msgid "DLC@RISEFROMRUIN@FRACTURING_WINDS_CRISIS@VICTORY_EVENT@INTERRUPTED@DESCRIPTION"
msgstr "{CountdownPlayer.Name} perdeu a posse de um ou mais de seus <<m:{GLOBAL.ArtifactConcept.Hyperlink}>> do Hubris dos Desfazedores, fazendo com que não progridam mais em direção à {GLOBAL.CataclysmVictoryConcept.Hyperlink}."

msgid "DLC@RISEFROMRUIN@INTERFACE@AGGRESSIVE_EXPANSION@DESCRIPTION"
msgstr "A Expansão Agressiva recompensa a {GLOBAL.ProvinceAnnexationConcept.Hyperlink} de províncias pertencentes a outras facções.[br/][br/]Anexar uma província hostil a uma cidade concede uma recompensa única de {GLOBAL.StructureProductionConcept.Hyperlink}, {GLOBAL.UnitProductionConcept.Hyperlink} e {GLOBAL.GoldConcept.Hyperlink}.[br/][br/]Essas recompensas escalam com a população da cidade da qual a província foi tomada."

msgid "DLC@RISEFROMRUIN@INTERFACE@AGGRESSIVE_EXPANSION@HYPERLINK"
msgstr "[hyperlink,GLOBAL.AggressiveExpansionConcept]Expansão Agressiva[/hyperlink]"

msgid "DLC@RISEFROMRUIN@INTERFACE@AGGRESSIVE_EXPANSION@NAME"
msgstr "Expansão Agressiva"

msgid "DLC@RISEFROMRUIN@INTERFACE@CUSTOMIZATION_LEADER@PUPILSIZE"
