msgstr "[hyperlink,GLOBAL.InsectoidWardenLoreConcept]Ryc'turi[/hyperlink]"

msgid "INTERFACE@LORE_CONCEPT@INSECTOIDWARDEN@NAME"
msgstr "Ryc'turi"

