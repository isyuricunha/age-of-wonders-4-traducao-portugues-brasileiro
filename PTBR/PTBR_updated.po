msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@BLOOD_EXARCH@ABILITY02@DESCRIPTION"
msgstr "Unidade alvo:[bulletlist][bullet/]Sofre dano.[bullet/]O dano aumenta em {amount} {GLOBAL.PhysicalDamageConcept.Hyperlink} para cada nível de unidade do alvo abaixo de {tier}.[bullet/]Cura {SIPHON_LESSER_LIFE_STEAL>ResolvedHealProportion}% do dano causado ao alvo.[bullet/]Se esta habilidade matar o alvo, reinicia o tempo de recarga de {GLOBAL.PROPERTIES.GIFT_BLOOD_OF_THE_EXARCH.Hyperlink}.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@BLOOD_EXARCH@ABILITY02@NAME"
msgstr "Sifão Menor"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@BLOOD_EXARCH@ABILITY03@DESCRIPTION"
msgstr "Unidade amigável alvo de Nível {tier} ou superior ganha {GLOBAL.PROPERTIES.BLOOD_OF_THE_EXARCH.Hyperlink} até o final do combate.[br/][br/]Não afeta <<m:{GLOBAL.HeroConcept.Hyperlink}>> ou outros Exarcas de Sangue."

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@BLOOD_EXARCH@ABILITY03@NAME"
msgstr "Conceder Sangue do Exarca"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@BLOOD_EXARCH@ABILITY03@PROP_DESCRIPTION"
msgstr "A unidade tem:[bulletlist][bullet/]+{BLOOD_OF_THE_EXARCH_DAMAGE_MULT>ResolvedMultiplier}% de dano.[bullet/]+{BLOOD_OF_THE_EXARCH_CRIT_CHANCE>ResolvedCritChanceBonus}% de chance de {GLOBAL.CriticalHitConcept.Hyperlink}.[bullet/]+{BLOOD_OF_THE_EXARCH_CRIT_DAMAGE>ResolvedMultiplier}% de dano de {GLOBAL.CriticalHitConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@BLOOD_EXARCH@ABILITY03@PROP_NAME"
msgstr "Sangue do Exarca"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@BLOOD_EXARCH@ABILITY04@DESCRIPTION"
msgstr "A unidade alvo sofre dano e tem uma chance base de {BLOOD_PULL_RESIST>ResolvedStrength}% de ser puxada para um hexágono adjacente."

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@BLOOD_EXARCH@ABILITY04@NAME"
msgstr "Puxão de Sangue"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@BLOOD_EXARCH@ABILITY05@DESCRIPTION"
msgstr "No final do turno, inimigos adjacentes têm uma chance base de {OPPRESSING_AURA_RESISTANCE>ResolvedStrength}% de sofrer:[bulletlist][bullet/]{GLOBAL.PROPERTIES.MISFORTUNE.Hyperlink} por {MISFORTUNE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]{OPPRESSING_AURA_MORALE_CHANGE>Morale Change Absolute} de perda de {GLOBAL.UnitMoraleConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@BLOOD_EXARCH@ABILITY05@NAME"
msgstr "Aura Opressora"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@BLOOD_EXARCH@NAME"
msgstr "Exarca de Sangue^n"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@SKILL1@DESCRIPTION"
msgstr "Invoca um {GLOBAL.UNITS.BLOOD_EXARCH.Hyperlink} {GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink} com habilidades poderosas de apoio e ofensiva que devastam unidades de nível baixo."

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@SKILL1@NAME"
msgstr "Invocar Exarca de Sangue"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@SKILL2@AUTOSPELL"
msgstr "No início do turno do conjurador:[bulletlist][bullet/]Até {TEARS_OF_THE_CRIMSON_SOVEREIGN_ENEMY_TARGETER>NumTargets} unidades inimigas:[bulletlist][bullet/]Sofrem {TEARS_OF_THE_CRIMSON_SOVEREIGN_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Têm uma chance base de {BLOOD_PARASITE_RESISTANCE>ResolvedStrength}% de ganhar {GLOBAL.PROPERTIES.BLOOD_PARASITE.Hyperlink} por {BLOOD_PARASITE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][bullet/]Até {TEARS_OF_THE_CRIMSON_SOVEREIGN_FRIENDLY_TARGETER>NumTargets} unidades amigáveis:[bulletlist][bullet/]Curam {TEARS_OF_THE_CRIMSON_SOVEREIGN_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Ganham {GLOBAL.PROPERTIES.FORTUNE.Hyperlink} por {FORTUNE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@SKILL2@DESCRIPTION"
msgstr "Ao ser conjurado e pelos próximos {TEARS_OF_THE_CRIMSON_SOVEREIGN_UNIT_AUTO_SPELL>TimeToLive} <<m:{GLOBAL.TurnConcept}>>:[bulletlist][bullet/]Até {TEARS_OF_THE_CRIMSON_SOVEREIGN_ENEMY_TARGETER>NumTargets} unidades inimigas:[bulletlist][bullet/]Sofrem {TEARS_OF_THE_CRIMSON_SOVEREIGN_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Têm uma chance base de {BLOOD_PARASITE_RESISTANCE>ResolvedStrength}% de ganhar {GLOBAL.PROPERTIES.BLOOD_PARASITE.Hyperlink} por {BLOOD_PARASITE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][bullet/]Até {TEARS_OF_THE_CRIMSON_SOVEREIGN_FRIENDLY_TARGETER>NumTargets} unidades amigáveis:[bulletlist][bullet/]Curam {TEARS_OF_THE_CRIMSON_SOVEREIGN_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Ganham {GLOBAL.PROPERTIES.FORTUNE.Hyperlink} por {FORTUNE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@SKILL2@NAME"
msgstr "Lágrimas do Soberano Carmesim"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@SKILL3@BUFF_DESCRIPTION"
msgstr "Unidade:[bulletlist][bullet/]Tem +{MANTLE_OF_THE_BLOOD_NOBLE_HP_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[bullet/]Recebe +{MANTLE_OF_THE_BLOOD_NOBLE_HEAL_MODIFIER>ResolvedHealing Multipli}% de cura em combate.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@SKILL3@DESCRIPTION"
msgstr "Concede às unidades encantadas:[bulletlist][bullet/]{GLOBAL.PROPERTIES.COAGULATE.Hyperlink}[bullet/]No início do combate, para cada unidade amigável não invocada de Nível I e II:[bulletlist][bullet/]+{amount1} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]+{amount2}% de cura recebida em combate.[/bulletlist][/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@SKILL3@NAME"
msgstr "Manto do Nobre de Sangue"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@SKILL3@PROP_DESCRIPTION"
msgstr "Unidade:[bulletlist][bullet/]Tem {GLOBAL.PROPERTIES.COAGULATE.Hyperlink}[bullet/]No início do combate, para cada unidade amigável não invocada de Nível I e II, ganha:[bulletlist][bullet/]+{amount1} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]+{amount2}% de cura recebida em combate.[/bulletlist][/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@SKILL4@DESCRIPTION"
msgstr "[bulletlist][bullet/]Unidades de Nível III, IV e V que você possui ganham:[bulletlist][bullet/]+{amount1} de regeneração de {GLOBAL.HitPointConcept.Hyperlink} no mapa do mundo.[bullet/]Ganham {amount2} de {GLOBAL.ExperienceConcept.Hyperlink} por turno no mapa do mundo.[/bulletlist][bullet/]Ganha {GLOBAL.CrimsonCourtMagistrateConcept.Hyperlink}, permitindo que você ganhe mana de Vassalos e ao Migrar, Arrasar ou Saquear.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@SKILL4@NAME"
msgstr "Corte Carmesim"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@SKILL4@PROP_DESCRIPTION"
msgstr "Esta unidade:[bulletlist][bullet/]Tem +{CRIMSON_COURT_REGEN_PER_TURN>BONUS>Regen} de regeneração de {GLOBAL.HitPointConcept.Hyperlink} no mapa do mundo.[bullet/]Ganha {CRIMSON_COURT_XP_PER_TURN>XP} de {GLOBAL.ExperienceConcept.Hyperlink} por turno no mapa do mundo.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@SKILL5@DESCRIPTION"
msgstr "Transforme suas unidades enquanto elas ingerem ritualisticamente sangue de um Exarca, concedendo-lhes:[bulletlist][bullet/]O tipo de unidade {GLOBAL.PROPERTIES.UNDEAD.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.LIFEDRINKER.Hyperlink}.[bullet/]Ataques básicos têm uma chance base de {BLOOD_PARASITE_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.BLOOD_PARASITE.Hyperlink} por {BLOOD_PARASITE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>. Este efeito é aumentado para ataques de Tiro Único.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@SKILL5@NAME"
msgstr "Dom do Sangue Antigo"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@SKILL5@PROP_DESCRIPTION"
msgstr "Unidade tem:[bulletlist][bullet/]O tipo de unidade {GLOBAL.PROPERTIES.UNDEAD.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.LIFEDRINKER.Hyperlink}.[bullet/]Ataques base têm uma chance base de {BLOOD_PARASITE_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.BLOOD_PARASITE.Hyperlink} por {BLOOD_PARASITE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>. Esse efeito é aumentado para ataques de Tiro Único.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Abrace uma magia esquecida e corrupta que fortalece suas unidades de alto nível e faz com que sua facção abrace uma forma ancestral de não-morte, ganhando o poder de espalhar <<m:{GLOBAL.PROPERTIES.BLOOD_PARASITE.Hyperlink}>> sobre seus inimigos."

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@TOME@LORE_DESCRIPTION"
msgstr "\"O sangue carrega um poder maior do que os mortais podem imaginar. O sangue dos Arcontes não carrega sua essência? Não usamos o sangue como pagamento por nossa magia? O sangue é onde a alma reside! E assim, nós bebemos, para preencher o vazio dentro de nós. Pois o Dom do Sangue Antigo exige almas para sacrificar... E há muito gastamos as nossas.\""

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@TOME@NAME"
msgstr "Tomo do Reinado Carmim"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@ABILITY01@DESCRIPTION"
msgstr "Ataque a unidade alvo e ganhe <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> igual a {DRAINING_STRIKE_LIFE_STEAL>ResolvedHealProportion}% do dano causado."

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@ABILITY01@NAME"
msgstr "Golpe Drenante"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@ABILITY02@NAME"
msgstr "Chicote Atormentador"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@ABILITY03@DESCRIPTION"
msgstr "Teletransporte para o hexágono alvo."

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@ABILITY03@NAME"
msgstr "Passo das Sombras"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@GAMEPLAY_DESCRIPTION"
msgstr "Atormente seus inimigos transformando suas próprias ações contra eles e faça suas unidades serem fortalecidas pela dor."

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@LORE_DESCRIPTION"
msgstr "\"Faça seus corpos tremerem de tormento. Por cada polegada que se movem, pagarão com grunhidos de agonia. Deixe o sofrimento escorrer como mel sobre sua pele pulsante. Faça-os curvar-se, faça-os implorar, faça-os suplicar ao seu causador de dor... E guarde um pouco de tormento para si mesmo, pois o sofrimento é melhor infligido quando apreciado em primeira mão.\""

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@NAME"
msgstr "Tomo do Tormento"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@PAIN_BRINGER@NAME"
msgstr "Portadora da Dor^f"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SKILL1@DESCRIPTION"
msgstr "A raça alvo abraça a dor e, quando atingida por um ataque, ganha:[bulletlist][bullet/]{PAINBOUND_MORALE>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}.[bullet/]Um efeito de status positivo aleatório.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SKILL1@NAME"
msgstr "Ligado à Dor"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SKILL1@PROP_DESCRIPTION"
msgstr "Quando esta unidade é atingida por um ataque, ela ganha:[bulletlist][bullet/]{PAINBOUND_MORALE>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}.[bullet/]Um efeito de status positivo aleatório.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SKILL2@DESCRIPTION"
msgstr "{GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink} que atormentam seus inimigos e podem facilmente flanqueá-los e drenar sua vitalidade."

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SKILL2@NAME"
msgstr "Portador da Dor"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SKILL3@DESCRIPTION"
msgstr "Ataques {GLOBAL.RangedConcept.Hyperlink} e {GLOBAL.MagicConcept.Hyperlink} de unidades encantadas:[bulletlist][bullet/]Têm uma chance base de {TORMENTED_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.TORMENT.Hyperlink} até o final do combate.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SKILL3@NAME"
msgstr "Projéteis Atormentadores"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SKILL3@PROP_DESCRIPTION"
msgstr "Ataques {GLOBAL.RangedConcept.Hyperlink} e {GLOBAL.MagicConcept.Hyperlink}:[bulletlist][bullet/]Têm uma chance base de {TORMENTED_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.TORMENT.Hyperlink} até o final do combate.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SKILL4@DESCRIPTION"
msgstr "Unidades inimigas em um raio de {AGONIZE_UNIT_TARGETER_CIRCLE>AREA>Radius} hexágonos:[bulletlist][bullet/]Sofrem {AGONIZE_UNIT_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}[bullet/]Têm uma chance base de {AGONIZE_RESISTANCE_CHECK>ResolvedStrength}% de ganhar {TORMENT_REPEATER>Count} acumulações de {GLOBAL.PROPERTIES.TORMENT.Hyperlink} até o final do combate. Em caso de falha, inflige {amount} acumulação de {GLOBAL.PROPERTIES.TORMENT.Hyperlink} em vez disso.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SKILL4@NAME"
msgstr "Agonizar"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SKILL5@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{amount} {GLOBAL.ManaConcept.Hyperlink}.[bullet/]+{amount2} <<m:{GLOBAL.CombatCastingPointConcept.Hyperlink}>>.[bullet/]<<m:{GLOBAL.DamageSpellConcept.Hyperlink}>> e <<m:{GLOBAL.DebuffSpellConcept.Hyperlink}>> aplicam uma perda extra de {amount3} {GLOBAL.UnitMoraleConcept.Hyperlink}.[/bulletlist][br/][br/]Pode ser construído apenas na {GLOBAL.ThroneCityConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SKILL5@MOD_DESCRIPTION"
msgstr "Os alvos perdem {amount} {GLOBAL.UnitMoraleConcept.Hyperlink}"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SKILL5@NAME"
msgstr "Lente da Angústia"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SPI@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{amount} de renda de {GLOBAL.ManaConcept.Hyperlink}.[bullet/]+{amount2} de renda de {GLOBAL.KnowledgeConcept.Hyperlink}.[bullet/]+{amount3} {GLOBAL.CityStabilityConcept.Hyperlink}[bullet/]+{amount4} {GLOBAL.ManaConcept.Hyperlink} por {GLOBAL.FarmConcept.Hyperlink} adjacente.[bullet/]+{amount5} {GLOBAL.KnowledgeConcept.Hyperlink} por {GLOBAL.ForesterConcept.Hyperlink} adjacente.[bullet/]Conta como um {GLOBAL.ConduitConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SPI@NAME"
msgstr "[conduit/] Basílica da Lamentação"

msgid "DLC@THRONESOFBLOOD@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@VAMPIRE_LORD@DESCRIPTION"
msgstr "{LOC.DLC@THRONESOFBLOOD@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@VAMPIRE_LORD@DESCRIPTION_SHORT}[br/][bulletlist][bullet/]Uma unidade {GLOBAL.PROPERTIES.UNDEAD.Hyperlink} com uma [hyperlink,GLOBAL.PROPERTIES.SUNLIGHT_WEAKNESS]aversão à luz[/hyperlink].[bullet/]Tem acesso à {GLOBAL.STRUCTURE_UPGRADES.LORD_CASTLE_FOUNDATION.Hyperlink} que substitui a {GLOBAL.STRUCTURE_UPGRADES.WIZARD_TOWER_FOUNDATION.Hyperlink} e concede o uso de <<m:{GLOBAL.ThrallConcept.Hyperlink}>> para conjurar poderosos rituais <<m:{GLOBAL.SpellConcept.Hyperlink}>>.[bullet/]Drena {amountXP}% da {GLOBAL.ExperienceConcept.Hyperlink} de combate ganha por heróis vampiros transformados.[bullet/]A facção é imune às penalidades de terreno sem sol para {GLOBAL.CityStabilityConcept.Hyperlink} e {GLOBAL.UnitMoraleConcept.Hyperlink}.[bullet/]Vampiros ancestrais são <<m:{GLOBAL.PROPERTIES.HEROTRAIT_GOVERNANCE_VAMPIRE_GOVERNOR.Hyperlink}>>.[bullet/]Vampiros ancestrais têm um custo de {amount3} {GLOBAL.GoldConcept.Hyperlink} {GLOBAL.UnitUpkeepConcept.Hyperlink}[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@VAMPIRE_LORD@DESCRIPTION_SHORT"
msgstr "[helpcolor]Um vampiro imortal que drena a vida dos inimigos sob a cobertura da noite.[/helpcolor]"

msgid "DLC@THRONESOFBLOOD@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@VAMPIRE_LORD@HYPERLINK"
msgstr "[hyperlink,GLOBAL.VampireLordConcept]Vampiro Ancestral[/hyperlink]"

msgid "DLC@THRONESOFBLOOD@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@VAMPIRE_LORD_HYBRID@DESCRIPTION"
msgstr "{LOC.DLC@THRONESOFBLOOD@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@VAMPIRE_LORD_HYBRID@DESCRIPTION_SHORT}[br/][bulletlist][bullet/]Pode ser de qualquer forma.[/bulletlist][br/]"

msgid "DLC@THRONESOFBLOOD@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@VAMPIRE_LORD_HYBRID@DESCRIPTION_SHORT"
msgstr "[helpcolor]Um vampiro descendente de uma das muitas raças que habitam o Mar Astral.[/helpcolor]"

msgid "DLC@THRONESOFBLOOD@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@VAMPIRE_LORD_PUREBLOOD@DESCRIPTION"
msgstr "{LOC.DLC@THRONESOFBLOOD@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@VAMPIRE_LORD_PUREBLOOD@DESCRIPTION_SHORT}[br/][bulletlist][bullet/]Possui opções de aparência únicas.[/bulletlist][br/]"

msgid "DLC@THRONESOFBLOOD@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@VAMPIRE_LORD_PUREBLOOD@DESCRIPTION_SHORT"
msgstr "[helpcolor]Um vampiro descendente dos Arqui-vampiros de Drevanya.[/helpcolor]"

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_ECHOES_01@AFFINITY_CHOICE_MATERIUM@FAILURE"
msgstr "Suas tentativas de transmutação não têm efeito."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_ECHOES_01@AFFINITY_CHOICE_MATERIUM@HEADER"
msgstr "Neutralize os ecos que ricocheteiam nas paredes da caverna:"

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_ECHOES_01@AFFINITY_CHOICE_MATERIUM@SUCCESS"
msgstr "A determinação do seu exército cresce contra o <<m:EventUnit>>."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_MAGGOTS_01@AFFINITY_CHOICE_NATURE@FAILURE"
msgstr "A natureza não pode superar a manipulação do <<m:EventUnit>>."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_MAGGOTS_01@AFFINITY_CHOICE_NATURE@HEADER"
msgstr "Neutralize qualquer influência que o <<m:EnemyUnit>> tenha sobre o <<m:EventUnit>>:"

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_MAGGOTS_01@AFFINITY_CHOICE_NATURE@SUCCESS"
msgstr "<<m:EventUnit>> recém-eclodidos atacam seus hospedeiros dispostos primeiro."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_MAGGOTS_01@AFFINITY_CHOICE_SHADOW@FAILURE"
msgstr "A sede de sangue do <<m:EventUnit>> transcende sua carne de gosto ruim."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_MAGGOTS_01@AFFINITY_CHOICE_SHADOW@HEADER"
msgstr "Encante seu exército para dissuadir o <<m:EventUnit>> de beber seu sangue:"

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_MAGGOTS_01@AFFINITY_CHOICE_SHADOW@SUCCESS"
msgstr "O <<m:EventUnit>> é menos propenso a injetar parasitas de sangue em seus guerreiros."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_TORMENT_01@AFFINITY_CHOICE_CHAOS@FAILURE"
msgstr "Para <<G:disappointment^n,{EventHero.FirstName}>>, a dor ainda causa dano."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_TORMENT_01@AFFINITY_CHOICE_CHAOS@HEADER"
msgstr "{EventHero} busca prazer na dor também:"

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_TORMENT_01@AFFINITY_CHOICE_CHAOS@SUCCESS"
msgstr "A mesma exaltação que inspira os ritualistas também beneficia {EventHero.FirstName}."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_TORMENT_01@AFFINITY_CHOICE_ORDER@FAILURE"
msgstr "O {EnemyUnit} e os discípulos <<o:EnemyUnit>> zombam da sua desaprovação pudica."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_TORMENT_01@AFFINITY_CHOICE_ORDER@HEADER"
msgstr "Tente condenar os <<G:ritualists^p,EnemyUnit>>:"

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_TORMENT_01@AFFINITY_CHOICE_ORDER@SUCCESS"
msgstr "Suas palavras atingem o alvo. Seus oponentes são sobrecarregados pela vergonha."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@ENTHRALL_HUNTRESS@AFFINITY_CHOICE@FAILURE"
msgstr "Furiosa, {Huntress.FirstName} resiste à sua tentativa de escravizar <<o:Huntress>>."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@ENTHRALL_HUNTRESS@AFFINITY_CHOICE@HEADER"
msgstr "Tentar escravizar {Huntress.FirstName} em um momento de distração de <<P:Huntress>>."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@ENTHRALL_HUNTRESS@AFFINITY_CHOICE@SUCCESS"
msgstr "{Huntress.FirstName} torna-se seu escravo e <<P:Huntress>> {Huntress.Race} seguem o exemplo."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@ENTHRALL_HUNTRESS@AFFINITY_CHOICE@SUCCESS_ALT"
msgstr "{Huntress.FirstName} fica escravizada. Todas as <<o:Huntress>> <<m:{GLOBAL.CityConcept.Hyperlink}>> e <<m:{GLOBAL.UnitConcept.Hyperlink}>> serão removidas do mapa."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@LOST_SOUL@LEVEL_UP_TWICE"
