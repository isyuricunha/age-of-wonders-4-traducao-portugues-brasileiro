msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@OVERGROWN_ROSE_GARDEN@DESCRIPTION"
msgstr "Obstáculos adicionais de Roseira Rastejante estão presentes durante a batalha. Eles são {GLOBAL.SharpConcept.Hyperlink} e {GLOBAL.CreepingConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@OVERGROWN_ROSE_GARDEN@NAME"
msgstr "Jardim de Rosas Crescidas"

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@PARASITIC_INFECTION@DESCRIPTION"
msgstr "A cada {GLOBAL.TurnConcept.Hyperlink}, todas as unidades inimigas com {GLOBAL.PROPERTIES.BLEEDING.Hyperlink} têm uma chance de {chance} de sofrer {GLOBAL.PROPERTIES.BLOOD_PARASITE.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@PARASITIC_INFECTION@NAME"
msgstr "Contaminação Parasítica"

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@PLEASURE_FROM_PAIN@DESCRIPTION"
msgstr "Todas as unidades de defesa têm {GLOBAL.PROPERTIES.CURSE_EATER.Hyperlink} e {GLOBAL.PROPERTIES.PAINBOUND_PROPERTY_GROUP.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@PLEASURE_FROM_PAIN@NAME"
