msgstr "Incursão Umbral"

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@SKILL3@DESCRIPTION"
msgstr "Transforma a raça alvo em seres Umbrais, o que lhes concede:[bulletlist][bullet/]O tipo de unidade {GLOBAL.PROPERTIES.UMBRAL_DEMON.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.FLOATING_MOVEMENT.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.FAST_MOVEMENT.Hyperlink}.[br/][br/]Unidades montadas perdem suas montarias.[br/][br/]Heróis perdem seus slots de equipamento de Montaria e Pernas.[br/][br/]Esta transformação é incompatível com {GLOBAL.SPECIAL_OPERATIONS.PURE_SOUL.Hyperlink}.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@SKILL3@GROUP_DESCRIPTION"
msgstr "Unidade possui:[bulletlist][bullet/]O tipo de unidade {GLOBAL.PROPERTIES.UMBRAL_DEMON.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.FLOATING_MOVEMENT.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.FAST_MOVEMENT.Hyperlink}.[bulletlist][br/][br/]Unidades montadas perdem suas montarias.[br/][br/]Heróis perdem os slots de equipamento Montaria e Pernas.[/bulletlist][/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@SKILL3@NAME"
msgstr "Andarilho das Trevas"

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@SKILL4@DESCRIPTION"
msgstr "Cria um {GLOBAL.PROPERTIES.TREACHEROUS_REFLECTION.Hyperlink} de uma unidade inimiga alvo.[br/][br/]Não pode alvejar <<m:{GLOBAL.PROPERTIES.HERO.Hyperlink}>>, <<m:{GLOBAL.PROPERTIES.COMBAT_SUMMON.Hyperlink}>> e <<m:{GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink}>>."

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@SKILL4@NAME"
msgstr "Reflexo Traiçoeiro"

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@SKILL4@PROP_DESCRIPTION"
msgstr "Uma cópia de outra unidade:[bulletlist][bullet/]O reflexo morre quando a unidade inimiga morre.[bullet/]O reflexo ganha o tipo de unidade {GLOBAL.PROPERTIES.UMBRAL_DEMON.Hyperlink}.[bullet/]Não pode invocar outras unidades.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@SKILL5@DESCRIPTION"
msgstr "Unidade inimiga alvo:[bulletlist][bullet/]Perde todos os <<m:{GLOBAL.PositiveStatusEffectConcept.Hyperlink}>>.[bullet/]Se um efeito de status perdido tiver algum {GLOBAL.OpposingStatusEffectsConcept}, então a unidade ganha uma pilha desse {GLOBAL.NegativeStatusEffectConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@SKILL5@NAME"
msgstr "Dádiva Corrompida"

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@SKILL6@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{baseincome} de renda de {GLOBAL.ManaConcept.Hyperlink}[bullet/]{castingpointsbonus} <<m:{GLOBAL.WorldMapCastingPointConcept.Hyperlink}>>[bullet/]{combatcastingpointsbonus} <<m:{GLOBAL.CombatCastingPointConcept.Hyperlink}>>[/bulletlist][br/]No início do combate no domínio desta cidade: [bulletlist][bullet/] {NumberUnits} unidades inimigas têm {InsanityPercentage}% de chance base de sofrer {GLOBAL.PROPERTIES.INSANITY} por {NumberTurnsInsanity} <<m:{GLOBAL.TurnConcept.Hyperlink}>>. Se falhar, ficam {GLOBAL.PROPERTIES.STUNNED} por {NumberTurnsStunned} {GLOBAL.TurnConcept.Hyperlink}.[/bulletlist][br/][br/]Só pode ser construído na {GLOBAL.ThroneCityConcept.Hyperlink}."

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@SKILL6@NAME"
msgstr "Trono dos Sussurros Insidiosos"

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@SKILL6@PROPERTY"
msgstr "No início do combate no domínio desta cidade: [bulletlist][bullet/] {NumberUnits} unidades inimigas têm {InsanityPercentage}% de chance base de sofrer {GLOBAL.PROPERTIES.INSANITY} por {NumberTurnsInsanity} <<m:{GLOBAL.TurnConcept.Hyperlink}>>. Se falhar, ficam {GLOBAL.PROPERTIES.STUNNED} por {NumberTurnsStunned} {GLOBAL.TurnConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Aproxime-se dos demônios umbrais e puna seus inimigos com suas próprias forças."

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@TOME@HERO_SKILL@DESCRIPTION"
msgstr "Ataques base roubam {NumberEffects} {GLOBAL.PositiveStatusEffectConcept.Hyperlink} do alvo para esta unidade."

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@TOME@HERO_SKILL@MOD_DESCRIPTION"
msgstr "Ao acertar, ataques roubam {NumberEffects} {GLOBAL.PositiveStatusEffectConcept.Hyperlink} do alvo para esta unidade."

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@TOME@HERO_SKILL@NAME"
msgstr "Roubo de Dádivas"

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@TOME@LORE_DESCRIPTION"
msgstr "\"Abraçe a corrupção dentro de si. Aqueles que a temem e negam estão cegos, mas você, você enxergará claramente. A escuridão do Abismo não o assustará, mas o fortalecerá. Torne-se o espelho que revela o vazio nos corações dos ignorantes. Tome tudo o que eles têm e mostre-lhes a maior verdade de Urrath: há corrupção em tudo, e em todos.\""

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@TOME@NAME"
msgstr "Tomo da Corrupção"

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@UNIT_ABILITY_1@DESCRIPTION"
msgstr "Libera um projétil mágico em um inimigo alvo.[bulletlist][bullet/]Inflige {WRACK_MORALE_DAMAGE>Morale Change} de {GLOBAL.UnitMoraleConcept.Hyperlink}.[bullet/]Se o alvo estiver {GLOBAL.PROPERTIES.ENCHAINED.Hyperlink}, este ataque não pode errar.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@UNIT_ABILITY_1@NAME"
msgstr "Abalo"

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@UNIT_ABILITY_2@DESCRIPTION"
msgstr "Unidade inimiga alvo tem {Percentage}% de chance base de ficar {GLOBAL.PROPERTIES.ENCHAINED.Hyperlink}.[br/][br/]Apenas uma unidade pode ser ligada por vez."

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@UNIT_ABILITY_2@NAME"
msgstr "Encadear Mente"

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@UNIT_ABILITY_3@DESCRIPTION"
msgstr "A unidade ligada alvo é afligida com {GLOBAL.PROPERTIES.INSANITY.Hyperlink} por {InsanityTurns} <<m:{GLOBAL.TurnConcept}>>.[br/][br/]Desativa {GLOBAL.PROPERTIES.GRATITUDE.Hyperlink} e {GLOBAL.PROPERTIES.SURRENDER.Hyperlink} neste turno."

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@UNIT_ABILITY_3@NAME"
msgstr "Fúria"

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@UNIT_ABILITY_4@DESCRIPTION"
msgstr "Unidade ligada alvo sofre:[bulletlist][bullet/]{MoralLoss} de {GLOBAL.UnitMoraleConcept.Hyperlink}[bullet/]{amount} de {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink} por {DefenseTime} <<m:{GLOBAL.TurnConcept}>>[bullet/]{amount} de {GLOBAL.PROPERTIES.SUNDERED_RESISTANCE.Hyperlink} por {ResistanceTime} <<m:{GLOBAL.TurnConcept}>>[/bulletlist][br/][br/]Desativa {GLOBAL.PROPERTIES.FURY.Hyperlink} e {GLOBAL.PROPERTIES.GRATITUDE.Hyperlink} neste turno."

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@UNIT_ABILITY_4@NAME"
msgstr "Rendição"

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@UNIT_ABILITY_5@DESCRIPTION"
msgstr "[bulletlist][bullet/]Unidade ligada:[bulletlist][bullet/]Sofre {hitpoints} de {GLOBAL.PhysicalDamageConcept.Hyperlink} que ignora {GLOBAL.DefenseConcept.Hyperlink}.[/bulletlist][bullet/]Unidade conjuradora:[bulletlist][bullet/]Cura {hitpoints} de {GLOBAL.TemporaryHitPointConcept.Hyperlink}.[bullet/]Rouba até {MaxTransfer} <<m:{GLOBAL.PositiveStatusEffectConcept.Hyperlink}>> da unidade ligada.[/bulletlist][/bulletlist][br/][br/]Desativa {GLOBAL.PROPERTIES.FURY.Hyperlink} e {GLOBAL.PROPERTIES.SURRENDER.Hyperlink} neste turno."

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@UNIT_ABILITY_5@NAME"
msgstr "Gratidão"

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@UNIT_ABILITY_6@DESCRIPTION"
msgstr "Encerrar antecipadamente o vínculo de {GLOBAL.PROPERTIES.ENCHAINED_MIND.Hyperlink}."

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@UNIT_ABILITY_6@NAME"
msgstr "Liberar Mente"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@DESCRIPTON"
msgstr "Esta é a unidade Constritor"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@NAME"
msgstr "Constritor"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Convoque mutações e criaturas tentaculadas das profundezas para conter e constringir seus inimigos, mantendo-os exatamente onde você deseja."

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@HERO_SKILL@DESCRIPTION"
msgstr "Convoque uma unidade {GLOBAL.UNITS.TENTACLE_UNIT.Hyperlink} no hexágono alvo.{LOC.CONCEPT@SUMMON_LIVE_SHARED}"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@HERO_SKILL@NAME"
msgstr "Manifestar Tentáculo"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@LORE_DESCRIPTION"
msgstr "\"Inspire-se no tentáculo e veja como os limites de sua carne são meras restrições autoimpostas. Acaricie, segure, aperte seu domínio sobre seguidores e adversários. Encante seu povo com a bênção de muitos braços para que eles também possam espalhar seu amor. Seja embalado no abraço do tentáculo e perceba que o único limite para seu alcance é sua própria imaginação.\""

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@NAME"
msgstr "Tomo do Tentáculo"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@SKILL1@DESCRIPTION"
msgstr "Uma {GLOBAL.PROPERTIES.POLEARM_UNIT.Hyperlink} capaz de puxar e conter oponentes."

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@SKILL1@NAME"
msgstr "Constritor"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@SKILL1@STATUS_EFFECT_NAME"
msgstr "Constringindo"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@SKILL2@DESCRIPTION"
msgstr "Invoca um {GLOBAL.PROPERTIES.FIGHTER.Hyperlink} [hyperlink,GLOBAL.PROPERTIES.IMMOBILIZED]Imóvel[/hyperlink] com {GLOBAL.PROPERTIES.HYPER_AWARE_UNIT_PASSIVE.Hyperlink}.{LOC.CONCEPT@SUMMON_LIVE_SHARED}"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@SKILL2@NAME"
msgstr "Conjurar Tentáculo"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@SKILL3@DESCRIPTION"
msgstr "Faz com que os ataques base de {GLOBAL.MagicConcept.Hyperlink} das unidades encantadas:[bulletlist][bullet/]Ganhem {CONSTRICTED_RESISTANCE_CHECK>ResolvedStrength}% de chance base de infligir {GLOBAL.PROPERTIES.CONSTRICTED.Hyperlink} por {CONSTRICTED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Chance aumentada para {strongerChance}% contra unidades {GLOBAL.PROPERTIES.MARKED.Hyperlink} ou {GLOBAL.PROPERTIES.SLOWED.Hyperlink}.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@SKILL3@MODIFIER_DESCRIPTION"
msgstr "[bulletlist][bullet/]{CONSTRICTED_RESISTANCE_CHECK>ResolvedStrength}% de chance base de infligir {GLOBAL.PROPERTIES.CONSTRICTED.Hyperlink} por {duration} {GLOBAL.TurnConcept}.[bullet/]{strongerChance}% de chance contra unidades {GLOBAL.PROPERTIES.MARKED.Hyperlink} ou {GLOBAL.PROPERTIES.SLOWED.Hyperlink}.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@SKILL3@MODIFIER_DESCRIPTION_SIMPLE"
msgstr "{CONSTRICTED_RESISTANCE_CHECK>ResolvedStrength}% de chance base de infligir {GLOBAL.PROPERTIES.CONSTRICTED.Hyperlink} por {duration} {GLOBAL.TurnConcept}."

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@SKILL3@NAME"
msgstr "Foco Constringidor"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@SKILL4@DESCRIPTION"
msgstr "A cidade ganha:[bulletlist][bullet/]{goldamount} {GLOBAL.GoldConcept.Hyperlink}[bullet/]{happinessamount} {GLOBAL.CityStabilityConcept.Hyperlink}[bullet/]Quando sitiada, conjura {amountTentacles} unidades {GLOBAL.UNITS.TENTACLE_UNIT.Hyperlink} adjacentes a unidades inimigas no início da batalha.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@SKILL4@NAME"
msgstr "Labirinto de Tentáculos"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@SKILL4@PROP_DESCRIPTION"
msgstr "{Amount} unidades {GLOBAL.UNITS.TENTACLE_UNIT.Hyperlink} são invocadas ao lado de unidades inimigas aleatórias no início da batalha."

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@SKILL4@STRUCTURE_DESCRIPTION"
msgstr "Quando sitiada, conjura {amountTentacles} unidades <<m:{GLOBAL.UNITS.TENTACLE_UNIT.Hyperlink}>> adjacentes a unidades inimigas no início da batalha."

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@SKILL5@DESCRIPTION"
msgstr "A unidade aliada alvo ganha {GLOBAL.PROPERTIES.RETALIATING_GROWTHS_PROPERTY_GROUP.Hyperlink} por {RETALIATING_GROWTHS>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@SKILL5@NAME"
msgstr "Crescimentos Retaliadores"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@SKILL5@PROPERTY_DESCRIPTION"
msgstr "A unidade possui:[bulletlist][bullet/]Uma chance base de {chance}% de infligir {GLOBAL.PROPERTIES.CONSTRICTED.Hyperlink} por {duration} {GLOBAL.TurnConcept} com seus ataques base de {GLOBAL.MeleeConcept.Hyperlink}.[bullet/]<<m:{GLOBAL.RetaliationConcept.Hyperlink}>> ilimitado.[bullet/]{GLOBAL.PROPERTIES.HYPER_AWARE_UNIT_PASSIVE.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.DEFENSIVE_MASTERS.Hyperlink}.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Unidade alvo:[bulletlist][bullet/]Sofre dano.[bullet/]Tem uma chance base de {CONSTRICTOR_PULL_RESISTANCE_CHECK>ResolvedStrength}% de:[bulletlist][bullet/]Ser puxada para um espaço adjacente.[bullet/]Ficar {GLOBAL.PROPERTIES.CONSTRICTED.Hyperlink} por {CONSTRICTED_EFFECT_DESCRIPTION>NumTurns} {GLOBAL.TurnConcept}.[/bulletlist][/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@UNIT1@ABILITY1@EFFECT_DESCRIPTION"
msgstr "{CONSTRICTOR_PULL_RESISTANCE_CHECK>ResolvedStrength}% de chance de puxar o alvo para um espaço adjacente e infligir {GLOBAL.PROPERTIES.CONSTRICTED.Hyperlink}."

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@UNIT1@ABILITY1@EFFECT_PREVIEW"
msgstr "[bulletlist][bullet/]Puxado[bullet/]Constrangido {duration}[turno/][/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@UNIT1@ABILITY1@NAME"
msgstr "Puxar"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@UNIT1@DESCRIPTION"
msgstr "Um tentáculo estacionário que constringe alvos próximos ao seu alcance."

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@UNIT1@NAME"
msgstr "Tentáculo^n"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@HERO_SKILL@DESCRIPTION"
msgstr "Enquanto esta unidade for o governante do exército, as unidades ganham:[bulletlist][bullet/]{GLOBAL.PROPERTIES.SHADOW_SICKNESS_IMMUNITY.Hyperlink}[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@HERO_SKILL@NAME"
msgstr "Pastor das Trevas"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@HERO_SKILL@PROPERTY_DESCRIPTION"
msgstr "Esta unidade possui:[bulletlist][bullet/]{GLOBAL.PROPERTIES.SHADOW_SICKNESS_IMMUNITY.Hyperlink}.[bullet/][hyperlink,GLOBAL.WorldMapRegeneration]Regenera[/hyperlink] +{GLOOM_SHEPHERD_HEALTH_REGEN>BONUS>Regen} {GLOBAL.HitPointConcept.Hyperlink} por {GLOBAL.TurnConcept.Hyperlink} no mapa-múndi enquanto estiver em terreno de {GLOBAL.GloomTerrainConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@PROVINCE_IMPROVEMENT@DESCRIPTION"
msgstr "[bulletlist][bullet/]Renda de {basemanaamount} {GLOBAL.ManaConcept.Hyperlink}.[bullet/]A cada {GLOBAL.TurnConcept.Hyperlink}, {amount} {GLOBAL.ProvinceConcept.Hyperlink} dentro de um raio igual ao Nível da Cidade:[bulletlist][bullet/]Ganha {GLOBAL.GloomTerrainConcept.Hyperlink}.[bullet/]Perde {GLOBAL.ChasmConcept.Hyperlink}, {GLOBAL.RiverConcept.Hyperlink}, {GLOBAL.SwampConcept.Hyperlink}, {GLOBAL.SandConcept.Hyperlink}, {GLOBAL.SnowConcept.Hyperlink}, {GLOBAL.FrozenWasteConcept.Hyperlink} e {GLOBAL.AshlandsConcept.Hyperlink}.[/bulletlist][bullet/]Conta como um {GLOBAL.ConduitConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@PROVINCE_IMPROVEMENT@NAME"
msgstr "[conduit/] Altar da Escuridão Marchante"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@SKILL1@DESCRIPTION"
msgstr "{GLOBAL.ProvinceConcept.Hyperlink} alvo e <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacentes:[bulletlist][bullet/]Ganham {GLOBAL.GloomTerrainConcept.Hyperlink}[bullet/]Perdem {GLOBAL.ChasmConcept.Hyperlink}, {GLOBAL.RiverConcept.Hyperlink}, {GLOBAL.SandConcept.Hyperlink}, {GLOBAL.SnowConcept.Hyperlink}, {GLOBAL.FrozenWasteConcept.Hyperlink}, {GLOBAL.AshlandsConcept.Hyperlink}, {GLOBAL.SwampConcept.Hyperlink}, {GLOBAL.CavernFloorConcept.Hyperlink} e {GLOBAL.DungeonConcept.Hyperlink}.[bullet/]<<m:{GLOBAL.UnitConcept.Hyperlink}>> inimigos sofrem {colddamage} {GLOBAL.FrostDamageConcept.Hyperlink} e {blightdamage} {GLOBAL.BlightDamageConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@SKILL1@NAME"
msgstr "Manto de Escuridão"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@SKILL2@DESCRIPTION"
msgstr "Cria uma Fenda Umbral na província alvo do Abismo Umbral e outra próxima na camada da Superfície."

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@SKILL2@NAME"
msgstr "Fenda Umbral"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@SKILL3@DESCRIPTION"
msgstr "A unidade alvo tem uma chance base de {UMBRAL_EXILE_RESIST>ResolvedStrength}% de:[bulletlist][bullet/]Ser removida imediatamente do combate.[bullet/]Aparecer em um local aleatório no Abismo Umbral após a batalha.[bullet/]Se não for bem-sucedido, inflige {GLOBAL.PROPERTIES.STUNNED.Hyperlink} por {STUNNED_EFFECT_DESCRIPTION>NumTurns} {GLOBAL.TurnConcept.Name} em vez disso.[/bulletlist][br/][br/]Não pode ser usado em Combate Aquático."

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@SKILL3@LOG_MESSAGE"
msgstr "Exilado"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@SKILL3@NAME"
msgstr "Exílio Umbral"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@SKILL4@DESCRIPTION"
msgstr "Invoca um {GLOBAL.UNITS.UMBRAL_JUGGERNAUT.Hyperlink} no hexágono alvo."

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@SKILL4@NAME"
msgstr "Invocar Juggernaut Umbral"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@SKILL5@DESCRIPTION"
msgstr "Concede à raça alvo as bênçãos do Abismo Umbral, concedendo-lhes:[bulletlist][bullet/]{GLOBAL.PROPERTIES.SHADOW_SICKNESS_IMMUNITY.Hyperlink}[bullet/]Enquanto em terreno de {GLOBAL.GloomTerrainConcept.Hyperlink}, as unidades ganham:[bulletlist][bullet/]+{UMBRAL_FLESH_MORALE>MoraleBonus} {GLOBAL.UnitMoraleConcept.Hyperlink}[bullet/]+{GLOOM_SHEPHERD_HEALTH_REGEN>BONUS>Regen} {GLOBAL.HitPointConcept.Hyperlink} por {GLOBAL.TurnConcept.Hyperlink} no mapa-múndi.[/bulletlist][bullet/]<<m:{GLOBAL.CityConcept.Hyperlink}>> da raça:[bulletlist][bullet/]Ganham +{KnowledgeAmount} de renda de {GLOBAL.KnowledgeConcept.Hyperlink} para cada província com terreno de Escuridão.[bullet/]Ignoram penalidades de {GLOBAL.CityStabilityConcept.Hyperlink} de terreno de Escuridão.[/bulletlist][bullet/]Unidades de Herói ganham {GLOBAL.PROPERTIES.GLOOM_SHEPHERD.Hyperlink}.[/bulletlist][br/]Esta transformação é incompatível com {GLOBAL.SPECIAL_OPERATIONS.PURE_SOUL.Hyperlink}."

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@SKILL5@NAME"
msgstr "Carne Umbral"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@SKILL5@PROPERTY_DESCRIPTION"
msgstr "Esta unidade possui {GLOBAL.PROPERTIES.SHADOW_SICKNESS_IMMUNITY.Hyperlink} e enquanto em terreno de {GLOBAL.GloomTerrainConcept.Hyperlink}:[bulletlist][bullet/]+{UMBRAL_FLESH_MORALE>MoraleBonus} {GLOBAL.UnitMoraleConcept.Hyperlink}[bullet/]+{GLOOM_SHEPHERD_HEALTH_REGEN>BONUS>Regen} {GLOBAL.HitPointConcept.Hyperlink} por {GLOBAL.TurnConcept.Hyperlink} no mapa-múndi.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@SKILL6@DESCRIPTION"
msgstr "Todas as <<m:{GLOBAL.UnitConcept.Hyperlink}>> em seu {GLOBAL.EmpireConcept.Hyperlink} ganham {GLOBAL.PROPERTIES.SHADOW_SICKNESS_IMMUNITY.Hyperlink}."

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@SKILL6@NAME"
msgstr "Ritual do Véu Sombrio"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@TOME@DESCRIPTION"
msgstr "Esses benefícios podem ser comprados em uma {GLOBAL.UmbralDwellingConcept.Hyperlink} ao estabelecer um {GLOBAL.EldritchPactConcept.Hyperlink} com eles. Eles ajudam seu Império a se adaptar ao {GLOBAL.UmbralAbyssConcept.Hyperlink} e espalhar {GLOBAL.GloomTerrainConcept.Hyperlink}."

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@TOME@NAME"
msgstr "Pacto Arcano"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSSTOME_UMBRAL_ABYSS@SKILL2@NAME"
msgstr "Transformação Andarilho das Trevas"

msgid "DLC@ELDRITCHREALMS@TRAITS_BACKGROUND_CHARACTERS@ELDRITCH01@DESCRIPTION"
msgstr "{GLOBAL.LeaderConcept.Hyperlink} começa com:[bulletlist][bullet/]Uma {GLOBAL.EQUIPMENT.RELIC_OF_MIND.Hyperlink}, uma arma de longo alcance que causa {GLOBAL.PhysicalDamageConcept.Hyperlink} e ignora as defesas inimigas.[bullet/]{GLOBAL.PROPERTIES.DELIRIUM.Hyperlink}, uma habilidade que torna uma unidade vulnerável e incontrolável.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TRAITS_BACKGROUND_CHARACTERS@ELDRITCH01@NAME"
msgstr "{LOC.INTERFACE@TEXT@CLASS@MAGE} Relíquia da Mente"

msgid "DLC@ELDRITCHREALMS@TRAITS_BACKGROUND_CHARACTERS@ELDRITCH02@DESCRIPTION"
msgstr "{GLOBAL.LeaderConcept.Hyperlink} começa com:[bulletlist][bullet/]Uma {GLOBAL.EQUIPMENT.RELIC_OF_FLESH.Hyperlink}, uma arma de longo alcance que causa {GLOBAL.BlightDamageConcept.Hyperlink} e inflige {GLOBAL.PROPERTIES.DECAYING.Hyperlink} e {GLOBAL.PROPERTIES.POISONED.Hyperlink}.[bullet/]{GLOBAL.SKILLS.ELDRITCH_RITUALS.Hyperlink}, uma habilidade de herói que concede feitiços econômicos custando <<m:{GLOBAL.ThrallConcept.Hyperlink}>>.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TRAITS_BACKGROUND_CHARACTERS@ELDRITCH02@NAME"
