msgid "DLC@GIANTKINGS@REALM_TRAIT@CRYSTAL_DWELLING@NAME"
msgstr "Morada de Cristal"

msgid "DLC@GIANTKINGS@REALM_TRAIT@MRN_MOUNTAIN_KING@DESCRIPTION"
msgstr "Este reino já fez parte do lendário reino dos Gigantes chamado {GLOBAL.MyrridaLoreConcept.Hyperlink}.[br/][bulletlist][bullet/]Há Regiões Fadadas presentes no mapa que oferecem cadeias de missões explorando o presente e o passado de {GLOBAL.MyrridaLoreConcept.Hyperlink}.[bullet/]Ganhe <<m:{GLOBAL.ArtifactConcept.Hyperlink}>> ao completar Regiões Fadadas, que concedem bônus únicos e podem ser coletados para iniciar Acontecimentos impactantes.[bullet/]Regiões Fadadas são afetadas por {GLOBAL.PROPERTIES.WARDED_BY_FATE.Hyperlink}.[bullet/]Apenas algumas das Regiões Fadadas disponíveis estarão presentes, deixando mais para serem exploradas em outro reino.[/bulletlist]"

msgid "DLC@GIANTKINGS@REALM_TRAIT@MRN_MOUNTAIN_KING@NAME"
msgstr "Lendas de Myrrida"

msgid "DLC@GIANTKINGS@REALM_TRAIT@TSR_SET_01@NAME"
msgstr "Conjunto TSR: Herdeiros dos Reis Gigantes (NÃO ENVIAR ISTO)"

