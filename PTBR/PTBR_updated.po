msgstr "[hyperlink,GLOBAL.AyaLoreConcept]Aya, a Iluminada^F[/hyperlink]"

msgid "INTERFACE@LORE_CONCEPT@AYA@NAME"
msgstr "Aya, a Iluminada^F"

