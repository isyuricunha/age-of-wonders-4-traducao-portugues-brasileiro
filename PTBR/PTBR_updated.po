msgid "COMBATPROPERTIES_TACTICAL@POISONED_TREE@NAME"
msgstr "Árvore Envenenada"

msgid "COMBATPROPERTIES_TACTICAL@POISON_ANTIDOTES@DESCRIPTION"
msgstr "Até o fim do combate, todas as habilidades de suporte das unidades atacantes irão dissipar {GLOBAL.PROPERTIES.POISONED.Hyperlink} no(s) alvo(s)."

msgid "COMBATPROPERTIES_TACTICAL@POISON_ANTIDOTES@NAME"
msgstr "Antídotos contra Veneno"

msgid "COMBATPROPERTIES_TACTICAL@PREDICTED_CRASHING_RUBBLE@NAME"
msgstr "Escombros em Queda Previsíveis"

msgid "COMBATPROPERTIES_TACTICAL@PRIMA_MATERIA@DESCRIPTION"
msgstr "Todos os Golems defensores ganham {GLOBAL.PROPERTIES.FIERY_REBIRTH.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@PRIMA_MATERIA@NAME"
msgstr "Reconstrução Flamejante"

msgid "COMBATPROPERTIES_TACTICAL@PRIMA_MATERIA_ATTACK_REBIRTH@DESCRIPTION"
msgstr "Todas as unidades atacantes de Nível 1 a Nível 3 ganham {GLOBAL.PROPERTIES.FIERY_REBIRTH.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@PRIMA_MATERIA_ATTACK_REBIRTH@NAME"
msgstr "Renascimento Menor"

msgid "COMBATPROPERTIES_TACTICAL@PRIMA_MATERIA_FIRE_RES@DESCRIPTION"
msgstr "Todas as unidades atacantes iniciam o combate com {value} de {GLOBAL.FireResistanceConcept.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@PRIMA_MATERIA_FIRE_RES@NAME"
msgstr "Proteção Avançada contra Fogo"

msgid "COMBATPROPERTIES_TACTICAL@PRIMA_MATERIA_GILDED@DESCRIPTION"
msgstr "A cada {value} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, um Golem no lado defensor se torna {GLOBAL.PROPERTIES.GILDED.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@PRIMA_MATERIA_GILDED@NAME"
msgstr "Constructo Dourado"

msgid "COMBATPROPERTIES_TACTICAL@PRIMA_MATERIA_NO_FIRE@DESCRIPTION"
msgstr "Todos os Golems defensores ganham {GLOBAL.PROPERTIES.FIERY_REBIRTH.Hyperlink}, mas a {GLOBAL.PROPERTIES.FIERY_REBIRTH.Hyperlink} não causa {GLOBAL.FireDamageConcept.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@PRIMA_MATERIA_NO_FIRE@NAME"
msgstr "Reconstrução Resfriada"

msgid "COMBATPROPERTIES_TACTICAL@PRIMA_MATERIA_RETALIATION@DESCRIPTION"
msgstr "Todas as unidades atacantes ganham {GLOBAL.PROPERTIES.HS_DEFENSE_DEFENSE.Hyperlink} extra contra <<m:{GLOBAL.RetaliationConcept.Name}>>."

msgid "COMBATPROPERTIES_TACTICAL@PRIMA_MATERIA_RETALIATION@NAME"
msgstr "Reorganizar Tropas"

msgid "COMBATPROPERTIES_TACTICAL@RAINFALL@DESCRIPTION"
msgstr "Chuva contínua deixa todas as unidades {GLOBAL.PROPERTIES.WET.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@RAINFALL@NAME"
msgstr "Precipitação"

msgid "COMBATPROPERTIES_TACTICAL@RAMPANT_FLORA@DESCRIPTION"
msgstr "Há vários obstáculos de Flora {GLOBAL.ObscuringConcept.Hyperlink} extras presentes no combate."

msgid "COMBATPROPERTIES_TACTICAL@RAMPANT_FLORA@NAME"
msgstr "Flora Exuberante"

msgid "COMBATPROPERTIES_TACTICAL@RAZED@DESCRIPTION"
msgstr "Este local foi arrasado ou saqueado. Muitos obstáculos estão danificados, destruídos ou pegando fogo."

msgid "COMBATPROPERTIES_TACTICAL@RAZED@NAME"
msgstr "Arrasado"

msgid "COMBATPROPERTIES_TACTICAL@REVEALED_TRAPS@DESCRIPTION"
msgstr "Várias armadilhas foram reveladas no mapa! Se uma unidade passar por cima delas, sofrerá {GLOBAL.PROPERTIES.BLEEDING.Hyperlink} por {turns} <<m:{GLOBAL.TurnConcept}>> e revelará a armadilha! [br/][br/]Não afeta unidades com {GLOBAL.PROPERTIES.FLOATING_MOVEMENT.Hyperlink}, {GLOBAL.PROPERTIES.FLYING_MOVEMENT.Hyperlink} ou {GLOBAL.PROPERTIES.ETHEREAL.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@REVEALED_TRAPS@NAME"
msgstr "Armadilhas Reveladas"

msgid "COMBATPROPERTIES_TACTICAL@SEIZED_DEMONIC_SUMMONING@DESCRIPTION"
msgstr "O atacante tomou controle do ritual! Em {turns} [turn/], um {GLOBAL.UNITS.BALOR.Hyperlink} com {GLOBAL.PROPERTIES.BERSERK.Hyperlink} se juntará ao atacante até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@SILVERTONGUE_WHISPERS@DESCRIPTION"
msgstr "A cada {turn} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, uma das unidades atacantes tem {chance}% de chance base de sofrer {GLOBAL.PROPERTIES.DISTRACTED.Hyperlink} até o fim do combate."

msgid "COMBATPROPERTIES_TACTICAL@SILVERTONGUE_WHISPERS@NAME"
msgstr "Sussurros Distrativos"

msgid "COMBATPROPERTIES_TACTICAL@SILVER_KNIGHT@DESCRIPTION"
msgstr "O duelista sofre dano reduzido de todas as unidades, exceto do líder do exército inimigo."

msgid "COMBATPROPERTIES_TACTICAL@SILVER_KNIGHT@NAME"
msgstr "Proteção do Duelista"

msgid "COMBATPROPERTIES_TACTICAL@SILVER_KNIGHT_TAUNT@DESCRIPTION"
msgstr "Os exércitos atacantes {GLOBAL.PROPERTIES.EXPEDITIONLEADER.Hyperlink} <<m:{GLOBAL.PROPERTIES.TAUNT.Hyperlink}>> o Cavaleiro de Prata até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@SILVER_KNIGHT_TAUNT@NAME"
msgstr "Provocando o Cavaleiro"

msgid "COMBATPROPERTIES_TACTICAL@SKELETON_SUMMON_ON_DEATH@DESCRIPTION"
msgstr "Sempre que um obstáculo de Sarcófago é destruído, ele invoca um {GLOBAL.UNITS.SKELETON_UNIT.Hyperlink} no lado do defensor até o fim do combate."

msgid "COMBATPROPERTIES_TACTICAL@SKELETON_SUMMON_ON_DEATH@NAME"
msgstr "Caixões Assombrados"

msgid "COMBATPROPERTIES_TACTICAL@SLAVE_REVOLT@DESCRIPTION"
msgstr "No início da batalha, alguns unidades de Cão de Guerra com {GLOBAL.PROPERTIES.BERSERK.Hyperlink} se juntam à luta adjacentes às unidades defensoras."

msgid "COMBATPROPERTIES_TACTICAL@SLAVE_REVOLT@NAME"
msgstr "Animais Fugitivos"

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_INSANE_IMMUNITY@DESCRIPTION"
msgstr "Todas as unidades atacantes são imunes a {GLOBAL.PROPERTIES.INSANITY.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_INSANE_IMMUNITY@NAME"
msgstr "Estabilidade Mental"

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_IN_SHADOW@DESCRIPTION"
msgstr "A cada {GLOBAL.TurnConcept.Hyperlink}, 1 unidade atacante é alvo; se ela tiver {GLOBAL.LowMoraleConcept.Hyperlink}, ganha {GLOBAL.PROPERTIES.INSANITY.Hyperlink}, caso contrário, perde {value} de {GLOBAL.UnitMoraleConcept.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_IN_SHADOW@NAME"
msgstr "Presença do Rei Morto"

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_IN_SHADOW_DISTRACTED@DESCRIPTION"
msgstr "Fica imune ao efeito {GLOBAL.PROPERTIES.SLOWED.Hyperlink} do Rei Morto, mas inicia o combate {GLOBAL.PROPERTIES.DISTRACTED.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_IN_SHADOW_DISTRACTED@NAME"
msgstr "Imunidade a Lentidão"

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_IN_SHADOW_FROST_RESISTANCE@DESCRIPTION"
msgstr "Todas as unidades atacantes iniciam o combate com {value} de {GLOBAL.FrostResistanceConcept.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_IN_SHADOW_FROST_RESISTANCE@NAME"
msgstr "Proteção contra Gelo"

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_IN_SHADOW_INSANE_IMMUNE@DESCRIPTION"
msgstr "Esta unidade é imune a {GLOBAL.PROPERTIES.INSANITY.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_IN_SHADOW_INSANE_IMMUNE@NAME"
msgstr "Imunidade à Insanidade"

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_IN_SHADOW_RALLY@DESCRIPTION"
msgstr "As habilidades de suporte dos atacantes concedem um efeito de {GLOBAL.PROPERTIES.RALLYING.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_IN_SHADOW_RALLY@NAME"
msgstr "Suporte Inspirador"

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_IN_SHADOW_SLOWED@DESCRIPTION"
msgstr "O Rei Morto inflige {GLOBAL.PROPERTIES.SLOWED.Hyperlink} em acertos."

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_IN_SHADOW_SLOWED@NAME"
msgstr "Letargia"

msgid "COMBATPROPERTIES_TACTICAL@SLOWED_ARMY@DESCRIPTION"
msgstr "No início da batalha, todas as unidades atacantes ficam {GLOBAL.PROPERTIES.SLOWED.Hyperlink} por {time} [turno/]."

msgid "COMBATPROPERTIES_TACTICAL@SLOWED_ARMY@NAME"
msgstr "Atacantes Lentos"

msgid "COMBATPROPERTIES_TACTICAL@SLOWED_ENEMIES@DESCRIPTION"
msgstr "No início da batalha, todas as unidades defensoras ficam {GLOBAL.PROPERTIES.SLOWED.Hyperlink} por {time} [turno/]."

msgid "COMBATPROPERTIES_TACTICAL@SLOWED_ENEMIES@NAME"
msgstr "Defensores Lentos"

msgid "COMBATPROPERTIES_TACTICAL@SLUMBERING_SOULS@DESCRIPTION"
msgstr "A cada {time} [turno/], uma unidade atacante fica {GLOBAL.PROPERTIES.HAUNTED.Hyperlink}.[br/][br/]Se uma unidade {GLOBAL.PROPERTIES.HAUNTED.Hyperlink} estiver adjacente a um obstáculo Sarcófago, o Sarcófago é destruído e invocará uma unidade Esqueleto {GLOBAL.UnitConcept.Hyperlink} no lado do defensor."

msgid "COMBATPROPERTIES_TACTICAL@SLUMBERING_SOULS@NAME"
msgstr "Esqueletos Agitados"

msgid "COMBATPROPERTIES_TACTICAL@SLUMBERING_SOULS@PROPERTY@DESCRIPTION"
msgstr "Quando este efeito expirar, qualquer obstáculo Sarcófago adjacente será destruído e invocará uma unidade Esqueleto {GLOBAL.UnitConcept.Hyperlink} no lado do defensor."

msgid "COMBATPROPERTIES_TACTICAL@SLUMBERING_SOULS@PROPERTY@NAME"
msgstr "Assombrado"

msgid "COMBATPROPERTIES_TACTICAL@SLUMBERING_SOULS_DELAYED@NAME"
msgstr "Esqueletos Agitados Tardios"

msgid "COMBATPROPERTIES_TACTICAL@SOOTHING_WELLSPRING@DESCRIPTION"
msgstr "Unidades que estiverem {GLOBAL.PROPERTIES.WET.Hyperlink} recuperarão 5 [hp/] Pontos de Vida no início de seu turno."

msgid "COMBATPROPERTIES_TACTICAL@SOOTHING_WELLSPRING@NAME"
msgstr "Nascente Reconfortante"

msgid "COMBATPROPERTIES_TACTICAL@SPELL@DESCRIPTION"
msgstr "Adiciona {combatproperty} à batalha."

msgid "COMBATPROPERTIES_TACTICAL@SPIDERLAIR@DESCRIPTION"
msgstr "No início do combate, vários obstáculos de {GLOBAL.SlowingConcept.Hyperlink} Teia de Aranha estão presentes."

msgid "COMBATPROPERTIES_TACTICAL@SPIDERLAIR@NAME"
msgstr "Teias de Aranha Expansivas"

msgid "COMBATPROPERTIES_TACTICAL@SPLITTING_MAGMA@DESCRIPTION"
msgstr "Quando um {GLOBAL.UNITS.MAGMA_SPIRIT.Hyperlink} defensor é morto, ele gera {amount} <<m:{GLOBAL.UNITS.LESSER_MAGMA_SPIRIT.Hyperlink}>>."

msgid "COMBATPROPERTIES_TACTICAL@SPLITTING_MAGMA@NAME"
msgstr "Divisão de Magma"

msgid "COMBATPROPERTIES_TACTICAL@SPRINGS_GROWTH@DESCRIPTION"
msgstr "Cada vez que as unidades do dono sofrem dano, elas ganham {amount} acúmulo(s) de {GLOBAL.PROPERTIES.REGENERATION.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@SPRINGS_GROWTH@NAME"
msgstr "Crescimento Primaveril"

msgid "COMBATPROPERTIES_TACTICAL@SPRINGS_GROWTH@SECTOR_DISPLAY@DESCRIPTION"
msgstr "{GLOBAL.PROPERTIES.COMBATPROPERTY_FEY_SPRING.Hyperlink} is active in this province."

msgid "COMBATPROPERTIES_TACTICAL@SPRINGS_GROWTH@SECTOR_DISPLAY@NAME"
msgstr "Domain of Spring"

msgid "COMBATPROPERTIES_TACTICAL@SPRINGS_GROWTH@SPELL_DESCRIPTION"
msgstr "Adiciona {GLOBAL.PROPERTIES.COMBATPROPERTY_FEY_SPRING.Hyperlink} à batalha."

msgid "COMBATPROPERTIES_TACTICAL@STATUS_RESISTANCE_ARMY@DESCRIPTION"
msgstr "Unidades atacantes têm {amount}{GLOBAL.StatusResistanceConcept.Hyperlink} até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@STATUS_RESISTANCE_ENEMIES@DESCRIPTION"
msgstr "Unidades defensoras têm {amount}{GLOBAL.StatusResistanceConcept.Hyperlink} até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@STRENGTHENED_ARMY@DESCRIPTION"
msgstr "Os ataques de todas as unidades atacantes causam {damage} de dano até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@STRENGTHENED_ARMY@NAME"
msgstr "Atacantes Fortalecidos"

msgid "COMBATPROPERTIES_TACTICAL@STRENGTHENED_ENEMIES@DESCRIPTION"
msgstr "Os ataques de todas as unidades defensoras causam {damage} de dano até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@STRENGTHENED_ENEMIES@NAME"
msgstr "Defensores Fortalecidos"

msgid "COMBATPROPERTIES_TACTICAL@SUMMERS_HEAT@DESCRIPTION"
msgstr "No início do turno do dono, unidades inimigas adjacentes às unidades do dono têm {chance}% de chance de sofrer {GLOBAL.PROPERTIES.BURNING.Hyperlink} e receber {damage} para cada acúmulo de {GLOBAL.PROPERTIES.BURNING.Hyperlink} que possuírem."

msgid "COMBATPROPERTIES_TACTICAL@SUMMERS_HEAT@NAME"
msgstr "Calor do Verão"

msgid "COMBATPROPERTIES_TACTICAL@SUMMERS_HEAT@SECTOR_DISPLAY@DESCRIPTION"
msgstr "{GLOBAL.PROPERTIES.COMBATPROPERTY_FEY_SUMMER.Hyperlink} is active in this province."

msgid "COMBATPROPERTIES_TACTICAL@SUMMERS_HEAT@SECTOR_DISPLAY@NAME"
msgstr "Domain of Summer"

msgid "COMBATPROPERTIES_TACTICAL@SUNDERED_ARMOR_ARMY@DESCRIPTION"
msgstr "Todas as unidades atacantes têm {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink} até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@SUNDERED_ARMOR_ARMY@NAME"
msgstr "Atacantes Indefesos"

msgid "COMBATPROPERTIES_TACTICAL@SUNDERED_ARMOR_ENEMIES@DESCRIPTION"
msgstr "Todas as unidades defensoras têm {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink} até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@SUNDERED_ARMOR_ENEMIES@NAME"
msgstr "Defensores Indefesos"

msgid "COMBATPROPERTIES_TACTICAL@SUNDERED_RESISTANCE_ARMY@DESCRIPTION"
msgstr "Todas as unidades atacantes têm {GLOBAL.PROPERTIES.SUNDERED_RESISTANCE.Hyperlink} até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@SUNDERED_RESISTANCE_ARMY@NAME"
msgstr "Atacantes Vulneráveis"

msgid "COMBATPROPERTIES_TACTICAL@SUNDERED_RESISTANCE_ENEMIES@DESCRIPTION"
msgstr "Todas as unidades defensoras têm {GLOBAL.PROPERTIES.SUNDERED_RESISTANCE.Hyperlink} até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@SUNDERED_RESISTANCE_ENEMIES@NAME"
msgstr "Defensores Vulneráveis"

msgid "COMBATPROPERTIES_TACTICAL@SUNDERED_STATUS_RESISTANCE_ARMY@NAME"
msgstr "Atacantes com Resistência a Efeitos de Status Despedaçada"

msgid "COMBATPROPERTIES_TACTICAL@SUNDERED_STATUS_RESISTANCE_ENEMIES@NAME"
msgstr "Defensores com Resistência a Efeitos de Status Despedaçada"

msgid "COMBATPROPERTIES_TACTICAL@THE_ONE@DESCRIPTION"
msgstr "A cada {GLOBAL.TurnConcept.Hyperlink}, as unidades do atacante perdem {MoraleValue} de moral."

msgid "COMBATPROPERTIES_TACTICAL@THE_ONE@NAME"
msgstr "O Lamento"

msgid "COMBATPROPERTIES_TACTICAL@UNDEADQUEEN@DESCRIPTION"
msgstr "Matar a Rainha Morta-Viva matará imediatamente todos os seus [abilityred]Servos Mortos-Vivos[/abilityred]."

msgid "COMBATPROPERTIES_TACTICAL@UNDEADQUEEN@NAME"
msgstr "Rainha Morta-Viva"

msgid "COMBATPROPERTIES_TACTICAL@WAVE_OF_TRANQUILITY@DESCRIPTION"
msgstr "A cada {turn} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, todos os Efeitos de Status em todas as unidades são dissipados."

msgid "COMBATPROPERTIES_TACTICAL@WAVE_OF_TRANQUILITY@NAME"
msgstr "Onda de Tranquilidade"

msgid "COMBATPROPERTIES_TACTICAL@WEAKENED_ARMY@DESCRIPTION"
msgstr "Todas as unidades atacantes ficam {GLOBAL.PROPERTIES.WEAKENED.Hyperlink} até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@WEAKENED_ARMY@NAME"
msgstr "Atacantes Enfraquecidos"

msgid "COMBATPROPERTIES_TACTICAL@WEAKENED_ENEMIES@DESCRIPTION"
msgstr "Todas as unidades defensoras ficam {GLOBAL.PROPERTIES.WEAKENED.Hyperlink} até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@WEAKENED_ENEMIES@NAME"
msgstr "Defensores Enfraquecidos"

msgid "COMBATPROPERTIES_TACTICAL@WINTERS_SORROW@DESCRIPTION"
msgstr "Unidades inimigas sofrem {amount} acúmulo(s) de {GLOBAL.PROPERTIES.DEMORALIZED.Hyperlink} sempre que matarem outra unidade."

msgid "COMBATPROPERTIES_TACTICAL@WINTERS_SORROW@NAME"
msgstr "Tristeza do Inverno"

msgid "COMBATPROPERTIES_TACTICAL@WINTERS_SORROW@SECTOR_DISPLAY@DESCRIPTION"
msgstr "{GLOBAL.PROPERTIES.COMBATPROPERTY_FEY_WINTER.Hyperlink} is active in this province."

msgid "COMBATPROPERTIES_TACTICAL@WINTERS_SORROW@SECTOR_DISPLAY@NAME"
msgstr "Domain of Winter"

msgid "COMBAT_TUTORIAL@ACCURACY@DESCRIPTION"
msgstr "Esta {GLOBAL.UnitConcept.Hyperlink} tem uma habilidade à distância selecionada. Habilidades à distância possuem uma classificação de {GLOBAL.AccuracyConcept}, que é a chance da habilidade acertar o alvo pretendido."

msgid "COMBAT_TUTORIAL@ACCURACY@DESCRIPTION_SECONDARY"
msgstr "Se uma habilidade errar, ela atingirá outro alvo ou não fará nada. Algumas habilidades também podem roçar, o que significa que a habilidade afetou o alvo, mas com força reduzida."

msgid "COMBAT_TUTORIAL@ACCURACY@TITLE"
msgstr "Precisão"

msgid "COMBAT_TUTORIAL@ACTION_POINTS@DESCRIPTION"
msgstr "Você selecionou uma {GLOBAL.UnitConcept.Hyperlink}. Ela tem 3 <<m:{GLOBAL.ActionPointConcept}>> para gastar em movimento e uso de habilidades."

msgid "COMBAT_TUTORIAL@ACTION_POINTS@DESCRIPTION_SECONDARY"
msgstr "Habilidades diferentes têm custos diferentes de [actionpoint/] pontos de ação, e algumas são acionadas uma vez por ponto de ação disponível. Usar uma habilidade quase sempre encerrará o turno de uma unidade![br/][br/]Ao planejar o movimento, você pode ver o número de [fullaction/] pontos de ação que terá disponível no destino."

msgid "COMBAT_TUTORIAL@ACTION_POINTS@TITLE"
msgstr "Pontos de Ação"

msgid "COMBAT_TUTORIAL@AI_TAKEOVER_NPC@DESCRIPTION"
msgstr "Você assumiu temporariamente o comando de um exército Independente.[br/][br/]Enquanto estiver no controle de uma {GLOBAL.IndependentCityConcept.Hyperlink} ou <<m:GLOBAL.MarauderConcept.Hyperlink>>, você poderá dar ordens às suas <<m:GLOBAL.UnitConcept.Hyperlink>>. A habilidade de lançar <<m:GLOBAL.CombatSpellConcept.Hyperlink>> fica desativada durante o turno Independente."

msgid "COMBAT_TUTORIAL@AI_TAKEOVER_NPC@TITLE"
msgstr "Tomada de Controle em Combate: Independentes"

msgid "COMBAT_TUTORIAL@AI_TAKEOVER_PLAYER@DESCRIPTION"
msgstr "Você assumiu temporariamente o comando de um exército pertencente a um {GLOBAL.LeaderConcept.Hyperlink} controlado pela IA.[br/][br/]Ao assumir o controle de um Governante da IA, você pode comandar suas <<m:GLOBAL.UnitConcept.Hyperlink>> e usar seus <<m:GLOBAL.CombatSpellConcept.Hyperlink>> durante o combate."

msgid "COMBAT_TUTORIAL@AI_TAKEOVER_PLAYER@TITLE"
msgstr "Tomada de Controle em Combate: Governante da IA"

msgid "COMBAT_TUTORIAL@BATTLE_MAGE_UNITS@DESCRIPTION"
msgstr "Esta é uma {GLOBAL.UnitConcept.Hyperlink} Mago de Batalha, que se destaca em causar dano mágico e aplicar efeitos de status. É vulnerável a ataques {GLOBAL.MeleeConcept} e deve ser mantida na linha de trás."

msgid "COMBAT_TUTORIAL@BATTLE_MAGE_UNITS@TITLE"
msgstr "[unitBattleMage/]Unidades de Mago de Batalha"

msgid "COMBAT_TUTORIAL@CASUALTIES@DESCRIPTION"
msgstr "Esta {GLOBAL.UnitConcept.Hyperlink} sofreu <<m:{GLOBAL.CasualtyConcept}>>. Baixas ocorrem quando uma unidade recebe dano, o que também faz com que ela cause menos dano com seus ataques."

msgid "COMBAT_TUTORIAL@CASUALTIES@DESCRIPTION_SECONDARY"
msgstr "Unidades representadas por uma única figura, como <<m:{GLOBAL.HeroConcept}>> e gigantes, são imunes a baixas."

msgid "COMBAT_TUTORIAL@CASUALTIES@TITLE"
msgstr "Baixas"

msgid "COMBAT_TUTORIAL@COMBAT_STARTS@DESCRIPTION"
msgstr "Bem-vindo ao campo de batalha! Aqui, você deve matar ou dispersar seus inimigos para reivindicar a vitória."

msgid "COMBAT_TUTORIAL@COMBAT_STARTS@DESCRIPTION_SECONDARY"
msgstr "O {GLOBAL.ArmyConcept} defensor sempre age primeiro, seguido pelo exército atacante."

msgid "COMBAT_TUTORIAL@COMBAT_STARTS@TITLE"
msgstr "Batalha Começa"

msgid "COMBAT_TUTORIAL@FLANKING@DESCRIPTION"
msgstr "Sua {GLOBAL.UnitConcept.Hyperlink} acabou de atacar um inimigo pelas costas. Isso é chamado de {GLOBAL.FlankingConcept}, e concede um bônus de dano."

msgid "COMBAT_TUTORIAL@FLANKING@DESCRIPTION_SECONDARY"
msgstr "Lembre-se de que unidades em {GLOBAL.DefenseModeConcept.Hyperlink} não podem ser flanqueadas!"

msgid "COMBAT_TUTORIAL@FLANKING@TITLE"
msgstr "Ataques de Flanco"

msgid "COMBAT_TUTORIAL@LEADER@DESCRIPTION"
msgstr "Você selecionou seu {GLOBAL.LeaderConcept}. Seu Governante é um combatente poderoso que pode empunhar equipamentos mágicos e aprender uma variedade de habilidades."

msgid "COMBAT_TUTORIAL@LEADER@DESCRIPTION_SECONDARY"
msgstr "Se seu Governante [hyperlink,GLOBAL.RulerVoidConcept]cair[/hyperlink] em combate, ele retornará à sua {GLOBAL.ThroneCityConcept.Hyperlink} após um curto período."

msgid "COMBAT_TUTORIAL@LEADER@TITLE"
msgstr "[unitRuler/]Governantes em Batalha"

msgid "COMBAT_TUTORIAL@LOW_MORALE@DESCRIPTION"
msgstr "Uma {GLOBAL.UnitConcept.Hyperlink} está com [hyperlink,GLOBAL.LowMoraleConcept]Moral Baixa[/hyperlink], pois a maré da batalha está virando contra ela. Unidades com moral baixa podem {GLOBAL.FumbleConcept} ataques, enquanto moral alta pode levar a [hyperlink,GLOBAL.CriticalHitConcept]Ataques Críticos[/hyperlink]."

msgid "COMBAT_TUTORIAL@LOW_MORALE@DESCRIPTION_SECONDARY"
msgstr "Se a moral de uma unidade cair demais, ela começará a {GLOBAL.RoutingConcept.Hyperlink} e fugirá do campo de batalha."

msgid "COMBAT_TUTORIAL@LOW_MORALE@TITLE"
msgstr "Moral da Unidade"

msgid "COMBAT_TUTORIAL@MAGIC_FIGHTER_UNITS@DESCRIPTION"
msgstr "Esta é uma {GLOBAL.UnitConcept.Hyperlink} Lutador Mágico, um combatente de linha de frente em corpo a corpo. Ela é especializada em ataques de {GLOBAL.MagicConcept.Hyperlink}, sendo ideal para causar dano em unidades com alta {GLOBAL.DefenseConcept.Hyperlink}, como Unidades com Escudo."

msgid "COMBAT_TUTORIAL@MAGIC_FIGHTER_UNITS@TITLE"
msgstr "[unitMagicFighter/]Unidades de Lutador Mágico"

msgid "COMBAT_TUTORIAL@POLEARM_UNIT@DESCRIPTION"
msgstr "Esta é uma {GLOBAL.UnitConcept.Hyperlink} de Arma de Haste, um combatente de linha de frente em corpo a corpo. Com suas habilidades de {GLOBAL.FirstStrikeConcept} e Resistência a [hyperlink,GLOBAL.ChargeConcept]Carga[/hyperlink], ela é perfeitamente adequada para absorver ataques {GLOBAL.MeleeConcept} inimigos."

msgid "COMBAT_TUTORIAL@POLEARM_UNIT@TITLE"
msgstr "[unitPolearm/]Unidades de Arma de Haste"

msgid "COMBAT_TUTORIAL@RANGED_UNIT@DESCRIPTION"
msgstr "Esta é uma {GLOBAL.UnitConcept.Hyperlink} à Distância, que se destaca em causar dano físico de longe. Ela é vulnerável a ataques {GLOBAL.MeleeConcept} e deve ser mantida na linha de trás."

msgid "COMBAT_TUTORIAL@RANGED_UNIT@TITLE"
msgstr "[unitRanged/]Unidades à Distância"

msgid "COMBAT_TUTORIAL@RETALIATION@DESCRIPTION"
msgstr "Uma {GLOBAL.UnitConcept.Hyperlink} acabou de ser atingida por uma {GLOBAL.RetaliationConcept.Hyperlink}. Isso acontece quando uma unidade {GLOBAL.MeleeConcept} é atacada dentro de sua Zona de Controle."

msgid "COMBAT_TUTORIAL@RETALIATION@DESCRIPTION_SECONDARY"
msgstr "Uma unidade tem um número limitado de <<m:{GLOBAL.RetaliationConcept.Hyperlink}>> por turno, indicado por marcas vermelhas sob sua bandeira."

msgid "COMBAT_TUTORIAL@RETALIATION@TITLE"
msgstr "Retaliação"

msgid "COMBAT_TUTORIAL@SCOUT_UNIT@DESCRIPTION"
msgstr "Este é um {GLOBAL.UnitConcept.Hyperlink} Batedor, que é fraco e deve ser mantido fora de batalha. Se forçado a lutar, sua alta velocidade e ataques à distância o tornam uma boa unidade para {GLOBAL.FlankingConcept}."

msgid "COMBAT_TUTORIAL@SCOUT_UNIT@TITLE"
msgstr "[unitScout/]Unidades Batedoras"

msgid "COMBAT_TUTORIAL@SHIELD_UNIT@DESCRIPTION"
msgstr "Este é um {GLOBAL.UnitConcept.Hyperlink} Escudeiro, um lutador de linha de frente em {GLOBAL.MeleeConcept}. Ao entrar no {GLOBAL.DefenseModeConcept}, concede um bônus a aliados adjacentes, protegendo-os contra dano físico."

msgid "COMBAT_TUTORIAL@SHIELD_UNIT@TITLE"
msgstr "[unitShield/]Unidades Escudeiras"

msgid "COMBAT_TUTORIAL@SHOCK_UNITS@DESCRIPTION"
msgstr "Este é um {GLOBAL.UnitConcept.Hyperlink} Choque, um lutador corpo a corpo poderoso especializado em <<m:{GLOBAL.ChargeConcept}>> de alto dano. Seus ataques podem cancelar o {GLOBAL.DefenseModeConcept}, tornando-o forte contra Unidades Escudeiras e Unidades de Suporte."

msgid "COMBAT_TUTORIAL@SHOCK_UNITS@TITLE"
msgstr "[unitShock/]Unidades de Choque"

msgid "COMBAT_TUTORIAL@SKIRMISHER_UNIT@DESCRIPTION"
msgstr "Este é um {GLOBAL.UnitConcept.Hyperlink} Escaramuçador, que é flexível e usa ataques à distância e {GLOBAL.MeleeConcept}. Com sua alta velocidade e habilidade Escorregadio, é a unidade perfeita para ataques de bater e correr."

msgid "COMBAT_TUTORIAL@SKIRMISHER_UNIT@TITLE"
msgstr "[unitSkirmisher/]Unidades Escaramuçadoras"

msgid "COMBAT_TUTORIAL@SPELL_CASTING@DESCRIPTION"
msgstr "Seus Feitiços estão prontos para serem conjurados! Feitiços podem ter uma variedade de efeitos poderosos e podem virar a maré da batalha quando usados corretamente."

msgid "COMBAT_TUTORIAL@SPELL_CASTING@DESCRIPTION_SECONDARY"
msgstr "Feitiços não estão disponíveis no primeiro turno de combate e requerem {GLOBAL.ManaConcept.Hyperlink} e <<m:{GLOBAL.CombatCastingPointConcept.Hyperlink}>> para serem usados."

msgid "COMBAT_TUTORIAL@SPELL_CASTING@TITLE"
msgstr "Conjuração de Feitiços"

msgid "COMBAT_TUTORIAL@SUPPORT_UNITS@DESCRIPTION"
msgstr "Este é um {GLOBAL.UnitConcept.Hyperlink} de Suporte, que pode usar habilidades mágicas para curar e fortalecer seus aliados."

msgid "COMBAT_TUTORIAL@SUPPORT_UNITS@INSTRUCTION"
msgstr "Ao entrar no {GLOBAL.DefenseModeConcept.Hyperlink}, concede um bônus a aliados adjacentes, protegendo-os contra ataques mágicos."

msgid "COMBAT_TUTORIAL@SUPPORT_UNITS@TITLE"
msgstr "[unitSupport/]Unidades de Suporte"

msgid "COMBAT_TUTORIAL@ZONE_OF_CONTORL@DESCRIPTION"
msgstr "Sua {GLOBAL.UnitConcept.Hyperlink} está na Zona de Controle de um inimigo. Quando uma unidade se move para a zona de controle de um inimigo, ela fica temporariamente imobilizada e não pode se mover pelo resto do turno."

msgid "COMBAT_TUTORIAL@ZONE_OF_CONTORL@DESCRIPTION_SECONDARY"
msgstr "Mover-se para fora de uma Zona de Controle pode desencadear um {GLOBAL.OpportunityAttackConcept}.[br/][br/]Enquanto estiver em uma Zona de Controle inimiga, muitas habilidades à distância e mágicas ficarão indisponíveis."

msgid "COMBAT_TUTORIAL@ZONE_OF_CONTORL@TITLE"
msgstr "Zona de Controle"

msgid "CONCEPT@ACCURACY@DESCRIPTION"
msgstr "Precisão é a probabilidade de ataques acertarem com sucesso. Se o ataque não acertar, ele erra ou roça o alvo.[bulletlist][bullet/]Rasantes causam metade do dano.[bullet/]Erros não causam dano.[bullet/]Erros podem acertar unidades adjacentes aleatórias próximas ao alvo.[/bulletlist]"

msgid "CONCEPT@ACCURACY@HYPERLINK"
msgstr "[hyperlink,GLOBAL.AccuracyConcept][accuracy/] Precisão[/hyperlink]"

msgid "CONCEPT@ACCURACY@NAME"
msgstr "[accuracy/]Precisão"

msgid "CONCEPT@ACTION_POINTS@DESCRIPTION"
msgstr "[bulletlist][bullet/]<<m:{GLOBAL.UnitConcept.Hyperlink}>> usam Pontos de Ação para atacar e usar habilidades.[bullet/]Unidades recebem 3 Pontos de Ação por {GLOBAL.TurnConcept} e podem usar até 2 deles para se mover.[/bulletlist][br/][br/]Habilidades usam pontos de ação de diferentes maneiras:[bulletlist][bullet/][singleuseaction/] {LOC.CONCEPT@ACTION_POINTS@DESCRIPTION_SINGLE}[bullet/][repeatingaction/] {LOC.CONCEPT@ACTION_POINTS@DESCRIPTION_REPEATING}[bullet/][fullaction/]{LOC.CONCEPT@ACTION_POINTS@DESCRIPTION_FULL}[bullet/][freeaction/] {LOC.CONCEPT@ACTION_POINTS@DESCRIPTION_FREE}[bullet/][leaveoneaction/] {LOC.CONCEPT@ACTION_POINTS@DESCRIPTION_LEAVE_ONE}[bullet/][fullactioncontinue/] {LOC.CONCEPT@ACTION_POINTS@DESCRIPTION_FULL_ACTION_CONTINUE}[/bulletlist]"

msgid "CONCEPT@ACTION_POINTS@DESCRIPTION_FREE"
msgstr "Habilidade custa 0 pontos de ação."

msgid "CONCEPT@ACTION_POINTS@DESCRIPTION_FULL"
msgstr "Habilidade custa 3 pontos de ação. O turno da unidade termina em seguida."

msgid "CONCEPT@ACTION_POINTS@DESCRIPTION_FULL_ACTION_CONTINUE"
msgstr "Habilidade requer 3 pontos de ação. A unidade mantém 1 ponto de ação em seguida."

msgid "CONCEPT@ACTION_POINTS@DESCRIPTION_LEAVE_ONE"
msgstr "Habilidade custa 0 pontos de ação. A unidade mantém 1 ponto de ação em seguida."

msgid "CONCEPT@ACTION_POINTS@DESCRIPTION_REPEATING"
msgstr "A habilidade é acionada uma vez por ponto de ação restante. O turno da unidade termina em seguida."

msgid "CONCEPT@ACTION_POINTS@DESCRIPTION_SINGLE"
msgstr "A habilidade custa um único ponto de ação. O turno da unidade termina em seguida."

msgid "CONCEPT@ACTION_POINTS@HYPERLINK"
msgstr "[hyperlink,GLOBAL.ActionPointConcept]Ponto de Ação[/hyperlink]"

msgid "CONCEPT@ACTION_POINTS@NAME"
msgstr "Ponto de Ação"

msgid "CONCEPT@BASE_ABILITY@DESCRIPTION"
msgstr "Um ataque básico é um ataque normal que uma unidade geralmente pode usar a cada turno em combate.[br/][br/]Alguns <<m:{GLOBAL.UnitEnchantmentConcept.Hyperlink}>> afetam apenas os ataques básicos de uma unidade."

msgid "CONCEPT@BASE_ABILITY@HYPERLINK"
msgstr "[hyperlink,GLOBAL.BaseAbilityConcept]Básico[/hyperlink]"

msgid "CONCEPT@BASE_ABILITY@NAME"
msgstr "Ataque Básico"

msgid "CONCEPT@BLIGHT_DAMAGE@DESCRIPTION"
msgstr "Inflige [damageBlight/] Dano de Calamidade."

msgid "CONCEPT@BLIGHT_DAMAGE@HYPERLINK"
msgstr "[damageBlight/] [hyperlink,GLOBAL.BlightDamageConcept]Dano de Calamidade[/hyperlink]"

msgid "CONCEPT@BLIGHT_DAMAGE@NAME"
msgstr "Dano de Calamidade"

msgid "CONCEPT@BLIGHT_RESISTANCE@DESCRIPTION"
msgstr "Proteção contra Calamidade reduz {GLOBAL.BlightDamageConcept.Hyperlink}."

msgid "CONCEPT@BLIGHT_RESISTANCE@HYPERLINK"
msgstr "[defenseblight/] [hyperlink,GLOBAL.BlightResistanceConcept]Proteção contra Calamidade[/hyperlink]"

msgid "CONCEPT@BLIGHT_RESISTANCE@NAME"
msgstr "Proteção contra Calamidade"

msgid "CONCEPT@CASUALTIES@DESCRIPTION"
msgstr "Quando uma {GLOBAL.UnitConcept.Hyperlink} sofre dano, membros da unidade são perdidos.[br/][br/]Cada membro perdido reduz proporcionalmente o dano causado pela unidade. A chance de a unidade aplicar <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>> também é reduzida.[br/][br/]Uma unidade de {GLOBAL.LeaderConcept.Hyperlink} ou {GLOBAL.HeroConcept.Hyperlink} e monstros grandes possuem apenas um membro e não são afetados por esta regra."

msgid "CONCEPT@CASUALTIES@HYPERLINK"
msgstr "[hyperlink,GLOBAL.CasualtyConcept]Baixa[/hyperlink]"

msgid "CONCEPT@CASUALTIES@NAME"
msgstr "Baixa"

msgid "CONCEPT@CHARGE@DESCRIPTION"
msgstr "Um ataque de Carga:[bulletlist][bullet/]Ganha dano extra por hexágono percorrido, até {GLOBAL.ChargeHexes} hexágonos.[bullet/]Cancela {GLOBAL.DefenseModeConcept.Hyperlink}.[bullet/]Remove {GLOBAL.RetaliationConcept.Hyperlink}.[/bulletlist][br/][br/]Esses efeitos são anulados por {GLOBAL.PROPERTIES.CHARGE_RESISTANCE.Hyperlink}, a menos que o ataque seja um {GLOBAL.PROPERTIES.HEAVYMELEESTRIKE.Hyperlink}."

msgid "CONCEPT@CHARGE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.ChargeConcept]Carga[/hyperlink]"

msgid "CONCEPT@CHARGE@NAME"
msgstr "Carga"

msgid "CONCEPT@CHARGE_HEAVY@DESCRIPTION"
msgstr "Um ataque de Carga Pesada:[bulletlist]{LOC.CONCEPT@CHARGE_SHARED}[bullet/]Cargas Pesadas ignoram {GLOBAL.PROPERTIES.CHARGE_RESISTANCE.Hyperlink}.[/bulletlist]"

msgid "CONCEPT@CHARGE_NORMAL@DESCRIPTION"
msgstr "Um ataque de Carga:[bulletlist]{LOC.CONCEPT@CHARGE_SHARED}[/bulletlist]"

msgid "CONCEPT@CHARGE_SHARED"
msgstr "[bullet/]Ganha {CHARGE_DAMAGE_MULTIPLIER>ResolvedDamageMultiplier}% de dano por hexágono percorrido, até {GLOBAL.ChargeHexes} hexágonos.[bullet/]Cancela {GLOBAL.DefenseModeConcept.Hyperlink}.[bullet/]Remove {GLOBAL.RetaliationConcept.Hyperlink}."

msgid "CONCEPT@COMBAT_SPEED@DESCRIPTION"
msgstr "[bulletlist][bullet/]Velocidade de Combate representa a distância que uma unidade pode se mover dentro de um {GLOBAL.TurnConcept} em {GLOBAL.CombatConcept.Hyperlink}.[bullet/]Cada hexágono em combate custa {amount} ponto para atravessar.[bullet/]Terrenos com {GLOBAL.SlowingConcept.Hyperlink} custam {amount2} pontos para atravessar.[/bulletlist]"

msgid "CONCEPT@COMBAT_SPEED@HYPERLINK"
msgstr "[combatspeed/][hyperlink,GLOBAL.CombatSpeedConcept]{LOC.CONCEPT@COMBAT_SPEED@NAME}[/hyperlink]"

msgid "CONCEPT@COMBAT_SPEED@NAME"
msgstr "Velocidade de Combate"

msgid "CONCEPT@CONTROL_LOSS_IMMUNITY@DESCRIPTION"
msgstr "Imune a efeitos que fazem você perder o controle de uma unidade, como {GLOBAL.PROPERTIES.BERSERK.Hyperlink} e {GLOBAL.PROPERTIES.DOMINATED.Hyperlink}.[br/]Também concede imunidade a ser {GLOBAL.CapturedConcept.Hyperlink}."

msgid "CONCEPT@CONTROL_LOSS_IMMUNITY@HYPERLINK"
msgstr "[hyperlink,GLOBAL.ControlLossImmunityConcept]Imunidade à Perda de Controle[/hyperlink]"

msgid "CONCEPT@CONTROL_LOSS_IMMUNITY@NAME"
msgstr "Imunidade à Perda de Controle"

msgid "CONCEPT@CRITICAL_HIT@DESCRIPTION"
msgstr "[bulletlist][bullet/]Se o ataque de uma unidade for um Acerto Crítico, seu dano é aumentado em {damage}.[bullet/]Acertos Críticos geralmente são causados por alta {GLOBAL.UnitMoraleConcept.Hyperlink}.[bullet/]A chance de Acerto Crítico nunca pode ser maior que a chance de acertar o ataque.[/bulletlist]"

msgid "CONCEPT@CRITICAL_HIT@HYPERLINK"
msgstr "[hyperlink,GLOBAL.CriticalHitConcept]Acerto Crítico[/hyperlink]"

msgid "CONCEPT@CRITICAL_HIT@NAME"
msgstr "Acerto Crítico"

msgid "CONCEPT@CRITICAL_HIT_CHANCE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.CriticalHitConcept][crit/]Chance de Acerto Crítico[/hyperlink]"

msgid "CONCEPT@CRITICAL_HIT_CHANCE@NAME"
msgstr "[crit/]Chance de Acerto Crítico"

msgid "CONCEPT@DEBUFF_ABILITY@DESCRIPTION"
msgstr "Uma habilidade que tenta infligir um {GLOBAL.NegativeStatusEffectConcept.Hyperlink} em um inimigo sem causar dano diretamente."

msgid "CONCEPT@DEBUFF_ABILITY@HYPERLINK"
msgstr "[hyperlink,GLOBAL.DebuffConcept]Efeito Negativo[/hyperlink]"

msgid "CONCEPT@DEFENSE@DESCRIPTION"
msgstr "Defesa reduz o dano de ataques {GLOBAL.MeleeConcept.Hyperlink} e {GLOBAL.RangedConcept.Hyperlink}."

msgid "CONCEPT@DEFENSE@HYPERLINK"
msgstr "[defense/] [hyperlink,GLOBAL.DefenseConcept]Defesa[/hyperlink]"

msgid "CONCEPT@DEFENSE@NAME"
msgstr "Defesa"

msgid "CONCEPT@DEFENSE_MODE@DESCRIPTION"
msgstr "Modo Defensivo é uma habilidade de {GLOBAL.UnitConcept.Hyperlink}. Quando em Modo Defensivo, uma unidade:[bulletlist][bullet/]Estende sua {GLOBAL.ZoneOfControlConcept.Hyperlink} para todos os hexágonos adjacentes.[bullet/]Ganha {defense} de {GLOBAL.DefenseConcept.Hyperlink}.[bullet/]Ganha {resistance} de {GLOBAL.ResistanceConcept.Hyperlink}.[bullet/]Fica imune a {GLOBAL.FlankingConcept.Hyperlink}.[/bulletlist]"

msgid "CONCEPT@DEFENSE_MODE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.DefenseModeConcept]Modo Defensivo[/hyperlink]"

msgid "CONCEPT@DEFENSE_MODE@NAME"
msgstr "Modo Defensivo"

msgid "CONCEPT@ENGAGED@DESCRIPTION"
msgstr "Enquanto estiver dentro da {GLOBAL.ZoneOfControlConcept.Hyperlink} de um inimigo, uma unidade está Engajada em Corpo a Corpo e não pode usar a maioria dos ataques à distância ou habilidades mágicas."

msgid "CONCEPT@ENGAGED@HYPERLINK"
msgstr "[hyperlink,GLOBAL.EngagedInMeleeConcept]Engajada em Corpo a Corpo[/hyperlink]"

msgid "CONCEPT@ENGAGED@NAME"
msgstr "Engajada em Corpo a Corpo"

msgid "CONCEPT@ETHEREAL_IMMUNITY"
msgstr "[bulletlist][bullet/]{GLOBAL.PROPERTIES.BLEEDING.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.DISEASED.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.IMMOBILIZED.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.POISONED.Hyperlink}[/bulletlist]"

msgid "CONCEPT@EVASION@DESCRIPTION"
msgstr "Aumenta a chance de ataques {GLOBAL.RangedConcept.Hyperlink} e mágicos {GLOBAL.MagicConcept.Hyperlink} à distância errarem o alvo."

msgid "CONCEPT@EVASION@HYPERLINK"
msgstr "[hyperlink,GLOBAL.EvasionConcept]Esquiva[/hyperlink]"

msgid "CONCEPT@EVASION@NAME"
msgstr "Esquiva"

msgid "CONCEPT@EXPERIENCE@DESCRIPTION"
msgstr "Pontos de experiência são ganhos por unidades para permitir que alcancem patentes superiores, melhorando suas habilidades.[br/][br/]Unidades ganham experiência ao vencer batalhas. Elas também ganham uma pequena quantidade a cada turno no mapa mundial."

msgid "CONCEPT@EXPERIENCE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.ExperienceConcept][xp/] Experiência[/hyperlink]"

msgid "CONCEPT@FIRE_DAMAGE@DESCRIPTION"
msgstr "Inflige [damageFire/] Dano de Fogo."

msgid "CONCEPT@FIRE_DAMAGE@HYPERLINK"
msgstr "[damageFire/] [hyperlink,GLOBAL.FireDamageConcept]Dano de Fogo[/hyperlink]"

msgid "CONCEPT@FIRE_DAMAGE@NAME"
msgstr "Dano de Fogo"

msgid "CONCEPT@FIRE_LIGHTNING_DAMAGE@NAME"
msgstr "Dano de Arcofogo"

msgid "CONCEPT@FIRE_LIGHTNING_FROST_DAMAGE@NAME"
msgstr "Dano Cósmico"

msgid "CONCEPT@FIRE_RESISTANCE@DESCRIPTION"
msgstr "Proteção contra Fogo reduz {GLOBAL.FireDamageConcept.Hyperlink}."

msgid "CONCEPT@FIRE_RESISTANCE@HYPERLINK"
msgstr "[defensefire/] [hyperlink,GLOBAL.FireResistanceConcept]Proteção contra Fogo[/hyperlink]"

msgid "CONCEPT@FIRE_RESISTANCE@NAME"
msgstr "Proteção contra Fogo"

msgid "CONCEPT@FIRE_SPIRIT_DAMAGE@NAME"
msgstr "Dano Radiante"

msgid "CONCEPT@FIRST_STRIKE@DESCRIPTION"
msgstr "Quando atacada, uma unidade com Ataque Preventivo usará uma {GLOBAL.RetaliationConcept.Hyperlink} para atacar primeiro."

msgid "CONCEPT@FIRST_STRIKE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.FirstStrikeConcept]Ataque Preventivo[/hyperlink]"

msgid "CONCEPT@FIRST_STRIKE@NAME"
msgstr "Ataque Preventivo"

msgid "CONCEPT@FLANKING@DESCRIPTION"
msgstr "Ataques de flanqueamento são desencadeados ao atacar um alvo por trás ou pelo lado.[bulletlist][bullet/]Ataques de flanqueamento causam {damage} de dano.[bullet/]Unidades em {GLOBAL.DefenseModeConcept.Hyperlink} não podem ser flanqueadas.[bullet/]Se uma unidade começar seu turno na {GLOBAL.ZoneOfControlConcept.Hyperlink} de um inimigo, então não poderá flanqueá-lo naquele turno.[/bulletlist]"

msgid "CONCEPT@FLANKING@HYPERLINK"
msgstr "[hyperlink,GLOBAL.FlankingConcept][flank/] Flanqueamento[/hyperlink]"

msgid "CONCEPT@FLANKING@NAME"
msgstr "[flank/] Flanqueamento"

msgid "CONCEPT@FORTIFIED@DESCRIPTION"
msgstr "Só pode ser danificada por habilidades ou feitiços que tenham {GLOBAL.PROPERTIES.DEMOLISHER.Hyperlink}."

msgid "CONCEPT@FORTIFIED@HYPERLINK"
msgstr "[hyperlink,GLOBAL.FortifiedConcept]Fortificada[/hyperlink]"

msgid "CONCEPT@FORTIFIED@NAME"
msgstr "Fortificada"

msgid "CONCEPT@FROEST_RESISTANCE@NAME"
msgstr "Proteção contra Gelo"

msgid "CONCEPT@FROST_BLIGHT_DAMAGE@NAME"
msgstr "Dano da Morte"

msgid "CONCEPT@FROST_DAMAGE@DESCRIPTION"
msgstr "Inflige [damageFrost/] Dano de Gelo."

msgid "CONCEPT@FROST_DAMAGE@HYPERLINK"
msgstr "[damageFrost/] [hyperlink,GLOBAL.FrostDamageConcept]Dano de Gelo[/hyperlink]"

msgid "CONCEPT@FROST_DAMAGE@NAME"
msgstr "Dano de Gelo"

msgid "CONCEPT@FROST_RESISTANCE@DESCRIPTION"
msgstr "Proteção contra Gelo reduz {GLOBAL.FrostDamageConcept.Hyperlink}."

msgid "CONCEPT@FROST_RESISTANCE@HYPERLINK"
msgstr "[defensefrost/] [hyperlink,GLOBAL.FrostResistanceConcept]Proteção contra Gelo[/hyperlink]"

msgid "CONCEPT@FUMBLE@DESCRIPTION"
msgstr "[bulletlist][bullet/]Se o ataque de uma unidade for uma Falha Crítica:[bulletlist][bullet/]Um acerto se torna um Acertão, causando metade do dano.[bullet/]Um acertão se torna uma falha.[/bulletlist][bullet/]Falhas Críticas geralmente são causadas por baixa {GLOBAL.UnitMoraleConcept.Hyperlink}.[/bulletlist]"

msgid "CONCEPT@FUMBLE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.FumbleConcept]Falha Crítica[/hyperlink]"

msgid "CONCEPT@FUMBLE@NAME"
msgstr "Falha Crítica"

msgid "CONCEPT@HEROES@AMBITION@NAME"
msgstr "Ambições do Herói"

msgid "CONCEPT@HEROES@AMBITIONS@DESCRIPTION"
msgstr "Cada {GLOBAL.HeroConcept.Hyperlink} possui uma Ambição, que define objetivos para serem completados e ganhar {GLOBAL.RenownConcept.Hyperlink}. Cada uma inclui uma Ambição Menor, que pode ser repetida quantas vezes forem necessárias, e uma Ambição Maior, que só pode ser completada uma vez.[br/][br/]Completar essas ambições concede {GLOBAL.RenownConcept.Hyperlink}, enquanto completar a Ambição Maior adicionalmente concede uma propriedade única ao herói.[br/][br/]A Ambição de um herói pode ser alterada por meio de um evento caso ele não consiga completar seus objetivos em um determinado período de tempo."

msgid "CONCEPT@HEROES@AMBITIONS@HYPERLINK"
msgstr "[hyperlink,GLOBAL.AmbitionConcept]Ambição[/hyperlink]"

msgid "CONCEPT@HEROES@AMBITIONS@NAME"
msgstr "Ambições do Herói"

msgid "CONCEPT@HEROES@CLASS@DESCRIPTION"
msgstr "Cada {GLOBAL.HeroConcept.Hyperlink} possui uma Classe, escolhida durante a criação. Cada classe permite que o herói se especialize em funções específicas e geralmente oferece duas variações gerais para essa função.[br/][br/]Classes de Herói:[bulletlist][bullet/]{GLOBAL.HeroClassDefender.Hyperlink}[bullet/]{GLOBAL.HeroClassWarrior.Hyperlink}[bullet/]{GLOBAL.HeroClassMage.Hyperlink}[bullet/]{GLOBAL.HeroClassRitualist.Hyperlink}[bullet/]{GLOBAL.HeroClassRanger.Hyperlink}[bullet/]{GLOBAL.HeroClassDeathKnight.Hyperlink}[bullet/]{GLOBAL.HeroClassSpellblade.Hyperlink}[/bulletlist]"

msgid "CONCEPT@HEROES@CLASS@HYPERLINK"
msgstr "[hyperlink,GLOBAL.HeroClass]Classe de Herói[/hyperlink]"

msgid "CONCEPT@HEROES@CLASS@NAME"
msgstr "Classe de Herói"

msgid "CONCEPT@HEROES@DEDICATION@DESCRIPTION"
msgstr "Em certos níveis, os heróis ganham a habilidade de escolher Habilidades Marcantes. Para <<m:{GLOBAL.MortalChampionConcept.Hyperlink}>>, <<m:{GLOBAL.WizardKingConcept.Hyperlink}>> e Senhores dos Dragões, essas assumem a forma de Dedicatórias de Afinidade.[br/][br/]Cada nível de Dedicatória de Afinidade fica disponível com base na <<m:{GLOBAL.AffinityConcept.Hyperlink}>> do seu império e no nível do seu herói:[br/][bulletlist][bullet/]Iniciante - Requer 1 ponto de afinidade e um Herói de nível 4.[bullet/]Adepto - Requer 4 pontos de afinidade e um Herói de nível 8.[bullet/]Mestre - Requer 6 pontos de afinidade e um Herói de nível 12.[bullet/]Paragon - Requer 8 pontos de afinidade e um Herói de nível 16.[/bulletlist][br/][br/][br/]Essas Dedicatórias concedem um benefício próprio e desbloqueiam novas Habilidades de Herói.[br/][br/]Alguns tipos de Herói, como Soberanos Arcanos, possuem Habilidades Marcantes especiais que não estão relacionadas à afinidade."

msgid "CONCEPT@HEROES@DEDICATION@HYPERLINK"
msgstr "[hyperlink,GLOBAL.HeroDedication]Habilidades Marcantes do Herói[/hyperlink]"

msgid "CONCEPT@HEROES@DEDICATION@NAME"
msgstr "Habilidades Marcantes do Herói"

msgid "CONCEPT@HEROES@DESTINY@DESCRIPTION"
msgstr "Cada Herói possui um Destino, que define objetivos para o herói completar e ganhar {GLOBAL.RenownConcept.Hyperlink}. Cada Destino possui uma Ambição Menor, que pode ser repetida quantas vezes forem necessárias, e uma Ambição Maior, que só pode ser completada uma vez.[br/][br/]Completar Ambições concede {GLOBAL.RenownConcept.Hyperlink}, e completar Ambições Maiores também concede uma propriedade única ao herói.[br/][br/]O Destino de um Herói pode ser alterado por meio de um evento caso ele não consiga completar suas ambições em um determinado período de tempo."

msgid "CONCEPT@HEROES@DESTINY@HYPERLINK"
msgstr "[hyperlink,GLOBAL.DestinyConcept]Destino[/hyperlink]"

msgid "CONCEPT@HEROES@DESTINY@NAME"
msgstr "Destino do Herói"

msgid "CONCEPT@HEROES@ORIGIN@DESCRIPTION"
msgstr "A Origem é determinada pelo tipo de herói criado durante a criação da facção; para a maioria dos <<m:{GLOBAL.HeroConcept.Hyperlink}>> encontrados aleatoriamente, esta será <<m:{GLOBAL.MortalChampionConcept.Hyperlink}>>.[br/][br/]Aqui são encontradas habilidades exclusivas desses tipos, como ataques de baforada para Senhores dos Dragões ou encantamentos de feitiços para <<m:{GLOBAL.WizardKingConcept.Hyperlink}>>."

msgid "CONCEPT@HEROES@ORIGIN@HYPERLINK"
msgstr "[hyperlink,GLOBAL.HeroOrigin]Origem do Herói[/hyperlink]"

msgid "CONCEPT@HEROES@ORIGIN@NAME"
msgstr "Origem do Herói"

msgid "CONCEPT@HEROES@RENOWN@DESCRIPTION"
msgstr "Os Heróis ganham Renome ao completarem os objetivos associados à sua {GLOBAL.AmbitionConcept.Hyperlink}. Ganhar renome suficiente aumenta seu Nível de Renome, o que aumenta os bônus que a [hyperlink,GLOBAL.GovernorConcept]Cidade Governada[/hyperlink] do herói recebe do traço de Governança.[br/]Além disso, os níveis de renome concedem moral adicional às unidades no exército do herói e reduzem a chance de perder unidades ao {GLOBAL.RoutingConcept.Hyperlink}."

msgid "CONCEPT@HEROES@RENOWN@HYPERLINK"
msgstr "[renown/] [hyperlink,GLOBAL.RenownConcept]Renome[/hyperlink]"

msgid "CONCEPT@HEROES@RENOWN@NAME"
msgstr "Renome do Herói"

msgid "CONCEPT@HERO_CLASS@DEATH_KNIGHT@DESCRIPTION"
msgstr "{LOC.CONCEPT@HERO_CLASS@DEATH_KNIGHT@DESCRIPTION_SHORT}[br/][br/]Armas compatíveis:[bulletlist][bullet/]{GLOBAL.GreatWeaponConcept.Hyperlink}[bullet/]{GLOBAL.OneHandedWeaponConcept.Hyperlink}[bullet/]{GLOBAL.ShieldConcept.Hyperlink}[bullet/]{GLOBAL.FistWeaponConcept.Hyperlink}[bullet/]{GLOBAL.PolearmWeaponConcept.Hyperlink}[bullet/]{GLOBAL.SkirmishingWeaponConcept.Hyperlink}[/bulletlist]"

msgid "CONCEPT@HERO_CLASS@DEATH_KNIGHT@DESCRIPTION_SHORT"
msgstr "Uma Classe de Herói que se especializa em ataques {GLOBAL.MeleeConcept.Hyperlink} de alto dano, apoiados por <<m:{GLOBAL.DebuffConcept.Hyperlink}>> e unidades {GLOBAL.PROPERTIES.UNDEAD.Hyperlink} invocadas."

msgid "CONCEPT@HERO_CLASS@DEATH_KNIGHT@GAMEPLAY_HYPERLINK"
msgstr "[classDeathknight/] [hyperlink,GLOBAL.HeroClassDeathKnight]Cavaleiro da Morte[/hyperlink]"

msgid "CONCEPT@HERO_CLASS@DEATH_KNIGHT@HYPERLINK"
msgstr "[hyperlink,GLOBAL.HeroClassDeathKnight]Classe de Herói: Cavaleiro da Morte[/hyperlink]"

msgid "CONCEPT@HERO_CLASS@DEFENDER@DESCRIPTION"
