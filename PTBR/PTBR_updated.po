msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SKILL1@DESCRIPTION"
msgstr "Invoca uma {GLOBAL.UNITS.ARCHON_ASTRA.Hyperlink} {GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink}, uma unidade Anjo com ataques poderosos e habilidades de cura."

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SKILL1@NAME"
msgstr "Invocar Astra"

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SKILL2@DESCRIPTION"
msgstr "Purifica as almas da raça alvo, concedendo-lhes:[bulletlist][bullet/]No início de cada turno em combate, dissipa {amount} {GLOBAL.NegativeStatusEffectConcept.Hyperlink}.[bullet/]Se o Efeito de Status Negativo removido tiver um [hyperlink,GLOBAL.OpposingStatusEffectsConcept]contra[/hyperlink] positivo, ganha o {GLOBAL.PositiveStatusEffectConcept.Hyperlink}.[/bulletlist][br/]Essa transformação é incompatível com {GLOBAL.SPECIAL_OPERATIONS.UMBRAL_FLESH.Hyperlink} e {GLOBAL.SPECIAL_OPERATIONS.GLOOMSTRIDER_TRANSFORMATION.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SKILL2@NAME"
