msgstr "Torre estacionária que atira em inimigos e amplifica o dano de feitiços."

msgid "TOME_AMPLIFICATION@UNIT1@NAME"
msgstr "Pilão de Amplificação"

msgid "TOME_ANIMISM@UNIT_1@NAME"
msgstr "Falção do Espírito"

msgid "TOME_ARCHDRUID@HERO_SKILL@DESCRIPTION"
msgstr "Todas as unidades amigáveis <<m:{GLOBAL.PROPERTIES.ANIMAL.Hyperlink}>> e <<m:{GLOBAL.PROPERTIES.PLANT.Hyperlink}>> dentro de {NATURE_AVENGER_UNIT_TARGETER_CIRCLE>AREA>Radius} hexágonos tornam-se {stacks} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}."

msgid "TOME_ARCHDRUID@HERO_SKILL@NAME"
msgstr "Vingador da Natureza"

msgid "TOME_ARCHDRUID@PASSIVE@DESCRIPTION"
msgstr "Após capturar uma {GLOBAL.CityConcept}, você pode escolher devolvê-la à natureza. Se fizer isso:[bulletlist][bullet/]A {GLOBAL.CityConcept} será arrasada.[bullet/]Cada {amount1} de {amount2} membros da {GLOBAL.CityConcept} {GLOBAL.PopulationConcept} será distribuído uniformemente por todo o seu {GLOBAL.EmpireConcept}.[bullet/]A {GLOBAL.ProvinceConcept} alvo será transformada em floresta.[/bulletlist]"

msgid "TOME_ARCHDRUID@PASSIVE@NAME"
msgstr "Retornar à Natureza"

msgid "TOME_ARCHDRUID@PASSIVE@OPERATION@DESCRIPTION"
msgstr "[bulletlist][bullet/]A {GLOBAL.CityConcept} será arrasada.[bullet/]Cada {amount1} de {amount2} membros da {GLOBAL.CityConcept} {GLOBAL.PopulationConcept} será distribuído uniformemente por todo o seu {GLOBAL.EmpireConcept}.[bullet/]A {GLOBAL.ProvinceConcept} alvo será transformada em floresta.[/bulletlist]"

msgid "TOME_ARCHDRUID@PASSIVE@OPERATION_PROGRESS@DESCRIPTION"
msgstr "A cidade está sendo devolvida à natureza. O processo será concluído em {Duration.Turn}."

msgid "TOME_ARCHDRUID@PIERCING_ROOTS@DESCRIPTION"
msgstr "Unidade inimiga alvo:[bulletlist][bullet/]Sofre {GLOBAL.BlightDamageConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_ARCHDRUID@ROOT_BURST@DESCRIPTION"
