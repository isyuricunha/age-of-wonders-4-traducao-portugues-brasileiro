msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT02@DESCRIPTION"
msgstr "Quando uma unidade aliada morre, todas as unidades inimigas adjacentes:[bulletlist][bullet/]Sofrem {MARTYRDOM_DAMAGE>DAMAGE>Spirit} de {GLOBAL.SpiritDamageConcept.Hyperlink}.[bullet/]Tornam-se {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT02@NAME"
msgstr "Martírio"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT02@PROP_DESCRIPTION"
msgstr "Quando esta unidade morre, todas as unidades inimigas adjacentes:[bulletlist][bullet/]Sofrem {MARTYRDOM_DAMAGE>DAMAGE>Spirit} de {GLOBAL.SpiritDamageConcept.Hyperlink}[bullet/]Tornam-se {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT03@DESCRIPTION"
msgstr "A cada {amount} <<m:{GLOBAL.TurnConcept}>>, uma unidade aliada aleatória:[bulletlist][bullet/]Ganha {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink}.[bullet/]Ganha {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}.[bullet/]Este efeito então se aplica a unidades aliadas adjacentes e é repetido.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT03@NAME"
msgstr "Empoderamento em Cascata"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT04@DESCRIPTION"
msgstr "A cada {amount} <<m:{GLOBAL.TurnConcept}>>, unidades inimigas:[bulletlist][bullet/]Têm uma chance base de {MISFORTUNE_RESISTANCE>ResolvedStrength}% de ganharem {GLOBAL.PROPERTIES.MISFORTUNE.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT04@NAME"
msgstr "Onda de Infortúnio"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT05@DESCRIPTION"
msgstr "A cada {amount} <<m:{GLOBAL.TurnConcept}>>, {amount2} unidades inimigas aleatórias têm:[bulletlist][bullet/]Chance base de {GHOSTFIRE_RESISTANCE>ResolvedStrength}% de serem afligidas com {GLOBAL.PROPERTIES.GHOSTFIRE.Hyperlink}.[bullet/]Chance base de {ELECTRIFIED_RESISTANCE>ResolvedStrength}% de serem afligidas com {GLOBAL.PROPERTIES.ELECTRIFIED.Hyperlink}.[bullet/]Chance base de {FROZEN_RESISTANCE>ResolvedStrength}% de serem afligidas com {GLOBAL.PROPERTIES.FROZEN.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT05@NAME"
