msgstr "Unidades encantadas ganham:[bulletlist][bullet/]{GLOBAL.PROPERTIES.CAVE_WALK.Hyperlink}[bullet/]Enquanto no Subterrâneo:[bulletlist][bullet/]+{amount1} {GLOBAL.DefenseConcept.Hyperlink}[bullet/]+{amount2} {GLOBAL.ResistanceConcept.Hyperlink}[/bulletlist][bullet/]Enquanto na superfície:[bulletlist][bullet/]Causa +{amount3}% de dano[/bulletlist][/bulletlist]"

