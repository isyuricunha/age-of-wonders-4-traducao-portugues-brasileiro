msgstr "[bulletlist][bullet/]O ataque base ganha +{FLURRY_MAIN_ATTACK_EXTRA_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} por pilha.[bullet/]{GLOBAL.PROPERTIES.FLURRY_OF_WEAPONS.Hyperlink} ganha +{FLURRY_EXTRA_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} por pilha.[bullet/]Pilhas até {amount} vezes.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@WILDLIFE_PROPERTIES@HERALD_OF_WAR@ABILITY01@PROP_NAME"
msgstr "Fúria Derretida"

msgid "DLC@EMPIRESANDASHES@WILDLIFE_PROPERTIES@HERALD_OF_WAR@ABILITY02@DESCRIPTION"
msgstr "[bulletlist][bullet/]Unidades adjacentes sofrem dano.[bullet/]Consome todas as pilhas de {GLOBAL.PROPERTIES.FLURRY_PROP_GROUP.Hyperlink}.[bullet/]Cura {MOLTEN_WHIRLWIND_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> por pilha consumida.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@WILDLIFE_PROPERTIES@HERALD_OF_WAR@ABILITY02@NAME"
msgstr "Redemoinho Derretido"

msgid "DLC@EMPIRESANDASHES@WILDLIFE_PROPERTIES@HERALD_OF_WAR@ABILITY03@DESCRIPTION"
msgstr "[bulletlist][bullet/]Quando uma unidade inimiga morre, ganha {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}.[bullet/]Quando uma unidade aliada morre, cura {SPIRIT_OF_WAR_FRIEND_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Não é acionado pela morte de <<m:{GLOBAL.PROPERTIES.COMBAT_SUMMON.Hyperlink}>>, {GLOBAL.PROPERTIES.TOWER_UNIT.Hyperlink} e {GLOBAL.PROPERTIES.SIEGECRAFT_UNIT.Hyperlink} unidades.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@WILDLIFE_PROPERTIES@HERALD_OF_WAR@ABILITY03@NAME"
msgstr "Espírito de Guerra"

msgid "DLC@EMPIRESANDASHES@WILDLIFE_PROPERTIES@HERALD_OF_WAR@ABILITY04@DESCRIPTION"
msgstr "Causa dano em uma linha de {LINE_ATTACK_HERALD_OF_WAR>AREA>Length} hexes."

msgid "DLC@EMPIRESANDASHES@WILDLIFE_PROPERTIES@HERALD_OF_WAR@ABILITY04@NAME"
msgstr "Torrente de Espadas"

msgid "DLC@EMPIRESANDASHES@WILDLIFE_PROPERTIES@PROGENITOR_GOLEM@ABILITY01@DESCRIPTION"
msgstr "Libera um raio mágico no inimigo alvo. Causa {BREACH_BOLT_CIRCLE>ResolvedEffectMultiplier}% do dano em inimigos adjacentes."

msgid "DLC@EMPIRESANDASHES@WILDLIFE_PROPERTIES@PROGENITOR_GOLEM@ABILITY01@NAME"
msgstr "Raio Perfurante"

msgid "DLC@EMPIRESANDASHES@WILDLIFE_PROPERTIES@PROGENITOR_GOLEM@ABILITY02@DESCRIPTION"
msgstr "Até {enemyamount} inimigos aleatórios e seus aliados adjacentes:[bulletlist][bullet/]Sofrem {amount} de {GLOBAL.LightningDamageConcept.Hyperlink}.[bullet/]Ganham {amount2} de {GLOBAL.PROPERTIES.WEAKENED.Hyperlink}.[bullet/]Ganham {amount3} de {GLOBAL.PROPERTIES.SUNDERED_RESISTANCE.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@WILDLIFE_PROPERTIES@PROGENITOR_GOLEM@ABILITY02@NAME"
msgstr "Convulsão Mágica"

msgid "DLC@EMPIRESANDASHES@WILDLIFE_PROPERTIES@PROGENITOR_GOLEM@ABILITY03@DESCRIPTION"
msgstr "A unidade inimiga alvo tem uma chance base de {LIMITED_SEAL_RESISTANCE>ResolvedStrength}% de ser {GLOBAL.PROPERTIES.SEAL.Hyperlink}."

msgid "DLC@EMPIRESANDASHES@WILDLIFE_PROPERTIES@PROGENITOR_GOLEM@ABILITY03@NAME"
msgstr "Selo Limitado"

msgid "DLC@EMPIRESANDASHES@WILDLIFE_PROPERTIES@PROGENITOR_GOLEM@ABILITY03@PROP_DESCRIPTION"
msgstr "Esta unidade:[bulletlist][bullet/]Não pode se mover ou agir.[bullet/]É imune a todo dano e efeitos de status.[bullet/]Não conta como estando em batalha.[/bulletlist][br/]O efeito termina se a outra unidade ligada morrer."

msgid "DLC@EMPIRESANDASHES@WILDLIFE_PROPERTIES@PROGENITOR_GOLEM@ABILITY03@PROP_NAME"
msgstr "Selado"

msgid "DLC@EMPIRESANDASHES@WILDLIFE_PROPERTIES@ROVING_FURNACE@ABILITY01@DESCRIPTION"
msgstr "Quando esta unidade ataca ou é atacada, unidades adjacentes:[bulletlist][bullet/]Sofrem {amount} de {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Têm uma chance base de {chance}% de ficarem {GLOBAL.PROPERTIES.BURNING.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@WILDLIFE_PROPERTIES@ROVING_FURNACE@ABILITY01@MOD_DESCRIPTION"
msgstr "Unidades adjacentes:[bulletlist][bullet/]Sofrem {amount} de {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Têm uma chance base de {chance}% de ficarem {GLOBAL.PROPERTIES.BURNING.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@WILDLIFE_PROPERTIES@ROVING_FURNACE@ABILITY01@NAME"
msgstr "Derramamento Derretido"

msgid "DLC@EMPIRESANDASHES@WILDLIFE_PROPERTIES@SCRAP_HERMIT@ABILITY01@DESCRIPTION"
msgstr "Unidades em um cone de {ACID_SPRAY_CONE_TARGETER>AREA>Length} hexes:[bulletlist][bullet/]Sofrem dano.[bullet/]Ganham {amount} de {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@WILDLIFE_PROPERTIES@SCRAP_HERMIT@ABILITY01@NAME"
msgstr "Spray Ácido"

msgid "DLC@EMPIRESANDASHES@WILDLIFE_PROPERTIES@SCRAP_HERMIT@ABILITY02@DESCRIPTION"
msgstr "Ao acertar, esta unidade ganha {GATHER_METAL_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> e tem {GATHER_METAL_RESISTANCE_CHECK>ResolvedStrength}% de chance de ganhar {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink}."

msgid "DLC@EMPIRESANDASHES@WILDLIFE_PROPERTIES@SCRAP_HERMIT@ABILITY02@NAME"
msgstr "Coletar Metal"

msgid "DLC@EMPIRESANDASHES@WORLD_TRAIT@SEALS_VICTORY@ACTIVE@DESCRIPTION"
msgstr "Selos estão presentes neste reino. Capturá-los levará a uma {GLOBAL.SealsVictoryConcept.Hyperlink}.[br/]- São necessários menos Pontos de Selo para alcançar a vitória."

msgid "DLC@EMPIRESANDASHES@WORLD_TRAIT@SEALS_VICTORY@ACTIVE@NAME"
msgstr "Selos Mundiais (Ativos)"

msgid "DLC@EMPIRESANDASHES@WORLD_TRAIT@SEALS_VICTORY@AMPLE@DESCRIPTION"
msgstr "Selos estão presentes neste reino. Capturá-los levará a uma {GLOBAL.SealsVictoryConcept.Hyperlink}.[br/]- Há mais Selos presentes neste reino."

msgid "DLC@EMPIRESANDASHES@WORLD_TRAIT@SEALS_VICTORY@AMPLE@NAME"
msgstr "Selos Mundiais (Abundantes)"

msgid "DLC@EMPIRESANDASHES@WORLD_TRAIT@SEALS_VICTORY@DEFAULT@DESCRIPTION"
msgstr "Selos estão presentes neste reino. Capturá-los levará a uma {GLOBAL.SealsVictoryConcept.Hyperlink}."

msgid "DLC@EMPIRESANDASHES@WORLD_TRAIT@SEALS_VICTORY@DEFAULT@NAME"
msgstr "Selos Mundiais"

msgid "DLC@EMPIRESANDASHES@WORLD_TRAIT@SEALS_VICTORY@DORMANT@DESCRIPTION"
msgstr "Selos estão presentes neste reino. Capturá-los levará a uma {GLOBAL.SealsVictoryConcept.Hyperlink}.[br/]- Mais Pontos de Selo são necessários para alcançar a vitória."

msgid "DLC@EMPIRESANDASHES@WORLD_TRAIT@SEALS_VICTORY@DORMANT@NAME"
msgstr "Selos Mundiais (Adormecidos)"

msgid "DLC@EMPIRESANDASHES@WORLD_TRAIT@SEALS_VICTORY@SCARCE@DESCRIPTION"
msgstr "Selos estão presentes neste reino. Capturá-los levará a uma {GLOBAL.SealsVictoryConcept.Hyperlink}.[br/]- Menos Selos estão presentes neste reino."

msgid "DLC@EMPIRESANDASHES@WORLD_TRAIT@SEALS_VICTORY@SCARCE@NAME"
msgstr "Selos Mundiais (Escassos)"

msgid "@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@"
msgstr "@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@"

msgid "DLC@EXPANSIONPASS@DISPLAYNAME"
msgstr "Passe de Expansão"

msgid "DLC@GIANTKINGS@BASE_ABILITY@MAGIC_BLAST@ETERNALS"
msgstr "Explosão Eterna"

msgid "DLC@GIANTKINGS@BASE_ABILITY@MAGIC_BLAST@ETERNALS_DESCRIPTION"
msgstr "Causa dano a unidades em um raio de {ETERNALS_BLAST_TARGETER>AREA>Radius} hexes."

msgid "DLC@GIANTKINGS@BASE_ABILITY@MAGIC_BLAST@VOLATILE"
msgstr "Explosão Volátil"

msgid "DLC@GIANTKINGS@BOON_STEAL@CHANCE_MODIFIER"
msgstr "Chance base de {BOON_STEALING_RESISTANCE_CHECK>ResolvedStrength}% de roubar {amount1} {GLOBAL.PositiveStatusEffectConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@CITYDEFINITION_STRATEGIC@CRYSTAL_DWELLING@DESCRIPTION"
msgstr "Moradas de Cristal são um tipo de {GLOBAL.DwellingConcept.Hyperlink} habitadas por remanescentes dos Reis Gigantes em formas de Litorina.[br/][bulletlist][bullet/]Apenas 1 Morada de Cristal existe dentro de um reino.[bullet/]A única forma de melhorar a {GLOBAL.HouseInfluenceConcept.Hyperlink} com a Morada é através de Missões.[bullet/]Ter um Pacto com a Morada de Cristal desbloqueará várias opções de comércio com eles, como conteúdo de {GLOBAL.TomeConcept.Hyperlink}, <<m:{GLOBAL.ArtifactConcept.Hyperlink}>>, <<m:{GLOBAL.UnitConcept.Hyperlink}>> de Litorina e revelar pontos de interesse no mapa.[bullet/]Uma vez capturada, uma Morada de Cristal é imediatamente destruída e concede alguns dos itens de comércio da Morada ao conquistador.[/bulletlist]"

msgid "DLC@GIANTKINGS@CITYDEFINITION_STRATEGIC@CRYSTAL_DWELLING@NAME"
msgstr "Morada de Cristal"

msgid "DLC@GIANTKINGS@CITYDEFINITION_STRATEGIC@CRYSTAL_DWELLING@TYPE"
msgstr "Moradas de Cristal"

msgid "DLC@GIANTKINGS@CITYDEFINITION_STRATEGIC@LITHORINE_WALLS@NAME"
msgstr "Muralhas de Litorita"

msgid "DLC@GIANTKINGS@CITYDEFINITION_STRATEGIC@LITHORINE_WALLS@UNLOCK"
msgstr "Obstáculos de Muralha de Litorita em combate"

msgid "DLC@GIANTKINGS@CITYDEFINITION_STRATEGIC@LITHORINE_WALLS@UNLOCK_DESCRIPTION"
msgstr "Obstáculos de Muralha de Litorita são {GLOBAL.FortifiedConcept.Hyperlink} com uma grande quantidade de <<m:{GLOBAL.HitPointConcept.Hyperlink}>> e infligem {GLOBAL.PROPERTIES.VOLATILE_CHARGE.Hyperlink} em Unidades em um raio de {radius} hexes quando destruídos."

msgid "DLC@GIANTKINGS@CITYDEFINITION_STRATEGIC@VOLATILE_RUNES@NAME"
msgstr "Runas Voláteis"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@ACIDIC_VAPOURS@DESCRIPTION"
msgstr "A cada {GLOBAL.TurnConcept.Hyperlink}, algumas posições se tornam {GLOBAL.PROPERTIES.POISONOUS.Hyperlink} por {timer} turnos. Todas as unidades defensoras são imunes ao efeito de veneno."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@ACIDIC_VAPOURS@NAME"
msgstr "Poças Ácidas"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@ANCIENT_DRACONIC_INSTINCT@DESCRIPTION"
msgstr "Todas as <<m:{GLOBAL.UnitConcept.Hyperlink}>> {GLOBAL.PROPERTIES.DRAGON.Hyperlink} ganham {GLOBAL.PROPERTIES.FRENZY.Hyperlink} até o fim do combate."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@ANCIENT_DRACONIC_INSTINCT@NAME"
msgstr "Frenesi Dracônico Ancestral"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@BEHEMOTHS_DREADFUL_PRESENCE@DESCRIPTION"
msgstr "A cada {GLOBAL.TurnConcept.Hyperlink}, cada unidade tem {chance} de sofrer {GLOBAL.PROPERTIES.REMORSE.Hyperlink}."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@BEHEMOTHS_DREADFUL_PRESENCE@NAME"
msgstr "Presença Aterradora do Behemoth"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@BERSERK_WYRMS@DESCRIPTION"
msgstr "Serpentes menores se tornam {GLOBAL.PROPERTIES.BERSERK.Hyperlink}."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@BERSERK_WYRMS@NAME"
msgstr "Frenesi Serpentino"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@BINDING_HEX@DESCRIPTION"
msgstr "Várias posições no mapa contêm um Hexágono de Ligação. Quando um Demônio Infernal atravessa um Hexágono de Ligação, ele fica {GLOBAL.PROPERTIES.STUNNED.Hyperlink} por {timer} {GLOBAL.TurnConcept.Hyperlink} e o Hexágono de Ligação é removido."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@BINDING_HEX@NAME"
msgstr "Hexágono de Ligação"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@BLINDED_MOTH@DESCRIPTION"
msgstr "No início do combate, a Mariposa Primordial fica {GLOBAL.PROPERTIES.BLINDED.Hyperlink} por {value} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@BLINDED_MOTH@NAME"
msgstr "Sobrecarga Sensorial"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@BRING_IN_DEVASTATORS@DESCRIPTION"
msgstr "No início do combate, o líder da sua pilha traz {NumberOfSpheres} <<m:{GLOBAL.UNITS.DEVASTATOR_SPHERE_UNIT}>>."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@BRING_IN_DEVASTATORS@NAME"
msgstr "Invocar Devastadores"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@CHAINED_BASILISK@DESCRIPTION"
msgstr "O Basilisco Primordial inicia a batalha {GLOBAL.PROPERTIES.STUNNED.Hyperlink} por {timer} {GLOBAL.TurnConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@CHAINED_BASILISK@NAME"
msgstr "Basilisco Acorrentado"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@CINDER_STORM@DESCRIPTION"
msgstr "A cada {value} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, a Mariposa Primordial bate suas asas, fazendo com que uma das unidades atacantes fique {GLOBAL.PROPERTIES.BLINDED.Hyperlink} por {BlindValue} <<m:{GLOBAL.TurnConcept.Hyperlink}>> e {GLOBAL.PROPERTIES.BURNING.Hyperlink} por {BurnValue} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@CINDER_STORM@NAME"
msgstr "Tempestade de Cinzas"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@CLAY_REBIRTH@DESCRIPTION"
msgstr "Os soldados de argila defensores ganham {GLOBAL.PROPERTIES.FIERY_REBIRTH.Hyperlink}."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@CLAY_REBIRTH@NAME"
msgstr "Criados por chamas primordiais"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@DELAYED_SURGE@DESCRIPTION"
msgstr "A cada {value} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, todas as unidades atacantes têm {chance} de chance de sofrer Carga Volátil."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@DELAYED_SURGE@NAME"
msgstr "Onda Volátil Tardia"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@DEMORALIZED_DEFENDERS@DESCRIPTION"
msgstr "No início do combate, todas as unidades defensoras ganham {numberOfStacks} acúmulos de {GLOBAL.PROPERTIES.DEMORALIZED.Hyperlink} até o fim do combate."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@DEMORALIZED_DEFENDERS@NAME"
msgstr "Defensores Desmoralizados"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@DISPERSE_DEFENDERS@DESCRIPTION"
msgstr "No início do combate, metade das unidades Lithorine defensoras se tornam {GLOBAL.PROPERTIES.HASTENED.Hyperlink} por {value} <<m:{GLOBAL.TurnConcept.Hyperlink}>> e a outra metade se torna {GLOBAL.PROPERTIES.SLOWED.Hyperlink} por {value} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@DISPERSE_DEFENDERS@NAME"
msgstr "Dispersar Defensores"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@ELEMENTAL_ATTUNEMENT@DESCRIPTION"
msgstr "Todos os <<m:{GLOBAL.UnitConcept.Hyperlink}>> {GLOBAL.PROPERTIES.ELEMENTAL.Hyperlink} ganham {GLOBAL.PROPERTIES.ELEMENTAL_ATTUNEMENT_UNITPROP.Hyperlink} até o fim do combate."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@ELEMENTAL_ATTUNEMENT@NAME"
msgstr "Sintonia Elemental"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@ELEMENTAL_ATTUNEMENT@PROPERTY_DESCRIPTION"
msgstr "Quando um {GLOBAL.SpellConcept.Hyperlink} é conjurado, o ataque base desta unidade ganha +{amount} de dano baseado na {GLOBAL.AffinityConcept.Hyperlink} do feitiço:[bulletlist][bullet/]{GLOBAL.OrderConcept.Hyperlink} - {GLOBAL.SpiritDamageConcept.Hyperlink}[bullet/]{GLOBAL.ChaosConcept.Hyperlink} - {GLOBAL.FireDamageConcept.Hyperlink}[bullet/]{GLOBAL.AstralConcept.Hyperlink} - {GLOBAL.LightningDamageConcept.Hyperlink}[bullet/]{GLOBAL.MateriumConcept.Hyperlink} - {GLOBAL.PhysicalDamageConcept.Hyperlink}[bullet/]{GLOBAL.NatureConcept.Hyperlink} - {GLOBAL.BlightDamageConcept.Hyperlink}[bullet/]{GLOBAL.ShadowConcept.Hyperlink} - {GLOBAL.FrostDamageConcept.Hyperlink}[/bulletlist][br/]Acumula até {STAR_BLADES_STATUS_DESCRIPTION>MaxStacks} vezes.[br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@GIANTS_BLESSING@DESCRIPTION"
msgstr "A cada {GLOBAL.TurnConcept.Hyperlink}, uma das unidades defensoras que ainda não foi alvo ganha a {GLOBAL.PROPERTIES.SUPERGROWTH_PROPERTY_GROUP.Hyperlink} {GLOBAL.RaceTransformationConcept.Hyperlink} e se cura completamente de <<m:{GLOBAL.HitPointConcept.Hyperlink}>>."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@GIANTS_BLESSING@NAME"
msgstr "Bênção do Gigante"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@GIANTS_BLESSING_ATTACKERS@DESCRIPTION"
msgstr "A cada {GLOBAL.TurnConcept.Hyperlink}, uma das unidades atacantes que ainda não foi alvo ganha a {GLOBAL.PROPERTIES.SUPERGROWTH_PROPERTY_GROUP.Hyperlink} {GLOBAL.RaceTransformationConcept.Hyperlink} e se cura completamente em <<m:{GLOBAL.HitPointConcept.Hyperlink}>>."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@GIANTS_JUDGEMENT@DESCRIPTION"
msgstr "Os ataques do seu Governante Gigante infligem {GLOBAL.PROPERTIES.REMORSE.Hyperlink} por {NumberOfTurns} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@GIANTS_JUDGEMENT@NAME"
msgstr "Julgamento do Gigante"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@GIANT_DISTRACTION_TACTICS@DESCRIPTION"
msgstr "Ataques de {GLOBAL.FlankingConcept.Hyperlink} das unidades atacantes têm {chance} de chance de infligir {GLOBAL.PROPERTIES.DISTRACTED.Hyperlink}."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@GIANT_DISTRACTION_TACTICS@NAME"
msgstr "Táticas de Distração do Gigante"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@GIANT_SLAYING_LEGEND@DESCRIPTION"
msgstr "O {GLOBAL.PROPERTIES.EXPEDITION_LEADER.Hyperlink} ganha a propriedade {GLOBAL.SKILLS.HUNTERS_CROSSBOW_SKILL.Hyperlink}."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@GIANT_SLAYING_LEGEND@NAME"
msgstr "Lenda de Matador de Gigantes"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@INFERNAL_FEED@DESCRIPTION"
msgstr "Toda vez que os Invasores Infernais geram uma unidade, seu Líder da Expedição ganha {StackCount} acúmulos de {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} por {timer} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@INFERNAL_FEED@NAME"
msgstr "Alimento Infernal"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@INFERNAL_INVADERS@DESCRIPTION"
msgstr "A cada {timer} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, enquanto o Cão Primordial defensor estiver vivo, um Demônio de nível {tiers} defensor surge próximo a ele. Essas unidades duram até o fim do combate."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@INFERNAL_INVADERS@NAME"
msgstr "Invasores Infernais"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@LITHORITE_DISRUPTION@DESCRIPTION"
msgstr "Metade das unidades Lithorine defensoras iniciam a batalha {GLOBAL.PROPERTIES.STUNNED.Hyperlink} por {value} {GLOBAL.TurnConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@LITHORITE_DISRUPTION@NAME"
msgstr "Perturbação Lithorita"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@LITHORITE_RECOMBINATION@DESCRIPTION"
msgstr "Enquanto o Sangue Primordial estiver vivo, sempre que uma unidade Lithorine defensora de Nível 1 a Nível 3 morrer, se houver outro Cadáver Lithorine no mapa, este será ressuscitado como uma unidade Lithorine um nível acima da unidade Lithorine que acabou de morrer."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@LITHORITE_RECOMBINATION@NAME"
msgstr "Reciclagem de Fragmento de Pedra"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@PUNY_SLAYING@DESCRIPTION"
msgstr "Todas as unidades defensoras ganham {GLOBAL.PROPERTIES.PUNY_SLAYER.Hyperlink} até o fim do combate."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@PUNY_SLAYING@NAME"
msgstr "Matador de Pequenos"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@REVERSE_GROWTH@DESCRIPTION"
msgstr "A cada {GLOBAL.TurnConcept.Hyperlink}, uma das unidades defensoras que ainda não foi alvo ganha a {GLOBAL.PROPERTIES.SPAWNKIN_PROPERTY_GROUP.Hyperlink} {GLOBAL.RaceTransformationConcept.Hyperlink} e tem seu {GLOBAL.HitPointConcept.Hyperlink} Máximo reduzido em {ReducedHealth}."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@REVERSE_GROWTH@NAME"
msgstr "Maldição dos Pequenos"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@SLOWED_INVADERS@DESCRIPTION"
msgstr "Unidades geradas pelos Invasores Infernais sofrem {GLOBAL.PROPERTIES.SLOWED.Hyperlink} por {timer} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@SLOWED_INVADERS@NAME"
msgstr "Invasores Lentificados"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@STAND_TOGETHER@DESCRIPTION"
msgstr "Todas as unidades atacantes ganham {GLOBAL.PROPERTIES.STAND_TOGETHER.Hyperlink} até o fim do combate."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@STAND_TOGETHER@NAME"
msgstr "Juntos Resistimos"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@STOKED_FIRE@DESCRIPTION"
msgstr "As unidades de argila defensoras iniciam o combate {GLOBAL.PROPERTIES.BURNING.Hyperlink}."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@STOKED_FIRE@NAME"
msgstr "Fogo Atiçado"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@STOP_UNDYING@DESCRIPTION"
