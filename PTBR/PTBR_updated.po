msgstr "<<m:{GLOBAL.CityStructureConcept}>> concede +{GoldBonusIncome}{GLOBAL.GoldConcept} além de seus efeitos normais[br/]Permite o alistamento de unidades {GLOBAL.UNITS.ROCK_GIANT.Hyperlink}"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@DESCRIPTION_NON_HEIR"
