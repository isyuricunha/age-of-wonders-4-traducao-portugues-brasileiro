msgid "FEY_INVASION@SIEGE_EVENT@AFFINITY_BUTTON@ASTRAL@HEADER"
msgstr "Tentar silenciar as Fadas através de uma potente barreira astral:"

msgid "FEY_INVASION@SIEGE_EVENT@AFFINITY_BUTTON@ASTRAL@SUCCESS"
msgstr "As vozes sinistras além dos portões ficam em silêncio, e seu povo recupera a sanidade."

msgid "FEY_INVASION@SIEGE_EVENT@AFFINITY_BUTTON@MATERIUM@FAILURE"
msgstr "As infelizes vítimas das Fadas ainda encontram rachaduras e buracos para escapar."

msgid "FEY_INVASION@SIEGE_EVENT@AFFINITY_BUTTON@MATERIUM@HEADER"
msgstr "Tentar selar as muralhas para torná-las intransponíveis:"

msgid "FEY_INVASION@SIEGE_EVENT@AFFINITY_BUTTON@MATERIUM@SUCCESS"
msgstr "Mesmo sob o mais poderoso encantamento, o povo de {EventCity} não pode deixar a cidade."

