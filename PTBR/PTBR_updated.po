msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@NEGOTIATION_IN_PROGRESS_SHORT"
msgstr "{STR_stateTML} em {INT_turns}[turn/]"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@NEUTRAL"
msgstr "Neutro"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@NEUTRAL_BUTTON"
msgstr "Fazer Paz"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@NEUTRAL_BUTTON_DESCRIPTION"
msgstr "Fazer [rs_neutral/] [hyperlink,GLOBAL.DSNeutralConcept]Paz[/hyperlink] com a {GLOBAL.IndependentCityConcept.Hyperlink} para retomar [hyperlink,GLOBAL.NegotiationConcept]negociações[/hyperlink]"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@NEUTRAL_DESCRIPTION"
msgstr "O {GLOBAL.PvEDiplStateConcept.Hyperlink} padrão. A {GLOBAL.IndependentCityConcept.Hyperlink} e o {GLOBAL.EmpireConcept.Hyperlink} ainda não [hyperlink,GLOBAL.NegotiationConcept]negociaram[/hyperlink] termos melhores. Isso pode ser feito usando um {GLOBAL.DiplomaticTokenConcept.Hyperlink}."

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@VASSALAGE"
msgstr "Pacto de Vassalagem"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@VASSALAGE_DESCRIPTION"
msgstr "[bulletlist][bullet/]A {GLOBAL.IndependentCityConcept.Hyperlink} compartilha sua renda e <<m:{GLOBAL.MagicMaterialConcept.Hyperlink}>>.[bullet/]Outros <<m:{GLOBAL.EmpireConcept.Hyperlink}>> não podem mais [hyperlink,GLOBAL.NegotiationConcept]negociar[/hyperlink] <<m:{GLOBAL.PvEDiplStateConcept.Hyperlink}>> melhores com a {GLOBAL.IndependentCityConcept.Hyperlink}.[bullet/]A {GLOBAL.IndependentCityConcept.Hyperlink} se juntará ao seu suserano em qualquer <<m:{GLOBAL.WarConcept.Hyperlink}>> em que estejam lutando, pode auxiliar em combate e pode receber diretivas na Coordenação de Guerra.[bullet/]Muda para o {GLOBAL.VassalagePhaseConcept.Hyperlink}, durante o qual mais {GLOBAL.HouseInfluenceConcept.Hyperlink} pode ser obtido para melhorar os benefícios da vassalagem. Eventualmente, a {GLOBAL.IndependentCityConcept.Hyperlink} pode ser [hyperlink,GLOBAL.PactOfIntegrationConcept]integrada[/hyperlink] ao império de seu suserano.[/bulletlist]"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@VASSALAGE_HYPERLINK"
msgstr "[rs_vassalage/] [hyperlink,GLOBAL.PactOfVassalageConcept]Pacto de Vassalagem[/hyperlink]"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@VASSALAGE_LEVEL_-1"
msgstr "Tributário"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@VASSALAGE_LEVEL_-1_DESCRIPTION"
msgstr "[bulletlist][bullet/]A {GLOBAL.IndependentCityConcept.Hyperlink} compartilha {incomePercentage}% de sua renda.[bullet/]Compartilha todo o seu <<m:{GLOBAL.MagicMaterialConcept.Hyperlink}>>.[bullet/]Contribui com {commandPoints}[recruitmentPoints/] para o {GLOBAL.RequestMilitaryAidConcept.Hyperlink}.[bullet/]O custo de [hyperlink,GLOBAL.IndependentCityTradeConcept]Comércio[/hyperlink] aumenta em {tradingCost}%.[bullet/]A Coordenação de Guerra é desativada e nenhum novo exército será enviado.[/bulletlist]"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@VASSALAGE_LEVEL_-1_HYPERLINK"
msgstr "[rs_vassalage-1/] [hyperlink,GLOBAL.PactOfVassalageLvl-1Concept]Tributário[/hyperlink]"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@VASSALAGE_LEVEL_-2"
