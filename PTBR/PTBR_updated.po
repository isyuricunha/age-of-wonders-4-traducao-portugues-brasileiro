msgstr "[hyperlink,GLOBAL.JuliaLoreConcept]Julia da Casa Inioch[/hyperlink]"

msgid "INTERFACE@LORE_CONCEPT@JULIA@NAME"
msgstr "Julia da Casa Inioch"

msgid "INTERFACE@LORE_CONCEPT@KARISSA@HYPERLINK"
msgstr "[hyperlink,GLOBAL.KarissaLoreConcept]Karissa, a Vermelha[/hyperlink]"

msgid "INTERFACE@LORE_CONCEPT@KARISSA@NAME"
msgstr "Karissa, a Vermelha"

