msgid "DLC@ELDRITCHREALMS@PICKUPS_STRATEGIC@CHITIN_PICKUP@DESCRIPTION"
msgstr "Carapaças descartadas e endurecidas de várias criaturas Demoníacas Umbrais. Podem ser usadas na construção de armaduras ou edifícios, ou vendidas como materiais exóticos.[br/][br/]Pode conceder uma grande quantidade de {GLOBAL.GoldConcept.Hyperlink}, {GLOBAL.UnitProductionConcept.Hyperlink} ou {GLOBAL.StructureProductionConcept.Hyperlink}."

msgid "DLC@ELDRITCHREALMS@PICKUPS_STRATEGIC@CHITIN_PICKUP@NAME"
msgstr "Quitina Descartada"

msgid "DLC@ELDRITCHREALMS@PICKUPS_STRATEGIC@SOULS_PICKUP@DESCRIPTION"
