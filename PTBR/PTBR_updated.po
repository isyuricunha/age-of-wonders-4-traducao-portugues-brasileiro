msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@BLOODBLIGHT@NAME"
msgstr "Praga Sangrenta"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@CONJURE_ROSE_KNIGHT@ABILITY_DESCRIPTION"
msgstr "No início do combate, conjure um {GLOBAL.UNITS.ROSE_KNIGHT.Hyperlink}.[br/][br/]Não funciona em batalhas aquáticas."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@CONJURE_ROSE_KNIGHT@ABILITY_NAME"
msgstr "Guardião Cavaleiro da Rosa"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@CONJURE_ROSE_KNIGHT@NAME"
