msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@FRAGMENTED_BLOODLIGHT_REFLECTIONS@DESCRIPTION"
msgstr "A cada {GLOBAL.TurnConcept.Hyperlink}, algumas posições ganham Luz Sanguínea por {turn}.[br/][br/]Unidades {GLOBAL.PROPERTIES.UNDEAD.Hyperlink} na Luz Sanguínea ganham {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} e {GLOBAL.PROPERTIES.REGENERATION.Hyperlink} no final do Turno."

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@FRAGMENTED_BLOODLIGHT_REFLECTIONS@NAME"
