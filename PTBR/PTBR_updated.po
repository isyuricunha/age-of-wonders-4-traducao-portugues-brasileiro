msgid "WILDLIFE_UNITPROPERTIES@ENHANCING_SYMB@NAME"
msgstr "Simbiose Aprimorante"

msgid "WILDLIFE_UNITPROPERTIES@ENHANCING_SYMB@PROP_DESCRIPTION_CASTER"
msgstr "Esta unidade ganha {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink} e {GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink} no final de cada {GLOBAL.TurnConcept}."

msgid "WILDLIFE_UNITPROPERTIES@ENHANCING_SYMB@PROP_DESCRIPTION_TARGET"
msgstr "Esta unidade ganha {amount} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} no final de cada {GLOBAL.TurnConcept}."

msgid "WILDLIFE_UNITPROPERTIES@ENTWINE@DESCRIPTION"
msgstr "Unidade inimiga alvo não-{GLOBAL.PROPERTIES.ETHEREAL.Hyperlink}, não-{GLOBAL.HeroConcept.Hyperlink}:[bulletlist][bullet/]Sofre dano[bullet/]Tem uma chance base de {ENTWINE_RESISTANCE>ResolvedStrength}% de se tornar {GLOBAL.PROPERTIES.ENTWINED.Hyperlink} por {ENTWINED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@ENTWINE@DESCRIPTION_2"
msgstr "Unidade inimiga alvo não-{GLOBAL.PROPERTIES.ETHEREAL.Hyperlink}, não-{GLOBAL.HeroConcept.Hyperlink}:[bulletlist][bullet/]Sofre dano.[bullet/]Torna-se {GLOBAL.PROPERTIES.ENTWINED.Hyperlink} por {ENTWINED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@ENTWINE@DESCRIPTION_3"
msgstr "Unidade inimiga alvo não-{GLOBAL.PROPERTIES.ETHEREAL.Hyperlink}, não-{GLOBAL.HeroConcept.Hyperlink}, além de outra dentro de {ENTWINE_MASTER_JUMP_TARGETER>MaxDistance} hexágonos:[bulletlist][bullet/]Sofre dano[bullet/]Tem uma chance base de {ENTWINE_RESISTANCE>ResolvedStrength}% de se tornar {GLOBAL.PROPERTIES.ENTWINED.Hyperlink} por {ENTWINED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@ENTWINE@ENHANCED_DESCRIPTION"
msgstr "Entrelaçar:[bulletlist][bullet/]Causa um adicional de {ENTWINE_ENHANCE_DAMAGE>DAMAGE>Blight}{GLOBAL.BlightDamageConcept.Hyperlink}.[bullet/]Garantidamente inflige {GLOBAL.PROPERTIES.ENTWINED.Hyperlink}.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@ENTWINE@ENHANCED_NAME"
msgstr "Entrelaçar Aprimorado"

msgid "WILDLIFE_UNITPROPERTIES@ENTWINE@MASTER_DESCRIPTION"
msgstr "Entrelaçar:[bulletlist][bullet/]Agora afeta outro inimigo dentro de {ENTWINE_MASTER_JUMP_TARGETER>MaxDistance} hexágonos.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@ENTWINE@MASTER_NAME"
msgstr "Entrelaçar Campeão"

msgid "WILDLIFE_UNITPROPERTIES@ENTWINE@MODIFIER"
msgstr "Chance base de {ENTWINE_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.ENTWINED.Hyperlink} por {ENTWINED_EFFECT_DESCRIPTION>NumTurns} {GLOBAL.TurnConcept}."

msgid "WILDLIFE_UNITPROPERTIES@ENTWINE@NAME"
msgstr "Entrelaçar"

msgid "WILDLIFE_UNITPROPERTIES@ENTWINE@PROP_DESCRIPTION"
msgstr "A unidade está {GLOBAL.PROPERTIES.IMMOBILIZED.Hyperlink} e sofre {ENTWINED_DAMAGE_OVER_TIME>ATTACK>Blight} {GLOBAL.BlightDamageConcept.Hyperlink} a cada turno.[br/][br/]Se esta unidade morrer enquanto estiver sob este efeito, ela se transforma em um {GLOBAL.UNITS.ENTWINED_THRALL_UNIT.Hyperlink} sob controle inimigo.[br/][br/]Se o Escravo sobreviver ao combate, ele então Evolui e o inimigo pode pagar {GLOBAL.ManaConcept.Hyperlink} para mantê-lo."

msgid "WILDLIFE_UNITPROPERTIES@ENTWINE@PROP_NAME"
msgstr "Entrelaçado"

msgid "WILDLIFE_UNITPROPERTIES@EXPLOSIVE_PHASE@DESCRIPTION"
