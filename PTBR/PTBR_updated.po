msgstr "Keya'Wyo"

msgid "META_EMPIRE@REALM_SEAL@NAME6"
msgstr "Keya'Manda"

msgid "META_EMPIRE@REALM_SEAL@SUBTITLE"
msgstr "Uma antiga terra Krazura, espalhada com selos místicos de Poder. Aquele que controla os Selos pode reclamar o reino para si."

msgid "META_EMPIRE@REALM_SEAL@TEMPLATE_NAME"
