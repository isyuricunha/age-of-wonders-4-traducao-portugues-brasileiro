msgstr "Ataques {GLOBAL.MagicConcept.Hyperlink} da unidade têm:[bulletlist][bullet/]+{SANGUINE_FOCUS_DAMAGE_REPEATING>DAMAGE>Physical} de {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Uma chance base de {BLEEDING_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.BLEEDING.Hyperlink} por {BLEEDING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@THRONESOFBLOOD@TOME_BLOOD_RITE@SKILL5@DESCRIPTION"
msgstr "Unidade amiga alvo sofre {RITE_OF_BLOODLETTING_DAMAGE>DAMAGE>Physical} de {GLOBAL.PhysicalDamageConcept.Hyperlink} não bloqueável. Então todas as unidades inimigas dentro de {RITE_OF_BLOODLETTING_CIRCLE_TARGETER>AREA>Radius} hexágonos:[bulletlist][bullet/]Sofrem {RITE_OF_BLOODLETTING_ENEMY_DAMAGE>DAMAGE>Physical} de {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Ganham {amount} de {GLOBAL.PROPERTIES.BLEEDING.Hyperlink} por {BLEEDING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

