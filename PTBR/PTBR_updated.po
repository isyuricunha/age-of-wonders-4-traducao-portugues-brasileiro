msgid "DLC@ARCHONPROPHECY@META_EMPIRE@TRAIT_ARCHON_WARD@DESCRIPTION"
msgstr "Um poderoso feitiço tecido pelos Arcontes afasta a morte, impedindo a morte verdadeira dos Celestiais.[bulletlist][bullet/]Todos os <<m:{GLOBAL.UnitConcept.Hyperlink}>> {GLOBAL.PROPERTIES.CELESTIAL.Hyperlink} não-Governantes ganham {GLOBAL.PROPERTIES.IMMORTAL_ARCHON_WARD.Hyperlink}.[bullet/]Unidades {GLOBAL.PROPERTIES.CELESTIAL.Hyperlink} [hyperlink.RoutingConcept.HeroConcept]<<Routed>>[/hyperlink] nunca são perdidas.[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@META_EMPIRE@TRAIT_ARCHON_WARD@NAME"
msgstr "Proteção dos Arcontes"

msgid "DLC@ARCHONPROPHECY@META_EMPIRE@TRAIT_ARCHON_WARD@UNIT_PROP@DESC"
