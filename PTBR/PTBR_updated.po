msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@ICEBOUND_BEHEMOTH@DESCRIPTION"
msgstr "<<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacentes a este Marco ganham:[bulletlist][bullet/]{income}.[bullet/] Um [researchpost/] Posto de Pesquisa nesta província concede {income2}.[bullet/]O {combatproperty} {GLOBAL.CombatEnchantmentConcept.Hyperlink}[/bulletlist][br/]Uma {GLOBAL.CityConcept.Hyperlink} com {amount} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacentes a este Marco ganham:[bulletlist][bullet/]Ganha {visionbonus} {GLOBAL.VisionRangeConcept.Hyperlink} e {sensingbonus} {GLOBAL.SensorRangeConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@ICEBOUND_BEHEMOTH@LORE"
msgstr "\"Olhar para esses vastos olhos congelados é estar à beira da eternidade em si. Mesmo selados no gelo, eles me atravessam — através da carne, da alma, do próprio tecido do cosmos. Nós, que reclamamos o domínio do arcano, não sabemos nada comparado a este colosso do {GLOBAL.UrwildernessLoreConcept.Hyperlink}. O que somos para um vidente tão antigo e esquecido?\"[br/][br/]— Merlin, o Viajante, Jornais recuperados da Quarta Era"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@ICEBOUND_BEHEMOTH@NAME"
