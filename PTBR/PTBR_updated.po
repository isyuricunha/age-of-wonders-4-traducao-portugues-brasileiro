msgstr "Impressed by your skill, the feathered Guardian allows you to enter."

msgid "DLC@SECRETSOFTHEARCHMAGES@TRIGGER@TOOLTIP@SHROUDED_GATE_SOULS@AFFINITY_CHOICE_SHADOW@FAILURE"
msgstr "You fail to extract the soul, which prompts the {EnemyUnit} to tear into your army."

msgid "DLC@SECRETSOFTHEARCHMAGES@TRIGGER@TOOLTIP@SHROUDED_GATE_SOULS@AFFINITY_CHOICE_SHADOW@HEADER"
msgstr "Extract the soul from a nearby scurrying creature:"

msgid "DLC@SECRETSOFTHEARCHMAGES@TRIGGER@TOOLTIP@SHROUDED_GATE_SOULS@AFFINITY_CHOICE_SHADOW@SUCCESS"
msgstr "The Portal Guardian approves of your offering and yields passage."

