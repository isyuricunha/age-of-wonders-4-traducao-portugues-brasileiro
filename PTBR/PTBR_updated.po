msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@SCORCHING_STENCH_OF_SUFFERING@NAME"
msgstr "Scorching Stench of Suffering"

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@YAKA01@DESCRIPTION"
msgstr "Defender {GLOBAL.PROPERTIES.BATTLE_MAGE.Hyperlink} and {GLOBAL.PROPERTIES.SUPPORT_UNIT.Hyperlink} units gain {GLOBAL.PROPERTIES.SUBDUE_PANTHEON.Hyperlink}. Other units gain a base {amount}% {GLOBAL.PROPERTIES.IMMOBILIZED.Hyperlink} chance on their base attacks, increased for Single Shot."

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@YAKA01@NAME"
msgstr "Slavers"

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@YAKA02@DESCRIPTION"
msgstr "At the start of combat, a random defender defects to the attackers."

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@YAKA02@NAME"
msgstr "Defection"

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@YAKA03@DESCRIPTION"
msgstr "The base attacks of units in the attackers side:[bulletlist][bullet/]Gain +{YAKA_ARCANUM_YAKAS_POWER_EXTRA_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Deal {YAKA_ARCANUM_YAKAS_POWER_MORALE>Morale Change Absolute} {GLOBAL.UnitMoraleConcept.Hyperlink} damage.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@YAKA03@NAME"
msgstr "Yaka's Power"

