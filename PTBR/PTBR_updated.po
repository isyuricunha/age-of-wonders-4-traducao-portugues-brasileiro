msgid "DLC@RISEFROMRUIN@FRACTURING_WINDS_CRISIS@RELICS_LOST@HEADER"
msgstr "Muitos <<m:{GLOBAL.ArtifactConcept.Hyperlink}>> foram perdidos!"

msgid "DLC@RISEFROMRUIN@FRACTURING_WINDS_CRISIS@RELICS_LOST@SUB_HEADER"
msgstr "Muitos <<m:{GLOBAL.ArtifactConcept.Hyperlink}>> foram perdidos, tornando a {GLOBAL.CataclysmVictoryConcept.Hyperlink} impossível."

msgid "DLC@RISEFROMRUIN@FRACTURING_WINDS_CRISIS@SEIZE@DESCRIPTION"
msgstr "{CountdownPlayer} reuniu pelo menos três <<m:{GLOBAL.ArtifactConcept.Hyperlink}>> da {GLOBAL.UnmakersLoreConcept.Hyperlink}, tornando-se o Guardião do Hubris.[br/][br/]Derrote {CountdownPlayer} para tomar os Artefatos."

