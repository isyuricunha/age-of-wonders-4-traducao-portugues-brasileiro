msgstr "{STR_unitName1} trocou de local com {STR_unitName2}"

msgid "SPEC_WILDMAGIC@SWAP_LOCATION@NAME"
msgstr "Trocar Local"

msgid "STACK@CONFIRM_SPEED_MARCH@DESCRIPTION"
msgstr "Unidades neste exército ganham {movepointgain} de seu total de <<m:{GLOBAL.MovePointConcept.Hyperlink}>> de volta.[br/]Unidades perdem {STR_HitpointPcnt}% de seu total de <<m:{GLOBAL.HitPointConcept.Hyperlink}>> e ficam {GLOBAL.PROPERTIES.EXHAUSTED.Hyperlink} por {STR_ExhaustTurns} <<m:{GLOBAL.TurnConcept.Hyperlink}>>.[br/]Custo: {STR_Cost} ({STR_UnitCost} por unidade)."

msgid "STACK@CONFIRM_SPEED_MARCH@TITLE"
msgstr "Marcha Forçada"

msgid "STATUSEFFECTS_UNITPROPERTIES@BERSERK@DESCRIPTION"
msgstr "A unidade:[bulletlist][bullet/]É incontrolável e sempre ataca o alvo inimigo mais próximo.[bullet/]Se não houver inimigos no alcance, atacará seus aliados.[bullet/]É imune a efeitos de {GLOBAL.UnitMoraleConcept.Hyperlink}.[bullet/]Penalidades de dano de {GLOBAL.CasualtyConcept} são anuladas.[/bulletlist]"

msgid "STATUSEFFECTS_UNITPROPERTIES@BERSERK@MODIFIER_DESCRIPTION"
msgstr "{BERSERK_RESISTANCE>ResolvedStrength}% base de chance de infligir {GLOBAL.PROPERTIES.BERSERK.Hyperlink} por {BERSERK_DESCRIPTION>NumTurns} {GLOBAL.TurnConcept}"

