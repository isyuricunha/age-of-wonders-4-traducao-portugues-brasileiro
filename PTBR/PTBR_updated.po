msgid "DLC@ELDRITCHREALMS@TOME_CLEANSING_FLAME@TOME@HAZARD@DESCRIPTION"
msgstr "Unidades que passarem ou terminarem seu turno neste hexágono:[bulletlist][bullet/]Não-{GLOBAL.PROPERTIES.ZEAL.Hyperlink} ou {GLOBAL.PROPERTIES.FAITHFUL.Hyperlink} sofrem {GLOBAL.PROPERTIES.BURNING.Hyperlink}.[bullet/]Unidades {GLOBAL.PROPERTIES.ZEAL.Hyperlink} ou {GLOBAL.PROPERTIES.FAITHFUL.Hyperlink} perdem -{DispelCountNegative} <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>>.[bullet/]Unidades {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink} perdem -{DispelCountPositive} <<m:{GLOBAL.PositiveStatusEffectConcept.Hyperlink}>>.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TOME_CLEANSING_FLAME@TOME@HAZARD@NAME"
