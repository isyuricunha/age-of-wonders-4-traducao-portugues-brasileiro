msgid "STATUSEFFECTS_UNITPROPERTIES@INSANITY@MODIFIER_DESCRIPTION_GUARANTEED"
msgstr "Inflige {GLOBAL.PROPERTIES.INSANITY.Hyperlink} por {INSANITY_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "STATUSEFFECTS_UNITPROPERTIES@INSANITY@NAME"
msgstr "Insanidade"

msgid "STATUSEFFECTS_UNITPROPERTIES@MIND_CONTROLLED@DESCRIPTION"
msgstr "Esta unidade é controlada pelo oponente.[br/]Se o efeito durar até o final do combate, a unidade morrerá, a menos que seu dono original vença."

msgid "STATUSEFFECTS_UNITPROPERTIES@MIND_CONTROLLED@DESCRIPTION_KEEP"
msgstr "Esta unidade é controlada pelo oponente.[br/]Se o oponente vencer o combate e esta unidade sobreviver, então o oponente manterá a unidade."

msgid "STATUSEFFECTS_UNITPROPERTIES@MIND_CONTROLLED@END_OF_COMBAT@MODIFIER_DESCRIPTION"
msgstr "Chance base de {MIND_CONTROL_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.MIND_CONTROLLED.Hyperlink} até o final do combate."

msgid "STATUSEFFECTS_UNITPROPERTIES@MIND_CONTROLLED@MODIFIER_DESCRIPTION"
msgstr "Chance base de {MIND_CONTROL_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.MIND_CONTROLLED.Hyperlink} por {MIND_CONTROL_TEMP>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "STATUSEFFECTS_UNITPROPERTIES@MIND_CONTROLLED@NAME"
msgstr "Controlado Mentalmente"

msgid "STATUSEFFECTS_UNITPROPERTIES@RALLYING@DESCRIPTION"
msgstr "[bulletlist][bullet/]Esta unidade ganha {RALLYING_CHANGE_MORALE>Alteração de Moral} {GLOBAL.UnitMoraleConcept.Hyperlink} no final de seu turno.[bullet/]Acumula até {stacksMax} vezes.[/bulletlist][br/][br/]Rallying {GLOBAL.OpposingStatusEffectsConcept.Hyperlink} {GLOBAL.PROPERTIES.REMORSE.Hyperlink}."

msgid "STATUSEFFECTS_UNITPROPERTIES@RALLYING@NAME"
msgstr "Ajuntamento"

msgid "STATUSEFFECTS_UNITPROPERTIES@SPIRIT_DISTRACTED@ABILITY_DESCRIPTION"
msgstr "Todos os ataques direcionados a esta unidade são ataques {GLOBAL.FlankingConcept.Hyperlink}.[br/][br/]Distraído {GLOBAL.OpposingStatusEffectsConcept.Hyperlink} {GLOBAL.PROPERTIES.HYPER_AWARE.Hyperlink}."

msgid "STATUSEFFECTS_UNITPROPERTIES@SPIRIT_DISTRACTED@ABILITY_NAME"
msgstr "Distraído"

msgid "STATUSEFFECTS_UNITPROPERTIES@SPIRIT_DISTRACTED@MODIFIER"
msgstr "Chance base de {DISTRACTED_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.DISTRACTED.Hyperlink} por {DISTRACTED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "STATUSEFFECTS_UNITPROPERTIES@SPIRIT_DISTRACTED@MODIFIER_GUARANTEED"
msgstr "Inflige {GLOBAL.PROPERTIES.DISTRACTED.Hyperlink} por {DISTRACTED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "STATUSEFFECTS_UNITPROPERTIES@SPIRIT_DISTRACTED@MODIFIER_GUARANTEED_IF_MOVED"
msgstr "Se a unidade se moveu, inflige {GLOBAL.PROPERTIES.DISTRACTED.Hyperlink} por {DISTRACTED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "STATUSEFFECTS_UNITPROPERTIES@TAUNTED@DESCRIPTION"
msgstr "Esta unidade está incontrolável e sempre atacará a unidade que a provocou.[br/]Uma unidade pode provocar múltiplos oponentes."

msgid "STATUSEFFECTS_UNITPROPERTIES@TAUNTED@GUARANTEED_MODIFIER_DESCRIPTION"
msgstr "Inflige {GLOBAL.PROPERTIES.TAUNTED.Hyperlink} por {TAUNTED_LINK_EFFECT>Duration} <<m:{GLOBAL.TurnConcept}>>."

msgid "STATUSEFFECTS_UNITPROPERTIES@TAUNTED@MODIFIER_DESCRIPTION"
msgstr "Chance base de {TAUNTED_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.TAUNTED.Hyperlink} por {TAUNTED_LINK_EFFECT>Duration} <<m:{GLOBAL.TurnConcept}>>."

msgid "STATUSEFFECTS_UNITPROPERTIES@TAUNTED@MODIFIER_DESCRIPTION_IF_MOVED"
msgstr "Se a unidade se moveu, chance base de {TAUNTED_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.TAUNTED.Hyperlink} por {TAUNTED_LINK_EFFECT>Duration} <<m:{GLOBAL.TurnConcept}>>."

msgid "STATUSEFFECTS_UNITPROPERTIES@TAUNTED@NAME"
msgstr "Provocado"

msgid "STATUSEFFECTS_UNITPROPERTIES@THRILLING_DOMINATION@DESCRIPTION"
msgstr "[bulletlist][bullet/]This unit is {GLOBAL.PROPERTIES.BERSERK.Hyperlink}.[bullet/]This unit is controlled by the opponent.[br/]If the effect lasts until the end of combat, the controller will have the option to spend [mana/] to keep the unit permanently.[/bulletlist]"

msgid "STATUSEFFECTS_UNITPROPERTIES@THRILLING_DOMINATION@NAME"
msgstr "Thrilling Domination"

msgid "STATUSEFFECTS_UNITPROPERTIES@TORMENT@DESCRIPTION"
msgstr "Quando a unidade usa uma habilidade:[bulletlist][bullet/]Ela sofre {TORMENT_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Perde {TORMENT_MORALE_LOSS>Alteração de Moral Absoluta} {GLOBAL.UnitMoraleConcept.Hyperlink}.[bullet/]Perde uma pilha deste efeito.[bullet/]Acumula até {maxStacks} vezes.[/bulletlist][br/][br/]Tormento {GLOBAL.OpposingStatusEffectsConcept.Hyperlink} {GLOBAL.PROPERTIES.GRACE.Hyperlink}."

msgid "STATUSEFFECTS_UNITPROPERTIES@TORMENT@MODIFIER_DESCRIPTION"
msgstr "Chance base de {TORMENTED_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.TORMENT.Hyperlink} até o final do combate."

msgid "STATUSEFFECTS_UNITPROPERTIES@TORMENT@MODIFIER_GUARANTEED_DESCRIPTION"
msgstr "Inflige {TORMENT_REPEATER>Count} {GLOBAL.PROPERTIES.TORMENT.Hyperlink} até o final do combate."

msgid "STATUSEFFECTS_UNITPROPERTIES@TORMENT@NAME"
msgstr "Tormento"

msgid "STORYREALM_VICTORY@01_VALLEYOFWONDERS@VICTORY"
msgstr "Defendeu o Vale das Maravilhas!"

msgid "STORYREALM_VICTORY@02_ENCHANTEDARCHIPELAGO@VICTORY"
msgstr "Liberou o Arquipélago Encantado!"

msgid "STORYREALM_VICTORY@03_CRIMSONCALDERA@VICTORY"
msgstr "Reivindicou o Gildercoil!"

msgid "STORYREALM_VICTORY@04_ETERNALCOURT@VICTORY"
msgstr "Quebrou a maldição!"

msgid "STORYREALM_VICTORY@05_GREXOLIS@VICTORY"
msgstr "Conquistou Grexolis!"

msgid "STORYREALM_VICTORY@DLC2_MISSION_01@VICTORY"
msgstr "Desvendou os mistérios de Manuhari!"

msgid "STORYREALM_VICTORY@DLC4_MISSION_02@VICTORY"
msgstr "Salvou Athla das garras arcanas de Urrath!"

msgid "STORY_EVENT@1013_1019@BODY_FOOTER"
msgstr "O <<m:EnemyUnit>> chama {EventHero.FirstName} para se juntar a eles nas águas. À medida que <<p:EventHero>> se aproxima, seus sorrisos escurecem. \"Venha entrar! Não resista.\""

msgid "STORY_EVENT@1013_1019@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "O <<m:EnemyUnit>> chama você para se juntar a eles nas águas. À medida que suas tropas se aproximam, seus sorrisos escurecem. \"Venha entrar! Não resista.\""

msgid "STORY_EVENT@1013_1019@BODY_HEADER"
msgstr "Após uma viagem árdua, as águas borbulhantes e refrescantes da {EventStructure.Name} parecem muito convidativas para {EventHero.Name} e o exército de <<o:EventHero>>. O murmúrio pacífico do riacho é pontuado por risadas brincalhonas."

msgid "STORY_EVENT@1013_1019@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Após uma viagem árdua, as águas borbulhantes e refrescantes da {EventStructure.Name} parecem muito convidativas para você e seu exército. O murmúrio pacífico do riacho é pontuado por risadas brincalhonas."

msgid "STORY_EVENT@1013_1019@BODY_LORE"
msgstr "\"Não fiquem aí parados!\" chama uma voz sedutora e acolhedora, acompanhada por um coro de risadas. Belos <<m:EnemyUnit>> estão se divertindo nas águas da nascente. Eles convidam com seus braços nus, bloqueando as formas humanoides que flutuam sem vida sob a superfície. Os <<m:EnemyUnit>> chamam, quase implorando com pedidos ansiosos. \"Juntem-se a nós! Venham se banhar conosco...\""

msgid "STORY_EVENT@1013_1019@BUTTON_0"
msgstr "\"É uma armadilha! Atacem!\""

msgid "STORY_EVENT@1013_1019@BUTTON_1"
msgstr "Ordene que suas tropas desviem os olhos antes de atacar os <<m:EnemyUnit>>."

msgid "STORY_EVENT@1013_1019@BUTTON_3"
msgstr "\"Não cedam à tentação! Nossa fé nos guiará através disso!\""

msgid "STORY_EVENT@1013_1019@BUTTON_4"
msgstr "Afaste-se dessas tentadoras."

msgid "STORY_EVENT@1013_1019@TITLE"
msgstr "Isca e Banho"

msgid "STORY_EVENT@1013_1020@BODY_FOOTER"
msgstr "O {EventUnit.Name} sorri. \"Não tenho muito a oferecer além da minha gratidão, bravo <<EventHero{hero/heroine}>>. A {EventStructure.Name} é sua.\""

msgid "STORY_EVENT@1013_1020@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "O {EventUnit.Name} sorri. \"Não tenho muito a oferecer além da minha gratidão, ó {PlayerLeader.Title}. A {EventStructure.Name} é sua.\""

msgid "STORY_EVENT@1013_1020@BODY_HEADER"
msgstr "{EventHero.Name} emerge vitorioso da {EventStructure.Name}. Um último {EventUnit} se aproxima, com os braços levantados. \"Eu perco toda a diversão?\" Ela pergunta brincalhona."

msgid "STORY_EVENT@1013_1020@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você emerge vitorioso da {EventStructure.Name}. Um último {EventUnit} se aproxima, com os braços levantados. \"Eu perco toda a diversão?\" Ela pergunta brincalhona."

msgid "STORY_EVENT@1013_1020@BODY_LORE"
msgstr "Ela continua: \"Aquelas bruxas enganavam as pessoas apenas para afogá-las por diversão. Elas até tentaram isso comigo, uma vez, antes de me afastar. Estou feliz que elas estejam...\" ela pausa para escolher suas palavras cuidadosamente, \"...partidas.\" Eu não sou como elas, sempre quis deixar a {EventStructure.Name} e aprender sobre o mundo, em vez de afogar todos.\""

msgid "STORY_EVENT@1013_1020@BUTTON_0"
msgstr "\"Estamos interessados apenas nas riquezas [gold/] que suas irmãs traidoras saquearam.\""

msgid "STORY_EVENT@1013_1020@BUTTON_0@HERO_IS_PLAYERLE"
msgstr "\"Estou interessado apenas nas riquezas [gold/] que suas irmãs traidoras saquearam.\""

msgid "STORY_EVENT@1013_1020@BUTTON_1"
msgstr "\"Tomaremos os frutos e plantas [food/] que você cultiva aqui.\""

msgid "STORY_EVENT@1013_1020@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"Tomarei os frutos e plantas [food/] que você cultiva aqui.\""

msgid "STORY_EVENT@1013_1020@BUTTON_2"
msgstr "\"Junte-se a nós, {EventUnit.Name}. [unit/] Então você poderá aprender tudo o que desejar.\""

msgid "STORY_EVENT@1013_1020@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "\"Junte-se a mim, {EventUnit.Name}. [unit/] Então você poderá aprender tudo o que desejar.\""

msgid "STORY_EVENT@1013_1020@TITLE"
msgstr "Isca e Banho: Consequências"

msgid "STORY_EVENT@1013_1024@BODY_FOOTER"
msgstr "Ela sorri friamente enquanto criaturas de gelo surgem da neve imaculada. \"Venha abraçar os {EventUnit} e seja preservado.\""

msgid "STORY_EVENT@1013_1024@BODY_HEADER"
msgstr "Após viajar alguma distância sob o sol quente do meio-dia, {EventHero.Name} dirige-se a uma nascente, esperando refrescar-se..."

msgid "STORY_EVENT@1013_1024@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Após viajar alguma distância sob o sol quente do meio-dia, você dirige-se a uma nascente, esperando refrescar-se..."

msgid "STORY_EVENT@1013_1024@BODY_LORE"
msgstr "Apesar do calor do dia, a nascente está completamente congelada. Sobre sua superfície está uma família de patos, congelados no gelo. Uma mulher, coroada com icículos cintilantes, desliza mais perto sobre as águas congeladas. O gelo se espalha sob seus pés nus e gelados. Ela acaricia gentilmente os animais congelados, antes de virar sua cabeça rapidamente em direção a {EventHero.FirstName}. \"Sangue quente perturba meu lago tranquilo.\""

msgid "STORY_EVENT@1013_1024@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Apesar do calor do dia, a nascente está completamente congelada. Sobre sua superfície está uma família de patos, congelados no gelo. Uma mulher, coroada com icículos cintilantes, desliza mais perto sobre as águas congeladas. O gelo se espalha sob seus pés nus e gelados. Ela acaricia gentilmente os animais congelados, antes de virar sua cabeça rapidamente em sua direção. \"Sangue quente perturba meu lago tranquilo.\""

msgid "STORY_EVENT@1013_1024@BUTTON_0"
msgstr "\"Hora de quebrar o gelo! Às armas!\""

msgid "STORY_EVENT@1013_1024@BUTTON_1"
msgstr "Use magia [mana/] para se proteger do frio."

msgid "STORY_EVENT@1013_1024@BUTTON_3"
msgstr "Aqueça seu fogo interior para resistir ao frio."

msgid "STORY_EVENT@1013_1024@BUTTON_4"
msgstr "Fuja do frio gelado."

msgid "STORY_EVENT@1013_1024@TITLE"
msgstr "O Lago Congelado"

msgid "STORY_EVENT@1013_1025@BODY_FOOTER"
msgstr "\"Não há tempo a perder, meus segredos derretem.\" Os símbolos que derretem rapidamente quase desapareceram."

msgid "STORY_EVENT@1013_1025@BODY_HEADER"
msgstr "Enquanto o sol derrete o último do gelo, o som de grasnados retorna à nascente."

msgid "STORY_EVENT@1013_1025@BODY_LORE"
msgstr "A Bruxa Branca desaparece, sua voz uma brisa fresca e fraca. \"Sou apenas um remanescente da Rainha que já governou aqui. Ela invadiu as terras quentes, preservando toda a vida no gelo. Marcadores congelados levam ao seu cofre do tesouro, mas agora, eles derretem.\" {EventHero.FirstName} percebe nos últimos vestígios de gelo que há algum tipo de mapa, detalhando o esconderijo de um tesouro perdido."

msgid "STORY_EVENT@1013_1025@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "A Bruxa Branca desaparece, sua voz uma brisa fresca e fraca. \"Sou apenas um remanescente da Rainha que já governou aqui. Ela invadiu as terras quentes, preservando toda a vida no gelo. Marcadores congelados levam ao seu cofre do tesouro, mas agora, eles derretem.\" Você percebe nos últimos vestígios de gelo que há algum tipo de mapa, detalhando o esconderijo de um tesouro perdido."

msgid "STORY_EVENT@1013_1025@BUTTON_0"
msgstr "Siga as direções no gelo que mostram um baú de tesouro. [gold/]"

msgid "STORY_EVENT@1013_1025@BUTTON_1"
msgstr "Siga as direções no gelo que mostram um {EventItem.Name}."

msgid "STORY_EVENT@1013_1025@BUTTON_2"
msgstr "Siga as direções no gelo que mostram uma estrela fria. [mana/]"

msgid "STORY_EVENT@1013_1025@BUTTON_4"
msgstr "Ignore o tesouro, restaure a vida selvagem natural da nascente [natureboon/]."

msgid "STORY_EVENT@1013_1025@TITLE"
msgstr "O Lago Congelado: Consequências"

msgid "STORY_EVENT@1013_1046@BODY_FOOTER"
msgstr "Os ferreiros olham para {EventHero.FirstName} e <<o:EventHero>> tropas; a esperança drenando de seus rostos queimados pelo fogo. \"Como você apaga um fogo inextinguível?\""

msgid "STORY_EVENT@1013_1046@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Os ferreiros olham para você e suas tropas; esperando que um {PlayerLeader.Title} como você possa ajudá-los. \"Como você apaga um fogo inextinguível?\""

msgid "STORY_EVENT@1013_1046@BODY_HEADER"
msgstr "{EventHero.Name} se aproxima do {EventStructure.Name}, esperando ver os trabalhadores ocupados na forja. Em vez disso, ferreiros franzindo a testa estão do lado de fora da forja, murmurando."

msgid "STORY_EVENT@1013_1046@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você se aproxima do {EventStructure.Name}, esperando ver os trabalhadores ocupados na forja. Em vez disso, ferreiros franzindo a testa estão do lado de fora da forja, murmurando."

msgid "STORY_EVENT@1013_1046@BODY_LORE"
msgstr "O mestre ferreiro explica que toda a forja superaqueceu de repente. \"Não importa como apagamos as chamas, o calor só ficou mais intenso. É como se Yaka mesmo tivesse decidido fazer deste lugar seu trono!\" Os ferreiros atrás dele concordam com a cabeça. \"Eu juro, as chamas ganharam vida!\" um deles adiciona, fuligem cobrindo seu rosto."

msgid "STORY_EVENT@1013_1046@BUTTON_0"
msgstr "\"Este fogo será apagado com sangue! Às armas!\""

msgid "STORY_EVENT@1013_1046@BUTTON_1"
msgstr "Ordene engenheiros de {EventCity.Name} [structureprod/] para abrir ventilações de resfriamento dentro do {EventStructure.Name} antes de entrar."

msgid "STORY_EVENT@1013_1046@BUTTON_4"
msgstr "Use seu conhecimento de terra e forjas para abrir as ventilações de resfriamento sob o {EventStructure.Name} você mesmo."

msgid "STORY_EVENT@1013_1046@BUTTON_5"
msgstr "Recue da forja volátil."

msgid "STORY_EVENT@1013_1046@TITLE"
msgstr "Quente demais para lidar"

msgid "STORY_EVENT@1013_1047@BODY_FOOTER"
msgstr "O mestre ferreiro concorda. \"Estamos em dívida com você, <<EventHero{hero/heroine}>> da {EventStructure.Name}. Nomeie seu prêmio.\""

msgid "STORY_EVENT@1013_1047@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "O mestre forjador acena com a cabeça. \"Estamos em débito com você, {PlayerLeader.Title}, Godir do {EventStructure.Name}. Nomeie seu prêmio.\""

msgid "STORY_EVENT@1013_1047@BODY_HEADER"
msgstr "As chamas da forja cintilam e brilham, não mais fora de controle. O mestre forjador sorri de orelha a orelha."

msgid "STORY_EVENT@1013_1047@BODY_LORE"
msgstr "\"Sua engenhosidade é algo de que precisamos na forja. Não acha que gostaria de um trabalho aqui conosco?\" Antes que {EventHero.FirstName} possa responder, o mestre forjador dá um forte tapinha nas costas de <<P:EventHero>> e explode em uma risada. \"Tenho certeza de que seus deveres são muito mais importantes do que o simples trabalho que fazemos aqui. Ainda assim…\""

msgid "STORY_EVENT@1013_1047@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "\"Sua engenhosidade é rara, ó {PlayerLeader.Title}. Não acha que gostaria de um trabalho aqui conosco?\" Antes que você possa responder, o mestre forjador explode em uma risada. \"Sem ofensa, {PlayerLeader.TitleName}. Tenho certeza de que suas ambições são muito maiores do que o simples trabalho que fazemos aqui. Ainda assim…\""

msgid "STORY_EVENT@1013_1047@BUTTON_1"
msgstr "\"Preciso de uma nova armadura.\" [item/]"

msgid "STORY_EVENT@1013_1047@BUTTON_2"
msgstr "\"Sua dívida será paga em ouro [gold/].\""

msgid "STORY_EVENT@1013_1047@BUTTON_3"
msgstr "\"Sua boa palavra e trabalho duro por nosso reino são pagamento suficiente, mestre forjador.\" [goodact/]"

msgid "STORY_EVENT@1013_1047@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "\"Sua boa palavra e trabalho duro por este reino são pagamento suficiente, mestre forjador.\" [goodact/]"

msgid "STORY_EVENT@1013_1047@BUTTON_4"
msgstr "\"Forje-me uma nova arma.\" [item/]"

msgid "STORY_EVENT@1013_1047@TITLE"
msgstr "Quente demais para lidar: consequências"

msgid "STORY_EVENT@1013_1054@BODY_FOOTER"
msgstr "O mestre de cerimônias proclama: \"Junte-se ao massacre, derrote meus [hyperlink,GLOBAL.HeroConcept]Heróis[/hyperlink] e ganhe ouro! Ou corra de volta para casa para sua mãe, como todos os {EventHeroRace.Name} fazem.\""

msgid "STORY_EVENT@1013_1054@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "O mestre de cerimônias proclama: \"Junte-se ao massacre, derrote meus [hyperlink,GLOBAL.HeroConcept]Heróis[/hyperlink] e ganhe ouro! Ou use essas pernas bonitas para correr direto de volta para casa.\""

msgid "STORY_EVENT@1013_1054@BODY_HEADER"
msgstr "Enquanto viaja passando por uma colina coroada com os vestígios de um castelo em ruínas, {EventHero.Name} pode ouvir o eco distante de uma multidão em festa. Intrigado, <<p:EventHero>> se aproxima para investigar."

msgid "STORY_EVENT@1013_1054@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Enquanto viaja passando por uma colina coroada com os vestígios de um castelo em ruínas, você ouve o eco distante de uma multidão em festa. Você se aproxima para investigar."

msgid "STORY_EVENT@1013_1054@BODY_LORE"
msgstr "As ruínas se abrem em uma arena de luta improvisada. Na lacuna formada por uma parede quebrada está um grupo de {EventRace.Name}, liderado por um mestre de cerimônias, gesticulando para {EventHero.FirstName}. \"Bem-vindo, espectadores sedentos de sangue!\" <<Cp:EventUnit>> sorri com uma boca faltando a maioria de seus dentes. \"Eu dirijo este estabelecimento de luta móvel. Os gladiadores mais resistentes levam o ouro para casa!\" <<Cp:EventUnit>> levanta uma bolsa cheia de moedas."

msgid "STORY_EVENT@1013_1054@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "As ruínas se abrem em uma arena de luta improvisada. Na lacuna formada por uma parede quebrada está um grupo de {EventRace.Name}, liderado por um mestre de cerimônias, gesticulando para você. \"Um nobre {PlayerLeader.Title} nos honra com a <<o:PlayerLeader>> presença! Bem-vindo, espectador sedento de sangue!\" <<Cp:EventUnit>> sorri com uma boca faltando a maioria de seus dentes. \"Eu dirijo este estabelecimento de luta móvel. Os gladiadores mais resistentes levam o ouro para casa!\" <<Cp:EventUnit>> levanta uma bolsa cheia de moedas."

msgid "STORY_EVENT@1013_1054@BUTTON_0"
msgstr "\"Mostraremos a todos vocês com o que estão lidando.\""

msgid "STORY_EVENT@1013_1054@BUTTON_0@HERO_IS_PLAYERLE"
msgstr "\"Mostrarei a todos vocês com o que estão lidando.\""

msgid "STORY_EVENT@1013_1054@BUTTON_1"
msgstr "Faça uma aposta [gold/] de que vencerá, incentivando seu exército."

msgid "STORY_EVENT@1013_1054@BUTTON_2"
msgstr "Deixe a arena."

msgid "STORY_EVENT@1013_1054@TITLE"
msgstr "Ouro e Gladiadores"

msgid "STORY_EVENT@1013_1055@BODY_FOOTER"
msgstr "\"Aqui está sua parte dos ganhos, agora vamos embora...\" <<Cp:EventUnit>> diz, segurando uma bolsa muito menor de moedas."

msgid "STORY_EVENT@1013_1055@BODY_HEADER"
msgstr "{EventHero.Name} foi vitorioso contra uma banda de gladiadores ferozes. O mestre de cerimônias sorri e tece <<o:EventUnit>> caminho entre os combatentes derrotados."

msgid "STORY_EVENT@1013_1055@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você foi vitorioso contra uma banda de gladiadores ferozes. O mestre de cerimônias sorri e tece <<o:EventUnit>> caminho entre os combatentes derrotados."

msgid "STORY_EVENT@1013_1055@BODY_LORE"
msgstr "\"Incrível! Pelo {GLOBAL.GodirLoreConcept.Hyperlink}, não vi esse tipo de luta há séculos!\" <<Cp:EventUnit>> bate na bolsa de moedas gorda em <<o:EventUnit>> cinto. Moedas tilintam. \"Suponho que seu poderoso {PlayerLeader.Title} espere pagamento.\" <<Cp:EventUnit>> olha ao redor e diz, \"Arrumem as coisas, rapazes! O {EventStructure.Name} tem um novo dono, e <<o:EventHero>> nome é {EventHero.FirstName}.\" <<Cp:EventUnit>> sorri para {EventHero.FirstName} enquanto <<o:EventUnit>> subordinados resmungam e vão embora."

msgid "STORY_EVENT@1013_1055@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "\"Incrível! Pelo {GLOBAL.GodirLoreConcept.Hyperlink}, não vejo esse tipo de luta há séculos!\" <<Cp:EventUnit>> bate na bolsa de moedas gorda no cinto de <<o:EventUnit>>. Moedas tilintam. \"Acho que você espera pagamento, meu {PlayerLeader.Title}.\" <<Cp:EventUnit>> olha ao redor e diz: \"Arrumem as coisas, rapazes! O {EventStructure.Name} tem um novo dono, e o nome de <<o:EventHero>> é {EventHero.FirstName}.\" <<Cp:EventUnit>> sorri para {EventHero.FirstName} enquanto os capangas de <<o:EventUnit>> resmungam e saem."

msgid "STORY_EVENT@1013_1055@BUTTON_0"
msgstr "Exija todo o ouro que lhe é devido antes de permitir que <<P:EventUnit>> saia. [gold/]"

msgid "STORY_EVENT@1013_1055@BUTTON_1"
msgstr "\"Poderíamos usar seus lutadores para instruir os soldados em {EventCity.Name}.\" [unitprod/]"

msgid "STORY_EVENT@1013_1055@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"Eu poderia usar seus lutadores para instruir meus soldados em {EventCity.Name}.\" [unitprod/]"

msgid "STORY_EVENT@1013_1055@BUTTON_2"
msgstr "\"Arenas ilegais são uma calamidade. Melhor você ir embora antes que a lei [order/] te alcance.\""

msgid "STORY_EVENT@1013_1055@BUTTON_3"
msgstr "\"Pedimos que seu campeão mais forte se junte a nós [unit/] no futuro.\""

msgid "STORY_EVENT@1013_1055@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "\"Peço que seu campeão mais forte se junte a mim [unit/] no futuro.\""

msgid "STORY_EVENT@1013_1055@BUTTON_4"
msgstr "\"Pedimos que seu campeão mais forte se junte a nós [unit/].\""

msgid "STORY_EVENT@1013_1055@BUTTON_4@HERO_IS_PLAYERLE"
msgstr "\"Peço que seu campeão mais forte se junte a mim [unit/].\""

msgid "STORY_EVENT@1013_1055@TITLE"
msgstr "Ouro e Gladiadores: Consequências"

msgid "STORY_EVENT@1013_1056@BODY_FOOTER"
msgstr "O estranho rústico sorri, mantendo a distância de <<o:EventHeroB>>. \"Aqueles bastardos armaram armadilhas. Eu posso ajudá-lo a encontrá-las. Você me ajuda e eu te ajudo, que tal?\""

msgid "STORY_EVENT@1013_1056@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "O estranho rústico sorri, mantendo a distância de <<o:EventHeroB>>. \"Aqueles bastardos armaram armadilhas. Eu posso ajudá-lo a encontrá-las. Você me ajuda e eu te ajudo, que tal?\""

msgid "STORY_EVENT@1013_1056@BODY_HEADER"
msgstr "Antes que {EventHero.Name} possa entrar em uma fortaleza infestada de bandidos, <<p:EventHero>> é parado por um assobio próximo."

msgid "STORY_EVENT@1013_1056@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Antes que você possa entrar em uma fortaleza infestada de bandidos, você é parado por um assobio próximo."

msgid "STORY_EVENT@1013_1056@BODY_LORE"
msgstr "Uma mulher de aparência rude aparece de trás de uma parede quebrada. \"Ei, psiu! Vejo que você está tentando entrar no meu antigo acampamento. Eu costumava liderar a gangue de idiotas lá dentro. Mas, depois do nosso último ataque, eles me expulsaram! Motim! Ei, se você der uma lição neles, eu ficarei feliz em apontar para você o nosso esconderijo secreto de saque. Dividindo os despojos, sabe como é?\""

msgid "STORY_EVENT@1013_1056@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Uma mulher de aparência rude aparece de trás de uma parede quebrada. \"Ei, psiu, meu {PlayerLeader.Title}! Vejo que você está tentando entrar no meu antigo acampamento. Eu costumava liderar a gangue de idiotas lá dentro. Mas, depois do nosso último ataque, eles me expulsaram! Motim! Ei, se você der uma lição neles, eu ficarei feliz em apontar para você o nosso esconderijo secreto de saque. Dividindo os despojos, sabe como é?\""

msgid "STORY_EVENT@1013_1056@BUTTON_0"
msgstr "\"Não preciso de ajuda de bandidos como você, eu mesmo limparei essas ruínas.\" [goodact/]"

msgid "STORY_EVENT@1013_1056@BUTTON_1"
msgstr "Permitir que a \"líder\" bandida revele as armadilhas antes de entrar nas ruínas."

msgid "STORY_EVENT@1013_1056@BUTTON_2"
msgstr "Descobrir onde estão as armadilhas usando seu conhecimento de pedra e arquitetura."

msgid "STORY_EVENT@1013_1056@BUTTON_4"
msgstr "Deixar a bandida e sua antiga equipe."

msgid "STORY_EVENT@1013_1056@TITLE"
msgstr "Fúria e Motim"

msgid "STORY_EVENT@1013_1057@BODY_FOOTER"
msgstr "{EventHeroB.Name} leva {EventHero.FirstName} a uma sala cheia de saque de bandidos. \"Ta-dah. Eu vou deixar você com isso...\" <<Cp:EventHeroB>> rapidamente enche <<o:EventHeroB>> bolsos com ouro e tenta sair."

msgid "STORY_EVENT@1013_1057@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "{EventHeroB.Name} leva você a uma sala cheia de saque de bandidos. \"Ta-dah. Eu vou deixar você com isso...\" <<Cp:EventHeroB>> rapidamente enche <<o:EventHeroB>> bolsos com ouro e tenta sair."

msgid "STORY_EVENT@1013_1057@BODY_HEADER"
msgstr "Depois de lidar com o covil de bandidos, {EventHero.Name} pode procurar nas ruínas. <<Cp:EventHero>> é rapidamente acompanhado pela ex-líder bandida."

msgid "STORY_EVENT@1013_1057@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Depois de lidar com o covil de bandidos, você pode procurar nas ruínas. Você é rapidamente acompanhado pela ex-líder bandida."

msgid "STORY_EVENT@1013_1057@BODY_LORE"
msgstr "O estranho suspira enquanto <<p:EventHeroB>> vê os corpos dos antigos companheiros de <<o:EventHeroB>>. \"Que pena. Eles eram bons companheiros, enquanto durou.\" <<Cp:EventHeroB>> leva {EventHero.Name} a uma sala secreta, escondida atrás de uma laje de pedra. \"De qualquer forma, aqui está o esconderijo. Alguns saques bons também, até mesmo um {EventItem.Name}... Meu nome é {EventHeroB.Name}, aliás. Caso nossos caminhos se cruzem novamente.\""

msgid "STORY_EVENT@1013_1057@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "O estranho suspira enquanto <<p:EventHeroB>> vê os corpos dos antigos companheiros de <<o:EventHeroB>>. \"Que pena. Eles eram bons companheiros, enquanto durou.\" <<Cp:EventHeroB>> leva você a uma sala secreta, escondida atrás de uma laje de pedra. \"De qualquer forma, aqui está o esconderijo. Alguns saques bons também, até mesmo um {EventItem.Name}... Meu nome é {EventHeroB.Name}, aliás. Caso nossos caminhos se cruzem novamente.\""

msgid "STORY_EVENT@1013_1057@BUTTON_0"
msgstr "Permitir que os soldados de {EventHero.Name} saqueiem o que quiserem. [morale/]"

msgid "STORY_EVENT@1013_1057@BUTTON_0@HERO_IS_PLAYERLE"
msgstr "Permitir que seus soldados saqueiem o que quiserem. [morale/]"

msgid "STORY_EVENT@1013_1057@BUTTON_1"
msgstr "\"Poderíamos usar um líder ousado [unit/] como você no futuro, {EventHeroB.Name}.\""

msgid "STORY_EVENT@1013_1057@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"Eu poderia usar um líder ousado [unit/] como você no futuro, {EventHeroB.Name}.\""

msgid "STORY_EVENT@1013_1057@BUTTON_3"
msgstr "\"Não tão rápido! Você será julgado [order/] por seus crimes e esses bens roubados serão confiscados.\""

msgid "STORY_EVENT@1013_1057@BUTTON_4"
msgstr "\"Poderíamos usar um líder ousado [unit/] como você do nosso lado, {EventHeroB.Name}.\""

msgid "STORY_EVENT@1013_1057@BUTTON_4@HERO_IS_PLAYERLE"
msgstr "\"Eu poderia usar um líder ousado [unit/] como você do meu lado, {EventHeroB.Name}.\""

msgid "STORY_EVENT@1013_1057@BUTTON_5"
msgstr "Reivindicar todo o saque [gold/] para o império."

msgid "STORY_EVENT@1013_1057@TITLE"
msgstr "Fúria e Motim: Consequências"

msgid "STORY_EVENT@1013_1058@BODY_FOOTER"
msgstr "{EventHero.FirstName} percebe que muitas almas serão libertadas com a derrota do {EnemyUnit.Name}."

msgid "STORY_EVENT@1013_1058@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Você percebe que muitas almas serão libertadas com a derrota do {EnemyUnit.Name}."

msgid "STORY_EVENT@1013_1058@BODY_HEADER"
msgstr "Ao entrar no {EventStructure.Name}, <<p:EventHero>> sente um pavor incompreensível. Lentamente, <<p:EventHero>> se agacha mais perto."

msgid "STORY_EVENT@1013_1058@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Ao entrar no {EventStructure.Name}, você sente um pavor incompreensível. Lentamente, você se agacha mais perto."

msgid "STORY_EVENT@1013_1058@BODY_LORE"
msgstr "No pátio, uma criatura sombria se move com uma graça antinatural. <<Cp:EnemyUnit>> toca o chão, que geme em protesto. Uma luz tremeluzente sobe dele... <<Cp:EnemyUnit>> agarra a luz e a puxa para <<r:EnemyUnit>>.[br/]{EventHero.FirstName} percebe que este é um {EnemyUnit.Name} do {GLOBAL.AstralSeaLoreConcept.Hyperlink}, um ser que, de acordo com o folclore, se alimenta de magia e almas perdidas {GLOBAL.SoulsLoreConcept.Hyperlink}..."

msgid "STORY_EVENT@1013_1058@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "No pátio, uma criatura sombria se move com uma graça antinatural. <<Cp:EnemyUnit>> toca o chão, que geme em protesto. Uma luz tremeluzente sobe dele... <<Cp:EnemyUnit>> agarra a luz e a puxa para <<r:EnemyUnit>>.[br/]Você percebe que este é um {EnemyUnit.Name} do {GLOBAL.AstralSeaLoreConcept.Hyperlink}, um ser que, de acordo com o folclore, se alimenta de magia e almas perdidas {GLOBAL.SoulsLoreConcept.Hyperlink}..."

msgid "STORY_EVENT@1013_1058@BUTTON_0"
msgstr "\"Não há tempo a perder! Este {EnemyUnit.Name} deve ser parado!\""

msgid "STORY_EVENT@1013_1058@BUTTON_1"
msgstr "Canalizar poder mágico bruto [mana/] para enfraquecer o {EnemyUnit.Name} antes de atacar."

msgid "STORY_EVENT@1013_1058@BUTTON_2"
msgstr "Deixar o {EventStructure.Name}."

msgid "STORY_EVENT@1013_1058@BUTTON_3"
msgstr "Conceder a {EventHero.FirstName} seu conhecimento do arcano para enfraquecer o <<g:link^n,EnemyUnit>> neste reino."

msgid "STORY_EVENT@1013_1058@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "Invocar seu conhecimento do arcano para enfraquecer o <<g:link^n,EnemyUnit>> neste reino."

msgid "STORY_EVENT@1013_1058@TITLE"
msgstr "Heróis e Horrores"

msgid "STORY_EVENT@1013_1059@BODY_FOOTER"
msgstr "Duas almas libertadas {GLOBAL.SoulsLoreConcept.Hyperlink} permanecem, desejando levar {EventHero.Name} a suas posses mortais por gratidão antes de seguirem em frente. Qual delas {EventHero.FirstName} segue?"

msgid "STORY_EVENT@1013_1059@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Duas almas libertadas permanecem, desejando levá-lo a suas posses mortais por gratidão antes de seguirem em frente. Qual delas você segue?"

msgid "STORY_EVENT@1013_1059@BODY_HEADER"
msgstr "Rajadas de luz saem das feridas dos monstros derrotados, pequenos dardos de energia zigzagueando em direção ao céu em busca de liberdade."

msgid "STORY_EVENT@1013_1059@BODY_LORE"
msgstr "{EventHero.FirstName} tira um momento para olhar as luzes passageiras antes de desviar <<o:EventHero>> olhar para baixo novamente. Muitos corpos estão espalhados entre as ruínas. Algumas das luzes flutuam até os corpos, como se estivessem se despedindo, antes de desaparecerem no céu. Duas delas oscila, flutuando nas proximidades. Parecem querer guiar {EventHero.FirstName} até seus pertences."

msgid "STORY_EVENT@1013_1059@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Você tira um momento para olhar as luzes passageiras antes de desviar seu olhar para baixo novamente. Muitos corpos estão espalhados entre as ruínas. Algumas das luzes flutuam até os corpos, como se estivessem se despedindo, antes de desaparecerem no céu. Duas delas oscila, flutuando nas proximidades. Parecem querer guiar você até seus pertences."

msgid "STORY_EVENT@1013_1059@BUTTON_0"
msgstr "Siga a alma do mercador, que oferece suas economias [gold/]."

msgid "STORY_EVENT@1013_1059@BUTTON_1"
msgstr "Siga a alma do comandante, que caiu empunhando um {EventItem.Name} [item/]."

msgid "STORY_EVENT@1013_1059@BUTTON_2"
msgstr "Dê a todos os corpos um funeral adequado. Peça apenas pela paz desses espíritos. [goodact/]"

msgid "STORY_EVENT@1013_1059@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "\"Salvar almas perdidas é sua própria recompensa. Não peço mais nada.\" [goodact/]"

msgid "STORY_EVENT@1013_1059@BUTTON_3"
msgstr "Reivindique rapidamente essas almas libertadas para você. [evilact/]"

msgid "STORY_EVENT@1013_1059@TITLE"
msgstr "Heróis e Horroes: Consequências"

msgid "STORY_EVENT@1013_1060@BODY_FOOTER"
msgstr "Piscando na luz, {EventHero.FirstName} percebe que este labirinto seria o lugar ideal para uma emboscada. Algo se aproxima..."

msgid "STORY_EVENT@1013_1060@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Piscando na luz, você percebe que este labirinto seria o lugar ideal para uma emboscada. Algo se aproxima..."

msgid "STORY_EVENT@1013_1060@BODY_HEADER"
msgstr "{EventHero.Name} descobre um bosque de árvores feitas de cristal puro. <<Cp:EventHero>> se sente <<r:EventHero>> confuso com a luz refletida ao redor de <<P:EventHero>>."

msgid "STORY_EVENT@1013_1060@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você descobre um bosque de árvores feitas de cristal puro. Você se sente confuso com a luz refletida ao seu redor."

msgid "STORY_EVENT@1013_1060@BODY_LORE"
msgstr "{EventHero.FirstName} descobre que quanto mais <<p:EventHero>> explora, mais desorientador e sinuoso este labirinto se torna. A floresta de cristal e luz confunde <<o:EventHero>> sentido de direção. Enquanto <<p:EventHero>> e <<o:EventHero>> exército tropeçam pelo labirinto, não têm certeza do que é e do que não é um caminho — ou apenas um reflexo."

msgid "STORY_EVENT@1013_1060@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Você descobre que quanto mais explora, mais desorientador e sinuoso este labirinto se torna. A floresta de cristal e luz confunde seu sentido de direção. Enquanto você e seu exército tropeçam pelo labirinto, não têm certeza do que é e do que não é um caminho — ou apenas um reflexo."

msgid "STORY_EVENT@1013_1060@BUTTON_0"
msgstr "\"Emboscada ou não, recuar mostra fraqueza! Às armas!\""

msgid "STORY_EVENT@1013_1060@BUTTON_1"
msgstr "Use seu conhecimento arcano para distorcer os efeitos do labirinto reflexivo a seu favor."

msgid "STORY_EVENT@1013_1060@BUTTON_2"
msgstr "Recue pelo caminho por onde veio."

msgid "STORY_EVENT@1013_1060@BUTTON_4"
msgstr "Use magia [mana/] para usar o labirinto reflexivo a seu favor."

msgid "STORY_EVENT@1013_1060@TITLE"
msgstr "Labirinto de Cristal"

msgid "STORY_EVENT@1013_1061@BODY_FOOTER"
msgstr "Depois de ajudar <<P:EventUnit>>, o menestrelo abre <<o:EventUnit>> carruagem e gesticula para dentro. \"Obrigado, {EventHero.FirstName}. Escolha sua recompensa.\""

msgid "STORY_EVENT@1013_1061@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Depois de ajudar <<P:EventUnit>>, o menestrelo abre <<o:EventUnit>> carruagem e gesticula para dentro. \"Obrigado, ó {PlayerLeader.Title}. Escolha sua recompensa.\""

msgid "STORY_EVENT@1013_1061@BODY_HEADER"
msgstr "Depois de afastar uma emboscada, {EventHero.Name} avança pela desorientante floresta de cristal. <<Cp:EventHero>> descobre um menestrelo vagante."

msgid "STORY_EVENT@1013_1061@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Depois de afastar uma emboscada, você avança pela desorientante floresta de cristal. Você descobre um menestrelo vagante."

msgid "STORY_EVENT@1013_1061@BODY_LORE"
msgstr "O menestrelo pula de <<o:EventUnit>> carruagem. <<Cp:EventUnit>> está animado em ver {EventHero.FirstName}. \"Oh, grande {EventHero.TitleName}, você é uma maravilha! Estou tão perdido! E os emboscadores! Rufiões em todo lugar! Se você pudesse me guiar pelo labirinto de espelhos, eu lhe darei uma recompensa da minha carruagem.\" Tendo dominado o labirinto, isso não é problema para {EventHero.FirstName}."

msgid "STORY_EVENT@1013_1061@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "O menestrelo pula da carroça de <<o:EventUnit>>. <<Cp:EventUnit>> está animado em vê-lo. \"Oh, grande {PlayerLeader.TitleName}, você é uma maravilha! Estou tão perdido! E os emboscadores! Rufiões em todo lugar! Se você puder me guiar através do labirinto de espelhos, eu lhe darei uma recompensa da minha carroça.\" Tendo dominado o labirinto, isso não é problema para você."

msgid "STORY_EVENT@1013_1061@BUTTON_0"
msgstr "Peça ao menestrelo para se apresentar em {EventCity}. [happiness/]"

msgid "STORY_EVENT@1013_1061@BUTTON_1"
msgstr "Peça ao menestrelo uma parte do [gold/] ouro de <<o:EventUnit>>."

msgid "STORY_EVENT@1013_1061@BUTTON_3"
msgstr "Peça ao menestrelo para compartilhar todo o [knowledge/] conhecimento que <<p:EventUnit>> aprendeu durante as viagens de <<o:EventUnit>>."

msgid "STORY_EVENT@1013_1061@BUTTON_4"
msgstr "\"Cante sobre como você foi salvo pelo lendário [influence/] {PlayerLeader.TitleName}.\""

msgid "STORY_EVENT@1013_1061@TITLE"
msgstr "Labirinto de Cristal: Consequências"

msgid "STORY_EVENT@1013_1066@BODY_FOOTER"
msgstr "\"Confesse e prove que seu {PlayerLeader.Title} é digno da nossa devoção.\" <<g:army^n,EventHero>> olha para <<P:EventHero>>, curioso para ver como <<p:EventHero>> responderá."

msgid "STORY_EVENT@1013_1066@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "\"Confesse e prove que você é digno da nossa devoção.\" Seu exército olha para você, curioso para ver como você responderá."

msgid "STORY_EVENT@1013_1066@BODY_HEADER"
msgstr "{EventHero.Name} se aproxima da {EventStructure}. Palavras desbotadas e ilegíveis estão gravadas na primeira pedra fundamental."

msgid "STORY_EVENT@1013_1066@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você se aproxima da {EventStructure}. Palavras desbotadas e ilegíveis estão gravadas na primeira pedra fundamental."

msgid "STORY_EVENT@1013_1066@BODY_LORE"
msgstr "{EventHero.FirstName} vê uma estátua em ruínas no final do templo, retratando um antigo e desconhecido {GLOBAL.GodirLoreConcept.Hyperlink}. Antes que <<p:EventHero>> possa prosseguir, um {EnemyUnit} aparece, seguido por uma voz trovejante. \"Você caminha pelos salões divinos de um Godir há muito perdido. Seu {PlayerLeader.Title} será seu novo patrono? Prove que <<p:PlayerLeader>> é digno através deste julgamento.\""

msgid "STORY_EVENT@1013_1066@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Você vê uma estátua em ruínas no final do templo, retratando um antigo e desconhecido {GLOBAL.GodirLoreConcept.Hyperlink}. Antes que você possa prosseguir, um {EnemyUnit} aparece, seguido por uma voz trovejante. \"Você caminha pelos salões divinos de um Godir há muito perdido. Você, {PlayerLeader.Title}, será seu novo patrono? Prove que é digno através deste julgamento.\""

msgid "STORY_EVENT@1013_1066@BUTTON_0"
msgstr "\"Não tenho nada a confessar a você. Desafie-me!\""

msgid "STORY_EVENT@1013_1066@BUTTON_1"
msgstr "Pague penitência [gold/] e confesse seus pecados antes de enfrentar o {EnemyUnit}."

msgid "STORY_EVENT@1013_1066@BUTTON_2"
msgstr "Confesse seus pecados com vigor e gravidade."

msgid "STORY_EVENT@1013_1066@BUTTON_3"
msgstr "\"Você quer ouvir sobre meus pecados? Por onde devo começar?\""

msgid "STORY_EVENT@1013_1066@BUTTON_5"
msgstr "Deixe a {EventStructure}."

msgid "STORY_EVENT@1013_1066@BUTTON_6"
msgstr "[goodact/] \"Ninguém está livre de pecado, mas eu procuro ser melhor.\""

msgid "STORY_EVENT@1013_1066@TITLE"
msgstr "Um Novo Credo"

msgid "STORY_EVENT@1013_1067@BODY_FOOTER"
msgstr "A voz desaparece, e com ela, as palavras originais do templo. Um silêncio cai... Como se o templo esperasse por um novo credo."

msgid "STORY_EVENT@1013_1067@BODY_HEADER"
msgstr "{EventHero.Name} suportou os julgamentos da {EventStructure} em seu nome. Os salões ficam em silêncio."

msgid "STORY_EVENT@1013_1067@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você suportou os julgamentos da {EventStructure}. Os salões ficam em silêncio."

msgid "STORY_EVENT@1013_1067@BODY_LORE"
msgstr "Enquanto {EventHero} avança, um brilho passa sobre uma estátua massiva no final do templo. Quando a luz desaparece, a estátua mudou para mostrar ninguém além de você, {PlayerLeader.TitleName}. A voz troveja mais uma vez. \"Você provou ser um {GLOBAL.GodirLoreConcept.Hyperlink} digno, ó {PlayerLeader.Title}. Doravante, este Templo será dedicado a você e à sua palavra divina.\""

msgid "STORY_EVENT@1013_1067@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Enquanto você avança, um brilho passa sobre uma estátua massiva no final do templo. Quando a luz desaparece, a estátua mudou para mostrar ninguém além de você, {PlayerLeader.TitleName}. A voz troveja mais uma vez. \"Você provou ser um {GLOBAL.GodirLoreConcept.Hyperlink} digno, ó {PlayerLeader.Title}. Doravante, este Templo será dedicado a você e à sua palavra divina.\""

msgid "STORY_EVENT@1013_1067@BUTTON_0"
msgstr "\"Perfeição através da mudança.\" [chaosboon/]"

msgid "STORY_EVENT@1013_1067@BUTTON_1"
msgstr "\"Equilíbrio através do crescimento.\" [natureboon/]"

msgid "STORY_EVENT@1013_1067@BUTTON_2"
msgstr "\"Estabilidade através da lei.\" [orderboon/]"

msgid "STORY_EVENT@1013_1067@BUTTON_3"
msgstr "\"Verdade através do entendimento.\" [astralboon/]"

msgid "STORY_EVENT@1013_1067@BUTTON_4"
msgstr "\"Legado através da fortitude.\" [materiumboon/]"

msgid "STORY_EVENT@1013_1067@BUTTON_5"
msgstr "\"Unidade através do sacrifício.\" [goodact/]"

msgid "STORY_EVENT@1013_1067@BUTTON_6"
msgstr "\"Vida através da morte.\" [shadowboon/]"

msgid "STORY_EVENT@1013_1067@BUTTON_7"
msgstr "\"Poder através da ganância.\" [evilact/]"

msgid "STORY_EVENT@1013_1067@BUTTON_8"
msgstr "\"Divindade através da majestade.\" [influence/]"

msgid "STORY_EVENT@1013_1067@TITLE"
msgstr "Um Novo Credo: Consequências"

msgid "STORY_EVENT@1013_1124@BODY_FOOTER"
msgstr "\"Tomamos a liberdade de tomar algumas decisões táticas para aliviar seus fardos, meu {EventHero.Title}! Esperamos que isso lhe agrade!\""

msgid "STORY_EVENT@1013_1124@BODY_HEADER"
msgstr "O cerco a {EventCity.Name} está bem encaminhado, exceto por um problema..."

msgid "STORY_EVENT@1013_1124@BODY_LORE"
msgstr "Ao fazer {EventHero.Possessive} rondas pelo acampamento de cerco, {EventHero.Name} percebe algumas peculiaridades. Exércitos estão mal posicionados, guardas não patrulham locais críticos... {EventHero.FirstName} percebe que continuar dessa forma vai causar problemas e prolongar o cerco desnecessariamente. Um comandante saluta orgulhosamente ao se aproximar de {EventHero.PronounObject}. \"Saudações, {EventHero.TitleName}!\""

msgid "STORY_EVENT@1013_1124@BUTTON_0"
msgstr "Ensinar os soldados sobre a estratégia de cerco adequada."

msgid "STORY_EVENT@1013_1124@BUTTON_1"
msgstr "\"Afaste-se, seus tolos, e nunca tomem essas decisões sem mim novamente.\" [morale/]"

msgid "STORY_EVENT@1013_1124@BUTTON_2"
msgstr "\"Iniciativa, por mais tola que seja, só pode ser recompensada.\" [morale/]"

msgid "STORY_EVENT@1013_1124@TITLE"
msgstr "Mestres do Cerco"

msgid "STORY_EVENT@1013_1126@BODY_FOOTER"
msgstr "<<g:soldiers^p,EventHero>> capturaram {EventRace.Name} fugitivos de {EventCity.Name}. O que <<p:EventHero>> faz com eles?"

msgid "STORY_EVENT@1013_1126@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Seus soldados capturaram nobres fugitivos de {EventCity.Name}. O que você faz com eles?"

msgid "STORY_EVENT@1013_1126@BODY_HEADER"
msgstr "Durante o cerco de {EventCity.Name} liderado pelo seu [hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink] {EventHero.Name}, um grupo de cidadãos capturados é apresentado a <<P:EventHero>>."

msgid "STORY_EVENT@1013_1126@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Durante o cerco de {EventCity.Name}, um grupo de cidadãos capturados é apresentado a você."

msgid "STORY_EVENT@1013_1126@BODY_LORE"
msgstr "É um grupo de {EventRace.Name} angustiados de {EventCity.Name} que tentaram escapar pelos esgotos subterrâneos. Independentemente de suas origens, todos parecem igualmente desalinhados e assustados enquanto são empurrados em direção a {EventHero.FirstName}. Um dos soldados de <<o:EventHero>> fala. \"Nossos batedores os encontraram, meu {EventHero.Title}. Temos certeza de que podemos obter algumas informações úteis deles...\""

msgid "STORY_EVENT@1013_1126@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "É um grupo de {EventRace.Name} angustiados de {EventCity.Name} que tentaram escapar pelos esgotos subterrâneos. Independentemente de suas origens, todos parecem igualmente desalinhados e assustados enquanto são empurrados em sua direção. Um dos seus soldados fala. \"Nossos batedores os encontraram, meu {PlayerLeader.Title}. Temos certeza de que podemos obter algumas informações úteis deles...\""

msgid "STORY_EVENT@1013_1126@BUTTON_0"
msgstr "\"Interrogue-os sobre possíveis fraquezas nas defesas da cidade.\""

msgid "STORY_EVENT@1013_1126@BUTTON_2"
msgstr "\"Mate-os e jogue suas cabeças sobre o muro da cidade. Isso deve enfraquecer a resistência.\" [evilact/]"

msgid "STORY_EVENT@1013_1126@BUTTON_3"
msgstr "\"Deixe-os ir. Esses cidadãos não são nosso alvo.\" [goodact/]"

msgid "STORY_EVENT@1013_1126@TITLE"
msgstr "Prisioneiros Fugitivos Capturados"

msgid "STORY_EVENT@1013_1127@BODY_FOOTER"
msgstr "As principais guildas de {EventCity.Name} planejam realizar uma parada em sua honra, mas não conseguem decidir sobre o tema."

msgid "STORY_EVENT@1013_1127@BODY_HEADER"
msgstr "Você tratou bem seus cidadãos em {EventCity.Name} e uma parada foi organizada para celebrá-lo como seu {PlayerLeader.Title}."

msgid "STORY_EVENT@1013_1127@BODY_LORE"
msgstr "Durante os preparativos para a parada, o {EventHero.Title} da cidade busca seu conselho. \"Os mestres das guildas não conseguem decidir sobre o tema da parada!\" diz {EventHero.TitleName}. \"Todos queriam mostrar suas diversas habilidades. Eu tentei raciocinar com eles, até ameacei com punição corporal, mas eles não chegam a um acordo. Claro, eles vão obedecer a você, meu {PlayerLeader.Title}...\""

msgid "STORY_EVENT@1013_1127@BUTTON_0"
msgstr "\"Os guardas e soldados da cidade [unitprod/] devem ser saudados.\""

msgid "STORY_EVENT@1013_1127@BUTTON_1"
msgstr "\"Celebre nossa cidade florescente e seu povo!\" [food/]"

msgid "STORY_EVENT@1013_1127@BUTTON_2"
msgstr "\"Os artesãos [structureprod/] de {EventCity.Name} são seu orgulho e alegria.\""

msgid "STORY_EVENT@1013_1127@BUTTON_4"
msgstr "\"Homenagearemos os cidadãos mais virtuosos de {EventCity.Name}. [influence/]\""

msgid "STORY_EVENT@1013_1127@BUTTON_5"
msgstr "\"Exijo obediência [influence/]. Desfile os prisioneiros pela cidade em direção à sua execução.\""

msgid "STORY_EVENT@1013_1127@TITLE"
msgstr "<<g:Parada^n,PlayerLeader.Title>>"

msgid "STORY_EVENT@1013_1131@BODY_FOOTER"
msgstr "{EventCity.Name} está sendo dominada por fora-da-lei devido à sua {GLOBAL.CityStabilityConcept.Hyperlink}. Como você responde?"

msgid "STORY_EVENT@1013_1131@BODY_HEADER"
msgstr "Você negligenciou sua população de {EventCity.Name}. Agora, o crime atingiu um nível recorde."

msgid "STORY_EVENT@1013_1131@BODY_LORE"
msgstr "Batedores de carteira vagam pelas ruas e bandidos assaltam casas à noite. Os comerciantes recorreram a pagar gangues por \"proteção\", mas isso levou a conflitos entre os distritos da cidade. Não demorará muito para a cidade cair em tumultos e anarquia."

msgid "STORY_EVENT@1013_1131@BUTTON_0"
msgstr "Acabe com esta anarquia [happiness/] implantando toda a sua guarnição [unitprod/]."

msgid "STORY_EVENT@1013_1131@BUTTON_1"
msgstr "A cidade não \"cai\" no caos. Ela é curada por ele!"

msgid "STORY_EVENT@1013_1131@BUTTON_2"
msgstr "Chame reforços de {PlayerCapital.Name} para ajudar {EventCity.Name} a se recuperar. [unitprod/] [gold/] [happiness/]"

msgid "STORY_EVENT@1013_1131@BUTTON_3"
msgstr "Prenda as famílias dos criminosos e execute [population/] todos eles. [evilact/] [happiness/]"

msgid "STORY_EVENT@1013_1131@BUTTON_4"
msgstr "\"Não tenho tempo para isso.\""

msgid "STORY_EVENT@1013_1131@TITLE"
msgstr "Cidade de Foras-da-Lei"

msgid "STORY_EVENT@1013_1166@BODY_FOOTER"
msgstr "Não há como raciocinar com {EventNimue}. Você só pode libertar o reino derrotando-a."

msgid "STORY_EVENT@1013_1166@BODY_HEADER"
msgstr "Você encontra {EventNimue.Name} em pessoa, seus olhos fervendo de ódio e insanidade."

msgid "STORY_EVENT@1013_1166@BODY_LORE"
msgstr "\"Você! Intruso, trespassador! O que você está fazendo no meu reino?! Sua suposta \"{EventRace}\" feia o mancha com imperfeição! Não importa. Você será facilmente destruído pelo meu amado {EventNimueRace}, e então usarei suas essências para fortalecer ainda mais meu povo! Você deveria ser grato, então fará parte da verdadeira perfeição.\""

msgid "STORY_EVENT@1013_1166@BUTTON_0"
msgstr "\"Guerra será!\""

msgid "STORY_EVENT@1013_1166@TITLE"
msgstr "A {EventNimue.Title}"

msgid "STORY_EVENT@1013_1194@BODY_FOOTER"
msgstr "\"Se você realmente deseja nos libertar dela, ajude meu povo a não viver mais com medo. Destrua a infestação e derrote os caçadores que nos ameaçam.\""

msgid "STORY_EVENT@1013_1194@BODY_HEADER"
msgstr "{EventPlayerLeader} suspira aliviado. \"Esperamos tanto tempo por um {GLOBAL.GodirLoreConcept.Hyperlink} benevolente para nos ajudar.\""

msgid "STORY_EVENT@1013_1194@BODY_LORE"
msgstr "\"Desde que {EventNimue.FirstName} nos descartou, vivemos com medo. Seus escravos caçam nosso povo como se fôssemos troféus, e a vida selvagem nos atormenta por onde vamos. Tento convencer meu povo de que podemos ficar fortes o suficiente para revidar, mas o medo deles é... enraizado. Enquanto isso, monstros se aproximam de nós. Em breve, não haverá mais lugar para onde fugir.\""

msgid "STORY_EVENT@1013_1194@BUTTON_0"
msgstr "\"Eu vou ajudar você e sua {EventPlayerRace.Name}.\""

msgid "STORY_EVENT@1013_1194@BUTTON_1"
msgstr "\"Não tenho tempo para esta missão.\""

msgid "STORY_EVENT@1013_1194@TITLE"
msgstr "Os {EventPlayerRace.Name}"

msgid "STORY_EVENT@1013_1195@BODY_FOOTER"
msgstr "{EventPlayerLeader.FirstName} esfrega <<o:EventPlayerLeader>> a têmpora. \"Se deseja me convencer, convença primeiro o {EventHouseLord.Title} de {EventHouse.Name} de suas boas intenções. Respeito os insights de <<o:EventHouseLord>>.\""

msgid "STORY_EVENT@1013_1195@BODY_HEADER"
msgstr "{EventPlayerLeader} resmunga. \"Você tem histórias sobre minha deusa? Mentiras, sem dúvida...\" <<Cp:EventPlayerLeader>> pausa por um momento. \"Muito bem, devo respeitar as regras da negociação.\""

msgid "STORY_EVENT@1013_1195@BODY_LORE"
msgstr "\"Através dos meus deveres, conheci outros com quem compartilho bons contatos. Alguns contam as histórias mais estranhas sobre o amor da deusa... virando ira. Mas isso não pode ser! Essas pessoas caíram da graça da deusa, mas tenho certeza de que é um mal-entendido. Ela nunca nos afogaria verdadeiramente... Faria?\" <<Cp:EventPlayerLeader>> estremece, como se <<p:EventPlayerLeader>> estivesse sendo repreendido por algo que você não pode ouvir."

msgid "STORY_EVENT@1013_1195@BUTTON_0"
msgstr "\"Muito bem, {EventPlayerLeader.TitleName}. Vou convencer <<P:EventHouseLord>>, e você.\""

msgid "STORY_EVENT@1013_1195@BUTTON_2"
msgstr "\"Não tenho tempo para me misturar com cidades menores.\""

msgid "STORY_EVENT@1013_1195@TITLE"
msgstr "Voz da Razão"

msgid "STORY_EVENT@1013_1260@BODY_FOOTER"
msgstr "Retornar aqui com um [hyperlink,GLOBAL.HeroConcept]Herói[/hyperlink] permitirá que você assuma o controle da {EventStructure} pacificamente."

msgid "STORY_EVENT@1013_1260@BODY_HEADER"
msgstr "Seu exército encontra tropas de {EventHouse.Name} guardando uma {EventStructure.Name}."

msgid "STORY_EVENT@1013_1260@BODY_LORE"
msgstr "As tropas, lideradas por um {EventStackLeader}, chamam de longe. \"Declare sua intenção. Onde está seu líder? Temos ordens para falar apenas com verdadeiros [hyperlink,GLOBAL.HeroConcept]Heróis[/hyperlink].\""

msgid "STORY_EVENT@1013_1260@BUTTON_0"
msgstr "Organize uma audiência diplomática com {EventHouseLord.Name} de {EventHouse.Name}."

msgid "STORY_EVENT@1013_1260@BUTTON_2"
msgstr "Atacar! Esta é a oportunidade de atacar!"

msgid "STORY_EVENT@1013_1260@BUTTON_3"
msgstr "Desengajar e deixá-los em paz."

msgid "STORY_EVENT@1013_1260@TITLE"
msgstr "Guardas de {EventHouse.Name} da {EventStructure.Name}."

msgid "STORY_EVENT@1013_1272@BODY_FOOTER"
msgstr "\"Algo aqui... me afeta.\" {Sundren.FirstName} diz. \"Não confio nos meus sentidos. Seguirei seu exemplo, {PlayerLeader.FirstName}. Devemos descobrir o que aflige a Corte Eterna.\""

msgid "STORY_EVENT@1013_1272@BODY_HEADER"
msgstr "Você chega ao reino chamado Corte Eterna. Mesmo com as flores desabrochando e os pássaros cantando, o ar parece... viciado."

msgid "STORY_EVENT@1013_1272@BODY_LORE"
msgstr "Você é acompanhado por {Sundren.TitleName}, que franze a testa ao chegar. \"Este não é o jeito que {GLOBAL.AuldwealdLoreConcept.Hyperlink} foi descrito para mim. Como um dos mundos de origem dos Elfos, deveria ser exuberante e grandioso. No fundo, todos os Elfos anseiam por este mundo, mas...\" <<Cp:Sundren>> de repente estremece e segura a cabeça. \"Ouço... você ouve isso? Sussurros... Algo está muito errado neste reino.\""

msgid "STORY_EVENT@1013_1272@BUTTON_0"
msgstr "\"Vou investigar o que aconteceu aqui.\""

msgid "STORY_EVENT@1013_1272@TITLE"
msgstr "A Corte Eterna"

msgid "STORY_EVENT@1013_1274@BODY_FOOTER"
msgstr "\"Agora, a única tarefa que resta é escoltar {Meandor.TitleName} para Magehaven para encontrar o Pacto.\""

msgid "STORY_EVENT@1013_1274@BODY_FOOTER@SUNDRENQUEST_NOT"
msgstr "\"Ainda tenho assuntos inacabados neste reino. Eu pediria que permanecesse aqui para oferecer sua ajuda. Mas... não posso forçá-lo, ó {PlayerLeader.Title}.\""

msgid "STORY_EVENT@1013_1274@BODY_HEADER"
msgstr "Você libertou a Corte Eterna de sua maldição, salvando assim uma parte importante de {GLOBAL.AuldwealdLoreConcept.Hyperlink} de uma ruína certa."

msgid "STORY_EVENT@1013_1274@BODY_HEADER@SUNDRENQUEST_NOT"
msgstr "Você quebrou a maldição que afetava Meandor e a Corte Eterna. Antes que você possa escoltar {Meandor.FirstName} para {GLOBAL.MagehavenLoreConcept.Hyperlink}, no entanto, {Sundren.FirstName} se aproxima de você."

msgid "STORY_EVENT@1013_1274@BODY_LORE"
msgstr "Levará tempo para as florestas de Auldweald se recuperarem, mas você tornou isso possível. As {GLOBAL.SoulsLoreConcept.Hyperlink} que estavam presas dentro agora podem seguir para {GLOBAL.TheWellLoreConcept.Hyperlink} e além. {Sundren.TitleName} acena severamente."

msgid "STORY_EVENT@1013_1274@BODY_LORE@SUNDRENQUEST_NOT"
msgstr "\"Parabéns, {PlayerLeader.TitleName}. Você quebrou o feitiço em {Meandor.FirstName} e, assim, salvou a Corte Eterna de sua maldição mortal. No entanto... ainda me sinto assombrado, mesmo agora que a maldição foi quebrada. Talvez um remanescente ainda persista... Mantendo-me aqui.\""

msgid "STORY_EVENT@1013_1274@BUTTON_0"
msgstr "'Tis bom ser um Godir."

msgid "STORY_EVENT@1013_1274@BUTTON_0@SUNDRENQUEST_NOT"
msgstr "Deixe-a retornar a Magehaven, vitoriosa!"

msgid "STORY_EVENT@1013_1274@BUTTON_1"
msgstr "Fique até que Sundren encontre a fonte dessas vozes."

msgid "STORY_EVENT@1013_1274@TITLE"
msgstr "A Corte Eterna: Vitória"

msgid "STORY_EVENT@1013_1274@TITLE@SUNDRENQUEST_NOT"
msgstr "Assuntos Inacabados"

msgid "STORY_EVENT@1013_1295@BODY_FOOTER"
msgstr "Acredito que {Meandor.FirstName} esteja aflito por um feitiço poderoso e localizei aparições que parecem estar conectadas a ele. No entanto, não posso investigá-las adequadamente sozinha."

msgid "STORY_EVENT@1013_1295@BODY_HEADER"
msgstr "{Melenis.FirstName} ri com desdém. \"Se deseja mudar o destino deste reino, deve lidar com meu marido.\""

msgid "STORY_EVENT@1013_1295@BODY_LORE"
msgstr "Aventurei-me aqui para encontrá-lo, esperando que nosso reencontro levasse a uma aliança renovada. Mas ele se tornou pateticamente obcecado com o destino de todas as {GLOBAL.SoulsLoreConcept.Hyperlink} dentro do {GLOBAL.AstralSeaLoreConcept.Hyperlink}. Sempre que ouso me aproximar de seus animais de estimação translúcidos, ele me chama de \"traidora mortal\" e ameaça me atacar. A mim! Tentei raciocinar com ele, mas ele não me dá ouvidos. Decepcionante."

msgid "STORY_EVENT@1013_1295@BUTTON_0"
msgstr "Visitarei as fontes que você menciona."

msgid "STORY_EVENT@1013_1295@BUTTON_2"
msgstr "Derrotar {Meandor.FirstName} em batalha é uma maneira melhor de resolver sua aflição!"

msgid "STORY_EVENT@1013_1295@BUTTON_3"
msgstr "Se algo aflige este reino, és tu, Melenis! Prepare-se para a guerra!"

msgid "STORY_EVENT@1013_1295@TITLE"
msgstr "Teia da Loucura"

msgid "STORY_EVENT@1013_1297@BODY_FOOTER"
msgstr "Um Godir poderoso deve reclamar este reino para mudar seu destino. Talvez... esse Godir não deva ser eu."

msgid "STORY_EVENT@1013_1297@BODY_FOOTER@MEANDOR_DEFEATED"
msgstr "Suas palavras desaparecem. \"O que eu fiz... Em minha ausência... livre o reino da minha maldição.\""

msgid "STORY_EVENT@1013_1297@BODY_HEADER"
msgstr "Ao eliminar suas fontes, você quebrou o feitiço que manteve Meandor ocupado por tanto tempo. Você é contactado pelo próprio {Meandor.Title}."

msgid "STORY_EVENT@1013_1297@BODY_HEADER@MEANDOR_DEFEATED"
msgstr "Ao eliminar suas fontes, você quebrou o feitiço que manteve Meandor ocupado. Mesmo através do {GLOBAL.AstralVoidLoreConcept.Hyperlink}, ele consegue contactar você."

msgid "STORY_EVENT@1013_1297@BODY_LORE"
msgstr "\"Uma névoa... está se dissipando. Foi você quem fez isso, {PlayerLeader.TitleName}? Talvez nem todos que visitam sejam invasores, afinal.\"[br/]Seu olhar se volta para o reino fantasma ao seu redor. \"Parece que nem eu posso me dar o consolo que anseio. Durante minha... aflição, coloquei coisas em movimento que não posso desfazer sozinho. Cada vez mais almas serão atraídas para cá.\""

msgid "STORY_EVENT@1013_1297@BODY_LORE@MEANDOR_DEFEATED"
msgstr "\"No vazio, sinto que uma névoa está... se dissipando. Foi você quem fez isso, {PlayerLeader.TitleName}? Vejo agora que eu estava... aflito. Coloquei coisas em movimento que não posso desfazer. Mesmo agora... sinto como cada vez mais {GLOBAL.SoulsLoreConcept.Hyperlink} são atraídas para o reino que criei. Elas logo serão vítimas de predadores do {GLOBAL.AstralSeaLoreConcept.Hyperlink}...\""

msgid "STORY_EVENT@1013_1297@BUTTON_0"
msgstr "Aceite sua derrota, então, {Meandor.TitleName}, e deixe este reino para que eu possa resolver o que você causou."

msgid "STORY_EVENT@1013_1297@BUTTON_6"
msgstr "Proponho uma aliança. Vamos reclamar este reino e libertar suas almas, juntos!"

msgid "STORY_EVENT@1013_1297@BUTTON_7"
msgstr "Deixe o {Meandor.Title} viajar pelo vazio por enquanto."

msgid "STORY_EVENT@1013_1297@TITLE"
msgstr "Teia da Loucura: Consequências"

msgid "STORY_EVENT@1013_1298@BODY_FOOTER"
msgstr "A voz de Meandor ecoa por todo o reino. \"Não serei deixado para morrer novamente, não deixarei este tribunal cair novamente. A Corte Eterna permanecerá preservada e silenciosa. Para sempre!\""

msgid "STORY_EVENT@1013_1298@BODY_HEADER"
msgstr "{Meandor.Name} aparece, furioso. \"Eu avisei para me deixarem em paz, e ainda assim insistem em perturbar minha paz?!\""

msgid "STORY_EVENT@1013_1298@BODY_LORE"
msgstr "\"Todos vocês, mortais, são iguais, invejosos de nossa superioridade. Vocês não podiam nos deixar viver, e agora não podem me deixar lamentar. Meu pai foi um tolo por confiar em vocês da primeira vez que pisaram em {GLOBAL.AthlaLoreConcept.Hyperlink}, assim como minha irmã!\""

msgid "STORY_EVENT@1013_1298@BUTTON_0"
msgstr "\"Se for preciso uma guerra para perturbar este reino sem vida, que assim seja.\""

msgid "STORY_EVENT@1013_1298@TITLE"
msgstr "Meandor Revida"

msgid "STORY_EVENT@1013_1334@BODY_FOOTER"
msgstr "\"Você está aqui para me ajudar nesta busca por morte e esquecimento? Ou vai se juntar às muitas almas amaldiçoadas {GLOBAL.SoulsLoreConcept.Hyperlink} neste reino?\""

msgid "STORY_EVENT@1013_1334@BODY_HEADER"
msgstr "{Melenis.Name} cumprimenta você com um sorriso frio. \"Ah. Outra alma perdida, vagando por este reino de morte e destruição.\""

msgid "STORY_EVENT@1013_1334@BODY_LORE"
msgstr "\"Meu marido pode querer reviver suas memórias, mas eu não posso ficar parada enquanto ele se concentra nos fantasmas de seu passado.\" Ela suspira, frustrada. \"Não pararei até que todo [hyperlink,GLOBAL.WorldsWithinLoreConcept]mundo[/hyperlink] no {GLOBAL.AstralSeaLoreConcept.Hyperlink} seja nada além de pó, interrompendo o ciclo de destruição e criação na desolação intermediária. Eu esperava que meu marido se juntasse a mim, mas ele está... aflito.\""

msgid "STORY_EVENT@1013_1334@BODY_LORE@CURSE_BROKEN"
msgstr "\"Não pararei até que todo reino, todo [hyperlink,GLOBAL.WorldsWithinLoreConcept]mundo[/hyperlink] no {GLOBAL.AstralSeaLoreConcept.Hyperlink} seja nada além de pó, interrompendo o ciclo de destruição e criação na desolação intermediária. Aventurei-me aqui para encontrar meu marido {Meandor.FirstName}, esperando que nosso reencontro levasse a uma aliança renovada. Mas mesmo agora que a maldição sobre meu marido foi quebrada, ele parece pateticamente passivo.\""

msgid "STORY_EVENT@1013_1334@BUTTON_1"
msgstr "\"Estou aqui para reclamar este reino.\""

msgid "STORY_EVENT@1013_1334@BUTTON_2"
msgstr "\"Nossos objetivos estão alinhados, {Melenis.FirstName}. Juntos, construiremos um império de ossos!\""

msgid "STORY_EVENT@1013_1334@BUTTON_3"
msgstr "\"Se algo aflige este reino, é você, Melenis! Prepare-se para a guerra!\""

msgid "STORY_EVENT@1013_1334@TITLE"
msgstr "Encontrando {Melenis.Name}"

msgid "STORY_EVENT@1013_1336@BODY_FOOTER"
msgstr "Meandor rosna. \"Eu sou Godir! Eu ressuscito os mortos e comando os espíritos! Como ousa me dar lições em meu próprio domínio!\""

msgid "STORY_EVENT@1013_1336@BODY_HEADER"
msgstr "Você entra no domínio fantasma de {Meandor.TitleName}. \"Você!\" ele diz. \"Invasor! Atormentador. Por que não pode me deixar em paz?!\""

msgid "STORY_EVENT@1013_1336@BODY_LORE"
msgstr "Sundren intervém. \"Meandor, tio, por favor. Os {GLOBAL.GodirLoreConcept.Hyperlink} do {GLOBAL.CovenantFactionLoreConcept.Hyperlink} precisam de você... Eu preciso de você. Não quero lutar contra você, mas farei se for necessário. Eu também conheço a perda, mas esta não é a maneira de governar. Você e seu reino estão estagnados... Você não pode reverter o passado, não importa o quanto deseje.\""

msgid "STORY_EVENT@1013_1336@BUTTON_0"
msgstr "\"Você está sendo enganado, Meandor. Há uma maldição afetando você.\""

msgid "STORY_EVENT@1013_1336@BUTTON_1"
msgstr "\"Não há utilidade em tentar raciocinar com Meandor agora.\""

msgid "STORY_EVENT@1013_1336@TITLE"
msgstr "Domínio do {Meandor.Title}"

msgid "STORY_EVENT@1013_1355@BODY_FOOTER"
msgstr "Meandor esfrega a têmpora, atormentado mais uma vez. \"Não, você está apenas aqui para tirar vantagem da minha dor. Vá embora! Vá embora...\""

msgid "STORY_EVENT@1013_1355@BODY_HEADER"
msgstr "Você fala sobre a maldição que afeta Meandor. Sua expressão fica mais perturbada a cada palavra que você diz."

msgid "STORY_EVENT@1013_1355@BODY_LORE"
msgstr "\"Uma... maldição?\" Ele diz. \"Impossível, nenhum {GLOBAL.GodirLoreConcept.Hyperlink} poderia me enganar - mas... os {GLOBAL.ShadraiFactionLoreConcept.Hyperlink}... É por causa do Gildercoil? Eles querem usá-lo - é uma chave...\" Cordas invisíveis parecem puxá-lo, e sua expressão endurece mais uma vez. \"Não. Eu sou o {Meandor.Title}, primeiro filho de Inioch. Vocês, mortais, tentam me enganar e tomar meu trono legítimo.\""

msgid "STORY_EVENT@1013_1355@BUTTON_0"
msgstr "\"Lançá-lo no vazio será uma misericórdia, Meandor.\""

msgid "STORY_EVENT@1013_1355@TITLE"
msgstr "Domínio do {Meandor.Title}: Continuação"

msgid "STORY_EVENT@1013_1357@BODY_FOOTER"
msgstr "\"Eu preservarei cada alma que chegar aqui...\" {Meandor.FirstName} não parece interessado em negociações com você em seu estado atual."

msgid "STORY_EVENT@1013_1357@BODY_HEADER"
msgstr "Você conhece o Governante deste reino, o próprio {Meandor.Title}. O olhar de <<Co:Meandor>> está ausente; ele parece olhar direto através de você."

msgid "STORY_EVENT@1013_1357@BODY_LORE"
msgstr "“Então, eu conheço {PlayerLeader.TitleName}. Você está aqui para se tornar parte da minha Corte Eterna? Ou são intrusos, aqui para saquear meu reino como os Humanos fizeram com o de meu pai? Todos os Elfos estão conectados a este mundo. Quando são arrancados da vida, muitas {GLOBAL.SoulsLoreConcept.Hyperlink} almas élficas tentam retornar aqui. Muitas nunca conseguem, perdendo-se. Eu não deixarei que isso aconteça novamente.”"

msgid "STORY_EVENT@1013_1357@BUTTON_0"
msgstr "Continue a ouvir seus murmúrios."

msgid "STORY_EVENT@1013_1357@BUTTON_1"
msgstr "\"Não há como raciocinar com você. Às armas!\""

msgid "STORY_EVENT@1013_1357@BUTTON_2"
msgstr "\"Apenas fique fora do meu caminho.\""

msgid "STORY_EVENT@1013_1357@TITLE"
msgstr "Conhecendo {Meandor.FirstName}"

msgid "STORY_EVENT@1013_1497@BODY_FOOTER"
msgstr "Você poderia enviar o humilde {EventHouseLord.TitleName}, uma de suas [whisperingStone/] Pedras de Sussurro, para começar a ganhar influência sobre {EventHouse.Name}."

msgid "STORY_EVENT@1013_1497@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da [hyperlink,GLOBAL.IndependentCityConcept.Hyperlink]Cidade Livre[/hyperlink] {EventHouse.Name} treme diante de você, claramente ciente da sua [hyperlink,GLOBAL.AlignmentConcept]reputação[/hyperlink] no reino."

msgid "STORY_EVENT@1013_1497@BODY_LORE"
msgstr "\"Saudações, {PlayerLeader.TitleName}. Estamos... impressionados com os métodos que você usa para expandir seu reino. Nós, {EventHouseRace.Name}, humildemente pedimos que respeite nosso território e independência, não obstante.\""

msgid "STORY_EVENT@1013_1497@BUTTON_0"
msgstr "\"Deixe-me avaliar se {EventHouse.Name} merece minha atenção.\""

msgid "STORY_EVENT@1013_1497@BUTTON_2"
msgstr "\"Aproveite sua liberdade... por enquanto.\""

msgid "STORY_EVENT@1013_1497@TITLE"
msgstr "Conhecendo a Ansiosa {EventHouse.Name}"

msgid "STORY_EVENT@1013_1498@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um dos seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> e gradualmente melhorar sua {GLOBAL.HouseInfluenceConcept.Hyperlink} com você."

msgid "STORY_EVENT@1013_1498@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da [hyperlink,GLOBAL.IndependentCityConcept.Hyperlink]Cidade Livre[/hyperlink] {EventHouse.Name} se curva profundamente para você, claramente ciente da sua [hyperlink,GLOBAL.AlignmentConcept]reputação[/hyperlink] no reino."

msgid "STORY_EVENT@1013_1498@BODY_LORE"
msgstr "\"Saudações, {PlayerLeader.TitleName}! Raramente conhecemos um {PlayerLeader.Title} tão [hyperlink,GLOBAL.AlignmentConcept]benevolente[/hyperlink] quanto você. Estamos honrados em ser agraciados com sua glória e esperamos que todos os {EventHouseRace.Name} aprendam com sua sabedoria.\""

msgid "STORY_EVENT@1013_1498@BUTTON_0"
msgstr "Inspecione a cidade reverente {EventHouse.Name}."

msgid "STORY_EVENT@1013_1498@BUTTON_2"
msgstr "\"Vamos conversar mais no futuro.\""

msgid "STORY_EVENT@1013_1498@TITLE"
msgstr "Conhecendo a Humilde {EventHouse.Name}"

msgid "STORY_EVENT@1013_1499@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um dos seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> e gradualmente melhorar sua {GLOBAL.HouseInfluenceConcept.Hyperlink} com você."

msgid "STORY_EVENT@1013_1499@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da [hyperlink,GLOBAL.IndependentCityConcept.Hyperlink]Cidade Livre[/hyperlink] {EventHouse.Name} cumprimenta você com alguma suspeita."

msgid "STORY_EVENT@1013_1499@BODY_LORE"
msgstr "\"Saudações, {PlayerLeader.TitleName}. Sua [hyperlink,GLOBAL.AlignmentConcept]reputação[/hyperlink] o precede... Perdoe-nos por sermos cautelosos. Podemos não compartilhar de suas crenças, mas pedimos que respeite <<g:territory^n,EventHouse>> e independência, não obstante.\""

msgid "STORY_EVENT@1013_1499@BUTTON_0"
msgstr "\"Deixe-me avaliar se a insignificante {EventHouse.Name} é digna da minha atenção.\""

msgid "STORY_EVENT@1013_1499@BUTTON_2"
msgstr "\"Aproveite sua liberdade... por enquanto.\""

msgid "STORY_EVENT@1013_1499@TITLE"
msgstr "Conhecendo a Vigilante {EventHouse.Name}"

msgid "STORY_EVENT@1013_1500@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um dos seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> e gradualmente melhorar sua {GLOBAL.HouseInfluenceConcept.Hyperlink} com você."

msgid "STORY_EVENT@1013_1500@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} cumprimenta você com alguma reverência."

msgid "STORY_EVENT@1013_1500@BODY_LORE"
msgstr "\"Saudações, {PlayerLeader.TitleName}. Sua [hyperlink,GLOBAL.AlignmentConcept]reputação[/hyperlink] precede você. Nos dá esperança encontrar um {PlayerLeader.Title} que compartilha nossas crenças. Ansiamos aprender com você e confiamos que você respeitará <<g:territory^n,EventHouse>> e independência.\""

msgid "STORY_EVENT@1013_1500@BUTTON_0"
msgstr "Inspecione {EventHouse.Name}."

msgid "STORY_EVENT@1013_1500@BUTTON_2"
msgstr "\"Certamente nos encontraremos novamente no futuro.\""

msgid "STORY_EVENT@1013_1500@TITLE"
msgstr "Encontrando o Bondoso {EventHouse.Name}"

msgid "STORY_EVENT@1013_1501@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um dos seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> e gradualmente melhorar sua {GLOBAL.HouseInfluenceConcept.Hyperlink} com você."

msgid "STORY_EVENT@1013_1501@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} cumprimenta você com um sorriso astuto."

msgid "STORY_EVENT@1013_1501@BODY_LORE"
msgstr "\"Saudações, {PlayerLeader.TitleName}. Sua [hyperlink,GLOBAL.AlignmentConcept]reputação[/hyperlink] precede você. Agradece-nos encontrar um {PlayerLeader.Title} que compartilha nossas convicções. No entanto, pedimos que você respeite <<g:independence^n,EventHouse>>.\""

msgid "STORY_EVENT@1013_1501@BUTTON_0"
msgstr "Avalie se os espíritos afins de {EventHouse.Name} são dignos da sua atenção."

msgid "STORY_EVENT@1013_1501@BUTTON_2"
msgstr "\"Aproveite sua independência... por enquanto.\""

msgid "STORY_EVENT@1013_1501@TITLE"
msgstr "Encontrando o Nefário {EventHouse.Name}"

msgid "STORY_EVENT@1013_1503@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um dos seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> e gradualmente melhorar sua {GLOBAL.HouseInfluenceConcept.Hyperlink} com você."

msgid "STORY_EVENT@1013_1503@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} cumprimenta você com curiosidade."

msgid "STORY_EVENT@1013_1503@BODY_LORE"
msgstr "\"Saudações, {PlayerLeader.TitleName}. Sua [hyperlink,GLOBAL.AlignmentConcept]reputação[/hyperlink] precede você. Podemos não compartilhar suas convicções nobres, mas confiamos que você honrará <<g:territory^n,EventHouse>> e independência.\""

msgid "STORY_EVENT@1013_1503@BUTTON_0"
msgstr "Inspecione {EventHouse.Name}."

msgid "STORY_EVENT@1013_1503@BUTTON_2"
msgstr "\"Certamente nos encontraremos novamente no futuro.\""

msgid "STORY_EVENT@1013_1503@TITLE"
msgstr "Encontrando o Neutro {EventHouse.Name}"

msgid "STORY_EVENT@1013_1506@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um dos seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> e gradualmente melhorar sua {GLOBAL.HouseInfluenceConcept.Hyperlink} com você."

msgid "STORY_EVENT@1013_1506@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} de {EventHouse.Name} cumprimenta você com um sorriso mal contido."

msgid "STORY_EVENT@1013_1506@BODY_LORE"
msgstr "\"Bem encontrado, {PlayerLeader.Name}. Estamos bem cientes da sua [hyperlink,GLOBAL.AlignmentConcept]reputação[/hyperlink]. Seu tipo de governo não é um que se alinha com nossos métodos, digamos, mais rígidos. Esperamos poder coexistir sem necessidade de hostilidades. {EventHouse.Name} ficará fora do seu caminho, se você gentileza ficar fora do nosso.\""

msgid "STORY_EVENT@1013_1506@BUTTON_0"
msgstr "\"Repugnante como {EventHouse.Name} é, talvez possa ser redimido.\""

msgid "STORY_EVENT@1013_1506@BUTTON_2"
msgstr "\"Vamos seguir nossos caminhos separados... por enquanto.\""

msgid "STORY_EVENT@1013_1506@TITLE"
msgstr "Encontrando o Odioso {EventHouse.Name}"

msgid "STORY_EVENT@1013_1507@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um dos seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> e gradualmente melhorar sua {GLOBAL.HouseInfluenceConcept.Hyperlink} com você."

msgid "STORY_EVENT@1013_1507@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} de {EventHouse.Name} cumprimenta você com um desdém contido."

msgid "STORY_EVENT@1013_1507@BODY_LORE"
msgstr "\"Saudações, {PlayerLeader.Name}. Sua [hyperlink,GLOBAL.AlignmentConcept]reputação[/hyperlink] é conhecida longe e wide. Admitimos que seus \"métodos\" variam muito dos nossos, então pedimos que você refreie suas aspirações mais sombrias e respeite a soberania de {EventHouse.Name}.\""

msgid "STORY_EVENT@1013_1507@BUTTON_0"
msgstr "\"Vamos ver se os auto justos {EventHouse.Name} são dignos do meu escrutínio.\""

msgid "STORY_EVENT@1013_1507@BUTTON_2"
msgstr "\"Prossiga ileso... por enquanto.\""

msgid "STORY_EVENT@1013_1507@TITLE"
msgstr "Encontrando os Justos {EventHouse.Name}"

msgid "STORY_EVENT@1013_1508@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um dos seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> e gradualmente melhorar sua {GLOBAL.HouseInfluenceConcept.Hyperlink} com você."

msgid "STORY_EVENT@1013_1508@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} de {EventHouse.Name} cumprimenta você com um sorriso sábio."

msgid "STORY_EVENT@1013_1508@BODY_LORE"
msgstr "\"Saudações, sábio {PlayerLeader.Name}. Os [hyperlink,GLOBAL.AstralFlowsLoreConcept]ventos astrais[/hyperlink] sussurram longe e wide sobre sua presença. Nós também estudamos as artes arcanas, embora não com seu domínio lendário dos mistérios superiores. {EventHouse.Name} está aqui para observar e aprender. Esperamos que você estenda a nós o mesmo nível de neutralidade amigável.\""

msgid "STORY_EVENT@1013_1508@BUTTON_0"
msgstr "\"Vamos ver se as pessoas de {EventHouse.Name} são realmente tão artisticamente talentosas.\""

msgid "STORY_EVENT@1013_1508@BUTTON_2"
msgstr "\"Nós nos separamos como amigos... por enquanto.\""

msgid "STORY_EVENT@1013_1508@TITLE"
msgstr "Encontrando os Eruditos {EventHouse.Name}"

msgid "STORY_EVENT@1013_1512@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um dos seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> e gradualmente melhorar sua {GLOBAL.HouseInfluenceConcept.Hyperlink} com você."

msgid "STORY_EVENT@1013_1512@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} de {EventHouse.Name} cumprimenta você com cautela."

msgid "STORY_EVENT@1013_1512@BODY_LORE"
msgstr "\"Bem encontrado, {PlayerLeader.Name}. Os {EventHouseRace.Name} de {EventHouse.Name} ouviram muito sobre seu poder arcano. Na verdade, muitos de nós acham sua curiosidade um pouco... perturbadora. Esperamos que você honre nossa independência e escolha de permanecer felizmente ignorantes dos caminhos da magia maior.\""

msgid "STORY_EVENT@1013_1512@BUTTON_0"
msgstr "Avalie se os simples moradores de {EventHouse.Name} merecem seu escrutínio."

msgid "STORY_EVENT@1013_1512@BUTTON_2"
msgstr "\"Desfrute de sua ignorância... por enquanto.\""

msgid "STORY_EVENT@1013_1512@TITLE"
msgstr "Encontrando os Céticos {EventHouse.Name}"

msgid "STORY_EVENT@1013_1513@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um dos seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> e gradualmente melhorar sua {GLOBAL.HouseInfluenceConcept.Hyperlink} com você."

msgid "STORY_EVENT@1013_1513@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} de {EventHouse.Name} cumprimenta você com uma expressão sábia e vagamente insuportável."

msgid "STORY_EVENT@1013_1513@BODY_LORE"
msgstr "\"Saudações, {PlayerLeader.Name}. Os {EventHouseRace.Name} de {EventHouse.Name} estendem um desejo esperançoso de neutralidade mútua. Nossos adivinhos previam sua presença nestas terras! Buscamos apenas aprofundar nossa compreensão das artes arcanas e permanecemos abertos a fomentar um relacionamento mutuamente benéfico com seu poderoso império. Se não pudermos, esperamos que pelo menos possamos ficar fora do caminho um do outro.\""

msgid "STORY_EVENT@1013_1513@BUTTON_0"
msgstr "\"Eu me pergunto se {EventHouse.Name} com sua reputação sábia vale meu tempo.\""

msgid "STORY_EVENT@1013_1513@BUTTON_2"
msgstr "\"Esteja em paz... por enquanto.\""

msgid "STORY_EVENT@1013_1513@TITLE"
msgstr "Encontrando os Enigmáticos {EventHouse.Name}"

msgid "STORY_EVENT@1013_1514@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um dos seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> e gradualmente melhorar sua {GLOBAL.HouseInfluenceConcept.Hyperlink} com você."

msgid "STORY_EVENT@1013_1514@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} de {EventHouse.Name} cumprimenta você com olhos brilhantes, um grande sorriso e uma postura orgulhosa."

msgid "STORY_EVENT@1013_1514@BODY_LORE"
msgstr "\"Força e sangue! Glória a você, {PlayerLeader.Name}. Nós, {EventHouseRace.Name} de {EventHouse.Name}, damos-lhe as boas-vindas a estas terras de conflito! Ansiamos para ver sua força no campo de batalha, seja ao nosso lado ou contra você!\""

msgid "STORY_EVENT@1013_1514@BUTTON_0"
msgstr "\"Vamos ver se o orgulhoso {EventHouse.Name} é digno da minha força.\""

msgid "STORY_EVENT@1013_1514@BUTTON_2"
msgstr "\"Siga seu caminho... por enquanto.\""

msgid "STORY_EVENT@1013_1514@TITLE"
msgstr "Encontrando o Feroz {EventHouse.Name}"

msgid "STORY_EVENT@1013_1515@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um dos seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> e melhorar gradualmente sua {GLOBAL.HouseInfluenceConcept.Hyperlink} com você."

msgid "STORY_EVENT@1013_1515@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} de {EventHouse.Name} bate no peito."

msgid "STORY_EVENT@1013_1515@BODY_LORE"
msgstr "\"Sangue e cinzas! Cuidado com seus passos, {PlayerLeader.Name}. Você pode ser um {PlayerLeader.Title}, mas podemos fazer até um {GLOBAL.GodirLoreConcept.Hyperlink} sangrar! Para nós, sangue e morte são companheiros constantes com os quais compartilhamos alegremente uma cerveja! Respeite-nos ou enfrete a ira dos {EventHouseRace.Name}!\""

msgid "STORY_EVENT@1013_1515@BUTTON_0"
msgstr "\"Vamos ver se o povo de {EventHouse.Name} tem razão para ser tão confiante.\""

msgid "STORY_EVENT@1013_1515@BUTTON_2"
msgstr "\"Paz... por enquanto.\""

msgid "STORY_EVENT@1013_1515@TITLE"
msgstr "Encontrando o Audacioso {EventHouse.Name}"

msgid "STORY_EVENT@1013_1516@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um dos seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> e melhorar gradualmente sua {GLOBAL.HouseInfluenceConcept.Hyperlink} com você."

msgid "STORY_EVENT@1013_1516@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} de {EventHouse.Name} cumprimenta você nervosamente, como se pudessem invocar sua ira a qualquer momento."

msgid "STORY_EVENT@1013_1516@BODY_LORE"
msgstr "\"Bem-vindo, {PlayerLeader.Name}. Nós, {EventHouseRace.Name} de {EventHouse.Name}, ouvimos muitas histórias sobre o {GLOBAL.ShadowTrialLoreConcept.Hyperlink} pelo qual você passou e o poder que você possui. Detestamos imaginar o que você sacrificou para conquistá-lo. Esperamos que você refreie quaisquer tendências potencialmente sedentas por poder enquanto avança por estas terras.\""

msgid "STORY_EVENT@1013_1516@BUTTON_0"
msgstr "\"Vamos ver se as pessoas de {EventHouse.Name} são de interesse.\""

msgid "STORY_EVENT@1013_1516@BUTTON_2"
msgstr "\"Até nos encontrarmos novamente, mortal.\""

msgid "STORY_EVENT@1013_1516@TITLE"
msgstr "Encontrando o Apreensivo {EventHouse.Name}"

msgid "STORY_EVENT@1013_1517@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um dos seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> e melhorar gradualmente sua {GLOBAL.HouseInfluenceConcept.Hyperlink} com você."

msgid "STORY_EVENT@1013_1517@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} de {EventHouse.Name} cumprimenta você com uma pequena dose de admiração."

msgid "STORY_EVENT@1013_1517@BODY_LORE"
msgstr "\"Mais valente {PlayerLeader.Name}, {EventHouse.Name} estende uma mão cautelosa em boas-vindas. Apreensão e excitação guiam nossas palavras em igual medida. Raramente encontramos alguém como você, que ascendeu através das fileiras da mortalidade para se tornar um [hyperlink,GLOBAL.AscendedChampLoreConcept]campeão[/hyperlink] do seu povo! Como não podemos deixar de nos perguntar, como você se esforçará para governar estas terras... Para o bem, ou para o mal?\""

msgid "STORY_EVENT@1013_1517@BUTTON_0"
msgstr "\"Vamos ver se as pessoas de {EventHouse.Name} são de interesse.\""

msgid "STORY_EVENT@1013_1517@BUTTON_2"
msgstr "\"Obrigado. É tudo, por enquanto.\""

msgid "STORY_EVENT@1013_1517@TITLE"
msgstr "Encontrando o Curioso {EventHouse.Name}"

msgid "STORY_EVENT@1013_1518@BODY_FOOTER"
msgstr "Dê ao mortal {EventHouseLord} um dos seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> e melhorar gradualmente sua {GLOBAL.HouseInfluenceConcept.Hyperlink} com você."

msgid "STORY_EVENT@1013_1518@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} de {EventHouse.Name} cumprimenta você com alguma curiosidade."

msgid "STORY_EVENT@1013_1518@BODY_LORE"
msgstr "\"Lendário {PlayerLeader.Name}! É raro para {EventHouse.Name} encontrar um [hyperlink,GLOBAL.AscendedChampLoreConcept]como você[/hyperlink]. No entanto, pedimos que você respeite o território e a independência de {EventHouse.Name}.\""

msgid "STORY_EVENT@1013_1518@BUTTON_0"
msgstr "\"Vamos ver se o povo de {EventHouse.Name} é de interesse.\""

msgid "STORY_EVENT@1013_1518@BUTTON_2"
msgstr "\"Obrigado. É tudo, por enquanto.\""

msgid "STORY_EVENT@1013_1518@TITLE"
msgstr "Encontrando o Curioso {EventHouse.Name}"

msgid "STORY_EVENT@1013_1519@BODY_FOOTER"
msgstr "\"Por favor, {PlayerLeader.Title}, compartilhe um pouco da sua sabedoria comigo para que eu possa passá-la para o meu povo!\""

msgid "STORY_EVENT@1013_1519@BODY_HEADER"
msgstr "{EventHouseLord.Name} de {EventHouse.Name} se aproxima de você sobre um assunto de pesquisa e filosofia."

msgid "STORY_EVENT@1013_1519@BODY_LORE"
msgstr "\"Como um {EventHouseLord.Title} dos {EventHouseRace.Name}, é esperado que eu escreva um diário, para ser adicionado à nossa grande biblioteca. Escolhi dedicar o meu às filosofias do maior Godir do reino. Claro que imediatamente pensei no maior {PlayerLeader.Title} do reino—você! Seria uma honra se você compartilhasse suas ideologias comigo.\""

msgid "STORY_EVENT@1013_1519@BUTTON_0"
msgstr "\"Apenas da destruição se pode construir algo novo. [chaosboon/].\""

msgid "STORY_EVENT@1013_1519@BUTTON_1"
msgstr "\"A vida é circular. [natureboon/] Das cinzas crescemos, como outros das nossas.\""

msgid "STORY_EVENT@1013_1519@BUTTON_2"
msgstr "\"Os conceitos são apenas escritos na areia até que sejam materializados. [materiumboon/]\""

msgid "STORY_EVENT@1013_1519@BUTTON_3"
msgstr "\"Apenas os mais justos e legais podem encontrar a salvação. [orderboon/].\""

msgid "STORY_EVENT@1013_1519@BUTTON_4"
msgstr "\"Para ganhar sabedoria, devemos avançar os limites do conhecido [astralboon/].\""

msgid "STORY_EVENT@1013_1519@BUTTON_6"
msgstr "\"Os governantes devem lembrar que a benevolência e a honra superam todas as outras virtudes.\" [goodact/]"

msgid "STORY_EVENT@1013_1519@BUTTON_7"
msgstr "\"Apenas na morte [shadowboon/] o espírito e o corpo podem alcançar seu potencial individual.\""

msgid "STORY_EVENT@1013_1519@BUTTON_8"
msgstr "\"Somos definidos pelas impressões que deixamos [influence/] nos outros.\""

msgid "STORY_EVENT@1013_1519@TITLE"
msgstr "Dentro da Mente"

msgid "STORY_EVENT@1013_1521@BODY_FOOTER"
msgstr "\"Nós nos gabamos de nossas proezas e conquistas,\" {EventHouseLord.TitleName} grita acima do barulho. \"Não quer se juntar a nós?\""

msgid "STORY_EVENT@1013_1521@BODY_HEADER"
msgstr "Para celebrar sua irmandade, {EventHouseLord.Name} de {EventHouse.Name} convidou você para uma competição—uma menos sangrenta do que o tipo usual."

msgid "STORY_EVENT@1013_1521@BODY_LORE"
msgstr "Uma multidão barulhenta se reuniu no grande salão de {EventHouse.Name}. Vários {EventHouseRace.Name} estão em cima de mesas e cadeiras, acenando com canecas enquanto gritam gritos de batalha e batem em móveis de madeira. A multidão aplaude. Um {EventUnit.Name} mostra <<o:EventUnit>> cicatrizes e se gaba em voz alta sobre <<o:EventUnit>> sua última aventura."

msgid "STORY_EVENT@1013_1521@BUTTON_0"
msgstr "Gabe-se sobre seu vasto império [influence/] e seu povo."

msgid "STORY_EVENT@1013_1521@BUTTON_1"
msgstr "Gabe-se sobre o comércio lucrativo em seu império [gold/]."

msgid "STORY_EVENT@1013_1521@BUTTON_3"
msgstr "Gabe-se sobre suas proezas marciais e impressionantes [morale/] exércitos."

msgid "STORY_EVENT@1013_1521@BUTTON_6"
msgstr "\"Eu nunca poderia competir com os grandes fanfarrões de {EventHouse.Name}.\""

msgid "STORY_EVENT@1013_1521@TITLE"
msgstr "Competição de Fanfarrões"

msgid "STORY_EVENT@1013_1526@BODY_FOOTER"
msgstr "\"Diga-me, como um {PlayerLeader.Title}, qual camada da nossa sociedade você acha que merece mais apreciação e apoio?\""

msgid "STORY_EVENT@1013_1526@BODY_HEADER"
msgstr "Seu apoiador, {EventHouseLord.Name} de {EventHouse.Name}, pede sua opinião sobre um assunto de sociedade e civilização."

msgid "STORY_EVENT@1013_1526@BODY_LORE"
msgstr "\"Os {EventHouseRace.Name} de {EventHouse.Name} acreditam em uma estrutura clara da sociedade,\" diz {EventHouseLord.FirstName}. \"Nós, nobres Governantes da terra, fornecemos proteção ao clero que oferece sabedoria, e à plebe que trabalha nos campos. Não podemos comer nossa proeza militar, e a plebe cairá no caos sem nosso governo.\""

msgid "STORY_EVENT@1013_1526@BUTTON_0"
msgstr "\"Eu, é claro. Estou acima de todos.\""

msgid "STORY_EVENT@1013_1526@BUTTON_1"
msgstr "\"Eruditos e sacerdotes [knowledge/] são o núcleo espiritual de nossos domínios.\""

msgid "STORY_EVENT@1013_1526@BUTTON_3"
msgstr "\"Vós, nobres Lordes e Damas [influence/], que carregam o peso da responsabilidade.\""

msgid "STORY_EVENT@1013_1526@BUTTON_6"
msgstr "\"Os camponeses e servos [food/] são a base de toda a sociedade.\""

msgid "STORY_EVENT@1013_1526@TITLE"
msgstr "Uma Questão de Classe"

msgid "STORY_EVENT@1013_1527@BODY_FOOTER"
msgstr "{EventHouseLord.TitleName} oferece a você um objeto forjado pelos ferreiros de {EventCity.Name} como um presente. Qual você escolhe?"

msgid "STORY_EVENT@1013_1527@BODY_HEADER"
msgstr "Para celebrar os laços que você forjou com {EventHouse.Name}, {EventHouseLord.Name} convida você a visitar <<o:EventHouseLord>> artesãos."

msgid "STORY_EVENT@1013_1527@BODY_LORE"
msgstr "<<Cp:EventHouseLord>> leva você a uma rua cheia de clamor de forjas e ferrarias. \"Nós de {EventHouse} acreditamos que um soldado é tão bom quanto a qualidade de seus armamentos, então nos esforçamos para o melhor.\" {EventHouseLord.TitleName} para em uma loja e gesticula para alguns objetos finamente craftados. \"Oferecemos a você um de nossos produtos, {PlayerLeader.Title}, para mostrar nossa apreciação.\""

msgid "STORY_EVENT@1013_1527@BUTTON_0"
msgstr "O protetor {EventItem1.Name} [item/], coberto por runas intricadas."

msgid "STORY_EVENT@1013_1527@BUTTON_1"
msgstr "O impressionante {EventItem3.Name} [item/] que brilha na luz da forja."

msgid "STORY_EVENT@1013_1527@BUTTON_3"
msgstr "O finamente craftado {EventItem2.Name} [item/], um prêmio digno apesar de seu tamanho."

msgid "STORY_EVENT@1013_1527@BUTTON_6"
msgstr "\"Já que você me aprecia tanto, aceito os três objetos [item/].\""

msgid "STORY_EVENT@1013_1527@TITLE"
msgstr "Forjando Amizades"

msgid "STORY_EVENT@1013_1528@BODY_FOOTER"
msgstr "{EventHouseLord.Name} oferece a você um item da estranha mesa de leilão. O que você leva para {EventCity.Name}?"

msgid "STORY_EVENT@1013_1528@BODY_HEADER"
msgstr "Para celebrar seu vínculo, {EventHouseLord.Name} de {EventHouse.Name} convidou você para um leilão."

msgid "STORY_EVENT@1013_1528@BODY_LORE"
msgstr "O grande salão está escuro, exceto por um palco iluminado onde curiosidades sinistras são exibidas. \"Divertido, não é?\" diz {EventHouseLord.TitleName}. \"Recreação para aqueles sobrecarregados com muito poder e ouro. Claro, lordes menos... cultos franzem a testa para a maioria do que é vendido aqui. Mas é exatamente por isso que é tão interessante. Diga-me, {PlayerLeader.Title}, qual desses objetos intriga você?\""

msgid "STORY_EVENT@1013_1528@BUTTON_0"
msgstr "\"O caderno amaldiçoado [knowledge/] do Eremita Congelado, para enriquecer minha biblioteca.\""

msgid "STORY_EVENT@1013_1528@BUTTON_1"
msgstr "\"A cabeça do agricultor [food/] em um pote, para manter meus cidadãos motivados.\" [evilact/]"

msgid "STORY_EVENT@1013_1528@BUTTON_3"
msgstr "\"O Trono de Obsidiana [influence/], para impressionar outros Governantes do reino.\""

msgid "STORY_EVENT@1013_1528@BUTTON_6"
msgstr "\"Este leilão sombrio deve visitar meu império [shadowboon/]. Meu povo vai amar.\""

msgid "STORY_EVENT@1013_1528@BUTTON_7"
msgstr "\"O {EventItem.Name} [item/], para dominar o campo de batalha.\""

msgid "STORY_EVENT@1013_1528@TITLE"
msgstr "Lance Sombrio"

msgid "STORY_EVENT@1013_1529@BODY_FOOTER"
msgstr "Os \"Filhos do {PlayerLeader.Title}\" buscam sua bênção enquanto se reúnem para celebrar seu zelo. O que você diz?"

msgid "STORY_EVENT@1013_1529@BODY_HEADER"
msgstr "Um culto recém-descoberto tornou-se muito popular entre a população geral em sua cidade {EventCity.Name}. Eles pregam em seu nome."

msgid "STORY_EVENT@1013_1529@BODY_LORE"
msgstr "Seguidores deste culto se espalharam pela cidade, em quase todos os setores da cidade. O culto prega uma doutrina de trabalho árduo e abnegação. Todo o movimento torna seus cidadãos muito produtivos. Em vez de acumular riqueza, eles buscam compartilhar sua abundância, por gratidão a você e por causa de sua benevolência."

msgid "STORY_EVENT@1013_1529@BUTTON_0"
msgstr "\"Ergam suas ferramentas, meus {EventRace.Name}, e construam [structureprod/] o futuro do nosso império!\""

msgid "STORY_EVENT@1013_1529@BUTTON_1"
msgstr "\"Honrem seus estudiosos [knowledge/], meus {EventRace.Name}, e escrevam nossa história!\""

msgid "STORY_EVENT@1013_1529@BUTTON_2"
msgstr "\"Deixem o povo prosperar e crescer [food/], meus {EventRace.Name}!\""

msgid "STORY_EVENT@1013_1529@BUTTON_3"
msgstr "\"Antes de ser Godir, eu era como vocês. Eu não devo ser adorado.\" [goodact/]"

msgid "STORY_EVENT@1013_1529@BUTTON_4"
msgstr "\"Eu posso ser Godir, mas não devo ser adorado.\" [goodact/]"

msgid "STORY_EVENT@1013_1529@TITLE"
msgstr "Culto à Personalidade"

msgid "STORY_EVENT@1013_1530@BODY_FOOTER"
msgstr "O Olho de {PlayerLeader.FirstName} governa {EventCity.Name} com mão de ferro. Eles esperam que você guie seu olhar penetrante."

msgid "STORY_EVENT@1013_1530@BODY_HEADER"
msgstr "Um novo culto chamado \"O Olho de {PlayerLeader.FirstName}\" surgiu em sua cidade {EventCity.Name}."

msgid "STORY_EVENT@1013_1530@BODY_LORE"
msgstr "Seguidores deste culto se espalharam pela cidade. Os sacerdotes afirmam que você é onisciente e onipotente, e assim pregam uma doutrina de submissão inquestionável a você. Todo o movimento torna seus cidadãos muito obedientes, seja por reverência ou por medo das punições do culto. Eles são conhecidos por fazer \"hereges\" desaparecerem."

msgid "STORY_EVENT@1013_1530@BUTTON_0"
msgstr "\"Construam templos e estruturas [structureprod/] em meu nome, até que suas costas quebrem.\""

msgid "STORY_EVENT@1013_1530@BUTTON_1"
msgstr "\"Um culto de guerra [unitprod/]! Os mais fortes podem se juntar à minha gloriosa conquista.\""

msgid "STORY_EVENT@1013_1530@BUTTON_2"
msgstr "\"Como seu radiante {PlayerLeader.Title}, entregue todas as suas posses [gold/] a mim.\""

msgid "STORY_EVENT@1013_1530@BUTTON_4"
msgstr "\"Deixe todo o meu império saber [influence/] que seu {PlayerLeader.Title} vê e sabe tudo.\""

msgid "STORY_EVENT@1013_1530@TITLE"
msgstr "O Olho de {PlayerLeader.FirstName}"

msgid "STORY_EVENT@1013_1531@BODY_FOOTER"
msgstr "O mestre da guilda olha para você. \"Qual abordagem você prefere, meu {PlayerLeader.Title}?\""

msgid "STORY_EVENT@1013_1531@BODY_HEADER"
msgstr "Você tratou bem seus cidadãos em {EventCity.Name}. Agora, os cidadãos desejam convidar o povo de {EventHouse.Name} para celebrar."

msgid "STORY_EVENT@1013_1531@BODY_LORE"
msgstr "Um mestre de guilda local ri animadamente. \"Estávamos pensando em organizar um festival coletivo, meu {PlayerLeader.Title}. Parece que os {EventHouseRace.Name} de {EventHouse.Name} amam nosso {RandomFood}, e eles prometeram compartilhar uma de suas iguarias em troca. Estamos planejando performances musicais, um grande mercado, um banquete para todos... Essas festividades serão uma ótima oportunidade para fortalecer nossos laços com sua cidade!\""

msgid "STORY_EVENT@1013_1531@BUTTON_0"
msgstr "\"Um festival compartilhado com {EventCity.Name} ajudará a todos nós.\""

msgid "STORY_EVENT@1013_1531@BUTTON_1"
msgstr "\"Convide {EventHouse.Name} e todos os {EventRace.Name} para celebrar em {EventCity.Name}!\""

msgid "STORY_EVENT@1013_1531@BUTTON_2"
msgstr "\"Festividades para estrangeiros são desnecessárias. Devemos cuidar dos nossos.\" [happiness/]"

msgid "STORY_EVENT@1013_1531@BUTTON_4"
msgstr "\"Esta riqueza deve fluir para a economia [gold/] de {EventCity.Name}!\""

msgid "STORY_EVENT@1013_1531@TITLE"
msgstr "Festival de {RandomFood}"

msgid "STORY_EVENT@1013_1554@BODY_FOOTER"
msgstr "\"Sua bênção santificaria esta celebração, ó {PlayerLeader.Title}. Você compartilharia algumas palavras para nossos irmãos caídos?\""

msgid "STORY_EVENT@1013_1554@BODY_HEADER"
msgstr "Seus cidadãos em {EventCity} organizam uma celebração durante a qual eles aplacam os mortos para que seus entes queridos falecidos possam descansar em paz."

msgid "STORY_EVENT@1013_1554@BODY_LORE"
msgstr "Um magistrado explica: \"Para evitar que os mortos ressuscitem e causem estragos, nossos cidadãos compartilham histórias e felicidade durante festividades ao redor da cripta da cidade. Dessa forma, os falecidos sabem que estamos bem sem eles e podem continuar sua jornada sem precisar voltar para nos assombrar.\""

msgid "STORY_EVENT@1013_1554@BUTTON_0"
msgstr "\"Seu sacrifício permitiu que meu império prosperasse [influence/]. Descanse em paz.\""

msgid "STORY_EVENT@1013_1554@BUTTON_1"
msgstr "\"Enquanto você descansa, outros acordarão [population/] em seu lugar.\""

msgid "STORY_EVENT@1013_1554@BUTTON_2"
msgstr "\"Grandes cidades como {EventCity} são construídas [production/] graças ao seu sacrifício.\""

msgid "STORY_EVENT@1013_1554@BUTTON_4"
msgstr "\"Não tema os mortos que ressuscitam! [shadow/] Veja como [unit/] eles são úteis.\""

msgid "STORY_EVENT@1013_1554@TITLE"
msgstr "Cavalgada de Cadáveres"

msgid "STORY_EVENT@1013_1555@BODY_FOOTER"
msgstr "\"Os efeitos desses chamados Esporos do Sono são temporários, mas podem ajudar {EventCity.Name} a superar estes... tempos desafiadores.\""

msgid "STORY_EVENT@1013_1555@BODY_HEADER"
msgstr "Você negligenciou as necessidades de seus cidadãos em {EventCity.Name}, causando agitação. Um especialista em farmácia propõe uma solução única..."

msgid "STORY_EVENT@1013_1555@BODY_LORE"
msgstr "<<Cp:EventUnit>> se curva e explica com uma voz nasal, \"Toda a minha vida, eu perssegui o estudo de infestações fúngicas mágicas que pontilham este mundo. Eu localizei uma variedade cujos esporos induzem um forte efeito sedativo. Se achar aconselhável, {PlayerLeader.Title}, poderíamos banhar as congregações inquietas de {EventCity.Name} com esses esporos.\""

msgid "STORY_EVENT@1013_1555@BUTTON_0"
msgstr "\"Libere os esporos por toda {EventCity.Name} [mana/] para acalmar sua população.\""

msgid "STORY_EVENT@1013_1555@BUTTON_1"
msgstr "\"Libere os esporos e execute [population/] os perturbadores sedados.\" [evilact/]"

msgid "STORY_EVENT@1013_1555@BUTTON_2"
msgstr "Não libere os esporos sobre seu povo. Bem, ainda não..."

msgid "STORY_EVENT@1013_1555@TITLE"
msgstr "Esporos do Sono"

msgid "STORY_EVENT@1013_1556@BODY_FOOTER"
msgstr "\"Isso não pode continuar, meu {PlayerLeader.Title}. Sua cidade apodrecerá por dentro!\" Como você irá acabar com a corrupção?"

msgid "STORY_EVENT@1013_1556@BODY_HEADER"
msgstr "A corrupção reina em sua cidade de {EventCity.Name}, seu povo governado por guardas corruptos e mestres de guildas fraudulentos. Um cidadão explica a situação para você."

msgid "STORY_EVENT@1013_1556@BODY_LORE"
msgstr "O cidadão se ajoelha diante de você em deferência, mas fala com uma ousadia que aumenta a cada palavra. \"Meu {PlayerLeader.Title}, a corrupção tem se alastrado em {EventCity.Name} por tempo demais. Doença, caos e pobreza reinam nas ruas, enquanto os líderes das guildas compram luxos. Os guardas eles mesmos invadem nossas casas e nos roubam em vez de nos proteger!\""

msgid "STORY_EVENT@1013_1556@BUTTON_0"
msgstr "Elimine a guarda da cidade [unitprod/] para erradicar sua corrupção."

msgid "STORY_EVENT@1013_1556@BUTTON_1"
msgstr "Punir os líderes de guildas fraudulentos [gold/] por seus erros."

msgid "STORY_EVENT@1013_1556@BUTTON_2"
msgstr "\"Eu lidarei com a agitação dentro de {EventCity.Name} mais tarde.\""

msgid "STORY_EVENT@1013_1556@BUTTON_4"
msgstr "Desacelere o crescimento da cidade [food/] até que a corrupção seja expulsa."

msgid "STORY_EVENT@1013_1556@TITLE"
msgstr "Corrupção em {EventCity.Name}"

msgid "STORY_EVENT@1013_1605@BODY_FOOTER"
msgstr "Você permitirá que o patético {EventStackLeader.Name} e outros seres deixem este mundo para trás, ou você atacará?"

msgid "STORY_EVENT@1013_1605@BODY_HEADER"
msgstr "Suas tropas engajam o {EventStackLeader.Name} e outras entidades etéreas, mas em vez de responder, eles simplesmente esperam, parecendo confusos."

msgid "STORY_EVENT@1013_1605@BODY_LORE"
msgstr "Expressões de desespero e tumulto lavam sobre os traços dos seres cintilantes. Em vez de mostrar hostilidade, eles parecem impotentes e perplexos por alguma aflição invisível."

msgid "STORY_EVENT@1013_1605@BUTTON_0"
msgstr "Atacar! [evilact/]"

msgid "STORY_EVENT@1013_1605@BUTTON_1"
msgstr "Conceda-lhes misericórdia. [goodact/]"

msgid "STORY_EVENT@1013_1605@BUTTON_2"
msgstr "Transporte [mana/] eles para o Mar Astral em troca de segredos arcanos. [knowledge/]"

msgid "STORY_EVENT@1013_1605@TITLE"
msgstr "Baixo Astral"

msgid "STORY_EVENT@1013_1611@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um de seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> e melhorar gradualmente sua {GLOBAL.HouseInfluenceConcept.Hyperlink} com você."

msgid "STORY_EVENT@1013_1611@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} de {EventHouse.Name} se aproxima com fanfarra."

msgid "STORY_EVENT@1013_1611@BODY_LORE"
msgstr "\"Nós, o povo de {EventHouse.Name}, saudamos você, ó {PlayerLeader.TitleName}. Você encontrará aqui um lugar de honra, glória e devoção à cavalaria. Esperamos que a paz seja alcançada entre nós por causa dos valores que compartilhamos, ou que nos envolvamos em um combate glorioso sobre o qual os bardos cantarão por eras.\""

msgid "STORY_EVENT@1013_1611@BUTTON_0"
msgstr "Converse com esses entusiastas da honra."

msgid "STORY_EVENT@1013_1611@BUTTON_2"
msgstr "Saia das discussões por enquanto."

msgid "STORY_EVENT@1013_1611@TITLE"
msgstr "Encontrando a Galante {EventHouse.Name}"

msgid "STORY_EVENT@1013_1612@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um de seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> e melhorar gradualmente sua {GLOBAL.HouseInfluenceConcept.Hyperlink} com você."

msgid "STORY_EVENT@1013_1612@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} de {EventHouse.Name} reconhece você com uma elegante reverência."

msgid "STORY_EVENT@1013_1612@BODY_LORE"
msgstr "\"Salve, grande {PlayerLeader.Name}. O povo de {EventHouse.Name} saúda você e deseja-lhe bem. Esperamos apresentar-lhe nossas artes e cultura para que você possa experimentar nossa opulência.\""

msgid "STORY_EVENT@1013_1612@BUTTON_0"
msgstr "Descubra mais sobre esses seres etéreos."

msgid "STORY_EVENT@1013_1612@BUTTON_2"
msgstr "Deixe-os com suas artes e ofícios."

msgid "STORY_EVENT@1013_1612@TITLE"
msgstr "Encontrando a Suntuosa {EventHouse.Name}"

msgid "STORY_EVENT@1013_1613@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um de seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> e melhorar gradualmente sua {GLOBAL.HouseInfluenceConcept.Hyperlink} com você."

msgid "STORY_EVENT@1013_1613@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} de {EventHouse.Name} cumprimenta você com um sorriso nefário."

msgid "STORY_EVENT@1013_1613@BODY_LORE"
msgstr "\"Saudações, grande e poderoso {PlayerLeader.Name}. Por favor, desconsidere o cheiro de morte que você pode ter notado antes de nossas discussões. Isso faz parte de nossos caminhos sombrios, não um presságio do que está por vir, agora que o povo de {EventHouse.Name} fez sua aquisição... a menos que sejamos provocados.\""

msgid "STORY_EVENT@1013_1613@BUTTON_0"
msgstr "Veja se você pode encontrar um terreno comum... ou colocá-los no chão."

msgid "STORY_EVENT@1013_1613@BUTTON_2"
msgstr "Retire-se por enquanto."

msgid "STORY_EVENT@1013_1613@TITLE"
msgstr "Encontrando a Arrepiante {EventHouse.Name}"

msgid "STORY_EVENT@1013_1629@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um de seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> e melhorar gradualmente sua {GLOBAL.HouseInfluenceConcept.Hyperlink} com você."

msgid "STORY_EVENT@1013_1629@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} cumprimenta você com um sorriso nefário."

msgid "STORY_EVENT@1013_1629@BODY_LORE"
msgstr "\"Saudações, {PlayerLeader.Name}. É um prazer conhecer um {PlayerLeader.Title} de nossa... persuasão. Embora entendamos o desejo de controlar e até subjugar aqueles abaixo de nós, pedimos que você nos permita, {EventHouse.Name}, permanecer independentes de seu alcance assassino.\""

msgid "STORY_EVENT@1013_1629@BUTTON_0"
msgstr "Investigue seu companheiro devoto da escuridão."

msgid "STORY_EVENT@1013_1629@BUTTON_2"
msgstr "Recuar de sua presença maligna por enquanto..."

msgid "STORY_EVENT@1013_1629@TITLE"
msgstr "Encontrando a Mortal {EventHouse.Name}"

msgid "STORY_EVENT@1013_1630@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um de seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> e gradualmente melhorar sua {GLOBAL.HouseInfluenceConcept.Hyperlink} com você."

msgid "STORY_EVENT@1013_1630@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} o cumprimenta com um olhar de medo."

msgid "STORY_EVENT@1013_1630@BODY_LORE"
msgstr "\"{PlayerLeader.TitleName}... devemos admitir que sua presença nos enche de pavor, mas reconhecemos sua magnificência. Não estamos acostumados a ser cercados por tanta morte. Esperamos que haja um caminho à frente no qual possamos conhecê-lo, enquanto ainda permanecemos na terra dos vivos.\""

msgid "STORY_EVENT@1013_1630@BUTTON_0"
msgstr "Iniciar uma discussão com essas almas vivas."

msgid "STORY_EVENT@1013_1630@BUTTON_2"
msgstr "Permitir que eles continuem vivendo... por enquanto..."

msgid "STORY_EVENT@1013_1630@TITLE"
msgstr "Encontrando a Cautelosa {EventHouse.Name}"

msgid "STORY_EVENT@1013_1631@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um de seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> e gradualmente melhorar sua {GLOBAL.HouseInfluenceConcept.Hyperlink} com você."

msgid "STORY_EVENT@1013_1631@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} de {EventHouse.Name} o cumprimenta com um sorriso amigável."

msgid "STORY_EVENT@1013_1631@BODY_LORE"
msgstr "\"Bem-vindo e muitas saudações, {PlayerLeader.TitleName}! Parece que temos muito em comum e ansiamos por um relacionamento forte entre {EventHouse.Name} e você. Juntos, poderíamos realizar grandes e honrosas ações.\""

msgid "STORY_EVENT@1013_1631@BUTTON_0"
msgstr "Discutir um caminho à frente com seus companheiros cavaleiros honrados."

msgid "STORY_EVENT@1013_1631@BUTTON_2"
msgstr "Retirar-se dessas negociações, com a possibilidade de retornar mais tarde."

msgid "STORY_EVENT@1013_1631@TITLE"
msgstr "Encontrando a Amigável {EventHouse.Name}"

msgid "STORY_EVENT@1013_1632@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um de seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> e gradualmente melhorar sua {GLOBAL.HouseInfluenceConcept.Hyperlink} com você."

msgid "STORY_EVENT@1013_1632@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} de {EventHouse.Name} o cumprimenta com um olhar intrigado."

msgid "STORY_EVENT@1013_1632@BODY_LORE"
msgstr "\"Bem encontrado, oh valente {PlayerLeader.TitleName}. Embora nossos caminhos sejam diferentes dos seus, sua busca por glória nos intriga. Esperamos que possamos viver em paz aqui em {EventHouse.Name} em vez de enfrentar seus exércitos.\""

msgid "STORY_EVENT@1013_1632@BUTTON_0"
msgstr "Descobrir mais sobre essa sociedade diferente."

msgid "STORY_EVENT@1013_1632@BUTTON_2"
msgstr "Deixá-los em seus caminhos por enquanto..."

msgid "STORY_EVENT@1013_1632@TITLE"
msgstr "Encontrando a Inquisitiva {EventHouse.Name}"

msgid "STORY_EVENT@1013_1633@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um de seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> e gradualmente melhorar sua {GLOBAL.HouseInfluenceConcept.Hyperlink} com você."

msgid "STORY_EVENT@1013_1633@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} de {EventHouse.Name} o aborda com uma formalidade profissional."

msgid "STORY_EVENT@1013_1633@BODY_LORE"
msgstr "\"Ah! Um novo potencial parceiro de negócios! É fantástico conhecê-lo, {PlayerLeader.Name}. Sei que se cooperarmos, {EventHouse.Name} pode ajudá-lo a construir grandes coisas... ou destruí-las.\""

msgid "STORY_EVENT@1013_1633@BUTTON_0"
msgstr "Aprender mais sobre esses indivíduos empreendedores."

msgid "STORY_EVENT@1013_1633@BUTTON_2"
msgstr "Escolher não se envolver no momento."

msgid "STORY_EVENT@1013_1633@TITLE"
msgstr "Encontrando {EventHouse.Name} Produtiva"

msgid "STORY_EVENT@1013_1670@BODY_FOOTER"
msgstr "{EventCity.Name} está ameaçada por um grupo de criaturas do [hyperlink,GLOBAL.AstralSeaLoreConcept]Mar Astral[/hyperlink], movidas por uma fome de outro mundo!"

msgid "STORY_EVENT@1013_1670@BODY_HEADER"
msgstr "Um {EventSpawner} surgiu perto de {EventCity.Name}, sua cidade. Criaturas emergem dele, lideradas por um temível {EventStackLeader.Name}."

msgid "STORY_EVENT@1013_1670@BODY_LORE"
msgstr "Originárias das profundezas do [hyperlink,GLOBAL.AstralSeaLoreConcept]Mar Astral[/hyperlink], essas criaturas são movidas por uma fome não por carne, mas pelo arcano. Esse desejo agora as leva em direção a {EventCity.Name}. Seus cidadãos estão aterrorizados, implorando para que você os proteja desses [hyperlink,GLOBAL.AstralMonstersLoreConcept]monstros[/hyperlink] que superam sua capacidade de compreensão."

msgid "STORY_EVENT@1013_1670@BUTTON_0"
msgstr "Sacrifique um pouco da sua magia [mana/] para saciar seus desejos."

msgid "STORY_EVENT@1013_1670@BUTTON_1"
msgstr "Alimente-os com [mana/] suficiente para colocar todo o {EventSpawner.Name} em repouso."

msgid "STORY_EVENT@1013_1670@BUTTON_2"
msgstr "Use seu vínculo com o Mar Astral para trazer essas criaturas e o {EventSpawner.Name} ao repouso."

msgid "STORY_EVENT@1013_1670@BUTTON_3"
msgstr "Essas criaturas não são páreo para <<g:defenses^p,EventCity>>. Que venham."

msgid "STORY_EVENT@1013_1670@TITLE"
msgstr "Monstros Além da Compreensão"

msgid "STORY_EVENT@1013_1671@BODY_FOOTER"
msgstr "O temível {EventStackLeader.Name} emergiu do {EventSpawner.Name}, <<o:EventStackLeader>> olhar ávido fixo em {EventCity.Name}."

msgid "STORY_EVENT@1013_1671@BODY_HEADER"
msgstr "Seus cidadãos em {EventCity.Name} estão aterrorizados com um {EventStackLeader.Name} que surgiu do {EventSpawner.Name} nas proximidades e agora ameaça seu domínio."

msgid "STORY_EVENT@1013_1671@BODY_LORE"
msgstr "Essa criatura já foi um orgulhoso mago, viajando pelo [hyperlink,GLOBAL.AstralSeaLoreConcept]Mar Astral[/hyperlink] para descobrir seus segredos e tesouros. Em vez de encontrar tesouros, no entanto, o {EventStackLeader.Name} encontrou <<o:EventStackLeader>> seu fim, sucumbindo à natureza distorcida do mar entre os mundos. Isso transformou <<P:EventStackLeader>> em uma [hyperlink,GLOBAL.LostWizardLoreConcept]monstruosidade[/hyperlink]—um ser que só deseja mais poder e sobrevive apenas com o conhecimento que <<p:EventStackLeader>> possuía antes."

msgid "STORY_EVENT@1013_1671@BUTTON_0"
msgstr "Invoque o [mana/] arcano para banir o {EventStackLeader.Name} de suas terras."

msgid "STORY_EVENT@1013_1671@BUTTON_1"
msgstr "Reúna todo o conhecimento [knowledge/] do seu império para banir o {EventStackLeader.Name} e colocar o {EventSpawner.Name} em repouso."

msgid "STORY_EVENT@1013_1671@BUTTON_2"
msgstr "Use seu vínculo com o Mar Astral para banir essa criatura e colocar o {EventSpawner.Name} em repouso."

msgid "STORY_EVENT@1013_1671@BUTTON_3"
msgstr "Esse mago já caiu antes e <<p:EventStackLeader>> fará isso novamente se <<p:EventStackLeader>> ousar se opor a mim."

msgid "STORY_EVENT@1013_1671@TITLE"
msgstr "Terror do Perdido"

msgid "STORY_EVENT@1013_1673@BODY_FOOTER"
msgstr "\"Você aceita os termos da minha rendição?\""

msgid "STORY_EVENT@1013_1673@BODY_HEADER"
msgstr "\"Paz, {PlayerLeader.TitleName},\" {EventStackLeader.Name} clama antes que suas tropas se aproximem."

msgid "STORY_EVENT@1013_1673@BODY_LORE"
msgstr "\"Sua proeza é conhecida por mim. Não vejo vitória aqui. Conceda misericórdia ao meu exército, permita que eles deixem o campo ilesos, e eu me renderei ao seu julgamento.\" {EventStackLeader.Name} parece tanto genuíno quanto contrito em <<o:EventStackLeader>> súplica por misericórdia."

msgid "STORY_EVENT@1013_1673@BUTTON_0"
msgstr "\"Não, vocês todos morrem!\" [evilact/]"

msgid "STORY_EVENT@1013_1673@BUTTON_1"
msgstr "\"Não, concedo misericórdia a todos vocês. Leve suas tropas e vá.\" [goodact/]"

msgid "STORY_EVENT@1013_1673@BUTTON_2"
msgstr "\"Vocês todos vivem, mas {EventStackLeader.FirstName} jura lealdade a mim.\" [unit/]"

msgid "STORY_EVENT@1013_1673@BUTTON_3"
msgstr "\"Vocês todos vivem, mas {EventStackLeader.FirstName} será meu prisioneiro.\""

msgid "STORY_EVENT@1013_1673@TITLE"
msgstr "Uma Proposta Heroica"

msgid "STORY_EVENT@1013_167@BODY_FOOTER"
msgstr "\"Humildemente, pedimos que você deixe o(a) {EventGeo} perto de {EventCity} para {EventHouse.Name}.\""

msgid "STORY_EVENT@1013_167@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} de {EventHouse.Name} se aproxima de você para resolver uma disputa territorial."

msgid "STORY_EVENT@1013_167@BODY_LORE"
msgstr "\"Nós de {EventCity.Name} estamos impressionados com a expansão do seu {PlayerRace.Name}, {PlayerLeader.TitleName}. Embora agora pareça que temos um mal-entendido considerando uma de suas possíveis reivindicações territoriais.\" <<Cp:EventHouseLord>> limpa <<o:EventHouseLord>> a garganta. \"Minha cidade, {EventHouse.Name}, está se expandindo rapidamente. Precisamos de mais espaço para nosso povo. A área em questão foi reivindicada por nós por esse motivo.\""

msgid "STORY_EVENT@1013_167@BODY_LORE@RACE_IS_PLAYERRA"
msgstr "\"Nós de {EventCity.Name} estamos impressionados com seu governo sobre nossos irmãos {PlayerRace.Name}, {PlayerLeader.TitleName}. Embora agora pareça que temos um mal-entendido considerando uma de suas possíveis reivindicações territoriais.\" <<Cp:EventHouseLord>> limpa <<o:EventHouseLord>> a garganta. \"Minha cidade, {EventHouse.Name}, está se expandindo rapidamente. Precisamos de mais espaço para nosso povo. A área em questão foi reivindicada por nós por esse motivo.\""

msgid "STORY_EVENT@1013_167@BUTTON_0"
msgstr "\"Muito bem. <<EventGeo{That/Those}>> {EventGeo} será seu.\""

msgid "STORY_EVENT@1013_167@BUTTON_1"
msgstr "\"Obrigado por divulgar qual área devo reivindicar para meu império.\" [evilact/]"

msgid "STORY_EVENT@1013_167@TITLE"
msgstr "Choque de Reivindicações"

msgid "STORY_EVENT@1013_1687@BODY_FOOTER"
msgstr "<<G:eyes^n,EventHouseLord>> encontram os seus em antecipação sinistra. \"O destino deste prisioneiro é seu para decidir, ó {PlayerLeader.Title}.\""

msgid "STORY_EVENT@1013_1687@BODY_HEADER"
msgstr "Antes que as negociações com {EventHouse} sejam retomadas, {EventHouseLord} cumprimenta você. <<Cp:EventHouseLord>> está ladeado por dois guardas segurando um homem desnutrido em correntes."

msgid "STORY_EVENT@1013_1687@BODY_LORE"
msgstr "{EventHouseLord.Name} mostra <<o:EventHouseLord>> os dentes com um sorriso perturbador. \"Para honrar seu poder, ofereço este presente para nosso entretenimento mútuo! Pegamos este malfeitor invadindo minha floresta privada.\" O prisioneiro zombeteia e prepara-se para objetar, mas um rápido soco no estômago de {EventHouseLord.Title} o deixa sem fôlego. O fogo em seus olhos, no entanto, permanece."

msgid "STORY_EVENT@1013_1687@BUTTON_0"
msgstr "\"Que loucura te assola? Liberte [goodact/] este homem!\""

msgid "STORY_EVENT@1013_1687@BUTTON_1"
msgstr "\"Eu preferiria que continuássemos nossas negociações.\""

msgid "STORY_EVENT@1013_1687@BUTTON_2"
msgstr "\"Sacrifique [evilact/] ele em nome de Urrath!\""

msgid "STORY_EVENT@1013_1687@BUTTON_3"
msgstr "\"Este resultado é tão previsível. O verdadeiro entretenimento vem do caos.\""

msgid "STORY_EVENT@1013_1687@BUTTON_4"
msgstr "\"Uma ótima adição para meu exército dos condenados! [evilact/]\""

msgid "STORY_EVENT@1013_1687@BUTTON_5"
msgstr "\"Saudações, infeliz intruso. Você decide qual pé permanece preso. [evilact/]\""

msgid "STORY_EVENT@1013_1687@TITLE"
msgstr "Entretenimento Sinistro"

msgid "STORY_EVENT@1013_168@BODY_FOOTER"
msgstr "\"Por favor, ó {PlayerLeader.Title}, você compartilharia um pouco de sua prosperidade com minha cidade faminta?\""

msgid "STORY_EVENT@1013_168@BODY_HEADER"
msgstr "O bondoso {EventHouseLord.TitleName} de {EventHouse.Name} aparece diante de você com um rosto emaciado."

msgid "STORY_EVENT@1013_168@BODY_LORE"
msgstr "\"Nobre {PlayerLeader.TitleName}, uma era sombria caiu sobre {EventHouse.Name}. Meu povo está faminto; as colheitas falharam e nossos armazéns estão vazios. Mães não podem alimentar seus filhos, minha guarda da cidade está amotinada... Temo que muitos dos meus cidadãos orgulhosos passarão fome antes que este tempo triste acabe.\""

msgid "STORY_EVENT@1013_168@BUTTON_0"
msgstr "\"{EventCity.Name} ajudará você com [food/] durante esta fome.\" [goodact/]"

msgid "STORY_EVENT@1013_168@BUTTON_1"
msgstr "\"{EventCity.Name} ajudará você com [food/]... por um preço.\" [gold/]"

msgid "STORY_EVENT@1013_168@BUTTON_2"
msgstr "\"Não tenho nada para compartilhar com {EventHouse.Name}. [relationLvl-3/] Encontre outra solução.\""

msgid "STORY_EVENT@1013_168@BUTTON_3"
msgstr "\"Se seu povo está passando fome, eles estariam melhor sob meus cuidados.\""

msgid "STORY_EVENT@1013_168@TITLE"
msgstr "{EventHouse.Name} em Perigo"

msgid "STORY_EVENT@1013_1692@BODY_FOOTER"
msgstr "\"Com sua permissão, meu {PlayerLeader.Title}, partiremos para encontrar essas pessoas e seus Governantes.\""

msgid "STORY_EVENT@1013_1692@BODY_HEADER"
msgstr "Seu <<m:EventUnit>> relata avistamentos interessantes além do horizonte."

msgid "STORY_EVENT@1013_1692@BODY_LORE"
msgstr "Um deles se aproxima de você. \"Meu {PlayerLeader.Title}, vimos navios de origem desconhecida no horizonte oeste e passagens subterrâneas pisoteadas no leste. Parece que algumas das <<G:creations^m,EventNimue>> sobreviveram à sua fúria. Talvez elas possam até ser convencidas a se juntar a você em sua busca para libertar o reino.\""

msgid "STORY_EVENT@1013_1692@BUTTON_0"
msgstr "\"Encontrarei essas criações abandonadas.\""

msgid "STORY_EVENT@1013_1692@TITLE"
msgstr "Criações Abandonadas"

msgid "STORY_EVENT@1013_1698@BODY_FOOTER"
msgstr "A {EventNimue.Title} mantém este reino em um abraço afogante, mas a resistência se espalha lentamente. Talvez outros possam ser convencidos a se juntar à sua causa."

msgid "STORY_EVENT@1013_1698@BODY_HEADER"
msgstr "Você conheceu os outros Governantes deste reino, tanto <<G:stranded creations^m,EventNimue>>. Falas sobre sua chegada se espalham pelo reino."

msgid "STORY_EVENT@1013_1698@BODY_LORE"
msgstr "Exilados de todos os tipos afluem para sua {GLOBAL.ThroneCityConcept}, chamando-o de seu salvador. Todos compartilham a mesma história: seu povo já foi favorecido por {EventNimue.FirstName}, mas depois foi abandonado quando ela ficou decepcionada com eles. Desencantados com sua deusa, eles afluem a você em busca de libertação."

msgid "STORY_EVENT@1013_1698@BUTTON_0"
msgstr "Permita que essas pessoas exiladas vivam em suas cidades. [population/]"

msgid "STORY_EVENT@1013_1698@BUTTON_1"
msgstr "Dispense esses exilados. Você é o libertador deles, não o cuidador. [influence/]"

msgid "STORY_EVENT@1013_1698@TITLE"
msgstr "Criações Abandonadas: Consequências"

msgid "STORY_EVENT@1013_169@BODY_FOOTER"
msgstr "{EventHouse.Name} é impopular em todo o reino, com rumores de que se deleita com \"delícias\" repulsivas. No entanto, {EventHouseLord.TitleName} pede que você endosse o banquete deles."

msgid "STORY_EVENT@1013_169@BODY_HEADER"
msgstr "Seu amigo, {EventHouseLord.TitleName} de {EventHouse.Name}, está hospedando um banquete e aparece diante de você, desanimado."

msgid "STORY_EVENT@1013_169@BODY_LORE"
msgstr "\"Tenho um favor a pedir, ó {PlayerLeader.Title}\", diz <<p:EventHouseLord>>, antes de <<p:EventHouseLord>> tomar uma respiração profunda. \"Vou hospedar um banquete em breve, para todos os nobres deste reino. Já paguei por tudo — bardos, bebidas e assim por diante, mas até agora parece que ninguém virá. Se um {PlayerLeader.Title} como você endossasse, no entanto...\""

msgid "STORY_EVENT@1013_169@BUTTON_0"
msgstr "\"Muito bem. Eu vou endossar você.\" [influence/]"

msgid "STORY_EVENT@1013_169@BUTTON_1"
msgstr "\"Você disgusta seus convidados. Por que minha reputação deveria sofrer ao lado da sua?\""

msgid "STORY_EVENT@1013_169@BUTTON_2"
msgstr "\"Uma oferta adequada [gold/] me persuadiria a defender você.\" [influence/]"

msgid "STORY_EVENT@1013_169@TITLE"
msgstr "Festa {EventHouse.Name}"

msgid "STORY_EVENT@1013_1705@BODY_FOOTER"
msgstr "{EventPlayerLeader.FirstName} não é tão facilmente convencido, mas você plantou as sementes da dúvida na fé de <<o:EventPlayerLeader>>."

msgid "STORY_EVENT@1013_1705@BODY_FOOTER@WAR_WITH_LOYALIS"
msgstr "{EventPlayerLeader.FirstName} não é tão facilmente convencido, mas você instigou uma paz e plantou as sementes da dúvida na fé de <<o:EventPlayerLeader>>."

msgid "STORY_EVENT@1013_1705@BODY_HEADER"
msgstr "Através de negociações com o {EventHouseLord.Title} de {EventHouse}, você persuadiu {EventPlayerLeader} a considerar que seus objetivos de parar {EventNimue.FirstName} podem ser justificados."

msgid "STORY_EVENT@1013_1705@BODY_LORE"
msgstr "{EventPlayerLeader.FirstName} parece angustiado. \"{EventHouseLord.TitleName} me diz que você é razoável, mas suas palavras, elas não podem ser verdadeiras. {EventNimue.FirstName}, ela está na minha cabeça — sussurrando ainda... Será que ela realmente afogou todas aquelas pessoas? As histórias são verdadeiras? Não podem ser...\" <<Cp:EventPlayerLeader>> estremece mais uma vez. \"Preciso de tempo para pensar. Agradeço, {PlayerLeader.TitleName}, por seus esforços.\""

msgid "STORY_EVENT@1013_1705@BODY_LORE@WAR_WITH_LOYALIS"
msgstr "{EventPlayerLeader.FirstName} parece angustiado. \"{EventHouseLord.TitleName} me diz que você é razoável, mas suas palavras, elas não podem ser verdadeiras. {EventNimue.FirstName}, ela está na minha cabeça — sussurrando ainda... Será que ela realmente afogou todas aquelas pessoas? Isso não pode ser... Já estou em guerra contra você!\" <<Cp:EventPlayerLeader>> estremece mais uma vez. \"Preciso de tempo para pensar. Não posso mais lutar contra você. Não com as questões que tenho.\""

msgid "STORY_EVENT@1013_1705@BUTTON_0"
msgstr "\"Desejo apenas liberdade para todos que residem neste reino.\" [goodact/]"

msgid "STORY_EVENT@1013_1705@BUTTON_1"
msgstr "Use a confusão dos {EventRace} para atrair alguns deles para sua causa. [evilact/]"

msgid "STORY_EVENT@1013_1705@TITLE"
msgstr "Voz da Razão: Consequências"

msgid "STORY_EVENT@1013_1709@BODY_FOOTER"
msgstr "\"Deixe este reino, intruso! Ou sentirá a ira de nossa amada {EventNimue.Title}!\""

msgid "STORY_EVENT@1013_1709@BODY_HEADER"
msgstr "Você encontra um grupo de rastreadores que estavam perseguindo um grupo de {EventPlayerRace}. Eles olham para você com ódio febril nos olhos."

msgid "STORY_EVENT@1013_1709@BODY_LORE"
msgstr "Está claro que eles foram alterados por magia poderosa. Estas são criações de {EventNimue.FirstName}, fazendo seu trabalho sujo.[br/]\"Intrusos,\" o {EventStackLeader} grita. \"Você está aqui para impedir a {EventNimue.Title} de criar seus filhos amados? Nunca deixaremos! Carregamos o glorioso fardo de limpar os imperfeitos deste reino. Provaremos que somos dignos de seu amor!\""

msgid "STORY_EVENT@1013_1709@BUTTON_0"
msgstr "\"Sua caçada acabou. Rendam-se ou morram!\""

msgid "STORY_EVENT@1013_1709@BUTTON_1"
msgstr "Deixe esses caçadores em sua tarefa."

msgid "STORY_EVENT@1013_1709@BUTTON_2"
msgstr "Quebre o encantamento [mana/] de Nimue nesses escravos, deixando-os perceber o que fizeram."

msgid "STORY_EVENT@1013_1709@TITLE"
msgstr "Caçadores dos {EventPlayerRace.Name}"

msgid "STORY_EVENT@1013_170@BODY_FOOTER"
msgstr "{EventHouseLord.TitleName} solicita que você considere a paz entre você e {EventHouse.Name}."

msgid "STORY_EVENT@1013_170@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} de {EventHouse.Name} lamenta sua guerra contínua."

msgid "STORY_EVENT@1013_170@BODY_LORE"
msgstr "\"<<p:EventHouseLord>> diz, \"{PlayerLeader.Name}, eu vi a loucura da nossa guerra. Por favor, ó {PlayerLeader.Title}, você consideraria um cessar-fogo? Já não foi derramado sangue suficiente por este reino?\""

msgid "STORY_EVENT@1013_170@BUTTON_0"
msgstr "\"Você pode estar certo. Vamos acabar com o derramamento de sangue.\""

msgid "STORY_EVENT@1013_170@BUTTON_1"
msgstr "\"Esta guerra só começou, {EventHouseLord.FirstName}.\""

msgid "STORY_EVENT@1013_170@TITLE"
msgstr "Pedido de Paz"

msgid "STORY_EVENT@1013_1716@BODY_FOOTER"
msgstr "O Pacto insiste que você visite a cidade nativa de [minorcity/][hyperlink,GLOBAL.IndependentCityConcept]Edendam[/hyperlink], que deve estar perto de você. Seu povo pode ser de ajuda para sua investigação."

msgid "STORY_EVENT@1013_1716@BODY_HEADER"
msgstr "A voz de um {GLOBAL.GodirLoreConcept.Hyperlink} desconhecido alcança você de além do {GLOBAL.AstralSeaLoreConcept.Hyperlink}. \"{PlayerLeader.TitleName}. Os Godir do {GLOBAL.CovenantFactionLoreConcept.Hyperlink} esperam que você tenha chegado em segurança.\""

msgid "STORY_EVENT@1013_1716@BODY_LORE"
msgstr "\"Meu nome é {CovenantRuler.Name}. Eu era um dos Godir que ouviu a canção do ser chamado {GLOBAL.ElyaLoreConcept.Hyperlink}. Fico feliz que você se voluntariou para investigar. Nós do Pacto devemos agir em qualquer pedido de ajuda, mas primeiro devemos verificar essas alegações contra {EventNimue.FirstName}.\""

msgid "STORY_EVENT@1013_1716@BUTTON_0"
msgstr "\"Muito bem, farei como o Pacto sugere.\""

msgid "STORY_EVENT@1013_1716@TITLE"
msgstr "Chamado do Pacto"

msgid "STORY_EVENT@1013_1717@BODY_FOOTER"
msgstr "\"O destino deste reino está em suas mãos. Por isso, o Pacto decidiu emprestar seu conhecimento. Peça, {PlayerLeader.TitleName}, e você receberá.\""

msgid "STORY_EVENT@1013_1717@BODY_HEADER"
msgstr "Após relatar o estado da cidade submersa que você encontrou, o {GLOBAL.CovenantFactionLoreConcept.Hyperlink} envia uma resposta."

msgid "STORY_EVENT@1013_1717@BODY_LORE"
msgstr "\"Ficamos profundamente entristecidos ao ouvir sobre o destino da cidade que pedimos para você visitar. Parece que as palavras de {GLOBAL.ElyaLoreConcept.Hyperlink} são verdadeiras, e que a Feiticeira da Água {EventNimue.FirstName} afogou essas pessoas. Isso é pior do que pensávamos. Insistimos que você se aproxime de {EventNimue} com a máxima cautela.\""

msgid "STORY_EVENT@1013_1717@BUTTON_0"
msgstr "\"Conceda-me o conhecimento para navegar pelos mares, para que eu possa atravessar este reino de ilhas.\""

msgid "STORY_EVENT@1013_1717@BUTTON_1"
msgstr "\"Conceda-me o conhecimento de Navegação Especializada, para que eu possa atravessar este reino em velocidades sem precedentes.\""

msgid "STORY_EVENT@1013_1717@BUTTON_2"
msgstr "\"Conceda-me o conhecimento de Navegação Especializada, para que eu possa atravessar este reino em velocidades inesperadas.\""

msgid "STORY_EVENT@1013_1717@BUTTON_3"
msgstr "\"Minha raça {EventRace.Name} e eu não precisamos de ajuda de nenhum outro Godir.\" [influence/]"

msgid "STORY_EVENT@1013_1717@TITLE"
msgstr "Chamado do Pacto: Consequências"

msgid "STORY_EVENT@1013_1719@BODY_FOOTER"
msgstr "\"Se {GLOBAL.GodirLoreConcept.Hyperlink} verdadeiramente bons existem, por favor, nos livrem de sua fúria.\""

msgid "STORY_EVENT@1013_1719@BODY_HEADER"
msgstr "Um governante de um povo desconhecido lentamente sai do esconderijo, dirigindo-se a você com coragem reunida. \"Você.. não é {EventNimue}.\""

msgid "STORY_EVENT@1013_1719@BODY_LORE"
msgstr "\"Sou {EventPlayerLeader.Name}, Governante dos {EventPlayerRace.Name}. Antes, éramos os favoritos da deusa, até que ela ficou... decepcionada conosco. Ela afogou tantos de nós quando fugimos de sua fúria. Sobrevivemos ficando escondidos, mas seu poder cresce com cada criatura que ela constrói e afoga. Por favor, você deve impedi-la, antes que ela nos encontre.\""

msgid "STORY_EVENT@1013_1719@BUTTON_0"
msgstr "\"Diga-me o que posso fazer para ajudar.\""

msgid "STORY_EVENT@1013_1719@BUTTON_1"
msgstr "\"Apenas fique fora do meu caminho.\""

msgid "STORY_EVENT@1013_1719@TITLE"
msgstr "Encontrando {EventPlayerLeader.Name}"

msgid "STORY_EVENT@1013_1720@BODY_FOOTER"
msgstr "{EventPlayerLeader.FirstName} soa desesperado. \"A {EventNimue.Title} nos amará novamente!\""

msgid "STORY_EVENT@1013_1720@BODY_HEADER"
msgstr "Você encontra {EventPlayerLeader.Name} dos {EventPlayerRace.Name}. <<Cp:EventPlayerLeader>> olha para você e enche <<o:EventPlayerLeader>> peito."

msgid "STORY_EVENT@1013_1720@BODY_LORE"
msgstr "\"Meu nome foi dado a mim pela própria {EventNimue.Title}! Como filhos abençoados de {EventNimue.FirstName}, nosso único objetivo é agradá-la. Infelizmente, ela nos considerou—imperfeitos. Sem sua orientação, assumimos a tarefa de patrulhar e proteger o reino. Eu sei que ela nos amará novamente se provarmos ser dignos.\""

msgid "STORY_EVENT@1013_1720@BUTTON_0"
msgstr "\"Há algo que eu possa fazer para convencê-lo da verdadeira natureza de sua deusa?\""

msgid "STORY_EVENT@1013_1720@BUTTON_1"
msgstr "\"Apenas fique fora do meu caminho.\""

msgid "STORY_EVENT@1013_1720@TITLE"
msgstr "Encontrando {EventPlayerLeader.Name}"

msgid "STORY_EVENT@1013_1734@BODY_FOOTER"
msgstr "{EventPlayerLeader.FirstName} suspira e acena. \"Lidera-nos para nossa liberdade, {PlayerLeader.TitleName}.\""

msgid "STORY_EVENT@1013_1734@BODY_HEADER"
msgstr "Você formou uma aliança com {EventPlayerLeader.TitleName} dos {EventPlayerRace}. Uma voz estridente ecoa do sul do reino."

msgid "STORY_EVENT@1013_1734@BODY_LORE"
msgstr "\"{EventPlayerLeader.FirstName}! Você OUSA fazer alianças com invasores?!\" A voz de {EventNimue.FirstName} grita. \"Eu deveria ter afogado vocês, fracotes, quando tive a chance! Da próxima vez, serei mais minuciosa!\" [br/]{EventPlayerLeader.TitleName} estremece sob o ataque verbal, mas então <<p:EventPlayerLeader>> endireita <<o:EventPlayerLeader>> costas. \"Nós não somos fracos. Não fugiremos mais de você, {EventNimue.FirstName}.\" <<Cp:EventPlayerLeader>> diz."

msgid "STORY_EVENT@1013_1734@BUTTON_0"
msgstr "\"Juntos, colocaremos um fim ao terror da {EventNimue.Title}.\""

msgid "STORY_EVENT@1013_1734@TITLE"
msgstr "Aliança Descartada"

msgid "STORY_EVENT@1013_1742@BODY_FOOTER"
msgstr "{EventPlayerLeader.FirstName} suspira e acena. \"É meu dever libertar este reino ao seu lado. Lidera o caminho, {PlayerLeader.TitleName}.\""

msgid "STORY_EVENT@1013_1742@BODY_HEADER"
msgstr "Você formou uma aliança com {EventPlayerLeader.TitleName} dos {EventPlayerRace}. Uma voz estridente ecoa do sul do reino."

msgid "STORY_EVENT@1013_1742@BODY_LORE"
msgstr "\"{EventPlayerLeader.FirstName}! Você OUSA fazer alianças com invasores?!\" A voz de {EventNimue.FirstName} grita. \"Eu deveria ter afogado vocês na primeira vez que me decepcionaram. Meus amados {EventNimueRace} irão erradicar vocês, fracassos crescidos!\" [br/]{EventPlayerLeader.TitleName} endireita <<o:EventPlayerLeader>> costas. \"Parece que você estava certo sobre nossa deusa, {PlayerLeader.FirstName}.\""

msgid "STORY_EVENT@1013_1742@BUTTON_0"
msgstr "\"Juntos, colocaremos um fim ao terror da {EventNimue.Title}.\""

msgid "STORY_EVENT@1013_1742@TITLE"
msgstr "Lealdade Muda"

msgid "STORY_EVENT@1013_1744@BODY_FOOTER"
msgstr "\"Quem quer que tenha matado <<P:EventPlayerLeader>>, obrigado por fazer meu trabalho sujo. Você sofrerá o mesmo destino nas mãos da {EventNimue.Title} e seus {EventNimueRace}!\""

msgid "STORY_EVENT@1013_1744@BODY_FOOTER@NIMUE_DEFEATED"
msgstr "Com {EventPlayerLeader.FirstName} derrotado, você está um passo mais perto da vitória sobre o Arquipélago Encantado."

msgid "STORY_EVENT@1013_1744@BODY_HEADER"
msgstr "{EventPlayerLeader} foi derrotado. <<Co:EventPlayerLeader>> {EventPlayerRace} se dispersam, aterrorizados."

msgid "STORY_EVENT@1013_1744@BODY_LORE"
msgstr "Risadas ecoam em seus ouvidos. \"Então aqueles miseráveis finalmente estão mortos! Boa livrança deles! <<Cp:EventPlayerLeader>> queria brincar de {GLOBAL.GodirLoreConcept.Hyperlink}, e agora a essência de <<o:EventPlayerLeader>> vai fortalecer meus novos filhos, melhores. Certamente, meu próximo experimento será perfeito!\""

msgid "STORY_EVENT@1013_1744@BODY_LORE@NIMUE_DEFEATED"
msgstr "{EventPlayerLeader.TitleName} é lançado no {GLOBAL.AstralVoidLoreConcept.Hyperlink}. Risadas ecoantes ressoam por todo o reino, como se fossem um eco da caída {EventNimue.Title}. Se algo, o experimento de <<o:EventNimue>> falhou em seu teste final... Enfrentar você."

msgid "STORY_EVENT@1013_1744@BUTTON_0"
msgstr "\"Você será o próximo, {EventNimue.FirstName}.\""

msgid "STORY_EVENT@1013_1744@BUTTON_0@NIMUE_DEFEATED"
msgstr "\"Assim termina o reinado de {EventPlayerLeader.Title} {EventPlayerLeader.FirstName}.\""

msgid "STORY_EVENT@1013_1744@TITLE"
msgstr "{EventPlayerLeader} Derrotado"

msgid "STORY_EVENT@1013_1745@BODY_FOOTER"
msgstr "\"Quem quer que tenha matado <<P:EventPlayerLeader>>, obrigado por fazer meu trabalho sujo. Você encontrará o mesmo destino nas mãos da {EventNimue.Title} e seu {EventNimueRace}!\""

msgid "STORY_EVENT@1013_1745@BODY_FOOTER@NIMUE_DEFEATED"
msgstr "Com {EventPlayerLeader.FirstName} derrotado, você está um passo mais perto da vitória sobre o Arquipélago Encantado."

msgid "STORY_EVENT@1013_1745@BODY_HEADER"
msgstr "{EventPlayerLeader} foi derrotado. <<o:EventPlayerLeader>> {EventPlayerRace} se reúnem, com medo, mas enfrentando {EventNimue.FirstName} com bravura."

msgid "STORY_EVENT@1013_1745@BODY_HEADER@NIMUE_DEFEATED"
msgstr "{EventPlayerLeader} foi derrotado. <<Co:EventPlayerLeader>> {EventPlayerRace} se reúnem, com medo, mas bravos."

msgid "STORY_EVENT@1013_1745@BODY_LORE"
msgstr "Risadas ecoam em seus ouvidos. \"E esse é o fim de {EventPlayerLeader.TitleName}. <<Cp:EventPlayerLeader>> não correspondeu ao seu nome, não é mesmo? Claro, eu já sabia disso. <<Cp:EventPlayerLeader>> queria brincar de Godir, e agora a essência de <<o:EventPlayerLeader>> vai fortalecer meus novos filhos, melhores. Certamente, meu próximo experimento será perfeito!\""

msgid "STORY_EVENT@1013_1745@BODY_LORE@NIMUE_DEFEATED"
msgstr "{EventPlayerLeader.TitleName} é lançado no {GLOBAL.AstralVoidLoreConcept.Hyperlink}. Risadas ecoantes ressoam por todo o reino, como se fossem um eco da caída {EventNimue.Title}. Se algo, o experimento de <<o:EventNimue>> falhou em seu teste final... Enfrentar você."

msgid "STORY_EVENT@1013_1745@BUTTON_0"
msgstr "\"Você será o próximo, {EventNimue.FirstName}.\""

msgid "STORY_EVENT@1013_1745@BUTTON_0@NIMUE_DEFEATED"
msgstr "\"Assim termina o reinado de {EventPlayerLeader.Title} {EventPlayerLeader.FirstName}.\""

msgid "STORY_EVENT@1013_1745@TITLE"
msgstr "{EventPlayerLeader} Derrotado"

msgid "STORY_EVENT@1013_1775@BODY_FOOTER"
msgstr "Você deve reclamar este reino para impedi-lo de sucumbir ao Mar Astral."

msgid "STORY_EVENT@1013_1775@BODY_HEADER"
msgstr "Você derrotou {Meandor.TitleName}, o feiticeiro que transformou este mundo em um reino de fantasmas e reminiscências. No entanto..."

msgid "STORY_EVENT@1013_1775@BODY_LORE"
msgstr "A nuvem opressora da morte permanece. Parece que mesmo Meandor não conseguia mais controlar a incursão de {GLOBAL.SoulsLoreConcept.Hyperlink} neste reino, o que por sua vez atrai criaturas do {GLOBAL.AstralSeaLoreConcept.Hyperlink}. O véu entre {GLOBAL.AuldwealdLoreConcept.Hyperlink} e o Mar Astral fica cada vez mais fino..."

msgid "STORY_EVENT@1013_1775@BUTTON_0"
msgstr "Isso é apenas um passo no caminho para a vitória."

msgid "STORY_EVENT@1013_1775@TITLE"
msgstr "Meandor Derrotado"

msgid "STORY_EVENT@1013_1814@BODY_FOOTER"
msgstr "\"Todos os invasores deste reino serão erradicados. Esta Corte será Eterna.\" A aparição de {Inioch.TitleName} não pode ser negociada."

msgid "STORY_EVENT@1013_1814@BODY_HEADER"
msgstr "Você é recebido por uma aparição. Antes, este era um poderoso imperador, mas agora apenas um fragmento de sua [hyperlink,GLOBAL.SoulsLoreConcept]alma[/hyperlink] permanece."

msgid "STORY_EVENT@1013_1814@BODY_LORE"
msgstr "<<Cp:Inioch>> não parece notar <<o:Inioch>> própria incorporeidade. \"Você se dirige a {Inioch.Name}, {Inioch.Title} dos {IniochRace}, Governante da {IniochCity}. Não permitirei que meu trono seja tomado, nem pela \"lei\" dos [hyperlink,GLOBAL.ArchonsLoreConcept]Archons[/hyperlink] nem por mortais inferiores. O {GLOBAL.ValleyofWondersLoreConcept.Hyperlink} é meu e somente meu, para sempre, como é meu direito de nascença eterno. Todos que se opõem a mim não são nada além de usurpadores.\""

msgid "STORY_EVENT@1013_1814@BUTTON_0"
msgstr "\"Que assim seja.\""

msgid "STORY_EVENT@1013_1814@TITLE"
msgstr "Encontrando {Inioch.TitleName}"

msgid "STORY_EVENT@1013_1818@BODY_FOOTER"
msgstr "\"Por favor, permita-me visitar as fontes das vozes que continuo ouvindo.\""

msgid "STORY_EVENT@1013_1818@BODY_FOOTER@SARIDAS_MET"
msgstr "\"Por favor, {PlayerLeader.TitleName}, eu imploro que acabe com este tormento. As [hyperlink,GLOBAL.SoulsLoreConcept]almas[/hyperlink] do meu pai e irmão não devem permanecer presas neste reino.\""

msgid "STORY_EVENT@1013_1818@BODY_HEADER"
msgstr "{Sundren.FirstName} se aproxima de você, perturbada. Ela esfrega as têmporas."

msgid "STORY_EVENT@1013_1818@BODY_LORE"
msgstr "\"O reino, ele—sussurra para mim. Ouço vozes, daqueles que pensei estar perdidos há muito tempo. Eles me chamam. Eles pedem para eu... encontrá-los. Não posso mais ignorar essas vozes. Por favor, {PlayerLeader.TitleName}, devo ir até eles.\""

msgid "STORY_EVENT@1013_1818@BODY_LORE@SARIDAS_MET"
msgstr "\"Meu pai e meu irmão, suas vozes continuam me assombrando. Eles continuam me chamando, chamando por mim—coisas terríveis. Eles me culpam, querem que eu me junte a eles. Eu não posso—não posso passar pelo [hyperlink,GLOBAL.ShadowTrialLoreConcept]Provação das Sombras[/hyperlink] novamente.\""

msgid "STORY_EVENT@1013_1818@BUTTON_0"
msgstr "\"Muito bem, vamos nos aventurar lá.\""

msgid "STORY_EVENT@1013_1818@BUTTON_2"
msgstr "\"Foque, Sundren. Temos um reino para reclamar.\""

msgid "STORY_EVENT@1013_1818@TITLE"
msgstr "Perdas Sombrias"

msgid "STORY_EVENT@1013_1819@BODY_FOOTER"
msgstr "\"Agora que libertei meu irmão e meu pai, sinto-me fortalecida em minha busca. Obrigada, {PlayerLeader.FirstName}. Não esquecerei isso.\""

msgid "STORY_EVENT@1013_1819@BODY_HEADER"
msgstr "{Sundren.Name} respira profundamente após o espírito de seu pai e irmão terem desaparecido. Ela olha para a distância antes de falar."

msgid "STORY_EVENT@1013_1819@BODY_LORE"
msgstr "\"Meu pai e meu irmão morreram porque não consegui protegê-los, e durante a minha [hyperlink,GLOBAL.ShadowTrialLoreConcept]Provação das Sombras[/hyperlink] vi perigos que até nós [hyperlink,GLOBAL.GodirLoreConcept]Godir[/hyperlink] mal conseguimos compreender. Devo proteger aqueles que não podem se proteger. Para isso, devo fazer escolhas difíceis, fazer coisas que outros podem não entender. E atualmente isso significa quebrar a maldição do meu tio, por qualquer meio necessário, para que ele possa oferecer sua ajuda em troca.\""

msgid "STORY_EVENT@1013_1819@BODY_LORE@CURSE_BROKEN"
msgstr "\"Meu pai e meu irmão morreram porque não consegui protegê-los, e durante a minha [hyperlink,GLOBAL.ShadowTrialLoreConcept]Provação das Sombras[/hyperlink] vi perigos que até nós [hyperlink,GLOBAL.GodirLoreConcept]Godir[/hyperlink] mal conseguimos compreender. Devo proteger aqueles que não podem se proteger. Para isso, devo fazer escolhas difíceis, fazer coisas que outros podem não entender. É por isso que eu queria falar com meu tio. Só ele pode entender.\""

msgid "STORY_EVENT@1013_1819@BUTTON_0"
msgstr "\"Juntos, podemos libertar este reino.\""

msgid "STORY_EVENT@1013_1819@BUTTON_0@CURSE_BROKEN"
msgstr "Retorne a Magehaven com Sundren."

msgid "STORY_EVENT@1013_1819@TITLE"
msgstr "Perdas Sombrias: Consequências"

msgid "STORY_EVENT@1013_182@BODY_FOOTER"
msgstr "O povo de {EventHouseB.Name} parece muito ansioso para ajudar você a esmagar {EventHouse.Name}."

msgid "STORY_EVENT@1013_182@BODY_HEADER"
msgstr "O prestativo {EventHouseBLord.TitleName} de {EventHouseB.Name} oferece <<o:EventHouseBLord>> ajuda durante sua guerra com {EventHouse.Name}."

msgid "STORY_EVENT@1013_182@BODY_LORE"
msgstr "\"Grande {PlayerLeader.Name}! Chegou ao meu conhecimento que você finalmente viu as verdadeiras cores do horrível {EventHouseLord.TitleName} de {EventHouse.Name}. Gostaria de oferecer meus melhores guerreiros para ajudá-lo em sua guerra.\""

msgid "STORY_EVENT@1013_182@BUTTON_0"
msgstr "Acolha as unidades [unit/] de {EventHouseB.Name}."

msgid "STORY_EVENT@1013_182@BUTTON_1"
msgstr "Peça a eles para treinarem [unitprod/] seus próprios soldados em vez disso."

msgid "STORY_EVENT@1013_182@BUTTON_2"
msgstr "Peça por fundos [gold/] para seu tesouro de guerra em vez disso."

msgid "STORY_EVENT@1013_182@TITLE"
msgstr "Inimigo do Meu Inimigo"

msgid "STORY_EVENT@1013_1836@BODY_FOOTER"
msgstr "\"Agora que você sabe o que estou fazendo aqui, devo matá-lo. Meandor não deve acordar do feitiço que teci.\""

msgid "STORY_EVENT@1013_1836@BODY_HEADER"
msgstr "{Arachna.TitleName} parece surpresa em encontrá-lo. \"Eu deveria ter sabido que este dia estava chegando. Você me pegou, {PlayerLeader.TitleName}. \""

msgid "STORY_EVENT@1013_1836@BODY_LORE"
msgstr "\"Que fique registrado que não era minha intenção que {Meandor.FirstName} transformasse este reino em um poço de {GLOBAL.SoulsLoreConcept.Hyperlink}. Eu apenas pretendia mantê-lo... distraído.\"[br/]\n"
"\"Quem ordenou que você fizesse isso?!\" {Sundren.FirstName} exige saber. \"O {GLOBAL.ShadraiFactionLoreConcept.Hyperlink}?!\" [br/]\n"
"{Arachna.FirstName} responde friamente: \"Diferente de muitos outros nesta teia de {GLOBAL.GodirLoreConcept.Hyperlink}, eu ajo por minha própria vontade. Eu vi um problema e o resolvi, por enquanto.\""

msgid "STORY_EVENT@1013_1836@BUTTON_2"
msgstr "\"Que feitiço você teceu?\""

msgid "STORY_EVENT@1013_1836@BUTTON_3"
msgstr "\"Chega de conversa, Arachna! É guerra!\""

msgid "STORY_EVENT@1013_1836@TITLE"
msgstr "Encontrando a Tecelã de Feitiços"

msgid "STORY_EVENT@1013_1838@BODY_FOOTER"
msgstr "{Sundren.FirstName} rosna e {Arachna.FirstName} ri, um som perturbador. \"Talvez Meandor aprisione sua {GLOBAL.SoulsLoreConcept.Hyperlink} aqui também, depois que eu derrotá-lo.\""

msgid "STORY_EVENT@1013_1838@BODY_HEADER"
msgstr "{Arachna.FirstName} sorri. \"Enganar o lendário {Meandor.FirstName} foi fácil, na verdade. Todo {GLOBAL.GodirLoreConcept.Hyperlink} tem suas cordas para puxar. Eu apenas teço teias com elas.\""

msgid "STORY_EVENT@1013_1838@BODY_LORE"
msgstr "\"Apreendi que {Meandor.FirstName} estava bisbilhotando por perto do {GLOBAL.ShadraiFactionLoreConcept.Hyperlink}. Mas eu não poderia derrotar <<P:Meandor>> e mesmo se eu conseguisse, ele certamente rastejaria de volta para {GLOBAL.MagehavenLoreConcept.Hyperlink}. Então, em vez disso, usei os fantasmas de seu passado para mantê-lo ocupado. Você já os encontrou? Seu pai, especialmente, foi um desafio, já que apenas um fragmento de sua alma vagava por Auldweald. Mas eu me virei.\""

msgid "STORY_EVENT@1013_1838@BUTTON_2"
msgstr "\"Chega de conversa, {Arachna.FirstName}! Prepare-se para a batalha!\""

msgid "STORY_EVENT@1013_1838@TITLE"
msgstr "Confissão da Tecelã de Feitiços"

msgid "STORY_EVENT@1013_1852@BODY_FOOTER"
msgstr "Você derrotou {Arachna.TitleName}, quebrando uma parte do feitiço que mantinha {Meandor.Name} ocupado. As {GLOBAL.SoulsLoreConcept.Hyperlink} no reino parecem não afetadas, no entanto."

msgid "STORY_EVENT@1013_1852@BODY_HEADER"
msgstr "Você derrotou {Arachna.TitleName}. Suas aranhinhas se espalham, chiando na escuridão."

msgid "STORY_EVENT@1013_1852@BODY_LORE"
msgstr "{Sundren.FirstName} se anima. \"Parte da pressão em minha mente aliviou. As memórias dolorosas, os sentimentos de dor e fúria... Eles estão diminuindo lentamente. Ainda os sinto, mas agora posso lidar com eles.\" <<p:Sundren>> estremece. \"Os sussurros permanecem, no entanto. Devemos nos apressar, {PlayerLeader.TitleName}. Eu temo pelo destino deste reino.\""

msgid "STORY_EVENT@1013_1852@BUTTON_0"
msgstr "\"Um passo mais perto da vitória.\""

msgid "STORY_EVENT@1013_1852@TITLE"
msgstr "A Tecelã de Feitiços, Derrotada"

msgid "STORY_EVENT@1013_1853@BODY_FOOTER"
msgstr "{Arachna.FirstName} ri, suas {ArachnaRace.Name} se espalhando ao seu redor. \"Vão em frente, meus filhos! Deixem a mãe orgulhosa!\""

msgid "STORY_EVENT@1013_1853@BODY_HEADER"
msgstr "Você entra no domínio de {Arachna.TitleName}. Parece que uma batalha final se aproxima."

msgid "STORY_EVENT@1013_1853@BODY_LORE"
msgstr "\"Lutar nas linhas de frente não é meu estilo preferido, {PlayerLeader.FirstName}. Eu me orgulho de minhas abordagens mais... sutis para conflitos. No entanto, como você entrou no meu domínio, você não me deixa escolha. Vamos ver se sua alma permanece na minha teia também!\""

msgid "STORY_EVENT@1013_1853@BUTTON_0"
msgstr "\"Seus dias estão contados, Arachna!\""

msgid "STORY_EVENT@1013_1853@TITLE"
msgstr "Domínio da Tecelã de Feitiços"

msgid "STORY_EVENT@1013_1867@BODY_FOOTER"
msgstr "\"Eu não lutarei contra você, {EventHero.TitleName}. Remova os fios que me ligam ao feitiço lançado por aquela bruxa esquelética, escondida no subterrâneo.\""

msgid "STORY_EVENT@1013_1867@BODY_HEADER"
msgstr "{EventHero.Name} entra no túmulo dedicado à Mãe Perdida, {Eleanor.TitleName}. Ela mesma aparece, frustrada."

msgid "STORY_EVENT@1013_1867@BODY_LORE"
msgstr "\"Eu era uma imperatriz, a esposa de {Inioch.TitleName}, retornando aqui após dar à luz ao príncipe herdeiro do {GLOBAL.ValleyofWondersLoreConcept.Hyperlink}. Agora sou usada como um mero peão para enganar meu próprio filho! Eu não aceitarei isso. Exijo que você liberte meu filho desta desonra.\" Ela gesticula e linhas fracas aparecem ao seu redor, como teias... ou as cordas de um titereiro."

msgid "STORY_EVENT@1013_1867@BUTTON_0"
msgstr "Use sua conexão com a morte e as almas para libertar a alma de {Eleanor.TitleName} do feitiço que a afeta."

msgid "STORY_EVENT@1013_1867@BUTTON_10"
msgstr "Deixe o túmulo da {Eleanor.Title}, até que você tenha reunido [hyperlink,GLOBAL.AffinitiesLoreConcept]Afinidade[/hyperlink] suficiente ({EventCheckStrength}) para quebrar o feitiço."

msgid "STORY_EVENT@1013_1867@BUTTON_5"
msgstr "Use seu domínio do arcano para alcançar o Mar Astral e quebrar o feitiço."

msgid "STORY_EVENT@1013_1867@BUTTON_6"
msgstr "Use seus poderes de crescimento e cura para desfazer a maldição da morte, libertando {Eleanor.TitleName}."

msgid "STORY_EVENT@1013_1867@BUTTON_7"
msgstr "Invoque os poderes do caos para destruir essa magia com fogo e violência à moda antiga."

msgid "STORY_EVENT@1013_1867@BUTTON_8"
msgstr "Nenhuma maldição pode resistir à justiça divina. Invoque seus poderes divinos para quebrar esse feitiço."

msgid "STORY_EVENT@1013_1867@BUTTON_9"
msgstr "Usando seus poderes de matéria, puxe as teias para o reino físico para quebrá-las."

msgid "STORY_EVENT@1013_1867@TITLE"
msgstr "A Mãe Perdida"

msgid "STORY_EVENT@1013_1868@BODY_FOOTER"
msgstr "\"Antes de ir, responda à Imperatriz do [hyperlink,GLOBAL.ValleyofWondersLoreConcept]Vale das Maravilhas[/hyperlink]. Por que você está aqui, neste reino?\""

msgid "STORY_EVENT@1013_1868@BODY_HEADER"
msgstr "{Eleanor.TitleName} acena com a cabeça enquanto as teias desaparecem. \"Bom. Agora posso descansar novamente.\""

msgid "STORY_EVENT@1013_1868@BODY_LORE"
msgstr "\"Meu {Meandor.FirstName} me visitava frequentemente. Ele viu tanta perda. Receio que ele até se sinta culpado pela minha morte, embora não haja necessidade. Estou em paz. E estou orgulhosa de ver que meu filho cresceu para se tornar ainda mais poderoso do que Inioch foi. Obrigada, {PlayerLeader.TitleName}, por conceder a mim, ao meu filho e às [hyperlink,GLOBAL.SoulsLoreConcept]Almas[/hyperlink] do nosso orgulhoso mundo natal Élfico a paz que merecem.\""

msgid "STORY_EVENT@1013_1868@BUTTON_0"
msgstr "\"Estou aqui para salvar este reino e libertar as almas que vagam aqui.\" [goodact/]"

msgid "STORY_EVENT@1013_1868@BUTTON_3"
msgstr "\"Estou aqui para competir com os mestres da sombra e da morte.\" [shadowboon/]"

msgid "STORY_EVENT@1013_1868@BUTTON_4"
msgstr "\"Estou aqui para remodelar este reino de acordo com minha visão.\" [materiumboon/]"

msgid "STORY_EVENT@1013_1868@BUTTON_5"
msgstr "\"Estou aqui para transformar este reino em um paraíso novamente.\" [natureboon/]"

msgid "STORY_EVENT@1013_1868@BUTTON_6"
msgstr "\"Estou aqui para testar minha coragem e reclamar este reino através de um concurso!\" [chaosboon/]"

msgid "STORY_EVENT@1013_1868@BUTTON_7"
msgstr "\"Porque é dever de um Godir proteger os reinos.\" [orderboon/]"

msgid "STORY_EVENT@1013_1868@BUTTON_8"
msgstr "\"Estou aqui para descobrir os muitos segredos que o Mar Astral tem a oferecer.\" [astralboon/]"

msgid "STORY_EVENT@1013_1868@BUTTON_9"
msgstr "\"Estou aqui para reclamar este mundo para mim mesmo.\" [evilact/]"

msgid "STORY_EVENT@1013_1868@TITLE"
msgstr "A Mãe Perdida: Consequências"

msgid "STORY_EVENT@1013_1871@BODY_FOOTER"
msgstr "{Meandor.FirstName} atrai mais almas, mas com elas, outros perigos se aproximam do Mar Astral..."

msgid "STORY_EVENT@1013_1871@BODY_FOOTER@MEANDOR_DEFEATED"
msgstr "Uma parte da maldição que afetou Meandor é levantada, mas os espíritos errantes permanecem. Com eles, o perigo se aproxima do [hyperlink,GLOBAL.AstralSeaLoreConcept]Mar Astral[/hyperlink]..."

msgid "STORY_EVENT@1013_1871@BODY_FOOTER@QUEST_DONE"
msgstr "\"Essas visões... O que está acontecendo? Minha mente está pregando peças em mim? O que você está fazendo comigo?\" Meandor murmura para si mesmo, confuso, enquanto a última parte de sua maldição é quebrada."

msgid "STORY_EVENT@1013_1871@BODY_HEADER"
msgstr "O fragmento de {Inioch.TitleName}, antigo governante da [hyperlink,GLOBAL.AthlaLoreConcept]Corte Élfica de Athlan[/hyperlink], evapora no ar. {Meandor.TitleName} aparece diante de você, fervendo de raiva."

msgid "STORY_EVENT@1013_1871@BODY_HEADER@MEANDOR_DEFEATED"
msgstr "O fragmento de {Inioch.TitleName}, antigo governante da [hyperlink,GLOBAL.AthlaLoreConcept]Corte Élfica de Athlan[/hyperlink], evapora no ar."

msgid "STORY_EVENT@1013_1871@BODY_HEADER@QUEST_DONE"
msgstr "O fragmento de {Inioch.TitleName}, antigo Governante da [hyperlink,GLOBAL.AthlaLoreConcept]Corte Élfica de Athlan[/hyperlink], evapora no ar. {Meandor.TitleName} aparece diante de você, atordoado."

msgid "STORY_EVENT@1013_1871@BODY_LORE"
msgstr "\"Você OUSA atacar {Inioch.Title} {Inioch.Name}, meu pai, em sua própria corte?! Eu deveria ter sabido, vocês não são nada além de miseráveis traidores, determinados a destruir tudo o que é belo no amaldiçoado [hyperlink,GLOBAL.AstralSeaLoreConcept]Mar Astral[/hyperlink]. Não importa. Eu salvarei todas as almas de [hyperlink,GLOBAL.AuldwealdLoreConcept]Auldweald[/hyperlink] e do Mar Astral!\" Antes que você possa reagir, {Meandor.FirstName} levanta <<o:Meandor>> braços e atrai ainda mais [hyperlink,GLOBAL.SoulsLoreConcept]Almas[/hyperlink]."

msgid "STORY_EVENT@1013_1871@BODY_LORE@MEANDOR_DEFEATED"
msgstr "Com o aparecimento, um poderoso feitiço lançado sobre este reino parece enfraquecer. Com {Meandor.TitleName} já derrotado, muitas [hyperlink,GLOBAL.SoulsLoreConcept]Almas[/hyperlink] suspiram aliviadas. No entanto, elas permanecem presas."

msgid "STORY_EVENT@1013_1871@BODY_LORE@QUEST_DONE"
msgstr "\"Você OUSA atacar o Imperador Inioch, meu pai, em sua própria corte?! Você... Você não passa de invasores, aqui para destruir a Corte Élfica--\" ele pausa, enquanto os fios do feitiço enfraquecem ao seu redor. \"Eu... você... Meu pai...\""

msgid "STORY_EVENT@1013_1871@BUTTON_0"
msgstr "Permita que esses novos perigos apareçam."

msgid "STORY_EVENT@1013_1871@BUTTON_1"
msgstr "Use sua destreza mágica [mana/] para impedir que os perigos do Mar Astral apareçam."

msgid "STORY_EVENT@1013_1871@BUTTON_3"
msgstr "Acabe com a maldição que atormentou Meandor."

msgid "STORY_EVENT@1013_1871@TITLE"
msgstr "Derrotado {Inioch.TitleName}"

msgid "STORY_EVENT@1013_1873@BODY_FOOTER"
msgstr "\"Eu acredito que {Meandor.TitleName} é a causa de tudo isso. Sua consorte não-morta {Melenis.TitleName} chegou recentemente e reclamou um trono no sul. Ela pode saber mais.\""

msgid "STORY_EVENT@1013_1873@BODY_HEADER"
msgstr "{ElfSurvivor.FirstName} inspira profundamente. \"Tudo começou depois que {Meandor.TitleName} se estabeleceu aqui. Ele é um salvador para muitos, mas temo que tenha enlouquecido.\""

msgid "STORY_EVENT@1013_1873@BODY_LORE"
msgstr "\"Quando {Meandor.FirstName} chegou a este reino, ele foi recebido de braços abertos, como qualquer Elfo seria. No entanto, com o passar do tempo, ele ficou mais... perturbado. Ele murmurava sobre traições passadas e falava com 'pessoas' que ninguém mais via... Mas não ousamos intervir. Não muito tempo depois, {GLOBAL.SoulsLoreConcept.Hyperlink} começaram a vagar.\""

msgid "STORY_EVENT@1013_1873@BUTTON_2"
msgstr "\"Obrigado, {ElfSurvivor.TitleName}.\""

msgid "STORY_EVENT@1013_1873@TITLE"
msgstr "Maldição da Corte Eterna"

msgid "STORY_EVENT@1013_1907@BODY_FOOTER"
msgstr "\"Eu devo proteger este reino, cada alma. Nenhuma deve sair, todas devem ser preservadas. Minha amada Corte Élfica, eterna... como deveria ser.\""

msgid "STORY_EVENT@1013_1907@BODY_HEADER"
msgstr "Meandor continua. \"Há ironia em ver como os mortais correm para suas mortes inevitáveis. Tantos vidas eternas, perdidas para a ambição mortal tola.\""

msgid "STORY_EVENT@1013_1907@BODY_LORE"
msgstr "\"Minhas primeiras tentativas de trazer os mortos de volta foram... falhas. Trouxe de volta meu pai, {Inioch.TitleName}, mas ele não era o mesmo. Os não-mortos têm suas utilidades, mas lhes falta - alma. A resposta estava bem na nossa frente. Estávamos usando {GLOBAL.SoulsLoreConcept.Hyperlink} como moeda, enquanto elas mesmas são a chave. Eu devo preservar suas almas.\""

msgid "STORY_EVENT@1013_1907@BUTTON_0"
msgstr "\"Não há como raciocinar com você. Às armas!\""

msgid "STORY_EVENT@1013_1907@BUTTON_1"
msgstr "Deixe o {Meandor.Title} com suas visões... por enquanto."

msgid "STORY_EVENT@1013_1907@TITLE"
msgstr "Murmúrios de um {Meandor.Title} Louco"

msgid "STORY_EVENT@1013_191@BODY_FOOTER"
msgstr "Parece que uma banda de piromaníacos reclamou este monte de pedra e agora passam seu tempo ateando fogo em animais capturados."

msgid "STORY_EVENT@1013_191@BODY_HEADER"
msgstr "À medida que {EventHero.Name} se aproxima das ruínas fumegantes de um castelo outrora orgulhoso, <<p:EventHero>> nota um sigilo desbotado acima do portão carbonizado."

msgid "STORY_EVENT@1013_191@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "À medida que você se aproxima das ruínas fumegantes de um castelo outrora orgulhoso, você nota um sigilo desbotado acima do portão carbonizado."

msgid "STORY_EVENT@1013_191@BODY_LORE"
msgstr "Através dos tempos, este castelo foi lar de muitas bestas e vagabundos, deixando-o em ruínas. {EventHero.FirstName} sente cheiro de fumaça enquanto <<p:EventHero>> entra no portão. Um brilho vermelho ilumina os corredores próximos ao pátio onde risadas cínicas e gritos de medo podem ser ouvidos. Lá {EventHero.Name} vê as sombras dançantes de um {EnemyUnit.Name} e <<o:EnemyUnit>> seguidores. Eles estão ateando fogo a várias fogueiras, às quais animais assustados estão amarrados."

msgid "STORY_EVENT@1013_191@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Através dos tempos, este castelo foi lar de muitas bestas e vagabundos, deixando-o em ruínas. Você sente cheiro de fumaça enquanto entra no portão. Um brilho vermelho ilumina os corredores próximos ao pátio onde risadas cínicas e gritos de medo podem ser ouvidos. Lá você vê as sombras dançantes de um {EnemyUnit.Name} e <<o:EnemyUnit>> seguidores. Eles estão ateando fogo a várias fogueiras, às quais animais assustados estão amarrados."

msgid "STORY_EVENT@1013_191@BUTTON_0"
msgstr "Atacar os incendiários!"

msgid "STORY_EVENT@1013_191@BUTTON_1"
msgstr "Use sua destreza mágica [mana/] para proteger seu exército das chamas antes de entrar."

msgid "STORY_EVENT@1013_191@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "Use sua destreza mágica [mana/] para proteger a si mesmo e seu exército das chamas antes de entrar."

msgid "STORY_EVENT@1013_191@BUTTON_2"
msgstr "Sair."

msgid "STORY_EVENT@1013_191@BUTTON_3"
msgstr "Canalize água para apagar as chamas antes de entrar."

msgid "STORY_EVENT@1013_191@TITLE"
msgstr "Fumaça e Ruínas"

msgid "STORY_EVENT@1013_192@BODY_FOOTER"
msgstr "O {EventItem.Name} que você descobriu parece pertencer a {EventHouse.Name}."

msgid "STORY_EVENT@1013_192@BODY_FOOTER@NO_HOUSE"
msgstr "As origens do {EventItem.Name} que você descobriu são desconhecidas."

msgid "STORY_EVENT@1013_192@BODY_FOOTER@NO_HOUSE_PLAYERL"
msgstr "As origens do {EventItem.Name} que você descobriu são desconhecidas."

msgid "STORY_EVENT@1013_192@BODY_HEADER"
msgstr "Com os piromaníacos desaparecidos, {EventHero.Name} e <<o:EventHero>> companheiros estão livres para procurar o resto das ruínas."

msgid "STORY_EVENT@1013_192@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Com os piromaníacos desaparecidos, você e seus companheiros estão livres para procurar o resto das ruínas."

msgid "STORY_EVENT@1013_192@BODY_LORE"
msgstr "<<g:soldiers^p,EventHero>> libertam os animais atormentados, que fogem rapidamente da fortaleza. Ao inspecionar mais, {EventHero.FirstName} percebe que os piromantes deixaram para trás estoques de saque queimado por todo o edifício. Entre eles, {EventHero.FirstName} descobre um {EventItem.Name}, gravado com o mesmo sigilo que <<p:EventHero>> viu acima do portão do castelo. Parece muito valioso depois que {EventHero.FirstName} removeu a fuligem."

msgid "STORY_EVENT@1013_192@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Seus soldados libertam os animais atormentados, que fogem rapidamente da fortaleza. Ao inspecionar mais, você percebe que os piromantes deixaram para trás estoques de saque queimado por todo o edifício. Entre eles, você descobre um {EventItem.Name}, gravado com o mesmo sigilo que você viu acima do portão do castelo. Parece muito valioso depois que você removeu a fuligem."

msgid "STORY_EVENT@1013_192@BUTTON_0"
msgstr "Quem acha, fica. [item/]"

msgid "STORY_EVENT@1013_192@BUTTON_1"
msgstr "Devolva o {EventItem.Name} para {EventHouse.Name}."

msgid "STORY_EVENT@1013_192@BUTTON_2"
msgstr "Exiba o {EventItem.Name} em {EventCity}."

msgid "STORY_EVENT@1013_192@TITLE"
msgstr "Fumaça e Ruínas: Consequências"

msgid "STORY_EVENT@1013_193@BODY_FOOTER"
msgstr "\"Somos apenas comerciantes de... um gado específico. Você está interessado em nossa mercadoria?\""

msgid "STORY_EVENT@1013_193@BODY_HEADER"
msgstr "{EventHero.Name} se aproxima do castelo com cuidado. Parece abandonado, mas vozes angustiadas podem ser ouvidas de dentro das paredes do castelo."

msgid "STORY_EVENT@1013_193@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você se aproxima do castelo com cuidado. Parece abandonado, mas vozes angustiadas podem ser ouvidas de dentro das paredes do castelo."

msgid "STORY_EVENT@1013_193@BODY_LORE"
msgstr "Dentro, <<p:EventHero>> percebe animais enjaulados e um grupo de cativos assustados, amarrados e guardados por captores liderados por um {EnemyUnit}. Este último vê {EventHero.FirstName} e se curva. \"Ah, um cliente!\" <<p:EnemyUnit>> diz com um sorriso astuto. \"Bem-vindo à nossa humilde caravana mercante.\""

msgid "STORY_EVENT@1013_193@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Dentro, você percebe animais enjaulados e um grupo de cativos assustados, amarrados e guardados por captores liderados por um {EnemyUnit}. Este último vê {EventHero.FirstName} e se curva, sorrindo astutamente. \"Ah, um cliente!\" <<p:EnemyUnit>> diz. \"Bem-vindo à nossa humilde caravana mercante.\""

msgid "STORY_EVENT@1013_193@BUTTON_0"
msgstr "Atacar os captores!"

msgid "STORY_EVENT@1013_193@BUTTON_1"
msgstr "\"Nós vamos comprar [gold/] seu estoque. Todo ele.\""

msgid "STORY_EVENT@1013_193@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"Eu vou comprar [gold/] seu estoque. Todo ele.\""

msgid "STORY_EVENT@1013_193@BUTTON_2"
msgstr "Sair."

msgid "STORY_EVENT@1013_193@BUTTON_3"
msgstr "Destrua os cadeados das jaulas dos animais antes de enfrentar os captores."

msgid "STORY_EVENT@1013_193@BUTTON_4"
msgstr "\"É melhor você fugir antes de invocar a ira dos espíritos que assombram esta fortaleza!\""

msgid "STORY_EVENT@1013_193@TITLE"
msgstr "Castelos e Cativos"

msgid "STORY_EVENT@1013_1949@BODY_FOOTER"
msgstr "Sundren geme enquanto os espíritos a chamam. [br/]\"Junte-se a nós na morte. Junte-se a nós na eternidade. Você sabe que quer.\""

msgid "STORY_EVENT@1013_1949@BODY_HEADER"
msgstr "Você encontra os fantasmas de dois Elfos régios, governando a cidade fantasma de {EventHouse}. {Sundren.FirstName} ofega. \"Pai! {Thannis.FirstName}! Isso... isso não é possível...\""

msgid "STORY_EVENT@1013_1949@BODY_LORE"
msgstr "\"Olá, Sundren,\" o {Saridas.Title} e seu filho, {Thannis.FirstName}, dizem em uníssono. \"Filha, irmã. Faz muito tempo. Sentimos sua falta.\" [br/] {Sundren.FirstName} recua, cobrindo os ouvidos. \"Não,\" ela implora, \"faça parar...\"[br/]\"Você não nos salvou,\" os dois espíritos continuam, \"quando fomos traídos, quando fomos mortos. Você era fraca, tentou esconder seu lado sombrio. Você pode se revelar, agora. Junte-se a nós.\""

msgid "STORY_EVENT@1013_1949@BUTTON_3"
msgstr "\"Não ouça eles, Sundren! Devemos lutar para libertá-los de sua maldição!\""

msgid "STORY_EVENT@1013_1949@TITLE"
msgstr "Perdas Sombrias: Pai e Irmão"

msgid "STORY_EVENT@1013_194@BODY_FOOTER"
msgstr "Os cativos de {EventHouse.Name} aguardam ansiosamente seu destino."

msgid "STORY_EVENT@1013_194@BODY_FOOTER@NO_HOUSE"
msgstr "Os cativos libertados são gratos por sua chegada. Como você procede?"

msgid "STORY_EVENT@1013_194@BODY_FOOTER@NO_HOUSE_PLAYERL"
msgstr "Os cativos libertados são gratos por sua chegada. Como você procede?"

msgid "STORY_EVENT@1013_194@BODY_HEADER"
msgstr "Os escravizadores se foram e os cativos sobreviventes se reúnem em torno de {EventHero.FirstName}."

msgid "STORY_EVENT@1013_194@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Os escravizadores se foram e os cativos sobreviventes se aglomeram ao seu redor, agradecidos, mas ansiosos."

msgid "STORY_EVENT@1013_194@BODY_LORE"
msgstr "De entre os cativos, um {EventUnit} da {EventRace.Name} avança. \"Somos civis sob a proteção de {EventHouse.Name}.\" <<p:EventUnit>> diz. \"Fomos emboscados nas estradas perto deste castelo e trazidos aqui... O que você planeja fazer conosco?\""

msgid "STORY_EVENT@1013_194@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "De entre os cativos, um {EventUnit} da {EventRace.Name} avança e se curva profundamente. \"Somos civis sob a proteção de {EventHouse.Name}.\" <<p:EventUnit>> diz. \"Fomos emboscados nas estradas perto deste castelo e trazidos aqui... O que você planeja fazer conosco, {PlayerLeader.Name}?\""

msgid "STORY_EVENT@1013_194@BODY_LORE@NO_HOUSE"
msgstr "De entre os cativos, um {EventUnit} da {EventRace.Name} avança. \"Somos civis sob a proteção de {EventCity}.\" <<p:EventUnit>> diz. \"Fomos emboscados nas estradas perto deste castelo e trazidos aqui... Somos eternamente gratos pelo resgate.\""

msgid "STORY_EVENT@1013_194@BODY_LORE@NO_HOUSE_NO_CITY"
msgstr "De entre os cativos, um {EventUnit} da {EventRace.Name} avança. \"Fomos emboscados nas estradas perto deste castelo e trazidos aqui... Somos eternamente gratos pelo resgate.\""

msgid "STORY_EVENT@1013_194@BODY_LORE@NO_HOUSE_PLAYERL"
msgstr "De entre os cativos, um {EventUnit} da {EventRace.Name} avança e se curva profundamente. \"Somos civis sob a proteção de {EventCity}.\" <<p:EventUnit>> diz. \"Fomos emboscados nas estradas perto deste castelo e trazidos aqui... Somos eternamente gratos pelo resgate, Ó {PlayerLeader.Title}!\""

msgid "STORY_EVENT@1013_194@BUTTON_0"
msgstr "Capture os civis você mesmo [evilact/], intimidando {EventHouse.Name}. Surpresa!"

msgid "STORY_EVENT@1013_194@BUTTON_1"
msgstr "Libere os civis para retornarem a {EventHouse.Name}."

msgid "STORY_EVENT@1013_194@BUTTON_2"
msgstr "\"Os soldados [unitprod/] de {EventCity.Name} irão escoltá-los para casa em {EventHouse.Name}.\" [goodact/]"

msgid "STORY_EVENT@1013_194@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "\"Meus soldados [unitprod/] de {EventCity.Name} irão escoltá-los para casa em {EventHouse.Name}.\" [goodact/]"

msgid "STORY_EVENT@1013_194@BUTTON_3"
msgstr "\"Soldados [unitprod/] de {EventCity.Name} irão escoltá-los para casa.\" [goodact/]"

msgid "STORY_EVENT@1013_194@BUTTON_4"
msgstr "Envie os civis em seu caminho."

msgid "STORY_EVENT@1013_194@TITLE"
msgstr "Castelos e Cativos: Consequências"

msgid "STORY_EVENT@1013_1950@BODY_FOOTER"
msgstr "{Sundren.FirstName} abraça seu pai e irmão pela última vez, antes que eles desapareçam."

msgid "STORY_EVENT@1013_1950@BODY_HEADER"
msgstr "O fantasma de {Saridas.TitleName} é derrotado. Ele e {Thannis.FirstName} aparecem diante de {Sundren.FirstName} uma última vez."

msgid "STORY_EVENT@1013_1950@BODY_LORE"
msgstr "\"Podemos ver claramente, agora que estamos livres deste reino. Lamentamos, {Sundren.FirstName}. Não pretendíamos lutar contra você - este reino, ele afeta a [hyperlink,GLOBAL.SoulsLoreConcept]alma[/hyperlink]. Obrigado por nos libertar.\"[br/]{Thannis.FirstName} avança. \"Devemos ir agora. Vejo uma escuridão em você, irmã. Não deixe que ela domine seu coração. Honre-me protegendo aqueles que não podem se proteger.\" Ele sorri.[br/][br/]\"Algum dia, nos encontraremos novamente.\""

msgid "STORY_EVENT@1013_1950@BUTTON_0"
msgstr "..."

msgid "STORY_EVENT@1013_1950@TITLE"
msgstr "Despedidas Agridoces"

msgid "STORY_EVENT@1013_195@BODY_FOOTER"
msgstr "\"Bem-vindos, intrusos!\" {EnemyUnit} sorri. \"Vocês vieram para reacender as chamas da nossa paixão com sua essência?\""

msgid "STORY_EVENT@1013_195@BODY_HEADER"
msgstr "Dizem que apenas tolos perturbariam os aposentos eternos de <<EnemyUnit{king/queen}>> {EnemyUnit}. Isso, no entanto, não impede {EventHero.Name}."

msgid "STORY_EVENT@1013_195@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Dizem que apenas tolos perturbariam os aposentos eternos de <<EnemyUnit{king/queen}>> {EnemyUnit}. Isso, no entanto, não o impede."

msgid "STORY_EVENT@1013_195@BODY_LORE"
msgstr "No centro do túmulo, {EventHero.FirstName} encontra um grande altar com vários corpos preservados drapados ao redor de um <<EnemyUnit{king/queen}>> decorado, parecendo amantes adormecidos mesmo após séculos de sepultamento. De repente, o corpo decorado se mexe e abre os olhos de <<o:EnemyUnit>>, e os amantes não-mortos seguem o exemplo. Vozes roucas ecoam pelo túmulo enquanto eles se levantam e chamam {EventHero.FirstName}."

msgid "STORY_EVENT@1013_195@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "No centro do túmulo, você encontra um grande altar com vários corpos preservados drapados ao redor de um <<EnemyUnit{king/queen}>> decorado, parecendo amantes adormecidos mesmo após séculos de sepultamento. De repente, o corpo decorado se mexe e abre os olhos de <<o:EnemyUnit>>, e os amantes não-mortos seguem o exemplo. Vozes roucas ecoam pelo túmulo enquanto eles se levantam e chamam você."

msgid "STORY_EVENT@1013_195@BUTTON_0"
msgstr "\"Essa devassidão deve acabar! Às armas!\""

msgid "STORY_EVENT@1013_195@BUTTON_1"
msgstr "\"Eu te dou a essência do povo [population/] de {EventCity}.\" [evilact/]"

msgid "STORY_EVENT@1013_195@BUTTON_2"
msgstr "Partir."

msgid "STORY_EVENT@1013_195@BUTTON_3"
msgstr "Use seu conhecimento dos não-mortos para enfraquecer o <<EnemyUnit{king/queen}>> e os companheiros de <<o:EnemyUnit>> antes de atacar."

msgid "STORY_EVENT@1013_195@BUTTON_4"
msgstr "\"Você chama isso de paixão? Assista a mim...\""

msgid "STORY_EVENT@1013_195@TITLE"
msgstr "Aposentos Eternos"

msgid "STORY_EVENT@1013_196@BODY_FOOTER"
msgstr "O lich <<EnemyUnit{king/queen}>> se curva. \"Eu sou seu, {EventHero.Name}, assim como minha riqueza. Eu não tenho mais necessidade dela.\""

msgid "STORY_EVENT@1013_196@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "O lich <<EnemyUnit{king/queen}>> se curva. \"Eu sou seu, ó {PlayerLeader.Title}, assim como minha riqueza. Eu não tenho mais necessidade dela.\""

msgid "STORY_EVENT@1013_196@BODY_HEADER"
msgstr "{EventHero.Name} derrotou o não-morto <<EnemyUnit{king/queen}>> e os amantes <<o:EnemyUnit>>. O <<EnemyUnit{king/queen}>> se levanta mais uma vez e bate palmas com <<o:EnemyUnit>>, impressionado."

msgid "STORY_EVENT@1013_196@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você derrotou o não-morto <<EnemyUnit{king/queen}>> e os amantes <<o:EnemyUnit>>. O <<EnemyUnit{king/queen}>> se levanta mais uma vez e bate palmas com <<o:EnemyUnit>>, impressionado."

msgid "STORY_EVENT@1013_196@BODY_LORE"
msgstr "A voz rouca de <<Co:EnemyUnit>> ecoa novamente através da {EventStructure.Name}. \"Você me impressionou, <<EventHero{hero/heroine}>>. Poucos são capazes de fazer isso. Você reacendeu paixões em mim que eu havia esquecido há muito tempo. Por isso, desejo agradecer-lhe.\""

msgid "STORY_EVENT@1013_196@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "A voz rouca de <<Co:EnemyUnit>> ecoa novamente através da {EventStructure.Name}. \"Você me impressionou, {PlayerLeader.TitleName}. Poucos são capazes de fazer isso. Você reacendeu paixões em mim que eu havia esquecido há muito tempo. Por isso, desejo agradecer-lhe.\""

msgid "STORY_EVENT@1013_196@BUTTON_0"
msgstr "Pegue o {EventItem} de <<o:EnemyUnit>> e deixe o não-morto <<EnemyUnit{king/queen}>>."

msgid "STORY_EVENT@1013_196@BUTTON_1"
msgstr "\"Descanse agora para sempre, {EnemyUnit.Name}. É tudo o que posso pedir.\" [goodact/]"

msgid "STORY_EVENT@1013_196@BUTTON_2"
msgstr "Recrutar {EnemyUnit.Name} [unit/] mais tarde."

msgid "STORY_EVENT@1013_196@BUTTON_3"
msgstr "Peça a {EnemyUnit} para compartilhar <<o:EnemyUnit>> conhecimento ancestral [knowledge/] antes de deixar <<P:EnemyUnit>> descansar."

msgid "STORY_EVENT@1013_196@BUTTON_4"
msgstr "Recrutar {EnemyUnit.Name}. [unit/]"

msgid "STORY_EVENT@1013_196@TITLE"
msgstr "Aposentos Eternos: Consequências"

msgid "STORY_EVENT@1013_1980@BODY_FOOTER"
msgstr "\"Eu tentei investigar, mas não consegui ir longe. No entanto, vou compartilhar tudo o que sei.\""

msgid "STORY_EVENT@1013_1980@BODY_HEADER"
msgstr "Você conhece {ElfSurvivor.TitleName}, que lidera o que parece ser as poucas almas vivas restantes neste reino. \"Agradeço ao Pai de Todos pela sua chegada, {PlayerLeader.TitleName}!\""

msgid "STORY_EVENT@1013_1980@BODY_LORE"
msgstr "\"A Corte Eterna, este reino em nosso amado mundo natal, já foi um lugar belo,\" {ElfSurvivor.FirstName} lamenta. \"Agora, uma maldição terrível o tomou. {GLOBAL.SoulsLoreConcept.Hyperlink} dos mortos vagam como os vivos. Muitos que viviam aqui fugiram ou pereceram, suas almas incapazes de seguir em frente. Algo - ou alguém, está os mantendo aqui.\""

msgid "STORY_EVENT@1013_1980@BUTTON_0"
msgstr "\"Continue...\""

msgid "STORY_EVENT@1013_1980@TITLE"
msgstr "Encontrando os Elfos de Auldweald"

msgid "STORY_EVENT@1013_1993@BODY_FOOTER"
msgstr "\"Nada que você possa dizer pode me convencer agora. Esta é uma guerra, {PlayerLeader.TitleName}.\""

msgid "STORY_EVENT@1013_1993@BODY_HEADER"
msgstr "{EventPlayerLeader} resmunga. \"Você faz guerra contra a justa <<m:{GLOBAL.IndependentCityConcept.Hyperlink}>> neste reino e agora afirma que minha deusa é a malvada?!\""

msgid "STORY_EVENT@1013_1993@BODY_LORE"
msgstr "<<Cp:EventPlayerLeader>> range <<o:EventPlayerLeader>> os dentes. \"Devo respeitar as regras da negociação, então não vou derrubar você onde está. Você escolheu derrotar a {GLOBAL.IndependentCityConcept.Hyperlink} que jurei proteger. Nada que você diga sobre a {EventNimue.Title} pode me convencer. Eu lhe dou esta chance de partir, ou de reunir seus exércitos.\""

msgid "STORY_EVENT@1013_1993@BUTTON_0"
msgstr "\"Que assim seja.\""

msgid "STORY_EVENT@1013_1993@TITLE"
msgstr "Tarde Demais para a Razão"

msgid "STORY_EVENT@1013_1994@BODY_FOOTER"
msgstr "{EventRuler.TitleName} oferece <<o:EventRuler>> ajuda como um [hyperlink,GLOBAL.HeroConcept]<<EventRuler{hero/heroine}>>[/hyperlink] sob seu comando neste reino! Você aceita?"

msgid "STORY_EVENT@1013_1994@BODY_HEADER"
msgstr "Você recebe uma mensagem de {EventRuler.TitleName}, enviada através das correntes distantes do Mar Astral."

msgid "STORY_EVENT@1013_1994@BODY_LORE"
msgstr "\"{PlayerLeader.TitleName}, recebi notícias sobre sua campanha neste reino. Estou impressionado com seus esforços e, por isso, formalmente ofereço minha ajuda. Permita-me lutar como seu [hyperlink,GLOBAL.HeroConcept]<<EventRuler{hero/heroine}>>[/hyperlink]. Juntos, reclamaremos este reino e mostraremos a todos os {GLOBAL.GodirLoreConcept.Hyperlink} o poder do nosso {GLOBAL.PantheonLoreConcept.Hyperlink}!\""

msgid "STORY_EVENT@1013_1994@BUTTON_0"
msgstr "\"Acolho sua ajuda, {EventRuler.TitleName}!\" [unit/]"

msgid "STORY_EVENT@1013_1994@BUTTON_1"
msgstr "No momento, não posso acomodar sua chegada, mas acolherei sua ajuda no futuro, {EventRuler.TitleName}.\""

msgid "STORY_EVENT@1013_1994@BUTTON_2"
msgstr "\"Não preciso de ajuda de outros Godir neste momento.\""

msgid "STORY_EVENT@1013_1994@TITLE"
msgstr "A Ajuda de um Godir"

msgid "STORY_EVENT@1013_1999@BODY_FOOTER"
msgstr "Você se comprometerá a construir mais <<m:{GLOBAL.FarmConcept.Hyperlink}>> conforme a proposta do {EventRace.Name}?"

msgid "STORY_EVENT@1013_1999@BODY_HEADER"
msgstr "O Conselho {EventRace.Name} envia seu principal deputado para se encontrar com você com um pedido."

msgid "STORY_EVENT@1013_1999@BODY_LORE"
msgstr "O deputado se curva profundamente antes de <<p:EventUnit>> falar. \"Se os {EventRace.Name} devem ser vitoriosos neste reino, precisamos expandir nossas fronteiras, expandir nossas cidades... alimentar nosso povo. Para fazer isso, seu Conselho propõe reclamar mais terras agrícolas. Seu império crescerá e seu povo ficará grato.\""

msgid "STORY_EVENT@1013_1999@BUTTON_0"
msgstr "\"Muito bem. Eu cuidarei para que mais terras agrícolas sejam cultivadas.\""

msgid "STORY_EVENT@1013_1999@BUTTON_1"
msgstr "\"A expansão descontrolada não é o único caminho para a vitória. Em breve, você aprenderá.\""

msgid "STORY_EVENT@1013_1999@BUTTON_2"
msgstr "\"A satisfação só leva à mansidão. Preciso do meu povo com fome, pronto para lutar [unitprod/] por sua próxima refeição!\""

msgid "STORY_EVENT@1013_1999@TITLE"
msgstr "Busca pelo Cultivo"

msgid "STORY_EVENT@1013_199@BODY_FOOTER"
msgstr "{EventHouseLord.TitleName} solicita a libertação de {EventHero.Name} da sua prisão."

msgid "STORY_EVENT@1013_199@BODY_HEADER"
msgstr "Você recebe um apelo de {EventHouse.Name} sobre seu herói aprisionado {EventHero.Name}."

msgid "STORY_EVENT@1013_199@BODY_LORE"
msgstr "\"Sabemos que você mantém {EventHero.Name} em cativeiro. Podemos ser apenas uma cidade comparada ao seu grande império, mas {EventHero.FirstName} é um grande [hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink], um exemplo para nossa cidade e todos os {EventRace.Name}. <<Cp:EventHero>> não deve definhar em uma cela de prisão. Faça a coisa honrosa. Permita que {EventHero.FirstName} retorne ao povo <<o:EventHero>>.\""

msgid "STORY_EVENT@1013_199@BUTTON_0"
msgstr "Liberte {EventHero.FirstName}."

msgid "STORY_EVENT@1013_199@BUTTON_1"
msgstr "Exija um resgate [gold/] antes de libertar {EventHero.FirstName}."

msgid "STORY_EVENT@1013_199@BUTTON_2"
msgstr "Rejeite o pedido para libertar {EventHero.FirstName}."

msgid "STORY_EVENT@1013_199@BUTTON_3"
msgstr "\"Você apela para minha honra? {EventHero.Name} morrerá por sua insolência! [evilact/]\""

msgid "STORY_EVENT@1013_199@TITLE"
msgstr "Deixe <<P:EventHero>> ir"

msgid "STORY_EVENT@1013_2000@BODY_FOOTER"
msgstr "Seu povo está grato por esta prosperidade e se reúne para ouvir sua sabedoria. Qual mensagem você proclama para seus {EventRace.Name}?"

msgid "STORY_EVENT@1013_2000@BODY_HEADER"
msgstr "A primeira semeadura da temporada passou, e um deputado satisfeito do Conselho {EventRace.Name} retornou a você."

msgid "STORY_EVENT@1013_2000@BODY_LORE"
msgstr "\"Um grande dia para os {EventRace.Name}!\" O deputado proclama. \"Com esta nova terra agrícola, nosso povo prospera e nossas cidades se expandirão grandemente. Sua sabedoria verdadeiramente não conhece limites, {PlayerLeader.Title}. O Conselho dos {EventRace.Name} está grato.\""

msgid "STORY_EVENT@1013_2000@BUTTON_0"
msgstr "\"Cultive as colheitas [food/] que eu lhe dei.\""

msgid "STORY_EVENT@1013_2000@BUTTON_1"
msgstr "\"A magia é o que nos impulsiona. Traga ofertas aos espíritos [mana/] da terra.\""

msgid "STORY_EVENT@1013_2000@BUTTON_3"
msgstr "\"A verdadeira honra para os {EventRace.Name} está no serviço militar.\" [unitprod/]"

msgid "STORY_EVENT@1013_2000@TITLE"
msgstr "Missão para Cultivo: Consequências"

msgid "STORY_EVENT@1013_2002@BODY_FOOTER"
msgstr "\"Dê-nos o que queremos, e nos lembraremos de sua generosidade da próxima vez que os ventos e marés nos trouxerem a {EventCity.Name}.\""

msgid "STORY_EVENT@1013_2002@BODY_HEADER"
msgstr "Piratas temidos de um {EventSpawner} estão intrudindo em seu domínio perto de {EventCity.Name}! Eles exigem uma negociação."

msgid "STORY_EVENT@1013_2002@BODY_LORE"
msgstr "Seu capitão, um {EventStackLeader.Name}, cumprimenta você. \"Saudações, {PlayerLeader.TitleName}. Somos navegadores orgulhosos, viajamos pelo mar e tomamos o que queremos com sua bênção. E agora suas marés benevolentes nos trouxeram às margens da sua bela cidade de {EventCity.Name}, com a promessa de ouro... Claro, não há necessidade de violência, se pudermos chegar a um acordo.\""

msgid "STORY_EVENT@1013_2002@BUTTON_0"
msgstr "Pague [gold/] aos piratas para que deixem {EventCity.Name}."

msgid "STORY_EVENT@1013_2002@BUTTON_1"
msgstr "Ofereça ouro suficiente [gold/] para apaziguar o {EventSpawner.Name} por um tempo."

msgid "STORY_EVENT@1013_2002@BUTTON_2"
msgstr "\"Você não é nada mais que salteadores em barcos. Seus navios quebrarão nas margens de {EventCity.Name}.\""

msgid "STORY_EVENT@1013_2002@BUTTON_3"
msgstr "\"Eu tenho uma oferta melhor. Tornem-se meus corsários [influence/] e desfrutem dos luxos do saque sob meu estandarte!\""

msgid "STORY_EVENT@1013_2002@TITLE"
msgstr "Marés Benevolentes"

msgid "STORY_EVENT@1013_2003@BODY_FOOTER"
msgstr "\"Talvez, juntos, possamos convencer <<P:EventPlayerLeader>> da verdadeira natureza de Nimue... Se você provar ser realmente diferente dela.\""

msgid "STORY_EVENT@1013_2003@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} de {EventHouse.Name} cumprimenta você. \"Devo admitir, estou feliz em conhecê-lo. {EventPlayerLeader.FirstName} enviou você?\""

msgid "STORY_EVENT@1013_2003@BODY_LORE"
msgstr "\"Sou um velho amigo de {EventPlayerLeader.TitleName} e um dos <<o:EventPlayerLeader>> conselheiros mais confiáveis. Apoiamos um ao outro através de muitas dificuldades, incluindo o momento em que {EventNimue.FirstName} descartou meu povo pela primeira vez, e logo depois, <<o:EventPlayerLeader>>... Embora {EventPlayerLeader.FirstName} ainda negue a verdade. Eu mesmo... tive meu tempo para lamentar. Agora, apenas desejo a liberdade do povo neste reino.\""

msgid "STORY_EVENT@1013_2003@BUTTON_0"
msgstr "Iniciar negociações com {EventHouse.Name}."

msgid "STORY_EVENT@1013_2003@BUTTON_2"
msgstr "Deixá-los à própria sobrevivência."

msgid "STORY_EVENT@1013_2003@TITLE"
msgstr "Encontrando {EventHouse}, Voz da Razão"

msgid "STORY_EVENT@1013_200@BODY_FOOTER"
msgstr "{EventHero.FirstName} implora desesperadamente para ser libertado da sua prisão."

msgid "STORY_EVENT@1013_200@BODY_HEADER"
msgstr "Os guardas da prisão transmitem uma mensagem de {EventHero.Name}, que tem sido seu prisioneiro por um tempo."

msgid "STORY_EVENT@1013_200@BODY_LORE"
msgstr "\"Resistir ao grande {PlayerLeader.Name} foi um grave erro\", diz {EventHero.FirstName}. \"Eu vejo isso agora. Não posso mais continuar assim, não nasci para morrer em correntes. Por favor, {PlayerLeader.Title}, posso dar informações, conhecimento, farei qualquer coisa se você me deixar respirar ar fresco novamente!\""

msgid "STORY_EVENT@1013_200@BUTTON_0"
msgstr "\"Jure lealdade a mim, então eu te libertarei.\" [unit/]"

msgid "STORY_EVENT@1013_200@BUTTON_2"
msgstr "\"Eu te libertarei depois que você compartilhar os segredos [knowledge/] para <<g:prosperity^n,EventHouse>>.\" [gold/]"

msgid "STORY_EVENT@1013_200@BUTTON_3"
msgstr "Negar <<g:request^n,EventHero>> por liberdade."

msgid "STORY_EVENT@1013_200@TITLE"
msgstr "Súplica de Desespero"

msgid "STORY_EVENT@1013_201@BODY_FOOTER"
msgstr "{EventHouseBLord.TitleName} sorri de forma maliciosa, ansioso para levar {EventHero.Name} sob os \"cuidados\" de <<o:EventHouseBLord>>."

msgid "STORY_EVENT@1013_201@BODY_HEADER"
msgstr "{EventHouseBLord.Name} de {EventHouseB.Name} compartilha um pedido sobre seu prisioneiro, {EventHero.Name} de {EventHouse.Name}."

msgid "STORY_EVENT@1013_201@BODY_LORE"
msgstr "\"Ó {PlayerLeader.Title}, chegou ao meu conhecimento que você capturou um herói importante de {EventHouse.Name}!\" {EventHouseBLord.TitleName} esfrega <<o:EventHouseBLord>> as mãos. \"Este chamado \"[hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink]\" {EventHero.Name} matou muitos dos meus soldados. Capturar <<P:EventHero>> certamente aumentaria nossa alavancagem sobre a cidade miserável de <<o:EventHero>>. Preparamos um... tratamento especial para {EventHero.TitleName} dos {EventHero.Race}. \""

msgid "STORY_EVENT@1013_201@BUTTON_0"
msgstr "Enviar {EventHero.FirstName} para <<o:EventHero>> rival: {EventHouseBLord.TitleName} de {EventHouseB.Name}. [evilact/]"

msgid "STORY_EVENT@1013_201@BUTTON_1"
msgstr "Rejeitar <<g:request^n,EventHouseBLord>> e manter {EventHero.FirstName} prisioneiro você mesmo."

msgid "STORY_EVENT@1013_201@BUTTON_2"
msgstr "\"Faça valer a pena [gold/] e {EventHero.Name} é seu.\" [evilact/]"

msgid "STORY_EVENT@1013_201@BUTTON_3"
msgstr "\"Até mesmo prisioneiros merecem respeito. {EventHero.FirstName} não sofrerá tortura [goodact/].\""

msgid "STORY_EVENT@1013_201@TITLE"
msgstr "Convidado Especial"

msgid "STORY_EVENT@1013_2024@BODY_FOOTER"
msgstr "\"Os Shad'rai nos encarregaram de guardar esta prisão. Não podemos deixar você libertar a criatura, ela é valiosa demais.\""

msgid "STORY_EVENT@1013_2024@BODY_HEADER"
msgstr "Você entra em um prado que teria sido pacífico, não fosse pelo grupo de criaturas que o recebem, lideradas por um {EnemyUnit}."

msgid "STORY_EVENT@1013_2024@BODY_LORE"
msgstr "\"Então você encontrou a prisão dos {GLOBAL.MaerLoreConcept.Hyperlink}\", diz o {EnemyUnit}. \"A {EventNimue.Title} estuda esta criatura para aprimorar seu povo. Com cada raça recém-nascida, os seguidores de Nimue ficam melhores, mais poderosos. Os {GLOBAL.ShadraiFactionLoreConcept.Hyperlink} veem mérito em seus esforços. É por isso que nos designaram para guardar o Maer, para manter os feitiços que a ligam abaixo da superfície do lago.\""

msgid "STORY_EVENT@1013_2024@BUTTON_0"
msgstr "Atacar os guardas!"

msgid "STORY_EVENT@1013_2024@BUTTON_10"
msgstr "Deixar o lago."

msgid "STORY_EVENT@1013_2024@TITLE"
msgstr "Prisão de Elya"

msgid "STORY_EVENT@1013_2025@BODY_FOOTER"
msgstr "\"Não posso lutar pela sua causa, mas posso ajudar. Durante meu tempo como prisioneiro de Nimue, aprendi sobre seus experimentos. Posso te dizer o que sei.\""

msgid "STORY_EVENT@1013_2025@BODY_HEADER"
msgstr "Você derrotou os guardas da prisão de Elya e libertou o mítico {GLOBAL.MaerLoreConcept.Hyperlink}. {GLOBAL.ElyaLoreConcept.Hyperlink} emerge graciosamente, flutuando em correntes invisíveis."

msgid "STORY_EVENT@1013_2025@BODY_LORE"
msgstr "\"Agradeço-lhe, {PlayerLeader.TitleName}, por seguir minha canção. Meu nome é Elya. Fui capturada por {EventNimue}. Ela afirma que moldará o povo perfeito, um exército para os {GLOBAL.GodirLoreConcept.Hyperlink} que se autodenominam {GLOBAL.ShadraiFactionLoreConcept.Hyperlink}. Por favor, {PlayerLeader.TitleName}, você deve reclamar este reino para garantir que ela nunca mais o atormente.\""

msgid "STORY_EVENT@1013_2025@BUTTON_0"
msgstr "\"Ensine-me sobre um tomo que ainda não conheço.\""

msgid "STORY_EVENT@1013_2025@BUTTON_10"
msgstr "\"Conte-me tudo o que sabe sobre seus experimentos.\" [knowledge/]"

msgid "STORY_EVENT@1013_2025@BUTTON_11"
msgstr "\"Rejeito qualquer conhecimento obtido dos experimentos corrompidos de Nimue.\" [goodact/]"

msgid "STORY_EVENT@1013_2025@BUTTON_9"
msgstr "\"Ensine-me o que Nimue fez para transformar seus {EventNimueRace}.\""

msgid "STORY_EVENT@1013_2025@TITLE"
msgstr "Prisão de Elya: Consequências"

msgid "STORY_EVENT@1013_202@BODY_FOOTER"
msgstr "Você poderia facilmente derrotar {EventHouseLord.TitleName}, mas talvez haja coisas mais importantes em jogo do que vencer esta pequena vitória..."

msgid "STORY_EVENT@1013_202@BODY_HEADER"
msgstr "Durante negociações diplomáticas, {EventHouseLord.TitleName} de {EventHouse.Name} convida você para um jogo de Feiticeiros e Reis de alto risco."

msgid "STORY_EVENT@1013_202@BODY_LORE"
msgstr "Muito em breve, fica claro que o {EventHouseLord.Title} de {EventHouse} não está à altura das complexidades de um jogo destinado a ser jogado por {GLOBAL.GodirLoreConcept.Hyperlink}. O que deveria ter sido uma maneira agradável de trocar favores lentamente se transforma em um desastre diplomático à medida que {EventHouseLord.FirstName} fica cada vez mais frustrado com cada movimento que você faz."

msgid "STORY_EVENT@1013_202@BUTTON_0"
msgstr "Derrote {EventHouseLord} para reclamar as apostas [gold/]."

msgid "STORY_EVENT@1013_202@BUTTON_1"
msgstr "Deixe {EventHouseLord} vencer [allegiance/], bajulando o ego de <<o:EventHouseLord>>."

msgid "STORY_EVENT@1013_202@BUTTON_3"
msgstr "Invocar um duplo ilusório para perder contra {EventHouseLord}."

msgid "STORY_EVENT@1013_202@BUTTON_4"
msgstr "Humilhar {EventHouseLord} [evilact/] para reclamar a aposta de <<o:EventHouseLord>> [gold/] e a fama [influence/]."

msgid "STORY_EVENT@1013_202@BUTTON_5"
msgstr "Blefar uma derrota iminente para aumentar [gold/] e reclamar as apostas."

msgid "STORY_EVENT@1013_202@TITLE"
msgstr "Altos Riscos"

msgid "STORY_EVENT@1013_2033@BODY_FOOTER"
msgstr "Ao derrotar {EventNimue} e seus {EventNimueRace}, você libertou o Arquipélago Encantado. Mas os {GLOBAL.ShadraiFactionLoreConcept.Hyperlink} parecem ter planos maiores..."

msgid "STORY_EVENT@1013_2033@BODY_HEADER"
msgstr "{EventNimue} foi derrotada. Ela grita enquanto é lançada no {GLOBAL.AstralVoidLoreConcept.Hyperlink}. Todo o reino parece suspirar de alívio."

msgid "STORY_EVENT@1013_2033@BODY_LORE"
msgstr "Seus exércitos vasculham sua capital, onde ela conduziu seus \"experimentos\" e abusou das correntes da criação para criar novos povos. Você encontra notas e diários descrevendo comunicações entre ela e outros {GLOBAL.GodirLoreConcept.Hyperlink}, incluindo {EventYaka.FirstName} e alguém chamado {EventLithyl.FirstName}. Este último está procurando por um objeto e exige que {EventNimue.FirstName} prepare seus exércitos, não importa quão \"imperfeitos\" eles possam ser."

msgid "STORY_EVENT@1013_2033@BUTTON_0"
msgstr "Levarei minhas descobertas ao Pacto."

msgid "STORY_EVENT@1013_2033@BUTTON_1"
msgstr "Tomar todo o seu reserva de mana [mana/]."

msgid "STORY_EVENT@1013_2033@BUTTON_2"
msgstr "Não preciso de nada de um Godir louco como Nimue. [influence/]"

msgid "STORY_EVENT@1013_2033@TITLE"
msgstr "{EventNimue.FirstName} Derrotada"

msgid "STORY_EVENT@1013_2034@BODY_FOOTER"
msgstr "{EventNimue.FirstName} ri com escárnio enquanto {EventPlayerLeader.TitleName} se vira para você. \"Minha deusa chama pelo meu dever, {PlayerLeader.TitleName}. Isso significa guerra.\""

msgid "STORY_EVENT@1013_2034@BODY_HEADER"
msgstr "Você entra no domínio afogado de {EventNimue.Name}. Você a ouve gritar. \"Você ousa invadir meu domínio?!\""

msgid "STORY_EVENT@1013_2034@BODY_LORE"
msgstr "\"Isso é inaceitável, como você ousa se opor a mim!\"[br/]Ela chama {EventPlayerLeader.FirstName}, uma de suas antigas criações. \"{EventPlayerLeader.FirstName}! Meu súdito leal! Seu {EventNimue.Title} está em perigo! Prove seu valor para mim e destrua esse cretino, antes que eu mesma te afogue!\"[br/]{EventPlayerLeader.TitleName} dos {EventPlayerRace} pula em atenção e se curva. \"Sim, minha {EventNimue.Title}.\""

msgid "STORY_EVENT@1013_2034@BUTTON_0"
msgstr "\"Que assim seja.\""

msgid "STORY_EVENT@1013_2034@TITLE"
msgstr "Súdito Leal"

msgid "STORY_EVENT@1013_2056@BODY_FOOTER"
msgstr "Nimue grita de raiva enquanto seu antigo súdito leal desafia sua demanda. O próprio {EventPlayerLeader.FirstName} se volta para você. \"Eu não vou lutar contra você, {PlayerLeader.TitleName}. Não por ela.\""

msgid "STORY_EVENT@1013_2056@BODY_HEADER"
msgstr "Você entra no domínio afogado de {EventNimue.Name}. Você ouve seu grito. \"Você ousa invadir meu domínio?!\""

msgid "STORY_EVENT@1013_2056@BODY_LORE"
msgstr "\"Isso é inaceitável, como você ousa se opor a mim!\"[br/]Ela chama {EventPlayerLeader.FirstName}, uma de suas antigas criações. \"{EventPlayerLeader.FirstName}! Meu súdito leal! Seu {EventNimue.Title} está em perigo! Prove seu valor para mim e destrua este cretino!\"[br/]{EventPlayerLeader.TitleName} pula em atenção, mas vacila. Ele então balança a cabeça. \"Não, {EventNimue.Name}. Eu não posso fazer isso.\""

msgid "STORY_EVENT@1013_2056@BUTTON_0"
msgstr "\"Fico feliz em tê-lo do meu lado.\""

msgid "STORY_EVENT@1013_2056@TITLE"
msgstr "Súdito Desleal"

msgid "STORY_EVENT@1013_2057@BODY_FOOTER"
msgstr "\"Você não sabe como é a verdadeira perfeição, a verdadeira divindade. Prove a derrota pela minha mão e você pode aprender!\""

msgid "STORY_EVENT@1013_2057@BODY_HEADER"
msgstr "Você encontra um exército de {EventNimue.Name}. Ela mesma aparece diante de você. \"Você ainda está aqui?!\" ela grita."

msgid "STORY_EVENT@1013_2057@BODY_LORE"
msgstr "\"Então você e seu {PlayerRaceInsult} chegaram até aqui. Surpreendente, mas não importa. Você não tem ideia do que está por vir, do que os outros Shad'rai e eu estamos planejando. Minhas obras-primas vão esmagar você. Este será seu teste final para provar que são dignos do meu amor! Vá, meu {EventNimueRace.Name}, e mostre para sua {EventNimue.Title} o quanto você a ama!\""

msgid "STORY_EVENT@1013_2057@BUTTON_0"
msgstr "\"Seu reinado de terror vai acabar, Nimue!\""

msgid "STORY_EVENT@1013_2057@TITLE"
msgstr "Batalha contra o {EventNimue.Title}"

msgid "STORY_EVENT@1013_205@BODY_FOOTER"
msgstr "Você abre a garrafa e se sente enjoado apenas com o cheiro. Sua relação com {EventHouse} realmente vale... isso?"

msgid "STORY_EVENT@1013_205@BODY_HEADER"
msgstr "Durante negociações diplomáticas, {EventHouseLord.TitleName} de {EventHouse} envia-lhe uma garrafa cheia de uma substância desconhecida."

msgid "STORY_EVENT@1013_205@BODY_LORE"
msgstr "\"Ó {PlayerLeader.TitleName}, nós {EventRace} nos sentimos abençoados por sua presença. Em antecipação ao nosso novo pacto, mandamos este pequeno presente para você.\" {EventHouseLord} levanta um copo. \"Em nossa cultura, compartilhamos esta bebida quando forjamos um vínculo.\" <<Cp:EventHouseLord>> toma um gole e tosse muito, esperando que você retribua o gesto."

msgid "STORY_EVENT@1013_205@BUTTON_0"
msgstr "Faça um brinde e tome um gole."

msgid "STORY_EVENT@1013_205@BUTTON_1"
msgstr "Recuse-se a beber esta mistura repugnante."

msgid "STORY_EVENT@1013_205@BUTTON_2"
msgstr "Coloque um antídoto sorrateiramente e beba a garrafa inteira."

msgid "STORY_EVENT@1013_205@TITLE"
msgstr "O Gosto da Amizade"

msgid "STORY_EVENT@1013_206@BODY_FOOTER"
msgstr "{EventHouseLord} parece estar profundamente insultado pelas ações do seu [hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink] {EventHero}."

msgid "STORY_EVENT@1013_206@BODY_HEADER"
msgstr "Durante negociações diplomáticas, {EventHouseLord.TitleName} de {EventHouse} se aproxima de você, tremendo de raiva."

msgid "STORY_EVENT@1013_206@BODY_LORE"
msgstr "\"Isso é um ultraje!\" {EventHouseLord} grita. \"Recebi relatórios de que seu [hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink] {EventHero} estava falando mal de mim, insultando minha aparência, até mesmo fazendo uma imitação de mim enquanto usava uma máscara de {EventUnit}. {EventHero} parece pensar que <<p:EventHero>> pode se esconder <<r:EventHero>> atrás de você, <<o:EventHero>> {PlayerLeader.Title}, mas eu exijo que haja consequências!\""

msgid "STORY_EVENT@1013_206@BUTTON_0"
msgstr "\"Quando se trata de <<m:EventHouseLord.Title>> menores, {EventHero} pode dizer o que <<p:EventHero>> quiser.\""

msgid "STORY_EVENT@1013_206@BUTTON_1"
msgstr "\"Tenha certeza de que {EventHero} será disciplinado por <<o:EventHero>> transgressões.\""

msgid "STORY_EVENT@1013_206@BUTTON_2"
msgstr "\"Apesar de <<G:misconduct^n,EventHero>>, você não está acima de tais piadas insignificantes, {EventHouseLord}?\""

msgid "STORY_EVENT@1013_206@TITLE"
msgstr "Gafe"

msgid "STORY_EVENT@1013_2075@BODY_FOOTER"
msgstr "\"Nada que você possa dizer pode me convencer agora. Esta é uma guerra, {PlayerLeader.TitleName}.\""

msgid "STORY_EVENT@1013_2075@BODY_HEADER"
msgstr "{EventPlayerLeader} resmunga. \"Você declara guerra contra a justa <<m:{GLOBAL.IndependentCityConcept.Hyperlink}>> neste reino e agora afirma que minha deusa é a vilã?!\""

msgid "STORY_EVENT@1013_2075@BODY_LORE"
msgstr "<<Cp:EventPlayerLeader>> range <<o:EventPlayerLeader>> os dentes. \"Devo respeitar as regras da negociação, então não vou derrubar você onde está. Você escolheu derrotar a {GLOBAL.IndependentCityConcept.Hyperlink} que jurei proteger. Nada que você diga sobre a {EventNimue.Title} pode me convencer. Eu lhe concedo esta chance de sair ou reunir seus exércitos.\""

msgid "STORY_EVENT@1013_2075@BUTTON_0"
msgstr "\"Que assim seja.\""

msgid "STORY_EVENT@1013_2075@TITLE"
msgstr "Tarde Demais para a Razão"

msgid "STORY_EVENT@1013_2077@BODY_FOOTER"
msgstr "\"Se bons Godir realmente existem, por favor, nos livre de sua ira.\""

msgid "STORY_EVENT@1013_2077@BODY_HEADER"
msgstr "\"Tenha cuidado!\" Um Governante de um povo que você ainda não conheceu propriamente sai lentamente do esconderijo. \"Há monstros à espreita por perto.\""

msgid "STORY_EVENT@1013_2077@BODY_LORE"
msgstr "\"Eu sou {EventPlayerLeader.Name}, Governante dos {EventPlayerRace.Name}. Uma vez, fomos os favoritos da deusa, até que ela ficou... decepcionada conosco. Ela afogou tantos de nós quando fugimos de sua ira. Nós sobrevivemos permanecendo escondidos, mas seu poder cresce com cada criatura que ela constrói e afoga. Por favor, você deve impedi-la, antes que ela nos pegue.\""

msgid "STORY_EVENT@1013_2077@BUTTON_0"
msgstr "\"Diga-me o que posso fazer para ajudar.\""

msgid "STORY_EVENT@1013_2077@BUTTON_1"
msgstr "\"Apenas fique fora do meu caminho.\""

msgid "STORY_EVENT@1013_2077@TITLE"
msgstr "Encontrando {EventPlayerLeader.Name}"

msgid "STORY_EVENT@1013_268@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um dos seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> e gradualmente melhorar sua {GLOBAL.HouseInfluenceConcept.Hyperlink} com você."

msgid "STORY_EVENT@1013_268@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} está encantado em conhecê-lo pela primeira vez."

msgid "STORY_EVENT@1013_268@BODY_LORE"
msgstr "\"Bem encontrado, {PlayerLeader.TitleName}! É uma honra para outros {EventHouseRace.Name} como nós conhecer um grande {PlayerLeader.Title} como você. Esperamos ver seu império crescer.\""

msgid "STORY_EVENT@1013_268@BUTTON_0"
msgstr "\"Deixe-me ver se {EventHouse.Name} é digno da atenção que tanto deseja.\""

msgid "STORY_EVENT@1013_268@BUTTON_2"
msgstr "\"Até logo.\""

msgid "STORY_EVENT@1013_268@TITLE"
msgstr "Encontrando Amigável {EventHouse.Name}"

msgid "STORY_EVENT@1013_271@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um dos seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> e gradualmente melhorar sua {GLOBAL.HouseInfluenceConcept.Hyperlink} com você."

msgid "STORY_EVENT@1013_271@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} cumprimenta você pela primeira vez."

msgid "STORY_EVENT@1013_271@BODY_LORE"
msgstr "\"Saudações. É uma honra conhecer um {PlayerLeader.Title} dos {EventHouseRace.Name} aqui. No entanto, pedimos humildemente que respeite o território e a independência de {EventHouse.Name}.\""

msgid "STORY_EVENT@1013_271@BUTTON_0"
msgstr "\"Deixe-me ver se {EventHouse.Name} é digno da minha atenção.\""

msgid "STORY_EVENT@1013_271@BUTTON_2"
msgstr "\"Até logo.\""

msgid "STORY_EVENT@1013_271@TITLE"
msgstr "Encontrando Neutro {EventHouse.Name}"

msgid "STORY_EVENT@1013_272@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um dos seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> e gradualmente melhorar sua {GLOBAL.HouseInfluenceConcept.Hyperlink} com você."

msgid "STORY_EVENT@1013_272@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} cumprimenta você com cautela."

msgid "STORY_EVENT@1013_272@BODY_LORE"
msgstr "\"Apenas porque você é um(a) {PlayerLeader.Title} dos {EventHouseRace.Name}, isso não significa que {EventHouse.Name} se curvará a você sem questionar. Estaremos de olho em você, {PlayerLeader.Name}.\""

msgid "STORY_EVENT@1013_272@BUTTON_0"
msgstr "\"Deixe-me ver se {EventHouse.Name} é digno de reconciliação.\""

msgid "STORY_EVENT@1013_272@BUTTON_2"
msgstr "\"Lidarei com sua insolência mais tarde.\""

msgid "STORY_EVENT@1013_272@TITLE"
msgstr "Encontrando {EventHouse.Name} com Cautela"

msgid "STORY_EVENT@1013_273@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um dos seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> e gradualmente melhorar sua {GLOBAL.HouseInfluenceConcept.Hyperlink} com você."

msgid "STORY_EVENT@1013_273@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} está entusiasmado em conhecê-lo pela primeira vez."

msgid "STORY_EVENT@1013_273@BODY_LORE"
msgstr "\"Bem-vindo, {PlayerLeader.TitleName}! Ouvimos coisas grandiosas sobre você. Nós, {EventHouseRace.Name}, esperamos que nossa humilde {GLOBAL.IndependentCityConcept.Hyperlink} possa aprender com você.\""

msgid "STORY_EVENT@1013_273@BUTTON_0"
msgstr "\"Deixe-me ver se {EventHouse.Name} é digno da atenção que tanto desejam.\""

msgid "STORY_EVENT@1013_273@BUTTON_2"
msgstr "\"Até logo.\""

msgid "STORY_EVENT@1013_273@TITLE"
msgstr "Encontrando {EventHouse.Name} Amigável"

msgid "STORY_EVENT@1013_274@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um dos seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> e gradualmente melhorar sua {GLOBAL.HouseInfluenceConcept.Hyperlink} com você."

msgid "STORY_EVENT@1013_274@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} cumprimenta você pela primeira vez."

msgid "STORY_EVENT@1013_274@BODY_LORE"
msgstr "\"Saudações, {PlayerLeader.Title} dos {PlayerRace.Name}. Nós, {EventHouseRace.Name}, humildemente pedimos que respeite <<g:territory^n,EventHouse>> e independência.\""

msgid "STORY_EVENT@1013_274@BUTTON_0"
msgstr "\"Deixe-me ver se {EventHouse.Name} é digno da minha atenção.\""

msgid "STORY_EVENT@1013_274@BUTTON_2"
msgstr "\"Até logo.\""

msgid "STORY_EVENT@1013_274@TITLE"
msgstr "Encontrando {EventHouse.Name} Neutro"

msgid "STORY_EVENT@1013_275@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um dos seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> e gradualmente melhorar sua {GLOBAL.HouseInfluenceConcept.Hyperlink} com você."

msgid "STORY_EVENT@1013_275@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} olha para você com suspeita."

msgid "STORY_EVENT@1013_275@BODY_LORE"
msgstr "\"Então! Os orgulhosos cidadãos de {EventHouse.Name} se encontram com um(a) {PlayerLeader.Title}. Sugerimos que nos aborde com cautela, pois você descobrirá que não nos curvamos tão facilmente quanto você, {PlayerRace.Name}.\""

msgid "STORY_EVENT@1013_275@BUTTON_0"
msgstr "\"Deixe-me ver se {EventHouse.Name} é digno de reconciliação.\""

msgid "STORY_EVENT@1013_275@BUTTON_2"
msgstr "\"Lidarei com sua insolência mais tarde.\""

msgid "STORY_EVENT@1013_275@TITLE"
msgstr "Encontrando {EventHouse.Name} com Cautela"

msgid "STORY_EVENT@1013_431@BODY_FOOTER"
msgstr "Você está atualmente passando pelo domínio de {EventHouse.Name}."

msgid "STORY_EVENT@1013_431@BODY_HEADER"
msgstr "Guardas amigáveis de {EventHouse.Name} rapidamente se levantam de onde estavam descansando quando seu exército se aproxima."

msgid "STORY_EVENT@1013_431@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Guardas amigáveis de {EventHouse.Name} rapidamente se levantam de onde estavam descansando quando você se aproxima."

msgid "STORY_EVENT@1013_431@BODY_LORE"
msgstr "\"Bom dia, viajantes,\" diz {EventStackLeader.Name} enquanto os outros se apressam para suas posições. \"Você são seguidores de {PlayerLeader.TitleName}, não são? Bem-vindos ao domínio de {EventHouse.Name}. O que os traz a nossas terras?\""

msgid "STORY_EVENT@1013_431@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "\"Bom dia, {PlayerLeader.TitleName},\" diz {EventStackLeader.Name} enquanto os outros se apressam para suas posições. \"Bem-vindo ao domínio de {EventHouse.Name}. O que o traz a nossas terras?\""

msgid "STORY_EVENT@1013_431@BUTTON_1"
msgstr "\"Temos uma mensagem para seu {EventHouseLord.TitleName}.\""

msgid "STORY_EVENT@1013_431@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"Tenho uma mensagem para seu {EventHouseLord.TitleName}.\""

msgid "STORY_EVENT@1013_431@BUTTON_2"
msgstr "\"Viemos para destruir você!\""

msgid "STORY_EVENT@1013_431@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "\"Vim para destruir você!\""

msgid "STORY_EVENT@1013_431@BUTTON_3"
msgstr "\"Estamos apenas passando...\""

msgid "STORY_EVENT@1013_431@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "\"Estou apenas passando...\""

msgid "STORY_EVENT@1013_431@TITLE"
msgstr "Saudações, Viajante!"

msgid "STORY_EVENT@1013_431@TITLE@HERO_IS_PLAYERLE"
msgstr "Saudações, {PlayerLeader.Title}!"

msgid "STORY_EVENT@1013_432@BODY_FOOTER"
msgstr "Esses guardas de {EventHouse.Name} parecem incertos sobre suas intenções."

msgid "STORY_EVENT@1013_432@BODY_HEADER"
msgstr "Guardas da cidade independente de {EventHouse.Name} chamam de uma distância quando seu exército se aproxima."

msgid "STORY_EVENT@1013_432@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Guardas da cidade independente de {EventHouse.Name} chamam de uma distância quando você se aproxima."

msgid "STORY_EVENT@1013_432@BODY_LORE"
msgstr "\"Pare, viajante! Saiba que está viajando pelo domínio de {EventHouse.Name}. Diga seu propósito ou vá embora!\""

msgid "STORY_EVENT@1013_432@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Eles murmuram, mas um deles reúne coragem para gritar: \"Pare, {PlayerLeader.Title}! Saiba que está viajando pelo domínio de {EventHouse.Name}. Diga seu propósito ou vá embora!\""

msgid "STORY_EVENT@1013_432@BUTTON_1"
msgstr "\"Temos uma mensagem para seu {EventHouseLord.TitleName}.\""

msgid "STORY_EVENT@1013_432@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"Tenho uma mensagem para seu {EventHouseLord.TitleName}.\""

msgid "STORY_EVENT@1013_432@BUTTON_2"
msgstr "\"Viemos para destruir você!\""

msgid "STORY_EVENT@1013_432@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "\"Vim para destruir você!\""

msgid "STORY_EVENT@1013_432@BUTTON_3"
msgstr "\"Fiquem à vontade, estamos apenas passando...\""

msgid "STORY_EVENT@1013_432@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "\"Fiquem à vontade, estou apenas passando...\""

msgid "STORY_EVENT@1013_432@TITLE"
msgstr "Pare, Viajante!"

msgid "STORY_EVENT@1013_432@TITLE@HERO_IS_PLAYERLE"
msgstr "Pare, {PlayerLeader.Title}!"

msgid "STORY_EVENT@1013_433@BODY_FOOTER"
msgstr "\"Que cidade bonita você tem aí!\" diz o {EventStackLeader.Name}. \"Seria uma pena se alguém a saqueasse, repetidamente...\""

msgid "STORY_EVENT@1013_433@BODY_HEADER"
msgstr "Um grupo de bandidos acampou nas proximidades e está invadindo suas fronteiras perto de {EventCity.Name}!"

msgid "STORY_EVENT@1013_433@BODY_LORE"
msgstr "\"Bom dia, vizinho!\" um {EventStackLeader.Name} de aparência rústica grita à distância. \"Prazer em conhecê-lo. Deixe-me explicar como as coisas funcionam por aqui. Oferecemos proteção... contra bandidos horríveis que vagam por estas terras. Mas para podermos protegê-lo de nós—err... quero dizer, deles—precisaremos de pagamento. Adiantado. Está claro o suficiente, hein?\""

msgid "STORY_EVENT@1013_433@BUTTON_0"
msgstr "Pague a taxa deles [gold/] para que o {EventStackLeader.Name} deixe {EventCity.Name} em paz."

msgid "STORY_EVENT@1013_433@BUTTON_1"
msgstr "\"Aqui está uma oferta [gold/] para apaziguar todo o seu {EventSpawner.Name} por um tempo.\""

msgid "STORY_EVENT@1013_433@BUTTON_2"
msgstr "\"Não temos medo de vocês, bandidos, nem de suas ameaças fracas.\""

msgid "STORY_EVENT@1013_433@TITLE"
msgstr "Proposta de Negócio"

msgid "STORY_EVENT@1013_434@BODY_FOOTER"
msgstr "Enquanto <<p:EventHero>> luta para se mover através da teia pegajosa, {EventHero.FirstName} ouve o farfalhar animado dos muitos habitantes de pernas da caverna. Eles podem sentir mais presas!"

msgid "STORY_EVENT@1013_434@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Enquanto você luta para se mover através da teia pegajosa, ouve o farfalhar animado dos muitos habitantes de pernas da caverna. Eles podem sentir mais presas!"

msgid "STORY_EVENT@1013_434@BODY_HEADER"
msgstr "A caverna está escura e silenciosamente assustadora enquanto {EventHero.Name} se aproxima. Uma fina camada de teia sedosa cobre a entrada."

msgid "STORY_EVENT@1013_434@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "A caverna está escura e silenciosamente assustadora enquanto você se aproxima. Uma fina camada de teia sedosa cobre a entrada."

msgid "STORY_EVENT@1013_434@BODY_LORE"
msgstr "{EventHero.FirstName} e <<o:EventHero>> grupo aventuram-se mais fundo pelo sistema de cavernas labirínticas, passando por casulos cheios de todos os tipos de criaturas enquanto buscam os segredos escondidos sob as teias de aranha. Logo, a teia fica tão espessa que fica visivelmente mais difícil de se mover. Então, {EventHero.FirstName} ouve algo na escuridão."

msgid "STORY_EVENT@1013_434@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Você e seu grupo aventuram-se mais fundo pela caverna labiríntica, passando por casulos cheios de todos os tipos de criaturas enquanto buscam os segredos escondidos sob as teias de aranha. Logo, a teia fica tão espessa que fica visivelmente mais difícil de se mover. Então, você ouve algo na escuridão."

msgid "STORY_EVENT@1013_434@BUTTON_0"
msgstr "\"Mate essas criaturas vis! Ataquem!\""

msgid "STORY_EVENT@1013_434@BUTTON_1"
msgstr "Ateie fogo na teia ao redor de {EventHero.FirstName}."

msgid "STORY_EVENT@1013_434@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "Ateie fogo na teia ao seu redor."

msgid "STORY_EVENT@1013_434@BUTTON_2"
msgstr "Desmorone parte da caverna em cima das aranhas, danificando-as antes de engajar."

msgid "STORY_EVENT@1013_434@BUTTON_4"
msgstr "Recuar."

msgid "STORY_EVENT@1013_434@TITLE"
msgstr "Covil de Seda"

msgid "STORY_EVENT@1013_435@BODY_FOOTER"
msgstr "\"Devo-lhe minha vida.\" diz {EventHeroB.Name}. \"Se precisar da minha ajuda no futuro, basta pedir.\""

msgid "STORY_EVENT@1013_435@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "\"Devo-lhe minha vida, ó {PlayerLeader.Title}.\" diz {EventHeroB.Name}. \"Se precisar da minha ajuda no futuro, basta pedir.\""

msgid "STORY_EVENT@1013_435@BODY_HEADER"
msgstr "Depois que as aranhas são derrotadas, {EventHero.FirstName} pode procurar na caverna com facilidade."

msgid "STORY_EVENT@1013_435@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Depois que as aranhas são derrotadas, você pode procurar na caverna com facilidade."

msgid "STORY_EVENT@1013_435@BODY_LORE"
msgstr "<<Cp:EventHero>> encontra vários casulos, a maioria deles vazios ou com seus conteúdos apodrecidos. Então, um dos companheiros de <<o:EventHero>> chama <<P:EventHero>>. \"Este ainda está respirando!\" {EventHero.FirstName} rapidamente libera a vítima viva e, após um momento de descanso, <<p:EventHeroB>> consegue falar. \"Agradeço ao {GLOBAL.GodirLoreConcept.Hyperlink} pela sua chegada. Meu nome é {EventHeroB.Name} de {EventHouse.Name}. Viajamos até aqui para investigar este suposto refúgio seguro, e então... bem.\" <<Cp:EventHeroB>> gesticula em direção aos casulos."

msgid "STORY_EVENT@1013_435@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Você encontra vários casulos, a maioria deles vazios ou com seus conteúdos apodrecidos. Então, um dos seus companheiros o chama. \"Este ainda está respirando!\" Você rapidamente libera a vítima viva e, após um momento de descanso, <<p:EventHeroB>> consegue falar. \"Agradeço ao {GLOBAL.GodirLoreConcept.Hyperlink} pela sua chegada. Meu nome é {EventHeroB} de {EventHouse}. Viajamos até aqui para investigar este suposto refúgio seguro, e então... bem.\" <<Cp:EventHeroB>> gesticula em direção aos casulos."

msgid "STORY_EVENT@1013_435@BODY_LORE@NO_EVENTHOUSE"
msgstr "<<Cp:EventHero>> encontra vários casulos, a maioria vazios ou com seus conteúdos apodrecidos. Então, um dos companheiros de <<o:EventHero>> chama <<P:EventHero>>. \"Este ainda está respirando!\" {EventHero.FirstName} rapidamente libera a vítima viva e, após um momento de descanso, <<p:EventHeroB>> consegue falar. \"Agradecemos aos {GLOBAL.GodirLoreConcept.Hyperlink} por sua chegada. Meu nome é {EventHeroB.Name} de {EventCity.Name}. Viajamos até aqui para investigar este suposto refúgio seguro, e então... bem.\" <<Cp:EventHeroB>> gesticula em direção aos casulos."

msgid "STORY_EVENT@1013_435@BODY_LORE@NO_HOUSE_NO_CITY"
msgstr "<<Cp:EventHero>> encontra vários casulos, a maioria vazios ou com seus conteúdos apodrecidos. Então, um dos companheiros de <<o:EventHero>> chama <<P:EventHero>>. \"Este ainda está respirando!\" {EventHero.FirstName} rapidamente libera a vítima viva e, após um momento de descanso, <<p:EventHeroB>> consegue falar. \"Agradecemos aos {GLOBAL.GodirLoreConcept.Hyperlink} por sua chegada. Meu nome é {EventHeroB.Name}. Viajamos até aqui para investigar este suposto refúgio seguro, e então... bem.\" <<Cp:EventHeroB>> gesticula em direção aos casulos."

msgid "STORY_EVENT@1013_435@BODY_LORE@NO_HOUSE_PLAYERL"
msgstr "Você encontra vários casulos, a maioria vazios ou com seus conteúdos apodrecidos. Então, um dos seus companheiros chama você. \"Este ainda está respirando!\" Você rapidamente libera a vítima viva e, após um momento de descanso, <<p:EventHeroB>> consegue falar. \"Agradecemos aos {GLOBAL.GodirLoreConcept.Hyperlink} por sua chegada. Meu nome é {EventHeroB} de {EventCity}. Viajamos até aqui para investigar este suposto refúgio seguro, e então... bem.\" <<Cp:EventHeroB>> gesticula em direção aos casulos."

msgid "STORY_EVENT@1013_435@BUTTON_0"
msgstr "Enviar {EventHeroB.Name} para casa [goodact/] para {EventHouse.Name}."

msgid "STORY_EVENT@1013_435@BUTTON_1"
msgstr "Tirar os pertences de {EventHeroB.Name} [gold/] e prender <<P:EventHeroB>>. [evilact/]"

msgid "STORY_EVENT@1013_435@BUTTON_2"
msgstr "Enviar {EventHeroB.Name} para casa [goodact/] para {EventCity.Name}."

msgid "STORY_EVENT@1013_435@BUTTON_3"
msgstr "Exigir um tributo [gold/] pelo resgate e enviar {EventHeroB.FirstName} em <<o:EventHeroB>> caminho."

msgid "STORY_EVENT@1013_435@TITLE"
msgstr "Covil de Seda: Consequências"

msgid "STORY_EVENT@1013_443@BODY_FOOTER"
msgstr "Esses soldados de {EventHouse.Name} claramente não confiam em suas intenções."

msgid "STORY_EVENT@1013_443@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Esses soldados de {EventHouse.Name} claramente não confiam em suas intenções."

msgid "STORY_EVENT@1013_443@BODY_HEADER"
msgstr "Guardas hostis de {EventHouse.Name} gritam de posições defensivas quando seu exército se aproxima."

msgid "STORY_EVENT@1013_443@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Guardas hostis de {EventHouse.Name} gritam de posições defensivas quando você se aproxima."

msgid "STORY_EVENT@1013_443@BODY_LORE"
msgstr "\"Parem! Nem um passo mais perto!\" seu líder grita, braços cruzados, em frente a <<g:banner^n,EventHouse>>. \"Você não pode nos enganar. Você carrega o estandarte do desprezível {PlayerLeader.TitleName}! Vamos ficar de olho em você, então não tente nada!\""

msgid "STORY_EVENT@1013_443@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "\"Pare, {PlayerLeader.Title}! Nem um passo mais perto!\" seu líder grita, braços cruzados, em frente a <<g:banner^n,EventHouse>>. \"Você não pode nos enganar ou intimidar. Ouvimos tudo sobre você! Vamos ficar de olho em você, então não tente nada!\""

msgid "STORY_EVENT@1013_443@BUTTON_1"
msgstr "\"Temos uma mensagem para o seu {EventHouseLord.TitleName}.\""

msgid "STORY_EVENT@1013_443@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"Tenho uma mensagem para o seu {EventHouseLord.TitleName}.\""

msgid "STORY_EVENT@1013_443@BUTTON_2"
msgstr "\"Suas suspeitas estão corretas! Às armas!\""

msgid "STORY_EVENT@1013_443@BUTTON_3"
msgstr "\"Descansem, estamos apenas passando por aqui...\""

msgid "STORY_EVENT@1013_443@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "\"Descansem, estou apenas passando por aqui...\""

msgid "STORY_EVENT@1013_443@TITLE"
msgstr "Nem um Passo Mais Perto!"

msgid "STORY_EVENT@1013_444@BODY_FOOTER"
msgstr "{EventHouse.Name} solicita o corpo de {EventHero.Name} para que possam enterrar <<P:EventHero>> em sua própria cripta."

msgid "STORY_EVENT@1013_444@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} de {EventHouse.Name} tem um pedido para você em relação ao herói falecido <<o:EventHouseLord>> {EventHero.Name}, que está descansando em sua {GLOBAL.CryptConcept}."

msgid "STORY_EVENT@1013_444@BODY_LORE"
msgstr "\"Nós confiamos nosso amado {EventHero.Name} a você, e agora <<p:EventHero>> morreu uma morte de herói sob seu comando. Por favor, permita-nos levar <<P:EventHero>> para casa para que <<p:EventHero>> possa descansar com <<o:EventHero>> ancestrais.\""

msgid "STORY_EVENT@1013_444@BUTTON_0"
msgstr "Entregar o corpo de {EventHero.Name} para {EventHouse.Name}."

msgid "STORY_EVENT@1013_444@BUTTON_1"
msgstr "\"{EventHero.FirstName} ficará aqui.\""

msgid "STORY_EVENT@1013_444@TITLE"
msgstr "Jornada Final para Casa"

msgid "STORY_EVENT@1013_445@BODY_FOOTER"
msgstr "{EventHouse.Name} pede que você realize rituais funerários especiais que significam que {EventHero.Name} nunca poderá ser ressuscitado."

msgid "STORY_EVENT@1013_445@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} de {EventHouse.Name} tem um pedido em relação ao <<o:EventHouseLord>> herói falecido {EventHero.Name}, que está descansando em seu {GLOBAL.CryptConcept}."

msgid "STORY_EVENT@1013_445@BODY_LORE"
msgstr "\"Estamos em profundo luto por {EventHero.Name}, mas acreditamos firmemente que os mortos devem descansar para sempre. Nós de {EventHouse.Name} compartilhamos a tradição de realizar rituais funerários que garantem que nenhuma necromancia possa manchar nossos [hyperlink,GLOBAL.SoulsLoreConcept]irmãos caídos[/hyperlink] em sua jornada pelo além. Pedimos humildemente que você honre essa tradição e conduza o ritual para {EventHero.Name}, que serviu tão bem a você.\""

msgid "STORY_EVENT@1013_445@BUTTON_0"
msgstr "Realize os rituais funerários [mana/] e envie {EventHero} para {EventHouse}."

msgid "STORY_EVENT@1013_445@BUTTON_1"
msgstr "Entregue <<G:body^n,EventHero>> a {EventHouse.Name}, onde eles realizarão os rituais."

msgid "STORY_EVENT@1013_445@BUTTON_2"
msgstr "\"Não posso realizar esses rituais para {EventHero.Name}.\""

msgid "STORY_EVENT@1013_445@BUTTON_3"
msgstr "\"Mortais tolos. Permitam-me educá-los sobre as bênçãos da não-morte.\""

msgid "STORY_EVENT@1013_445@TITLE"
msgstr "Rituais Funerários"

msgid "STORY_EVENT@1013_446@BODY_FOOTER"
msgstr "Você deixa o assustado {EventStackLeader.Name} e outras criaturas irem, ou os ataca mesmo assim?"

msgid "STORY_EVENT@1013_446@BODY_HEADER"
msgstr "Suas tropas enfrentam o {EventStackLeader.Name} e <<o:EventStackLeader>> servos, mas eles se encolhem de medo em vez de lutar."

msgid "STORY_EVENT@1013_446@BODY_LORE"
msgstr "A maioria deles tenta se esconder, enquanto outros se aglomeram no chão. Eles parecem estar implorando por misericórdia através de assobios e gritos em pânico."

msgid "STORY_EVENT@1013_446@BUTTON_0"
msgstr "Atacar! [evilact/]"

msgid "STORY_EVENT@1013_446@BUTTON_1"
msgstr "Deixe-os ir. [goodact/]"

msgid "STORY_EVENT@1013_446@TITLE"
msgstr "Lutar ou Fugir"

msgid "STORY_EVENT@1013_449@BODY_FOOTER"
msgstr "Animais selvagens e famintos ameaçam as fronteiras de {EventCity.Name}."

msgid "STORY_EVENT@1013_449@BODY_HEADER"
msgstr "Seus aldeões de {EventCity.Name} relatam avistamentos preocupantes..."

msgid "STORY_EVENT@1013_449@BODY_LORE"
msgstr "\"Bestas, meu {PlayerLeader.Title}! Nós as vimos espreitando na escuridão e encontramos gado morto em nossos campos. Essas bestas são movidas pela fome e quase levaram o filho do pedreiro quando ele foi para a floresta! Se não fizermos algo, elas certamente atacarão nossas casas a seguir! Pense nas crianças, meu {Player.Title}. Pense no filho do pedreiro!\""

msgid "STORY_EVENT@1013_449@BUTTON_0"
msgstr "\"Envenene um pouco de comida [food/] e deixe para os animais nos campos.\""

msgid "STORY_EVENT@1013_449@BUTTON_1"
msgstr "\"Envenene comida suficiente [food/] para afastá-los de volta ao seu {EventSpawner}.\""

msgid "STORY_EVENT@1013_449@BUTTON_2"
msgstr "\"Deixe-os vir, não temos medo de algumas bestas famintas.\""

msgid "STORY_EVENT@1013_449@TITLE"
msgstr "Espreitando nas Terras Selvagens"

msgid "STORY_EVENT@1013_450@BODY_FOOTER"
msgstr "Como você deseja celebrar essa conquista frutífera?"

msgid "STORY_EVENT@1013_450@BODY_HEADER"
msgstr "A colheita no domínio de sua cidade {EventCity.Name} foi abundante este ano."

msgid "STORY_EVENT@1013_450@BODY_LORE"
msgstr "A cidade é bem conhecida por sua impressionante agricultura, e agora superou a si mesma. Barracas de comida transformam a praça principal em um labirinto cheio de aromas e sabores, enquanto crianças desfilam pelas ruas com cestas cheias da última colheita. Não há dúvida de que todos os outros governantes estão maravilhados com essa demonstração de prosperidade."

msgid "STORY_EVENT@1013_450@BUTTON_0"
msgstr "Vender [gold/] o excedente da colheita deste ano."

msgid "STORY_EVENT@1013_450@BUTTON_1"
msgstr "Doar os excedentes da colheita deste ano para as famílias mais pobres. [goodact/]"

msgid "STORY_EVENT@1013_450@BUTTON_2"
msgstr "Homenagear os trabalhadores de {EventCity.Name} [happiness/] pelo trabalho árduo."

msgid "STORY_EVENT@1013_450@BUTTON_3"
msgstr "Realizar festas luxuosas para os Lordes menores [influence/] neste reino."

msgid "STORY_EVENT@1013_450@TITLE"
msgstr "Festival da Colheita"

msgid "STORY_EVENT@1013_451@BODY_FOOTER"
msgstr "{EventHero.FirstName} congela quando um grito ensurdecedor ecoa pela caverna e o mesmo {EnemyUnit.Name} sedento de sangue emerge da escuridão, <<o:EnemyUnit>> olhos raivosos fixos em {EventHero.FirstName}."

msgid "STORY_EVENT@1013_451@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Você congela quando um grito ensurdecedor ecoa pela caverna e o mesmo {EnemyUnit.Name} sedento de sangue emerge da escuridão, <<o:EnemyUnit>> olhos raivosos fixos em você..."

msgid "STORY_EVENT@1013_451@BODY_HEADER"
msgstr "Ao se aproximar da caverna, <<p:EventHero>> sente cheiro de sangue fresco, mas não encontra sinais de vida."

msgid "STORY_EVENT@1013_451@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Ao se aproximar da caverna, você sente cheiro de sangue fresco, mas não encontra sinais de vida."

msgid "STORY_EVENT@1013_451@BODY_LORE"
msgstr "Ao entrar na caverna, {EventHero.FirstName} e <<o:EventHero>> companheiros encontram os restos de uma luta brutal. A carcaça de um {EventUnit.Name} adulto está ao lado de sua prole; os dois parecem ter sido emboscados em um local que deveria ser um refúgio seguro. Ao inspecionar mais de perto, parece que os animais foram atacados violentamente por um {EnemyUnit.Name} selvagem."

msgid "STORY_EVENT@1013_451@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Ao entrar na caverna, você e seus companheiros encontram os restos de uma luta brutal. A carcaça de um {EventUnit.Name} adulto está ao lado de sua prole; os dois parecem ter sido emboscados em um local que deveria ser um refúgio seguro. Ao inspecionar mais de perto, parece que os animais foram atacados violentamente por um {EnemyUnit.Name} selvagem."

msgid "STORY_EVENT@1013_451@BUTTON_0"
msgstr "\"Não há tempo a perder! Ataque!\""

msgid "STORY_EVENT@1013_451@BUTTON_1"
msgstr "Tente acalmar o {EnemyUnit.Name} enlouquecido antes de derrotá-lo."

msgid "STORY_EVENT@1013_451@BUTTON_2"
msgstr "Alimente a besta [food/] até ela mal conseguir se mover, então ataque."

msgid "STORY_EVENT@1013_451@BUTTON_3"
msgstr "Fugir."

msgid "STORY_EVENT@1013_451@TITLE"
msgstr "Caverna de Carnificina"

msgid "STORY_EVENT@1013_452@BODY_FOOTER"
msgstr "Um jovem {EventUnit.Name} sobreviveu à carnificina na {EventStructure.Name} e se agarrou a {EventHero.FirstName}."

msgid "STORY_EVENT@1013_452@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Um jovem {EventUnit.Name} sobreviveu à carnificina na {EventStructure.Name} e se agarrou a você."

msgid "STORY_EVENT@1013_452@BODY_HEADER"
msgstr "A ameaça selvagem foi eliminada e {EventHero.Name} tem a oportunidade de explorar a caverna."

msgid "STORY_EVENT@1013_452@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "A ameaça selvagem foi eliminada e você tem a oportunidade de explorar a caverna."

msgid "STORY_EVENT@1013_452@BODY_LORE"
msgstr "{EventHero.FirstName} ordena que os corpos do {EventUnit} e sua prole sejam removidos. Enquanto outros vão levantar o animal pesado, algo geme suavemente debaixo dele — e um jovem {EventUnit.Name} emerge, o único sobrevivente da matilha. Parece que o corpo de sua mãe o protegeu de danos. Ele olha para {EventHero.Name} e geme novamente."

msgid "STORY_EVENT@1013_452@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Você ordena que os corpos do {EventUnit} e sua prole sejam removidos. Enquanto outros vão levantar o animal pesado, algo geme suavemente debaixo dele — e um jovem {EventUnit.Name} emerge, o único sobrevivente da matilha. Parece que o corpo de sua mãe o protegeu de danos. Ele olha para você e geme novamente."

msgid "STORY_EVENT@1013_452@BUTTON_0"
msgstr "Mantenha o {EventUnit.Name} e crie-o como sua montaria. [mount/]"

msgid "STORY_EVENT@1013_452@BUTTON_1"
msgstr "Cuide do {EventUnit.Name} até ele ficar forte e o solte na natureza. [goodact/]"

msgid "STORY_EVENT@1013_452@BUTTON_2"
msgstr "A pele deste {EventUnit} seria perfeita para um {EventItem.Name} [item/] muito bom..."

msgid "STORY_EVENT@1013_452@TITLE"
msgstr "Caverna de Carnificina: Consequências"

msgid "STORY_EVENT@1013_457@BODY_FOOTER"
msgstr "Você é convidado a celebrar o aniversário de {EventHouseLord.Name}. Que presente você levará?"

msgid "STORY_EVENT@1013_457@BODY_HEADER"
msgstr "Você recebe um convite oficial do amigável {EventHouseLord.Title} de {EventHouse.Name}."

msgid "STORY_EVENT@1013_457@BODY_LORE"
msgstr "\"O grande {PlayerLeader.TitleName}! Nós de {EventHouse.Name} humildemente convidamos você a participar da celebração do aniversário do nosso {EventHouseLord.TitleName}. Seria uma honra se você comparecesse, e ansiamos pelo seu presente.\""

msgid "STORY_EVENT@1013_457@BUTTON_0"
msgstr "Ordene seus melhores artistas [gold/] para pintar um retrato lisonjeiro de {EventHouseLord.TitleName}."

msgid "STORY_EVENT@1013_457@BUTTON_1"
msgstr "Um pequeno mimo [gold/] será suficiente."

msgid "STORY_EVENT@1013_457@BUTTON_2"
msgstr "Presenteie o {EventHouseLord.Title} com uma besta domesticada da terra natal dos {PlayerRace.Name}."

msgid "STORY_EVENT@1013_457@BUTTON_3"
msgstr "Dê uma desculpa para não participar da celebração."

msgid "STORY_EVENT@1013_457@BUTTON_4"
msgstr "\"Meu presente é permitir que {EventHouseLord.TitleName} viva mais um dia.\" [evilact/]"

msgid "STORY_EVENT@1013_457@TITLE"
msgstr "Celebração de Aniversário"

msgid "STORY_EVENT@1013_462@BODY_FOOTER"
msgstr "\"Peço que você gentilmente me empreste seus cozinheiros, para ensinar meu povo a fazer uma refeição decente.\""

msgid "STORY_EVENT@1013_462@BODY_HEADER"
msgstr "{EventHouseLord.Name} de {EventHouse.Name} tem uma pergunta sobre sua <<gu:cuisine^n,EventRace>>."

msgid "STORY_EVENT@1013_462@BODY_LORE"
msgstr "\"Ouvimos histórias sobre as iguarias feitas pelos {EventRace.Name}. Aperitivos deliciosos, assados dignos de uma canção, sobremesas para morrer de tanto apreciar... Enquanto isso, eu estou aqui, comendo pão seco e carne crua, porque meus cozinheiros não sabem fazer uma refeição decente. Isso não pode continuar. Os {EventHouseRace.Name} devem ser educados nas artes culinárias!\""

msgid "STORY_EVENT@1013_462@BUTTON_0"
msgstr "\"Muito bem. Chefs [food/] de {EventCity.Name} instruirão os seus por um tempo.\""

msgid "STORY_EVENT@1013_462@BUTTON_1"
msgstr "Que oportunidade perfeita para envenenar os cidadãos de {EventHouse.Name}... [evilact/]"

msgid "STORY_EVENT@1013_462@BUTTON_2"
msgstr "\"Tenho meu próprio povo para alimentar...\""

msgid "STORY_EVENT@1013_462@BUTTON_3"
msgstr "\"Proponho um acordo. Seus construtores [structureprod/] pelos meus chefs [food/].\""

msgid "STORY_EVENT@1013_462@TITLE"
msgstr "Curiosidade Culinária"

msgid "STORY_EVENT@1013_463@BODY_FOOTER"
msgstr "{EventHouseLord.TitleName} se curva. \"Curvo-me perante sua expertise arcana, meu {PlayerLeader.Title}, e humildemente peço que seus estudiosos instruam os meus.\""

msgid "STORY_EVENT@1013_463@BODY_HEADER"
msgstr "{EventHouseLord.Name} de {EventHouse.Name} ouviu falar do seu progresso em educação e conhecimento."

msgid "STORY_EVENT@1013_463@BODY_LORE"
msgstr "\"Toda vez que ouço falar de {EventCity.Name}, fico impressionado com suas mais recentes descobertas arcanas. Parece que vocês estão avançando a passos largos, enquanto nós ainda engatinhamos como bebês recém-nascidos. Você, o brilhante {PlayerLeader.TitleName}, estaria interessado em educar meu povo, para que possamos segui-lo neste caminho do conhecimento?\""

msgid "STORY_EVENT@1013_463@BUTTON_0"
msgstr "\"O conhecimento deve ser compartilhado. Estudiosos de {EventCity.Name} [knowledge/] iluminarão os seus.\""

msgid "STORY_EVENT@1013_463@BUTTON_2"
msgstr "\"Preciso de todos os meus estudiosos ao meu lado...\""

msgid "STORY_EVENT@1013_463@BUTTON_3"
msgstr "\"Eu pessoalmente o tutoriarei, {EventHouseLord.TitleName}.\""

msgid "STORY_EVENT@1013_463@BUTTON_4"
msgstr "\"Estudiosos de {EventCity.Name} [knowledge/] iluminarão os seus, por uma taxa.\" [gold/]"

msgid "STORY_EVENT@1013_463@TITLE"
msgstr "Compartilhamento de Conhecimento"

msgid "STORY_EVENT@1013_465@BODY_FOOTER"
msgstr "\"Certamente colocaria os cidadãos de {EventHouse.Name} à vontade se vissem o grande {PlayerLeader.Title} que você é.\""

msgid "STORY_EVENT@1013_465@BODY_HEADER"
msgstr "Seu apoiador, {EventHouseLord.Name} de {EventHouse.Name}, pondera sobre seus laços diplomáticos."

msgid "STORY_EVENT@1013_465@BODY_LORE"
msgstr "\"Foi uma honra conhecê-lo, ó {PlayerLeader.Title}. {EventCity.Name} se banha em sua glória. No entanto, ainda há aqueles que questionam nosso vínculo com você. Alguns dos meus cidadãos estão... desconfiados de você. Minha palavra sozinha não é suficiente para convencê-los.\""

msgid "STORY_EVENT@1013_465@BUTTON_0"
msgstr "Use sua influência [influence/] para se promover em {EventHouse.Name}."

msgid "STORY_EVENT@1013_465@BUTTON_2"
msgstr "Faça um discurso eloquente para encantar {EventHouse.Name}."

msgid "STORY_EVENT@1013_465@BUTTON_3"
msgstr "\"Não é minha responsabilidade convencer seu povo.\""

msgid "STORY_EVENT@1013_465@BUTTON_4"
msgstr "Envie um presente considerável [gold/] para {EventHouse.Name} para apaziguar os cidadãos."

msgid "STORY_EVENT@1013_465@TITLE"
msgstr "Laços e Benevolência"

msgid "STORY_EVENT@1013_466@BODY_FOOTER"
msgstr "{EventHouseLord.Name} olha para você, com a mandíbula cerrada e levemente trêmula. \"Os outros não ousam desafiá-lo, meu {PlayerLeader.Title}... mas eu o farei!\""

msgid "STORY_EVENT@1013_466@BODY_HEADER"
msgstr "O crítico {EventHouseLord.Name} de {EventHouse.Name} está diante de você, desafiadoramente."

msgid "STORY_EVENT@1013_466@BODY_LORE"
msgstr "\"{PlayerLeader.TitleName}. Por muito tempo, as boas pessoas deste reino se curvaram a você. Nunca mais! Não mais seremos enganados ou intimidados por você. {EventHouse.Name} resistirá à calamidade que você lança sobre este reino!\""

msgid "STORY_EVENT@1013_466@BUTTON_0"
msgstr "\"Se você quer uma guerra com um {PlayerLeader.Title}, que assim seja!\""

msgid "STORY_EVENT@1013_466@BUTTON_1"
msgstr "Tente consertar suas relações diplomáticas [influence/] com {EventHouseLord.Name}."

msgid "STORY_EVENT@1013_466@BUTTON_2"
msgstr "\"Lembre-se de que você está falando com um {PlayerLeader.Title}. Cuidado com seu tom, {EventHouseLord.Title}\""

msgid "STORY_EVENT@1013_466@TITLE"
msgstr "Desafio Ousado"

msgid "STORY_EVENT@1013_467@BODY_FOOTER"
msgstr "\"Por favor, compartilhe um pouco de sua sabedoria arquitetônica comigo, para que eu possa proteger meus cidadãos!\""

msgid "STORY_EVENT@1013_467@BODY_HEADER"
msgstr "{EventHouseLord.Name} aparece diante de você, preocupado com as defesas de {EventHouse.Name}."

msgid "STORY_EVENT@1013_467@BODY_LORE"
msgstr "\"{PlayerLeader.TitleName}, há muito tempo estou impressionado com suas façanhas de construção e humildemente peço sua ajuda. Meus planos de construção sofreram alguns atrasos e agora <<g:defenses^p,EventHouse>> estão ficando para trás. Com as tensões crescentes no reino, temo que minha cidade não resista a um cerco, caso tal coisa aconteça.\""

msgid "STORY_EVENT@1013_467@BUTTON_0"
msgstr "\"Meus construtores [structureprod/] de {EventCity.Name} apoiarão os seus por um tempo.\""

msgid "STORY_EVENT@1013_467@BUTTON_1"
msgstr "\"Eu pessoalmente ajudarei você com suas defesas.\""

msgid "STORY_EVENT@1013_467@BUTTON_3"
msgstr "\"Meus construtores [structureprod/] ajudarão você, pelo tributo certo [gold/].\""

msgid "STORY_EVENT@1013_467@BUTTON_4"
msgstr "\"Você admite sua fraqueza. Um erro tolo. Reúna as tropas!\" [evilact/]"

msgid "STORY_EVENT@1013_467@BUTTON_5"
msgstr "\"Não compartilharei os segredos das minhas defesas com você.\""

msgid "STORY_EVENT@1013_467@TITLE"
msgstr "Defesas em Decadência"

msgid "STORY_EVENT@1013_468@BODY_FOOTER"
msgstr "\"Eu imploro, meu {PlayerLeader.Title}. Empreste-me um pouco da sua sabedoria para salvar {EventHouse.Name} de uma revolta.\""

msgid "STORY_EVENT@1013_468@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da maligna {EventHouse.Name} está em um humor sombrio."

msgid "STORY_EVENT@1013_468@BODY_LORE"
msgstr "\"Não entendo, {PlayerLeader.TitleName}!\" <<cp:EventHouseLord>> diz. \"Pensei que estava fazendo tudo certo. Enforquei aqueles que semearam a discórdia, banir aqueles que falavam mal de mim. E ainda assim, meus cidadãos ficam cada vez mais furiosos a cada dia. Eles estão aos portões do meu castelo, gritando sobre tirania. Mas você, meu {PlayerLeader.Title}... Todos te respeitam.\""

msgid "STORY_EVENT@1013_468@BUTTON_0"
msgstr "\"Meus enviados [influence/] ajudarão a melhorar seu legado.\""

msgid "STORY_EVENT@1013_468@BUTTON_1"
msgstr "\"Convencer as pessoas requer trabalho duro e sacrifício, não forcas e banimentos.\" [goodact/]"

msgid "STORY_EVENT@1013_468@BUTTON_2"
msgstr "\"Preciso focar no meu povo. Você deveria fazer o mesmo.\""

msgid "STORY_EVENT@1013_468@TITLE"
msgstr "Busca pela Felicidade"

msgid "STORY_EVENT@1013_469@BODY_FOOTER"
msgstr "\"Suplico por seu apoio e seria eternamente grato.\""

msgid "STORY_EVENT@1013_469@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} de {EventHouse.Name} parece desesperado."

msgid "STORY_EVENT@1013_469@BODY_LORE"
msgstr "\"Nobre {PlayerLeader.TitleName}, estou arruinado. Eu e meu povo estamos endividados. Meu tesouro está vazio, e meus antigos benfeitores querem meu sangue. Eles tomaram membros da minha família como reféns, fazendo ameaças de mutilação e morte.\""

msgid "STORY_EVENT@1013_469@BUTTON_0"
msgstr "\"Errar é humano. Diga-me quanto [gold/] você precisa.\""

msgid "STORY_EVENT@1013_469@BUTTON_1"
msgstr "\"Vou ajudá-lo a tornar suas terras mais lucrativas.\""

msgid "STORY_EVENT@1013_469@BUTTON_2"
msgstr "\"Sua família pagará as consequências de suas ações.\""

msgid "STORY_EVENT@1013_469@BUTTON_3"
msgstr "\"Seus credores encontrarão um fim doloroso.\""

msgid "STORY_EVENT@1013_469@TITLE"
msgstr "Dívida e Morte"

msgid "STORY_EVENT@1013_482@BODY_FOOTER"
msgstr "Você reconhece as preocupações dos agricultores em relação a <<g:agriculture^n,EventCity.Name>>?"

msgid "STORY_EVENT@1013_482@BODY_HEADER"
msgstr "Seus agricultores de {EventCity.Name} declaram que há um problema com suas colheitas."

msgid "STORY_EVENT@1013_482@BODY_LORE"
msgstr "\" {PlayerLeader.TitleName}, nós agricultores somos seus humildes servos, mas parece que não somos suficientes para sustentar suas ambições. Ouvimos histórias sobre {EventGoldenCity.Name}, onde os pastos são mais verdes e as pessoas têm comida para sempre. Lutamos para alimentar nossos filhos, e lá eles festejam como reis. Por que não podemos viver como eles? Por que não estamos prosperando como eles?\""

msgid "STORY_EVENT@1013_482@BUTTON_0"
msgstr "Melhore [gold/] as ferramentas desses camponeses para garantir melhores colheitas [food/]."

msgid "STORY_EVENT@1013_482@BUTTON_1"
msgstr "Prometa [influence/] designar trabalhadores temporários [population/] para os campos."

msgid "STORY_EVENT@1013_482@BUTTON_2"
msgstr "Consulte seu conhecimento para aumentar a qualidade das colheitas."

msgid "STORY_EVENT@1013_482@BUTTON_3"
msgstr "Ignore suas preocupações."

msgid "STORY_EVENT@1013_482@TITLE"
msgstr "Pastos Mais Verdes"

msgid "STORY_EVENT@1013_483@BODY_FOOTER"
msgstr "Parece que {EventCity.Name} e seu império se tornaram motivo de risada em relação ao nível de educação."

msgid "STORY_EVENT@1013_483@BODY_HEADER"
msgstr "Um membro do conselho da sua cidade {EventCity.Name} se aproxima de você, acenando com um panfleto."

msgid "STORY_EVENT@1013_483@BODY_LORE"
msgstr "\"Recebemos este panfleto de {EventGoldenCity.Name}, meu {PlayerLeader.Title}! Levou um tempo para decifrar, mas acredito que estão rindo de nós e nos chamando de idiotas! O que \"dulbert\" significa? Isso é uma palavra? Não podemos simplesmente deixar que nos insultem assim, meu {PlayerLeader.Title}. Deve haver algo que possamos fazer para provar que estão errados...\""

msgid "STORY_EVENT@1013_483@BUTTON_0"
msgstr "Investir [gold/] em educar [knowledge/] os cidadãos de {EventCity.Name}."

msgid "STORY_EVENT@1013_483@BUTTON_1"
msgstr "{EventCity} precisa de escolas. Jure [influence/] para recrutar mais construtores. [production/]"

msgid "STORY_EVENT@1013_483@BUTTON_2"
msgstr "Tutore pessoalmente os cidadãos de {EventCity.Name} por um tempo."

msgid "STORY_EVENT@1013_483@BUTTON_3"
msgstr "Não se envolver."

msgid "STORY_EVENT@1013_483@TITLE"
msgstr "Insulto Eloquente"

msgid "STORY_EVENT@1013_484@BODY_FOOTER"
msgstr "Como você gostaria que o vencedor o servisse?"

msgid "STORY_EVENT@1013_484@BODY_HEADER"
msgstr "Um torneio local está sendo realizado em sua cidade {EventCity.Name}."

msgid "STORY_EVENT@1013_484@BODY_LORE"
msgstr "A cidade é bem conhecida por sua proeza militar local, e isso se mostra. Vivas ecoam pelas ruas enquanto os concorrentes se enfrentam na praça da cidade. Embora cada rodada seja inofensiva por natureza, os duelos ficam mais sérios à medida que a vitória se aproxima. Eventualmente, um concorrente, um {EventUnit.Name}, ajoelha-se diante de você, muito machucado, mas vitorioso!"

msgid "STORY_EVENT@1013_484@BUTTON_0"
msgstr "O vencedor será seu gladiador. Como patrono, você reclama os despojos [gold/]!"

msgid "STORY_EVENT@1013_484@BUTTON_1"
msgstr "Contrate o vencedor para instruir recrutas [unitprod/] nas artes da batalha."

msgid "STORY_EVENT@1013_484@BUTTON_2"
msgstr "Parabenize e elogie o vencedor [happiness/] pela vitória bem merecida de <<o:EventUnit>>."

msgid "STORY_EVENT@1013_484@BUTTON_3"
msgstr "Permita que o {EventUnit.Name} vencedor [unit/] junte-se ao seu exército."

msgid "STORY_EVENT@1013_484@TITLE"
msgstr "Pão e Circo"

msgid "STORY_EVENT@1013_487@BODY_FOOTER"
msgstr "O que você dirá para encerrar o argumento crescente entre {EventHouseLord.TitleName} e {EventHouseBLord.TitleName}?"

msgid "STORY_EVENT@1013_487@BODY_HEADER"
msgstr "Durante negociações diplomáticas, {EventHouseLord.TitleName} de {EventHouse} convida você e {EventHouseBLord.TitleName} de {EventHouseB} para uma noite de conversa amigável."

msgid "STORY_EVENT@1013_487@BODY_LORE"
msgstr "À medida que a noite avança, {EventHouseLord} e {EventHouseBLord} começam a discutir.[br/]\"O {GLOBAL.AstralSeaLoreConcept.Hyperlink} é um plano plano, seu idiota!\" {EventHouseLord.FirstName} grita, gesticulando selvagemente.[br/][br/]\"Não, ele se comporta como uma esfera, estendendo-se em todas as direções!\" {EventHouseBLord.FirstName} bate <<o:EventHouseBLord>> as mãos na mesa.[br/][br/]Então, ambos se voltam para você, esperando que um {PlayerLeader.Title} resolva sua discussão."

msgid "STORY_EVENT@1013_487@BUTTON_0"
msgstr "\"{EventHouseLord.Name} está certo. O Mar Astral é plano.\""

msgid "STORY_EVENT@1013_487@BUTTON_1"
msgstr "\"{EventHouseBLord.Name} faz um argumento convincente. Parece mais uma esfera.\""

msgid "STORY_EVENT@1013_487@BUTTON_3"
msgstr "Apelar para a amizade deles [influence/] para acalmar o debate."

msgid "STORY_EVENT@1013_487@BUTTON_4"
msgstr "Lance uma projeção do Mar Astral que seja plana E esférica."

msgid "STORY_EVENT@1013_487@TITLE"
msgstr "Debate Aquecido"

msgid "STORY_EVENT@1013_488@BODY_FOOTER"
msgstr "{EventHero.FirstName} oferece a você o {EventItem}. \"Peguei a arma para você, meu {PlayerLeader.Title}, para ajudá-lo a obter a vitória!\""

msgid "STORY_EVENT@1013_488@BODY_HEADER"
msgstr "Antes de retomar as negociações diplomáticas, {EventHouseLord.TitleName} de {EventHouse.Name} acusa um dos seus [hyperlink,GLOBAL.HeroConcept]Heróis[/hyperlink]. \"{EventHero.Name} roubou meu cobiçado {EventItem.Name}!\""

msgid "STORY_EVENT@1013_488@BODY_LORE"
msgstr "{EventHouseLord.TitleName} está furioso. \"Eu não acusaria ninguém de roubo sem provas, meu {PlayerLeader.Title}. Mas dois dos meus servos pegaram {EventHero.Name} no ato! Confio em seu julgamento e espero que a arma seja devolvida a mim imediatamente.\"[br/][br/]Ao ser questionado, {EventHero.FirstName} admite imediatamente o roubo sem nenhum arrependimento."

msgid "STORY_EVENT@1013_488@BUTTON_0"
msgstr "{EventHero.Name} está certo. Guarde o {EventItem.Name}. [item/]"

msgid "STORY_EVENT@1013_488@BUTTON_1"
msgstr "Venda secretamente [gold/] o {EventItem.Name} antes que {EventHouseLord.Name} o acuse ainda mais."

msgid "STORY_EVENT@1013_488@BUTTON_2"
msgstr "Devolva uma falsificação do {EventItem.Name} para {EventHouse.Name}. Guarde o original. [item/]"

msgid "STORY_EVENT@1013_488@BUTTON_3"
msgstr "Faça {EventHero} se desculpar formalmente [happiness/]. {EventHouse.Name} recebe o {EventItem.Name}."

msgid "STORY_EVENT@1013_488@BUTTON_4"
msgstr "Devolva a arma e envie {EventHero.Name} para {EventHouse.Name} para ser punido."

msgid "STORY_EVENT@1013_488@TITLE"
msgstr "Dedos Pegajosos"

msgid "STORY_EVENT@1013_489@BODY_FOOTER"
msgstr "<<Cp:EventStackLeader>> gesticula para você. \"Gostaria de tocar uma música?\""

msgid "STORY_EVENT@1013_489@BODY_HEADER"
msgstr "As tropas de {EventHouse.Name} estacionadas no {EventStructure.Name} estão ouvindo uma apresentação musical."

msgid "STORY_EVENT@1013_489@BODY_LORE"
msgstr "As suaves melodias da música chegam aos ouvidos de {EventHero.Name} quando <<p:EventHero>> se aproxima. Um {EventStackLeader.Name} olha para cima e se aproxima. \"Por favor, fique conosco por um tempo. Estávamos apenas desfrutando de algumas melodias doces tocadas por nossos amigos altamente talentosos. Você serve a {PlayerLeader.TitleName}, não é? Um {PlayerLeader.Title} que conhece algo de cultura! Por favor, me diga. Você também é habilidoso nas artes musicais?\""

msgid "STORY_EVENT@1013_489@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "As suaves melodias da música chegam aos seus ouvidos quando você se aproxima. Um {EventStackLeader.Name} olha para cima e se aproxima de você. \"Por favor, fique conosco por um tempo. Estávamos apenas desfrutando de algumas melodias doces tocadas por nossos amigos altamente talentosos. Você é {PlayerLeader.TitleName}, não é? Um {PlayerLeader.Title} que conhece algo de cultura! Por favor, me diga. Você também é refinado nas artes musicais?\""

msgid "STORY_EVENT@1013_489@BUTTON_1"
msgstr "\"O {EventHouseLord.TitleName} concordará [influence/] em deixar este local para mim.\""

msgid "STORY_EVENT@1013_489@BUTTON_2"
msgstr "\"Minha música vai te levar às lágrimas. Em troca, você me concederá o {EventStructure}.\""

msgid "STORY_EVENT@1013_489@BUTTON_3"
msgstr "\"Os únicos instrumentos que toco são os tambores de guerra! Atacar!\""

msgid "STORY_EVENT@1013_489@BUTTON_4"
msgstr "\"Estamos apenas apreciando a música. Por favor, continue...\""

msgid "STORY_EVENT@1013_489@TITLE"
msgstr "Melodias Doces"

msgid "STORY_EVENT@1013_490@BODY_FOOTER"
msgstr "\"Sei que deveríamos estar guardando este local, mas você é gente boa, certo? Tome uma bebida!\""

msgid "STORY_EVENT@1013_490@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "\"Sei que deveríamos estar guardando este local... mas você entende, certo, {PlayerLeader.Title}? Tome uma bebida!\""

msgid "STORY_EVENT@1013_490@BODY_HEADER"
msgstr "As tropas de {EventHouse.Name} estão dançando ao redor do {EventStructure.Name} e mal percebem a aproximação de {EventHero.Name}."

msgid "STORY_EVENT@1013_490@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "As tropas de {EventHouse.Name} estão dançando ao redor do {EventStructure.Name} e mal percebem sua aproximação."

msgid "STORY_EVENT@1013_490@BODY_LORE"
msgstr "As tropas deveriam guardar o {EventStructure.Name}, mas em vez disso estão celebrando. \"Nosso general se casou, então temos o dia de folga\", diz o {EventStackLeader.Name} quando {EventHero.FirstName} pergunta sobre o comportamento deles. \"Bem, ele não nos deu realmente o dia de folga... mas tomamos a iniciativa e tiramos folga mesmo assim. Junte-se a nós!\""

msgid "STORY_EVENT@1013_490@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "As tropas deveriam guardar o {EventStructure.Name}, mas em vez disso estão celebrando. \"Nosso general se casou, então temos o dia de folga\", diz o {EventStackLeader.Name} quando você pergunta sobre o comportamento deles. \"Bem, ele não nos deu realmente o dia de folga... mas tomamos a iniciativa e tiramos folga mesmo assim. Junte-se a nós!\""

msgid "STORY_EVENT@1013_490@BUTTON_0"
msgstr "\"Seu {EventHouseLord.Title} não se importará [influence/] se você tirar ainda mais tempo de folga.\""

msgid "STORY_EVENT@1013_490@BUTTON_1"
msgstr "{EventHero.Name} junta-se à festa para enganá-los a desistir do {EventStructure}..."

msgid "STORY_EVENT@1013_490@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "Junte-se às festividades para enganá-los a assinar a transferência do local para você..."

msgid "STORY_EVENT@1013_490@BUTTON_2"
msgstr "\"Neste estado distraído, eles serão presas fáceis! Atacar!\""

msgid "STORY_EVENT@1013_490@BUTTON_3"
msgstr "\"Estaremos a caminho, divirta-se...\""

msgid "STORY_EVENT@1013_490@TITLE"
msgstr "Trabalhe duro, festeje duro"

msgid "STORY_EVENT@1013_510@BODY_FOOTER"
msgstr "Os batedores de {EventHero.FirstName} encontraram um ponto fraco escondido nas fundações da cidade. O que <<p:EventHero>> faz com a informação?"

msgid "STORY_EVENT@1013_510@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Seus batedores encontraram um ponto fraco escondido nas fundações da cidade. Você quer usar isso a seu favor?"

msgid "STORY_EVENT@1013_510@BODY_HEADER"
msgstr "Durante o cerco a {EventCity.Name} liderado pelo seu [hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink] {EventHero.Name}, <<o:EventHero>> os batedores retornam com notícias emocionantes."

msgid "STORY_EVENT@1013_510@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Durante o cerco a {EventCity.Name}, seus batedores retornam com notícias emocionantes."

msgid "STORY_EVENT@1013_510@BODY_LORE"
msgstr "\"Encontramos uma fraqueza na parede sul, meu {EventHero.Title},\" o batedor proclama orgulhosamente, após recuperar o fôlego. \"Suas fundações estão desmoronando e mal estão sendo sustentadas. Tudo o que precisamos é de algum esforço concentrado para virar o jogo - e a parede - a nosso favor!\""

msgid "STORY_EVENT@1013_510@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "\"Encontramos uma fraqueza na parede sul, meu {PlayerLeader.Title},\" o batedor proclama orgulhosamente, após recuperar o fôlego. \"Suas fundações estão desmoronando e mal estão sendo sustentadas. Tudo o que precisamos é de algum esforço concentrado para virar o jogo - e a parede - a nosso favor!\""

msgid "STORY_EVENT@1013_510@BUTTON_0"
msgstr "\"Coloque um esforço extra [structureprod/] no ataque a essas defesas enfraquecidas!\""

msgid "STORY_EVENT@1013_510@BUTTON_1"
msgstr "\"Com alguns ataques de precisão bem colocados, podemos romper...\""

msgid "STORY_EVENT@1013_510@BUTTON_2"
msgstr "\"Continuaremos como antes.\""

msgid "STORY_EVENT@1013_510@TITLE"
msgstr "Fundações Instáveis"

msgid "STORY_EVENT@1013_514@BODY_FOOTER"
msgstr "\"Nossa relutância em obedecer nos forçou a esta vida de selvageria,\" os desertores reclamam, \"mas lutaremos pelo que é certo e sobreviveremos, até mesmo reclamaremos {EventCity.Name} se for necessário!\""

msgid "STORY_EVENT@1013_514@BODY_HEADER"
msgstr "Um grupo de {EventRace.Name}, que são desertores, reclamaram uma área perto de {EventCity.Name} e agora estão ameaçando seus cidadãos!"

msgid "STORY_EVENT@1013_514@BODY_LORE"
msgstr "Eles roubam de aldeias ao redor de {EventCity.Name} e despojam viajantes que entram em seu \"território\". Apesar disso, agora professam um amor pela paz.[br/][br/]\"Deixem suas armas. Não queremos causar dano! Nós nos recusamos a lutar em guerras sem esperança, e agora somos evitados por onde vamos. Mas lutaremos por uma causa justa - nossa liberdade!\""

msgid "STORY_EVENT@1013_514@BUTTON_0"
msgstr "Ajude o grupo invasor a encontrar refúgio em {EventCity.Name}, apesar do protesto público [happiness/]. [goodact/]"

msgid "STORY_EVENT@1013_514@BUTTON_1"
msgstr "Permita que todos os desertores dispostos de {EventSpawner.Name} vivam em {EventCity.Name}, perturbando a população [happiness/]. [goodact/]"

msgid "STORY_EVENT@1013_514@BUTTON_2"
msgstr "\"Não tememos nem temos simpatia por desertores que ameaçam {EventCity.Name}.\""

msgid "STORY_EVENT@1013_514@BUTTON_3"
msgstr "Ordene que sua guarnição [unitprod/] caça o grupo que ameaça {EventCity.Name} diretamente."

msgid "STORY_EVENT@1013_514@BUTTON_4"
msgstr "Prometa a todos os desertores dispostos santuário em {EventCity.Name}, então execute-os por seus crimes.[evilact/]"

msgid "STORY_EVENT@1013_514@TITLE"
msgstr "Desertores Evitados"

msgid "STORY_EVENT@1013_515@BODY_FOOTER"
msgstr "O {EventStackLeader.Name} permanece firme diante de seu poder. \"Dê-nos as informações que buscamos, ou teremos que recorrer a medidas mais extremas.\""

msgid "STORY_EVENT@1013_515@BODY_HEADER"
msgstr "Um grupo de bandidos que se chamam de \"aspirantes a viajantes astrais\" estão invadindo suas fronteiras perto de {EventCity.Name}."

msgid "STORY_EVENT@1013_515@BODY_LORE"
msgstr "\"Nós trabalhamos neste reino amaldiçoado tempo suficiente. Estamos procurando uma maneira de sair, e a única maneira segura de fazer isso parece ser através de algo chamado \"[hyperlink,GLOBAL.WorldGateLoreConcept]Portais Mundiais[/hyperlink]\" para o {GLOBAL.AstralSeaLoreConcept.Hyperlink}. Sabemos que você {GLOBAL.GodirLoreConcept.Hyperlink} sabe como construí-los. Queremos esse conhecimento! Tomaremos à força se necessário. Qualquer coisa para chegarmos ao paraíso!\""

msgid "STORY_EVENT@1013_515@BUTTON_0"
msgstr "Conceda a esses \"viajantes\" acesso limitado ao seu conhecimento [knowledge/] para mantê-los ocupados... por enquanto."

msgid "STORY_EVENT@1013_515@BUTTON_1"
msgstr "Permita que esses \"viajantes\" aprendam o que desejam [knowledge/], acalmando o {EventSpawner.Name} por um tempo."

msgid "STORY_EVENT@1013_515@BUTTON_2"
msgstr "Se eles ousarem se aproximar de {EventCity.Name}, conhecerão o verdadeiro custo do conhecimento."

msgid "STORY_EVENT@1013_515@TITLE"
msgstr "Aspirações Astrais"

msgid "STORY_EVENT@1013_516@BODY_FOOTER"
msgstr "Criaturas ameaçam infestar {EventCity.Name} e parecem ser apaziguadas apenas com doces e pastéis."

msgid "STORY_EVENT@1013_516@BODY_HEADER"
msgstr "Um grupo de criaturas liderado por um {EventStackLeader.Name} está ameaçando suas aldeias perto de {EventCity.Name}, movidas por um desejo particular."

msgid "STORY_EVENT@1013_516@BODY_LORE"
msgstr "De acordo com o folclore local, as criaturas caçam os aldeões, a menos que sejam apaziguadas com doces e outros produtos açucarados. Os aldeões recorreram a deixar pilhas de confeitos como oferta nas bordas do império, na esperança de apaziguar o {EventSpawner.Name}, mas parece que os <<g:cravings^p,EventStackLeader>> por doces não são tão facilmente satisfeitos..."

msgid "STORY_EVENT@1013_516@BUTTON_0"
msgstr "Reúna alguns doces [food/] para apaziguar aqueles mais próximos de {EventCity.Name}."

msgid "STORY_EVENT@1013_516@BUTTON_1"
msgstr "Reúna todos os pastéis [food/] que a cidade puder reunir para saciar todo o {EventSpawner.Name} por um tempo."

msgid "STORY_EVENT@1013_516@BUTTON_2"
msgstr "Deixe-os vir, nossa vingança será mais doce que qualquer confeito."

msgid "STORY_EVENT@1013_516@TITLE"
msgstr "Desejos Doces"

msgid "STORY_EVENT@1013_517@BODY_FOOTER"
msgstr "\"Dê brilhantes!\" O {EventStackLeader.Name} ruge, \"ou {EventUnit.Name} come!\" <<o:EventStackLeader>> {EventUnit.Name} fareja e rosna, aproximando-se cada vez mais de {EventCity.Name}."

msgid "STORY_EVENT@1013_517@BODY_HEADER"
msgstr "Um grupo próximo de {EventStackLeader.Name} e <<o:EventStackLeader>> animais de estimação estão se aproximando cada vez mais de {EventCity.Name}, sua cidade."

msgid "STORY_EVENT@1013_517@BODY_LORE"
msgstr "A mensagem do {EventStackLeader.Name} é simples. \"{EventUnit.Name} sente cheiro de brilhantes. Fareja fareja. {EventUnit.Name} encontra. Eu pego. Se os pequenos {EventRace.Name} guardarem brilhantes, {EventUnit.Name} come {EventRace.Name}. Então eu pego.\""

msgid "STORY_EVENT@1013_517@BUTTON_0"
msgstr "Apele para este {EventStackLeader.Name} com algum ouro brilhante [gold/]."

msgid "STORY_EVENT@1013_517@BUTTON_1"
msgstr "Deixe ouro brilhante suficiente [gold/] para que todo o {EventSpawner.Name} fique satisfeito por muito tempo."

msgid "STORY_EVENT@1013_517@BUTTON_2"
msgstr "\"Eu não cedo a demandas mesquinhas como essas. Deixe-os vir.\""

msgid "STORY_EVENT@1013_517@TITLE"
msgstr "Cheiro de Ouro"

msgid "STORY_EVENT@1013_518@BODY_FOOTER"
msgstr "{EventHero.FirstName} se pergunta se <<p:EventHero>> deveria permitir que o ritual de invocação continue ou impedi-lo antes que seja tarde demais."

msgid "STORY_EVENT@1013_518@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Você se pergunta se deveria permitir que o ritual de invocação continue ou impedi-lo antes que seja tarde demais..."

msgid "STORY_EVENT@1013_518@BODY_HEADER"
msgstr "{EventHero.Name} e <<o:EventHero>> comitiva se aproximam do grandioso {EventStructure.Name}, decorado com representações de {GLOBAL.GodirLoreConcept.Hyperlink} de aparência severa."

msgid "STORY_EVENT@1013_518@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você e sua comitiva se aproximam do grandioso {EventStructure.Name}, decorado com representações de {GLOBAL.GodirLoreConcept.Hyperlink} de aparência severa."

msgid "STORY_EVENT@1013_518@BODY_LORE"
msgstr "{EventHero.Name} ouve cantos sinistros vindos de dentro e espia um grupo de figuras encapuzadas realizando algum tipo de ritual. De repente, um grito arrepiante ecoa pelo templo. O grupo está invocando algo... Algo grande e sobrenatural. <<Cg:companions^p,EventHero>> engolem nervosamente enquanto observam, aguardando ordens."

msgid "STORY_EVENT@1013_518@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Você ouve cantos sinistros vindos de dentro e espia um grupo de figuras encapuzadas realizando algum tipo de ritual. De repente, um grito arrepiante ecoa pelo templo. Este grupo está invocando algo... Algo grande e sobrenatural. Seus companheiros engolem nervosamente enquanto observam, aguardando ordens."

msgid "STORY_EVENT@1013_518@BUTTON_0"
msgstr "\"Pare este ritual AGORA! Às armas!\""

msgid "STORY_EVENT@1013_518@BUTTON_1"
msgstr "Atrase o ritual o máximo possível [mana/] e ataque."

msgid "STORY_EVENT@1013_518@BUTTON_2"
msgstr "Partir."

msgid "STORY_EVENT@1013_518@BUTTON_3"
msgstr "\"A fé nos ajudará a adiar essa profanação!\""

msgid "STORY_EVENT@1013_518@BUTTON_4"
msgstr "Assuma o ritual. O que for invocado pertencerá a você."

msgid "STORY_EVENT@1013_518@TITLE"
msgstr "Pergaminhos do Terror"

msgid "STORY_EVENT@1013_519@BODY_FOOTER"
msgstr "O pergaminho demoníaco está em silêncio, e ainda assim incrivelmente cativante. Tanto conhecimento repousa dentro dele..."

msgid "STORY_EVENT@1013_519@BODY_HEADER"
msgstr "Com os cultistas desaparecidos e seu ritual desfeito, o {EventStructure} finalmente fica em silêncio e {EventHero.Name} está livre para investigar."

msgid "STORY_EVENT@1013_519@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Com os cultistas desaparecidos e seu ritual desfeito, o {EventStructure} finalmente fica em silêncio e você está livre para investigar."

msgid "STORY_EVENT@1013_519@BODY_LORE"
msgstr "Os cultistas não estavam louvando as divindades para as quais o {EventStructure.Name} foi construído. Um pergaminho de aparência maliciosa está no centro do círculo ritual: um artefato usado para invocar seres de um mundo chamado Obbadoth, com ilustrações de seres como <<m:EventUnit>>. Parece que os cultistas estavam usando este pergaminho para invocar esse poder demoníaco."

msgid "STORY_EVENT@1013_519@BUTTON_0"
msgstr "O conhecimento [knowledge/] contido neste pergaminho diabólico certamente poderia ser útil para você..."

msgid "STORY_EVENT@1013_519@BUTTON_1"
msgstr "Use o pergaminho para invocar e controlar uma unidade [unit/] de origem verdadeiramente maligna... [evilact/]"

msgid "STORY_EVENT@1013_519@BUTTON_2"
msgstr "Queime o pergaminho. Purifique o {EventStructure.Name}. [goodact/]"

msgid "STORY_EVENT@1013_519@TITLE"
msgstr "Pergaminhos do Terror: Consequências"

msgid "STORY_EVENT@1013_551@BODY_FOOTER"
msgstr "\"Você derrubará {TargetHouse} para que nós de {EventHouse} não sejamos mais assediados?!\""

msgid "STORY_EVENT@1013_551@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} de {EventHouse} se aproxima de você com a mandíbula de <<o:EventHouseLord>> cerrada."

msgid "STORY_EVENT@1013_551@BODY_LORE"
msgstr "\"Nós de {EventHouse} temos uma longa e sangrenta história com {TargetHouse}. A rivalidade entre nossas cidades começou gerações atrás por razões que nem eu conheço. Ainda assim, qualquer tentativa de paz resultou em traição e mais derramamento de sangue. Eu temia que nunca acabasse. Mas com um {PlayerLeader.Title} como você ao nosso lado, ninguém ousará nos desafiar novamente.\""

msgid "STORY_EVENT@1013_551@BUTTON_0"
msgstr "\"Eu te ouço. Eu derrubarei {TargetHouse}.\""

msgid "STORY_EVENT@1013_551@BUTTON_1"
msgstr "\"Eu decreto que [influence/] vocês dois serão unidos como amigos [goodact/] sob minha proteção em vez disso.\""

msgid "STORY_EVENT@1013_551@BUTTON_2"
msgstr "\"Não tenho tempo para brigas mesquinhas de cidades menores.\""

msgid "STORY_EVENT@1013_551@TITLE"
msgstr "Rivalidade Amarga"

msgid "STORY_EVENT@1013_552@BODY_FOOTER"
msgstr "O que você pede de {EventHouse.Name} por seus problemas?"

msgid "STORY_EVENT@1013_552@BODY_HEADER"
msgstr "Você conquistou com sucesso {TargetHouse}, resultando em um {EventHouseLord.TitleName} muito feliz."

msgid "STORY_EVENT@1013_552@BODY_LORE"
msgstr "\"Não consigo acreditar que você fez isso! Você realmente os esmagou! Eu sabia que sua proeza era lendária, mas nunca vi nada parecido em todos os meus dias. Estou grato, {PlayerLeader}, verdadeiramente grato. {EventHouse} deve-lhe uma grande dívida. Não temos muito a oferecer a um grande {PlayerLeader.Title} como você, mas saiba que você ganhou um amigo para a vida em nós.\""

msgid "STORY_EVENT@1013_552@BUTTON_0"
msgstr "\"Vamos selar essa grande conquista com um novo tratado [allegiance/]!\""

msgid "STORY_EVENT@1013_552@BUTTON_1"
msgstr "\"Eu poderia usar alguns de seus homens e mulheres combatentes [unit/] ao meu lado.\""

msgid "STORY_EVENT@1013_552@BUTTON_3"
msgstr "Meu povo pagou com sangue. Você pagará com ouro [gold/]."

msgid "STORY_EVENT@1013_552@TITLE"
msgstr "Rivalidade Amarga: Consequências"

msgid "STORY_EVENT@1013_558@BODY_FOOTER"
msgstr "Parece que {EventHero.FirstName} tem \"aliados\" inesperados dentro de {EventCity.Name}. <<p:EventHero>> chama por sua ajuda?"

msgid "STORY_EVENT@1013_558@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Parece que você tem \"aliados\" inesperados dentro de {EventCity.Name}. Você chama por sua ajuda?"

msgid "STORY_EVENT@1013_558@BODY_HEADER"
msgstr "Durante o cerco de {EventCity.Name}, seu [hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink] {EventHero.Name} recebe uma nota escrita às pressas que foi amarrada a uma pedra e jogada sobre o muro."

msgid "STORY_EVENT@1013_558@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Durante o cerco de {EventCity.Name}, você recebe uma nota escrita às pressas que foi amarrada a uma pedra e jogada sobre o muro."

msgid "STORY_EVENT@1013_558@BODY_LORE"
msgstr "\"Não compartilhamos amor por {EventCity.Name} ou {EventCityLord.TitleName}. Ajudaremos por dentro, por segurança e ouro. Entregue a resposta e a recompensa à meia-noite e estará feito.\""

msgid "STORY_EVENT@1013_558@BUTTON_0"
msgstr "Pague [gold/] aos traidores por sua ajuda."

msgid "STORY_EVENT@1013_558@BUTTON_1"
msgstr "Prometa pagar a eles quando o cerco terminar... e então \"esqueça\" tudo sobre isso."

msgid "STORY_EVENT@1013_558@BUTTON_2"
msgstr "\"Continuaremos como estamos.\""

msgid "STORY_EVENT@1013_558@TITLE"
msgstr "Amigos do Outro Lado"

msgid "STORY_EVENT@1013_559@BODY_FOOTER"
msgstr "Contrabandistas e ladrões de {EventCity.Name} estão oferecendo sua expertise para levar suprimentos para a cidade, em troca de promessa de clemência."

msgid "STORY_EVENT@1013_559@BODY_HEADER"
msgstr "Enquanto sua cidade {EventCity.Name} está sitiada por {EnemyUnit.Name}, você recebe uma oferta inesperada de ajuda."

msgid "STORY_EVENT@1013_559@BODY_LORE"
msgstr "Um {EventUnit.Name} suspeito faz uma reverência sarcástica e sorri. \"Eu represento um 'empreendimento' particular dentro desses muros da cidade. Temos maneiras de mover contrabando para dentro e para fora deste lugar, mesmo em tempos como este. Agora, nenhum de nós jamais foi pego, e gostaríamos de manter assim. Então, se lhe dermos uma mão, precisamos que seus guardas cheirem em outro lugar no futuro, se você entende o que quero dizer.\""

msgid "STORY_EVENT@1013_559@BUTTON_0"
msgstr "\"Aceito sua oferta e garantirei que suas futuras façanhas sejam... ignoradas.\""

msgid "STORY_EVENT@1013_559@BUTTON_1"
msgstr "\"Mostre-me suas rotas ou eu o farei ser 'pego' antes que esta cidade caia!\""

msgid "STORY_EVENT@1013_559@BUTTON_2"
msgstr "\"Não preciso de ajuda de criminosos insignificantes.\""

msgid "STORY_EVENT@1013_559@TITLE"
msgstr "Honra Entre Ladrões"

msgid "STORY_EVENT@1013_565@BODY_FOOTER"
msgstr "Reconhecer uma ancestralidade compartilhada com os {EventRace} alegraria {EventHouseLord}, mas causaria controvérsia entre seu povo."

msgid "STORY_EVENT@1013_565@BODY_HEADER"
msgstr "Durante negociações diplomáticas, {EventHouseLord} de {EventHouse} acredita que uma descoberta importante foi feita."

msgid "STORY_EVENT@1013_565@BODY_LORE"
msgstr "\"Eu sabia,\" {EventHouseLord} grita animadamente, \"Eu sabia que nós de {EventHouse} somos destinados à grandeza. Perdoe meu impulso, ó {PlayerLeader.Title}, mas os sábios mais sábios entre os {EventRace.Name} têm se debruçado sobre inúmeros pergaminhos delineando árvores genealógicas e parece evidente que você e eu... compartilhamos ancestrais comuns. Não é maravilhoso!?\""

msgid "STORY_EVENT@1013_565@BUTTON_0"
msgstr "\"Bem, se isso o deleita, {EventHouseLord.FirstName}... Você pode me chamar de primo.\""

msgid "STORY_EVENT@1013_565@BUTTON_1"
msgstr "\"Eu, relacionado aos {EventRace}? Riso!\""

msgid "STORY_EVENT@1013_565@BUTTON_2"
msgstr "Evitar o assunto."

msgid "STORY_EVENT@1013_565@BUTTON_3"
msgstr "\"Toda vida está conectada. Relacionados ou não, nosso povo deve viver em harmonia.\""

msgid "STORY_EVENT@1013_565@TITLE"
msgstr "Reunião de Família"

msgid "STORY_EVENT@1013_566@BODY_FOOTER"
msgstr "O silêncio desce sobre a reunião. Todos olham para você, esperando que você execute a famosa dança..."

msgid "STORY_EVENT@1013_566@BODY_HEADER"
msgstr "Durante uma ilustre reunião para avançar seus laços políticos com {EventHouse}, {EventHouseLord} se gaba dos dançarinos de <<o:EventHouseLord>>."

msgid "STORY_EVENT@1013_566@BODY_LORE"
msgstr "\"Nós de {EventHouse} talvez não tenhamos o poder militar de um {PlayerLeader.Title}, mas os {EventRace} têm dançarinos que não conhecem iguais neste reino!\"[br/][br/]Incitado pela atmosfera e por uma bebida a mais, um de seus cortesãos se levanta, afirmando que você é melhor. \"{PlayerLeader.TitleName} é o epítome da graça! Argh! <<p:PlayerLeader>> pode dançar a lendária Dança dos 10.000 Véus!\""

msgid "STORY_EVENT@1013_566@BUTTON_0"
msgstr "\"Dançar? 10.000 véus? Claro! Quão difícil pode ser?\""

msgid "STORY_EVENT@1013_566@BUTTON_1"
msgstr "Invocar [mana/] uma melodia cativante, inspirando todos os outros a dançar em vez disso."

msgid "STORY_EVENT@1013_566@BUTTON_2"
msgstr "\"Ouça aquele bêbado? Uma moeda de [gold/] para quem o fizer dançar!\""

msgid "STORY_EVENT@1013_566@BUTTON_3"
msgstr "\"Eu estudei a Dança dos 10.000 Véus por anos. Observe!\""

msgid "STORY_EVENT@1013_566@BUTTON_4"
msgstr "\"<<m:PlayerLeader.Title>> não dança. Eles são entretidos. Música! Dançarinos!\""

msgid "STORY_EVENT@1013_566@TITLE"
msgstr "Uma Dança Perigosa"

msgid "STORY_EVENT@1013_568@BODY_FOOTER"
msgstr "{EventHero.Name} apreciaria se você forjasse um {EventPact.Hyperlink} com {EventCity}, <<g:cidade de origem^n,EventHero>>."

msgid "STORY_EVENT@1013_568@BODY_HEADER"
msgstr "{EventHero.Name} pede para falar com você. \"Como você sabe, eu nasci em {EventCity.Name}, uma cidade que ainda tenho caro.\""

msgid "STORY_EVENT@1013_568@BODY_LORE"
msgstr "\"Quase não passa um dia sem eu pensar na minha cidade natal. As luzes brilhantes nas torres à noite, o burburinho do mercado... É diferente de qualquer outro lugar. Um pensamento particular se tornou uma obsessão crescente em mim, e devo falar minha mente, meu {PlayerLeader.Title}, pois me traria muita alegria se você forjasse um laço mais próximo com {EventCity.Name}.\""

msgid "STORY_EVENT@1013_568@BUTTON_0"
msgstr "\"Juntos com {EventCity.Name}, prosperaremos.\""

msgid "STORY_EVENT@1013_568@BUTTON_2"
msgstr "\"Eu não tenho tempo para {EventCity.Name}.\""

msgid "STORY_EVENT@1013_568@TITLE"
msgstr "Cidade Natal"

msgid "STORY_EVENT@1013_569@BODY_FOOTER"
msgstr "\"Você fez um grande favor a mim e à minha amada {EventCity.Name}. Por favor, diga-me o que podemos fazer por você.\""

msgid "STORY_EVENT@1013_569@BODY_HEADER"
msgstr "Você forjou com sucesso um {EventPact.Hyperlink} com {EventCity.Name}. {EventHero.Name} está grato."

msgid "STORY_EVENT@1013_569@BODY_LORE"
msgstr "\"Fico feliz que você tenha visto a beleza de {EventCity.Name}, {PlayerLeader.TitleName}, e ainda mais feliz em saber que ela está abrigada sob sua mão protetora. Meu coração está em paz, mas meu espírito está mais inflamado do que nunca para realizar grandes feitos em seu nome!\""

msgid "STORY_EVENT@1013_569@BUTTON_0"
msgstr "\"Através de contos e canções, você proclamará a glória [influence/] do meu império.\""

msgid "STORY_EVENT@1013_569@BUTTON_1"
msgstr "\"Aproxime ainda mais os laços com {EventHouseLord} de {EventCity}.\""

msgid "STORY_EVENT@1013_569@BUTTON_3"
msgstr "\"Convoque os vassalos [unit/] de {EventCity} para reforçar meus exércitos.\""

msgid "STORY_EVENT@1013_569@TITLE"
msgstr "Cidade Natal: Consequências"

msgid "STORY_EVENT@1013_573@BODY_FOOTER"
msgstr "Os demônios não podem escapar impunes de sua rampagem flagrante. Você não salvará seu povo e purgará esses demônios, Santo {PlayerLeader.Title}?"

msgid "STORY_EVENT@1013_573@BODY_HEADER"
msgstr "Após fortalecer seu império através da ordem e disciplina, você recebe relatórios de que demônios estão se reunindo perto de {EventCity}, espalhando medo nos corações de seus cidadãos."

msgid "STORY_EVENT@1013_573@BODY_LORE"
msgstr "A infestação diabólica, demônios que ou mataram ou escaparam de seus mestres, são liderados por um horrendo {EventStackLeader}. Como mariposas diabólicas, os desviantes infernais são atraídos pela luz brilhante que santifica seu império, caçando os fracos e fracos de vontade entre seus seguidores. Vários cidadãos piedosos foram supostamente tentados, seduzidos, enganados, comprometidos ou simplesmente mortos por esses hóspedes sem Deus."

msgid "STORY_EVENT@1013_573@BUTTON_0"
msgstr "\"Esses invasores profanos serão purificados pelo meu fogo sagrado!\""

msgid "STORY_EVENT@1013_573@BUTTON_1"
msgstr "\"Depois de devorarem os infiéis, esses demônios sem ordem certamente se dispersarão.\""

msgid "STORY_EVENT@1013_573@BUTTON_2"
msgstr "\"Um {EventStackLeader} sem controle? Minhas incantações zelosas [mana/] dominarão [unit/] ele [ordercrisis/]!\""

msgid "STORY_EVENT@1013_573@TITLE"
msgstr "Invasores Infernais"

msgid "STORY_EVENT@1013_574@BODY_FOOTER"
msgstr "De {EventCity}, cidadãos curiosos preparam-se para pilhar o tesouro abandonado. Você deve declarar o que é seu e o que é deles para coletar."

msgid "STORY_EVENT@1013_574@BODY_FOOTER@NO_CITY"
msgstr "Enquanto suas tropas começam a pilhar o tesouro abandonado, você deve declarar o que é seu e o que é deles para coletar."

msgid "STORY_EVENT@1013_574@BODY_HEADER"
msgstr "Os demônios ímpios foram vencidos! A ordem divina é restaurada em seu reino. Batedores relatam o que os demônios acumularam em seu ninho."

msgid "STORY_EVENT@1013_574@BODY_LORE"
msgstr "Os invasores profanos haviam saqueado as terras ao redor por vários dias. Tesouros manchados de sangue estão empilhados nas bordas do ninho. No topo do monte mais alto, um {EventItem} é encontrado, marcado por garras. Dezenas de animais mortos foram arrastados para o centro do ponto de encontro. Alguns dos gados abatidos estão parcialmente devorados, mas a maioria das carcaças frescas permanece intacta."

msgid "STORY_EVENT@1013_574@BUTTON_0"
msgstr "Pegue o tesouro manchado [gold/] e ordene que seja lavado."

msgid "STORY_EVENT@1013_574@BUTTON_1"
msgstr "Envie as carcaças não contaminadas [food/] para {EventCity} antes que apodreçam."

msgid "STORY_EVENT@1013_574@BUTTON_3"
msgstr "Reivindique o {EventItem} para comemorar seu poder piedoso."

msgid "STORY_EVENT@1013_574@BUTTON_4"
msgstr "Pegue todas as recompensas [gold/] [food/] [item/] para você. Elas não são dignas de plebeus [evilact/]."

msgid "STORY_EVENT@1013_574@TITLE"
msgstr "Invasores Infernais: Consequências"

msgid "STORY_EVENT@1013_577@BODY_FOOTER"
msgstr "{GLOBAL.ElyaLoreConcept.Hyperlink} a Maer junta-se a você enquanto você parte para Magehaven, vitorioso."

msgid "STORY_EVENT@1013_577@BODY_HEADER"
msgstr "Você lançou a Deusa Sereia no vazio e reclamou o Arquipélago Encantado de seu abraço afogante!"

msgid "STORY_EVENT@1013_577@BODY_LORE"
msgstr "De sua capital, a mítica {GLOBAL.MaerLoreConcept.Hyperlink} emerge novamente. \"Agradeço-lhe, {PlayerLeader.TitleName}, por ouvir minha canção e libertar o reino. Temo não ter nada que se assemelhe a uma recompensa de {GLOBAL.GodirLoreConcept.Hyperlink}... Mas se você me permitir juntar-me a você em suas viagens, posso compartilhar o que aprendi como prisioneira de Nimue.\""

msgid "STORY_EVENT@1013_577@BODY_LORE@ELYA_NOT_FREED"
msgstr "De sua prisão escondida, uma mítica {GLOBAL.MaerLoreConcept.Hyperlink} emerge, flutuando em correntes invisíveis. \"Agradeço-lhe, {PlayerLeader.TitleName}, por ouvir minha canção e libertar o reino. Meu nome é {GLOBAL.ElyaLoreConcept.Hyperlink}. Temo não ter nada para dar como recompensa para um Godir... Mas se você me permitir juntar-me a você em suas viagens, posso compartilhar o que aprendi como prisioneira de Nimue.\""

msgid "STORY_EVENT@1013_577@BUTTON_0"
msgstr "Elya a Maer junta-se a você enquanto você parte para Magehaven vitoriosamente."

msgid "STORY_EVENT@1013_577@TITLE"
msgstr "O Arquipélago Encantado: Vitória"

msgid "STORY_EVENT@1013_614@BODY_FOOTER"
msgstr "\"Grande {PlayerLeader.Title}, você pode nos livrar desses dissidentes?\""

msgid "STORY_EVENT@1013_614@BODY_HEADER"
msgstr "Seu [hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink] {EventHero.Name}, nomeado governador de {EventCity.Name}, aproxima-se de você em angústia."

msgid "STORY_EVENT@1013_614@BODY_LORE"
msgstr "\"Sábio {PlayerLeader.Title}, gostaria de pedir seu conselho sobre o seguinte assunto. Um grupo de veteranos descontentes tem causado problemas na cidade. Eles montaram acampamento logo fora dos portões, onde continuam a semear dissensão e fazer exigências. No entanto, a guarda da cidade não quer pegar em armas contra os seus próprios.\""

msgid "STORY_EVENT@1013_614@BUTTON_0"
msgstr "\"Eu lidarei com esses insurretos.\""

msgid "STORY_EVENT@1013_614@BUTTON_2"
msgstr "\"Você não é o governador de {EventCity}, {EventHero}? Você encontrará uma solução.\""

msgid "STORY_EVENT@1013_614@TITLE"
msgstr "Veteranos Problemáticos"

msgid "STORY_EVENT@1013_615@BODY_FOOTER"
msgstr "\"Parece que os veteranos da cidade estão ansiosos para mostrar seu valor mais uma vez. O que devemos fazer com eles?\""

msgid "STORY_EVENT@1013_615@BODY_HEADER"
msgstr "Você lidou com os veteranos descontentes e restaurou a paz em {EventCity}. {EventHero} está aliviado."

msgid "STORY_EVENT@1013_615@BODY_LORE"
msgstr "\"Obrigado, {PlayerLeader.TitleName}, por restaurar a ordem em {EventCity.Name}. Os cidadãos estão muito impressionados com suas ações. Eles não se rebelarão novamente por um tempo. Até os idosos estão mais motivados do que nunca!\""

msgid "STORY_EVENT@1013_615@BUTTON_0"
msgstr "Dê a eles uma voz no conselho {EventRace}. [happiness/]"

msgid "STORY_EVENT@1013_615@BUTTON_1"
msgstr "Deixe-os proteger as caravanas de comércio [gold/] que viajam para e de {EventCity.Name}."

msgid "STORY_EVENT@1013_615@BUTTON_3"
msgstr "Use sua experiência para treinar [unitprod/] os guardas de {EventCity.Name}."

msgid "STORY_EVENT@1013_615@TITLE"
msgstr "Veteranos Problemáticos: Consequências"

msgid "STORY_EVENT@1013_616@BODY_FOOTER"
msgstr "\"Não desejamos lutar contra você, ó {PlayerLeader.Title}. Mas lutaremos pelo bem-estar daqueles que serviram a você.\""

msgid "STORY_EVENT@1013_616@BODY_HEADER"
msgstr "Você encontra os insurgentes de {EventCity}, um grupo comandado por um {EventStackLeader}, que toma uma postura corajosa ao ver suas tropas."

msgid "STORY_EVENT@1013_616@BODY_LORE"
msgstr "\"Então você ouviu falar sobre nosso protesto?\" <<p:EventStackLeader>> pergunta. \"Então você também deve ter ouvido falar sobre a forma como somos tratados. Há muito tempo guardamos sua cidade, lutamos ao seu lado. Mas e depois? Os velhos e feridos são jogados de lado, como panos de chão velhos. Chega! Nosso trabalho e sacrifício merecem respeito. Exigimos comida e abrigo para os feridos e idosos!\""

msgid "STORY_EVENT@1013_616@BUTTON_0"
msgstr "\"Você fez sua cama, agora morra nela. [evilact/] Para a batalha!\""

msgid "STORY_EVENT@1013_616@BUTTON_1"
msgstr "\"Eu vou garantir que os veteranos de {EventCity} sejam cuidados [food/].\" [goodact/]"

msgid "STORY_EVENT@1013_616@BUTTON_2"
msgstr "\"Por favor, voltem para {EventCity.Name} [population/], eu prometo que vocês não serão mais ignorados.\""

msgid "STORY_EVENT@1013_616@BUTTON_3"
msgstr "Sair."

msgid "STORY_EVENT@1013_616@TITLE"
msgstr "Encontrando Veteranos Problemáticos"

msgid "STORY_EVENT@1013_645@BODY_FOOTER"
msgstr "Você conquistará {EventHouse.Name} para os {EventRace.Name}?"

msgid "STORY_EVENT@1013_645@BODY_HEADER"
msgstr "O Conselho dos {EventRace.Name} solicita uma audiência sobre a guerra com a cidade independente de {EventHouse.Name}."

msgid "STORY_EVENT@1013_645@BODY_LORE"
msgstr "\"{PlayerLeader.TitleName}, nosso protetor, queremos apresentar a você os maus feitos de {EventHouse.Name} contra nosso povo. Desde que a guerra começou, inocentes {EventRace.Name} têm sido sujeitos a perseguição e assassinato. Para nós, esta guerra com {EventHouse.Name} só pode terminar de uma maneira: com o fim da dinastia de {EventHouseLord.TitleName}, os instigadores desta campanha assassina.\""

msgid "STORY_EVENT@1013_645@BUTTON_0"
msgstr "\"Você terá as cabeças deles.\""

msgid "STORY_EVENT@1013_645@BUTTON_1"
msgstr "\"A destruição indiscriminada não traz lucro. Encontrarei maneiras mais lucrativas [materiumboon/] de usar {EventHouse.Name}.\""

msgid "STORY_EVENT@1013_645@BUTTON_2"
msgstr "\"Ainda pode haver outras maneiras de resolver este conflito.\""

msgid "STORY_EVENT@1013_645@TITLE"
msgstr "Cabeças em uma Bandeja"

msgid "STORY_EVENT@1013_646@BODY_FOOTER"
msgstr "\"Como você deseja que seu povo lembre deste dia memorável, ó {PlayerLeader.Title} dos {EventRace}?\""

msgid "STORY_EVENT@1013_646@BODY_HEADER"
msgstr "Você derrotou {EventHouse.Name}. O Conselho dos {EventRace} se alegra."

msgid "STORY_EVENT@1013_646@BODY_LORE"
msgstr "\"Sangue por sangue. Osso por osso. O fim de {EventHouse} traz conforto a todos os {EventRace} que tiveram que sofrer nas mãos deles. Os despojos da conquista não curarão todas as feridas, mas espalham um senso de justiça, mesmo que alguns erros nunca possam ser reparados.\""

msgid "STORY_EVENT@1013_646@BUTTON_0"
msgstr "\"Lembre-se das gloriosas batalhas [unitprod/] que derrubaram nossos inimigos.\""

msgid "STORY_EVENT@1013_646@BUTTON_1"
msgstr "\"Lembre-se de nossas grandes cidades [structureprod/], cujos muros nos deram abrigo.\""

msgid "STORY_EVENT@1013_646@TITLE"
msgstr "Cabeças em uma Bandeja: Consequências"

msgid "STORY_EVENT@1013_682@BODY_FOOTER"
msgstr "Você vai deter essas criaturas de gelo antes que congelem tudo ao seu alcance?"

msgid "STORY_EVENT@1013_682@BODY_HEADER"
msgstr "Pelo destino ou pura sorte, as correntes de mudança e caos chamam sua atenção para uma cena gelada."

msgid "STORY_EVENT@1013_682@BODY_LORE"
msgstr "Um {EventStackLeader} e <<o:EventStackLeader>> seguidores tomados pelo gelo estão lentamente transformando a área ao seu redor em gelo. Eles congelam a terra, as bestas e os homens, deixando para trás uma desolada terra sem vida. Toda a vontade de viver, movimento e impulso é apagado, como se toda a região tivesse sido congelada no tempo."

msgid "STORY_EVENT@1013_682@BUTTON_0"
msgstr "\"O inverno acabou. Vamos derreter um pouco de gelo!\""

msgid "STORY_EVENT@1013_682@BUTTON_1"
msgstr "\"As mudanças vêm e vão. Seu gelo não durará muito.\""

msgid "STORY_EVENT@1013_682@BUTTON_2"
msgstr "\"Detê-los? Eu vou apoiar [mana/] este experimento de congelamento!\""

msgid "STORY_EVENT@1013_682@TITLE"
msgstr "Congelamento Eterno"

msgid "STORY_EVENT@1013_683@BODY_FOOTER"
msgstr "Qual recompensa você escolhe salvar antes que o caos a reduza a pó astral?"

msgid "STORY_EVENT@1013_683@BODY_HEADER"
msgstr "Com as criaturas de gelo desaparecidas, seu gelo mágico começa a derreter."

msgid "STORY_EVENT@1013_683@BODY_LORE"
msgstr "Gelos se quebram e a água pinga enquanto o frio desaparece, revelando vários objetos que estavam presos no gelo. Você vê armas, ouro e uma pilha de livros. Mas, enquanto o gelo derrete, o caos e a decadência compensam o tempo perdido, pois você pode ver os objetos se deteriorarem diante dos seus olhos. Você tem que escolher rápido."

msgid "STORY_EVENT@1013_683@BUTTON_0"
msgstr "Pegue um {EventItem} [item/]."

msgid "STORY_EVENT@1013_683@BUTTON_1"
msgstr "Pegue um baú de riquezas [gold/]."

msgid "STORY_EVENT@1013_683@BUTTON_3"
msgstr "Pegue um tomo de conhecimento ancestral [knowledge/]."

msgid "STORY_EVENT@1013_683@BUTTON_4"
msgstr "Deixe todos os objetos se deteriorarem e recolha os reagentes mágicos depois. [Mana/]"

msgid "STORY_EVENT@1013_683@TITLE"
msgstr "Congelamento Eterno: Consequências"

msgid "STORY_EVENT@1013_695@BODY_FOOTER"
msgstr "{EventHouseLord} pede sua permissão para cruzar <<o:EventHouseLord>> própria montaria com sua {EventMount}."

msgid "STORY_EVENT@1013_695@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} de {EventHouse} busca um favor concernente à sua montaria."

msgid "STORY_EVENT@1013_695@BODY_LORE"
msgstr "\"Grande {PlayerLeader.Title}, você monta um {EventMount} que quase combina com sua própria graça e poder. Enquanto isso, meu fiel {HouseLordMount} foi ferido e eu não posso mais montar <<p:HouseLordMount>> em batalha. Eu humildemente peço que você considere cruzar o seu com o meu. Com um pouco de magia {GLOBAL.GodirLoreConcept.Hyperlink}, espero que nossas montarias combinadas produzam uma criatura magnífica que trará nova glória a {EventHouse}.\""

msgid "STORY_EVENT@1013_695@BUTTON_0"
msgstr "\"Não! Tais crimes contra a natureza [natureboon/] só produziriam abominações.\""

msgid "STORY_EVENT@1013_695@BUTTON_1"
msgstr "\"Por uma generosa compensação [gold/], eu posso permitir que nossas montarias cruzem.\""

msgid "STORY_EVENT@1013_695@BUTTON_2"
msgstr "\"Não, você não pode cruzar minha montaria.\""

msgid "STORY_EVENT@1013_695@BUTTON_3"
msgstr "\"Em toda a minha generosidade, eu vou lhe presentear com meu {EventMount}.\""

msgid "STORY_EVENT@1013_695@BUTTON_4"
msgstr "\"Eles podem se reproduzir, mas seu primeiro filhote [mount/] é meu.\""

msgid "STORY_EVENT@1013_695@TITLE"
msgstr "Criação de Qualidade"

msgid "STORY_EVENT@1013_721@BODY_FOOTER"
msgstr "Este escriba rebelde é apenas um sintoma dos problemas subjacentes de {GLOBAL.CityStabilityConcept.Hyperlink} que esta cidade está enfrentando."

msgid "STORY_EVENT@1013_721@BODY_HEADER"
msgstr "Você negligenciou as necessidades de sua população em {EventCity.Name} e agora alguém em sua cidade está escrevendo poesia incitante nos edifícios."

msgid "STORY_EVENT@1013_721@BODY_LORE"
msgstr "Os guardas arrastam um jovem escriba que olha para você com desafio. \"Você não se importa conosco,\" diz <<p:EventUnit>>, \"a menos que danifiquemos seu legado. Faça o que deve, seu povo já sabe que tipo de {GLOBAL.GodirLoreConcept.Hyperlink} você é.\" Os guardas da cidade olham para você com inquietação e o escriba fecha <<o:EventUnit>> os olhos, aguardando seu julgamento."

msgid "STORY_EVENT@1013_721@BUTTON_0"
msgstr "Pague [gold/] para remover a escrita. [happiness/]"

msgid "STORY_EVENT@1013_721@BUTTON_1"
msgstr "Use seus poderes de transmutação para restaurar as paredes. [happiness/]"

msgid "STORY_EVENT@1013_721@BUTTON_2"
msgstr "Liberte o escriba. [goodact/] A crítica é um presente."

msgid "STORY_EVENT@1013_721@BUTTON_3"
msgstr "Execute publicamente o escriba [evilact/]. Isso deve ser uma lição para todos. [happiness/]"

msgid "STORY_EVENT@1013_721@BUTTON_4"
msgstr "\"Não tenho tempo para isso.\""

msgid "STORY_EVENT@1013_721@TITLE"
msgstr "Escrita na Parede"

msgid "STORY_EVENT@1013_722@BODY_FOOTER"
msgstr "O olhar pensativo de <<Co:EventHeroB>> se volta para a {EventStructure}. \"Não peço isso de ânimo leve, <<EventHero{hero/heroine}>>... Mas este {EnemyUnit} corrompido deve ser detido.\""

msgid "STORY_EVENT@1013_722@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "O olhar pensativo de <<Co:EventHeroB>> se volta para a {EventStructure}. \"Não peço isso de ânimo leve, o {PlayerLeader.Title}... Mas este {EnemyUnit} corrompido deve ser detido.\""

msgid "STORY_EVENT@1013_722@BODY_HEADER"
msgstr "Ao se aproximar da majestosa {EventStructure}, {EventHero.Name} é interrompido por um {EventHeroB.Title} real emergindo de uma cabana próxima."

msgid "STORY_EVENT@1013_722@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Ao se aproximar da majestosa {EventStructure}, você é interrompido por um {EventHeroB.Title} real emergindo de uma cabana próxima."

msgid "STORY_EVENT@1013_722@BODY_LORE"
msgstr "<<Cp:EventHeroB>> cumprimenta {EventHero} calorosamente. \"Desejo-lhe bem, viajante. Meus companheiros Guardiões da Árvore e eu já a salvamos de ser destruída por demônios, mortos-vivos e até mortais. Agora, porém, um inimigo inesperado nos ameaça... um dos nossos! A corrupção tomou conta do {EnemyUnit}, que começou a consumir a vida da própria Árvore.\""

msgid "STORY_EVENT@1013_722@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "<<Cp:EventHeroB>> cumprimenta você calorosamente. \"Desejo-lhe bem, o {PlayerLeader.Title}. Meus companheiros Guardiões da Árvore e eu já a salvamos de ser destruída por demônios, mortos-vivos e até mortais. Agora, porém, um inimigo inesperado nos ameaça... um dos nossos! A corrupção tomou conta do {EnemyUnit}, que começou a consumir a vida da própria Árvore.\""

msgid "STORY_EVENT@1013_722@BUTTON_0"
msgstr "\"Eu libertarei a {EventStructure} deste {EnemyUnit} corrompido.\""

msgid "STORY_EVENT@1013_722@BUTTON_1"
msgstr "\"Conceda-me o <<G:support^n,EventStructure>> [mana/] e eu a protegerei.\""

msgid "STORY_EVENT@1013_722@BUTTON_3"
msgstr "Afaste-se."

msgid "STORY_EVENT@1013_722@BUTTON_4"
msgstr "Invoque o poder da {EventStructure} você mesmo."

msgid "STORY_EVENT@1013_722@TITLE"
msgstr "Guardião Corrompido"

msgid "STORY_EVENT@1013_723@BODY_FOOTER"
msgstr "Então <<p:EventHeroB>> sorri. \"Chega de sermões. A {EventStructure} e seus guardiões estão em dívida com você, bravo <<EventHero{hero/heroine}>>. Diga seu desejo.\""

msgid "STORY_EVENT@1013_723@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Então <<p:EventHeroB>> sorri. \"Chega de sermões. A {EventStructure} e seus guardiões estão em dívida com você, o {PlayerLeader.Title}. Diga seu desejo.\""

msgid "STORY_EVENT@1013_723@BODY_HEADER"
msgstr "O sábio {EventHeroB.Title} cumprimenta {EventHero.FirstName} após os sons da batalha terem desaparecido. \"Obrigado. Agora a {EventStructure} pode se curar novamente.\""

msgid "STORY_EVENT@1013_723@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "O sábio {EventHeroB.Title} cumprimenta você depois que os sons da batalha desapareceram. \"Obrigado. Agora a {EventStructure} pode se curar novamente.\""

msgid "STORY_EVENT@1013_723@BODY_LORE"
msgstr "\"Eu sei que você busca recursos para fortalecer suas forças,\" diz <<Cp:EventHeroB>>, antes de <<p:EventHeroB>> olhar para os inimigos caídos que já estiveram com <<P:EventHeroB>>. \"... A obsessão corrompe as almas mais puras. Cuidado para que sua busca por poder não corrompa as coisas que você já valorizou. Até a árvore mais grandiosa cairá quando suas raízes estiverem apodrecendo.\""

msgid "STORY_EVENT@1013_723@BUTTON_0"
msgstr "\"Eu busco para minha população em {EventCity} crescer [food/] com a bênção da Árvore.\""

msgid "STORY_EVENT@1013_723@BUTTON_1"
msgstr "\"Eu busco ajuda [unit/] dos outros guardiões da {EventStructure}.\""

msgid "STORY_EVENT@1013_723@BUTTON_2"
msgstr "\"Não me dê lições sobre ganância. Dê-me o {EventItem} [item/] que seu guardião corrompido carregava.\" [evilact/]"

msgid "STORY_EVENT@1013_723@BUTTON_4"
msgstr "\"Permita-me me comunicar [natureboon/] com a Árvore, nobre {EventHeroB.Title}.\""

msgid "STORY_EVENT@1013_723@TITLE"
msgstr "Guardião Corrompido: Consequências"

msgid "STORY_EVENT@1013_724@BODY_FOOTER"
msgstr "As tropas de <<Cg:troops^n,EventHero>> se agitam e gritam em confusão enquanto seus reflexos ganham vida e se revelam como <<m:EnemyUnit>>."

msgid "STORY_EVENT@1013_724@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Suas tropas se agitam e gritam em confusão enquanto seus reflexos ganham vida e se revelam como <<m:EnemyUnit>>."

msgid "STORY_EVENT@1013_724@BODY_HEADER"
msgstr "{EventHero.Name} entra em uma floresta de formações de cristal brilhante, mostrando reflexos sinistros de {EventHero.FirstName} e das tropas de <<o:EventHero>>."

msgid "STORY_EVENT@1013_724@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você entra em uma floresta de formações de cristal brilhante, mostrando reflexos sinistros de você e de suas tropas."

msgid "STORY_EVENT@1013_724@BODY_LORE"
msgstr "Enquanto <<p:EventHero>> continua avançando pela floresta, memórias o sobrecarregam. Reflexos de <<r:EventHero>> se transformam em visões do passado, presente e futuro, em memórias das coisas boas e ruins que <<p:EventHero>> já fez. As tropas de <<Co:EventHero>> choram e lamentam, pedindo desculpas para suas próprias imagens refletidas. Então, as visões começam a tomar forma física... enquanto criaturas aparecem do labirinto de cristal."

msgid "STORY_EVENT@1013_724@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Enquanto você continua avançando pela floresta, memórias o sobrecarregam. Reflexos de si mesmo se transformam em visões do passado, presente e futuro, em memórias das coisas boas e ruins que você já fez. Suas tropas choram e lamentam, pedindo desculpas para suas próprias imagens refletidas. Então, as visões começam a tomar forma física... enquanto criaturas aparecem do labirinto de cristal."

msgid "STORY_EVENT@1013_724@BUTTON_0"
msgstr "\"Não desespere! Às armas!\""

msgid "STORY_EVENT@1013_724@BUTTON_1"
msgstr "Use seu conhecimento místico para fortificar suas tropas contra o <<m:EnemyUnit>>."

msgid "STORY_EVENT@1013_724@BUTTON_2"
msgstr "Recue antes que os reflexos o dominem."

msgid "STORY_EVENT@1013_724@BUTTON_3"
msgstr "\"Não tenham medo, tropas! Esses espelhos podem quebrar como qualquer outro!\""

msgid "STORY_EVENT@1013_724@BUTTON_4"
msgstr "Use magia [mana/] para fortificar suas tropas contra o <<m:EnemyUnit>>."

msgid "STORY_EVENT@1013_724@TITLE"
msgstr "Reflexos"

msgid "STORY_EVENT@1013_725@BODY_FOOTER"
msgstr "Os reflexos da {EventStructure.Name} agora mostram memórias afetuosas do passado. {EventHero.FirstName} olha para o cristal e lembra..."

msgid "STORY_EVENT@1013_725@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Os reflexos da {EventStructure.Name} agora mostram memórias afetuosas do passado. Você olha para o cristal e lembra..."

msgid "STORY_EVENT@1013_725@BODY_HEADER"
msgstr "À medida que a emboscada dos estranhos reflexos se dissipa, as tropas de <<g:troops^p,EventHero>> suspiram aliviadas. A {EventStructure.Name} pulsa com uma nova energia."

msgid "STORY_EVENT@1013_725@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "À medida que a emboscada dos estranhos reflexos se dissipa, suas tropas suspiram aliviadas. A {EventStructure.Name} pulsa com uma nova energia."

msgid "STORY_EVENT@1013_725@BODY_LORE"
msgstr "{EventHero.FirstName} vê um caminho com muitos garfos à frente, cada um levando à liberdade. Os cristais cintilam e as tropas de <<g:troops^p,EventHero>> sorriem enquanto os novos reflexos mostram memórias afetuosas de seu passado. Se apenas por um momento, elas encontram consolo e paz dentro desta floresta de cristal. {EventHero.FirstName} vai dar uma olhada mais de perto nos cristais <<r:EventHero>>."

msgid "STORY_EVENT@1013_725@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Você vê um caminho com muitos garfos à frente, cada um levando à liberdade. Os cristais cintilam e suas tropas sorriem enquanto os novos reflexos mostram memórias afetuosas de seu passado. Se apenas por um momento, elas encontram consolo e paz dentro desta floresta de cristal. Você vai dar uma olhada mais de perto nos cristais."

msgid "STORY_EVENT@1013_725@BUTTON_0"
msgstr "Lembra quando {EventHero.FirstName} ganhou o primeiro salário de <<o:EventHero>> [gold/]."

msgid "STORY_EVENT@1013_725@BUTTON_0@HERO_IS_PLAYERLE"
msgstr "Lembra quando você ganhou sua primeira moeda [gold/]."

msgid "STORY_EVENT@1013_725@BUTTON_1"
msgstr "Lembra quando {EventHero.FirstName} fez o primeiro amigo verdadeiro de <<o:EventHero>>. [unit/]"

msgid "STORY_EVENT@1013_725@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "Lembra quando você encontrou companheirismo pela primeira vez. [unit/]"

msgid "STORY_EVENT@1013_725@BUTTON_2"
msgstr "Lembra do primeiro dia de treinamento com uma arma de <<o:EventHero>> [item/]."

msgid "STORY_EVENT@1013_725@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "Lembra do seu primeiro dia de treinamento com uma arma [item/]."

msgid "STORY_EVENT@1013_725@BUTTON_3"
msgstr "Lembra do dia em que {EventHero.FirstName} lançou o primeiro feitiço de <<o:EventHero>> [mana/]."

msgid "STORY_EVENT@1013_725@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "Lembra do dia em que você lançou seu primeiro feitiço [mana/]."

msgid "STORY_EVENT@1013_725@BUTTON_4"
msgstr "Lembra do dia em que {EventHero.FirstName} se tornou um herói [happiness/] entre o povo de <<o:EventHero>>."

msgid "STORY_EVENT@1013_725@BUTTON_4@HERO_IS_PLAYERLE"
msgstr "Lembra do dia em que você se tornou um {PlayerLeader.Title} [happiness/] entre seu povo."

msgid "STORY_EVENT@1013_725@TITLE"
msgstr "Reflexões: Consequências"

msgid "STORY_EVENT@1013_730@BODY_FOOTER"
msgstr "Quando o {EnemyUnit} percebe {EventHero.FirstName}, <<p:EnemyUnit>> se levanta em toda a sua altura, pronto para lutar contra este pretendente ao poder de <<o:EnemyUnit>>."

msgid "STORY_EVENT@1013_730@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Quando o {EnemyUnit} percebe você, <<p:EnemyUnit>> se levanta em toda a sua altura, pronto para lutar contra este desafio ao poder de <<o:EnemyUnit>>."

msgid "STORY_EVENT@1013_730@BODY_HEADER"
msgstr "{EventHero} entra na imponente {EventStructure}. Já foi um farol de poder mágico. Agora só restam remanescentes desvanecentes."

msgid "STORY_EVENT@1013_730@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você entra na imponente {EventStructure}. Já foi um farol de poder mágico. Agora só restam remanescentes desvanecentes."

msgid "STORY_EVENT@1013_730@BODY_LORE"
msgstr "Enquanto {EventHero.Name} sobe a espiral sinuosa, uma sensação estranha supera <<P:EventHero>>. Então <<p:EventHero>> percebe um {GLOBAL.LostWizardLoreConcept.Hyperlink} correndo pela torre, procurando freneticamente por... algo. <<Cp:EnemyUnit>> para repentinamente quando <<p:EnemyUnit>> encontra um livro apodrecido e pega o tomo com surpreendente cuidado. O {EnemyUnit} treme quando o tomo desmorona em pó em suas garras, e solta um grito ensurdecedor antes de continuar sua frenética destruição."

msgid "STORY_EVENT@1013_730@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Enquanto você sobe a espiral sinuosa, uma sensação estranha o supera. Então você percebe um {GLOBAL.LostWizardLoreConcept.Hyperlink} correndo pela torre, procurando freneticamente por... algo. <<Cp:EnemyUnit>> para repentinamente quando <<p:EnemyUnit>> encontra um livro apodrecido, pegando o tomo com surpreendente cuidado. O {EnemyUnit} treme quando o tomo desmorona em pó em seus tentáculos, e solta um grito ensurdecedor antes de continuar sua frenética destruição."

msgid "STORY_EVENT@1013_730@BUTTON_0"
msgstr "Mate este {EnemyUnit}!"

msgid "STORY_EVENT@1013_730@BUTTON_1"
msgstr "Use poder mágico bruto [mana/] para enfraquecer o {EnemyUnit} contra seus ataques."

msgid "STORY_EVENT@1013_730@BUTTON_3"
msgstr "Invoque seu grande conhecimento do Mar Astral para enfraquecer este {EnemyUnit} contra seus ataques."

msgid "STORY_EVENT@1013_730@BUTTON_4"
msgstr "Pegue um livro e queime-o na frente do {EnemyUnit} para provocar <<P:EnemyUnit>>."

msgid "STORY_EVENT@1013_730@BUTTON_5"
msgstr "Afaste-se e deixe a torre."

msgid "STORY_EVENT@1013_730@TITLE"
msgstr "Obsessão Imortal"

msgid "STORY_EVENT@1013_731@BODY_FOOTER"
msgstr "Uma voz emana da orb flutuante, sem saber que {EventHero.FirstName} não é o feiticeiro que residia aqui. \"O que devo recuperar do seu tesouro hoje?\""

msgid "STORY_EVENT@1013_731@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Uma voz emana da orb flutuante, sem saber que você não é o feiticeiro que residia aqui. \"O que devo recuperar do seu tesouro hoje?\""

msgid "STORY_EVENT@1013_731@BODY_HEADER"
msgstr "A ameaça na {EventStructure} tendo sido resolvida, {EventHero} é capaz de procurar a torre quebrada <<r:EventHero>>."

msgid "STORY_EVENT@1013_731@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "A ameaça na {EventStructure} tendo sido resolvida, você é capaz de procurar a torre quebrada você mesmo."

msgid "STORY_EVENT@1013_731@BODY_LORE"
msgstr "Enquanto devastava a torre, o {GLOBAL.LostWizardLoreConcept.Hyperlink} perdeu uma porta secreta, habilmente escondida pelo feiticeiro que residia aqui antes. Ela leva a um tesouro bem protegido. Todos os seus conteúdos estão em uma condição notavelmente boa em comparação com o resto da {EventStructure}. No centro da sala, uma esfera flutuante zumbi e sobe quando {EventHero.FirstName} entra. \"Bem-vindo de volta, mestre.\""

msgid "STORY_EVENT@1013_731@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Enquanto devastava a torre, o {GLOBAL.LostWizardLoreConcept.Hyperlink} perdeu uma porta secreta, habilmente escondida pelo feiticeiro que residia aqui antes. Ela leva a um tesouro bem protegido. Todos os seus conteúdos estão em uma condição notavelmente boa em comparação com o resto da {EventStructure}. No centro da sala, uma esfera flutuante zumbi e sobe quando você entra. \"Bem-vindo de volta, mestre.\""

msgid "STORY_EVENT@1013_731@BUTTON_1"
msgstr "\"Entregue-me minha arma mais forte.\" [item/]"

msgid "STORY_EVENT@1013_731@BUTTON_2"
msgstr "\"Traga-me minha riqueza.\" [gold/]"

msgid "STORY_EVENT@1013_731@BUTTON_3"
msgstr "\"Convoque minhas defesas.\" [unit/]"

msgid "STORY_EVENT@1013_731@BUTTON_4"
msgstr "\"Entregue-me meus jornais. Desejo aprender sobre... meu próprio domínio.\" [influence/]"

msgid "STORY_EVENT@1013_731@TITLE"
msgstr "Obsessão Imortal: Consequências"

msgid "STORY_EVENT@1013_732@BODY_FOOTER"
msgstr "{EventHero.FirstName} olha além do ferreiro, em direção à {EventStructure} em colapso. Um rugido e um estrondo podem ser ouvidos de dentro."

msgid "STORY_EVENT@1013_732@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Você olha além do ferreiro, em direção à {EventStructure} em colapso. Um rugido e um estrondo podem ser ouvidos de dentro."

msgid "STORY_EVENT@1013_732@BODY_HEADER"
msgstr "Um ferreiro grisalho está entre {EventHero.Name} e uma forja ancestral. \"A forja está fechada.\" <<Cp:EventUnit>> suspira, derrotado."

msgid "STORY_EVENT@1013_732@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Um ferreiro grisalho está entre você e uma forja ancestral. \"A forja está fechada.\" <<Cp:EventUnit>> suspira, derrotado."

msgid "STORY_EVENT@1013_732@BODY_LORE"
msgstr "\"Acho que nosso trabalho perturbou um {EnemyUnit} e <<o:EnemyUnit>> servos,\" lamenta o ferreiro. \"Eles estão em uma destruição, rasgando a forja... Mal conseguimos sair vivos. A estrutura inteira está desmoronando...\" o ferreiro enxuga <<o:EventUnit>> testa suada, lágrimas brotando em <<o:EventUnit>> olhos. \"Nosso sustento inteiro, perdido.\""

msgid "STORY_EVENT@1013_732@BUTTON_0"
msgstr "\"Eu salvarei a {EventStructure.Name} do colapso. Às armas!\""

msgid "STORY_EVENT@1013_732@BUTTON_1"
msgstr "Antes de entrar, peça aos ferreiros [gold/] para melhorar seu exército."

msgid "STORY_EVENT@1013_732@BUTTON_5"
msgstr "Deixe a {EventStructure}."

msgid "STORY_EVENT@1013_732@BUTTON_6"
msgstr "Antes de entrar, use seu conhecimento estrutural para prever qualquer colapso futuro."

msgid "STORY_EVENT@1013_732@TITLE"
msgstr "Gigantes e Escombros"

msgid "STORY_EVENT@1013_733@BODY_FOOTER"
msgstr "\"Precisaremos de algum tempo para reconstruir a {EventStructure}, mas posso oferecer a você uma de nossas obras-primas como um símbolo de nossa gratidão.\""

msgid "STORY_EVENT@1013_733@BODY_HEADER"
msgstr "Com a {EventStructure} salva, o ferreiro retorna feliz para {EventHero.Name}."

msgid "STORY_EVENT@1013_733@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Com a {EventStructure} salva, o ferreiro retorna feliz para você, curvando-se profundamente."

msgid "STORY_EVENT@1013_733@BODY_LORE"
msgstr "Os ferreiros da forja imediatamente começam a limpar os escombros. \"Agradecemos, {EventHero.Name}...\" O ferreiro resmunga enquanto <<p:EventUnit>> levanta um grande pedaço de escombros, rindo enquanto <<p:EventUnit>> revela um baú trancado. \"Lá está! Nosso cofre resistiu!\" <<Cp:EventUnit>> abre-o para revelar muitos objetos habilmente craftados."

msgid "STORY_EVENT@1013_733@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Os ferreiros da forja imediatamente começam a limpar os escombros. \"Agradecemos, {PlayerLeader.TitleName}.\" O ferreiro resmunga enquanto <<p:EventUnit>> levanta um grande pedaço de escombros, rindo enquanto <<p:EventUnit>> revela um baú trancado. \"Lá está! Nosso cofre resistiu!\" <<Cp:EventUnit>> abre-o para revelar muitos objetos habilmente craftados."

msgid "STORY_EVENT@1013_733@BUTTON_0"
msgstr "Pegue a {EventArmor}. [item/]"

msgid "STORY_EVENT@1013_733@BUTTON_1"
msgstr "Pegue a {EventWeapon}. [item/]"

msgid "STORY_EVENT@1013_733@BUTTON_2"
msgstr "Pegue o {EventTrinket}. [item/]"

msgid "STORY_EVENT@1013_733@BUTTON_3"
msgstr "\"Já que você está tão grato, eu vou pegar os três objetos.\" [item/] [evilact/]"

msgid "STORY_EVENT@1013_733@BUTTON_4"
msgstr "\"Eu não preciso de recompensa por te ajudar.\" [goodact/]"

msgid "STORY_EVENT@1013_733@TITLE"
msgstr "Gigantes e Escombros: Consequências"

msgid "STORY_EVENT@1013_736@BODY_FOOTER"
msgstr "{EventHero.FirstName} percebe que isso não é uma saída para <<P:EventHero>>... mas uma entrada para criaturas de outros mundos, escondidas além."

msgid "STORY_EVENT@1013_736@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Você percebe que isso não é uma saída para você... É uma entrada para criaturas de outros mundos, escondidas além."

msgid "STORY_EVENT@1013_736@BODY_HEADER"
msgstr "{EventHero} se aproxima da imponente {EventStructure}. Seus salões dourados são alinhados com estátuas de antigos {GLOBAL.ArchonsLoreConcept.Hyperlink} olhando para os visitantes."

msgid "STORY_EVENT@1013_736@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você se aproxima da imponente {EventStructure}. Seus salões dourados são alinhados com estátuas de antigos {GLOBAL.ArchonsLoreConcept.Hyperlink} olhando para os visitantes."

msgid "STORY_EVENT@1013_736@BODY_LORE"
msgstr "Em breve {EventHero.FirstName} e as tropas de <<o:EventHero>> entram em um grande salão com um arco coberto de runas na extremidade oposta. Dizem que essas estruturas já foram usadas como [hyperlink,GLOBAL.WorldGateLoreConcept]portais[/hyperlink] para outros mundos, mas este tem estado dormente há eras... Pelo menos, até {EventHero.FirstName} entrar. De repente, o antigo arco crepita com energia e um vórtice iluminado por estrelas aparece em seu centro. Sombras emergem por trás do véu..."

msgid "STORY_EVENT@1013_736@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Em breve você e suas tropas entram em um grande salão com um arco coberto de runas na extremidade oposta. Dizem que essas estruturas já foram usadas como [hyperlink,GLOBAL.WorldGateLoreConcept]portais[/hyperlink] para outros mundos, mas este tem estado dormente há eras... Pelo menos, até você entrar. De repente, o antigo arco crepita com energia e um vórtice iluminado por estrelas aparece em seu centro. Sombras emergem por trás do véu..."

msgid "STORY_EVENT@1013_736@BUTTON_0"
msgstr "\"Mantenham-se firmes, tropas! Nós vamos sobreviver ao que quer que passe por aquele portal!\""

msgid "STORY_EVENT@1013_736@BUTTON_1"
msgstr "Reforce suas tropas [mana/] contra os invasores astrais."

msgid "STORY_EVENT@1013_736@BUTTON_3"
msgstr "\"Nós vamos manter a {EventStructure}, protegidos pelos milagres da fé!\""

msgid "STORY_EVENT@1013_736@BUTTON_4"
msgstr "Use a magia que flui através da {EventStructure} para fortalecer seus próprios feitiços."

msgid "STORY_EVENT@1013_736@BUTTON_7"
msgstr "Recue antes que o portal se abra."

msgid "STORY_EVENT@1013_736@TITLE"
msgstr "Portal Dormente"

msgid "STORY_EVENT@1013_737@BODY_FOOTER"
msgstr "Enquanto os estudiosos chegam para investigar a grandiosa {EventStructure}, {EventHero.FirstName} pode decidir como passar <<o:EventHero>> tempo antes de <<p:EventHero>> partir."

msgid "STORY_EVENT@1013_737@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Enquanto os estudiosos chegam para investigar a grandiosa {EventStructure}, você pode decidir como passar seu tempo antes de partir."

msgid "STORY_EVENT@1013_737@BODY_HEADER"
msgstr "{EventHero.Name} e as tropas de <<o:EventHero>> sobreviveram ao ataque na {EventStructure}. Lentamente, o portal se fecha e a energia mágica no ar se dissipa."

msgid "STORY_EVENT@1013_737@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você e suas tropas sobreviveram ao ataque na {EventStructure}. Lentamente, o portal se fecha e a energia mágica no ar se dissipa."

msgid "STORY_EVENT@1013_737@BODY_LORE"
msgstr "Depois de recuperar <<o:EventHero>> fôlego, {EventHero.FirstName} pode caminhar pelos salões dourados com facilidade. Quase todas as superfícies são cobertas por runas e murais que retratam batalhas lendárias e jornadas para mundos desconhecidos. Não demora muito para que estudiosos ansiosos do seu império entrem na {EventStructure}, seus debates sussurrados sobre sua história e usos potenciais preenchendo os salões outrora abandonados."

msgid "STORY_EVENT@1013_737@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Depois de recuperar o fôlego, você pode caminhar pelos salões dourados com facilidade. Quase todas as superfícies são cobertas por runas e murais que retratam batalhas lendárias e jornadas para mundos desconhecidos. Não demora muito para que estudiosos ansiosos do seu império entrem na {EventStructure}, seus debates sussurrados sobre sua história e usos potenciais preenchendo os salões outrora abandonados."

msgid "STORY_EVENT@1013_737@BUTTON_0"
msgstr "Pegue o {EventItem} [item/] que repousa no centro da {EventStructure}."

msgid "STORY_EVENT@1013_737@BUTTON_1"
msgstr "Saqueie a {EventStructure} [gold/]."

msgid "STORY_EVENT@1013_737@BUTTON_2"
msgstr "\"A {EventStructure} será um farol de poder [influence/] para o meu {PlayerLeader.Title}.\""

msgid "STORY_EVENT@1013_737@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "\"Esta {EventStructure} será meu farol de poder [influence/].\""

msgid "STORY_EVENT@1013_737@BUTTON_3"
msgstr "Fique e aprenda com as lendas que cobrem as paredes douradas."

msgid "STORY_EVENT@1013_737@TITLE"
msgstr "Portão Adormecido: Consequências"

msgid "STORY_EVENT@1013_790@BODY_FOOTER"
msgstr "Avançando sobre {EventCity.Name}, o <<m:EventStackLeader>> não pode esperar para começar seu primeiro tesouro!"

msgid "STORY_EVENT@1013_790@BODY_HEADER"
msgstr "Um ninho de criaturas draconianas chocou perto de {EventCity.Name}, sua natureza de [hyperlink,GLOBAL.DragonsLoreConcept]dragão[/hyperlink] os compelindo a reclamar parte do seu domínio."

msgid "STORY_EVENT@1013_790@BODY_LORE"
msgstr "Eles estão totalmente crescidos, mas muito jovens para falar, mas as demandas das bestas majestosas são claras enquanto olham para {EventCity.Name} com olhos gananciosos. Seus pais lhes ensinaram como um bom ninho cheira e parece. Cheio de coisas brilhantes e cintilantes de metal, para rolar e se divertir. Para dormir e proteger. Para acumular."

msgid "STORY_EVENT@1013_790@BUTTON_0"
msgstr "Deixe algum ouro [gold/] fora de {EventCity.Name} para apaziguar o {EventStackLeader.Name}."

msgid "STORY_EVENT@1013_790@BUTTON_1"
msgstr "Esvazie seu tesouro [gold/] para satisfazer a ganância de todo o {EventSpawner.Name} por um tempo."

msgid "STORY_EVENT@1013_790@BUTTON_2"
msgstr "{EventCity.Name} não tem medo de alguns dragões jovens. Deixe-os vir."

msgid "STORY_EVENT@1013_790@BUTTON_3"
msgstr "Transmute rochas em um tesouro dourado de ouro falso para enganar o {EventStackLeader.Name}."

msgid "STORY_EVENT@1013_790@TITLE"
msgstr "Ganância Jovem"

msgid "STORY_EVENT@1013_791@BODY_FOOTER"
msgstr "O [hyperlink,GLOBAL.DragonsLoreConcept]dragão[/hyperlink] sorri através de dentes afiados como navalhas. \"Será ouro ou sangue?\""

msgid "STORY_EVENT@1013_791@BODY_HEADER"
msgstr "Dos picos do {EventSpawner.Name} perto da sua cidade {EventCity.Name}, uma sombra poderosa desceu para escurecer os céus."

msgid "STORY_EVENT@1013_791@BODY_LORE"
msgstr "Um rugido gelado ecoa através do reino de {EventCity.Name} enquanto o {EventStackLeader.Name} se aproxima, espalhando suas asas massivas. \"Você se estabeleceu em nosso domínio sem nenhum direito de fazê-lo,\" ele diz em uma voz gutural e rugindo. \"Pague o dízimo e você ainda pode ser poupado.\""

msgid "STORY_EVENT@1013_791@BUTTON_0"
msgstr "Sacrifique gado [food/] para pagar o dízimo de sangue... por agora."

msgid "STORY_EVENT@1013_791@BUTTON_1"
msgstr "Reúna ouro suficiente [gold/] para apaziguar os dragões por muito tempo."

msgid "STORY_EVENT@1013_791@BUTTON_2"
msgstr "Não tememos <<m:EventStackLeader>>. Deixe-os vir."

msgid "STORY_EVENT@1013_791@BUTTON_3"
msgstr "Sacrifique alguns de seus cidadãos [population/] pelo bem maior. [evilact/]"

msgid "STORY_EVENT@1013_791@BUTTON_4"
msgstr "Invocar uma tempestade violenta para derrotar os dragões."

msgid "STORY_EVENT@1013_791@TITLE"
msgstr "Tributos de {EventCity}"

msgid "STORY_EVENT@1013_792@BODY_FOOTER"
msgstr "Um {EventStackLeader} e seu enxame voam cada vez mais perto de {EventCity.Name}, atacando qualquer um que considerem presa."

msgid "STORY_EVENT@1013_792@BODY_HEADER"
msgstr "Bestas aladas construíram um {EventSpawner} perto de {EventCity}, ameaçando seu povo."

msgid "STORY_EVENT@1013_792@BODY_LORE"
msgstr "Agricultores estão lamentando sobre as bestas que mergulham sobre seu gado, deixando os animais mutilados ou pior. Comerciantes chegam à cidade com marcas de garras cobrindo suas carroças. \"É um pesadelo,\" eles dizem. \"Mal os ouvimos chegando antes que desçam. Tentamos evitar seu território, mas parece que os pássaros se aventuram cada vez mais a cada dia que passa.\""

msgid "STORY_EVENT@1013_792@BUTTON_0"
msgstr "Envie os homens mais bravos de {EventCity} [unitprod/] para combater a ameaça iminente."

msgid "STORY_EVENT@1013_792@BUTTON_1"
msgstr "Reúna todos os homens da cidade [unitprod/] para atacar o ninho."

msgid "STORY_EVENT@1013_792@BUTTON_2"
msgstr "Não temos medo de <<m:EventStackLeader>>. Que venham."

msgid "STORY_EVENT@1013_792@BUTTON_3"
msgstr "Ponha os céus em chamas para afastar as bestas voadoras."

msgid "STORY_EVENT@1013_792@TITLE"
msgstr "Morte do Alto"

msgid "STORY_EVENT@1013_923@BODY_FOOTER"
msgstr "Artistas de {EventHouse.Name} apresentam suas melhores obras para você na esperança de ganhar seu favor. Qual você elogia?"

msgid "STORY_EVENT@1013_923@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} convidou você para um evento celebrando cultura e arte em {EventHouse.Name}."

msgid "STORY_EVENT@1013_923@BODY_LORE"
msgstr "Muitos artistas aspirantes a mestres mostram ansiosamente suas obras. Um monólogo de um ator é interrompido por outro artista que reclama o palco, provocando olhares de despeito e inveja. {EventHouseLord.Name} murmura pensativamente. \"Até nossos melhores artistas não estão acima da competição e rivalidade, parece. Eles querem que escolhamos o que consideramos o melhor. Algum se destacou para você, {PlayerLeader.TitleName}?\""

msgid "STORY_EVENT@1013_923@BUTTON_0"
msgstr "Um dançarino cujos movimentos eram tão hipnotizantes [chaosboon/] quanto os redemoinhos de uma tempestade."

msgid "STORY_EVENT@1013_923@BUTTON_1"
msgstr "Um pintor que capturou a essência da paisagem [natureboon/] em um único traço."

msgid "STORY_EVENT@1013_923@BUTTON_2"
msgstr "Um escultor que criou uma estátua [materiumboon/] que resistirá ao teste do tempo."

msgid "STORY_EVENT@1013_923@BUTTON_3"
msgstr "Um poeta cuja história de amizade [orderboon/] quase trouxe uma lágrima aos seus olhos."

msgid "STORY_EVENT@1013_923@BUTTON_4"
msgstr "Um cantor que apresentou uma ária verdadeiramente encantadora [astralboon/]."

msgid "STORY_EVENT@1013_923@BUTTON_6"
msgstr "Um ator que expôs de forma inteligente as alianças e intrigas [influence/] na corte."

msgid "STORY_EVENT@1013_923@BUTTON_7"
msgstr "Arte é para os fracos. [evilact/] Você só aprecia a beleza do derramamento de sangue e da batalha [unitprod/]."

msgid "STORY_EVENT@1013_923@BUTTON_8"
msgstr "Um músico cuja canção solene enviou um calafrio [shadowboon/] pela sua espinha."

msgid "STORY_EVENT@1013_923@TITLE"
msgstr "Competição de Arte"

msgid "STORY_EVENT@1013_925@BODY_FOOTER"
msgstr "{EventHouseLord.FirstName} gesticula para os modelos. \"Se lhe agradar, meu {PlayerLeader.Title}, eu lhe concederia a honra de escolher o design final.\""

msgid "STORY_EVENT@1013_925@BODY_HEADER"
msgstr "{EventHouseLord.Name} de {EventHouse.Name} solicita um momento do seu tempo para um assunto de construção."

msgid "STORY_EVENT@1013_925@BODY_LORE"
msgstr "\"Como orgulhosos {EventRace.Name}, precisamos continuar melhorando nossa cidade,\" {EventHouseLord.TitleName} explica. \"Nosso projeto mais recente vai atualizar minha própria mansão. Meus arquitetos sugeriram alguns designs.\" <<Cp:EventHouseLord>> revela alguns modelos de madeira, ladeados por arquitetos nervosos."

msgid "STORY_EVENT@1013_925@BUTTON_0"
msgstr "O design que usou padrões assimétricos como inspiração, com uma nova surpresa em cada esquina. [chaosboon/]"

msgid "STORY_EVENT@1013_925@BUTTON_1"
msgstr "O design que incluía muitas praças abertas e jardins, incluindo uma grande árvore central. [natureboon/]"

msgid "STORY_EVENT@1013_925@BUTTON_2"
msgstr "O design que era tanto robusto quanto eficaz no uso de materiais. [materiumboon/]"

msgid "STORY_EVENT@1013_925@BUTTON_3"
msgstr "O design cujo salão principal era o ponto focal, incentivando todos a se deleitarem em sua glória. [orderboon/]"

msgid "STORY_EVENT@1013_925@BUTTON_4"
msgstr "O design que implementou torres altas e padrões arcano, quase alcançando o próprio Mar Astral. [astralboon/]"

msgid "STORY_EVENT@1013_925@BUTTON_6"
msgstr "\"Aqueles designs [structureprod/] parecem interessantes. Vou levá-los. [evilact/]\""

msgid "STORY_EVENT@1013_925@BUTTON_7"
msgstr "\"Por uma oferta de [gold/] eu pedirei aos meus construtores para compartilharem seus conhecimentos.\""

msgid "STORY_EVENT@1013_925@BUTTON_8"
msgstr "\"O design imponente que permite que o vento uive através dele, como se estivesse assombrado.\" [shadowboon/]"

msgid "STORY_EVENT@1013_925@TITLE"
msgstr "Grandes Planos"

msgid "STORY_EVENT@1013_927@BODY_FOOTER"
msgstr "{EventHouseLord.TitleName} pede para você pensar em um castigo para o {EventUnit.Name} que traiu <<P:EventHouseLord>>."

msgid "STORY_EVENT@1013_927@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} de {EventHouse.Name} solicitou sua opinião sobre um assunto de espionagem e traição."

msgid "STORY_EVENT@1013_927@BODY_LORE"
msgstr "\"<<PlayerLeader.Title>>, chegou ao meu conhecimento que meu mais confiável {EventUnit.Name} me traiu. <<Cp:EventUnit>> está conspirando com meu rival, {EventHouseB.Name}, vendendo meus planos defensivos e os segredos da minha—err... de natureza pessoal. Como o(a) {PlayerLeader.Title} nestas terras, você é a quem eu humildemente imploro para aplicar um castigo adequado para que isso não aconteça novamente.\""

msgid "STORY_EVENT@1013_927@BUTTON_0"
msgstr "\"Amaldiçoe uma adaga para que ela apunhale <<P:EventUnit>> nas costas para sempre, refletindo o que <<p:EventUnit>> fez com você.\" [chaosboon/]"

msgid "STORY_EVENT@1013_927@BUTTON_1"
msgstr "\"Faça com que a comida de <<o:EventUnit>> vire cinzas em <<o:EventUnit>> boca, e <<o:EventUnit>> toda bebida tenha gosto de veneno.\" [natureboon/]"

msgid "STORY_EVENT@1013_927@BUTTON_2"
msgstr "\"Amaldiçoe as mãos de <<o:EventUnit>> para que tudo e todos que <<p:EventUnit>> tocar virem pedra.\" [materiumboon/]"

msgid "STORY_EVENT@1013_927@BUTTON_3"
msgstr "\"Amaldiçoe a família e os amigos de <<o:EventUnit>> para que <<p:EventUnit>> nunca mais tenha aliados.\" [orderboon/]"

msgid "STORY_EVENT@1013_927@BUTTON_4"
msgstr "\"Garanta que <<p:EventUnit>> seja torturado por visões da traição de <<o:EventUnit>> toda vez que <<p:EventUnit>> dormir.\" [astralboon/]"

msgid "STORY_EVENT@1013_927@BUTTON_6"
msgstr "\"Eu contrataria o {EventUnit.Name} em vez disso. Traições são minha especialidade.\" [evilact/]"

msgid "STORY_EVENT@1013_927@BUTTON_7"
msgstr "\"Simples. Mate <<P:EventUnit>> e faça de <<P:EventUnit>> seu escravo morto-vivo.\" [shadowboon/]"

msgid "STORY_EVENT@1013_927@BUTTON_8"
msgstr "\"Você trouxe isso sobre si mesmo, {EventHouseLord.Name}. Eu não aplicarei um castigo.\" [goodact/]"

msgid "STORY_EVENT@1013_927@TITLE"
msgstr "Uma Maldição Pessoal"

msgid "STORY_EVENT@1013_973@BODY_FOOTER"
msgstr "Qual convidado extra você trará para o banquete de {EventHouse.Name}?"

msgid "STORY_EVENT@1013_973@BODY_HEADER"
msgstr "Para celebrar sua aliança, {EventHouseLord.Name} de {EventHouse.Name} convidou você e um convidado para um gala."

msgid "STORY_EVENT@1013_973@BODY_LORE"
msgstr "Como esperado, o gala estará repleto de eventos. {EventHouseLord.TitleName} promete todo tipo de entretenimento extremamente cult. Há um debate, um palco para performances e amplas oportunidades para forjar laços com outras cidades do reino. Você só pode enviar um convidado extra, no entanto."

msgid "STORY_EVENT@1013_973@BUTTON_0"
msgstr "Traga seu melhor arquiteto [structureprod/] de {EventCity.Name} para ser inspirado por {EventHouse.Name}."

msgid "STORY_EVENT@1013_973@BUTTON_1"
msgstr "Traga uma comitiva [influence/] para enfatizar a importância do seu reino."

msgid "STORY_EVENT@1013_973@BUTTON_2"
msgstr "Traga o sábio mais sábio [knowledge/] de {EventCity.Name} para liderar o debate."

msgid "STORY_EVENT@1013_973@BUTTON_3"
msgstr "Traga seu melhor comerciante [gold/] para melhorar o comércio com {EventCity.Name}."

msgid "STORY_EVENT@1013_973@TITLE"
msgstr "Gala Civilizado"

msgid "STORY_EVENT@1038_10@BODY_FOOTER"
msgstr "O bardo deseja escrever uma canção para você. Que sentimento você quer que ela transmita?"

msgid "STORY_EVENT@1038_10@BODY_HEADER"
msgstr "Você tratou bem seus cidadãos em {EventCity.Name}. Agora um famoso bardo entra em contato com você com um sorriso encantador iluminando <<o:EventUnit>> rosto."

msgid "STORY_EVENT@1038_10@BODY_LORE"
msgstr "\"É uma honra falar com você, grande {PlayerLeader.TitleName}!\" diz o músico extravagante, dedilhando um alaúde. \"Sou conhecido em todo o reino como um humilde bardo, contador de histórias e letrista extraordinário. Sua lenda é verdadeiramente inspiradora para mim. Eu simplesmente devo escrever uma balada sobre você. Uma canção digna do seu legado!\""

msgid "STORY_EVENT@1038_10@BUTTON_0"
msgstr "\"Faça uma canção que instile poder [unitprod/] e obediência!\""

msgid "STORY_EVENT@1038_10@BUTTON_1"
msgstr "\"Faça uma canção que minhas tropas cantarão [morale/] quando forem para a batalha!\""

msgid "STORY_EVENT@1038_10@BUTTON_2"
msgstr "\"Faça uma canção de trabalho inspiradora! [structureprod/] [food/] [knowledge/].\""

msgid "STORY_EVENT@1038_10@BUTTON_3"
msgstr "\"Uma canção sobre honra e benevolência [influence/]. Devemos ficar juntos para prosperar.\""

msgid "STORY_EVENT@1038_10@BUTTON_4"
msgstr "\"Uma canção que instila terror [influence/], intimidando meus aliados e inimigos igualmente.\""

msgid "STORY_EVENT@1038_10@TITLE"
msgstr "Canção das Eras"

msgid "STORY_EVENT@1038_174@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um dos seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> e melhorar gradualmente sua {GLOBAL.HouseInfluenceConcept.Hyperlink} para com você."

msgid "STORY_EVENT@1038_174@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} cumprimenta você com hesitação graciosa."

msgid "STORY_EVENT@1038_174@BODY_LORE"
msgstr "\"Saudações {PlayerLeader.Name}. Na verdade, achamos seus caminhos aborrecíveis, talvez até nojentos... Ainda assim, devo dizer que estou intrigado. Podemos ainda encontrar um acordo entre {EventHouse.Name} e você. Nosso caminho à frente deve ser interessante, no mínimo.\""

msgid "STORY_EVENT@1038_174@BUTTON_0"
msgstr "Envolva-se em discussões com esses cretinos pretensiosos."

msgid "STORY_EVENT@1038_174@BUTTON_1"
msgstr "Deixe sua presença dispensável por enquanto."

msgid "STORY_EVENT@1038_174@TITLE"
msgstr "Encontrando o Esnobe {EventHouse.Name}"

msgid "STORY_EVENT@1038_175@BODY_FOOTER"
msgstr "Um {EventStackLeader.Name} de {EventHouse.Name} pergunta sobre suas intenções dentro de seu domínio."

msgid "STORY_EVENT@1038_175@BODY_HEADER"
msgstr "Um {EventStackLeader} chama enquanto seu exército se aproxima do {EventStructure.Name}."

msgid "STORY_EVENT@1038_175@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Um {EventStackLeader} chama enquanto você se aproxima do {EventStructure.Name}."

msgid "STORY_EVENT@1038_175@BODY_LORE"
msgstr "\"Força, amigo de {EventHouse.Name}! Que tipo de vento trouxe você para nossas terras ancestrais hoje? Um que sopra pela casa longa, trazendo cheiros de hidromel e folia? Ou um que passa por um campo de batalha, carregando o fedor da morte, decadência e más intenções?\""

msgid "STORY_EVENT@1038_175@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "\"Força, amigo de {EventHouse.Name}! Que tipo de vento trouxe você para nossas terras ancestrais hoje? Um que sopra pela casa longa, trazendo cheiros de hidromel e folia? Ou um que passa por um campo de batalha, carregando o fedor da morte, decadência e más intenções?\""

msgid "STORY_EVENT@1038_175@BUTTON_1"
msgstr "\"Nós gostaríamos de falar com seu {EventHouseLord.TitleName}.\""

msgid "STORY_EVENT@1038_175@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"Eu gostaria de falar com seu {EventHouseLord.TitleName}.\""

msgid "STORY_EVENT@1038_175@BUTTON_2"
msgstr "\"É hora de testar sua coragem. Empunhem suas armas!\""

msgid "STORY_EVENT@1038_175@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "\"É hora de testar sua coragem. Empunhem suas armas!\""

msgid "STORY_EVENT@1038_175@BUTTON_3"
msgstr "\"Paz, guerreiro. Estamos apenas passando...\""

msgid "STORY_EVENT@1038_175@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "\"Paz, guerreiro. Estou apenas passando...\""

msgid "STORY_EVENT@1038_175@TITLE"
msgstr "Ainda Amigo... ou Inimigo?"

msgid "STORY_EVENT@1038_175@TITLE@HERO_IS_PLAYERLE"
msgstr "Ainda Amigo... ou Inimigo?"

msgid "STORY_EVENT@1038_176@BODY_FOOTER"
msgstr "Olhando para cima, {EventHero.FirstName} vê sombras contorcendo-se nos galhos, descendo rapidamente. O pobre {EventUnit} olha para {EventHero.FirstName}, implorando por ajuda."

msgid "STORY_EVENT@1038_176@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Olhando para cima, você vê sombras contorcendo-se nos galhos, descendo rapidamente. O pobre {EventUnit} olha para você, implorando por ajuda."

msgid "STORY_EVENT@1038_176@BODY_HEADER"
msgstr "A majestosa {EventStructure} se desdobra diante de {EventHero}, com luz cintilando através de suas folhas. Algo se move na copa."

msgid "STORY_EVENT@1038_176@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "A majestosa {EventStructure} se desdobra diante de você, com luz cintilando através de suas folhas. Algo se move na copa."

msgid "STORY_EVENT@1038_176@BODY_LORE"
msgstr "\"Ajuda! Ajuda! Grande <<EventHero{hero/heroine}>>! Ajuda!\" Descendo rapidamente pelo tronco da árvore massiva estão <<m:EventUnit>>, com lágrimas marcando suas bochechas. Suas orelhas pontudas tremem enquanto gritam para {EventHero.FirstName}. \"Por favor, ajude-nos! O {EnemyUnit} venenoso e os horríveis amigos de <<o:EnemyUnit>> atacam nosso ninho no topo da árvore e buscam consumir nossos amigos e nossos bebês...\""

msgid "STORY_EVENT@1038_176@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "\"Ajuda! Ajuda! Grande {PlayerLeader.Title}! Ajuda!\" Descendo rapidamente pelo tronco da árvore massiva estão <<m:EventUnit>>, com lágrimas marcando suas bochechas. Suas orelhas pontudas tremem enquanto gritam para você. \"Por favor, ajude-nos! O {EnemyUnit} venenoso e os horríveis amigos de <<o:EnemyUnit>> atacam nosso ninho no topo da árvore e buscam consumir nossos amigos e nossos bebês...\""

msgid "STORY_EVENT@1038_176@BUTTON_0"
msgstr "Ajude as fadas e ataque o {EnemyUnit}!"

msgid "STORY_EVENT@1038_176@BUTTON_1"
msgstr "Procure um antídoto [food/] contra o {EnemyUnit} venenoso."

msgid "STORY_EVENT@1038_176@BUTTON_3"
msgstr "Use seu conhecimento sobre veneno para criar um antídoto para o {EnemyUnit}."

msgid "STORY_EVENT@1038_176@BUTTON_4"
msgstr "Deixe as fadas implorando e a {EventStructure}."

msgid "STORY_EVENT@1038_176@TITLE"
msgstr "Veneno e Proteção"

msgid "STORY_EVENT@1038_177@BODY_FOOTER"
msgstr "\"Faça um pedido, e se for verdadeiro, esta recompensa será para você!\""

msgid "STORY_EVENT@1038_177@BODY_HEADER"
msgstr "Com a ameaça imediata derrotada, pequenas vozes no topo das árvores cantam seus louvores."

msgid "STORY_EVENT@1038_177@BODY_LORE"
msgstr "{EventHero.FirstName} também nota vários animais saindo de seus esconderijos, incluindo um {EventMount}. Os animais gritam e uivam e as fadas cantam: \"<<EventHero{hero/heroine}>> dos galhos quebrados, obrigado por nossa libertação. Deixe-nos cantar seus louvores agora e recompensá-lo com equivalência!\""

msgid "STORY_EVENT@1038_177@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Você também nota vários animais saindo de seus esconderijos, incluindo um {EventMount}. Os animais gritam e uivam e as fadas cantam: \"{PlayerLeader.Title} dos galhos quebrados, obrigado por nossa libertação. Deixe-nos cantar seus louvores agora e recompensá-lo com equivalência!\""

msgid "STORY_EVENT@1038_177@BUTTON_0"
msgstr "\"Eu desejo o poder venenoso que combati.\" [item/]"

msgid "STORY_EVENT@1038_177@BUTTON_1"
msgstr "\"Eu desejo montar o {EventMount.Name} [mount/] durante minhas aventuras!\""

msgid "STORY_EVENT@1038_177@BUTTON_2"
msgstr "\"Eu desejo ajuda [unit/] das criaturas da {EventStructure}.\""

msgid "STORY_EVENT@1038_177@BUTTON_4"
msgstr "\"Eu só desejo que todas as criaturas estejam seguras.\" [goodact/]"

msgid "STORY_EVENT@1038_177@TITLE"
msgstr "Veneno e Proteção: Consequências"

msgid "STORY_EVENT@1038_183@BODY_FOOTER"
msgstr "Azar, vamos lutar."

msgid "STORY_EVENT@1038_242@BODY_FOOTER"
msgstr "O {EventPlayerRace.Name} e eu estamos para sempre em sua dívida, {PlayerLeader.Title}. Diga-nos o que você precisa em sua busca."

msgid "STORY_EVENT@1038_242@BODY_HEADER"
msgstr "Você derrotou as ameaças que atormentavam {EventPlayerLeader.TitleName} e o povo de <<o:EventPlayerLeader>>."

msgid "STORY_EVENT@1038_242@BODY_LORE"
msgstr "{EventPlayerLeader.FirstName} se curva profundamente para você. \"Suas ações trazem esperança para meu povo, ó {PlayerLeader.TitleName}. Achávamos que tudo estava perdido, mas com você... podemos ter uma chance contra {EventNimue.FirstName}.\""

msgid "STORY_EVENT@1038_242@BUTTON_0"
msgstr "\"Peço seus melhores e mais bravos guerreiros [unit/] para se juntarem a mim!\""

msgid "STORY_EVENT@1038_242@BUTTON_1"
msgstr "\"Precisarei de todos os recursos que puder obter. Envie sua ajuda [food/] [structureprod/] [unitprod/] para {EventCity}.\""

msgid "STORY_EVENT@1038_242@BUTTON_2"
msgstr "\"Proponho uma aliança, {EventPlayerLeader}. Juntos podemos libertar este reino!\""

msgid "STORY_EVENT@1038_242@BUTTON_3"
msgstr "\"Apenas peço que lembre que há bondade a ser encontrada no Mar Astral.\" [goodact/]"

msgid "STORY_EVENT@1038_242@TITLE"
msgstr "Os {EventPlayerRace.Name}: Consequências"

msgid "STORY_EVENT@1038_286@BODY_FOOTER"
msgstr "\"Tentei investigar, mas não consegui avançar muito. Ainda assim, compartilharei tudo o que sei.\""

msgid "STORY_EVENT@1038_286@BODY_HEADER"
msgstr "Você encontra {ElfSurvivor.TitleName}, que lidera o que parece ser as poucas almas vivas restantes neste reino. \"Agradecemos ao Pai de Todos pela sua chegada, {PlayerLeader.TitleName}!\""

msgid "STORY_EVENT@1038_286@BODY_LORE"
msgstr "\"A Corte Eterna, este reino em nosso amado mundo natal, já foi um lugar belo,\" {ElfSurvivor.FirstName} lamenta. \"Agora, uma maldição terrível o tomou. Almas dos mortos vagueiam como os vivos. Muitos que viviam aqui fugiram ou pereceram, suas almas incapazes de seguir em frente. Algo... ou alguém, as mantém aqui.\""

msgid "STORY_EVENT@1038_286@BUTTON_0"
msgstr "\"Continue...\""

msgid "STORY_EVENT@1038_286@TITLE"
msgstr "Encontrando os Elfos de Auldweald"

msgid "STORY_EVENT@1038_287@BODY_FOOTER"
msgstr "\"Havia um império élfico no leste. Sugiro que nos aventuremos até lá e encontremos outros que possam saber mais.\""

msgid "STORY_EVENT@1038_287@BODY_HEADER"
msgstr "{Sundren.FirstName} se aproxima de você, preocupado. \"{PlayerLeader.TitleName}, recebi alguns relatórios preocupantes dos meus batedores. Muitas pessoas neste reino parecem ser... fantasmas.\""

msgid "STORY_EVENT@1038_287@BODY_LORE"
msgstr "\"Não tenho certeza do porquê desses espíritos estarem aqui. Almas que permanecem não são incomuns, mas essa densidade é... problemática. Talvez essas sejam as vozes que continuo ouvindo, sussurrando...\" Ela olha sobre o reino e parece se lembrar de algo. \"Ouvi dizer que este reino já foi lar de muitas cidades élficas. Certamente, uma delas resistiu a essa incursão fantasma.\""

msgid "STORY_EVENT@1038_287@BUTTON_0"
msgstr "\"Vou procurar vida no leste.\""

msgid "STORY_EVENT@1038_287@TITLE"
msgstr "Elfos de Auldweald"

msgid "STORY_EVENT@1038_293@BODY_FOOTER"
msgstr "Esta cidade inteira, um povo inteiro, foi afogado. Seu exército permanece em silêncio enquanto a chuva cai, sem saber o que fazer."

msgid "STORY_EVENT@1038_293@BODY_HEADER"
msgstr "Seu exército se aproxima do que deveria ter sido uma cidade orgulhosa, mas que agora parece ser nada além de um pântano salobro."

msgid "STORY_EVENT@1038_293@BODY_HEADER@HERO"
msgstr "{EventHero.Name} se aproxima do que deveria ter sido uma cidade orgulhosa, mas que agora parece ser nada além de um pântano salobro."

msgid "STORY_EVENT@1038_293@BODY_HEADER@LORD"
msgstr "Você se aproxima do que deveria ter sido uma cidade orgulhosa, mas que agora parece ser nada além de um pântano salobro."

msgid "STORY_EVENT@1038_293@BODY_LORE"
msgstr "Estruturas de pedra quebradas sobressaem das águas, desmoronando rapidamente sob a constante fúria dos elementos. Ao atravessar as ruas outrora movimentadas, seu exército não encontra sinais de vida. Cadáveres inchados enchem as ruas e mercados apodrecidos. Parece que eles não tiveram tempo nem mesmo de fugir da maré que tirou suas vidas."

msgid "STORY_EVENT@1038_293@BUTTON_0"
msgstr "\"Um dia, reconstruiremos esta cidade. Ela não será esquecida.\" [influence/]"

msgid "STORY_EVENT@1038_293@BUTTON_2"
msgstr "\"Conceda a estas pessoas seus últimos ritos [goodact/]. Elas merecem pelo menos isso.\""

msgid "STORY_EVENT@1038_293@BUTTON_3"
msgstr "\"Estudaremos esta civilização perdida. Seu conhecimento [knowledge/] não será perdido.\""

msgid "STORY_EVENT@1038_293@BUTTON_4"
msgstr "\"Saqueie [gold/] tudo o que puder encontrar. Parece que vamos precisar.\""

msgid "STORY_EVENT@1038_293@BUTTON_5"
msgstr "\"Isso é o que acontece quando você desobedece [happiness/] seu {PlayerLeader.Title}, meu {EventRace}.\" [evilact/]"

msgid "STORY_EVENT@1038_293@TITLE"
msgstr "Ecos Submersos"

msgid "STORY_EVENT@1038_307@BODY_FOOTER"
msgstr "De repente, {EventHero.FirstName} encontra <<r:EventHero>> olho no olho com um {EnemyUnit}, antes que ele desapareça novamente. O perigo se aproxima..."

msgid "STORY_EVENT@1038_307@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "De repente, suas tropas se encontram olho no olho com um {EnemyUnit}, antes que ele desapareça novamente. O perigo se aproxima..."

msgid "STORY_EVENT@1038_307@BODY_HEADER"
msgstr "{EventHero} entra na escura {EventStructure}. Costumava ser um farol grandioso e estável para todos os seres mágicos. Mas agora..."

msgid "STORY_EVENT@1038_307@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você entra na escura {EventStructure}. Costumava ser um farol grandioso e estável para todos os seres mágicos. Mas agora..."

msgid "STORY_EVENT@1038_307@BODY_LORE"
msgstr "{EventHero.FirstName} e <<o:EventHero>> exército rapidamente percebem que algo está errado. Sem se mover, eles se encontram na outra extremidade do corredor, subindo as escadas... ou de volta à porta. Fica claro que alguma força aqui está distorcendo a torre e deslocando seus móveis — e todos dentro dela. <<g:army^n,EventHero>> se espalha enquanto se encontram deslocados por toda a torre."

msgid "STORY_EVENT@1038_307@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Você e seu exército rapidamente percebem que algo está errado. Sem se mover, você se encontra na outra extremidade do corredor, subindo as escadas... ou de volta à porta. Fica claro que alguma força aqui está distorcendo a torre e deslocando seus móveis — e todos dentro dela. Seu exército se espalha enquanto se encontram deslocados por toda a torre."

msgid "STORY_EVENT@1038_307@BUTTON_0"
msgstr "Atacar as criaturas que assombram a {EventStructure} amaldiçoada!"

msgid "STORY_EVENT@1038_307@BUTTON_1"
msgstr "Use sua proeza arcana [mana/] para atrasar os deslocamentos."

msgid "STORY_EVENT@1038_307@BUTTON_3"
msgstr "Conecte-se aos fluxos selvagens do Mar Astral. Use-os a seu favor."

msgid "STORY_EVENT@1038_307@BUTTON_5"
msgstr "Deixe a {EventStructure} distorcida."

msgid "STORY_EVENT@1038_307@TITLE"
msgstr "Torre Distorcida"

msgid "STORY_EVENT@1038_308@BODY_FOOTER"
msgstr "Um experimento falho causou os problemas na torre. Que objeto {EventHero.FirstName} salva antes que seja distorcido no {GLOBAL.AstralSeaLoreConcept.Hyperlink}?"

msgid "STORY_EVENT@1038_308@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Um experimento arcano falho causou os problemas na torre. Que objeto você salva antes que seja distorcido no {GLOBAL.AstralSeaLoreConcept.Hyperlink}?"

msgid "STORY_EVENT@1038_308@BODY_HEADER"
msgstr "Após derrotar as criaturas na {EventStructure} distorcida, um certo senso de paz retorna à torre retorcida."

msgid "STORY_EVENT@1038_308@BODY_LORE"
msgstr "A torre agora pode ser atravessada com relativa facilidade, embora a distorção continue. <<g:army^n,EventHero>> tenta coletar o máximo de livros e riquezas possível para evitar que os objetos apareçam e desapareçam da existência. {EventHero.FirstName} entra na torre mais alta da torre, onde o deslocamento parece mais forte, e encontra o corpo de um feiticeiro... distorcido em uma parede."

msgid "STORY_EVENT@1038_308@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "A torre agora pode ser atravessada com relativa facilidade, embora a distorção continue. Seu exército tenta coletar o máximo de livros e riquezas possível para evitar que os objetos apareçam e desapareçam da existência. Você entra na torre mais alta da torre, onde o deslocamento parece mais forte, e encontra o corpo de um feiticeiro... distorcido em uma parede."

msgid "STORY_EVENT@1038_308@BUTTON_1"
msgstr "Salve o {EventItem}."

msgid "STORY_EVENT@1038_308@BUTTON_2"
msgstr "Salve o baú cheio de riquezas [gold/]."

msgid "STORY_EVENT@1038_308@BUTTON_3"
msgstr "Salve o Tomo Ancestral."

msgid "STORY_EVENT@1038_308@BUTTON_4"
msgstr "Salve o vaso de almas [soul/]."

msgid "STORY_EVENT@1038_308@TITLE"
msgstr "Torre Distorcida: Consequências"

msgid "STORY_EVENT@1038_309@BODY_FOOTER"
msgstr "Os dois dragões se levantam, pairando acima de {EventHero.FirstName}. \"Deixe nossos tesouros, ou enfrete nossa fúria!\""

msgid "STORY_EVENT@1038_309@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Os dois dragões se levantam, pairando acima de você. \"Deixe nossos tesouros, ou enfrete nossa fúria!\""

msgid "STORY_EVENT@1038_309@BODY_HEADER"
msgstr "A ancestral {EventStructure} ergue-se diante de {EventHero.Name}. Dentro, <<p:EventHero>> encontra dois {GLOBAL.DragonsLoreConcept.Hyperlink} descansando em extremidades opostas do salão."

msgid "STORY_EVENT@1038_309@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "A antiga {EventStructure} se ergue diante de você. Dentro, você encontra dois {GLOBAL.DragonsLoreConcept.Hyperlink} descansando em extremidades opostas do salão."

msgid "STORY_EVENT@1038_309@BODY_LORE"
msgstr "Cada dragão parece estar guardando metade de um tesouro considerável. \"Intruso\", diz o primeiro, um {EventDragon} real. \"Ousas entrar no meu tesouro? Deixa teu tributo, ou eu derramarei minha ira flamejante sobre ti!\"[br/]O segundo, um {EventDragon2}, olha furioso para o outro antes de voltar-se para {EventHero.FirstName} com um sorriso frio. \"Sugiro que corras, pequeno rato.\""

msgid "STORY_EVENT@1038_309@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Cada dragão parece estar guardando metade de um tesouro considerável. \"Intruso\", diz o primeiro, um {EventDragon} real. \"Ousas entrar no meu tesouro? Deixa teu tributo, ou eu derramarei minha ira flamejante sobre ti!\"[br/]O segundo, um {EventDragon2}, olha furioso para o outro antes de voltar-se para {EventHero.FirstName} com um sorriso frio. \"Sugiro que corras, pequeno {PlayerLeader.Title}.\""

msgid "STORY_EVENT@1038_309@BUTTON_0"
msgstr "Atacar os dragões!"

msgid "STORY_EVENT@1038_309@BUTTON_1"
msgstr "Conjurar um feitiço rápido [mana/] para proteger suas tropas antes de engajar."

msgid "STORY_EVENT@1038_309@BUTTON_3"
msgstr "Questionar cujo tesouro é maior, para provocar uma luta."

msgid "STORY_EVENT@1038_309@BUTTON_4"
msgstr "\"Eu trago a ambos tributo [gold/], poderosos dragões. Voltem a dormir.\""

msgid "STORY_EVENT@1038_309@BUTTON_7"
msgstr "Fugir."

msgid "STORY_EVENT@1038_309@TITLE"
msgstr "Dois Dragões"

msgid "STORY_EVENT@1038_310@BODY_FOOTER"
msgstr "O tesouro dos dragões é seu para tomar. Qual item chama a atenção de <<g:eye^n,EventHero>>?"

msgid "STORY_EVENT@1038_310@BODY_HEADER"
msgstr "Com a ameaça dos {GLOBAL.DragonsLoreConcept.Hyperlink} removida, {EventHero} ganhou acesso à {EventStructure}."

msgid "STORY_EVENT@1038_310@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Com a ameaça dos {GLOBAL.DragonsLoreConcept.Hyperlink} removida, você ganhou acesso à {EventStructure}."

msgid "STORY_EVENT@1038_310@BODY_LORE"
msgstr "Ao longo das eras que passaram neste reino, os dragões acumularam um tesouro considerável, seu conteúdo meticulosamente dividido ao meio. {EventHero.FirstName} até encontra alguns objetos quebrados, como se os dragões não soubessem como dividir a riqueza de outra forma. Felizmente, a maioria dos tesouros foi mantida intacta."

msgid "STORY_EVENT@1038_310@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Ao longo das eras que passaram neste reino, os dragões acumularam um tesouro considerável, seu conteúdo meticulosamente dividido ao meio. Você até encontra alguns objetos quebrados, como se os dragões não soubessem como dividir a riqueza de outra forma. Felizmente, a maioria dos tesouros foi mantida intacta."

msgid "STORY_EVENT@1038_310@BUTTON_0"
msgstr "O {EventRing} do {EventDragon}. [item/]"

msgid "STORY_EVENT@1038_310@BUTTON_2"
msgstr "A {EventWeapon} do {EventDragon2}. [item/]"

msgid "STORY_EVENT@1038_310@BUTTON_3"
msgstr "Reparar o trono quebrado. [influence/]"

msgid "STORY_EVENT@1038_310@BUTTON_4"
msgstr "Reparar o {EventUnit} desativado. [unit/]"

msgid "STORY_EVENT@1038_310@TITLE"
msgstr "Dois Dragões: Desfecho"

msgid "STORY_EVENT@1038_317@BODY_FOOTER"
msgstr "\"Um poderoso {GLOBAL.GodirLoreConcept.Hyperlink} deve reclamar este reino para mudar seu destino. Talvez... esse Godir não deva ser eu.\""

msgid "STORY_EVENT@1038_317@BODY_FOOTER@MEANDOR_DEFEATED"
msgstr "\"O que eu fiz...\" Suas palavras desaparecem. \"Na minha ausência... livre o reino da minha maldição.\""

msgid "STORY_EVENT@1038_317@BODY_HEADER"
msgstr "Ao eliminar suas fontes, você quebrou o feitiço que manteve Meandor ocupado por tanto tempo. Você é contactado pelo próprio {Meandor.Title}."

msgid "STORY_EVENT@1038_317@BODY_HEADER@MEANDOR_DEFEATED"
msgstr "Ao eliminar suas fontes, você quebrou o feitiço que manteve Meandor ocupado. Mesmo através do vazio, ele consegue contatar você."

msgid "STORY_EVENT@1038_317@BODY_LORE"
msgstr "\"Uma névoa... está se dissipando. Foi você quem fez isso, {PlayerLeader.TitleName}? Talvez nem todos que visitam sejam invasores, afinal.\"[br/]Seu olhar se volta para o reino fantasmagórico ao seu redor. \"Parece que nem eu posso me dar o consolo que tanto anseio. Durante minha... aflição, coloquei coisas em movimento que não posso desfazer sozinho. Mais e mais {GLOBAL.SoulsLoreConcept.Hyperlink} serão atraídos para cá.\""

msgid "STORY_EVENT@1038_317@BODY_LORE@MEANDOR_DEFEATED"
msgstr "\"No vazio, sinto que uma névoa está... se dissipando. Foi você quem fez isso, {PlayerLeader.TitleName}? Vejo agora que eu estava... aflito. Coloquei coisas em movimento que não podem ser desfeitas. Mesmo agora... sinto como mais e mais almas são atraídas para o reino que criei. Elas logo serão vítimas de predadores do Mar Astral...\""

msgid "STORY_EVENT@1038_317@BUTTON_0"
msgstr "\"Aceite sua derrota, então, {Meandor.TitleName}, e deixe este reino para que eu possa resolver o que você causou.\""

msgid "STORY_EVENT@1038_317@BUTTON_6"
msgstr "\"Eu proponho uma aliança. Vamos reclamar este reino e libertar suas almas, juntos!\""

msgid "STORY_EVENT@1038_317@BUTTON_7"
msgstr "Deixe o {Meandor.Title} viajar através do vazio por enquanto."

msgid "STORY_EVENT@1038_317@TITLE"
msgstr "Teia Rasgada da Loucura"

msgid "STORY_EVENT@1038_319@BODY_FOOTER"
msgstr "{Sundren.Name} foi ferida, mas escapou da morte. Levará algum tempo para ela recuperar sua força."

msgid "STORY_EVENT@1038_319@BODY_HEADER"
msgstr "{Sundren.TitleName} foi derrotada em batalha sob seu comando!"

msgid "STORY_EVENT@1038_319@BODY_LORE"
msgstr "Através de esforço, sorte ou algo mais, ela conseguiu sobreviver ao ataque e voltou em segurança, onde aparece em uma nuvem de sombras. Ela faz uma careta, uma expressão mais sombria marcando seu rosto antes que as sombras desapareçam e ela se volta para você novamente. \"Eu resisti a muitas dificuldades no {GLOBAL.AstralVoidLoreConcept.Hyperlink}. Ele não me reclamará ainda.\""

msgid "STORY_EVENT@1038_319@BUTTON_3"
msgstr "Que assim seja."

msgid "STORY_EVENT@1038_319@TITLE"
msgstr "Sundren Derrotada"

msgid "STORY_EVENT@1038_4@BODY_FOOTER"
msgstr "Os cidadãos oferecem esculpir uma estátua em sua semelhança! Qual pose melhor captura suas qualidades?"

msgid "STORY_EVENT@1038_4@BODY_HEADER"
msgstr "Você tratou bem seus cidadãos em {EventCity.Name}. Agora um escultor se aproxima de você, curvando-se reverentemente."

msgid "STORY_EVENT@1038_4@BODY_LORE"
msgstr "\"Saudações, {PlayerLeader.TitleName}. O povo de {EventCity.Name} me contratou, um humilde escultor de semelhanças de Reis e Godir, para imortalizar sua imagem em mármore e pedra fluida. Materiais difíceis de trabalhar, mas eu não usaria nada menos para um {PlayerLeader.Title} de sua estatura. Por favor, se você fosse tão gentil a ponto de assumir uma pose...\""

msgid "STORY_EVENT@1038_4@BUTTON_0"
msgstr "Uma atitude ponderada [knowledge/], buscando respostas."

msgid "STORY_EVENT@1038_4@BUTTON_1"
msgstr "Uma postura defensiva [production/], protetor da cidade."

msgid "STORY_EVENT@1038_4@BUTTON_3"
msgstr "Um rugido de batalha [unitprod/], arma erguida alto."

msgid "STORY_EVENT@1038_4@BUTTON_4"
msgstr "Um gesto benevolente [influence/], mão estendida para ajudar."

msgid "STORY_EVENT@1038_4@BUTTON_5"
msgstr "Uma postura imponente; um tirano [influence/] a ser temido."

msgid "STORY_EVENT@1038_4@TITLE"
msgstr "Esculpido em Pedra"

msgid "STORY_EVENT@1038_52@BODY_FOOTER"
msgstr "Algo despertou os mortos nas proximidades. A horda que se aproxima está indo para {EventCity.Name}!"

msgid "STORY_EVENT@1038_52@BODY_HEADER"
msgstr "Uma ameaça sombria paira à beira de {EventCity.Name}, sua cidade."

msgid "STORY_EVENT@1038_52@BODY_LORE"
msgstr "Uma viúva se aproxima de você, apoiada por um guarda da cidade. Ela está muito chateada. \"{PlayerLeader.Title}, é... é terrível! Eu fui visitar o túmulo do meu falecido marido. Eu vou lá frequentemente para colocar flores frescas nele, e ele, ele...\" Ela começa a chorar, e o guarda continua sua história.[br/][br/]\"Seu marido surgiu do túmulo e a atacou. Quando ela fugiu, viu outros... outros corpos, cambaleando em direção à cidade.\""

msgid "STORY_EVENT@1038_52@BUTTON_0"
msgstr "Afaste os mortos com luz e truques de magia [mana/]... por enquanto."

msgid "STORY_EVENT@1038_52@BUTTON_1"
msgstr "Envie um grupo especializado de magos [mana/] para expulsar os mortos de volta ao seu {EventSpawner}."

msgid "STORY_EVENT@1038_52@BUTTON_2"
msgstr "Use sua conexão com os mortos para transformar a horda que se aproxima em seu aliado."

msgid "STORY_EVENT@1038_52@BUTTON_3"
msgstr "\"Os mortos não nos assustam. {EventCity} está pronta para eles.\""

msgid "STORY_EVENT@1038_52@TITLE"
msgstr "Mortos Inquietos"

msgid "STORY_EVENT@1038_55@BODY_FOOTER"
msgstr "\"Tema nossa convocação. Tema a ira dos Shad'rai!\""

msgid "STORY_EVENT@1038_55@BODY_HEADER"
msgstr "Por muito tempo, o {EventSpawner} perto da sua cidade de {EventCity} ficou inalterado. Agora, suas criações sombrias vagam livremente, ameaçando toda a área."

msgid "STORY_EVENT@1038_55@BODY_LORE"
msgstr "\"Contemplem, o grandioso {EventUnit}!\" um dos cultistas grita de longe. \"Na gloriosa luz de Yaka e com os ventos rápidos de Artica, nós conquistaremos todos vocês e provaremos que somos dignos dos {GLOBAL.ShadraiFactionLoreConcept.Hyperlink}! Pois eles são os verdadeiros {GLOBAL.GodirLoreConcept.Hyperlink} e só eles têm o verdadeiro poder.\""

msgid "STORY_EVENT@1038_55@BUTTON_0"
msgstr "Ordene que seus magos [mana/] destruam os cultistas mais próximos de {EventCity}."

msgid "STORY_EVENT@1038_55@BUTTON_1"
msgstr "Ordene que seus magos [mana/] expulsem todos os cultistas de volta ao {EventSpawner.Name}."

msgid "STORY_EVENT@1038_55@BUTTON_2"
msgstr "Seus rituais serão como nada contra o poder de {EventCity.Name}."

msgid "STORY_EVENT@1038_55@BUTTON_3"
msgstr "Subjugue o {EventUnit} à sua própria vontade."

msgid "STORY_EVENT@1038_55@TITLE"
msgstr "Assuntos dos Shad'rai"

msgid "STORY_EVENT@1038_56@BODY_FOOTER"
msgstr "{EventHouseLord.Name} e o vencedor da brutal batalha da arena olham para você, esperando palavras de reconhecimento."

msgid "STORY_EVENT@1038_56@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} convidou você para ver <<o:EventHouseLord>> guerreiros de {EventHouse.Name} em ação."

msgid "STORY_EVENT@1038_56@BODY_LORE"
msgstr "Sua arena \"improvisada\" é uma bagunça manchada de sangue. Os gritos altos e o cheiro de suor são difíceis de ignorar enquanto esquadrões variados se esmagam uns aos outros no chão. Quando a batalha termina, o vencedor revela uma boca sorridente cheia de dentes quebrados, um olho inchado e fechado. A multidão aplaude e o vencedor levanta um punho para você em vitória."

msgid "STORY_EVENT@1038_56@BUTTON_0"
msgstr "\"Bem feito. A sorte favorece os corajosos [chaosboon/] e você certamente foi!\""

msgid "STORY_EVENT@1038_56@BUTTON_1"
msgstr "\"Bem feito. Sua bestialidade interior [natureboon/] garantiu sua vitória.\""

msgid "STORY_EVENT@1038_56@BUTTON_2"
msgstr "\"Bem feito. Sua vitória é um sinal de verdadeiro domínio de armas. [materiumboon/]\""

msgid "STORY_EVENT@1038_56@BUTTON_3"
msgstr "\"Bem feito. Que esta vitória fortaleça sua fé [orderboon/] e convicções.\""

msgid "STORY_EVENT@1038_56@BUTTON_4"
msgstr "\"Bem feito. Sua vitória fala por seu conhecimento [astralboon/] e perspicácia.\""

msgid "STORY_EVENT@1038_56@BUTTON_6"
msgstr "\"Bem feito. Convidamos <<g:Pit Champion^n,EventHouseLord>> [unit/] a se juntar às minhas fileiras.\""

msgid "STORY_EVENT@1038_56@BUTTON_7"
msgstr "\"Esta exibição de violência me apavora [goodact/]. Todos vocês deveriam se envergonhar.\""

msgid "STORY_EVENT@1038_56@BUTTON_8"
msgstr "\"Bem feito. Nunca encontrei um aliado da morte como você antes.\" [shadowboon/]."

msgid "STORY_EVENT@1038_56@TITLE"
msgstr "Campeão do Poço"

msgid "STORY_EVENT@1038_62@BODY_FOOTER"
msgstr "{EventHouseLord.TitleName} pede que você diga algo aos cavaleiros contendores. Qual discurso você dá?"

msgid "STORY_EVENT@1038_62@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} convidou você para assistir a um torneio, sediado em {EventHouse.Name}."

msgid "STORY_EVENT@1038_62@BODY_LORE"
msgstr "Seis cavaleiros dos {EventHouseRace.Name} montam e curvam-se reverentemente a você e ao seu {EventHouseLord.Title}. \"Torneios são oportunidades perfeitas para nossos cavaleiros mostrarem seu valor\", diz {EventHouseLord.Name}. \"Todos nós ficamos felizes em ver seu interesse em nossa cultura, {PlayerLeader.TitleName}. Se lhe agradar, esses cavaleiros ficariam honrados se você lhes dirigisse algumas palavras.\""

msgid "STORY_EVENT@1038_62@BUTTON_0"
msgstr "\"Que sua espada seja afiada e a sorte [chaosboon/] esteja ao seu lado!\""

msgid "STORY_EVENT@1038_62@BUTTON_1"
msgstr "\"Nunca esqueça seus progenitores [natureboon/], que lhe deram sua força.\""

msgid "STORY_EVENT@1038_62@BUTTON_2"
msgstr "\"Que sua armadura seja resistente [materiumboon/] e seu escudo inquebrável.\""

msgid "STORY_EVENT@1038_62@BUTTON_3"
msgstr "\"Que você seja um farol de esperança [orderboon/] para seu povo.\""

msgid "STORY_EVENT@1038_62@BUTTON_4"
msgstr "\"Aprimore sua mente [astralboon/] como faria com sua espada para alcançar a vitória.\""

msgid "STORY_EVENT@1038_62@BUTTON_6"
msgstr "\"O melhor de você [unit/] é permitido a juntar-se ao meu exército!\""

msgid "STORY_EVENT@1038_62@BUTTON_7"
msgstr "\"Virtudes cavalheirescas [goodact/] elevam cavaleiros acima de soldados comuns.\""

msgid "STORY_EVENT@1038_62@BUTTON_8"
msgstr "\"Quando a morte está ao seu lado, você não precisa temer nada.\" [shadowboon/]"

msgid "STORY_EVENT@1038_62@TITLE"
msgstr "Favor do {PlayerLeader.Title}"

msgid "STORY_EVENT@1038_9@BODY_FOOTER"
msgstr "Os cidadãos em tumulto são afetados por {GLOBAL.CityStabilityConcept.Hyperlink} e exigem alguma forma de socorro."

msgid "STORY_EVENT@1038_9@BODY_HEADER"
msgstr "Você negligenciou sua população de {EventCity.Name}. Agora, eles estão em tumulto nas ruas."

msgid "STORY_EVENT@1038_9@BODY_LORE"
msgstr "Os sons de gritos e vidros quebrando ecoam pela cidade. Mercadores se escondem enquanto suas lojas são saqueadas por uma multidão enfurecida. Um grande grupo de cidadãos avança para confrontá-lo. \"Você e seus supostos lordes e damas ficam aí no luxo enquanto nós trabalhamos na lama! Você nos negou toda chance de conforto. Chega!\""

msgid "STORY_EVENT@1038_9@BUTTON_0"
msgstr "Faça seus magos [mana/] distraírem eles [happiness/] com magia e fogos de artifício."

msgid "STORY_EVENT@1038_9@BUTTON_1"
msgstr "Crie alguma forma de distração para os cidadãos [happiness/] você mesmo por agora."

msgid "STORY_EVENT@1038_9@BUTTON_2"
msgstr "Implante a guarnição [unitprod/] para restaurar a ordem [happiness/] à força."

msgid "STORY_EVENT@1038_9@BUTTON_3"
msgstr "Reúna os tumultuadores e execute-os. [evilact/]. [happiness/]"

msgid "STORY_EVENT@1038_9@BUTTON_4"
msgstr "\"Não tenho tempo para isso.\""

msgid "STORY_EVENT@1038_9@TITLE"
msgstr "Tumulto em {EventCity.Name}"

msgid "STORY_EVENT@1042_10@BODY_FOOTER"
msgstr "O grupo guardando o {EventStructure.Name} está esperando você mostrar sua intenção."

msgid "STORY_EVENT@1042_10@BODY_HEADER"
msgstr "{EventHero.Name} se aproxima de uma delegação de {EventHouse.Name} e é recebido por rostos amigáveis."

msgid "STORY_EVENT@1042_10@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você se aproxima de uma delegação de {EventHouse.Name} e é recebido por rostos amigáveis."

msgid "STORY_EVENT@1042_10@BODY_LORE"
msgstr "\"Saudações, viajante! O que te traz aqui?\" O {EventStackLeader.Name} sorri, obviamente à vontade com <<g:presence^n,{EventHero.FirstName}>>. \"Nós garantimos o {EventStructure.Name} para {EventHouse.Name} e estamos guardando-o contra bandidos.\""

msgid "STORY_EVENT@1042_10@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "\"Saudações, {PlayerLeader.Title}! O que te traz aqui?\" O {EventStackLeader.Name} sorri, obviamente à vontade com sua presença. \"Nós garantimos o {EventStructure.Name} para {EventHouse.Name} e estamos guardando-o contra bandidos.\""

msgid "STORY_EVENT@1042_10@BUTTON_0"
msgstr "\"Certamente {EventHouseLord.Name} não se importará [influence/] se nós ocuparmos este local.\""

msgid "STORY_EVENT@1042_10@BUTTON_0@HERO_IS_PLAYERLE"
msgstr "\"Certamente {EventHouseLord.Name} não se importará [influence/] se eu tomar este local para mim.\""

msgid "STORY_EVENT@1042_10@BUTTON_1"
msgstr "\"Abandonem seus postos ou enfrentem nosso aço.\""

msgid "STORY_EVENT@1042_10@BUTTON_2"
msgstr "\"Vamos apagar esses sorrisos dos seus rostos! Às armas!\""

msgid "STORY_EVENT@1042_10@BUTTON_3"
msgstr "\"Estamos apenas passando por aqui...\""

msgid "STORY_EVENT@1042_10@TITLE"
msgstr "Guardas Credulos"

msgid "STORY_EVENT@1042_1@BODY_FOOTER"
msgstr "O {EventStackLeader} liderando este exército parece suspeitar de suas motivações, mas talvez <<p:EventStackLeader>> possa ser persuadido."

msgid "STORY_EVENT@1042_1@BODY_HEADER"
msgstr "Um {EventStackLeader} carregando a bandeira de {EventHouse.Name} avança enquanto {EventHero.Name} se aproxima."

msgid "STORY_EVENT@1042_1@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Um {EventStackLeader} carregando a bandeira de {EventHouse.Name} avança enquanto você se aproxima."

msgid "STORY_EVENT@1042_1@BODY_LORE"
msgstr "\"Pare bem aí!\" A aparência do {EventStackLeader} indica claramente que <<p:EventStackLeader>> é o líder deste exército. \"Estamos aqui em nome de {EventHouse.Name} para proteger a {EventStructure.Name} local e seus recursos, mesmo de um {PlayerLeader.Title}.\" A suspeita é clara nos olhos de <<o:EventStackLeader>> enquanto <<p:EventStackLeader>> avalia suas forças. \"O que te traz aqui?\""

msgid "STORY_EVENT@1042_1@BUTTON_1"
msgstr "\"Aqui está um saco de razões [gold/] para você ir embora sem derramamento de sangue.\""

msgid "STORY_EVENT@1042_1@BUTTON_2"
msgstr "\"Se você deseja ser nosso inimigo, que assim seja.\""

msgid "STORY_EVENT@1042_1@BUTTON_3"
msgstr "\"Estamos apenas passando por aqui...\""

msgid "STORY_EVENT@1042_1@TITLE"
msgstr "Um Encontro Tenso"

msgid "STORY_EVENT@1042_8@BODY_FOOTER"
msgstr "O exército guardando a {EventStructure.Name} parece abatido e desmoralizado."

msgid "STORY_EVENT@1042_8@BODY_HEADER"
msgstr "{EventHero.Name} encontra um exército de {EventHouse.Name}, sua aparência desleixada e descuidada."

msgid "STORY_EVENT@1042_8@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você encontra um exército de {EventHouse.Name}, sua aparência desleixada e descuidada."

msgid "STORY_EVENT@1042_8@BODY_LORE"
msgstr "\"Agradeçamos ao {GLOBAL.GodirLoreConcept.Hyperlink}! Estamos tão felizes em ver um rosto amigável!\" diz seu líder, aliviado por ter encontrado companhia. \"Fomos encarregados de guardar a {EventStructure.Name}, mas estamos aqui há eras sem reforços... Estamos doentes, famintos e cansados!\" Os guardas atrás de <<P:EventStackLeader>> resmungam em concordância."

msgid "STORY_EVENT@1042_8@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "\"Agradeçamos ao {GLOBAL.GodirLoreConcept.Hyperlink}! Estamos tão felizes em ver um rosto amigável!\" diz seu líder, aliviado por ter encontrado companhia. \"Fomos encarregados de guardar a {EventStructure.Name}, mas estamos aqui há eras sem reforços... Estamos doentes, famintos e cansados!\" Os guardas atrás de <<P:EventStackLeader>> resmungam em concordância."

msgid "STORY_EVENT@1042_8@BUTTON_0"
msgstr "\"Alguma comida [food/] te persuadiria a deixar este local para nós?\""

msgid "STORY_EVENT@1042_8@BUTTON_0@HERO_IS_PLAYERLE"
msgstr "\"Alguma comida [food/] te persuadiria a deixar este local para mim?\""

msgid "STORY_EVENT@1042_8@BUTTON_1"
msgstr "\"Junte-se a nós! Você nunca mais estará cansado...\""

msgid "STORY_EVENT@1042_8@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"Junte-se a mim! Você nunca mais estará cansado...\""

msgid "STORY_EVENT@1042_8@BUTTON_2"
msgstr "\"Nós vamos acabar com seu sofrimento, então. Às armas!\""

msgid "STORY_EVENT@1042_8@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "\"Eu acabarei com seu sofrimento, então. Às armas!\""

msgid "STORY_EVENT@1042_8@BUTTON_3"
msgstr "\"Estamos apenas passando por aqui...\""

msgid "STORY_EVENT@1042_8@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "\"Estou apenas passando por aqui...\""

msgid "STORY_EVENT@1042_8@TITLE"
msgstr "Guardas Inquietos"

msgid "STORY_EVENT@1048_18@BODY_FOOTER"
msgstr "Você supera em muito o número desses guardas. Você os deixa sair da {EventStructure.Name} sem lutar?"

msgid "STORY_EVENT@1048_18@BODY_HEADER"
msgstr "À medida que suas tropas se aproximam do bando de guardas mercenários, eles levantam a bandeira branca."

msgid "STORY_EVENT@1048_18@BODY_LORE"
msgstr "\"Fomos contratados por um mercador rico para cuidar da {EventStructure.Name}\", explica o líder da gangue, um {EventStackLeader.Name}. \"Esperávamos protegê-la de canalhas errantes, não de um assalto em grande escala! Por favor, aceite nossa rendição e nos deixe ir!\""

msgid "STORY_EVENT@1048_18@BUTTON_0"
msgstr "\"Isso é o que vocês ganham por se tornarem mercenários! [evilact/] Ataquem!\""

msgid "STORY_EVENT@1048_18@BUTTON_1"
msgstr "\"Não temos desavenças com vocês. [goodact/] Saiam em paz.\""

msgid "STORY_EVENT@1048_18@BUTTON_2"
msgstr "\"Que tal mudarmos seu contrato [gold/]... para servir a mim!\" [unit/]"

msgid "STORY_EVENT@1048_18@TITLE"
msgstr "Risco Ocupacional"

msgid "STORY_EVENT@1048_22@BODY_FOOTER"
msgstr "Você os deixa ir e pede paz com {EventHouse.Name}?"

msgid "STORY_EVENT@1048_22@BODY_HEADER"
msgstr "Suas tropas capturam uma divisão inimiga que se separou de {EventHouse.Name}."

msgid "STORY_EVENT@1048_22@BODY_LORE"
msgstr "Ansiosos, eles enviam seu capitão, um {EventStackLeader.Name}, para negociar sua rendição. \"Nosso {EventHouseLord.TitleName} de {EventHouse.Name} é um grande governador, mas um marechal fraco. Estamos perdendo esta guerra. <<Co:EventHouseLord>> outros generais são orgulhosos demais para admitir, mas alguém tem que enfrentar {EventHouseLord.Name}. Deixe-nos recuar, e eu prometo que haverá paz novamente.\""

msgid "STORY_EVENT@1048_22@BUTTON_0"
msgstr "\"Esta guerra só começou. [evilact/] Ataquem!\""

msgid "STORY_EVENT@1048_22@BUTTON_1"
msgstr "\"Hoje, vocês podem sair ilesos. [goodact/] Mas saibam que não haverá paz amanhã.\""

msgid "STORY_EVENT@1048_22@BUTTON_2"
msgstr "\"Vocês podem sair se garantirem que nossas boas intenções sejam conhecidas por {EventHouseLord.Name}.\""

msgid "STORY_EVENT@1048_22@TITLE"
msgstr "Causa Perdida"

msgid "STORY_EVENT@1048_23@BODY_FOOTER"
msgstr "As tropas veem sua proeza e querem se juntar à sua causa!"

msgid "STORY_EVENT@1048_23@BODY_HEADER"
msgstr "O exército inimigo de {EventHouse.Name} recebe suas tropas com saudações amigáveis."

msgid "STORY_EVENT@1048_23@BODY_LORE"
msgstr "Com um ar patético, seu capitão vem à frente: \"Saudações, {PlayerLeader.TitleName}! Viva o {PlayerLeader.Title} cujos feitos no campo de batalha comandam a admiração até de <<o:PlayerLeader>> inimigos. Minha divisão há muito sonha em seguir um líder de tal poder. Estamos cansados do vil {EventHouseLord.Name} e <<o:EventHouseLord>> {EventHouse.Name}—permita-nos lutar em seu nome!\""

msgid "STORY_EVENT@1048_23@BUTTON_0"
msgstr "\"Permitir que um inimigo se junte às forças? Morram [evilact/], seus tolos!\""

msgid "STORY_EVENT@1048_23@BUTTON_1"
msgstr "\"Não há espaço para traidores em minhas fileiras [goodact/]. Fora daqui!\""

msgid "STORY_EVENT@1048_23@BUTTON_2"
msgstr "\"Quem rejeitaria o serviço [unit/] de alguém com tão bom gosto?\""

msgid "STORY_EVENT@1048_23@TITLE"
msgstr "Desertores Audaciosos"

msgid "STORY_EVENT@1048_27@BODY_FOOTER"
msgstr "Como você deseja comemorar a engenhosidade demonstrada por seus {EventRace}?"

msgid "STORY_EVENT@1048_27@BODY_HEADER"
msgstr "Na praça principal de sua cidade {EventCity.Name}, está ocorrendo uma feira de construção."

msgid "STORY_EVENT@1048_27@BODY_LORE"
msgstr "Construtores de todo o continente se reuniram para se maravilhar com as últimas máquinas e invenções criadas pelos {EventRace.Name}. Os métodos de produção desenvolvidos por seu povo despertaram o interesse de muitos governantes."

msgid "STORY_EVENT@1048_27@BUTTON_0"
msgstr "Vender [gold/] os planos de produção para os maiores lanceiros."

msgid "STORY_EVENT@1048_27@BUTTON_1"
msgstr "Faça um discurso [happiness/] sobre a importância da Produção para o seu império."

msgid "STORY_EVENT@1048_27@BUTTON_2"
msgstr "Olhe para o futuro e as inovações [knowledge/] que ainda estão por vir."

msgid "STORY_EVENT@1048_27@TITLE"
msgstr "Engenhos de Admiração"

msgid "STORY_EVENT@1048_34@BODY_FOOTER"
msgstr "Você apoiará as ambições deles para aumentar a produtividade em {EventCity.Name}?"

msgid "STORY_EVENT@1048_34@BODY_HEADER"
msgstr "A guilda de construtores em {EventCity.Name} solicita seu apoio."

msgid "STORY_EVENT@1048_34@BODY_LORE"
msgstr "\"Os aprendizes da nossa guilda estão desanimados!\" exclama seu mestre artesão. \"Em suas jornadas pelo império de {EventGoldenCityPlayer.Name}, eles testemunharam o trabalho elaborado e os edifícios monumentais em {EventGoldenCity.Name}. Agora eles sonham com igual grandiosidade, mas nossos próprios meios são limitados...\""

msgid "STORY_EVENT@1048_34@BUTTON_0"
msgstr "Invista [gold/] em materiais e ferramentas [structureprod/] para começar."

msgid "STORY_EVENT@1048_34@BUTTON_1"
msgstr "Prometa [influence/] atrair mais trabalhadores [population/] para {EventCity.Name}."

msgid "STORY_EVENT@1048_34@BUTTON_2"
msgstr "Dobre pedras e terra à sua vontade para inspirá-los."

msgid "STORY_EVENT@1048_34@BUTTON_3"
msgstr "Ignore o pedido deles."

msgid "STORY_EVENT@1048_34@TITLE"
msgstr "Maravilhas Estrangeiras"

msgid "STORY_EVENT@1048_39@BODY_FOOTER"
msgstr "Um eco oco sacode a caverna: \"Dissciplesss da Deusa Gorgon, escolham seu ssacrificcce... Menosss que você encontre seus coraçõesss gananciososs virados para pedra.\""

msgid "STORY_EVENT@1048_39@BODY_HEADER"
msgstr "Assim que {EventHero.Name} entra no {EventStructure.Name}, <<p:EventHero>> percebe que está infestado de cobras."

msgid "STORY_EVENT@1048_39@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Assim que você entra no {EventStructure.Name}, você percebe que está infestado de cobras."

msgid "STORY_EVENT@1048_39@BODY_LORE"
msgstr "Toda a cena parece um santuário dedicado a uma divindade proibida. Formações rochosas ornamentadas cercam um altar em forma de pedra, onde está a imagem de uma mulher com cabelos de cobra. As serpentes vivas espreitam à distância, até que {EventHero.Name} toca o altar."

msgid "STORY_EVENT@1048_39@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Serpentes de pedra pairam como pilares no coração do labirinto subterrâneo. Toda a cena parece um santuário dedicado a uma divindade proibida. Formações rochosas ornamentadas cercam um altar em forma de pedra, onde está a imagem de uma mulher com cabelos de cobra. As serpentes vivas espreitam à distância, até que você toca o altar. A imagem sorri e desmorona, as cobras assobiando em antecipação."

msgid "STORY_EVENT@1048_39@BUTTON_0"
msgstr "\"Não tenho medo de nenhuma deusa ou de seus guardiões rastejantes. Às armas!\""

msgid "STORY_EVENT@1048_39@BUTTON_1"
msgstr "\"Oferecemos as pessoas [population/] de {EventCity.Name} [evilact/] para alimentar seus protetores, ó Serpente.\""

msgid "STORY_EVENT@1048_39@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"Ofereço as pessoas [population/] de {EventCity.Name} [evilact/] para alimentar seus protetores.\""

msgid "STORY_EVENT@1048_39@BUTTON_2"
msgstr "A magia de pedra é uma das suas forças. Use-a para prever os alvos da Maldição da Górgona."

msgid "STORY_EVENT@1048_39@BUTTON_4"
msgstr "Recuar."

msgid "STORY_EVENT@1048_39@TITLE"
msgstr "Poço de Víboras"

msgid "STORY_EVENT@1048_40@BODY_FOOTER"
msgstr "Será que {EventHero.Name} mantém o pergaminho de litomancia ou o usa para reviver as vítimas petrificadas que <<p:EventHero>> encontrou?"

msgid "STORY_EVENT@1048_40@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Você mantém o pergaminho de litomancia ou o usa para reviver as vítimas petrificadas que encontrou?"

msgid "STORY_EVENT@1048_40@BODY_HEADER"
msgstr "Tendo sobrevivido ao julgamento da Deusa Górgona, uma placa de pedra deslizante revela sua câmara de ofertas."

msgid "STORY_EVENT@1048_40@BODY_LORE"
msgstr "Dentro da sala escondida, uma fileira de aventureiros petrificados testemunha em silêncio a magia da Maldição que {EventHero.FirstName} resistiu. {EventHero.FirstName} encontra um pergaminho criado pelos antigos adoradores da Deusa Górgona, que parece conter um feitiço de litomancia."

msgid "STORY_EVENT@1048_40@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Dentro da sala escondida, uma fileira de aventureiros petrificados testemunha em silêncio a magia da Maldição que você resistiu. Você encontra um pergaminho criado pelos antigos adoradores da Deusa Górgona, que parece conter um feitiço de litomancia."

msgid "STORY_EVENT@1048_40@BUTTON_0"
msgstr "\"O tempo deles passou. O pergaminho [knowledge/] nos ajudará em batalhas futuras.\""

msgid "STORY_EVENT@1048_40@BUTTON_0@HERO_IS_PLAYERLE"
msgstr "\"O tempo deles passou. O pergaminho [knowledge/] me ajudará em batalhas futuras.\""

msgid "STORY_EVENT@1048_40@BUTTON_1"
msgstr "\"Traga as vítimas de volta à vida! Elas estão livres para retornar às suas casas [influence/].\" [goodact/]"

msgid "STORY_EVENT@1048_40@BUTTON_2"
msgstr "\"Reviva as vítimas da maldição! Nosso exército [unit/] pode usar esses <<m:EventUnit>>!\""

msgid "STORY_EVENT@1048_40@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "\"Reviva as vítimas da maldição! Meu exército [unit/] pode usar esses <<m:EventUnit>>!\""

msgid "STORY_EVENT@1048_40@TITLE"
msgstr "Cova de Víboras: Consequências"

msgid "STORY_EVENT@1048_45@BODY_FOOTER"
msgstr "As bestas são uma ameaça até mesmo para {EventCity.Name}. O que você fará para acabar com esse terror?"

msgid "STORY_EVENT@1048_45@BODY_HEADER"
msgstr "Um bando das poderosas {EventStackLeader.Name} está vagando pelas planícies perto da sua cidade {EventCity.Name}."

msgid "STORY_EVENT@1048_45@BODY_LORE"
msgstr "As bestas enlouquecidas pelo sangue têm aterrorizado as aldeias vizinhas, uma lança quebrada ainda cravada no flanco do alfa {EventStackLeader.Name}. Muitas histórias foram contadas sobre o {EventSpawner.Name} na região e os animais selvagens que emergem de suas profundezas. Nenhuma delas termina bem."

msgid "STORY_EVENT@1048_45@BUTTON_0"
msgstr "Arme os aldeões [unitprod/] para expulsar o bando de nossas fronteiras."

msgid "STORY_EVENT@1048_45@BUTTON_1"
msgstr "Reúna a população [unitprod/] para forçar o bando a voltar para seu {EventSpawner.Name}!"

msgid "STORY_EVENT@1048_45@BUTTON_2"
msgstr "O {EventStackLeader.Name} parece estar sofrendo. Cuidar cuidadosamente de seus ferimentos pode torná-lo dócil... embora o {EventSpawner.Name} permanecerá."

msgid "STORY_EVENT@1048_45@BUTTON_3"
msgstr "Deixe os animais virem. Nossas guarnições estão preparadas."

msgid "STORY_EVENT@1048_45@TITLE"
msgstr "Terror nos Campos"

msgid "STORY_EVENT@1060_1@BODY_FOOTER"
msgstr "Para declarar o vencedor, você é convidado a escolher o ditado mais convincente."

msgid "STORY_EVENT@1060_1@BODY_HEADER"
msgstr "No alto pódio em {EventCity.Name}, os grandes estudiosos do seu império estão competindo em um debate público."

msgid "STORY_EVENT@1060_1@BODY_LORE"
msgstr "Demonstrando o conhecimento e a astúcia pelos quais os {EventRace.Name} se tornaram famosos, cada um dos participantes está apresentando a prova inevitável de sua própria teoria mundial de maneiras eloquentes. Sua performance marca outro ponto alto nesta era dourada acadêmica do seu povo."

msgid "STORY_EVENT@1060_1@BUTTON_0"
msgstr "\"O mundo é uma fechadura. O conhecimento [knowledge/] é a chave.\""

msgid "STORY_EVENT@1060_1@BUTTON_1"
msgstr "\"O conhecimento inspira as pessoas [happiness/] à grandeza.\""

msgid "STORY_EVENT@1060_1@BUTTON_2"
msgstr "\"O conhecimento é o vento [mana/] que nos permite navegar pelo mar astral.\""

msgid "STORY_EVENT@1060_1@TITLE"
msgstr "Batalha de Intelectos"

msgid "STORY_EVENT@1060_29@BODY_FOOTER"
msgstr "{EventHouseLord.Name} deseja os serviços do seu herói {EventHero.Name}."

msgid "STORY_EVENT@1060_29@BODY_HEADER"
msgstr "Durante negociações diplomáticas, {EventHouseLord.TitleName} de {EventHouse.Name} entra em contato com você com um pedido incomum."

msgid "STORY_EVENT@1060_29@BODY_LORE"
msgstr "\"Em {EventHouse.Name},\" {EventHouseLord.Pronoun} começa, \"é costume selar uma nova amizade com uma troca de servos. Seus enviados me mostraram um desenho da bela {EventHero.Name} dedicada à sua causa. Eu quero {EventHero.PronounObject}. Eu exijo {EventHero.PronounObject}! Escolha qualquer um dos heróis de {EventHouse.Name} em troca...\""

msgid "STORY_EVENT@1060_29@BUTTON_0"
msgstr "\"É um acordo: Meu {EventHero.Name} pelo seu {EventHouseHero.Name}!\""

msgid "STORY_EVENT@1060_29@BUTTON_1"
msgstr "\"Eu poderia ser convencido [gold/], a deixar {EventHero.Name} se juntar a você. Mas {EventHero.Pronoun} vem a um preço diferente [evilact/]...\""

msgid "STORY_EVENT@1060_29@BUTTON_2"
msgstr "\"As pessoas que me servem têm sua própria vontade livre [goodact/]. Eu não forçarei {EventHero.Name}.\""

msgid "STORY_EVENT@1060_29@TITLE"
msgstr "Troca de Pessoal"

msgid "STORY_EVENT@1060_2@BODY_FOOTER"
msgstr "\"Agora que você ouviu sobre nós sermos condenados a esta tarefa indigna, o que o traz aqui?\""

msgid "STORY_EVENT@1060_2@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "\"Agora que você ouviu sobre nós sermos condenados a esta tarefa indigna, o que o traz aqui, ó {PlayerLeader.Title}?\""

msgid "STORY_EVENT@1060_2@BODY_HEADER"
msgstr "Aproximando-se do {EventStructure.Name}, {EventHero.Name} encontra o {EventStackLeader.Name}, que parece estar lamentando o destino de <<o:EventStackLeader>> ter que liderar os guardas de {EventHouse.Name}."

msgid "STORY_EVENT@1060_2@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Aproximando-se do {EventStructure.Name}, você encontra o {EventStackLeader.Name}, que parece estar lamentando o destino de <<o:EventStackLeader>> ter que liderar os guardas de {EventHouse.Name}."

msgid "STORY_EVENT@1060_2@BODY_LORE"
msgstr "\"Nós deveríamos estar nas terras selvagens,\" diz <<p:EventStackLeader>>, \"matando um dragão ou atacando o castelo de um cavaleiro-ladrão. Em vez disso, estamos presos aqui, vigiando o {EventStructure.Name} que ninguém se importa. É um trabalho tão humilde, que só camponeses deveriam ter que fazê-lo.\""

msgid "STORY_EVENT@1060_2@BUTTON_1"
msgstr "\"Eu libertarei você e seus homens e comprarei [gold/] este {EventStructure.Name} de {EventHouse.Name}. \""

msgid "STORY_EVENT@1060_2@BUTTON_2"
msgstr "\"Você ouve isso? Você está sendo chamado de volta para a defesa de {EventHouse.Name}!\""

msgid "STORY_EVENT@1060_2@BUTTON_3"
msgstr "\"Estou aqui para conceder a vocês uma luta heroica - até a morte!\""

msgid "STORY_EVENT@1060_2@BUTTON_4"
msgstr "\"Apenas buscando aventuras. Nós estaremos a caminho...\""

msgid "STORY_EVENT@1060_2@TITLE"
msgstr "Um Trabalho para Camponeses"

msgid "STORY_EVENT@1060_30@BODY_FOOTER"
msgstr "Quais são suas ordens?"

msgid "STORY_EVENT@1060_30@BODY_FOOTER@STACKLEADER_IS_P"
msgstr "O que você faz?"

msgid "STORY_EVENT@1060_30@BODY_HEADER"
msgstr "Suas tropas se engajam com um contingente militar de {EventHouse.Name}."

msgid "STORY_EVENT@1060_30@BODY_HEADER@STACKLEADER_IS_P"
msgstr "Você se engaja com um contingente militar de {EventHouse.Name}."

msgid "STORY_EVENT@1060_30@BODY_LORE"
msgstr "O exército de {EventHouseLord.Name} está em movimento, com pouco tempo ou interesse em gentilezas diplomáticas. Ainda assim, seu capitão é respeitoso o suficiente para deixar tempo para uma negociação, como uma oportunidade para suas tropas fazerem contato."

msgid "STORY_EVENT@1060_30@BODY_LORE@STACKLEADER_IS_P"
msgstr "O exército de {EventHouseLord.Name} está em movimento, com pouco tempo ou interesse em gentilezas diplomáticas. Ainda assim, seu capitão é respeitoso o suficiente para deixar tempo para uma negociação, como uma oportunidade para suas tropas fazerem contato."

msgid "STORY_EVENT@1060_30@BUTTON_1"
msgstr "Organize uma audiência diplomática com {EventHouseLord.Name}."

msgid "STORY_EVENT@1060_30@BUTTON_3"
msgstr "Atacar! Esta é a oportunidade de atacar!"

msgid "STORY_EVENT@1060_30@BUTTON_4"
msgstr "Desengaje e deixe-os seguir seu caminho."

msgid "STORY_EVENT@1060_30@TITLE"
msgstr "Movimento de Tropas: {EventHouse.Name}"

msgid "STORY_EVENT@1060_3@BODY_FOOTER"
msgstr "\"Não tão tímidos! Ousam se juntar à confusão e jogar? O vencedor leva a {EventStructure.Name}. São seus crânios contra os nossos!\""

msgid "STORY_EVENT@1060_3@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "\"Não tão tímido, {PlayerLeader.Title}! Ousa se juntar à confusão e jogar? O vencedor leva a {EventStructure.Name}. São seus crânios contra os nossos!\""

msgid "STORY_EVENT@1060_3@BODY_HEADER"
msgstr "As tropas barulhentas de {EventHouse.Name} estacionadas na {EventStructure.Name} estão se entregando a um jogo mórbido."

msgid "STORY_EVENT@1060_3@BODY_LORE"
msgstr "Eles continuam rearrumando o mesmo conjunto de ossos suspeitamente humanoides, apenas para derrubá-los novamente com crânios arremessados de uma distância. Seu líder, um {EventStackLeader.Name} de aparência feroz, olha para {EventHero.Name} e ri."

msgid "STORY_EVENT@1060_3@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Eles continuam rearrumando o mesmo conjunto de ossos suspeitamente humanoides, apenas para derrubá-los novamente com crânios arremessados de uma distância. Seu líder, um {EventStackLeader.Name} de aparência feroz, olha para você e ri."

msgid "STORY_EVENT@1060_3@BUTTON_1"
msgstr "\"Por que se contentar com ossos quando você poderia ter gado [food/] suficiente para um banquete por semanas?\""

msgid "STORY_EVENT@1060_3@BUTTON_2"
msgstr "Conceda força a {EventHero.Name} para jogar."

msgid "STORY_EVENT@1060_3@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "Reúna sua força para jogar."

msgid "STORY_EVENT@1060_3@BUTTON_3"
msgstr "\"Fim de jogo. Vamos esmagar seus ossos de verdade!\""

msgid "STORY_EVENT@1060_3@BUTTON_4"
msgstr "\"Você continua jogando. Nós vamos assistir de longe...\""

msgid "STORY_EVENT@1060_3@TITLE"
msgstr "Boliche de Crânios"

msgid "STORY_EVENT@1060_4@BODY_FOOTER"
msgstr "\"Agora eu continuo pensando, será que a morte deste homem deveria ter sido a minha? Você busca minha ruína, {PlayerLeader.Name}?\""

msgid "STORY_EVENT@1060_4@BODY_HEADER"
msgstr "Após um jantar diplomático com seus enviados, você é contactado por um pálido {EventHouseLord.TitleName} de {EventHouse.Name}."

msgid "STORY_EVENT@1060_4@BODY_LORE"
msgstr "\"Eu sei que sou apenas um {EventHouseLord.Title} menor aos olhos de um {PlayerLeader.Title},\" <<p:EventHouseLord>> diz ansiosamente. \"Mas eu preciso saber a verdade... Depois de experimentar o ensopado pelo qual os {PlayerRace.Name} são famosos, meu provador de comida inchar com gases até que o pobre homem foi dilacerado por dentro, transformando o buffet em uma bagunça nauseante...\""

msgid "STORY_EVENT@1060_4@BUTTON_0"
msgstr "\"Isso foi um acidente trágico. Deixe meu tesouro [gold/] garantir nossa amizade.\""

msgid "STORY_EVENT@1060_4@BUTTON_1"
msgstr "\"Se eu quisesse você morto, você estaria [evilact/].\""

msgid "STORY_EVENT@1060_4@BUTTON_2"
msgstr "\"Não é minha culpa que vocês {EventHouseRace.Name} não consigam tolerar nossas iguarias...\""

msgid "STORY_EVENT@1060_4@BUTTON_3"
msgstr "\"Uma terceira parte deve ter envenenado o ensopado para sabotar as negociações!\""

msgid "STORY_EVENT@1060_4@TITLE"
msgstr "Enopado Tóxico"

msgid "STORY_EVENT@1064_104@BODY_FOOTER"
msgstr "\"Grande {PlayerLeader.Title}, você compartilharia um pouco do seu poder, para que possamos criar uma fruta mágica para {EventHouseLord}?\""

msgid "STORY_EVENT@1064_104@BODY_HEADER"
msgstr "À luz das negociações com {EventHouseLord.Name}, um grupo de agricultores de {EventHouse} está entrando em contato com você com um pedido."

msgid "STORY_EVENT@1064_104@BODY_LORE"
msgstr "\"Nós amamos nosso {EventHouseLord.TitleName}!\" seu <<EventUnit{spokesman/spokeswoman}>> explica. \"E queremos criar uma nova fruta para honrar o nome de <<o:EventHouseLord>>. Fruta mágica deliciosa que fica mais exótica a cada mordida. {EventHouseLord} ficará encantado com ela!\""

msgid "STORY_EVENT@1064_104@BUTTON_0"
msgstr "\"Seu pedido [mana/] será concedido!\""

msgid "STORY_EVENT@1064_104@BUTTON_1"
msgstr "\"Estude [knowledge/] as artes arcanas em {EventCity} para aprender os encantamentos vocês mesmos.\""

msgid "STORY_EVENT@1064_104@BUTTON_2"
msgstr "\"Eu não tenho mana para gastar com isso.\""

msgid "STORY_EVENT@1064_104@BUTTON_3"
msgstr "\"Infundir plantas com magia é meu passatempo favorito.\""

msgid "STORY_EVENT@1064_104@TITLE"
msgstr "Infusão Mágica de Frutas"

msgid "STORY_EVENT@1064_106@BODY_FOOTER"
msgstr "\"Fomos abandonados pelo nosso {EventHouseLord.Title}. Trabalharíamos feliz para qualquer um, menos para <<P:EventHouseLord>>.\""

msgid "STORY_EVENT@1064_106@BODY_HEADER"
msgstr "À medida que {EventHero.Name} se aproxima do {EventStructure.Name}, os guardas maltrapilhos de {EventHouse.Name} olham para cima, cansados."

msgid "STORY_EVENT@1064_106@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "À medida que você se aproxima do {EventStructure.Name}, os guardas maltrapilhos de {EventHouse.Name} olham para cima, cansados."

msgid "STORY_EVENT@1064_106@BODY_LORE"
msgstr "\"Você está interessado nesta {EventStructure.Name},\" pergunta o {EventStackLeader}. \"{EventHouseLord.TitleName} exige que seja patrulhada, mas nos faltam os recursos para nos defendermos adequadamente. Já perdemos muitos bons {EventRace.Name} para monstros. <<Cp:EventHouseLord>> diz que é nosso dever seguir ordens, mas por que seguir as ordens de um {EventHouseLord.Title} que nos abandonou?\""

msgid "STORY_EVENT@1064_106@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "\"Você está interessado nesta {EventStructure.Name}, {PlayerLeader.Title},\" pergunta o {EventStackLeader}. \"{EventHouseLord.TitleName} exige que seja patrulhada, mas nos faltam os recursos para nos defendermos adequadamente. Já perdemos muitos bons {EventRace.Name} para monstros. <<Cp:EventHouseLord>> diz que é nosso dever seguir ordens, mas por que seguir as ordens de um {EventHouseLord.Title} que nos abandonou?\""

msgid "STORY_EVENT@1064_106@BUTTON_1"
msgstr "\"Eu vou tirar esta {EventStructure.Name} das <<g:mãos^p,EventHouseLord>> [gold/]. Podem ir.\""

msgid "STORY_EVENT@1064_106@BUTTON_2"
msgstr "\"Eu vou comprar [gold/] tanto a {EventStructure.Name} quanto o seu serviço.\""

msgid "STORY_EVENT@1064_106@BUTTON_3"
msgstr "\"Vagabundos preguiçosos! Sua fraqueza faz de vocês um alvo fácil.\""

msgid "STORY_EVENT@1064_106@BUTTON_4"
msgstr "\"Vou pensar sobre isso. Honestamente...\""

msgid "STORY_EVENT@1064_106@TITLE"
msgstr "Guardas Maltrapilhos"

msgid "STORY_EVENT@1064_1155@BODY_FOOTER"
msgstr "\"Você santificará o código de pacifismo que compilamos, ó {PlayerLeader.Title} dos {EventRace}, para que todos possamos nos esforçar abertamente pela paz?\""

msgid "STORY_EVENT@1064_1155@BODY_HEADER"
msgstr "O(a) <<EventUnit {presidente/presidenta}>> do Conselho {EventRace} se aproxima de você em um estado calmo, semelhante a um transe."

msgid "STORY_EVENT@1064_1155@BODY_LORE"
msgstr "\"Com o tempo, nós {EventRace} aprendemos a abominar a violência que domina este reino. Buscamos levar uma vida mais reclusa, protegendo o que construímos se necessário, mas abandonando as grandes batalhas e intrigas que só trazem os horrores do conflito forçado sobre a terra e seu povo.\""

msgid "STORY_EVENT@1064_1155@BUTTON_0"
msgstr "\"Sua sabedoria me agrada. Os {EventRace} serão conhecidos como um povo amante da paz.\""

msgid "STORY_EVENT@1064_1155@BUTTON_1"
msgstr "\"Devo proibir [influence/] tal pacifismo. Seus ideais, embora nobres, trariam ruína aos {EventRace}.\""

msgid "STORY_EVENT@1064_1155@BUTTON_2"
msgstr "\"Você foi enganado pelas vaidades da paz. A guerra e a violência [evilact/] retornarão para ditar os destinos [happiness/] dos {EventRace}.\""

msgid "STORY_EVENT@1064_1155@TITLE"
msgstr "Espadas em Arados"

msgid "STORY_EVENT@1064_1168@BODY_FOOTER"
msgstr "\"Por decreto do nosso Conselho, desejamos estabelecer um costume de peregrinação ao tesouro imperial, para que todos os {EventRace} possam se maravilhar com sua beleza cintilante.\""

msgid "STORY_EVENT@1064_1168@BODY_HEADER"
msgstr "O presidente do Conselho {EventRace} se aproxima de você com um brilho de ganância nos olhos."

msgid "STORY_EVENT@1064_1168@BODY_LORE"
msgstr "\"Estes são tempos verdadeiramente abençoados para nós {EventRace}. Prosperamos enquanto coisas de beleza e valor são mantidas seguras dentro do tesouro divino de sua criação, ó {PlayerLeader.Title}. Outros impérios olham para nós com inveja, pois só podem sonhar com a felicidade material que protegemos e desfrutamos.\""

msgid "STORY_EVENT@1064_1168@BUTTON_0"
msgstr "\"Prossigam como desejarem. O valor do ouro será verdadeiramente conhecido por todos os {EventRace}.\""

msgid "STORY_EVENT@1064_1168@BUTTON_1"
msgstr "\"Se o ouro é tão caro para o Conselho, certamente uma doação generosa [gold/] mudaria suas mentes.\""

msgid "STORY_EVENT@1064_1168@BUTTON_2"
msgstr "\"Adorar riquezas é tolice [happiness/]. Não vou incentivar a ganância dos {EventRace}.\""

msgid "STORY_EVENT@1064_1168@TITLE"
msgstr "Riqueza Além da Medida"

msgid "STORY_EVENT@1064_1171@BODY_FOOTER"
msgstr "\"Compilamos um livro de tutela, pronto para transcrição, para que todos os {EventRace} possam ser guiados a estudar o passado.\""

msgid "STORY_EVENT@1064_1171@BODY_HEADER"
msgstr "O(a) <<EventUnit {chairman/chairwoman}>> do Conselho {EventRace} vem perante você, um livro ornado nas mãos de <<o:EventUnit>>."

msgid "STORY_EVENT@1064_1171@BODY_LORE"
msgstr "\"Isso,\" <<p:EventUnit>> diz com pathos, \"é o legado dos {EventRace}. Em eras passadas, tribos, reinos e reinos inteiros desapareceram nas brumas do tempo, seu conhecimento aparentemente perdido para sempre. Mas com grande dedicação e magia, muito do que foi esquecido pode ser redescoberto, como mensagens rúnicas entalhadas profundamente nas raízes ocultas deste mundo.\""

msgid "STORY_EVENT@1064_1171@BUTTON_0"
msgstr "\"Você é sábio. Este conhecimento ancestral irá remodelar os {EventRace}.\""

msgid "STORY_EVENT@1064_1171@BUTTON_1"
msgstr "\"O passado não é compreensível para as massas. Permita-me iluminar [knowledge/] você...\""

msgid "STORY_EVENT@1064_1171@BUTTON_2"
msgstr "\"Eu proíbo [happiness/] tal morada no passado. Molde antes o futuro, antes que todos os {EventRace} tenham virado pó.\""

msgid "STORY_EVENT@1064_1171@TITLE"
msgstr "Deliberadores de Segredos"

msgid "STORY_EVENT@1064_1179@BODY_FOOTER"
msgstr "\"Por favor, meu(a) {PlayerLeader.Title}, nomeie qualquer oferta ou serviço que eu possa dar para salvar a mim e à minha família desta maldição.\""

msgid "STORY_EVENT@1064_1179@BODY_HEADER"
msgstr "Um mercador dos {EventRace} de {EventCity}, amplamente conhecido por <<o:EventUnit>> festins depravados, veio perante seu trono, implorando por absolvição."

msgid "STORY_EVENT@1064_1179@BODY_LORE"
msgstr "\"Não olhe com ira para este pobre pecador, ó {PlayerLeader.Title},\" o(a) <<EventUnit {man/woman}>> implora, <<o:EventUnit>> voz grossa de medo. \"Por muito tempo ignorei a ordem divina da tua fé. Agora uma maldição escura caiu sobre mim, destruindo lentamente tudo o que tenho de querido. Até mesmo minha própria saúde está diminuindo, drenando qualquer força que me reste.\""

msgid "STORY_EVENT@1064_1179@BUTTON_0"
msgstr "\"Renuncie aos seus bens mundanos [gold/] e sua alma encontrará descanso.\""

msgid "STORY_EVENT@1064_1179@BUTTON_1"
msgstr "\"Estude as escrituras sagradas [knowledge/] e o caminho da redenção se revelará a você.\""

msgid "STORY_EVENT@1064_1179@BUTTON_2"
msgstr "\"Embarque em uma peregrinação [orderboon/] para buscar a luz da verdadeira fé.\""

msgid "STORY_EVENT@1064_1179@TITLE"
msgstr "Absolvição Divina"

msgid "STORY_EVENT@1064_1181@BODY_FOOTER"
msgstr "\"Oooo, quanto tempo esperamos na escuridão... Liberte-nos... Livre-nos!\""

msgid "STORY_EVENT@1064_1181@BODY_HEADER"
msgstr "Sussurros nebulosos emergem das profundezas da sua cripta, chamando sua atenção para um frasco selado de origem desconhecida."

msgid "STORY_EVENT@1064_1181@BODY_LORE"
msgstr "\"{PlayerLeader}... venha sob as sombras. Ouça-nos... <<p:PlayerLeader>>, que pode ouvir nossa voz. Magia negra foi nosso crime. Prisão eterna nossa sentença.\""

msgid "STORY_EVENT@1064_1181@BUTTON_0"
msgstr "Dissipe a maldição do frasco [mana/] para libertar os espíritos [shadowboon/]."

msgid "STORY_EVENT@1064_1181@BUTTON_1"
msgstr "Canalize [mana/] as almas do frasco [souls/] para sua magia negra."

msgid "STORY_EVENT@1064_1181@BUTTON_2"
msgstr "Deixe o frasco na sua cripta."

msgid "STORY_EVENT@1064_1181@BUTTON_3"
msgstr "Subjugue os espíritos ancestrais para aproveitar seus segredos [knowledge/]."

msgid "STORY_EVENT@1064_1181@TITLE"
msgstr "Sussurros de Aflição"

msgid "STORY_EVENT@1064_1184@BODY_FOOTER"
msgstr "\"Que forma hedionda e nova devo dar a este espião de {EventHouse}? Bestas geladas são minha especialidade...\""

msgid "STORY_EVENT@1064_1184@BODY_HEADER"
msgstr "Nos dias da guerra com {EventHouse}, um convidado inesperado aparece em sua corte: um(a) perverso(a) {EventUnit} do extremo norte."

msgid "STORY_EVENT@1064_1184@BODY_LORE"
msgstr "\"Magnífico {PlayerLeader}, há muito tempo observo seu reinado intrigantemente sombrio. Ele gelou meus sentidos e fez cócegas em minhas veias congeladas. Agora venho com um presente.\" Ela mostra um sorriso vicioso enquanto apresenta um homem da {EventRace} preso em uma gaiola flutuante de gelo."

msgid "STORY_EVENT@1064_1184@BUTTON_0"
msgstr "\"Transforme-o em um {TargetWolf} [unit/], deixe seu uivo assustar todos da {EventHouse}.\""

msgid "STORY_EVENT@1064_1184@BUTTON_1"
msgstr "\"Como uma {TargetSpider} [unit/], ele irá prender outros espiões em sua teia.\""

msgid "STORY_EVENT@1064_1184@BUTTON_2"
msgstr "\"Deixe-o comigo. Seu conhecimento da {EventHouse} [garrison/] será a ruína deles.\""

msgid "STORY_EVENT@1064_1184@BUTTON_3"
msgstr "\"Transforme-o em gelo eterno [shadowboon/]. Ele será um ornamento adequado para minha corte.\""

msgid "STORY_EVENT@1064_1184@TITLE"
msgstr "Homenagem Maligna"

msgid "STORY_EVENT@1064_1187@BODY_FOOTER"
msgstr "Você tenta evitar a destruição que poderia atingir a {EventStructure} perto de sua cidade de {EventCity}?"

msgid "STORY_EVENT@1064_1187@BODY_HEADER"
msgstr "Através de sua profunda ligação com o mundo abaixo de você, sente os movimentos de um elemental terrestre ancestral."

msgid "STORY_EVENT@1064_1187@BODY_LORE"
msgstr "Perturbado em seu sono ancestral, o elemental está roncando inquietamente, sacudindo o mundo que está construído em suas costas. Um desastre tectônico parece iminente enquanto o elemental se move lentamente em direção a {EventCity}."

msgid "STORY_EVENT@1064_1187@BUTTON_0"
msgstr "Comunique-se com o elemental [mana/] para acalmá-lo novamente. [materiumboon/]"

msgid "STORY_EVENT@1064_1187@BUTTON_1"
msgstr "Canalize sua magia [mana/] para desviar o elemental para o domínio de um rival."

msgid "STORY_EVENT@1064_1187@BUTTON_2"
msgstr "Ignore o elemental ancestral até que ele chegue a {EventCity}."

msgid "STORY_EVENT@1064_1187@TITLE"
msgstr "Terra em Movimento"

msgid "STORY_EVENT@1064_1338@BODY_FOOTER"
msgstr "O guarda da prisão sufoca os <<G:resmungos patéticos^p,EventUnit>>. \"O que devemos fazer com este espião da traidora {EventHouse.Name}?\""

msgid "STORY_EVENT@1064_1338@BODY_HEADER"
msgstr "Um <<EventUnit{homem/mulher}>> está diante de você, com agonia crua refletida no rosto de <<o:EventUnit>>. \"Por favor... farei qualquer coisa. Por favor, não me mate!\""

msgid "STORY_EVENT@1064_1338@BODY_LORE"
msgstr "Seu guarda da prisão puxa a <<G:coleira de ferro^n,EventUnit>>. \"Pego espiando para {EventHouse}!\" Um suspiro audível ecoa pela câmara. Cada cortesão expressa seu choque, dizendo que nunca fariam tal coisa, nem por qualquer recompensa. O espião continua a implorar. \"{EventHouseLord} matará minha família. Por favor! Eu não sou ninguém. Não quis causar nenhum dano ao seu vasto império.\""

msgid "STORY_EVENT@1064_1338@BUTTON_0"
msgstr "Enforque <<P:EventUnit>> no portão [evilact/] como uma mensagem [relationLvl-3/] para {EventHouse}."

msgid "STORY_EVENT@1064_1338@BUTTON_1"
msgstr "Entre em contato discretamente com {EventHouseLord} para negociar um resgate [gold/]."

msgid "STORY_EVENT@1064_1338@BUTTON_2"
msgstr "Encerre a vida de <<o:EventUnit>>. O corpo traidor de <<Co:EventUnit>> junta-se aos meus leais guerreros não-mortos. [shadowboon/]"

msgid "STORY_EVENT@1064_1338@BUTTON_3"
msgstr "Use <<P:EventUnit>> para alimentar informações favoráveis [relationLvl3/] para {EventHouseLord}."

msgid "STORY_EVENT@1064_1338@BUTTON_4"
msgstr "\"Este <<EventUnit{homem/mulher}>> já foi torturado o suficiente. [goodact/] Liberte <<P:EventUnit>>!\""

msgid "STORY_EVENT@1064_1338@TITLE"
msgstr "Os Olhos Indiscretos de {EventHouse}"

msgid "STORY_EVENT@1064_1474@BODY_FOOTER"
msgstr "\"Temos a Bobina Dourada, a única chave para o cofre mundial chamado Grexolis. No entanto, ela só pode ser usada quando todo o Grexolis estiver sob nosso controle.\""

msgid "STORY_EVENT@1064_1474@BODY_HEADER"
msgstr "Olhando para os continentes fragmentados de {GLOBAL.GrexolisLoreConcept.Hyperlink}, você é abordado por seus aliados {GLOBAL.ShadraiFactionLoreConcept.Hyperlink}."

msgid "STORY_EVENT@1064_1474@BODY_LORE"
msgstr "\"Um mundo sacrificado para um propósito maior - louvável, mas em vão.\" {EventPlayer} fala lentamente e com gravidade, como se cada palavra que <<p:EventPlayer>> pronunciava fosse um desafio em si mesma. \"Os {GLOBAL.ArchonsLoreConcept.Hyperlink} fizeram o que consideravam justo, mas sua força estava diminuindo. Onde eles viam perigo, nós vemos potencial.\""

msgid "STORY_EVENT@1064_1474@BUTTON_0"
msgstr "Ouça mais sobre Grexolis e seu guardião."

msgid "STORY_EVENT@1064_1474@TITLE"
msgstr "O Cofre Mundial"

msgid "STORY_EVENT@1064_1476@BODY_FOOTER"
msgstr "{EventHero.FirstName} desce até a cratera e, sem hesitação, ativa o Gildercoil."

msgid "STORY_EVENT@1064_1476@BODY_HEADER"
msgstr "Enquanto {EventHero.FirstName} segura o Gildercoil, os continentes fragmentados de {GLOBAL.GrexolisLoreConcept.Hyperlink} são postos em movimento, como as engrenagens de um motor gigantesco."

msgid "STORY_EVENT@1064_1476@BODY_LORE"
msgstr "A terra treme e os edifícios desabam, até que um grande vazio é formado. Runas brilhantes ao redor do vazio apontam você em direção ao centro."

msgid "STORY_EVENT@1064_1476@BUTTON_0"
msgstr "Prepare-se para a abertura do Cofre Mundial."

msgid "STORY_EVENT@1064_1476@TITLE"
msgstr "Abrindo Grexolis"

msgid "STORY_EVENT@1064_1512@BODY_FOOTER"
msgstr "Inspirado pelo momento, você se sente fortalecido e capaz de conjurar um objeto do Mar Astral você mesmo."

msgid "STORY_EVENT@1064_1512@BODY_HEADER"
msgstr "A brecha no nó de mana ressoa como um eco arcano enquanto a magia bruta do {GLOBAL.AstralSeaLoreConcept.Hyperlink} retorna para ressonar com seus {GLOBAL.AstralFlowsLoreConcept.Hyperlink}."

msgid "STORY_EVENT@1064_1512@BODY_LORE"
msgstr "Os invasores astrais foram repelidos, deixando uma impressão assustadora dos perigos que espreitam além de {GLOBAL.AthlaLoreConcept.Hyperlink}. No entanto, você não consegue se livrar da sensação de ter vislumbrado algo grandioso, uma janela se abrindo entre os mundos."

msgid "STORY_EVENT@1064_1512@BUTTON_0"
msgstr "Invocar um artefato mágico [item/]."

msgid "STORY_EVENT@1064_1512@BUTTON_1"
msgstr "Atrair um grande cristal de mana [mana/]."

msgid "STORY_EVENT@1064_1512@BUTTON_2"
msgstr "Conjurar um companheiro mágico [unit/]."

msgid "STORY_EVENT@1064_1512@TITLE"
msgstr "Caçadores do Além: Consequências"

msgid "STORY_EVENT@1064_1515@BODY_FOOTER"
msgstr "Para proteger seu povo e restaurar sua fé em seu governo, você deve procurar os {GLOBAL.AstralMonstersLoreConcept.Hyperlink} perto de {EventCity}."

msgid "STORY_EVENT@1064_1515@BODY_HEADER"
msgstr "Por um breve momento, seu povo encontrou refúgio neste Vale das Maravilhas. Mas agora gritos de pânico começam a ecoar nas ruas de {EventCity}."

msgid "STORY_EVENT@1064_1515@BODY_LORE"
msgstr "\"A ruína está sobre nós! Monstros do além!\" Seus batedores chegam pouco depois do alvoroço. Criaturas do {GLOBAL.AstralSeaLoreConcept.Hyperlink} foram avistadas perto da cidade. O medo dos {EventRace} rapidamente leva à dúvida. Será que {EventHouseLord} estava certo? Sua magia atraiu as criaturas de longe?"

msgid "STORY_EVENT@1064_1515@BUTTON_0"
msgstr "Esses horrores de outro mundo descobrirão que os {EventRace} não são presas fáceis."

msgid "STORY_EVENT@1064_1515@TITLE"
msgstr "Caçadores do Além"

msgid "STORY_EVENT@1064_1518@BODY_FOOTER"
msgstr "Está claro que o {EventStackLeader} está causando medo nos corações de seus soldados. O que você faz?"

msgid "STORY_EVENT@1064_1518@BODY_HEADER"
msgstr "À medida que você se aproxima das criaturas do {GLOBAL.AstralSeaLoreConcept.Hyperlink}, sua natureza horrenda se revela completamente."

msgid "STORY_EVENT@1064_1518@BODY_LORE"
msgstr "Olhos assustadores olham de membros fluindo de maneira perturbadora. Um silêncio sinistro envolve os monstros, enquanto o ar ao seu redor crepita com traços carregados de magia."

msgid "STORY_EVENT@1064_1518@BUTTON_3"
msgstr "Amedrontadores ou não, esses monstros devem morrer. Ataque!"

msgid "STORY_EVENT@1064_1518@BUTTON_4"
msgstr "Coloque uma recompensa [gold/] na cabeça do {EventStackLeader}."

msgid "STORY_EVENT@1064_1518@BUTTON_5"
msgstr "Canalize sua habilidade mágica para forçar as criaturas de volta ao Mar Astral."

msgid "STORY_EVENT@1064_1518@BUTTON_7"
msgstr "Fugir."

msgid "STORY_EVENT@1064_1518@BUTTON_8"
msgstr "Lembre as tropas da grandiosidade [influence/] e bravura de seus antepassados."

msgid "STORY_EVENT@1064_1518@TITLE"
msgstr "Encontrando os Caçadores do Além"

msgid "STORY_EVENT@1064_1605@BODY_FOOTER"
msgstr "\"Farei contato com você através de visões como esta. Siga meu conselho e você alcançará a vitória.\""

msgid "STORY_EVENT@1064_1605@BODY_HEADER"
msgstr "Das névoas ocultas de sua mente emerge <<EventHero{um homem/uma mulher}>> vestido com seda etérea. \"Vejo que você chegou à Caldera Carmim, {PlayerLeader},\" <<p:EventHero>> diz, e você reconhece <<P:EventHero>> como {EventHero}."

msgid "STORY_EVENT@1064_1605@BODY_LORE"
msgstr "\"Todos os {GLOBAL.ShadraiFactionLoreConcept.Hyperlink} depositaram muita fé em seus talentos. Mantenha-se alerta! Erros são fatais neste [hyperlink,GLOBAL.ObbadothLoreConcept]reino demoníaco[/hyperlink], no qual todos são prisioneiros de guerra. A traição paira sobre cada momento que virá, seja através do inimigo, da terra que muda de forma viciosamente, ou até mesmo de seus próprios soldados.\""

msgid "STORY_EVENT@1064_1605@BUTTON_0"
msgstr "\"Fale-me sobre o Gildercoil e suas influências.\""

msgid "STORY_EVENT@1064_1605@TITLE"
msgstr "Emissário dos Shad'rai"

msgid "STORY_EVENT@1064_1610@BODY_FOOTER"
msgstr "\"Deixe-me conquistar seu coração, {PlayerLeader.FirstName}, assim como conquistarei suas cidades. Por favor, resista, será ainda mais atraente.\""

msgid "STORY_EVENT@1064_1610@BODY_HEADER"
msgstr "\"Um novo peão entrou no campo de jogo da luxúria. Ele conhece a paixão? É o <<PlayerLeader{sedutor/sedutora}>> ou o seduzido?\" Suaves sussurros anunciam a chegada de {EventPlayer}."

msgid "STORY_EVENT@1064_1610@BODY_LORE"
msgstr "O {EventPlayer.Title} dos {EventRace} olha para você com lascívia evidente. Ou lascívia fingida, pois <<p:EventPlayer>> certamente treinou este ato à perfeição. {EventPlayer} faz um gesto lascivo. \"Abrace seus desejos carnais, {PlayerLeader}. O prazer é um banquete sem saciação e eu o convido a dar uma mordida.\""

msgid "STORY_EVENT@1064_1610@BUTTON_0"
msgstr "Suporte o discurso perturbador em silêncio. Você responderá no campo de batalha [unitprod/]."

msgid "STORY_EVENT@1064_1610@BUTTON_1"
msgstr "Ouça sem se emocionar. Uma mente focada [knowledge/] não será incomodada por esta farsa."

msgid "STORY_EVENT@1064_1610@BUTTON_2"
msgstr "Os pecados de <<Co:EventPlayer>> serão <<o:EventPlayer>> a ruína. Seu império é um bastião de virtude [orderboon/]."

msgid "STORY_EVENT@1064_1610@BUTTON_3"
msgstr "Você aceita o desafio. Ninguém pode vencer seu {PlayerRace} em sua revelria violenta [chaosboon/]."

msgid "STORY_EVENT@1064_1610@TITLE"
msgstr "A Loucura de {EventPlayer}"

msgid "STORY_EVENT@1064_1620@BODY_FOOTER"
msgstr "\"Muitos dos {GLOBAL.ShadraiFactionLoreConcept.Hyperlink} expressaram o desejo de oferecer mais ajuda. Escolha o que você considerar mais útil para sua campanha.\""

msgid "STORY_EVENT@1064_1620@BODY_HEADER"
msgstr "\"Aplaudo sua determinação, {PlayerLeader}.\" {EventHero} bate palmas de forma ostentativa."

msgid "STORY_EVENT@1064_1620@BODY_LORE"
msgstr "\"Você realmente se tornou um tecelão de pesadelos. A armadilha foi preparada — hora de atrair suas vítimas para seu destino.\""

msgid "STORY_EVENT@1064_1620@BUTTON_0"
msgstr "Escolha o <<m:{EventUnit01}>> [unit/] de Yaka Enkhanan."

msgid "STORY_EVENT@1064_1620@BUTTON_2"
msgstr "Pegue o {EventItem} [item/] de Ydgaard Worldbender."

msgid "STORY_EVENT@1064_1620@BUTTON_3"
msgstr "Invocar o <<m:{EventUnit02}>> [unit/] de Nimue, a Rainha Sereia."

msgid "STORY_EVENT@1064_1620@BUTTON_4"
msgstr "\"Eles ajudam agora que minha vitória está próxima? A glória [influence/] será somente minha!\""

msgid "STORY_EVENT@1064_1620@TITLE"
msgstr "Tecelão de Pesadelos: Consequências"

msgid "STORY_EVENT@1064_1622@BODY_FOOTER"
msgstr "\"Lance a magia Fio da Mente em um Godir, e você encontrará uma maneira de forçar a revelação do que eles sabem sobre o Gildercoil.\""

msgid "STORY_EVENT@1064_1622@BODY_HEADER"
msgstr "\"Você encontrou seu primeiro suspeito, {PlayerLeader}.\" {EventHero} mostra um sorriso frio. \"Então é hora de te ensinar sobre a magia do Fio Mental.\""

msgid "STORY_EVENT@1064_1622@BODY_LORE"
msgstr "{EventHero.FirstName} continua: \"Como nossa aliada {GLOBAL.ShadraiFactionLoreConcept.Hyperlink} {ArachnaSecondary.FirstName} diria, uma aranha não ataca sua presa abertamente; ela encontra uma maneira de prender sua vítima em suas teias. A magia do Fio Mental funciona de maneira semelhante. Ela permite que você invada a mente de um {GLOBAL.GodirLoreConcept.Hyperlink} para aprender sobre seus pesadelos e prendê-los dentro de seus medos ou ambições mais profundos.\""

msgid "STORY_EVENT@1064_1622@BUTTON_0"
msgstr "\"Insidioso. Eu gosto disso [evilact/].\""

msgid "STORY_EVENT@1064_1622@BUTTON_1"
msgstr "\"Isso parece um mal necessário.\""

msgid "STORY_EVENT@1064_1622@TITLE"
msgstr "Tecelão de Pesadelos"

msgid "STORY_EVENT@1064_1636@BODY_FOOTER"
msgstr "\"O banho de sangue do campo de batalha é apenas o aperitivo. Uma vez que os vencidos entram no matadouro, a verdadeira diversão começa.\""

msgid "STORY_EVENT@1064_1636@BODY_HEADER"
msgstr "Uma chama tremeluzente zombeteira seus olhos enquanto {EventPlayer} ascende de uma poça de icor escarlate."

msgid "STORY_EVENT@1064_1636@BODY_LORE"
msgstr "\"Alguns dizem que o sangue dos homens seria um afrodisíaco,\" <<p:EventPlayer>> diz com um sorriso malicioso. \"Eu digo que é uma fonte de poder. Eu bebo, enquanto meus {EventRace} consomem carne e ossos. É uma divisão justa, não acha?\""

msgid "STORY_EVENT@1064_1636@BUTTON_0"
msgstr "\"Canibalismo? Isso é nojento...\" [goodact/]"

msgid "STORY_EVENT@1064_1636@BUTTON_1"
msgstr "\"Veremos quem ri por último.\""

msgid "STORY_EVENT@1064_1636@BUTTON_2"
msgstr "\"Embora eu aprecie seus métodos mórbidos [evilact/], você ainda deve cair diante do meu trono.\""

msgid "STORY_EVENT@1064_1636@TITLE"
msgstr "A Loucura de {EventPlayer}"

msgid "STORY_EVENT@1064_1641@BODY_FOOTER"
msgstr "\"Eu não tenho a Bobina Dourada. Matei muitos para ganhá-la como meu prêmio, mas em vão. Agora, leve esta coisa embora—por favor!\""

msgid "STORY_EVENT@1064_1641@BODY_HEADER"
msgstr "Ao avistar o {EventUnit}, {EventPlayer} congela."

msgid "STORY_EVENT@1064_1641@BODY_LORE"
msgstr "Parecendo incapaz de agir ou fugir, <<p:EventPlayer>> expressa terror crescente enquanto a criatura horrível lentamente se aproxima de <<P:EventPlayer>>."

msgid "STORY_EVENT@1064_1641@BUTTON_0"
msgstr "Deixe o {EventUnit} arrastar {EventPlayer} para o Mar Astral. [evilact/]"

msgid "STORY_EVENT@1064_1641@BUTTON_1"
msgstr "\"Vá embora e nunca mais volte!\" [goodact/]"

msgid "STORY_EVENT@1064_1641@BUTTON_2"
msgstr "\"Se eu te salvar, você me serve.\""

msgid "STORY_EVENT@1064_1641@TITLE"
msgstr "Passado Atormentado: Consequências"

msgid "STORY_EVENT@1064_1645@BODY_FOOTER"
msgstr "\"Deixem suas armas e vocês podem encontrar paz na vida após a morte. Todos que resistirem serão abatidos e purgados.\""

msgid "STORY_EVENT@1064_1645@BODY_HEADER"
msgstr "\"Foram-se, prole imunda de {GLOBAL.ObbadothLoreConcept.Hyperlink}!\" Um grito justo perfura os céus enquanto {EventPlayer} desce de cima com fúria sagrada."

msgid "STORY_EVENT@1064_1645@BODY_LORE"
msgstr "\"Seus disfarces sombrios não podem enganar minha verdadeira visão, pois seus demônios interiores traíram seu propósito. A Caldera Carmim é um cálice sempre fluente de violência e morte. Eu beberei dele.\""

msgid "STORY_EVENT@1064_1645@BUTTON_0"
msgstr "\"Você terá sua guerra.\""

msgid "STORY_EVENT@1064_1645@TITLE"
msgstr "A Loucura de {EventPlayer}"

msgid "STORY_EVENT@1064_1647@BODY_FOOTER"
msgstr "\"Há um {EventUnit} acorrentado à Caldera Carmim. Liberte <<p:EventUnit>> e <<p:EventUnit>> não negará a você o julgamento de {EventPlayer}.\""

msgid "STORY_EVENT@1064_1647@BODY_HEADER"
msgstr "\"Os demônios de {GLOBAL.ObbadothLoreConcept.Hyperlink} se deleitam com a corrupção,\" {EventHero.FirstName} elabora. \"Mais do que destruição, eles buscam alimentar os demônios interiores de suas vítimas.\""

msgid "STORY_EVENT@1064_1647@BODY_LORE"
msgstr "\"Em raras ocasiões, esses demônios conseguem arrastar um {EventUnit} para seu reino demoníaco, onde o aprisionam e tentam corrompê-lo através de rituais sem fim.\""

msgid "STORY_EVENT@1064_1647@BUTTON_0"
msgstr "\"O dia do julgamento está chegando.\""

msgid "STORY_EVENT@1064_1647@TITLE"
msgstr "Ambições Profanas"

msgid "STORY_EVENT@1064_1648@BODY_FOOTER"
msgstr "\"Eu não tenho o Gildercoil. Mas pegue o que quiser, {PlayerLeader}. Qualquer coisa para afastar o {EventUnit} do meu caminho.\""

msgid "STORY_EVENT@1064_1648@BODY_HEADER"
msgstr "O {EventUnit} ascende às nuvens acima de {EventPlayer}. <<Co:EventUnit>> A mera presença causa {EventPlayer.FirstName} a se desintegrar."

msgid "STORY_EVENT@1064_1648@BODY_LORE"
msgstr "\"Seus poderes profanos vão além do que eu esperava, {PlayerLeader.TitleName}. Eu me retirarei da Caldera Carmesim e não voltarei.\" Ansiosamente, {EventPlayer.FirstName} olha para o {EventUnit} e depois de volta para você."

msgid "STORY_EVENT@1064_1648@BUTTON_0"
msgstr "\"Que seja conhecido por todo o reino [influence/] que você se retira por minha misericórdia.\""

msgid "STORY_EVENT@1064_1648@BUTTON_1"
msgstr "\"Faça suas tropas mais zelosas [unit/] jurarem lealdade a mim.\""

msgid "STORY_EVENT@1064_1648@BUTTON_2"
msgstr "\"Eu não preciso de suas ofertas patéticas. O julgamento aguarda [evilact/].\""

msgid "STORY_EVENT@1064_1648@TITLE"
msgstr "Ambições Profanas: Consequências"

msgid "STORY_EVENT@1064_1650@BODY_FOOTER"
msgstr "\"O que você precisa é de um {EventUnit} para ameaçar <<ge:judgment^n,EventPlayer.FirstName>>.\""

msgid "STORY_EVENT@1064_1650@BODY_HEADER"
msgstr "\"Há um velho ditado de que o que um inquisidor mais teme é a própria inquisição.\" {EventHero} fala lentamente, interpretando o vislumbre de <<ge:mind^n,EventPlayer.FirstName>>."

msgid "STORY_EVENT@1064_1650@BODY_LORE"
msgstr "\"Parece que o zelo de {EventPlayer} é impulsionado pelo <<o:EventPlayer>> medo de não ser digno <<r:EventPlayer>>. Ao erradicar o mal, <<p:EventPlayer>> tenta provar <<o:EventPlayer>> pureza de fé, mas <<p:EventPlayer>> teme que o verdadeiro caminho para a ascensão ainda esteja oculto de <<P:EventPlayer>>.\""

msgid "STORY_EVENT@1064_1650@BUTTON_0"
msgstr "\"O plano é bom, mas onde eu encontraria um {EventUnit} em um reino demoníaco?\""

msgid "STORY_EVENT@1064_1650@TITLE"
msgstr "Julgando o Juiz"

msgid "STORY_EVENT@1064_1674@BODY_FOOTER"
msgstr "\"Há três <<m:{EventSpawner}>> dedicados a Atyngwe longe a sudoeste. Negocie bem, e <<ge: contract^n,EventPlayer.FirstName>> será seu.\""

msgid "STORY_EVENT@1064_1674@BODY_HEADER"
msgstr "\"Um contrato com os Príncipes de {GLOBAL.ObbadothLoreConcept.Hyperlink} não pode ser quebrado. Mas pode ser alterado.\""

msgid "STORY_EVENT@1064_1674@BODY_LORE"
msgstr "\"Se Atyngwe transferir <<ge: debt^n,EventPlayer.FirstName>> para você, <<p:EventPlayer>> estará à sua mercê. Atyngwe em si não tem posses na Caldera Carmesim, mas há maneiras de fazer sua voz ser ouvida.\""

msgid "STORY_EVENT@1064_1674@BUTTON_0"
msgstr "<<ge: schemes^p,EventPlayer.FirstName>> estão prestes a terminar."

msgid "STORY_EVENT@1064_1674@TITLE"
msgstr "Negociações Infernais"

msgid "STORY_EVENT@1064_1675@BODY_FOOTER"
msgstr "\"Diga-me, {PlayerLeader.TitleName}, o que você tem a oferecer em troca pela alma de um {GLOBAL.GodirLoreConcept.Hyperlink}?\""

msgid "STORY_EVENT@1064_1675@BODY_HEADER"
msgstr "Finalmente, Atyngwe em pessoa responde aos seus chamados. \"Eu vim.\""

msgid "STORY_EVENT@1064_1675@BODY_LORE"
msgstr "\"O que você busca será custoso, {PlayerLeader}.\" Dentro das mãos de Atyngwe, um pergaminho assinado em sangue aparece. \"Um contrato com um Príncipe de {GLOBAL.ObbadothLoreConcept.Hyperlink} não é uma mera mercadoria. Mas você despertou meu interesse...\""

msgid "STORY_EVENT@1064_1675@BUTTON_0"
msgstr "\"Minhas vitórias [influence/] na Caldera Carmesim serão dedicadas a você, ó Atyngwe, maior de todos os Príncipes Demoníacos.\""

msgid "STORY_EVENT@1064_1675@BUTTON_1"
msgstr "\"Eu presenteio sua majestade com um exército [unitprod/] para comandar.\""

msgid "STORY_EVENT@1064_1675@BUTTON_2"
msgstr "\"Uma alma pelas almas de uma nação [population/], um sacrifício que vale a pena fazer [evilact/].\""

msgid "STORY_EVENT@1064_1675@BUTTON_3"
msgstr "Este preço é muito alto. Melhor enfrentar {EventPlayer} da maneira convencional."

msgid "STORY_EVENT@1064_1675@TITLE"
msgstr "Encontrando o Diabo"

msgid "STORY_EVENT@1064_1677@BODY_FOOTER"
msgstr "\"{EventPlayer.FirstName} não é o cativo do {EventRace}, mas <<p:EventPlayer>> perdeu <<o:EventPlayer>> alma para o Príncipe Demoníaco Atyngwe e deve, por contrato, obedecer à sua vontade.\""

msgid "STORY_EVENT@1064_1677@BODY_HEADER"
msgstr "\"Oh meu, oh meu...\" {EventHero} levanta uma sobrancelha. \"Mesmo para {GLOBAL.GodirLoreConcept.Hyperlink}, esta mente é um labirinto não facilmente navegado.\""

msgid "STORY_EVENT@1064_1677@BODY_LORE"
msgstr "\"{EventPlayer} habita na decepção e na trapaça. Tudo o que <<p:EventPlayer>> diz parece ser mentira, mas há uma verdade irônica em <<o:EventPlayer>> pedido encenado por ajuda.\""

msgid "STORY_EVENT@1064_1677@BUTTON_0"
msgstr "Pergunte como isso ajudará em sua causa."

msgid "STORY_EVENT@1064_1677@TITLE"
msgstr "Fraqueza da Verdade"

msgid "STORY_EVENT@1064_1679@BODY_FOOTER"
msgstr "Está claro que nada de útil pode vir de falar com o {EventUnit}."

msgid "STORY_EVENT@1064_1679@BODY_HEADER"
msgstr "Ao chamar por Atyngwe, um {EventUnit} emerge do fechamento do rift infernal que os cultistas haviam invocado. \"Você chama meu mestre, sim, sim?\""

msgid "STORY_EVENT@1064_1679@BODY_LORE"
msgstr "Tendo ouvido seu caso, o {EventUnit} balança <<o:EventUnit>> cabeça, rindo. \"Feiticeiro bobo, contratos demoníacos não são para negociação, não, não.\" <<Cp:EventUnit>> pula de uma perna para a outra de maneira nervosa. \"Mas eu posso jogar uma pedra queimada para você. Um, dois e ela morde!\""

msgid "STORY_EVENT@1064_1679@BUTTON_0"
msgstr "Deixe o {EventUnit} retornar ao <<o:EventUnit>> mestre."

msgid "STORY_EVENT@1064_1679@TITLE"
msgstr "Encontrando a Terra Sob os Sapatos do Advogado do Diabo"

msgid "STORY_EVENT@1064_1682@BODY_FOOTER"
msgstr "Qual {GLOBAL.GodirLoreConcept.Hyperlink} será o alvo da sua intrusão sombria?"

msgid "STORY_EVENT@1064_1682@BODY_HEADER"
msgstr "Realizando o ritual ensinado a você por {EventHero}, você recita os encantamentos do feitiço Fio da Mente:"

msgid "STORY_EVENT@1064_1682@BODY_LORE"
msgstr "\"Quando a escuridão cai[br/]e as sombras rastejam[br/]um tecelão vem para aqueles que dormem.[br/]Tecel-me um fio de sonhos e medos,[br/]uma rede que me leva às suas lágrimas.\""

msgid "STORY_EVENT@1064_1682@BUTTON_0"
msgstr "{DarkAI}"

msgid "STORY_EVENT@1064_1682@BUTTON_1"
msgstr "{BarbAI}"

msgid "STORY_EVENT@1064_1682@BUTTON_2"
msgstr "{IndusAI}"

msgid "STORY_EVENT@1064_1682@BUTTON_3"
msgstr "{Frikka}"

msgid "STORY_EVENT@1064_1682@BUTTON_4"
msgstr "{HighAI}"

msgid "STORY_EVENT@1064_1682@BUTTON_5"
msgstr "Ninguém para alvejar"

msgid "STORY_EVENT@1064_1682@TITLE"
msgstr "Lançando o Feitiço Fio da Mente"

msgid "STORY_EVENT@1064_1686@BODY_FOOTER"
msgstr "\"Paciência. Você não sabia que nós demônios inventamos a burocracia? Foi um golpe de gênio.\""

msgid "STORY_EVENT@1064_1686@BODY_HEADER"
msgstr "Mais uma vez você desafia Atyngwe a se mostrar. Desta vez, um {EventUnit} vem à frente."

msgid "STORY_EVENT@1064_1686@BODY_LORE"
msgstr "\"Uma modificação de contrato concernente ao locatário {EventPlayer}? Delicioso,\" <<p:EventUnit>> diz com uma voz seca. \"Bem, preencha os formulários e nós avaliaremos o pedido. Nenhum prazo específico garantido.\""

msgid "STORY_EVENT@1064_1686@BUTTON_0"
msgstr "Deixe o {EventUnit} retornar através do rift infernal."

msgid "STORY_EVENT@1064_1686@BUTTON_3"
msgstr "Comande o {EventUnit} para chamar o mestre de <<o:EventUnit>> diretamente."

msgid "STORY_EVENT@1064_1686@BUTTON_4"
msgstr "Ameace ferir o {EventUnit} com luz sagrada."

msgid "STORY_EVENT@1064_1686@TITLE"
msgstr "Encontrando o Advogado do Diabo"

msgid "STORY_EVENT@1064_1694@BODY_FOOTER"
msgstr "\"Você pode me possuir no além, mas até então sou livre para ir. Pegue o que mais lhe agrada como um pedágio para a minha dívida.\""

msgid "STORY_EVENT@1064_1694@BODY_HEADER"
msgstr "Notando o pergaminho muito familiar em suas mãos, {EventPlayer} mostra sinais claros de pânico."

msgid "STORY_EVENT@1064_1694@BODY_LORE"
msgstr "\"Quão... generoso de você resgatar meu contrato e me libertar do aperto exigente de Atyngwe.\" Vendo sua reação divertida, <<p:EventPlayer>> para. \"Bem jogado, {PlayerLeader}. Se eu tivesse a Bobina Dourada, ela seria sua.\""

msgid "STORY_EVENT@1064_1694@BUTTON_0"
msgstr "\"Esvazie seu tesouro [gold/], {EventPlayer}!\""

msgid "STORY_EVENT@1064_1694@BUTTON_1"
msgstr "\"Envie todo o mana [mana/] que você tem armazenado!\""

msgid "STORY_EVENT@1064_1694@BUTTON_2"
msgstr "\"Compartilhe seus segredos [knowledge/], mago trapaceiro!\""

msgid "STORY_EVENT@1064_1694@TITLE"
msgstr "Negociações Infernais: Consequências"

msgid "STORY_EVENT@1064_1696@BODY_FOOTER"
msgstr "\"Este martelo deve seu poder à alma de um Gigante da Tempestade que habita dentro dele. Qual dos meus artefatos o seu habitará, {PlayerLeader}?\""

msgid "STORY_EVENT@1064_1696@BODY_HEADER"
msgstr "A fanfarra de mil martelos batendo em uma bigorna anuncia a chegada de {EventPlayer}, Príncipe Demônio da Forja."

msgid "STORY_EVENT@1064_1696@BODY_LORE"
msgstr "\"Bem-vindo, {PlayerLeader}, a um [hyperlink,GLOBAL.ObbadothLoreConcept]mundo de reabilitação[/hyperlink], onde até a alma mais abjeta recebe seu propósito. Trabalhe no cadinho, alimente os fogos de {EventCity} ou prove ser digno de aumentar minhas máquinas e armamentos com sua força vital. De qualquer forma, você é um recurso valioso para {EventPlayer}.\""

msgid "STORY_EVENT@1064_1696@BUTTON_0"
msgstr "\"Serei a espada do seu carrasco.\""

msgid "STORY_EVENT@1064_1696@TITLE"
msgstr "A Loucura de {EventPlayer}"

msgid "STORY_EVENT@1064_1697@BODY_FOOTER"
msgstr "{EventHero.FirstName} se contrai na <<o:EventHero>> teia etérea, que começa a se mover como sombras líquidas devoram violentamente o chifre. \"Quando um inimigo não pode ser aprisionado, deve ser sobrepujado.\""

msgid "STORY_EVENT@1064_1697@BODY_HEADER"
msgstr "Tentando perseguir a mente de {EventPlayer}, você sente uma forte força empurrando sua pegada astral para longe, como uma armadura deflectindo uma flecha."

msgid "STORY_EVENT@1064_1697@BODY_LORE"
msgstr "\"Invadir a memória de um Príncipe Demônio? Eu admiro suas ambições, {PlayerLeader}.\" {EventHero} tira o chifre de um touro e lentamente o cobre com cordas astrais escuras. \"Mas parece que séculos de competição e traição ensinaram os Príncipes de {GLOBAL.ObbadothLoreConcept.Hyperlink} a proteger bem suas mentes.\""

msgid "STORY_EVENT@1064_1697@BUTTON_0"
msgstr "Aceite o presente [unit/] de {EventHero}."

msgid "STORY_EVENT@1064_1697@TITLE"
msgstr "Barreira Mental"

msgid "STORY_EVENT@1064_1700@BODY_FOOTER"
msgstr "Enquanto contempla que a Bobina Dourada não foi encontrada com nenhum dos presentes {GLOBAL.GodirLoreConcept.Hyperlink}, você é abordado por uma figura suspeitamente familiar - {EventPlayer}!"

msgid "STORY_EVENT@1064_1700@BODY_HEADER"
msgstr "Os campos da Caldera Carmim foram encharcados com o sangue de seus adversários."

msgid "STORY_EVENT@1064_1700@BODY_LORE"
msgstr "Você demonstrou valentia e habilidade como um general no campo de batalha e quebrou a maldição da guerra sem fim neste reino. Se os Príncipes de {GLOBAL.ObbadothLoreConcept.Hyperlink} tolerarão seu ponto de apoio em seu mundo demoníaco ainda está para ser visto. Por enquanto, há um silêncio pacífico."

msgid "STORY_EVENT@1064_1700@BUTTON_0"
msgstr "Deixe {EventPlayer.FirstName} falar."

msgid "STORY_EVENT@1064_1700@TITLE"
msgstr "A Recompensa da Caldera Carmim"

msgid "STORY_EVENT@1064_1704@BODY_FOOTER"
msgstr "O Gildercoil não está com {EventPlayer}. Você lança <<P:EventPlayer>> no {GLOBAL.AstralVoidLoreConcept.Hyperlink} como um testemunho do que acontece com seus inimigos."

msgid "STORY_EVENT@1064_1704@BODY_HEADER"
msgstr "Armaduras foram destruídas, fortalezas foram violadas e {EventPlayer} está derrotado a seus pés."

msgid "STORY_EVENT@1064_1704@BODY_LORE"
msgstr "\"Todos nós viemos à Caldera Carmim para reclamar o Gildercoil para nós mesmos. Os sussurros do reino... prometem isso como uma recompensa para o último que viver. Um demônio que eu seduzi uma vez chamou o nome Perumplex, mas ainda não ouvi seu significado.\""

msgid "STORY_EVENT@1064_1704@BUTTON_0"
msgstr "Devemos continuar procurando."

msgid "STORY_EVENT@1064_1704@TITLE"
msgstr "A Queda de {EventPlayer}"

msgid "STORY_EVENT@1064_1705@BODY_FOOTER"
msgstr "O Gildercoil não está com {EventPlayer}. Você lança <<P:EventPlayer>> no {GLOBAL.AstralVoidLoreConcept.Hyperlink} como um testemunho do que acontece com seus inimigos."

msgid "STORY_EVENT@1064_1705@BODY_HEADER"
msgstr "Armaduras foram destruídas, fortalezas foram violadas e {EventPlayer} está derrotado a seus pés."

msgid "STORY_EVENT@1064_1705@BODY_LORE"
msgstr "\"Na Caldera Carmim, o Gildercoil aguarda como um prêmio cobiçado... ou assim prometem os sussurros de além. Um rei que minha {EventRace} já festejou gritou o nome Liztia, mas não levou a nada mais.\""

msgid "STORY_EVENT@1064_1705@BUTTON_0"
msgstr "Devemos continuar procurando."

msgid "STORY_EVENT@1064_1705@TITLE"
msgstr "A Queda de {EventPlayer}"

msgid "STORY_EVENT@1064_1706@BODY_FOOTER"
msgstr "O Gildercoil não está com {EventPlayer}. {EventPlayer} foge por uma fenda do inferno que se abre bem abaixo, antes que você possa lançá-lo no {GLOBAL.AstralVoidLoreConcept.Hyperlink}."

msgid "STORY_EVENT@1064_1706@BODY_HEADER"
msgstr "Armaduras foram destruídas, fortalezas foram violadas e {EventPlayer} está derrotado a seus pés."

msgid "STORY_EVENT@1064_1706@BODY_LORE"
msgstr "\"Maldito seja o nome de Gontro, o mais baixo e desprezível de todos os Príncipes Demoníacos. Ele moldou esta arena de batalha eterna, atraindo vítimas para lutar até a morte. O Gildercoil... Eu o terei... em outro dia.\""

msgid "STORY_EVENT@1064_1706@BUTTON_0"
msgstr "Devemos continuar procurando."

msgid "STORY_EVENT@1064_1706@TITLE"
msgstr "A Queda de {EventPlayer}"

msgid "STORY_EVENT@1064_1708@BODY_FOOTER"
msgstr "O Gildercoil não está com {EventPlayer}. Você lança <<P:EventPlayer>> no {GLOBAL.AstralVoidLoreConcept.Hyperlink} como um testemunho do que acontece com seus inimigos."

msgid "STORY_EVENT@1064_1708@BODY_HEADER"
msgstr "Armaduras foram destruídas, fortalezas foram violadas e {EventPlayer} está derrotado a seus pés."

msgid "STORY_EVENT@1064_1708@BODY_LORE"
msgstr "\"Ah, minha força não foi suficiente! Quem agora irá executar vingança sobre Zhitur, traidor e ladrão do Gildercoil? Quem irá reclamar o artefato em nome dos {GLOBAL.ArchonsLoreConcept.Hyperlink} e sua única fé verdadeira?\""

msgid "STORY_EVENT@1064_1708@BUTTON_0"
msgstr "Devemos continuar procurando."

msgid "STORY_EVENT@1064_1708@TITLE"
msgstr "A Queda de {EventPlayer}"

msgid "STORY_EVENT@1064_1711@BODY_FOOTER"
msgstr "O Gildercoil não está com {EventPlayer}. Uma fenda do inferno se abre abaixo de <<p:EventPlayer>> na qual {EventPlayer.FirstName} é arrastado por garras de sombra pura."

msgid "STORY_EVENT@1064_1711@BODY_HEADER"
msgstr "Armaduras foram destruídas, fortalezas foram violadas e {EventPlayer} está derrotado a seus pés."

msgid "STORY_EVENT@1064_1711@BODY_LORE"
msgstr "\"Oh {PlayerLeader}, por que não tem misericórdia de uma pobre alma necessitada? Minha hora do destino se aproxima... Pagarei por essas palavras, mas Atyngwe é quem você deve procurar.\""

msgid "STORY_EVENT@1064_1711@BUTTON_0"
msgstr "Devemos continuar procurando."

msgid "STORY_EVENT@1064_1711@TITLE"
msgstr "A Queda de {EventPlayer}"

msgid "STORY_EVENT@1064_1720@BODY_FOOTER"
msgstr "\"Você ganhou a recompensa da Caldera Carmim, {PlayerLeader}. O Gildercoil me deu o que eu desejava, e não tenho arrependimentos em ceder o item de ira eterna do [hyperlink,GLOBAL.ArchonsLoreConcept]Arconte[/hyperlink] em seu nome.\""

msgid "STORY_EVENT@1064_1720@BODY_HEADER"
msgstr "\"Muitos vieram e morreram nesta arena do meu divertimento pessoal. Todos buscavam poder e encontraram a morte irônica—exceto você.\""

msgid "STORY_EVENT@1064_1720@BODY_LORE"
msgstr "{EventPlayer.FirstName} faz um gesto, como se estivesse colocando uma máscara, revelando brevemente um rosto infernal e com chifres. \"Tenho muitos nomes. Atyngwe, Liztia, Perumplex, Zhitur, Gontro... as pessoas ficam criativas quando se trata do Príncipe Demônio do Engano.\""

msgid "STORY_EVENT@1064_1720@BUTTON_0"
msgstr "Pegue o Gildercoil para completar sua vitória."

msgid "STORY_EVENT@1064_1720@TITLE"
msgstr "Encontrando o Gildercoil"

msgid "STORY_EVENT@1064_1725@BODY_FOOTER"
msgstr "Enquanto contemplava que o Gildercoil não poderia ser encontrado com nenhum dos {GLOBAL.GodirLoreConcept.Hyperlink} presentes, você é abordado por uma figura suspeitamente familiar - {EventPlayer}!"

msgid "STORY_EVENT@1064_1725@BODY_HEADER"
msgstr "Os campos da Caldera Carmim foram encharcados com o sangue de seus adversários."

msgid "STORY_EVENT@1064_1725@BODY_LORE"
msgstr "Você demonstrou valentia e habilidade como um general no campo de batalha e quebrou a maldição da guerra sem fim neste reino. Se os Príncipes de {GLOBAL.ObbadothLoreConcept.Hyperlink} tolerarão seu ponto de apoio em seu mundo demoníaco ainda está para ser visto. Por enquanto, há um silêncio pacífico."

msgid "STORY_EVENT@1064_1725@BUTTON_0"
msgstr "Deixe {EventPlayer.FirstName} falar."

msgid "STORY_EVENT@1064_1725@TITLE"
msgstr "A Recompensa da Caldera Carmim"

msgid "STORY_EVENT@1064_1733@BODY_FOOTER"
msgstr "Você emergiu deste conflito como um herói e salvador do seu povo. Levado pela euforia deles, você sente seus espíritos sendo elevados alto, além do horizonte e em direção ao {GLOBAL.AstralSeaLoreConcept.Hyperlink}."

msgid "STORY_EVENT@1064_1733@BODY_HEADER"
msgstr "\"Vitória!\" é o que ecoa nas ruas de {EventCity}, \"Vitória!\" é o que está gravado nos corações dos {EventRace} por {EventEnemy}, {GLOBAL.GodirLoreConcept.Hyperlink} de Fogo, foi derrotado."

msgid "STORY_EVENT@1064_1733@BODY_HEADER@NO_CITY"
msgstr "\"Vitória!\" é o que ecoa pelo Vale das Maravilhas, \"Vitória!\" é o que está gravado nos corações dos {EventRace} por {EventEnemy}, {GLOBAL.GodirLoreConcept.Hyperlink} de Fogo, foi derrotado."

msgid "STORY_EVENT@1064_1733@BODY_LORE"
msgstr "A fumaça ainda paira sobre as cidades orgulhosas dos {EventEnemyRace}, enquanto você reflete sobre suas próprias conquistas. Foi realmente um [hyperlink,GLOBAL.AscendedChampLoreConcept]Herói Mortal[/hyperlink] que derrotou o {GLOBAL.WizardKingLoreConcept.Hyperlink} {EventEnemy.FirstName}? Ou sua jornada de conhecimento e poder já havia alterado seu destino?"

msgid "STORY_EVENT@1064_1733@BUTTON_0"
msgstr "Libere Athla para concluir sua ascensão."

msgid "STORY_EVENT@1064_1733@TITLE"
msgstr "A Queda de {EventEnemy}"

msgid "STORY_EVENT@1064_1736@BODY_FOOTER"
msgstr "Elya, a Maer, junta-se a você enquanto você parte para Magehaven, vitorioso."

msgid "STORY_EVENT@1064_1736@BODY_HEADER"
msgstr "Você lançou a Deusa Sereia no vazio e reclamou o Arquipélago Encantado de seu abraço afogante!"

msgid "STORY_EVENT@1064_1736@BODY_LORE"
msgstr "Da sua capital, a mítica Maer emerge mais uma vez. \"Agradeço-lhe, {PlayerLeader.TitleName}, por ouvir minha canção e libertar o reino. Receio não ter nada para dar como recompensa para um Godir... mas se você me permitir juntar-me a você em suas viagens, posso compartilhar o que aprendi como prisioneira de Nimue.\""

msgid "STORY_EVENT@1064_1736@BODY_LORE@ELYA_NOT_FREED"
msgstr "De sua prisão escondida, uma mítica Maer emerge, flutuando em correntes invisíveis. \"Agradeço-lhe, {PlayerLeader.TitleName}, por ouvir minha canção e libertar o reino. Meu nome é Elya. Receio não ter nada para dar como recompensa para um Godir... mas se você me permitir juntar-me a você em suas viagens, posso compartilhar o que aprendi como prisioneira de Nimue.\""

msgid "STORY_EVENT@1064_1736@BUTTON_0"
msgstr "Outro reino libertado pelo grande {PlayerLeader.TitleName}!"

msgid "STORY_EVENT@1064_1736@TITLE"
msgstr "O Arquipélago Encantado: Vitória"

msgid "STORY_EVENT@1064_1795@BODY_FOOTER"
msgstr "{EventPlayer.FirstName} esmaga a figurinha com a mão esquerda de <<o:EventPlayer>>. \"Alguns sacrifícios valem a pena.\""

msgid "STORY_EVENT@1064_1795@BODY_HEADER"
msgstr "\"Os {GLOBAL.ArchonsLoreConcept.Hyperlink} deixaram um guardião poderoso para vigiar seu mundo proibido.\" {EventPlayer} tira uma figurinha joalhada e a coloca em um pedestal."

msgid "STORY_EVENT@1064_1795@BODY_LORE"
msgstr "\"{TargetPlayer} é o primeiro dos {GLOBAL.GodirLoreConcept.Hyperlink} e um amigo leal dos Archons. <<Cp:TargetPlayer>> poderia ter sido um deus. Em vez disso, <<p:TargetPlayer>> tornou-se um mero vigia, esperando por um inimigo para derrubá-lo.\""

msgid "STORY_EVENT@1064_1795@BUTTON_0"
msgstr "Discutir o plano de batalha."

msgid "STORY_EVENT@1064_1795@TITLE"
msgstr "A Batalha por Grexolis"

msgid "STORY_EVENT@1064_1796@BODY_FOOTER"
msgstr "\"Nada pode resistir à nossa força mágica combinada. Juntos, lançaremos um feitiço que abalará os alicerces de {GLOBAL.GrexolisLoreConcept.Hyperlink}.\""

msgid "STORY_EVENT@1064_1796@BODY_HEADER"
msgstr "\"Basta de conversa. O destino não espera.\" {EventPlayer} incendeia os fragmentos da figurinha quebrada até que se incinerem."

msgid "STORY_EVENT@1064_1796@BODY_LORE"
msgstr "\"Não importa quem ou o que está no caminho de nossa vitória. Nós somos {GLOBAL.GodirLoreConcept.Hyperlink}. Nós somos {GLOBAL.ShadraiFactionLoreConcept.Hyperlink}! Foram-se os tempos amaldiçoados em que tivemos que confiar nos esquemas de mortais inferiores para alcançar nossos objetivos.\""

msgid "STORY_EVENT@1064_1796@BUTTON_0"
msgstr "Realizar <<gu:ritual da pira^N,EventPlayer.FirstName>>."

msgid "STORY_EVENT@1064_1796@BUTTON_1"
msgstr "Realizar <<gu:ritual dos afogados^N,Nimue.FirstName>>."

msgid "STORY_EVENT@1064_1796@BUTTON_2"
msgstr "Realizar <<gu:ritual da terra despedaçada^N,Ydgaard.FirstName>>."

msgid "STORY_EVENT@1064_1796@BUTTON_3"
msgstr "Realizar <<gu:ritual da maldição do espelho^N,Arachna.FirstName>>."

msgid "STORY_EVENT@1064_1796@TITLE"
msgstr "Magia Shad'rai"

msgid "STORY_EVENT@1064_1797@BODY_FOOTER"
msgstr "\"Você não pode compreender o mal que eu guardo. Não é o guardião que você deve temer, mas os prisioneiros.\""

msgid "STORY_EVENT@1064_1797@BODY_HEADER"
msgstr "Uma voz áspera, que parece ressonar das profundezas do Vazio Astral, ordena que você deixe {GLOBAL.GrexolisLoreConcept.Hyperlink}: \"Fujam, tolos!\""

msgid "STORY_EVENT@1064_1797@BODY_LORE"
msgstr "{EventPlayer} avança, severo e imóvel como uma rocha solitária na maré. \"Você veio a um mundo proibido. Vá embora agora e você poderá viver. Fique e encontrará seu destino.\""

msgid "STORY_EVENT@1064_1797@BUTTON_0"
msgstr "Ouça seus aliados. Mentiras vazias dos Archons não vão assustar os Shad'rai."

msgid "STORY_EVENT@1064_1797@TITLE"
msgstr "O Primeiro Godir"

msgid "STORY_EVENT@1064_1798@BODY_FOOTER"
msgstr "Os {GLOBAL.CovenantFactionLoreConcept.Hyperlink} seguiram os {GLOBAL.ShadraiFactionLoreConcept.Hyperlink} até {GLOBAL.GrexolisLoreConcept.Hyperlink}. Eles farão qualquer coisa para frustrar seus planos."

msgid "STORY_EVENT@1064_1798@BODY_HEADER"
msgstr "Da névoa da guerra, {Meandor}, {Sundren} e {Fangir} emergem."

msgid "STORY_EVENT@1064_1798@BODY_LORE"
msgstr "\"Parece que você esqueceu de nos convidar para sua tentativa louca de desatar um desastre cósmico,\" diz {Meandor.FirstName} friamente.[br/][br/]\"Primeiro você trouxe conflito para mundos inocentes,\" continua {Sundren.FirstName}, \"e agora... isso.\" {Fangir.FirstName} concorda em silêncio. <<Cp:Fangir>> não gosta de conversa frívola."

msgid "STORY_EVENT@1064_1798@BUTTON_0"
msgstr "Eles estão presos em conflitos passados. Mas o vencedor reescreve a história."

msgid "STORY_EVENT@1064_1798@TITLE"
msgstr "O Pacto"

msgid "STORY_EVENT@1064_1860@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um de seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> e melhorar gradualmente sua {GLOBAL.HouseInfluenceConcept.Hyperlink} com você."

msgid "STORY_EVENT@1064_1860@BODY_HEADER"
msgstr "Você encontra {EventHouseLord}, que se separou dos {EventRace} leais a <<P:EventHouseLord>> quando sua tribo entrou no {GLOBAL.ValleyofWondersLoreConcept.Hyperlink}."

msgid "STORY_EVENT@1064_1860@BODY_LORE"
msgstr "\"Falamos novamente, {PlayerLeader},\" diz {EventHouseLord} com uma voz severa. \"Lembre-se, nós de {EventHouse} não buscamos brigas. Foi a magia que causou a perda de nossa terra natal, a magia que matou o ancião de nossa tribo. Quando você pegou o {GLOBAL.TomeLoreConcept.Hyperlink} do ancião, você pediu por ruína. Mantemos nossa distância. Evitar toda a magia nos manterá seguros.\""

msgid "STORY_EVENT@1064_1860@BUTTON_0"
msgstr "\"Vamos começar formalmente um relacionamento diplomático.\""

msgid "STORY_EVENT@1064_1860@BUTTON_2"
msgstr "\"Veremos o que isso significa para o futuro dos {EventRace}. Por enquanto, nos separamos.\""

msgid "STORY_EVENT@1064_1860@TITLE"
msgstr "Encontrando os Separatistas"

msgid "STORY_EVENT@1064_1863@BODY_FOOTER"
msgstr "As ruínas seriam um local formidável para fundar uma {GLOBAL.CityConcept.Hyperlink} e deixar o passado pesado dar lugar a um novo futuro."

msgid "STORY_EVENT@1064_1863@BODY_HEADER"
msgstr "Nas profundezas do vale, seu {EventStackLeader} encontra uma grande área de ruínas cobertas pela vegetação."

msgid "STORY_EVENT@1064_1863@BODY_HEADER@HERO"
msgstr "Nas profundezas do vale, seu herói {EventStackLeader} encontra uma grande área de ruínas cobertas pela vegetação."

msgid "STORY_EVENT@1064_1863@BODY_HEADER@LORD"
msgstr "Nas profundezas do vale, você encontra uma grande área de ruínas cobertas pela vegetação."

msgid "STORY_EVENT@1064_1863@BODY_LORE"
msgstr "O que agora foi em grande parte reclamado pela natureza deve ter sido a cidade próspera de uma grande civilização. No entanto, uma força persistente de amargura habita sob a superfície pacífica. Você pode sentir que há [hyperlink,GLOBAL.SoulsLoreConcept]espíritos[/hyperlink] que ainda guardam rancor da antiga desgraça que aconteceu aqui."

msgid "STORY_EVENT@1064_1863@BUTTON_0"
msgstr "\"Vou considerar isso.\""

msgid "STORY_EVENT@1064_1863@BUTTON_2"
msgstr "\"Esses espíritos antigos me dão uma oportunidade única de estudar [knowledge/] o passado.\""

msgid "STORY_EVENT@1064_1863@BUTTON_3"
msgstr "\"Atrocidades passadas são os peões que semeiam o que eu colherei [souls/]...\""

msgid "STORY_EVENT@1064_1863@BUTTON_4"
msgstr "\"Essas pessoas tinham um forte vínculo com os espíritos da natureza. Eu invocarei seu guardião.\""

msgid "STORY_EVENT@1064_1863@TITLE"
msgstr "Vestígios de um Passado Distante"

msgid "STORY_EVENT@1064_1868@BODY_FOOTER"
msgstr "\"Seu {EventRace} pode ser útil para erguer os monumentos da minha glória afinal. Ajoelhe-se e salve-os. Agora!\""

msgid "STORY_EVENT@1064_1868@BODY_HEADER"
msgstr "Colunas de fumaça se elevam acima do {GLOBAL.ValleyofWondersLoreConcept.Hyperlink} e {EventPlayer.Name} está provocando você a se render."

msgid "STORY_EVENT@1064_1868@BODY_LORE"
msgstr "\"Não há vitória contra a tempestade furiosa, {PlayerLeader}. Os grandes impérios de {GLOBAL.AthlaLoreConcept.Hyperlink} não conseguiram parar nossos meros servos, os Nascidos da Sombra. Agora eles desmoronam diante de todo o poder dos {GLOBAL.ShadraiFactionLoreConcept.Hyperlink}.\""

msgid "STORY_EVENT@1064_1868@BUTTON_0"
msgstr "\"Nunca nos renderemos a um {EventPlayer.Title} invasor!\""

msgid "STORY_EVENT@1064_1868@TITLE"
msgstr "<<ge:Claim^n,EventPlayer.FirstName>>"

msgid "STORY_EVENT@1064_1875@BODY_FOOTER"
msgstr "\"Você não está sozinho nisso, {PlayerLeader}. As criaturas do Vale estão se juntando à nossa causa. Elas responderão ao seu chamado...\""

msgid "STORY_EVENT@1064_1875@BODY_HEADER"
msgstr "\"Bem dito, {PlayerLeader}!\" {AllyPlayer} grita com um brilho feroz nos olhos de <<o:AllyPlayer>>."

msgid "STORY_EVENT@1064_1875@BODY_LORE"
msgstr "\"O povo de {GLOBAL.AthlaLoreConcept.Hyperlink} é engenhoso. Forças maiores do que esta falharam em reclamar nosso mundo antes. {EventPlayer.FirstName} saberia disso se <<o:EventPlayer>> imenso ego não estivesse obscurecendo <<o:EventPlayer>> memória.\""

msgid "STORY_EVENT@1064_1875@BUTTON_0"
msgstr "Invocar os guardiões da floresta."

msgid "STORY_EVENT@1064_1875@BUTTON_4"
msgstr "Deixe sua voz ecoar através das montanhas ao redor."

msgid "STORY_EVENT@1064_1875@BUTTON_5"
msgstr "Chamar os espíritos ancestrais, guardiões das eras passadas."

msgid "STORY_EVENT@1064_1875@TITLE"
msgstr "<<ge:Retaliação^n,AllyPlayer.FirstName>>"

msgid "STORY_EVENT@1064_1896@BODY_FOOTER"
msgstr "\"Sou imortal. Se eu cair, retorno. Sua vida, porém,... termina.\""

msgid "STORY_EVENT@1064_1896@BODY_HEADER"
msgstr "Uma calma se instala no campo de batalha perto de {EventCity}. Ou assim parecia, pois {EventPlayer} não tolera silêncio."

msgid "STORY_EVENT@1064_1896@BODY_LORE"
msgstr "\"Qualquer vitória que você pudesse alcançar hoje será insignificante, {PlayerLeader}. {GLOBAL.AthlaLoreConcept.Hyperlink} é apenas um peão neste jogo de poder. Viemos punir os infiéis, recompensar nossos servos leais. Enquanto isso, os planos dos {GLOBAL.ShadraiFactionLoreConcept.Hyperlink} estão se concretizando, além do seu alcance ou compreensão.\""

msgid "STORY_EVENT@1064_1896@BUTTON_0"
msgstr "\"Então, vamos acabar com isso, de uma forma ou de outra!\""

msgid "STORY_EVENT@1064_1896@TITLE"
msgstr "<<ge:Fúria^n,EventPlayer.FirstName>>"

msgid "STORY_EVENT@1064_1897@BODY_FOOTER"
msgstr "\"O Pacto está lhe enviando um presente de {GLOBAL.MagehavenLoreConcept.Hyperlink}, {PlayerLeader}. Você derrubará {EventPlayer.FirstName}, acabará com o ataque de <<o:EventPlayer>>!\""

msgid "STORY_EVENT@1064_1897@BODY_HEADER"
msgstr "\"Não ouça essas mentiras, {PlayerLeader}.\" {AllyPlayer.FirstName} levanta <<o:AllyPlayer>> {EventItem}. \"Lutar por aqueles que você ama nunca é em vão!\""

msgid "STORY_EVENT@1064_1897@BODY_LORE"
msgstr "\"{EventPlayer.FirstName} pode afirmar que os {GLOBAL.ShadraiFactionLoreConcept.Hyperlink} são os Governantes incontestáveis além de {GLOBAL.AthlaLoreConcept.Hyperlink}, mas não são. Em {GLOBAL.MagehavenLoreConcept.Hyperlink}, eles são apenas uma facção entre muitas. Nós do {GLOBAL.CovenantFactionLoreConcept.Hyperlink} condenamos suas ações. E os confrontamos, onde podemos.\""

msgid "STORY_EVENT@1064_1897@BUTTON_0"
msgstr "Sua confiança em minhas habilidades não será em vão."

msgid "STORY_EVENT@1064_1897@TITLE"
msgstr "<<ge:Retaliação^n,AllyPlayer.FirstName>>"

msgid "STORY_EVENT@1064_1898@BODY_FOOTER"
msgstr "\"Você está cometendo um grave erro, {PlayerLeader}. No final, os Shad'rai serão os únicos vencedores nesta guerra desnecessária.\""

msgid "STORY_EVENT@1064_1898@BODY_HEADER"
msgstr "{EventPlayer} olha para você com desprezo: \"Então chegou a isso, e os refugiados que precisavam de abrigo se tornaram os invasores.\""

msgid "STORY_EVENT@1064_1898@BODY_LORE"
msgstr "\"A história continua se repetindo. Traição e migração agressiva desafiaram meu povo em cada uma das eras passadas. No entanto, persistimos e empurraremos de volta seus {EventRace} agora que devemos.\""

msgid "STORY_EVENT@1064_1898@BUTTON_0"
msgstr "\"Eu quebrarei o ciclo das eras. Nós {EventRace} reclamaremos este Vale das Maravilhas — e o manteremos.\""

msgid "STORY_EVENT@1064_1898@BUTTON_5"
msgstr "\"Eu escrevo minha própria lenda, e isso tem sua cabeça montada na parede da minha sala do trono. [evilact/]\""

msgid "STORY_EVENT@1064_1898@TITLE"
msgstr "A Guerra com {EventPlayer}"

msgid "STORY_EVENT@1064_1899@BODY_FOOTER"
msgstr "Antes que você possa agir ou se mover, {EventPlayer.FirstName} desaparece em um redemoinho azul de magia, escapando para o Mar Astral."

msgid "STORY_EVENT@1064_1899@BODY_HEADER"
msgstr "As forças de {EventPlayer} caíram no campo de batalha ou se dispersaram na floresta. {EventPlayer.FirstName} <<r:EventPlayer>> está sozinho."

msgid "STORY_EVENT@1064_1899@BODY_LORE"
msgstr "\"Fique atrás, {PlayerLeader}, ou mergulharei sua alma no Vazio Astral!\" <<Cge:Aparência^n,EventPlayer.FirstName>> mudou. <<Cp:EventPlayer>> parece pálido e feroz, ódio sombrio ardendo em <<o:EventPlayer>> olhos. Isso faz você lembrar os mitos de Elfos Sombrios caçando os desavisados nos tempos antes da antiga Comunidade surgir."

msgid "STORY_EVENT@1064_1899@BUTTON_0"
msgstr "\"Fuja com vergonha, {EventPlayer}. A glória desta vitória [influence/] será minha, independentemente.\""

msgid "STORY_EVENT@1064_1899@TITLE"
msgstr "Vencendo {EventPlayer}"

msgid "STORY_EVENT@1064_1900@BODY_FOOTER"
msgstr "{AllyPlayer.FirstName} se vira para você: \"O Vale das Maravilhas é seu para proteger agora, {PlayerLeader}!\" Então ela desaparece em um redemoinho de magia, escapando para o Mar Astral."

msgid "STORY_EVENT@1064_1900@BODY_FOOTER@SUNDREN_NOT_BEFR"
msgstr "Antes que {EventPlayer.FirstName} possa agir ou se mover, {AllyPlayer.FirstName} desaparece em um redemoinho azul de magia, escapando para o Mar Astral."

msgid "STORY_EVENT@1064_1900@BODY_HEADER"
msgstr "<<Co:AllyPlayer>> As forças {AllyRace} caíram ou se dispersaram e {AllyPlayer} está sozinho contra a maré de {EventPlayer}."

msgid "STORY_EVENT@1064_1900@BODY_LORE"
msgstr "\"Fique atrás, {EventPlayer.FirstName}, ou eu mergulharei sua alma no Vazio Astral!\" <<Cge:Appearance^n,AllyPlayer.FirstName>> mudou. <<Cp:AllyPlayer>> parece pálido e feroz, com um ódio sombrio ardendo em <<o:AllyPlayer>> olhos. Isso faz você lembrar dos mitos dos Elfos Sombrios caçando os desavisados nos tempos antes da antiga Comunidade existir."

msgid "STORY_EVENT@1064_1900@BUTTON_0"
msgstr "\"Meu povo terá sucesso [unitprod/], onde os {AllyRace} falharam.\""

msgid "STORY_EVENT@1064_1900@BUTTON_5"
msgstr "\"Todos saúdam {PlayerLeader} [influence/], a última esperança de Athla.\""

msgid "STORY_EVENT@1064_1900@TITLE"
msgstr "A Queda de {AllyPlayer}"

msgid "STORY_EVENT@1064_1967@BODY_FOOTER"
msgstr "\"Você não viajará para lugar nenhum, velho. \" {AllyPlayer.FirstName} avança, conjurando uma prisão de sombras na qual {EventPlayer.FirstName} é forçado a entrar. \"Apenas um tolo ignoraria os segredos que permanecem em sua mente ancestral.\""

msgid "STORY_EVENT@1064_1967@BODY_HEADER"
msgstr "Mesmo em <<o:EventPlayer>> hora mais sombria, {EventPlayer.FirstName} permanece firme, uma montanha em meio a uma tempestade furiosa."

msgid "STORY_EVENT@1064_1967@BODY_LORE"
msgstr "\"Eu falhei,\" <<p:EventPlayer>> diz, <<o:EventPlayer>> olhos olhando além dos {GLOBAL.ShadraiFactionLoreConcept.Hyperlink} em direção ao {GLOBAL.AstralVoidLoreConcept.Hyperlink}. \"Eu anseio... por Emnora. Ainda assim, não pode ser. Talvez seja hora da última jornada de {EventPlayer}. Os {GLOBAL.ArchonsLoreConcept.Hyperlink} saberão.\""

msgid "STORY_EVENT@1064_1967@BUTTON_0"
msgstr "\"A glória [influence/] de derrotar o primeiro Godir é nossa!\""

msgid "STORY_EVENT@1064_1967@TITLE"
msgstr "A Queda de {EventPlayer}"

msgid "STORY_EVENT@1064_1971@BODY_FOOTER"
msgstr "\"A luta acabou,\" {AllyPlayer} responde com autoridade. \"Nós não lhe devemos nenhuma prova da nossa força pessoal.\""

msgid "STORY_EVENT@1064_1971@BODY_HEADER"
msgstr "Com <<o:EventPlayer>> exércitos derrotados no campo de batalha, {EventPlayer.FirstName} está sendo acorado pelo Godir {GLOBAL.ShadraiFactionLoreConcept.Hyperlink}."

msgid "STORY_EVENT@1064_1971@BODY_LORE"
msgstr "\"Venha! Lute comigo, se ousar!\" <<g:roar^n,EventPlayer.FirstName>> sacode a terra debaixo enquanto <<p:EventPlayer>> levanta <<o:EventPlayer>> {EventItem} para desafiar <<o:EventPlayer>> inimigos para um combate direto. \"Se eu morrer, meu espírito se juntará a Cantarra e reforçará sua força antes que a escuridão caia.\""

msgid "STORY_EVENT@1064_1971@BUTTON_0"
msgstr "Selar {EventPlayer} em uma gaiola de supressão mágica."

msgid "STORY_EVENT@1064_1971@TITLE"
msgstr "A Queda de {EventPlayer}"

msgid "STORY_EVENT@1064_1974@BODY_FOOTER"
msgstr "Qual magia dos seus aliados Shad'rai você escolhe para quebrar a oposição restante em {GLOBAL.GrexolisLoreConcept.Hyperlink}?"

msgid "STORY_EVENT@1064_1974@BODY_HEADER"
msgstr "Uma conquista momentosa pede por uma magia momentosa para seguir."

msgid "STORY_EVENT@1064_1974@BODY_LORE"
msgstr "Fortalecidos por sua vitória e o mana armazenado na Torre do Feiticeiro do inimigo caído, os {GLOBAL.ShadraiFactionLoreConcept.Hyperlink} estão prontos para realizar outro ritual."

msgid "STORY_EVENT@1064_1974@BUTTON_0"
msgstr "Realizar <<gu:ritual of the pyre^N,EventPlayer.FirstName>>."

msgid "STORY_EVENT@1064_1974@BUTTON_3"
msgstr "Realizar <<gu:ritual of the drowned^N,Nimue.FirstName>>."

msgid "STORY_EVENT@1064_1974@BUTTON_4"
msgstr "Realizar <<gu:ritual of shattered earth^N,Ydgaard.FirstName>>."

msgid "STORY_EVENT@1064_1974@BUTTON_5"
msgstr "Realizar <<gu:ritual of the mirror curse^N,Arachna.FirstName>>."

msgid "STORY_EVENT@1064_1974@TITLE"
msgstr "Magia Shad'rai"

msgid "STORY_EVENT@1064_1976@BODY_FOOTER"
msgstr "{EventPlayer} recuou com ferimentos graves para a Torre do Feiticeiro de {AllyPlayer}. Lá <<p:EventPlayer>> descansará até que força suficiente de <<o:EventPlayer>> seja restaurada."

msgid "STORY_EVENT@1064_1976@BODY_HEADER"
msgstr "A batalha por {GLOBAL.GrexolisLoreConcept.Hyperlink} continua implacável. Os exércitos em conflito do {GLOBAL.CovenantFactionLoreConcept.Hyperlink}, {GLOBAL.ShadraiFactionLoreConcept.Hyperlink} e o guardião de Grexolis podem derrubar até mesmo um {GLOBAL.GodirLoreConcept.Hyperlink}."

msgid "STORY_EVENT@1064_1976@BODY_LORE"
msgstr "\"Impossível!\" <<Cg:cry of dismay^n,EventPlayer.FirstName>> rasga o ar de Grexolis enquanto <<p:EventPlayer>> é dominado pela hoste do inimigo. \"Eu sou o {EventPlayer.Title}. Meu poder não se curva diante de ninguém, nem cairei... hoje.\""

msgid "STORY_EVENT@1064_1976@BUTTON_0"
msgstr "Onde <<p:EventPlayer>> perdeu, minhas tropas irão reclamar a vitória! Isso ainda não acabou."

msgid "STORY_EVENT@1064_1976@TITLE"
msgstr "A Retirada de {EventPlayer}"

msgid "STORY_EVENT@1064_1987@BODY_FOOTER"
msgstr "\"Pare! Não se mova ainda!\" {EventPlayer.FirstName}, que, como o Godir do Pacto, foi reduzido a um espectador impotente, levanta <<o:EventPlayer>> voz."

msgid "STORY_EVENT@1064_1987@BODY_HEADER"
msgstr "{EventPlayer}, o {GLOBAL.CovenantFactionLoreConcept.Hyperlink} - nenhum deles poderia resistir ao poder dos Shad'rai. Com {GLOBAL.GrexolisLoreConcept.Hyperlink} seguro, {AllyPlayer} chama você para eliminar o Gildercoil."

msgid "STORY_EVENT@1064_1987@BODY_LORE"
msgstr "\"É hora, {PlayerLeader.FirstName}. Use o poder do Gildercoil! Faça o que era proibido!\" {AllyPlayer.FirstName} o tenta com um sorriso luxuoso, como se <<p:AllyPlayer>> precisasse lhe dar uma desculpa para um pecado de escala cósmica. Evidentemente, até os {GLOBAL.ShadraiFactionLoreConcept.Hyperlink} estão ansiosos pelo momento que está por vir."

msgid "STORY_EVENT@1064_1987@BUTTON_0"
msgstr "Ouça <<g:words^n,EventPlayer.FirstName>>."

msgid "STORY_EVENT@1064_1987@TITLE"
msgstr "O Cofre Mundial: Consequências"

msgid "STORY_EVENT@1064_1988@BODY_FOOTER"
msgstr "{AllyPlayer.FirstName} avança, fazendo um gesto como se <<p:AllyPlayer>> estivesse apresentando <<r:AllyPlayer>>. \"Você está certo, {EventPlayer.FirstName}. É hora de {PlayerLeader} aprender a verdade...\""

msgid "STORY_EVENT@1064_1988@BODY_HEADER"
msgstr "\"Você acha que conhece bem as consequências de abrir o Cofre Mundial, {PlayerLeader},\" {EventPlayer.FirstName} começa, \"mas olhe ao seu redor em cujas palavras você confiou nesta jornada para o esquecimento.\""

msgid "STORY_EVENT@1064_1988@BODY_LORE"
msgstr "{EventPlayer.FirstName} aponta a mão para todos os {GLOBAL.ShadraiFactionLoreConcept.Hyperlink} presentes: \"Um autoproclamado faraó-deus, queimando quem questiona seu ego. Uma sereia obsessiva, afogando seus próprios filhos. Um acumulador de riqueza que vendeu sua cabeça e coração por poder. E então este aqui...\" <<Cg:eyes^p,EventPlayer.FirstName>> repousam em {AllyPlayer.FirstName}. \"Você nem sabe <<o:AllyPlayer>> verdadeiro nome.\""

msgid "STORY_EVENT@1064_1988@BUTTON_0"
msgstr "Espere {AllyPlayer.FirstName} terminar."

msgid "STORY_EVENT@1064_1988@TITLE"
msgstr "<<g:Intervention^n,EventPlayer.FirstName>>"

msgid "STORY_EVENT@1064_1989@BODY_FOOTER"
msgstr "{EventHero.FirstName} vira-se para você. \"Sinto muito, mas isso é muito importante.\" Sem aviso, uma mão convocada arrebata o Gildercoil de você, colocando-o em <<g:hands^p,EventHero.FirstName>>."

msgid "STORY_EVENT@1064_1989@BODY_HEADER"
msgstr "\"{EventHero.FirstName}!\" O nome é sussurrado pelos {GLOBAL.GodirLoreConcept.Hyperlink} presentes enquanto {AllyPlayer.FirstName} muda magicamente sua aparência, revelando <<r:AllyPlayer>> ser {EventHero}."

msgid "STORY_EVENT@1064_1989@BODY_LORE"
msgstr "\"Como pode ser testemunhado aqui,\" <<p:AllyPlayer>> diz lentamente, \"as coisas muitas vezes não são como parecem à primeira vista. Liberar o que foi visto como prejudicial em eras passadas pode ser a solução para problemas atuais. Os {GLOBAL.ArchonsLoreConcept.Hyperlink} estão perdendo sua guerra, {EventPlayer.FirstName}. Lentamente, mas constantemente, as sombras estão se arrastando para frente, a menos que... alguns convidados inesperados apareçam.\" Agora é {EventPlayer.FirstName} cuja voz revela consternação: \"Os Endailon! Você deve estar além do desesperado.\""

msgid "STORY_EVENT@1064_1989@BUTTON_0"
msgstr "Assista {EventHero.FirstName} abrir o Cofre Mundial."

msgid "STORY_EVENT@1064_1989@TITLE"
msgstr "A revelação de {EventHero.FirstName}"

msgid "STORY_EVENT@1064_1990@BODY_FOOTER"
msgstr "{EventPlayer.FirstName} permanece em silêncio. Parece que <<p:EventPlayer>> não considera <<g:words^p,AllyPlayer.FirstName>> dignas de qualquer reação."

msgid "STORY_EVENT@1064_1990@BODY_HEADER"
msgstr "\"Não precisa ser assim, {EventPlayer}.\" {AllyPlayer} fala com uma voz terna, olhando <<P:EventPlayer>> diretamente nos olhos."

msgid "STORY_EVENT@1064_1990@BODY_LORE"
msgstr "\"Temos muito em comum. Por que lutar entre nós {GLOBAL.GodirLoreConcept.Hyperlink} quando o verdadeiro inimigo está criando novas trevas a cada dia? Não seria sábio deixar este posto e juntar-se aos {GLOBAL.ArchonsLoreConcept.Hyperlink} em sua luta, mantendo a paz com os {GLOBAL.ShadraiFactionLoreConcept.Hyperlink}, que poderiam ser aliados valiosos no futuro?\""

msgid "STORY_EVENT@1064_1990@BUTTON_0"
msgstr "<<Cp:EventPlayer>> teve <<o:EventPlayer>> chance de render-se pacificamente."

msgid "STORY_EVENT@1064_1990@TITLE"
msgstr "Tentando o Intemptável"

msgid "STORY_EVENT@1064_276@BODY_FOOTER"
msgstr "Como você protegerá os cidadãos de {EventCity.Name} do apetite dos Mortos-Vivos errantes?"

msgid "STORY_EVENT@1064_276@BODY_HEADER"
msgstr "Um dos guardas da sua cidade de {EventCity.Name} tem notícias perturbadoras para compartilhar."

msgid "STORY_EVENT@1064_276@BODY_LORE"
msgstr "\"Essas criaturas são mantidas vivas apenas por magia maligna!\" o chefe do guarda explica. \"Mortos-Vivos inquietos, ressuscitados de um {EventSpawner.Name}! Primeiro, eles horrorizaram nossos agricultores locais, que encontraram seu gado com os cérebros sugados ao amanhecer. Agora, parece que os Mortos-Vivos têm fome de mais.\""

msgid "STORY_EVENT@1064_276@BUTTON_0"
msgstr "Repila os Mortos-Vivos [mana/] com um feitiço de proteção."

msgid "STORY_EVENT@1064_276@BUTTON_1"
msgstr "Canalize mana [mana/] suficiente para o {EventSpawner.Name} para prender os Mortos-Vivos lá."

msgid "STORY_EVENT@1064_276@BUTTON_2"
msgstr "\"Deixe-me selar a terra no {EventSpawner.Name}. Isso os fará descansar.\""

msgid "STORY_EVENT@1064_276@BUTTON_3"
msgstr "\"Esses patéticos devoradores de cérebros não são páreo para nossas defesas!\""

msgid "STORY_EVENT@1064_276@BUTTON_4"
msgstr "\"Se é cérebros que eles querem, temos alguns estudiosos [knowledge/] para sacrificar... [evilact/]\""

msgid "STORY_EVENT@1064_276@BUTTON_5"
msgstr "\"Pela vontade da Natureza, farei esses cadáveres apodrecerem. Agora!\""

msgid "STORY_EVENT@1064_276@TITLE"
msgstr "Devoradores de Cérebros"

msgid "STORY_EVENT@1064_293@BODY_FOOTER"
msgstr "Como você responde à terrível ameaça do {EventStackLeader.Name} que chamam de \"Horror de {GLOBAL.UrrathLoreConcept.Hyperlink}\" e seu {EventSpawner.Name}?"

msgid "STORY_EVENT@1064_293@BODY_HEADER"
msgstr "Rumores de um grupo ocultista perto de sua cidade {EventCity.Name} há muito espalham medo entre sua população. Agora, esse medo ganha uma nova forma."

msgid "STORY_EVENT@1064_293@BODY_LORE"
msgstr "\"Entregue suas crianças a nós!\" a voz histérica de um cultista pode ser ouvida além dos portões da cidade. \"Ou invocaremos o Horror de {GLOBAL.UrrathLoreConcept.Hyperlink} para arrastar suas almas para o {GLOBAL.AstralSeaLoreConcept.Hyperlink}!\" Eles gesticulam freneticamente para o {EventStackLeader.Name} em seu domínio."

msgid "STORY_EVENT@1064_293@BUTTON_0"
msgstr "Reúna uma multidão [unitprod/] para afastar os cultistas."

msgid "STORY_EVENT@1064_293@BUTTON_1"
msgstr "Reúna toda a cidade [unitprod/] para erradicar o próprio {EventSpawner.Name}."

msgid "STORY_EVENT@1064_293@BUTTON_2"
msgstr "Ignore-os. Esse \"Horror de Urrath\" parece patético."

msgid "STORY_EVENT@1064_293@BUTTON_3"
msgstr "Entregue realmente as crianças [population/]. Isso encerrará o assunto. [evilact/]"

msgid "STORY_EVENT@1064_293@BUTTON_4"
msgstr "Invoque você mesmo este {EventStackLeader.Name}."

msgid "STORY_EVENT@1064_293@TITLE"
msgstr "Extorsão Sombria"

msgid "STORY_EVENT@1064_368@BODY_FOOTER"
msgstr "Você vai apaziguar o {EventStackLeader.Name} com um sacrifício - ou por um fim a <<g:tradition^n,EventCity>>?"

msgid "STORY_EVENT@1064_368@BODY_HEADER"
msgstr "Seu povo de {EventCity.Name} compartilha um vínculo especial com o {EventSpawner.Name}."

msgid "STORY_EVENT@1064_368@BODY_LORE"
msgstr "Eles adoram o {EventStackLeader.Name} e seus parentes emplumados, acreditando que um grande pássaro sustenta o sol em suas asas. No entanto, os pássaros em si geralmente só se preocupam com as ofertas sacrificiais. Eles se tornaram mais exigentes com o tempo e agora ameaçam atacar {EventCity.Name}."

msgid "STORY_EVENT@1064_368@BUTTON_0"
msgstr "\"Eu respeito suas crenças [happiness/]. Deixe o gado [food/] de {EventCity.Name} nutrir o {EventStackLeader.Name}.\""

msgid "STORY_EVENT@1064_368@BUTTON_1"
msgstr "Suborne [gold/] seus xamãs para acabar com essa loucura e afastar todos os pássaros do {EventSpawner.Name}."

msgid "STORY_EVENT@1064_368@BUTTON_2"
msgstr "Os pássaros não são páreo para <<g:defenses^p,EventCity>>."

msgid "STORY_EVENT@1064_368@BUTTON_3"
msgstr "\"Suas crenças primitivas ofendem os deuses. Purificar [mana/] os pássaros e seu {EventSpawner.Name} é o caminho certo.\""

msgid "STORY_EVENT@1064_368@BUTTON_4"
msgstr "Cultive seu vínculo especial para domar o {EventStackLeader.Name}."

msgid "STORY_EVENT@1064_368@TITLE"
msgstr "Pássaros de Prece"

msgid "STORY_EVENT@1064_407@BODY_FOOTER"
msgstr "\"Você vai me ajudar, meu {PlayerLeader.Title}, a encontrar o {EventMaterial} necessário para reforjar a arma dos meus antepassados?\""

msgid "STORY_EVENT@1064_407@BODY_HEADER"
msgstr "{EventHero} se aproxima de você com determinação solene."

msgid "STORY_EVENT@1064_407@BODY_LORE"
msgstr "\"Estes são os fragmentos do {EventItem},\" <<p:EventHero>> diz, mostrando-lhe um maço de fragmentos de armas cuidadosamente embrulhados. \"Há muito tempo, ele inspirava medo nos inimigos dos {EventRace}. Seus guardiões há muito procuram uma maneira de imbuí-lo com nova vida, mas nunca encontramos o mítico {EventMaterial} do qual é feito.\""

msgid "STORY_EVENT@1064_407@BUTTON_0"
msgstr "\"Eu vou ajudá-lo. Um herói é tão bom quanto <<o:EventHero>> arma!\""

msgid "STORY_EVENT@1064_407@BUTTON_2"
msgstr "\"Não há tempo para buscas ociosas como esta...\""

msgid "STORY_EVENT@1064_407@TITLE"
msgstr "{EventItem} Reforjado"

msgid "STORY_EVENT@1064_408@BODY_FOOTER"
msgstr "\"Estou em sua dívida, meu {PlayerLeader.Title}\" <<p:EventHero>> diz. \"Qualquer caminho que você traçar para mim, eu seguirei.\""

msgid "STORY_EVENT@1064_408@BODY_HEADER"
msgstr "Com o {EventMaterial}, {EventHero} se retira para <<o:EventHero>> forja. Ao anoitecer, <<p:EventHero>> retorna a você, o {EventItem} em <<o:EventHero>> mãos."

msgid "STORY_EVENT@1064_408@BODY_LORE"
msgstr "\"Finalmente! Nossa lendária arma retornará à batalha, e nós, {EventRace}, ficaremos triunfantes!\" {EventHero} grita em triunfo, levantando o {EventItem} em direção ao céu. Depois de um tempo, <<p:EventHero>> relaxa <<o:EventHero>> postura e se vira para você."

msgid "STORY_EVENT@1064_408@BUTTON_0"
msgstr "\"Aperfeiçoe suas habilidades de forja [unitprod/]! Em {EventCity} há muitos homens que precisam de armas.\""

msgid "STORY_EVENT@1064_408@BUTTON_3"
msgstr "\"Carregue o {EventItem} para a glória [happiness/] dos {EventRace}!\""

msgid "STORY_EVENT@1064_408@BUTTON_4"
msgstr "\"Artefatos mágicos são dignos de estudo aprofundado. [knowledge/] Pesquise e aprenda!\""

msgid "STORY_EVENT@1064_408@BUTTON_5"
msgstr "\"Treine [xp/], {EventHero}. Torne-se digno do {EventItem}.\""

msgid "STORY_EVENT@1064_408@TITLE"
msgstr "{EventItem} Reforjado: Consequências"

msgid "STORY_EVENT@1064_492@BODY_FOOTER"
msgstr "Você promete construir mais <<m:{GLOBAL.FarmConcept.Hyperlink}>> para saciar o apetite \"saudável\" dos {EventRace.Name}?"

msgid "STORY_EVENT@1064_492@BODY_HEADER"
msgstr "O Conselho {EventRace.Name} envia seu principal deputado para encontrá-lo com um pedido."

msgid "STORY_EVENT@1064_492@BODY_LORE"
msgstr "\"Por muito tempo nós, {EventRace.Name}, sofremos com a falta,\" explica o deputado, um <<EventUnit{homem/mulher}>> bem alimentado. \"Está claro agora, meu {PlayerLeader.TitleName}, que suas cidades precisam de mais terras agrícolas, para que possamos desfrutar de um terceiro café da manhã como qualquer povo civilizado deveria.\""

msgid "STORY_EVENT@1064_492@BUTTON_0"
msgstr "\"Um bom homem deve comer, isso é certo!\""

msgid "STORY_EVENT@1064_492@BUTTON_1"
msgstr "\"Um segundo café da manhã terá que ser suficiente, por enquanto.\""

msgid "STORY_EVENT@1064_492@BUTTON_2"
msgstr "\"Esta autoindulgência glutona tornará vocês, {EventRace.Name}, muito moles [unitprod/] para a guerra!\""

msgid "STORY_EVENT@1064_492@TITLE"
msgstr "Uma Refeição Fina"

msgid "STORY_EVENT@1064_493@BODY_FOOTER"
msgstr "\"O povo quer agradecer com um presente. O que o Conselho deve proclamar?\""

msgid "STORY_EVENT@1064_493@BODY_HEADER"
msgstr "A primeira semeadura da temporada passou, e um deputado muito satisfeito do Conselho {EventRace.Name} retornou a você."

msgid "STORY_EVENT@1064_493@BODY_LORE"
msgstr "\"Oh, dia alegre!\" o deputado começa seu elogio. \"Não precisamos mais, nós {EventRace.Name}, ter medo de passar fome quando desejamos nosso terceiro café da manhã! Seu nome está na boca de todos, meu {PlayerLeader.TitleName}. Sempre lembre-se: {EventRace.Name} satisfeitos são {EventRace.Name} felizes.\""

msgid "STORY_EVENT@1064_493@BUTTON_0"
msgstr "\"Que eles nutram as colheitas [food/] que tão ansiosamente pediram.\""

msgid "STORY_EVENT@1064_493@BUTTON_1"
msgstr "\"Que eles não esqueçam de trazer ofertas para os espíritos [mana/] da terra.\""

msgid "STORY_EVENT@1064_493@BUTTON_3"
msgstr "\"Que seus primogênitos servirão ao exército dos {EventRace.Name} [unitprod/] no serviço militar.\""

msgid "STORY_EVENT@1064_493@TITLE"
msgstr "Uma Refeição Fina: Consequências"

msgid "STORY_EVENT@1064_539@BODY_FOOTER"
msgstr "Você está em guerra com {EventHouse.Name}."

msgid "STORY_EVENT@1064_539@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} cumprimenta você com hostilidade."

msgid "STORY_EVENT@1064_539@BODY_LORE"
msgstr "\" {EventHouse.Name} lutará por nossa liberdade e se oporá a qualquer um que ameace nossa {GLOBAL.IndependentCityConcept.Hyperlink}, mesmo quando liderados por um {PlayerLeader.Title} como você. Não pense que nossa herança racial compartilhada abalará nossas convicções.\""

msgid "STORY_EVENT@1064_539@BUTTON_0"
msgstr "Inspecione os insolentes {EventHouse.Name}."

msgid "STORY_EVENT@1064_539@BUTTON_2"
msgstr "\"Que assim seja!\""

msgid "STORY_EVENT@1064_539@TITLE"
msgstr "Encontrando {EventHouse.Name} Hostil"

msgid "STORY_EVENT@1064_540@BODY_FOOTER"
msgstr "Você está em guerra com {EventHouse.Name}."

msgid "STORY_EVENT@1064_540@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} cumprimenta você com hostilidade."

msgid "STORY_EVENT@1064_540@BODY_LORE"
msgstr "\"Nós {EventHouseRace.Name} de {EventHouse.Name} lutaremos por nossa liberdade e nos oporemos a qualquer um que ameace nossa {GLOBAL.IndependentCityConcept.Hyperlink}, mesmo quando liderados por um {PlayerLeader.Title} como você. O sangue de invasores, ladrões e espiões nutrirá os campos.\""

msgid "STORY_EVENT@1064_540@BUTTON_0"
msgstr "Inspecione os insolentes {EventHouse.Name}."

msgid "STORY_EVENT@1064_540@BUTTON_2"
msgstr "\"Que assim seja!\""

msgid "STORY_EVENT@1064_540@TITLE"
msgstr "Encontrando {EventHouse.Name} Hostil"

msgid "STORY_EVENT@1064_594@BODY_FOOTER"
msgstr "{EventHero.FirstName} faz um gesto elaborado, após o qual um mapa mostrando as principais fortalezas da Caldeira Carmesim aparece. \"É aqui que você deve procurar todos os Godir suspeitos.\""

msgid "STORY_EVENT@1064_594@BODY_HEADER"
msgstr "\"O Gildercoil não está simplesmente escondido em algum lugar da Caldeira Carmesim,\" {EventHero.FirstName} começa a explicar. \"Ele é guardado de perto por seu atual dono.\""

msgid "STORY_EVENT@1064_594@BODY_LORE"
msgstr "\"O desafio é descobrir por quem. Todos os atuais {GLOBAL.GodirLoreConcept.Hyperlink} são inerentemente suspeitos e, portanto, devem ser procurados. Apenas lembre-se, eles são todos insanos e só dirão a verdade quando forem forçados. Uma vez que você tenha encontrado o primeiro deles, falaremos novamente.\""

msgid "STORY_EVENT@1064_594@BUTTON_0"
msgstr "Pegue o mapa para começar sua caçada."

msgid "STORY_EVENT@1064_594@BUTTON_1"
msgstr "O mapa é tão primitivo... Canalize seu foco arcano [mana/] para melhorá-lo."

msgid "STORY_EVENT@1064_594@BUTTON_2"
msgstr "Queime o mapa. Seu povo pode sentir a batalha [unitprod/] de longe!"

msgid "STORY_EVENT@1064_594@TITLE"
msgstr "Vestígios do Gildercoil"

msgid "STORY_EVENT@1064_595@BODY_FOOTER"
msgstr "Como {PlayerLeader.Title}, você pode reclamar qualquer um dos tesouros que seus batedores trouxeram de volta de suas jornadas."

msgid "STORY_EVENT@1064_595@BODY_HEADER"
msgstr "Enquanto você pondera suas estratégias para esta guerra de muitas frentes, seus batedores estão retornando agora das diferentes regiões da Caldeira Carmesim."

msgid "STORY_EVENT@1064_595@BODY_LORE"
msgstr "Eles falam de encontros demoníacos, monstros viciosos e bandos de guerra perambulando pela terra, testamentos loucos dos Governantes há muito caídos que vieram à Caldeira Carmesim em busca do poder do Gildercoil."

msgid "STORY_EVENT@1064_595@BUTTON_0"
msgstr "Reivindique o {EventItem} [item/] que eles desenterraram."

msgid "STORY_EVENT@1064_595@BUTTON_1"
msgstr "Pegue a moeda [gold/] que eles saquearam nas muitas estradas que percorreram."

msgid "STORY_EVENT@1064_595@BUTTON_2"
msgstr "Abasteça o arsenal de {EventCity} [unitprod/] com armas resgatadas dos campos de batalha da Caldera Carmim."

msgid "STORY_EVENT@1064_595@TITLE"
msgstr "Vestígios do Gildercoil: Consequências"

msgid "STORY_EVENT@1064_64@BODY_FOOTER"
msgstr "Você vai resgatar o mago e banir as criaturas mágicas em seu local antes que seja tarde demais?"

msgid "STORY_EVENT@1064_64@BODY_HEADER"
msgstr "Ao se conectar com o cosmos, você percebe uma perturbação no {GLOBAL.AstralFlowsLoreConcept.Hyperlink}."

msgid "STORY_EVENT@1064_64@BODY_LORE"
msgstr "Um mago excessivamente curioso mexeu com as correntes de mana. <<Cp:EventUnit>> acidentalmente abriu um portal, atraindo criaturas mágicas do {GLOBAL.AstralSeaLoreConcept.Hyperlink}. Agora, <<p:EventUnit>> está se escondendo atrás de uma barreira enquanto os monstros convocados ameaçam toda a área."

msgid "STORY_EVENT@1064_64@BUTTON_0"
msgstr "\"Claro que vou ajudar um arcano em necessidade.\""

msgid "STORY_EVENT@1064_64@BUTTON_1"
msgstr "\"Os magos são engenhosos. <<Cp:EventUnit>> certamente ficará bem...\""

msgid "STORY_EVENT@1064_64@BUTTON_2"
msgstr "\"Essas criaturas estão perdidas. Elas precisam ser nutridas [mana/], não mortas!\" [astralcrisis/]"

msgid "STORY_EVENT@1064_64@TITLE"
msgstr "Problemas Planares"

msgid "STORY_EVENT@1064_65@BODY_FOOTER"
msgstr "Em que direção você guia o {EventUnit.Name} do {EventRace.Name} antes que <<o:EventUnit>> experimentos mágicos possam causar mais danos?"

msgid "STORY_EVENT@1064_65@BODY_HEADER"
msgstr "Com os monstros convocados banidos novamente, o {EventUnit.Name} derruba <<o:EventUnit>> barreira mágica."

msgid "STORY_EVENT@1064_65@BODY_LORE"
msgstr "\"Obrigado!\" <<p:EventUnit>> avança, agitando <<o:EventUnit>> varinha entusiasticamente. \"Minha pesquisa de campo nunca rendeu resultados mais valiosos! Tenho outra hipótese interessante que precisa de confirmação. Não acho que você se importaria, se eu...\""

msgid "STORY_EVENT@1064_65@BUTTON_0"
msgstr "A manipulação destrutiva de <<Co:EventUnit>> torna <<P:EventUnit>> uma adição adequada [unit/] ao seu exército."

msgid "STORY_EVENT@1064_65@BUTTON_1"
msgstr "Convide o mago a compartilhar <<o:EventUnit>> descobertas [knowledge/] em sua corte."

msgid "STORY_EVENT@1064_65@BUTTON_3"
msgstr "Deixe <<P:EventUnit>> continuar. Poderes arcanos [mana/] precisam de total liberdade da mente para se desenvolver."

msgid "STORY_EVENT@1064_65@TITLE"
msgstr "Problemas Planares: Consequências"

msgid "STORY_EVENT@1064_71@BODY_FOOTER"
msgstr "Você vai proteger os mineiros em {EventStructure} dos ataques do {EventStackLeader.Name} antes que seja tarde demais?"

msgid "STORY_EVENT@1064_71@BODY_HEADER"
msgstr "Conectando-se com a terra e suas riquezas, você testemunha uma tragédia subterrânea."

msgid "STORY_EVENT@1064_71@BODY_LORE"
msgstr "O {EventRace.Name} minerou longe e avidamente demais nas profundezas da terra. Sua perfuração perturbou um {EventStackLeader.Name}, junto com uma horda de predadores subterrâneos. Agora, essas ameaças estão perseguindo o {EventStructure.Name}, matando os trabalhadores do {EventRace.Name} um por um."

msgid "STORY_EVENT@1064_71@BUTTON_0"
msgstr "\"Seu tesouro - e os mineiros - serão resgatados!\""

msgid "STORY_EVENT@1064_71@BUTTON_1"
msgstr "\"Seu destino não nos interessa.\""

msgid "STORY_EVENT@1064_71@BUTTON_2"
msgstr "\"Eles foram pecadores por serem tão gananciosos. [materiumcrisis/] Devemos aprender [knowledge/] com seu castigo.\""

msgid "STORY_EVENT@1064_71@TITLE"
msgstr "Cavando Fundos Demais"

msgid "STORY_EVENT@1064_72@BODY_FOOTER"
msgstr "O mestre prospector quer agradecer com um presente do baú da guilda."

msgid "STORY_EVENT@1064_72@BODY_HEADER"
msgstr "Agora que os monstros em {EventStructure.Name} foram mortos, os mineiros sobreviventes saem do esconderijo."

msgid "STORY_EVENT@1064_72@BODY_LORE"
msgstr "\"Devemos nossas vidas a você, estrangeiro,\" começa a dizer o mestre prospector. \"Dê uma olhada em nosso tesouro. Escolha qualquer item e ele será seu. Deixaremos este lugar perigoso e voltaremos para nossas casas.\""

msgid "STORY_EVENT@1064_72@BUTTON_0"
msgstr "Pegue uma bolsa considerável de moedas de [gold/]."

msgid "STORY_EVENT@1064_72@BUTTON_1"
msgstr "Pegue um acessório joalhado [item/], o {EventItem.Name}."

msgid "STORY_EVENT@1064_72@BUTTON_3"
msgstr "Peça aos mineiros para visitar suas guildas de artesãos [structureprod/] em {EventCity.Name} em vez disso."

msgid "STORY_EVENT@1064_72@TITLE"
msgstr "Cavando Fundamente: Consequências"

msgid "STORY_EVENT@1064_785@BODY_FOOTER"
msgstr "<<Cp:EventUnit>> está pedindo a colheita deste ano para nutrir as criaturas da natureza. Você fará esse sacrifício?"

msgid "STORY_EVENT@1064_785@BODY_HEADER"
msgstr "Das profundezas emaranhadas da natureza perto de sua cidade {EventCity.Name}, a canção cativante de um {EventUnit.Name} o encanta."

msgid "STORY_EVENT@1064_785@BODY_LORE"
msgstr "\"Venha, abençoe a terra com maçãs![br/]Deixe a colheita descansar![br/]Os despojos para todos aproveitarem[br/]alimentam urso, pássaro, fada e ninho!\""

msgid "STORY_EVENT@1064_785@BUTTON_0"
msgstr "Deixe {EventCity.Name} oferecer sua colheita [food/] à terra. [natureboon/]"

msgid "STORY_EVENT@1064_785@BUTTON_1"
msgstr "Use parte da colheita [food/] para ganhar o favor do {EventUnit.Name}. [unit/]"

msgid "STORY_EVENT@1064_785@BUTTON_2"
msgstr "Ignore a <<g:canção^n,EventUnit>>. [naturecrisis/]"

msgid "STORY_EVENT@1064_785@TITLE"
msgstr "Rito do Outono"

msgid "STORY_EVENT@1064_856@BODY_FOOTER"
msgstr "Para preparar uma poção de amor forte o suficiente para encantar {EventPlayer}, você deve obter {EventMaterial1} e {EventMaterial2}."

msgid "STORY_EVENT@1064_856@BODY_HEADER"
msgstr "\"Aquele cujo coração é frio ficará indefeso quando for subitamente inflamado.\" {EventHero} mostra um frasco vazio."

msgid "STORY_EVENT@1064_856@BODY_LORE"
msgstr "\"A fraqueza de {EventPlayer} é <<o:EventPlayer>> próprio jogo perfidioso, no qual <<p:EventPlayer>> se alimenta do amor de <<o:EventPlayer>> vítimas para prazer pessoal. Vire o jogo e <<p:EventPlayer>> será seu.\""

msgid "STORY_EVENT@1064_856@BUTTON_0"
msgstr "{EventPlayer} obedecerá aos seus desejos em pouco tempo."

msgid "STORY_EVENT@1064_856@TITLE"
msgstr "Ame e Deixe Morrer"

msgid "STORY_EVENT@1064_857@BODY_FOOTER"
msgstr "Está claro que {EventPlayer} está desesperadamente apaixonado por você. O que você fará com esse tolo?"

msgid "STORY_EVENT@1064_857@BODY_HEADER"
msgstr "Você prepara uma poção com os materiais que coletou. Logo depois, o resultado apresenta <<r:EventPlayer>> a você. \"Oh, {PlayerLeader}!\" {EventPlayer} lança um olhar languido."

msgid "STORY_EVENT@1064_857@BODY_LORE"
msgstr "\"Você é certamente o mais deslumbrante de todos <<m:{PlayerLeader.Title}>>. Quem poderia trair um coração que bate dentro de um peito tão sublime como o seu? Lamento não ter o Gildercoil para presentear, nem sei quem o possui. Mas servirei a você por toda a eternidade, pois não suportaria nem mesmo um indício de sua desaprovação!\""

msgid "STORY_EVENT@1064_857@BUTTON_0"
msgstr "Faça de <<P:EventPlayer>> seu bobo pessoal [unit/]."

msgid "STORY_EVENT@1064_857@BUTTON_1"
msgstr "Deixe <<P:EventPlayer>> cantar baladas sobre sua beleza e fama [influence/]."

msgid "STORY_EVENT@1064_857@BUTTON_2"
msgstr "Permita que <<P:EventPlayer>> siga seu comando lealmente como um herói [unit/]."

msgid "STORY_EVENT@1064_857@TITLE"
msgstr "Amar e Deixar Morrer: Consequências"

msgid "STORY_EVENT@1064_85@BODY_FOOTER"
msgstr "Você tentará forjar um {EventPact.Hyperlink} com {TargetHouse}?"

msgid "STORY_EVENT@1064_85@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} de {EventHouse} vem até você com um pedido de grande importância para <<P:EventHouseLord>>."

msgid "STORY_EVENT@1064_85@BODY_LORE"
msgstr "\"<<Cp:TargetHouseLord>> e eu, de {TargetHouse}, compartilhamos uma longa e duradoura amizade. <<Cp:TargetHouseLord>> uma vez me salvou de um javali durante uma caçada, somos aliados desde então. Eu confiaria minha vida a {TargetHouseLord} e acredito que {TargetHouse} seria um grande aliado para você também, {PlayerLeader.TitleName}. Eu sei que <<p:TargetHouseLord>> ficaria honrado em se juntar a você em sua grande jornada.\""

msgid "STORY_EVENT@1064_85@BUTTON_0"
msgstr "\"Quanto mais aliados, melhor. Enviarei uma proposta a {TargetHouse}.\""

msgid "STORY_EVENT@1064_85@BUTTON_1"
msgstr "\"Amizades são passageiras. A guerra [chaosboon/] é eterna.\""

msgid "STORY_EVENT@1064_85@BUTTON_2"
msgstr "\"Pare de me incomodar com suas alianças insignificantes.\""

msgid "STORY_EVENT@1064_85@TITLE"
msgstr "Duas Cidades, Unidas"

msgid "STORY_EVENT@1064_863@BODY_FOOTER"
msgstr "Qual fonte de magia você usará para atrair o {EventUnit} em direção a {EventPlayer}?"

msgid "STORY_EVENT@1064_863@BODY_HEADER"
msgstr "Enquanto o {EventUnit} chama pelo {GLOBAL.AstralSeaLoreConcept.Hyperlink}, é impulsionado por seus instintos a encontrar novas presas."

msgid "STORY_EVENT@1064_863@BODY_LORE"
msgstr "Este é o momento que você antecipou. Uma isca atraente é necessária para manipular para onde o {EventUnit} atacará em seguida."

msgid "STORY_EVENT@1064_863@BUTTON_0"
msgstr "Use um grande conglomerado de cristais de mana [mana/]."

msgid "STORY_EVENT@1064_863@BUTTON_1"
msgstr "Use sua própria energia astral [hp/]."

msgid "STORY_EVENT@1064_863@BUTTON_2"
msgstr "Use as almas [population/] da sua própria população [evilact/]."

msgid "STORY_EVENT@1064_863@TITLE"
msgstr "Atraindo o Horror"

msgid "STORY_EVENT@1064_864@BODY_FOOTER"
msgstr "\"Se você atrair um {EventUnit} do {GLOBAL.AstralSeaLoreConcept.Hyperlink} e confrontar {EventPlayer.FirstName} com ele, <<p:EventPlayer>> ficará paralisado de medo.\""

msgid "STORY_EVENT@1064_864@BODY_HEADER"
msgstr "\"Qual é o maior medo de um glutão? Que ele mesmo seja consumido.\" {EventHero} exibe um sorriso sarcástico."

msgid "STORY_EVENT@1064_864@BODY_LORE"
msgstr "\"Após o Grande Banimento em {GLOBAL.AthlaLoreConcept.Hyperlink}, {EventPlayer} foi exposto ao {GLOBAL.ShadowTrialLoreConcept.Hyperlink} por mais tempo do que a maioria dos {GLOBAL.GodirLoreConcept.Hyperlink}. <<Cp:EventPlayer>> é assombrado por esse passado, ainda teme o <<m:{EventUnit}>> predador do além.\""

msgid "STORY_EVENT@1064_864@BUTTON_0"
msgstr "\"Fazer de isca para um horror especializado em caçar Godir? Vamos esperar que isso valha a pena.\""

msgid "STORY_EVENT@1064_864@TITLE"
msgstr "Passado Atormentado"

msgid "STORY_EVENT@1064_868@BODY_FOOTER"
msgstr "\"Por favor, {PlayerLeader}, afaste os {EventRace} e me livre do trono de espinhos deles.\""

msgid "STORY_EVENT@1064_868@BODY_HEADER"
msgstr "\"Abençoado seja este dia, ó {PlayerLeader}, em que nos conhecemos, meu herói salvador!\" {EventPlayer} faz um gesto teatral, sacudindo <<o:EventPlayer>> as mãos em lágrimas."

msgid "STORY_EVENT@1064_868@BODY_LORE"
msgstr "\"Os {EventRace} me chamam de {EventPlayer.Title}, mas eu não sou. Eles me mantêm cativo e me vestem como seu Governante por delírio ou zombaria. A cada dia, devo assistir às suas maquinações viciosas e suportar a dor de suas vítimas.\""

msgid "STORY_EVENT@1064_868@BUTTON_0"
msgstr "Você pode sentir que há mais em {EventPlayer} do que aparenta."

msgid "STORY_EVENT@1064_868@TITLE"
msgstr "A Loucura de {EventPlayer}"

msgid "STORY_EVENT@1064_86@BODY_FOOTER"
msgstr "\"Você fez um grande favor tanto para {EventHouse} quanto para {TargetHouse}. O que deseja em troca?\""

msgid "STORY_EVENT@1064_86@BODY_HEADER"
msgstr "Você forjou com sucesso um {EventPact.Hyperlink} com {TargetHouse}. {EventHouseLord} está encantado."

msgid "STORY_EVENT@1064_86@BODY_LORE"
msgstr "\"Eu sabia! Eu sabia que você acharia {TargetHouseLord} agradável. Mal posso esperar por nossa próxima aventura, {PlayerLeader.TitleName}. {EventHouse} e {TargetHouse} estão felizes em servir!\""

msgid "STORY_EVENT@1064_86@BUTTON_0"
msgstr "\"Espalhe a palavra da minha grandiosidade [influence/] por todo o reino.\""

msgid "STORY_EVENT@1064_86@BUTTON_1"
msgstr "\"Meu exército poderia usar soldados fortes [unit/] como os seus.\""

msgid "STORY_EVENT@1064_86@BUTTON_3"
msgstr "\"Sua lealdade e gratidão poderiam ser expressas em um novo pacto [allegiance/].\""

msgid "STORY_EVENT@1064_86@TITLE"
msgstr "Duas Cidades, Unidas: Desfecho"

msgid "STORY_EVENT@1064_881@BODY_FOOTER"
msgstr "Você se sente preparado para reclamar o Gildercoil através de astúcia ou força. Pela glória de si mesmo. E pelo {GLOBAL.ShadraiFactionLoreConcept.Hyperlink}!"

msgid "STORY_EVENT@1064_881@BODY_HEADER"
msgstr "Depois que {EventHero.FirstName} terminou a visão, você reflete sobre a situação em questão."

msgid "STORY_EVENT@1064_881@BODY_LORE"
msgstr "Cinco {GLOBAL.GodirLoreConcept.Hyperlink} habitam a Caldera Carmesim. Um deles possui o Gildercoil, mas para descobrir quem, você deve ter cada um deles à sua mercê. Para este fim, {EventHero.FirstName} ensinou-lhe a magia Fio da Mente, mas a força bruta parece ser uma opção igualmente boa neste reino de guerra perpétua."

msgid "STORY_EVENT@1064_881@BUTTON_0"
msgstr "\"Sou uma força quase imparável.\""

msgid "STORY_EVENT@1064_881@TITLE"
msgstr "Encontrando o Gildercoil"

msgid "STORY_EVENT@1064_882@BODY_FOOTER"
msgstr "\"Você ganhou a recompensa da Caldera Carmesim, {PlayerLeader}. O Gildercoil me deu o que eu desejava, e não tenho arrependimentos em transferir o item de [hyperlink,GLOBAL.ArchonsLoreConcept]Arconte[/hyperlink] de ira eterna para o seu nome.\""

msgid "STORY_EVENT@1064_882@BODY_HEADER"
msgstr "\"Muitos vieram e morreram nesta arena do meu divertimento pessoal. Todos buscavam poder e encontraram a morte irônica—todos, exceto você.\""

msgid "STORY_EVENT@1064_882@BODY_LORE"
msgstr "{EventPlayer.FirstName} faz um gesto como se estivesse colocando uma máscara, revelando brevemente um semblante infernal com chifres. \"Tenho muitos nomes. Atyngwe, Liztia, Perumplex, Zhitur, Gontro... as pessoas ficam criativas quando se trata do Príncipe Demônio do Engano.\""

msgid "STORY_EVENT@1064_882@BUTTON_0"
msgstr "Pegue o Gildercoil para completar sua vitória."

msgid "STORY_EVENT@1064_882@TITLE"
msgstr "Encontrando o Gildercoil: Desfecho"

msgid "STORY_EVENT@1064_89@BODY_FOOTER"
msgstr "{EventHouseLord} suplica desesperadamente para que seus exércitos limpem o {EventSpawner}."

msgid "STORY_EVENT@1064_89@BODY_HEADER"
msgstr "Um {EventHouseLord.TitleName} perturbado de {EventHouse} aparece diante de você."

msgid "STORY_EVENT@1064_89@BODY_LORE"
msgstr "\"Por favor, ouça meu humilde apelo, {PlayerLeader.TitleName}. {EventHouse} está atormentada por bandidos. Envie uma companhia de soldados para atacar o acampamento deles, mas em vez de enfrentar os bandidos, eles desertaram e se juntaram às fileiras deles. Que eu possa ver tais tempos, quando o chamado do butim é mais forte do que o chamado para proteger nossa grande cidade!\""

msgid "STORY_EVENT@1064_89@BUTTON_0"
msgstr "\"Minhas forças derrotarão o {EventSpawner}, e você ficará em minha dívida.\""

msgid "STORY_EVENT@1064_89@BUTTON_1"
msgstr "\"Se seus soldados [unit/] são tão facilmente comprados [gold/], então eu os comprarei.\""

msgid "STORY_EVENT@1064_89@BUTTON_2"
msgstr "\"Não tenho tempo para seus problemas insignificantes.\""

msgid "STORY_EVENT@1064_89@TITLE"
msgstr "Chamado do Butim"

msgid "STORY_EVENT@1064_90@BODY_FOOTER"
msgstr "Você protegeu {EventHouse} e lhe é oferecida uma arma como um símbolo de gratidão. O que mais você pede?"

msgid "STORY_EVENT@1064_90@BODY_HEADER"
msgstr "Você destruiu o {EventSpawner} que estava ameaçando {EventHouse}."

msgid "STORY_EVENT@1064_90@BODY_LORE"
msgstr "{EventHouseLord} está muito aliviado. \"Minha cidade e eu estamos em dívida com você, {PlayerLeader.TitleName}. Podemos não ter muito a oferecer a um {PlayerLeader.Title} como você, mas seria uma honra presentear você com uma arma que já foi usada para proteger nossa cidade de um grande perigo, a {EventItem}. \""

msgid "STORY_EVENT@1064_90@BUTTON_0"
msgstr "\"Meu império sempre precisa de mais ouro [gold/].\""

msgid "STORY_EVENT@1064_90@BUTTON_1"
msgstr "\"Você pode pagar sua dívida me concedendo alguns de seus soldados [unit/].\""

msgid "STORY_EVENT@1064_90@BUTTON_3"
msgstr "\"Lembre-se dos meus feitos, {EventHouseLord}. Lembre-se de quem confiar na necessidade.\""

msgid "STORY_EVENT@1064_90@TITLE"
msgstr "Atração do Butim: Consequências"

msgid "STORY_EVENT@1064_946@BODY_FOOTER"
msgstr "Para expandir seu domínio, caça as criaturas perto de {EventCity} e cresça uma nova população para [hyperlink,GLOBAL.ProvinceImprovementConcept]colocar[/hyperlink] sua primeira {GLOBAL.FarmConcept.Hyperlink}."

msgid "STORY_EVENT@1064_946@BODY_HEADER"
msgstr "Por muito tempo os {EventRace} vagaram {GLOBAL.AthlaLoreConcept.Hyperlink} como exilados, ó {PlayerLeader.TitleName}. Ao liderá-los para este vale, você devolveu a esperança a eles."

msgid "STORY_EVENT@1064_946@BODY_LORE"
msgstr "A orgulhosa cidade de {EventCity} representa um novo começo para seu povo. Eles estão ansiosos para ir além dos portões da cidade e reclamar as terras ao redor como suas."

msgid "STORY_EVENT@1064_946@BUTTON_0"
msgstr "Que esta jornada de nós {EventRace} comece."

msgid "STORY_EVENT@1064_946@TITLE"
msgstr "Um Novo Amanhecer"

msgid "STORY_EVENT@1064_947@BODY_FOOTER"
msgstr "A peça em sua honra terminará com uma promessa para o futuro. Como você deseja que ela termine?"

msgid "STORY_EVENT@1064_947@BODY_HEADER"
msgstr "Você domou a terra ao redor de {EventCity} e invocou um espírito de otimismo e aventura em seu povo."

msgid "STORY_EVENT@1064_947@BODY_LORE"
msgstr "Eles estão encenando uma peça que reconta a história de como você liderou os {EventRace} para a segurança: desde a morte do ancião, até o {GLOBAL.TomeLoreConcept.Hyperlink} herdado, o cisma com {EventHouseLord} e, eventualmente, a fundação de {EventCity} no {GLOBAL.ValleyofWondersLoreConcept.Hyperlink}."

msgid "STORY_EVENT@1064_947@BUTTON_0"
msgstr "Termina com um tesouro [gold/] digno de reis."

msgid "STORY_EVENT@1064_947@BUTTON_1"
msgstr "A última cena se passa nos campos férteis [food/] de {EventCity}."

msgid "STORY_EVENT@1064_947@BUTTON_2"
msgstr "No campo de batalha, [unitprod/] os valorosos {EventRace} cumprem seu destino."

msgid "STORY_EVENT@1064_947@BUTTON_3"
msgstr "Por último, mostra os estudiosos [knowledge/] de {EventCity} sentados em seus grandes salões."

msgid "STORY_EVENT@1064_947@TITLE"
msgstr "Um Novo Amanhecer: Consequências"

msgid "STORY_EVENT@1064_950@BODY_FOOTER"
msgstr "Você buscará e se aliara com {EventHouse} para reunir os {EventRace}?"

msgid "STORY_EVENT@1064_950@BODY_HEADER"
msgstr "Após um longo debate, um dos <<m:EventUnit>> de {EventCity} se aproxima de você, ansioso para falar."

msgid "STORY_EVENT@1064_950@BODY_LORE"
msgstr "\"Como você sabe, meu {PlayerLeader.Title}, nem todos nós {EventRace} tivemos a sabedoria de seguir sua liderança para {EventCity}. Alguns ficaram com medo da magia que o ancião passou para você, nosso {PlayerLeader.Title}. Eles ficaram com {EventHouseLord} para fundar {EventHouse} por conta própria.\""

msgid "STORY_EVENT@1064_950@BUTTON_0"
msgstr "\"Eu concordo. Somos mais fortes como um só.\""

msgid "STORY_EVENT@1064_950@BUTTON_2"
msgstr "\"Eu irei garantir a lealdade deles... com a espada [unitprod/]! [evilact/]\""

msgid "STORY_EVENT@1064_950@BUTTON_3"
msgstr "\"Eles escolheram seu próprio caminho. O destino deles é deles.\""

msgid "STORY_EVENT@1064_950@TITLE"
msgstr "Consertando o Cisma"

msgid "STORY_EVENT@1064_951@BODY_FOOTER"
msgstr "\"<<EventHouse>> oferece tudo o que tem para dar, para que os <<EventRace>> possam ficar juntos novamente.\""

msgid "STORY_EVENT@1064_951@BODY_HEADER"
msgstr "O novo pacto forjado com <<EventHouse>> sela a reunificação dos <<EventRace>>."

msgid "STORY_EVENT@1064_951@BODY_LORE"
msgstr "\"Fomos tolos em temer a magia que você está usando,\" <<EventHouseLord>> diz. \"Um feitiço pode causar dano ou matar, mas também pode proteger. Nós, <<EventRace>>, precisamos do seu poder para sobreviver neste mundo perigoso e o chamaremos orgulhosamente de <<PlayerLeader.Title>>.\""

msgid "STORY_EVENT@1064_951@BUTTON_0"
msgstr "\"Recrute seus melhores soldados [unit/] para a guerra!\""

msgid "STORY_EVENT@1064_951@BUTTON_1"
msgstr "\"As pessoas em <<EventCity>> merecem um banquete [food/] em honra desta ocasião.\" [goodact/]"

msgid "STORY_EVENT@1064_951@BUTTON_2"
msgstr "\"Doe para o meu tesouro [gold/], e prosperaremos juntos.\""

msgid "STORY_EVENT@1064_951@TITLE"
msgstr "Consertando o Cisma: Consequências"

msgid "STORY_EVENT@1064_95@BODY_FOOTER"
msgstr "\"Você vai me ajudar a matar o <<EventStackLeader>> e obter minha vingança?\""

msgid "STORY_EVENT@1064_95@BODY_HEADER"
msgstr "<<EventHero>> se aproxima de você. \"Eu era uma criança solitária,\" <<p:EventHero>> explica, e você percebe que está prestes a ouvir uma longa história."

msgid "STORY_EVENT@1064_95@BODY_LORE"
msgstr "\"O único amigo que eu tinha era meu animal de estimação <<EventMount>>, <<PetName>>. Eu amava aquela criatura.\" <<Co:EventHero>> expressão escurece. \"Mas então, o <<EventStackLeader>> veio e atacou nossa aldeia. Todos fugiram, exceto eu e <<PetName>>... <<Cp:PetName>> morreu me protegendo. Naquele dia, jurei que teria minha vingança contra aquele <<EventStackLeader>> e sua espécie. E agora eu o encontrei. O assassino do meu melhor amigo.\""

msgid "STORY_EVENT@1064_95@BUTTON_0"
msgstr "\"Você terá sua vingança, e eu a cabeça do <<EventStackLeader>>.\""

msgid "STORY_EVENT@1064_95@BUTTON_2"
msgstr "\"Este não é o momento para vinganças pessoais, <<EventHero>>.\""

msgid "STORY_EVENT@1064_95@TITLE"
msgstr "Cavalgar por Vingança"

msgid "STORY_EVENT@1064_965@BODY_FOOTER"
msgstr "Você resistirá à exigência de <<EventPlayer.Name>>?"

msgid "STORY_EVENT@1064_965@BODY_HEADER"
msgstr "Dentro da fumaça de uma nuvem em chamas, uma figura real se revela a você."

msgid "STORY_EVENT@1064_965@BODY_LORE"
msgstr "\"Alegre-se, mortal! Você foi considerado digno de contemplar o aspecto do verdadeiramente sublime <<EventPlayer.Name>>. Você pode agora render seu povo e templos ao Deus do Fogo em adoração reverencial — ou vê-los queimar em retribuição por um erro tolo.\""

msgid "STORY_EVENT@1064_965@BUTTON_0"
msgstr "\"Não temos medo de suas legiões flamejantes. Venha, enfrete nosso aço!\""

msgid "STORY_EVENT@1064_965@BUTTON_2"
msgstr "\"Como um mortal poderia resistir à vontade de um deus? Eu me rendo a você, meu Senhor Supremo.\""

msgid "STORY_EVENT@1064_965@TITLE"
msgstr "Fogo e Areia"

msgid "STORY_EVENT@1064_966@BODY_FOOTER"
msgstr "Você emergiu deste conflito como um herói e salvador do seu povo. Levado pela euforia deles, você sente seu espírito sendo elevado alto, além do horizonte e em direção ao [hyperlink,GLOBAL.AstralSeaLoreConcept]Mar Astral[/hyperlink]."

msgid "STORY_EVENT@1064_966@BODY_HEADER"
msgstr "\"Vitória!\" é o que ecoa nas ruas de <<EventCity>>, \"Vitória!\" é o que está gravado nos corações dos <<EventRace>>, pois <<EventEnemy>>, [hyperlink,GLOBAL.GodirLoreConcept]Godir[/hyperlink] do Fogo, foi derrotado."

msgid "STORY_EVENT@1064_966@BODY_HEADER@NO_CITY"
msgstr "\"Vitória!\" é o que ecoa no Vale das Maravilhas, \"Vitória!\" é o que está gravado nos corações dos <<EventRace>>, pois <<EventEnemy>>, [hyperlink,GLOBAL.GodirLoreConcept]Godir[/hyperlink] do Fogo, foi derrotado."

msgid "STORY_EVENT@1064_966@BODY_LORE"
msgstr "A fumaça ainda paira sobre as cidades orgulhosas dos <<EventEnemyRace>>, enquanto você reflete sobre suas próprias conquistas. Foi realmente um [hyperlink,GLOBAL.AscendedChampLoreConcept]Herói Mortal[/hyperlink] que derrotou o [hyperlink,GLOBAL.WizardKingLoreConcept]Rei-Feiticeiro[/hyperlink] <<EventEnemy.FirstName>>? Ou sua jornada de conhecimento e poder já havia alterado seu destino?"

msgid "STORY_EVENT@1064_966@BUTTON_0"
msgstr "Libere Athla para concluir sua ascensão."

msgid "STORY_EVENT@1064_966@TITLE"
msgstr "Fogo e Areia: Consequências"

msgid "STORY_EVENT@1064_96@BODY_FOOTER"
msgstr "{EventHero} está grato por sua ajuda em <<o:EventHero>> busca por vingança. O que você pede em troca?"

msgid "STORY_EVENT@1064_96@BODY_HEADER"
msgstr "Você caçou e matou com sucesso o {EventStackLeader}."

msgid "STORY_EVENT@1064_96@BODY_LORE"
msgstr "{EventHero} inclina <<o:EventHero>> cabeça. \"Finalmente, está feito. {PetName}, meu velho amigo, você foi vingado!\" <<Cp:EventHero>> olha para cima. \"Obrigado, {PlayerLeader.TitleName}. Isso significa muito para mim. Diga-me o que posso fazer para retribuir.\""

msgid "STORY_EVENT@1064_96@BUTTON_0"
msgstr "\"Treine os novos recrutas [unitprod/] em {EventCity}.\""

msgid "STORY_EVENT@1064_96@BUTTON_1"
msgstr "\"Nós vingamos sua antiga montaria. Vá e treine [mount/] uma nova!\""

msgid "STORY_EVENT@1064_96@BUTTON_3"
msgstr "\"Sua lealdade e gratidão [happiness/] é tudo o que posso pedir.\""

msgid "STORY_EVENT@1064_96@TITLE"
msgstr "Cavalgar para a Vingança: Consequências"

msgid "STORY_EVENT@1064_973@BODY_FOOTER"
msgstr "{EventPlayer.FirstName} aconselha você a explorar a {EventStructure} próxima e usar seus poderes para afastar {EventEnemy}."

msgid "STORY_EVENT@1064_973@BODY_HEADER"
msgstr "\"O piromante {EventEnemy} escapou e voltou para {GLOBAL.AthlaLoreConcept.Hyperlink}. <<Co:EventEnemy>> olhar está fixo no {GLOBAL.ValleyofWondersLoreConcept.Hyperlink}.\""

msgid "STORY_EVENT@1064_973@BODY_LORE"
msgstr "\"<<Cp:EventEnemy>> está acumulando <<o:EventEnemy>> forças infernais e não tolerará competição, especialmente de um mago iniciante como você. Você deve abraçar a centelha de magia que despertou dentro de você. Procure os poderes da {EventStructure} próxima antes que {EventEnemy.FirstName} o faça. Se você não se preparar, {EventEnemy.FirstName} queimará seus assentamentos até o chão.\""

msgid "STORY_EVENT@1064_973@BUTTON_0"
msgstr "\"Você tem minha gratidão, {EventPlayer}. Juntos, podemos enfrentar até um Rei-Feiticeiro.\""

msgid "STORY_EVENT@1064_973@BUTTON_2"
msgstr "\"Seu conselho é um insulto ao meu governo. Vá embora!\""

msgid "STORY_EVENT@1064_973@TITLE"
msgstr "A Torre Perdida"

msgid "STORY_EVENT@1064_974@BODY_FOOTER"
msgstr "{EventPlayer} tira um {EventItem} e entrega a você. \"Você está pronto para atacar {EventEnemy.FirstName}, {PlayerLeader}. Eu lhe emprestarei um batalhão dos meus guerreiros—escolha o que melhor se encaixa em sua estratégia.\""

msgid "STORY_EVENT@1064_974@BODY_HEADER"
msgstr "Enquanto sua mente ainda está processando os acontecimentos na Torre dos Destinos, você é abordado novamente por {EventPlayer}."

msgid "STORY_EVENT@1064_974@BODY_LORE"
msgstr "\"Incrível, não é? Pensar que todo esse conhecimento estava enterrado em {GLOBAL.AthlaLoreConcept.Hyperlink} por eras—se apenas Julia ou Merlin estivessem aqui para ponderar seu significado. Infelizmente, há menos esperança de encontrá-los do que de resolvermos isso nós mesmos. Você foi agraciado, {PlayerLeader}. Em breve você aprenderá o que isso realmente significa.\""

msgid "STORY_EVENT@1064_974@BUTTON_0"
msgstr "Peça arqueiros [unit/] para atirar no inimigo de longe."

msgid "STORY_EVENT@1064_974@BUTTON_2"
msgstr "Peça curandeiros [unit/] que irão sarar os ferimentos em batalha."

msgid "STORY_EVENT@1064_974@BUTTON_3"
msgstr "Peça piqueiros [unit/] para guardar as linhas de frente."

msgid "STORY_EVENT@1064_974@TITLE"
msgstr "A Torre Perdida: Consequências"

msgid "STORY_EVENT@1064_987@BODY_FOOTER"
msgstr "As raças retratadas pareciam antigas e esquecidas, mas {EventHero} estremece enquanto figuras encapuzadas começam a emergir das bordas escuras do cofre."

msgid "STORY_EVENT@1064_987@BODY_FOOTER@LEADER"
msgstr "As raças retratadas pareciam antigas e esquecidas, mas suas tropas estremecem enquanto figuras encapuzadas começam a emergir das bordas escuras do salão."

msgid "STORY_EVENT@1064_987@BODY_HEADER"
msgstr "Quando {EventHero} entra na {EventStructure}, um grande salão com colunas ornamentadas em seu centro se abre diante de <<P:EventHero>>."

msgid "STORY_EVENT@1064_987@BODY_HEADER@LEADER"
msgstr "Quando você entra na {EventStructure}, um grande salão com colunas ornamentadas em seu centro se abre diante de você."

msgid "STORY_EVENT@1064_987@BODY_LORE"
msgstr "Os relevos trabalhados nas colunas contam cada um a história de um povo em ascensão, recebendo presentes de um misterioso {GLOBAL.GodirLoreConcept.Hyperlink}. Alguns aprenderam a suportar o fogo, enquanto outros desenvolveram asas ou começaram a sugar a vida de seus inimigos. Na mente de <<g:mind^m,EventHero>>, uma mensagem abafada ecoa: \"Apenas os dignos ascendem.\""

msgid "STORY_EVENT@1064_987@BODY_LORE@LEADER"
msgstr "Os relevos trabalhados nas colunas contam cada um a história de um povo em ascensão, recebendo presentes de um misterioso {GLOBAL.GodirLoreConcept.Hyperlink}. Alguns aprenderam a suportar o fogo, enquanto outros desenvolveram asas ou começaram a sugar a vida de seus inimigos. Na sua mente, uma mensagem abafada ecoa: \"Apenas os dignos ascendem.\""

msgid "STORY_EVENT@1064_987@BUTTON_0"
msgstr "\"Venha o que vier, mantemos nossa posição!\""

msgid "STORY_EVENT@1064_987@BUTTON_1"
msgstr "Lance um guarda menor [mana/] para proteger [resistance/] suas tropas."

msgid "STORY_EVENT@1064_987@BUTTON_3"
msgstr "Invoque a coluna dos senhores da tempestade supercarregados."

msgid "STORY_EVENT@1064_987@BUTTON_4"
msgstr "Invoque a coluna dos parentes demônios chifrudos."

msgid "STORY_EVENT@1064_987@BUTTON_5"
msgstr "Fugir."

msgid "STORY_EVENT@1064_987@BUTTON_6"
msgstr "Invoque a coluna dos guardiões das árvores verdes."

msgid "STORY_EVENT@1064_987@BUTTON_7"
msgstr "Invoque a coluna dos paladinos exaltados."

msgid "STORY_EVENT@1064_987@BUTTON_8"
msgstr "Invoque a coluna dos senhores artesãos resolutos."

msgid "STORY_EVENT@1064_987@BUTTON_9"
msgstr "Invoque a coluna dos nascidos de cadáveres em decomposição."

msgid "STORY_EVENT@1064_987@TITLE"
msgstr "A Torre dos Destinos"

msgid "STORY_EVENT@1064_988@BODY_FOOTER"
msgstr "Ao tocar o livro, {EventHero} ouve a mesma voz ecoante na cabeça de <<p:EventHero>>: \"Qual caminho você deseja liderar os {EventRace}?\""

msgid "STORY_EVENT@1064_988@BODY_FOOTER@LEADER"
msgstr "Ao tocar o livro, você ouve a mesma voz ecoante na sua cabeça: \"Qual caminho você deseja liderar os {EventRace}?\""

msgid "STORY_EVENT@1064_988@BODY_HEADER"
msgstr "Os guardiões da torre foram dispersos, deixando seus segredos maduros para serem tomados."

msgid "STORY_EVENT@1064_988@BODY_LORE"
msgstr "Em um altar de pedra fluida, {EventHero} encontra um único livro semelhante a um tomo, sua encadernação antiga e imponente como um testamento do tempo. Se o misterioso Godir mostrado nas colunas o deixou aqui ou algum preservador de seu legado, permanece incerto."

msgid "STORY_EVENT@1064_988@BODY_LORE@LEADER"
msgstr "Em um altar de pedra fluida, você encontra um único livro semelhante a um tomo, sua encadernação antiga e imponente como um testamento do tempo. Se o misterioso Godir mostrado nas colunas o deixou aqui ou algum preservador de seu legado, permanece incerto."

msgid "STORY_EVENT@1064_988@BUTTON_1"
msgstr "\"No caminho do esclarecimento arcano.\""

msgid "STORY_EVENT@1064_988@BUTTON_10"
msgstr "\"No caminho dos poderes demoníacos, um pacto inquebrável.\""

msgid "STORY_EVENT@1064_988@BUTTON_3"
msgstr "\"Para uma vida eterna além da morte.\""

msgid "STORY_EVENT@1064_988@BUTTON_7"
msgstr "\"Para os selvagens, abraçando suas raízes.\""

msgid "STORY_EVENT@1064_988@BUTTON_8"
msgstr "\"Em direção às riquezas e despojos da terra.\""

msgid "STORY_EVENT@1064_988@BUTTON_9"
msgstr "\"Em direção a um paraíso livre de pecado, ligado à fé.\""

msgid "STORY_EVENT@1064_988@TITLE"
msgstr "A Torre dos Destinos: Consequências"

msgid "STORY_EVENT@1064_991@BODY_FOOTER"
msgstr "\"Ouça o que eu tenho a dizer, e você e seus {EventRace} podem evitar encontrar seu fim aqui.\""

msgid "STORY_EVENT@1064_991@BODY_HEADER"
msgstr "Desde que você chegou no {GLOBAL.ValleyofWondersLoreConcept.Hyperlink}, visões lúcidas apareceram em sua mente. Agora, uma elfa de aparência proposital entra em foco."

msgid "STORY_EVENT@1064_991@BODY_LORE"
msgstr "\"Saudações, {PlayerLeader}. Eu sou {EventPlayer}. Meu povo tem guardado este vale ao longo das Eras. Para melhor ou pior, seu destino está conectado ao nosso.[br/][br/]Temos observado você por algum tempo. Outros {GLOBAL.GodirLoreConcept.Hyperlink} poderosos também notaram sua chegada. Sua essência emana conflito, mas também grande potencial.\""

msgid "STORY_EVENT@1064_991@BUTTON_0"
msgstr "Continuar a ouvir..."

msgid "STORY_EVENT@1064_991@TITLE"
msgstr "<<ge:Call^n,EventPlayer.FirstName>>"

msgid "STORY_EVENT@1064_9@BODY_FOOTER"
msgstr "A criatura implora para que você a liberte, a ela e ao povo deste reino, da ira da {EventNimue.Title}."

msgid "STORY_EVENT@1064_9@BODY_HEADER"
msgstr "Você chega à borda externa do Arquipélago Encantado. Você é recebido por uma voz melancólica, a mesma que o trouxe a este reino."

msgid "STORY_EVENT@1064_9@BODY_LORE"
msgstr "A voz canta sobre amor transformado em obsessão, sobre uma deusa irada e um povo encantado. Sobre um lago, uma nascente, transformada em uma prisão. Ela canta desesperadamente pela chegada de um salvador a este reino. [br/][br/]De repente, a voz é abafada por risadas estridentes antes de ficar em silêncio, deixando apenas o som do vento e das ondas."

msgid "STORY_EVENT@1064_9@BUTTON_0"
msgstr "Eu reclamarei este reino e o libertarei desta \"Deusa Sereia\"."

msgid "STORY_EVENT@1064_9@TITLE"
msgstr "O Arquipélago Encantado"

msgid "STORY_EVENT@1103_10@BODY_FOOTER"
msgstr "Você concederia misericórdia ao aparentemente gentil {EventStackLeader.Name}, ou atacaria?"

msgid "STORY_EVENT@1103_10@BODY_HEADER"
msgstr "Enquanto suas tropas se movem para engajar o antigo {EventStackLeader.Name}, <<p:EventStackLeader>> os surpreende simplesmente sentando."

msgid "STORY_EVENT@1103_10@BODY_LORE"
msgstr "Embora sentado, o [hyperlink,GLOBAL.GiantsLoreConcept]ser primordial[/hyperlink] ainda se eleva acima do seu exército, lançando uma longa sombra que engolfa grande parte dos arredores de <<o:EventStackLeader>>. Certamente, <<p:EventStackLeader>> usou <<o:EventStackLeader>> poder tremendo para formar as montanhas e os mares. Agora, o {EventStackLeader} levanta <<o:EventStackLeader>> braços no sinal atemporal de rendição. Então <<p:EventStackLeader>> simplesmente espera, <<o:EventStackLeader>> braços raspando o céu como dois pináculos sinistros."

msgid "STORY_EVENT@1103_10@BUTTON_0"
msgstr "\"Morte ao {EventStackLeader}!\" [evilact/]"

msgid "STORY_EVENT@1103_10@BUTTON_1"
msgstr "\"Vá em paz, meu amigo gigante.\" [goodact/]"

msgid "STORY_EVENT@1103_10@BUTTON_2"
msgstr "\"Siga em frente, {EventStackLeader}, e diga a todos [influence/] que você vive porque eu lhe concedi misericórdia!\""

msgid "STORY_EVENT@1103_10@TITLE"
msgstr "Grande Amigão {EventStackLeader.Name}"

msgid "STORY_EVENT@1103_11@BODY_FOOTER"
msgstr "<<Cp:EventStackLeader>> gesticula para {EventHero.FirstName} e depois para si mesmo e seu oponente. \"Quem é mais digno?\""

msgid "STORY_EVENT@1103_11@BODY_HEADER"
msgstr "Tropas da {EventHouse.Name} observam dois guerreiros poderosos, mas igualmente parelhos, se chocarem na {EventStructure.Name}."

msgid "STORY_EVENT@1103_11@BODY_LORE"
msgstr "{EventStackLeader.Name}, um dos guerreiros em batalha, para e se dirige a {EventHero.Name} enquanto se aproximam da {EventStructure.Name}. \"Força e glória! Você serve {PlayerLeader.TitleName}, certo? Nosso {EventHouseLord.Title} decretou que quem for mais forte terá a honra de guardar este local. Mas estamos igualmente parelhos. Você decide quem é digno e quem pode deixar o campo em vergonha!\""

msgid "STORY_EVENT@1103_11@BUTTON_1"
msgstr "\"Nenhum. Ambos precisam de treinamento! Meus homens treinarão vocês, [unitprod/] e vocês deixarão este local para mim.\""

msgid "STORY_EVENT@1103_11@BUTTON_2"
msgstr "\"Você são filhotes chorões?! Lutem! O vencedor me concederá este local!\""

msgid "STORY_EVENT@1103_11@BUTTON_3"
msgstr "\"Não vejo ninguém digno de guardar este local. Vejo apenas um número de cadáveres a serem!\""

msgid "STORY_EVENT@1103_11@BUTTON_4"
msgstr "\"Eu deixarei vocês a isso...\""

msgid "STORY_EVENT@1103_11@TITLE"
msgstr "Bárbaros Duelando"

msgid "STORY_EVENT@1103_12@BODY_FOOTER"
msgstr "<<Cp:EventStackLeader>> cruza <<o:EventStackLeader>> braços e encara {EventHero.FirstName} diretamente nos olhos. \"O que é melhor na vida?\""

msgid "STORY_EVENT@1103_12@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "<<Cp:EventStackLeader>> cruza <<o:EventStackLeader>> braços e olha fixamente em seus olhos. \"O que há de melhor na vida?\""

msgid "STORY_EVENT@1103_12@BODY_HEADER"
msgstr "Tropas de {EventHouse.Name} estacionadas na {EventStructure.Name} sentam-se ao redor de uma fogueira, discutindo os méritos do modo de vida bárbaro."

msgid "STORY_EVENT@1103_12@BODY_LORE"
msgstr "{EventStackLeader.Name} olha para {EventHero.Name} enquanto <<p:EventHero>> se aproxima da {EventStructure.Name}. \"Eu te conheço, você serve a {PlayerLeader.TitleName}, não? Você aprendeu muito em suas viagens, não? Ajude-nos a resolver uma discussão.\""

msgid "STORY_EVENT@1103_12@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "{EventStackLeader.Name} olha para você enquanto você se aproxima da {EventStructure.Name}. \"Eu te conheço, você é {PlayerLeader.TitleName}, não? Você aprendeu muito em suas viagens, não? Ajude-nos a resolver uma discussão.\""

msgid "STORY_EVENT@1103_12@BUTTON_1"
msgstr "\"A glória é o melhor! [influence/] Saia e ganhe um pouco para vocês mesmos!\""

msgid "STORY_EVENT@1103_12@BUTTON_2"
msgstr "\"A valentia é o melhor. Nós somos mais poderosos que você. Reclamamos este local!\""

msgid "STORY_EVENT@1103_12@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "\"A valentia é o melhor. Eu sou mais poderoso que você. Reclamo este local!\""

msgid "STORY_EVENT@1103_12@BUTTON_3"
msgstr "\"A harmonia é o melhor. Esta terra clama pelo governo de <<g:rule^n,PlayerLeader>>.\""

msgid "STORY_EVENT@1103_12@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "\"A harmonia é o melhor. Esta terra clama pelo meu governo.\""

msgid "STORY_EVENT@1103_12@BUTTON_4"
msgstr "\"A batalha é o melhor! Esmagar seus inimigos, vê-los fugindo diante de você!\""

msgid "STORY_EVENT@1103_12@BUTTON_5"
msgstr "\"A honra é o melhor. Nós honramos sua reivindicação desta {EventStructure}. Adeus.\""

msgid "STORY_EVENT@1103_12@BUTTON_5@HERO_IS_PLAYERLE"
msgstr "\"A honra é o melhor. Eu honro sua reivindicação desta {EventStructure}. Adeus.\""

msgid "STORY_EVENT@1103_12@TITLE"
msgstr "Filosofia Bárbara"

msgid "STORY_EVENT@1103_13@BODY_FOOTER"
msgstr "O {EventStackLeader} aguarda nervosamente sua resposta, com uma mão pairando perto de sua arma."

msgid "STORY_EVENT@1103_13@BODY_HEADER"
msgstr "Há algo suspeito na maneira como um esquadrão de tropas de {EventHouse.Name} observa cautelosamente a aproximação do seu exército em direção a {EventStructure.Name}."

msgid "STORY_EVENT@1103_13@BODY_LORE"
msgstr "À medida que {EventHero.Name} se aproxima, eles notam estandartes e insígnias de {EventHouse.Name} jogados de lado. Um {EventStackLeader} franzindo a testa diz: \"Nós só queremos ser deixados em paz, por favor, sigam em frente.\" Parece que essas tropas estão considerando desertar..."

msgid "STORY_EVENT@1103_13@BUTTON_0"
msgstr "\"Você são claramente desertores. Aceitem esta doação [gold/] para um novo começo. Agora deixem este lugar.\""

msgid "STORY_EVENT@1103_13@BUTTON_1"
msgstr "Compel-os a se arrependerem e se submeterem a você."

msgid "STORY_EVENT@1103_13@BUTTON_2"
msgstr "\"A deserção é punível com a morte!\""

msgid "STORY_EVENT@1103_13@BUTTON_3"
msgstr "Deixe-os."

msgid "STORY_EVENT@1103_13@TITLE"
msgstr "Apenas Desertores"

msgid "STORY_EVENT@1103_14@BODY_FOOTER"
msgstr "<<Cp:EventStackLeader>> gesticula para {EventHero.FirstName}. \"Você é um especialista em convergências de energia mágica?\""

msgid "STORY_EVENT@1103_14@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "<<Cp:EventStackLeader>> gesticula para você. \"Você é um especialista em convergências de energia mágica?\""

msgid "STORY_EVENT@1103_14@BODY_HEADER"
msgstr "As tropas de {EventHouse.Name} estacionadas na {EventStructure.Name} parecem estar observando a área enquanto fazem anotações diligentes."

msgid "STORY_EVENT@1103_14@BODY_LORE"
msgstr "{EventStackLeader.Name} corre até {EventHero.Name} enquanto seu exército se aproxima da {EventStructure.Name}. \"Você também pode sentir, não é?! Uma certa convergência de energias nesta área! Isso deve ser certamente o motivo pelo qual {PlayerLeader.TitleName} enviou você! Você está aqui para estudar este local obviamente mágico também?\""

msgid "STORY_EVENT@1103_14@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "{EventStackLeader.Name} corre em sua direção enquanto seu exército se aproxima da {EventStructure.Name}. \"Você também pode sentir, não é?! Uma certa convergência de energias nesta área! Com certeza é por isso que você veio! Você está aqui para estudar este local obviamente mágico também?\""

msgid "STORY_EVENT@1103_14@BUTTON_0"
msgstr "\"Você pode acessar nossas bibliotecas [knowledge/], mas {PlayerLeader.TitleName} agora reivindica esta {EventStructure}.\""

msgid "STORY_EVENT@1103_14@BUTTON_0@HERO_IS_PLAYERLE"
msgstr "\"Você pode acessar minhas bibliotecas [knowledge/], mas eu agora reivindico esta {EventStructure}.\""

msgid "STORY_EVENT@1103_14@BUTTON_1"
msgstr "\"Testemunhe o poder da minha magia enquanto reivindico este local!\""

msgid "STORY_EVENT@1103_14@BUTTON_2"
msgstr "\"Nossas lâminas convergirão com seus corações!\""

msgid "STORY_EVENT@1103_14@BUTTON_3"
msgstr "\"Estamos apenas passando. Continue seus estudos sem perturbações.\""

msgid "STORY_EVENT@1103_14@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "\"Estou apenas passando. Continue seus estudos sem perturbações.\""

msgid "STORY_EVENT@1103_14@TITLE"
msgstr "Mentes Convergentes"

msgid "STORY_EVENT@1103_15@BODY_FOOTER"
msgstr "O {EventStackLeader} olha para {EventHero.FirstName} enquanto <<p:EventStackLeader>> prepara um novo feitiço. \"Por favor, espere até que concluamos nosso debate.\""

msgid "STORY_EVENT@1103_15@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "O {EventStackLeader} olha para você enquanto <<p:EventStackLeader>> prepara um novo feitiço. \"Por favor, espere até que concluamos nosso debate.\""

msgid "STORY_EVENT@1103_15@BODY_HEADER"
msgstr "O ar crepita ao redor da {EventStructure.Name} enquanto dois grupos de magos da {EventHouse.Name} lançam feitiços um no outro."

msgid "STORY_EVENT@1103_15@BODY_LORE"
msgstr "{EventStackLeader.Name} pede um cessar-fogo enquanto {EventHero.Name} se aproxima. <<Cp:EventStackLeader>> encara <<o:EventStackLeader>> oponente enquanto um feitiço final atinge uma árvore próxima a <<P:EventStackLeader>> antes de se virar e se dirigir ao herói. \"Sua chegada é inoportuna! Estamos determinando qual de nós é mais capaz, magicamente falando, de guardar este local para a {EventHouse.Name}.\""

msgid "STORY_EVENT@1103_15@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "{EventStackLeader.Name} pede um cessar-fogo enquanto seu exército se aproxima. <<Cp:EventStackLeader>> encara <<o:EventStackLeader>> oponente enquanto um feitiço final atinge uma árvore próxima a <<P:EventStackLeader>> antes de se virar e se dirigir a você. \"Sua chegada é inoportuna! Estamos determinando qual de nós é mais capaz, magicamente falando, de guardar este local para a {EventHouse.Name}.\""

msgid "STORY_EVENT@1103_15@BUTTON_0"
msgstr "\"Use <<mana^n,PlayerLeader>> [mana/] para recarregar, mas termine seu debate em outro lugar.\""

msgid "STORY_EVENT@1103_15@BUTTON_0@HERO_IS_PLAYERLE"
msgstr "\"Use minha mana [mana/] para recarregar, mas termine seu debate em outro lugar.\""

msgid "STORY_EVENT@1103_15@BUTTON_1"
msgstr "\"Esta terra não tolerará mais suas transgressões mágicas!\""

msgid "STORY_EVENT@1103_15@BUTTON_2"
msgstr "\"Toda aquela energia dispensada, mas nenhuma gasta para se defenderem!\""

msgid "STORY_EVENT@1103_15@BUTTON_3"
msgstr "\"Estamos saindo antes que vocês queimem esta {EventStructure} até o chão.\""

msgid "STORY_EVENT@1103_15@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "\"Estou saindo antes que vocês queimem esta {EventStructure} até o chão.\""

msgid "STORY_EVENT@1103_15@TITLE"
msgstr "Debate Místico"

msgid "STORY_EVENT@1103_1@BODY_FOOTER"
msgstr "Você permite que o lamentável {EventStackLeader.Name} e <<o:EventStackLeader>> clã gigante se retirem, ou irá atacar?"

msgid "STORY_EVENT@1103_1@BODY_HEADER"
msgstr "O imponente {EventStackLeader.Name} grita de terror com a aproximação do seu exército. <<Cp:EventStackLeader>> se encolhe, escondendo <<o:EventStackLeader>> características atrás de dedos gigantescos."

msgid "STORY_EVENT@1103_1@BODY_LORE"
msgstr "Vendo seu líder se submeter, o resto da <<o:EventStackLeader>> tribo segue o exemplo. A área logo se enche com os sons de uivos lamentáveis e gritos roucos por misericórdia."

msgid "STORY_EVENT@1103_1@BUTTON_0"
msgstr "Mate todos eles! [evilact/]"

msgid "STORY_EVENT@1103_1@BUTTON_1"
msgstr "\"Vão embora, gentis gigantes.\" [goodact/]"

msgid "STORY_EVENT@1103_1@BUTTON_2"
msgstr "Recrute [unitprod/] eles como trabalhadores [structureprod/] em {EventCity.Name}."

msgid "STORY_EVENT@1103_1@TITLE"
msgstr "O Tamanho Não Importa"

msgid "STORY_EVENT@1103_2@BODY_FOOTER"
msgstr "Você vai evitá-los e permitir que escapem, ou vai atacar primeiro?"

msgid "STORY_EVENT@1103_2@BODY_HEADER"
msgstr "Um {EventStackLeader.Name} e outros mortos-vivos olham para suas tropas com medo e fome em igual medida."

msgid "STORY_EVENT@1103_2@BODY_LORE"
msgstr "O medo, no entanto, logo parece prevalecer, tornando o grupo relutante em atacar. Os seres sem vida se arrastam, tentando manter distância do seu exército."

msgid "STORY_EVENT@1103_2@BUTTON_0"
msgstr "\"Morte a esses mortos!\""

msgid "STORY_EVENT@1103_2@BUTTON_1"
msgstr "Deixe-os mortos e permita que continuem causando caos. [evilact/]"

msgid "STORY_EVENT@1103_2@BUTTON_3"
msgstr "Usando magia, [mana/] libere seus espíritos e deixe esses mortos finalmente descansarem. [goodact/]"

msgid "STORY_EVENT@1103_2@BUTTON_4"
msgstr "\"Parem de vagar sem rumo e juntem-se às minhas fileiras!\""

msgid "STORY_EVENT@1103_2@TITLE"
msgstr "Um Contrato de Não-Vida"

msgid "STORY_EVENT@1103_3@BODY_FOOTER"
msgstr "Você vai conceder-lhes misericórdia ou vai atacar?"

msgid "STORY_EVENT@1103_3@BODY_HEADER"
msgstr "Um {EventStackLeader.Name} com aparência torturada e <<o:EventStackLeader>> servos olham fixamente para o seu exército."

msgid "STORY_EVENT@1103_3@BODY_LORE"
msgstr "Sem palavras, os seres vazios se arrastam em sua direção, seus membros e características envolvidos em videiras. Folhas tremem e a casca range em súplica silenciosa, mas eles não fazem outros movimentos hostis."

msgid "STORY_EVENT@1103_3@BUTTON_0"
msgstr "\"Pode esses arbustos!\" [evilact/]"

msgid "STORY_EVENT@1103_3@BUTTON_1"
msgstr "Deixe-os crescer. [goodact/]"

msgid "STORY_EVENT@1103_3@BUTTON_2"
msgstr "Descubra [knowledge/] como colher cuidadosamente [food/] suas videiras e permita que partam depois."

msgid "STORY_EVENT@1103_3@TITLE"
msgstr "Sementes da Dúvida"

msgid "STORY_EVENT@1103_4@BODY_FOOTER"
msgstr "Você vai permitir que o {EventStackLeader.Name} e <<o:EventStackLeader>> povo passem em segurança ou vai atacá-los?"

msgid "STORY_EVENT@1103_4@BODY_HEADER"
msgstr "Um grupo de Fey famintos e assustados fazem o possível para se esconder atrás de {EventStackLeader.Name} enquanto seu exército se aproxima."

msgid "STORY_EVENT@1103_4@BODY_LORE"
msgstr "O {EventStackLeader.Name}, tentando parecer o mais corajoso possível, tenta manter <<o:EventStackLeader>> grupo atrás de <<p:EventStackLeader>> e enfrenta suas tropas com desafio, mas não diz nada e não faz movimentos hostis."

msgid "STORY_EVENT@1103_4@BUTTON_0"
msgstr "\"Sem misericórdia!\" [evilact/]"

msgid "STORY_EVENT@1103_4@BUTTON_1"
msgstr "\"Paz, valente.\" [goodact/]"

msgid "STORY_EVENT@1103_4@BUTTON_2"
msgstr "Troque comida [food/] por segredos Fey [knowledge/] e permita que partam."

msgid "STORY_EVENT@1103_4@TITLE"
msgstr "Comida para Pensar"

msgid "STORY_EVENT@1103_5@BODY_FOOTER"
msgstr "Você vai atacá-los ou permitir que {EventStackLeader.Name} e <<o:EventStackLeader>> aliados temperamentais recuem?"

msgid "STORY_EVENT@1103_5@BODY_HEADER"
msgstr "As temperaturas na área imediata sobem e caem intermitentemente enquanto um grupo de seres elementais entra em pânico com a aproximação do seu exército."

msgid "STORY_EVENT@1103_5@BODY_LORE"
msgstr "O {EventStackLeader.Name}, aparentemente o líder deste grupo, vacila instavelmente diante de você. <<p:EventStackLeader>> parece ciente de que enfrentá-lo resultaria em morte quase certa, mas não está disposto a abandonar o grupo de <<o:EventStackLeader>>."

msgid "STORY_EVENT@1103_5@BUTTON_0"
msgstr "Atacar! [evilact/]"

msgid "STORY_EVENT@1103_5@BUTTON_1"
msgstr "Permitir que eles vão embora. [goodact/]"

msgid "STORY_EVENT@1103_5@BUTTON_2"
msgstr "Exigir uma porção do poder primordial deles [mana/] antes que partam."

msgid "STORY_EVENT@1103_5@TITLE"
msgstr "Elementos de Surpresa"

msgid "STORY_EVENT@1103_6@BODY_FOOTER"
msgstr "Você permitirá que eles invoquem seu portal para {GLOBAL.ObbadothLoreConcept.Hyperlink} e deixem estas terras?"

msgid "STORY_EVENT@1103_6@BODY_HEADER"
msgstr "Enquanto suas tropas engajam o grupo de demônios, fica aparente que eles estavam conjurando um portal para recuar."

msgid "STORY_EVENT@1103_6@BODY_LORE"
msgstr "O {EventStackLeader.Name}, o aparente líder do ajuntamento, lança um olhar astuto sobre o seu exército. Vendo que há pouca esperança de sobrevivência, <<p:EventStackLeader>> chama as próprias tropas para se sentarem no chão e se submeterem antes de seguir o exemplo <<r:EventStackLeader>>. <<Cp:EventStackLeader>> observa você com esperança cautelosa."

msgid "STORY_EVENT@1103_6@BUTTON_0"
msgstr "\"Mate-os todos!\" [evilact/]"

msgid "STORY_EVENT@1103_6@BUTTON_1"
msgstr "\"Vão embora então, demônios, e não retornem!\" [goodact/]"

msgid "STORY_EVENT@1103_6@BUTTON_2"
msgstr "Vincular o {EventStackLeader.Name} a você [mana/]."

msgid "STORY_EVENT@1103_6@TITLE"
msgstr "Demônio ou Inimigo"

msgid "STORY_EVENT@1103_7@BODY_FOOTER"
msgstr "Você permitirá que as bestas aladas recuem com seus ovos ou atacará?"

msgid "STORY_EVENT@1103_7@BODY_HEADER"
msgstr "Suas tropas atacam um grupo de criaturas aladas, mas percebem que elas não atacam nem recuam."

msgid "STORY_EVENT@1103_7@BODY_LORE"
msgstr "Seus inimigos voam pela área, batendo suas asas e fazendo barulhos alarmados. Eles não desejam enfrentar seu número superior, mas parecem relutantes em recuar também. Parece que estão protegendo alguns ninhos próximos."

msgid "STORY_EVENT@1103_7@BUTTON_0"
msgstr "\"Elimine-os todos.\" [evilact/]"

msgid "STORY_EVENT@1103_7@BUTTON_1"
msgstr "\"Voem, vocês, aves!\" [goodact/]"

msgid "STORY_EVENT@1103_7@BUTTON_2"
msgstr "Construir um aviário [structureprod/] em {EventCity.Name}, proporcionando segurança para as bestas [happiness/]."

msgid "STORY_EVENT@1103_7@TITLE"
msgstr "Voar ou Lutar"

msgid "STORY_EVENT@1103_8@BODY_FOOTER"
msgstr "Você deixará os macabros monstros ao terror deles ou atacá-los mesmo assim?"

msgid "STORY_EVENT@1103_8@BODY_HEADER"
msgstr "Enquanto suas tropas se movem para atacar o {EventStackLeader.Name} e a coleção de <<o:EventStackLeader>> [hyperlink,GLOBAL.AstralMonstersLoreConcept]horrores[/hyperlink], o inimigo grita e se submete."

msgid "STORY_EVENT@1103_8@BODY_LORE"
msgstr "Carne ondulante e tentáculos contorcidos se entrelaçam em um grotesco espetáculo de pânico, enquanto suas armas cercam o grupo de horrores arcanos do {GLOBAL.AstralSeaLoreConcept.Hyperlink}. Embora aterrorizantes em aparência, esses seres parecem não ter luta neles. Pelo menos, não contra você..."

msgid "STORY_EVENT@1103_8@BUTTON_0"
msgstr "\"Acabe com eles!\""

msgid "STORY_EVENT@1103_8@BUTTON_1"
msgstr "Permitir que eles fujam e espalhem seu terror em uma destruição pelo reino. [evilact/]"

msgid "STORY_EVENT@1103_8@BUTTON_2"
msgstr "Banir eles [mana/] para o Mar Astral onde eles não podem prejudicar ninguém. [goodact/]"

msgid "STORY_EVENT@1103_8@TITLE"
msgstr "Intenções Insondáveis"

msgid "STORY_EVENT@1103_9@BODY_FOOTER"
msgstr "O {EventStackLeader.Name} pondera: \"O que será então? Prudência, e nos separamos como iguais? Ou glória, e um de nós cai?\""

msgid "STORY_EVENT@1103_9@BODY_HEADER"
msgstr "Em vez de enfrentar suas tropas que se aproximam, o {EventStackLeader.Name} vira <<o:EventStackLeader>> pescoço sinuoso enquanto <<p:EventStackLeader>> os observa com um olhar antigo e sábio."

msgid "STORY_EVENT@1103_9@BODY_LORE"
msgstr "\"Vejo muito em termos de força e poder diante de mim,\" a sonorosa voz do grande [hyperlink,GLOBAL.DragonsLoreConcept]dragão[/hyperlink] retumba. Eras atrás, <<p:EventStackLeader>> e <<o:EventStackLeader>> parentes usaram forças primais para moldar este reino. Agora o monstro serpente faz uma pausa, lançando um olhar de vasta inteligência sobre seu exército. \"Eu também, você pode concordar, sou poderoso. Igualmente, estamos em equilíbrio, sim?\""

msgid "STORY_EVENT@1103_9@BUTTON_0"
msgstr "\"Glória, você verme supercrescido! Ataque!\" [evilact/]"

msgid "STORY_EVENT@1103_9@BUTTON_1"
msgstr "\"Paz, grande dragão. Vamos seguir nossos caminhos separados...\" [goodact/]"

msgid "STORY_EVENT@1103_9@BUTTON_2"
msgstr "\"Antes de nos separarmos em paz, um acordo? Ouro [gold/] do seu tesouro em troca de conhecimento ancestral [knowledge/].\""

msgid "STORY_EVENT@1103_9@TITLE"
msgstr "Aqui Há Dragões"

msgid "STORY_EVENT@1122_103@BODY_FOOTER"
msgstr "\"Por favor, estenda nossa rede receptora para permitir a formação de feixes aprimorada. Ou, como seus trabalhadores entenderão: por favor, construa [hyperlink,GLOBAL.ResearchPostConcept][researchpost/]Postos de Pesquisa[/hyperlink] adicionais.\""

msgid "STORY_EVENT@1122_103@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} de {EventHouse} cumprimenta você respeitosamente. \"Sábio {PlayerLeader.TitleName}, mapeamos os movimentos das estrelas. Nossos magos de formação de feixes solicitam seu apoio.\""

msgid "STORY_EVENT@1122_103@BODY_LORE"
msgstr "\"A formação de feixes é bastante direta. A luz das estrelas chega aqui do {GLOBAL.AstralSeaLoreConcept.Hyperlink} como raios. Nossos magos observam esses raios por um momento minúsculo. No entanto, a distância e a velocidade de uma estrela causam uma pequena discrepância na chegada de seus raios em cada um de nossos [hyperlink,GLOBAL.ProvinceImprovementConcept][researchpost/]Postos de Pesquisa[/hyperlink], causando ruído. Combinar observações de raios canalizados em todo o nosso domínio, levemente atrasadas para compensar a discrepância, forma um sinal mais forte e claro.\""

msgid "STORY_EVENT@1122_103@BUTTON_0"
msgstr "\"Como você solicita. Mas espero compartilhar de suas descobertas.\""

msgid "STORY_EVENT@1122_103@BUTTON_2"
msgstr "\"Alternativamente, compartilharei minhas próprias observações astrais [knowledge/] com você.\""

msgid "STORY_EVENT@1122_103@BUTTON_3"
msgstr "\"Que tal eu manipular diretamente os movimentos das estrelas para você observar?\""

msgid "STORY_EVENT@1122_103@BUTTON_4"
msgstr "\"Isso parece uma perda de tempo e recursos para mim.\""

msgid "STORY_EVENT@1122_103@TITLE"
msgstr "Formação de Feixes Astral"

msgid "STORY_EVENT@1122_104@BODY_FOOTER"
msgstr "O {EventHouseLord.Name} se curva. \"Graças a você, nosso <<m:EventUnit>> agora aproveita o poder das estrelas. Respeitosamente, oferecemos a você qualquer recompensa.\""

msgid "STORY_EVENT@1122_104@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} de {EventHouse} retorna a você pouco depois de você ter erigido o {EventImprovement} final. \"Novas revelações continuam a surgir, meu {PlayerLeader.Title}!\""

msgid "STORY_EVENT@1122_104@BODY_LORE"
msgstr "\"Estávamos um pouco incertos sobre a sintonia do atraso da canalização no início, mas logo descobrimos que poderíamos compensar as detecções contra a velocidade da magia sobre a qual deixamos fluir nossas percepções dos pulsos de luz das estrelas. Isso rendeu novos mapas de constelações, alguns dos quais usamos para forjar poderosos [hyperlink,GLOBAL.AstralSeaLoreConcept]astral[/hyperlink] visores, como este!\" {EventHouseLord} segura orgulhosamente um imaculado {EventItem}."

msgid "STORY_EVENT@1122_104@BUTTON_0"
msgstr "\"Ensine-me alguns dos segredos que as estrelas revelaram a você!\""

msgid "STORY_EVENT@1122_104@BUTTON_1"
msgstr "\"Ter um {EventUnit} [unit/] a meu serviço beneficiaria minha própria pesquisa!\""

msgid "STORY_EVENT@1122_104@BUTTON_3"
msgstr "\"Em troca da minha ajuda, aceito aquele belo {EventItem} [item/] que você forjou.\""

msgid "STORY_EVENT@1122_104@BUTTON_4"
msgstr "\"Valoro nossa amizade estelar acima de qualquer recompensa material, meu amigo.\""

msgid "STORY_EVENT@1122_104@TITLE"
msgstr "Formação de Feixes Astral: Consequências"

msgid "STORY_EVENT@1122_110@BODY_FOOTER"
msgstr "Você enviará um grupo de caça para {EventHouse} e se juntará à caçada pelo evasivo Pyreborn {EventStackLeader}?"

msgid "STORY_EVENT@1122_110@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} o cumprimenta solenemente. \"Majestoso {PlayerLeader}, {EventHouse} cordialmente o convida a participar da Caçada Cerimonial do Pyreborn {EventStackLeader}.\""

msgid "STORY_EVENT@1122_110@BODY_LORE"
msgstr "\"Uma vez a cada década, nossos melhores caçadores saem em busca do Pyreborn {EventStackLeader}. Nós abatemos todas as criaturas que encontramos e coletamos a carne para a glória de {EventHouse}, até finalmente capturarmos aquele {EventStackLeader} infundido de chamas. Você nos concederia uma tremenda honra ao se juntar a nós.\""

msgid "STORY_EVENT@1122_110@BUTTON_0"
msgstr "\"Estou honrado em me juntar a vocês.\""

msgid "STORY_EVENT@1122_110@BUTTON_2"
msgstr "\"Infelizmente, não posso poupar nenhum caçador no momento. Boa caçada!\""

msgid "STORY_EVENT@1122_110@BUTTON_3"
msgstr "\"Enviarei vários caçadores [unitprod/] de {EventCity} para se juntarem a vocês em meu lugar.\""

msgid "STORY_EVENT@1122_110@BUTTON_4"
msgstr "\"Não terei parte em seus rituais cruéis! [goodact/]\""

msgid "STORY_EVENT@1122_110@BUTTON_5"
msgstr "\"Sua caçada é brutal, não cerimonial. Você pode celebrar a cultura sem derramamento de sangue.\""

msgid "STORY_EVENT@1122_110@TITLE"
msgstr "A Caçada Pyreborn"

msgid "STORY_EVENT@1122_111@BODY_FOOTER"
msgstr "\"Você nos superou\", declara {EventHouseLord}. \"Como o matador de nossa presa venerável, você é o primeiro a reclamar seu prêmio.\""

msgid "STORY_EVENT@1122_111@BODY_HEADER"
msgstr "Após matar o Pyreborn {EventAnimal}, você ouve os distantes cornos de {EventHouse}. A Caçada acabou!"

msgid "STORY_EVENT@1122_111@BODY_LORE"
msgstr "Não demora muito até que {EventHouseLord.TitleName} se aproxime de você. <<Cp:EventHouseLord>> faz uma reverência profunda. \"O Pyreborn {EventAnimal} foi morto! Que o grande Caçador {PlayerLeader} traga glória para o nosso grande {EventHouse}!\" Os menestreis no <<G:entourage^n,EventHouseLord>> cantam uma curta balada de triunfo. Os Caçadores reúnem todos os animais mortos na caçada, formando uma respeitável montanha de caça."

msgid "STORY_EVENT@1122_111@BUTTON_0"
msgstr "\"Reivindicarei toda a carne [food/] que coletamos hoje.\""

msgid "STORY_EVENT@1122_111@BUTTON_1"
msgstr "\"Você pode ficar com a carne, mas levarei as peles [gold/].\""

msgid "STORY_EVENT@1122_111@BUTTON_3"
msgstr "\"Permita-me alistar [unit/] um de seus formidáveis caçadores {EventUnit}.\""

msgid "STORY_EVENT@1122_111@BUTTON_4"
msgstr "\"Montar a cabeça do {EventAnimal} simbolizará a supremacia do meu Império [influence/].\""

msgid "STORY_EVENT@1122_111@TITLE"
msgstr "A Caçada Pyreborn: Consequências"

msgid "STORY_EVENT@1122_123@BODY_FOOTER"
msgstr "\"A má notícia é que aqueles miseráveis de {EventHouse} secretamente o guardaram em seus cofres por eras! Devemos reavê-lo!\""

msgid "STORY_EVENT@1122_123@BODY_HEADER"
msgstr "{EventHero}, seu [hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink] solicitou uma audiência urgente com você. \"Meu senhor, finalmente localizei o há muito perdido {EventItem}!\""

msgid "STORY_EVENT@1122_123@BODY_LORE"
msgstr "\"As lendas que cercam o {EventItem} me inspiraram a me tornar um aventureiro. O mito da relíquia está tão entrelaçado com a cultura do meu povo! Mesmo hoje ouvi as crianças de {HeroCity} cantarem sua cantiga de roda: '{EventItem} / todos os {EventRace} conhecem seu nome / padeiros, açougueiros, brigadeiros / nenhum nega sua fama.' Por séculos ele esteve perdido, mas hoje descobri sua localização!\""

msgid "STORY_EVENT@1122_123@BODY_LORE@HERO_RACE_=_PLAY"
msgstr "\"As lendas que cercam o {EventItem} me inspiraram a me tornar um aventureiro. O mito da relíquia está tão entrelaçado com a cultura do nosso povo! Mesmo hoje ouvi as crianças de {HeroCity} cantarem sua cantiga de roda: '{EventItem} / todos os {EventRace} conhecem seu nome / padeiros, açougueiros, brigadeiros / nenhum nega sua fama.' Por séculos ele esteve perdido, mas hoje descobri sua localização!\""

msgid "STORY_EVENT@1122_123@BUTTON_0"
msgstr "\"Derrotaremos os tiranos de {TargetHouse} e reaveremos {EventItem}!\""

msgid "STORY_EVENT@1122_123@BUTTON_2"
msgstr "\"Não travarei uma guerra por causa de sua relíquia esquecida.\""

msgid "STORY_EVENT@1122_123@BUTTON_3"
msgstr "\"Você nunca me disse que deseja um {EventItem}. Permita-me replicá-lo!\""

msgid "STORY_EVENT@1122_123@TITLE"
msgstr "{EventItem}, Reivindicado"

msgid "STORY_EVENT@1122_124@BODY_FOOTER"
msgstr "\"Recuperamos o {EventItem} com justiça! Os cofres de {TargetHouse} estão à nossa mercê, {PlayerLeader.TitleName}. Que troféu você reivindicará?\""

msgid "STORY_EVENT@1122_124@BODY_HEADER"
msgstr "Após sua vitória contra {TargetHouse}, {EventHero} o visita imediatamente. \"Você derrotou os {TargetRace}! O {EventItem} finalmente é nosso para reivindicar!\""

msgid "STORY_EVENT@1122_124@BODY_LORE"
msgstr "\"Já fiz alguns guardas procurarem nos cofres da cidade, meu senhor. Eles me disseram que o {EventItem} foi mantido em condições impecáveis. Além disso, o cofre está repleto de tesouros e relíquias! Nossos para tomar! Vamos saquear—não—libertar esses prêmios dos gananciosos {TargetRace}, meu {PlayerLeader.Title}!\" Um brilho febril se instalou em <<G:eyes^n,EventHero>>."

msgid "STORY_EVENT@1122_124@BUTTON_0"
msgstr "\"Tomarei seus tesouros inestimáveis de ouro e prata [gold/].\""

msgid "STORY_EVENT@1122_124@BUTTON_1"
msgstr "\"As <<CG:crown jewels^n,TargetHouse>> decorarão meu salão do trono, elevando seu esplendor [influence/].\""

msgid "STORY_EVENT@1122_124@BUTTON_3"
msgstr "\"Quem deseja tesouros quando a cidade está repleta de almas [souls/] para colher! [evilact/]\""

msgid "STORY_EVENT@1122_124@BUTTON_4"
msgstr "\"Colete tudo [food/] [gold/] [influence/] que possuem. Os {TargetRace} testemunharão a supremacia de {PlayerLeader.Name} [evilact/].\""

msgid "STORY_EVENT@1122_124@BUTTON_5"
msgstr "\"Colete tudo [food/] [gold/] [influence/] [souls/] que possuem. Os {TargetRace} testemunharão a supremacia de {PlayerLeader.Name} [evilact/].\""

msgid "STORY_EVENT@1122_124@TITLE"
msgstr "{EventItem}, Reivindicado: Consequências"

msgid "STORY_EVENT@1122_127@BODY_FOOTER"
msgstr "{EventHero} franze a testa. \"Posso fabricar Golems, defensores de nossas terras. No entanto, construí-los requer algum {EventMaterial}. Você poderia garantir isso?\""

msgid "STORY_EVENT@1122_127@BODY_HEADER"
msgstr "\"<<PlayerLeader.TitleName>>, solicito urgentemente uma audiência!\" Seu [hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink] {EventHero} o visita com um olhar preocupado em <<o:EventHero>> olhos. \"Nossa defesa está faltando.\""

msgid "STORY_EVENT@1122_127@BODY_LORE"
msgstr "\"Sirvo arduamente suas ambições. Por você, aventuro-me no deserto ou invado os territórios de seus rivais.\" {EventHero.FirstName} ajoelha-se. \"Mas agora que comecei uma família, minhas prioridades mudaram. Esses dias, minha mente permanece com minha família dentro de suas fronteiras. Testemunhei a ferocidade das forças de nossos inimigos. Os protetores de nosso reino não podem resistir a eles. Precisamos de reforços poderosos.\""

msgid "STORY_EVENT@1122_127@BUTTON_0"
msgstr "\"Os Golems oferecem proteção extraordinária ao meu povo, {EventHero.Name}. Eu entregarei o {EventMaterial}.\""

msgid "STORY_EVENT@1122_127@BUTTON_2"
msgstr "\"Eu me solidarizo com você, {EventHero.Name}, mas minhas prioridades estão em outro lugar.\""

msgid "STORY_EVENT@1122_127@BUTTON_3"
msgstr "\"Você deveria estabelecer [unit/] em {EventCity}, para proteger sua família e treinar tropas [unitprod/].\""

msgid "STORY_EVENT@1122_127@TITLE"
msgstr "Corações de Ferro"

msgid "STORY_EVENT@1122_128@BODY_FOOTER"
msgstr "{EventHero.Name} usou o {EventMaterial} que você encontrou para construir dois <<m:EventUnitB>>. <<Cp:EventHero>> oferece agradecidamente um escudo. Você aceitará o {EventItem}?"

msgid "STORY_EVENT@1122_128@BODY_HEADER"
msgstr "{EventHero.Name} retorna a você, visivelmente aliviado. \"Ótimas notícias, {PlayerLeader.TitleName}! Agora que temos o {EventMaterial}, construí os Golems!\""

msgid "STORY_EVENT@1122_128@BODY_LORE"
msgstr "\"Esses <<m:EventUnitB>> podem defender suas fronteiras agora. Posso novamente embarcar em jornadas de conquista e exploração em seu nome, liberado de preocupações e hesitações.\" {EventHero.Name} produz um {EventItem}. \"Meu filho mais velho <<EventUnit{son/daughter}>> pegou o {EventMaterial} restante e fez isso na forja onde <<p:EventUnit>> aprende. Por favor, aceite este presente da minha família para você.\""

msgid "STORY_EVENT@1122_128@BUTTON_0"
msgstr "\"Faça seu <<EventUnit{son/daughter}>> equipar o escudo <<EventUnit{himself/herself}>> e me servir como um {EventUnit}.\""

msgid "STORY_EVENT@1122_128@BUTTON_3"
msgstr "\"Obrigado, {EventHero.FirstName}. Levarei o {EventItem} [item/] com orgulho.\""

msgid "STORY_EVENT@1122_128@BUTTON_4"
msgstr "\"Com este {EventItem}, seu filho mais velho protegerá sua família quando você estiver fora em aventuras [goodact/].\""

msgid "STORY_EVENT@1122_128@BUTTON_5"
msgstr "\"Pinte meu brasão no {EventItem}. Ele adornará minha sala do trono [influence/].\""

msgid "STORY_EVENT@1122_128@TITLE"
msgstr "Corações de Ferro: Consequências"

msgid "STORY_EVENT@1122_131@BODY_FOOTER"
msgstr "\"<<Cp:EventKnight>> é um risco, meu {PlayerLeader.Title}. Eventualmente, alguns viajantes visitando {EventStructure} morrerão. A menos que paremos <<P:EventKnight>>.\""

msgid "STORY_EVENT@1122_131@BODY_HEADER"
msgstr "{EventHero}, seu [hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink], cumprimenta você com um aviso: \"Corajoso {PlayerLeader.TitleName}, chegou ao meu conhecimento que um perigoso Cavaleiro Prateado está atacando viajantes!\""

msgid "STORY_EVENT@1122_131@BODY_LORE"
msgstr "\"Este guerreiro tirânico declarou <<r:EventKnight>> o <<G:sentinel^n,EventStructure>> e impede qualquer um de passar. <<Cp:EventKnight>> lança o desafio de derrotar <<P:EventKnight>> em combate próximo. Supostamente, <<p:EventKnight>> é um duelista formidável. Ninguém consegue derrotá-lo. Eu adoraria desafiar este Cavaleiro eu mesmo, se tivesse a oportunidade.\""

msgid "STORY_EVENT@1122_131@BUTTON_0"
msgstr "\"Eu preciso encontrar este Cavaleiro Prateado. E garantir a derrota de <<o:EventKnight>>.\""

msgid "STORY_EVENT@1122_131@BUTTON_2"
msgstr "\"Tenho certeza de que este assunto se resolverá sozinho eventualmente.\""

msgid "STORY_EVENT@1122_131@TITLE"
msgstr "O Cavaleiro Prateado"

msgid "STORY_EVENT@1122_132@BODY_FOOTER"
msgstr "{EventStackLeader} aponta <<o:EventStackLeader>> espada para {TriggeringStackLeader}, que desvia a espada de duelo. Instantaneamente, o Cavaleiro avança para desentranhar <<P:TriggeringStackLeader>>. {TriggeringStackLeader}..."

msgid "STORY_EVENT@1122_132@BODY_FOOTER@PLAYERLEADER_=_S"
msgstr "{EventStackLeader} aponta <<o:EventStackLeader>> espada para você. Você desvia a espada de duelo. Instantaneamente, o Cavaleiro avança para desentranhar você. Você..."

msgid "STORY_EVENT@1122_132@BODY_FOOTER@QUESTGIVER_=_STA"
msgstr "{EventStackLeader} aponta <<o:EventStackLeader>> espada para {TriggeringStackLeader}. {TriggeringStackLeader.FirstName} desvia a espada de duelo após proclamar: \"Eu estava esperando por este momento, Cavaleiro Prateado!\" Imediatamente, o Cavaleiro avança em direção a {TriggeringStackLeader.FirstName} para desentranhá-lo. {TriggeringStackLeader}..."

msgid "STORY_EVENT@1122_132@BODY_HEADER"
msgstr "{TriggeringStackLeader} encontra o Cavaleiro Prateado ainda guardando a {EventStructure}. O Cavaleiro gesticula em direção a uma espada de duelo cravada em um tronco de árvore."

msgid "STORY_EVENT@1122_132@BODY_HEADER@PLAYERLEADER_=_S"
msgstr "Você encontra o Cavaleiro Prateado ainda guardando a {EventStructure}. O Cavaleiro gesticula em direção a uma espada de duelo cravada em um tronco de árvore."

msgid "STORY_EVENT@1122_132@BODY_LORE"
msgstr "O Cavaleiro Prateado permanece firme, com <<o:EventStackLeader>> mãos apoiadas nas guardas da cruz de <<o:EventStackLeader>> arma enquanto <<p:EventStackLeader>> avalia a destreza marcial de {TriggeringStackLeader}. Uma companhia de <<m:EventUnit>> uivantes aparece do {GLOBAL.AstralVoidLoreConcept.Hyperlink}, flanqueando o {EventStackLeader}, seu capitão. A voz do Cavaleiro ressoa como um chifre estéril: \"Você pode passar... depois de me derrotar.\" <<Cp:EventStackLeader>> avança, convidando {TriggeringStackLeader} a fazer o mesmo."

msgid "STORY_EVENT@1122_132@BODY_LORE@PLAYERLEADER_=_S"
msgstr "O Cavaleiro Prateado permanece firme, com <<o:EventStackLeader>> mãos apoiadas nas guardas da cruz de <<o:EventStackLeader>> arma enquanto <<p:EventStackLeader>> avalia sua destreza marcial. Uma companhia de <<m:EventUnit>> uivantes aparece do Vazio, flanqueando o {EventStackLeader}, seu capitão. A voz do Cavaleiro ressoa como um chifre estéril: \"Você pode passar... depois de me derrotar.\" <<Cp:EventStackLeader>> avança, convidando você a fazer o mesmo."

msgid "STORY_EVENT@1122_132@BUTTON_0"
msgstr "... assume a postura de arado para desviar a ponta do Cavaleiro com <<o:TriggeringStackLeader>> espada e..."

msgid "STORY_EVENT@1122_132@BUTTON_0@PLAYERLEADER_=_S"
msgstr "... assume a postura de arado para desviar a ponta do Cavaleiro com sua espada e..."

msgid "STORY_EVENT@1122_132@BUTTON_1"
msgstr "... ataca com fúria a espada do Cavaleiro com um golpe súbito, mas decisivo, e..."

msgid "STORY_EVENT@1122_132@BUTTON_1@PLAYERLEADER_=_S"
msgstr "... ataca com fúria a espada do Cavaleiro com um golpe súbito, mas decisivo, e..."

msgid "STORY_EVENT@1122_132@BUTTON_2"
msgstr "... finge um contra-ataque, esquiva enquanto deixa cair <<o:TriggeringStackLeader>> espada e..."

msgid "STORY_EVENT@1122_132@BUTTON_2@PLAYERLEADER_=_S"
msgstr "... finge um contra-ataque, esquiva enquanto deixa cair sua espada e..."

msgid "STORY_EVENT@1122_132@BUTTON_3"
msgstr "... recua taticamente para <<o:TriggeringStackLeader>> tropas atrás de <<P:TriggeringStackLeader>>. Prepare-se para a batalha!"

msgid "STORY_EVENT@1122_132@BUTTON_3@PLAYERLEADER_=_S"
msgstr "... recua taticamente para suas tropas atrás de você. Prepare-se para a batalha!"

msgid "STORY_EVENT@1122_132@BUTTON_4"
msgstr "... vira-se e foge da {EventStructure}. O Cavaleiro e <<o:EventStackLeader>> <<m:EventUnit>> zombam da fuga de <<o:TriggeringStackLeader>>."

msgid "STORY_EVENT@1122_132@BUTTON_4@PLAYERLEADER_=_S"
msgstr "... vira-se e foge da {EventStructure}. O Cavaleiro e <<o:EventStackLeader>> <<m:EventUnit>> zombam da sua fuga."

msgid "STORY_EVENT@1122_132@TITLE"
msgstr "Encontrando o Cavaleiro Prateado"

msgid "STORY_EVENT@1122_133@BODY_FOOTER"
msgstr "A vitória de hoje traz glória ao Império de {PlayerLeader.TitleName}! Logo antes do Cavaleiro Prateado explodir em estrelas, você reivindica a..."

msgid "STORY_EVENT@1122_133@BODY_FOOTER@PLAYERLEADER_=_S"
msgstr "A vitória de hoje traz glória ao seu Império! Logo antes do Cavaleiro Prateado explodir em estrelas, você reivindica a..."

msgid "STORY_EVENT@1122_133@BODY_HEADER"
msgstr "Quando o {EventKnight} é derrotado, ele cai no chão. Morto... mas então se levanta novamente! Os lamentáveis <<m:EventMinion>> desaparecem."

msgid "STORY_EVENT@1122_133@BODY_LORE"
msgstr "\"Finalmente, um oponente digno,\" declara o Cavaleiro Prateado. \"Eu te saúdo. Canções serão cantadas sobre sua vitória hoje.\" O {EventKnight} estremece. \"No entanto, eu emito este aviso: quando eu for permitido retornar um dia, buscarei retribuição.\" O Cavaleiro Prateado aperta a empunhadura de sua espada. \"Agora deixarei este reino. Selecione uma de minhas armaduras como sua lembrança.\""

msgid "STORY_EVENT@1122_133@BUTTON_0"
msgstr "...ornado {EventItemA} [item/] como seu troféu."

msgid "STORY_EVENT@1122_133@BUTTON_1"
msgstr "...equilibrado {EventItemB} [item/] como seu troféu."

msgid "STORY_EVENT@1122_133@BUTTON_3"
msgstr "...resistente {EventItemC} [item/] como seu troféu."

msgid "STORY_EVENT@1122_133@BUTTON_4"
msgstr "...flexível {EventItemD} [item/] como seu troféu."

msgid "STORY_EVENT@1122_133@TITLE"
msgstr "O Cavaleiro Prateado: Consequências"

msgid "STORY_EVENT@1122_164@BODY_FOOTER"
msgstr "{EventHouseLord} suspira solenemente. \"Você salvou minha cidade e povo de uma ruína iminente. Como podemos retribuir?\""

msgid "STORY_EVENT@1122_164@BODY_HEADER"
msgstr "\"Acabei de receber relatórios de nossos agricultores.\" {EventHouseLord.TitleName} cumprimenta você com um sorriso. \"O cerco acabou! Os terríveis <<m:EventUnit>> foram eliminados!\""

msgid "STORY_EVENT@1122_164@BODY_LORE"
msgstr "O aliviado {EventHouseLord.Title} olha para as terras distantes. \"Com o tempo, podemos reassentar aquelas terras devastadas novamente. Mas aprendi minha lição. Não devemos interferir nos dons que a natureza nos apresenta. Seremos mais cuidadosos com os riscos de nossas práticas de cultivo.\""

msgid "STORY_EVENT@1122_164@BUTTON_0"
msgstr "\"Metade de seus rendimentos de colheita [food/] parece justo para mim.\""

msgid "STORY_EVENT@1122_164@BUTTON_1"
msgstr "\"Trate {EventCity} [happiness/] com uma carroça daquelas Bagas de Pressa que você criou.\""

msgid "STORY_EVENT@1122_164@BUTTON_3"
msgstr "\"Não interfira com a Natureza, {EventHouseLord.TitleName}. Ela já possui tudo o que você precisa para prosperar [natureboon/].\""

msgid "STORY_EVENT@1122_164@BUTTON_4"
msgstr "\"Preciso de reforços [unitprod/] depois de cuidar de sua bagunça. Espero seu apoio.\""

msgid "STORY_EVENT@1122_164@BUTTON_5"
msgstr "\"Explique-me como você criou essa nova variante de Baga de Pressa [knowledge/]\""

msgid "STORY_EVENT@1122_164@TITLE"
msgstr "<<m:EventUnit>> Vorazes: Consequências"

msgid "STORY_EVENT@1122_165@BODY_FOOTER"
msgstr "\"As bestas logo inundarão nossas terras! Nos falta o poder militar para repeli-las.\" {EventHouseLord} inclina <<o:EventHouseLord>> a cabeça. \"{PlayerLeader.Title}. Por favor. Ajude!\""

msgid "STORY_EVENT@1122_165@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} de {EventHouse} entra em contato com você com os olhos arregalados e em pânico! \"Poderoso {PlayerLeader.TitleName}, eu imploro, salve nosso povo de uma infestação de <<m:EventUnit>>!\""

msgid "STORY_EVENT@1122_165@BODY_LORE"
msgstr "Ficamos extasiados quando cultivamos uma nova variedade de Baga de Pressa. Extra cheia e suculenta, significativamente mais doce do que o tipo original que cresce nos campos e florestas. Deliciamo-nos com os néctares frutados que suas flores secretam. Mas esse mesmo perfume amaldiçoado atraiu a horda de {EventUnit} vorazes!\""

msgid "STORY_EVENT@1122_165@BUTTON_0"
msgstr "\"Deixe isso comigo. Minhas poderosas forças destruirão o {EventSpawner}!\""

msgid "STORY_EVENT@1122_165@BUTTON_2"
msgstr "\"Você criou essa situação, {EventHouseLord.Title}. Salvar seu povo é sua responsabilidade.\""

msgid "STORY_EVENT@1122_165@BUTTON_3"
msgstr "\"Você precisa de um exército melhor. Meus treinadores [unitprod/] estão ao seu serviço.\""

msgid "STORY_EVENT@1122_165@BUTTON_4"
msgstr "\"Você não é capaz de governar, {EventHouseLord.TitleName}. Seu povo merece um governador competente!\""

msgid "STORY_EVENT@1122_165@TITLE"
msgstr "<<m:EventUnit>> Vorazes"

msgid "STORY_EVENT@1122_197@BODY_FOOTER"
msgstr "O {RandomWarriorTitle} próximo busca lançar você na luz. Eles merecem ser submetidos ao seu poder terrível."

msgid "STORY_EVENT@1122_197@BODY_HEADER"
msgstr "Contos de seus negócios com {GLOBAL.ShadowConcept} viajam longe. Uma companhia de paladinos destemidos proclama que irão derrubá-lo."

msgid "STORY_EVENT@1122_197@BODY_LORE"
msgstr "Os zelosos {RandomWarriorTitle} do {RandomIdol} estão sempre ansiosos para vencer uma manifestação da Sombra em seu reino. A companhia, liderada por um {EventStackLeader}, não se importa nem mesmo com o grau de ameaça que você representa para as terras e seu povo. Você é simplesmente um meio de trazer honra e títulos para seus nomes."

msgid "STORY_EVENT@1122_197@BUTTON_0"
msgstr "\"Eles são bem-vindos no meu domínio das trevas. Bem-vindos para morrer.\""

msgid "STORY_EVENT@1122_197@BUTTON_1"
msgstr "\"Como se esses tolos zelosos pudessem navegar no meu reino das sombras. Ignore-os.\""

msgid "STORY_EVENT@1122_197@BUTTON_2"
msgstr "\"Bugigangas douradas [gold/] convencerão seu comandante {EventStackLeader} a se juntar [unit/] ao meu exército [shadowcrisis/].\""

msgid "STORY_EVENT@1122_197@TITLE"
msgstr "Devorando a Luz"

msgid "STORY_EVENT@1122_198@BODY_FOOTER"
msgstr "Tudo o que resta fazer agora é decidir como utilizar os corpos moribundos dos zelotes excessivamente confiantes."

msgid "STORY_EVENT@1122_198@BODY_HEADER"
msgstr "Os {RandomWarriorTitle} do {RandomIdol} não foram páreo para seu poder sombrio e jazem mortalmente feridos aos pés de suas tropas."

msgid "STORY_EVENT@1122_198@BODY_LORE"
msgstr "Você garantiu que nem todos os paladinos fossem mortos imediatamente, pensando à frente como sua mente astuta está acostumada a fazer. Corpos frescos e {GLOBAL.SoulsLoreConcept.Hyperlink} são difíceis de adquirir, então quando os cordeiros se levam ao abate, você faz uso eficiente da oportunidade. A sinfonia de estertores de morte que sobe dos corpos imóveis é um testemunho do seu sucesso."

msgid "STORY_EVENT@1122_198@BUTTON_0"
msgstr "Alimente [food/] os seguidores profanos em {EventCity}."

msgid "STORY_EVENT@1122_198@BUTTON_1"
msgstr "Extraia os segredos [knowledge/] de seus cérebros moribundos."

msgid "STORY_EVENT@1122_198@BUTTON_3"
msgstr "Colete rapidamente suas almas [souls/] antes que entrem na vida após a morte."

msgid "STORY_EVENT@1122_198@BUTTON_4"
msgstr "Erga alguns {RandomWarriorTitle} para servirem a você como <<m:EventUnit>> [unit/]."

msgid "STORY_EVENT@1122_198@TITLE"
msgstr "Devorando a Luz: Consequências"

msgid "STORY_EVENT@1122_223@BODY_FOOTER"
msgstr "{EventHero} pretende espelhar a generosidade que você demonstra. No entanto, <<p:EventHero>> estará gastando seu ouro."

msgid "STORY_EVENT@1122_223@BODY_FOOTER@NO_GOVERNOR"
msgstr "O povo de {EventCity} pretende espelhar a generosidade que você demonstra. No entanto, {EventCity} estará gastando seu ouro."

msgid "STORY_EVENT@1122_223@BODY_HEADER"
msgstr "Seus conselheiros mencionam que {EventCity} anunciou planos custosos para importar comida. Você entra em contato com seu <<G:governor^n,EventCity>>, {EventHero}."

msgid "STORY_EVENT@1122_223@BODY_HEADER@NO_GOVERNOR"
msgstr "Seus conselheiros mencionam que {EventCity} anunciou planos custosos para importar comida. Você entra em contato com a cidade."

msgid "STORY_EVENT@1122_223@BODY_LORE"
msgstr "{EventHero} recebe você de bom humor. \"Eu sei o que você quer discutir, meu {PlayerLeader.Title}. E você pode se orgulhar. Seguindo seus decretos [hyperlink,GLOBAL.AlignmentConcept]benevolentes[/hyperlink], eu declarei a importação de carnes e produtos abundantes para os cidadãos famintos de {EventCity}! A melhor parte? A cidade está pagando por tudo!\""

msgid "STORY_EVENT@1122_223@BODY_LORE@NO_GOVERNOR"
msgstr "Um administrador de {EventCity} recebe você de bom humor. \"Eu sei o que você quer discutir, meu {PlayerLeader.Title}. E você pode se orgulhar. Seguindo seus decretos benevolentes, {EventCity} declarou a importação de carnes e produtos abundantes para nossos cidadãos famintos! A melhor parte? A cidade está pagando por tudo!\""

msgid "STORY_EVENT@1122_223@BUTTON_0"
msgstr "Aprovar os planos [food/]. Ouro [gold/] não compra felicidade [happiness/]."

msgid "STORY_EVENT@1122_223@BUTTON_1"
msgstr "Gaste ainda mais fundos [gold/] de {EventCity} em comida [food/] [goodact/]!"

msgid "STORY_EVENT@1122_223@BUTTON_2"
msgstr "Proíba isso. {EventCity} deve se conformar aos seus decretos [happiness/]."

msgid "STORY_EVENT@1122_223@BUTTON_3"
msgstr "\"Sem contribuições coletivas [gold/] de cidadãos dedicados, nosso império não pode se expandir.\""

msgid "STORY_EVENT@1122_223@BUTTON_4"
msgstr "Taxe {EventCity} mais [gold/] em vez disso. Este é o seu reino [evilact/]!"

msgid "STORY_EVENT@1122_223@TITLE"
msgstr "O Bem Maior"

msgid "STORY_EVENT@1122_224@BODY_FOOTER"
msgstr "\"Desejamos nos estabelecer perto de {EventCity}.\" Os cidadãos de {EventCity} são notoriamente desconfiados de pessoas de {EventHouse}."

msgid "STORY_EVENT@1122_224@BODY_HEADER"
msgstr "Um emissário representando um grupo de refugiados da cidade livre de {EventHouse} se aproxima de você."

msgid "STORY_EVENT@1122_224@BODY_LORE"
msgstr "\"Boas novas para você, ó [hyperlink,GLOBAL.AlignmentConcept]Misericordioso[/hyperlink] {PlayerLeader.Title}! Fugimos de nossa cidade natal, {EventHouse}, libertando-nos do jugo cruel de {EventHouseLord.TitleName}.\" O emissário ajoelha-se diante de você. \"Como não podíamos mais suportar viver lá, buscamos asilo em suas belas terras, entre seu povo compassivo.\""

msgid "STORY_EVENT@1122_224@BUTTON_0"
msgstr "Construa [structureprod/] um vilarejo para os refugiados [goodact/], longe de {EventCity}."

msgid "STORY_EVENT@1122_224@BUTTON_1"
msgstr "Desafie {EventHouse} [goodact/]. Migrate os refugiados para {EventCity} [population/], apesar dos protestos [happiness/]."

msgid "STORY_EVENT@1122_224@BUTTON_2"
msgstr "Envie os refugiados embora [evilact/]. Os problemas deles não podem incomodar {EventCity} [happiness/]."

msgid "STORY_EVENT@1122_224@BUTTON_3"
msgstr "Remova <<G:memories^p,EventHouseLord>> dos refugiados, assim libertando-os [goodact/]."

msgid "STORY_EVENT@1122_224@BUTTON_4"
msgstr "Envie uma mensagem para {EventHouseLord} para vender [gold/] <<P:EventHouseLord>> a localização dos refugiados. [evilact/]"

msgid "STORY_EVENT@1122_224@TITLE"
msgstr "Refúgio Seguro"

msgid "STORY_EVENT@1122_225@BODY_FOOTER"
msgstr "\"É hora de expressarmos nossa gratidão,\" proclama {EventHouseLord.FirstName}. \"Escolha qualquer bênção que possamos oferecer.\""

msgid "STORY_EVENT@1122_225@BODY_HEADER"
msgstr "Seus aliados se reuniram para honrar suas [hyperlink,GLOBAL.AlignmentConcept]benevolentes[/hyperlink] contribuições para o reino."

msgid "STORY_EVENT@1122_225@BODY_LORE"
msgstr "{EventHouseLord.TitleName} de {EventHouse} lidera a assembleia. \"Gracioso {PlayerLeader.Title}, um propósito singular nos reúne aqui. Todos aqui se beneficiaram de um de seus favores, boas ações ou atos de apoio. De fato, alguns de nós teriam caído diante daqueles que servem ao mal, se você não fosse tão altruísta e heroico.\" Seus aliados se curvam diante de você em uníssono."

msgid "STORY_EVENT@1122_225@BUTTON_0"
msgstr "\"Peça que seus melhores comandantes treinem [unitprod/] minhas tropas em {EventCity}.\""

msgid "STORY_EVENT@1122_225@BUTTON_1"
msgstr "\"Conceda-me três de seus <<m:EventUnit>> [unit/].\""

msgid "STORY_EVENT@1122_225@BUTTON_2"
msgstr "\"Ensine-me um segredo místico que melhore minhas habilidades de governar.\""

msgid "STORY_EVENT@1122_225@BUTTON_3"
msgstr "\"Apresente-me suas percepções sobre a arte de governar [influence/].\""

msgid "STORY_EVENT@1122_225@BUTTON_4"
msgstr "\"Meus amigos, nossa amizade é sua própria recompensa!\""

msgid "STORY_EVENT@1122_225@TITLE"
msgstr "Para Aqueles que Esperam"

msgid "STORY_EVENT@1122_226@BODY_FOOTER"
msgstr "Enquanto seus guerreiros começam a pisotear os comerciantes, você considera suas ações. Eles estão apenas ecoando sua liderança?"

msgid "STORY_EVENT@1122_226@BODY_HEADER"
msgstr "Alguns de seus <<m:EventUnit>> supostamente capturaram viajantes vendendo mercadorias insignificantes. Seus guerreiros provam ser guardas de prisioneiros cruéis."

msgid "STORY_EVENT@1122_226@BODY_LORE"
msgstr "Desesperados, os comerciantes capturados puxam suas correntes e imploram a seus captores por liberdade. Ao ver sua chegada, eles se jogam no chão para suplicar. Um de seus <<m:EventUnit>> ri e grita: \"Você acha que nosso {PlayerLeader.Title} vai salvar vocês? <<Cp:PlayerLeader>> fez coisas mais [hyperlink,GLOBAL.AlignmentConcept]hediondas[/hyperlink] a homens melhores do que vocês!\""

msgid "STORY_EVENT@1122_226@BUTTON_0"
msgstr "Coloque os comerciantes no pelourinho para <<G:entertainment^n,EventCity>> [happiness/]."

msgid "STORY_EVENT@1122_226@BUTTON_1"
msgstr "Incentive [morale/] seus <<m:EventUnit>> a chutar os comerciantes com mais força [evilact/]."

msgid "STORY_EVENT@1122_226@BUTTON_2"
msgstr "Venda [gold/] os miseráveis comerciantes para traficantes de escravos estrangeiros [evilact/]."

msgid "STORY_EVENT@1122_226@BUTTON_3"
msgstr "Sacrifique [evilact/] os comerciantes capturados para extrair suas almas [souls/]."

msgid "STORY_EVENT@1122_226@BUTTON_4"
msgstr "Liberte [goodact/] os comerciantes e compense-os pelo mau trato [gold/]."

msgid "STORY_EVENT@1122_226@TITLE"
msgstr "Pecados do {PlayerLeader.Title}"

msgid "STORY_EVENT@1122_227@BODY_FOOTER"
msgstr "\"Para purificar estas terras da sua presença, declaramos GUERRA contra você!\" O arauto aguarda sua resposta com desdém."

msgid "STORY_EVENT@1122_227@BODY_HEADER"
msgstr "Um arauto insolente da cidade livre de {EventHouse} interrompe seus [hyperlink,GLOBAL.AlignmentConcept]pensamentos sombrios[/hyperlink], aqui para entregar uma mensagem de seu {EventHouseLord.Title}."

msgid "STORY_EVENT@1122_227@BODY_LORE"
msgstr "O mensageiro limpa a garganta: \"O Povo de {EventHouse} e seu {EventHouseLord.Title} o renunciam, ó desprezível {PlayerLeader.TitleName}. Nós nos levantamos contra seu domínio maligno. Que possamos conquistar sua cidade do trono, arrasar suas cidades e exterminar seus servos malignos... pelo bem e benefício de todo o reino!\""

msgid "STORY_EVENT@1122_227@BUTTON_0"
msgstr "Prepare seus guardas para a batalha [morale/]. O arauto retorna a {EventHouse}."

msgid "STORY_EVENT@1122_227@BUTTON_1"
msgstr "Jure [influence/] que destruirá {EventHouse}."

msgid "STORY_EVENT@1122_227@BUTTON_2"
msgstr "Envie a cabeça do mensageiro para {EventHouse} como sua resposta."

msgid "STORY_EVENT@1122_227@BUTTON_3"
msgstr "Pague [gold/] um tributo [influence/] para {EventHouseLord.TitleName} para evitar a guerra."

msgid "STORY_EVENT@1122_227@TITLE"
msgstr "Quebrando a Aurora"

msgid "STORY_EVENT@1122_228@BODY_FOOTER"
msgstr "Seu sacrifício eleito aumentará seu poder. Mas qual recipiente será o alvo da sua malícia?"

msgid "STORY_EVENT@1122_228@BODY_HEADER"
msgstr "Você encarna [hyperlink,GLOBAL.AlignmentConcept]malignidade[/hyperlink]. No entanto, sua ambição insaciável já o faz trabalhar em seu próximo esquema."

msgid "STORY_EVENT@1122_228@BODY_LORE"
msgstr "Reis temem pronunciar seu nome. Mães advertem suas crianças travessas sobre você. Mas não é suficiente. Você recentemente aprendeu sobre os antigos Males Primordiais, que lançaram as sombras mais longas e escuras da história. Eles ligaram sua malícia a animais, objetos, até mesmo servos. Um ritual hediondo que exige grande sacrifício."

msgid "STORY_EVENT@1122_228@BUTTON_0"
msgstr "[nature/] Gere uma terrível {EventMount} [mount/] do seu sangue perverso."

msgid "STORY_EVENT@1122_228@BUTTON_1"
msgstr "[matter/] Forje um precioso {EventItem} [item/] no qual você derrama sua malevolência."

msgid "STORY_EVENT@1122_228@BUTTON_2"
msgstr "[arcana/] Devore a própria essência da magia [mana/] para ganhar poder arcano."

msgid "STORY_EVENT@1122_228@BUTTON_3"
msgstr "Alimente [population/] sua maldade com a energia caótica de {EventCity} [chaosboon/]."

msgid "STORY_EVENT@1122_228@BUTTON_4"
msgstr "Queime [population/] seus súditos obedientes em {EventCity} para sua malevolência tirânica [orderboon/]."

msgid "STORY_EVENT@1122_228@BUTTON_5"
msgstr "[shadow/] Unja [souls/] um {EventUnit} [unit/] para ser seu Arauto do Terror!"

msgid "STORY_EVENT@1122_228@BUTTON_6"
msgstr "Aumente {EventHeroMin.FirstName}, seu Mestre do Medo, com o sangue de <<G:young^n,EventCity>> [unitprod/]."

msgid "STORY_EVENT@1122_228@BUTTON_7"
msgstr "Sacrifique [unit/] {EventHeroMin.FirstName} o Patético para fazer de {EventHeroMax.FirstName} seu Campeão da Malícia."

msgid "STORY_EVENT@1122_228@BUTTON_8"
msgstr "Consuma [unit/] {EventHeroMin.FirstName} o Patético para aumentar seu próprio poder."

msgid "STORY_EVENT@1122_228@BUTTON_9"
msgstr "Não faça nada. Seu mal já é insuperável."

msgid "STORY_EVENT@1122_228@TITLE"
msgstr "Mal Primordial"

msgid "STORY_EVENT@1122_229@BODY_FOOTER"
msgstr "O viajante treme; <<o:EventHero>> morte iminente. <<Cp:EventHero>> sussurra: \"Por favor, ajude. Eu sou {EventHero}, <<EventHero{filho/filha}>> de {EventHouseLord}\". Como você agirá?"

msgid "STORY_EVENT@1122_229@BODY_HEADER"
msgstr "Um viajante pede sua ajuda. <<Cp:EventHero>> foi espancado e deixado para morrer. <<Co:EventHero>> sotaque trai <<o:EventHero>> origem {EventHouse}."

msgid "STORY_EVENT@1122_229@BODY_LORE"
msgstr "O {EventHouseLord.Title} de {EventHouse}, {EventHouseLord.Name}, e você estão em guerra. Parece que este viajante foi pego na estrada por seus guerreiros e prontamente maltratado."

msgid "STORY_EVENT@1122_229@BUTTON_0"
msgstr "Contrate [gold/] médicos de {EventCity} [unitprod/] para salvar <<G:a vida^n,EventHero>> [goodact/]."

msgid "STORY_EVENT@1122_229@BUTTON_1"
msgstr "Cuide [food/] do <<EventHero{filho/filha}>> de seu inimigo de volta à saúde [goodact/] como prisioneiro."

msgid "STORY_EVENT@1122_229@BUTTON_2"
msgstr "Ignore {EventHero} [evilact/]. Seus servos eventualmente trazem <<o:EventHero>> corpo frio."

msgid "STORY_EVENT@1122_229@BUTTON_3"
msgstr "Decapite [evilact/] {EventHero} e envie <<o:EventHero>> cabeça de volta para {EventHouseLord} [morale/]."

msgid "STORY_EVENT@1122_229@TITLE"
msgstr "Cores Verdadeiras"

msgid "STORY_EVENT@1122_233@BODY_FOOTER"
msgstr "Não importa o que o futuro reserve, {EnemyPlayerLeader} não será mais um espinho no seu lado. Como você comemorará esta vitória extraordinária?"

msgid "STORY_EVENT@1122_233@BODY_HEADER"
msgstr "Você destruiu as últimas defesas de {EnemyPlayerLeader} e lançou <<P:EnemyPlayerLeader>> no {GLOBAL.AstralVoidLoreConcept.Hyperlink}, banindo <<P:EnemyPlayerLeader>> deste reino."

msgid "STORY_EVENT@1122_233@BODY_LORE"
msgstr "Quaisquer esquemas que {EnemyPlayerLeader} tivesse em andamento, nenhum deles chegará à fruição. Os últimos das tropas <<o:EnemyPlayerLeader>> mal orientadas fogem para se esconder nas colinas e florestas. <<Co:EnemyPlayerLeader>> {EventRace}, seus espíritos esmagados pelo jugo de seu falso ídolo, agora se encontram à sua mercê, ó glorioso {PlayerLeader.Title}!"

msgid "STORY_EVENT@1122_233@BUTTON_0"
msgstr "Realize um desfile para celebrar seu triunfo [influence/]! Não poupe despesas [gold/]!"

msgid "STORY_EVENT@1122_233@BUTTON_1"
msgstr "Manipule [evilact/] o zelo desvanecente [order/] de {EnemyPlayerLeader} para conjurar ouro divino [gold/]."

msgid "STORY_EVENT@1122_233@BUTTON_2"
msgstr "Aproveite [evilact/] a sede de sangue desvanecente [chaos/] de {EnemyPlayerLeader} para aumentar sua banda de guerra [unitprod/]."

msgid "STORY_EVENT@1122_233@BUTTON_3"
msgstr "Solidifique [evilact/] a sintonia mágica desvanecente [arcana/] de {EnemyPlayerLeader} em cristais de mana [mana/]."

msgid "STORY_EVENT@1122_233@BUTTON_4"
msgstr "Aplique [evilact/] o artesanato desvanecente [matter/] de {EnemyPlayerLeader} para fazer {EventCity} se elevar [structureprod/]."

msgid "STORY_EVENT@1122_233@BUTTON_5"
msgstr "Drene [evilact/] a fertilidade desvanecente [nature/] de {EnemyPlayerLeader} para aumentar a colheita [food/]."

msgid "STORY_EVENT@1122_233@BUTTON_6"
msgstr "Extraia [evilact/] os segredos desvanecentes [shadow/] de {EnemyPlayerLeader} para aprender lendas indizíveis [knowledge/]."

msgid "STORY_EVENT@1122_233@BUTTON_7"
msgstr "Guie espiritualmente [mana/] {EnemyPlayerLeader} para Magehaven [goodact/]."

msgid "STORY_EVENT@1122_233@BUTTON_8"
msgstr "Deixe o momento passar. {EnemyPlayerLeader} foi apenas um pequeno inconveniente para você."

msgid "STORY_EVENT@1122_233@TITLE"
msgstr "Celebrando a derrota de {EnemyPlayerLeader}"

msgid "STORY_EVENT@1122_235@BODY_FOOTER"
msgstr "O povo de {EventHouseB.Name} oferece ajuda por ouro em sua guerra contra {EventHouse.Name}."

msgid "STORY_EVENT@1122_235@BODY_HEADER"
msgstr "{EventHouseBLord.TitleName} de {EventHouseB.Name} oferece <<o:EventHouseBLord>> ajuda durante sua guerra com {EventHouse.Name}."

msgid "STORY_EVENT@1122_235@BODY_LORE"
msgstr "\"A guerra é verdadeiramente um momento difícil, grande {PlayerLeader.Name}, não é? Nós humildemente, e com apenas o menor vestígio de autointeresse, oferecemos a você a ajuda que temos disponível. Por um preço igualmente humilde, é claro.\""

msgid "STORY_EVENT@1122_235@BUTTON_0"
msgstr "Compre [gold/] tropas [unit/] de {EventHouseB.Name}."

msgid "STORY_EVENT@1122_235@BUTTON_1"
msgstr "\"Você irá nos ajudar voluntariamente [unit/], em honra [influence/] da minha majestade.\""

msgid "STORY_EVENT@1122_235@BUTTON_2"
msgstr "Rejeitar a oferta deles."

msgid "STORY_EVENT@1122_235@TITLE"
msgstr "Aproveitador de Guerra"

msgid "STORY_EVENT@1122_236@BODY_FOOTER"
msgstr "\"O que você diz? Você irá admitir a derrota e trazer paz para nossos reinos?\""

msgid "STORY_EVENT@1122_236@BODY_HEADER"
msgstr "Seu inimigo, {EventHouseLord.TitleName} de {EventHouse.Name}, oferece arrogantemente uma chance de rendição."

msgid "STORY_EVENT@1122_236@BODY_LORE"
msgstr "\"A guerra é uma coisa terrível, {PlayerLeader.Name}, duas vezes pior quando você a perde! Minhas tropas estão se aproximando da sua cidade. Você se saiu bem, mas talvez seja hora de acabar com isso. Vamos poupar nossos povos de mais derramamento de sangue.\""

msgid "STORY_EVENT@1122_236@BUTTON_0"
msgstr "\"Eu... concordo. [influence/]\""

msgid "STORY_EVENT@1122_236@BUTTON_1"
msgstr "\"Concordar? Nós ainda nem começamos a lutar!\""

msgid "STORY_EVENT@1122_236@BUTTON_2"
msgstr "\"Perdendo? Eu só estava esperando os cadáveres se acumularem!\""

msgid "STORY_EVENT@1122_236@BUTTON_3"
msgstr "\"Eu invocarei a terra para ajudar seu verdadeiro mestre!\""

msgid "STORY_EVENT@1122_236@TITLE"
msgstr "Uma Última Chance"

msgid "STORY_EVENT@1122_237@BODY_FOOTER"
msgstr "\"Por favor, termine esta guerra com {EventHouseBLord}. Caso contrário... bem, esta tentativa de mediação cumpriu meu dever.\""

msgid "STORY_EVENT@1122_237@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} de {EventHouse.Name} se aproxima, com um ar de exasperação cansada sobre <<P:EventHouseLord>>."

msgid "STORY_EVENT@1122_237@BODY_LORE"
msgstr "\"Eu desejo um favor humilde, poderoso {PlayerLeader.Name}. Você está em guerra com {EventHouseBLord.Name} de {EventHouseB}, que acontece ser meu <<EventHouseBLord{cunhado/cunhada}>>... Não pergunte, é uma história estranha. {EventHouseB} é improvável que vença contra um {PlayerLeader.Title} como você. Mesmo que vença, suas perdas serão grandes. Minha honra familiar dita que eu tente salvar meu <<EventHouseBLord{cunhado/cunhada}>>.\""

msgid "STORY_EVENT@1122_237@BUTTON_0"
msgstr "\"Não. Mas sua família em breve terá um tolo a menos!\""

msgid "STORY_EVENT@1122_237@BUTTON_1"
msgstr "\"Não é um pedido muito sincero. Mas você me comoveu mesmo assim. [goodact/]\""

msgid "STORY_EVENT@1122_237@BUTTON_2"
msgstr "\"Eu me tornarei famoso [influence/] por derrotar toda a sua família! [evilact/]\""

msgid "STORY_EVENT@1122_237@TITLE"
msgstr "Obrigação Familiar"

msgid "STORY_EVENT@1122_238@BODY_FOOTER"
msgstr "\"Como um Governante para outro... se renda! Eu imploro...\""

msgid "STORY_EVENT@1122_238@BODY_HEADER"
msgstr "Seu inimigo, {EventHouseLord.TitleName} de {EventHouse.Name}, se aproxima. Uma fina camada de orgulho falha em esconder <<o:EventHouseLord>> o desespero óbvio."

msgid "STORY_EVENT@1122_238@BODY_LORE"
msgstr "\"{PlayerLeader.Name}, estamos em guerra. Pode ir de qualquer jeito. Para você, poderoso {PlayerLeader.Title}, isso seria apenas mais uma marca na sua mesa de guerra. Para mim, isso significaria mais. Na verdade, eu temo que meus súditos estejam perdendo a fé em mim como seu {EventHouseLord.Title}. Em nossa cultura, isso tem... consequências letais!\""

msgid "STORY_EVENT@1122_238@BUTTON_0"
msgstr "\"Não. Volte e coloque seus assuntos em ordem.\""

msgid "STORY_EVENT@1122_238@BUTTON_1"
msgstr "\"Esta guerra é trivial para mim. Muito bem. Reivindique sua vitória. [goodact/]\""

msgid "STORY_EVENT@1122_238@BUTTON_2"
msgstr "\"Naturalmente... depois que você adoçar o acordo [gold/].\""

msgid "STORY_EVENT@1122_238@BUTTON_3"
msgstr "\"Você é patético [influence/]. E todos de {EventHouse} saberão. [morale/]\""

msgid "STORY_EVENT@1122_238@TITLE"
msgstr "Renda-se! Por favor?"

msgid "STORY_EVENT@1122_240@BODY_FOOTER"
msgstr "\"Meu {PlayerLeader.Title}, sua saga precisa incluir quem você era antes de se tornar um {GLOBAL.GodirLoreConcept.Hyperlink}.\" O que você pode dizer ao escriba?"

msgid "STORY_EVENT@1122_240@BODY_HEADER"
msgstr "\"Meu {PlayerLeader.Title}? Você se lembra?\" As palavras do jovem escriba o surpreendem enquanto você recorda sua vida anterior."

msgid "STORY_EVENT@1122_240@BODY_LORE"
msgstr "Sua pergunta direta faz sua mente regressar a tempos mais simples. Quando você era mortal, sonhando sonhos modestos, perseguindo ambições mundanas. Para ascender, você teve que sacrificar tantos apegos mundanos. Sacrifícios que o fizeram parar de olhar para trás. Que o fizeram esquecer. Apenas memórias vagas do que você era antes permanecem."

msgid "STORY_EVENT@1122_240@BUTTON_0"
msgstr "\"[matter/] Eu construí baluartes [structureprod/] para nos proteger dos Reis-Feiticeiros invasores!\""

msgid "STORY_EVENT@1122_240@BUTTON_1"
msgstr "\"[nature/] Eu criei uma família [population/] em paz quando os Reis-Feiticeiros invadiram.\""

msgid "STORY_EVENT@1122_240@BUTTON_2"
msgstr "\"[chaos/] Eu incitei minha tribo [unitprod/] a saquear os Reis-Feiticeiros invasores!\""

msgid "STORY_EVENT@1122_240@BUTTON_3"
msgstr "\"[order/] Eu defendi [influence/] meus vassalos contra os Reis-Feiticeiros invasores.\""

msgid "STORY_EVENT@1122_240@BUTTON_4"
msgstr "\"[arcana/] Eu extraí poder [mana/] da sintonia Astral dos Reis-Feiticeiros invasores.\""

msgid "STORY_EVENT@1122_240@BUTTON_5"
msgstr "\"[shadow/] Eu repeli Reis-Feiticeiros invasores usando servos [unitprod/] e lores sombrios [knowledge/].\""

msgid "STORY_EVENT@1122_240@BUTTON_6"
msgstr "\"Eu unifiquei todos os povos sob um único estandarte. O meu [unit/].\""

msgid "STORY_EVENT@1122_240@BUTTON_7"
msgstr "\"Eu pesquisei terras férteis nas quais nossa tribo prosperou [food/].\""

msgid "STORY_EVENT@1122_240@BUTTON_8"
msgstr "\"Eu era um estudante de lores obscuros [knowledge/].\""

msgid "STORY_EVENT@1122_240@BUTTON_9"
msgstr "\"Eu era um pacificador, amigável [happiness/] com todos os povos que viviam em nosso reino.\""

msgid "STORY_EVENT@1122_240@TITLE"
msgstr "Origens Humildes"

msgid "STORY_EVENT@1122_241@BODY_FOOTER"
msgstr "Na escuridão, você tinha apenas uma coisa para se agarrar, um pedaço de quem você era antes. Que memória preservou sua sanidade?"

msgid "STORY_EVENT@1122_241@BODY_HEADER"
msgstr "Como um {GLOBAL.WizardKingLoreConcept.Hyperlink}, você viu o {GLOBAL.AstralVoidLoreConcept.Hyperlink}, e memórias disso o assombram. Mesmo agora, você encontra sua mente voltando a isso."

msgid "STORY_EVENT@1122_241@BODY_LORE"
msgstr "Você é [hyperlink,GLOBAL.ShadowTrialLoreConcept]assombrado[/hyperlink] por séculos solitários flutuando no vasto nada do Vazio, onde vozes monstruosas do seu passado torceram e distorceram suas convicções mais profundas. Você viu visões de um futuro sombrio repleto de perda e insanidade. Mais de uma vez, sentiu sua alma se dissolver no vazio sem fim."

msgid "STORY_EVENT@1122_241@BUTTON_0"
msgstr "\"Eu fundei impérios [influence/] que impressionaram Feiticeiros e Reis!\""

msgid "STORY_EVENT@1122_241@BUTTON_1"
msgstr "\"Eu dominei o lores proibidos e perdidos [knowledge/]!\""

msgid "STORY_EVENT@1122_241@BUTTON_2"
msgstr "\"[order/] Eu comandei legiões de paladinos fervorosos [unit/]!\""

msgid "STORY_EVENT@1122_241@BUTTON_3"
msgstr "\"[chaos/] Eu gerei [population/] uma hoste de servos selvagens!\""

msgid "STORY_EVENT@1122_241@BUTTON_4"
msgstr "\"[arcana/] Eu era um artista do arcano [mana/]!\""

msgid "STORY_EVENT@1122_241@BUTTON_5"
msgstr "\"[matter/] Eu criei tesouros inigualáveis [gold/] invejados por dragões.\""

msgid "STORY_EVENT@1122_241@BUTTON_6"
msgstr "\"[nature/] Eu cuidei de plantas e bestas, e saboreei seus frutos [food/].\""

msgid "STORY_EVENT@1122_241@BUTTON_7"
msgstr "\"[shadow/] Eu remodelava [unitprod/] meus súditos nas sombras sem fim!\""

msgid "STORY_EVENT@1122_241@BUTTON_8"
msgstr "\"Mortais frágeis se deleitavam [happiness/] com meu esplendor!\""

msgid "STORY_EVENT@1122_241@BUTTON_9"
msgstr "\"Eu erguia [structureprod/] Torres do Feiticeiro em reinos infinitos!\""

msgid "STORY_EVENT@1122_241@TITLE"
msgstr "Ecos do Vazio"

msgid "STORY_EVENT@1122_242@BODY_FOOTER"
msgstr "Os {EventRace} de {EventCity} se reuniram em grande número para saudar seu novo {PlayerLeader.Title}."

msgid "STORY_EVENT@1122_242@BODY_HEADER"
msgstr "{EventCity} ficou convencida de que apenas você lidera o caminho para a glória, ó {PlayerLeader.Title}. Seus {EventRace} se juntam ao seu império."

msgid "STORY_EVENT@1122_242@BODY_LORE"
msgstr "A partir deste dia, você guia <<g:development^n,EventCity>>. Seus {EventRace} produzem alegremente o que você solicitar e se estabelecem nas províncias que preferir. Você pode designar um de seus [hyperlink,GLOBAL.HeroConcept]Heróis[/hyperlink] como seu {GLOBAL.GovernorConcept} para alterar a eficácia da sua produção de recursos. Por fim, a cidade depende de você para defender a próspera {EventCity} quando saqueadores aparecerem."

msgid "STORY_EVENT@1122_242@BUTTON_0"
msgstr "Inspecione {EventCity}."

msgid "STORY_EVENT@1122_242@BUTTON_1"
msgstr "Instrua {EventCity} sobre como se governar."

msgid "STORY_EVENT@1122_242@BUTTON_2"
msgstr "\"Bem-vindo ao meu império.\""

msgid "STORY_EVENT@1122_242@TITLE"
msgstr "Seu império recebe {EventCity}"

msgid "STORY_EVENT@1122_243@BODY_FOOTER"
msgstr "Você deve se sair melhor contra seus rivais do que o caído {DefeatedPlayer.Title} conseguiu."

msgid "STORY_EVENT@1122_243@BODY_HEADER"
msgstr "Uma rajada de rumores troveja pelo reino. \"{DefeatedPlayer} foi derrotado! O império de <<Co:DefeatedPlayer>> jaz em ruínas!\""

msgid "STORY_EVENT@1122_243@BODY_LORE"
msgstr "Para melhor ou pior, o banimento de {DefeatedPlayer.TitleName} deixou um vácuo neste mundo. Felizmente, vácuo e oportunidade são a mesma coisa nos assuntos do {GLOBAL.GodirLoreConcept.Hyperlink}."

msgid "STORY_EVENT@1122_243@BUTTON_0"
msgstr "Envie algumas esmolas [gold/] aos {DefeatedRace} abandonados por compaixão [goodact/]."

msgid "STORY_EVENT@1122_243@BUTTON_1"
msgstr "Confisque o ouro [gold/] de <<g:population^n,DefeatedPlayer>> enquanto fogem [evilact/]."

msgid "STORY_EVENT@1122_243@BUTTON_2"
msgstr "\"Era apenas uma questão de tempo.\""

msgid "STORY_EVENT@1122_243@TITLE"
msgstr "{DefeatedPlayer} banido para o Vazio"

msgid "STORY_EVENT@1122_244@BODY_FOOTER"
msgstr "Um guerreiro de {EventHouse.Name} pergunta sobre as intenções do seu exército dentro de seu domínio."

msgid "STORY_EVENT@1122_244@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Um guerreiro de {EventHouse.Name} pergunta sobre suas intenções dentro de seu domínio."

msgid "STORY_EVENT@1122_244@BODY_HEADER"
msgstr "Um grupo de guerreiros endurecidos sai das sombras ao redor de {EventStructure.Name}."

msgid "STORY_EVENT@1122_244@BODY_LORE"
msgstr "\"Salve, viajante. Você percorre as terras de {EventHouse.Name}. Estas terras são nossas por direito de sangue e cinzas, reclamadas ao longo de eras de tumulto. Por qual direito e razão você cruza nossas fronteiras?\""

msgid "STORY_EVENT@1122_244@BUTTON_1"
msgstr "\"Buscamos audiência com seu líder, {EventHouseLord.TitleName}.\""

msgid "STORY_EVENT@1122_244@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"Busco audiência com seu líder, {EventHouseLord.TitleName}.\""

msgid "STORY_EVENT@1122_244@BUTTON_2"
msgstr "\"Pelo direito e razão da conquista! Preparem-se!\""

msgid "STORY_EVENT@1122_244@BUTTON_3"
msgstr "\"Paz, guerreiro. Não queremos te causar nenhum mal.\""

msgid "STORY_EVENT@1122_244@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "\"Paz, guerreiro. Não quero te causar nenhum mal.\""

msgid "STORY_EVENT@1122_244@TITLE"
msgstr "Terras Ancestrais"

msgid "STORY_EVENT@1122_245@BODY_FOOTER"
msgstr "Seguindo um toque, o globo de luz flutuante aguarda sua resposta."

msgid "STORY_EVENT@1122_245@BODY_HEADER"
msgstr "Enquanto seu exército chega a {EventStructure.Name}, um estranho globo translúcido surge do chão. Uma voz oca emana dele."

msgid "STORY_EVENT@1122_245@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Ao chegar a {EventStructure.Name}, um estranho globo translúcido surge do chão. Uma voz oca emana dele."

msgid "STORY_EVENT@1122_245@BODY_LORE"
msgstr "\"Bem-vindo às terras de {EventHouse.Name}. {EventHouseLord.TitleName} pergunta sobre a natureza da sua intenção neste local. Por favor, deixe sua resposta após o toque. Note que respostas incorretas podem levar à convocação de guardiões próximos.\""

msgid "STORY_EVENT@1122_245@BUTTON_1"
msgstr "\"Na verdade, desejamos falar com {EventHouseLord.TitleName}.\""

msgid "STORY_EVENT@1122_245@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"Na verdade, desejo falar com {EventHouseLord.TitleName}.\""

msgid "STORY_EVENT@1122_245@BUTTON_2"
msgstr "\"Convoque seus guardiões, globo. Estamos aqui para lutar!\""

msgid "STORY_EVENT@1122_245@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "\"Convoque seus guardiões, globo. Estou aqui para lutar!\""

msgid "STORY_EVENT@1122_245@BUTTON_3"
msgstr "\"Informe a {EventHouseLord.TitleName} que estamos apenas passando por aqui.\""

msgid "STORY_EVENT@1122_245@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "\"Informe a {EventHouseLord.TitleName} que estou apenas passando por aqui.\""

msgid "STORY_EVENT@1122_245@TITLE"
msgstr "O Mensageiro"

msgid "STORY_EVENT@1122_246@BODY_FOOTER"
msgstr "Após um toque, silêncio... A luz pulsante do globo confere uma atmosfera assustadora enquanto ele aguarda."

msgid "STORY_EVENT@1122_246@BODY_HEADER"
msgstr "Um globo translúcido, pulsando uma cor sinistra, surge do chão e fala com seu exército em tons ocos."

msgid "STORY_EVENT@1122_246@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Um globo translúcido, pulsando uma cor sinistra, surge do chão e fala com seu exército em tons ocos."

msgid "STORY_EVENT@1122_246@BODY_LORE"
msgstr "\"Você está invadindo as terras de {EventHouse.Name}. {EventHouseLord.TitleName} convocou guardiões para este local. Você pode deixar sua resposta após o toque.\""

msgid "STORY_EVENT@1122_246@BUTTON_1"
msgstr "\"Gostaríamos de conversar com {EventHouseLord.TitleName}.\""

msgid "STORY_EVENT@1122_246@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"Gostaria de conversar com {EventHouseLord.TitleName}.\""

msgid "STORY_EVENT@1122_246@BUTTON_2"
msgstr "Empunhe suas armas e aguarde os guardiões..."

msgid "STORY_EVENT@1122_246@BUTTON_3"
msgstr "Não diga nada e vá embora."

msgid "STORY_EVENT@1122_246@TITLE"
msgstr "O Mensageiro Ameaçador"

msgid "STORY_EVENT@1122_247@BODY_FOOTER"
msgstr "O rosto de pedra de {EventStackLeader.Name} repousa a mão em sua arma, aguardando sua resposta."

msgid "STORY_EVENT@1122_247@BODY_HEADER"
msgstr "Seu exército é recebido por um grupo de bárbaros armados ao se aproximar do {EventStructure.Name}."

msgid "STORY_EVENT@1122_247@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você é recebido por um grupo de bárbaros armados ao se aproximar da {EventStructure.Name}."

msgid "STORY_EVENT@1122_247@BODY_LORE"
msgstr "\"Salve, {EventHero}. Você é conhecido por nós e não é bem-vindo aqui. No entanto, {EventHouse.Name} oferece um presente. O presente é este aviso. Permaneça aqui e enfrentará nossa ira.\""

msgid "STORY_EVENT@1122_247@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "\"Salve, {PlayerLeader.TitleName}. Você é conhecido por nós e não é bem-vindo aqui. No entanto, {EventHouse.Name} oferece um presente. O presente é este aviso. Permaneça aqui e enfrentará nossa ira.\""

msgid "STORY_EVENT@1122_247@BUTTON_1"
msgstr "\"Paz, guerreiro. Desejamos conversar com seu {EventHouseLord.Title}.\""

msgid "STORY_EVENT@1122_247@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"Paz, guerreiro. Desejo conversar com seu {EventHouseLord.Title}.\""

msgid "STORY_EVENT@1122_247@BUTTON_2"
msgstr "\"Seu desafio é aceito. Às armas!\""

msgid "STORY_EVENT@1122_247@BUTTON_3"
msgstr "\"Descanse tranquilo, {EventStackLeader}. Não buscamos briga e iremos embora.\""

msgid "STORY_EVENT@1122_247@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "\"Descanse tranquilo, {EventStackLeader}. Não busco briga e irei embora.\""

msgid "STORY_EVENT@1122_247@TITLE"
msgstr "Um Aviso Generoso"

msgid "STORY_EVENT@1122_248@BODY_FOOTER"
msgstr "O {EventStackLeader}, com intenção aparentemente clara, aguarda sua resposta."

msgid "STORY_EVENT@1122_248@BODY_HEADER"
msgstr "Um {EventStackLeader} de aparência estoica e sombria bloqueia o caminho do seu exército para {EventStructure.Name}."

msgid "STORY_EVENT@1122_248@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Um {EventStackLeader} de aparência estoica e sombria bloqueia seu caminho para {EventStructure.Name}."

msgid "STORY_EVENT@1122_248@BODY_LORE"
msgstr "\"O {EventStackLeader} não diz uma palavra, mas se levanta quando você se aproxima. Vários homens e mulheres armados relaxam por perto, observando <<P:EventStackLeader>>. À medida que seu exército se aproxima, o {EventStackLeader} levanta <<o:EventStackLeader>> mão. Você nota que os guardas em repouso ficam em posição de atenção.\""

msgid "STORY_EVENT@1122_248@BUTTON_1"
msgstr "\"Paz, bom <<EventStackLeader{Sir/Dame}>>. Buscamos uma audiência com seu {EventHouseLord.Title}.\""

msgid "STORY_EVENT@1122_248@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"Paz, bom <<EventStackLeader{Sir/Dame}>>. Busco uma audiência com seu {EventHouseLord.Title}.\""

msgid "STORY_EVENT@1122_248@BUTTON_2"
msgstr "Sem dizer nada, avance e empunhe suas armas."

msgid "STORY_EVENT@1122_248@BUTTON_3"
msgstr "Sem dizer nada, afaste-se."

msgid "STORY_EVENT@1122_248@TITLE"
msgstr "Cavaleiro Silencioso"

msgid "STORY_EVENT@1122_249@BODY_FOOTER"
msgstr "O {EventStackLeader} olha fixamente, com a mão no cabo de <<o:EventStackLeader>> arma, aguardando sua resposta."

msgid "STORY_EVENT@1122_249@BODY_HEADER"
msgstr "À medida que seu exército se aproxima de {EventStructure.Name}, eles são abordados por um {EventStackLeader} com aparência irritada e um número de tropas."

msgid "STORY_EVENT@1122_249@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "À medida que você se aproxima de {EventStructure.Name}, é abordado por um {EventStackLeader} com aparência irritada e um número de tropas."

msgid "STORY_EVENT@1122_249@BODY_LORE"
msgstr "\"Você tem muita audácia, aproximando-se das terras de {EventHouse.Name}. {EventHouseLord.TitleName} deixou claros seus sentimentos em relação ao seu reino. Minha ira será temperada pelo meu código por apenas um momento. Você tem uma chance de se retirar.\""

msgid "STORY_EVENT@1122_249@BUTTON_1"
msgstr "\"Buscamos uma audiência com seu {EventHouseLord.Title}.\""

msgid "STORY_EVENT@1122_249@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"Busco uma audiência com seu {EventHouseLord.Title}.\""

msgid "STORY_EVENT@1122_249@BUTTON_2"
msgstr "\"Guarde seu código. Empunhe sua arma!\""

msgid "STORY_EVENT@1122_249@BUTTON_3"
msgstr "\"Não buscamos conflitos hoje. Adeus...\""

msgid "STORY_EVENT@1122_249@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "\"Não busco conflitos hoje. Adeus...\""

msgid "STORY_EVENT@1122_249@TITLE"
msgstr "Um Cavaleiro Tempestuoso"

msgid "STORY_EVENT@1122_250@BODY_FOOTER"
msgstr "{EventHero} nota tropas de {EventHouse.Name} aguardando a resposta de <<o:EventHero>> à aparição esquelética."

msgid "STORY_EVENT@1122_250@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Você nota tropas de {EventHouse.Name} aguardando sua resposta à aparição esquelética."

msgid "STORY_EVENT@1122_250@BODY_HEADER"
msgstr "Uma pequena pilha de ossos desconexos se anima e se dirige às suas tropas enquanto elas se aproximam de {EventStructure.Name}."

msgid "STORY_EVENT@1122_250@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Uma pequena pilha de ossos desconexos se anima e se dirige a você enquanto se aproxima de {EventStructure.Name}."

msgid "STORY_EVENT@1122_250@BODY_LORE"
msgstr "O mensageiro esquelético, composto de ossos quebrados e comidos pelo musgo, e mais parecido com uma aranha do que com uma pessoa, levanta uma mão esquelética para virar seu crânio sorridente em direção a {EventHero}. Com uma voz oca, semelhante a uma tampa de cripta sendo arrastada, pergunta: \"P-p-por que você t-tressspassa?\""

msgid "STORY_EVENT@1122_250@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "O mensageiro esquelético, composto de ossos quebrados e comidos pelo musgo, e mais parecido com uma aranha do que com uma pessoa, levanta uma mão esquelética para virar seu crânio sorridente em sua direção. Com uma voz oca, semelhante a uma tampa de cripta sendo arrastada, pergunta: \"P-p-por que você t-tressspassa?\""

msgid "STORY_EVENT@1122_250@BUTTON_1"
msgstr "\"Gostaria de falar com seu <<EventHouseLord{senhor/senhora}>>.\""

msgid "STORY_EVENT@1122_250@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"Gostaria de falar com seu <<EventHouseLord{senhor/senhora}>>.\""

msgid "STORY_EVENT@1122_250@BUTTON_2"
msgstr "\"Mate todos eles!\""

msgid "STORY_EVENT@1122_250@BUTTON_3"
msgstr "\"Isso é muito estranho... vamos embora!\""

msgid "STORY_EVENT@1122_250@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "\"Isso é muito estranho... vou embora!\""

msgid "STORY_EVENT@1122_250@TITLE"
msgstr "Mensagem do Além"

msgid "STORY_EVENT@1122_251@BODY_FOOTER"
msgstr "As sombras balançam, aproximando-se, dando ao seu exército uma janela muito pequena para responder."

msgid "STORY_EVENT@1122_251@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "As sombras balançam, aproximando-se, dando a você uma janela muito pequena para responder."

msgid "STORY_EVENT@1122_251@BODY_HEADER"
msgstr "Enquanto suas tropas se aproximam de {EventStructure.Name}, as sombras parecem se alongar e cercá-las."

msgid "STORY_EVENT@1122_251@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Enquanto você se aproxima de {EventStructure.Name}, as sombras parecem se alongar e cercá-lo."

msgid "STORY_EVENT@1122_251@BODY_LORE"
msgstr "As sombras ganham membros e olhos brilhantes. Quando falam, soam como o assobio de mil serpentes. \"{EventHouseLord.TitleName} declarou você um inimigo de {EventHouse.Name}. Saia deste lugar ou pereça. Guardiõesss foram invocados.\""

msgid "STORY_EVENT@1122_251@BUTTON_1"
msgstr "\"Invoca teu <<EventHouseLord{senhor/senhora}>>, sombra. Queremos falar com <<P:EventHouseLord>>.\""

msgid "STORY_EVENT@1122_251@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"Invoca teu <<EventHouseLord{senhor/senhora}>>, sombra. Quero falar com <<P:EventHouseLord>>.\""

msgid "STORY_EVENT@1122_251@BUTTON_2"
msgstr "\"É você quem perecerá... Às armas!\""

msgid "STORY_EVENT@1122_251@BUTTON_3"
msgstr "\"Permaneça na escuridão, sombra. Vamos embora...\""

msgid "STORY_EVENT@1122_251@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "\"Permaneça na escuridão, sombra. Eu irei embora...\""

msgid "STORY_EVENT@1122_251@TITLE"
msgstr "Sentinelas Sombrias"

msgid "STORY_EVENT@1122_252@BODY_FOOTER"
msgstr "\"Espero que seus motivos sejam pacíficos. Seria uma pena se rebaixar comportando-se de outra forma.\""

msgid "STORY_EVENT@1122_252@BODY_HEADER"
msgstr "Suas tropas veem um grupo de tropas de {EventHouse.Name} desfrutando de finos alimentos, engajados em profundas discussões filosóficas."

msgid "STORY_EVENT@1122_252@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você vê um grupo de tropas de {EventHouse.Name} desfrutando de finos alimentos, engajados em profundas discussões filosóficas."

msgid "STORY_EVENT@1122_252@BODY_LORE"
msgstr "\"Ah, {EventHero.Name}, é um prazer vê-lo. Por favor, desfrute de nossa comida e bebida. Junte-se ao nosso salão. Você é bem-vindo em nossas terras.\" O {EventStackLeader} sorri e gentilmente gesticula em direção aos seus compatriotas. \"Mas devo perguntar... o que o traz aqui hoje? Você não estava programado para se encontrar com {EventHouseLord.TitleName} ou com as pessoas de {EventHouse.Name}.\""

msgid "STORY_EVENT@1122_252@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "\"Ah, {PlayerLeader.TitleName}, é um prazer vê-lo. Por favor, desfrute de nossa comida e bebida. Junte-se ao nosso salão. Você é bem-vindo em nossas terras.\" O {EventStack.Leader} sorri e gentilmente gesticula em direção aos seus compatriotas. \"Mas devo perguntar... o que o traz aqui hoje? Você não estava programado para se encontrar com {EventHouseLord.TitleName} ou com as pessoas de {EventHouse.Name}.\""

msgid "STORY_EVENT@1122_252@BUTTON_1"
msgstr "\"Paz, sim. Desejamos conversar com {EventHouseLord.TitleName}.\""

msgid "STORY_EVENT@1122_252@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"Paz, sim. Desejo conversar com {EventHouseLord.TitleName}.\""

msgid "STORY_EVENT@1122_252@BUTTON_2"
msgstr "\"Infelizmente para você. Esta festa será a sua última. Morra!\""

msgid "STORY_EVENT@1122_252@BUTTON_3"
msgstr "\"Aproveite suas festividades. Estaremos seguindo.\""

msgid "STORY_EVENT@1122_252@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "\"Aproveite suas festividades. Estarei seguindo.\""

msgid "STORY_EVENT@1122_252@TITLE"
msgstr "Alta Sociedade"

msgid "STORY_EVENT@1122_253@BODY_FOOTER"
msgstr "\"Devemos discutir as coisas como pessoas civilizadas, ou você vai nos decepcionar — embora não surpreender — escolhendo a violência?\""

msgid "STORY_EVENT@1122_253@BODY_HEADER"
msgstr "Um {EventStackLeader} de {EventHouse.Name} está sobre seu exército, imponente. <<Cp:EventStackLeader>> percebe seu exército e os olha com desdém, revirando <<o:EventStackLeader>> os olhos."

msgid "STORY_EVENT@1122_253@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Um {EventStackLeader} de {EventHouse.Name} está sobre seu exército, imponente. <<Cp:EventStackLeader>> percebe você e o olha com desdém, revirando <<o:EventStackLeader>> os olhos."

msgid "STORY_EVENT@1122_253@BODY_LORE"
msgstr "\"Vejo que vocês, mestiços, finalmente encontraram o caminho para nossas fronteiras,\" suspira o {EventStackLeader}. \"Embora todos os meus sentidos se contorçam com sua presença, admito que estou impressionado que vocês conseguiram tropeçar em direção a {EventHouse.Name}.\""

msgid "STORY_EVENT@1122_253@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "\"Vejo que seus mestiços finalmente encontraram o caminho para nossas fronteiras,\" suspira o {EventStack.Leader}. \"Embora todas as minhas sensibilidades se contorçam com sua presença, admito que estou impressionado que você conseguiu tropeçar em direção a {EventHouseCity.Name}.\""

msgid "STORY_EVENT@1122_253@BUTTON_1"
msgstr "\"Somos civilizados. Traga seu {EventHouseLord.Title}... por favor.\""

msgid "STORY_EVENT@1122_253@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"Sou civilizado. Traga seu {EventHouseLord.Title}... por favor.\""

msgid "STORY_EVENT@1122_253@BUTTON_2"
msgstr "\"Escolhemos a violência!\""

msgid "STORY_EVENT@1122_253@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "\"Escolho a violência!\""

msgid "STORY_EVENT@1122_253@BUTTON_3"
msgstr "\"Nenhum. Estamos apenas passando.\""

msgid "STORY_EVENT@1122_253@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "\"Nenhum. Estou apenas passando.\""

msgid "STORY_EVENT@1122_253@TITLE"
msgstr "Forai, Plebeu"

msgid "STORY_EVENT@1122_254@BODY_FOOTER"
msgstr "\"Se você deseja discutir coisas com {EventHouse.Name}, farei com que uma de minhas tropas alerte {EventHouseLord} imediatamente.\""

msgid "STORY_EVENT@1122_254@BODY_HEADER"
msgstr "Tropas de {EventHouse.Name} parecem estar minerando a {EventStructure.Name} em busca de materiais."

msgid "STORY_EVENT@1122_254@BODY_LORE"
msgstr "As tropas estão trabalhando tão diligentemente em suas tarefas que mal registram sua aproximação. Após alguns minutos observando sua eficiência, seu supervisor, um {EventStackLeader}, finalmente percebe seu exército. \"Minhas desculpas pela espera, {EventHero.Name}. Tendemos a mergulhar de cabeça em nosso trabalho aqui em {EventHouse.Name}. Francamente, não desejo me afastar por muito tempo.\""

msgid "STORY_EVENT@1122_254@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "As tropas estão trabalhando tão diligentemente em suas tarefas que mal registram sua aproximação. Após alguns minutos observando sua eficiência, seu supervisor, um {EventStackLeader}, finalmente percebe você. \"Minhas desculpas pela espera, {PlayerLeader.TitleName}. Tendemos a mergulhar de cabeça em nosso trabalho aqui em {EventHouse.Name}. Francamente, não desejo me afastar por muito tempo.\""

msgid "STORY_EVENT@1122_254@BUTTON_1"
msgstr "\"Sim, por favor. Gostaríamos de falar com {EventHouseLord}.\""

msgid "STORY_EVENT@1122_254@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"Sim, por favor. Eu gostaria de falar com {EventHouseLord}.\""

msgid "STORY_EVENT@1122_254@BUTTON_2"
msgstr "\"Agora vocês estarão ocupados lutando por suas vidas!\""

msgid "STORY_EVENT@1122_254@BUTTON_3"
msgstr "\"Continuem com seu trabalho. Estamos apenas passando por aqui.\""

msgid "STORY_EVENT@1122_254@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "\"Continuem com seu trabalho. Estou apenas passando por aqui.\""

msgid "STORY_EVENT@1122_254@TITLE"
msgstr "Abelhas Ocupadas"

msgid "STORY_EVENT@1122_255@BODY_FOOTER"
msgstr "\"É melhor que você nos tenha distraído por um bom motivo.\""

msgid "STORY_EVENT@1122_255@BODY_HEADER"
msgstr "Os soldados de {EventHouse.Name}, que estavam escavando a {EventStructure.Name}, param seu trabalho e agora olham feio para você."

msgid "STORY_EVENT@1122_255@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Os soldados de {EventHouse.Name}, que estavam escavando a {EventStructure.Name}, param seu trabalho e agora olham feio para suas tropas."

msgid "STORY_EVENT@1122_255@BODY_LORE"
msgstr "Um {EventStackLeader} se aproxima, mãos nos quadris, e solta um suspiro. \"Você não vê que estamos um pouco ocupados aqui? Sua intrusão indesejada pode me custar horas de produtividade.\""

msgid "STORY_EVENT@1122_255@BUTTON_1"
msgstr "\"Temos certeza de que falar com {EventHouseLord} conta como um bom motivo.\""

msgid "STORY_EVENT@1122_255@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"Tenho certeza de que falar com {EventHouseLord} conta como um bom motivo.\""

msgid "STORY_EVENT@1122_255@BUTTON_2"
msgstr "\"Este intervalo é, de fato, o seu último. Morram!\""

msgid "STORY_EVENT@1122_255@BUTTON_3"
msgstr "Deixe-os voltar ao trabalho."

msgid "STORY_EVENT@1122_255@TITLE"
msgstr "Ei, Estou Trabalhando Aqui!"

msgid "STORY_EVENT@1122_256@BODY_FOOTER"
msgstr "{EventStackLeader.Name} observa {EventHero.FirstName} impacientemente. \"Bem? O que vai ser? Estou ansioso para concluir nossa caçada!\""

msgid "STORY_EVENT@1122_256@BODY_HEADER"
msgstr "Um nobre menor e <<o:EventStackLeader>> comitiva quase não percebem seu exército, tão concentrados estão em perseguir algo dentro da {EventStructure.Name}."

msgid "STORY_EVENT@1122_256@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Um nobre menor e sua comitiva quase não percebem você, tão concentrados estão em perseguir algo dentro da {EventStructure.Name}."

msgid "STORY_EVENT@1122_256@BODY_LORE"
msgstr "{EventStackLeader.Name} se aproxima de {EventHero.Name} e fala em tom baixo. \"Bem encontrado! Acreditamos ter encurralado uma besta gloriosa aqui, um {RandomAnimal} muito elusivo! Peço que você vá embora e nos permita o que certamente será uma morte deliciosa para {EventHouse.Name}!\""

msgid "STORY_EVENT@1122_256@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "{EventStackLeader.Name} se aproxima de você e fala em tom baixo. \"Bem encontrado! Acreditamos ter encurralado uma besta gloriosa aqui, um {RandomAnimal} muito elusivo! Peço que você vá embora e nos permita o que certamente será uma morte deliciosa para {EventHouse.Name}!\""

msgid "STORY_EVENT@1122_256@BUTTON_1"
msgstr "\"Deixe este local e colete carne de veado de {EventCity} [food/] como compensação.\""

msgid "STORY_EVENT@1122_256@BUTTON_2"
msgstr "\"O nobre {RandomAnimal} está sob minha própria proteção. Saia deste lugar agora!\""

msgid "STORY_EVENT@1122_256@BUTTON_3"
msgstr "Teça uma ilusão. \"Olhe lá! A besta foge por ali!\""

msgid "STORY_EVENT@1122_256@BUTTON_4"
msgstr "\"Hoje a pena por caçar é a morte!\""

msgid "STORY_EVENT@1122_256@BUTTON_5"
msgstr "\"Não tenho tempo para suas distrações insignificantes. Adeus!\""

msgid "STORY_EVENT@1122_256@TITLE"
msgstr "A Presa"

msgid "STORY_EVENT@1122_260@BODY_FOOTER"
msgstr "O {EventStackLeader} sorri novamente. \"Você parece um conhecedor. Interessado em comprar nosso trabalho?\""

msgid "STORY_EVENT@1122_260@BODY_HEADER"
msgstr "Tropas de {EventHouse.Name} estão reunidas ao redor do {EventStructure}, empunhando o que parecem ser bolas de luz."

msgid "STORY_EVENT@1122_260@BODY_LORE"
msgstr "Os orbes são na verdade redemoinhos de magia artística. Eles formam figurinos coloridos e brilhantes. Um {EventStackLeader.Name} percebe <<G:gaze^n,EventHero>> e sorri. \"Obras-primas, não são? Com magia, libertamos esses espíritos do {EventStructure} para moldar estatuetas. Nosso trabalho não impressiona você?\""

msgid "STORY_EVENT@1122_260@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Os orbes são na verdade redemoinhos de magia artística. Eles formam figurinos coloridos e brilhantes. Um {EventStackLeader.Name} percebe seu olhar e sorri. \"Obras-primas, não são? Com magia, libertamos esses espíritos do {EventStructure} para moldar estatuetas. Nosso trabalho não impressiona você?\""

msgid "STORY_EVENT@1122_260@BUTTON_1"
msgstr "\"Nós compraremos [gold/] sua arte se vocês deixarem este lugar.\""

msgid "STORY_EVENT@1122_260@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"Eu comprarei [gold/] sua arte se vocês deixarem este lugar.\""

msgid "STORY_EVENT@1122_260@BUTTON_2"
msgstr "\"Se pudermos criar algo melhor, vocês devem abandonar o {EventStructure}.\""

msgid "STORY_EVENT@1122_260@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "\"Se eu puder criar algo melhor, vocês devem abandonar o {EventStructure}.\""

msgid "STORY_EVENT@1122_260@BUTTON_4"
msgstr "\"Nós vamos quebrar suas obras-primas e sua determinação!\""

msgid "STORY_EVENT@1122_260@BUTTON_4@HERO_IS_PLAYERLE"
msgstr "\"Eu vou quebrar suas obras-primas e sua determinação!\""

msgid "STORY_EVENT@1122_260@BUTTON_5"
msgstr "Deixe-os continuar moldando seus estranhos bonequinhos."

msgid "STORY_EVENT@1122_260@TITLE"
msgstr "Estatuetas Sobrenaturais"

msgid "STORY_EVENT@1122_261@BODY_FOOTER"
msgstr "\"Até que tenhamos levantado trabalhadores mortos-vivos suficientes,\" murmura o {EventStackLeader}, \"somos obrigados a permanecer aqui.\""

msgid "STORY_EVENT@1122_261@BODY_HEADER"
msgstr "Suas tropas se aproximam de um {EventStructure}, recebidas por um coro de cantos de uma legião de {EventHouse}."

msgid "STORY_EVENT@1122_261@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você se aproxima de um {EventStructure}, recebido por um coro de cantos de uma legião de {EventHouse}."

msgid "STORY_EVENT@1122_261@BODY_LORE"
msgstr "{EventHero.Name} testemunha dezenas de esqueletos reanimando ao som da incantação do exército. \"Mais trabalhadores para {EventHouse},\" seu comandante, um {EventStackLeader}, resmunga. \"Nós abandonaríamos este local para você, mas meu povo depende da força de trabalho fornecida pelos ossos sob esta terra.\""

msgid "STORY_EVENT@1122_261@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Você testemunha dezenas de esqueletos reanimando ao som da incantação do exército. \"Mais trabalhadores para {EventHouse},\" seu comandante, um {EventStackLeader}, resmunga. \"Nós abandonaríamos este local para você, mas meu povo depende da força de trabalho fornecida pelos ossos sob esta terra.\""

msgid "STORY_EVENT@1122_261@BUTTON_1"
msgstr "\"Saia agora e nós enviaremos trabalhadores de {EventCity}.\""

msgid "STORY_EVENT@1122_261@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"Saia agora e eu enviarei trabalhadores de {EventCity}.\""

msgid "STORY_EVENT@1122_261@BUTTON_3"
msgstr "\"Que tal nós levantarmos esses mortos para você?\""

msgid "STORY_EVENT@1122_261@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "\"Que tal eu levantar esses mortos para você?\""

msgid "STORY_EVENT@1122_261@BUTTON_4"
msgstr "\"Você pagará por essa desecração vil!\""

msgid "STORY_EVENT@1122_261@BUTTON_5"
msgstr "\"Continue. Não queremos envolvimento.\""

msgid "STORY_EVENT@1122_261@BUTTON_5@HERO_IS_PLAYERLE"
msgstr "\"Continue. Não quero envolvimento.\""

msgid "STORY_EVENT@1122_261@TITLE"
msgstr "Trabalhado até a Morte"

msgid "STORY_EVENT@1122_262@BODY_FOOTER"
msgstr "\"Role para salvar sua vida, {EventHero.Name}. Se você vencer, desapareceremos. Se perder... Bem...\""

msgid "STORY_EVENT@1122_262@BODY_HEADER"
msgstr "Vilões visgosos de {EventHouse.Name} estão jogando dados em um {EventStructure} que você se aproxima."

msgid "STORY_EVENT@1122_262@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Vilões visgosos de {EventHouse.Name} estão jogando dados em um {EventStructure} que suas tropas se aproximam."

msgid "STORY_EVENT@1122_262@BODY_LORE"
msgstr "Um {EventStackLeader} olha para o cadáver fresco de um {RandomUnit}, usando <<o:EventStackLeader>> manga para limpar o sangue do pobre coitado da adaga de <<o:EventStackLeader>>. <<Cp:EventStackLeader>> rosna quando <<p:EventStackLeader>> percebe {EventHero}. Então, <<p:EventStackLeader>> gesticula para um conjunto de dados de osso ensanguentado. <<Co:EventStackLeader>> a tripulação de canalhas gargalha em antecipação."

msgid "STORY_EVENT@1122_262@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Um {EventStackLeader} olha para o cadáver fresco de um {RandomUnit}, usando <<o:EventStackLeader>> manga para limpar o sangue do pobre coitado da adaga de <<o:EventStackLeader>>. <<Cp:EventStackLeader>> rosna quando <<p:EventStackLeader>> percebe você. Então, <<p:EventStackLeader>> gesticula para um conjunto de dados de osso ensanguentado. <<Co:EventStackLeader>> a tripulação de canalhas gargalha em antecipação."

msgid "STORY_EVENT@1122_262@BUTTON_1"
msgstr "\"Por que apostar quando você acabou de ganhar na loteria [gold/]. Agora, vá embora!\""

msgid "STORY_EVENT@1122_262@BUTTON_3"
msgstr "Manipule os dados para vencer."

msgid "STORY_EVENT@1122_262@BUTTON_4"
msgstr "\"Temo que sua sorte acabou!\""

msgid "STORY_EVENT@1122_262@BUTTON_5"
msgstr "\"Não vou testar minha sorte hoje.\""

msgid "STORY_EVENT@1122_262@BUTTON_6"
msgstr "O Caos é seu aliado. Role os dados."

msgid "STORY_EVENT@1122_262@TITLE"
msgstr "O Jogador"

msgid "STORY_EVENT@1122_264@BODY_FOOTER"
msgstr "O {EventStackLeader} olha para {EventHero} com exasperação. \"Perdoe nossa... ineficiência. Deixaremos este {EventStructure} para você assim que isso for resolvido.\""

msgid "STORY_EVENT@1122_264@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "O {EventStackLeader} olha para você com exasperação. \"Perdoe nossa... ineficiência. Deixaremos este {EventStructure} para você assim que isso for resolvido.\""

msgid "STORY_EVENT@1122_264@BODY_HEADER"
msgstr "Perto de um {EventStructure}, um grupo de {EventHouse.Name} está segurando ábacos e apontando para o chão enquanto discutem. Alto."

msgid "STORY_EVENT@1122_264@BODY_LORE"
msgstr "\"O ferro é mais prevalente neste setor, eu garanto\", grita um. \"Não, seu ignorante. Está claro que há mais ouro nesta terra\", grita outro. \"Nunca vamos conseguir ir para casa se vocês dois não pararem de discutir e se concentrarem!\" suplica seu supervisor, um {EventStackLeader}."

msgid "STORY_EVENT@1122_264@BUTTON_1"
msgstr "\"Vá. Mineiros [structureprod/] de {EventCity} compartilharão suas descobertas com você.\""

msgid "STORY_EVENT@1122_264@BUTTON_3"
msgstr "Use seu conhecimento de metais para resolver a discussão deles."

msgid "STORY_EVENT@1122_264@BUTTON_4"
msgstr "\"Se é ferro que você deseja, então prove nossas lâminas afiadas!\""

msgid "STORY_EVENT@1122_264@BUTTON_5"
msgstr "\"Posso retornar depois que você completar sua pesquisa.\""

msgid "STORY_EVENT@1122_264@BUTTON_5@HERO_IS_PLAYERLE"
msgstr "\"Posso retornar quando você completar sua pesquisa.\""

msgid "STORY_EVENT@1122_264@TITLE"
msgstr "Avaliação da Cena"

msgid "STORY_EVENT@1122_265@BODY_FOOTER"
msgstr "O {EventStackLeader} rosna para {EventHero}, \"Este encantamento eu não consigo desfazer. Ajude-nos, e seguiremos nosso caminho.\""

msgid "STORY_EVENT@1122_265@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "O {EventStackLeader} rosna para você, \"Este encantamento eu não consigo desfazer. Ajude-nos, e seguiremos nosso caminho.\""

msgid "STORY_EVENT@1122_265@BODY_HEADER"
msgstr "Orbes brilhantes circulam o {EventStructure.Name}, refratando a luz de uma máquina imponente nas cores de {EventHouse}."

msgid "STORY_EVENT@1122_265@BODY_LORE"
msgstr "\"Você consegue desprender isso, ou há lama demais?\" Um trabalhador de {EventHouse.Name} pergunta ao seu superior. O {EventStackLeader} balança <<o:EventStackLeader>> cabeça. \"A lama não é o problema. É o {EventStructure}! A magia maligna que flui dele aprisionou nossa escavadeira! A menos que o feitiço possa ser temperado, não podemos terminar nosso trabalho!\""

msgid "STORY_EVENT@1122_265@BUTTON_1"
msgstr "\"Nossos magos [mana/] libertarão seu equipamento.\""

msgid "STORY_EVENT@1122_265@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"Meus magos [mana/] libertarão seu equipamento.\""

msgid "STORY_EVENT@1122_265@BUTTON_3"
msgstr "\"Eu mesmo dissiparei o encantamento.\""

msgid "STORY_EVENT@1122_265@BUTTON_4"
msgstr "\"Ha! Nada mais fácil de matar do que alvos estacionários!\""

msgid "STORY_EVENT@1122_265@BUTTON_5"
msgstr "Deseje-lhes sorte e siga em frente."

msgid "STORY_EVENT@1122_265@TITLE"
msgstr "Atolado"

msgid "STORY_EVENT@1122_266@BODY_FOOTER"
msgstr "\"Declare seu motivo para vir ao meu {EventStructure}\", pergunta {EventHouseLord}."

msgid "STORY_EVENT@1122_266@BODY_HEADER"
msgstr "Antes que você possa se aproximar de um exército de {EventHouse} que ocupa um {EventStructure}, seu {EventHouseLord.Title}, {EventHouseLord.Name}, entra em contato com você."

msgid "STORY_EVENT@1122_266@BODY_HEADER@STACKLEADER_IS_H"
msgstr "Antes que {EventHero} possa se aproximar de um exército de {EventHouse} que ocupa um {EventStructure}, seu {EventHouseLord.Title}, {EventHouseLord.Name}, entra em contato com você."

msgid "STORY_EVENT@1122_266@BODY_LORE"
msgstr "\"O que você quer com o meu <<m:EventStackLeader>>?\" {EventHouseLord.FirstName} avalia cuidadosamente seu exército para avaliar a situação. \"Eles guardam este {EventStructure} por minhas ordens.\" Os <<G:troops^p,EventHouseLord.Title>> observam nervosamente sua troca e parecem prontos para atacar se necessário."

msgid "STORY_EVENT@1122_266@BUTTON_0"
msgstr "\"Meu supremo império agora reivindica este {EventStructure} [influence/].\""

msgid "STORY_EVENT@1122_266@BUTTON_0@STACKLEADER_IS_H"
msgstr "\"<<G:empire^n,PlayerLeader>> agora reivindica este {EventStructure} [influence/].\""

msgid "STORY_EVENT@1122_266@BUTTON_2"
msgstr "Apelar para sua boa relação [allegiance/] com {EventHouse} para reivindicar o {EventStructure}."

msgid "STORY_EVENT@1122_266@BUTTON_3"
msgstr "Atacar o <<m:EventStackLeader>>!"

msgid "STORY_EVENT@1122_266@BUTTON_4"
msgstr "Partir."

msgid "STORY_EVENT@1122_266@TITLE"
msgstr "{EventStackLeader} Guardas de {EventHouse}"

msgid "STORY_EVENT@1122_267@BODY_FOOTER"
msgstr "\"Tenho quase certeza de que estas são nossas águas territoriais\", brada o {EventStackLeader} para {EventHero}. \"Sugiro que você retorne a águas mais seguras!\""

msgid "STORY_EVENT@1122_267@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "\"Tenho quase certeza de que estas são nossas águas territoriais\", brada o {EventStackLeader} para você. \"Sugiro que você retorne a águas mais seguras!\""

msgid "STORY_EVENT@1122_267@BODY_HEADER"
msgstr "\"Ahoy!\" Tropas de {EventHouse} estão espalhadas ao redor de um {EventStructure} cercado por águas profundas."

msgid "STORY_EVENT@1122_267@BODY_LORE"
msgstr "Com medo de escorregar e cair nas ondas tempestuosas, o regimento se agarra aos mastros de seus navios atracados ao redor do {EventStructure}. Todos, exceto seu líder, um {EventStackLeader}. <<Cp:EventStackLeader>> permanece alto, firme, inabalável. Um pilar imóvel no meio dos torrentes que buscam engolir <<P:EventStackLeader>>."

msgid "STORY_EVENT@1122_267@BUTTON_1"
msgstr "\"Solicitamos uma parley com {EventHouseLord.TitleName}!\""

msgid "STORY_EVENT@1122_267@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"Eu solicito uma parley com {EventHouseLord.TitleName}!\""

msgid "STORY_EVENT@1122_267@BUTTON_2"
msgstr "\"Nós vamos enviar você para uma cova d'água!\""

msgid "STORY_EVENT@1122_267@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "\"Eu vou enviar você para uma cova d'água!\""

msgid "STORY_EVENT@1122_267@BUTTON_3"
msgstr "Deriva para longe."

msgid "STORY_EVENT@1122_267@TITLE"
msgstr "Em Águas Estrangeiras"

msgid "STORY_EVENT@1122_268@BODY_FOOTER"
msgstr "\"Você aí!\" O {EventStackLeader} ri e acena. \"Você veio para nos entregar mais cider [food/]? Ou arrrr vocês são nosso reforço?\""

msgid "STORY_EVENT@1122_268@BODY_HEADER"
msgstr "Seu exército enfrentou as marés e correntes para alcançar uma {EventStructure}... para encontrar tropas de {EventHouse} já lá!"

msgid "STORY_EVENT@1122_268@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você enfrentou as marés e correntes para alcançar uma {EventStructure}... para encontrar tropas de {EventHouse} já lá!"

msgid "STORY_EVENT@1122_268@BODY_LORE"
msgstr "Uma frota de garrafas vazias recebe {EventHero}, carregada por ondas suaves. Em seguida, <<p:EventHero>> ouve os guardas cantando. Finalmente, <<p:EventHero>> avista a {EventStructure}, remodelada em um farol improvisado. Uma bandeira rasgada de {EventHouse} voa alto. Quem sabe há quanto tempo esses guerreiros estão estacionados aqui? Um {EventStackLeader} se aproxima e olha através de uma luneta."

msgid "STORY_EVENT@1122_268@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Uma frota de garrafas vazias recebe você, carregada por ondas suaves. Em seguida, você ouve os guardas cantando. Finalmente, você avista a {EventStructure}, remodelada em um farol improvisado. Uma bandeira rasgada de {EventHouse} voa alto. Quem sabe há quanto tempo esses guerreiros estão estacionados aqui? Um {EventStackLeader} se aproxima e olha através de uma luneta."

msgid "STORY_EVENT@1122_268@BUTTON_1"
msgstr "\"Navegue para {EventCity}! Eles vão te dar sua cider [food/]!\""

msgid "STORY_EVENT@1122_268@BUTTON_3"
msgstr "\"Nós viemos de {EventHouse} para relevá-lo de seu dever!\""

msgid "STORY_EVENT@1122_268@BUTTON_4"
msgstr "\"Esses guardas estão bêbados! Fácil de pegar!\""

msgid "STORY_EVENT@1122_268@BUTTON_5"
msgstr "Deixe os guardas em paz."

msgid "STORY_EVENT@1122_268@TITLE"
msgstr "Ilhamento Prolongado"

msgid "STORY_EVENT@1122_272@BODY_FOOTER"
msgstr "Os {EventRace} de {EventCity} se reúnem para ouvir atentamente as primeiras ordens de seu novo {PlayerLeader.Title}."

msgid "STORY_EVENT@1122_272@BODY_HEADER"
msgstr "Os {EventRace} de {EventCity} têm que aceitá-lo como seu {PlayerLeader.Title} e receber uma nova era sob seu governo."

msgid "STORY_EVENT@1122_272@BODY_LORE"
msgstr "A partir deste dia, você dirige <<g:development^n,EventCity>>. Seus {EventRace} produzem alegremente o que você solicitar e se estabelecem nas províncias que preferir. Você pode designar um de seus [hyperlink,GLOBAL.HeroConcept]Heróis[/hyperlink] como seu {GLOBAL.GovernorConcept} para alterar a efetividade de sua produção de recursos. Por fim, a cidade depende de você para defender a próspera {EventCity} quando saqueadores aparecerem."

msgid "STORY_EVENT@1122_272@BUTTON_0"
msgstr "Inspecione {EventCity}."

msgid "STORY_EVENT@1122_272@BUTTON_1"
msgstr "Instrua {EventCity} sobre como se governar."

msgid "STORY_EVENT@1122_272@BUTTON_2"
msgstr "\"Bem-vindo. Voltarei em outro momento.\""

msgid "STORY_EVENT@1122_272@TITLE"
msgstr "{EventCity} junta-se ao seu Império"

msgid "STORY_EVENT@1122_273@BODY_FOOTER"
msgstr "Os {EventRace} de {EventCity} aguardam nervosamente a inspeção e as primeiras ordens de seu novo {PlayerLeader.Title}."

msgid "STORY_EVENT@1122_273@BODY_HEADER"
msgstr "{EventCity} está completamente disfuncional. Felizmente, a maioria de seus cidadãos {EventRace} cessam seu protesto e reconhecem você como seu {PlayerLeader.Title}."

msgid "STORY_EVENT@1122_273@BODY_LORE"
msgstr "A partir deste dia, você dita <<g:development^n,EventCity>>. Seus {EventRace} produzem alegremente o que você solicitar e se estabelecem nas províncias que preferir. Você pode designar um de seus [hyperlink,GLOBAL.HeroConcept]Heróis[/hyperlink] como seu {GLOBAL.GovernorConcept} para alterar a efetividade de sua produção de recursos. Por fim, a cidade depende de você para defender a próspera {EventCity} quando saqueadores aparecerem."

msgid "STORY_EVENT@1122_273@BUTTON_0"
msgstr "Inspecionar {EventCity}."

msgid "STORY_EVENT@1122_273@BUTTON_1"
msgstr "Instrua {EventCity} sobre como se governar."

msgid "STORY_EVENT@1122_273@BUTTON_2"
msgstr "\"Volte ao trabalho! Assuntos mais importantes exigem minha atenção.\""

msgid "STORY_EVENT@1122_273@TITLE"
msgstr "Seu Império anexa {EventCity}."

msgid "STORY_EVENT@1122_285@BODY_FOOTER"
msgstr "O embaixador se curva profundamente. \"Você promete acalmar seus {EventRace} e vassalizar {EventHouse}?\""

msgid "STORY_EVENT@1122_285@BODY_HEADER"
msgstr "Um embaixador do Conselho {EventRace} se aproxima de você. <<Cp:EventUnit>> tem um sorriso tímido."

msgid "STORY_EVENT@1122_285@BODY_LORE"
msgstr "\"Meu {PlayerLeader.Title}. Nós do Conselho {EventRace} descobrimos que você está interessado em fortalecer os laços diplomáticos com {EventHouse}. Os {EventRace} têm uma longa história compartilhada com os {HouseRace} de {EventHouse}, e nós ficaremos felizes se você os considerar favoravelmente.\""

msgid "STORY_EVENT@1122_285@BUTTON_0"
msgstr "\"Esplêndido. Eu pretendia que eles se tornassem meus vassalos de qualquer maneira.\""

msgid "STORY_EVENT@1122_285@BUTTON_1"
msgstr "\"Honestamente, eu preferiria fazer amizade com {EventHouse} [allegiance/] do que com o Conselho {EventRace}.\""

msgid "STORY_EVENT@1122_285@BUTTON_2"
msgstr "\"Poupe-me de seus pedidos frívolos. Deixe-me em paz.\""

msgid "STORY_EVENT@1122_285@TITLE"
msgstr "Espíritos Afins"

msgid "STORY_EVENT@1122_286@BODY_FOOTER"
msgstr "\"Nossos novos vassalos estão ansiosos para visitar nossas cidades. Quem entre os {HouseRace} devemos convidar primeiro?\""

msgid "STORY_EVENT@1122_286@BODY_HEADER"
msgstr "Agora que seus laços diplomáticos com os {HouseRace} de {EventHouse} se desenvolveram, o embaixador do Conselho {EventRace} o visita novamente."

msgid "STORY_EVENT@1122_286@BODY_LORE"
msgstr "\"Sabíamos que você não nos decepcionaria, meu {PlayerLeader.Title}.\" As palavras do embaixador são acompanhadas por gestos amplos enquanto <<p:EventUnit>> sorri de orelha a orelha. \"Ficamos felizes em saber que seu império e {EventHouse} celebram seus interesses mútuos. E assim também os seus {EventRace} e seus {HouseRace}. Que nosso povo e cultura prosperem para sempre.\""

msgid "STORY_EVENT@1122_286@BUTTON_0"
msgstr "Convide seus cidadãos para mostrar nossas grandes obras e monumentos [happiness/]."

msgid "STORY_EVENT@1122_286@BUTTON_1"
msgstr "Convide seus comerciantes e mercadores [gold/] para visitar suas cidades."

msgid "STORY_EVENT@1122_286@BUTTON_3"
msgstr "Convide seus trabalhadores para suas cidades para aumentar a velocidade de construção [structureprod/]."

msgid "STORY_EVENT@1122_286@TITLE"
msgstr "Espíritos Afins: Consequências"

msgid "STORY_EVENT@1122_290@BODY_FOOTER"
msgstr "Os {EventRace} entrarão em pânico quando perceberem que <<m:EventStackLeader>> estão por perto! Rápido, ó {PlayerLeader.Title}, você deve despachá-los!"

msgid "STORY_EVENT@1122_290@BODY_HEADER"
msgstr "Um membro angustiado do Conselho {EventRace} solicita uma reunião urgente."

msgid "STORY_EVENT@1122_290@BODY_LORE"
msgstr "\"Notícias terríveis, meu {PlayerLeader.Title}. Nossos batedores relataram avistamentos de um exército de <<m:EventStackLeader>> vagando por nossas terras! Nossos antepassados contavam lendas sobre essas criaturas, que elas são portadoras de morte. E que ver tal criatura anuncia 77 anos de azar. Devemos afastá-la imediatamente, para evitar agitação em nossas cidades!\""

msgid "STORY_EVENT@1122_290@BUTTON_0"
msgstr "\"Não há necessidade de pânico. Eu cuidarei dos <<m:EventStackLeader>>.\""

msgid "STORY_EVENT@1122_290@BUTTON_1"
msgstr "\"Eduquem-se [knowledge/]. Crenças insensatas dos {EventRace} devem ser renunciadas!\""

msgid "STORY_EVENT@1122_290@BUTTON_2"
msgstr "\"Não tenho tempo para suas bobagens supersticiosas.\""

msgid "STORY_EVENT@1122_290@TITLE"
msgstr "Arautos da Desgraça"

msgid "STORY_EVENT@1122_292@BODY_FOOTER"
msgstr "O <<m:EventStackLeader>> notou suas tropas e está se preparando para atacar. O que você fará?"

msgid "STORY_EVENT@1122_292@BODY_HEADER"
msgstr "Após uma busca tensa e uma longa marcha, seu exército se depara com o <<m:EventStackLeader>>."

msgid "STORY_EVENT@1122_292@BODY_LORE"
msgstr "A visão das criaturas terríveis causa medo entre os {EventRace} em seu exército. O silêncio ensurdecedor traí a hesitação de suas tropas. Sua moral não vai aguentar."

msgid "STORY_EVENT@1122_292@BODY_LORE@NO_RACE_UNITS"
msgstr "\"Os uivos do <<m:EventUnit>> não afetam seus guerreiros. Na verdade, suas tropas não entendem o que os {EventRace} acham tão assustador nessas criaturas. Alguns começam a zombar do inimigo de longe.\""

msgid "STORY_EVENT@1122_292@BUTTON_0"
msgstr "Seus soldados não temem esses <<m:EventStackLeader>>. Ataque!"

msgid "STORY_EVENT@1122_292@BUTTON_1"
msgstr "Ordene que suas tropas desanimadas ataquem."

msgid "STORY_EVENT@1122_292@BUTTON_3"
msgstr "\"Uma recompensa [gold/] para quem me trouxer a cabeça de um {EventStackLeader}!\""

msgid "STORY_EVENT@1122_292@BUTTON_4"
msgstr "Tente banir essas criaturas de onde elas vieram."

msgid "STORY_EVENT@1122_292@BUTTON_5"
msgstr "Tente comandar essas criaturas para que retornem de onde vieram."

msgid "STORY_EVENT@1122_292@BUTTON_6"
msgstr "Partir. Agora não é o momento certo para atacar."

msgid "STORY_EVENT@1122_292@TITLE"
msgstr "Encontrando Arautos da Desgraça"

msgid "STORY_EVENT@1122_293@BODY_FOOTER"
msgstr "\"Os {EventRace} ouvirão falar de sua vitória. Talvez nossas crenças supersticiosas possam ser transformadas em uma virtude do nosso povo?\""

msgid "STORY_EVENT@1122_293@BODY_HEADER"
msgstr "Agora que os <<m:EventHarbinger>> se foram de suas terras, o Conselho {EventRace} entra em contato com você novamente."

msgid "STORY_EVENT@1122_293@BODY_LORE"
msgstr "\"Trabalho maravilhoso, {PlayerLeader}, simplesmente maravilhoso! Conseguimos conter qualquer pânico em relação aos avistamentos de {EventHarbinger}, então parece que estamos livres. Tudo graças a você, é claro.\""

msgid "STORY_EVENT@1122_293@BUTTON_0"
msgstr "\"Esta vitória prova que os {EventRace} são verdadeiros guerreiros [unitprod/].\""

msgid "STORY_EVENT@1122_293@BUTTON_1"
msgstr "\"Esta vitória sinaliza a sorte [happiness/] dos {EventRace}.\""

msgid "STORY_EVENT@1122_293@BUTTON_3"
msgstr "\"Esta vitória mostra que os {EventRace} devem construir [structureprod/] defesas melhores.\""

msgid "STORY_EVENT@1122_293@BUTTON_4"
msgstr "\"Este encontro apenas ilustra que meu império [influence/] pode dominar qualquer inimigo.\""

msgid "STORY_EVENT@1122_293@TITLE"
msgstr "Arautos da Desgraça: Consequências"

msgid "STORY_EVENT@1122_29@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um de seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> e melhorar gradualmente sua {GLOBAL.HouseInfluenceConcept.Hyperlink} para com você."

msgid "STORY_EVENT@1122_29@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} de {EventHouse.Name} cumprimenta você com óbvio desprezo."

msgid "STORY_EVENT@1122_29@BODY_LORE"
msgstr "\"Saudações, {PlayerLeader.Name}. Os valores que sua cultura possui não poderiam ser mais diferentes dos nossos, mas esperamos que você encontre algum terreno em comum com {EventHouse.Name}. E se não, talvez tenhamos encontrado um adversário digno.\""

msgid "STORY_EVENT@1122_29@BUTTON_0"
msgstr "Iniciar discussões com esses honoráveis tolos."

msgid "STORY_EVENT@1122_29@BUTTON_2"
msgstr "Deixe-os com suas buscas cavalheirescas... por enquanto..."

msgid "STORY_EVENT@1122_29@TITLE"
msgstr "Encontrando a Cavalheiresca {EventHouse.Name}"

msgid "STORY_EVENT@1122_2@BODY_FOOTER"
msgstr "\"Serei um aliado melhor do que meu <<EventHouseLord{pai/mãe}>>.\" Você apoiará o esquema de {EventHero.FirstName} para suplantar {EventHouseLord.TitleName}?"

msgid "STORY_EVENT@1122_2@BODY_HEADER"
msgstr "Você é convocado por {EventHouse}, mas não é recebido por {EventHouseLord.TitleName}. Em vez de retomar as negociações diplomáticas, <<o:EventHouseLord>> o filho mais velho <<EventHero{filho/filha}>> de <<o:EventHouseLord>> o saúda."

msgid "STORY_EVENT@1122_2@BODY_LORE"
msgstr "\"Bom dia, {PlayerLeader.TitleName}. Sou {EventHero.Name} de {EventHouse}. Acredito que o governo do meu <<EventHouseLord{pai/mãe}>> está falhando. Felizmente, estou ansioso e capaz de assumir, mas temo que a uhm... 'transição' possa ser árdua.\""

msgid "STORY_EVENT@1122_2@BUTTON_0"
msgstr "\"Eu vou ajudá-lo a alcançar suas ambições sangrentas [evilact/]!\""

msgid "STORY_EVENT@1122_2@BUTTON_1"
msgstr "\"Junte-se a mim [unit/], {EventHero.FirstName}! Por que governar um lago quando eu lhe ofereço o oceano?\""

msgid "STORY_EVENT@1122_2@BUTTON_2"
msgstr "\"Junte-se a mim [unit/], {EventHero.FirstName}! Por que governar um lago quando eu lhe ofereço o oceano?\""

msgid "STORY_EVENT@1122_2@BUTTON_3"
msgstr "\"Acorde seu <<EventHouseLord{pai/mãe}>>, criança! Eu não lido com filhotes.\""

msgid "STORY_EVENT@1122_2@BUTTON_4"
msgstr "\"Visite-me prontamente, intrigante! Eu anseio pelos segredos da sua mente perversa!\""

msgid "STORY_EVENT@1122_2@BUTTON_5"
msgstr "\"Não estou interessado. Lide com este assunto por conta própria.\""

msgid "STORY_EVENT@1122_2@TITLE"
msgstr "Ambições Nobre"

msgid "STORY_EVENT@1122_304@BODY_FOOTER"
msgstr "As criaturas desde então desenvolveram um apetite por nós {EventRace}. Devemos eliminar esses demônios na fonte, grande {PlayerLeader.Title}."

msgid "STORY_EVENT@1122_304@BODY_HEADER"
msgstr "O Conselho {EventRace} convocou uma reunião de emergência com você. \"Meu {PlayerLeader.Title}, estamos sendo caçados por <<m:EventStackLeader>>!\""

msgid "STORY_EVENT@1122_304@BODY_LORE"
msgstr "\"Descobrimos um {EventSpawner} perto de {EventCity}, o que já era preocupante por si só. Seus ataques incidentais aos {EventRace} eram incômodos, mas administráveis. Esperávamos que destruíssem propriedades, mas não podíamos prever que devorariam nossos parentes!\""

msgid "STORY_EVENT@1122_304@BUTTON_0"
msgstr "\"Considere esta ameaça ao seu povo eliminada!\""

msgid "STORY_EVENT@1122_304@BUTTON_1"
msgstr "\"Talvez seja melhor investir em sua própria defesa [unitprod/].\""

msgid "STORY_EVENT@1122_304@BUTTON_2"
msgstr "\"Esta ameaça não me diz respeito.\""

msgid "STORY_EVENT@1122_304@TITLE"
msgstr "{EventRace} do tamanho de Petiscos"

msgid "STORY_EVENT@1122_305@BODY_FOOTER"
msgstr "O conselho dos {EventRace} quer expressar sua gratidão através de um festival. O que eles devem celebrar?"

msgid "STORY_EVENT@1122_305@BODY_HEADER"
msgstr "Agora que o {EventSpawner} foi destruído, o Conselho {EventRace} parabeniza você por sua conquista."

msgid "STORY_EVENT@1122_305@BODY_LORE"
msgstr "\"Estamos felizes em relatar que o consumo do nosso povo terminou, ó {PlayerLeader.Title}! Nossos parentes estão seguros do <<m:EventSpawnerHead>> novamente, graças a você!\""

msgid "STORY_EVENT@1122_305@BUTTON_0"
msgstr "Tenha um festival de fertilidade [population/] para reabastecer seu povo."

msgid "STORY_EVENT@1122_305@BUTTON_1"
msgstr "Construa e reconstrua [structureprod/] em honra dos parentes devorados."

msgid "STORY_EVENT@1122_305@BUTTON_3"
msgstr "Celebre [happiness/] que o <<m:EventSpawnerHead>> não ameaçam mais sua espécie."

msgid "STORY_EVENT@1122_305@TITLE"
msgstr "{EventRace} do tamanho de Petiscos: Consequências"

msgid "STORY_EVENT@1122_309@BODY_FOOTER"
msgstr "\"Se você apoiar nossa busca para nos aproximarmos das correntes mágicas [hyperlink,GLOBAL.AstralFlowsLoreConcept]correntes[/hyperlink], solicitamos gentilmente que você construa mais [hyperlink,GLOBAL.ConduitConcept][conduit/]Condutos[/hyperlink].\""

msgid "STORY_EVENT@1122_309@BODY_HEADER"
msgstr "Um distinto enviado do Conselho {EventRace} aparece diante de você. Após as formalidades necessárias, <<p:EventUnit>> declara <<o:EventUnit>> intenção."

msgid "STORY_EVENT@1122_309@BODY_LORE"
msgstr "\"Sua eminência, vocês nos conhecem, os {EventRace}, como um povo orgulhoso e ilustre. Buscamos elevar-nos da lama mundana deste reino.\" O enviado sorri. \"Desejamos entender melhor os caminhos da magia. Com o tempo, podemos até mesmo aprimorar nossos parentes com os poderosos fluxos do {GLOBAL.AstralSeaLoreConcept.Hyperlink}.\""

msgid "STORY_EVENT@1122_309@BUTTON_0"
msgstr "\"Vou considerar seu pedido.\""

msgid "STORY_EVENT@1122_309@BUTTON_1"
msgstr "\"Eu decido o que construir em minhas terras.\""

msgid "STORY_EVENT@1122_309@BUTTON_2"
msgstr "\"Magia não é para vocês, simples {EventRace}. Mas a agricultura [food/] é!\""

msgid "STORY_EVENT@1122_309@TITLE"
msgstr "Mais Próximo da Magia"

msgid "STORY_EVENT@1122_310@BODY_FOOTER"
msgstr "O enviado sorri. \"Espero que você deseje um sinal de gratidão. Como os {EventRace} podem recompensar seu sucesso?\""

msgid "STORY_EVENT@1122_310@BODY_HEADER"
msgstr "Depois que você construiu o último dos [hyperlink,GLOBAL.ConduitConcept][conduit/]Condutores[/hyperlink] solicitados, o enviado do Conselho {EventRace} retorna de bom humor."

msgid "STORY_EVENT@1122_310@BODY_LORE"
msgstr "O enviado estende <<o:EventUnit>> braços como se para alargar ainda mais o sorriso em <<o:EventUnit>> rosto. \"Trabalho excepcional, meu {PlayerLeader.Title}. Agora temos [conduit/] condutores para nos conectar aos {GLOBAL.AstralFlowsLoreConcept.Hyperlink} em todo este reino! Sabíamos que poderíamos contar com você!\""

msgid "STORY_EVENT@1122_310@BUTTON_0"
msgstr "Deixe-os colher a descarga de cristal [mana/] dos condutores."

msgid "STORY_EVENT@1122_310@BUTTON_1"
msgstr "Deixe-os usar os condutores para impulsionar sua pesquisa [knowledge/]."

msgid "STORY_EVENT@1122_310@BUTTON_3"
msgstr "Deixe-os pagar mais impostos [gold/], agora que seu desejo foi atendido."

msgid "STORY_EVENT@1122_310@BUTTON_4"
msgstr "Apenas deixe os {EventRace} desfrutarem de sua nova bênção [happiness/]."

msgid "STORY_EVENT@1122_310@TITLE"
msgstr "Mais Próximo da Magia: Consequências"

msgid "STORY_EVENT@1122_32@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um de seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> e gradualmente melhorar sua {GLOBAL.HouseInfluenceConcept.Hyperlink} para com você."

msgid "STORY_EVENT@1122_32@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} de {EventHouse.Name} cumprimenta você com um ar de julgamento pretensioso."

msgid "STORY_EVENT@1122_32@BODY_LORE"
msgstr "\"Salve, {PlayerLeader.Name}. Embora não experimentemos com a morte da maneira que você faz, espero que nossos esforços mágicos possam ajudá-lo a ver que você tem muito em comum com {EventHouse.Name}."

msgid "STORY_EVENT@1122_32@BUTTON_0"
msgstr "Explore um caminho adiante com esses entusiastas do místico."

msgid "STORY_EVENT@1122_32@BUTTON_2"
msgstr "Saia de sua esfera áurica por enquanto..."

msgid "STORY_EVENT@1122_32@TITLE"
msgstr "Encontrando o Místico {EventHouse.Name}"

msgid "STORY_EVENT@1122_33@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um de seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> e gradualmente melhorar sua {GLOBAL.HouseInfluenceConcept.Hyperlink} para com você."

msgid "STORY_EVENT@1122_33@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} de {EventHouse.Name} cumprimenta você com curiosidade hesitante."

msgid "STORY_EVENT@1122_33@BODY_LORE"
msgstr "\"Bem encontrado, {PlayerLeader.Name}. Embora meu instinto seja erradicar você na hora, estou ansioso para aprender mais sobre sua cultura e descobrir se você e {EventHouse.Name} podem coexistir em paz. Se não... então estamos prontos para você.\""

msgid "STORY_EVENT@1122_33@BUTTON_0"
msgstr "Tente uma conversa com esses primitivos mortais."

msgid "STORY_EVENT@1122_33@BUTTON_2"
msgstr "Deixe a companhia bruta deles por enquanto..."

msgid "STORY_EVENT@1122_33@TITLE"
msgstr "Encontrando Brutamontes {EventHouse.Name}"

msgid "STORY_EVENT@1122_35@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um dos seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> e gradualmente melhorar sua {GLOBAL.HouseInfluenceConcept.Hyperlink} para com você."

msgid "STORY_EVENT@1122_35@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} de {EventHouse.Name} cumprimenta você com cautela calculada."

msgid "STORY_EVENT@1122_35@BODY_LORE"
msgstr "\"Saudações, ó {PlayerLeader.Name}. Seu poder e devoção às artes sombrias paralelas à nossa paixão pelo progresso aqui em {EventHouse.Name}. Esperamos que nossa eficiência e seu poder possam provar ser uma boa combinação.\""

msgid "STORY_EVENT@1122_35@BUTTON_0"
msgstr "Inicie possíveis negociações com esta cidade empreendedora."

msgid "STORY_EVENT@1122_35@BUTTON_2"
msgstr "Parta das discussões, com a possibilidade de retomá-las em um momento posterior."

msgid "STORY_EVENT@1122_35@TITLE"
msgstr "Encontrando Empresarial {EventHouse.Name}"

msgid "STORY_EVENT@1122_36@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um dos seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> e gradualmente melhorar sua {GLOBAL.HouseInfluenceConcept.Hyperlink} para com você."

msgid "STORY_EVENT@1122_36@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} de {EventHouse.Name} cumprimenta você com um sorriso de desdém."

msgid "STORY_EVENT@1122_36@BODY_LORE"
msgstr "\"Oh, é você, {PlayerLeader.Name}. Sua devoção à honra é... digamos... um tanto repulsiva para o meu gosto. No entanto, {EventHouse.Name} não deseja ofender... pelo menos não imediatamente. Talvez resolvamos nossas diferenças. Ou suas legiões podem eventualmente se juntar às minhas na morte. Acho que veremos.\""

msgid "STORY_EVENT@1122_36@BUTTON_0"
msgstr "Explore que caminhos podem aguardá-lo com esses odiosos necromantes."

msgid "STORY_EVENT@1122_36@BUTTON_2"
msgstr "Deixe a presença dessas criaturas vis em breve."

msgid "STORY_EVENT@1122_36@TITLE"
msgstr "Encontrando Desdenhoso {EventHouse.Name}"

msgid "STORY_EVENT@1122_3@BODY_FOOTER"
msgstr "\"Meu povo favorece <<P:EventHero>>, mesmo que eu não! E agora <<p:EventHero>> deseja 'provar <<o:EventHero>> qualidade'. Busco seu conselho!\""

msgid "STORY_EVENT@1122_3@BODY_HEADER"
msgstr "Assim que as negociações do dia são concluídas, {EventHouseLord.TitleName} de {EventHouse.Name} solicita conselhos sobre <<o:EventHouseLord>> inútil mais jovem <<EventHero{son/daughter}>>."

msgid "STORY_EVENT@1122_3@BODY_LORE"
msgstr "\"<<EventHero.FirstName>> é tão diferente de <<o:EventHero>> mais velho <<EventHero{brother/sister}>>,\" o {EventHouseLord.Title} suspira. \"Agora, <<Zp:EventHero>> caminha com Feiticeiros e Meio-Homens! Um verdadeiro parâmetro de bravura e coragem... Enquanto meu mais jovem se esconde em cavernas úmidas e atira flechas de cobertura como um covarde. E todo esse tempo, <<p:EventHero>> pensa <<r:EventHero>> tão nobre quanto um <<EventHero{king/queen}>> de antigamente!\""

msgid "STORY_EVENT@1122_3@BUTTON_0"
msgstr "\"Meus valentes capitães treinarão [unitprod/] {EventHero.FirstName} em {EventCity} [unit/].\""

msgid "STORY_EVENT@1122_3@BUTTON_1"
msgstr "\"Meus valentes capitães treinarão [unitprod/] {EventHero.FirstName} em {EventCity} [unit/].\""

msgid "STORY_EVENT@1122_3@BUTTON_2"
msgstr "\"Pegue meu {EventItem} [item/], diga que está amaldiçoado e envie <<P:EventHero>> para destruí-lo!\""

msgid "STORY_EVENT@1122_3@BUTTON_3"
msgstr "\"E ainda assim, seu sangue corre nas veias de <<o:EventHero>>. Lembre-se disso.\""

msgid "STORY_EVENT@1122_3@BUTTON_4"
msgstr "\"Envie {EventHero.FirstName} para a batalha. <<Cp:EventHero>> vence? Ótimo! <<Cp:EventHero>> morre? Problema resolvido!\""

msgid "STORY_EVENT@1122_3@BUTTON_5"
msgstr "\"Claramente, as qualidades de <<o:EventHero>> são abundantes. Você simplesmente não consegue vê-las.\""

msgid "STORY_EVENT@1122_3@TITLE"
msgstr "<<EventHero{son/daughter}>> Favorecido"

msgid "STORY_EVENT@1122_41@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um dos seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> e gradualmente melhorar sua {GLOBAL.HouseInfluenceConcept.Hyperlink} para com você."

msgid "STORY_EVENT@1122_41@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} de {EventHouse.Name} cumprimenta você com uma reverência elegante e misteriosa."

msgid "STORY_EVENT@1122_41@BODY_LORE"
msgstr "\"Saudações, {PlayerLeader.Name}. Esperamos que nossas artes místicas e seus valores possam ser uma boa combinação com o tempo. {EventHouse.Name} aprendeu muito sobre você através de nossas visões, e estamos interessados em possivelmente buscar amizade.\""

msgid "STORY_EVENT@1122_41@BUTTON_0"
msgstr "Iniciar uma conversa com esses sábios fascinantes."

msgid "STORY_EVENT@1122_41@BUTTON_2"
msgstr "Deixar esses sábios com sua magia por enquanto..."

msgid "STORY_EVENT@1122_41@TITLE"
msgstr "Encontrando {EventHouse.Name} Metafísicos"

msgid "STORY_EVENT@1122_42@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um de seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> e gradualmente melhorar sua {GLOBAL.HouseInfluenceConcept.Hyperlink} para com você."

msgid "STORY_EVENT@1122_42@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} de {EventHouse.Name} cumprimenta você com um grito alto e poderoso."

msgid "STORY_EVENT@1122_42@BODY_LORE"
msgstr "\"{PlayerLeader.Name}! É bom conhecê-lo. Embora você use sua força de maneira mais sutil que nós, acredito que temos muito em comum. Nós de {EventHouse.Name} podemos ser rústicos e prontos, e não motivados pela glória — mas a maneira como nos deleitamos no combate é incomparável.\""

msgid "STORY_EVENT@1122_42@BUTTON_0"
msgstr "Tentar conversar com essas pessoas bestiais."

msgid "STORY_EVENT@1122_42@BUTTON_2"
msgstr "Deixar sua presença primitiva por enquanto."

msgid "STORY_EVENT@1122_42@TITLE"
msgstr "Encontrando {EventHouse.Name} Rústicos"

msgid "STORY_EVENT@1122_44@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um de seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> e gradualmente melhorar sua {GLOBAL.HouseInfluenceConcept.Hyperlink} para com você."

msgid "STORY_EVENT@1122_44@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} de {EventHouse.Name} cumprimenta você com um aperto de mão e um olhar conhecedor."

msgid "STORY_EVENT@1122_44@BODY_LORE"
msgstr "\"Saudações, oh ilustre {PlayerLeader.Name}. Nós o estudamos e o achamos impressionante. Embora estejamos bastante ocupados com vários projetos, {EventHouse.Name} sempre terá tempo para diplomacia com você, caso tenha interesse. Certamente gostaríamos de trabalhar juntos.\""

msgid "STORY_EVENT@1122_44@BUTTON_0"
msgstr "Iniciar um possível caminho adiante com esses entusiastas da invenção."

msgid "STORY_EVENT@1122_44@BUTTON_2"
msgstr "Deixar as discussões por enquanto..."

msgid "STORY_EVENT@1122_44@TITLE"
msgstr "Encontrando {EventHouse.Name} Diligentes"

msgid "STORY_EVENT@1122_45@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um de seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> e gradualmente melhorar sua {GLOBAL.HouseInfluenceConcept.Hyperlink} para com você."

msgid "STORY_EVENT@1122_45@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} de {EventHouse.Name} cumprimenta você com um sorriso ostentoso."

msgid "STORY_EVENT@1122_45@BODY_LORE"
msgstr "\"Bem encontrado, {PlayerLeader.Name}. Embora você seja um pouco mais rústico do que nossa sociedade, acreditamos que nós aqui em {EventHouse.Name} podemos ter muito em comum com você, caso escolha buscar negociações. O tempo dirá.\""

msgid "STORY_EVENT@1122_45@BUTTON_0"
msgstr "Iniciar uma troca com esta sociedade opulenta."

msgid "STORY_EVENT@1122_45@BUTTON_2"
msgstr "Remover-se da conversa por enquanto."

msgid "STORY_EVENT@1122_45@TITLE"
msgstr "Encontrando {EventHouse.Name} Sofisticados"

msgid "STORY_EVENT@1122_46@BODY_FOOTER"
msgstr "\"Ordene-nos purgar suas cidades de hereges, e seu sacrifício elevará seu povo fiel... ou a você mesmo.\""

msgid "STORY_EVENT@1122_46@BODY_HEADER"
msgstr "Uma companhia de <<m:EventUnit>> chega à sua corte. Seu capitão proclama: \"Finalmente! Nós te encontramos!\""

msgid "STORY_EVENT@1122_46@BODY_LORE"
msgstr "\"Nós somos os {RandomWarriorTitle} do {RandomIdol}, que descobriram que comunidades virtuosas se tornam iluminadas quando libertadas de seus infiéis. Seu zelo focado pode até elevar um {GLOBAL.GodirLoreConcept.Hyperlink} como você! Em um sonho, recebi a missão de ajudar um novo parâmetro de [hyperlink,GLOBAL.OrderConcept]Ordem[/hyperlink]! {PlayerLeader.TitleName}, esse parâmetro é você!\""

msgid "STORY_EVENT@1122_46@BUTTON_0"
msgstr "\"Ilumine meu império [orderboon/]. Purge meu domínio de hereges [population/].\""

msgid "STORY_EVENT@1122_46@BUTTON_1"
msgstr "\"Purge [population/] {EventCity} apenas e me conceda conhecimento celestial!\""

msgid "STORY_EVENT@1122_46@BUTTON_2"
msgstr "\"Meu império carece de convicção [influence/]. Torne-se meu executor divino [unit/].\""

msgid "STORY_EVENT@1122_46@BUTTON_3"
msgstr "\"Considero seus métodos bárbaros [ordercrisis/]. Deixe meu reino!\""

msgid "STORY_EVENT@1122_46@TITLE"
msgstr "Salvação Divina"

msgid "STORY_EVENT@1122_47@BODY_FOOTER"
msgstr "\"Nós te abençoamos através de nossa súplica santificadora. Prove agora seu direito divino. Realize um milagre que demonstre seu poder!\""

msgid "STORY_EVENT@1122_47@BODY_HEADER"
msgstr "Em uma visão, um {EventUnit} te visita. Um coro invisível canta: \"Por certo, tu te tornaste um Farol de [hyperlink,GLOBAL.OrderConcept]Ordem[/hyperlink], {PlayerLeader.TitleName}.\""

msgid "STORY_EVENT@1122_47@BODY_LORE"
msgstr "O olhar implacável do Santuário penetra sua alma. O coro angelical continua: \"Nós vasculhamos reinos que se conectam ao {GLOBAL.AstralSeaLoreConcept.Hyperlink}, em busca de Faróis como você. Nossa canção te enobrece - não tema! O caminho para a ascensão se abre para aqueles que a ouvem. Nós te suplicamos agora antes de partirmos: mostre a piedade de seu coração zeloso.\""

msgid "STORY_EVENT@1122_47@BUTTON_0"
msgstr "Extraia da divindade de sua alma [mana/] [knowledge/] para abençoar sua população [orderboon/]."

msgid "STORY_EVENT@1122_47@BUTTON_1"
msgstr "Construa ídolos [structureprod/] em cada cidade, para exibir a unificação de seu império [influence/]."

msgid "STORY_EVENT@1122_47@BUTTON_2"
msgstr "Estabeleça [unitprod/] a Ordem Sagrada do Divino <<m:EventUnitB>> em {EventCity}!"

msgid "STORY_EVENT@1122_47@BUTTON_3"
msgstr "\"Vá embora, {EventUnit}! Minha glória ofusca sua autoridade [ordercrisis/]!\""

msgid "STORY_EVENT@1122_47@TITLE"
msgstr "Exaltação Divina"

msgid "STORY_EVENT@1122_4@BODY_FOOTER"
msgstr "Enquanto analisa a performance magistral do {EventUnit} transformado em bobo da corte, {EventHouseLord.FirstName} de repente pergunta por que você não parece entretido."

msgid "STORY_EVENT@1122_4@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} de {EventHouse} orgulhosamente convoca <<o:EventHouseLord>> novo bobo da corte para te entreter durante as negociações."

msgid "STORY_EVENT@1122_4@BODY_LORE"
msgstr "Este bobo da corte, no entanto, claramente não é um tolo! Enquanto <<p:EventUnit>> realiza complexos feitiços de conjuração e ilusão, <<p:EventUnit>> parece severamente superqualificado para <<o:EventUnit>> trabalho. {EventHouseLord.Name} bate palmas e grita de alegria, incapaz de avaliar o quão poderoso o performer é. O bobo da corte realiza outra ilusão deslumbrante com facilidade, <<o:EventUnit>> expressão beirando o tédio."

msgid "STORY_EVENT@1122_4@BUTTON_0"
msgstr "\"Meu império [influence/] não conhece bobos da corte tão talentosos quanto os seus, {EventHouseLord.Title}!\""

msgid "STORY_EVENT@1122_4@BUTTON_1"
msgstr "\"<<Cp:EventUnit>>! Eu serei seu novo patrono [unit/]!\""

msgid "STORY_EVENT@1122_4@BUTTON_2"
msgstr "\"<<Cp:EventUnit>> está bem, mas como estão <<o:EventUnit>> habilidades de malabarismo?\""

msgid "STORY_EVENT@1122_4@BUTTON_3"
msgstr "\"<<Cp:EventUnit>> é capaz, tudo bem. Agora, veja como os Godir realizam truques de magia!\""

msgid "STORY_EVENT@1122_4@BUTTON_4"
msgstr "\"Desculpe minha seriedade, {EventHouseLord}. Estou ponderando sobre o futuro brilhante de {EventHouse} sob minha proteção.\""

msgid "STORY_EVENT@1122_4@TITLE"
msgstr "Jogos Tolos"

msgid "STORY_EVENT@1122_5@BODY_FOOTER"
msgstr "\"Certamente, você contribuirá para a celebração do grande {EventGodir}! O que podemos esperar de você, ó {PlayerLeader.Name}?\""

msgid "STORY_EVENT@1122_5@BODY_HEADER"
msgstr "Após as negociações diplomáticas de hoje, {EventHouseLord.TitleName} de {EventHouse} anuncia que sua cidade deseja celebrar um Godir que admira: {EventGodir}."

msgid "STORY_EVENT@1122_5@BODY_LORE"
msgstr "Eles desejam comemorar o dia em que {EventGodir} se tornou um Godir e pretendem tornar isso um evento anual. \"Foi minha ideia,\" declara {EventHouseLord.Name}. \"E a moral do meu povo nunca esteve melhor! Que todos nós sejamos abençoados pela força e glória de {EventGodir}!\""

msgid "STORY_EVENT@1122_5@BODY_LORE@ASTRAL"
msgstr "Eles desejam comemorar o dia em que {EventGodir} tornou-se um Godir e pretendem tornar isso um evento anual. \"Foi minha ideia,\" declara {EventHouseLord.Name}. \"E a moral do meu povo nunca esteve melhor! Que todos nós sejamos abençoados pela sabedoria e arcana de {EventGodir}!\""

msgid "STORY_EVENT@1122_5@BODY_LORE@CHAOS"
msgstr "Eles desejam comemorar o dia em que {EventGodir} tornou-se um Godir e pretendem tornar isso um evento anual. \"Foi minha ideia,\" declara {EventHouseLord.Name}. \"E a moral do meu povo nunca esteve melhor! Que todos nós sejamos abençoados pelo fogo e caos de {EventGodir}!\""

msgid "STORY_EVENT@1122_5@BODY_LORE@MATERIUM"
msgstr "Eles desejam comemorar o dia em que {EventGodir} tornou-se um Godir e pretendem tornar isso um evento anual. \"Foi minha ideia,\" declara {EventHouseLord.Name}. \"E a moral do meu povo nunca esteve melhor! Que todos nós sejamos abençoados pela opulência e artesanato de {EventGodir}!\""

msgid "STORY_EVENT@1122_5@BODY_LORE@NATURE"
msgstr "Eles desejam comemorar o dia em que {EventGodir} tornou-se um Godir e pretendem tornar isso um evento anual. \"Foi minha ideia,\" declara {EventHouseLord.Name}. \"E a moral do meu povo nunca esteve melhor! Que todos nós sejamos abençoados pela fertilidade e vibração de {EventGodir}!\""

msgid "STORY_EVENT@1122_5@BODY_LORE@ORDER"
msgstr "Eles desejam comemorar o dia em que {EventGodir} tornou-se um Godir e pretendem tornar isso um evento anual. \"Foi minha ideia,\" declara {EventHouseLord.Name}. \"E a moral do meu povo nunca esteve melhor! Que todos nós sejamos abençoados pela luz e harmonia de {EventGodir}!\""

msgid "STORY_EVENT@1122_5@BODY_LORE@SHADOW"
msgstr "Eles desejam comemorar o dia em que {EventGodir} tornou-se um Godir e pretendem tornar isso um evento anual. \"Foi minha ideia,\" declara {EventHouseLord.Name}. \"E a moral do meu povo nunca esteve melhor! Que todos nós sejamos abençoados pelos segredos e decadência de {EventGodir}!\""

msgid "STORY_EVENT@1122_5@BUTTON_0"
msgstr "\" {EventGodir} nos inspira a todos. Eu patrocinarei [gold/] suas festividades.\""

msgid "STORY_EVENT@1122_5@BUTTON_1"
msgstr "\" {EventGodir} era um TOLO! Vocês deveriam me adorar em vez disso [influence/]!\""

msgid "STORY_EVENT@1122_5@BUTTON_2"
msgstr "Ensine [knowledge/] {EventHouse} sobre {EventGodir} e <<o:EventGodir>> realizações."

msgid "STORY_EVENT@1122_5@BUTTON_3"
msgstr "\"Celebrar <<G:supremacy^n,{EventGodir}>> está incompleto sem um toque de magia.\""

msgid "STORY_EVENT@1122_5@BUTTON_4"
msgstr "\"Essas celebrações vulgares não merecem minha atenção.\""

msgid "STORY_EVENT@1122_5@TITLE"
msgstr "<<G:Day^n,EventGodir>>"

msgid "STORY_EVENT@1122_61@BODY_FOOTER"
msgstr "O prospector solicita mineiros de {EventCity} para desenterrar um depósito de pedra mágica. Sua parte permitirá um projeto especial."

msgid "STORY_EVENT@1122_61@BODY_HEADER"
msgstr "Um velho prospector coberto de terra o saúda. <<Cp:EventUnit>> mantém uma bolsa próxima ao <<o:EventUnit>> peito."

msgid "STORY_EVENT@1122_61@BODY_LORE"
msgstr "A voz do prospector sujo é áspera, <<o:EventUnit>> entusiasmo descontrolado. \"Então você é o Guardião da Forja por aqui, hein?\" <<Cp:EventUnit>> tira sorrindo um seixo da bolsa. \"Vê isso? Flowrock! Eu conheço um depósito secreto! Mas não posso movê-lo sozinho. Sobra alguns trabalhadores para me ajudar, e dividiremos o butim!\""

msgid "STORY_EVENT@1122_61@BUTTON_0"
msgstr "Envie mineiros [structureprod/] e erija um obelisco para comemorar a descoberta [materiumboon/]."

msgid "STORY_EVENT@1122_61@BUTTON_1"
msgstr "Envie mineiros [structureprod/] e forje um {EventItem} [item/]."

msgid "STORY_EVENT@1122_61@BUTTON_2"
msgstr "Envie mineiros [structureprod/] e construa um {EventUnitB} [unit/]."

msgid "STORY_EVENT@1122_61@BUTTON_3"
msgstr "\"Flowrock? Essa é a coisa mais ridícula [materiumcrisis/] que já ouvi.\""

msgid "STORY_EVENT@1122_61@TITLE"
msgstr "Oportunidade Preciosa"

msgid "STORY_EVENT@1122_62@BODY_FOOTER"
msgstr "No entanto, a argila está se decompondo rapidamente! Você tem apenas alguns segundos para decidir qual novo elemento criar!"

msgid "STORY_EVENT@1122_62@BODY_HEADER"
msgstr "Você dedicou seu domínio em [hyperlink,GLOBAL.MateriumConcept]Materium[/hyperlink] à criação da argila mítica do transmutador. Hoje, você conseguiu!"

msgid "STORY_EVENT@1122_62@BODY_LORE"
msgstr "Apenas os {GLOBAL.ArchonsLoreConcept.Hyperlink} primordiais conseguiram moldar essa argila que, de acordo com lendas, dá ao seu usuário o poder de moldar materiais nunca antes vistos! Após inúmeras tentativas sem sucesso, você derrubou acidentalmente um frasco sem rótulo hoje, derramando seu conteúdo em seu caldeirão. A tintura chiou... estourou... e, uma vez que os fumos se dissiparam, a argila estava lá!"

msgid "STORY_EVENT@1122_62@BUTTON_0"
msgstr "Transforme trigo [food/] de {EventCity} em um vapor que agça a mente [knowledge/]!"

msgid "STORY_EVENT@1122_62@BUTTON_1"
msgstr "Transmute ouro [gold/] em um elixir [materiumboon/] que ressuscita {EventHero} [unit/]!"

msgid "STORY_EVENT@1122_62@BUTTON_2"
msgstr "Transforme <<g:teardrops^n,EventCity>> [happiness/] em moedas de ouro [gold/]!"

msgid "STORY_EVENT@1122_62@BUTTON_3"
msgstr "Permita que a argila do transmutador se desintegre."

msgid "STORY_EVENT@1122_62@TITLE"
msgstr "Transmutações Elementares"

msgid "STORY_EVENT@1122_63@BODY_FOOTER"
msgstr "\"<<PlayerLeader.Title>>, você pode aprender uma magia destrutiva em troca de... um quarto do seu sangue.\""

msgid "STORY_EVENT@1122_63@BODY_HEADER"
msgstr "Um eremita encapuzado solicita uma audiência. <<Cp:EventUnit>> carrega três páginas que claramente foram arrancadas de seus [hyperlink,GLOBAL.TomeLoreConcept]Tomos de Magia[/hyperlink]."

msgid "STORY_EVENT@1122_63@BODY_LORE"
msgstr "\"Você tem uma reputação de ser um <<PlayerLeader.TitleName>> erudito.\" A voz do eremita é profunda e suave. Você discerne o contorno de uma cauda espinhosa sob as vestes de <<o:EventUnit>>. \"Eu carrego... conhecimento proibido que pode ser seu. Se você estiver determinado o suficiente para reclamá-lo.\" Pequenos chifres protrudem de sob o capuz do eremita."

msgid "STORY_EVENT@1122_63@BUTTON_0"
msgstr "Troque seu sangue pela página lambida pelas chamas."

msgid "STORY_EVENT@1122_63@BUTTON_0@LEARN_SPELL_CONDEMNATION"
msgstr "{PlayerLeader} aprende {Condemnation.Hyperlink}"

msgid "STORY_EVENT@1122_63@BUTTON_0@LEARN_SPELL_FIREBALL"
msgstr "{PlayerLeader} aprende a magia {Fireball.Hyperlink}"

msgid "STORY_EVENT@1122_63@BUTTON_0@LEARN_SPELL_ICECOFFIN"
msgstr "{PlayerLeader} aprende {IceCoffin.Hyperlink}"

msgid "STORY_EVENT@1122_63@BUTTON_1"
msgstr "Troque seu sangue pela página gelada."

msgid "STORY_EVENT@1122_63@BUTTON_2"
msgstr "Troque seu sangue pela página iluminada."

msgid "STORY_EVENT@1122_63@BUTTON_3"
msgstr "Afaste o trapaceiro. O preço do conhecimento tem seus limites [astralcrisis/]."

msgid "STORY_EVENT@1122_63@TITLE"
msgstr "Acordo Ardiloso"

msgid "STORY_EVENT@1122_64@BODY_FOOTER"
msgstr "Quem se tornará seu aprendiz? A família de seu aprendiz lhe presenteará com o recurso que produzem."

msgid "STORY_EVENT@1122_64@BODY_HEADER"
msgstr "De acordo com as tradições, qualquer Mestre do [hyperlink,GLOBAL.AstralConcept]Astral[/hyperlink] que se preze, aceita um pupilo."

msgid "STORY_EVENT@1122_64@BODY_LORE"
msgstr "Você convida todo sétimo filho de um sétimo filho para sua corte. Três atendem ao chamado. O primeiro irrompe e imediatamente começa uma briga: um filho de um lenhador de temperamento quente. O segundo calmamente toma um assento à sua mesa: um filho de um administrador de rosto de aço. O terceiro cumprimenta os guardas e serve uma bebida para si mesmo: um filho de um padeiro amigável."

msgid "STORY_EVENT@1122_64@BUTTON_0"
msgstr "\"<<EventHeroA.FirstName>> [unit/], <<EventHeroA{filho/filha}>> do lenhador [structureprod/], será meu aprendiz [knowledge/].\""

msgid "STORY_EVENT@1122_64@BUTTON_1"
msgstr "\"<<EventHeroA.FirstName>> [unit/], <<EventHeroA{filho/filha}>> do lenhador [structureprod/], será meu aprendiz [knowledge/].\""

msgid "STORY_EVENT@1122_64@BUTTON_2"
msgstr "\"<<EventHeroB.FirstName>> [unit/], <<EventHeroB{filho/filha}>> do administrador [gold/], será meu aprendiz [knowledge/].\""

msgid "STORY_EVENT@1122_64@BUTTON_3"
msgstr "\"<<EventHeroB.FirstName>> [unit/], <<EventHeroB{filho/filha}>> do administrador [gold/], será meu aprendiz [knowledge/].\""

msgid "STORY_EVENT@1122_64@BUTTON_4"
msgstr "\"<<EventHeroC.FirstName>> [unit/], <<EventHeroC{menino/menina}>> do padeiro [food/], será meu aprendiz [knowledge/].\""

msgid "STORY_EVENT@1122_64@BUTTON_5"
msgstr "\"<<EventHeroC.FirstName>> [unit/], <<EventHeroC{menino/menina}>> do padeiro [food/], será meu aprendiz [knowledge/].\""

msgid "STORY_EVENT@1122_64@BUTTON_6"
msgstr "\"O que estou fazendo? Aprendizes são para tolos! [astralcrisis/]\""

msgid "STORY_EVENT@1122_64@TITLE"
msgstr "Aprendiz de Feiticeiro"

msgid "STORY_EVENT@1122_68@BODY_FOOTER"
msgstr "A Tempestade Astral ameaça evaporar os cidadãos de {EventCity}. Você é capaz de desviar do caos iminente?"

msgid "STORY_EVENT@1122_68@BODY_HEADER"
msgstr "Seu olho [hyperlink,GLOBAL.AstralConcept]Astral[/hyperlink] sente uma terrível tempestade de [hyperlink,GLOBAL.AstralFlowsLoreConcept]correntes mágicas[/hyperlink] se reunindo sobre sua cidade do trono."

msgid "STORY_EVENT@1122_68@BODY_LORE"
msgstr "As energias fluentes do {GLOBAL.AstralSeaLoreConcept.Hyperlink}, aquela mestra volúvel, fluem entre seus principais condutos. Quando as ondas astrais colidem e caem, muita energia pode inundar um reino que abriga qualquer {PlayerLeader.Title} de nota. Hoje, esse {PlayerLeader.Title} é você."

msgid "STORY_EVENT@1122_68@BUTTON_0"
msgstr "Salve {EventCity} absorvendo as energias devastadoras [mana/]."

msgid "STORY_EVENT@1122_68@BUTTON_1"
msgstr "Dissipe a tempestade [mana/] para vislumbrar três nexos Astrais."

msgid "STORY_EVENT@1122_68@BUTTON_2"
msgstr "Lance a tempestade em um molde e forje [structureprod/] um {EventItem} [item/]!"

msgid "STORY_EVENT@1122_68@BUTTON_3"
msgstr "Destile as correntes em dois <<m:EventUnit>> [unit/] com a ajuda de seus convocadores [unitprod/]!"

msgid "STORY_EVENT@1122_68@BUTTON_4"
msgstr "Não faça nada. O Mar Astral dá [astralboon/] e consome [population/]."

msgid "STORY_EVENT@1122_68@TITLE"
msgstr "Tempestade Astral"

msgid "STORY_EVENT@1122_69@BODY_FOOTER"
msgstr "Para um <<PlayerLeader{Master/Mistress}>> da Sombra, esses guerreiros ressurgidos são um presente! Que propósito eles servirão?"

msgid "STORY_EVENT@1122_69@BODY_HEADER"
msgstr "[hyperlink,GLOBAL.ShadowConcept]Sombras[/hyperlink] cobrindo seu reino causam soldados mortos há muito tempo a ressurgirem de seus túmulos em um local de batalha esquecido perto de sua cidade de {EventCity}."

msgid "STORY_EVENT@1122_69@BODY_LORE"
msgstr "Atraídos por sua radiação escura, o exército marcha sobre {EventCity}. <<m:EventUnitB>> arranham seus portões. <<m:EventUnitC>> roem seus muros. <<m:EventUnit>> uivam para as poucas almas vivas que restam em sua cidade do trono. Onde outros desmaiariam ao mero vislumbre dessa horda de revenantes, você vê oportunidade."

msgid "STORY_EVENT@1122_69@BUTTON_0"
msgstr "Vincule [unit/] a companhia não-morta ao seu comando usando magia [mana/]."

msgid "STORY_EVENT@1122_69@BUTTON_1"
msgstr "\"{EventHero}! Despache esses não-mortos! Suas almas [souls/] são minhas.\""

msgid "STORY_EVENT@1122_69@BUTTON_2"
msgstr "\"Necromantes [unitprod/]! Escolha seus cérebros para colher os segredos ancestrais [knowledge/].\""

msgid "STORY_EVENT@1122_69@BUTTON_3"
msgstr "Abra os portões [happiness/]! Os mortos são bem-vindos em {EventCity} [population/]."

msgid "STORY_EVENT@1122_69@BUTTON_4"
msgstr "Deixe-os em paz. Os mortos logo retomarão seu descanso."

msgid "STORY_EVENT@1122_69@BUTTON_5"
msgstr "\"Guardas [unitprod/]! Despache esses não-mortos! Eu preciso de suas almas [souls/].\""

msgid "STORY_EVENT@1122_69@TITLE"
msgstr "Horda de Revenantes"

msgid "STORY_EVENT@1122_6@BODY_FOOTER"
msgstr "\"O que você diz, meu {PlayerLeader.Title}? Você me concederá acesso aos seus tesouros de conhecimento?\""

msgid "STORY_EVENT@1122_6@BODY_HEADER"
msgstr "Durante as negociações, {EventHouseLord.TitleName} de {EventHouse} inesperadamente exige que você compartilhe sua sabedoria e conhecimento com <<P:EventHouseLord>>."

msgid "STORY_EVENT@1122_6@BODY_LORE"
msgstr "As palavras de {EventHouseLord.TitleName} traem <<o:EventHouseLord>> ambição. \"Confesso que busco sua tutela nos caminhos da Magia. Posso avançar minhas aspirações através de sua generosidade e compaixão. Conhecimento é o que eu desejo, Ó {PlayerLeader.TitleName}. Eu me tornaria um aliado poderoso para sua causa!\""

msgid "STORY_EVENT@1122_6@BUTTON_0"
msgstr "\"Eu compartilharei algum do meu conhecimento [knowledge/] com você.\""

msgid "STORY_EVENT@1122_6@BUTTON_1"
msgstr "\"Meus segredos [knowledge/] podem ser seus... por um preço! [gold/]\""

msgid "STORY_EVENT@1122_6@BUTTON_2"
msgstr "\"Não. Dominar a magia é uma jornada, não um destino, {EventHouseLord.Title}.\""

msgid "STORY_EVENT@1122_6@BUTTON_3"
msgstr "\"Você cobiça os segredos de um Godir? Eis aqui eles, e desespere!\""

msgid "STORY_EVENT@1122_6@BUTTON_4"
msgstr "\"Embora seu pedido me divirta, não posso atender ao seu pedido.\""

msgid "STORY_EVENT@1122_6@TITLE"
msgstr "Compartilhando Segredos"

msgid "STORY_EVENT@1122_79@BODY_FOOTER"
msgstr "\"Celebre a fertilidade da primavera comigo, {PlayerLeader.TitleName}! Exponha-me à potência do seu domínio!\" Seu expansionismo pode impressionar o {EventUnit}?"

msgid "STORY_EVENT@1122_79@BODY_HEADER"
msgstr "Um {EventUnit} vem brincando de campos distantes e dança diante de você, flores brotando de onde quer que os pés de <<o:EventUnit>> pousem."

msgid "STORY_EVENT@1122_79@BODY_LORE"
msgstr "Você é atraído para as profundezas dos olhos de <<o:EventUnit>>, como poços sem fundo de água verde fria. A dança de <<Co:EventUnit>> fica mais feroz e intensa. O {EventUnit} parece receber prazer de seus movimentos exagerados, até que <<p:EventUnit>> para repentinamente em uma pose sugestiva, o olhar faminto de <<o:EventUnit>> permanecendo em seu corpo."

msgid "STORY_EVENT@1122_79@BUTTON_0"
msgstr "Desmorone a mina [structureprod/] perto de {EventCityB} para semear sementes [food/] lá."

msgid "STORY_EVENT@1122_79@BUTTON_1"
msgstr "Aumente a taxa de natalidade [population/] [happiness/] de {EventCity} com vinho fino [gold/]."

msgid "STORY_EVENT@1122_79@BUTTON_2"
msgstr "Fortaleça as linhagens de guerreiros [unitprod/] em {EventCity} aumentando suas rações [food/]."

msgid "STORY_EVENT@1122_79@BUTTON_3"
msgstr "Contrate um especialista em criação [gold/] para criar um {EventMount}."

msgid "STORY_EVENT@1122_79@BUTTON_4"
msgstr "\"Não me seduza, Bruxa da Floresta [naturecrisis/]!\""

msgid "STORY_EVENT@1122_79@TITLE"
msgstr "Chamado da Primavera"

msgid "STORY_EVENT@1122_7@BODY_FOOTER"
msgstr "\"Sua fascinação pelo meu {EventItem} me lisonjeia,\" diz {EventHouseLord.Name}, \"mas apenas uma oferta generosa pode me convencer a me separar dele.\""

msgid "STORY_EVENT@1122_7@BODY_HEADER"
msgstr "Durante uma longa discussão sobre termos de comércio, você descobre um {EventItem} esquisito montado na parede de {EventHouseLord.TitleName} de {EventHouse}."

msgid "STORY_EVENT@1122_7@BODY_LORE"
msgstr "Você admira o artesanato do objeto. Mesmo através da Pedra de Sussurro, você pode sentir a poderosa energia fluindo do {EventItem}. Este é um artefato que pertence ao tesouro de um {GLOBAL.GodirLoreConcept.Hyperlink}, não em uma <<g:parede^n,{EventHouseLord.Title}>>! {EventHouseLord.Name} logo percebe seu interesse no objeto e sorri."

msgid "STORY_EVENT@1122_7@BUTTON_0"
msgstr "Ofereça joias [gold/] em troca do {EventItem} [item/]."

msgid "STORY_EVENT@1122_7@BUTTON_1"
msgstr "Troque o {EventItem} [item/] pela sua sabedoria imortal [knowledge/]."

msgid "STORY_EVENT@1122_7@BUTTON_2"
msgstr "\"Isso certamente é um {EventItem} espetacular! Você deve estar muito orgulhoso. [influence/]\""

msgid "STORY_EVENT@1122_7@BUTTON_3"
msgstr "Estude seus desenhos e crie uma cópia para você mesmo."

msgid "STORY_EVENT@1122_7@BUTTON_4"
msgstr "\"Eu não quero seu enfeite frívolo.\""

msgid "STORY_EVENT@1122_7@TITLE"
msgstr "Negociações de Comércio"

msgid "STORY_EVENT@1122_80@BODY_FOOTER"
msgstr "\"Somos guardiões do ciclo, você e eu. Para que a nova vida brote, a mais velha deve morrer. Então, escolha.\""

msgid "STORY_EVENT@1122_80@BODY_HEADER"
msgstr "Sem aviso, uma rajada de folhas o envolve. Um {EventUnit} sombrio avança. \"{PlayerLeader.TitleName}! Limite seu crescimento!\""

msgid "STORY_EVENT@1122_80@BODY_LORE"
msgstr "Com uma voz como o vento através de uma árvore oca, o {EventUnit} entoa: \"O caminho da [hyperlink,GLOBAL.NatureConcept]Natureza[/hyperlink] não é de florescimento sem fim. Tal incursão causa a ruína de todos. Após a estação de inverno trazer a morte, esse vazio é a razão pela qual os recém-nascidos respiram.\" O servo da Natureza desenha um círculo com <<o:EventUnit>> cajado no chão."

msgid "STORY_EVENT@1122_80@BUTTON_0"
msgstr "Pode a população de {EventCity}. Um jovem herói [unit/] florescerá."

msgid "STORY_EVENT@1122_80@BUTTON_1"
msgstr "Colha as sementes já semeadas [unitprod/] e cultive o solo do seu reino [natureboon/]."

msgid "STORY_EVENT@1122_80@BUTTON_2"
msgstr "\"Livres do jugo das minhas ambições [influence/], meu povo se multiplicará [population/].\""

msgid "STORY_EVENT@1122_80@BUTTON_3"
msgstr "\"Você está errado [naturecrisis/]! A expansão do meu império é ilimitada [influence/].\""

msgid "STORY_EVENT@1122_80@BUTTON_4"
msgstr "Reduza a população de {EventCity}. Um jovem herói [unit/] florescerá."

msgid "STORY_EVENT@1122_80@TITLE"
msgstr "Redenção do Inverno"

msgid "STORY_EVENT@1122_81@BODY_FOOTER"
msgstr "Cabe a você adicionar tempero a este terrível \"banquete\". Como você procederá?"

msgid "STORY_EVENT@1122_81@BODY_HEADER"
msgstr "Seu mordomo insistiu que você realizasse um banquete formal para seus distintos súditos. Não surpreendentemente, o evento é tedioso e insosso."

msgid "STORY_EVENT@1122_81@BODY_LORE"
msgstr "Convidados usando vestidos sufocantes e roupas desconfortáveis sentam-se em longas mesas, mastigando solenemente refeições insossas. Trovejadores tocam músicas monótonas reservadas para banquetes refinados, conforme a tradição. Um urso dançarino adormeceu. Um conjurador tenta em vão recuperar suas pombas das vigas do grande salão. Alguém espirra, então prontamente se desculpa."

msgid "STORY_EVENT@1122_81@BUTTON_0"
msgstr "Compartilhe seus melhores vinhos e cervejas [gold/]! Saúde a todos! [happiness/]"

msgid "STORY_EVENT@1122_81@BUTTON_1"
msgstr "Ateie magicamente as cortinas [mana/]! Contemplem o espetáculo! [happiness/]"

msgid "STORY_EVENT@1122_81@BUTTON_2"
msgstr "Busque prazer em formas inibidas de entretenimento [chaoscrisis/]."

msgid "STORY_EVENT@1122_81@TITLE"
msgstr "Revelação Sem Causa"

msgid "STORY_EVENT@1122_82@BODY_FOOTER"
msgstr "O {EventUnitB} desembainha <<o:EventUnitB>> espada com mão trêmula e dúvida persistente em <<o:EventUnitB>> olhos. Como lidar com <<P:EventUnitB>>?"

msgid "STORY_EVENT@1122_82@BODY_HEADER"
msgstr "Um {EventUnitB} em armadura reluzente confronta você. \"Hoje, minha espada acabará com você, escória infernal!\""

msgid "STORY_EVENT@1122_82@BODY_LORE"
msgstr "\"Este é o juramento que fiz perante o {RandomWarriorTitle} do {RandomIdol}: encontrar e despachar o [hyperlink,GLOBAL.ChaosConcept]Caos[/hyperlink] <<PlayerLeader{Mestre/Mestra}>> que causa estragos neste reino! Será meu teste final após deixar para trás uma vida de pecado e depravação! Esse demônio que eu não sou mais!\""

msgid "STORY_EVENT@1122_82@BUTTON_0"
msgstr "Ofereça riquezas [gold/] para corromper o {EventUnitB} em um {EventUnit} [unit/]."

msgid "STORY_EVENT@1122_82@BUTTON_1"
msgstr "Revele segredos infernais [knowledge/] para corromper o {EventUnitB} em um {EventUnit} [unit/]."

msgid "STORY_EVENT@1122_82@BUTTON_2"
msgstr "Imole [mana/] o {EventUnitB} [evilact/] para o Caos [chaosboon/]."

msgid "STORY_EVENT@1122_82@BUTTON_3"
msgstr "Use magia do Caos [mana/] para levantar [goodact/] <<G:juramento^n,EventUnitB>> [chaosboon/].\""

msgid "STORY_EVENT@1122_82@BUTTON_4"
msgstr "\"Contenha sua língua zelosa, Juramentado! Deixe-me em paz [chaoscrisis/].\""

msgid "STORY_EVENT@1122_82@TITLE"
msgstr "Quebrador de Juramento"

msgid "STORY_EVENT@1122_83@BODY_FOOTER"
msgstr "O {EventUnit} percebe você e berra: \"Embody o Caos, {PlayerLeader.TitleName}! Demolish este ídolo falso!\" Você ousa interferir?"

msgid "STORY_EVENT@1122_83@BODY_HEADER"
msgstr "Em um sonho recorrente, um terrível {EventUnit} batalha incessantemente um radiante {EventUnitB} no topo de um planalto montanhoso."

msgid "STORY_EVENT@1122_83@BODY_LORE"
msgstr "Você teve este sonho terrível desde que abraçou [hyperlink,GLOBAL.ChaosConcept]Caos[/hyperlink]. Mas esta noite, parece que os avatares do Caos e da [hyperlink,GLOBAL.OrderConcept]Ordem[/hyperlink] resolverão seu conflito eterno e determinarão quem herdará as ruínas cinzentas do [hyperlink,GLOBAL.AstralSeaLoreConcept]Mar Astral[/hyperlink]. Você discerne mais {GLOBAL.GodirLoreConcept.Hyperlink} sobre Ordem e Caos, todos testemunhando o duelo, seus olhos inundados de medo."

msgid "STORY_EVENT@1122_83@BUTTON_0"
msgstr "Derrote o {EventUnitB} e vincule [unit/] o {EventUnit} à sua vontade."

msgid "STORY_EVENT@1122_83@BUTTON_10"
msgstr "Desvie o olhar [chaoscrisis/] até que a visão termine."

msgid "STORY_EVENT@1122_83@BUTTON_2"
msgstr "Imole {EventUnit}, {EventUnitB} e a si mesmo em um pandemônio de chamas serpenteantes [chaosboon/]!"

msgid "STORY_EVENT@1122_83@BUTTON_9"
msgstr "Mate o {EventUnit}, e o {EventUnitB} concederá a você <<o:EventUnitB>> segredos [chaoscrisis/]."

msgid "STORY_EVENT@1122_83@TITLE"
msgstr "Pandemoniaco"

msgid "STORY_EVENT@1122_8@BODY_FOOTER"
msgstr "\"Assassinos estão atrás de mim! Você deseja fortalecer os laços entre nossas Casas? Então, por favor, mantenha-me seguro(a)!\""

msgid "STORY_EVENT@1122_8@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} de {EventHouse} interrompe suas negociações. \"Não posso fingir mais! Por que negociar se estarei morto amanhã de qualquer jeito!\""

msgid "STORY_EVENT@1122_8@BODY_LORE"
msgstr "<<g:voice^n,{EventHouseLord.Name}>> treme: \"Tenho certeza de que pretendentes ao meu trono estão incitando meu povo contra mim. Eles espalham mentiras sobre minha incompetência como Governante! E agora — tenho certeza disso! — eles pretendem fazer seu movimento... tirando minha vida!\""

msgid "STORY_EVENT@1122_8@BUTTON_0"
msgstr "\"Guardas [unitprod/] de {EventCity} manterão você seguro.\""

msgid "STORY_EVENT@1122_8@BUTTON_1"
msgstr "\"{EventHero} [unit/] será seu guarda-costas pessoal, meu amigo. [goodact/]\""

msgid "STORY_EVENT@1122_8@BUTTON_2"
msgstr "\"A sede de sangue obrigará seus pretendentes a se massacrarem [evilact/].\""

msgid "STORY_EVENT@1122_8@BUTTON_3"
msgstr "\"Inquisidores julgarão esses pretendentes perante um tribunal de minha criação!\""

msgid "STORY_EVENT@1122_8@BUTTON_4"
msgstr "\"Assassinos?! Sua imaginação está descontrolada, {EventHouseLord.Title}. Você ficará bem.\""

msgid "STORY_EVENT@1122_8@TITLE"
msgstr "Salvando os Mansos"

msgid "STORY_EVENT@1122_95@BODY_FOOTER"
msgstr "\"Você pode me ajudar a encontrar meu <<EventUnit{irmão/irmã}>>, meu {PlayerLeader.Title}? Estou preocupado com a segurança de <<o:EventUnit>>! Permita-me marcar a {EventStructure} em seu mapa.\""

msgid "STORY_EVENT@1122_95@BODY_HEADER"
msgstr "\"<<PlayerLeader.TitleName>>!\" Seu [hyperlink,GLOBAL.HeroConcept]<<EventHero{herói/heroína}>>[/hyperlink] {EventHero.Name} ajoelha-se diante de você, angustiado. \"Meu pequeno <<EventUnit{irmão/irmã}>>! <<Cp:EventUnit>> foi procurar pedras preciosas, mas nunca voltou!\""

msgid "STORY_EVENT@1122_95@BODY_LORE"
msgstr "\"<<Cp:EventUnit>> migrou para {EventCity} quando você me recrutou. <<Cp:EventUnit>> tem prospectado pedras e metais preciosos desde que <<p:EventUnit>> era um pequeno <<EventUnit{menino/menina}>>, carregando uma vara de radiestesia grande demais. Recentemente, uma {EventStructure} distante chamou a atenção de <<o:EventUnit>>. Normalmente, meu <<EventUnit{irmão/irmã}>> retorna com um grande butim em três dias. Hoje é o oitavo dia desde que <<p:EventUnit>> partiu.\" <<G:eyes^n,EventHero>> ficam lacrimejantes."

msgid "STORY_EVENT@1122_95@BUTTON_0"
msgstr "\"Vou procurar seu <<EventUnit{irmão/irmã}>>, {EventHero.FirstName}. Tenho certeza de que <<p:EventUnit>> está bem.\""

msgid "STORY_EVENT@1122_95@BUTTON_2"
msgstr "\"Não posso ajudá-lo. Que <<p:EventUnit>> retorne em breve.\""

msgid "STORY_EVENT@1122_95@TITLE"
msgstr "<<EventUnit{Irmão/Irmã}>> Tesouro"

msgid "STORY_EVENT@1122_96@BODY_FOOTER"
msgstr "O {EventUnit} suspira agradecido. \"Por me resgatar, por favor, aceite o tesouro que descobri. Minhas habilidades estão a serviço de {PlayerLeader.TitleName}.\""

msgid "STORY_EVENT@1122_96@BODY_FOOTER@PLAYER_LEADS"
msgstr "O {EventUnit} suspira agradecido. \"Por me resgatar, por favor, aceite o tesouro que descobri. Minhas habilidades estão a seu serviço, {PlayerLeader.TitleName}.\""

msgid "STORY_EVENT@1122_96@BODY_FOOTER@QUESTGIVER_LEADS"
msgstr "O {EventUnit} suspira agradecido. \"Por me resgatar, por favor, aceite o tesouro que descobri. Minhas habilidades estão a serviço de {PlayerLeader.TitleName}.\""

msgid "STORY_EVENT@1122_96@BODY_HEADER"
msgstr "Suas tropas vasculham a área e os túneis. Quando passam por uma fenda sob a {EventStructure} central, alguém sussurra: \"Eles se foram?\""

msgid "STORY_EVENT@1122_96@BODY_HEADER@PLAYER_LEADS"
msgstr "Você vasculha a área e os túneis. Quando passa por uma fenda sob a {EventStructure} central, alguém sussurra: \"Eles se foram?\""

msgid "STORY_EVENT@1122_96@BODY_HEADER@QUESTGIVER_LEADS"
msgstr "{EventHero} vasculha a área e os túneis. Quando <<p:EventHero>> passa por uma fenda sob a {EventStructure} central, alguém sussurra: \"Eles se foram?\""

msgid "STORY_EVENT@1122_96@BODY_LORE"
msgstr "Um {EventUnit} sai rastejando do esconderijo de <<o:EventUnit>>. \"Eu sabia que alguém viria me procurar eventualmente! Eu me escondi lá embaixo por dias — acho — comendo larvas e musgo viscoso para sobreviver.\" O <<EventUnit{menino/menina}>> ri e produz uma bolsa. \"Mas valeu a pena! Os túneis ao redor desta {EventStructure} estão repletos de rubis!\""

msgid "STORY_EVENT@1122_96@BODY_LORE@PLAYER_LEADS"
msgstr "Um {EventUnit} sai rastejando do esconderijo de <<o:EventUnit>>. \"Eu sabia que {EventHero.FirstName} enviaria alguém para me procurar! Eu nunca imaginei que seria VOCÊ, {PlayerLeader.TitleName}! Eu me escondi lá embaixo por dias — acho — comendo larvas e musgo viscoso para sobreviver.\" O <<EventUnit{menino/menina}>> ri e produz uma bolsa. \"Mas valeu a pena! Os túneis ao redor deste {EventResource} estão repletos de rubis!\""

msgid "STORY_EVENT@1122_96@BODY_LORE@QUESTGIVER_LEADS"
msgstr "Um {EventUnit} sai rastejando do esconderijo de <<o:EventUnit>>. \"Oh, grande <<EventHero{irmão/irmã}>>! Eu sabia que você viria me procurar! Eu me escondi lá embaixo por dias — acho — comendo larvas e musgo viscoso para sobreviver.\" O <<EventUnit{menino/menina}>> ri e produz uma bolsa. \"Mas valeu a pena! Os túneis ao redor desta {EventStructure} estão repletos de rubis!\""

msgid "STORY_EVENT@1122_96@BUTTON_0"
msgstr "\"Sua expertise em metal e pedra [structureprod/] fará {EventCity} prosperar.\""

msgid "STORY_EVENT@1122_96@BUTTON_1"
msgstr "\"Ensine-me [knowledge/] sobre pedras e metais preciosos, bem como o comportamento do <<m:EventUnitB>>.\""

msgid "STORY_EVENT@1122_96@BUTTON_3"
msgstr "\"Eu aceito seu serviço como um {EventUnit} [unit/].\""

msgid "STORY_EVENT@1122_96@BUTTON_4"
msgstr "\"Eu não preciso de recompensa [goodact/]. Estou feliz que você está seguro.\""

msgid "STORY_EVENT@1122_96@TITLE"
msgstr "<<EventUnit{Irmão/Irmã}>> Querido: Desfecho"

msgid "STORY_EVENT@1122_97@BODY_FOOTER"
msgstr "Como alguém poderia sobreviver a esta infestação? É tolice acreditar que <<G:irmão/irmã^n,EventHero>> ainda está vivo?"

msgid "STORY_EVENT@1122_97@BODY_HEADER"
msgstr "Ao chegar na {EventStructure}, fica claro que a prole de um {EventSireUnit} chocou há alguns dias."

msgid "STORY_EVENT@1122_97@BODY_LORE"
msgstr "A {EventStructure} está tomada pelos corpos contorcidos do <<m:EventUnit>>. Seu muco corrosivo escorre para as fissuras próximas. O guincho de seu progenitor pode ser ouvido ecoando dos túneis profundos de onde o <<m:EventUnit>> chocou. O <<m:EventUnit>> tem se alimentado de {RandomAnimalA}, a julgar pelos restos parcialmente dissolvidos que estão espalhados pela área."

msgid "STORY_EVENT@1122_97@BUTTON_0"
msgstr "Atacar o <<m:EventUnit>> para limpar a {EventStructure} de qualquer maneira!"

msgid "STORY_EVENT@1122_97@BUTTON_1"
msgstr "Afaste o {EventUnit} da {EventStructure} com gado fresco [food/] de {EventCity}."

msgid "STORY_EVENT@1122_97@BUTTON_2"
msgstr "Cubra os corpos de suas tropas com o muco de {EventSireUnit} para repelir o <<m:EventUnit>>."

msgid "STORY_EVENT@1122_97@BUTTON_3"
msgstr "Partir. Não há nada que ninguém possa fazer aqui."

msgid "STORY_EVENT@1122_97@TITLE"
msgstr "<<EventUnitB{Irmão/Irmã}>> Querido: Localização"

msgid "STORY_EVENT@1140_393@BODY_FOOTER"
msgstr "Como você usará seus poderes contra os Reis-Feiticeiros?"

msgid "STORY_EVENT@1140_393@BODY_HEADER"
msgstr "Você sabe sobre os perigos que os [hyperlink,GLOBAL.WizardKingLoreConcept]Reis-Feiticeiros[/hyperlink] trazem. {PlayerLeaderWizard.Lord.TitleName}, que você conheceu neste reino, é apenas um deles."

msgid "STORY_EVENT@1140_393@BODY_LORE"
msgstr "Ao longo da sua vida, você ouviu inúmeras histórias sobre os poderosos Reis-Feiticeiros saqueando e pilhando os reinos. Agora você os enfrenta com seus próprios poderes. Você dominou as artes arcanas e ganhou a habilidade de navegar pelo {GLOBAL.AstralSeaLoreConcept.Hyperlink}. Você [hyperlink,GLOBAL.GodirLoreConcept]ascendeu[/hyperlink]. Quando você viu seu reflexo hoje, notou que seus poderes combinam com os dos Reis-Feiticeiros. Um pensamento assustador? Ou esperançoso?"

msgid "STORY_EVENT@1140_393@BUTTON_0"
msgstr "\"Eu apoiarei pessoalmente meu exército [unitprod/].\""

msgid "STORY_EVENT@1140_393@BUTTON_1"
msgstr "\"Meus poderes [mana/] apoiarão meu povo [food/] [happiness/].\""

msgid "STORY_EVENT@1140_393@BUTTON_2"
msgstr "\"Eu aperfeiçoarei meus poderes. Eles superarão os deles [mana/].\""

msgid "STORY_EVENT@1140_393@BUTTON_3"
msgstr "\"Um melhor entendimento [knowledge/] dos Fluxos Astrais nos dará uma vantagem.\""

msgid "STORY_EVENT@1140_393@TITLE"
msgstr "Perigo dos Reis-Feiticeiros"

msgid "STORY_EVENT@1140_394@BODY_FOOTER"
msgstr "\"O que devemos fazer contra esses monstros?\""

msgid "STORY_EVENT@1140_394@BODY_HEADER"
msgstr "Histórias de monstros marinhos na costa de {EventCity.Name} chamam sua atenção."

msgid "STORY_EVENT@1140_394@BODY_LORE"
msgstr "Histórias de fantasmas sobre criaturas no {EventSpawner} não são incomuns, mas recentemente essas histórias se tornaram mais frequentes. Seus cidadãos descrevem ataques por monstros terríveis como o {EventStackLeader} em detalhes chocantes. Um de seus conselheiros sugere: \"Podemos focar nosso exército no problema, ou podemos contratar alguns mercenários para eliminar o {EventSpawner}. Claro, sempre há a opção de cuidar desses chamados fantasmas nós mesmos...\""

msgid "STORY_EVENT@1140_394@BUTTON_0"
msgstr "Ordene que seus instrutores militares [unitprod/] expulsem os monstros da sua costa."

msgid "STORY_EVENT@1140_394@BUTTON_1"
msgstr "Pague [gold/] mercenários para colocar o {EventSpawner} em repouso."

msgid "STORY_EVENT@1140_394@BUTTON_2"
msgstr "Não faça nada. Você cuidará disso pessoalmente."

msgid "STORY_EVENT@1140_394@BUTTON_3"
msgstr "Histórias de fantasmas são sua especialidade. Mostre a esses monstros alguns horrores seus..."

msgid "STORY_EVENT@1140_394@TITLE"
msgstr "Histórias Terríveis"

msgid "STORY_EVENT@1140_436@BODY_FOOTER"
msgstr "\"Devemos levar Meandor ao Convênio. Não podemos permitir que o esquema dos Shad'rai continue sem que possamos interferir.\""

msgid "STORY_EVENT@1140_436@BODY_HEADER"
msgstr "{Sundren.FirstName} se aproxima de você. \"O estado mental de Meandor é... preocupante.\""

msgid "STORY_EVENT@1140_436@BODY_LORE"
msgstr "\"Não posso deixar de sentir que os {GLOBAL.ShadraiFactionLoreConcept.Hyperlink} estão por trás disso. Típico desses tolos mexerem com {GLOBAL.GodirLoreConcept.Hyperlink} que foram avisados para evitar—não importa. {Meandor.FirstName} é crucial para o {GLOBAL.CovenantFactionLoreConcept.Hyperlink} seguir os Shad'rai a tempo. E, tenho que admitir, tenho... razões pessoais para procurá-lo também. Com meu pai desaparecido e minha mãe desaparecida... Tenho perguntas e dúvidas que apenas ele pode responder.\""

msgid "STORY_EVENT@1140_436@BUTTON_3"
msgstr "\"Entendido.\""

msgid "STORY_EVENT@1140_436@TITLE"
msgstr "Herança Sombria"

msgid "STORY_EVENT@1140_437@BODY_FOOTER"
msgstr "De repente, você se sente cansado. Talvez precise deitar, olhar para as estrelas por um tempo... Algo não está certo, mas você sente seus olhos se fechando..."

msgid "STORY_EVENT@1140_437@BODY_HEADER"
msgstr "Enquanto viaja pela Corte Eterna, seu caminho é bloqueado por uma aparição, que afirma ser um espírito do seu próprio passado!"

msgid "STORY_EVENT@1140_437@BODY_LORE"
msgstr "\"{PlayerLeader.FirstName}, você pode ter esquecido de mim... Tantos Godir esquecem seu passado. Essa 'busca' sua é tão cansativa. Deite-se comigo em vez disso, olhe para as estrelas comigo, como fazíamos antes. Lembra? Pegue minha mão... descanse...\" As estrelas atrás de <<P:EventHero>> piscam, e por um momento parecem olhos."

msgid "STORY_EVENT@1140_437@BUTTON_2"
msgstr "[Order/] Use luz sagrada para atravessar essa aparição."

msgid "STORY_EVENT@1140_437@BUTTON_3"
msgstr "[Nature/] Concentre-se no ser por trás da aparição."

msgid "STORY_EVENT@1140_437@BUTTON_4"
msgstr "[Chaos/] Destrua a aparição."

msgid "STORY_EVENT@1140_437@BUTTON_5"
msgstr "[Arcana/] Aumente sua visão para ver através dessa aparição."

msgid "STORY_EVENT@1140_437@BUTTON_6"
msgstr "[Shadow/] Use seu conhecimento de engano para ver através dessa aparição."

msgid "STORY_EVENT@1140_437@BUTTON_7"
msgstr "[Matter/] Alcance através da aparição para encontrar a verdade por trás dela."

msgid "STORY_EVENT@1140_437@TITLE"
msgstr "Passado Encantador"

msgid "STORY_EVENT@1140_622@BODY_FOOTER"
msgstr "\"Seis forças poderosas da criação travam guerra para manter suas leis. E você, ó {PlayerLeader.Title}. Como terminará esta guerra sem fim de equilíbrio e esperança?\""

msgid "STORY_EVENT@1140_622@BODY_HEADER"
msgstr "Depois de se estabelecer no reino dilacerado pela guerra, um rugido distante chama sua atenção. \"{PlayerLeader.Title}, você pisa nos campos de batalha cósmicos da Guerra das Cinzas.\""

msgid "STORY_EVENT@1140_622@BODY_LORE"
msgstr "A voz se torna lamentosa. \"Seis {GLOBAL.DragonsLoreConcept.Hyperlink} ancestrais, irmãos e irmãs na Criação, dilacerados pela discórdia. De um lado, os Reformadores. {CreatorDragon.FirstName}, {DestroyerDragon.FirstName} e {DeathDragon.FirstName}, guardando o equilíbrio cósmico da criação e destruição. Do outro, os Guardiões da Aurora {NatureDragon.FirstName}, {OrderDragon.FirstName} e {AstralDragon.FirstName}, lutando para manter a preciosa beleza da vida e do espírito.\""

msgid "STORY_EVENT@1140_622@BUTTON_0"
msgstr "\"A vida é sagrada e deve ser protegida. Concordo com os Guardiões da Alvorada.\""

msgid "STORY_EVENT@1140_622@BUTTON_1"
msgstr "\"Precisa haver um equilíbrio entre criação e destruição. Os Reformadores parecem entender isso.\""

msgid "STORY_EVENT@1140_622@BUTTON_2"
msgstr "\"Esta Guerra Cinzenta terminará por minha mão e apenas por ela.\""

msgid "STORY_EVENT@1140_622@TITLE"
msgstr "A Guerra Cinzenta"

msgid "STORY_EVENT@1140_623@BODY_FOOTER"
msgstr "Seu povo o aclama enquanto você retorna a {GLOBAL.MagehavenLoreConcept.Hyperlink}, vitorioso."

msgid "STORY_EVENT@1140_623@BODY_HEADER"
msgstr "Você se aliou aos Guardiões da Alvorada e garantiu uma vitória para os defensores da vida e do espírito."

msgid "STORY_EVENT@1140_623@BODY_LORE"
msgstr "Sob seu olhar atento, o reino floresce com vida enquanto os vitoriosos {GLOBAL.DragonsLoreConcept.Hyperlink} ascendem nos céus para espalhar justiça, conhecimento e glória verdejante. Talvez o cosmos precise de destruição e morte, mas não neste reino. Não hoje."

msgid "STORY_EVENT@1140_623@BUTTON_0"
msgstr "Uma vitória gloriosa para {PlayerLeader.TitleName}."

msgid "STORY_EVENT@1140_623@TITLE"
msgstr "A Guerra Cinzenta: Vitória dos Guardiões da Alvorada"

msgid "STORY_EVENT@1140_624@BODY_FOOTER"
msgstr "Seu povo o aclama enquanto você retorna a {GLOBAL.MagehavenLoreConcept.Hyperlink}, vitorioso."

msgid "STORY_EVENT@1140_624@BODY_HEADER"
msgstr "Você se aliou aos Reformadores e garantiu uma vitória para os guardiões do renascimento e do equilíbrio."

msgid "STORY_EVENT@1140_624@BODY_LORE"
msgstr "Sob seu olhar atento, o ciclo de vida e morte continua. Das cinzas brota nova vida, do luto emergem novas criações. A vida é bela, mas não significa nada sem a morte. Este equilíbrio cósmico não será perturbado. Não hoje."

msgid "STORY_EVENT@1140_624@BUTTON_0"
msgstr "Uma vitória gloriosa para {PlayerLeader.TitleName}."

msgid "STORY_EVENT@1140_624@TITLE"
msgstr "A Guerra Cinzenta: Vitória dos Reformadores"

msgid "STORY_EVENT@1140_625@BODY_FOOTER"
msgstr "Seu povo o aclama enquanto você retorna a {GLOBAL.MagehavenLoreConcept.Hyperlink}, vitorioso."

msgid "STORY_EVENT@1140_625@BODY_HEADER"
msgstr "Com um tremendo esforço, você uniu tanto os Guardiões da Alvorada quanto os Reformadores em uma aliança que eles nunca imaginaram."

msgid "STORY_EVENT@1140_625@BODY_LORE"
msgstr "As negociações são difíceis. Os {GLOBAL.DragonsLoreConcept.Hyperlink} não são conhecidos por sua paciência e natureza perdoadora. Mas você, aquele que eles chamam de Moldador da Alvorada, consegue uni-los como eram antes. Vida e Morte, Ordem e Caos, o etéreo e o físico. A destruição não deve ser indiscriminada, mas é necessária para permitir o verdadeiro progresso. Você consegue formar uma aliança renovada entre eles, trazendo uma paz equilibrada ao reino."

msgid "STORY_EVENT@1140_625@BUTTON_0"
msgstr "Uma vitória gloriosa para {PlayerLeader.TitleName}."

msgid "STORY_EVENT@1140_625@TITLE"
msgstr "A Guerra Cinzenta: Paz e Equilíbrio"

msgid "STORY_EVENT@1140_730@BODY_FOOTER"
msgstr "Por favor"

msgid "STORY_EVENT@1140_730@BODY_HEADER"
msgstr "{Laryssa.Name} cumprimenta você. \"Olá. {Reaver.Name} e seus {ReaverRace.Name} estão lutando contra {Progenitor.Name} e os {ProgenitorRace.Name}. Isso é loucura."

msgid "STORY_EVENT@1140_743@BODY_HEADER"
msgstr "{Reaver.Name} e {Progenitor.Name}"

msgid "STORY_EVENT@1140_757@TITLE"
msgstr "Encontrando os Devastadores"

msgid "STORY_EVENT@1140_75@BODY_FOOTER"
msgstr "O Godir chamado {EventLithyl.FirstName} tenta argumentar mais, mas {EventNimue.FirstName} a dispensa, sem saber que você ouviu esta conversa."

msgid "STORY_EVENT@1140_75@BODY_FOOTER@NIMUE_DEFEATED"
msgstr "O Godir chamado {EventLithyl.FirstName} tenta argumentar mais, mas os guardas não cedem. Nenhum deles parece perceber que você ouviu esta conversa."

msgid "STORY_EVENT@1140_75@BODY_HEADER"
msgstr "O canto de Elya fica mais alto; você sente que sua prisão está próxima. De repente, uma fenda se abre, permitindo que você espie um {GLOBAL.GodirLoreConcept.Hyperlink} de máscara pela metade falando com {EventNimue.FirstName}."

msgid "STORY_EVENT@1140_75@BODY_HEADER@NIMUE_DEFEATED"
msgstr "O canto de {GLOBAL.ElyaLoreConcept.Hyperlink} fica mais alto, você sente que sua prisão está próxima. De repente, uma fenda se abre, permitindo que você espie um {GLOBAL.GodirLoreConcept.Hyperlink} de máscara pela metade falando com os guardas da prisão."

msgid "STORY_EVENT@1140_75@BODY_LORE"
msgstr "\"O que é isso que ouço sobre a {GLOBAL.MaerLoreConcept.Hyperlink} prisioneira?\" O Godir desconhecido diz. \"Nós concordamos que você a libertaria. Ela já serviu ao seu propósito.\"[br/]{EventNimue.FirstName} zombeteia. \"Nós discutimos isso. E eu decidi contra. Meu trabalho ainda não está terminado, {EventLithyl.FirstName}!\"[br/]O Godir de máscara pela metade responde, irritado, \"Você é tolo. O {GLOBAL.CovenantFactionLoreConcept.Hyperlink} já está investigando. Se eles descobrirem sobre o Gildercoil...\""

msgid "STORY_EVENT@1140_75@BODY_LORE@NIMUE_DEFEATED"
msgstr "\"O que é isso que ouço sobre a {GLOBAL.MaerLoreConcept.Hyperlink} prisioneira?\" O Godir desconhecido diz. \"Eu pedi a {EventNimue.FirstName} para libertá-la. Ela já serviu ao seu propósito.\"[br/]O guarda responde. \"A {EventNimue.Title} decidiu contra isso, {EventLithyl.Title} {EventLithyl.FirstName}.\"[br/]O Godir de máscara pela metade responde, irritado, \"O tolo. O {GLOBAL.CovenantFactionLoreConcept.Hyperlink} já está investigando. Se eles descobrirem sobre o Gildercoil...\""

msgid "STORY_EVENT@1140_75@BUTTON_0"
msgstr "Deixe os Shad'rai com suas brigas."

msgid "STORY_EVENT@1140_75@TITLE"
msgstr "Aproximando-se da Prisão"

msgid "STORY_EVENT@1149_11@BODY_FOOTER"
msgstr "Seu guarda chama sua atenção ao falar: \"Poderoso {PlayerLeader.Title}, o que devemos fazer com o ladrão?\""

msgid "STORY_EVENT@1149_11@BODY_HEADER"
msgstr "Há tumulto perto do seu tesouro, onde você guarda seus tesouros preciosos. Um dos seus guardas traz um <<EventHero{homem/mulher}>> da {EventRace} na sua frente."

msgid "STORY_EVENT@1149_11@BODY_LORE"
msgstr "\"Encontramos este ladrão tentando roubar o {EventItem} do seu tesouro,\" o guarda explica. O ladrão olha para você com medo nos olhos de <<o:EventHero>>. <<Cp:EventHero>> percebe o quão sagrado é o tesouro de um [hyperlink,GLOBAL.DragonsLoreConcept]Dragão[/hyperlink] e quão iracundos os Dragões são conhecidos por serem. Tendo entrado no seu cofre, <<p:EventHero>> precisa ser punido."

msgid "STORY_EVENT@1149_11@BUTTON_0"
msgstr "\"Tire <<P:EventHero>> de <<o:EventHero>> pertences e leve o que é valioso para o meu tesouro.\" [item/]"

msgid "STORY_EVENT@1149_11@BUTTON_1"
msgstr "\"Se <<p:EventHero>> valoriza <<o:EventHero>> vida, <<p:EventHero>> enriquecerá [gold/] meu tesouro em vez disso.\""

msgid "STORY_EVENT@1149_11@BUTTON_10"
msgstr "\"Os fortes se alimentam dos fracos. Lembre-se disso enquanto eu me banqueteio com este ladrão.\" [evilact/] [natureboon/]"

msgid "STORY_EVENT@1149_11@BUTTON_11"
msgstr "\"Realize uma cerimônia. <<Cp:EventHero>> será sacrificado à nossa fé.\" [evilact/] [orderboon/]"

msgid "STORY_EVENT@1149_11@BUTTON_12"
msgstr "\"Amarre <<o:EventHero>> alma ao meu cofre para guardar o lugar por toda a eternidade.\" [evilact/] [shadowboon/]"

msgid "STORY_EVENT@1149_11@BUTTON_2"
msgstr "\"Mate o ladrão e queime <<o:EventHero>> aldeia natal. Ninguém toca no meu tesouro!\" [evilact/] [influence/]"

msgid "STORY_EVENT@1149_11@BUTTON_3"
msgstr "\"Exile <<P:EventHero>>! <<Cp:EventHero>> contará histórias sobre o meu tesouro.\" [influence/]"

msgid "STORY_EVENT@1149_11@BUTTON_4"
msgstr "\"Invocar os terrores do Mar Astral sobre <<P:EventHero>>.\" [evilact/] [astralboon/]"

msgid "STORY_EVENT@1149_11@BUTTON_5"
msgstr "\"Mate o ladrão e queime <<o:EventHero>> casa. Ninguém toca no meu tesouro!\" [evilact/] [chaosboon/]"

msgid "STORY_EVENT@1149_11@BUTTON_6"
msgstr "\"Banhe {EventHero.FirstName} no ouro que <<p:EventHero>> tanto deseja... até <<p:EventHero>> se afogar.\" [evilact/] [materiumboon/]"

msgid "STORY_EVENT@1149_11@TITLE"
msgstr "Ladrão"

msgid "STORY_EVENT@1149_12@BODY_FOOTER"
msgstr "\"Por favor, aceite nosso tributo!\" O líder do grupo remove a lona com um floreio, revelando um ovo gigante. Um ovo de Dragão."

msgid "STORY_EVENT@1149_12@BODY_HEADER"
msgstr "Você ouve as rodas de uma carroça se aproximando. Uma lona cobre um grande objeto redondo embaixo."

msgid "STORY_EVENT@1149_12@BODY_LORE"
msgstr "Um grupo de figuras encapuzadas arrastando a carroça vem diretamente em sua direção. Enquanto se curvam na sua frente, você percebe que são cidadãos de {EventHouse}. Seu líder fala: \"Viaamos longe para trazer isso como um tributo, ó {PlayerLeader.Title}. Foi mantido seguro em um santuário escondido, até que um Dragão digno retornasse.\""

msgid "STORY_EVENT@1149_12@BUTTON_0"
msgstr "\"Eu vou chocá-lo e criá-lo [food/] para se tornar um poderoso Dragão [unit/].\""

msgid "STORY_EVENT@1149_12@BUTTON_1"
msgstr "Coma-o [evilact/] para ganhar seu poder [xp/]. \"Eu serei o único!\""

msgid "STORY_EVENT@1149_12@BUTTON_2"
msgstr "\"Será uma honra ver {EventHouse} chocar um novo Dragonkin [allegiance/].\""

msgid "STORY_EVENT@1149_12@TITLE"
msgstr "O Dom"

msgid "STORY_EVENT@1149_13@BODY_FOOTER"
msgstr "Você pode sentir dois grupos de presas dignas de um Dragão do seu estatuto."

msgid "STORY_EVENT@1149_13@BODY_HEADER"
msgstr "Desejos ancestrais dentro de você despertam, e você sente o desejo de caçar de repente o dominar."

msgid "STORY_EVENT@1149_13@BODY_LORE"
msgstr "Como um [hyperlink,GLOBAL.DragonsLoreConcept]Dragão[/hyperlink], você tem poder ilimitado. Você pode voar mais alto que os pássaros, canalizar magia desconhecida para os feiticeiros. Reis se curvam diante do seu poder. No entanto, às vezes a besta dentro de você acorda e você sente desejos. Desejos de caçar."

msgid "STORY_EVENT@1149_13@BUTTON_0"
msgstr "Caçar gado [food/] a caminho de {PlayerCity}."

msgid "STORY_EVENT@1149_13@BUTTON_1"
msgstr "Devorar [evilact/] os {EventRace} em uma das aldeias da fronteira de {EventHouse}."

msgid "STORY_EVENT@1149_13@BUTTON_2"
msgstr "Suprimir [morale/] o desejo. Você não é escravo dos seus desejos."

msgid "STORY_EVENT@1149_13@TITLE"
msgstr "Desejo de Caça"

msgid "STORY_EVENT@1149_19@BODY_FOOTER"
msgstr "Você conhece <<G:location^n,EventHero>>. Você quer se engajar?"

msgid "STORY_EVENT@1149_19@BODY_HEADER"
msgstr "Um desafio passado de boca em boca chama sua atenção. {EventHero} proclama <<r:EventHero>> um matador de dragões e você como <<o:EventHero>> alvo."

msgid "STORY_EVENT@1149_19@BODY_LORE"
msgstr "Há rumores de que <<p:EventHero>> matou dragões antes. <<Cp:EventHero>> é dito ser um [hyperlink,GLOBAL.HeroConcept]<<EventRuler{hero/heroine}>>[/hyperlink] que toma vingança pelo terror infligido por [hyperlink,GLOBAL.DragonsLoreConcept]Dragões[/hyperlink] ao longo dos tempos. \"Nós deveríamos dar uma lição em <<P:EventHero>>, {PlayerLeader.TitleName}\", um de seus subordinados diz."

msgid "STORY_EVENT@1149_19@BUTTON_0"
msgstr "Nós lidaremos com esse chamado \"herói\"."

msgid "STORY_EVENT@1149_19@BUTTON_1"
msgstr "Ignore <<P:EventHero>>."

msgid "STORY_EVENT@1149_19@BUTTON_2"
msgstr "\"Eu me recuso a lutar [goodact/], e convencerei {EventHero.FirstName} [influence/] de que nem todos os dragões são maus.\""

msgid "STORY_EVENT@1149_19@TITLE"
msgstr "Matador de Dragões"

msgid "STORY_EVENT@1149_20@BODY_FOOTER"
msgstr "Seu povo olha para você com expectativa enquanto você pondera sobre o Matador de Dragões caído. O que você faz?"

msgid "STORY_EVENT@1149_20@BODY_HEADER"
msgstr "{EventHero} jaz morto na terra. A luta acabou."

msgid "STORY_EVENT@1149_20@BODY_LORE"
msgstr "\"Você superou <<P:EventHero>>, mas mais poderiam sempre seguir. Na história do seu povo, sempre há matadores de dragões envolvidos. Em {GLOBAL.AthlaLoreConcept.Hyperlink}, um mundo bastante parecido com este, {GLOBAL.DragonsLoreConcept.Hyperlink} foram caçados até a extinção. Você não deixará isso acontecer aqui. Você precisa enviar um sinal.\""

msgid "STORY_EVENT@1149_20@BUTTON_0"
msgstr "Que isso seja uma lição. Nenhum {PlayerLeader.Title}, nem os {EventRace} se curvarão a heróis insignificantes. [influence/]"

msgid "STORY_EVENT@1149_20@BUTTON_1"
msgstr "Exibir o corpo carbonizado de <<o:EventHero>> em sua capital, como uma mensagem para outros \"matadores de dragões\" ambiciosos. [happiness/]"

msgid "STORY_EVENT@1149_20@BUTTON_3"
msgstr "Dê a {EventHero} um enterro de Dragão para honrar <<P:EventHero>>. [goodact/]"

msgid "STORY_EVENT@1149_20@BUTTON_4"
msgstr "Alimente-se do cadáver para obter poder. [evilact/] [xp/]"

msgid "STORY_EVENT@1149_20@TITLE"
msgstr "Matador de Dragões: Consequências"

msgid "STORY_EVENT@1149_22@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um dos seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para começar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> com {EventHouse} e gradualmente melhorar sua {GLOBAL.HouseInfluenceConcept.Hyperlink} para com você."

msgid "STORY_EVENT@1149_22@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} de {EventHouse.Name} cumprimenta você com um aceno."

msgid "STORY_EVENT@1149_22@BODY_LORE"
msgstr "\"Saudações, {PlayerLeader.TitleName}! Você, como nós, parece entender o que é necessário para descartar as amarras que oprimem este reino. Seu povo está unido sob a bandeira do progresso. Nossos interesses estão alinhados. Vamos agir sobre isso.\""

msgid "STORY_EVENT@1149_22@BUTTON_0"
msgstr "Inspecionar seu poderio militar."

msgid "STORY_EVENT@1149_22@BUTTON_2"
msgstr "Deixá-los em paz. Você tem outros planos."

msgid "STORY_EVENT@1149_22@TITLDLC@EMPIRESANDASHES@E"
msgstr "Encontrando Pragmático {EventHouse.Name}"

msgid "STORY_EVENT@1149_22@TITLE"
msgstr "Encontrando Pragmático {EventHouse.Name}"

msgid "STORY_EVENT@1149_23@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um dos seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> com {EventHouse} e melhorar gradualmente sua {GLOBAL.HouseInfluenceConcept.Hyperlink} para com você."

msgid "STORY_EVENT@1149_23@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} de {EventHouse.Name} cumprimenta você com um aceno."

msgid "STORY_EVENT@1149_23@BODY_LORE"
msgstr "\"Saudações, {PlayerLeader.TitleName}! Sua cultura nos intriga, e acreditamos que uma cooperação poderia beneficiar a todos. Com nossa tecnologia e sua expertise como {GLOBAL.GodirLoreConcept.Hyperlink}, podemos fazer deste reino verdadeiramente nosso. Por que não estabelecemos comunicação e nos tornamos aliados poderosos?\""

msgid "STORY_EVENT@1149_23@BUTTON_0"
msgstr "Inspecionar {EventHouse.Name}."

msgid "STORY_EVENT@1149_23@BUTTON_2"
msgstr "Recusar a oferta, por enquanto."

msgid "STORY_EVENT@1149_23@TITLE"
msgstr "Encontrando Expansionista {EventHouse.Name}"

msgid "STORY_EVENT@1149_24@BODY_FOOTER"
msgstr "Dê a {EventHouseLord} um dos seus <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> para iniciar <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> com {EventHouse} e melhorar gradualmente sua {GLOBAL.HouseInfluenceConcept.Hyperlink} para com você."

msgid "STORY_EVENT@1149_24@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} de {EventHouse.Name} cumprimenta você com um rosto severo."

msgid "STORY_EVENT@1149_24@BODY_LORE"
msgstr "\"O que você quer neste reino, {PlayerLeader.TitleName}? Conquistar? Saquear? Destruir? Nossas armas estão afiadas, nossas armas estão carregadas. Lutaremos contra você se necessário, mas não vamos nos destruir. Uma solução pacífica seria mais prática. Você concorda?\""

msgid "STORY_EVENT@1149_24@BUTTON_0"
msgstr "Investigar se {EventHouse} é digno da sua atenção."

msgid "STORY_EVENT@1149_24@BUTTON_2"
msgstr "Mantenha seus negócios para você mesmo."

msgid "STORY_EVENT@1149_24@TITLE"
msgstr "Encontrando Militante {EventHouse.Name}"

msgid "STORY_EVENT@1149_25@BODY_FOOTER"
msgstr "Você está em guerra com {EventHouse.Name}."

msgid "STORY_EVENT@1149_25@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} cumprimenta você com hostilidade."

msgid "STORY_EVENT@1149_25@BODY_LORE"
msgstr "\"Você está em nosso caminho, {PlayerLeader.Name}! A guerra é inevitável. Nós, {EventHouseRace.Name} de {EventHouse.Name}, somos um povo orgulhoso e lutaremos por nossa liberdade. Com nossas lanças afiadas e magelocks carregados, podemos derrotar todos que nos ameaçam, até mesmo você.\""

msgid "STORY_EVENT@1149_25@BUTTON_0"
msgstr "Inspecionar o insolente {EventHouse.Name}."

msgid "STORY_EVENT@1149_25@BUTTON_2"
msgstr "\"Que assim seja!\""

msgid "STORY_EVENT@1149_25@TITLE"
msgstr "Encontrando Hostil {EventHouse.Name}"

msgid "STORY_EVENT@1149_26@BODY_FOOTER"
msgstr "O {EventStackLeader} acena severamente. \"Infelizmente, preciso pedir que você vá embora. Este lugar pertence a {EventHouse}.\""

msgid "STORY_EVENT@1149_26@BODY_HEADER"
msgstr "O som de tiros estilhaça o céu. Nuvens espessas se reúnem ao redor da {EventStructure.Name}. Uma companhia de lutadores da cidade livre está praticando com armas de fecho mágico."

msgid "STORY_EVENT@1149_26@BODY_LORE"
msgstr "Um dos soldados tenta chamar sua atenção. Com um sorriso orgulhoso, <<p:EventStackLeader>> explica: \"Essas armas são o auge da tecnologia, poderosas o suficiente para matar qualquer besta! Ao acionar um interruptor, qualquer um pode se tornar um lutador poderoso. Sua pontaria é importante, é claro, mas sério...\", <<p:EventStackLeader>> atira a cabeça de um boneco de prática para enfatizar <<o:EventStackLeader>> ponto. \"Criamos algo verdadeiramente magnífico aqui.\""

msgid "STORY_EVENT@1149_26@BUTTON_1"
msgstr "\"Parta e {EventCity} lhe dará o melhor treinamento possível.\""

msgid "STORY_EVENT@1149_26@BUTTON_2"
msgstr "\"Eu reclamo esta {EventStructure}. {EventHouse} cairá!\""

msgid "STORY_EVENT@1149_26@BUTTON_3"
msgstr "\"Eu deixarei você com seu treinamento.\""

msgid "STORY_EVENT@1149_26@BUTTON_4"
msgstr "\"Entre no meu serviço e eu te cobrirei de ouro!\""

msgid "STORY_EVENT@1149_26@BUTTON_5"
msgstr "\"Eu desafio você para um duelo! O vencedor fica com a {EventStructure.Name}.\""

msgid "STORY_EVENT@1149_26@TITLE"
msgstr "Prática com armas de fecho mágico"

msgid "STORY_EVENT@1149_2@BODY_FOOTER"
msgstr "Pensar em como longe você chegou o fortalece. Como você usará esse súbito aumento de poder?"

msgid "STORY_EVENT@1149_2@BODY_HEADER"
msgstr "Como um [hyperlink,GLOBAL.WizardKingLoreConcept]Rei-Feiticeiro[/hyperlink], você lembra de seus primeiros passos incertos ao retornar do [hyperlink,GLOBAL.AstralVoidLoreConcept]vazio[/hyperlink], muito antes de chegar a este reino."

msgid "STORY_EVENT@1149_2@BODY_LORE"
msgstr "O tempo passou desde então. Você já ganhou seguidores e fez um nome para si mesmo. Os anos de [hyperlink,GLOBAL.ShadowTrialLoreConcept]tormento[/hyperlink] ficaram para trás e você é capaz de viver o momento novamente. Os {GLOBAL.AstralFlowsLoreConcept.Hyperlink} se curvam à sua vontade. É hora de olhar para frente."

msgid "STORY_EVENT@1149_2@BUTTON_0"
msgstr "Use-o para impressionar [influence/] todo o reino."

msgid "STORY_EVENT@1149_2@BUTTON_1"
msgstr "Concentre-se em seu povo e prepare um banquete [food/]."

msgid "STORY_EVENT@1149_2@BUTTON_2"
msgstr "Crie um exército [unit/] para conquistar este reino."

msgid "STORY_EVENT@1149_2@BUTTON_3"
msgstr "[chaos/] Inspire outros a abraçar seus poderes [unitprod/]."

msgid "STORY_EVENT@1149_2@BUTTON_4"
msgstr "[arcana/] Explore como recriar esse aumento de poder [knowledge/]."

msgid "STORY_EVENT@1149_2@BUTTON_5"
msgstr "[matter/] Inspire seus construtores [structureprod/]."

msgid "STORY_EVENT@1149_2@BUTTON_6"
msgstr "[nature/] Encha {EventCity} com plantas do seu reino natal [happiness/]."

msgid "STORY_EVENT@1149_2@BUTTON_7"
msgstr "[shadow/] Use-o para reunir segredos sussurrados e vendê-los [gold/]."

msgid "STORY_EVENT@1149_2@BUTTON_8"
msgstr "[order/] Atraia a fé do seu povo e converta-a em energia [mana/]."

msgid "STORY_EVENT@1149_2@BUTTON_9"
msgstr "[order/] Armazene-o como mana [mana/] para ser usado depois."

msgid "STORY_EVENT@1149_2@TITLE"
msgstr "Retorno do Rei-Feiticeiro"

msgid "STORY_EVENT@1149_34@BUTTON_3"
msgstr "\"Deixe-me guiá-lo para uma causa mais justa.\" [orderboon/]"

msgid "STORY_EVENT@1149_38@BODY_FOOTER"
msgstr "Você está em guerra com {EventHouse.Name}."

msgid "STORY_EVENT@1149_38@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da [hyperlink,GLOBAL.IndependentCityConcept]Cidade Livre[/hyperlink] {EventHouse.Name} cumprimenta você com um sorriso malicioso."

msgid "STORY_EVENT@1149_38@BODY_LORE"
msgstr "\"Sua chamada [hyperlink,GLOBAL.AlignmentConcept]'benevolência'[/hyperlink] só o torna fraco. Provarei ao povo de {EventHouse}, e a todos neste reino, que não existe certo ou errado... Apenas força e fraqueza.\""

msgid "STORY_EVENT@1149_38@TITLE"
msgstr "Encontrando {EventHouse.Name} Desorientado"

msgid "STORY_EVENT@1149_39@BODY_FOOTER"
msgstr "Você está em guerra com {EventHouse.Name}."

msgid "STORY_EVENT@1149_39@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} olha para você, enojado."

msgid "STORY_EVENT@1149_39@BODY_LORE"
msgstr "\"Como você pode ser tão [hyperlink,GLOBAL.AlignmentConcept]mal[/hyperlink]? Como consegue dormir enquanto aqueles diante de você tremem de medo? Talvez eu não tenha chance de derrotá-lo, mas tenho a responsabilidade para com todas as pessoas deste reino de me opor a você. Que as forças combinadas do bem ponham fim ao seu reinado maligno.\""

msgid "STORY_EVENT@1149_39@TITLE"
msgstr "Encontrando {EventHouse.Name} Iludido"

msgid "STORY_EVENT@1149_42@BUTTON_0"
msgstr "Inspecione o autoproclamado justo {EventHouse.Name}."

msgid "STORY_EVENT@1149_42@BUTTON_1"
msgstr "\"Que assim seja!\""

msgid "STORY_EVENT@1149_43@BUTTON_0"
msgstr "Inspecione o belicoso {EventHouse.Name}."

msgid "STORY_EVENT@1149_43@BUTTON_1"
msgstr "\"Que assim seja!\""

msgid "STORY_EVENT@1149_44@BODY_FOOTER"
msgstr "Você está em guerra com {EventHouse.Name}."

msgid "STORY_EVENT@1149_44@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} cumprimenta você com pesar nos olhos."

msgid "STORY_EVENT@1149_44@BODY_LORE"
msgstr "\"É infeliz que nos encontremos assim, {PlayerLeader.TitleName}, mas parece que a guerra entre nós é inevitável. Nós, o povo de {EventHouse.Name}, lutaremos pelo que é [hyperlink,GLOBAL.AlignmentConcept]bom[/hyperlink] e por um futuro mais brilhante. Um futuro sem você.\""

msgid "STORY_EVENT@1149_44@BUTTON_0"
msgstr "Inspecione o preconceituoso {EventHouse.Name}."

msgid "STORY_EVENT@1149_44@BUTTON_1"
msgstr "\"Deixe-me guiá-lo para uma causa mais justa.\" [orderboon/]"

msgid "STORY_EVENT@1149_44@BUTTON_2"
msgstr "\"Que assim seja!\""

msgid "STORY_EVENT@1149_44@TITLE"
msgstr "Encontrando {EventHouse.Name} Enganado"

msgid "STORY_EVENT@1149_45@BODY_FOOTER"
msgstr "Você está em guerra com {EventHouse.Name}."

msgid "STORY_EVENT@1149_45@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} ameaça você."

msgid "STORY_EVENT@1149_45@BODY_LORE"
msgstr "\"Alguns podem considerá-lo um [hyperlink,GLOBAL.GodirLoreConcept]deus[/hyperlink], eu não. Conheço suas fraquezas, sei como fazer até um Godir sangrar. Tema o poder de {EventHouse.Name}, pois seu tempo chegou.\""

msgid "STORY_EVENT@1149_45@BUTTON_0"
msgstr "Inspecione o insolente {EventHouse.Name}."

msgid "STORY_EVENT@1149_45@BUTTON_1"
msgstr "\"Que assim seja!\""

msgid "STORY_EVENT@1149_45@TITLE"
msgstr "Encontrando {EventHouse.Name} Vicioso"

msgid "STORY_EVENT@1149_47@BODY_FOOTER"
msgstr "Não tendo encontrado uma maneira de derrotá-lo, o guardião mecânico parece aguardar sua reação. O que você faz?"

msgid "STORY_EVENT@1149_47@BODY_HEADER"
msgstr "Enquanto se move para atacar seu exército, o {EventStackLeader} mecânico para de repente e inspeciona suas tropas."

msgid "STORY_EVENT@1149_47@BODY_LORE"
msgstr "As engrenagens dentro do corpo metálico de <<o:EventStackLeader>> estão girando. Fumaça escapa das fendas do casco de <<o:EventStackLeader>>. Com um olhar gelado, {EventStackLeader.Name} inspeciona cada oponente, procurando por fraquezas. <<Cp:EventStackLeader>> não parece encontrar nenhuma."

msgid "STORY_EVENT@1149_47@BUTTON_0"
msgstr "Atacá-los de qualquer maneira."

msgid "STORY_EVENT@1149_47@BUTTON_1"
msgstr "Dê-lhes um novo propósito e envie-os em seu caminho. [goodact/]"

msgid "STORY_EVENT@1149_47@BUTTON_2"
msgstr "Use seu estado atordoado para desativar [evilact/] e desmontá-los. [knowledge/]"

msgid "STORY_EVENT@1149_47@BUTTON_3"
msgstr "Tente mudar suas diretivas para servi-lo. [unit/]"

msgid "STORY_EVENT@1149_47@TITLE"
msgstr "Falha ao Seguir a Diretiva"

msgid "STORY_EVENT@1149_4@BODY_FOOTER"
msgstr "Na escuridão, você tinha apenas uma coisa para se agarrar, um pedaço de quem você era antes. Que memória preservou sua sanidade?"

msgid "STORY_EVENT@1149_4@BODY_HEADER"
msgstr "Como um {GLOBAL.WizardKingLoreConcept.Hyperlink}, você viu o {GLOBAL.AstralVoidLoreConcept.Hyperlink}, e memórias dele assombram você. Mesmo agora, você sente sua mente vagando de volta."

msgid "STORY_EVENT@1149_4@BODY_LORE"
msgstr "Você está [hyperlink,GLOBAL.ShadowTrialLoreConcept]assombrado[/hyperlink] por séculos solitários passados flutuando no vasto nada do Vazio, onde vozes monstruosas do seu passado distorceram e deformaram suas convicções mais profundas. Você viu visões de um futuro sombrio repleto de perda e insanidade. Mais de uma vez, você sentiu sua alma se dissolver no vazio sem fim."

msgid "STORY_EVENT@1149_4@BUTTON_0"
msgstr "\"Eu fundei impérios [influence/] que impressionaram Feiticeiros e Reis!\""

msgid "STORY_EVENT@1149_4@BUTTON_1"
msgstr "\"Eu dominei o conhecimento proibido e perdido [knowledge/]!\""

msgid "STORY_EVENT@1149_4@BUTTON_2"
msgstr "\"[order/] Eu comandei legiões de paladinos fervorosos [unit/]!\""

msgid "STORY_EVENT@1149_4@BUTTON_3"
msgstr "\"[chaos/] Eu criei [population/] uma hoste de servos selvagens!\""

msgid "STORY_EVENT@1149_4@BUTTON_4"
msgstr "\"[arcana/] Eu era um artista do arcano [mana/]!\""

msgid "STORY_EVENT@1149_4@BUTTON_5"
msgstr "\"[matter/] Eu criei tesouros inigualáveis [gold/] invejados por dragões.\""

msgid "STORY_EVENT@1149_4@BUTTON_6"
msgstr "\"[nature/] Eu cuidei de plantas e bestas, e saboreei seus frutos [food/].\""

msgid "STORY_EVENT@1149_4@BUTTON_7"
msgstr "\"[shadow/] Eu reformei incessantemente [unitprod/] meus súditos nas sombras!\""

msgid "STORY_EVENT@1149_4@BUTTON_8"
msgstr "\"Mortais frágeis se deleitavam [happiness/] com meu esplendor!\""

msgid "STORY_EVENT@1149_4@BUTTON_9"
msgstr "\"Eu ergui [structureprod/] grandes torres em reinos infinitos!\""

msgid "STORY_EVENT@1149_4@TITLE"
msgstr "Ecos do vazio"

msgid "STORY_EVENT@1149_6@BODY_FOOTER"
msgstr "Ao reviver momentos passados da sua vida, você encontra mais um item que lembra de onde veio. O que é?"

msgid "STORY_EVENT@1149_6@BODY_HEADER"
msgstr "Ao procurar pelos suprimentos do seu exército, um dos seus {EventRace.Name} encontra um recipiente com itens que você achava perdidos há muito tempo."

msgid "STORY_EVENT@1149_6@BODY_LORE"
msgstr "A caixa contém pertences que sobreviveram às suas viagens e aventuras. Cada item contém memórias da sua vida anterior. Uma memória da sua infância. Da primeira vez que usou um feitiço. Do momento em que se tornou um líder."

msgid "STORY_EVENT@1149_6@BUTTON_0"
msgstr "Uma arma [item/] tirada de um inimigo feroz."

msgid "STORY_EVENT@1149_6@BUTTON_1"
msgstr "Um anel [item/] representando seu vínculo com alguém especial."

msgid "STORY_EVENT@1149_6@BUTTON_10"
msgstr "A {EventItemArmor}, um presente de um amigo falecido [item/]."

msgid "STORY_EVENT@1149_6@BUTTON_2"
msgstr "[ordem/] Um artefato [item/] da sua fé."

msgid "STORY_EVENT@1149_6@BUTTON_3"
msgstr "[caos/] O poderoso {EventItemChaos} [item/] que o acompanhou sempre que você criou caos."

msgid "STORY_EVENT@1149_6@BUTTON_4"
msgstr "[arcana/] Um item encantado [item/] que o ajudou a aprender magia."

msgid "STORY_EVENT@1149_6@BUTTON_5"
msgstr "[matéria/] Um item [item/] que você ajudou a criar."

msgid "STORY_EVENT@1149_6@BUTTON_6"
msgstr "[natureza/] O {EventItemNature} [item/], representando seu vínculo com a natureza."

msgid "STORY_EVENT@1149_6@BUTTON_7"
msgstr "[sombra/] Uma memória [item/] da primeira vez que você caminhou pelas sombras."

msgid "STORY_EVENT@1149_6@BUTTON_9"
msgstr "Ficar preso ao passado só vai te segurar. Venda tudo [ouro/]."

msgid "STORY_EVENT@1149_6@TITLE"
msgstr "Lembranças da sua vida anterior"

msgid "STORY_EVENT@1149_7@BODY_FOOTER"
msgstr "Parece que há rumores entre seu povo de que você se tornou distante deles. Como você responde?"

msgid "STORY_EVENT@1149_7@BODY_HEADER"
msgstr "O(a) <<EventUnit {presidente/presidenta}>> do Conselho {EventRace} se aproxima de você: \"Saudações {PlayerLeader.TitleName}, posso falar abertamente?\""

msgid "STORY_EVENT@1149_7@BODY_LORE"
msgstr "Sem esperar por sua resposta, <<p:EventUnit>> continua: \"Você sempre foi um de nós, pessoas comuns, mas agora você [hyperlink,GLOBAL.GodirLoreConcept]ascendeu[/hyperlink]. Com suas habilidades mágicas e sua imortalidade, você está muito acima de nós e tememos que você se torne como os [hyperlink,GLOBAL.WizardKingLoreConcept]Reis-Feiticeiros[/hyperlink].\""

msgid "STORY_EVENT@1149_7@BUTTON_0"
msgstr "Ofereça um banquete [ouro/] para mostrar seu afeto [felicidade/]."

msgid "STORY_EVENT@1149_7@BUTTON_1"
msgstr "Organize [produção/] uma feira que honre [influência/] o passado da raça do jogador."

msgid "STORY_EVENT@1149_7@BUTTON_2"
msgstr "Investigue [conhecimento/] os rumores e descubra o que exatamente seu povo quer [felicidade/]."

msgid "STORY_EVENT@1149_7@BUTTON_3"
msgstr "Suprima esses rumores com força [produção de unidade/]. Eles não devem questioná-lo! [felicidade/] [ato maligno/]"

msgid "STORY_EVENT@1149_7@BUTTON_4"
msgstr "Ignore-os [felicidade/]. Você tem outros problemas."

msgid "STORY_EVENT@1149_7@TITLE"
msgstr "O Custo da Ascensão"

msgid "STORY_EVENT@1149_8@BODY_FOOTER"
msgstr "Um dos seus conselheiros avança: \"Precisamos responder a eles, caso contrário, suas reivindicações agressivas causarão agitação em {EventCity}. Qual é o seu plano?\""

msgid "STORY_EVENT@1149_8@BODY_HEADER"
msgstr "\"{PlayerLeader.TitleName}, não queremos você aqui\", declara o(a) {EventHero} de aparência dura que se aproxima de você sem hesitação."

msgid "STORY_EVENT@1149_8@BODY_LORE"
msgstr "\"Eu sou o representante escolhido dos {EventRace}. Estávamos aqui muito antes de você pisar neste reino. Ouvimos histórias de <<m:{GLOBAL.WizardKingLoreConcept.Hyperlink}>>. Você só traz destruição! Vamos nos levantar contra você!\" Enquanto um dos seus guardas segura o causador de problemas, outro guarda fala com você: \"Eu ouvi falar deles. Eles montaram seu acampamento perto de {EventCity}...\""

msgid "STORY_EVENT@1149_8@BUTTON_0"
msgstr "\"Acalme-os com comida [comida/] para mostrar sua boa vontade.\" [ato bom/]"

msgid "STORY_EVENT@1149_8@BUTTON_1"
msgstr "\"Envie nossos estudiosos [conhecimento/] para negociar um tratado. Faça-os se juntar [população/] à nossa nação.\""

msgid "STORY_EVENT@1149_8@BUTTON_2"
msgstr "\"Ofereça grandes riquezas [ouro/] a todos que se juntarem às minhas forças.\" [unidade/]"

msgid "STORY_EVENT@1149_8@BUTTON_3"
msgstr "\"Mate <<P:EventHero>> e <<o:EventHero>> conspiradores. Use toda a força necessária.\" [produção de unidade/]"

msgid "STORY_EVENT@1149_8@BUTTON_4"
msgstr "\"Jogar <<P:EventHero>> em nossa prisão vai deter qualquer oposição.\" [evilact/]"

msgid "STORY_EVENT@1149_8@BUTTON_5"
msgstr "\"Deixe-os em paz.\" [happiness/]"

msgid "STORY_EVENT@1149_8@TITLE"
msgstr "Oposição Nativa"

msgid "STORY_EVENT@1160_1605@BODY_FOOTER"
msgstr "Though the worst has passed, the volatile energies of the realm remain in flux, driving many towards violence and delirium still—especially on the battlefield."

msgid "STORY_EVENT@1160_1605@BODY_HEADER"
msgstr "The roaring beneath the earth recedes, yet the taint of madness still clings to every soul upon across the Azh'Ruun Pit."

msgid "STORY_EVENT@1160_1605@BODY_LORE"
msgstr "Though the earth no longer convulses with anger and the boiling seas settled back into uneasy calm, the precedent of mayhem remains. Across {GLOBAL.ObbadothLoreConcept.Hyperlink}, many blood-crazed denizens wander the smoldering streets with wild eyes and trembling hands, while a thunderous rumble still echoes faintly from the abyss below. The [hyperlink,GLOBAL.DemonicOverlordLoreConcept]Demon Overlords[/hyperlink] have relented their manic goading... but only slightly."

msgid "STORY_EVENT@1160_1605@BUTTON_0"
msgstr "\"We endured. Heads down and work on.\" [production/]"

msgid "STORY_EVENT@1160_1605@TITLE"
msgstr "Mayhem Begets Carnage"

msgid "STORY_EVENT@1160_1615@BODY_FOOTER"
msgstr "The Carnage Ritual falters, thus riots break out across the Pit as the outraged abyss drives many denizens of the realm to senseless slaughter."

msgid "STORY_EVENT@1160_1615@BODY_HEADER"
msgstr "The earth shakes. The boiling seas churn. Across The Azh'Ruun Pit, something vast has grown hungry."

msgid "STORY_EVENT@1160_1615@BODY_LORE"
msgstr "Lesser Fiends scatter in shrieking terror, hurling themselves into molten fissures and scalding rivers alike. Then the roar begins. Vast. Endless. A chorus of abyssal hunger clawing through every soul upon {GLOBAL.ObbadothLoreConcept.Hyperlink}.[br/][br/]\"Carnage! Carnage! More! MORE!\" The [hyperlink,GLOBAL.DemonicOverlordLoreConcept]Demon Overlords[/hyperlink] demand their due."

msgid "STORY_EVENT@1160_1615@BUTTON_0"
msgstr "Steel yourself."

msgid "STORY_EVENT@1160_1615@TITLE"
msgstr "A Crisis of Carnage"

msgid "STORY_EVENT@1160_1616@BODY_FOOTER"
msgstr "The worst of the abyssal hunger has thus passed, yet the Carnage Ritual still demands its endless tribute, lest this ravenous ire be awakened again."

msgid "STORY_EVENT@1160_1616@BODY_HEADER"
msgstr "The turbulent madness subsides as the raging abyss beneath the realm withdraws its ravenous ire from The Azh'Ruun Pit."

msgid "STORY_EVENT@1160_1616@BODY_LORE"
msgstr "Slowly, the screams fade. The trembling earth stills.[br/]Across {GLOBAL.ObbadothLoreConcept.Hyperlink}, blood-soaked denizens stagger from their murderous delirium as though waking from a nightmare. Deep beneath the world, the ravenous fury of the [hyperlink,GLOBAL.DemonicOverlordLoreConcept]Demon Overlords[/hyperlink] recedes once more into the dark.[br/][br/]For now, the abyss is sated."

msgid "STORY_EVENT@1160_1616@BUTTON_0"
msgstr "\"The work continues...\" [production/]"

msgid "STORY_EVENT@1160_1616@TITLE"
msgstr "The Nether Realms Subside"

msgid "STORY_EVENT@1160_1617@BODY_FOOTER"
msgstr "As the Carnage Ritual falters, volatile magical currents surge across the realm, driving all but the strongest minds into frenzied abandon."

msgid "STORY_EVENT@1160_1617@BODY_HEADER"
msgstr "The abyss roars anew as escalating madness sweeps across {GLOBAL.ObbadothLoreConcept.Hyperlink} like a plague of slaughter."

msgid "STORY_EVENT@1160_1617@BODY_LORE"
msgstr "The ritual falters once more. Again the boiling earth convulses. Again the skies howl with that dreadful chorus rising from beneath the world. Yet this time, the fury is greater. Sharper. Angrier. Across The Azh'Ruun Pit, entire villages abandon all restraint, while frenzied denizens butcher neighbor and kin alike beneath the unseen gaze of the wrathful [hyperlink,GLOBAL.DemonicOverlordLoreConcept]Demon Overlords[/hyperlink].[br/][br/]\"More Carnage! MORE!\""

msgid "STORY_EVENT@1160_1617@BUTTON_0"
msgstr "Hold fast through the mayhem."

msgid "STORY_EVENT@1160_1617@TITLE"
msgstr "The Pit Gone Rabid"

msgid "STORY_EVENT@1160_769@BODY_FOOTER"
msgstr "{EventHero.FirstName} está frustrado com <<o:EventHero>> ambição atual. Você permitirá que <<P:EventHero>> mude de ideia?"

msgid "STORY_EVENT@1160_769@BODY_HEADER"
msgstr "Você é abordado por seu {GLOBAL.HeroConcept.Hyperlink}, {EventHero}. <<Co:EventHero>> expressão traí dejeção e vexação."

msgid "STORY_EVENT@1160_769@BODY_LORE"
msgstr "Após um suspiro profundo, <<p:EventHero>> declara: \"Toda a minha vida, sempre me considerei <<a:CurrentDestiny>>. Mas ultimamente, sou assombrado pela dúvida. Este é o meu caminho destinado para {GLOBAL.RenownConcept.Hyperlink}? Ou traçar outro curso me levará ao sucesso e à satisfação que atualmente me faltam, mas que tanto desejo?\""

msgid "STORY_EVENT@1160_769@BUTTON_0"
msgstr "\"Mantenha seu curso. Seu destino será cumprido.\""

msgid "STORY_EVENT@1160_769@BUTTON_0@TOOLTIP_AMBITION"
msgstr "{EventHero} mantém <<o:EventHero>> ambição atual de {CurrentDestiny}."

msgid "STORY_EVENT@1160_769@BUTTON_1"
msgstr "\"Ser <<a:ReplacementDestiny1>> combina mais com você.\""

msgid "STORY_EVENT@1160_769@BUTTON_2"
msgstr "\"Ser <<a:ReplacementDestiny2>> é uma ambição admirável.\""

msgid "STORY_EVENT@1160_769@TITLE"
msgstr "Mudança de Coração"

msgid "STORY_EVENT@1160_815@BODY_FOOTER"
msgstr "Espera-se que o {StructureResource} resida em seu domínio por {TurnCount} turnos antes de partir."

msgid "STORY_EVENT@1160_815@BODY_HEADER"
msgstr "Batedores relatam que um {StructureResource} trocou a natureza selvagem pelo seu domínio e acampou {EventDirection} de {EventCity}."

msgid "STORY_EVENT@1160_815@BODY_LORE"
msgstr "\"Ainda não o vimos com nossos próprios olhos, meu {PlayerLeader.Title}.\" Você detecta admiração na voz do seu batedor. \"Mas encontramos seu acampamento e as muitas criaturas que <<p:ShopKeeper>> mantém lá. O {ShopKeeper} tem reputação de vendê-las como montarias para quem tem moedas para essas bestas valorizadas.\" Você considera quais adições beneficiariam seu estábulo."

msgid "STORY_EVENT@1160_815@BUTTON_0"
msgstr "\"Desde que as criaturas de <<o:ShopKeeper>> não comam meu {EventRace}, <<p:ShopKeeper>> é bem-vindo.\""

msgid "STORY_EVENT@1160_815@BUTTON_1"
msgstr "\"Dispersem o acampamento de <<o:ShopKeeper>>. Os <<Co:ShopKeeper>> malfeitores não são bem-vindos aqui.\""

msgid "STORY_EVENT@1160_815@TITLE"
msgstr "Mercador de Montarias"

msgid "STORY_EVENT@1160_824@BODY_FOOTER"
msgstr "O Acampamento de Treinamento partirá após {Turns} turnos."

msgid "STORY_EVENT@1160_824@BODY_HEADER"
msgstr "Rumores chegam até você de que um renomado {ShopKeeper} montou um {StructureResource} em seu domínio, {EventDirection} de {EventCity}."

msgid "STORY_EVENT@1160_824@BODY_LORE"
msgstr "O {ShopKeeper} chega à sua corte para prestar <<o:ShopKeeper>> respeitos. \"Força e sabedoria a você. Estive a serviço de renomados {GLOBAL.GodirLoreConcept.Hyperlink} e governantes. Agora, sigo meu próprio caminho. É uma honra oferecer meus serviços a um grande {PlayerLeader.Title} como você.\" Então, baixando <<o:ShopKeeper>> voz, <<p:ShopKeeper>> adiciona: \"Ou qualquer outro {GLOBAL.GodirLoreConcept.Hyperlink} ou {GLOBAL.HeroConcept.Hyperlink} que venha me visitar.\""

msgid "STORY_EVENT@1160_824@BUTTON_0"
msgstr "\"Bem-vindo, instrutor! Que você ensine bem meus Heróis.\""

msgid "STORY_EVENT@1160_824@BUTTON_1"
msgstr "\"Vá embora, mercenário! Venda seus truques em outro lugar!\""

msgid "STORY_EVENT@1160_824@TITLE"
msgstr "Comerciante de Talentos"

msgid "STORY_EVENT@1160_825@BODY_FOOTER"
msgstr "O Vidente Místico partirá após {Turns} turnos."

msgid "STORY_EVENT@1160_825@BODY_HEADER"
msgstr "Um conselheiro relata que um {StructureResource} montou loja {EventDirection} de {EventCity}, oferecendo conhecimento de territórios e governantes distantes."

msgid "STORY_EVENT@1160_825@BODY_LORE"
msgstr "<<Cp:ShopKeeper>> te visita no mesmo dia. \"Eu vendo segredos, {PlayerLeader.Title}. Eu sei muito sobre este reino e seus [hyperlink,GLOBAL.GodirLoreConcept]habitantes[/hyperlink]. E o pouco que eu não sei, eu divino.\" Seu conselheiro então se inclina e sussurra: \"Vale notar que <<p:ShopKeeper>> mantém as mesmas informações sobre você e seus domínios para seus rivais explorarem.\" O {ShopKeeper} apresenta um sorriso inofensivo."

msgid "STORY_EVENT@1160_825@BUTTON_0"
msgstr "\"Isso me excita. Deixe-me inspecionar sua loja imediatamente.\""

msgid "STORY_EVENT@1160_825@BUTTON_1"
msgstr "\"Meu reino não é lugar para <<m:StructureResource>>!\""

msgid "STORY_EVENT@1160_825@TITLE"
msgstr "Loja de Segredos"

msgid "STORY_EVENT@1160_857@BODY_FOOTER"
msgstr "\"Eu sigo para onde meus animais me levam. Não o contrário. Talvez eles me levem de volta aqui algum dia.\""

msgid "STORY_EVENT@1160_857@BODY_HEADER"
msgstr "O {StructureResource} que residia em seu domínio levou <<o:ShopKeeper>> menagerie completa antes de você para anunciar <<o:ShopKeeper>> partida."

msgid "STORY_EVENT@1160_857@BODY_LORE"
msgstr "Apesar da explosão auricular de rosnados, relinchos e mugidos, a <<G:voz^n,ShopKeeper>> ainda soa mais clara. \"Eu vou agora. Mas eu queria agradecer por permitir minha presença.\" O {ShopKeeper} gesticula para suas criaturas. \"Não somos sempre bem-vindos em todos os lugares.\" <<Cp:ShopKeeper>> clica <<o:ShopKeeper>> língua e os animais vão embora em fila, como uma procissão. Dois <<m:EventMount>> puxam a <<G:carruagem^n,ShopKeeper>>."

msgid "STORY_EVENT@1160_857@BUTTON_0"
msgstr "A busca por novas bestas e criaturas é volúvel."

msgid "STORY_EVENT@1160_857@TITLE"
msgstr "Mercador de Montarias: Consequências"

msgid "STORY_EVENT@1160_859@BODY_FOOTER"
msgstr "\"O horizonte me chama. Vou procurar novos [hyperlink,GLOBAL.HeroConcept]Heróis[/hyperlink] para treinar. Adeus!\" O {ShopKeeper} coloca <<o:ShopKeeper>> carruagem em movimento e vai embora."

msgid "STORY_EVENT@1160_859@BODY_HEADER"
msgstr "O {ShopKeeper} arrumou o {StructureResource} <<p:ShopKeeper>> montou em seu domínio e está pronto para partir."

msgid "STORY_EVENT@1160_859@BODY_LORE"
msgstr "\"Muitos [hyperlink,GLOBAL.HeroConcept]Heróis[/hyperlink] vêm até mim. Agora eu devo ir até os [hyperlink,GLOBAL.HeroConcept]Heróis[/hyperlink] novamente.\" O {ShopKeeper} puxa uma espada de madeira e te saúda. \"Mas não aqui. Em outro lugar. Longe de você.\" Você se pergunta se isso foi meant como um insulto."

msgid "STORY_EVENT@1160_859@BUTTON_0"
msgstr "Tal é a vida de um instrutor itinerante. Até a próxima vez."

msgid "STORY_EVENT@1160_859@TITLE"
msgstr "Comerciante de Talentos: Partiu"

msgid "STORY_EVENT@1160_860@BODY_FOOTER"
msgstr "\"Gostaria de dizer que espero que nos encontremos novamente. Mas eu já conheço o resultado.\" E com isso, o {ShopKeeper} vira e dirige sua carruagem para fora de vista."

msgid "STORY_EVENT@1160_860@BODY_HEADER"
msgstr "O {StructureResource} que passou algum tempo em seu domínio arrumou suas coisas e está pronto para partir."

msgid "STORY_EVENT@1160_860@BODY_LORE"
msgstr "<<Cp:ShopKeeper>> veio se encontrar com você para dizer <<o:ShopKeeper>> adeus pessoalmente. \"Lucrativa foi minha estadia. Muito poucos arrependimentos. Agora, é hora de ir.\""

msgid "STORY_EVENT@1160_860@BUTTON_0"
msgstr "Talvez seus destinos se encontrem novamente no futuro."

msgid "STORY_EVENT@1160_860@TITLE"
msgstr "Loja de Segredos: Partiu"

msgid "STORY_EVENT@1165_1350@BODY_FOOTER"
msgstr "Você se encontra entre dois Godir que brigam pelo domínio da natureza. Com quem você se alia?"

msgid "STORY_EVENT@1165_1350@BODY_HEADER"
msgstr "Pouco depois de conhecer {EventPlayer.TitleName}, <<p:EventPlayer>> entra em contato com você. \"As bênçãos da natureza-\" <<p:EventPlayer>> começa, mas antes que <<p:EventPlayer>> possa terminar sua saudação, <<p:EventPlayer>> é interrompido por ninguém menos que {EventPlayer2.TitleName}!"

msgid "STORY_EVENT@1165_1350@BODY_LORE"
msgstr "Imediatamente os dois {GLOBAL.GodirLoreConcept.Hyperlink} começam a brigar. \"As bênçãos da {GLOBAL.NatureConcept} devem ser protegidas, não distorcidas e devolvidas,\" {Serena.FirstName} rosna: \"Todos que ameaçam meu domínio serão exterminados, mesmo 'deusas' loucas como {Nimue.FirstName}.\"\n"
"\n"
"{Nimue.FirstName} zombeteia. \"Enquanto você estava se escondendo em suas florestas, eu estava evoluindo minha {NimueRace}. Apenas os mais fortes sobrevivem, e para isso, você deve se adaptar. Permita-me demonstrar!\""

msgid "STORY_EVENT@1165_1350@BUTTON_0"
msgstr "Aliar-se com {Serena.TitleName}."

msgid "STORY_EVENT@1165_1350@BUTTON_1"
msgstr "Aliar-se com {Nimue.TitleName}."

msgid "STORY_EVENT@1165_1350@BUTTON_2"
msgstr "Não escolher lado, deixar a natureza (e a guerra) seguir seu curso."

msgid "STORY_EVENT@1165_1350@TITLE"
msgstr "A Disputa Primal"

msgid "STORY_EVENT@1165_1351@BODY_FOOTER"
msgstr "Seu povo o aclama enquanto você retorna a {GLOBAL.MagehavenLoreConcept.Hyperlink}, vitorioso."

msgid "STORY_EVENT@1165_1351@BODY_HEADER"
msgstr "Você resolveu o conflito entre os dois {GLOBAL.GodirLoreConcept.Hyperlink} brigões da {GLOBAL.NatureConcept}, de uma forma ou de outra. Um senso de paz retorna ao reino."

msgid "STORY_EVENT@1165_1351@BODY_LORE"
msgstr "Se essa paz durará é incerto. Alianças desmoronam, amizades mudam e o [hyperlink,GLOBAL.AstralVoidLoreConcept]Vazio[/hyperlink] distorce qualquer mente que toca. No {GLOBAL.AstralSeaLoreConcept.Hyperlink}, poucas coisas são eternas.[br/]\n"
"Mas por agora, as terras de {RealmName} são devotas ao seu governo."

msgid "STORY_EVENT@1165_1351@BUTTON_0"
msgstr "A vitória é nossa!"

msgid "STORY_EVENT@1165_1351@TITLE"
msgstr "A Disputa Primal: Resolvida"

msgid "STORY_EVENT@1165_5112@TITLE"
msgstr "A Ameaça de Melenis"

msgid "STORY_EVENT@1165_5244@BODY_FOOTER"
msgstr "{EventLeaderDefeated.TitleName} reivindica este reino para si mesma. Derrotar <<P:EventLeaderDefeated>> tornará seu governo inegável."

msgid "STORY_EVENT@1165_5244@BODY_HEADER"
msgstr "A visão fantasmagórica de {EventLeaderDefeated.TitleName} aparece diante de você e se dirige a você com um tom de desprezo, como se este encontro estivesse abaixo da estação de <<P:EventLeaderDefeated>>."

msgid "STORY_EVENT@1165_5244@BODY_LORE"
msgstr "\"Você transgride meu reino, sangue quente. Fique fora do meu caminho e talvez eu veja por bem deixar que esse sangue corra em suas veias por algumas luas a mais. Interfira, e ele alimentará a terra do meu reino como todos que vieram antes.\""

msgid "STORY_EVENT@1165_5244@BUTTON_0"
msgstr "A Rainha Lich deve cair."

msgid "STORY_EVENT@1165_5244@TITLE"
msgstr "Domínio da Rainha Lich"

msgid "STORY_EVENT@1165_5245@BODY_FOOTER"
msgstr "Por fim, você sozinho está vitorioso na sala do trono de <<o:EventLeaderDefeated>>, ninguém pode negar seu poder agora. O Reino é seu."

msgid "STORY_EVENT@1165_5245@BODY_HEADER"
msgstr "{EventLeaderDefeated} cai com uma maldição final em seus lábios, as legiões de mortos-vivos que a serviam desmoronam na terra enquanto suas tropas exultam em sua vitória."

msgid "STORY_EVENT@1165_5245@BODY_LORE"
msgstr "A grande necrópole de <<g:former throne city^n,EventLeaderDefeated>> contém uma quantidade inimaginável de almas, um poder necromântico que ninguém pode negar e poucos poderiam desafiar."

msgid "STORY_EVENT@1165_5245@BUTTON_0"
msgstr "Bingbong, o Lich, está morto!"

msgid "STORY_EVENT@1165_5245@TITLE"
msgstr "A Rainha Lich cai"

msgid "STORY_EVENT@1165_5278@BODY_FOOTER"
msgstr "Texto de Rodapé"

msgid "STORY_EVENT@1165_5278@BODY_HEADER"
msgstr "Texto de Cabeçalho"

msgid "STORY_EVENT@1165_5278@BODY_LORE"
msgstr "Texto de Lore"

msgid "STORY_EVENT@1165_5278@BUTTON_0"
msgstr "OK, OK, vamos matá-los com martelos."

msgid "STORY_EVENT@1165_5278@TITLE"
msgstr "Visão de Promessa"

msgid "STORY_EVENT@1167_1467@BODY_FOOTER"
msgstr "Will you seek to crush the festering cult in {EventCity}? Or do you trust the otherworldly influence to bring boons?"

msgid "STORY_EVENT@1167_1467@BODY_HEADER"
msgstr "A magistrate addresses you with great concern. \"We have a problem, {PlayerLeader.Title}. A cult develops in {EventCity}.\""

msgid "STORY_EVENT@1167_1467@BODY_LORE"
msgstr "<<Cp:EventUnit>> continues: \"Some of your people have begun to worship otherworldy beings, false gods that they view as supreme and allmighty. Frankly, It's unnerving the general population of {EventCity}. This may become a bigger issue over time, but it may not be too late to suppress the spread of the cult's ideology to make it disappear.\""

msgid "STORY_EVENT@1167_1467@BUTTON_0"
msgstr "Dispatch the city guard [unitprod/] to arrest the cultists. [population/]"

msgid "STORY_EVENT@1167_1467@BUTTON_1"
msgstr "Magically aid [mana/] the city guard [unitprod/] to expel the cultists. [population/]"

msgid "STORY_EVENT@1167_1467@BUTTON_2"
msgstr "Openly promote [evilact/] the cult. [chaosboon/]"

msgid "STORY_EVENT@1167_1467@BUTTON_3"
msgstr "Distract the population with games and festivals. [gold/]"

msgid "STORY_EVENT@1167_1467@BUTTON_4"
msgstr "Order governs {EventCity}. It always has and always will."

msgid "STORY_EVENT@1167_1467@BUTTON_5"
msgstr "Don't get involved. [happiness/] This will likely resolve itself."

msgid "STORY_EVENT@1167_1467@TITLE"
msgstr "Festering Cult"

msgid "STORY_EVENT@1167_1472@BODY_FOOTER"
msgstr "The summoned {EventUnit} grants the {EventRace} Infernal strength. You lose face, but perhaps this is not the worst possible outcome."

msgid "STORY_EVENT@1167_1472@BODY_HEADER"
msgstr "The cult that sprouted in {EventCity} some time ago has matured. Most citizens now follow the cult's Demonic Overlord, a {EventUnit}."

msgid "STORY_EVENT@1167_1472@BODY_LORE"
msgstr "The cultists have gathered in the streets to summon their overlord into this realm under the promise of great but terrible strength."

msgid "STORY_EVENT@1167_1472@BUTTON_0"
msgstr "Embrace the Demonic influence. [evilact/]"

msgid "STORY_EVENT@1167_1472@BUTTON_1"
msgstr "Attempt to counter [mana/] the transformation with all your power."

msgid "STORY_EVENT@1167_1472@BUTTON_2"
msgstr "Bind the {EventUnit} to your will."

msgid "STORY_EVENT@1167_1472@TITLE"
msgstr "Cult Manifested"

msgid "STORY_EVENT@1167_1473@BODY_FOOTER"
msgstr "Will you permit the Order of the {RandomIdol} to build their stronghold in {EventCity}?"

msgid "STORY_EVENT@1167_1473@BODY_HEADER"
msgstr "A {EventUnit} arrives before you. \"Hail, {PlayerLeader.Title}! I represent the {RandomWarriorTitle} of the {RandomIdol}. I have a proposal for you.\""

msgid "STORY_EVENT@1167_1473@BODY_LORE"
msgstr "\"Word has reached us of your resolute measures against the Demonic cult in {EventCity}. We are looking for a patron in our everlasting battle against evil and its wicked servants. We seek to establish a knightly order in your fair city. The Order of the {RandomIdol}.\""

msgid "STORY_EVENT@1167_1473@BUTTON_0"
msgstr "Permit them to establish the Order, giving them a small allowance. [gold/]"

msgid "STORY_EVENT@1167_1473@BUTTON_1"
msgstr "Help the {RandomWarriorTitle} build [structureprod/] their stronghold. It will strengthen <<G:defenses^p,EventCity>>. [fortification/]"

msgid "STORY_EVENT@1167_1473@BUTTON_2"
msgstr "Refuse and force the {RandomWarriorTitle} to leave their weapons [unitprod/] behind."

msgid "STORY_EVENT@1167_1473@TITLE"
msgstr "Order of the {RandomIdol}"

msgid "STORY_EVENT@1167_16@BODY_FOOTER"
msgstr "\"Impérios robustos são construídos com poderosos blocos de pedra! Meu {PlayerLeader.Title}, construa mais [hyperlink,GLOBAL.QuarryConcept][quarry/]Pedreiras[/hyperlink]!\" O chanceler aguarda sua resposta rapsodicamente."

msgid "STORY_EVENT@1167_16@BODY_HEADER"
msgstr "\"{PlayerLeader.Title}, devemos conversar.\" Um chanceler sério se aproxima de você. \"Enquanto seus exércitos lutam em terras distantes, o que defende seu povo?\""

msgid "STORY_EVENT@1167_16@BODY_LORE"
msgstr "\"Eu vou te dizer o que\", o chanceler continua. \"Muros tão altos quanto montanhas! Tão grossos quanto os troncos de carvalhos ancestrais! Se quisermos prosperar, devemos construir, construir, construir!\" O chanceler dispensa <<o:EventUnit>> propaganda industriosa com consumo fervoroso. <<Cp:EventUnit>> limpa <<o:EventUnit>> queixo. \"Ou, construímos salas de recrutamento, celeiros... Qualquer coisa que nos ajude a vencer a guerra!\""

msgid "STORY_EVENT@1167_16@BUTTON_0"
msgstr "\"Eu apoio sua ambição industriosa! Precisamos daquelas Pedreiras!\""

msgid "STORY_EVENT@1167_16@BUTTON_1"
msgstr "\"Esqueça. Os trabalhadores [structureprod/] em {EventCity} só precisam trabalhar mais. [happiness/]\""

msgid "STORY_EVENT@1167_16@BUTTON_2"
msgstr "\"Eu conheço uma maneira mais rápida de ganhar blocos de pedra.\""

msgid "STORY_EVENT@1167_16@BUTTON_3"
msgstr "\"Vá embora, tolo trabalhador. Não tenho desejo por pedra.\""

msgid "STORY_EVENT@1167_16@TITLE"
msgstr "Defesas Estruturadas"

msgid "STORY_EVENT@1167_18@BODY_FOOTER"
msgstr "\"Suas cidades se alegram! Elas constroem tudo o que queremos!\" Agora a pedra congestiona as ruas de suas cidades. Como você gastará o excesso?"

msgid "STORY_EVENT@1167_18@BODY_HEADER"
msgstr "Seu chanceler entra alegremente de volta na sua sala do trono. \"[hyperlink,GLOBAL.QuarryConcept][quarry/]Pedreiras[/hyperlink]! [hyperlink,GLOBAL.QuarryConcept][quarry/]Pedreiras[/hyperlink] até onde eu posso ver!\""

msgid "STORY_EVENT@1167_18@BODY_LORE"
msgstr "O chanceler prossegue para contar em grande detalhe como a pedra é transportada para suas cidades. \"Em todo o seu reino, em cada cidade, seus cidadãos falam sobre como se sentem seguros, sabendo que temos os materiais para estruturas defensivas.\" O chanceler bate palmas de <<o:EventUnit>> e sorri."

msgid "STORY_EVENT@1167_18@BUTTON_0"
msgstr "\"Venda a pedra nos mercados. [gold/]\""

msgid "STORY_EVENT@1167_18@BUTTON_1"
msgstr "\"{EventCity} está desprotegida. Construiremos muros lá.\""

msgid "STORY_EVENT@1167_18@BUTTON_2"
msgstr "\"Construa estátuas e monumentos para me celebrar! [influence/]\""

msgid "STORY_EVENT@1167_18@BUTTON_3"
msgstr "\"Use o excesso de pedra para cabeças de martelo e hastes de machado [unitprod/].\""

msgid "STORY_EVENT@1167_18@BUTTON_4"
msgstr "\"Transforme [mana/] os blocos em um {EventUnitB}.\""

msgid "STORY_EVENT@1167_18@BUTTON_5"
msgstr "\"Aumente sua produção em cada cidade. [structureprod/]\""

msgid "STORY_EVENT@1167_18@TITLE"
msgstr "Defesas Estruturadas: Consequências"

msgid "STORY_EVENT@1167_19@BODY_FOOTER"
msgstr "\"Eu sugiro fazer amizade com {EventHouseLord.FirstName} de {EventHouse}, meu {PlayerLeader.Title}. Assim <<p:EventHouseLord>> pode declarar guerra a {TargetPlayer}.\" Você apoiará esse esquema?"

msgid "STORY_EVENT@1167_19@BODY_HEADER"
msgstr "Um de seus conselheiros mais astutos propõe um esquema convincente."

msgid "STORY_EVENT@1167_19@BODY_LORE"
msgstr "Seu conselheiro sorri. \"Meu {PlayerLeader.Title}! Por muito tempo, seu rival irritante, {TargetPlayer} dos {TargetRace}, tem frustrado seus objetivos. Alguém deveria desafiar <<P:TargetPlayer>>!\" Você está prestes a educar seu conselheiro sobre os riscos e custos da guerra, quando <<p:EventUnit>> continua. \"Mas VOCÊ não precisa levantar sua espada! E se pudermos colocar a descartável Cidade de {EventHouse} contra {TargetPlayer}?\""

msgid "STORY_EVENT@1167_19@BUTTON_0"
msgstr "\"Uma vez que {EventHouse} seja amigável conosco, eles atacarão meu rival!\""

msgid "STORY_EVENT@1167_19@BUTTON_1"
msgstr "\"Cesse seu belicoso sub-reptício! [influence/] Eu não aprovo trapaças! [goodact/]\""

msgid "STORY_EVENT@1167_19@BUTTON_2"
msgstr "\"Eu luto minhas próprias batalhas. Deixe-me.\""

msgid "STORY_EVENT@1167_19@TITLE"
msgstr "Mestre de Fantoches"

msgid "STORY_EVENT@1167_20@BODY_FOOTER"
msgstr "Você persuadiu {EventHouse} a declarar guerra a {TargetPlayer}. Como você ajudará seus esforços de guerra das sombras?"

msgid "STORY_EVENT@1167_20@BODY_HEADER"
msgstr "Boas notícias! O {EventHouseLord.Title} de {EventHouse} sucumbiu aos seus encantos. <<Cp:EventHouseLord>> considera você <<o:EventHouseLord>> amigo."

msgid "STORY_EVENT@1167_20@BODY_LORE"
msgstr "\"Somos gratos por você ter apontado os esquemas de {TargetPlayer} e <<o:TargetPlayer>> trapaceiros {EventRace} contra meu povo. Eles pagarão por seus crimes.\" O {EventHouseLord.Title} se curva respeitosamente diante de você. \"Já declaramos guerra a {TargetPlayer}, ó {PlayerLeader.Title}!\" Seu conselheiro esquemático concorda ansiosamente de trás de uma cortina."

msgid "STORY_EVENT@1167_20@BUTTON_0"
msgstr "\"Vou recrutar [gold/] um {EventUnitA} para reforçar o exército deles.\""

msgid "STORY_EVENT@1167_20@BUTTON_1"
msgstr "\"Vou convocar [mana/] um {EventUnitB} para o exército deles!\""

msgid "STORY_EVENT@1167_20@BUTTON_2"
msgstr "\"Vou me concentrar em fortalecer meu vínculo com {EventHouse}. [allegiance/]\""

msgid "STORY_EVENT@1167_20@BUTTON_3"
msgstr "\"A guerra deles me permite forjar um casus belli contra {TargetPlayer}!\""

msgid "STORY_EVENT@1167_20@TITLE"
msgstr "Mestre de Fantoches: Consequências"

msgid "STORY_EVENT@1167_24@BODY_FOOTER"
msgstr "Seus esforços de recrutamento são significativamente aprimorados ao adquirir {EventMaterial}. Você buscará o material raro?"

msgid "STORY_EVENT@1167_24@BODY_HEADER"
msgstr "Você envia guerreiros corajosos para lutar em guerras. Mas os números deles serão suficientes? Seu conselho tem uma sugestão."

msgid "STORY_EVENT@1167_24@BODY_LORE"
msgstr "\"As pedras de moinho da guerra continuam a girar, meu {PlayerLeader.Title}. Nós nos beneficiaríamos ao aumentar nossos esforços de recrutamento. Quanto mais tropas enviarmos para a batalha contra {EnemyLeader}, mais cedo reclamaremos a vitória. Tivemos notícias de uma substância encantada que acelera o treinamento de seus guerreiros. Você deveria reclamar este {EventIngredient} para si mesmo.\""

msgid "STORY_EVENT@1167_24@BUTTON_0"
msgstr "\"Vou conquistar o {EventMaterial} e reunir um vasto exército!\""

msgid "STORY_EVENT@1167_24@BUTTON_1"
msgstr "\"Envie os martelos de nossos construtores [structureprod/] para os ferreiros [unitprod/] de {EventCity} em vez disso.\""

msgid "STORY_EVENT@1167_24@BUTTON_2"
msgstr "\"Não preciso encontrar {EventMaterial}. Posso moldá-lo eu mesmo!\""

msgid "STORY_EVENT@1167_24@BUTTON_3"
msgstr "\"Já posso reunir todos os guerreiros que a vitória exige.\""

msgid "STORY_EVENT@1167_24@TITLE"
msgstr "Atualizações de Batalha"

msgid "STORY_EVENT@1167_25@BODY_FOOTER"
msgstr "Além de impulsionar o recrutamento, que outro bônus seus alquimistas devem extrair do {EventMaterial}?"

msgid "STORY_EVENT@1167_25@BODY_HEADER"
msgstr "Seus alquimistas murmuram animadamente ao saber que você adicionou {EventMaterial} aos seus estoques. Seu conselho o parabeniza."

msgid "STORY_EVENT@1167_25@BODY_LORE"
msgstr "\"Marque minhas palavras, mares de nossos guerreiros inundarão os campos de batalha. Nossos inimigos não poderão escapar de nosso poder.\" Um membro do conselho examina o {EventMaterial} e grita: \"Meu {PlayerLeader.Title}, esta substância é tão potente que seus magos e alquimistas podem extrair uma aplicação secundária!\" O conselho aguarda sua resposta com expectativa."

msgid "STORY_EVENT@1167_25@BUTTON_0"
msgstr "Aumente a moral de nossas tropas. [morale/]"

msgid "STORY_EVENT@1167_25@BUTTON_1"
msgstr "Aumente o corpo e as habilidades de {EventHero}."

msgid "STORY_EVENT@1167_25@BUTTON_2"
msgstr "Monte um {EventUnit}. [unit/]"

msgid "STORY_EVENT@1167_25@BUTTON_3"
msgstr "Extraia mana [mana/] do {EventMaterial}."

msgid "STORY_EVENT@1167_25@TITLE"
msgstr "Atualizações de Batalha: Consequências"

msgid "STORY_EVENT@1167_28@BODY_FOOTER"
msgstr "Seu chanceler resume: \"Após derrotar heroicamente os <<m:EventUnitB>> sem mente que nós mesmos soltamos... Nós alegamos que {EnemyPlayer} ordenou o ataque.\""

msgid "STORY_EVENT@1167_28@BODY_HEADER"
msgstr "Você está em guerra com {EnemyPlayer}! Seu povo está sofrendo sob esta guerra que você declarou. Mais notavelmente a cidade de {EventCity}."

msgid "STORY_EVENT@1167_28@BODY_LORE"
msgstr "Um de seus chanceleres engole seco. \"Se agrada a meu {PlayerLeader.Title}, eu posso saber de uma maneira de recuperar o apoio do seu povo.\" Antes que você possa responder, <<p:EventUnit>> continua, \"Os plebeus endossam lutas contra vilões hediondos. Então, nós soltamos alguns <<m:EventUnitB>> dentro de nossas fronteiras.\" Você nota o suor brilhando na testa do seu chanceler. \"Então, nós os deixamos causar estragos.\""

msgid "STORY_EVENT@1167_28@BUTTON_0"
msgstr "Ordene o ataque de falsa bandeira e convoque <<m:EventUnitB>> perto de {EventCity}."

msgid "STORY_EVENT@1167_28@BUTTON_1"
msgstr "\"Arriscar vidas civis? Não, investirei [gold/] em apoio popular! [happiness/]\""

msgid "STORY_EVENT@1167_28@BUTTON_2"
msgstr "Em vez disso, invoque o senso de dever do seu povo para apoiar esta guerra."

msgid "STORY_EVENT@1167_28@BUTTON_3"
msgstr "Essas questões triviais me entediam. Tenho uma guerra para vencer!"

msgid "STORY_EVENT@1167_28@TITLE"
msgstr "Ajuntamento em Torno da Bandeira"

msgid "STORY_EVENT@1167_29@BODY_FOOTER"
msgstr "{EventCity}, agora profundamente reunida, apoia fervorosamente sua guerra contra {EnemyPlayer}. Como você usará seu vigor reacendido?"

msgid "STORY_EVENT@1167_29@BODY_HEADER"
msgstr "Antes que o último {EventUnitB} caia, você ouve gritos de alegria vindos de {EventCity}."

msgid "STORY_EVENT@1167_29@BODY_LORE"
msgstr "Você envia seu chanceler para se dirigir à população. \"Povo de {EventCity}! Esses monstros <<m:EventUnitB>> que ameaçavam destruir suas casas e comer seus filhos foram instruídos a invadir nossas terras pelo traidor {EnemyPlayer}. Nosso {PlayerLeader.Title} se opõe à intenção funesta de <<o:EnemyPlayer>>. Vocês se juntarão à luta justa?\" Mais gritos de alegria surgem das ruas da cidade."

msgid "STORY_EVENT@1167_29@BUTTON_0"
msgstr "Aumentar os esforços de recrutamento [unitprod/] da cidade."

msgid "STORY_EVENT@1167_29@BUTTON_1"
msgstr "Enviar emissários para levantar apoio em suas outras cidades também [happiness/]"

msgid "STORY_EVENT@1167_29@BUTTON_2"
msgstr "Incentivar a produção de estruturas. [structureprod/]"

msgid "STORY_EVENT@1167_29@BUTTON_3"
msgstr "Atrair mais pessoas [population/] para se juntarem à cidade que o apoia tanto."

msgid "STORY_EVENT@1167_29@TITLE"
msgstr "Ajuntamento em Torno da Bandeira: Consequências"

msgid "STORY_EVENT@1167_33@BODY_FOOTER"
msgstr "\"Esses comerciantes proclamaram que viajarão para seu reino,\" o batedor conclui. Como você os receberá?"

msgid "STORY_EVENT@1167_33@BODY_HEADER"
msgstr "Um batedor relata que <<p:EventUnit>> avistou uma estranha banda de comerciantes {EventRace} no deserto."

msgid "STORY_EVENT@1167_33@BODY_LORE"
msgstr "\"Havia algo estranho sobre esses {EventRace},\" o batedor informa. \"Eles juram que são comerciantes. No entanto, notei que carregavam armas escondidas.\" O batedor então se inclina e sussurra: \"Esses 'comerciantes' possuem surpreendentemente poucos produtos para negociar. No entanto, suas montarias eram robustas e criadas para a batalha.\""

msgid "STORY_EVENT@1167_33@BUTTON_0"
msgstr "Procurar os comerciantes suspeitos."

msgid "STORY_EVENT@1167_33@BUTTON_1"
msgstr "Enviar guardas [unitprod/] de {EventCity} para repelir os comerciantes do seu reino."

msgid "STORY_EVENT@1167_33@BUTTON_2"
msgstr "Ocultar os caminhos que levam através de nossas fronteiras."

msgid "STORY_EVENT@1167_33@BUTTON_3"
msgstr "Ignorá-los. As pessoas podem viajar livremente para dentro e fora do meu reino. [knowledge/]"

msgid "STORY_EVENT@1167_33@TITLE"
msgstr "Propósitos Cruzados"

msgid "STORY_EVENT@1167_344@BODY_FOOTER"
msgstr "O que você fará com esse tolo e <<o:EventHero>> alegações improváveis sobre um {EventRealm} perdido nas brumas?"

msgid "STORY_EVENT@1167_344@BODY_HEADER"
msgstr "Os guardas da cidade de {EventCity} trazem diante de você um <<EventHero{homem/mulher}>> maltrapilho, acusado de semear pânico com <<o:EventHero>> histórias de destruição iminente."

msgid "STORY_EVENT@1167_344@BODY_LORE"
msgstr "\"As brumas virão, {PlayerLeader}!\" <<Cp:EventHero>> fala com terror nos olhos de <<o:EventHero>>. \"Elas se espalham pelos campos, rastejam pelas rachaduras nos muros da sua cidade... e então—whoosh—todos desaparecem! Roubados pelos Fey!\" O <<EventHero{homem/mulher}>> olha para o espaço até <<p:EventHero>> tirar um {EventItem} quebrado. \"Isso,\" <<p:EventHero>> grita, sacudindo <<o:EventHero>> punhos, \"é tudo o que resta do meu {EventRealm}.\""

msgid "STORY_EVENT@1167_344@BUTTON_0"
msgstr "Interrogar o <<EventHero{homem/mulher}>> para saber mais sobre a ameaça das brumas."

msgid "STORY_EVENT@1167_344@BUTTON_1"
msgstr "É melhor prevenir do que remediar. Aumentar os esforços de recrutamento [unitprod/]!"

msgid "STORY_EVENT@1167_344@BUTTON_2"
msgstr "Prenda o causador de problemas por causar agitação pública."

msgid "STORY_EVENT@1167_344@BUTTON_3"
msgstr "Banir o tolo, mas manter <<o:EventHero>> {EventItem} [item/] após consertá-lo."

msgid "STORY_EVENT@1167_344@BUTTON_4"
msgstr "\"A névoa não pode tocar um poderoso Godir como eu!\" [influence/]"

msgid "STORY_EVENT@1167_344@TITLE"
msgstr "Para o Fim os Sinos Dobram"

msgid "STORY_EVENT@1167_345@BODY_FOOTER"
msgstr "\"Toda noite, <<G:song^n,EventDuathadae>> me chama. Desejo obedecer. Devo retornar!\" Você deve abordar o encantamento do sobrevivente."

msgid "STORY_EVENT@1167_345@BODY_HEADER"
msgstr "Os guardas de {EventCity} informam que um dos {PlayerRace} que você resgatou dos {EventRace} está exibindo comportamento errático. <<Cp:EventUnit>> quer retornar aos {EventRace}."

msgid "STORY_EVENT@1167_345@BODY_LORE"
msgstr "O sobrevivente vestiu <<r:EventUnit>> no estilo dos {EventRace}. <<Cp:EventUnit>> grita: \"Devo saber! Devo saber se sou digno!\" Você pergunta o que <<p:EventUnit>> significa. \"Vi aqueles que foram levados pelos {EventRace} sendo levados perante quatro {GLOBAL.DuathadaeLoreConcept.Hyperlink}, aqueles deuses de outro mundo que eles adoram. Eles devoraram todos, exceto aqueles que consideraram dignos, os quais eles... deformaram. Torceram, para se tornarem um de... deles!\""

msgid "STORY_EVENT@1167_345@BUTTON_0"
msgstr "\"Receba meu feitiço de amnésia [mana/] para fazê-lo esquecer.\" [goodact/]"

msgid "STORY_EVENT@1167_345@BUTTON_1"
msgstr "\"Meus guardas [unitprod/] irão interrogá-lo para aprender mais [knowledge/] sobre Duatha.\""

msgid "STORY_EVENT@1167_345@BUTTON_2"
msgstr "\"Seja refinado digno [mana/] como um {EventUnitA} [unit/] para o meu exército.\""

msgid "STORY_EVENT@1167_345@BUTTON_3"
msgstr "Permita que o sobrevivente parta. Sua partida irá inquietar [happiness/] {EventCity}."

msgid "STORY_EVENT@1167_345@TITLE"
msgstr "Tormentos Encobertos"

msgid "STORY_EVENT@1167_346@BODY_FOOTER"
msgstr "Os desertores {EventRace} buscam refúgio em seu reino. O que você pedirá em troca por sua acomodação?"

msgid "STORY_EVENT@1167_346@BODY_HEADER"
msgstr "Sua rotina diária é interrompida inesperadamente: uma companhia de {EventRace} emergiu de {GLOBAL.DuathaLoreConcept.Hyperlink}. Seu comandante busca uma audiência com você."

msgid "STORY_EVENT@1167_346@BODY_LORE"
msgstr "O {EventUnit} ajoelha-se. \"Saudações, Supremo {PlayerLeader.Title}, Guardião do {EventRelic}. Já pertencemos à Cohorte Cinza, como espadas para {EventDuathadae}, {EventDuathadaeTitle}. Mas meus mestres falharam com os {GLOBAL.DuathadaeLoreConcept.Hyperlink}. {PlayerLeader.Name}, possuidor do poder de criar <<m:EventScourgeUnit>>, seu esplendor agora rivaliza com o de {EventDuathadae}! Permita-nos servi-lo, {PlayerLeader.Title}. Nossos segredos fortalecerão sua eminência. Ou devo sintonizar o {EventRelic} com <<G:power^n,EventDuathadae>>?\""

msgid "STORY_EVENT@1167_346@BUTTON_0"
msgstr "Permita asilo aos {EventRace} e cronique seus segredos. [knowledge/]"

msgid "STORY_EVENT@1167_346@BUTTON_1"
msgstr "Aliste o {EventUnit} [unit/] e sua companhia."

msgid "STORY_EVENT@1167_346@BUTTON_2"
msgstr "\"Sintonize o {EventRelic} para mim!\""

msgid "STORY_EVENT@1167_346@BUTTON_3"
msgstr "Execute [evilact/] o insolente {EventRace} como compensação [happiness/] pelos crimes de seus parentes."

msgid "STORY_EVENT@1167_346@BUTTON_4"
msgstr "Afaste a companhia de {EventRace}."

msgid "STORY_EVENT@1167_346@TITLE"
msgstr "Elucidações Nebulosas"

msgid "STORY_EVENT@1167_34@BODY_FOOTER"
msgstr "\"Vá embora. Partiremos em breve o suficiente\", diz o líder de forma zombeteira. Algo está errado. O que você fará?"

msgid "STORY_EVENT@1167_34@BODY_HEADER"
msgstr "Você encontrou o grupo de comerciantes que seu batedor descreveu."

msgid "STORY_EVENT@1167_34@BODY_LORE"
msgstr "Seu líder dá um passo à frente. \"Por que você está nos incomodando? Somos apenas simples comerciantes que não fizeram nada de errado.\" Os companheiros de <<Co:EventStackLeader>> se reúnem ao redor de <<P:EventStackLeader>>, seus olhos sombrios fixos em você. A maioria deles tem as mãos debaixo de suas túnicas soltas, como se estivessem segurando algo."

msgid "STORY_EVENT@1167_34@BUTTON_0"
msgstr "Atacar o grupo suspeito de comerciantes!"

msgid "STORY_EVENT@1167_34@BUTTON_1"
msgstr "Suborne [gold/] o grupo para fazê-los ir embora."

msgid "STORY_EVENT@1167_34@BUTTON_2"
msgstr "\"Tropas! Jurem que protegerão nossas fronteiras!\""

msgid "STORY_EVENT@1167_34@BUTTON_3"
msgstr "Descubra a verdadeira identidade dos comerciantes."

msgid "STORY_EVENT@1167_34@BUTTON_4"
msgstr "\"Certo. Eu irei embora. Por enquanto.\""

msgid "STORY_EVENT@1167_34@TITLE"
msgstr "Propósitos Cruzados: Encontro"

msgid "STORY_EVENT@1167_35@BODY_FOOTER"
msgstr "\"Nós revelaremos <<G:secrets^p,EventHouse>>!\", grita o líder dos espiões. <<CG:transgression^n,EventHouse>> exige uma resposta forte. O que você fará?"

msgid "STORY_EVENT@1167_35@BODY_HEADER"
msgstr "A verdadeira identidade dos \"comerciantes\" é revelada! Eles são espiões enviados por {EventHouse}!"

msgid "STORY_EVENT@1167_35@BODY_LORE"
msgstr "Após o confronto, você interroga o líder do grupo de espiões. O {TraderLeader} se recusa a falar no início. Felizmente, alguns veteranos em seu séquito têm métodos afiados para fazer as pessoas falarem. O {TraderLeader} se quebra mesmo antes de alguém colocar a mão em <<P:TraderLeader>>."

msgid "STORY_EVENT@1167_35@BUTTON_0"
msgstr "\"{EventHouse} deve pagar. À GUERRA!\""

msgid "STORY_EVENT@1167_35@BUTTON_1"
msgstr "\"Isso prova que precisamos priorizar nossas defesas em {EventCity}! [unitprod/]\""

msgid "STORY_EVENT@1167_35@BUTTON_2"
msgstr "Esqueça {EventHouse}. Faça parecer que seu rival, {EnemyPlayer}, orquestrou a incursão."

msgid "STORY_EVENT@1167_35@BUTTON_3"
msgstr "\"Estou disposto a esquecer [relation/]... por um preço. [gold/]\""

msgid "STORY_EVENT@1167_35@BUTTON_4"
msgstr "\"Eu perdoo [goodact/] seu ato de agressão. [relation/]\""

msgid "STORY_EVENT@1167_35@TITLE"
msgstr "Propósitos Cruzados: Consequências"

msgid "STORY_EVENT@1167_37@BODY_FOOTER"
msgstr "O chefe de guerra dissidente e <<o:EventStackLeader>> guerreiros devastarão suas terras. O que você fará para deter <<P:EventStackLeader>>?"

msgid "STORY_EVENT@1167_37@BODY_HEADER"
msgstr "Um batedor ferido chega à sua corte, <<o:EventUnit>> armadura rasgada e danificada. \"O Açougueiro... está aqui...!\", <<p:EventUnit>> gagueja."

msgid "STORY_EVENT@1167_37@BODY_LORE"
msgstr "Depois que o batedor encontrou <<o:EventUnit>> língua engolindo duas taças de vinho, <<p:EventUnit>> relata trêmulo. \"Meu {PlayerLeader.Title}. Seu inimigo, o perverso {EventHouseLord.Title} de {EventHouse}, soltou <<o:EventHouseLord>> o chefe de guerra mais terrível sobre seu povo, dando ao bastardo rédea solta.\" <<Cp:EventUnit>> olha para você sóbrio. \"{EventStackLeader.FirstName}, o Açougueiro de {EventHouse} mata, pilha e profana... como uma besta selvagem!\""

msgid "STORY_EVENT@1167_37@BUTTON_0"
msgstr "Procure {EventStackLeader} e <<o:EventStackLeader>> bando de guerreiros."

msgid "STORY_EVENT@1167_37@BUTTON_1"
msgstr "Reúna guardas [unitprod/] para proteger meu povo [happiness/] e lidar com {EventStackLeader.FirstName}."

msgid "STORY_EVENT@1167_37@BUTTON_2"
msgstr "Invocar sombras para distrair o bando de guerra."

msgid "STORY_EVENT@1167_37@BUTTON_3"
msgstr "Corra o risco e não faça nada. [evilact/]"

msgid "STORY_EVENT@1167_37@TITLE"
msgstr "Incursão Brutal"

msgid "STORY_EVENT@1167_38@BODY_FOOTER"
msgstr "O chefe de guerra {EventStackLeader.FirstName} está ocupado falando, concedendo-lhe uma oportunidade de melhorar suas chances de vitória sobre ele."

msgid "STORY_EVENT@1167_38@BODY_HEADER"
msgstr "Suas tropas encontraram o chefe de guerra bruto e <<o:EventStackLeader>> invasores. Ambos os lados se preparam para a batalha, quando {EventStackLeader} se dirige ao {PlayerStackLeader}."

msgid "STORY_EVENT@1167_38@BODY_HEADER@PLAYERSTACKLEADE"
msgstr "Você encontrou o chefe de guerra bruto e <<o:EventStackLeader>> invasores. Ambos os lados se preparam para a batalha, quando {EventStackLeader} se dirige a você."

msgid "STORY_EVENT@1167_38@BODY_LORE"
msgstr "\"Já ouvi falar de você. Veio para me parar?\" O terrível Açougueiro solta uma gargalhada estrondosa. \"Olhem aqui, rapazes! Esse aí pensa que <<r:PlayerStackLeader>> é algum tipo de herói!\" O sorriso do chefe de guerra então se transforma em um franzir de cenho. <<Cp:EventStackLeader>> toca no colar que <<p:EventStackLeader>> usa. É feito de orelhas. \"Esses caras também achavam que eram heróis,\" <<p:EventStackLeader>> rosna."

msgid "STORY_EVENT@1167_38@BODY_LORE@PLAYERSTACKLEADE"
msgstr "\"Já ouvi falar de você. Veio para me parar?\" O terrível Açougueiro solta uma gargalhada estrondosa. \"Olhem aqui, rapazes! Esse aí pensa que <<r:PlayerStackLeader>> é invencível ou algo assim!\" O sorriso do chefe de guerra então se transforma em um franzir de cenho. <<Cp:EventStackLeader>> toca no colar que <<p:EventStackLeader>> usa. É feito de orelhas. \"Esses caras também achavam que eram invencíveis,\" <<p:EventStackLeader>> rosna."

msgid "STORY_EVENT@1167_38@BUTTON_0"
msgstr "Enfrente-os de frente! [goodact/]"

msgid "STORY_EVENT@1167_38@BUTTON_1"
msgstr "Conjure magias simples [mana/] para reforçar suas próprias tropas antes da batalha."

msgid "STORY_EVENT@1167_38@BUTTON_2"
msgstr "\"Pegue esses cofres de moedas [gold/] e lute por mim. [unit/]\""

msgid "STORY_EVENT@1167_38@BUTTON_3"
msgstr "\"Se é carnificina que você busca, chefe de guerra {EventStackLeader.FirstName}, caça um oponente mais fraco.\""

msgid "STORY_EVENT@1167_38@BUTTON_4"
msgstr "Recue. Você pode confrontar a banda de guerra mais tarde."

msgid "STORY_EVENT@1167_38@BUTTON_5"
msgstr "\"Pegue esses cofres de moedas [gold/] e vá embora. Seu {EventUnit} [unit/] fica comigo.\" [evilact/]"

msgid "STORY_EVENT@1167_38@TITLE"
msgstr "Encontrando Incursão Brutal"

msgid "STORY_EVENT@1167_39@BODY_FOOTER"
msgstr "Seus cidadãos aliviados celebram, e seus soldados mais ainda. Como você usará esta vitória para seu melhor proveito?"

msgid "STORY_EVENT@1167_39@BODY_HEADER"
msgstr "O terrível chefe de guerra foi derrotado. <<Cp:EventStackLeader>> e <<o:EventStackLeader>> tropas não são mais uma ameaça."

msgid "STORY_EVENT@1167_39@BODY_LORE"
msgstr "Pouco depois, você recebe uma mensagem do seu inimigo odiado, {EventHouseLord.FirstName} de {EventHouse}. <<Cp:EventHouseLord>> informa que {EventStackLeader} estava agindo por conta própria, e que o {EventHouseLord.Title} não teve envolvimento na devastadora carnificina. Não importa. Sua força venceu o dia. Você amassa a carta em uma bola e a joga em uma fogueira próxima."

msgid "STORY_EVENT@1167_39@BUTTON_0"
msgstr "Inspire todas as suas tropas! [morale/]"

msgid "STORY_EVENT@1167_39@BUTTON_1"
msgstr "Atraia mais recrutas para a guerra! [unitprod/]"

msgid "STORY_EVENT@1167_39@BUTTON_2"
msgstr "Pregue o corpo do Açougueiro em <<G:gates^p,EventCity>> [evilact/] para demonstrar sua supremacia. [influence/]"

msgid "STORY_EVENT@1167_39@BUTTON_3"
msgstr "Não aceite recompensa. As terras estão seguras novamente! [goodact/]"

msgid "STORY_EVENT@1167_39@TITLE"
msgstr "Incursão Brutal: Consequências"

msgid "STORY_EVENT@1167_48@BODY_FOOTER"
msgstr "O patético {EventHouseLord.Title} zomba das suas habilidades de guerra. Como você responderá?"

msgid "STORY_EVENT@1167_48@BODY_HEADER"
msgstr "Um mensageiro entrega uma declaração oficial do seu inimigo, {EventHouseLord} de {EventHouse} para {EventCity}, sua cidade do trono."

msgid "STORY_EVENT@1167_48@BODY_LORE"
msgstr "\"Para o covarde {PlayerLeader.Title}. Você é o pior Governante deste mundo. Todos os outros Governantes das <<m:GLOBAL.IndependentCityConcept.Hyperlink>> riem de você pelas costas. Estamos surpresos que você ainda não escorregou e caiu de volta no Vazio por acidente. Seu inimigo na guerra, {EventHouseLord.TitleFirstName}.\""

msgid "STORY_EVENT@1167_48@BUTTON_0"
msgstr "Converta <<G:stone^n,EventCity>> [structureprod/] em mana [mana/] para reforçar sua capacidade de convocação."

msgid "STORY_EVENT@1167_48@BUTTON_1"
msgstr "Encontre mais recrutas [unitprod/] em {EventCity} prometendo cerveja a eles! [food/]"

msgid "STORY_EVENT@1167_48@BUTTON_2"
msgstr "Recrute prontamente um mercenário {EventUnit}! [unit/] Esvazie os cofres do Império! [gold/]"

msgid "STORY_EVENT@1167_48@BUTTON_3"
msgstr "Convoque um {EventUnitB} [unit/] agora mesmo! Use nossas reservas de mana [mana/]!"

msgid "STORY_EVENT@1167_48@BUTTON_4"
msgstr "\"Insultos traem sua fraqueza, {EventHouseLord.Title}. [influence/]\""

msgid "STORY_EVENT@1167_48@TITLE"
msgstr "Rosnados e Mordidas"

msgid "STORY_EVENT@1167_49@BODY_FOOTER"
msgstr "O {EventHouseLord.Title} suspira. \"Estou disposto a me submeter ao seu governo, se você prometer ajudar meu povo a se recuperar!\""

msgid "STORY_EVENT@1167_49@BODY_HEADER"
msgstr "Seu oponente na guerra, {EventHouseLord} de {EventHouse}, entra em contato com você, <<o:EventHouseLord>> rosto marcado pela guerra e sombrio."

msgid "STORY_EVENT@1167_49@BODY_LORE"
msgstr "\"Não sou orgulhoso demais para admitir que o sofrimento do meu povo supera meu desejo de vencê-lo em batalha. Meus {EventRace} estão subalimentados e muitos estão deslocados. Estou lentamente aceitando que devo me curvar à sua força.\" {EventHouseLord.FirstName} olha nos seus olhos. \"Mas tenho condições.\""

msgid "STORY_EVENT@1167_49@BUTTON_0"
msgstr "\"Junte-se a mim. {EventCity} alimentará [food/] seu povo e construirá [structureprod/] abrigos.\""

msgid "STORY_EVENT@1167_49@BUTTON_1"
msgstr "\"Vamos acabar com a guerra. {EventHouse} permanecerá independente. [goodact/]\""

msgid "STORY_EVENT@1167_49@BUTTON_2"
msgstr "\"Quanto [gold/] vale a paz para você?\""

msgid "STORY_EVENT@1167_49@BUTTON_3"
msgstr "\"Que outra opção há senão se submeter à minha glória?\""

msgid "STORY_EVENT@1167_49@BUTTON_4"
msgstr "\"O campo de batalha decidirá se você é digno de sobreviver.\""

msgid "STORY_EVENT@1167_49@TITLE"
msgstr "Cidade das Bandeiras Brancas"

msgid "STORY_EVENT@1167_50@BODY_FOOTER"
msgstr "\"Seus cidadãos em {EventCity} claramente sofrem mais com esta guerra. Que recurso podemos enviar para ajudá-los?\""

msgid "STORY_EVENT@1167_50@BODY_HEADER"
msgstr "Você consulta seus conselheiros sobre sua estratégia de guerra contra {EnemyHouse}, quando o {EventHouseLord.Title} de {EventHouse} solicita uma audiência."

msgid "STORY_EVENT@1167_50@BODY_LORE"
msgstr "{EventHouseLord} cumprimenta você formalmente. \"Serei breve, ó {PlayerLeader.Title}, pois sei que você tem <<g:sons^p,EventCity>> para derrotar. A carnificina que você inflige aos seus guerreiros é problema seu. No entanto, quando inocentes sofrem, não podemos tolerar. Assim, embora não ajudaremos suas forças nesta guerra contra {EnemyHouse}, oferecemos altruisticamente alívio ao seu povo.\""

msgid "STORY_EVENT@1167_50@BUTTON_0"
msgstr "\"Comida [food/] para as crianças famintas.\""

msgid "STORY_EVENT@1167_50@BUTTON_1"
msgstr "\"Madeira e pedra [structureprod/] para construir novas casas.\""

msgid "STORY_EVENT@1167_50@BUTTON_2"
msgstr "\"Formas de entretenimento [happiness/] para ajudar a lidar com o ataque.\""

msgid "STORY_EVENT@1167_50@BUTTON_3"
msgstr "\"Você me pede para escolher? {EventCity} precisa de tudo!\""

msgid "STORY_EVENT@1167_50@BUTTON_4"
msgstr "\"Agradeço a oferta, mas outras pessoas precisam mais.\" [goodact/]"

msgid "STORY_EVENT@1167_50@TITLE"
msgstr "Apoio Simpático"

msgid "STORY_EVENT@1167_53@BODY_FOOTER"
msgstr "{EventHouse} pede ajuda contra seu inimigo, {RivalPlayer}. Você oferecerá algum socorro?"

msgid "STORY_EVENT@1167_53@BODY_HEADER"
msgstr "O pedido desesperado de {EventHouseLord} de {EventHouse} chega até você! {EventHouseLord.FirstName} está perdendo a guerra para {RivalPlayer}!"

msgid "STORY_EVENT@1167_53@BODY_LORE"
msgstr "\"Ajude-nos, {PlayerLeader}! Você é nossa única esperança!\" O {EventHouseLord.Title} junta <<o:EventHouseLord>> mãos. \"Aquele agressor, {RivalPlayer}, quer tomar minhas terras! Sei que não sou um de seus vassalos, ó {PlayerLeader.Title}, mas se seu coração favorece a misericórdia e a bondade, por favor, ajude-nos contra este tirano!\" {EventHouseLord.FirstName} cai de joelhos, lágrimas escorrendo pelo <<o:EventHouseLord>> rosto."

msgid "STORY_EVENT@1167_53@BUTTON_0"
msgstr "Denuncie {RivalPlayer} [relation/] em apoio a {EventHouse}. [allegiance/]"

msgid "STORY_EVENT@1167_53@BUTTON_1"
msgstr "Convoque discretamente [mana/] um {EventUnitB} para ajudar sua causa. [relation/]"

msgid "STORY_EVENT@1167_53@BUTTON_2"
msgstr "Treine [unitprod/] um {EventUnitA} de {EventCity} para o exército de {EventHouse}. [relation/]"

msgid "STORY_EVENT@1167_53@BUTTON_3"
msgstr "Presenteie {EventHouse} [relation/] com um pacote de alívio de colheitas [food/] e madeira [structureprod/]."

msgid "STORY_EVENT@1167_53@BUTTON_3_PREDICTION"
msgstr "{EventHouse} ganha 1 {GLOBAL.PopulationConcept} e a {GLOBAL.StructureProductionConcept} doada por {EventCity}."

msgid "STORY_EVENT@1167_53@BUTTON_4"
msgstr "Deseje-lhes boa sorte contra seus inimigos."

msgid "STORY_EVENT@1167_53@TITLE"
msgstr "Chamar por Ajuda"

msgid "STORY_EVENT@1167_558@BODY_FOOTER"
msgstr "\"Eu rastreei os ladrões de volta ao {EventSpawner}. Eu exijo justiça rápida, meu {PlayerLeader.Title}. Permita-me entregá-la!\""

msgid "STORY_EVENT@1167_558@BODY_HEADER"
msgstr "\"Meu nome de família está manchado!\" seu [hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink], {EventHero}, grita para você. \"Bandidos levaram meu {EventItem} durante a noite!\""

msgid "STORY_EVENT@1167_558@BODY_LORE"
msgstr "Seu campeão destemido está profundamente angustiado. \"Foi confiado a mim pelo meu <<EventHero{father/mother}>>, que o recebeu de <<o:EventHero>> <<EventHero{father/mother}>> antes de <<P:EventHero>>. A relíquia pode ser rastreada até o primeiro ancestral do <<m:{EventHero.LastName}>>. Eu era seu Guardião, mas agora eu envergonhei meus antepassados.\" O desespero nos <<G:eyes^p,EventHero>> então se transforma em raiva vingativa."

msgid "STORY_EVENT@1167_558@BUTTON_0"
msgstr "\"Vá e recupere sua honra, {EventHero.FirstName}, com minha bênção.\""

msgid "STORY_EVENT@1167_558@BUTTON_1"
msgstr "Recrie o {EventItem} para {EventHero}."

msgid "STORY_EVENT@1167_558@BUTTON_2"
msgstr "Os guardas de {EventCity} [unitprod/] irão limpar o acampamento dos bandidos. [morale/] Os despojos [gold/] são meus."

msgid "STORY_EVENT@1167_558@BUTTON_3"
msgstr "\"Não posso atender aos seus problemas agora, {EventHero.FirstName}. Talvez em outra hora.\""

msgid "STORY_EVENT@1167_558@TITLE"
msgstr "Honra Roubada"

msgid "STORY_EVENT@1167_559@BODY_FOOTER"
msgstr "\"Sou apenas seu humilde servo, ó {PlayerLeader.Title}.\" {EventHero} se curva. \"Pergunte como posso recompensá-lo, e eu farei.\""

msgid "STORY_EVENT@1167_559@BODY_HEADER"
msgstr "{EventHero} cumprimenta você com um sorriso. \"O {EventItem} dos meus antepassados é meu novamente. Eu agradeço, meu {PlayerLeader.Title}.\""

msgid "STORY_EVENT@1167_559@BODY_LORE"
msgstr "{EventHero.FirstName} tranca o {EventItem} em um cofre forte. \"Lá! Ninguém pode reclamá-lo agora. Eu o guardarei, e a honra da minha família, até que eu possa passá-lo para um herdeiro de minha escolha.\" Seu <<EventHero{hero/heroine}>> está mais alto do que nunca e está irradiando confiança e determinação."

msgid "STORY_EVENT@1167_559@BUTTON_0"
msgstr "Apropriar-se [evilact/] do {EventItem} ancestral. [item/]"

msgid "STORY_EVENT@1167_559@BUTTON_1"
msgstr "\"Que sua honra recuperada lhe traga força.\" [xp/]"

msgid "STORY_EVENT@1167_559@BUTTON_2"
msgstr "\"Lidere suas tropas com graça e fervor, {EventHero.FirstName}!\" [unitHero/]"

msgid "STORY_EVENT@1167_559@BUTTON_3"
msgstr "\"Seu erro sendo corrigido é a única recompensa que eu preciso.\" [goodact/]"

msgid "STORY_EVENT@1167_559@BUTTON_4"
msgstr "\"Eu estava apenas cumprindo minha parte do nosso juramento.\" [devotedact/]"

msgid "STORY_EVENT@1167_559@BUTTON_5"
msgstr "Propor uma recompensa por achado como agradecimento. [gold/]"

msgid "STORY_EVENT@1167_559@TITLE"
msgstr "Honra Roubada: Desfecho"

msgid "STORY_EVENT@1167_562@BODY_FOOTER"
msgstr "\"Meu {PlayerLeader.Title}, como seu servo devoto, permita-me um {EventStackLeader}. Nós compartilharemos sua carne... e seu poder.\""

msgid "STORY_EVENT@1167_562@BODY_HEADER"
msgstr "\"Você já provou... {EventStackLeader}, meu {PlayerLeader.Title}?\", seu [hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink], {EventHero}, pergunta casualmente. Você se pergunta aonde isso vai levar."

msgid "STORY_EVENT@1167_562@BODY_LORE"
msgstr "\"Dizem que é bastante doce... e cheio de poder revigorante.\" {EventHero.FirstName} finge indiferença, mas você detecta o tremor na <<o:EventHero>> voz. <<Cp:EventHero>> molha <<o:EventHero>> lábios. Sua sobrancelha levantada é todo o incentivo que seu <<EventHero{hero/heroine}>> precisa. \"Lendas deste reino dizem que a carne de um {EventStackLeader} concede força e sabedoria a quem a consome!\""

msgid "STORY_EVENT@1167_562@BUTTON_0"
msgstr "Ajude {EventHero} a saciar <<o:EventHero>> a fome por poder."

msgid "STORY_EVENT@1167_562@BUTTON_1"
msgstr "\"O único poder [influence/] que tolero neste reino é o meu próprio.\" [morale/]"

msgid "STORY_EVENT@1167_562@BUTTON_2"
msgstr "Drene a força insolente de {EventHero.FirstName} de <<o:EventHero>> para se fortalecer. [xp/]"

msgid "STORY_EVENT@1167_562@BUTTON_3"
msgstr "\"Você não pode caçar o {EventStackLeader}, {EventHero.FirstName}. Pelo menos, não hoje.\""

msgid "STORY_EVENT@1167_562@TITLE"
msgstr "Poder Tornado Carne"

msgid "STORY_EVENT@1167_563@BODY_FOOTER"
msgstr "\"Eu já posso sentir seu poder fluindo através das minhas veias. Eu me tornei sua arma, {PlayerLeader.Title}. Use-me.\""

msgid "STORY_EVENT@1167_563@BODY_HEADER"
msgstr "\"Finalmente! A carne do {EventStackLeader} é minha!\" {EventHero} sorri, mostrando <<o:EventHero>> dentes vorazmente."

msgid "STORY_EVENT@1167_563@BODY_LORE"
msgstr "Após reunir uma ampla seleção de pó e tônicos, seu [hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink] procede cerimonialmente para preparar a carne do {EventStackLeader} em <<o:EventHero>> quartos. Um odor sórdido logo permeia sua morada. Enquanto seus cortesãos se reúnem em protesto, {EventHero.FirstName} ressurge triunfante, mastigando o que parece ser uma coxa assada do {EventStackLeader}. <<Cp:EventHero>> exuma uma força recém-descoberta."

msgid "STORY_EVENT@1167_563@BUTTON_0"
msgstr "\"Me dê um gosto disso.\" [xp/]"

msgid "STORY_EVENT@1167_563@BUTTON_1"
msgstr "\"Drenar força combina com você, {EventHero}. Desenvolva [unitHero/] esses instintos ainda mais.\""

msgid "STORY_EVENT@1167_563@BUTTON_2"
msgstr "\"Todo poder vem com um preço. Hora de pagar.\" [gold/]"

msgid "STORY_EVENT@1167_563@BUTTON_3"
msgstr "\"Misture a <<G:carcass^n,EventStackLeader>> nas rações das suas tropas, {EventHero.FirstName}.\" [xp/]"

msgid "STORY_EVENT@1167_563@TITLE"
msgstr "Poder Tornado Carne: Consequências"

msgid "STORY_EVENT@1167_566@BODY_FOOTER"
msgstr "{EventHero.FirstName} suspira. \"Meu desejo mais profundo permanece: testemunhar um {EventStackLeader} com meus próprios olhos. Posso ir encontrar um?\""

msgid "STORY_EVENT@1167_566@BODY_HEADER"
msgstr "Seu [hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink], {EventHero}, cumprimenta você calorosamente. \"{PlayerLeader.Title}. Como seu servo, me sinto sortudo por ter viajado longe e visto muito.\""

msgid "STORY_EVENT@1167_566@BODY_LORE"
msgstr "Antes que você possa enviar o <<EventHero{hero/heroine}>> para outro local distante, <<p:EventHero>> continua. \"Parte do motivo pelo qual escolhi a vida de um <<EventHero{hero/heroine}>> aventureiro é porque desejo testemunhar as maravilhas dos reinos.\" {EventHero.FirstName} cora. \"Minha avó {EventHero.LastName} costumava me contar histórias sobre o {EventStackLeader} e os heróis que ganharam renome apenas por encontrar um.\""

msgid "STORY_EVENT@1167_566@BUTTON_0"
msgstr "\"Vá então. Que você logo ponha os olhos em um {EventStackLeader}.\""

msgid "STORY_EVENT@1167_566@BUTTON_1"
msgstr "Faça {EventHero} pastorear gado [food/] para tirar <<o:EventHero>> mente do <<m:EventStackLeader>>."

msgid "STORY_EVENT@1167_566@BUTTON_2"
msgstr "\"Um {EventStackLeader}? Eu posso te mostrar um {EventStackLeader} agora mesmo!\""

msgid "STORY_EVENT@1167_566@BUTTON_3"
msgstr "\"Incomode-me com esses sonhos ociosos seus em outro momento, {EventHero.FirstName}.\""

msgid "STORY_EVENT@1167_566@TITLE"
msgstr "Desejo Profundo por <<m:EventStackLeader>>"

msgid "STORY_EVENT@1167_567@BODY_FOOTER"
msgstr "Não demora muito até que o {EventStackLeader} pegue o <<G:scent^n,EventHero>>. Ele se vira para enfrentar <<P:EventHero>> e se prepara para atacar!"

msgid "STORY_EVENT@1167_567@BODY_FOOTER@HERO_NOT_PRESENT"
msgstr "Você deveria retornar com {EventHero}."

msgid "STORY_EVENT@1167_567@BODY_HEADER"
msgstr "{EventHero.FirstName} não consegue conter <<o:EventHero>> excitação. \"Lá! Um {EventStackLeader} é! Eles realmente existem!\""

msgid "STORY_EVENT@1167_567@BODY_HEADER@HERO_NOT_PRESENT"
msgstr "Seu exército atualmente se aproximando do {EventStackLeader} não inclui {EventHero}. <<Cp:EventHero>> é quem quer ver o {EventStackLeader}."

msgid "STORY_EVENT@1167_567@BODY_HEADER@TEST"
msgstr "{EventPhrase}"

msgid "STORY_EVENT@1167_567@BODY_LORE"
msgstr "O poderoso {EventStackLeader} vagueia sem rumo perto do {EventStructure} enquanto {EventHero.FirstName} continua a observá-lo. Alguns <<m:EventUnit>> têm uma toca nas proximidades, mas parecem não se incomodar com a grande criatura invadindo seu território. <<Cp:EventHero>> murmura: \"Então realmente existem <<m:EventStackLeader>>! E agora, eu vi um!\" <<Cp:EventHero>> está tão fascinado com a visão da grande criatura que não percebe o vento mudando inesperadamente."

msgid "STORY_EVENT@1167_567@BODY_LORE@HERO_NOT_PRESENT"
msgstr "O poderoso {EventStackLeader} vagueia sem rumo perto do {EventStructure}. Alguns <<m:EventUnit>> têm uma toca nas proximidades, mas parecem não se incomodar com a grande criatura invadindo seu território."

msgid "STORY_EVENT@1167_567@BUTTON_0"
msgstr "\"Derrote-o! Quero sua cabeça na minha parede!\""

msgid "STORY_EVENT@1167_567@BUTTON_1"
msgstr "\"Tropas, aprendam [xp/] com os ataques desta criatura poderosa.\""

msgid "STORY_EVENT@1167_567@BUTTON_2"
msgstr "Domar a criatura formidável."

msgid "STORY_EVENT@1167_567@BUTTON_3"
msgstr "\"Posições! Não deixem a criatura pisotear vocês!\""

msgid "STORY_EVENT@1167_567@BUTTON_4"
msgstr "Retornar mais tarde com {EventHero}."

msgid "STORY_EVENT@1167_567@BUTTON_4@TOOLTIP"
msgstr "{EventHero.FirstName} se aproximará do {EventStackLeader} mais tarde."

msgid "STORY_EVENT@1167_567@BUTTON_5"
msgstr "Atacar o {EventStackLeader} de qualquer jeito."

msgid "STORY_EVENT@1167_567@TITLE"
msgstr "Desejo Profundo por <<m:EventStackLeader>>: Encontro"

msgid "STORY_EVENT@1167_568@BODY_FOOTER"
msgstr "<<Cp:EventHero>> conclui: \"Ninguém em casa jamais acreditará em mim. No entanto, que vida!\" Você reivindica um troféu do {EventStackLeader}."

msgid "STORY_EVENT@1167_568@BODY_FOOTER@HERO_NOT_PRESENT"
msgstr "Você deixa a cena esperando que {EventHero.FirstName} não fique muito decepcionado com sua decisão."

msgid "STORY_EVENT@1167_568@BODY_HEADER"
msgstr "{EventHero} superou o {EventStackLeader} que <<p:EventHero>> tanto desejava ver. <<Cp:EventHero>> derrama uma lágrima pelo destino da criatura."

msgid "STORY_EVENT@1167_568@BODY_HEADER@HERO_NOT_PRESENT"
msgstr "Suas tropas mataram o {EventStackLeader} que seu {GLOBAL.HeroConcept.Hyperlink}, {EventHero}, tanto desejava ver."

msgid "STORY_EVENT@1167_568@BODY_LORE"
msgstr "{EventHero.FirstName} olha para o horizonte por um tempo, então sussurra: \"Uma criatura tão majestosa e magnífica. Eu desejava que ainda vagasse pelas terras, livre e desimpedida.\" <<Cp:EventHero>> então corta alguns pelos da criatura e coloca em um medalhão. \"Se apenas a Vovó {EventHero.LastName} pudesse me ver agora. Pequeno {EventHero.FirstName}, servindo a um Godir.\""

msgid "STORY_EVENT@1167_568@BODY_LORE@HERO_NOT_PRESENT"
msgstr "No entanto, seu Herói não participou do encontro. O mundo ficou quieto e silencioso, como se estivesse de luto. Você não consegue livrar-se da sensação de que isso foi um empreendimento falho, ou pelo menos uma oportunidade perdida."

msgid "STORY_EVENT@1167_568@BUTTON_0"
msgstr "Faça {EventHero.FirstName} refletir [xp/] sobre o encontro com o {EventStackLeader}."

msgid "STORY_EVENT@1167_568@BUTTON_1"
msgstr "Reivindique um troféu do {EventStackLeader}: um {EventItem}. [item/]"

msgid "STORY_EVENT@1167_568@BUTTON_3"
msgstr "\"Você derrubou o poderoso {EventStackLeader}! Inspire outros [unitHero/] a atacar sem piedade.\""

msgid "STORY_EVENT@1167_568@BUTTON_4"
msgstr "Estimule {EventHero} a desenvolver <<o:EventHero>> fascinação por criaturas. [unitHero/]"

msgid "STORY_EVENT@1167_568@BUTTON_5"
msgstr "Informe {EventHero} sobre a notícia infeliz. [morale/]"

msgid "STORY_EVENT@1167_568@TITLE"
msgstr "Desejo Profundo por <<m:EventStackLeader>>: Consequências"

msgid "STORY_EVENT@1167_568@TITLE@HERO_NOT_PRESENT"
msgstr "Desejo Profundo por <<m:EventStackLeader>>: Falha"

msgid "STORY_EVENT@1167_571@BODY_FOOTER"
msgstr "\"Meu {PlayerLeader.Title}, um {EventStackLeader} fez seu ninho nas proximidades. Permita-me encontrar a criatura. E matá-la. Ou ser morto.\""

msgid "STORY_EVENT@1167_571@BODY_HEADER"
msgstr "\"Você me considera corajoso o suficiente para enfrentar um {EventStackLeader}?\", pergunta seu [hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink], {EventHero}. \"Ele é uma presa honrosa para um caçador.\""

msgid "STORY_EVENT@1167_571@BODY_LORE"
msgstr "{EventHero.FirstName} não espera por sua resposta. <<Cp:EventHero>> fala com um brilho no <<o:EventHero>> olho. \"Esta não é uma criatura que você caça por sua carne. Nem renderá um icor para ser usado como veneno ou medicina. Esta é uma besta que você caça para lutar.\" {EventHero.FirstName} abaixa <<o:EventHero>> voz e <<o:EventHero>> expressão fica solene. \"Para lutar até a morte.\""

msgid "STORY_EVENT@1167_571@BUTTON_0"
msgstr "\"Vá e conquiste sua honra, {EventHero.FirstName}.\""

msgid "STORY_EVENT@1167_571@BUTTON_1"
msgstr "\"Matar uma besta apenas por esporte? Este não é o nosso caminho.\""

msgid "STORY_EVENT@1167_571@BUTTON_2"
msgstr "Negar o pedido de {EventHero} <<o:EventHero>>."

msgid "STORY_EVENT@1167_571@TITLE"
msgstr "Na <<G:toca^n,EventStackLeader>>"

msgid "STORY_EVENT@1167_572@BODY_FOOTER"
msgstr "O que você fará com os despojos do {EventSpawner}?"

msgid "STORY_EVENT@1167_572@BODY_FOOTER@HERO_WAS_PRESENT"
msgstr "{EventHero} está revigorado pelo desafio. O ouro é seu. O que você fará com os restos do {EventSpawner}?"

msgid "STORY_EVENT@1167_572@BODY_HEADER"
msgstr "Após uma batalha feroz, suas forças limparam a <<G:toca^n,EventStackLeader>>."

msgid "STORY_EVENT@1167_572@BODY_HEADER@HERO_WAS_PRESENT"
msgstr "Após uma batalha feroz, {EventHero} limpou a <<G:toca^n,EventStackLeader>>."

msgid "STORY_EVENT@1167_572@BODY_LORE"
msgstr "Construída com materiais rudimentares, a {EventSpawner} abrigava não apenas o {EventStackLeader}, mas também oferecia abrigo para outras criaturas. A toca está repleta de pequenos tesouros: tudo o que resta de desafiantes menos sortudos. Enquanto suas tropas recolhem as moedas descartadas, um fraco gorjeio chama sua atenção. Sob alguns escombros, eles encontram um {EventItem} e um jovem {EventUnit} órfão que imediatamente foge."

msgid "STORY_EVENT@1167_572@BUTTON_0"
msgstr "Colete o {EventItem} rudimentar [item/] como seu troféu."

msgid "STORY_EVENT@1167_572@BUTTON_1"
msgstr "Pegue o {EventUnit} órfão [unit/] e faça-o lutar por você."

msgid "STORY_EVENT@1167_572@BUTTON_2"
msgstr "Desmonte os restos da toca para obter materiais de construção [structureprod/] para {EventCity}."

msgid "STORY_EVENT@1167_572@BUTTON_3"
msgstr "\"Regozije-se na glória [morale/] de sua vitória [unitHero/], {EventHero}!\""

msgid "STORY_EVENT@1167_572@BUTTON_4"
msgstr "Reivindique o {EventUnit} órfão como seu animal de estimação premiado [influence/] para entretenimento. [evilact/]"

msgid "STORY_EVENT@1167_572@TITLE"
msgstr "Na <<G:toca^n,EventStackLeader>>: Consequências"

msgid "STORY_EVENT@1167_575@BODY_FOOTER"
msgstr "{EventHero.FirstName} implora para que você encontre e obtenha {EventMaterial}, para curar a doença do <<o:EventHero>> <<EventUnit{irmão/irmã}>>."

msgid "STORY_EVENT@1167_575@BODY_HEADER"
msgstr "Seu [hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink], {EventHero}, aproxima-se de você com gravidade. \"Meu {PlayerLeader.Title}, meu <<EventUnit{irmão/irmã}>> está doente. Eu temo que <<o:EventUnit>> morte seja iminente.\""

msgid "STORY_EVENT@1167_575@BODY_LORE"
msgstr "Seu <<EventHero{hero/heroine}>> desenrola um pergaminho antigo. \"É um segredo bem guardado dos {EventRace} que o {EventMaterial} tem aplicações medicinais específicas. Eu aposto que seus herbalistas são capazes de preparar um bálsamo curativo de <<m:EventMaterial>> fresco.\" {EventHero.FirstName} guarda o pergaminho e ajoelha-se enquanto lágrimas molham o chão. \"Eu imploro a você, meu {PlayerLeader.Title}. <<Cp:EventUnit>> é a única família que me resta.\""

msgid "STORY_EVENT@1167_575@BUTTON_0"
msgstr "Concordar em encontrar o {EventMaterial}."

msgid "STORY_EVENT@1167_575@BUTTON_2"
msgstr "Tentar um feitiço de recuperação para curar o <<EventUnit{irmão/irmã}>>"

msgid "STORY_EVENT@1167_575@BUTTON_3"
msgstr "\"Eu tenho assuntos mais urgentes para tratar, {EventHero.FirstName}.\""

msgid "STORY_EVENT@1167_575@TITLE"
msgstr "Aplicação Medicinal"

msgid "STORY_EVENT@1167_576@BODY_FOOTER"
msgstr "\"Meu <<EventUnit{irmão/irmã}>>, um capaz {EventUnit}, se recuperará totalmente. Por favor, nos avise como podemos servi-lo.\""

msgid "STORY_EVENT@1167_576@BODY_HEADER"
msgstr "Agora que você garantiu o {EventMaterial}, {EventHero.FirstName} responde prontamente ao seu chamado. <<Cp:EventHero>> percebe o material colhido e sorri."

msgid "STORY_EVENT@1167_576@BODY_LORE"
msgstr "\"Obrigado! Mil vezes obrigado, ó {PlayerLeader.Title}. Levarei isso aos herbalistas imediatamente!\" {EventHero} se curva diante de você, sinceramente comovido por sua generosidade. \"Não possuo muita riqueza. Mas por nos ajudar, eu lhe daria esta herança de família: uma {EventItem}.\""

msgid "STORY_EVENT@1167_576@BUTTON_0"
msgstr "{EventCity} se beneficiará [population/] dos efeitos medicinais do {EventMaterial}."

msgid "STORY_EVENT@1167_576@BUTTON_1"
msgstr "Recrute o {EventUnit} recuperado. [unit/]"

msgid "STORY_EVENT@1167_576@BUTTON_2"
msgstr "Faça {EventHero.FirstName} desenvolver <<o:EventHero>> habilidades de cura. [unitHero/]"

msgid "STORY_EVENT@1167_576@BUTTON_3"
msgstr "\"Agradeça aos {EventRace} e ao seu conhecimento de cura.\" [happiness/]"

msgid "STORY_EVENT@1167_576@TITLE"
msgstr "Aplicação Medicinal: Consequências"

msgid "STORY_EVENT@1167_670@BODY_FOOTER"
msgstr "Você pode escolher continuar, mas talvez seja mais sábio retornar com {EventHero} presente."

msgid "STORY_EVENT@1167_670@BODY_HEADER"
msgstr "Suas forças se aproximam do {EventSpawner}, prontas para atacar."

msgid "STORY_EVENT@1167_670@BODY_LORE"
msgstr "No entanto, {EventHero} deseja que <<p:EventHero>> <<r:EventHero>> se junte ao assalto deste {EventSpawner}."

msgid "STORY_EVENT@1167_670@BUTTON_0"
msgstr "A ameaça do {EventSpawner} é muito aguda! Ataque!"

msgid "STORY_EVENT@1167_670@BUTTON_1"
msgstr "Retorne com {EventHero} mais tarde."

msgid "STORY_EVENT@1167_670@TITLE"
msgstr "Segundos pensamentos"

msgid "STORY_EVENT@1167_726@BODY_FOOTER"
msgstr "O Cavaleiro de Prata aponta <<o:SilverKnight>> lâmina para {EventHero.FirstName} e avança. \"Lutaremos um contra o outro. Até que um de nós caia.\""

msgid "STORY_EVENT@1167_726@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "O Cavaleiro de Prata aponta <<o:SilverKnight>> lâmina para você e avança. \"Lutaremos um contra o outro. Até que um de nós caia.\""

msgid "STORY_EVENT@1167_726@BODY_HEADER"
msgstr "{EventHero} explora a {EventStructure} de árvores vítreas. Um Cavaleiro alto, vestido com uma armadura de prata, espera por <<P:EventHero>>."

msgid "STORY_EVENT@1167_726@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você explora a {EventStructure} de árvores vítreas. Um Cavaleiro alto, vestido com uma armadura de prata, espera por você."

msgid "STORY_EVENT@1167_726@BODY_LORE"
msgstr "O Cavaleiro de Prata empunha <<o:SilverKnight>> espada. \"Visitantes no Reino de Prata? Será que meu mestre finalmente enviou reforços?\" <<m:EventUnit>> uivantes avançam das árvores. \"Entendo. Como não me é permitido ainda sair, vocês não podem entrar.\" Os <<m:EventUnit>> se voltam para <<G:troops^p,{EventHero.FirstName}>>, rosnando. \"Parece que meu mestre deseja vocês mortos\", declara o Cavaleiro."

msgid "STORY_EVENT@1167_726@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "O Cavaleiro de Prata empunha <<o:SilverKnight>> espada. \"Visitantes no Reino de Prata? Será que meu mestre finalmente enviou reforços?\" <<m:EventUnit>> uivantes avançam das árvores. \"Entendo. Como não me é permitido ainda sair, vocês não podem entrar.\" Os <<m:EventUnit>> se voltam para suas tropas, rosnando. \"Parece que meu mestre deseja vocês mortos\", declara o Cavaleiro."

msgid "STORY_EVENT@1167_726@BUTTON_0"
msgstr "Defenda-se dos ataques do Cavaleiro de Prata."

msgid "STORY_EVENT@1167_726@BUTTON_1"
msgstr "\"Já derrotamos você antes. Vamos derrotá-lo novamente.\" [morale/]"

msgid "STORY_EVENT@1167_726@BUTTON_2"
msgstr "Replique a Proteção do Duelista que protege o Cavaleiro de Prata."

msgid "STORY_EVENT@1167_726@BUTTON_4"
msgstr "\"Você e eu até a morte, Cavaleiro de Prata!\" [mana/]"

msgid "STORY_EVENT@1167_726@BUTTON_5"
msgstr "Recue deste Reino de Prata."

msgid "STORY_EVENT@1167_726@TITLE"
msgstr "O Reino de Prata"

msgid "STORY_EVENT@1167_727@BODY_FOOTER"
msgstr "<<p:EventHero>> tem a oportunidade de quebrar a maldição do Cavaleiro de Prata ou obter outra bênção da {EventStructure} abandonada."

msgid "STORY_EVENT@1167_727@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Você tem a oportunidade de quebrar a maldição do Cavaleiro de Prata ou obter outra bênção da {EventStructure} abandonada."

msgid "STORY_EVENT@1167_727@BODY_HEADER"
msgstr "O Cavaleiro de Prata jaz aos <<G:pés^p,EventHero>>, <<o:SilverKnight>> espada rachada, mas não quebrada."

msgid "STORY_EVENT@1167_727@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "O Cavaleiro de Prata jaz aos seus pés, <<o:SilverKnight>> espada rachada, mas não quebrada."

msgid "STORY_EVENT@1167_727@BODY_LORE"
msgstr "O Cavaleiro zombou. \"Uma vez,\" <<p:SilverKnight>> disse, \"eu era o Viajante. Eu naveguei pelo {GLOBAL.AstralSeaLoreConcept.Hyperlink} em uma busca própria. Até que meu mestre me amarrou nesta forma. Agora estou condenado a retornar em outra {EventStructure}, em outro Reino.\" Já o corpo do Cavaleiro de Prata começa a desaparecer. \"Em um ciclo eterno, até que meu mestre decida o contrário.\""

msgid "STORY_EVENT@1167_727@BUTTON_0"
msgstr "Destrua a espada do Cavaleiro de Prata [bindingfragments/] e encerre a maldição. [goodact/]"

msgid "STORY_EVENT@1167_727@BUTTON_1"
msgstr "Amarre um dos <<m:EventUnit>> [unit/] errantes à sua vontade."

msgid "STORY_EVENT@1167_727@BUTTON_3"
msgstr "Estude [knowledge/] a floresta e a espada do Cavaleiro de Prata antes que desapareçam."

msgid "STORY_EVENT@1167_727@BUTTON_4"
msgstr "Corte a mão do Cavaleiro [evilact/] para exibir como um troféu. [influence/]"

msgid "STORY_EVENT@1167_727@TITLE"
msgstr "O Reino de Prata: Consequências"

msgid "STORY_EVENT@1167_728@BODY_FOOTER"
msgstr "Apesar da névoa, um {EventUnit} avista sua tropa e grita: \"Matem os intrusos! Protejam os segredos da Corte!\""

msgid "STORY_EVENT@1167_728@BODY_HEADER"
msgstr "Atravessando a natureza selvagem, {EventHero} e <<o:EventHero>> exército encontram uma clareira perto de uma nascente, onde uma Corte das Fadas se reuniu."

msgid "STORY_EVENT@1167_728@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Atravessando a natureza selvagem, você e seu exército encontram uma clareira perto de uma nascente, onde uma Corte das Fadas se reuniu."

msgid "STORY_EVENT@1167_728@BODY_LORE"
msgstr "{EventHero.FirstName} ouviu falar sobre essas reuniões em lendas. Emissários dos {GLOBAL.DuathadaeLoreConcept.Hyperlink} e outras Criaturas Feéricas se reúnem em lugares mágicos para realizar uma Corte das Fadas, onde consultam e conspiram. As Cortes das Fadas são protegidas pelo véu de névoas persistentes, mas de alguma forma seu [hyperlink,GLOBAL.HeroConcept]<<EventHero{herói/heroína}>>[/hyperlink] deve ter rompido seu véu de ocultação. Ao redor de uma mesa de pedra, as Fadas tagarelam e comem iguarias encantadoras."

msgid "STORY_EVENT@1167_728@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Você ouviu falar sobre essas reuniões em lendas. Emissários dos {GLOBAL.DuathadaeLoreConcept.Hyperlink} e outras Criaturas Feéricas se reúnem em lugares mágicos para realizar uma Corte das Fadas, onde consultam e conspiram. As Cortes das Fadas são protegidas pelo véu de névoas persistentes, mas de alguma forma você deve ter rompido seu véu de ocultação. Ao redor de uma mesa de pedra, as Fadas tagarelam e comem iguarias encantadoras."

msgid "STORY_EVENT@1167_728@BUTTON_0"
msgstr "Atacar as Fadas na névoa."

msgid "STORY_EVENT@1167_728@BUTTON_1"
msgstr "Alterar magicamente [mana/] como a névoa afeta as Fadas."

msgid "STORY_EVENT@1167_728@BUTTON_3"
msgstr "Conjurar defesas mágicas contra os ataques das Fadas."

msgid "STORY_EVENT@1167_728@BUTTON_4"
msgstr "Extrair poder da {EventStructure} para reduzir a resistência das Fadas."

msgid "STORY_EVENT@1167_728@BUTTON_5"
msgstr "Invocar uma ventania para afastar as névoas da {EventStructure}."

msgid "STORY_EVENT@1167_728@BUTTON_6"
msgstr "Refazer seus passos para escapar da ira da Corte."

msgid "STORY_EVENT@1167_728@TITLE"
msgstr "A Corte das Fadas"

msgid "STORY_EVENT@1167_729@BODY_FOOTER"
msgstr "O {EventUnit} implora: \"Em troca de manter o segredo da Corte das Fadas, leve agora um tesouro de nossa reunião.\""

msgid "STORY_EVENT@1167_729@BODY_HEADER"
msgstr "{EventHero} está vitorioso no meio da Corte das Fadas. \"Basta! Nós cedemos!\" grita um {EventUnit}. \"Pegue um prêmio do nosso tesouro e vá!\""

msgid "STORY_EVENT@1167_729@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você está vitorioso no meio da Corte das Fadas. \"Basta! Nós cedemos!\" grita um {EventUnit}. \"Pegue um prêmio do nosso tesouro e vá!\""

msgid "STORY_EVENT@1167_729@BODY_LORE"
msgstr "As fadas usam este breve momento de descanso para se envolverem em camadas de feitiços protetores. \"Você deve partir\", diz a {EventUnit}. \"Mas não precisa ir de mãos vazias.\" <<Cp:EventUnit>> acena com <<o:EventUnit>> pequenas mãos e parece cantar uma curta canção. \"Uma bênção que coloquei sobre seu {PlayerLeader.Title}: nosso Dom da Lábia! [hyperlink,GLOBAL.AscendedChampLoreConcept]Mortais[/hyperlink] e [hyperlink,GLOBAL.WizardKingLoreConcept]Reis-Feiticeiros[/hyperlink] acharão as palavras de <<o:PlayerLeader>> irresistíveis.\""

msgid "STORY_EVENT@1167_729@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "As fadas usam este breve momento de descanso para se envolverem em camadas de feitiços protetores. \"Você deve partir\", diz a {EventUnit}. \"Mas não precisa ir de mãos vazias.\" <<Cp:EventUnit>> acena com <<o:EventUnit>> pequenas mãos e parece cantar uma curta canção. \"Uma bênção que coloquei sobre você: nosso Dom da Lábia! [hyperlink,GLOBAL.AscendedChampLoreConcept]Mortais[/hyperlink] e [hyperlink,GLOBAL.WizardKingLoreConcept]Reis-Feiticeiros[/hyperlink] acharão suas palavras irresistíveis.\""

msgid "STORY_EVENT@1167_729@BUTTON_0"
msgstr "Pegue a comida das fadas [food/] da mesa de pedra."

msgid "STORY_EVENT@1167_729@BUTTON_1"
msgstr "Pegue o pote de ouro [gold/] escondido debaixo da mesa."

msgid "STORY_EVENT@1167_729@BUTTON_2"
msgstr "Reivindique um suprimento de Trevo Arc-íris."

msgid "STORY_EVENT@1167_729@BUTTON_4"
msgstr "Escolha o poder de invocar Névoa."

msgid "STORY_EVENT@1167_729@BUTTON_4@LEARN_SPELL_MISTY_MAGIC"
msgstr "{PlayerLeader} aprende o {GLOBAL.SPECIAL_OPERATIONS.MISTY_MAGIC.Hyperlink} Feitiço de Combate."

msgid "STORY_EVENT@1167_729@TITLE"
msgstr "A Corte das Fadas: Consequências"

msgid "STORY_EVENT@1167_730@BODY_FOOTER"
msgstr "Eventualmente, o {EventItem} será completado e a [hyperlink,GLOBAL.ShadowRealmLoreConcept]Divindade Umbral[/hyperlink] entrará neste reino. Estar em sua presença diminui <<G:spirit^n,EventHero.FirstName>>."

msgid "STORY_EVENT@1167_730@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Eventualmente, o {EventItem} será completado e a [hyperlink,GLOBAL.ShadowRealmLoreConcept]Divindade Umbral[/hyperlink] entrará neste reino. Estar em sua presença diminui seu espírito."

msgid "STORY_EVENT@1167_730@BODY_HEADER"
msgstr "{EventHero} entra na {EventStructure} ao som de martelos e bigornas tilintando. <<m:EventUnit>> estão trabalhando na forja."

msgid "STORY_EVENT@1167_730@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você entra na {EventStructure} ao som de martelos e bigornas tilintando. <<m:EventUnit>> estão trabalhando na forja."

msgid "STORY_EVENT@1167_730@BODY_LORE"
msgstr "Com cada batida do martelo, {EventHero.FirstName} sente uma escuridão puxando a resolução de <<o:EventHero>>. <<Cp:EventHero>> deseja fugir. Abandonar a esperança. Renunciar a quaisquer juramentos que <<p:EventHero>> tenha feito. Os <<m:EventUnit>>, que ainda não notaram seu exército, cantam. Eles cantam sobre uma [hyperlink,GLOBAL.ShadowRealmLoreConcept]Divindade Umbral[/hyperlink], predestinada a retornar uma vez que a forja do {EventItem} seja completada. O medo aperta <<G:heart^n,EventHero.FirstName>>."

msgid "STORY_EVENT@1167_730@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Com cada batida do martelo, você sente uma escuridão puxando sua resolução. Você deseja fugir. Abandonar a esperança. Renunciar a quaisquer juramentos que tenha feito. Os <<m:EventUnit>>, que ainda não notaram seu exército, cantam. Eles cantam sobre uma [hyperlink,GLOBAL.ShadowRealmLoreConcept]Divindade Umbral[/hyperlink], predestinada a retornar uma vez que a forja do {EventItem} seja completada. O medo aperta seu coração."

msgid "STORY_EVENT@1167_730@BUTTON_0"
msgstr "Atacar os perversos mestres forjadores!"

msgid "STORY_EVENT@1167_730@BUTTON_1"
msgstr "Use feitiços invernais simples [mana/] para esfriar a forja!"

msgid "STORY_EVENT@1167_730@BUTTON_5"
msgstr "Fortaleça as almas de suas tropas contra a influência que drena o espírito."

msgid "STORY_EVENT@1167_730@BUTTON_6"
msgstr "Mantenha-se firme. [influence/] O destino deste reino depende da sua resolução [morale/] hoje."

msgid "STORY_EVENT@1167_730@BUTTON_7"
msgstr "Deixe a {EventStructure}. Os <<m:EventUnit>> parecem ocupados afinal."

msgid "STORY_EVENT@1167_730@TITLE"
msgstr "O {EventItem} Lamentoso"

msgid "STORY_EVENT@1167_731@BODY_FOOTER"
msgstr "Enquanto <<o:EventHero>> tropas reúnem os armamentos criados na {EventStructure}, {EventHero.FirstName} pondera o que fazer com o {EventItem} inacabado."

msgid "STORY_EVENT@1167_731@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Enquanto suas tropas reúnem os armamentos criados na {EventStructure}, você pondera o que fazer com o {EventItem} inacabado."

msgid "STORY_EVENT@1167_731@BODY_HEADER"
msgstr "{EventHero} purificou a {EventStructure} da presença do culto dos mestres forjadores e negou à [hyperlink,GLOBAL.ShadowRealmLoreConcept]Divindade Umbral[/hyperlink] seu retorno."

msgid "STORY_EVENT@1167_731@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você purificou a {EventStructure} da presença do culto dos mestres forjadores e negou à [hyperlink,GLOBAL.ShadowRealmLoreConcept]Divindade Umbral[/hyperlink] seu retorno."

msgid "STORY_EVENT@1167_731@BODY_LORE"
msgstr "Ao inspecionar mais de perto, fica claro para {EventHero.FirstName} que os <<m:EventUnit>> têm trabalhado pelo retorno de sua Divindade há anos. A forja do {EventItem} seria sua conquista final, mas eles já haviam criado armamentos suficientes para um exército. Isso não era apenas alguma adoração profana. Isso se tornaria uma invasão abominável."

msgid "STORY_EVENT@1167_731@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Ao inspecionar mais de perto, fica claro para você que os <<m:EventUnit>> têm trabalhado pelo retorno de sua Divindade por anos. A forja do {EventItem} seria sua conquista final, mas eles já haviam criado armas e armaduras suficientes para um exército. Isso não era apenas uma adoração profana. Isso se tornaria uma invasão abominável."

msgid "STORY_EVENT@1167_731@BUTTON_0"
msgstr "Destrua [goodact/] o {EventItem}! [influence/]"

msgid "STORY_EVENT@1167_731@BUTTON_1"
msgstr "Pegue [evilact/] o {EventItem} amaldiçoado. [item/]"

msgid "STORY_EVENT@1167_731@BUTTON_2"
msgstr "Reforje [bindingfragments/] o {EventItem}."

msgid "STORY_EVENT@1167_731@TITLE"
msgstr "O Lamentável {EventItem}: Consequências"

msgid "STORY_EVENT@1167_732@BODY_FOOTER"
msgstr "Das sombras, um {EventStackLeader} manipula os {EventUnitA} e as outras vítimas, que sacam suas armas silenciosamente para atacar {EventHero.FirstName}."

msgid "STORY_EVENT@1167_732@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Das sombras, um {EventStackLeader} manipula os {EventUnitA} e as outras vítimas, que sacam suas armas silenciosamente para atacar você."

msgid "STORY_EVENT@1167_732@BODY_HEADER"
msgstr "{EventHero} entra na {EventStructure} com uma trepidação saudável. Uma voz, estranhamente sem emoção, ecoa: \"Ajude-nos. Você deve nos ajudar.\""

msgid "STORY_EVENT@1167_732@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você entra na {EventStructure} com uma trepidação saudável. Uma voz, estranhamente sem emoção, ecoa: \"Ajude-nos. Você deve nos ajudar.\""

msgid "STORY_EVENT@1167_732@BODY_LORE"
msgstr "Um {EventUnitA} olha diretamente para {EventHero.FirstName}, a expressão de <<o:EventUnitA>> vazia. Outros magos e guerreiros estão aglomerados juntos no salão sombrio da Torre. \"Sim. Venha mais perto. Você deve nos ajudar,\" diz um {EventUnitB}, mas {EventHero.FirstName} novamente não detecta nenhum espírito na voz de <<o:EventUnitB>>. Mais pessoas de olhos vazios arrastam-se em direção ao centro do salão. Um assobio rouco das sombras mais escuras então chama a atenção de <<G:attention^n,EventHero>>."

msgid "STORY_EVENT@1167_732@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Um {EventUnitA} olha diretamente para você, a expressão de <<o:EventUnitA>> vazia. Outros magos e guerreiros estão aglomerados juntos no salão sombrio da Torre. \"Sim. Venha mais perto. Você deve nos ajudar,\" diz um {EventUnitB}, mas você novamente não detecta nenhum espírito na voz de <<o:EventUnitB>>. Mais pessoas de olhos vazios arrastam-se em direção ao centro do salão. Um assobio rouco das sombras mais escuras então chama sua atenção."

msgid "STORY_EVENT@1167_732@BUTTON_0"
msgstr "Atacar o {EventStackLeader} e <<o:EventStackLeader>> rebanho relutante."

msgid "STORY_EVENT@1167_732@BUTTON_1"
msgstr "Quebre [mana/] o <<G:hold^n,EventStackLeader>> sobre o {EventUnitA}."

msgid "STORY_EVENT@1167_732@BUTTON_3"
msgstr "Deixe sua glória atordoante [influence/] proteger seu guerreiro da <<G:dominance^n,EventStackLeader>>."

msgid "STORY_EVENT@1167_732@BUTTON_5"
msgstr "\"Nossa fé é mais forte que a maldição sombria deste cretino.\""

msgid "STORY_EVENT@1167_732@BUTTON_6"
msgstr "Converta um dos guerreiros controlados mentalmente para o seu lado."

msgid "STORY_EVENT@1167_732@BUTTON_7"
msgstr "Deixe a {EventStructure} antes que seu exército caia sob o <<G:spell^n,EventStackLeader>>."

msgid "STORY_EVENT@1167_732@TITLE"
msgstr "Titereiro Desolado"

msgid "STORY_EVENT@1167_733@BODY_FOOTER"
msgstr "{EventHero.FirstName} remove o <<G:third eye^n,EventStackLeader>> e passa algum tempo estudando-o. Em que <<p:EventHero>> irá se concentrar?"

msgid "STORY_EVENT@1167_733@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Você remove o <<G:third eye^n,EventStackLeader>> e passa algum tempo estudando-o. Em que você irá se concentrar?"

msgid "STORY_EVENT@1167_733@BODY_HEADER"
msgstr "{EventHero} derrotou o {EventStackLeader} titereiro e <<o:EventStackLeader>> vítimas."

msgid "STORY_EVENT@1167_733@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você derrotou o {EventStackLeader} titereiro e <<o:EventStackLeader>> vítimas."

msgid "STORY_EVENT@1167_733@BODY_LORE"
msgstr "Liberados do controle da criatura maligna, os <<m:EventUnit>> sobreviventes vagueiam vagamente pela {EventStructure}. {EventHero.FirstName} os ignora; <<p:EventHero>> procura investigar como este {GLOBAL.LostWizardLoreConcept.Hyperlink} ganhou habilidades de controle mental. Enquanto <<p:EventHero>> estuda o cadáver, um terceiro olho de repente se abre na <<G:forehead^n,EventStackLeader>>. {EventHero.FirstName} se pergunta se este {EventStackLeader} em particular havia sido escravizado por {GLOBAL.ShadowDemonsLoreConcept.Hyperlink} antes de chegar a este reino."

msgid "STORY_EVENT@1167_733@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Liberados do controle da criatura maligna, os <<m:EventUnit>> sobreviventes vagueiam vagamente pela {EventStructure}. Você os ignora. Em vez disso, você procura investigar como este {GLOBAL.LostWizardLoreConcept.Hyperlink} ganhou habilidades de controle mental. Enquanto você estuda o cadáver, um terceiro olho de repente se abre na <<G:forehead^n,EventStackLeader>>. Você se pergunta se este {EventStackLeader} em particular havia sido escravizado por {GLOBAL.ShadowDemonsLoreConcept.Hyperlink} antes de chegar a este reino."

msgid "STORY_EVENT@1167_733@BUTTON_1"
msgstr "Restaure a sanidade dos <<m:EventUnit>> [unit/] que vagueiam e recrute-os."

msgid "STORY_EVENT@1167_733@BUTTON_2"
msgstr "Assimile a mutação do Feiticeiro Perdido [evilact/] para ganhar poderes de dominação [unitHero/]."

msgid "STORY_EVENT@1167_733@BUTTON_3"
msgstr "Conceda imunidade permanente ao controle mental aos guerreiros que lutaram contra este {EventStackLeader}."

msgid "STORY_EVENT@1167_733@BUTTON_7"
msgstr "Crie um {EventItem} [item/] a partir do olho."

msgid "STORY_EVENT@1167_733@TITLE"
msgstr "Titereiro Desolado: Consequências"

msgid "STORY_EVENT@1167_832@BODY_FOOTER"
msgstr "\"Vá embora!\", berra um {EventUnit} que avista {EventHero.FirstName}. \"Se interferir, nossa fúria trovejante também o atingirá!\""

msgid "STORY_EVENT@1167_832@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "\"Vá embora!\", berra um {EventUnit} que te avista. \"Se interferir, nossa fúria trovejante também o atingirá!\""

msgid "STORY_EVENT@1167_832@BODY_HEADER"
msgstr "Um raio atinge o chão, não muito longe de onde {EventHero} está. Outro raio atinge a imponente {EventStructure} antes de <<P:EventHero>>."

msgid "STORY_EVENT@1167_832@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Um raio atinge o chão, não muito longe de onde você está. Outro raio atinge a imponente {EventStructure} antes de você."

msgid "STORY_EVENT@1167_832@BODY_LORE"
msgstr "Os <<m:EventUnit>>, não mais contentes em achatar montanhas, voltaram seus olhos para a {EventStructure}. Eles a sitiavam com a intenção de derrubá-la completamente, de acordo com seus esforços para remodelar o reino. Eles trouxeram trovões, raios, machados e uma hoste de bestas eletrizantes."

msgid "STORY_EVENT@1167_832@BUTTON_0"
msgstr "Atacar os <<m:EventUnit>> e suas bestas!"

msgid "STORY_EVENT@1167_832@BUTTON_1"
msgstr "Manipule [mana/] as tempestades para atingir os <<m:EventUnit>> primeiro."

msgid "STORY_EVENT@1167_832@BUTTON_3"
msgstr "Comande os raios para apressar seus guerreiros se eles forem atingidos."

msgid "STORY_EVENT@1167_832@BUTTON_4"
msgstr "Peça à {EventStructure} para ajudar seus guerreiros a resistir à tempestade."

msgid "STORY_EVENT@1167_832@BUTTON_5"
msgstr "Aterre suas tropas para protegê-las dos raios."

msgid "STORY_EVENT@1167_832@BUTTON_6"
msgstr "Invocar o frio para infundir a tempestade trovejante com geada."

msgid "STORY_EVENT@1167_832@BUTTON_7"
msgstr "Obedecer o <<G:warning^n,EventUnit>> e vá embora."

msgid "STORY_EVENT@1167_832@TITLE"
msgstr "Madeira Trovejante"

msgid "STORY_EVENT@1167_833@BODY_FOOTER"
msgstr "{EventHero.FirstName} coleta a madeira caída e procura por um memento ou prêmio para comemorar o cerco à {EventStructure}."

msgid "STORY_EVENT@1167_833@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Você coleta a madeira caída e procura por um memento ou prêmio para comemorar o cerco à {EventStructure}."

msgid "STORY_EVENT@1167_833@BODY_HEADER"
msgstr "A {EventStructure} ainda está de pé, o que é mais do que {EventHero} pode dizer sobre os <<m:EventUnit>> e seus seguidores."

msgid "STORY_EVENT@1167_833@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "A {EventStructure} ainda está de pé, o que é mais do que você pode dizer sobre os <<m:EventUnit>> e seus seguidores."

msgid "STORY_EVENT@1167_833@BODY_LORE"
msgstr "A horda trovejante dos <<m:EventUnit>> está morta ou dispersa. Alguns <<m:EventUnitB>> pousam na copa da {EventStructure}, que sobreviveu ao cerco, apesar de várias marcas de queimaduras e galhos quebrados. E vários machados ainda cravados em seu tronco. Os campos ao redor crepitam com armas infundidas com raios que cobrem as terras como folhas de outono após uma tempestade."

msgid "STORY_EVENT@1167_833@BUTTON_0"
msgstr "Exiba um galho quebrado [influence/] em {EventCity} para comemorar a conquista de hoje."

msgid "STORY_EVENT@1167_833@BUTTON_1"
msgstr "Pegue o {EventItem} [item/] que o chefe {EventUnit} deixou cair."

msgid "STORY_EVENT@1167_833@BUTTON_2"
msgstr "Domar dois <<m:EventUnitB>> [unit/] que ainda voam por perto."

msgid "STORY_EVENT@1167_833@BUTTON_3@LEARN_SPELL_AMPLIFICATION_ARROWS"
msgstr "{PlayerLeader} aprende o encantamento {GLOBAL.SPECIAL_OPERATIONS.AMPLIFIED_ARROWS.Hyperlink}."

msgid "STORY_EVENT@1167_833@BUTTON_3@LEARN_SPELL_LIGHTNING_BLADES"
msgstr "{PlayerLeader} aprende o encantamento {GLOBAL.SPECIAL_OPERATIONS.LIGHTNING_BLADES.Hyperlink}."

msgid "STORY_EVENT@1167_833@BUTTON_4"
msgstr "Aproveite a força residual do relâmpago para aumentar seu armamento."

msgid "STORY_EVENT@1167_833@TITLE"
msgstr "Madeira Trovejante: Consequências"

msgid "STORY_EVENT@1167_834@BODY_FOOTER"
msgstr "O influxo de [hyperlink,GLOBAL.ChaosConcept]Caos[/hyperlink] anima os Golems que alinham o <<G:paredes^p,EventStructure>> com intenção flamejante. \"É o único jeito,\" confessa o {EventUnit}."

msgid "STORY_EVENT@1167_834@BODY_HEADER"
msgstr "Ao entrar na {EventStructure}, {EventHero} é recebido por um {EventUnit} atordoado. \"Sua pesquisa também o trouxe aqui?\", pergunta <<p:EventUnit>>."

msgid "STORY_EVENT@1167_834@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Ao entrar na {EventStructure}, você é recebido por um {EventUnit} atordoado. \"Sua pesquisa também o trouxe aqui?\", pergunta <<p:EventUnit>>."

msgid "STORY_EVENT@1167_834@BODY_LORE"
msgstr "<<Cp:EventUnit>> conhece <<G:olhar confuso^n,{EventHero.FirstName}>> muito bem. \"Eu sou um alquimista,\" explica <<p:EventUnit>>, \"buscando criar a Prima Materia. Estou prestes a provar minha hipótese!\" O {EventUnit} gira vários discos dourados, fazendo o {EventStructure} zumbir e vibrar. \"Sinto muito,\" diz o {EventUnit} de repente. \"Para criar a Prima Materia, a [hyperlink,GLOBAL.OrderConcept]Ordem[/hyperlink] no [hyperlink,GLOBAL.MateriumConcept]Materium[/hyperlink] deve ser contrada com [hyperlink,GLOBAL.ChaosConcept]Caos[/hyperlink].\""

msgid "STORY_EVENT@1167_834@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "<<Cp:EventUnit>> conhece seu olhar confuso muito bem. \"Eu sou um alquimista,\" explica <<p:EventUnit>>, \"buscando criar a Prima Materia. Estou prestes a provar minha hipótese!\" O {EventUnit} gira vários discos dourados, fazendo o {EventStructure} zumbir e vibrar. \"Sinto muito,\" diz o {EventUnit} de repente. \"Para criar a Prima Materia, a [hyperlink,GLOBAL.OrderConcept]Ordem[/hyperlink] no [hyperlink,GLOBAL.MateriumConcept]Materium[/hyperlink] deve ser contrada com [hyperlink,GLOBAL.ChaosConcept]Caos[/hyperlink].\""

msgid "STORY_EVENT@1167_834@BUTTON_0"
msgstr "Atacar o {EventUnit} e os Golems hostis!"

msgid "STORY_EVENT@1167_834@BUTTON_1"
msgstr "Proteja magicamente [mana/] seu exército contra fogo."

msgid "STORY_EVENT@1167_834@BUTTON_10"
msgstr "Deixe o {EventUnit} e o {EventStructure}."

msgid "STORY_EVENT@1167_834@BUTTON_3"
msgstr "Treine [unitprod/] suas tropas para reconhecer os padrões de luta dos Golems."

msgid "STORY_EVENT@1167_834@BUTTON_7"
msgstr "Apague as chamas internas que aumentaram os Golems."

msgid "STORY_EVENT@1167_834@BUTTON_8"
msgstr "Use seu controle sobre metais para lentamente transformar os Golems em ouro."

msgid "STORY_EVENT@1167_834@BUTTON_9"
msgstr "Redirecione o influxo de energia do Caos para melhorar seus soldados mais fracos."

msgid "STORY_EVENT@1167_834@TITLE"
msgstr "Prima Materia"

msgid "STORY_EVENT@1167_835@BODY_FOOTER"
msgstr "A Prima Materia é sua, embora seu potencial completo seja desconhecido para você. Que outra bênção da criação {EventHero.FirstName} reclamará em seu nome?"

msgid "STORY_EVENT@1167_835@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "A Prima Materia é sua, embora seu potencial completo seja desconhecido para você. Que outra bênção da criação será sua?"

msgid "STORY_EVENT@1167_835@BODY_HEADER"
msgstr "O {EventUnit} foi morto. Seu exército sobreviveu ao torrente de [hyperlink,GLOBAL.MateriumConcept]Materium[/hyperlink] e [hyperlink,GLOBAL.ChaosConcept]Caos[/hyperlink]."

msgid "STORY_EVENT@1167_835@BODY_LORE"
msgstr "Apesar da hostilidade trapaceira do {EventUnit}, <<p:EventUnit>> não mentiu. O {EventStructure} é um tesouro de descobertas alquímicas. E agora, em <<o:EventStructure>> centro, suspensa no ar, uma substância transmórfica muda e gira sem parar. A Prima Materia. Ela permitirá que você forje artefatos e armas poderosos."

msgid "STORY_EVENT@1167_835@BUTTON_0"
msgstr "Pilhe o ouro [gold/] que reveste as paredes e os Golems."

msgid "STORY_EVENT@1167_835@BUTTON_2"
msgstr "Pegue o {EventItem} [item/] que o {EventUnit} guardou em <<o:EventUnit>> mochila."

msgid "STORY_EVENT@1167_835@BUTTON_3"
msgstr "Colete os metais e pedras [structureprod/] que estão espalhados pelo {EventStructure}."

msgid "STORY_EVENT@1167_835@BUTTON_4"
msgstr "Estude os segredos alquímicos [knowledge/] do {EventStructure}."

msgid "STORY_EVENT@1167_835@TITLE"
msgstr "Prima Materia: Consequências"

msgid "STORY_EVENT@1167_836@BODY_FOOTER"
msgstr "O Ghoul real sussurra: \"Eu sou o Adormecido na Sombra. Não quer se juntar a mim aqui dentro?\" {EventHero.FirstName} avança um passo relutantemente."

msgid "STORY_EVENT@1167_836@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "O Ghoul real sussurra: \"Eu sou o Adormecido na Sombra. Não quer se juntar a mim aqui dentro?\" Você avança um passo relutantemente."

msgid "STORY_EVENT@1167_836@BODY_HEADER"
msgstr "{EventHero} se prepara para explorar o {EventStructure} quando um escriba de olhos arregalados sai correndo: \"Ele não dorme mais! Fuja, tolos! Fuja!\""

msgid "STORY_EVENT@1167_836@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você se prepara para explorar o {EventStructure} quando um escriba de olhos arregalados sai correndo: \"Ele não dorme mais! Fuja, tolos! Fuja!\""

msgid "STORY_EVENT@1167_836@BODY_LORE"
msgstr "Um vento gelado, como se um monstro inalasse, puxa {EventHero.FirstName} em direção à entrada. O chão então treme, mas não há estrondo. Uma névoa negra rasteja da boca do {EventStructure}. Ela esconde uma figura assustadora que parece tão antiga e maligna quanto real. A determinação do seu exército diminui, enquanto a insanidade arranha a <<G:mente^n,EventHero>>."

msgid "STORY_EVENT@1167_836@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Um vento gelado, como se um monstro inalasse, puxa você em direção à entrada. O chão então treme, mas não há estrondo. Uma névoa negra rasteja da boca do {EventStructure}. Ela esconde uma figura assustadora que parece tão antiga e maligna quanto real. A determinação do seu exército diminui, enquanto a insanidade arranha a sua mente."

msgid "STORY_EVENT@1167_836@BUTTON_0"
msgstr "Corra para atacar o Adormecido na Sombra."

msgid "STORY_EVENT@1167_836@BUTTON_1"
msgstr "\"Tropas, mantenham suas mentes longe de qualquer poder letárgico que persista aqui!\""

msgid "STORY_EVENT@1167_836@BUTTON_2"
msgstr "\"A Ordem Natural sempre prevalecerá contra a escuridão.\""

msgid "STORY_EVENT@1167_836@BUTTON_4"
msgstr "Acenda o poder inspirador de suas forças de apoio."

msgid "STORY_EVENT@1167_836@BUTTON_5"
msgstr "\"A loucura não é rival para o Caos.\""

msgid "STORY_EVENT@1167_836@BUTTON_6"
msgstr "Liberte-se do encantamento terrível e recue!"

msgid "STORY_EVENT@1167_836@BUTTON_7"
msgstr "Proteja-se [mana/] contra os ataques gelados dos amaldiçoados e ensombrados."

msgid "STORY_EVENT@1167_836@TITLE"
msgstr "O Adormecido na Sombra"

msgid "STORY_EVENT@1167_837@BODY_FOOTER"
msgstr "Enquanto seus guerreiros procuram tesouros no {EventStructure}, {EventHero.FirstName} reflete sobre como essa provação mudou <<P:EventHero>> para melhor."

msgid "STORY_EVENT@1167_837@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Enquanto seus guerreiros procuram tesouros no {EventStructure}, você reflete sobre como essa provação o mudou para melhor."

msgid "STORY_EVENT@1167_837@BODY_HEADER"
msgstr "Após uma batalha fatigante e pesadelosa, o Adormecido na Sombra jaz espatifado aos <<G:pés^p,{EventHero.FirstName}>>. A sombra passou."

msgid "STORY_EVENT@1167_837@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Após uma batalha fatigante e pesadelosa, o Adormecido na Sombra jaz espatifado aos seus pés. A sombra passou."

msgid "STORY_EVENT@1167_837@BODY_LORE"
msgstr "{EventHero.FirstName} lembra de lendas antigas dos {EventRace} sobre um tirano antigo que foi eventualmente morto e amaldiçoado. Foi predito que ele retornaria para desafiar qualquer novo poder que buscasse reclamar estas terras. {EventHero.FirstName} percebe que a <<G:presença^n,PlayerLeader>> no reino provavelmente despertou o Adormecido na Sombra."

msgid "STORY_EVENT@1167_837@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Você lembra de lendas antigas dos {EventRace} sobre um tirano antigo que foi eventualmente morto e amaldiçoado. Foi predito que ele retornaria para desafiar qualquer novo poder que buscasse reclamar estas terras. Você percebe que sua presença no reino provavelmente despertou o Adormecido na Sombra."

msgid "STORY_EVENT@1167_837@BUTTON_0"
msgstr "Estude [knowledge/] as gravuras e murais arcaicos no túmulo."

msgid "STORY_EVENT@1167_837@BUTTON_2"
msgstr "Pegue a coroa negra do Adormecido na Sombra. [item/]"

msgid "STORY_EVENT@1167_837@BUTTON_4"
msgstr "O {EventStructure} está repleto de almas. [souls/]. Colha-as."

msgid "STORY_EVENT@1167_837@BUTTON_5"
msgstr "Espalhe alegria [happiness/] em suas cidades selando o túmulo intocado."

msgid "STORY_EVENT@1167_837@TITLE"
msgstr "O Adormecido na Sombra: Consequências"

msgid "STORY_EVENT@1167_838@BODY_FOOTER"
msgstr "A Ordem dos Glutões logo soltará o devorador {EnemyUnit} no mundo. Seu esquema insano deve ser detido."

msgid "STORY_EVENT@1167_838@BODY_HEADER"
msgstr "{EventHero.Name} se aproxima de um {EventStructure} construído pelos {GLOBAL.ArchonsLoreConcept.Hyperlink} há muito tempo, e é recebido por cantos e um odor muito fétido."

msgid "STORY_EVENT@1167_838@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você se aproxima do {EventStructure} construído pelos {GLOBAL.ArchonsLoreConcept.Hyperlink} há muito tempo, e é recebido por cantos e um odor muito fétido."

msgid "STORY_EVENT@1167_838@BODY_LORE"
msgstr "Espiando por dentro, {EventHero.FirstName} testemunha uma massa de cultistas, que construíram meia dúzia de pilhas de ossos e carne. No centro, um {EventUnit} alimenta um glutão {EnemyUnit} com carcaças em decomposição para fortalecê-lo. Os cultistas cantam sobre a chegada do Devorador de Mundos, augurado para consumir o reino. Uma vez que o {EnemyUnit} esteja suficientemente alimentado, os cultistas o libertarão."

msgid "STORY_EVENT@1167_838@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Espiando por dentro, você testemunha uma massa de cultistas, que construíram meia dúzia de pilhas de ossos e carne. No centro, um {EventUnit} alimenta um glutão {EnemyUnit} com carcaças em decomposição para fortalecê-lo. Os cultistas cantam sobre a chegada do Devorador de Mundos, augurado para consumir o reino. Uma vez que o {EnemyUnit} esteja suficientemente alimentado, os cultistas o libertarão."

msgid "STORY_EVENT@1167_838@BUTTON_0"
msgstr "\"Hoje seu culto termina, loucos!\""

msgid "STORY_EVENT@1167_838@BUTTON_1"
msgstr "Acelere magicamente [mana/] seus lutadores para atacar rapidamente as pilhas de carne."

msgid "STORY_EVENT@1167_838@BUTTON_2"
msgstr "\"Pelo legado dos Arcontes, eu te repreendo e denuncio!\""

msgid "STORY_EVENT@1167_838@BUTTON_3"
msgstr "Envenene as pilhas de ossos e carne que o {EnemyUnit} devorará."

msgid "STORY_EVENT@1167_838@BUTTON_5"
msgstr "Fuja do {EventStructure} e do culto, por enquanto."

msgid "STORY_EVENT@1167_838@BUTTON_6"
msgstr "Engane o {EnemyUnit} para que veja seu exército como pouco apetitoso."

msgid "STORY_EVENT@1167_838@TITLE"
msgstr "Ordem dos Glutões"

msgid "STORY_EVENT@1167_839@BODY_FOOTER"
msgstr "No entanto, o {EventStructure} ainda está sujo com sujeira e decadência. Como {EventHero.FirstName} lidará com a bagunça do culto?"

msgid "STORY_EVENT@1167_839@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "No entanto, o {EventStructure} ainda está sujo com sujeira e decadência. Como você lidará com a bagunça do culto?"

msgid "STORY_EVENT@1167_839@BODY_HEADER"
msgstr "{EventHero.Name} frustrou o esquema da Ordem dos Glutões e matou o devorador {EnemyUnit}."

msgid "STORY_EVENT@1167_839@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você frustrou o esquema da Ordem dos Glutões e matou o devorador {EnemyUnit}."

msgid "STORY_EVENT@1167_839@BODY_LORE"
msgstr "Enquanto inspeciona o {EventStructure}, outro {EventUnit} pula de um alcove escondido, tentando escapar. Com o último corruptor deixando o Templo, a graça dos {GLOBAL.ArchonsLoreConcept.Hyperlink} que um dia enobreceu este {EventStructure} é restaurada, e {EventHero.FirstName} sente sua bênção arcana percorrer o corpo de <<o:EventHero>>."

msgid "STORY_EVENT@1167_839@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Enquanto inspeciona o {EventStructure}, outro {EventUnit} pula de um alcove escondido, tentando escapar. Com o último corruptor deixando o Templo, a graça dos {GLOBAL.ArchonsLoreConcept.Hyperlink} que um dia enobreceu este {EventStructure} é restaurada, e você sente sua bênção arcana percorrer seu corpo."

msgid "STORY_EVENT@1167_839@BUTTON_0"
msgstr "Despoje o {EventStructure} de seus últimos tesouros restantes. [gold/]"

msgid "STORY_EVENT@1167_839@BUTTON_1"
msgstr "Limpe o {EventStructure} para restaurar parte de sua antiga glória. [influence/]"

msgid "STORY_EVENT@1167_839@BUTTON_2"
msgstr "Entregue a carne [food/] destinada ao {EnemyUnit} para {EventCity}."

msgid "STORY_EVENT@1167_839@BUTTON_3"
msgstr "Corra atrás do {EventUnit} [unit/] e aliste <<P:EventUnit>>."

msgid "STORY_EVENT@1167_839@TITLE"
msgstr "Ordem dos Glutões: Consequências"

msgid "STORY_EVENT@1194_1362@BODY_FOOTER"
msgstr "Você deixa o assustado {EventStackLeader.Name} e outras criaturas irem, ou os ataca mesmo assim?"

msgid "STORY_EVENT@1194_1362@BODY_HEADER"
msgstr "Suas tropas enfrentam o {EventStackLeader.Name} e <<o:EventStackLeader>> servos, mas eles se encolhem de medo em vez de lutar."

msgid "STORY_EVENT@1194_1362@BODY_LORE"
msgstr "Mesmo com a liberdade das profundezas abaixo deles, as criaturas ficam tensas e permanecem congeladas com os olhos bem abertos e fixos em suas tropas. O único som que vem deles é o ocasional respingo de água enquanto aguardam temerosamente seu destino."

msgid "STORY_EVENT@1194_1362@BUTTON_0"
msgstr "Atacar! [evilact/]"

msgid "STORY_EVENT@1194_1362@BUTTON_1"
msgstr "Deixe-os ir. [goodact/]"

msgid "STORY_EVENT@1194_1362@TITLE"
msgstr "Medo Profundo"

msgid "STORY_EVENT@1194_1476@BODY_FOOTER"
msgstr "\"Ajude-nos, ó {PlayerLeader.Title}! Três Kjörnoe se unirão para que um retorne! Riquezas, prosperidade e poder serão nossa recompensa!\""

msgid "STORY_EVENT@1194_1476@BODY_HEADER"
msgstr "Você coletou o {CauldronRelic}, {MirrorRelic} e {GrailRelic}. Agora, um cultista estranho se aproxima de você. \"Você possui os artefatos dos [hyperlink,GLOBAL.TraitorKingsLoreConcept]Kjörnoe[/hyperlink]\", <<p:EventUnit>> sussurra."

msgid "STORY_EVENT@1194_1476@BODY_LORE"
msgstr "\"Eu sou <<EventUnit{um filho/uma filha}>> dos Kjörnoe, destinado a reavivar os [hyperlink,GLOBAL.GiantKingLoreConcept]Reis Gigantes[/hyperlink] que foram tão injustamente declarados 'Traidores'. Por muito tempo, seguimos os Artefatos que você agora possui, esperando por alguém para nos ajudar. Com os Pecados dos Três, seus poderes como um {GLOBAL.GodirLoreConcept.Hyperlink} e um sacrifício inconsciente, podemos consertar os Kjörnoe e fazê-los retornar a nós!\""

msgid "STORY_EVENT@1194_1476@BUTTON_0"
msgstr "Iniciar o ritual para trazer de volta um Rei Traidor."

msgid "STORY_EVENT@1194_1476@BUTTON_1"
msgstr "Use os Artefatos para governar os Filhos dos Kjörnoe você mesmo."

msgid "STORY_EVENT@1194_1476@BUTTON_2"
msgstr "Rejeitar o culto dos Filhos dos Kjörnoe. [goodact/]"

msgid "STORY_EVENT@1194_1476@TITLE"
msgstr "Retorno dos Kjörnoe"

msgid "STORY_EVENT@1194_1481@BODY_FOOTER"
msgstr "\"Fomos destruídos, fragmentados. Agora nós... Eu sou {TraitorKingLord.FirstName}. Meu destino, ligado a você. Eu pago nossas dívidas. Nomeie as suas.\""

msgid "STORY_EVENT@1194_1481@BODY_HEADER"
msgstr "Usando seus próprios poderes de {GLOBAL.GodirLoreConcept.Hyperlink} e os Artefatos dos {GLOBAL.TraitorKingsLoreConcept.Hyperlink}, você guia suas almas fragmentadas para um hospedeiro relutante."

msgid "STORY_EVENT@1194_1481@BODY_LORE"
msgstr "Incapaz de responder ao ataque repentino, {PreviousPlayer} é lançado no {GLOBAL.AstralVoidLoreConcept.Hyperlink}. Os gritos agonizantes de <<Co:PreviousPlayer>> e as risadas maníacas dos Filhos dos [hyperlink,GLOBAL.TraitorKingsLoreConcept]Kjörnoe[/hyperlink] anunciam a chegada dos {GLOBAL.TraitorKingsLoreConcept.Hyperlink}. Suas almas fragmentadas se fundem para formar um {GLOBAL.GiantKingLoreConcept.Hyperlink}, que rugem com três vozes antes de encontrar <<o:TraitorKingLord>> compostura. <<Cp:TraitorKingLord>> se vira para você: \"Você nos reavivou.\""

msgid "STORY_EVENT@1194_1481@BUTTON_0"
msgstr "\"Conceda-me as riquezas [gold/] que me foram prometidas.\""

msgid "STORY_EVENT@1194_1481@BUTTON_1"
msgstr "\"Disseram-me que você trouxe prosperidade.\" [food/]"

msgid "STORY_EVENT@1194_1481@BUTTON_2"
msgstr "\"Conceda-me sua reverência!\" [influence/]"

msgid "STORY_EVENT@1194_1481@TITLE"
msgstr "Retorno dos Kjörnoe: Reavivando"

msgid "STORY_EVENT@1194_1490@BODY_FOOTER"
msgstr "O cultista grita em êxtase. \"Canalize as almas dos Kjörnoe, conserte seus fragmentos! Guie-os para seu hospedeiro e trono!\""

msgid "STORY_EVENT@1194_1490@BODY_HEADER"
msgstr "Lágrimas brotam nos olhos do cultista. \"Sim! Vamos começar o ritual imediatamente!\""

msgid "STORY_EVENT@1194_1490@BODY_LORE"
msgstr "Mais tarde, você se encontra no centro de uma runa elaborada, os Artefatos dos {GLOBAL.TraitorKingsLoreConcept.Hyperlink} colocados ao seu redor. Fumaça escura o envolve enquanto o cultista canta. \"Os Kjörnoe sentem seu poder\", <<p:EventUnit>> exclama. \"Com você como seu condutor, eles precisam apenas de um hospedeiro, um cordeiro {GLOBAL.GodirLoreConcept.Hyperlink} inconsciente para sacrificar! Encontre um, ó {PlayerLeader.Title}! Conceda ao [hyperlink,GLOBAL.AstralVoidLoreConcept]Vazio[/hyperlink] seu prêmio!\""

msgid "STORY_EVENT@1194_1490@BUTTON_0"
msgstr "Guie as almas fragmentadas para o caos de {ReplacedPlayerChaos}. [evilact/]"

msgid "STORY_EVENT@1194_1490@BUTTON_1"
msgstr "Guie as almas fragmentadas para a aura firme de {ReplacedPlayerMaterium}. [evilact/]"

msgid "STORY_EVENT@1194_1490@BUTTON_2"
msgstr "Guie as almas fragmentadas para o espírito trovejante de {ReplacedPlayerAstral}. [evilact/]"

msgid "STORY_EVENT@1194_1490@BUTTON_3"
msgstr "Guie as almas fragmentadas até a alma fria de {ReplacedPlayerShadow}. [evilact/]"

msgid "STORY_EVENT@1194_1490@BUTTON_4"
msgstr "Isso vai longe demais. Pare o ritual e banir o cultista. [goodact/]"

msgid "STORY_EVENT@1194_1490@TITLE"
msgstr "O Retorno do Kjörnoe: Ritual Sombrio"

msgid "STORY_EVENT@1194_1595@BODY_FOOTER"
msgstr "A distância pode ser uma bênção. Por enquanto, o Abismo Umbral pode estar adormecido, mas suas forças podem ser avassaladoras se você as despertar sem preparação."

msgid "STORY_EVENT@1194_1595@BODY_HEADER"
msgstr "Você se estabeleceu em uma ilha fora do {EventRealm}. Uma névoa leve repousa sobre as ilhas ao seu redor, obscurecendo a costa à distância."

msgid "STORY_EVENT@1194_1595@BODY_LORE"
msgstr "Você lembra da descrição do reino que lhe foi dada. Ao norte e ao sul, você vê os contornos de ilhas irregulares, pequenos pedaços de terra pontilhando o oceano. A leste, você imagina os iminentes Penhascos de Sordünn, reclamados pelo {GLOBAL.ShadowRealmLoreConcept.Hyperlink}. O oceano os bloqueia do seu alcance — e você deles."

msgid "STORY_EVENT@1194_1595@BUTTON_0"
msgstr "Devemos preparar nossa invasão do Abismo Umbral."

msgid "STORY_EVENT@1194_1595@TITLE"
msgstr "O {EventRealm}"

msgid "STORY_EVENT@1194_1632@BODY_FOOTER"
msgstr "Ou será que não é?"

msgid "STORY_EVENT@1194_1632@BODY_HEADER"
msgstr "Derrote {Merlin.TitleName}"

msgid "STORY_EVENT@1194_1632@BODY_LORE"
msgstr "É o único caminho"

msgid "STORY_EVENT@1194_1632@BUTTON_0"
msgstr "Talvez"

msgid "STORY_EVENT@1194_1632@TITLE"
msgstr "Salve o Reino"

msgid "STORY_EVENT@1194_1633@BODY_FOOTER"
msgstr "Seus soldados varrem o {EventRealm}, limpando as últimas infestações da influência Umbral. Este [hyperlink,GLOBAL.WorldsWithinLoreConcept]Mundo[/hyperlink] e seu [hyperlink,GLOBAL.DreamersLoreConcept]Sonhador[/hyperlink] podem se curar mais uma vez."

msgid "STORY_EVENT@1194_1633@BODY_HEADER"
msgstr "Você derrotou {Merlin.TitleName} e <<o:Merlin>> [hyperlink,GLOBAL.ShadowDemonsLoreConcept]forças Umbrais[/hyperlink]. <<Cp:Merlin>> afunda no chão. {Sundren.FirstName} e {Julia.FirstName} aparecem e ajoelham-se ao lado de <<P:Merlin>>."

msgid "STORY_EVENT@1194_1633@BODY_LORE"
msgstr "{Julia.FirstName} fecha suavemente <<o:Merlin>> olhos. \"Sinto muito, meu velho amigo.\" <<Cp:Julia>> sussurra, uma única lágrima descendo pelo rosto de <<o:Julia>>. {Sundren.FirstName} fixa seu olhar em você. \"Tentei fazer o certo por meu pai, mãe e mentor. Talvez eu estivesse errada. Leve-me a Magehaven, para enfrentar meu julgamento, como {Merlin.FirstName} fez aqui.\""

msgid "STORY_EVENT@1194_1633@BUTTON_0"
msgstr "Uma vitória conquistada com dificuldade."

msgid "STORY_EVENT@1194_1633@TITLE"
msgstr "O {EventRealm}, libertado"

msgid "STORY_EVENT@1194_1654@BODY_FOOTER"
msgstr "\"Sinto uma presença familiar, envolta em sombras. Minha natureza rejeita a escuridão, e ainda assim uma parte de mim urge que investiguemos... Eu imploro que você faça isso, {PlayerLeader.TitleName}. Sinto que é importante.\""

msgid "STORY_EVENT@1194_1654@BODY_HEADER"
msgstr "Enquanto você viaja pelo {EventRealm}, {Julia.FirstName} entra em contato com você. \"{PlayerLeader.FirstName}, sei que temos uma missão importante para nos concentrar, mas sinto outra presença neste reino.\""

msgid "STORY_EVENT@1194_1654@BODY_LORE"
msgstr "\"Algo, ou alguém, me alcança do {GLOBAL.ShadowRealmLoreConcept.Hyperlink}. Parece familiar, mas distorcido, quase como se... Não, não devo esperar em vão.\" {Julia.FirstName} implora: \"Quem quer que seja, eles precisam da nossa ajuda.\""

msgid "STORY_EVENT@1194_1654@BUTTON_0"
msgstr "\"Veremos.\""

msgid "STORY_EVENT@1194_1654@TITLE"
msgstr "Cintilar na Escuridão"

msgid "STORY_EVENT@1194_1655@BODY_FOOTER"
msgstr "{Sundren.FirstName} mal reage ao tom severo de sua mãe. \"Não tomei minhas decisões levianamente, mãe... Estou aqui para salvar aqueles que me importo.\""

msgid "STORY_EVENT@1194_1655@BODY_HEADER"
msgstr "Você derrotou o último [hyperlink,GLOBAL.ShadowDemonsLoreConcept]Demônio Umbral[/hyperlink] que ameaçava a entidade escondida na torre de vigia. Agora, uma figura emerge dela."

msgid "STORY_EVENT@1194_1655@BODY_LORE"
msgstr "\"Você reconhece a figura como uma Elfa, envolta em sombras defensivas. {Julia.FirstName} suspira. \"... Sundren? É realmente você?\"[br/]O olhar severo da Elfa sombria muda e seus olhos se arregalam. \"Mãe?!\"\" {Sundren.FirstName} exclama, e {Julia.FirstName} e {Sundren.FirstName} se reúnem, emocionadas.[br/]\n"
"\"Eu persegui o [hyperlink,GLOBAL.AstralSeaLoreConcept]Mar Astral[/hyperlink] por você,\" {Sundren.FirstName} finalmente diz.[br/] {Julia.FirstName} concorda. \"Ouvi muito sobre seus esforços, minha filha... E a ira que você provoca.\""

msgid "STORY_EVENT@1194_1655@BUTTON_0"
msgstr "Continue ouvindo."

msgid "STORY_EVENT@1194_1655@TITLE"
msgstr "Cintilar na Escuridão: Consequências"

msgid "STORY_EVENT@1194_1658@BODY_FOOTER"
msgstr "\"Há uma torre de vigia, onde fiz minha resistência. Liberte-me, e eu ficarei em sua dívida.\" A voz pausa por um momento. \"... Por favor.\""

msgid "STORY_EVENT@1194_1658@BODY_HEADER"
msgstr "Suas tropas entram no {GLOBAL.ShadowRealmLoreConcept.Hyperlink}. Imediatamente, um sussurro chega até você, crescendo em uma voz etérea carregada pelo ar pesado do Abismo Umbral."

msgid "STORY_EVENT@1194_1658@BODY_LORE"
msgstr "\"Estou em uma missão importante que mudará a guerra contra o {GLOBAL.ShadowRealmLoreConcept.Hyperlink}. Mas esses malditos {GLOBAL.ShadowDemonsLoreConcept.Hyperlink} provaram ser... desafiadores. Ajude-me, para que eu possa terminar minha missão.\""

msgid "STORY_EVENT@1194_1658@BUTTON_0"
msgstr "\"Vou considerar isso.\""

msgid "STORY_EVENT@1194_1658@TITLE"
msgstr "Cintilar na Escuridão: No Abismo"

msgid "STORY_EVENT@1194_1673@BODY_FOOTER"
msgstr "\"Como um símbolo de boa vontade, ofereço a você o conhecimento para atravessar os mares de Sordünn. Também percebo que você pode ter mais perguntas para mim.\""

msgid "STORY_EVENT@1194_1673@BODY_HEADER"
msgstr "Você é abordado por uma mulher Elfa regal. <<Co:Julia>> postura é orgulhosa, mas <<o:Julia>> olhos traem eras de conflito, perda e esperança."

msgid "STORY_EVENT@1194_1673@BODY_LORE"
msgstr "\"Salve, {PlayerLeader.TitleName},\" <<p:Julia>> diz. \"Meu nome é {Julia.Name}, {Julia.Title}. Fui enviada aqui pelos {GLOBAL.ArchonsLoreConcept.Hyperlink} para ajudá-lo neste reino.\" <<Cp:Julia>> olha para a costa à distância, e sua voz desaparece por um momento. \"Tantos mundos, devastados pela escuridão... Devemos lutar contra isso.\""

msgid "STORY_EVENT@1194_1673@BUTTON_0"
msgstr "\"Quem é você?\""

msgid "STORY_EVENT@1194_1673@BUTTON_1"
msgstr "\"Você sabe algo sobre a Profecia que nos trouxe aqui?\""

msgid "STORY_EVENT@1194_1673@BUTTON_2"
msgstr "\"Você já lutou contra o Abismo Umbral antes?\""

msgid "STORY_EVENT@1194_1673@BUTTON_3"
msgstr "\"Aceito sua ajuda. Vamos lutar contra o Abismo Umbral, juntos.\""

msgid "STORY_EVENT@1194_1673@TITLE"
msgstr "A Campeã dos Arcontes"

msgid "STORY_EVENT@1194_1676@BODY_FOOTER"
msgstr "\"O {EventRealm} costumava fazer parte de {GLOBAL.MyrridaLoreConcept.Hyperlink}. Os {GLOBAL.ArchonsLoreConcept.Hyperlink} acreditam ser a guarda divina, e nós somos os novos poderes a surgir. Quanto à estrofe sobre o Sangue do Traidor... Eles não conseguiram concordar sobre sua interpretação.\""

msgid "STORY_EVENT@1194_1676@BODY_HEADER"
msgstr "{Julia.FirstName} concorda lentamente. \"Conheço a Profecia de Golianth.\""

msgid "STORY_EVENT@1194_1676@BODY_LORE"
msgstr "{Julia.FirstName} recita: \"Miopia Divina, Equilíbrio Acorrentado;\n"
"Impérios Gigantes Caem, a Corrupção Reina;\n"
"\n"
"Do Sangue do Traidor, o Caminho do Destino se Divide;\n"
"A Escuridão é Morta, Através da Luz Fraturada;\n"
"\n"
"A Guarda Divina deve Descansar, Para Novos Poderes Surgirem;\n"
"Que Pesam o Custo da Misericórdia, Para uma Vingança Fatal.\""

msgid "STORY_EVENT@1194_1676@BUTTON_0"
msgstr "\"Quem é você?\""

msgid "STORY_EVENT@1194_1676@BUTTON_1"
msgstr "\"Você sabe algo sobre a Profecia que nos trouxe aqui?\""

msgid "STORY_EVENT@1194_1676@BUTTON_2"
msgstr "\"Você já lutou contra o Abismo Umbral antes?\""

msgid "STORY_EVENT@1194_1676@BUTTON_3"
msgstr "\"Aceito sua ajuda. Vamos lutar contra o Abismo Umbral, juntos.\""

msgid "STORY_EVENT@1194_1676@TITLE"
msgstr "A Profecia de Golianth"

msgid "STORY_EVENT@1194_1677@BODY_FOOTER"
msgstr "\"Fui encontrada por uma vanguarda dos [hyperlink,GLOBAL.ArchonsLoreConcept]Arcontes[/hyperlink] e levada a Emnora. Desde então, tenho viajado pelos {GLOBAL.WorldsWithinLoreConcept.Hyperlink}, preservando a vida e reconstruindo onde posso.\""

msgid "STORY_EVENT@1194_1677@BODY_HEADER"
msgstr "{Julia.FirstName} suspira e acena com a cabeça. \"Já lutei contra as forças do {GLOBAL.ShadowRealmLoreConcept.Hyperlink} muitas vezes antes... Na última vez, eu perdi.\""

msgid "STORY_EVENT@1194_1677@BODY_LORE"
msgstr "\"Quando os [hyperlink,GLOBAL.WorldGateLoreConcept]Portais Mundiais[/hyperlink] se abriram, os Impérios de {GLOBAL.AthlaLoreConcept.Hyperlink} já estavam dilacerados por guerra e conspiração. Nós resistimos valentemente, mas... Meu marido, ele foi—assassinado. Eu fui capturada.\" Um tom amargo se insinua na voz de <<o:Julia>> enquanto ela continua: \"Um dia, fui libertada, por um ato tão gentil quanto tolo.\""

msgid "STORY_EVENT@1194_1677@BUTTON_0"
msgstr "\"Quem é você?\""

msgid "STORY_EVENT@1194_1677@BUTTON_1"
msgstr "\"Você sabe algo sobre a Profecia que nos trouxe aqui?\""

msgid "STORY_EVENT@1194_1677@BUTTON_2"
msgstr "\"Você já lutou contra o Abismo Umbral antes?\""

msgid "STORY_EVENT@1194_1677@BUTTON_3"
msgstr "\"Aceito sua ajuda. Vamos lutar contra o Abismo Umbral, juntos.\""

msgid "STORY_EVENT@1194_1677@TITLE"
msgstr "Prisioneira de Lithyl"

msgid "STORY_EVENT@1194_1678@BODY_FOOTER"
msgstr "\"... Mas acima de tudo, sou uma mãe. Para meus dois filhos: Thannis e [hyperlink,GLOBAL.SundrenLoreConcept]Sundren[/hyperlink]... onde quer que eles estejam.\""

msgid "STORY_EVENT@1194_1678@BODY_HEADER"
msgstr "{Julia.FirstName} sorri com uma profunda tristeza. \"Quem sou eu? Essa é uma pergunta difícil de responder...\""

msgid "STORY_EVENT@1194_1678@BODY_LORE"
msgstr "\"Sou a filha do falecido Imperador Inioch de {GLOBAL.AthlaLoreConcept.Hyperlink}, a quem amei e contra quem lutei. Sou irmã de [hyperlink,GLOBAL.MeandorLoreConcept]Meandor[/hyperlink], contra quem lutei e amei. Eu sou—\" sua voz falha, apenas por um momento: \"... Viúva do meu amado rei Saridas. Eu lutei, amei, segui e reinei. Vi grandes atrocidades e belas bondades... Fui uma pária e uma rainha para muitos.\""

msgid "STORY_EVENT@1194_1678@BUTTON_0"
msgstr "\"Quem é você?\""

msgid "STORY_EVENT@1194_1678@BUTTON_1"
msgstr "\"Você sabe algo sobre a Profecia que nos trouxe aqui?\""

msgid "STORY_EVENT@1194_1678@BUTTON_2"
msgstr "\"Você já lutou contra o Abismo Umbral antes?\""

msgid "STORY_EVENT@1194_1678@BUTTON_3"
msgstr "\"Aceito sua ajuda. Vamos lutar contra o Abismo Umbral, juntos.\""

msgid "STORY_EVENT@1194_1678@TITLE"
msgstr "Rebelde, Rainha, Mãe"

msgid "STORY_EVENT@1194_1684@BODY_FOOTER"
msgstr "Que pena"

msgid "STORY_EVENT@1194_1684@BODY_HEADER"
msgstr "Você encontra {Merlin.TitleName}"

msgid "STORY_EVENT@1194_1684@BODY_LORE"
msgstr "Ele vai para a guerra com você"

msgid "STORY_EVENT@1194_1684@BUTTON_0"
msgstr "Que pena"

msgid "STORY_EVENT@1194_1684@BUTTON_1"
msgstr "Eu posso salvar você"

msgid "STORY_EVENT@1194_1684@TITLE"
msgstr "Encontrando {Merlin.TitleName}"

msgid "STORY_EVENT@1194_1690@BODY_FOOTER"
msgstr "Sundren não pode fazer isso sozinha, já que está muito alinhada com a Sombra. Ela também percebe que não pode fazer tudo sozinha (o Jogador precisa ajudá-la)"

msgid "STORY_EVENT@1194_1690@BODY_HEADER"
msgstr "Sundren compartilha que Merlin está tentando corromper as outras Afinidades e os Arcontes (transformando-os em Revenantes)."

msgid "STORY_EVENT@1194_1690@BODY_LORE"
msgstr "\"Ele é atualmente o general principal do Abismo Umbral e está usando seu conhecimento das esferas/afinidades para corrompê-las.\"\n"
"Sundren compartilha que Merlin pode potencialmente ser purificado, canalizando as diferentes Afinidades. \"Há outros como eu neste reino, precisamos libertar todos eles.\""

msgid "STORY_EVENT@1194_1690@BUTTON_0"
msgstr "Verei o que posso fazer."

msgid "STORY_EVENT@1194_1690@TITLE"
msgstr "Através da Luz Fraturada"

msgid "STORY_EVENT@1194_1691@BODY_FOOTER"
msgstr "Confronte-o"

msgid "STORY_EVENT@1194_1691@BODY_HEADER"
msgstr "Você coletou todas as Afinidades"

msgid "STORY_EVENT@1194_1691@BODY_LORE"
msgstr "Agora você pode colocar Merlin em um caminho de redenção"

msgid "STORY_EVENT@1194_1691@BUTTON_0"
msgstr "vamos lá"

msgid "STORY_EVENT@1194_1691@TITLE"
msgstr "Através da Luz Fraturada: Consequências"

msgid "STORY_EVENT@1194_1726@BODY_FOOTER"
msgstr "escolher"

msgid "STORY_EVENT@1194_1726@BODY_HEADER"
msgstr "Mas você pode usar as afinidades para purificá-lo"

msgid "STORY_EVENT@1194_1726@BODY_LORE"
msgstr "você fará isso?"

msgid "STORY_EVENT@1194_1726@BUTTON_0"
msgstr "Eu vou colocá-lo em um caminho de redenção"

msgid "STORY_EVENT@1194_1726@BUTTON_1"
msgstr "não, ele merece morrer"

msgid "STORY_EVENT@1194_1726@TITLE"
msgstr "Você derrotou Merlin"

msgid "STORY_EVENT@1194_1738@BODY_FOOTER"
msgstr "boa"

msgid "STORY_EVENT@1194_1738@BODY_HEADER"
msgstr "Acionou o local da Ordem"

msgid "STORY_EVENT@1194_1738@BODY_LORE"
msgstr "legal"

msgid "STORY_EVENT@1194_1738@BUTTON_0"
msgstr "legal"

msgid "STORY_EVENT@1194_1738@TITLE"
msgstr "Teste"

msgid "STORY_EVENT@1194_1758@BODY_FOOTER"
msgstr "legal"

msgid "STORY_EVENT@1194_1758@BODY_HEADER"
msgstr "ele é um morto-vivo"

msgid "STORY_EVENT@1194_1758@BODY_LORE"
msgstr "também mais lore"

msgid "STORY_EVENT@1194_1758@BUTTON_0"
msgstr "guerra é o que há"

msgid "STORY_EVENT@1194_1758@TITLE"
msgstr "conheça o revenant"

msgid "STORY_EVENT@1194_1927@BODY_FOOTER"
msgstr "O fantasma suspira, o aroma de rosas quase te domina. \"Como éramos belos. Quão apaixonado era nosso amor...\""

msgid "STORY_EVENT@1194_1927@BODY_HEADER"
msgstr "Você encontrou a fonte do chamado atraente que ouviu antes. O aroma de rosas e cinzas fica mais forte."

msgid "STORY_EVENT@1194_1927@BODY_LORE"
msgstr "Não muito tempo depois, uma figura fraca aparece diante de você. \"Meu Príncipe...\" Ela pausa. \"Você não é meu Príncipe Pálido... Mas carrega sua maldição... minha maldição.\" Ela lamenta. \"Oh [hyperlink,GLOBAL.UrvatoghLoreConcept]Urvatogh[/hyperlink], o que eu fiz...\"[br/][br/]Ela se vira para você e gesticula para a {EventStructure}. \"Este é o lugar onde lutamos, este é o lugar onde eu o amaldiçoei. Onde traímos um ao outro...\""

msgid "STORY_EVENT@1194_1927@BUTTON_0"
msgstr "\"Conte-me mais.\""

msgid "STORY_EVENT@1194_1927@BUTTON_1"
msgstr "\"Já ouvi o suficiente dessa história de fantasma. Vá embora.\""

msgid "STORY_EVENT@1194_1927@TITLE"
msgstr "Fogo e Rosas: Consequências"

msgid "STORY_EVENT@1194_1941@BODY_FOOTER"
msgstr "\"Aquelas rosas lindas, transformadas em {EventMaterial}... Para sempre fora do meu alcance!\" Ela lamenta novamente, perdida em agonia. \"Por que ele manteve as rosas longe de mim? Por quê? POR QUÊ?!\""

msgid "STORY_EVENT@1194_1941@BODY_HEADER"
msgstr "O fantasma continua. \"Eu era uma bruxa, abençoada pelo Caos... ele era um Príncipe, favorecido pela Sombra.\""

msgid "STORY_EVENT@1194_1941@BODY_LORE"
msgstr "\"Meu Príncipe... Ele cultivava rosas de vidro... Rosas tão lindas! Nós nos apaixonamos. Eu lhe dei... Tudo. E ainda assim, ele não me deu. Ele não poupou nenhuma rosa para mim. Por que ele as manteria longe de mim? Nosso amor virou cinzas. E então, decidi tomar o que ele não me daria. Eu o traí, eu... eu...\""

msgid "STORY_EVENT@1194_1941@BUTTON_0"
msgstr "\"Eu vou reclamar {EventMaterial} para você.\""

msgid "STORY_EVENT@1194_1941@BUTTON_1"
msgstr "\"Encontre outra coisa para se obsessionar.\""

msgid "STORY_EVENT@1194_1941@TITLE"
msgstr "Coração de Vidro"

msgid "STORY_EVENT@1194_1942@BODY_FOOTER"
msgstr "\"Agora, eu posso descansar... E eu te dou minha arma, para conceder a ele o mesmo alívio.\" A bruxa desaparece, o cheiro de rosas desvanecendo com sua memória."

msgid "STORY_EVENT@1194_1942@BODY_HEADER"
msgstr "Você reclamou o {EventIngredient}. Você ouve um suspiro profundo enquanto o fantasma aparece mais uma vez."

msgid "STORY_EVENT@1194_1942@BODY_LORE"
msgstr "\"...Eu traí meu [hyperlink,GLOBAL.UrvatoghLoreConcept]Príncipe Pálido[/hyperlink], tentei tomar uma rosa à força. Nós lutamos,\" ela continua. \"Meu Caos encontrou sua Sombra... Em nosso momento final, eu o amaldiçoei, ele e suas rosas... Ele me consumiu em sua raiva. Eu não sabia... Ele estava cultivando uma rosa para mim o tempo todo.\""

msgid "STORY_EVENT@1194_1942@BUTTON_0"
msgstr "Peça aos seus estudiosos para [knowledge/] cronicar esta história."

msgid "STORY_EVENT@1194_1942@BUTTON_1"
msgstr "Guie a alma perdida [mana/] em seu caminho para o Mar Astral. [goodact/]"

msgid "STORY_EVENT@1194_1942@BUTTON_2"
msgstr "Drene a bruxa de sua essência [mana/] enquanto ela desaparece. [evilact/]"

msgid "STORY_EVENT@1194_1942@TITLE"
msgstr "Coração de Vidro: Consequências"

msgid "STORY_EVENT@1194_1945@BODY_FOOTER"
msgstr "\"Me encontre,\" a voz sussurra, o cheiro quase irresistível: \"Volte para mim... Meu Príncipe...\""

msgid "STORY_EVENT@1194_1945@BODY_HEADER"
msgstr "Enquanto você viaja através de {EventRealm}, um cheiro fraco chama sua atenção. Cheira a fogo, e rosas, e paixão."

msgid "STORY_EVENT@1194_1945@BODY_LORE"
msgstr "Sua atenção se volta para o cheiro estranho, e enquanto você se concentra, começa a ouvir uma voz, um sussurro fraco no vento. \"Vampiro... Meu Príncipe. Me encontre... Onde lutamos... Onde caímos... Onde meu sangue tocou seus lábios.\""

msgid "STORY_EVENT@1194_1945@BUTTON_0"
msgstr "Siga o cheiro atraente."

msgid "STORY_EVENT@1194_1945@BUTTON_1"
msgstr "Concentre-se em suas outras tarefas."

msgid "STORY_EVENT@1194_1945@TITLE"
msgstr "Fogo e Rosas"

msgid "STORY_EVENT@1194_27@BODY_HEADER"
msgstr "Contos de um {GLOBAL.GodirLoreConcept.Hyperlink} perverso fazem até os mais tenazes do seu povo tremerem. Enquanto investigava esses contos, você é contactado por ninguém menos que {EventRuler.TitleName}."

msgid "STORY_EVENT@1194_27@BODY_LORE"
msgstr "\"Parece que minha [hyperlink,GLOBAL.AlignmentConcept]reputação[/hyperlink] me precede... E a sua também. Muitos chamados Governantes carecem da força de vontade para reclamar e conquistar o que é deles para tomar, mas você não hesita. Temos isso em comum. Aceite minha oferta, e eu posso ajudá-lo em seu caminho de dominação, por quaisquer meios necessários.\""

msgid "STORY_EVENT@1194_27@BUTTON_0"
msgstr "\"Eu aceito sua oferta. Vamos conquistar o reino.\" [unit/]"

msgid "STORY_EVENT@1194_27@BUTTON_1"
msgstr "\"No momento, não posso acomodar sua chegada, mas darei boas-vindas à sua ajuda no futuro.\""

msgid "STORY_EVENT@1194_27@BUTTON_2"
msgstr "\"Foras daqui, patife! Não há lugar para você aqui.\""

msgid "STORY_EVENT@1194_27@TITLE"
msgstr "A Ajuda de um Godir Notório"

msgid "STORY_EVENT@1194_31@BODY_HEADER"
msgstr "Um de seus mensageiros se aproxima de você. \"Benevolente {PlayerLeader.Title}, uma mensagem de {GLOBAL.MagehavenLoreConcept.Hyperlink} chegou. {EventRuler.TitleName} entra em contato com você.\""

msgid "STORY_EVENT@1194_31@BODY_LORE"
msgstr "Você ouviu poemas e canções sobre o virtuoso {EventRuler.Name} no passado. \"Saudações, ó {PlayerLeader.Title},\" <<p:EventRuler>> diz. \"Estou viajando pelos reinos, ajudando outros {GLOBAL.GodirLoreConcept.Hyperlink} que lutam por uma causa nobre. Vendo que você também tem um [hyperlink,GLOBAL.AlignmentConcept]coração bondoso[/hyperlink], ofereço-me para me juntar a você e emprestar minha ajuda.\""

msgid "STORY_EVENT@1194_31@BUTTON_0"
msgstr "\"Eu aceito. Vamos trazer paz e prosperidade para este Reino juntos!\" [unit/]"

msgid "STORY_EVENT@1194_31@BUTTON_1"
msgstr "\"Você é muito bem-vindo. Eu o alistarei assim que o destino permitir.\""

msgid "STORY_EVENT@1194_31@BUTTON_2"
msgstr "\"Agradeço sua oferta, mas preciso encontrar meu próprio caminho.\""

msgid "STORY_EVENT@1194_31@TITLE"
msgstr "A Ajuda de um Godir Virtuoso"

msgid "STORY_EVENT@1194_33@BODY_HEADER"
msgstr "Os {GLOBAL.AstralFlowsLoreConcept.Hyperlink} estão inquietos hoje. Um poderoso {GLOBAL.GodirLoreConcept.Hyperlink} entra em contato com você através da névoa arcana."

msgid "STORY_EVENT@1194_33@BODY_LORE"
msgstr "{EventRuler.TitleName} aparece diante de você. \"Vejo que você aprendeu as artes arcanas, {PlayerLeader.TitleName}. O {GLOBAL.AstralSeaLoreConcept.Hyperlink} vibra com sua presença. Seus estudos do [hyperlink,GLOBAL.AstralConcept]Astral[/hyperlink] são de meu interesse. Permita-me caminhar entre seus {PlayerRace}, para que eu possa aprender com você e seu povo. Em troca, ofereço minha expertise.\""

msgid "STORY_EVENT@1194_33@BUTTON_0"
msgstr "\"Junte-se a mim e juntos poderemos dominar o arcano.\" [unit/]"

msgid "STORY_EVENT@1194_33@BUTTON_1"
msgstr "\"Vou me preparar para sua chegada e o convidarei no futuro.\""

msgid "STORY_EVENT@1194_33@BUTTON_2"
msgstr "\"Não, tenho outros planos.\""

msgid "STORY_EVENT@1194_33@TITLE"
msgstr "A Ajuda de um Godir Astral"

msgid "STORY_EVENT@1194_38@BODY_HEADER"
msgstr "Uma estranha corrente no {GLOBAL.AstralSeaLoreConcept.Hyperlink} chama sua atenção. Um sentimento tentador de anarquismo e paixão o domina, enquanto um {GLOBAL.GodirLoreConcept.Hyperlink} entra em contato com você."

msgid "STORY_EVENT@1194_38@BODY_LORE"
msgstr "Na visão de calor turbulento, {EventRuler.TitleName} aparece. \"Seu [hyperlink,GLOBAL.ChaosConcept]Caos[/hyperlink] causa inconsistência neste universo perpétuo. Eu gosto disso. Anarquismo e caos nos levarão à verdadeira liberdade! O que você diz, {PlayerLeader.TitleName}, se eu me juntar às suas forças e abalarmos os alicerces deste reino?\""

msgid "STORY_EVENT@1194_38@BUTTON_0"
msgstr "\"Sempre tenho espaço para Godir poderosos.\" [unit/]"

msgid "STORY_EVENT@1194_38@BUTTON_1"
msgstr "\"Vou me preparar para sua chegada e o receberei mais tarde, meu <<EventRuler{irmão/irmã}>> no caos.\""

msgid "STORY_EVENT@1194_38@BUTTON_2"
msgstr "\"Não preciso da sua ajuda.\""

msgid "STORY_EVENT@1194_38@TITLE"
msgstr "A Ajuda de um Godir do Caos"

msgid "STORY_EVENT@1194_39@BODY_HEADER"
msgstr "Um artefato artesanal com gravações arcanas é entregue a você. Depois de aceitá-lo, o artefato se abre, revelando que ninguém menos que {EventRuler.TitleName} tem uma oferta para você!"

msgid "STORY_EVENT@1194_39@BODY_LORE"
msgstr "{EventRuler.Title} {EventRuler.FirstName} aparece. \"Seu interesse em [hyperlink,GLOBAL.MateriumConcept]Materium[/hyperlink] chamou minha atenção. O poder da criação e da transmutação corre por você, e os elementos se curvam à sua vontade. Peço apenas para me juntar a você em sua busca para dominar toda a matéria. Você me receberá?\""

msgid "STORY_EVENT@1194_39@BUTTON_0"
msgstr "\"Junte-se a mim e você verá todas as maravilhas deste reino.\" [unit/]"

msgid "STORY_EVENT@1194_39@BUTTON_1"
msgstr "\"Você pode se juntar a mim assim que eu tiver capacidade.\""

msgid "STORY_EVENT@1194_39@BUTTON_2"
msgstr "\"Não preciso da sua ajuda.\""

msgid "STORY_EVENT@1194_39@TITLE"
msgstr "A Ajuda de um Godir de Materium"

msgid "STORY_EVENT@1194_40@BODY_HEADER"
msgstr "Nas folhas farfalhantes e na água corrente, você ouve a voz de um {GLOBAL.GodirLoreConcept.Hyperlink}."

msgid "STORY_EVENT@1194_40@BODY_LORE"
msgstr "{EventRuler.TitleName} aparece diante de você. \"Os ventos da primavera sussurram sobre outro [hyperlink,GLOBAL.NatureConcept]amigo da natureza[/hyperlink]. Parece que você abraça a vida e o crescimento tanto quanto eu. Vamos unir forças. Juntos, podemos trazer prosperidade a este reino!\""

msgid "STORY_EVENT@1194_40@BUTTON_0"
msgstr "\"Aceito sua oferta. Junte-se a mim neste reino!\" [unit/]"

msgid "STORY_EVENT@1194_40@BUTTON_1"
msgstr "\"No momento, não posso acomodar sua chegada, mas receberei sua ajuda no futuro.\""

msgid "STORY_EVENT@1194_40@BUTTON_2"
msgstr "\"Não, tenho que seguir meu caminho sozinho.\""

msgid "STORY_EVENT@1194_40@TITLE"
msgstr "A Ajuda de um Godir da Natureza"

msgid "STORY_EVENT@1194_41@BODY_HEADER"
msgstr "Em um raio de luz celestial, uma mensagem formal é entregue a você."

msgid "STORY_EVENT@1194_41@BODY_LORE"
msgstr "\"Ao justo {PlayerLeader.TitleName} dos {PlayerRace},[br/]Desejo expressar minha aprovação pelo [hyperlink,GLOBAL.OrderConcept]Caminho da Fé[/hyperlink] que você escolheu. Como {GLOBAL.GodirLoreConcept.Hyperlink}, devemos permanecer firmes contra os fora da lei e a escuridão. Portanto, peço que você me aliste em seu exército, para que eu possa caminhar entre os mortais mais uma vez e ajudá-lo em sua busca.[br/]Que a fé e a ordem guiem você em seu caminho.[br/][br/]- {EventRuler.TitleName}.\""

msgid "STORY_EVENT@1194_41@BUTTON_0"
msgstr "Aliste {EventRuler.Title} {EventRuler.FirstName} em seu exército. [unit/]"

msgid "STORY_EVENT@1194_41@BUTTON_1"
msgstr "Explique que você não pode acomodar {EventRuler.FirstName} no momento, mas gostaria de fazê-lo no futuro."

msgid "STORY_EVENT@1194_41@BUTTON_2"
msgstr "Recusar a oferta de <<o:EventRuler>>."

msgid "STORY_EVENT@1194_41@TITLE"
msgstr "A Ajuda de um Godir da Ordem"

msgid "STORY_EVENT@1194_42@BODY_HEADER"
msgstr "As sombras ao seu redor cintilam e mudam, até que uma figura aparece da escuridão. Não é ninguém menos que {EventRuler.TitleName}!"

msgid "STORY_EVENT@1194_42@BODY_LORE"
msgstr "\"Você, que olha para a [hyperlink,GLOBAL.ShadowConcept]Sombra[/hyperlink] sem medo, chamou a atenção daqueles além do esquecimento. A morte se torna você, {PlayerLeader.TitleName}. Permita-me juntar-se a você em seu caminho para se tornar Eterno.\""

msgid "STORY_EVENT@1194_42@BUTTON_0"
msgstr "\"Junte-se a mim nas sombras, {EventRuler.Title} {EventRuler.Name}!\" [unit/]"

msgid "STORY_EVENT@1194_42@BUTTON_1"
msgstr "\"No momento, não posso acomodar sua chegada, mas receberei sua ajuda no futuro.\""

msgid "STORY_EVENT@1194_42@BUTTON_2"
msgstr "\"Eu caminho por este caminho de sombra sozinho.\""

msgid "STORY_EVENT@1194_42@TITLE"
msgstr "A Ajuda de um Godir da Sombra"

msgid "STORY_EVENT@1194_641@BODY_FOOTER"
msgstr "Seus cortesãos avisam que, com tudo o que está acontecendo no Império do {IntrigueVictimPlayerLeader.Title}, isso pode muito bem ser uma armadilha..."

msgid "STORY_EVENT@1194_641@BODY_HEADER"
msgstr "Seus cortesãos entregam uma carta do Império do {IntrigueVictimPlayerLeader.Title}, encontrada escondida entre mercadorias regulares.[br/]\"Ao grande {PlayerLeader.Title}...\""

msgid "STORY_EVENT@1194_641@BODY_LORE"
msgstr "\"Não invoco a ajuda de um {GLOBAL.GodirLoreConcept.Hyperlink} levianamente, mas ficou claro que nosso {IntrigueVictimPlayerLeader.Title} sucumbiu a forças além das nossas, em um plano que se estende além do nosso Império. O {IntrigueVictimPlayerLeader.Title} tem olhos e ouvidos em todos os lugares. Se você é verdadeiramente o salvador de que precisamos, nos encontraremos no {EventOverlay}. - Um Cidadão Preocupado.\""

msgid "STORY_EVENT@1194_641@BUTTON_0"
msgstr "Enviar um grupo para encontrar o {IntrigueVictimUnit}."

msgid "STORY_EVENT@1194_641@BUTTON_1"
msgstr "Recusar-se a se envolver nos assuntos de outros Impérios."

msgid "STORY_EVENT@1194_641@TITLE"
msgstr "Tomada Diabólica"

msgid "STORY_EVENT@1194_643@BODY_FOOTER"
msgstr "Das sombras ao seu redor, a fumaça se reúne e mais demônios aparecem. Riso ensurdecedor ressoa pelo reino. Uma emboscada!"

msgid "STORY_EVENT@1194_643@BODY_HEADER"
msgstr "Você enviou um séquito para encontrar o \"Cidadão Preocupado\", que entrou em contato com você sobre o {IntrigueVictimPlayerLeader.Title} dos {IntrigueVictimPlayerRace}."

msgid "STORY_EVENT@1194_643@BODY_LORE"
msgstr "Não muito depois de chegar, um <<EventHero{homem/mulher}>> emerge, curvando-se profundamente. \"Salve, grande {PlayerLeader.Title}. Devo ser rápido, pois temo ter sido seguido. Nosso {IntrigueVictimPlayerLeader.Title} foi capturado e substituído por um {IntrigueVictimPlayerLeader.Title} de {GLOBAL.ObbadothLoreConcept.Hyperlink}. Eu conheço a {EventStructure} onde a convocação ocorreu. Mas, mais importante, há um contra-\" Antes que <<p:IntrigueUnit>> possa terminar <<o:IntrigueUnit>> frase, <<p:IntrigueUnit>> é atingido por uma garra infernal."

msgid "STORY_EVENT@1194_643@BUTTON_0"
msgstr "Mantenha-se firme!"

msgid "STORY_EVENT@1194_643@TITLE"
msgstr "Tomada Diabólica: Cidadão Preocupado"

msgid "STORY_EVENT@1194_667@BODY_FOOTER"
msgstr "\"Tão curioso...\" {IntrigueVictimPlayer.FirstName} diz. \"Não há necessidade de investigar mais. Certamente, podemos encontrar uma solução que seja... satisfatória, para ambos.\""

msgid "STORY_EVENT@1194_667@BODY_HEADER"
msgstr "Você enviou com sucesso um cortesão para a corte de {IntrigueVictimPlayer.TitleName}, que começou a se comportar de maneira errática."

msgid "STORY_EVENT@1194_667@BODY_LORE"
msgstr "Não muito depois, seu cortesão entra em contato com você, freneticamente. \"Tenho notícias, meu {IntriguePlayer.Title}, mas devo ser rápido. {IntrigueVictimPlayer.FirstName} está possuído por um demônio de {GLOBAL.ObbadothLoreConcept.Hyperlink}. Aprendi a localização de uma {EventStructure}, onde a possessão ocorreu. Lá, você pode destruir-\" Antes que <<p:IntrigueUnit>> possa terminar <<o:IntrigueUnit>> frase, <<p:IntrigueUnit>> é atingido por uma garra infernal."

msgid "STORY_EVENT@1194_667@BUTTON_0"
msgstr "\"Eu vou te mandar de volta para Obbadoth, criatura imunda!\""

msgid "STORY_EVENT@1194_667@BUTTON_1"
msgstr "\"Uma aliança com um {IntrigueVictimPlayer.Title} demoníaco certamente seria benéfica.\""

msgid "STORY_EVENT@1194_667@BUTTON_2"
msgstr "\"Compartilhe seu conhecimento infernal comigo, demônio, e eu te deixarei em paz.\""

msgid "STORY_EVENT@1194_667@BUTTON_3"
msgstr "Cesse todas as investigações sobre {IntrigueVictimPlayer}."

msgid "STORY_EVENT@1194_667@TITLE"
msgstr "Um {IntrigueVictimPlayer.Title} Possuído"

msgid "STORY_EVENT@1194_668@BUTTON_0"
msgstr "Continuar"

msgid "STORY_EVENT@1194_668@TITLE"
msgstr "Missão 2A concluída"

msgid "STORY_EVENT@1194_669@BODY_FOOTER"
msgstr "\"Eu sugeriria vassalizar a cidade de {EventHouse}. Uma vez que estejam sob seu governo, você pode impor seu interrogatório.\""

msgid "STORY_EVENT@1194_669@BODY_HEADER"
msgstr "Você enviou com sucesso um cortesão para a corte de {IntrigueVictimPlayer.TitleName}, que começou a se comportar de maneira errática."

msgid "STORY_EVENT@1194_669@BODY_LORE"
msgstr "Não muito depois, seu cortesão entra em contato com você com notícias. \"Falei com várias camareiras e magos da corte, meu {IntriguePlayer.Title}. Eles sussurram sobre uma maldição, lançada sobre {IntrigueVictimPlayer.Title} {IntrigueVictimPlayer.FirstName}. Isso certamente explicaria a mudança súbita de caráter... Toda vez que pergunto, um nome vem à tona: {EventHouseLord.Name}. Espero que <<p:EventHouseLord>> saiba mais.\""

msgid "STORY_EVENT@1194_669@BUTTON_0"
msgstr "Investigue mais, vise vassalizar {EventHouse}."

msgid "STORY_EVENT@1194_669@BUTTON_1"
msgstr "Pare de investigar, use seu conhecimento atual como alavanca contra {IntrigueVictimPlayer}."

msgid "STORY_EVENT@1194_669@TITLE"
msgstr "Um {IntrigueVictimPlayer.Title} Possuído"

msgid "STORY_EVENT@1194_670@BUTTON_0"
msgstr "Continuar"

msgid "STORY_EVENT@1194_670@TITLE"
msgstr "Missão 2B concluída"

msgid "STORY_EVENT@1194_672@BODY_FOOTER"
msgstr "\"Entendo que você é quem purificou a mancha infernal em minha alma, {PlayerLeader.Name}. Estou em sua dívida.\""

msgid "STORY_EVENT@1194_672@BODY_HEADER"
msgstr "Você destruiu o local onde {IntrigueVictimPlayer.TitleName} foi possuído. Um rugido ressoa pelo reino enquanto o demônio é exorcizado."

msgid "STORY_EVENT@1194_672@BODY_LORE"
msgstr "Não muito tempo depois, você é contatado por {IntrigueVictimPlayer.FirstName}, que voltou ao estado anterior de <<o:IntrigueVictimPlayer>>. <<Cp:IntrigueVictimPlayer>> explica o que aconteceu: \"Eu estava investigando pessoalmente um local de ritual. Parecia pouco ameaçador e, assim, fui descuidado. O demônio estava à espreita, escondido, à caça... até que me dominou. Eu me achava invencível, e a possessão foi o castigo pela minha negligência.\""

msgid "STORY_EVENT@1194_672@BUTTON_0"
msgstr "\"Sejamos aliados, então, e conquistemos este reino juntos!\""

msgid "STORY_EVENT@1194_672@BUTTON_1"
msgstr "\"Recebo minha recompensa em ouro [gold/] e mana [mana/].\""

msgid "STORY_EVENT@1194_672@BUTTON_2"
msgstr "\"Sua negligência custou seu direito sobre este reino. Torne-se meu vassalo em vez disso.\""

msgid "STORY_EVENT@1194_672@TITLE"
msgstr "Um(a) {IntrigueVictimPlayer.Title} Possuído(a): Desfecho"

msgid "STORY_EVENT@1194_673@BODY_FOOTER"
msgstr "\"Através de suas ações, você quebrou meu pacto, e fiquei sem as recompensas que me foram prometidas.\""

msgid "STORY_EVENT@1194_673@BODY_HEADER"
msgstr "Você destruiu o local onde {IntrigueVictimPlayer.TitleName} foi possuído. Um rugido ressoa pelo reino enquanto o demônio é exorcizado."

msgid "STORY_EVENT@1194_673@BODY_LORE"
msgstr "Não muito tempo depois, você é contatado por {IntrigueVictimPlayer.FirstName}, que voltou ao estado anterior de <<o:IntrigueVictimPlayer>>. \"O que você fez?\" <<p:IntrigueVictimPlayer>> exige. \"Eu tinha tudo sob controle! O acordo que fiz era perfeito. Eu dormiria em meu próprio corpo, e quando acordasse novamente em um ano e um dia, reconstruiria sobre as cinzas deste reino, minha alma intocada por quaisquer atrocidades necessárias.\""

msgid "STORY_EVENT@1194_673@BUTTON_0"
msgstr "\"Pague-me [gold/], ou todo o reino saberá o que você fez.\""

msgid "STORY_EVENT@1194_673@TITLE"
msgstr "Um(a) {IntrigueVictimPlayer.Title} Possuído(a): Desfecho"

msgid "STORY_EVENT@1194_674@BODY_FOOTER"
msgstr "\"Eu sei como quebrar esta maldição e tenho provas dos planos de {IntrigueCulpritPlayer.FirstName}. Por favor, como meu senhor, proteja-me da ira de <<o:IntrigueCulpritPlayer>>!\""

msgid "STORY_EVENT@1194_674@BODY_HEADER"
msgstr "Você vassalizou o(a) {EventHouseLord.Title} de {EventHouse}, que você suspeita saber mais sobre o(a) {IntrigueVictimPlayer.TitleName} amaldiçoado(a). Você convoca {EventHouseLord.FirstName} para interrogar <<P:EventHouseLord>>."

msgid "STORY_EVENT@1194_674@BODY_LORE"
msgstr "Assim que o interrogatório começa, {EventHouseLord.FirstName} se desespera. \"Por favor, ó {PlayerLeader.Title}, fui forçado. O(a) {IntrigueCulpritPlayer.Title} me ameaçou com ruína se eu não me juntasse a <<P:IntrigueCulpritPlayer>> na maldição de {IntrigueVictimPlayer.FirstName}. Eu fui encarregado de invocar um demônio de {GLOBAL.ObbadothLoreConcept.Hyperlink}, enquanto o(a) {IntrigueCulpritPlayer.Title} {IntrigueCulpritPlayer.FirstName} o ligava a {IntrigueVictimPlayer.FirstName}. Eu vou contar tudo o que sei!\""

msgid "STORY_EVENT@1194_674@BUTTON_0"
msgstr "Quebre a maldição sobre {IntrigueVictimPlayer}, deixe todos saberem quem foi o responsável."

msgid "STORY_EVENT@1194_674@TITLE"
msgstr "Um(a) {IntrigueVictimPlayer.Title} Possuído(a): Desfecho"

msgid "STORY_EVENT@1194_675@BODY_FOOTER"
msgstr "\"Foi o(a) {EventItem} amaldiçoado(a) que possuía {IntrigueVictimPlayer}. Será necessário o poder de um(a) {GLOBAL.GodirLoreConcept.Hyperlink} para libertar <<P:IntrigueVictimPlayer>>.\""

msgid "STORY_EVENT@1194_675@BODY_HEADER"
msgstr "Você vassalizou o(a) {EventHouseLord.Title} de {EventHouse}, que você suspeita saber mais sobre o(a) {IntrigueVictimPlayer.TitleName} amaldiçoado(a). Você convoca {EventHouseLord.FirstName} para interrogar <<P:EventHouseLord>>."

msgid "STORY_EVENT@1194_675@BODY_LORE"
msgstr "\"Eu vi {IntrigueVictimPlayer.FirstName} carregando algo que reconheci como o(a) {EventItem}, que dizem carregar uma maldição de {GLOBAL.ObbadothLoreConcept.Hyperlink}. Eu tentei avisar <<P:IntrigueVictimPlayer>>, mas em vão. Eu vi a transformação de <<o:IntrigueVictimPlayer>> e procurei uma maneira de quebrar a maldição... No entanto, eu não sabia em quem confiar com a resposta.\""

msgid "STORY_EVENT@1194_675@BUTTON_0"
msgstr "Tome o(a) {EventItem} amaldiçoado(a) para si mesmo, mantenha a maldição sobre {IntrigueVictimPlayer}."

msgid "STORY_EVENT@1194_675@TITLE"
msgstr "Um(a) {IntrigueVictimPlayer.Title} Possuído(a): Desfecho"

msgid "STORY_EVENT@1224_790@BODY_FOOTER"
msgstr "Os olhos de {EventHero} caem subitamente sobre suas tropas. \"E ainda... Talvez os ventos me tenham abençoado com sua ajuda.\""

msgid "STORY_EVENT@1224_790@BODY_HEADER"
msgstr "Suas tropas estão fazendo seu caminho através das profundezas {EventDirection} {EventCity}. Elas estão cercadas por altas paredes massivas, outrora esculpidas por mãos ancestrais, agora fissuradas com rachaduras vibrantes e perturbadoras."

msgid "STORY_EVENT@1224_790@BODY_LORE"
msgstr "\"O que você vê é nosso destino\", uma voz chama. A figura está sentada sobre um aglomerado de pedras, olhando para as fissuras. \"Meu nome é {EventHero}, único sobrevivente da tribo {TribeName}. Meu povo carregava um dever passado através de gerações, renovar os selos para que [hyperlink,GLOBAL.AstralBarrensConcept]a corrupção dos vis Desfazedores[/hyperlink] não consumisse o reino. Mas agora, o desenho daqueles selos foi perdido, e estou fadado a morrer buscando a fonte desta contaminação, na esperança de erradicá-la.\""

msgid "STORY_EVENT@1224_790@BUTTON_0"
msgstr "Continue para a região fraturada."

msgid "STORY_EVENT@1224_790@BUTTON_4"
msgstr "Produza [structureprod/] as ferramentas para escavar a área."

msgid "STORY_EVENT@1224_790@BUTTON_5"
msgstr "Traga arqueólogos [gold/] para ajudá-lo a pesquisar [knowledge/] as ruínas que você encontrará."

msgid "STORY_EVENT@1224_790@TITLE"
msgstr "Encontrando o Núcleo da Contaminação"

msgid "STORY_EVENT@1224_83@BODY_FOOTER"
msgstr "Você matará o {EventStackLeader.Name} e <<o:EventHero>> descendentes infantis, ou encontrará uma solução diferente?"

msgid "STORY_EVENT@1224_83@BODY_HEADER"
msgstr "Suas tropas engajam o {EventStackLeader.Name} e <<o:EventStackLeader>> servos, mas eles parecem estar recuando em formações defensivas em vez de atacar."

msgid "STORY_EVENT@1224_83@BODY_LORE"
msgstr "Seus grunhidos e assobios em pânico soam como pedidos de misericórdia. Quando você olha mais de perto, percebe que eles estão defendendo sua prole recém-nascida. Eles podem sentir que não são páreo para você, mas lutarão por seus filhotes até o último suspiro."

msgid "STORY_EVENT@1224_83@BUTTON_0"
msgstr "Atacar! [evilact/]"

msgid "STORY_EVENT@1224_83@BUTTON_1"
msgstr "Deixe-os reunir seus filhotes e partir. [goodact/]"

msgid "STORY_EVENT@1224_83@BUTTON_3"
msgstr "Atraia [food/] algumas das criaturas para longe e recrute o {EventStackLeader.Name}. [unit/]"

msgid "STORY_EVENT@1224_83@TITLE"
msgstr "Prole Desprotegida"

msgid "STORY_EVENT@1224_84@BODY_FOOTER"
msgstr "{EventHero.FirstName} tem dúvidas sobre <<o:EventHero>> ambição atual. <<o:EventHero>> herança proporcionará <<P:EventHero>> um novo propósito?"

msgid "STORY_EVENT@1224_84@BODY_HEADER"
msgstr "Segurando <<o:EventHero>> herança de família, seu {GLOBAL.HeroConcept.Hyperlink}, {EventHero}, se aproxima de você com uma saudação formal e proclama:"

msgid "STORY_EVENT@1224_84@BODY_LORE"
msgstr "\"Sou o herdeiro de um sangue orgulhoso. Um dos meus ancestrais foi um <<a:ReplacementDestiny1>>, outro um <<a:ReplacementDestiny2>>—sua {GLOBAL.RenownConcept.Hyperlink} ecoou através do tempo. Cresci desafiando esses valores, então me tornei um <<a:CurrentDestiny>>. Mas agora sou mais velho, e abraçar a tradição parece uma maneira de honrar meus ancestrais. Para lembrar quem eles eram. Busco seu conselho neste assunto, meu {PlayerLeader.Title}.\""

msgid "STORY_EVENT@1224_84@BUTTON_0"
msgstr "\"Continue seu caminho, você é seu próprio legado.\""

msgid "STORY_EVENT@1224_84@BUTTON_1"
msgstr "\"Sua linhagem será a de um <<a:ReplacementDestiny1>>.\""

msgid "STORY_EVENT@1224_84@BUTTON_2"
msgstr "\"Seus descendentes lembrarão de você como um <<a:ReplacementDestiny2>>.\""

msgid "STORY_EVENT@1224_84@TITLE"
msgstr "Uma Questão de Herança"

msgid "STORY_EVENT@1224_85@BODY_FOOTER"
msgstr "{EventHero.FirstName} ficou frustrado com <<o:EventHero>> ambição atual. Você consertará o que a inveja quebrou?"

msgid "STORY_EVENT@1224_85@BODY_HEADER"
msgstr "Seu {GLOBAL.HeroConcept.Hyperlink}, {EventHero}, pede uma audiência. Olhando para o chão <<p:EventHero>> pronuncia:"

msgid "STORY_EVENT@1224_85@BODY_LORE"
msgstr "\"Vejo como os outros realizam suas ambições enquanto eu espero minha chance de provar meu valor como um <<a:CurrentDestiny>>. Busco {GLOBAL.RenownConcept.Hyperlink} como qualquer outro. Não mereço isso, meu {PlayerLeader.Title}? Sou indigno de glória? Suplico por sua orientação mais uma vez.\""

msgid "STORY_EVENT@1224_85@BUTTON_0"
msgstr "\"Tenha orgulho de quem você é e alcançará a glória.\""

msgid "STORY_EVENT@1224_85@BUTTON_1"
msgstr "\"Ser um <<a:ReplacementDestiny1>> lhe dará o crédito que busca.\""

msgid "STORY_EVENT@1224_85@BUTTON_2"
msgstr "\"Você encontrará seu valor como um <<a:ReplacementDestiny2>>.\""

msgid "STORY_EVENT@1224_85@TITLE"
msgstr "Espinho da Inveja"

msgid "STORY_EVENT@1224_87@BODY_FOOTER"
msgstr "O que você fará com o exótico {EventStackLeader.Name}?"

msgid "STORY_EVENT@1224_87@BODY_HEADER"
msgstr "Suas tropas enfrentam o {EventStackLeader.Name} e <<o:EventStackLeader>> servos, mas eles tremem de medo em vez de lutar."

msgid "STORY_EVENT@1224_87@BODY_LORE"
msgstr "Eles tremem sem poder se defender, cercados pelo seu exército. Mas antes que você possa dar a ordem de ataque, seus estudiosos gritam animadamente: \"Espere, meu {PlayerLeader.Title}! Olhe para a coloração rara da língua e o padrão em suas costas! Esses são espécimes dignos de investigação! Permita-nos levá-los para que possamos estudá-los em seu ambiente natural.\""

msgid "STORY_EVENT@1224_87@BUTTON_0"
msgstr "Atacar! [evilact/]"

msgid "STORY_EVENT@1224_87@BUTTON_1"
msgstr "Deixe-os ir. [goodact/]"

msgid "STORY_EVENT@1224_87@BUTTON_3"
msgstr "Permita que seus estudiosos [knowledge/] documentem eles. [influence/]"

msgid "STORY_EVENT@1224_87@TITLE"
msgstr "Animais Exóticos"

msgid "STORY_EVENT@1224_88@BODY_FOOTER"
msgstr "{EventHero.FirstName} está frustrado com <<o:EventHero>> ambição atual. Você vai satisfazer <<o:EventHero>> desejos?"

msgid "STORY_EVENT@1224_88@BODY_HEADER"
msgstr "Seu {GLOBAL.HeroConcept.Hyperlink}, {EventHero}, está diante de você. <<Cp:EventHero>> enche o peito e levanta o queixo enquanto <<p:EventHero>> declara:"

msgid "STORY_EVENT@1224_88@BODY_LORE"
msgstr "\"Por omissão ou preconceito, percebo que estou muito aquém do que poderia ser. Seja honesto comigo, meu {PlayerLeader.Title}. Minha ambição como um <<a:CurrentDestiny>> não lhe interessa? Eu nasci para ser grande, então direcione-me para a {GLOBAL.RenownConcept.Hyperlink}. Que caminho devo seguir?\""

msgid "STORY_EVENT@1224_88@BUTTON_0"
msgstr "\"Conheça seu lugar, {EventHero}, e siga seu curso.\""

msgid "STORY_EVENT@1224_88@BUTTON_1"
msgstr "\"Ações falam mais alto que palavras, prove-se como um <<a:ReplacementDestiny1>>.\""

msgid "STORY_EVENT@1224_88@BUTTON_2"
msgstr "\"Ambição é bom, você se encaixa como <<a:ReplacementDestiny2>>.\""

msgid "STORY_EVENT@1224_88@TITLE"
msgstr "Consumido pela Arrogância"

msgid "STORY_EVENT@1224_89@BODY_FOOTER"
msgstr "{EventHero.FirstName} tem dúvidas sobre <<o:EventHero>> ambição atual. Você vai permitir que <<P:EventHero>> persiga <<o:EventHero>> sonhos?"

msgid "STORY_EVENT@1224_89@BODY_HEADER"
msgstr "Nas primeiras horas da manhã, você encontra seu {GLOBAL.HeroConcept.Hyperlink} {EventHero} esperando do lado de fora de seus aposentos."

msgid "STORY_EVENT@1224_89@BODY_LORE"
msgstr "\"Ó {PlayerLeader.Title}, tive uma visão em meus sonhos ontem à noite! Havia um <<a:ReplacementDestiny1>>, reverenciado pelas massas. Ao lado de <<P:EventHero>> havia um <<a:ReplacementDestiny2>>, cercado e apreciado por aqueles que <<p:EventHero>> amava. Isso parece ser um sinal para mudar meu destino como um <<a:CurrentDestiny>>. Que {GLOBAL.RenownConcept.Hyperlink} devo buscar?\""

msgid "STORY_EVENT@1224_89@BUTTON_0"
msgstr "\"Sonhos são para aqueles que dormem, você está acordado agora.\""

msgid "STORY_EVENT@1224_89@BUTTON_1"
msgstr "\"Ser um <<a:ReplacementDestiny1>> combina mais com você.\""

msgid "STORY_EVENT@1224_89@BUTTON_2"
msgstr "\"Ser um <<a:ReplacementDestiny2>> é uma ambição admirável.\""

msgid "STORY_EVENT@1224_89@TITLE"
msgstr "Sonhos Ambiciosos"

msgid "STORY_EVENT@1224_90@BODY_FOOTER"
msgstr "{EventHero.FirstName} tem dúvidas sobre <<o:EventHero>> ambição atual. Você vai permitir que <<P:EventHero>> siga seu caminho?"

msgid "STORY_EVENT@1224_90@BODY_HEADER"
msgstr "Seu {GLOBAL.HeroConcept.Hyperlink}, {EventHero}, faz uma reverência antes de se aproximar. Com <<o:EventHero>> punho no peito, <<p:EventHero>> diz:"

msgid "STORY_EVENT@1224_90@BODY_LORE"
msgstr "Meu {PlayerLeader.Title}, vejo que você segue sua ambição como um {PlayerLeader.Destiny}. Eu sou apenas um <<a:CurrentDestiny>>, que se sentiria honrado com a chance de seguir seus sonhos. Você me permitiria compartilhar suas ambições pela grandeza e {GLOBAL.RenownConcept.Hyperlink} do império?"

msgid "STORY_EVENT@1224_90@BUTTON_0"
msgstr "\"Siga seu curso. Seu destino será cumprido.\""

msgid "STORY_EVENT@1224_90@BUTTON_1"
msgstr "\"Junte-se a mim como um <<a:ReplacementDestiny1>>.\""

msgid "STORY_EVENT@1224_90@BUTTON_2"
msgstr "\"Ser um <<a:ReplacementDestiny2>> é uma ambição admirável.\""

msgid "STORY_EVENT@1224_90@TITLE"
msgstr "Um Modelo de Regra"

msgid "STORY_EVENT@1229_17@BODY_FOOTER"
msgstr "Bandos de <<m:EventUnit>> estão enxameando o castelo, perseguindo os plebeus e causando caos. O que você fará?"

msgid "STORY_EVENT@1229_17@BODY_HEADER"
msgstr "Seu aprendiz, {EventHero.Name}, entra em pânico em seus aposentos, está claro que algo deu errado..."

msgid "STORY_EVENT@1229_17@BODY_LORE"
msgstr "Enquanto trabalhava em sua coleção de grimórios e tomos, {EventHero.Name} esbarrou em uma incantação rabiscada em um pergaminho antigo, esquecido nas páginas de um tratado sobre convocação de animais. A curiosidade superou <<o:EventHero>> e <<p:EventHero>> pronunciou as palavras em voz alta—acidentalmente abrindo um portal para um reino repleto de porcos selvagens!"

msgid "STORY_EVENT@1229_17@BUTTON_0"
msgstr "\"Talvez eles possam ser úteis, [unit/] eu prepararei um contra-feitiço.\" [mana/]"

msgid "STORY_EVENT@1229_17@BUTTON_1"
msgstr "\"Isso faz parte do processo de aprendizado. [happiness/] Você vai descobrir como resolver.\" [xp/]"

msgid "STORY_EVENT@1229_17@BUTTON_2"
msgstr "\"Reúna as tropas. [unitprod/] Há boa comida nesses porcos, não os deixe escapar!\" [food/]"

msgid "STORY_EVENT@1229_17@BUTTON_3"
msgstr "\"Porcos são nossos amigos, eu cuidarei disso!\" [unit/]"

msgid "STORY_EVENT@1229_17@TITLE"
msgstr "Um Erro Simples"

msgid "STORY_EVENT@1229_18@BODY_FOOTER"
msgstr "\"Agora pague sua multa ou é para a cadeia.\""

msgid "STORY_EVENT@1229_18@BODY_HEADER"
msgstr "\"Pare bem aí, escória criminosa!\""

msgid "STORY_EVENT@1229_18@BODY_LORE"
msgstr "\"Ninguém quebra a lei sob minha vigilância! Estou confiscando seus bens roubados.\""

msgid "STORY_EVENT@1229_18@BUTTON_0"
msgstr "P"

msgid "STORY_EVENT@1229_18@BUTTON_1"
msgstr "Resistir à Prisão"

msgid "STORY_EVENT@1229_18@BUTTON_2"
msgstr "Pagar Ouro [gold/]"

msgid "STORY_EVENT@1229_18@TITLE"
msgstr "Evento de Seguimento do Materium TESTE"

msgid "STORY_EVENT@1229_21@BUTTON_1"
msgstr "Encontre a mente você mesmo"

msgid "STORY_EVENT@1229_21@TITLE"
msgstr "Sub-Missão Astral"

msgid "STORY_EVENT@991_4465@BODY_FOOTER"
msgstr "{EventHouse.Name} pede um memorial para o falecido {EventHero.Name}."

msgid "STORY_EVENT@991_4465@BODY_HEADER"
msgstr "Um arquiteto de {EventHouse.Name} transmite um apelo a você sobre o herói falecido {EventHero.Name}, que repousa em sua {GLOBAL.CryptConcept}."

msgid "STORY_EVENT@991_4465@BODY_LORE"
msgstr "\"{EventHero.Name} era uma lenda. <<Cp:EventHero>> representava o melhor da Casa {EventHouse.Name}. Os contos dos feitos de <<o:EventHero>> vivem nos corações de <<o:EventHero>> povo. Deixar nosso {EventHero.FirstName} apodrecer dentro de uma cova comum seria ignóbil. <<Cp:EventHero>> merece um mausoléu, um monumento inspirador para as futuras gerações.\""

msgid "STORY_EVENT@991_4465@BUTTON_0"
msgstr "\"Este [gold/] deve ser suficiente para fazer justiça a <<G:honor^n,EventHero>>.\""

msgid "STORY_EVENT@991_4465@BUTTON_1"
msgstr "\"Minha moeda é melhor gasta com os vivos!\""

msgid "STORY_EVENT@991_4465@BUTTON_2"
msgstr "Invoque seus poderes mortais para projetar um mausoléu digno de {EventHero.Name}."

msgid "STORY_EVENT@991_4465@TITLE"
msgstr "Amado Além da Morte"

msgid "STORY_EVENT@991_4466@BODY_FOOTER"
msgstr "O corpo de {EventHero.Name} é solicitado pelo povo de <<o:EventHero>>."

msgid "STORY_EVENT@991_4466@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} de {EventHouse.Name} apela para a sua honra em relação ao herói falecido {EventHero.Name}, que repousa em seu {GLOBAL.CryptConcept}."

msgid "STORY_EVENT@991_4466@BODY_LORE"
msgstr "\"A disputa entre {EventHouse.Name} e seu império tem sido implacável. Lamentamos a queda de {EventHero.Name}... e consideraríamos um sinal de benevolência se você honrasse a morte de <<o:EventHero>> e devolvesse os restos mortais a nós.\""

msgid "STORY_EVENT@991_4466@BUTTON_0"
msgstr "Entregue o corpo de {EventHero.Name} a {EventHouse.Name}."

msgid "STORY_EVENT@991_4466@BUTTON_1"
msgstr "\" {EventHero.Name} permanecerá na minha cripta pelo tempo que eu desejar.\""

msgid "STORY_EVENT@991_4466@BUTTON_2"
msgstr "\"Nenhuma [evilact/]. {EventHero.Name} será meu lembrete da sua impertinência.\""

msgid "STORY_EVENT@991_4466@TITLE"
msgstr "Post Mortem"

msgid "STORY_EVENT@991_4469@BODY_FOOTER"
msgstr "{EventHero.Name} deve interferir antes que {EnemyUnit.Name} e os companheiros de <<o:EnemyUnit>> decidam como cozinhar melhor seus cativos?"

msgid "STORY_EVENT@991_4469@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Você deve interferir antes que {EnemyUnit.Name} e os companheiros de <<o:EnemyUnit>> decidam como cozinhar melhor seus cativos?"

msgid "STORY_EVENT@991_4469@BODY_HEADER"
msgstr "Explorando o castelo, {EventHero.Name} testemunha um argumento bastante mórbido."

msgid "STORY_EVENT@991_4469@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Explorando o castelo, você testemunha um argumento bastante mórbido."

msgid "STORY_EVENT@991_4469@BODY_LORE"
msgstr "\"Nós os cozinhamos no vapor com cogumelos!\" {EventHero.FirstName} ouve a voz profunda de um {EnemyUnit.Name} dizer. \"Ficam mais cremosos assim!\"[br/][br/]\"Não!\" outra voz que soa igual discorda. \"Nós cozinhamos os pequenos {EventRace.Name} em manteiga!\"[br/][br/]\"Você é um idiota!\" outro deles grita. \"Nós os assamos com vinagre!\"[br/][br/]Nenhum deles ouve os protestos de seus \"ingredientes,\" um grupo de {EventRace.Name} encolhidos em um canto."

msgid "STORY_EVENT@991_4469@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "\"Nós os cozinhamos no vapor com cogumelos!\" você ouve a voz profunda de um {EnemyUnit.Name} dizer. \"Ficam mais cremosos assim!\"[br/][br/]\"Não!\" outra voz que soa igual discorda. \"Nós cozinhamos os pequenos {EventRace.Name} em manteiga!\"[br/][br/]\"Você é um idiota!\" outro deles grita. \"Nós os assamos com vinagre!\"[br/][br/]Nenhum deles ouve os protestos de seus \"ingredientes,\" um grupo de {EventRace.Name} encolhidos em um canto."

msgid "STORY_EVENT@991_4469@BUTTON_0"
msgstr "\"Para o resgate! Ataque!\""

msgid "STORY_EVENT@991_4469@BUTTON_1"
msgstr "Apease os {EnemyUnit.Name} e os companheiros de <<o:EnemyUnit>> com gado [food/] de {EventCity.Name}."

msgid "STORY_EVENT@991_4469@BUTTON_2"
msgstr "Sair."

msgid "STORY_EVENT@991_4469@BUTTON_3"
msgstr "Aumente a chama da discussão deles até que se voltem uns contra os outros..."

msgid "STORY_EVENT@991_4469@TITLE"
msgstr "Sal e Vinagre"

msgid "STORY_EVENT@991_4470@BODY_FOOTER"
msgstr "O {EventUnit.Name} inclina <<o:EventUnit>> cabeça. \"Todos nesta companhia devem suas vidas a você - como podemos retribuir?\""

msgid "STORY_EVENT@991_4470@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "\"Estamos em dívida com você, {PlayerLeader.TitleName}. Todos nesta companhia devem suas vidas a você - como podemos retribuir?\""

msgid "STORY_EVENT@991_4470@BODY_HEADER"
msgstr "Com os brutamontes famintos não sendo mais uma ameaça, {EventHero.Name} pode resgatar suas vítimas traumatizadas."

msgid "STORY_EVENT@991_4470@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Com os brutamontes famintos não sendo mais uma ameaça, você pode resgatar suas vítimas traumatizadas."

msgid "STORY_EVENT@991_4470@BODY_LORE"
msgstr "\"Foi tudo minha culpa!\" seu líder, um {EventUnit.Name}, explica. \"Esses comerciantes confiaram em nós para protegê-los, mas, dois dias atrás, aqueles canibais monstruosos nos dominaram no anoitecer.\""

msgid "STORY_EVENT@991_4470@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "\"Foi tudo minha culpa, {PlayerLeader.Title}!\" seu líder, um {EventUnit.Name}, explica. \"Esses comerciantes confiaram em nós para protegê-los, mas, dois dias atrás, aqueles canibais monstruosos nos dominaram no anoitecer.\""

msgid "STORY_EVENT@991_4470@BUTTON_0"
msgstr "\"Comercialize seus bens [structureprod/] em {EventCity.Name} e todos colheremos os benefícios desta aventura.\""

msgid "STORY_EVENT@991_4470@BUTTON_1"
msgstr "\"Seu baú de artesanato [gold/] é o que nos interessa...\""

msgid "STORY_EVENT@991_4470@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"Seu baú de artesanato [gold/] é o que me interessa...\""

msgid "STORY_EVENT@991_4470@BUTTON_2"
msgstr "\"Sirva ao meu exército, {EventUnit.Name} [unit/], e você poderá se redimir em combate.\""

msgid "STORY_EVENT@991_4470@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "\"Junte-se ao meu exército, {EventUnit.Name}, e você poderá se redimir em combate.\""

msgid "STORY_EVENT@991_4470@TITLE"
msgstr "Sal e Vinagre: Consequências"

msgid "STORY_EVENT@991_4471@BODY_FOOTER"
msgstr "A ganância dos saqueadores de túmulos despertou os mortos! E {EventHero.FirstName} se encontra <<r:EventHero>> no meio disso..."

msgid "STORY_EVENT@991_4471@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "A ganância dos saqueadores de túmulos despertou os mortos! E você se encontra no meio disso..."

msgid "STORY_EVENT@991_4471@BODY_HEADER"
msgstr "Quando {EventHero.Name} se aproxima do portão da {EventStructure}, o barulho de picaretas ocupadas ecoa de suas paredes."

msgid "STORY_EVENT@991_4471@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Quando você se aproxima do portão da {EventStructure}, o barulho de picaretas ocupadas ecoa de suas paredes."

msgid "STORY_EVENT@991_4471@BODY_LORE"
msgstr "Uma banda de saqueadores de túmulos pode ser vista trabalhando dentro. Mas antes que {EventHero.FirstName} possa agir, um dos saqueadores grita em horror quando uma mão esquelética agarra seu braço. Os saqueadores fogem, deixando {EventHero.FirstName} e o exército de <<o:EventHero>> para lidar com o {EnemyUnit} e outros horrores que emergem dos caixões ao seu redor."

msgid "STORY_EVENT@991_4471@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Uma banda de saqueadores de túmulos pode ser vista trabalhando dentro. Mas antes que você possa agir, um dos saqueadores grita em horror quando uma mão esquelética agarra seu braço. Os saqueadores fogem, deixando você e seu exército para lidar com o {EnemyUnit} e outros horrores que emergem dos caixões ao seu redor."

msgid "STORY_EVENT@991_4471@BUTTON_0"
msgstr "Atacar os mortos-vivos!"

msgid "STORY_EVENT@991_4471@BUTTON_1"
msgstr "Lançar um feitiço [mana/] para atrasar os mortos-vivos."

msgid "STORY_EVENT@991_4471@BUTTON_2"
msgstr "Fugir da {EventStructure}."

msgid "STORY_EVENT@991_4471@BUTTON_4"
msgstr "Invocar magias poderosas da morte para atrasar o assalto dos mortos-vivos."

msgid "STORY_EVENT@991_4471@TITLE"
msgstr "Saqueadores do {EventItem.Name}"

msgid "STORY_EVENT@991_4472@BODY_FOOTER"
msgstr "Um dos <<g:soldiers^p,EventHero>> aponta para alguns caixões decorados, elevados acima dos outros. Seus conteúdos devem ser especiais..."

msgid "STORY_EVENT@991_4472@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Um dos seus soldados aponta para alguns caixões decorados, elevados acima dos outros. Seus conteúdos devem ser especiais..."

msgid "STORY_EVENT@991_4472@BODY_HEADER"
msgstr "{EventHero.Name} sobreviveu ao ataque dos mortos-vivos na {EventStructure}. Agora, o túmulo está seguro para ser vasculhado."

msgid "STORY_EVENT@991_4472@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você sobreviveu ao ataque dos mortos-vivos na {EventStructure}. Agora, o túmulo está seguro para ser vasculhado."

msgid "STORY_EVENT@991_4472@BODY_LORE"
msgstr "Com os saqueadores de túmulos há muito tempo desaparecidos, seu exército não perde tempo e imediatamente começa a reunir qualquer conhecimento que possa encontrar sobre as pessoas que foram enterradas aqui. Este túmulo pertencia a um rei caído, que foi enterrado com toda a sua corte após seu assassinato."

msgid "STORY_EVENT@991_4472@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Com os saqueadores de túmulos há muito tempo desaparecidos, seu exército não perde tempo e imediatamente começa a reunir qualquer conhecimento que possa encontrar sobre as pessoas que foram enterradas aqui. Este túmulo pertencia a um rei caído, que foi enterrado com toda a sua corte após seu assassinato."

msgid "STORY_EVENT@991_4472@BUTTON_0"
msgstr "Saquear o caixão do marechal do rei. [unitprod/]"

msgid "STORY_EVENT@991_4472@BUTTON_2"
msgstr "Saquear o caixão do mordomo do rei. [gold/]"

msgid "STORY_EVENT@991_4472@BUTTON_4"
msgstr "Saqueie o caixão do próprio rei envenenado. [item/]"

msgid "STORY_EVENT@991_4472@BUTTON_5"
msgstr "Não sou um ladrão de túmulos. [goodact/]"

msgid "STORY_EVENT@991_4472@TITLE"
msgstr "Saqueadores do {EventItem.Name}: Consequências"

msgid "STORY_EVENT@991_4484@BODY_FOOTER"
msgstr "Você vai interferir antes que o {EventStackLeader.Name} e seu exército queimem toda a floresta?"

msgid "STORY_EVENT@991_4484@BODY_HEADER"
msgstr "Enquanto sua mente vagueia pelos selvagens, suas meditações são interrompidas por uma cena repentina de destruição."

msgid "STORY_EVENT@991_4484@BODY_LORE"
msgstr "Você vê as criações flamejantes de um Piromante devastando a floresta {EventDirection} {EventCity}. A própria terra parece chorar enquanto eles incendeiam a área, ameaçando tudo que cresce e floresce."

msgid "STORY_EVENT@991_4484@BUTTON_0"
msgstr "Jure destruir as criaturas de fogo que ameaçam a floresta."

msgid "STORY_EVENT@991_4484@BUTTON_1"
msgstr "Essas florestas não são da sua conta."

msgid "STORY_EVENT@991_4484@BUTTON_2"
msgstr "\"O fogo aquece minha alma. Eu... vou avivar [mana/] suas chamas!\" [naturecrisis/]"

msgid "STORY_EVENT@991_4484@TITLE"
msgstr "Incineradores Imprudentes"

msgid "STORY_EVENT@991_4485@BODY_FOOTER"
msgstr "Qual presente você deseja que o {EventUnit.Name} conceda a você?"

msgid "STORY_EVENT@991_4485@BODY_HEADER"
msgstr "Com as criaturas de fogo detidas, o guardião da floresta se revela a você."

msgid "STORY_EVENT@991_4485@BODY_LORE"
msgstr "É um {EventUnit.Name}, tão prístino e majestoso quanto descrito em muitas histórias antigas. A criatura justa se aproxima de você com um brilho benevolente em seus olhos. Está claro que ele quer agradecer você."

msgid "STORY_EVENT@991_4485@BUTTON_0"
msgstr "Peça ao {EventUnit.Name} [unit/] para segui-lo."

msgid "STORY_EVENT@991_4485@BUTTON_1"
msgstr "Você sente uma conexão profunda. A partir de agora, você cavalgará o {EventMount.Name} [mount/] na batalha!"

msgid "STORY_EVENT@991_4485@BUTTON_3"
msgstr "Peça ao {EventUnit.Name} para compartilhar um pouco de sua essência mágica [mana/] com você."

msgid "STORY_EVENT@991_4485@TITLE"
msgstr "Incineradores Imprudentes: Consequências"

msgid "STORY_EVENT@991_4561@BODY_FOOTER"
msgstr "\"Que melodramático,\" {AllyPlayer} comenta sarcasticamente. \"Mas também presunçoso. Você não sabe o que acontecerá quando abrirmos o Cofre Mundial. O que isso significará para o Panteão. De qualquer forma, você será nosso convidado de honra para assistir...\""

msgid "STORY_EVENT@991_4561@BODY_HEADER"
msgstr "O Príncipe das Sombras tem estado furioso contra o {GLOBAL.ShadraiFactionLoreConcept.Hyperlink} no campo de batalha. Mas agora, enquanto <<p:EventPlayer>> vê os exércitos de <<o:EventPlayer>> derrotados, {EventPlayer.FirstName} mantém uma calma sarcástica."

msgid "STORY_EVENT@991_4561@BODY_LORE"
msgstr "\"Esta pode ser minha hora de perecer, mas já passei pela morte, sombra e pesadelos tantas vezes que não me afeto com isso. Você, por outro lado,\"—{EventPlayer.FirstName} olha brevemente para os outros Shad'rai—\"você se apegou às suas vidas \"imortais\" por eras e eras, pronto para pagar qualquer preço. E agora sua ruína chegará por suas próprias mãos. Uma pena que custará ao cosmos.\""

msgid "STORY_EVENT@991_4561@BUTTON_0"
msgstr "Prenda {EventPlayer.FirstName} para interrogatório futuro."

msgid "STORY_EVENT@991_4561@TITLE"
msgstr "A Queda de {EventPlayer}"

msgid "STORY_EVENT@991_4562@BODY_FOOTER"
msgstr "Comovido por essa cena de tristeza, {AllyPlayer} sinaliza para <<o:AllyPlayer>> aliados deixarem {EventPlayer.FirstName} em paz. Não se precisa de prisão para um homem enredado em um labirinto de luto."

msgid "STORY_EVENT@991_4562@BODY_HEADER"
msgstr "Pedras foram esmagadas, montanhas inteiras desmoronaram até que {EventPlayer} sucumbiu ao poder do {GLOBAL.ShadraiFactionLoreConcept.Hyperlink}."

msgid "STORY_EVENT@991_4562@BODY_LORE"
msgstr "Silenciosamente, {EventPlayer.FirstName} permanece, uma estátua impávida de dor, lamentando o destino do {EventRace} e a perda de seus monumentos em {GLOBAL.GrexolisLoreConcept.Hyperlink}. Pois mesmo em um mundo fraturado sem futuro, {EventPlayer.FirstName} buscou moldar pedra e terra em novos lares."

msgid "STORY_EVENT@991_4562@BUTTON_0"
msgstr "Com o tempo, faremos de <<P:EventPlayer>> nosso prisioneiro legítimo."

msgid "STORY_EVENT@991_4562@TITLE"
msgstr "A Queda de {EventPlayer}"

msgid "STORY_EVENT@991_4844@BODY_FOOTER"
msgstr "\"A facilidade da magia tornou-se onipotente em nossas vidas. Agora desejamos inscrever nossas humildes aplicações em um tomo para que todos os {EventRace} estudem.\""

msgid "STORY_EVENT@991_4844@BODY_HEADER"
msgstr "Com um ruído estalante e um flash azul brilhante, o(a) <<EventUnit {presidente/presidenta}>> do Conselho {EventRace} surge diante do seu trono."

msgid "STORY_EVENT@991_4844@BODY_LORE"
msgstr "\"Meu(a) {PlayerLeader.Title}!\" <<p:EventUnit>> exclama ofegante, ainda atordoado(a) pela excitação. \"Sua proficiência no arcano é inspiradora! Nós, {EventRace}, olhamos para sua feitiçaria com admiração, e o mana abundante que você domina nos permite seguir humildemente seu exemplo: agricultores animam suas foices para colher, construtores fazem madeira e pedra leves como uma pena ao vento.\""

msgid "STORY_EVENT@991_4844@BUTTON_0"
msgstr "\"Concordo. Todo o mana fluirá livremente para os {EventRace}.\""

msgid "STORY_EVENT@991_4844@BUTTON_1"
msgstr "\"As correntes da magia são caprichosas. A parte do Conselho [mana/] é tudo o que posso poupar.\""

msgid "STORY_EVENT@991_4844@BUTTON_2"
msgstr "\"Os {EventRace} [felicidade/] não devem desperdiçar minha riqueza mágica com futilidades.\""

msgid "STORY_EVENT@991_4844@BUTTON_3"
msgstr "\"Este tomo seu [conhecimento/] poderia servir a um propósito maior. Eu o exijo para mim!\""

msgid "STORY_EVENT@991_4844@TITLE"
msgstr "Aplicações Arcanas"

msgid "STORY_EVENT@991_4848@BODY_FOOTER"
msgstr "\"Os padrões estéticos das cidades {EventRace} devem ser mantidos na mais alta estima, para que seu esplendor se torne conhecido em todo o reino.\""

msgid "STORY_EVENT@991_4848@BODY_HEADER"
msgstr "Gesticulando em direção à sacada do seu salão do trono, o(a) <<EventUnit {presidente/presidenta}>> do Conselho {EventRace} solicita uma audiência privada."

msgid "STORY_EVENT@991_4848@BODY_LORE"
msgstr "\"Oh, {PlayerLeader.TitleName},\" <<p:EventUnit>> diz com um sorriso suntuoso, \"que visão é contemplar {EventCity} ao pôr do sol. A arquitetura refinada, as grandes praças e torres — claramente a expressão da civilização atingiu seu auge em nossas belas cidades.\""

msgid "STORY_EVENT@991_4848@BUTTON_0"
msgstr "\"De fato, os {EventRace} serão conhecidos por sua arquitetura sublime.\""

msgid "STORY_EVENT@991_4848@BUTTON_1"
msgstr "\"A estética é um privilégio. O salão do conselho será grandioso [influência/], mas não as cabanas do povo comum.\""

msgid "STORY_EVENT@991_4848@BUTTON_2"
msgstr "\"Você não deve se entregar [felicidade/] a construções vaidosas. Acima de tudo, nossas cidades devem acomodar meu império.\""

msgid "STORY_EVENT@991_4848@TITLE"
msgstr "Posição Privilegiada"

msgid "STORY_EVENT@991_4852@BODY_FOOTER"
msgstr "\"Nós, {EventRace}, somos os vasos da guerra. Todos ouvirão nosso grito de batalha e desesperarão!\""

msgid "STORY_EVENT@991_4852@BODY_HEADER"
msgstr "Com confiança, o(a) <<EventUnit {presidente/presidenta}>> do Conselho {EventRace} caminha em direção ao seu trono, <<o:EventUnit>> arma erguida."

msgid "STORY_EVENT@991_4852@BODY_LORE"
msgstr "\"Salve, {PlayerLeader.TitleName}!\" <<p:EventUnit>> grita. \"Que idade gloriosa dos {EventRace} está amanhecendo! Temperados pela batalha e moldados através da vitória, nosso povo esculpiu seu novo destino nas linhas de nossos inimigos.\""

msgid "STORY_EVENT@991_4852@BUTTON_0"
msgstr "\"Avante, meus exércitos! Todos os {EventRace} se banharão em sangue!\""

msgid "STORY_EVENT@991_4852@BUTTON_1"
msgstr "\"Você se considera pronto, mas não está. Treine bem [unitprod/] e falaremos novamente.\""

msgid "STORY_EVENT@991_4852@BUTTON_2"
msgstr "\"Após cada guerra, vem um tempo de paz [felicidade/] e prosperidade.\""

msgid "STORY_EVENT@991_4852@TITLE"
msgstr "<<EventUnit {Filhos/Filhas}>> da Guerra"

msgid "STORY_EVENT@991_4859@BODY_FOOTER"
msgstr "\"Com este compêndio de bestiário, o Conselho deseja encorajar todos os {EventRace} a buscar companheirismo com seus animais afins.\""

msgid "STORY_EVENT@991_4859@BODY_HEADER"
msgstr "O(a) <<EventUnit{chairman/chairwoman}>> do Conselho {EventRace} se aproxima do seu trono, um jovem {AnimalUnit} aconchegado nos braços de <<o:EventUnit>>."

msgid "STORY_EVENT@991_4859@BODY_HEADER@CUB_ANIMAL"
msgstr "O(a) <<EventUnit{chairman/chairwoman}>> do Conselho {EventRace} se aproxima do seu trono, um {AnimalUnit} aconchegado nos braços de <<o:EventUnit>>."

msgid "STORY_EVENT@991_4859@BODY_LORE"
msgstr "\"Os <<m:{AnimalUnit}>> são criaturas magníficas, meu/minha {PlayerLeader.Title},\" diz o(a) <<EventUnit{chairman/chairwoman}>> com um sorriso carinhoso. \"Você sabia sobre {EventAnimalTopic} deles? Há tanto a aprender com a ligação com os animais selvagens, e nós, {EventRace}, nutrimos todos eles com grande paixão.\""

msgid "STORY_EVENT@991_4859@BUTTON_0"
msgstr "\"Toda vida é sagrada. Os {EventRace} podem abraçar as criaturas deste reino!\""

msgid "STORY_EVENT@991_4859@BUTTON_1"
msgstr "\"Meu/minha {AnimalUnit} [unit/] eu dou de presente ao Conselho, mas mais eu devo proibir.\""

msgid "STORY_EVENT@991_4859@BUTTON_2"
msgstr "\"Você não deve esquecer [happiness/] que o lugar dos animais é abaixo, não entre nós.\""

msgid "STORY_EVENT@991_4859@TITLE"
msgstr "Vínculo Primal"

msgid "STORY_EVENT@991_4877@BODY_FOOTER"
msgstr "\"O Conselho coletou as táticas mais eficazes do seu general, para que todos os {EventRace} possam ser treinados para a vitória.\""

msgid "STORY_EVENT@991_4877@BODY_HEADER"
msgstr "Envolto em bandagens ensanguentadas, o(a) <<EventUnit{chairman/chairwoman}>> do Conselho {EventRace} cumprimenta você com orgulho."

msgid "STORY_EVENT@991_4877@BODY_LORE"
msgstr "\"Força e sangue, {PlayerLeader.TitleName}!\" <<p:EventUnit>> exclama com o punho levantado. \"Os fracos caem no campo de batalha. Os frágeis são eliminados como vermes em seus buracos. Nenhuma tática é grotesca demais quando vence uma batalha. Nós, {EventRace}, nos adaptamos, adotamos as forças de nossos inimigos — e triunfamos.\""

msgid "STORY_EVENT@991_4877@BUTTON_0"
msgstr "\"Faça o que for preciso. Os {EventRace} serão temidos por sua crueldade.\""

msgid "STORY_EVENT@991_4877@BUTTON_1"
msgstr "\"Glória ao Conselho [influence/], mas o treinamento militar você deixa comigo.\""

msgid "STORY_EVENT@991_4877@BUTTON_2"
msgstr "\"A vitória se transforma em derrota [happiness/] se nos faz abandonar nossos princípios.\" [goodact/]"

msgid "STORY_EVENT@991_4877@TITLE"
msgstr "Glória Sangrenta"

msgid "STORY_EVENT@991_5037@BODY_FOOTER"
msgstr "Parece haver apenas uma maneira de obter <<ge: riches^p,EventHouse.Name>>: tomá-lo de assalto e saqueá-lo como desejar."

msgid "STORY_EVENT@991_5037@BODY_HEADER"
msgstr "Enquanto sua mente vagueia pela abundância cintilante do seu tesouro, você se pega ponderando sobre a cidade de {EventHouse}."

msgid "STORY_EVENT@991_5037@BODY_LORE"
msgstr "Desde que você conheceu {EventHouseLord}, um sentimento incômodo tem crescido dentro do seu poderoso peito. Rumores sobre <<g: wealth^n,EventHouseLord.FirstName>> envenenaram seus pensamentos. Histórias de um cofre do tesouro secreto abaixo de {EventHouse} capturaram sua mente. O {EventHouseLord.Title} eludiu todas as investigações, temeroso da ganância de um Dragão."

msgid "STORY_EVENT@991_5037@BUTTON_0"
msgstr "Planeje a invasão de {EventHouse}."

msgid "STORY_EVENT@991_5037@BUTTON_1"
msgstr "Reconsidere. Como {PlayerLeader.Title}, você tem outras oportunidades para aumentar seu tesouro."

msgid "STORY_EVENT@991_5037@BUTTON_2"
msgstr "Faça amizade [influence/] com {EventHouseLord} em vez disso para sifonar a riqueza de <<o:EventHouseLord>> através de tributos."

msgid "STORY_EVENT@991_5037@TITLE"
msgstr "<<ge:Treasury^n,EventHouse.Name>>"

msgid "STORY_EVENT@991_5038@BODY_FOOTER"
msgstr "O que você fará com as relíquias da {EventHouse} caída?"

msgid "STORY_EVENT@991_5038@BODY_HEADER"
msgstr "Com as muralhas de {EventHouse} violadas e {EventHouseLord} perecido, suas riquezas são suas para reclamar."

msgid "STORY_EVENT@991_5038@BODY_LORE"
msgstr "Seus capangas têm procurado rigorosamente no <<g:palace^n,EventHouseLord>>, mas é seu instinto infalível que revela a entrada para o cofre do tesouro. Entre pilhas consideráveis de ouro, você encontra uma vitrine cuidadosamente elaborada, contendo os artefatos mais finos de <<ge:dynasty^n,EventHouse>>."

msgid "STORY_EVENT@991_5038@BUTTON_0"
msgstr "Aproprie-se dos itens [item/] para seu tesouro."

msgid "STORY_EVENT@991_5038@BUTTON_1"
msgstr "Estabeleça um novo tesouro para atrair um {EventUnit} [unit/]."

msgid "STORY_EVENT@991_5038@BUTTON_3"
msgstr "Entregue-os aos ferreiros de {EventCity} [unitprod/] para aprimorar suas habilidades."

msgid "STORY_EVENT@991_5038@TITLE"
msgstr "<<ge:Tesouraria^n,EventHouse.Name>>: Consequências"

msgid "STORY_EVENT@991_5696@BODY_FOOTER"
msgstr "Como você reage aos horrores que se escondem na névoa, ameaçando a população da sua cidade?"

msgid "STORY_EVENT@991_5696@BODY_HEADER"
msgstr "Uma névoa espessa e antinatural está se espalhando a partir do {EventGeo} {EventDirection} {EventCity}."

msgid "STORY_EVENT@991_5696@BODY_LORE"
msgstr "Um silêncio assustador envolve o mundo fora dos portões da cidade. Relatos de figuras estranhas se arrastando nas sombras espalham pânico entre seus cidadãos, enquanto as aldeias vizinhas falam de pessoas desaparecendo na névoa."

msgid "STORY_EVENT@991_5696@BUTTON_0"
msgstr "Esvazie seus baús de tesouro [gold/] para reunir a milícia [unitprod/] de {EventCity}."

msgid "STORY_EVENT@991_5696@BUTTON_1"
msgstr "Cercar a cidade com feitiços de proteção [mana/] para atrasar a aproximação do temor."

msgid "STORY_EVENT@991_5696@BUTTON_2"
msgstr "Deixe as pessoas se refugiarem em {EventCity}. Suas defesas estão preparadas."

msgid "STORY_EVENT@991_5696@TITLE"
msgstr "Pedágio da Primavera"

msgid "STORY_EVENT@991_5696@TITLE@AUTUMN"
msgstr "Pedágio do Outono"

msgid "STORY_EVENT@991_5696@TITLE@SUMMER"
msgstr "Pedágio do Verão"

msgid "STORY_EVENT@991_5696@TITLE@WINTER"
msgstr "Pedágio do Inverno"

msgid "STORY_EVENT@991_5701@BODY_FOOTER"
msgstr "Há pouco tempo antes que o {EventStructure} desmorone."

msgid "STORY_EVENT@991_5701@BODY_FOOTER@POP_LOST"
msgstr "Há pouco tempo antes que o {EventStructure} desmorone e qualquer esperança de resgatar os cativos de {EventCity} termine."

msgid "STORY_EVENT@991_5701@BODY_HEADER"
msgstr "Você expulsou os {EventRace} de {EventCity}."

msgid "STORY_EVENT@991_5701@BODY_LORE"
msgstr "Seus remanescentes, seguindo o rastro do terrível {EventUnit}, recuaram para as névoas dissipantes. À medida que o ar lentamente fica claro novamente, um {EventStructure} é revelado no {EventGeo}. Sem dúvida, é aqui que os {EventRace} retornaram ao seu reino das Fadas."

msgid "STORY_EVENT@991_5701@BODY_LORE@POP_LOST"
msgstr "Seus remanescentes, seguindo o rastro do terrível {EventUnit}, recuaram para as névoas dissipantes. À medida que o ar lentamente fica claro novamente, um {EventStructure} é revelado no {EventGeo}. É aqui que suas pessoas de {EventCity} foram levadas? Sequestradas para o reino das Fadas?"

msgid "STORY_EVENT@991_5701@BUTTON_0"
msgstr "Que todos se apressem!"

msgid "STORY_EVENT@991_5701@TITLE"
msgstr "Névoas Retirantes"

msgid "STORY_EVENT@991_5713@BODY_FOOTER"
msgstr "Você enviará seu exército para o {EventStructure} para perseguir os {EventRace}?"

msgid "STORY_EVENT@991_5713@BODY_FOOTER@POP_LOST"
msgstr "Você enviará seu exército para o {EventStructure} para perseguir os {EventRace} e libertar seu povo?"

msgid "STORY_EVENT@991_5713@BODY_HEADER"
msgstr "Aproximando-se do {EventStructure}, você pode sentir uma presença diminuindo da magia das Fadas."

msgid "STORY_EVENT@991_5713@BODY_LORE"
msgstr "Não há dúvida de que o {EventStructure} leva ao reino das Fadas, {GLOBAL.DuathaLoreConcept.Hyperlink}, e aos {EventRace} restantes. Você deve pesar suas opções. Os {EventRace} ainda podem ser numerosos. Eles serão difíceis de surpreender em seu próprio domínio errático. Você não consegue se livrar da sensação de que segui-los sem um exército suficientemente grande seria suicídio."

msgid "STORY_EVENT@991_5713@BUTTON_0"
msgstr "\"Não tememos nada. Nós passaremos!\""

msgid "STORY_EVENT@991_5713@BUTTON_1"
msgstr "Feche a fissura para drenar as últimas gotas de magia das Fadas [mana/]."

msgid "STORY_EVENT@991_5713@BUTTON_2"
msgstr "Recuar, por enquanto."

msgid "STORY_EVENT@991_5713@TITLE"
msgstr "O Caminho para Duatha"

msgid "STORY_EVENT@991_5714@BODY_FOOTER"
msgstr "Os gritos de suas tropas alertam sobre o colapso de {EventStructure}. O que quer que você pretenda fazer com a relíquia das Fadas, deve ser feito rapidamente!"

msgid "STORY_EVENT@991_5714@BODY_FOOTER@HERO"
msgstr "Os gritos de suas tropas alertam <<p:EventHero>> sobre o iminente colapso de {EventStructure}. O que quer que <<p:EventHero>> pretendesse fazer com a relíquia das Fadas, deve ser feito rapidamente!"

msgid "STORY_EVENT@991_5714@BODY_HEADER"
msgstr "Você expulsou os {EventRace} restantes mais profundamente para o reino das Fadas."

msgid "STORY_EVENT@991_5714@BODY_HEADER@POP_LOST"
msgstr "Você expulsou os {EventRace} restantes mais profundamente para o reino das Fadas, e seus cativos — seus cidadãos de {EventCity} — estão livres novamente."

msgid "STORY_EVENT@991_5714@BODY_LORE"
msgstr "Enquanto as tropas ficam atentas a qualquer truque maligno das Fadas, sua atenção é atraída para o santuário da árvore colocado no centro do assentamento. Em seu coração repousa uma relíquia de outro mundo, ecoando os sussurros de uma entidade distante enquanto você se aproxima o suficiente para tocá-la. A relíquia irradia grande poder, mas também ameaça."

msgid "STORY_EVENT@991_5714@BODY_LORE@HERO"
msgstr "Enquanto as tropas ficam atentas a qualquer truque maligno das Fadas, <<ge:attention^n,EventHero.Name>> é atraído para o santuário da árvore colocado no centro do assentamento. Em seu coração repousa uma relíquia de outro mundo, ecoando os sussurros de uma entidade distante enquanto {EventHero} se aproxima o suficiente para tocá-la. A relíquia emana grande poder, mas também ameaça."

msgid "STORY_EVENT@991_5714@BUTTON_0"
msgstr "Quebre a relíquia para liberar a magia que habita dentro."

msgid "STORY_EVENT@991_5714@BUTTON_2"
msgstr "Desencante a relíquia em essência de ligação [bindingfragments/]."

msgid "STORY_EVENT@991_5714@BUTTON_3"
msgstr "Pegue a relíquia. Seus poderes serão seus!"

msgid "STORY_EVENT@991_5714@TITLE"
msgstr "O Caminho para Duatha: Consequências"

msgid "STORY_EVENT@991_5737@BODY_FOOTER"
msgstr "\"Devolva a {EventRelic} e nós moveremos nossos assuntos para um império de sua sugestão. Recuse, e você invocará as névoas de {GLOBAL.DuathaLoreConcept.Hyperlink}.\""

msgid "STORY_EVENT@991_5737@BODY_HEADER"
msgstr "Uma sensação de inquietação rasteja nas câmaras profundas da torre do seu feiticeiro, enquanto um emissário dos {EventRace} aparece de uma rajada repentina de névoa."

msgid "STORY_EVENT@991_5737@BODY_LORE"
msgstr "\"Eu sou {EventHero}, descendente do grande Corvo Tharic e servo dos {GLOBAL.DuathadaeLoreConcept.Hyperlink}. Nossos senhores,\" diz <<p:EventHero>>, \"não toleram a perda dos presentes que deram.\" A Fada segura uma bainha com marcações ornamentais que retratam a {EventRelic}. \"Sortudo para você, {PlayerLeader}, os {GLOBAL.DuathadaeLoreConcept.Hyperlink} são generosos com suas ofertas,\" {EventHero} continua enquanto <<p:EventHero>> brevemente transforma <<o:EventHero>> rosto em um semblante de {EventUnit}."

msgid "STORY_EVENT@991_5737@BUTTON_0"
msgstr "Devolva a relíquia das Fadas e peça aos {EventRace} para atacar {TargetPlayerA}."

msgid "STORY_EVENT@991_5737@BUTTON_2"
msgstr "Negue a devolução do ídolo."

msgid "STORY_EVENT@991_5737@BUTTON_3"
msgstr "... peça aos {EventRace} para atacar {TargetPlayerB}."

msgid "STORY_EVENT@991_5737@BUTTON_4"
msgstr "... peça aos {EventRace} para atacar {TargetPlayerC}."

msgid "STORY_EVENT@991_5737@TITLE"
msgstr "Uma Oferta Inesperada"

msgid "STORY_EVENT@991_5738@BODY_FOOTER"
msgstr "O tempo para negociações passou. Como você se preparará para o ataque final das Fadas?"

msgid "STORY_EVENT@991_5738@BODY_HEADER"
msgstr "A névoa que se espalha dos {EventRace} anuncia o início iminente da batalha por {EventCity}."

msgid "STORY_EVENT@991_5738@BODY_LORE"
msgstr "Não há incerteza assustadora, nenhuma dúvida sobre a natureza das névoas ou das figuras que se arrastam dentro delas. Os {GLOBAL.DuathadaeLoreConcept.Hyperlink} exigem de volta o que consideram legitimamente deles, e os {EventRace} são seu instrumento de guerra."

msgid "STORY_EVENT@991_5738@BUTTON_0"
msgstr "Prometa qualquer recompensa [gold/] para tropas [unitprod/] se juntarem ao último levante em {EventCity}."

msgid "STORY_EVENT@991_5738@BUTTON_1"
msgstr "Cercar a cidade com feitiços de proteção [mana/] para atrasar a força invasora."

msgid "STORY_EVENT@991_5738@BUTTON_2"
msgstr "Deixe as pessoas se refugiarem em {EventCity}. Suas defesas estão preparadas."

msgid "STORY_EVENT@991_5738@TITLE"
msgstr "Duatha Desencadeado"

msgid "STORY_EVENT@991_5739@BODY_FOOTER"
msgstr "Graças à sua vitória, o reino não precisa mais temer o Pedágio das Estações."

msgid "STORY_EVENT@991_5739@BODY_HEADER"
msgstr "Você derrotou os {EventRace} e acabou com seu ataque. O povo de {EventCity} está em festa!"

msgid "STORY_EVENT@991_5739@BODY_LORE"
msgstr "Enquanto isso, você se retirou para sua torre de feiticeiro para retornar ao {EventRelic}, que agora é seu e apenas seu. A relíquia dos {GLOBAL.DuathadaeLoreConcept.Hyperlink} intriga e excita você, e passar mais tempo sintonizado com ela revelou mais de seus segredos."

msgid "STORY_EVENT@991_5739@BUTTON_0"
msgstr "Eu faço o que deve ser feito. [happiness/] [influence/]"

msgid "STORY_EVENT@991_5739@TITLE"
msgstr "Fim das Brumas"

msgid "STORY_EVENT@991_6428@BODY_FOOTER"
msgstr "Você construirá o <<m:{GLOBAL.ForesterConcept.Hyperlink}>> para coletar a madeira que {EventHero} precisa para <<o:EventHero>> {EventImprovement}?"

msgid "STORY_EVENT@991_6428@BODY_HEADER"
msgstr "Seu [hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink] {EventHero} se aproxima de você, uma tocha acesa em <<o:EventHero>> mãos."

msgid "STORY_EVENT@991_6428@BODY_LORE"
msgstr "\"Contemple a chama, meu {EventPlayer.Title}, e observe-a devorar a essência material deste [hyperlink,GLOBAL.WorldsWithinLoreConcept]mundo interior[/hyperlink]! Ela não deu origem a civilizações inteiras e as destruiu à sua vontade?\" <<Cge:eyes^p,EventHero.FirstName>> brilham à luz de <<o:EventHero>> tocha. \"Você é {GLOBAL.GodirLoreConcept.Hyperlink}. Você conhece os poderes arcanos que emanam de cada fogueira. Deixe-me avivar as chamas, {PlayerLeader}! Deixe-me criar um {EventImprovement} digno de sua magnificência!\""

msgid "STORY_EVENT@991_6428@TITLE"
msgstr "Cinzas às Cinzas"

msgid "STORY_EVENT@991_6429@BODY_FOOTER"
msgstr "Fortificado pelo {EventImprovement}, você sente uma onda arcana percorrendo seu corpo. O que você faz?"

msgid "STORY_EVENT@991_6429@BODY_HEADER"
msgstr "Com entusiasmo febril, {EventHero} apresenta a você <<o:EventHero>> {EventImprovement} flamejante."

msgid "STORY_EVENT@991_6429@BODY_LORE"
msgstr "\"Queime, chama eterna, e ilumine os céus! Deixe todos neste reino ver o esplendor de {PlayerLeader.TitleName}!\" {EventHero.FirstName} levanta <<o:EventHero>> mãos e, enquanto o fogo queima <<ge:offerings^p,EventHero.FirstName>>, você pode sentir as [hyperlink,GLOBAL.AstralFlowsLoreConcept]correntes astrais[/hyperlink] mudarem até convergirem em sua posição."

msgid "STORY_EVENT@991_6429@TITLE"
msgstr "Cinzas às Cinzas: Consequências"

msgid "STORY_EVENT@991_6432@BUTTON_0"
msgstr "Você canaliza a mana para invocar um ser de fogo puro [unit/]."

msgid "STORY_EVENT@991_6432@BUTTON_1"
msgstr "Você lança uma bênção ligada às chamas [unitHero/] em {EventHero}."

msgid "STORY_EVENT@991_6432@BUTTON_2"
msgstr "Você absorve as energias arcanas [mana/]."

msgid "STORY_EVENT@991_6433@BUTTON_0"
msgstr "\"Acenda a chama, {EventHero}. Ela fortalecerá meu reinado.\""

msgid "STORY_EVENT@991_6433@BUTTON_1"
msgstr "\"Não tenho interesse em seu {EventImprovement}, {EventHero}.\""

msgid "STORY_EVENT@991_6446@BODY_FOOTER"
msgstr "\"Diga onde colocar meu {EventImprovement} e será feito!\""

msgid "STORY_EVENT@991_6446@BODY_HEADER"
msgstr "Seus <<m:{GLOBAL.ForesterConcept.Hyperlink}>> coletaram a madeira que {EventHero} precisava para <<o:EventHero>> {EventImprovement}."

msgid "STORY_EVENT@991_6446@BODY_LORE"
msgstr "\"É hora, meu {EventPlayer.Title}\", diz {EventHero.FirstName}, com um fogo queimando em <<o:EventHero>> olhos. \"As estacas estão preparadas e meus dedos coçam para acender a faísca que incendeia o palco...\""

msgid "STORY_EVENT@991_6446@BUTTON_0"
msgstr "\"Vou inspecionar minhas cidades para dar a ordem...\""

msgid "STORY_EVENT@991_6446@TITLE"
msgstr "Cinzas às Cinzas: Interlúdio"

msgid "STORY_EVENT@991_6463@BODY_FOOTER"
msgstr "Você construirá o <<m:{GLOBAL.ForesterConcept.Hyperlink}>> para coletar a madeira que {EventHero} precisa para <<o:EventHero>> {EventImprovement}?"

msgid "STORY_EVENT@991_6463@BODY_HEADER"
msgstr "Com uma expressão triste no rosto de <<o:EventHero>> e a pele de um {EventUnit} nas mãos de <<o:EventHero>>, {EventHero} busca sua audiência."

msgid "STORY_EVENT@991_6463@BODY_LORE"
msgstr "\"Isto, meu {PlayerLeader.Title},\" <<p:EventHero>> começa, \"era um {EventUnit}, uma criatura orgulhosa que já vagou por terras distantes e próximas. Mas nestes dias, onde nossas cidades invadem as terras selvagens, eles são mortos como meras pragas.\" {EventHero.FirstName} mostra a cicatriz manchada de sangue onde a pele foi perfurada. \"Os animais deste reino precisam de um abrigo, isolado dentro do nosso domínio. Permita-me construir um {EventImprovement}, {PlayerLeader}, e poderemos prosperar em harmonia novamente.\""

msgid "STORY_EVENT@991_6463@BUTTON_0"
msgstr "\"Você é sábio, {EventHero}. As bestas desta terra devem ser domadas, não caçadas.\""

msgid "STORY_EVENT@991_6463@BUTTON_1"
msgstr "\"Os <<m:{EventUnit}>> não são da minha preocupação, {EventHero}.\""

msgid "STORY_EVENT@991_6463@TITLE"
msgstr "Um Abrigo Intocado"

msgid "STORY_EVENT@991_6464@BODY_FOOTER"
msgstr "\"Seus instintos são infalíveis, meu {PlayerLeader.Title}. Diga-me, onde devo construir o {EventImprovement}?\""

msgid "STORY_EVENT@991_6464@BODY_HEADER"
msgstr "Seus <<m:{GLOBAL.ForesterConcept.Hyperlink}>> coletaram a madeira que {EventHero} precisava para <<o:EventHero>> {EventImprovement}."

msgid "STORY_EVENT@991_6464@BODY_LORE"
msgstr "\"Sua benevolência é uma bênção para as criaturas desta terra, {PlayerLeader},\" diz {EventHero}, segurando um {EventTreeBranch}. \"Eu tenho tudo planejado. Os cochos, as cercas, a isca nas trilhas dos animais...\" <<Cp:EventHero>> usa <<o:EventHero>> {EventTreeBranch} para fazer desenhos no chão, presumivelmente formando um mapa, embora permaneça ilegível."

msgid "STORY_EVENT@991_6464@BUTTON_0"
msgstr "\"Meus 'instintos' estão examinando a terra ao redor de nossas cidades...\""

msgid "STORY_EVENT@991_6464@TITLE"
msgstr "Um Abrigo Intocado: Interlúdio"

msgid "STORY_EVENT@991_6465@BODY_FOOTER"
msgstr "\"Você fomentou este santuário, meu {PlayerLeader.Title}. Por favor, escolha seu presente dele, maduro para ser colhido.\""

msgid "STORY_EVENT@991_6465@BODY_HEADER"
msgstr "Cheio de alegria e orgulho, {EventHero} convida você a visitar <<o:EventHero>> {EventImprovement}."

msgid "STORY_EVENT@991_6465@BODY_LORE"
msgstr "Cercado pela <<m:{EventGeo}>> {EventDirection} {EventCity}, o {EventImprovement} está repleto de muitas bestas, grandes e pequenas. Até mesmo um {EventUnit} já encontrou seu caminho até aqui. \"Não é maravilhoso,\" pergunta {EventHero.FirstName}, gesticulando ao redor. \"As criaturas da terra aceitaram minha oferta. Seus espíritos perturbados estão encontrando descanso e concedendo paz às terras selvagens.\""

msgid "STORY_EVENT@991_6465@BUTTON_0"
msgstr "\"Eu vou nutrir o {EventUnit} [unit/] até que ele cresça em plena força.\""

msgid "STORY_EVENT@991_6465@BUTTON_1"
msgstr "\"Você é o presente, {EventHero}. Lidere este novo 'bando' seu com sabedoria [unitHero/].\""

msgid "STORY_EVENT@991_6465@BUTTON_2"
msgstr "\"Domine uma montaria [mount/] do seu {EventImprovement}, {EventHero}, para cavalgar na batalha!\""

msgid "STORY_EVENT@991_6465@TITLE"
msgstr "Um Abrigo Intocado: Desfecho"

msgid "STORY_EVENT@991_6484@BODY_FOOTER"
msgstr "\"Se você me confiar um {GLOBAL.ResearchPostConcept.Hyperlink}, meu {PlayerLeader.Title}, eu fundarei o primeiro {EventImprovement} deste reino!\""

msgid "STORY_EVENT@991_6484@BODY_HEADER"
msgstr "Um frio rastejante entra na sala enquanto {EventHero} busca sua companhia."

msgid "STORY_EVENT@991_6484@BODY_LORE"
msgstr "\"Quando as pessoas ouvem sobre magia de gelo, meu {PlayerLeader.Title}, elas pensam em inverno e morte,\" <<p:EventHero>> diz lentamente, \"enquanto deveriam considerar as estruturas de cristais de gelo assombrosamente belas e suas aplicações úteis. Sabia que eu poderia congelar profundamente a carne de um {EventUnit} e ela não estragaria em anos? Para acabar com esta ignorância,\" {EventHero.FirstName} conclui, \"eu sonho com um {EventImprovement}, onde magos de gelo quebram o gelo — e estudam seus mistérios.\""

msgid "STORY_EVENT@991_6484@BUTTON_0"
msgstr "\"Reúna seus aprendizes, {EventHero}. Será feito.\""

msgid "STORY_EVENT@991_6484@BUTTON_1"
msgstr "\"Não posso apoiar seus planos de gelo e frio, {EventHero}.\""

msgid "STORY_EVENT@991_6484@TITLE"
msgstr "Anseios Gélidos"

msgid "STORY_EVENT@991_6485@BODY_FOOTER"
msgstr "\"Agora me diga, meu {PlayerLeader.Title}, qual terra congelada posso reclamar para minha {EventImprovement}?\""

msgid "STORY_EVENT@991_6485@BODY_HEADER"
msgstr "Dentro do {GLOBAL.ResearchPostConcept.Hyperlink} que você emprestou a <<P:EventHero>>, {EventHero} finalizou <<o:EventHero>> preparações para fundar a {EventImprovement}."

msgid "STORY_EVENT@991_6485@BODY_LORE"
msgstr "\"As artes geladas estão prontas para serem ensinadas, ó {PlayerLeader.TitleName},\" {EventHero} declara com dignidade. \"Adquiri os pergaminhos e materiais, planejei o complexo de construção e os assuntos a serem abordados. Meus futuros alunos estão ansiosos para se matricular no primeiro termo. Agora, tudo o que falta é um pouco de neve sob seu comando...\" {EventHero.FirstName} mostra um sorriso raro."

msgid "STORY_EVENT@991_6485@BUTTON_0"
msgstr "\"Terra congelada? Deixe-me ver se minhas cidades podem acomodar seus desejos...\""

msgid "STORY_EVENT@991_6485@TITLE"
msgstr "Anseios Gelados: Interlúdio"

msgid "STORY_EVENT@991_6486@BODY_FOOTER"
msgstr "\"Seu patrocínio permitiu a fundação desta faculdade. Qualquer favor que você pedir, eu obedecerei.\""

msgid "STORY_EVENT@991_6486@BODY_HEADER"
msgstr "Vestindo uma roupa de arquimago, {EventHero} recebe você em <<o:EventHero>> {EventImprovement}."

msgid "STORY_EVENT@991_6486@BODY_LORE"
msgstr "\"Bem-vindo à Faculdade de {EventCity},\" <<p:EventHero>> pronuncia, abrindo o portão da frente, \"onde os iniciados invocam as tempestades do inverno e a geada floresce. Claro,\" <<p:EventHero>> adiciona com cautela, \"tudo isso empalidece diante de sua magia, {PlayerLeader.TitleName}.\""

msgid "STORY_EVENT@991_6486@BUTTON_0"
msgstr "\"Deixe seus adeptos invocarem uma criatura gelada [unit/] para eu comandar!\""

msgid "STORY_EVENT@991_6486@BUTTON_1"
msgstr "\"Chefe da Faculdade de {EventCity} [unitHero/] com a firmeza do gelo.\""

msgid "STORY_EVENT@991_6486@BUTTON_2"
msgstr "\"Seu melhor aluno me servirá como um {EventUnit} [unit/].\""

msgid "STORY_EVENT@991_6486@TITLE"
msgstr "Anseios Gelados: Desfecho"

msgid "STORY_EVENT@991_6495@BODY_FOOTER"
msgstr "Você construirá a <<m:{GLOBAL.QuarryConcept.Hyperlink}>> para fornecer a {EventHero} as pedras trabalhadas necessárias para <<o:EventHero>> {EventImprovement}?"

msgid "STORY_EVENT@991_6495@BODY_HEADER"
msgstr "Com a armadura e vestes de <<o:EventHero>> arrumadas e polidas, {EventHero} ajoelha-se diante do seu trono."

msgid "STORY_EVENT@991_6495@BODY_LORE"
msgstr "\"Certamente, meu {PlayerLeader.Title}, você já ouviu falar do poder que pode ser ligado em runas mágicas.\" <<Cp:EventHero>> revela uma pedra rúnica incrustada na armadura de <<o:EventHero>>. \"Desde que carreguei este encantamento, os golpes que recebo perdem potência e as flechas são desviadas a meu favor — e tornou-se meu desejo proteger mais de nossas tropas por meio dessa arte rúnica e estabelecer uma {EventImprovement}.\""

msgid "STORY_EVENT@991_6495@BUTTON_0"
msgstr "\"Você terá sua oficina, habilidoso {EventHero.FirstName}.\""

msgid "STORY_EVENT@991_6495@BUTTON_1"
msgstr "\"Sua {EventImprovement} não está alinhada com meus planos, {EventHero}.\""

msgid "STORY_EVENT@991_6495@TITLE"
msgstr "Runas de Magia"

msgid "STORY_EVENT@991_6497@BODY_FOOTER"
msgstr "\"Eu lhe devo uma dívida de gratidão, ó {PlayerLeader},\" {EventHero} conclui. \"Aceite qualquer compensação que esta {EventImprovement} possa fornecer.\""

msgid "STORY_EVENT@991_6497@BODY_HEADER"
msgstr "Entre armaduras estocadas e blocos de pedra, {EventHero} aguarda você para apresentar <<o:EventHero>> {EventImprovement}."

msgid "STORY_EVENT@991_6497@BODY_LORE"
msgstr "\"Olhe para este belo artesanato, meu <<EventPlayer{lord/lady}>>!\" <<Cp:EventHero>> chama um servo que está segurando uma vitrine trancada. {EventHero.FirstName} abre o cadeado. Dentro, você vê colares, anéis e amuletos, mas também armaduras de couro ornamentadas, todas imbuídas com pedras rúnicas encantadas. \"Embora sejam belas de se contemplar, o verdadeiro valor desses itens mágicos será revelado em batalha.\""

msgid "STORY_EVENT@991_6497@BUTTON_0"
msgstr "Pegue as runas azuis de <<A:{EventShieldSpell}>>."

msgid "STORY_EVENT@991_6497@BUTTON_1"
msgstr "Pegue as runas vermelhas de <<A:{EventBladeSpell}>>."

msgid "STORY_EVENT@991_6497@BUTTON_2"
msgstr "Pegue as runas amarelas de <<A:{EventArrowSpell}>>."

msgid "STORY_EVENT@991_6497@BUTTON_3"
msgstr "Escolha a armadura e a joia encantadas com runas [item/] da vitrine."

msgid "STORY_EVENT@991_6497@TITLE"
msgstr "Runas de Magia: Consequências"

msgid "STORY_EVENT@991_6501@BODY_FOOTER"
msgstr "\"Diga a palavra, meu {PlayerLeader.Title}, e eu estabelecerei meu {EventImprovement} sob seu comando.\""

msgid "STORY_EVENT@991_6501@BODY_HEADER"
msgstr "Suas <<m:{GLOBAL.QuarryConcept.Hyperlink}>> trabalharam as pedras que {EventHero} precisava para <<o:EventHero>> {EventImprovement}."

msgid "STORY_EVENT@991_6501@BODY_LORE"
msgstr "\"Ó {PlayerLeader.TitleName}, \" <<p:EventHero>> o recebe com uma reverência, \"todos os preparativos para começar a criação de runas foram concluídos. Os cortadores de pedra fizeram maravilhas, e assim como sua autorização, permitindo-me garantir ferramentas, artesãos e pergaminhos de encantamento.\" {EventHero.FirstName} exibe uma alegria industriosa."

msgid "STORY_EVENT@991_6501@BUTTON_0"
msgstr "\"Eu inspecionarei minhas cidades para dar a ordem...\""

msgid "STORY_EVENT@991_6501@TITLE"
msgstr "Runas de Magia: Interlúdio"

msgid "STORY_EVENT@991_6513@BODY_FOOTER"
msgstr "Você construirá o {GLOBAL.ConduitConcept.Hyperlink} que {EventHero} precisa para aproveitar para <<o:EventHero>> {EventImprovement}?"

msgid "STORY_EVENT@991_6513@BODY_HEADER"
msgstr "O ar começa a crepitar com energias arcana enquanto {EventHero} entra em sua sala do trono."

msgid "STORY_EVENT@991_6513@BODY_LORE"
msgstr "\"Sua magia é inspiradora, ó {PlayerLeader.TitleName},\" <<p:EventHero>> diz com uma voz respeitosa. \"Como seu humilde servo, busco emular apenas uma fração de seus poderes. Você é um {GLOBAL.GodirLoreConcept.Hyperlink}, capaz de erguer Torres de Feiticeiros que perfuram o céu. Eu sou um simples mago. No entanto, sonho com um {EventImprovement} onde a feitiçaria possa ser praticada pelos iniciados do arcano, para a glória de nosso {PlayerLeader.Title}.\""

msgid "STORY_EVENT@991_6513@BUTTON_0"
msgstr "\"Suas ambições me lisonjeiam, {EventHero}. Prossiga.\""

msgid "STORY_EVENT@991_6513@BUTTON_1"
msgstr "\"Apesar de suas palavras doces, não tenho interesse em seu {EventImprovement}, {EventHero}.\""

msgid "STORY_EVENT@991_6513@TITLE"
msgstr "Torre do Feiticeiro"

msgid "STORY_EVENT@991_6515@BODY_FOOTER"
msgstr "\"Este {EventImprovement} é uma mera gota em seu reservatório de riqueza arcana. Ainda assim, se desejar algo que ele oferece, pode levá-lo.\""

msgid "STORY_EVENT@991_6515@BODY_HEADER"
msgstr "Visitando o {EventImprovement} de {EventHero}, você é recebido por um familiar {MagicUnit}."

msgid "STORY_EVENT@991_6515@BODY_LORE"
msgstr "O {MagicUnit} mostra a você os diferentes níveis da torre, desde o porão de mana até a biblioteca, os campos de treinamento e, por fim, a torre do feiticeiro no topo. Lá, {EventHero} o recebe, exultante: \"Desculpe minha ausência inicial, meu {PlayerLeader.Title}. Mas as oportunidades que esta torre proporciona são exultantes e custa-me deixar meus estudos de lado...\""

msgid "STORY_EVENT@991_6515@BUTTON_0"
msgstr "\"Compartilhe as descobertas de seus estudos místicos [knowledge/], {EventHero.FirstName}.\""

msgid "STORY_EVENT@991_6515@BUTTON_1"
msgstr "\"Abrace este papel como um feiticeiro [unitHero/], {EventHero}. Ele combina com você.\""

msgid "STORY_EVENT@991_6515@BUTTON_2"
msgstr "Gosto do seu familiar {MagicUnit} [unit/]. Deixe-me ficar com ele.\""

msgid "STORY_EVENT@991_6515@TITLE"
msgstr "Torre do Feiticeiro: Consequências"

msgid "STORY_EVENT@991_6519@BODY_FOOTER"
msgstr "{EventHero} tem o impulso de liberar as energias astral de <<o:EventHero>> e criar o {EventImprovement} conforme sua vontade."

msgid "STORY_EVENT@991_6519@BODY_HEADER"
msgstr "Extraindo energias astral do {GLOBAL.ConduitConcept.Hyperlink} que você construiu para <<P:EventHero>>, {EventHero} finalizou os preparativos de <<o:EventHero>> para moldar o {EventImprovement}."

msgid "STORY_EVENT@991_6519@BODY_LORE"
msgstr "\"Você me deu poder, meu {PlayerLeader.Title}!\" <<Cp:EventHero>> fala com confiança, os olhos de <<o:EventHero>> brilhando com luz azul. \"Os {GLOBAL.AstralFlowsLoreConcept.Hyperlink}, eles fluem através do meu corpo; o mana, ele corre em minhas veias. Devo liberar seu potencial criativo enquanto a visão do {EventImprovement} estiver forte dentro de mim. {PlayerLeader}, por favor...\""

msgid "STORY_EVENT@991_6519@BUTTON_0"
msgstr "\"Onde os Condutos zumbem, seu {EventImprovement} prosperará...\""

msgid "STORY_EVENT@991_6519@TITLE"
msgstr "Torre do Feiticeiro: Interlúdio"

msgid "STORY_EVENT@991_6523@BODY_FOOTER"
msgstr "Você construirá a <<m:{GLOBAL.FarmConcept.Hyperlink}>> para fornecer a {EventHero} as colheitas necessárias para <<o:EventHero>> {EventImprovement}?"

msgid "STORY_EVENT@991_6523@BODY_HEADER"
msgstr "Com solenidade piedosa, você é visitado por {EventHero}, segurando uma figurinha que parece modelar—você!"

msgid "STORY_EVENT@991_6523@BODY_LORE"
msgstr "\"Ó {PlayerLeader.TitleName}!\" <<p:EventHero>> chama, pausando brevemente em <<o:EventHero>> devoção. \"Oficialmente, posso servi-lo como um general. Mas você não é apenas um governante para mim. Você é {GLOBAL.GodirLoreConcept.Hyperlink}, um {GLOBAL.GodirLoreConcept.Hyperlink}, que eu adoro e venero. Na Ordem de {PlayerLeader.FirstName}, muitos desejam prestar-lhe serviço religioso. Buscamos construir um {EventImprovement} onde possamos nos reunir como monges. Infelizmente, nos faltam terras agrícolas para cultivar as colheitas para nossos rituais...\""

msgid "STORY_EVENT@991_6523@BUTTON_0"
msgstr "\"Venerando meu {EventPlayerAttribute}? Você pode prosseguir...\""

msgid "STORY_EVENT@991_6523@BUTTON_1"
msgstr "\"Sua ordem deve se conter, por enquanto.\""

msgid "STORY_EVENT@991_6523@BUTTON_2"
msgstr "\"Venha a si, <<EventHero{irmão/irmã}>>! Apenas ao Pai de Todos devemos rezar...\" [goodact/]"

msgid "STORY_EVENT@991_6523@TITLE"
msgstr "A Ordem de {PlayerLeader.FirstName}"

msgid "STORY_EVENT@991_6524@BODY_FOOTER"
msgstr "\"Os discípulos aguardam ansiosamente as palavras proféticas de seu {GLOBAL.GodirLoreConcept.Hyperlink}: onde devemos construir o {EventImprovement}?\""

msgid "STORY_EVENT@991_6524@BODY_HEADER"
msgstr "Suas <<m:{GLOBAL.FarmConcept.Hyperlink}>> colheram as safras que {EventHero} precisava para <<o:EventHero>> {EventImprovement}."

msgid "STORY_EVENT@991_6524@BODY_LORE"
msgstr "\"Ó mais generoso {PlayerLeader.TitleName},\" {EventHero.FirstName} grita animado, \"essas ervas e progênies servirão bem aos nossos mestres de rituais. Enquanto isso,\" <<p:EventHero>> continua, \"seus seguidores não ficaram ociosos, garantindo arquitetos, força de trabalho e materiais de construção para o {EventImprovement}.\""

msgid "STORY_EVENT@991_6524@BUTTON_0"
msgstr "\"Assim que eu inspecionar minhas cidades, você receberá um sinal...\""

msgid "STORY_EVENT@991_6524@TITLE"
msgstr "A Ordem de {PlayerLeader.FirstName}: Interlúdio"

msgid "STORY_EVENT@991_6525@BODY_FOOTER"
msgstr "\"Nossa ordem e este {EventImprovement} existem apenas para servi-lo. Como podemos agradá-lo, nosso {EventPlayerType}, hoje?\""

msgid "STORY_EVENT@991_6525@BODY_HEADER"
msgstr "Carregando um tomo adornado com sua semelhança, {EventHero} recebe você no novo {EventImprovement}."

msgid "STORY_EVENT@991_6525@BODY_LORE"
msgstr "\"Você nos abençoa com sua presença, ó {PlayerLeader.TitleName}!\" <<Cp:EventHero>> levanta <<o:EventHero>> braços, pregando para os monges que se reúnem no <<Ge:central court^n,EventImprovement.Name>>. \"Através de nossos rituais, podemos agora transcender nossa consciência e nos aproximar de seu {EventPlayerAttribute}. Mas nada é tão elevador quanto nosso {GLOBAL.GodirLoreConcept.Hyperlink} caminhando entre nós.\""

msgid "STORY_EVENT@991_6525@BUTTON_0"
msgstr "\"Inscreva seus rituais e epifanias em livros sagrados de conhecimento.\" [knowledge/]"

msgid "STORY_EVENT@991_6525@BUTTON_1"
msgstr "\"Espalhe as palavras da minha natureza divina em {EventCity}!\" [happiness/]"

msgid "STORY_EVENT@991_6525@BUTTON_2"
msgstr "\"Deixe a fé de sua ordem fortalecer meu reinado.\" [influence/]"

msgid "STORY_EVENT@991_6525@BUTTON_DRAGON"
msgstr "\"Desejo as relíquias da sua ordem para o meu tesouro!\" [item/]"

msgid "STORY_EVENT@991_6525@BUTTON_ELDRITCH"
msgstr "\"[runicfont]O tentáculo dá e o tentáculo tira.[/runicfont]\"[thralls/]"

msgid "STORY_EVENT@991_6525@TITLE"
msgstr "A Ordem de {PlayerLeader.FirstName}: Desfecho"

msgid "STORY_EVENT@991_6558@BODY_FOOTER"
msgstr "Ansiosos para caçar os tesouros dos antigos Reis Gigantes, seus homens aguardam novas ordens."

msgid "STORY_EVENT@991_6558@BODY_HEADER"
msgstr "Fazendo seu caminho através do subterrâneo, suas tropas entram em uma caverna brilhando em tons de ouro."

msgid "STORY_EVENT@991_6558@BODY_LORE"
msgstr "Parece que realmente já houve uma abundância do metal precioso na região. Ruínas dispersas da arquitetura Myrridan conectadas por uma rede ferroviária e uma miríade de carrinhos de mineração sugerem que, nos dias da antiga {GLOBAL.MyrridaLoreConcept.Hyperlink}, isso deve ter sido um complexo de mineração de ouro florescente. O que ainda resta desse esplendor dourado ainda está para ser visto, mas o brilho nos olhos de suas tropas diz muito."

msgid "STORY_EVENT@991_6558@BUTTON_0"
msgstr "Permita que eles prossigam. [movementgeneral/]"

msgid "STORY_EVENT@991_6558@BUTTON_1"
msgstr "Você sente perigo. Eles devem descansar [hp/] antes de continuar."

msgid "STORY_EVENT@991_6558@BUTTON_2"
msgstr "Evite dar quaisquer ordens especiais."

msgid "STORY_EVENT@991_6558@BUTTON_3"
msgstr "Conecte-se com a terra para procurar as riquezas que estão à frente."

msgid "STORY_EVENT@991_6558@TITLE"
msgstr "Entrando nos Desertos Dourados"

msgid "STORY_EVENT@991_6576@BODY_FOOTER"
msgstr "Assustados pelos sussurros fantasmagóricos, seus soldados buscam sua orientação."

msgid "STORY_EVENT@991_6576@BODY_HEADER"
msgstr "Enquanto o som de moedas tilintando ecoa pela caverna, é respondido pelos suspiros murmurados de mil vozes sem boca."

msgid "STORY_EVENT@991_6576@BODY_LORE"
msgstr "\"Deixe-nos!\" \"Salve-nos!\" \"Junte-se a nós!\" \"Salvador!\" \"Traidor!\" \"Amaldiçoado!\" Os sussurros agitados enchem a caverna, discordantes e cobiçosos, instilando medo em suas tropas. Alguns deles afirmam ver figuras fantasmagóricas armadas se movendo na escuridão. Eventualmente, as vozes diminuem e os Desertos Dourados retornam a um estado de silêncio. Mas não é mais um silêncio que conhece conforto."

msgid "STORY_EVENT@991_6576@BUTTON_0"
msgstr "Dispense seus medos [happiness/]."

msgid "STORY_EVENT@991_6576@BUTTON_1"
msgstr "Apelo [influence/] à bravura deles."

msgid "STORY_EVENT@991_6576@BUTTON_2"
msgstr "Demonstre seu poder arcano [mana/]. Os fantasmas devem tremer!"

msgid "STORY_EVENT@991_6576@TITLE"
msgstr "Desertos Dourados: Sussurros Fantasmagóricos"

msgid "STORY_EVENT@991_6579@BODY_FOOTER"
msgstr "Fantasmas armados saem das sombras, bloqueando qualquer caminho para frente ou para trás."

msgid "STORY_EVENT@991_6579@BODY_HEADER"
msgstr "Depois que suas tropas resgataram outro esconderijo de ouro dentro das ruínas, uma única voz irada enche a caverna."

msgid "STORY_EVENT@991_6579@BODY_LORE"
msgstr "\"Invasores! Saqueadores! Ladrões!\" a voz grita, ecoando violentamente nos ouvidos de suas tropas. \"Todos vocês são culpados de ganância, manchando suas mãos com o sangue dos {EventRace}. Nós mineramos até a morte. Nós fundimos até a morte. Desmoronando sob os pés de ferro de {EventGiantKing}. Amaldiçoado é o nome de <<o:EventGiantKing>>. Amaldiçoado, o ouro. Amaldiçoado, todos que tocam uma única moeda!\""

msgid "STORY_EVENT@991_6579@BUTTON_0"
msgstr "\"Peguem em armas! Esses fantasmas não são páreo para nós!\""

msgid "STORY_EVENT@991_6579@BUTTON_1"
msgstr "\"Nossos corações não conhecem ganância. Para provar isso, sacrificaremos nossa riqueza [gold/].\""

msgid "STORY_EVENT@991_6579@TITLE"
msgstr "Desertos Dourados: Fúria Fantasmagórica"

msgid "STORY_EVENT@991_6580@BODY_FOOTER"
msgstr "Cegado pela agonia, o fantasma envia mais de <<o:EventHero>> irmãos para vingar falsamente seu destino."

msgid "STORY_EVENT@991_6580@BODY_HEADER"
msgstr "Com mais ouro tirado das ruínas, a voz do fantasma retorna com raiva."

msgid "STORY_EVENT@991_6580@BODY_LORE"
msgstr "\"Parem! Parem! Por que vocês não morrem, invasores implacáveis? Nós não sofremos o suficiente...\" O fantasma soa desesperado, derrotado. \"{EventGiantKing} ansiava por golems incansáveis para fazer <<o:EventGiantKing>> vontade, sem descanso, vontade ou necessidades,\" a voz continua. \"Quando as forjas falharam nas demandas de <<o:EventGiantKing>>, {EventGiantKing} recorreu à magia perversa, tentando torcer nossos corpos em uma raça de servos golems. Em vez disso... nos tornamos isso!\" O fantasma revela <<o:EventHero>> rosto, metade carne fantasmagórica e metade metal."

msgid "STORY_EVENT@991_6580@BUTTON_0"
msgstr "\"Fiquem juntos! Sem misericórdia para os desalmados!\""

msgid "STORY_EVENT@991_6580@BUTTON_1"
msgstr "\"Suas almas perturbadas buscam descanso. Permita-me ajudá-los [mana/]...\""

msgid "STORY_EVENT@991_6580@TITLE"
msgstr "Desertos Dourados: Tristezas Fantasmagóricas"

msgid "STORY_EVENT@991_6581@BODY_FOOTER"
msgstr "\"Estou abrindo o caminho para {EventGiantKing} e <<o:EventGiantKing>> tesouro. Mate o amaldiçoado, {PlayerLeader}, cumpra nossa vingança!\""

msgid "STORY_EVENT@991_6581@BODY_HEADER"
msgstr "Você tomou muitos dos tesouros dos Desertos Dourados. O herói fantasma vem até você, calmo finalmente."

msgid "STORY_EVENT@991_6581@BODY_LORE"
msgstr "\"Talvez,\" <<p:EventHero>> diz, metade para <<r:EventHero>>, \"este não seja um momento de ruína, mas de fortuna. Quando os {GLOBAL.ArchonsLoreConcept.Hyperlink} cavalgaram para a justiça e {EventGiantKing} previu <<o:EventGiantKing>> destino, <<p:EventGiantKing>> escondeu <<o:EventGiantKing>> alma dentro de um cálice alimentando um {EventUnit}. Lá <<p:EventGiantKing>> sobreviveu à queda de {GLOBAL.MyrridaLoreConcept.Hyperlink}, e embora tenhamos trancado <<P:EventGiantKing>> dentro de <<o:EventGiantKing>> próprio tesouro, nunca pudemos completar nossa vingança, pois <<o:EventGiantKing>> poderes estão além dos nossos.\""

msgid "STORY_EVENT@991_6581@BUTTON_0"
msgstr "\"Este {EventGiantKing} não será páreo para nós!\" [influence/]"

msgid "STORY_EVENT@991_6581@BUTTON_1"
msgstr "\"Eu aceito seu chamado, mas seus fantasmas [unit/] se juntarão a mim em batalha.\""

msgid "STORY_EVENT@991_6581@TITLE"
msgstr "Terras Douradas: Vingança Fantasmal"

msgid "STORY_EVENT@991_6584@BODY_HEADER@CALMED_PHANTASM"
msgstr "Suas ações acalmaram o herói fantasma. <<Cp:EventHero>> parece ser capaz de ver além da raiva de <<o:EventHero>> novamente."

msgid "STORY_EVENT@991_6591@BODY_FOOTER"
msgstr "O fantasma se curva diante de você, antes de partir: \"As Terras Douradas são suas agora, {PlayerLeader.TitleName}.\""

msgid "STORY_EVENT@991_6591@BODY_HEADER"
msgstr "Com um ruído ensurdecedor, o {EventUnit} desaba aos pés de suas tropas. O líder dos fantasmas aparece, o núcleo dourado contendo <<ge:soul^n,EventGiantKing>> nas mãos de <<o:EventHero>>."

msgid "STORY_EVENT@991_6591@BODY_LORE"
msgstr "\"Está feito,\" <<p:EventHero>> diz, olhando incrédulo para o artefato reluzente. \"Você nos livrou de nossa maldição. Finalmente, as almas dos {EventRace} podem descansar em paz.\" O herói fantasma entrega a você o {EventRelic}. \"Pegue. Você saberá como destruir ou conter {EventGiantKing}.\" Ao tocar o amuleto, você sente um grande poder, mas também—perturbação! Esta não é uma alma integral dentro do {EventRelic}. É um fragmento, um memorial miserável da vã busca pela imortalidade."

msgid "STORY_EVENT@991_6591@BUTTON_0"
msgstr "\"Eu reclamo estas terras para renovar o esplendor [influence/] da antiga Myrrida.\""

msgid "STORY_EVENT@991_6591@BUTTON_1"
msgstr "\"Não descansaremos até que cada moeda [gold/] deixada nessas minas seja nossa.\""

msgid "STORY_EVENT@991_6591@BUTTON_3"
msgstr "\"Os mistérios descobertos aqui, eu presenteio aos {GLOBAL.EternalSagesLoreConcept.Name}.\" [allegiance/]"

msgid "STORY_EVENT@991_6591@TITLE"
msgstr "Terras Douradas: Consequências"

msgid "STORY_EVENT@991_6672@BODY_FOOTER"
msgstr "Os fluxos dentro da barreira estão sobrecarregando seus sentidos astrais, tornando impossível discernir o que está dentro."

msgid "STORY_EVENT@991_6672@BODY_HEADER"
msgstr "Aproximando-se do olho da tempestade, suas tropas encontram seu caminho bloqueado por um vórtice impenetrável."

msgid "STORY_EVENT@991_6672@BODY_LORE"
msgstr "Aqui, as descargas astrais estão carregadas ao máximo—enviar alguém através da barreira seria equivalente a uma sentença de morte. Dentro da barreira, a forma de algo enorme pode ser vislumbrada, como um titã mantido em estase pelo redemoinho ao redor."

msgid "STORY_EVENT@991_6672@BUTTON_0"
msgstr "\"Nós nos retiraremos, por enquanto.\""

msgid "STORY_EVENT@991_6672@TITLE"
msgstr "Platô da Tempestade de Cristal: Barreira da Tempestade"

msgid "STORY_EVENT@991_6690@BODY_FOOTER"
msgstr "A tempestade de cristal o atrai, capturando sua atenção. No entanto, como você protegerá suas tropas dos perigos que estão à frente?"

msgid "STORY_EVENT@991_6690@BODY_HEADER"
msgstr "No topo das encostas da montanha {EventDirection} {EventCity}, suas tropas se encontram em uma área elevada fervilhando com energia astral."

msgid "STORY_EVENT@991_6690@BODY_LORE"
msgstr "Formações cristalinas bizarras estão espalhadas por toda a região, algumas crescendo do chão, outras mantidas em levitação pelas forças de cisalhamento da tempestade que assola o centro do platô. À distância, uma abundância de criaturas de Lithorine pode ser vista vagando pela paisagem. Se elas foram atraídas pelos cristais, criaram-nos ou os protegem, é incerto."

msgid "STORY_EVENT@991_6690@BUTTON_0"
msgstr "Lance sobre eles [mana/] um feitiço de proteção [resistance/]."

msgid "STORY_EVENT@991_6690@BUTTON_1"
msgstr "Ordene que se aterrem [defenselightning/] à custa de um avanço mais lento [movementwalk/]."

msgid "STORY_EVENT@991_6690@BUTTON_3"
msgstr "As tropas conseguirão sem seu apoio direto."

msgid "STORY_EVENT@991_6690@TITLE"
msgstr "Escalando o Platô da Tempestade de Cristal"

msgid "STORY_EVENT@991_6740@BODY_FOOTER"
msgstr "\"Traga núcleos de cristal de Lithorine,\" o {EventUnit} conclui, \"e eu quebro a proteção.\""

msgid "STORY_EVENT@991_6740@BODY_HEADER"
msgstr "Ao se afastarem da barreira da tempestade, suas tropas são abordadas por um {EventUnit} que sinaliza <<o:EventUnit>> intenções pacíficas."

msgid "STORY_EVENT@991_6740@BODY_LORE"
msgstr "\"Magia poderosa dos <<m:{GLOBAL.GiantKingLoreConcept.Hyperlink}>>,\" a {EventUnit} grita, \"muitas runestones enterradas sob o poderoso reino.\" <<Cp:EventUnit>> alcança sob <<o:EventUnit>> manto gasto para revelar uma esfera polida, com semelhança às pedras de visão dos Godir. \"Veja o passado. Veja o futuro. Pode destruir a magia dos parentes gigantes—Hastefolk paga o preço.\""

msgid "STORY_EVENT@991_6740@BUTTON_0"
msgstr "Aceitar o acordo da {EventUnit}."

msgid "STORY_EVENT@991_6740@BUTTON_1"
msgstr "Sobrepujar a {EventUnit} para fazer <<P:EventUnit>> quebrar a barreira à força."

msgid "STORY_EVENT@991_6740@TITLE"
msgstr "Platô da Tempestade de Cristal: Runestones do Passado"

msgid "STORY_EVENT@991_6837@BODY_FOOTER"
msgstr "\"O que quer que o {GLOBAL.FireClanLoreConcept.Hyperlink} pretenda fazer com as bestas enjauladas, não pode ser bom,\" o druida conclui. \"Você as libera, todos nós ganhamos, certo?\""

msgid "STORY_EVENT@991_6837@BODY_HEADER"
msgstr "Entrando em uma caverna flamejante {EventDirection} {EventCity}, suas tropas ouvem os gritos abafados de um <<EventHero{homem/mulher}>>, desesperado para chamar sua atenção."

msgid "STORY_EVENT@991_6837@BODY_LORE"
msgstr "\"Silêncio—venha cá!\" Enquanto seu {EventStackLeader} se aproxima do <<EventHero{homem/mulher}>> vestido com roupas de druida, <<p:EventHero>> olha para <<P:EventStackLeader>> incrédulo, mas não recua. \"Veja as grandes figuras lá embaixo nas fissuras? Aqueles são capangas do {GLOBAL.FireClanLoreConcept.Hyperlink},\" <<p:EventHero>> sussurra. \"Eles capturaram as bestas da terra, importunando-as em gaiolas, brutalizando-as para combate.\" O druida morde ansiosamente <<o:EventHero>> unhas. \"Eu... não posso suportar isso mais tempo. Este mau trato deve acabar!\""

msgid "STORY_EVENT@991_6837@BODY_LORE@RULER_STACK_LEAD"
msgstr "\"Silêncio—venha cá!\" Enquanto você se aproxima do <<EventHero{homem/mulher}>> vestido com roupas de druida, <<p:EventHero>> olha para você incrédulo, mas não recua. \"Veja as grandes figuras lá embaixo nas fissuras? Aqueles são capangas do {GLOBAL.FireClanLoreConcept.Hyperlink},\" <<p:EventHero>> sussurra. \"Eles capturaram as bestas da terra, importunando-as em gaiolas, brutalizando-as para combate.\" O druida morde ansiosamente <<o:EventHero>> unhas. \"Eu... não posso suportar isso mais tempo. Este mau trato deve acabar!\""

msgid "STORY_EVENT@991_6837@BUTTON_0"
msgstr "\"Bem. Nós cuidaremos do {GLOBAL.FireClanLoreConcept.Name}.\""

msgid "STORY_EVENT@991_6837@BUTTON_1"
msgstr "\"Sinto suas tristezas. Essas pobres criaturas devem ser libertadas!\" [goodact/]"

msgid "STORY_EVENT@991_6837@BUTTON_3"
msgstr "\"Uma vez acorrentadas ao meu chicote, aquelas bestas de guerra estarão livres... para matar!\" [evilact/]"

msgid "STORY_EVENT@991_6837@TITLE"
msgstr "Descobrindo a Cicatriz Derretida"

msgid "STORY_EVENT@991_6850@BODY_FOOTER"
msgstr "O {EventStackLeader} e <<o:EventStackLeader>> lutadores do {GLOBAL.FireClanLoreConcept.Hyperlink} estão se aproximando de suas tropas. Como você ordena que seu exército os enfrente?"

msgid "STORY_EVENT@991_6850@BODY_HEADER"
msgstr "Domando cuidadosamente a {EventUnit} enjaulada, suas tropas são surpreendidas quando são cercadas pelos gritos de guerra do {GLOBAL.FireClanLoreConcept.Hyperlink}."

msgid "STORY_EVENT@991_6850@BODY_HEADER@CHAINED_CREATURE"
msgstr "Amarrando a {EventUnit} \"libertada\" com um colar acorrentado, suas tropas são surpreendidas quando são cercadas pelos gritos de guerra do {GLOBAL.FireClanLoreConcept.Hyperlink}."

msgid "STORY_EVENT@991_6850@BODY_HEADER@FREED_CREATURE"
msgstr "Observando a {EventUnit} solta escapar para o selvagem, suas tropas são surpreendidas quando são cercadas pelos gritos de guerra do {GLOBAL.FireClanLoreConcept.Hyperlink}."

msgid "STORY_EVENT@991_6850@BODY_LORE"
msgstr "Liderados por um {EventStackLeader}, os brutamontes do {GLOBAL.FireClanLoreConcept.Hyperlink} cercam seu exército, bloqueando qualquer caminho de retirada. \"Quem pensa que pode roubar do clã gigante? Liberar bestas? Quebrar correntes?\" eles gritam, mostrando seus dentes hediondos. \"Agora Hastefolk coloca na gaiola. Guinche e se contorça! Quando {EventBeastName} acordar, Hastefolk vira comida.\""

msgid "STORY_EVENT@991_6850@BODY_LORE@SECOND_EVENT"
msgstr "Os brutamontes do {GLOBAL.FireClanLoreConcept.Hyperlink} quase parecem desesperados, vendo que você frustra seus planos um por um. \"Fora, Hastefolk chato! Bestas treinadas para guerra. Quando {EventBeastName} ver, junta-se ao poderoso {GLOBAL.FireClanLoreConcept.Hyperlink}.\" Eles montam um enorme caldeirão em uma fogueira acesa às pressas. \"Hoje à noite nós comemos ensopado de Hastefolk!\""

msgid "STORY_EVENT@991_6850@BUTTON_0"
msgstr "Deixe-os enfrentar os atacantes sem dar ordens especiais."

msgid "STORY_EVENT@991_6850@BUTTON_1"
msgstr "Ordene que as tropas avancem sobre o inimigo [movementwalk/], expondo seus próprios flancos [armor/]."

msgid "STORY_EVENT@991_6850@BUTTON_2"
msgstr "Faça-os permanecer em uma formação apertada [armor/], sacrificando sua própria mobilidade [movementwalk/]."

msgid "STORY_EVENT@991_6850@BUTTON_3"
msgstr "Convoque [mana/] um corpo de água acima deles, para protegê-los [defensefire/] de ataques flamejantes."

msgid "STORY_EVENT@991_6850@TITLE"
msgstr "Cicatriz Derretida: Emboscada do {GLOBAL.FireClanLoreConcept.Name}!"

msgid "STORY_EVENT@991_6852@BODY_FOOTER"
msgstr "\"Enquanto explorava a região, descobri todas as gaiolas que o {GLOBAL.FireClanLoreConcept.Hyperlink} montou,\" {EventHero} conclui. \"Aqui, deixe-me mostrar a você...\""

msgid "STORY_EVENT@991_6852@BODY_FOOTER@CHAINED_CREATURE"
msgstr "\"Como um falante selvagem, sei que toda vida é sagrada,\" {EventHero} conclui, \"mas vendo suas ações brutais, sinto dúvida no meu coração.\""

msgid "STORY_EVENT@991_6852@BODY_HEADER"
msgstr "Enquanto suas tropas cuidam do {EventUnit} enjaulado, o druida da entrada da caverna retorna para conversar."

msgid "STORY_EVENT@991_6852@BODY_HEADER@CHAINED_CREATURE"
msgstr "Enquanto suas tropas acorrentam o {EventUnit} sombriamente, o druida da entrada da caverna retorna, cheio de amargura."

msgid "STORY_EVENT@991_6852@BODY_HEADER@FREED_CREATURE"
msgstr "Enquanto suas tropas libertam cuidadosamente o {EventUnit}, o druida da entrada da caverna retorna, transbordando de alegria."

msgid "STORY_EVENT@991_6852@BODY_LORE"
msgstr "\"É bom ver pessoas tratando seus animais com respeito\", diz <<p:EventHero>>, mostrando um sorriso. \"Eu sou {EventHero}, falante selvagem e aventureiro veterano alistado no {GLOBAL.ColtLoreConcept.Hyperlink}. Quando ouvi falar de um mapa descoberto que levaria à Cicatriz Ígnea, soube que o caminho estava traçado para mim...\""

msgid "STORY_EVENT@991_6852@BODY_LORE@CHAINED_CREATURE"
msgstr "\"Essa exibição de violência é infuriante!\" <<p:EventHero>> grita, claramente consternado. \"Eu sou {EventHero}, falante selvagem e aventureiro veterano alistado no {GLOBAL.ColtLoreConcept.Hyperlink}. Quando ouvi falar de um mapa descoberto que levaria à Cicatriz Ígnea, soube que o caminho estava traçado para mim...\""

msgid "STORY_EVENT@991_6852@BODY_LORE@FREED_CREATURE"
msgstr "\"Está claro que a bênção da natureza corre em suas veias\", diz <<p:EventHero>> com um sorriso sincero. \"Eu sou {EventHero}, falante selvagem e aventureiro veterano alistado no {GLOBAL.ColtLoreConcept.Hyperlink}. Quando ouvi falar de um mapa descoberto que levaria à Cicatriz Ígnea, soube que o caminho estava traçado para mim...\""

msgid "STORY_EVENT@991_6852@BUTTON_0"
msgstr "Descubra os locais das gaiolas restantes."

msgid "STORY_EVENT@991_6852@BUTTON_1"
msgstr "Deixe o tolo tagarelar. <<Cp:EventHero>> ainda pode ser útil."

msgid "STORY_EVENT@991_6852@TITLE"
msgstr "Cicatriz Ígnea: Uma Introdução Formal"

msgid "STORY_EVENT@991_6853@BODY_FOOTER"
msgstr "A chave de Pedra Fluente revelou a você uma {EventStructure}. Sem dúvida, é aqui que a {GLOBAL.FireClanLoreConcept.Hyperlink} e \"sua\" {EventBeastName} devem ser encontradas."

msgid "STORY_EVENT@991_6853@BODY_HEADER"
msgstr "Para a surpresa de suas tropas, não há criatura alguma na última gaiola aberta, mas sim um grande bloco de Pedra Fluente."

msgid "STORY_EVENT@991_6853@BODY_LORE"
msgstr "Quando seus soldados tocam o bloco, a Pedra Fluente se transforma na forma de uma chave enorme — sem dúvida, uma obra da antiga magia dos gigantes. A chave parece registrar seus poderes {GLOBAL.GodirLoreConcept.Hyperlink}. Ela chama por você, arrasta sua atenção para a {EventDirection} da Cicatriz Ígnea. Você vê uma ilha de masmorra em meio à lava fervente, correntes levando às profundezas mais sombrias da prisão... até ouvir o eco de um grito primordial."

msgid "STORY_EVENT@991_6853@BUTTON_0"
msgstr "Envie um de seus heróis para enfrentar os perigos da {EventStructure}."

msgid "STORY_EVENT@991_6853@TITLE"
msgstr "Cicatriz Ígnea: Visões Enjauladas"

msgid "STORY_EVENT@991_6905@BODY_FOOTER"
msgstr "\"Sinto que a {GLOBAL.FireClanLoreConcept.Hyperlink} deve saber sobre o mito de {EventBeastName}\", {EventHero} encerra <<o:EventHero>> discurso. \"Se ao menos eu... Quero dizer, a presença deles aqui não pode ser uma coincidência!\""

msgid "STORY_EVENT@991_6905@BODY_FOOTER@CHAINED_CREATURE"
msgstr "\"Se {EventBeastName} ainda estivesse por perto\", {EventHero} encerra <<o:EventHero>> discurso com alegria mórbida, \"certamente vingaria seus pecados contra a natureza.\""

msgid "STORY_EVENT@991_6905@BODY_HEADER"
msgstr "Enquanto suas tropas cuidam do {EventUnit} enjaulado, {EventHero} retorna para conversar."

msgid "STORY_EVENT@991_6905@BODY_HEADER@CHAINED_CREATURE"
msgstr "Enquanto suas tropas acorrentam o {EventUnit} sombriamente, {EventHero} retorna, cheio de amargura."

msgid "STORY_EVENT@991_6905@BODY_HEADER@FREED_CREATURE"
msgstr "Enquanto suas tropas libertam cuidadosamente o {EventUnit}, {EventHero} retorna, transbordando de alegria."

msgid "STORY_EVENT@991_6905@BODY_LORE"
msgstr "\"Para aqueles versados no folclore da terra, a Cicatriz Ígnea é um lugar lendário\", <<p:EventHero>> começa a narrar. \"Diz-se que [hyperlink,GLOBAL.UrwildernessLoreConcept]nos dias da Grande Caçada[/hyperlink], quando os [hyperlink,GLOBAL.GiantKingLoreConcept]Gigantes Ancestrais[/hyperlink] lutaram contra as Bestas Primordiais, uma {PrimordialUnit} chamada {EventBeastName} habitava esta região. Quando {EventBeastName} chocou-se com os caçadores gigantes, seus golpes poderosos dividiram a terra, derramando magma fervente das profundezas deste mundo; os abismos formados um memorial, para a eternidade.\""

msgid "STORY_EVENT@991_6905@BUTTON_0"
msgstr "Agradeça a {EventHero} por <<o:EventHero>> insights."

msgid "STORY_EVENT@991_6905@BUTTON_1"
msgstr "O momento para {EventHero} ainda não chegou... pelo menos não ainda."

msgid "STORY_EVENT@991_6905@TITLE"
msgstr "Cicatriz Ígnea: Mitos Primordiais"

msgid "STORY_EVENT@991_6921@BODY_FOOTER"
msgstr "\"Tive éons para guardar rancor\", {DruidHero} guincha, enquanto grandes olhos compostos iluminam-se na escuridão acima. \"Agora devo me alimentar, e me alimentar eu vou!\""

msgid "STORY_EVENT@991_6921@BODY_FOOTER@APE"
msgstr "\"Tive éons para guardar rancor\", {DruidHero} grita, enquanto a figura imponente de {EventBeastName} entra em foco. \"Agora devo me alimentar, e me alimentar eu vou!\""

msgid "STORY_EVENT@991_6921@BODY_FOOTER@ENTRY_BLOCKED"
msgstr "Parece não haver como atravessar a lava e entrar na {EventStructure}."

msgid "STORY_EVENT@991_6921@BODY_FOOTER@SERPENT"
msgstr "\"Tive éons para guardar rancor,\" {DruidHero} grita, enquanto o som de um corpo enorme deslizando pelas colunas pode ser ouvido de cima. \"Agora devo me alimentar, e me alimentar eu vou!\""

msgid "STORY_EVENT@991_6921@BODY_HEADER"
msgstr "Quando suas tropas chegam à beira do lago de lava, a chave Flowrock se transforma em uma lâmina fina, formando uma ponte para a {EventStructure} no meio."

msgid "STORY_EVENT@991_6921@BODY_HEADER@ENTRY_BLOCKED"
msgstr "As temperaturas estão subindo ao máximo, enquanto suas tropas chegam à beira escaldante de um lago de lava."

msgid "STORY_EVENT@991_6921@BODY_LORE"
msgstr "Uma vez dentro, o guincho sobrenatural de {EventBeastName} pode ser ouvido. Grandes corredores, transformados em túneis de teias de mariposas, levam ao salão onde o {PrimordialUnit} estava preso. Agora, as correntes celestiais estão quebradas no chão, aos pés do triunfante {GLOBAL.FireClanLoreConcept.Hyperlink}.[br/][br/]De repente, uma voz estranhamente familiar começa a falar: \"É incomum para uma presa,\" diz ela, \"vir livremente para seu próprio engolfamento. No entanto, <<p:DruidHero>> veio livremente, buscando acalmar minha fúria. QUANDO A NATUREZA NUNCA CONHECEU MAIOR IRA!\" Gritando violentamente, {DruidHero} salta das sombras, o rosto de <<o:DruidHero>> inexpressivo e os olhos de <<o:DruidHero>> cheios de <<ge:fire^n,EventBeastName>>!"

msgid "STORY_EVENT@991_6921@BODY_LORE@APE"
msgstr "Uma vez dentro, a batida do peito como um tambor de {EventBeastName} pode ser ouvida. Grandes corredores, emaranhados com lianas brotantes, levam ao salão onde o {PrimordialUnit} estava preso. Agora, as correntes celestiais estão quebradas no chão, aos pés do triunfante {GLOBAL.FireClanLoreConcept.Hyperlink}.[br/][br/]De repente, uma voz estranhamente familiar começa a falar: \"É incomum para uma presa,\" diz ela, \"vir livremente para seu próprio engolfamento. No entanto, <<p:DruidHero>> veio livremente, buscando acalmar minha fúria. QUANDO A NATUREZA NUNCA CONHECEU MAIOR IRA!\" Gritando violentamente, {DruidHero} salta das sombras, o rosto de <<o:DruidHero>> inexpressivo e os olhos de <<o:DruidHero>> cheios de <<ge:fury^n,EventBeastName>>!"

msgid "STORY_EVENT@991_6921@BODY_LORE@ENTRY_BLOCKED"
msgstr "À distância, uma grande fortaleza se ergue dentro da lava. Parece quase uma miragem, pois quem construiria uma fortaleza em um lugar tão inóspito sem ponte ou porta para entrar?"

msgid "STORY_EVENT@991_6921@BODY_LORE@NO_RULER"
msgstr "Uma vez dentro, o guincho sobrenatural de {EventBeastName} pode ser ouvido. Grandes corredores, transformados em túneis de teias de mariposas, levam ao salão onde o {PrimordialUnit} estava preso. Agora, as correntes celestiais estão quebradas no chão, aos pés do triunfante {GLOBAL.FireClanLoreConcept.Hyperlink}.[br/][br/]De repente, uma voz estranhamente familiar começa a falar: \"É incomum para uma presa,\" diz ela, \"vir livremente para seu próprio engolfamento. No entanto, <<p:DruidHero>> veio livremente, buscando acalmar minha fúria. QUANDO A NATUREZA NUNCA CONHECEU MAIOR IRA!\" Gritando violentamente, {DruidHero} salta das sombras, o rosto de <<o:DruidHero>> inexpressivo e os olhos de <<o:DruidHero>> cheios de <<ge:fire^n,EventBeastName>>!"

msgid "STORY_EVENT@991_6921@BODY_LORE@SERPENT"
msgstr "Uma vez dentro, o assobio sinistro de {EventBeastName} pode ser ouvido. Grandes corredores, repletos de pequenas serpentes, levam ao salão onde o {PrimordialUnit} estava preso. Agora, as correntes celestiais estão quebradas no chão, aos pés do triunfante {GLOBAL.FireClanLoreConcept.Hyperlink}.[br/][br/]De repente, uma voz estranhamente familiar começa a falar: \"É incomum para uma presa,\" diz ela, \"vir livremente para seu próprio engolfamento. No entanto, <<p:DruidHero>> veio livremente, buscando acalmar minha fúria. QUANDO A NATUREZA NUNCA CONHECEU MAIOR IRA!\" Gritando violentamente, {DruidHero} salta das sombras, o rosto de <<o:DruidHero>> inexpressivo e os olhos de <<o:DruidHero>> cheios de <<ge:venom^n,EventBeastName>>!"

msgid "STORY_EVENT@991_6921@BUTTON_0"
msgstr "Atacar o {GLOBAL.FireClanLoreConcept.Name}, {DruidHero} e a terrível {EventBeastName}!"

msgid "STORY_EVENT@991_6921@BUTTON_1"
msgstr "Ganhe a bênção dos Gigantes [mana/] e deixe a Grande Caçada começar novamente!"

msgid "STORY_EVENT@991_6921@BUTTON_2"
msgstr "Sair, por enquanto."

msgid "STORY_EVENT@991_6921@TITLE"
msgstr "Cicatriz Derretida: Uma Mariposa Desacorrentada"

msgid "STORY_EVENT@991_6921@TITLE@APE"
msgstr "Cicatriz Derretida: Um Macaco Desacorrentado"

msgid "STORY_EVENT@991_6921@TITLE@ENTRY_BLOCKED"
msgstr "Cicatriz Derretida: A {EventStructure}"

msgid "STORY_EVENT@991_6921@TITLE@SERPENT"
msgstr "Cicatriz Derretida: Uma Serpente Desacorrentada"

msgid "STORY_EVENT@991_6922@BODY_FOOTER"
msgstr "\"Você salvou este mundo de {EventBeastName}, {PlayerLeader},\" {DruidHero} finaliza. \"A {EventRelic} que os Gigantes invocaram para libertar a besta é sua — e meu destino está em suas mãos.\""

msgid "STORY_EVENT@991_6922@BODY_HEADER"
msgstr "Com o poderoso {EventBeastName} subjugado e devolvido às suas correntes, {DruidHero} volta a <<o:DruidHero>> sentidos novamente."

msgid "STORY_EVENT@991_6922@BODY_LORE"
msgstr "\"O que... o que eu fiz?\" <<p:DruidHero>> clama em desespero, olhando para <<o:DruidHero>> mãos, ainda ardendo com fogo primordial. \"Pensei que poderia me conectar com {EventBeastName}, corrigir o que a Grande Caçada havia afligido na criatura que eu chamava de nobre. Em vez disso, encontrei ódio ardente, incinerando minhas crenças em momentos. Eu estava indefeso. Se o {GLOBAL.FireClanLoreConcept.Hyperlink} soltasse {EventBeastName}, sua ira primordial teria devorado os reinos...\""

msgid "STORY_EVENT@991_6922@BODY_LORE@APE"
msgstr "\"O que... o que eu fiz?\" <<p:DruidHero>> clama em desespero, olhando para <<o:DruidHero>> mãos, ainda pulsando com fúria primordial. \"Pensei que poderia me conectar com {EventBeastName}, corrigir o que a Grande Caçada havia afligido na criatura que eu chamava de nobre. Em vez disso, encontrei ódio ilimitado, esmagando minhas crenças em momentos. Eu estava indefeso. Se o {GLOBAL.FireClanLoreConcept.Hyperlink} soltasse {EventBeastName}, sua ira primordial teria devorado os reinos...\""

msgid "STORY_EVENT@991_6922@BODY_LORE@SERPENT"
msgstr "\"O que... o que eu fiz?\" <<p:DruidHero>> clama em desespero, olhando para <<o:DruidHero>> mãos, ainda pingando com veneno primordial. \"Pensei que poderia me conectar com {EventBeastName}, corrigir o que a Grande Caçada havia afligido na criatura que eu chamava de nobre. Em vez disso, encontrei ódio venenoso, corrompendo minhas crenças em momentos. Eu estava indefeso. Se o {GLOBAL.FireClanLoreConcept.Hyperlink} soltasse {EventBeastName}, sua ira primordial teria devorado os reinos...\""

msgid "STORY_EVENT@991_6922@BUTTON_0"
msgstr "\"Um <<DruidHero{homem/mulher}>> com seus talentos é bem-vindo [unitHero/] em meu exército.\""

msgid "STORY_EVENT@991_6922@BUTTON_1"
msgstr "\"Sua compaixão com as criaturas da terra [natureboon/] é inspiradora. Não abandone este caminho!\" [goodact/]"

msgid "STORY_EVENT@991_6922@BUTTON_2"
msgstr "\"Eu consumirei você e os poderes [xp/] que você sugou de {EventBeastName}!\" [evilact/]"

msgid "STORY_EVENT@991_6922@BUTTON_3"
msgstr "\"Você será um ativo valioso para extorquir [gold/] o {GLOBAL.ColtLoreConcept.Name}.\""

msgid "STORY_EVENT@991_6922@BUTTON_4"
msgstr "\"Use seus poderes como um selvifalante para reforçar minhas fileiras [unit/]!\""

msgid "STORY_EVENT@991_6922@TITLE"
msgstr "Cicatriz Derretida: Consequências"

msgid "STORY_EVENT@991_6954@BODY_FOOTER"
msgstr "\"O Criador vigia estes salões,\" o {EventUnit} conclui. \"Resolva seus enigmas e você poderá esculpir sua própria recompensa. Busque derramamento de sangue, no entanto, e isso também você encontrará.\""

msgid "STORY_EVENT@991_6954@BODY_HEADER"
msgstr "Descendo escadas imaculadas esculpidas em pedra, suas tropas encontram seu caminho bloqueado por um {EventUnit}, imponente na entrada de um grande salão."

msgid "STORY_EVENT@991_6954@BODY_LORE"
msgstr "\"Parem,\" o {EventUnit} diz lentamente, <<o:EventUnit>> voz ecoando das paredes. \"Parem, estrangeiros, antes de entrarem nos sagrados salões do {GLOBAL.StoneClanLoreConcept.Hyperlink}. Aqui, ponderamos os enigmas do mundo material. Ao contrário dos outros clãs, não buscamos desavenças com os Apressados. Nós criamos.\" De fato, as câmaras que se estendem atrás do {EventUnit} não estão arruinadas como outros remanescentes do antigo {GLOBAL.MyrridaLoreConcept.Hyperlink}. Elas são construídas de novo, um monumento ao potencial bruto ainda presente nos Gigantes."

msgid "STORY_EVENT@991_6954@BUTTON_0"
msgstr "Entre no Salão dos Enigmas."

msgid "STORY_EVENT@991_6954@TITLE"
msgstr "Entrando no Salão dos Enigmas"

msgid "STORY_EVENT@991_6955@BODY_FOOTER"
msgstr "\"Por muito tempo ninguém foi digno nem mesmo de um frasco. Se eu fosse seu servo, qual seria minha tarefa?\""

msgid "STORY_EVENT@991_6955@BODY_FOOTER@ENIGMA_SOLVED"
msgstr "Você já respondeu a este enigma. Vá para as outras câmaras para continuar o julgamento."

msgid "STORY_EVENT@991_6955@BODY_HEADER"
msgstr "No centro desta câmara, uma fonte de Pedra Fluente jorra terra e pedra. À medida que suas tropas se aproximam, ela se transforma em um {EventStackLeader} e começa a falar:"

msgid "STORY_EVENT@991_6955@BODY_HEADER@ENIGMA_SOLVED"
msgstr "Suas tropas retornam ao {EventStackLeader} no centro desta câmara."

msgid "STORY_EVENT@991_6955@BODY_LORE"
msgstr "\"[hyperlink,GLOBAL.GiantKingLoreConcept]Os Gigantes[/hyperlink] me concederam tendões e ossos.[br/]Sou um líquido ou sou uma pedra?[br/]{GLOBAL.MyrridaLoreConcept.Hyperlink} Ergui salões e torres, sublime.[br/]Minhas paredes intocadas pelas devastações do tempo.[br/]Resisti ao fogo dos Dragões, resisti à ira dos Arcontes.[br/]No entanto, meus mestres se perderam em seu caminho fatídico.\""

msgid "STORY_EVENT@991_6955@BODY_LORE@ENIGMA_SOLVED"
msgstr "O {EventStackLeader} permanece em silêncio, como se <<p:EventStackLeader>> ainda estivesse ponderando as respostas que você deu."

msgid "STORY_EVENT@991_6955@BUTTON_0"
msgstr "Não responda ao {EventStackLeader} por enquanto."

msgid "STORY_EVENT@991_6955@BUTTON_0@ENIGMA_SOLVED"
msgstr "Partir."

msgid "STORY_EVENT@991_6955@BUTTON_1"
msgstr "\"Erguer-se como elementais, guerreiros invulneráveis de rocha!\""

msgid "STORY_EVENT@991_6955@BUTTON_2"
msgstr "\"Construir paredes altas e poderosas [structureprod/], o núcleo de um novo império.\""

msgid "STORY_EVENT@991_6955@BUTTON_3"
msgstr "\"Erguir monumentos [influence/] para as eras contemplarem!\""

msgid "STORY_EVENT@991_6955@BUTTON_4"
msgstr "\"Gravar a sabedoria do mundo [knowledge/] em tomos de pedra.\""

msgid "STORY_EVENT@991_6955@TITLE"
msgstr "Salão dos Enigmas: Visões da Pedra Fluente"

msgid "STORY_EVENT@991_6956@BODY_FOOTER"
msgstr "\"Fizemos tudo o que nos pediram, mas seus corações afundaram na névoa. Eles buscavam a vida e viram o fracasso. Diga: quando a vida existe?\""

msgid "STORY_EVENT@991_6956@BODY_FOOTER@ENIGMA_SOLVED"
msgstr "Você já respondeu a este enigma. Vá para as outras câmaras para continuar o julgamento."

msgid "STORY_EVENT@991_6956@BODY_HEADER"
msgstr "Nesta câmara repleta de energias cristalinas, suas tropas são recebidas por um {EventStackLeader}:"

msgid "STORY_EVENT@991_6956@BODY_HEADER@ENIGMA_SOLVED"
msgstr "Suas tropas retornam ao {EventStackLeader} no centro desta câmara."

msgid "STORY_EVENT@991_6956@BODY_LORE"
msgstr "\"Éramos gemas da terra, luminosas e altas.[br/]Os <<m:{GLOBAL.GiantKingLoreConcept.Hyperlink}>> nos mineraram e iluminaram seus salões.[br/]Nos forjaram em armas, moídos e fundidos a cada dia.[br/]Eles eram os escultores, e nós éramos o barro.[br/]Por fim, nos imbuíram de rostos e alma.[br/]Éramos maravilhosos e curiosos e estranhos a todos.\""

msgid "STORY_EVENT@991_6956@BODY_LORE@ENIGMA_SOLVED"
msgstr "O {EventStackLeader} permanece em silêncio, como se <<p:EventStackLeader>> ainda estivesse ponderando as respostas que você deu."

msgid "STORY_EVENT@991_6956@BUTTON_0"
msgstr "Não responda ao {EventStackLeader}, por enquanto."

msgid "STORY_EVENT@991_6956@BUTTON_0@ENIGMA_SOLVED"
msgstr "Sair."

msgid "STORY_EVENT@991_6956@BUTTON_1"
msgstr "\"Vivo está quem luta pela sobrevivência!\""

msgid "STORY_EVENT@991_6956@BUTTON_2"
msgstr "\"Todos os seres vivos devem se alimentar [food/] e brotar.\""

msgid "STORY_EVENT@991_6956@BUTTON_3"
msgstr "\"A vida é a faísca mágica [mana/] que acende nossas almas.\""

msgid "STORY_EVENT@991_6956@BUTTON_4"
msgstr "\"Como Godir [influence/] concedemos vida ao que desejamos.\""

msgid "STORY_EVENT@991_6956@TITLE"
msgstr "Salão dos Enigmas: Visões de Litiorita"

msgid "STORY_EVENT@991_6957@BODY_FOOTER"
msgstr "\"A essência que eles ligaram alimenta as forjas até hoje. Ainda assim, qual item é o mais digno de ser feito?\""

msgid "STORY_EVENT@991_6957@BODY_FOOTER@ENIGMA_SOLVED"
msgstr "Você já respondeu a este enigma. Vá para as outras câmaras para continuar o julgamento."

msgid "STORY_EVENT@991_6957@BODY_HEADER"
msgstr "Entre dois pilares poderosos, um {EventStackLeader} solitário aguarda suas tropas nesta câmara. Ele fala com uma voz metálica:"

msgid "STORY_EVENT@991_6957@BODY_HEADER@ENIGMA_SOLVED"
msgstr "Suas tropas retornam ao {EventStackLeader} no centro desta câmara."

msgid "STORY_EVENT@991_6957@BODY_LORE"
msgstr "\"Ricos são os elementos sob a sombra da terra.[br/]Ricos que destilam seu grau de pureza.[br/]O <<m:{GLOBAL.GiantKingLoreConcept.Hyperlink}>> presenteado como nenhum antes foi[br/]Refinado e ligado ao núcleo material.[br/]Ferreiros, magos e bigorna em um só[br/]Eles criaram maravilhas que rivalizavam com o sol.\""

msgid "STORY_EVENT@991_6957@BODY_LORE@ENIGMA_SOLVED"
msgstr "O {EventStackLeader} permanece em silêncio, como se <<p:EventStackLeader>> ainda estivesse ponderando as respostas que você deu."

msgid "STORY_EVENT@991_6957@BUTTON_0"
msgstr "Não responda ao {EventStackLeader}, por enquanto."

msgid "STORY_EVENT@991_6957@BUTTON_0@ENIGMA_SOLVED"
msgstr "Sair."

msgid "STORY_EVENT@991_6957@BUTTON_1"
msgstr "\"A espada que corta através das linhas inimigas!\""

msgid "STORY_EVENT@991_6957@BUTTON_2"
msgstr "\"O anel que liga toda [influence/] à minha vontade!\""

msgid "STORY_EVENT@991_6957@BUTTON_3"
msgstr "\"O martelo de forja [bindingessence/] que aprimora todas as futuras criações.\""

msgid "STORY_EVENT@991_6957@BUTTON_4"
msgstr "\"A esfera de vidência [mana/] que me permite vislumbrar tanto o futuro quanto o passado.\""

msgid "STORY_EVENT@991_6957@TITLE"
msgstr "Salão dos Enigmas: Visões de Ligação"

msgid "STORY_EVENT@991_6989@BODY_FOOTER"
msgstr "O {EventStackLeader} começa a falar: \"Eu observei, {PlayerLeader}. Eu conheço suas convicções.\""

msgid "STORY_EVENT@991_6989@BODY_HEADER"
msgstr "Enquanto suas tropas retornam à câmara central, energias imóveis pesam sobre você como uma montanha, ameaçando esmagar lentamente todos os seus sentidos."

msgid "STORY_EVENT@991_6989@BODY_LORE"
msgstr "Apesar dessa pressão fundamental, você se sente revigorado, inspirado a criar, construir, moldar o que nenhum {GLOBAL.GodirLoreConcept.Hyperlink} concebeu antes...! Então você percebe a entidade observando você, dando a si mesma a aparência de um {EventStackLeader}. No entanto, você instintivamente sabe que sua verdadeira forma é muito maior. Intransponível. Abrangendo o cosmos. Este Criador adorado pelo {GLOBAL.StoneClanLoreConcept.Hyperlink}, poderia ser o {GLOBAL.EndailonLoreConcept.Hyperlink} do Materium?"

msgid "STORY_EVENT@991_6989@BUTTON_0"
msgstr "Fuja do alcance do Criador."

msgid "STORY_EVENT@991_6989@BUTTON_1"
msgstr "\"Eu sou o terremoto que destrói o mundo.\""

msgid "STORY_EVENT@991_6989@BUTTON_2"
msgstr "\"Eu sou o construtor [structureprod/], erguendo cidades e muros.\""

msgid "STORY_EVENT@991_6989@BUTTON_3"
msgstr "\"Eu sou o artesão [influence/] que aperfeiçoa seu trabalho.\""

msgid "STORY_EVENT@991_6989@BUTTON_4"
msgstr "\"Eu sou o arquiteto [knowledge/] de civilizações para durar.\""

msgid "STORY_EVENT@991_6989@TITLE"
msgstr "Salão dos Enigmas: Visões do Criador"

msgid "STORY_EVENT@991_7003@BODY_FOOTER"
msgstr "\"Você ganhou a posse destes salões, {PlayerLeader},\" o Criador termina enquanto sua presença desaparece. \"Aceite o {EventRelic}. O {GLOBAL.StoneClanLoreConcept.Hyperlink} é um diamante bruto. Refine ou venda—eu observo.\""

msgid "STORY_EVENT@991_7003@BODY_HEADER"
msgstr "O {EventStackLeader} concorda. \"A criação constante é a virtude material mais pura. No entanto, sem foco, o criador pode se imurar dentro de um labirinto.\""

msgid "STORY_EVENT@991_7003@BODY_HEADER@AMBITION"
msgstr "O {EventStackLeader} concorda. \"A imaculabilidade é o ideal da criação. Tais ambições podem levar à eternidade—ou ao vazio de uma tarefa inacabável.\""

msgid "STORY_EVENT@991_7003@BODY_HEADER@DEVASTATION"
msgstr "O {EventStackLeader} concorda. \"A destruição abre caminho para a criação. Da devastação, novas civilizações podem nascer—ou tudo pode virar pó.\""

msgid "STORY_EVENT@991_7003@BODY_HEADER@WISDOM"
msgstr "O {EventStackLeader} concorda. \"Apenas o conhecedor dos elementos pode empregá-los com o maior efeito. A menos que o conhecimento acumule pó dentro de um tomo nunca posto em prática.\""

msgid "STORY_EVENT@991_7003@BODY_LORE"
msgstr "\"Os <<m:{GLOBAL.GiantKingLoreConcept.Hyperlink}>> foram favorecidos além de comparação,\" o Criador continua. \"Eles moldaram os reinos, domaram o {GLOBAL.UrwildernessLoreConcept.Hyperlink}, defenderam os elementos através da força e da arte. Seu reino, {GLOBAL.MyrridaLoreConcept.Hyperlink}, avivou as chamas da civilização e seu conhecimento cósmico desafiou até mesmo os {GLOBAL.ArchonsLoreConcept.Hyperlink}.\" A entidade suspira como uma montanha durante uma noite tempestuosa. \"Eles abandonaram o caminho da criação. Embora tenham durado mais que qualquer um antes ou depois.\""

msgid "STORY_EVENT@991_7003@BUTTON_0"
msgstr "Aceite o dom da devastação. [unit/]"

msgid "STORY_EVENT@991_7003@BUTTON_3"
msgstr "Aceite o dom da ambição. [mine/][quarry/][conduit/]"

msgid "STORY_EVENT@991_7003@BUTTON_4"
msgstr "Aceite o dom da criação. [bindingessence/]"

msgid "STORY_EVENT@991_7003@BUTTON_5"
msgstr "Aceite o dom da sabedoria. [knowledge/]"

msgid "STORY_EVENT@991_7003@TITLE"
msgstr "Salão dos Enigmas: Consequências"

msgid "STORY_EVENT@991_7028@BODY_FOOTER"
msgstr "O {GLOBAL.StormClanLoreConcept.Hyperlink}, {GLOBAL.FireClanLoreConcept.Hyperlink} e {GLOBAL.StoneClanLoreConcept.Hyperlink} o consideram como aquele que cumprirá a Lenda de Thagnokar e liderará seus clãs em uma guerra contra o reino. Você aceita a lealdade deles?"

msgid "STORY_EVENT@991_7028@BODY_HEADER"
msgstr "Estudando as inscrições nos Menires Myrridanos que você possui, você é interrompido por uma delegação dos três principais clãs de Gigantes."

msgid "STORY_EVENT@991_7028@BODY_LORE"
msgstr "O {StoneGiant} começa a falar: \"Por muito tempo, esperamos pela vinda de alguém, como Thagnokar, o Duradouro, que caiu na defesa do Círculo do Titã.\"[br/][br/]\"Alguém, que invoca a tempestade que quebra os tronos de todos os Hastefolk,\" o {StormGiant} continua, \"e talha a pedra angular de um novo {GLOBAL.MyrridaLoreConcept.Hyperlink}.\"[br/][br/]\"Você arrebatou o {FireRelic}, {StormRelic} e {StoneRelic} de nossos clãs, {PlayerLeader.TitleName},\" o {FireGiant} conclui. \"Você é a chama que pode nos forjar em um só. Se apenas você acender a faísca...\""

msgid "STORY_EVENT@991_7028@BUTTON_0"
msgstr "\"O reinado dos parentes Gigantes será restaurado!\""

msgid "STORY_EVENT@991_7028@BUTTON_1"
msgstr "\"Eu não posso liderá-los na guerra. Mas posso conceder a seus parentes santuário dentro do meu reino.\""

msgid "STORY_EVENT@991_7028@BUTTON_2"
msgstr "\"Myrrida foi construída sobre paz e igualdade, não derramamento de sangue e massacre!\" [influence/][goodact/]"

msgid "STORY_EVENT@991_7028@TITLE"
msgstr "Herdeiro de Thagnokar: Introdução"

msgid "STORY_EVENT@991_7040@BODY_FOOTER"
msgstr "Os Clãs de Gigantes estão planejando um ataque aos impérios deste reino. Como você deseja se preparar para o assalto deles?"

msgid "STORY_EVENT@991_7040@BODY_HEADER"
msgstr "Rumores alarmantes estão chegando ao seu império, falando de exércitos de Gigantes se reunindo em todo o reino."

msgid "STORY_EVENT@991_7040@BODY_LORE"
msgstr "De fato, a terra tem tremido levemente e as nuvens escurecido com trovões, instilando medo não apenas no povo do seu próprio império. Em todos os lugares, a palavra está se espalhando de que os diferentes Clãs Gigantes estão invocando o nome do Herdeiro de Thagnokar, um líder que surgiu para unir seus clãs e devolvê-los ao seu lugar de direito acima de todas as raças menores."

msgid "STORY_EVENT@991_7040@BUTTON_0"
msgstr "Conecte-se com a terra [mana/] para discernir seus movimentos sob a terra."

msgid "STORY_EVENT@991_7040@BUTTON_1"
msgstr "Envie arautos [influence/] para reunir qualquer um disposto a defender [unitprod/] seus lares."

msgid "STORY_EVENT@991_7040@BUTTON_2"
msgstr "\"Estamos bem preparados para enfrentar qualquer inimigo. Seja Demônio, Dragão ou Gigante.\""

msgid "STORY_EVENT@991_7040@TITLE"
msgstr "Herdeiro de Thagnokar: Trovão Rugidor"

msgid "STORY_EVENT@991_7042@BODY_FOOTER"
msgstr "Os Gigantes e suas tropas monstruosas estão marchando em direção a {EventCity}, determinados a arrasá-la até o chão."

msgid "STORY_EVENT@991_7042@BODY_HEADER"
msgstr "Tremores anunciam a invasão do exército {EventClan}, seu líder, o temido {EventHero}, pairando acima da {EventGeo} {EventDirection} {EventCity}."

msgid "STORY_EVENT@991_7042@BODY_LORE"
msgstr "Mesmo de uma grande distância, os gritos de {EventHero} podem ser ouvidos: \"A Era do Hastefolk chegou ao seu fim abrupto,\" <<p:EventHero>> declara, balançando <<o:EventHero>> {EventItem}. \"Pois o Herdeiro de Thagnokar, {EventPlayer.TitleName}, uniu nossa parentela novamente. Agora, reclamamos nosso lugar de direito como governantes deste reino!\""

msgid "STORY_EVENT@991_7042@BUTTON_0"
msgstr "\"{EventPlayer} pagará por isso com o tempo!\""

msgid "STORY_EVENT@991_7042@TITLE"
msgstr "Herdeiro de Thagnokar: Ataque a {EventCity}"

msgid "STORY_EVENT@991_7060@BODY_FOOTER"
msgstr "\"Fui escolhido para ser seu general nesta guerra que acaba com todas, {PlayerLeader.TitleName},\" {EventHero} conclui. \"Qual exército de clã você deseja que eu comande?\""

msgid "STORY_EVENT@991_7060@BODY_HEADER"
msgstr "Tremores anunciam as invasões dos Clãs Gigantes por todo o reino. Um de seus líderes, {EventHero}, aproxima-se orgulhosamente de você."

msgid "STORY_EVENT@991_7060@BODY_LORE"
msgstr "\"Então começa, Herdeiro de Thagnokar!\" <<p:EventHero>> diz, apontando para uma distância invisível para você. \"Nós levantamos exércitos dignos até mesmo do mais poderoso {GLOBAL.GiantKingLoreConcept.Hyperlink}. Muralhas serão violadas; tronos serão destruídos; e nossa parentela surgirá como senhores das cinzas!\""

msgid "STORY_EVENT@991_7060@BUTTON_0"
msgstr "\"Lidere a legião flamejante [unit/] do {GLOBAL.FireClanLoreConcept.Name}!\""

msgid "STORY_EVENT@991_7060@BUTTON_2"
msgstr "\"Campo as tropas robustas [unit/] do {GLOBAL.StoneClanLoreConcept.Name}!\""

msgid "STORY_EVENT@991_7060@BUTTON_3"
msgstr "\"Comande as hordas tempestuosas [unit/] desatadas pelo {GLOBAL.StormClanLoreConcept.Name}!\""

msgid "STORY_EVENT@991_7060@TITLE"
msgstr "Herdeiro de Thagnokar: Os Clãs Desatados"

msgid "STORY_EVENT@991_7065@BODY_FOOTER"
msgstr "O campo de batalha está repleto de corpos e equipamentos do {EventClan}. O que você ordena que suas tropas recuperem em seu nome?"

msgid "STORY_EVENT@991_7065@BODY_HEADER"
msgstr "Você derrotou o {EventClan} e salvou {EventCity}!"

msgid "STORY_EVENT@991_7065@BODY_HEADER@CITY_RAZED"
msgstr "Você derrotou o {EventClan}, embora seu império lamentará por muito tempo a destruição de {EventCity}."

msgid "STORY_EVENT@991_7065@BODY_LORE"
msgstr "Os corpos colossais dos Gigantes e a terra revolvida ainda dão testemunho do choque momentâneo com as forças primais do {EventClan}. Eles buscaram glória e destruição e a alcançaram—torcidos pelo destino em sua própria ruína. Por muitas gerações, os {EventRace} lembrarão deste dia em que os Gigantes foram derrubados em suas portas."

msgid "STORY_EVENT@991_7065@BUTTON_0"
msgstr "\"As armas e armaduras para refundir [bindingessence/] nas forjas.\""

msgid "STORY_EVENT@991_7065@BUTTON_2"
msgstr "\"Os adornos primitivos de ouro [gold/] e de pedras preciosas.\""

msgid "STORY_EVENT@991_7065@BUTTON_3"
msgstr "\"Os enfeites encantados [item/], uma recompensa considerável para meus heróis.\""

msgid "STORY_EVENT@991_7065@BUTTON_4"
msgstr "\"Deixar suas almas [souls/] intocadas seria uma misericórdia mal colocada...\""

msgid "STORY_EVENT@991_7065@TITLE"
msgstr "Herdeiro de Thagnokar: Gigantes em Ruínas"

msgid "STORY_EVENT@991_7111@BODY_FOOTER"
msgstr "Você enfrentará o {EventStackLeader} para recuperar o {EventArtifact} para a Morada de Cristal?"

msgid "STORY_EVENT@991_7111@BODY_HEADER"
msgstr "Os {GLOBAL.EternalSagesLoreConcept.Hyperlink} se aproximam de você com um pedido."

msgid "STORY_EVENT@991_7111@BODY_LORE"
msgstr "\"Nós mantivemos registros por muito tempo de uma relíquia chamada {EventArtifact}. Finalmente, descobrimos a localização de <<o:EventArtifact>> na {EventGeo} {EventDirection} {EventCity},\" eles dizem a você em uma voz monótona. \"Desejamos estudar o {EventArtifact} e guardá-lo em nossas vastas bibliotecas cristalinas. No entanto, <<p:EventArtifact>> é defendido por um {EventStackLeader} e seu exército.\""

msgid "STORY_EVENT@991_7111@BUTTON_0"
msgstr "\"Eu conquistarei essa relíquia para vocês.\""

msgid "STORY_EVENT@991_7111@TITLE"
msgstr "Recuperando o {EventArtifact}"

msgid "STORY_EVENT@991_7112@BODY_FOOTER"
msgstr "Os {GLOBAL.EternalSagesLoreConcept.Hyperlink} estão ansiosos para estudar o {EventArtifact}. Você completará sua missão e o devolverá?"

msgid "STORY_EVENT@991_7112@BODY_HEADER"
msgstr "Você arrebatou o {EventArtifact} do {EventStackLeader}."

msgid "STORY_EVENT@991_7112@BODY_LORE"
msgstr "Os {GLOBAL.EternalSagesLoreConcept.Name} já espiaram seu triunfo, entrando em contato com você de longe. \"Você fez bem, {PlayerLeader.Title},\" seu emissário fala com você. \"Finalmente podemos saciar nossa curiosidade e aprender tudo o que há para saber sobre o {EventArtifact}.\""

msgid "STORY_EVENT@991_7112@BUTTON_0"
msgstr "Dê o {EventArtifact} aos {GLOBAL.EternalSagesLoreConcept.Name}. [allegiance/]"

msgid "STORY_EVENT@991_7112@BUTTON_1"
msgstr "Mantenha o {EventArtifact} para você mesmo, irritando os {GLOBAL.EternalSagesLoreConcept.Name}."

msgid "STORY_EVENT@991_7112@TITLE"
msgstr "Recuperando o {EventArtifact}: Consequências"

msgid "STORY_EVENT@991_7202@BODY_FOOTER"
msgstr "\"Como não podemos deixar {EventHouse}, você possui o poder de recuperar o que não podemos obter nós mesmos,\" os {GLOBAL.EternalSagesLoreConcept.Hyperlink} concluem. \"Você nos emprestará sua ajuda nesta busca por sabedoria?\""

msgid "STORY_EVENT@991_7202@BODY_HEADER"
msgstr "Os {GLOBAL.EternalSagesLoreConcept.Hyperlink} cumprimentam você de dentro de sua biblioteca cristalina em {EventHouse}."

msgid "STORY_EVENT@991_7202@BODY_LORE"
msgstr "\"Bem-vindo, {PlayerLeader.TitleName},\" o {EventHouseLord} murmura. \"Previmos seu interesse em nos ajudar. Curiosidade e ambição definem a maioria dos {GLOBAL.GodirLoreConcept.Hyperlink}, o que faz de você aliados valiosos em nossa busca por conhecimento. Nós cronologizamos e coletamos tudo o que há para saber sobre o cosmos.\""

msgid "STORY_EVENT@991_7202@BUTTON_0"
msgstr "Peça aos {GLOBAL.EternalSagesLoreConcept.Name} uma missão."

msgid "STORY_EVENT@991_7202@BUTTON_1"
msgstr "Peça aos {GLOBAL.EternalSagesLoreConcept.Name} uma missão desafiadora."

msgid "STORY_EVENT@991_7202@BUTTON_2"
msgstr "Deixe os {GLOBAL.EternalSagesLoreConcept.Name} com seus estudos por enquanto."

msgid "STORY_EVENT@991_7202@BUTTON_3"
msgstr "Pague [mana/] aos {GLOBAL.EternalSagesLoreConcept.Name} para revelar um local de interesse especial."

msgid "STORY_EVENT@991_7202@BUTTON_4"
msgstr "Compartilhe suas percepções como um {EventPlayerType} [knowledge/] com os {GLOBAL.EternalSagesLoreConcept.Name}."

msgid "STORY_EVENT@991_7202@BUTTON_5"
msgstr "Ofereça seu {EventItem} [item/] para os {GLOBAL.EternalSagesLoreConcept.Name} estudarem."

msgid "STORY_EVENT@991_7202@TITLE"
msgstr "Sede Eterna por Conhecimento"

msgid "STORY_EVENT@991_7233@BODY_FOOTER"
msgstr "\"Para capturar o {EventStackLeader}, você deve usar esta cápsula de Litiorita. Ela selará a criatura dentro de um cristal, pronta para nossos estudos.\""

msgid "STORY_EVENT@991_7233@BODY_HEADER"
msgstr "Os {GLOBAL.EternalSagesLoreConcept.Hyperlink} se aproximam de você com um pedido."

msgid "STORY_EVENT@991_7233@BODY_LORE"
msgstr "\"Temos interesse em estudar e preservar os diferentes espécimes que crescem em cada mundo,\" eles explicam a você. \"Entre as criaturas que ainda desejamos coletar está o {EventStackLeader}. Aprendemos sobre um {EventStackLeader} na {EventGeo} {EventDirection} {EventCity}.\""

msgid "STORY_EVENT@991_7233@BUTTON_0"
msgstr "\"Eu voltarei com o {EventStackLeader}.\""

msgid "STORY_EVENT@991_7233@TITLE"
msgstr "Capturando <<m:{EventStackLeader}>>"

msgid "STORY_EVENT@991_7234@BODY_FOOTER"
msgstr "Os {GLOBAL.EternalSagesLoreConcept.Hyperlink} estão ansiosos para estudar o {EventStackLeader}. Você completará sua missão e o retornará?"

msgid "STORY_EVENT@991_7234@BODY_HEADER"
msgstr "Você encapsulou o {EventStackLeader} dentro de um grande cristal de Litiorita."

msgid "STORY_EVENT@991_7234@BODY_LORE"
msgstr "Os {GLOBAL.EternalSagesLoreConcept.Name} já espiaram seu triunfo, entrando em contato com você de longe. \"Você fez bem, {PlayerLeader.Title},\" seu emissário fala com você. \"Finalmente podemos saciar nossa curiosidade e aprender o que há para saber sobre o {EventStackLeader}.\""

msgid "STORY_EVENT@991_7234@BUTTON_0"
msgstr "Ofereça o {EventStackLeader} aos {GLOBAL.EternalSagesLoreConcept.Name} [allegiance/]."

msgid "STORY_EVENT@991_7234@BUTTON_1"
msgstr "Domine o {EventStackLeader} para você [unit/], irritando os {GLOBAL.EternalSagesLoreConcept.Name}."

msgid "STORY_EVENT@991_7234@TITLE"
msgstr "Capturando <<m:{EventStackLeader}>>: Consequências"

msgid "STORY_EVENT@991_7573@BODY_FOOTER"
msgstr "\"Pise neste local de escavação por sua própria conta e risco e observe o <<m:EventUnit>>\", {EventHero} conclui. \"Esta rocha requer algumas bombas grandes para quebrar.\""

msgid "STORY_EVENT@991_7573@BODY_HEADER"
msgstr "Adentrando as profundezas {EventDirection} {EventCity}, suas tropas são surpreendidas por explosões ecoantes e o som de picaretas agitadas."

msgid "STORY_EVENT@991_7573@BODY_LORE"
msgstr "\"Cuidado, por lá!\" alguém grita, e emergindo de um grupo de trabalhadores, um <<EventHero{homem/mulher}>> ricamente vestido se planta <<r:EventHero>> diante de suas tropas. \"{EventHero} do {GLOBAL.ColtLoreConcept.Hyperlink},\" <<p:EventHero>> se apresenta <<r:EventHero>>. \"Estamos escavando as ruínas de uma cidade enterrada do antigo reino de {GLOBAL.MyrridaLoreConcept.Hyperlink}. Nossos aventureiros estão bem equipados para lidar com quaisquer perigos que possamos encontrar. No entanto —\" <<p:EventHero>> observa suas tropas uma por uma \"— contratados capazes são sempre bem-vindos. Por uma parte justa dos despojos.\""

msgid "STORY_EVENT@991_7573@BUTTON_0"
msgstr "Entre na área de escavação."

msgid "STORY_EVENT@991_7573@BUTTON_4"
msgstr "Use a oportunidade para recrutar [gold/] alguns trabalhadores [structureprod/] para {PlayerCity}."

msgid "STORY_EVENT@991_7573@BUTTON_5"
msgstr "Pergunte a {EventHero} sobre o famoso equipamento de aventureiro [item/] vendido [gold/] pelos {GLOBAL.ColtLoreConcept.Name}."

msgid "STORY_EVENT@991_7573@TITLE"
msgstr "Entrando nas Câmaras de Brilho Profundo"

msgid "STORY_EVENT@991_7588@BODY_FOOTER"
msgstr "As aranhas e seu {EventStructure} representam uma grave ameaça a qualquer um que tente se aprofundar nas ruínas."

msgid "STORY_EVENT@991_7588@BODY_HEADER"
msgstr "Cavando através da terra, suas tropas se encontram em uma câmara coberta por teias de aranha grossas."

msgid "STORY_EVENT@991_7588@BODY_LORE"
msgstr "Ruídos de assobios ecoam na escuridão, enquanto silhuetas de muitas pernas se escondem sem movimento, aguardando a chegada de novas presas. No centro da câmara, onde a teia é mais densa, suas tropas acreditam ter avistado um {EventStackLeader}, provavelmente a rainha dessa infestação."

msgid "STORY_EVENT@991_7588@BUTTON_0"
msgstr "Prepare-se para eliminar o {EventStructure}."

msgid "STORY_EVENT@991_7588@TITLE"
msgstr "Câmaras de Brilho Profundo: Pesadelos Aracnídeos"

msgid "STORY_EVENT@991_7595@BODY_FOOTER"
msgstr "A masmorra está cheia de armadilhas e defensores imortais. Parece claro que o que está além deve ter sido de grande valor..."

msgid "STORY_EVENT@991_7595@BODY_HEADER"
msgstr "Rompendo um monte, suas tropas alcançam uma área de masmorra bem preservada."

msgid "STORY_EVENT@991_7595@BODY_LORE"
msgstr "Construída de forma magistral, esta câmara resistiu aos tempos sem danos. Sem dúvida, seu propósito era negar passagem para as câmaras mais preciosas da cidade — e erradicar qualquer um que ousasse intruir. Armadilhas mortais de masmorra pendem em pilares e paredes como um claro aviso, com mais provavelmente escondidas ao longo do caminho. <<m:EventStackLeader>> pode ser avistado à distância, patrulhando incansavelmente os pisos pavimentados, enquanto armas animadas se escondem nas sombras."

msgid "STORY_EVENT@991_7595@BUTTON_0"
msgstr "\"Nós vamos derrubar essas defesas da masmorra!\""

msgid "STORY_EVENT@991_7595@TITLE"
msgstr "Câmaras de Brilho Profundo: Explorando a Masmorra"

msgid "STORY_EVENT@991_7603@BODY_FOOTER"
msgstr "Enquanto suas tropas ainda maravilham-se com {EventStructure}, uma série de explosões ensurdecedoras rompe a câmara que os {GLOBAL.ColtLoreConcept.Hyperlink} forçaram passagem do outro lado!"

msgid "STORY_EVENT@991_7603@BODY_HEADER"
msgstr "Gastando picareta após picareta, suas tropas cavam seu caminho através do solo eternamente congelado até alcançarem uma nova câmara, finalmente."

msgid "STORY_EVENT@991_7603@BODY_LORE"
msgstr "Brilhando em um raro feixe de luz solar refratada que cai através de camadas infinitas de gelo no teto, {EventStructure} ergue-se no centro desta última câmara. Construída a partir de mármore de rocha fluida imaculada, do tipo que apenas os <<m:{GLOBAL.GiantKingLoreConcept.Hyperlink}>> de antigamente poderiam esculpir, {EventStructure} é um símbolo de poder avassalador e artesanato sem igual."

msgid "STORY_EVENT@991_7603@BUTTON_0"
msgstr "Que todos se apressem para alcançar {EventStructure}!"

msgid "STORY_EVENT@991_7603@TITLE"
msgstr "Câmaras de Brilho Profundo: {EventStructure}"

msgid "STORY_EVENT@991_7613@BODY_FOOTER"
msgstr "Os {GLOBAL.ColtLoreConcept.Hyperlink} traíram seu acordo e reivindicam {EventStructure} para si."

msgid "STORY_EVENT@991_7613@BODY_HEADER"
msgstr "Ao chegar aos grandes portões de {EventStructure}, {EventHero} encontra o complexo da estrutura já repleto de aventureiros saqueadores."

msgid "STORY_EVENT@991_7613@BODY_HEADER@HERO_IS_RULER"
msgstr "Ao chegar aos grandes portões de {EventStructure}, você encontra o complexo da estrutura já repleto de aventureiros saqueadores."

msgid "STORY_EVENT@991_7613@BODY_LORE"
msgstr "\"Abandonem as instalações!\" A voz familiar de {ColtHero} pode ser ouvida gritando de longe. \"Este sítio arqueológico foi encontrado e registrado pelos {GLOBAL.ColtLoreConcept.Hyperlink}. Somos os legítimos proprietários desta área e usaremos a força para defender nossa nova propriedade, se necessário.\" Um vislumbre da sala do trono, de fato, revela armas empunhadas e rostos sombrios escondidos atrás de barricadas montadas às pressas."

msgid "STORY_EVENT@991_7613@BUTTON_0"
msgstr "\"Eles devem pagar por esta insolência. Ataquem!\""

msgid "STORY_EVENT@991_7613@BUTTON_1"
msgstr "Crie seu próprio [production/] <<m:{GLOBAL.UNITS.DEVASTATOR_SPHERE_UNIT}>> em {EventCity} para explodir suas barricadas."

msgid "STORY_EVENT@991_7613@BUTTON_2"
msgstr "Fujam."

msgid "STORY_EVENT@991_7613@TITLE"
msgstr "Câmaras de Brilho Profundo: Uma Companhia de Ladrões"

msgid "STORY_EVENT@991_7614@BODY_FOOTER"
msgstr "Você defendeu sua reivindicação sobre as Câmaras de Brilho Profundo. Tomando a {EventRelic}, o destino do patético {ColtHero} permanece seu para decidir."

msgid "STORY_EVENT@991_7614@BODY_HEADER"
msgstr "Assim que o último dos aventureiros de <<o:ColtHero>> é abatido por suas tropas, {ColtHero} revela <<o:ColtHero>> posição de esconderijo, levantando ambas as mãos em rendição."

msgid "STORY_EVENT@991_7614@BODY_LORE"
msgstr "\"Eu desisto!\" <<p:ColtHero>> grita em terror mortal, segurando um cofre forte ornamentado. \"Aqui, pegue isto! Eu sou rico. Eu sou de grande valor para os {GLOBAL.ColtLoreConcept.Hyperlink}... quando vivo, eu lhe asseguro!\" {ColtHero} lentamente recupera <<o:ColtHero>> compostura, abrindo o cofre forte. \"Contemplem, a {EventRelic}, a joia deste tesouro do Rei Gigante—um presente digno para um {PlayerLeader.Title}, não é?\""

msgid "STORY_EVENT@991_7614@BUTTON_10"
msgstr "Interrogue {ColtHero} para saber tudo sobre <<o:ColtHero>> equipamento acumulado escondido. [item/]"

msgid "STORY_EVENT@991_7614@BUTTON_11"
msgstr "Envie {ColtHero} como um presente [allegiance/] para os {GLOBAL.EternalSagesLoreConcept.Name}, para que eles possam recuperar segredos Myrridan saqueados pelos {GLOBAL.ColtLoreConcept.Name}."

msgid "STORY_EVENT@991_7614@BUTTON_3"
msgstr "Negocie um resgate [gold/] com os {GLOBAL.ColtLoreConcept.Name}."

msgid "STORY_EVENT@991_7614@BUTTON_9"
msgstr "Condene {ColtHero} e exponha [influence/] as práticas sombrias dos {GLOBAL.ColtLoreConcept.Name}."

msgid "STORY_EVENT@991_7614@TITLE"
msgstr "Câmaras de Brilho Profundo: Consequências"

msgid "STORY_EVENT@991_7615@BODY_FOOTER"
msgstr "A terra treme violentamente enquanto o <<m:EventUnit>> explode um túnel em direção à Primeira Câmara."

msgid "STORY_EVENT@991_7615@BODY_FOOTER@SECOND_TUNNEL"
msgstr "A terra treme violentamente enquanto o <<m:EventUnit>> explode um túnel em direção à Segunda Câmara."

msgid "STORY_EVENT@991_7615@BODY_FOOTER@THIRD_TUNNEL"
msgstr "A terra treme violentamente enquanto o <<m:EventUnit>> explode um túnel em direção à Terceira Câmara."

msgid "STORY_EVENT@991_7615@BODY_HEADER"
msgstr "Assim que a conversa com {EventHero} termina, avisos do extremo distante da caverna dão notícia da preparação do <<m:EventUnit>> para detonar."

msgid "STORY_EVENT@991_7615@BODY_HEADER@SECOND_TUNNEL"
msgstr "Com as aranhas exterminadas, os {GLOBAL.ColtLoreConcept.Hyperlink} estão queimando todas as teias, abrindo o caminho para seu <<m:EventUnit>>."

msgid "STORY_EVENT@991_7615@BODY_HEADER@THIRD_TUNNEL"
msgstr "Com os defensores da masmorra destruídos, os {GLOBAL.ColtLoreConcept.Hyperlink} desarmam cuidadosamente a maioria das armadilhas restantes, abrindo o caminho para seu <<m:EventUnit>>."

msgid "STORY_EVENT@991_7615@BODY_LORE"
msgstr "\"Acenda os fusíveis[br/]Espere alguns hematomas[br/]Eles construíram esses salões em séculos passados[br/]Nós os derrubamos, em um instante explosivo[br/]3... 2... 1...[br/]BOOM!\""

msgid "STORY_EVENT@991_7615@BUTTON_0"
msgstr "Hora de fazer alguma escavação!"

msgid "STORY_EVENT@991_7615@TITLE"
msgstr "Câmaras de Brilho Profundo: Escavação Devastadora"

msgid "STORY_EVENT@991_7681@BODY_FOOTER"
msgstr "\"A progênie draconiana, sempre invejosa do trabalho dos Gigantes, invadiu este jardim\", diz o {EventUnit}. \"Extermine-os. Arranque esta erva daninha antes que ela possa se espalhar!\""

msgid "STORY_EVENT@991_7681@BODY_HEADER"
msgstr "Olhando para a enorme e antiga colunata que circunda uma montanha de pico preto, suas tropas são surpreendidas por uma voz trovejante."

msgid "STORY_EVENT@991_7681@BODY_LORE"
msgstr "\"Que você entre em paz!\" O comando ecoa da montanha enquanto um grande {EventUnit} emerge entre os pilares. \"Pois os alicerces deste jardim datam dos tempos da abençoada {GLOBAL.MyrridaLoreConcept.Hyperlink}, e eu não permitirei que seja destruído.\" O {EventUnit} abaixa <<o:EventUnit>> cajado, abrigando um ninho de pássaro. \"Embora a paz que por tanto tempo trouxe esteja novamente em perigo.\""

msgid "STORY_EVENT@991_7681@BUTTON_0"
msgstr "Pergunte ao {EventUnit} sobre a localização dessas criaturas draconianas."

msgid "STORY_EVENT@991_7681@BUTTON_DRAGON"
msgstr "\"Eu reavererei esta 'progênie', gigante insignificante, para ajudá-lo em sua miséria.\""

msgid "STORY_EVENT@991_7681@TITLE"
msgstr "Entrando no Jardim da Colunata"

msgid "STORY_EVENT@991_7684@BODY_FOOTER"
msgstr "O {EventUnit} colhe um fruto de um ramo do manto emaranhado de <<o:EventUnit>>. \"Minha magia preservou esta progênie por eras. Venha, prove a glória de {GLOBAL.MyrridaLoreConcept.Hyperlink}!\""

msgid "STORY_EVENT@991_7684@BODY_HEADER"
msgstr "Enquanto suas tropas derrotam as criaturas draconianas uma por uma, o {EventUnit} retorna, pensativo."

msgid "STORY_EVENT@991_7684@BODY_LORE"
msgstr "\"Estes ramos testemunharam o amadurecimento dos frutos da paz, estas raízes provaram o vinho da vida sem fardos\", diz <<p:EventUnit>> lentamente, tocando a mais antiga das árvores. \"Dentro das grandes cidades de {GLOBAL.MyrridaLoreConcept.Hyperlink}, o povo pequeno encontrou prosperidade e abrigo. Nunca mais as colheitas foram tão fartas, os campos tão irênicos.\""

msgid "STORY_EVENT@991_7684@BUTTON_0"
msgstr "Envie o fruto para {EventCity} para nutrir [food/] a população."

msgid "STORY_EVENT@991_7684@BUTTON_4"
msgstr "Coma o fruto [xp/]."

msgid "STORY_EVENT@991_7684@BUTTON_5"
msgstr "Divida o fruto para que ele possa fortalecer [xp/] suas tropas."

msgid "STORY_EVENT@991_7684@BUTTON_6"
msgstr "Imole o fruto em uma fogueira. [chaosboon/]"

msgid "STORY_EVENT@991_7684@TITLE"
msgstr "Jardim da Colunata: Passado Exuberante"

msgid "STORY_EVENT@991_7686@BODY_FOOTER"
msgstr "\"O Dragão que devastou esta cidade era chamado de {EventDragonName}\", diz o {EventUnit} em <<o:EventUnit>> discurso doloroso. \"Mas eu chamo <<P:{EventDragonName}>> de Calamidade.\""

msgid "STORY_EVENT@991_7686@BODY_HEADER"
msgstr "Com satisfação crescente, o {EventUnit} observa suas tropas matarem as criaturas draconianas."

msgid "STORY_EVENT@991_7686@BODY_LORE"
msgstr "\"Eles eram chamados de aliados dos {GLOBAL.ArchonsLoreConcept.Hyperlink}, lutando por justiça e ordem\", rosna o {EventUnit}. \"Mas os {GLOBAL.DragonsLoreConcept.Hyperlink} desceram sobre {GLOBAL.MyrridaLoreConcept.Hyperlink} como arautos de morte e destruição.\" Os <<Ge:fists^p,EventUnit.Name>> estão tremendo de raiva. \"Por muito tempo os Dragões invejaram a civilização que construímos. Esta foi sua oportunidade de retaliar contra os parentes Gigantes—e os {GLOBAL.ArchonsLoreConcept.Hyperlink} permaneceram cegos para suas devastações depois que tão duramente condenaram todos os <<m:{GLOBAL.GiantKingLoreConcept.Hyperlink}>>.\""

msgid "STORY_EVENT@991_7686@BUTTON_0"
msgstr "Deixe o {EventUnit} com <<o:EventUnit>> pensamentos."

msgid "STORY_EVENT@991_7686@TITLE"
msgstr "Jardim da Colunata: Guerra e Desgraça"

msgid "STORY_EVENT@991_7687@BODY_FOOTER"
msgstr "Uma tempestade repentina está se formando enquanto o {EventUnit} levanta <<o:EventUnit>> cajado. Nuvens escuras se espessam até que um poderoso raio parte a montanha negra, revelando a {EventStructure} dentro."

msgid "STORY_EVENT@991_7687@BODY_HEADER"
msgstr "Suas tropas dizimaram as criaturas draconianas dentro do Jardim Colunado. O {EventUnit} se aproxima delas com determinação severa."

msgid "STORY_EVENT@991_7687@BODY_LORE"
msgstr "\"Eu vigiei essas ruínas ao longo das eras, e à medida que elas lentamente se tornaram cobertas pela vegetação, eu também me tornei um com a floresta.\" As folhas que cobrem o {EventUnit} ficaram coloridas, como se tivessem se enfeitado para um último dia dourado de outono.[br/][br/]\"Agora, no entanto, minha vigília está chegando ao fim. Escondido dentro da montanha negra, mergulhado em um sono encantado, está {EventDragonName}, a Calamidade. Foi assim que eu aprisionei <<P:{EventDragonName}>>, esperando por alguém poderoso o suficiente para acabar com a besta. Essa pessoa é você, {PlayerLeader.TitleName}!\""

msgid "STORY_EVENT@991_7687@BUTTON_0"
msgstr "\"A fama [influence/] de matar {EventDragonName} será minha, e apenas minha!\""

msgid "STORY_EVENT@991_7687@BUTTON_4"
msgstr "\"Empreste-me a ajuda das suas forças da natureza [unit/] nesta batalha que se aproxima!\""

msgid "STORY_EVENT@991_7687@TITLE"
msgstr "Jardim Colunado: Uma Tempestade de Outono"

msgid "STORY_EVENT@991_7690@BODY_FOOTER"
msgstr "Uma brisa suave leva a <<Ge:foliage^n,{EventUnit}>> espalhando-a aos quatro ventos. Os chifres e o cajado de <<Co:EventUnit>> permanecem, passando a administração do Jardim Colunado para você."

msgid "STORY_EVENT@991_7690@BODY_FOOTER@DRAGON_ALLY"
msgstr "{EventDragonName} parte para os céus, deixando você com o {EventRelic}, os chifres e o cajado do {EventUnit}—e o domínio sobre o Jardim Colunado."

msgid "STORY_EVENT@991_7690@BODY_HEADER"
msgstr "Com {EventDragonName} desaparecido, o {EventUnit} examina cuidadosamente os restos do {EventStructure}."

msgid "STORY_EVENT@991_7690@BODY_HEADER@DRAGON_ALLY"
msgstr "Com o poderoso {EventUnit} abatido, {EventDragonName} reascende ao pico achatado da montanha negra em triunfo."

msgid "STORY_EVENT@991_7690@BODY_LORE"
msgstr "\"Paz, finalmente,\" o {EventUnit} exclama, revirando os escombros e cascas de ovos quebrados. As <<Ge:leaves^p,{EventUnit}>> perderam a maior parte de sua cor, exibindo um marrom que anuncia a chegada do inverno. Perto do centro do oco, o {EventUnit} para subitamente. \"Contemplem,\" <<p:EventUnit>> exclama, \"o {EventRelic}! O mais generoso entre as maravilhas abençoadas de {GLOBAL.MyrridaLoreConcept.Hyperlink}. Um presente digno de qualquer {PlayerLeader.Title}.\" O {EventUnit} coloca o {EventRelic} em um pedestal. \"Minha vigília terminou, {PlayerLeader}. A sua está apenas começando...\""

msgid "STORY_EVENT@991_7690@BODY_LORE@DRAGON_ALLY"
msgstr "\"Meu sono terminou,\" {EventDragonName} fala com majestade, \"e o último dos detestados Gigantes não existe mais.\" <<Cp:{EventDragonName}>> deixa <<o:{EventDragonName}>> olhar vagar em direção ao horizonte. \"Os tempos mudaram. O alcance dos {GLOBAL.ArchonsLoreConcept.Hyperlink} tornou-se distante e muito do que era falado apenas em profecia despertou. Eu devo vagar novamente, {PlayerLeader}. Pegue isto, o {EventRelic}, por seus feitos. Foi criado pelos senhores Gigantes desta cidade arruinada, mas só me trouxe males.\""

msgid "STORY_EVENT@991_7690@BUTTON_0"
msgstr "Use os chifres e o cajado para construir um santuário para o {EventUnit}. [natureboon/]"

msgid "STORY_EVENT@991_7690@BUTTON_3"
msgstr "Conecte-se com o cajado para convocar um servo [unit/] da natureza, uma última vez."

msgid "STORY_EVENT@991_7690@BUTTON_4"
msgstr "Suplique a {EventDragonName} para compartilhar <<o:{EventDragonName}>> conhecimento ancestral [knowledge/] com você antes de partir."

msgid "STORY_EVENT@991_7690@BUTTON_5"
msgstr "Convide os {GLOBAL.EternalSagesLoreConcept.Name} [allegiance/] para estudar as ruínas Myrridanas do Jardim Colunado."

msgid "STORY_EVENT@991_7690@BUTTON_6"
msgstr "Reivindique os chifres como um adorno [influence/] para o seu trono."

msgid "STORY_EVENT@991_7690@TITLE"
msgstr "Jardim Colunado: Consequências"

msgid "STORY_EVENT@991_7703@BODY_FOOTER"
msgstr "{EventDragonName} fixa você com <<o:{EventDragonName}>> olhos enormes e penetrantes: \"Você deve decidir, {PlayerLeader}, será a verdade ou a morte?\""

msgid "STORY_EVENT@991_7703@BODY_HEADER"
msgstr "Aproximando-se do {EventStructure}, a voz zombeteira de {EventDragonName} chama por você."

msgid "STORY_EVENT@991_7703@BODY_LORE"
msgstr "\"Então, {PlayerLeader.TitleName}, você realmente confia nas palavras de um Gigante,\" <<p:{EventDragonName}>> pergunta, sorrindo com seus enormes dentes. \"Eles nunca falam sobre o que causou a Grande Guerra ou sobre as baixas que infligiram. Conveniente, não é? Como se os {GLOBAL.TraitorKingsLoreConcept.Hyperlink} e suas maldições de alma nunca tivessem existido...\""

msgid "STORY_EVENT@991_7703@BUTTON_0"
msgstr "\"Morte! Sua desolação termina agora, {EventDragonName}!\""

msgid "STORY_EVENT@991_7703@BUTTON_4"
msgstr "\"Verdade! Vamos lutar ao lado do vingativo {EventUnit}!\""

msgid "STORY_EVENT@991_7703@BUTTON_DRAGON"
msgstr "\"Não deve haver discórdia entre iguais primordiais, meu <<EventDragonName{irmão/irmã}>>.\""

msgid "STORY_EVENT@991_7703@TITLE"
msgstr "Jardim Colunado: <<ge:Desdém^n,{EventDragonName}>>"

msgid "STORY_EVENT@991_7754@BODY_FOOTER"
msgstr "\"Você compartilhará seus destinos?\" a voz pronuncia enquanto desaparece, \"Ou você aprenderá com sua loucura, demonstrando o valor de herdar os segredos da Ilha da Trindade?\""

msgid "STORY_EVENT@991_7754@BODY_HEADER"
msgstr "Navegando pelos mares, com um arquipélago distante à vista, suas tropas ouvem uma voz profunda ressoando dentro de seus crânios."

msgid "STORY_EVENT@991_7754@BODY_LORE"
msgstr "\"Invasores. Saqueadores. Ladrões.\" Cada palavra tem o peso de uma acusação, mas as vozes em uníssono que as pronunciam não revelam emoção. \"Ao longo dos séculos, muitos vieram a estas ilhas para roubar os segredos do {GLOBAL.EternalCouncilLoreConcept.Hyperlink}. Avaliamos suas intenções. E então os detivemos, horrorizados com suas ambições vulgares.\" Visões de grandes rostos inexpressivos, esculpidos em cristal, manifestam-se nas mentes de suas tropas. \"Agora eles existem como estátuas vivas, um aviso a todos que buscam poder sem sabedoria.\""

msgid "STORY_EVENT@991_7754@BUTTON_0"
msgstr "\"Um <<{EventPlayerType}>> não precisa de prova de seu esplendor!\" [influence/]"

msgid "STORY_EVENT@991_7754@TITLE"
msgstr "Descobrindo a Ilha da Trindade"

msgid "STORY_EVENT@991_7757@BODY_FOOTER"
msgstr "O {EventUnit} questiona com autoridade: \"Entre as muitas atrocidades que os {GLOBAL.TraitorKingsLoreConcept.Hyperlink} cometeram, qual foi seu maior pecado?\""

msgid "STORY_EVENT@991_7757@BODY_FOOTER@COMPLETED"
msgstr "Você já respondeu a este julgamento. Visite os prisioneiros nas outras ilhas para obter o julgamento do {EventUnit}!"

msgid "STORY_EVENT@991_7757@BODY_HEADER"
msgstr "Examinando o {EventStackLeader} congelado em cristais, suas tropas ouvem o {EventUnit} falar com elas mais uma vez."

msgid "STORY_EVENT@991_7757@BODY_HEADER@COMPLETED"
msgstr "Suas tropas retornam ao {EventStackLeader}, selado dentro da prisão de cristal do {EventUnit}."

msgid "STORY_EVENT@991_7757@BODY_LORE"
msgstr "\"Ávidos por poder como seus mestres falecidos, os {GLOBAL.TraitorKingCultLoreConcept.Hyperlink} são um inimigo póstumo do {GLOBAL.EternalCouncilLoreConcept.Hyperlink}.\" A voz do {EventUnit} fica mais alta. \"Quando os {GLOBAL.TraitorKingsLoreConcept.Hyperlink} tentaram roubar o segredo de nossa imortalidade, cometeram um erro crucial. Eles tomaram nosso conhecimento. Eles tomaram nossos cristais. Eles experimentaram em seus seguidores em rituais macabros. No entanto, quando chegou a hora, eles apenas fraturaram suas almas, uma sombra imortalizada de seus antigos eus.\""

msgid "STORY_EVENT@991_7757@BODY_LORE@COMPLETED"
msgstr "Só se pode imaginar se o {EventStackLeader} ainda está verdadeiramente vivo ou se o confinamento dentro dos cristais deteve todos os <<o:EventStackLeader>> pensamentos e sensações."

msgid "STORY_EVENT@991_7757@BUTTON_0"
msgstr "Não responda ao {EventUnit}, por enquanto."

msgid "STORY_EVENT@991_7757@BUTTON_1"
msgstr "\"Traição. Eles traíram seu juramento como Reis Gigantes e o povo que deveriam proteger.\""

msgid "STORY_EVENT@991_7757@BUTTON_2"
msgstr "\"Ganância. [gold/] Onde os Reis Gigantes mineravam riquezas para criar e artesanato, os Reis Traidores acumularam riqueza sem razão.\""

msgid "STORY_EVENT@991_7757@BUTTON_3"
msgstr "\"Orgulho. [influence/] Eles agiram como deuses caprichosos, sacrificando tudo na busca pela imortalidade.\""

msgid "STORY_EVENT@991_7757@BUTTON_4"
msgstr "\"Ignorância. [knowledge/] Eles buscaram conhecimento proibido sem compreender a ruína que trouxeram sobre si mesmos e, em última instância, sobre todos os parentes Gigantes.\""

msgid "STORY_EVENT@991_7757@TITLE"
msgstr "Ilha da Trindade: Julgamento do Pecado"

msgid "STORY_EVENT@991_7761@BODY_FOOTER"
msgstr "O {EventUnit} pergunta: \"Imagine uma biblioteca com a história coletada de um reino sendo presenteada a um <<PlayerLeader{rei/rainha}>>. O que o <<PlayerLeader{rei/rainha}>> deveria fazer?\""

msgid "STORY_EVENT@991_7761@BODY_FOOTER@COMPLETED"
msgstr "Você já respondeu a este julgamento. Visite os prisioneiros nas outras ilhas para obter o julgamento do {EventUnit}!"

msgid "STORY_EVENT@991_7761@BODY_HEADER"
msgstr "Enquanto suas tropas encontram um único renegado, selado dentro de um cristal de Litiorita, o {EventUnit} fala sobre o destino de <<o:EventStackLeader>>."

msgid "STORY_EVENT@991_7761@BODY_HEADER@COMPLETED"
msgstr "Suas tropas retornam ao {EventStackLeader}, selado dentro da prisão de cristal do {EventUnit}."

msgid "STORY_EVENT@991_7761@BODY_LORE"
msgstr "\"O nome de <<Co:EventStackLeader>> é {EventStackLeader}, mas <<p:EventStackLeader>> era apenas uma ferramenta descartável para os {GLOBAL.ColtLoreConcept.Hyperlink}.\" Enquanto o {EventUnit} fala, suas tropas começam a ver a forma de uma grande estrutura cristalina cintilando nas águas costeiras. No entanto, à medida que a voz continua, a imagem desaparece novamente, como uma miragem: \"Eles equipam e contratam aventureiros para saquear os tesouros secretos de [hyperlink,GLOBAL.MyrridaLoreConcept]Myrrida[/hyperlink], destruindo grande parte de seu legado além de qualquer recuperação. Assim, eles são a força contrária aos {GLOBAL.EternalSagesLoreConcept.Hyperlink}, que cronologizam e preservam todo o conhecimento dentro de suas bibliotecas de cristal.\""

msgid "STORY_EVENT@991_7761@BODY_LORE@COMPLETED"
msgstr "Só se pode imaginar se o {EventStackLeader} ainda está verdadeiramente vivo ou se o confinamento dentro dos cristais deteve todos os <<o:EventStackLeader>> pensamentos e sensações."

msgid "STORY_EVENT@991_7761@BUTTON_0"
msgstr "Não responda ao {EventUnit}, por enquanto."

msgid "STORY_EVENT@991_7761@BUTTON_1"
msgstr "\"Queime a biblioteca! A história é escrita pelos vencedores!\""

msgid "STORY_EVENT@991_7761@BUTTON_2"
msgstr "\"Compartilhe a biblioteca com os governadores locais, para reformar o sistema administrativo [food/][structureprod/].\""

msgid "STORY_EVENT@991_7761@BUTTON_3"
msgstr "\"Use o conhecimento dentro para forjar agravos [influence/] contra reinos rivais.\""

msgid "STORY_EVENT@991_7761@BUTTON_4"
msgstr "\"Estude as crônicas [knowledge/] para aprender com os erros de impérios passados.\""

msgid "STORY_EVENT@991_7761@TITLE"
msgstr "Ilha da Trindade: Provação de Sabedoria"

msgid "STORY_EVENT@991_7764@BODY_FOOTER"
msgstr "A voz pergunta com determinação: \"Um troll e um <<PlayerLeader{homem/mulher}>> buscam justiça na corte de um {GLOBAL.GiantKingLoreConcept.Hyperlink}. Quem o {GLOBAL.GiantKingLoreConcept.Hyperlink} deve favorecer?\""

msgid "STORY_EVENT@991_7764@BODY_FOOTER@COMPLETED"
msgstr "Você já respondeu a esta provação. Visite os prisioneiros nas outras ilhas para obter o julgamento do {EventUnit}!"

msgid "STORY_EVENT@991_7764@BODY_HEADER"
msgstr "Atordoados pelo enorme cristal encapsulando um {EventStackLeader}, suas tropas ouvem a voz profunda e ressonante retornar."

msgid "STORY_EVENT@991_7764@BODY_HEADER@COMPLETED"
msgstr "Suas tropas retornam ao {EventStackLeader}, selado dentro da prisão de cristal do {EventUnit}."

msgid "STORY_EVENT@991_7764@BODY_LORE"
msgstr "\"Ah, é nisso que a prole dos parentes Gigantes se tornou: brutamontes incivilizados, ansiosos para roubar sua própria herança.\" A voz vacila por um momento, como se perdida em pensamento. Então continua: \"Os Clãs Gigantes acusam os 'Apressados' de supressão, mas eles mesmos incitam o ódio contra os parentes menores, evocando uma visão de {GLOBAL.MyrridaLoreConcept.Hyperlink} que nunca existiu.\""

msgid "STORY_EVENT@991_7764@BODY_LORE@COMPLETED"
msgstr "Pode-se apenas se perguntar se o {EventStackLeader} ainda está verdadeiramente vivo ou se o confinamento dentro dos cristais deteve todos os <<o:EventStackLeader>> pensamentos e sensações."

msgid "STORY_EVENT@991_7764@BUTTON_0"
msgstr "Não responda ao {EventUnit}, por enquanto."

msgid "STORY_EVENT@991_7764@BUTTON_1"
msgstr "\"O <<PlayerLeader{homem/mulher}>>! Um troll é uma descendência degenerada que deve ser eliminada dos reinos!\""

msgid "STORY_EVENT@991_7764@BUTTON_2"
msgstr "\"Ambos! Misericórdia [goodact/] é um dom concedido por verdadeiros reis.\""

msgid "STORY_EVENT@991_7764@BUTTON_3"
msgstr "\"O troll! Em um Reino Gigante, os Gigantes governam supremos!\" [influence/]"

msgid "STORY_EVENT@991_7764@BUTTON_4"
msgstr "\"Nenhum! A justiça deve ser dispensada apenas após estudar [knowledge/] todas as evidências!\""

msgid "STORY_EVENT@991_7764@TITLE"
msgstr "Ilha da Trindade: Provação de Equilíbrio"

msgid "STORY_EVENT@991_7774@BODY_FOOTER"
msgstr "As vozes em uníssono terminam sua provação: \"Para herdar nossos segredos, fale uma última vez: Qual qualidade um <<PlayerLeader{rei/rainha}>> deve representar acima de tudo?\""

msgid "STORY_EVENT@991_7774@BODY_HEADER"
msgstr "Suas tropas se aproximam cuidadosamente do {EventStackLeader}, flutuando entre as três ilhas, aguardando o julgamento de <<o:EventStackLeader>>."

msgid "STORY_EVENT@991_7774@BODY_LORE"
msgstr "\"Você respondeu às nossas provações,\" diz o {EventStackLeader}, \"e consideramos suas respostas dignas de um {PlayerLeader.Title}.\" Há reflexos de cristal na água, cegando suas tropas, mas eles desaparecem novamente enquanto o {EventStackLeader} continua: \"O <<m:{GLOBAL.GiantKingLoreConcept.Hyperlink}>> governou {GLOBAL.MyrridaLoreConcept.Hyperlink} com grande sabedoria. Havia igualdade entre gigantes e os parentes menores e até mesmo os <<m:{GLOBAL.GiantKingLoreConcept.Hyperlink}>> obedeciam à lei e aos vereditos do {GLOBAL.EternalCouncilLoreConcept.Hyperlink}.\""

msgid "STORY_EVENT@991_7774@BUTTON_0"
msgstr "Não responda ao {EventStackLeader}, por enquanto."

msgid "STORY_EVENT@991_7774@BUTTON_1"
msgstr "\"Suas provações são um insulto ao meu poder. Morra agora, {EventStackLeader} vexatório!\""

msgid "STORY_EVENT@991_7774@BUTTON_2"
msgstr "\"Tenacidade.\" [structureprod/][materiumboon/]"

msgid "STORY_EVENT@991_7774@BUTTON_3"
msgstr "\"Nobreza.\" [influence/][shadowboon/]"

msgid "STORY_EVENT@991_7774@BUTTON_4"
msgstr "\"Prudência.\" [knowledge/][astralboon/]"

msgid "STORY_EVENT@991_7774@TITLE"
msgstr "Ilha da Trindade: A Provação do {EventStackLeader}"

msgid "STORY_EVENT@991_7777@BODY_FOOTER"
msgstr "Onde o {EventUnit} flutuava, agora apenas um artefato está à deriva nas ondas. É o {EventRelic}, recompensa e prova do seu domínio sobre a Ilha da Trindade."

msgid "STORY_EVENT@991_7777@BODY_HEADER"
msgstr "O {EventUnit} murmura. \"Uma resposta sagaz. Com isso, podemos levantar nosso feitiço e retornar aos salões cintilantes de nossos irmãos. Maravilhe-se com a {EventStructure}, {PlayerLeader}, e seus segredos que agora são seus!\""

msgid "STORY_EVENT@991_7777@BODY_LORE"
msgstr "Um chiado arcano agita as águas da Ilha da Trindade e, à medida que a ilusão do {EventUnit} desaparece, grandes cristais monumentais são revelados às suas tropas. Eles formam um complexo estrutural que se estende entre as três ilhas, uma {EventStructure} que contém o conhecimento cristalizado do {GLOBAL.EternalCouncilLoreConcept.Hyperlink}."

msgid "STORY_EVENT@991_7777@BUTTON_0"
msgstr "Ative os guardiões Lithorine [unit/] adormecidos dentro da {EventStructure}."

msgid "STORY_EVENT@991_7777@BUTTON_4"
msgstr "Reivindique quaisquer itens mágicos [item/] armazenados entre os cristais de conhecimento."

msgid "STORY_EVENT@991_7777@BUTTON_5"
msgstr "Absorva as abundantes energias astrais [mana/] contidas dentro da {EventStructure}."

msgid "STORY_EVENT@991_7777@BUTTON_6"
msgstr "Convide os {GLOBAL.EternalSagesLoreConcept.Name} [allegiance/] para a {EventStructure}."

msgid "STORY_EVENT@991_7777@TITLE"
msgstr "Ilha da Trindade: Consequências"

msgid "STORY_EVENT@993_7337@BODY_FOOTER"
msgstr "{EventLeaderDefeated.Name} exerce uma forte influência sobre este reino. Derrotar <<p:var>> garantirá sua dominância."

msgid "STORY_EVENT@993_7337@BODY_HEADER"
msgstr "{EventLeaderDefeated.TitleName} olha para você com desprezo, avaliando a relevância de sua intrusão no reino de <<o:EventLeaderDefeated>>."

msgid "STORY_EVENT@993_7337@BODY_LORE"
msgstr "\"Não tolerarei a presença de pretensos em meu reino. Fique fora do meu caminho e talvez você sobreviva ao frio o suficiente para se arrepender de ter vindo aqui.\""

msgid "STORY_EVENT@993_7337@BUTTON_0"
msgstr "Este reino será nosso."

msgid "STORY_EVENT@993_7337@TITLE"
msgstr "Reino da Rainha do Gelo"

msgid "STORY_EVENT@993_7338@BODY_FOOTER"
msgstr "Com o poder do Coração Congelado em suas mãos, ninguém pode ficar em seu caminho. Este reino é seu."

msgid "STORY_EVENT@993_7338@BODY_HEADER"
msgstr "{EventLeaderDefeated} foi derrotado. À medida que <<p:EventLeaderDefeated>> é lançado no vazio, o controle de <<o:EventLeaderDefeated>> sobre este reino vacila."

msgid "STORY_EVENT@993_7338@BODY_LORE"
msgstr "Saqueando a <<g:antiga cidade do trono^n,EventLeaderDefeated>>, o segredo para o controle de <<o:EventLeaderDefeated>> sobre o reino é revelado: um coração congelado aparentemente feito de muitas criaturas elementais, fundidas de maneira grotesca."

msgid "STORY_EVENT@993_7338@BUTTON_0"
msgstr "A vitória é nossa!"

msgid "STORY_EVENT@993_7338@TITLE"
msgstr "A Rainha do Gelo Derrotada"

msgid "STORY_EVENT@993_7347@BODY_FOOTER"
msgstr "{EventLeaderDefeated.TitleName} é a principal ameaça ao seu controle sobre este reino. Derrotar um ser tão poderoso não deixará dúvidas sobre seu direito de governar."

msgid "STORY_EVENT@993_7347@BODY_HEADER"
msgstr "Com chamas rugindo, {EventLeaderDefeated.TitleName} aparece, os olhos de <<o:EventLeaderDefeated>> cintilando com uma intensidade aterrorizante."

msgid "STORY_EVENT@993_7347@BODY_LORE"
msgstr "\"Um novo cordeiro chega ao meu reino.\" <<Cp:EventLeaderDefeated>> observa sua forma, avaliando você como alguém selecionaria gado para o abate. \"Você ainda não perdeu seu fogo. Isso é bom... Vou aproveitar tirá-lo de você.\""

msgid "STORY_EVENT@993_7347@BUTTON_0"
msgstr "\"{EventLeaderDefeated.TitleName} deve cair.\""

msgid "STORY_EVENT@993_7347@TITLE"
msgstr "Reino da {EventLeaderDefeated.Title}"

msgid "STORY_EVENT@993_7348@BODY_FOOTER"
msgstr "A <<g:derrota final^n,EventLeaderDefeated>> prova sua supremacia sobre este reino. Com os poderes de <<o:EventLeaderDefeated>> adicionados aos seus, os outros lordes se rendem ou se apressam para fugir."

msgid "STORY_EVENT@993_7348@BODY_HEADER"
msgstr "{EventLeaderDefeated.TitleName} é abraçado pelas chamas que <<p:EventLeaderDefeated>> já chamou de <<o:EventLeaderDefeated>>, rugindo enquanto <<p:EventLeaderDefeated>> é levado."

msgid "STORY_EVENT@993_7348@BODY_LORE"
msgstr "O {EventLeaderDefeated.Title} foi derrotado, os exércitos de <<o:EventLeaderDefeated>> se dispersando e sucumbindo a lutas internas. Agora você possui o poder de comandar as legiões de <<o:EventLeaderDefeated>> ou de baní-las."

msgid "STORY_EVENT@993_7348@BUTTON_0"
msgstr "A vitória é nossa!"

msgid "STORY_EVENT@993_7348@TITLE"
msgstr "O {EventLeaderDefeated.Title} Derrotado"

msgid "STORY_EVENT@993_7354@BODY_FOOTER"
msgstr "Por conquista ou diplomacia, {WarlordLeader.Name}, {BastardLeader.Name} e {HeirLeader.Name} devem ser subjugados."

msgid "STORY_EVENT@993_7354@BODY_HEADER"
msgstr "Após se encontrar com os reis que governam os remanescentes deste que já foi um poderoso reino, você tem um novo objetivo diante de si, a reunificação de Vossin... sob sua bandeira."

msgid "STORY_EVENT@993_7354@BODY_LORE"
msgstr "O outrora poderoso reino de Vossin está agora destruído, seu povo sofre enquanto os reis brigam. Algo deve ser feito."

msgid "STORY_EVENT@993_7354@BUTTON_0"
msgstr "Vossin será reunido sob minha bandeira."

msgid "STORY_EVENT@993_7354@TITLE"
msgstr "A Conquista de Vossin"

msgid "STORY_EVENT@993_7355@BODY_FOOTER"
msgstr "O trono é agora seu para ascender e o Reino de Vossin reforjado seu para comandar."

msgid "STORY_EVENT@993_7355@BODY_HEADER"
msgstr "Com seu controle sobre o último reino fragmentado assegurado, não há mais dúvidas sobre sua reivindicação a este reino."

msgid "STORY_EVENT@993_7355@BODY_LORE"
msgstr "Os reis restantes juram lealdade a você, seus súditos aclamando você como um grande unificador, aquele que reunificou um reino destruído."

msgid "STORY_EVENT@993_7355@BUTTON_0"
msgstr "A vitória é nossa!"

msgid "STORY_EVENT@993_7355@TITLE"
msgstr "Vossin Conquistado"

msgid "STORY_EVENT@993_8062@BODY_FOOTER"
msgstr "{EventLeaderDefeated.Name} tem uma forte influência sobre as casas deste reino, derrotar <<P:EventLeaderDefeated>> provará sua dominância."

msgid "STORY_EVENT@993_8062@BODY_HEADER"
msgstr "Uma imagem de {EventLeaderDefeated.TitleName} aparece cercada por um ar imperioso; <<p:EventLeaderDefeated>> sorri calorosamente."

msgid "STORY_EVENT@993_8062@BODY_LORE"
msgstr "\"Bem-vindo, pretendente. Você entra em um Reino já salvo, iluminado pela vontade dos [hyperlink,GLOBAL.ArchonsLoreConcept]Arcontes[/hyperlink]. Você seria sábio em se alinhar e juntar-se ao nosso pacto... ou encontrar-se banido.\""

msgid "STORY_EVENT@993_8062@BUTTON_0"
msgstr "{EventLeaderDefeated.TitleName} deve cair."

msgid "STORY_EVENT@993_8062@TITLE"
msgstr "Reino do {EventLeaderDefeated.Title}"

msgid "STORY_EVENT@993_8063@BODY_FOOTER"
msgstr "Com as Casas subjugadas à sua vontade, ninguém pode ficar em seu caminho. Este Reino é seu."

msgid "STORY_EVENT@993_8063@BODY_HEADER"
msgstr "O {EventLeaderDefeated.Title} está derrotado. No entanto, enquanto <<p:EventLeaderDefeated>> é lançado no vazio, nenhuma retribuição divina vem."

msgid "STORY_EVENT@993_8063@BODY_LORE"
msgstr "O {EventLeaderDefeated.Title} poderia sangrar afinal... como representante das muitas Casas, rendemos nossa lealdade a você, vencedor dos profetas. Que você nos mostre misericórdia."

msgid "STORY_EVENT@993_8063@BUTTON_0"
msgstr "A vitória é nossa!"

msgid "STORY_EVENT@993_8063@TITLE"
msgstr "O {EventLeaderDefeated.Title} Derrotado"

msgid "STORY_EVENT@993_8075@BODY_FOOTER"
msgstr "{EventLeaderDefeated.Name} está trabalhando em algum trabalho arcano aterrorizante neste reino, derrotar <<P:EventLeaderDefeated>> frustrará o esquema de <<o:EventLeaderDefeated>> e transferirá o poder de <<o:EventLeaderDefeated>> para você."

msgid "STORY_EVENT@993_8075@BODY_HEADER"
msgstr "Uma projeção de {EventLeaderDefeated.TitleName} aparece, não reconhecendo sua presença enquanto fala."

msgid "STORY_EVENT@993_8075@BODY_LORE"
msgstr "\"Mais intrusos para perturbar meu trabalho... Veja que você não o faça, ou descobrirá o significado das palavras 'Conhecimento é poder.'\""

msgid "STORY_EVENT@993_8075@BUTTON_0"
msgstr "{EventLeaderDefeated.TitleName} deve cair."

msgid "STORY_EVENT@993_8075@TITLE"
msgstr "Reino do Bibliotecário"

msgid "STORY_EVENT@993_8076@BODY_FOOTER"
msgstr "Com os Tomos do bibliotecário e o dispositivo arcano de <<o:EventLeaderDefeated>> à sua disposição, este Reino é seu."

msgid "STORY_EVENT@993_8076@BODY_HEADER"
msgstr "{EventLeaderDefeated.Title} foi derrotado. Enquanto <<p:EventLeaderDefeated>> é lançado no vazio, os esquemas de <<o:EventLeaderDefeated>> ficam incompletos."

msgid "STORY_EVENT@993_8076@BODY_LORE"
msgstr "Saqueando a <<g:antiga cidade do trono^n,EventLeaderDefeated>>, o segredo do esquema arcano de <<o:EventLeaderDefeated>> é revelado: Um {GLOBAL.LostWizardLoreConcept.Hyperlink} aprisionado, seu poder drenado para conceder uma fração do poder de um {GLOBAL.GodirLoreConcept.Hyperlink} completo."

msgid "STORY_EVENT@993_8076@BUTTON_0"
msgstr "A vitória é nossa!"

msgid "STORY_EVENT@993_8076@TITLE"
msgstr "O Bibliotecário Derrotado"

msgid "STORY_EVENT@BUTTON@DECLINE_OFFER_DEFAULT"
msgstr "Recusar a oferta"

msgid "STORY_EVENT@PANTHEONHERO_JOIN@BODY_FOOTER_DEFAULT"
msgstr "{EventRuler.TitleName} oferece a ajuda de <<o:EventRuler>> como um [hyperlink,GLOBAL.HeroConcept]<<EventRuler{Hero/Heroine}>>[/hyperlink] sob seu comando! Você aceita?"

