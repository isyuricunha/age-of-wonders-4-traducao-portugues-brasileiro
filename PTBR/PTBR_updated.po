msgid "DLC@EMPIRESANDASHES@REALM_TRAIT@AMAZONIAN_REALM@DESCRIPTION"
msgstr "O reino é uma selva exuberante, cercada pelo Vazio Astral.[bulletlist][bullet/]<<m:{GLOBAL.ProvinceConcept.Hyperlink}>> tropicais e <<m:{GLOBAL.ProvinceFeatureConcept.Hyperlink}>> de floresta são [abilityblue]Comuns[/abilityblue].[bullet/]<<m:{GLOBAL.ProvinceFeatureConcept.Hyperlink}>> de rio são [abilityblue]Comuns[/abilityblue].[bullet/]<<m:{GLOBAL.ProvinceConcept.Hyperlink}>> árticas, desérticas e desoladas são [abilityblue]Raras[/abilityblue].[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@REALM_TRAIT@AMAZONIAN_REALM@NAME"
msgstr "Selva Perdida"

msgid "DLC@EMPIRESANDASHES@REALM_TRAIT@AVIAN_INHABITANTS@DESCRIPTION"
msgstr "O reino é lar de muitas aves, civilizadas e selvagens.[bulletlist][bullet/]<<m:{GLOBAL.IndependentCityConcept.Hyperlink}>> aviárias são [abilityblue]Comuns[/abilityblue].[bullet/]<<m:{GLOBAL.STRUCTURES.GREAT_BIRD_NEST_SPAWNER.Hyperlink}>> são [abilityblue]Comuns[/abilityblue].[bullet/]Unidades de aves <<m:{GLOBAL.UnitConcept.Hyperlink}>> são [abilityblue]Comuns[/abilityblue].[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@REALM_TRAIT@AVIAN_INHABITANTS@NAME"
msgstr "Aves do Paraíso"

msgid "DLC@EMPIRESANDASHES@REALM_TRAIT@WARDEN_OF_MANUHARI@DESCRIPTION"
msgstr "Este reino é protegido por um poderoso {GLOBAL.UNITS.PROGENITOR_GOLEM.Hyperlink}, que lançará ataques periódicos contra qualquer inimigo dos [hyperlink,GLOBAL.AncientKrazuraLoreConcept]Krazura[/hyperlink] nativos."

msgid "DLC@EMPIRESANDASHES@REALM_TRAIT@WARDEN_OF_MANUHARI@NAME"
msgstr "Guardião de Manuhari"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT01@DESCRIPTION"
msgstr "A cada {amount} <<m:{GLOBAL.TurnConcept}>>, unidades inimigas:[bulletlist][bullet/]Sofrem {CONDEMNATION_STRIKE_DAMAGE>DAMAGE>Spirit} de {GLOBAL.SpiritDamageConcept.Hyperlink}.[bullet/]Têm uma chance base de {CONDEMN_RESISTANCE>ResolvedStrength}% de se tornarem {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT01@NAME"
