msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALABYSS@DESCRIPTION"
msgstr "Tutorial sobre o Abismo Umbral"

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALABYSS@PAGE1@DESCRIPTION"
msgstr "Você entrou no {GLOBAL.UmbralAbyssConcept.Hyperlink}! [br/]Grandes recompensas e recursos abundantes o aguardam enquanto explora e conquista dentro desta Camada do {GLOBAL.WorldMapConcept.Hyperlink}."

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALABYSS@PAGE1@INSTRUCTION"
msgstr "O Abismo Umbral é um lugar hostil, habitado por poderosos <<m:{GLOBAL.PROPERTIES.UMBRAL_DEMON.Hyperlink}>> que se reúnem em locais como Ninho Umbral <<m:{GLOBAL.InfestationConcept.Hyperlink}>>. Além disso, seu <<m:{GLOBAL.ArmyConcept.Hyperlink}>> sofre de {GLOBAL.PROPERTIES.SHADOW_SICKNESS.Hyperlink} enquanto estiver dentro do Abismo Umbral."

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALABYSS@PAGE2@DESCRIPTION"
msgstr "Para sobreviver no Abismo Umbral, você deve construir <<m:{GLOBAL.SanctuaryOutpostConcept.Hyperlink}>>, que protegem seu <<m:{GLOBAL.ArmyConcept.Hyperlink}>> da {GLOBAL.PROPERTIES.SHADOW_SICKNESS.Hyperlink}. Isso também permitirá que você anexe <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> no Abismo Umbral."

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALABYSS@PAGE2@INSTRUCTION"
msgstr "<<m:{GLOBAL.SanctuaryOutpostConcept.Hyperlink}>> só podem ser construídos em <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> com um {GLOBAL.BeaconOfLightConcept.Hyperlink}. Estes podem ser encontrados enquanto explora o {GLOBAL.UmbralAbyssConcept.Hyperlink} e ao derrotar Ninhos Umbrais <<m:{GLOBAL.InfestationConcept.Hyperlink}>>.[br/]Postos Avançados de Santuário não podem ser usados para fundar <<m:{GLOBAL.CityConcept.Hyperlink}>>."

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALABYSS@PAGE2@TITLE"
msgstr "Faróis de Luz"

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALABYSS@TITLE"
msgstr "O Abismo Umbral"

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALDWELLING@DESCRIPTION"
msgstr "Tutorial sobre Moradias Umbrais"

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALDWELLING@PAGE1@DESCRIPTION"
msgstr "Você encontrou uma {GLOBAL.UmbralDwellingConcept.Hyperlink}! [br/]Essas <<m:{GLOBAL.DwellingConcept.Hyperlink}>> estão repletas de <<m:{GLOBAL.PROPERTIES.UMBRAL_DEMON.Hyperlink}>> e espalham {GLOBAL.GloomTerrainConcept.Hyperlink} à medida que se expandem pelo {GLOBAL.UmbralAbyssConcept.Hyperlink} e para outras Camadas do {GLOBAL.WorldMapConcept.Hyperlink}."

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALDWELLING@PAGE1@INSTRUCTION"
msgstr "Portanto, são uma ameaça que deve ser destruída. Uma Moradia Umbral destruída deixará para trás um {GLOBAL.BeaconOfLightConcept.Hyperlink}."

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALDWELLING@PAGE2@DESCRIPTION"
msgstr "Você também pode escolher fazer amizade com a {GLOBAL.UmbralDwellingConcept.Hyperlink} para obter bônus únicos.[br/]Para acessá-los, você deve alcançar um {GLOBAL.EldritchPactConcept.Hyperlink}. Isso pode ser feito aumentando a {GLOBAL.HouseInfluenceConcept.Hyperlink} com a {GLOBAL.UmbralDwellingConcept.Hyperlink}."

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALDWELLING@PAGE2@INSTRUCTION"
msgstr "<<m:{GLOBAL.UmbralDwellingConcept.Hyperlink}>> são sempre consideradas {GLOBAL.PROPERTIES.EVIL_3_UNIT_PROPERTY.Hyperlink} e não aceitarão um {GLOBAL.DiplomaticTokenConcept.Hyperlink}. Para [hyperlink,GLOBAL.AlignmentConcept][reputation2/] Malignos[/hyperlink] <<m:{GLOBAL.LeaderConcept.Hyperlink}>>, a {GLOBAL.HouseInfluenceConcept.Hyperlink} aumentará lentamente com o tempo.[br/][br/]Atender às [reputation2/] exigências malignas da Moradia Umbral também aumentará a [allegiance/] Aliança."

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALDWELLING@PAGE2@TITLE"
msgstr "Oferendas ou destruição"

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALDWELLING@TITLE"
msgstr "Moradias Umbrais"

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALGATE@DESCRIPTION"
msgstr "Tutorial sobre Portões Umbrais"

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALGATE@PAGE1@DESCRIPTION"
msgstr "Você encontrou um Portão Umbral! [br/]Portões Umbrais são portais para o {GLOBAL.UmbralAbyssConcept.Hyperlink}, que é uma camada no {GLOBAL.WorldMapConcept.Hyperlink} repleta de riquezas e perigos."

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALGATE@PAGE1@INSTRUCTION"
msgstr "Portões Umbrais são a única maneira de acessar a camada do {GLOBAL.UmbralAbyssConcept.Hyperlink}. Eles estão espalhados por todas as camadas do {GLOBAL.WorldMapConcept.Hyperlink}.[br/][br/]Dentro do Abismo Umbral, há valiosos <<m:{GLOBAL.NodeConcept.Hyperlink}>>, <<m:{GLOBAL.PickupConcept.Hyperlink}>> únicos e <<m:{GLOBAL.VisitSiteConcept.Hyperlink}>> exóticos."

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALGATE@PAGE2@DESCRIPTION"
msgstr "Esteja ciente de que o terreno próximo aos Portões Umbrais e no {GLOBAL.UmbralAbyssConcept.Hyperlink} são afetados pela {GLOBAL.GloomTerrainConcept.Hyperlink}."

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALGATE@PAGE2@GLOOM"
msgstr "Penumbra"

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALGATE@PAGE2@INSTRUCTION"
msgstr "<<m:{GLOBAL.UnitConcept.Hyperlink}>> em <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> afetadas pela {GLOBAL.GloomTerrainConcept.Hyperlink} sofrerão {GLOBAL.PROPERTIES.SHADOW_SICKNESS.Hyperlink}, [warningred]fazendo com que percam <<m:{GLOBAL.HitPointConcept.Hyperlink}>> a cada {GLOBAL.TurnConcept.Hyperlink}[/warningred] e tenham sua Visão reduzida.[br/][br/]O dano da Doença Umbral nunca reduzirá uma unidade abaixo de {HPPercentage}% de seus [hp/] Pontos de Vida totais."

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALGATE@TITLE"
msgstr "Portões Umbrais"

