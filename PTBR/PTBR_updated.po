msgid "TRAITS_BACKGROUND_CHARACTERS@BATTLEMAGE3@NAME"
msgstr "{LOC.INTERFACE@TEXT@CLASS@MAGE} Orbe de Relâmpago"

msgid "TRAITS_BACKGROUND_CHARACTERS@BATTLEMAGE4@DESCRIPTION"
msgstr "{GLOBAL.LeaderConcept.Hyperlink} começa com:[bulletlist][bullet/]{GLOBAL.HeroClassMage.Hyperlink}[bullet/]{GLOBAL.EQUIPMENT.POISON_ORB.Hyperlink}[bullet/]{GLOBAL.HeroMountConcept.Hyperlink}[/bulletlist]"

msgid "TRAITS_BACKGROUND_CHARACTERS@BATTLEMAGE4@NAME"
msgstr "{LOC.INTERFACE@TEXT@CLASS@MAGE} Orbe de Calamidade"

msgid "TRAITS_BACKGROUND_CHARACTERS@BATTLEMAGE5@DESCRIPTION"
msgstr "{GLOBAL.LeaderConcept.Hyperlink} começa com:[bulletlist][bullet/]{GLOBAL.HeroClassMage.Hyperlink}[bullet/]{GLOBAL.EQUIPMENT.FROST_ORB.Hyperlink}[bullet/]{GLOBAL.HeroMountConcept.Hyperlink}[/bulletlist]"

msgid "TRAITS_BACKGROUND_CHARACTERS@BATTLEMAGE5@NAME"
msgstr "{LOC.INTERFACE@TEXT@CLASS@MAGE} Orbe de Gelo"

msgid "TRAITS_BACKGROUND_CHARACTERS@BATTLEMAGE6@NAME"
msgstr "{LOC.INTERFACE@TEXT@CLASS@MAGE} Orbe de Aço"

msgid "TRAITS_BACKGROUND_CHARACTERS@BATTLEMAGE_WK@DESCRIPTION"
msgstr "{GLOBAL.LeaderConcept.Hyperlink} começa com:[bulletlist][bullet/]{GLOBAL.HeroClassMage.Hyperlink}[bullet/]{GLOBAL.EQUIPMENT.LIGHTNING_ORB.Hyperlink}[bullet/]{GLOBAL.HeroMountConcept.Hyperlink}[/bulletlist]"

msgid "TRAITS_BACKGROUND_CHARACTERS@DARK_SWORD_CROSSBOW@DESCRIPTION"
msgstr "{GLOBAL.LeaderConcept.Hyperlink} começa com:[bulletlist][bullet/]{GLOBAL.HeroClassRanger.Hyperlink}[bullet/]{GLOBAL.EQUIPMENT.DARK_CROSSBOW_SWORD.Hyperlink}[bullet/]{GLOBAL.HeroMountConcept.Hyperlink}[/bulletlist]"

msgid "TRAITS_BACKGROUND_CHARACTERS@FEUDAL_SWORD_CROSSBOW@DESCRIPTION"
