msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@RIGHTEOUSNESS@OATHBREAKER_TOOLTIP_DESCRIPTION"
msgstr "[bullet/]{GLOBAL.PROPERTIES.NOBILITY.Hyperlink}: -{amount}% de dano."

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@RIGHTEOUSNESS@PARAGON_TOOLTIP_DESCRIPTION"
msgstr "[bullet/]{GLOBAL.PROPERTIES.NOBILITY.Hyperlink}: +{amount} {GLOBAL.SpiritDamageConcept.Hyperlink}[bullet/]Unidades {GLOBAL.UNITS.AVENGER.Hyperlink} têm sua {GLOBAL.PROPERTIES.SWORN_PARAGON_RIGHTEOUSNESS.Hyperlink} ativada."

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@STRIFE@ADHERENT_TOOLTIP_DESCRIPTION"
msgstr "[bullet/]{GLOBAL.PROPERTIES.WARRIORS_SOUL.Hyperlink}: +{amount} {GLOBAL.FireDamageConcept.Hyperlink}"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@STRIFE@DEVOTEE_TOOLTIP_DESCRIPTION"
msgstr "[bullet/]{GLOBAL.PROPERTIES.WARRIORS_SOUL.Hyperlink}: +{amount} {GLOBAL.FireDamageConcept.Hyperlink}"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@STRIFE@DEVOTION_DESCRIPTION"
msgstr "[bulletlist][bullet/]Ganhe {GLOBAL.DevotionConcept.Hyperlink} por:[bulletlist][bullet/]Entrar em <<m:{GLOBAL.WarConcept.Hyperlink}>> +{GLOBAL.StrifeEnterWar} [devotedact/].[bullet/]{GLOBAL.RazingConcept.Hyperlink} uma {GLOBAL.CityConcept.Hyperlink} +{GLOBAL.StrifeRazeCity} [devotedact/].[bullet/]Não deixar unidades fugirem em eventos +{GLOBAL.StrifeNoRoutEvent} [devotedact/].[bullet/]Vencer em combate:[bulletlist][bullet/]Com poder de exército menor +{GLOBAL.StrifeBattleWonWeaker} [devotedact/].[bullet/]Com poder de exército maior +{GLOBAL.StrifeBattleWonStronger} [devotedact/].[/bulletlist][/bulletlist][bullet/]Perca {GLOBAL.DevotionConcept.Hyperlink} por:[bulletlist][bullet/]Entrar em um {GLOBAL.TruceConcept.Hyperlink} -{GLOBAL.StrifeMadeTruce} [undevotedact/], {GLOBAL.DefensivePactConcept.Hyperlink} -{GLOBAL.StrifeMadeCoop} [undevotedact/], ou {GLOBAL.DSAllianceConcept.Hyperlink} -{GLOBAL.StrifeMadePeace} [undevotedact/].[bullet/]Fazer um {GLOBAL.PactOfVassalageConcept.Hyperlink} -{GLOBAL.StrifeMadeVassal} [undevotedact/].[bullet/]Perder uma {GLOBAL.CityConcept.Hyperlink} própria -{GLOBAL.StrifeOwnCityLost} [undevotedact/].[/bulletlist][/bulletlist]"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@STRIFE@DEVOTION_TOOLTIP_DESCRIPTION"
msgstr "{LOC.DLC@WAYSOFWAR@DIPLOMACY@CONCEPT_OATH_STRIFE@NAME}{LOC.DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@STRIFE@DEVOTION_DESCRIPTION}"

