msgid "DLC@GIANTKINGS@RELIC@MENHIR_OF_FIRE@DESCRIPTION"
msgstr "[bulletlist][bullet/]Adiciona {IntRallyPoints} <<m:{GLOBAL.RecruitmentPointsConcept.Hyperlink}>> e a unidade {GLOBAL.UNITS.FIRE_GIANT.Hyperlink} ao {GLOBAL.RequestMilitaryAidConcept.Hyperlink}.[bullet/]Todos os <<m:{GLOBAL.PROPERTIES.GIANT.Hyperlink} >> não heróis e Semideuses que você controla ganham {GLOBAL.PROPERTIES.TSR_MS_RELIC_UNIT_PROP.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@RELIC@MENHIR_OF_FIRE@LORE"
msgstr "\"Funesto o fogo que sacudiu o Henge de Titã[br/]Fulgurando a luz da vingança do Arconte[br/]Bocarras escancaradas do enxame de Lindworm\""

msgid "DLC@GIANTKINGS@RELIC@MENHIR_OF_FIRE@NAME"
msgstr "Menir de Fogo^n"

msgid "DLC@GIANTKINGS@RELIC@MENHIR_OF_FIRE@UNIT_PROP@DESCRIPTION"
msgstr "Unidade tem:[bulletlist][bullet/]+{RELIC_UNIT_EXTRA_DMG>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} em ataques base, [hyperlink,GLOBAL.EnchantingNonRepeatingConcept]aumentado[/hyperlink] para ataques de Tiro Único.[bullet/]+{RELIC_UNIT_EXTRA_RESISTANCE>DEF_MOD>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}[bullet/]+{RELIC_UNIT_EXTRA_RESISTANCE>REDUCTION>Fire} {GLOBAL.FireResistanceConcept.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.VENGEFUL_FLAMES.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.STATUS_EFFECT_IMMUNITY_BURNING.Hyperlink}[/bulletlist]"

