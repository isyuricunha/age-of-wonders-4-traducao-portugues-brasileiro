msgid "DLC@GIANTKINGS@EXPLORATIONSITE_STRATEGIC@FREEPRIMORDIALPRISONER@NAME"
msgstr "Libertar Prisioneiro Primordial"

msgid "DLC@GIANTKINGS@EXPLORATIONSITE_STRATEGIC@GIANTSTHRONE@DESCRIPTION"
msgstr "[bulletlist][bullet/]Todas as <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> possuídas adjacentes a esta Maravilha Ancestral ganham {income} de renda adicional.[bullet/]Adiciona o {GLOBAL.UNITS.ROCK_GIANT.Hyperlink} e o {GLOBAL.UNITS.STORM_GIANT.Hyperlink} ao {GLOBAL.RequestMilitaryAidConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@EXPLORATIONSITE_STRATEGIC@GIANTSTHRONE@LORE"
msgstr "Um monumento palaciano dedicado a um [hyperlink,GLOBAL.GiantsLoreConcept]Rei Gigante dos tempos antigos[/hyperlink], reverenciado como um deus por seus súditos pequenos. Ricamente decorado com ouro e mármore negro, esses Tronos são ecos tênues do esplendor de {GLOBAL.MyrridaLoreConcept.Hyperlink} que outrora abrangia grande parte do {GLOBAL.AstralSeaLoreConcept.Hyperlink}. Apesar de sua idade imensurável, essas estátuas majestosas não apresentam sinais de decadência."

msgid "DLC@GIANTKINGS@EXPLORATIONSITE_STRATEGIC@GIANTSTHRONE@NAME"
msgstr "Trono do Gigante"

msgid "DLC@GIANTKINGS@EXPLORATIONSITE_STRATEGIC@MAGMAPRISON@DESCRIPTION"
msgstr "[bulletlist][bullet/]Ganhe {income} de renda por {GLOBAL.HeroConcept.Hyperlink} em sua {GLOBAL.PrisonConcept.Hyperlink}.[bullet/]Aumenta a chance de capturar Heróis derrotados em sua Prisão para {chance}.[bullet/]Desbloqueia Libertar o Prisioneiro Primordial, uma ação de uso único que concede uma {GLOBAL.UnitConcept.Hyperlink} singularmente poderosa baseada na aventura.[/bulletlist]"

msgid "DLC@GIANTKINGS@EXPLORATIONSITE_STRATEGIC@MAGMAPRISON@LORE"
msgstr "Após suas melhorias nos reinos do {GLOBAL.AstralSeaLoreConcept.Hyperlink}, os {GLOBAL.GiantsLoreConcept.Hyperlink} entraram em conflito com os gigantescos habitantes do {GLOBAL.UrwildernessLoreConcept.Hyperlink}. Quando esses beemotes primordiais não puderam ser destruídos, os Gigantes os prenderam com [hyperlink,GLOBAL.ArchonsLoreConcept]correntes de Arconte[/hyperlink] que drenam sua energia. Conservados em prisões robustas construídas em poças de lava, eles lentamente se tornam mortais."

msgid "DLC@GIANTKINGS@EXPLORATIONSITE_STRATEGIC@MAGMAPRISON@NAME"
msgstr "Prisão de Lava"

msgid "DLC@GIANTKINGS@FORTIFICATION_TACTICAL@CRYSTAL_WALL@NAME"
msgstr "Muralha de Cristal"

msgid "DLC@GIANTKINGS@GIANT_AXE@BONE@NAME"
msgstr "Machado de Gigante de Osso^n"

msgid "DLC@GIANTKINGS@GIANT_AXE@CHARGE_HEAVY@DESCRIPTION"
msgstr "Um ataque Carga Pesada que atinge unidades inimigas em uma linha de {GIANT_AXE_HEAVY_CHARGE_TARGET>AREA>Length} hexes:[bulletlist]{LOC.CONCEPT@CHARGE_SHARED}[bullet/]Cargas Pesadas ignoram {GLOBAL.PROPERTIES.CHARGE_RESISTANCE.Hyperlink}.[/bulletlist]"

