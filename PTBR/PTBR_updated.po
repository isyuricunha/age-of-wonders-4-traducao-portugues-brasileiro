msgid "WILDLIFE_UNITPROPERTIES@FRIGID_BELCH@NAME"
msgstr "Arroto Gélido"

msgid "WILDLIFE_UNITPROPERTIES@FRIGID_BELCH@PROP_NAME"
msgstr "Habilidade Ganha: Arroto Gélido"

msgid "WILDLIFE_UNITPROPERTIES@FROST_AURA@DESCRIPTION"
msgstr "No início do turno, unidades inimigas adjacentes:[bulletlist][bullet/]Sofrem {FROST_AURA_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Têm uma chance base de {SLOWED_RESISTANCE>ResolvedStrength}% de ficarem {GLOBAL.PROPERTIES.SLOWED.Hyperlink} por {SLOWED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@FROST_AURA@NAME"
msgstr "Aura Gélida"

msgid "WILDLIFE_UNITPROPERTIES@FROST_BREATH@NAME"
msgstr "Bafo de Gelo"

msgid "WILDLIFE_UNITPROPERTIES@FROZEN_WEB@DESCRIPTION"
msgstr "Causa dano às unidades inimigas em um cone de {FROZEN_WEBS_TARGETER>AREA>Length} hex."

msgid "WILDLIFE_UNITPROPERTIES@FROZEN_WEB@NAME"
msgstr "Teia Congelada"

msgid "WILDLIFE_UNITPROPERTIES@GREATER_PHASE@NAME"
msgstr "Fase Maior"

msgid "WILDLIFE_UNITPROPERTIES@HEALING_SAP@DESCRIPTION"
msgstr "Esta unidade e todas as unidades amigáveis adjacentes curam +{HEALING_SAP_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>. Esta unidade então entra em {GLOBAL.DefenseModeConcept}."

msgid "WILDLIFE_UNITPROPERTIES@HEALING_SAP@NAME"
msgstr "Seiva Curativa"

msgid "WILDLIFE_UNITPROPERTIES@HINDERING_BLIZZARD@DESCRIPTION"
msgstr "Unidades em um raio de {HINDERING_BLIZZARD_TARGETER>AREA>Radius} hex sofrem dano."

msgid "WILDLIFE_UNITPROPERTIES@HINDERING_BLIZZARD@ENHANCED_DESCRIPTION"
msgstr "Nevasca Impeditiva:[bulletlist][bullet/]Causa um adicional de {HINDERING_BLIZZARD_ENHANCED_DAMAGE>DAMAGE>Frost}{GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Garantidamente inflige {GLOBAL.PROPERTIES.SLOWED.Hyperlink}.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@HINDERING_BLIZZARD@ENHANCED_NAME"
msgstr "Nevasca Impeditiva Aprimorada"

msgid "WILDLIFE_UNITPROPERTIES@HINDERING_BLIZZARD@MASTER_DESCRIPTION"
msgstr "Nevasca Impeditiva:[bulletlist][bullet/]Tem uma chance base de {FROZEN_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.FROZEN.Hyperlink} por {FROZEN_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@HINDERING_BLIZZARD@MASTER_NAME"
msgstr "Nevasca Impeditiva do Campeão"

msgid "WILDLIFE_UNITPROPERTIES@HINDERING_BLIZZARD@NAME"
msgstr "Nevasca Impeditiva"

msgid "WILDLIFE_UNITPROPERTIES@HINDERING_BURST@NAME"
msgstr "Explosão Impeditiva"

msgid "WILDLIFE_UNITPROPERTIES@HOPELESSNESS@DESCRIPTION"
