msgid "DLC@SECRETSOFTHEARCHMAGES@MEGAWONDERS_STRATEGIC@MISTFLOW_GARDEN@LORE"
msgstr "\"These mistflow gardens are places of communion for the Fey folk. Within them, the energy of {GLOBAL.DuathaLoreConcept.Hyperlink} is vibrant, making them ideal ground for all manner of rituals. I myself was judged in one of them by the {GLOBAL.DuathadaeLoreConcept.Hyperlink}. But what followed... is a story for another day.\"[br/][br/]— Ham Binger, Beyond the Mist of the Fey."

msgid "DLC@SECRETSOFTHEARCHMAGES@MEGAWONDERS_STRATEGIC@MISTFLOW_GARDENS@DESCRIPTION"
msgstr "<<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacent to this Landmark gain:[bulletlist][bullet/]{foodbonus} {GLOBAL.FoodConcept.Hyperlink} and {manabonus} {GLOBAL.ManaConcept.Hyperlink}.[bullet/]A {GLOBAL.ConduitConcept.Hyperlink} in the Province grants {happinessbonus} {GLOBAL.CityStabilityConcept.Hyperlink} and {foodbonus2} {GLOBAL.FoodConcept.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.MISTY.Hyperlink}.[/bulletlist][br/]A {GLOBAL.CityConcept.Hyperlink} with {amount} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacent to this Landmark gains:[bulletlist][bullet/]Allows recruitment of Tier I, II, and III {GLOBAL.PROPERTIES.FEY.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>>.[/bulletlist]"

