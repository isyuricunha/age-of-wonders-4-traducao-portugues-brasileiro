msgstr "Os ataques base {GLOBAL.RangedConcept.Hyperlink} da unidade possuem:[bulletlist][bullet/]+{FROST_BLADES_EXTRA_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]{FROST_BLADES_EXTRA_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Uma chance base de {SLOWED_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.SLOWED.Hyperlink}.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CRYOMANCY@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Especialize-se em causar {GLOBAL.FrostDamageConcept.Hyperlink} e infligir {GLOBAL.PROPERTIES.FROZEN.Hyperlink}."

msgid "TOME_CRYOMANCY@TOME@LORE_AUTHOR"
msgstr "Artica, a Fria, Rainha dos Frostlings"

msgid "TOME_CRYOMANCY@TOME@LORE_DESCRIPTION"
msgstr "\"Quando todo o mundo se transformar em gelo, vejo um paraíso puro dos Frostlings! Congelar seus membros e tornar seus ossos quebradiços, sepultados em sangue gelado! Invocar a nevasca para congelar a carne e inspirar medo que remete a um tempo em que os mortais se aglomeravam em cavernas, temendo que o frio os reclamasse...\""

msgid "TOME_CRYOMANCY@TOME@NAME"
msgstr "Tomo de Criomancia"

msgid "TOME_CRYOMANCY@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Causa dano à unidade inimiga alvo."

msgid "TOME_CRYOMANCY@UNIT1@ABILITY1@ENHANCED_DESCRIPTION"
msgstr "Explosão Congelante:[bulletlist][bullet/]Causa um adicional de {FREEZING_BLAST_ENHANCED_DAMAGE>DAMAGE>Frost}{GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]não tem tempo de recarga.[/bulletlist]"

msgid "TOME_CRYOMANCY@UNIT1@ABILITY1@ENHANCED_NAME"
msgstr "Explosão Congelante Aprimorada"

msgid "TOME_CRYOMANCY@UNIT1@ABILITY1@MASTER_DESCRIPTION"
msgstr "Explosão Congelante:[bulletlist][bullet/]Causa um adicional de {FREEZING_BLAST_ENHANCED_DAMAGE>DAMAGE>Frost}{GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Tem uma chance base de {FROZEN_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.FROZEN.Hyperlink}.[/bulletlist]"

msgid "TOME_CRYOMANCY@UNIT1@ABILITY1@MASTER_NAME"
msgstr "Explosão Congelante Campeã"

msgid "TOME_CRYOMANCY@UNIT1@ABILITY1@NAME"
msgstr "Explosão Congelante"

msgid "TOME_CYCLES@ABILITY1@DESCRIPTION"
msgstr "Quando esta unidade mata outra, seus tempos de recarga são resetados."

msgid "TOME_CYCLES@ABILITY1@NAME"
msgstr "Vida da Morte"

msgid "TOME_CYCLES@ABILITY_2@DESCRIPTION"
msgstr "Pequena chance de matar instantaneamente um alvo ferido. Essa chance aumenta quanto menor for os <<m:{GLOBAL.HitPointConcept}>> do alvo. Se não for bem-sucedido, o alvo ganha {amount2} {GLOBAL.PROPERTIES.WEAKENED.Hyperlink}."

msgid "TOME_CYCLES@ABILITY_2@NAME"
msgstr "Fim do Ciclo"

msgid "TOME_CYCLES@ABILITY_3@DESCRIPTION"
msgstr "Unidade amigável alvo:[bulletlist][bullet/]Se estiver viva, cura +{RESTART_THE_CYCLE_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Se estiver morta, é trazida de volta à vida com {RESTART_THE_CYCLE_RESSURECT>ResolvedHitPoints}% de seus <<m:{GLOBAL.HitPointConcept.Hyperlink}>> totais.[/bulletlist]"

msgid "TOME_CYCLES@ABILITY_3@DESCRIPTION_CHAMPION"
msgstr "Reiniciar o Ciclo: [bulletlist][bullet/]Cura um adicional de {healAmount}<<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Ressuscita unidades com um adicional de {resurrectPercentage}% de seus <<m:{GLOBAL.HitPointConcept.Hyperlink}>> totais.[/bulletlist]"

msgid "TOME_CYCLES@ABILITY_3@ERROR_MESSAGE"
msgstr "Requer {GLOBAL.PROPERTIES.LIFE_FROM_DEATH_ABILITY_MODIFIER.Hyperlink} para ser usado."

msgid "TOME_CYCLES@ABILITY_3@NAME"
msgstr "Reiniciar o Ciclo"

msgid "TOME_CYCLES@ABILITY_3@NAME_CHAMPION"
msgstr "Reiniciar o Ciclo Campeão"

msgid "TOME_CYCLES@ABILITY_4@DESCRIPTION"
msgstr "Unidade amigável não-herói alvo é morta, inimigos adjacentes sofrem {SACRIFICIAL_BLIGHT_DAMAGE>DAMAGE>Blight} {GLOBAL.BlightDamageConcept.Hyperlink} por nível da unidade sacrificada.[br/][br/]Esta habilidade sempre aciona {GLOBAL.PROPERTIES.LIFE_FROM_DEATH_ABILITY_MODIFIER.Hyperlink},"

msgid "TOME_CYCLES@ABILITY_4@NAME"
msgstr "Calamidade Sacrificial"

msgid "TOME_CYCLES@HERO_SKILL@DESCRIPTION"
msgstr "Ataques base ganham uma chance base de {DECAYING_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.DECAYING.Hyperlink}.[br/][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CYCLES@HERO_SKILL@NAME"
msgstr "Decaimento Murchante"

msgid "TOME_CYCLES@PASSIVE@DESCRIPTION"
msgstr "Reduções na moral que surgem da morte de unidades amigáveis são reduzidas pela metade."

msgid "TOME_CYCLES@PASSIVE@NAME"
msgstr "Ciclo da Vida"

msgid "TOME_CYCLES@SKILL1@DESCRIPTION"
msgstr "Faz com que os ataques base de unidades encantadas:[bulletlist][bullet/]Infligam {GLOBAL.PROPERTIES.DECAYING.Hyperlink}, um efeito de dano ao longo do tempo que diminui a cura recebida.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CYCLES@SKILL1@NAME"
msgstr "Lâmina da Decomposição"

msgid "TOME_CYCLES@SKILL1@PROP_DESCRIPTION"
msgstr "Ataques base da unidade:[bulletlist][bullet/]Infligem {GLOBAL.PROPERTIES.DECAYING.Hyperlink}.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CYCLES@SKILL2@DESCRIPTION"
msgstr "{GLOBAL.PROPERTIES.SUPPORT_UNIT.Hyperlink} que manipula a vida e a morte como parte do ciclo natural."

msgid "TOME_CYCLES@SKILL2@NAME"
msgstr "Druida do Ciclo^n"

msgid "TOME_CYCLES@SKILL3@DESCRIPTION"
msgstr "Unidade inimiga alvo:[bulletlist][bullet/]Sofre {DIFFUSE_HEALTH_DAMAGE>DAMAGE>Blight} {GLOBAL.BlightDamageConcept.Hyperlink}.[bullet/]Ganha {amountDecaying} {GLOBAL.PROPERTIES.DECAYING_DAMAGE_OVER_TIME.Hyperlink}.[/bulletlist][br/]Unidades amigáveis em um alcance de {DIFFUSE_HEALTH_UNIT_TARGETER_FRIENDLY>AREA>Radius} hexágonos. [bulletlist][bullet/]Cura +{DIFFUSE_HEALTH_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Ganha {amountRegeneration} {GLOBAL.PROPERTIES.REGENERATION.Hyperlink}.[/bulletlist]"

msgid "TOME_CYCLES@SKILL3@NAME"
msgstr "Difusão de Saúde"

msgid "TOME_CYCLES@SKILL4@DESCRIPTION"
msgstr "Até o final da batalha, sempre que uma unidade amigável morrer, todas as outras unidades amigáveis dentro de {PARTING_GIFTS_UNIT_TARGETER_CIRCLE>AREA>Radius} hexágonos curam +{PARTING_GIFTS_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>."

msgid "TOME_CYCLES@SKILL4@NAME"
msgstr "Presentes de Despedida"

msgid "TOME_CYCLES@SKILL4@PROP_DESCRIPTION"
msgstr "Quando esta unidade morrer, unidades amigáveis dentro de {amount} hexágonos a curam +{amount2} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>."

msgid "TOME_CYCLES@SKILL5@AUTUMN_DESCRIPTION"
msgstr "Inimigos do dono são infligidos com {amount4} {GLOBAL.PROPERTIES.WEAKENED.Hyperlink}."

msgid "TOME_CYCLES@SKILL5@AUTUMN_NAME"
msgstr "Ciclo das Estações: Outono"

msgid "TOME_CYCLES@SKILL5@DESCRIPTION"
msgstr "Todas as batalhas que ocorrem no domínio da cidade alvo ganham [abilityblue]Ciclo das Estações[/abilityblue], concedendo um efeito diferente a cada turno de batalha na seguinte ordem:[bulletlist][bullet/]Inverno: Todos os inimigos sofrem {amount} [damageFrost/].[bullet/]Primavera: Todas as unidades amigáveis tornam-se {amount2} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}.[bullet/]Verão: Todas as unidades amigáveis curam +{amount3} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Outono: Todos os inimigos tornam-se {amount4} {GLOBAL.PROPERTIES.WEAKENED.Hyperlink}.[/bulletlist]"

msgid "TOME_CYCLES@SKILL5@DISPLAY_DESCRIPTION"
msgstr "Concede um efeito diferente a cada turno na seguinte ordem:"

msgid "TOME_CYCLES@SKILL5@NAME"
msgstr "Ciclo das Estações"

msgid "TOME_CYCLES@SKILL5@SPRING_DESCRIPTION"
msgstr "Unidades do dono tornam-se {amount2} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}."

msgid "TOME_CYCLES@SKILL5@SPRING_NAME"
msgstr "Ciclo das Estações: Primavera"

msgid "TOME_CYCLES@SKILL5@SUMMER_DESCRIPTION"
msgstr "Unidades do dono curam +{amount3}<<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>."

msgid "TOME_CYCLES@SKILL5@SUMMER_NAME"
msgstr "Ciclo das Estações: Verão"

msgid "TOME_CYCLES@SKILL5@WINTER_NAME"
msgstr "Ciclo das Estações: Inverno"

msgid "TOME_CYCLES@SKILL5@WINTER_PROP_DESCRIPTION"
msgstr "Inimigos do dono sofrem {amount} {GLOBAL.FrostDamageConcept.Hyperlink}."

msgid "TOME_CYCLES@SKILL6@DESCRIPTION"
msgstr "Torna os ataques base {GLOBAL.RangedConcept.Hyperlink} e {GLOBAL.MagicConcept.Hyperlink} das unidades encantadas:[bulletlist][bullet/]Ganha uma chance base de {LIFE_SEED_RESISTANCE_CHECK>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.LIFE_SEED_ON_DEATH.Hyperlink} por {LIFE_SEED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Causa +{BLOOMING_PROJECTILES_DAMAGE_MULTIPLIER>ResolvedMultiplier}% de dano contra unidades {GLOBAL.PROPERTIES.DECAYING.Hyperlink}.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CYCLES@SKILL6@NAME"
msgstr "Projéteis Florescentes"

msgid "TOME_CYCLES@SKILL6@PROP_DESCRIPTION"
msgstr "Ataques base {GLOBAL.RangedConcept.Hyperlink} e {GLOBAL.MagicConcept.Hyperlink} da unidade têm:[bulletlist][bullet/]Uma chance base de {LIFE_SEED_RESISTANCE_CHECK>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.LIFE_SEED_ON_DEATH.Hyperlink} por {LIFE_SEED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]+{BLOOMING_PROJECTILES_DAMAGE_MULTIPLIER>ResolvedMultiplier}% de dano contra unidades {GLOBAL.PROPERTIES.DECAYING.Hyperlink}.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CYCLES@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Domine os ciclos naturais da vida e da morte e especialize-se em debilitar inimigos e curar aliados."

msgid "TOME_CYCLES@TOME@LORE_AUTHOR"
msgstr "Serena, Feiticeira Élfica da Vida"

msgid "TOME_CYCLES@TOME@LORE_DESCRIPTION"
msgstr "\"Há um ciclo em todas as coisas. A besta se alimenta de sua presa, ganhando força. O cadáver apodrece, nutrindo a terra. A vida dá lugar à morte, que, por sua vez, dá lugar a mais vida. Domine esse fluxo e refluxo, e você descobrirá que pode manipular tanto seus dons quanto o preço que exige!\""

msgid "TOME_CYCLES@TOME@NAME"
msgstr "Tomo dos Ciclos"

msgid "TOME_CYCLES@UNIT@NAME"
msgstr "Druida do Ciclo"

msgid "TOME_DEMON_GATE@HERO_SKILL@DESCRIPTION"
msgstr "Enquanto esta unidade for o líder do exército, unidades amigáveis não-{GLOBAL.PROPERTIES.FIEND} e não-{GLOBAL.HeroConcept} no exército:[bulletlist][bullet/]Transformam-se em {GLOBAL.PROPERTIES.FIEND} de Nível I <<m:{GLOBAL.PROPERTIES.FIEND.Hyperlink}>> ao morrer em batalha.[bullet/]Têm uma pequena chance de se transformar em {GLOBAL.PROPERTIES.FIEND} de Nível II <<m:{GLOBAL.PROPERTIES.FIEND.Hyperlink}>> em vez disso.[/bulletlist]"

msgid "TOME_DEMON_GATE@HERO_SKILL@NAME"
msgstr "Hino Demoníaco"

msgid "TOME_DEMON_GATE@HERO_SKILL@PROP_DESCRIPTION"
msgstr "Quando esta unidade morre, ela se transforma em um {GLOBAL.PROPERTIES.FIEND} de Nível I. Tem uma pequena chance de se transformar em um {GLOBAL.PROPERTIES.FIEND} de Nível II em vez disso."

msgid "TOME_DEMON_GATE@PASSIVE@DESCRIPTION"
msgstr "Quando uma unidade amigável não-{GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink} morre em batalha, tem uma chance de {chance}% de gerar um {GLOBAL.PROPERTIES.FIEND.Hyperlink} de Nível {tier} até o final da batalha."

msgid "TOME_DEMON_GATE@PASSIVE@NAME"
msgstr "Portal da Morte"

msgid "TOME_DEMON_GATE@PASSIVE@PROPERTY@DESCRIPTION"
msgstr "Quando esta unidade morre, tem uma chance de {chance}% de gerar um {GLOBAL.PROPERTIES.INFERNAL_FIEND.Hyperlink} de Nível {tier} até o final da batalha."

msgid "TOME_DEMON_GATE@SKILL1@DESCRIPTION"
msgstr "A cidade alvo perde {amount} {GLOBAL.PopulationConcept.Hyperlink} e gera um {GLOBAL.UNITS.BALOR.Hyperlink}, uma unidade mítica que causa estragos em seus inimigos."

msgid "TOME_DEMON_GATE@SKILL1@NAME"
msgstr "Invocar Balor"

msgid "TOME_DEMON_GATE@SKILL2@DESCRIPTION"
msgstr "Escolha uma de suas {GLOBAL.IndependentCityConcept.Hyperlink} <<m:{GLOBAL.PvEVassalConcept.Hyperlink}>>:[bulletlist][bullet/]Invocar {summon} {GLOBAL.PROPERTIES.FIEND.Hyperlink} aleatórios sob seu controle, um será de Nível III e o outro de Nível IV.[bullet/]O {GLOBAL.PvEVassalConcept.Hyperlink} perde:[bulletlist][bullet/]Um estágio diplomático de {GLOBAL.VassalagePhaseConcept.Hyperlink}.[bullet/]{pop} {GLOBAL.PopulationConcept.Hyperlink}.[/bulletlist][/bulletlist][br/]Não pode ser lançado em um {GLOBAL.PactOfVassalageLvl-3Concept.Hyperlink}."

msgid "TOME_DEMON_GATE@SKILL2@NAME"
msgstr "Invocação Demoníaca"

msgid "TOME_DEMON_GATE@SKILL3@DESCRIPTION"
msgstr "Duas unidades {GLOBAL.PROPERTIES.FIEND.Hyperlink} do mesmo Nível no exército alvo lutam entre si. Uma morre e a outra se transforma em um {GLOBAL.PROPERTIES.FIEND.Hyperlink} com um Nível um nível mais alto do que antes."

msgid "TOME_DEMON_GATE@SKILL3@DIALOG_SUBHEADER"
msgstr "Vários demônios emergem através da fuligem e das chamas, disputando a honra de servir a você."

msgid "TOME_DEMON_GATE@SKILL3@NAME"
msgstr "Lutar pelo Poder"

msgid "TOME_DEMON_GATE@SKILL4@DESCRIPTION"
msgstr "A unidade amigável alvo explode e unidades inimigas dentro de {SACRIFICIAL_SLAUGHTER_UNIT_TARGETER_CIRCLE>AREA>Radius} hexágonos:[bulletlist][bullet/]Sofrem {SACRIFICIAL_SLAUGHTER_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} mais {SACRIFICIAL_SLAUGHTER_TIER_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} por Nível da unidade sacrificada.[bullet/]Sofrem um {GLOBAL.NegativeStatusEffectConcept.Hyperlink} aleatório por Nível da unidade sacrificada.[/bulletlist]"

msgid "TOME_DEMON_GATE@SKILL4@NAME"
msgstr "Massacre Sacrificial"

msgid "TOME_DEMON_GATE@SKILL5@DESCRIPTION"
msgstr "{GLOBAL.ProvinceConcept.Hyperlink} alvo:[bulletlist][bullet/]Unidades inimigas <<m:{GLOBAL.UnitConcept.Hyperlink}>> sofrem -{amount} {GLOBAL.FireResistanceConcept.Hyperlink} por {duration} {GLOBAL.WorldMapConcept.Hyperlink} {GLOBAL.TurnConcept}.[bullet/]As províncias ganham {GLOBAL.AshlandsConcept.Hyperlink}.[bullet/]As províncias perdem {GLOBAL.RiverConcept.Hyperlink}, {GLOBAL.FertilePlainsConcept.Hyperlink}, {GLOBAL.SwampConcept.Hyperlink}, {GLOBAL.SnowConcept.Hyperlink}, {GLOBAL.FrozenWasteConcept.Hyperlink}, {GLOBAL.SandConcept.Hyperlink}, {GLOBAL.CavernFloorConcept.Hyperlink} e {GLOBAL.GloomTerrainConcept.Hyperlink}.[bullet/]Invoca um {GLOBAL.UNITS.MAGMA_SPIRIT.Hyperlink} no hexágono alvo.[/bulletlist]"

msgid "TOME_DEMON_GATE@SKILL5@NAME"
msgstr "Chamas Abissais"

msgid "TOME_DEMON_GATE@SKILL5@PROP_DESCRIPTION"
msgstr "{ABYSSAL_FLAMES_FIRE_RESISTANCE>REDUCTION>Fire} {GLOBAL.FireResistanceConcept.Hyperlink}"

msgid "TOME_DEMON_GATE@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Abra fissuras para invocar <<m:{GLOBAL.PROPERTIES.FIEND.Hyperlink}>> e queime o mundo em seu rastro."

msgid "TOME_DEMON_GATE@TOME@LORE_AUTHOR"
msgstr "Kruul, Senhor da Peste, Príncipe do Caos"

msgid "TOME_DEMON_GATE@TOME@LORE_DESCRIPTION"
msgstr "\"Aqueles que dominam a arte da convocação sempre terão aliados prontos, embora talvez não totalmente dispostos. Demônios podem ser aterrorizantes para alguns, mas, se devidamente convocados, são os servos mais valiosos que um Godir pode encontrar. Claro, eles prefeririam arrancar a carne do seu rosto se pudessem... mas não podem, então o ponto é irrelevante!\""

msgid "TOME_DEMON_GATE@TOME@NAME"
msgstr "Tomo do Portal Demoníaco"

msgid "TOME_DEMON_GATE@UNIT@NAME"
msgstr "Balor^n"

msgid "TOME_DEMON_GATE@UNIT_ABILITY_1@DESCRIPTION"
msgstr "Quando esta unidade morre, unidades em um raio de {DEATH_EXPLOSION_UNIT_TARGETER>AREA>Radius} hexágonos:[bulletlist][bullet/]Sofrem {DEATH_EXPLOSION_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}. Metade para unidades amigáveis.[bullet/]Ficam {GLOBAL.PROPERTIES.BURNING.Hyperlink} por {BURNING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "TOME_DEMON_GATE@UNIT_ABILITY_1@NAME"
msgstr "Explosão da Morte"

msgid "TOME_DEMON_GATE@UNIT_ABILITY_2@DESCRIPTION"
msgstr "Unidade alvo:[bulletlist][bullet/]Sofre dano.[bullet/]Ganha {GLOBAL.PROPERTIES.BERSERK.Hyperlink} e {GLOBAL.PROPERTIES.CHAOS_BRAND_ON_DEATH.Hyperlink} até o final da batalha.[/bulletlist][br/]Não pode afetar Heróis, Demônios ou unidades de Cerco."

msgid "TOME_DEMON_GATE@UNIT_ABILITY_2@NAME"
msgstr "Marca do Caos"

msgid "TOME_DEMON_GATE@UNIT_ABILITY_3@DESCRIPTION"
msgstr "Causa dano em uma linha de {SUNDER_THE_EARTH_OBSTACLE_TARGETER_LINE>AREA>Length} hexágonos que tem {hexwide} hexágonos de largura.[br/]Unidades atingidas sofrem {amount} {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink}."

msgid "TOME_DEMON_GATE@UNIT_ABILITY_3@NAME"
msgstr "Fender a Terra"

msgid "TOME_DEVASTATION@PASSIVE@DESCRIPTION"
msgstr "Saquear <<m:{GLOBAL.ProvinceConcept}>> rende +{amount} extra {GLOBAL.GoldConcept.Hyperlink}."

msgid "TOME_DEVASTATION@PASSIVE@NAME"
msgstr "Saques Minuciosos"

msgid "TOME_DEVASTATION@SKILL5@DESCRIPTION"
msgstr "Concede ataques de unidades encantadas:[bulletlist][bullet/]{GLOBAL.PROPERTIES.DEMOLISHER.Hyperlink}, que permite destruir obstáculos {GLOBAL.FortifiedConcept.Hyperlink}.[bullet/]Uma chance base de {FOCUS_OF_DEVASTATION_RESISTANCE_CHECK>ResolvedStrength}% de cancelar <<m:{GLOBAL.DefenseModeConcept.Hyperlink}>>.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_DEVASTATION@SKILL5@MODIFIER_DESCRIPTION"
msgstr "Concede uma chance de {FOCUS_OF_DEVASTATION_RESISTANCE_CHECK>ResolvedStrength}% de cancelar {GLOBAL.DefenseModeConcept}."

msgid "TOME_DEVASTATION@SKILL5@NAME"
msgstr "Foco da Devastação"

msgid "TOME_DEVASTATION@SKILL5@PROPERTY_DESCRIPTION"
