msgid "DLC@RISEFROMRUIN@EXPLORATIONSITES_STRATEGIC@ANCIENT_WONDERS@WITHERED_TREE@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{amount} {GLOBAL.FoodConcept.Hyperlink} e +{amount} {GLOBAL.StructureProductionConcept.Hyperlink} por {GLOBAL.ProvinceConcept.Hyperlink} com {GLOBAL.SandConcept.Hyperlink} ou {GLOBAL.AstralBarrensConcept.Hyperlink} na {GLOBAL.CityConcept.Hyperlink} {GLOBAL.DomainConcept.Hyperlink}.[bullet/]Adiciona a unidade {GLOBAL.UNITS.CARRION_BIRD.Hyperlink} ao {GLOBAL.RequestMilitaryAidConcept.Hyperlink}.[bullet/]Desbloqueia a ação Restaurar que transforma esta {GLOBAL.AncientWonderConcept.Hyperlink} em uma {GLOBAL.STRUCTURES.WORLD_TREE.Hyperlink}.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@EXPLORATIONSITES_STRATEGIC@ANCIENT_WONDERS@WITHERED_TREE@LORE"
msgstr "Apenas esta carcaça de madeira permanece de uma poderosa {GLOBAL.STRUCTURES.WORLD_TREE.Hyperlink}, que são testemunhos da resiliência descontrolada da vida. Suas raízes já cresceram profundas e longas, seus galhos altos e compridos; nutriram, curaram e protegeram tudo o que vive e cresce entre eles. Portanto, a morte de uma Árvore do Mundo, que apenas uma força devastadora poderia causar, é uma afronta à própria vida."

