msgstr "Quando expirar, escombros em chamas cairão, e unidades dentro de {range} [range/] sofrerão {damagephysical} [damagePhysical/] e {damagefire} [damageFire/]. As hexes alvo ganharão {GLOBAL.OnFireConcept.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@CRASHING_RUBBLE@NAME"
msgstr "Escombros em Queda"

msgid "COMBATPROPERTIES_TACTICAL@CURSE_OF_THE_GORGON@DESCRIPTION"
msgstr "No início da batalha, uma unidade é escolhida secretamente como alvo da maldição. Esse alvo ficará {GLOBAL.PROPERTIES.STUNNED.Hyperlink} em {duration} [turn/] se ainda estiver vivo, e um novo alvo será então escolhido."

msgid "COMBATPROPERTIES_TACTICAL@CURSE_OF_THE_GORGON@NAME"
msgstr "Maldição da Górgona"

msgid "COMBATPROPERTIES_TACTICAL@CURSE_OF_THE_GORGON@PROPERTY@DESCRIPTION"
msgstr "Quando expirar, a unidade ficará {GLOBAL.PROPERTIES.STUNNED.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@CURSE_OF_THE_GORGON@VISIBLE@DESCRIPTION"
msgstr "No início da batalha, uma unidade é escolhida secretamente como alvo da maldição. Esse alvo ficará {GLOBAL.PROPERTIES.STUNNED.Hyperlink} em {duration} [turn/] se ainda estiver vivo, e um novo alvo será escolhido.[br/][br/]Você pode ver quem é o alvo da maldição."

msgid "COMBATPROPERTIES_TACTICAL@CURSE_OF_THE_GORGON@VISIBLE@NAME"
msgstr "Maldição Visível da Górgona"

msgid "COMBATPROPERTIES_TACTICAL@DAMAGED_ARMY@DESCRIPTION"
msgstr "Unidades atacantes sofrem {damage} [damagePhysical/] no início do combate."

msgid "COMBATPROPERTIES_TACTICAL@DAMAGED_ARMY@NAME"
msgstr "Atacantes Danificados"

msgid "COMBATPROPERTIES_TACTICAL@DAMAGED_ENEMIES@DESCRIPTION"
msgstr "Unidades defensoras sofrem {damage} [damagePhysical/] no início do combate."

msgid "COMBATPROPERTIES_TACTICAL@DAMAGED_ENEMIES@NAME"
msgstr "Defensores Danificados"

msgid "COMBATPROPERTIES_TACTICAL@DELAYED_DISPLACING_REALITY@NAME"
msgstr "Realidade Deslocada Adiada"

msgid "COMBATPROPERTIES_TACTICAL@DEMON_SUMMONING@DESCRIPTION"
msgstr "Em {turns} [turn/], um {GLOBAL.UNITS.BALOR.Hyperlink} será invocado no lado do defensor."

msgid "COMBATPROPERTIES_TACTICAL@DEMON_SUMMONING@NAME"
msgstr "Invocação Demoníaca"

msgid "COMBATPROPERTIES_TACTICAL@DEMON_SUMMONING_DELAYED@NAME"
msgstr "Invocação Demoníaca Adiada"

msgid "COMBATPROPERTIES_TACTICAL@DEMON_SUMMONING_HASTENED@NAME"
msgstr "Invocação Demoníaca Acelerada"

msgid "COMBATPROPERTIES_TACTICAL@DEMON_SUMMONING_SEIZED@NAME"
msgstr "Invocação Demoníaca Tomada"

msgid "COMBATPROPERTIES_TACTICAL@DIRE_PENGUIN_MENACE@DESCRIPTION"
msgstr "Todas as unidades defensoras foram transformadas em Pinguins Terríveis."

msgid "COMBATPROPERTIES_TACTICAL@DIRE_PENGUIN_MENACE@NAME"
msgstr "Ameaça dos Pinguins Terríveis"

msgid "COMBATPROPERTIES_TACTICAL@DISCOURAGED@DESCRIPTION"
msgstr "Todas as unidades atacantes têm {morale} {GLOBAL.UnitMoraleConcept.Hyperlink} até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@DISCOURAGED@NAME"
msgstr "Atacantes Desanimados"

msgid "COMBATPROPERTIES_TACTICAL@DISCOURAGED_ENEMIES@DESCRIPTION"
msgstr "Todas as unidades defensoras têm {morale} {GLOBAL.UnitMoraleConcept.Hyperlink} até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@DISCOURAGED_ENEMIES@NAME"
msgstr "Defensores Desanimados"

msgid "COMBATPROPERTIES_TACTICAL@DISPERSE_MIST@DESCRIPTION"
msgstr "Invocar ventos para dispersar {value} das nuvens de névoa."

msgid "COMBATPROPERTIES_TACTICAL@DISPERSE_MIST@NAME"
msgstr "Dispersar Névoa"

msgid "COMBATPROPERTIES_TACTICAL@DISPLACING_REALITY@DESCRIPTION"
msgstr "A cada {turn} [turn/], todas as unidades são teletransportadas em {range} hexes."

msgid "COMBATPROPERTIES_TACTICAL@DISPLACING_REALITY@NAME"
msgstr "Realidade Deslocada"

msgid "COMBATPROPERTIES_TACTICAL@DISTRACTED_ARMY@DESCRIPTION"
msgstr "Todas as unidades atacantes têm {GLOBAL.PROPERTIES.DISTRACTED.Hyperlink} até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@DISTRACTED_ARMY@NAME"
msgstr "Atacantes Distraídos"

msgid "COMBATPROPERTIES_TACTICAL@DRACONIC_CATALYST@DESCRIPTION"
msgstr "Quando um Dragão Vermelho tem {GLOBAL.PROPERTIES.DRACONIC_RAGE.Hyperlink}, todas as unidades atacantes têm {chanceBurning} de chance de sofrer {GLOBAL.PROPERTIES.BURNING.Hyperlink} a cada turno.[br/][br/]Quando um Dragão Azul tem {GLOBAL.PROPERTIES.DRACONIC_RAGE.Hyperlink}, todas as unidades atacantes têm {chanceFrozen} de chance de ficar {GLOBAL.PROPERTIES.FROZEN.Hyperlink} a cada turno."

msgid "COMBATPROPERTIES_TACTICAL@DRACONIC_CATALYST@NAME"
msgstr "Catalisador Dracônico"

msgid "COMBATPROPERTIES_TACTICAL@ELECTRIFIED@DESCRIPTION"
msgstr "[bulletlist][bullet/]A unidade sofre {ELECRIFIED_DAMAGE_OVER_TIME>ATTACK>Shock} de {GLOBAL.LightningDamageConcept.Hyperlink} a cada [turn/].[bullet/]Acumula até {stacksMax} vezes.[/bulletlist]"

msgid "COMBATPROPERTIES_TACTICAL@ELECTRIFIED@NAME"
msgstr "Eletrizado"

msgid "COMBATPROPERTIES_TACTICAL@ENCOURAGED@DESCRIPTION"
msgstr "Todas as unidades atacantes têm {morale} de {GLOBAL.UnitMoraleConcept.Hyperlink} até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@ENCOURAGED@NAME"
msgstr "Atacantes Encorajados"

msgid "COMBATPROPERTIES_TACTICAL@ENCOURAGED_ENEMIES@DESCRIPTION"
msgstr "Todas as unidades defensoras têm {morale} de {GLOBAL.UnitMoraleConcept.Hyperlink} até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@ENCOURAGED_ENEMIES@NAME"
msgstr "Defensores Encorajados"

msgid "COMBATPROPERTIES_TACTICAL@ENDLESS_TREASURE@DESCRIPTION"
msgstr "A área está repleta de pilhas de moedas falsas e sem valor, que [abilityred]desaceleram[/abilityred] unidades e podem ser perigosas ao receber Dano de {damageshock/} Choque."

msgid "COMBATPROPERTIES_TACTICAL@ENDLESS_TREASURE@NAME"
msgstr "Tesouro Infinito"

msgid "COMBATPROPERTIES_TACTICAL@ETERNALSERVANTS@DESCRIPTION"
msgstr "Os Servos Mortos-Vivos lutam para proteger a Rainha Morta-Viva![br/][br/]Todas as unidades defensoras ressuscitam após {turn} {GLOBAL.TurnConcept} depois de serem mortas pela primeira vez.[br/][br/]Destruir o {GLOBAL.HeroConcept.Hyperlink} defensor mata instantaneamente todos os inimigos."

msgid "COMBATPROPERTIES_TACTICAL@ETERNALSERVANTS@NAME"
msgstr "Servos Mortos-Vivos"

msgid "COMBATPROPERTIES_TACTICAL@EXPEDITION_LEADER@DESCRIPTION"
msgstr "O Herói que lidera este exército é o Líder da Expedição. Se o Líder da Expedição fugir ou morrer, mas a batalha for vencida, as forças restantes reviverão o Líder da Expedição após a batalha."

msgid "COMBATPROPERTIES_TACTICAL@EXPEDITION_LEADER@NAME"
msgstr "Líder da Expedição"

msgid "COMBATPROPERTIES_TACTICAL@FIRESTARTER@DESCRIPTION"
msgstr "Várias áreas e obstáculos inflamáveis estão {GLOBAL.OnFireConcept.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@FIRESTARTER@NAME"
msgstr "Fogo Descontrolado"

msgid "COMBATPROPERTIES_TACTICAL@FIRE_IMMUNITY@DESCRIPTION"
msgstr "Até o fim da batalha, todas as unidades atacantes são imunes a sofrer {GLOBAL.PROPERTIES.BURNING.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@FIRE_IMMUNITY@NAME"
msgstr "Imunidade a Queimando (Atacantes)"

msgid "COMBATPROPERTIES_TACTICAL@FOCUSED_GAZE@DESCRIPTION"
msgstr "Os ataques base {GLOBAL.RangedConcept.Hyperlink} e {GLOBAL.MagicConcept.Hyperlink} de todas as unidades defensoras ganham +{FOCUSED_GAZE_RANGE_BOOST>ADD>MaxRange} de {GLOBAL.RangeConcept.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@FOCUSED_GAZE@NAME"
msgstr "Olhar Focado"

msgid "COMBATPROPERTIES_TACTICAL@FOCUSSED_GAZE@NAME"
msgstr "Olhar Focado"

msgid "COMBATPROPERTIES_TACTICAL@FREEZING_WINDS@DESCRIPTION"
msgstr "A cada {timer} [turn/], todas as unidades atacantes sofrem {damage} e têm {chance} de chance de ficar {GLOBAL.PROPERTIES.FROZEN.Hyperlink}. Se falhar, as unidades sofrem {GLOBAL.SlowingConcept.Hyperlink} em vez disso."

msgid "COMBATPROPERTIES_TACTICAL@FREEZING_WINDS@NAME"
msgstr "Ventos Congelantes"

msgid "COMBATPROPERTIES_TACTICAL@FRIGID_WINDS@DESCRIPTION"
msgstr "Após um Relâmpago da Tempestade de Relâmpagos atingir, todas as unidades defensoras recebem {damage} de {GLOBAL.FrostDamageConcept.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@FRIGID_WINDS@NAME"
msgstr "Ventos Gélidos"

msgid "COMBATPROPERTIES_TACTICAL@GORGING_PREDATORS@DESCRIPTION"
msgstr "Todas as unidades defensoras possuem a habilidade {GLOBAL.PROPERTIES.VIOLENT_GORGING.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@GORGING_PREDATORS@NAME"
msgstr "Predadores Vorazes"

msgid "COMBATPROPERTIES_TACTICAL@HASTEFUL_ONSLAUGHT@DESCRIPTION"
msgstr "Unidades Defensoras possuem {GLOBAL.PROPERTIES.HASTENED.Hyperlink}, {GLOBAL.PROPERTIES.SWIFT.Hyperlink} e {GLOBAL.PROPERTIES.SLIPPERY.Hyperlink} até o fim do combate."

msgid "COMBATPROPERTIES_TACTICAL@HASTEFUL_ONSLAUGHT@NAME"
msgstr "Velocidade Sobrenatural"

msgid "COMBATPROPERTIES_TACTICAL@HASTENED_ARMY@DESCRIPTION"
msgstr "No início da batalha, todas as unidades atacantes possuem {GLOBAL.PROPERTIES.HASTENED.Hyperlink} por {time} [turno/]."

msgid "COMBATPROPERTIES_TACTICAL@HASTENED_ARMY@NAME"
msgstr "Atacantes Acelerados"

msgid "COMBATPROPERTIES_TACTICAL@HASTENED_ENEMIES@DESCRIPTION"
msgstr "No início da batalha, todas as unidades defensoras possuem {GLOBAL.PROPERTIES.HASTENED.Hyperlink} por {time} [turno/]."

msgid "COMBATPROPERTIES_TACTICAL@HASTENED_ENEMIES@NAME"
msgstr "Defensores Acelerados"

msgid "COMBATPROPERTIES_TACTICAL@HASTENING_STORM@DESCRIPTION"
msgstr "No início de um turno, durante os próximos {TimeToLive} <<m:{GLOBAL.TurnConcept}>>, uma unidade atacante aleatória sofre {Shock} {GLOBAL.LightningDamageConcept.Hyperlink}, mas também se torna {GLOBAL.PROPERTIES.HASTENED.Hyperlink} por {valueOfHaste} {GLOBAL.TurnConcept}."

msgid "COMBATPROPERTIES_TACTICAL@HASTENING_STORM@NAME"
msgstr "Tempestade Aceleradora"

msgid "COMBATPROPERTIES_TACTICAL@HIDDEN_TRAPS@DESCRIPTION"
msgstr "Várias armadilhas ocultas estão espalhadas pelo mapa! Se uma unidade passar por cima delas, será afetada por {GLOBAL.PROPERTIES.BLEEDING.Hyperlink} por {turns} <<m:{GLOBAL.TurnConcept}>> e revelará a armadilha! [br/][br/]Não afeta unidades com {GLOBAL.PROPERTIES.FLOATING_MOVEMENT.Hyperlink}, {GLOBAL.PROPERTIES.FLYING_MOVEMENT.Hyperlink} ou {GLOBAL.PROPERTIES.ETHEREAL.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@HIDDEN_TRAPS@NAME"
msgstr "Armadilhas Ocultas"

msgid "COMBATPROPERTIES_TACTICAL@IMMUMESEDUCED@DESCRIPTION"
msgstr "Todas as unidades atacantes estão {GLOBAL.PROPERTIES.IMMUMESEDUCED.Hyperlink} até o fim da batalha!"

msgid "COMBATPROPERTIES_TACTICAL@LEECHING_FROM_NATURE@DESCRIPTION"
msgstr "O Deus Chifrudo defensor está drenando poder da natureza ao redor. A cada {GLOBAL.TurnConcept}, todos os obstáculos {GLOBAL.FloraObstacleConcept.Hyperlink} em um alcance de {range} hexes são consumidos, curando o Deus Chifrudo em +{healamount} [hp/] e concedendo {stackamount} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} por {duration} <<m:{GLOBAL.TurnConcept}>>."

msgid "COMBATPROPERTIES_TACTICAL@LEECHING_FROM_NATURE@NAME"
msgstr "Drenagem da Natureza"

msgid "COMBATPROPERTIES_TACTICAL@LIGHTNING_RESISTANCE@DESCRIPTION"
msgstr "Até o fim do combate, as unidades defensoras ganham Proteção Adicional contra Relâmpago."

msgid "COMBATPROPERTIES_TACTICAL@LIGHTNING_RESISTANCE@NAME"
msgstr "Proteção Avançada contra Relâmpago"

msgid "COMBATPROPERTIES_TACTICAL@LIGHTNING_STORM@DESCRIPTION"
msgstr "No início de um turno, durante os próximos {TimeToLive} <<m:{GLOBAL.TurnConcept}>>, uma unidade atacante aleatória sofre {Shock} {GLOBAL.LightningDamageConcept.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@LIGHTNING_STORM@NAME"
msgstr "Tempestade de Relâmpagos"

msgid "COMBATPROPERTIES_TACTICAL@LITTERED_CORPSES@DESCRIPTION"
msgstr "Vários cadáveres estão espalhados pelo mapa. Eles podem ser úteis para necromancia..."

msgid "COMBATPROPERTIES_TACTICAL@LITTERED_CORPSES@NAME"
msgstr "Repleto de Cadáveres"

msgid "COMBATPROPERTIES_TACTICAL@LOST_PUPPETEER@DESCRIPTION"
msgstr "A cada {Cooldown} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, uma das unidades do atacante se torna permanentemente {GLOBAL.PROPERTIES.MIND_CONTROLLED.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@LOST_PUPPETEER@NAME"
msgstr "Sussurros Sombrios"

msgid "COMBATPROPERTIES_TACTICAL@LOST_PUPPETEER_IMMUNITY@DESCRIPTION"
msgstr "Unidades atacantes que são {GLOBAL.PROPERTIES.FAITHFUL.Hyperlink} ganham {GLOBAL.ControlLossImmunityConcept.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@LOST_PUPPETEER_IMMUNITY@NAME"
msgstr "Lealdade Fiel"

msgid "COMBATPROPERTIES_TACTICAL@LOST_PUPPETEER_REVERSE@DESCRIPTION"
msgstr "Após os primeiros {NumberOfTurns} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, force uma das unidades defensoras a se tornar {GLOBAL.PROPERTIES.MIND_CONTROLLED.Hyperlink} e lutar por você."

msgid "COMBATPROPERTIES_TACTICAL@LOST_PUPPETEER_REVERSE@NAME"
msgstr "Cortar Cordões"

msgid "COMBATPROPERTIES_TACTICAL@LOST_PUPPETEER_STUN@DESCRIPTION"
msgstr "Unidades atacantes que se tornam {GLOBAL.PROPERTIES.MIND_CONTROLLED.Hyperlink} ficam {GLOBAL.PROPERTIES.STUNNED.Hyperlink} por {StunNumber} {GLOBAL.TurnConcept.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@LOST_PUPPETEER_STUN@NAME"
msgstr "Postos de Controle"

msgid "COMBATPROPERTIES_TACTICAL@LOST_PUPPETEER_STUN_SINGLE@DESCRIPTION"
msgstr "No início do combate, a segunda unidade mais forte do exército defensor fica {GLOBAL.PROPERTIES.STUNNED.Hyperlink} por {value} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "COMBATPROPERTIES_TACTICAL@LOST_PUPPETEER_STUN_SINGLE@NAME"
msgstr "Quebrar Controle"

msgid "COMBATPROPERTIES_TACTICAL@MASS_SPAWNING2@NAME"
msgstr "Procriação em Massa: Segunda Onda"

msgid "COMBATPROPERTIES_TACTICAL@MASS_SPAWNING3@NAME"
msgstr "Procriação em Massa: Terceira Onda"

msgid "COMBATPROPERTIES_TACTICAL@MASS_SPAWNING@DESCRIPTION"
msgstr "Uma onda de {amount} unidades defensoras adicionais surgirá em {timer} [turno/]!"

msgid "COMBATPROPERTIES_TACTICAL@MASS_SPAWNING@NAME"
msgstr "Invocar Primeira Onda"

msgid "COMBATPROPERTIES_TACTICAL@MIRROR_VEIL_ARMY@DESCRIPTION"
msgstr "Todas as unidades atacantes têm {GLOBAL.PROPERTIES.MIRROR_VEIL_DAMAGE_REFLECTION}."

msgid "COMBATPROPERTIES_TACTICAL@MIRROR_VEIL_ARMY@NAME"
msgstr "Atacantes do Véu Espelhado"

msgid "COMBATPROPERTIES_TACTICAL@MIRROR_VEIL_ENEMIES@DESCRIPTION"
msgstr "Todas as unidades defensoras têm {GLOBAL.PROPERTIES.MIRROR_VEIL_DAMAGE_REFLECTION}."

msgid "COMBATPROPERTIES_TACTICAL@MIRROR_VEIL_ENEMIES@NAME"
msgstr "Defensores do Véu Espelhado"

msgid "COMBATPROPERTIES_TACTICAL@MISTY_MAGIC@DESCRIPTION"
msgstr "Névoa {GLOBAL.ObscuringConcept.Hyperlink} cobre o campo de batalha, dando a todas as unidades dentro da névoa {value} de {GLOBAL.ResistanceConcept.Hyperlink}, mas as unidades atacantes também ganham {GLOBAL.PROPERTIES.DISTRACTED.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@MISTY_MAGIC@NAME"
msgstr "Magia Nebulosa"

msgid "COMBATPROPERTIES_TACTICAL@MISTY_MAGIC@SPELL@DESCRIPTION"
msgstr "Névoa {GLOBAL.ObscuringConcept.Hyperlink} cobre o campo de batalha por {numTurns} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, dando às suas unidades dentro da névoa {value} de {GLOBAL.ResistanceConcept.Hyperlink} e fazendo com que as unidades inimigas fiquem {GLOBAL.PROPERTIES.DISTRACTED.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@OH_SO_LUCKY@DESCRIPTION"
msgstr "A cada {turn} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, todas as unidades defensoras ganham {GLOBAL.PROPERTIES.RALLYING.Hyperlink} e {GLOBAL.PROPERTIES.FORTUNE.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@OH_SO_LUCKY@NAME"
msgstr "Tão Sortudo"

msgid "COMBATPROPERTIES_TACTICAL@OMNI_ATTUNEMENT@DESCRIPTION"
msgstr "O {GLOBAL.UNITS.LOST_WIZARD_UNIT.Hyperlink} defensor tem fome por conhecimento proibido e feitiços ancestrais. Cada vez que um Feitiço é conjurado, ele ganha {amount} <<m:{GLOBAL.PositiveStatusEffectConcept.Hyperlink}>> aleatório."

msgid "COMBATPROPERTIES_TACTICAL@OMNI_ATTUNEMENT@NAME"
msgstr "Sintonia Onipresente"

msgid "COMBATPROPERTIES_TACTICAL@OPENED_COOLING_VENTS@DESCRIPTION"
msgstr "Umidade fresca está passando pelas aberturas dos respiradouros! Unidades sobre os respiradouros ficarão {GLOBAL.PROPERTIES.WET.Hyperlink} e podem dissipar {GLOBAL.PROPERTIES.BURNING.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@OPENED_COOLING_VENTS@NAME"
msgstr "Respiradouros de Resfriamento"

msgid "COMBATPROPERTIES_TACTICAL@ORDER_OF_GLUTTON@DESCRIPTION"
