msgid "CONCEPT@HERO_SKILL_ADEPT@HYPERLINK"
msgstr "[hyperlink,GLOBAL.AdeptHeroSkill]Habilidade de Herói Adepta[/hyperlink]"

msgid "CONCEPT@HERO_SKILL_EXPERT@DESCRIPTION"
