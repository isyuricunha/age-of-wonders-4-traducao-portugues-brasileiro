msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_02@NAME"
msgstr "Revelar Medos"

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_03@DESCRIPTION"
msgstr "Unidade amiga alvo ganha {amount} <<m:{GLOBAL.PositiveStatusEffectConcept.Hyperlink}>> aleatórios."

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_03@NAME"
msgstr "Conselho Especializado"

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_04@DESCRIPTION"
msgstr "Unidade amiga alvo recupera a saúde total como <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>."

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_04@NAME"
msgstr "Volte à Luta"

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_05@DESCRIPTION"
msgstr "Unidade amiga alvo recupera todos os seus <<m:{GLOBAL.ActionPointConcept.Hyperlink}>>."

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_05@NAME"
msgstr "Incentivar à Ação"

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_06@DESCRIPTION"
msgstr "Outras unidades no exército ganham {EXPERT_TRAINER_EXTRA_XP>ResolvedProportion}% de {GLOBAL.ExperienceConcept.Hyperlink} extra do combate."

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_06@NAME"
msgstr "Treinador Especializado"

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_07@DESCRIPTION"
msgstr "Invoca uma unidade Animal ou Dragão aleatória do Nível III ou IV.{LOC.CONCEPT@SUMMON_LIVE_SHARED}"

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_07@NAME"
msgstr "Conjurar Bestas Maiores"

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_08@DESCRIPTION"
msgstr "Unidade amiga Animal ou Dragão alvo:[bulletlist][bullet/]Cura {NURTURE_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Ganha {amount} {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink} por {BOLSTERED_DEFENSE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Ganha {amount} {GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink} por {BOLSTERED_RESISTANCE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_08@NAME"
msgstr "Nutrir"

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_09@COMBAT_DESCRIPTION"
msgstr "Unidades Animais e Dragões do dono deste efeito ganham:[bulletlist][bullet/]+{BEASTMASTER_STAT_BONUS>BONUS>DEFENSE>Armor} {GLOBAL.DefenseConcept.Hyperlink}[bullet/]+{BEASTMASTER_STAT_BONUS>BONUS>DEFENSE>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}[bullet/]+{BEASTMASTER_DAMAGE>ResolvedMultiplier}% de dano[/bulletlist]"

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_09@DESCRIPTION"
msgstr "Enquanto esta unidade estiver em combate, unidades Animais e Dragões ganham:[bulletlist][bullet/]+{BEASTMASTER_STAT_BONUS>BONUS>DEFENSE>Armor} {GLOBAL.DefenseConcept.Hyperlink}[bullet/]+{BEASTMASTER_STAT_BONUS>BONUS>DEFENSE>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}[bullet/]+{BEASTMASTER_DAMAGE>ResolvedMultiplier}% de dano[/bulletlist]"

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_09@NAME"
msgstr "Mestre das Feras"

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_09@PROP_DESCRIPTION"
msgstr "A unidade tem:[bulletlist][bullet/]+{BEASTMASTER_STAT_BONUS>BONUS>DEFENSE>Armor} {GLOBAL.DefenseConcept.Hyperlink}[bullet/]+{BEASTMASTER_STAT_BONUS>BONUS>DEFENSE>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}[bullet/]+{BEASTMASTER_DAMAGE>ResolvedMultiplier}% de dano[/bulletlist]"

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_10@DESCRIPTION"
msgstr "Quando esta unidade morre, unidades amigáveis Animais e Dragões ganham:[bulletlist][bullet/]{amount} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} por {STRENGTHENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]{GLOBAL.PROPERTIES.BERSERK.Hyperlink} por {BERSERK_DESCRIPTION_2>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_10@NAME"
msgstr "Pai da Alcateia"

msgid "DLC@GIANTKINGS@SOTTK_FINISHER@CULT_LEADER_EFFECTS_TOOLTIP"
msgstr "Sempre que você conjurar um feitiço de maldição da alma, há uma chance de {IntChance}% de um exército cultista se juntar ao seu governante. A força desse exército escala com o nível do feitiço de maldição da alma conjurado. Quando múltiplos desses efeitos extras de conjuração de maldição da alma puderem ser acionados, suas chances de acionamento são somadas, mas um máximo de {IntMax} efeitos é acionado."

msgid "DLC@GIANTKINGS@SOTTK_FINISHER@CULT_LEADER_TOOLTIP"
msgstr "Pelo resto do jogo, você se torna o Líder do Culto do {GLOBAL.TraitorKingCultLoreConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@SPAWNERS@LITHORINE_SPAWNER@DESCRIPTION"
msgstr "Uma formação cristalina que replica a Litiorina de maneira descontrolada.[br/]Se não for controlada, elas crescerão em força, expandirão seu território e enviarão exércitos de invasão."

msgid "DLC@GIANTKINGS@SPAWNERS@LITHORINE_SPAWNER@LORE"
msgstr "Um jardim potente que cultiva rochas e Litiorita, cuspindo hordas territoriais de aberrações em forma de pedra. Os Gigantes Ancestrais da há muito perdida Myrrida uma vez criaram e comandaram os organismos sintéticos coloquialmente referidos como Litiorina. Desafiando a Natureza, as criaturas neste jardim de alguma forma reproduzem sua centelha de vida. Evidentemente, até mesmo a vida sintética eventualmente encontra um caminho."

msgid "DLC@GIANTKINGS@SPAWNERS@LITHORINE_SPAWNER@NAME"
msgstr "Berço de Litiorina"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_722@BODY_FOOTER"
msgstr "O {EnemyUnit} escapado nota os guerreiros. Com um rosnado, <<p:EnemyUnit>> pega um {EventUnit} próximo e o arremessa em {EventHero.FirstName}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_722@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "O {EnemyUnit} escapado nota seus guerreiros. Com um rosnado, <<p:EnemyUnit>> pega um {EventUnit} próximo e o arremessa em você."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_722@BODY_HEADER"
msgstr "<<G:army^n,EventHero>> segue estalos e rangidos forçados até um lago de lava, no qual uma imponente {EventStructure} foi construída."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_722@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Seu exército segue estalos e rangidos forçados até um lago de lava, no qual uma imponente {EventStructure} foi construída."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_722@BODY_LORE"
msgstr "Dentro, {EventHero.FirstName} encontra <<a:EnemyUnit>> que escapou de <<o:EnemyUnit>> cela, agachado no chão da prisão. Dezenas de criaturas Litiorinas que fizeram sua colmeia aqui, rastejam ao redor de <<P:EnemyUnit>>. O {EnemyUnit} pega dois <<m:EventUnit>> e os esmaga um contra o outro. Para <<G:bewilderment^n,{EventHero.FirstName}>> e <<G:entertainment^n,EnemyUnit>>, os <<m:EventUnit>> se reassemblam em um {EventUnitB}!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_722@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Dentro, você encontra <<a:EnemyUnit>> que escapou de <<o:EnemyUnit>> cela, agachado no chão da prisão. Dezenas de criaturas Litiorinas que fizeram sua colmeia aqui, rastejam ao redor de <<P:EnemyUnit>>. O {EnemyUnit} pega dois <<m:EventUnit>> e os esmaga um contra o outro. Para seu espanto e <<G:entertainment^n,EnemyUnit>>, os <<m:EventUnit>> se reassemblam em um {EventUnitB}!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_722@BUTTON_0"
msgstr "\"Defendam-se! Às armas!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_722@BUTTON_1"
msgstr "Conjurar um feitiço de emergência de atordoamento [mana/] no <<m:EventUnit>>."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_722@BUTTON_2"
msgstr "Manipular a velocidade de movimento das pragas Litiorinas."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_722@BUTTON_3"
msgstr "Fugir da cena."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_722@BUTTON_4"
msgstr "\"Até os mais poderosos caem diante de mil golpes feitos como um só, tropas!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_722@BUTTON_5"
msgstr "Ordenar mineiros [structureprod/] de {EventCity} para cortar as conchas das criaturas Litiorinas."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_722@TITLE"
msgstr "Argila Primordial"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_723@BODY_FOOTER"
msgstr "Carcaças de Litiorina são enviadas para {EventCity} para serem usadas como materiais de construção. O que mais você confiscará antes de deixar os <<G:walls^p,EventStructure>>?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_723@BODY_HEADER"
msgstr "O último dos bichos Lithorine desmorona. O {EnemyUnit} jaz aos <<G:pés^p,EventHero>>, derrotado."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_723@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "O último dos bichos Lithorine desmorona. O {EnemyUnit} jaz aos seus pés, derrotado."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_723@BODY_LORE"
msgstr "<<EventHero.FirstName>> supõe que a infestação Lithorine tornou as paredes da prisão porosas e frágeis, permitindo que o {EnemyUnit} escapasse. A besta finalmente levanta <<r:EnemyUnit>> e observa <<G:cada ação^n,{EventHero.FirstName}>> com cautela. Usando gestos, seu(a) [hyperlink,GLOBAL.HeroConcept]<<EventHero{herói/heroína}>>[/hyperlink] comunica ao {EnemyUnit} que <<p:EventHero>> libertará <<P:EnemyUnit>> da {EventStructure} se <<p:EnemyUnit>> estiver disposto a lutar por você. O behemoth finalmente concorda."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_723@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Você supõe que a infestação Lithorine tornou as paredes da prisão porosas e frágeis, permitindo que o {EnemyUnit} escapasse. A besta finalmente levanta <<r:EnemyUnit>> e observa cada uma de suas ações com cautela. Usando gestos, você comunica ao {EnemyUnit} que libertará <<P:EnemyUnit>> da {EventStructure} se <<p:EnemyUnit>> estiver disposto a lutar por você. O behemoth finalmente concorda."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_723@BUTTON_0"
msgstr "Extrair gemas preciosas [gold/] das carcaças Lithorine."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_723@BUTTON_1"
msgstr "Remontar um {EventUnit} dos escombros. [unit/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_723@BUTTON_2"
msgstr "O membro de um {EventUnitB} servirá como um {EventItem}. [item/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_723@TITLE"
msgstr "Argila Primordial: Consequências"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_724@BODY_FOOTER"
msgstr "Quando o <<G:colar^n,EnemyUnit>> se quebrar, <<o:EnemyUnit>> poder total retornará! Como {EventHero.FirstName} se defenderá contra <<o:EnemyUnit>> parentes e aliados?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_724@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Quando o <<G:colar^n,EnemyUnit>> se quebrar, <<o:EnemyUnit>> poder total retornará! Como você se defenderá contra <<o:EnemyUnit>> parentes e aliados?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_724@BODY_HEADER"
msgstr "Enquanto <<G:as tropas^p,EventHero>> marcham em direção à assustadora {EventStructure}, {EventHero.FirstName} percebe sulcos rasos na lama quente, levando à sua entrada. <<Cp:EventHero>> entra."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_724@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Enquanto suas tropas marcham em direção à assustadora {EventStructure}, você percebe sulcos rasos na lama quente, levando à sua entrada. Você entra."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_724@BODY_LORE"
msgstr "Cheira a ácido dentro. Murais imensos mostram como {GLOBAL.GiantsLoreConcept.Hyperlink} destemidos subjugaram behemoths da {GLOBAL.UrwildernessLoreConcept.Hyperlink}. Os murais apresentam um {EnemyUnit} excepcionalmente cruel e seu eventual acorrentamento por [hyperlink,GLOBAL.ArchonsLoreConcept]Arcontes[/hyperlink]. {EventHero.FirstName} logo descobre uma terrível verdade: esta {EventStructure} abriga aquele mesmo {EnemyUnit}! O que é pior, adoradores da Serpente de <<o:EnemyUnit>> quebraram <<o:EnemyUnit>> correntes e agora tentam corroer <<o:EnemyUnit>> colar do Arconte!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_724@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Cheira a ácido dentro. Murais imensos mostram como {GLOBAL.GiantsLoreConcept.Hyperlink} destemidos subjugaram behemoths da {GLOBAL.UrwildernessLoreConcept.Hyperlink}. Os murais apresentam um {EnemyUnit} excepcionalmente cruel e seu eventual acorrentamento por [hyperlink,GLOBAL.ArchonsLoreConcept]Arcontes[/hyperlink]. Você logo descobre uma terrível verdade: esta {EventStructure} abriga aquele mesmo {EnemyUnit}! O que é pior, adoradores da Serpente de <<o:EnemyUnit>> quebraram <<o:EnemyUnit>> correntes e agora tentam corroer <<o:EnemyUnit>> colar do Arconte!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_724@BUTTON_0"
msgstr "Atacar para cortar a cabeça de <<o:EnemyUnit>>!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_724@BUTTON_1"
msgstr "Neutralizar as poças cáusticas das Serpentes com magias simples. [mana/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_724@BUTTON_2"
msgstr "Reforçar o colar do Arconte para atrasar a <<G:fuga^n,EnemyUnit>>"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_724@BUTTON_3"
msgstr "Recuar da cova primordial da serpente."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_724@BUTTON_4"
msgstr "Induzir as Serpentes a morderem umas às outras!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_724@BUTTON_5"
msgstr "Tomar o remédio de {EventCity} [food/] para se proteger do veneno das Serpentes."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_724@TITLE"
msgstr "Guerras de Wyrm"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_725@BODY_FOOTER"
msgstr "Em breve, os vapores corrosivos persistentes derreterão tudo dentro da {EventStructure}. O que {EventHero} levará, antes que seja tarde demais?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_725@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Em breve, os vapores corrosivos persistentes derreterão tudo dentro da {EventStructure}. O que você levará, antes que seja tarde demais?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_725@BODY_HEADER"
msgstr "Joelhos fundos em veneno e ácido, seus guerreiros vitoriosos estão cercados por Serpentes mortas. E um {EnemyUnit} abatido."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_725@BODY_LORE"
msgstr "Um {EventUnit} confuso tenta deslizar para fora discretamente. {EventHero.FirstName} presta pouca atenção a <<P:EventUnit>>, em vez disso, inspecionando o cadáver já em decomposição do Basilisco. <<Cp:EventHero>> arranca uma das <<G:presas^p,EnemyUnit>> e julga que ela passa por um {EventItem}. Só então <<p:EventHero>> descobre o ovo do Basilisco. Ele balança e racha. A prole do Basilisco pode ser criada para lutar por você!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_725@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Um {EventUnit} atordoado tenta escapar discretamente. Você presta pouca atenção ao <<P:EventUnit>>, em vez disso, inspeciona o cadáver já em decomposição da Basilisk. Você arranca uma das <<G:presas^p,EnemyUnit>> e julga que ela passa por um {EventItem}. Só então você descobre o ovo da Basilisk. Ele balança e racha. A prole da Basilisk pode ser criada para lutar por você!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_725@BUTTON_0"
msgstr "Colete as escamas e presas das Serpentes caídas. [unitprod/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_725@BUTTON_1"
msgstr "Capture o {EventUnit} [unit/] antes que ele escape."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_725@BUTTON_2"
msgstr "Levante um novo {EventUnitB} [unit/] do <<G:corpo^n,EnemyUnit>>."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_725@BUTTON_3"
msgstr "Aprenda a usar o <<G:veneno^n,EnemyUnit>> [knowledge/] em batalha."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_725@GUARANTEED_REWARD_PRISONER"
msgstr "Você ganha acesso ao Prisioneiro Primordial Livre, que concede a você uma {unit}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_725@TITLE"
msgstr "Guerras de Wyrm: Consequências"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_736@BODY_FOOTER"
msgstr "\"Você apoiará nossa missão?\" Os {GLOBAL.EternalSagesLoreConcept.Hyperlink} buscam colaborar com você em troca de segredos dos cofres de {EventHouse}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_736@BODY_HEADER"
msgstr "Uma formação flutuante de faces de pedra se dirige a você: \"Nós o saudamos.\" A voz monótona de {EventHouseLord.FirstName} da {GLOBAL.CrystalDwellingConcept.Hyperlink} de {EventHouse.Name} ressoa dentro do seu crânio."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_736@BODY_LORE"
msgstr "A entidade de rosto de pedra continua: \"Não nos tema, pois não queremos causar dano. Já compartilhamos suas ambições, quando ainda governávamos sobre os formidáveis {GLOBAL.MyrridaLoreConcept.Hyperlink}. Somos ainda maiores agora. Somos os {GLOBAL.EternalSagesLoreConcept.Hyperlink}. Observamos. Cronicamos. Preservamos e coletamos tudo o que o cosmos contém.\" Os rostos da formação não mostram emoção, mas há um tom esperançoso em sua voz."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_736@BUTTON_0"
msgstr "Inspecione os {GLOBAL.EternalSagesLoreConcept.Name} de {EventHouse}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_736@BUTTON_1"
msgstr "\"Eu o deixarei em sua busca por conhecimento.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_736@BUTTON_2"
msgstr "Descubra quais missões os {GLOBAL.EternalSagesLoreConcept.Name} têm a oferecer."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_736@TITLE"
msgstr "Encontrando {EventHouse} Sedentário"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_737@BODY_FOOTER"
msgstr "\"Nós, os {GLOBAL.EternalSagesLoreConcept.Name}, recompensaremos sua ajuda,\" conclui o {EventHouseLord}. \"Você está eternamente convidado para nossa {GLOBAL.CrystalDwellingConcept.Hyperlink} para trocar conhecimento e segredos.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_737@BODY_HEADER"
msgstr "Uma formação flutuante de faces de pedra se dirige a você: \"{EventHouse} lhe dá as boas-vindas, <<PlayerLeader{irmão/irmã}>>. Eu sou {EventHouseLord.FirstName}.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_737@BODY_LORE"
msgstr "\"Compartilhamos um parentesco ancestral, embora nossos caminhos tenham divergido éons atrás.\" Você ouviu falar dos [hyperlink,GLOBAL.GiantKingLoreConcept]Gigantes Ancestrais[/hyperlink] que se transformaram em cristais para preservar não apenas a si mesmos, mas também seu conhecimento. \"Nós, estudiosos do cosmos, observamos atentamente sua mobilidade, Gigante. Não por inveja. Mas por utilidade. Como nossa {EventHouseRace}, nossa sabedoria pode guiá-lo à erudição.\" A voz da entidade de rosto de pedra é monótona, mas não sem um tom esperançoso."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_737@BUTTON_0"
msgstr "Inspecione o assentamento de cristal de {EventHouse}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_737@BUTTON_1"
msgstr "\"Adeus. Talvez você possa me ensinar os segredos perdidos de Myrrida algum dia.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_737@BUTTON_2"
msgstr "Ofereça ajuda aos {GLOBAL.EternalSagesLoreConcept.Name} em uma missão por conhecimento."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_737@TITLE"
msgstr "Encontrando {EventHouse} Perpetual"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BODY_FOOTER"
msgstr "O {EventStackLeader} e o grupo {EventHouseRace} são exploradores enviados pela {GLOBAL.CrystalDwellingConcept.Hyperlink}. Como {EventHero.FirstName} irá proceder?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "O {EventStackLeader} e o grupo {EventHouseRace} são exploradores enviados pela {GLOBAL.CrystalDwellingConcept.Hyperlink}. Como você irá proceder?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BODY_HEADER"
msgstr "Suas tropas descobrem um grupo de guerreiros de {EventHouse} olhando para uma {EventStructure} em silêncio. <<Ca:EventStackLeader>> percebe você."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Suas tropas descobrem um grupo de guerreiros de {EventHouse} olhando para uma {EventStructure} em silêncio. <<Ca:EventStackLeader>> percebe {EventHero}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BODY_HEADER@NO_HERO_IN_STACK"
msgstr "Suas tropas descobrem um grupo de guerreiros de {EventHouse} olhando para uma {EventStructure} em silêncio. <<Ca:EventStackLeader>> percebe seu exército."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BODY_LORE"
msgstr "Enquanto as tropas de <<o:EventStackLeader>> continuam a observar a {EventStructure} como estátuas, o {EventStackLeader} vira-se para enfrentar {EventHero.FirstName}. <<Cp:EventStackLeader>> transmite um discurso memorizado: \"Este território é inspecionado pelos {GLOBAL.EternalSagesLoreConcept.Hyperlink}. Nossa missão é registrar conhecimentos não coletados. Por favor, deixe-nos prosseguir com nosso trabalho.\" O {EventStackLeader} observa {EventHero.FirstName}, mas o olhar de <<o:EventStackLeader>> está vazio, como se estivesse ouvindo algo — ou alguém — distante."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Enquanto as tropas de <<o:EventStackLeader>> continuam a observar a {EventStructure} como estátuas, o {EventStackLeader} vira-se para enfrentar você. <<Cp:EventStackLeader>> transmite um discurso memorizado: \"Este território é inspecionado pelos {GLOBAL.EternalSagesLoreConcept.Hyperlink}. Nossa missão é registrar conhecimentos não coletados. Por favor, deixe-nos prosseguir com nosso trabalho.\" O {EventStackLeader} observa você, mas o olhar de <<o:EventStackLeader>> está vazio, como se estivesse ouvindo algo — ou alguém — distante."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BODY_LORE@NO_HERO_IN_STACK"
msgstr "Enquanto as tropas de <<o:EventStackLeader>> continuam a observar a {EventStructure} como estátuas, o {EventStackLeader} vira-se para enfrentar seus guerreiros. <<Cp:EventStackLeader>> transmite um discurso memorizado: \"Este território é inspecionado pelos {GLOBAL.EternalSagesLoreConcept.Hyperlink}. Nossa missão é registrar conhecimentos não coletados. Por favor, deixe-nos prosseguir com nosso trabalho.\" O {EventStackLeader} observa seu exército, mas o olhar de <<o:EventStackLeader>> está vazio, como se estivesse ouvindo algo — ou alguém — distante."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BUTTON_0"
msgstr "Ajude o {EventStackLeader} a completar sua pesquisa [knowledge/] da {EventStructure}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BUTTON_1"
msgstr "\"Esqueça esta {EventStructure}. Entregue meu {EventItem} [item/] aos {GLOBAL.EternalSagesLoreConcept.Name} para exame.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BUTTON_2"
msgstr "Presenteie cristais mágicos [mana/] para {EventHouse} para fazer os guerreiros {EventHouseRace} irem embora."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BUTTON_3"
msgstr "Force os guerreiros infundidos com cristais a abandonarem a {EventStructure}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BUTTON_4"
msgstr "Atacar os servos imóveis dos {GLOBAL.EternalSagesLoreConcept.Name}!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BUTTON_5"
msgstr "Deixe a {EventStructure} para os guerreiros dos {GLOBAL.EternalSagesLoreConcept.Name}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@TITLE"
msgstr "Eruditos Eternos"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_764@BODY_FOOTER"
msgstr "\"Como não podemos deixar {EventHouse}, apreciamos sua capacidade de recuperar o que não podemos obter nós mesmos,\" os {GLOBAL.EternalSagesLoreConcept.Hyperlink} concluem. \"Por favor, considere nos ajudar em uma busca por conhecimento.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_764@BODY_HEADER"
msgstr "Os {GLOBAL.EternalSagesLoreConcept.Hyperlink} entram em contato com você de dentro de sua biblioteca cristalina em {EventHouse}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_764@BODY_LORE"
msgstr "\"Saudações, {PlayerLeader.TitleName},\" o {EventHouseLord} murmura. \"Faz algum tempo desde nossa última comunicação. Como você sabe, vasculhamos o reino em busca de conhecimento. Buscamos cronificar e preservar todo o conhecimento mantido pelo cosmos. Supomos que você estaria interessado em ajudar nossa causa. Naturalmente, nós o recompensaremos por seus esforços.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_764@BUTTON_2"
msgstr "Recusar a oferta apresentada pelos {GLOBAL.EternalSagesLoreConcept.Name}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_764@TITLE"
msgstr "Sede Eterna Encantadora"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@BODY_FOOTER"
msgstr "Os guerreiros de argila animados treinam suas armas em {EventHero.FirstName}, obrigados a proteger seu criador: o {EnemyUnit} agitado! Defenda-se!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Os guerreiros de argila animados treinam suas armas em você, obrigados a proteger seu criador: o {EnemyUnit} agitado! Defenda-se!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@BODY_HEADER"
msgstr "No meio de um vasto lago de lava, {EventHero} descobre uma {EventStructure} excepcionalmente alta. Um pequeno portão oferece uma entrada."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "No meio de um vasto lago de lava, você descobre uma {EventStructure} excepcionalmente alta. Um pequeno portão oferece uma entrada."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@BODY_LORE"
msgstr "Seu exército entra no pátio abobadado adornado com estátuas de argila, como guardas de prisão imóveis, onde {EventHero.FirstName} descobre um {EnemyUnit} voando alto acima deles! O calor inerente de <<Co:EnemyUnit>> derreteu a [hyperlink,GLOBAL.ArchonsLoreConcept]corrente do Arconte[/hyperlink] que drenava o poder de <<o:EnemyUnit>>. Chamas revigorantes caem das <<G:wings^p,EnemyUnit>>, que roçam as estátuas de guerreiros de terracota, acendendo vida nos guardas esculpidos!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Seu exército entra no pátio abobadado adornado com estátuas de argila, como guardas de prisão imóveis, onde você descobre um {EnemyUnit} voando alto acima de você! O calor inerente de <<Co:EnemyUnit>> derreteu a [hyperlink,GLOBAL.ArchonsLoreConcept]corrente do Arconte[/hyperlink] que drenava o poder de <<o:EnemyUnit>>. Chamas revigorantes caem das <<G:wings^p,EnemyUnit>>, que roçam as estátuas de guerreiros de terracota, acendendo vida nos guardas esculpidos!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@BUTTON_0"
msgstr "Atacar! Derrubar a mariposa e seus protetores de argila!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@BUTTON_1"
msgstr "Anular [mana/] a habilidade dos soldados de argila de ressuscitar."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@BUTTON_2"
msgstr "Quebrar os soldados de argila com ventos gelados."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@BUTTON_3"
msgstr "Fuja da {EventStructure} e retorne em outro momento."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@BUTTON_4"
msgstr "Cegue {EnemyUnit} com uma bola brilhante de relâmpago."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@BUTTON_5"
msgstr "Envie armaduras adicionais [unitprod/] de {EventCity} para proteger suas tropas."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@BUTTON_6"
msgstr "Utilize a lava ao redor para incendiar os guerreiros de argila!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@TITLE"
msgstr "Tocado Pela Chama"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_766@BODY_FOOTER"
msgstr "Antes que a {EventStructure} desabe no poço de lava, o que {EventHero} tentará salvar?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_766@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Antes que a {EventStructure} desabe no poço de lava, o que você tentará salvar?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_766@BODY_HEADER"
msgstr "Seu exército está vitorioso sobre os escombros dos guerreiros de argila desmoronados e o casulo gigante do {EnemyUnit}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_766@BODY_LORE"
msgstr "A Traça caiu na [hyperlink,GLOBAL.ArchonsLoreConcept]corrente do Arconte[/hyperlink] que drenou a vida do {EnemyUnit} por tantos séculos. Inesperadamente, arcos de energia da corrente voltam para o {EnemyUnit}, que revive mais uma vez, assim como as duas estátuas de argila restantes de um {EventUnit} e um {EventUnitB}. O {EnemyUnit} revitalizado obedece a você. No entanto, para que ele saia da {EventStructure}, a estrutura deve ser destruída."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_766@BUTTON_0"
msgstr "Transporte os fragmentos de argila [structureprod/] das estátuas derrotadas para {EventCity}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_766@BUTTON_1"
msgstr "Colete as armas [unitprod/] empunhadas pelos guerreiros de argila para {PlayerCapital}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_766@BUTTON_2"
msgstr "Estude os efeitos revitalizantes do Piremote para aumentar [unitHero/] {EventHero.FirstName}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_766@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "Estude os efeitos revitalizantes do Piremote para aumentar [unitHero/] você mesmo."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_766@TITLE"
msgstr "Tocado Pela Chama: Consequências"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_780@BODY_FOOTER"
msgstr "Você limpará o {EventSpawner} para recuperar o {EventArtifact} para a Morada de Cristal?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_780@BODY_HEADER"
msgstr "Os {GLOBAL.EternalSagesLoreConcept.Hyperlink} se aproximam de você com um pedido."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_780@BODY_LORE"
msgstr "\"Descobrimos a localização de uma relíquia há muito considerada perdida. O {EventArtifact} está localizado em um {EventSpawner} {EventDirection} {EventCity},\" eles dizem a você em uma voz monótona. \"Desejamos estudar o {EventArtifact} e armazená-lo em nossas vastas bibliotecas cristalinas. No entanto, o {EventSpawner} não está sem defensores, complicando assim a recuperação do {EventArtifact}.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_780@BUTTON_0"
msgstr "\"Eu recuperarei esta relíquia do {EventSpawner}.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_780@TITLE"
msgstr "Recuperando o {EventArtifact}"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_781@BODY_FOOTER"
msgstr "Os {GLOBAL.EternalSagesLoreConcept.Hyperlink} estão ansiosos para estudar o {EventArtifact}. Você permanecerá fiel à sua palavra e o devolverá?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_781@BODY_HEADER"
msgstr "Você recuperou o {EventArtifact} do {EventSpawner}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_781@BODY_LORE"
msgstr "Os {GLOBAL.EternalSagesLoreConcept.Name} já notaram seu sucesso e se comunicam com você de longe. \"Você fez bem, {PlayerLeader.Title},\" seu emissário fala com você monotonamente. \"Finalmente podemos revelar quais segredos o {EventArtifact} contém.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_781@BUTTON_0"
msgstr "Dê o {EventArtifact} aos {GLOBAL.EternalSagesLoreConcept.Name}. [allegiance/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_781@BUTTON_1"
msgstr "Mantenha o {EventArtifact} para você mesmo, irritando os {GLOBAL.EternalSagesLoreConcept.Name}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_781@TITLE"
msgstr "Recuperando o {EventArtifact}: Consequências"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_798@BODY_FOOTER"
msgstr "\"Você pode capturar o {EventStackLeader}, após derrotar <<P:EventStackLeader>> no {EventSpawner}, usando esta cápsula de Litiorita. Ela perpetuará <<p:EventStackLeader>> dentro dela.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_798@BODY_HEADER"
msgstr "Os {GLOBAL.EternalSagesLoreConcept.Hyperlink} se aproximam de você com um pedido."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_798@BODY_LORE"
msgstr "\"Temos interesse em estudar e preservar as várias criaturas que povoam os reinos,\" eles declaram. \"Uma das criaturas que falta em nossa coleção é um {EventStackLeader}. Recentemente, descobrimos um <<G:nest^n,EventStackLeader>> nas proximidades: um {EventSpawner} {EventDirection} {EventCity}.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_798@BUTTON_0"
msgstr "\"Eu voltarei com o {EventStackLeader} capturado.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_798@TITLE"
msgstr "Capturando <<m:EventStackLeader>>"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_799@BODY_FOOTER"
msgstr "Os {GLOBAL.EternalSagesLoreConcept.Hyperlink} estão ansiosos para adquirir o {EventStackLeader}. Você completará sua missão e entregará <<P:EventStackLeader>> a eles?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_799@BODY_HEADER"
msgstr "O {EventStackLeader} é encapsulado com sucesso dentro do grande cristal de Litiorita. O {EventSpawner} é desmantelado."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_799@BODY_LORE"
msgstr "Os {GLOBAL.EternalSagesLoreConcept.Name} já notaram seu sucesso e se comunicam com você de longe. \"Você fez bem, {PlayerLeader.Title},\" seu emissário fala com você monotonamente. \"Finalmente podemos estudar o {EventStackLeader} e <<o:EventStackLeader>> comportamento por toda a eternidade.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_799@BUTTON_0"
msgstr "Ofereça o {EventStackLeader} aos {GLOBAL.EternalSagesLoreConcept.Name} [allegiance/]."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_799@BUTTON_1"
msgstr "Domar o {EventStackLeader} para você mesmo [unit/], irritando os {GLOBAL.EternalSagesLoreConcept.Name}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_799@TITLE"
msgstr "Capturando <<m:EventStackLeader>>: Consequências"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_821@BODY_FOOTER"
msgstr "Você forjará o {EventArtifact} para a Morada de Cristal para que eles possam estudá-lo? Você receberá um [hyperlink,GLOBAL.ItemForgeConcept]Projeto[/hyperlink] sob medida."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_821@BODY_FOOTER@FORGE_ITEM_VAR1"
msgstr "Você reforjará o {EventArtifact} para a Morada de Cristal para que eles possam estudá-lo? Você receberá um [hyperlink,GLOBAL.ItemForgeConcept]Projeto[/hyperlink] sob medida."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_821@BODY_HEADER"
msgstr "Os {GLOBAL.EternalSagesLoreConcept.Hyperlink} se aproximam de você com um pedido."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_821@BODY_LORE"
msgstr "\"Há muito tempo filosofamos sobre os poderes de uma arma hipotética. Um {EventArtifact}, se assim pudermos chamar.\" Eles explicam com uma voz oca. \"Caso este {EventArtifact} venha a existir, desejamos mantê-lo e estudá-lo. Acreditamos que você possua uma {GLOBAL.ItemForgeConcept.Hyperlink}. Podemos fornecer as instruções de forjamento se você concordar.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_821@BODY_LORE@FORGE_ITEM_VAR1"
msgstr "\"Há muito tempo guardamos os fragmentos de um {EventArtifact}, uma relíquia de uma era perdida. Seu poder é cronicado em lendas.\" Apesar de sua voz monótona, há um toque de constrangimento nas palavras dos {GLOBAL.EternalSagesLoreConcept.Name}. \"Infelizmente, não conseguimos reparar o item nós mesmos. Sabemos que você controla uma {GLOBAL.ItemForgeConcept.Hyperlink}. Você seria capaz de reforjar o {EventArtifact}?\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_821@BUTTON_0"
msgstr "\"Eu forjarei o {EventArtifact} para vocês.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_821@TITLE"
msgstr "Forjando o {EventArtifact}"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_822@BODY_FOOTER"
msgstr "Os {GLOBAL.EternalSagesLoreConcept.Hyperlink} estão ansiosos para estudar os efeitos do {EventArtifact}. Você o entregará a eles?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_822@BODY_HEADER"
msgstr "Você forjou o {EventArtifact} em sua Forja de Itens."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_822@BODY_LORE"
msgstr "Os {GLOBAL.EternalSagesLoreConcept.Name} sentiram seu sucesso e se aproximam de você novamente. \"Você fez bem, {PlayerLeader.Title},\" seu emissário fala com você monotonamente. \"Estamos curiosos sobre o {EventArtifact} e seu potencial.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_822@BUTTON_0"
msgstr "Entregue o {EventArtifact} aos {GLOBAL.EternalSagesLoreConcept.Name}. [allegiance/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_822@BUTTON_1"
msgstr "Mantenha o {EventArtifact} para você mesmo, irritando os {GLOBAL.EternalSagesLoreConcept.Name}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_822@TITLE"
msgstr "Forjando o {EventArtifact}: Consequências"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_880@BODY_FOOTER"
msgstr "Você aceitará o convite dos Sábios Eternos para se tornar um Médium para seu ritual de comunhão com outros <<m:{GLOBAL.CrystalDwellingConcept.Hyperlink}>>?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_880@BODY_HEADER"
msgstr "Tornou-se uma visão familiar: a saudação formal dos {GLOBAL.EternalSagesLoreConcept.Hyperlink} em sua biblioteca cristalina em {EventHouse}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_880@BODY_LORE"
msgstr "<<G:voz monótona^n,EventHouseLord>> explica: \"Você provou ser um aliado valioso para nossa causa, {PlayerLeader.TitleName}. Um último favor permanece. Buscamos alcançar nossos parentes dispersos através do {GLOBAL.AstralSeaLoreConcept.Hyperlink}. Para nos comunicarmos e trocarmos nosso conhecimento acumulado de todos os reinos e mundos. O ritual exige um indivíduo para agir como um Médium. Um indivíduo com os poderes de um {GLOBAL.GodirLoreConcept.Hyperlink}.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_880@BUTTON_0"
msgstr "Concordar em se tornar seu Médium. Os Sábios Eternos preparam agradecidos seu ritual."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_880@BUTTON_1"
msgstr "Fingir concordar [evilact/] com a intenção de perturbar o ritual do Conclave."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_880@BUTTON_2"
msgstr "Recusar educadamente. Solicitar uma comunhão privada com a Morada [knowledge/] em vez disso."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_880@TITLE"
msgstr "Comunhão Entre Cristais"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_881@BODY_FOOTER"
msgstr "Este é o Conclave Cósmico que {EventHouse} manifestou, com você em seu centro. O poder onisciente de todo o {GLOBAL.AstralSeaLoreConcept.Hyperlink} está percorrendo seu corpo imortal."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_881@BODY_FOOTER@PLAYER_NOT_MEDIU"
msgstr "O Conclave Cósmico faz com que este reino cresça repleto de poder onisciente de todo o {GLOBAL.AstralSeaLoreConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_881@BODY_HEADER"
msgstr "Estrelas aparecem repentinamente no céu, seguidas por zumbidos que ressoam através do chão. O ar tem gosto de cerejas."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_881@BODY_LORE"
msgstr "Conexões astrais são feitas entre <<m:{GLOBAL.CrystalDwellingConcept.Hyperlink}>> em outros reinos, aparecendo na forma de um redemoinho arcano. Filamentos de energia roxa emergem entre as estrelas, alcançando para se conectar com um Médium. De repente, todos os filamentos tocaram {EventHouse}, causando energia a ser disparada de volta para o cosmos. Os surtos logo alcançam um equilíbrio. As conexões são estabilizadas. O Conclave Cósmico, uma comunhão entre {GLOBAL.EternalSagesLoreConcept.Hyperlink}, começou."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_881@BUTTON_0"
msgstr "\"Os segredos do cosmos, dispostos diante de mim.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_881@BUTTON_2"
msgstr "\"Podemos aprender muito com este auspicioso presságio.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_881@TITLE"
msgstr "O Conclave Cósmico"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_882@BODY_FOOTER"
msgstr "Seguindo a culminância cósmica de sua parceria com {EventHouse}, você celebra suas conquistas em sua pesquisa que contribuíram para suas ambições pessoais."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_882@BODY_FOOTER@PLAYER_NOT_MEDIU"
msgstr "Sua pesquisa se beneficiou do Conclave Cósmico. Quanto seus rivais lucraram com o ocorrido, ainda está para ser visto."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_882@BODY_HEADER"
msgstr "O Conclave Cósmico terminou. O {GLOBAL.CrystalDwellingConcept.Hyperlink} se comunicou com sucesso com seus parentes através do cosmos."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_882@BODY_LORE"
msgstr "A clareza com que você contemplou o mundo e seus segredos além está diminuindo. É como se sua mente estivesse repentinamente envolta em algodão. Mas, embora a acuidade tenha diminuído, os frutos desta Era do Conhecimento permanecem. Os {GLOBAL.EternalSagesLoreConcept.Hyperlink} já se retiraram serenamente de volta para suas fortalezas de cristal para retomar seus estudos eternos."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_882@BUTTON_0"
msgstr "\"Agora sei quanto mais ainda resta para aprender.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_882@TITLE"
msgstr "O Conclave Cósmico: Consequências"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_883@BODY_FOOTER"
msgstr "Tendo descoberto sua traição, {EventHouseLord.TitleName} de {EventHouse} entra em contato com você. \"Você pagará por esta profanação!\", <<p:EventHouseLord>> troveja. Mas você já tem seu prêmio."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_883@BODY_HEADER"
msgstr "Estrelas aparecem repentinamente no céu, seguidas por zumbidos que ressoam através do chão. O ar tem gosto de cerejas."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_883@BODY_LORE"
msgstr "Conexões astrais são feitas entre <<m:{GLOBAL.CrystalDwellingConcept.Hyperlink}>> em outros reinos, aparecendo na forma de um redemoinho arcano. Filamentos de energia roxa emergem entre as estrelas, alcançando para se conectar com um Médium: você. Mas eles nunca encontram seu alvo. Seus magos iniciam o contra-ritual, causando os filamentos a se emaranharem e iminente atingirem {EventHouse} como raios. Suas estruturas eternas desmoronam; seus defensores se desintegram."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_883@BUTTON_0"
msgstr "\"Eu tenho domínio sobre o conhecimento. [knowledge/] Eu terei domínio sobre você.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_883@TITLE"
msgstr "Decepção Eterna"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_905@BODY_FOOTER"
msgstr "Como você resumiria suas ambições para o {EventUnit}?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_905@BODY_HEADER"
msgstr "Um {EventUnit}, um de seus súditos Hastefolk, pergunta ousadamente sobre seus planos para o futuro."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_905@BODY_LORE"
msgstr "\"Meu {PlayerLeader.Title}, você é descendente de uma linhagem de [hyperlink,GLOBAL.GiantKingLoreConcept]reis poderosos[/hyperlink] e guerreiros imponentes. Seus ancestrais já definiram a disposição da terra, o curso dos rios e o fluxo das montanhas. Como herdeiro do poder de {GLOBAL.MyrridaLoreConcept.Hyperlink}, seus {EventRace} estão curiosos para saber... que planos você tem para este reino?\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_905@BUTTON_0"
msgstr "Restaurar a influência de Myrrida [influence/] à sua antiga majestade."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_905@BUTTON_1"
msgstr "Remodelar os reinos [structureprod/] como eu achar melhor."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_905@BUTTON_2"
msgstr "Proteger [goodact/] aqueles menores que eu."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_905@BUTTON_3"
msgstr "Forjar [bindingessence/] itens potentes que decidirão o destino dos reinos."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_905@BUTTON_4"
msgstr "Invocar tempestades poderosas, como meus ancestrais fizeram éons atrás. [mana/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_905@BUTTON_5"
msgstr "Erguer mares de lava, como meus ancestrais fizeram éons atrás. [mana/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_905@BUTTON_6"
msgstr "Cobrir continentes com neve, como meus ancestrais fizeram éons atrás. [mana/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_905@BUTTON_7"
msgstr "Erguer montanhas eternas, como meus ancestrais fizeram éons atrás. [mana/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_905@TITLE"
msgstr "Ambições Gigantes"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_906@BODY_FOOTER"
msgstr "Seus {EventRace} dependem de você para desbloquear todo o seu potencial. Que caminho você escolherá para seus súditos?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_906@BODY_HEADER"
msgstr "Você possui o poder de remodelar os reinos. À medida que sua majestade cresce, é hora de remodelar seus {EventRace}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_906@BODY_LORE"
msgstr "Nem mesmo os [hyperlink,GLOBAL.GiantKingLoreConcept]Reis Gigantes[/hyperlink] de outrora poderiam governar os reinos sem a ajuda de seus seguidores. Línguas maldosas afirmam que eles eram notórios por experimentar em seus súditos menores. De qualquer forma, você depende de seus Hastefolk para manter o controle sobre seu domínio. É seu dever e responsabilidade desenvolver seus {EventRace}. Eles anseiam por sua orientação."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_906@BUTTON_0"
msgstr "\"Eu só desejo mantê-lo longe de perigo.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_906@BUTTON_1"
msgstr "\"Você crescerá alto e poderoso como os Gigantes de antigamente.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_906@BUTTON_2"
msgstr "\"Eu lhe emprestarei o poder dos Gigantes da Tempestade.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_906@BUTTON_3"
msgstr "\"Eu lhe emprestarei o poder dos Gigantes de Fogo.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_906@BUTTON_4"
msgstr "\"Eu lhe emprestarei o poder dos Gigantes de Gelo.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_906@BUTTON_5"
msgstr "\"Eu lhe emprestarei o poder dos Gigantes de Pedra.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_906@BUTTON_6"
msgstr "\"Você já é perfeito exatamente como é.\" [happiness/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_906@TITLE"
msgstr "Desenvolvimentos Formativos"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1367@BODY_FOOTER"
msgstr "Sentinelas de Lithorine entram no salão. Ondas arcanas percorrem o edifício enquanto zumbem com poder e notam {EventHero.FirstName}..."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1367@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Sentinelas de Lithorine entram no salão. Ondas arcanas percorrem o edifício enquanto zumbem com poder e notam você..."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1367@BODY_HEADER"
msgstr "Uma majestosa {EventStructure} se ergue diante de {EventHero.TitleName}, o nome do {GLOBAL.GiantKingLoreConcept.Hyperlink} retratado esquecido no tempo."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1367@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Uma majestosa {EventStructure} se ergue diante de você, o nome do {GLOBAL.GiantKingLoreConcept.Hyperlink} retratado esquecido no tempo."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1367@BODY_LORE"
msgstr "Sob o trono massivo, {EventHero.FirstName} entra em um grande salão, <<o:EventHero>> movimento ecoando por todo o edifício. Não há vida a ser encontrada aqui. Nenhuma teia de aranha, vermes ou mesmo poeira cobre os salões. E ainda assim, não há nenhum cuidador para ser encontrado... Até que {EventHero.FirstName} sente um formigamento familiar percorrer <<o:EventHero>> coluna — uma onda de energia arcana."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1367@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Sob o trono massivo, você entra em um grande salão, seu movimento ecoa por todo o edifício. Não há vida a ser encontrada aqui. Nenhuma teia de aranha, vermes ou mesmo poeira cobre os salões. E ainda assim, não há nenhum cuidador para ser encontrado... Até que você sente um formigamento familiar percorrer sua coluna — uma onda de energia arcana."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1367@BUTTON_0"
msgstr "\"Atacem essas sentinelas rebeldes!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1367@BUTTON_1"
msgstr "Lance um feitiço protetor [mana/] sobre seu exército."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1367@BUTTON_2"
msgstr "Use seu conhecimento arcano para atrasar as ondas de magia."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1367@BUTTON_3"
msgstr "Fuja da {EventStructure}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1367@BUTTON_4"
msgstr "Invoque os poderes do Caos para provocarem e confundirem as sentinelas."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1367@BUTTON_5"
msgstr "Invoque os poderes da {EventStructure} para fortalecer a armadura do seu exército."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1367@TITLE"
msgstr "Sentinelas Fraturadas"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1368@BODY_FOOTER"
msgstr "Junto ao conhecimento encontrado dentro, {EventHero.FirstName} encontra tesouros escondidos e até mesmo uma sala de sentinelas Lithorine dormentes."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1368@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Junto ao conhecimento encontrado dentro, você encontra tesouros escondidos e até mesmo uma sala de sentinelas Lithorine dormentes."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1368@BODY_HEADER"
msgstr "Depois de destruir as sentinelas Lithorine da {EventStructure}, {EventHero.Name} está livre para explorar os salões imaculados."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1368@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Depois de destruir as sentinelas Lithorine da {EventStructure}, você está livre para explorar os salões imaculados."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1368@BODY_LORE"
msgstr "Com as sentinelas obsessivamente limpando e protegendo os salões por séculos, tudo dentro foi preservado. Runas claras, entalhes e fileiras de livros alinham as paredes, compartilhando uma riqueza de histórias sobre {GLOBAL.MyrridaLoreConcept.Hyperlink}. Há representações dos [hyperlink,GLOBAL.GiantKingLoreConcept]Reis Gigantes[/hyperlink] e seus pactos com os {GLOBAL.ArchonsLoreConcept.Hyperlink}, a queda de Myrrida e os {GLOBAL.TraitorKingsLoreConcept.Hyperlink}, e até mesmo lendas secretas do {GLOBAL.EternalCouncilLoreConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1368@BUTTON_0"
msgstr "Pegue uma arma coberta de cristais. [item/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1368@BUTTON_1"
msgstr "Reivindique o tesouro [gold/] encontrado dentro da {EventStructure}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1368@BUTTON_2"
msgstr "Vincule algumas das sentinelas ao seu lado. [unit/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1368@BUTTON_3"
msgstr "Reúna os cristais de Lithorite. [mana/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1368@TITLE"
msgstr "Sentinelas Fraturadas: Consequências"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1370@BODY_FOOTER"
msgstr "Seu líder aponta para {EventHero.FirstName} e grita: \"Grandes Reis do passado! Abençoe-nos com sua proeza para esmagar esses hereges!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1370@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Seu líder aponta para você e grita: \"Grandes Reis do passado! Abençoe-nos com sua proeza para esmagar esses hereges!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1370@BODY_HEADER"
msgstr "{EventHero.FirstName} entra na {EventStructure} e encontra um grupo de figuras adorando a estátua de um antigo {GLOBAL.GiantKingLoreConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1370@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você entra na {EventStructure} e encontra um grupo de figuras adorando a estátua de um antigo {GLOBAL.GiantKingLoreConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1370@BODY_LORE"
msgstr "A princípio, os adoradores não parecem notar {EventHero.FirstName} de forma alguma, em vez disso, cantando na antiga linguagem de {GLOBAL.MyrridaLoreConcept.Hyperlink}. É apenas quando {EventHero.FirstName} se aproxima da estátua que seu líder levanta <<o:EnemyUnit>> olhar. \"Você não é um adorador de Gigantes. Você transgride terras sagradas! Você ousa manchar os grandes degraus da {EventStructure} com seus soldados?!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1370@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "A princípio, os adoradores não parecem notar você, em vez disso, cantam na antiga linguagem de {GLOBAL.MyrridaLoreConcept.Hyperlink}. É apenas quando você se aproxima da estátua que seu líder levanta o olhar de <<o:EnemyUnit>>. \"Você não é um adorador de Gigantes. Você está violando terras sagradas! Você ousa manchar os grandes degraus do {EventStructure} com seus soldados?!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1370@BUTTON_0"
msgstr "\"Atacar!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1370@BUTTON_1"
msgstr "\"Você quer se tornar gigantes, será derrubado como eles!\" [influence/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1370@BUTTON_2"
msgstr "\"A bênção do crescimento pode ser concedida, mas eu posso tirá-la.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1370@BUTTON_3"
msgstr "Deixe os cultistas com sua cerimônia."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1370@BUTTON_4"
msgstr "\"Você adora meus parentes! Curvem-se a mim, meus seguidores!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1370@TITLE"
msgstr "Proeza Primal"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1371@BODY_FOOTER"
msgstr "Sem os cultistas para proteger seu tesouro, os objetos estão livres para serem reclamados."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1371@BODY_HEADER"
msgstr "Após matar os adoradores do {EventStructure}, {EventHero.FirstName} pode se aproximar livremente da estátua."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1371@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Após matar os adoradores do {EventStructure}, você pode se aproximar livremente da estátua."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1371@BODY_LORE"
msgstr "Nenhum trovão cai, nenhum relâmpago ou ira divina atinge {EventHero.FirstName} ou o exército de <<o:EventHero>>. Em vez disso, o {EventStructure} permanece em silêncio, os grandes salões ecoando cada passo enquanto a estátua se ergue acima do exército. Na base gigante da estátua, os cultistas haviam reunido uma pilha de artefatos para adorar e sacrificar a seu amado {GLOBAL.GiantKingLoreConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1371@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Nenhum trovão cai, nenhum relâmpago ou ira divina atinge você ou seu exército. Em vez disso, o {EventStructure} permanece em silêncio, os grandes salões ecoando cada passo enquanto a estátua se ergue acima do exército. Na base gigante da estátua, os cultistas haviam reunido uma pilha de artefatos para adorar e sacrificar a seu amado {GLOBAL.GiantKingLoreConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1371@BUTTON_0"
msgstr "Reúna tudo de valor para vender. [gold/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1371@BUTTON_1"
msgstr "Pegue o pergaminho ritual da Graça do Colosso."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1371@BUTTON_2"
msgstr "Reclame o {EventItem}. [item/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1371@BUTTON_3"
msgstr "Pegue o tomo de lenda antiga [knowledge/] sobre Gigantes e sua magia."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1371@BUTTON_4"
msgstr "Não reclame nada. Este remanescente da civilização deve ser mantido intacto. [materiumboon/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1371@TITLE"
msgstr "Proeza Primal: Consequências"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1373@BODY_FOOTER"
msgstr "O Gigante olha para {EventHero.FirstName} enquanto <<p:EventHero>> se aproxima. \"Intrusos! Este é o meu trono! Atacá-los!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1373@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "O Gigante olha para você enquanto você se aproxima. \"Intrusos! Este é o meu trono! Atacá-los!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1373@BODY_HEADER"
msgstr "Dentro do imponente {EventStructure}, remanescente da glória de {GLOBAL.MyrridaLoreConcept.Hyperlink}, {EventHero.Name} encontra um {GiantUnit}, junto com um grupo de Semigigantes."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1373@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Dentro do imponente {EventStructure}, remanescente da glória de {GLOBAL.MyrridaLoreConcept.Hyperlink}, você encontra um {GiantUnit}, junto com um grupo de Semigigantes."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1373@BODY_LORE"
msgstr "\"Éons atrás, os [hyperlink,GLOBAL.GiantKingLoreConcept]Reis Gigantes[/hyperlink] governaram sobre todas as raças menores,\" o Gigante se gaba para seus seguidores <<o:EnemyUnit>> Semigigantes. \"É apenas justo que eu reclame este trono mais uma vez, conforme a ordem natural.\" Um silêncio confuso cai, e o Gigante grita em frustração: \"Os pequenos seguem os grandes, seus tolos!\" Os Semigigantes gritam, felizes por entenderem, enquanto o Gigante suspira."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1373@BUTTON_0"
msgstr "Atacar esses tolos desengonçados!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1373@BUTTON_1"
msgstr "\"Meus parentes Dragões já te venceram antes, Gigante! Eu farei isso novamente!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1373@BUTTON_2"
msgstr "Confunda os Semigigantes com retórica [knowledge/] sobre Gigantes e seus parentes."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1373@BUTTON_3"
msgstr "Deixe o Gigante e os seguidores de <<o:EnemyUnit>>."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1373@BUTTON_4"
msgstr "\"Como a lenda do jovem pastor, nós também podemos matar Gigantes!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1373@BUTTON_5"
msgstr "\"Um grupo de caçadores pode derrubar a maior presa!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1373@TITLE"
msgstr "O Tamanho Importa"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1374@BODY_FOOTER"
msgstr "O Semigigante solitário não representa ameaça para {EventHero.FirstName}. O que você pede a <<P:EventUnit>>?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1374@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "O Semigigante solitário não representa ameaça para você. O que você pede a <<P:EventUnit>>?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1374@BODY_HEADER"
msgstr "{EventHero.FirstName} matou um aspirante a {GLOBAL.GiantKingLoreConcept.Hyperlink} e seus seguidores. Com isso, a {EventStructure} é sua e pode ser explorada livremente."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1374@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você matou um aspirante a {GLOBAL.GiantKingLoreConcept.Hyperlink} e seus seguidores. Com isso, a {EventStructure} é sua e pode ser explorada livremente."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1374@BODY_LORE"
msgstr "Enquanto {EventHero.FirstName} percorre os salões, <<p:EventHero>> encontra um {EventUnit} solitário, que levanta <<o:EventUnit>> braços. \"Você esmagou o Gigante? Você venceu. O Gigante me disse para guardar o tesouro... Mas eu fiquei entediado, então andei por aí.\" O Semigigante ri. \"Você esmagou o Gigante. Eu estou livre.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1374@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Enquanto você percorre os salões, encontra um {EventUnit} solitário, que levanta <<o:EventUnit>> braços. \"Você esmagou o Gigante? Você venceu. Ele era malvado de qualquer jeito. Nos chamou de burros. Ele me disse para guardar o tesouro... Mas eu fiquei entediado, então andei por aí.\" O Semigigante ri. \"Agora ele foi esmagado e eu estou livre.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1374@BUTTON_0"
msgstr "Recrute o Semigigante para o seu lado. [unit/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1374@BUTTON_1"
msgstr "Exija que o Semigigante guie você até os tesouros coletados. [gold/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1374@BUTTON_2"
msgstr "\"Você está livre para ir, {EventUnit}.\" [goodact/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1374@BUTTON_3"
msgstr "Mate o {EventUnit} que se rende como um exemplo para suas tropas. [evilact/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1374@TITLE"
msgstr "O Tamanho Importa: Consequências"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1476@BODY_FOOTER@NO_AI_LORDS"
msgstr "O {EventUnit} levanta <<o:EventUnit>> mãos e grita em êxtase. \"Você é abençoado pelo [hyperlink,GLOBAL.TraitorKingsLoreConcept]Kjörnoe[/hyperlink]! Nós vamos adorar você como fizemos com eles!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1476@BODY_LORE@NO_AI_LORDS"
msgstr "\"Eu sou um <<EventUnit{Son/Daughter}>> do Kjörnoe, um seguidor dos verdadeiros [hyperlink,GLOBAL.GiantKingLoreConcept]Reis Gigantes[/hyperlink] tão injustamente declarados 'Traidores'. Por muito tempo, seguimos os Artefatos que você agora possui, esperando por alguém que encarne as bênçãos do Kjörnoe. Você é <<P:PlayerLeader>>! E assim, os Filhos do Kjörnoe juram lealdade a você!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1490@BUTTON_5"
msgstr "Guie as almas fragmentadas para {ReplacedPlayerFallback}. [evilact/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1490@BUTTON_6"
msgstr "Pare o ritual e use os Artefatos para governar os Filhos do Kjörnoe você mesmo."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1490@BUTTON_7"
msgstr "Sacrifique seu <<EventHero{hero/heroine}>> {EventHero.TitleName} para trazer de volta o Rei Traidor sob seu comando. [unit/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1498@BODY_FOOTER"
msgstr "{PreviousPlayer.TitleName} foi lançado no {GLOBAL.AstralVoidLoreConcept.Hyperlink} por {TriggeringPlayer}. O [hyperlink,GLOBAL.TraitorKingsLoreConcept]Rei Traidor[/hyperlink] {TraitorKingLord} agora governa os {ReplacedPlayerRace} no lugar de <<o:PreviousPlayer>>."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1498@BODY_HEADER"
msgstr "Seus planos são interrompidos por uma onda arcana sombria, que se espalha pelo reino."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1498@BODY_LORE"
msgstr "Após investigar sua causa, você descobre que {TriggeringPlayer} usou o {CauldronRelic}, {MirrorRelic} e {GrailRelic} para reavivar os antigos {GLOBAL.TraitorKingsLoreConcept.Hyperlink}. O processo de invocação lançou {PreviousPlayer} no {GLOBAL.AstralVoidLoreConcept.Hyperlink} e substituiu <<P:PreviousPlayer>> por {TraitorKingLord}. Infelizmente, não há nada que você possa fazer contra essa magia do Rei Traidor."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1498@BUTTON_0"
msgstr "\"Vou aprender [knowledge/] com a magia sombria deste Rei Traidor!\" [evilact/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1498@BUTTON_2"
msgstr "Envie alguns donativos [gold/] para os {ReplacedPlayerRace} por compaixão. [goodact/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1498@BUTTON_3"
msgstr "\"Este ato proibido não pode ficar sem resposta.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1498@TITLE"
msgstr "Retorno dos Kjörnoe: Invocação Sombria"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6766@BODY_FOOTER"
msgstr "Jatos de chama emergem nos céus, acalmando a tempestade até que a barreira no centro do planalto colapse."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6766@BODY_HEADER"
msgstr "Resmungando contente, o {EventUnit} pega todos os núcleos de Lithorine que você coletou. Então <<p:EventUnit>> levanta <<o:EventUnit>> mãos:"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6766@BODY_HEADER@OGRE_DEFEATED"
msgstr "Derrotado e ameaçado pelo poder de você e suas tropas, o {EventUnit} começa a invocação com relutância:"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6766@BODY_LORE"
msgstr "\"Faísca, pequena runa![br/]Ouça a chama[br/]Fissuras passadas[br/]Nome esculpido:[br/]Frustrar e explodir[br/]—boom!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6766@BUTTON_0"
msgstr "Prepare-se para enfrentar o que está além da guarda."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6766@TITLE"
msgstr "Platô da Tempestade de Cristal: Invocação da Guarda Quebrada"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6768@BODY_FOOTER"
msgstr "Os Gigantes {GLOBAL.StormClanLoreConcept.Hyperlink} ligaram o {EventStackLeader} à sua vontade. Eles estão prontos para liberá-lo em qualquer um que ouse interferir."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6768@BODY_HEADER"
msgstr "Ao chegar ao centro do planalto, suas tropas olham para um enorme {EventStackLeader}."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6768@BODY_LORE"
msgstr "Distraídos pelo tamanho do {EventStackLeader}, leva alguns momentos antes que suas tropas percebam os Gigantes reunidos em torno de um grande menir, suas runas esculpidas brilhando com magia. Há alguma agitação entre esses Gigantes, como se tivessem sido interrompidos em um ritual. Vendo o emblema do {GLOBAL.StormClanLoreConcept.Hyperlink}, só se pode assumir que a {GLOBAL.PROPERTIES.TSR_CRYSTAL_STORM_AUTO_SPELL.Hyperlink} furiosa foi obra deles."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6768@BUTTON_0"
msgstr "\"Devemos recuar, por enquanto.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6768@BUTTON_1"
msgstr "\"Este {GLOBAL.StormClanLoreConcept.Name} não é páreo para nós, ataque!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6768@TITLE"
msgstr "Platô da Tempestade de Cristal: Ritual do Clã da Tempestade"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6791@BODY_FOOTER"
msgstr "Você sente uma magia forte de lealdade ligada dentro do {EventRelic.Name}. Enquanto a região finalmente fica sem vento, você pode reclamar sua vitória."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6791@BODY_HEADER"
msgstr "Você derrotou o {GLOBAL.StormClanLoreConcept.Hyperlink} e seu Lithorine evocado. Seu líder atual, um {EventUnit}, reúne sua última força para levantar <<o:EventUnit>> voz."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6791@BODY_LORE"
msgstr "\"Amaldiçoados traidores {GLOBAL.FireClanLoreConcept.Hyperlink}, amaldiçoados todos os Hastefolk!\" <<p:EventUnit>> grita violentamente. \"Eles nos atacaram, quebraram nosso feitiço...\" Apenas levemente, o {EventUnit} move <<o:EventUnit>> punho enorme. \"Nós persistiremos. Domamos o Lithorine. O poder dos Reis Gigantes será direito nosso! Uma tempestade irá irromper. Todos os Hastefolk... irão... tremer!\" O {EventUnit} exala <<o:EventUnit>> último suspiro, desabando ao lado do {EventRelic.Name}."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6791@BUTTON_0"
msgstr "Absorva as energias astrais remanescentes [mana/] antes que se dissipem."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6791@BUTTON_3"
msgstr "Declare seu domínio [influence/] sobre o {GLOBAL.StormClanLoreConcept.Name} em todo o reino."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6791@BUTTON_4"
msgstr "Rastreie os ecos ondulantes da tempestade para invocar seres [unit/] de relâmpagos puros."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6791@BUTTON_5"
msgstr "O que pode ser aprendido sobre a magia do {GLOBAL.StormClanLoreConcept.Name} deve ser compartilhado com a Morada de Cristal. [allegiance/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6791@TITLE"
msgstr "Platô da Tempestade de Cristal: Consequências"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6922@BUTTON_6"
msgstr "\"Compartilhe o que você aprendeu sobre o {EventBeastName} com os {GLOBAL.EternalSagesLoreConcept.Name}\". [allegiance/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6989@BODY_FOOTER@ENIGMA_LOCKED"
msgstr "Você deve retornar aos outros salões e resolver seus enigmas. Somente depois disso o Criador falará com você."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6989@BODY_HEADER@ENIGMA_LOCKED"
msgstr "No cômodo central, suas tropas encontram um {EventStackLeader}, observando a região em silêncio."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6989@BODY_LORE@ENIGMA_LOCKED"
msgstr "Elas não ousam se aproximar do {EventStackLeader}, como se uma montanha intransponível estivesse bloqueando seu caminho. Nenhuma palavra precisa ser dita para discernir que este Criador adorado pelo {GLOBAL.StoneClanLoreConcept.Hyperlink} não está aqui para falar com você, mas aguarda outro {GLOBAL.GodirLoreConcept.Hyperlink} envolvido no Salão dos Enigmas."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6989@BUTTON_0@ENIGMA_LOCKED"
msgstr "Partir."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6989@TITLE@ENIGMA_LOCKED"
msgstr "Salão dos Enigmas: Criador Observador"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7003@BUTTON_6"
msgstr "Compartilhe o conhecimento sobre o Criador com os {GLOBAL.EternalSagesLoreConcept.Name}. [allegiance/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7060@BUTTON_4"
msgstr "\"Convoque o exército gelado [unit/] do Clã do Gelo!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7309@BODY_FOOTER"
msgstr "O {EventUnit} examina suas tropas. \"Apenas quando as manifestações de <<ge:malice^n,{EventHero.FirstName}>> forem enfraquecidas, o espírito de {EventHero} <<r:EventHero>> poderá ser desafiado e destruído para sempre.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7309@BODY_HEADER"
msgstr "Atemorizadas pelas vastas ruínas desoladas que se estendem até o horizonte, suas tropas são contatadas por um espírito cintilante de longe."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7309@BODY_LORE"
msgstr "\"Cuidado, cidadãos corajosos!\" O {EventUnit} grita, enquanto <<p:EventUnit>> se aproxima. \"Pois vocês estão entrando em uma terra amaldiçoada. Em eras passadas, este era o domínio de um terrível [hyperlink,GLOBAL.TraitorKingsLoreConcept]Rei Traidor[/hyperlink]. Embora {EventHero} tenha caído sob o justo castigo de [hyperlink,GLOBAL.ArchonsLoreConcept]meu povo[/hyperlink], <<o:EventHero>> espírito quebrado continua a assombrar o reino, afligindo bestas, vermes e até mesmo o solo com uma fome insaciável.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7309@BUTTON_0"
msgstr "Considere o aviso do {EventUnit} enquanto suas tropas entram nas ruínas."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7309@BUTTON_3"
msgstr "Peça ao {EventUnit} para abençoar suas tropas [statuseffectresistance/] antes que elas prossigam."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7309@BUTTON_4"
msgstr "Drene [mana/][evilact/] energias sagradas do {EventUnit} para proteger [statuseffectresistance/] suas próprias tropas."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7309@TITLE"
msgstr "Explorando os Campos Famintos"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7315@BODY_FOOTER"
msgstr "O {EventStackLeader} balança violentamente <<o:EventStackLeader>> cabeça. Então <<p:EventStackLeader>> fixa seu olhar em suas tropas: \"Qual refeição ou presa você trouxe para o meu prato?\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7315@BODY_FOOTER@SPIRIT_WEAKENED"
msgstr "Para confrontar {EventHero}, você deve encontrar e enfraquecer os outros aspectos."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7315@BODY_HEADER"
msgstr "Devorando o {EventStructure}, um terrível {EventStackLeader} é interrompido por suas tropas. Enquanto <<p:EventStackLeader>> se vira para elas, <<p:EventStackLeader>> fala com a voz sinistra de {EventHero}."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7315@BODY_HEADER@SPIRIT_WEAKENED"
msgstr "Você enfraqueceu o aspecto da fome."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7315@BODY_LORE"
msgstr "\"Eu venho a todos, atemporal é minha respiração,\" diz o {EventStackLeader}, mostrando <<o:EventStackLeader>> enormes dentes. \"Em meu rastro, trago a morte voraz. Ossos são roídos, árvores devoradas, arbustos engolidos, <<m:{EventSmallAnimal}>> tragados, <<m:{EventLargeAnimal}>> comidos aos poucos. Tudo consumido dentro do meu poço.\" O {EventStackLeader} ruge. \"Eu não era o rei deles, para alimentá-los? Para governar, meu direito de nascença; para festear, meu prazer primordial. No entanto, todos eles me falharam...\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7315@BODY_LORE@SPIRIT_WEAKENED"
msgstr "Fraca como é, não representa mais uma ameaça para você."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7315@BUTTON_0@SPIRIT_WEAKENED"
msgstr "Deixe o {EventStackLeader} para <<r:EventStackLeader>>."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7315@BUTTON_1"
msgstr "\"A cabeça de um {EventStackLeader}, recém-servida!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7315@BUTTON_2"
msgstr "\"O suficiente {RandomFood} [food/] do nosso reino para engordar a própria fome.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7315@BUTTON_3"
msgstr "\"Nós trazemos a ruína de todos os glutões: O Tomo do Jejum!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7315@BUTTON_4"
msgstr "\"A cauda perdida de um lagarto, escapando da mandíbula...\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7315@TITLE"
msgstr "Campos Famintos: Aspecto da Fome"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7320@BODY_FOOTER"
msgstr "O {EventStackLeader} pega <<o:EventStackLeader>> faca novamente. \"Qual de vocês será o primeiro?\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7320@BODY_HEADER"
msgstr "No calor de uma cozinha infernal alimentada por lava, um {EventStackLeader} se vira da {EventStructure} para cumprimentar suas tropas com a voz profunda de {EventHero}."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7320@BODY_HEADER@SPIRIT_WEAKENED"
msgstr "Você enfraqueceu o aspecto de carnificina."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7320@BODY_LORE"
msgstr "\"Ah, visitantes!\" <<p:EventStackLeader>> chama, colocando <<o:EventStackLeader>> grande faca de açougueiro de lado. \"Qual prato vocês desejam hoje, caros convidados? Alguns {EventRace1}, frescos do forno? {EventRace2} ensopado? Ou melhor ainda, {EventRace3} picado no palito?\" O {EventStackLeader} inclina-se para frente, como se <<p:EventStackLeader>> estivesse compartilhando um segredo. \"Esses arrivistas de {GLOBAL.ObbadothLoreConcept.Hyperlink} pensam que seus templos de carnificina são uma novidade. Eles deveriam ter visto esta Arena do Matadouro em todo o seu esplendor! Servíamos reis e realizávamos banquetes cavaleirescos sem igual...\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7320@BODY_LORE@SPIRIT_WEAKENED"
msgstr "Encharcado de sangue e cansado, o {EventStackLeader} não representa mais uma ameaça para suas tropas."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7320@BUTTON_0"
msgstr "Fuja do {EventStackLeader}."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7320@BUTTON_1"
msgstr "\"Você, {EventHero}—este massacre termina agora!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7320@BUTTON_2"
msgstr "Ferva a {EventStructure} [mana/] para cozinhar o {EventStackLeader} <<r:EventStackLeader>>."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7320@TITLE"
msgstr "Campos Famintos: Aspecto de Carnificina"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7321@BODY_FOOTER"
msgstr "O olhar do {EventStackLeader} penetra suas tropas, olhando diretamente para você—o {EventPlayerType}—observando de longe, buscando um caminho para dentro da sua mente..."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7321@BODY_HEADER"
msgstr "Nas [hyperlink,GLOBAL.AstralVoidLoreConcept]encostas da realidade[/hyperlink], onde o mundo físico parece devorar a si mesmo, um {EventStackLeader} caça as {GLOBAL.SoulsLoreConcept.Hyperlink} perdidas em uma era há muito passada."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7321@BODY_HEADER@SPIRIT_WEAKENED"
msgstr "Você enfraqueceu o aspecto de delírio."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7321@BODY_LORE"
msgstr "\"Sem dentes, eu mordo. Sem boca, eu engulo\", o {EventStackLeader} murmura envolto por um silêncio sobrenatural. \"Nenhuma carne poderia saciar minhas necessidades. A própria terra deve desaparecer em minha goela. Uma dúzia de mentes é uma refeição para eu me alimentar. Ainda assim, acima de tudo, eu desejo almas deliciosas!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7321@BODY_LORE@SPIRIT_WEAKENED"
msgstr "Flutuando silenciosamente, o {EventStackLeader} não representa mais uma ameaça para suas tropas."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7321@BUTTON_0"
msgstr "Fuja do {EventStackLeader}."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7321@BUTTON_1"
msgstr "\"Derrote esta abominação, antes que ela possa acorrentar seus pensamentos!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7321@BUTTON_2"
msgstr "Alimente o {EventStackLeader} com almas [souls/] amaldiçoadas com o esquecimento."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7321@TITLE"
msgstr "Campos Famintos: Aspecto de Delírio"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7324@BUTTON_0@SPIRIT_WEAKENED"
msgstr "Deixe o {EventStackLeader} para <<r:EventStackLeader>>."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7328@BUTTON_0@SPIRIT_WEAKENED"
msgstr "Deixe o {EventStackLeader} para <<r:EventStackLeader>>."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7328@BUTTON_4"
msgstr "Atraia o {EventStackLeader} para dentro, para esmagá-lo com sua força de vontade [knowledge/]."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7461@BODY_FOOTER"
msgstr "Através de magia vil, {EventHero} invoca <<o:EventHero>> servos para proteger <<o:EventHero>> imunda não-vida. Apenas um exército poderoso pode desafiar o [hyperlink,GLOBAL.TraitorKingsLoreConcept]Rei Traidor[/hyperlink]."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7461@BODY_HEADER"
msgstr "Tendo enfraquecido os aspectos de fome, carnificina e delírio, {EventHero} é forçado a revelar <<o:EventHero>> verdadeira forma, um espírito amaldiçoado vingativo."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7461@BODY_LORE"
msgstr "\"Quem você pensa que é para ousar me desafiar?\" <<p:EventHero>> grita, cheio de fúria. \"Eu enganei o {GLOBAL.EternalCouncilLoreConcept.Hyperlink}, escapei da ira do [hyperlink,GLOBAL.ArchonsLoreConcept]Arconte[/hyperlink]. {GLOBAL.DragonsLoreConcept.Hyperlink} evitam meu domínio, com medo do meu alcance inescapável.\" <<Cge:voice^n,EventHero.FirstName>> rosna com trovão, e as ruínas ao redor começam a desmoronar. \"Eu me tornei um poder primordial. EU SOU A FOME. EU SOU A MORTE!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7461@BUTTON_0"
msgstr "Prepare-se para enfrentar {EventHero} e acabar com <<o:EventHero>> malícia."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7461@TITLE"
msgstr "Campos Famintos: {EventHero} Exposto"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7466@BODY_FOOTER"
msgstr "O {EventUnit} desaparece dentro de um clarão radiante, a luz de <<o:EventUnit>> rejuvenescendo o solo que toca. Deixado sozinho no meio da vida recém-brotada, você determina o destino dos Campos Famintos."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7466@BODY_HEADER"
msgstr "À medida que a presença de {EventHero} desaparece, suspiros profundos ecoam das paredes da cidade arruinada e as raras árvores murmuram em alívio."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7466@BODY_LORE"
msgstr "O {EventUnit} que havia lhe alertado sobre a maldição do [hyperlink,GLOBAL.TraitorKingsLoreConcept]Rei Traidor[/hyperlink] retorna às suas tropas. \"{EventHero} foi derrotado—finalmente!\" <<p:EventUnit>> exclama, regozijando-se com radiação. \"Você, {PlayerLeader.TitleName}, aliviou os Campos Famintos de sua maldição e restaurou a paz sobre a terra. Pegue o {EventRelic} dos <<ge:remains^p,EventHero.FirstName>> e observe <<p:EventRelic>> bem. Lá habita um mal que nunca desaparece.\" O {EventUnit} coloca <<o:EventUnit>> armas no chão, colocando <<o:EventUnit>> mão translúcida no chão para uma última oração: \"Minha vigília termina aqui. Este é meu presente de despedida...\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7466@BUTTON_0"
msgstr "\"Isto será um memorial ao triunfo do bem [goodact/] contra o mal!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7466@BUTTON_3"
msgstr "\"O poder do {GLOBAL.TraitorKingsLoreConcept.Name} era grande. No entanto, eu estou acima de tudo!\" [influence/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7466@BUTTON_4"
msgstr "\"Onde havia fome e miséria, haverá abundância [food/] e prosperidade!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7466@BUTTON_5"
msgstr "\"Para estudar a cidade e seu destino, devemos convidar os {GLOBAL.EternalSagesLoreConcept.Name}.\" [allegiance/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7466@BUTTON_6"
msgstr "\"Devemos aprender [knowledge/] o que pudermos sobre <<ge:potent soulcurse magic^n,EventHero.FirstName>>...\" [evilact/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7466@TITLE"
msgstr "Campos Famintos: Consequências"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7496@BODY_FOOTER"
msgstr "\"Recupere o trono de {EventUnit}! Puna os {GLOBAL.TraitorKingCultLoreConcept.Hyperlink}!\" o trol comanda. \"Cultistas lançam feitiços. Esmague os Cultistas. Esmague o feitiço!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7496@BODY_HEADER"
msgstr "Ao pé de uma montanha imponente, o caminho das suas tropas é subitamente bloqueado por um trol grande e real."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7496@BODY_LORE"
msgstr "\"Curvem-se diante da Montanha Guardiã dos Deuses\", o trol grita, apontando para as estruturas cintilantes no topo do planalto da montanha, \"sede do {GLOBAL.BloodClanLoreConcept.Hyperlink} e trono do mais poderoso {EventUnit}!\" <<Cp:EventUnit>> ostenta a coroa em <<o:EventUnit>> cabeça. \"Mas {EventUnit} traiu. Os {GLOBAL.TraitorKingCultLoreConcept.Hyperlink} vieram. Envenenaram as mentes do {GLOBAL.BloodClanLoreConcept.Hyperlink} com orgulho. Ogros e trolls se rebelaram... servem aos traidores!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7496@BUTTON_0"
msgstr "Pergunte ao {EventUnit} onde encontrar os {GLOBAL.TraitorKingCultLoreConcept.Name}."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7496@TITLE"
msgstr "Descobrindo a Montanha Guardiã dos Deuses"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7514@BODY_FOOTER"
msgstr "Com um grito terrível, o {EventUnit} derrama <<o:EventUnit>> própria alma, tentando escapar do seu alcance."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7514@BODY_HEADER"
msgstr "Ferido e derrotado, um {EventUnit} do {GLOBAL.TraitorKingCultLoreConcept.Hyperlink} fala com suas tropas, ainda instigado pelo orgulho."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7514@BODY_LORE"
msgstr "\"Você acha que pode nos deter?\" o {EventUnit} grita, <<o:EventUnit>> mandíbula mantida em movimento apenas por magia negra. \"Para nossos deuses, [hyperlink,GLOBAL.TraitorKingsLoreConcept]os Kjörnoe[/hyperlink], a morte era apenas uma porta, um mero caminho para novos poderes.\" <<Cp:EventUnit>> arranca um icicle de <<o:EventUnit>> ombro, esmagando-o com <<o:EventUnit>> punhos. \"Eles ousaram se opor à falsa ordem dos {GLOBAL.ArchonsLoreConcept.Hyperlink}. Como {GLOBAL.TraitorKingCultLoreConcept.Hyperlink}, nós carregamos seu legado e dominamos sua magia. A imortalidade está próxima...\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7514@BUTTON_0"
msgstr "Deixe a alma de <<o:EventUnit>> escapar para <<o:EventUnit>> mestres."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7514@BUTTON_4"
msgstr "Banir [mana/] a alma para acabar com a malícia de <<o:EventUnit>>. [goodact/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7514@BUTTON_5"
msgstr "Prender [mana/] a alma para extrair os doces segredos [knowledge/] da magia Kjörnoe... [evilact/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7514@TITLE"
msgstr "Montanha Guardiã dos Deuses: A {EventRace}"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7515@BODY_FOOTER"
msgstr "O {EventUnit} desaba. Se as últimas palavras lunáticas de <<o:EventUnit>> continham algum grão de verdade, o {GLOBAL.TraitorKingCultLoreConcept.Hyperlink} está abusando do {GLOBAL.BloodClanLoreConcept.Hyperlink} como sacrifícios em seus rituais vis."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7515@BODY_HEADER"
msgstr "À beira do último suspiro de <<o:EventUnit>>, um {EventUnit} do {GLOBAL.TraitorKingCultLoreConcept.Hyperlink} de repente irrompe em risadas."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7515@BODY_LORE"
msgstr "\"Você viu os ogros?\" o {EventUnit} pergunta rindo, <<o:EventUnit>> sanidade há muito perdida. \"Eles respingam como sapos grandes. Intestinos verdes, goo azul. Pintam as paredes. Incham-nos com essência mágica, espetam-nos com um fragmento de gelo e—ploft! É engraçado, estúpido!\" <<Cp:EventUnit>> cospe sangue enquanto <<p:EventUnit>> ri. \"Eles acham que nós lhes concederíamos poder. Oh, sim, poder de sapo verde respingante!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7515@BUTTON_0"
msgstr "\"Descobriremos em breve.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7515@TITLE"
msgstr "Monte Godkeep: Sacrifícios {GLOBAL.BloodClanLoreConcept.Name}"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7516@BODY_FOOTER"
msgstr "\"Líder do culto forte,\" o {EventUnit} avisa. \"{EventUnit} tem três servos leais. Um se junta a {PlayerLeader}, luta contra {EventHero}. {PlayerLeader} escolhe.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7516@BODY_HEADER"
msgstr "Suas tropas dizimaram o {GLOBAL.TraitorKingCultLoreConcept.Hyperlink} que vagava pelas encostas do Monte Godkeep. O {EventUnit} retorna a eles, sorrindo com alegria maliciosa."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7516@BODY_LORE"
msgstr "\"Cultistas riem e torturam {GLOBAL.BloodClanLoreConcept.Hyperlink},\" diz o {EventUnit} com ressentimento. \"Quem ri agora?\" <<Cp:EventUnit>> balança <<o:EventUnit>> grande maça em direção ao topo da montanha. \"Escudo de feitiço dos Cultistas quebrado. Agora, {EventHero} teme a vingança de {EventUnit}. Esconde-se na sala do trono. Colar de caveira de <<Co:EventHero>> para {EventUnit}.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7516@BUTTON_0"
msgstr "Escolha o nutridor {BeastOgre} [unit/]."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7516@BUTTON_4"
msgstr "Escolha o habilidoso {TrainerOgre} [unit/]."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7516@BUTTON_5"
msgstr "Escolha o astuto {SeerOgre} [unit/]."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7516@TITLE"
msgstr "Monte Godkeep: Para o Trono!"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7522@BODY_FOOTER"
msgstr "\"Não vejo presentes nem escravos dignos da minha magnificência,\" {CultHero} conclui. \"Então você morre.\" De trás do trono, grandes {GLOBAL.BloodClanLoreConcept.Hyperlink} grunhidos aparecem, prontos para defender seu recém-encontrado \"<<CultHero{King/Queen}>>\"."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7522@BODY_FOOTER@ENTRY_BLOCKED"
msgstr "Parece que o {EventUnit} disse a verdade e {EventStructure} só pode ser acessado depois que {GLOBAL.TraitorKingCultLoreConcept.Hyperlink} suficientes foram mortos para interromper seu feitiço."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7522@BODY_HEADER"
msgstr "Entrando no portão da frente do imponente complexo de estruturas com suas paredes e estatuária grandiosas, suas tropas se encontram em um salão impecável de grandeza sem igual."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7522@BODY_HEADER@ENTRY_BLOCKED"
msgstr "Aproximando-se do imponente complexo de estruturas com suas paredes e estatuária grandiosas, suas tropas encontram qualquer caminho dentro bloqueado."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7522@BODY_LORE"
msgstr "\"Você veio me oferecer reverência?\" uma voz gelada chama, ecoando pela câmara gigante. \"Ou você terminará sua vida em uma tolice de desafio? Pois quando olhei no Espelho, previ meu destino para empunhar os poderes dos deuses. Eu, {CultHero}, que carrega a marca secreta de [hyperlink,GLOBAL.TraitorKingsLoreConcept]Kjörnoe[/hyperlink] e lidera seus Filhos para um domínio sombrio.\" À distância, a coroa de Netherice de {CultHero} revela <<o:CultHero>> maneirismos abaixo do antigo trono gigante."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7522@BODY_LORE@ENTRY_BLOCKED"
msgstr "Um feitiço poderoso sela cada portão, cada porta, cada pequena brecha dentro das antigas paredes, bloqueando-o com uma barreira impenetrável de Netherice."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7522@BUTTON_0"
msgstr "Traga este falso <<CultHero{Rei/Rainha}>> para <<o:CultHero>> joelhos!"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7522@BUTTON_1"
msgstr "Reprenda [influence/] os trolls e ogros por traírem seu rei."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7522@BUTTON_2"
msgstr "Fugir."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7522@TITLE"
msgstr "Monte Godkeep: O Falso <<CultHero{Rei/Rainha}>>"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7522@TITLE@ENTRY_BLOCKED"
msgstr "Monte Godkeep: Barreira de Gelo"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7523@BODY_FOOTER"
msgstr "O {EventUnit} tira <<o:EventUnit>> coroa. \"{PlayerLeader} digno {PlayerLeader.Title}. {EventUnit} não tem mais {GLOBAL.BloodClanLoreConcept.Hyperlink}. Seguirá {PlayerLeader}!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7523@BODY_HEADER"
msgstr "Com o {CultHero} caído vítima de <<o:CultHero>> hubris, o {EventUnit} retorna à sala do trono <<p:EventUnit>> que já governou."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7523@BODY_LORE"
msgstr "\"Irmãos de {EventUnit}, todos mortos...\" <<p:EventUnit>> diz, olhando sobre os corpos dos {GLOBAL.BloodClanLoreConcept.Hyperlink} caídos espalhados por muitas câmaras de {EventStructure}. O {EventUnit} abaixa <<o:EventUnit>> cabeça enorme, <<o:EventUnit>> olhos hediondos ficando turvos. \"Culpa de {EventUnit}. {EventRelic} condenou {EventUnit}. Mostrou glória. Trouxe morte. Agora {EventRelic} condenou {CultHero}.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7523@BUTTON_3"
msgstr "Aceite a lealdade do {EventUnit} [unit/]."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7523@BUTTON_6"
msgstr "Envie o {EventUnit} para o {GLOBAL.EternalSagesLoreConcept.Name} [allegiance/], compartilhando conhecimento sobre o {GLOBAL.BloodClanLoreConcept.Hyperlink} e o {GLOBAL.TraitorKingCultLoreConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7523@BUTTON_7"
msgstr "Sacrifique o {EventUnit} [evilact/] para reanimar {CultHero} [hero/] como seu servo das trevas."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7523@BUTTON_8"
msgstr "Sacrifique o {EventUnit} [evilact/] para reanimar {CultHero} [hero/] como seu servo das trevas."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7523@BUTTON_9"
msgstr "Tome apenas a coroa do {EventUnit}, como um emblema [influence/] do seu esplendor crescente."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7523@TITLE"
msgstr "Montar Godkeep: Consequências"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7754@BUTTON_3"
msgstr "\"Os sábios sabem [knowledge/] que só podem encontrar o que carregavam dentro de si mesmos.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7754@BUTTON_4"
msgstr "\"As energias arcana [mana/] emanadas pelos cristais desta ilha irão aguçar nossas mentes.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7774@BODY_FOOTER@TRIAL_FAILED"
msgstr "A voz uníssona termina seu suplício: \"Você será detido nestas ilhas, como muitos pequenos ladrões e saqueadores que vieram antes!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7774@BODY_FOOTER@TRIAL_LOCKED"
msgstr "Você deve retornar aos locais de julgamento e responder ao {EventStackLeader} lá."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7774@BODY_HEADER@TRIAL_LOCKED"
msgstr "Suas tropas se aproximam cuidadosamente do {EventStackLeader}, flutuando no meio das três ilhas, mas <<p:EventStackLeader>> os ignora."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7774@BODY_LORE@TRIAL_FAILED"
msgstr "\"Você respondeu aos nossos julgamentos,\" diz o {EventStackLeader}, \"e consideramos suas respostas indignas!\" Há reflexos de cristal na água, cegando suas tropas, mas eles desaparecem novamente enquanto o {EventStackLeader} continua: \"O <<m:{GLOBAL.GiantKingLoreConcept.Hyperlink}>> governou {GLOBAL.MyrridaLoreConcept.Hyperlink} com grande sabedoria. Havia igualdade entre gigantes e os parentes menores e até mesmo o <<m:{GLOBAL.GiantKingLoreConcept.Hyperlink}>> obedecia à lei e aos vereditos do {GLOBAL.EternalCouncilLoreConcept.Hyperlink}.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7774@BODY_LORE@TRIAL_LOCKED"
msgstr "\"Viemos julgar outro {GLOBAL.GodirLoreConcept.Hyperlink},\" exclama o {EventStackLeader}. \"Retorne a nós quando tiver respondido aos nossos julgamentos.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7774@BUTTON_0@TRIAL_LOCKED"
msgstr "Partir."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7774@BUTTON_1@TRIAL_FAILED"
msgstr "\"Você subestima os poderes de um {GLOBAL.GodirLoreConcept.Name}. Esta detenção termina agora!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7774@BUTTON_5"
msgstr "\"Valor.\" [unitprod/][chaosboon/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7774@BUTTON_6"
msgstr "\"Caridade.\" [gold/][orderboon/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7774@BUTTON_7"
msgstr "\"Frugalidade.\" [food/][natureboon/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7774@TITLE@TRIAL_LOCKED"
msgstr "Ilha da Trindade: O {EventStackLeader}"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7777@BODY_HEADER@TRIAL_FAILED"
msgstr "Você destruiu o {EventUnit} e arrebatou a Ilha da Trindade do domínio eterno de <<o:EventUnit>>."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7800@BODY_FOOTER"
msgstr "\"A Última Legião aguarda suas ordens,\" diz o {EventUnit}. \"Somos os defensores de {GLOBAL.MyrridaLoreConcept.Hyperlink}. Diga a palavra e expulsaremos qualquer invasor.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7800@BODY_HEADER"
msgstr "Examinando os Artefatos de Flowrock que você possui, eles de repente ganham vida e dentro do triângulo que formam, um {EventUnit} surge, puxado das profundezas do reino."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7800@BODY_LORE"
msgstr "\"Você nos convocou para ajudá-lo, mestre?\" <<p:EventUnit>> pergunta, proferindo com uma voz sem boca. \"Nós dormimos ao longo dos séculos, esperando abaixo da terra. É hoje o dia em que finalmente nos levantamos, expulsando todos os invasores que ameaçam {GLOBAL.MyrridaLoreConcept.Hyperlink}?\" Em sua mente, imagens de linhas intermináveis de soldados de barro se formam, abrindo seus olhos sem pálpebras dentro de tumbas eternas. Seus flancos guardados por armas levitantes dos antigos <<m:{GLOBAL.GiantKingLoreConcept.Hyperlink}>> ligados por uma magia imortal."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7800@BUTTON_0"
msgstr "Liberte a Última Legião sobre o reino!"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7800@BUTTON_1"
msgstr "Diga que chamará a Última Legião uma após a outra, como defensores reais."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7800@BUTTON_2"
msgstr "Liberte a Última Legião de seu dever eterno, absorvendo a essência mágica [mana/][bindingessence/][bindingfragments/] que os mantinha vivos."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7800@TITLE"
msgstr "A Última Legião: Introdução"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7819@BODY_FOOTER"
msgstr "A Última Legião está surgindo de suas câmaras enterradas para assaltar o reino. Como você deseja se preparar para o ataque deles?"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7819@BODY_HEADER"
msgstr "O reino é abalado pelo medo enquanto histórias de uma mítica Última Legião de {GLOBAL.MyrridaLoreConcept.Hyperlink} se espalham."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7819@BODY_LORE"
msgstr "De fato, a terra está em tumulto. Você pode sentir seus tremores ondulantes, ouvir seus murmúrios ancestrais. Aldeões de todas as partes da terra contam histórias de figuras de argila movendo-se na escuridão de seus campos. Ferreiros falam de armas que ganham vida e deixam as forjas para se juntar às fileiras da Última Legião. A verdade dessas histórias ainda precisa ser julgada, mas você sente um perigo iminente."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7819@BUTTON_0"
msgstr "\"Ajuntamento dos Vassalos! [influence/] Este é o momento em que eles honrarão nossos pactos.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7819@BUTTON_1"
msgstr "\"Deixe os arautos [influence/] recrutar qualquer homem ou mulher [unitprod/] disposto a defender nossas cidades!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7819@BUTTON_2"
msgstr "\"Um Godir não teme nem pedaços de argila nem armas enferrujadas.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7819@TITLE"
msgstr "A Última Legião: Movimentos na Terra"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7821@BODY_FOOTER"
msgstr "Exércitos da Última Legião estão marchando sobre suas cidades. Repila seus ataques, ou tudo será reduzido a nada!"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7821@BODY_HEADER"
msgstr "Um silêncio perturbador cai sobre suas cidades enquanto linhas intermináveis de Soldados de Argila surgem da terra."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7821@BODY_LORE"
msgstr "Eles não falam nenhuma palavra, nem as armas encantadas que flutuam em seus flancos. Mas está claro que esta Última Legião de Myrrida tem apenas um propósito: eliminar qualquer um com um pé em seu antigo reino perdido—exceto dentro das terras de {EventPlayer}. Neste momento de maior perigo, a traição do {EventPlayer.Title} dos {EventRace} fica clara. Foi <<P:EventPlayer>> quem libertou a Última Legião!"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7821@BUTTON_0"
msgstr "\"Uma vez que tenhamos superado a tempestade, {EventPlayer} pagará por isso!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7821@TITLE"
msgstr "A Última Legião: Assalto Global"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7848@BODY_FOOTER"
msgstr "Neste momento de vitória dolorosa, os {EventRace} voltam-se para seu {PlayerLeader.Title}. Você fecha os olhos e remodela a argila e as armas espalhadas em..."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7848@BODY_HEADER"
msgstr "Com a Última Legião esmagada e derrotada, uma sensação de paz retorna ao seu reino, finalmente."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7848@BODY_LORE"
msgstr "No entanto, há pouco motivo para uma vitória alegre. Pois quando os inimigos eram apenas argila e aço sem coração, os corpos encontrados nos campos de batalha ilustram claramente as perdas do seu povo. Há relatos de outros Godir ainda resistindo à Última Legião em seus domínios. Mas isso não deve preocupá-lo, pois os {EventRace} estão em segurança."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7848@BUTTON_0"
msgstr "...um monumento de guerra. [unitprod/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7848@BUTTON_2"
msgstr "...um monumento de paz. [goodact/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7848@BUTTON_3"
msgstr "...um mausoléu para os caídos. [influence/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7848@BUTTON_4"
msgstr "...trabalhadores de argila para reconstruir suas cidades. [structureprod/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7848@TITLE"
msgstr "A Última Legião: Fragmentos de Argila"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7857@BODY_FOOTER"
msgstr "\"Um batalhão é seu para comandar diretamente, mestre,\" o {EventUnit} termina. \"Que você nos leve à vitória!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7857@BODY_HEADER"
msgstr "A Última Legião chega em esplendor terrível enquanto linhas intermináveis de Soldados de Argila surgem da terra."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7857@BODY_LORE"
msgstr "\"A hora está próxima, mestre,\" um {EventUnit} que se manifestou <<r:EventUnit>> dentro de sua sala do trono fala. \"Hoje saímos de nossas câmaras profundas para defender os vestígios de {GLOBAL.MyrridaLoreConcept.Hyperlink}. Finalmente, nosso propósito será cumprido!\" As incontáveis legiões da Última Legião iniciam sua marcha contra os outros Godir do reino. Percebendo sua traição, eles amaldiçoam seu nome, mas já é tarde demais."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7857@BUTTON_0"
msgstr "\"E a vitória será nossa!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7857@TITLE"
msgstr "A Última Legião: Glória de Myrrida"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_1@DESCRIPTION"
msgstr "Ataques base de {GLOBAL.MagicConcept.Hyperlink} de unidades encantadas ganham:[bulletlist][bullet/]Uma chance base de {VOLATILE_CHARGE_RESISTANCE>ResolvedStrength}% de aplicar {GLOBAL.PROPERTIES.VOLATILE_CHARGE.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_1@NAME"
msgstr "Foco de Cristal"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_1@PROP_DESCRIPTION"
msgstr "Ataques base de {GLOBAL.MagicConcept.Hyperlink} da unidade têm:[bulletlist][bullet/]Uma chance base de {VOLATILE_CHARGE_RESISTANCE>ResolvedStrength}% de aplicar {GLOBAL.PROPERTIES.VOLATILE_CHARGE.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_2@DESCRIPTION"
msgstr "Unidades inimigas em um raio de {VOLATILE_CHARGE_TARGETER>AREA>Radius} hexágonos:[bulletlist][bullet/]Sofrem {CRYSTAL_CRASH_UNIT_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Sofrem {CRYSTAL_CRASH_UNIT_DAMAGE>DAMAGE>Shock} {GLOBAL.LightningDamageConcept.Hyperlink}.[bullet/]Têm uma chance base de {VOLATILE_CHARGE_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.VOLATILE_CHARGE.Hyperlink} por {VOLATILE_CHARGE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_2@NAME"
msgstr "Quebra de Cristal"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_3@DESCRIPTION"
msgstr "Um {GLOBAL.PROPERTIES.POLEARM_UNIT.Hyperlink} que imobiliza inimigos. Pode ser alistado em cidades."

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_3@NAME"
msgstr "Lanceador de Estilhaços Litório"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_4@DESCRIPTION"
msgstr "Um {GLOBAL.PROPERTIES.BATTLE_MAGE.Hyperlink} que inflige {GLOBAL.PROPERTIES.VOLATILE_CHARGE.Hyperlink} em uma grande área. Pode ser alistado em cidades."

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_4@NAME"
msgstr "Gêmeo Litório"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_5@DESCRIPTION"
msgstr "Revive a unidade alvo não-Litória e não-Herói como um Litório do mesmo Nível.[br/][br/]Se vitorioso em combate, as unidades revividas podem ser mantidas por um custo de {GLOBAL.ManaConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_5@NAME"
msgstr "Cristalizar Essência"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_6@DESCRIPTION"
msgstr "[bulletlist][bullet/]{amount} {GLOBAL.ManaConcept.Hyperlink}[bullet/]{amount2} {GLOBAL.KnowledgeConcept.Hyperlink}[bullet/]{amount3} {GLOBAL.ImperiumConcept.Hyperlink}[/bulletlist]"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_6@NAME"
msgstr "Embaixada Eterna"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_7@DESCRIPTION"
msgstr "Um {GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink} com um forte ataque de carga e a habilidade de criar uma cadeia de relâmpagos que pode desencadear {GLOBAL.PROPERTIES.VOLATILE_CHARGE.Hyperlink}. Pode ser alistado em cidades."

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_7@NAME"
msgstr "Simulacro Litório"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_8@DESCRIPTION"
msgstr "Uma {GLOBAL.PROPERTIES.SUPPORT_UNIT.Hyperlink} que pode se conectar a unidades e receber dano por elas. Pode ser alistado em cidades."

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_8@NAME"
msgstr "Núcleo Litório"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_9@DESCRIPTION"
msgstr "Uma {GLOBAL.PROPERTIES.RANGED_UNIT.Hyperlink} com um ataque à distância que aplica {GLOBAL.PROPERTIES.VOLATILE_CHARGE.Hyperlink}. Pode ser alistado em cidades."

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_9@NAME"
msgstr "Agulheiro Litório"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@TOME@DESCRIPTION"
msgstr "Essas bênçãos podem ser compradas de uma {GLOBAL.CrystalDwellingConcept.Hyperlink} ao alcançar um pacto de Cristal ou Eterno com eles. Eles darão acesso a unidades Litórias e ao poder dos Eternos."

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@TOME@NAME"
msgstr "Pacto de Cristal"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL1@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{amount1} {GLOBAL.GoldConcept.Hyperlink}[bullet/]+{amount2} {GLOBAL.GoldConcept.Hyperlink} por {GLOBAL.ProvinceConcept.Hyperlink} de Masmorra adjacente.[bullet/]+{amount3} {GLOBAL.BindingEssenceConcept.Hyperlink} por {GLOBAL.ProvinceConcept.Hyperlink} de Masmorra adjacente[bullet/]Conta como uma {GLOBAL.MineConcept.Hyperlink}[/bulletlist]"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL1@NAME"
msgstr "[mine/] Cofre Subterrâneo"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL2@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{amount1} {GLOBAL.StructureProductionConcept.Hyperlink} por {GLOBAL.ProvinceConcept.Hyperlink} de Masmorra adjacente.[bullet/]+{amount2} {GLOBAL.UnitProductionConcept.Hyperlink} por {GLOBAL.ProvinceConcept.Hyperlink} de Masmorra adjacente.[bullet/]Permite o alistamento das unidades {GLOBAL.UNITS.CLAY_ARBALEST.Hyperlink}, {GLOBAL.UNITS.CLAY_CHARGER.Hyperlink} e {GLOBAL.UNITS.CLAY_DEFENDER.Hyperlink}.[bullet/]Conta como uma {GLOBAL.QuarryConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL2@NAME"
msgstr "[quarry/] Forja de Argila"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL3@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{amount1} {GLOBAL.FortificationHealthConcept.Hyperlink} por {GLOBAL.ProvinceConcept.Hyperlink} de Masmorra adjacente.[bullet/]+{amount2} {GLOBAL.CityStabilityConcept.Hyperlink} por {GLOBAL.ProvinceConcept.Hyperlink} de Masmorra adjacente.[bullet/]Um {GLOBAL.UNITS.CLAY_ARBALEST.Hyperlink}, {GLOBAL.UNITS.CLAY_CHARGER.Hyperlink} ou um {GLOBAL.UNITS.CLAY_DEFENDER.Hyperlink} se junta ao combate do seu lado quando lutando no domínio desta cidade (não funciona na água ou lava).[bullet/]Conta como uma {GLOBAL.QuarryConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL3@EFFECT_DESCRIPTION"
msgstr "Adiciona aleatoriamente uma unidade {GLOBAL.UNITS.CLAY_ARBALEST.Hyperlink}, {GLOBAL.UNITS.CLAY_CHARGER.Hyperlink} ou {GLOBAL.UNITS.CLAY_DEFENDER.Hyperlink} a esta luta."

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL3@NAME"
msgstr "[quarry/] Quartel Silencioso"

