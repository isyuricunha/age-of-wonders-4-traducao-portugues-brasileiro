msgid "TOME_AMPLIFICATION@SKILL5@NAME"
msgstr "Amplificar Mentes"

msgid "TOME_AMPLIFICATION@SKILL6@DESCRIPTION"
msgstr "Faz com que os ataques de unidades encantadas:[bulletlist][bullet/]Causem +{LIGHTNING_FOCUS_EXTRA_DAMAGE>DAMAGE>Shock} {GLOBAL.LightningDamageConcept.Hyperlink}.[bullet/]Ganham uma chance base de {ELECTRIFIED_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.ELECTRIFIED.Hyperlink}, um efeito de dano ao longo do tempo.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_AMPLIFICATION@SKILL6@NAME"
msgstr "Foco de Relâmpago"

msgid "TOME_AMPLIFICATION@SKILL6@PROPERTY_DESCRIPTION"
msgstr "Os ataques da unidade têm:[bulletlist][bullet/]+{LIGHTNING_FOCUS_EXTRA_DAMAGE>DAMAGE>Shock} {GLOBAL.LightningDamageConcept.Hyperlink}.[bullet/]Uma chance base de {ELECTRIFIED_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.ELECTRIFIED.Hyperlink}.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_AMPLIFICATION@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Aprimore seus magos e sua magia com magia arcana mais avançada."

msgid "TOME_AMPLIFICATION@TOME@LORE_AUTHOR"
msgstr "Merlin, o Viajante"

msgid "TOME_AMPLIFICATION@TOME@LORE_DESCRIPTION"
msgstr "\"Um dos aspectos mais fascinantes do arcano é que ele pode ser voltado contra si mesmo, aumentando e amplificando sua própria essência. Qualquer feiticeiro pode lançar um feitiço, mas um verdadeiro mestre busca aperfeiçoá-lo e elevar a si mesmo e sua magia além do que meros praticantes consideram possível.\""

msgid "TOME_AMPLIFICATION@TOME@NAME"
msgstr "Tomo de Amplificação"

