msgid "DLC@SECRETSOFTHEARCHMAGES@ORDER_BOUND_PRAYER@AFFINITY_CHOICE_ORDER@FAILURE_01"
msgstr "Your prayer was heard but remains unanswered."

msgid "DLC@SECRETSOFTHEARCHMAGES@ORDER_BOUND_PRAYER@AFFINITY_CHOICE_ORDER@FAILURE_02"
msgstr "Your prayer failed to transcend the infernal depths of the Azh'Ruun Pit."

msgid "DLC@SECRETSOFTHEARCHMAGES@ORDER_BOUND_PRAYER@AFFINITY_CHOICE_ORDER@HEADER"
msgstr "You pray upon higher forces to protect you against evil."

msgid "DLC@SECRETSOFTHEARCHMAGES@ORDER_BOUND_PRAYER@AFFINITY_CHOICE_ORDER@SUCCESS"
msgstr "Higher forces bless you with a protector [unit/] against evil."

msgid "DLC@SECRETSOFTHEARCHMAGES@QUEST@ACTIVATE_OBELISK@FAIL_REASON"
msgstr "All portals have already been revealed"

msgid "DLC@SECRETSOFTHEARCHMAGES@QUESTION_KARISSA@AFFINITY_CHOICE@CHAOS@SUCCESS"
msgstr "You break through <<g:mania^n,Karissa>> and <<p:Karissa>> complies."

msgid "DLC@SECRETSOFTHEARCHMAGES@QUESTION_KARISSA@AFFINITY_CHOICE_CHAOS@FAILURE"
msgstr "Unimpressed, {Karissa.FirstName} erupts in a scathing cackle."

msgid "DLC@SECRETSOFTHEARCHMAGES@QUESTION_KARISSA@AFFINITY_CHOICE_CHAOS@HEADER"
msgstr "Attempt to convince {Karissa.FirstName} to explain <<r:Karissa>> to you."

