msgstr "Invocar Deus Cornífero"

msgid "TOME_ARCHDRUID@SKILL4@DESCRIPTION"
msgstr "Todas as unidades amigáveis em um raio de {AWAKEN_INSTINCTS_CIRCLE_TARGETER>AREA>Radius} hexágonos:[bulletlist][bullet/]Cura +{AWAKEN_INSTINCTS_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Recuperam todos os <<m:{GLOBAL.ActionPointConcept.Hyperlink}>>.[bullet/]Tornam-se {GLOBAL.PROPERTIES.BERSERK.Hyperlink} por {BERSERK_DESCRIPTION_2>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][br/]Não afeta unidades com {GLOBAL.ControlLossImmunityConcept.Hyperlink}."

msgid "TOME_ARCHDRUID@SKILL4@NAME"
msgstr "Despertar Instintos"

msgid "TOME_ARCHDRUID@SKILL5@DESCRIPTION"
msgstr "{GLOBAL.ProvinceConcept.Hyperlink} alvo com {GLOBAL.ForestConcept.Hyperlink}:[bulletlist][bullet/]Perde {GLOBAL.ForestConcept.Hyperlink}.[bullet/]Um {GLOBAL.ArmyConcept.Hyperlink} de <<m:{GLOBAL.PROPERTIES.ANIMAL.Hyperlink}>> e <<m:{GLOBAL.PROPERTIES.PLANT.Hyperlink}>> é invocado sob seu controle.[/bulletlist]"

msgid "TOME_ARCHDRUID@SKILL5@NAME"
msgstr "Despertar a Floresta"

msgid "TOME_ARCHDRUID@SKILL5@UNIT_DESCRIPTION"
msgstr "Um poderoso guardião da natureza e a personificação de sua fúria. Capaz de invocar e curar."

msgid "TOME_ARCHDRUID@SKILL5@UNIT_NAME"
msgstr "Deus Cornífero^n"

msgid "TOME_ARCHDRUID@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Concede magias poderosas que liberam o poder incontrolável da natureza."

msgid "TOME_ARCHDRUID@TOME@LORE_AUTHOR"
msgstr "Serena, Feiticeira Élfica da Vida"

msgid "TOME_ARCHDRUID@TOME@LORE_DESCRIPTION"
msgstr "\"A natureza é a folha ao vento, o ninho, o cordeiro recém-nascido. Também é a tempestade furiosa que dilacera a terra, o poderoso redemoinho que destrói pedra e carne igualmente. A natureza pode ser cruel, implacável... poderosa! Domine-a e você comandará as energias primais que deixam seres menores tremendo de terror.\""

msgid "TOME_ARCHDRUID@TOME@NAME"
msgstr "Tomo da Fúria da Natureza"

msgid "TOME_ARCHDRUID@UNIT1@ABILITY1@JUMP@DESCRIPTION"
msgstr "Cura uma unidade aliada adjacente ao alvo +{RECLAIMING_BOLT_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>."

msgid "TOME_ARCHDRUID@UNIT1@ABILITY1@JUMP@NAME"
msgstr "Reivindicar"

msgid "TOME_ARCHDRUID@UNIT1@ABILITY1@NAME"
msgstr "Relâmpago Reivindicador"

msgid "TOME_ARCHDRUID@UNIT1@ABILITY2@DESCRIPTION"
msgstr "Dentro de um raio de {WILD_ERUPTION_POSITION_TARGETER_CIRCLE>AREA>Radius} hexágonos:[bulletlist][bullet/]Causa {GLOBAL.PhysicalDamageConcept.Hyperlink} a todas as unidades e obstáculos.[bullet/]Invoca Trepadeiras Vivas em cada hexágono desocupado.[/bulletlist]"

msgid "TOME_ARCHDRUID@UNIT1@ABILITY2@NAME"
msgstr "Erupção Selvagem"

msgid "TOME_ARCHDRUID@UNIT1@ABILITY3@DESCRIPTION"
msgstr "O alvo {GLOBAL.FloraObstacleConcept.Hyperlink} transforma-se em uma unidade {GLOBAL.UNITS.FLORAL_STINGER.Hyperlink} sob seu controle.{LOC.CONCEPT@SUMMON_LIVE_SHARED}"

msgid "TOME_ARCHDRUID@UNIT1@ABILITY3@NAME"
msgstr "Animar Flora"

msgid "TOME_ARCHDRUID@UNIT1@ABILITY4@DESCRIPTION"
msgstr "Unidades amigáveis {GLOBAL.PROPERTIES.ANIMAL.Hyperlink} e {GLOBAL.PROPERTIES.PLANT.Hyperlink} ganham {GLOBAL.PROPERTIES.STALWART.Hyperlink}."

msgid "TOME_ARCHDRUID@UNIT1@ABILITY4@NAME"
msgstr "Pastor das Selvas"

msgid "TOME_ARCHDRUID@VINE_ERUPTION@DESCRIPTION"
msgstr "Em um raio de {radius} hexágonos [range/]:[bulletlist][bullet/]Unidades sofrem {GLOBAL.BlightDamageConcept.Hyperlink}.[bullet/]Obstáculos sofrem dano dobrado.[/bulletlist]"

msgid "TOME_ARCHDRUID@VINE_ERUPTION@NAME"
msgstr "Erupção de Trepadeiras"

msgid "TOME_ARCH_MAGE@HERO_SKILL@DESCRIPTION"
msgstr "Concede ataques {GLOBAL.MagicConcept.Hyperlink}:[bulletlist][bullet/]+{MAXIMIZED_MAGIC_CRITICAL_CHANCE>ResolvedCritChanceBonus}% {GLOBAL.CriticalHitChanceConcept.Hyperlink}[bullet/]+{MAXIMIZED_MAGIC_ACCURACY_BOOST>ResolvedAccuracyModifier}% {GLOBAL.AccuracyConcept.Hyperlink}[/bulletlist]"

msgid "TOME_ARCH_MAGE@HERO_SKILL@MODIFIER@DESCRIPTION"
msgstr "Concede +{MAXIMIZED_MAGIC_CRITICAL_CHANCE>ResolvedCritChanceBonus}% {GLOBAL.CriticalHitChanceConcept.Hyperlink} e +{amount2}% {GLOBAL.AccuracyConcept.Hyperlink}."

msgid "TOME_ARCH_MAGE@HERO_SKILL@NAME"
msgstr "Magia Maximizada"

msgid "TOME_ARCH_MAGE@PASSIVE@DESCRIPTION"
msgstr "Quando seu {GLOBAL.LeaderConcept} entra em batalha, a unidade ganha {amount} <<m:{GLOBAL.CombatCastingPointConcept}>> até o final da batalha."

msgid "TOME_ARCH_MAGE@PASSIVE@NAME"
msgstr "Mestre Tecelão de Magias"

msgid "TOME_ARCH_MAGE@SKILL1@DESCRIPTION"
msgstr "Faz seu líder se teletransportar para o hexágono do mundo alvo."

msgid "TOME_ARCH_MAGE@SKILL1@NAME"
msgstr "Viagem Astral"

msgid "TOME_ARCH_MAGE@SKILL2@DESCRIPTION"
msgstr "Unidades inimigas alvo em um raio de {TIME_STOP_UNIT_TARGETER_CIRCLE>AREA>Radius} hexágonos:[bulletlist][bullet/]Ficam {GLOBAL.PROPERTIES.STUNNED.Hyperlink} por {STUNNED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Ficam {GLOBAL.PROPERTIES.DISTRACTED.Hyperlink} por {DISTRACTED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Ganham {stacks} {GLOBAL.PROPERTIES.MARKED.Hyperlink} por {MARKED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "TOME_ARCH_MAGE@SKILL2@NAME"
msgstr "Parada Temporal"

msgid "TOME_ARCH_MAGE@SKILL3@DESCRIPTION"
msgstr "Concede às unidades encantadas:[bulletlist][bullet/]+{COSMIC_OVERDRIVE_DAMAGE_MULTIPLIER>ResolvedMultiplier}% de dano.[bullet/]{GLOBAL.PROPERTIES.VERY_FAST_MOVEMENT.Hyperlink}.[/bulletlist]"

msgid "TOME_ARCH_MAGE@SKILL3@NAME"
msgstr "Superaceleração Cósmica"

msgid "TOME_ARCH_MAGE@SKILL3@PROPERTY_DESCRIPTION"
msgstr "A unidade tem:[bulletlist][bullet/]+{COSMIC_OVERDRIVE_DAMAGE_MULTIPLIER>ResolvedMultiplier}% de dano.[bullet/]{GLOBAL.PROPERTIES.VERY_FAST_MOVEMENT.Hyperlink}.[/bulletlist]"

msgid "TOME_ARCH_MAGE@SKILL4@DESCRIPTION"
msgstr "[bulletlist][bullet/]Unidades inimigas têm uma chance base de {DISRUPTION_RESISTANCE>ResolvedStrength}% de se tornarem {GLOBAL.PROPERTIES.DISRUPTION_TOOLTIP_PROPERTY.Hyperlink} por {DISRUPTION_DISABLE>Duration} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Dissipa {DISRUPTION_WAVE_PROPERTY_DISPEL_ENEMIES>NumThingsToDispel} <<m:{GLOBAL.PositiveStatusEffectConcept.Hyperlink}>> dos inimigos.[bullet/]Dissipa {DISRUPTION_WAVE_DISPEL_ALLIES>NumThingsToDispel} <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>> dos aliados.[/bulletlist]"

msgid "TOME_ARCH_MAGE@SKILL4@NAME"
msgstr "Onda de Ruptura"

msgid "TOME_ARCH_MAGE@SKILL5@NAME"
msgstr "Era Astral"

msgid "TOME_ARCH_MAGE@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Atinga o auge das artes arcanas, curvando o espaço e o tempo à sua vontade."

msgid "TOME_ARCH_MAGE@TOME@LORE_AUTHOR"
msgstr "Alto Conselheiro Gabriel, Guardião de Evermore"

msgid "TOME_ARCH_MAGE@TOME@LORE_DESCRIPTION"
msgstr "\"Quando sua capacidade de comandar o arcano atinge seu auge, você descobrirá que sua conexão com o Mar Astral começa a vazar para este reino e afeta sua própria realidade. A distância, por exemplo, é um problema para seres inferiores. Para você, o canto mais distante do mundo está a apenas um pensamento de distância.\""

msgid "TOME_ARCH_MAGE@TOME@NAME"
msgstr "Tomo do Arcanista"

msgid "TOME_ARTIFICER@PASSIVE@DESCRIPTION"
msgstr "<<m:{GLOBAL.SiegeProjectConcept}>> são {amount}% mais baratos."

msgid "TOME_ARTIFICER@TOME@LORE_AUTHOR"
msgstr "Edward Portsmith, Último Dreadnought da Comunidade"

msgid "TOME_ARTIFICER@TOME@LORE_DESCRIPTION"
msgstr "\"A artefice, eu gosto de pensar, é a expressão máxima do gênio tornado físico. Traduzir algo tão intangível quanto uma ideia em um autômato funcional e ambulante é verdadeiramente magnífico. Quando se pode transformar tais criações em behemoths, unindo máquina com magia que pode arrasar ou erguer uma cidade... eles podem verdadeiramente reclamar o título de artefice!\""

msgid "TOME_ARTIFICER@TOME@NAME"
msgstr "Tomo da Artefice"

msgid "TOME_ARTIFICING@ABILITY1@DESCRIPTION"
msgstr "Esta unidade termina seu turno e entra em um modo defensivo:[bulletlist][bullet/]Estende sua {GLOBAL.ZoneOfControlConcept.Hyperlink} para todos os hexágonos adjacentes.[bullet/]Ganha +{PROTECTIVE_WALL_DEFENSE_INCREASE>DEF_MOD>Armor} {GLOBAL.DefenseConcept.Hyperlink}.[bullet/]Ganha +{PROTECTIVE_WALL_DEFENSE_INCREASE>DEF_MOD>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}.[bullet/]Imune a {GLOBAL.FlankingConcept.Hyperlink}.[bullet/]Todas as unidades amigáveis adjacentes ganham +{SHIELD_DEFENSE_DEFENSE>DEF_MOD>Armor} {GLOBAL.DefenseConcept.Hyperlink}[bullet/]Todas as unidades amigáveis adjacentes ganham +{PROTECTIVE_WALL_STATUS_RESISTANCE>Resistance} {GLOBAL.StatusResistanceConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_ARTIFICING@ABILITY1@HYPERLINK"
msgstr "{GLOBAL.DEFENSES.PROTECTIVE_WALL.Hyperlink}"

msgid "TOME_ARTIFICING@ABILITY1@NAME"
msgstr "Modo Defensivo: Parede Protetora"

msgid "TOME_ARTIFICING@ABILITY1@PROP_NAME"
msgstr "Parede Protetora"

msgid "TOME_ARTIFICING@ABILITY2@DESCRIPTION"
msgstr "Causa dano em um raio de {HAIL_OF_BOLTS_UNIT_TARGETER>AREA>Radius} hexágonos."

msgid "TOME_ARTIFICING@ABILITY2@NAME"
msgstr "Relâmpago Poderoso"

msgid "TOME_ARTIFICING@PASSIVE@NAME"
msgstr "Engenheiros Artífices"

msgid "TOME_ARTIFICING@SKILL1@DESCRIPTION"
msgstr "[bulletlist][bullet/]No início da batalha, ganhe {amount} {GLOBAL.UNITS.BOLT_REPEATER_UNIT.Hyperlink} unidades do lado do atacante até o final da batalha.[bullet/] <<m:{GLOBAL.UNITS.BOLT_REPEATER_UNIT.Hyperlink}>> são unidades imóveis {GLOBAL.PROPERTIES.SIEGECRAFT_UNIT.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> com ataques de área de efeito de longo alcance que são repetitivos, ao contrário de <<m:{GLOBAL.UNITS.CATAPULT_UNIT.Hyperlink}>>.[bullet/]Apenas um tipo de unidade de Artefice pode ser trazido para a {GLOBAL.CombatConcept.Hyperlink}. Se múltiplos <<m:{GLOBAL.SiegeProjectConcept.Hyperlink}>> os trouxerem, apenas o mais forte deles aparecerá.[/bulletlist]"

msgid "TOME_ARTIFICING@SKILL1@NAME"
msgstr "Construir Repetidores de Projéteis"

msgid "TOME_ARTIFICING@SKILL2@DESCRIPTION"
msgstr "Concede às unidades encantadas:[bulletlist][bullet/]+{ARTISAN_BLADES_CRITICAL_CHANCE>ResolvedCritChanceBonus}% de {GLOBAL.CriticalHitChanceConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_ARTIFICING@SKILL2@NAME"
msgstr "Armamentos Artífices"

msgid "TOME_ARTIFICING@SKILL2@PROP_DESCRIPTION"
msgstr "Unidade tem:[bulletlist][bullet/]+{ARTISAN_BLADES_CRITICAL_CHANCE>ResolvedCritChanceBonus}% {GLOBAL.CriticalHitChanceConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_ARTIFICING@SKILL3@DESCRIPTION"
msgstr "Unidade defensiva {GLOBAL.PROPERTIES.SHIELD_UNIT.Hyperlink} que é resistente a <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>> e protege aliados deles."

msgid "TOME_ARTIFICING@SKILL3@NAME"
msgstr "Golem de Ferro"

msgid "TOME_ARTIFICING@SKILL4@DESCRIPTION"
msgstr "Concede às unidades encantadas:[bulletlist][bullet/]+{SIEGE_MAGIC_DAMAGE>ResolvedMultiplier}% de dano[bullet/]{GLOBAL.PROPERTIES.SIEGE_BREAKER.Hyperlink}, causando dano extra de fortificação durante um cerco.[bullet/]{GLOBAL.PROPERTIES.DEMOLISHER.Hyperlink}, tornando-as capazes de destruir obstáculos reforçados.[/bulletlist]"

msgid "TOME_ARTIFICING@SKILL4@NAME"
msgstr "Magia de Cerco"

msgid "TOME_ARTIFICING@SKILL4@PROP_DESCRIPTION"
msgstr "Unidade tem:[bulletlist][bullet/]+{SIEGE_MAGIC_DAMAGE>ResolvedMultiplier}% de dano[bullet/]{GLOBAL.PROPERTIES.SIEGE_BREAKER.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.DEMOLISHER.Hyperlink}.[/bulletlist]"

msgid "TOME_ARTIFICING@SKILL5@DESCRIPTION"
msgstr "Uma {GLOBAL.CityTowerStructureConcept.Hyperlink} que concede à cidade torres {GLOBAL.UNITS.BOLT_REPEATER_UNIT.Hyperlink} durante o combate de cerco."

msgid "TOME_ARTIFICING@SKILL5@NAME"
msgstr "Fortificação Artesanal"

msgid "TOME_ARTIFICING@SKILL5@PROP_DESCRIPTION"
msgstr "Adiciona {amount} <<m:{GLOBAL.UNITS.BOLT_REPEATER_TOWER_UNIT.Hyperlink}>> em {GLOBAL.CombatConcept.Hyperlink} durante um {GLOBAL.SiegeConcept.Hyperlink}."

msgid "TOME_ARTIFICING@SKILL5@PROP_NAME"
msgstr "Torres Repetidoras de Projéteis em Combate"

msgid "TOME_ARTIFICING@TOME@GAMEPLAY"
msgstr "Especialize-se em arte de cerco, armas artesanalmente elaboradas e Golems."

msgid "TOME_ARTIFICING@UNIT1@NAME"
msgstr "Golem de Ferro^n"

msgid "TOME_ARTIFICING@UNIT2@DESCRIPTION"
msgstr "{GLOBAL.PROPERTIES.FIGHTER.Hyperlink} expansível que é imune a Efeitos de Status."

msgid "TOME_ARTIFICING@UNIT2@NAME"
msgstr "Assistente de Golem de Ferro^n"

msgid "TOME_ARTIFICING@UNIT3@NAME"
msgstr "Repetidor de Projéteis^n"

msgid "TOME_ARTIFICING@UNIT4@NAME"
msgstr "Torre Repetidora de Projéteis^n"

msgid "TOME_ASTRAL_CONVERGENCE@HERO_SKILL@DESCRIPTION"
msgstr "Sempre que uma magia amiga é conjurada, ganha:[bulletlist][bullet/]+{ARCANE_SURGE_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>[bullet/]{stack1} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}[bullet/]{stack2} {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink}[bullet/]{stack3} {GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink}[/bulletlist]"

msgid "TOME_ASTRAL_CONVERGENCE@HERO_SKILL@NAME"
msgstr "Onda Arcana"

msgid "TOME_ASTRAL_CONVERGENCE@PASSIVE@DESCRIPTION"
msgstr "[bulletlist][bullet/]{amount} <<m:{GLOBAL.CombatCastingPointConcept.Hyperlink}>>[bullet/]{amount} <<m:{GLOBAL.WorldMapCastingPointConcept}>>[/bulletlist]"

msgid "TOME_ASTRAL_CONVERGENCE@PASSIVE@NAME"
msgstr "Teçaria de Magia Eficiente"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL1@ATTUNEMNT_DESCRIPTION"
msgstr "Quando uma magia amiga é conjurada, esta unidade ganha um {GLOBAL.PositiveStatusEffectConcept.Hyperlink} aleatório."

msgid "TOME_ASTRAL_CONVERGENCE@SKILL1@ATTUNEMNT_NAME"
msgstr "Sintonia: Presságio Astral"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL1@DESCRIPTION"
msgstr "Vincula a raça alvo ao Mar Astral, concedendo-lhes:[bulletlist][bullet/]O tipo de unidade {GLOBAL.PROPERTIES.ETHEREAL.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.ATTUNEMENT_ASTRAL_OMEN.Hyperlink}, concedendo um {GLOBAL.PositiveStatusEffectConcept.Hyperlink} aleatório quando uma magia é conjurada em combate.[/bulletlist]"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL1@NAME"
msgstr "Sintonia Astral"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL1@PROPERTY_DESCRIPTION"
msgstr "Unidade tem:[bulletlist][bullet/]O tipo de unidade {GLOBAL.PROPERTIES.ETHEREAL.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.ATTUNEMENT_ASTRAL_OMEN.Hyperlink}[/bulletlist]"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL2@DESCRIPTION"
msgstr "Hex não ocupado alvo:[bulletlist][bullet/]Conjure uma unidade {GLOBAL.UNITS.ASTRAL_SERPENT_UNIT.Hyperlink} ou {GLOBAL.UNITS.ASTRAL_SIPHONER_UNIT.Hyperlink} aleatoriamente que dura por {SUMMON_POSITION_EFFECT>TurnsToLive} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Todas as unidades adjacentes sofrem {EXPLOSIVE_MANIFESTATION_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}, {EXPLOSIVE_MANIFESTATION_DAMAGE>DAMAGE>Shock} {GLOBAL.LightningDamageConcept.Hyperlink} e {EXPLOSIVE_MANIFESTATION_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL2@NAME"
msgstr "Manifestação Explosiva"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL3@DESCRIPTION"
msgstr "[bulletlist][bullet/]No início do combate, ganhe {castingpoints}.[bullet/]Durante o combate, todos os <<m:{GLOBAL.UnitConcept.Hyperlink}>> inimigos sofrem {resistancepenalty}.[/bulletlist]"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL3@NAME"
msgstr "Acumulação Arcana"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL3@PROPERTY@DESCRIPTION"
msgstr "A cada turno no combate até {amount} inimigos aleatórios:[bulletlist][bullet/]Ficam {GLOBAL.PROPERTIES.ELECTRIFIED.Hyperlink}.[bullet/]Sofrem {damage} {GLOBAL.FireDamageConcept.Hyperlink}, {damage} {GLOBAL.LightningDamageConcept.Hyperlink} ou {damage} {GLOBAL.FrostDamageConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL4@DESCRIPTION"
msgstr "Alvo {GLOBAL.ProvinceConcept.Hyperlink}:[bulletlist][bullet/]Se contiver um {GLOBAL.ProvinceImprovementConcept.Hyperlink} inimigo e nenhuma {GLOBAL.AncientWonderConcept.Hyperlink}, torna-se ruínas.[bullet/]Gera um poderoso exército saqueador {GLOBAL.ArmyConcept.Hyperlink} de unidades do Mar Astral.[/bulletlist]"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL4@NAME"
msgstr "Fragmentação Astral"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL5@DESCRIPTION"
msgstr "Sempre que você conjurar uma magia no Combate Tático, adicione um {GLOBAL.PROPERTIES.CASCADING_POWER_AUTO_SPELL.Hyperlink} àquele combate."

msgid "TOME_ASTRAL_CONVERGENCE@SKILL5@NAME"
msgstr "Poder em Cascata"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL5@PROP_DESCRIPTION"
msgstr "[bulletlist][bullet/]Uma unidade inimiga aleatória sofre {amount} {GLOBAL.LightningDamageConcept.Hyperlink} no início do turno do dono.[bullet/]Para cada pilha, outra unidade inimiga aleatória sofre dano.[/bulletlist]"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL5@PROP_NAME"
msgstr "Pilha de Poder em Cascata"

msgid "TOME_ASTRAL_CONVERGENCE@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Fique mais forte quanto mais magias você conjurar e invocar criaturas do Mar Astral."

msgid "TOME_ASTRAL_CONVERGENCE@TOME@LORE_AUTHOR"
msgstr "Merlin, o Viajante"

msgid "TOME_ASTRAL_CONVERGENCE@TOME@LORE_DESCRIPTION"
msgstr "\"Quando você altera as correntes do Mar Astral, as correntes também o alteram. Verdadeiros mestres do arcano se tornarão condutores da energia mágica que comandam, deixando-a fluir através de seu próprio ser. Essa energia pode ser usada para infundir seus súditos, aprimorando-os de várias maneiras.\""

msgid "TOME_ASTRAL_CONVERGENCE@TOME@NAME"
msgstr "Tomo da Convergência Astral"

msgid "TOME_ASTRAL_MIRROR@AUTO_REVERT@DESCRIPTION"
msgstr "Esta unidade é um Mímico.[br/]Quando os <<m:{GLOBAL.HitPointConcept.Hyperlink}>> desta unidade caem para 0, ela volta à sua forma original e revive com {REVERT_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[br/]Isso só pode acontecer uma vez por batalha."

msgid "TOME_ASTRAL_MIRROR@AUTO_REVERT@NAME"
msgstr "Mimetizando"

msgid "TOME_ASTRAL_MIRROR@HERO_SKILL@DESCRIPTION"
msgstr "Reflete {MAGIC_DEFLECTION_DAMAGE_REFLECTION>ResolvedDamageReflected}% do dano sofrido de volta aos atacantes."

msgid "TOME_ASTRAL_MIRROR@HERO_SKILL@NAME"
msgstr "Deflexão de Dano"

msgid "TOME_ASTRAL_MIRROR@MIMIC@ABILITY_DESCRIPTION"
msgstr "Transforme-se na unidade inimiga alvo não-{GLOBAL.HeroConcept.Hyperlink}:[bulletlist][bullet/]Efeitos de status são copiados.[bullet/]Encantamentos são copiados.[bullet/]Pontos de Vida são copiados se forem maiores que os da unidade.[bullet/]Fica mais forte ao se transformar em unidades de nível inferior.[bullet/]Fica mais fraco ao se transformar em unidades de nível superior.[/bulletlist]"

msgid "TOME_ASTRAL_MIRROR@MIMIC@ABILITY_NAME"
msgstr "Mímico"

msgid "TOME_ASTRAL_MIRROR@PASSIVE@DESCRIPTION"
msgstr "Todas as suas <<m:{GLOBAL.CityConcept}>> ganham metade do bônus de {GLOBAL.GovernorConcept.Hyperlink} do seu {GLOBAL.LeaderConcept}."

msgid "TOME_ASTRAL_MIRROR@PASSIVE@NAME"
msgstr "Atenção Dividida"

msgid "TOME_ASTRAL_MIRROR@REFLECTION_PROPERTY@DESCRIPTION"
msgstr "Uma cópia de outra unidade:[bulletlist][bullet/]Se a unidade original morrer, esta unidade a substitui.[bullet/]Não pode invocar outras unidades.[/bulletlist]"

msgid "TOME_ASTRAL_MIRROR@REFLECTION_PROPERTY@NAME"
msgstr "Reflexo Astral"

msgid "TOME_ASTRAL_MIRROR@SKILL1@DESCRIPTION"
msgstr "Unidades e Cidades que você controla ganham +{amount} de Alcance de Visão."

msgid "TOME_ASTRAL_MIRROR@SKILL1@NAME"
msgstr "Revelação Astral"

msgid "TOME_ASTRAL_MIRROR@SKILL2@DESCRIPTION"
msgstr "Invoca um {GLOBAL.UNITS.MIRROR_MIMIC_UNIT.Hyperlink}, uma {GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink} que pode assumir a forma de outras unidades, ganhando suas habilidades e se curando."

msgid "TOME_ASTRAL_MIRROR@SKILL2@NAME"
msgstr "Invocar Mímico Espelhado"

msgid "TOME_ASTRAL_MIRROR@SKILL3@DESCRIPTION"
msgstr "Invoca uma {GLOBAL.PROPERTIES.REFLECTION.Hyperlink} da unidade amigável alvo em um hexágono adjacente não ocupado.[br/][br/]Não pode ter como alvo <<m:{GLOBAL.PROPERTIES.HERO.Hyperlink}>>, <<m:{GLOBAL.PROPERTIES.COMBAT_SUMMON.Hyperlink}>> e <<m:{GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink}>>."

msgid "TOME_ASTRAL_MIRROR@SKILL3@NAME"
msgstr "Invocar Reflexo Astral"

msgid "TOME_ASTRAL_MIRROR@SKILL4@DESCRIPTION"
msgstr "Torna as unidades encantadas:[bulletlist][bullet/]Refletem {MIRROR_VEIL_DAMAGE_REFLECTION>ResolvedDamageReflected}% de dano não-{GLOBAL.PhysicalDamageConcept.Hyperlink} de volta aos atacantes.[/bulletlist]"

msgid "TOME_ASTRAL_MIRROR@SKILL4@NAME"
msgstr "Véu Espelhado"

msgid "TOME_ASTRAL_MIRROR@SKILL4@PROPERTY_DESCRIPTION"
msgstr "Esta unidade:[bulletlist][bullet/]Reflete {MIRROR_VEIL_DAMAGE_REFLECTION>ResolvedDamageReflected}% de dano não-{GLOBAL.PhysicalDamageConcept.Hyperlink} de volta aos atacantes.[/bulletlist]"

msgid "TOME_ASTRAL_MIRROR@SKILL5@DESCRIPTION"
msgstr "[bulletlist][bullet/]Quando uma luta ocorre no domínio da cidade, o jogador ganha um {GLOBAL.PROPERTIES.REFLECTION.Hyperlink} de seu {GLOBAL.LeaderConcept.Hyperlink} se eles não estiverem presentes.[bullet/]Seu Governante ganha {xp} {GLOBAL.ExperienceConcept.Hyperlink} por {GLOBAL.TurnConcept.Hyperlink} por Cidade possuída com esta estrutura de cidade construída.[/bulletlist]"

