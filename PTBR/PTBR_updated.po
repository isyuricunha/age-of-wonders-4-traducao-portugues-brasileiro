msgid "STATUSEFFECTS_UNITPROPERTIES@FEARLESS@NAME"
msgstr "Resistente"

msgid "STATUSEFFECTS_UNITPROPERTIES@FEY_BEGUILE@DESCRIPTION"
msgstr "No final de seu turno, se esta unidade estiver {GLOBAL.PROPERTIES.OBSCURED.Hyperlink} ou em uma nuvem de {GLOBAL.MistConcept.Hyperlink}, ela ganha um {GLOBAL.PositiveStatusEffectConcept.Hyperlink} aleatório."

