msgid "DLC@GIANTKINGS@META_EMPIRE@REALM_MYRRIDA@SUBTITLE"
msgstr "Um reino outrora governado pelo <<m:{GLOBAL.GiantKingLoreConcept.Hyperlink}>> de {GLOBAL.MyrridaLoreConcept.Hyperlink}, seus antigos salões subterrâneos aguardam para serem redescobertos."

msgid "DLC@GIANTKINGS@META_EMPIRE@REALM_MYRRIDA@TEMPLATE_NAME"
msgstr "Vestígios de Myrrida"

msgid "DLC@GIANTKINGS@MINORFACTIONS_WORLD@ETERNALS_RACE@BIO_1"
msgstr "Nas eras de {GLOBAL.MyrridaLoreConcept.Hyperlink}, os <<m:{GLOBAL.GiantKingLoreConcept.Hyperlink}>> governavam os reinos que remodelaram em todos os cantos do {GLOBAL.AstralSeaLoreConcept.Hyperlink}. Mas sua remodelação não terminou com o terreno, pois também modificaram os habitantes dos reinos que os Gigantes governavam, infundindo-os com cristais especiais que tornaram seus corpos mortais eternos. Os Gigantes Ancestrais usariam esses mesmos cristais para armazenar memórias e emoções. Desde a queda de Myrrida, os {GLOBAL.EternalSagesLoreConcept.Hyperlink} que restam são governados por Conselhos Eternos."

msgid "DLC@GIANTKINGS@MINORFACTIONS_WORLD@ETERNALS_RACE@NAME_1"
msgstr "Sentinelas de Siäldryh"

msgid "DLC@GIANTKINGS@MINOR_FACTION@UPGRADE_SET@CRYSTAL@DESCRIPTION"
msgstr "Estes são os servos dos {GLOBAL.EternalSagesLoreConcept.Hyperlink}. Seus corpos foram aumentados com cristais mágicos que fortificam o corpo e imbuem a mente com memórias de Gigantes há muito desaparecidos."

msgid "DLC@GIANTKINGS@OBELISK@BONE@NAME"
msgstr "Obelisco de Osso^n"

msgid "DLC@GIANTKINGS@OBELISK@STORM@NAME"
msgstr "Obelisco^n"

msgid "DLC@GIANTKINGS@PANTHEON_TREE@GAINT_ARCHON_BODY@NAME"
