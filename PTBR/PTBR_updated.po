msgid "DLC@THRONESOFBLOOD@TOME_BLOOD_RITE@SKILL6@DESCRIPTION"
msgstr "Esculpa sigilos profanos na carne da sua raça, concedendo-lhes:[bulletlist][bullet/]+{FLESH_CARVED_RUNES_STAT_BONUS>BONUS>Regen} de regeneração de {GLOBAL.HitPointConcept.Hyperlink} no {GLOBAL.WorldMapConcept.Hyperlink}.[bullet/]Ataques e habilidades de {GLOBAL.DebuffConcept.Hyperlink}:[bulletlist][bullet/]Ignoram {FLESH_CARVED_RUNES_RESISTANCE_CHECK_BOOST>ResistanceBypass} de {GLOBAL.StatusResistanceConcept.Hyperlink} por pilha de {GLOBAL.PROPERTIES.BLEEDING.Hyperlink} no alvo.[/bulletlist][/bulletlist]"

