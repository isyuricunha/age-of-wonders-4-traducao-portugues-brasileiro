msgid "DLC@ARCHONPROPHECY@MEGAWONDERS_STRATEGIC@FOUNTAIN_OF_CREATION@DESCRIPTION"
msgstr "<<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacentes a este Marco ganham:[bulletlist][bullet/]{income}.[bullet/]Uma [farm/] Fazenda nesta província concede {income2}.[bullet/]O {combatproperty} {GLOBAL.CombatEnchantmentConcept.Hyperlink}.[/bulletlist][br/]Uma {GLOBAL.CityConcept.Hyperlink} com {amount} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacentes a este Marco ganha:[bulletlist][bullet/][farm/] Fazendas no domínio concedem {income3} e {income4}.[bullet/]O {combatproperty} {GLOBAL.CombatEnchantmentConcept.Hyperlink} no domínio.[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@MEGAWONDERS_STRATEGIC@FOUNTAIN_OF_CREATION@LORE"
msgstr "\"Assim como os gêiseres de água lustral, devemos santificar a terra e cultivá-la com cuidado providencial. Por essa verdade, erguemos fontes sobre essas torrentes e, assim, ao compreender o labor de Sua obra, nos aproximamos do Pai de Tudo. Pois o que são esses riachos, senão a encarnação do Poço da Criação feita manifesta?\"[br/][br/]— Anon, Rei-Feiticeiro Arcônico da Vida, Sobre os Caminhos da Ascensão Divina"

msgid "DLC@ARCHONPROPHECY@MEGAWONDERS_STRATEGIC@FOUNTAIN_OF_CREATION@NAME"
msgstr "Fonte da Criação"

