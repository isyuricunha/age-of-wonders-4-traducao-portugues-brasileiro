msgid "DLC@GIANTKINGS@DIPLOMACY@CRYSTAL_DWELLING@CRYSTAL_PACT@DESCRIPTION"
msgstr "[bulletlist][bullet/]Irá [hyperlink,GLOBAL.ReinforcementRuleConcept]reforçar[/hyperlink] em {GLOBAL.CombatConcept.Hyperlink} contra <<m:{GLOBAL.MarauderConcept.Hyperlink}>> e <<m:{GLOBAL.LeaderConcept.Hyperlink}>> com quem a {GLOBAL.DwellingConcept.Hyperlink} estiver em {GLOBAL.IndependentCityWarConcept.Hyperlink}.[bullet/]Desbloqueia a compra dos seguintes itens de comércio via Cooperação:[bulletlist][bullet/]{GLOBAL.TOKENDEFINITION.LITHORITE_PRISM_ARTIFACT.Hyperlink}[bullet/]{GLOBAL.SPECIAL_OPERATIONS.CRYSTAL_FOCUS.Hyperlink}[bullet/]{GLOBAL.SPECIAL_OPERATIONS.CRYSTALLIZE_ESSENCE.Hyperlink}[bullet/]{GLOBAL.SPECIAL_OPERATIONS.CRYSTAL_CRASH.Hyperlink}[bullet/]{GLOBAL.UNITS.LITHORINE_SHARDLANCER.Hyperlink}[bullet/]{GLOBAL.UNITS.LITHORINE_GEMCASTER.Hyperlink}[/bulletlist][bullet/]Completar missões da Morada recompensa {GLOBAL.ManaConcept.Hyperlink} garantido além das outras recompensas.[/bulletlist]"

msgid "DLC@GIANTKINGS@DIPLOMACY@CRYSTAL_DWELLING@CRYSTAL_PACT@HYPERLINK"
msgstr "[rs_crystal/] [hyperlink,GLOBAL.CrystalDwellingCrystalPactConcept]Pacto de Cristal[/hyperlink]"

