msgid "DLC@THRONESOFBLOOD@TOME_BLOOD_RITE@SKILL2@NAME"
msgstr "Lâminas que Bebem Sangue"

msgid "DLC@THRONESOFBLOOD@TOME_BLOOD_RITE@SKILL2@PROP_DESCRIPTION"
msgstr "Ataques base {GLOBAL.MeleeConcept.Hyperlink}:[bulletlist][bullet/]Causam +{BLOOD_DRINKING_BLADES_REPEATING>DAMAGE>Physical} de {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Ao atingir unidades com {GLOBAL.PROPERTIES.BLEEDING.Hyperlink}, curam {BLOOD_DRINKING_BLADES_LIFE_STEAL>MinHeal} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@THRONESOFBLOOD@TOME_BLOOD_RITE@SKILL3@DESCRIPTION"
msgstr "Um {GLOBAL.PROPERTIES.BATTLE_MAGE.Hyperlink} que inflige um Parasita de Sangue em seus inimigos e pode se fortalecer à custa de suas próprias vidas."

msgid "DLC@THRONESOFBLOOD@TOME_BLOOD_RITE@SKILL3@NAME"
msgstr "Cultista de Sangue"

msgid "DLC@THRONESOFBLOOD@TOME_BLOOD_RITE@SKILL4@DESCRIPTION"
msgstr "Ataques {GLOBAL.MagicConcept.Hyperlink} de unidades encantadas ganham:[bulletlist][bullet/]+{SANGUINE_FOCUS_DAMAGE_REPEATING>DAMAGE>Physical} de {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Uma chance base de {BLEEDING_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.BLEEDING.Hyperlink} por {BLEEDING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@THRONESOFBLOOD@TOME_BLOOD_RITE@SKILL4@NAME"
msgstr "Foco Sanguíneo"

