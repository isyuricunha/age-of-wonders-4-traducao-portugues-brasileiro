msgid "TOME_GREAT_TRANSFORMATION@SKILL6@NAME"
msgstr "Reanimação de Dragão Ósseo"

msgid "TOME_GREAT_TRANSFORMATION@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Transforme seu povo em {GLOBAL.PROPERTIES.UNDEAD.Hyperlink} e transforme seu império em um paraíso para eles prosperarem."

msgid "TOME_GREAT_TRANSFORMATION@TOME@LORE_AUTHOR"
msgstr "Nekron, Mestre da Morte"

msgid "TOME_GREAT_TRANSFORMATION@TOME@LORE_DESCRIPTION"
msgstr "\"Uma vez que você sentiu o poder da necromancia, começa a compreender uma verdade maior. Um império não requer realmente vida para verdadeiramente viver. A vida é desordenada. É imprevisível e ineficiente. Conceda ao seu povo o dom da não-morte eterna e eles lhe recompensarão com obediência eterna e ordenada.\""

msgid "TOME_GREAT_TRANSFORMATION@TOME@NAME"
msgstr "Tomo da Grande Transformação"

msgid "TOME_GREAT_TRANSFORMATION@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Cadáver não-Zumbi alvo é ressuscitado como um {GLOBAL.UNITS.DECAYING_ZOMBIE.Hyperlink} do seu lado."

msgid "TOME_GREAT_TRANSFORMATION@UNIT1@ABILITY1@NAME"
msgstr "Invocar Zumbi em Decomposição"

msgid "TOME_GREAT_TRANSFORMATION@UNIT1@DESCRIPTION"
msgstr "Uma estrutura defensiva que cura e fortalece unidades Mortas-Vivas amigáveis próximas."

msgid "TOME_GREAT_TRANSFORMATION@UNIT1@NAME"
msgstr "Espira Necrótica^n"

msgid "TOME_HELL_GATE@UNIT_ABILITY_2@NAME"
msgstr "Marca do Caos"

msgid "TOME_HELL_GATE@UNIT_ABILITY_2@PROP_DESCRIPTION"
msgstr "Quando esta unidade morre, ela se transforma em um {GLOBAL.UNITS.INFERNO_PUPPY.Hyperlink} sob controle inimigo.[br/][br/]Se o Cachorro do Inferno sobreviver ao combate, ele então Evolui e o inimigo pode pagar {GLOBAL.ManaConcept.Hyperlink} para mantê-lo."

msgid "TOME_HELL_GATE@UNIT_ABILITY_2@PROP_NAME"
msgstr "Marca do Inferno"

