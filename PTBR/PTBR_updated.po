msgid "WILDLIFE_UNITPROPERTIES@FIERY_REBIRTH@NAME"
msgstr "Renascimento Flamejante"

msgid "WILDLIFE_UNITPROPERTIES@FIRE_BREATH@NAME"
msgstr "Bafo de Fogo"

msgid "WILDLIFE_UNITPROPERTIES@FIRE_GIANT_RESISTANCE@NAME"
msgstr "Fraqueza do Gigante de Fogo"

msgid "WILDLIFE_UNITPROPERTIES@FORBIDDEN_TOME@DESCRIPTION"
