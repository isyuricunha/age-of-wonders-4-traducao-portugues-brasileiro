msgstr "The {EnemyUnit} applauds your creative solution and allows you to pass."

msgid "DLC@SECRETSOFTHEARCHMAGES@TRIGGER@TOOLTIP@SHROUDED_GATE_POPULATION@AFFINITY_CHOICE_CHAOS@FAILURE"
msgstr "The {EnemyUnit} interprets your attempt as a threat and retaliates."

msgid "DLC@SECRETSOFTHEARCHMAGES@TRIGGER@TOOLTIP@SHROUDED_GATE_POPULATION@AFFINITY_CHOICE_CHAOS@HEADER"
msgstr "Parade the unfettered energy of the {EventRace}:"

msgid "DLC@SECRETSOFTHEARCHMAGES@TRIGGER@TOOLTIP@SHROUDED_GATE_POPULATION@AFFINITY_CHOICE_CHAOS@SUCCESS"
msgstr "The display intimidates the ancient Defender, thus yielding you access."

msgid "DLC@SECRETSOFTHEARCHMAGES@TRIGGER@TOOLTIP@SHROUDED_GATE_POPULATION@AFFINITY_CHOICE_NATURE@FAILURE"
msgstr "The {EnemyUnit} demands a sacrifice. <<Cp:EnemyUnit>> attacks your troops."

