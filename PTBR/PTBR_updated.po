msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@HARMONY@PARAGON_TOOLTIP_DESCRIPTION"
msgstr "[bullet/]{GLOBAL.PROPERTIES.HARMONIZE.Hyperlink}: Cure {amount} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>[bullet/]Unidades {GLOBAL.UNITS.PEACEBRINGER.Hyperlink} têm sua {GLOBAL.PROPERTIES.SWORN_PARAGON_WISDOM.Hyperlink} ativada."

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@RIGHTEOUSNESS@ADHERENT_TOOLTIP_DESCRIPTION"
msgstr "[bullet/]{GLOBAL.PROPERTIES.NOBILITY.Hyperlink}: +{amount} {GLOBAL.SpiritDamageConcept.Hyperlink}"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@RIGHTEOUSNESS@DESCRIPTION"
msgstr "Seu povo segue um caminho de Retidão, trabalhando para ser uma força positiva para o bem no mundo:[bulletlist][bullet/]O alinhamento negativo [reputation2/] obtido é dobrado.[bullet/]Unidades de cultura têm {GLOBAL.PROPERTIES.NOBILITY.Hyperlink}.[bullet/]Ficam mais fortes à medida que ganham {GLOBAL.DevotionConcept.Hyperlink} para o {GLOBAL.OathOfRighteousness.Hyperlink}.[/bulletlist]"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@RIGHTEOUSNESS@DEVOTEE_TOOLTIP_DESCRIPTION"
msgstr "[bullet/]{GLOBAL.PROPERTIES.NOBILITY.Hyperlink}: +{amount} {GLOBAL.SpiritDamageConcept.Hyperlink}"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@RIGHTEOUSNESS@DEVOTION_DESCRIPTION"
msgstr "[bulletlist][bullet/]Ganhe {GLOBAL.DevotionConcept.Hyperlink} por:[bulletlist][bullet/]Ter alinhamento bom, +{GLOBAL.goodDevotion} [devotedact/] por ponto [reputation6/].[/bulletlist][bullet/]Perca {GLOBAL.DevotionConcept.Hyperlink} por:[bulletlist][bullet/]Ter alinhamento mau, -{GLOBAL.devotionevil} [undevotedact/] por ponto [reputation2/].[/bulletlist][/bulletlist]"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@RIGHTEOUSNESS@DEVOTION_TOOLTIP_DESCRIPTION"
msgstr "{LOC.DLC@WAYSOFWAR@DIPLOMACY@CONCEPT_OATH_RIGHTEOUESNESS@NAME}{LOC.DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@RIGHTEOUSNESS@DEVOTION_DESCRIPTION}"

