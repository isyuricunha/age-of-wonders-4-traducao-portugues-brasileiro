msgid "TOME_PANDEMONIUM@UNIT1@ABILITY1@NAME"
msgstr "Consumir Caos"

msgid "TOME_PANDEMONIUM@UNIT1@ABILITY2@DESCRIPTION"
msgstr "Causa {CHAOS_BOLTS_EXTRA_DAMAGE>DAMAGE>Shock} {GLOBAL.LightningDamageConcept.Hyperlink}, {CHAOS_BOLTS_EXTRA_DAMAGE>DAMAGE>Blight} {GLOBAL.BlightDamageConcept.Hyperlink}, {CHAOS_BOLTS_EXTRA_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink}, ou {CHAOS_BOLTS_EXTRA_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink} aleatoriamente."

msgid "TOME_PANDEMONIUM@UNIT1@ABILITY2@NAME"
msgstr "Projéteis do Caos"

msgid "TOME_PANDEMONIUM@UNIT1@ABILITY3@DESCRIPTION"
msgstr "Causa {CONSUME_CHAOS_EXTRA_DAMAGE>DAMAGE>Shock} {GLOBAL.LightningDamageConcept.Hyperlink}, {CONSUME_CHAOS_EXTRA_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}, ou {CONSUME_CHAOS_EXTRA_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink} de dano aleatoriamente."

msgid "TOME_PANDEMONIUM@UNIT1@DESCRIPTION"
