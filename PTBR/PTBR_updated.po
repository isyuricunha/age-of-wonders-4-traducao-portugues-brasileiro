msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@TRAIT_HILLS_NO_MOUNTAINS@DESCRIPTION"
msgstr "The peoples of this realm live in burrows dug beneath the hilly landscape.[bulletlist][bullet/]Mountain <<m:{GLOBAL.ProvinceFeatureConcept.Hyperlink}>> are [abilityblue]Rare[/abilityblue].[bullet/]Hills are [abilityblue]Common[/abilityblue].[bullet/]<<m:{GLOBAL.IndependentCityConcept.Hyperlink} >> only exist in the {GLOBAL.UndergroundConcept.Hyperlink}.[bullet/]All <<m:{GLOBAL.IndependentCityConcept.Hyperlink} >> and marauder races have animalistic forms.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@TRAIT_HILLS_NO_MOUNTAINS@NAME"
msgstr "Burrowed Realm"

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@TRAIT_LAVA_ISLANDS@DESCRIPTION"
