msgstr "Campeão Exaltado"

msgid "TOME_GOD_EMPEROR@SKILL2@DESCRIPTION"
msgstr "Unidades no exército amigável alvo ganham {GLOBAL.PROPERTIES.RESURGENCE.Hyperlink} por {duration} [turn/]."

msgid "TOME_GOD_EMPEROR@SKILL2@NAME"
msgstr "Proteção Divina"

msgid "TOME_GOD_EMPEROR@SKILL3@DESCRIPTION"
msgstr "Exército inimigo alvo:[bulletlist][bullet/]Sofre {damage} {GLOBAL.SpiritDamageConcept.Hyperlink}.[bullet/]Fica {GLOBAL.PROPERTIES.DEMORALIZED} por {turn} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Fica {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink} por {turn} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Se conjurado em território inimigo, o exército sofre adicionalmente {damageExtra} de dano.[/bulletlist]"

msgid "TOME_GOD_EMPEROR@SKILL3@NAME"
msgstr "Fúria do Imperador"

msgid "TOME_GOD_EMPEROR@SKILL4@NAME"
msgstr "Era da Ordem"

msgid "TOME_GOD_EMPEROR@SKILL5@DESCRIPTION"
msgstr "Alvos todas as unidades amigáveis mortas com {GLOBAL.PROPERTIES.FAITHFUL.Hyperlink} ou {GLOBAL.PROPERTIES.ZEAL.Hyperlink}. Elas voltam à vida com {MASS_REVIVE_RESURRECT>ResolvedHitPoints}% de seus pontos de vida totais <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[br/][br/]{LOC.TACTICAL@ABILITY@NEVER_IN_WATER}"

msgid "TOME_GOD_EMPEROR@SKILL5@NAME"
msgstr "Ressurreição em Massa"

msgid "TOME_GOD_EMPEROR@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Torne-se um deus a ser adorado. Sua mera presença inspira suas tropas e suas cidades. Especialize-se em fortalecer suas unidades."

msgid "TOME_GOD_EMPEROR@TOME@LORE_AUTHOR"
msgstr "Turiel, Guardião Exaltado de Grexolis"

msgid "TOME_GOD_EMPEROR@TOME@LORE_DESCRIPTION"
msgstr "\"A divindade é conhecida. É sentida. Não é necessário convencer os outros da própria divindade, pois a própria essência brilhará. Abrace a divindade. Inspire todos com sua presença e conceda poder sagrado a todos que o seguem em seu caminho justo. Abençoado seja você, pastor, e abençoado seja seu rebanho.\""

msgid "TOME_GOD_EMPEROR@TOME@NAME"
msgstr "Tomo do Imperador Divino"

msgid "TOME_GOLDEN@ABILITY0@DESCRIPTION"
msgstr "[bulletlist][bullet/]Causa dano a unidades inimigas em um cone de {unitsAmount} hexágonos.[bullet/]Ao acertar um alvo {GLOBAL.PROPERTIES.GILDED.Hyperlink}:[bulletlist][bullet/]Cura {GILDED_CLEAVE_HEAL>MinHeal} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Causa +{GILDED_CLEAVE_DAMAGE>ResolvedMultiplier}% de dano.[/bulletlist][/bulletlist]"

