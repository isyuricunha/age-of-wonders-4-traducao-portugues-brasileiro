msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_579@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} cumprimenta você com a saudação cerimonial de <<o:EventHouseLord>> {EventHouseRace}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_579@BODY_LORE"
msgstr "\"Celebramos sua chegada, {PlayerLeader.FirstName}-kan. {EventPhrase} Vamos renovar nossos Juramentos na presença um do outro. Que isso ofereça uma base sólida para ambas as nossas Casas. Que negócios você tem com {EventHouse}? Como nossas aspirações podem beneficiar as suas, e as suas as minhas?\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_579@BUTTON_0"
msgstr "Inspecione {EventHouse}, bastião de seus irmãos de armas."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_579@BUTTON_1"
msgstr "\"Eu retornarei a você em outro dia, {EventHouseLord.FirstName}-hem.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_579@EVENTPHRASE_HARMONY"
msgstr "Sua postura equilibrada me informa que você, como nós, é guiado por {EventOath}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_579@EVENTPHRASE_RIGHTEOUSNESS"
msgstr "Sua postura sincera me informa que você, como nós, é guiado por {EventOath}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_579@EVENTPHRASE_STRIFE"
msgstr "Sua postura firme me informa que você, como nós, é guiado por {EventOath}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_579@TITLE"
msgstr "Encontrando Fraternal {EventHouse.Name}"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_588@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} saúda você com respeito, como é o costume dos {EventHouseRace}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_588@BODY_LORE"
msgstr "Cabe a você saudar {EventHouseLord.FirstName} no estilo do seu {PlayerRace}. O gesto apazigua o {EventHouseLord.Title}. \"Embora você e eu sigamos caminhos diferentes, você o Caminho de {PlayerOath}, eu o Caminho de {EventOath}, a paz entre nossos povos pavimenta a estrada para a prosperidade e o triunfo, {PlayerLeader.FirstName}-kan.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_588@BUTTON_0"
msgstr "Inspecione os Discípulos de {EventOath} em {EventHouse}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_588@BUTTON_1"
msgstr "\"Que {EventOath} guie suas mãos, {EventHouseLord.FirstName}-hem.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_588@TITLE"
msgstr "Encontrando Heróica {EventHouse.Name}"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_589@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} cumprimenta você formalmente. A guarda de honra dos {EventHouseRace} flanqueia <<P:EventHouseLord>>."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_589@BODY_LORE"
msgstr "\"Sua reputação precede você, {PlayerLeader.FirstName}-kan.\" O <<G:face^n,{EventHouseLord.Title}>> é estrito, mas há respeito sincero nos olhos de <<o:EventHouseLord>>. \"Não temos desavenças com você. Embora você seja um estranho aos nossos costumes, o juramento que fizemos exige que o recebamos como um amigo.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_589@BUTTON_0"
msgstr "Inspecione {EventHouse} e os honoráveis {EventHouseRace}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_589@BUTTON_1"
msgstr "Prometa retornar em outro momento."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_589@TITLE"
msgstr "Encontrando Honorável {EventHouse.Name}"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_590@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} cumprimenta você com cautela. A mão de <<Co:EventHouseLord>> repousa no punho de sua espada."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_590@BODY_LORE"
msgstr "{EventHouseLord.FirstName} está alto, mas imóvel, como uma estátua, mas observa atentamente cada um de seus movimentos. \"Até decidirmos se você é uma ameaça ao nosso modo de vida, {PlayerLeader.FirstName}-do, acho melhor você manter distância.\" A voz de <<Co:EventHouseLord>> não contém ameaça, mas <<p:EventHouseLord>> fala com intenção severa e inabalável. \"Você escolhe qual destino o aguarda\", conclui o {EventHouseLord.Title}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_590@BUTTON_0"
msgstr "Inspecione {EventHouse} com cautela."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_590@BUTTON_1"
msgstr "\"Nossos destinos certamente se encontrarão. Mas não hoje, {EventHouseLord.Title}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_590@TITLE"
msgstr "Encontrando Rigorosa {EventHouse.Name}"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_591@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} encontra você com <<o:EventHouseLord>> arma erguida."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_591@BODY_LORE"
msgstr "\"Uma maldição sobre este dia, em que você pisou em nossas terras, {PlayerLeader.FirstName}-uch\", o {EventHouseLord.Title} cospe. \"Eu juro aqui que destruirei você e seu {PlayerRace}.\" {EventHouseLord.FirstName} corta a palma de <<o:EventHouseLord>> mão e deixa o sangue pingar no solo. \"Os {EventHouseRace} denunciam tudo pelo que você representa, suposto {PlayerLeader.Title}!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_591@BUTTON_0"
msgstr "Inspecionar a audaciosa {EventHouse}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_591@BUTTON_1"
msgstr "\"Ou você quebra seu juramento, ou eu quebro {EventHouse}!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_591@TITLE"
msgstr "Encontrando a Beligerante {EventHouse.Name}"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_594@BODY_FOOTER"
msgstr "O {EventStackLeader} jura: \"{EventOath} nos enobrecerá, Sentinelas da {EventStructure}!\" Esses sentinelas podem ser convencidos a abandonar seu posto?"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_594@BODY_HEADER"
msgstr "Enquanto seu exército se aproxima de uma {EventStructure.Name}, são abordados por sentinelas de {EventHouse} que estão estacionadas lá. \"Parem!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_594@BODY_LORE"
msgstr "Um {EventStackLeader} novato avança para avaliar sua companhia. \"Você não tem negócios aqui! Este é o domínio dos {EventRace} de {EventHouse}.\" Os outros guardas permanecem imóveis em formação. Seu comandante novato acena aprovadoramente para reconhecer sua disciplina, então continua a gritar: \"Não nos moveremos! Como sentinelas de {EventHouse}, fizemos juramentos de lealdade.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_594@BUTTON_0"
msgstr "Pague honra e respeito [influence/] a {EventHouse} para ter permissão de acesso."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_594@BUTTON_2"
msgstr "\"Você provou sua dedicação. É hora de voltar para casa com honra.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_594@BUTTON_3"
msgstr "\"Bom! Este foi seu teste. Você passou. Agora vá embora.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_594@BUTTON_4"
msgstr "\"Seu juramento será seu fim! Às armas!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_594@BUTTON_5"
msgstr "Deixe os sentinelas dedicados de {EventHouse}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_594@TITLE"
msgstr "Sentinelas Firmes"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_598@BODY_FOOTER"
msgstr "Os vencedores de {EventHouse} não deixarão a {EventStructure} antes que a celebração termine. O que você fará?"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_598@BODY_HEADER"
msgstr "Suas tropas visitam uma {EventStructure}, apenas para encontrar um exército de {EventHouse} reunido em torno do cadáver de um grande {EventUnitB}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_598@BODY_LORE"
msgstr "O líder da companhia, um {EventStackLeader}, cumprimenta você de maneira gentil. \"Ah, você veio na hora certa!\" ele exclama. \"Minhas tropas acabaram de derrotar este {EventUnitB} desagradável em uma batalha épica. De acordo com os princípios dos {EventRace}, devemos agora realizar um banquete comemorativo. Inimigos poderosos merecem muita honra, então estamos prestes a realizar uma grande festa! Você não gostaria de se juntar a nós e prestar respeito ao nosso alvo abatido?\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_598@BUTTON_0"
msgstr "Mova a celebração [food/] para {EventCity}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_598@BUTTON_2"
msgstr "Conjure uma visão do <<G:reanimation^n,EventUnitB>>."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_598@BUTTON_3"
msgstr "\"Vamos mostrar a esses amadores de {EventHouse} como a {PlayerRace} faz festa, tropas!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_598@BUTTON_4"
msgstr "Vença-os enquanto sua guarda está baixa!"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_598@BUTTON_5"
msgstr "Permita que os soldados celebrem em paz."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_598@BUTTON_6"
msgstr "Faça com que os guardas [unitprod/] de {EventCity} se juntem ao banquete para elevar sua honra."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_598@TITLE"
msgstr "Banquete do Triunfo"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_599@BODY_FOOTER"
msgstr "Como você celebrará a apresentação do Campeão deste ano de {EventHouse}, que visita todos os Godir benevolentes do reino?"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_599@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} de {EventHouse} visita você com um formidável {EventUnit}. \"{PlayerLeader.Title}, apresento com orgulho o Campeão deste ano!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_599@BODY_LORE"
msgstr "{EventHouseLord.FirstName} está ansioso para explicar do que se trata. \"Todos os anos, o Conselho de {EventOath} elege o parangão mais devoto da cultura de {EventHouse} entre os soldados mais experientes do nosso exército. Esse lutador é laureado como o Campeão do ano: o guerreiro consumado {EventHouseRace}.\" O {EventHouseLord.Title} sorri. \"Como é nossa tradição, visitamos todos os aliados para compartilhar as celebrações!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_599@BUTTON_0"
msgstr "Peça ao Campeão para treinar os recrutas [unitprod/] de {EventCity}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_599@BUTTON_1"
msgstr "Obtenha um pedaço da <<G:armor^n,EventUnit>> [item/] como um símbolo de respeito."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_599@BUTTON_2"
msgstr "\"Eu simplesmente DEVO [influence/] ter seu Campeão [unit/] em minhas fileiras.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_599@BUTTON_3"
msgstr "\"Deixe sua coragem inspirar [morale/] minhas tropas!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_599@BUTTON_4"
msgstr "\"Compartilhe suas virtudes altruístas [goodact/] conosco!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_599@BUTTON_5"
msgstr "\"Ensine meus {EventRace} a viver harmoniosamente [happiness/], Campeão.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_599@TITLE"
msgstr "O Tour do Campeão"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_600@BODY_FOOTER"
msgstr "O {EventHouseLord.Title} aguarda sua sugestão sobre como lidar com os acusados Quebradores de Juramento."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_600@BODY_HEADER"
msgstr "{EventHouseLord} de {EventHouse} entra em contato com você, <<o:EventHouseLord>> com dúvida e nojo traidores. <<m:EventUnit>> acorrentados estão atrás dele."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_600@BODY_LORE"
msgstr "\"Ó {PlayerLeader.Title}, estamos lutando para declarar o destino desses Quebradores de Juramento,\" {EventHouseLord.FirstName} pronuncia. <<Cp:EventHouseLord>> acena para os <<m:EventUnit>> atrás de <<P:EventHouseLord>>. \"Pegamos esses degenerados em flagrante. {EventPhrase} Agora devemos decidir sua sentença.\" O {EventHouseLord.Title} sorri. \"Eu valorizo sua opinião, {PlayerLeader.FirstName}-kan. Que penitência deve recair sobre os Quebradores de Juramento?\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_600@BUTTON_0"
msgstr "\"Eu lidarei com esses <<m:EventUnit>>.\" [unit/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_600@BUTTON_1"
msgstr "Dê um exemplo com os <<m:EventUnit>>. Colha suas almas. [soul/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_600@BUTTON_2"
msgstr "\"Pelo meu juramento, [undevotedact/] restaure a honra desses Quebradores de Juramento.\" [allegiance/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_600@BUTTON_3"
msgstr "Exija que os <<m:EventUnit>> recebam um julgamento justo."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_600@BUTTON_4"
msgstr "\"Se sua culpa é certa, um duelo judicial selará o destino de <<o:EventUnit>>.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_600@BUTTON_5"
msgstr "Tire suas armas e armaduras. [item/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_600@EVENTPHRASE_HARMONY"
msgstr "Eles reuniram os {EventHouseRace} para pegar em armas contra você!"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_600@EVENTPHRASE_RIGHTEOUSNESS"
msgstr "Eles estavam roubando comida dos doentes e pobres."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_600@EVENTPHRASE_STRIFE"
msgstr "Eles largaram suas armas para se tornarem fazendeiros de porcos."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_600@TITLE"
msgstr "Quebradores de Juramento"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_602@BODY_FOOTER"
msgstr "\"<<Ca:EventStructure>> está causando dissonância,\" eles dizem em uníssono. \"Nivele-o para trazer harmonia ao reino. E ao seu coração.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_602@BODY_HEADER"
msgstr "\"Você reflete sobre suas ações passadas, muitas das quais se opuseram aos valores de {PlayerOath}, quando, de repente, dois <<m:EventUnit>> aparecem."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_602@BODY_LORE"
msgstr "Um {EventUnit}, mais escuro em cor, observa você com severidade. <<Cp:EventUnit>> então abre <<o:EventUnit>> boca para falar. \"Quebrador de Juramento!\" <<Cp:EventUnit>> claramente não está acostumado a usar <<o:EventUnit>> voz. \"A dissonância ameaça a harmonia. Os erros em seus caminhos desequilibraram você e os {PlayerRace}.\" O outro, mais claro em cor e sorrindo de maneira travessa, continua com uma voz igualmente atípica: \"Felizmente, duas dissonâncias orquestradas podem ressonar e causar harmonia.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_602@TITLE"
msgstr "Harmonizando a Dissonância"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_603@BODY_FOOTER"
msgstr "Os <<m:EventUnit>> dobram suas mãos, fecham seus olhos e cantam: \"Repita nossas palavras. Retome seu juramento. Recupere a harmonia.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_603@BODY_HEADER"
msgstr "Você mal teve tempo para inspecionar os despojos do <<G:ruins^p,EventStructure>>, quando o <<m:EventUnit>> reaparece, lado a lado."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_603@BODY_LORE"
msgstr "\"Admirável, simplesmente admirável,\" diz a variante mais clara, com um sorriso e uma voz incomum do <<o:EventUnit>>. A contraparte mais escura do <<Co:EventUnit>> ainda usa <<o:EventUnit>> expressão sombria, embora você veja um vislumbre de aprovação em <<o:EventUnit>> olhos. O {EventUnit} mais claro pisca e continua. \"A dissonância do {EventStructure} contraria a sua própria. Você está pronto.\" O {EventUnit} mais escuro finalmente fala: \"Pronto para a redenção.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_603@TITLE"
msgstr "Harmonizando a Dissonância: Consequências"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_614@BUTTON_0"
msgstr "Repita as palavras deles e retome seu juramento. [devotedact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_614@BUTTON_1"
msgstr "Em vez de seguir a harmonia, [undevotedact/] alimente sua Fúria de Berserker adormecida. [unitHero/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_614@BUTTON_2"
msgstr "Mate o <<m:EventUnit>> [evilact/] para esculpir um {EventItem} [item/] de suas carapaças. [undevotedact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_614@BUTTON_3"
msgstr "Remova a Armadura Abençoada do <<m:EventUnit>> enquanto sua guarda está baixa."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_614@BUTTON_4"
msgstr "\"Eu me harmonizarei com [arcana/] Astral em vez disso. [undevotedact/] Ele nunca me abandonou.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_614@BUTTON_5"
msgstr "\"Eu me harmonizarei com [chaos/] Caos em vez disso. [undevotedact/] Ele nunca me abandonou.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_614@BUTTON_6"
msgstr "\"Eu me harmonizarei com [matter/] Materium em vez disso. [undevotedact/] Ele nunca me abandonou.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_614@BUTTON_7"
msgstr "\"Eu me harmonizarei com [nature/] Natureza em vez disso. [undevotedact/] Ela nunca me abandonou.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_614@BUTTON_8"
msgstr "\"Eu me harmonizarei com [order/] Ordem em vez disso. [undevotedact/] Ela nunca me abandonou.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_614@BUTTON_9"
msgstr "\"Eu me harmonizarei com [shadow/] Sombra em vez disso. [undevotedact/] Ela nunca me abandonou.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_615@BUTTON_0"
msgstr "\"Sábio <<m:EventUnit>>, minha determinação trará harmonia ao reino.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_615@BUTTON_1"
msgstr "\"Minha dissonância só aumentaria, <<m:EventUnit>>. Recuso sua oferta.\" [undevotedact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_625@BODY_FOOTER"
msgstr "\"Para restaurar sua honra, peço que você banir o {EventStackLeader}. Mas cuidado: a criatura se cerca de protetores poderosos.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_625@BODY_HEADER"
msgstr "Você reflete sobre suas ações passadas, muitas das quais se opuseram aos valores de {PlayerOath}, quando, de repente, um {EventUnit} se apresenta."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_625@BODY_LORE"
msgstr "A criatura nobre o observa brevemente, então fala com uma voz severa, mas inspiradora: \"Você é conhecido por mim, Quebrador de Juramentos. Você se desonrou e desonrou sua {PlayerRace}. Ainda assim, nem tudo está perdido. Um teste eu lhe ofereço. Meu inimigo, o traidor {EventStackLeader}, caça guerreiros inexperientes, capturando-os em <<o:EventStackLeader>> teias de mentiras e enganos.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_625@BUTTON_0"
msgstr "\"Eu irei vitoriosamente derrotar o terror que assombra este reino.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_625@BUTTON_1"
msgstr "\"Eu abandonei a Retidão, {EventUnit}. [undevotedact/] Deixe-me em paz.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_625@TITLE"
msgstr "Graça Salvadora"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@BODY_FOOTER"
msgstr "\"Toque minha coroa, faça o juramento e o poder da Retidão fluirá novamente em suas veias.\" O {EventUnit} se curva."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@BODY_HEADER"
msgstr "O <<G:reign of terror^n,EventStackLeader>> terminou enquanto você inspeciona <<o:EventStackLeader>> carapaça sem vida. O {EventUnit} retorna, banhado em uma luz gloriosa."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@BODY_LORE"
msgstr "Quando <<p:EventUnit>> fala, <<o:EventUnit>> palavras aquecem sua alma: \"Meu inimigo perverso foi derrotado. Você fez como eu pedi e fez o que é justo. Lembre-se hoje como seu amanhecer de esperança e reivindicação.\" Uma aura de ouro o envolve. A criatura nobre finalmente ordena:"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@BUTTON_0"
msgstr "Renove seu juramento, pela Retidão. [devotedact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@BUTTON_1"
msgstr "Esqueça seu juramento. [undevotedact/] Esta caçada despertou sua fome por morte. [unitHero/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@BUTTON_2"
msgstr "Derrote [evilact/] o {EventUnit} enquanto <<p:EventUnit>> abaixa <<o:EventUnit>> cabeça. [xp/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@BUTTON_3"
msgstr "Roube os segredos de {GLOBAL.PROPERTIES.ACCURSED_ARMORS_GROUP.Hyperlink} do <<G:corpse^n,EventStackLeader>>."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@BUTTON_4"
msgstr "Abandone a Retidão. [undevotedact/] [arcana/] O Astral será seu verdadeiro caminho."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@BUTTON_5"
msgstr "Abandone a Retidão. [undevotedact/] [chaos/] O Caos será seu verdadeiro caminho."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@BUTTON_6"
msgstr "Abandone a Retidão. [undevotedact/] [matter/] O Materium será seu verdadeiro caminho."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@BUTTON_7"
msgstr "Abandone a Retidão. [undevotedact/] [nature/] A Natureza será seu verdadeiro caminho."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@BUTTON_8"
msgstr "Abandone a Retidão. [undevotedact/] [order/] A Ordem será seu verdadeiro caminho."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@BUTTON_9"
msgstr "Abandone a Retidão. [undevotedact/] [shadow/] A Sombra será seu verdadeiro caminho."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@TITLE"
msgstr "Graça Salvadora: Consequências"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_627@BODY_FOOTER"
msgstr "\"Prove que o Conflito ainda governa suas ações, Quebrador de Juramentos,\" o {EventUnit} berra. \"Conquiste {EventHouse} e eu restaurarei sua honra!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_627@BODY_HEADER"
msgstr "Você reflete sobre suas ações passadas, muitas das quais se opuseram aos valores de {PlayerOath}, quando, de repente, um {EventUnit} se revela."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_627@BODY_LORE"
msgstr "Você ouve a voz do Dragão ressoar em sua cabeça, enquanto <<o:EventUnit>> olhos parecem perfurar seu coração. \"Você levou seu {PlayerRace} e a si mesmo para longe do caminho, Quebrador de Juramentos {PlayerLeader.FirstName}. O poder que você já teve escorregou por entre seus dedos.\" O {EventUnit} sorri. \"Um poder que eu posso devolver a você, se assim desejar.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_627@BUTTON_0"
msgstr "\"Eu não vou decepcioná-lo, {EventUnit}! Pelo Conflito!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_627@BUTTON_1"
msgstr "\"Eu recuso, pois estou além da redenção.\" [undevotedact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_627@TITLE"
msgstr "Conflito Difícil"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_628@BODY_FOOTER"
msgstr "\"Agora, é hora de reabraçar os princípios do Conflito, {PlayerLeader.Title}.\" O {EventUnit} ri. \"A menos que você tenha outros planos.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_628@BODY_HEADER"
msgstr "Depois de ter reclamado a vitória sobre {EventHouse}, o {EventUnit} aparece diante de você novamente. <<Co:EventUnit>> sorriso aflito transborda de deleite."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_628@BODY_LORE"
msgstr "Os sons da agitação surgindo da cidade caída deleitam o Dragão. <<Co:EventUnit>> voz novamente penetra seu crânio. \"Ah, a cacofonia do caos e da calamidade. Uma sinfonia para os servos do Conflito!\" O {EventUnit} o aperta com <<o:EventUnit>> corpo sinuoso, movendo <<o:EventUnit>> mandíbula a centímetros do seu rosto. Vapores saindo da forma serpentina revigoram sua alma."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_628@BUTTON_0"
msgstr "Renove seu juramento [devotedact/] para se tornar um agente do Conflito mais uma vez."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_628@BUTTON_1"
msgstr "Rejeite o juramento [undevotedact/] e abraça seus desejos de queimar cidades. [unitHero/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_628@BUTTON_2"
msgstr "Tente ligar o {EventUnit} à sua vontade."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_628@BUTTON_3"
msgstr "Abandone o Conflito. [undevotedact/] Empunhe [arcana/] o Astral como se fosse sua arma."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_628@BUTTON_4"
msgstr "Abandone o Conflito. [undevotedact/] Empunhe [chaos/] o Caos como se fosse sua arma."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_628@BUTTON_5"
msgstr "Abandone o Conflito. [undevotedact/] Empunhe [matter/] o Materium como se fosse sua arma."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_628@BUTTON_6"
msgstr "Abandone o Conflito. [undevotedact/] Use a [nature/] Natureza como se fosse sua arma."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_628@BUTTON_7"
msgstr "Abandone o Conflito. [undevotedact/] Use a [order/] Ordem como se fosse sua arma."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_628@BUTTON_8"
msgstr "Abandone o Conflito. [undevotedact/] Use a [shadow/] Sombra como se fosse sua arma."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_628@TITLE"
msgstr "Conflito Difícil: Consequências"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1010@BODY_FOOTER"
msgstr "{IntriguePreviousRuler.TitleName} não pode ser salvo, mas você pode tomar uma ação antes que a Gaiola de Ligação desmorone."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1010@BODY_HEADER"
msgstr "Você derrotou {IntrigueVictimPlayerLeader.TitleName} e tomou a capital de <<o:IntrigueVictimPlayerLeader>>, no meio da regência de <<o:IntrigueVictimPlayerLeader>>. Seus exércitos invadem a antiga capital, inundando seus salões principais."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1010@BODY_LORE"
msgstr "Nas profundezas da cidade, você encontra uma masmorra escondida, onde vê o {IntriguePreviousRuler.Title}, adormecido em uma elaborada construção de ritual, sigilos arcanos e uma máquina que você reconhece como uma {GLOBAL.CageOfBindingLoreConcept.Hyperlink}. Infelizmente, o antigo {IntrigueVictimPlayerLeader.Title} havia preparado uma armadilha. Sem ter tomado as precauções adequadas, a armadilha é acionada e a gaiola começa a se desintegrar, sem dúvida resultando na derrota de {IntriguePreviousRuler.TitleName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1010@BUTTON_0"
msgstr "Sobrecarregue o sifão para reclamar seu poder [mana/] em um único surto, destruindo a Gaiola e banindo {IntriguePreviousRuler.FirstName} instantaneamente."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1010@BUTTON_2"
msgstr "Salve o que puder da Gaiola antes que ela desmorone para estudá-la. [knowledge/]."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1010@BUTTON_3"
msgstr "Guie espiritualmente [mana/] {IntriguePreviousRuler.TitleName} para Magehaven [goodact/]."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1010@TITLE"
msgstr "Uma Regência de Curta Duração"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1034@BODY_FOOTER"
msgstr "Parece que o {IntriguePreviousRuler.Title} dos {IntrigueVictimPlayerRace} foi substituído. Como isso poderia ter acontecido com <<P:IntriguePreviousRuler>>? Isso é uma ameaça... ou uma oportunidade para você?"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1034@BODY_HEADER"
msgstr "Enquanto você pondera sobre o reino, é subitamente contatado por ninguém menos que um {CalamityDragonUnit}, que agora parece governar os {IntrigueVictimPlayerRace}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1034@BODY_LORE"
msgstr "Com uma voz trovejante, o {IntrigueVictimPlayerLeader.Title} anuncia: \"Contemplem a chegada de {IntrigueVictimPlayerLeader.Name}, Calamidade encarnada! Os {IntrigueVictimPlayerRace} foram considerados dignos da minha orientação para o [hyperlink,GLOBAL.ChaosConcept]Caos[/hyperlink]. Junte-se a mim ou enfrete seu fim!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1034@BUTTON_0"
msgstr "Devo estar pronto para o que está por vir."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1034@TITLE"
msgstr "Presságio de Destruição"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1038@BODY_FOOTER"
msgstr "\"Seu povo está se perguntando o que nosso grande Império está fazendo para impedir a ruína anunciada pelo {IntrigueVictimPlayerLeader.Title}. O que devemos dizer a eles?\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1038@BODY_HEADER"
msgstr "Você é abordado por um dos membros do seu conselho. \"Meu {PlayerLeader.Title}, há relatos de preocupação das áreas externas do seu império.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1038@BODY_LORE"
msgstr "\"Os aldeões temem que o {IntrigueVictimPlayerLeader.Title} anuncie o fim do mundo. Para um {GLOBAL.GodirLoreConcept.Hyperlink} como você, este reino pode ser apenas um pequeno ponto dentro do {GLOBAL.AstralSeaLoreConcept.Hyperlink}, mas para esses aldeões, este é o seu lar e será por gerações. Eles querem saber que seu {PlayerLeader.Title} os protegerá, assim como seus meios de subsistência.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1038@BUTTON_0"
msgstr "\"Não tenham medo. Pela minha autoridade, encontraremos uma maneira de deter o {IntrigueVictimPlayerLeader.Title}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1038@BUTTON_1"
msgstr "\"O povo está exagerando, o {IntrigueVictimPlayerLeader.Title} está aqui para ficar.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1038@BUTTON_2"
msgstr "\"A Calamidade é um arauto abençoado da mudança e do ciclo eterno! Rejubile-se em seu esplendor!\" [chaosboon/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1038@TITLE"
msgstr "Anunciando o Fim"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1039@BODY_FOOTER"
msgstr "<<g:voice^n,IntriguePreviousRuler>> fica amargo: \"O {IntrigueVictimPlayerLeader.Title} me dominou, drenou meus poderes de {GLOBAL.GodirLoreConcept.Hyperlink} e tomou meu trono, MEU Império.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1039@BODY_HEADER"
msgstr "Você enviou perguntas sobre o aparecimento do {IntrigueVictimPlayerLeader.Title}. Então, um visitante inesperado solicita uma audiência."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1039@BODY_LORE"
msgstr "Ninguém menos que {IntriguePreviousRuler.TitleName} entra em sua corte. \"{PlayerLeader.TitleName},\" <<p:IntriguePreviousRuler>> diz: \"Estou diante de você sem armas. Notei que você estava investigando o {IntrigueVictimPlayerLeader.Title} e não precisa procurar mais. Eu trago todas as respostas que você precisa, pois sou responsável pela presença de <<o:IntrigueVictimPlayerLeader>>. Em minha busca por [hyperlink,GLOBAL.ChaosConcept]Caos[/hyperlink], atraí o <<P:IntrigueVictimPlayerLeader>> para este reino...\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1039@BUTTON_0"
msgstr "Geste para {IntriguePreviousRuler.FirstName} continuar."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1039@TITLE"
msgstr "Aclamando o Fim: Consequências"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1049@BODY_FOOTER"
msgstr "\"Para combater a força da desolação, é preciso o poder do crescimento. Para enfraquecer o {IntrigueVictimPlayerLeader.Title}, deve-se reclamar a {EventStructure}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1049@BODY_HEADER"
msgstr "\"Dói-me admitir isso,\" {IntriguePreviousRuler.FirstName} continua, \"mas sem meus poderes como um {GLOBAL.GodirLoreConcept.Hyperlink}, precisarei de sua ajuda.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1049@BODY_LORE"
msgstr "\"Será tentador atacar o {IntrigueVictimPlayerLeader.Title} diretamente; é o que eu faria. Mas <<p:IntrigueVictimPlayerLeader>> é uma força de destruição, e derrotá-lo diretamente significaria o fim do meu Império. Portanto, peço que enfraqueça o controle de <<o:IntrigueVictimPlayerLeader>> sobre o [hyperlink,GLOBAL.ChaosConcept]Caos[/hyperlink] antes de derrotá-lo. É a única maneira de eu recuperar meu trono.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1049@BUTTON_0"
msgstr "\"Eu reclamarei esta {EventStructure}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1049@BUTTON_1"
msgstr "\"Não, não acho que farei isso.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1049@BUTTON_4"
msgstr "\"Você foi um tolo em se aproximar de mim no seu momento mais fraco. [influence/] Aproveite o Vazio.\" [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1049@TITLE"
msgstr "Calamidade e Maravilha"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1050@BODY_FOOTER"
msgstr "Ao combinar <<g:chaos powers^p,IntriguePreviousRuler>> e os seus, você enfraquece o {IntrigueVictimPlayerLeader.Title} e pode canalizar algo mais..."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1050@BODY_HEADER"
msgstr "Você reclamou a {EventStructure}. Ao olhar para ela, você sente o poder primordial que emana dela."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1050@BODY_LORE"
msgstr "\"Vida após a desolação,\" {IntriguePreviousRuler.FirstName} diz, olhando para a árvore massiva. \"O poder puro da {EventStructure} irá deter <<g:trail of destruction^n,IntrigueVictimPlayerLeader>> e enfraquecer <<P:IntrigueVictimPlayerLeader>>. Isso me permitirá recuperar meu Império.\" <<Cp:IntriguePreviousRuler>> olha para você. \"Meus poderes são limitados, mas posso ajudá-lo a canalizar o poder da {EventStructure} em algo que possa ajudar em nosso empreendimento.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1050@BUTTON_0"
msgstr "Convoque um exército para ajudá-lo! [unit/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1050@BUTTON_1"
msgstr "Convoque um exército de caos e fogo! [unit/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1050@BUTTON_2"
msgstr "Convoque um exército de protetores naturais! [unit/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1050@BUTTON_3"
msgstr "Convoque uma arma mágica! [item/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1050@BUTTON_4"
msgstr "Canalize a força de Vida da Árvore para expandir seu conhecimento! [knowledge/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1050@TITLE"
msgstr "Calamidade e Maravilha: Consequências"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1054@BODY_FOOTER"
msgstr "\"Alguns dos meus súditos mais leais escaparam do <<g:ashen grasp^n,IntrigueVictimPlayerLeader>> e oferecem-se para se juntar a você.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1054@BODY_HEADER"
msgstr "Com a força da {EventStructure} ao seu lado, seu olhar se volta para a destruição causada pelo {IntrigueVictimPlayerLeader.Title}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1054@BODY_LORE"
msgstr "Enquanto você pondera sobre possíveis estratégias, {IntriguePreviousRuler.FirstName} junta-se a você. \"Para derrotar o {IntrigueVictimPlayerLeader.Title}, você deve tomar {EventCity}. Não sinto alegria em conspirar contra meus próprios {IntrigueVictimPlayerRace}, mas como o {IntrigueVictimPlayerLeader.Title} os controla, não vejo outra maneira.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1054@BUTTON_0"
msgstr "\"Aceito a ajuda deles.\" [unit/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1054@BUTTON_1"
msgstr "\"Recuso-me a participar ainda mais de suas falhas.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1054@BUTTON_4"
msgstr "\"Meu exército é forte o suficiente.\" [morale/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1054@TITLE"
msgstr "Montanhas de Cinzas"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1055@BODY_FOOTER"
msgstr "Ódio brilha nos olhos de {IntriguePreviousRuler.FirstName}. \"{PlayerLeader.FirstName}, permita-me mostrar a este {IntrigueVictimPlayerLeader.Title} o que acontece quando você tenta destronar um {GLOBAL.GodirLoreConcept.Hyperlink}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1055@BODY_HEADER"
msgstr "Você conquistou {EventCity}. O {IntrigueVictimPlayerLeader.Title} ruge e os {IntrigueVictimPlayerRace} olham com a respiração contida enquanto {IntriguePreviousRuler.Name} marcha para a sala do trono."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1055@BODY_LORE"
msgstr "Lá, o {IntrigueVictimPlayerLeader.Title} flutua, os poderes {GLOBAL.GodirLoreConcept.Hyperlink} de caos e destruição diminuídos. <<Cp:IntrigueVictimPlayerLeader>> recua e mostra <<o:IntrigueVictimPlayerLeader>> presas, mas {IntriguePreviousRuler.FirstName} não hesita enquanto <<p:IntriguePreviousRuler>> avança. \"Você toma MINHA cidade, toma MEU trono, destrói MEU Império?!\" {IntriguePreviousRuler.FirstName} grita. \"Você, serpente miserável!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1055@BUTTON_0"
msgstr "Permita a vingança de {IntriguePreviousRuler.FirstName}, e <<o:IntriguePreviousRuler>> título."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1055@BUTTON_1"
msgstr "Destrua {IntriguePreviousRuler.FirstName}, subjugue o {IntrigueVictimPlayerLeader.Title} e {IntrigueVictimPlayerRace}. [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1055@BUTTON_2"
msgstr "Destrua tanto o {IntrigueVictimPlayerLeader.Title} quanto {IntriguePreviousRuler.Name}, causando o colapso do <<o:IntriguePreviousRuler>> Império. [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1055@TITLE"
msgstr "Montanhas de Cinzas: Consequências"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1056@BODY_FOOTER"
msgstr "{IntrigueVictimPlayerLeader.TitleName} suspira enquanto <<p:IntrigueVictimPlayerLeader>> afunda em <<o:IntrigueVictimPlayerLeader>> trono. \"Acho que lhe devo algo, não é?\" {IntrigueVictimPlayerLeader.FirstName} concorda. \"Nomeie sua recompensa.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1056@BODY_HEADER"
msgstr "Você recua enquanto {IntrigueVictimPlayerLeader.FirstName} se aproxima do {IntriguePreviousRuler.Title} com intenção assassina."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1056@BODY_LORE"
msgstr "Com cada passo, <<g:powers^p,IntrigueVictimPlayerLeader>> crescem e os do {IntriguePreviousRuler.Title} diminuem. Ainda assim, o {IntriguePreviousRuler.Title} sorri, mostrando uma fileira de dentes. \"Você vê agora, querida {IntrigueVictimPlayerLeader.FirstName}, a promessa da verdadeira Calamidade? A decadência é o estado natural do mundo, apenas você esp...\"[br/]Antes que <<p:IntriguePreviousRuler>> possa terminar <<o:IntriguePreviousRuler>> monólogo, {IntrigueVictimPlayerLeader.FirstName} aniquila <<P:IntriguePreviousRuler>>. \"Cale. A. Boca.\" {IntrigueVictimPlayerLeader.FirstName} rosna. Sem mais delongas, <<p:IntrigueVictimPlayerLeader>> toma <<o:IntrigueVictimPlayerLeader>> trono."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1056@BUTTON_0"
msgstr "\"Precisarei de um aliado neste reino. Junte-se a mim, para a vitória!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1056@BUTTON_1"
msgstr "\"Compartilhe seu conhecimento [knowledge/] e prosperidade comigo, {IntrigueVictimPlayerLeader.FirstName}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1056@BUTTON_2"
msgstr "\"Você não pode ser confiado para governar. Torne-se meu vassalo em vez disso.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1056@BUTTON_3"
msgstr "\"Você é fraco demais para ser chamado de Godir, e eu ainda enfrentarei você na guerra.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1056@TITLE"
msgstr "Das Cinzas"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1057@BODY_FOOTER"
msgstr "O {IntrigueVictimPlayerLeader.Title} olha para você com curiosidade mórbida. \"Estou ligado a você. O que um {PlayerLeader.Title} poderia pedir a um {IntrigueVictimPlayerLeader.Title} derrotado?\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1057@BODY_HEADER"
msgstr "{IntriguePreviousRuler.FirstName} se aproxima do {IntrigueVictimPlayerLeader.Title} com intenção assassina. O Dragão se enrola e sorri, presas à mostra para a batalha iminente."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1057@BODY_LORE"
msgstr "Enquanto {IntriguePreviousRuler.FirstName} vira <<o:IntriguePreviousRuler>> de volta para você, você sinaliza para seus soldados atacarem. O ex-{IntriguePreviousRuler.Title} enfraquecido não é páreo para sua traição. \"Você... criatura enganadora...\" {IntriguePreviousRuler.FirstName} ofega, antes do [hyperlink,GLOBAL.AstralVoidLoreConcept]Vazio[/hyperlink] levar <<P:IntriguePreviousRuler>>.[br/]O {IntrigueVictimPlayerLeader.Title} ri, um trovão que causa rachaduras nas paredes. \"Sim! Destruição, decadência... Calamidade! Você me venceu neste jogo de caos, ó {PlayerLeader.Title}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1057@BUTTON_0"
msgstr "Forçar o {IntrigueVictimPlayerLeader.Title} a compartilhar mais conhecimento [knowledge/] sobre Calamidade."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1057@BUTTON_1"
msgstr "Exigir um tributo de ouro [gold/] e magia [mana/]."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1057@BUTTON_2"
msgstr "Reivindicar uma hoste de soldados Amaldiçoados [unit/] ao seu lado."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1057@TITLE"
msgstr "Calamidade Conquistada"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1058@BODY_FOOTER"
msgstr "Enquanto o Império de {IntriguePreviousRuler.TitleName} desmorona, você pode reivindicar um objeto da sala do trono antes que ele colapse completamente."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1058@BODY_HEADER"
msgstr "{IntriguePreviousRuler.FirstName} se aproxima do {IntrigueVictimPlayerLeader.Title} com intenção assassina. O Dragão se enrola e sorri, presas à mostra para a batalha iminente."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1058@BODY_LORE"
msgstr "Nenhum deles esperava que você ordenasse que seus soldados atacassem e enviassem ambos para o {GLOBAL.AstralVoidLoreConcept.Hyperlink}. \"Você... ousa...\" {IntriguePreviousRuler.FirstName} ofega, antes que <<p:IntriguePreviousRuler>> desapareça. O {IntrigueVictimPlayerLeader.Title} apenas ri enquanto seus exércitos cercam <<P:IntrigueVictimPlayerLeader>>. Com um último golpe de <<o:IntrigueVictimPlayerLeader>> cauda, <<p:IntrigueVictimPlayerLeader>> destrói o trono e derruba os pilares que sustentam a fortaleza, antes que <<p:IntrigueVictimPlayerLeader>> também desapareça."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1058@BUTTON_0"
msgstr "Reivindique o trono, como um lembrete do seu poder. [influence/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1058@BUTTON_1"
msgstr "Aproveite [evilact/] o Caos [chaos/] que se esvai dos dois Governantes para aumentar seu poder [mana/]."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1058@BUTTON_2"
msgstr "Forçar um grupo de soldados {EventRace} a se juntar a você. [unit/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1058@TITLE"
msgstr "Fim de um Império"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1059@BODY_FOOTER"
msgstr "O {IntrigueVictimPlayerLeader.TitleName} se deleita com a destruição que <<p:IntrigueVictimPlayerLeader>> causa."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1059@BODY_HEADER"
msgstr "O {IntrigueVictimPlayerLeader.Title} se levanta para um céu escurecido. Nuvens cinzentas se reúnem e cinzas giram enquanto o ar fica pesado com a pressão."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1059@BODY_LORE"
msgstr "O dragão rugi: \"Que comece a Era da Guerra! Que cometas atinjam! Que o fogo caia! Contemple a glória da Calamidade!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1059@BUTTON_0"
msgstr "Nós vamos perseverar."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1059@BUTTON_1"
msgstr "Rejubile-se na destruição! [chaosboon/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1059@TITLE"
msgstr "Sombra da Entropia"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1060@BODY_FOOTER"
msgstr "{IntriguePreviousRuler.TitleName} parte para {GLOBAL.MagehavenLoreConcept.Hyperlink} enquanto <<o:IntriguePreviousRuler>> Império desmorona. Você pode reivindicar um objeto da sala do trono desmoronando antes que ele colapse completamente."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1060@BODY_HEADER"
msgstr "Você derrotou o {IntrigueVictimPlayerLeader.Title} sem maiores precauções. {IntriguePreviousRuler.FirstName} aparece diante de você. \"O que você fez?!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1060@BODY_LORE"
msgstr "Em um último ato de desafio, o {IntrigueVictimPlayerLeader.Title} ri e sobe aos ares para destruir o trono dos {IntrigueVictimPlayerRace}, antes de desaparecer no {GLOBAL.AstralVoidLoreConcept.Hyperlink}.[br/]{IntriguePreviousRuler.FirstName} olha para a destruição. \"Meu {IntrigueVictimPlayerRace}, meu trono... Tudo se foi.\" <<Cp:IntriguePreviousRuler>> mal consegue conter sua raiva. \"Eu vou reconstruir em outro lugar. Esta não é o fim da minha história.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1060@BUTTON_0"
msgstr "Reivindique o trono, como um lembrete do seu poder. [influence/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1060@BUTTON_1"
msgstr "Aproveite [evilact/] o Caos [chaos/] que se esvai dos dois Governantes para aumentar sua banda de guerra [unitprod/]."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1060@BUTTON_2"
msgstr "Forçar um grupo de soldados {EventRace} a se juntar a você. [unit/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1060@TITLE"
msgstr "Fim de um Império"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1125@BODY_FOOTER"
msgstr "\"Aqueles que podem governar com fé e [hyperlink,GLOBAL.OrderConcept]Ordem[/hyperlink] não têm nada a temer. Em breve, entrarei em contato com aqueles que são dignos de redenção.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1125@BODY_HEADER"
msgstr "Seja perto ou longe, este reino viu guerra e conflito. Enquanto você contempla isso, um novo Governante anuncia <<r:IntrigueVictimPlayerLeader>>."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1125@BODY_LORE"
msgstr "\"Saudações, {GLOBAL.GodirLoreConcept.Hyperlink}. Dado o estado atual do reino, {IntriguePreviousRuler.TitleName} foi destituído de <<o:IntriguePreviousRuler>> governo até que os diversos problemas sejam resolvidos. Em vez de <<o:IntriguePreviousRuler>>, o manto de autoridade sobre todos os {IntrigueVictimPlayerRace} foi concedido a mim, como o {IntrigueVictimPlayerLeader.Title}. Pelos poderes sagrados investidos em mim, eu doravante julgarei todos que governam aqui.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1125@BUTTON_0"
msgstr "\"Finalmente, um devoto da Ordem [order/] como eu!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1125@BUTTON_1"
msgstr "\"Eu não reconheço nenhuma autoridade além da minha!\" [imperium/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1125@BUTTON_2"
msgstr "\"Muito bem...\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1125@TITLE"
msgstr "Dia do Julgamento"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1129@BODY_FOOTER"
msgstr "Passar por essas provações é a única maneira de trazer de volta {IntriguePreviousRuler.TitleName}..."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1129@BODY_HEADER"
msgstr "O {IntrigueVictimPlayerLeader.Title} entra em contato com você. \"Este reino é um poço de caos e hostilidade, e os {GLOBAL.GodirLoreConcept.Hyperlink} aqui falharam em impor [hyperlink,GLOBAL.OrderConcept]Ordem[/hyperlink].\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1129@BODY_LORE"
msgstr "\"Estas são as circunstâncias que me compeliram a intervir. No entanto, as forças da fé são nada se não misericordiosas. Você, {PlayerLeader.TitleName}, está sendo dado a oportunidade de provar-se como um Governante digno, o que me libertará do meu dever como {IntrigueVictimPlayerLeader.Title}. Para isso, você deve provar que pode restaurar a ordem ao reino. Você aceita estas provações?\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1129@BUTTON_0"
msgstr "\"Eu aceito esta provação.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1129@BUTTON_1"
msgstr "\"Eu recuso estas provações, você animal de carga arrogante!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1129@BUTTON_2"
msgstr "a"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1129@TITLE"
msgstr "Provações de Redenção"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1130@BODY_FOOTER"
msgstr "\"[hyperlink,GLOBAL.OrderConcept]Ordem[/hyperlink] deveria ser sua própria recompensa, mas reconheço que velhos padrões não são facilmente quebrados. Como tal, estou lhe dando a autoridade de apresentar uma recompensa de sua escolha.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1130@BODY_HEADER"
msgstr "Você se tornou amigo de uma {GLOBAL.IndependentCityConcept}. O {IntrigueVictimPlayerLeader.Title} aparece mais uma vez e acena com a cabeça. \"Você ainda pode provar-se digno.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1130@BODY_LORE"
msgstr "\"No grande esquema das coisas, muitos {GLOBAL.GodirLoreConcept.Hyperlink} esquecem sobre o poder das formas de vida inferiores. No entanto, deve-se tentar encontrar alianças mesmo com aqueles que se possa descartar à primeira vista.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1130@BUTTON_0"
msgstr "Escolha uma recompensa monetária [gold/]."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1130@BUTTON_2"
msgstr "Decida sobre uma bênção em {EventCity}. [food/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1130@BUTTON_3"
msgstr "Recuse qualquer recompensa [influence/], você faz isso pelo seu império, não por ninguém mais."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1130@TITLE"
msgstr "Honrar os Humildes"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1134@BODY_FOOTER"
msgstr "\"Destrua o {EventStructure}, prove que você pode tanto passar a sentença quanto empunhar a espada do carrasco.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1134@BODY_HEADER"
msgstr "O {IntrigueVictimPlayerLeader.Title} murmura: \"Você passou na primeira provação, agora deve provar seu zelo.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1134@BODY_LORE"
msgstr "\"[hyperlink,GLOBAL.OrderConcept]Ordem[/hyperlink] equilibra as escalas da harmonia e da violência justa. Algumas criaturas são simplesmente irrecuperáveis. Há momentos em que se deve purgar o reino daqueles que desejam causar dano. Essa será sua próxima provação, para provar seu valor como custódio deste reino.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1134@BUTTON_0"
msgstr "\"Eu aceito esta provação.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1134@BUTTON_1"
msgstr "\"Eu recuso esta provação. Você não tem autoridade sobre mim!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1134@TITLE"
msgstr "Fulminar os Ímpios"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1135@BODY_FOOTER"
msgstr "\"Através desta demonstração de poder e julgamento, você ganhou uma recompensa, {PlayerLeader.TitleName}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1135@BODY_HEADER"
msgstr "O {IntrigueVictimPlayerLeader.Title} aparece mais uma vez. \"Você purificou o reino de uma de suas ameaças. Bem feito.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1135@BODY_LORE"
msgstr "\"Os poderes da [hyperlink,GLOBAL.OrderConcept]Ordem[/hyperlink] me convocam para reinos que precisam do meu julgamento. Fico satisfeito em ver que você é um prospecto promissor como seu guardião. Tornar-se a mão divina que dá, mas fulmina quando necessário... É um manto de honra, mas também de obrigação.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1135@BUTTON_0"
msgstr "Peça para aprender mais sobre a Ordem e seus méritos."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1135@BUTTON_3"
msgstr "Escolha uma bênção [happiness/] para toda a sua {EventRace}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1135@BUTTON_4"
msgstr "Decida que qualquer recompensa deve ir para aqueles que lutam em seu nome. [moral/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1135@TITLE"
msgstr "Fulminar os Ímpios: Consequências"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1139@BODY_FOOTER"
msgstr "\"Decida se este Governante merece sua misericórdia ou sua ira.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1139@BODY_HEADER"
msgstr "\"Agora, para seu julgamento final,\" o {IntrigueVictimPlayerLeader.Title} diz, \"você deve equilibrar as escalas da justiça entre benevolência e derramamento de sangue.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1139@BODY_LORE"
msgstr "\"Este reino precisa estar em paz, o que pode ser encontrado através das bênçãos da fé ou da força da subjugação. Como {GLOBAL.GodirLoreConcept.Hyperlink}, você deve pesar os méritos de ambos e escolher sabiamente entre eles. Há Governantes neste reino que precisam ser julgados, e você o fará.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1139@BUTTON_0"
msgstr "\"Eu aceito este julgamento.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1139@BUTTON_4"
msgstr "\"Eu recuso este julgamento. Eu decido quem é digno do meu julgamento!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1139@TITLE"
msgstr "Escalas da Justiça"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1140@BODY_FOOTER"
msgstr "\"Meu dever como {IntrigueVictimPlayerLeader.Title} está cumprido. Eu deixo a decisão final sobre o destino de {IntriguePreviousRuler.TitleName} para você.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1140@BODY_HEADER"
msgstr "Você julgou e agiu sobre o destino de um colega Governante. Agora, o {IntrigueVictimPlayerLeader.Title} aparece mais uma vez. \"Muito bem.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1140@BODY_LORE"
msgstr "\"Ao decidir entre derrota e diplomacia, você trouxe um senso de paz e [hyperlink,GLOBAL.OrderConcept]Ordem[/hyperlink] para o reino e provou ser um guardião justo e capaz.\" O {IntrigueVictimPlayerLeader.Title} se curva profundamente, <<o:IntrigueVictimPlayerLeader>> chifres quase tocam o chão. \"Você é digno do título de {GLOBAL.GodirLoreConcept.Hyperlink}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1140@BUTTON_0"
msgstr "\"Parta, então, e permita que {IntriguePreviousRuler.Name} retorne.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1140@BUTTON_1"
msgstr "\"Fique, {IntrigueVictimPlayerLeader.FirstName}. Eu posso usar sua orientação.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1140@BUTTON_2"
msgstr "\"{IntriguePreviousRuler.Name} é indigno. Parta, <<o:IntriguePreviousRuler>> Império está perdido.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1140@TITLE"
msgstr "Escalas da Justiça: Consequências"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1141@BODY_FOOTER"
msgstr "{IntrigueVictimPlayerLeader.TitleName} suspira enquanto <<p:IntrigueVictimPlayerLeader>> afunda em <<o:IntrigueVictimPlayerLeader>> trono. \"Nomeie sua recompensa.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1141@BODY_HEADER"
msgstr "O {IntriguePreviousRuler.Title} acena. \"Que assim seja. Adeus, {PlayerLeader.TitleName}.\" Com um clarão de luz, <<p:PreviousRuler>> desaparece, e {IntrigueVictimPlayerLeader.TitleName} aparece com uma faísca."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1141@BODY_LORE"
msgstr "\"O que... o que aconteceu?\" {IntrigueVictimPlayerLeader.FirstName} diz, tropeçando. \"Eu estava aqui, governando meu Império, até que uma voz grandiosa discursou sobre meus supostos fracassos... Ela me prendeu no {GLOBAL.AstralVoidLoreConcept.Hyperlink}, e então... me disse que você havia provado seu valor e solicitado meu retorno. Eu não sei o que você fez... mas acho que devo minha gratidão a você.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1141@BUTTON_0"
msgstr "\"Precisarei de um aliado neste reino. Junte-se a mim, para a vitória!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1141@BUTTON_1"
msgstr "\"Compartilhe seu conhecimento [conhecimento/] e prosperidade [ouro/] [mana/] comigo, {IntrigueVictimPlayerLeader.FirstName}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1141@BUTTON_2"
msgstr "\"Após sua ausência, você não pode ser confiável para governar. Torne-se meu vassalo em vez disso.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1141@BUTTON_3"
msgstr "\"Você é fraco demais para ser chamado de Godir, e eu ainda enfrentarei você na guerra.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1141@TITLE"
msgstr "Justiça, Entregue"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1142@BODY_FOOTER"
msgstr "\"Acho que a única questão restante é como nossos laços devem ser, {PlayerLeader.TitleName}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1142@BODY_HEADER"
msgstr "O {IntrigueVictimPlayerLeader.Title} se anima. \"Você pede para eu ficar? Como... pouco ortodoxo. Acho que eu poderia.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1142@BODY_LORE"
msgstr "O {IntrigueVictimPlayerLeader.Title} fica em silêncio por um momento, depois acena com a cabeça. \"Está feito. {IntriguePreviousRuler.TitleName} permanecerá no {GLOBAL.AstralVoidLoreConcept.Hyperlink} para encontrar o caminho de <<o:IntriguePreviousRuler>>, como você decreta. E eu ficarei neste reino como o novo Governante dos {IntrigueVictimPlayerRace}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1142@BUTTON_0"
msgstr "\"Precisarei de um aliado neste reino. Junte-se a mim, para a vitória!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1142@BUTTON_1"
msgstr "\"Compartilhe seu conhecimento [knowledge/] e prosperidade [gold/] [mana/] comigo, {IntrigueVictimPlayerLeader.FirstName}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1142@BUTTON_2"
msgstr "\"Você não está pronto para governar completamente. Torne-se meu vassalo em vez disso.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1142@BUTTON_3"
msgstr "\"Como um novo Governante, você precisará encontrar seu próprio caminho, com uma folha em branco.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1142@TITLE"
msgstr "Apenas Nós"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1143@BODY_FOOTER"
msgstr "Os {IntrigueVictimPlayerRace} deixam suas cidades por seu decreto. Tudo o que resta é o destino de sua antiga capital."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1143@BODY_HEADER"
msgstr "O {IntrigueVictimPlayerLeader.Title} acena com a cabeça. \"Que assim seja. Eu partirei, e {IntriguePreviousRuler.TitleName} permanecerá no {GLOBAL.AstralVoidLoreConcept.Hyperlink}, conforme seu decreto.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1143@BODY_LORE"
msgstr "\"Este reino fica em suas mãos, {PlayerLeader.TitleName}. Govern-o bem.\" Com uma última reverência, o {IntrigueVictimPlayerLeader.Title} desaparece."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1143@BUTTON_0"
msgstr "Reivindique o trono, como um lembrete do seu poder. [influence/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1143@BUTTON_1"
msgstr "Exija que alguns {IntrigueVictimPlayerRace} se juntem a você. [unit/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1143@BUTTON_2"
msgstr "Deixe sua benevolência e poder serem conhecidos [happiness/] por todas as suas cidades."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1143@TITLE"
msgstr "Folha em Branco"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1144@BODY_FOOTER"
msgstr "{IntrigueWarVictimPlayerLeader.TitleName} está indignado e tenta protestar, mas nada pode ser feito sobre a declaração de {IntrigueVictimPlayerLeader.FirstName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1144@BODY_HEADER"
msgstr "O {IntrigueVictimPlayerLeader.Title} tem outro anúncio a fazer."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1144@BODY_LORE"
msgstr "\"{IntrigueWarVictimPlayerLeader.TitleName} falhou como soberano, <<o:IntrigueWarVictimPlayerLeader>> governo manchado por incompetência e falta de fé. Por decreto do {IntrigueVictimPlayerLeader.Title}, <<o:IntrigueWarVictimPlayerLeader>> coroa é perdida. A guerra será <<o:IntrigueWarVictimPlayerLeader>> sentença, enquanto os exércitos da justiça marcham sobre <<o:IntrigueWarVictimPlayerLeader>> reino. Que se saiba que <<o:IntrigueWarVictimPlayerLeader>> reinado termina em fogo e aço, pelo bem de todos.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1144@BUTTON_0"
msgstr "Que assim seja."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1144@TITLE"
msgstr "O Martelo Cai"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1145@BODY_FOOTER"
msgstr "Embora você não possa trazer {ItnriguePreviousRuler.Name} de volta, você pode reivindicar qualquer coisa do {IntrigueVictimPlayerLeader.Title} que desaparece."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1145@BODY_HEADER"
msgstr "Você derrotou {IntrigueVictimPlayerLeader.TitleName} e tomou <<o:IntrigueVictimPlayerLeader>> capital. O {IntrigueVictimPlayerLeader.Title} aparece mais uma vez, <<o:IntrigueVictimPlayerLeader>> demeanor altivo diminuído. \"Isso é um ultraje!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1145@BODY_LORE"
msgstr "O pânico de <<Co:IntrigueVictimPlayerLeader>> aumenta à medida que <<p:IntrigueVictimPlayerLeader>> desaparece. \"Sua insolência não pode ficar sem resposta! [hyperlink,GLOBAL.OrderConcept]Ordem[/hyperlink] prevalecerá... Deve! A justiça deve ser feita... Ainda não acabei! Não!\" Com um último brilho de luz, o {IntrigueVictimPlayerLeader.Title} desaparece no {GLOBAL.AstralSeaLoreConcept.Hyperlink}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1145@BUTTON_0"
msgstr "Canalize [mana/] <<g:fading zeal^n,IntrigueVictimPlayerLeader>> para aprimorar sua própria magia."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1145@BUTTON_1"
msgstr "Receba os {IntrigueVictimPlayerRace} em {EventCity}. [population/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1145@BUTTON_2"
msgstr "Tome <<o:IntrigueVictimPlayerLeader>> chifres para exibi-los como um símbolo do seu poder. [influence/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1145@TITLE"
msgstr "Você e o Exército de Quem"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1156@BODY_FOOTER"
msgstr "Com <<g:palavras finais para você^p,IntrigueVictimPlayerLeader>>, toda a esperança de trazer de volta {IntriguePreviousRuler.Name} está perdida. \"Você foi julgado e considerado indigno.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1156@BODY_HEADER"
msgstr "Você falhou em convencer o {IntrigueVictimPlayerLeader.Title} de suas intenções justas. <<Cp:IntrigueVictimPlayerLeader>> entra em contato com você com um nojo mal disfarçado."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1156@BODY_LORE"
msgstr "\"Seja por intenção ou incompetência, você provou ser indigno de seu manto como um {GLOBAL.LeaderConcept}. Pela autoridade investida em mim como {IntrigueVictimPlayerLeader.Title}, eu decreto sua remoção deste reino para o bem maior. Que isso sirva como uma declaração oficial de {GLOBAL.WarConcept} sobre você e todos os outros soberanos indignos que ousam reclamar domínio aqui.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1156@BUTTON_0"
msgstr "\"Que assim seja!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1156@TITLE"
msgstr "Para que não sejas julgado"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1233@BODY_FOOTER"
msgstr "O {IntriguePreviousRuler.Title} dos {IntrigueVictimPlayerRace} perdeu um jogo com o {IntrigueVictimPlayerLeader.Title} e foi... suplantado."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1233@BODY_HEADER"
msgstr "Durante um momento de descanso, você sente um frio repentino, enquanto um {ReaperUnit} aparece diante de você."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1233@BODY_LORE"
msgstr "O {ReaperUnit} sem rosto sussurra em uma voz ao mesmo tempo imensamente alta e suave como o farfalhar de folhas mortas: \"{IntriguePreviousRuler.TitleName} me invocou. <<Cp:IntriguePreviousRuler>> pensou que poderia me acorrentar, me enganar, mas nenhuma corrente pode segurar a morte em si. {IntriguePreviousRuler.Name} apostou com <<o:IntriguePreviousRuler>> [hyperlink,GLOBAL.SoulsLoreConcept]Alma[/hyperlink] e perdeu. E assim eu a reclamo, e as [hyperlink,GLOBAL.SoulsLoreConcept]Almas[/hyperlink] dos {IntrigueVictimPlayerRace}. Eu não tenho nome... mas você pode me chamar de {IntrigueVictimPlayerLeader.FirstName}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1233@BUTTON_0"
msgstr "Deve-se jogar com as cartas que se tem..."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1233@TITLE"
msgstr "Uma aposta com a morte"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1237@BODY_FOOTER"
msgstr "Se você quiser investigar o {IntriguePreviousRuler.Title} e o {IntrigueVictimPlayerLeader.Title}, precisará separar fato de ficção."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1237@BODY_HEADER"
msgstr "Boatos sobre o destino de {IntriguePreviousRuler.TitleName} e o {ReaperUnit} que agora governa os {IntrigueVictimPlayerRace} chegam à sua corte. Seus conselheiros estão divididos."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1237@BODY_LORE"
msgstr "\"Nenhum {GLOBAL.GodirLoreConcept.Hyperlink} está acima das forças primordiais da morte, nem mesmo {IntriguePreviousRuler.TitleName},\" diz um deles. \"Eu digo que deixemos <<P:IntriguePreviousRuler>> aprender <<o:IntriguePreviousRuler>> lição no [hyperlink,GLOBAL.AstralVoidLoreConcept]Vazio[/hyperlink].\"[br/]Outro conselheiro é mais calculista. \"O {IntrigueVictimPlayerLeader.Title} é uma lenda entre muitos. Aprender mais pode ajudá-lo a evitar o mesmo destino de {IntriguePreviousRuler.FirstName}. Além disso, pense no favor que <<p:IntriguePreviousRuler>> lhe deveria...\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1237@BUTTON_0"
msgstr "\"Eu desvendarei os mistérios da morte.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1237@BUTTON_1"
msgstr "\"Deixe {IntriguePreviousRuler.FirstName} apodrecer no Vazio, tenho outros assuntos para cuidar.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1237@TITLE"
msgstr "Morte e Lendas"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1238@BODY_FOOTER"
msgstr "\"Nós teorizamos que para derrotar o {IntrigueVictimPlayerLeader.Title}, deve-se desafiar <<P:IntrigueVictimPlayerLeader>> para um jogo de seu próprio design.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1238@BODY_HEADER"
msgstr "Você investigou o {IntrigueVictimPlayerLeader.Title} e o destino que recaiu sobre {IntriguePreviousRuler.TitleName}. Um de seus estudiosos se aproxima com os resultados."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1238@BODY_LORE"
msgstr "\"É amplamente conhecido que {GLOBAL.SoulsLoreConcept.Hyperlink} dos falecidos viajam para {GLOBAL.TheWellLoreConcept.Hyperlink}, mas as crenças sobre como e por que diferem por-\" O estudioso percebe seu olhar. \"... Eu me desvio. O {IntrigueVictimPlayerLeader.Title} disse que <<p:IntrigueVictimPlayerLeader>> passou a governar os {IntrigueVictimPlayerRace} através de uma aposta. Acredita-se amplamente que a morte tem uma forte conexão com o destino... e, portanto, <<m:ReaperUnit>> amam jogos de chance, porque sempre vencem.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1238@BUTTON_0"
msgstr "\"Continue...\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1238@TITLE"
msgstr "Morte e Lendas: Consequências"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1242@BODY_FOOTER"
msgstr "\"Nós acreditamos firmemente que a {EventStructure} contém um artefato que o ajudará contra o {IntrigueVictimPlayerLeader.Title}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1242@BODY_HEADER"
msgstr "O estudioso concorda, feliz por você não ter dispensado <<P:EventUnit>> ainda. \"Durante nossa busca, também investigamos mitos e lendas de outros Impérios.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1242@BODY_LORE"
msgstr "\"Foram as lendas dos {IntrigueRandomRace} que nos levaram à {EventStructure}. Aparentemente, ela esconde a prisão de um ladrão lendário que enganou <<o:IntrigueWonderHero>> alma das garras da morte em si. Quão irônico, ser enterrado após escapar da morte... Diz-se que <<p:IntrigueWonderHero>> ainda carrega o segredo para o maior truque que <<p:IntrigueWonderHero>> já fez.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1242@BUTTON_0"
msgstr "\"Muito bem, eu explorarei esta '{EventStructure}'.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1242@BUTTON_1"
msgstr "\"Não perseguirei mais mitos e lendas. Recuso.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1242@TITLE"
msgstr "Trapaceando o Destino"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1243@BODY_FOOTER"
msgstr "\"Com o {IntrigueItem} em sua posse, você está pronto para confrontar o {IntrigueVictimPlayerLeader.Title}...\" seu acadêmico diz. \"A única questão é como.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1243@BODY_HEADER"
msgstr "Você encontrou {IntrigueItem}, um artefato mágico que permite virar qualquer jogo a seu favor. Seu acadêmico está eufórico."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1243@BODY_LORE"
msgstr "\"Então as lendas eram verdadeiras! Quão glorioso, que grande dia para nós, historiadores!\" O acadêmico comemora. \"Hmm, mas, é claro, o mais importante é que isso permite que você desafie o {IntrigueVictimPlayerLeader.Title} para um jogo de dados. Pelo que ouvi, <<p:IntrigueVictimPlayerLeader>> certamente aceitará!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1243@BUTTON_0"
msgstr "\"Certamente você está prestes a me dizer.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1243@BUTTON_7"
msgstr "\"Me colocar naquela posição vulnerável? Absurdo! Encontrarei outra maneira de lidar com isso.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1243@TITLE"
msgstr "Trapaceando o Destino: Desfecho"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1247@BODY_FOOTER"
msgstr "\"Para desafiar o {IntrigueVictimPlayerLeader.Title}, você precisará carregar o {IntrigueItem} com você... e se lançar no {GLOBAL.AstralVoidLoreConcept.Hyperlink}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1247@BODY_HEADER"
msgstr "Seu acadêmico se mexe desconfortavelmente. \"Pensei em como lhe dizer isso, meu {PlayerLeader.Title}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1247@BODY_LORE"
msgstr "\"Para desafiar adequadamente o {IntrigueVictimPlayerLeader.Title}, precisamos dar a <<P:IntrigueVictimPlayerLeader>> a impressão de que você está à mercê de <<o:IntrigueVictimPlayerLeader>>. Só então <<p:IntrigueVictimPlayerLeader>> estará disposto a aceitar qualquer aposta sua.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1247@BUTTON_0"
msgstr "\"...Muito bem. Se devo enfrentar a morte, então morrerei!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1247@BUTTON_1"
msgstr "\"Eu, naquela posição vulnerável? Nunca! Encontrarei outra maneira de lidar com isso.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1247@TITLE"
msgstr "Sem Medo da Morte"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1248@BODY_FOOTER"
msgstr "\"Aceito seu desafio, {PlayerLeader.TitleName}. Deixe este momento decidir seu destino. O que você aposta?\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1248@BODY_HEADER"
msgstr "Você se vê à beira do {GLOBAL.AstralVoidLoreConcept.Hyperlink}. Enquanto sente a escuridão puxando você, o {IntrigueVictimPlayerLeader.Title} aparece."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1248@BODY_LORE"
msgstr "Mesmo na escuridão, a forma de <<o:IntrigueVictimPlayerLeader>> é claramente visível. \"Não sinto medo ou raiva em você,\" <<o:IntrigueVictimPlayer>> suspira. \"Você acolhe minha presença. Por quê?\" Quando você desafia <<P:IntrigueVictimPlayerLeader>> para um jogo de dados, a voz de <<o:IntrigueVictimPlayerLeader>> muda levemente, quase com... excitação. \"Um jogo de chance, de Destino, não posso resistir.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1248@BUTTON_0"
msgstr "\"Aposto minha alma pelo retorno de {IntriguePreviousRuler.TitleName}, que governa legitimamente os {IntrigueVictimPlayerRace}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1248@BUTTON_1"
msgstr "\"Aposto minha alma por uma aliança com você, ó {IntrigueVictimPlayerLeader.Title}!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1248@BUTTON_2"
msgstr "\"Aposto minha alma para que você deixe este reino.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1248@TITLE"
msgstr "Sem Medo da Morte: Confrontação"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1249@BODY_FOOTER"
msgstr "Você é imediatamente contatado por {IntrigueVictimPlayerLeader.TitleName}. \"Você... me trouxe de volta. Pensei que este fosse o meu fim. Eu lhe devo, {PlayerLeader.FirstName}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1249@BODY_HEADER"
msgstr "Você lança o {IntrigueItem}. O {IntriguePreviousRuler.Title} olha intensamente para ele enquanto rola e pousa no símbolo em que você apostou sua alma."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1249@BODY_LORE"
msgstr "O {IntriguePreviousRuler.Title} acena com a cabeça. \"Um artefato tão interessante... A vida em si é um gambito sem fim para escapar do alcance da morte, mas aqueles que vencem muitas vezes descobrem que seu prêmio azedará com o tempo. Você venceu hoje, {PlayerLeader.TitleName}. Nos encontraremos novamente.\" Com isso, <<p:IntriguePreviousRuler>> desaparece e você se vê de volta à sua capital."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1249@BUTTON_0"
msgstr "\"Sejamos aliados, então, e unamo-nos em nossa busca pela vitória!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1249@BUTTON_1"
msgstr "\"Eu recebo minha recompensa em ouro [gold/] e mana [mana/].\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1249@BUTTON_2"
msgstr "\"Sua negligência custou seu direito sobre este reino. Torne-se meu vassalo em vez disso.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1249@BUTTON_3"
msgstr "\"Eu só te trouxe de volta para derrotá-lo eu mesmo!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1249@TITLE"
msgstr "Morte e Vida"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1250@BODY_FOOTER"
msgstr "Você agora está aliado ao {IntrigueVictimPlayerLeader.Title}. Qual seria seu primeiro pedido a este amigo mortal?"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1250@BODY_HEADER"
msgstr "Você lança o {IntrigueItem}. O {IntrigueVictimPlayerLeader.Title} olha atentamente para ele enquanto rola e pousa no símbolo em que você apostou sua alma."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1250@BODY_LORE"
msgstr "O {IntriguePreviousRuler.Title} acena. \"Um artefato tão interessante... A própria vida é um gambito sem fim para escapar do alcance da morte, mas aqueles que vencem muitas vezes descobrem que seu prêmio azedará com o tempo. Você venceu hoje, {PlayerLeader.TitleName}. Eu vou chamá-lo de meu... aliado.\" Você pisca e se encontra de volta à sua capital."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1250@BUTTON_0"
msgstr "Peça ao {IntrigueVictimPlayerLeader.Title} para compartilhar mais conhecimento [knowledge/] sobre a Morte."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1250@BUTTON_1"
msgstr "Solicite um presente de ouro [gold/] e magia [mana/]."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1250@BUTTON_2"
msgstr "Garanta que todo o reino saiba da sua aliança com a própria morte. [influence/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1250@TITLE"
msgstr "Como Velhos Amigos"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1251@BODY_FOOTER"
msgstr "À medida que o {IntrigueVictimPlayerLeader.Title} desaparece, o antigo Império de {IntriguePreviousRuler.TitleName} desmorona, um símbolo de inevitabilidade."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1251@BODY_HEADER"
msgstr "Você lança o {IntrigueItem}. O {IntrigueVictimPlayerLeader.Title} olha atentamente para ele enquanto rola e pousa no símbolo em que você apostou sua alma."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1251@BODY_LORE"
msgstr "O {IntrigueVictimPlayerLeader.Title} acena. \"Um artefato tão interessante... A própria vida é um gambito sem fim para escapar do alcance da morte, mas aqueles que vencem muitas vezes descobrem que seu prêmio azedará com o tempo. Você venceu hoje, {PlayerLeader.TitleName}. Nós nos encontraremos novamente.\" Com isso, <<p:IntrigueVictimPlayerLeader>> desaparece e você se encontra de volta à sua capital."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1251@BUTTON_0"
msgstr "Reivindique o trono, como um lembrete do seu poder. [influence/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1251@BUTTON_1"
msgstr "Aproveite a força desaparecida do {IntrigueVictimPlayerLeader.Title} [shadow/] para reunir energia arcana. [mana/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1251@BUTTON_2"
msgstr "Aprofunde-se no conhecimento mortal [knowledge/] para aprimorar o seu próprio."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1251@TITLE"
msgstr "Até Nos Encontrarmos Novamente"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1252@BODY_FOOTER"
msgstr "O <<G:head^n,ReaperUnit>> inclina-se enquanto o jogo de chance de <<o:IntrigueVictimPlayerLeader>> se desenrola. \"O destino decidiu. O {IntrigueWarVictimPlayerLeader.TitleName} vive... por enquanto.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1252@BODY_FOOTER@REAPERLOST"
msgstr "O <<G:head^n,ReaperUnit>> inclina-se enquanto o jogo de chance de <<o:IntrigueVictimPlayerLeader>> se desenrola. \"O destino decidiu. As {GLOBAL.SoulsLoreConcept.Hyperlink} de {IntrigueWarVictimPlayerLeader.TitleName} e <<o:IntrigueWarVictimPlayerLeader>> {IntrigueWarVictimPlayerRace} são perdidas... E eu vou coletar.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1252@BODY_HEADER"
msgstr "Outro {GLOBAL.LeaderConcept}, {IntrigueWarVictimPlayerLeader.TitleName}, recentemente se retirou para o {GLOBAL.AstralVoidLoreConcept.Hyperlink}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1252@BODY_LORE"
msgstr "Com um suspiro tão cansado quanto eufórico de forma perturbadora, o {IntrigueVictimPlayerLeader.Title} aparece mais uma vez. \"Até mesmo {GLOBAL.GodirLoreConcept.Hyperlink} imploram por suas vidas imortais quando olham no espelho eterno do Vazio.\" Um {ReaperObject} aparece nos dedos ossudos de <<o:IntrigueVictimPlayerLeader>>. \"Diante da Morte, o {IntrigueWarVictimPlayerLeader.Title} escolheu apostar o destino de <<o:IntrigueWarVictimPlayerLeader>> [hyperlink,GLOBAL.SoulsLoreConcept]Alma[/hyperlink]...\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1252@BUTTON_0"
msgstr "Muito bem..."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1252@TITLE"
msgstr "Um Jogo de Destino"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1253@BODY_FOOTER"
msgstr "Você pode reivindicar um objeto da sala do trono antes que ela desmorone completamente."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1253@BODY_HEADER"
msgstr "Você derrotou o {IntrigueVictimPlayerLeader.Title}. O autoproclamado representante da morte o encara friamente enquanto <<p:IntrigueVictimPlayerLeader>> recua para o {GLOBAL.AstralVoidLoreConcept.Hyperlink}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1253@BODY_LORE"
msgstr "Com a derrota do {IntrigueVictimPlayerLeader.Title} e dos {IntrigueVictimPlayerRace}, toda esperança de restaurar {IntriguePreviousRuler.TitleName} é perdida. Os {IntrigueVictimPlayerRace} vagueiam sem seu senhor da morte, e o Império colapsa."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1253@BUTTON_0"
msgstr "Reivindique o trono, como um lembrete do seu poder. [influence/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1253@BUTTON_1"
msgstr "Aproveite [evilact/] a força da morte que se esvai [shadow/] para reunir energia arcana. [mana/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1253@BUTTON_2"
msgstr "Mergulhe no conhecimento da morte [knowledge/] para aprimorar o seu próprio."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1253@TITLE"
msgstr "Morte, Derrotada"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1261@BODY_FOOTER"
msgstr "O {IntrigueVictimPlayerLeader.Title} desafia você para um jogo de chance. De um lado: ressurreição instantânea. Do outro: uma [hyperlink,GLOBAL.WarConcept]Guerra[/hyperlink] com a morte..."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1261@BODY_HEADER"
msgstr "Você foi derrotado e agora se encontra à beira do {GLOBAL.AstralVoidLoreConcept.Hyperlink}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1261@BODY_LORE"
msgstr "Enquanto sente a escuridão puxando você, o {IntrigueVictimPlayerLeader.Title} aparece mais uma vez, flutuando no oceano de escuridão. \"Até os {GLOBAL.GodirLoreConcept.Hyperlink} temem a imagem refletida no espelho eterno do Vazio\", o {IntrigueVictimPlayerLeader.Title} suspira. Um {ReaperObject} aparece nos dedos ossudos de <<o:IntrigueVictimPlayerLeader>>, brilhando na escuridão eterna. \"E você, {PlayerLeader.Name}? Apostaria seu destino por uma chance de reviver?\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1261@BUTTON_0"
msgstr "Aceitar a aposta."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1261@BUTTON_1"
msgstr "Apegue-se à vida e ao reino natural para influenciar as chances."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1261@BUTTON_2"
msgstr "Canalize seu controle sobre a morte para influenciar seu próprio destino."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1261@BUTTON_3"
msgstr "Caos e fortuna são seu forte. Torça as chances a seu favor."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1261@BUTTON_4"
msgstr "Invoque sua fé e zelo para influenciar as chances a seu favor."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1261@BUTTON_5"
msgstr "Fortaleça os laços com seu corpo físico e influencie as chances a seu favor."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1261@BUTTON_6"
msgstr "Este jogo é mágico, e você o controla. Torça os fluxos arcanos a seu favor."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1261@BUTTON_7"
msgstr "Recusar-se a apostar sua alma."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1261@TITLE"
msgstr "Seu Jogo do Destino"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1283@BODY_FOOTER"
msgstr "Enquanto seus soldados se preparam para derrubar o muro, o som de mortos-vivos inquietos pode ser ouvido atrás dele."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1283@BODY_HEADER"
msgstr "Ao entrar na {EventStructure}, {EventHero.FirstName} acha nada de especial, mas não demora muito para encontrar uma parede simples marcada com um símbolo."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1283@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Ao entrar na {EventStructure}, você acha nada de especial, mas não demora muito para encontrar uma parede simples marcada com um símbolo."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1283@BODY_LORE"
msgstr "{EventHero.FirstName} reconhece o símbolo como um conjunto de dados. No entanto, atrás da porta, há apenas um beco sem saída, com uma frase esculpida na parede: \"Cuidado com o túmulo dos ladrões sem nome; [br/] Pois eles negaram até mesmo à morte o que era devido; [br/] Que eles sufocem no pó de seu saque; [br/] E que o descanso da morte sempre os eluda.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1283@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Você reconhece o símbolo como um conjunto de dados. No entanto, atrás da porta, há apenas um beco sem saída, com uma frase esculpida na parede: \"Cuidado com o túmulo dos ladrões sem nome; [br/] Pois eles negaram até mesmo à morte o que era devido; [br/] Que eles sufocem no pó de seu saque; [br/] E que o descanso da morte sempre os eluda.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1283@BUTTON_0"
msgstr "\"Derrubem o muro, vamos subjugar qualquer resistência!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1283@BUTTON_2"
msgstr "Deixar a {EventStructure}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1283@BUTTON_3"
msgstr "Use seu conhecimento de Sombra para enfraquecer o que quer que se mexa dentro antes de abrir."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1283@BUTTON_4"
msgstr "Prepare seu exército [mana/] para o que quer que surja."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1283@TITLE"
msgstr "A {EventStructure}"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1284@BODY_FOOTER"
msgstr " \"Você pode ter essas riquezas, meu {IntrigueItem}. Eu só quero deixar este túmulo.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1284@BODY_HEADER"
msgstr "Você derrotou {EnemyUnit.Name}, que emergiu de uma sala escondida dentro da {EventStructure}. <<Cp:EnemyUnit>> levanta uma mão. \"Eu me rendo... eu me rendo.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1284@BODY_LORE"
msgstr "\"Peço desculpas, a promessa de liberdade me deixou animado. Mas eu nunca fui um lutador, você vê. Mais um vigarista. Eu até enganei a morte em si.\" <<Cp:EnemyUnit>> descobre um objeto mágico. \"Este é {IntrigueItem}, um dado carregado magicamente. Meu maior ativo... que se tornou minha maldição. Eu poderia escapar de qualquer vínculo, quebrar qualquer fechadura... então eles me enterraram, sem fechaduras ou vínculos... sem nem mesmo a morte para escapar.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1284@BUTTON_0"
msgstr "\"Seja livre então, {EnemyUnit.FirstName}. Como Godir, eu decreto que seu castigo acabou.\" [influence/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1284@BUTTON_2"
msgstr "\"Eu poderia usar um ladrão imortal como você do meu lado.\" [unit/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1284@BUTTON_4"
msgstr "\"Eu poderia usar um ladrão imortal como você do meu lado.\" [unit/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1284@BUTTON_5"
msgstr "\"Eu tenho uma nova cripta em {EventCity} com seu nome nela.\" [unit/] [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1284@TITLE"
msgstr "A {EventStructure}: Consequências"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1298@BODY_FOOTER"
msgstr "Folhas fumegantes caem suavemente sobre seu exército enquanto eles evitam a estampida de animais que fogem de seus antigos lares."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1298@BODY_HEADER"
msgstr "Seu exército se aproxima da {EventStructure}, sua coroa de folhas brilhando em vermelho por causa de um fogo abaixo."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1298@BODY_LORE"
msgstr "Dentro, {EventHero.FirstName} vê vários seres Amaldiçoados causando destruição, liderados por um {EnemyUnit}. Eles estão trabalhando duro para colocar as próprias raízes da {WorldTreeStructure} em chamas. Eles parecem se deleitar com a destruição e a calamidade que causam, perseguindo os animais que tentam fugir do inferno."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1298@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Dentro, você vê vários seres Amaldiçoados causando destruição, liderados por um {EnemyUnit}. Eles estão trabalhando duro para colocar as próprias raízes da {WorldTreeStructure} em chamas. Eles parecem se deleitar com a destruição e a calamidade que causam, perseguindo os animais que tentam fugir do inferno."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1298@BUTTON_0"
msgstr "Atacar os inimigos Amaldiçoados!"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1298@BUTTON_2"
msgstr "Fujam da árvore em chamas."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1298@BUTTON_4"
msgstr "Canalize sua proeza mágica [mana/] para proteger seu exército das chamas antes de engajar."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1298@TITLE"
msgstr "A {EventStructure}"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1299@BODY_FOOTER"
msgstr "Com o tempo, esta árvore prevalecerá e se renovará. Suas folhas farfalham, quase como se agradecessem a você."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1299@BODY_HEADER"
msgstr "{EventHero.Name} matou os seres Amaldiçoados que estavam colocando fogo na {WorldTreeStructure}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1299@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você matou os seres Amaldiçoados que estavam colocando fogo na {WorldTreeStructure}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1299@BODY_LORE"
msgstr "Seu exército tenta apagar as chamas, mas as raízes fumegantes levarão muito tempo para se recuperar. À medida que a fumaça se dissipa, no entanto, alguns animais já começam a retornar. O exército amaldiçoado que foi enviado aqui por {IntrigueVictimPlayerLeader.TitleName} não teve sucesso."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1299@BUTTON_0"
msgstr "Convocar reforços [unitprod/] para ajudar a apagar completamente a árvore. [goodact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1299@BUTTON_4"
msgstr "Capturar alguns desses animais para seu exército. [unit/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1299@BUTTON_5"
msgstr "Colete os galhos quebrados para {EventCity}. [production/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1299@TITLE"
msgstr "A {EventStructure}: Consequências"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1334@BODY_FOOTER"
msgstr "\"Prove a mim que você pode ser [hyperlink,GLOBAL.AlignmentConcept]Compassivo[/hyperlink] para com todos que residem neste reino.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1334@BODY_HEADER"
msgstr "\"Agora, para seu julgamento final,\" diz o {IntrigueVictimPlayerLeader.Title}, \"você deve mostrar verdadeira virtude.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1334@BODY_LORE"
msgstr "\"Este reino precisa estar em paz, e a verdadeira paz só pode ser encontrada através da compaixão. Você deve governar e servir. Você deve ferir, mas também ajudar. Você deve julgar, mas também perdoar. Prove a mim que, como um {GLOBAL.GodirLoreConcept.Hyperlink}, você é capaz de incorporar essas virtudes divinas.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1334@BUTTON_0"
msgstr "\"Eu aceito este julgamento.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1334@BUTTON_4"
msgstr "\"Eu recuso este julgamento. Eu decido quem é digno do meu julgamento!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1334@BUTTON_5"
msgstr "\"A história não é escrita pelos benevolentes, mas por aqueles que os pisoteiam!\" [evilact/] [influence/] [happiness/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1334@TITLE"
msgstr "Compaixão Divina"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1335@BODY_FOOTER"
msgstr "\"Meu dever como {IntrigueVictimPlayerLeader.Title} está cumprido. Eu deixo a decisão final sobre o destino de {IntriguePreviousRuler.TitleName} para você.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1335@BODY_HEADER"
msgstr "Você alcançou um alto {GLOBAL.AlignmentConcept.Hyperlink} e provou sua compaixão. Agora, o {IntrigueVictimPlayerLeader.Title} aparece mais uma vez. \"Muito bem.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1335@BODY_LORE"
msgstr "\"Ao mostrar sua benevolência e perdão, você trouxe um senso de paz e [hyperlink,GLOBAL.OrderConcept]Ordem[/hyperlink] para o reino, e provou ser um guardião justo e capaz.\" O {IntrigueVictimPlayerLeader.Title} se curva profundamente, <<o:IntrigueVictimPlayerLeader>> chifres quase tocam o chão. \"Você é digno do título de {GLOBAL.GodirLoreConcept.Hyperlink}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1335@BUTTON_0"
msgstr "\"Parta, então, e permita que {IntriguePreviousRuler.Name} retorne.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1335@BUTTON_1"
msgstr "\"Fique, {IntrigueVictimPlayerLeader.FirstName}. Eu posso usar sua orientação.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1335@BUTTON_2"
msgstr "\"{IntriguePreviousRuler.Name} é indigno. Parta, <<o:IntriguePreviousRuler>> Império é perdido.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1335@TITLE"
msgstr "Compaixão Divina: Consequências"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_669@BUTTON_2"
msgstr "Cesse todas as investigações sobre {IntrigueVictimPlayer}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_672@BUTTON_3"
msgstr "\"Você é fraco demais para ser chamado de Godir, e eu verei seu reinado terminar.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_673@BUTTON_1"
msgstr "\"Você é um covarde e um tolo. Eu garantirei que todos os governantes saibam.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_673@BUTTON_2"
msgstr "\"Compartilhe seu conhecimento [knowledge/] comigo, e tudo será esquecido.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_673@BUTTON_3"
msgstr "\"Meu objetivo era apenas ajudá-lo. Espero fazer isso no futuro.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_674@BUTTON_1"
msgstr "Quebre a maldição em {IntrigueVictimPlayer}, fortaleça seus laços com <<P:IntrigueVictimPlayer>>."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_674@BUTTON_2"
msgstr "Deixe {IntrigueVictimPlayer} como <<p:IntrigueVictimPlayer>> está, mantendo o segredo de {IntrigueCulpritPlayer.FirstName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_674@BUTTON_3"
msgstr "Deixe {IntrigueVictimPlayer} como <<p:IntrigueVictimPlayer>> está, exija um suborno [gold/] pelo seu silêncio."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_675@BUTTON_1"
msgstr "Quebre a maldição em {IntrigueVictimPlayer}, reclame o {EventItem} e seu conhecimento para você."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_675@BUTTON_2"
msgstr "Destrua o {EventItem}, liberte {IntrigueVictimPlayer}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_730@BODY_FOOTER"
msgstr "Parece que o {IntriguePreviousRuler.Title} dos {IntrigueVictimPlayerRace} foi... substituído. Como isso poderia ter acontecido com <<P:IntriguePreviousRuler>>? Isso é um perigo... ou uma oportunidade para você?"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_730@BODY_HEADER"
msgstr "Enquanto você reflete sobre o reino, é subitamente contatado por ninguém menos que um {BalorUnit}, que agora parece governar os {IntrigueVictimPlayerRace}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_730@BODY_LORE"
msgstr "Antes que você possa exigir uma explicação, o novo {IntrigueVictimPlayerLeader.Title} sorri. \"Mortais e {GLOBAL.GodirLoreConcept.Hyperlink}! O Império de {IntriguePreviousRuler.Name} está sob novo comando. Curve-se a mim, o grande {IntrigueVictimPlayerLeader.Name}, e desespere, pois a ira e a fúria de {GLOBAL.ObbadothLoreConcept.Hyperlink} chegaram!\" O sorriso de <<Co:IntrigueVictimPlayerLeader>> fica mais sombrio enquanto <<p:IntrigueVictimPlayerLeader>> corta a conexão."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_730@BUTTON_0"
msgstr "O tempo dirá."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_730@TITLE"
msgstr "Um Anúncio Perturbador"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_745@BODY_FOOTER"
msgstr "Salvar as pessoas do acampamento de refugiados próximo pode ser sua única maneira de aprender mais sobre o {IntrigueVictimPlayerLeader.TitleName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_745@BODY_HEADER"
msgstr "Você muda seu foco do cidadão caído dos {IntrigueVictimPlayerRace}, em direção a sons de luta próximos."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_745@BODY_LORE"
msgstr "Você percebe que é um acampamento de refugiados que fugiram do Império do {IntrigueVictimPlayerLeader.Title}. Eles são emboscados por forças demoníacas e agora lutam por suas vidas."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_745@BUTTON_0"
msgstr "Envie um grupo para salvar os refugiados."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_745@BUTTON_1"
msgstr "Recusar-se a tomar qualquer parte adicional nisso."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_745@TITLE"
msgstr "Tomada Fiend: Refúgio"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_746@BODY_FOOTER"
msgstr "Se você deseja investigar mais, o {EventStructure} é seu próximo alvo."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_746@BODY_HEADER"
msgstr "Você tem uma nova pista em suas investigações sobre o {IntrigueVictimPlayerLeader.Title}. <<Cp:IntrigueVictimPlayerLeader>> foi convocado em um {EventStructure}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_746@BODY_LORE"
msgstr "Investigar o {EventStructure} pode fornecer mais pistas sobre como parar o {IntrigueVictimPlayerLeader.Title} e descobrir quem mais está envolvido... ou encontrar maneiras de lucrar com essa situação."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_746@BUTTON_0"
msgstr "Investigar e destruir o {EventStructure}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_746@BUTTON_1"
msgstr "Cessar investigações e usar qualquer evidência coletada contra {IntrigueVictimPlayer.Name}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_746@TITLE"
msgstr "Convocação Infernal"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_747@BODY_FOOTER"
msgstr "{IntrigueVictimPlayerLeader.TitleName} rosna, \"Cesse suas investigações ou eu lhe mostrarei o que acontece quando você brinca com fogo infernal!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_747@BODY_HEADER"
msgstr "Após derrotar qualquer resistência no Círculo Ritualístico, suas tropas e estudiosos buscam a área envolvida no aparecimento de {IntrigueVictimPlayerLeader.TitleName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_747@BODY_LORE"
msgstr "\"Este foi de fato o local de uma convocação poderosa, meu {PlayerLeader.Title}\", diz seu estudioso. \"Runas infernais retratam um acordo entre uma convocação e banimento para {GLOBAL.ObbadothLoreConcept.Hyperlink}, e de um Contrato arcano entre o {BalorUnit} e ninguém menos que {IntrigueCulpritPlayerLeader.TitleName}!\"[br/][br/]Pouco depois, você é contatado pelo {IntrigueVictimPlayerLeader.Title} <<r:IntrigueVictimPlayerLeader>>. \"Então o tolo {GLOBAL.GodirLoreConcept.Hyperlink} insiste em meter o nariz <<o:PlayerLeader>> em nossos assuntos.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_747@BUTTON_0"
msgstr "\"Eu não serei ameaçado a me submeter!\" [influence/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_747@TITLE"
msgstr "Convocação Infernal: Consequências"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_753@BUTTON_1"
msgstr "\"Fogo? Você saberá o que é fogo quando eu terminar com você!\" [chaosboon/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_753@BUTTON_2"
msgstr "\"Eu vou te mandar de volta para Obbadoth, criatura imunda!\" [orderboon/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_753@BUTTON_3"
msgstr "\"Nem mesmo o fogo infernal pode derreter minhas muralhas. Teste-me, demônio!\" [materiumboon/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_753@BUTTON_4"
msgstr "\"Você pode ameaçar queimar e destruir, mas a vida sempre prevalece!\" [natureboon/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_753@BUTTON_5"
msgstr "\"Você não passa de uma convocação falha. Enfrente-me, e eu resolverei essa anomalia.\" [astralboon/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_753@BUTTON_6"
msgstr "\"Até o fogo morre quando é sufocado. Eu vou te ver passar fome.\" [shadowboon/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_753@BUTTON_7"
msgstr "\"Vou considerar isso...\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_754@BODY_FOOTER"
msgstr "\"Se você é o salvador que os {IntrigueVictimPlayerRace} buscam, eu vou marcar um local no seu mapa onde você pode encontrar meus companheiros.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_754@BODY_HEADER"
msgstr "\"Meu {PlayerLeader.Title}, esperamos que você queira ouvir isso.\" Seus guardas trazem um {IntrigueVictimUnit} dos {IntrigueVictimPlayerRace}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_754@BODY_LORE"
msgstr "<<Cp:IntrigueVictimUnit>> se arrasta diante de você, <<o:IntrigueVictimUnit>> roupas rasgadas e sujas. \"Eu represento um grupo de refugiados dos {IntrigueVictimPlayerRace}. Nosso {IntriguePreviousRuler.Title} sucumbiu a forças além das nossas, e agora o {IntrigueVictimPlayerLeader.Title} e <<o:IntrigueVictimPlayerLeader>> servos atormentam nosso Império. Alguns de nós sabem mais sobre o que aconteceu, mas por nossa própria segurança, não fui informado dos detalhes.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_754@BUTTON_0"
msgstr "Enviar um grupo para encontrar os refugiados."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_754@BUTTON_1"
msgstr "Recusar-se a se envolver nos assuntos de outros Impérios."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_754@TITLE"
msgstr "Tomada Fiendíaca"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_755@BODY_FOOTER"
msgstr "O cidadão desaba no chão, incapaz de compartilhar mais informações. Mais sons de luta podem ser ouvidos nas proximidades..."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_755@BODY_HEADER"
msgstr "Você enviou um séquito para encontrar o \"Cidadão Preocupado\" que entrou em contato com você sobre o {IntrigueVictimPlayerLeader.Title} dos {IntrigueVictimPlayerRace}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_755@BODY_LORE"
msgstr "Não muito depois de chegar, um <<IntrigueVictimUnit{homem/mulher}>> emerge, curvando-se profundamente. \"Salve, grande {PlayerLeader.Title}. Devo ser rápido, pois temo ter sido seguido. Nosso {IntriguePreviousRuler.Title} foi banido e substituído por um Demônio vil de {GLOBAL.ObbadothLoreConcept.Hyperlink}. Eu sei o local-\" Antes que <<p:IntrigueVictimUnit>> possa terminar <<o:IntrigueVictimUnit>> frase, <<p:IntrigueVictimUnit>> é atingido por uma garra infernal."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_755@BUTTON_0"
msgstr "Mude seu foco para os sons de luta nas proximidades."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_755@TITLE"
msgstr "Tomada Fiendíaca: Cidadão Preocupado"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_771@BODY_FOOTER"
msgstr "\"Há poder e riquezas escondidos por trás das artes que outros consideram 'proibidas'. Afaste-se agora, e podemos fazer valer a pena para você...\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_771@BODY_HEADER"
msgstr "Você descobriu que {IntrigueCulpritPlayerLeader.TitleName} convocou e assinou um Contrato Fiendíaco com o {IntrigueVictimPlayerLeader.Title}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_771@BODY_LORE"
msgstr "O Contrato é a chave para o poder compartilhado deles. Através de seus espiões e contatos, você descobre que ele está escondido em {EventCity}. Antes que você possa ponderar mais, você é contactado por ninguém menos que {IntrigueCulpritPlayerLeader.Name} <<r:IntrigueCulpritPlayerLeader>>. \"Não sejamos apressados, {PlayerLeader.FirstName}. Certamente você vê o potencial em aliados como eu e o {IntrigueVictimPlayerLeader.Title}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_771@BUTTON_0"
msgstr "\"Eu vou acabar com seu esquema, {IntrigueCulpritPlayerLeader.FirstName}!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_771@BUTTON_1"
msgstr "\"Muito bem. Eu vou parar de investigar você, por uma recompensa.\" [evilact/] [gold/] [knowledge/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_771@TITLE"
msgstr "Lidar com o {IntrigueVictimPlayerLeader.Title}"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_772@BODY_FOOTER"
msgstr "O Contrato em si é um poderoso artefato mágico. Com ele, você poderia alterar o destino deste reino..."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_772@BODY_HEADER"
msgstr "Dentro do principal bastião de {EventCity}, você reivindica o Contrato do {IntrigueVictimPlayerLeader.Title}. Seu significado completo se torna claro para você."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_772@BODY_LORE"
msgstr "Após uma \"troca\" forçada entre um ser de {GLOBAL.ObbadothLoreConcept.Hyperlink} e um {GLOBAL.LeaderConcept.Hyperlink} deste reino, o ser convocado recebe poderes de {GLOBAL.GodirLoreConcept.Hyperlink} do convocador e eles permanecerão em uma {GLOBAL.DSAllianceConcept.Hyperlink}, até que o reino seja conquistado. Então, o ser convocado será libertado para invadir outros reinos com <<o:IntrigueVictimPlayerLeader>> novos escravos, deixando as cinzas deste reino para o convocador: {IntrigueCulpritPlayerLeader.FirstName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_772@BUTTON_0"
msgstr "Destrua o Contrato e a Aliança Infernal, banindo o {IntrigueVictimPlayerLeader.Title} e trazendo de volta {IntriguePreviousRuler.TitleName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_772@BUTTON_1"
msgstr "Use seu conhecimento [chaosboon/] do Contrato, junte-se à Aliança entre {IntrigueVictimPlayerLeader.FirstName} e {IntrigueCulpritPlayerLeader.FirstName}. [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_772@BUTTON_2"
msgstr "Mantenha o Contrato, use-o para reclamar poderes infernais [knowledge/] [mana/] para você mesmo! [chaosboon/] [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_772@TITLE"
msgstr "Lide com o {IntrigueVictimPlayerLeader.Title}: Consequências"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_781@BODY_FOOTER"
msgstr "\"Obrigado, {PlayerLeader.TitleName}. Agora que retornei, devo reparar os danos causados ao meu {IntrigueVictimPlayerRace}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_781@BODY_HEADER"
msgstr "Através de uma impressionante proeza Godir, você bane o {BalorUnit} que havia usurpado {IntrigueVictimPlayerLeader.TitleName}, e traz de volta {IntrigueVictimPlayerLeader.FirstName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_781@BODY_LORE"
msgstr "Não muito tempo depois, você é contactado por {IntrigueVictimPlayerLeader.Name} <<r:IntrigueVictimPlayerLeader>>. \"Entendo que estou em dívida com você, {PlayerLeader.TitleName}, o mínimo que lhe devo é o meu lado desta história. Durante um tempo de descanso, fui subitamente banido para {GLOBAL.ObbadothLoreConcept.Hyperlink} através de magias malignas, após as quais só conheci fogo e conflito. Temia nunca mais retornar, até que você reverteu as magias que me baniram.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_781@BUTTON_0"
msgstr "\"Sejamos aliados, então, e unamo-nos em nossa busca pela vitória!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_781@BUTTON_1"
msgstr "\"Recebo minha recompensa em ouro [gold/] e mana [mana/]. Sua vingança é sua.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_781@BUTTON_2"
msgstr "\"Sua negligência custou seu direito sobre este reino. Torne-se meu vassalo em vez disso.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_781@BUTTON_3"
msgstr "\"Você é fraco demais para ser chamado de Godir, e eu veria seu reinado terminar.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_781@TITLE"
msgstr "Dívida Infernal"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_783@BODY_FOOTER"
msgstr "Você tem a oportunidade de forçar uma bênção de {IntrigueVictimPlayerLeader.FirstName} ou {IntrigueCulpritPlayerLeader.FirstName}. O que você escolhe?"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_783@BODY_HEADER"
msgstr "Você altera o Contrato entre {IntrigueVictimPlayerLeader.FirstName} e {IntrigueCulpritPlayerLeader.FirstName}, adicionando-se ao acordo inquebrável."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_783@BODY_LORE"
msgstr "{IntrigueVictimPlayerLeader.FirstName} e {IntrigueCulpritPlayerLeader.FirstName} não têm escolha a não ser aceitar sua {GLOBAL.DSAllianceConcept.Hyperlink}, e você também não. Com sua assinatura, seus destinos estão selados: Você alcançará a vitória neste reino juntos, ou compartilhará um destino no {GLOBAL.AstralVoidLoreConcept.Hyperlink}. No entanto, você não é tolo. Você percebe que pode alterar o Contrato levemente, para ganhar mais com este Pacto Diabólico."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_783@BUTTON_0"
msgstr "Force {IntrigueVictimPlayerLeader.FirstName} a compartilhar conhecimento demoníaco."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_783@BUTTON_1"
msgstr "Force um tributo de ouro [gold/] e magia [mana/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_783@BUTTON_2"
msgstr "Reclame uma hoste de soldados Obbadothan [unit/] ao seu lado."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_783@BUTTON_3"
msgstr "Recuse-se a abusar do contrato."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_783@TITLE"
msgstr "Três é uma Festa"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_784@BODY_FOOTER"
msgstr "O poder dentro do Contrato permite uma grande proeza de magia. O que você escolhe?"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_784@BODY_HEADER"
msgstr "Você reclama o Contrato entre {IntrigueVictimPlayerLeader.FirstName} e {IntrigueCulpritPlayerLeader.FirstName} e canaliza seu poder."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_784@BODY_LORE"
msgstr "O Contrato pulsa com energias [hyperlink,GLOBAL.ChaosConcept]Caóticas[/hyperlink], com o poder de vincular até mesmo {GLOBAL.GodirLoreConcept.Hyperlink} aos acordos escritos dentro dele. Você percebe que pode canalizar essa proeza mágica bruta para si mesmo."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_784@BUTTON_0"
msgstr "Invocar uma hoste de soldados Obbadothan [unit/] ao seu lado."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_784@BUTTON_1"
msgstr "Canalize seus poderes para reclamar segredos arcanos."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_784@BUTTON_2"
msgstr "Consuma seu poder diretamente para aprimorar a si mesmo e ao seu povo."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_784@BUTTON_3"
msgstr "\"Com este Contrato como prova, todo o reino saberá o que você fez.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_784@TITLE"
msgstr "Conhecimento Proibido"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_791@BODY_FOOTER"
msgstr "{IntrigueWarVictimPlayerLeader.TitleName} está indignado, mas nada pode ser feito sobre a declaração de {IntrigueVictimPlayerLeader.FirstName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_791@BODY_HEADER"
msgstr "{IntrigueVictimPlayerLeader.FirstName}, o {BalorUnit} que atualmente governa os {IntrigueVictimPlayerRace}, tem outro anúncio a fazer."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_791@BODY_LORE"
msgstr "\"Que fique conhecido que o chamado '{IntrigueWarVictimPlayerLeader.Title}' {IntrigueWarVictimPlayerLeader.FirstName} não passa de um fraco que em breve será um grão de cinza no reino. Eu, o grande {IntrigueVictimPlayerLeader.Name}, {IntrigueVictimPlayerLeader.Title}, derrubarei <<P:IntrigueWarVictimPlayerLeader>> eu mesmo!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_791@BUTTON_0"
msgstr "Que assim seja."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_791@TITLE"
msgstr "Declaração Súbita"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_792@BODY_FOOTER"
msgstr "\"Como refugiados, nos falta os meios para desafiar o {IntrigueVictimPlayerLeader.Title}. E assim deixamos este conhecimento, e o destino do nosso povo, em suas mãos.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_792@BODY_HEADER"
msgstr "Não muito depois que sua comitiva chega, um civil dos {IntrigueVictimPlayerRace} emerge. \"Salve, grande {PlayerLeader.Title}. Fico feliz que nossa mensagem tenha chegado até você.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_792@BODY_LORE"
msgstr "\"Eu fazia parte da corte do nosso {IntriguePreviousRuler.Title}, antes que <<p:IntriguePreviousRuler>> fosse banido e substituído por um Demônio vil de {GLOBAL.ObbadothLoreConcept.Hyperlink}. Eu fugi, pois conheço a localização da {EventStructure} onde o {IntrigueVictimPlayerLeader.Title} foi convocado. Deve conter a resposta sobre como isso aconteceu. Eu temo que isso não tenha sido obra de um mero cultista.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_792@BUTTON_0"
msgstr "\"Os {IntrigueVictimPlayerRace} em fuga são bem-vindos no meu Império.\" [population/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_792@BUTTON_1"
msgstr "\"Sua confiança em mim foi mal colocada. Entregue seus pertences [gold/], ou morra.\" [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_792@BUTTON_2"
msgstr "\"Manterei isso em mente.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_792@TITLE"
msgstr "Tomada Diabólica: Cidadão Preocupado"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_831@BODY_FOOTER"
msgstr "Em meio ao pânico, os {IntrigueVictimPlayerRace} podem sentir o [hyperlink,GLOBAL.ChaosConcept]Caos[/hyperlink] se dispersar. Qual é o seu ato final neste capítulo infernal?"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_831@BODY_HEADER"
msgstr "Você derrotou o {IntrigueVictimPlayerLeader.Title}. Os {IntrigueVictimPlayerRace} se dispersam, libertos do terror de seu mestre infernal, mas sem seu antigo {GLOBAL.GodirLoreConcept.Hyperlink}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_831@BODY_LORE"
msgstr "O {BalorUnit} ruge enquanto <<p:IntrigueVictimPlayerLeader>> é banido de volta para {GLOBAL.ObbadothLoreConcept.Hyperlink}, deixando cidades arruinadas no rastro de <<o:IntrigueVictimPlayerLeader>>. Sem o conhecimento ou artefato que convocou <<P:IntrigueVictimPlayerLeader>>, no entanto, você não pode reinstaurar {IntriguePreviousRuler.TitleName}. Esperançosamente, <<p:IntriguePreviousRuler>> encontre <<o:IntriguePreviousRuler>> seu próprio caminho de volta para {GLOBAL.MagehavenLoreConcept.Hyperlink}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_831@BUTTON_0"
msgstr "Canalize o poder caótico fugaz para reivindicar segredos arcanos."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_831@BUTTON_1"
msgstr "Convoque um exército de soldados Obbadothanos [unit/] para o seu lado."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_831@BUTTON_2"
msgstr "Receba os {IntrigueVictimPlayerRace} em fuga em suas cidades. [population/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_831@TITLE"
msgstr "O {IntrigueVictimPlayerLeader.Title}, Derrotado"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_832@BODY_FOOTER"
msgstr "O próprio Contrato é um poderoso artefato mágico. Com ele, você poderia alterar o destino deste reino..."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_832@BODY_HEADER"
msgstr "Você derrotou {IntrigueCulpritPlayerLeader.TitleName}. No caos da derrota de <<o:IntrigueCulpritPlayerLeader>>, você encontra um Contrato Infernal entre <<P:IntrigueCulpritPlayerLeader>> e {IntrigueVictimPlayerLeader.Name}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_832@BODY_LORE"
msgstr "{IntrigueCulpritPlayerLeader.FirstName} convocou um {BalorUnit} de {GLOBAL.ObbadothLoreConcept.Hyperlink}, banindo e substituindo {IntriguePreviousRuler.TitleName}. O Contrato afirma ainda que <<p:IntrigueCulpritPlayerLeader>> e o {IntrigueVictimPlayerLeader.Title} permanecerão em uma {GLOBAL.DSAllianceConcept.Hyperlink} até que o reino seja conquistado. Com a derrota de {IntrigueCulpritPlayerLeader.FirstName}, o Contrato torna-se nulo..."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_832@BUTTON_0"
msgstr "Destrua o Contrato e a Aliança Infernal, banindo o {IntrigueVictimPlayerLeader.Title} e trazendo de volta {IntriguePreviousRuler.TitleName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_832@BUTTON_1"
msgstr "Mantenha o Contrato, use-o para reclamar poderes infernais [knowledge/] [mana/] para você mesmo! [chaosboon/] [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_832@TITLE"
msgstr "Invocador Infernal, Derrotado"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_844@BODY_FOOTER"
msgstr "Não é anormal para um {GLOBAL.LeaderConcept} se retirar temporariamente para o Vazio. No entanto, para alguém governar em sua ausência temporária, é certamente... único."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_844@BODY_HEADER"
msgstr "{IntriguePreviousRuler.TitleName} recentemente se retirou para o {GLOBAL.AstralVoidLoreConcept.Hyperlink}. Na <<o:IntriguePreviousRuler>> ausência, um {IntrigueVictimPlayerLeader.Title} introduz <<r:IntrigueVictimPlayerLeader>>."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_844@BODY_LORE"
msgstr "\"Bem-vindo. Nosso grande {IntriguePreviousRuler.TitleName} está atualmente... indisponível, e enquanto investigamos a <<o:IntriguePreviousRuler>> ausência, o peso do nosso orgulhoso {GLOBAL.EmpireConcept} caiu sobre meus ombros. Fique tranquilo, encontraremos o responsável pelo destino do nosso grandioso [hyperlink,GLOBAL.LeaderConcept]Governante[/hyperlink], e a justiça será feita.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_844@BUTTON_0"
msgstr "Sem escolha a não ser ver como isso se desenvolve."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_844@TITLE"
msgstr "Uma Nova Regência"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_862@BODY_FOOTER"
msgstr "Você poderia investigar as magias que prendem {IntriguePreviousRuler} no {GLOBAL.AstralVoidLoreConcept.Hyperlink} para ajudar <<P:IntriguePreviousRuler>>... Ou usar essas descobertas para sua própria vantagem."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_862@BODY_HEADER"
msgstr "O {IntrigueVictimUnit} concorda. \"Obrigado, {PlayerLeader.TitleName}. Eu compartilharei tudo o que sei sobre o desaparecimento do nosso {IntriguePreviousRuler.Title}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_862@BODY_LORE"
msgstr "\"Nosso {IntriguePreviousRuler.Title} foi banido para o {GLOBAL.AstralVoidLoreConcept.Hyperlink}. Normalmente <<p:IntriguePreviousRuler>> retornaria ao <<o:IntriguePreviousRuler>> trono logo depois. Agora, no entanto, algo prende <<P:IntriguePreviousRuler>> à escuridão. Há magia envolvida, e tenho certeza de que isso é <<g:doing^n,IntrigueVictimPlayerLeader>>... Mas me falta o poder para investigar e provar isso.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_862@BUTTON_0"
msgstr "\"Eu investigarei [knowledge/] essas correntes arcana.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_862@BUTTON_1"
msgstr "\"Pensando melhor, estou muito ocupado para isso.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_862@TITLE"
msgstr "Correntes de Magia"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_863@BODY_FOOTER"
msgstr "Seu estudioso concorda. \"Encontramos evidências de que o {IntrigueVictimPlayerLeader.Title} capturou {IntriguePreviousRuler.Name} em uma Gaiola de Ligação para aumentar o <<o:IntrigueVictimPlayerLeader>> poder.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_863@BODY_HEADER"
msgstr "A investigação sobre a causa da <<g:prolonged absence^n,IntriguePreviousRuler>> foi concluída. Seus estudiosos e o {IntrigueVictimUnit} que se juntou a você apresentam suas descobertas."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_863@BODY_LORE"
msgstr "\"É pior do que eu esperava, ó {PlayerLeader.Title}. Meu {IntriguePreviousRuler.Title} não está apenas preso ao {GLOBAL.AstralVoidLoreConcept.Hyperlink}, mas as energias que o prendem convergem em nossa capital {IntrigueVictimPlayerCapital}. A natureza das magias envolvidas e a súbita ascensão de <<G:power^n,IntrigueVictimPlayerLeader>> implicam fortemente que <<p:IntrigueVictimPlayerLeader>> está usando uma {GLOBAL.CageOfBindingLoreConcept.Hyperlink} para sugar a energia do {GLOBAL.GodirLoreConcept.Hyperlink}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_863@BUTTON_0"
msgstr "\"Muito preocupante. Continue...\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_863@TITLE"
msgstr "Correntes de Magia: Consequências"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_873@BODY_FOOTER"
msgstr "\"Não estou mais seguro em {IntrigueVictimPlayerCapital}. Ofereço minhas habilidades como estudioso ao {GLOBAL.LeaderConcept} que visa provar a culpa de <<o:IntrigueVictimPlayerLeader>>.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_873@BODY_HEADER"
msgstr "Pouco depois que o {IntrigueVictimPlayerLeader.Title} ascendeu ao poder, seus guardas trazem um {IntrigueVictimUnit} da {IntrigueVictimPlayerRace}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_873@BODY_LORE"
msgstr "\" {PlayerLeader.TitleName}, obrigado por me ouvir. Venho de {IntrigueVictimPlayerCapital}. Quando nosso {IntriguePreviousRuler.Title} foi lançado no {GLOBAL.AstralVoidLoreConcept.Hyperlink}, {IntrigueVictimPlayerLeader.FirstName} assumiu o controle do nosso {GLOBAL.EmpireConcept}. Conheço <<P:IntrigueVictimPlayerLeader>> como um esquemático que não parará até obter o poder de um {GLOBAL.GodirLoreConcept.Hyperlink}. Tenho certeza de que <<p:IntrigueVictimPlayerLeader>> está por trás da prolongada ausência do nosso {IntriguePreviousRuler.Title}, mas me falta a prova.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_873@BUTTON_0"
msgstr "\"Conte-me mais.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_873@BUTTON_1"
msgstr "\"Não tenho interesse na política e no drama de outros Impérios.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_873@TITLE"
msgstr "Ausência Suspeita"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_877@BODY_FOOTER"
msgstr "\"Antes de poder quebrar a Gaiola que mantém {IntriguePreviousRuler.Title}, você precisará coletar os componentes necessários para remover quaisquer armadilhas.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_877@BODY_HEADER"
msgstr "Você descobriu que {IntriguePreviousRuler.TitleName} está sendo mantido em uma [hyperlink,GLOBAL.CageOfBindingLoreConcept]Gaiola de Ligação[/hyperlink] em {IntrigueVictimPlayerCapital}, usada como fonte de poder para o {IntrigueVictimPlayerLeader.Title}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_877@BODY_LORE"
msgstr "Usar esse método controverso—alguns até diriam proibido—para roubar poder de um [hyperlink,GLOBAL.GodirLoreConcept]Godir[/hyperlink] seria motivo de guerra para muitos. \"No entanto, um assalto direto seria arriscado,\" o estudioso te avisa. \"{IntrigueVictimPlayerLeader.FirstName} não é tolo, <<p:IntrigueVictimPlayerLeader>> terá amarrado a Gaiola a <<r:IntrigueVictimPlayerLeader>>. Devemos primeiro quebrar essa linha de vida antes de podermos libertar meu {IntriguePreviousRuler.Title}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_877@BUTTON_0"
msgstr "\"Eu reclamarei esses locais.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_877@BUTTON_1"
msgstr "\"Eu não tenho tempo para isso.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_877@BUTTON_4"
msgstr "\"Eu usarei todo esse conhecimento [knowledge/] para meu próprio ganho em vez disso...\" [influence/] [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_877@TITLE"
msgstr "Sifão Arcano"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_878@BODY_FOOTER"
msgstr "\"Não há [hyperlink,GLOBAL.CageOfBindingLoreConcept]\"Gaiola\"[/hyperlink] em {IntrigueVictimPlayerCapital}, mas sua preocupação com meu povo é louvável. Cesse esse empreendimento inútil, e poderemos compartilhar nossa prosperidade.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_878@BODY_HEADER"
msgstr "Você coletou os ingredientes necessários para quebrar a [hyperlink,GLOBAL.CageOfBindingLoreConcept]Gaiola de Ligação[/hyperlink] que mantém {IntriguePreviousRuler.TitleName} em {IntrigueVictimPlayerCapital}. Antes que você possa planejar seus próximos passos, no entanto..."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_878@BODY_LORE"
msgstr "Você é abordado por ninguém menos que {IntrigueVictimPlayerLeader.TitleName} <<r:IntrigueVictimPlayerLeader>>. \"{PlayerLeader.TitleName}. Chegou ao meu conhecimento que você aceita conselhos de um fugitivo conhecido de nosso Império. <<Cp:IntrigueVictimUnit>> é um fraudador delusional, que te faz perseguir uma fantasia caluniosa para distraí-lo dos esquemas que <<p:IntrigueVictimUnit>> planeja dentro do seu [hyperlink,GLOBAL.EmpireConcept]Império[/hyperlink].\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_878@BUTTON_0"
msgstr "\"Você não passa de um usurpador, e eu verei você cair!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_878@BUTTON_7"
msgstr "\"Muito bem. Eu fingirei acreditar em você.\" [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_878@BUTTON_8"
msgstr "\"Meu silêncio pode ser comprado pelo preço de ouro [gold/] e poder.\" [influence/] [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_878@TITLE"
msgstr "Sifão Arcano: Consequências"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_885@BODY_FOOTER"
msgstr "A Gaiola de Ligação em {IntrigueVictimPlayerCapital} agora pode ser abordada. Tome a cidade para alcançar a Gaiola, e {IntriguePreviousRuler.TitleName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_885@BODY_HEADER"
msgstr "À medida que <<g:face^n,IntrigueVictimPlayerLeader>> cai, você corta a conexão com <<P:IntrigueVictimPlayerLeader>> e se volta para o {IntrigueVictimUnit} e seus estudiosos."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_885@BODY_LORE"
msgstr "\"Fico aliviado que você não tenha caído nas <<g:words^p,IntrigueVictimPlayerLeader>>, ó {PlayerLeader.Title},\" diz o {IntrigueVictimUnit}. \"Poucos podem resistir ao apelo do poder... Mas eu divago. Seus estudiosos e eu preparamos um ritual de disrupção que enfraquecerá a ligação entre {IntrigueVictimPlayerLeader.FirstName} e a [hyperlink,GLOBAL.CageOfBindingLoreConcept]Gaiola de Ligação[/hyperlink] em {IntrigueVictimPlayerCapital}.\" Você gesticula em aprovação, e o ritual começa."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_885@BUTTON_0"
msgstr "\"Chamem os estandartes!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_885@BUTTON_1"
msgstr "\"Pensando melhor, eu aceitarei <<g:deal^n,IntrigueVictimPlayerLeader>>.\" [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_885@TITLE"
msgstr "{IntriguePreviousRuler.Title} em uma Gaiola"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_886@BODY_FOOTER"
msgstr "Diante de você está a [hyperlink,GLOBAL.CageOfBindingLoreConcept]Gaiola de Ligação[/hyperlink] com {IntriguePreviousRuler.TitleName} em um sono eterno. O poder emanado é quase intoxicante..."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_886@BODY_HEADER"
msgstr "Você capturou com sucesso {EventCity}. Como um [hyperlink,GLOBAL.GodirLoreConcept]Godir[/hyperlink], não leva muito tempo para localizar a fonte de <<g:powers^p,IntrigueVictimPlayerLeader>>."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_886@BODY_LORE"
msgstr "Despojado do poder de <<o:IntrigueVictimPlayerLeader>> como um {IntrigueVictimPlayerLeader.Title} e incapaz de te parar, {IntrigueVictimPlayerLeader.FirstName} não tem escolha a não ser assistir enquanto você força seu caminho através de <<g:bastion^n,EventCity>>. No fundo, você é assaltado pelos poderes brutos do {IntriguePreviousRuler.Title} adormecido enquanto eles são drenados por meio de um elaborado constructo de ritual, sigilos arcanos e máquina."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_886@BUTTON_0"
msgstr "Quebrar a Gaiola de Ligação, libertar {IntriguePreviousRuler.TitleName}. [influence/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_886@BUTTON_7"
msgstr "Manter a Gaiola de Ligação, derrotar o Império de {IntriguePreviousRuler.TitleName} e drenar [mana/] o poder de <<o:IntriguePreviousRuler>>. [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_886@TITLE"
msgstr "{IntriguePreviousRuler.Title} em uma Gaiola: Consequências"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_889@BODY_FOOTER"
msgstr "\"Todos os Governantes, cuidado, {PlayerLeader.TitleName} capturou nosso amado {IntriguePreviousRuler.Title} em uma Gaiola de Ligação!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_889@BODY_HEADER"
msgstr "O recém-nomeado {IntrigueVictimPlayerLeader.TitleName} dos {IntrigueVictimPlayerRace} tem um anúncio a fazer."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_889@BODY_LORE"
msgstr "\"Nossas investigações sobre o prolongado desaparecimento de nosso grande {IntriguePreviousRuler.TitleName} nos levaram a uma conclusão preocupante. Não foi ninguém menos que {IntriguePlayerLeader.TitleName} quem colocou <<P:IntriguePreviousRuler>> em uma [hyperlink,GLOBAL.CageOfBindingLoreConcept]Gaiola de Ligação[/hyperlink]. Afinal, quem mais além de um [hyperlink,GLOBAL.GodirLoreConcept]Godir[/hyperlink] poderia possuir o poder de criar uma Gaiola como essa? Não foi {PlayerLeader.FirstName} <<r:PlayerLeader>> quem recentemente investigou essa magia proibida?\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_889@BUTTON_0"
msgstr "\"Mentiras e difamação!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_889@TITLE"
msgstr "Acusação Repentina"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_894@BODY_FOOTER"
msgstr "\"Você tem minha gratidão, {PlayerLeader.TitleName}. Nomeie sua recompensa e você a terá.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_894@BODY_HEADER"
msgstr "Através de uma impressionante proeza de [hyperlink,GLOBAL.GodirLoreConcept]Godir[/hyperlink], você quebra a [hyperlink,GLOBAL.CageOfBindingLoreConcept]Gaiola de Ligação[/hyperlink] no centro de {IntrigueVictimPlayerCapital} e libera {IntrigueVictimPlayerLeader.FirstName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_894@BODY_LORE"
msgstr "Mesmo no estado enfraquecido de <<o:IntrigueVictimPlayerLeader>>, {IntrigueVictimPlayerLeader} retorna à <<o:IntrigueVictimPlayerLeader>> regalia original. <<Cp:IntrigueVictimPlayerLeader>> grita ordens, e logo depois o antigo {IntriguePreviousRuler.Title} é capturado e arrastado para as prisões de {IntrigueVictimPlayerCapital}. {IntrigueVictimPlayerLeader.TitleName} vira-se para você. \"Você me salvou de um destino pior que a morte. Não sou estranho ao [hyperlink,GLOBAL.AstralVoidLoreConcept]Vazio Astral[/hyperlink], mas uma [hyperlink,GLOBAL.CageOfBindingLoreConcept]Gaiola de Ligação[/hyperlink] é uma tortura que não desejaria nem ao meu maior inimigo.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_894@BUTTON_0"
msgstr "\"Precisarei de um aliado neste reino. Junte-se a mim, para a vitória!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_894@BUTTON_1"
msgstr "\"Compartilhe seus recursos [gold/] [mana/] [food/] [knowledge/] com minha cidade {EventCity}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_894@BUTTON_2"
msgstr "\"Você não pode ser confiado para governar. Torne-se meu vassalo em vez disso.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_894@BUTTON_3"
msgstr "\"Você é fraco demais para ser chamado de Godir, e eu verei seu reinado terminar.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_894@TITLE"
msgstr "O Retorno do {IntrigueVictimPlayerLeader.Title}"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_895@BODY_FOOTER"
msgstr "Seu Império exige sua atenção. O que você faz antes de deixar {IntriguePreviousRuler.TitleName} para <<o:IntriguePreviousRuler>> destino como uma fonte arcana de poder?"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_895@BODY_HEADER"
msgstr "Enquanto você está diante da [hyperlink,GLOBAL.CageOfBindingLoreConcept]Gaiola de Ligação[/hyperlink] que segura {IntriguePreviousRuler.TitleName}, o poder drenado quase o sobrecarrega."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_895@BODY_LORE"
msgstr "Por sua ordem, o antigo {IntrigueVictimPlayerLeader.Title} dos {IntrigueVictimPlayerRace} é arrastado por uma multidão enfurecida. O {IntrigueVictimUnit} deixa sua corte, chocado com sua decisão, mas você não se importa. Se {IntrigueVictimPlayerLeader.FirstName} poderia usar um dispositivo como o que está diante de você, por que não você? Você não o construiu, nem aprisionou {IntriguePreviousRuler.FirstName}. Você apenas... usa a mão que lhe foi dada."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_895@BUTTON_0"
msgstr "Sobrecarregue o sifão [mana/] para destruir a Gaiola e banir {IntriguePreviousRuler} para o Vazio."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_895@BUTTON_1"
msgstr "Ordene que seus estudiosos estudem a Gaiola de Ligação e <<g:Magia^n,IntriguePreviousRuler>>. [knowledge/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_895@BUTTON_2"
msgstr "Forçar seus Heróis a absorverem parte do <<g:poder^n,IntriguePreviousRuler>>."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_895@BUTTON_3"
msgstr "Canalize <<g:magia^n,IntriguePreviousRuler>> para {EventCity} para aumentar temporariamente sua prosperidade. [food/] [unitprod/] [production/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_895@TITLE"
msgstr "Os Poderes de um Godir"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_935@BODY_FOOTER"
msgstr "A inquietação ressoa dentro do Império de {IntrigueVictimPlayerLeader.TitleName}. Uma ameaça a ser lidada... ou uma oportunidade para você?"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_935@BODY_HEADER"
msgstr "Por muito tempo o [hyperlink,GLOBAL.EmpireConcept]Império[/hyperlink] de {IntrigueVictimPlayerLeader.TitleName} esteve em agitação. Agora, rumores de uma rebelião chegam à sua corte."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_935@BODY_LORE"
msgstr "Qualquer dissidência era punida severamente por {IntrigueVictimPlayerLeader.FirstName}, mas isso só parece ter avivado as chamas dentro. Recentemente, no entanto, a voz mais alta dos {IntrigueVictimPlayerRace} desapareceu, rumores dizem que fugiu para pastos mais verdes."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_935@BUTTON_0"
msgstr "O tempo dirá."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_935@TITLE"
msgstr "Rumores de Rebelião"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_939@BODY_FOOTER"
msgstr "Conquistar {IntrigueHouse} parece ser a única maneira de tirar este prisioneiro importante de {IntrigueVictimPlayerLeader.FirstName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_939@BODY_HEADER"
msgstr "Enquanto você pondera sobre seu domínio neste reino, recebe rumores sobre uma pessoa que pode ser de interesse."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_939@BODY_LORE"
msgstr "Há falas de um prisioneiro misterioso mantido em {IntrigueHouse}, vendado e amordaçado, longe de todos os outros. Oficiais dizem que <<p:IntrigueHero>> é um ladrão comum, mas o \"tratamento especial\" parece altamente suspeito. Há até rumores sobre o envolvimento de {IntrigueVictimPlayerLeader.Name} <<r:IntrigueVictimPlayerLeader>>.[br/]Libertar este prisioneiro certamente irritará {IntrigueVictimPlayerLeader.FirstName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_939@BUTTON_0"
msgstr "Eu libertarei este prisioneiro."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_939@BUTTON_1"
msgstr "Não terei mais parte nisso."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_939@TITLE"
msgstr "Prisioneiro Misterioso"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_940@BODY_FOOTER"
msgstr "\"Eu percebo que a ajuda de um Godir raramente vem sem custo. Ainda assim, só posso ser grato por respirar ar fresco novamente.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_940@BODY_HEADER"
msgstr "Você conquistou {IntrigueHouse}. No calabouço mais profundo, seus soldados encontram o prisioneiro vendado e amordaçado."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_940@BODY_LORE"
msgstr "Quando <<p:IntrigueHero>> é trazido perante você, fica claro que o prisioneiro não viu a luz do dia, ou qualquer tipo de conforto, há muito tempo. A voz de <<Co:IntrigueHero>> está rouca, quase um sussurro quando <<p:IntrigueHero>> fala, mas <<p:IntrigueHero>> permanece sem medo diante de você. \"Meu nome é {IntrigueHero.FirstName}, cidadão orgulhoso de {IntrigueVictimPlayerCapital}... ou eu era, antes de ser preso.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_940@BUTTON_0"
msgstr "\"Conte-me mais sobre seu aprisionamento.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_940@BUTTON_2"
msgstr "\"Sua gratidão está mal colocada, você é meu prisioneiro agora!\" [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_940@TITLE"
msgstr "Prisioneiro Misterioso: Consequências"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_945@BODY_FOOTER"
msgstr "\"Eu tenho muitos apoiadores em {IntrigueVictimPlayerCapital}. Ajude-me a tomar a cidade, e os {IntrigueVictimPlayerRace} estarão em sua dívida.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_945@BODY_HEADER"
msgstr "{IntrigueHero.FirstName} rosna. \"Eu fui preso porque '{IntrigueVictimPlayerLeader.Title}' {IntrigueVictimPlayerLeader.FirstName} tem medo de <<o:IntrigueVictimPlayerLeader>> seus próprios súditos e do poder dos {IntrigueVictimPlayerRace}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_945@BODY_LORE"
msgstr "\"Nós, {IntrigueVictimPlayerRace}, somos tratados terrivelmente por nosso {IntrigueVictimPlayerLeader.Title}. As pessoas só podem suportar tanto abuso antes de se levantarem contra um regime, mesmo de um [hyperlink,GLOBAL.GodirLoreConcept]Godir[/hyperlink]. Havia muitas vozes durante esta revolta, mas acho que eu era a mais alta. E assim fui silenciado. Agora que você me libertou, devo, por minha vez, unir e libertar meu povo da <<g:tirania^n,IntrigueVictimPlayerLeader>>.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_945@BUTTON_0"
msgstr "\"Eu o ajudarei em sua rebelião, {IntrigueHero.FirstName}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_945@BUTTON_1"
msgstr "\"Você está livre para ir, mas não ajudarei uma rebelião.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_945@BUTTON_4"
msgstr "\"Sua confiança em mim está mal colocada, você é meu prisioneiro agora!\" [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_945@TITLE"
msgstr "Voz do Povo"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_946@BODY_FOOTER"
msgstr "{IntrigueHero.FirstName} se prepara para ascender ao trono de {IntrigueVictimPlayerCapital}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_946@BODY_HEADER"
msgstr "Você tomou {IntrigueVictimPlayerCapital}. Enquanto seus soldados inundam suas ruas, {IntrigueHero.Name} marcha para a capital, reunindo um grande número de seguidores atrás de <<P:IntrigueHero>>."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_946@BODY_LORE"
msgstr "Em pouco tempo, {IntrigueHero} está diante do trono que pertencia a {IntrigueVictimPlayerLeader.TitleName}. \"Finalmente, nossa luta chegou ao fim.\" <<Cp:IntrigueHero>> vira-se para a multidão reunida diante de <<P:IntrigueHero>>: \"Cidadãos de {IntrigueVictimPlayerCapital}, este é o início de uma nova alvorada. Nunca mais um tirano governará os {IntrigueVictimPlayerRace}! Nunca mais nos ajoelharemos para {GLOBAL.GodirLoreConcept.Hyperlink} indignos!\" A multidão aclama freneticamente."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_946@BUTTON_0"
msgstr "Apoie o novo governo de {IntrigueHero.FirstName} dos {IntrigueVictimPlayerRace}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_946@BUTTON_7"
msgstr "Aproveite esta chance para assassinar {IntrigueHero.FirstName} antes que <<p:IntrigueHero>> possa ascender. [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_946@TITLE"
msgstr "Voz do Povo: Consequências"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_947@BODY_FOOTER"
msgstr "\"Eu e os {IntrigueVictimPlayerRace} estamos em dívida com você, {PlayerLeader.TitleName}. Nomeie sua recompensa.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_947@BODY_HEADER"
msgstr "Os {IntrigueVictimPlayerRace} têm um novo {IntrigueVictimPlayerLeader.Title}: {IntrigueVictimPlayerLeader.Name}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_947@BODY_LORE"
msgstr "Tendo sido removido do trono de <<o:IntriguePreviousRuler>> por <<o:IntriguePreviousRuler>> próprios ex-súditos, {IntriguePreviousRuler.TitleName} é enviado para o {GLOBAL.AstralVoidLoreConcept.Hyperlink}.[br/][br/]\"Isso era inevitável,\" diz {IntrigueVictimPlayerLeader.TitleName}. \"O povo exige sua libra de carne. Que isso acabe com o derramamento de sangue e a injustiça em {IntrigueVictimPlayerCapital}.\" <<Cp:IntrigueVictimPlayerLeader>> vira-se para você. \"Isso não teria sido possível sem sua ajuda.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_947@BUTTON_0"
msgstr "\"Precisarei de aliados apoiadores neste reino. Junte-se a mim, para a vitória!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_947@BUTTON_1"
msgstr "Compartilhe seus recursos [gold/] [mana/] [food/] [knowledge/] com minha cidade {EventCity}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_947@BUTTON_2"
msgstr "\"Governar um Império é difícil para os não iniciados. Torne-se meu vassalo em vez disso.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_947@TITLE"
msgstr "Viva o {IntrigueVictimPlayerLeader.Title}"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_948@BODY_FOOTER"
msgstr "Você destruiu completamente qualquer senso de unidade dentro do Império de {IntrigueVictimPlayerLeader.TitleName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_948@BODY_HEADER"
msgstr "Você ordena que seus soldados assassinem {IntrigueHero.FirstName} à beira da ascensão. <<Cp:IntrigueHero>> olha para as facas protrudindo do corpo de <<o:IntrigueHero>> em descrença."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_948@BODY_LORE"
msgstr "Sem outra palavra, o aspirante a {IntrigueHero.Title} desaba no chão, sangue se acumulando ao redor de <<P:IntrigueHero>>. Os {IntrigueVictimPlayerRace} gritam em agonia com a perda de seu libertador."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_948@BUTTON_0"
msgstr "\"Isso é o que acontece com aqueles que desafiam o governo de um Godir.\" [influence/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_948@BUTTON_1"
msgstr "Saqueie [item/] e reivindique <<g:body^n,IntrigueHero>> [unit/] para sua própria cripta."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_948@BUTTON_3"
msgstr "Reinstale {IntrigueVictimPlayerLeader.TitleName} e force <<P:IntrigueVictimPlayerLeader>> à submissão."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_948@TITLE"
msgstr "Et tu, {PlayerLeader.FirstName}"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_954@BODY_FOOTER"
msgstr "\"Que este cerco termine logo,\" diz {IntrigueHero.FirstName}, olhando para a cidade. \"Assim meu povo não precisará sofrer mais.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_954@BODY_HEADER"
msgstr "Você chegou a {IntrigueVictimPlayerCapital}. Enquanto inicia o cerco, {IntrigueHero.FirstName} avança, claramente visível das muralhas."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_954@BODY_LORE"
msgstr "\"{IntrigueVictimPlayerRace}!\" <<Cp:IntrigueHero>> grita, \"Irmãos, irmãs! Eu voltei, com a ajuda e apoio de {PlayerLeader.TitleName}! Não estamos sozinhos, somos muitos, nunca podemos ser silenciados! Levante-se contra o tirano {IntrigueVictimPlayerLeader.Name}!\" Uma fraca aclamação pode ser ouvida das muralhas de {IntrigueVictimPlayerCapital}, seguida pelos sons de tumultos e agitação dentro."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_954@BUTTON_0"
msgstr "Continue seu cerco."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_954@BUTTON_1"
msgstr "Aproveite esta chance para assassinar {IntrigueHero.FirstName} antes que <<p:IntrigueHero>> possa cumprir <<o:IntrigueHero>> missão. [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_954@TITLE"
msgstr "Voz do Povo: {IntrigueVictimPlayerCapital}"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_956@BODY_FOOTER"
msgstr "\"Isso significa guerra, {PlayerLeader.TitleName}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_956@BODY_HEADER"
msgstr "Pouco depois de libertar um prisioneiro de {IntrigueVictimPlayerLeader.TitleName}, você é contatado pelo {IntrigueVictimPlayerLeader.Title} <<r:IntrigueVictimPlayerLeader>>."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_956@BODY_LORE"
msgstr "{IntrigueVictimPlayerLeader.FirstName} fala friamente: \"Você me subestima se acha que não estou ciente do que você está planejando. Seu único objetivo é semear a discórdia, e eu não aceitarei isso.\" Um sorriso fino se espalha pelo rosto de <<o:IntrigueVictimPlayerLeader>>: \"Felizmente, nada une um povo mais do que uma ameaça comum.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_956@BUTTON_0"
msgstr "\"Que assim seja.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_956@TITLE"
msgstr "Nenhuma Boa Ação"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_978@BODY_FOOTER"
msgstr "\"Não podemos banir o {IntrigueVictimPlayerLeader.Title}, mas você pode. Por favor, {IntriguePlayerLeader.TitleName}. Destrua aquele demônio vil. Salve os {IntrigueVictimPlayerRace}...\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_978@BODY_HEADER"
msgstr "Você resgatou um grupo de refugiados de um ataque demoníaco. Maltratados, mas gratos, os sobreviventes se reúnem ao redor do seu exército."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_978@BODY_LORE"
msgstr "A última coisa que o cidadão preocupado lhe disse antes do <<o:IntrigueVictimUnit>> falecimento, foi sobre a invocação de {IntrigueVictimPlayerLeader.TitleName}. Ao perguntar, um dos refugiados avança mancando. \"Você quer dizer a {EventStructure}?\" <<Cp:IntrigueVictimUnit>> diz, apesar dos avisos sussurrados de <<o:IntrigueVictimUnit>> companheiros. \"Eu... eu sei onde está. Mas devo avisá-lo, ó {PlayerLeader.Title}. Isso não foi obra de um simples culto.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_978@BUTTON_0"
msgstr "\"Os {IntrigueVictimPlayerRace} em fuga são bem-vindos no meu Império.\" [population/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_978@BUTTON_1"
msgstr "\"Sua confiança em mim está mal colocada. Entregue seus pertences [gold/], ou morra.\" [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_978@BUTTON_2"
msgstr "\"Vou manter isso em mente.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_978@TITLE"
msgstr "Tomada Diabólica: Consequências"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_987@BODY_FOOTER"
msgstr "Os {IntrigueVictimPlayerRace} restantes não têm escolha a não ser aguardar seu julgamento sobre seu destino. Como você os aborda?"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_987@BODY_HEADER"
msgstr "Você derrotou {IntrigueVictimPlayerLeader.TitleName} e tomou <<o:IntrigueVictimPlayerLeader>> capital, em meio a uma rebelião em ascensão."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_987@BODY_LORE"
msgstr "Seus exércitos invadem a antiga capital, dissuadindo qualquer outra agitação. A queda do grande Império ecoa pelo reino, e quaisquer rumores de rebelião e prisioneiros desaparecem com aqueles que fogem da sua ira esperada."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_987@BUTTON_0"
msgstr "\"À medida que este Império cai, lembre-se do poder de {PlayerLeader.TitleName}.\" [influence/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_987@BUTTON_2"
msgstr "\"Os {IntrigueVictimPlayerRace} serão ajudados [food/] durante esses tempos de incerteza.\" [goodact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_987@BUTTON_3"
msgstr "Você não aborda o povo. Você saqueia a cidade. [gold/] [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_987@TITLE"
msgstr "Rebelião: Esmagada"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_988@BODY_FOOTER"
msgstr "Você sente um poder arcano surgir ao redor de {IntrigueHero.FirstName}. Se você deixar <<P:IntrigueHero>>, <<p:IntrigueHero>> ascenderá para se tornar o [hyperlink,GLOBAL.LeaderConcept]Governante[/hyperlink] dos {IntrigueVictimPlayerRace}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_988@BODY_HEADER"
msgstr "{IntrigueHero.FirstName} rosna. \"Eu fui preso porque '{IntrigueVictimPlayerLeader.Title}' {IntrigueVictimPlayerLeader.FirstName} tem medo de <<o:IntrigueVictimPlayerLeader>> próprios súditos e do poder dos {IntrigueVictimPlayerRace}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_988@BODY_LORE"
msgstr "\"<<g:power^n,IntrigueVictimPlayerLeader>> está diminuindo, <<o:IntrigueVictimPlayerLeader>> capital foi tomada, e assim devo guiar meu povo.\" Em pouco tempo, {IntrigueHero.FirstName} está diante de <<o:IntrigueHero>> povo. \"Orgulhosos {IntrigueVictimPlayerRace}, nosso conflito chegou ao fim! Nunca mais um tirano governará sobre nós! Nunca mais nos ajoelharemos para {GLOBAL.GodirLoreConcept.Hyperlink} indignos!\" A multidão aclama selvagemente o retorno de seu [hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink]."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_988@TITLE"
msgstr "Voz do Povo"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@BRAVERY@DESCRIPTION"
msgstr "Seu povo segue um caminho de Conflito, buscando forjar sua força no fogo da guerra:[bulletlist][bullet/]Ganhe agravos contra <<m:{GLOBAL.LeaderConcept.Hyperlink}>> com uma classificação geral melhor.[bullet/]{GLOBAL.RazingConcept.Hyperlink} <<m:{GLOBAL.CityConcept.Hyperlink}>> e {GLOBAL.PillagingConcept.Hyperlink} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> leva -{duration} {GLOBAL.TurnConcept}.[bullet/]{GLOBAL.RazingConcept.Hyperlink} <<m:{GLOBAL.CityConcept.Hyperlink}>> e {GLOBAL.PillagingConcept.Hyperlink} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> rende {GLOBAL.ImperiumConcept.Hyperlink}.[bullet/]Unidades de cultura têm {GLOBAL.PROPERTIES.WARRIORS_SOUL.Hyperlink}.[bullet/]Fique mais forte à medida que ganha {GLOBAL.DevotionConcept.Hyperlink} para o {GLOBAL.OathOfStrife.Hyperlink}.[/bulletlist]"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@BRAVERY@LORENAME"
msgstr "Juramentada^f"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@BRAVERY@NAME"
msgstr "Conflito"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@HARMONY@ADHERENT_TOOLTIP_DESCRIPTION"
msgstr "[bullet/]{GLOBAL.PROPERTIES.HARMONIZE.Hyperlink}: Cura {amount} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@HARMONY@DEVOTEE_TOOLTIP_DESCRIPTION"
msgstr "[bullet/]{GLOBAL.PROPERTIES.HARMONIZE.Hyperlink}: Cura {amount} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@HARMONY@DEVOTION_DESCRIPTION"
msgstr "[bulletlist][bullet/]Ganhe {GLOBAL.DevotionConcept.Hyperlink} por:[bulletlist][bullet/]Ter uma {GLOBAL.CityConcept.Hyperlink} ou {GLOBAL.PvEVassalConcept.Hyperlink} de outra Raça +{GLOBAL.FromVassalage} [devotedact/].[bullet/]Limpar uma {GLOBAL.InfestationConcept.Hyperlink} ou {GLOBAL.AncientWonderConcept.Hyperlink} +{GLOBAL.ClearInfestation} [devotedact/].[bullet/]Fazer um {GLOBAL.TruceConcept.Hyperlink} +{GLOBAL.MakeTruce} [devotedact/].[bullet/]Perdoar um {GLOBAL.CasusBelliConcept.Hyperlink} +{GLOBAL.ForgiveGrievence} [devotedact/].[/bulletlist][bullet/]Perca {GLOBAL.DevotionConcept.Hyperlink} por:[bulletlist][bullet/]Iniciar uma {GLOBAL.WarConcept.Hyperlink} -{GLOBAL.HarmonyEnterWar} [undevotedact/].[bullet/]{GLOBAL.RazingConcept.Hyperlink} ou {GLOBAL.MigratingConcept.Hyperlink} uma {GLOBAL.CityConcept.Hyperlink} hostil -{GLOBAL.AbsorbRazeCity} [undevotedact/].[bullet/]Fabricar um {GLOBAL.CasusBelliConcept.Hyperlink} -{GLOBAL.HarmonyFabricateGrievence} [undevotedact/].[/bulletlist][/bulletlist]"

