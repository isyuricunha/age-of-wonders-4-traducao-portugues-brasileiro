msgid "TOME_PANDEMONIUM@TOME@LORE_AUTHOR"
msgstr "Karissa, a Vermelha, Mestra das Paixões"

msgid "TOME_PANDEMONIUM@TOME@LORE_DESCRIPTION"
msgstr "\"Há uma arte sutil no verdadeiro caos. Não há nada tão delicioso quanto ver as sementes da discórdia crescerem em histeria em massa, espalhando pânico e desordem por populações inteiras! Para mim, é simplesmente... êxtase!\""

msgid "TOME_PANDEMONIUM@TOME@NAME"
msgstr "Tomo de Pandemônio"

msgid "TOME_PANDEMONIUM@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Alvos todos os inimigos adjacentes:[bulletlist][bullet/]Remove todos os <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>>.[bullet/]Causa {CONSUME_CHAOS_EXTRA_DAMAGE>DAMAGE>Fire} de dano elemental aleatório para cada efeito de status removido.[/bulletlist]"

msgid "TOME_PANDEMONIUM@UNIT1@ABILITY1@DESCRIPTION_BIGGER"
msgstr "Alvos todos os inimigos dentro de {CONSUME_CHAOS_UNIT_TARGETER_CIRCLE_AROUND_CASTER_MASTER>AREA>Rad} hexágonos:[bulletlist][bullet/]Remove todos os <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>>.[bullet/]Causa {CONSUME_CHAOS_EXTRA_DAMAGE>DAMAGE>Fire} de dano elemental aleatório para cada efeito de status removido.[/bulletlist]"

msgid "TOME_PANDEMONIUM@UNIT1@ABILITY1@DESCRIPTION_MASTER"
