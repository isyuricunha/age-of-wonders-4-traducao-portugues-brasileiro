msgid "WILDLIFE_UNITPROPERTIES@DRINK@NAME"
msgstr "Beber!"

msgid "WILDLIFE_UNITPROPERTIES@EARTHEN_FURY@DESCRIPTION"
msgstr "+{damageincrease}% de dano contra unidades com {GLOBAL.PROPERTIES.IMMOBILIZED.Hyperlink} e {GLOBAL.PROPERTIES.SLOWED.Hyperlink}."

msgid "WILDLIFE_UNITPROPERTIES@EARTHEN_FURY@NAME"
msgstr "Fúria Terrena"

msgid "WILDLIFE_UNITPROPERTIES@EARTHQUAKE@DESCRIPTION"
msgstr "Unidades inimigas em um raio de {QUAKE_ABILITY_TARGETER>AREA>Radius} hexágonos sofrem dano. Entre no modo {GLOBAL.DefenseModeConcept.Hyperlink}."

msgid "WILDLIFE_UNITPROPERTIES@EARTHQUAKE_SMASH@DESCRIPTION"
msgstr "Causa dano à unidade alvo e unidades inimigas dentro de {EARQUAKE_SMASH_OUTER_TARGETER>AREA>Radius} hexágonos."

msgid "WILDLIFE_UNITPROPERTIES@EARTHQUAKE_SMASH@NAME"
msgstr "Esmagamento Sísmico"

msgid "WILDLIFE_UNITPROPERTIES@ENFEEBLING_HOWL@DESCRIPTION"
msgstr "Unidades inimigas em um cone de {ENFEEBLING_HOWL_TARGETER>AREA>Length} hexágonos sofrem dano e ganham {stack} <<m:stack>> de {GLOBAL.PROPERTIES.WEAKENED.Hyperlink}."

msgid "WILDLIFE_UNITPROPERTIES@ENFEEBLING_HOWL@NAME"
msgstr "Uivo Enfraquecedor"

msgid "WILDLIFE_UNITPROPERTIES@ENHANCING_SYMB@DESCRIPTION"
