msgid "DLC@ELDRITCHREALMS@CITYDEFINITIONS_STRATEGIC@SANCTUARY@DESCRIPTION"
msgstr "Um tipo de {GLOBAL.OutpostConcept.Hyperlink} que só pode ser construído em uma {GLOBAL.ProvinceConcept.Hyperlink} no {GLOBAL.UmbralAbyssConcept.Hyperlink} com um {GLOBAL.BeaconOfLightConcept.Hyperlink}.[bulletlist][bullet/]<<m:{GLOBAL.UnitConcept.Hyperlink}>> amigáveis dentro do {GLOBAL.DomainConcept.Hyperlink} de um Posto Santuário são imunes a {GLOBAL.PROPERTIES.SHADOW_SICKNESS.Hyperlink}.[bullet/]<<m:{GLOBAL.CityConcept}>> não podem ser fundadas em Postos Santuário.[bullet/]Uma vez construído, pode ser atualizado para anexar {amount} províncias adicionais.[bullet/]Concede {gold} {GLOBAL.GoldConcept.Hyperlink}, {mana} {GLOBAL.ManaConcept.Hyperlink} e {knowledge} {GLOBAL.KnowledgeConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@CITYDEFINITIONS_STRATEGIC@SANCTUARY@HYPERLINK"
