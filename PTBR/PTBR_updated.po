msgstr "Quando esta unidade cai abaixo de {GIANT_SIGNATURE_GRAND_ORDER_THRESHOLD>ResolvedTriggerProportion}% de seus pontos de vida máximos:[bulletlist][bullet/]Ganha {amount} pilha de {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink} por {BOLSTERED_DEFENSE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Ganha {amount} pilha de {GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink} por {BOLSTERED_RESISTANCE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Ganha {GIANT_SIGNATURE_GRAND_ORDER_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> por pilha de {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink} e {GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@GIANT_SIGNATURES@SHADOW1@NAME"
msgstr "Runa da Dispersão"

msgid "DLC@GIANTKINGS@GIANT_SIGNATURES@SHADOW2@DESCRIPTION"
msgstr "[bulletlist][bullet/]Ataques básicos têm uma chance base de {DISRUPTION_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.DISRUPTION_TOOLTIP_PROPERTY.Hyperlink} por {DISRUPTION_DISABLE>Duration} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Ataques causam +{GIANT_SIGNATURE_SHADOW_DAMAGE>ResolvedMultiplier}% de dano a unidades {GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@GIANT_SIGNATURES@SHADOW2@NAME"
msgstr "Runa da Interrupção"

msgid "DLC@GIANTKINGS@GIANT_SIGNATURES@SHADOW4@DESCRIPTION"
msgstr "Enquanto governante do exército, todas as unidades não-herói no exército ganham:[bulletlist][bullet/]Ataques básicos têm uma chance base de {DISRUPTION_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.DISRUPTION_TOOLTIP_PROPERTY.Hyperlink} por {DISRUPTION_DISABLE>Duration} <<m:{GLOBAL.TurnConcept}>>, {LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}.[bullet/]Ataques causam +{GIANT_SIGNATURE_SHADOW_DAMAGE>ResolvedMultiplier}% de dano a unidades {GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@GIANT_SIGNATURES@SHADOW4@MOD_DESCRIPTION"
msgstr "+{GIANT_SIGNATURE_SHADOW_DAMAGE>ResolvedMultiplier}% de dano a unidades {GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink}."

