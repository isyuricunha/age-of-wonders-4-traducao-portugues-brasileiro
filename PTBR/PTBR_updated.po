msgid "DIPLOMACY@ACTION@NOMUTUALLYKNOWNPLAYERS"
msgstr "Não há Governantes disponíveis que ambos tenham conhecido."

msgid "DIPLOMACY@ACTION@NOTWHILEATWAR"
