msgid "DLC@ARCHONPROPHECY@SPAWNERS_STRATEGIC@CALL_TO_CRUSADE@DESCRIPTION"
msgstr "Tente persuadir a Infestação a lutar em outro lugar ou iniciar uma cruzada contra um {GLOBAL.EmpireConcept.Hyperlink} [reputation1/] [hyperlink,GLOBAL.AlignmentConcept]maligno[/hyperlink] com o qual você está em [rs_war/] Guerra, o que remove permanentemente este Exército Cruzado.[br/][br/]A Infestação deve ser {GLOBAL.InfestationNeutralityConcept.Hyperlink} para você para usar esta opção."

msgid "DLC@ARCHONPROPHECY@SPAWNERS_STRATEGIC@CRUSADER_HOST@DESCRIPTION"
msgstr "Devotos e celestiais se reúnem para vencer o mal.[br/]Se não forem controlados, crescerão em força, expandirão seu território e enviarão exércitos de invasão.[br/][br/]Esta Infestação será {GLOBAL.InfestationNeutralityConcept.Hyperlink} para aqueles com {GLOBAL.PROPERTIES.GOOD_2_UNIT_PROPERTY.Name} ou melhor {GLOBAL.AlignmentConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@SPAWNERS_STRATEGIC@CRUSADER_HOST@LORE"
msgstr "Se as paredes pudessem falar, as rachaduras nesta estrutura sussurrariam as crônicas das cruzadas contra Urrath. Após eras de conflito, este Exército Cruzado ainda permanece inabalável, servindo como ponto de encontro para os [hyperlink,GLOBAL.ArchonsLoreConcept]Arcontes[/hyperlink] e outros campeões da luz. No entanto, o dever dos Cruzados não se limita às infestações Umbrais; sua honra os compele a erguer suas espadas contra todos que governam através do mal."

msgid "DLC@ARCHONPROPHECY@SPAWNERS_STRATEGIC@CRUSADER_HOST@NAME"
msgstr "Exército Cruzado"

msgid "DLC@ARCHONPROPHECY@STACKENCOUNTER_EVENTS@CRUSADER_HOST@DESTROY_PREDICTION"
msgstr "O Exército Cruzado será removido permanentemente."

msgid "DLC@ARCHONPROPHECY@STACKENCOUNTER_EVENTS@CRUSADER_HOST@PREDICTION"
msgstr "Gera imediatamente {amount} {GLOBAL.MarauderConcept.Hyperlink} <<m:{GLOBAL.ArmyConcept.Hyperlink}>> que viajarão e atacarão <<g:Empire^n,TargetRuler>>."

msgid "DLC@ARCHONPROPHECY@STACKENCOUNTER_EVENTS@CRUSADER_HOST@PREDICTION_UMBRAL"
msgstr "Gera imediatamente {amount} {GLOBAL.MarauderConcept.Hyperlink} <<m:{GLOBAL.ArmyConcept.Hyperlink}>> próximo ao {GLOBAL.UmbralDwellingConcept.Hyperlink} e tentará capturá-lo."

msgid "DLC@ARCHONPROPHECY@STACKENCOUNTER_EVENTS@CRUSADER_HOST@REQUIREMENT"
msgstr "Você precisa ser [reputation8/] [hyperlink,GLOBAL.AlignmentConcept]Puro Bondoso[/hyperlink] para convencê-los."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1004@BODY_FOOTER"
msgstr "O mundo volta ao normal quando sua visão termina. Ainda assim, você ri. Pois é você quem irá arruinar o mundo."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1004@BODY_HEADER"
msgstr "Ao vestir a máscara do mago maníaco, você enxerga as conexões mágicas ocultas no mundo. Poderes fluem através de você."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1004@BODY_LORE"
msgstr "Você estende a mão, e relâmpagos saltam de seus dedos. Você ri. Eles queimam seus inimigos e amplificam o poder de seu {EventRace}. Quanto mais feitiços conjura, mais forte se torna. Você ri. O mundo se curva diante de sua supremacia arcana. {GLOBAL.GodirLoreConcept.Hyperlink} curvam-se. <<m: {GLOBAL.MagicMaterialConcept.Hyperlink}>> se fundem ao seu corpo. <<m:{GLOBAL.AncientWonderConcept.Hyperlink}>> revelam seus segredos ancestrais a você. Você ri."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1004@BUTTON_0"
msgstr "\"Anunciarei uma Era da Magia!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1004@REWARD"
msgstr "Ganha {amount}{GLOBAL.ManaConcept.Hyperlink} por turno."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1004@TITLE"
msgstr "Devastações da Magia"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1005@BODY_FOOTER"
msgstr "Tudo o que você lembra são os fios intermináveis de poder arcano. Você se tornou a Magia, Devoradora de Mundos."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1005@BODY_HEADER"
msgstr "O feito está consumado. A devastação do reino está completa. E você foi o arquiteto de sua destruição."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1005@BODY_LORE"
msgstr "Enquanto seu {EventRace} se deleita com a destruição e o caos no reino, você tenta se lembrar do mundo como era antes. Mas as imagens dos dias anteriores à sua ceifa se foram."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1005@BUTTON_0"
msgstr "\"Agora é minha hora. A Era da Magia.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1005@REWARD"
msgstr "Todos os Governantes podem lançar um feitiço adicional por turno em combate."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1005@REWARD2"
msgstr "Seus feitiços custam {percentage}% menos <<m:{GLOBAL.WorldMapCastingPointConcept.Hyperlink}>> e <<m:{GLOBAL.CombatCastingPointConcept.Hyperlink}>>."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1005@TITLE"
msgstr "Era da Magia"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1008@BODY_FOOTER"
msgstr "A visão termina ali. O mundo volta ao normal. Seu caminho está claro. Você e seu {EventRace} irão arruinar o mundo."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1008@BODY_HEADER"
msgstr "Ao vestir a máscara do general rosnante, o mundo é incendiado. Uma sede de sangue toma conta de você. Seu rosnado se transforma em um sorriso."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1008@BODY_LORE"
msgstr "Um poder inquieto cresce dentro de você. Você descobre um machado e uma espada em suas mãos. Inúmeros inimigos o atacam de todos os lados. Camponeses e príncipes. Magos e <<m:{GLOBAL.HeroConcept.Hyperlink}>>. Até mesmo {GLOBAL.GodirLoreConcept.Hyperlink}. Você canta e ri enquanto os ceifa como trigo na colheita. Você ruge enquanto suas bandeiras se desfraldam em suas cidades caídas. Seu {EventRace} enlouquecido canta seu nome. A máscara de guerra carmesim e seu rosto são um só."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1008@BUTTON_0"
msgstr "\"Anunciarei uma Era da Guerra!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1008@REWARD"
msgstr "Sua {GLOBAL.ThroneCityConcept.Hyperlink} ganha {amount}{GLOBAL.UnitProductionConcept.Hyperlink} por turno."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1008@TITLE"
msgstr "Devastações da Guerra"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1009@BODY_FOOTER"
msgstr "Tudo o que você lembra são as marés eternas de batalhas. Você se tornou a Guerra, Carrasco de Mundos."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1009@BODY_HEADER"
msgstr "O trabalho necessário está feito. A devastação do reino está completa. E você foi o arquiteto de sua destruição."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1009@BODY_LORE"
msgstr "Enquanto seu {EventRace} se deleita com a destruição e o caos no reino, você tenta se lembrar do mundo como era antes. Mas as imagens dos dias anteriores à sua ceifa se foram."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1009@BUTTON_0"
msgstr "Agora é sua hora: a Era da Guerra."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1009@TITLE"
msgstr "Era da Guerra"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1016@BODY_FOOTER"
msgstr "Sua visão termina e o mundo volta ao normal. Seu caminho está claro. Você e seus {EventRace} arruinarão o mundo."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1016@BODY_HEADER"
msgstr "Ao vestir a máscara do guardião do túmulo choroso, o mundo se torna escuro e frio. Um silêncio sinistro desce sobre as terras."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1016@BODY_LORE"
msgstr "Entre incontáveis <<m:{GLOBAL.CityRuinConcept.Hyperlink}>> sem vida, apenas seus {EventRace} prosperam. Os campos são semeados com os ossos de seus rivais, esmagados sob os pés apodrecidos dos Mortos-Vivos devastadores. Você sente a mão da Morte em seu ombro. Você se vira para encarar <<P:PlayerLeader>> e vê que ambos usam a mesma máscara de obsidiana. Vocês removem suas máscaras simultaneamente e descobrem que o rosto da Morte é o seu."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1016@BUTTON_0"
msgstr "\"Anunciarei uma Era da Morte!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1016@REWARD"
msgstr "Ganhe {amount} de <<m:{GLOBAL.SoulConcept.Hyperlink}>> por turno."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1016@TITLE"
msgstr "Desolações da Morte"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1017@BODY_FOOTER"
msgstr "Tudo o que você lembra são campos intermináveis de cadáveres. Você se tornou a Morte, Destruidora de Mundos."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1017@BODY_HEADER"
msgstr "O feito está consumado. A devastação do reino está completa. E você foi o arquiteto de sua destruição."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1017@BODY_LORE"
msgstr "Enquanto seus {EventRace} se deleitam com a destruição e o caos no reino, você tenta se lembrar do mundo como ele era antes. Mas as imagens dos dias anteriores à sua ceifa se foram."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1017@BUTTON_0"
msgstr "Agora é a sua hora: a Era da Morte."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1017@REWARD"
msgstr "{GLOBAL.PROPERTIES.AGE_OF_DEATH.Hyperlink} agora está ativa durante todas as batalhas, com {PlayerLeader.Name} como o Profeta."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1017@SOULS_INCOME_REWARD"
msgstr "Como Profeta, você ganha +{Soulsincome} de <<m:{GLOBAL.SoulConcept.Hyperlink}>> por [turn/] turno."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1017@TITLE"
msgstr "Era da Morte"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1018@BODY_FOOTER"
msgstr "Esse é o ramo que você deve seguir. Qual voz, qual cor, seu coração escolhe? Onde reside o seu destino?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1018@BODY_HEADER"
msgstr "Enquanto prepara sua estratégia para governar este novo reino, o mundo ao seu redor se transforma na visão de uma Árvore Mundial."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1018@BODY_LORE"
msgstr "Você sobe a Árvore Cósmica caleidoscópica de vastidão sem precedentes. Seus ramos se estendem infinitamente em direção a todos os polos do {GLOBAL.AstralSeaLoreConcept.Hyperlink}. Sussurros, cânticos e gritos chamam e acenam para você. Alguns amigáveis. Outros ásperos. Alguns sedutores. Todos conhecem seu nome. No entanto, você percebe que há uma cor — um ramo — que abriga o destino de seus {EventRace}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1018@BUTTON_0"
msgstr "[order/] Siga o ramo dourado em direção aos cânticos."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1018@BUTTON_1"
msgstr "[chaos/] Siga o ramo carmesim em direção às gargalhadas estrondosas."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1018@BUTTON_2"
msgstr "[arcana/] Siga o ramo azul em direção aos encantamentos."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1018@BUTTON_3"
msgstr "[matter/] Siga o ramo cristalino que leva ao chão."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1018@BUTTON_4"
msgstr "[nature/] Siga o ramo florido em direção aos cantos."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1018@BUTTON_5"
msgstr "[shadow/] Siga o ramo morto em direção aos sussurros."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1018@TITLE"
msgstr "Visão do Destino"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1021@BODY_FOOTER"
msgstr "Quando a Lei e a {GLOBAL.OrderConcept.Hyperlink} governarem o reino sob seu comando, a luz divina o abraçará novamente. E o fortalecerá."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1021@BODY_HEADER"
msgstr "Seu espírito se eleva quando trombetas douradas anunciam sua chegada ao se aproximar do fim do ramo dourado."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1021@BODY_LORE"
msgstr "Pilares de luz descem dos próprios céus para ungir você como seu cavaleiro servidor. Você sente uma presença primordial que tanto julga quanto abençoa. Um vislumbre de imenso poder divino. Com um último clarão, a luz então se atenua. Sua visão termina. No entanto, sua missão é revelada."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1021@BUTTON_0"
msgstr "\"Provarei que sou um Guardião da Paz e da Ordem.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1021@TITLE"
msgstr "Destino da Ordem"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1022@BODY_FOOTER"
msgstr "Este sempre foi o seu destino. E com a bênção do {GLOBAL.EndailonLoreConcept.Hyperlink} da {GLOBAL.OrderConcept.Hyperlink}, sua supremacia está apenas começando."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1022@BODY_HEADER"
msgstr "Você se tornou o Ápice da {GLOBAL.OrderConcept.Hyperlink}. O <<PlayerLeader{Mestre/Senhora}>> da Legalidade. Você trouxe a Ordem para este reino."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1022@BODY_LORE"
msgstr "Você realizou seu próprio destino através de esforço e determinação implacáveis. Sua {EventRace}, seus fiéis seguidores, ferramentas e armas ajudaram-no diligentemente a completar suas tarefas. Seu trabalho agora está completo. Mas não é hora de ficar ocioso. Não quando a vitória está ao seu alcance."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1022@BUTTON_0"
msgstr "\"Onde quer que a Ordem exista, minha {EventRace} também existirá. Assim como eu.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1022@REWARD"
msgstr "Todas as unidades possuídas ganham {GLOBAL.PROPERTIES.PROPHECY_MARK_OF_ORDER.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1022@REWARD2"
msgstr "O {GLOBAL.UNITS.LIGHT_SPIRIT.Hyperlink}, {GLOBAL.UNITS.BLESSED_SOUL.Hyperlink} e {GLOBAL.UNITS.ARCHON_ASTRA.Hyperlink} ficam disponíveis no {GLOBAL.RequestMilitaryAidConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1022@TITLE"
msgstr "Exaltado pela Ordem"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1025@BODY_FOOTER"
msgstr "Quando os habitantes deste reino não servirem a nenhum outro Mestre além da {GLOBAL.ChaosConcept.Hyperlink}, seu domínio ardente será irrestrito."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1025@BODY_HEADER"
msgstr "Todos os seus medos e inibições se dissipam enquanto você corre sobre o galho carmesim em direção ao dossel em chamas."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1025@BODY_LORE"
msgstr "Seus fogos furiosos libertam você. Aqui não há regras. Tudo é permitido no reino da {GLOBAL.ChaosConcept.Hyperlink}. Uma entidade invisível observa você. Você sente que ela saboreia sua presença. Sua excitação torna-se o prazer dela. Com uma última labareda, os fogos são subitamente apagados. Sua visão termina. No entanto, sua missão é revelada."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1025@BUTTON_0"
msgstr "\"Provarei que sou um Conquistador e um Acendedor do Caos.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1025@TITLE"
msgstr "Destino do Caos"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1026@BODY_FOOTER"
msgstr "Este sempre foi o seu destino. E com a bênção do {GLOBAL.EndailonLoreConcept.Hyperlink} do {GLOBAL.ChaosConcept.Hyperlink}, seu domínio está apenas começando."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1026@BODY_HEADER"
msgstr "Você se tornou o Ápice do {GLOBAL.ChaosConcept.Hyperlink}. O <<PlayerLeader{Mestre/Senhora}>> da Libertação. Você trouxe o {GLOBAL.ChaosConcept.Name} para este reino."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1026@BODY_LORE"
msgstr "Você realizou seu próprio destino através de esforço e determinação implacáveis. Sua {EventRace}, seus fiéis seguidores, ferramentas e armas ajudaram-no diligentemente a completar suas tarefas. Seu trabalho agora está completo. Mas não é hora de ficar ocioso. Não quando a vitória está ao seu alcance."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1026@BUTTON_0"
msgstr "\"Onde quer que o Caos exista, minha {EventRace} também existirá. Assim como eu.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1026@REWARD"
msgstr "Todas as unidades possuídas ganham {GLOBAL.PROPERTIES.PROPHECY_MARK_OF_CHAOS.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1026@REWARD2"
msgstr "O {GLOBAL.UNITS.INFERNO_HOUND.Hyperlink}, {GLOBAL.UNITS.NIGHTMARE_UNIT.Hyperlink} e {GLOBAL.UNITS.BALOR.Hyperlink} ficam disponíveis no {GLOBAL.RequestMilitaryAidConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1026@TITLE"
msgstr "Liberado pelo Caos"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1029@BODY_FOOTER"
msgstr "Quando seu domínio sobre a magia prende este reino e seus segredos, toda a extensão de seus talentos {GLOBAL.AstralConcept.Hyperlink} é liberada."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1029@BODY_HEADER"
msgstr "O galho azul leva você cada vez mais alto, até desaparecer sob seus pés. Você flutua, imerso na essência {GLOBAL.AstralConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1029@BODY_LORE"
msgstr "Os ensinamentos fundamentais do cosmos estão arquivados aqui. No entanto, antes que você possa estudá-los, descobre que algo etéreo habita esta biblioteca elevada. Você não pode vê-lo, mas pode sentir sua presença, como um relâmpago. Ele estuda você por um momento. Com um súbito trovão, sua visão termina. No entanto, sua missão agora é revelada, inscrita em sua mente."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1029@BUTTON_0"
msgstr "\"Provarei minha devoção à magia como um Erudito de Astral.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1029@TITLE"
msgstr "Destino de Astral"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1030@BODY_FOOTER"
msgstr "Este sempre foi o seu destino. E com a bênção do {GLOBAL.EndailonLoreConcept.Hyperlink} de {GLOBAL.AstralConcept.Hyperlink}, sua estrela apenas começou a brilhar."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1030@BODY_HEADER"
msgstr "Você se tornou o Ápice de {GLOBAL.AstralConcept.Hyperlink}. O <<PlayerLeader{Mestre/Mestra}>> da Magia. Você trouxe {GLOBAL.AstralConcept.Name} para este reino."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1030@BODY_LORE"
msgstr "Você forjou seu próprio destino através de esforço e determinação incansáveis. Seu {EventRace}, seus seguidores leais, ferramentas e armas ajudaram-no diligentemente a completar suas tarefas. Seu trabalho está completo agora. Mas este não é o momento para ficar ocioso. Não quando a vitória está ao seu alcance."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1030@BUTTON_0"
msgstr "\"Onde quer que Astral exista, meu {EventRace} existirá. Assim como eu.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1030@REWARD"
msgstr "Todas as unidades possuídas ganham {GLOBAL.PROPERTIES.PROPHECY_MARK_OF_ASTRAL.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1030@REWARD2"
msgstr "O {GLOBAL.UNITS.LOST_WIZARD_UNIT.Hyperlink} e o {GLOBAL.UNITS.MAGE_BANE_UNIT.Hyperlink} ficam disponíveis no {GLOBAL.RequestMilitaryAidConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1030@TITLE"
msgstr "Ascendido por Astral"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1033@BODY_FOOTER"
msgstr "Quando suas cidades adornam o reino como joias, criadas e posicionadas com precisão e intenção, os segredos de {GLOBAL.MateriumConcept.Hyperlink} são seus."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1033@BODY_HEADER"
msgstr "Você segue o ramo de cristal, seu caminho. Ele leva ao subterrâneo, onde ramos de cristal infinitos crescem e colidem uns com os outros."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1033@BODY_LORE"
msgstr "O bater incessante dos ramos de cristal lembra ferreiros martelando e pedreiros talhando. Galhos grossos e delgados se entrelaçaram e se retorceram em catedrais impressionantes de madeira cristalina. Você sente seu arquiteto, ocultando-se dentro de sua obra. Ele observa seus movimentos e pondera sua apreciação. A visão termina subitamente quando as estruturas desabam. Você acorda, sua mente fixa em sua missão."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1033@BUTTON_0"
msgstr "\"Provarei que sou um Artesão e Guardião de Materium.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1033@TITLE"
msgstr "Destino de Materium"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1034@BODY_FOOTER"
msgstr "Este sempre foi o seu destino. E com a bênção do {GLOBAL.EndailonLoreConcept.Hyperlink} de {GLOBAL.MateriumConcept.Hyperlink}, sua habilidade artesanal apenas começou a se desenvolver."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1034@BODY_HEADER"
msgstr "Você se tornou o Ápice de {GLOBAL.MateriumConcept.Hyperlink}. O <<PlayerLeader{Mestre/Mestra}>> da Arte. Você trouxe {GLOBAL.MateriumConcept.Name} para este reino."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1034@BODY_LORE"
msgstr "Você forjou seu próprio destino através de esforço e determinação incansáveis. Seu {EventRace}, seus seguidores leais, ferramentas e armas ajudaram-no diligentemente a completar suas tarefas. Seu trabalho está completo agora. Mas este não é o momento para ficar ocioso. Não quando a vitória está ao seu alcance."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1034@BUTTON_0"
msgstr "\"Onde quer que Materium exista, meu {EventRace} existirá. Assim como eu.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1034@REWARD"
msgstr "Todas as unidades possuídas ganham {GLOBAL.PROPERTIES.PROPHECY_MARK_OF_MATERIUM.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1034@REWARD2"
msgstr "O {GLOBAL.UNITS.EARTH_TITAN_UNIT.Hyperlink} e o {GLOBAL.UNITS.GOLD_GOLEM.Hyperlink} ficam disponíveis no {GLOBAL.RequestMilitaryAidConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1034@TITLE"
msgstr "Reforçado por Materium"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1035@BODY_FOOTER"
msgstr "Este sempre foi o seu destino. E com a bênção do {GLOBAL.EndailonLoreConcept.Hyperlink} de {GLOBAL.NatureConcept.Hyperlink}, seu florescimento está apenas começando."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1035@BODY_HEADER"
msgstr "Você se tornou o Ápice de {GLOBAL.NatureConcept.Hyperlink}. O <<PlayerLeader{Mestre/Mestra}>> da Vida. Você trouxe {GLOBAL.NatureConcept.Name} para este reino."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1035@BODY_LORE"
msgstr "Você forjou seu próprio destino através de esforço e determinação incansáveis. Seu {EventRace}, seus seguidores leais, ferramentas e armas ajudaram-no diligentemente a completar suas tarefas. Seu trabalho está completo agora. Mas este não é o momento para ficar ocioso. Não quando a vitória está ao seu alcance."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1035@BUTTON_0"
msgstr "\"Onde quer que Natureza exista, meu {EventRace} existirá. Assim como eu.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1035@REWARD"
msgstr "Todas as unidades possuídas ganham {GLOBAL.PROPERTIES.PROPHECY_MARK_OF_NATURE.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1035@REWARD2"
msgstr "A {GLOBAL.UNITS.ENTWINED_SCOURGE_UNIT.Hyperlink} e o {GLOBAL.UNITS.HORNED_GOD.Hyperlink} ficam disponíveis no {GLOBAL.RequestMilitaryAidConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1035@REWARD3"
msgstr "Todas as cidades ganham renda de {GLOBAL.ManaConcept.Hyperlink} igual a {percentage}% de sua renda de {GLOBAL.FoodConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1035@TITLE"
msgstr "Abraçado pela Natureza"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1039@BODY_FOOTER"
msgstr "Quando seus jardins alcançarem o horizonte e seus {EventRace} tiverem se multiplicado e fortificado, você receberá pleno poder sobre {GLOBAL.NatureConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1039@BODY_HEADER"
msgstr "Os doces aromas das flores revigoram você enquanto finalmente chega ao fim do galho frondoso no denso dossel."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1039@BODY_LORE"
msgstr "Você chegou a um paraíso onde tudo se expande e cresce infinitamente para preencher o grande vazio além. Flora e fauna curiosamente notam sua presença. Assim como outra entidade expansiva, escondida fora de vista. Ela planta uma semente em seus pensamentos. Enquanto brota, a visão murcha diante de seus olhos. No entanto, sua missão está enxertada em sua mente."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1039@BUTTON_0"
msgstr "\"Provarei que sou um Cultivador do Crescimento e da Natureza.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1039@TITLE"
msgstr "Destino da Natureza"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1045@BODY_FOOTER"
msgstr "Quando você se senta em sua teia de sombras e enganos, o pleno poder de {GLOBAL.ShadowConcept.Hyperlink} está ao seu dispor para manipular."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1045@BODY_HEADER"
msgstr "O galho morto leva você para baixo, não para cima. Você é guiado para as sombras mais frias e escuras da Árvore."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1045@BODY_LORE"
msgstr "Uma terrível entidade habita aqui, mas você não sente medo, apenas admiração. A entidade estende um de seus membros ganchosos para tocá-lo. Seu toque o intoxica. Você deseja mais. Bebe de um poço fresco de segredos. Mas logo a luz começa a perfurar as sombras. Você está de volta ao mundo. Sua visão terminou. No entanto, sua missão foi revelada."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1045@BUTTON_0"
msgstr "\"Provarei que sou um Manipulador e um Servo da Sombra.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1045@TITLE"
msgstr "Destino da Sombra"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1046@BODY_FOOTER"
msgstr "Este sempre foi o seu destino. E com a bênção do {GLOBAL.EndailonLoreConcept.Hyperlink} de {GLOBAL.ShadowConcept.Hyperlink}, sua influência está apenas começando a crescer."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1046@BODY_HEADER"
msgstr "Você se tornou o Ápice de {GLOBAL.ShadowConcept.Hyperlink}. O <<PlayerLeader{Mestre/Mestra}>> da Decadência. E trouxe {GLOBAL.ShadowConcept.Name} para este reino."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1046@BODY_LORE"
msgstr "Você realizou seu próprio destino através de esforço e determinação incansáveis. Seus {EventRace}, seus fiéis seguidores, ferramentas e armas o ajudaram diligentemente a completar suas tarefas. Seu trabalho está concluído. Mas agora não é hora de ficar ocioso. Não quando a vitória está ao seu alcance."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1046@BUTTON_0"
msgstr "\"Onde quer que a Sombra exista, meus {EventRace} também existirão. Assim como eu.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1046@REWARD"
msgstr "Todas as unidades possuídas ganham {GLOBAL.PROPERTIES.PROPHECY_MARK_OF_SHADOW_AUTOSPELL.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1046@REWARD2"
msgstr "O {GLOBAL.UNITS.FALLEN_ANGEL.Hyperlink}, o {GLOBAL.UNITS.UNDEAD_TITAN.Hyperlink} e o {GLOBAL.UNITS.BONE_DRAGON.Hyperlink} ficam disponíveis no {GLOBAL.RequestMilitaryAidConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1046@TITLE"
msgstr "Imerso na Sombra"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1085@BODY_FOOTER"
msgstr "Enquanto o {EventStackLeader} permanecer no {EventStructure}, seu destino não poderá ser cumprido."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1085@BODY_HEADER"
msgstr "Você encontrou o {EventStructure} de suas visões. Mas ele não está desabitado."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1085@BODY_LORE"
msgstr "Você se lembra da presença sinistra em seus sonhos. Aquele guardião ameaçador do local profetizado de seu Paraíso. É um {EventStackLeader} que ruge quando <<p:EventStackLeader>> nota sua presença, mesmo de longe. <<Cp:EventStackLeader>> está em seu caminho."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1085@BUTTON_0"
msgstr "\"Este {EventStackLeader} deve desocupar este {EventStructure}.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1085@TITLE"
msgstr "O Habitante das Ruínas"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1086@BODY_FOOTER"
msgstr "Para cumprir seu destino e realizar a profecia, você deve reconstruir uma grande {GLOBAL.CityConcept.Hyperlink} a partir destas {EventStructure}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1086@BODY_HEADER"
msgstr "O {EventStackLeader} foi removido da {EventStructure}. Seu destino está ao alcance."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1086@BODY_LORE"
msgstr "As <<m:{GLOBAL.CityRuinConcept.Hyperlink}>> chamam por você. Você sente uma sensação de paz interior e pertencimento. Entre os escombros das Ruínas está a Coroa de Prata da sua visão. Enegrecida pelo tempo e pela intempérie, basta um leve polimento para revelar a promessa reluzente escondida dentro. É o mesmo que estas Ruínas: agora são um monte de pedras quebradas, mas contêm a promessa de uma {GLOBAL.CityConcept.Hyperlink} além da imaginação."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1086@BUTTON_0"
msgstr "\"Estas Ruínas farão uma bela Cidade.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1086@TITLE"
msgstr "Limpando os Escombros"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1096@BODY_FOOTER"
msgstr "<<g:sentries^p,EventHouse>> zombam de você dos baluartes. Você deve tomar esta cidade deles."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1096@BODY_HEADER"
msgstr "Você se aproxima do local da sua Terra Profetizada. É a Cidade Livre de {EventHouse}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1096@BODY_LORE"
msgstr "Os {EventHouseRace}, liderados por {EventHouseLord}, ocupam o território que é seu por direito divino. Você vê a coroa reluzente da sua visão suspensa no ar, bem acima da cidade. Sua visão inspira você e seus guerreiros. Ela ordena que você liberte {EventHouse} de seus ocupantes ilegítimos."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1096@BUTTON_0"
msgstr "\"Eu expulsarei {EventHouseLord} e <<o:EventHouseLord>> {EventHouseRace} da minha cidade!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1096@TITLE"
msgstr "Marchando para o Paraíso"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1097@BODY_FOOTER"
msgstr "{EventHouse} está pronta para se tornar sua {GLOBAL.ThroneCityConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1097@BODY_HEADER"
msgstr "{EventHouse} caiu diante do seu glorioso poder. Seus {EventRace} marcham triunfantes por suas ruas."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1097@BODY_LORE"
msgstr "Seus artesãos já estão reparando os portões da cidade que seu exército destruiu momentos antes. Este é o seu novo lar. Você não sabe explicar, mas isso lhe parece justo. Assim é como o mundo deveria ser."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1097@BUTTON_0"
msgstr "\"Eles não foram páreo para mim e meus poderosos {EventRace}.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1097@TITLE"
msgstr "Paraíso Conquistado"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1115@BODY_FOOTER"
msgstr "Você arriscará enfurecer seu povo e permitirá a entrada dos peregrinos em {EventCity}?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1115@BODY_HEADER"
msgstr "Notícias dos seus esforços para construir seu Paraíso se espalham longe e largo. Peregrinos chegaram para se estabelecer em {EventCity}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1115@BODY_LORE"
msgstr "Os peregrinos são {EventRace}, parentes do seu povo. Eles vieram de todos os cantos deste reino para se juntar a você na sua busca para cumprir sua Profecia. No entanto, sua chegada desagrada os cidadãos de {EventCity}. Por que os peregrinos deveriam se beneficiar do trabalho árduo deles, argumentam. Se você permitir sua entrada, isso certamente desagradará sua população."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1115@BUTTON_0"
msgstr "Receber os peregrinos [population/] para o descontentamento [unhappiness/] dos seus cidadãos."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1115@BUTTON_1"
msgstr "Massacrar os peregrinos [evilact/] e alimentar [food/] sua população em {EventCity} com eles."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1115@BUTTON_2"
msgstr "Expulsar os peregrinos."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1115@BUTTON_3"
msgstr "Construir [structureprod/] e mobiliar [gold/] casas dedicadas [population/] para os peregrinos."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1115@TITLE"
msgstr "Peregrinos para o Paraíso"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1119@BODY_FOOTER"
msgstr "Suas ameaças e insultos continuam por várias horas. Talvez seja melhor acabar com suas vidas rapidamente."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1119@BODY_HEADER"
msgstr "Seus esforços para trazer uma Era da Morte não passaram despercebidos. Cruzados se uniram contra você."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1119@BODY_LORE"
msgstr "Uma companhia de {RandomWarriorTitle} de {RandomIdol} marchou para o seu domínio. Eles juraram matar aquele responsável por trazer tanta morte a este reino. Três Heróis lideram a companhia, repetindo a mesma mensagem sem parar: \"Malvado! Seu reinado de morte terminará pelas nossas lâminas!\" grita {EventHero1}. \"Sua alma amaldiçoada será purificada pelo nosso zelo,\" clama {EventHero2}. \"Suas cidades de decadência serão purgadas por nossas chamas sagradas!\", ruge {EventHero3}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1119@BUTTON_0"
msgstr "\"Minha cripta os recebe.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1119@BUTTON_2"
msgstr "\"Espere, você acha que eu sou o mal?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1119@TITLE"
msgstr "Sentença de Morte"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1120@BODY_FOOTER"
msgstr "Aqueles que morreram serão movidos para sua {GLOBAL.CryptConcept.Hyperlink}. Aqueles que sobreviveram devem logo se juntar a seus <<EventHero1{irmãos/irmãs}>> em armas."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1120@BODY_HEADER"
msgstr "Você derrotou os zelosos {RandomWarriorTitle} de {RandomIdol}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1120@BODY_LORE"
msgstr "Você provou que suas ameaças eram vazias e seu fervor, inútil. Agora eles jazem a seus pés, sacrificados ao grande objetivo que você serve, combustível para as frias chamas da morte."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1120@BUTTON_0"
msgstr "\"Cada vez mais próxima rasteja a hora da Morte.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1120@TITLE"
msgstr "Sentença de Morte: Consequências"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1129@BODY_FOOTER"
msgstr "Este {EventMaterial} está próximo, embora qualquer nova fonte de {GLOBAL.MagicMaterialConcept.Hyperlink} assegurada por comércio ou conquista sirva. Você o reivindicará?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1129@BODY_HEADER"
msgstr "Seus esforços contínuos para arruinar o reino com a força insondável da Magia estão progredindo bem. No entanto, componentes críticos ainda estão faltando."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1129@BODY_LORE"
msgstr "Você sente que pode precisar de {EventMaterial} para completar um conjunto de <<m:{GLOBAL.MagicMaterialConcept.Hyperlink}>> e assim alcançar seus objetivos arcanos. Há uma fonte não muito longe do seu reino. Sua imagem aparece em sua mente. Você quase pode tocá-la."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1129@BUTTON_0"
msgstr "Vá em frente e obtenha o {EventMaterial}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1129@BUTTON_1"
msgstr "Ignore a sensação."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1129@TITLE"
msgstr "Assegurando o Conjunto"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1133@BODY_FOOTER"
msgstr "Embora seu plano ainda não tenha se concretizado totalmente, a inevitabilidade do seu curso traçado torna-se cada vez mais aparente."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1133@BODY_HEADER"
msgstr "Você assegurou o {EventMaterial}. Seus planos avançam a cada hora."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1133@BODY_LORE"
msgstr "Você pode sentir como o {GLOBAL.MagicMaterialConcept.Hyperlink} age como um condutor para as energias mágicas que fluem através dele. O ar em seu reino fica um pouco mais denso e ligeiramente mais estático. A pressão está aumentando."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1133@BUTTON_0"
msgstr "Este mundo logo ruirá."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1133@TITLE"
msgstr "Combinação Mágica"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1159@BODY_FOOTER"
msgstr "Inspirado pelo Endailon, você sabe em seu coração: ao reivindicar o {EventMaterial}, aumentará a produtividade do seu reino."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1159@BODY_HEADER"
msgstr "Enquanto supervisiona a construção em {EventCity}, você é subitamente tomado por uma compulsão de criar. Uma entidade se revela a você."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1159@BODY_LORE"
msgstr "Você reconhece a entidade de sua visão. Este é o arquiteto da Catedral de Madeira Cristalina. Dentro de você, cresce o desejo de criar ferramentas finas e construir torres altas. A entidade, o próprio {GLOBAL.EndailonLoreConcept.Hyperlink} de {GLOBAL.MateriumConcept.Hyperlink} que foi atraído ao seu reino pela sua dedicação à construção, revela a você um {EventMaterial} próximo, que guarda segredos para construir mais rápido, mais alto e melhor. Ela então faz uma pausa, aparentemente observando sua reação."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1159@BUTTON_0"
msgstr "Sim, o {EventMaterial} será meu!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1159@BUTTON_3"
msgstr "Purifique o desejo. Rejeite seus instintos inatos. [materiumcrisis/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1159@BUTTON_4"
msgstr "Ordene aos cidadãos de {EventCity} que trabalhem em [structureprod/], sem descanso. [food/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1159@TITLE"
msgstr "A Musa do Ofício"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1160@BODY_FOOTER"
msgstr "Você percebe que o {GLOBAL.EndailonLoreConcept.Hyperlink} partiu. Mas sua febre construtiva permanece."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1160@BODY_HEADER"
msgstr "Você reivindicou o {EventMaterial} e foi tomado por uma revelação inspiradora."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1160@BODY_LORE"
msgstr "Você passa a compreender instantaneamente projetos arquitetônicos, integridades estruturais e as qualidades dos materiais. Essa compreensão não vem apenas de seu íntimo. Foi amplificada, se não concedida, a você pela encarnação absoluta do Fazer: o {GLOBAL.EndailonLoreConcept.Hyperlink} de {GLOBAL.MateriumConcept.Hyperlink}. Mas a inspiração é fugaz. O Endailon deve cuidar de outras criações."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1160@BUTTON_0"
msgstr "Das cavernas mais profundas aos céus mais altos, nós construímos!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1160@TITLE"
msgstr "Intervenção Construtiva"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1163@BODY_FOOTER"
msgstr "Você percebe que o {EventSpawner} não é um objetivo, mas um meio. Você pondera seu próximo movimento."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1163@BODY_HEADER"
msgstr "Enquanto planeja e trama seu próximo movimento, uma súbita sensação de temor e terror toma conta de você. Uma entidade familiar se revela."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1163@BODY_LORE"
msgstr "Você já admirou sua presença antes, no reino sombrio e decadente de sua visão. Diante de você, estendendo seu imenso corpus de escuridão como a noite morta, está o próprio {GLOBAL.EndailonLoreConcept.Hyperlink} de {GLOBAL.ShadowConcept.Hyperlink}. Ele estava oculto nas sombras que você projeta em seu reino. Alguns de seus membros ganchosos apontam para um {EventSpawner}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1163@BUTTON_0"
msgstr "Ordene que seus exércitos ataquem o {EventSpawner}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1163@BUTTON_1"
msgstr "Canalize o terror do Endailon [happiness/] para recrutar mais guerreiros [unitprod/] em {EventCity}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1163@BUTTON_2"
msgstr "Rejeite o convite do Endailon. [shadowcrisis/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1163@TITLE"
msgstr "A Musa do Engano"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1164@BODY_FOOTER"
msgstr "A vitória, no entanto, inspira seu {EventRace} a servi-lo em batalha. E servi-lo, eles o farão."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1164@BODY_HEADER"
msgstr "O {EventSpawner} está em ruínas, e seus guerreiros recolhem os espólios. Ainda assim, você se sente insatisfeito."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1164@BODY_LORE"
msgstr "Você se pergunta se o {EventSpawner} tinha outro propósito. Talvez não devesse ter sido obliterado. Talvez devesse obliterar. Você pondera as manipulações do {GLOBAL.EndailonLoreConcept.Hyperlink} de {GLOBAL.ShadowConcept.Hyperlink}, cuja presença sombria você sente recuar, esgueirando-se de volta às sombras do reino."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1164@BUTTON_0"
msgstr "\"Roubarei seu favor, ó Endailon!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1164@TITLE"
msgstr "Intervenção Oculta"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1171@BODY_FOOTER"
msgstr "Suas cidades precisam de {GLOBAL.FoodConcept.Hyperlink} para crescer. O {GLOBAL.EndailonLoreConcept.Hyperlink} oferece-lhe um banquete suculento: caçar o {EventStackLeader}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1171@BODY_HEADER"
msgstr "A visão de suas cidades em expansão faz seu <<PlayerLeader{virility/vivacity}>> crescer. De repente, uma entidade se revela a você."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1171@BODY_LORE"
msgstr "Você já encontrou essa entidade antes em sua visão do paraíso em constante crescimento. Você é recebido pelo próprio {GLOBAL.EndailonLoreConcept.Hyperlink} de {GLOBAL.NatureConcept.Hyperlink}, atraído por seu domínio florescente. Sua fome de expansão cresce em sua presença. A entidade mostra-lhe um {EventStackLeader} gordo vagando por perto."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1171@BUTTON_0"
msgstr "Cace o {EventStackLeader} pela carne de <<o:EventStackLeader>>."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1171@BUTTON_1"
msgstr "Seu {EventRace} não deseja carne. Envie todos os trabalhadores [structureprod/] para as fazendas! [food/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1171@BUTTON_2"
msgstr "Recusar-se a caçar o {EventStackLeader}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1171@TITLE"
msgstr "A Musa do Crescimento"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1172@BODY_FOOTER"
msgstr "Sob as asas do {GLOBAL.EndailonLoreConcept.Hyperlink}, a carne coletada se multiplica, tornando-se um banquete que alimenta todos os cidadãos em seu reino."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1172@BODY_HEADER"
msgstr "Ao colher a carne do {EventStackleader} abatido, você sente o {GLOBAL.EndailonLoreConcept.Hyperlink} de {GLOBAL.NatureConcept.Hyperlink} ressurgir."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1172@BODY_LORE"
msgstr "Ele estuda o cadáver do {EventStackLeader} com crescente curiosidade. Você esperava que deplorasse a decomposição, mas, através da entidade, testemunha a injeção de nova vida no <<G:carcass^n,EventStackLeader>>: insetos limpando os ossos, fungos crescendo no cadáver, e o que restar fertilizará sementes em brotação. O Endailon, satisfeito com o ciclo da vida renovado, concede uma última dádiva antes de partir."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1172@BUTTON_0"
msgstr "\"Avante e multipliquem-se, meu {EventRace}!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1172@TITLE"
msgstr "Intervenção Nutritiva"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1175@BODY_FOOTER"
msgstr "O Endailon inspira você a realizar um ato divino. Você jurará destruir o {EventSpawner} ou apaziguá-lo de outra forma?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1175@BODY_HEADER"
msgstr "Sua devoção e autoridade moldam lentamente este reino. Orgulho e exaltação o envolvem quando uma entidade se revela a você."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1175@BODY_LORE"
msgstr "Cercado por pilares dourados de luz, o {GLOBAL.EndailonLoreConcept.Hyperlink} de {GLOBAL.OrderConcept.Hyperlink} o honra com sua presença. Ele observa seu domínio e as Cidades Livres que você inspira com aprovação paternal. No entanto, você pressente que uma anomalia irrita a entidade. Uma mancha nas terras ordeiras que governa. Um {EventSpawner} é fonte de corrupção e caos. Você sente as expectativas do Endailon em relação a você."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1175@BUTTON_0"
msgstr "Tragerei Ordem ao reino destruindo o {EventSpawner}"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1175@BUTTON_2"
msgstr "Oferecer proteção [unitprod/] contra o {EventSpawner} a Cidades Livres amigas. [allegiance/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1175@BUTTON_4"
msgstr "Recusar o chamado. [ordercrisis/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1175@TITLE"
msgstr "A Musa da Harmonia"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1176@BODY_FOOTER"
msgstr "Não é sempre que alguém tão magnífico quanto você honra os reinos. Banhe-se na luz de sua supremacia."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1176@BODY_HEADER"
msgstr "O {EventSpawner} foi destruído. Este reino está um passo mais perto da ordem perfeita."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1176@BODY_LORE"
msgstr "O {GLOBAL.EndailonLoreConcept.Hyperlink} de {GLOBAL.OrderConcept.Hyperlink} aprova seu trabalho. Um coro angelical então começa a cantar. Primeiro em sussurros, até que a luz que envolve o Endailon começa a se dissipar. As vozes do coro então crescem em um crescendo, momento em que a entidade desaparece com um estrondo ensurdecedor. A luz se vai, exceto por um pilar que desce dos céus. Ele incide sobre você, coroando sua cabeça com glória dourada."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1176@BUTTON_0"
msgstr "Ninguém é tão digno quanto você."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1176@TITLE"
msgstr "Intervenção Divina"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1185@BODY_FOOTER"
msgstr "Seja qual for o motivo que os trouxe aqui, derrote os devastadores antes que destruam seus recursos ou prejudiquem seu {EventRace}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1185@BODY_HEADER"
msgstr "<<m:{GLOBAL.MarauderConcept.Hyperlink}>> no reino tomaram conhecimento de seus esforços para despedaçar este mundo nas chamas da guerra. Alguns concordam. Outros não."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1185@BODY_LORE"
msgstr "Alguns dos que discordam chegaram às suas fronteiras para exigir justiça e responsabilizá-lo por seus atos. Eles não hasteiam bandeira alguma além da própria. O mais peculiar do que o momento de sua chegada é o caos desenfreado que causam, como se para provocá-lo."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1185@BUTTON_0"
msgstr "Devastar os devastadores."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1185@TITLE"
msgstr "Objeções Justas"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1186@BODY_FOOTER"
msgstr "Esta carta é prova de uma tentativa descarada de atacá-lo pelas costas. Mais importante, você pode usá-la para reforçar suas reivindicações contra {RivalPlayer}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1186@BODY_HEADER"
msgstr "Seus guerreiros derrotaram o {EventStackLeader} saqueador e seus companheiros <<o:EventStackLeader>>. Entre os espólios, vocês descobrem algo surpreendente."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1186@BODY_LORE"
msgstr "Parece que o ataque dos saqueadores não foi coincidência. Eles carregam uma carta enviada por {RivalPlayer}, que expressa os profundos medos de <<o:RivalPlayer>> sobre suas visões de ruína para o reino. Os bandidos foram enviados para acabar, ou pelo menos atrapalhar, seus planos."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1186@BUTTON_0"
msgstr "{RivalPlayer} deve pagar por sua transgressão <<o:RivalPlayer>>."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1186@TITLE"
msgstr "Causa Justa"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1192@BODY_FOOTER"
msgstr "Escravo da vontade do <<o:{GLOBAL.EndailonLoreConcept.Hyperlink}>>, {EventHouseLord}, de {EventHouse}, jura prontamente destruir você e seu {EventRace}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1192@BODY_HEADER"
msgstr "Por suas mãos, este reino cai lentamente no caos. De repente, uma entidade atraída pela devastação que você causa se revela a você."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1192@BODY_LORE"
msgstr "A entidade liberta sua alma; sua presença inflama seu coração. Você se lembra dessa entidade de sua visão do dossel em chamas. Suas ações atraíram o próprio {GLOBAL.EndailonLoreConcept.Hyperlink} de {GLOBAL.ChaosConcept.Hyperlink} para seu domínio. No entanto, o apetite da entidade por destruição ainda não está satisfeito. Ela observa o reino e, desejando mais desordem, fere o coração do {EventHouseLord.Title} de {EventHouse} para incitar ódio em seu interior."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1192@BUTTON_0"
msgstr "Outra Cidade deve cair sob suas lâminas flamejantes."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1192@BUTTON_2"
msgstr "Pacifique {EventHouse} comprando [gold/] suas espadas [unitprod/] para o seu exército."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1192@BUTTON_3"
msgstr "Não tenho desavenças com {EventHouse}. Rejeito esta guerra. [chaoscrisis/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1192@TITLE"
msgstr "A Musa do Conflito"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1193@BODY_FOOTER"
msgstr "Este frenesi de batalha recém-despertado será um trunfo útil enquanto você continua a semear o caos em nome de {GLOBAL.ChaosConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1193@BODY_HEADER"
msgstr "Enquanto seus guerreiros festejam entre as ruínas de {EventHouse}, você sente o retorno do {GLOBAL.EndailonLoreConcept.Hyperlink} de {GLOBAL.ChaosConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1193@BODY_LORE"
msgstr "A luz flamejante da entidade lhe enche de euforia. Você compartilha de sua alegria ao observar as muralhas destruídas de {EventHouse}. Apesar de seu êxtase, você começa a entender que esta guerra foi um favor da entidade. Quando o {GLOBAL.EndailonLoreConcept.Hyperlink} fixa seu olhar em você, quase explode de fervor. A sensação irrompe de você e se espalha por todos os {EventRace} em seu reino."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1193@BUTTON_0"
msgstr "Morte à Ordem! Glória ao Caos!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1193@TITLE"
msgstr "Intervenção Discordante"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1197@BODY_FOOTER"
msgstr "É estranho, mas você inexplicavelmente sente que satisfazer o pedido do <<o:{GLOBAL.EndailonLoreConcept.Hyperlink}>> para obter {EventMaterial} revelará segredos ocultos a você."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1197@BODY_HEADER"
msgstr "Um a um, os segredos deste reino são desvendados por você. De repente, você se sente iluminado quando uma entidade se revela a você."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1197@BODY_LORE"
msgstr "Você conhece sua identidade: o próprio {GLOBAL.EndailonLoreConcept.Hyperlink} de {GLOBAL.AstralConcept.Hyperlink}. Lembrando-se de seu encontro com a entidade na biblioteca Astral de sua visão, suas mentes se conectam brevemente. Você vislumbra um {EventMaterial} não muito longe daqui. Você sente a curiosidade da entidade: ela deseja que você reivindique a substância para si. Para estudá-la... e potencialmente por outros motivos."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1197@BUTTON_0"
msgstr "O Endailon sabe o que é melhor. Obterei o {EventMaterial}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1197@BUTTON_3"
msgstr "Rejeitar a orientação do Endailon. [astralcrisis/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1197@BUTTON_4"
msgstr "Beneficiar-se da presença do Endailon para extrair conhecimento cósmico [mana/]. [knowledge/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1197@TITLE"
msgstr "A Musa da Descoberta"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1198@BODY_FOOTER"
msgstr "Esta é sua verdadeira recompensa. As ressonâncias combinadas do {GLOBAL.EndailonLoreConcept.Hyperlink} e do {EventMaterial} revelam a localização de uma {GLOBAL.AncientWonderConcept.Hyperlink} não reivindicada."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1198@BODY_HEADER"
msgstr "Você reivindicou com sucesso o {EventMaterial}, que está coberto por uma espessa camada de poeira de [hyperlink,GLOBAL.ManaConcept]mana[/hyperlink]."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1198@BODY_LORE"
msgstr "O enigmático {GLOBAL.EndailonLoreConcept.Hyperlink} de {GLOBAL.AstralConcept.Hyperlink} reaparece, porém foca-se no {EventMaterial}. Você sente suas magias inerentes interagindo—uma experiência inebriante—enquanto, lentamente, a poeira de mana se rearranja em um mapa rudimentar. Ele detalha o caminho para uma {GLOBAL.AncientWonderConcept.Hyperlink} que você ainda não explorou. A entidade então relaxa novamente, antes de voltar sua atenção para algo mais no {GLOBAL.AstralSeaLoreConcept.Hyperlink} e desaparece."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1198@BUTTON_0"
msgstr "\"Fui abençoado por este augúrio arcano.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1198@TITLE"
msgstr "Intervenção Arcana"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1205@BODY_FOOTER"
msgstr "Seus arquitetos acreditam que o {EventMaterial} acelerará a construção em {EventCity}. Você aceitará a proposta deles?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1205@BODY_HEADER"
msgstr "{EventCity} cresce. Tanto sua população quanto seus edifícios se multiplicam e se tornam mais fortes."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1205@BODY_LORE"
msgstr "Entusiasmados, <<G:architects^p,EventCity>> apresentam uma oportunidade a você. Eles descobriram novas propriedades estruturais no {EventMaterial}, alegando que ele pode ser misturado à pedra e à terra de {EventCity} para fortalecê-la! \"Se {EventCity} é verdadeiramente nosso Paraíso,\" argumentam, \"certamente apenas os melhores materiais devem ser usados em sua construção, ó {PlayerLeader.Title}.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1205@BUTTON_0"
msgstr "Decida encontrar o {EventMaterial} para {EventCity}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1205@BUTTON_4"
msgstr "Decida que {EventCity} atualmente não precisa de aumento mágico."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1205@TITLE"
msgstr "Projetos de Estabilidade"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1206@BODY_FOOTER"
msgstr "Euforia se espalha entre seus cidadãos. A crença de que {EventCity} é seu Paraíso nunca foi tão ardente."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1206@BODY_HEADER"
msgstr "Você garantiu o {EventMaterial}. Ele agora será incorporado na construção de {EventCity}!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1206@BODY_LORE"
msgstr "A notícia de sua conquista se espalha rapidamente. A população de {EventCity} aclama os construtores e trabalhadores, encorajando-os a trabalhar melhor, mais duro e mais rápido. As muralhas e torres de sua grande cidade crescem cada vez mais altas. O canto de seu nome é ouvido por toda parte. \"{PlayerLeader}! Vida longa a {PlayerLeader}!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1206@BUTTON_0"
msgstr "{EventCity} não terá igual em todos os reinos."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1206@TITLE"
msgstr "Fundação de Estabilidade"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1207@BODY_FOOTER"
msgstr "Você enfrenta um dilema: pressionar o ataque e vencer mais facilmente, ou recuar para preservar as estruturas da cidade."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1207@BODY_HEADER"
msgstr "A vitória está ao seu alcance: o cerco a {EventCity} começou. Você esperou muito tempo por este momento."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1207@BODY_LORE"
msgstr "Mas um pensamento lentamente toma sua mente enquanto supervisiona os preparativos do cerco. Se esta cidade deve ser seu Paraíso, que sabedoria há em atacar {EventCity} com fogo e aço?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1207@BUTTON_0"
msgstr "Chame reforços de {PlayerCity} [unitprod/] e intensifique [siegehealthdamage/] o ataque!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1207@BUTTON_1"
msgstr "Obrigue suas tropas [hp/] a minimizar baixas [goodact/] entre a população. [population/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1207@BUTTON_2"
msgstr "Continue com o cerco normalmente."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1207@BUTTON_3"
msgstr "Incite suas tropas [morale/] a minimizar danos a <<G:structures^p,EventCity>>. [structureprod/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1207@TITLE"
msgstr "Batendo nos Portões Profetizados"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1210@BODY_FOOTER"
msgstr "Isso não pode continuar. Você está vinculado à sua Profecia. Reivindique o que é seu por direito! Conquiste {EventCity}!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1210@BODY_HEADER"
msgstr "É seu destino construir seu Paraíso nas <<m:{GLOBAL.CityRuinConcept.Hyperlink}>>. No entanto, {RivalPlayer} chegou antes de você."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1210@BODY_LORE"
msgstr "Pouco importa se foi malícia, ignorância ou acaso. Seu rival construiu uma cidade própria nas <<m:{GLOBAL.CityRuinConcept.Hyperlink}>> que eram suas para reivindicar. Os {EventRace} de <<Co:RivalPlayer>> agora vivem, trabalham e se multiplicam onde seus {PlayerRace} estão predestinados a prosperar."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1210@BUTTON_0"
msgstr "Que insolência! {EventCity} deve ser minha!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1210@TITLE"
msgstr "Expectativas Arruinadas"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1211@BODY_FOOTER"
msgstr "Você pode deixar esta guerra para trás agora e focar em seu futuro próspero em {EventCity}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1211@BODY_HEADER"
msgstr "Você conquistou {EventCity} das garras indignas de {RivalPlayer}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1211@BODY_LORE"
msgstr "Seu rival {GLOBAL.GodirLoreConcept.Hyperlink} talvez nunca compreenda por que foi tão vital para você se estabelecer nestas <<m:{GLOBAL.CityRuinConcept.Hyperlink}>>. Você pertence a uma companhia seleta: os poucos escolhidos encarregados da busca por feitos monumentais. Você foi avaliado. E foi considerado digno."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1211@BUTTON_0"
msgstr "Hoje pertence aos poderosos {PlayerRace}!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1211@TITLE"
msgstr "Restauração da Reivindicação"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_939@BODY_FOOTER"
msgstr "Qual destino lhe pertence? A Cidade Murada? A Floresta de Detritos? Ou você permanecerá dentro das Fundações de Argila?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_939@BODY_HEADER"
msgstr "Este reino exala um aroma de destino que o afeta. Não demora muito até que você sucumba a um sonho."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_939@BODY_LORE"
msgstr "Você está em meio às inacabadas Fundações de Argila ao amanhecer, um lugar familiar e seguro. A charneca o cerca, com apenas dois marcos à vista. Os raios do Sol nascente refletem em uma coroa suspensa no céu, pairando sobre uma Cidade Murada no topo de uma colina íngreme. Enquanto isso, a Lua ilumina um caminho de detritos que leva a uma floresta densa, onde incontáveis olhos brilham sob suas copas. Uma voz trovejante ordena: \"Guie seus {EventRace} em direção ao Paraíso deles.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_939@BUTTON_0"
msgstr "[order/] Ascenda a colina distante, em direção à cidade murada."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_939@BUTTON_1"
msgstr "[nature/] Siga o caminho de detritos até a floresta de olhos."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_939@BUTTON_2"
msgstr "[matter/] Plante os pés no centro das fundações de argila."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_939@TITLE"
msgstr "Visões de Promessa"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_942@BODY_FOOTER"
msgstr "O sonho se dissipa, sua mensagem clara. Encontre a Terra Profetizada ocupada pelos usurpadores e conquiste-a para seus {EventRace}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_942@BODY_HEADER"
msgstr "Você chega à Cidade Murada. Seu portão está trancado. Figuras sombrias marcham ao longo de suas altas muralhas. O caminho está fechado."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_942@BODY_LORE"
msgstr "A coroa flutuando sobre a cidade o chama. Seu brilho aquece seu coração e incita uma promessa estimulante em sua alma. Você vê entalhes nas muralhas da cidade. Imagens desbotadas de seus {EventRace} e... de você mesmo! Esta é sua terra. Esta cidade lhe pertence. No entanto, você não é seu <<PlayerLeader{senhor/senhora}>>. Inimigos, espreitando-o de fortificações imponentes, estão em seu caminho."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_942@BUTTON_0"
msgstr "\"Pelas espadas dos {EventRace}, conquistarei meu Paraíso!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_942@TITLE"
msgstr "Promessa de Paraíso"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_954@BODY_FOOTER"
msgstr "{EventCity} trará riqueza e produtividade sem precedentes para seus {EventRace}. Que seu reinado aqui seja longo."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_954@BODY_HEADER"
msgstr "Seu trabalho determinado é finalmente recompensado. A Grande Obra está concluída. A construção de {EventCity}, seu Paraíso, agora está completa."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_954@BODY_LORE"
msgstr "Seus {EventRace} celebram enquanto você relembra a visão que teve há tanto tempo. Observando o zelo e a determinação de seu povo, você se pergunta se aquela Visão de Profecia lhe trouxe este feito monumental, ou se a vontade de vencer sempre esteve dentro de você. Ou talvez sejam uma e a mesma coisa."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_954@BUTTON_0"
msgstr "Agora é hora de colher os frutos de nosso trabalho."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_954@BUTTON_2"
msgstr "Conquistamos o {EventMonster}. Agora conquistamos o reino."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_954@BUTTON_3"
msgstr "Agora é hora de colher os frutos de nosso trabalho.\\"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_954@TITLE"
msgstr "Pedras Angulares no Paraíso"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_957@BODY_FOOTER"
msgstr "Você desperta com o impulso de encontrar a {EventStructure} e derrotar qualquer entidade que habite lá. Seu Paraíso deve ser reconstruído."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_957@BODY_HEADER"
msgstr "Os escombros do caminho sinuoso da floresta rangem sob seus passos até que você finalmente chega a uma clareira iluminada pela lua."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_957@BODY_LORE"
msgstr "A clareira já abrigou uma cidade ancestral, agora espalhada em escombros e ossos. Você encontra uma coroa de prata com seu nome gravado nela. Estas são as <<m:{GLOBAL.CityRuinConcept.Hyperlink}>> da sua Terra Profetizada. Então, árvores escuras que cercam a clareira rangem e dão lugar a algo sinistro que fez seu covil aqui. Você ouve ossos se quebrando. O sonho termina aí."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_957@BUTTON_0"
msgstr "A terra agora arruinada florescerá novamente!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_957@TITLE"
msgstr "Paraíso Perdido"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_977@BODY_FOOTER"
msgstr "Seu Paraíso é {EventCity}. Tudo o que você precisa fazer para realizar seu potencial é aumentar sua população e mantê-los felizes."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_977@BODY_HEADER"
msgstr "Você passeia entre as fundações de argila e descobre que navega por seu layout com uma familiaridade estranha. Isso lembra você de casa."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_977@BODY_LORE"
msgstr "Então, as paredes baixas começam a se fechar sobre você. Você se sente apertado. Contido. Inibido. Isso não serve. Você deve expandir. Crescer. Construir. Este será o seu destino. Transformar sua casa em um bastião de vigor e arte. Sua determinação repele as paredes que avançam. Seu sonho termina abruptamente e você percebe: as fundações em suas visões eram as de {EventCity}, lar do seu {EventRace}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_977@BUTTON_0"
msgstr "Inicie nossa grande obra em {EventCity}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_977@REWARD"
msgstr "Sua <<m:{GLOBAL.ThroneCityConcept.Hyperlink}>> ganha {amount} de {GLOBAL.CityStabilityConcept.Hyperlink} por {GLOBAL.MagicMaterialConcept.Hyperlink} que você controla."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_977@TITLE"
msgstr "Fundações do Paraíso"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_979@BODY_HEADER"
msgstr "Você garantiu um novo lar para o seu {EventRace}. O Paraíso finalmente é seu."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_979@BUTTON_0"
msgstr "\"Deste novo trono de poder, governarei o reino.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_979@TITLE"
msgstr "Conquista do Paraíso"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_988@BODY_HEADER"
msgstr "Antes, isto era um ermo arruinado. Agora, sua cidade reluzente ergue-se alta e robusta. Você reconquistou seu Paraíso."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_988@BUTTON_0"
msgstr "Arrancamos {EventCity} do ermo. Agora conquistamos o reino."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_988@TITLE"
msgstr "Paraíso Reconquistado"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_998@BODY_FOOTER"
msgstr "\"{PlayerLeader}, este mundo deve terminar por suas mãos. Escolha suas ferramentas de destruição.\" Qual máscara da destruição você vestirá?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_998@BODY_HEADER"
msgstr "Você e seu {EventRace} contemplam este novo reino, maduro para ser tomado, quando nuvens escuras enegrecem os céus."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_998@BODY_LORE"
msgstr "Uma visão aterradora aparece no céu: uma caveira gargalhante, trespassada por lâminas de gelo, fogo e relâmpago. De repente, você encontra três máscaras em três pedestais diante de você: uma máscara de obsidiana de um guardião de túmulo choroso, uma máscara de cornalina de um general rosnante e uma máscara de lápis-lazúli de um mago rindo maniacamente. A terra ao seu redor treme, se move e se rasga enquanto a caveira no céu grita seu nome."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_998@BUTTON_0"
msgstr "[arcana/] Torne-se o mago risonho."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_998@BUTTON_1"
msgstr "[chaos/] Torne-se o general rosnante."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_998@BUTTON_2"
msgstr "[shadow/] Torne-se o guardião de túmulo choroso."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_998@TITLE"
msgstr "Visões da Ruína"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1171_3692@BODY_FOOTER"
msgstr "A Hoste se reúne diante de você e aguarda ansiosamente por seu decreto."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1171_3692@BODY_HEADER"
msgstr "Por ser percebido como puro pela Hoste Cruzada, você poderia convencê-los a continuar sua luta em outro lugar. Removendo permanentemente sua Infestação."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1171_3692@BODY_LORE"
msgstr "Se você tiver alcançado o alinhamento de Bondade Pura, poderia até convencê-los a lançar uma cruzada final e decisiva contra um inimigo de sua escolha."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1171_3692@BUTTON_0"
msgstr "[influence/] \"Esta terra está livre da corrupção, vocês devem continuar a luta em outro lugar.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1171_3692@BUTTON_1"
msgstr "[reputation8/] [influence/] \"Em nome dos Arcontes, derrubem {Ruler1.Name}!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1171_3692@BUTTON_3"
msgstr "[reputation8/] [influence/] \"Honrem seus juramentos, ergam-se em armas contra {Ruler2.Name}!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1171_3692@BUTTON_4"
msgstr "[reputation8/] [influence/] \"Pelo bem do reino, aniquilem {Ruler3.Name}!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1171_3692@BUTTON_5"
msgstr "Partir por enquanto."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1171_3692@BUTTON_6"
msgstr "[reputation8/]\"Marchem contra {GLOBAL.UrrathLoreConcept}! Destruam [minorcity/] {House.Name}!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1171_3692@TITLE"
msgstr "Convocar à Cruzada"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1574@BODY_FOOTER"
msgstr "Rodapé"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1574@BODY_HEADER"
msgstr "O {EventHouseLord.Title} de {EventHouse} avança de braços abertos para falar em nome de <<o:EventHouseLord>> {GLOBAL.IndependentCityConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1574@BODY_LORE"
msgstr "\"Glória!\" anuncia {EventHouseLord.Title} {EventHouseLord.FirstName} enquanto <<p:EventHouseLord>> ergue o dedo indicador bem alto, \"Ó Godir, Ó Godir. Louvado seja o grande plano que me agracia com um igual de cultura neste dia.\" <<Cp:EventHouseLord>> estende ambas as mãos e sorri. \"Contemplem, sou {EventHouseLord.TitleName} dos {EventHouseRace}. Digam-me, que fundação construiremos juntos a partir de agora?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1574@BUTTON_0"
msgstr "Veja quais fundações {EventHouse.Name} é digna."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1574@BUTTON_1"
msgstr "\"Você me chama de seu igual? Que curioso.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1574@BUTTON_2"
msgstr "Impressione-os com uma oração sobre Ordem."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1574@BUTTON_3"
msgstr "Persuada-os com um discurso sobre a Sombra."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1574@BUTTON_4"
msgstr "Toque-os com um monólogo sobre o Materium."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1574@BUTTON_5"
msgstr "Encante-os com uma narrativa sobre a Natureza."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1574@BUTTON_6"
msgstr "Deixe-os maravilhados com um discurso sobre o Astral."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1574@BUTTON_7"
msgstr "Convença-os com uma catarse sobre o Caos."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1574@TITLE"
msgstr "Encontro com a Exaltada {EventHouse}"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1769@BODY_FOOTER"
msgstr "A distância pode ser uma bênção. Por enquanto, o Abismo Umbral pode dormir, mas suas forças podem ser esmagadoras se você os despertar sem preparação."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1769@BODY_HEADER"
msgstr "Você se estabeleceu em uma ilha ao largo de {EventRealm}. Uma leve névoa repousa sobre as ilhas ao seu redor, obscurecendo a costa à distância."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1769@BODY_LORE"
msgstr "Você se lembra da descrição do reino que lhe foi dada. Ao norte e ao sul, vê os contornos de ilhas recortadas, pequenos pedaços de terra pontilhando o oceano. A leste, imagina os imponentes Penhascos de Sordünn, reivindicados pelo {GLOBAL.ShadowRealmLoreConcept.Hyperlink}. O oceano os separa de seu alcance—e a você do deles."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1769@BUTTON_0"
msgstr "Devemos preparar nossa invasão do Abismo Umbral."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1769@TITLE"
msgstr "O {EventRealm}"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1771@BODY_FOOTER"
msgstr "Seus soldados varrem o {EventRealm}, eliminando as últimas infestações da influência Umbral. Este [hyperlink,GLOBAL.WorldsWithinLoreConcept]Mundo[/hyperlink] pode se curar mais uma vez."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1771@BODY_HEADER"
msgstr "Você derrotou {Merlin.TitleName} e <<o:Merlin>> as [hyperlink,GLOBAL.ShadowDemonsLoreConcept]forças Umbrais[/hyperlink]. <<Cp:Merlin>> cai no chão. {Sundren.FirstName} e {Julia.FirstName} aparecem e se ajoelham ao lado de <<P:Merlin>>."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1771@BODY_HEADER@NO_SUNDREN"
msgstr "Você derrotou {Merlin.TitleName} e <<o:Merlin>> as [hyperlink,GLOBAL.ShadowDemonsLoreConcept]forças Umbrais[/hyperlink]. <<Cp:Merlin>> cai no chão, enquanto {Julia.FirstName} aparece e se ajoelha ao lado de <<P:Merlin>>."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1771@BODY_LORE"
msgstr "{Julia.FirstName} fecha delicadamente os olhos de <<o:Merlin>>. \"Sinto muito, meu velho amigo.\" <<Cp:Julia>> sussurra, uma única lágrima escorrendo pelo rosto de <<o:Julia>>. {Sundren.FirstName} fixa seu olhar severo em você. \"A Profecia... Tentei fazer o que era certo por meu pai, minha mãe e meu mentor. Talvez eu estivesse errada. Errada em vir aqui, ou em confiar em você.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1771@BODY_LORE@NO_SUNDREN"
msgstr "{Julia.FirstName} fecha delicadamente os olhos de <<o:Merlin>>. \"Sinto muito, meu velho amigo.\" <<Cp:Julia>> sussurra, uma única lágrima escorrendo pelo rosto de <<o:Julia>>. \"Se ao menos o destino tivesse sido mais gentil conosco...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1771@BUTTON_0"
msgstr "Uma vitória duramente conquistada."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1771@TITLE"
msgstr "Uma Morte Vingativa"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1772@BODY_FOOTER"
msgstr "\"Como um gesto de boa vontade, ofereço-lhe o conhecimento para atravessar os mares de Sordünn. Também percebo que pode ter mais perguntas para mim.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1772@BODY_HEADER"
msgstr "Você é abordado por uma mulher élfica régia. A postura de <<Co:Julia>> é orgulhosa, mas seus olhos revelam eras de conflito, perda e esperança."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1772@BODY_LORE"
msgstr "\"Salve, {PlayerLeader.TitleName},\" diz <<p:Julia>>. \"Meu nome é {Julia.Name}, {Julia.Title}. Fui enviada aqui pelos [hyperlink,GLOBAL.ArchonsLoreConcept]Arcontes[/hyperlink] para ajudá-lo neste reino.\" <<Cp:Julia>> olha para a costa ao longe, e sua voz some por um momento. \"Tantos mundos, devastados pela escuridão... Devemos revidar.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1772@BUTTON_0"
msgstr "\"Quem é você?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1772@BUTTON_1"
msgstr "\"Você sabe algo sobre a Profecia que nos trouxe aqui?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1772@BUTTON_2"
msgstr "\"Você já lutou contra o Abismo Umbral antes?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1772@BUTTON_3"
msgstr "\"Aceito sua ajuda. Vamos lutar contra o Abismo Umbral, juntos.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1772@TITLE"
msgstr "A Campeã dos Arcontes"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1773@BODY_FOOTER"
msgstr "\"... Mas acima de tudo, sou mãe. De meus dois filhos: Thannis e [hyperlink,GLOBAL.SundrenLoreConcept]Sundren[/hyperlink]... Em vida, e além.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1773@BODY_HEADER"
msgstr "{Julia.FirstName} sorri com uma tristeza profunda. \"Quem sou eu? Essa é uma pergunta difícil de responder...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1773@BODY_LORE"
msgstr "\"Sou filha do falecido Imperador Inioch de [hyperlink,GLOBAL.AthlaLoreConcept]Athla[/hyperlink], a quem amei e lutei contra. Sou irmã de [hyperlink,GLOBAL.MeandorLoreConcept]Meandor[/hyperlink], contra quem lutei e a quem amei. Sou—\" sua voz falha, por apenas um instante: \"... Viúva de meu amado rei Saridas. Já lutei, amei, segui e reinei. Já vi grandes atrocidades e belas bondades... Já fui uma exilada e uma rainha.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1773@BUTTON_1"
msgstr "\"Você sabe algo sobre a Profecia que nos trouxe aqui?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1773@BUTTON_2"
msgstr "\"Você já lutou contra o Abismo Umbral antes?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1773@BUTTON_3"
msgstr "\"Aceito sua ajuda. Vamos lutar contra o Abismo Umbral, juntos.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1773@TITLE"
msgstr "Rebelde, Rainha, Mãe"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1774@BODY_FOOTER"
msgstr "\"Os Arcontes podem pressionar, mas no fim, é você quem decide se e como essa Profecia será cumprida. Uma grande responsabilidade, {PlayerLeader.TitleName}.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1774@BODY_HEADER"
msgstr "{Julia.FirstName} assente lentamente. \"Conheço a Profecia de Anon e já vi os {GLOBAL.ArchonsLoreConcept.Hyperlink} debaterem sua interpretação.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1774@BODY_LORE"
msgstr "\"Posso ser a Campeã dos Arcontes, mas falo por mim quando digo: as palavras carregam muitos significados, e as Profecias podem ser tão perigosas quanto úteis. Já vi muitos homens e mulheres sábios que se cegaram com seu próprio esplendor. Os Arcontes acreditam que todas as impurezas precisam ser purgadas. Eu acho que a Profecia fala de uma alternativa.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1774@BUTTON_0"
msgstr "\"Quem é você?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1774@BUTTON_2"
msgstr "\"Você já lutou contra o Abismo Umbral antes?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1774@BUTTON_3"
msgstr "\"Aceito sua ajuda. Vamos lutar contra o Abismo Umbral, juntos.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1774@TITLE"
msgstr "Miopia Divina"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1775@BODY_FOOTER"
msgstr "\"Fui encontrada por uma vanguarda de [hyperlink,GLOBAL.ArchonsLoreConcept]Arcontes[/hyperlink] e levada a Emnora. Aprendi muito sobre sua cultura, mas estou feliz por viajar e reconstruir os reinos novamente.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1775@BODY_HEADER"
msgstr "{Julia.FirstName} suspira e assente. \"Já lutei contra as forças do {GLOBAL.ShadowRealmLoreConcept.Hyperlink} muitas vezes antes... Na última vez, eu perdi.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1775@BODY_LORE"
msgstr "\"Quando os [hyperlink,GLOBAL.WorldGateLoreConcept}Portões Mundiais[/hyperlink] se abriram, os Impérios de {GLOBAL.AthlaLoreConcept.Hyperlink} já estavam dilacerados pela guerra e conspiração. Lutamos com bravura, mas... Meu marido, ele foi... assassinado. Eu fui capturada em seu lugar.\" Um tom amargo se insinua na voz de <<o:Julia>> enquanto ela continua: \"Um dia, fui libertada, por um ato tão bondoso quanto tolo.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1775@BUTTON_0"
msgstr "\"Quem é você?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1775@BUTTON_1"
msgstr "\"Você sabe algo sobre a Profecia que nos trouxe até aqui?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1775@BUTTON_3"
msgstr "\"Aceito sua ajuda. Vamos lutar contra o Abismo Umbral, juntos.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1775@TITLE"
msgstr "Prisioneira de Lithyl"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1776@BODY_FOOTER"
msgstr "{Julia.FirstName} suplica: \"Imploro que investigue este chamado, {PlayerLeader.TitleName}. Sinto que é importante.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1776@BODY_HEADER"
msgstr "Enquanto viajam pelo {EventRealm}, {Julia.FirstName} entra em contato com você. \"{PlayerLeader.FirstName}, percebo que devemos focar em nossa missão, mas sinto outra presença por perto.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1776@BODY_LORE"
msgstr "\"Algo, ou alguém, está me chamando do {GLOBAL.ShadowRealmLoreConcept.Hyperlink}. Minha natureza rejeita a escuridão que sinto, e ainda assim algo dentro de mim me impele a investigar. Parece distorcido, mas familiar, quase como se... Não, não devo ter esperanças em vão...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1776@BUTTON_0"
msgstr "\"Vou considerar isso.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1776@TITLE"
msgstr "Luz na Escuridão"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1777@BODY_FOOTER"
msgstr "Após um momento, o tom de Julia se torna severo: \"Ouvi muito sobre suas empreitadas, Sundren... E a ira que provoca.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1777@BODY_HEADER"
msgstr "Você derrotou o último [hyperlink,GLOBAL.ShadowDemonsLoreConcept}Demônio Umbral[/hyperlink] que ameaçava a entidade escondida na torre de vigia. Agora, uma figura emerge dela."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1777@BODY_LORE"
msgstr "Você reconhece a figura como uma elfa, envolta em sombras. {Julia.FirstName} ofega. \"... Sundren? É você mesmo?\"[br/]O olhar severo da elfa sombria se suaviza e seus olhos se arregalam. \"Mãe?!\" {Sundren.FirstName} exclama, e as duas finalmente se abraçam. \"Percorri o [hyperlink,GLOBAL.AstralSeaLoreConcept}Mar Astral[/hyperlink] à sua procura,\" {Sundren.FirstName} diz por fim.[br/]{Julia.FirstName} assente, com lágrimas nos olhos. \"Minha filha, quanta dor você viu.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1777@BUTTON_0"
msgstr "Permita que as duas conversem."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1777@BUTTON_1"
msgstr "\"Não temos tempo para isso. Diga-me por que está aqui, Sundren.\" [Pular]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1777@TITLE"
msgstr "Luz na Escuridão: Consequências"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1778@BODY_FOOTER"
msgstr "\"Há uma torre de vigia, onde fiz minha resistência. Liberte-me, e ficarei em dívida com você.\" A voz faz uma pausa. \"... Por favor.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1778@BODY_HEADER"
msgstr "Suas tropas adentram o {GLOBAL.ShadowRealmLoreConcept.Hyperlink}. Imediatamente, um sussurro chega até você, crescendo até se tornar uma voz etérea carregada pelo ar pesado do Abismo Umbral."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1778@BODY_LORE"
msgstr "\"Estou em uma missão importante que mudará a guerra contra o {GLOBAL.ShadowRealmLoreConcept.Hyperlink}. Mas esses malditos {GLOBAL.ShadowDemonsLoreConcept.Hyperlink} têm se mostrado... desafiadores. Ajude-me, para que eu possa concluir minha missão.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1778@BUTTON_0"
msgstr "\"Vou considerar isso.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1778@TITLE"
msgstr "Um Brilho na Escuridão: No Abismo"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1779@BODY_FOOTER"
msgstr "\"{Merlin.FirstName} tenta corromper as Afinidades no {EventRealm}. Com o poder do {GLOBAL.EndailonLoreConcept.Hyperlink}, acredito que podemos quebrar a influência de Urrath sobre ele.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1779@BODY_HEADER"
msgstr "Sundren continua: \"{Merlin.FirstName} é atualmente o [hyperlink,GLOBAL.UrrathLoreConcept]escravo[/hyperlink] mais poderoso e general de Urrath. O domínio da magia de <<Co:Merlin>> deu ao {GLOBAL.ShadowRealmLoreConcept.Hyperlink} oportunidades terríveis.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1779@BODY_LORE"
msgstr "\"{Merlin.FirstName} usou este reino para iniciar experimentos, a fim de corromper as outras {GLOBAL.AffinitiesLoreConcept.Hyperlink} e até mesmo os próprios {GLOBAL.ArchonsLoreConcept.Hyperlink}. Mas essa conexão com as magias superiores também nos oferece uma oportunidade.\" {Sundren.FirstName} ergue o queixo com orgulho. \"Quando um portal é aberto, dois lados podem passar. Podemos usar os poderes das Afinidades contra {GLOBAL.UrrathLoreConcept.Hyperlink} e quebrar seu domínio sobre {Merlin.FirstName}.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1779@BUTTON_0"
msgstr "\"Continue...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1779@TITLE"
msgstr "Através da Luz Fragmentada"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1780@BODY_FOOTER"
msgstr "\"Com o poder do {GLOBAL.EndailonLoreConcept.Hyperlink} ao nosso lado, podemos confrontar {Merlin.FirstName} em sua capital... e quebrar o domínio de [hyperlink,GLOBAL.UrrathLoreConcept]Urrath[/hyperlink] sobre ele.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1780@BODY_HEADER"
msgstr "Você coletou e canalizou todos os seis Aspectos de [hyperlink,GLOBAL.AffinitiesLoreConcept]Afinidade[/hyperlink]. {Sundren.FirstName} se aproxima de você."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1780@BODY_LORE"
msgstr "\"Agora que você tem a atenção de todos os {GLOBAL.EndailonLoreConcept.Hyperlink}, podemos desfazer a corrupção de Merlin... tanto a dele sobre seu reino quanto a corrupção de [hyperlink,GLOBAL.UrrathLoreConcept]Urrath[/hyperlink] sobre ele. Isso exigirá que o enfrentemos. Não há dúvida de que ele resistirá...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1780@BUTTON_0"
msgstr "\"Avante.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1780@TITLE"
msgstr "Através da Luz Fragmentada: Concluído"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1781@BODY_FOOTER"
msgstr "Seus soldados varrem o {EventRealm}, eliminando as últimas infestações da influência Umbral. {Merlin.FirstName} e este [hyperlink,GLOBAL.WorldsWithinLoreConcept]Mundo[/hyperlink] podem se curar mais uma vez."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1781@BODY_HEADER"
msgstr "Você decidiu conceder misericórdia a {Merlin.FirstName} e encerrar seu ataque mágico contra ele. {Sundren.FirstName} e {Julia.FirstName} ajoelham-se ao lado do feiticeiro corrompido."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1781@BODY_LORE"
msgstr "\"Sua respiração está fraca, mas ele vive,\" diz {Julia.FirstName}. \"O custo da misericórdia... A Profecia foi cumprida.\"[br/]{Sundren.FirstName} assente. \"O caminho para sua restauração será árduo, mas pelo menos haverá esperança para ele.\" Ela olha para você. \"Obrigada, {PlayerLeader.FirstName}, por lhe conceder essa chance.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1781@BUTTON_0"
msgstr "Uma vitória conquistada a duras penas."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1781@BUTTON_1"
msgstr "não, ele merece morrer"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1781@TITLE"
msgstr "Misericórdia e Restauração"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1783@BODY_FOOTER"
msgstr "\"Que Urrath abrace tudo o que é e será. Essas lutas mesquinhas... Tudo será desfeito na paz do Vazio.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1783@BODY_HEADER"
msgstr "Das trevas arcanas que pairam sobre o {EventRealm}, surge uma figura encapuzada. \"Tanta perseverança, tanta... Desafio.\" diz {Merlin.FirstName}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1783@BODY_LORE"
msgstr "<<Cg:sad gaze^n,Merlin>> pousa sobre você. \"Você não pode deter a escuridão devoradora. Veja como até mesmo os poderosos Titãs dos {GLOBAL.ArchonsLoreConcept.Hyperlink} podem cair...\" {Merlin.FirstName} faz um gesto e outro Governante aparece diante de você, um [hyperlink,GLOBAL.RevenantsLoreConcept]Renegado[/hyperlink], cujo olhar morto recai sobre você friamente. \"{Revenant.FirstName} agora também serve a Urrath, assim como todos nós serviremos. Através de nosso trabalho, tudo deixará de existir.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1783@BUTTON_0"
msgstr "\"Eu nunca me curvarei a um feiticeiro caído como você.\" [influence/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1783@BUTTON_1"
msgstr "Permita que Urrath acaricie sua mente [knowledge/], ainda que por um momento... [evilact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1783@TITLE"
msgstr "O Domínio das Trevas"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1784@BODY_FOOTER"
msgstr "A expressão de Julia se endurece. \"Você tirou essa escolha de mim, {Merlin.FirstName}, tanto quanto [hyperlink,GLOBAL.LithylTrueLoreConcept]Lithyl[/hyperlink] fez. E agora todos os outros [hyperlink,GLOBAL.WorldsWithinLoreConcept]Mundos[/hyperlink] sofrem por causa dos talentos que você permitiu que {GLOBAL.UrrathLoreConcept.Hyperlink} corrompesse.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1784@BODY_HEADER"
msgstr "\"Oh, Merlin... O que aconteceu com você.\" {Julia.FirstName} aparece, e {Merlin.FirstName} se encolhe, assustado.[br/]\"Julia? Você está- Eu não queria que isso acontecesse.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1784@BODY_LORE"
msgstr "\"E, no entanto, você escolheu isso.\" {Julia.FirstName} diz tristemente. \"O que você fez?\"[br/]\"Eu fiz isso por você,\" {Merlin.FirstName} protesta. \"Por...\"[br/]\"Suas ações podem ter vindo do amor, mas causaram tanto sofrimento.\" {Julia.FirstName} diz. \"Eu nunca teria concordado com o que você sacrificou para me conceder minha liberdade... E acho que você sabia.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1784@BUTTON_0"
msgstr "\"Talvez a morte seja realmente uma misericórdia.\" [unit/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1784@BUTTON_3"
msgstr "\"Nunca é tarde demais para corrigir o que está errado.\" [relationLvl3/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1784@TITLE"
msgstr "Amor e Sofrimento"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1785@BODY_FOOTER"
msgstr "\"Eu me recuso a matar um dos maiores heróis de [hyperlink,GLOBAL.AthlaLoreConcept]Athla[/hyperlink]. É por isso que estou aqui. Acredito que posso salvar {Merlin.FirstName}, em vez de destruí-lo.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1785@BODY_HEADER"
msgstr "{Sundren.FirstName} encontra o olhar severo de Julia. \"Eu não tomei minhas decisões levianamente, mãe... Estou aqui para moldar a guerra contra {GLOBAL.UrrathLoreConcept.Hyperlink}.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1785@BODY_LORE"
msgstr "{Sundren.FirstName} faz uma pausa por um momento. \"Você sabe contra quem estamos lutando aqui, no {EventRealm}? Contra quem os {GLOBAL.ArchonsLoreConcept.Hyperlink} pediram para você lutar? Mãe, o maior escravo de Urrath é {Merlin.FirstName}. É ele quem pedem para você destruir.\" {Julia.FirstName} empalidece e a expressão de Sundren se escurece enquanto ela continua: \"Eu me recuso a participar da roda interminável de guerra e destruição.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1785@BUTTON_0"
msgstr "Continue ouvindo."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1785@TITLE"
msgstr "O Caminho do Destino se Divide"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1786@BODY_FOOTER"
msgstr "\"Por meio deste, concedo a você, {PlayerLeader.TitleName}, o Aspecto da Sombra, e minha ajuda.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1786@BODY_HEADER"
msgstr "{Sundren.FirstName} assente. \"Este reino contém Aspectos de cada [hyperlink,GLOBAL.AffinitiesLoreConcept]Afinidade[/hyperlink]. Canalizá-los atrai a atenção dos {GLOBAL.EndailonLoreConcept.Hyperlink}.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1786@BODY_LORE"
msgstr "\"Já me comprometi demais com o Aspecto da Sombra para canalizar os outros. E, vendo como você atravessou o {GLOBAL.ShadowRealmLoreConcept.Hyperlink} onde eu não consegui... Talvez seja hora de depositar minha fé em outro {GLOBAL.GodirLoreConcept.Hyperlink}. Posso abrir <<m:EventGate>> em direção aos Aspectos, perto do antigo local de pesquisa de Merlin. Mas peço que você os canalize e encontre um caminho de redenção para {Merlin.FirstName}, meu mentor... meu amigo.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1786@BUTTON_0"
msgstr "\"Junte-se a mim como Herói, então, {Sundren.FirstName}.\" [unit/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1786@BUTTON_3"
msgstr "\"Não preciso da sua ajuda.\" [influence/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1786@TITLE"
msgstr "O Aspecto da Sombra"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1822@BODY_FOOTER"
msgstr "A sensação desaparece, mas você percebe que alguém — ou algo — está observando você, pedindo para que prossiga pelos salões congelados."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1822@BODY_HEADER"
msgstr "Seu exército, após atravessar grandes picos congelados, adentra um enorme salão. Vários desmoronamentos bloqueiam seu caminho, mas uma corrente de ar gelado sugere uma passagem adiante."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1822@BODY_LORE"
msgstr "Você percebe que essas paredes não são naturais. Foram finamente trabalhadas por mãos maiores do que as de qualquer mortal comum. De repente, você é tomado por sua beleza. A qualidade do material, o artesanato, a promessa de tesouros inestimáveis no fim deste salão... Isso o chama para seguir adiante. Para descobrir seu criador."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1822@BUTTON_0"
msgstr "Não há para onde ir, a não ser adiante."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1822@TITLE"
msgstr "Impérios Gigantes Caem"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1823@BODY_FOOTER"
msgstr "O Gigante despertado olha para você com paciência infinita. \"Por que está aqui, neste reino de poeira e ruínas?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1823@BODY_HEADER"
msgstr "Você adentra os grandes salões do Gigante do Gelo que dorme aqui e percebe como as paredes e o chão começam a tremer enquanto algo desperta nas profundezas."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1823@BODY_LORE"
msgstr "\"Godir\", o Gigante ressoa. \"Meu povo {GiantRace} e eu dormimos no gelo para que a [hyperlink,GLOBAL.ShadowRealmLoreConcept]aflição das trevas[/hyperlink] não nos alcançasse. Vi muitos Impérios de Gigantes caírem, o meu não será um deles. Não enfrentarei a escuridão sozinho. No entanto, vocês cavaram e rasgaram para nos alcançar, para nos despertar. Por quê?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1823@BUTTON_0"
msgstr "\"Fui enviado aqui por Magehaven.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1823@BUTTON_1"
msgstr "\"Luto para ajudar os Arcontes.\" [knowledge/] [relationLvl-3/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1823@BUTTON_2"
msgstr "\"Estou aqui pela glória de Myrrida!\" [relationLvl3/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1823@BUTTON_3"
msgstr "\"Estou aqui para salvar almas perdidas.\" [goodact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1823@BUTTON_4"
msgstr "\"Estou aqui apenas pela minha própria glória!\" [influence/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1823@BUTTON_5"
msgstr "\"Estou aqui para formar uma aliança contra o Abismo Umbral!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1823@TITLE"
msgstr "Impérios de Gigantes Caem: {Giant.FirstName}"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1828@BODY_FOOTER"
msgstr "Você se aproxima da capital congelada do Gigante que um dia governou aqui. Uma sensação retumbante de tempos antigos o impulsiona adiante, prometendo tesouros e maravilhas àquele que despertar <<P:Giant>>."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1828@BODY_HEADER"
msgstr "Você lutou e abriu caminho através da caverna congelada. Estranhamente, o frio só parece aumentar quanto mais fundo você vai."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1828@BODY_LORE"
msgstr "As paredes cobertas de gelo contam a história dos [hyperlink,GLOBAL.GiantKingLoreConcept]Reis Gigantes[/hyperlink] de {GLOBAL.MyrridaLoreConcept.Hyperlink}, suas guerras contra {GLOBAL.DragonsLoreConcept.Hyperlink} e {GLOBAL.ArchonsLoreConcept.Hyperlink}, e sua inevitável queda. Um [hyperlink,GLOBAL.GiantsLoreConcept]Gigante[/hyperlink] se ergueu no alto dos picos montanhosos e assistiu enquanto o reino era finalmente invadido pelo {GLOBAL.ShadowRealmLoreConcept.Hyperlink}. O último entalhe mostra como o Gigante e seu povo se esconderam no subterrâneo e se envolveram em gelo."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1828@BUTTON_0"
msgstr "Encontrarei este Gigante adormecido."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1828@TITLE"
msgstr "Impérios de Gigantes Caem: Sonhos Congelados"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1829@BODY_FOOTER"
msgstr "\"O artesão do mundo, mestre da criação,\" {Giant.FirstName} sussurra. \"Ele lhe concede sua bênção. Uma grande honra.\" Você sente o poder do criador fluir através de si. Você..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1829@BODY_HEADER"
msgstr "{Giant.TitleName} assente lentamente. \"Entendo...\" Então <<p:Giant>> se agita quando algo mais domina seus sentidos."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1829@BODY_LORE"
msgstr "Estalactites de gelo se estilhaçam e rochas desabam enquanto um tremor percorre o subterrâneo. Você vê rachaduras nas paredes se abrirem e revelarem veios de minerais preciosos. Sente o chão sob seus pés se mover e moldar, como se o próprio reino respirasse fundo. Você sente a grandiosidade das montanhas acima e a pressão da terra derretida abaixo. Argila infinita, potencial infinito."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1829@BUTTON_0"
msgstr "... Extrair riquezas [gold/] da terra."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1829@BUTTON_3"
msgstr "... Moldar um servo de metal inanimado. [unit/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1829@BUTTON_4"
msgstr "... Invocar um criador de pedra e rocha. [unit/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1829@BUTTON_5"
msgstr "... Abençoar suas cidades com prosperidade. [structureprod/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1829@TITLE"
msgstr "O Aspecto do Materium"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1835@BODY_FOOTER"
msgstr "\"Não sinto alegria em ver nossos velhos inimigos transformados em escravos de [hyperlink,GLOBAL.UrrathLoreConcept]Urrath[/hyperlink]. Mas não hesitarei em abatê-los.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1835@BODY_HEADER"
msgstr "Você sente a presença de {Giant.FirstName}. \"{Revenant.FirstName}...\" <<Cp:Giant>> rosna. \"Eu me lembro de <<P:Revenant>>. Um Titã dos {GLOBAL.ArchonsLoreConcept.Hyperlink}, que caiu lutando contra meu povo.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1835@BODY_LORE"
msgstr "\"Agora, {Revenant.FirstName} retorna dos mortos, uma piada macabra do destino. Esses {GLOBAL.RevenantsLoreConcept.Hyperlink} me lembram das magias amaldiçoadas desesperadas dos {GLOBAL.TraitorKingsLoreConcept.Hyperlink} de meu [hyperlink,GLOBAL.GiantsLoreConcept]povo[/hyperlink]. Teriam os Reis Traidores inspirado o toque maculado de [hyperlink,GLOBAL.UrrathLoreConcept]Urrath[/hyperlink] e esses Arcontes caídos? O conhecimento de meu povo teria trazido a ruína deste reino?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1835@BUTTON_0"
msgstr "\"Nossa luz sagrada purificará a aflição deste reino.\" [orderboon/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1835@BUTTON_3"
msgstr "\"Só através das magias selvagens podemos nos purgar de qualquer escravidão!\" [chaosboon/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1835@BUTTON_4"
msgstr "\"O conhecimento que guardamos nos protegerá contra este destino amaldiçoado.\" [astralboon/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1835@BUTTON_5"
msgstr "\"Mesmo através do Abismo Umbral, a natureza prevalecerá.\" [natureboon/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1835@BUTTON_6"
msgstr "\"Urrath pode corromper tudo, exceto ouro e rocha, então é para ouro e rocha que devemos nos voltar.\" [materiumboon/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1835@BUTTON_7"
msgstr "\"Só ao aceitar nossa própria sombra podemos aprender a atravessá-la.\" [shadowboon/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1835@BUTTON_8"
msgstr "\"Através de laços fortes [relationLvl3/] podemos superar qualquer ameaça.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1835@TITLE"
msgstr "Ascensão Máxima, Queda Profunda"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1841@BODY_FOOTER"
msgstr "\"O caminho adiante será arriscado e custoso,\" {Sundren.FirstName} lhe adverte. \"Um passo em falso pode significar que tudo foi em vão. Mas é o único caminho.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1841@BODY_HEADER"
msgstr "Seu cerco a {MerlinCapital} está concluído. Suas tropas se preparam para uma possível batalha final no coração do {GLOBAL.ShadowRealmLoreConcept.Hyperlink} neste reino."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1841@BODY_LORE"
msgstr "\"Esta é nossa chance,\" diz {Sundren.FirstName}. \"Com suas defesas rompidas, encontrei um caminho para dentro de {MerlinCapital}. Em seu trono, podemos usar <<g:connection^n,Merlin>> para acessar magias superiores e acabar com o domínio de [hyperlink,GLOBAL.UrrathLoreConcept]Urrath[/hyperlink] sobre ele!\"[br/]{Julia.FirstName} assente lentamente. \"Os {GLOBAL.ArchonsLoreConcept.Hyperlink} desejam que eliminemos qualquer [hyperlink,GLOBAL.ShadowRealmLoreConcept]agente Umbral[/hyperlink] sem piedade. E, no entanto... Há eras, {Merlin.FirstName} usou sua magia para me salvar da possessão. Talvez isso possa ser feito.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1841@BUTTON_0"
msgstr "Iniciar o ritual para libertar Merlin do domínio de Urrath."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1841@BUTTON_3"
msgstr "\"Não, Merlin deve ser derrotado e o Abismo Umbral erradicado.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1841@BUTTON_4"
msgstr "a"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1841@BUTTON_5"
msgstr "a"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1841@TITLE"
msgstr "O Preço da Misericórdia"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1850@BODY_FOOTER"
msgstr "{Merlin.FirstName} se conecta ao {GLOBAL.AstralSeaLoreConcept.Hyperlink}. Energias arcanas se retorcem, e visões de lugares muito além do seu alcance ameaçam inundar sua mente. Você..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1850@BODY_HEADER"
msgstr "Com esforço, {Sundren.FirstName} envolve você e {Julia.FirstName} em sombras. Vocês se esgueiram por {GLOBAL.ShadowDemonsLoreConcept.Hyperlink} e guardas da cidade, chegando ao coração de {MerlinCapital}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1850@BODY_LORE"
msgstr "Assim que entram na sala do trono, o ar pesado do {GLOBAL.ShadowRealmLoreConcept.Hyperlink} recai sobre vocês. \"Vocês,\" suspira {Merlin.FirstName}. \"Por que insistem? É tarde demais, meus experimentos estão quase concluídos. {GLOBAL.UrrathLoreConcept.Hyperlink} alcança tudo... Contemplem.\"[br/]Você sente {Merlin.FirstName} invocar uma forma distorcida de magia pura. \"Lá está,\" grita {Sundren.FirstName}, \"essa conexão! Canalize seu Aspecto para combater a corrupção de Urrath!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1850@BUTTON_0"
msgstr "... Canalizar o Aspecto do Caos."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1850@BUTTON_10"
msgstr "Canalizar todos os Aspectos (BOTÃO TEMPORÁRIO)"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1850@BUTTON_3"
msgstr "... Canalizar o Aspecto da Ordem."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1850@BUTTON_5"
msgstr "... Canalizar o Aspecto do Astral."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1850@BUTTON_6"
msgstr "... Canalizar o Aspecto do Materium."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1850@BUTTON_7"
msgstr "... Canalizar o Aspecto da Natureza."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1850@BUTTON_8"
msgstr "... Canalizar o Aspecto da Sombra."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1850@BUTTON_9"
msgstr "... Desista e enfrente Merlin diretamente, como os Arcontes pretendiam."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1850@TITLE"
msgstr "Conexões Corrompidas"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1851@BODY_FOOTER"
msgstr "{Sundren.FirstName} grita e pisca, afastando você para fora de {MerlinCapital}. Após um breve silêncio, Julia diz, suavemente: \"Parece que só há um caminho agora. {Merlin.FirstName} precisa ser derrotado.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1851@BODY_HEADER"
msgstr "Você tenta banir a corrupção de {GLOBAL.UrrathLoreConcept.Hyperlink}, mas o Aspecto canalizado não corresponde àquele corrompido por {Merlin.FirstName}. Sua tentativa falha."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1851@BODY_LORE"
msgstr "{Sundren.FirstName} xinga. \"Não, não! Isso deveria funcionar! {Merlin.FirstName}, você me ensinou isso! Você deveria se libertar!\"[br/]\"Garota tola,\" {Merlin.FirstName} suspira. \"Até sua luz vai tremular e morrer no abraço de Urrath...\"[br/]{Julia.FirstName} fecha os olhos, incapaz de continuar olhando, enquanto tentáculos sombrios ameaçam envolvê-la e a você."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1851@BUTTON_0"
msgstr "Que assim seja."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1851@TITLE"
msgstr "Em Vão"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1854@BODY_FOOTER"
msgstr "{Merlin.FirstName} invoca forças de magia selvagem. Demônios aparecem, gritando enquanto tentáculos arcanos rasgam sua carne infernal. A loucura ameaça dominá-lo. Você..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1854@BODY_HEADER"
msgstr "{Merlin.FirstName} faz uma careta quando você canaliza o poder arcano do Astral. Sobrepujado por sua força, a conexão corrompida de Merlin é substituída por algo... puro."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1854@BODY_LORE"
msgstr "Um tentáculo irritado rapidamente quebra a conexão, e {Merlin.FirstName} acessa uma fonte diferente de magia. Você sente a temperatura na sala do trono começar a subir, vê como gavinhas corrompidas alcançam figuras demoníacas que surgem do calor. Anarquia, destruição e fúria, corrompidas pela passividade, desdém e o desejo pelo completo desfazer da criação."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1854@BUTTON_0"
msgstr "... Canalize o Aspecto do Caos."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1854@BUTTON_3"
msgstr "... Canalize o Aspecto da Ordem."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1854@BUTTON_5"
msgstr "... Canalize o Aspecto do Astral."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1854@BUTTON_6"
msgstr "... Canalize o Aspecto do Materium."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1854@BUTTON_7"
msgstr "... Canalize o Aspecto da Natureza."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1854@BUTTON_8"
msgstr "... Canalize o Aspecto da Sombra."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1854@BUTTON_9"
msgstr "... Desista e enfrente Merlin diretamente, como os Arcontes pretendiam."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1854@TITLE"
msgstr "Conexões Corrompidas"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1855@BODY_FOOTER"
msgstr "Plantas corrompidas explodem em seu rastro. Você ouve o lamento dos animais, desesperados para escapar do ar venenoso que enche a sala. Você..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1855@BODY_HEADER"
msgstr "Você canaliza o Caos puro, o calor de sua paixão queimando a corrupção. {Merlin.FirstName} grita enquanto as emoções que {GLOBAL.UrrathLoreConcept.Hyperlink} havia suprimido por tanto tempo o invadem."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1855@BODY_LORE"
msgstr "{Merlin.FirstName} rompe sua conexão com o Caos. Seu olhar se fixa em {Julia.FirstName}. \"Você,\" ele diz a ela com uma voz que não é sua, \"você também cairá... Filha de Inioch.\" O ar fica pesado enquanto espinhos brotam do chão, brilhando com veneno escuro. {Julia.FirstName} se encolhe ao se preparar contra a corrupção de seus poderes."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1855@BUTTON_0"
msgstr "... Canalize o Aspecto do Caos."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1855@BUTTON_3"
msgstr "... Canalize o Aspecto da Ordem."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1855@BUTTON_5"
msgstr "... Canalize o Aspecto do Astral."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1855@BUTTON_6"
msgstr "... Canalize o Aspecto do Materium."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1855@BUTTON_7"
msgstr "... Canalizar o Aspecto da Natureza."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1855@BUTTON_8"
msgstr "... Canalizar o Aspecto da Sombra."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1855@BUTTON_9"
msgstr "... Desistir e enfrentar Merlin diretamente, como os Arcontes pretendiam."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1855@TITLE"
msgstr "Conexões Corrompidas"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1856@BODY_FOOTER"
msgstr "Sua armadura e o chão sob seus pés começam a se esfarelar e decair sob a pressão arcana de Merlin. Riqueza, o poder dos elementos, nada importa sob o olhar de Urrath. Você..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1856@BODY_HEADER"
msgstr "Você canaliza o crescimento da Natureza, curando o chão sob seus pés e espalhando uma aura revigorante ao seu redor, {Julia.FirstName} e {Sundren.FirstName}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1856@BODY_LORE"
msgstr "{Julia.FirstName} suspira aliviada. \"Você não me pegará, {GLOBAL.UrrathLoreConcept.Hyperlink}!\" Ela grita, canalizando crescimentos protetores ao seu redor e de {Merlin.FirstName}. \"Merlin! Reaja! Eu sei que você consegue!\"[br/]{Merlin.FirstName} abre a boca para falar, mas um tentáculo enfurecido corta sua conexão com a natureza. {Merlin.FirstName} geme e o chão começa a tremer, esmagando as jovens plantas que crescem na sala do trono."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1856@BUTTON_0"
msgstr "... Canalizar o Aspecto do Caos."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1856@BUTTON_3"
msgstr "... Canalizar o Aspecto da Ordem."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1856@BUTTON_5"
msgstr "... Canalizar o Aspecto do Astral."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1856@BUTTON_6"
msgstr "... Canalizar o Aspecto do Materium."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1856@BUTTON_7"
msgstr "... Canalizar o Aspecto da Natureza."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1856@BUTTON_8"
msgstr "... Canalizar o Aspecto da Sombra."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1856@BUTTON_9"
msgstr "... Desistir e enfrentar Merlin diretamente, como os Arcontes pretendiam."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1856@TITLE"
msgstr "Conexões Corrompidas"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1857@BODY_FOOTER"
msgstr "{Merlin.FirstName} tenta corromper outra Afinidade. Sua autoridade o sufoca, crava-se em sua alma, substituindo a fé por servidão irracional. Você..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1857@BODY_HEADER"
msgstr "Você canaliza a força do Materium. A terra ruge, uma tempestade açoita {Merlin.FirstName}, e o edifício se protege contra o {GLOBAL.ShadowRealmLoreConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1857@BODY_LORE"
msgstr "{Merlin.FirstName} grita. Desesperado e sobrecarregado, ele busca outra Afinidade, antes de olhar para você com uma autoridade recém-descoberta. Você sente uma luz, como a luz de um eclipse ou de um sol moribundo. Ela é brilhante—brilhante demais, e errada, desprovida de qualquer calor. \"Onde as chamas queimam mais intensamente, as sombras criam raízes mais profundas,\" Merlin murmura. \"Até mesmo os {GLOBAL.ArchonsLoreConcept.Hyperlink}... Devem cair...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1857@BUTTON_0"
msgstr "... Canalizar o Aspecto do Caos."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1857@BUTTON_3"
msgstr "... Canalizar o Aspecto da Ordem."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1857@BUTTON_5"
msgstr "... Canalizar o Aspecto do Astral."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1857@BUTTON_6"
msgstr "... Canalizar o Aspecto do Materium."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1857@BUTTON_7"
msgstr "... Canalizar o Aspecto da Natureza."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1857@BUTTON_8"
msgstr "... Canalizar o Aspecto da Sombra."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1857@BUTTON_9"
msgstr "... Desistir e enfrentar Merlin diretamente, como os Arcontes pretendiam."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1857@TITLE"
msgstr "Conexões Corrompidas"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1858@BODY_FOOTER"
msgstr "\"Rápido, {PlayerLeader.FirstName}, canalize o Aspecto final! Ele não pode escapar da Sombra, o {GLOBAL.ShadowRealmLoreConcept.Hyperlink} está ligado a ela!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1858@BODY_HEADER"
msgstr "Você canaliza o Aspecto da Ordem, sua luz ardente queima toda corrupção que o ameaçava, e a você."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1858@BODY_LORE"
msgstr "{Merlin.FirstName} grita de dor e rapidamente corta a conexão divina. Apenas uma Afinidade permanece ligada a {Merlin.FirstName} e ao {GLOBAL.ShadowRealmLoreConcept.Hyperlink}. A mais sombria, suas raízes entrelaçadas com o Abismo. \"Morte e gelo,\" {Merlin.FirstName} tosse, \"nunca o começo, nunca o fim...\"[br/]{Sundren.FirstName} rosna. \"Você pode ter corrompido o {GLOBAL.AstralVoidLoreConcept.Hyperlink} de onde rastejou, mas sabe que o {GLOBAL.EndailonLoreConcept.Hyperlink} pode lutar contra você.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1858@BUTTON_0"
msgstr "... Canalizar o Aspecto do Caos."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1858@BUTTON_3"
msgstr "... Canalizar o Aspecto da Ordem."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1858@BUTTON_5"
msgstr "... Canalizar o Aspecto do Astral."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1858@BUTTON_6"
msgstr "... Canalizar o Aspecto do Materium."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1858@BUTTON_7"
msgstr "... Canalizar o Aspecto da Natureza."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1858@BUTTON_8"
msgstr "... Canalizar o Aspecto da Sombra."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1858@BUTTON_9"
msgstr "... Desistir e lutar diretamente contra Merlin, como os Arcontes pretendiam."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1858@TITLE"
msgstr "Conexões Corrompidas"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1859@BODY_FOOTER"
msgstr "Finalmente, o olhar de Merlin se torna aguçado e, pela primeira vez, ele parece realmente ver aqueles à sua frente. \"{Sundren.FirstName}... {Julia.FirstName}? O que eu... eu...\" Ele ofega e desaba."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1859@BODY_HEADER"
msgstr "Você canaliza o Aspecto da Sombra, seu poder puro colidindo com a corrupção de {GLOBAL.UrrathLoreConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1859@BODY_LORE"
msgstr "{Merlin.FirstName} grita, e tentáculos desesperados atacam a conexão, mas o {GLOBAL.ShadowRealmLoreConcept.Hyperlink} está muito entrelaçado com a Sombra para ser arrancado. Membros arcanos congelam e decaem na escuridão fria enquanto a Sombra recupera sua força pura, rastejando em direção a Merlin, rasgando seu poder arcano corrompido. Com todas as Afinidades combinadas, sua conexão com {GLOBAL.UrrathLoreConcept.Hyperlink} enfraquece."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1859@BUTTON_0"
msgstr "Conceder misericórdia a Merlin e colocá-lo em um caminho de restauração."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1859@BUTTON_6"
msgstr "Derrotar Merlin e bani-lo para o vazio."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1859@BUTTON_9"
msgstr "c"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1859@TITLE"
msgstr "Corrupção Cortada"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1865@BODY_FOOTER"
msgstr "\"Você encontrará nosso campeão no norte. <<Cp:Julia>> pode não ser um Arconte, mas <<p:Julia>> será uma aliada poderosa para sua causa.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1865@BODY_HEADER"
msgstr "Antes que você possa investigar mais, um sino divino interrompe seus pensamentos e você é contatado por um [hyperlink,GLOBAL.ArchonsLoreConcept]Arconte[/hyperlink]."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1865@BODY_LORE"
msgstr "\"Salve, {PlayerLeader.TitleName}. Eu sou {Anon.FirstName}, {Anon.Title}. Fui eu quem registrou a Profecia que o trouxe aqui. É um estranho capricho do destino escrever a própria Profecia que me impede de agir sobre ela. Infelizmente, como um Arconte, devo cumpri-la e, em vez disso, oferecerei insights onde puder.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1865@BUTTON_0"
msgstr "\"Conte-me mais sobre essa Profecia.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1865@BUTTON_1"
msgstr "\"Muito bem, encontrarei esse aliado.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1865@TITLE"
msgstr "Mandato Divino"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1870@BODY_FOOTER"
msgstr "\"O {EventRealm} costumava fazer parte de {GLOBAL.MyrridaLoreConcept.Hyperlink}. Acreditamos que o Sangue do Traidor está ligado àqueles que apoiam {GLOBAL.UrrathLoreConcept.Hyperlink}. Por fim, nós {GLOBAL.ArchonsLoreConcept.Hyperlink} nos consideramos a guarda divina, e você, {PlayerLeader.TitleName}, é o novo poder a ascender.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1870@BODY_HEADER"
msgstr "{Anon.FirstName} assente gravemente, recordando sua própria Profecia:"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1870@BODY_LORE"
msgstr "\"Miopia Divina; Equilíbrio Acorrentado;[br/]Impérios Gigantes Caem; Trevas Reinam;[br/]Do Sangue do Traidor; O Rastro do Destino se Divide;[br/]Corrupção Purificada, Através da Luz Fraturada;[br/]A Guarda Divina Deve Descansar; Para Novos Poderes Ascenderem;[br/]Quem Pesa o Custo da Misericórdia; Contra um Fim Vingativo.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1870@BUTTON_0"
msgstr "\"Muito bem.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1870@TITLE"
msgstr "A Profecia de Anon"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1878@BODY_FOOTER"
msgstr "{Sundren.Name} foi ferida, mas escapou da morte. Levará algum tempo para que ela recupere suas forças."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1878@BODY_HEADER"
msgstr "{Sundren.TitleName} foi derrotada em batalha sob seu comando!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1878@BODY_LORE"
msgstr "Por esforço, sorte ou algo completamente diferente, ela conseguiu sobreviver ao ataque e voltou em segurança, onde aparece em uma nuvem de sombras. Ela faz uma careta, uma expressão mais sombria marcando seu rosto antes que as sombras desapareçam e ela se volte para você novamente. \"Eu suportei muitas dificuldades no {GLOBAL.AstralVoidLoreConcept.Hyperlink}. Ele ainda não me reivindicará.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1878@BUTTON_0"
msgstr "Que assim seja."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1878@TITLE"
msgstr "Sundren Derrotada"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1881@BODY_FOOTER"
msgstr "\"O Alto Conselho dos Arquons insta você a manter o curso de sua missão: destruir o {GLOBAL.ShadowRealmLoreConcept.Hyperlink} e todos que se aliam a ele.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1881@BODY_HEADER"
msgstr "{Anon.FirstName} se aproxima de você mais uma vez. \"O Alto Conselho dos [hyperlink,GLOBAL.ArchonsLoreConcept]Arquons[/hyperlink] está feliz em ver {Sundren.FirstName} e {Julia.TitleName} reunidas. O amor entre mãe e filha arde forte.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1881@BODY_LORE"
msgstr "\"No entanto, fui incumbido de transmitir a posição dos Arquons sobre {Sundren.FirstName}...\" {Anon.FirstName} suspira e continua: \"Que fique claro que {Sundren.Name} é uma renegada conhecida, uma lâmina solta que libertou forças cósmicas que deveriam permanecer aprisionadas. Que todos que ouvem suas palavras o façam com extrema cautela, pois seu caminho se desvia muito da ordem... Muito como o de seu avô.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1881@BUTTON_0"
msgstr "\"Eu acatarei o aviso do Conselho.\" [unit/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1881@BUTTON_3"
msgstr "\"Os Arquons não têm poder aqui, eu faço o que decreto ser certo.\" [influence/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1881@TITLE"
msgstr "Sangue de Inioch"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1883@BODY_FOOTER"
msgstr "{Sundren.FirstName} interfere. \"O Alto Conselho dos Arquons está cego para qualquer outra interpretação. Como podem ter tanta certeza de quem é o sangue desse 'Sangue do Traidor'? Há outros caminhos para a salvação além do fogo sagrado e da lâmina.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1883@BODY_HEADER"
msgstr "Você coletou múltiplos Aspectos das Afinidades no {EventRealm}. {Anon.FirstName} aparece diante de você mais uma vez."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1883@BODY_LORE"
msgstr "\"Chegou ao conhecimento do Alto Conselho dos [hyperlink,GLOBAL.ArchonsLoreConcept]Arquons[/hyperlink] que você está se desviando de sua missão, entrando em contato com os {GLOBAL.EndailonLoreConcept.Hyperlink}.\" {Anon.FirstName} faz uma pausa por um momento. \"O Alto Conselho condena esse caminho, pois a Profecia afirma que o sangue dos traidores {Merlin.FirstName} e {Revenant.FirstName} deve fluir.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1883@BUTTON_0"
msgstr "\"Os Arquons estão certos, Urrath deve ser destruído.\" [unit/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1883@BUTTON_3"
msgstr "\"Sundren está certa, pode haver outros caminhos.\" [morale/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1883@BUTTON_4"
msgstr "\"Encontrarei meu próprio caminho.\" [influence/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1883@BUTTON_5"
msgstr "\"Estou aqui para lutar, não para discutir Profecias!\" [unitprod/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1883@TITLE"
msgstr "Disputa Divina"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1885@BODY_FOOTER"
msgstr "\"Acredito que os Endailon e seus Aspectos são a Luz Fraturada mencionada na Profecia, e o Sangue do Traidor... Acho que pode ser... eu.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1885@BODY_HEADER"
msgstr "Após iniciar seu cerco à capital de {Merlin.FirstName}, {Sundren.FirstName} aparece diante de você. \"Em breve, enfrentaremos {Merlin.FirstName} em seu trono.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1885@BODY_LORE"
msgstr "\"Tenho pensado na Profecia, especialmente depois que {Anon.FirstName} mencionou meu avô, o Imperador Inioch de [hyperlink,GLOBAL.AthlaLoreConcept]Athla[/hyperlink]. Inioch um dia quebrou um antigo pacto com os Arcontes, o que levou a muita discórdia em Athla. Minha família inteira carrega suas cicatrizes, e eu também invoquei a ira dos Arcontes. Será possível... Sangue de Traidor...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1885@BUTTON_0"
msgstr "\"Não há como recuar agora.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1885@TITLE"
msgstr "Sangue de Traidor"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_109@BODY_FOOTER"
msgstr "Qual será o destino deste enviado Angelical?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_109@BODY_HEADER"
msgstr "Após a batalha, um clarão radiante o cega—deixando para trás uma figura Angelical acorrentada."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_109@BODY_LORE"
msgstr "O Anjo ergue o rosto de <<o:EventUnit>> e fala com voz trêmula: \"Finalmente... os [hyperlink,GLOBAL.ArchonsLoreConcept]Arcontes[/hyperlink] ouviram minhas preces. Suplico-lhe—liberte-me destas correntes. Fui aprisionado e deixado sob a guarda daqueles que você derrotou, destinado a ser sacrificado. Meu corpo não tem mais forças para lutar... mas minha voz ainda ressoa. Liberte-me, e serei seu arauto.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_109@BUTTON_0"
msgstr "\"Sua intervenção em {EventHouse} seria muito bem-vinda.\" [allegiance/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_109@BUTTON_1"
msgstr "\"{EventHouseB} clama por sua presença orientadora.\" [allegiance/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_109@BUTTON_2"
msgstr "\"Que sua voz alcance {EventHouseC}.\" [allegiance/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_109@BUTTON_3"
msgstr "\"Nenhuma recompensa é necessária para fazer o que é certo.\" [goodact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_109@BUTTON_4"
msgstr "\"Você cumprirá seu propósito como sacrifício!\" [evilact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_109@TITLE"
msgstr "Enviado Angelical"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_113@BODY_FOOTER"
msgstr "A {OracleUnit} aguarda uma resposta ao apelo de <<o:OracleUnit>>. O que {EventHero.TitleName} fará com aqueles que ousam interferir no destino?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_113@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "A {OracleUnit} aguarda uma resposta ao apelo de <<o:OracleUnit>>. O que você fará com aqueles que ousam interferir no destino?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_113@BODY_HEADER"
msgstr "Uma figura encapuzada se aproxima de {EventHero.Name}. Revelando-se como uma {OracleUnit}—aqueles que leem as estrelas no {EventStructure}—ela proclama:"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_113@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Uma figura encapuzada se aproxima de você. Revelando-se como uma {OracleUnit}—aqueles que leem as estrelas no {EventStructure}—ela proclama:"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_113@BODY_LORE"
msgstr "\"Grande Libertador {EventHero.Name}... Foi profetizado que você chegaria em um momento de grande necessidade. O {EventStructure} caiu nas mãos de <<a:EventStackLeader>> e dos acólitos de <<o:EventStackLeader>>. Eles estão nos forçando a prever seus futuros, buscando explorar esse conhecimento em benefício próprio. Eu escapei do templo para trazer-lhe esta mensagem... mas minhas irmãs continuam presas.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_113@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "\"Grande Libertador {EventHero.Name}... foi profetizado que você chegaria em um momento de grande necessidade. O {EventStructure} caiu nas mãos de {EventStackLeader} e dos acólitos de <<o:EventStackLeader>>. Eles estão nos forçando a prever seus futuros, buscando explorar esse conhecimento em benefício próprio. Eu escapei do templo para trazer-lhe esta mensagem... mas minhas irmãs continuam presas.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_113@BUTTON_0"
msgstr "\"Ataque!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_113@BUTTON_1"
msgstr "Peça à {OracleUnit} uma adivinhação [mana/] da batalha que se aproxima."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_113@BUTTON_2"
msgstr "Convença [influence/] a {OracleUnit} de que <<p:EventHero>> precisará da ajuda de <<o:OracleUnit>> para reconquistar o {EventStructure}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_113@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "Convença [influence/] a {OracleUnit} de que você precisará da ajuda de <<o:OracleUnit>> para reconquistar o {EventStructure}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_113@BUTTON_3"
msgstr "Leia as estrelas para prever as táticas do inimigo."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_113@BUTTON_4"
msgstr "Abraçe as sombras para lançar uma maldição sobre os acólitos."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_113@TITLE"
msgstr "Forçando o Destino"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_114@BODY_FOOTER"
msgstr "O que pesa na mente de {EventHero.Name}? As guerras que virão? A riqueza do reino? O destino incerto de <<Co:EventHero>>?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_114@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "O que pesa em sua mente? As guerras que virão? A riqueza do reino? Seu destino incerto?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_114@BODY_HEADER"
msgstr "O último dos acólitos cai—conhecer o futuro não concede o poder de evitá-lo."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_114@BODY_LORE"
msgstr "A Vidente Estelar, sumo-sacerdotisa do {EventStructure}, aproxima-se de {EventHero.Name} e diz: \"Enquanto os {GLOBAL.ArchonsLoreConcept.Hyperlink} travavam guerras em frentes distantes, esses bandidos aproveitaram a chance e tomaram este lugar. Mas, como as estrelas no firmamento, nosso destino brilha novamente. Grande Libertador, permita-nos iluminar seu futuro, como um gesto de nossa gratidão.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_114@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "A Vidente Estelar, sumo-sacerdotisa do {EventStructure}, aproxima-se de você e diz: \"Enquanto os {GLOBAL.ArchonsLoreConcept.Hyperlink} travavam guerras em frentes distantes, esses bandidos aproveitaram a chance e tomaram este lugar. Mas, como as estrelas no firmamento, nosso destino brilha novamente. Grande Libertador, permita-nos iluminar seu futuro, como um gesto de nossa gratidão.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_114@BUTTON_0"
msgstr "Peça uma profecia sobre guerra. [unitprod/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_114@BUTTON_1"
msgstr "Peça uma profecia sobre prosperidade. [food/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_114@BUTTON_2"
msgstr "Peça uma profecia pessoal. [xp/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_114@TITLE"
msgstr "Forçando o Destino: Consequências"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_134@BUTTON_5"
msgstr "Canalize o dever sagrado de <<o:EventHero>> para trazer julgamento sobre os ímpios."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_134@BUTTON_5@HERO_IS_PLAYERLE"
msgstr "Canalize seu dever sagrado para trazer julgamento sobre os ímpios."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_134@BUTTON_6"
msgstr "Deixe o local por enquanto."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_136@BODY_FOOTER"
msgstr "{EventHero.TitleName} tem apenas alguns segundos antes que os guardas ataquem <<P:EventHero>>. O que <<p:EventHero>> fará?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_136@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Você tem apenas alguns segundos antes que os guardas ataquem. O que fará?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_136@BODY_HEADER"
msgstr "Os passos de {EventHero.TitleName} ecoam pelos salões do {EventStructure}. Uma figura escreve em um tomo colossal."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_136@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Seus passos ecoam pelos salões do {EventStructure}. Um {EventUnit} escreve em um tomo colossal."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_136@BODY_LORE"
msgstr "O {EventUnit} continua escrevendo enquanto <<p:EventUnit>> clama: \"Os [hyperlink,GLOBAL.ArchonsLoreConcept]Arcontes[/hyperlink] nos condenaram por registrar as mortes previstas nas estrelas. Mas há um nome que surge repetidamente, uma blasfêmia impossível, uma chance de redenção. A morte de {PlayerLeader.TitleName} foi decretada pelo destino há muito tempo. Hoje, corrigirei essa falha no destino, começando com o vassalo de <<o:PlayerLeader>>.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_136@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "O {EventUnit} continua escrevendo enquanto <<p:EventUnit>> clama: \"Os [hyperlink,GLOBAL.ArchonsLoreConcept]Arcontes[/hyperlink] nos condenaram por registrar as mortes previstas nas estrelas. Mas há um nome que surge repetidamente, uma blasfêmia impossível, uma chance de redenção. Sua morte foi decretada pelo destino há muito tempo, {PlayerLeader.TitleName}. Hoje, corrigirei essa falha no destino.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_136@BUTTON_0"
msgstr "\"Ataquem!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_136@BUTTON_1"
msgstr "Proclame [influence/] a glória eterna do reinado imortal de <<g: immortal reign^n,{PlayerLeader.TitleName}>>."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_136@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "Proclame [influence/] a glória eterna de seu reinado imortal."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_136@BUTTON_2"
msgstr "Lance [mana/] um feitiço para manter <<r:EventHero>> vivo em seu último suspiro."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_136@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "Lance [mana/] um feitiço para se manter vivo em seu último suspiro."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_136@BUTTON_4"
msgstr "Extraia força do Plano Astral para manter <<r:EventHero>> vivo em seu último suspiro."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_136@BUTTON_4@HERO_IS_PLAYERLE"
msgstr "Extraia força do Plano Astral para se manter vivo em seu último suspiro."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_136@BUTTON_5"
msgstr "\"Nem mesmo a morte ousa me aprisionar.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_136@BUTTON_6"
msgstr "\"Os justos se erguerão mais uma vez.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_136@BUTTON_7"
msgstr "Recuar as tropas."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_136@TITLE"
msgstr "Uma Morte Anunciada"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_137@BODY_FOOTER"
msgstr "O que {EventHero.Name} perguntará à Vidente das Estrelas?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_137@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "O que você perguntará à Vidente das Estrelas?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_137@BODY_HEADER"
msgstr "A Vidente das Estrelas—suma sacerdotisa do {EventStructure}—ajoelha-se diante de {EventHero.Name}, derrotada. Dúvidas assolam a mente de <<o:EventUnit>> enquanto <<p:EventUnit>> diz:"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_137@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "A Vidente das Estrelas—suma sacerdotisa do {EventStructure}—ajoelha-se diante de você, derrotada. Dúvidas assolam a mente de <<o:EventUnit>> enquanto <<p:EventUnit>> diz:"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_137@BODY_LORE"
msgstr "\"Como isso é possível? O destino não quer que eu triunfe? Os {GLOBAL.GodirLoreConcept.Hyperlink} são arautos do destino, e não seus detratores? Tenho muito a refletir, {EventHero.Name}. Este observatório agora é seu—por favor, permita-me servir, para que eu possa corrigir meu fracasso. Possuo conhecimentos que podem ser do seu interesse. Pergunte com sabedoria.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_137@BUTTON_0"
msgstr "Consultar o oráculo sobre a morte de <<o:EventHero>>."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_137@BUTTON_0@HERO_IS_PLAYERLE"
msgstr "Consultar o oráculo sobre sua próxima morte."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_137@BUTTON_1"
msgstr "Permitir que os estudiosos de {EventCity} façam suas perguntas."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_137@BUTTON_2"
msgstr "Consultar o oráculo sobre a morte dos inimigos de <<o:EventHero>>."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_137@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "Consultar o oráculo sobre a morte de seus inimigos."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_137@TITLE"
msgstr "Uma Morte Anunciada: Consequências"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_138@BODY_FOOTER"
msgstr "As tropas de {EventHero.Name} recolhem os cristais em sua retirada. O que {EventHero} fará antes que tudo se desfaça?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_138@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Suas tropas recolhem os cristais em sua retirada. O que você fará antes que tudo se desfaça?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_138@BODY_HEADER"
msgstr "Com a derrota do último morto-vivo, as almas começam a deixar seus corpos vazios, ecoando como um coro amaldiçoado."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_138@BODY_LORE"
msgstr "As vozes dos mortos entoam uma última frase: \"A profecia nunca foi encontrada. A guerra contra Urrath jamais terminou.\" As colunas começam a rachar, e os telescópios enferrujam instantaneamente, envelhecendo de repente. Relíquias ancestrais caem das prateleiras, espatifando-se no chão. Enquanto uma enorme onda de energia é liberada, cristais de mana se formam por toda a estrutura."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_138@BUTTON_0"
msgstr "Salvar uma das relíquias. [item/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_138@BUTTON_1"
msgstr "Olhar pelo telescópio."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_138@BUTTON_2"
msgstr "Colher as almas dos condenados. [souls/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_138@TITLE"
msgstr "Servidão Eterna: Consequências"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_139@BODY_FOOTER"
msgstr "Esses {GLOBAL.RevenantsLoreConcept.Hyperlink} são amaldiçoados a perseguir um propósito para sempre fora de seu alcance. {EventHero.Name} os libertará de seu tormento eterno?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_139@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Esses {GLOBAL.RevenantsLoreConcept.Hyperlink} são amaldiçoados a perseguir um propósito para sempre fora de seu alcance. Você os libertará de seu tormento eterno?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_139@BODY_HEADER"
msgstr "Quando {EventHero.Name} entra no {EventStructure}, tudo parece funcionar normalmente — mas algo sinistro paira no ar."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_139@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Quando você entra no {EventStructure}, tudo parece funcionar normalmente — mas algo sinistro paira no ar."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_139@BODY_LORE"
msgstr "Os oráculos continuam seu dever de buscar profecias nas estrelas. Um deles olha pelo telescópio. Quando {EventHero.Name} se aproxima, a figura se vira. O rosto de <<Co:EventUnit>> não tem olhos. Uma voz força sua saída da garganta de <<o:EventUnit>>, como se <<p:EventUnit>> estivesse desacostumado a falar: \"Devemos cumprir nossa tarefa... encontrar a profecia... defender o {EventStructure}...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_139@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Os oráculos continuam seu dever de buscar profecias nas estrelas. Um deles olha pelo telescópio. Quando você se aproxima, a figura se vira. O rosto de <<Co:EventUnit>> não tem olhos. Uma voz força sua saída da garganta de <<o:EventUnit>>, como se <<p:EventUnit>> estivesse desacostumado a falar: \"Devemos cumprir nossa tarefa... encontrar a profecia... defender o {EventStructure}...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_139@BUTTON_0"
msgstr "\"Destruiremos essas almas atormentadas!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_139@BUTTON_1"
msgstr "Infunda [mana/] as unidades de <<o:EventHero>> com o poder de libertar as almas."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_139@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "Infunda [mana/] suas unidades com o poder de libertar as almas."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_139@BUTTON_2"
msgstr "Produza [structureprod/] água benta e consagre este Observatório antes de atacar."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_139@BUTTON_3"
msgstr "Ensine as unidades de <<o:EventHero>> a libertar suas almas."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_139@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "Ensine suas unidades a libertar suas almas."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_139@BUTTON_4"
msgstr "\"Essas almas me pertencem.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_139@BUTTON_5"
msgstr "\"Devemos encarnar a luz para afastar essas sombras!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_139@BUTTON_6"
msgstr "Deixe essas almas miseráveis."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_139@TITLE"
msgstr "Servidão Eterna"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_140@BODY_FOOTER"
msgstr "Como {EventHero} enfrentará este teste de força?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_140@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Como você enfrentará este teste de força?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_140@BODY_HEADER"
msgstr "Várias figuras estão nos balcões altos do {EventStructure}, suas silhuetas delineadas por uma luz Celestial atrás delas."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_140@BODY_LORE"
msgstr "Uma voz sinistra ressoa dentro da estrutura: \"Finalmente, {EventHero} — o herói que esperávamos. Mas será que <<p:EventHero>> está pronto para assumir seu papel como Campeão dos [hyperlink,GLOBAL.ArchonsLoreConcept]Arcontes[/hyperlink]? Proteja nosso {ProtectUnit} e prove que você não é capaz apenas de lutar... mas também de nutrir.\"\n"
"\n"
"{ProtectUnit} deve sobreviver à batalha para passar no teste dos [hyperlink,GLOBAL.ArchonsLoreConcept]Arcontes[/hyperlink]."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_140@BUTTON_0"
msgstr "\"Que testemunhem nossa glória!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_140@BUTTON_1"
msgstr "Treine [unitprod/] as tropas para proteger, não para atacar."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_140@BUTTON_2"
msgstr "Una o lamento dos condenados [souls/] às armas de <<o:EventHero>>."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_140@BUTTON_3"
msgstr "Banhe <<r:EventHero>> na luz protetora."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_140@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "Una o lamento dos condenados [souls/] às suas armas."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_140@BUTTON_4"
msgstr "Invoca as sombras projetadas pela luz."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_140@BUTTON_5"
msgstr "Abraçe o caos para combater a ordem."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_140@BUTTON_6"
msgstr "\"Ainda não estamos prontos para esta prova.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_140@TITLE"
msgstr "Prova de Força"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_141@BODY_FOOTER"
msgstr "Que grande dádiva {EventHero} buscará?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_141@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Que grande dádiva você buscará?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_141@BODY_HEADER"
msgstr "Você permanece vitorioso com o {ProtectUnit} ao seu lado. Os [hyperlink,GLOBAL.ArchonsLoreConcept]Arcontes[/hyperlink] se erguem, exaustos pela batalha."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_141@BODY_LORE"
msgstr "A voz ecoa mais uma vez em {EventStructure}: \"O poderoso competidor julgou <<r:EventHero>> digno. Com orgulho, nós o nomeamos Campeão dos [hyperlink,GLOBAL.ArchonsLoreConcept]Arcontes[/hyperlink]. As profecias da queda de [hyperlink,GLOBAL.UrrathLoreConcept]Urrath[/hyperlink] falam de um herói — e talvez esse seja você. Empunhe estas armas sagradas, forjadas para proteger os indefesos. E antes que sua cruzada comece, uma última bênção lhe será concedida.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_141@BUTTON_0"
msgstr "Ganhe o poder de aniquilar seus inimigos."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_141@BUTTON_1"
msgstr "Uma gloriosa {EventUnit} se juntará à [unit/] sua tropa."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_141@BUTTON_2"
msgstr "\"Você interpretou mal a profecia — cairá pela minha mão.\" [evilact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_141@TITLE"
msgstr "Prova de Força Superada: Consequências"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_142@BODY_FOOTER"
msgstr "Que dádiva {EventHero} buscará?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_142@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Que dádiva você buscará?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_142@BODY_HEADER"
msgstr "Você resistiu à prova, mas o {ProtectUnit} não. Os [hyperlink,GLOBAL.ArchonsLoreConcept]Arcontes[/hyperlink] se erguem, exaustos pela batalha."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_142@BODY_LORE"
msgstr "A voz ecoa mais uma vez através de {EventStructure}: \"Guerreiro poderoso — você não superou a prova. O manto de Campeão não é seu para carregar. Mas seu valor em batalha não pode ser negado, e toda lâmina é necessária na guerra contra as trevas. Empunhe estas armas sagradas, e antes que sua cruzada comece, uma última bênção lhe será concedida.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_142@BUTTON_0"
msgstr "Seja fortalecido com o esplendor da luz."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_142@BUTTON_1"
msgstr "Uma {EventUnit} se juntará à [unit/] sua tropa."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_142@BUTTON_2"
msgstr "\"Você interpretou mal a profecia — cairá pela minha mão.\" [evilact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_142@TITLE"
msgstr "Prova de Força Sobrevivida: Consequências"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_151@BODY_FOOTER"
msgstr "Que dádiva você buscará deste emissário divino?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_151@BODY_HEADER"
msgstr "À medida que a escaramuça termina, uma luz ofuscante o cega. De seu esplendor, emerge uma {AngelUnit}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_151@BODY_LORE"
msgstr "A voz em camadas de <<Co:AngelUnit>> — ressoando em uma harmonia metálica — exclama: \"Não tema, pois esta foi sua provação, e em sua glória você se banhou. Estas criaturas imundas não mais devastarão estas terras sagradas. Erga-se agora e reivindique sua retribuição divina.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_151@BUTTON_0"
msgstr "\"Exalte a glória de {PlayerLeader.TitleName} no reino.\" [allegiance/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_151@BUTTON_1"
msgstr "Solicite reforços para sua cruzada. [unit/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_151@BUTTON_3"
msgstr "\"Sua bênção será suficiente.\" [goodact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_151@BUTTON_4"
msgstr "Abaixe o {AngelUnit} em nome do profano. [evilact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_151@TITLE"
msgstr "Delegado Divino"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_152@BODY_FOOTER"
msgstr "Que tarefa o penitente suportará a seu serviço?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_152@BODY_HEADER"
msgstr "Ainda cativo, uma figura graciosa se apresenta diante de você. <<Cp:EventUnit>> veste roupas humildes e não usa sapatos, mas há algo divino em <<P:EventUnit>>."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_152@BODY_LORE"
msgstr "<<Cp:EventUnit>> diz: \"Que os [hyperlink,GLOBAL.ArchonsLoreConcept]Arcontes[/hyperlink] o abençoem, meu salvador. Antes, eu estava entre os divinos, mas agora não sou mais do que um penitente. Vago por estas terras buscando redenção através do serviço aos justos. Por favor, permita-me redimir minhas falhas. Diga-me — que penitência devo suportar?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_152@BUTTON_0"
msgstr "\"Caminhe até uma cidade e proclame minha glória [allegiance/].\" [goodact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_152@BUTTON_1"
msgstr "\"Marche enquanto seus pés aguentarem, exaltando meu nome [allegiance/].\" [evilact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_152@BUTTON_3"
msgstr "\"Eu o hospedarei em {EventCity}. Espalhe suas boas ações lá.\" [goodact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_152@BUTTON_4"
msgstr "Mate o penitente para obter os pertences de <<o:EventUnit>> [item/]. [evilact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_152@TITLE"
msgstr "Caído em Desgraça"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_153@BODY_FOOTER"
msgstr "O que pedirá a esta alma gentil?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_153@BODY_HEADER"
msgstr "Ao se aproximar do corpo do Anjo, uma alma se ergue dele. A voz de <<Co:EventUnit>>, cálida como a luz do sol, diz:"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_153@BODY_LORE"
msgstr "\"Saudações, viajante. O que vê a seus pés é meu corpo, que não suportou as dificuldades do meu cativeiro. Mas agora, minha alma eterna está livre. Suas ações trouxeram paz a este Anjo infeliz. Permita-me conceder-lhe um presente de despedida.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_153@BUTTON_0"
msgstr "\"Exalte a glória de {PlayerLeader.TitleName} no reino.\" [allegiance/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_153@BUTTON_1"
msgstr "\"Conceda cura àqueles que sangraram por sua salvação.\" [goodact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_153@BUTTON_3"
msgstr "\"Não parta ainda, seus salvadores ainda precisam de sua luz.\" [unit/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_153@BUTTON_4"
msgstr "Sifone o que resta da luz da alma. [evilact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_153@TITLE"
msgstr "Ascensão"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_100@BODY_FOOTER"
msgstr "O Aspecto Astral não foi encontrado aqui, provavelmente está escondido em outro lugar."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_100@BODY_HEADER"
msgstr "Após vasculhar a torre de cima a baixo, nada é encontrado, mas então o Aspecto fala à sua mente novamente..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_100@BODY_LORE"
msgstr "\"Olha só,\" ele começa, \"eu sei que você sabe que tem uns pensamentos novos e esquisitos dentro de você que parecem saber mais do que seus pensamentos antigos. Só... se concentra nesse pensamento 'esvoaçante', tá? E você vai saber onde eu tô escondido! E não, eu não posso simplesmente dizer, senão o {GLOBAL.UrrathLoreConcept.Hyperlink} me acha. Já que ele tá ouvindo, afinal... Agora, vai!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_100@BUTTON_0"
msgstr "\"Ainda vou te encontrar.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_100@TITLE"
msgstr "Longe dos Olhos, Longe do..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_101@BODY_FOOTER"
msgstr "Enquanto os resquícios daquele pensamento estranho se dissipam, você ainda segura o destino da mente desencarnada em suas mãos. O que faz?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_101@BODY_HEADER"
msgstr "Após vasculhar a torre, um crânio de cristal peculiar é encontrado e, de repente, começa a falar!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_101@BODY_LORE"
msgstr "\"Eu sabia que você conseguiria! Olá, sou eu! Veja só, agora não passo de uma mente desencarnada, não é? Bem, admito que foi um plano tolo, mas... também era o último recurso, antes que {GLOBAL.UrrathLoreConcept.Hyperlink} fizesse comigo o que fez com o pobre velho {Merlin.FirstName}. Bem, você sabe o que está rolando, né? Aqui, vou conceder a você o Aspecto de Astral. Agora, antes que tudo acabe, vá e aproveite aquele pensamento estranho de antes, sim? Depois, eu me mando daqui, tipo teleporte. Tchau!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_101@BUTTON_0"
msgstr "Recrute o crânio falante [item/] para o seu lado."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_101@BUTTON_1"
msgstr "Aproveite o pensamento desvanecente para obter maior sabedoria. [knowledge/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_101@BUTTON_2"
msgstr "Destrua o crânio [evilact/] e consuma seu conhecimento! [knowledge/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_101@TITLE"
msgstr "Uma Experiência Fora do Corpo: Fora de Si"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_103@BODY_FOOTER"
msgstr "A realidade retorna, e sua mente agora está ampliada com uma clareza profunda ao ascender ao Aspecto de Astral."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_103@BODY_HEADER"
msgstr "Com uma onda enlouquecedora, sua mente parece subitamente expandida, como se pudesse abrigar cem pensamentos de uma só vez!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_103@BODY_LORE"
msgstr "A realidade se desvanece, e com uma euforia estupenda seu espaço mental parece inundado pela onisciência do próprio cosmos. Pensar e saber se fundem, e parece que os pensamentos de todos os seres existentes estão agora ao seu alcance! Porém, uma clara realização se cristaliza acima de todas as outras: o pleno conhecimento de que você foi designado por uma sabedoria superior — o {GLOBAL.EndailonLoreConcept.Hyperlink} do Astral!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_103@BUTTON_0"
msgstr "\"Eu sempre soube disso.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_103@TITLE"
msgstr "O Novo Aspecto de Astral"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_13@BODY_FOOTER"
msgstr "Com um sorriso astuto, <<p:EventHouseLord>> acrescenta: \"Seria uma grande honra se você patrocinasse meu grandioso projeto.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_13@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} anuncia <<r:EventHouseLord>> com uma tosse nervosa. \"Respeitado vizinho,\" <<p:EventHouseLord>> começa, \"um momento do seu tempo?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_13@BODY_LORE"
msgstr "\"Meu rival no conselho desafiou meu governo com a construção de um monumento imponente! Não serei superado e, portanto, elaborei um projeto ainda mais grandioso que certamente ofuscará o do meu rival!\" <<Cp:EventHouseLord>> mostra a você os planos extravagantes de <<o:EventHouseLord>>, seguido por um silêncio constrangedor. \"Infelizmente, ninguém em {EventHouse} está disposto a patrocinar sua construção...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_13@BUTTON_0"
msgstr "Recusar-se a financiar este projeto."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_13@BUTTON_1"
msgstr "\"Posso emprestar meus artesãos [structureprod/].\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_13@BUTTON_2"
msgstr "Financiar [gold/] este projeto opulento."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_13@BUTTON_3"
msgstr "Vender secretamente [gold/] esses projetos para o rival de <<o:EventHouseLord>>."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_13@BUTTON_4"
msgstr "\"Por que construir o seu próprio? Destrua o monumento do seu rival!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_13@BUTTON_5"
msgstr "Propor um redesenho mais econômico [structureprod/] do plano de <<o:EventHouseLord>>."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_13@BUTTON_6"
msgstr "\"Vamos pensar nisso com calma, certo?\" [knowledge/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_13@BUTTON_7"
msgstr "Propor resolver esta questão através de uma astuta diplomacia. [influence/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_13@BUTTON_8"
msgstr "\"Não construa esterilidade, plante fertilidade! [food/] Deixe-me mostrar como...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_13@TITLE"
msgstr "Doações Monumentais"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_14@BODY_FOOTER"
msgstr "Sorrindo, <<p:EventHouseLord>> conclui: \"O que me diz? Honrará a memória de nosso falecido filósofo com uma oração?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_14@BODY_HEADER"
msgstr "\"Glória!\" anuncia {EventHouseLord} de braços abertos, \"Meu estimado confederado, venho até você com um maravilhoso anúncio!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_14@BODY_LORE"
msgstr "\"Hoje, o povo de {EventHouse} celebra o aniversário de nosso filósofo fundador. Como nosso estimado amigo e um dos mais eminentes {GLOBAL.GodirLoreConcept.Hyperlink}, convido-o graciosamente a nos honrar proferindo a oração de abertura! Admito que o convite é um tanto repentino, mas tenho certeza de que um Godir capaz como você dará um jeito.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_14@BUTTON_0"
msgstr "Fazer um discurso modestamente organizado. [influence/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_14@BUTTON_1"
msgstr "Exigir compensação adequada [gold/] pelo seu tempo."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_14@BUTTON_2"
msgstr "Simplesmente improvisar na hora. [chaosboon/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_14@BUTTON_3"
msgstr "Aproveitar este momento para moralizar a importância da filosofia em geral. [orderboon/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_14@BUTTON_4"
msgstr "Usar esta oportunidade para propagandear sua própria ideologia. [shadowboon/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_14@BUTTON_5"
msgstr "Aceitar, mas silenciosamente convidar a todos para meditar sobre suas éticas interiormente. [natureboon/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_14@BUTTON_6"
msgstr "Simplesmente falar longamente sobre arquitetura, todos amam arquitetura! [materiumboon/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_14@BUTTON_7"
msgstr "Realizar um diálogo filosófico que questione os fundamentos de seus princípios. [astralboon/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_14@BUTTON_8"
msgstr "\"Nunca. Só vou me engrandecer!\" [influence/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_14@TITLE"
msgstr "Uma Oração de Abertura"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_157@BODY_FOOTER"
msgstr "Parece que esse anseio curioso vem de fora, e não de dentro; alguma força externa parece estar provocando você."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_157@BODY_HEADER"
msgstr "Percebendo que o Aspecto do Caos está mais adiante, uma estranha sensação de fome voraz subitamente o domina."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_157@BODY_LORE"
msgstr "Sem motivo discernível, um anseio inquieto e inabalável emerge de cada fibra do seu ser, lembrando-o de que você está tão perto de seu objetivo, e ainda assim tão distante."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_157@BUTTON_0"
msgstr "\"Mantenha-se alerta.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_157@TITLE"
msgstr "O Aspecto do Caos"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_158@BODY_FOOTER"
msgstr "Ao tomar o Aspecto do Caos para si, a inquietação diminui, mas um novo desejo permanece, um que tem gosto de mais."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_158@BODY_HEADER"
msgstr "Com o gosto da vitória fresco em seus sentidos, sua antiga e estranha fome diminui, mas aquela inquietação antinatural ainda permanece..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_158@BODY_LORE"
msgstr "Então, de repente, ela alimenta e impulsiona seus desejos como um incêndio descontrolado! Da turbulência de sua própria inquietação surge uma nova, que purga toda a desordem mental até restar apenas uma grande e saciante consciência do presente. E, por um breve e ardente instante, você se torna um só com o pandemônio do {GLOBAL.EndailonLoreConcept.Hyperlink} do Caos — e isso é verdadeiramente eletrizante!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_158@BUTTON_0"
msgstr "\"Eu quero mais!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_158@TITLE"
msgstr "O Novo Aspecto do Caos"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_15@BODY_FOOTER"
msgstr "\"Diga,\" observa o {EventStackLeader}, \"você parece ter uma mente mundana, como definiria o puro bem e o mal?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_15@BODY_HEADER"
msgstr "No {EventStructure.Name} está um exército discutindo entre si. \"Assassinato!\" diz um combatente, \"Traição!\" diz outro, \"Senhores de terra!\" murmura um terceiro."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_15@BODY_LORE"
msgstr "Enquanto os observa discutir por um tempo, seu líder, um {EventStackLeader}, nota sua presença e acena, dizendo: \"Saudações. Fomos enviados aqui pelo mestre de {EventHouse.Name} para cultivar um entendimento do puro bem e do mal. Todos nós temos filosofado extensamente sobre o tema, mas não conseguimos concordar com uma definição adequada.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_15@BUTTON_0"
msgstr "\"Não posso dizer. Venha, por favor, estude o tema [knowledge/] com meus estudiosos.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_15@BUTTON_1"
msgstr "Recusar a investigação e seguir em frente."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_15@BUTTON_2"
msgstr "\"Em busca de conhecimento; ou de sua destruição egoísta.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_15@BUTTON_3"
msgstr "\"Fazer qualquer uma das coisas, apenas por fazê-las.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_15@BUTTON_4"
msgstr "\"A busca por riqueza; para que não seja ganância.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_15@BUTTON_5"
msgstr "\"Proteger toda a vida; ou causar sua corrupção.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_15@BUTTON_6"
msgstr "\"Estabilidade e harmonia; versus tirania e discórdia.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_15@BUTTON_7"
msgstr "\"Preservar a grandeza; ou consumir os fracos.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_15@BUTTON_8"
msgstr "\"Chega de papo filosófico, para a batalha!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_15@TITLE"
msgstr "Refletindo sobre Dilemas Morais"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_160@BODY_FOOTER"
msgstr "Antes que suas forças possam alcançar o Aspecto, <<p:EventUnit>> se teleporta para as profundezas do abismo, e o eco de uma gargalhada insana de <<o:EventUnit>> ressoa à distância."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_160@BODY_HEADER"
msgstr "Chegando à beira do abismo, uma dança estridente acontece enquanto o Aspecto do Caos se diverte com os amigos de <<o:EventUnit>>."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_160@BODY_LORE"
msgstr "\"Hi-hi, ho-ho, ha-ha! Que momento maravilhoso para estar vivo!\" <<p:EventUnit>> gargalha, \"Todo o reino está se despedaçando e devorando a si mesmo! Mas, ack, o que é isso que vejo? Um estranho, tocado pelo khaos e pela sombra, hein? Diga, você não está vindo me khatchar agora, está? Uou! Hi-hi, ho-ho! Não-não! Você nunca vai me khatchar, não a mim! Eu sou o khaos inkharnate, uhu!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_160@BUTTON_0"
msgstr "Perseguir <<P:EventUnit>>."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_160@TITLE"
msgstr "Allegro Caótica"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_161@BODY_FOOTER"
msgstr "O Aspecto do Caos resiste e não se submete, o que deve ser feito?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_161@BODY_HEADER"
msgstr "Após uma perseguição perigosa, o Aspecto do Caos finalmente foi capturado e imobilizado."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_161@BODY_LORE"
msgstr "\"Ho-ho-ho, hi-hi-hi! Você khannot me khatchar, eu sou o khaos inkharnate! Eu sou—\" de repente, ele volta a si, \"Eh? Não! Fui khatchado? Ach! Não, não! Me solte! Não serei domado!\" o Aspecto do Caos se debate sem controle, \"Não, aqui, você é o Aspekht, hein? Apenas me mate agora! Mas não me prenda! Quero ver o reino cair em grande khaos! Quero ser livre! Livre!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_161@BUTTON_0"
msgstr "\"Junte-se a mim [unit/], e verá um caos ainda maior!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_161@BUTTON_1"
msgstr "Matar o Gremlin."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_161@BUTTON_2"
msgstr "Exigir pagamento [gold/] por sua liberdade."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_161@TITLE"
msgstr "Allegro Caótica: Finale"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_168@BODY_FOOTER"
msgstr "Então, o buquê etéreo se evapora e seu olfato é restaurado, restando apenas um traço tênue daquelas reflexões estranhas..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_168@BODY_HEADER"
msgstr "Ao adentrar o abismo com suas forças, você sente um leve e incomum aroma que desperta uma memória há muito perdida."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_168@BODY_LORE"
msgstr "O que começou como um simples cheiro se transforma em uma amálgama estranha de odores, cada um confundindo e desabrochando inúmeras memórias. Reflexos de dias passados há muito tempo, e até mesmo de tempos que você não se lembra de ter vivido!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_168@BUTTON_0"
msgstr "\"Algo suspeito está acontecendo...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_168@TITLE"
msgstr "O Aspecto da Natureza"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_169@BODY_FOOTER"
msgstr "Exalando, o vigor pleno do Aspecto da Natureza irrompe de dentro, e com esse poder você..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_169@BODY_HEADER"
msgstr "Uma brisa etérea roça seu rosto e, ao inspirar, você é recebido por um aroma extremamente agradável."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_169@BODY_LORE"
msgstr "Seus sentidos são intoxicados por uma sensação avassaladora de êxtase. Memórias de uma juventude cósmica invadem sua consciência, lembrando-lhe que, no fim, todas as coisas murcham. Assim como o equilíbrio um dia sucumbiu à corrupção, também a corrupção dará lugar à restauração. E, por um breve momento, parece que o {GLOBAL.EndailonLoreConcept.Hyperlink} da Natureza em pessoa o conforta... O que já aconteceu antes, acontecerá novamente."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_169@BUTTON_0"
msgstr "... Reviver a {EventUnit} murcha. [unit/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_169@BUTTON_1"
msgstr "... Compartilhar sua abundância [food/] com sua população."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_169@BUTTON_2"
msgstr "... Cultivar poderes [knowledge/] para restaurar o reino."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_169@TITLE"
msgstr "O Novo Aspecto da Natureza"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_16@BODY_FOOTER"
msgstr "A {EventUnit} está ocupada finalizando a obra-prima imaculada de <<o:EventUnit>> e não sairá até que <<p:EventUnit>> termine. Do que <<p:EventUnit>> precisa?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_16@BODY_HEADER"
msgstr "Ao se aproximar da {EventStructure.Name}, ouve-se um gemido alto e frustrado, seguido de um grito: \"Agora não, vá embora!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_16@BODY_LORE"
msgstr "Uma {EventUnit} está diante de uma escultura maravilhosa, desbastando pequenos pedaços com um cinzel. \"Se precisa saber,\" <<p:EventUnit>> resmunga, \"estamos usando esta {EventStructure.Name} para criar a obra-prima encomendada por {EventHouseLord}. Mas, para terminá-la, eu preciso... ainda preciso...\" <<Cp:EventUnit>> dá um passo atrás e inspeciona a escultura impecável com um olhar tenso. \"Do que eu preciso?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_16@BUTTON_0"
msgstr "Oferecer suas oficinas [structureprod/] para que a {EventUnit} trabalhe em paz."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_16@BUTTON_1"
msgstr "Deixar a {EventUnit} com <<o:EventUnit>> trabalho."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_16@BUTTON_2"
msgstr "\"Trabalho impressionante! Você merece um patrono muito mais rico [gold/], como eu.\" [unit/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_16@BUTTON_3"
msgstr "Usar sua mão inspirada no Materium para finalizar a peça."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_16@BUTTON_4"
msgstr "Declarar a todos que \"bom\" já é bom o suficiente!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_16@BUTTON_5"
msgstr "\"É inútil! Você precisa desistir.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_16@BUTTON_6"
msgstr "\"Você precisa apanhar para entrar na linha, vamos lá!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_16@BUTTON_7"
msgstr "\"Venha, quando se está preso por dentro, busque inspiração no exterior.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_16@BUTTON_8"
msgstr "\"De verdade, quando algo está realmente terminado?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_16@BUTTON_9"
msgstr "\"Apenas corte aquele pedaço e acabe com isso!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_16@TITLE"
msgstr "Desbastando uma Obra-Prima"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_172@BODY_FOOTER"
msgstr "O Aspecto da Natureza parece preso em um ciclo interminável; leve-o ao núcleo do labirinto para quebrá-lo."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_172@BODY_HEADER"
msgstr "O Aspecto da Natureza parece gravemente ferido enquanto permanece ali, apenas murmurando para si mesmo."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_172@BODY_LORE"
msgstr "\"Eu preciso plantá-la... preciso plantar a semente,\" murmura com um cansaço trêmulo, \"Não importa se o reino morrer amanhã, a última semente da árvore-mundo deve ser plantada no núcleo do labirinto! Essa é minha sina. De novo, e de novo, faço essa jornada, embora a corrupção seja grande demais para superar... Preciso continuar.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_172@BUTTON_0"
msgstr "Ajude o Aspecto da Natureza."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_172@TITLE"
msgstr "De Natureza Labiríntica"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_174@BODY_FOOTER"
msgstr "\"Agora, com a semente-mundo plantada, posso finalmente murchar, sabendo que um novo Aspecto irá... To... Mar... O meu... Lugar—você.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_174@BODY_HEADER"
msgstr "Conforme seu exército se aproxima da Nascente no centro, o Aspecto da Natureza avança a passos largos."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_174@BODY_LORE"
msgstr "Ele chega ao centro, planta cuidadosamente a semente na nascente e então desaba ao lado dela com um gemido exausto. [br/][br/]\"Eu tenho vigiado o {EventRealm} desde que era apenas um reino broto,\" ele grunhe, \"Ah, eu vi os {GLOBAL.ArchonsLoreConcept.Hyperlink} irem e virem, e o Império de {GLOBAL.MyrridaLoreConcept.Hyperlink} se erguer antes deles. Sim, eu sobrevivi a todos eles, mas não à corrupção de {GLOBAL.UrrathLoreConcept.Hyperlink}...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_174@BUTTON_0"
msgstr "\"Que assim seja.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_174@BUTTON_1"
msgstr "Deixe-o morrer e reivindique parte de seu poder. (DEPRECATED)"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_174@TITLE"
msgstr "De Natureza Labiríntica: Germinação"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_2@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} de {EventHouse} apresenta <<r:EventHouseLord>> com uma mão sobre o coração de <<o:EventHouseLord>> para falar em nome da {GLOBAL.IndependentCityConcept.Hyperlink} de <<o:EventHouseLord>>."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_2@BODY_LORE"
msgstr "\"Saudações, ó {PlayerLeader.Title}, {PlayerLeader.Title},\" <<p:EventHouseLord>> discursa, movendo uma mão até o peito de <<o:EventHouseLord>>, \"Nós, os {EventHouseRace}, damos-lhe boas-vindas e estamos muito curiosos para descobrir os desígnios de nosso par. Eu sou chamado {EventHouseLord.TitleName}. Rogamos, diga-nos, construiremos pontes neste dia ou devemos erguer muralhas?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_2@BUTTON_0"
msgstr "Avalie se {EventHouse} merece pontes ou muralhas."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_2@BUTTON_1"
msgstr "\"Construa como desejar, meus desígnios permanecem meus.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_2@TITLE"
msgstr "Encontro com {EventHouse} Deliciado"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_3@BODY_HEADER"
msgstr "O {EventHouseLord.Title} de {EventHouse} aparece diante de você, massageando pensativamente o queixo de <<o:eventHouseLord>>, e então começa a falar em nome da {GLOBAL.IndependentCityConcept.Hyperlink} de <<o:EventHouseLord>>."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_3@BODY_LORE"
msgstr "\"Eis e vede! Um Godir, um Godir se apresenta diante de mim nesta hora,\" <<p:EventHouseLord>> pondera em voz alta enquanto gesticula em direção ao chão, \"Em conformidade com o grande plano, dou-lhe boas-vindas, {PlayerLeader.TitleName}. Mas o que é que nos oferece em troca, eu me pergunto? De fato, o que nos oferecerá em troca?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_3@BUTTON_0"
msgstr "\"Deixe-me ver se {EventHouse} é digno de minhas ofertas.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_3@BUTTON_1"
msgstr "Não lhes ofereça nada, por enquanto."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_3@TITLE"
msgstr "Encontro com {EventHouse} Pensativo"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_4@BODY_HEADER"
msgstr "O {EventHouseLord.Title} de {EventHouse} avança com um punho contra o peito de <<o:EventHouseLord>> e fala em nome da {GLOBAL.IndependentCityConcept.Hyperlink} de <<o:EventHouseLord>>."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_4@BODY_LORE"
msgstr "\"Não avance mais!\" <<p:EventHouseLord>> ordena com a mão estendida, \"Nós, Arquitetos dos {EventHouseRace}, não convidaremos a ruína ao nosso domínio. Eu, {EventHouseLord.TitleName}, peço que declare seu propósito ou nos deixe com nossas obras.\" <<Cp:EventHouseLord>> observa você por um momento, então ergue o queixo de <<o:EventHouseLord>>. \"Então, o que será?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_4@BUTTON_0"
msgstr "Inspecione {EventHouse}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_4@BUTTON_1"
msgstr "Deixe-os em paz, por enquanto."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_4@TITLE"
msgstr "Encontro com {EventHouse} Indignado"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_5@BODY_HEADER"
msgstr "O {EventHouseLord.Title} de {EventHouse.Name} recua com o queixo erguido e fala em nome da {GLOBAL.IndependentCityConcept.Hyperlink} de <<o:EventHouseLord>>."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_5@BODY_LORE"
msgstr "<<Cp:EventHouseLord>> observa você por um momento, então arregala os olhos de <<o:EventHouseLord>> e anuncia, \"Uma desgraça nos saúda nesta hora, trazendo ruína ao nosso domínio. Com todos os {EventHouseRace} como minhas testemunhas, eu, {EventHouseLord.Name}, {EventHouseLord.Title} de {EventHouse.Name}, farei com que seu império desmorone! Desmorone, eu digo!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_5@BUTTON_0"
msgstr "Inspecionar {EventHouse}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_5@BUTTON_1"
msgstr "\"Vocês trouxeram a ruína sobre si mesmos!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_5@TITLE"
msgstr "Encontro com {EventHouse} Irado"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_69@BODY_FOOTER"
msgstr "“Mas espera, ó Aspecto da Sombra! Quem és tu verdadeiramente?”, desafia o Titã, “És um aliado vindo para me libertar ou mais um inimigo?”"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_69@BODY_HEADER"
msgstr "Ao se aproximar do observatório, uma voz profunda e magnífica ressoa de repente sobre o portão principal."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_69@BODY_LORE"
msgstr "“Louvado seja! Finalmente, nosso salvador chega, eu percebo tua presença!”, declara um {EventUnit} coberto de sujeira surgindo atrás dos portões, “Eis! Sou o último dos Titãs Endailon, que, desde o {GLOBAL.EndailonCrisisLoreConcept.Hyperlink}, rejeitou os {GLOBAL.ArchonsLoreConcept.Hyperlink} e seu {GLOBAL.AllfatherLoreConcept.Hyperlink}, e então buscou proximidade com o grande Endailon da Ordem no exílio. Por muitos ciclos permanecemos aqui, o último bastião de nossa espécie. Mas, infelizmente, apesar de nossa resistência desafiadora, {GLOBAL.UrrathLoreConcept.Hyperlink} corrompeu meus irmãos e assim trouxe o caos para nossa casa...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_69@BUTTON_0"
msgstr "\"Sou seu aliado.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_69@BUTTON_1"
msgstr "\"Sou seu inimigo!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_69@TITLE"
msgstr "Último Titã Endailon"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_71@BODY_FOOTER"
msgstr "Essa música estranha chama sua atenção, antes de desaparecer completamente, restando apenas aquele leve e distante tilintar."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_71@BODY_HEADER"
msgstr "Conforme seu exército se aproxima da área onde {Sundren.FirstName} disse que o Aspecto da Ordem estaria, um assobio agudo repentino preenche seu ouvido interno."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_71@BODY_LORE"
msgstr "O que começa como um leve tilintar distante, gradualmente soa muito mais como... Como um coro distante?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_71@BUTTON_0"
msgstr "\"Curioso.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_71@TITLE"
msgstr "O Aspecto da Ordem"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_72@BODY_FOOTER"
msgstr "À medida que o som se dissipa, você se sente completamente inspirado pelo poder do Aspecto da Ordem."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_72@BODY_HEADER"
msgstr "Seu ouvido interno percebe novamente o som daquele coro Celestial... Que agora enche seu espírito de luz e êxtase!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_72@BODY_LORE"
msgstr "Um clarão intenso toma seus sentidos quando um grande coro Celestial desaba sobre você. Mas você permanece firme como uma rocha e é tomado por exaltação e propósito justo. Quando aquela música antes estranha se torna totalmente nativa ao seu ser, você assume seu poder abençoado. Então, o que parecia ser mil vozes, coalesce em uma — o {GLOBAL.EndailonLoreConcept.Hyperlink} da Ordem."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_72@BUTTON_0"
msgstr "\"Avante!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_72@TITLE"
msgstr "O Novo Aspecto da Ordem"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_89@BODY_FOOTER"
msgstr "Sinos e cânticos ressoam no ar, forças maiores estão atentas a este momento, como você responderá?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_89@BODY_HEADER"
msgstr "Enquanto seu exército adentra o observatório infestado por demônios, aquele leve tilintar celestial ecoa novamente à distância."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_89@BODY_LORE"
msgstr "Avançando, você não pode deixar de notar a infestação corruptora avassaladora que se arrasta de cada fenda e pedra. Parece que os Titãs Endailon estão realmente fazendo sua última resistência aqui, ou até mesmo que já falharam. [br/][br/]“Eis que nosso inimigo chega”, observa o {EventUnit}, enquanto <<p:EventUnit>> fixa seus sentidos severos em você, “Prepare-se.”"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_89@BUTTON_0"
msgstr "\"Às armas!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_89@BUTTON_1"
msgstr "Primeiro, lance um feitiço para fortalecer suas forças."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_89@BUTTON_6"
msgstr "Deixe a batalha para depois."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_89@TITLE"
msgstr "Ordem Sob Cerco"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_90@BODY_FOOTER"
msgstr "\"Fala, ó novo Aspecto da Ordem, e profere teu julgamento sobre mim.\" O Titã se ajoelha e aguarda seu julgamento."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_90@BODY_HEADER"
msgstr "Após a batalha, a poeira baixa e o {EventUnit} fala uma última vez."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_90@BODY_LORE"
msgstr "\"Lutaste com bravura e valor!\" reconhece o Titã exausto, \"Verdadeiramente, o {GLOBAL.EndailonLoreConcept.Hyperlink} da Ordem está contigo, não tenho dúvidas. Não, parece que a era dos Titãs Endailon chegou ao fim. E com ela, minha grande missão aqui também... Eis que agora te concedo o 'Aspecto da Ordem', como protetor vitorioso de nosso antigo trono, posição que é tua por direito. Que prossigas com propósito justo e restaures a ordem onde eu falhei!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_90@BUTTON_0"
msgstr "\"Ergue-te [unit/], e continua tua luta ao meu lado.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_90@BUTTON_1"
msgstr "\"A era de sua espécie termina agora, pereçam!\" [evilact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_90@BUTTON_2"
msgstr "\"A ordem foi restaurada, pois a vitória é sua própria recompensa.\" [goodact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_90@TITLE"
msgstr "Ordem Sob Cerco: Restaurada"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_95@BODY_FOOTER"
msgstr "Parece que forças sobrenaturais estão inspirando seu próximo movimento."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_95@BODY_HEADER"
msgstr "Ao desembarcar no {GLOBAL.ShadowRealmLoreConcept.Hyperlink}, um pensamento curioso surge de repente em sua mente..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_95@BODY_LORE"
msgstr "É um pensamento sem palavras, sons ou imagens. No entanto, ele se impõe em sua consciência com grande clareza, de modo que você simplesmente 'sabe'... \"Procure as torres. Encontre {EventUnit.Name}.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_95@BUTTON_0"
msgstr "Concentre-se mais no pensamento..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_95@TITLE"
msgstr "Aspecto do Astral"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_97@BODY_FOOTER"
msgstr "\"Olha só, cê 'importa' de me proteger antes que esses malditos Demônios Umbrais me peguem, hein? Eu, é... me 'guardei' numa dessas torres aqui.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_97@BODY_HEADER"
msgstr "Antes que você possa refletir sobre seu último pensamento, uma voz estranha fala diretamente à sua mente."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_97@BODY_LORE"
msgstr "\"Ei! Você aí! Ótimo, um 'Aspecto-iniciante'. Certo, um pouco de ajuda seria bem-vinda,\" insiste o falante grosseiro, \"Puxa, como o velho Aspecto, lutei o máximo que pude para afastar essa maldita corrupção de {EventRealm}, mas que se dane, como falhei... Agora, meu velho corpo pode até estar sendo manipulado por algo como {GLOBAL.ShadowDemonsLoreConcept.Hyperlink}, mas minha mente, pelo menos... Bem, está 'guardada', por assim dizer...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_97@BUTTON_0"
msgstr "Ajude o Aspecto e mate seu antigo corpo. (DEPRECATED)"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_97@BUTTON_1"
msgstr "Procure o Aspecto oculto."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_97@TITLE"
msgstr "Uma Experiência Fora do Corpo"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_98@BODY_FOOTER"
msgstr "Você é convidado a entrar no {EventStructure} e lutar contra o {EnemyUnit} animado demoníaco em seu interior."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_98@BODY_HEADER"
msgstr "Ao entrar no {EventStructure}, uma voz familiar força-se novamente em sua mente..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_98@BODY_LORE"
msgstr "\"Ei! O que você tá fazendo na antiga torre de estudos de {Merlin.FirstName} e minha? Coitadinha, o que sobrou dela...\" À frente, um {EnemyUnit} sem mente flutua em meio a uma cascata de livros, joias e outros itens mágicos. \"Olha só! Meu velho corpo está sendo animado por {GLOBAL.UrrathLoreConcept.Hyperlink}. Ugh, parece que está guardando essas coisas para Merlin coletar depois... Bom, já que você tá aqui, poderia me fazer um favor e acabar com ele pra mim?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_98@BUTTON_0"
msgstr "Ataque o {EnemyUnit} animado de frente!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_98@BUTTON_1"
msgstr "Prepare um feitiço improvisado [mana/] para despedaçar as defesas mágicas do {EnemyUnit}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_98@BUTTON_6"
msgstr "\"Agora não.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_98@BUTTON_7"
msgstr "Use sua Afinidade com o Astral para enfraquecer o {EventUnit} animado."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_98@BUTTON_8"
msgstr "Invoca Godebald para provocar seu antigo corpo animado com insultos grosseiros."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_98@TITLE"
msgstr "Tempo Fora da Mente"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_99@BODY_FOOTER"
msgstr "Enquanto o tesouro desaparece lentamente, você tem apenas uma chance de salvar o artefato mais valioso!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_99@BODY_HEADER"
msgstr "Ao derrotar o corpo animado, ouve-se um grande estrondo e toda a torre treme, antes que uma voz familiar surja novamente."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_99@BODY_LORE"
msgstr "\"Caramba, que espetáculo e tanto! Foi o fim de uma era, né? {Merlin.FirstName} e eu costumávamos pesquisar os Aspectos aqui. Pelo menos, antes dele ir embora procurar a menina dos olhos dele...\" Então, o chão racha e desaba, revelando o vasto {GLOBAL.ShadowRealmLoreConcept.Hyperlink} além. Com guinchos e arranhões, o corpo é sugado para o abismo, e junto com ele todos os itens, gemas e tomos que flutuavam pelo espaço também são lentamente arrastados!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_99@BUTTON_0"
msgstr "Salve o item mágico mais próximo. [item/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_99@BUTTON_1"
msgstr "Salve o diário de aparência mais grandiosa. [knowledge/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_99@BUTTON_2"
msgstr "Maldito Merlin (DEPRECATED)"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_99@BUTTON_3"
msgstr "Salve as joias! [gold/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_99@BUTTON_4"
msgstr "\"Ei! Pegue meu caderno surrado!\" Salve a inestimável Pesquisa de Aspectos de Godebald! [arcana/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_99@TITLE"
msgstr "Tempo Fora da Mente: Fora do Tempo"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8093@BODY_FOOTER"
msgstr "\"Eles veem seus medos,\" {OracleName} diz abruptamente. \"Todos devem confessar à luz ou desesperar!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8093@BODY_HEADER"
msgstr "Com vertigem, você acorda em uma paisagem serena. Seu guia, {OracleName} dos {EventRace}, lentamente entra em foco novamente, sorrindo."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8093@BODY_LORE"
msgstr "\"Chegamos, {PlayerLeader},\" declara <<p:OracleName>>, enquanto as visões do {GLOBAL.AstralSeaLoreConcept.Hyperlink} ainda persistem em sua mente. \"Este é um dos reinos abençoados que os {GLOBAL.ArchonsLoreConcept.Hyperlink} chamam de Emnora. Aqui eles residem, dedicando-se a emendas divinas e à construção de seus templos poderosos.\" Enquanto {OracleName} fala, as [hyperlink,GLOBAL.AstralFlowsLoreConcept]Correntes Astrais[/hyperlink] ao seu redor se avolumam novamente, conjurando a imagem da terrível luz que você contemplou."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8093@BUTTON_0"
msgstr "\"Vi ladrões, espreitando nas sombras para roubar meus tesouros [gold/].\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8093@BUTTON_1"
msgstr "\"Pecado e caos abalaram os reinos. A Era de Obbadoth [influence/] estava em seu alvorecer.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8093@BUTTON_2"
msgstr "\"Não havia conflito [unitprod/] ou emoção. Toda a vida subjugada em padrões previsíveis.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8093@BUTTON_3"
msgstr "\"As Correntes Astrais [mana/] se esgotaram, e não havia mais magia.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8093@BUTTON_4"
msgstr "\"Caçadas e encurraladas, as grandes feras [unit/] dos reinos foram levadas à extinção.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8093@BUTTON_5"
msgstr "\"A plebe usurpou o trono, eternamente ignorante [knowledge/] de seus poderes não buscados.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8093@BUTTON_6"
msgstr "\"Meu povo [population/] foi reduzido a peões, sacrificados nos jogos de poder de Magehaven.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8093@BUTTON_7"
msgstr "\"As torres dos Arquimagos [monument/] desmoronaram, sua riqueza arcana perdida para sempre.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8093@BUTTON_DRAGON"
msgstr "\"Vingativos e invejosos, os Reis Gigantes mataram todos os dragões [unit/] por toda parte.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8093@BUTTON_GIANT"
msgstr "\"Como a antiga Myrrida, os grandes reinos dos Parentes Gigantes [structureprod/] pereceram no fogo dos dragões.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8093@TITLE"
msgstr "Visões de Exaltação"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8110@BODY_FOOTER"
msgstr "\"Os portais entre os Anéis de Emnora são as <<m:{GLOBAL.STRUCTURES.GOLDEN_ZIGGURAT.Hyperlink}>> neste reino,\" conclui {OracleName}. \"Previ seu desejo de trilhar esse caminho, embora não saiba o propósito.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8110@BODY_HEADER"
msgstr "\"A luz da verdade pode queimar violentamente,\" diz {OracleName}. \"Como {EventUnit}, devo proteger meus olhos de seu toque.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8110@BODY_LORE"
msgstr "\"Você se saiu bem, {PlayerLeader},\" continua <<p:OracleName>>, \"mas sua jornada rumo aos {GLOBAL.ArchonsLoreConcept.Hyperlink} está apenas começando. Os anéis de Emnora são como escadarias sinuosas para o céu. Exceto que nenhum pé pode caminhar por seus degraus, apenas um espírito em busca de iluminação. Estamos no Quarto Anel, onde as almas menos divinas buscam ascensão. No Primeiro Anel, o Alto Conselho dos Arcontes se reúne.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8110@BUTTON_0"
msgstr "\"Não existe portal mágico que minha astúcia arcana não possa decifrar.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8110@BUTTON_1"
msgstr "\"No santuário destes monumentos dos Arcontes, minhas preces encontram novo significado.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8110@BUTTON_2"
msgstr "\"Deve haver outros aspirantes nesses portais. Eles podem saber como passar.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8110@BUTTON_3"
msgstr "\"Quando ameaçar destruir seus preciosos portais, os Arcontes ouvirão minhas exigências.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8110@TITLE"
msgstr "Caminhos da Ascensão"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8111@BODY_FOOTER"
msgstr "\"Se deseja completar sua jornada até Emnora,\" conclui {OracleName}, \"você terá que dominar seus medos. Com o tempo, entenderá o verdadeiro significado disso.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8111@BODY_HEADER"
msgstr "Após examinar a {EventStructure}, você é esperado por {OracleName}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8111@BODY_LORE"
msgstr "\"Encontrou o que procurava, {PlayerLeader.Name}?\" pergunta <<p:EventUnit>> com um sorriso conhecedor. \"A resposta só poderia ser 'sim'. Talvez já tenha percebido: em Emnora, as esperanças e medos dos magicamente dotados podem tomar forma tangível. É uma das razões pelas quais apenas os virtuosos e dignos podem ascender aos anéis superiores.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8111@BUTTON_0"
msgstr "Agradeça a {OracleName} pelas percepções de <<o:EventUnit>>."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8111@TITLE"
msgstr "Caminhos da Ascensão: Consequências"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BODY_FOOTER"
msgstr "O vórtice celestial dentro do arco o convida a entrar. Para onde deseja ir?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BODY_FOOTER@FIRST_OTHER"
msgstr "O arco do portal inativo não oferece a {EventHero} passagem para os anéis superiores de Emnora. O que {EventHero} faz?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BODY_FOOTER@FIRST_RULER"
msgstr "O arco do portal inativo não oferece passagem para os anéis superiores de Emnora. O que você faz?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BODY_FOOTER@NO_RULER"
msgstr "O vórtice celestial dentro do arco convida {EventHero} a entrar. Para onde {EventHero} deseja ir?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BODY_HEADER"
msgstr "Subindo mais uma vez as escadas da {EventStructure}, você retorna à câmara do portal no topo."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BODY_HEADER@FIRST_OTHER"
msgstr "Subindo as escadas da {EventStructure}, {EventHero} contempla a grandiosidade da arquitetura ancestral dos [hyperlink,GLOBAL.ArchonsLoreConcept]Arcontes[/hyperlink]."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BODY_HEADER@FIRST_RULER"
msgstr "Subindo as escadas da {EventStructure}, você contempla a grandiosidade da arquitetura ancestral dos [hyperlink,GLOBAL.ArchonsLoreConcept]Arcontes[/hyperlink]."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BODY_HEADER@NO_RULER"
msgstr "Subindo mais uma vez as escadas da {EventStructure}, {EventHero} retorna à câmara do portal no topo."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BODY_LORE"
msgstr "Dentro da câmara no topo, o arco coberto de runas ainda repousa. Ao se aproximar do arco ancestral, ele de repente crepita com energia e um vórtice estrelado aparece em seu centro."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BODY_LORE@FIRST_OTHER"
msgstr "Dentro da câmara no topo, {EventHero} encontra um arco coberto de runas, não muito diferente dos <<m:{GLOBAL.WorldGateLoreConcept.Hyperlink}>> de {GLOBAL.MagehavenLoreConcept.Hyperlink}. O arco está inativo, sem vestígio de qualquer mecanismo arcano que possa ativá-lo."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BODY_LORE@FIRST_RULER"
msgstr "Dentro da câmara no topo, você encontra um arco coberto de runas, não muito diferente dos <<m:{GLOBAL.WorldGateLoreConcept.Hyperlink}>> de {GLOBAL.MagehavenLoreConcept.Hyperlink}. O arco está inativo, sem vestígio de qualquer mecanismo arcano que possa ativá-lo."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BODY_LORE@NO_RULER"
msgstr "Dentro da câmara no topo, o arco coberto de runas ainda repousa. À medida que {EventHero} se aproxima do arco ancestral, ele de repente crepita com energia e um vórtice estrelado aparece em seu centro."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BUTTON_0"
msgstr "Entrar no portal para o Primeiro Anel."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BUTTON_1"
msgstr "Entrar no portal para o Segundo Anel."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BUTTON_2"
msgstr "Sair."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BUTTON_3"
msgstr "Entrar no portal para o Terceiro Anel."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BUTTON_4"
msgstr "Entrar no portal para o Quarto Anel."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BUTTON_5"
msgstr "Examinar o arco mais de perto para desvendar seus segredos..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BUTTON_6"
msgstr "Ajoelhar-se diante do arco para iniciar suas preces..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BUTTON_7"
msgstr "Engajar a figura próxima à outra extremidade da câmara..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BUTTON_8"
msgstr "Erguer o {EventItem} para ameaçar destruir o arco..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@TITLE"
msgstr "No Caminho da Ascensão"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8122@BODY_FOOTER"
msgstr "\"É nosso chamado mergulhar os {GLOBAL.RevenantsLoreConcept.Hyperlink} no {GLOBAL.AstralVoidLoreConcept.Hyperlink},\" conclui {EventPlayer}. \"Interfira, {PlayerLeader}, e você também será fulminado.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8122@BODY_HEADER"
msgstr "Do {EventGeo} {EventDirection} de {EventCity}, um coro rouco cresce, encantador porém aterrorizante, até que {EventPlayer} revela <<r:EventPlayer>> para você."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8122@BODY_LORE"
msgstr "\"Ouça nossa interpretação:\", canta <<p:EventPlayer>>, com seu saco vocal pulsando de fervor, \"Nós, {EventRace}, navegamos até as margens de Emnora em busca da graça dos Arcontes, mas encontramos habitantes tão vis quanto os terrores profundos do {GLOBAL.AstralSeaLoreConcept.Hyperlink}. Refiro-me aos {GLOBAL.RevenantsLoreConcept.Hyperlink}, cuja presença vil ameaça este Santuário Celestial.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8122@BUTTON_0"
msgstr "\"Os cânticos divinos dos {EventRace} são inspiradores. [relationLvl3/] Vamos nos juntar ao seu fervor arrebatador!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8122@BUTTON_3"
msgstr "\"Prossiga como desejar. Não tomamos partido em cruzadas sagradas.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8122@BUTTON_4"
msgstr "\"Não cabe a você decidir sobre vida e morte, {EventPlayer}. [relationLvl-3/] Isso cabe a mim!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8122@TITLE"
msgstr "Os Ímpios que Esmagamos"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8129@BODY_FOOTER"
msgstr "\"Não somos agentes de {GLOBAL.UrrathLoreConcept.Hyperlink},\" grita {EventPlayer} desafiadoramente. \"Somos {GLOBAL.ArchonsLoreConcept.Hyperlink}!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8129@BODY_HEADER"
msgstr "Exalando um aroma de óleo fragrante, mas também de decomposição, um <<EventPlayer{man/woman}>> enrugado em armadura de Arconte desce as escadas da Necrópole de <<o:EventPlayer>>."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8129@BODY_LORE"
msgstr "\"Sou {EventPlayer}, líder daqueles tão injustamente proscritos como '{EventRace}',\" apresenta-se <<p:EventPlayer>>, exibindo um sorriso amargo. \"Meu povo foi condenado duas vezes: primeiro quando os Homens-Lagarto nos negaram a partida na Primeira Era de {GLOBAL.AthlaLoreConcept.Hyperlink}; e novamente perto do fim de sua Segunda Era, quando a marca de {GLOBAL.UrrathLoreConcept.Hyperlink} foi colocada sobre nossas Necrópoles. Erguemo-nos como marionetes maculadas, mas quando os selos de {GLOBAL.AthlaLoreConcept.Hyperlink} se romperam, nossas {GLOBAL.SoulsLoreConcept.Hyperlink} foram reacesas com fé.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8129@BUTTON_0"
msgstr "Continuar ouvindo {EventPlayer}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8129@TITLE"
msgstr "Condenação"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8132@BODY_FOOTER"
msgstr "\"Os {GLOBAL.ArchonsLoreConcept.Hyperlink} sem dúvida favorecerão aqueles que puderem pôr os {GLOBAL.RevenantsLoreConcept.Hyperlink} para descansar,\" conclui {OracleName}. \"Pois eles temem o que não deve ser.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8132@BODY_HEADER"
msgstr "À medida que o coro dos {EventRace} se dissipa, {OracleName} ergue a voz de <<o:EventUnit>>, falando com você."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8132@BODY_LORE"
msgstr "\"O destino dos {GLOBAL.RevenantsLoreConcept.Hyperlink} é um destino distorcido,\" diz <<p:EventUnit>>, com <<o:EventUnit>> palavras ditas com uma fragilidade incomum. \"Antes {GLOBAL.ArchonsLoreConcept.Hyperlink} em vida, suas {GLOBAL.SoulsLoreConcept.Hyperlink} foram negadas a passagem para o {GLOBAL.AllfatherLoreConcept.Hyperlink}—até que a Necromancia mais poderosa os trouxe de volta à não-vida, para sempre marcados com o selo de {GLOBAL.UrrathLoreConcept.Hyperlink}.\" {OracleName} hesita, então continua: \"Se há {GLOBAL.RevenantsLoreConcept.Hyperlink} em Emnora, as coisas não auguram nada de bom.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8132@BUTTON_0"
msgstr "Lidaremos com essa ameaça dos Revenants a seu tempo."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8132@TITLE"
msgstr "A Maldição dos Revenants"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8133@BODY_FOOTER"
msgstr "\"Posso ver as emanações no {EventStructure} mudarem,\" relata {OracleName}. \"O caminho para Emnora continua, {PlayerLeader}.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8133@BODY_HEADER"
msgstr "Após testemunhar a derrota de {EventPlayer}, {OracleName} compartilha <<o:EventUnit>> pensamentos."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8133@BODY_LORE"
msgstr "\"Que você encontre paz finalmente, {EventPlayer.FirstName}—seu coração compassivo não merecia tal destino,\" diz <<p:EventUnit>>, com <<o:EventUnit>> mãos realizando gestos de despedida.[br/][br/]Então {OracleName} se volta para você: \"Você prestou um grande serviço aos Arcontes hoje, {PlayerLeader}, mesmo que eles não reconheçam isso abertamente.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8133@BUTTON_0"
msgstr "Planeje seu retorno ao {EventStructure}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8133@BUTTON_2"
msgstr "Recompensa 2"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8133@BUTTON_3"
msgstr "Recompensa 3"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8133@BUTTON_4"
msgstr "Recompensa 4"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8133@BUTTON_5"
msgstr "Recompensa 5"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8133@BUTTON_6"
msgstr "Recompensa 6"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8133@TITLE"
msgstr "A Maldição dos Revenants: Consequências"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8142@BODY_FOOTER"
msgstr "\"Nós, {EventRace}, fomentamos a ascensão de novos {GLOBAL.ArchonsLoreConcept.Hyperlink} em muitos mundos\", declara {EventPlayer}. \"Infelizmente, essa era abençoada já passou.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8142@BODY_HEADER"
msgstr "Ladeado por Anjos, uma poderosa carruagem desce das montanhas, seu exaltado cavaleiro iluminado por raios divinos."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8142@BODY_LORE"
msgstr "\"Salve o {GLOBAL.AllfatherLoreConcept.Hyperlink}, {PlayerLeader.Name},\" clama <<p:EventPlayer>> com esplendor, \"pois você está entrando nas terras abençoadas dos {EventRace}. Eu sou {EventPlayer.TitleName} e cabe a mim julgar quem pode ascender para alcançar Emnora.\" {EventPlayer} olha para você com <<o:EventPlayer>> olhar radiante. \"Vejo que você é um {EventPlayerForm}. Uma pena.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8142@BODY_LORE@PLAYER_HUMANFORM"
msgstr "\"Salve o {GLOBAL.AllfatherLoreConcept.Hyperlink}, {PlayerLeader.Name},\" clama <<p:EventPlayer>> com esplendor, \"pois você está entrando nas terras abençoadas dos {EventRace}. Eu sou {EventPlayer.TitleName} e cabe a mim julgar quem pode ascender para alcançar Emnora.\" {EventPlayer} olha para você com <<o:EventPlayer>> olhar radiante. \"Vejo que você é um {EventPlayerForm}. Que promissor!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8142@BUTTON_0"
msgstr "Continue ouvindo {EventPlayer}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8142@TITLE"
msgstr "Um Destino Superior"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8147@BODY_FOOTER"
msgstr "\"As almas dos dignos são refundidas na luz dos {EventRace},\" proclama {EventPlayer}, acendendo <<o:EventPlayer>> {EventItem}. \"No entanto, os impuros incineram...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8147@BODY_HEADER"
msgstr "A expressão em <<ge:face^n,EventPlayer>> se torna severa, resplandecente, porém terrível."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8147@BODY_LORE"
msgstr "\"Devo insistir para que você volte atrás, {PlayerLeader},\" diz <<p:EventPlayer>> lentamente, e você sente um desejo urgente de seguir <<o:EventPlayer>> comando. \"Retorne, enquanto pode, pois para alcançar Emnora, é preciso atravessar chamas purificadoras.\"[br/][br/]Como você não recua, {EventPlayer} continua: \"Pelo mandato a mim conferido pelo Alto Conselho, decreto meu desafio a você. Supere meus poderes divinos, e eu lhe concederei passagem.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8147@BUTTON_0"
msgstr "\"Seus exércitos Celestiais tremerão diante de mim, {EventPlayer}!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8147@TITLE"
msgstr "Provação pelo Fogo"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8149@BODY_FOOTER"
msgstr "{OracleName} pergunta: \"Você aceitará o {TitanUnit} em suas fileiras?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8149@BODY_HEADER"
msgstr "Embora as portas do Terceiro Anel de Emnora tenham se aberto amplamente, {OracleName} tem mais boas notícias para compartilhar."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8149@BODY_LORE"
msgstr "\"Seus feitos neste reino não passaram despercebidos, {PlayerLeader},\" diz <<p:EventUnit>> com voz séria. \"Um {TitanUnit}, anteriormente aliado a {EventPlayer}, está oferecendo a você, o {PlayerLeader.Title}, a lealdade de <<o:TitanUnit>>.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8149@BUTTON_0"
msgstr "Recrutar o {TitanUnit} [unit/] para o seu exército."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8149@BUTTON_2"
msgstr "Pedir ao {TitanUnit} para trabalhar nas forjas [unitprod/] de {EventCity}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8149@BUTTON_3"
msgstr "Comungar com o {TitanUnit} para aprender o rito de passagem de almas de <<o:TitanUnit>>."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8149@TITLE"
msgstr "Provação pelo Fogo: Consequências"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8153@BODY_FOOTER"
msgstr "\"Eu sou {EventPlayer}, {EventPlayer.Title},\" diz o homem, erguendo o capuz de <<o:EventPlayer>>. \"Mas, quem é você?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8153@BODY_HEADER"
msgstr "Acompanhado por um único escriba, um homem encapuzado, humilde porém exaltado, espera por você ao pé das escadarias do Zigurate."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8153@BODY_LORE"
msgstr "\"Então o Oráculo de Alanor adivinhou a verdade,\" diz o homem, \"e vem 'um, portador de uma carta de necessidade, que caminha em <<ge:luz estelar^n,{EventGodir}>>'.\" <<Cp:EventPlayer>> olha para o céu, onde, de fato, a constelação de {EventGodir} brilha mais intensamente que qualquer outra. \"Bem, então. Você deve estar em seu caminho para Emnora. Se for assim, saiba que chegou aos Lagos da Sagacidade, onde as águas podem refletir a verdade.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8153@BUTTON_0"
msgstr "\"Eu sou {PlayerLeader.TitleName}.\" [influence/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8153@BUTTON_3"
msgstr "\"Eu sou {PlayerLeader.FirstName}, Buscador da Verdade.\" [knowledge/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8153@BUTTON_4"
msgstr "\"Meu nome não tem significado à luz do Pai de Todos.\" [goodact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8153@TITLE"
msgstr "Revelações Estelares"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8162@BODY_FOOTER"
msgstr "\"Passeie sob as cúpulas de nossos Observatórios, {PlayerLeader.TitleName}\", finaliza {EventPlayer} <<o:EventPlayer>> discurso, \"e talvez ainda alcance Emnora.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8162@BODY_FOOTER@NO_NAME"
msgstr "\"Passeie sob as cúpulas de nossos Observatórios, peregrino\", finaliza {EventPlayer} <<o:EventPlayer>> discurso, \"e talvez ainda alcance Emnora.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8162@BODY_FOOTER@PLAIN_NAME"
msgstr "\"Passeie sob as cúpulas de nossos Observatórios, {PlayerLeader.Name}\", finaliza {EventPlayer} <<o:EventPlayer>> discurso, \"e talvez ainda alcance Emnora.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8162@BODY_HEADER"
msgstr "\"Um {PlayerLeader.Title}, vejo,\" repete {EventPlayer} pensativamente, <<o:EventPlayer>> pensamentos velados sob <<o:EventPlayer>> capuz."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8162@BODY_HEADER@NO_NAME"
msgstr "\"Um peregrino, vejo,\" diz {EventPlayer} pensativamente, <<o:EventPlayer>> pensamentos velados sob <<o:EventPlayer>> capuz."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8162@BODY_HEADER@PLAIN_NAME"
msgstr "\"{PlayerLeader.Name}, vejo,\" repete {EventPlayer} pensativamente, <<o:EventPlayer>> pensamentos velados sob <<o:EventPlayer>> capuz."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8162@BODY_LORE"
msgstr "\"É raro um estranho visitar os Lagos da Sagacidade,\" continua <<p:EventPlayer>>. \"Mas você está livre para entrar em nossas casas de sabedoria, absorver sua mente na presença de nossas águas abençoadas; deixar que as profecias de nossos Oráculos se assentem.\"[br/][br/]\"A luz do [hyperlink,GLOBAL.AllfatherLoreConcept]Pai de Todos[/hyperlink] anuncia o destino de nosso cosmos,\" explica {EventPlayer} com empatia, \"mas aquele que contempla {GLOBAL.TheWellLoreConcept.Hyperlink} se afogará em sua verdade. Assim, a Ordem dos Áugures observa apenas seus tênues reflexos, ecoados como luz estelar.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8162@BUTTON_0"
msgstr "Concordar em estudar as profecias da Ordem dos Áugures."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8162@BUTTON_4"
msgstr "Este é o momento de atacar os Arcontes quando menos esperam. [evilact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8162@TITLE"
msgstr "Presságios e Profecias"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8163@BODY_FOOTER"
msgstr "\"Por meio deste, concedo-lhe o direito de se aproximar do Alto Conselho,\" proclama {EventPlayer}. \"Que o Pai de Todos inspire suas palavras ao suplicar a eles.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8163@BODY_HEADER"
msgstr "Muito aconteceu desde que você chegou aos Lagos da Sagacidade. Agora {EventPlayer} convocou você e {EventHero} para se juntarem a <<P:EventPlayer>> junto às águas abençoadas."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8163@BODY_LORE"
msgstr "\"Vocês demonstraram grande sabedoria e paciência durante sua estadia nestas terras, {PlayerLeader} e {EventHero},\" diz {EventPlayer} com um brilho de solenidade na voz de <<o:EventPlayer>>. \"Ambos adquiriram um entendimento de como as profecias podem guiar nossas ações e ambos enfrentaram seus medos, dominando-os de maneiras distintas.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8163@BUTTON_0"
msgstr "Preparem-se para enfrentar o Alto Conselho dos Arcontes."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8163@TITLE"
msgstr "Presságios e Profecias: Consequências"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8169@BODY_FOOTER"
msgstr "Rodapé"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8169@BODY_HEADER"
msgstr "Cabeçalho"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8169@BODY_LORE"
msgstr "História"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8169@BUTTON_0"
msgstr "Ok"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8169@TITLE"
msgstr "Evento do Conselho dos Observadores"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8171@BODY_FOOTER"
msgstr "\"Meu nome é {EventHero},\" a mulher se apresenta <<r:EventHero>>. \"E eu também estou no caminho para Emnora.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8171@BODY_HEADER"
msgstr "Vagando pelos Lagos da Sagacidade, vocês encontram uma mulher solitária observando as águas. Quando <<p:EventHero>> os nota, <<p:EventHero>> olha para cima."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8171@BODY_LORE"
msgstr "\"Fui informada de que alguém chegou com intenções não muito diferentes das minhas,\" fala <<p:EventHero>>, revelando seu belo rosto élfico. \"E embora seja meu grande desejo saber mais, não devo perguntar sobre a Grande Guerra Umbral. Pois me afligiria demais; enquanto estou aqui, sentada, lendo folhas de chá Astral...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8171@BUTTON_0"
msgstr "Continuar ouvindo {EventHero}..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8171@TITLE"
msgstr "A Dama do Lago"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8177@BODY_FOOTER"
msgstr "\"Seguirei sua liderança, {PlayerLeader},\" diz {EventHero.FirstName} com um sorriso. \"O último passo de nossa jornada está diante de nós.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8177@BODY_HEADER"
msgstr "Juntamente com {EventHero}, vocês descem a escadaria do último Zigurate, avistando ao longe a sede do Alto Conselho dos Arcontes."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8177@BODY_LORE"
msgstr "Estátuas angelicais e árvores sagradas ladeiam o caminho, que serpenteia até um enorme {EventStructure}. \"Dizem,\" sussurra {EventHero.FirstName}, \"que os Arcontes do Alto Conselho transcenderam a forma física, tornando-se uma dualidade de luz e alma. Para nos comunicarmos com eles, teremos que entrar em seu santuário e aguardar seu chamado.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8177@BUTTON_0"
msgstr "Prepare seu espírito para se comunicar com o Alto Conselho."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8177@TITLE"
msgstr "O Alto Conselho dos Arcontes"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8178@BODY_FOOTER"
msgstr "Imbuído com esse novo significado, seu espírito se eleva, banhando-se na luz de {GLOBAL.TheWellLoreConcept.Hyperlink}..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8178@BODY_HEADER"
msgstr "Enquanto as palavras do Alto Conselho dos Arcontes ainda ressoam em sua mente, você reflete sobre a jornada que ficou para trás."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8178@BODY_LORE"
msgstr "Vocês ascenderam aos anéis Celestiais, provando sua resistência, bravura e sabedoria. Agora, sob a garoa de {EventStructure}, finalmente compreendem as palavras de {OracleName}. 'Emnora' não é este reino, nem o local do Alto Conselho, nem qualquer solo sagrado. É um estado de clareza e paz, uma transformação do seu espírito interior, uma verdade além dos véus da realidade."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8178@BUTTON_0"
msgstr "... até alcançar Emnora."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8178@TITLE"
msgstr "O Alto Conselho dos Arcontes: Consequências"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8180@BODY_FOOTER"
msgstr "Imbuído com esse novo significado, seu espírito se eleva, banhando-se na luz de {GLOBAL.TheWellLoreConcept.Hyperlink}..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8180@BODY_HEADER"
msgstr "Enquanto as palavras do Alto Conselho dos Arcontes ainda ressoam em sua mente, você reflete sobre a jornada que ficou para trás."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8180@BODY_LORE"
msgstr "Você ascendeu aos Anéis Celestiais, provando sua resistência, bravura e sabedoria. Agora, sob a garoa de {EventStructure}, você finalmente compreende as palavras de {OracleName}. 'Emnora' não é este reino, nem o local do Alto Conselho, nem qualquer solo sagrado. É um estado de clareza e paz, uma transformação de seu espírito interior, uma verdade além dos véus da realidade."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8180@BUTTON_0"
msgstr "... até chegar a Emnora."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8180@TITLE"
msgstr "Anéis de Emnora: Vitória"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8193@BODY_FOOTER"
msgstr "Embora {OracleName} esteja são e salvo, o auto-resgate de <<o:OracleName>> drenou uma quantidade notável de suas reservas de mana..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8193@BODY_HEADER"
msgstr "Parecia que <<ge:fate^n,{OracleName}>> havia sido selado. No entanto, após a batalha, <<p:OracleName>> retorna, emergindo de um rasgo Astral."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8193@BODY_LORE"
msgstr "\"Foi por pouco\", {OracleName} exclama, ainda ofegante. \"Como um {EventUnit} experiente em escaramuças, desenvolvi uma percepção única sobre minha própria segurança. No entanto, prever a aproximação da morte não significa naturalmente que você possa enganá-la.\" <<Cp:OracleName>> rasga um pequeno pedaço de tecido da túnica de <<o:OracleName>>, polindo o orbe em seu cajado. \"Então, não vamos nos meter nisso de novo, {PlayerLeader}, combinado?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8193@BUTTON_0"
msgstr "Esse é o preço da imortalidade."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8193@TITLE"
msgstr "Uma Fuga Pressentida"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8203@BODY_FOOTER"
msgstr "\"Você é um Godir, {PlayerLeader},\" {EventPlayer} apela para você. \"Fale com o {EventUnit} em {EventStructure}. Fale de nossas intenções, convença <<P:EventUnit>> de que não estamos corrompidos...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8203@BODY_HEADER"
msgstr "\"Viemos a Emnora em busca de redenção,\" {EventPlayer} continua. \"No entanto, encontramos a passagem para os anéis superiores bloqueada, nossas preces respondidas por um silêncio estoico.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8203@BODY_LORE"
msgstr "\"Eles não veem? Nossa vinda é um presente, um hospedeiro disposto oferecendo-se para encontrar uma cura para o que não pode ser curado...\" {EventPlayer} soa desesperado, embora <<p:EventPlayer>> logo recupere a compostura. \"Nossas súplicas permaneceram sem resposta por tempo demais. Agora pecamos, capturando um {EventUnit} para negociar uma conversa. Apenas pedimos para ser ouvidos, mas o {EventUnit} não fala.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8203@BUTTON_0"
msgstr "\"Mostre-me {EventStructure}, e lutarei por sua redenção.\" [relationLvl3/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8203@TITLE"
msgstr "Medidas Desesperadas"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8204@BODY_FOOTER"
msgstr "\"Meu destino em Emnora está selado,\" {EventPlayer} conclui. \"No entanto, como posso ajudá-lo em sua jornada, {PlayerLeader}?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8204@BODY_HEADER"
msgstr "Não muito depois do ocorrido em {EventStructure}, {EventPlayer} entra em contato com você, exultante."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8204@BODY_LORE"
msgstr "\"Você realizou um milagre, {PlayerLeader},\" diz <<p:EventPlayer>>, profundamente comovido. \"O {EventUnit} agora retornou aos anéis superiores de Emnora, onde <<p:EventUnit>> falará a nosso favor. <<Cp:EventUnit>> teme que nosso único caminho para a redenção possa ser através de um rito de passagem. Se for assim, ficaremos felizes em deixar este mundo como Arcontes, finalmente.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8204@BUTTON_0"
msgstr "\"Eu o consideraria um aliado valioso [rs_alliance/], {EventPlayer}.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8204@TITLE"
msgstr "Medidas Desesperadas: Consequências"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8205@BODY_FOOTER@REVENANT_BETRAYE"
msgstr "\"Podemos estar condenados, {PlayerLeader},\" {EventPlayer} grita freneticamente, \"mas nos resta um propósito vingativo: destruir você e seu povo.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8205@BODY_HEADER@REVENANT_BETRAYE"
msgstr "Não muito depois do ocorrido em {EventStructure}, {EventPlayer} entra em contato com você, tremendo de raiva."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8205@BODY_LORE@REVENANT_BETRAYE"
msgstr "\"Você nos condenou, {PlayerLeader}!\" <<p:EventPlayer>> grita em agonia. \"Fui um tolo em confiar em você em meu desespero. Agora, nossa esperança de reconciliação com os Arcontes foi esmagada, uma cura tornou-se impossível.\" Gritando violentamente, {EventPlayer} arranca a máscara que protege seu rosto, olhando para você como uma caveira cheia de ódio."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8205@BUTTON_7"
msgstr "\"Deixe suas terras para que meu povo as ocupe.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8205@BUTTON_8"
msgstr "\"Não desejo recompensa maior do que a salvação de suas almas.\" [goodact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8205@BUTTON_9"
msgstr "\"Que assim seja!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8206@BUTTON_4"
msgstr "\"Falarei com o {EventUnit}, embora não possa prometer mais.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8206@BUTTON_5"
msgstr "\"Os Arcontes estão certos: a maldição dos Renascidos não deve se espalhar.\" [relationLvl-3/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8212@BODY_FOOTER"
msgstr "\"Então, o Renascido envia outro defensor,\" diz a {EventUnit}. \"A corrupção pode assumir muitas formas, {EventHero}.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8212@BODY_FOOTER@NO_QUEST"
msgstr "Suas tropas não encontram nada de interessante, deixando o templo em paz."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8212@BODY_HEADER"
msgstr "Ao chegar à {EventStructure}, suas grandes portas são abertas pelos {EventRace} de {EventPlayer}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8212@BODY_HEADER@NO_QUEST"
msgstr "Suas tropas encontram um templo de arquitetura arconte, abandonado e selado."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8212@BODY_LORE"
msgstr "Eles conduzem você em silêncio ao centro do templo, onde uma {EventUnit} está detida dentro de um círculo de magia sombria. A {EventUnit} ajoelha-se no chão, protegida pelas quatro poderosas asas de <<o:EventUnit>>. Ao notar sua presença, <<p:EventUnit>> ergue levemente <<o:EventUnit>> cabeça. As palavras de <<Co:EventUnit>>, brilhantes e cortantes, ressoam pelo templo como uma provação."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8212@BODY_LORE@NO_QUEST"
msgstr "Há um aroma distinto de lavanda e mirra no ar, como um testemunho remanescente de cerimônias distantes, quando os Arcontes santificavam os mortos. Suas tropas percorrem o complexo da estrutura, mas o único portão que antes levava ao interior do templo está bloqueado por dentro."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8212@BODY_LORE@NO_RULER"
msgstr "Eles conduzem {EventHero} em silêncio ao centro do templo, onde uma {EventUnit} está detida dentro de um círculo de magia sombria. A {EventUnit} ajoelha-se no chão, protegida pelas quatro poderosas asas de <<o:EventUnit>>. Ao notar {EventHero}, <<p:EventUnit>> ergue levemente <<o:EventUnit>> cabeça. As palavras de <<Co:EventUnit>>, brilhantes e cortantes, ressoam pelo templo como uma provação."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8212@BUTTON_0"
msgstr "\"Você está enganado, {EventUnit}. Vim para libertá-lo desta prisão!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8212@BUTTON_1"
msgstr "\"Tanta arrogância. Tanta confiança. Pela maldição dos Renascidos [evilact/], você será meu escravo!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8212@BUTTON_2"
msgstr "Partir."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8212@BUTTON_3"
msgstr "\"Ouça-me, {EventUnit}, pelo bem dos {EventRace}.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8212@TITLE"
msgstr "A {EventStructure}"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8213@BODY_FOOTER"
msgstr "\"Antes de partir, posso conceder-lhe minha bênção, {EventHero},\" conclui a {EventUnit}. \"Qual chamado Celestial deseja seguir?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8213@BODY_FOOTER@ASTRA_CORRUPTED"
msgstr "\"Você despertou o Vazio dentro de mim, {EventHero},\" diz a {FallenUnit}. \"Quais poderes deseja?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8213@BODY_HEADER"
msgstr "\"Suas palavras parecem guiadas pelo Pai de Todos, {PlayerLeader},\" diz a {EventUnit}, e por um momento um sorriso ilumina o rosto de <<o:EventUnit>>."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8213@BODY_HEADER@ASTRA_CORRUPTED"
msgstr "Nem os {EventRace} nem a {EventUnit} <<r:EventUnit>> puderam detê-lo. Agora, sussurros sombrios espalham a maldição dos Renascidos."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8213@BODY_HEADER@ASTRA_FREED"
msgstr "Com os {EventRace} na {EventStructure} mortos, o feitiço que prendia a {EventUnit} foi quebrado."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8213@BODY_LORE"
msgstr "<<Cp:EventUnit>> chama o líder atual dos {EventRace} para se aproximar, dizendo que <<p:EventUnit>> deseja falar com {EventPlayer}.[br/][br/]Então, a {EventUnit} volta-se para você. \"Vejo seu desejo de chegar a Emnora, {EventHero}. Retorne ao {EventZiggurat} e tudo estará bem.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8213@BODY_LORE@ASTRA_CORRUPTED"
msgstr "\"Da Graça à Desgraça[br/]Da Vida à Não-Vida[br/]Para se tornar aquilo contra o que lutou[br/][runicfont]E habitar na sombra de Urrath[/runicfont]\"[br/][br/]Enquanto os sussurros insidiosos ecoam, tentáculos sombrios saem dos cadáveres dos {EventRace}, cobrindo a {EventUnit} até que <<p:EventUnit>> se levante novamente como uma {FallenUnit}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8213@BODY_LORE@ASTRA_FREED"
msgstr "\"Você me libertou,\" diz a {EventUnit}, abrindo <<o:EventUnit>> asas. \"E sou grato por isso. Vejo seu desejo de chegar a Emnora, {EventHero}. Retorne ao {EventZiggurat} e tudo estará bem.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8213@BUTTON_0"
msgstr "\"Desejo esmagar os ímpios.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8213@BUTTON_1"
msgstr "\"Desejo curar os humildes.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8213@BUTTON_2"
msgstr "\"Desejo ser um farol de santidade.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8213@BUTTON_3"
msgstr "\"Desejo despedaçar meus inimigos com decadência gélida.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8213@BUTTON_4"
msgstr "\"Desejo corromper tudo e todos.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8213@BUTTON_5"
msgstr "\"Desejo prosperar na morte.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8213@TITLE"
msgstr "O {EventStructure}: Consequências"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8216@BODY_FOOTER"
msgstr "\"A maldição do [hyperlink,GLOBAL.RevenantsLoreConcept]Revenante[/hyperlink] é uma corrupção da própria santidade,\" finaliza o {EventUnit}. \"Devemos proteger nossas terras Celestiais de seu alcance, ou tudo pode ser contaminado.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8216@BODY_HEADER"
msgstr "\"Você parece determinado,\" diz o {EventUnit}, abrindo <<o:EventUnit>> asas. \"No entanto, a compaixão é um dom que deve ser reservado aos vivos.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8216@BODY_LORE"
msgstr "\"Há santidade em cada alma, seja de Homem, Elfo ou Arconte,\" explica <<p:EventUnit>> com gravidade. \"Nós, {GLOBAL.ArchonsLoreConcept.Hyperlink}, vigiamos a integridade de todas as {GLOBAL.SoulsLoreConcept.Hyperlink} ao deixarem seus invólucros mortais, protegendo sua jornada para se reunirem ao {GLOBAL.AllfatherLoreConcept.Hyperlink}. A necromancia, porém, é uma perversão da alma. Ela abre as portas para o caminho sem retorno. Apenas o fim de sua não-vida pode restaurar a paz às almas que sofreram tal destino.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8216@BUTTON_0"
msgstr "\"Não podemos deixar o medo controlar nossas ações [influence/] ou Urrath terá vencido esta guerra!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8216@BUTTON_1"
msgstr "\"Alcançar o impossível, curar o incurável — que chamado maior poderia haver para os sábios [knowledge/] do divino?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8216@BUTTON_2"
msgstr "\"Quando viramos as costas para os fracos e doentes, perdemos a centelha da divindade que santificava nossas ações.\" [goodact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8216@BUTTON_3"
msgstr "Parta, por enquanto."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8216@TITLE"
msgstr "O Preço da Não-Vida"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8232@BODY_FOOTER"
msgstr "{EventPlayer} expira, <<o:EventPlayer>> corpo repousando como se finalmente tivesse encontrado paz. No entanto, você sabe que as obras de Urrath podem ser enganosas."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8232@BODY_HEADER"
msgstr "Derrotado e ferido, as últimas palavras de {EventPlayer} são ditas como se em um sonho febril e Umbral."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8232@BODY_LORE"
msgstr "\"As estrelas estão se apagando, a luz divina... devorada,\" murmura <<p:EventPlayer>>, \"Uma escuridão se adensa, absoluta e abrangente... O Poço eclipsado, para sempre ressecado... [runicfont]nossas bocas, portões Celestiais não mais[/runicfont]...\" De repente, <<o:EventPlayer>> olhos se abrem e <<o:EventPlayer>> mãos se contraem violentamente. \"Fiquem comigo, irmãos!\" grita <<p:EventPlayer>>. \"Meu pecado não deve manchar suas almas. Fujam do Vazio incessante! [runicfont]Fujam![/runicfont]\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8232@BUTTON_0"
msgstr "Santificar [mana/] o local onde {EventPlayer} caiu. [goodact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8232@BUTTON_1"
msgstr "Deixar os {EventRace} restantes lamentarem seu governante."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8232@BUTTON_2"
msgstr "Agitar as trevas para enxertar as almas [souls/] dos {EventRace}. [evilact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8232@TITLE"
msgstr "A Queda de {EventPlayer}"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8234@BODY_FOOTER"
msgstr "Porém, enormes cisalhamentos Astrais rasgam o vórtice. Não há tempo para entrar, apenas para puxar algo através..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8234@BODY_HEADER"
msgstr "Examinando o arco, você busca sintonizar sua mente com suas emanações arcanas."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8234@BODY_LORE"
msgstr "Há uma forte magia Celestial habitando o arco. Você consegue sentir os encantamentos divinos que imbuíram o arco com seu poder, mas ao retraçar suas correntes Astrais subjacentes, elas escapam ao seu alcance. Você mergulha mais fundo, seguindo as correntes através de ondulações e adentrando o turbilhão. Estende a mão até seu centro — e força a abertura de um vórtice estrelado na câmara do Zigurate!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8234@BUTTON_0"
msgstr "Invocar um ser divino [unit/] de Emnora."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8234@BUTTON_3"
msgstr "Invocar um ser corrupto [unit/] buscando infiltrar-se em Emnora."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8234@BUTTON_4"
msgstr "Invocar um ser Astral [unit/] que circunda Emnora."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8234@TITLE"
msgstr "Segredos da Ascensão"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8235@BODY_FOOTER"
msgstr "Em uma chuva de revelação, você ergue sua própria voz e fala..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8235@BODY_FOOTER@NO_RULER"
msgstr "Em uma chuva de revelação, {EventHero} ergue a voz de <<o:EventHero>> e fala..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8235@BODY_HEADER"
msgstr "Ajoelhando-se diante do arco, sua mente embarca em uma jornada espiritual."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8235@BODY_HEADER@NO_RULER"
msgstr "Ajoelhando-se diante do arco, a mente de {EventHero} embarca em uma jornada espiritual."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8235@BODY_LORE"
msgstr "É como se seu espírito tivesse atravessado o {EventStructure}, visitando os anéis superiores de Emnora. Você vê árvores abençoadas e grandiosas estátuas. Pessoas com traços angelicais viajam pelas estradas pavimentadas, entrando em salões iluminados por estrelas, onde oráculos falam dos dias que virão. Por fim, sua mente segue suas emanações divinas, sobrevoando o {GLOBAL.AstralSeaLoreConcept.Hyperlink}, até que a imagem vívida do {GLOBAL.TheWellLoreConcept.Hyperlink} preenche seus pensamentos, envolvendo gentilmente sua consciência, lavando mágoas, ambição, pecado..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8235@BODY_LORE@NO_RULER"
msgstr "É como se o espírito de <<o:EventHero>> tivesse atravessado o {EventStructure}, visitando os anéis superiores de Emnora. <<Cp:EventHero>> vê árvores abençoadas e grandiosas estátuas. Pessoas com traços angelicais viajam pelas estradas pavimentadas, entrando em salões iluminados por estrelas, onde oráculos falam dos dias que virão. Por fim, a mente de <<o:EventHero>> segue suas emanações divinas, sobrevoando o {GLOBAL.AstralSeaLoreConcept.Hyperlink}, até que a imagem vívida do {GLOBAL.TheWellLoreConcept.Hyperlink} preenche os pensamentos de <<o:EventHero>>, envolvendo gentilmente sua consciência, lavando mágoas, ambição, pecado..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8235@BUTTON_0"
msgstr "... um mantra [mana/] de fé. [knowledge/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8235@BUTTON_3"
msgstr "... um mantra [mana/] de zelo. [knowledge/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8235@BUTTON_4"
msgstr "... um mantra [mana/] de virtude. [knowledge/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8235@BUTTON_5"
msgstr "... um mantra [mana/] de luz. [knowledge/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8235@BUTTON_6"
msgstr "... um mantra de humildade. [order/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8235@TITLE"
msgstr "Orações de Ascensão"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8236@BODY_FOOTER"
msgstr "\"Posso ver que deseja transcender a si mesmo, {PlayerLeader},\" conclui {EventHero}. \"Permita-me ajudá-lo em sua jornada. Juntos, conseguiremos.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8236@BODY_HEADER"
msgstr "Aproximando-se da figura no fim da câmara, ela sai das sombras."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8236@BODY_LORE"
msgstr "\"Saudações, companheiro {GLOBAL.GodirLoreConcept.Hyperlink},\" diz <<p:EventHero>>. \"Eu sou {EventHero.TitleName}. Tenho observado este {EventStructure}. Muitos vieram para atravessar seu arco portal, mas todos partiram insatisfeitos. Apenas para dois, um Símio devoto e uma dama Élfica em desespero, o vórtice estrelado se abriu, mas sem permitir que muito conhecimento sobre sua magia Celestial fosse obtido...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8236@BUTTON_0"
msgstr "\"Junte-se a mim [unitHero/], {EventHero.TitleName}.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8236@BUTTON_3"
msgstr "\"Junte-se a mim [unitHero/], {EventHero.TitleName}, quando chegar a hora.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8236@BUTTON_4"
msgstr "\"O caminho para Emnora [influence/] é solitário.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8236@TITLE"
msgstr "Parceiros de Ascensão"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8237@BODY_FOOTER"
msgstr "\"Você me convocou, mestre!\" grita o {EventUnit}, rindo. \"Agora me comande, ó deus da destruição!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8237@BODY_HEADER"
msgstr "Você fica de pé com o {EventItem} erguido, pronto para destruir o arco..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8237@BODY_LORE"
msgstr "... e nada acontece. Então, você golpeia o arco com toda a sua força. O chão treme, mas o arco ancestral não mostra sequer a menor rachadura. Você golpeia de novo, e de novo, até que, por fim, um vórtice carmesim se abre no centro do arco. Antes que possa entrar em triunfo, no entanto, o vórtice se fecha novamente quando um {EventUnit} salta através dele."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8237@BUTTON_0"
msgstr "Aceitar o {EventUnit} em suas fileiras. [unit/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8237@BUTTON_3"
msgstr "Matar o {EventUnit} para treinamento. [xp/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8237@BUTTON_4"
msgstr "Ordenar que o {EventUnit} destrua [bindingfragments/] tantas relíquias de Arconte quanto <<p:EventUnit>> conseguir encontrar."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8237@TITLE"
msgstr "Ascensão Despedaçada"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8370@BODY_FOOTER"
msgstr "\"Não subestime {EventPlayer},\" {OracleName} o adverte. \"A fúria divina de <<Co:EventPlayer>> será liberada quando você menos esperar.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8370@BODY_HEADER"
msgstr "Na tensão de <<ge:provação^n,{EventPlayer}>>, {OracleName} se apresenta diante de você com um aviso."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8370@BODY_LORE"
msgstr "\"É um triste capricho do destino que você deva enfrentar os {EventRace}, {PlayerLeader},\" diz <<p:EventUnit>> com voz preocupada. \"Sua Ordem é renomada por suas habilidades marciais — e beligerância. Desde minha partida, sua influência entre as Ordens dos Arcontes diminuiu. Mas eles continuam sendo uma força a ser considerada, suas hostes Celestiais uma visão temível.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8370@BUTTON_0"
msgstr "\"Quando descerem, estaremos preparados.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8370@TITLE"
msgstr "Guerreiros Sagrados"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8374@BODY_FOOTER"
msgstr "Ao <<ge:comando^n,{EventPlayer}>>, as hostes Celestiais do reino marcham sobre suas cidades."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8374@BODY_HEADER"
msgstr "As nuvens acima de suas cidades se dissipam ao som das trombetas dos {EventRace}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8374@BODY_LORE"
msgstr "Acompanhado por seu chamado divino, a voz de {EventPlayer} se eleva, sublime e terrível:[br/][br/]\"Reúnam-se, meus campeões sagrados![br/]Concentrem a luz sagrada do {GLOBAL.AllfatherLoreConcept.Hyperlink} até que queime como uma chama purificadora![br/]Façam {PlayerLeader} tremer diante de seu poder!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8374@BUTTON_0"
msgstr "Prepare-se para enfrentar as forças celestiais."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8374@TITLE"
msgstr "Chamado do Arconte"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8382@BODY_FOOTER"
msgstr "Seguindo <<ge:mandato^n,{EventPlayer}>>, as hostes Celestiais do reino continuam seu assalto."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8382@BODY_HEADER"
msgstr "O som das trombetas anuncia a chegada de outro {GLOBAL.STRUCTURES.CRUSADER_HOST.Hyperlink} {EventDirection} {EventCity}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8382@BODY_HEADER@NO_CITIES"
msgstr "O som das trombetas anuncia a chegada de outro {GLOBAL.STRUCTURES.CRUSADER_HOST.Hyperlink} {EventDirection} você."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8382@BODY_LORE"
msgstr "Com um {EventStackLeader} à frente, os guerreiros sagrados do reino não demonstram cansaço ou remorso. A essa altura, está claro que, para deter seus ataques, você deve derrotar {EventPlayer} <<r:EventPlayer>>."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8382@BUTTON_0"
msgstr "\"Resistiremos até que {EventPlayer} seja dominado!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8382@TITLE"
msgstr "Tenacidade Celestial"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8386@BODY_FOOTER"
msgstr "\"Hoje devo recuar,\" diz {EventPlayer} enquanto o Manto dos Arcontes começa a envolver <<P:EventPlayer>>. \"Amanhã, os {EventRace} enfrentarão você com glória renovada.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8386@BODY_FOOTER@PLAYER_HUMANFORM"
msgstr "\"Ascendam a Emnora!\" grita {EventPlayer} enquanto o Manto dos Arcontes começa a envolver <<P:EventPlayer>>. \"E talvez ainda nos encontremos novamente como {EventRace}.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8386@BODY_HEADER"
msgstr "Em meio a rodas de carruagens estilhaçadas e armaduras Celestiais despedaçadas, {EventPlayer} permanece de pé, derrotado, mas não quebrado."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8386@BODY_LORE"
msgstr "\"Seus poderes são formidáveis, {PlayerLeader},\" diz <<p:EventPlayer>> com calma forçada, mas você pode sentir uma fúria tempestuosa rugindo dentro de <<P:EventPlayer>>. \"Você superou meus soldados, derrubou minhas muralhas, marchou através de chamas purificadoras. Assim, você passou por minha provação, e honrarei minha palavra concedendo-lhe passagem.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8386@BODY_LORE@PLAYER_HUMANFORM"
msgstr "\"Seus poderes são formidáveis, {PlayerLeader},\" <<p:EventPlayer>> o parabeniza, e há um estranho tom de orgulho em <<o:EventPlayer>> voz. \"Você superou meus soldados, derrubou minhas muralhas, marchou através de chamas purificadoras. Verdadeiramente, você provou seu potencial como um aspirante a Arconte e passou por minha provação.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8386@BUTTON_0"
msgstr "Planeje seu retorno à {EventStructure}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8386@TITLE"
msgstr "<<Cge:admissão^n,{EventPlayer}>>"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8398@BODY_FOOTER"
msgstr "\"Você deve dominar seus medos, {PlayerLeader}\", profetiza {OracleName}, \"ou sucumbirá às encarnações do sofrimento.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8398@BODY_HEADER"
msgstr "Tendo ascendido ao Terceiro Anel de Emnora, {OracleName} aparece diante de você, <<o:EventUnit>> rosto pálido como mármore."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8398@BODY_LORE"
msgstr "\"As visões estão ficando mais fortes, não estão, {PlayerLeader}?\" <<p:EventUnit>> pergunta, e você sabe que <<p:EventUnit>> não precisa de resposta. \"Eu falei sobre isso antes, como você se lembra: os {GLOBAL.AstralFlowsLoreConcept.Hyperlink} de Emnora são como espelhos perigosos da alma de cada Ascendente. Quanto mais alto você subir, mais fortes suas medos se tornarão — até que eles atravessem o espelho, manifestando-se em fantasmas que atacam sua sanidade e vida.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8398@BUTTON_0"
msgstr "\"Estarei pronto quando chegar a hora.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8398@BUTTON_3"
msgstr "\"Minha mente disciplinada [mana/] repelirá essas visões.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8398@BUTTON_4"
msgstr "\"Eu abraço [xp/] esta oportunidade de enfrentar meus medos!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8398@TITLE"
msgstr "Desgraça Iminente"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@BODY_FOOTER"
msgstr "As manifestações de seus medos estão marchando sobre {EventCity}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@BODY_FOOTER@NO_CITIES"
msgstr "As manifestações de seus medos estão marchando sobre você!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@BODY_HEADER"
msgstr "Despertando de um pesadelo, você encontra os sujeitos de sua perturbação tomando forma vívida."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@BODY_LORE"
msgstr "Há canalhas, saqueadores, ladrões invadindo seu domínio para roubar seus tesouros. O mais impiedoso entre eles, um {EventStackLeader}, apresenta sua bolsa vazia com um sorriso."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@BODY_LORE@ASTRAL"
msgstr "Há espíritos, {GLOBAL.AstralMonstersLoreConcept.Hyperlink}, sanguessugas cósmicas invadindo seu domínio para sugar sua riqueza arcana. O mais horrível entre eles, um {EventStackLeader}, invoca os horrores do {GLOBAL.AstralVoidLoreConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@BODY_LORE@CHAMPION"
msgstr "Há <<m:{GLOBAL.WizardKingLoreConcept.Hyperlink}>> e sua comitiva de magos de batalha invadindo seu domínio para causar caos mágico ao seu povo. O primeiro dos <<m:{GLOBAL.WizardKingLoreConcept.Hyperlink}>>, {EventStackLeader}, canaliza um terrível {EventItem}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@BODY_LORE@CHAOS"
msgstr "Há zelotes, inquisidores, tiranos invadindo seu domínio para impor ordem absoluta. O mais sagrado entre eles, um {EventStackLeader}, recita os mandamentos para que todos sigam."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@BODY_LORE@DRAGON"
msgstr "A própria terra treme enquanto os <<m:{GLOBAL.GiantKingLoreConcept.Hyperlink}>> se erguem, comandando seus semelhantes para destruir suas cidades. Elevando-se acima de todos está {EventStackLeader}, <<o:EventStackLeader>> {EventItem} sedento por sangue de dragão."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@BODY_LORE@ELDRITCH"
msgstr "Tentáculos sombrios se lançam enquanto os habitantes do {GLOBAL.UmbralAbyssConcept.Hyperlink} infligem a marca do {GLOBAL.UrrathLoreConcept.Hyperlink} sobre a terra e seu povo. Seu Soberano, {EventStackLeader}, clama a você: \"[runicfont]Regozijem-se! Seu retorno está próximo.[/runicfont]\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@BODY_LORE@GIANT"
msgstr "Os céus se rasgam enquanto os {GLOBAL.DragonsLoreConcept.Hyperlink} descem com destruição, prontos para arrasar suas cidades. Seu Ancião, {EventStackLeader}, ruge com poder primordial, invocando os horrores da queda de [hyperlink,GLOBAL.MyrridaLoreConcept]Myrrida[/hyperlink]."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@BODY_LORE@NATURE"
msgstr "Há caçadores, matadores, aventureiros invadindo seu domínio para caçar todas as criaturas, grandes e pequenas. O de olhar mais aguçado entre eles, um {EventStackLeader}, usa o crânio de um {AnimalUnit}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@BODY_LORE@ORDER"
msgstr "Há bufões infernais, devassos, demônios invadindo seu domínio para mergulhar seu povo no pecado. O mais aterrorizante entre eles, um {EventStackLeader}, mostra os dentes de <<o:EventStackLeader>> rosto grotesco."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@BODY_LORE@SHADOW"
msgstr "Há camponeses armados, pregadores, os chamados 'campeões dos humildes' invadindo seu domínio para instigar sua população. O mais audacioso entre eles, um {EventStackLeader}, encena o enforcamento de um boneco que claramente se parece com você, {PlayerLeader}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@BODY_LORE@WK"
msgstr "A própria terra treme enquanto suas encarnações elementais se erguem, invadindo seu domínio para destruir suas cidades. Elevando-se acima de todos está um {EventStackLeader}, <<o:EventStackLeader>> olhar imbuído de fúria primordial."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@BUTTON_0"
msgstr "Devemos resistir!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@TITLE"
msgstr "Encarnações da Desgraça"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@TITLE@ASTRAL"
msgstr "Encarnações da Seca"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@TITLE@CHAMPION"
msgstr "Encarnações da Soberba"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@TITLE@CHAOS"
msgstr "Encarnações da Subjugação"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@TITLE@DRAGON"
msgstr "Encarnações da Vingança Gigante"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@TITLE@ELDRITCH"
msgstr "Encarnações da Corrupção"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@TITLE@GIANT"
msgstr "Encarnações da Ira Dracônica"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@TITLE@MATERIUM"
msgstr "Encarnações do Furto"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@TITLE@NATURE"
msgstr "Encarnações da Caçada"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@TITLE@ORDER"
msgstr "Encarnações do Pecado"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@TITLE@SHADOW"
msgstr "Encarnações do Transtorno"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@TITLE@WK"
msgstr "Encarnações da Devastação"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8463@BODY_FOOTER"
msgstr "Enquanto os sábios Arcontes contemplam a fonte, você fica a ponderar seus próprios passos."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8463@BODY_HEADER"
msgstr "Ao entrar no salão central de {EventStructure}, você ouve o suave som de água corrente."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8463@BODY_LORE"
msgstr "O ruído vem da enorme fonte localizada logo abaixo da cúpula do observatório. A maioria dos sábios da Ordem dos Áugures observa a fonte e seus reflexos em constante mudança de vários pontos do salão. Seu silêncio conjunto é estranhamente cativante, convidando-o a juntar-se às suas meditações."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8463@BUTTON_0"
msgstr "Misturar-se à Ordem dos Áugures e meditar na fonte."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8463@BUTTON_1"
msgstr "Seguir as águas até o jardim do pátio."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8463@BUTTON_2"
msgstr "Sair."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8463@BUTTON_3"
msgstr "Visitar a Câmara das Profecias."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8463@TITLE"
msgstr "Sabedoria Fluente"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8464@BODY_FOOTER"
msgstr "Enquanto a voz se dissipa, a Profecia de Irith ainda ressoa em sua mente."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8464@BODY_HEADER"
msgstr "Na Câmara das Profecias, uma luz é acesa. De dentro de sua luz flutuante, uma voz pura recita:"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8464@BODY_LORE"
msgstr "\"Das trevas inteiro o sol nasceu[br/]Sua luz moldou tudo, sua luz deu vida[br/]Raios cromáticos, através das eras rompidos[br/]São capturados após a luta do guardião do sol[br/]Eis! Uma vez eclipsada, uma nova escuridão[br/]A ascensão de uma lua Umbral[br/]Distorce a luz, confunde falso e verdadeiro[br/]Suas sombras lançadas trazem a ruína do guardião do sol\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8464@BUTTON_0"
msgstr "Sair, por enquanto."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8464@BUTTON_3"
msgstr "\"A 'lua Umbral' tem um nome. Devemos lutar contra Urrath até o amargo fim!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8464@BUTTON_4"
msgstr "\"A 'ruína do guardião do sol' não deve ser irrevogável. Os Revenants devem ser recebidos com compaixão [goodact/], não com medo.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8464@BUTTON_5"
msgstr "\"Os 'raios cromáticos' estão novamente livres e os poderes brutos [mana/] do Endailon podem restaurar o antigo equilíbrio.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8464@TITLE"
msgstr "A Profecia de Irith"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8465@BODY_FOOTER"
msgstr "\"É fácil condenar o passado depois que uma profecia se cumpre,\" conclui {EventPlayer} com um sorriso. \"Não é, {PlayerLeader}?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8465@BODY_HEADER"
msgstr "Enquanto suas palavras ainda ecoam pela câmara das profecias, {EventPlayer} entra na sala."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8465@BODY_LORE"
msgstr "\"A Profecia de Irith previu muitos males que recairiam sobre o cosmos,\" diz <<p:EventPlayer>> pensativamente. \"Entre eles, o despedaçamento do meu povo.\" {EventPlayer} aponta para um relevo na parede, retratando um {GLOBAL.MaerLoreConcept.Hyperlink} flutuando através das [hyperlink,GLOBAL.AstralFlowsLoreConcept]Correntes Astrais[/hyperlink]. \"Eu sei quem dos {GLOBAL.GloomwatchLoreConcept.Hyperlink} o trouxe a estas terras, {PlayerLeader}. Diga a {OracleName} que <<p:EventUnit>> é bem-vindo para ficar nos Lagos da Sagacidade pelo tempo que <<p:EventUnit>> desejar.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8465@BUTTON_0"
msgstr "Concordar. Havia muitas formas como essa profecia poderia se desenrolar."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8465@BUTTON_5"
msgstr "Discordar. Apesar de conhecerem o futuro, os Arcontes cometeram erros graves."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8465@TITLE"
msgstr "Sabedoria Fluente: Consequências"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8466@BODY_FOOTER"
msgstr "Hipnotizado pela cena, leva um tempo até que você reflita sobre o que fazer."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8466@BODY_HEADER"
msgstr "Ecoando pela cúpula do {EventStructure}, uma voz extasiada pode ser ouvida."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8466@BODY_LORE"
msgstr "A voz pertence a um {EventUnit}, sentado no alto de um estrado. O <<EventUnit{homem/mulher}>> parece estar abalado por visões, irrompendo em exclamações, enquanto <<p:EventUnit>> se agarra às hastes douradas do estrado de <<o:EventUnit>>. Vários escribas estão reunidos abaixo do {EventUnit}, anotando as revelações de <<o:EventUnit>>, enquanto três atendentes administram a <<P:EventUnit>> águas e óleos para aliviar seu frenesi febril."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8466@BUTTON_0"
msgstr "Observar o {EventUnit} mais de perto."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8466@BUTTON_1"
msgstr "Entrar na ala da biblioteca do {EventStructure}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8466@BUTTON_2"
msgstr "Sair, por enquanto."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8466@BUTTON_3"
msgstr "Visitar a Câmara das Profecias."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8466@TITLE"
msgstr "Adivinhação Fervorosa"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8467@BODY_FOOTER"
msgstr "Virando-se para você, o sábio acrescenta: \"Os amigos de {OracleName} são hóspedes bem-vindos. Fiquem à vontade para dar uma olhada.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8467@BODY_HEADER"
msgstr "Ao entrar no {EventStructure}, você é acompanhado por {OracleName}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8467@BODY_LORE"
msgstr "Ambos encontram a Ordem dos Áugures trabalhando em silenciosa diligência, envolvidos em várias tarefas de arquivamento. No entanto, enquanto caminham pelo salão da cúpula, sussurros abafados começam a se espalhar, enquanto os Áugures lançam olhares furtivos em sua direção. Por fim, um dos sábios se aproxima, falando com {OracleName}: \"É um grande prazer recebê-lo de volta nesta casa da sabedoria, <<OracleName{irmão/irmã}>>. Verá que mantivemos suas obras em alta estima.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8467@BUTTON_0"
msgstr "Subir as escadas até o telhado do observatório."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8467@BUTTON_1"
msgstr "Levar {OracleName} para uma sala lateral para conversar em particular..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8467@BUTTON_2"
msgstr "Sair."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8467@BUTTON_3"
msgstr "Visitar a Câmara das Profecias."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8467@TITLE"
msgstr "Um Retorno Imprevisto"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8468@BODY_FOOTER"
msgstr "\"Embora, como vê,\" {EventPlayer} conclui seu discurso, \"este não é um fim para um Oráculo, apenas a transição para algo novo.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8468@BODY_HEADER"
msgstr "Enquanto suas palavras ainda ecoam pela Câmara das Profecias, {EventPlayer} entra na sala."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8468@BODY_LORE"
msgstr "\"Parece que você está destinado a algo de grande importância,\" <<p:EventPlayer>> se dirige a você, alisando a veste de <<o:EventPlayer>>, \"pois testemunhou um raro momento de verdadeira iluminação. E não menos um entrelaçado com minha própria profecia — a Profecia de Anon. Você pode ter se perguntado por que nossas profecias são nomeadas em homenagem a seus profetas. É bem simples: uma vez que um Oráculo se banhou na luz da verdade, seus sentidos divinos se ofuscam e nunca mais revelarão a luz do Pai de Todos.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8468@BUTTON_0"
msgstr "Agradecer a {EventPlayer} por seus insights."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8468@TITLE"
msgstr "Adivinhação Fervorosa: Consequências"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8469@BODY_FOOTER"
msgstr "\"Para os descrentes, a dúvida parece ser a inimiga da fé,\" conclui {EventPlayer}. \"No entanto, muitas vezes é aquele sem dúvida que é abandonado.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8469@BODY_HEADER"
msgstr "Enquanto suas palavras ainda ecoam pela Câmara das Profecias, {EventPlayer} entra na sala."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8469@BODY_LORE"
msgstr "\"Como pode ver, {PlayerLeader},\" diz <<p:EventPlayer>>, \"a interpretação de uma profecia pode causar divisão até mesmo entre nós {GLOBAL.ArchonsLoreConcept.Hyperlink}. Em certo sentido, é por isso que a Ordem dos Áugures existe: para que um discurso teológico saudável possa ser realizado sobre questões de importância cósmica. Enquanto outras Ordens formulam dogmas para guiar seus seguidores, nós formulamos dúvidas. Pois é quando paramos de duvidar que os maiores erros são cometidos.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8469@BUTTON_0"
msgstr "Concordar. A ovelha que segue cegamente seu pastor pode ser facilmente desviada."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8469@BUTTON_5"
msgstr "Discordar. A dúvida é a brecha pela qual os sussurros de Urrath podem entrar."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8469@TITLE"
msgstr "Um Retorno Imprevisto: Consequências"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8470@BODY_FOOTER"
msgstr "Enquanto a voz se dissipa, a Profecia de Anon ainda ressoa em sua mente."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8470@BODY_HEADER"
msgstr "Na Câmara das Profecias, um farol é aceso. De dentro de sua luz flutuante, uma voz profunda, que você reconhece como <<ge:voice^n,EventPlayer.FirstName>>, recita:"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8470@BODY_LORE"
msgstr "\"Miopia Divina, Equilíbrio Acorrentado;[br/]Impérios Gigantes Caem, Corrupção Reina;[br/][br/]Do Sangue do Traidor, o Rastro do Destino se Divide;[br/]Trevas Mortas, Através da Luz Fraturada;[br/][br/]O Guardião Divino deve Descansar, Para que Novos Poderes Surjam;[br/]Quem Pesa o Custo da Misericórdia, a um Fim Vingativo.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8470@BUTTON_0"
msgstr "Partir, por enquanto."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8470@BUTTON_3"
msgstr "\"Myrrida caiu por sua hubris. Não devemos repetir seus erros!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8470@BUTTON_4"
msgstr "\"O tempo de 'O Guardião Divino deve Descansar' chegou ao fim. Magehaven clama pelo [influence/] e poder dos Arcontes!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8470@BUTTON_5"
msgstr "\"Em Sordünn, a 'Luz Fraturada' será refeita!\" [bindingessence/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8470@TITLE"
msgstr "A Profecia de Anon"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8471@BODY_FOOTER"
msgstr "Enquanto a voz se dissipa, a Profecia de Miopthera ainda ressoa em sua mente."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8471@BODY_HEADER"
msgstr "Na câmara das profecias, um farol é aceso. De dentro de sua luz flutuante, uma voz familiar — <<ge:voice^n,{OracleName}>>! — recita:"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8471@BODY_LORE"
msgstr "\"Jovens são os filhos do crepúsculo[br/]Seus poderes criativos desatados[br/]Não cabe a nós guiar sua vontade[br/]Precisam de uma liberdade profunda[br/]Não tema seus sonhos na noite violenta[br/]Proteja-os do mal e de limites frios[br/]De berços moldados ao seu desejo[br/]Seu destino sublime se revelará.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8471@BUTTON_0"
msgstr "Partir, por enquanto."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8471@BUTTON_3"
msgstr "\"Nós, Godir, somos os 'filhos do crepúsculo'. Os dogmas dos Arcontes não nos deterão!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8471@BUTTON_4"
msgstr "\"O favoritismo humano custou muita credibilidade aos Arcontes. Reparações [gold/] para as outras raças poderiam mudar isso...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8471@BUTTON_5"
msgstr "\"Devemos aprender mais [knowledge/] sobre os Sonhadores e seu 'destino sublime!'\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8471@TITLE"
msgstr "A Profecia de Miopthera"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8473@BODY_FOOTER"
msgstr "\"Permita-me ajudá-lo a interpretar as profecias, {PlayerLeader},\" {EventHero.FirstName} insiste, \"para que você possa chegar ao Alto Conselho.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8473@BODY_HEADER"
msgstr "\"Ou assim dizem.\" {EventHero} volta a observar as águas ondulantes."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8473@BODY_LORE"
msgstr "\"Ficar junto aos Lagos da Sagacidade acalmou minha mente,\" continua <<p:EventHero>> após um momento. \"Observar o {GLOBAL.AstralSeaLoreConcept.Hyperlink}, ouvir a Ordem dos Áugures, ler tratados de Arcontes sobre profecias—tudo faz parte de uma jornada que eu não esperava. No entanto, meu coração está inquieto demais para saborear esses presentes.\"[br/][br/]\"Talvez não seja meu destino chegar a Emnora por conta própria. Talvez,\"—{EventHero.FirstName} se volta para você novamente—\"eu tenha sido trazido aqui como um auxiliar.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8473@BUTTON_0"
msgstr "Aceitar {EventHero} em suas fileiras. [unitHero/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8473@BUTTON_3"
msgstr "Convidar {EventHero.FirstName} para sua Torre do Feiticeiro [caststrategic/] para fortalecer sua magia."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8473@TITLE"
msgstr "Um Chamado Fatídico"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8475@BODY_FOOTER"
msgstr "\"A resposta está inerente nestas águas,\" sugere o sábio, \"oculta, mas palpável. Consegue lê-la, {PlayerLeader.Name}?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8475@BODY_HEADER"
msgstr "Em meio aos sábios da Ordem dos Áugures, um deles se aproxima de você em silêncio."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8475@BODY_LORE"
msgstr "\"As águas da fonte são hipnotizantes, não são?\" comenta <<p:EventUnit>> com uma voz abafada. \"Sob seu feitiço, Irith pronunciou sua profecia fatídica. As eras passaram e aqui ainda estamos, ponderando seu significado completo: já se cumpriu a 'ruína do guarda-sol'? Ou é o destino de todos os {GLOBAL.ArchonsLoreConcept.Hyperlink} se tornarem {GLOBAL.RevenantsLoreConcept.Hyperlink} no fim?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8475@BUTTON_0"
msgstr "Recusar-se a ler as águas."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8475@BUTTON_3"
msgstr "Deixar seu olho arcano [mana/] desvendar os segredos [knowledge/] da fonte."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8475@TITLE"
msgstr "Uma Profecia de Ruína"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8476@BODY_FOOTER"
msgstr "\"Sinto a presença do {GLOBAL.EndailionLoreConcept.Hyperlink}, distante, mas abrangente,\" conclui {EventHero.FirstName}. \"Consegue senti-la também?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8476@BODY_HEADER"
msgstr "Ao entrar no jardim, você é acompanhado por {EventHero}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8476@BODY_LORE"
msgstr "\"Há uma beleza nestes jardins dos Arcontes que eu não esperava,\" diz {EventHero.FirstName}, com os olhos de <<o:EventHero>> fechados enquanto <<p:EventHero>> respira lentamente. \"Vemos os {GLOBAL.ArchonsLoreConcept.Hyperlink} como guerreiros sagrados, sacerdotes, paladinos, sem perceber que eles eram os arquitetos e jardineiros dos mundos.\" <<Cp:EventHero>> o leva até um canteiro exuberante de flores. \"Se ao menos tivessem lembrado da beleza de todas as cores. Mas, ao eliminar as ervas daninhas, condenaram suas próprias obras.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8476@BUTTON_0"
msgstr "\"Sinto fervor, ardente e estimulante.\" [chaosboon/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8476@BUTTON_3"
msgstr "\"Sinto rancor, frio e implacável.\" [shadowboon/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8476@BUTTON_4"
msgstr "\"Sinto crescimento, emaranhado e desenfreado.\" [natureboon/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8476@BUTTON_5"
msgstr "\"Sinto operosidade, firme e constante.\" [materiumboon/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8476@BUTTON_6"
msgstr "\"Sinto unidade, estruturada e harmoniosa.\" [orderboon/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8476@BUTTON_7"
msgstr "\"Sinto engenhosidade, pulsante e encantadora.\" [astralboon/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8476@BUTTON_8"
msgstr "\"Estou desprovido da influência do Endailion.\" [influence/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8476@TITLE"
msgstr "Ecos Florescentes"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8493@BODY_FOOTER"
msgstr "\"Eu o encorajo a explorar essas primeiras obras dos Arcontes,\" convida {EventHero.FirstName}. \"É esclarecedor, mesmo que não necessariamente no sentido dos Arcontes.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8493@BODY_HEADER"
msgstr "Na ala da biblioteca de {EventStructure}, você é acompanhado por {EventHero}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8493@BODY_LORE"
msgstr "\"Dar uma olhada na riqueza de textos que debatem suas profecias me ensinou muito sobre os {GLOBAL.ArchonsLoreConcept.Hyperlink},\" diz <<p:EventHero>>, enquanto os dedos de <<o:EventHero>> percorrem lentamente os símbolos nas estantes, indicando sua era e categoria. \"Eles acreditavam que a Profecia de Anon prenunciava a queda de {GLOBAL.MyrridaLoreConcept.Hyperlink}. Por isso, após Myrrida ser sitiada, eles se retiraram de muitos {GLOBAL.WorldsWithinLoreConcept.Hyperlink}, pois 'O Guarda Divino deve Descansar, Para que Novos Poderes Surjam'. O que, por sua vez, facilitou a {GLOBAL.EndailonCrisisLoreConcept.Hyperlink}...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8493@BUTTON_0"
msgstr "Ler sobre o Pai de Todos e a criação dos Arcontes. [order/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8493@BUTTON_3"
msgstr "Leia sobre a expansão do Mar Astral. [arcana/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8493@BUTTON_4"
msgstr "Leia sobre a Urselva e sua evolução desenfreada. [nature/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8493@BUTTON_5"
msgstr "Leia sobre a formação dos Mundos Interiores através de Dragões e Gigantes. [matter/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8493@BUTTON_6"
msgstr "Leia sobre o tumulto cósmico durante a Crise de Endailon. [chaos/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8493@BUTTON_7"
msgstr "Leia sobre o surgimento de Urrath do Vazio Astral. [shadow/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8493@TITLE"
msgstr "Aberrações Registradas"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8494@BODY_FOOTER"
msgstr "<<Cge:eyes^p,{EventHero.FirstName}>> ficam enevoados enquanto <<p:EventHero>> observa as estrelas acima. \"Nós nunca soubemos das apostas cósmicas envolvidas. Mas todos sofremos as consequências.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8494@BODY_HEADER"
msgstr "Ao alcançar o teto estrelado de {EventStructure}, você encontra {EventHero} absorto em pensamentos."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8494@BODY_LORE"
msgstr "\"Ser confrontado com a profecia que moldou a vida da minha família — e de raças inteiras em {GLOBAL.AthlaLoreConcept.Hyperlink} — é impressionante,\" diz {EventHero.FirstName} assim que <<p:EventHero>> nota sua presença. \"A Ordem de {EventRace} se formou em torno de uma crença muito específica: a de que a Profecia de Miopthera falava da então ainda jovem raça Humana. Eles permitiram que os Elfos semeassem mundo após mundo para os Humanos habitarem, para que pudessem ascender à condição de Arcontes. Até que meu pai rompeu seu antigo acordo em {GLOBAL.AthlaLoreConcept.Hyperlink}...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8494@BUTTON_0"
msgstr "Console {EventHero} conectando-se aos fluxos [mana/] para realçar a beleza do Mar Astral."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8494@BUTTON_3"
msgstr "Deixe {EventHero.FirstName} com <<o:EventHero>> melancolia."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8494@TITLE"
msgstr "Tragédias dos Altos-Humanos"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8495@BODY_FOOTER"
msgstr "Após esta última revelação, {EventUnit} é levado a um local de descanso nas câmaras atrás do salão da cúpula."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8495@BODY_HEADER"
msgstr "Aproximando-se de {EventUnit}, as palavras violentamente proferidas por <<o:EventUnit>> ficam mais claras."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8495@BODY_LORE"
msgstr "\"... luz fragmentada, ela está se apagando... corrompida pelas mãos deformadas do traidor... a filha, ela deve se reunir à mãe... união impossível entre escuridão e luz...\"[br/][br/]{EventUnit} desaba, sendo carregado para descansar por seus atendentes. Ao passarem por você, o <<EventUnit{homem/mulher}>> de repente se levanta mais uma vez: \"Em Sordünn... nos Penhascos de Sordünn novos poderes surgem!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8495@BUTTON_0"
msgstr "Reflita sobre as palavras de {EventUnit}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8495@TITLE"
msgstr "Um Momento de Profecia"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8496@BODY_FOOTER"
msgstr "\"Foi somente depois que o {GLOBAL.GloomwatchLoreConcept.Hyperlink} me encontrou no exílio que minha profecia — e, portanto, minha vida — recebeu novo significado,\" conclui {OracleName} em sua reminiscência. \"Agora eu amparo os {GLOBAL.DreamersLoreConcept.Hyperlink}, os verdadeiros 'Filhos do Crepúsculo'.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8496@BODY_HEADER"
msgstr "Quando ficam a sós, antes que você possa confrontar <<P:OracleName>>, {OracleName} já ergue a voz:"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8496@BODY_LORE"
msgstr "\"Eu sabia que esta conversa viria,\" diz <<p:OracleName>>, tocando as têmporas. \"E nesta fase, você merece saber mais. Há muito tempo — em uma vida diferente — eu costumava ser um Arconte da Ordem dos Áugures. Após minha epifania, as consequências da minha própria profecia eram assustadoras: a ascensão da Ordem de {EventRace}, o preparo de mundos inteiros para a humanidade, as crescentes tensões com outras raças... Eu desesperava, incapaz de deter o que minhas palavras haviam posto em movimento.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8496@BUTTON_0"
msgstr "Agradeça a {OracleName} por <<o:OracleName>> confiança em você."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8496@TITLE"
msgstr "O Arconte Renegado"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8534@BODY_FOOTER"
msgstr "As vozes se dissipam, permitindo que sua mente exausta descanse. Você pode intuir que o veredito delas ainda está por vir."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8534@BODY_HEADER"
msgstr "Em meio às grandiosas estátuas do Alto Conselho, uma luz radiante envolve seus sentidos. Você vê visões de espíritos flamejantes, cujas palavras de debate ecoam em sua mente:"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8534@BODY_LORE"
msgstr "\"Eles demonstraram sinais de grande promessa.\"[br/]\"Isso não importa. Os [hyperlink,GLOBAL.GodirLoreConcept]Deogai[/hyperlink] não são confiáveis.\"[br/]\"Eles não são unificados, suas vozes estão em desacordo.\"[br/]\"Os caminhos de [hyperlink,GLOBAL.AllfatherLoreConcept]Illaetas[/hyperlink] são múltiplos.\"[br/]\"[hyperlink,GLOBAL.TurielLoreConcept]Turiel[/hyperlink] nos alertou sobre suas ambições.\"[br/]\"A [hyperlink,GLOBAL.GrexolisLoreConcept]tarefa[/hyperlink] que lhe impusemos o afogou em Sombras.\"[br/]\"Há Pastores entre eles, sinceros e vigilantes.\"[br/]\"No entanto, há Açougueiros, Incitadores de Ódio, Profanadores.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8534@BUTTON_0"
msgstr "Aproxime-se do próximo assento de comunhão."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8534@TITLE"
msgstr "O Alto Conselho dos Arcontes: Alfa"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8536@BODY_FOOTER"
msgstr "As vozes se dissipam, permitindo que sua mente exausta descanse. Você pressente que o veredito deles está próximo."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8536@BODY_HEADER"
msgstr "Com o retorno da luz radiante, o debate do conselho continua:"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8536@BODY_LORE"
msgstr "\"O [hyperlink,GLOBAL.MagehavenLoreConcept]farol[/hyperlink] foi abandonado, os luminares se apagaram.\"[br/]\"O erro do guardião não deve se repetir.\"[br/]\"A guerra deles é a nossa guerra, nossos caminhos se fundem.\"[br/]\"Eles são suscetíveis à voz de [hyperlink,GLOBAL.UrrathLoreConcept]Nilfero[/hyperlink].\"[br/]\"Sua angústia aflige até Emnora.\"[br/]\"O destino deles prenuncia o fim.\"[br/]\"Será que suas almas não anseiam por [hyperlink,GLOBAL.AllfatherLoreConcept]Illaetas[/hyperlink]?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8536@BUTTON_0"
msgstr "Aproxime-se do próximo assento de comunhão."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8536@TITLE"
msgstr "O Alto Conselho dos Arcontes: Nu"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8537@BODY_FOOTER"
msgstr "A voz do conselho se dissipa, e {EventHero} some em sua luz."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8537@BODY_HEADER"
msgstr "Da luz radiante emerge uma roda flamejante de olhos. Seu olhar petrifica sua existência, enquanto você ouve a voz unificada do conselho:"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8537@BODY_LORE"
msgstr "\"Escute, {PlayerLeader}, arauto da necessidade: a luz que buscou ainda arde dentro de você. Seja a tocha que reacende os faróis de Magehaven, sinalizando o retorno do Exército do Pai de Todos!\"[br/][br/]\"Escute, {EventHero}, prole do outono: a frieza do inverno ficou para trás. Não tema. Dê um passo à frente, rumo à luz. Em Emnora, os botões da primavera florescem.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8537@BUTTON_0"
msgstr "Está feito."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8537@TITLE"
msgstr "O Alto Conselho dos Arcontes: Ômega"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8539@BODY_FOOTER"
msgstr "\"Eu... preciso de um tempo para pensar. Por favor, {PlayerLeader}, permita que eu me retire para sua Torre do Feiticeiro, por enquanto.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8539@BODY_HEADER"
msgstr "No calor da batalha, no momento em que {EventHero} está prestes a cair, a Proteção dos Arcontes subitamente envolve <<P:EventHero>>."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8539@BODY_LORE"
msgstr "Quando <<p:EventHero>> ressurge da luz, <<o:EventHero>> ferimentos parecem estar curados. \"Não sei o que aconteceu\", diz {EventHero.FirstName}, olhando para <<o:EventHero>> mãos imaculadas com incredulidade. \"Mas parece que, mais uma vez, há forças em jogo que não querem que minha jornada termine.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8539@BUTTON_0"
msgstr "Permita que {EventHero.FirstName} suspenda <<o:EventHero>> deveres como seu herói."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8539@BUTTON_1"
msgstr "Recuse <<ge:request^n,{EventHero.FirstName}>>. [happiness/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8539@TITLE"
msgstr "Intervenção Divina"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8549@BODY_FOOTER"
msgstr "\"Pelo poder de {EventPlayer}, {EventPlayer.Title},\" diz o homem, revelando <<o:EventPlayer>> rosto. \"Você não passará!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8549@BODY_FOOTER@SURPRISE_ATTACK"
msgstr "\"Pelo poder da Ordem dos Áugures,\" {EventPlayer} grita desafiador, \"você não passará!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8549@BODY_HEADER"
msgstr "Acompanhado por um único escriba, um homem encapuzado, humilde mas exaltado, espera por você ao pé das escadarias do Zigurate."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8549@BODY_HEADER@SURPRISE_ATTACK"
msgstr "Você ataca sem aviso, mas em uma fração de segundo {EventPlayer} ergue <<o:EventPlayer>> cajado para invocar um escudo de luz estelar."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8549@BODY_LORE"
msgstr "\"Retroceda, imundo {PlayerLeader}!\" grita o homem, erguendo <<o:EventPlayer>> cajado em desafio. \"As estrelas me revelaram suas maquinações vis. Não permitirei que profane estas terras abençoadas. Retorne às sombras ou enfrentará a verdadeira ira dos {GLOBAL.ArchonsLoreConcept.Hyperlink}!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8549@BODY_LORE@SURPRISE_ATTACK"
msgstr "\"Retroceda, imundo {PlayerLeader}!\" {EventPlayer} grita, resistindo atrás de <<o:EventPlayer>> proteção. \"As estrelas me revelaram suas intenções vis. Não permitirei que profane estas terras abençoadas. Retorne às sombras ou enfrentará a verdadeira ira dos {GLOBAL.ArchonsLoreConcept.Hyperlink}!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8549@BUTTON_0"
msgstr "Aceite o desafio. Amanhã, os céus chorarão sangue."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8549@TITLE"
msgstr "Revelações Profanas"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8551@BODY_FOOTER"
msgstr "\"Você está condenado para sempre, {PlayerLeader},\" {EventPlayer} exclama enquanto o Ward dos Arcontes envolve <<P:EventPlayer>>. \"No [hyperlink,GLOBAL.AstralVoidLoreConcept]Vazio[/hyperlink], você se arrependerá.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8551@BODY_HEADER"
msgstr "Os Lagos da Sagacidade estão contaminados com o sangue dos {EventRace}. {EventPlayer} <<r:EventPlayer>> foi levado aos <<o:EventPlayer>> joelhos."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8551@BODY_LORE"
msgstr "\"A malignidade crescente do Panteão ganhou poder além de nossas previsões,\" diz <<p:EventPlayer>> lentamente, reunindo as <<o:EventPlayer>> últimas forças. \"Poderia ser... a Profecia de Dygenion... Eu deveria ter percebido antes.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8551@BUTTON_0"
msgstr "Que tolo. Minha vitória estava predestinada!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8551@TITLE"
msgstr "Triunfo Perverso"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8552@BODY_FOOTER"
msgstr "Sombras densas se avolumam no {EventStructure}, ligando sua magia à sua vontade. O caminho para o anel mais alto está finalmente aberto."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8552@BODY_HEADER"
msgstr "Parado no local da <<ge:fall^n,{EventPlayer}>>, você canaliza a arcana residual de <<o:EventPlayer>> para realizar um ritual sombrio:"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8552@BODY_LORE"
msgstr "\"Da luz maculada[br/]Às sombras profundas[br/]Calamidade profana[br/]Uma chave colherá[br/]A porta sagrada[br/]Para sempre aberta estará.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8552@BUTTON_0"
msgstr "Prepare-se para enfrentar o Alto Conselho dos Arcontes."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8552@TITLE"
msgstr "Revelações Profanas: Consequências"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8559@BODY_FOOTER"
msgstr "A tempestade celestial do Alto Conselho dos Arcontes se enfurece. Eles sabem que você está chegando."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8559@BODY_HEADER"
msgstr "Descendo a escadaria do último Zigurate em triunfo sinistro, você contempla a sede do Alto Conselho dos Arcontes."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8559@BODY_LORE"
msgstr "Estátuas angelicais e árvores sagradas ladeiam seu caminho, que serpenteia até um enorme {EventStructure}. No entanto, assim que você pisa no caminho, a tranquilidade se dissipa. Uma brisa sobrenatural rapidamente se transforma em tempestade, curvando as fileiras de árvores sagradas, e vozes trovejantes, exaltadas mas perturbadas, ecoam das paredes da fonte monumental."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8559@BUTTON_0"
msgstr "Aproxime-se da sede do Alto Conselho dos Arcontes."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8559@TITLE"
msgstr "Um Conselho em Turbulência"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8560@BODY_FOOTER"
msgstr "Com poder divino unificado, o Alto Conselho dos Arcontes o baniu de Emnora. No entanto, eles não podem desfazer o que você realizou..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8560@BODY_HEADER"
msgstr "Ao alcançar as águas do {EventStructure}, você é cegado por uma luz avassaladora."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8560@BODY_LORE"
msgstr "Há formas na luz, iradas, horrorizadas. Você imagina ver asas, incontáveis, batendo em terror, enquanto as vozes trovejantes clamam seu nome com tal fervor que os próprios céus são abalados."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8560@BUTTON_0"
msgstr "\"Eu... retornarei!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8560@TITLE"
msgstr "Um Conselho em Turbulência: Consequências"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8561@BODY_FOOTER"
msgstr "\"Meus deveres como seu enviado ascendido terminaram,\" {OracleName} declara, invocando uma esfera de luz estelar ao redor de <<r:OracleName>>. \"Nos encontraremos novamente como inimigos.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8561@BODY_HEADER"
msgstr "Enquanto planeja sua conquista de Emnora, você é interrompido por {OracleName}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8561@BODY_LORE"
msgstr "\"Eu o guiei através de enigmas e chamas purificadoras,\" diz <<p:OracleName>>, o <<o:OracleName>> rosto pálido como marfim. \"Mas, infelizmente, quando se trata de você, {PlayerLeader}, minha precognição me falhou. Agora, você busca trazer corrupção às terras mais sagradas do meu povo.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8561@BUTTON_0"
msgstr "Deixe <<P:OracleName>> desaparecer. <<Cp:OracleName>> pagará por <<o:OracleName>> traição a seu tempo."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8561@TITLE"
msgstr "A Partida de {OracleName}"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8575@BODY_FOOTER"
msgstr "\"Não!\" {EventPlayer} grita com as últimas forças de <<o:EventPlayer>>. \"Através do {GLOBAL.AstralSeaLoreConcept.Hyperlink}, nossas {GLOBAL.SoulsLoreConcept.Hyperlink} navegarão, infalíveis, perseverantes, até retornarmos a... {GLOBAL.TheWellLoreConcept.Hyperlink}...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8575@BODY_HEADER"
msgstr "O saco vocal de <<Co:EventPlayer>> sangrando a cada sílaba pronunciada, {EventPlayer} entoa debilmente o próprio réquiem."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8575@BODY_LORE"
msgstr "\"Onde está a galé dos Arcontes com as abençoadas reforços?\" <<p:EventPlayer>> lamenta. \"Onde está o farol que nos guia a portos seguros? Os {EventRace} jazem esmagados nas praias da batalha. Seu destino não é digno da libertação dos Arcontes?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8575@BUTTON_0"
msgstr "Acenda uma fogueira [mana/], guiando os {EventRace} em sua jornada final."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8575@BUTTON_1"
msgstr "Deixe <<P:EventPlayer>> morrer em paz."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8575@BUTTON_2"
msgstr "\"Pesque\" as almas à deriva [souls/] dos {EventRace}. [evilact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8575@TITLE"
msgstr "A Queda de {EventPlayer}"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8618@BODY_FOOTER"
msgstr "\"O que me diz, {PlayerLeader},\" {EventPlayer} pergunta, a pele de <<o:EventPlayer>> agora com um tom amarelado, \"devemos banquetear-nos em amizade?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8618@BODY_HEADER"
msgstr "Enquanto seus batedores patrulham as fronteiras, vigiando os {GLOBAL.RevenantsLoreConcept.Hyperlink} de {RevenantPlayer}, você ouve o familiar coaxar de {EventPlayer} ao longe."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8618@BODY_LORE"
msgstr "\"Justo {PlayerLeader},\" {EventPlayer} entoa, a pele de <<o:EventPlayer>> mudando de cor como se transmitisse uma mensagem própria. \"É um prazer vê-lo juntar-se à cruzada contra {RevenantPlayer}. As águas turbulentas perto de {EventCity} são traiçoeiras para navegar. No entanto, se partirmos juntos, nosso desembarque será triunfal!\"[br/][br/]\"É costume entre meu povo selar uma aliança com uma troca de comida e homens,\" <<p:EventPlayer>> continua, revelando um grande banquete com supostas iguarias dos {EventRace} atrás de <<P:EventPlayer>>."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8618@BUTTON_0"
msgstr "Aceite a aliança [rs_alliance/] e uma troca de tropas. [unit/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8618@BUTTON_3"
msgstr "Aceite a aliança [rs_alliance/] e uma troca de comida. [food/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8618@BUTTON_4"
msgstr "Aceite a aliança [rs_alliance/], mas decline educadamente o resto."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8618@BUTTON_5"
msgstr "Recuse a oferta. A guerra contra {RevenantPlayer} é sua."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8618@TITLE"
msgstr "Uma Brisa Acolhedora"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8623@BODY_FOOTER"
msgstr "\"Em nome de {GLOBAL.AthlaLoreConcept.Hyperlink} e {GLOBAL.MagehavenLoreConcept.Hyperlink}, eu lhe suplico, {PlayerLeader}:\" {EventHero} conclui o chamado de <<o:EventHero>>, \"pare com essa loucura agora, enquanto sua alma ainda pode encontrar paz.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8623@BODY_HEADER"
msgstr "Invadindo os Lagos da Sagacidade, você encontra um solitário <<EventHero{homem/mulher}>> élfico, chamando por você à distância."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8623@BODY_LORE"
msgstr "\"Saia agora, {PlayerLeader}!\" <<p:EventHero>> grita, a voz suave de <<o:EventHero>> emanando autoridade. \"Pois estas terras abençoadas merecem permanecer em paz. Vim aqui abalado por horrores. Ficar com a Ordem dos Áugures acalmou minha mente.\"[br/][br/]\"Eu sou {EventHero}, meu povo compartilhando uma história violenta com os {GLOBAL.ArchonsLoreConcept.Hyperlink},\" <<p:EventHero>> continua, revelando-se a você. \"Como poucos outros, conheço o fascínio maculado da vingança. Quando guardamos rancor, convidamos o mal. O caminho para Emnora passa pelo perdão...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8623@BUTTON_0"
msgstr "O aviso de <<Co:EventHero>> é uma prova do seu poder! [influence/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8623@TITLE"
msgstr "Um Elfo Entre Arcontes"

msgid "DLC@ARCHONPROPHECY@STORY_REALMS@NAME"
msgstr "Intervenção Divina"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@CB@DAFAEL"
msgstr "Ameaça dos Renascidos a Emnora"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@CB@MALIEL"
msgstr "Mandato Celestial"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@CB@REVENANT_FREED_ASTRA"
msgstr "Esperanças dos Renascidos por uma Cura Destruídas"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@COUNCIL_COMMUNION_OBJECTIVE"
msgstr "{INT_0}/{INT_1} Comungou com o Alto Conselho"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@DEFEAT_ANONL_QUEST_OBJECTIVE"
msgstr "{INT_0}/{INT_1} Anon Derrotado"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@DEFEAT_MALIEL_QUEST_OBJECTIVE"
msgstr "{INT_0}/{INT_1} Maliel Derrotado"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@DEFEAT_REVENANT_QUEST_OBJECTIVE"
msgstr "{INT_0}/{INT_1} Revenantes Derrotados"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@DESCRIPTION"
msgstr "Entre no reino oculto de Emnora, fortaleza dos {GLOBAL.ArchonsLoreConcept.Hyperlink}, em busca de ajuda contra {GLOBAL.UrrathLoreConcept.Hyperlink}. Lute ou negocie seu caminho através das camadas da Ordem Celestial para provar seu valor e {GLOBAL.MagehavenLoreConcept.Hyperlink} digno da atenção do Alto Conselho dos Arcontes."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@EFFECT@WIZARD_TOWER_REWARD"
msgstr "Sua {GLOBAL.ThroneCityConcept.Hyperlink} {EventCity} ganha a {GLOBAL.STRUCTURE_UPGRADES.WIZARD_TOWER_FOUNDATION.Hyperlink} {GLOBAL.CityStructureConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@FALLEN_ANGEL_NO_UPKEEP_PROP@DESCRIPTION"
msgstr "Esta unidade está ligada ao seu dono pela Maldição do Revenante e não custa manutenção."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@FALLEN_ANGEL_NO_UPKEEP_PROP@NAME"
msgstr "Vínculo de Corrupção"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@GLOOMWATCH_RACE@DESCRIPTION"
msgstr "Em {GLOBAL.GloomwatchLoreConcept.Hyperlink}, pessoas de diversas raças e origens se unem, ligadas por seu serviço aos {GLOBAL.DreamersLoreConcept.Hyperlink} — e pela resistência contra {GLOBAL.UrrathLoreConcept.Hyperlink}. Um grupo particularmente misterioso entre eles são os Emissários de Gloomwatch. Eles têm aparência justa e são adoradores fervorosos do {GLOBAL.AllfatherLoreConcept.Hyperlink}. Como tal, possuem grande conhecimento sobre os {GLOBAL.ArchonsLoreConcept.Hyperlink} e estão dispostos a ajudar o {GLOBAL.GodirLoreConcept.Hyperlink} de [hyperlink,GLOBAL.MagehavenLoreConcept]Magehaven[/hyperlink] em sua busca por contato com os Arcontes."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@GLOOMWATCH_RACE@NAME"
msgstr "Emissários de Gloomwatch^p"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@HIGH_COUNCIL@NAME"
msgstr "Assento do Conselho^N"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@INFILTRATE_COUNCIL_OBJECTIVE"
msgstr "Alto Conselho Infiltrado"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@JULIA_WITHDRAWS"
msgstr "Você perde {EventHero} como {GLOBAL.HeroConcept.Hyperlink} no mapa."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@MAIN_OBJECTIVE_FINAL"
msgstr "{AP1_COUNCIL_COMMUNED}/1 Alto Conselho dos Arcontes Contatado"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@MAIN_OBJECTIVE_FINAL_ALT"
msgstr "{AP1_COUNCIL_COMMUNED}/1 Alto Conselho dos Arcontes Infiltrado"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@MAIN_OBJECTIVE_FOURTH_RING"
msgstr "{AP1_RING_04_UNLOCKED}/1 Quarto Anel Acessível"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@MAIN_OBJECTIVE_FOURTH_RING_02"
msgstr "{AP1_RING_04_ENTERED}/1 Quarto Anel Adentrado"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@MAIN_OBJECTIVE_SECOND_RING"
msgstr "{AP1_RING_02_UNLOCKED}/1 Segundo Anel Acessível"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@MAIN_OBJECTIVE_SECOND_RING_02"
msgstr "{AP1_RING_02_ENTERED}/1 Segundo Anel Adentrado"

