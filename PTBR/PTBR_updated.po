msgstr "Presença Divina"

msgid "TOME_GOD_EMPEROR@PASSIVE@PROPERTY@DESCRIPTION"
msgstr "Todas as unidades amigáveis durante a batalha ganham {morale} {GLOBAL.UnitMoraleConcept.Hyperlink}."

msgid "TOME_GOD_EMPEROR@SKILL1@DESCRIPTION"
msgstr "Por {EXALTED_CHAMPION_STATUS_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>, torna a unidade amigável alvo:[bulletlist][bullet/]Causa +{EXALTED_CHAMPION_DAMAGE_MULITPLIER>ResolvedMultiplier}% de dano.[bullet/]Ganha {stacks} {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink}.[bullet/]Ganha {stacks} {GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink}.[bullet/]Ganha {stacks} {GLOBAL.PROPERTIES.STATUS_PROTECTION.Hyperlink}.[/bulletlist]"

msgid "TOME_GOD_EMPEROR@SKILL1@MODIFIER@DESCRIPTION"
