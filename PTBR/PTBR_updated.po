msgid "DLC@THRONESOFBLOOD@TOME_BLOOD_RITE@ABILITY01@CHAMPION_DESCRIPTION"
msgstr "Praga Escarlate:[bulletlist][bullet/]Dano base aumenta para {BLOOD_CONVULSION_UNIT_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Inflige {amount} {GLOBAL.PROPERTIES.BLOOD_PARASITE.Hyperlink}.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_BLOOD_RITE@ABILITY01@CHAMPION_NAME"
msgstr "Campeão Praga Escarlate"

msgid "DLC@THRONESOFBLOOD@TOME_BLOOD_RITE@ABILITY01@DESCRIPTION"
