msgid "TOME_OBLIVION@SKILL3@NAME"
msgstr "Invocar Névoa Viva"

msgid "TOME_OBLIVION@SKILL4@DESCRIPTION"
msgstr "[bulletlist][bullet/]Conjura um {GLOBAL.DevouringVoidConcept.Hyperlink} em um raio de {DEVOURING_VOID_POSITION_TARGETER_CIRCLE_1>AREA>Radius} hexágonos.[bullet/]A cada turno, o raio aumenta em {increase} <<m:hex>>.[bullet/]Dura por {DEVOURING_VOID_AUTO_SPELL_1>Duration} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "TOME_OBLIVION@SKILL4@NAME"
msgstr "Vazio Devorador"

msgid "TOME_OBLIVION@SKILL5@DESCRIPTION"
msgstr "Alvo {GLOBAL.CityConcept.Hyperlink} amigável. Qualquer batalha no {GLOBAL.DomainConcept.Hyperlink} da {GLOBAL.CityConcept.Hyperlink} agora tem o encantamento de batalha Névoa da Insanidade, que faz com que os inimigos tenham uma chance base de {chance}% de ganhar {GLOBAL.PROPERTIES.INSANITY.Hyperlink} a cada {GLOBAL.TurnConcept.Hyperlink}."

msgid "TOME_OBLIVION@SKILL5@NAME"
msgstr "Névoa da Insanidade"

msgid "TOME_OBLIVION@SKILL5@PROPERTY@DESCRIPTION"
msgstr "A cada turno, os inimigos do proprietário têm uma chance base de {INSANITY_RESISTANCE>ResolvedStrength}% de serem afligidos com {GLOBAL.PROPERTIES.INSANITY.Hyperlink}."

msgid "TOME_OBLIVION@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Use magia poderosa capaz de enviar seus inimigos para o nada do esquecimento. Especialize-se em infligir {GLOBAL.PROPERTIES.INSANITY} e tornar partes do mundo e do campo de batalha inóspitas."

msgid "TOME_OBLIVION@TOME@LORE_AUTHOR"
msgstr "Meandor, Senhor das Sombras dos Elfos Sombrios"

msgid "TOME_OBLIVION@TOME@LORE_DESCRIPTION"
msgstr "\"A morte não é verdadeiramente o oposto da vida. O fim é parte da jornada. O verdadeiro oposto da vida é o esquecimento. Quando você dominar esse entendimento, quando puder aproveitar a essência do vazio e lançar seus inimigos ao não-existir, então você verdadeiramente comandará a vida, a morte e o que realmente está além.\""

msgid "TOME_OBLIVION@TOME@NAME"
msgstr "Tomo do Esquecimento"

msgid "TOME_OBLIVION@UNIT1@ABILITY1@DESCRIPTION"
msgstr "O dano não pode ser reduzido por {GLOBAL.DefenseConcept.Hyperlink} ou {GLOBAL.ResistanceConcept.Hyperlink}."

msgid "TOME_OBLIVION@UNIT1@ABILITY1@NAME"
msgstr "Golpe Mental"

msgid "TOME_OBLIVION@UNIT1@ABILITY2@NAME"
msgstr "Dano Irreversível"

msgid "TOME_OBLIVION@UNIT1@ABILITY3@DESCRIPTION"
msgstr "Conjure um perigo de {GLOBAL.DevouringVoidConcept.Hyperlink} em um raio de {DEVOURING_VOID_POSITION_TARGETER_CIRCLE_1>AREA>Radius} hexágonos que dura por {DEVOURING_VOID_PLACE_MARKER_1>Duration} <<m:{GLOBAL.TurnConcept}>>."

msgid "TOME_OBLIVION@UNIT1@ABILITY3@NAME"
msgstr "Chamar o Vazio"

msgid "TOME_OBLIVION@UNIT1@DESCRIPTION"
msgstr "Um ser do vazio cujos ataques não podem ser bloqueados e que faz os mortais enlouquecerem."

msgid "TOME_OBLIVION@UNIT1@NAME"
msgstr "Névoa Viva^n"

