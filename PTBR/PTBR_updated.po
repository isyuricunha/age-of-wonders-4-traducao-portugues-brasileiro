msgid "DLC@GIANTKINGS@GILDED_WASTES@TOOLTIP@OTHER_PLAYER_FINAL_PHASE"
msgstr "Outro jogador já desbloqueou a câmara final desta região!"

msgid "DLC@GIANTKINGS@GILDED_WASTES_ENTER_EVENT@AFFINITY_MATERIUM@FAILURE"
msgstr "Sua vidência não produziu resultados. Nenhuma riqueza, isso não pode ser!"

msgid "DLC@GIANTKINGS@GILDED_WASTES_ENTER_EVENT@AFFINITY_MATERIUM@HEADER"
msgstr "Tentar localizar todas as fontes de ouro dentro da região:"

msgid "DLC@GIANTKINGS@GILDED_WASTES_ENTER_EVENT@AFFINITY_MATERIUM@SUCCESS"
msgstr "Seus instintos de Materium revelam todas as fontes de ouro."

msgid "DLC@GIANTKINGS@GOM_FINISHER@DESCRIPTION_NON_HEIR"
msgstr "A Última Legião está despertando para assaltar todas as cidades do reino. Eles parecem agir sob as antigas ordens do <<m:{GLOBAL.GiantKingLoreConcept.Hyperlink}>> de {GLOBAL.MyrridaLoreConcept.Hyperlink}, sem saber que o império que buscam defender foi destruído há muito tempo."

msgid "DLC@GIANTKINGS@GOM_FINISHER@GRIEVANCE"
msgstr "{STR_leaderName} desatou a Última Legião neste reino!"

msgid "DLC@GIANTKINGS@GOM_FINISHER@HEADER_ACTIVE_ASSAULT"
msgstr "Defenda suas cidades contra a Última Legião!"

msgid "DLC@GIANTKINGS@GOM_FINISHER@HEADER_ACTIVE_ASSAULT_CENTURION"
msgstr "A Última Legião está assaltando o reino!"

msgid "DLC@GIANTKINGS@GOM_FINISHER@HEADER_DEFEATED_ASSAULT"
msgstr "Você repeliu a Última Legião!"

msgid "DLC@GIANTKINGS@GOM_FINISHER@HEADER_END"
msgstr "Os ataques da Última Legião terminaram."

msgid "DLC@GIANTKINGS@GOM_FINISHER@HEADER_INCOMING_ASSAULT"
msgstr "Prepare-se para o ataque da Última Legião!"

msgid "DLC@GIANTKINGS@GOM_FINISHER@HEADER_LOST_ASSAULT"
msgstr "A Última Legião saqueou seu império!"

msgid "DLC@GIANTKINGS@GOM_FINISHER@NOTE_ARMY_DEFEATED@DESCRIPTION"
msgstr "Um dos exércitos da Última Legião que assaltava suas cidades foi derrotado. Restam {GOM_ARMY_COUNT_LOCAL}!"

msgid "DLC@GIANTKINGS@GOM_FINISHER@NOTE_ARMY_DEFEATED@HEADER"
msgstr "A Última Legião: Exército Derrotado"

msgid "DLC@GIANTKINGS@GOM_FINISHER@NOTIFICATION@ARMY_DESTROYED@DESCRIPTION"
msgstr "Outro jogador derrotou todos os exércitos da Última Legião que invadiam seu reino."

msgid "DLC@GIANTKINGS@GOM_FINISHER@NOTIFICATION@ARMY_DESTROYED@HEADER"
msgstr "A Última Legião: Invasão Repelida"

msgid "DLC@GIANTKINGS@GOM_FINISHER@NOTIFICATION@CITY_LOST@DESCRIPTION"
msgstr "Os exércitos da Última Legião capturaram uma de suas cidades e começaram a arrasá-la. Recupere a cidade para detê-los!"

msgid "DLC@GIANTKINGS@GOM_FINISHER@NOTIFICATION@CITY_LOST@HEADER"
msgstr "A Última Legião: Cidade Perdida!"

msgid "DLC@GIANTKINGS@GOM_FINISHER@NOTIFICATION@CITY_RAZED@DESCRIPTION"
msgstr "A Última Legião arrasou uma de suas cidades. O exército que atacava aquela cidade recuou para as profundezas da terra de onde veio."

msgid "DLC@GIANTKINGS@GOM_FINISHER@NOTIFICATION@CITY_RAZED@HEADER"
msgstr "A Última Legião: Cidade Arrasada!"

msgid "DLC@GIANTKINGS@GOM_FINISHER@NOTIFICATION@CITY_RAZED_CENTURION@DESCRIPTION"
msgstr "Um dos exércitos da Última Legião arrasou a cidade que atacou. Dos escombros fumegantes, eles resgataram {GOM_RAZE_ESSENCE_REWARD} [bindingfragments/] [hyperlink,GLOBAL.BindingEssenceConcept]Fragmentos de Ligação[/hyperlink] para usar em sua forja. Depois, o exército da Última Legião desapareceu, pois a magia que o mantinha vivo cumpriu seu propósito."

msgid "DLC@GIANTKINGS@GOM_FINISHER@NOTIFICATION@CITY_RAZED_CENTURION@HEADER"
msgstr "A Última Legião: Ataque à Cidade Bem-Sucedido!"

msgid "DLC@GIANTKINGS@GOM_FINISHER@NOTIFICATION@CITY_RAZED_OTHER@DESCRIPTION"
msgstr "Irritado com a destruição da cidade alvo, um exército da Última Legião recuou do seu domínio."

msgid "DLC@GIANTKINGS@GOM_FINISHER@NOTIFICATION@CITY_RAZED_OTHER@HEADER"
msgstr "A Última Legião: Ataque à Cidade Abortado!"

msgid "DLC@GIANTKINGS@GOM_FINISHER@NOTIFICATION@CITY_RAZED_OTHER_CENTURION@DESCRIPTION"
msgstr "Irritado com a destruição da cidade alvo por outras forças, um exército da Última Legião abortou seu ataque e desapareceu."

msgid "DLC@GIANTKINGS@GOM_FINISHER@NOTIFICATION@CITY_SIEGED@DESCRIPTION"
msgstr "Uma de suas cidades está sendo sitiada pela Última Legião. Você deve se apressar para defendê-la!"

msgid "DLC@GIANTKINGS@GOM_FINISHER@NOTIFICATION@CITY_SIEGED@HEADER"
msgstr "A Última Legião: Cidade Sitiada!"

msgid "DLC@GIANTKINGS@GOM_FINISHER@NOTIFICATION@NO_CITY_TO_RAID@DESCRIPTION"
msgstr "Como seu império não tem mais cidades, a Última Legião não enviou exércitos para seu domínio."

msgid "DLC@GIANTKINGS@GOM_FINISHER@NOTIFICATION@NO_CITY_TO_RAID@HEADER"
msgstr "Última Legião: Ataque abortado"

msgid "DLC@GIANTKINGS@GOM_FINISHER@OBJECTIVE_ACTIVE_ASSAULT_CENTURION"
msgstr "Exércitos Restantes da Última Legião: {GOM_ARMY_COUNT_GLOBAL}"

msgid "DLC@GIANTKINGS@GOM_FINISHER@OBJECTIVE_ACTIVE_ASSAULT_CENTURION_02"
msgstr "Ganhe {GOM_RAZE_ESSENCE_REWARD} [bindingfragments/] [hyperlink,GLOBAL.BindingEssenceConcept]Fragmentos de Ligação[/hyperlink] quando a Última Legião arrasar uma cidade."

msgid "DLC@GIANTKINGS@GOM_FINISHER@OBJECTIVE_DEFEAT_ARMY"
msgstr "Exércitos de Invasão Restantes: {GOM_ARMY_COUNT_LOCAL}"

msgid "DLC@GIANTKINGS@GOM_FINISHER@TOOLTIP@CENTURION"
msgstr "Pelo resto do jogo, você se torna conhecido como o Centurião da Última Legião, desbloqueando o recrutamento de todas as unidades Soldado de Argila e Arma Animada em todas as suas cidades. Eles ganham {IntRanks} ranks extras ao serem recrutados. Além disso, as Armas Animadas que você controla ganham {GLOBAL.PROPERTIES.LEGION_PROPERTY.Hyperlink}."

msgid "DLC@GIANTKINGS@GOM_FINISHER@TOOLTIP@INVASION_FORECAST"
msgstr "Em {IntDuration} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, um exército de soldados de argila e armas animadas aparecerá para cada cidade dos outros jogadores e os atacará. Esses jogadores ganharão um grande {GLOBAL.CasusBelliConcept.Hyperlink} contra você quando isso acontecer."

