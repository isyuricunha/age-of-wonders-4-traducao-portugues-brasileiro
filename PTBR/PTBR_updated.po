msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@HOUSE_DECLARE_WAR_FROM_VASSALAGE"
msgstr "Seu vassalo foi tomado de você"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@INTEGRATION"
msgstr "Pacto de Integração"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@INTEGRATION_BUTTON"
msgstr "Integrar Cidade"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@INTEGRATION_DESCRIPTION"
msgstr "[bulletlist][bullet/]A posse da Cidade é transferida para o {GLOBAL.EmpireConcept.Hyperlink} que forja este pacto.[bullet/]Deixa de existir como entidade diplomática.[bullet/]O {GLOBAL.FreeCityLordConcept.Hyperlink} pode ser recrutado como um {GLOBAL.HeroConcept.Hyperlink} do {GLOBAL.EmpireConcept.Hyperlink} que forja este pacto.[bullet/]Qualquer <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> será liberado.[/bulletlist]"

