msgstr "O Reino da Eternidade"

msgid "META_EMPIRE@REALM_REALM_OF_IMORTALS@NAME_4"
msgstr "Os Campos do Renascimento"

msgid "META_EMPIRE@REALM_REALM_OF_IMORTALS@SUBTITLE"
