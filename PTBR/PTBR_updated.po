msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@BELBEDOR01@NAME"
msgstr "Berserk Abomination"

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@BHAJIF01@DESCRIPTION"
msgstr "Every {BHAJIF_ARCANUM_MAGIC_DISRUPTION_UNIT_AUTO_SPELL>RoundsToWait} <<m:{GLOBAL.TurnConcept}>>:[bulletlist][bullet/]Attackers have a base {DISRUPTION_RESISTANCE>ResolvedStrength}% chance of becoming:[bulletlist][bullet/]{GLOBAL.PROPERTIES.DISRUPTION_TOOLTIP_PROPERTY.Hyperlink} for {DISRUPTION_DISABLE>Duration} <<m:{GLOBAL.TurnConcept}>>.[bullet/]{GLOBAL.PROPERTIES.MANA_DRAINED.Hyperlink} for {MANA_DRAINED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][bullet/]Combat Spells cannot be cast for {amount} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@BHAJIF01@NAME"
msgstr "Magic Disruption"

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@BHAJIF02@DESCRIPTION"
msgstr "Attackers gain:[bulletlist][bullet/]+{BHAJIF_ARCANUM_ANTI-MAGIC_SHIELDING_RESISTANCE>DEF_MOD>Resistanc} {GLOBAL.ResistanceConcept.Hyperlink}[bullet/]+{BHAJIF_ARCANUM_ANTI-MAGIC_SHIELDING_STATUS_RESISTANCE>Resistance} {GLOBAL.StatusResistanceConcept.Hyperlink}[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@BHAJIF02@NAME"
msgstr "Anti-Magic Shielding"

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@BHAJIF03@DESCRIPTION"
msgstr "The attacker's <<m:{GLOBAL.PROPERTIES.BATTLE_MAGE.Hyperlink}>>, <<m:{GLOBAL.PROPERTIES.MAGIC_FIGHTER.Hyperlink}>>, and <<m:{GLOBAL.PROPERTIES.SUPPORT_UNIT.Hyperlink}>> attacks gain a {DISRUPTION_RESISTANCE>ResolvedStrength}% chance of inflicting:[bulletlist][bullet/]{GLOBAL.PROPERTIES.DISRUPTION_TOOLTIP_PROPERTY.Hyperlink} for {DISRUPTION_DISABLE>Duration} <<m:{GLOBAL.TurnConcept}>>.[bullet/]{GLOBAL.PROPERTIES.MANA_DRAINED.Hyperlink} for {MANA_DRAINED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][br/]Increased for Single Shots."

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@BHAJIF03@NAME"
msgstr "Mana Disrupting Magic"

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@BINGER02@DESCRIPTION"
msgstr "Defending <<m:{GLOBAL.UnitConcept.Hyperlink}>> will also be targeted by the Autumn and Winter effects of {GLOBAL.PROPERTIES.CYCLE_OF_SEASONS.Hyperlink}."

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@BINGER02@NAME"
msgstr "Cold Embrace"

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@BINGER03@DESCRIPTION"
msgstr "Attacking <<m:{GLOBAL.UnitConcept.Hyperlink}>> will also be targeted by the Spring and Summer effects of {GLOBAL.PROPERTIES.CYCLE_OF_SEASONS.Hyperlink}."

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@BINGER03@NAME"
msgstr "Warm Embrace"

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@CINREN01@DESCRIPTION"
msgstr "Every turn, a random attacker non-hero unit has a base {BERSERK_RESISTANCE>ResolvedStrength}% chance of becoming {GLOBAL.PROPERTIES.BERSERK.Hyperlink} for {BERSERK_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@CINREN01@NAME"
msgstr "Cinren's Amusement"

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@CINREN02@DESCRIPTION"
msgstr "Attackers start with +{CINREN_ARCANUM_HEDONISTIC_SPIRIT_MORALE>Morale Change Absolute} {GLOBAL.UnitMoraleConcept.Hyperlink}."

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@CINREN02@NAME"
msgstr "Hedonistic Spirit"

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@ELDRITCH_GAZE@DESCRIPTION"
msgstr "Every {turns} <<m:{GLOBAL.TurnConcept.Hyperlink}>>:[bulletlist][bullet/]All non-{GLOBAL.PROPERTIES.ETHEREAL.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> have a {percentage} chance of suffering {GLOBAL.PROPERTIES.INSANITY.Hyperlink} for {turn} {GLOBAL.TurnConcept.Hyperlink}.[bullet/]If it fails, the Unit suffers {morale} {GLOBAL.UnitMoraleConcept.Hyperlink} instead.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@ELDRITCH_GAZE@NAME"
msgstr "Eldritch Gaze"

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@ELDRITCH_LURE@DESCRIPTION"
msgstr "Non-{GLOBAL.PROPERTIES.ETHEREAL.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> in this {GLOBAL.ProvinceConcept.Hyperlink}:[bulletlist][bullet/]Suffer {GLOBAL.PROPERTIES.DISTRACTED.Hyperlink}[bullet/]Cannot regenerate and lose {hp} <<m:{GLOBAL.HitPointConcept.Hyperlink}>> per {GLOBAL.TurnConcept.Hyperlink} in the {GLOBAL.WorldMapConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@ELDRITCH_WAKE@DESCRIPTION"
msgstr "{GLOBAL.PROPERTIES.ETHEREAL.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> have their {GLOBAL.MagicConcept.Hyperlink} Attacks and {GLOBAL.SupportConcept.Hyperlink} Abilities jump to another target within {range} hexes, but their Damage and Healing is reduced by {percentage}."

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@ELDRITCH_WAKE@NAME"
msgstr "Eldritch Wake"

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@ELEMENTAL_DEFENSES@DESCRIPTION"
msgstr "Every {GLOBAL.TurnConcept.Hyperlink}, a random {GLOBAL.UnitConcept.Hyperlink} is targeted by one of the following effects chosen at random:[bulletlist][bullet/]{GLOBAL.SPECIAL_OPERATIONS.ICE_COFFIN.Hyperlink}[bullet/]{GLOBAL.SPECIAL_OPERATIONS.FIREBALL.Hyperlink}[bullet/]{GLOBAL.SPECIAL_OPERATIONS.FULMINATION.Hyperlink}[bullet/]{GLOBAL.SPECIAL_OPERATIONS.ROCK_BLAST.Hyperlink}[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@ELEMENTAL_DEFENSES@NAME"
msgstr "Elemental Defenses"

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@FRIKKA01@DESCRIPTION"
msgstr "At the start of the battle, each Defending {GLOBAL.UnitConcept.Hyperlink} transforms into a non-{GLOBAL.PROPERTIES.HERO.Hyperlink} attacking unit that hasn't been copied yet.[br/]In addition, after {turns} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, each attacking Hero Unit spawns a hostile clone of itself within {hexes} hexes."

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@FRIKKA01@NAME"
msgstr "Mirrored Army"

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@FRIKKA02@DESCRIPTION"
msgstr "After {turn} {GLOBAL.TurnConcept.Hyperlink}, one of the defending <<m:{GLOBAL.UnitConcept.Hyperlink}>> permanently transforms into a {GLOBAL.UNITS.PIGLET.Hyperlink}."

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@FRIKKA02@NAME"
msgstr "Piglet Imitation"

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@GABRIEL01@DESCRIPTION"
msgstr "Each {GLOBAL.TurnConcept.Hyperlink}, all corpses on the battlefield resurrect as <<m:{GLOBAL.UNITS.BLESSED_SOUL.Hyperlink}>> on the Defending side. These resurrected <<m:{GLOBAL.UnitConcept.Hyperlink}>> rout after {turn} {GLOBAL.TurnConcept.Hyperlink}."

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@GABRIEL01@NAME"
msgstr "Merciful Return"

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@GABRIEL01@PROPERTY_DESCRIPTION"
msgstr "This unit was resurrected and transformed into a {GLOBA.UNITS.BLESSED_SOUL.Hyperlink}. It will rout when this effect expires."

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@GABRIEL01@PROPERTY_NAME"
msgstr "Mercifully Returned"

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@KARISSA01@DESCRIPTION"
msgstr "When a non-hero attacker dies, it turns into an {GLOBAL.UNITS.IMMOLATED_SOUL.Hyperlink} on the defender's side."

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@KARISSA01@NAME"
msgstr "Karissa's Curse"

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@KARISSA02@DESCRIPTION"
msgstr "Attackers have +{FIRE_WARD_RESISTANCE>REDUCTION>Fire} {GLOBAL.FireResistanceConcept.Hyperlink}."

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@KARISSA02@NAME"
msgstr "Fire Ward"

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@KARISSA03@DESCRIPTION"
msgstr "Attackers have:[bulletlist][bullet/]+{CHAOS_STRENGTH_DAMAGE_MULT>ResolvedMultiplier}% damage.[bullet/]+{CHAOS_STRENGTH_CRIT>ResolvedCritChanceBonus}% {GLOBAL.CriticalHitConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@KARISSA03@NAME"
msgstr "Chaos Strength"

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@NIMUE01@DESCRIPTION"
msgstr "[bulletlist][bullet/]The defending {GLOBAL.UNITS.COLOSSAL_PENGUIN.Hyperlink} has +{hpbonus} <<m:{GLOBAL.HitPointConcept.Hyperlink}>> per defending {GLOBAL.UNITS.PENGUIN.Hyperlink} at the start of combat.[bullet/]Whenever a defending {GLOBAL.UNITS.PENGUIN.Hyperlink} dies, the defending Colossal Penguin loses {hploss} [hp/] Hit Points.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@NIMUE01@NAME"
msgstr "Dire Queen"

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@NIMUE01@PROPERTY_NAME"
msgstr "Dire Subject"

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@NOCTUS01@DESCRIPTION"
msgstr "When an {GLOBAL.PROPERTIES.UNDEAD.Hyperlink} unit is resurrected they gain:[bulletlist][bullet/]+{NOCTUS_ARCANUM_DMG>ResolvedMultiplier}% damage.[bullet/]+{NOCTUS_ARCANUM_HP_BONUS>BONUS>HitPoints} maximum <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@NOCTUS01@NAME"
msgstr "Graven Strength"

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@NOCTUS01@PROP_DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]+{NOCTUS_ARCANUM_DMG>ResolvedMultiplier}% damage.[bullet/]+{NOCTUS_ARCANUM_HP_BONUS>BONUS>HitPoints} maximum <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@NOCTUS02@DESCRIPTION"
msgstr "Attackers deal +{TOWER_SLAYER_DAMAGE>ResolvedMultiplier}% damage against {GLOBAL.PROPERTIES.TOWER.Hyperlink} units."

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@NOCTUS02@NAME"
msgstr "Tower Slayer"

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@NOCTUS02@PROP_DESCRIPTION"
msgstr "+{TOWER_SLAYER_DAMAGE>ResolvedMultiplier}% damage against {GLOBAL.PROPERTIES.TOWER.Hyperlink} units."

msgid "DLC@SECRETSOFTHEARCHMAGES@COMBATPROPERTIES_TACTICAL@NOCTUS03@DESCRIPTION"
