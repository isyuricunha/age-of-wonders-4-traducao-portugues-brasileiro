msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@STUNNING_SOUNDS@DESCRIPTION"
msgstr "A cada {turns}, um {GLOBAL.UNITS.SHRIEKING_BAT.Hyperlink} tem uma chance de {chance} de sofrer {GLOBAL.PROPERTIES.STUNNED.Hyperlink} por {turns2}. Se falhar, sofre {GLOBAL.PROPERTIES.DISTRACTED.Hyperlink} por {turns2} em vez disso."

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@STUNNING_SOUNDS@NAME"
msgstr "Sons Atordoantes"

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@TAUNTED_QUEEN@DESCRIPTION"
