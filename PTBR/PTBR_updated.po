msgid "CRISIS@991_7562@SUB_HEADER"
msgstr "O {GLOBAL.ColtLoreConcept.Hyperlink} está escavando as ruínas de uma cidade Myrridana..."

msgid "CRISIS@991_7674@DESCRIPTION"
msgstr "Um {TSR_HORNED_GOD} vigia as ruínas cobertas de vegetação desta região. <<Cp:{TSR_HORNED_GOD}>> guarda rancor contra toda a linhagem Dracônica e busca erradicar as criaturas Draconianas que perturbam a paz do jardim de <<o:{TSR_HORNED_GOD}>>."

