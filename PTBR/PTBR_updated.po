msgstr "Pacto de Lealdade"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@LOYALTY_DESCRIPTION"
msgstr "[bulletlist][bullet/]A {GLOBAL.IndependentCityConcept.Hyperlink} compartilha sua visão.[bullet/]A {GLOBAL.IndependentCityConcept.Hyperlink} permite construir em províncias reivindicadas.[bullet/]Contribui com {commandPoints}[recruitmentPoints/] para o {GLOBAL.RequestMilitaryAidConcept.Hyperlink}.[bullet/]Irá [hyperlink,GLOBAL.ReinforcementRuleConcept]reforçar[/hyperlink] em {GLOBAL.CombatConcept.Hyperlink} contra <<m:{GLOBAL.MarauderConcept.Hyperlink}>> e <<m:{GLOBAL.LeaderConcept.Hyperlink}>> com os quais a {GLOBAL.IndependentCityConcept.Hyperlink} está em {GLOBAL.IndependentCityWarConcept.Hyperlink}.[/bulletlist]"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@LOYALTY_HYPERLINK"
