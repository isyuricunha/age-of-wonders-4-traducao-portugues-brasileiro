msgid "WILDLIFE_UNITPROPERTIES@INCINERATE@MASTER_DESCRIPTION"
msgstr "Incinerar:[bulletlist][bullet/]Causa um adicional de {INCINERATE_MASTER_DAMAGE>DAMAGE>Fire}{GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Garantidamente inflige {GLOBAL.PROPERTIES.BURNING.Hyperlink}.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@INCINERATE@MASTER_NAME"
msgstr "Incinerar de Campeão"

msgid "WILDLIFE_UNITPROPERTIES@INCINERATE@NAME"
msgstr "Incinerar"

msgid "WILDLIFE_UNITPROPERTIES@JUMP@DESCRIPTION"
msgstr "Salta para o local alvo."

msgid "WILDLIFE_UNITPROPERTIES@JUMP@NAME"
