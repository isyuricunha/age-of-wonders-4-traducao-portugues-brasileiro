msgstr "Principalmente terra com um pequeno oceano criando uma longa costa."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@LANDMASS_TYPE_ISLANDS"
msgstr "Um grande número de ilhas espalhadas pelo mapa."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@LANDMASS_TYPE_LAND"
msgstr "Um mapa totalmente terrestre."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@LAVA"
