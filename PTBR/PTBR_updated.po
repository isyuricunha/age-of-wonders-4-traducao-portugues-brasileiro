msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@DRAGON_REMAINS@DESCRIPTION"
msgstr "<<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacentes a este Marco ganham:[bulletlist][bullet/]{income}[bullet/]O {combatproperty} {GLOBAL.CombatEnchantmentConcept.Hyperlink}[/bulletlist][br/]Uma {GLOBAL.CityConcept.Hyperlink} com {amount} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacentes a este Marco ganham:[bulletlist][bullet/]Desbloqueia o recrutamento de {GLOBAL.PROPERTIES.DRAGON.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> de nível 4 e 5.[/bulletlist]"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@DRAGON_REMAINS@LORE"
msgstr "\"Olhando para os restos do que já foi um tesouro majestoso, não se pode evitar contemplar o [hyperlink,GLOBAL.DragonsLoreConcept]Dragão[/hyperlink] que caiu aqui e sua rivalidade destrutiva com os {GLOBAL.GiantsLoreConcept.Hyperlink}. Veja como até os ossos parecem ainda proteger seus tesouros. Enquanto o vento uivava através dos picos, juro que ainda podia ouvir o rugido antigo do dragão...\"[br/][br/]— Fangir Rockborne, Jornais da Segunda Era: Parte II"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@DRAGON_REMAINS@NAME"
msgstr "Tesouro do Dragão Ancestral"

