msgid "DLC@ELDRITCHREALMS@ELDRITCH_RULER_TYPE@DESCRIPTION"
msgstr "{LOC.DLC@ELDRITCHREALMS@ELDRITCH_RULER_TYPE@DESCRIPTION_SHORT}[br/][bulletlist][bullet/]Soberanos Arcanos têm acesso a poderosas Habilidades Marcantes de controle.[bullet/]Soberanos Arcanos ganham poderosas {GLOBAL.HeroDedication.Hyperlink} únicas.[bullet/]Use <<m:{GLOBAL.ThrallConcept.Hyperlink}>> para lançar poderosos <<m:{GLOBAL.SpellConcept.Hyperlink}>> rituais.[bullet/]Comece com {GLOBAL.SPECIAL_OPERATIONS.CLAIRVOYANCE_RITUAL.Hyperlink} e {GLOBAL.SPECIAL_OPERATIONS.ENTRHALL_POPULATION.Hyperlink}.[bullet/]Soberanos Arcanos são <<m:{GLOBAL.PROPERTIES.HEROTRAIT_GOVERNANCE_ELDRITCH_GOVERNOR.Hyperlink}>>.[bullet/]Soberanos Arcanos têm uma {amount} {GLOBAL.ManaConcept.Hyperlink} {GLOBAL.UnitUpkeepConcept.Hyperlink} e não podem equipar itens de Pernas e Montaria.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@ELDRITCH_RULER_TYPE@DESCRIPTION_SHORT"
msgstr "[helpcolor]Um feiticeiro arcano que comanda poderes além da compreensão mortal.[/helpcolor]"

