msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_WARCOORDINATION_FAILED_DEFAULT"
msgstr "{HouseBLord.FirstName} falhou em completar seu {GLOBAL.CallToArmsConcept.Hyperlink} que havia aceitado."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_WARCOORDINATION_SUCCESS_DEFAULT"
msgstr "{HouseBLord.FirstName} completou seu {GLOBAL.CallToArmsConcept.Hyperlink} e recebeu as recompensas."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_WARCOORDINATION_UPDATE_PENDING_DEFAULT"
msgstr "{HouseBLord.FirstName} ainda está considerando se pode completar o {GLOBAL.CallToArmsConcept.Hyperlink} e não tomou nenhuma ação ainda."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_WARCOORDINATION_UPDATE_RUNNING_NEARTARGET_DEFAULT"
msgstr "{HouseBLord.FirstName} está próximo do alvo do {GLOBAL.CallToArmsConcept.Hyperlink} e pode ser capaz de completá-lo em breve. {LOC.DIPLOMACY@PLAYERINTERACTION@FOOTER_WARCOORDINATION_UPDATE_RUNNING_TIMEESTIMATE}"

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_WARCOORDINATION_UPDATE_RUNNING_NEGATIVE_DEFAULT"
msgstr "{HouseBLord.FirstName} levará mais tempo para alcançar o alvo do {GLOBAL.CallToArmsConcept.Hyperlink}. {LOC.DIPLOMACY@PLAYERINTERACTION@FOOTER_WARCOORDINATION_UPDATE_RUNNING_TIMEESTIMATE}"

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_WARCOORDINATION_UPDATE_RUNNING_NEUTRAL_DEFAULT"
msgstr "{HouseBLord.FirstName} ainda está movendo seus exércitos para alcançar o alvo do {GLOBAL.CallToArmsConcept.Hyperlink}, mas não fez nenhum progresso. {LOC.DIPLOMACY@PLAYERINTERACTION@FOOTER_WARCOORDINATION_UPDATE_RUNNING_TIMEESTIMATE}"

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_WARCOORDINATION_UPDATE_RUNNING_PAUSED_DEFAULT"
msgstr "{HouseBLord.FirstName} não está mais focando no {GLOBAL.CallToArmsConcept.Hyperlink}; eles podem tentar novamente mais tarde."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_WARCOORDINATION_UPDATE_RUNNING_POSITIVE_DEFAULT"
msgstr "{HouseBLord.FirstName} está fazendo progresso para alcançar o alvo do {GLOBAL.CallToArmsConcept.Hyperlink}. {LOC.DIPLOMACY@PLAYERINTERACTION@FOOTER_WARCOORDINATION_UPDATE_RUNNING_TIMEESTIMATE}"

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_WARCOORDINATION_UPDATE_RUNNING_TIMEESTIMATE"
msgstr "Eles estimam {TurnsUntilTarget} <<m:{GLOBAL.TurnConcept.Hyperlink}>> para completar a recompensa."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_WARCOORDINATION_UPDATE_START_DEFAULT"
msgstr "{HouseBLord.FirstName} avaliou o {GLOBAL.CallToArmsConcept.Hyperlink} e fará uma tentativa de completá-lo."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_WAR_DEFAULT"
msgstr "[fireCol]Agora você está em {GLOBAL.WarConcept.Hyperlink} com {HouseBLord.Name}.[/fireCol][br/][hyperlink,GLOBAL.TradeConcept]Negocie[/hyperlink] uma {GLOBAL.TruceConcept.Hyperlink} com eles para encerrar a guerra."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_WAR_QUEUED_DEFAULT"
msgstr "[fireCol]Você estará em {GLOBAL.WarConcept.Hyperlink} com {HouseBLord.Name} em {QueuedDuration} <<m:{GLOBAL.TurnConcept.Hyperlink}>>.[/fireCol][br/][hyperlink,GLOBAL.TradeConcept]Negocie[/hyperlink] uma {GLOBAL.TruceConcept.Hyperlink} com eles para encerrar a guerra."

msgid "DIPLOMACY@PLAYERINTERACTION@HEADER_DEFEATED"
msgstr "..."

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_CALLTOWAR_RECEIVED_ALLIANCE_AGGRESSIVE"
msgstr "\"Junte-se a nós em nossa guerra, {Player.Lord.FirstName}! Juntos, esmagaremos os patéticos {Target.Race}!\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_CALLTOWAR_RECEIVED_ALLIANCE_DEFENSIVE"
msgstr "\"Junte-se a nós em nossa guerra, {Player.Lord.FirstName}! Faremos {Target.Lord.FirstName} se arrepender do dia em que <<p:Target.Lord>> atacou nossa poderosa aliança!\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_CALLTOWAR_RECEIVED_DEFENSIVEPACT"
msgstr "\"Estamos sob ataque, {Player.Lord.FirstName}! Esperamos que honre seu juramento e venha em nosso auxílio.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_DECLARATION_CALL_TO_FRIENDSHIP_DEFAULT"
msgstr "\"{Target.Lord.Name} provou ser um amigo digno para mim. Uma amizade compartilhada entre você e {Target.Lord.FirstName} só pode nos tornar mais fortes!\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_DECLARATION_CALL_TO_RIVALRY_DEFAULT"
msgstr "\"Minha rivalidade com {Target.Lord.FirstName} não é segredo. Junte-se a mim e prevaleceremos sobre <<P:Target.Lord>> juntos!\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_DECLARATION_FRIENDSHIP_DEFAULT"
msgstr "\"Eu o considero meu amigo, {HouseALord.TitleName}. Juntos, prosperaremos!\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_DECLARATION_FRIENDSHIP_DEFAULT_ISOLATIONIST"
msgstr "\"Eu... na verdade o considero um amigo, {HouseALord.FirstName}. Talvez {HouseBRace} e {HouseARace} possam viver juntos em harmonia.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_DECLARATION_RIVALRY_DEFAULT"
msgstr "\"Considere isto como um anúncio oficial de que eu, {HouseBLord.TitleName}, o considero um inimigo.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_DECLARATION_RIVALRY_DEFAULT_ISOLATIONIST"
msgstr "\"Este reino estaria melhor sem gente como você, {HouseALord.FirstName}. Estou avisando. Fique longe de mim e do meu povo.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_DECLARATION_RIVALRY_DEFAULT_SPY"
msgstr "\"Todos nós estaríamos melhor sem Governantes como você. Fique longe de mim e não interfira nos meus planos.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_DECLAREWAR_DEFAULT"
msgstr "\"Você tem sido um espinho no meu lado por tempo demais, {HouseALord.TitleName}. Prepare-se para a guerra!\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_DECLAREWAR_DEFAULT_DIPLOMAT"
msgstr "\"Todos têm seus limites, até mesmo aqueles que buscam a paz. E você acabou de cruzar a linha, {HouseALord.TitleName}. Prepare-se para a batalha.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_DECLAREWAR_DEFAULT_ISOLATIONIST"
msgstr "\"Parabéns, {HouseALord.TitleName}. Você conseguiu me irritar tanto que terei que agir e destruí-lo pessoalmente.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_DECLAREWAR_DEFAULT_WARLORD"
msgstr "\"Você verá o verdadeiro poder de {HouseBLord.TitleName} e dos {HouseBRace.Name}.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_DECLAREWAR_MAGICVICTORY_DEFAULT_1"
msgstr "\"Você não acha que ficarei parado enquanto canaliza os poderes das Maravilhas Ancestrais, {HouseALord.TitleName}. Prepare-se para a guerra!\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_DECLAREWAR_MAGICVICTORY_DEFAULT_2"
msgstr "\"Você não é digno de canalizar os poderes das Maravilhas Ancestrais, {HouseALord.TitleName}. Deve ser detido!\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_DENOUNCE_DEFAULT"
msgstr "\"Você me desafiou, {HouseALord.TitleName}! Aconselho-o a parar com essa traição, ou haverá consequências.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_DENOUNCE_OTHER_DEFAULT"
msgstr "\"Que todos saibam que {TargetLord.Name} me desafiou. <<Cp:TargetLord>> não é confiável!\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_DIPLOMATICSTATECHANGE_DECREASED_DEFAULT"
msgstr "\"É com tristeza que anuncio o fim de nossa coalizão. Parece que um vínculo entre nós não foi tão benéfico quanto eu pensava.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_DIPLOMATICSTATECHANGE_DECREASED_DEFAULT_WARLORD"
msgstr "\"Não vejo mais valor em colaborar com você. Continuarei minha conquista sozinho.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_DIPLOMATICSTATECHANGE_INCREASED_DEFAULT"
msgstr "\"É com alegria que anuncio que nossos laços se fortaleceram, {HouseALord.TitleName}. Vamos trabalhar por uma era mais brilhante para ambos.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_DIPLOMATICSTATECHANGE_INCREASED_DEFAULT_DIPLOMAT"
msgstr "\"Fico feliz que você também veja valor em tratados e diplomacia. Juntos, forjaremos uma era mais brilhante para nossos povos.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_DEFAULT"
msgstr "\"Saudações, {HouseALord.TitleName}, o que deseja discutir?\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_DEFAULT_DIPLOMAT"
msgstr "\"Salve, {HouseALord.TitleName}. Que assuntos de diplomacia discutiremos hoje?\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_DEFAULT_ISOLATIONIST"
msgstr "\"{HouseALord.TitleName}. Estou muito ocupado, o que precisa?\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_DEFAULT_MERCHANT"
msgstr "\"Saudações, {HouseALord.TitleName}! Que assuntos discutiremos?\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_DEFAULT_SAGE"
msgstr "\"O destino nos reúne mais uma vez. Que questões o afligem, {HouseALord.Name}?\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_DEFAULT_SPY"
msgstr "\"Saudações, {HouseALord.TitleName}. Como vão seus grandiosos planos?\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_DEFAULT_WARLORD"
msgstr "\"Força, {HouseALord.TitleName}. O que o traz à minha sala de guerra?\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ENDWAR"
msgstr "\"Bem-vindo, {HouseALord.TitleName}. Esta guerra tem sido muito custosa para ambos. Espero que esteja aqui para discutirmos seu fim.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_DEFAULT"
msgstr "\"Permita-me apresentar-me. Sou {HouseBLord.TitleName} dos {HouseBRace.Name}. Esperemos que este reino seja grande o suficiente para todos nós.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_DEFAULT_DIPLOMAT"
msgstr "\"Salve, {HouseALord.TitleName}. Permita-me apresentar-me. Sou {HouseBLord.TitleName}. Muitos Godir fazem guerra, eu busco fazer a paz.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_DEFAULT_DRAGON_TO_GIANT"
msgstr "\"Mais um Rei Gigante surge para destruir nossas maravilhas. Veio buscar redenção ou debater-se-á em futilidade como os tolos de Myrrida fizeram outrora?\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_DEFAULT_GIANT_TO_DRAGON"
msgstr "\"Um Dragão cruza meu caminho. Contenha sua língua bifurcada em minha presença, ou sofrerá meu poder primordial.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_DEFAULT_ISOLATIONIST"
msgstr "\"Outro Governante neste reino. Quantos mais este lugar suporta? Vamos apenas concordar em ficar fora do caminho um do outro, hã?\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_DEFAULT_SAGE"
msgstr "\"Saudações, {HouseALord.TitleName}. Que a sabedoria guie seu caminho neste reino.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_DEFAULT_SPY"
msgstr "\"Um novo contendor pelo poder neste reino aparece diante de mim. Diga-me, {HouseALord.TitleName}, é um mestre ou um peão?\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_DEFAULT_VOID"
msgstr "\"Parece que nos encontramos em circunstâncias especiais, {HouseALord.TitleName}. Talvez discutamos nossas relações em outro momento.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_DEFAULT_WARLORD"
msgstr "\"Bem encontrado, {HouseALord.TitleName}. Sou {HouseBLord.TitleName}. Prove sua força para mim, e talvez conquistemos este reino juntos.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_NEGATIVE"
msgstr "\"Então você é o notório {HouseALord.Name}. Sugiro que mantenha distância de minhas terras, caso contrário, a vida aqui pode se tornar muito desagradável para você.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_NEGATIVE_DIPLOMAT"
msgstr "\"Então você é o {HouseALord.TitleName} desconsiderado. Sou {HouseBLord.TitleName}. Muitos Godir fazem guerra, eu busco fazer a paz. Até mesmo com os da sua laia.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_NEGATIVE_DRAGON_TO_GIANT"
msgstr "\"Mais um Gigante surge para destruir nossas maravilhas. Curve-se diante de seus superiores e implore por redenção, ou o reduzirei a pó.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_NEGATIVE_GIANT_TO_DRAGON"
msgstr "\"Então este reino está infestado de Dragões. Cabe a nós, Gigantes, colocar sua raça esquecida em seu devido lugar.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_NEGATIVE_ISOLATIONIST"
msgstr "\"Outro governante vem ameaçar meu império. Apenas fique fora do meu caminho, e eu ficarei fora do seu.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_NEGATIVE_SAGE"
msgstr "\"Às vezes, o destino coloca adversários em nosso caminho para testar nossa determinação. Espero, pelo bem de todos nós, que você não seja um deles.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_NEGATIVE_SPY"
msgstr "\"Um novo peão aparece diante de mim. Você parece um Godir, mas está pronto para enfrentar alguém como eu?\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_NEGATIVE_WARLORD"
msgstr "\"Então você é {HouseALord.TitleName} dos {HouseARace.Name}. Não estou impressionado. Ande com cuidado, antes que eu decida que seu reino vale a pena ser conquistado.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_POSITIVE"
msgstr "\"Ouvi grandes coisas sobre você, {HouseALord.TitleName}. Estou ansioso para ver seu progresso aqui.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_POSITIVE_DIPLOMAT"
msgstr "\"Salve, {HouseALord.TitleName}! Parece que compartilhamos parentesco. Meu nome é {HouseBLord.Name}. Muitos Godir fazem guerra aos reinos. Acho mais recompensador fazer a paz. Você não concorda?\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_POSITIVE_DRAGON_TO_GIANT"
msgstr "\"Raramente encontro um Gigante razoável. Você será o primeiro a conquistar minha confiança?\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_POSITIVE_GIANT_TO_DRAGON"
msgstr "\"Raramente encontro um Dragão razoável. Prove e redima-se perante mim antes de conquistar minha confiança.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_POSITIVE_ISOLATIONIST"
msgstr "\"Entre tantos estranhos neste reino, você parece ser o mais razoável. No entanto, não me envolvo nas mesquinhas disputas dos outros Godir. Vamos simplesmente viver e deixar viver.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_POSITIVE_MERCHANT"
msgstr "\"Ouvi grandes coisas sobre você, {HouseALord.TitleName}. Estou ansioso para ver seu progresso aqui ao lado do meu.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_POSITIVE_SAGE"
msgstr "\"É um dia abençoado quando um {HouseBLord.Title} encontra um {HouseALord.Title} como você. Seja bem-vindo, {HouseALord.Name}. Vamos governar este reino com sabedoria.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_POSITIVE_SPY"
msgstr "\"Então um novo Governante apareceu neste reino de esquemas e conquistas. Bem-vindo, {HouseALord.FirstName}. Esperemos que possamos manipular este reino juntos.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_POSITIVE_WARLORD"
msgstr "\"Raramente encontro um Governante poderoso como eu, que sabe que o verdadeiro poder reside na força. Prove sua força para mim, e talvez ainda conquistemos este reino juntos.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_SECTORCLAIM"
msgstr "\"Então você é quem acabou de tomar aquela província promissora... Espero que isso não se repita.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FORESHADOW_DEGRADE_DEFAULT"
msgstr "\"Sinto que nossos impérios estão se distanciando, {HouseALord.TitleName}. Talvez nossa aliança tenha sido um erro...\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FORESHADOW_DEGRADE_DEFAULT_ISOLATIONIST"
msgstr "\"Seus esquemas e disputas estão começando a me irritar, {HouseALord.TitleName}. Talvez eu fique melhor sem você.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FORESHADOW_DEGRADE_DEFAULT_SAGE"
msgstr "\"Suas ações me deixam em dúvida, {HouseALord.FirstName}. Talvez minha confiança em você tenha sido mal colocada.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FORESHADOW_DEGRADE_DEFAULT_SPY"
msgstr "\"Suas ações estão interferindo em meus planos, {HouseALord.TitleName}. Ande com cuidado, antes que eu decida acabar com seu governo.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FORESHADOW_DEGRADE_DEFAULT_WARLORD"
msgstr "\"Suas estratégias estão começando a me irritar, {HouseALord.TitleName}. Ande com cuidado, para não se ver no lado receptor da minha ira.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FORESHADOW_ENDWAR_DEFAULT"
msgstr "\"Esta nossa guerra é cansativa, {HouseALord.FirstName}. Às vezes me pergunto se não seria melhor acabarmos com ela.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FORESHADOW_IMPROVE_DEFAULT"
msgstr "\"Estava pensando em você, {HouseALord.Name}. Temos muito em comum. Talvez possamos aproximar nossos impérios.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FORESHADOW_IMPROVE_DEFAULT_DIPLOMAT"
msgstr "\"Tenho ponderado sobre os muitos aliados e inimigos que tenho neste reino. Fico feliz que você pareça ser um dos primeiros. Vamos tentar aproximar nossos impérios.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FORESHADOW_IMPROVE_DEFAULT_ISOLATIONIST"
msgstr "\"Devo dizer que você pode realmente valer minha atenção, {HouseALord.FirstName}. Talvez nossos impérios possam realmente coexistir.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FORESHADOW_IMPROVE_DEFAULT_MERCHANT"
msgstr "\"Estava pensando em você, {HouseALord.FirstName}. Como vão nossos tratados e acordos comerciais? Talvez possamos melhorá-los.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FORESHADOW_IMPROVE_DEFAULT_SAGE"
msgstr "\"Suas ações demonstram sua sabedoria, {HouseALord.FirstName}. Fico feliz em ver nossos destinos se entrelaçando.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FORESHADOW_IMPROVE_DEFAULT_SPY"
msgstr "\"Normalmente considero os outros como peões, para serem usados como eu achar melhor. Mas você, {HouseALord.TitleName}, pode muito bem ser mais do que isso.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FORESHADOW_WAR_DEFAULT"
msgstr "\"Você está me irritando, {HouseALord.Name}. Estou avisando, se continuar assim, porei um fim ao seu reinado aqui mesmo.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_MAINTAINWAR"
msgstr "\"Não percamos tempo com palavras, {HouseALord.FirstName}. Somente no campo de batalha nossas diferenças serão resolvidas.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_NEGATIVE"
msgstr "\"O que você quer? Seja rápido, tenho um império para liderar.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_NEGATIVE_DIPLOMAT"
msgstr "\"O rude {HouseALord.Title} fala comigo mais uma vez. Como sempre, farei o possível para ser cortês.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_NEGATIVE_ISOLATIONIST"
msgstr "\"O que você quer? Tenho coisas mais importantes para fazer do que ouvir você.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_NEGATIVE_MERCHANT"
msgstr "\"{HouseALord.TitleName}. Estou extremamente ocupado lidando com assuntos mais importantes do que você. O que deseja?\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_NEGATIVE_SAGE"
msgstr "\"Algumas conversas só acontecem para testar nossa paciência. Esta parece ser uma delas.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_NEGATIVE_SPY"
msgstr "\"{HouseALord.TitleName}. Eu perguntaria como você está, mas, honestamente, não me importo com seu bem-estar.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_NEGATIVE_WARLORD"
msgstr "\"Aviso para não me perturbar demais, ou nosso próximo encontro acontecerá no campo de batalha.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_PERSONALITY_DISLIKE"
msgstr "\"Alguns considerariam sua linha de ação profundamente insensata, {HouseALord.FirstName}. Especialmente se quiser evitar me irritar!\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_PERSONALITY_LIKE"
msgstr "\"Talvez não sejamos tão diferentes afinal, {HouseALord.FirstName}. Suas ações são promissoras. Continue, por favor!\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_POSITIVE"
msgstr "\"É sempre um prazer falar com você, {HouseALord.FirstName}. Sobre o que deseja conversar?\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_POSITIVE_DIPLOMAT"
msgstr "\"Salve, {HouseALord.TitleName}! É um prazer falar com você. Por favor, diga-me o que precisa.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_POSITIVE_ISOLATIONIST"
msgstr "\"Saudações, {HouseALord.TitleName}. De todos os Governantes brigões deste reino, você parece ser um pouco razoável. O que o traz ao meu império?\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_POSITIVE_MERCHANT"
msgstr "\"Saudações, {HouseALord.TitleName}! Você veio para negociar ou apenas para admirar meu grandioso império?\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_POSITIVE_SAGE"
msgstr "\"As marés do destino me favorecem, trazendo você aqui. O que posso fazer por você, {HouseALord.FirstName}?\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_POSITIVE_SPY"
msgstr "\"Saudações, {HouseALord.TitleName}. Que todos os seus planos se realizem!\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_POSITIVE_WARLORD"
msgstr "\"Força, {HouseALord.TitleName}! Que os campos sejam inundados com o sangue de seus inimigos.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_CALLTOWAR_ACCEPTED"
msgstr "\"Eu e meus {HouseBRace.Name} nos juntaremos a você em sua guerra contra {Target.Name}!\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_CALLTOWAR_DECLINED"
msgstr "\"Não posso me juntar a você em sua guerra, {HouseALord.TitleName}.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_CALLTOWAR_RECEIVED"
msgstr "\"As regras de honra me dão algum tempo antes de responder ao seu chamado à guerra. Deixe-me pensar.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_CALLTOWAR_REPLY_ACCEPTED"
msgstr "\"Bem-vindo à guerra, {HouseALord.FirstName}! {Target.Name} não tem chance contra nós dois!\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_CALLTOWAR_REPLY_DECLINED"
msgstr "\"Então é assim que você honra seus juramentos, {HouseALord.FirstName}? Parece que é hora de reavaliarmos nosso relacionamento.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_DECLARATION_FRIENDOFRIVAL_DEFAULT"
msgstr "\"Você ousa partir o pão com {Target.Lord.TitleName}?!\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_DECLARATION_MUTUALFRIENDSHIP_DEFAULT"
msgstr "\"Fico feliz em ver que compartilhamos um amigo em {Target.Lord.Name}. Juntos, prevaleceremos!\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_DECLARATION_MUTUALRIVALRY_DEFAULT"
msgstr "\"Fico feliz que você tenha visto as verdadeiras cores do meu rival {Target.Lord.FirstName}. <<Cp:Target.Lord>> não merece nada menos.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_DECLARATION_PLAYERFRIENDSHIP_BROKEN_DEFAULT"
msgstr "\"Estou decepcionado ao saber que você não está disposto a se comprometer com sua promessa de amizade, {HouseALord.FirstName}.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_DECLARATION_PLAYERFRIENDSHIP_DEFAULT"
msgstr "\"Fico feliz em saber que você me considera seu amigo, {HouseALord.TitleName}. Não esquecerei isso.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_DECLARATION_PLAYERFRIENDSHIP_NEGATIVE"
msgstr "\"Então busca amizade com os {HouseBRace}? Veremos, talvez você prove ser digno.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_DECLARATION_PLAYERRIVALRY_BROKEN_DEFAULT"
msgstr "\"Ouvi dizer que finalmente está disposto a encerrar sua disputa comigo. Muito promissor. Talvez ainda possamos forjar boas relações, afinal.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_DECLARATION_PLAYERRIVALRY_DEFAULT"
msgstr "\"Você me declara seu rival? Muito bem, veremos quem ri por último!\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_DECLARATION_PLAYERRIVALRY_POSITIVE"
msgstr "\"Isso é uma grande vergonha, {HouseALord.Name}, tínhamos grandes esperanças para o futuro.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_DECLARATION_RIVALOFFRIEND_DEFAULT"
msgstr "\"Considero {Target.Lord.TitleName} meu amigo. Me decepciona que você o tenha transformado em inimigo, <<P:Target.Lord>>.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_DECLAREWAR_DEFAULT"
msgstr "\"Muito bem, {HouseALord.Name}...\" <<p:HouseBLord>> diz entre dentes cerrados. \"Se é guerra que quer, guerra terá. Toquem os tambores!\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_DENOUNCE_DEFAULT"
msgstr "\"Reconheço minha transgressão, {HouseALord.TitleName}. Espero que não haja ressentimentos entre nós.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_DIPLOMATICSTATECHANGE_DECREASED_DEFAULT"
msgstr "\"Estou triste em ver nossa coalizão se desfazer. Talvez um vínculo entre nós não seja tão benéfico quanto pensei.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_DIPLOMATICSTATECHANGE_INCREASED_DEFAULT"
msgstr "\"Estou feliz em ver que os laços que forjamos são mais fortes, {HouseALord.TitleName}. Vamos trabalhar por uma era mais brilhante para ambos.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_NEGATIVEFIRSTMEET_NEGATIVE"
msgstr "\"Talvez insultos fossem esperados de um '{HouseALord.Title}' como você. Não se engane, pagará por me tratar assim.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_NEGATIVEFIRSTMEET_POSITIVE"
msgstr "\"Estou decepcionado com sua hostilidade, {HouseALord.FirstName}. Talvez minhas suposições positivas sobre você estivessem equivocadas.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_POSITIVEFIRSTMEET_NEGATIVE"
msgstr "\"Acha que uma tentativa fraca de bajulação me convencerá de sua boa vontade? Precisará de mais do que isso, \"{HouseALord.Title}\".\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_POSITIVEFIRSTMEET_POSITIVE"
msgstr "\"Aceito este gesto de boa vontade, {HouseALord.Name}. Obrigado.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_WARCOORDINATION_ACCEPTED_DEFAULT"
msgstr "\"Não posso prometer nada, {HouseALord.Name}, mas aceito sua recompensa.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_WARCOORDINATION_DECLINED_DEFAULT"
msgstr "\"Infelizmente, não posso ajudá-lo com esta recompensa, {HouseALord.TitleName}. Talvez mais tarde.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_WARCOORDINATION_FAILED_DEFAULT"
msgstr "\"Sinto muito, {HouseALord.TitleName}, não posso completar esta recompensa.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_WARCOORDINATION_SUCCESS_DEFAULT"
msgstr "\"Fiz como pediu, {HouseALord.TitleName}, a recompensa foi cumprida.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_WARCOORDINATION_UPDATE_PENDING_DEFAULT"
msgstr "\"Estou considerando minhas táticas, {HouseALord.TitleName}, ainda não tenho certeza se posso completar a recompensa.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_WARCOORDINATION_UPDATE_RUNNING_NEARTARGET_DEFAULT"
msgstr "\"Meu exército está perto do alvo, {HouseALord.TitleName}. Talvez consiga completar a recompensa.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_WARCOORDINATION_UPDATE_RUNNING_NEGATIVE_DEFAULT"
msgstr "\"Alcançar o alvo pode demorar mais do que o previsto, {HouseALord.TitleName}.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_WARCOORDINATION_UPDATE_RUNNING_NEUTRAL_DEFAULT"
msgstr "\"Ainda não há novidades sobre a recompensa! Manterei você informado, {HouseALord.TitleName}.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_WARCOORDINATION_UPDATE_RUNNING_PAUSED_DEFAULT"
msgstr "\"Infelizmente, minhas prioridades mudaram, {HouseALord.TitleName}. Talvez consiga retomar o progresso da recompensa mais tarde.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_WARCOORDINATION_UPDATE_RUNNING_POSITIVE_DEFAULT"
msgstr "\"Meu exército está se aproximando do alvo, espero alcançá-lo em breve.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_WARCOORDINATION_UPDATE_START_DEFAULT"
msgstr "\"Meu exército acaba de partir em missão rumo ao alvo, {HouseALord.TitleName}. Manterei você informado sobre o progresso.\""

msgid "DIPLOMACY@PLAYERINTERACTION@REASON_GENERIC"
msgstr "{HouseALord.Name} é uma ameaça para mim."

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_ACCEPTED"
msgstr "\"Obrigado, {HouseALord.Name}, temos um acordo.\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_DECLINED"
msgstr "\"Minhas desculpas, {HouseALord.Name}. Essa troca não vai funcionar.\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_DEFAULT"
msgstr "\"Uma troca, {HouseALord.FirstName}? Muito bem. O que você propõe?\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_DEFAULT_NEGATIVE"
msgstr "\"Eu o advirto a não desperdiçar meu tempo, {HouseALord.FirstName}. O que você oferece?\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_DEFAULT_POSITIVE"
msgstr "\"Será um prazer praticar a fina arte do comércio com você, {HouseALord.Name}.\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_FAIR_DEFAULT"
msgstr "\"Essa troca me parece justa. Concordamos?\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_NODEAL_DEFAULT"
msgstr "\"Minhas desculpas, {HouseALord.Name}. Essa troca não vai funcionar.\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_NODEAL_DEMAND_RESOURCE_DEFAULT"
msgstr "\"No momento, não quero me desfazer desse recurso em particular. Talvez eu reconsidere quando você tiver algo mais interessante para oferecer.\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_NODEAL_GIFT_RESOURCE_DEFAULT"
msgstr "\"Esse recurso não me interessa no momento.\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_OFFER_DEFAULT"
msgstr "\"Saudações, {HouseALord.TitleName}. Gostaria de propor uma troca, o que acha?\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_OFFER_ENDWAR_DEFAULT"
msgstr "\"Essa guerra já durou tempo demais; vamos pôr um fim nela.\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_OFFER_ENDWAR_LOSING"
msgstr "\"Eu sei quando estou em desvantagem, por favor, vamos acabar com essa guerra sem sentido.\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_OFFER_ENDWAR_LOSING_VASSALAGE"
msgstr "\"Você venceu esta guerra, {HouseALord.Name}. Fui derrotado, mas ainda posso ser útil. Não me lance no vazio, permita-me servi-lo!\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_OFFER_ENDWAR_WINNING_VASSALAGE"
msgstr "\"Você perdeu esta guerra, {HouseALord.Name}, mas não desejo lançá-lo no vazio. Ajoelhe-se e junte-se a mim na glória!\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_OFFER_FAIR_DEFAULT"
msgstr "\"{HouseALord.Name}, estaria interessado em uma troca? Isso me parece uma proposta justa.\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_OFFER_REQUEST_DEFAULT"
msgstr "\"{HouseALord.Name}, estaria interessado em uma troca? Em troca, posso lhe oferecer o seguinte.\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_OFFER_SELL_DEFAULT"
msgstr "\"Saudações, {HouseALord.Name}. Meu império tem algo a oferecer, está interessado?\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_PROPOSAL_DEMAND_DEFAULT"
msgstr "\"Seu pedido é razoável, mas preciso de algo em troca. Talvez uma das seguintes opções.\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_PROPOSAL_DEMAND_RESOURCE_DEFAULT"
msgstr "\"Posso estar disposto a fornecer alguns dos meus recursos, mas também preciso de algo de você, {HouseALord.FirstName}.\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_PROPOSAL_GIFT_DEFAULT"
msgstr "\"Uma proposta interessante, {HouseALord.Name}. Posso lhe oferecer o seguinte em troca.\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_PROPOSAL_GIFT_RESOURCE_DEFAULT"
msgstr "\"Interessante, suponho que poderia usar esse recurso, {HouseALord.TitleName}. Estaria disposto a me desfazer do seguinte.\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_PROPOSAL_OFFERGIFT_DEFAULT"
msgstr "\"Você me ofereceria um presente? Agradeço, {HouseALord.TitleName}. Prefiro uma das seguintes opções.\""

msgid "DIPLOMACY@PLAYEROPINION@GRUDGE"
msgstr "Agravo devido a <<m:{GLOBAL.CasusBelliConcept.Hyperlink}>>"

msgid "DIPLOMACY@PLAYEROPINION@GRUDGE_REMAIN"
msgstr "Agravo devido a <<m:{GLOBAL.CasusBelliConcept.Hyperlink}>> expirado"

msgid "DIPLOMACY@PRESSURE@DESCRIPTION"
msgstr "O nível de ameaça representa o quanto outros <<m:{GLOBAL.LeaderConcept.Hyperlink}>> se sentem ameaçados.[br/][br/]Esse nível é influenciado por vários fatores que avaliam o desempenho de cada Governante: por exemplo, se possuem grandes <<m:{GLOBAL.ArmyConcept.Hyperlink}>>, muitas <<m:{GLOBAL.CityConcept.Hyperlink}>> ou são apoiados por muitos [hyperlink,GLOBAL.DSAllianceConcept]aliados[/hyperlink].[br/][br/]O nível de ameaça é expresso como um modificador de [hyperlink,GLOBAL.EmpireRelationConcept]relações[/hyperlink]."

msgid "DIPLOMACY@PRESSURE@FACTORS"
msgstr "Descobrimos os seguintes fatores contribuintes."

msgid "DIPLOMACY@PRESSURE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.AIPressureConcept]Nível de Ameaça[/hyperlink]"

msgid "DIPLOMACY@PRESSURE@LEVEL_-1"
msgstr "Inquieto"

msgid "DIPLOMACY@PRESSURE@LEVEL_-1_DESCRIPTION"
msgstr "O {GLOBAL.LeaderConcept.Hyperlink} se sente ameaçado pelo seu {GLOBAL.EmpireConcept.Hyperlink}, o que afeta suas [hyperlink,GLOBAL.EmpireRelationConcept]relações[/hyperlink] com ele em {RelationValue}[badRelation/] e também torna o comércio com ele mais custoso."

msgid "DIPLOMACY@PRESSURE@LEVEL_-2"
msgstr "Vigilante"

msgid "DIPLOMACY@PRESSURE@LEVEL_-3"
msgstr "Desconfiado"

msgid "DIPLOMACY@PRESSURE@LEVEL_-4"
msgstr "Ameaçado"

msgid "DIPLOMACY@PRESSURE@LEVEL_0"
msgstr "Indiferente"

msgid "DIPLOMACY@PRESSURE@LEVEL_0_DESCRIPTION"
msgstr "O {GLOBAL.LeaderConcept.Hyperlink} sente indiferença pelo seu {GLOBAL.EmpireConcept.Hyperlink}, o que ainda pode mudar com o tempo."

msgid "DIPLOMACY@PRESSURE@LEVEL_1"
msgstr "À vontade"

msgid "DIPLOMACY@PRESSURE@LEVEL_1_DESCRIPTION"
msgstr "O {GLOBAL.LeaderConcept.Hyperlink} sente confiança em relação ao seu {GLOBAL.EmpireConcept.Hyperlink}, o que afeta suas [hyperlink,GLOBAL.EmpireRelationConcept]Relações[/hyperlink] com ele em {RelationValue}[goodRelation/]."

msgid "DIPLOMACY@PRESSURE@LEVEL_2"
msgstr "Confiante"

msgid "DIPLOMACY@PRESSURE@LEVEL_3"
msgstr "Confiável"

msgid "DIPLOMACY@PRESSURE@TITLE"
msgstr "Nível de Ameaça"

msgid "DIPLOMACY@PRONOUNCEMENTS@ACTIVEINFO"
msgstr "Ações ativas de proclamação que têm como alvo este Governante ainda estão em andamento. Seus efeitos serão aplicados assim que as ações forem concluídas."

msgid "DIPLOMACY@PRONOUNCEMENTS@DESCRIPTION"
msgstr "Uma declaração ou proclamação que o <<m:{GLOBAL.LeaderConcept.Hyperlink}>> pode fazer em relação a outros Governantes para melhorar suas [hyperlink,GLOBAL.EmpireRelationConcept]Relações[/hyperlink]. Inclui [hyperlink,GLOBAL.FabricatedCasusBelliConcept]fabricar[/hyperlink] <<m:{GLOBAL.CasusBelliConcept.Hyperlink}>>, fazer declarações, [hyperlink,GLOBAL.CallToWarConcept]Convocar Governantes para a Guerra[/hyperlink] e mais."

msgid "DIPLOMACY@PRONOUNCEMENTS@HYPERLINK"
msgstr "[hyperlink,GLOBAL.PronouncementsConcept]Proclamação[/hyperlink]"

msgid "DIPLOMACY@PRONOUNCEMENTS@TITLE"
msgstr "Proclamações"

msgid "DIPLOMACY@PRONOUNCEMENTS@TOOLTIP"
msgstr "Abre as sub-opções de proclamação. Estas permitem que você faça declarações que afetarão seu relacionamento com o Governante oposto."

msgid "DIPLOMACY@PVE_NEGOTIATION_PHASE@DESCRIPTION"
msgstr "Durante a fase de negociação, todos os <<m:{GLOBAL.EmpireConcept.Hyperlink}>> podem [hyperlink,GLOBAL.NegotiationConcept]negociar[/hyperlink] com uma {GLOBAL.IndependentCityConcept.Hyperlink} por maior {GLOBAL.HouseInfluenceConcept.Hyperlink} e melhores estados diplomáticos. Uma vez que um {GLOBAL.EmpireConcept.Hyperlink} tenha assegurado {GLOBAL.HouseInfluenceConcept.Hyperlink} suficiente para um {GLOBAL.PactOfVassalageConcept.Hyperlink}, essa [hyperlink,GLOBAL.CompetitorConcept]competição[/hyperlink] termina e o {GLOBAL.EmpireConcept.Hyperlink} \"vencedor\" entra na {GLOBAL.VassalagePhaseConcept.Hyperlink}.[br/][br/]Estes são os <<m:{GLOBAL.PvEDiplStateConcept.Hyperlink}>> da Fase de Negociação:[bulletlist][bullet/]{GLOBAL.IndependentCityWarConcept.Hyperlink}[bullet/]{GLOBAL.IndependentCityNeutralConcept.Hyperlink}[bullet/]{GLOBAL.PactOfCooperationConcept.Hyperlink}[bullet/]{GLOBAL.PactOfLoyaltyConcept.Hyperlink}[bullet/]{GLOBAL.PactOfVassalageConcept.Hyperlink}[/bulletlist]"

msgid "DIPLOMACY@PVE_NEGOTIATION_PHASE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.NegotiationPhaseConcept]Fase de Negociação[/hyperlink]"

msgid "DIPLOMACY@PVE_NEGOTIATION_PHASE@TITLE"
msgstr "Fase de Negociação das Cidades Livres"

msgid "DIPLOMACY@PVE_VASSALAGE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.PvEVassalConcept]Vassalo[/hyperlink]"

msgid "DIPLOMACY@PVE_VASSALAGE@TITLE"
msgstr "Vassalagem da Cidade"

msgid "DIPLOMACY@PVE_VASSALAGE_PHASE@DESCRIPTION"
msgstr "Durante a fase de vassalagem, apenas o {GLOBAL.EmpireConcept.Hyperlink} suserano pode [hyperlink,GLOBAL.NegotiationConcept]negociar[/hyperlink] com uma {GLOBAL.IndependentCityConcept.Hyperlink}. Outros <<m:{GLOBAL.EmpireConcept.Hyperlink}>> só podem declarar {GLOBAL.IndependentCityWarConcept.Hyperlink} à {GLOBAL.IndependentCityConcept.Hyperlink} declarando guerra ao suserano da Cidade Livre.[br/][br/]Estes são os <<m:{GLOBAL.PvEDiplStateConcept.Hyperlink}>> da Fase de Vassalagem:[bulletlist][bullet/]{GLOBAL.PactOfVassalageLvl-3Concept.Hyperlink}[bullet/]{GLOBAL.PactOfVassalageLvl-2Concept.Hyperlink}[bullet/]{GLOBAL.PactOfVassalageLvl-1Concept.Hyperlink}[bullet/]{GLOBAL.PactOfVassalageLvl0Concept.Hyperlink}[bullet/]{GLOBAL.PactOfVassalageLvl1Concept.Hyperlink}[bullet/]{GLOBAL.PactOfVassalageLvl2Concept.Hyperlink}[bullet/]{GLOBAL.PactOfVassalageLvl3Concept.Hyperlink}[/bulletlist][br/][br/]Ao atingir {GLOBAL.PactOfVassalageLvl2Concept.Hyperlink}, o {GLOBAL.PactOfIntegrationConcept.Hyperlink} se torna disponível, permitindo que um {GLOBAL.EmpireConcept.Hyperlink} absorva completamente a {GLOBAL.IndependentCityConcept.Hyperlink}."

msgid "DIPLOMACY@PVE_VASSALAGE_PHASE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.VassalagePhaseConcept]Fase de Vassalagem[/hyperlink]"

msgid "DIPLOMACY@PVE_VASSALAGE_PHASE@TITLE"
msgstr "Fase de Vassalagem das Cidades Livres"

msgid "DIPLOMACY@PVE_VASSLAGE@DESCRIPTION"
msgstr "Cidades Livres podem ser vassalizadas por Governantes através de [hyperlink,GLOBAL.NegotiationConcept]Negociações[/hyperlink] ou convertendo uma {GLOBAL.CityConcept.Hyperlink} própria ou conquistada em uma cidade vassala.[br/][br/]Cidades vassalas possuem muitas vantagens:[bulletlist][bullet/]Elas compartilharão sua renda e materiais mágicos.[bullet/]Elas o auxiliarão em guerras.[bullet/]Elas lhe concederão visão de seu domínio.[/bulletlist][br/]Cidades vassalas também podem eventualmente ser [hyperlink,GLOBAL.PactOfIntegrationConcept]integradas[/hyperlink] ao Império do Governante."

