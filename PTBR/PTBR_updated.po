msgid "DLC@RISEFROMRUIN@CATACLYSM_VICTORY@SUB_TEXT"
msgstr "Aproveitando os Ventos Devoradores"

msgid "DLC@RISEFROMRUIN@CATACLYSM_VICTORY@VICTORY"
msgstr "Era do Cataclismo"

msgid "DLC@RISEFROMRUIN@CATACLYSM_VICTORY@VICTORY@ALLY_DESCRIPTION"
msgstr "{OtherPlayer.Name} aproveitou os Ventos Devoradores com os Artefatos dos Desfazedores. Juntos, vocês possuem o poder dos Cataclismos!"

msgid "DLC@RISEFROMRUIN@CATACLYSM_VICTORY@VICTORY@DESCRIPTION"
msgstr "Os Ventos Devoradores foram dominados pelos Artefatos dos Desfazedores. Seu poder flui em suas veias.[br/]Hubris ou não, você agora possui o poder dos Cataclismos!"

msgid "DLC@RISEFROMRUIN@CATACLYSM_VICTORY@VICTORY_CONDITION@DESCRIPTION"
msgstr "Para alcançar a Vitória do Cataclismo, explore os Ecos da Fratura em busca dos <<m:{GLOBAL.ArtifactConcept.Hyperlink}>> dos {GLOBAL.UnmakersLoreConcept.Hyperlink} dentro de Regiões Fadadas.[br/][br/]Adquira 3 <<m:{GLOBAL.ArtifactConcept.Hyperlink}>> para reclamar a vitória."

