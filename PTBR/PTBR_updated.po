msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@COMBAT_CASTERS@DESCRIPTION"
msgstr "Todos os <<m:{GLOBAL.UnitConcept.Hyperlink}>> defensores têm {GLOBAL.PROPERTIES.MELEE_MAGE.Hyperlink} até o final da batalha."

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@COMBAT_CASTERS@NAME"
msgstr "Defensores Magos de Corpo a Corpo"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@DELAYED_WORM@NAME"
msgstr "Tremores Atrasados"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@ELEMENTAL_FRAGILITY@DESCRIPTION"
msgstr "A primeira vez que cada {GLOBAL.PROPERTIES.ELEMENTAL.Hyperlink} {GLOBAL.UnitConcept.Hyperlink} defensor cai abaixo de {percent} de seus <<m:{GLOBAL.HitPointConcept.Hyperlink}>>:[bulletlist][bullet/]A unidade se teleporta até {hex} hexes longe dos atacantes.[bullet/]A unidade se transforma em uma unidade Elemental aleatória.[bullet/]A unidade sofre {stack} {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink}.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@ELEMENTAL_FRAGILITY@NAME"
msgstr "Fragilidade Elemental"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@ELEMENTAL_MAYHEM@DESCRIPTION"
msgstr "A primeira vez que cada {GLOBAL.PROPERTIES.ELEMENTAL.Hyperlink} {GLOBAL.UnitConcept.Hyperlink} defensor cai abaixo de {percent} de seus <<m:{GLOBAL.HitPointConcept.Hyperlink}>>:[bulletlist][bullet/]A unidade se teleporta até {hex} hexes longe dos atacantes.[bullet/]A unidade se transforma em uma unidade Elemental aleatória de Nível 1.[bullet/]A unidade é curada em {hp} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>[/bulletlist]"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@ELEMENTAL_MAYHEM@NAME"
msgstr "Caos Elemental"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@FADING_SOULS@DESCRIPTION"
msgstr "A cada {turn} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, todos os cadáveres de <<m:{GLOBAL.UnitConcept.Hyperlink}>> defensores são ressuscitados como um {GLOBAL.UNITS.PHANTASM_WARRIOR_UNIT.Hyperlink} que morre após {turn} [turn/] turnos."

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@FADING_SOULS@NAME"
msgstr "Almas Desvanecentes"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@FRACTURING_DRAGON@DESCRIPTION"
msgstr "O {GLOBAL.UNITS.FRACTURED_DRAGON.Hyperlink} defensor deixa para trás Fraturas de Mana em cada hex alvo de seus ataques. Fraturas de Mana têm {GLOBAL.DrainingConcept.Hyperlink} e se espalham para um hex adjacente toda vez que uma Magia é conjurada."

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@FRACTURING_DRAGON@NAME"
msgstr "Rastro de Fratura"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@FRIENDLY_FIRE_WORM@DESCRIPTION"
msgstr "A cada {turn} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, um raio de {radius} hexes perto de uma unidade defensora fica marcado por tremores.[bulletlist][bullet/]Todas as unidades atacantes sem {GLOBAL.PROPERTIES.FLYING_MOVEMENT.Hyperlink}, {GLOBAL.PROPERTIES.FLOATING_MOVEMENT.Hyperlink} ou {GLOBAL.PROPERTIES.SAND_WALK.Hyperlink} no raio sofrem {GLOBAL.PROPERTIES.SLOWED.Hyperlink} por {turn2} [turn/] turno.[bullet/]No final do próximo turno, todas as unidades ainda dentro do raio são mortas.[bulletlist][bullet/]Unidades mortas dessa forma ignoram {GLOBAL.PROPERTIES.RESURGENCE.Hyperlink} e {GLOBAL.PROPERTIES.STEADFAST.Hyperlink} e não deixam um cadáver para trás.[bullet/]O Líder da Expedição ainda é revivido com {hp} {GLOBAL.HitPointConcept.Hyperlink} se o lado deles for vitorioso na batalha.[/bulletlist][/bulletlist]"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@FRIENDLY_FIRE_WORM@NAME"
msgstr "Tremores Agitados"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@GIANT_WORM@DESCRIPTION"
msgstr "A cada {turn} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, um raio de {radius} hexes perto de uma unidade atacante fica marcado por tremores.[bulletlist][bullet/]Todas as unidades atacantes sem {GLOBAL.PROPERTIES.FLYING_MOVEMENT.Hyperlink}, {GLOBAL.PROPERTIES.FLOATING_MOVEMENT.Hyperlink} ou {GLOBAL.PROPERTIES.SAND_WALK.Hyperlink} no raio sofrem {GLOBAL.PROPERTIES.SLOWED.Hyperlink} por {turn2} [turn/] turno.[bullet/]No final do próximo [turn/] turno, todas as unidades ainda dentro do raio são mortas.[bulletlist][bullet/]Unidades mortas dessa forma ignoram {GLOBAL.PROPERTIES.RESURGENCE.Hyperlink} e {GLOBAL.PROPERTIES.STEADFAST.Hyperlink} e não deixam um cadáver para trás.[bullet/]O Líder da Expedição ainda é revivido com {hp} {GLOBAL.HitPointConcept.Hyperlink} se o lado deles for vitorioso na batalha.[/bulletlist][/bulletlist]"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@GIANT_WORM@DESCRIPTION_TSR"
msgstr "A cada {turn} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, um raio de {radius} hexes perto de uma unidade atacante fica marcado por tremores.[bulletlist][bullet/]Todas as unidades atacantes sem {GLOBAL.PROPERTIES.FLYING_MOVEMENT.Hyperlink}, {GLOBAL.PROPERTIES.FLOATING_MOVEMENT.Hyperlink} ou {GLOBAL.PROPERTIES.SAND_WALK.Hyperlink} no raio sofrem {GLOBAL.PROPERTIES.SLOWED.Hyperlink} por {turn2} [turn/] turno.[bullet/]No final do próximo [turn/] turno, todas as unidades ainda dentro do raio são mortas.[bulletlist][bullet/]Unidades mortas dessa forma ignoram {GLOBAL.PROPERTIES.RESURGENCE.Hyperlink} e {GLOBAL.PROPERTIES.STEADFAST.Hyperlink} e não deixam um cadáver para trás.[/bulletlist][/bulletlist]"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@GIANT_WORM@NAME"
msgstr "Tremores Gigantescos"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@MOVING_SANDSTORMS@DESCRIPTION"
msgstr "A cada {turns} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, várias tempestades de areia com raio de {hex} hexes são geradas em locais aleatórios.[bulletlist][bullet/]<<m:{GLOBAL.UnitConcept.Hyperlink}>> sem {GLOBAL.PROPERTIES.SAND_WALK.Hyperlink} sofrem {GLOBAL.PROPERTIES.SLOWED.Hyperlink} e têm {chance} de sofrer {GLOBAL.PROPERTIES.BLINDED.Hyperlink} por {turn} [turn/] turno ao passar por ou terminar seu turno em uma tempestade de areia.[bullet/]Tempestades de areia duram {turns} [turn/] turnos.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@MOVING_SANDSTORMS@NAME"
msgstr "Tempestades de Areia Rastejantes"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@REJUVINATING_SOULS@DESCRIPTION"
msgstr "A cada {turn} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, todos os cadáveres de <<m:{GLOBAL.UnitConcept.Hyperlink}>> defensores são ressuscitados como um {GLOBAL.UNITS.PHANTASM_WARRIOR_UNIT.Hyperlink}. Quando isso acontece, todas as unidades atacantes dentro de um raio de {radius} hexes do cadáver são curadas em {heal} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>."

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@REJUVINATING_SOULS@NAME"
msgstr "Almas Rejuvenescedoras"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@SABOTAGED_CONSTRUCTS@DESCRIPTION"
msgstr "Todos os {GLOBAL.PROPERTIES.CONSTRUCT.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> defensores sofrem {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink} por {turn} <<m:{GLOBAL.TurnConcept.Hyperlink}>>. Todas as unidades defensores não-construtos sofrem {GLOBAL.PROPERTIES.DEMORALIZED.Hyperlink} por {turn} [turn/] turnos em vez disso."

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@SABOTAGED_CONSTRUCTS@NAME"
msgstr "Construtos Sabotados"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@STATIC_SANDSTORMS@DESCRIPTION"
msgstr "Várias tempestades de areia com raio de {hex} hexágonos estão presentes na batalha.[bulletlist][bullet/]<<m:{GLOBAL.UnitConcept.Hyperlink}>> sem {GLOBAL.PROPERTIES.SAND_WALK.Hyperlink} sofrem {GLOBAL.PROPERTIES.SLOWED.Hyperlink} e têm {chance} de sofrer {GLOBAL.PROPERTIES.BLINDED.Hyperlink} por {turn} {GLOBAL.TurnConcept.Hyperlink} ao passar ou terminar seu turno em uma tempestade de areia.[bullet/]Essas tempestades de areia não se movem e permanecem em suas posições até o final da batalha.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@STATIC_SANDSTORMS@NAME"
msgstr "Tempestades de Areia Estáticas"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@TAUNTED_DRAGON@DESCRIPTION"
msgstr "O {GLOBAL.UNITS.FRACTURED_DRAGON.Hyperlink} defensor está sendo provocado pelo {GLOBAL.PROPERTIES.EXPEDITION_LEADER.Hyperlink} atacante até o final da batalha!"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@TAUNTED_DRAGON@NAME"
msgstr "Provocação do Dragão Fracturado"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@UNDYING_SOULS@DESCRIPTION"
msgstr "A cada {turn} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, todos os cadáveres de <<m:{GLOBAL.UnitConcept.Hyperlink}>> defensores são ressuscitados como <<m:{GLOBAL.UNITS.PHANTASM_WARRIOR_UNIT.Hyperlink}>>."

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@UNDYING_SOULS@NAME"
msgstr "Almas Imortais"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@VOLATILE_CONSTRUCTS@DESCRIPTION"
msgstr "Unidades defensores {GLOBAL.PROPERTIES.CONSTRUCT.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> explodem ao morrer, causando {damage} {GLOBAL.FireDamageConcept.Hyperlink} a todas as unidades defensores adjacentes."

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@VOLATILE_CONSTRUCTS@NAME"
msgstr "Construtos Voláteis"

msgid "DLC@RISEFROMRUIN@CRISIS@1171_4502@SUB_HEADER"
msgstr "Encontre uma das Regiões Fadadas."

msgid "DLC@RISEFROMRUIN@CRISIS@1171_4503@DESCRIPTION"
msgstr "Os {GLOBAL.FracturingWindsConcept.Hyperlink} uivam no ar e trarão o <<m:{GLOBAL.CataclysmConcept.Hyperlink}>> quando muitas magias <<m:{GLOBAL.WorldMapSpellConcept.Hyperlink}>> forem lançadas. Talvez, ao encontrar as origens desse fenômeno, você possa se proteger contra ele ou até mesmo usá-lo como arma."

msgid "DLC@RISEFROMRUIN@CRISIS@1171_4503@NAME"
msgstr "Os Ventos Devoradores"

msgid "DLC@RISEFROMRUIN@CRISIS@1224_1337@DESCRIPTION"
msgstr "Duas facções se chocam pelo controle do oásis subterrâneo. Uma tribo nômade busca erradicar aqueles que envenenam a terra, a água e seu povo—enquanto uma tribo de párias fracturados luta para defender o que consideram terra sagrada."

msgid "DLC@RISEFROMRUIN@CRISIS@1224_1337@NAME"
msgstr "Grande Lago do Vermes"

msgid "DLC@RISEFROMRUIN@CRISIS@1224_1337@SUB_HEADER"
msgstr "Uma batalha acirrada está ocorrendo no Grande Lago do Vermes."

msgid "DLC@RISEFROMRUIN@CRISIS@1252_70@DESCRIPTION"
msgstr "As Colinas Fantasma são pontilhadas com os acampamentos de guerra de um exército fantasma. Suas bandeiras tremulantes falam de um tempo em que ousados campeões marchavam sobre as cidades dos {GLOBAL.UnmakersLoreConcept.Hyperlink} para proteger o reino de seus perigosos experimentos arcanos."

msgid "DLC@RISEFROMRUIN@CRISIS@1252_70@NAME"
msgstr "Colinas Fantasma"

msgid "DLC@RISEFROMRUIN@CRISIS@1252_70@SUB_HEADER"
msgstr "O exército de um {TSR_WARLORD} fantasma permanece nesta região..."

msgid "DLC@RISEFROMRUIN@CRISIS@FRACTURING_WINDS@PHASE2@DESCRIPTION"
msgstr "Os {GLOBAL.FracturingWindsConcept.Hyperlink} parecem ter sido criados acidentalmente através da arrogância desses chamados {GLOBAL.UnmakersLoreConcept.Hyperlink}. Agora há muito tempo desaparecidos, alguns de seus <<m:{GLOBAL.ArtifactConcept.Hyperlink}>> permanecem nas Regiões Fadadas espalhadas pelo reino.[br/][br/]Esses artefatos provam ser capazes de manipular e parcialmente controlar os Ventos Devoradores.[br/][br/]Coletar o suficiente deles e canalizá-los por um tempo significará usar os ventos como arma, resultando em uma vitória decisiva para quem os manejar, pois poderão restaurar ou dispersar o reino à vontade."

msgid "DLC@RISEFROMRUIN@CRISIS@FRACTURING_WINDS@SUB_HEADER"
msgstr "Continue your journey, beware the [hyperlink,GLOBAL.FracturingWindsConcept.Hyperlink]Winds[/hyperlink]."

msgid "DLC@RISEFROMRUIN@CRISIS@TSR_RFR_CM@DESCRIPTION"
msgstr "Vozes criadas pelos ventos devoradores assombram esta área, onde a energia de {GLOBAL.FractureLoreConcept.Hyperlink} é tão volátil que o ar estala com ela. As vozes pedem para você se aproximar das Fraturas, prometendo conhecimento inimaginável."

msgid "DLC@RISEFROMRUIN@CRISIS@TSR_RFR_CM@NAME"
msgstr "Meseta Estalante"

msgid "DLC@RISEFROMRUIN@CRISIS@TSR_RFR_CM@SUB_HEADER"
msgstr "Os ventos devoradores sussurram promessas de conhecimento."

