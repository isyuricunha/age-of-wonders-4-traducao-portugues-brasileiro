msgid "TOME_PARADISE@SKILL2@DESCRIPTION"
msgstr "A {GLOBAL.CityConcept.Hyperlink} amigável alvo ganha:[bulletlist][bullet/]A cada {GLOBAL.TurnConcept.Hyperlink}, {amount} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> dentro ou adjacente ao {GLOBAL.DomainConcept.Hyperlink}:[bulletlist][bullet/]Ganha {GLOBAL.FertilePlainsConcept.Hyperlink} e {GLOBAL.ForestConcept.Hyperlink} se na Superfície, ou {GLOBAL.FungusFieldsConcept.Hyperlink} e {GLOBAL.MushroomForestConcept.Hyperlink} se no Subterrâneo.[bullet/]Perdem {GLOBAL.ChasmConcept.Hyperlink}, {GLOBAL.SwampConcept.Hyperlink}, {GLOBAL.SandConcept.Hyperlink}, {GLOBAL.SnowConcept.Hyperlink}, {GLOBAL.FrozenWasteConcept.Hyperlink}, {GLOBAL.AshlandsConcept.Hyperlink} e {GLOBAL.GloomTerrainConcept.Hyperlink}.[bullet/]Províncias dentro do domínio com características de Planícies Férteis, Florestas, Campos de Fungos ou Florestas de Cogumelos ganham: +{amount2} {GLOBAL.FoodConcept.Hyperlink}, +{amount2} {GLOBAL.StructureProductionConcept.Hyperlink} e +{amount2} {GLOBAL.UnitProductionConcept.Hyperlink}.[/bulletlist][/bulletlist]"

msgid "TOME_PARADISE@SKILL2@NAME"
msgstr "Florescimento Encantado"

msgid "TOME_PARADISE@SKILL3@DESCRIPTION"
