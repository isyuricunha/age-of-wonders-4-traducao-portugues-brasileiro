msgid "TOME_GOLDEN@STATUS@NAME"
msgstr "Dourado"

msgid "TOME_GOLDEN@TOME@GAMEPLAY"
msgstr "Torne-se um império próspero e ganhe grandes quantidades de ouro com nova infraestrutura e transformando seus inimigos em ouro."

msgid "TOME_GOLDEN@TOME@LORE"
msgstr "\"Ouro! O rei e a rainha dos minerais, cobiçados por todos os mortais que, ávidos e profundamente, escavam o solo. Verdadeiramente, domine este aspecto mais dourado da terra e você descobrirá que tudo que reluz realmente É ouro! Assim, você se tornará um com as riquezas da terra!\""

msgid "TOME_GOLDEN@TOME@LORE@AUTHOR"
msgstr "Fangir Rockborne, Mestre da Terra"

msgid "TOME_GOLDEN@TOME@NAME"
msgstr "Tomo do Reino Dourado"

msgid "TOME_GOLDEN@UNIT1@NAME"
msgstr "Golem Dourado^n"

msgid "TOME_GREAT_TRANSFORMATION@PASSIVE@DESCRIPTION"
msgstr "Reanime um {GLOBAL.HeroConcept} em sua cripta como um servo {GLOBAL.PROPERTIES.UNDEAD.Hyperlink} sob seu controle."

