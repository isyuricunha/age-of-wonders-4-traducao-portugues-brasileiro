msgid "CONCEPT@HERO_CLASS@WARLOCK@DESCRIPTION_SHORT"
msgstr "Bruxos são especialistas em enfraquecer inimigos e em mortos-vivos, usando poderosos debuffs e fortalecendo invocações de mortos-vivos que eles erguem durante a batalha."

msgid "CONCEPT@HERO_CLASS@WARLOCK@GAMEPLAY_HYPERLINK"
