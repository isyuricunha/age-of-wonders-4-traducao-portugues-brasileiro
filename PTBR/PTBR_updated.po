msgid "DLC@RISEFROMRUIN@FRACTURING_WINDS_CRISIS@HEALING_EVENT@HEADER_OTHERS"
msgstr "{CountdownPlayer.Name} purificará o Cataclismo em {TurnCountdown} [turn/] turnos!"

msgid "DLC@RISEFROMRUIN@FRACTURING_WINDS_CRISIS@OBJECTIVE1@DESCRIPTION"
msgstr "Região do Destino totalmente explorada."

msgid "DLC@RISEFROMRUIN@FRACTURING_WINDS_CRISIS@OBJECTIVE2@DESCRIPTION"
