msgid "DLC@ELDRITCHREALMS@CITYDEFINITIONS_STRATEGIC@SANCTUARY@NAME"
msgstr "Posto Santuário"

msgid "DLC@ELDRITCHREALMS@CITYDEFINITIONS_STRATEGIC@UMBRAL_DWELLING@ALIGNMENT"
msgstr "Moradia Umbral Destruída"

msgid "DLC@ELDRITCHREALMS@CITYDEFINITIONS_STRATEGIC@UMBRAL_DWELLING@DESCRIPTION"
msgstr "Moradias Umbrais são um tipo de {GLOBAL.DwellingConcept.Hyperlink} habitadas por {GLOBAL.ShadowDemonsLoreConcept.Hyperlink} que só podem ser encontradas no {GLOBAL.ShadowRealmLoreConcept.Hyperlink}.[br/][bulletlist][bullet/]Moradias Umbrais são sempre consideradas {GLOBAL.PROPERTIES.EVIL_3_UNIT_PROPERTY.Hyperlink} e terão relações positivas com outros [reputation2/] Impérios do Mal e relações negativas com [reputation6/] Impérios do Bem.[bullet/]Você não pode atribuir um {GLOBAL.DiplomaticTokenConcept.Hyperlink} a elas.[bullet/]Para melhorar a {GLOBAL.HouseInfluenceConcept.Hyperlink}, será solicitado que faça sacrifícios durante eventos aleatórios e por meio da ação Aumentar Lealdade.[bullet/]Ao alcançar um {GLOBAL.EldritchPactConcept.Hyperlink}, você pode comprar <<m:{GLOBAL.SpellConcept.Hyperlink}>> únicos e outros bônus para se beneficiar do terreno {GLOBAL.GloomTerrainConcept.Hyperlink}.[bullet/]Moradias Umbrais lentamente alteram o terreno dentro e adjacente ao seu {GLOBAL.DomainConcept.Hyperlink} para {GLOBAL.GloomTerrainConcept.Hyperlink}.[bullet/]Moradias Umbrais não podem ser [hyperlink,GLOBAL.PactOfVassalageConcept]vassalizadas[/hyperlink] ou [hyperlink,GLOBAL.AbsorbingConcept]conquistadas[/hyperlink]. Em vez disso, são destruídas ao serem capturadas.[bullet/]Moradias Umbrais são lideradas por <<{GLOBAL.UNITS.UMBRAL_TYRANT.Hyperlink}>> <<m:{GLOBAL.PROPERTIES.HERO.Hyperlink}>> únicos que não podem ser recrutados ou convertidos.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@CITYDEFINITIONS_STRATEGIC@UMBRAL_DWELLING@NAME"
msgstr "Moradia Umbral"

msgid "DLC@ELDRITCHREALMS@CITYDEFINITIONS_STRATEGIC@UMBRAL_DWELLING@NAME_PLURAL"
msgstr "Moradias Umbrais"

