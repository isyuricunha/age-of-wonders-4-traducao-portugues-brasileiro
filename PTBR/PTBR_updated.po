msgid "DLC@WAYSOFWAR@OATHSWORN@UNIT_MECHANIC02@DESCRIPTION"
msgstr "Ataques não-flanqueadores da unidade causam dano extra baseado na {GLOBAL.DevotionConcept.Hyperlink} da cultura:[bulletlist][bullet/][devotion3/] Paragon: +{paragonamount} {GLOBAL.SpiritDamageConcept.Hyperlink}[bullet/][devotion2/] Devoto: +{devoteeamount} {GLOBAL.SpiritDamageConcept.Hyperlink}[bullet/][devotion1/] Seguidor: +{adherentamount} {GLOBAL.SpiritDamageConcept.Hyperlink}[bullet/][devotion0/] Neutro: +{neutralamount} {GLOBAL.SpiritDamageConcept.Hyperlink}[bullet/][devotion-1/] Quebrador de Juramentos: -{OathbreakerDamage}% de dano[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

