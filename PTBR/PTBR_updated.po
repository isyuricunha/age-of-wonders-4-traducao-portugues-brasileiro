msgid "TOME_AMPLIFICATION@SKILL1@DESCRIPTION"
msgstr "Conjura um {GLOBAL.UNITS.AMPLIFICATION_PYLON_UNIT.Hyperlink}, uma estrutura estacionária que causa dano e aumenta o dano dos seus feitiços em {damage}.{LOC.CONCEPT@SUMMON_LIVE_SHARED}[br/][br/]{LOC.TACTICAL@ABILITY@NEVER_IN_WATER}"

msgid "TOME_AMPLIFICATION@SKILL1@NAME"
msgstr "Conjurar Pílone de Amplificação"

msgid "TOME_AMPLIFICATION@SKILL2@DESCRIPTION"
msgstr "Unidade inimiga alvo:[bulletlist][bullet/]Sofre {CHAIN_LIGHTNING_DAMAGE>DAMAGE>Shock} {GLOBAL.LightningDamageConcept.Hyperlink}.[bullet/]É infligido com {electrifiedCount} {GLOBAL.PROPERTIES.ELECTRIFIED.Hyperlink}.[bullet/]Este efeito passa para outro inimigo dentro de {CHAIN_LIGHTNING_JUMP>MaxDistance} hexágonos.[bullet/]Passa até {CHAIN_LIGHTNING_JUMP>MaxJumps} vezes.[/bulletlist]"

msgid "TOME_AMPLIFICATION@SKILL2@NAME"
msgstr "Cadeia de Relâmpagos"

msgid "TOME_AMPLIFICATION@SKILL3@DESCRIPTION"
msgstr "Concede às unidades encantadas:[bulletlist][bullet/]{GLOBAL.PROPERTIES.FRENZY.Hyperlink}, que aumenta o dano causado quando atacam.[bullet/]+{ARCANE_FRENZY_RANGE_MODIFIER>ADD>MaxRange}{GLOBAL.RangeConcept.Hyperlink} em ataques básicos à distância.[/bulletlist]"

msgid "TOME_AMPLIFICATION@SKILL3@NAME"
msgstr "Foco de Frenesi"

msgid "TOME_AMPLIFICATION@SKILL3@PROPERTY_DESCRIPTION"
msgstr "A unidade tem:[bulletlist][bullet/]{GLOBAL.PROPERTIES.FRENZY.Hyperlink}.[bullet/]+{ARCANE_FRENZY_RANGE_MODIFIER>ADD>MaxRange}{GLOBAL.RangeConcept.Hyperlink} em ataques básicos à distância.[/bulletlist]"

msgid "TOME_AMPLIFICATION@SKILL4@DESCRIPTION"
msgstr "Faz com que a magia comece a fluir nas veias da raça alvo, concedendo-lhes:[bulletlist][bullet/]{GLOBAL.PROPERTIES.ATTUNEMENT_FORTUNE.Hyperlink}, que aumenta a {GLOBAL.CriticalHitChanceConcept.Hyperlink} quando feitiços são lançados.[/bulletlist]"

msgid "TOME_AMPLIFICATION@SKILL4@NAME"
msgstr "Sangue Astral"

msgid "TOME_AMPLIFICATION@SKILL4@PROPERTY_DESCRIPTION"
msgstr "A unidade tem:[bulletlist][bullet/]{GLOBAL.PROPERTIES.ATTUNEMENT_FORTUNE.Hyperlink}.[/bulletlist]"

msgid "TOME_AMPLIFICATION@SKILL5@DESCRIPTION"
