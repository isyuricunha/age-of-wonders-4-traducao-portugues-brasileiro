msgid "DLC@EMPIRESANDASHES@STORY_REALM_MISSION_02@REALM_TRAIT_OASIS@DESCRIPTION"
msgstr "Este reino consiste em um Oásis central cercado por desertos.[bulletlist][bullet/]Desertos <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> são [abilityblue]Comuns[/abilityblue].[bullet/]Árticos, Terras Altas e <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> Temperados são [abilityblue]Ausentes[/abilityblue].[bullet/]Florestas <<m:{GLOBAL.ProvinceFeatureConcept.Hyperlink}>> e Pântanos <<m:{GLOBAL.ProvinceFeatureConcept.Hyperlink}>> são [abilityblue]Raros[/abilityblue].[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@STORY_REALM_MISSION_02@REALM_TRAIT_OASIS@NAME"
msgstr "Oásis"

msgid "DLC@EMPIRESANDASHES@STORY_REALM_MISSION_02@VICTORY"
msgstr "O Endailon do Caos foi revelado!"

msgid "DLC@EMPIRESANDASHES@STORY_REALM_MISSION_02@VICTORY_TEXT"
msgstr "Você revelou o Endailon do Caos e impediu Edward Portsmith de sucumbir à sua natureza violenta. Vitoriosos, você e Laryssa guiam Edward até Magehaven."

msgid "DLC@EMPIRESANDASHES@STRUCTURE_STRATEGIC@SEAL@DESCRIPTION"
msgstr "Fornece +{amount1} ponto para o {GLOBAL.SealsVictoryConcept.Hyperlink} a cada turno para o {GLOBAL.ImpérioConcept.Hyperlink} que tiver unidades posicionadas no Selo."

msgid "DLC@EMPIRESANDASHES@STRUCTURE_STRATEGIC@SEAL@LORE"
msgstr "[lorefontsize][lorefont]Os Selos foram construídos por ordem dos antigos {GLOBAL.ArchonsLoreConcept.Hyperlink}, para proteger os {GLOBAL.WorldsWithinLoreConcept.Hyperlink} das influências do {GLOBAL.AstralSeaLoreConcept.Hyperlink}... ou o contrário. Quem ativar essas estruturas poderosas terá controle total sobre quem entra ou sai do reino. Assim, os Selos foram deixados fortemente guardados. Na maioria dos mundos, essas maquinarias arcanas agora jazem dormentes e esquecidas... A menos que um poderoso {GLOBAL.GodirLoreConcept.Hyperlink} encontre uma maneira de ativá-los novamente.[/lorefont][/lorefontsize]"

msgid "DLC@EMPIRESANDASHES@STRUCTURE_STRATEGIC@SEAL@NAME"
msgstr "[sealsvictory/] Selo"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@PROVINCE_IMPROVEMENT@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{baseamount} {GLOBAL.ConhecimentoConcept.Hyperlink}.[bullet/]+{bonusamount} {GLOBAL.ConhecimentoConcept.Hyperlink} por {GLOBAL.ProvinceImprovementConcept.Hyperlink} único adjacente.[bullet/]Conta como um {GLOBAL.ResearchPostConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@PROVINCE_IMPROVEMENT@NAME"
msgstr "[researchpost/] Laboratório do Alquimista"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL1@ABILITY_DESCRIPTION"
msgstr "Unidade alvo:[bulletlist][bullet/]Ganha {amount} <<m:{GLOBAL.PositiveStatusEffectConcept.Hyperlink}>> aleatório.[bullet/]Tem um de seus <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>> dissipado.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL1@ABILITY_NAME"
msgstr "Distribuir Tônico"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL1@DESCRIPTION"
msgstr "Concede a unidades encantadas:[bulletlist][bullet/]{GLOBAL.PROPERTIES.DISTRIBUTE_TONIC.Hyperlink}, concedendo <<m:{GLOBAL.PositiveStatusEffectConcept.Hyperlink}>> enquanto remove um negativo.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL1@NAME"
msgstr "Tônico Misterioso"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL1@PROP_DESCRIPTION"
msgstr "Unidade possui:[bulletlist][bullet/]A habilidade {GLOBAL.PROPERTIES.DISTRIBUTE_TONIC.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL2@DESCRIPTION"
msgstr "Cria {GLOBAL.AfflictingMiasmaHazard.Hyperlink} em um raio de {hex} hexes."

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL2@NAME"
msgstr "Dispersar Miasma Aflictor"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL3@DESCRIPTION"
msgstr "{GLOBAL.PROPERTIES.RANGED_UNIT.Hyperlink} que pode criar Miasmas para debilitar inimigos."

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL3@NAME"
msgstr "Afligente^f"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL4@DESCRIPTION"
msgstr "Unidades amigas em um raio de {ANTIMAGIC_TINCTURE_CIRCLE>AREA>Radius} hexes:[bulletlist][bullet/]Têm {ANTIMAGIC_TINCTURE_DISPEL>NumThingsToDispel} <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>> dissipados.[bullet/]Ganham {amount} {GLOBAL.PROPERTIES.STATUS_PROTECTION.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL4@NAME"
msgstr "Tintura Antimágica"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL5@DESCRIPTION"
