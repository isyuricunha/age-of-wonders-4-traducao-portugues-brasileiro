msgstr "[bullet/]{GLOBAL.PROPERTIES.WARRIORS_SOUL.Hyperlink}: +{amount} {GLOBAL.FireDamageConcept.Hyperlink}"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@STRIFE@OATHBREAKER_TOOLTIP_DESCRIPTION"
msgstr "[bullet/]{GLOBAL.PROPERTIES.WARRIORS_SOUL.Hyperlink}: -{amount}% de dano mesmo se não estiver [hyperlink,GLOBAL.OutnumberedConcept]Em menor número[/hyperlink]."

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@STRIFE@PARAGON_TOOLTIP_DESCRIPTION"
msgstr "[bullet/]{GLOBAL.PROPERTIES.WARRIORS_SOUL.Hyperlink}: +{amount} {GLOBAL.FireDamageConcept.Hyperlink}[bullet/]Unidades {GLOBAL.UNITS.WARBOUND.Hyperlink} têm sua {GLOBAL.PROPERTIES.SWORN_PARAGON_BRAVERY.Hyperlink} ativada."

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@WISDOM@DESCRIPTION"
msgstr "Seu povo segue um caminho de Harmonia, buscando cooperação e limpar o mundo de ameaças:[bulletlist][bullet/]Ganhe +{relations} [goodRelation/] relações com <<m:{GLOBAL.IndependentCityConcept.Hyperlink}>> e <<m:{GLOBAL.LeaderConcept.Hyperlink}>>.[bullet/]Ao vassalizar uma cidade conquistada, elas começam na fase {GLOBAL.PactOfVassalageLvl0Concept.Hyperlink} em vez de {GLOBAL.PactOfVassalageLvl-1Concept.Hyperlink}.[bullet/]Unidades de cultura têm {GLOBAL.PROPERTIES.HARMONIZE.Hyperlink}.[bullet/]Ficam mais fortes à medida que ganham {GLOBAL.DevotionConcept.Hyperlink} para o {GLOBAL.OathOfHarmony.Hyperlink}.[/bulletlist]"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@WISDOM@LORENAME"
msgstr "Juramentada^f"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@WISDOM@NAME"
msgstr "Harmonia"

msgid "DLC@WAYSOFWAR@TOME_CALAMITY@SKILL1@DESCRIPTION"
msgstr "A {GLOBAL.ProvinceConcept.Hyperlink} de propriedade não arruinada vira Ruínas e terreno Desolado e então invoca um {GLOBAL.UNITS.DRAGON_OF_CALAMITY.Hyperlink}, uma unidade {GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink} com fortes capacidades ofensivas."

msgid "DLC@WAYSOFWAR@TOME_CALAMITY@SKILL1@NAME"
msgstr "Invocar Dragão da Calamidade"

msgid "DLC@WAYSOFWAR@TOME_CALAMITY@SKILL2@DESCRIPTION"
msgstr "Unidades em um raio de {METEOR_OF_CALAMITY_UNIT_TARGETER_CIRCLE>AREA>Radius} hex:[bulletlist][bullet/]Sofrem {METEOR_OF_CALAMITY_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Sofrem {METEOR_OF_CALAMITY_UNIT_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Têm uma chance base de {FROZEN_RESISTANCE>ResolvedStrength}% de se tornarem {GLOBAL.PROPERTIES.FROZEN.Hyperlink} por {FROZEN_EFFECT_DESCRIPTION>NumTurns} {GLOBAL.TurnConcept}.[bullet/]Ganham {amountStacks1} stacks de {GLOBAL.PROPERTIES.GHOSTFIRE.Hyperlink} por {GHOSTFIRE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@WAYSOFWAR@TOME_CALAMITY@SKILL2@NAME"
msgstr "Cometa da Calamidade"

msgid "DLC@WAYSOFWAR@TOME_CALAMITY@SKILL3@DESCRIPTION"
msgstr "{GLOBAL.ProvinceConcept.Hyperlink} alvo:[bulletlist][bullet/]Se contiver uma {GLOBAL.ProvinceImprovementConcept.Hyperlink}, ela se torna [hyperlink,GLOBAL.PillagingConcept]Saqueada[/hyperlink].[bulletlist][bullet/]Você recebe suas recompensas e perde [reputation2/] {GLOBAL.AlignmentConcept.Hyperlink}.[/bulletlist][bullet/]A província ganha {GLOBAL.AshlandsConcept.Hyperlink}.[bullet/]A província perde {GLOBAL.RiverConcept.Hyperlink}, {GLOBAL.FertilePlainsConcept.Hyperlink}, {GLOBAL.SwampConcept.Hyperlink}, {GLOBAL.SnowConcept.Hyperlink}, {GLOBAL.FrozenWasteConcept.Hyperlink}, {GLOBAL.SandConcept.Hyperlink}, {GLOBAL.CavernFloorConcept.Hyperlink} e {GLOBAL.GloomTerrainConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@WAYSOFWAR@TOME_CALAMITY@SKILL3@NAME"
msgstr "Profanar a Terra"

msgid "DLC@WAYSOFWAR@TOME_CALAMITY@SKILL4@DESCRIPTION"
msgstr "[bulletlist][bullet/]No início de cada {GLOBAL.TurnConcept.Hyperlink} durante o cerco, uma {GLOBAL.ProvinceImprovementConcept.Hyperlink} aleatória da cidade sitiada é [hyperlink,GLOBAL.PillagingConcept]saqueada[/hyperlink], concedendo recompensas.[bullet/]No início do combate:[bulletlist][bullet/]Todos os defensores ganham uma stack de {GLOBAL.PROPERTIES.GHOSTFIRE.Hyperlink} por {duration} <<m:{GLOBAL.TurnConcept}>>.[bullet/]{amountUnits} <<m:{GLOBAL.UNITS.ACCURSED_OGRE.Hyperlink}>> aparecem do lado do atacante.[/bulletlist][/bulletlist]"

msgid "DLC@WAYSOFWAR@TOME_CALAMITY@SKILL4@NAME"
msgstr "Ritual da Calamidade"

msgid "DLC@WAYSOFWAR@TOME_CALAMITY@SKILL5@DESCRIPTION"
msgstr "Ataques {GLOBAL.RangedConcept.Hyperlink} e {GLOBAL.MagicConcept.Hyperlink} de unidades encantadas:[bulletlist][bullet/]Causam +{ACCURSED_PROJECTILES_EXTRA_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Causam +{ACCURSED_PROJECTILES_EXTRA_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}[bullet/]Infligem {GLOBAL.PROPERTIES.GHOSTFIRE.Hyperlink} por {GHOSTFIRE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@WAYSOFWAR@TOME_CALAMITY@SKILL5@NAME"
msgstr "Projéteis Amaldiçoados"

msgid "DLC@WAYSOFWAR@TOME_CALAMITY@SKILL5@PROP_DESCRIPTION"
msgstr "Ataques {GLOBAL.RangedConcept.Hyperlink} e {GLOBAL.MagicConcept.Hyperlink} da unidade têm:[bulletlist][bullet/]+{ACCURSED_PROJECTILES_EXTRA_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]+{ACCURSED_PROJECTILES_EXTRA_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}[bullet/]Infligem {GLOBAL.PROPERTIES.GHOSTFIRE.Hyperlink} por {GHOSTFIRE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@WAYSOFWAR@TOME_CALAMITY@SKILL6@DESCRIPTION"
msgstr "Unidades encantadas ganham:[bulletlist][bullet/]Quando um ataque corpo a corpo atinge, o atacante tem uma:[bulletlist][bullet/]{GHOSTFIRE_RESISTANCE>ResolvedStrength}% de chance de ser afligido com {GLOBAL.PROPERTIES.GHOSTFIRE.Hyperlink} por {GHOSTFIRE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]{MISFORTUNE_RESISTANCE>ResolvedStrength}% de chance de ser afligido com {GLOBAL.PROPERTIES.MISFORTUNE.Hyperlink} por {MISFORTUNE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][bullet/]+{ACCURSED_ARMORS_RESISTANCE>DEF_MOD>Armor} {GLOBAL.DefenseConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@WAYSOFWAR@TOME_CALAMITY@SKILL6@NAME"
msgstr "Armaduras Amaldiçoadas"

msgid "DLC@WAYSOFWAR@TOME_CALAMITY@SKILL6@PROP_DESCRIPTION"
msgstr "Quando um ataque corpo a corpo atinge, o atacante tem uma:[bulletlist][bullet/]{GHOSTFIRE_RESISTANCE>ResolvedStrength}% de chance de ser afligido com {GLOBAL.PROPERTIES.GHOSTFIRE.Hyperlink} por {GHOSTFIRE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]{MISFORTUNE_RESISTANCE>ResolvedStrength}% de chance de ser afligido com {GLOBAL.PROPERTIES.MISFORTUNE.Hyperlink} por {MISFORTUNE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@WAYSOFWAR@TOME_CALAMITY@SPI@DESCRIPTION"
msgstr "[bulletlist][bullet/]Ao ser colocada, altera o terreno para Desolado.[bullet/]Por província de Ruínas adjacente, ganha:[bulletlist][bullet/]+{amount1} {GLOBAL.UnitProductionConcept.Hyperlink}[bullet/]+{amount2} {GLOBAL.FoodConcept.Hyperlink}[bullet/]+{amount3} {GLOBAL.GoldConcept.Hyperlink}[bullet/]+{amount4} {GLOBAL.KnowledgeConcept.Hyperlink}[bullet/]+{amount5} {GLOBAL.ManaConcept.Hyperlink}[bullet/]+{amount6} {GLOBAL.StructureProductionConcept.Hyperlink}[/bulletlist][bullet/]Permite o alistamento de {GLOBAL.UNITS.ACCURSED_OGRE.Hyperlink}, {GLOBAL.UNITS.ACCURSED_BLADE.Hyperlink} e {GLOBAL.UNITS.ACCURSED_TRICKSTER.Hyperlink}[bullet/]Conta como um {GLOBAL.ConduitConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@WAYSOFWAR@TOME_CALAMITY@SPI@NAME"
msgstr "[conduit/] Santuário Amaldiçoado"

msgid "DLC@WAYSOFWAR@TOME_CALAMITY@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Traga calamidade ao reino e queime seus inimigos com {GLOBAL.PROPERTIES.GHOSTFIRE.Hyperlink} fria."

msgid "DLC@WAYSOFWAR@TOME_CALAMITY@TOME@LORE_DESCRIPTION"
msgstr "\"Olhai, aquele Dragão da Calamidade; a desolação em seu nome! Contemplai a marca amaldiçoada; a cicatriz da chama congelada; Aquele inferno glacial, gelo e fogo unidos e gêmeos. Ó, trazedor de devastação gloriosa; Eis seus santuários de profanação; De pétalas cinzentas ao vento!\""

msgid "DLC@WAYSOFWAR@TOME_CALAMITY@TOME@NAME"
msgstr "Tomo da Calamidade"

msgid "DLC@WAYSOFWAR@TOME_DISCIPLINE@DESCRIPTION"
msgstr "Monge"

msgid "DLC@WAYSOFWAR@TOME_DISCIPLINE@EMPOWERED_STRIKES@DESCRIPTION"
msgstr "Faz com que os ataques base {GLOBAL.MeleeConcept.Hyperlink} de unidades encantadas:[bulletlist][bullet/]Causem +{EMPOWERED_STRIKES_EXTRA_DAMAGE>DAMAGE>Physical}{GLOBAL.PhysicalDamageConcept.Hyperlink}[bullet/]O terceiro ataque em um turno tem uma chance base de {STUNNED_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.STUNNED.Hyperlink} por {STUNNED_EFFECT_DESCRIPTION>NumTurns}{GLOBAL.TurnConcept.Name}[/bulletlist][br/]O encantamento não se aplica a unidades sem um ataque base corpo a corpo repetitivo."

msgid "DLC@WAYSOFWAR@TOME_DISCIPLINE@EMPOWERED_STRIKES@NAME"
msgstr "Golpes Fortalecidos"

msgid "DLC@WAYSOFWAR@TOME_DISCIPLINE@EMPOWERED_STRIKES@PROPERTY_DESCRIPTION"
msgstr "O ataque base {GLOBAL.MeleeConcept.Hyperlink} desta unidade:[bulletlist][bullet/]Causa +{EMPOWERED_STRIKES_EXTRA_DAMAGE>DAMAGE>Physical}{GLOBAL.PhysicalDamageConcept.Hyperlink}[bullet/]O terceiro ataque em um turno tem uma chance base de {STUNNED_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.STUNNED.Hyperlink} por {STUNNED_EFFECT_DESCRIPTION>NumTurns}{GLOBAL.TurnConcept.Name}[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@WAYSOFWAR@TOME_DISCIPLINE@FOCUS_AIM@ABILITY_DESCRIPTION"
msgstr "A unidade ganha {GLOBAL.PROPERTIES.TRUE_STRIKE.Hyperlink} neste turno e não pode errar."

msgid "DLC@WAYSOFWAR@TOME_DISCIPLINE@FOCUS_AIM@ABILITY_NAME"
msgstr "Foco"

msgid "DLC@WAYSOFWAR@TOME_DISCIPLINE@FOCUS_AIM@DESCRIPTION"
msgstr "Concede às unidades encantadas:[bulletlist][bullet/]A habilidade {GLOBAL.PROPERTIES.FOCUS.Hyperlink}, que permite à unidade fazer um ataque que não pode errar[/bulletlist]"

msgid "DLC@WAYSOFWAR@TOME_DISCIPLINE@FOCUS_AIM@NAME"
msgstr "Foco Preciso"

msgid "DLC@WAYSOFWAR@TOME_DISCIPLINE@FOCUS_AIM@PROP_DESCRIPTION"
msgstr "Esta unidade tem:[bulletlist][bullet/]A habilidade {GLOBAL.PROPERTIES.FOCUS.Hyperlink}.[/bulletlist]"

msgid "DLC@WAYSOFWAR@TOME_DISCIPLINE@INNER_MASTERY@DESCRIPTION"
msgstr "Concede à raça alvo domínio sobre suas próprias energias internas, concedendo-lhes:[bulletlist][bullet/]+{STATUS_RESISTANCE>Resistência}{GLOBAL.StatusResistanceConcept.Hyperlink}[bullet/]+{INNER_MASTERY_HEAL_MODIFIER>Multiplicador de Cura Resolvida}% de cura recebida em combate.[/bulletlist]"

msgid "DLC@WAYSOFWAR@TOME_DISCIPLINE@INNER_MASTERY@NAME"
