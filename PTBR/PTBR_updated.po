msgid "TOME_OBLIVION@SKILL1@PROPERTY@DESCRIPTION"
msgstr "Tem uma chance base de {chance}% de ficar {GLOBAL.PROPERTIES.STUNNED.Hyperlink} por {turn} <<m:{GLOBAL.TurnConcept}>> no início de cada batalha."

msgid "TOME_OBLIVION@SKILL2@DESCRIPTION"
msgstr "Unidade alvo não-{GLOBAL.PROPERTIES.HERO.Hyperlink} morre. Após {SLEEP_OF_OBLIVION_UNDYING>TurnsTilRes} <<m:{GLOBAL.TurnConcept}>>, voltam à vida com {SLEEP_OF_OBLIVION_UNDYING>ResolvedHealthProportion}% de seus pontos de vida totais <<m:{GLOBAL.HitPointConcept.Hyperlink}>> e são afligidos com {GLOBAL.PROPERTIES.INSANITY.Hyperlink}.[br/][br/]Enquanto mortos dessa forma, a unidade não pode ser revivida ou ter seu cadáver destruído."

msgid "TOME_OBLIVION@SKILL2@NAME"
msgstr "Sono do Esquecimento"

msgid "TOME_OBLIVION@SKILL2@PROPERTY@DESCRIPTION"
