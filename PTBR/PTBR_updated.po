msgstr "Chance base de {DIFILER_MAGE_RESISTANCE_CHECK>ResolvedStrength}% de remover um efeito de status positivo. Em caso de sucesso, cura {DEFILER_MAGE_HEAL>NumHitpointsToRestore}."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@DESECRATION@SKILL02@NAME"
