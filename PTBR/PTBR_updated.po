msgid "TOME_CRYOMANCY@SKILL_4@DESCRIPTION"
msgstr "Invoca um {GLOBAL.UNITS.LESSER_SNOW_SPIRIT.Hyperlink}, um {GLOBAL.PROPERTIES.MAGIC_FIGHTER.Hyperlink} com ataques que infligem {GLOBAL.PROPERTIES.FROZEN.Hyperlink}."

