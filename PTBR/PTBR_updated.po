msgid "TOME_PYROMANCY@TOME@LORE_AUTHOR"
msgstr "Yaka, autoproclamado Deus do Fogo"

msgid "TOME_PYROMANCY@TOME@LORE_DESCRIPTION"
msgstr "\"O fogo é sagrado. É o início e o fim, é paixão e destruição, é vida e morte. Domine a essência da chama, observe-a levar seus inimigos à ruína fumegante, contemple a beleza nas cinzas. Enquanto o inferno queima a terra, ele também dá vitalidade ao solo, trazendo vida da destruição por onde passa.\""

msgid "TOME_PYROMANCY@TOME@NAME"
msgstr "Tomo de Piromancia"

msgid "TOME_REAPER@ABILITY_1@DESCRIPTION"
msgstr "Unidade inimiga não-{GLOBAL.HeroConcept} alvo tem uma chance base de {FINGER_OF_DEATH_RESISTANCE_CHECK>ResolvedStrength}% de morrer.[bulletlist][bullet/]Se uma unidade não-{GLOBAL.PROPERTIES.UNDEAD.Hyperlink} morrer dessa forma, ela se transforma em um {GLOBAL.UNITS.DECAYING_ZOMBIE.Hyperlink} sob seu controle até o final da batalha.[bullet/]Se resistido, a unidade sofre {FINGER_OF_DEATH_UNIT_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink} que ignora {GLOBAL.ResistanceConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_REAPER@ABILITY_1@NAME"
msgstr "Dedo da Morte"

msgid "TOME_REAPER@ABILITY_2@DESCRIPTION"
