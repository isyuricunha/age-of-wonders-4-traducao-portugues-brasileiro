msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@SKILL2@DESCRIPTION"
msgstr "Invoca um {GLOBAL.UNITS.ARCHON_ANGEL.Hyperlink} {GLOBAL.PROPERTIES.BATTLE_MAGE.Hyperlink}, uma unidade que lança fogo sagrado para purificar seus inimigos."

msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@SKILL2@NAME"
