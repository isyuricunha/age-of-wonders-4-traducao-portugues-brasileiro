msgid "WILDLIFE_UNITPROPERTIES@IMMOBILIZING_PHASE@DESCRIPTION"
msgstr "Unidade se teleporta para o hex alvo e causa dano às unidades inimigas adjacentes."

msgid "WILDLIFE_UNITPROPERTIES@IMMOBILIZING_PHASE@NAME"
msgstr "Fase Imobilizadora"

msgid "WILDLIFE_UNITPROPERTIES@INCINERATE@DESCRIPTION"
msgstr "Causa dano em um raio de {INCINERATE_TARGETER>AREA>Radius} hex."

msgid "WILDLIFE_UNITPROPERTIES@INCINERATE@ENHANCED_DESCRIPTION"
msgstr "Incinerar:[bulletlist][bullet/]Causa um adicional de {INCINERATE_ENHANCED_DAMAGE>DAMAGE>Fire}{GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Garantidamente inflige {GLOBAL.PROPERTIES.BURNING.Hyperlink}.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@INCINERATE@ENHANCED_NAME"
