msgid "TOME_GREAT_TRANSFORMATION@SKILL1@DESCRIPTION"
msgstr "Concede imortalidade além da vida à raça alvo, concedendo-lhes:[bulletlist][bullet/]O tipo de unidade {GLOBAL.PROPERTIES.UNDEAD.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.NEW_LIFE_STEAL.Hyperlink}, que restaura <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> a cada ataque.[/bulletlist]"

