msgid "DLC@EMPIRESANDASHES@MINOR_FACTION@UPGRADE_SET@ALCHEMY@DESCRIPTION"
msgstr "Estes são os seguidores da Alquimia, cujo objetivo é a compreensão de toda a matéria por meio de estudo e experimentação. Seu domínio sobre a matéria traz prosperidade à sua sociedade... e vitória em suas guerras."

msgid "DLC@EMPIRESANDASHES@MINOR_FACTION@UPGRADE_SET@ALCHEMY@NAME"
