msgstr "Estes são os Mestres da Antimagia. Seja por uma antiga rixa ou apenas curiosidade, eles se especializaram em suprimir e anular completamente efeitos mágicos."

msgid "DLC@EMPIRESANDASHES@MINOR_FACTION@UPGRADE_SET@ANTIMAGIC@NAME"
msgstr "Mestres da Antimagia"

msgid "DLC@EMPIRESANDASHES@MINOR_FACTION@UPGRADE_SET@ANTIMAGIC_TRAIT@NAME"
