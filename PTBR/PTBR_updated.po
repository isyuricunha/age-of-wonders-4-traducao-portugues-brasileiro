msgid "TOME_GODDESS_NATURE@SKILL3@REQUISITE_NAME"
msgstr "Naga"

msgid "TOME_GODDESS_NATURE@SKILL4@DESCRIPTION"
msgstr "[bulletlist][bullet/]Cura todas as unidades amigáveis +{MASS_REJUVENATE_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Traz todas as unidades amigáveis mortas <<m:{GLOBAL.PROPERTIES.ANIMAL.Hyperlink}>> e <<m:{GLOBAL.PROPERTIES.PLANT.Hyperlink}>> de volta à vida com {MASS_REJUVENATE_EFFECT_RESSURECT>ResolvedHitPoints}% de seus <<m:{GLOBAL.HitPointConcept}>> totais.[/bulletlist]"

msgid "TOME_GODDESS_NATURE@SKILL4@NAME"
msgstr "Rejuvenescimento em Massa"

msgid "TOME_GODDESS_NATURE@SKILL5@NAME"
msgstr "Era da Natureza"

msgid "TOME_GODDESS_NATURE@TOME@DESCRIPTION"
msgstr "Torne-se a encarnação definitiva da natureza. Excelente em buffs e cura, especialmente para <<m:{GLOBAL.PROPERTIES.PLANT.Hyperlink}>> e <<m:{GLOBAL.PROPERTIES.ANIMAL.Hyperlink}>>."

msgid "TOME_GODDESS_NATURE@TOME@LORE_AUTHOR"
msgstr "Serena, Mago Élfico da Vida"

msgid "TOME_GODDESS_NATURE@TOME@LORE_DESCRIPTION"
msgstr "\"No final, todos nós seremos humilhados perante aquele que pode aproveitar plenamente as forças da natureza. O doador de vida e cultivador da morte, o domador da tempestade e o guardião da clareira. As bestas uivarão seu nome, as folhas sussurrarão suas bênçãos, e as terras serão melhores por seu reinado florescente.\""

msgid "TOME_GODDESS_NATURE@TOME@NAME"
msgstr "Tomo da Deusa da Natureza"

msgid "TOME_GOD_EMPEROR@HERO_SKILL@DESCRIPTION"
msgstr "[bulletlist][bullet/]Cura aliados dentro de um raio de {DOME_OF_PROTECTION_UNIT_TARGETER_CIRCLE>AREA>Radius} hexágonos +{DOME_OF_PROTECTION_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Coloca um {GLOBAL.DomeOfProtectionConcept.Hyperlink} sobre um raio de {DOME_OF_PROTECTION_UNIT_TARGETER_CIRCLE>AREA>Radius} hexágonos.[bullet/]Entra no modo de defesa.[/bulletlist]"

msgid "TOME_GOD_EMPEROR@HERO_SKILL@MARKER@DESCRIPTION"
msgstr "Unidades amigáveis com {GLOBAL.PROPERTIES.FAITHFUL.Hyperlink} ou {GLOBAL.PROPERTIES.ZEAL.Hyperlink} ganham:[bulletlist][bullet/]{stacks} {GLOBAL.DefenseConcept.Hyperlink}[bullet/]{stacks} {GLOBAL.ResistanceConcept.Hyperlink}[bullet/]{stacks} {GLOBAL.StatusResistanceConcept.Hyperlink}[/bulletlist]"

msgid "TOME_GOD_EMPEROR@HERO_SKILL@NAME"
msgstr "Conjurar Cúpula de Proteção"

msgid "TOME_GOD_EMPEROR@HERO_SKILL@PROPERTY@DESCRIPTION"
msgstr "Unidades com {GLOBAL.PROPERTIES.ZEAL.Hyperlink} ou {GLOBAL.PROPERTIES.FAITHFUL.Hyperlink} ganham:[bulletlist][bullet/]+{DOME_OF_PROTECTION_STAT_BONUS>BONUS>DEFENSE>Armor} {GLOBAL.DefenseConcept.Hyperlink}.[bullet/]+{DOME_OF_PROTECTION_STAT_BONUS>BONUS>DEFENSE>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}.[bullet/]+{DOME_OF_PROTECTION_STATUS_RESISTANCE>Resistance} {GLOBAL.StatusResistanceConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_GOD_EMPEROR@HERO_SKILL@PROPERTY@NAME"
