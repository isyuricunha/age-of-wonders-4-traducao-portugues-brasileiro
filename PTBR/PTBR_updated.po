msgstr "Fratura"

msgid "DLC@RISEFROMRUIN@INTERFACE@FRACTURE@DESCRIPTION"
msgstr "Fraturas são rasgos no tecido da magia e da realidade.[br/][br/]Mover uma unidade [unit/] irá acionar um Evento relacionado a ela."

msgid "DLC@RISEFROMRUIN@INTERFACE@FRACTURE@ERROR"
msgstr "ERRO - POR FAVOR VERIFIQUE COM PABLO"

msgid "DLC@RISEFROMRUIN@INTERFACE@FRACTURED_BOLT@NAME"
