msgstr "[hyperlink,GLOBAL.HykaLoreConcept]Hyka-Tha Agatare[/hyperlink]"

msgid "INTERFACE@LORE_CONCEPT@HYKA@NAME"
msgstr "Hyka-Tha Agatare"

