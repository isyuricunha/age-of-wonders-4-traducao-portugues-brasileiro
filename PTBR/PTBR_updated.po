msgstr "Causa dano e aplica {GLOBAL.PROPERTIES.BLINDED.Hyperlink} às unidades em um raio de {BRILLIANT_PHASE_CIRCLE_TARGETER>AREA>Radius} hexágonos. A unidade então se teleporta para o hexágono alvo."

msgid "WILDLIFE_UNITPROPERTIES@BRILLIANT_PHASE@NAME"
msgstr "Fase Brilhante"

msgid "WILDLIFE_UNITPROPERTIES@BUDDING_STRENGTH@DESCRIPTION"
msgstr "Unidades amigáveis em um raio de {BUDDING_STRENGTH_TARGETER>AREA>Radius} hexágonos ganham:[bulletlist][bullet/]{amount} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.TRUE_STRIKE.Hyperlink}[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@BUDDING_STRENGTH@DESCRIPTION_2"
msgstr "Unidades amigáveis em um raio de {BUDDING_STRENGTH_TARGETER>AREA>Radius} hexágonos ganham:[bulletlist][bullet/]{amount} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.TRUE_STRIKE.Hyperlink}[bullet/]{randomAmount} <<m:{GLOBAL.PositiveStatusEffectConcept.Hyperlink}>> aleatórios[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@BUDDING_STRENGTH@DESCRIPTION_CHAMPION"
msgstr "Força Crescente:[bulletlist][bullet/]Concede um adicional de {amount} <<m:{GLOBAL.PositiveStatusEffectConcept.Hyperlink}>> aleatórios.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@BUDDING_STRENGTH@NAME"
msgstr "Força Crescente"

msgid "WILDLIFE_UNITPROPERTIES@BUDDING_STRENGTH@NAME_CHAMPION"
msgstr "Força Crescente do Campeão"

msgid "WILDLIFE_UNITPROPERTIES@BURNING@NAME"
msgstr "Queimando"

msgid "WILDLIFE_UNITPROPERTIES@BURNING@PROP"
msgstr "Inflige {GLOBAL.PROPERTIES.BURNING.Hyperlink}."

msgid "WILDLIFE_UNITPROPERTIES@BUTCHERS_CUT@DESCRIPTION"
msgstr "Causa dano à unidade alvo. Com base na saúde faltante, o alvo tem uma chance aumentada de:[bulletlist][bullet/]Ganhar {amount} {GLOBAL.PROPERTIES.BLEEDING.Hyperlink} por {BLEEDING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Ganhar {amount} {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink} por {SUNDERED_DEFENSE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Em caso de sucesso, o ogro cura {BUTCHERS_CUT_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@BUTCHERS_CUT@NAME"
msgstr "Corte do Açougueiro"

msgid "WILDLIFE_UNITPROPERTIES@BUTCHERS_CUT@RES_OVERRIDE"
msgstr "[bulletlist][bullet/]{amount}x Sangrando[bullet/]{amount}x Defesa Despedaçada[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@CAPTIVE_GLAMOUR@DESCRIPTION"
msgstr "[bulletlist][bullet/]A unidade alvo danificada tem uma chance de se tornar {GLOBAL.PROPERTIES.DOMINATED.Hyperlink} até o final do combate.[bullet/]A chance aumenta com a saúde faltante do alvo.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@CAPTIVE_GLAMOUR@NAME"
msgstr "Glamour Cativo"

msgid "WILDLIFE_UNITPROPERTIES@CARRION_FEED@DESCRIPTION"
msgstr "Consome o cadáver alvo e cura +{CARRION_FEED_DESTROY_CORPSE>HealCasterAmount} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>."

msgid "WILDLIFE_UNITPROPERTIES@CARRION_FEED@NAME"
msgstr "Alimentação de Carniça"

msgid "WILDLIFE_UNITPROPERTIES@CAUSTIC_ERUPTION@DESCRIPTION"
msgstr "Causa dano às unidades inimigas em um raio de {CAUSTIC_ERUPTION_TARGETER>AREA>Radius} hexágonos."

msgid "WILDLIFE_UNITPROPERTIES@CAUSTIC_ERUPTION@NAME"
msgstr "Erupção Cáustica"

msgid "WILDLIFE_UNITPROPERTIES@CHAIN_LIGHTNING@DESCRIPTION"
msgstr "Causa dano à unidade alvo e até {CHAIN_LIGHTNING_JUMP_TARGETER>MaxDistance} outras unidades dentro de {CHAIN_LIGHTNING_JUMP_TARGETER>MaxJumps} hexágonos."

msgid "WILDLIFE_UNITPROPERTIES@CHAIN_LIGHTNING@NAME"
msgstr "Relâmpago em Cadeia"

msgid "WILDLIFE_UNITPROPERTIES@CLEANSING_TOUCH@DESCRIPTION"
msgstr "Unidade alvo:[bulletlist][bullet/]Cura {CLEANSING_TOUCH_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Remove {GENERAL_DISPEL_NEGATIVE>NumThingsToDispel} Efeitos de Status Negativos.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@CLEANSING_TOUCH@NAME"
msgstr "Toque Purificador"

msgid "WILDLIFE_UNITPROPERTIES@CONDEMNING_BLAST@NAME"
msgstr "Explosão Condenatória"

msgid "WILDLIFE_UNITPROPERTIES@COSMIC_BARRAGE@DESCRIPTION"
msgstr "Causa dano em um raio de {COSMIC_BARRAGE_TARGETER>AREA>Radius} hexágonos."

msgid "WILDLIFE_UNITPROPERTIES@COSMIC_BARRAGE@NAME"
msgstr "Barragem Cósmica"

msgid "WILDLIFE_UNITPROPERTIES@COSMIC_SPARK@DESCRIPTION"
msgstr "Causa {COSMIC_SPARK_EXTRA_DAMAGE>DAMAGE>Shock} {GLOBAL.LightningDamageConcept.Hyperlink}, {COSMIC_SPARK_EXTRA_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} ou {COSMIC_SPARK_EXTRA_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink} aleatoriamente."

msgid "WILDLIFE_UNITPROPERTIES@COSMIC_SPARK@NAME"
msgstr "Faísca Cósmica"

msgid "WILDLIFE_UNITPROPERTIES@CRUEL_CHARGE@NAME"
msgstr "Carga Cruel Corpo a Corpo"

msgid "WILDLIFE_UNITPROPERTIES@CRUSHING_ANGUISH@DESCRIPTION"
msgstr "Unidade alvo com {GLOBAL.UnitMoraleConcept.Hyperlink} de \"Baixa\" ou pior:[bulletlist][bullet/]Tem chance de morrer instantaneamente.[bullet/]Quanto menor a moral da unidade alvo, maior essa chance.[bullet/]Se a unidade não morrer, sofre {CRUSHING_ANGUISH_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink} em vez disso.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@CRUSHING_ANGUISH@NAME"
msgstr "Angústia Esmagadora"

msgid "WILDLIFE_UNITPROPERTIES@DEFLECTION@NAME"
msgstr "Deflexão"

msgid "WILDLIFE_UNITPROPERTIES@DEFLECTIONRIER@DESCRIPTION"
msgstr "Unidade tem +{DEFLECTION>ResolvedAccuracyModifier}% {GLOBAL.EvasionConcept.Hyperlink}."

msgid "WILDLIFE_UNITPROPERTIES@DEVOUR_MIND@DESCRIPTION"
msgstr "Unidade inimiga alvo tem uma chance base de {DEVOUR_MIND_RESISTANCE_CHECK>ResolvedStrength}% de:[bulletlist][bullet/]Ganhar {GLOBAL.PROPERTIES.INSANITY.Hyperlink} por {INSANITY_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bulletlist][bullet/]Se bem-sucedido, o atacante ganha uma pilha de {GLOBAL.PROPERTIES.DEVOUR_MIND_STAT_UP.Hyperlink} até o final da batalha.[bullet/]Se mal-sucedido, o alvo sofre:[bulletlist][bullet/]{DEVOUR_MIND_DAMAGE>DAMAGE>Shock} {GLOBAL.LightningDamageConcept.Hyperlink}[bullet/]{DEVOUR_MIND_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}[bullet/]{DEVOUR_MIND_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[/bulletlist][/bulletlist][/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@DEVOUR_MIND@NAME"
msgstr "Devorar Mente"

msgid "WILDLIFE_UNITPROPERTIES@DEVOUR_MIND@PROP_DESCRIPTION"
msgstr "[bulletlist][bullet/]+{DEVOUR_MIND_STAT_UP>BONUS>HitPoints} máximo <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]+{DEVOUR_MIND_STAT_UP>BONUS>DEFENSE>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}.[bullet/]Acumula até {amount} vezes.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@DEVOUR_MIND@PROP_NAME"
msgstr "Mente Absorvida"

msgid "WILDLIFE_UNITPROPERTIES@DISTRACTING_AURA@DESCRIPTION"
msgstr "No início do turno, inflige {GLOBAL.PROPERTIES.DISTRACTED.Hyperlink} a unidades inimigas adjacentes por {DISTRACTED_EFFECT_DESCRIPTION>NumTurns} {GLOBAL.TurnConcept}."

msgid "WILDLIFE_UNITPROPERTIES@DISTRACTING_AURA@NAME"
msgstr "Aura Distraente"

msgid "WILDLIFE_UNITPROPERTIES@DRACONIC_RAGE@DESCRIPTION"
msgstr "Quando os <<m:{GLOBAL.HitPointConcept.Hyperlink}>> totais desta unidade atingirem {DRACONIC_RAGE>ResolvedTriggerProportion}% ou menos, ela causa +{DRACONIC_RAGE_ABILITY_MODIFIER_DAMAGE>ResolvedMultiplier}% de dano."

msgid "WILDLIFE_UNITPROPERTIES@DRACONIC_RAGE@NAME"
msgstr "Fúria Draconiana"

msgid "WILDLIFE_UNITPROPERTIES@DRACONIC_RAGE@PROP_DESCRIPTION"
msgstr "Unidade causa +{DRACONIC_RAGE_ABILITY_MODIFIER_DAMAGE>ResolvedMultiplier}% de dano."

msgid "WILDLIFE_UNITPROPERTIES@DRAGON_BREATH@DESCRIPTION"
msgstr "Causa dano a todas as unidades em um cone de {DRAGON_BREATH_TARGETER>AREA>Length} hexágonos."

msgid "WILDLIFE_UNITPROPERTIES@DRAIN_ENCHANTMENT@DESCRIPTION"
msgstr "Remove um [abilityblue]Encantamento de Unidade[/abilityblue] aleatório ao acertar."

msgid "WILDLIFE_UNITPROPERTIES@DRAIN_ENCHANTMENT@NAME"
msgstr "Drenar Encantamento"

msgid "WILDLIFE_UNITPROPERTIES@DRENCHING_PHASE@DESCRIPTION"
msgstr "Teleporta a unidade para o hexágono alvo, então causa dano e inflige {GLOBAL.PROPERTIES.WET.Hyperlink} em unidades adjacentes."

msgid "WILDLIFE_UNITPROPERTIES@DRENCHING_PHASE@NAME"
msgstr "Fase Encharcante"

msgid "WILDLIFE_UNITPROPERTIES@DRINK@DESCRIPTION"
