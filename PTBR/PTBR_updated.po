msgid "TOME_ARCHDRUID@SKILL1@DESCRIPTION"
msgstr "Inimigo alvo não-{GLOBAL.PROPERTIES.HERO.Hyperlink}:[bulletlist][bullet/]Tem uma chance base de {DEVOLVE_RESISTANCE_CHECK>ResolvedStrength}% de ser transformado em um animal aleatório de Nível I até o final da batalha.[bullet/]Se resistir, inflige {GLOBAL.PROPERTIES.STUNNED.Hyperlink} em vez disso.[/bulletlist][br/][br/]{LOC.TACTICAL@ABILITY@NEVER_IN_WATER}"

msgid "TOME_ARCHDRUID@SKILL1@NAME"
msgstr "Regressão"

msgid "TOME_ARCHDRUID@SKILL2@DESCRIPTION"
msgstr "Na {GLOBAL.ProvinceConcept.Hyperlink} alvo:[bulletlist][bullet/]Unidades inimigas sofrem {damageamount} {GLOBAL.BlightDamageConcept.Hyperlink}.[bullet/]Se contiver uma {GLOBAL.ProvinceImprovementConcept.Hyperlink} inimiga, ela se torna [hyperlink,GLOBAL.PillagingConcept]Saqueada[/hyperlink].[bulletlist][bullet/]Você não recebe suas recompensas nem perde {GLOBAL.AlignmentConcept.Hyperlink}.[/bulletlist][bullet/]A província ganha {GLOBAL.ForestConcept.Hyperlink} se na Superfície ou {GLOBAL.MushroomForestConcept.Hyperlink} se no Subterrâneo.[/bulletlist]"

