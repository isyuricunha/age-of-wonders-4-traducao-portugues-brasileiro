msgstr "[hyperlink,GLOBAL.LaryssaLoreConcept]Laryssa Mirabilis[/hyperlink]"

msgid "INTERFACE@LORE_CONCEPT@LARYSSA@NAME"
msgstr "Laryssa Mirabilis"

