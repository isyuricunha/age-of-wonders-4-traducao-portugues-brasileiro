msgstr "A unidade tem:[bulletlist][bullet/]+{FLESH_CARVED_RUNES_STAT_BONUS>BONUS>Regen} de regeneração de {GLOBAL.HitPointConcept.Hyperlink} no {GLOBAL.WorldMapConcept.Hyperlink}.[bullet/]Ataques e habilidades de {GLOBAL.DebuffConcept.Hyperlink}:[bulletlist][bullet/]Ignoram {FLESH_CARVED_RUNES_RESISTANCE_CHECK_BOOST>ResistanceBypass} de {GLOBAL.StatusResistanceConcept.Hyperlink} por pilha de {GLOBAL.PROPERTIES.BLEEDING.Hyperlink} no alvo.[/bulletlist][/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_BLOOD_RITE@SPI@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{amount} de renda de {GLOBAL.UnitProductionConcept.Hyperlink}.[bullet/]+{amount2} de {GLOBAL.UnitProductionConcept.Hyperlink} por {GLOBAL.FarmConcept.Hyperlink} adjacente.[bullet/]Ao ser vitorioso em batalha, ganha {amount3} de {GLOBAL.ManaConcept.Hyperlink}.[bullet/]Conta como um {GLOBAL.ConduitConcept.Hyperlink}.[/bulletlist]"

