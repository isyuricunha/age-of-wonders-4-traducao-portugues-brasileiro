msgstr "Those Who Remained Behind"

msgid "DLC@SECRETSOFTHEARCHMAGES@RACE@BI_ELVES@NAME"
msgstr "Long Forgotten Protectors"

msgid "DLC@SECRETSOFTHEARCHMAGES@RACE@BI_HALF_DARKS@NAME"
msgstr "Twisted Halflings"

msgid "DLC@SECRETSOFTHEARCHMAGES@RACE@HighElves@NAME"
msgstr "Defenders of Secrets"

msgid "DLC@SECRETSOFTHEARCHMAGES@RACE@YAKA@NAME"
msgstr "Azracs"

msgid "DLC@SECRETSOFTHEARCHMAGES@REALMTRAITS_SHROUDEDREGIONS@ACTIVATE_OBELISK_QUEST@OBJECTIVE_DESCRIPTION"
msgstr "<<m:{GLOBAL.STRUCTURES.ANCIENT_OBELISK_NODE.Hyperlink}>> Activated"

msgid "DLC@SECRETSOFTHEARCHMAGES@REALMTRAITS_SHROUDEDREGIONS@ACTIVATE_OBELISK_QUEST@SHOW_NEAREST_PORTAL@PREDICTION"
msgstr "You will be shown the nearest Portal towards a Shrouded Isle."

msgid "DLC@SECRETSOFTHEARCHMAGES@REALMTRAITS_SHROUDEDREGIONS@OBELISK_OPERATION@DESCRIPTION"
msgstr "Requires a {GLOBAL.PROPERTIES.HERO.Hyperlink} Unit.[br/]Activating enough Ancient Obelisks will reveal the portals leading to Shrouded Isles![br/][br/]You can only activate each Ancient Obelisk once.[br/]Activating an Ancient Obelisk does not prevent other {GLOBAL.EmpireConcept.Hyperlink} from activating them."

msgid "DLC@SECRETSOFTHEARCHMAGES@REALMTRAITS_SHROUDEDREGIONS@OBELISK_OPERATION@NAME"
msgstr "Activate Ancient Obelisk"

msgid "DLC@SECRETSOFTHEARCHMAGES@REALMTRAITS_SHROUDEDREGIONS@SHROUDED_FEATURE@DESCRIPTION"
msgstr "This area is shrouded in mystery. A dimension where powerful Godir built magical landscapes to keep their secrets safe.[br/][br/]No {GLOBAL.CityConcept.Hyperlink} or {GLOBAL.OutpostConcept.Hyperlink} can be built here."

msgid "DLC@SECRETSOFTHEARCHMAGES@REALMTRAITS_SHROUDEDREGIONS@SHROUDED_FEATURE@NAME"
msgstr "Shrouded"

msgid "DLC@SECRETSOFTHEARCHMAGES@SECRET_SPELLS@01@DESCRIPTION"
msgstr "Summon a {GLOBAL.UNITS.FEY_ABOMINATION.Hyperlink}, a powerful unit that uses the abilities of a powerful fiend with a Fey twist."

msgid "DLC@SECRETSOFTHEARCHMAGES@SECRET_SPELLS@01@NAME"
msgstr "Belbedor's Folly"

msgid "DLC@SECRETSOFTHEARCHMAGES@SECRET_SPELLS@02@DESCRIPTION"
msgstr "Up to {amount} random <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> gain an Ice Age Hazard. At the start of the next turn those hazards expire and:[bulletlist][bullet/]Enemy units sustain {amountDamage} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Provinces are destroyed.[bullet/]The province:[bulletlist][bullet/]Gains {GLOBAL.SnowConcept.Hyperlink} and {GLOBAL.FrozenWasteConcept.Hyperlink}.[bullet/]Loses {GLOBAL.ChasmConcept.Hyperlink}, {GLOBAL.SwampConcept.Hyperlink}, {GLOBAL.AshlandsConcept.Hyperlink}, {GLOBAL.SandConcept.Hyperlink}, {GLOBAL.CavernFloorConcept.Hyperlink}, {GLOBAL.FungusFieldsConcept.Hyperlink}, and {GLOBAL.GloomTerrainConcept.Hyperlink}."

msgid "DLC@SECRETSOFTHEARCHMAGES@SECRET_SPELLS@02@DISPLAY_PROPERTY"
msgstr "When this hazard expires:[bulletlist][bullet/]Enemy units sustain {amountDamage} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Provinces are destroyed.[bullet/]The province:[bulletlist][bullet/]Gains {GLOBAL.SnowConcept.Hyperlink} and {GLOBAL.FrozenWasteConcept.Hyperlink}.[bullet/]Loses {GLOBAL.ChasmConcept.Hyperlink}, {GLOBAL.SwampConcept.Hyperlink}, {GLOBAL.AshlandsConcept.Hyperlink}, {GLOBAL.SandConcept.Hyperlink}, {GLOBAL.CavernFloorConcept.Hyperlink}, {GLOBAL.FungusFieldsConcept.Hyperlink}, and {GLOBAL.GloomTerrainConcept.Hyperlink}."

msgid "DLC@SECRETSOFTHEARCHMAGES@SECRET_SPELLS@02@NAME"
msgstr "Artica's Ice Age"

msgid "DLC@SECRETSOFTHEARCHMAGES@SECRET_SPELLS@02@PROP_NAME"
msgstr "Ice Age"

msgid "DLC@SECRETSOFTHEARCHMAGES@SECRET_SPELLS@03@DESCRIPTION"
msgstr "Summon a {GLOBAL.UNITS.MISBORN_MISTLING.Hyperlink}, a transformed and monstrous Fey that favors brute force over Fey tricks."

msgid "DLC@SECRETSOFTHEARCHMAGES@SECRET_SPELLS@03@NAME"
msgstr "Thulyana's Contortion"

msgid "DLC@SECRETSOFTHEARCHMAGES@SECRET_SPELLS@04@DESCRIPTION"
msgstr "Summon a {GLOBAL.UNITS.COLOSSAL_PENGUIN.Hyperlink}, the failed experiment of Nimue as she tried to harness a power too evil for even her to control.[br/][br/]Additionally, unlock the drafting of some {GLOBAL.PROPERTIES.PENGUIN.Hyperlink} units in cities."

msgid "DLC@SECRETSOFTHEARCHMAGES@SECRET_SPELLS@04@NAME"
msgstr "Nimue's Failure"

msgid "DLC@SECRETSOFTHEARCHMAGES@SECRET_SPELLS@05@DESCRIPTION"
msgstr "Target non-{GLOBAL.HeroConcept.Hyperlink} enemy unit is revealed to be a {GLOBAL.UNITS.MIRROR_MIMIC_UNIT.Hyperlink} spy on your side.[br/][br/]If it survives until the end of combat, it can be acquired for a {GLOBAL.ManaConcept.Hyperlink} cost."

msgid "DLC@SECRETSOFTHEARCHMAGES@SECRET_SPELLS@05@NAME"
msgstr "Frikka's Revelation"

msgid "DLC@SECRETSOFTHEARCHMAGES@SECRET_SPELLS@06@DESCRIPTION"
msgstr "Infuse target race with feline essence gaining:[bulletlist][bullet/]{GLOBAL.PROPERTIES.VERY_FAST_MOVEMENT.Hyperlink}[bullet/]+{YAKA'S_FELINE_INFUSION_EVASION>ResolvedAccuracyModifier}% {GLOBAL.EvasionConcept.Hyperlink} against {GLOBAL.RangedConcept.Hyperlink} attacks.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@SECRET_SPELLS@06@NAME"
msgstr "Yaka's Feline Infusion"

msgid "DLC@SECRETSOFTHEARCHMAGES@SECRET_SPELLS@06@PROP_DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]{GLOBAL.PROPERTIES.VERY_FAST_MOVEMENT.Hyperlink}[bullet/]+{YAKA'S_FELINE_INFUSION_EVASION>ResolvedAccuracyModifier}% {GLOBAL.EvasionConcept.Hyperlink} against {GLOBAL.RangedConcept.Hyperlink} attacks.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@SECRET_SPELLS@07@DESCRIPTION"
msgstr "Target friendly city is destroyed. Then for each population of the destroyed city:[bulletlist][bullet/]Gain +{amount} {GLOBAL.KnowledgeConcept.Hyperlink}.[bullet/]Gain +{amount2} {GLOBAL.SoulConcept.Hyperlink}.[bullet/]Gain a random Skeleton unit.[bulletlist][bullet/]Each skeleton gained has a small chance of being a {GLOBAL.UNITS.CORRUPT_SOUL.Hyperlink} instead.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@SECRET_SPELLS@07@NAME"
msgstr "Noctus' Mastery"

msgid "DLC@SECRETSOFTHEARCHMAGES@SECRET_SPELLS@08@DESCRIPTION"
msgstr "Heroes in target army:[bulletlist][bullet/]Lose {amountHP} maximum <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[bullet/]Base attacks gain a base {amountChance}% chance of inflicting {GLOBAL.PROPERTIES.GILDED.Hyperlink} for {amountTurn} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Grants +{amount} {GLOBAL.GoldConcept.Hyperlink} per {GLOBAL.WorldMapConcept.Hyperlink} {GLOBAL.TurnConcept}.[/bulletlist][br/]Cannot affect Leaders."

msgid "DLC@SECRETSOFTHEARCHMAGES@SECRET_SPELLS@08@NAME"
msgstr "Ydgaard's Trade"

msgid "DLC@SECRETSOFTHEARCHMAGES@SECRET_SPELLS@08@PROP_DESCRIPTION"
msgstr "Unit:[bulletlist][bullet/]Has {YDGAARDS_TRADE_HP_LOSS>BONUS>HitPoints} maximum <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[bullet/]Base attacks have a base {GILDED_RESISTANCE>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.GILDED.Hyperlink} for {GILDED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Grants +{amount} {GLOBAL.GoldConcept.Hyperlink} per {GLOBAL.WorldMapConcept.Hyperlink} {GLOBAL.TurnConcept}.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@SECRET_SPELLS@09@DESCRIPTION"
msgstr "[bulletlist][bullet/]A random non-hero enemy in target army deserts its ranks.[bullet/]You may acquire it for an additional {GLOBAL.ManaConcept.Hyperlink} cost.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@SECRET_SPELLS@09@NAME"
msgstr "Cinren's Temptation"

msgid "DLC@SECRETSOFTHEARCHMAGES@SECRET_SPELLS@10@DESCRIPTION"
msgstr "Target enemy unit sustains {KARISSA'S_IMMOLATION_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}. If it dies to this damage and is not a hero or {GLOBAL.PROPERTIES.COMBAT_SUMMON.Hyperlink} unit, it turns into an {GLOBAL.UNITS.IMMOLATED_SOUL.Hyperlink} under your control that can be acquired at the end of combat for a {GLOBAL.ManaConcept.Hyperlink} cost."

msgid "DLC@SECRETSOFTHEARCHMAGES@SECRET_SPELLS@10@NAME"
msgstr "Karissa's Immolation"

msgid "DLC@SECRETSOFTHEARCHMAGES@SECRET_SPELLS@11@DESCRIPTION"
msgstr "All <<m:{GLOBAL.ProvinceConcept.Hyperlink}>>:[bulletlist][bullet/]Gain {GLOBAL.FertilePlainsConcept.Hyperlink} and {GLOBAL.ForestConcept.Hyperlink} if on the Surface or {GLOBAL.FungusFieldsConcept.Hyperlink} and {GLOBAL.MushroomForestConcept.Hyperlink} if they are in the Underground.[bullet/]Lose {GLOBAL.ChasmConcept.Hyperlink}, {GLOBAL.SwampConcept.Hyperlink}, {GLOBAL.SnowConcept.Hyperlink}, {GLOBAL.FrozenWasteConcept.Hyperlink}, {GLOBAL.AshlandsConcept.Hyperlink}, {GLOBAL.SandConcept.Hyperlink}, {GLOBAL.CavernFloorConcept.Hyperlink}, {GLOBAL.StalagmitesConcept.Hyperlink}, and {GLOBAL.GloomTerrainConcept.Hyperlink}.[/bulletlist][br/]Additionally, all your <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> with {GLOBAL.FertilePlainsConcept.Hyperlink} or {GLOBAL.ForestConcept.Hyperlink} gain double income."

msgid "DLC@SECRETSOFTHEARCHMAGES@SECRET_SPELLS@11@NAME"
msgstr "Zaethyl's Paradise"

msgid "DLC@SECRETSOFTHEARCHMAGES@SECRET_SPELLS@12@DESCRIPTION"
msgstr "[bulletlist][bullet/]Enemies in a {BHAJIFS_DISRUPTION_TARGETER>AREA>Radius}-hex radius:[bulletlist][bullet/]Become {GLOBAL.PROPERTIES.DISRUPTION_TOOLTIP_PROPERTY.Hyperlink} for {DISRUPTION_DISABLE>Duration} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Become {GLOBAL.PROPERTIES.MANA_DRAINED.Hyperlink} for {MANA_DRAINED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][bullet/]Additionally:[bullet/]All active combat enchantments are dispelled.[bullet/]For the next {BHAJIFS_DISRUPTION_BLOCK_OP>TimeToLive} <<m:{GLOBAL.TurnConcept}>>, <<m:{GLOBAL.CombatSpellConcept}>> cannot be cast.[/bulletlist][/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@SECRET_SPELLS@12@NAME"
msgstr "Bhajif's Disruption"

msgid "DLC@SECRETSOFTHEARCHMAGES@SECRET_SPELLS@12@PROP_DESCRIPTION"
msgstr "Cannot cast combat spells."

msgid "DLC@SECRETSOFTHEARCHMAGES@SECRET_SPELLS@13@DESCRIPTION"
msgstr "Target race is infused with Fallen Angels gaining:[bulletlist][bullet/]The {GLOBAL.PROPERTIES.CELESTIAL.Hyperlink} unit type.[bullet/]{GLOBAL.PROPERTIES.FLYING_MOVEMENT.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.FRENZY.Hyperlink}.[bullet/]Decreased number of units in formation.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@SECRET_SPELLS@13@NAME"
msgstr "Ysariel's Fallen Form"

msgid "DLC@SECRETSOFTHEARCHMAGES@SECRET_SPELLS@13@PROP_DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]The {GLOBAL.PROPERTIES.CELESTIAL.Hyperlink} unit type.[bullet/]{GLOBAL.PROPERTIES.FLYING_MOVEMENT.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.FRENZY.Hyperlink}.[bullet/]Decreased number of units in formation.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@SECRET_SPELLS@14@DESCRIPTION"
msgstr "{GLOBAL.PROPERTIES.ETHEREAL.Hyperlink} and {GLOBAL.PROPERTIES.UNDEAD.Hyperlink} units in a 2-hex radius:[bulletlist][bullet/]Have a {FANFARE_OF_MERCY_RESISTANCE_CHECK>ResolvedStrength}% chance of becoming {GLOBAL.RoutingConcept.Hyperlink}. If resisted, they are {GLOBAL.PROPERTIES.PACIFIED.Hyperlink} for {PACIFICED_STATUS_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>> instead."

msgid "DLC@SECRETSOFTHEARCHMAGES@SECRET_SPELLS@14@NAME"
msgstr "Fanfare of Mercy"

msgid "DLC@SECRETSOFTHEARCHMAGES@SECTORDEFINITIONS_STRATEGIC@BREACHED_PORTAL@GUARDED@DESCRIPTION"
msgstr "This portal is currently closed and cannot be used. It requires a {GLOBAL.HeroConcept.Hyperlink} {GLOBAL.UnitConcept.Hyperlink} to open.[br/]Once opened and bound, it can be teleported into your {GLOBAL.DomainConcept.Hyperlink}."

msgid "DLC@SECRETSOFTHEARCHMAGES@SECTORDEFINITIONS_STRATEGIC@SHROUDED_PORTAL@BOUND@DESCRIPTION"
msgstr "This portal is bound by {BoundByPlayer}.[br/]They can teleport this portal into their {GLOBAL.DomainConcept.Hyperlink} and annex its connecting isle."

msgid "DLC@SECRETSOFTHEARCHMAGES@SECTORDEFINITIONS_STRATEGIC@SHROUDED_PORTAL@GUARDED@DESCRIPTION"
msgstr "This portal is currently guarded by inhabitants and must be cleared before it can be used.[br/]Once opened and bound, it can be teleported to your {GLOBAL.DomainConcept.Hyperlink}."

msgid "DLC@SECRETSOFTHEARCHMAGES@SECTORDEFINITIONS_STRATEGIC@SHROUDED_PORTAL@OPEN@DESCRIPTION"
msgstr "This portal is open and can be freely traveled through.[br/]Once bound, it can be teleported to your {GLOBAL.DomainConcept.Hyperlink} and its connecting Isle can be annexed."

