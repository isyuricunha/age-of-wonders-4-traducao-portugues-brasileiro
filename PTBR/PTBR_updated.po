msgstr "Uma Pescaria é um melhoramento de província básico {GLOBAL.ProvinceImprovementConcept.Hyperlink} com os seguintes benefícios:[bulletlist][bullet/]Fornece renda de {GLOBAL.FoodConcept.Hyperlink}.{LOC.INTERFACE@STRATEGIC_MAP@BASE_IMPROVEMENT_DESCRIPTION}[/bulletlist]"

msgid "INTERFACE@STRATEGIC_MAP@FISHERY_HYPERLINK"
msgstr "[fishery/] [hyperlink,GLOBAL.FisheryConcept]Pescaria[/hyperlink]"

