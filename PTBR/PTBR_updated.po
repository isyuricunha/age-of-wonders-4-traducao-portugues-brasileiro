msgid "DLC@GIANTKINGS@REALM_TRAIT@TSR_SET_03@NAME"
msgstr "Conjunto TSR: Glória de Myrrida (NÃO ENVIAR ISTO)"

msgid "DLC@GIANTKINGS@RELIC@FLOWROCK_CORNUCOPIA@DESCRIPTION"
msgstr "[bulletlist][bullet/]Desbloqueia a produção do {GLOBAL.STRUCTURE_UPGRADES.GIANT_FORUM_SPI.Hyperlink} {GLOBAL.SpecialImprovementConcept.Hyperlink} em sua <<m:{GLOBAL.CityConcept.Hyperlink}>>.[bullet/]O {GLOBAL.STRUCTURE_UPGRADES.GIANT_FORUM_SPI.Hyperlink} recebe os seguintes benefícios:[bulletlist][bullet/]{IntProdBonus} de renda de {GLOBAL.StructureProductionConcept.Hyperlink}.[bullet/]{IntFoodBonus} de {GLOBAL.FoodConcept.Hyperlink} por {GLOBAL.FarmConcept.Hyperlink} ou {GLOBAL.ForesterConcept.Hyperlink} adjacente.[bullet/]Conta como uma {GLOBAL.FarmConcept.Hyperlink} e {GLOBAL.ForesterConcept.Hyperlink} além de seus outros tipos.[/bulletlist][/bulletlist]"

msgid "DLC@GIANTKINGS@RELIC@FLOWROCK_CORNUCOPIA@LORE"
msgstr "“Prometo minha proteção aos sobreviventes[br/]Das garras da Urwilderness[br/]Guiá-los é minha tarefa, alimentá-los, meu dever”"

msgid "DLC@GIANTKINGS@RELIC@FLOWROCK_CORNUCOPIA@NAME"
msgstr "Cornucópia de Flowrock^n"

msgid "DLC@GIANTKINGS@RELIC@FLOWROCK_CREST@DESCRIPTION"
msgstr "[bulletlist][bullet/]Desbloqueia a produção do {GLOBAL.STRUCTURE_UPGRADES.GIANT_FORUM_SPI.Hyperlink} {GLOBAL.SpecialImprovementConcept.Hyperlink} em sua <<m:{GLOBAL.CityConcept.Hyperlink}>>.[bullet/]O {GLOBAL.STRUCTURE_UPGRADES.GIANT_FORUM_SPI.Hyperlink} recebe os seguintes benefícios:[bulletlist][bullet/]{IntProdBonus} de renda de {GLOBAL.StructureProductionConcept.Hyperlink}.[bullet/]{IntGoldBonus} de {GLOBAL.GoldConcept.Hyperlink} por {GLOBAL.MineConcept.Hyperlink} ou {GLOBAL.QuarryConcept.Hyperlink} adjacente.[bullet/]Conta como uma {GLOBAL.MineConcept.Hyperlink} além de seus outros tipos.[/bulletlist][/bulletlist]"

msgid "DLC@GIANTKINGS@RELIC@FLOWROCK_CREST@LORE"
msgstr "“O abrigo que esculpo carrega o peso da civilização[br/]Devo construir grandioso e devo construir firme[br/]Na riqueza todos habitam quem entram em meus salões”"

msgid "DLC@GIANTKINGS@RELIC@FLOWROCK_CREST@NAME"
msgstr "Crista de Flowrock^n"

msgid "DLC@GIANTKINGS@RELIC@FLOWROCK_SCALES@DESCRIPTION"
msgstr "[bulletlist][bullet/]Desbloqueia a produção do {GLOBAL.STRUCTURE_UPGRADES.GIANT_FORUM_SPI.Hyperlink} {GLOBAL.SpecialImprovementConcept.Hyperlink} em sua <<m:{GLOBAL.CityConcept.Hyperlink}>>.[bullet/]O {GLOBAL.STRUCTURE_UPGRADES.GIANT_FORUM_SPI.Hyperlink} recebe os seguintes benefícios:[bulletlist][bullet/]{IntProdBonus} de renda de {GLOBAL.StructureProductionConcept.Hyperlink}.[bullet/]{IntKnowledgeBonus} de {GLOBAL.KnowledgeConcept.Hyperlink} por {GLOBAL.ConduitConcept.Hyperlink} ou {GLOBAL.ResearchPostConcept.Hyperlink} adjacente.[bullet/]Conta como um {GLOBAL.ConduitConcept.Hyperlink} e {GLOBAL.ResearchPostConcept.Hyperlink} além de seus outros tipos.[/bulletlist][/bulletlist]"

msgid "DLC@GIANTKINGS@RELIC@FLOWROCK_SCALES@LORE"
msgstr "“Onde a igualdade reina entre as raças, grandes e pequenas[br/]Com sabedoria devo forjar e martelar a lei[br/]Tudo isso eu juro pelo sangue de Gudfjalla[br/]Deixem os Titãs serem os juízes deste Rei Gigante”"

msgid "DLC@GIANTKINGS@RELIC@FLOWROCK_SCALES@NAME"
