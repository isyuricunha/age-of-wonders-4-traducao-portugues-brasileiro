msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@GRAND_STATUARY@DESCRIPTION"
msgstr "<<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacentes a este Marco ganham:[bulletlist][bullet/]{income}.[bullet/] Um [researchpost/] Posto de Pesquisa nesta província concede {income2}.[/bulletlist][br/]Uma {GLOBAL.CityConcept.Hyperlink} com {amount} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacentes a este Marco ganham:[bulletlist][bullet/]O {GLOBAL.GovernorConcept.Hyperlink} da Cidade ganha {renown} {GLOBAL.RenownConcept.Hyperlink} a cada {GLOBAL.TurnConcept.Hyperlink}.[bullet/]<<m:{GLOBAL.UnitConcept.Hyperlink}>> recrutados na Cidade ganham {rankbonus} Rank inicial.[/bulletlist]"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@GRAND_STATUARY@LORE"
msgstr "\"Quando caminho entre essas estátuas desgastadas pelo tempo, pondero sobre as almas que elas imortalizam. Mesmo aquelas cujos nomes foram esquecidos comandam meu respeito. Serei eu também, lembrado — ou esquecido — como este? Ofertas irão graçar minha semelhança de pedra, ou será abandonada ao tempo? Se meus traços fossem esculpidos em pedra, se tornariam um farol de esperança — ou de temor?\"[br/][br/]— Alfred Elderstone, Reflexões sobre o Governo"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@GRAND_STATUARY@NAME"
