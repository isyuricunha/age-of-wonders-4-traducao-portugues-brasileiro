msgid "TOME_GREAT_TRANSFORMATION@SKILL4@DISPLAY_DESCRIPTION"
msgstr "[bulletlist][bullet/]Unidades {GLOBAL.PROPERTIES.UNDEAD.Hyperlink} amigáveis no domínio causam +{damage}% de dano.[bullet/]Unidades inimigas no domínio se tornam {GLOBAL.PROPERTIES.SOULBOUND.Hyperlink}.[/bulletlist]"

msgid "TOME_GREAT_TRANSFORMATION@SKILL4@NAME"
msgstr "Domínio da Morte"

msgid "TOME_GREAT_TRANSFORMATION@SKILL4@PROPERTY@DESCRIPTION"
msgstr "Esta unidade causa +{amount}% de dano."

msgid "TOME_GREAT_TRANSFORMATION@SKILL5@DESCRIPTION"
