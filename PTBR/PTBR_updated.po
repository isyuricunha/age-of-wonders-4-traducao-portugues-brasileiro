msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@DESECRATION@SKILL09@NAME"
msgstr "Angústia do Vínculo da Alma"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@DESECRATION@SKILL13@ABILITY_DESCRIPTION"
msgstr "Unidade inimiga alvo:[bulletlist][bullet/]Sofre dano.[bullet/]Ganha {amount} {GLOBAL.PROPERTIES.POISONED.Hyperlink} por {POISONED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Ganha {amount2} {GLOBAL.PROPERTIES.DECAYING.Hyperlink} por {DECAYING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@DESECRATION@SKILL13@NAME"
msgstr "Espinha Purulenta"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@DESECRATION@SKILL15@DESCRIPTION"
msgstr "Quando {GLOBAL.PROPERTIES.FESTERING_SPINE.Hyperlink} mata uma unidade, todas as unidades inimigas em um raio de hexágonos {MIASMIC_SPINE_TARGETER>AREA>Radius} ganham {amount} {GLOBAL.PROPERTIES.POISONED.Hyperlink} e {amount2} {GLOBAL.PROPERTIES.DECAYING.Hyperlink} por {DECAYING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@DESECRATION@SKILL15@MOD_DESCRIPTION"
msgstr "Ao matar, todas as unidades inimigas em um raio de hexágonos {MIASMIC_SPINE_TARGETER>AREA>Radius} ganham {amount} {GLOBAL.PROPERTIES.POISONED.Hyperlink} e {amount2} {GLOBAL.PROPERTIES.DECAYING.Hyperlink} por {DECAYING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@DESECRATION@SKILL15@NAME"
msgstr "Espinha Miasmática"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@NIGHTLORD@DESCRIPTION"
msgstr "[bulletlist][bullet/]A unidade é imune a {GLOBAL.PROPERTIES.BLINDED.Hyperlink}.[bullet/]Enquanto em Sem Sol, Subterrâneo ou Penumbra, esta unidade tem:[bulletlist][bullet/]+{amount}% de dano.[bullet/]{GLOBAL.PROPERTIES.NATURAL_REGENERATION_GROUP.Hyperlink}.[/bulletlist][/bulletlist]"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@NIGHTLORD@NAME"
msgstr "Senhor da Noite"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@NIGHTSWORN@NAME"
msgstr "Juramentado da Noite"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@NIGHTSWORN@PASSIVE_DESCRIPTION"
msgstr "No início do combate, conjura um {GLOBAL.UNITS.DOOM_BAT.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@NIGHTSWORN@PASSIVE_NAME"
msgstr "Criatura da Noite"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@REAPER@DESCRIPTION"
msgstr "Ao matar:[bulletlist][bullet/]Os cooldowns ativos são reduzidos em {REAPER_COOLDOWN_EFFECT>Amount of Turns} {GLOBAL.TurnConcept}.[bullet/]Ganha +{REAPER_STAT>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>> para a luta.[/bulletlist][br/]Dispara uma vez por turno."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@REAPER@NAME"
msgstr "Ceifador"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@REAPER@PROP_DESCRIPTION"
msgstr "A unidade tem +{REAPER_STAT>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>> por pilha."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@SHARED_UPKEEP_01@DESCRIPTION"
msgstr "O custo de manutenção aumenta em {VAMPIRE_LORD_UPKEEP>FlatUpkeep} {GLOBAL.GoldConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@SHARED_UPKEEP_01@NAME"
msgstr "Custo de Manutenção Aumentado"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@SPREADING_BLIGHT@ABILITY_DESCRIPTION"
msgstr "Unidade inimiga alvo e {SPREADING_BLIGHT_JUMP_TARGETER>MaxJumps} outras dentro de {SPREADING_BLIGHT_JUMP_TARGETER>MaxDistance} hexágonos:[bulletlist][bullet/]Sofrem dano.[bullet/]Ganham {amount} {GLOBAL.PROPERTIES.BLOOD_PARASITE.Hyperlink} por {BLOOD_PARASITE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@SPREADING_BLIGHT@DESCRIPTION"
msgstr "{GLOBAL.PROPERTIES.BLOODBLIGHT.Hyperlink} agora se espalha para {SPREADING_BLIGHT_JUMP_TARGETER>MaxJumps} unidades inimigas dentro de {SPREADING_BLIGHT_JUMP_TARGETER>MaxDistance} hexágonos."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@SPREADING_BLIGHT@NAME"
msgstr "Praga Propagadora"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@TYRANNY@SKILL01@ABILITY_DESCRIPTION"
msgstr "Unidade inimiga alvo:[bulletlist][bullet/]Ganha {TORMENT_REPEATER>Count} {GLOBAL.PROPERTIES.TORMENT.Hyperlink} até o final do combate.[bullet/]Ganha {GLOBAL.PROPERTIES.STATUS_VULNERABILITY.Hyperlink} por {STATUS_VULNERABILITY_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Perde {DREAD_MORALE_DAMAGE>Morale Change Absolute} {GLOBAL.UnitMoraleConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@TYRANNY@SKILL01@ABILITY_NAME"
msgstr "Pavor"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@TYRANNY@SKILL01@NAME"
msgstr "Terrível"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@TYRANNY@SKILL01@PASSIVE_DESCRIPTION"
msgstr "Ataques causam perda de {TYRANT_MORALE_CHANGE>Morale Change Absolute} {GLOBAL.UnitMoraleConcept.Hyperlink} no alvo. Dobrado para ataques de Tiro Único."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@TYRANNY@SKILL01@PASSIVE_MOD_DESCRIPTION"
msgstr "Inflige perda de {TYRANT_MORALE_CHANGE>Morale Change Absolute} {GLOBAL.UnitMoraleConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@TYRANNY@SKILL01@PASSIVE_NAME"
msgstr "Tirano"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@TYRANNY@SKILL13@ABILITY_DESCRIPTION"
msgstr "Unidades inimigas dentro de um raio de {TORMENTING_MIST_TARGETER>AREA>Radius} hexágonos:[bulletlist][bullet/]Sofrem dano.[bullet/]Perdem {TORMENTING_MIST_MORALE_LOSS>Morale Change Absolute} {GLOBAL.UnitMoraleConcept.Hyperlink}.[bullet/]Ganham {TORMENT_REPEATER>Count} pilhas de {GLOBAL.PROPERTIES.TORMENT.Hyperlink} até o final do combate.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@TYRANNY@SKILL13@NAME"
msgstr "Névoa de Tormento"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@TYRANNY@SKILL14@ABILITY_DESCRIPTION"
msgstr "No final do turno, inimigos adjacentes:[bulletlist][bullet/]Sofrem {AURA_OF_TORMENT_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Perdem {TORMENTING_MIST_MORALE_LOSS>Morale Change Absolute} {GLOBAL.UnitMoraleConcept.Hyperlink}.[bullet/]Ganham {TORMENT_REPEATER>Count} {GLOBAL.PROPERTIES.TORMENT.Hyperlink} até o final do combate.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@TYRANNY@SKILL14@NAME"
msgstr "Aura de Tormento"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@VAMPIRIC_RAGE@DESCRIPTION"
msgstr "O dano aumenta conforme os <<m:{GLOBAL.HitPointConcept.Hyperlink}>> diminuem, até {VAMPIRE_RAGE_MULT>ResolvedMultiplier}% com {amount} {GLOBAL.HitPointConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@VAMPIRIC_RAGE@NAME"
msgstr "Fúria Vampírica"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@VIOLENT_EXSANGUINATION@ABILITY_DESCRIPTION"
msgstr "Alvo:[bulletlist][bullet/]Sofre dano que ignora {EXSANGUINATE_DEFENSE_BYPASS>MODIFIERS>ResolvedArmor}% de {GLOBAL.DefenseConcept.Hyperlink} e {GLOBAL.ResistanceConcept.Hyperlink}.[bullet/]Ganha {amount} {GLOBAL.PROPERTIES.BLEEDING.Hyperlink} por {BLEEDING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][bulletlist][br/]Inimigos adjacentes sofrem {VIOLENT_EXSANGUINATION_TARGETER>ResolvedEffectMultiplier}% do dano que ignora {EXSANGUINATE_DEFENSE_BYPASS>MODIFIERS>ResolvedArmor}% de {GLOBAL.DefenseConcept.Hyperlink} e {GLOBAL.ResistanceConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@SPAWNERS@PROCESSION"
msgstr "Procissão Profana"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1142_933@BODY"
msgstr "A lua sangra através de uma ferida aberta, manchando o céu de carmesim. Animais fogem para se esconder, aldeões trancam suas portas e as criaturas do anoitecer se alegram com seu brilho. Pois a noite é vermelha e governada por horrors."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1142_933@BODY_FOOTER"
msgstr "Durante seu eclipse, a Lua de Sangue fortalece todos os [hyperlink,GLOBAL.VampireLordConcept]Vampiros[/hyperlink] e permite que eles vagueiem livremente pelo mundo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1142_933@BODY_FOOTER@NO_AI_LORDS"
msgstr "Esta é a Lua de Sangue"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1142_933@BODY_HEADER"
msgstr "O céu escurece para escarlate. A Lua de Sangue, convocada por {BloodMoonPlayer}, eclipsa a luz do sol."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1142_933@BODY_HEADER@PLAYER_IS_CASTER"
msgstr "O céu escurece para escarlate. A Lua de Sangue que você convocou eclipsa a luz do sol."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1142_933@BODY_LORE@NO_AI_LORDS"
msgstr "Esta é a Lua de Sangue"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1142_933@BUTTON_0"
msgstr "Prepare-se para a noite vermelha."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1142_933@HAPPENING_HEADER"
msgstr "O céu escurece para escarlate. A Lua de Sangue eclipsa a luz do sol."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1142_933@TITLE"
msgstr "Lua de Sangue"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1249@BODY_FOOTER"
msgstr "De que poço carmesim você saciará sua sede? De quem o sangue satisfará seu desejo?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1249@BODY_HEADER"
msgstr "Suas presas coçam. Lampejos de vermelho turvam sua visão. Seu corpo anseia por sangue. Você não pode mais suprimir seus desejos profanos."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1249@BODY_LORE"
msgstr "Você sente os batimentos cardíacos dos mortais que o cercam. {EventRace.Name}. Animais. Seus tenentes confiáveis e seus prisioneiros de guerra. Você tenta afastar o desejo. Não é digno de um <<PlayerLeader{lord/lady}>> de sua posição, afinal. Mas a sede de sangue cresce implacavelmente até que os rugidos de sua fome afoguem todos os outros sons. Sangue. Você deve beber sangue."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1249@BUTTON_0"
msgstr "\"Ninguém sentirá falta de algumas {EventRace} [souls/] de {EventCity}. [happiness/]\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1249@BUTTON_1"
msgstr "\"<<Co:EventHero>> é fraco de qualquer forma. O sangue de {EventHero} me revigorará.\" [xp/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1249@BUTTON_2"
msgstr "\"Vou me banquetear com gado.\" [food/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1249@BUTTON_3"
msgstr "Beba o sangue [souls/] de um homem morto, apesar de seus efeitos nocivos. [hp/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1249@BUTTON_4"
msgstr "Devore seus escravos [thralls/] para acalmar a fome."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1249@BUTTON_5"
msgstr "Consuma {EventHeroB}, acorrentado em sua prisão."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1249@TITLE"
msgstr "O Desejo"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1255@BODY_FOOTER"
msgstr "O acampamento do Caçador de Vampiros e do séquito de <<o:EventStackLeader>> está localizado {EventDirection} de {EventCity}. Derrote <<P:EventStackLeader>>, para que não o ataquem."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1255@BODY_HEADER"
msgstr "Algo se agita em seu domínio. Seus súditos sussurram sobre um Caçador de Vampiros que veio para acabar com seu reinado."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1255@BODY_LORE"
msgstr "Ninguém menos que {EventStackLeader}, renomado Matador de <<m:{GLOBAL.ElderVampireLoreConcept.Hyperlink}>>, montou acampamento perto de suas fronteiras. <<Cp:EventStackLeader>> certamente planeja uma incursão para cravar uma estaca em seu coração. Serendipitamente, o Caçador de Vampiros ainda não localizou seu território envolto em sombras, mas isso é provavelmente uma questão de tempo. <<Co:EventStackLeader>> desorientação passageira apresenta a você uma oportunidade de caçar o Caçador."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1255@BUTTON_0"
msgstr "Perseguir o Caçador de Vampiros. Sede pelo sangue de <<o:EventStackLeader>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1255@BUTTON_1"
msgstr "Eu invoco [thralls/] a própria noite [shadowboon/] para engolir o Caçador inteiro."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1255@BUTTON_2"
msgstr "Envie batedores [unitprod/] para afastá-los de {EventCity}. [happiness/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1255@BUTTON_3"
msgstr "Ignore o Caçador de Vampiros e espere que <<p:EventStackLeader>> nunca encontre seu domínio."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1255@TITLE"
msgstr "{EventStackLeader.FirstName}, o Caçador de Vampiros"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1256@BODY_FOOTER"
msgstr "O {EventItem} que você guarda para si mesmo: para usar ou desmantelar. Mas o que você fará com {EventStackLeader}?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1256@BODY_HEADER"
msgstr "Seu exército destruiu os guarda-costas do Caçador de Vampiros. {EventStackLeader} está derrotado, à beira da morte."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1256@BODY_LORE"
msgstr "\"Continue então,\" {EventStackLeader.FirstName} gorgoleja logo antes de <<p:EventStackLeader>> cuspir sangue. \"Acabe com minha vida. Eu não temo a morte.\" Você se diverte com a ideia de matar o Caçador. Mas há usos melhores para <<P:EventStackLeader>>. Suas tropas saqueiam o acampamento e encontram vários itens mágicos usados para matar vampiros. Mais notavelmente, um {EventItem} guardado em um saco de aniagem."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1256@BUTTON_0"
msgstr "Pregue <<G:corpo ainda vivo^n,EventStackLeader>> nos portões de {EventCity}. [happiness/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1256@BUTTON_1"
msgstr "Abrace [unitHero/] {EventStackLeader}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1256@BUTTON_4"
msgstr "Deixe {EventHero} se alimentar [xp/] de <<P:EventStackLeader>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1256@BUTTON_5"
msgstr "Colha as almas [souls/] do Caçador e do séquito de <<o:EventStackLeader>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1256@TITLE"
msgstr "{EventStackLeader.FirstName}, o Caçador de Vampiros: Desfecho"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1262@BODY_FOOTER"
msgstr "O {EnemyUnit}, tão cego quanto <<o:EnemyUnit>> morcegos, avança em sua direção de forma ameaçadora. <<Co:EnemyUnit>> <<m:EventUnit>> sedentos de sangue seguem o exemplo. Como {EventHero.FirstName} procederá?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1262@BODY_FOOTER@HERO_IS_PLAYELEA"
msgstr "O {EnemyUnit}, tão cego quanto <<o:EnemyUnit>> morcegos, avança em sua direção de forma ameaçadora. <<Co:EnemyUnit>> <<m:EventUnit>> sedentos de sangue seguem o exemplo. Como você procederá?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1262@BODY_HEADER"
msgstr "{EventHero} desce na escuridão da {EventStructure} e é recebido por gritos agudos ricocheteando nas paredes da caverna."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1262@BODY_HEADER@HERO_IS_PLAYELEA"
msgstr "Você entra na escuridão da {EventStructure} e é recebido por gritos agudos que ecoam pelas paredes da caverna."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1262@BODY_LORE"
msgstr "<<m:EventUnit>>, criados por um {EnemyUnit} desvairado, são a fonte dos gritos. Seu horrorizado {GLOBAL.HeroConcept.Hyperlink} testemunha como o {EnemyUnit} oferece os braços de <<o:EnemyUnit>> para os <<m:EventUnit>>, que bebem o sangue de <<o:EnemyUnit>> de bom grado. \"Bebam, meus pets\", <<p:EnemyUnit>> grita em agonia. \"Bebam e logo serei um {GLOBAL.ElderVampireLoreConcept.Hyperlink}!\" <<Cp:EnemyUnit>> então percebe a presença de suas tropas e retira o braço de <<o:EnemyUnit>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1262@BODY_LORE@HERO_IS_PLAYELEA"
msgstr "<<m:EventUnit>>, criados por um {EnemyUnit} desvairado, são a fonte dos gritos. Você testemunha horrorizado como o {EnemyUnit} oferece os braços de <<o:EnemyUnit>> para os <<m:EventUnit>>, que bebem o sangue de <<o:EnemyUnit>> de bom grado. \"Bebam, meus pets\", <<p:EnemyUnit>> grita em agonia. \"Bebam e logo serei um {GLOBAL.ElderVampireLoreConcept.Hyperlink}!\" <<Cp:EnemyUnit>> então percebe sua presença e retira o braço de <<o:EnemyUnit>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1262@BUTTON_0"
msgstr "Corte as asas dos morcegos! Ataque!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1262@BUTTON_1"
msgstr "Confunda os morcegos com o barulho das ferramentas dos trabalhadores [structureprod/] de {EventCity}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1262@BUTTON_2"
msgstr "Transforme as paredes da caverna para amortecer sua acústica."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1262@BUTTON_3"
msgstr "Revele todo o seu poder vampírico [thralls/] para intimidar o {EnemyUnit}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1262@TITLE"
msgstr "Ecos da Insanidade"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1265@BUTTON_4"
msgstr "Fuja da caverna dos morcegos."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1266@BODY_FOOTER"
msgstr "Após copiar as notas de pesquisa, o que mais {EventHero} levará da {EventStructure} limpa?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1266@BODY_HEADER"
msgstr "Os gritos ensurdecedores que ecoavam pela {EventStructure} são silenciados. Sangue inunda o chão da caverna coberto de guano."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1266@BODY_LORE"
msgstr "Alguns dos filhotes de {EventUnit} foram poupados do massacre. {EventHero.FirstName} logo descobre que os delírios do {EnemyUnit} eram mais profundos do que se pensava anteriormente. Tomos empoeirados e rabiscos nas paredes descrevem rituais e processos relacionados ao vampirismo e à anatomia de morcegos. Embora a noção de <<m:EventUnit>> transformando mortais em <<m:{GLOBAL.ElderVampireLoreConcept.Hyperlink}>> continue absurda, os experimentos podem render insights valiosos."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1266@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Alguns dos filhotes de {EventUnit} foram poupados do massacre. Você descobre que os delírios do {EnemyUnit} eram mais profundos do que você pensava. Tomos empoeirados e rabiscos nas paredes descrevem rituais e processos relacionados ao vampirismo e à anatomia de morcegos. Embora a noção de <<m:EventUnit>> transformando mortais em <<m:{GLOBAL.ElderVampireLoreConcept.Hyperlink}>> continue absurda, os experimentos podem render insights valiosos."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1266@BUTTON_0"
msgstr "Raspe as fezes de morcego do chão para fertilizar seus campos. [food/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1266@BUTTON_1"
msgstr "Crie um {EventUnit} [unit/] para lutar por você."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1266@BUTTON_2"
msgstr "Monte uma {EventMount} [item/] para voar para a batalha."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1266@TITLE"
msgstr "Ecos da Insanidade: Consequências"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1267@BODY_FOOTER"
msgstr "Os <<m:EventUnit>>, liderados por um {EnemyUnit}, não deixarão {EventHero.FirstName} se aproximar da bela adormecida. Como <<p:EventHero>> responde?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1267@BODY_FOOTER@HERO_IS_PLAYELEA"
msgstr "Os <<m:EventUnit>>, liderados por um {EnemyUnit}, não deixarão você se aproximar da bela adormecida. Como você responde?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1267@BODY_HEADER"
msgstr "{EventHero} lidera <<o:EventHero>> exército para o pátio silencioso de um antigo palácio. O pátio está coberto por roseiras."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1267@BODY_HEADER@HERO_IS_PLAYELEA"
msgstr "Você lidera seu exército para o pátio silencioso de um antigo palácio. O pátio está coberto por roseiras."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1267@BODY_LORE"
msgstr "Na extremidade distante do pátio, uma bela <<EventHero{mulher/homem}>> está imóvel em uma cama de pedra. Uma roda de fiar decomposta está próxima, seu fuso manchado de sangue tão vermelho quanto as rosas que cobrem o pátio. {EventHero.FirstName} nota os restos de <<m:EventUnit>> sob as roseiras, com espinhos fundidos aos seus ossos. Quando <<p:EventHero>> dá um passo à frente, os mortos se levantam."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1267@BODY_LORE@HERO_IS_PLAYELEA"
msgstr "Na extremidade distante do pátio, uma bela <<EventHero{mulher/homem}>> está imóvel em uma cama de pedra. Uma roda de fiar decomposta está próxima, seu fuso manchado de sangue tão vermelho quanto as rosas que cobrem o pátio. Você nota os restos de <<m:EventUnit>> sob as roseiras, com espinhos fundidos aos seus ossos. Quando você dá um passo à frente, os mortos se levantam."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1267@BUTTON_0"
msgstr "Ataque o {EnemyUnit} para salvar a bela adormecida."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1267@BUTTON_1"
msgstr "Antes de atacar, incendeie os arbustos de rosas com um simples feitiço. [mana/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1267@BUTTON_2"
msgstr "Manipule as rosas. Faça-as perderem seus espinhos."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1267@BUTTON_3"
msgstr "Invocar ventos frios para murchar os espinheiros na {EventStructure}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1267@BUTTON_4"
msgstr "Deixe a beleza dormir e saia da {EventStructure}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1267@TITLE"
msgstr "<<EventHero{Rose/Thorne}>> de <<EventHero{Thorns/Roses}>>"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1268@BODY_FOOTER"
msgstr "A maldição está quebrada. A magia da {EventStructure} enfraquece e os espinheiros desmoronam. Antes de partir, que troféu {EventHero} reivindicará?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1268@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "A maldição está quebrada. A magia da {EventStructure} enfraquece e os espinheiros desmoronam. Antes de partir, que troféu você reivindicará?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1268@BODY_HEADER"
msgstr "Com o {EnemyUnit} reduzido a ossos e armadura espinhosos, {EventHero} se aproxima da bela adormecida na cama de pedra."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1268@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Com o {EnemyUnit} reduzido a ossos e armadura espinhosos, você se aproxima da bela adormecida na cama de pedra."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1268@BODY_LORE"
msgstr "<<Cp:EventHero>> inclina-se para verificar se a adormecida ainda vive. Quando <<G:o hálito^n,EventHero>> toca <<EventHeroB{os lábios do homem/os lábios da mulher}>>, <<p:EventHeroB>> abre <<o:EventHeroB>> olhos e ofega. \"Saudações, Herói,\" <<p:EventHeroB>> suspira. \"Fui amaldiçoado por uma bruxa, com ciúmes da minha juventude e habilidade. Eu sou {EventHeroB}.\" <<Cp:EventHeroB>> olha ao redor. \"Este é o castelo do meu pai? Parece... que eu dormi por muito tempo.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1268@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Você se inclina para verificar se a adormecida ainda vive. Quando seu hálito toca <<EventHeroB{os lábios do homem/os lábios da mulher}>>, <<p:EventHeroB>> abre <<o:EventHeroB>> olhos e ofega. \"Saudações, Herói,\" <<p:EventHeroB>> suspira. \"Fui amaldiçoado por uma bruxa, com ciúmes da minha juventude e habilidade. Eu sou {EventHeroB}.\" <<Cp:EventHeroB>> olha ao redor. \"Este é o castelo do meu pai? Parece... que eu dormi por muito tempo.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1268@BUTTON_0"
msgstr "Recrutar [unitHero/] {EventHeroB}, agora despertado."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1268@BUTTON_2"
msgstr "Deixe seus estudiosos cronificarem [knowledge/] <<G:memórias^p,EventHeroB>> de outrora."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1268@BUTTON_3"
msgstr "Deixe {EventHeroB.FirstName} ir. Pegue o <<G:{EventItem},EnemyUnit>>. [item/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1268@BUTTON_4"
msgstr "Colher o poder mágico remanescente [mana/] da {EventStructure}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1268@TITLE"
msgstr "<<EventHero{Rose/Thorne}>> de <<EventHero{Thorns/Roses}>>: Consequências"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1286@BODY_FOOTER"
msgstr "\"Meu marido adúltero morreu antes de receber punição, mas meu desprezo será sofrido.\" <<G:um grito repentino^n,{EnemyUnit.FirstName}>> destrói a estátua, antes que <<p:EnemyUnit>> se lance sobre {EventHero.FirstName}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1286@BODY_FOOTER@HERO_IS_PLAYELEA"
msgstr "\"Meu marido adúltero morreu antes de receber punição, mas meu desprezo será sofrido.\" <<G:um grito repentino^n,{EnemyUnit.FirstName}>> destrói a estátua, antes que <<p:EnemyUnit>> se lance sobre você."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1286@BODY_HEADER"
msgstr "{EventHero} entra no pátio de um palácio antigo e esquecido. Uma mulher está chorando diante da estátua de um rei."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1286@BODY_HEADER@HERO_IS_PLAYELEA"
msgstr "Você entra no pátio de um palácio antigo e esquecido. Uma mulher está chorando diante da estátua de um rei."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1286@BODY_LORE"
msgstr "A estátua está profanada com sangue. Arranhões, como se feitos por unhas, correm sobre os olhos do homem. A mulher chorosa vira <<o:EnemyUnit>> cabeça quando <<p:EnemyUnit>> ouve <<G:o exército^n,EventHero>> se aproximar. \"Você veio para zombar da Rainha Banshee,\" <<p:EnemyUnit>> chora. \"Pobre {EnemyUnit.FirstName}, traída por <<o:EnemyUnit>> marido, aquele Rei dos Trapaceiros.\" <<Cp:EnemyUnit>> mostra <<o:EnemyUnit>> presas enquanto <<m:EventUnit>> aparecem ao redor de <<P:EnemyUnit>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1286@BODY_LORE@HERO_IS_PLAYELEA"
msgstr "A estátua está profanada com sangue. Arranhões, como se feitos por unhas, correm sobre os olhos do homem. A mulher chorosa vira <<o:EnemyUnit>> cabeça quando <<p:EnemyUnit>> ouve seu exército se aproximar. \"Você veio para zombar da Rainha Banshee,\" <<p:EnemyUnit>> chora. \"Pobre {EnemyUnit.FirstName}, traída por <<o:EnemyUnit>> marido, aquele Rei dos Trapaceiros.\" <<Cp:EnemyUnit>> mostra <<o:EnemyUnit>> presas enquanto <<m:EventUnit>> aparecem ao redor de <<P:EnemyUnit>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1286@BUTTON_0"
msgstr "\"Hora de silenciar a Rainha Banshee. Ataque!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1286@BUTTON_1"
msgstr "Uma recompensa [gold/] para quem me trouxer <<g:a cabeça^n,{EnemyUnit.FirstName}>>!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1286@BUTTON_2"
msgstr "Conjurar uma visão de <<G:cônjuge adúltero^n,{EnemyUnit.FirstName}>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1286@BUTTON_3"
msgstr "Disfarçar-se como <<G:marido morto^n,{EnemyUnit.FirstName}>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1286@BUTTON_4"
msgstr "Fuja da {EventStructure} e <<G:scorn^n,{EnemyUnit.FirstName}>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1286@HERO@FIRSTNAME"
msgstr "Mayv^F"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1286@TITLE"
msgstr "Rainha das Banshees"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1287@BODY_FOOTER"
msgstr "Ansioso para deixar as tragédias sombrias da {EventStructure} para trás, <<P:EventHero>>, que lembrança {EventHero.FirstName} levará do palácio?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1287@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Ansioso para deixar as tragédias sombrias da {EventStructure} para trás, que lembrança você levará do palácio?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1287@BODY_HEADER"
msgstr "A Rainha das Banshees jaz aos pés de <<G:feet^p,EventHero>>. Seu coração agora em paz. Seu lamento finalmente cessou."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1287@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "A Rainha das Banshees jaz aos seus pés. Seu coração agora em paz. Seu lamento finalmente cessou."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1287@BODY_LORE"
msgstr "Os poucos <<m:EventUnit>> que restam se espalham para se esconder nos cantos mais escuros da {EventStructure}. Eles foram atraídos por <<G:scorn^n,{EnemyUnit.FirstName}>> séculos atrás e a tinham enlouquecido. Quando {EventHero} examina as câmaras opulentas do palácio em busca de tesouros e antiguidades, <<p:EventHero>> descobre os corpos decompostos de servos. Suas gargantas estão marcadas por cortes longos e profundos feitos por garras. Ou unhas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1287@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Os poucos <<m:EventUnit>> que restam se espalham para se esconder nos cantos mais escuros da {EventStructure}. Eles foram atraídos por <<G:scorn^n,{EnemyUnit.FirstName}>> séculos atrás e a tinham enlouquecido. Quando você examina as câmaras opulentas do palácio em busca de tesouros e antiguidades, você descobre os corpos decompostos de servos. Suas gargantas estão marcadas por cortes longos e profundos feitos por garras. Ou unhas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1287@BUTTON_0"
msgstr "Restaurar a estátua do marido [influence/] para ser colocada em sua corte."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1287@BUTTON_2"
msgstr "Vincular um dos <<m:EventUnit>> errantes para se juntar [unit/] ao seu exército."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1287@BUTTON_3"
msgstr "Extrair as almas dormentes [souls/] que permanecem na {EventStructure}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1287@BUTTON_4"
msgstr "Dê à Rainha das Banshees um enterro adequado. [goodact/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1287@TITLE"
msgstr "Rainha das Banshees: Consequências"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1288@BODY_FOOTER"
msgstr "Um {EnemyUnit} percebe {EventHero.FirstName} espiando. Todos os Vampiros, sóbrios em um instante, viram-se para enfrentar <<P:EventHero>>, prontos para atacar."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1288@BODY_FOOTER@HERO_IS_PLAYELEA"
msgstr "Um {EnemyUnit} percebe você espiando. Todos os Vampiros, sóbrios em um instante, viram-se para enfrentar você, prontos para atacar."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1288@BODY_HEADER"
msgstr "Enquanto prepara <<o:EventHero>> exército para explorar uma {EventStructure}, aparentemente abandonada e coberta de vegetação, {EventHero} ouve música."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1288@BODY_HEADER@HERO_IS_PLAYELEA"
msgstr "Enquanto prepara seu exército para explorar uma {EventStructure}, aparentemente abandonada e coberta de vegetação, você ouve música."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1288@BODY_LORE"
msgstr "Olhando através de altas janelas de vidro manchado de vermelho, {EventHero.FirstName} descobre uma coven de Vampiros festeando no pátio do palácio. Eles enchem taças de vinho com o sangue de mortais amarrados, pendurados de cabeça para baixo e alimentados à força com cerveja. Os Vampiros intoxicados se deleitam na luz que entra no pátio através das janelas de vidro manchado de vermelho e brindam à Lua de Sangue e à supremacia de sua espécie."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1288@BODY_LORE@HERO_IS_PLAYELEA"
msgstr "Olhando através de altas janelas de vidro manchado de vermelho, você descobre uma coven de Vampiros festeando no pátio do palácio. Eles enchem taças de vinho com o sangue de mortais amarrados, pendurados de cabeça para baixo e alimentados à força com cerveja. Os Vampiros intoxicados se deleitam na luz que entra no pátio através das janelas de vidro manchado de vermelho e brindam à Lua de Sangue e à supremacia de sua espécie."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1288@BUTTON_0"
msgstr "Avançar para o pátio para matar os Vampiros."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1288@BUTTON_1"
msgstr "Use sua piedade para purificar a luz terrível."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1288@BUTTON_2"
msgstr "Quebrar o vidro manchado de vermelho das janelas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1288@BUTTON_3"
msgstr "Declarar sua posição [thralls/] como {PlayerLeader.Title} para estabelecer dominância."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1288@BUTTON_4"
msgstr "Fugir antes que os Vampiros o confrontem."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1288@TITLE"
msgstr "Banquete da Lua de Sangue"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1289@BODY_FOOTER"
msgstr "Os <<m:EventUnit>> resgatados estão ansiosos para servir a você em batalha. Antes que {EventHero} parta, qual será o propósito dos estoques da {EventStructure}?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1289@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Os <<m:EventUnit>> resgatados estão ansiosos para servir a você em batalha. Antes de partir, qual será o propósito dos estoques da {EventStructure}?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1289@BODY_HEADER"
msgstr "Depois de destruir as festividades dos Vampiros, {EventHero} libera seus prisioneiros drenados de sangue. Entre eles estão <<m:EventUnit>> da sua {EventRace}!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1289@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Depois de destruir as festividades dos Vampiros, você libera seus prisioneiros drenados de sangue. Entre eles estão <<m:EventUnit>> da sua {EventRace}!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1289@BODY_LORE"
msgstr "\"Louvado seja nosso {PlayerLeader.Title}\", suspira o {EventUnit} menos drenado. \"Eu tinha muito pouco sangue para dar.\" {EventHero} investiga os arredores do palácio. Os Vampiros estavam se alimentando dos prisioneiros capturados, mas seu palácio estava abastecido com os melhores alimentos para engordar seus fornecedores de sangue. Seria uma pena deixar o banquete ir para o lixo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1289@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "\"Louvado seja você, ó {PlayerLeader.Title}!\", suspira o {EventUnit} menos drenado. \"Eu tinha muito pouco sangue para dar.\" Você investiga os arredores do palácio. Os Vampiros estavam se alimentando dos prisioneiros capturados, mas seu palácio estava abastecido com os melhores alimentos para engordar seus fornecedores de sangue. Seria uma pena deixar o banquete ir para o lixo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1289@BUTTON_0"
msgstr "Saquear as provisões armazenadas [food/] para {EventCity}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1289@BUTTON_2"
msgstr "Enviar os alimentos palacianos para seus recrutas [unitprod/] em {EventCity}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1289@BUTTON_3"
msgstr "Permitir que seu exército vitorioso termine o banquete. [morale/] Eles merecem."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1289@BUTTON_4"
msgstr "Estudar o Ritual da Lua de Sangue para fortalecer [xp/] {EventHero}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1289@BUTTON_5"
msgstr "Escravizar [thralls/] os outros prisioneiros resgatados. [evilact/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1289@TITLE"
msgstr "Banquete da Lua de Sangue: Consequências"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1291@BODY_FOOTER"
msgstr "Eles notam {EventHero} quando um {EventUnit} desgarrado tenta se agarrar à perna de <<o:EventHero>>. Os <<m:EnemyUnit>> frenéticos imediatamente se movem para atacar."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1291@BODY_FOOTER@HERO_IS_PLAYELEA"
msgstr "Eles notam você quando um {EventUnit} desgarrado tenta se agarrar à sua perna. Os <<m:EnemyUnit>> frenéticos imediatamente se movem para atacar."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1291@BODY_HEADER"
msgstr "{EventHero} marcha em direção ao cheiro de sangue quente que emana da entrada da {EventStructure}, bombardeado por gritos angustiantes e chilreios."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1291@BODY_HEADER@HERO_IS_PLAYELEA"
msgstr "Você marcha em direção ao cheiro de sangue quente que emana da entrada da {EventStructure}, bombardeado por gritos angustiantes e chilreios."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1291@BODY_LORE"
msgstr "Liderando o exército de <<o:EventHero>> para dentro, {EventHero.FirstName} testemunha como <<m:EnemyUnit>> expõem seus corpos para <<m:EventUnit>>, que drenam seu sangue de forma voraz. <<m:EventUnit>> inchados se contorcem no chão da caverna, colocando ovos. Formas se movem sob a pele dos <<m:EnemyUnit>>, que gritam cânticos arcanos sobre pureza de sangue e os Princípios do Sangrador. Seus gritos não revelam agonia, apenas exaltação."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1291@BODY_LORE@HERO_IS_PLAYELEA"
msgstr "Liderando seu exército para dentro, você testemunha como <<m:EnemyUnit>> expõem seus corpos para <<m:EventUnit>>, que drenam seu sangue de forma voraz. <<m:EventUnit>> inchados se contorcem no chão da caverna, colocando ovos. Formas se movem sob a pele dos <<m:EnemyUnit>>, que gritam cânticos arcanos sobre pureza de sangue e os Princípios do Sangrador. Seus gritos não revelam agonia, apenas exaltação."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1291@BUTTON_0"
msgstr "Acelerar o sangramento dos <<m:EnemyUnit>> equivocados. Atacar!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1291@BUTTON_1"
msgstr "Infectar [hp/] suas tropas com Parasitas de Sangue para compartilhar a bênção dos cultistas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1291@BUTTON_2"
msgstr "Corromper sua carne para repelir os vorazes Parasitas de Sangue."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1291@BUTTON_3"
msgstr "Invocar os impulsos primais de todos os <<m:EventUnit>> recém-eclodidos."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1291@BUTTON_4"
msgstr "Recuar. Deixar esses miseráveis <<m:EnemyUnit>> com seus rituais enlouquecidos por enquanto."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1291@TITLE"
msgstr "Princípios do Sangrador"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1292@BODY_FOOTER"
msgstr "O {EnemyUnit} uiva ecstaticamente e os discípulos de <<o:EnemyUnit>> se aglomeram ao redor de <<P:EnemyUnit>>: \"Ensinem a esses voyeurs não convidados sobre a dor!\" Como {EventHero} responderá?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1292@BODY_FOOTER@HERO_IS_PLAYELEA"
msgstr "O {EnemyUnit} uiva ecstaticamente e os discípulos de <<o:EnemyUnit>> se aglomeram ao redor de <<P:EnemyUnit>>: \"Ensinem a esses voyeurs não convidados sobre a dor!\" Como você responderá?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1292@BODY_HEADER"
msgstr "{EventHero} inicialmente fica apreensivo com os gritos que saem da {EventStructure} abaixo de <<P:EventHero>>. Mas as risadas subsequentes despertam a curiosidade de <<o:EventHero>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1292@BODY_HEADER@HERO_IS_PLAYELEA"
msgstr "Você inicialmente fica apreensivo com os gritos que saem da {EventStructure} abaixo de você. Mas as risadas subsequentes despertam sua curiosidade."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1292@BODY_LORE"
msgstr "{EventHero.FirstName} descobre o espetáculo dentro com horror. Um {EnemyUnit} instrui os acólitos de <<o:EnemyUnit>> nos Ensino da Dor: eles beliscam, esfaqueiam, torcem e cortam uns aos outros. Sangue jorra de suas feridas autoinfligidas, e gritos eufóricos de suas gargantas. O {EnemyUnit}, adornado com respingos de sangue, sorri com deleite ansioso quando <<p:EnemyUnit>> avista <<G:army^n,{EventHero.FirstName}>> e sussurra: \"Mais carne disposta?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1292@BODY_LORE@HERO_IS_PLAYELEA"
msgstr "Você descobre o espetáculo dentro com horror. Um {EnemyUnit} instrui os acólitos de <<o:EnemyUnit>> nos Ensino da Dor: eles beliscam, esfaqueiam, torcem e cortam uns aos outros. Sangue jorra de suas feridas autoinfligidas, e gritos eufóricos de suas gargantas. O {EnemyUnit}, adornado com respingos de sangue, sorri com deleite ansioso quando <<p:EnemyUnit>> avista seu exército e sussurra: \"Mais carne disposta?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1292@BUTTON_0"
msgstr "\"Não há dor na morte! Abatam-nos!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1292@BUTTON_1"
msgstr "\"Pensem em pensamentos felizes, tropas! Tirem isso da mente deles!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1292@BUTTON_2"
msgstr "\"Vocês, desviantes, deveriam ter vergonha de vocês mesmos!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1292@BUTTON_3"
msgstr "\"Isso parece o tipo de festa que eu gosto! Contem comigo!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1292@BUTTON_4"
msgstr "Deixe o {EnemyUnit} e os discípulos de <<o:EnemyUnit>> com seus rituais em privacidade."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1292@TITLE"
msgstr "Ensino do Torturador"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1293@BODY_FOOTER"
msgstr "<<m:EventUnit>> fogem da {EventStructure}. Há algo que valha a pena salvar neste local abandonado?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1293@BODY_HEADER"
msgstr "Ao matar o último dos <<m:EnemyUnit>>, {EventHero} descobre o verdadeiro propósito da {EventStructure}: é um altar para {GLOBAL.UrvatoghLoreConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1293@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Ao matar o último dos <<m:EnemyUnit>>, você descobre o verdadeiro propósito da {EventStructure}: é um altar para {GLOBAL.UrvatoghLoreConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1293@BODY_LORE"
msgstr "{EventHero.FirstName} descobre tomos que mencionam o [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] e seus chamados Dez Mandamentos do Sangue. O poder da entidade sombria havia infectado as mentes dos <<m:EnemyUnit>> com a crença distorcida de que oferecer seu sangue ao <<m:EventUnit>> levaria à grandeza e ao retorno do Primeiro Vampiro. Seus rituais repetidos acumularam energias mágicas imprevisíveis, que {EventHero.FirstName} rapidamente precipita como mana."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1293@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Você descobre tomos que mencionam o [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] e seus chamados Dez Mandamentos do Sangue. O poder da entidade sombria havia infectado as mentes dos <<m:EnemyUnit>> com a crença distorcida de que oferecer seu sangue ao <<m:EventUnit>> levaria à grandeza e ao retorno do Primeiro Vampiro. Seus rituais repetidos acumularam energias mágicas imprevisíveis, que você rapidamente precipita como mana."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1293@BUTTON_0"
msgstr "Pesquise [knowledge/] as vantagens da sangria em batalha."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1293@BUTTON_1"
msgstr "Adote um {EventUnit} perdido. [unit/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1293@BUTTON_2"
msgstr "Estudar os dez mandamentos do Deus Imortal transforma seu {EventStackUnit} em um {EnemyUnit}. [unit/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1293@BUTTON_3"
msgstr "Moer os mortos <<m:EventUnit>> em fertilizante [food/] para <<G:farms^p,EventCity>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1293@TITLE"
msgstr "Dez Mandamentos do Sangue: Consequências"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1294@BODY_FOOTER"
msgstr "Além do {EventItem}, o que {EventHero} deve extrair da {EventStructure} antes de seguir em frente deste local depravado?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1294@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Além do {EventItem}, o que você extrairia da {EventStructure} antes de seguir em frente deste local depravado?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1294@BODY_HEADER"
msgstr "{EventHero} matou os ritualistas que ocupavam a {EventStructure}. Um sorriso encantado está congelado nos lábios mortos de <<G:lips^p,EnemyUnit>>, para <<G:discomfort^n,{EventHero.FirstName}>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1294@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você matou os ritualistas que ocupavam a {EventStructure}. Um sorriso deliciado está congelado nos lábios mortos do <<G:lips^p,EnemyUnit>>, para seu desconforto."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1294@BODY_LORE"
msgstr "A luz fraca da {EventStructure} revela que o chão da caverna está agora completamente inundado com o sangue dos mortos em batalha. Cidadãos de todo o reino se reuniram aqui para adorar a Dor juntos. {EventHero.FirstName} examina o elaborado kit de ferramentas do {EnemyUnit} e encontra <<o:EnemyUnit>> {EventItem}. <<Cp:EventHero>> se pergunta se <<p:EventHero>> poderia algum dia entender verdadeiramente que convicção levou esses ritualistas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1294@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "A luz fraca da {EventStructure} revela que o chão da caverna está agora completamente inundado com o sangue dos mortos em batalha. Cidadãos de todo o reino se reuniram aqui para adorar a Dor juntos. Você examina o elaborado kit de ferramentas do {EnemyUnit} e encontra <<o:EnemyUnit>> {EventItem}. Você se pergunta se poderia algum dia entender verdadeiramente que convicção levou esses ritualistas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1294@BUTTON_0"
msgstr "Experimente com as <<G:artes^p,EnemyUnit>> [unitHero/] para aumentar <<G:durabilidade^n,{EventHero.FirstName}>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1294@BUTTON_0@HERO_IS_PLAYERLE"
msgstr "Experimente com as <<G:artes^p,EnemyUnit>> [unitHero/] para aumentar sua durabilidade."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1294@BUTTON_1"
msgstr "[order/] Purge todas as evidências dos <<G:rituais aberrant^p,EnemyUnit>> da {EventStructure}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1294@BUTTON_2"
msgstr "Beba o sangue que foi derramado por toda parte. [xp/] Não desperdice, não queira!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1294@BUTTON_3"
msgstr "Estude as <<G:lições^p,EnemyUnit>> para fortalecer seus combatentes à distância. [knowledge/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1294@TITLE"
msgstr "Ensino do Atormentador: Consequências"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1295@BODY_FOOTER"
msgstr "Eles param, esperando que você resolva seu desacordo volátil. A quem você favorecerá? O poderoso {EventHeroA.FirstName}? Ou o ambicioso {EventHeroB.FirstName}?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1295@BODY_HEADER"
msgstr "Seu banquete noturno na corte é interrompido quando as tensões entre {EventHeroA} e {EventHeroB} explodem em uma discussão."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1295@BODY_LORE"
msgstr "\"Covarde!\" {EventHeroA.FirstName}, o mais forte dos dois, arrasta {EventHeroB.FirstName} pela mesa de jantar, derramando um pouco do seu melhor sangue engarrafado. O mais recentemente gerado {EventHeroB.FirstName} chupa <<o:EventHeroB>> os dentes. \"Você é um tolo,\" <<p:EventHeroB>> ri. \"Soldados não podem forjar impérios! Tecer feitiços molda reinos poderosos! Todo mundo sabe disso!\" {EventHeroA} empunha <<o:EventHeroA>> arma. \"Vamos ver como seu tecer se sai contra minha lâmina, cão!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1295@BUTTON_0"
msgstr "Fique ao lado de {EventHeroB} [morale/]. Seu império deve crescer por meio de feitiçaria. [knowledge/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1295@BUTTON_1"
msgstr "\"Esta não é maneira de se comportar! Vocês dois vão me obedecer!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1295@BUTTON_2"
msgstr "Fique ao lado de {EventHeroA} [morale/]. Seu império deve crescer pela espada. [unitprod/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1295@BUTTON_3"
msgstr "\"Parem com essa rivalidade infantil. Banquetem-se com alguns escravos [thralls/] em vez disso. Saúde!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1295@BUTTON_4"
msgstr "Nenhum dos dois parece entender a arte do governo. Ignore-os."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1295@BUTTON_5"
msgstr "\"Haha, isso vai ser uma grande luta! Que vença o melhor Vampiro!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1295@TITLE"
msgstr "Sangue Ruim"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1298@BODY_FOOTER"
msgstr "Um {PlayerLeader.Title} como você deveria ostentar <<o:PlayerLeader>> {EventMaterial} para mostrar sua opulência. Você vai caçar uma nova fonte?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1298@BODY_HEADER"
msgstr "A origem dos Vampiros está ligada à lendária substância comumente chamada de {EventMaterial}, que revigora os Vampiros e gera sede de sangue."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1298@BODY_LORE"
msgstr "Os <<m:{GLOBAL.ArchvampireLoreConcept.Hyperlink}>>, seus senhores ancestrais, criavam espadas, anéis e coroas de vidro para exibir sua riqueza e autoridade. As janelas de seus antigos palácios seriam feitas de painéis de {EventMaterial}, transformando os raios brilhantes que as atravessam em uma luz vermelha revitalizante. Os maiores dos reis tinham covens inteiros de tenentes confiáveis equipados com armamentos mestres de {EventMaterial}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1298@BUTTON_0"
msgstr "\"O {EventMaterial} será de grande ajuda em minhas conquistas!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1298@BUTTON_2"
msgstr "\"Ostentar {EventMaterial}? Eu vou erguer uma estátua [structureprod/] de mim mesmo [influence/] em vez disso!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1298@BUTTON_3"
msgstr "\"Não tenho interesse nas loucuras de reis empoeirados.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1298@TITLE"
msgstr "Taça de Carmim"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@BODY_FOOTER"
msgstr "Adquirir o {EventMaterial} aumenta sua produção de itens mágicos. Os ferreiros podem até terminar uma arma para um {GLOBAL.HeroConcept.Hyperlink} imediatamente!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@BODY_HEADER"
msgstr "Segurando um fragmento de {EventMaterial}, você sente um pulso fraco. Você sente seus efeitos revigorantes. E sua fome crescente."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@BODY_LORE"
msgstr "Seus ferreiros chegam para informar que suas forjas estão prontas. Eles estão ansiosos para usar este material para criar lâminas afiadas e placas defletoras. Seu <<m:{GLOBAL.HeroConcept.Hyperlink}>> em particular pode se beneficiar dos armamentos melhorados que o {EventMaterial} pode fornecer. Você dá o sinal, e seus ferreiros sorridentes carregam o {EventMaterial} para suas sombrias forjas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@BUTTON_0"
msgstr "Forje um {DefenderItem} [item/] para {DefenderHero}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@BUTTON_1"
msgstr "Forje um {MageItem} [item/] para {MageHero}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@BUTTON_10"
msgstr "Forje um {WarriorItem} [item/] para {WarriorHero}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@BUTTON_11"
msgstr "Forje um {DeathItem} [item/] para {DeathHero}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@BUTTON_4"
msgstr "Forje um {RangerItem} [item/] para {RangerHero}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@BUTTON_5"
msgstr "Esqueça os Heróis. Misture isso com os armamentos das minhas tropas regulares. [unitprod/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@BUTTON_6"
msgstr "\"Meus Heróis me abandonaram. Eu mesmo criarei uma arma.\" [item/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@BUTTON_7"
msgstr "Forje um {RitualistItem} [item/] para {RitualistHero}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@BUTTON_8"
msgstr "Forje um {SpellbladeItem} [item/] para {SpellbladeHero}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@BUTTON_9"
msgstr "Forje um {WarlockItem} [item/] para {WarlockHero}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@TITLE"
msgstr "Taça de Carmim: Consequências"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1302@BODY_FOOTER"
msgstr "Se você deseja aprender mais sobre seus ancestrais, construa <<m:{GLOBAL.ResearchPostConcept.Hyperlink}>> para estudar a história de sua linhagem mais profundamente."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1302@BODY_HEADER"
msgstr "Como um(a) {GLOBAL.ElderVampireLoreConcept.Hyperlink} {PlayerLeader.Title}, você é descendente de uma grande linhagem de [hyperlink,GLOBAL.ArchvampireLoreConcept]<<PlayerLeader{Archsires/Archdams}>>[/hyperlink]. Mas qual?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1302@BODY_LORE"
msgstr "Havia muitos clãs, covens e casas no passado sem sol de sua espécie. Cada um exaltava seus próprios talentos, forças e habilidades. E enquanto você anseia por saber aonde suas ambições o levam, conhecer a origem de seu poder pode ser útil. Escribas e estudiosos já trabalham incansavelmente para descobrir magias ocultas, mas precisarão de reforço para estudar sua linhagem."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1302@BUTTON_0"
msgstr "Construa o <<m:{GLOBAL.ResearchPostConcept.Name}>> para fortalecer suas capacidades acadêmicas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1302@BUTTON_2"
msgstr "Você sabe [knowledge/] o suficiente. O que lhe falta são mãos dispostas [thralls/]."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1302@BUTTON_3"
msgstr "Deixe o passado apodrecer. Seu foco é dominar o futuro."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1302@TITLE"
msgstr "Lore do(a) <<PlayerLeader{Archsires/Archdams}>>"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1303@BODY_FOOTER"
msgstr "Acessar este novo poço de poder já o fortalece. Como você usará esta descoberta para moldar seu domínio?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1303@BODY_HEADER"
msgstr "O último <<m:{GLOBAL.ResearchPostConcept.Hyperlink}>> foi construído e seus escribas já relatam uma descoberta."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1303@BODY_LORE"
msgstr "Eles traduziram com sucesso pergaminhos antigos, escritos em uma língua morta, que abrigam os anais de um dos filhos das trevas do [hyperlink,GLOBAL.UrvatoghLoreConcept]Imperador Sangrento Eterno[/hyperlink]. Comparando esses anais com a árvore genealógica de seu(sua) <<PlayerLeader{sire/dam}>>, você pode traçar sua linhagem até {EventPhrase}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1303@BUTTON_0"
msgstr "Use o conhecimento para atrair recrutas para o seu exército. [unitprod/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1303@BUTTON_1"
msgstr "Explore esse conhecimento para cimentar seu status de alta classe [influence/]."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1303@BUTTON_4"
msgstr "Anuncie essa descoberta para reforçar o orgulho [happiness/] da sua {EventRace}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1303@BUTTON_5"
msgstr "Aduza sua linhagem para ligar mais escravos [thralls/] à sua vontade."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1303@BUTTON_6"
msgstr "Aceite esse conhecimento como prova da sua devoção [devotion/]."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1303@TITLE"
msgstr "Lore do <<PlayerLeader{Archsires/Archdams}>>: Consequências"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@BODY_FOOTER"
msgstr "Tantos escravos para poupar! Certamente você pode encontrar um uso melhor para eles do que congestionar seu [hyperlink,GLOBAL.STRUCTURE_UPGRADES.LORD_CASTLE_FOUNDATION]Castelo Vampiro[/hyperlink]?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@BODY_HEADER"
msgstr "Escravos se reúnem em sua fortaleza em {EventCity}. Eles estão aglomerados em multidões, ocupando suas masmorras mais profundas e laboratórios mais mortais."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@BODY_LORE"
msgstr "Escravos são um símbolo de sua influência sobre pessoas inferiores. Privados de suas vontades e desejos, eles seguem suas ordens sem pausa ou objeção. Mas para Vampiros, escravos não devem ficar ociosos. Os príncipes e consortes vampiros mais astutos emitiram hordas de escravos para executar suas ordens sombrias. Muitos dos seus estão sem uso, assim como seu potencial."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@BUTTON_0"
msgstr "Esfolar escravos [thralls/] para entreter [morale/] sua coven."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@BUTTON_1"
msgstr "Gaste escravos [thralls/] para ganhar favor com senhores inferiores. [allegiance/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@BUTTON_10"
msgstr "[nature/] Envie escravos [thralls/] para seus açougueiros. [food/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@BUTTON_11"
msgstr "[shadow/] Drene escravos [thralls/] para aprender [knowledge/] mais sobre o Cosmos."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@BUTTON_12"
msgstr "Escravos demais? Nada disso. Traga-me mais! [thralls/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@BUTTON_2"
msgstr "Parade seus escravos [thralls/] para exibir sua senhoria. [influence/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@BUTTON_3"
msgstr "[chaos/] Envie escravos [thralls/] para trabalhar nas forjas [unitprod/] em suas ferrarias."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@BUTTON_4"
msgstr "[arcana/] Gaste escravos [thralls/] para extrair mana [mana/] do Mar Astral."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@BUTTON_5"
msgstr "[order/] Implante escravos [thralls/] como coletores de impostos [gold/]."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@BUTTON_9"
msgstr "[matter/] Emita escravos [thralls/] para explorar em suas pedreiras. [structureprod/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@TITLE"
msgstr "Multidões de Escravos"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1194_1919@BODY_FOOTER"
msgstr "Dizem que a cripta de <<Co:Emperor>> está localizada sob o monte ensopado de sangue de um coração despedaçado. Encontre-a, pois aquele que a desvendar decidirá o futuro destino de todos os Vampiros."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1194_1919@BODY_HEADER"
msgstr "O [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink], o primeiro de todos os Vampiros, foi há muito tempo colocado para descansar neste reino. <<Cp:Emperor>> aguarda a chegada daquele que instigará um acerto de contas de sangue."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1194_1919@BODY_LORE"
msgstr "Odiado ou amado, o [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] é um enigma venerado por cultos de sangue secretos ao longo dos tempos. Eles há muito pregam a chegada de um evento, chamado de 'Acerto de Contas de Sangue'. Um tempo em que {EventRealm} retorna do banimento, e o sangue sagrado do Deus Imortal será derramado ou novamente reinstaurado para uma glória ainda maior!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1194_1919@BUTTON_0"
msgstr "\"O acerto de contas está à mão.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1194_1919@TITLE"
msgstr "Cripta do Deus Imortal"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_212@BODY_FOOTER"
msgstr "A figura se transforma em pó diante dos olhos de {EventHero}, deixando <<P:EventHero>> com um pedido para salvar a aldeia assolada. O que {EventHero} fará?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_212@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "A figura se transforma em pó diante dos seus olhos, deixando você com um pedido para salvar a aldeia assolada. O que você fará?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_212@BODY_HEADER"
msgstr "Do canto do olho de <<o:EventHero>>, {EventHero} sente algo. Mancando e gravemente ferido, uma figura se aproxima de <<P:EventHero>>, gesticulando por ajuda."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_212@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Do canto do seu olho, você sente algo. Mancando e gravemente ferido, uma figura se aproxima, gesticulando por ajuda."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_212@BODY_LORE"
msgstr "\"Por favor, não aguentamos mais. Algo terrível está assombrando nossa aldeia, levando nosso povo. Consegui chegar aqui para pedir ajuda. Mas meus filhos... minha família, ainda estão lá.\"\n"
"\n"
"Os olhos de <<Co:VillageSoulHero>> de repente se fixam nas próprias feridas letais de <<o:VillageSoulHero>>. Com um olhar de terror, <<p:VillageSoulHero>> diz, \"Mas tenha cuidado... parece que não saí vivo daqui.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_212@BUTTON_0"
msgstr "Queime o lugar maldito — a maldição não deve se espalhar."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_212@BUTTON_1"
msgstr "Procure por sobreviventes; alguém ainda pode estar vivo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_212@BUTTON_4"
msgstr "Conecte-se com a fonte do mal que assombra o lugar."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_212@BUTTON_5"
msgstr "Deixe a alma perdida."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_212@TITLE"
msgstr "A Aldeia Assolada"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_213@BODY_FOOTER"
msgstr "Isso ainda não acabou. Uma última ação permanece."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_213@BODY_HEADER"
msgstr "Depois de matar a última criatura, a aldeia deveria ter sido limpa. No entanto, algo está errado, este lugar ainda parece assombrado."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_213@BODY_LORE"
msgstr "As casas apodrecem em silêncio, dilapidadas, abandonadas. No entanto, você sentiu, nenhum sentido de paz veio após matar o último monstro. Uma presença sombria persiste, o que quer que tenha amaldiçoado este lugar ainda está aqui. Você vê isso nas sombras da cidade. Suas formas não combinam com os edifícios."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_213@BUTTON_0"
msgstr "Prepare o combustível. Acenda as tochas. Incendeie esta cidade."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_213@BUTTON_1"
msgstr "Entre na aldeia — alguém ainda deve estar vivo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_213@BUTTON_4"
msgstr "Conecte-se com a presença sombria."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_213@TITLE"
msgstr "A Maldição da Aldeia Assolada"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_214@BODY_FOOTER"
msgstr "O destino deste domínio está em suas mãos. O que você fará?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_214@BODY_HEADER"
msgstr "O fogo purifica a corrupção desta terra. As chamas envolvem os edifícios, as sombras, a maldição."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_214@BODY_LORE"
msgstr "Você não consegue desviar o olhar do clarão. Não apenas a aldeia queima, as chamas estão consumindo algo mais que persiste no ar. Você pode ouvir gritos e torções. Você pode ver o fogo ficar preto ao seu toque. Nada escapa do inferno. Mas uma vez que a terra seja queimada, você pode escolher o que se tornará dela."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_214@BUTTON_0"
msgstr "Proibir [influence/] qualquer um de se estabelecer aqui. [renown/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_214@BUTTON_1"
msgstr "Remodele a terra [unitprod/] em campos de cultivo [food/]."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_214@BUTTON_4"
msgstr "Reconstrua as fundações."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_214@BUTTON_5"
msgstr "Opção de lorde vampiro ou outra opção de lorde (em desenvolvimento)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_214@TITLE"
msgstr "A Aldeia Assolada: Em Chamas"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_215@BODY_FOOTER"
msgstr "O que você vai fazer? (WIP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_215@BODY_HEADER"
msgstr "Uma larva recém-nascida chora, está ferida e perdida. (WIP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_215@BODY_LORE"
msgstr "Ela está comendo os suprimentos da vila. \n"
" \n"
"Uma larva de graça, você a quer? (WIP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_215@BUTTON_0"
msgstr "Acariciar a larva [unit/] (WIP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_215@BUTTON_1"
msgstr "Matar a larva [goodact/] (WIP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_215@BUTTON_4"
msgstr "Estudar a larva [knowledge/] (WIP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_215@TITLE"
msgstr "A Vila Amaldiçoada - Lamentando (WIP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_216@BODY_FOOTER"
msgstr "O destino da família está em suas mãos. O que você vai fazer?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_216@BODY_HEADER"
msgstr "Nenhuma casa abriga uma alma viva. Nenhuma, exceto uma, cuja porta range ao se abrir enquanto você se aproxima."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_216@BODY_LORE"
msgstr "Os habitantes da casa saem dela arrastando-se. Um pai e duas crianças, famintos e com medo. Você pode ver a corrupção correndo por suas veias, eles podem se transformar nos mesmos monstros que os caçaram. O adulto fala com uma voz quebrada: \"Temos pouco restante... mas você pode ficar com esta relíquia, se nos conceder passagem segura.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_216@BUTTON_0"
msgstr "Deixe-os juntarem-se a {EventCity}. [unhappiness/] [goodact/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_216@BUTTON_1"
msgstr "Acabe com eles, você não pode deixar a maldição se espalhar."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_216@BUTTON_4"
msgstr "Liberte-os [mana/] da maldição [goodact/]."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_216@BUTTON_5"
msgstr "Dissipe a energia da sombra para levantar a maldição. [goodact/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_216@BUTTON_6"
msgstr "Desfaça a energia do caos para levantar a maldição. [goodact/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_216@TITLE"
msgstr "A Vila Amaldiçoada: Sobreviventes"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_217@BODY_FOOTER"
msgstr "Embora gasto e desgastado, o manto ainda vibra com um poder ancestral. Você precisará de sua {GLOBAL.ItemForgeConcept.Hyperlink} para consertá-lo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_217@BODY_HEADER"
msgstr "Embora não haja vento, uma capa esfarrapada se move pela superfície. Como se sentisse a presença de {EventHero}, a capa se dirige para <<P:EventHero>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_217@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Embora não haja vento, uma capa esfarrapada se move pela terra árida. Como se sentisse sua presença, a capa se dirige para você."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_217@BODY_LORE"
msgstr "Do manto emana uma presença fantasmagórica, mal segurando o tecido. Uma voz cansada ecoa: \n"
"\"O {EventArtifact}... liga minha linhagem a este mundo. Ele deve ser consertado... antes que o nome da minha família desapareça.\" \n"
"Com as últimas palavras de <<o:SoulHero>>, o espírito murcha, deixando o manto cair aos seus pés. Como a pele trocada de algo que não pertence mais a este mundo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_217@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Do manto emana uma presença fantasmagórica, mal segurando o tecido. Uma voz cansada ecoa: \n"
"\"O {EventArtifact}... ainda liga nossa linhagem a este mundo. Ele deve ser consertado... antes que nos tornemos extintos.\" \n"
"Com as últimas palavras de <<o:SoulHero>>, o espírito murcha, deixando o manto cair aos seus pés. Como a pele trocada de algo que não pertence mais a este mundo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_217@BUTTON_0"
msgstr "\"Esta linhagem não será relegada ao esquecimento.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_217@BUTTON_1"
msgstr "\"Este fardo não é meu para carregar.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_217@TITLE"
msgstr "Manto do Antepassado"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_218@BODY_FOOTER"
msgstr "O fantasma anseia pelo {EventArtifact}. O que você responderá?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_218@BODY_HEADER"
msgstr "Você reforjou o {EventArtifact}. Da capa remendada, surge a figura espectral, o contorno de <<o:SoulHero>> agora claro e a presença de <<o:SoulHero>> revitalizada."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_218@BODY_LORE"
msgstr "Com sua própria essência, você reacendeu o {EventArtifact} que era meu... e de meus ancestrais, é claro. Sua generosidade é... deliciosa, {PlayerLeader}; mas eu odiaria testá-la ainda mais. Permita-me devolver esta vestimenta ao seu lugar de direito, para que—sob meu nome—novo sangue possa vestí-la mais uma vez."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_218@BUTTON_0"
msgstr "\"Pegue isso e lembre-se de quem salvou sua linhagem.\" [influence/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_218@BUTTON_1"
msgstr "\"A vestimenta está sintonizada comigo agora.\" [item/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_218@TITLE"
msgstr "O Dono da Capa"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_219@BODY_FOOTER"
msgstr "O espírito que você ajudou não era uma alma perdida, mas um Vampiro envolto em necessidade. O que você decretará?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_219@BODY_HEADER"
msgstr "Pessoas têm desaparecido em seu reino. Os relatórios de seus investigadores permitiram que você encontrasse o perpetrador, com as mãos de <<o:SoulHero>> ainda ensanguentadas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_219@BODY_LORE"
msgstr "O fantasma que você ajudou agora se mostra como <<r:SoulHero>> diante de você como um Vampiro, o {EventArtifact} drapeado sobre os ombros de <<o:SoulHero>>. \"Nos encontramos novamente, {PlayerLeader}. Eu lhe devo uma explicação,\" diz <<p:SoulHero>> com um sorriso. \"Derrotado e em desespero, eu derramei o último de minha essência em minha capa, esperando me esconder e recuperar minha força. A mesma capa que você restaurou para sua glória total.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_219@BUTTON_0"
msgstr "\"Enquanto você servir [unitHero/] a mim, poderá saciar sua fome [population/] [evilact/].\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_219@BUTTON_1"
msgstr "\"Você não escapará do meu julgamento.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_219@BUTTON_4"
msgstr "\"Conheça seu lugar, novato, você servirá [unitHero/] a mim e se alimentará fora [thralls/] dos meus domínios.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_219@TITLE"
msgstr "Capa do Vampiro"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_221@BODY_FOOTER"
msgstr "A aparição está ligada pela ira e pela dor. {EventHero} responderá ao seu chamado?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_221@BODY_HEADER"
msgstr "{EventHero} ouve um grito de coração partido; um grito de dor sem ferida; um fantasma usando uma careta eterna de agonia."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_221@BODY_LORE"
msgstr "Gesticulando entre soluços, ela diz: \"Que tipo de mundo é este onde não há justiça? Que tipo de dor é esta, que nem mesmo a morte pode silenciá-la? Meus filhos... meus pobres filhos.\"\n"
"Sua dor explode em fúria enquanto ela afirma: \"Você não escapará de mim! Eu posso sentir seu fedor, {FairSoulHero2}.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_221@BUTTON_0"
msgstr "\"Eu reivindicarei sua vingança.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_221@BUTTON_1"
msgstr "Deixe a alma atormentada."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_221@TITLE"
msgstr "Lamento da Dama Justa"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_224@BODY_FOOTER"
msgstr "A ira do espectro não conhece limites. Você persistirá em sua busca por vingança?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_224@BODY_HEADER"
msgstr "Após a batalha recente, entre os caídos, a aparição vingativa se levanta sobre sua vítima aterrorizada."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_224@BODY_LORE"
msgstr "\"O que eu fiz com você,\" grita o homem. \"Você pode não ser ele—mas carrega o mesmo fedor do mal. O fedor de alguém capaz de derramar o sangue de sua própria prole,\" responde o espectro. E depois de se lançar sobre ele com toda a sua raiva, ela deixa o homem sem vida. \n"
"\"Não era ele, devemos continuar procurando,\" diz a aparição."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_224@BUTTON_0"
msgstr "\"Eu continuarei até que você descanse em paz.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_224@BUTTON_1"
msgstr "\"Eu não posso seguir você, você perdeu seu caminho.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_224@BUTTON_4"
msgstr "\"Este massacre precisa cessar.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_224@TITLE"
msgstr "Vingança da Dama Justa"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_240@BODY_FOOTER"
msgstr "A fúria do espectro não conhece limites. Você persistirá em sua busca por vingança?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_240@BODY_HEADER"
msgstr "Após a batalha recente, entre os caídos, a aparição vingativa surge sobre sua vítima aterrorizada."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_240@BODY_LORE"
msgstr "\"Como eu te ofendi,\" exclama o homem. \"Você pode não ser ele — mas o mesmo cheiro de mal clinga a você. O cheiro de alguém que abusou da própria alma que jurou amar,\" responde o espectro. E depois de se lançar sobre ele com toda a sua fúria, ela deixa o homem sem vida. \"Não era ele, devemos continuar procurando,\" diz a aparição."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_240@BUTTON_0"
msgstr "\"Eu continuarei até que você descanse em paz.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_240@BUTTON_1"
msgstr "\"Não posso te seguir, você perdeu seu caminho.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_240@BUTTON_4"
msgstr "\"Essa carnificina precisa cessar.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_240@TITLE"
msgstr "A Vingança da Dama Justa"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_241@BODY_FOOTER"
msgstr "A fúria do espectro não conhece limites. Você persistirá em sua busca por vingança?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_241@BODY_HEADER"
msgstr "Após a batalha recente, entre os caídos, a aparição vingativa surge sobre sua vítima aterrorizada."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_241@BODY_LORE"
msgstr "\"Não sou ele, nunca te conheci,\" grita o homem. \"Talvez não — mas você carrega o mesmo cheiro de mal. Um cheiro que parece mentiras, traição e tortura,\" responde o espectro. E depois de se lançar sobre ele com toda a sua fúria, ela deixa o homem sem vida. \"Não era ele, devemos continuar procurando,\" diz a aparição."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_241@BUTTON_0"
msgstr "\"Eu continuarei até que você descanse em paz.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_241@BUTTON_1"
msgstr "\"Não posso te seguir, você perdeu seu caminho.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_241@BUTTON_4"
msgstr "\"Você precisa parar com essa carnificina.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_241@TITLE"
msgstr "A Vingança da Dama Justa"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_242@BODY_FOOTER"
msgstr "A aparição mostrou suas verdadeiras faces. Como você responderá?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_242@BODY_HEADER"
msgstr "O rosto da aparição se contorce e se divide em caretas impossíveis, formando múltiplas faces e mostrando sua verdadeira natureza, a de um {EventUnit}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_242@BODY_LORE"
msgstr "Suas vozes gritam: \n"
"\"Nós somos o sofrimento daqueles que foram abusados. Nós somos a raiva daqueles que morreram em agonia. Nós somos aqueles que nunca conheceram a justiça.\n"
"Eles levaram nossa sanidade. Eles levaram nossas vidas. Eles levaram tudo o que tínhamos.\n"
"Eles não levarão nossas lágrimas. Eles não levarão nossa raiva. E você não levará nossa vingança!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_242@BUTTON_0"
msgstr "\"Você aceitará a morte — de bom grado ou não.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_242@BUTTON_1"
msgstr "\"Talvez nossos objetivos estejam, de fato, alinhados.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_242@BUTTON_4"
msgstr "\"Siga em frente, mas não caminharei ao seu lado.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_242@BUTTON_5"
msgstr "[reputation8/] \"Não consigo compreender sua dor, mas juntos, podemos erradicar o mal.\" [unit/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_242@TITLE"
msgstr "Os Rostos da Dama Justa"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_243@TITLE"
msgstr "Os Banidos da Dama Justa"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_246@BODY_FOOTER"
msgstr "Com os assuntos inacabados de <<o:SoulLoverHero>> concluídos, o fantasma desaparece. O que {EventHero} fará?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_246@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Com os assuntos inacabados de <<o:SoulLoverHero>> concluídos, o fantasma desaparece. O que você fará?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_246@BODY_HEADER"
msgstr "Um fantasma se manifesta na frente de {EventHero}. O olhar de <<Co:SoulLoverHero>>, encharcado em lágrimas que nunca caem, implora por ajuda."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_246@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Um fantasma se manifesta na sua frente. O olhar de <<Co:SoulLoverHero>>, encharcado em lágrimas que nunca caem, implora por ajuda."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_246@BODY_LORE"
msgstr "\"Sua presença... me chama... Você pode me ajudar. Eu estou desaparecendo, estou me desvanecendo, não quero partir; não agora que posso estar com meu amado. Passamos uma vida tentando nos alcançar, mas só nos encontramos na morte. Por favor, nos una. Una nossas almas em nosso anel de casamento, para que possamos sempre estar juntos.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_246@BUTTON_0"
msgstr "\"Descanse sua alma agora, honrarei seus desejos.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_246@BUTTON_1"
msgstr "\"Você não sabe o que está pedindo.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_246@TITLE"
msgstr "Demise Nupcial"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_247@BODY_FOOTER"
msgstr "Você tem apenas um momento antes que a alma do cônjuge seja perdida para sempre. O que você fará?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_247@BODY_HEADER"
msgstr "Enquanto a alma é incorporada ao anel, uma chama de luz espectral irrompe. Um segundo espírito se manifesta em seu brilho."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_247@BODY_LORE"
msgstr "\"Não! O que você fez?! Onde está <<p:SoulHero>>?!\" Com um olhar para o {EventArtifact}, <<p:SoulLoverHero2>> entende. \"Oh, meu querido, meu doce querido, o que você fez? Você era o último laço que me mantinha aqui. Eu ansiava partir juntos... para onde quer que a jornada... nos leve.\" \n"
"\n"
"Antes de quase desaparecer, a alma grita \"Eu não... quero ficar... sozinho... novamente.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_247@BUTTON_0"
msgstr "Quebre o anel, permitindo que ambas as almas passem. [mana/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_247@BUTTON_1"
msgstr "Una ambas as almas ao anel. [item/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_247@BUTTON_4"
msgstr "\"Você estará junto—mas não na vida, e não na morte.\" [evilact/] [unit/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_247@TITLE"
msgstr "Até que a Morte nos Separe"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_265@BODY_FOOTER"
msgstr "O fantasma que uma vez implorou por sua ajuda agora está diante de você—a alma de <<o:SoulHero>> desfigurada por vingança. O que você fará?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_265@BODY_HEADER"
msgstr "Desde que você escolheu manter o {EventArtifact}, sussurros assolam os cantos, com palavras que você não consegue entender."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_265@BODY_LORE"
msgstr "Você nunca está sozinho, mesmo quando o quarto está vazio. Os murmúrios o assaltam em seus momentos de descanso, eles têm ficado cada vez mais altos. De repente, uma voz—fragmentada, incompleta, mas unida—sussurra com dicção perfeita: \"Não há verdadeiro sono para os perversos.\" O espírito aparece diante de você, seu desejo por vingança deformou a alma de <<o:SoulHero>>, transformando-o em um {LivingFogUnit}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_265@BUTTON_0"
msgstr "Enfrente o espírito vingativo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_265@BUTTON_1"
msgstr "\"O que é uma alma perversa para um necromante?\" [souls/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_265@BUTTON_4"
msgstr "\"Em nome de tudo que é sagrado, vá embora, presença maligna!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_265@BUTTON_5"
msgstr "Corte a conexão de <<o:SoulHero>> com o reino dos vivos."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_265@TITLE"
msgstr "Manto da Vingança"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_356@BODY_FOOTER"
msgstr "Os despojos da batalha estão no campo. O que você fará com eles?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_356@BODY_HEADER"
msgstr "Com a escaramuça terminada, o campo de batalha emana uma quietude solene. Uma força fantasmal se manifesta à distância."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_356@BODY_LORE"
msgstr "Ela aparece novamente, o espírito que o levou aqui, surgindo ao lado do alvo de sua fúria. Mas algo está errado; ambos parecem confusos.\n"
"\n"
"Sua mente volta para o pós-batalha. Não sobrou muito após a luta, mas o suficiente para que você possa aproveitar."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_356@BUTTON_0"
msgstr "Troque os bens por ouro. [gold/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_356@BUTTON_1"
msgstr "Entregue-os aos seus estudiosos. [knowledge/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_356@BUTTON_4"
msgstr "Dedique-os à sua cidade, {EventCity}. [happiness/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_356@TITLE"
msgstr "Despojos da Refrega"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_475@BODY_FOOTER"
msgstr "Você terá que voltar mais tarde."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_475@BODY_HEADER"
msgstr "Uma presença obscurece o ar, mas sua forma está velada."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_475@BODY_LORE"
msgstr "A alma só se manifestará perante grandes vontades, como a de heróis e Governantes."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_475@BUTTON_0"
msgstr "Deixe a alma perdida."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_475@TITLE"
msgstr "Alma Perdida"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_515@BODY_FOOTER"
msgstr "[hyperlink,GLOBAL.VampireLordConcept]Vampiros[/hyperlink] não são mais fortalecidos pela Lua de Sangue e sofrem novamente as consequências de caminhar sob a luz do dia."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_515@BODY_HEADER"
msgstr "A Lua de Sangue minguante, e o medo da luz retorna àqueles que se banham na escuridão."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_515@BODY_LORE"
msgstr "O sol nasce atrás da lua que se esvai, restaurando a cor ao mundo. Seus raios dão vida aos prados e acendem a esperança em corações cansados. As criaturas do crepúsculo recuam para seus covis, abrigadas pelas sombras dentro deles."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_515@BUTTON_0"
msgstr "Diga adeus à noite vermelha."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_515@TITLE"
msgstr "Lua de Sangue: Consequências"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_542@BODY_FOOTER"
msgstr "As vozes gritam para que {EventHero} as siga. <<p:EventHero>> encontrará a origem de seu sofrimento?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_542@BODY_HEADER"
msgstr "{EventHero} pode sentir sua presença. Não um, não dois, mas uma amálgama de fantasmas. Todos falando ao mesmo tempo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_542@BODY_LORE"
msgstr "\"Pare eles. Ajude-nos. Nossa carne... nossas almas... consumidas.\" Uma das vozes se liberta da amálgama, \"Eles estão tentando criá-lo. A essência da vida, a tintura, a pedra da imortalidade.\" Então, como uma só, elas falam novamente. \"Uma para transformar chumbo em ouro. Uma para transformar morte em vida. Mas a magia exige um custo, e fomos nós.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_542@BUTTON_0"
msgstr "Siga para onde elas levam."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_542@BUTTON_1"
msgstr "Deixe as almas perdidas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_542@TITLE"
msgstr "Sangue e Alma"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_543@BODY_FOOTER"
msgstr "A energia está diante de você, aguardando a transmutaçao pela sua vontade."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_543@BODY_HEADER"
msgstr "O último cultista cai. Sangue e carne são consumidos pelo círculo ritual, completando o rito."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_543@BODY_LORE"
msgstr "À medida que os caídos são absorvidos pelo sigilo de sangue, uma energia carmesim irrompe. Ondas surgem para fora, girando em um vórtice violento. A cada volta, ele se contrai, condensando-se em uma anomalia escarlate. Ela chama por você. É poder—bruto e desimpedido, esperando para ser moldado."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_543@BUTTON_0"
msgstr "Crie um {BloodGlass} na área."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_543@BUTTON_1"
msgstr "Dissipe a energia [mana/]. Liberte as almas [goodact/]."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_543@BUTTON_4"
msgstr "Molde a energia na essência da vida necessária para forjar a pedra da imortalidade."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_543@TITLE"
msgstr "Sangue e Alma: Consequências"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_549@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "As vozes gritam para que você as siga. Você encontrará a origem de seu sofrimento?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_549@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você pode sentir a presença delas. Não uma, não duas, mas uma amálgama de fantasmas. Todos falando ao mesmo tempo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_555@BODY_FOOTER"
msgstr "O que assombra esta vila não é uma simples maldição, mas uma doença viva: consciente, voraz, descontrolada. O que você fará com ela?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_555@BODY_HEADER"
msgstr "Você fecha os olhos e alcança a presença que assombra esta vila. Ela é sem forma, antiga, paciente."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_555@BODY_LORE"
msgstr "A presença está consciente. Flashes de memória tomam conta de você: um homem de vermelho, rituais experimentais de sangue e almas. Uma doença que infecta o sangue, sangue que infecta a alma, alma que molda o corpo em seu reflexo maligno. Então você entende, você está vendo através dos olhos daqueles tomados pela doença. A doença é a própria presença."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_555@BUTTON_0"
msgstr "Alimente [mana/] e deixe a presença consumir a vila [evilact/], completando sua metamorfose [unit/]."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_555@BUTTON_1"
msgstr "Permita que a presença o infecte [hp/], concedendo-lhe seu poder [xp/]."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_555@BUTTON_4"
msgstr "Isole a doença [unitprod/], seus estudiosos aprenderão [knowledge/] com ela e evitarão que ela se espalhe."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_555@TITLE"
msgstr "Presença Sombria"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_577@BODY_FOOTER@HERO_IS_PALYERLE"
msgstr "A aparição está ligada pela ira e pela dor. Você responderá ao seu chamado?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_577@BODY_HEADER@HERO_IS_PALYERLE"
msgstr "Você ouve um grito de coração partido; um grito de dor sem ferida; um fantasma usando uma careta eterna de agonia."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_579@BODY_FOOTER"
msgstr "Suas tropas libertaram esta terra dessa ameaça. Mas um rastro de cascos fantasmas leva o caminho para um local incerto."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_579@BODY_HEADER"
msgstr "A cavalaria morta jaz derrotada, mas seus fantasmas não encontram descanso."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_579@BODY_LORE"
msgstr "As almas de cavaleiros e cavalos surgem de seus restos. Compelidos por uma força imperativa, eles esporam seus corcéis e galopam para longe. Apenas o Cavaleiro Decapitado resiste ao impulso, por um instante <<p:RiderSoulHero>> vira-se para você. No entanto, por aquele breve momento, você sente a <<o:RiderSoulHero>> desesperação, como se <<p:RiderSoulHero>> não comandasse mais suas próprias ações."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_579@BUTTON_0"
msgstr "Rastreie as aparições equinas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_579@BUTTON_1"
msgstr "Deixe as almas dos cavaleiros."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_579@TITLE"
msgstr "Cavalaria Decapitada"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_580@BODY_FOOTER"
msgstr "A cabeça do fantasma voa para longe, levada por uma entidade desconhecida."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_580@BODY_HEADER"
msgstr "Um fantasma se manifesta na frente de {EventHero}. Inconsciente da <<o:EventHero>> presença."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_580@BODY_LORE"
msgstr "Como se ainda estivesse vivo, o fantasma passeia, falando com uma figura que não está lá. De repente, <<p:HeadlessSoulHero>> vira-se, com medo em <<o:HeadlessSoulHero>> rosto. Você ouve o trovão fantasma de cascos galopando se aproximando — e então, SHUNK! <<Co:HeadlessSoulHero>> cabeça é decepada, voando de <<o:HeadlessSoulHero>> ombros. Uma força invisível a agarra do chão e desaparece na distância."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_580@BUTTON_0"
msgstr "Rastreie para onde leva e enfrete o decapitador."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_580@BUTTON_1"
msgstr "Deixe a alma perdida."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_580@TITLE"
msgstr "Vítima Sem Cabeça"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_583@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Um fantasma se manifesta na sua frente. Inconsciente da sua presença."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_600@BODY_FOOTER"
msgstr "A cabeça do cavaleiro sem cabeça está em suas mãos. Será este o fim do dever de <<o:RiderSoulHero>>?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_600@BODY_HEADER"
msgstr "Os mortos retornaram aos seus túmulos. O cemitério repousa em paz mais uma vez."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_600@BODY_LORE"
msgstr "Ao lado da estátua do cavaleiro, há várias cabeças cortadas e ossos espalhados, cercados por runas pintadas em sangue. Os necromantes usaram esses restos para invocar a cavalaria e subjugá-los à sua vontade. Uma cabeça irradia uma energia assustadora, uma aura que você reconhece do Cavaleiro Decapitado."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_600@BUTTON_0"
msgstr "\"Seu juramento ainda não foi cumprido.\" [item/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_600@BUTTON_1"
msgstr "As almas perdidas [souls/] são suas para reclamar."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_600@BUTTON_4"
msgstr "Purifique a maldição [goodact/] e deixe seu estandarte para trás. [influence/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_600@TITLE"
msgstr "Fim do Meu Dever"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_602@BODY_FOOTER"
msgstr "O cemitério parece esconder grandes perigos."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_602@BODY_HEADER"
msgstr "O relatório do seu batedor é breve: a trilha fantasmagórica termina em um sombrio cemitério."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_602@BODY_LORE"
msgstr "A mensagem é escrita às pressas com uma mão trêmula: \"Acho que consigo ouvir cantos dentro do cemitério. Minha montaria se recusa a se aproximar mais da área. Mas através do portão, vislumbro um grupo ao redor de uma grande estátua de um cavaleiro em seu corcel. Os túmulos aqui estão vazios, {PlayerLeader.Title}. Por favor, tenha cuidado.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_602@BUTTON_0"
msgstr "Prepare suas tropas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_602@BUTTON_5"
msgstr "Deixe as almas perdidas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_602@TITLE"
msgstr "Onde Meus Ossos Repousam"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_623@BODY_FOOTER"
msgstr "O espírito anseia que você construa um grande palácio onde <<p:FluteSoulHero>> possa tocar <<o:FluteSoulHero>> música."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_623@BODY_HEADER"
msgstr "Uma rajada de vento assobia uma melodia. Carregada pela mesma brisa, um espírito toma forma."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_623@BODY_LORE"
msgstr "A flauta de <<Co:FluteSoulHero>> canta com um ritmo dançante, mas cada nota arrasta-se pelo chão com uma melancolia pesada. O espírito percebe a presença de {EventHero} e exclama:\n"
"\"Você pode me ouvir? Você pode me ouvir! Faz décadas desde que alguém pôde. Você... Você serve a um {EventPlayerType}... Com a magia <<o:LeaderType>>, todo o reino <<o:LeaderType>> poderia ouvir minha canção! Por favor, construa um grande palco onde eu possa tocar.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_623@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "A flauta de <<Co:FluteSoulHero>> canta com um ritmo dançante, mas cada nota arrasta-se pelo chão com uma melancolia pesada. O espírito percebe sua presença e exclama:\n"
"\"Você pode me ouvir? Você pode me ouvir! Faz décadas desde que alguém pôde. Você... Você é um {EventPlayerType}... Com sua magia, todo o seu reino poderia ouvir minha canção! Por favor, construa um grande palco onde eu possa tocar.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_623@BUTTON_0"
msgstr "Prometa ao espírito o palco de <<o:FluteSoulHero>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_623@BUTTON_1"
msgstr "Deixe a alma perdida."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_623@TITLE"
msgstr "Última Sinfonia"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_624@BODY_FOOTER"
msgstr "O bardo fantasmagórico agora oferece os serviços de <<o:FluteSoulHero>>. O que você pedirá a <<P:FluteSoulHero>>?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_624@BODY_HEADER"
msgstr "Uma vez que a estrutura é construída, o espírito levanta <<o:FluteSoulHero>> flauta, e a música inunda os salões."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_624@BODY_LORE"
msgstr "A canção ecoa através das câmaras altas que carregam seu nome, seu emblema, sua própria essência. Amplificada pela ligação de seu império com o [hyperlink,GLOBAL.AstralSeaLoreConcept]Mar Astral[/hyperlink], a melodia se espalha por todos os cantos do seu domínio. Quando a nota final desaparece, o espírito se vira para você:\n"
"\"Obrigado. Sempre desejei tocar para um reino inteiro. Antes de desaparecer, permita-me conceder algo em troca.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_624@BUTTON_0"
msgstr "\"Deixe sua flauta para que ainda possamos ouvir sua música.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_624@BUTTON_1"
msgstr "Continue tocando, para que as pessoas venham ao meu reino."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_624@BUTTON_4"
msgstr "Cante uma canção em meu nome."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_624@TITLE"
msgstr "Última Sinfonia: Consequências"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_638@BODY_FOOTER"
msgstr "O espírito oferece a <<o:KingSoulHero>> ajuda em seu novo reinado. O que você pedirá a <<P:KingSoulHero>>?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_638@BODY_HEADER"
msgstr "O fantasma do monarca morto aparece ao seu lado enquanto você recupera {EventHouse}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_638@BODY_LORE"
msgstr "\"O usurpador se foi, e meu domínio agora está em suas mãos. Quão doce é a vitória, e quão passageira. Meu tempo aqui acabou, {PlayerLeader.Name}. No entanto, antes de partir, ainda tenho alguma força dentro de mim. Permita-me oferecer um último presente a este reino ressurgente.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_638@BUTTON_0"
msgstr "Acesso aos arquivos privados de <<o:KingSoulHero>>. [knowledge/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_638@BUTTON_1"
msgstr "Tratados antigos sobre comércio, a serem invocados conforme sua vontade. [gold/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_638@BUTTON_4"
msgstr "Uma carta de recomendação, endereçada às cidades livres do reino. [allegiance/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_638@TITLE"
msgstr "Destronado: Consequências"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_639@BODY_FOOTER"
msgstr "Parece que o antigo monarca de {EventHouse} ainda permanece, exigindo vingança contra o usurpador do trono de <<o:KingSoulHero>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_639@BODY_HEADER"
msgstr "Um espírito aparece diante de {EventHero}, balbuciando e agitando-se em fúria. A voz de <<Co:KingSoulHero>> se eleva em um discurso amargo:"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_639@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Um espírito aparece diante de você, balbuciando e agitando-se em fúria. A voz de <<Co:KingSoulHero>> se eleva em um discurso amargo:"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_639@BODY_LORE"
msgstr " \"Amaldiçoado seja <<p:CityRuler>>! Que os esquemas de <<o:CityRuler>> apodreçam e envenenem o próprio sangue de <<o:CityRuler>>, que a bile de <<o:CityRuler>> queime <<P:CityRuler>> por dentro! <<Cp:CityRuler>> me queria morto, pois <<p:CityRuler>> cobiçou meu reino. E agora estou morto, e meu reino é de <<o:CityRuler>>. Saiba disso, aquele que reina em {EventHouse} não é um Governante legítimo. Não partirei deste mundo até ter minha vingança!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_639@BUTTON_0"
msgstr "\"Eu executarei sua vingança.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_639@BUTTON_1"
msgstr "Deixe a alma perdida."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_639@BUTTON_5"
msgstr "Ensine-me as melhores técnicas de colheita para estas terras."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_639@TITLE"
msgstr "Destronado"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BODY_FOOTER"
msgstr "{EventHero} tornou-se o porta-estandarte desta terrível procissão de almas, e elas reclamam a essência de <<o:EventHero>>. O que <<p:EventHero>> fará?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Você tornou-se o porta-estandarte desta terrível procissão de almas, e elas reclamam sua essência. O que você fará?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BODY_HEADER"
msgstr "O porta-estandarte condenado entrega o pesado estandarte a {EventHero}. Enquanto o aperto de <<o:PilgrimHero>> afrouxa, <<p:PilgrimHero>> desaba sem vida no chão."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "O porta-estandarte condenado entrega a você o pesado estandarte. Enquanto o aperto de <<o:PilgrimHero>> afrouxa, <<p:PilgrimHero>> desaba sem vida no chão."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BODY_LORE"
msgstr "Toda a marcha volta seu olhar para {EventHero}. E então <<p:EventHero>> sente isso—<<o:EventHero>> própria essência é atraída para o estandarte, esvaindo-se como água no solo árido, desaparecendo em um vazio insondável. Os mortos exigem os vivos para liderar sua procissão impiedosa. {EventHero} assumiu o manto do penitente anterior, a maldição é de <<o:EventHero>> agora."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Toda a marcha volta seu olhar para você. E então você sente isso—sua própria essência é atraída para o estandarte, esvaindo-se como água no solo árido, desaparecendo em um vazio insondável. Os mortos exigem os vivos para liderar sua procissão impiedosa. Você assumiu o manto do penitente anterior, a maldição é sua agora."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BUTTON_0"
msgstr "Banir a procissão impiedosa."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BUTTON_1"
msgstr "{EventHero} é mais forte que a maldição, <<p:EventHero>> pode suportá-la."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "Você é mais forte que a maldição, pode suportá-la."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BUTTON_4"
msgstr "Alimente mana [mana/] para o estandarte para saciá-lo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BUTTON_5"
msgstr "Não será a alma [souls/] de <<o:EventHero>> que eles drenarão."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BUTTON_5@HERO_IS_PLAYERLE"
msgstr "Não será sua alma [souls/] que eles drenarão."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BUTTON_6"
msgstr "{EventHero} já caminha entre os mortos [unitUndead/], eles não têm reivindicação sobre <<P:EventHero>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BUTTON_6@HERO_IS_PLAYERLE"
msgstr "Você já caminha entre os mortos [unitUndead/], eles não têm reivindicação sobre você."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@TITLE"
msgstr "Fardo Penitencial"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_641@BODY_FOOTER"
msgstr "O homem condenado implora a {EventHero} que pegue o estandarte de <<o:PilgrimHero>> e alivie <<o:PilgrimHero>> tormento."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_641@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "O homem condenado implora que você pegue o estandarte de <<o:PilgrimHero>> e alivie <<o:PilgrimHero>> tormento."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_641@BODY_HEADER"
msgstr "Uma procissão de espíritos toma forma diante de {EventHero}. No entanto, aquele que a lidera não parece uma alma de forma alguma."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_641@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Uma procissão de espíritos toma forma diante de você. No entanto, aquele que a lidera não parece uma alma de forma alguma."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_641@BODY_LORE"
msgstr "A marcha avança em duas longas linhas, cada peregrino fantasma segurando uma vela acesa. Todos, exceto um, a figura na frente. Cadavérico e sombrio, <<p:PilgrimHero>> carrega um estandarte pesado, a voz oca de <<o:PilgrimHero>> chama {EventHero}:\n"
"\"Misericórdia, carregue meu fardo, se apenas por um momento.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_641@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "A marcha avança em duas longas linhas, cada peregrino fantasma segurando uma vela acesa. Todos, exceto um, a figura na frente. Cadavérico e sombrio, <<p:PilgrimHero>> carrega um estandarte pesado, a voz oca de <<o:PilgrimHero>> chama você:\n"
"\"Misericórdia, carregue meu fardo, se apenas por um momento.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_641@BUTTON_0"
msgstr "Ajude o porta-estandarte."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_641@BUTTON_1"
msgstr "Deixe a alma perdida."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_641@TITLE"
msgstr "Procissão Profana"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_223@BODY_FOOTER"
msgstr "\"Se você quer meu sangue, então traga-me a Rosa de Obsidiana do palácio em ruínas de {Emperor.FirstName} e coloque-a aos meus pés. A oferta é feita, pequeno '[hyperlink,GLOBAL.ElderVampireLoreConcept]Ancestral[/hyperlink].' Estarei observando você, tchau-tchau.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_223@BODY_HEADER"
msgstr "\"Tut-tut, pequeno animal de estimação,\" ronrona {Wife.TitleFirstName}, \"Como você pretende entrar no local de descanso final de <<Co:Emperor>> sem nem mesmo o meu sangue, hmm?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_223@BODY_HEADER@DONT_KNOW"
msgstr "{Wife.TitleFirstName} curva <<o:Wife>> lábio. \"Aww, não é adorável? Como você gostaria se a mãe lhe desse um pouco de—motivação?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_223@BODY_HEADER@RESIST_WIFE"
msgstr "{Wife.TitleFirstName} irrompe em uma gargalhada trêmula. \"Oh, como é delicioso! Sua resistência mesquinha é simplesmente... Mhh, irresistível. Eu preciso de mais disso!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_223@BODY_LORE"
msgstr "\"Sim, eu decidi, você pode ficar,\" sorri {Wife.TitleFirstName}. \"Sem dúvida, você veio aqui para desvendar aquela cripta fétida do meu marido apodrecido, {Emperor.FirstName}. Mas para fazer isso, primeiro precisa do meu sangue exaltado, com o qual aquele lugar está completamente selado. No entanto, se você pretende matar aquele bastardo miserável, então eu posso estar aberta a fazer um pequeno—negócio...\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_223@BUTTON_0"
msgstr "\"Vou considerar isso.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_223@BUTTON_1"
msgstr "\"Terei seu sangue por tocar as cordas do meu coração!\" [influence/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_223@BUTTON_2"
msgstr "\"Não, obrigado.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_223@TITLE"
msgstr "Chave para as Cordas do Meu Coração"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_223@TITLE@DONT_KNOW"
msgstr "{Wife.TitleFirstName} torce <<o:Wife>> lábio. “Ah, não é isso adorável. Como você gostaria se a mãe te desse um pouco de... motivação?” (WIP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_223@TITLE@RESIST_WIFE"
msgstr "{Wife.TitleFirstName} irrompe em uma gargalhada nervosa. “Oh, como é delicioso! Sua pequena resistência é simplesmente... Mmm, irresistível. Eu preciso de mais!” (WIP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_224@BODY_FOOTER"
msgstr "{Wife.TitleFirstName} <<o:Wife>> olhar malevolente sonda sua visão e fere suas cordas do coração... \"Diga-me, meu doce, o que te traz ao meu domínio?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_224@BODY_HEADER"
msgstr "Sombras estranhas cegam seus sentidos, então um sussurro agudo entra em seu ouvido interno... \"O que é isso que eu encontro, um '{GLOBAL.ElderVampireLoreConcept.Hyperlink}' desconhecido vagando pelo meu reino? Depois de todo esse tempo.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_224@BODY_LORE"
msgstr "Das trevas mais profundas surge a forma aterrorizante de um {GLOBAL.ArchvampireLoreConcept.Hyperlink}, {Wife.TitleName}, famosa autora do Tomo do Tormento e primeira esposa do [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] <<Cr:Emperor>>. <<Cp:Wife>> te inspeciona com um olhar predatório, então levanta <<o:Wife>> queixo e produz um sorriso fraco e com presas. De repente, seu peito começa a doer! Parece que <<p:Wife>> está lançando algum tipo de feitiço em você."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_224@BUTTON_0"
msgstr "\"Para despertar o Deus Imortal.\" [xp/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_224@BUTTON_1"
msgstr "Permanecer em silêncio."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_224@BUTTON_2"
msgstr "\"Isso não é da sua conta!\" [relationLvl3/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_224@BUTTON_4"
msgstr "Resistir ao feitiço de <<P:Wife>>. [mana/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_224@BUTTON_5"
msgstr "\"Eu vim por sangue, o seu em particular!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_224@TITLE"
msgstr "A Arci-Dama do Túmulo"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_225@BODY_FOOTER"
msgstr "{Wife.TitleFirstName} treme toda de fúria. \"Na verdade, este é o pedido que eu te faço ao conceder meu sangue para abrir a cripta fétida de <<Co:Emperor>>... Mate <<CP:Emperor>>!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_225@BODY_HEADER"
msgstr "\"Magnífico!\" guincha {Wife.TitleFirstName}. \"Meu, oh meu, você parece saber o caminho para o coração de um Vampiro com precisão mortal. Podemos ter um interesse em comum aí, meu doce.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_225@BODY_LORE"
msgstr "{Wife.TitleFirstName} estuda a Rosa Cruor com uma careta feérica e melancólica. \"Esta rosa sangrenta foi cultivada para <<Co:Emperor>>... <<Co:Emperor>> bruxa maldita...\" <<Cp:Wife>> fecha <<P:Wife>> olhos por um momento e pressiona a rosa contra <<o:Wife>> seio. Então, <<P:Wife>> olhos brilham abertos com um olhar sedento por sangue. \"Sim. Eu quero <<P:Emperor>> morto!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_225@BUTTON_0"
msgstr "\"Eu cuidarei de tudo.\" [rs_alliance/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_225@BUTTON_1"
msgstr "\"Não, obrigado. Agora me entregue seu sangue!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_225@BUTTON_2"
msgstr "\"Qualquer coisa, por um preço...\" [thralls/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_225@BUTTON_3"
msgstr "\"O que você quiser. Primeiro me fortaleça através da dor!\" [xp/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_225@TITLE"
msgstr "Chave para as Cordas do Meu Coração: Conquistada"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_240@BODY_FOOTER"
msgstr "Com a cripta de <<Po:Emperor>> agora desselada e vazia, a herança do trono de '{Emperor.Name}' permanece sua para ser tomada—título, trono e tudo..."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_240@BODY_HEADER"
msgstr "Pela sua mão, o [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] foi derrotado. Um ato que é sentido por [hyperlink,GLOBAL.ArchvampireLoreConcept]Arquivampiros[/hyperlink] longe e perto, por todo o {GLOBAL.AstralSeaLoreConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_240@BODY_LORE"
msgstr "Embora eles possam não saber ainda seu nome, todos os Arcisires e Arcidamas saberão de você por seus feitos, e temerão você para sempre por isso! Pois, se um Vampiro poderia matar o imortal—Sire de todos—o que então impede os Descendentes de se levantarem contra seus próprios Sires em completa e total anarquia? Assim, por essa crença, nasce uma nova era manchada de sangue para toda a espécie Vampiro."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_240@BUTTON_0"
msgstr "\"Sangue por sangue!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_240@TITLE"
msgstr "Cripta do Deus Imortal: Destruída"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_248@BODY_FOOTER"
msgstr "Ninguém entrou em {EventRealm} desde então, até agora. Enquanto uma noite destinada amanhece ao uivo distante de lobos, você é deixado para refletir sobre o motivo pelo qual veio aqui..."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_248@BODY_HEADER"
msgstr "Diante de você se estende um reino sem sol de mito e lenda, mais antigo que as memórias mais antigas de até mesmo a maioria dos {GLOBAL.GodirLoreConcept.Hyperlink}. Aqui, a linhagem de sangue puro começou há muito tempo e alcançou seu zênite histórico."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_248@BODY_LORE"
msgstr "Naqueles dias passados, a espécie Vampiro governou um domínio sedento por sangue que aterrorizou o {GLOBAL.AstralSeaLoreConcept.Hyperlink}. Naquela época, todos os sangue-puro estavam unidos sob um 'imperador eterno', agora lembrado apenas como o '[hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink]'. Se por arrogância ou traição, esse domínio de terror acabou desmoronando e foi banido para {GLOBAL.GrexolisLoreConcept.Hyperlink} por razões há muito esquecidas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_248@BUTTON_0"
msgstr "\"A traição desfez nossa grandeza, mas eu pretendo restaurá-la novamente!\" [influence/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_248@BUTTON_1"
msgstr "\"A arrogância causou a queda de Drevanya, eu pretendo terminar o trabalho.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_248@BUTTON_2"
msgstr "\"A noite me convocou aqui, seus filhos [unit/] me mostrarão o caminho.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_248@BUTTON_3"
msgstr "\"Quem se importa com o passado? Eu só tenho fome de sangue!\" [xp/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_248@TITLE"
msgstr "A Noite Cai sobre Rued Drevanya"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_257@BODY_FOOTER"
msgstr "Para quem você dá a Rosa Cruor? (TEMP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_257@BODY_HEADER"
msgstr "Você conseguiu a Rosa Obsidiana. (TEMP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_257@BODY_LORE"
msgstr "Dê esta rosa a um dos cônjuges para ganhar sua confiança e ser oferecido uma aliança. (TEMP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_257@BUTTON_0"
msgstr "Dê a Rosa à Princesa Consorte Mavelith (TEMP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_257@BUTTON_1"
msgstr "Dê a Rosa ao Príncipe Consorte Wtorakh (TEMP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_257@BUTTON_2"
msgstr "Nenhum! Pegue para você mesmo. (TEMP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_257@TITLE"
msgstr "Trapaça da Rosa Obsidiana (TEMP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_264@BODY_FOOTER"
msgstr "{Husband.TitleFirstName} passa os dedos <<o:Husband>> nos lábios brilhantes enquanto <<p:Husband>> secretamente lança um feitiço em você que ferve seu sangue. \"Mostre-me como um Vampiro adequado cumprimenta seu superior.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_264@BODY_HEADER"
msgstr "Uma ocorrência estranha de borbulhar e ferver entra em sua consciência, seguida por um baixo assobio... \"Meu, oh meu... Que brinquedo anômalo e peculiar eu espio aqui?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_264@BODY_LORE"
msgstr "Do canto do seu olho, você vê uma névoa carmesim quente irromper, da qual emerge uma figura ensopada de sangue com postura distinta: o lendário {GLOBAL.ArchvampireLoreConcept.Hyperlink}, {Husband.TitleFirstName}. \"Depois de eras de solidão, finalmente sou agraciado com um rosto novo e fresco - e que rosto é esse... Você é 'um dos meus', talvez? Não importa, eu acredito que as apresentações estão em ordem, você não concorda? Ou sua geração abandonou suas maneiras como eles um dia abandonaram o {Emperor.Title}?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_264@BUTTON_0"
msgstr "Curve-se baixo e cortêsmente. [relationLvl3/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_264@BUTTON_1"
msgstr "Simplesmente observe <<P:Husband>> em silêncio."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_264@BUTTON_2"
msgstr "Fique em pé e zombar de <<P:Husband>> em desafio! [influence/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_264@BUTTON_3"
msgstr "Ofereça a <<P:Husband>> um sacrifício fresco de sangue. [thralls/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_264@BUTTON_4"
msgstr "\"Ninguém é meu superior. Pereça você, palhaço!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_264@TITLE"
msgstr "Primeiras Impressões Ferventes"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_268@BODY_FOOTER"
msgstr "\"Se você se comprometer comigo, seu fabuloso Príncipe, <<p:Husband>>, a Rosa Obsidiana do palácio do [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink]. Então eu estaria aberto a compartilhar uma gota do meu sangue mais puro.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_268@BODY_HEADER"
msgstr "\"Encantado, certamente,\" sorri o {Husband.Title} com um aceno. \"Ah, juventude, me lembra de mim mesmo naquela idade, contornando a etiqueta e a insolência. Tão ousado, tão audacioso.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_268@BODY_HEADER@BOW_LOW"
msgstr "\"Por que, meu caro suplicante,\" reconhece {Husband.TitleFirstName}, enquanto <<p:Husband>> faz uma reverência aristocrática em retorno, \"Você honra seu Príncipe^m com uma verdadeira classe de cortesia.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_268@BODY_HEADER@RESIST_HUSBAND"
msgstr "\"Oh? Você, um [hyperlink,GLOBAL.ElderVampireLoreConcept]Ancestral[/hyperlink], ousa me desafiar? Um {GLOBAL.ArchvampireLoreConcept.Hyperlink}?\" ri {Husband.TitleFirstName} com um rosnado bestial. \"Quão delicioso, quão delicioso, quão... Debonair!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_268@BODY_LORE"
msgstr "\"Vamos conduzir os negócios, não é mesmo,\" começa o {Husband.Title}. \"Eu sei tudo sobre você, {Player.Name}. Procurando abrir a cripta do nosso sagrado '{Emperor.Title}', não é? Para este propósito, precisaria do sangue dos Consortes de <<Co:Emperor>> — como o meu. Agora, devido à sua... digamos... notável introdução, ouso dizer que estou sentindo o desejo de — potencialmente — considerar seu empreendimento ousado. Em troca, naturalmente, por um pequeno sacrifício.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_268@BUTTON_0"
msgstr "\"Vou considerar isso.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_268@BUTTON_1"
msgstr "\"Terei seu sangue por ferver o meu!\" [influence/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_268@BUTTON_2"
msgstr "\"Não, obrigado.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_268@TITLE"
msgstr "Chave do meu Desejo"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_269@BODY_FOOTER"
msgstr "<<Cp:Husband>> esmaga lentamente a Rosa de Obsidiana em <<o:Husband>> punho e lambe a seiva preta de <<o:Husband>> palma. \"Você pode guardar um segredinho, meu novo aliado?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_269@BODY_HEADER"
msgstr "\"Para mim? Oh, não deveria,\" finge {Husband.TitleFirstName}. \"Por que, que espécime magnífico, esplêndido; como, é claro, é a rosa...\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_269@BODY_LORE"
msgstr "Cheirando a rosa, <<p:Husband>> olha para você com um piscar lento. \"Ah, o cheiro do amor verdadeiro,\" sorri o {Husband.Title}, \"Quão nulo... Bem, então, vamos lá. Vamos considerar este magnífico empreendimento seu, hmm? Imagine se nós acordássemos o [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink], então o que? Louvor e glória? Oh não, devo avisá-lo: meu Sire^m não é um conto de fadas e agradar <<CP:Emperor>> é uma tolice de fato. Não, nosso antigo Criador, esplêndido como <<Cp:Emperor>> pode ser, é uma mente extremamente maligna que não aceita iguais — se você 'entende o que quero dizer...'\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_269@BUTTON_0"
msgstr "\"Mas é claro, meu Príncipe.\" [rs_alliance/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_269@BUTTON_1"
msgstr "\"Não, obrigado. Agora me dê seu sangue!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_269@BUTTON_2"
msgstr "\"Por um preço [thralls/], é claro.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_269@BUTTON_3"
msgstr "\"Meu Príncipe, você me lisonjeia. Segredos são minha especialidade.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_269@TITLE"
msgstr "Chave do meu Desejo: Conquistada"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_273@BODY_FOOTER"
msgstr "\"Se você também está aqui para matar este 'Deus Imortal', então tenho uma oferta para fazer,\" <<p:Huntress>> propõe, lentamente abaixando <<o:Huntress>> braços."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_273@BODY_HEADER"
msgstr "Um fedor mortal entra em suas narinas. Então, uma figura sombria e espreitadora aparece à vista. \"Eu conheço um Vampiro quando vejo um.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_273@BODY_LORE"
msgstr "Mantendo <<P:Huntress>> mão perto de <<P:Huntress>> arma, <<p:Huntress>> ainda assim olha para você com um sorriso sombrio. \"Você não é daqui, é? Acho que você também busca descobrir esse tal '[hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink]', não é? Bem, eu também, {Huntress.TitleFirstName}. Meus motivos não precisam de explicação, eu acho.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_273@BUTTON_0"
msgstr "Ouça a oferta dela, por enquanto..."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_273@BUTTON_1"
msgstr "“Eu conheço uma caçadora quando cheiro uma, prepare-se para morrer!” (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_273@TITLE"
msgstr "Dois Predadores Cruzando"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_277@BODY_FOOTER"
msgstr "\"Declare guerra tanto a {Wife.FirstName} quanto a {Husband.FirstName},\" anuncia {Huntress.FirstName} sombriamente. \"Assim eu sei que posso confiar em você. Nós matamos os Consortes, pegamos o sangue deles e matamos [hyperlink,GLOBAL.UrvatoghLoreConcept]Urvatogh[/hyperlink] de uma vez por todas. O que você diz?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_277@BODY_HEADER"
msgstr "{Huntress.FirstName} retorna um sorriso fino e honesto. \"Obrigado por me ouvir. Vou direto ao ponto.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_277@BODY_LORE"
msgstr "\"Minha pesquisa me diz que a cripta deste '[hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink]' está trancada com um ritual de sangue, lançado pelos Consortes de <<o:Emperor>>,\" explica {Huntress.FirstName}. \"A maioria destes fugiu do reino antes que ele fosse selado, exceto dois: {Wife.TitleFirstName} e {Husband.TitleFirstName}. Então eles estão em nosso caminho. Felizmente, eles também se odeiam, então, se você quer abrir aquela cripta, é isso que fazemos...\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_277@BUTTON_0"
msgstr "\"Vou pensar sobre isso.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_277@BUTTON_1"
msgstr "\"Por que eu deveria confiar em um Caçador de Vampiros? Vá embora!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_277@BUTTON_2"
msgstr "\"Como você ousa desperdiçar meu tempo, morra!\" [influence/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_277@BUTTON_3"
msgstr "\"Já está feito.\" [influence/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_277@TITLE"
msgstr "Inimigo do Meu Inimigo"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_278@BODY_FOOTER"
msgstr "<<Cp:Huntress>> engata <<o:Huntress>> bestas e te lança um olhar determinado. \"Vamos caçar alguns Vampiros.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_278@BODY_HEADER"
msgstr "\"Bem feito,\" diz {Huntress.FirstName} com uma careta levemente perplexa."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_278@BODY_HEADER@BADASS"
msgstr "{Huntress.FirstName} olha para você com <<o:Huntress>> boca levemente aberta, antes de se corrigir <<r:Huntress>> com um sorriso surpreso."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_278@BODY_LORE"
msgstr "\"Serei honesto, duvidei que você faria isso. Com nós estando em lados diferentes, por assim dizer. Mas agora que você declarou guerra contra aqueles [hyperlink,GLOBAL.ArchvampireLoreConcept]sugadores ancestrais[/hyperlink], estou bastante ansioso para ver isso até o fim.\" <<Cp:Huntress>> remexe em <<co:Huntress>> bolsa, então olha para você, antes de jogar uma bolsa que chacoalha. \"Não se preocupe, é ouro. Essa é a primeira metade da recompensa, porque agora as coisas vão ficar sérias, muito em breve.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_278@BUTTON_0"
msgstr "\"Me diga seu plano.\" [rs_defensivepact/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_278@BUTTON_1"
msgstr "\"Obrigado pelo ouro, tolo. Agora morra!\" [evilact/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_278@BUTTON_2"
msgstr "\"Eu preciso de mais [gold/] ouro do que isso antes de começar a ouvir.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_278@TITLE"
msgstr "Inimigo do meu Inimigo: Meu Amigo"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_284@BODY_FOOTER"
msgstr "{Wife.TitleFirstName} sorri com luxúria, \"Não há mais pedidos de misericórdia. Eu te verá em minhas masmorras!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_284@BODY_HEADER"
msgstr "Por um breve momento, {Wife.TitleFirstName} curva <<o:Wife>> lábio e te lança um olhar desanimado."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_284@BODY_LORE"
msgstr "\"Ah...\" <<p:Wife>> suspira levemente, \"Parece que você prefere o caminho da dor, que pena. Bem, para você pelo menos. Eu, por outro lado, vou ansiar para fazer você guinchar, meu travesso [hyperlink,GLOBAL.ElderVampireLoreConcept]Ancestral[/hyperlink].\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_284@BUTTON_0"
msgstr "\"Que assim seja.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_284@TITLE"
msgstr "Dor e Traição"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_285@BODY_FOOTER"
msgstr "\"Minha mente está decidida,\" sorri o {Husband.Title} enquanto <<p:Husband>> olha para longe. \"Lamente este dia, plebeu. Você logo aprenderá seu devido lugar.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_285@BODY_HEADER"
msgstr "Por um breve instante, ou até dois, {Husband.TitleFirstName} franze a testa e te lança um olhar dolorido."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_285@BODY_LORE"
msgstr "\"Oh, bem,\" começa <<p:Husband>>, com um gesto casual de <<o:Husband>> pulso, \"O que mais eu poderia esperar de um rústico como um '{GLOBAL.ElderVampireLoreConcept.Hyperlink}'? Não importa, parece que devo obter minha adoração 'do jeito usual...' À força.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_285@BUTTON_0"
msgstr "\"Que assim seja.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_285@TITLE"
msgstr "Traição Fervente"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_290@BODY_FOOTER"
msgstr "\"É aqui que você entra, meu doce,\" sorri {Wife.FirstName}. \"Tome meu sangue, procure a cripta de <<Co:Emperor>> e mate aquele porco vil por mim! Isso me libertaria da influência de <<Co:Emperor>>, finalmente!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_290@BODY_HEADER"
msgstr "\"Oh, eu gosto de você,\" observa {Wife.TitleFirstName} com um sorriso dentuço. \"Confio em você também. É por isso que vou revelar a verdade a você, e apenas a você.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_290@BODY_LORE"
msgstr "\"Eu fui a primeira vítima de <<Co:Emperor>>, sabe. E quando {Emperor.FirstName} me transformou, <<Cp:Emperor>> lançou uma maldição de controle mental que me impedia de jamais machucar <<CP:Emperor>>. Oh, eu odiava ser um Vampiro, e <<Cp:Emperor>> gostava de me fazer sofrer. Eu implorava pela morte, mas <<Cp:Emperor>> me negava todas as vezes. Então, eu jurei ver <<CP:Emperor>> destruído! No entanto... Todo esse tempo eu estava impotente para fazer isso sozinha.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_290@BUTTON_0"
msgstr "\"Vamos matar <<CP:Emperor>>, juntos.\" [relationLvl3/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_290@BUTTON_1"
msgstr "\"Qualquer coisa, por um preço...\" [gold/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_290@BUTTON_2"
msgstr "\"Não, obrigado, eu vou sozinho.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_290@TITLE"
msgstr "Sangue por Sangue"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_291@BODY_FOOTER"
msgstr "Longe dali, um lobo uiva na noite, sinalizando o amanhecer de uma nova era para todos os Vampiros. Com o trono agora vago, é seu para reclamar — e compartilhar."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_291@BODY_HEADER"
msgstr "Enquanto a poeira da guerra se assenta e uma nova lua surge sobre este reino, {Wife.FirstName} aparece ao seu lado com um sorriso estranhamente sincero. \"Liberdade...\" <<p:Wife>> sussurra."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_291@BODY_LORE"
msgstr "\"Eu perdi a conta das eras em que esse bastardo miserável me atormentou. Ver <<P:Emperor>> derrotado enche meu coração frio e sem vida com... Com...\" De repente, {Wife.FirstName} agarra <<o:Wife>> peito com um suspiro. Então olha para você com um sorriso largo, dentuço e olhos curiosos e perolados. \"O quê?\" <<p:Wife>> ri, enquanto um leve rubor enche <<o:Wife>> rosto. \"Não fique só olhando para sua Princesa assim, faça algo.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_291@BUTTON_0"
msgstr "Ofereça a {Wife.FirstName} sua mão."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_291@TITLE"
msgstr "Sangue por Sangue: Lua Nova"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_295@BODY_FOOTER"
msgstr "\"Você, no entanto, pode fazer o que eu não pude\", provoca o {Husband.Title}. \"Vá para a cripta de <<Co:Emperor>> e acabe com o {Emperor.Title} de uma vez por todas! Então, eu serei livre!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_295@BODY_HEADER"
msgstr "{Husband.TitleFirstName} suspira. \"Ser um {GLOBAL.ArchvampireLoreConcept.Hyperlink} não é tudo o que parece...\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_295@BODY_LORE"
msgstr "\"Eu estava lá quando nossa espécie foi 'criada', quando as bênçãos de <<Co:Emperor>> foram distribuídas pela primeira vez. E também, a maldição de <<Co:Emperor>>... Estar ligado ao [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] por toda a eternidade e seguir a vontade dominante de <<Co:Emperor>> como um miserável fantoche em cordas ensanguentadas. Ugh, {Emperor.FirstName} me fez fazer... coisas 'indizíveis', e eu não tinha vontade de negar <<CP:Emperor>>. Então sim, eu admito, eu conspirei com {Wife.FirstName} e os outros para selar <<CP:Emperor>>! Pois, como a prole miserável de <<Co:Emperor>>, eu não podia matar <<CP:Emperor>>...\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_295@BUTTON_0"
msgstr "\"Vamos acabar com <<CP:Emperor>> juntos, meu Príncipe.\" [relationLvl3/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_295@BUTTON_1"
msgstr "\"Por um preço [gold/], é claro.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_295@BUTTON_2"
msgstr "\"Não, obrigado, eu vou sozinho.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_295@TITLE"
msgstr "Sedento por Regicídio"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_296@BODY_FOOTER"
msgstr "Longe dali, um lobo uiva na noite, sinalizando o amanhecer de uma nova era para todos os Vampiros. Com o trono agora vago, é seu para reclamar — e compartilhar."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_296@BODY_HEADER"
msgstr "Enquanto a poeira da batalha se assenta, uma nova lua surge sobre Drevanya. E neste momento {Husband.TitleFirstName} vem até você com um sorriso diabólico."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_296@BODY_LORE"
msgstr "\"Oh meu, o gosto da liberdade\", sussurra {Husband.FirstName}. \"É a coisa mais — maravilhosa! E pensar que tenho você, meu querido {Player.FirstName}, para agradecer por isso.\" Um momento de silêncio passa enquanto {Husband.FirstName} apenas olha para você com um deleite curioso. \"O trono imperial de Drevanya está parecendo terrivelmente 'vazio', não acha? Que tal, você e eu o aquecermos um pouco? Eu conheço justamente o feitiço.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_296@BUTTON_0"
msgstr "Aceite a oferta de {Husband.FirstName}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_296@TITLE"
msgstr "Sedento por Regicídio: Saciado"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_300@BODY_FOOTER"
msgstr "{Huntress.FirstName} olha nos seus olhos com determinação furiosa. \"{Emperor.FirstName} deve ser parado. Vá, liderar o caminho para a {EventStructure}, apenas um Vampiro pode entrar nela.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_300@BODY_HEADER"
msgstr "\"Antes de começarmos\", suspira {Huntress.FirstName}, \"eu acho importante que você saiba contra o que estamos lutando...\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_300@BODY_LORE"
msgstr "\"Você provavelmente não precisa ser lembrado do que está em jogo aqui, mas deixe-me explicar para você, independentemente. {Emperor.FirstName} criou os [hyperlink,GLOBAL.ArchvampireLoreConcept]Arquivampiros[/hyperlink], como {Wife.FirstName} e {Husband.FirstName}. Estes, por sua vez, criaram a maioria dos [hyperlink,GLOBAL.ElderVampireLoreConcept]Vampiros Ancestrais[/hyperlink], como você. Se {Emperor.FirstName} retornasse, todos os Arquivampiros e sua prole se juntariam instantaneamente ao lado de <<o:Emperor>>. Juntos, eles desatariam uma frente unida e imparável contra todos os {GLOBAL.WorldsWithinLoreConcept.Hyperlink}!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_300@BUTTON_0"
msgstr "\"Vamos matar este 'Deus Imortal', juntos.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_300@BUTTON_1"
msgstr "\"Em segundo pensamento, irei em frente sozinho.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_300@BUTTON_2"
msgstr "\"Tolo ignorante. Eu anseio ver todos os Vampiros unidos! Agora morra!\" [evilact/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_300@BUTTON_3"
msgstr "\"Sim {Huntress.FirstName}, olhe nos meus olhos...\" [evilact/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_300@TITLE"
msgstr "Morte ao Deus Imortal"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_301@BODY_FOOTER"
msgstr "Longe dali, um lobo uiva na noite, inaugurando uma nova era para os Vampiros. O que o futuro reserva, ninguém pode dizer, e talvez seja melhor assim."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_301@BODY_HEADER"
msgstr "Com o banimento de <<o:Emperor>> completo, a cripta do [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] está em ruínas diante de você e seu trabalho aqui está concluído."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_301@BODY_LORE"
msgstr "\"Coisa impressionante,\" observa {Huntress.FirstName} com um notável tom de admiração. <<Cp:Huntress>> fica ao seu lado por um tempo e absorve a devastação que você causou. \"Eu digo sério, sabe. Você impediu que os [hyperlink,GLOBAL.ArchvampireLoreConcept]Arqui-vampiros[/hyperlink] se reunissem sob um mestre comum, novamente. Eu tenho que admitir, nunca pensei que sentiria qualquer tipo de admiração por um Vampiro na minha vida, mas você... Bem, você mudou tudo.\" {Huntress.FirstName} para e ri. \"Qual é o seu nome, afinal?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_301@BUTTON_0"
msgstr "Caminhar para a noite."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_301@TITLE"
msgstr "Herói Anônimo da Noite"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_305@BODY_FOOTER"
msgstr "Prepare-se bem! Explore o {EventStructure} para enfrentar o [hyperlink,GLOBAL.UrvatoghLoreConcept]Progenitor Vampiro[/hyperlink] <<Cr:Emperor>> e trazer o tão esperado Julgamento de Sangue."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_305@BODY_HEADER"
msgstr "Com o sangue da Consorte em sua posse, você finalmente pode desvendar a cripta que o atraiu para este reino."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_305@BODY_LORE"
msgstr "Todos os Vampiros têm sua origem em uma única fonte: o [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink], o Sire^m de todos, <<Cp:Emperor>> que espalhou <<Co:Emperor>> bênção e <<Co:Emperor>> maldição sobre o {GLOBAL.WorldsWithinLoreConcept.Hyperlink} desde a [hyperlink,GLOBAL.ArchvampireLoreConcept]Primeira Ninhada[/hyperlink], até mesmo para você. As terras sem sol, os rios de sangue, a fome e o poder, tudo isso surgiu através do incrível e terrível poder de <<Co:Emperor>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_305@BUTTON_0"
msgstr "\"Eu sou o julgamento.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_305@BUTTON_1"
msgstr "... Alimente-se de seus escravos por sangue. (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_305@BUTTON_2"
msgstr "... Alimente-se de seus escravos por glória. (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_305@TITLE"
msgstr "Peregrinação Sepulcral"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_306@BODY_FOOTER"
msgstr "Longe dali, um lobo uiva na noite. Com o [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] derrotado, o trono e o título de <<o:Emperor>> permanecem vagos para serem tomados..."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_306@BODY_HEADER"
msgstr "Sangue por sangue! Por sua mão, {Emperor.Name} foi derrotado e as lendas de sua grandeza 'imortal' foram provadas falsas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_306@BODY_LORE"
msgstr "Este foi o 'Julgamento de Sangue' que iniciou uma nova era para todos os Vampiros, uma livre da opressiva herança de seu criador. Suas ações neste reino nivelaram a hierarquia que há muito segmentava os Vampiros, desde tempos imemoriais. Pois se você, um {GLOBAL.ElderVampireLoreConcept.Hyperlink} poderia derrubar o [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] sem consequências, o que então impede os Vampiros Menores de se rebelarem contra seus próprios Sires? Não, seu legado certamente inspirará gerações de Vampiros que se esforçarão para seguir seus passos."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_306@BUTTON_0"
msgstr "\"Meu legado será eterno.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_306@TITLE"
msgstr "Um Legado Eterno"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_315@BODY_FOOTER"
msgstr "\"{Player.FirstName}, meu libertador,\" <<p:Emperor>> declara sombriamente. \"Eu sonhei com este momento por dias sem número. E agora, como uma prece feita carne, você veio. Bem-vindo.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_315@BODY_HEADER"
msgstr "Uma melodia austera e assombrosa reverbera pelos salões e corredores de pedra escura abandonados pela luz, que compõem a necrópole subterrânea sob o monte sangrante."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_315@BODY_LORE"
msgstr "Seguir a música até sua fonte revela uma cidade esquecida dos mortos, imersa em um leitmotiv majestoso, mas triste, reminiscente de um amor perdido há muito tempo. Então, a música termina abruptamente e um silêncio tirânico conquista completamente o vazio auricular, um silêncio tão intenso que cria um vácuo profundo no próprio esquecimento. No entanto, desse vazio, emerge uma voz profunda e sonora, imersa em soberania e remorso imemoriais..."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_315@BUTTON_0"
msgstr "\"Revele-se.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_315@BUTTON_1"
msgstr "(DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_315@BUTTON_2"
msgstr "Lute e desafie o Deus Imortal! (WIP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_315@TITLE"
msgstr "Prelúdio para uma Escuridão sem Lua"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_319@BODY_FOOTER"
msgstr "\"Começamos imediatamente. Destrua todos que restam no reino, não deixe nenhuma alma viva, ou não-viva. Não me importa como será feito, mas batize a nova Drevanya completamente com o sangue deles!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_319@BODY_HEADER"
msgstr "Por um breve instante, {Emperor.FirstName} fecha <<Co:Emperor>> os olhos e derrama uma única lágrima. Então, <<Cp:Emperor>> pisca <<Co:Emperor>> os olhos com resolução imperial. \"Drevanya ressurgirá.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_319@BODY_LORE"
msgstr "<<Cp:Emperor>> olha para você, e uma escuridão cai sobre <<Co:Emperor>> rosto. \"Desencadearmos um Julgamento Sangrento sobre o {GLOBAL.AstralSeaLoreConcept.Hyperlink} que instilará medo nos corações de todos. Começando com minhas criações falhas, {Wife.FirstName} e {Husband.FirstName}, aqueles miseráveis sediciosos e ingratos que ainda se chamam meus Consortes, assim como qualquer um que ouse se opor a nós.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_319@BUTTON_0"
msgstr "\"Sua vontade será feita.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_319@BUTTON_1"
msgstr "\"Veja, já fiz como você deseja!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_319@TITLE"
msgstr "Julgamento Sobre os Traidores"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_320@BODY_FOOTER"
msgstr "\"Junte-se a mim em união, {Player.FirstName}, e juntos dominaremos o vasto {GLOBAL.AstralSeaLoreConcept.Hyperlink} com um domínio vampírico mais grandioso do que antes.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_320@BODY_HEADER"
msgstr "Com todo o reino coberto pelo sangue dos traidores, {Emperor.Name} aparece ao seu lado com um olhar sombrio e pensativo. \"Você fez bem.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_320@BODY_LORE"
msgstr "<<Cp:Emperor>> suspira, então se vira para você com um sorriso distante. \"Quando eu era mais jovem,\" começa <<Cp:Emperor>>, \"cometi o erro de saciar o vazio no meu coração não-vivo com o conforto ocioso de Consortes indulgentes. Desde então, tive uma eternidade para reconsiderar meus apetites infantis e chegar à compreensão de que a parceria é, em última análise, uma união de poder. E neste dia, {Player.FirstName}, você é o Vampiro mais poderoso que já conheci.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_320@BUTTON_0"
msgstr "\"O julgamento é nosso.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_320@TITLE"
msgstr "Um Julgamento Sem Igual"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_341@BODY_FOOTER"
msgstr "Sussurros assobiantes emanam do abismo coberto de sombras encontrado abaixo do altar sacrificial... (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_341@BODY_HEADER"
msgstr "Você sacrificou o Juramento do Amado e limpou a cripta, mas não descobriu o Deus Imortal... (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_341@BODY_LORE"
msgstr "O corpo rígido do Vampiro era um truque, este não é o Deus Imortal. Onde Ele poderia ser encontrado? O coração se foi, a fonte de sangue foi toda drenada para o chão... Mas espere! Ao inspecionar o altar, um contorno peculiar é detectado no pódio, o altar de ébano esculpido pode ser movido para revelar um grande abismo abaixo. (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_341@BUTTON_0"
msgstr "\"Poderia ser?\"... (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_341@TITLE"
msgstr "Profanando a Cripta Profana (EVENTO MARCADOR)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_377@BODY_FOOTER"
msgstr "Eis a {EventStructure} abandonada. Seus salões e corredores sombreados são ditos abrigar segredos indizíveis, bem como uma única rosa de esplendor lendário..."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_377@BODY_HEADER"
msgstr "Sobre aquela colina desponta uma estrutura impressionante, mas dolorosa. Parece abandonada, embora ainda emane uma aura poderosa e maligna."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_377@BODY_LORE"
msgstr "Os terrenos diante do palácio sufocado por rosas são marcados por pântanos ensopados de sangue, exalando o fedor odioso da morte. Seu pátio interno silencioso é defendido por uma vasta parede rastejante de arbustos de espinhos afiados, supervisionada por gárgulas petrificadas que afastam visitantes indesejados... Elas protegem o lugar profano onde incontáveis vidas de mortais foram sacrificadas em antigos ritos sangrentos e orgias nos dias passados quando o [hyperlink,GLOBAL.UrvatoghLoreConcept]Imperador Sangrento Eterno[/hyperlink] reinou supremo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_377@BUTTON_0"
msgstr "Avance."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_377@TITLE"
msgstr "Palácio do Príncipe Pálido"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_378@BODY_FOOTER"
msgstr "Os corredores intermináveis do labirinto curvam-se e serpenteiam com uma vastidão sobrenatural. Todos que entram nele sempre saem exatamente da mesma maneira que entraram..."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_378@BODY_FOOTER@HAVE_QUEST"
msgstr "Os corredores intermináveis do labirinto curvam-se e serpenteiam com uma vastidão sobrenatural. Mas uma voz familiar acaricia sua mente e guia seu caminho adiante, em direção a uma hoste de protetores espinhosos e esqueléticos..."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_378@BODY_HEADER"
msgstr "No alto de uma protuberância rochosa está a {EventStructure}, cercada por um vasto labirinto vivo de sebes sufocadas por rosas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_378@BODY_LORE"
msgstr "Este labirinto diabólico exala uma terrível aura ancestral nascida de uma magia de sangue extremamente vil, tecida há muito tempo pelo [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] <<Cr:Emperor>>. Ao se aproximar, pode-se ouvir o fraco e assustador lamento de mil vítimas sacrificadas. As almas tributárias ao {Emperor.Title}, no auge do esplendor de Drevanya... Agora, seu sofrimento sem fim alimenta e distorce a folhagem sufocada por rosas de sua própria prisão."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_378@BUTTON_0"
msgstr "Dissipar [mana/] o feitiço de proteção que protege o labirinto."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_378@BUTTON_1"
msgstr "Abandonar o labirinto, por enquanto."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_378@BUTTON_2"
msgstr "Siga a voz da Princesa Consorte Mavelith. [relationLvl3/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_378@BUTTON_3"
msgstr "Siga a voz do Príncipe Consorte Wtorakh. [relationLvl3/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_378@TITLE"
msgstr "Pântano de Sangue e Assombro"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_380@BODY_FOOTER"
msgstr "A Rosa de Obsidiana brilha como uma joia. É uma planta viva e imortal que exala uma poderosa aura de magia das sombras, e agora é sua."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_380@BODY_HEADER"
msgstr "Ao derrotar a hoste de guardas de rosas não-mortas, o Palácio da Rosa do [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] está livre para explorar."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_380@BODY_LORE"
msgstr "Ao som de um trovão, as grandes portas decoradas com o emblema de uma rosa se abrem. Além delas, há um palácio sufocado por rosas, repleto de inúmeras salas de baile e salas de estar abandonadas, todas cobertas por respingos secos de sangue. Subindo as escadas empoeiradas, você chega ao topo da torre mais alta. Suas portas se abrem para revelar uma estufa curiosa, cheia de muitas rosas murchas. Mas em seu centro cresce uma única Rosa de Obsidiana, tão magnífica que confunde a mente!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_380@BUTTON_0"
msgstr "Dê a Rosa de Obsidiana à Princesa Consorte Mavelith. [relationLvl3/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_380@BUTTON_1"
msgstr "Dê a Rosa de Obsidiana ao Príncipe Consorte Wtorakh. [relationLvl3/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_380@BUTTON_2"
msgstr "Pegue a rosa para si mesmo e absorva seu poder! [mana/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_380@BUTTON_2@HAVE_QUEST"
msgstr "Pegue-a para si mesmo e absorva seu poder. [mana/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_380@BUTTON_3"
msgstr "Reivindique esta recompensa das sombras e examine seu poder. [shadowboon/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_380@BUTTON_4"
msgstr "Obtenha esta maravilha da natureza e use-a para melhorar suas colheitas! [natureboon/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_380@TITLE"
msgstr "A Rosa de Obsidiana"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_410@BODY_FOOTER"
msgstr "Um êxtase louco toma conta dos cultistas enquanto todos avançam em sua direção, facas nas mãos. Enquanto muitas outras figuras emergem das sombras da câmara..."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_410@BODY_FOOTER@NO_KEY"
msgstr "A última linha diz: \"Em Seu corpo para sempre imortal, mas em nossa memória daqui em diante não vivida. Que Ele descanse na miséria.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_410@BODY_HEADER"
msgstr "Como os movimentos de um sonho, as grandes portas de pedra que selaram esta cripta por eras incontáveis se abrem diante de você sem som ou vibração; desaparecendo, como se nunca tivessem existido de fato..."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_410@BODY_HEADER@NO_KEY"
msgstr "Diante de você está um grandioso memorial de fonte de sangue abandonado. Ele é construído em torno de uma enorme laje de pedra elaboradamente inscrita, que diz:"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_410@BODY_LORE"
msgstr "Ao entrar na escuridão além, você é tomado pelo cheiro de rocha, sangue e cera de vela. Logo, uma câmara estreita e iluminada por velas se revela, atendida por uma hoste de figuras encapuzadas, todas murmurando ao redor de uma estátua sufocada por rosas do [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink]. Com sua chegada, os cultistas todos olham para cima, seus olhos brilhando com deleite extático. \"O acerto de contas\", um cultista ri. \"A hora do Acerto de Contas de Sangue chegou, finalmente! Irmãos e irmãs, regozijem-se! Pelo Deus Imortal, que nosso sangue seja derramado em celebração—derramem-no agora!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_410@BODY_LORE@NO_KEY"
msgstr "\"Dois amantes dilacerados por rosas derramaram sangue e conceberam uma maldição; uma terra sem sol encharcada em rios de vermelho. Um coração partido conjurou novos amantes coagidos; para nunca serem amores verdadeiros, mas servos em vez disso. Treze consortes negligenciados, prometeram seu sangue aqui para amercear; e assim selaram seu Sire na perdição e no temor.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_410@BUTTON_0"
msgstr "\"Recuem!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_410@BUTTON_0@NO_KEY"
msgstr "Retorne mais tarde."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_410@BUTTON_1"
msgstr "Derrame o sangue deles!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_410@TITLE"
msgstr "Arrebatado para o Julgamento"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_410@TITLE@NO_KEY"
msgstr "Sem Amor e Sem Morte"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_411@BODY_FOOTER"
msgstr "Mover a estátua revela um poço de sangue escondido, levando ainda mais fundo para as entranhas da terra. E das profundezas de sua escuridão eterna ecoa um som assombroso e fraco — de música."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_411@BODY_HEADER"
msgstr "Vermelho! Vermelho! Vermelho! Após a batalha, toda a câmara está encharcada de sangue e corpos cobrindo tudo tão completamente em carmesim que quase desperta sua sede vampírica ao delírio."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_411@BODY_LORE"
msgstr "Mas enquanto você está lá, até os tornozelos em sangue, ouvindo o som da sua própria respiração, uma clareza repentina entra em sua consciência: Se esta cripta estava selada, como esses cultistas mortais entraram? E onde está <<Cp:Emperor>>? Onde, na danação, está o [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Sem Morte[/hyperlink]? Você aguça seus sentidos e busca em cada canto desta cripta notavelmente pequena, mas não encontra nada. No entanto, após um tempo, você percebe como todo o sangue na sala drena em direção ao pé da estátua..."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_411@BUTTON_0"
msgstr "Siga a música até sua fonte."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_411@TITLE"
msgstr "Rapsódia de um Julgamento"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_423@BODY_FOOTER"
msgstr "'{Husband.TitleFirstName}' e '{Wife.TitleFirstName}'. Certamente estes devem conhecer o nome profano de <<Co:Emperor>>, talvez se você simplesmente perguntar a eles? (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_423@BODY_HEADER"
msgstr "Seguir o puxão misterioso levou você a um monte escuro e sagrado, onde se dizia que todos os vampiros já se originaram. (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_423@BODY_LORE"
msgstr "Em sua sombra sul está um monumento, banhado em sangue. Ele lista os nomes daqueles que testemunharam o nascimento do Sire Nightborne na forma de vampiro ascendido de <<Co:Emperor>>. No topo estão os nomes dos consortes profanos de <<Co:Emperor>>, a maioria dos quais são violentamente riscados, exceto por dois... (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_423@BUTTON_0"
msgstr "Eu poderia considerar isso. (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_423@TITLE"
msgstr "Estela Ensanguentada (WIP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_427@BODY_FOOTER"
msgstr "Para desselar a cripta, é necessário procurar {Wife.TitleFirstName} e {Husband.TitleFirstName} e obter o sangue deles — de uma forma ou de outra."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_427@BODY_HEADER"
msgstr "Então, a cripta do [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Sem Morte[/hyperlink] está selada com o sangue dos Consortes de <<Co:Emperor>>, e apenas o sangue deles pode desfazer isso."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_427@BODY_LORE"
msgstr "Pouco se sabe realmente sobre o [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Sem Morte[/hyperlink] além de mito e lenda cultistas. Mas entre os [hyperlink,GLOBAL.ElderVampireLoreConcept]Vampiros Ancestrais[/hyperlink] é bem conhecido que o Deus Sem Morte criou a Primeira Ninhada, os temidos [hyperlink,GLOBAL.ArchvampireLoreConcept]Arquivampiros[/hyperlink]. Desta ninhada, <<Cp:Emperor>> selecionou um harém de Consortes a quem <<Cp:Emperor>> ligou à vontade indomável de <<Co:Emperor>>. Parece, no entanto, que eles conspiraram para trancar seu Deus Sem Morte nesta cripta. Como e por quê, bem, apenas os Consortes restantes poderiam dizer."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_427@BUTTON_0"
msgstr "\"Eu sei o que fazer.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_427@TITLE"
msgstr "Caça aos Cônjuges"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_428@BODY_FOOTER"
msgstr "Ou atenda aos Consortes em sua busca, ou derrote-os em batalha e colete o sangue de seus cadáveres. A escolha é sua..."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_428@BODY_HEADER"
msgstr "Você encontrou {Wife.TitleFirstName} e {Husband.TitleFirstName}, e ambos reconheceram que selaram a {EventStructure} com seu sangue."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_428@BODY_LORE"
msgstr "Ambos pareciam ansiosos para obter esta Rosa de Obsidiana, seus motivos permanecem desconhecidos... Independentemente, uma escolha decisiva agora repousa em sua consciência: você atenderá a eles em seu pequeno desafio e esperará que eles permaneçam fiéis à sua palavra, ou você extrairá o sangue deles à força?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_428@BUTTON_0"
msgstr "Obtenha a Rosa de Obsidiana, se apenas por agora."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_428@TITLE"
msgstr "Caça aos Cônjuges: Encontre Seu Par"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_429@BUTTON_1"
msgstr "Siga o caminho sangrento da guerra!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_429@BUTTON_2"
msgstr "Continue, e torture um Escravo [thralls/] ou dois para cortejar {Wife.TitleFirstName}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_429@BUTTON_3"
msgstr "Continue, e sacrifique um Escravo [thralls/] ou dois para cortejar {Husband.TitleFirstName}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_430@BUTTON_1"
msgstr "\"Eu deveria, talvez, permanecer vigilante...\" (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_430@BUTTON_2"
msgstr "\"Não me importo de qualquer forma; só desejo sangue!\" (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_453@BODY_FOOTER"
msgstr "O que foi selado com sangue logo será aberto com ele. Derrote {Wife.TitleFirstName} ou {Husband.TitleFirstName} para obter o sangue deles."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_453@BODY_HEADER"
msgstr "É natural que Vampiros rivalizem com seus pares. Da vida à não-vida, de Prole a Sire^m, de par a rival, de [hyperlink,GLOBAL.ElderVampireLoreConcept]Ancestral[/hyperlink] a {GLOBAL.ArchvampireLoreConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_453@BODY_LORE"
msgstr "Sim. Inevitavelmente, todos os Vampiros criam novas proles. O 'Sire^m' ou 'Dam^f' é, a partir daí, o guardião e senhor de sua progênie, muitas vezes governando cada uma de suas ações. Até que a prole eventualmente se torne poderosa o suficiente para rivalizar com seu criador... Essa implacável disputa de poder por dominância dita o ciclo de vida de virtualmente todos os Vampiros: ou se domina, ou é dominado. Então, o que será?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_453@BUTTON_0"
msgstr "\"O sangue deles será meu.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_453@TITLE"
msgstr "Subindo na Cadeia Alimentar"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_456@BODY_FOOTER"
msgstr "Você obteve o sangue exaltado de um {GLOBAL.ArchvampireLoreConcept.Hyperlink} Consorte. Embora... Você realmente precisa de todo ele para abrir a {EventStructure}?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_456@BODY_HEADER"
msgstr "{ConsortKilled} foi derrotado! Agora, a terra pálida e sem sol está manchada com o sangue puro de um {GLOBAL.ArchvampireLoreConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_456@BODY_LORE"
msgstr "Ao contrário do {GLOBAL.ElderVampireLoreConcept.Hyperlink}, apenas uma seleta prole limitada de [hyperlink,GLOBAL.ArchvampireLoreConcept]Arquivampiros[/hyperlink] foi criada pelo [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink]—muito menos feita em Consorte de <<Co:Emperor>>. Agora, por suas presas, existe um a menos no reino de {EventRealm}!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_456@BUTTON_0"
msgstr "Abstenha-se da sua fome [goodact/], você é maior que isso. [influence/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_456@TITLE"
msgstr "Subindo na Cadeia Alimentar: Quase no Topo"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_473@BUTTON_2"
msgstr "\"O sangue do Consorte já é meu!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_474@BODY_FOOTER@GOT_BLOOD"
msgstr "Você obteve o sangue exaltado de um {GLOBAL.ArchvampireLoreConcept.Hyperlink}. Continue até a {EventStructure} para despertar o [hyperlink,GLOBAL.UrvatoghLoreConcept]Progenitor de todos os Vampiros[/hyperlink]."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_474@BUTTON_2"
msgstr "Cometa Diablerie [evilact/] e consuma uma porção desse sangue exaltado! [xp/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_474@BUTTON_3"
msgstr "Lance um Rito Hemoc [thralls/] com esse sangue exaltado para expandir seu reinado. [food/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_474@BUTTON_4"
msgstr "Colete todo o sangue, mas reserve uma porção para seus estudos. [knowledge/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_474@BUTTON_5"
msgstr "\"O Acerto de Contas com Sangue está próximo!\" [influence/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_485@BODY_FOOTER"
msgstr "\"Mate {Wife.TitleFirstName} ou {Husband.TitleFirstName} e obtenha o sangue deles. Então poderemos abrir a cripta e pôr um fim a {Emperor.Name}.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_485@BODY_HEADER"
msgstr "{Huntress.FirstName} olha para você com um olhar estudioso. \"Muito bem, agora a parte fácil do plano.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_485@BODY_LORE"
msgstr "\"Vamos fazer o que eu faço de melhor e ver se você também faz. Matar Vampiros. Depois, você faz o que sua espécie faz de melhor: todo aquele voodoo de sangue hediondo para abrir a cripta. Como estabelecido, precisaremos do sangue dos Consortes para realizar seu—rito, então você sabe o que isso significa?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_485@BUTTON_0"
msgstr "\"A caçada começou.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_485@BUTTON_2"
msgstr "\"Esse é um plano terrível. Vou seguir meu próprio caminho.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_485@BUTTON_3"
msgstr "\"O sangue deles já é meu.\" [influence/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_485@TITLE"
msgstr "A Caçada Começou"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_486@BODY_FOOTER"
msgstr "{Huntress.FirstName} olha para você com um brilho impaciente em <<o:Huntress>> olho. \"Sua vez, parceiro.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_486@BODY_HEADER"
msgstr "Com {ConsortKilled} derrotado, {Huntress.FirstName} se aproxima de você com um brilho ambicioso em <<p:Huntress>> olho."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_486@BODY_HEADER@SUPERBADASS"
msgstr "{Huntress.FirstName} recua e ofega. \"C– Como? Quem?...\" <<p:Huntress>> gagueja com os olhos arregalados. \"Essa é uma caçada superior!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_486@BODY_LORE"
msgstr "\"Trabalho impressionante—'parceiro', \" sorri {Huntress.FirstName}. \"Com este sangue podemos abrir o {EventStructure} e fazer o que há muito se pensava ser impossível. Meu, como eu sonhei com este momento, e pensar que isso aconteceria com um Vampiro sangrento ao meu lado, pha!\" <<Cp:Huntress>> olha para a distância por um momento, então sussurra, \"Mãe ficaria orgulhosa...\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_486@BUTTON_0"
msgstr "\"Hora de caçar a grande presa, parceiro.\" [rs_alliance/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_486@BUTTON_2"
msgstr "\"Parceiro? Este sangue é meu e só meu, pereça!\" [evilact/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_486@BUTTON_3"
msgstr "\"Eu não preciso de um parceiro, eu preciso de ouro.\" [gold/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_486@TITLE"
msgstr "A Caçada Começou: Sucesso!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_491@BODY_FOOTER"
msgstr "<<Cp:Emperor>> estende <<o:Emperor>> mão e sussurra, \"Árbitro do Julgamento Sangrento, revele-me o que há muito desejo aprender por toda a eternidade: reinaremos juntos, para sempre; ou você será minha destruição cobiçada?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_491@BODY_HEADER"
msgstr "Do vazio sem luz, duas presas de marfim emergem, seguidas por olhos flamejantes como portais para o [hyperlink,GLOBAL.EndailonLoreConcept]Endailon da Sombra[/hyperlink] em si. O olhar exaltado de <<Co:Emperor>> prende toda a sua atenção."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_491@BODY_LORE"
msgstr "\"Obrigado por me libertar, minha progênie sem igual,\" confidencia {Emperor.Name}. \"E que Vampiro magnífico você é... Toda a minha dormência selada sonhei com sua chegada, {Player.Name}. No entanto, agora, testemunhando você aqui diante de Mim, em toda a sua perfeição majestosa, devo declarar: você é uma visão mais gloriosa do que os sonhos poderiam conceber.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_491@BUTTON_0"
msgstr "Junte-se ao Deus Imortal ao lado despertado de <<Co:Emperor>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_491@BUTTON_1"
msgstr "Jure destruir o Deus Imortal!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_491@TITLE"
msgstr "Face do Criador de Presas"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_492@BODY_FOOTER"
msgstr "DEPRECATEd"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_492@BODY_HEADER"
msgstr "DEPRECATED"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_492@BODY_LORE"
msgstr "DEPRECATED"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_492@BUTTON_0"
msgstr "DEPRECATED"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_492@TITLE"
msgstr "DEPRECATED"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_493@BODY_FOOTER"
msgstr "<<Cp:Emperor>> olha para você com saudade por um momento, antes de se virar e sacar <<o:Emperor>> arma. \"Sangue por sangue.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_493@BODY_HEADER"
msgstr "Por um breve instante, {Emperor.FirstName} sorri para você com afeição sincera. \"Você é exatamente como eu esperava que fosse, minha progênie da ruína.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_493@BODY_LORE"
msgstr "\"Oh, como eu anseio por sua melhor tentativa contra minha vida, {Player.FirstName},\" lamenta {Emperor.Name} com melancolia amarga. \"Embora meu anseio possa muito bem ser em vão, como sempre. Independentemente—venha, vamos nos juntar nesta dança negra de derramamento de sangue que estou eternamente fadado a realizar.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_493@BUTTON_0"
msgstr "\"Sangue por sangue.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_493@TITLE"
msgstr "Acerto de Contas com o Criador"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_508@BODY_FOOTER"
msgstr "{Huntress.FirstName} estuda você com intenção calculista. \"Então me diga, ainda está considerando minha oferta, ou não?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_508@BODY_HEADER"
msgstr "Em seu momento de determinação, {Huntress.FirstName} estende a mão para você."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_508@BODY_LORE"
msgstr "<<Cp:Huntress>> olha para você com um sorriso desagradável. \"Tenho mantido meus olhos em você. Você está tramando algo, não está?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_508@BUTTON_0"
msgstr "\"Estou, apenas tenha paciência.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_508@BUTTON_1"
msgstr "\"Não, vou seguir meu próprio caminho.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_508@BUTTON_2"
msgstr "\"Você, me espionando? Isso significa guerra!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_508@TITLE"
msgstr "Conflito Sangrento de Interesses"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_513@BODY_FOOTER"
msgstr "Sim, aqui está a Cripta do [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink]. Embora, à distância, não mostre nenhuma entrada óbvia. Melhor inspecioná-la de perto."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_513@BODY_HEADER"
msgstr "Ao seu redor, há um pântano de sangue, muito mais antigo que qualquer {GLOBAL.ElderVampireLoreConcept.Hyperlink}. O ar rançoso é estagnado e espesso com decadência."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_513@BODY_LORE"
msgstr "Rios de sangue escorrem pela grande colina, levando a uma profunda depressão na terra. Lá, em um vale cheio de cadáveres e névoa, você encontra um grande monumento antigo e coberto de vegetação. Parece ser—um sepulcro ancestral? Ou talvez até uma cripta."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_513@BUTTON_0"
msgstr "Continue sua busca."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_513@TITLE"
msgstr "Um Sepulcro Selado"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_516@BODY_FOOTER"
msgstr "Ofegante de exaustão, uma risada louca emerge da forma trêmula de <<o:Wife>>. \"Muito bem. Lição aprendida: Nunca. Confie. Em ninguém. Nunca! Hora de matar. Matar. Matar!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_516@BODY_HEADER"
msgstr "Por um longo instante, {Wife.TitleFirstName} olha para você com olhos perplexos e arregalados, <<o:Wife>> boca aberta e trêmula."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_516@BODY_LORE"
msgstr "\"Você...\" <<p:Wife>> sussurra com a garganta seca. \"Você, mentiroso vil e miserável! Você, rato amaldiçoado! Vou arrancar sua garganta por isso! Vou arrancar seus dentes e rasgar você membro por membro, eu vou... eu vou...\" <<Co:Wife>> rosto e corpo tremem com um ataque de histeria enquanto <<p:Wife>> joga <<o:Wife>> cabeça para trás e grita para o céu como uma banshee!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_516@BUTTON_0"
msgstr "\"Hora de matar, de fato.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_516@TITLE"
msgstr "Traição Profunda e Ardente"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_517@BODY_FOOTER"
msgstr "\"N–não importa,\" <<p:Husband>> gagueja com um sorriso vil e crescente. \"Foi totalmente minha culpa por confiar na classe inferior. Esse erro será corrigido em breve, com determinação furiosa!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_517@BODY_HEADER"
msgstr "{Husband.TitleFirstName} olha para você com intenção furiosa e ardente. <<Co:Husband>> narinas dilatam e vapor sai de <<o:Husband>> pele."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_517@BODY_LORE"
msgstr "\"Como você pôde fazer isso comigo,\" <<p:Husband>> exige com um tremor rosnado em <<o:Husband>> voz. \"Comigo? {Husband.TitleName}! Você, camponês insolente! Você não sabe o que fez! Você não...\" <<Cp:Husband>> se corrige <<r:Husband>> com um gesto de desprezo de <<o:Husband>> mãos trêmulas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_517@BUTTON_0"
msgstr "\"Faça seu pior.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_517@TITLE"
msgstr "Traição Ardente e Flamejante"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_518@BODY_FOOTER"
msgstr "\"Você tornou isso pessoal agora, otário,\" <<p:Huntress>> sorri sombriamente. \"Vou esculpir uma estaca com seu nome nela. Venha pegar!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_518@BODY_HEADER"
msgstr "{Huntress.FirstName} vira-se para você com um olhar de surpresa atordoada em <<o:Huntress>> sobrancelhas, antes de cuspir uma maldição silenciosa."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_518@BODY_LORE"
msgstr "\"Bem, não posso dizer que estou totalmente surpreso,\" <<p:Huntress>> resmunga. \"Machucado? Claro, um pouco. Mas surpreso? Por ser esfaqueado por trás por um Vampiro sem-vergonha e miserável? Não, está na sua natureza vil e sugadora de sangue, não está? Abominações miseráveis; todos vocês!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_518@BUTTON_0"
msgstr "\"Sua morte será meu prazer.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_518@TITLE"
msgstr "Traição Sangrenta"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_521@BODY_FOOTER"
msgstr "{Wife.TitleFirstName} engasga em <<o:Princess>> grito e então cai em um silêncio assustador enquanto {Emperor.Name} domina completamente a mente de <<o:Wife>>. (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_521@BODY_HEADER"
msgstr "\"Muito bem, {Player.FirstName},\" sorri {Emperor.Name} enquanto <<p:Emperor>> começa um poderoso ritual de sangue. \"Você não me deixa escolha a não ser nivelar nosso campo de batalha iminente.\" (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_521@BODY_LORE"
msgstr "Então, {Wife.TitleFirstName} é convocada, gritando e guinchando enquanto arranca <<P:Wife>> cabelo. \"Não! Não! Não novamente, seu porco miserável! Saia da minha cabeça! Aaaaargh!\"[br/][br/]{Emperor.Name} sangra pelos olhos de <<o:Emperor>>, enquanto <<p:Emperor>> rosna bestialmente. \"Silêncio, sua prostituta insolente,\" zombam <<p:Emperor>>. \"Lidarei com sua traição mais tarde. Primeiro, temos um acerto de contas para honrar. Venha a mim, minha Consorte!\" (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_521@BUTTON_0"
msgstr "\"Que assim seja.\" (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_521@BUTTON_2"
msgstr "Tentar frustrar o feitiço! (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_521@TITLE"
msgstr "Renovação Atormentada dos Votos (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_532@BODY_FOOTER"
msgstr "{Husband.TitleFirstName} engasga em <<o:Husband>> gagueira e então cai em um silêncio assustador enquanto {Emperor.Name} domina completamente a mente de <<o:Husband>>. (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_532@BODY_HEADER"
msgstr "\"Muito bem, {Player.FirstName},\" sorri {Emperor.Name} enquanto <<p:Emperor>> começa um poderoso ritual de sangue. \"Você não me deixa escolha a não ser nivelar nosso campo de batalha iminente.\" (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_532@BODY_LORE"
msgstr "Então, {Husband.TitleFirstName} é convocado, gaguejando e resistindo enquanto um suor sangrento surge em <<o:Husband>> testa. \"Misericórdia, meu Sire^m,\" implora <<p:Husband>>. \"{Wife.FirstName} me fez fazer isso, eu juro! Eu sempre fui seu fiel Consorte!\"[br/][br/] {Emperor.Name} sangra pelos olhos de <<o:Emperor>>, enquanto <<p:Emperor>> rosna bestialmente. \"Silêncio, seu canalha insolente,\" zombam <<p:Emperor>>. \"Lidarei com sua traição mais tarde. Primeiro, temos um acerto de contas para honrar. Venha a mim, minha Consorte!\" (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_532@BUTTON_0"
msgstr "\"Que assim seja.\" (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_532@BUTTON_2"
msgstr "Tentar frustrar o feitiço! (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_532@TITLE"
msgstr "Jubileu Forçado dos Votos (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_533@BODY_FOOTER"
msgstr "\"Venha, cesse sua luta, meu êxtase,\" oferece {Emperor.Name}. \"Junte-se ao meu lado, onde você pertence direito! E juntos, desataremos um acerto de contas que inspirará terror até mesmo nos {GLOBAL.ArchonsLoreConcept.Hyperlink}!\" (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_533@BODY_HEADER"
msgstr "{Emperor.Name} vem antes de você, os olhos de <<o:Emperor>> brilham e cintilam como uma galáxia enquanto <<p:Emperor>> se dirige a você com um discurso delicado. (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_533@BODY_LORE"
msgstr "\"{Player.FirstName}, admiro seu espírito de luta,\" persuade <<p:Emperor>>. \"De fato. Você é etéreamente magnífico enquanto graça a terra com seu grandioso e impecável senso de propósito. O próprio chão sob seus pés é totalmente indigno de sua presença, e me enche de orgulho rapturoso e elevado saber que você é minha progênie. Minha criação definitiva, a perfeição feita carne.\" (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_533@BUTTON_0"
msgstr "\"Não significa não!\" (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_533@BUTTON_1"
msgstr "Aceitar a oferta e juntar-se ao Deus Imortal afinal. (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_533@TITLE"
msgstr "Encantos do Deus Imortal (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_547@BODY_FOOTER"
msgstr "Com um arrepio, uma realização surge... Foi isso, {Emperor.Name}? <<Cp:Emperor>> realmente acabou de alcançar você?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_547@BODY_HEADER"
msgstr "De repente, uma brisa fria e curiosa toca seus sentidos. Ela carrega um murmúrio assustador, um sussurro do além..."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_547@BODY_LORE"
msgstr "Afinando seus sentidos vampíricos, você percebe como o suspiro fantasmagórico contém palavras audíveis. \"Meu... Libertador...\" ele diz. \"Venha... Venha até mim. Dessele-o... Dessele o Cripta...\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_547@BUTTON_0"
msgstr "\"Ainda vou te encontrar!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_547@TITLE"
msgstr "Sussurros da Cripta"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_619@TITLE"
msgstr "Sangue dos Consortes"

msgid "DLC@THRONESOFBLOOD@STORY_REALMS@NAME"
msgstr "Sangue e Cortejo"

msgid "DLC@THRONESOFBLOOD@STORY_REALM_01@AISTARTINGBONUS@DESCRIPTION@EMPEROR"
msgstr "O Governante começa com estruturas adicionais desbloqueadas e heróis extras."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_01@AISTARTINGBONUS@NAME@EMPEROR"
msgstr "Bônus Inicial do Imperador"

msgid "DLC@THRONESOFBLOOD@STORY_REALM_01@ANCIENT_WONDER@CRIMSON_FANE@ALT_STRUCT_DESCR"
msgstr "Esta sepultura, há muito evitada e coberta por vegetação, foi erigida para enterrar o [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] e para memorializar a criação de todos os Vampiros. A lenda conta que um reino de rosas já prosperou nesta colina, onde, um dia, dois amantes se encontraram e acabaram sangrando até a morte. Através deste calvário profano, o primeiro Vampiro surgiu, que, a partir daí, gerou muitos outros."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_01@ANCIENT_WONDER@FANE_CRYPT@ALT_STRUCT_NAME"
msgstr "Cripta do Deus Imortal"

msgid "DLC@THRONESOFBLOOD@STORY_REALM_01@ANCIENT_WONDER@ROSE_PALACE@ALT_STRUCT_DESCR"
msgstr "Incontáveis orgias de sangue foram realizadas dentro das paredes deste lugar amaldiçoado. E através do sacrifício de inúmeras almas, um feitiço maligno foi tecido ao seu redor, paralisando toda a propriedade no tempo — afastando tanto a ruína quanto os saqueadores. Pois um labirinto encantado e espinhoso se arrasta ao seu redor, que dizem proteger uma rosa de verdadeiro amor cultivada na torre mais alta."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_01@ANCIENT_WONDER@ROSE_PALACE@ALT_STRUCT_NAME"
msgstr "Palácio da Rosa do Imperador de Sangue"

msgid "DLC@THRONESOFBLOOD@STORY_REALM_01@DESCRIPTION"
msgstr "Como um {GLOBAL.ElderVampireLoreConcept.Hyperlink}, retorne ao reino de origem amaldiçoado de todos os Vampiros. Frustre ou corteje seus dois guardiões {GLOBAL.ArchvampireLoreConcept.Hyperlink} em disputa, enquanto você se aventura para descobrir a mítica Cripta do [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] e trazer um aguardado ajuste de contas de sangue."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_01@NAME"
msgstr "Drevanya Amaldiçoada"

msgid "DLC@THRONESOFBLOOD@STORY_REALM_01@SITE@FANE_CRYPT@ALT_STRUCT_NAME"
msgstr "Altar de Revivificação do Sangue"

msgid "DLC@THRONESOFBLOOD@STORY_REALM_01@SITE@THORNED_HEART@ALT_STRUCT_NAME"
msgstr "Madeira de Roseira Destruída do Endailon"

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@BRIEFING_01@DESCRIPTION"
msgstr "Idades atrás, em uma época em que as forças do poder elemental vagavam pelo cosmos, um príncipe traiu sua amante e, através desse derramamento de sangue, foi amaldiçoado. Assim surgiu um ser de grande poder e atração, nem morto nem vivo, que se alimentava dos vivos e prosperava nas sombras: O primeiro Vampiro."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@BRIEFING_02@DESCRIPTION"
msgstr "Este Vampiro espalharia sua maldição de poder e danação através de seu 'beijo' letal. Através disso, ele se tornou o Deus Imortal; um flagelo que invadia e encantava reinos inteiros. E ainda, após ter nascido de uma traição, a traição seria sua queda... Pois a inquietação surgiu de dentro."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@BRIEFING_03@DESCRIPTION"
msgstr "Falso amor selou o Deus Imortal em uma cripta, e a inquietação que se seguiu amaldiçoou ele e todo o seu Reino ao Cofre do Mundo chamado Grexolis. À medida que o primeiro Vampiro foi reduzido a mito e lenda, os Vampiros que permaneceram foram caçados ou fugiram para as sombras."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@BRIEFING_04@DESCRIPTION"
msgstr "Mas então, após Idades de banimento, o reino do Vampiro imortal emergiu do esquecimento de Grexolis. Poucos lembraram do cruel Deus Imortal, mas muitos Vampiros conheciam o mito do Ajuste de Contas de Sangue, quando o Deus Imortal acordaria mais uma vez e a Era dos Vampiros começaria.[br/][br/]Esta é a história do Vampiro que traria este Ajuste de Contas de Sangue."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@CHOSE_SIDE_HUNTRESS@CUSTOM_PREDICTION_01"
msgstr "Continue com a Missão da Caçadora, mas termine a sua própria. (Por enquanto...)"

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@CHOSE_SIDE_HUNTRESS@CUSTOM_PREDICTION_02"
msgstr "Termina a Missão da Caçadora, continue por conta própria."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@DEBRIEFING_01_RECKONING@DESCRIPTION"
msgstr "Assim, pela mão de sua progênie, o Deus Imortal foi levantado de seu sono escuro e, por seu comando real, a aristocracia Vampiro dispersa foi convocada para a cripta imperial de Drevanya. Lá, eles prestaram homenagem ao Deus Imortal e ao Godir que o libertou."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@DEBRIEFING_01_REGICIDE@DESCRIPTION"
msgstr "Assim, o Deus Imortal foi morto por um de seus próprios descendentes. Este Ajuste de Contas de Sangue foi sentido por todos os Vampiros longe e perto, e em seus corações frios e enegrecidos agitou-se o medo ansioso da anarquía... E da oportunidade."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@DEBRIEFING_02_RECKONING@DESCRIPTION"
msgstr "As lendas da cruel grandeza de Urvatogh fariam os Mundos Internos tremerem novamente, pois seu longo proclamado Ajuste de Contas de Sangue havia apenas começado... com seu salvador ao seu lado, esperado para permanecer em sua sombra para sempre."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@DEBRIEFING_02_REGICIDE@CONSORT@DESCRIPTION"
msgstr "Com sua cripta agora desselada e vazia, o título, trono e Domínio do Imperador de Sangue Eterno pertenceria ao Godir Vampiro que o havia banido. Juntamente com um novo consorte, este Godir traria a nova Era dos Vampiros."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@DEBRIEFING_02_REGICIDE@DESCRIPTION"
msgstr "Com sua cripta agora desselada e vazia, o título, trono e Domínio do Imperador de Sangue Eterno pertenceria ao Godir que o havia banido. E foi este Godir que traria a nova Era dos Vampiros."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@DEBRIEFING_02_REGICIDE@HUNTRESS@DESCRIPTION"
msgstr "Com sua cripta agora desselada e vazia, o título, trono e Domínio do Imperador de Sangue Eterno cairiam novamente no esquecimento, enquanto a caçada contra os Vampiros se intensificava... Até mesmo por seus próprios parentes."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@GIVE_ROSE_HUSBAND@CUSTOM_PREDICTION_01"
msgstr "Você ganha três <<m:{EventUnit}>> da {EventRace.Name}."

