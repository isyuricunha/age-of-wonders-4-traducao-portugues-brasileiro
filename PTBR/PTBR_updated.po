msgstr "Você tem versões mais novas dos seguintes mods"

msgid "INTERFACE@MODS@NEW_MODS_NOTICE_SP"
msgstr "Você está usando atualmente mods diferentes daqueles com os quais o jogo foi salvo."

msgid "INTERFACE@MODS@NEW_MODS_WARNING_SP"
msgstr "Se você tentar jogar o jogo, ele pode ficar instável. Deseja continuar?"

msgid "INTERFACE@MODS@OUTDATED_MODS"
msgstr "Você tem versões desatualizadas dos seguintes mods"

msgid "INTERFACE@MODS@PROBLEM_MODS"
msgstr "Não foi possível carregar os mods:"

msgid "INTERFACE@MODS@SURPLUS_MODS"
msgstr "Os seguintes mods devem ser desativados"

msgid "INTERFACE@MODS@UNKNOWN_MODS"
msgstr "Você tem um conflito desconhecido com os seguintes mods"

msgid "INTERFACE@MODS@YOUR_VERSION"
msgstr "Sua versão"

