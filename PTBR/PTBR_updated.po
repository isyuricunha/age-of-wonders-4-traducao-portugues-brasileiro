msgid "TOME_BEACON@ABILITY_1@DESCRIPTION"
msgstr "Chance base de {CONVERT_RESISTANCE_CHECK>ResolvedStrength}% de fazer com que a unidade inimiga alvo não-[hyperlink,GLOBAL.Concept]Herói[/hyperlink] se torne [hyperlink,GLOBAL.PROPERTIES.DOMINATED]Dominada[/hyperlink]. Se não for bem-sucedido, a unidade sofre {amount} de [hyperlink,GLOBAL.SpiritDamageConcept]Dano de Espírito[/hyperlink] em vez disso.[br/][br/]A unidade entra em [hyperlink,GLOBAL.DefenseModeConcept]Modo de Defesa[/hyperlink] após o uso."

msgid "TOME_BEACON@ABILITY_1@ENHANCED_DESCRIPTION"
msgstr "Converter:[bulletlist][bullet/]Causa um adicional de {CONVERT_ENHANCED_DAMAGE>DAMAGE>Spirit} de [hyperlink,GLOBAL.SpiritDamageConcept]Dano de Espírito[/hyperlink][bullet/]Tem +{CONVERT_ENHANCED_RANGE>ADD>MaxRange} de [hyperlink,GLOBAL.RangeConcept]Alcance[/hyperlink][/bulletlist]"

msgid "TOME_BEACON@ABILITY_1@ENHANCED_NAME"
msgstr "Conversão Aprimorada"

msgid "TOME_BEACON@ABILITY_1@MASTER_DESCRIPTION"
msgstr "Converter:[bulletlist][bullet/]Tem +{CONVERT_MASTER_RANGE>ADD>OptimalRange} de [hyperlink,GLOBAL.RangeConcept]Alcance[/hyperlink].[bullet/]Tem {amount} de [hyperlink,GLOBAL.TurnConcept]Turno[/hyperlink] de recarga.[/bulletlist]"

msgid "TOME_BEACON@ABILITY_1@MASTER_NAME"
msgstr "Conversão de Campeão"

msgid "TOME_BEACON@ABILITY_1@NAME"
msgstr "Converter"

msgid "TOME_BEACON@HERO_SKILL@DESCRIPTION"
msgstr "[bulletlist][bullet/]A unidade se torna {GLOBAL.PROPERTIES.FAITHFUL.Hyperlink}.[bullet/]Unidades não-{GLOBAL.HeroConcept.Hyperlink} {GLOBAL.PROPERTIES.FAITHFUL.Hyperlink} ganham +{CHAMPION_OF_THE_FAITHFUL_MORALE_EFFECT>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink} no início da batalha.[/bulletlist]"

msgid "TOME_BEACON@HERO_SKILL@NAME"
msgstr "Campeão dos Fiéis"

msgid "TOME_BEACON@PASSIVE@DESCRIPTION"
msgstr "Seus <<m:{GLOBAL.DiplomaticTokenConcept}>> concedem +{amount} {GLOBAL.HouseInfluenceConcept.Hyperlink} por turno."

msgid "TOME_BEACON@PASSIVE@NAME"
msgstr "Pregadores do Farol"

msgid "TOME_BEACON@SKILL1@DESCRIPTION"
msgstr "Invoca um {GLOBAL.UNITS.LESSER_LIGHT_SPIRIT.Hyperlink} {GLOBAL.PROPERTIES.SUPPORT_UNIT.Hyperlink}."

msgid "TOME_BEACON@SKILL1@NAME"
msgstr "Invocar Espírito de Luz Menor"

msgid "TOME_BEACON@SKILL2@DESCRIPTION"
msgstr "Unidades recrutadas através de {GLOBAL.RequestMilitaryAidConcept.Hyperlink} do {GLOBAL.PvEVassalConcept.Hyperlink} alvo têm {GLOBAL.PROPERTIES.FAITHFUL.Hyperlink}.[br/]A cidade Vassalo alvo concede ao jogador {amount} {GLOBAL.ManaConcept.Hyperlink} a cada {GLOBAL.TurnConcept}."

msgid "TOME_BEACON@SKILL2@NAME"
msgstr "Pacto da Fé"

msgid "TOME_BEACON@SKILL3@DESCRIPTION"
msgstr "Invoca uma {GLOBAL.UNITS.BLESSED_SOUL.Hyperlink} {GLOBAL.PROPERTIES.SHIELD_UNIT.Hyperlink} que pode reunir suas unidades e condenar o inimigo."

msgid "TOME_BEACON@SKILL3@NAME"
msgstr "Invocar Alma Abençoada"

msgid "TOME_BEACON@SKILL5@DESCRIPTION"
msgstr "Concede às unidades encantadas:[bulletlist][bullet/]{GLOBAL.PROPERTIES.FAITHFUL.Hyperlink}, que reduz {GLOBAL.UnitUpkeepConcept.Hyperlink}.[bullet/]+{MIGHTY_MEEK_RESISTANCE>Resistance} {GLOBAL.StatusResistanceConcept.Hyperlink}.[bullet/]+{MIGHTY_MEEK_COUNTING_TIER_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink} em ataques para cada Nível da Unidade do alvo.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_BEACON@SKILL5@MOD_DESCRIPTION"
msgstr "+{MIGHTY_MEEK_COUNTING_TIER_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink} para cada Nível da Unidade do alvo."

msgid "TOME_BEACON@SKILL5@NAME"
msgstr "Poderosos e Humildes"

msgid "TOME_BEACON@SKILL5@PROPERTY_DESCRIPTION"
msgstr "Unidade:[bulletlist][bullet/]Tem {GLOBAL.PROPERTIES.FAITHFUL.Hyperlink}.[bullet/]Tem +{MIGHTY_MEEK_RESISTANCE>Resistance} {GLOBAL.StatusResistanceConcept.Hyperlink}.[bullet/]Causa +{MIGHTY_MEEK_COUNTING_TIER_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink} em ataques para cada Nível da Unidade do alvo.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_BEACON@SKILL6@DESCRIPTION"
msgstr "Invoca um {GLOBAL.UNITS.DIVINE_BEACON_UNIT.Hyperlink}. Ao lançar e no início de cada turno, unidades amigáveis em um raio de {DIVINE_BEACONS_GRACE_UNIT_TARGETER_CIRCLE>AREA>Radius} hexágonos:[bulletlist][bullet/]Curam +{DIVINE_BEACONS_GRACE_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Ganham +{DIVINE_BEACONS_GRACE_MORALE_GAIN>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}.[/bulletlist]{LOC.CONCEPT@SUMMON_LIVE_SHARED}[br/][br/]{LOC.TACTICAL@ABILITY@NEVER_IN_WATER}"

msgid "TOME_BEACON@SKILL6@NAME"
msgstr "Conjurar Farol Divino"

msgid "TOME_BEACON@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Revela a radiação interior dos {GLOBAL.PROPERTIES.FAITHFUL.Hyperlink} para fulminar inimigos e fortalecer aliados."

msgid "TOME_BEACON@TOME@LORE_AUTHOR"
msgstr "Sola, a Pura, Humana Exaltada"

msgid "TOME_BEACON@TOME@LORE_DESCRIPTION"
msgstr "\"Fé, fervor, glória justa: tais coisas podem se espalhar como uma chama sagrada, trazendo a luz da verdade até mesmo aos olhos de seus inimigos! Um verdadeiro farol de fé brilha tão intensamente que cura as feridas dos fiéis e instila dúvida nos infiéis, levando-os ao caminho verdadeiro... seu caminho.\""

msgid "TOME_BEACON@TOME@NAME"
msgstr "Tomo do Farol"

msgid "TOME_BEACON@UNIT2@NAME"
msgstr "Farol Divino^n"

msgid "TOME_BEACON@UNIT2_ABILITY@DESCRIPTION"
msgstr "Unidades amigáveis dentro de {DIVINE_BEACONS_GRACE_UNIT_TARGETER_CIRCLE>AREA>Radius} hexágonos:[bulletlist][bullet/]Curam +{DIVINE_BEACONS_GRACE_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Ganham {DIVINE_BEACONS_GRACE_MORALE_GAIN>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_BEACON@UNIT2_ABILITY@NAME"
msgstr "Graça do Farol Divino"

msgid "TOME_BEACON@UNIT@NAME"
msgstr "Portador de Luz^n"

msgid "TOME_BEASTS@PASSIVE@DESCRIPTION"
msgstr "<<m:{GLOBAL.PROPERTIES.ANIMAL.Hyperlink}>> tem {amount} Nível."

msgid "TOME_BEASTS@PASSIVE@NAME"
msgstr "Instintos Aguçados"

msgid "TOME_CHAOS_CHANNELING@HERO_SKILL@DESCRIPTION"
msgstr "Atacantes inimigos dentro de {CHAOTIC_REBUKE_MAGIC_EFFECT_SHIELD>MaxAttackerDistance} hexágonos têm uma chance base de {chance}% de ganhar um efeito de status aleatório."

msgid "TOME_CHAOS_CHANNELING@HERO_SKILL@NAME"
msgstr "Repreensão Caótica"

msgid "TOME_CHAOS_CHANNELING@PASSIVE@DESCRIPTION"
msgstr "Saquear <<m:{GLOBAL.ProvinceConcept}>> concede {amount} {GLOBAL.ManaConcept}."

msgid "TOME_CHAOS_CHANNELING@PASSIVE@NAME"
msgstr "Extrair Caos"

msgid "TOME_CHAOS_CHANNELING@SKILL1@DESCRIPTION"
msgstr "[bulletlist][bullet/]Invoca um exército completo de unidades aleatórias não-Scout de Nível I que podem ser produzidas em uma cidade no hexágono alvo.[bullet/]Se conjurado dentro de uma {GLOBAL.ProvinceConcept.Hyperlink} inimiga, a saqueia instantaneamente.[/bulletlist]"

msgid "TOME_CHAOS_CHANNELING@SKILL1@NAME"
msgstr "Horda Dourada"

msgid "TOME_CHAOS_CHANNELING@SKILL2@DESCRIPTION"
msgstr "Todas as unidades inimigas:[bulletlist][bullet/]Sofrem {FAN_THE_INFERNO_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} que ignora {BREACHING>MODIFIERS>ResolvedResistance}% de {GLOBAL.ResistanceConcept.Hyperlink}.[bullet/]São infligidas com {GLOBAL.PROPERTIES.BURNING.Hyperlink}.[/bulletlist]"

msgid "TOME_CHAOS_CHANNELING@SKILL2@NAME"
msgstr "Atizar o Inferno"

msgid "TOME_CHAOS_CHANNELING@SKILL3@DESCRIPTION"
msgstr "Torna a raça alvo a personificação do fogo, concedendo-lhes:[bulletlist][bullet/]{SCION_OF_FLAME_DEFENSE>REDUCTION>Fire} {GLOBAL.FireResistanceConcept.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.VENGEFUL_FLAMES.Hyperlink}, que causa dano a atacantes {GLOBAL.MeleeConcept.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.FIERY_WAKE.Hyperlink}, que incendeia terrenos inflamáveis como <<m:{GLOBAL.FloraObstacleConcept.Hyperlink}>>.[bullet/]Imunidade a {GLOBAL.PROPERTIES.BURNING.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.LAVA_WALK.Hyperlink}.[bullet/]<<m:{GLOBAL.CityConcept.Hyperlink}>> desta raça ignoram a penalidade de {GLOBAL.CityStabilityConcept.Hyperlink} de Abismo e Lava em seu {GLOBAL.DomainConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CHAOS_CHANNELING@SKILL3@NAME"
msgstr "Descendente da Chama"

msgid "TOME_CHAOS_CHANNELING@SKILL3@PROPERTY_DESCRIPTION"
msgstr "A unidade tem:[bulletlist][bullet/]{SCION_OF_FLAME_DEFENSE>REDUCTION>Fire} {GLOBAL.FireResistanceConcept.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.VENGEFUL_FLAMES.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.FIERY_WAKE.Hyperlink}[bullet/]Imunidade a {GLOBAL.PROPERTIES.BURNING.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.LAVA_WALK.Hyperlink}[/bulletlist]"

msgid "TOME_CHAOS_CHANNELING@SKILL4@DESCRIPTION"
msgstr "Sempre que outra unidade morre em batalha, a unidade encantada ganha:[bulletlist][bullet/]{GLOBAL.PROPERTIES.INFERNAL_MIGHT.Hyperlink} por {INFERNAL_BLAZE_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]+{DEMONIC_SIPHON_MORALE>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}.[/bulletlist][br/]Não é acionado pela morte de <<m:{GLOBAL.PROPERTIES.COMBAT_SUMMON.Hyperlink}>>, {GLOBAL.PROPERTIES.TOWER_UNIT.Hyperlink} e {GLOBAL.PROPERTIES.SIEGECRAFT_UNIT.Hyperlink} unidades."

msgid "TOME_CHAOS_CHANNELING@SKILL4@NAME"
msgstr "Sifão Demônico"

msgid "TOME_CHAOS_CHANNELING@SKILL4@PROPERTY_DESCRIPTION"
msgstr "Sempre que outra unidade morre em batalha, esta unidade ganha:[bulletlist][bullet/]{GLOBAL.PROPERTIES.INFERNAL_MIGHT.Hyperlink} por {INFERNAL_BLAZE_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]+{DEMONIC_SIPHON_MORALE>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}.[br/]Não é acionado pela morte de <<m:{GLOBAL.PROPERTIES.COMBAT_SUMMON.Hyperlink}>>, {GLOBAL.PROPERTIES.TOWER_UNIT.Hyperlink} e {GLOBAL.PROPERTIES.SIEGECRAFT_UNIT.Hyperlink} unidades.[/bulletlist]"

msgid "TOME_CHAOS_CHANNELING@SKILL4@PROP_DESCRIPTION"
msgstr "[bulletlist][bullet/]Ataques têm +{amount} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Unidades {GLOBAL.PROPERTIES.FIEND.Hyperlink} ganham +{INFERNAL_BLAZE_FIEND_CRIT>ResolvedCritChanceBonus}% de chance de acerto crítico.[bullet/]Pode acumular até {amountStacks} vezes.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CHAOS_CHANNELING@SKILL4@PROP_NAME"
msgstr "Poder Infernal"

msgid "TOME_CHAOS_CHANNELING@SKILL5@DESCRIPTION"
msgstr "Alvo uma cidade, e sempre que você lutar naquele domínio, um {GLOBAL.UNITS.GREMLIN_UNIT.Hyperlink} é invocado ao lado de uma de suas unidades a cada {GLOBAL.TurnConcept.Hyperlink}.[br/]Até {amount} <<m:{GLOBAL.UNITS.GREMLIN_UNIT.Hyperlink}>> podem ser invocados por batalha."

msgid "TOME_CHAOS_CHANNELING@SKILL5@NAME"
msgstr "Emboscadores Gremlins"

msgid "TOME_CHAOS_CHANNELING@SKILL5@PROP_DESCRIPTION"
msgstr "Um {GLOBAL.UNITS.GREMLIN_UNIT.Hyperlink} é invocado ao lado de uma das unidades do proprietário a cada {GLOBAL.TurnConcept.Hyperlink}."

msgid "TOME_CHAOS_CHANNELING@SKILL6@DESCRIPTION"
msgstr "Invoca uma unidade {GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink} de Nível V não-{GLOBAL.PROPERTIES.FIEND.Hyperlink} com habilidades relacionadas a Fogo e Queimando no hexágono alvo."

msgid "TOME_CHAOS_CHANNELING@SKILL6@NAME"
msgstr "Invocar Encarnado da Chama"

msgid "TOME_CHAOS_CHANNELING@SKILL7@ABILITY_DESCRIPTION"
msgstr "Causa dano a unidades em um raio de {FIRE_BOMB_TARGETER_CIRCLE>AREA>Radius} hexágonos."

msgid "TOME_CHAOS_CHANNELING@SKILL7@ABILITY_NAME"
msgstr "Bomba de Fogo"

msgid "TOME_CHAOS_CHANNELING@SKILL7@DESCRIPTION"
msgstr "Unidades encantadas ganham:[bulletlist][bullet/]A habilidade {GLOBAL.PROPERTIES.FIRE_BOMB.Hyperlink}, que causa dano mágico em uma área.[bullet/]O dano dessa habilidade aumenta com o nível da unidade.[/bulletlist]"

msgid "TOME_CHAOS_CHANNELING@SKILL7@NAME"
msgstr "Foco de Chamas"

msgid "TOME_CHAOS_CHANNELING@SKILL7@PROP_DESCRIPTION"
msgstr "A unidade tem:[bulletlist][bullet/]A habilidade {GLOBAL.PROPERTIES.FIRE_BOMB.Hyperlink}.[/bulletlist]"

msgid "TOME_CHAOS_CHANNELING@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Torne-se o mestre do caos explorando seus poderes caóticos acumulados de {GLOBAL.ChaosConcept.Hyperlink} anteriores <<m:{GLOBAL.TomeConcept.Hyperlink}>>."

msgid "TOME_CHAOS_CHANNELING@TOME@LORE_AUTHOR"
msgstr "Karissa, a Vermelha, Mestra das Paixões"

msgid "TOME_CHAOS_CHANNELING@TOME@LORE_DESCRIPTION"
msgstr "\"Abrace o caos, e ele também o abraçará, espalhando fervor a todos que tocar! Um verdadeiro agente do caos verá a ordem e a lógica se transformarem em loucura e tumulto, sempre a seu favor!\""

msgid "TOME_CHAOS_CHANNELING@TOME@NAME"
msgstr "Tomo de Canalização do Caos"

msgid "TOME_CHAOS_LORD@HERO_SKILL@DESCRIPTION"
msgstr "Invoca um {GLOBAL.PROPERTIES.INFERNAL_FIEND.Hyperlink} aleatório de Nível I sempre que esta unidade matar outra unidade. Há uma pequena chance de um {GLOBAL.PROPERTIES.INFERNAL_FIEND.Hyperlink} de Nível II ser invocado em vez disso.[br/]Não funciona em batalhas aquáticas."

msgid "TOME_CHAOS_LORD@HERO_SKILL@NAME"
msgstr "Massacre Demônico"

msgid "TOME_CHAOS_LORD@PASSIVE@DESCRIPTION"
msgstr "Substitui um Assalto Impetuoso por um Assalto Imparável, que:[bulletlist][bullet/]Causa mais dano à {GLOBAL.FortificationHealthConcept} da cidade.[bullet/]Não reduz os <<m:{GLOBAL.HitPointConcept}>> das suas unidades.[bullet/]Não faz com que suas unidades fiquem {GLOBAL.PROPERTIES.EXHAUSTED.Hyperlink}.[/bulletlist]"

msgid "TOME_CHAOS_LORD@PASSIVE@NAME"
msgstr "Assalto Imparável"

msgid "TOME_CHAOS_LORD@PASSIVE@PROPERTY@DESCRIPTION"
msgstr "Acelera significativamente um cerco."

msgid "TOME_CHAOS_LORD@SKILL1@DESCRIPTION"
msgstr "Transforma a raça alvo em seres demoníacos, concedendo-lhes:[bulletlist][bullet/]O tipo de unidade {GLOBAL.PROPERTIES.INFERNAL_FIEND.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.FLYING_MOVEMENT.Hyperlink}, aumentando a mobilidade.[bullet/]{GLOBAL.PROPERTIES.FRENZY.Hyperlink}, aumentando o dano conforme atacam.[bullet/]<<m:{GLOBAL.CityConcept.Hyperlink}>> desta raça ignoram a penalidade de {GLOBAL.CityStabilityConcept.Hyperlink} de Abismo e Lava em seu {GLOBAL.DomainConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CHAOS_LORD@SKILL1@NAME"
msgstr "Demônicos"

msgid "TOME_CHAOS_LORD@SKILL2@DESCRIPTION"
msgstr "Todas as unidades atacantes ganham {GLOBAL.PROPERTIES.KILLING_MOMENTUM.Hyperlink} e {GLOBAL.PROPERTIES.HASTENED.Hyperlink} por {HASTENED_EFFECT_DESCRIPTION_3>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "TOME_CHAOS_LORD@SKILL2@NAME"
msgstr "Assalto Demônico"

msgid "TOME_CHAOS_LORD@SKILL3@DESCRIPTION"
msgstr "[bulletlist][bullet/]Após {turn} [turn/] em batalha, {Number} unidades inimigas não-{GLOBAL.HeroConcept.Hyperlink} são {GLOBAL.PROPERTIES.MIND_CONTROLLED} até o final do combate.[bullet/]A cidade sofre -{HappinessDebuff} {GLOBAL.CityStabilityConcept.Hyperlink} enquanto estiver sitiada.[/bulletlist]"

msgid "TOME_CHAOS_LORD@SKILL3@NAME"
msgstr "Incitar Rebelião"

msgid "TOME_CHAOS_LORD@SKILL4@DESCRIPTION"
msgstr "Invoca um avatar do seu {GLOBAL.LeaderConcept.Hyperlink} em uma batalha. O avatar tem as mesmas habilidades que seu Governante e aparece com <<m:{GLOBAL.ActionPointConcept.Hyperlink}>> completos. Todos os <<m:{GLOBAL.PROPERTIES.FIEND.Hyperlink}>> ganham +{AVATAR_OF_CHAOS_MORALE>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}.[br/][br/]{LOC.TACTICAL@ABILITY@NEVER_IN_WATER}[br/]Não pode ser usado em batalhas onde seu {GLOBAL.LeaderConcept.Hyperlink} está presente."

msgid "TOME_CHAOS_LORD@SKILL4@NAME"
msgstr "Invocar Avatar do Caos"

msgid "TOME_CHAOS_LORD@SKILL5@NAME"
msgstr "Era do Caos"

msgid "TOME_CHAOS_LORD@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Liberte as forças do caos sobre o mundo. Especialize-se em buffs ofensivos."

msgid "TOME_CHAOS_LORD@TOME@LORE_AUTHOR"
msgstr "Karissa, a Vermelha, Mestra das Paixões"

msgid "TOME_CHAOS_LORD@TOME@LORE_DESCRIPTION"
msgstr "\"Delire-se com a desordem! Prosperar no tumulto! Sua aura de caos é como uma névoa insidiosa que distorce a realidade e incita a loucura. A própria terra parece tremer com sua chegada, com seres de reinos demoníacos tomando conhecimento. Nasça em fogo e sangue, ó Godir, e traga a Era do Caos!\""

msgid "TOME_CHAOS_LORD@TOME@NAME"
msgstr "Tomo do Senhor do Caos"

msgid "TOME_COLD_DARK@HERO_SKILL@DESCRIPTION"
msgstr "Ataques básicos de {GLOBAL.MagicConcept.Hyperlink} têm uma chance base de {BLINDED_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.BLINDED.Hyperlink}.[br/][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_COLD_DARK@HERO_SKILL@NAME"
msgstr "Magia Cegante"

msgid "TOME_COLD_DARK@PASSIVE@DESCRIPTION"
msgstr "Destruir <<m:{GLOBAL.CityConcept}>> e saquear <<m:{GLOBAL.ProvinceConcept}>> transforma a {GLOBAL.ProvinceConcept} em uma província Ártica."

msgid "TOME_COLD_DARK@PASSIVE@NAME"
msgstr "Ruínas Congeladas"

msgid "TOME_COLD_DARK@PASSIVE_FARMING@DESCRIPTION"
msgstr "Capacidade de construir <<m:{GLOBAL.FarmConcept.Hyperlink}>> em terrenos de Neve.[br/][br/]<<m:{GLOBAL.FarmConcept.Hyperlink}>> em terrenos de Neve ganham +{amount} {GLOBAL.FoodConcept.Hyperlink} se sua raça tiver Adaptação Ártica."

msgid "TOME_COLD_DARK@PASSIVE_FARMING@NAME"
msgstr "Agricultura Ártica"

msgid "TOME_COLD_DARK@PASSIVE_STABILITY@DESCRIPTION"
msgstr "<<m:{GLOBAL.ProvinceConcept.Hyperlink}>> com Neve dão +{amount} {GLOBAL.CityStabilityConcept.Hyperlink}."

msgid "TOME_COLD_DARK@PASSIVE_STABILITY@NAME"
msgstr "Preferência por Neve"

msgid "TOME_COLD_DARK@SKILL1@DESCRIPTION"
msgstr "A cada turno, por {BLINDING_MIST_AUTO_SPELL>TimeToLive} <<m:{GLOBAL.TurnConcept}>>, todos os inimigos:[bulletlist][bullet/]Sofrem {WITHERING_MIST_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Têm uma chance base de {BLINDED_RESISTANCE>ResolvedStrength}% de ficarem {GLOBAL.PROPERTIES.BLINDED.Hyperlink} por {BLINDED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Têm uma chance base de {WEAKENED_RESISTANCE>ResolvedStrength}% de ficarem {GLOBAL.PROPERTIES.WEAKENED.Hyperlink} por {WEAKENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "TOME_COLD_DARK@SKILL1@NAME"
msgstr "Névoa Murchante"

msgid "TOME_COLD_DARK@SKILL1@PROPERTY@DESCRIPTION"
msgstr "A cada turno, todos os inimigos:[bulletlist][bullet/]Sofrem {WITHERING_MIST_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Têm uma chance base de {BLINDED_RESISTANCE>ResolvedStrength}% de ficarem {GLOBAL.PROPERTIES.BLINDED.Hyperlink} por {BLINDED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Têm uma chance base de {WEAKENED_RESISTANCE>ResolvedStrength}% de ficarem {GLOBAL.PROPERTIES.WEAKENED.Hyperlink} por {WEAKENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "TOME_COLD_DARK@SKILL2@DESCRIPTION"
msgstr "Invoca um {GLOBAL.UNITS.SNOW_SPIRIT.Hyperlink}, um {GLOBAL.PROPERTIES.MAGIC_FIGHTER.Hyperlink} com ataques que infligem {GLOBAL.PROPERTIES.FROZEN.Hyperlink}."

msgid "TOME_COLD_DARK@SKILL2@NAME"
msgstr "Invocar Espírito da Neve"

msgid "TOME_COLD_DARK@SKILL3@DESCRIPTION"
msgstr "Faz o inverno correr nas veias da raça alvo, concedendo-lhes:[bulletlist][bullet/]{FROSTLING_TRANSFORMATION_DEFENSE>REDUCTION>Frost} {GLOBAL.FrostResistanceConcept.Hyperlink}.[bullet/]Imunidade a {GLOBAL.PROPERTIES.FROZEN.Hyperlink}.[bullet/]+{FROSTLING_TRANSFORMATION_MORALE_BONUS_FROZEN_WASTE>MoraleBonus} {GLOBAL.UnitMoraleConcept.Hyperlink} enquanto em terrenos frios.[bullet/]{GLOBAL.PROPERTIES.ARCTIC_WALK.Hyperlink}, que permite que eles atravessem terrenos frios mais rapidamente.[/bulletlist]"

msgid "TOME_COLD_DARK@SKILL3@NAME"
msgstr "Transformação em Frostling"

msgid "TOME_COLD_DARK@SKILL3@PROP_DESCRIPTION"
msgstr "A unidade tem:[bulletlist][bullet/]{FROSTLING_TRANSFORMATION_DEFENSE>REDUCTION>Frost} {GLOBAL.FrostResistanceConcept.Hyperlink}.[bullet/]Imunidade a {GLOBAL.PROPERTIES.FROZEN.Hyperlink}.[bullet/]+{FROSTLING_TRANSFORMATION_MORALE_BONUS_FROZEN_WASTE>MoraleBonus} {GLOBAL.UnitMoraleConcept.Hyperlink} enquanto em terrenos frios.[bullet/]{GLOBAL.PROPERTIES.ARCTIC_WALK.Hyperlink}.[/bulletlist]"

msgid "TOME_COLD_DARK@SKILL4@DESCRIPTION"
msgstr "O alvo que está liderando um exército ganha {GLOBAL.PROPERTIES.UNIVERSAL_CAMOUFLAGE.Hyperlink} para todo o seu exército por {turns} <<m:{GLOBAL.TurnConcept}>>."

msgid "TOME_COLD_DARK@SKILL4@NAME"
msgstr "Véu da Escuridão"

msgid "TOME_COLD_DARK@SKILL4@PROPERTY@DESCRIPTION"
msgstr "Todo o exército ganha {GLOBAL.PROPERTIES.UNIVERSAL_CAMOUFLAGE.Hyperlink}."

msgid "TOME_COLD_DARK@SKILL5@DESCRIPTION"
msgstr "A {GLOBAL.CityConcept.Hyperlink} amiga alvo ganha:[bulletlist]A cada {GLOBAL.TurnConcept.Hyperlink}, {amount} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> dentro ou adjacente ao {GLOBAL.DomainConcept.Hyperlink}:[bulletlist][bullet/]Ganham {GLOBAL.SnowConcept.Hyperlink} e {GLOBAL.FrozenWasteConcept.Hyperlink}.[bullet/]Perdem {GLOBAL.ChasmConcept.Hyperlink}, {GLOBAL.SwampConcept.Hyperlink}, {GLOBAL.AshlandsConcept.Hyperlink}, {GLOBAL.SandConcept.Hyperlink}, {GLOBAL.CavernFloorConcept.Hyperlink}, {GLOBAL.FungusFieldsConcept.Hyperlink} e {GLOBAL.GloomTerrainConcept.Hyperlink}.[/bulletlist][bullet/]Províncias no domínio com Neve ou Gelo fornecem +{resources} {GLOBAL.FoodConcept.Hyperlink} e +{resources} {GLOBAL.StructureProductionConcept.Hyperlink} de renda.[/bulletlist]"

msgid "TOME_COLD_DARK@SKILL5@NAME"
msgstr "Marcha do Inverno"

msgid "TOME_COLD_DARK@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Espalhe terrenos Árticos por todo o mundo e envolva suas unidades com seu poder, para que possam ser fortalecidas por sua presença."

msgid "TOME_COLD_DARK@TOME@LORE_AUTHOR"
msgstr "Artica, a Fria, Rainha dos Frostlings"

msgid "TOME_COLD_DARK@TOME@LORE_DESCRIPTION"
msgstr "\"A luz traz tanto calor quanto esperança. Apague-a e mergulhe seus inimigos em uma noite fria e eterna! Roube-lhes o conforto, destrua suas esperanças, deixe-os com membros entorpecidos e olhos cegos. A escuridão drenará a vontade de seus inimigos de lutar, de vencer, de viver!\""

msgid "TOME_COLD_DARK@TOME@NAME"
msgstr "Tomo do Frio Escuro"

msgid "TOME_CREATOR@HERO_SKILL@DESCRIPTION"
msgstr "A unidade cresce em tamanho e ganha:[bulletlist][bullet/]{GLOBAL.PROPERTIES.LARGE_TARGET.Hyperlink}[bullet/]+{ANCIENT_OF_EARTH_STAT_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]+{ANCIEN_OF_EARTH_DAMAGE_MULTIPLIER>ResolvedMultiplier}% de dano[/bulletlist][br/]A unidade não pode mais usar uma montaria."

msgid "TOME_CREATOR@HERO_SKILL@DESCRIPTION_DRGON"
msgstr "A unidade ganha:[bulletlist][bullet/]+{ANCIENT_OF_EARTH_STAT_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]+{ANCIEN_OF_EARTH_DAMAGE_MULTIPLIER>ResolvedMultiplier}% de dano[/bulletlist]"

msgid "TOME_CREATOR@HERO_SKILL@ES_NAME"
msgstr "Ancestral"

msgid "TOME_CREATOR@HERO_SKILL@NAME"
msgstr "Ancestral da Terra"

msgid "TOME_CREATOR@PASSIVE@DESCRIPTION"
msgstr "Unidades não-{GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink} são produzidas com {amount} de Patente."

msgid "TOME_CREATOR@PASSIVE@NAME"
msgstr "Forjas Lendárias"

msgid "TOME_CREATOR@SKILL1@SPELL2@DESCRIPTION"
msgstr "A província Montanhosa alvo se torna uma província Rochosa."

msgid "TOME_CREATOR@SKILL1@SPELL2@NAME"
msgstr "Montanhas Rebaixadas"

msgid "TOME_CREATOR@SKILL2@DESCRIPTION"
msgstr "[bulletlist][bullet/]Invoca um {GLOBAL.UNITS.EARTH_TITAN_UNIT.Hyperlink} no hexágono alvo desocupado.[bullet/]Todos os inimigos adjacentes perdem sua {GLOBAL.DefenseModeConcept.Hyperlink} e {GLOBAL.RetaliationConcept.Hyperlink}.[/bulletlist][br/][br/]{LOC.TACTICAL@ABILITY@NEVER_IN_WATER}"

msgid "TOME_CREATOR@SKILL2@NAME"
msgstr "Chamar o Titã da Terra"

msgid "TOME_CREATOR@SKILL3@DESCRIPTION"
msgstr "[bulletlist][bullet/]Todos os inimigos sofrem {TECTONIC_SHATTER_UNIT_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Todos os inimigos têm uma chance base de {STUNNED_RESISTANCE>ResolvedStrength}% de ficarem {GLOBAL.PROPERTIES.STUNNED.Hyperlink}.[bullet/]Todos os obstáculos no mapa têm uma chance de {obstacles} de serem destruídos.[/bulletlist]"

msgid "TOME_CREATOR@SKILL3@NAME"
msgstr "Esmagamento Tectônico"

msgid "TOME_CREATOR@SKILL4@DESCRIPTION"
msgstr "Concede às unidades encantadas:[bulletlist][bullet/]{GLOBAL.PROPERTIES.NATURAL_REGENERATION_GROUP.Hyperlink}[bullet/]+{SHAPERS_TOUCH_STAT_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]+{SHAPERS_TOUCH_DEFENSE>REDUCTION>Shock} {GLOBAL.LightningResistanceConcept.Hyperlink}[/bulletlist]"

msgid "TOME_CREATOR@SKILL4@NAME"
msgstr "Toque do Moldador"

msgid "TOME_CREATOR@SKILL4@PROP_DESCRIPTION"
msgstr "A unidade tem:[bulletlist][bullet/]{GLOBAL.PROPERTIES.NATURAL_REGENERATION_GROUP.Hyperlink}[bullet/]+{SHAPERS_TOUCH_STAT_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]+{SHAPERS_TOUCH_DEFENSE>REDUCTION>Shock} {GLOBAL.LightningResistanceConcept.Hyperlink}[/bulletlist]"

msgid "TOME_CREATOR@SKILL5@NAME"
msgstr "Era do Materium"

msgid "TOME_CREATOR@SKILL6@DESCRIPTION"
msgstr "[bulletlist][bullet/]No início da batalha, todos os obstáculos de Parede são danificados.[bullet/]No início da batalha, ganhe {amount} unidades de {GLOBAL.UNITS.EARTHSHATTER_ENGINE_UNIT.Hyperlink} no lado do atacante até o final da batalha.[bullet/]<<m:{GLOBAL.UNITS.EARTHSHATTER_ENGINE_UNIT.Hyperlink}>> são unidades {GLOBAL.PROPERTIES.SIEGECRAFT_UNIT.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> com ataques de curto alcance e área de efeito que podem destruir obstáculos e tirar unidades inimigas da {GLOBAL.DefenseModeConcept.Hyperlink}.[bullet/]Apenas um tipo de unidade de Cerco pode ser trazido para a {GLOBAL.CombatConcept.Hyperlink}. Se múltiplos <<m:{GLOBAL.SiegeProjectConcept.Hyperlink}>> trouxerem elas, apenas a mais forte delas aparecerá.[/bulletlist]"

msgid "TOME_CREATOR@SKILL6@NAME"
msgstr "Criar Motores de Esmagamento Terrestre"

msgid "TOME_CREATOR@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Modele o mundo, invoque titãs adormecidos e torne-se o mestre da terra."

msgid "TOME_CREATOR@TOME@LORE_AUTHOR"
msgstr "Mãe Mab, Deusa dos Goblins"

msgid "TOME_CREATOR@TOME@LORE_DESCRIPTION"
msgstr "\"Aqueles que dominam o Materium estão acima do mundo, arrasando e derrubando terras a seu bel-prazer, e aproveitando as forças primordiais da criação. Os próprios titãs caminharão com você, enquanto as essências do elemento e do mineral se ajoelham. Você é o Criador, um moldador de mundos.\""

msgid "TOME_CREATOR@TOME@NAME"
msgstr "Tomo do Criador"

msgid "TOME_CREATOR@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Alvos todos os inimigos dentro de {SEISMIC_SLAM_UNIT_TARGETER_CIRCLE>AREA>Radius} hexágonos."

msgid "TOME_CREATOR@UNIT1@ABILITY1@NAME"
msgstr "Impacto Sísmico"

msgid "TOME_CREATOR@UNIT1@DESCRIPTION"
msgstr "Obedecendo apenas ao comando dos mestres absolutos da terra, o Titã da Terra é uma força imparável e a personificação da fúria da terra."

msgid "TOME_CREATOR@UNIT1@NAME"
msgstr "Titã da Terra^n"

msgid "TOME_CREATOR@UNIT2@ABILITY1@DESCRIPTION"
msgstr "Unidades inimigas em um raio de {EARTH_TREMOR_UNIT_TARGETER_CIRCLE>AREA>Radius} hexágonos:[bulletlist][bullet/]Sofrem dano[bullet/]Perdem sua {GLOBAL.DefenseModeConcept.Hyperlink}[bullet/]Perdem {GLOBAL.RetaliationConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CREATOR@UNIT2@ABILITY1@NAME"
msgstr "Tremor Terrestre"

msgid "TOME_CREATOR@UNIT2@DESCRIPTION"
msgstr "Lento, mas forte, motor de cerco capaz de destruir seções inteiras de muralhas em momentos."

msgid "TOME_CREATOR@UNIT2@NAME"
msgstr "Motor de Terremoto^n"

msgid "TOME_CRICIBLE@SKILL2@DEFENSE_DESCRIPTION"
msgstr "Adiciona obstáculos de Parapetos de Cadinho em {GLOBAL.CombatConcept.Hyperlink} durante um {GLOBAL.SiegeConcept.Hyperlink}.[br/][br/]Obstáculos de Parapetos de Cadinho concedem ataques {GLOBAL.RangedConcept.Hyperlink} e {GLOBAL.MagicConcept.Hyperlink}:[bulletlist][bullet/]Causa {damage} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Define hexágonos afetados {GLOBAL.OnFireConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CRUCIBLE@HERO_SKILL@DESCRIPTION"
msgstr "[bulletlist][bullet/]Ataques básicos causam {METEOR_ARROWS_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} ao alvo e inimigos adjacentes.[bullet/]Todos os ataques ganham {GLOBAL.PROPERTIES.DEMOLISHER.Hyperlink}.[br/][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}[/bulletlist]"

msgid "TOME_CRUCIBLE@HERO_SKILL@MOD_DESCRIPTION"
msgstr " +{METEOR_ARROWS_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} ao alvo e inimigos adjacentes."

msgid "TOME_CRUCIBLE@HERO_SKILL@NAME"
msgstr "Impactos de Meteoros"

msgid "TOME_CRUCIBLE@PASSIVE@DESCRIPTION"
msgstr "[bulletlist][bullet/]Minas concedem {amount} {GLOBAL.ManaConcept} de renda.[bullet/]Minas agora podem ser construídas em <<m:{GLOBAL.ProvinceConcept}>> com um recurso de Lava ou Abismo.[/bulletlist]"

msgid "TOME_CRUCIBLE@PASSIVE@NAME"
msgstr "Mineração de Pirosifão"

msgid "TOME_CRUCIBLE@SKILL1@DESCRIPTION"
msgstr "Alvo {GLOBAL.ProvinceConcept.Hyperlink}:[bulletlist][bullet/]Se contiver uma {GLOBAL.ProvinceImprovementConcept.Hyperlink} inimiga, ela será [hyperlink,GLOBAL.PillagingConcept]Saqueada[/hyperlink].[bulletlist][bullet/]Você não ganhará suas recompensas ou perderá {GLOBAL.AlignmentConcept.Hyperlink}.[/bulletlist][bullet/]Unidades inimigas <<m:{GLOBAL.UnitConcept.Hyperlink}>> na província sofrem {damage} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]A província ganha {GLOBAL.AshlandsConcept.Hyperlink}.[bullet/]A província perde {GLOBAL.RiverConcept.Hyperlink}, {GLOBAL.FertilePlainsConcept.Hyperlink}, {GLOBAL.SwampConcept.Hyperlink}, {GLOBAL.SnowConcept.Hyperlink}, {GLOBAL.FrozenWasteConcept.Hyperlink}, {GLOBAL.SandConcept.Hyperlink}, {GLOBAL.CavernFloorConcept.Hyperlink} e {GLOBAL.GloomTerrainConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CRUCIBLE@SKILL1@NAME"
msgstr "Erupção Piroclástica"

msgid "TOME_CRUCIBLE@SKILL2@DEFENSE_DESCRIPTION"
msgstr "Adiciona obstáculos de Parapetos de Cadinho em {GLOBAL.CombatConcept.Hyperlink} durante um {GLOBAL.SiegeConcept.Hyperlink}.[br/][br/]Obstáculos de Parapetos de Cadinho concedem ataques {GLOBAL.RangedConcept.Hyperlink} e {GLOBAL.MagicConcept.Hyperlink}:[bulletlist][bullet/]Causa {damage} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Define hexágonos afetados {GLOBAL.OnFireConcept.Hyperlink}.[bullet/]Ignora {GLOBAL.ObscuredConcept.Hyperlink} em alvos.[bullet/]{rangebonus} {GLOBAL.RangeConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CRUCIBLE@SKILL2@DESCRIPTION"
msgstr "{GLOBAL.CityBattlementStructureConcept.Hyperlink}[br/][bulletlist][bullet/]Parapetos concedem ataques {GLOBAL.RangedConcept.Hyperlink} e {GLOBAL.MagicConcept.Hyperlink}:[bulletlist][bullet/]Causa {damage}.[bullet/]Define hexágonos afetados {GLOBAL.OnFireConcept.Hyperlink}.[bullet/]Ignora {GLOBAL.ObscuredConcept.Hyperlink} em alvos.[bullet/]{rangebonus} {GLOBAL.RangeConcept.Hyperlink}[/bulletlist][bullet/]A Cidade ignora penalidades negativas de {GLOBAL.CityStabilityConcept.Hyperlink} por anexar províncias com {GLOBAL.ChasmConcept.Hyperlink} ou {GLOBAL.LavaConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CRUCIBLE@SKILL2@MARKER@DESCRIPTION"
msgstr "Ataques básicos {GLOBAL.RangedConcept.Hyperlink} e {GLOBAL.MagicConcept.Hyperlink}:[bulletlist][bullet/]Causam {damage} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Definem o chão {GLOBAL.OnFireConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CRUCIBLE@SKILL2@MARKER@NAME"
msgstr "Runas Imoladoras"

msgid "TOME_CRUCIBLE@SKILL2@MODIFIER_DESCRIPTION"
msgstr "Esta unidade foi construída em uma Cidade com a estrutura de Cadinho Fortificado, fazendo com que os ataques desta unidade causem {damage}."

msgid "TOME_CRUCIBLE@SKILL2@NAME"
msgstr "Parapetos de Cadinho"

msgid "TOME_CRUCIBLE@SKILL2@UNLOCK@NAME"
msgstr "Parapetos de Cadinho em Combate"

msgid "TOME_CRUCIBLE@SKILL3@DESCRIPTION"
msgstr "Alvos em um raio de {LAVA_BURST_OBSTACLE_TARGETER_CIRCLE>AREA>Radius} hexágonos:[bulletlist][bullet/]Todas as unidades sofrem {LAVA_BURST_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Todas as unidades são afligidas com {GLOBAL.PROPERTIES.BURNING.Hyperlink}.[bullet/]Todas as unidades são {GLOBAL.PROPERTIES.SLOWED.Hyperlink}.[bullet/]O chão é definido {GLOBAL.OnFireConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CRUCIBLE@SKILL3@NAME"
msgstr "Explosão de Lava"

msgid "TOME_CRUCIBLE@SKILL4@DESCRIPTION"
msgstr "Até {METEOR_SHOWER_AUTO_SPELL>MaxCastCount} unidades inimigas aleatórias e inimigos adjacentes a essas:[bulletlist][bullet/]Sofrem {METEOR_SHOWER_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} e {METEOR_SHOWER_UNIT_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[/bulletlist][br/]Esta magia se repete no início de cada turno pelos próximos {METEOR_SHOWER_AUTO_SPELL>TimeToLive} <<m:{GLOBAL.TurnConcept}>>."

msgid "TOME_CRUCIBLE@SKILL4@NAME"
msgstr "Chuva de Meteoros"

msgid "TOME_CRUCIBLE@SKILL5@DESCRIPTION"
msgstr "Faz com que os ataques básicos de unidades encantadas:[bulletlist][bullet/]Causem +{METEOR_ARROWS_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} ao alvo e inimigos adjacentes.[bullet/]Ganhem {GLOBAL.PROPERTIES.DEMOLISHER.Hyperlink}, tornando-os capazes de destruir obstáculos reforçados.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CRUCIBLE@SKILL5@MOD_DESCRIPTION"
msgstr "[bulletlist][bullet/]+{METEOR_ARROWS_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} no alvo e inimigos adjacentes.[bullet/]Possui {GLOBAL.PROPERTIES.DEMOLISHER.Hyperlink}[/bulletlist]"

msgid "TOME_CRUCIBLE@SKILL5@NAME"
msgstr "Projéteis de Meteoro"

msgid "TOME_CRUCIBLE@SKILL5@PROP_DESCRIPTION"
msgstr "Os ataques base da unidade possuem:[bulletlist][bullet/]+{METEOR_ARROWS_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} no alvo e inimigos adjacentes.[bullet/]{GLOBAL.PROPERTIES.DEMOLISHER.Hyperlink}.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CRUCIBLE@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Enterre seus inimigos em lava e molde a terra usando as forças destrutivas da terra e do fogo."

msgid "TOME_CRUCIBLE@TOME@LORE_AUTHOR"
msgstr "Yaka, autoproclamado Deus do Fogo"

msgid "TOME_CRUCIBLE@TOME@LORE_DESCRIPTION"
msgstr "\"Não é o magma um espetáculo glorioso de se contemplar? Uma união de fogo e terra fluindo inexoravelmente em direção aos seus inimigos, engolindo-os, trazendo a morte flamejante! A própria paisagem é remodelada quando flui, com cicatrizes belas traçadas sobre o reino.\""

msgid "TOME_CRUCIBLE@TOME@NAME"
msgstr "Tomo do Cadinho"

msgid "TOME_CRYOMANCY@PASSIVE@DESCRIPTION"
msgstr "Ganha {amount} {GLOBAL.KnowledgeConcept} por {GLOBAL.UnitConcept} de Tier morto em {GLOBAL.CombatConcept}."

msgid "TOME_CRYOMANCY@PASSIVE@NAME"
msgstr "Preservar Espécimes"

msgid "TOME_CRYOMANCY@SKILL_1@DESCRIPTION"
msgstr "Alvo inimigo:[bulletlist][bullet/]Sofre {ICE_COFFIN_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Tem uma chance base de {FROZEN_RESISTANCE>ResolvedStrength}% de se tornar {GLOBAL.PROPERTIES.FROZEN.Hyperlink}. Se não for bem-sucedido, inflige {GLOBAL.PROPERTIES.STATUS_VULNERABILITY.Hyperlink}.[/bulletlist]"

msgid "TOME_CRYOMANCY@SKILL_1@NAME"
msgstr "Caixão de Gelo"

msgid "TOME_CRYOMANCY@SKILL_2@DESCRIPTION"
msgstr "Concede acesso a um {GLOBAL.PROPERTIES.BATTLE_MAGE.Hyperlink} que inflige {GLOBAL.PROPERTIES.FROZEN.Hyperlink}."

msgid "TOME_CRYOMANCY@SKILL_2@NAME"
msgstr "Bruxa Branca^f"

