msgstr "Faz com que os ataques base {GLOBAL.RangedConcept.Hyperlink} de unidades encantadas ganhem:[bulletlist][bullet/]+{FROST_BLADES_EXTRA_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]{FROST_BLADES_EXTRA_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Uma chance base de {SLOWED_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.SLOWED.Hyperlink}.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CRYOMANCY@SKILL_6@NAME"
msgstr "Flechas de Gelo"

