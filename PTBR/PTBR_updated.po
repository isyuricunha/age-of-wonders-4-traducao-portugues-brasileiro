msgid "INTERFACE@MAP_SETUP_TOOLTIP@MANGROVE"
msgstr "Definir a frequência do terreno de Floresta de Mangue em relação aos outros tipos de terreno"

msgid "INTERFACE@MAP_SETUP_TOOLTIP@MARAUDER_TC_AI_PROFILE"
msgstr "Nível de dificuldade de combates contra exércitos de Saqueadores"

msgid "INTERFACE@MAP_SETUP_TOOLTIP@MOUNTAINS"
msgstr "Definir a frequência do terreno de Montanhas em relação aos outros tipos de terreno"

msgid "INTERFACE@MAP_SETUP_TOOLTIP@MUSHROOM_FOREST"
msgstr "Definir a frequência do terreno de Floresta de Cogumelos em relação aos outros tipos de terreno"

msgid "INTERFACE@MAP_SETUP_TOOLTIP@OBSERVE_COMBAT"
msgstr "Selecionar quando observar um encontro de Combate Manual de um jogador humano."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@OBSERVE_COMBAT_ALWAYS"
msgstr "Sempre observar combate."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@OBSERVE_COMBAT_NEVER"
msgstr "Nunca observar combate."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@OBSERVE_COMBAT_VISIBLE"
msgstr "Observar combate apenas quando ele acontecer em um local visível."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@OCEAN"
msgstr "Definir a frequência do clima Oceânico em relação aos outros climas"

msgid "INTERFACE@MAP_SETUP_TOOLTIP@PLAYERS"
msgstr "Selecionar o número de jogadores para este jogo."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@PLAYER_DISTANCE"
msgstr "Gera um tamanho de mapa baseado no número de jogadores, com uma distância variável entre as posições iniciais dos jogadores."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@PLAYER_EMPIRE_MECHANICS"
msgstr "Quando ativado, {GLOBAL.PantheonLoreConcept.Hyperlink} <<m:{GLOBAL.LeaderConcept.Hyperlink}>> começará com <<m:{GLOBAL.AscensionTraitConcept.Hyperlink}>>, <<m:{GLOBAL.AscendedTransformationConcept.Hyperlink}>> e habilidades de herói ascendido. Além disso, governantes do panteão marcados como heróis recrutáveis podem ser oferecidos como herói e, na vitória, um governante pode ascender ao Panteão.[br/][br/]Governantes do Panteão sempre podem ser selecionados independentemente dessa configuração."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@PLAYER_EMPIRE_MECHANICS_BONUSTRAIT"
msgstr "Quando ativado, {GLOBAL.PantheonLoreConcept.Hyperlink} <<m:{GLOBAL.LeaderConcept.Hyperlink}>> começará com <<m:{GLOBAL.AscensionTraitConcept.Hyperlink}>>.{LOC.INTERFACE@MAP_SETUP_TOOLTIP@PLAYER_EMPIRE_MECHANICS_GENERAL}"

msgid "INTERFACE@MAP_SETUP_TOOLTIP@PLAYER_EMPIRE_MECHANICS_GENERAL"
msgstr "[br/][br/]Governantes do Panteão sempre podem ser selecionados independentemente dessa configuração e, na vitória, um governante pode ascender ao Panteão."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@PLAYER_EMPIRE_MECHANICS_HERORECRUITMENT"
msgstr "Quando ativado, {GLOBAL.PantheonLoreConcept.Hyperlink} <<m:{GLOBAL.LeaderConcept.Hyperlink}>> marcado como heróis recrutáveis pode ser oferecido como herói. Em Multijogador e Reinos de História, governantes do panteão não podem ser recrutados como heróis.{LOC.INTERFACE@MAP_SETUP_TOOLTIP@PLAYER_EMPIRE_MECHANICS_GENERAL}"

msgid "INTERFACE@MAP_SETUP_TOOLTIP@PLAYER_EMPIRE_MECHANICS_TRANSFORMATIONS"
msgstr "Quando ativado, {GLOBAL.PantheonLoreConcept.Hyperlink} <<m:{GLOBAL.LeaderConcept.Hyperlink}>> começará com <<m:{GLOBAL.AscendedTransformationConcept.Hyperlink}>> e habilidades de herói ascendido.{LOC.INTERFACE@MAP_SETUP_TOOLTIP@PLAYER_EMPIRE_MECHANICS_GENERAL}"

msgid "INTERFACE@MAP_SETUP_TOOLTIP@RANDOM_TRAIT_FILTER_LIST"
msgstr "Editar quais traços podem aparecer na randomização"

msgid "INTERFACE@MAP_SETUP_TOOLTIP@REEF"
msgstr "Definir a frequência do terreno de Recife em relação aos outros tipos de terreno"

msgid "INTERFACE@MAP_SETUP_TOOLTIP@RESEARCH_SPEED"
msgstr "Modificador para o custo de toda pesquisa."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@RESEARCH_SPEED_FAST"
msgstr "Toda pesquisa tem seu custo de conhecimento reduzido em -{Value}%."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@RESEARCH_SPEED_NORMAL"
msgstr "A pesquisa terá o custo normal de conhecimento."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@RESEARCH_SPEED_SLOW"
msgstr "Toda pesquisa tem seu custo de conhecimento aumentado em +{Value}%."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@RESTART_COMBAT_AI_ONLY"
msgstr "Permitido apenas contra IA"

msgid "INTERFACE@MAP_SETUP_TOOLTIP@RESTART_COMBAT_ALWAYS"
msgstr "Sempre permitido"

msgid "INTERFACE@MAP_SETUP_TOOLTIP@RESTART_COMBAT_NEVER"
msgstr "Nunca permitido"

msgid "INTERFACE@MAP_SETUP_TOOLTIP@RIVER"
msgstr "Defina a frequência de Rios"

msgid "INTERFACE@MAP_SETUP_TOOLTIP@ROCKY"
msgstr "Defina a frequência do tipo de terreno Rochoso em relação aos outros tipos de terreno"

msgid "INTERFACE@MAP_SETUP_TOOLTIP@SAND"
msgstr "Defina a frequência do tipo de terreno Arenoso em relação aos outros tipos de terreno"

msgid "INTERFACE@MAP_SETUP_TOOLTIP@SCORE_VICTORY"
msgstr "Ativar/Desativar Vitória por Pontuação[br/]A Vitória por Pontuação é alcançada ao ter a maior pontuação acumulada no final do limite de turnos definido. A pontuação depende do seu desempenho em várias áreas, que podem ser revisadas no jogo."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@SCORE_VICTORY_COMBO"
msgstr "Selecione o limite de turnos para a Vitória por Pontuação."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@SCORE_VICTORY_OPTION"
msgstr "Limite de {INT_DURATION}[turno/] turnos."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@SEALS_VICTORY"
msgstr "Descrição da vitória por Selos"

msgid "INTERFACE@MAP_SETUP_TOOLTIP@SEALS_VICTORY_COMBO"
msgstr "Descrição do menu suspenso de selos"

msgid "INTERFACE@MAP_SETUP_TOOLTIP@SEALS_VICTORY_OPTION"
msgstr "Os jogadores precisam de {INT_Points} Pontos de Selos para alcançar a vitória"

msgid "INTERFACE@MAP_SETUP_TOOLTIP@SEAL_COUNT_COMBO"
msgstr "Descrição do menu suspenso de contagem de selos"

msgid "INTERFACE@MAP_SETUP_TOOLTIP@SHOPS_ENABLED"
msgstr "Lojas são <<m:{GLOBAL.LocationConcept.Hyperlink}>> que podem aparecer aleatoriamente em seu domínio conforme você joga. Em troca de {GLOBAL.GoldConcept.Hyperlink} ou {GLOBAL.ManaConcept.Hyperlink}, elas podem lhe dar acesso a muitos bônus únicos, como novas montarias e habilidades para seus heróis, ou informações sobre o paradeiro de seus inimigos."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@SNOW"
msgstr "Defina a frequência do tipo de terreno Neve em relação aos outros tipos de terreno"

msgid "INTERFACE@MAP_SETUP_TOOLTIP@STARTING_RESOURCES"
msgstr "Selecione a quantidade de recursos que cada jogador recebe no início do jogo, bem como o tamanho de seu exército inicial."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@STARTING_UNITS_NORMAL"
msgstr "A composição inicial regular."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@STARTING_UNITS_STRONG"
msgstr "Mais unidades do que a composição inicial regular."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@STARTING_UNITS_WEAK"
msgstr "Menos unidades do que a composição inicial regular."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@SUB_TROPICAL"
msgstr "Defina a frequência do clima Sub-Tropical em relação aos outros climas"

msgid "INTERFACE@MAP_SETUP_TOOLTIP@SUNKEN_RUINS"
msgstr "Defina a frequência do tipo de terreno Ruínas Submersas em relação aos outros tipos de terreno"

msgid "INTERFACE@MAP_SETUP_TOOLTIP@TACTICAL_TIMER_COMBO"
msgstr "Selecione a velocidade na qual os turnos devem ser jogados no combate tático."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@TACTICAL_TIMER_SPEED"
msgstr "Você recebe {INT_BASE} segundos por turno e um adicional de {INT_PERUNIT} segundos por unidade que você controla."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@TEAMS"
msgstr "Ativar/Desativar Times[br/]Ativar times permitirá que você defina um time para cada jogador. Jogadores no mesmo time estão em uma aliança permanente com jogadores do mesmo time, enquanto estão permanentemente em guerra com jogadores de outros times.[br/][br/][warningRed]Ativar times desativará muitos sistemas diplomáticos, como <<m:{GLOBAL.CasusBelliConcept.Hyperlink}>> e mudança de Estados Diplomáticos.[/warningRed]"

msgid "INTERFACE@MAP_SETUP_TOOLTIP@TEMPERATE"
msgstr "Defina a frequência do clima Temperado em relação aos outros climas"

msgid "INTERFACE@MAP_SETUP_TOOLTIP@TRAIT_COMPLEXITY"
msgstr "Selecione a complexidade dos traços que serão escolhidos para <<m:{GLOBAL.UnknownTraitConcept.Hyperlink}>> neste reino."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@TRAIT_COMPLEXITY@COMPLEX"
msgstr "Foco em traços de reino complexos."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@TRAIT_COMPLEXITY@NORMAL"
msgstr "A experiência padrão, uma ampla variedade de traços diferentes será escolhida."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@TRAIT_COMPLEXITY@SIMPLE"
msgstr "Foco em traços de reino simples."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@TURN_SYSTEM"
msgstr "Selecione o Sistema de Turnos usado para este Jogo:[bulletlist][bullet/]<<m:{GLOBAL.ClassicTurnConcept.Hyperlink}>>: Todos jogam seus turnos em ordem, um após o outro.[bullet/]<<m:{GLOBAL.SimultaneousTurnConcept.Hyperlink}>>: Todos jogam seus turnos ao mesmo tempo.[/bulletlist]"

msgid "INTERFACE@MAP_SETUP_TOOLTIP@TURN_SYSTEM_CLASSIC"
msgstr "Em turnos clássicos, todos jogam seus turnos na ordem da lista de Governantes. Uma vez que o último Governante tenha terminado seu turno, a próxima rodada começará com o primeiro Governante."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@TURN_SYSTEM_SIM"
msgstr "Em turnos simultâneos, todos jogam seus turnos ao mesmo tempo. Uma vez que cada Governante tenha terminado seu turno, a próxima rodada começará."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@TURN_TIMER"
msgstr "Ativar/Desativar o Timer de Turno Estratégico[br/]O timer de turno determina quanto tempo um jogador tem a cada turno antes que ele termine automaticamente."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@TURN_TIMER_LONG"
msgstr "Ativar/Desativar o Timer de Turno Longo[br/]Este timer continua contando, mesmo quando você não está jogando. Outros jogadores podem escolher passar seu turno depois que o tempo acabar."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@TURN_TIMER_OFF"
msgstr "O timer de turno está desativado."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@TURN_TIMER_SPEED"
msgstr "O tempo total por turno é calculado com base em:[br/]Uma base de +{INT_BASE} segundos.[br/]+{INT_PERSTACK} segundos para cada 6 unidades além das suas primeiras 6 unidades.[br/]+{INT_PERCOLONY} segundos para cada cidade além da sua primeira."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@UNDERGROUND"
msgstr "Define a frequência do clima Subterrâneo em relação aos outros climas (Subterrâneo é único e não funciona dessa forma!)"

msgid "INTERFACE@MAP_SETUP_TOOLTIP@USE_COMBAT_RESTART"
msgstr "Ativa a opção de reiniciar o Combate Manual.[br/]Isso torna possível reiniciar durante uma batalha e tentar uma estratégia diferente, se desejado."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@USE_COMBAT_RETRY"
msgstr "Ativa a opção de repetir um combate a partir da tela de resultados.[br/]Isso torna possível repetir manualmente um combate após ele ter sido concluído, se o combate não terminou com um resultado favorável."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@WATER"
msgstr "Define a frequência do tipo de terreno Água em relação aos outros tipos de terreno."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@WETLANDS"
msgstr "Define a frequência do tipo de terreno Pântano em relação aos outros tipos de terreno."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@WORLD_SIZE"
msgstr "Selecione o tamanho do mundo gerado aleatoriamente. Isso determina uma faixa para o número de províncias que o mundo terá."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@WORLD_THREAT"
msgstr "Determina a força geral dos exércitos independentes, a velocidade com que eles atualizam sua força e a frequência com que enviam exércitos atacantes."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@WORLD_THREAT_DANGEROUS"
msgstr "Exércitos inimigos são aumentados em força e aumentam em força ao longo do tempo em uma taxa mais rápida.[br/][br/]Cidades livres e infestações enviarão exércitos atacantes com frequência."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@WORLD_THREAT_LOW"
msgstr "Exércitos inimigos são reduzidos em força e aumentam em força ao longo do tempo em uma taxa lenta.[br/][br/]Cidades livres e infestações enviarão menos exércitos atacantes."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@WORLD_THREAT_MODERATE"
msgstr "Exércitos inimigos têm força normal e aumentam em força ao longo do tempo em uma taxa balanceada.[br/][br/]Cidades livres e infestações enviarão exércitos atacantes regularmente."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@WORLD_THREAT_PASSIVE"
msgstr "Exércitos inimigos são reduzidos em força e aumentam em força ao longo do tempo em uma taxa lenta.[br/][br/]Cidades livres e infestações não enviarão exércitos atacantes."

msgid "INTERFACE@MAP_SETUP_WARNING@HUMAN_IN_PRESENCE_TRAIT"
msgstr "Presence Trait can't be changed while a player occupies one of its Player Slots."

msgid "INTERFACE@MAP_SETUP_WARNING@PLAYER_COUNT_UNKOWN_PRESENCE_TRAIT"
msgstr "O número de jogadores pode diferir com base no traço de presença escolhido."

msgid "INTERFACE@MARK_TUTORIAL_READ_MESSAGE@DIALOG_HEADER"
msgstr "Tutorial no Jogo"

msgid "INTERFACE@MARK_TUTORIAL_READ_MESSAGE@DIALOG_MESSAGE"
msgstr "As Mensagens de Ajuda foram atualizadas, adicionando novos Tutoriais e melhorando a Experiência de Integração. Enquanto joga, você pode receber Mensagens de Ajuda sobre coisas que já conhece ou completou antes.[br/] Gostaria de marcar todas as Mensagens de Ajuda do jogo base como lidas/concluídas?"

msgid "INTERFACE@MEET_PLAYER_EVENT@MEET_PLAYER"
msgstr "Você conheceu um Governante"

msgid "INTERFACE@MESSAGE_PANEL@ABANDON_SESSION_DESCRIPTION"
msgstr "Você está prestes a abandonar a sessão! Seu turno será assumido por um jogador de IA e você não poderá continuar jogando. [br/][br/]Deseja continuar?"

msgid "INTERFACE@MESSAGE_PANEL@ABORT_SESSION_DESCRIPTION"
msgstr "Você está prestes a abortar e encerrar a sessão. Todos os jogadores que entraram serão expulsos automaticamente. [br/][br/]Deseja continuar?"

msgid "INTERFACE@MESSAGE_PANEL@ARE_YOU_SURE"
msgstr "Tem certeza?"

msgid "INTERFACE@MESSAGE_PANEL@ARE_YOU_SURE_SETTINGS"
msgstr "Tem certeza de que deseja cancelar? Configurações não salvas serão perdidas."

msgid "INTERFACE@MESSAGE_PANEL@ARE_YOU_SURE_SETTINGS_HEADER"
msgstr "Cancelar Configurações"

msgid "INTERFACE@MESSAGE_PANEL@ENEMY_ROUTED_DESCRIPTION"
msgstr "O inimigo está fugindo do campo. Deseja reclamar a vitória e vencer a batalha imediatamente?"

msgid "INTERFACE@MESSAGE_PANEL@ENEMY_ROUTED_TITLE"
msgstr "Reclamar Vitória Agora?"

msgid "INTERFACE@MESSAGE_PANEL@FLEE_UNIT_DESCRIPTION"
msgstr "Mover uma unidade para uma zona de retirada fará com que ela fique em fuga e saia da batalha! [br/][bulletlist][bullet/]Unidades próximas [fireCol]perderão moral [morale/][/fireCol].[bullet/]A unidade [fireCol]perderá Pontos de Movimento [movementwalk/][/fireCol] após a batalha.[bullet/]Recuar sua última unidade fará com que você [fireCol]perca a batalha[/fireCol].[bullet/]Se você perder a batalha, a [fireCol]unidade morrerá ou se dispersará e reaparecerá em uma de suas cidades após alguns turnos[/fireCol].[/bulletlist]"

msgid "INTERFACE@MESSAGE_PANEL@RESTART_DESCRIPTION"
msgstr "Tem certeza de que deseja reiniciar o combate? Dados não salvos serão perdidos."

msgid "INTERFACE@MESSAGE_PANEL@STRATEGIC_MAP_SURRENDER_DESCRIPTION"
msgstr "Você está prestes a se render no jogo. Suas cidades se tornarão independentes e afundarão na anarquía, e seus exércitos serão dispensados. [br/][br/]Tem certeza?"

msgid "INTERFACE@MESSAGE_PANEL@SURRENDER_DESCRIPTION"
msgstr "Tem certeza de que deseja se render? Render-se fará com que todas as suas unidades fujam e tentem sair do campo de batalha."

msgid "INTERFACE@MODAL_DIPLOMATIC_STATE_QUEUED@DESCRIPTION"
msgstr "Seu estado diplomático com {Target.Lord.Name} está mudando para {DiplomaticState.Hyperlink} em {Duration} <<m:{GLOBAL.TurnConcept.Hyperlink}>>. Você não pode atacar {Target.Lord.FirstName} neste turno."

msgid "INTERFACE@MODAL_DIPLOMATIC_STATE_QUEUED@DESCRIPTION_ALLIANCE"
msgstr "Você acabou de quebrar uma aliança. Você não pode atacar seu ex-aliado neste turno."

msgid "INTERFACE@MODAL_DIPLOMATIC_STATE_QUEUED@DESCRIPTION_PEACE"
msgstr "Você acabou de quebrar um pacto de não-agressão. Você não pode atacar o Governante com quem tinha esse pacto neste turno."

msgid "INTERFACE@MODAL_DIPLOMATIC_STATE_QUEUED@DESCRIPTION_VASSAL"
msgstr "Seu estado diplomático com {Target.Lord.Name} está mudando para {DiplomaticState.Hyperlink} em {Duration} <<m:{GLOBAL.TurnConcept.Hyperlink}>>. Você não pode atacar seu vassalo neste turno."

msgid "INTERFACE@MODAL_DIPLOMATIC_STATE_QUEUED@HEADER"
msgstr "Mudança de Estado Diplomático Pendente"

msgid "INTERFACE@MODAL_HOSTILE_ACTION@ATTACK_ALLIEDTRESPASSER_DESCRIPTION"
msgstr "O exército invasor pertence a um de seus aliados, {STR_targetPlayer}. Você deve romper seu {DiplomaticState.Hyperlink} com {STR_targetPlayer} antes de poder atacar esse invasor em seu domínio. Tem certeza de que deseja romper o {DiplomaticState.Name}?"

msgid "INTERFACE@MODAL_HOSTILE_ACTION@ATTACK_TRESPASSER_DESCRIPTION"
msgstr "Você está prestes a atacar um exército pertencente a {STR_targetPlayer}, que está invadindo seu domínio. Você não está atualmente em guerra com {STR_targetPlayer}, e eles ganharão {CasusBelliValue}[casusBelli/] se você os atacar. Tem certeza de que deseja atacar este exército?"

msgid "INTERFACE@MODAL_HOSTILE_ACTION@DESCRIPTION_ALLIANCE"
msgstr "Você está prestes a romper sua {GLOBAL.DSAllianceConcept.Hyperlink} com {STR_targetPlayer}. Isso incorrerá em uma penalidade de relações! Tem certeza de que deseja romper a aliança?"

msgid "INTERFACE@MODAL_HOSTILE_ACTION@DESCRIPTION_DEFENSIVE"
msgstr "Você está prestes a romper seu {GLOBAL.DefensivePactConcept.Hyperlink} com {STR_targetPlayer}. Isso incorrerá em uma penalidade de relações e quaisquer tratados dependentes serão quebrados! Tem certeza de que deseja romper o pacto defensivo?"

msgid "INTERFACE@MODAL_HOSTILE_ACTION@DESCRIPTION_FIXED"
msgstr "Você atualmente compartilha relações fixas com {STR_targetPlayer} e, portanto, não pode declarar guerra para atacá-los."

msgid "INTERFACE@MODAL_HOSTILE_ACTION@DESCRIPTION_INDEPENDENT"
msgstr "Você está prestes a declarar {GLOBAL.IndependentCityWarConcept.Hyperlink} em {STR_targetPlayer}. Isso conta como um ato [evilact/] [hyperlink,GLOBAL.AlignmentConcept]maligno[/hyperlink]! Tem certeza de que deseja declarar guerra?"

msgid "INTERFACE@MODAL_HOSTILE_ACTION@DESCRIPTION_NEUTRAL"
msgstr "Você está prestes a declarar guerra em {STR_targetPlayer}. Tem certeza?"

msgid "INTERFACE@MODAL_HOSTILE_ACTION@DESCRIPTION_VASSALAGE"
msgstr "{HouseBLord.Name} é seu susserano, e você não pode atacar ou declarar guerra contra eles enquanto forem seu susserano. Você ainda pode tentar [hyperlink,GLOBAL.TradeConcept]Negociar[/hyperlink] sua liberdade com {HouseBLord.FirstName}."

msgid "INTERFACE@MODAL_HOSTILE_ACTION@DESCRIPTION_VASSALAGEOVERLORD"
msgstr "{HouseBLord.Name} é seu vassalo, e você não pode atacar ou declarar guerra contra eles enquanto forem seu vassalo. Você ainda pode conceder-lhes liberdade através de <<m:{GLOBAL.TradeConcept.Hyperlink}>>."

msgid "INTERFACE@MODAL_HOSTILE_ACTION@DESCRIPTION_WARCOOLDOWN"
msgstr "Seu estado diplomático com {Target.Name} mudou recentemente e {GLOBAL.WarConcept.Hyperlink} não pode ser declarado por {Duration} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "INTERFACE@MODAL_HOSTILE_ACTION@HEADER_VASSALAGE"
msgstr "Encontrando seu Suserano, {HouseBLord.FirstName}"

msgid "INTERFACE@MODAL_HOSTILE_ACTION@HEADER_VASSALAGEOVERLORD"
msgstr "Encontrando seu Vassalo, {HouseBLord.FirstName}"

msgid "INTERFACE@MODAL_HOSTILE_ACTION@HEADER_WARCOOLDOWN"
msgstr "Não pode declarar guerra contra {Target.Name} ainda"

msgid "INTERFACE@MODAL_HOSTILE_ACTION@SPECOPS"
msgstr "Você está prestes a lançar um feitiço em um Governante ou cidade com a qual não está em guerra. Você deve declarar guerra antes de poder mirá-los com este feitiço."

msgid "INTERFACE@MODAL_HOSTILE_ACTION@SPECOPS_FIXED"
msgstr "Você só pode lançar este feitiço em Governantes com os quais está em guerra. Você atualmente compartilha um estado diplomático fixo com o outro Governante e não pode romper esse relacionamento."

