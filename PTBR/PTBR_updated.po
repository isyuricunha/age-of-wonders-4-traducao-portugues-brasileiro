msgid "TOME_PARADISE@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Crie um paraíso verde exuberante para seu povo. Concentre-se na economia, cura e bônus."

msgid "TOME_PARADISE@TOME@LORE_AUTHOR"
msgstr "Pé-de-Bétula, Eremita da Clareira"

msgid "TOME_PARADISE@TOME@LORE_DESCRIPTION"
msgstr "\"Dê-me um cobertor de floresta para espalhar pelo mundo. Desdobre seu abraço esmeralda sobre todas as regiões, lance uma sombra exuberante e folhuda sobre cada terra. Isto! Isto será meu paraíso. Quando a música do canto dos pássaros e o rugido das bestas acompanharem a brisa que flutua pelas florestas eternas, então estarei satisfeito!\""

msgid "TOME_PARADISE@TOME@NAME"
msgstr "Tomo do Paraíso"

