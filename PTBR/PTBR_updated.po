msgid "DIPLOMACY@DISCUSSION_DECLARATIONOFFRIENDSHIP@DESCRIPTION"
msgstr "Declare publicamente sua Amizade com outro {GLOBAL.LeaderConcept.Hyperlink}.[br/][br/]Um modificador que aumenta lentamente em direção a {RelationValue}[goodRelation/] será adicionado às suas [hyperlink,GLOBAL.EmpireRelationConcept]relações[/hyperlink] com o Governante. Qualquer <<m:{GLOBAL.CasusBelliConcept.Hyperlink}>> obtido contra esse Governante será reduzido em {Reduction}%. Quando dois Governantes declaram Amizade um com o outro, cada tratado diplomático ativo que possuem aumenta o bônus máximo de relações em {RelationBonus}[goodRelation/], até um total de {MaxRelationBonus}[goodRelation/].[br/][br/]Manter uma declaração custa {cost} de manutenção por {GLOBAL.TurnConcept.Hyperlink}, que aumenta em {costScale} para cada declaração adicional.[br/][br/]Declarações podem ser feitas e encerradas por meio de <<m:{GLOBAL.PronouncementsConcept.Hyperlink}>>."

msgid "DIPLOMACY@DISCUSSION_DECLARATIONOFFRIENDSHIP@EVENT_OTHER"
msgstr "Outros Governantes declararam uma amizade"

msgid "DIPLOMACY@DISCUSSION_DECLARATIONOFFRIENDSHIP@EVENT_RECEIVER"
msgstr "Uma Amizade com você foi declarada"

msgid "DIPLOMACY@DISCUSSION_DECLARATIONOFFRIENDSHIP@EVENT_SELF"
msgstr "Você declarou uma Amizade"

msgid "DIPLOMACY@DISCUSSION_DECLARATIONOFFRIENDSHIP@HYPERLINK"
msgstr "[hyperlink,GLOBAL.DeclFriendshipConcept]Declaração de Amizade[/hyperlink]"

msgid "DIPLOMACY@DISCUSSION_DECLARATIONOFFRIENDSHIP@INFOPANEL"
msgstr "{PlayerB.Name} declarou uma [hyperlink,GLOBAL.DeclFriendshipConcept]Amizade[/hyperlink] com {Target.Name}. Com o tempo, suas relações podem melhorar e se transformar em uma {GLOBAL.DSAllianceConcept.Hyperlink}. Declarar uma [hyperlink,GLOBAL.DeclFriendshipConcept]Amizade[/hyperlink] com {Target.Name} pode fortalecer suas relações com {PlayerB.Name}, enquanto uma [hyperlink,GLOBAL.DeclRivalryConcept]Rivalidade[/hyperlink] pode voltar {PlayerB.Name} contra você."

msgid "DIPLOMACY@DISCUSSION_DECLARATIONOFFRIENDSHIP@INFOPANEL_SELF"
msgstr "{PlayerB.Name} declarou uma [hyperlink,GLOBAL.DeclFriendshipConcept]Amizade[/hyperlink] com você. Com o tempo, suas relações podem melhorar e se transformar em uma {GLOBAL.DSAllianceConcept.Hyperlink}."

msgid "DIPLOMACY@DISCUSSION_DECLARATIONOFFRIENDSHIP@NAME"
msgstr "Declaração de Amizade"

msgid "DIPLOMACY@DISCUSSION_DECLARATIONOFRIVALRY@DESCRIPTION"
msgstr "Declare publicamente uma Rivalidade com outro {GLOBAL.LeaderConcept.Hyperlink}.[br/][br/]Um modificador que diminui lentamente em direção a {RelationValue}[badRelation/] será adicionado às suas [hyperlink,GLOBAL.EmpireRelationConcept]relações[/hyperlink] com o Governante. Qualquer <<m:{GLOBAL.CasusBelliConcept.Hyperlink}>> obtido contra esse Governante será aumentado em {Increase}%. No entanto, fazer tratados se torna impossível e quaisquer tratados existentes serão rompidos.[br/][br/]Além disso, um modificador crescente de {GLOBAL.RivalJustificationConcept.Hyperlink} será obtido, que aumenta em {casusbellibonusperturn}[casusBelli/] por {GLOBAL.TurnConcept.Hyperlink} até {casusbellibonusmax}[casusBelli/].[br/][br/]Manter uma declaração custa {cost} de manutenção por {GLOBAL.TurnConcept.Hyperlink}, que aumenta em {costScale} para cada declaração adicional.[br/][br/]Declarações podem ser feitas e encerradas por meio de <<m:{GLOBAL.PronouncementsConcept.Hyperlink}>>."

msgid "DIPLOMACY@DISCUSSION_DECLARATIONOFRIVALRY@EVENT_OTHER"
msgstr "Outros Governantes declararam uma rivalidade"

msgid "DIPLOMACY@DISCUSSION_DECLARATIONOFRIVALRY@EVENT_RECEIVER"
msgstr "Uma Rivalidade foi declarada contra você"

msgid "DIPLOMACY@DISCUSSION_DECLARATIONOFRIVALRY@EVENT_SELF"
msgstr "Você declarou uma Rivalidade"

msgid "DIPLOMACY@DISCUSSION_DECLARATIONOFRIVALRY@HYPERLINK"
msgstr "[hyperlink,GLOBAL.DeclRivalryConcept]Declaração de Rivalidade[/hyperlink]"

msgid "DIPLOMACY@DISCUSSION_DECLARATIONOFRIVALRY@INFOPANEL"
msgstr "{HouseALord.Name} declarou uma [hyperlink,GLOBAL.DeclRivalryConcept]Rivalidade[/hyperlink] com {HouseBLord.Name}. Com o tempo, suas relações podem se deteriorar e levar à {GLOBAL.WarConcept.Hyperlink}. Declarar uma [hyperlink,GLOBAL.DeclRivalryConcept]Rivalidade[/hyperlink] com {HouseBLord.FirstName} pode fortalecer suas relações com {HouseALord.FirstName}, enquanto uma [hyperlink,GLOBAL.DeclFriendshipConcept]Amizade[/hyperlink] pode voltar {HouseALord.FirstName} contra você."

msgid "DIPLOMACY@DISCUSSION_DECLARATIONOFRIVALRY@INFOPANEL_SELF"
