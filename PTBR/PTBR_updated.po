msgstr "Para usar a entrada de mouse e teclado, tanto o mouse quanto o teclado precisam estar conectados ao iniciar o jogo."

msgid "INTERFACE@MOVEMENT@GAINS"
msgstr "ganha {INT_movePoints}[moveWalk/]."

msgid "INTERFACE@MOVEMENT@LOSES"
msgstr "perde {INT_movePoints}[moveWalk/]."

msgid "INTERFACE@MOVEMENT_POPUPS@MOVEMENT_ABILITIES"
