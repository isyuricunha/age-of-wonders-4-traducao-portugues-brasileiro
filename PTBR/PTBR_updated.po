msgid "DLC@GIANTKINGS@RELIC@LITHORITE_GLOBE@KNOWLEDGE_CONVERSION@NAME"
msgstr "Estudos Eternos"

msgid "DLC@GIANTKINGS@RELIC@LITHORITE_GLOBE@LORE"
msgstr "“Para escapar da ordem virtuosa, devemos quadrar o círculo[br/]Para fugir do fogo do dragão, realizar um verdadeiro milagre[br/]Transcendendo nossas almas em gaiolas cristalinas[br/]Reis Gigantes não mais, tornam-se Sábios Eternos”"

msgid "DLC@GIANTKINGS@RELIC@LITHORITE_GLOBE@NAME"
msgstr "Astrolábio de Litiorita^n"

msgid "DLC@GIANTKINGS@RELIC@LITHORITE_PRISM@DESCRIPTION"
msgstr "[bulletlist][bullet/]Suas <<m:{GLOBAL.CityConcept.Hyperlink}>> ganham:[bulletlist][bullet/]{IntStabilityBuff} {GLOBAL.CityStabilityConcept.Hyperlink} se você tiver um {GLOBAL.OrderConcept.Hyperlink} {GLOBAL.TomeConcept.Hyperlink} em sua biblioteca.[bullet/]{IntFoodBuff} {GLOBAL.FoodConcept.Hyperlink} se você tiver um {GLOBAL.NatureConcept.Hyperlink} {GLOBAL.TomeConcept.Hyperlink} em sua biblioteca.[bullet/]{IntGoldBuff} {GLOBAL.GoldConcept.Hyperlink} se você tiver um {GLOBAL.MateriumConcept.Hyperlink} {GLOBAL.TomeConcept.Hyperlink} em sua biblioteca.[bullet/]{IntDraftBuff} {GLOBAL.UnitProductionConcept.Hyperlink} se você tiver um {GLOBAL.ChaosConcept.Hyperlink} {GLOBAL.TomeConcept.Hyperlink} em sua biblioteca.[bullet/]{IntKnowledgeBuff} {GLOBAL.KnowledgeConcept.Hyperlink} se você tiver um {GLOBAL.ShadowConcept.Hyperlink} {GLOBAL.TomeConcept.Hyperlink} em sua biblioteca.[bullet/]{IntManaBuff} {GLOBAL.ManaConcept.Hyperlink} se você tiver um {GLOBAL.AstralConcept.Hyperlink} {GLOBAL.TomeConcept.Hyperlink} em sua biblioteca.[bullet/]Para afinidades duplas <<m:{GLOBAL.TomeConcept.Hyperlink}>> esses bônus são reduzidos pela metade.[/bulletlist][/bulletlist]"

msgid "DLC@GIANTKINGS@RELIC@LITHORITE_PRISM@LORE"
msgstr "“Das profundezas da história, provas cronificadas[br/]Em bibliotecas coletamos conhecimento sem limites[br/]Os segredos cósmicos ocultos abaixo da terra”"

msgid "DLC@GIANTKINGS@RELIC@LITHORITE_PRISM@NAME"
msgstr "Prisma de Litiorita^n"

msgid "DLC@GIANTKINGS@RELIC@LITHORITE_SCROLL@DESCRIPTION"
msgstr "[bulletlist][bullet/]{IntAffinityIncrease} {GLOBAL.OrderConcept.Hyperlink}[bullet/]{IntAffinityIncrease} {GLOBAL.NatureConcept.Hyperlink}[bullet/]{IntAffinityIncrease} {GLOBAL.MateriumConcept.Hyperlink}[bullet/]{IntAffinityIncrease} {GLOBAL.ChaosConcept.Hyperlink}[bullet/]{IntAffinityIncrease} {GLOBAL.ShadowConcept.Hyperlink}[bullet/]{IntAffinityIncrease} {GLOBAL.AstralConcept.Hyperlink}[/bulletlist]"

msgid "DLC@GIANTKINGS@RELIC@LITHORITE_SCROLL@LORE"
msgstr "“Há música nestes cristais, escute[br/]Deixe os sinos dos dias esquecidos brilhar[br/]Discernir as notas é ler a verdade”"

