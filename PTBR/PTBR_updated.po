msgid "TOME_NECROMANCY@UNIT_1@ABILITY_2@NAME"
msgstr "Desmontar"

msgid "TOME_NECROMANCY@UNIT_1@ABILITY_3@DESCRIPTION"
msgstr "A primeira vez que o total de <<m:{GLOBAL.HitPointConcept.Hyperlink}>> desta unidade atinge {CORPSE_CAGE_THRESHOLD_EVENT>ResolvedTriggerProportion}% ou menos, ela invoca um {GLOBAL.UNITS.DECAYING_ZOMBIE.Hyperlink}.[br/]Não funciona em batalhas aquáticas."

msgid "TOME_NECROMANCY@UNIT_1@ABILITY_3@NAME"
msgstr "Gaiola de Cadáver"

msgid "TOME_NECROMANCY@UNIT_1@DESCRIPTION"
msgstr "Esta amálgama de cadáveres reanimados tem o único propósito de matar seus inimigos, sem considerar sua própria sobrevivência."

msgid "TOME_NECROMANCY@UNIT_1@NAME"
msgstr "Horror Ósseo^n"

msgid "TOME_NECROMANCY@UNIT_2@ABILITY_1@DESCRIPTION"
msgstr "Alvo:[bulletlist][bullet/]Cadáver {GLOBAL.PROPERTIES.UNDEAD.Hyperlink} amigável é revivido com {RAISE_UNDEAD_RESURRECT>ResolvedHitPoints}% de seus pontos de vida totais <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[bullet/]Cadáver não-{GLOBAL.PROPERTIES.UNDEAD.Hyperlink} é levantado como um {GLOBAL.UNITS.ZOMBIE.Hyperlink}.[/bulletlist]"

