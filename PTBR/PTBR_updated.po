msgid "TOME_PARADISE@PASSIVE@NAME"
msgstr "Paraíso Perfeito"

msgid "TOME_PARADISE@SKILL1@DESCRIPTION"
msgstr "Todas as unidades amigáveis na {GLOBAL.ProvinceConcept} alvo ganham +{maxhp} de <<m:{GLOBAL.HitPointConcept.Hyperlink}>> máximo e [hyperlink,GLOBAL.WorldMapRegeneration]regeneram[/hyperlink] {regen} <<m:{GLOBAL.HitPointConcept.Hyperlink}>> em domínio neutro e amigável pelos próximos {amount} {GLOBAL.WorldMapConcept.Hyperlink} <<m:{GLOBAL.TurnConcept}>>."

