msgid "CONCEPT@HERO_CLASS@WARLOCK@HYPERLINK"
msgstr "[hyperlink,GLOBAL.HeroClassWarlock]Classe de Herói: Bruxo[/hyperlink]"

msgid "CONCEPT@HERO_CLASS@WARRIOR@DESCRIPTION"
msgstr "{LOC.CONCEPT@HERO_CLASS@WARRIOR@DESCRIPTION_SHORT}[br/][br/]Armas compatíveis:[bulletlist][bullet/]{GLOBAL.GreatWeaponConcept.Hyperlink}[bullet/]{GLOBAL.OneHandedWeaponConcept.Hyperlink}[bullet/]{GLOBAL.ShieldConcept.Hyperlink}[bullet/]{GLOBAL.FistWeaponConcept.Hyperlink}[bullet/]{GLOBAL.PolearmWeaponConcept.Hyperlink}[bullet/]{GLOBAL.SkirmishingWeaponConcept.Hyperlink}[/bulletlist]"

msgid "CONCEPT@HERO_CLASS@WARRIOR@DESCRIPTION_SHORT"
msgstr "Uma Classe de Herói especializada em ataques de carga, causando dano e ganhando força através do combate."

msgid "CONCEPT@HERO_CLASS@WARRIOR@GAMEPLAY_HYPERLINK"
msgstr "[classWarrior/] [hyperlink,GLOBAL.HeroClassWarrior]Guerreiro[/hyperlink]"

msgid "CONCEPT@HERO_CLASS@WARRIOR@HYPERLINK"
msgstr "[hyperlink,GLOBAL.HeroClassWarrior]Classe de Herói: Guerreiro[/hyperlink]"

msgid "CONCEPT@HERO_SKILL_ADEPT@DESCRIPTION"
