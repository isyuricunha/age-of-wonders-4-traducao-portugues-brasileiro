msgid "DLC@RISEFROMRUIN@FRACTURE@EVENTUNIT@TITLE"
msgstr "Fraturar^n"

msgid "DLC@RISEFROMRUIN@FRACTURED@TRANSFORMATION@BONUS_PROP_DESCRIPTION"
msgstr "Esta unidade tem suas magia e transformações desativadas. Para cada uma desativada, ela tem:[bulletlist][bullet/]{FRACTURED_TRANSFORMATION_UPGRADE_HP>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]+{FRACTURED_TRANSFORMATION_UPGRADE_DAMAGE>ResolvedMultiplier}% de dano[/bulletlist]"

msgid "DLC@RISEFROMRUIN@FRACTURED@TRANSFORMATION@DESCRIPTION"
msgstr "A raça alvo torna-se fraturada:[bulletlist][bullet/]Ataques têm uma chance base de {DISRUPTION_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.DISRUPTION_TOOLTIP_PROPERTY.Hyperlink}. Este efeito é aumentado para ataques de tiro único.[bullet/]Ganha {GLOBAL.PROPERTIES.MANA_STARVED.Hyperlink}.[bullet/]Tem todas as suas outras magia e transformações desativadas. Para cada uma desativada, ganha:[bulletlist][bullet/]{FRACTURED_TRANSFORMATION_UPGRADE_HP>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]+{FRACTURED_TRANSFORMATION_UPGRADE_DAMAGE>ResolvedMultiplier}% de dano[/bulletlist][/bulletlist]"

msgid "DLC@RISEFROMRUIN@FRACTURED@TRANSFORMATION@NAME"
msgstr "Transformação Fraturada"

msgid "DLC@RISEFROMRUIN@FRACTURED@TRANSFORMATION@PROP_DESCRIPTION"
msgstr "Esta unidade:[bulletlist][bullet/]Ataques têm uma chance base de {DISRUPTION_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.DISRUPTION_TOOLTIP_PROPERTY.Hyperlink}. Este efeito é aumentado para ataques de tiro único.[bullet/]Tem {GLOBAL.PROPERTIES.MANA_STARVED.Hyperlink}.[bullet/]Tem todas as suas outras magia e transformações desativadas. Para cada uma desativada, ganha:[bulletlist][bullet/]{FRACTURED_TRANSFORMATION_UPGRADE_DAMAGE>ResolvedMultiplier} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]+{FRACTURED_TRANSFORMATION_UPGRADE_DAMAGE>ResolvedMultiplier}% de dano[/bulletlist][/bulletlist]"

