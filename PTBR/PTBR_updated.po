msgid "INTERFACE@STRATEGIC_MAP@DOMAIN"
msgstr "Domínio"

msgid "INTERFACE@STRATEGIC_MAP@DOMAIN_DESCRIPTION"
msgstr "A coleção de <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> pertencentes à cidade. O Governante terá uma {GLOBAL.ClaimConcept.Hyperlink} sobre províncias adjacentes ao domínio da cidade. Unidades amigáveis precisam gastar {amount1} menos <<m:{GLOBAL.MovePointConcept.Hyperlink}>> para atravessar o terreno em domínios amigáveis."

msgid "INTERFACE@STRATEGIC_MAP@DOMAIN_HYPERLINK"
msgstr "[hyperlink,GLOBAL.DomainConcept]Domínio[/hyperlink]"

msgid "INTERFACE@STRATEGIC_MAP@FARM_DESCRIPTION"
