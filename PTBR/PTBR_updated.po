msgid "TOME_HERALDS_DOOM@TOME@LORE_AUTHOR"
msgstr "Arachna Aranea, Rainha Aranha"

msgid "TOME_HERALDS_DOOM@TOME@LORE_DESCRIPTION"
msgstr "\"A escuridão que se arrasta de sombra em sombra não só traz inquietação, mas também carrega a promessa de sua chegada. Diminua a luz dos espíritos de seus inimigos. Envolva-os em desespero, para que suas armas caiam no chão e feitiços não saiam de seus lábios.\""

msgid "TOME_HERALDS_DOOM@TOME@NAME"
msgstr "Tomo do Arauto da Perdição"

msgid "TOME_HERALD_DOOM@ABILITY_1@DESCRIPTION"
msgstr "Unidades inimigas dentro de um raio de {WAIL_OF_THE_BANSHEE_UNIT_CIRCLE_TARGETER>AREA>Radius} hexágonos sofrem dano e têm uma chance base de {chance}% de:[bulletlist][bullet/]Ter sua {GLOBAL.UnitMoraleConcept.Hyperlink} reduzida em {morale}.[bullet/]Ficar {weakness} {GLOBAL.PROPERTIES.WEAKENED.Hyperlink}.[/bulletlist]"

msgid "TOME_HERALD_DOOM@ABILITY_1@ENHANCED_DESCRIPTION"
msgstr "Lamento da Banshee:[bulletlist][bullet/]Causa um adicional de {WAIL_OF_THE_BANSHEE_ENHANCE_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Tem uma chance base de {WAIL_OF_THE_BANSHEE_RESISTANCE_CHECK_ENHANCED>ResolvedStrength}% de infligir seus efeitos.[/bulletlist]"

msgid "TOME_HERALD_DOOM@ABILITY_1@ENHANCED_NAME"
msgstr "Lamento da Banshee Aprimorado"

msgid "TOME_HERALD_DOOM@ABILITY_1@MASTER_DESCRIPTION"
msgstr "Lamento da Banshee:[bulletlist][bullet/]Tem uma chance base de {WAIL_OF_THE_BANSHEE_RESISTANCE_CHECK_MASTER>ResolvedStrength}% de infligir seus efeitos.[bullet/]Causa um adicional de {WAIL_OF_THE_BANSHEE_MASTER_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_HERALD_DOOM@ABILITY_1@MASTER_NAME"
msgstr "Lamento da Banshee Campeã"

msgid "TOME_HERALD_DOOM@ABILITY_1@NAME"
msgstr "Lamento da Banshee"

msgid "TOME_HERALD_DOOM@MAGIC_BOLTS@CRUEL"
msgstr "Projéteis Cruéis"

msgid "TOME_HERALD_DOOM@UNIT@NAME"
msgstr "Banshee^n"

msgid "TOME_HORDE@ABILITY_1@DESCRIPTION"
msgstr "No início da batalha, invoque um {GLOBAL.UNITS.WAR_HOUND_UNIT.Hyperlink} {GLOBAL.PROPERTIES.SHOCK_UNIT.Hyperlink} que inflige {GLOBAL.PROPERTIES.MARKED.Hyperlink} e {GLOBAL.PROPERTIES.BLEEDING.Hyperlink} com seu ataque.[br/][br/]Não funciona em combate aquático e não pode se beneficiar de Encantamentos de Unidade."

msgid "TOME_HORDE@ABILITY_1@NAME"
msgstr "Liberte os Cães"

msgid "TOME_HORDE@ABILITY_2@DESCRIPTION"
msgstr "Unidade amigável {GLOBAL.PROPERTIES.ANIMAL.Hyperlink} alvo ganha {amount} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}."

msgid "TOME_HORDE@ABILITY_2@DESCRIPTION_PROP"
msgstr "Ganha +{WEAK_POINT_SHOT>ResolvedMultiplier}% de dano contra unidades {GLOBAL.PROPERTIES.MARKED.Hyperlink}."

msgid "TOME_HORDE@ABILITY_2@NAME"
msgstr "Tiro no Ponto Fraco"

msgid "TOME_HORDE@ABILITY_2@NAME_PROP"
msgstr "Ponto Fraco"

msgid "TOME_HORDE@HERO_SKILL@DESCRIPTION"
msgstr "Enquanto esta unidade for o líder do exército, todas as unidades de Nível I no exército ganham:[bulletlist][bullet/]+{BATTLE_SEEKER_STATUS_STATS>BONUS>DEFENSE>Armor}{GLOBAL.DefenseConcept.Hyperlink}[bullet/]+{BATTLE_SEEKER_STATUS_STATS>BONUS>DEFENSE>Resistance}{GLOBAL.ResistanceConcept.Hyperlink}[bullet/]+{BATTLE_SEEKER_STATUS_STATS>BONUS>HitPoints}{GLOBAL.HitPointConcept.Hyperlink}[bullet/]+{BATTLE_SEEKER_STATUS_RESIST>Resistance}{GLOBAL.StatusResistanceConcept.Hyperlink}[/bulletlist]"

msgid "TOME_HORDE@HERO_SKILL@NAME"
msgstr "Treino do Buscador de Batalhas"

msgid "TOME_HORDE@PASSIVE@DESCRIPTION"
msgstr "Quando você vence em batalha, tem uma chance de {chance}% de ganhar uma unidade de Nível {tier}."

msgid "TOME_HORDE@PASSIVE@NAME"
msgstr "Chamado da Horda"

msgid "TOME_HORDE@SKILL1@DESCRIPTION"
msgstr "Uma {GLOBAL.PROPERTIES.RANGED_UNIT.Hyperlink} que invoca um {GLOBAL.UNITS.WAR_HOUND_UNIT.Hyperlink} para debilitar inimigos."

msgid "TOME_HORDE@SKILL1@NAME"
msgstr "Mestre de Cães^n"

msgid "TOME_HORDE@SKILL2@DESCRIPTION"
msgstr "Unidades amigáveis de Nível I e Nível II em um raio de {FURY_OF_THE_HORDE_UNIT_TARGETER_ALL>AREA>Radius} hexágonos ganham:[bulletlist][bullet/]{amount} pilhas de {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}.[/bulletlist]"

msgid "TOME_HORDE@SKILL2@NAME"
msgstr "Fúria da Horda"

msgid "TOME_HORDE@SKILL3@DESCRIPTION"
msgstr "Torna a raça alvo menor e mais numerosa, concedendo a eles:[bulletlist][bullet/]Número aumentado de unidades na formação.[bullet/]+{SPAWNKIN_DAMAGE_MULTIPLIER>ResolvedMultiplier}% de dano para unidades não-herói.[bullet/]+{SPAWNKIN_HERO_EVASION>ResolvedAccuracyModifier}% de {GLOBAL.EvasionConcept.Hyperlink} para unidades herói.[bullet/]Incompatível com {GLOBAL.PROPERTIES.SUPERGROWTH_PROPERTY_GROUP.Hyperlink}.[/bulletlist]"

msgid "TOME_HORDE@SKILL3@NAME"
msgstr "Pequeno"

msgid "TOME_HORDE@SKILL3@PROPERTY_DESCRIPTION"
msgstr "A unidade tem:[bulletlist][bullet/]Um número aumentado de unidades na formação.[bullet/]+{SPAWNKIN_DAMAGE_MULTIPLIER>ResolvedMultiplier}% de dano.[/bulletlist]"

msgid "TOME_HORDE@SKILL3@PROPERTY_DESCRIPTION_HERO"
msgstr "A unidade tem:[bulletlist][bullet/]+{SPAWNKIN_HERO_EVASION>ResolvedAccuracyModifier}% de {GLOBAL.EvasionConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_HORDE@SKILL4@DESCRIPTION"
msgstr "Invoca uma unidade de Nível I não-Batedor aleatória que pode ser produzida em uma cidade no hexágono alvo."

msgid "TOME_HORDE@SKILL4@NAME"
msgstr "Invocar Irregulares"

msgid "TOME_HORDE@SKILL5@DESCRIPTION"
msgstr "A unidade inimiga alvo sofre:[bulletlist][bullet/]{BLAZE_OF_THE_HORDE_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]+{BLAZE_OF_THE_HORDE_COUNT_ADJACENT>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} para cada unidade amigável adjacente[/bulletlist]"

msgid "TOME_HORDE@SKILL5@NAME"
msgstr "Chama da Horda"

msgid "TOME_HORDE@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Transforme suas unidades mais baratas em grandes exércitos mortais. Especialize-se em invocar e fortalecer unidades de baixo nível."

msgid "TOME_HORDE@TOME@LORE_AUTHOR"
msgstr "Chamador de Enxame Trass, Chefe de Guerra Ratkin"

msgid "TOME_HORDE@TOME@LORE_DESCRIPTION"
msgstr "\"Os Mestres da Horda entendem o poder dos grandes números, de massas agitadas em um frenesi. No final, nossos cães de guerra vão dilacerar os cavaleiros mais fortes e os bruxos mais astutos. O maior erro de nossos inimigos é subestimar quantos escravos comandamos e o quanto pouco nos importamos com suas vidas.\""

msgid "TOME_HORDE@TOME@NAME"
msgstr "Tomo da Horda"

msgid "TOME_HORDE@UNIT2@NAME"
msgstr "Cão de Guerra^n"

msgid "TOME_HORDE@UNIT@NAME"
msgstr "Mestre de Cães^m"

msgid "TOME_INQUISITION@PASSIVE@DESCRIPTION"
msgstr "Ganha {amount} {GLOBAL.ImperiumConcept} por {GLOBAL.HeroConcept} na prisão do seu império."

msgid "TOME_INQUISITION@PASSIVE@NAME"
msgstr "Inquisidores Interrogadores"

msgid "TOME_INQUISITION@SKILL1@DESCRIPTION"
msgstr "Concede acesso a um {GLOBAL.PROPERTIES.SKIRMISHER.Hyperlink} agressivo que pode infligir {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink} e {GLOBAL.PROPERTIES.STUNNED.Hyperlink}."

msgid "TOME_INQUISITION@SKILL1@NAME"
msgstr "Inquisidor"

msgid "TOME_INQUISITION@SKILL2@DESCRIPTION"
msgstr "Inimigos em um raio de hexágonos de {MASS_CONDEMN_UNIT_TARGETER_CIRCLE>AREA>Radius}:\n"
"[bulletlist]\n"
"[bullet/]Sofrem {MASS_CONDEMN_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink}.\n"
"[bullet/]Ficam {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink} até o final da batalha.\n"
"[/bulletlist]"

msgid "TOME_INQUISITION@SKILL2@NAME"
msgstr "Condenação em Massa"

msgid "TOME_INQUISITION@SKILL3@DESCRIPTION"
msgstr "[bulletlist]\n"
"[bullet/]{stability} {GLOBAL.CityStabilityConcept.Hyperlink}\n"
"[bullet/]{research} {GLOBAL.KnowledgeConcept.Hyperlink} por {GLOBAL.PopulationConcept.Hyperlink}\n"
"[/bulletlist]"

msgid "TOME_INQUISITION@SKILL3@NAME"
msgstr "Tribunal"

msgid "TOME_INQUISITION@SKILL4@DESCRIPTION"
msgstr "Torna os ataques de unidades encantadas com:\n"
"[bulletlist]\n"
"[bullet/]Chance base de {CONDEMN_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink} até o final do combate, reduzindo a {GLOBAL.StatusResistanceConcept.Hyperlink} do inimigo.\n"
"[bullet/]Chance base de {WEAKENED_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.WEAKENED.Hyperlink}, reduzindo o dano do inimigo.\n"
"[/bulletlist]\n"
"[br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_INQUISITION@SKILL4@NAME"
msgstr "Marca do Inquisidor"

msgid "TOME_INQUISITION@SKILL4@PROPERTY_DESCRIPTION"
msgstr "Os ataques da unidade têm:\n"
"[bulletlist]\n"
"[bullet/]Chance base de {CONDEMN_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink} até o final da batalha.\n"
"[bullet/]Chance base de {WEAKENED_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.WEAKENED.Hyperlink}.\n"
"[/bulletlist]\n"
"[br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_INQUISITION@SKILL5@DESCRIPTION"
msgstr "Exército inimigo alvo:\n"
"[bulletlist]\n"
"[bullet/]Sofre {damage} {GLOBAL.SpiritDamageConcept.Hyperlink}.\n"
"[bullet/]Perde {amount}% de seus <<m:{GLOBAL.MovePointConcept}>> no {GLOBAL.WorldMapConcept.Hyperlink}.\n"
"[/bulletlist]"

msgid "TOME_INQUISITION@SKILL5@NAME"
msgstr "Fardo da Culpa"

msgid "TOME_INQUISITION@SKILL6@DESCRIPTION"
msgstr "Invoca um {GLOBAL.UNITS.LIGHTBRINGER_UNIT.Hyperlink} {GLOBAL.PROPERTIES.BATTLE_MAGE.Hyperlink} que pode converter outras unidades para sua causa."

msgid "TOME_INQUISITION@SKILL6@NAME"
msgstr "Invocar Portador da Luz"

msgid "TOME_INQUISITION@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Caçar aqueles que não concordam com sua autoridade. Infligir {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink} em inimigos e restringir seu Movimento."

msgid "TOME_INQUISITION@TOME@LORE_AUTHOR"
msgstr "Shira Snowblood, Godir do Pacto"

msgid "TOME_INQUISITION@TOME@LORE_DESCRIPTION"
msgstr "\"Os ímpios sentirão a ira de nossa virtude inerrante. Nós os abateremos com raiva devota e vingança furiosa! Seus membros serão pesados com o peso de sua maldade, enquanto nossos próprios súditos serão impulsionados pela nobreza de espírito!\""

msgid "TOME_INQUISITION@TOME@NAME"
msgstr "Tomo da Inquisição"

msgid "TOME_INQUISITION@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Atira besta no alvo da unidade inimiga."

msgid "TOME_INQUISITION@UNIT1@ABILITY1@NAME"
msgstr "Dardo do Julgamento"

msgid "TOME_LICH@SKILL3@NAME"
