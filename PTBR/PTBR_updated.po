msgid "COMBATPROPERTIES_TACTICAL@ORDER_OF_GLUTTON@NAME"
msgstr "Poder Glutão"

msgid "COMBATPROPERTIES_TACTICAL@ORDER_OF_GLUTTON_ABILITY@DESCRIPTION"
msgstr "Consome comida para ganhar 1 pilha de {GLOBAL.PROPERTIES.COMBATPROPERTY_DEVOURED_POWER.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@ORDER_OF_GLUTTON_ABILITY@NAME"
msgstr "Devorar Comida"

msgid "COMBATPROPERTIES_TACTICAL@ORDER_OF_GLUTTON_CONDEMN@DESCRIPTION"
msgstr "Todas as unidades defensoras sofrem {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink} até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@ORDER_OF_GLUTTON_CONDEMN@NAME"
msgstr "Defensores Condenados"

msgid "COMBATPROPERTIES_TACTICAL@ORDER_OF_GLUTTON_DEVOURED_POWER@DESCRIPTION"
msgstr "[bulletlist][bullet/]<<m:{GLOBAL.HitPointConcept.Hyperlink}>> máximo aumentado em {value}. [bullet/]Ganha 1 pilha de {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}.[/bulletlist]"

msgid "COMBATPROPERTIES_TACTICAL@ORDER_OF_GLUTTON_DEVOURED_POWER@NAME"
msgstr "Poder Devorado"

msgid "COMBATPROPERTIES_TACTICAL@ORDER_OF_GLUTTON_HASTENED@DESCRIPTION"
msgstr "No início da batalha, todas as unidades atacantes têm {GLOBAL.PROPERTIES.HASTENED.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@ORDER_OF_GLUTTON_HASTENED@NAME"
msgstr "Atacantes Acelerados"

msgid "COMBATPROPERTIES_TACTICAL@ORDER_OF_GLUTTON_NO_GORGING@DESCRIPTION"
msgstr "O Karagh não pode usar sua habilidade {GLOBAL.PROPERTIES.TERRIFYING_GORGING.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@ORDER_OF_GLUTTON_NO_GORGING@NAME"
msgstr "Pouco Apetitoso"

msgid "COMBATPROPERTIES_TACTICAL@ORDER_OF_GLUTTON_POISON@DESCRIPTION"
msgstr "Envenene a comida dos Karaghs, fazendo com que o Karagh ganhe 1 pilha de {GLOBAL.PROPERTIES.POISONED.Hyperlink} e {GLOBAL.PROPERTIES.DISEASED.Hyperlink} sempre que comer uma caixa de comida."

msgid "COMBATPROPERTIES_TACTICAL@ORDER_OF_GLUTTON_POISON@NAME"
msgstr "Comida Envenenada"

msgid "COMBATPROPERTIES_TACTICAL@OUT_OF_CONTROL_STORM@DESCRIPTION"
msgstr "Durante os primeiros {numOfTurns} {GLOBAL.TurnConcept.Hyperlink}, a Tempestade de Relâmpago só atingirá as unidades defensoras."

msgid "COMBATPROPERTIES_TACTICAL@OUT_OF_CONTROL_STORM@NAME"
msgstr "Manipulação da Tempestade"

msgid "COMBATPROPERTIES_TACTICAL@POISONED_TREE@DESCRIPTION"
