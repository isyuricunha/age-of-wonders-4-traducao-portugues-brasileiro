msgid "CONCEPT@HERO_CLASS@SPELLBLADE@DESCRIPTION_SHORT"
msgstr "Uma Classe de Herói que usa ataques {GLOBAL.MeleeConcept.Hyperlink} e {GLOBAL.MagicConcept.Hyperlink} para causar dano mágico à distância e dano físico quando o inimigo se aproxima."

msgid "CONCEPT@HERO_CLASS@SPELLBLADE@GAMEPLAY_HYPERLINK"
