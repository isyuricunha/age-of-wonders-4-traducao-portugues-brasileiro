msgstr "Derrote {CountdownPlayer} para tomar os Artefatos."

msgid "DLC@RISEFROMRUIN@FRACTURING_WINDS_CRISIS@VICTORY@TOOLTIP"
msgstr "Você alcançou a {GLOBAL.CataclysmVictoryConcept.Hyperlink}."

msgid "DLC@RISEFROMRUIN@FRACTURING_WINDS_CRISIS@VICTORY_EVENT@DESCRIPTION"
msgstr "{CountdownPlayer} possui <<m:{GLOBAL.ArtifactConcept.Hyperlink}>> suficientes do Hubris dos Desfazedores para usar seu poder e limpar o {GLOBAL.CataclysmConcept.Hyperlink} e fará isso em {TurnCountdown} [turn/] Turnos.[br/][br/]Outros podem impedir isso roubando um ou mais dos Artefatos, o que pode ser feito derrotando {CountdownPlayer.Name}."

