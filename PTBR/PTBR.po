msgid "DIPLOMACY@PLAYEROPINION@GRUDGE_REMAIN"
msgstr "Rancor devido a <<m:{GLOBAL.CasusBelliConcept.Hyperlink}>> expirado"

msgid "DIPLOMACY@PRESSURE@DESCRIPTION"
msgstr "O nível de ameaça representa o quanto outros <<m:{GLOBAL.LeaderConcept.Hyperlink}>> se sentem ameaçados.[br/][br/]Esse nível é influenciado por diversos fatores que avaliam o desempenho de cada Governante: por exemplo, se possuem grandes <<m:{GLOBAL.ArmyConcept.Hyperlink}>>, muitas <<m:{GLOBAL.CityConcept.Hyperlink}>>, ou são apoiados por muitos [hyperlink,GLOBAL.DSAllianceConcept]aliados[/hyperlink].[br/][br/]O nível de ameaça é expresso como um modificador de [hyperlink,GLOBAL.EmpireRelationConcept]relações[/hyperlink]."

msgid "DIPLOMACY@PRESSURE@FACTORS"
msgstr "Descobrimos os seguintes fatores contribuintes."

msgid "DIPLOMACY@PRESSURE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.AIPressureConcept]Nível de Ameaça[/hyperlink]"

msgid "DIPLOMACY@PRESSURE@LEVEL_-1"
msgstr "Inquieto"

msgid "DIPLOMACY@PRESSURE@LEVEL_-1_DESCRIPTION"
msgstr "O {GLOBAL.LeaderConcept.Hyperlink} sente-se ameaçado pelo seu {GLOBAL.EmpireConcept.Hyperlink}, o que afeta suas [hyperlink,GLOBAL.EmpireRelationConcept]relações[/hyperlink] com ele em {RelationValue}[badRelation/] e também torna o comércio com ele mais caro."

msgid "DIPLOMACY@PRESSURE@LEVEL_-2"
msgstr "Vigilante"

msgid "DIPLOMACY@PRESSURE@LEVEL_-3"
msgstr "Cauteloso"

msgid "DIPLOMACY@PRESSURE@LEVEL_-4"
msgstr "Ameaçado"

