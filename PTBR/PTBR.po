msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@ANCIENT_BATTLEFIELD@DESCRIPTION"
msgstr "<<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacentes a este Marco ganham:[bulletlist][bullet/]{income}.[bullet/]Se <<m:{GLOBAL.SoulConcept.Hyperlink}>> forem obtidos, esta província concede {income2}.[bullet/]O {combatproperty} {GLOBAL.CombatEnchantmentConcept.Hyperlink}[/bulletlist][br/]Uma {GLOBAL.CityConcept.Hyperlink} com {amount} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacentes a este Marco ganham:[bulletlist][bullet/]Unidades de Nível 1 <<m:{GLOBAL.UnitConcept.Hyperlink}>> têm seu custo de recrutamento reduzido em {discount} na Cidade.[bullet/]Se <<m:{GLOBAL.SoulConcept.Hyperlink}>> forem obtidos, desbloqueia o recrutamento de unidades Esqueleto de Nível 1.[/bulletlist]"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@ANCIENT_BATTLEFIELD@LORE"
msgstr "\"Você sente? Magia proibida paira neste campo de batalha... Não de criação, mas de não-vida. Meus parentes contam a história de um [hyperlink,GLOBAL.TraitorKingsLoreConcept]Rei Traidor[/hyperlink] que amaldiçoou o solo com magias ancestrais onde caiu... Nenhum dos que lutaram aqui conhecerá paz. E assim, as almas dos caídos permanecem entre seus ossos, lutando para sempre, morrendo para sempre...\"[br/][br/]— Fjalla Construtor-de-Torres, Nos Passos do Gigante: Citado por Ham Binger"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@ANCIENT_BATTLEFIELD@NAME"
msgstr "Campo de Batalha Assombrado"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@CASCADE_FALLS@DESCRIPTION"
msgstr "<<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacentes a este Marco ganham:[bulletlist][bullet/]{income}.[bullet/]Uma Fazenda [farm/] ou um Guardião Florestal [forester/] nesta província concede {income2}.[/bulletlist][br/]Uma {GLOBAL.CityConcept.Hyperlink} com {amount} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacentes a este Marco ganham:[bulletlist][bullet/]Desbloqueia o recrutamento de <<{GLOBAL.UNITS.LESSER_TIDE_SPIRIT.Hyperlink}>> e <<{GLOBAL.UNITS.TIDE_SPIRIT.Hyperlink}>>.[bullet/]Unidades amigas <<m:{GLOBAL.UnitConcept.Hyperlink}>> no domínio [hyperlink,GLOBAL.WorldMapRegeneration]regeneram[/hyperlink] {regen} a cada {GLOBAL.TurnConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@CASCADE_FALLS@LORE"
msgstr "\"Quando a coroa pesava sobre minha mãe, ela buscava refúgio nas quedas d'água. Ela dizia que a cascata afoga todo o caos. Em minha busca por ela, eu também visito este lugar de paz. Entro na correnteza, deixo que o turbilhão me envolva e, em seu ritmo implacável, redescubro clareza e força.\"[br/][br/]— Sundren da Casa Inioch, Memórias da Corte Élfica"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@CASCADE_FALLS@NAME"
msgstr "Cachoeira da Cascata"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@CASCADE_FALLS@NAME_OVERRIDE_01"
msgstr "Quedas Arcádias"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@CASCADE_FALLS@NAME_OVERRIDE_02"
msgstr "Corredeiras do Arco-Íris"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@CASCADE_FALLS@NAME_OVERRIDE_03"
msgstr "Cascata Abençoada"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@CASCADE_FALLS@NAME_OVERRIDE_04"
msgstr "Quedas Espirituais"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@DESTROYTHERING@DESCRIPTION"
msgstr "O Herói Halfling lançará seu anel no vulcão. O Anel será permanentemente destruído e você ganhará {alignment} de Alinhamento."

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@DESTROYTHERING@NAME"
msgstr "Destruir o Anel [reputation6/]"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@DRAGON_REMAINS@DESCRIPTION"
msgstr "<<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacentes a este Marco ganham:[bulletlist][bullet/]{income}[bullet/]O {combatproperty} {GLOBAL.CombatEnchantmentConcept.Hyperlink}[/bulletlist][br/]Uma {GLOBAL.CityConcept.Hyperlink} com {amount} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacentes a este Marco ganham:[bulletlist][bullet/]Desbloqueia o recrutamento de unidades {GLOBAL.PROPERTIES.DRAGON.Hyperlink} de Nível 4 e 5 <<m:{GLOBAL.UnitConcept.Hyperlink}>>.[/bulletlist]"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@DRAGON_REMAINS@LORE"
msgstr "\"Olhando para os restos do que um dia foi um majestoso tesouro, não se pode deixar de pensar no [hyperlink,GLOBAL.DragonsLoreConcept]Dragão[/hyperlink] que caiu aqui e em sua rivalidade destrutiva com o {GLOBAL.GiantsLoreConcept.Hyperlink}. Veja como até os ossos parecem ainda proteger seus tesouros. Enquanto o vento uivava entre os picos, juro que pude ouvir o rugido ancestral do dragão...\"[br/][br/]— Fangir Rochedo-de-Pedra, Diários da Segunda Era: Parte II"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@DRAGON_REMAINS@NAME"
msgstr "Tesouro do Dragão Ancestral"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@DRAGON_REMAINS@NAME_OVERRIDE_01"
msgstr "Cordilheira Presas-de-Dragão"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@DRAGON_REMAINS@NAME_OVERRIDE_02"
msgstr "Espinha Dorsal do Dragão"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@DRAGON_REMAINS@NAME_OVERRIDE_03"
msgstr "Tesouro dos Caídos"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@DRAGON_REMAINS@NAME_OVERRIDE_04"
msgstr "Crepúsculo do Dragão"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@GRAND_STATUARY@DESCRIPTION"
msgstr "<<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacentes a este Marco ganham:[bulletlist][bullet/]{income}.[bullet/] Um Posto de Pesquisa [researchpost/] nesta província concede {income2}.[/bulletlist][br/]Um {GLOBAL.CityConcept.Hyperlink} com {amount} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacentes a este Marco ganham:[bulletlist][bullet/]O {GLOBAL.GovernorConcept.Hyperlink} da Cidade ganha {renown} {GLOBAL.RenownConcept.Hyperlink} a cada {GLOBAL.TurnConcept.Hyperlink}.[bullet/]<<m:{GLOBAL.UnitConcept.Hyperlink}>> recrutados na Cidade ganham {rankbonus} Patente inicial.[/bulletlist]"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@GRAND_STATUARY@LORE"
msgstr "\"Ao caminhar entre estas estátuas desgastadas, pondero sobre as almas que elas imortalizam. Mesmo aqueles cujos nomes foram esquecidos merecem meu respeito. Serei eu também lembrado — ou esquecido — como eles? Minha efígie de pedra receberá oferendas ou será abandonada ao tempo? Se meus traços fossem esculpidos na pedra, se tornariam um farol de esperança — ou de terror?\"[br/][br/]— Alfred Elderstone, Reflexões sobre o Governo"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@GRAND_STATUARY@NAME"
msgstr "Grande Estatuária"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@GRAND_STATUARY@NAME_OVERRIDE_01"
