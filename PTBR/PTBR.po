msgid "PLAYER_INTERACTION@EVENT_HIGHESTCAPABILITY@NEGATIVE"
msgstr "\"Ha, você pode ser a estrela em ascensão agora, mas isso não durará. Mais cedo ou mais tarde, meu império se erguerá acima de tudo!\""

msgid "PLAYER_INTERACTION@EVENT_HIGHESTCAPABILITY@NEUTRAL"
