msgid "DLC@WAYSOFWAR@OATHSWORN@UNIT_MECHANIC01@DESCRIPTION"
msgstr "Quando esta unidade ficar abaixo de {maxHP}% do seu máximo <<m:{GLOBAL.HitPointConcept.Hyperlink}>>, ganha um efeito baseado na {GLOBAL.DevotionConcept.Hyperlink} da cultura:[bulletlist][bullet/][devotion3/] Exemplar: Cura {amountParagon} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>[bullet/][devotion2/] Devoto: Cura {amountDevotee} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>[bullet/][devotion1/] Adepto: Cura {amountAdherent} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>[bullet/][devotion0/] Neutro: Cura {amountNeutral} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>[bullet/][devotion-1/] Quebrador de Juramento: {Weakamount} {GLOBAL.PROPERTIES.WEAKENED.Hyperlink} por {weakduration} <<m:{GLOBAL.TurnConcept}>>[/bulletlist]"

msgid "DLC@WAYSOFWAR@OATHSWORN@UNIT_MECHANIC01@NAME"
msgstr "Harmonizar"

msgid "DLC@WAYSOFWAR@OATHSWORN@UNIT_MECHANIC02@DESCRIPTION"
msgstr "Os ataques não de flanco da unidade causam dano extra baseado na {GLOBAL.DevotionConcept.Hyperlink}:[bulletlist][bullet/][devotion3/] Exemplar: +{paragonamount} {GLOBAL.SpiritDamageConcept.Hyperlink}[bullet/][devotion2/] Devoto: +{devoteeamount} {GLOBAL.SpiritDamageConcept.Hyperlink}[bullet/][devotion1/] Adepto: +{adherentamount} {GLOBAL.SpiritDamageConcept.Hyperlink}[bullet/][devotion0/] Neutro: +{neutralamount} {GLOBAL.SpiritDamageConcept.Hyperlink}[bullet/][devotion-1/] Quebrador de Juramento: -{OathbreakerDamage}% dano[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@WAYSOFWAR@OATHSWORN@UNIT_MECHANIC02@NAME"
msgstr "Nobreza"

msgid "DLC@WAYSOFWAR@OATHSWORN@UNIT_MECHANIC03@BUFF_DESCRIPTION"
msgstr "Os ataques desta unidade causam +{WARRIOR_SOUL_REPEATING_DAMAGE>DAMAGE>Fire}{GLOBAL.FireDamageConcept.Hyperlink}.[br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@WAYSOFWAR@OATHSWORN@UNIT_MECHANIC03@BUFF_NAME"
msgstr "Fúria do Guerreiro"

msgid "DLC@WAYSOFWAR@OATHSWORN@UNIT_MECHANIC03@BUFF_NAME_ADHERENT"
msgstr "Fúria do Guerreiro (Adepto)"

msgid "DLC@WAYSOFWAR@OATHSWORN@UNIT_MECHANIC03@BUFF_NAME_DEVOTEE"
msgstr "Fúria do Guerreiro (Devoto)"

msgid "DLC@WAYSOFWAR@OATHSWORN@UNIT_MECHANIC03@BUFF_NAME_PARAGON"
msgstr "Fúria do Guerreiro (Exemplar)"

msgid "DLC@WAYSOFWAR@OATHSWORN@UNIT_MECHANIC03@DESCRIPTION"
msgstr "No início do turno da unidade, se as unidades amigas não superarem em número as unidades inimigas, a unidade ganha {GLOBAL.PROPERTIES.WARRIOR_FURY_NEUTRAL.Hyperlink} até o final do combate.[br/][br/]{GLOBAL.PROPERTIES.WARRIOR_FURY_NEUTRAL.Hyperlink} aumenta o dano dos ataques, com base na {GLOBAL.DevotionConcept.Hyperlink}:[bulletlist][bullet/][devotion3/] Exemplar: +{paragonamount} {GLOBAL.FireDamageConcept.Hyperlink}[bullet/][devotion2/] Devoto: +{devoteeamount} {GLOBAL.FireDamageConcept.Hyperlink}[bullet/][devotion1/] Adepto: +{adherentamount} {GLOBAL.FireDamageConcept.Hyperlink}[bullet/][devotion0/] Neutro: +{neutralamount} {GLOBAL.FireDamageConcept.Hyperlink}[bullet/][devotion-1/] Quebrador de Juramento: Fúria do Guerreiro está desativada, ataques causam -{OathbreakerDamage}% de dano.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@WAYSOFWAR@OATHSWORN@UNIT_MECHANIC03@NAME"
msgstr "Alma do Guerreiro"

msgid "DLC@WAYSOFWAR@OATHSWORN_STRIFE_STORY_EVENT_BUTTON_UNITS_SURRENDER"
msgstr "\"O medo deles é a sua ruína. Só através da discórdia [devotedact/] que verdadeiros guerreiros são forjados!\" [evilact/]"

msgid "DLC@WAYSOFWAR@PICKUPS_STRATEGIC@IMPERIUM_PICKUP@DESCRIPTION"
msgstr "Uma escultura opulenta feita de materiais exóticos. Pronta para adornar a residência de um governante e inspirar lendas.[br/][br/]Mover seu exército sobre ela concederá instantaneamente algum {GLOBAL.ImperiumConcept.Hyperlink}."

msgid "DLC@WAYSOFWAR@PICKUPS_STRATEGIC@IMPERIUM_PICKUP@NAME"
msgstr "Estátua Prestigiosa"

msgid "DLC@WAYSOFWAR@PROSPERITY_DRAGON@BESTOW_MASK_OF_PROSPERITY@DESCRIPTION"
msgstr "Vincular à unidade aliada alvo:[bulletlist][bullet/]O dano sofrido pela unidade vinculada também é infligido a esta unidade com redução de {BESTOW_MASK_OF_PROSPERITY_MARTYRDOM>ResolvedDamageMultiplier}%.[bullet/]No início de cada turno, esta unidade e a unidade vinculada recebem {GLOBAL.PROPERTIES.GRACE.Hyperlink}.[/bulletlist][br/]Enquanto ativo, ganha {GLOBAL.PROPERTIES.RECALL_MASK_OF_PROSPERITY.Hyperlink}."

msgid "DLC@WAYSOFWAR@PROSPERITY_DRAGON@BESTOW_MASK_OF_PROSPERITY@NAME"
msgstr "Conceder Máscara da Prosperidade"

msgid "DLC@WAYSOFWAR@PROSPERITY_DRAGON@BESTOW_MASK_OF_PROSPERITY@STATUS_DESCRIPTION_CASTER"
msgstr "[bulletlist][bullet/]Esta unidade está absorvendo o dano de outra unidade, reduzido em {amount}%.[bullet/]No início de cada turno, recebe {GLOBAL.PROPERTIES.GRACE.Hyperlink}.[/bulletlist]"

msgid "DLC@WAYSOFWAR@PROSPERITY_DRAGON@BESTOW_MASK_OF_PROSPERITY@STATUS_DESCRIPTION_TARGET"
msgstr "[bulletlist][bullet/]O dano recebido está sendo compartilhado com outra unidade com redução de {amount}%.[bullet/]No início de cada turno, recebe {GLOBAL.PROPERTIES.GRACE.Hyperlink}.[/bulletlist]"

msgid "DLC@WAYSOFWAR@PROSPERITY_DRAGON@BESTOW_MASK_OF_PROSPERITY@STATUS_NAME"
msgstr "Máscara da Prosperidade"

msgid "DLC@WAYSOFWAR@PROSPERITY_DRAGON@RADIANT_REBUKE@NAME"
msgstr "Repreensão Radiante"

msgid "DLC@WAYSOFWAR@PROSPERITY_DRAGON@RADIANT_SPIKE@DESCRIPTION"
msgstr "Dano à unidade alvo, inimigos adjacentes recebem {RADIANT_SPIKE_CIRCLE_TARGETER>ResolvedEffectMultiplier}% de dano."

msgid "DLC@WAYSOFWAR@PROSPERITY_DRAGON@RADIANT_SPIKE@NAME"
msgstr "Espinho Radiante"

msgid "DLC@WAYSOFWAR@PROSPERITY_DRAGON@RAIN_OF_PROSPERITY@DESCRIPTION"
msgstr "Todas as unidades aliadas:[bulletlist][bullet/]Ganham {GLOBAL.PROPERTIES.GRACE.Hyperlink}[bullet/]Perde um {GLOBAL.NegativeStatusEffectConcept.Hyperlink} aleatório.[/bulletlist]"

msgid "DLC@WAYSOFWAR@PROSPERITY_DRAGON@RAIN_OF_PROSPERITY@NAME"
msgstr "Chuva da Prosperidade"

msgid "DLC@WAYSOFWAR@PROSPERITY_DRAGON@RECALL_MASK_OF_PROSPERITY@DESCRIPTION"
msgstr "[bulletlist][bullet/]Quebre o vínculo {GLOBAL.PROPERTIES.BESTOW_MASK_OF_PROSPERITY_CASTER.Hyperlink}.[bullet/]Consuma todas as pilhas de {GLOBAL.PROPERTIES.GRACE.Hyperlink}. Então, por cada pilha consumida:[bulletlist][bullet/]Cure {RECALL_MASK_OF_PROSPERITY_HEAL_EFFECT>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Ganhe uma pilha de {GLOBAL.PROPERTIES.REGENERATION.Hyperlink}.[/bulletlist][/bulletlist]"

msgid "DLC@WAYSOFWAR@PROSPERITY_DRAGON@RECALL_MASK_OF_PROSPERITY@NAME"
msgstr "Recuperar Máscara da Prosperidade"

