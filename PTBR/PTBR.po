msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@ICEBOUND_BEHEMOTH@DESCRIPTION"
msgstr "<<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacentes a este Marco ganham:[bulletlist][bullet/]{income}.[bullet/] Um Posto de Pesquisa [researchpost/] nesta província concede {income2}.[bullet/]O {combatproperty} {GLOBAL.CombatEnchantmentConcept.Hyperlink}[/bulletlist][br/]Um {GLOBAL.CityConcept.Hyperlink} com {amount} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacentes a este Marco ganham:[bulletlist][bullet/]Ganhe {visionbonus} {GLOBAL.VisionRangeConcept.Hyperlink} e {sensingbonus} {GLOBAL.SensorRangeConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@ICEBOUND_BEHEMOTH@LORE"
msgstr "\"Olhar para esses vastos olhos congelados é como estar à beira da eternidade. Mesmo selados no gelo, eles me perfuram — através da carne, da alma, do próprio tecido do cosmos. Nós, que alegamos dominar o arcano, não somos nada comparados a este colosso do {GLOBAL.UrwildernessLoreConcept.Hyperlink}. O que somos nós para um vidente tão antigo e esquecido?\"[br/][br/]— Merlin, o Errante, Diários Recuperados da Quarta Era"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@ICEBOUND_BEHEMOTH@NAME"
msgstr "Beemote Congelado"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@ICEBOUND_BEHEMOTH@NAME_OVERRIDE_01"
