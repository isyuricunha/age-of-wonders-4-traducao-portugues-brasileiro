msgstr "Montanhas Aetherglow"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@LITHORITE_PEAKS@NAME_OVERRIDE_04"
msgstr "O Espelhacrista"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@RAGING_VOLCANO@DESCRIPTION"
msgstr "<<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacentes a este Marco ganham:[bulletlist][bullet/]{income}.[bullet/]O {combatproperty} <<m:{GLOBAL.CombatEnchantmentConcept.Hyperlink}>>.[bullet/]<<m{GLOBAL.UnitConcept.Hyperlink}>> na Província ganham {GLOBAL.PROPERTIES.VOLCANIC_HEAT_UNIT_PROPERTY.Hyperlink}.[/bulletlist][br/]Um {GLOBAL.CityConcept.Hyperlink} com {amount} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacente a este Marco ganha:[bulletlist][bullet/]Libera o recrutamento de {GLOBAL.PROPERTIES.INFERNAL_FIEND.Hyperlink} e {GLOBAL.UNITS.MAGMA_SPIRIT.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>>.[/bulletlist]"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@RAGING_VOLCANO@LORE"
msgstr "\"Basta testemunhar a devastação que os vulcões precipitam para entender seu potencial arcano... e seu fascínio mítico. Alguns propõem que essas fendas flamejantes servem como portais para {GLOBAL.ObbadothLoreConcept.Hyperlink}. Ainda não confirmei se os demônios encontrados aqui emergiram do coração derretido ou se simplesmente o reivindicaram como lar.\"[br/][br/]— Larissa Mirabilis, Mito e Verdade: Folclore e suas Origens Arcanas"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@RAGING_VOLCANO@NAME"
msgstr "Vulcão Infernal"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@RAGING_VOLCANO@NAME_OVERRIDE_01"
