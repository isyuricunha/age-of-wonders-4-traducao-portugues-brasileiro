msgstr "Yaka, autoproclamado Deus do Fogo"

msgid "TOME_AUTHOR@YMBRIA"
msgstr "Ymbria, a Sacerdotisa Sangrante"

msgid "TOME_AUTHOR@ZAETHYL"
msgstr "Zaethyl, Guardião Selvagem dos Primeiros Elfos"

msgid "TOME_BEACON@ABILITY_1@DESCRIPTION"
msgstr "Base {CONVERT_RESISTANCE_CHECK>ResolvedStrength}% de chance de transformar a unidade inimiga não-{GLOBAL.HeroConcept.Hyperlink} em {GLOBAL.PROPERTIES.DOMINATED.Hyperlink}, se falhar, a unidade sofre {amount} {GLOBAL.SpiritDamageConcept.Hyperlink} em vez disso.[br/][br/]A unidade entra em {GLOBAL.DefenseModeConcept.Hyperlink} após o uso."

msgid "TOME_BEACON@ABILITY_1@ENHANCED_DESCRIPTION"
msgstr "Converter:[bulletlist][bullet/]Causa dano adicional {CONVERT_ENHANCED_DAMAGE>DAMAGE>Spirit}{GLOBAL.SpiritDamageConcept.Hyperlink}[bullet/]Concede +{CONVERT_ENHANCED_RANGE>ADD>MaxRange}{GLOBAL.RangeConcept.Hyperlink}[/bulletlist]"

msgid "TOME_BEACON@ABILITY_1@ENHANCED_NAME"
msgstr "Conversão Aprimorada"

msgid "TOME_BEACON@ABILITY_1@MASTER_DESCRIPTION"
msgstr "Converter:[bulletlist][bullet/]Concede +{CONVERT_MASTER_RANGE>ADD>OptimalRange}{GLOBAL.RangeConcept.Hyperlink}.[bullet/]Tem {amount}{GLOBAL.TurnConcept.Hyperlink} de recarga.[/bulletlist]"

msgid "TOME_BEACON@ABILITY_1@MASTER_NAME"
msgstr "Conversão Campeã"

msgid "TOME_BEACON@ABILITY_1@NAME"
msgstr "Converter"

msgid "TOME_BEACON@HERO_SKILL@DESCRIPTION"
msgstr "[bulletlist][bullet/]A unidade torna‑se {GLOBAL.PROPERTIES.FAITHFUL.Hyperlink}.[bullet/]Unidades não-{GLOBAL.HeroConcept.Hyperlink} {GLOBAL.PROPERTIES.FAITHFUL.Hyperlink} ganham +{CHAMPION_OF_THE_FAITHFUL_MORALE_EFFECT>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink} no início da batalha.[/bulletlist]"

msgid "TOME_BEACON@HERO_SKILL@NAME"
msgstr "Campeão dos Fiéis"

msgid "TOME_BEACON@PASSIVE@DESCRIPTION"
msgstr "Seu <<m:{GLOBAL.DiplomaticTokenConcept}>> concede +{amount} {GLOBAL.HouseInfluenceConcept.Hyperlink} por turno."

msgid "TOME_BEACON@PASSIVE@NAME"
msgstr "Pregadores do Farol"

msgid "TOME_BEACON@SKILL1@DESCRIPTION"
msgstr "Invoca um {GLOBAL.UNITS.LESSER_LIGHT_SPIRIT.Hyperlink} {GLOBAL.PROPERTIES.SUPPORT_UNIT.Hyperlink}."

msgid "TOME_BEACON@SKILL1@NAME"
msgstr "Invocar Espírito de Luz Menor"

msgid "TOME_BEACON@SKILL2@DESCRIPTION"
msgstr "Unidades recrutadas através de {GLOBAL.RequestMilitaryAidConcept.Hyperlink} da {GLOBAL.PvEVassalConcept.Hyperlink} alvo recebem {GLOBAL.PROPERTIES.FAITHFUL.Hyperlink}.[br/]A cidade‑vassalo alvo concede ao jogador {amount} {GLOBAL.ManaConcept.Hyperlink} a cada {GLOBAL.TurnConcept}."

msgid "TOME_BEACON@SKILL2@NAME"
msgstr "Aliança da Fé"

msgid "TOME_BEACON@SKILL3@DESCRIPTION"
msgstr "Invoca um {GLOBAL.UNITS.BLESSED_SOUL.Hyperlink} {GLOBAL.PROPERTIES.SHIELD_UNIT.Hyperlink} que pode reunir suas unidades e condenar o inimigo."

msgid "TOME_BEACON@SKILL3@NAME"
msgstr "Invocar Alma Abençoada"

msgid "TOME_BEACON@SKILL5@DESCRIPTION"
msgstr "Concede unidades encantadas:[bulletlist][bullet/]{GLOBAL.PROPERTIES.FAITHFUL.Hyperlink}, que reduz {GLOBAL.UnitUpkeepConcept.Hyperlink}.[bullet/]+{MIGHTY_MEEK_RESISTANCE>Resistance} {GLOBAL.StatusResistanceConcept.Hyperlink}.[bullet/]+{MIGHTY_MEEK_COUNTING_TIER_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink} nos ataques para cada Nível de Unidade do alvo.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_BEACON@SKILL5@MOD_DESCRIPTION"
msgstr "+{MIGHTY_MEEK_COUNTING_TIER_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink} para cada Nível de Unidade do alvo."

msgid "TOME_BEACON@SKILL5@NAME"
msgstr "Manso Poderoso"

msgid "TOME_BEACON@SKILL5@PROPERTY_DESCRIPTION"
msgstr "Unidade:[bulletlist][bullet/]Tem {GLOBAL.PROPERTIES.FAITHFUL.Hyperlink}.[bullet/]Tem +{MIGHTY_MEEK_RESISTANCE>Resistance} {GLOBAL.StatusResistanceConcept.Hyperlink}.[bullet/]Causa +{MIGHTY_MEEK_COUNTING_TIER_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink} nos ataques para cada Nível de Unidade do alvo.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_BEACON@SKILL6@DESCRIPTION"
msgstr "Invoca um(a) {GLOBAL.UNITS.DIVINE_BEACON_UNIT.Hyperlink}. Ao conjurar e no início de cada turno, unidades amigas em um raio de {DIVINE_BEACONS_GRACE_UNIT_TARGETER_CIRCLE>AREA>Radius} hexágonos:[bulletlist][bullet/]Cura +{DIVINE_BEACONS_GRACE_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Ganha +{DIVINE_BEACONS_GRACE_MORALE_GAIN>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}.[/bulletlist]{LOC.CONCEPT@SUMMON_LIVE_SHARED}[br/][br/]{LOC.TACTICAL@ABILITY@NEVER_IN_WATER}"

msgid "TOME_BEACON@SKILL6@NAME"
msgstr "Conjurar Farol Divino"

msgid "TOME_BEACON@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Libera a radiação interior do(a) {GLOBAL.PROPERTIES.FAITHFUL.Hyperlink} para castigar inimigos e fortalecer aliados."

msgid "TOME_BEACON@TOME@LORE_AUTHOR"
msgstr "Sola, a Pura, Humano Exaltado"

msgid "TOME_BEACON@TOME@LORE_DESCRIPTION"
msgstr "\"Fé, fervor, glória justa: tais coisas podem se espalhar como uma chama sagrada, trazendo a luz da verdade até os olhos de seus inimigos! Um verdadeiro farol de fé brilha tão intensamente que cura as feridas dos fiéis e incute dúvida nos infiéis, conduzindo-os ao caminho verdadeiro... o seu caminho.\""

msgid "TOME_BEACON@TOME@NAME"
msgstr "Tomo do Farol"

msgid "TOME_BEACON@UNIT2@NAME"
msgstr "Farol Divino^n"

msgid "TOME_BEACON@UNIT2_ABILITY@DESCRIPTION"
msgstr "Unidades amigas dentro de {DIVINE_BEACONS_GRACE_UNIT_TARGETER_CIRCLE>AREA>Radius} hexágonos:[bulletlist][bullet/]Cura +{DIVINE_BEACONS_GRACE_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Ganha {DIVINE_BEACONS_GRACE_MORALE_GAIN>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_BEACON@UNIT2_ABILITY@NAME"
msgstr "Graça do Farol Divino"

msgid "TOME_BEACON@UNIT@NAME"
msgstr "Portador da Luz^n"

msgid "TOME_BEASTS@PASSIVE@DESCRIPTION"
msgstr "<<m:{GLOBAL.PROPERTIES.ANIMAL.Hyperlink}>> tem {amount} Posto."

msgid "TOME_BEASTS@PASSIVE@NAME"
msgstr "Afiar Instintos"

msgid "TOME_CHAOS_CHANNELING@HERO_SKILL@DESCRIPTION"
msgstr "Invasores inimigos dentro de {CHAOTIC_REBUKE_MAGIC_EFFECT_SHIELD>MaxAttackerDistance} hexágonos têm uma chance base de {chance}% de ganhar um efeito de status aleatório."

msgid "TOME_CHAOS_CHANNELING@HERO_SKILL@NAME"
msgstr "Repreensão Caótica"

msgid "TOME_CHAOS_CHANNELING@PASSIVE@DESCRIPTION"
msgstr "Saqueando <<m:{GLOBAL.ProvinceConcept}>> concede {amount} {GLOBAL.ManaConcept}."

msgid "TOME_CHAOS_CHANNELING@PASSIVE@NAME"
msgstr "Extrair Caos"

msgid "TOME_CHAOS_CHANNELING@SKILL1@DESCRIPTION"
msgstr "[bulletlist][bullet/]Invoca um exército completo de unidades aleatórias não-Batedor de Nível I que podem ser produzidas em uma cidade no hexágono alvo.[bullet/]Se conjurada dentro de um {GLOBAL.ProvinceConcept.Hyperlink} inimigo, saqueia-o instantaneamente.[/bulletlist]"

msgid "TOME_CHAOS_CHANNELING@SKILL1@NAME"
msgstr "Horda Dourada"

msgid "TOME_CHAOS_CHANNELING@SKILL2@DESCRIPTION"
msgstr "Todas as unidades inimigas:[bulletlist][bullet/]Sustentam {FAN_THE_INFERNO_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} que ignora {BREACHING>MODIFIERS>ResolvedResistance}% da {GLOBAL.ResistanceConcept.Hyperlink}.[bullet/]São afetadas por {GLOBAL.PROPERTIES.BURNING.Hyperlink}.[/bulletlist]"

msgid "TOME_CHAOS_CHANNELING@SKILL2@NAME"
msgstr "Alimentar o Inferno"

msgid "TOME_CHAOS_CHANNELING@SKILL3@DESCRIPTION"
msgstr "Transforma a raça-alvo na personificação do fogo, concedendo-lhe:[bulletlist][bullet/]{SCION_OF_FLAME_DEFENSE>REDUCTION>Fire} {GLOBAL.FireResistanceConcept.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.VENGEFUL_FLAMES.Hyperlink}, que causa dano a {GLOBAL.MeleeConcept.Hyperlink} atacantes.[bullet/]{GLOBAL.PROPERTIES.FIERY_WAKE.Hyperlink}, que incendeia terrenos inflamáveis como <<m:{GLOBAL.FloraObstacleConcept.Hyperlink}>>.[bullet/]Imunidade a {GLOBAL.PROPERTIES.BURNING.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.LAVA_WALK.Hyperlink}.[bullet/]<<m:{GLOBAL.CityConcept.Hyperlink}>> desta raça ignoram a penalidade de {GLOBAL.CityStabilityConcept.Hyperlink} de Abismo e Lava em seu {GLOBAL.DomainConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CHAOS_CHANNELING@SKILL3@NAME"
msgstr "Descendente da Chama"

msgid "TOME_CHAOS_CHANNELING@SKILL3@PROPERTY_DESCRIPTION"
msgstr "Unidade tem:[bulletlist][bullet/]{SCION_OF_FLAME_DEFENSE>REDUCTION>Fire} {GLOBAL.FireResistanceConcept.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.VENGEFUL_FLAMES.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.FIERY_WAKE.Hyperlink}[bullet/]Imunidade a {GLOBAL.PROPERTIES.BURNING.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.LAVA_WALK.Hyperlink}[/bulletlist]"

msgid "TOME_CHAOS_CHANNELING@SKILL4@DESCRIPTION"
msgstr "Sempre que outra unidade morre em batalha, a unidade encantada ganha:[bulletlist][bullet/]{GLOBAL.PROPERTIES.INFERNAL_MIGHT.Hyperlink} por {INFERNAL_BLAZE_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]+{DEMONIC_SIPHON_MORALE>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}.[/bulletlist][br/]Não ocorre ao morrer de <<m:{GLOBAL.PROPERTIES.COMBAT_SUMMON.Hyperlink}>>, {GLOBAL.PROPERTIES.TOWER_UNIT.Hyperlink} e {GLOBAL.PROPERTIES.SIEGECRAFT_UNIT.Hyperlink} unidades."

msgid "TOME_CHAOS_CHANNELING@SKILL4@NAME"
msgstr "Sifão Demoníaco"

msgid "TOME_CHAOS_CHANNELING@SKILL4@PROPERTY_DESCRIPTION"
msgstr "Sempre que outra unidade morre em batalha, esta unidade ganha:[bulletlist][bullet/]{GLOBAL.PROPERTIES.INFERNAL_MIGHT.Hyperlink} por {INFERNAL_BLAZE_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]+{DEMONIC_SIPHON_MORALE>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}.[br/][br/]Não ocorre ao morrer de <<m:{GLOBAL.PROPERTIES.COMBAT_SUMMON.Hyperlink}>>, {GLOBAL.PROPERTIES.TOWER_UNIT.Hyperlink} e {GLOBAL.PROPERTIES.SIEGECRAFT_UNIT.Hyperlink} unidades.[/bulletlist]"

msgid "TOME_CHAOS_CHANNELING@SKILL4@PROP_DESCRIPTION"
msgstr "[bulletlist][bullet/]Ataques têm +{amount} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.FIEND.Hyperlink} unidades ganham +{INFERNAL_BLAZE_FIEND_CRIT>ResolvedCritChanceBonus}% de chance crítica.[bullet/]Podem acumular até {amountStacks} vezes.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CHAOS_CHANNELING@SKILL4@PROP_NAME"
msgstr "Poder Infernal"

msgid "TOME_CHAOS_CHANNELING@SKILL5@DESCRIPTION"
msgstr "Alvo uma cidade, e sempre que lutar naquele domínio, um {GLOBAL.UNITS.GREMLIN_UNIT.Hyperlink} é invocado ao lado de uma de suas unidades a cada {GLOBAL.TurnConcept.Hyperlink}.[br/]Até {amount} <<m:{GLOBAL.UNITS.GREMLIN_UNIT.Hyperlink}>> podem ser invocados por batalha."

msgid "TOME_CHAOS_CHANNELING@SKILL5@NAME"
msgstr "Emboscadores Gremlin"

msgid "TOME_CHAOS_CHANNELING@SKILL5@PROP_DESCRIPTION"
msgstr "Um(a) {GLOBAL.UNITS.GREMLIN_UNIT.Hyperlink} é invocado ao lado de uma das unidades do proprietário a cada {GLOBAL.TurnConcept.Hyperlink}."

msgid "TOME_CHAOS_CHANNELING@SKILL6@DESCRIPTION"
msgstr "Invoca um(a) não-{GLOBAL.PROPERTIES.FIEND.Hyperlink} de Nível V {GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink} com habilidades de Fogo e Queimando no hexágono alvo."

msgid "TOME_CHAOS_CHANNELING@SKILL6@NAME"
msgstr "Invocar Incarnado da Chama"

msgid "TOME_CHAOS_CHANNELING@SKILL7@ABILITY_DESCRIPTION"
msgstr "Causa dano a unidades em um raio de {FIRE_BOMB_TARGETER_CIRCLE>AREA>Radius} hexágonos."

msgid "TOME_CHAOS_CHANNELING@SKILL7@ABILITY_NAME"
msgstr "Bomba de Fogo"

msgid "TOME_CHAOS_CHANNELING@SKILL7@DESCRIPTION"
msgstr "Unidades encantadas ganham:[bulletlist][bullet/]A habilidade {GLOBAL.PROPERTIES.FIRE_BOMB.Hyperlink} causa dano mágico em área.[bullet/]O dano desta habilidade aumenta com o nível da unidade.[/bulletlist]"

msgid "TOME_CHAOS_CHANNELING@SKILL7@NAME"
msgstr "Foco de Incendiário"

msgid "TOME_CHAOS_CHANNELING@SKILL7@PROP_DESCRIPTION"
msgstr "Unidade tem:[bulletlist][bullet/]A habilidade {GLOBAL.PROPERTIES.FIRE_BOMB.Hyperlink}.[/bulletlist]"

msgid "TOME_CHAOS_CHANNELING@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Torne‑se o mestre do caos ao explorar os poderes caóticos acumulados nos anteriores {GLOBAL.ChaosConcept.Hyperlink} <<m:{GLOBAL.TomeConcept.Hyperlink}>>."

msgid "TOME_CHAOS_CHANNELING@TOME@LORE_AUTHOR"
msgstr "Karissa, a Vermelha, Senhora das Paixões"

msgid "TOME_CHAOS_CHANNELING@TOME@LORE_DESCRIPTION"
msgstr "“Abrace o caos, e ele o abraçará também, espalhando fervor a tudo que tocar! Um verdadeiro agente da desordem verá a ordem e a lógica distorcidas em loucura e tumulto, torcidas eternamente a seu favor!”"

msgid "TOME_CHAOS_CHANNELING@TOME@NAME"
msgstr "Tomo de Canalização do Caos"

msgid "TOME_CHAOS_LORD@HERO_SKILL@DESCRIPTION"
msgstr "Invoca um {GLOBAL.PROPERTIES.INFERNAL_FIEND.Hyperlink} aleatório de Nível I sempre que esta unidade mata outra unidade. Há uma pequena chance de que um {GLOBAL.PROPERTIES.INFERNAL_FIEND.Hyperlink} de Nível II seja invocado em vez disso.[br/]Não funciona em batalhas aquáticas."

msgid "TOME_CHAOS_LORD@HERO_SKILL@NAME"
msgstr "Carnificina Demoníaca"

msgid "TOME_CHAOS_LORD@PASSIVE@DESCRIPTION"
msgstr "Substitui um Ataque Impetuoso por um Ataque Imparável, que:[bulletlist][bullet/]Causa mais dano à {GLOBAL.FortificationHealthConcept} da cidade.[bullet/]Não reduz o <<m:{GLOBAL.HitPointConcept}>> de suas unidades.[bullet/]Não faz com que suas unidades se tornem {GLOBAL.PROPERTIES.EXHAUSTED.Hyperlink}.[/bulletlist]"

msgid "TOME_CHAOS_LORD@PASSIVE@NAME"
msgstr "Ataque Imparável"

msgid "TOME_CHAOS_LORD@PASSIVE@PROPERTY@DESCRIPTION"
msgstr "Acelera significativamente um cerco."

msgid "TOME_CHAOS_LORD@SKILL1@DESCRIPTION"
msgstr "Transforma a raça-alvo em seres demoníacos, concedendo-lhes:[bulletlist][bullet/]O tipo de unidade {GLOBAL.PROPERTIES.INFERNAL_FIEND.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.FLYING_MOVEMENT.Hyperlink}, aumentando a mobilidade.[bullet/]{GLOBAL.PROPERTIES.FRENZY.Hyperlink}, aumentando o dano ao atacar.[bullet/]<<m:{GLOBAL.CityConcept.Hyperlink}>> desta raça ignoram a penalidade de {GLOBAL.CityStabilityConcept.Hyperlink} de Abismo e Lava em sua {GLOBAL.DomainConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CHAOS_LORD@SKILL1@NAME"
msgstr "Demônios"

msgid "TOME_CHAOS_LORD@SKILL2@DESCRIPTION"
msgstr "Todas as unidades atacantes recebem {GLOBAL.PROPERTIES.KILLING_MOMENTUM.Hyperlink} e {GLOBAL.PROPERTIES.HASTENED.Hyperlink} por {HASTENED_EFFECT_DESCRIPTION_3>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "TOME_CHAOS_LORD@SKILL2@NAME"
msgstr "Investida Demoníaca"

msgid "TOME_CHAOS_LORD@SKILL3@DESCRIPTION"
msgstr "[bulletlist][bullet/]Após {turn} [turn/] em batalha, {Number} unidades inimigas não-{GLOBAL.HeroConcept.Hyperlink} ficam {GLOBAL.PROPERTIES.MIND_CONTROLLED} até o fim do combate.[bullet/]A cidade sofre -{HappinessDebuff} {GLOBAL.CityStabilityConcept.Hyperlink} enquanto está sitiada.[/bulletlist]"

msgid "TOME_CHAOS_LORD@SKILL3@NAME"
msgstr "Incitar Rebelião"

msgid "TOME_CHAOS_LORD@SKILL4@DESCRIPTION"
msgstr "Invoca um avatar do seu {GLOBAL.LeaderConcept.Hyperlink} para a batalha. O avatar tem as mesmas habilidades que o seu Governante e nasce com <<m:{GLOBAL.ActionPointConcept.Hyperlink}>> cheio. Todos os <<m:{GLOBAL.PROPERTIES.FIEND.Hyperlink}>> recebem +{AVATAR_OF_CHAOS_MORALE>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}.[br/][br/]{LOC.TACTICAL@ABILITY@NEVER_IN_WATER}[br/]Não pode ser usado em batalhas onde seu {GLOBAL.LeaderConcept.Hyperlink} está presente."

msgid "TOME_CHAOS_LORD@SKILL4@NAME"
msgstr "Convocar Avatar do Caos"

msgid "TOME_CHAOS_LORD@SKILL5@NAME"
msgstr "Era do Caos"

msgid "TOME_CHAOS_LORD@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Liberte forças caóticas sobre o mundo. Especialize‑se em bônus ofensivos."

msgid "TOME_CHAOS_LORD@TOME@LORE_AUTHOR"
msgstr "Karissa, a Vermelha, Senhora das Paixões"

msgid "TOME_CHAOS_LORD@TOME@LORE_DESCRIPTION"
msgstr "“Delicie‑se na desordem! Prospere no tumulto! Sua aura de caos é como uma névoa insidiosa que distorce a realidade e incita a loucura. A própria terra parece tremer ao seu chegar, com seres dos reinos demoníacos percebendo sua presença. Nasça em fogo e sangue, ó Godir, e traga a Era do Caos!”"

msgid "TOME_CHAOS_LORD@TOME@NAME"
msgstr "Tomo do Senhor do Caos"

msgid "TOME_COLD_DARK@HERO_SKILL@DESCRIPTION"
msgstr "Ataques base de {GLOBAL.MagicConcept.Hyperlink} têm uma chance base de {BLINDED_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.BLINDED.Hyperlink}.[br/][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_COLD_DARK@HERO_SKILL@NAME"
msgstr "Magia Cegante"

msgid "TOME_COLD_DARK@PASSIVE@DESCRIPTION"
msgstr "Arrasar <<m:{GLOBAL.CityConcept}>> e saquear <<m:{GLOBAL.ProvinceConcept}>> transforma o {GLOBAL.ProvinceConcept} em uma província Ártica."

msgid "TOME_COLD_DARK@PASSIVE@NAME"
msgstr "Ruínas Congeladas"

msgid "TOME_COLD_DARK@PASSIVE_FARMING@DESCRIPTION"
msgstr "Pode construir <<m:{GLOBAL.FarmConcept.Hyperlink}>> em terreno de Neve.[br/][br/]<<m:{GLOBAL.FarmConcept.Hyperlink}>> em terreno de Neve recebem +{amount} {GLOBAL.FoodConcept.Hyperlink} se sua raça possui Adaptação Ártica."

msgid "TOME_COLD_DARK@PASSIVE_FARMING@NAME"
msgstr "Agricultura Ártica"

msgid "TOME_COLD_DARK@PASSIVE_STABILITY@DESCRIPTION"
msgstr "<<m:{GLOBAL.ProvinceConcept.Hyperlink}>> com Neve concedem +{amount} {GLOBAL.CityStabilityConcept.Hyperlink}."

msgid "TOME_COLD_DARK@PASSIVE_STABILITY@NAME"
msgstr "Preferência por Neve"

msgid "TOME_COLD_DARK@SKILL1@DESCRIPTION"
msgstr "Cada turno, por {BLINDING_MIST_AUTO_SPELL>TimeToLive} <<m:{GLOBAL.TurnConcept}>>, todos os inimigos:[bulletlist][bullet/]Sofrem {WITHERING_MIST_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Têm uma chance base de {BLINDED_RESISTANCE>ResolvedStrength}% de se tornar {GLOBAL.PROPERTIES.BLINDED.Hyperlink} por {BLINDED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Têm uma chance base de {WEAKENED_RESISTANCE>ResolvedStrength}% de se tornar {GLOBAL.PROPERTIES.WEAKENED.Hyperlink} por {WEAKENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "TOME_COLD_DARK@SKILL1@NAME"
msgstr "Névoa Degradante"

msgid "TOME_COLD_DARK@SKILL1@PROPERTY@DESCRIPTION"
msgstr "Cada turno, todos os inimigos:[bulletlist][bullet/]Sofrem {WITHERING_MIST_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Têm uma chance base de {BLINDED_RESISTANCE>ResolvedStrength}% de se tornar {GLOBAL.PROPERTIES.BLINDED.Hyperlink} por {BLINDED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Têm uma chance base de {WEAKENED_RESISTANCE>ResolvedStrength}% de se tornar {GLOBAL.PROPERTIES.WEAKENED.Hyperlink} por {WEAKENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "TOME_COLD_DARK@SKILL2@DESCRIPTION"
msgstr "Invoca um {GLOBAL.UNITS.SNOW_SPIRIT.Hyperlink}, um {GLOBAL.PROPERTIES.MAGIC_FIGHTER.Hyperlink} cujos ataques infligem {GLOBAL.PROPERTIES.FROZEN.Hyperlink}."

msgid "TOME_COLD_DARK@SKILL2@NAME"
msgstr "Invocar Espírito da Neve"

msgid "TOME_COLD_DARK@SKILL3@DESCRIPTION"
msgstr "Faz o inverno percorrer as veias da raça-alvo, concedendo-lhes:[bulletlist][bullet/]{FROSTLING_TRANSFORMATION_DEFENSE>REDUCTION>Frost} {GLOBAL.FrostResistanceConcept.Hyperlink}.[bullet/]Imunidade a {GLOBAL.PROPERTIES.FROZEN.Hyperlink}.[bullet/]+{FROSTLING_TRANSFORMATION_MORALE_BONUS_FROZEN_WASTE>MoraleBonus} {GLOBAL.UnitMoraleConcept.Hyperlink} enquanto em terreno frio.[bullet/]{GLOBAL.PROPERTIES.ARCTIC_WALK.Hyperlink}, que permite atravessar terreno frio mais rápido.[/bulletlist]"

msgid "TOME_COLD_DARK@SKILL3@NAME"
msgstr "Transformação Frostling"

msgid "TOME_COLD_DARK@SKILL3@PROP_DESCRIPTION"
msgstr "Unidade possui:[bulletlist][bullet/]{FROSTLING_TRANSFORMATION_DEFENSE>REDUCTION>Frost} {GLOBAL.FrostResistanceConcept.Hyperlink}.[bullet/]Imunidade a {GLOBAL.PROPERTIES.FROZEN.Hyperlink}.[bullet/]+{FROSTLING_TRANSFORMATION_MORALE_BONUS_FROZEN_WASTE>MoraleBonus} {GLOBAL.UnitMoraleConcept.Hyperlink} enquanto em terreno frio.[bullet/]{GLOBAL.PROPERTIES.ARCTIC_WALK.Hyperlink}.[/bulletlist]"

msgid "TOME_COLD_DARK@SKILL4@DESCRIPTION"
msgstr "Alvo que lidera um exército ganha {GLOBAL.PROPERTIES.UNIVERSAL_CAMOUFLAGE.Hyperlink} para todo o seu exército por {turns} <<m:{GLOBAL.TurnConcept}>>."

msgid "TOME_COLD_DARK@SKILL4@NAME"
msgstr "Véu das Trevas"

msgid "TOME_COLD_DARK@SKILL4@PROPERTY@DESCRIPTION"
msgstr "Todo o exército ganha {GLOBAL.PROPERTIES.UNIVERSAL_CAMOUFLAGE.Hyperlink}."

msgid "TOME_COLD_DARK@SKILL5@DESCRIPTION"
msgstr "Alvo aliado {GLOBAL.CityConcept.Hyperlink} ganha:[bulletlist]A cada {GLOBAL.TurnConcept.Hyperlink}, {amount} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> dentro ou adjacente ao {GLOBAL.DomainConcept.Hyperlink}:[bulletlist][bullet/]Ganha {GLOBAL.SnowConcept.Hyperlink} e {GLOBAL.FrozenWasteConcept.Hyperlink}.[bullet/]Perde {GLOBAL.ChasmConcept.Hyperlink}, {GLOBAL.SwampConcept.Hyperlink}, {GLOBAL.AshlandsConcept.Hyperlink}, {GLOBAL.SandConcept.Hyperlink}, {GLOBAL.CavernFloorConcept.Hyperlink}, {GLOBAL.FungusFieldsConcept.Hyperlink} e {GLOBAL.GloomTerrainConcept.Hyperlink}.[/bulletlist][bullet/]Províncias no domínio com Neve ou Gelo fornecem +{resources} {GLOBAL.FoodConcept.Hyperlink} e +{resources} {GLOBAL.StructureProductionConcept.Hyperlink} de renda.[/bulletlist]"

msgid "TOME_COLD_DARK@SKILL5@NAME"
msgstr "Inverno Marchante"

msgid "TOME_COLD_DARK@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Espalhe o terreno Ártico por todo o mundo e envolva suas unidades com seu poder, para que elas sejam fortalecidas por sua presença."

msgid "TOME_COLD_DARK@TOME@LORE_AUTHOR"
msgstr "Artica, a Fria, Rainha dos Frostlings"

msgid "TOME_COLD_DARK@TOME@LORE_DESCRIPTION"
msgstr "\"A luz traz tanto calor quanto esperança. Apague‑a e você mergulhará seus inimigos em frio, noite eterna! Roube‑les o conforto, destrua sua esperança, deixe‑os com membros dormentes e olhos cegos. A escuridão drenará a vontade de seus inimigos de lutar, vencer, viver!\""

msgid "TOME_COLD_DARK@TOME@NAME"
msgstr "Tomo da Escuridão Fria"

msgid "TOME_CREATOR@HERO_SKILL@DESCRIPTION"
msgstr "Unidade cresce em tamanho e ganha:[bulletlist][bullet/]{GLOBAL.PROPERTIES.LARGE_TARGET.Hyperlink}[bullet/]+{ANCIENT_OF_EARTH_STAT_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]+{ANCIEN_OF_EARTH_DAMAGE_MULTIPLIER>ResolvedMultiplier}% de dano[/bulletlist][br/]Unidade não pode mais usar montaria."

msgid "TOME_CREATOR@HERO_SKILL@DESCRIPTION_DRGON"
msgstr "Unidade ganha:[bulletlist][bullet/]+{ANCIENT_OF_EARTH_STAT_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]+{ANCIEN_OF_EARTH_DAMAGE_MULTIPLIER>ResolvedMultiplier}% de dano[/bulletlist]"

msgid "TOME_CREATOR@HERO_SKILL@ES_NAME"
msgstr "Ancião"

msgid "TOME_CREATOR@HERO_SKILL@NAME"
msgstr "Ancião da Terra"

msgid "TOME_CREATOR@PASSIVE@DESCRIPTION"
msgstr "Unidades não-{GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink} são produzidas com posto {amount}."

msgid "TOME_CREATOR@PASSIVE@NAME"
msgstr "Forjas Lendárias"

msgid "TOME_CREATOR@SKILL1@SPELL2@DESCRIPTION"
msgstr "A província de Montanha alvo torna‑se uma província Rochosa."

msgid "TOME_CREATOR@SKILL1@SPELL2@NAME"
msgstr "Montanhas Baixas"

msgid "TOME_CREATOR@SKILL2@DESCRIPTION"
msgstr "[bulletlist][bullet/]Invoca um {GLOBAL.UNITS.EARTH_TITAN_UNIT.Hyperlink} no hexágono desocupado alvo.[bullet/]Todos os inimigos adjacentes perdem seu {GLOBAL.DefenseModeConcept.Hyperlink} e {GLOBAL.RetaliationConcept.Hyperlink}.[/bulletlist][br/][br/]{LOC.TACTICAL@ABILITY@NEVER_IN_WATER}"

msgid "TOME_CREATOR@SKILL2@NAME"
msgstr "Invocar o Titã da Terra"

msgid "TOME_CREATOR@SKILL3@DESCRIPTION"
msgstr "[bulletlist][bullet/]Todos os inimigos sofrem {TECTONIC_SHATTER_UNIT_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Todos os inimigos têm uma chance base de {STUNNED_RESISTANCE>ResolvedStrength}% de se tornarem {GLOBAL.PROPERTIES.STUNNED.Hyperlink}.[bullet/]Todos os obstáculos no mapa têm chance de {obstacles} de serem destruídos.[/bulletlist]"

msgid "TOME_CREATOR@SKILL3@NAME"
msgstr "Fragmentação Tectônica"

msgid "TOME_CREATOR@SKILL4@DESCRIPTION"
msgstr "Concede unidades encantadas:[bulletlist][bullet/]{GLOBAL.PROPERTIES.NATURAL_REGENERATION_GROUP.Hyperlink}[bullet/]+{SHAPERS_TOUCH_STAT_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]+{SHAPERS_TOUCH_DEFENSE>REDUCTION>Shock} {GLOBAL.LightningResistanceConcept.Hyperlink}[/bulletlist]"

msgid "TOME_CREATOR@SKILL4@NAME"
msgstr "Toque do Modelador"

msgid "TOME_CREATOR@SKILL4@PROP_DESCRIPTION"
msgstr "Unidade tem:[bulletlist][bullet/]{GLOBAL.PROPERTIES.NATURAL_REGENERATION_GROUP.Hyperlink}[bullet/]+{SHAPERS_TOUCH_STAT_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]+{SHAPERS_TOUCH_DEFENSE>REDUCTION>Shock} {GLOBAL.LightningResistanceConcept.Hyperlink}[/bulletlist]"

msgid "TOME_CREATOR@SKILL5@NAME"
msgstr "Era do Materium"

msgid "TOME_CREATOR@SKILL6@DESCRIPTION"
msgstr "[bulletlist][bullet/]No início da batalha, todos os obstáculos de Muralha são danificados.[bullet/]No início da batalha, ganhe {amount} {GLOBAL.UNITS.EARTHSHATTER_ENGINE_UNIT.Hyperlink} unidades do lado do atacante até o fim da batalha.[bullet/]<<m:{GLOBAL.UNITS.EARTHSHATTER_ENGINE_UNIT.Hyperlink}>> são {GLOBAL.PROPERTIES.SIEGECRAFT_UNIT.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> com alcance curto, ataques de área que podem destruir obstáculos e derrubar unidades inimigas de {GLOBAL.DefenseModeConcept.Hyperlink}.[bullet/]Apenas um tipo de unidade de Cerco pode ser trazido para {GLOBAL.CombatConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CREATOR@SKILL6@NAME"
msgstr "Criar Máquinas de Fragmentação da Terra"

msgid "TOME_CREATOR@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Molde o mundo, invoque titãs adormecidos e torne‑se o mestre da terra."

msgid "TOME_CREATOR@TOME@LORE_AUTHOR"
msgstr "Mãe Mab, Deusa dos Goblins"

msgid "TOME_CREATOR@TOME@LORE_DESCRIPTION"
msgstr "\"Aqueles que dominam o Materium elevam‑se acima do mundo, arrasando e derrubando terras à vontade, e dominando as forças primordiais da criação. Os próprios titãs caminharão ao seu lado, enquanto as próprias essências de elemento e mineral se curvarão. Você é o Criador, um modelador de mundos.\""

msgid "TOME_CREATOR@TOME@NAME"
msgstr "Tomo do Criador"

msgid "TOME_CREATOR@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Alvo todos os inimigos dentro de {SEISMIC_SLAM_UNIT_TARGETER_CIRCLE>AREA>Radius} hexágonos."

msgid "TOME_CREATOR@UNIT1@ABILITY1@NAME"
msgstr "Golpe Sísmico"

msgid "TOME_CREATOR@UNIT1@DESCRIPTION"
msgstr "Obedecendo apenas ao comando dos mestres absolutos da terra, o Titã da Terra é uma força implacável e a personificação da fúria da terra."

msgid "TOME_CREATOR@UNIT1@NAME"
msgstr "Titã da Terra^n"

msgid "TOME_CREATOR@UNIT2@ABILITY1@DESCRIPTION"
msgstr "Unidades inimigas em um raio de {EARTH_TREMOR_UNIT_TARGETER_CIRCLE>AREA>Radius} hexágonos:[bulletlist][bullet/]Sofrem dano[bullet/]Perdem seu {GLOBAL.DefenseModeConcept.Hyperlink}[bullet/]Perdem {GLOBAL.RetaliationConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CREATOR@UNIT2@ABILITY1@NAME"
msgstr "Tremor de Terra"

msgid "TOME_CREATOR@UNIT2@DESCRIPTION"
msgstr "Máquina de cerco lenta porém poderosa, capaz de destruir trechos inteiros de muralhas em instantes."

msgid "TOME_CREATOR@UNIT2@NAME"
msgstr "Máquina de Fragmentação da Terra^n"

msgid "TOME_CRICIBLE@SKILL2@DEFENSE_DESCRIPTION"
msgstr "Adiciona obstáculos de Baluartes do Crisol em {GLOBAL.CombatConcept.Hyperlink} durante um {GLOBAL.SiegeConcept.Hyperlink}.[br/][br/]Obstáculos de Baluartes do Crisol concedem ataques {GLOBAL.RangedConcept.Hyperlink} e {GLOBAL.MagicConcept.Hyperlink}:[bulletlist][bullet/]Causa {damage} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Define os hexágonos afetados {GLOBAL.OnFireConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CRUCIBLE@HERO_SKILL@DESCRIPTION"
msgstr "[bulletlist][bullet/]Ataques base causam {METEOR_ARROWS_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} ao alvo e inimigos adjacentes.[bullet/]Todos os ataques ganham {GLOBAL.PROPERTIES.DEMOLISHER.Hyperlink}.[br/][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}[/bulletlist]"

msgid "TOME_CRUCIBLE@HERO_SKILL@MOD_DESCRIPTION"
msgstr "+{METEOR_ARROWS_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} ao alvo e inimigos adjacentes."

msgid "TOME_CRUCIBLE@HERO_SKILL@NAME"
msgstr "Impactos de Meteoro"

msgid "TOME_CRUCIBLE@PASSIVE@DESCRIPTION"
msgstr "[bulletlist][bullet/]Minas concedem {amount} {GLOBAL.ManaConcept} de renda.[bullet/]Minas agora podem ser construídas em <<m:{GLOBAL.ProvinceConcept}>> com recurso de Lava ou Abismo.[/bulletlist]"

msgid "TOME_CRUCIBLE@PASSIVE@NAME"
msgstr "Mineração de Pyrosifão"

msgid "TOME_CRUCIBLE@SKILL1@DESCRIPTION"
msgstr "Alvo {GLOBAL.ProvinceConcept.Hyperlink}:[bulletlist][bullet/]Se contiver um inimigo {GLOBAL.ProvinceImprovementConcept.Hyperlink}, será [hyperlink,GLOBAL.PillagingConcept]Saqueado[/hyperlink].[bulletlist][bullet/]Você não receberá suas recompensas nem perderá {GLOBAL.AlignmentConcept.Hyperlink}.[/bulletlist][bullet/]Inimigo <<m:{GLOBAL.UnitConcept.Hyperlink}>> na província sustenta {damage} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]A província ganha {GLOBAL.AshlandsConcept.Hyperlink}.[bullet/]A província perde {GLOBAL.RiverConcept.Hyperlink}, {GLOBAL.FertilePlainsConcept.Hyperlink}, {GLOBAL.SwampConcept.Hyperlink}, {GLOBAL.SnowConcept.Hyperlink}, {GLOBAL.FrozenWasteConcept.Hyperlink}, {GLOBAL.SandConcept.Hyperlink}, {GLOBAL.CavernFloorConcept.Hyperlink} e {GLOBAL.GloomTerrainConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CRUCIBLE@SKILL1@NAME"
msgstr "Erupção Piroclástica"

msgid "TOME_CRUCIBLE@SKILL2@DEFENSE_DESCRIPTION"
msgstr "Adiciona obstáculos de Baluartes do Crisol em {GLOBAL.CombatConcept.Hyperlink} durante um {GLOBAL.SiegeConcept.Hyperlink}.[br/][br/]Obstáculos de Baluarte do Crisol concedem ataques {GLOBAL.RangedConcept.Hyperlink} e {GLOBAL.MagicConcept.Hyperlink}:[bulletlist][bullet/]Causa {damage} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Define os hexágonos afetados como {GLOBAL.OnFireConcept.Hyperlink}.[bullet/]Ignora {GLOBAL.ObscuredConcept.Hyperlink} nos alvos.[bullet/]{rangebonus} {GLOBAL.RangeConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CRUCIBLE@SKILL2@DESCRIPTION"
msgstr "{GLOBAL.CityBattlementStructureConcept.Hyperlink}[br/][bulletlist][bullet/]Baluartes concedem ataques {GLOBAL.RangedConcept.Hyperlink} e {GLOBAL.MagicConcept.Hyperlink}:[bulletlist][bullet/]Causa {damage}.[bullet/]Define os hexágonos afetados {GLOBAL.OnFireConcept.Hyperlink}.[bullet/]Ignora {GLOBAL.ObscuredConcept.Hyperlink} nos alvos.[bullet/]{rangebonus} {GLOBAL.RangeConcept.Hyperlink}[/bulletlist][bullet/]A Cidade ignora penalidades negativas de {GLOBAL.CityStabilityConcept.Hyperlink} ao anexar províncias com {GLOBAL.ChasmConcept.Hyperlink} ou {GLOBAL.LavaConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CRUCIBLE@SKILL2@MARKER@DESCRIPTION"
msgstr "Ataques base {GLOBAL.RangedConcept.Hyperlink} e {GLOBAL.MagicConcept.Hyperlink}:[bulletlist][bullet/]Causa {damage} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Incendeia o solo {GLOBAL.OnFireConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CRUCIBLE@SKILL2@MARKER@NAME"
msgstr "Runas Incendiárias"

msgid "TOME_CRUCIBLE@SKILL2@MODIFIER_DESCRIPTION"
msgstr "Esta unidade foi construída em uma Cidade com a estrutura Crisol Fortificado, fazendo com que seus ataques causem {damage}."

msgid "TOME_CRUCIBLE@SKILL2@NAME"
msgstr "Baluartes do Crisol"

msgid "TOME_CRUCIBLE@SKILL2@UNLOCK@NAME"
msgstr "Baluartes do Crisol em Combate"

msgid "TOME_CRUCIBLE@SKILL3@DESCRIPTION"
msgstr "Alvo: raio de {LAVA_BURST_OBSTACLE_TARGETER_CIRCLE>AREA>Radius} hexágonos:[bulletlist][bullet/]Todas as unidades recebem {LAVA_BURST_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Todas as unidades são afetadas por {GLOBAL.PROPERTIES.BURNING.Hyperlink}.[bullet/]Todas as unidades ficam {GLOBAL.PROPERTIES.SLOWED.Hyperlink}.[bullet/]O solo fica {GLOBAL.OnFireConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CRUCIBLE@SKILL3@NAME"
msgstr "Explosão de Lava"

msgid "TOME_CRUCIBLE@SKILL4@DESCRIPTION"
msgstr "Até {METEOR_SHOWER_AUTO_SPELL>MaxCastCount} unidades inimigas aleatórias e inimigos adjacentes a elas:[bulletlist][bullet/]Sofrem {METEOR_SHOWER_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} e {METEOR_SHOWER_UNIT_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[/bulletlist][br/]Este feitiço se repete no início de cada turno pelos próximos {METEOR_SHOWER_AUTO_SPELL>TimeToLive} <<m:{GLOBAL.TurnConcept}>>."

msgid "TOME_CRUCIBLE@SKILL4@NAME"
msgstr "Chuva de Meteoros"

msgid "TOME_CRUCIBLE@SKILL5@DESCRIPTION"
msgstr "Faz com que os ataques base de unidades encantadas:[bulletlist][bullet/]Cause +{METEOR_ARROWS_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} ao alvo e inimigos adjacentes.[bullet/]Ganha {GLOBAL.PROPERTIES.DEMOLISHER.Hyperlink}, permitindo destruir obstáculos reforçados.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CRUCIBLE@SKILL5@MOD_DESCRIPTION"
msgstr "[bulletlist][bullet/]+{METEOR_ARROWS_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} ao alvo e inimigos adjacentes.[bullet/]Tem {GLOBAL.PROPERTIES.DEMOLISHER.Hyperlink}[/bulletlist]"

msgid "TOME_CRUCIBLE@SKILL5@NAME"
msgstr "Imbuimento de Meteoros"

msgid "TOME_CRUCIBLE@SKILL5@PROP_DESCRIPTION"
msgstr "Os ataques base da unidade têm:[bulletlist][bullet/]+{METEOR_ARROWS_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} ao alvo e inimigos adjacentes.[bullet/]{GLOBAL.PROPERTIES.DEMOLISHER.Hyperlink}.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CRUCIBLE@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Enterre seus inimigos em lava e molde a terra usando as forças destrutivas da terra e do fogo."

msgid "TOME_CRUCIBLE@TOME@LORE_AUTHOR"
msgstr "Yaka, autoproclamado Deus do Fogo"

msgid "TOME_CRUCIBLE@TOME@LORE_DESCRIPTION"
msgstr "\"Não é o magma um espetáculo glorioso de se contemplar? Uma união de fogo e terra que avança inexoravelmente contra seus inimigos, engolindo-os, trazendo morte flamejante! A própria paisagem se remodela ao fluir, com belas cicatrizes traçadas sobre o reino.\""

msgid "TOME_CRUCIBLE@TOME@NAME"
msgstr "Tomo do Crisol"

msgid "TOME_CRYOMANCY@PASSIVE@DESCRIPTION"
msgstr "Ganha {amount} {GLOBAL.KnowledgeConcept} por cada nível {GLOBAL.UnitConcept} eliminado em {GLOBAL.CombatConcept}."

msgid "TOME_CRYOMANCY@PASSIVE@NAME"
msgstr "Preservar espécimes"

msgid "TOME_CRYOMANCY@SKILL_1@DESCRIPTION"
msgstr "Alvo inimigo:[bulletlist][bullet/]Sofre {ICE_COFFIN_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Tem {FROZEN_RESISTANCE>ResolvedStrength}% de chance base de se tornar {GLOBAL.PROPERTIES.FROZEN.Hyperlink}. Se falhar, inflige {GLOBAL.PROPERTIES.STATUS_VULNERABILITY.Hyperlink}.[/bulletlist]"

msgid "TOME_CRYOMANCY@SKILL_1@NAME"
msgstr "Caixão de Gelo"

msgid "TOME_CRYOMANCY@SKILL_2@DESCRIPTION"
msgstr "Concede acesso a um {GLOBAL.PROPERTIES.BATTLE_MAGE.Hyperlink} que inflige {GLOBAL.PROPERTIES.FROZEN.Hyperlink}."

msgid "TOME_CRYOMANCY@SKILL_2@NAME"
msgstr "Bruxa Branca^f"

msgid "TOME_CRYOMANCY@SKILL_3@DESCRIPTION"
msgstr "Faz com que os ataques de unidades encantadas causem:[bulletlist][bullet/]+{FROST_BLADES_EXTRA_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]+{FROST_BLADES_DAMAGE_MULTIPLIER>ResolvedMultiplier}% de dano contra unidades {GLOBAL.PROPERTIES.FROZEN.Hyperlink} ou {GLOBAL.PROPERTIES.SLOWED.Hyperlink}.[/bulletlist] [br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CRYOMANCY@SKILL_3@NAME"
msgstr "Lâminas de Gelo"

msgid "TOME_CRYOMANCY@SKILL_3@PROP_DESCRIPTION"
msgstr "Os ataques da unidade têm:[bulletlist][bullet/]+{FROST_BLADES_EXTRA_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]+{FROST_BLADES_DAMAGE_MULTIPLIER>ResolvedMultiplier}% de dano contra unidades {GLOBAL.PROPERTIES.FROZEN.Hyperlink} e {GLOBAL.PROPERTIES.SLOWED.Hyperlink}.[/bulletlist] [br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CRYOMANCY@SKILL_4@DESCRIPTION"
msgstr "Invoca um {GLOBAL.UNITS.LESSER_SNOW_SPIRIT.Hyperlink}, um {GLOBAL.PROPERTIES.MAGIC_FIGHTER.Hyperlink} cujos ataques infligem {GLOBAL.PROPERTIES.FROZEN.Hyperlink}."

msgid "TOME_CRYOMANCY@SKILL_4@NAME"
msgstr "Invocar Espírito de Neve Menor"

msgid "TOME_CRYOMANCY@SKILL_5@DESCRIPTION"
msgstr "Todas as unidades do exército inimigo alvo:[bulletlist][bullet/]Sofrem {amount} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Sofrem {vulnerability} {GLOBAL.StatusResistanceConcept.Hyperlink} por {turn} {GLOBAL.WorldMapConcept.Name} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "TOME_CRYOMANCY@SKILL_5@NAME"
msgstr "Nevasca"

msgid "TOME_CRYOMANCY@SKILL_5@PROPERTY@DESCRIPTION"
msgstr "{BLIZZARD_STATUS_RESISTANCE>Resistance} {GLOBAL.StatusResistanceConcept.Hyperlink}"

msgid "TOME_CRYOMANCY@SKILL_6@DESCRIPTION"
msgstr "Faz com que os ataques de unidades encantadas ganhem:[bulletlist][bullet/]+{FROST_BLADES_EXTRA_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Uma chance base de {SLOWED_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.SLOWED.Hyperlink}.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CRYOMANCY@SKILL_6@NAME"
msgstr "Setas de Gelo"

msgid "TOME_CRYOMANCY@SKILL_6@PROP_DESCRIPTION"
msgstr "Os ataques da unidade têm:[bulletlist][bullet/]+{FROST_BLADES_EXTRA_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Uma chance base de {SLOWED_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.SLOWED.Hyperlink}.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CRYOMANCY@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Especialize-se em causar {GLOBAL.FrostDamageConcept.Hyperlink} e infligir {GLOBAL.PROPERTIES.FROZEN.Hyperlink}."

msgid "TOME_CRYOMANCY@TOME@LORE_AUTHOR"
msgstr "Artica, a Fria, Rainha dos Frostlings"

msgid "TOME_CRYOMANCY@TOME@LORE_DESCRIPTION"
msgstr "\"Quando todo o mundo se transformar em gelo, vejo um puro paraíso Frostling! Congele seus membros e torne seus ossos frágeis, sepultados em sangue gelado! Invoco a nevasca para congelar a carne e inspirar o medo que remonta a uma época em que os mortais se encolhiam em cavernas, temendo que o frio os consumisse...\""

msgid "TOME_CRYOMANCY@TOME@NAME"
msgstr "Tomo de Criomancia"

msgid "TOME_CRYOMANCY@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Cause dano à unidade inimiga alvo."

msgid "TOME_CRYOMANCY@UNIT1@ABILITY1@ENHANCED_DESCRIPTION"
msgstr "Explosão Congelante:[bulletlist][bullet/]Causa um adicional {FREEZING_BLAST_ENHANCED_DAMAGE>DAMAGE>Frost}{GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]não tem tempo de recarga.[/bulletlist]"

msgid "TOME_CRYOMANCY@UNIT1@ABILITY1@ENHANCED_NAME"
msgstr "Explosão Congelante Aprimorada"

msgid "TOME_CRYOMANCY@UNIT1@ABILITY1@MASTER_DESCRIPTION"
msgstr "Explosão Congelante:[bulletlist][bullet/]Causa dano adicional {FREEZING_BLAST_ENHANCED_DAMAGE>DAMAGE>Frost}{GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Tem uma chance base de {FROZEN_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.FROZEN.Hyperlink}.[/bulletlist]"

msgid "TOME_CRYOMANCY@UNIT1@ABILITY1@MASTER_NAME"
msgstr "Campeão Explosão Congelante"

msgid "TOME_CRYOMANCY@UNIT1@ABILITY1@NAME"
msgstr "Explosão Congelante"

msgid "TOME_CYCLES@ABILITY1@DESCRIPTION"
msgstr "Quando esta unidade mata outra, seus tempos de recarga são redefinidos."

msgid "TOME_CYCLES@ABILITY1@NAME"
msgstr "Vida da Morte"

msgid "TOME_CYCLES@ABILITY_2@DESCRIPTION"
msgstr "Leve chance de matar instantaneamente um alvo ferido. Essa chance aumenta quanto menores forem os <<m:{GLOBAL.HitPointConcept}>> do alvo. Se falhar, o alvo ganha {amount2} {GLOBAL.PROPERTIES.WEAKENED.Hyperlink}."

msgid "TOME_CYCLES@ABILITY_2@NAME"
msgstr "Fim do Ciclo"

msgid "TOME_CYCLES@ABILITY_3@DESCRIPTION"
msgstr "Alvo unidade amiga:[bulletlist][bullet/]Se viva, cura +{RESTART_THE_CYCLE_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Se morta, é ressuscitada com {RESTART_THE_CYCLE_RESSURECT>ResolvedHitPoints}% de seu total de <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[/bulletlist]"

msgid "TOME_CYCLES@ABILITY_3@DESCRIPTION_CHAMPION"
msgstr "Reiniciar o Ciclo: [bulletlist][bullet/]Cura adicional {healAmount}<<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Ressuscita unidades com um adicional de {resurrectPercentage}% de seu total de <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[/bulletlist]"

msgid "TOME_CYCLES@ABILITY_3@ERROR_MESSAGE"
msgstr "Requer {GLOBAL.PROPERTIES.LIFE_FROM_DEATH_ABILITY_MODIFIER.Hyperlink} para ser usado."

msgid "TOME_CYCLES@ABILITY_3@NAME"
msgstr "Reiniciar o Ciclo"

msgid "TOME_CYCLES@ABILITY_3@NAME_CHAMPION"
msgstr "Campeão Reiniciar o Ciclo"

msgid "TOME_CYCLES@ABILITY_4@DESCRIPTION"
msgstr "Alvo unidade amiga não‑herói é morta, inimigos adjacentes sofrem {SACRIFICIAL_BLIGHT_DAMAGE>DAMAGE>Blight} {GLOBAL.BlightDamageConcept.Hyperlink} por nível da unidade sacrificada.[br/][br/]Esta habilidade sempre é ativada {GLOBAL.PROPERTIES.LIFE_FROM_DEATH_ABILITY_MODIFIER.Hyperlink},"

msgid "TOME_CYCLES@ABILITY_4@NAME"
msgstr "Calamidade Sacrificial"

msgid "TOME_CYCLES@HERO_SKILL@DESCRIPTION"
