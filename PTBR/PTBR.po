msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_579@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} do(a) {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} saúda você com a saudação cerimonial de <<o:EventHouseLord>> {EventHouseRace}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_579@BODY_LORE"
msgstr "\"Celebramos sua chegada, {PlayerLeader.FirstName}-kan. {EventPhrase} Vamos renovar nossos Juramentos na presença um do outro. Que isso ofereça uma base sólida para ambas as nossas Casas. Que assunto o traz até {EventHouse}? Como nossas aspirações podem beneficiar as suas, e as suas as minhas?\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_579@BUTTON_0"
msgstr "Inspecionar {EventHouse}, bastião de seus irmãos de armas."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_579@BUTTON_1"
msgstr "\"Voltarei a vê-lo outro dia, {EventHouseLord.FirstName}-hem.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_579@EVENTPHRASE_HARMONY"
msgstr "Sua postura equilibrada me informa que você, assim como nós, é guiado por {EventOath}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_579@EVENTPHRASE_RIGHTEOUSNESS"
msgstr "Sua postura sincera me informa que você, assim como nós, é guiado por {EventOath}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_579@EVENTPHRASE_STRIFE"
msgstr "Seu comportamento enérgico me informa que você, assim como nós, é guiado por {EventOath}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_579@TITLE"
msgstr "Encontro com os Fraternais {EventHouse.Name}"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_588@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} do {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} saúda você com respeito, como é o costume do {EventHouseRace}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_588@BODY_LORE"
msgstr "Então cabe a você saudar {EventHouseLord.FirstName} no estilo do seu {PlayerRace}. O gesto agrada o {EventHouseLord.Title}. \"Embora você e eu trilhemos caminhos diferentes, você o Caminho do {PlayerOath}, eu o Caminho do {EventOath}, a paz entre nossos povos pavimenta a estrada para a prosperidade e o triunfo, {PlayerLeader.FirstName}-kan.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_588@BUTTON_0"
msgstr "Inspecionar os Discípulos de {EventOath} em {EventHouse}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_588@BUTTON_1"
msgstr "\"Que {EventOath} guie suas mãos, {EventHouseLord.FirstName}-hem.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_588@TITLE"
msgstr "Encontro com o Heroico {EventHouse.Name}"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_589@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} do {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} cumprimenta você formalmente. A guarda de honra do {EventHouseRace} flanqueia <<P:EventHouseLord>>."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_589@BODY_LORE"
msgstr "\"Sua reputação o precede, {PlayerLeader.FirstName}-kan.\" O <<G:face^n,{EventHouseLord.Title}>> é rígido, mas há respeito sincero nos olhos de <<o:EventHouseLord>>. \"Não temos desavenças com você. Embora você seja um estranho aos nossos costumes, o juramento que fizemos nos obriga a recebê-lo como amigo.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_589@BUTTON_0"
msgstr "Inspecionar {EventHouse} e os honrados {EventHouseRace}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_589@BUTTON_1"
msgstr "Prometer voltar em outra ocasião."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_589@TITLE"
msgstr "Encontro com o Honorável {EventHouse.Name}"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_590@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} do {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} cumprimenta você com cautela. A mão de <<Co:EventHouseLord>> repousa no punho de sua espada."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_590@BODY_LORE"
msgstr "{EventHouseLord.FirstName} permanece ereto e imóvel, como uma estátua, mas observa cada um de seus movimentos com atenção. \"Até decidirmos se você representa uma ameaça ao nosso modo de vida, {PlayerLeader.FirstName}-do, acho melhor que mantenha distância.\" A voz de <<Co:EventHouseLord>> não traz ameaça, mas <<p:EventHouseLord>> fala com intenção firme e inabalável. \"Você escolhe o destino que o aguarda\", conclui o {EventHouseLord.Title}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_590@BUTTON_0"
msgstr "Inspecionar {EventHouse} com cautela."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_590@BUTTON_1"
msgstr "\"Nossos destinos certamente se cruzarão. Mas não hoje, {EventHouseLord.Title}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_590@TITLE"
msgstr "Encontro com os Rigorosos {EventHouse.Name}"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_591@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} do {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} encontra você com a arma de <<o:EventHouseLord>> erguida."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_591@BODY_LORE"
msgstr "\"Maldito seja este dia, em que você pisou em nossas terras, {PlayerLeader.FirstName}-uch\", cospe o {EventHouseLord.Title}. \"Juro aqui que destruirei você e seu {PlayerRace}.\" {EventHouseLord.FirstName} corta a palma da mão de <<o:EventHouseLord>> e deixa o sangue pingar no solo. \"Os {EventHouseRace} renegam tudo o que você representa, suposto {PlayerLeader.Title}!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_591@BUTTON_0"
msgstr "Inspecionar o insolente {EventHouse}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_591@BUTTON_1"
msgstr "\"Ou você quebra seu juramento, ou eu quebro {EventHouse}!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_591@TITLE"
msgstr "Encontro com o {EventHouse.Name} Belicoso"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_594@BODY_FOOTER"
msgstr "O {EventStackLeader} jura: \"{EventOath} nos enobrecerá, Sentinelas do {EventStructure}!\" Será que essas sentinelas podem ser convencidas a abandonar seu posto?"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_594@BODY_HEADER"
msgstr "Conforme seu exército se aproxima de um {EventStructure.Name}, vocês são interpelados por sentinelas de {EventHouse} estacionadas ali. \"Alto!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_594@BODY_LORE"
msgstr "Um {EventStackLeader} novato avança para avaliar sua companhia. \"Vocês não têm nada a fazer aqui! Este é o domínio do {EventRace} de {EventHouse}.\" Os outros guardas permanecem imóveis em formação. Seu comandante novato assente em aprovação, reconhecendo a disciplina deles, e então continua a ordenar: \"Não recuaremos! Como sentinelas de {EventHouse}, fizemos juramentos de lealdade.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_594@BUTTON_0"
msgstr "Prestar honra e respeito de [influence/] ao {EventHouse} para obter permissão de acesso."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_594@BUTTON_2"
msgstr "\"Você provou sua dedicação. É hora de voltar para casa com honra.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_594@BUTTON_3"
msgstr "\"Bom! Este foi seu teste. Você passou. Agora vá embora.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_594@BUTTON_4"
msgstr "\"Seu juramento será sua ruína! Às armas!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_594@BUTTON_5"
msgstr "Deixar as sentinelas leais de {EventHouse}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_594@TITLE"
msgstr "Sentinelas Inabaláveis"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_598@BODY_FOOTER"
msgstr "Os vitoriosos de {EventHouse} não deixarão o {EventStructure} antes que a celebração termine. O que você fará?"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_598@BODY_HEADER"
msgstr "Suas tropas visitam um {EventStructure}, mas encontram um exército de {EventHouse} reunido ao redor do cadáver de um grande {EventUnitB}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_598@BODY_LORE"
msgstr "O líder da companhia, um {EventStackLeader}, saúda vocês com cordialidade. \"Ah, chegaram na hora certa!\", exclama. \"Minhas tropas acabaram de derrotar este terrível {EventUnitB} em uma batalha épica. Segundo os preceitos do {EventRace}, devemos realizar um banquete comemorativo. Inimigos poderosos merecem muita honra, então estamos prestes a fazer uma grande festa! Não querem se juntar a nós e prestar respeito ao nosso alvo abatido?\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_598@BUTTON_0"
msgstr "Mover a celebração [food/] para {EventCity}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_598@BUTTON_2"
msgstr "Conjurar uma aparição do <<G:reanimation^n,EventUnitB>>."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_598@BUTTON_3"
msgstr "\"Vamos mostrar a esses fracotes de {EventHouse} como o {PlayerRace} comemora, tropas!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_598@BUTTON_4"
msgstr "Derrotá-los enquanto estão desprevenidos!"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_598@BUTTON_5"
msgstr "Permita que os soldados desfrutem da paz em celebração."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_598@BUTTON_6"
msgstr "Convide os guardas de [unitprod/] de {EventCity} para o banquete, a fim de elevar sua honra."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_598@TITLE"
msgstr "Banquete do Triunfo"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_599@BODY_FOOTER"
msgstr "Como você celebrará a apresentação do Campeão deste ano de {EventHouse}, que visita todos os benevolentes Godir do reino?"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_599@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} de {EventHouse} visita você com um formidável {EventUnit} a reboque. \"{PlayerLeader.Title}, tenho o orgulho de apresentar o Campeão deste ano!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_599@BODY_LORE"
msgstr "{EventHouseLord.FirstName} está ansioso para explicar do que se trata. \"Todos os anos, o Conselho de {EventOath} elege o mais devoto paradigma da cultura {EventHouse} entre os soldados mais experientes do nosso exército. Esse lutador é laureado como o Campeão deste ano: o consumado guerreiro {EventHouseRace}.\" O {EventHouseLord.Title} sorri. \"Como manda nossa tradição, visitamos todos os aliados para compartilhar as celebrações!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_599@BUTTON_0"
msgstr "Peça ao Campeão que treine os recrutas de [unitprod/] de {EventCity}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_599@BUTTON_1"
msgstr "Obtenha um fragmento do <<G:armor^n,EventUnit>> [item/] como símbolo de respeito."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_599@BUTTON_2"
msgstr "\"Eu PRECISO ter o seu Campeão [unit/] em minhas fileiras. [influence/]\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_599@BUTTON_3"
msgstr "\"Que a sua coragem inspire as minhas tropas! [morale/]\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_599@BUTTON_4"
msgstr "\"Compartilhe suas virtudes altruístas conosco! [goodact/]\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_599@BUTTON_5"
msgstr "\"Ensine aos meus {EventRace} como viver em harmonia [happiness/], Campeão.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_599@TITLE"
msgstr "A Turnê do Campeão"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_600@BODY_FOOTER"
msgstr "O {EventHouseLord.Title} aguarda sua sugestão sobre como lidar com os acusados de Quebra de Juramento."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_600@BODY_HEADER"
msgstr "{EventHouseLord} de {EventHouse} entra em contato com você, <<o:EventHouseLord>> o rosto traindo dúvida e desgosto. Prisioneiros acorrentados <<m:EventUnit>> estão atrás dele."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_600@BODY_LORE"
msgstr "\"Ó {PlayerLeader.Title}, estamos com dificuldade para decidir o destino desses Quebradores de Juramento,\" diz {EventHouseLord.FirstName}. <<Cp:EventHouseLord>> acena para os <<m:EventUnit>> atrás de <<P:EventHouseLord>>. \"Nós os pegamos em flagrante. {EventPhrase} Agora, precisamos decidir sua sentença.\" O {EventHouseLord.Title} sorri. \"Eu valorizo sua opinião, {PlayerLeader.FirstName}-kan. Que penitência deve recair sobre os Quebradores de Juramento?\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_600@BUTTON_0"
msgstr "\"Eu mesmo lidarei com esses <<m:EventUnit>>. [unit/]\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_600@BUTTON_1"
msgstr "Faça um exemplo dos <<m:EventUnit>>. Colha suas almas. [soul/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_600@BUTTON_2"
msgstr "\"Pelo meu juramento, [undevotedact/] restaure a honra desses Quebradores de Juramento. [allegiance/]\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_600@BUTTON_3"
msgstr "Exija que os <<m:EventUnit>> recebam um julgamento justo."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_600@BUTTON_4"
msgstr "\"Se a culpa deles for certa, um duelo judicial selará o destino de <<o:EventUnit>>.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_600@BUTTON_5"
msgstr "Tirem suas armas e armaduras. [item/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_600@EVENTPHRASE_HARMONY"
msgstr "Eles incitaram os {EventHouseRace} a pegar em armas contra você!"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_600@EVENTPHRASE_RIGHTEOUSNESS"
msgstr "Eles estavam roubando comida dos doentes e pobres."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_600@EVENTPHRASE_STRIFE"
msgstr "Eles depuseram suas armas para se tornarem criadores de porcos."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_600@TITLE"
msgstr "Traidores de Juramento"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_602@BODY_FOOTER"
msgstr "\"<<Ca:EventStructure>> está causando dissonância\", dizem em uníssono. \"Destrua-o para trazer harmonia ao reino. E ao seu coração.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_602@BODY_HEADER"
msgstr "\"Você reflete sobre suas ações passadas, muitas das quais se opuseram aos valores de {PlayerOath}, quando, de repente, dois <<m:EventUnit>> aparecem.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_602@BODY_LORE"
msgstr "Um {EventUnit}, de cor mais escura, observa você com gravidade. <<Cp:EventUnit>> então abre <<o:EventUnit>> boca para falar. \"Traidor de Juramento!\" <<Cp:EventUnit>> claramente não está acostumado a usar <<o:EventUnit>> voz. \"A dissonância ameaça a harmonia. Os erros em seus caminhos desequilibraram a si mesmo e o {PlayerRace}.\" O outro, de cor mais clara e sorrindo maliciosamente, continua com uma voz igualmente atípica: \"Felizmente, duas dissonâncias orquestradas podem ressoar e causar harmonia.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_602@TITLE"
msgstr "Harmonizando a Dissonância"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_603@BODY_FOOTER"
msgstr "Os <<m:EventUnit>> juntam as mãos, fecham os olhos e cantam: \"Repita nossas palavras. Renove seu juramento. Recupere a harmonia.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_603@BODY_HEADER"
msgstr "Você mal teve tempo de inspecionar os espólios do <<G:ruins^p,EventStructure>>, quando os <<m:EventUnit>> reaparecem, lado a lado."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_603@BODY_LORE"
msgstr "\"Admirável, simplesmente admirável,\" diz a variante mais clara, sorrindo com <<o:EventUnit>> voz incomum. <<Co:EventUnit>> contraparte mais escura ainda mantém <<o:EventUnit>> expressão severa, embora você veja um brilho de aprovação em <<o:EventUnit>> olhos. O {EventUnit} mais claro pisca e continua. \"A dissonância do {EventStructure} neutralizou a sua. Você está pronto.\" O {EventUnit} mais escuro finalmente fala: \"Pronto para a redenção.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_603@TITLE"
msgstr "Harmonizando a Dissonância: Consequências"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_614@BUTTON_0"
msgstr "Repita as palavras deles e renove seu juramento. [devotedact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_614@BUTTON_1"
msgstr "Em vez de seguir a harmonia, [undevotedact/] alimenta sua Fúria Berserker adormecida. [unitHero/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_614@BUTTON_2"
msgstr "Mate os <<m:EventUnit>> [evilact/] para esculpir um {EventItem} [item/] de suas carapaças. [undevotedact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_614@BUTTON_3"
msgstr "Tire a Armadura Abençoada dos <<m:EventUnit>> enquanto sua guarda está baixa."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_614@BUTTON_4"
msgstr "\"Vou harmonizar com o Astral de [arcana/]. [undevotedact/] Ele nunca me abandonou.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_614@BUTTON_5"
msgstr "\"Vou harmonizar com o Caos de [chaos/]. [undevotedact/] Ele nunca me abandonou.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_614@BUTTON_6"
msgstr "\"Prefiro harmonizar com o [matter/] Materium. [undevotedact/] Ele nunca me abandonou.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_614@BUTTON_7"
msgstr "\"Prefiro harmonizar com a [nature/] Natureza. [undevotedact/] Ela nunca me abandonou.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_614@BUTTON_8"
msgstr "\"Prefiro harmonizar com a [order/] Ordem. [undevotedact/] Ela nunca me abandonou.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_614@BUTTON_9"
msgstr "\"Prefiro harmonizar com a [shadow/] Sombra. [undevotedact/] Ela nunca me abandonou.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_615@BUTTON_0"
msgstr "\"Sábio <<m:EventUnit>>, minha determinação trará harmonia ao reino.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_615@BUTTON_1"
msgstr "\"Minha dissonância só aumentaria, <<m:EventUnit>>. Recuso sua oferta.[undevotedact/]\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_625@BODY_FOOTER"
msgstr "\"Para restaurar sua honra, ordeno que banam o {EventStackLeader}. Mas cuidado: a criatura se cerca de protetores poderosos.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_625@BODY_HEADER"
msgstr "Você reflete sobre suas ações passadas, muitas das quais se opuseram aos valores da {PlayerOath} quando, de repente, um {EventUnit} aparece."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_625@BODY_LORE"
msgstr "A criatura nobre observa você brevemente e então fala com uma voz severa, porém inspiradora: \"Eu o conheço, Quebrador de Juramentos. Você desonrou a si mesmo e ao seu {PlayerRace}. Ainda assim, nem tudo está perdido. Ofereço-lhe um teste. Meu inimigo, o traiçoeiro {EventStackLeader}, caça guerreiros inexperientes, prendendo-os em <<o:EventStackLeader>> teias de mentiras e enganos.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_625@BUTTON_0"
msgstr "\"Eu destruirei com justiça o terror que assombra este reino.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_625@BUTTON_1"
msgstr "\"Abandonei a Retidão, {EventUnit}. [undevotedact/] Deixe-me em paz.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_625@TITLE"
msgstr "Salvação Redentora"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@BODY_FOOTER"
msgstr "\"Toque minha coroa, faça o juramento, e o poder da Retidão fluirá novamente em suas veias.\" O {EventUnit} se curva."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@BODY_HEADER"
msgstr "O <<G:reign of terror^n,EventStackLeader>> termina quando você inspeciona a carapaça sem vida do <<o:EventStackLeader>>. O {EventUnit} retorna, banhado em luz gloriosa."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@BODY_LORE"
msgstr "Quando <<p:EventUnit>> fala, suas palavras <<o:EventUnit>> aquecem sua alma: \"Meu inimigo perverso foi derrotado. Você fez o que pedi e o que é justo. Lembre-se deste dia como o seu amanhecer de esperança e redenção.\" Uma aura dourada o envolve. A criatura nobre finalmente ordena:"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@BUTTON_0"
msgstr "Renove seu juramento, pela Retidão. [devotedact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@BUTTON_1"
msgstr "Esqueça seu juramento. [undevotedact/] Esta caçada despertou sua sede de morte. [unitHero/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@BUTTON_2"
msgstr "Mate [evilact/], o {EventUnit}, enquanto <<p:EventUnit>> abaixou a <<o:EventUnit>> cabeça. [xp/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@BUTTON_3"
msgstr "Roube os segredos do {GLOBAL.PROPERTIES.ACCURSED_ARMORS_GROUP.Hyperlink} do <<G:corpse^n,EventStackLeader>>."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@BUTTON_4"
msgstr "Abandone a Retidão. [undevotedact/] [arcana/] Astral será seu verdadeiro caminho."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@BUTTON_5"
msgstr "Abandone a Retidão. [undevotedact/] [chaos/] O Caos será seu verdadeiro caminho."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@BUTTON_6"
msgstr "Abandone a Retidão. [undevotedact/] [matter/] O Materium será seu verdadeiro caminho."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@BUTTON_7"
msgstr "Abandone a Retidão. [undevotedact/] [nature/] A Natureza será seu verdadeiro caminho."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@BUTTON_8"
msgstr "Abandone a Retidão. [undevotedact/] [order/] A Ordem será seu verdadeiro caminho."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@BUTTON_9"
msgstr "Abandone a Retidão. [undevotedact/] [shadow/] A Sombra será seu verdadeiro caminho."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@TITLE"
msgstr "Graça Salvadora: Consequências"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_627@BODY_FOOTER"
msgstr "\"Prove que o Conflito ainda governa suas ações, Quebrador de Juramentos,\" ruge o {EventUnit}. \"Conquiste {EventHouse} e eu restaurarei sua honra!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_627@BODY_HEADER"
msgstr "Você reflete sobre suas ações passadas, muitas das quais se opuseram aos valores de {PlayerOath} quando, de repente, um {EventUnit} se revela."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_627@BODY_LORE"
msgstr "Você ouve a voz do Dragão ressoar em sua mente, enquanto os olhos de <<o:EventUnit>> parecem perfurar seu coração. \"Você desviou seu {PlayerRace} e a si mesmo do caminho, Quebrador de Juramentos {PlayerLeader.FirstName}. O poder que antes possuía escapou por entre seus dedos.\" O {EventUnit} sorri. \"Poder que posso devolver a você, se assim desejar.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_627@BUTTON_0"
msgstr "\"Não vou decepcioná-lo, {EventUnit}! Pelo Conflito!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_627@BUTTON_1"
msgstr "\"Recuso, pois estou além da redenção.\" [undevotedact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_627@TITLE"
msgstr "Conflito dos Desafortunados"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_628@BODY_FOOTER"
msgstr "\"Agora é hora de reabraçar os princípios do Conflito, {PlayerLeader.Title}.\" O {EventUnit} ri. \"A menos que tenha outros planos.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_628@BODY_HEADER"
msgstr "Após reivindicar a vitória sobre {EventHouse}, o {EventUnit} aparece diante de você novamente. O sorriso pesaroso de <<Co:EventUnit>> transborda de satisfação."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_628@BODY_LORE"
msgstr "Os sons do tumulto que se ergue da cidade caída deleitam o Dragão. A voz de <<Co:EventUnit>> penetra seu crânio mais uma vez. \"Aah, a cacofonia do caos e da calamidade. Uma sinfonia para os servos da Discórdia!\" O {EventUnit} o aperta com o corpo sinuoso de <<o:EventUnit>>, aproximando a bocarra de <<o:EventUnit>> a centímetros do seu rosto. Os vapores que emanam da forma serpentina revigoram sua alma."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_628@BUTTON_0"
msgstr "Renove seu juramento, [devotedact/], para se tornar um agente do Conflito mais uma vez."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_628@BUTTON_1"
msgstr "Rejeite o juramento, [undevotedact/], e abrace seu desejo de queimar cidades. [unitHero/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_628@BUTTON_2"
msgstr "Tente subjugar o {EventUnit} à sua vontade."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_628@BUTTON_3"
msgstr "Abandone o Conflito. [undevotedact/] Use [arcana/] Astral como se fosse sua arma."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_628@BUTTON_4"
msgstr "Abandone o Conflito. [undevotedact/] Use [chaos/] Caos como se fosse sua arma."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_628@BUTTON_5"
msgstr "Abandone a Discórdia. [undevotedact/] Use [matter/] Materium como se fosse sua arma."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_628@BUTTON_6"
msgstr "Abandone a Discórdia. [undevotedact/] Use [nature/] Natureza como se fosse sua arma."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_628@BUTTON_7"
msgstr "Abandone a Discórdia. [undevotedact/] Use [order/] Ordem como se fosse sua arma."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_628@BUTTON_8"
msgstr "Abandone a Discórdia. [undevotedact/] Use [shadow/] Sombra como se fosse sua arma."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_628@TITLE"
msgstr "Discórdia Sofrida: Consequências"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1010@BODY_FOOTER"
msgstr "{IntriguePreviousRuler.TitleName} não pode ser salvo, mas você pode realizar uma ação antes que a Jaula de Ligação desabe."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1010@BODY_HEADER"
msgstr "Você derrotou {IntrigueVictimPlayerLeader.TitleName} e tomou <<o:IntrigueVictimPlayerLeader>> capital, em meio à regência de <<o:IntrigueVictimPlayerLeader>>. Seus exércitos invadem a antiga capital, adentrando seus salões principais."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1010@BODY_LORE"
msgstr "No fundo da cidade, você encontra uma masmorra escondida, onde vê {IntriguePreviousRuler.Title} adormecido em uma elaborada construção de rituais, sigilos arcanos e uma máquina que você reconhece como {GLOBAL.CageOfBindingLoreConcept.Hyperlink}. Infelizmente, o antigo {IntrigueVictimPlayerLeader.Title} havia preparado uma armadilha. Sem as devidas precauções, a armadilha é acionada e a jaula começa a se desintegrar, resultando, sem dúvida, na derrota de {IntriguePreviousRuler.TitleName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1010@BUTTON_0"
msgstr "Sobrecarregue o sifão para reivindicar seu poder [mana/] em uma explosão, destruindo a Jaula e banindo {IntriguePreviousRuler.FirstName} instantaneamente."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1010@BUTTON_2"
msgstr "Salve o que puder da Jaula antes que ela desabe para estudá-la. [knowledge/]."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1010@BUTTON_3"
msgstr "Guie espiritualmente [mana/] {IntriguePreviousRuler.TitleName} até Refúgio dos Magos [goodact/]."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1010@TITLE"
msgstr "Uma Regência Efêmera"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1034@BODY_FOOTER"
msgstr "Parece que o {IntriguePreviousRuler.Title} do {IntrigueVictimPlayerRace} foi substituído. Como isso pôde acontecer com <<P:IntriguePreviousRuler>>? Isso é uma ameaça... ou uma oportunidade para você?"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1034@BODY_HEADER"
msgstr "Enquanto pondera o reino, você é subitamente contatado por ninguém menos que um {CalamityDragonUnit}, que agora parece governar o {IntrigueVictimPlayerRace}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1034@BODY_LORE"
msgstr "Com uma voz trovejante, o {IntrigueVictimPlayerLeader.Title} anuncia: \"Contemplem a chegada de {IntrigueVictimPlayerLeader.Name}, a Calamidade encarnada! Os {IntrigueVictimPlayerRace} foram considerados dignos de minha orientação rumo a [hyperlink,GLOBAL.ChaosConcept]Caos[/hyperlink]. Junte-se a mim ou enfrente sua destruição!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1034@BUTTON_0"
msgstr "Devo estar preparado para o que está por vir."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1034@TITLE"
msgstr "Presságio de Destruição"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1038@BODY_FOOTER"
msgstr "\"Seu povo está se perguntando o que nosso grandioso Império está fazendo para deter a desgraça anunciada pelo {IntrigueVictimPlayerLeader.Title}. O que devemos dizer a eles?\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1038@BODY_HEADER"
msgstr "Você é abordado por um de seus conselheiros. \"Meu {PlayerLeader.Title}, há relatos de preocupação vindos das áreas mais distantes de seu império.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1038@BODY_LORE"
msgstr "\"Os aldeões temem que o {IntrigueVictimPlayerLeader.Title} anuncie o fim do mundo. Para um {GLOBAL.GodirLoreConcept.Hyperlink} como você, este reino pode ser apenas um pequeno ponto dentro do {GLOBAL.AstralSeaLoreConcept.Hyperlink}, mas para esses aldeões, este é seu lar e assim será por gerações. Eles querem saber se seu {PlayerLeader.Title} irá protegê-los e seus meios de vida.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1038@BUTTON_0"
msgstr "\"Não tema. Com minha autoridade, encontraremos um jeito de deter o {IntrigueVictimPlayerLeader.Title}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1038@BUTTON_1"
msgstr "\"O povo está exagerando, o {IntrigueVictimPlayerLeader.Title} veio para ficar\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1038@BUTTON_2"
msgstr "\"A calamidade é um arauto abençoado da mudança e do ciclo eterno! Regozije-se com sua glória!\" [chaosboon/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1038@TITLE"
msgstr "Anunciando o Fim"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1039@BODY_FOOTER"
msgstr "<<g:voice^n,IntriguePreviousRuler>> diz, amargurado: \"O {IntrigueVictimPlayerLeader.Title} me dominou, drenou meus poderes de {GLOBAL.GodirLoreConcept.Hyperlink} e tomou meu trono, MEU Império.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1039@BODY_HEADER"
msgstr "Você enviou investigações sobre o aparecimento do {IntrigueVictimPlayerLeader.Title}. Então, um visitante inesperado pede uma audiência."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1039@BODY_LORE"
msgstr "Ninguém menos que {IntriguePreviousRuler.TitleName} entra em sua corte. \"{PlayerLeader.TitleName},\" diz <<p:IntriguePreviousRuler>>, \"apresento-me diante de você sem armas. Notei que estava investigando o {IntrigueVictimPlayerLeader.Title}, e não precisa procurar mais. Trago todas as respostas que precisa, pois sou responsável pela presença de <<o:IntrigueVictimPlayerLeader>>. Em minha busca por [hyperlink,GLOBAL.ChaosConcept]Caos[/hyperlink], atraí o <<P:IntrigueVictimPlayerLeader>> para este reino...\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1039@BUTTON_0"
msgstr "Faça um gesto para que {IntriguePreviousRuler.FirstName} continue."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1039@TITLE"
msgstr "Anunciando o Fim: Consequências"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1049@BODY_FOOTER"
msgstr "\"Para combater a força da desolação, é preciso o poder do crescimento. Para enfraquecer o {IntrigueVictimPlayerLeader.Title}, deve-se reivindicar o {EventStructure}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1049@BODY_HEADER"
msgstr "\"Me dói admitir,\" continua {IntriguePreviousRuler.FirstName}, \"mas, sem meus poderes como {GLOBAL.GodirLoreConcept.Hyperlink}, precisarei de sua ajuda.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1049@BODY_LORE"
msgstr "\"Será tentador atacar o {IntrigueVictimPlayerLeader.Title} diretamente; é o que eu faria. Mas <<p:IntrigueVictimPlayerLeader>> é uma força de destruição, e derrotar <<P:IntrigueVictimPlayerLeader>> diretamente significaria o fim do meu Império. Então, peço que enfraqueça primeiro o domínio de <<o:IntrigueVictimPlayerLeader>> sobre [hyperlink,GLOBAL.ChaosConcept]Caos[/hyperlink], antes de derrotar <<P:IntrigueVictimPlayerLeader>>. É a única maneira de eu recuperar meu trono.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1049@BUTTON_0"
msgstr "\"Reivindicarei este {EventStructure}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1049@BUTTON_1"
msgstr "\"Não, acho que não vou fazer isso.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1049@BUTTON_4"
msgstr "\"Você foi um tolo em me procurar em seu momento mais fraco. [influence/] Aproveite o Vazio.\" [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1049@TITLE"
msgstr "Calamidade e Maravilha"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1050@BODY_FOOTER"
msgstr "Ao combinar <<g:chaos powers^p,IntriguePreviousRuler>> com os seus, você enfraquece o {IntrigueVictimPlayerLeader.Title} e pode canalizar algo mais..."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1050@BODY_HEADER"
msgstr "Você reivindicou o {EventStructure}. Ao olhar para ele, sente o poder primordial que emana dali."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1050@BODY_LORE"
msgstr "\"Vida após a desolação,\" diz {IntriguePreviousRuler.FirstName}, olhando para a árvore imensa. \"O poder puro do {EventStructure} deterá <<g:trail of destruction^n,IntrigueVictimPlayerLeader>> e enfraquecerá <<P:IntrigueVictimPlayerLeader>>. Isso me permitirá recuperar meu Império.\" <<Cp:IntriguePreviousRuler>> olha para você. \"Meus poderes são limitados, mas posso ajudá-lo a canalizar o poder do {EventStructure} para algo que ajude nossa empreitada.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1050@BUTTON_0"
msgstr "Convoque um exército para ajudá-lo! [unit/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1050@BUTTON_1"
msgstr "Convoque um exército de caos e fogo! [unit/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1050@BUTTON_2"
msgstr "Convoque um exército de protetores naturais! [unit/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1050@BUTTON_3"
msgstr "Convoque uma arma mágica! [item/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1050@BUTTON_4"
msgstr "Canalize a força vital da Árvore para expandir seu conhecimento! [knowledge/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1050@TITLE"
msgstr "Calamidade e Maravilha: Consequências"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1054@BODY_FOOTER"
msgstr "\"Alguns dos meus súditos mais leais fugiram de <<g:ashen grasp^n,IntrigueVictimPlayerLeader>> e oferecem-se para se juntar a você.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1054@BODY_HEADER"
msgstr "Com a força do(a) {EventStructure} ao seu lado, seu olhar se volta para a destruição causada pelo(a) {IntrigueVictimPlayerLeader.Title}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1054@BODY_LORE"
msgstr "Enquanto pondera possíveis estratégias, {IntriguePreviousRuler.FirstName} se junta a você. \"Para derrotar o(a) {IntrigueVictimPlayerLeader.Title}, você deve tomar {EventCity}. Não tenho prazer em tramar contra os meus próprios {IntrigueVictimPlayerRace}, mas como o(a) {IntrigueVictimPlayerLeader.Title} os controla, não vejo outra saída.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1054@BUTTON_0"
msgstr "\"Aceito a ajuda Deles.\" [unit/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1054@BUTTON_1"
msgstr "\"Recuso-me a participar mais dos seus fracassos.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1054@BUTTON_4"
msgstr "\"Meu exército é forte o suficiente.\" [morale/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1054@TITLE"
msgstr "Montanhas de Cinzas"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1055@BODY_FOOTER"
msgstr "O ódio brilha nos olhos de {IntriguePreviousRuler.FirstName}. \"{PlayerLeader.FirstName}, permita-me mostrar a este(a) {IntrigueVictimPlayerLeader.Title} o que acontece quando se tenta destronar um(a) {GLOBAL.GodirLoreConcept.Hyperlink}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1055@BODY_HEADER"
msgstr "Você conquistou {EventCity}. O(a) {IntrigueVictimPlayerLeader.Title} ruge e os(as) {IntrigueVictimPlayerRace} observam, contendo a respiração, enquanto {IntriguePreviousRuler.Name} marcha em direção à sala do trono."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1055@BODY_LORE"
msgstr "Lá, o {IntrigueVictimPlayerLeader.Title} flutua, {GLOBAL.GodirLoreConcept.Hyperlink} poderes do caos e da destruição diminuídos. <<Cp:IntrigueVictimPlayerLeader>> recua e mostra <<o:IntrigueVictimPlayerLeader>> presas, mas {IntriguePreviousRuler.FirstName} não hesita enquanto <<p:IntriguePreviousRuler>> avança. \"Você toma MINHA cidade, toma MEU trono, destrói MEU Império?!\" {IntriguePreviousRuler.FirstName} grita. \"Sua cobra miserável!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1055@BUTTON_0"
msgstr "Permitir que {IntriguePreviousRuler.FirstName} busque vingança por <<o:IntriguePreviousRuler>>, e <<o:IntriguePreviousRuler>> título."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1055@BUTTON_1"
msgstr "Destrua {IntriguePreviousRuler.FirstName}, subjugue os(as) {IntrigueVictimPlayerLeader.Title} e {IntrigueVictimPlayerRace}. [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1055@BUTTON_2"
msgstr "Destrua tanto {IntrigueVictimPlayerLeader.Title} quanto {IntriguePreviousRuler.Name}, causando o colapso do Império de <<o:IntriguePreviousRuler>>. [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1055@TITLE"
msgstr "Montanhas de Cinzas: Consequências"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1056@BODY_FOOTER"
msgstr "{IntrigueVictimPlayerLeader.TitleName} suspira enquanto <<p:IntrigueVictimPlayerLeader>> afunda em <<o:IntrigueVictimPlayerLeader>> trono. \"Acho que devo algo a você, não é?\" {IntrigueVictimPlayerLeader.FirstName} assente. \"Diga sua recompensa.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1056@BODY_HEADER"
msgstr "Você recua quando {IntrigueVictimPlayerLeader.FirstName} se aproxima do(a) {IntriguePreviousRuler.Title} com intenções assassinas."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1056@BODY_LORE"
msgstr "A cada passo, os(as) <<g:powers^p,IntrigueVictimPlayerLeader>> crescem e os(as) do(a) {IntriguePreviousRuler.Title} diminuem. Ainda assim, o(a) {IntriguePreviousRuler.Title} sorri, exibindo uma grande fileira de dentes. \"Está vendo agora, querido(a) {IntrigueVictimPlayerLeader.FirstName}, a promessa da verdadeira Calamidade? A decadência é o estado natural do mundo, só espere...\"[br/]Antes que <<p:IntriguePreviousRuler>> termine <<o:IntriguePreviousRuler>> monólogo, {IntrigueVictimPlayerLeader.FirstName} aniquila <<P:IntriguePreviousRuler>>. \"Cale. A. Boca.\" rosna {IntrigueVictimPlayerLeader.FirstName}. Sem mais delongas, <<p:IntrigueVictimPlayerLeader>> toma o trono de <<o:IntrigueVictimPlayerLeader>>."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1056@BUTTON_0"
msgstr "\"Preciso de um aliado neste reino. Junte-se a mim, rumo à vitória!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1056@BUTTON_1"
msgstr "\"Compartilhe seu conhecimento, [knowledge/], e prosperidade comigo, {IntrigueVictimPlayerLeader.FirstName}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1056@BUTTON_2"
msgstr "\"Não se pode confiar em você para governar. Torne-se meu vassalo, em vez disso.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1056@BUTTON_3"
msgstr "\"Você é fraco demais para ser chamado de Godir, e ainda enfrentarei você em guerra.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1056@TITLE"
msgstr "Das Cinzas"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1057@BODY_FOOTER"
msgstr "O(A) {IntrigueVictimPlayerLeader.Title} olha para você com curiosidade mórbida. \"Estou ligado(a) a você. O que um(a) {PlayerLeader.Title} pediria a um(a) {IntrigueVictimPlayerLeader.Title} derrotado(a)?\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1057@BODY_HEADER"
msgstr "{IntriguePreviousRuler.FirstName} se aproxima do(a) {IntrigueVictimPlayerLeader.Title} com intenções assassinas. O Dragão se enrola e sorri, exibindo as presas para a batalha iminente."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1057@BODY_LORE"
msgstr "Quando {IntriguePreviousRuler.FirstName} vira <<o:IntriguePreviousRuler>> de costas para você, você dá o sinal para seus soldados atacarem. O(A) ex-{IntriguePreviousRuler.Title} enfraquecido(a) não é páreo para sua traição. \"Seu... traidor(a) nojento...\" arqueja {IntriguePreviousRuler.FirstName}, antes que o(a) [hyperlink,GLOBAL.AstralVoidLoreConcept]Vazio[/hyperlink] leve <<P:IntriguePreviousRuler>>.[br/]O(A) {IntrigueVictimPlayerLeader.Title} ri, um trovão que faz rachaduras aparecerem nas paredes. \"Sim! Destruição, decadência... Calamidade! Você me venceu neste jogo do caos, ó {PlayerLeader.Title}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1057@BUTTON_0"
msgstr "Obrigue o(a) {IntrigueVictimPlayerLeader.Title} a compartilhar mais conhecimento [knowledge/] sobre a Calamidade."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1057@BUTTON_1"
msgstr "Exija um tributo em ouro [gold/] e magia [mana/]."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1057@BUTTON_2"
msgstr "Reivindique um grupo de soldados Amaldiçoados [unit/] ao seu lado."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1057@TITLE"
msgstr "Calamidade Conquistada"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1058@BODY_FOOTER"
msgstr "Enquanto o Império de {IntriguePreviousRuler.TitleName} desmorona, você pode reivindicar um objeto da sala do trono antes que ela desabe completamente."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1058@BODY_HEADER"
msgstr "{IntriguePreviousRuler.FirstName} se aproxima do(a) {IntrigueVictimPlayerLeader.Title} com intenções assassinas. O Dragão se enrola e sorri, exibindo as presas para a batalha iminente."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1058@BODY_LORE"
msgstr "Ninguém esperava que você ordenasse a seus soldados que atacassem em massa e enviassem ambos para o(a) {GLOBAL.AstralVoidLoreConcept.Hyperlink}. \"Você... ousa...\" arqueja {IntriguePreviousRuler.FirstName}, antes que <<p:IntriguePreviousRuler>> se desvaneça. O(A) {IntrigueVictimPlayerLeader.Title} apenas ruge de tanto rir enquanto seus exércitos cercam <<P:IntrigueVictimPlayerLeader>>. Com um golpe final de <<o:IntrigueVictimPlayerLeader>> cauda, <<p:IntrigueVictimPlayerLeader>> destrói o trono e derruba os pilares que sustentam a fortaleza, antes que <<p:IntrigueVictimPlayerLeader>> também se desvaneça."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1058@BUTTON_0"
msgstr "Reivindique o trono como lembrança de seu poder. [influence/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1058@BUTTON_1"
msgstr "Aproveite o(a) [evilact/] Caos [chaos/] desvanecente dos dois Governantes para aumentar seu poder [mana/]."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1058@BUTTON_2"
msgstr "Obrigue um grupo de soldados {EventRace} a se juntar a você. [unit/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1058@TITLE"
msgstr "Fim de um Império"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1059@BODY_FOOTER"
msgstr "O(a) {IntrigueVictimPlayerLeader.TitleName} se regozija com a destruição causada por <<p:IntrigueVictimPlayerLeader>>."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1059@BODY_HEADER"
msgstr "O(a) {IntrigueVictimPlayerLeader.Title} se ergue sob um céu que escurece. Nuvens de cinzas se acumulam e brasas rodopiam enquanto o ar fica pesado com a pressão."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1059@BODY_LORE"
msgstr "O dragão ruge: \"Que comece a Era da Guerra! Que cometas caiam! Que chova fogo! Contemplem a glória da Calamidade!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1059@BUTTON_0"
msgstr "Nós resistiremos."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1059@BUTTON_1"
msgstr "Regozije-se com a destruição! [chaosboon/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1059@TITLE"
msgstr "Sombra da Entropia"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1060@BODY_FOOTER"
msgstr "{IntriguePreviousRuler.TitleName} parte para {GLOBAL.MagehavenLoreConcept.Hyperlink} enquanto o Império de <<o:IntriguePreviousRuler>> desmorona. Você pode reivindicar um objeto da sala do trono em ruínas antes que ela desabe completamente."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1060@BODY_HEADER"
msgstr "Você derrotou o(a) {IntrigueVictimPlayerLeader.Title} sem maiores precauções. {IntriguePreviousRuler.FirstName} aparece diante de você. \"O que você fez?!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1060@BODY_LORE"
msgstr "Em um último ato de desafio, o(a) {IntrigueVictimPlayerLeader.Title} solta uma gargalhada e alça voo para destruir o trono do(a) {IntrigueVictimPlayerRace}, antes de se dissipar em {GLOBAL.AstralVoidLoreConcept.Hyperlink}.[br/]{IntriguePreviousRuler.FirstName} observa a destruição. \"Meu(inha) {IntrigueVictimPlayerRace}, meu trono... Tudo se foi.\" <<Cp:IntriguePreviousRuler>> mal consegue conter sua fúria. \"Eu reconstruirei em outro lugar. Esta não é o fim da minha história.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1060@BUTTON_0"
msgstr "Reivindique o trono como lembrança do seu poder. [influence/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1060@BUTTON_1"
msgstr "Aproveite [evilact/] o Caos [chaos/] que se esvai dos dois Governantes para aumentar sua tropa de guerra [unitprod/]."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1060@BUTTON_2"
msgstr "Force um grupo de soldados {EventRace} a se juntar a você. [unit/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1060@TITLE"
msgstr "Fim de um Império"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1125@BODY_FOOTER"
msgstr "\"Aqueles que governam com fé e [hyperlink,GLOBAL.OrderConcept]Ordem[/hyperlink] nada têm a temer. Em breve, entrarei em contato com aqueles dignos de redenção.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1125@BODY_HEADER"
msgstr "Perto ou longe, este reino já viu guerra e conflito. Enquanto você reflete sobre isso, um novo Governante anuncia <<r:IntrigueVictimPlayerLeader>>."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1125@BODY_LORE"
msgstr "\"Saudações, {GLOBAL.GodirLoreConcept.Hyperlink}. Dada a situação atual do reino, {IntriguePreviousRuler.TitleName} foi destituído(a) do governo de <<o:IntriguePreviousRuler>> até que os inúmeros problemas sejam resolvidos. Em <<o:IntriguePreviousRuler>> lugar, o manto da autoridade sobre todo(a) {IntrigueVictimPlayerRace} foi concedido a mim, como {IntrigueVictimPlayerLeader.Title}. Pelos poderes sagrados a mim conferidos, doravante julgarei todos os que aqui governam.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1125@BUTTON_0"
msgstr "\"Finalmente, um devoto da Ordem [order/] como eu!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1125@BUTTON_1"
msgstr "\"Não reconheço outra autoridade além da minha!\" [imperium/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1125@BUTTON_2"
msgstr "\"Muito bem...\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1125@TITLE"
msgstr "Dia do Juízo"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1129@BODY_FOOTER"
msgstr "Passar por essas provações é a única maneira de trazer {IntriguePreviousRuler.TitleName} de volta..."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1129@BODY_HEADER"
msgstr "O(a) {IntrigueVictimPlayerLeader.Title} entra em contato com você. \"Este reino é um poço de caos e hostilidade, e os(as) {GLOBAL.GodirLoreConcept.Hyperlink} aqui falharam em impor a [hyperlink,GLOBAL.OrderConcept]Ordem[/hyperlink].\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1129@BODY_LORE"
msgstr "\"Foram exatamente essas circunstâncias que me obrigaram a intervir. No entanto, as forças da fé não deixam de ser misericordiosas. Você, {PlayerLeader.TitleName}, recebeu a oportunidade de provar que é um(a) Governante digno(a), o que me libertará do meu dever como {IntrigueVictimPlayerLeader.Title}. Para isso, você deverá provar que pode restaurar a ordem neste reino. Aceita essas provações?\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1129@BUTTON_0"
msgstr "\"Aceito esta provação.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1129@BUTTON_1"
msgstr "\"Recuso essas provações, seu animal insolente!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1129@BUTTON_2"
msgstr "um(a)"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1129@TITLE"
msgstr "Provações da Redenção"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1130@BODY_FOOTER"
msgstr "\"A [hyperlink,GLOBAL.OrderConcept]Ordem[/hyperlink] deveria ser sua própria recompensa, mas reconheço que velhos padrões não são facilmente quebrados. Por isso, estou lhe dando a autoridade para escolher uma recompensa à sua escolha.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1130@BODY_HEADER"
msgstr "Você fez amizade com um(a) {GLOBAL.IndependentCityConcept}. O(a) {IntrigueVictimPlayerLeader.Title} aparece mais uma vez e assente. \"Talvez você ainda prove ser digno(a).\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1130@BODY_LORE"
msgstr "\"No grande esquema, muitos(as) {GLOBAL.GodirLoreConcept.Hyperlink} esquecem o poder das formas de vida inferiores. No entanto, deve-se tentar encontrar alianças até mesmo com aqueles que podem ser inicialmente ignorados.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1130@BUTTON_0"
msgstr "Escolha uma recompensa monetária [gold/]."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1130@BUTTON_2"
msgstr "Decida por uma bênção sobre {EventCity}. [food/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1130@BUTTON_3"
msgstr "Recuse qualquer recompensa [influence/], você faz isso pelo seu império, não por mais ninguém."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1130@TITLE"
msgstr "Honrar os Humildes"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1134@BODY_FOOTER"
msgstr "\"Destrua o(a) {EventStructure}, prove que pode tanto proferir a sentença quanto empunhar a espada do carrasco.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1134@BODY_HEADER"
msgstr "O(a) {IntrigueVictimPlayerLeader.Title} murmura: \"Você passou na primeira provação, agora deve provar seu zelo.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1134@BODY_LORE"
msgstr "\"A [hyperlink,GLOBAL.OrderConcept]Ordem[/hyperlink] equilibra as escalas da harmonia e da violência justa. Algumas criaturas são simplesmente irrecuperáveis. Há momentos em que se deve purificar o reino daqueles que pretendem causar mal. Essa será sua próxima provação, para provar seu valor como guardião deste reino.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1134@BUTTON_0"
msgstr "\"Aceito esta provação.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1134@BUTTON_1"
msgstr "\"Recuso esta provação. Você não manda em mim!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1134@TITLE"
msgstr "Aniquile os Ímpios"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1135@BODY_FOOTER"
msgstr "\"Com essa demonstração de poder e julgamento, você conquistou uma recompensa, {PlayerLeader.TitleName}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1135@BODY_HEADER"
msgstr "O {IntrigueVictimPlayerLeader.Title} aparece mais uma vez. \"Você purificou o reino de uma de suas ameaças. Muito bem.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1135@BODY_LORE"
msgstr "\"Os poderes de [hyperlink,GLOBAL.OrderConcept]Ordem[/hyperlink] me convocam a reinos que precisam do meu julgamento. É gratificante ver que você é uma promessa como seu guardião. Tornar-se a mão divina que dá, mas que castiga quando necessário... É um manto de honra, mas também de obrigação.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1135@BUTTON_0"
msgstr "Perguntar para saber mais sobre a Ordem e seus méritos."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1135@BUTTON_3"
msgstr "Escolher uma bênção de [happiness/] para todos os seus {EventRace}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1135@BUTTON_4"
msgstr "Decidir que qualquer recompensa deve ir para aqueles que lutam em seu nome. [morale/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1135@TITLE"
msgstr "Aniquile os Ímpios: Consequências"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1139@BODY_FOOTER"
msgstr "\"Decida se este Governante merece sua misericórdia ou sua ira.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1139@BODY_HEADER"
msgstr "\"Agora, para sua última prova,\" diz o {IntrigueVictimPlayerLeader.Title}, \"você deve equilibrar a balança da justiça entre benevolência e derramamento de sangue.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1139@BODY_LORE"
msgstr "\"Este reino precisa de paz, que pode ser alcançada pelas bênçãos da fé ou pela força da subjugação. Como {GLOBAL.GodirLoreConcept.Hyperlink}, você deve ponderar os méritos de ambos e escolher sabiamente entre eles. Há Governantes neste reino que precisam ser julgados, e você o fará.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1139@BUTTON_0"
msgstr "\"Aceito esta prova.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1139@BUTTON_4"
msgstr "\"Recuso esta prova. Eu decido quem é digno do meu julgamento!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1139@TITLE"
msgstr "Balança da Justiça"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1140@BODY_FOOTER"
msgstr "\"Meu dever como {IntrigueVictimPlayerLeader.Title} está cumprido. Deixo a decisão final sobre o destino de {IntriguePreviousRuler.TitleName} em suas mãos.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1140@BODY_HEADER"
msgstr "Você julgou e agiu sobre o destino de um Governante. Agora, o {IntrigueVictimPlayerLeader.Title} aparece mais uma vez. \"Muito bem.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1140@BODY_LORE"
msgstr "\"Ao decidir entre derrota e diplomacia, você trouxe um senso de paz e [hyperlink,GLOBAL.OrderConcept]Ordem[/hyperlink] ao reino, provando ser um guardião justo e capaz.\" O {IntrigueVictimPlayerLeader.Title} faz uma reverência profunda, <<o:IntrigueVictimPlayerLeader>> chifres quase tocam o chão. \"Você é digno do título de {GLOBAL.GodirLoreConcept.Hyperlink}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1140@BUTTON_0"
msgstr "\"Vá, então, e permita que o {IntriguePreviousRuler.Name} retorne.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1140@BUTTON_1"
msgstr "\"Fique, {IntrigueVictimPlayerLeader.FirstName}. Posso precisar de sua orientação.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1140@BUTTON_2"
msgstr "\"{IntriguePreviousRuler.Name} é indigno. Vá embora, o <<o:IntriguePreviousRuler>> Império está perdido.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1140@TITLE"
msgstr "Escamas da Justiça: Consequências"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1141@BODY_FOOTER"
msgstr "{IntrigueVictimPlayerLeader.TitleName} suspira enquanto <<p:IntrigueVictimPlayerLeader>> se acomoda no trono <<o:IntrigueVictimPlayerLeader>>. \"Diga sua recompensa.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1141@BODY_HEADER"
msgstr "O {IntriguePreviousRuler.Title} assente. \"Que assim seja. Adeus, {PlayerLeader.TitleName}.\" Com um clarão de luz, <<p:PreviousRuler>> desaparece, e {IntrigueVictimPlayerLeader.TitleName} surge com uma centelha."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1141@BODY_LORE"
msgstr "\"O que... o que aconteceu?\" diz {IntrigueVictimPlayerLeader.FirstName}, tropeçando. \"Eu estava aqui, governando meu Império, até que uma voz grandiosa discursou sobre meus supostos fracassos... Me prendeu no {GLOBAL.AstralVoidLoreConcept.Hyperlink} e então... disse que você havia provado seu valor e pedido meu retorno. Não sei o que fez... mas suponho que lhe devo minha gratidão.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1141@BUTTON_0"
msgstr "\"Precisarei de um aliado neste reino. Junte-se a mim, rumo à vitória!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1141@BUTTON_1"
msgstr "\"Compartilhe seu conhecimento [knowledge/] e prosperidade [gold/] [mana/] comigo, {IntrigueVictimPlayerLeader.FirstName}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1141@BUTTON_2"
msgstr "\"Após sua ausência, não se pode confiar em você para governar. Torne-se meu vassalo.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1141@BUTTON_3"
msgstr "\"Você é fraco demais para ser chamado de Godir, e ainda enfrentarei você em guerra.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1141@TITLE"
msgstr "Justiça, Cumprida"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1142@BODY_FOOTER"
msgstr "\"Suponho que a única questão restante é como nossas alianças devem ser, {PlayerLeader.TitleName}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1142@BODY_HEADER"
msgstr "O {IntrigueVictimPlayerLeader.Title} se anima. \"Você pede que eu fique? Que... incomum. Suponho que poderia.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1142@BODY_LORE"
msgstr "O {IntrigueVictimPlayerLeader.Title} fica em silêncio por um momento, então assente. \"Está feito. {IntriguePreviousRuler.TitleName} permanecerá no {GLOBAL.AstralVoidLoreConcept.Hyperlink} para encontrar <<o:IntriguePreviousRuler>> próprio caminho, como ordena. E eu permanecerei neste reino como o novo Governante do {IntrigueVictimPlayerRace}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1142@BUTTON_0"
msgstr "\"Precisarei de um aliado neste reino. Junte-se a mim, rumo à vitória!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1142@BUTTON_1"
msgstr "\"Compartilhe seu conhecimento [knowledge/] e prosperidade [gold/] [mana/] comigo, {IntrigueVictimPlayerLeader.FirstName}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1142@BUTTON_2"
msgstr "\"Você ainda não está pronto para governar plenamente. Torne-se meu vassalo.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1142@BUTTON_3"
msgstr "\"Como novo Governante, precisará encontrar seu próprio caminho, com uma nova chance.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1142@TITLE"
msgstr "Só Nós"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1143@BODY_FOOTER"
msgstr "Os {IntrigueVictimPlayerRace} partem para suas cidades por seu decreto. Resta apenas decidir o destino de sua antiga capital."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1143@BODY_HEADER"
msgstr "O {IntrigueVictimPlayerLeader.Title} assente. \"Que assim seja. Partirei, e {IntriguePreviousRuler.TitleName} permanecerá no {GLOBAL.AstralVoidLoreConcept.Hyperlink}, conforme seu decreto.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1143@BODY_LORE"
msgstr "\"Este reino fica em suas mãos, {PlayerLeader.TitleName}. Governe-o bem.\" Com uma última reverência, o {IntrigueVictimPlayerLeader.Title} desaparece."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1143@BUTTON_0"
msgstr "Reivindique o trono como um lembrete do seu poder. [influence/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1143@BUTTON_1"
msgstr "Exija que alguns {IntrigueVictimPlayerRace} se juntem a você. [unit/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1143@BUTTON_2"
msgstr "Que sua benevolência e poder sejam conhecidos [happiness/] em todas as suas cidades."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1143@TITLE"
msgstr "Começar do Zero"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1144@BODY_FOOTER"
msgstr "{IntrigueWarVictimPlayerLeader.TitleName} fica indignado e tenta protestar, mas nada pode ser feito contra a declaração de {IntrigueVictimPlayerLeader.FirstName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1144@BODY_HEADER"
msgstr "O {IntrigueVictimPlayerLeader.Title} tem outro anúncio a fazer."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1144@BODY_LORE"
msgstr "\"{IntrigueWarVictimPlayerLeader.TitleName} falhou como soberano, <<o:IntrigueWarVictimPlayerLeader>> governo manchado por incompetência e falta de fé. Por decreto do {IntrigueVictimPlayerLeader.Title}, a coroa de <<o:IntrigueWarVictimPlayerLeader>> é confiscada. A guerra será <<o:IntrigueWarVictimPlayerLeader>> sentença, enquanto os exércitos da justiça marcham sobre o reino de <<o:IntrigueWarVictimPlayerLeader>>. Que todos saibam que o reinado de <<o:IntrigueWarVictimPlayerLeader>> termina em fogo e aço, para o bem de todos.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1144@BUTTON_0"
msgstr "Que assim seja."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1144@TITLE"
msgstr "O Martelo Cai"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1145@BODY_FOOTER"
msgstr "Embora não possa trazer {ItnriguePreviousRuler.Name} de volta, você pode reivindicar qualquer coisa do {IntrigueVictimPlayerLeader.Title} em declínio."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1145@BODY_HEADER"
msgstr "Você derrotou {IntrigueVictimPlayerLeader.TitleName} e tomou a capital de <<o:IntrigueVictimPlayerLeader>>. O {IntrigueVictimPlayerLeader.Title} aparece mais uma vez, com a postura arrogante de <<o:IntrigueVictimPlayerLeader>> diminuída. \"Isso é um ultraje!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1145@BODY_LORE"
msgstr "<<Co:IntrigueVictimPlayerLeader>> entra em pânico conforme <<p:IntrigueVictimPlayerLeader>> se esvai. \"Sua insolência não ficará sem resposta! A [hyperlink,GLOBAL.OrderConcept]Ordem[/hyperlink] prevalecerá... Deve! A justiça precisa ser feita... Ainda não terminei! Não!\" Com um último brilho de luz, o {IntrigueVictimPlayerLeader.Title} desaparece no {GLOBAL.AstralSeaLoreConcept.Hyperlink}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1145@BUTTON_0"
msgstr "Canalize o [mana/] <<g:fading zeal^n,IntrigueVictimPlayerLeader>> para aprimorar sua própria magia."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1145@BUTTON_1"
msgstr "Receba o {IntrigueVictimPlayerRace} em {EventCity}. [population/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1145@BUTTON_2"
msgstr "Pegue os chifres de <<o:IntrigueVictimPlayerLeader>> para exibi-los como símbolo do seu poder. [influence/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1145@TITLE"
msgstr "Você e Que Exército"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1156@BODY_FOOTER"
msgstr "Com <<g:final words to you^p,IntrigueVictimPlayerLeader>>, toda esperança de trazer {IntriguePreviousRuler.Name} de volta se perde. \"Você foi julgado e considerado indigno.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1156@BODY_HEADER"
msgstr "Você não conseguiu convencer o {IntrigueVictimPlayerLeader.Title} de suas nobres intenções. <<Cp:IntrigueVictimPlayerLeader>> entra em contato com você com desprezo mal disfarçado."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1156@BODY_LORE"
msgstr "\"Seja por intenção ou incompetência, você provou ser indigno do seu manto como {GLOBAL.LeaderConcept}. Pela autoridade que me foi conferida como {IntrigueVictimPlayerLeader.Title}, decreto sua remoção deste reino para o bem maior. Que isto sirva como uma declaração oficial de {GLOBAL.WarConcept} contra você e todos os outros soberanos indignos que ousarem reivindicar domínio aqui.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1156@BUTTON_0"
msgstr "\"Que assim seja!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1156@TITLE"
msgstr "Não Serás Julgado"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1233@BODY_FOOTER"
msgstr "O {IntriguePreviousRuler.Title} do {IntrigueVictimPlayerRace} perdeu uma partida com o {IntrigueVictimPlayerLeader.Title} e foi... substituído."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1233@BODY_HEADER"
msgstr "Em um momento de descanso, você de repente sente um calafrio, quando um {ReaperUnit} aparece diante de você."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1233@BODY_LORE"
msgstr "O {ReaperUnit} sem rosto sussurra com uma voz ao mesmo tempo imensamente alta e suave como o farfalhar de folhas mortas: \"{IntriguePreviousRuler.TitleName} me convocou. <<Cp:IntriguePreviousRuler>> pensou que <<p:IntriguePreviousRuler>> poderia me acorrentar, me enganar, mas nenhuma corrente pode prender a morte em si. {IntriguePreviousRuler.Name} apostou com <<o:IntriguePreviousRuler>> [hyperlink,GLOBAL.SoulsLoreConcept]Alma[/hyperlink] e perdeu. E assim eu a reivindico, e as [hyperlink,GLOBAL.SoulsLoreConcept]Almas[/hyperlink] do {IntrigueVictimPlayerRace}. Não tenho nome... mas podem me chamar de {IntrigueVictimPlayerLeader.FirstName}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1233@BUTTON_0"
msgstr "É preciso jogar com as cartas que se recebe..."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1233@TITLE"
msgstr "Uma Aposta com a Morte"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1237@BODY_FOOTER"
msgstr "Se quiser investigar o {IntriguePreviousRuler.Title} e o {IntrigueVictimPlayerLeader.Title}, precisará separar fato de ficção."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1237@BODY_HEADER"
msgstr "Rumores sobre o destino de {IntriguePreviousRuler.TitleName} e do {ReaperUnit} que agora governa o {IntrigueVictimPlayerRace} chegam à sua corte. Seus conselheiros estão divididos."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1237@BODY_LORE"
msgstr "\"Nenhum {GLOBAL.GodirLoreConcept.Hyperlink} está acima das forças primordiais da morte, nem mesmo {IntriguePreviousRuler.TitleName},\" diz um deles. \"Eu digo que deixemos <<P:IntriguePreviousRuler>> aprender a lição de <<o:IntriguePreviousRuler>> no [hyperlink,GLOBAL.AstralVoidLoreConcept]Vazio[/hyperlink].\"[br/]Outro conselheiro é mais calculista. \"O {IntrigueVictimPlayerLeader.Title} é uma lenda entre muitos. Saber mais pode ajudá-lo a evitar o mesmo destino de {IntriguePreviousRuler.FirstName}. Além disso, pense no favor que <<p:IntriguePreviousRuler>> lhe devia...\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1237@BUTTON_0"
msgstr "\"Vou desvendar os mistérios da morte.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1237@BUTTON_1"
msgstr "\"Deixe {IntriguePreviousRuler.FirstName} apodrecer no Vazio, tenho outros assuntos para tratar.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1237@TITLE"
msgstr "Morte e Lendas"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1238@BODY_FOOTER"
msgstr "\"Nossa teoria é que, para derrotar o {IntrigueVictimPlayerLeader.Title}, é preciso desafiar <<P:IntrigueVictimPlayerLeader>> para um jogo de sua própria criação.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1238@BODY_HEADER"
msgstr "Você investigou o {IntrigueVictimPlayerLeader.Title} e o destino que recaiu sobre {IntriguePreviousRuler.TitleName}. Um de seus estudiosos se aproxima com os resultados."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1238@BODY_LORE"
msgstr "\"É amplamente sabido que as {GLOBAL.SoulsLoreConcept.Hyperlink} dos falecidos viajam para {GLOBAL.TheWellLoreConcept.Hyperlink}, mas as crenças sobre como e por quê diferem entre—\" O estudioso nota seu olhar. \"...Desvio do assunto. O {IntrigueVictimPlayerLeader.Title} disse que <<p:IntrigueVictimPlayerLeader>> chegou a governar o {IntrigueVictimPlayerRace} por meio de uma aposta. Acredita-se amplamente que a morte tem uma forte conexão com o destino... e, portanto, os <<m:ReaperUnit>> adoram jogos de azar, pois sempre vencem.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1238@BUTTON_0"
msgstr "\"Continue...\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1238@TITLE"
msgstr "Morte e Lendas: Consequências"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1242@BODY_FOOTER"
msgstr "\"Acreditamos firmemente que o {EventStructure} possui um artefato que o ajudará contra o {IntrigueVictimPlayerLeader.Title}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1242@BODY_HEADER"
msgstr "O estudioso assente, feliz por você ainda não ter dispensado <<P:EventUnit>>. \"Durante nossa busca, também investigamos mitos e lendas de outros Impérios.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1242@BODY_LORE"
msgstr "\"Foram as lendas sobre os {IntrigueRandomRace} que nos levaram ao {EventStructure}. Aparentemente, ele esconde a prisão de um ladrão lendário que enganou a morte e roubou <<o:IntrigueWonderHero>> alma. Que ironia ser aprisionado depois de escapar da morte... Dizem que <<p:IntrigueWonderHero>> ainda carrega o segredo do maior truque que <<p:IntrigueWonderHero>> já realizou.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1242@BUTTON_0"
msgstr "\"Muito bem, vou explorar este '{EventStructure}'.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1242@BUTTON_1"
msgstr "\"Não vou mais perseguir mitos e lendas. Recuso.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1242@TITLE"
msgstr "Enganando o Destino"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1243@BODY_FOOTER"
msgstr "\"Com o {IntrigueItem} em seu poder, você está pronto para confrontar o {IntrigueVictimPlayerLeader.Title}...\" diz seu erudito. \"A única questão é como.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1243@BODY_HEADER"
msgstr "Você encontrou {IntrigueItem}, um artefato mágico que permite virar qualquer jogo a seu favor. Seu erudito está extasiado."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1243@BODY_LORE"
msgstr "\"Então as lendas eram verdadeiras! Que glorioso, que dia grandioso para nós, historiadores!\" comemora o erudito. \"Ahem, mas, é claro, o mais importante é que isso permite desafiar o {IntrigueVictimPlayerLeader.Title} para um jogo de dados. Pelo que ouvi, <<p:IntrigueVictimPlayerLeader>> certamente aceitará!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1243@BUTTON_0"
msgstr "\"Com certeza você está prestes a me contar.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1243@BUTTON_7"
msgstr "\"Me colocar nessa posição vulnerável? Absurdo! Vou encontrar outra maneira de lidar com isso.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1243@TITLE"
msgstr "Enganando o Destino: Consequências"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1247@BODY_FOOTER"
msgstr "\"Para desafiar o {IntrigueVictimPlayerLeader.Title}, você precisará levar o {IntrigueItem} consigo... e se lançar no {GLOBAL.AstralVoidLoreConcept.Hyperlink}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1247@BODY_HEADER"
msgstr "Seu erudito se mexe, desconfortável. \"Pensei em como lhe dizer isso, meu {PlayerLeader.Title}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1247@BODY_LORE"
msgstr "\"Para desafiar o {IntrigueVictimPlayerLeader.Title} adequadamente, precisamos dar a <<P:IntrigueVictimPlayerLeader>> a impressão de que você está à <<o:IntrigueVictimPlayerLeader>> mercê. Só então <<p:IntrigueVictimPlayerLeader>> aceitará qualquer aposta sua.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1247@BUTTON_0"
msgstr "\"...Muito bem. Se devo encarar a morte, então morrerei!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1247@BUTTON_1"
msgstr "\"Eu, nessa posição vulnerável? Jamais! Vou encontrar outra maneira de lidar com isso.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1247@TITLE"
msgstr "Não Tema o Ceifador"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1248@BODY_FOOTER"
msgstr "\"Aceito seu desafio, {PlayerLeader.TitleName}. Que este momento decida seu destino. O que você aposta?\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1248@BODY_HEADER"
msgstr "Você se vê à beira do {GLOBAL.AstralVoidLoreConcept.Hyperlink}. Ao sentir a escuridão puxando-o, o {IntrigueVictimPlayerLeader.Title} aparece."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1248@BODY_LORE"
msgstr "Mesmo na escuridão, a forma de <<o:IntrigueVictimPlayerLeader>> é claramente visível. \"Não sinto medo nem raiva em você\", suspira <<o:IntrigueVictimPlayer>>. \"Você recebe minha presença. Por quê?\" Quando desafia <<P:IntrigueVictimPlayerLeader>> para um jogo de dados, a voz de <<o:IntrigueVictimPlayerLeader>> muda levemente, quase com... empolgação. \"Um jogo de azar, de Destino, não consigo resistir.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1248@BUTTON_0"
msgstr "\"Aposto minha alma pelo retorno de {IntriguePreviousRuler.TitleName}, que governa o {IntrigueVictimPlayerRace} por direito.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1248@BUTTON_1"
msgstr "\"Aposto minha alma por uma aliança com você, ó {IntrigueVictimPlayerLeader.Title}!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1248@BUTTON_2"
msgstr "\"Aposto minha alma para que você deixe este reino.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1248@TITLE"
msgstr "Não Tema o Ceifador: Confronto"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1249@BODY_FOOTER"
msgstr "Você é imediatamente contatado por {IntrigueVictimPlayerLeader.TitleName}. \"Você... me trouxe de volta. Pensei que este seria o meu fim. Eu lhe devo, {PlayerLeader.FirstName}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1249@BODY_HEADER"
msgstr "Você conjura o {IntrigueItem}. O {IntriguePreviousRuler.Title} observa atentamente enquanto ele rola e cai sobre o símbolo no qual você apostou sua alma."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1249@BODY_LORE"
msgstr "O {IntriguePreviousRuler.Title} assente. \"Um artefato tão interessante... A vida em si é um eterno jogo para escapar das garras da morte, mas aqueles que vencem muitas vezes descobrem que seu prêmio azeda com o tempo. Você venceu hoje, {PlayerLeader.TitleName}. Nos encontraremos novamente.\" Com isso, <<p:IntriguePreviousRuler>> se dissipa e você se vê de volta à sua capital."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1249@BUTTON_0"
msgstr "\"Sejamos aliados, então, e unamos forças em nossa busca pela vitória!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1249@BUTTON_1"
msgstr "\"Recebo minha recompensa em ouro [gold/] e mana [mana/].\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1249@BUTTON_2"
msgstr "\"Sua negligência lhe custou sua reivindicação sobre este reino. Torne-se meu vassalo, em vez disso.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1249@BUTTON_3"
msgstr "\"Eu só o trouxe de volta para derrotá-lo com minhas próprias mãos!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1249@TITLE"
msgstr "Morte e Vida"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1250@BODY_FOOTER"
msgstr "Agora você é aliado de {IntrigueVictimPlayerLeader.Title}. Qual seria seu primeiro pedido a este amigo sombrio?"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1250@BODY_HEADER"
msgstr "Você conjura o {IntrigueItem}. O {IntrigueVictimPlayerLeader.Title} observa atentamente enquanto ele rola e cai sobre o símbolo no qual você apostou sua alma."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1250@BODY_LORE"
msgstr "O {IntriguePreviousRuler.Title} assente. \"Um artefato tão interessante... A vida em si é um eterno jogo para escapar das garras da morte, mas aqueles que vencem muitas vezes descobrem que seu prêmio azeda com o tempo. Você venceu hoje, {PlayerLeader.TitleName}. Eu o chamarei de... aliado.\" Você pisca e se vê de volta à sua capital."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1250@BUTTON_0"
msgstr "Peça a {IntrigueVictimPlayerLeader.Title} para compartilhar mais conhecimento [knowledge/] sobre a Morte."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1250@BUTTON_1"
msgstr "Solicite um presente de ouro [gold/] e magia [mana/]."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1250@BUTTON_2"
msgstr "Garanta que todo o reino saiba de sua aliança com a própria morte. [influence/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1250@TITLE"
msgstr "Como Velhos Amigos"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1251@BODY_FOOTER"
msgstr "Enquanto {IntrigueVictimPlayerLeader.Title} se dissipa, o antigo Império de {IntriguePreviousRuler.TitleName} desmorona, um símbolo da inevitabilidade."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1251@BODY_HEADER"
msgstr "Você conjura o {IntrigueItem}. O {IntrigueVictimPlayerLeader.Title} observa atentamente enquanto ele rola e cai sobre o símbolo no qual você apostou sua alma."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1251@BODY_LORE"
msgstr "O {IntrigueVictimPlayerLeader.Title} assente. \"Um artefato tão interessante... A vida em si é um eterno jogo para escapar das garras da morte, mas aqueles que vencem muitas vezes descobrem que seu prêmio azeda com o tempo. Você venceu hoje, {PlayerLeader.TitleName}. Nos encontraremos novamente.\" Com isso, <<p:IntrigueVictimPlayerLeader>> se dissipa e você se vê de volta à sua capital."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1251@BUTTON_0"
msgstr "Reivindique o trono como um lembrete do seu poder. [influence/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1251@BUTTON_1"
msgstr "Aproveite a força enfraquecida do(a) {IntrigueVictimPlayerLeader.Title} [shadow/] para reunir energia arcana. [mana/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1251@BUTTON_2"
msgstr "Explore o conhecimento mortal [knowledge/] para aprimorar o seu próprio."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1251@TITLE"
msgstr "Até Nos Encontrarmos Novamente"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1252@BODY_FOOTER"
msgstr "O(a) <<G:head^n,ReaperUnit>> se inclina enquanto um jogo de azar <<o:IntrigueVictimPlayerLeader>> se desenrola. \"O destino decidiu. O(a) {IntrigueWarVictimPlayerLeader.TitleName} vive... por enquanto.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1252@BODY_FOOTER@REAPERLOST"
msgstr "O <<G:head^n,ReaperUnit>> se inclina enquanto <<o:IntrigueVictimPlayerLeader>> jogo de azar se desenrola. \"O destino decidiu. Os {GLOBAL.SoulsLoreConcept.Hyperlink} de {IntrigueWarVictimPlayerLeader.TitleName} e <<o:IntrigueWarVictimPlayerLeader>> {IntrigueWarVictimPlayerRace} estão perdidos... E eu os reivindicarei.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1252@BODY_HEADER"
msgstr "Outro(a) {GLOBAL.LeaderConcept}, {IntrigueWarVictimPlayerLeader.TitleName}, recentemente se retirou para o(a) {GLOBAL.AstralVoidLoreConcept.Hyperlink}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1252@BODY_LORE"
msgstr "Com um suspiro tão cansado quanto perturbadoramente extasiado, o(a) {IntrigueVictimPlayerLeader.Title} aparece mais uma vez. \"Até mesmo {GLOBAL.GodirLoreConcept.Hyperlink} imploram por suas vidas imortais quando encaram o espelho eterno do Vazio.\" Um(a) {ReaperObject} aparece nos dedos ossudos de <<o:IntrigueVictimPlayerLeader>>. \"Diante da Morte, o(a) {IntrigueWarVictimPlayerLeader.Title} escolheu apostar o destino de <<o:IntrigueWarVictimPlayerLeader>> [hyperlink,GLOBAL.SoulsLoreConcept]alma[/hyperlink]...\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1252@BUTTON_0"
msgstr "Muito bem..."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1252@TITLE"
msgstr "Um Jogo do Destino"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1253@BODY_FOOTER"
msgstr "Você pode reivindicar um objeto da sala do trono antes que ela desabe completamente."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1253@BODY_HEADER"
msgstr "Você derrotou o(a) {IntrigueVictimPlayerLeader.Title}. O(a) autoproclamado(a) representante da morte olha friamente para você enquanto <<p:IntrigueVictimPlayerLeader>> se retira para o(a) {GLOBAL.AstralVoidLoreConcept.Hyperlink}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1253@BODY_LORE"
msgstr "Com a derrota do(a) {IntrigueVictimPlayerLeader.Title} e do(a) {IntrigueVictimPlayerRace}, toda esperança de trazer {IntriguePreviousRuler.TitleName} de volta está perdida. Os(as) {IntrigueVictimPlayerRace} vagueiam sem seu senhor da morte, e o Império desmorona."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1253@BUTTON_0"
msgstr "Reivindique o trono como um lembrete do seu poder. [influence/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1253@BUTTON_1"
msgstr "Aproveite [evilact/] a força enfraquecida da morte [shadow/] para reunir energia arcana. [mana/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1253@BUTTON_2"
msgstr "Explore o conhecimento mortal [knowledge/] para aprimorar o seu próprio."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1253@TITLE"
msgstr "Morte, Derrotada"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1261@BODY_FOOTER"
msgstr "O(a) {IntrigueVictimPlayerLeader.Title} o(a) desafia para um jogo de azar. De um lado: ressurreição instantânea. Do outro: uma [hyperlink,GLOBAL.WarConcept]guerra[/hyperlink] com a morte..."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1261@BODY_HEADER"
msgstr "Você foi derrotado(a) e agora se encontra à beira do(a) {GLOBAL.AstralVoidLoreConcept.Hyperlink}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1261@BODY_LORE"
msgstr "Enquanto sente a escuridão puxando você, o(a) {IntrigueVictimPlayerLeader.Title} aparece mais uma vez, flutuando no oceano de trevas. \"Até mesmo {GLOBAL.GodirLoreConcept.Hyperlink} temem a imagem refletida no espelho eterno do Vazio,\" suspira o(a) {IntrigueVictimPlayerLeader.Title}. Um(a) {ReaperObject} aparece nos dedos ossudos de <<o:IntrigueVictimPlayerLeader>>, brilhando na escuridão eterna. \"E você, {PlayerLeader.Name}? Apostaria seu destino por uma chance de reviver?\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1261@BUTTON_0"
msgstr "Arrisque-se."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1261@BUTTON_1"
msgstr "Apegue-se à vida e ao reino natural para influenciar as probabilidades."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1261@BUTTON_2"
msgstr "Canalize seu controle sobre a morte para influenciar as suas."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1261@BUTTON_3"
msgstr "Caos e sorte são o seu forte. Vire as probabilidades a seu favor."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1261@BUTTON_4"
msgstr "Invoque sua fé e zelo para determinar as probabilidades a seu favor."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1261@BUTTON_5"
msgstr "Fortaleça os laços com seu corpo físico e determine as probabilidades a seu favor."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1261@BUTTON_6"
msgstr "Este jogo é magia, e você o controla. Manipule os fluxos arcanos a seu favor."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1261@BUTTON_7"
msgstr "Recuse-se a apostar pela sua alma."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1261@TITLE"
msgstr "Seu Jogo do Destino"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1283@BODY_FOOTER"
msgstr "Enquanto seus soldados se preparam para derrubar a muralha, o som de mortos-vivos inquietos pode ser ouvido do outro lado."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1283@BODY_HEADER"
msgstr "Ao entrar no(a) {EventStructure}, o(a) {EventHero.FirstName} parece comum, mas não demora para encontrar uma parede simples marcada com um símbolo."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1283@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Ao entrar no(a) {EventStructure}, ele(a) parece comum, mas não demora para encontrar uma parede simples marcada com um símbolo."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1283@BODY_LORE"
msgstr "{EventHero.FirstName} reconhece o símbolo como um conjunto de dados. Porém, atrás da porta, há apenas um beco sem saída, com uma frase entalhada na parede: \"Cuidado com a tumba dos ladrões sem nome;[br/]Pois negaram até à morte o que lhe era devido;[br/]Que se engasguem com a poeira de seu butim;[br/]E que o descanso da morte sempre os iluda.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1283@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Você reconhece o símbolo como um conjunto de dados. Porém, atrás da porta, há apenas um beco sem saída, com uma frase entalhada na parede: \"Cuidado com a tumba dos ladrões sem nome;[br/]Pois negaram até à morte o que lhe era devido;[br/]Que se engasguem com a poeira de seu butim;[br/]E que o descanso da morte sempre os iluda.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1283@BUTTON_0"
msgstr "\"Derrubem a muralha, subjugaremos qualquer resistência!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1283@BUTTON_2"
msgstr "Abandonar o(a) {EventStructure}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1283@BUTTON_3"
msgstr "Use seu conhecimento de Sombra para enfraquecer o que quer que se agite lá dentro antes de abrir."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1283@BUTTON_4"
msgstr "Prepare seu exército [mana/] para o que quer que surja."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1283@TITLE"
msgstr "O(a) {EventStructure}"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1284@BODY_FOOTER"
msgstr "\"Pode ficar com essas riquezas, meu(minha) {IntrigueItem}. Eu só quero sair desta tumba.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1284@BODY_HEADER"
msgstr "Você derrotou {EnemyUnit.Name}, que surgiu de uma sala oculta dentro do(a) {EventStructure}. <<Cp:EnemyUnit>> ergue uma mão. \"Eu me rendo... eu me rendo.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1284@BODY_LORE"
msgstr "\"Peço desculpas, a promessa de liberdade me deixou animado. Mas nunca fui um lutador, entende? Mais um trapaceiro. Até enganei a morte. \" <<Cp:EnemyUnit>> revela um objeto mágico. \"Este é o(a) {IntrigueItem}, um dado carregado de magia. Meu maior trunfo... que se tornou minha maldição. Eu conseguia escapar de qualquer prisão, arrombar qualquer fechadura... então me enterraram, sem fechaduras ou prisões... sem nem a morte para escapar.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1284@BUTTON_0"
msgstr "\"Seja livre, então, {EnemyUnit.FirstName}. Pelo decreto de Godir, seu castigo está cumprido.\" [influence/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1284@BUTTON_2"
msgstr "\"Eu poderia usar um ladrão imortal como você ao meu lado.\" [unit/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1284@BUTTON_4"
msgstr "\"Eu poderia usar um ladrão imortal como você ao meu lado.\" [unit/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1284@BUTTON_5"
msgstr "\"Tenho uma nova cripta em {EventCity} com seu nome gravado.\" [unit/] [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1284@TITLE"
msgstr "O(a) {EventStructure}: Consequências"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1298@BODY_FOOTER"
msgstr "Folhas fumegantes caem suavemente sobre seu exército enquanto eles evitam a debandada de animais que fogem de seus antigos lares."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1298@BODY_HEADER"
msgstr "Seu exército se aproxima do(a) {EventStructure}, sua copa de folhas brilhando em vermelho por causa de um incêndio abaixo."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1298@BODY_LORE"
msgstr "Lá dentro, {EventHero.FirstName} vê várias criaturas Amaldiçoadas causando destruição, lideradas por um(a) {EnemyUnit}. Elas trabalham arduamente para incendiar as próprias raízes do(a) {WorldTreeStructure}. Parecem se deleitar com a destruição e a calamidade que causam, perseguindo os animais que tentam fugir do inferno."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1298@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Lá dentro, você vê várias criaturas Amaldiçoadas causando destruição, lideradas por um(a) {EnemyUnit}. Elas trabalham arduamente para incendiar as próprias raízes do(a) {WorldTreeStructure}. Parecem se deleitar com a destruição e a calamidade que causam, perseguindo os animais que tentam fugir do inferno."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1298@BUTTON_0"
msgstr "Ataque os inimigos Amaldiçoados!"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1298@BUTTON_2"
msgstr "Fuja da árvore em chamas."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1298@BUTTON_4"
msgstr "Use seu poder mágico, [mana/], para proteger seu exército das chamas antes de atacar."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1298@TITLE"
msgstr "O(a) {EventStructure}"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1299@BODY_FOOTER"
msgstr "Com o tempo, essa árvore prevalecerá e se renovará. Suas folhas farfalham, quase como se estivessem gratas a você."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1299@BODY_HEADER"
msgstr "{EventHero.Name} derrotou as criaturas Amaldiçoadas que estavam incendiando o(a) {WorldTreeStructure}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1299@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você derrotou as criaturas Amaldiçoadas que estavam incendiando o(a) {WorldTreeStructure}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1299@BODY_LORE"
msgstr "Seu exército tenta apagar as chamas, mas as raízes fumegantes levarão muito tempo para se recuperar. No entanto, conforme a fumaça se dissipa, alguns animais já começam a retornar. O exército amaldiçoado enviado por {IntrigueVictimPlayerLeader.TitleName} não obteve sucesso."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1299@BUTTON_0"
msgstr "Convoque reforços, [unitprod/], para ajudar a apagar completamente a árvore. [goodact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1299@BUTTON_4"
msgstr "Capture alguns desses animais para o seu exército. [unit/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1299@BUTTON_5"
msgstr "Colete os galhos quebrados para obter {EventCity}. [production/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1299@TITLE"
msgstr "O {EventStructure}: Consequências"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1334@BODY_FOOTER"
msgstr "\"Prove para mim que você pode ser [hyperlink,GLOBAL.AlignmentConcept]Compassivo[/hyperlink] com todos que habitam este reino.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1334@BODY_HEADER"
msgstr "\"Agora, para sua última prova,\" diz o {IntrigueVictimPlayerLeader.Title}, \"você deve demonstrar verdadeira virtude.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1334@BODY_LORE"
msgstr "\"Este reino precisa estar em paz, e a verdadeira paz só pode ser alcançada por meio da compaixão. Você deve governar e servir. Deve punir, mas também ajudar. Deve julgar, mas também perdoar. Prove para mim que, como {GLOBAL.GodirLoreConcept.Hyperlink}, você é capaz de incorporar essas virtudes divinas.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1334@BUTTON_0"
msgstr "\"Aceito esta prova.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1334@BUTTON_4"
msgstr "\"Recuso esta prova. Eu decido quem merece meu julgamento!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1334@BUTTON_5"
msgstr "\"A história não é escrita pelos benevolentes, mas por aqueles que os esmagam!\" [evilact/] [influence/] [happiness/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1334@TITLE"
msgstr "Compaixão Divina"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1335@BODY_FOOTER"
msgstr "\"Meu dever como {IntrigueVictimPlayerLeader.Title} está cumprido. Deixo a decisão final sobre o destino de {IntriguePreviousRuler.TitleName} em suas mãos.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1335@BODY_HEADER"
msgstr "Você alcançou um alto nível de {GLOBAL.AlignmentConcept.Hyperlink} e provou sua compaixão. Agora, o {IntrigueVictimPlayerLeader.Title} aparece mais uma vez. \"Muito bem.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1335@BODY_LORE"
msgstr "\"Ao demonstrar sua benevolência e perdão, você trouxe uma sensação de paz e [hyperlink,GLOBAL.OrderConcept]Ordem[/hyperlink] ao reino, e provou ser um guardião justo e capaz.\" O {IntrigueVictimPlayerLeader.Title} faz uma reverência profunda, <<o:IntrigueVictimPlayerLeader>> chifres quase tocam o chão. \"Você é digno do título de {GLOBAL.GodirLoreConcept.Hyperlink}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1335@BUTTON_0"
msgstr "\"Vá embora, então, e permita que {IntriguePreviousRuler.Name} retorne.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1335@BUTTON_1"
msgstr "\"Fique, {IntrigueVictimPlayerLeader.FirstName}. Posso usar sua orientação.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1335@BUTTON_2"
msgstr "\"{IntriguePreviousRuler.Name} é indigno. Vá embora, o <<o:IntriguePreviousRuler>> Império está perdido.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1335@TITLE"
msgstr "Compaixão Divina: Consequências"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_669@BUTTON_2"
msgstr "Encerre todas as investigações sobre {IntrigueVictimPlayer}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_672@BUTTON_3"
msgstr "\"Você é fraco demais para ser chamado de Godir, e eu verei o fim do seu reinado.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_673@BUTTON_1"
msgstr "\"Você é um covarde e um tolo. Garantirei que todos os governantes saibam.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_673@BUTTON_2"
msgstr "\"Compartilhe seu conhecimento [knowledge/] comigo, e tudo será esquecido.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_673@BUTTON_3"
msgstr "\"Meu objetivo era apenas ajudá-lo. Espero fazer isso no futuro.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_674@BUTTON_1"
msgstr "Quebre a maldição sobre {IntrigueVictimPlayer}, fortaleça seus laços com <<P:IntrigueVictimPlayer>>."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_674@BUTTON_2"
msgstr "Deixe {IntrigueVictimPlayer} como <<p:IntrigueVictimPlayer>> está, guardando o segredo de {IntrigueCulpritPlayer.FirstName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_674@BUTTON_3"
msgstr "Deixe {IntrigueVictimPlayer} como <<p:IntrigueVictimPlayer>> está, exija um suborno [gold/] pelo seu silêncio."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_675@BUTTON_1"
msgstr "Quebre a maldição sobre {IntrigueVictimPlayer}, reivindique o {EventItem} e seu conhecimento para si."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_675@BUTTON_2"
msgstr "Destrua o {EventItem}, liberte {IntrigueVictimPlayer}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_730@BODY_FOOTER"
msgstr "Parece que o {IntriguePreviousRuler.Title} do {IntrigueVictimPlayerRace} foi... substituído. Como isso pôde acontecer com <<P:IntriguePreviousRuler>>? Será um perigo... ou uma oportunidade para você?"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_730@BODY_HEADER"
msgstr "Enquanto pondera sobre o reino, você é subitamente contatado por ninguém menos que um {BalorUnit}, que agora parece governar o {IntrigueVictimPlayerRace}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_730@BODY_LORE"
msgstr "Antes que possa exigir uma explicação, o novo {IntrigueVictimPlayerLeader.Title} sorri. \"Mortais e {GLOBAL.GodirLoreConcept.Hyperlink}! O Império de {IntriguePreviousRuler.Name} agora está sob nova administração. Curve-se a mim, o grandioso {IntrigueVictimPlayerLeader.Name}, e desespere, pois a fúria e a ira de {GLOBAL.ObbadothLoreConcept.Hyperlink} chegaram!\" O sorriso de <<Co:IntrigueVictimPlayerLeader>> se torna sombrio enquanto <<p:IntrigueVictimPlayerLeader>> corta a conexão."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_730@BUTTON_0"
msgstr "O tempo dirá."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_730@TITLE"
msgstr "Um Anúncio Perturbador"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_745@BODY_FOOTER"
msgstr "Salvar as pessoas do acampamento de refugiados próximo pode ser sua única maneira de saber mais sobre o {IntrigueVictimPlayerLeader.TitleName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_745@BODY_HEADER"
msgstr "Você desvia o foco do cidadão caído do {IntrigueVictimPlayerRace} para sons de luta próximos."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_745@BODY_LORE"
msgstr "Você percebe que é um acampamento de refugiados que fugiram do Império do {IntrigueVictimPlayerLeader.Title}. Eles estão sendo emboscados por forças demoníacas e agora lutam por suas vidas."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_745@BUTTON_0"
msgstr "Envie um grupo para salvar os refugiados."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_745@BUTTON_1"
msgstr "Recuse-se a tomar parte nisso."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_745@TITLE"
msgstr "Tomada Demoníaca: Refúgio"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_746@BODY_FOOTER"
msgstr "Se deseja investigar mais, o {EventStructure} é seu próximo alvo."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_746@BODY_HEADER"
msgstr "Você tem uma nova pista em suas investigações sobre o {IntrigueVictimPlayerLeader.Title}. <<Cp:IntrigueVictimPlayerLeader>> foi convocado em um {EventStructure}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_746@BODY_LORE"
msgstr "Investigar o {EventStructure} pode fornecer mais pistas sobre como deter o {IntrigueVictimPlayerLeader.Title} e descobrir quem mais está envolvido... ou encontrar maneiras de lucrar com essa situação."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_746@BUTTON_0"
msgstr "Investigar e destruir o {EventStructure}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_746@BUTTON_1"
msgstr "Encerrar as investigações e usar qualquer evidência coletada contra o {IntrigueVictimPlayer.Name}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_746@TITLE"
msgstr "Invocação Infernal"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_747@BODY_FOOTER"
msgstr "{IntrigueVictimPlayerLeader.TitleName} rosna: \"Pare com suas investigações ou vou mostrar o que acontece quando se brinca com fogo infernal!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_747@BODY_HEADER"
msgstr "Após derrotar qualquer resistência no {EventStructure}, suas tropas e estudiosos vasculham a área envolvida no aparecimento do {IntrigueVictimPlayerLeader.TitleName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_747@BODY_LORE"
msgstr "\"Este foi de fato o local de uma invocação poderosa, meu {PlayerLeader.Title}\", diz seu estudioso. \"Runas infernais descrevem um acordo entre uma invocação e um banimento para {GLOBAL.ObbadothLoreConcept.Hyperlink}, e de um Contrato Arcano entre o {BalorUnit} e ninguém menos que {IntrigueCulpritPlayerLeader.TitleName}!\"[br/][br/]Logo depois, você é contatado pelo {IntrigueVictimPlayerLeader.Title} <<r:IntrigueVictimPlayerLeader>>. \"Então o tolo {GLOBAL.GodirLoreConcept.Hyperlink} insiste em meter <<o:PlayerLeader>> nariz nos nossos assuntos.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_747@BUTTON_0"
msgstr "\"Não vou me submeter a ameaças!\" [influence/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_747@TITLE"
msgstr "Invocação Infernal: Consequências"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_753@BUTTON_1"
msgstr "\"Fogo? Você vai saber o que é fogo quando eu terminar com você!\" [chaosboon/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_753@BUTTON_2"
msgstr "\"Vou mandar você de volta para Obbadoth, criatura imunda!\" [orderboon/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_753@BUTTON_3"
msgstr "\"Nem mesmo o fogo infernal derrete minhas muralhas. Experimente, demônio!\" [materiumboon/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_753@BUTTON_4"
msgstr "\"Você pode ameaçar queimar e destruir, mas a vida sempre prevalece!\" [natureboon/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_753@BUTTON_5"
msgstr "\"Você não passa de uma invocação falha. Enfrente-me, e resolverei essa anomalia.\" [astralboon/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_753@BUTTON_6"
msgstr "\"Até o fogo morre quando é privado. Vou fazer você passar fome.\" [shadowboon/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_753@BUTTON_7"
msgstr "\"Vou considerar isso...\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_754@BODY_FOOTER"
msgstr "\"Se você é o salvador que o {IntrigueVictimPlayerRace} procura, marcarei um local no seu mapa onde poderá encontrar meus companheiros.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_754@BODY_HEADER"
msgstr "\"Meu {PlayerLeader.Title}, achamos que você vai querer ouvir isso.\" Seus guardas trazem à frente um {IntrigueVictimUnit} do {IntrigueVictimPlayerRace}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_754@BODY_LORE"
msgstr "<<Cp:IntrigueVictimUnit>> se ajoelha diante de você, com <<o:IntrigueVictimUnit>> roupas esfarrapadas e sujas. \"Represento um grupo de refugiados do {IntrigueVictimPlayerRace}. Nosso {IntriguePreviousRuler.Title} sucumbiu a forças além do nosso controle, e agora os lacaios do {IntrigueVictimPlayerLeader.Title} e do <<o:IntrigueVictimPlayerLeader>> atormentam nosso Império. Alguns de nós sabem mais sobre o que aconteceu, mas, por segurança, não me contaram os detalhes.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_754@BUTTON_0"
msgstr "Enviar um grupo para encontrar os refugiados."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_754@BUTTON_1"
msgstr "Recusar-se a se envolver nos assuntos de outros Impérios."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_754@TITLE"
msgstr "Tomada Demoníaca"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_755@BODY_FOOTER"
msgstr "O cidadão cai no chão, incapaz de compartilhar mais informações. Mais sons de luta podem ser ouvidos por perto..."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_755@BODY_HEADER"
msgstr "Você enviou uma comitiva para encontrar o \"Cidadão Preocupado\" que entrou em contato sobre o {IntrigueVictimPlayerLeader.Title} do {IntrigueVictimPlayerRace}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_755@BODY_LORE"
msgstr "Pouco depois de chegar, um <<IntrigueVictimUnit{man/woman}>> surge, fazendo uma reverência profunda. \"Salve, grandioso {PlayerLeader.Title}. Preciso ser rápido, pois temo ter sido seguido. Nosso {IntriguePreviousRuler.Title} foi banido e substituído por um Demônio vil de {GLOBAL.ObbadothLoreConcept.Hyperlink}. Eu sei a loca-\" Antes que <<p:IntrigueVictimUnit>> possa terminar a <<o:IntrigueVictimUnit>> frase, <<p:IntrigueVictimUnit>> é derrubado por uma garra infernal."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_755@BUTTON_0"
msgstr "Mude seu foco para os sons de luta próximos."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_755@TITLE"
msgstr "Tomada Demoníaca: Cidadão Preocupado"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_771@BODY_FOOTER"
msgstr "\"Há poder e riquezas escondidos por trás das artes que outros consideram 'proibidas'. Afaste-se agora, e podemos tornar isso vantajoso para você...\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_771@BODY_HEADER"
msgstr "Você descobriu que {IntrigueCulpritPlayerLeader.TitleName} invocou e assinou um Pacto Demoníaco com o {IntrigueVictimPlayerLeader.Title}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_771@BODY_LORE"
msgstr "O Pacto é a chave para o poder compartilhado deles. Por meio de seus espiões e contatos, você descobre que ele está escondido em {EventCity}. Antes que possa refletir mais, você é contatado por ninguém menos que {IntrigueCulpritPlayerLeader.Name} <<r:IntrigueCulpritPlayerLeader>>. \"Não sejamos precipitados, {PlayerLeader.FirstName}. Certamente você vê o potencial em aliados como eu e o {IntrigueVictimPlayerLeader.Title}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_771@BUTTON_0"
msgstr "\"Vou acabar com seu plano, {IntrigueCulpritPlayerLeader.FirstName}!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_771@BUTTON_1"
msgstr "\"Muito bem. Vou parar de investigar você, por uma recompensa.\" [evilact/] [gold/] [knowledge/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_771@TITLE"
msgstr "Lidar com o {IntrigueVictimPlayerLeader.Title}"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_772@BODY_FOOTER"
msgstr "O Pacto em si é um artefato mágico poderoso. Com ele, você poderia alterar o destino deste reino..."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_772@BODY_HEADER"
msgstr "Dentro da fortaleza principal de {EventCity}, você reivindica o Pacto do {IntrigueVictimPlayerLeader.Title}. Seu significado completo fica claro para você."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_772@BODY_LORE"
msgstr "Após uma \"troca\" forçada entre uma criatura de {GLOBAL.ObbadothLoreConcept.Hyperlink} e um {GLOBAL.LeaderConcept.Hyperlink} deste reino, a criatura invocada recebe poderes {GLOBAL.GodirLoreConcept.Hyperlink} do invocador e eles permanecerão em um {GLOBAL.DSAllianceConcept.Hyperlink}, até que o reino seja conquistado. Então, a criatura invocada será libertada para invadir outros reinos com <<o:IntrigueVictimPlayerLeader>> novos escravos, deixando as cinzas deste reino para o invocador: {IntrigueCulpritPlayerLeader.FirstName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_772@BUTTON_0"
msgstr "Destruir o Pacto e a Aliança Infernal, banindo o {IntrigueVictimPlayerLeader.Title} e trazendo de volta {IntriguePreviousRuler.TitleName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_772@BUTTON_1"
msgstr "Usar seu conhecimento [chaosboon/] do Pacto, juntar-se à Aliança entre {IntrigueVictimPlayerLeader.FirstName} e {IntrigueCulpritPlayerLeader.FirstName}. [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_772@BUTTON_2"
msgstr "Manter o Pacto, usá-lo para reivindicar poderes Infernais [knowledge/] [mana/] para si mesmo! [chaosboon/] [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_772@TITLE"
msgstr "Lidar com o {IntrigueVictimPlayerLeader.Title}: Consequências"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_781@BODY_FOOTER"
msgstr "\"Obrigado, {PlayerLeader.TitleName}. Agora que voltei, devo reparar os erros cometidos contra o meu {IntrigueVictimPlayerRace}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_781@BODY_HEADER"
msgstr "Com um feito impressionante de proeza Godir, você bane o {BalorUnit} que havia usurpado {IntrigueVictimPlayerLeader.TitleName} e traz {IntrigueVictimPlayerLeader.FirstName} de volta."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_781@BODY_LORE"
msgstr "Pouco tempo depois, você é contatado por {IntrigueVictimPlayerLeader.Name} <<r:IntrigueVictimPlayerLeader>>. \"Entendo que estou em dívida com você, {PlayerLeader.TitleName}. O mínimo que lhe devo é contar minha versão da história. Durante um momento de trégua, fui banido para {GLOBAL.ObbadothLoreConcept.Hyperlink} por magias vis, e desde então só conheci fogo e conflito. Temia nunca mais voltar, até que você reverteu a magia que me baniu.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_781@BUTTON_0"
msgstr "\"Sejamos aliados, então, e unamos forças em nossa busca pela vitória!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_781@BUTTON_1"
msgstr "\"Exijo minha recompensa em ouro [gold/] e mana [mana/]. Sua vingança é problema seu.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_781@BUTTON_2"
msgstr "\"Sua negligência lhe custou a reivindicação deste reino. Torne-se meu vassalo, em vez disso.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_781@BUTTON_3"
msgstr "\"Você é fraco demais para ser chamado de Godir, e eu verei o fim do seu reinado.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_781@TITLE"
msgstr "Dívida Infernal"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_783@BODY_FOOTER"
msgstr "Você tem a oportunidade de exigir um favor de {IntrigueVictimPlayerLeader.FirstName} ou {IntrigueCulpritPlayerLeader.FirstName}. O que você escolhe?"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_783@BODY_HEADER"
msgstr "Você altera o Contrato entre {IntrigueVictimPlayerLeader.FirstName} e {IntrigueCulpritPlayerLeader.FirstName}, adicionando-se ao acordo inquebrável."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_783@BODY_LORE"
msgstr "{IntrigueVictimPlayerLeader.FirstName} e {IntrigueCulpritPlayerLeader.FirstName} não têm escolha senão aceitar seu {GLOBAL.DSAllianceConcept.Hyperlink}, e nem você. Com sua assinatura, seus destinos estão selados: vocês alcançarão a vitória neste reino juntos ou compartilharão um destino no {GLOBAL.AstralVoidLoreConcept.Hyperlink}. Mas você não é tolo. Percebe que pode alterar levemente o Contrato para obter mais deste Pacto Demoníaco."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_783@BUTTON_0"
msgstr "Obrigar {IntrigueVictimPlayerLeader.FirstName} a compartilhar conhecimento demoníaco."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_783@BUTTON_1"
msgstr "Exigir um tributo de ouro [gold/] e magia [mana/]."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_783@BUTTON_2"
msgstr "Reivindicar um exército de soldados Obbadothanos [unit/] ao seu lado."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_783@BUTTON_3"
msgstr "Recusar-se a abusar do contrato."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_783@TITLE"
msgstr "Três é Demais"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_784@BODY_FOOTER"
msgstr "O poder dentro do Contrato permite um grande feito de magia. O que você escolhe?"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_784@BODY_HEADER"
msgstr "Você reivindica o Contrato entre {IntrigueVictimPlayerLeader.FirstName} e {IntrigueCulpritPlayerLeader.FirstName} e canaliza seu poder."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_784@BODY_LORE"
msgstr "O Contrato pulsa com energias [hyperlink,GLOBAL.ChaosConcept]Caóticas[/hyperlink], com o poder de vincular até mesmo {GLOBAL.GodirLoreConcept.Hyperlink} aos acordos escritos dentro dele. Você percebe que pode canalizar esse poder mágico bruto para si."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_784@BUTTON_0"
msgstr "Invocar um exército de soldados Obbadothanos [unit/] ao seu lado."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_784@BUTTON_1"
msgstr "Canalize seus poderes para reivindicar segredos arcanos."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_784@BUTTON_2"
msgstr "Consuma seu poder diretamente para se fortalecer e fortalecer seu povo."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_784@BUTTON_3"
msgstr "\"Com este Contrato como prova, todo o reino saberá o que você fez.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_784@TITLE"
msgstr "Conhecimento Proibido"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_791@BODY_FOOTER"
msgstr "{IntrigueWarVictimPlayerLeader.TitleName} está indignado, mas nada pode ser feito em relação à declaração de {IntrigueVictimPlayerLeader.FirstName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_791@BODY_HEADER"
msgstr "{IntrigueVictimPlayerLeader.FirstName}, o {BalorUnit} que atualmente governa o {IntrigueVictimPlayerRace}, tem outro anúncio a fazer."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_791@BODY_LORE"
msgstr "\"Que todos saibam que o chamado '{IntrigueWarVictimPlayerLeader.Title}' {IntrigueWarVictimPlayerLeader.FirstName} não passa de um fraco que logo será apenas cinzas neste reino. Eu, o grande {IntrigueVictimPlayerLeader.Name}, {IntrigueVictimPlayerLeader.Title}, destruirei <<P:IntrigueWarVictimPlayerLeader>> com minhas próprias mãos!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_791@BUTTON_0"
msgstr "Que assim seja."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_791@TITLE"
msgstr "Declaração Repentina"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_792@BODY_FOOTER"
msgstr "\"Como refugiados, não temos meios de desafiar o {IntrigueVictimPlayerLeader.Title}. Assim, deixamos este conhecimento, e o destino do nosso povo, em suas mãos.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_792@BODY_HEADER"
msgstr "Pouco depois de sua comitiva chegar, um civil do {IntrigueVictimPlayerRace} aparece. \"Salve, grande {PlayerLeader.Title}. Fico feliz que nossa mensagem tenha chegado até você.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_792@BODY_LORE"
msgstr "\"Eu fazia parte da corte do nosso {IntriguePreviousRuler.Title}, antes que <<p:IntriguePreviousRuler>> fosse banido e substituído por um Demônio vil de {GLOBAL.ObbadothLoreConcept.Hyperlink}. Eu fugi, pois conheço a localização do {EventStructure} onde o {IntrigueVictimPlayerLeader.Title} foi invocado. Deve haver a resposta sobre como isso aconteceu. Receio que isso não tenha sido obra de um simples cultista.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_792@BUTTON_0"
msgstr "\"Os {IntrigueVictimPlayerRace} em fuga são bem-vindos ao meu Império.\" [population/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_792@BUTTON_1"
msgstr "\"Sua confiança em mim foi mal colocada. Entregue seus pertences, [gold/], ou morra.\" [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_792@BUTTON_2"
msgstr "\"Vou levar isso em consideração.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_792@TITLE"
msgstr "Tomada Demoníaca: Cidadão Preocupado"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_831@BODY_FOOTER"
msgstr "Em meio ao pânico do {IntrigueVictimPlayerRace}, você sente o [hyperlink,GLOBAL.ChaosConcept]Caos[/hyperlink] se dissipar. Qual é seu ato final neste capítulo infernal?"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_831@BODY_HEADER"
msgstr "Você derrotou o {IntrigueVictimPlayerLeader.Title}. Os {IntrigueVictimPlayerRace} se dispersam, libertos do terror de seu mestre infernal, mas sem seu antigo {GLOBAL.GodirLoreConcept.Hyperlink}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_831@BODY_LORE"
msgstr "The {BalorUnit} roars as <<p:IntrigueVictimPlayerLeader>> is banished back to {GLOBAL.ObbadothLoreConcept.Hyperlink}, leaving ruined cities in <<o:IntrigueVictimPlayerLeader>> wake. Without the knowledge or artifact that summoned <<P:IntrigueVictimPlayerLeader>>, however, you cannot reinstate {IntriguePreviousRuler.TitleName}. Hopefully, <<p:IntriguePreviousRuler>> finds <<o:IntriguePreviousRuler>> own way back to {GLOBAL.MagehavenLoreConcept.Hyperlink}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_831@BUTTON_0"
msgstr "Canalize o poder Caótico passageiro para reivindicar segredos arcanos."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_831@BUTTON_1"
msgstr "Convoque um exército de soldados obbadothanos [unit/] ao seu lado."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_831@BUTTON_2"
msgstr "Receba {IntrigueVictimPlayerRace} fugitivos em suas cidades. [population/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_831@TITLE"
msgstr "O {IntrigueVictimPlayerLeader.Title}, Derrotado"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_832@BODY_FOOTER"
msgstr "O próprio Contrato é um artefato mágico poderoso. Com ele, você poderia alterar o destino deste reino..."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_832@BODY_HEADER"
msgstr "Você derrotou {IntrigueCulpritPlayerLeader.TitleName}. No caos da derrota de <<o:IntrigueCulpritPlayerLeader>>, você encontra um Contrato Infernal entre <<P:IntrigueCulpritPlayerLeader>> e {IntrigueVictimPlayerLeader.Name}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_832@BODY_LORE"
msgstr "{IntrigueCulpritPlayerLeader.FirstName} convocou um {BalorUnit} de {GLOBAL.ObbadothLoreConcept.Hyperlink}, banindo e substituindo {IntriguePreviousRuler.TitleName}. O Contrato ainda afirma que <<p:IntrigueCulpritPlayerLeader>> e o {IntrigueVictimPlayerLeader.Title} permanecerão em um(a) {GLOBAL.DSAllianceConcept.Hyperlink} até que o reino seja conquistado. Com a derrota de {IntrigueCulpritPlayerLeader.FirstName}, o Contrato se torna nulo..."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_832@BUTTON_0"
msgstr "Destrua o Contrato e a Aliança Infernal, banindo o(a) {IntrigueVictimPlayerLeader.Title} e trazendo {IntriguePreviousRuler.TitleName} de volta."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_832@BUTTON_1"
msgstr "Mantenha o Contrato e use-o para reivindicar poderes infernais [knowledge/] [mana/] para você! [chaosboon/] [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_832@TITLE"
msgstr "Invocador Infernal, Derrotado"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_844@BODY_FOOTER"
msgstr "Não é anormal que um(a) {GLOBAL.LeaderConcept} recue temporariamente para o Vazio. Porém, que alguém governe em sua ausência temporária é certamente... incomum."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_844@BODY_HEADER"
msgstr "{IntriguePreviousRuler.TitleName} recuou recentemente para o(a) {GLOBAL.AstralVoidLoreConcept.Hyperlink}. Na ausência de <<o:IntriguePreviousRuler>>, um(a) {IntrigueVictimPlayerLeader.Title} apresenta <<r:IntrigueVictimPlayerLeader>>."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_844@BODY_LORE"
msgstr "\"Saudações. Nosso grande {IntriguePreviousRuler.TitleName} está atualmente... indisposto, e enquanto investigamos a ausência de <<o:IntriguePreviousRuler>>, o peso do nosso orgulhoso {GLOBAL.EmpireConcept} recaiu sobre meus ombros. Fique tranquilo, encontraremos o responsável pelo destino do nosso grandioso [hyperlink,GLOBAL.LeaderConcept]Governante[/hyperlink], e a justiça será feita.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_844@BUTTON_0"
msgstr "Não há escolha a não ser ver como isso se desenvolve."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_844@TITLE"
msgstr "Uma Nova Regência"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_862@BODY_FOOTER"
msgstr "Você poderia investigar as magias que prendem {IntriguePreviousRuler} no(a) {GLOBAL.AstralVoidLoreConcept.Hyperlink} para ajudar <<P:IntriguePreviousRuler>>... Ou usar essas descobertas em seu próprio benefício."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_862@BODY_HEADER"
msgstr "O(a) {IntrigueVictimUnit} assente. \"Obrigado, {PlayerLeader.TitleName}. Compartilharei tudo o que sei sobre o desaparecimento do nosso {IntriguePreviousRuler.Title}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_862@BODY_LORE"
msgstr "\"Nosso {IntriguePreviousRuler.Title} foi banido para o(a) {GLOBAL.AstralVoidLoreConcept.Hyperlink}. Normalmente, <<p:IntriguePreviousRuler>> retornaria ao trono de <<o:IntriguePreviousRuler>> em breve. Agora, porém, algo prende <<P:IntriguePreviousRuler>> à escuridão. Há magia em ação, e tenho certeza de que isso é obra de <<g:doing^n,IntrigueVictimPlayerLeader>>... Mas não tenho poder para investigar e provar isso.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_862@BUTTON_0"
msgstr "\"Vou investigar essas correntes arcanas de [knowledge/].\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_862@BUTTON_1"
msgstr "\"Pensando melhor, estou ocupado demais para isso.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_862@TITLE"
msgstr "Correntes da Magia"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_863@BODY_FOOTER"
msgstr "Seu erudito assente. \"Encontramos evidências de que o {IntrigueVictimPlayerLeader.Title} capturou {IntriguePreviousRuler.Name} em uma Jaula de Ligação para ampliar o poder de <<o:IntrigueVictimPlayerLeader>>.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_863@BODY_HEADER"
msgstr "A investigação sobre a causa de <<g:prolonged absence^n,IntriguePreviousRuler>> foi concluída. Seus eruditos e o {IntrigueVictimUnit} que se juntou a você apresentam suas descobertas."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_863@BODY_LORE"
msgstr "\"É pior do que eu esperava, ó {PlayerLeader.Title}. Meu {IntriguePreviousRuler.Title} não está apenas ligado ao {GLOBAL.AstralVoidLoreConcept.Hyperlink}, mas as energias que prendem <<P:IntriguePreviousRuler>> convergem todas em nossa capital {IntrigueVictimPlayerCapital}. A natureza das magias envolvidas e o súbito surgimento de <<G:power^n,IntrigueVictimPlayerLeader>> indicam fortemente que <<p:IntrigueVictimPlayerLeader>> está usando um {GLOBAL.CageOfBindingLoreConcept.Hyperlink} para desviar a energia de {GLOBAL.GodirLoreConcept.Hyperlink}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_863@BUTTON_0"
msgstr "\"Muito preocupante. Continue...\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_863@TITLE"
msgstr "Correntes da Magia: Consequências"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_873@BODY_FOOTER"
msgstr "\"Não estou mais seguro em {IntrigueVictimPlayerCapital}. Ofereço minhas habilidades como erudito ao {GLOBAL.LeaderConcept} que busca provar a culpa de <<o:IntrigueVictimPlayerLeader>>.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_873@BODY_HEADER"
msgstr "Pouco depois de {IntrigueVictimPlayerLeader.Title} ascender ao poder, seus guardas trazem à sua presença um {IntrigueVictimUnit} do {IntrigueVictimPlayerRace}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_873@BODY_LORE"
msgstr "\"{PlayerLeader.TitleName}, obrigado por me ouvir. Venho de {IntrigueVictimPlayerCapital}. Quando nosso {IntriguePreviousRuler.Title} foi lançado no {GLOBAL.AstralVoidLoreConcept.Hyperlink}, {IntrigueVictimPlayerLeader.FirstName} tomou o controle de nosso {GLOBAL.EmpireConcept}. Conheço <<P:IntrigueVictimPlayerLeader>> como um conspirador que não medirá esforços para obter o poder de um {GLOBAL.GodirLoreConcept.Hyperlink}. Tenho certeza de que <<p:IntrigueVictimPlayerLeader>> está por trás do prolongado desaparecimento de nosso {IntriguePreviousRuler.Title}, mas me faltam provas.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_873@BUTTON_0"
msgstr "\"Conte-me mais.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_873@BUTTON_1"
msgstr "\"Não tenho interesse na política e nos dramas de outros Impérios.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_873@TITLE"
msgstr "Ausência Suspeita"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_877@BODY_FOOTER"
msgstr "\"Antes de quebrar a Jaula que prende {IntriguePreviousRuler.Title}, você precisará coletar os componentes necessários para remover quaisquer armadilhas.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_877@BODY_HEADER"
msgstr "Você descobriu que {IntriguePreviousRuler.TitleName} está sendo mantido em uma {GLOBAL.CageOfBindingLoreConcept.Hyperlink} em {IntrigueVictimPlayerCapital}, usado como fonte de poder para o {IntrigueVictimPlayerLeader.Title}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_877@BODY_LORE"
msgstr "Usar esse método controverso — alguns diriam até proibido — para roubar poder de um {GLOBAL.GodirLoreConcept.Hyperlink} seria motivo de guerra para muitos. \"No entanto, um ataque direto seria arriscado\", alerta o erudito. \"{IntrigueVictimPlayerLeader.FirstName} não é tolo, <<p:IntrigueVictimPlayerLeader>> terá ancorado a Jaula em <<r:IntrigueVictimPlayerLeader>>. Devemos primeiro romper essa linha vital antes de libertar meu {IntriguePreviousRuler.Title}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_877@BUTTON_0"
msgstr "\"Vou reivindicar esses locais.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_877@BUTTON_1"
msgstr "\"Não tenho tempo para isso.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_877@BUTTON_4"
msgstr "\"Vou usar todo esse conhecimento de [knowledge/] em meu próprio benefício...\" [influence/] [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_877@TITLE"
msgstr "Sifão Arcano"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_878@BODY_FOOTER"
msgstr "\"Não existe uma [hyperlink,GLOBAL.CageOfBindingLoreConcept]\"Jaula\"[/hyperlink] em {IntrigueVictimPlayerCapital}, mas seu cuidado com meu povo é louvável. Abandone esse esforço inútil, e poderemos compartilhar nossa prosperidade.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_878@BODY_HEADER"
msgstr "Você coletou os ingredientes necessários para quebrar o {GLOBAL.CageOfBindingLoreConcept.Hyperlink} que prende {IntriguePreviousRuler.TitleName} em {IntrigueVictimPlayerCapital}. Antes que possa planejar seus próximos passos, no entanto..."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_878@BODY_LORE"
msgstr "{IntrigueVictimPlayerLeader.TitleName} <<r:IntrigueVictimPlayerLeader>> se aproxima de você. \"{PlayerLeader.TitleName}. Chegou ao meu conhecimento que você busca conselhos de um fugitivo conhecido do nosso Império. <<Cp:IntrigueVictimUnit>> é um charlatão delirante, que o faz perseguir uma fantasia caluniosa para distraí-lo dos planos que <<p:IntrigueVictimUnit>> prepara dentro do seu {GLOBAL.EmpireConcept}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_878@BUTTON_0"
msgstr "\"Você não passa de um usurpador, e eu verei sua queda!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_878@BUTTON_7"
msgstr "\"Muito bem. Vou fingir que acredito em você.\" [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_878@BUTTON_8"
msgstr "\"Meu silêncio pode ser comprado por um preço em ouro [gold/] e poder.\" [influence/] [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_878@TITLE"
msgstr "Sifão Arcano: Consequências"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_885@BODY_FOOTER"
msgstr "A Jaula de Ligação em {IntrigueVictimPlayerCapital} agora pode ser acessada. Tome a cidade para chegar à Jaula e {IntriguePreviousRuler.TitleName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_885@BODY_HEADER"
msgstr "Com a queda de <<g:face^n,IntrigueVictimPlayerLeader>>, você rompe a conexão com <<P:IntrigueVictimPlayerLeader>> e se volta para o {IntrigueVictimUnit} e seus estudiosos."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_885@BODY_LORE"
msgstr "\"Estou aliviado que você não caiu nas mentiras de <<g:words^p,IntrigueVictimPlayerLeader>>, ó {PlayerLeader.Title},\" diz o {IntrigueVictimUnit}. \"Poucos conseguem resistir ao fascínio do poder... Mas divago. Seus estudiosos e eu preparamos um ritual de ruptura que enfraquecerá o vínculo entre {IntrigueVictimPlayerLeader.FirstName} e o {GLOBAL.CageOfBindingLoreConcept.Hyperlink} em {IntrigueVictimPlayerCapital}.\" Você faz um gesto de aprovação, e o ritual começa."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_885@BUTTON_0"
msgstr "\"Convocar os estandartes!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_885@BUTTON_1"
msgstr "\"Pensando melhor, vou aceitar <<g:deal^n,IntrigueVictimPlayerLeader>>.\" [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_885@TITLE"
msgstr "{IntriguePreviousRuler.Title} na Jaula"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_886@BODY_FOOTER"
msgstr "Diante de você está o {GLOBAL.CageOfBindingLoreConcept.Hyperlink} com {IntriguePreviousRuler.TitleName} em um sono eterno. O poder que emana é quase intoxicante..."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_886@BODY_HEADER"
msgstr "Você capturou {EventCity} com sucesso. Como {GLOBAL.GodirLoreConcept.Hyperlink}, não demora muito para localizar a fonte de <<g:powers^p,IntrigueVictimPlayerLeader>>."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_886@BODY_LORE"
msgstr "Despojado do poder de <<o:IntrigueVictimPlayerLeader>> como {IntrigueVictimPlayerLeader.Title} e incapaz de detê-lo, {IntrigueVictimPlayerLeader.FirstName} não tem escolha senão assistir enquanto você força seu caminho através de <<g:bastion^n,EventCity>>. Nas profundezas, você é atacado pelos poderes brutos do {IntriguePreviousRuler.Title} adormecido, que são sifonados por meio de uma elaborada construção de ritual, sigilos arcanos e máquina."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_886@BUTTON_0"
msgstr "Quebre a Jaula de Ligação, liberte {IntriguePreviousRuler.TitleName}. [influence/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_886@BUTTON_7"
msgstr "Mantenha a Jaula de Ligação, derrote o Império de {IntriguePreviousRuler.TitleName} e sifone o poder de [mana/] <<o:IntriguePreviousRuler>>. [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_886@TITLE"
msgstr "{IntriguePreviousRuler.Title} na Jaula: Consequências"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_889@BODY_FOOTER"
msgstr "\"Que todos os Governantes se cuidem, {PlayerLeader.TitleName} capturou nosso amado {IntriguePreviousRuler.Title} em uma Jaula de Ligação!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_889@BODY_HEADER"
msgstr "O recém-nomeado {IntrigueVictimPlayerLeader.TitleName} do {IntrigueVictimPlayerRace} tem um anúncio a fazer."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_889@BODY_LORE"
msgstr "\"Nossas investigações sobre a prolongada ausência do nosso grande {IntriguePreviousRuler.TitleName} levaram a uma conclusão preocupante. Foi ninguém menos que {IntriguePlayerLeader.TitleName} quem colocou <<P:IntriguePreviousRuler>> em uma {GLOBAL.CageOfBindingLoreConcept.Hyperlink}. Afinal, quem mais além de um {GLOBAL.GodirLoreConcept.Hyperlink} poderia possuir o poder para criar uma Jaula como esta? Não foi {PlayerLeader.FirstName} <<r:PlayerLeader>> quem recentemente investigou essa magia proibida?\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_889@BUTTON_0"
msgstr "\"Mentiras e calúnias!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_889@TITLE"
msgstr "Acusação Repentina"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_894@BODY_FOOTER"
msgstr "\"Tenho minha gratidão, {PlayerLeader.TitleName}. Diga sua recompensa, e você a terá.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_894@BODY_HEADER"
msgstr "Com uma impressionante demonstração de habilidade em {GLOBAL.GodirLoreConcept.Hyperlink}, você quebra o {GLOBAL.CageOfBindingLoreConcept.Hyperlink} no centro de {IntrigueVictimPlayerCapital} e liberta {IntrigueVictimPlayerLeader.FirstName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_894@BODY_LORE"
msgstr "Even in <<o:IntrigueVictimPlayerLeader>> weakened state, {IntrigueVictimPlayerLeader} returns to <<o:IntrigueVictimPlayerLeader>> original regality. <<Cp:IntrigueVictimPlayerLeader>> barks orders, and soon after the former {IntriguePreviousRuler.Title} is captured and dragged to the prisons of {IntrigueVictimPlayerCapital}. {IntrigueVictimPlayerLeader.TitleName} turns to you. \"You saved me from a fate worse than death. I am no stranger to the {GLOBAL.AstralVoidLoreConcept.Hyperlink}, but a {GLOBAL.CageOfBindingLoreConcept.Hyperlink} is a torture I would not wish upon my greatest enemy.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_894@BUTTON_0"
msgstr "\"Preciso de um aliado neste reino. Junte-se a mim, rumo à vitória!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_894@BUTTON_1"
msgstr "\"Compartilhe seus recursos [gold/] [mana/] [food/] [knowledge/] com minha cidade {EventCity}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_894@BUTTON_2"
msgstr "\"Não se pode confiar em você para governar. Torne-se meu vassalo, em vez disso.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_894@BUTTON_3"
msgstr "\"Você é fraco demais para ser chamado de Godir, e eu porei fim ao seu reinado.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_894@TITLE"
msgstr "O Retorno de {IntrigueVictimPlayerLeader.Title}"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_895@BODY_FOOTER"
msgstr "Seu Império exige sua atenção. O que você faz antes de deixar {IntriguePreviousRuler.TitleName} à mercê do <<o:IntriguePreviousRuler>> como fonte de poder arcano?"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_895@BODY_HEADER"
msgstr "Ao ficar diante do {GLOBAL.CageOfBindingLoreConcept.Hyperlink} que aprisiona {IntriguePreviousRuler.TitleName}, o poder sifonado quase o domina."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_895@BODY_LORE"
msgstr "A seu comando, o antigo {IntrigueVictimPlayerLeader.Title} do {IntrigueVictimPlayerRace} é arrastado por uma multidão enfurecida. O {IntrigueVictimUnit} deixa sua corte, horrorizado com sua decisão, mas você não se importa. Se {IntrigueVictimPlayerLeader.FirstName} podia usar um dispositivo como esse diante de você, por que não você? Você não o construiu, nem aprisionou {IntriguePreviousRuler.FirstName}. Você apenas... usa a mão que lhe foi dada."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_895@BUTTON_0"
msgstr "Sobrecarregue o sifão [mana/] para destruir a Jaula e banir {Ruler} para o Vazio."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_895@BUTTON_1"
msgstr "Ordene que seus estudiosos estudem a Jaula de Aprisionamento e <<g:Magic^n,IntriguePreviousRuler>>. [knowledge/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_895@BUTTON_2"
msgstr "Force seus Heróis a absorverem parte de <<g:power^n,IntriguePreviousRuler>>."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_895@BUTTON_3"
msgstr "Canalize <<g:magic^n,IntriguePreviousRuler>> para {EventCity} para impulsionar temporariamente sua prosperidade. [food/] [unitprod/] [production/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_895@TITLE"
msgstr "Os Poderes de um Godir"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_935@BODY_FOOTER"
msgstr "A inquietação ressoa dentro do Império de {IntrigueVictimPlayerLeader.TitleName}. Uma ameaça a ser enfrentada... ou uma oportunidade para você?"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_935@BODY_HEADER"
msgstr "Há muito tempo, o {GLOBAL.EmpireConcept} de {IntrigueVictimPlayerLeader.TitleName} está em agitação. Agora, rumores de uma rebelião chegam à sua corte."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_935@BODY_LORE"
msgstr "Qualquer dissidência era recebida com punição severa de {IntrigueVictimPlayerLeader.FirstName}, mas isso parece ter apenas atiçado as chamas internas. Recentemente, no entanto, a voz mais alta dos {IntrigueVictimPlayerRace} desapareceu, rumores dizem que fugiu para pastos mais verdes."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_935@BUTTON_0"
msgstr "O tempo dirá."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_935@TITLE"
msgstr "Rumores de Rebelião"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_939@BODY_FOOTER"
msgstr "Conquistar {IntrigueHouse} parece ser a única maneira de libertar esse prisioneiro importante de {IntrigueVictimPlayerLeader.FirstName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_939@BODY_HEADER"
msgstr "Enquanto pondera sobre seu domínio neste reino, você recebe rumores sobre uma pessoa que pode ser de seu interesse."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_939@BODY_LORE"
msgstr "Há relatos de um prisioneiro misterioso mantido em {IntrigueHouse}, vendado e amordaçado, afastado de todos os outros. Os oficiais dizem que <<p:IntrigueHero>> é um ladrão comum, mas o \"tratamento especial\" parece altamente suspeito. Até mesmo há sussurros sobre o envolvimento de {IntrigueVictimPlayerLeader.Name} <<r:IntrigueVictimPlayerLeader>>.[br/]Libertar esse prisioneiro certamente irritará {IntrigueVictimPlayerLeader.FirstName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_939@BUTTON_0"
msgstr "Vou libertar esse prisioneiro."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_939@BUTTON_1"
msgstr "Não quero me envolver mais nisso."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_939@TITLE"
msgstr "Prisioneiro Misterioso"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_940@BODY_FOOTER"
msgstr "\"Percebo que a ajuda de um Godir raramente vem sem custo. Ainda assim, só posso agradecer por respirar ar fresco novamente.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_940@BODY_HEADER"
msgstr "Você conquistou {IntrigueHouse}. No calabouço mais profundo, seus soldados encontram o prisioneiro vendado e amordaçado sobre o qual havia rumores."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_940@BODY_LORE"
msgstr "Quando <<p:IntrigueHero>> é trazido à sua presença, fica claro que o prisioneiro não vê a luz do dia, ou qualquer tipo de conforto, há muito tempo. A voz de <<Co:IntrigueHero>> está rouca, quase um sussurro quando <<p:IntrigueHero>> fala, mas <<p:IntrigueHero>> permanece destemido diante de você. \"Meu nome é {IntrigueHero.FirstName}, cidadão orgulhoso de {IntrigueVictimPlayerCapital}... ou era, antes de ser aprisionado.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_940@BUTTON_0"
msgstr "\"Conte-me mais sobre seu aprisionamento.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_940@BUTTON_2"
msgstr "\"Sua gratidão está mal colocada, agora você é meu prisioneiro!\" [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_940@TITLE"
msgstr "Prisioneiro Misterioso: Consequências"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_945@BODY_FOOTER"
msgstr "\"Tenho muitos apoiadores em {IntrigueVictimPlayerCapital}. Ajude-me a tomar a cidade, e os {IntrigueVictimPlayerRace} ficarão em dívida com você.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_945@BODY_HEADER"
msgstr "{IntrigueHero.FirstName} rosna. \"Fui aprisionado porque '{IntrigueVictimPlayerLeader.Title}' {IntrigueVictimPlayerLeader.FirstName} tem medo dos <<o:IntrigueVictimPlayerLeader>> próprios súditos e do poder do {IntrigueVictimPlayerRace}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_945@BODY_LORE"
msgstr "\"Nós, {IntrigueVictimPlayerRace}, somos tratados terrivelmente por nosso {IntrigueVictimPlayerLeader.Title}. As pessoas só aguentam tanto abuso antes de se levantarem contra um regime, mesmo um [hyperlink,GLOBAL.GodirLoreConcept]Godir[/hyperlink]. Havia muitas vozes durante esse levante, mas suponho que a minha era a mais alta. E assim fui silenciado. Agora que você me libertou, devo, por minha vez, unir e libertar meu povo de <<g:tyranny^n,IntrigueVictimPlayerLeader>>.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_945@BUTTON_0"
msgstr "\"Vou ajudá-lo em sua rebelião, {IntrigueHero.FirstName}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_945@BUTTON_1"
msgstr "\"Você está livre para partir, mas não ajudarei uma rebelião.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_945@BUTTON_4"
msgstr "\"Sua confiança em mim foi mal colocada, agora você é meu prisioneiro!\" [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_945@TITLE"
msgstr "Voz do Povo"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_946@BODY_FOOTER"
msgstr "{IntrigueHero.FirstName} prepara <<r:IntrigueHero>> para ascender ao trono de {IntrigueVictimPlayerCapital}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_946@BODY_HEADER"
msgstr "Você conquistou {IntrigueVictimPlayerCapital}. Enquanto seus soldados invadem suas ruas, {IntrigueHero.Name} marcha para a capital, reunindo um grande séquito atrás de <<P:IntrigueHero>>."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_946@BODY_LORE"
msgstr "Em pouco tempo, {IntrigueHero} está diante do trono que pertencia a {IntrigueVictimPlayerLeader.TitleName}. \"Finalmente, nosso conflito chegou ao fim.\" <<Cp:IntrigueHero>> se volta para a multidão reunida diante de <<P:IntrigueHero>>: \"Cidadãos de {IntrigueVictimPlayerCapital}, este é o início de uma nova era. Nunca mais um tirano governará o {IntrigueVictimPlayerRace}! Nunca mais nos ajoelharemos diante de {GLOBAL.GodirLoreConcept.Hyperlink} indignos!\" A multidão aclama freneticamente."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_946@BUTTON_0"
msgstr "Apoie o novo governo de {IntrigueHero.FirstName} do {IntrigueVictimPlayerRace}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_946@BUTTON_7"
msgstr "Aproveite esta chance para assassinar {IntrigueHero.FirstName} antes que <<p:IntrigueHero>> possa ascender. [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_946@TITLE"
msgstr "Voz do Povo: Consequências"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_947@BODY_FOOTER"
msgstr "\"Eu e o {IntrigueVictimPlayerRace} estamos em dívida com você, {PlayerLeader.TitleName}. Diga sua recompensa.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_947@BODY_HEADER"
msgstr "O {IntrigueVictimPlayerRace} tem um novo {IntrigueVictimPlayerLeader.Title}: {IntrigueVictimPlayerLeader.Name}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_947@BODY_LORE"
msgstr "Having been removed from <<o:IntriguePreviousRuler>> throne by <<o:IntriguePreviousRuler>> own former subjects, {IntriguePreviousRuler.TitleName} is sent to the {GLOBAL.AstralVoidLoreConcept.Hyperlink}.[br/][br/]\"This was inevitable,\" {IntrigueVictimPlayerLeader.TitleName} says. \"The people demand their pound of flesh. Let us hope this ends the bloodshed and injustice in {IntrigueVictimPlayerCapital}.\" <<Cp:IntrigueVictimPlayerLeader>> turns to you. \"This would not have been possible without your aid.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_947@BUTTON_0"
msgstr "\"Precisarei de aliados leais neste reino. Junte-se a mim, rumo à vitória!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_947@BUTTON_1"
msgstr "Compartilhe seus recursos [gold/] [mana/] [food/] [knowledge/] com minha cidade {EventCity}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_947@BUTTON_2"
msgstr "\"Governar um Império é difícil para os inexperientes. Torne-se meu vassalo, em vez disso.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_947@TITLE"
msgstr "Vida Longa ao {IntrigueVictimPlayerLeader.Title}"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_948@BODY_FOOTER"
msgstr "Você destruiu completamente qualquer senso de unidade dentro do Império de {IntrigueVictimPlayerLeader.TitleName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_948@BODY_HEADER"
msgstr "Você ordena que seus soldados assassinem {IntrigueHero.FirstName} à beira da ascensão. <<Cp:IntrigueHero>> encara as facas que se projetam do corpo de <<o:IntrigueHero>> com incredulidade."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_948@BODY_LORE"
msgstr "Sem dizer outra palavra, o suposto {IntrigueHero.Title} desaba no chão, o sangue se acumulando ao redor de <<P:IntrigueHero>>. Os {IntrigueVictimPlayerRace} lamentam em agonia a perda de seu libertador."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_948@BUTTON_0"
msgstr "\"É isso que acontece com aqueles que desafiam o governo de um Godir.\" [influence/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_948@BUTTON_1"
msgstr "Saqueie [item/] e reivindique <<g:body^n,IntrigueHero>> [unit/] para sua própria cripta."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_948@BUTTON_3"
msgstr "Reintegre {IntrigueVictimPlayerLeader.TitleName} e force <<P:IntrigueVictimPlayerLeader>> à submissão."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_948@TITLE"
msgstr "Até tu, {PlayerLeader.FirstName}?"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_954@BODY_FOOTER"
msgstr "\"Que este cerco acabe logo,\" diz {IntrigueHero.FirstName}, olhando para a cidade. \"Para que meu povo não sofra mais.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_954@BODY_HEADER"
msgstr "Você chegou a {IntrigueVictimPlayerCapital}. Ao iniciar o cerco, {IntrigueHero.FirstName} avança, claramente visível dos muros."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_954@BODY_LORE"
msgstr "\"{IntrigueVictimPlayerRace}!\" grita <<Cp:IntrigueHero>>, \"Irmãos, irmãs! Eu voltei, com a ajuda e o apoio de {PlayerLeader.TitleName}! Não estamos sozinhos, somos muitos, nunca seremos silenciados! Levantem-se contra o tirano {IntrigueVictimPlayerLeader.Name}!\" Um fraco aplauso é ouvido dos muros de {IntrigueVictimPlayerCapital}, seguido pelos sons de tumultos e agitação dentro da cidade."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_954@BUTTON_0"
msgstr "Continue seu cerco."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_954@BUTTON_1"
msgstr "Aproveite esta chance para assassinar {IntrigueHero.FirstName} antes que <<p:IntrigueHero>> cumpra a missão <<o:IntrigueHero>>. [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_954@TITLE"
msgstr "Voz do Povo: {IntrigueVictimPlayerCapital}"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_956@BODY_FOOTER"
msgstr "\"Isso significa guerra, {PlayerLeader.TitleName}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_956@BODY_HEADER"
msgstr "Pouco depois de libertar um prisioneiro de {IntrigueVictimPlayerLeader.TitleName}, você é contatado pelo(a) {IntrigueVictimPlayerLeader.Title} <<r:IntrigueVictimPlayerLeader>>."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_956@BODY_LORE"
msgstr "{IntrigueVictimPlayerLeader.FirstName} fala friamente: \"Você me subestima se pensa que não estou ciente do que planeja. Seu único objetivo é semear a discórdia, e eu não aceitarei isso.\" Um leve sorriso surge no rosto de <<o:IntrigueVictimPlayerLeader>>: \"Por sorte, nada une mais um povo do que uma ameaça comum.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_956@BUTTON_0"
msgstr "\"Que assim seja.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_956@TITLE"
msgstr "Nenhuma Boa Ação"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_978@BODY_FOOTER"
msgstr "\"Não podemos banir o(a) {IntrigueVictimPlayerLeader.Title}, mas você pode. Por favor, {IntriguePlayerLeader.TitleName}. Destrua esse demônio vil. Salve o(a) {IntrigueVictimPlayerRace}...\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_978@BODY_HEADER"
msgstr "Você resgatou um grupo de refugiados de um ataque demoníaco. Machucados, mas gratos, os sobreviventes se reúnem ao redor do seu exército."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_978@BODY_LORE"
msgstr "A última coisa que o cidadão preocupado lhe disse antes da morte de <<o:IntrigueVictimUnit>> foi sobre a invocação de {IntrigueVictimPlayerLeader.TitleName}. Ao investigar, um dos refugiados se adianta mancando. \"Você quer dizer o(a) {EventStructure}?\" diz <<Cp:IntrigueVictimUnit>>, apesar dos avisos sussurrados dos companheiros <<o:IntrigueVictimUnit>>. \"Eu... eu sei onde fica. Mas devo avisá-lo, ó {PlayerLeader.Title}. Isso não foi obra de um simples culto.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_978@BUTTON_0"
msgstr "\"Os refugiados {IntrigueVictimPlayerRace} em fuga são bem-vindos no meu Império.\" diz [population/]."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_978@BUTTON_1"
msgstr "\"Sua confiança em mim está mal colocada. Entregue seus pertences, [gold/], ou morra.\" diz [evilact/]."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_978@BUTTON_2"
msgstr "\"Vou me lembrar disso.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_978@TITLE"
msgstr "Tomada Demoníaca: Consequências"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_987@BODY_FOOTER"
msgstr "Os {IntrigueVictimPlayerRace} restantes não têm escolha senão aguardar seu julgamento sobre seu destino. Como você se dirige a eles?"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_987@BODY_HEADER"
msgstr "Você derrotou {IntrigueVictimPlayerLeader.TitleName} e tomou a capital de <<o:IntrigueVictimPlayerLeader>>, em meio a uma rebelião crescente."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_987@BODY_LORE"
msgstr "Seus exércitos invadem a antiga capital, dissuadindo qualquer agitação adicional. A queda do grandioso Império ecoa pelo reino, e quaisquer rumores de rebelião e prisioneiros desaparecem com aqueles que fogem de sua ira esperada."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_987@BUTTON_0"
msgstr "\"Com a queda deste Império, lembrem-se do poder de {PlayerLeader.TitleName}.\" [influence/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_987@BUTTON_2"
msgstr "\"Os {IntrigueVictimPlayerRace} serão auxiliados [food/] durante estes tempos de incerteza.\" [goodact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_987@BUTTON_3"
msgstr "Você não se dirige ao povo. Você saqueia a cidade. [gold/] [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_987@TITLE"
msgstr "Rebelião: Esmagada"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_988@BODY_FOOTER"
msgstr "Você sente um poder arcano surgir ao redor de {IntrigueHero.FirstName}. Se permitir que <<P:IntrigueHero>>, <<p:IntrigueHero>> ascenderá para se tornar o [hyperlink,GLOBAL.LeaderConcept]Governante[/hyperlink] do {IntrigueVictimPlayerRace}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_988@BODY_HEADER"
msgstr "{IntrigueHero.FirstName} rosna. \"Fui aprisionado porque '{IntrigueVictimPlayerLeader.Title}' {IntrigueVictimPlayerLeader.FirstName} tem medo de <<o:IntrigueVictimPlayerLeader>> próprios súditos e do poder do {IntrigueVictimPlayerRace}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_988@BODY_LORE"
msgstr "\"<<g:power^n,IntrigueVictimPlayerLeader>> está em declínio, <<o:IntrigueVictimPlayerLeader>> capital foi tomada, e assim devo guiar meu povo.\" Em pouco tempo, {IntrigueHero.FirstName} se apresenta diante de <<o:IntrigueHero>> povo. \"Orgulhosos {IntrigueVictimPlayerRace}, nossa luta chegou ao fim! Nunca mais um tirano governará sobre nós! Nunca mais nos ajoelharemos perante {GLOBAL.GodirLoreConcept.Hyperlink} indignos!\" A multidão aclama selvagemente o retorno de seu [hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink]."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_988@TITLE"
msgstr "Voz do Povo"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@BRAVERY@DESCRIPTION"
msgstr "Seu povo segue um caminho de Luta, buscando forjar sua força nas chamas da guerra:[bulletlist][bullet/]Ganhe ressentimentos contra <<m:{GLOBAL.LeaderConcept.Hyperlink}>> com uma classificação geral melhor.[bullet/]{GLOBAL.RazingConcept.Hyperlink} <<m:{GLOBAL.CityConcept.Hyperlink}>> e {GLOBAL.PillagingConcept.Hyperlink} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> recebem -{duration} {GLOBAL.TurnConcept}.[bullet/]{GLOBAL.RazingConcept.Hyperlink} <<m:{GLOBAL.CityConcept.Hyperlink}>> e {GLOBAL.PillagingConcept.Hyperlink} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> geram {GLOBAL.ImperiumConcept.Hyperlink}.[bullet/]Unidades culturais têm {GLOBAL.PROPERTIES.WARRIORS_SOUL.Hyperlink}.[bullet/]Torne-se mais forte conforme ganha {GLOBAL.DevotionConcept.Hyperlink} para o {GLOBAL.OathOfStrife.Hyperlink}.[/bulletlist]"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@BRAVERY@LORENAME"
msgstr "Juramentad^f"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@BRAVERY@NAME"
msgstr "Luta"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@HARMONY@ADHERENT_TOOLTIP_DESCRIPTION"
msgstr "[bullet/]{GLOBAL.PROPERTIES.HARMONIZE.Hyperlink}: Curar {amount} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@HARMONY@DEVOTEE_TOOLTIP_DESCRIPTION"
msgstr "[bullet/]{GLOBAL.PROPERTIES.HARMONIZE.Hyperlink}: Curar {amount} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@HARMONY@DEVOTION_DESCRIPTION"
msgstr "[bulletlist][bullet/]Ganhe {GLOBAL.DevotionConcept.Hyperlink} por:[bulletlist][bullet/]Ter um {GLOBAL.CityConcept.Hyperlink} ou {GLOBAL.PvEVassalConcept.Hyperlink} de outra Raça +{GLOBAL.FromVassalage} [devotedact/].[bullet/]Limpar um {GLOBAL.InfestationConcept.Hyperlink} ou {GLOBAL.AncientWonderConcept.Hyperlink} +{GLOBAL.ClearInfestation} [devotedact/].[bullet/]Fazer um {GLOBAL.TruceConcept.Hyperlink} +{GLOBAL.MakeTruce} [devotedact/].[bullet/]Perdoar uma {GLOBAL.CasusBelliConcept.Hyperlink} +{GLOBAL.ForgiveGrievence} [devotedact/].[/bulletlist][bullet/]Perca {GLOBAL.DevotionConcept.Hyperlink} por:[bulletlist][bullet/]Iniciar uma {GLOBAL.WarConcept.Hyperlink} -{GLOBAL.HarmonyEnterWar} [undevotedact/].[bullet/]{GLOBAL.RazingConcept.Hyperlink} ou {GLOBAL.MigratingConcept.Hyperlink} um {GLOBAL.CityConcept.Hyperlink} hostil -{GLOBAL.AbsorbRazeCity} [undevotedact/].[bullet/]Fabricar uma {GLOBAL.CasusBelliConcept.Hyperlink} -{GLOBAL.HarmonyFabricateGrievence} [undevotedact/].[/bulletlist][/bulletlist]"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@HARMONY@DEVOTION_TOOLTIP_DESCRIPTION"
msgstr "{LOC.DLC@WAYSOFWAR@DIPLOMACY@CONCEPT_OATH_HARMONY@NAME}{LOC.DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@HARMONY@DEVOTION_DESCRIPTION}"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@HARMONY@NEUTRAL_TOOLTIP_DESCRIPTION"
msgstr "[bullet/]{GLOBAL.PROPERTIES.HARMONIZE.Hyperlink}: Curar {amount} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@HARMONY@OATHBREAKER_TOOLTIP_DESCRIPTION"
msgstr "[bullet/]{GLOBAL.PROPERTIES.HARMONIZE.Hyperlink}: Ganhar {amount} {GLOBAL.PROPERTIES.WEAKENED.Hyperlink} por {duration} <<m:{GLOBAL.TurnConcept}>>"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@HARMONY@PARAGON_TOOLTIP_DESCRIPTION"
msgstr "[bullet/]{GLOBAL.PROPERTIES.HARMONIZE.Hyperlink}: Cura {amount} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>[bullet/]{GLOBAL.UNITS.PEACEBRINGER.Hyperlink} unidades têm seu {GLOBAL.PROPERTIES.SWORN_PARAGON_WISDOM.Hyperlink} ativado."

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@RIGHTEOUSNESS@ADHERENT_TOOLTIP_DESCRIPTION"
msgstr "[bullet/]{GLOBAL.PROPERTIES.NOBILITY.Hyperlink}: +{amount} {GLOBAL.SpiritDamageConcept.Hyperlink}"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@RIGHTEOUSNESS@DESCRIPTION"
msgstr "Seu povo segue um caminho de Retidão, trabalhando para ser uma força positiva para o bem no mundo:[bulletlist][bullet/]O alinhamento [reputation2/] negativo obtido é dobrado.[bullet/]Unidades culturais têm {GLOBAL.PROPERTIES.NOBILITY.Hyperlink}.[bullet/]Fique mais forte conforme ganha {GLOBAL.DevotionConcept.Hyperlink} para o {GLOBAL.OathOfRighteousness.Hyperlink}.[/bulletlist]"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@RIGHTEOUSNESS@DEVOTEE_TOOLTIP_DESCRIPTION"
msgstr "[bullet/]{GLOBAL.PROPERTIES.NOBILITY.Hyperlink}: +{amount} {GLOBAL.SpiritDamageConcept.Hyperlink}"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@RIGHTEOUSNESS@DEVOTION_DESCRIPTION"
msgstr "[bulletlist][bullet/]Ganhe {GLOBAL.DevotionConcept.Hyperlink} por:[bulletlist][bullet/]Ter alinhamento bom, +{GLOBAL.goodDevotion} [devotedact/] por ponto de [reputation6/].[/bulletlist][bullet/]Perca {GLOBAL.DevotionConcept.Hyperlink} por:[bulletlist][bullet/]Ter alinhamento maligno, -{GLOBAL.devotionevil} [undevotedact/] por ponto de [reputation2/].[/bulletlist][/bulletlist]"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@RIGHTEOUSNESS@DEVOTION_TOOLTIP_DESCRIPTION"
msgstr "{LOC.DLC@WAYSOFWAR@DIPLOMACY@CONCEPT_OATH_RIGHTEOUESNESS@NAME} de {LOC.DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@RIGHTEOUSNESS@DEVOTION_DESCRIPTION}"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@RIGHTEOUSNESS@LORENAME"
msgstr "Juramentad^f"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@RIGHTEOUSNESS@NAME"
msgstr "Retidão"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@RIGHTEOUSNESS@NEUTRAL_TOOLTIP_DESCRIPTION"
msgstr "[bullet/] de {GLOBAL.PROPERTIES.NOBILITY.Hyperlink}: +{amount} {GLOBAL.SpiritDamageConcept.Hyperlink}"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@RIGHTEOUSNESS@OATHBREAKER_TOOLTIP_DESCRIPTION"
msgstr "[bullet/]{GLOBAL.PROPERTIES.NOBILITY.Hyperlink}: -{amount}% de dano."

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@RIGHTEOUSNESS@PARAGON_TOOLTIP_DESCRIPTION"
msgstr "[bullet/]{GLOBAL.PROPERTIES.NOBILITY.Hyperlink}: +{amount} {GLOBAL.SpiritDamageConcept.Hyperlink}[bullet/]{GLOBAL.UNITS.AVENGER.Hyperlink} unidades têm seu {GLOBAL.PROPERTIES.SWORN_PARAGON_RIGHTEOUSNESS.Hyperlink} ativado."

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@STRIFE@ADHERENT_TOOLTIP_DESCRIPTION"
msgstr "[bullet/] de {GLOBAL.PROPERTIES.WARRIORS_SOUL.Hyperlink}: +{amount} {GLOBAL.FireDamageConcept.Hyperlink}"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@STRIFE@DEVOTEE_TOOLTIP_DESCRIPTION"
msgstr "[bullet/] de {GLOBAL.PROPERTIES.WARRIORS_SOUL.Hyperlink}: +{amount} {GLOBAL.FireDamageConcept.Hyperlink}"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@STRIFE@DEVOTION_DESCRIPTION"
