msgid "COMBATPROPERTIES_TACTICAL@LIGHTNING_STORM@NAME"
msgstr "Tempestade de Relâmpagos"

msgid "COMBATPROPERTIES_TACTICAL@LITTERED_CORPSES@DESCRIPTION"
