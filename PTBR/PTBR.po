msgid "DLC@RISEFROMRUIN@FRACTURING_WINDS_CRISIS@VICTORY_EVENT@INTERRUPTED@DESCRIPTION"
msgstr "{CountdownPlayer.Name} perdeu a posse de um ou mais de seus Hubris of the Unmakers <<m:{GLOBAL.ArtifactConcept.Hyperlink}>>, fazendo com que não progridam mais em direção a alcançar a {GLOBAL.CataclysmVictoryConcept.Hyperlink}."

msgid "DLC@RISEFROMRUIN@INTERFACE@AGGRESSIVE_EXPANSION@DESCRIPTION"
msgstr "Aggressive Expansion recompensa a {GLOBAL.ProvinceAnnexationConcept.Hyperlink} de províncias pertencentes a outras facções.[br/][br/]Anexando uma província hostil a uma cidade concede uma recompensa única de {GLOBAL.StructureProductionConcept.Hyperlink}, {GLOBAL.UnitProductionConcept.Hyperlink} e {GLOBAL.GoldConcept.Hyperlink}.[br/][br/]Essas recompensas escalam com a população da cidade de onde a província foi tomada."

msgid "DLC@RISEFROMRUIN@INTERFACE@AGGRESSIVE_EXPANSION@HYPERLINK"
msgstr "[hyperlink,GLOBAL.AggressiveExpansionConcept]Aggressive Expansion[/hyperlink]"

