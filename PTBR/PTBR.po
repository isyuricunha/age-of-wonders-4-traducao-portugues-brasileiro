msgid "DLC@RISEFROMRUIN@FRACTURING_WINDS_CRISIS@VICTORY_EVENT@DESCRIPTION"
msgstr "{CountdownPlayer} tem posse de suficiente Hubris of the Unmakers <<m:{GLOBAL.ArtifactConcept.Hyperlink}>> para usar seu poder para purificar o {GLOBAL.CataclysmConcept.Hyperlink} e fará isso em {TurnCountdown} [turn/] Turns.[br/][br/]Outros podem impedir isso roubando um ou mais dos Artefatos, o que pode ser feito derrotando {CountdownPlayer.Name}."

msgid "DLC@RISEFROMRUIN@FRACTURING_WINDS_CRISIS@VICTORY_EVENT@HEADER"
