msgstr "Todas as {GLOBAL.PROPERTIES.DRAGON.Hyperlink} amigas ganham {GLOBAL.PROPERTIES.KILLING_MOMENTUM.Hyperlink} por {turns} {GLOBAL.TurnConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@ROAR_DRAGONKIN@NAME"
msgstr "Rugido dos Antigos Dragonídeos"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@SUBTERRANEAN_MONUMENTS@DESCRIPTION"
msgstr "<<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacentes a este Marco ganham:[bulletlist][bullet/] Uma [quarry/] Pedreira nesta província concede {income}.[bullet/]Uma [mine/] Mina nesta província concede {income2}.[/bulletlist][br/]Uma {GLOBAL.CityConcept.Hyperlink} com {amount} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacentes a este Marco ganha:[bulletlist][bullet/]Ganhe {income3} {GLOBAL.BindingEssenceConcept.Hyperlink} e {income4} [bindingfragments/] [hyperlink,GLOBAL.BindingEssenceConcept]Fragmentos[/hyperlink] de renda adicional.[/bulletlist]"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@SUBTERRANEAN_MONUMENTS@LORE"
msgstr "\"Vejo o império caído de {GLOBAL.MyrridaLoreConcept.Hyperlink} e meu coração se aperta pelo que meu povo perdeu. Corredores e distritos sem fim, espalhando-se pelo Subterrâneo... Como lamento pela Era Dourada de Myrrida, sua majestade perdida gravada em nossa história. Mas como um [hyperlink,GLOBAL.GiantKingLoreConcept]Rei Gigante[/hyperlink], devo tentar honrar seu legado...\"[br/][br/]— Fjalla Construtor-de-Torres, Em Passos de Gigante: Citado por Ham Binger"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@SUBTERRANEAN_MONUMENTS@NAME"
msgstr "Monumentos Subterrâneos"

