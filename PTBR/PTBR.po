msgstr "Eles respeitam ferreiros e outros artesãos, preferindo uma muralha forte a um palácio decorado."

msgid "CULTURE_INDUSTRIOUS@INDUSTRIOUS@DESCRIPTION"
msgstr "[bulletlist][bullet/]Tem maior renda de {GLOBAL.StructureProductionConcept.Hyperlink}.[bullet/]Por meio de {GLOBAL.PROPERTIES.BOLSTERING.Hyperlink}, as unidades ficam mais resistentes conforme são atingidas em batalha.[bullet/]{GLOBAL.ScoutProspectingConcept.Hyperlink}.[/bulletlist]"

