msgid "DLC@EMPIRESANDASHES@CULTURE_REAVER@DISCUSSION_DECLARATIONOFSUPREMACY@DESCRIPTION"
msgstr "Declare sua Supremacia sobre outro(a) {GLOBAL.LeaderConcept.Hyperlink}.[br/][br/]Um modificador que aumenta lentamente até {RelationValue}[goodRelation/] será adicionado às suas [hyperlink,GLOBAL.EmpireRelationConcept]relações[/hyperlink] com o Governante. Enquanto a Supremacia durar, o jogador adversário não terá nenhum ressentimento afetando a relação por qualquer um de seus <<m:{GLOBAL.CasusBelliConcept.Hyperlink}>>.[br/][br/]Manter uma declaração custa {cost} de manutenção por {GLOBAL.TurnConcept.Hyperlink}, que aumenta em {costScale} para cada declaração adicional.[br/][br/]Declarações podem ser feitas e encerradas por meio de <<m:{GLOBAL.PronouncementsConcept.Hyperlink}>>."

msgid "DLC@EMPIRESANDASHES@CULTURE_REAVER@DISCUSSION_DECLARATIONOFSUPREMACY@EVENT_OTHER"
msgstr "Outros Governantes declararam supremacia"

msgid "DLC@EMPIRESANDASHES@CULTURE_REAVER@DISCUSSION_DECLARATIONOFSUPREMACY@EVENT_RECEIVER"
msgstr "Uma Supremacia foi declarada sobre você"

msgid "DLC@EMPIRESANDASHES@CULTURE_REAVER@DISCUSSION_DECLARATIONOFSUPREMACY@EVENT_SELF"
msgstr "Você declarou uma Supremacia"

msgid "DLC@EMPIRESANDASHES@CULTURE_REAVER@DISCUSSION_DECLARATIONOFSUPREMACY@HYPERLINK"
msgstr "[hyperlink,GLOBAL.DeclSupremacyConcept]Declaração de Supremacia[/hyperlink]"

msgid "DLC@EMPIRESANDASHES@CULTURE_REAVER@DISCUSSION_DECLARATIONOFSUPREMACY@INFOPANEL"
msgstr "{HouseALord.Name} declarou uma [hyperlink,GLOBAL.DeclSupremacyConcept]Supremacia[/hyperlink] sobre {HouseBLord.Name}. Se intimidados com sucesso, a relação deles com {HouseBLord.Name} pode melhorar com o tempo."

msgid "DLC@EMPIRESANDASHES@CULTURE_REAVER@DISCUSSION_DECLARATIONOFSUPREMACY@NAME"
msgstr "Declaração de Supremacia"

msgid "DLC@EMPIRESANDASHES@CULTURE_REAVER@DISCUSSION_END_DECLARATIONOFSUPREMACY@DESCRIPTION"
msgstr "Encerra sua declaração de Supremacia. Quaisquer bônus de relação da declaração serão perdidos, e o oponente recuperará qualquer ressentimento por suas queixas."

msgid "DLC@EMPIRESANDASHES@CULTURE_REAVER@DISCUSSION_END_DECLARATIONOFSUPREMACY@EVENT_OTHER"
msgstr "Outros Governantes encerraram sua supremacia"

msgid "DLC@EMPIRESANDASHES@CULTURE_REAVER@DISCUSSION_END_DECLARATIONOFSUPREMACY@EVENT_RECEIVER"
msgstr "Uma Supremacia sobre você foi encerrada"

msgid "DLC@EMPIRESANDASHES@CULTURE_REAVER@DISCUSSION_END_DECLARATIONOFSUPREMACY@EVENT_SELF"
msgstr "Você encerrou sua Supremacia"

msgid "DLC@EMPIRESANDASHES@CULTURE_REAVER@DISCUSSION_END_DECLARATIONOFSUPREMACY@INFOPANEL"
msgstr "{HouseALord.Name} encerrou sua [hyperlink,GLOBAL.DeclSupremacyConcept]Supremacia[/hyperlink] com {HouseBLord.Name}. As relações deles podem se deteriorar por causa disso."

