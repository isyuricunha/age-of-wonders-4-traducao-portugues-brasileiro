msgstr "Dragão Fraturado^n"

msgid "DLC@RISEFROMRUIN@UNITS_WILDLIFE@FRACTURED_EVOKER@NAME"
msgstr "Evocador Fraturado^m"

msgid "DLC@RISEFROMRUIN@UNITS_WILDLIFE@FRACTURED_SCORPION@NAME"
msgstr "Escorpião Fraturado^n"

msgid "DLC@RISEFROMRUIN@UNITS_WILDLIFE@FRACTURED_SERPENT@NAME"
msgstr "Serpente Fraturada^n"

msgid "DLC@RISEFROMRUIN@UNITS_WILDLIFE@FRACTURED_UNICORN@NAME"
msgstr "Unicórnio Fraturado^n"

msgid "DLC@RISEFROMRUIN@UNITS_WILDLIFE@FRACTURED_WORM@NAME"
msgstr "Verme Fraturado^n"

msgid "DLC@RISEFROMRUIN@UNITS_WILDLIFE@SANDWORM@NAME"
msgstr "Verme da Areia^n"

msgid "DLC@RISEFROMRUIN@UNMAKER_RACE@NAME"
msgstr "{GLOBAL.UnmakersLoreConcept.Hyperlink}"

msgid "DLC@RISEFROMRUIN@WEAPON@NOMAD_BOW@NAME"
msgstr "Arco Nômade^n"

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@FRACTURED@ABILITY01@NAME"
msgstr "Raios Disruptivos"

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@FRACTURED@ABILITY02@CHAMPION_DESCRIPTION"
msgstr "Drenagem de Mana:[bulletlist][bullet/]Dano base aumenta para {MANA_DRAIN_UNIT_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.DISRUPTION_TOOLTIP_PROPERTY.Hyperlink} e a chance de {GLOBAL.PROPERTIES.MANA_STARVED.Hyperlink} aumenta para {MANA_DRAINED_RESISTANCE>ResolvedStrength}%[/bulletlist]"

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@FRACTURED@ABILITY02@CHAMPION_NAME"
msgstr "Drenagem de Mana do Campeão"

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@FRACTURED@ABILITY02@DESCRIPTION"
msgstr "Unidade alvo:[bulletlist][bullet/]Sofre dano.[bullet/]Tem chance base de {DISRUPTION_RESISTANCE>ResolvedStrength}% de se tornar {GLOBAL.PROPERTIES.DISRUPTION_TOOLTIP_PROPERTY.Hyperlink} por {DISRUPTION_DISABLE>Duration} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Tem chance base de {MANA_DRAINED_RESISTANCE>ResolvedStrength}% de se tornar {GLOBAL.PROPERTIES.MANA_DRAINED.Hyperlink} por {MANA_DRAINED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@FRACTURED@ABILITY02@NAME"
msgstr "Drenagem de Mana"

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@FRACTURED@ABILITY03@DESCRIPTION"
msgstr "Unidade alvo sofre dano. Acesse {GLOBAL.DefenseModeConcept.Hyperlink}."

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@FRACTURED@ABILITY03@NAME"
msgstr "Ferrão Disruptivo"

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@FRACTURED@ABILITY04@DESCRIPTION"
msgstr "Mover para o hexágono alvo."

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@FRACTURED@ABILITY04@NAME"
msgstr "Deslocamento de Fase"

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@FRACTURED@ABILITY05@DESCRIPTION"
msgstr "Unidades inimigas em um raio de {SEVERING_TREMOR_TARGETER>AREA>Radius} hexágonos:[bulletlist][bullet/]Sofrem dano.[bullet/]{GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink} unidades sofrem dano dobrado.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@FRACTURED@ABILITY05@NAME"
msgstr "Tremor Cortante"

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@FRACTURED@ABILITY06@DESCRIPTION"
msgstr "[bulletlist][bullet/]Cause dano a todas as unidades em um cone de {ANTIMAGIC_BREATH_TARGETER>AREA>Length} hexágonos.[bullet/]{GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink} unidades têm chance base de {ANTIMAGIC_BREATH_RESISTANCE_CHECK>ResolvedStrength}% de morrer instantaneamente.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@FRACTURED@ABILITY06@NAME"
msgstr "Sopro Anti-Mágico"

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@FRACTURED@ABILITY07@DESCRIPTION"
msgstr "No início do turno, unidades inimigas adjacentes:[bulletlist][bullet/]Sofrem {DISRUPTING_AURA_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Têm chance base de {DISRUPTION_RESISTANCE>ResolvedStrength}% de se tornar {GLOBAL.PROPERTIES.DISRUPTION_TOOLTIP_PROPERTY.Hyperlink} por {DISRUPTION_DISABLE>Duration} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@FRACTURED@ABILITY07@NAME"
msgstr "Aura Disruptiva"

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@FRACTURED@ABILITY08@DESCRIPTION"
msgstr "Unidade inimiga alvo:[bulletlist][bullet/]Sofre dano.[bullet/]Torna-se {GLOBAL.PROPERTIES.MANA_DRAINED.Hyperlink} por {MANA_DRAINED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][br/]Ao acertar, todas as outras unidades aliadas com {GLOBAL.PROPERTIES.MANA_STARVED.Hyperlink} ganham {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} e {GLOBAL.PROPERTIES.REGENERATION.Hyperlink} por {STRENGTHENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@FRACTURED@ABILITY08@NAME"
msgstr "Toque de Drenagem de Mana"

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@FRACTURED@SHARED@DESCRIPTION"
msgstr "Esta unidade:[bulletlist][bullet/]Ganha {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} e {GLOBAL.PROPERTIES.REGENERATION.Hyperlink} por {STRENGTHENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>:[bulletlist][bullet/]Quando aplica {GLOBAL.PROPERTIES.DISRUPTION_TOOLTIP_PROPERTY.Hyperlink} e {GLOBAL.PROPERTIES.MANA_DRAIN.Hyperlink}.[bullet/]Quando atingida por um ataque {GLOBAL.MagicConcept.Hyperlink}:[/bulletlist][bullet/]Não pode ter Encantamentos de Unidade ou Transformações.[bullet/]Possui {GLOBAL.ControlLossImmunityConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@FRACTURED@SHARED@NAME"
msgstr "Privado de Mana"

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@SAND_WORM@ABILITY01@DESCRIPTION"
msgstr "Unidades inimigas em um raio de {EARTH_TREMOR_TARGETER>AREA>Radius} hexágonos sofrem dano.[br/][br/]Causam dano dobrado aos obstáculos."

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@SAND_WORM@ABILITY01@NAME"
msgstr "Tremor Terrestre"

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@SAND_WORM@ABILITY02@DESCRIPTION"
msgstr "Chance base de {SAND_WORM_SWALLOW_WHOLE_RESISTANCE>ResolvedStrength}% de [hyperlink,GLOBAL.SwallowedConcept]Engolir[/hyperlink] uma unidade não‑herói."

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@SAND_WORM@ABILITY02@NAME"
msgstr "Engolir Inteiro"

msgid "DLC@RISEFROMRUIN@WONDER_PROPERTY@TSR_SOE@NAME"
msgstr "Deficiência de Mana"

msgid "@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@"
msgstr "@@@@@@"

msgid "@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@"
msgstr "@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@"

msgid "@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@"
msgstr "@@@@@@"

msgid "DLC@SECRETSOFTHEARCHMAGES@@ESSENCE_GRACE@SKIN_OWLKIN@BIO"
msgstr "Aves de rapina de olhos arregalados que inflam suas penas quando ameaçadas. Seus grasnidos sinalizam reverência ou aflição."

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY01@NAME"
msgstr "Atirar Teia"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY02@DESCRIPTION"
msgstr "Unidades adjacentes sofrem dano. Em seguida, teleportam para o hexágono alvo."

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY02@NAME"
msgstr "Retiro do Tecelão"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY03@DESCRIPTION"
msgstr "[bulletlist][bullet/]A unidade inimiga alvo sofre dano.[bullet/]Aumenta em {COMBUST_EXTRA_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} para cada {GLOBAL.PROPERTIES.BURNING.Hyperlink} que o alvo possui.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY03@NAME"
msgstr "Combustão"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY04@DESCRIPTION"
msgstr "A unidade inimiga alvo tem uma chance base de {RIDDLE_OF_LIGHT_CHECK>ResolvedStrength}% de ganhar {amount} do seguinte:[bulletlist][bullet/]{GLOBAL.PROPERTIES.STUNNED.Hyperlink} por {STUNNED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]{GLOBAL.PROPERTIES.BLINDED.Hyperlink} por {BLINDED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]{RIDDLE_OF_LIGHT_REPEATER_1>Count} {GLOBAL.PROPERTIES.BURNING.Hyperlink} por {BURNING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]{RIDDLE_OF_LIGHT_REPEATER_2>Count} {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink} e {RIDDLE_OF_LIGHT_REPEATER_2>Count} {GLOBAL.PROPERTIES.SUNDERED_RESISTANCE.Hyperlink} por {SUNDERED_DEFENSE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY04@NAME"
msgstr "Enigma da Luz"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY05@DESCRIPTION"
msgstr "A unidade inimiga alvo tem uma chance base de {RIDDLE_OF_NIGHT_CHECK>ResolvedStrength}% de ganhar {amount} dos seguintes:[bulletlist][bullet/]{GLOBAL.PROPERTIES.FROZEN.Hyperlink} por {FROZEN_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]{GLOBAL.PROPERTIES.INSANITY.Hyperlink} por {INSANITY_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]{RIDDLE_OF_NIGHT_REPEATER_1>Count} {GLOBAL.PROPERTIES.ELECTRIFIED.Hyperlink} por {ELECTRIFIED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]{RIDDLE_OF_NIGHT_REPEATER_2>Count} {GLOBAL.PROPERTIES.MISFORTUNE.Hyperlink} por {MISFORTUNE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY05@NAME"
msgstr "Enigma da Noite"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY06@DESCRIPTION"
msgstr "[bulletlist][bullet/]A unidade inimiga alvo sofre dano.[bullet/]Então, unidades amigas em um raio de {SUN_AND_LIFE_CIRCLE_TARGETER>AREA>Radius}-hex do alvo:[bulletlist][bullet/]Cura {SUN_AND_LIFE_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Remova {GENERAL_DISPEL_NEGATIVE>NumThingsToDispel} efeitos de status negativos.[/bulletlist][/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY06@NAME"
msgstr "Sol e Vida"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY07@DESCRIPTION"
msgstr "[bulletlist][bullet/]A unidade inimiga alvo sofre dano.[bullet/]Então, unidades amigas em um raio de {MOON_AND_SHADOW_CIRCLE_TARGETER>AREA>Radius}-hex do alvo:[bulletlist][bullet/]Ganhe {amount} {GLOBAL.EvasionConcept.Hyperlink} por {EVASION_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Remova {GENERAL_DISPEL_NEGATIVE>NumThingsToDispel} efeitos de status negativos.[/bulletlist][/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY07@NAME"
msgstr "Lua e Sombra"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY08@DESCRIPTION"
msgstr "No final do turno, unidades inimigas adjacentes a esta sofrem {PARASITIC_CORAL_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}. Em seguida, cure {PARASITIC_CORAL_LIFE_STEAL>MinHeal} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> por cada inimigo atingido."

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY08@NAME"
msgstr "Coral Parasítico"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY09@DESCRIPTION"
msgstr "Unidades de nível {tier} ou inferior {GLOBAL.PROPERTIES.PENGUIN.Hyperlink} no exército recebem:[bulletlist][bullet/]+{PENGUIN_COMMAND_DAMAGE>ResolvedMultiplier}% de dano.[bullet/]+{PENGUIN_COMMAND_DEFENSE>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[bullet/]+{PENGUIN_COMMAND_DEFENSE>BONUS>DEFENSE>Armor} {GLOBAL.DefenseConcept.Hyperlink}.[bullet/]+{PENGUIN_COMMAND_DEFENSE>BONUS>DEFENSE>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}[/bulletlist][br/]Não acumula."

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY09@NAME"
msgstr "Comandante Pinguim"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY09@PROP_DESCRIPTION"
msgstr "A unidade possui:[bulletlist][bullet/]+{PENGUIN_COMMAND_DAMAGE>ResolvedMultiplier}% de dano[bullet/]+{PENGUIN_COMMAND_DEFENSE>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]+{PENGUIN_COMMAND_DEFENSE>BONUS>DEFENSE>Armor} {GLOBAL.DefenseConcept.Hyperlink}[bullet/]+{PENGUIN_COMMAND_DEFENSE>BONUS>DEFENSE>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY09@PROP_NAME"
msgstr "Comando Pinguim"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY10@DESCRIPTION"
msgstr "Quando esta unidade morre, unidades em um raio de {GLITTER_EXPLOSION_UNIT_TARGETER>AREA>Radius}-hex:[bulletlist][bullet/]Sofrem {GLITTER_EXPLOSION_UNIT_DAMAGE>DAMAGE>Shock} {GLOBAL.LightningDamageConcept.Hyperlink} e {GLITTER_EXPLOSION_UNIT_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}. Metade para unidades amigas.[bullet/]Ganham um efeito de status negativo aleatório.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY10@NAME"
msgstr "Explosão Cintilante"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY11@DESCRIPTION"
msgstr "Unidade alvo:[bulletlist][bullet/]Sofre dano.[bullet/]Ganha {GLOBAL.PROPERTIES.INSANITY.Hyperlink} e {GLOBAL.PROPERTIES.TWISTED_BRAND_ON_DEATH.Hyperlink} até o fim da batalha.[/bulletlist][br/]Não afeta Heróis, Fey ou unidades de Cerco."

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY11@NAME"
msgstr "Marca Retorcida"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY11@PROP_DESCRIPTION"
msgstr "Quando esta unidade morre, transforma‑se em um {GLOBAL.UNITS.EVENING_SPRITE.Hyperlink} sob controle inimigo.[br/][br/]Se esta unidade sobreviver ao combate, evolui e pode ser mantida por um custo de {GLOBAL.ManaConcept.Hyperlink}."

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY11@PROP_NAME"
msgstr "Marca Fey"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY12@DESCRIPTION"
msgstr "Em uma linha de {RENDING_MIST_UNIT_TARGETER_LINE>AREA>Length}-hex de comprimento e {RENDING_MIST_UNIT_TARGETER_LINE>AREA>Width}-hex de largura:[bulletlist][bullet/]Unidades sofrem dano.[bullet/]Unidades ganham {amount} {GLOBAL.PROPERTIES.SUNDERED_RESISTANCE.Hyperlink}.[bullet/]Crie {GLOBAL.MistConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY12@NAME"
msgstr "Névoa Dilacerante"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY13@MOD_NAME"
msgstr "Truques Fey"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY14@MOD_DESCRIPTION"
msgstr "+{MIST_SLAYER>DAMAGE>Blight} {GLOBAL.BlightDamageConcept.Hyperlink} e +{MIST_SLAYER>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink} por {GLOBAL.PROPERTIES.CLINGING_MIST.Hyperlink} no alvo."

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY14@MOD_NAME"
msgstr "Caçador de Névoa"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY15@DESCRIPTION"
msgstr "Teleporte em direção ao inimigo alvo e cause dano. Em seguida, espalhe {GLOBAL.MistConcept.Hyperlink} sobre e ao redor do alvo."

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY15@NAME"
msgstr "Investida Nebulosa"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY16@DESCRIPTION"
msgstr "Inimigos em um raio de {PAINED_CRY_TARGETER>AREA>Radius}-hex:[bulletlist][bullet/]Sofrem dano.[bullet/]Se os alvos tiverem {GLOBAL.PROPERTIES.CLINGING_MIST.Hyperlink}:[bulletlist][bullet/]Sofrem {PAINED_CRY_DAMAGE_EXTRA>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink} extra.[bullet/]Eles têm uma chance base de {STUNNED_RESISTANCE>ResolvedStrength}% de se tornarem {GLOBAL.PROPERTIES.STUNNED.Hyperlink} por {STUNNED_RESISTANCE>SuccessMultiplier} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY16@NAME"
msgstr "Grito Dolorido"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY17@DESCRIPTION"
msgstr "No final do turno, crie uma nuvem de {GLOBAL.MistConcept.Hyperlink} nas casas da unidade e nas adjacentes."

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY17@NAME"
msgstr "Despertar das Névoas"

msgid "DLC@SECRETSOFTHEARCHMAGES@ARTIFACT@ARTICA@DESCRIPTION"
msgstr "Desbloqueia o feitiço: {GLOBAL.SPECIAL_OPERATIONS.ARCTICA'S_ICE_AGE.Hyperlink}."

msgid "DLC@SECRETSOFTHEARCHMAGES@ARTIFACT@ARTICA@NAME"
msgstr "Pergaminho Secreto de Artica"

msgid "DLC@SECRETSOFTHEARCHMAGES@ARTIFACT@BELBEDOR@DESCRIPTION"
msgstr "Desbloqueia o feitiço: {GLOBAL.SPECIAL_OPERATIONS.???'S_FEY_ABOMINATION.Hyperlink}."

msgid "DLC@SECRETSOFTHEARCHMAGES@ARTIFACT@BELBEDOR@NAME"
msgstr "Pergaminho Secreto de Belbedor"

