msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@TRAIT_CREEPING_MISTS@DESCRIPTION"
msgstr "Uma névoa antinatural se move sobre a terra, ameaçando todos que ficam dentro.[bulletlist][bullet/]<<m:{GLOBAL.ProvinceConcept.Hyperlink}>> com {GLOBAL.PROPERTIES.MISTY.Hyperlink} são [abilityblue]Perigoso[/abilityblue].[/bulletlist]"

