msgid "INTERFACE@STRATEGIC_MAP@FARM_HYPERLINK"
msgstr "[farm/] [hyperlink,GLOBAL.FarmConcept]Fazenda[/hyperlink]"

msgid "INTERFACE@STRATEGIC_MAP@FISHERY_DESCRIPTION"
msgstr "Uma Pesqueira é um {GLOBAL.ProvinceImprovementConcept.Hyperlink} base com os seguintes benefícios:[bulletlist][bullet/]Fornece renda de {GLOBAL.FoodConcept.Hyperlink}.{LOC.INTERFACE@STRATEGIC_MAP@BASE_IMPROVEMENT_DESCRIPTION}[/bulletlist]"

msgid "INTERFACE@STRATEGIC_MAP@FISHERY_HYPERLINK"
