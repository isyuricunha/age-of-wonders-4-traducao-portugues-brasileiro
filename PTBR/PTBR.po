msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SPI@NAME"
msgstr "Portal Arconte [teleporter/]"

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Convoque aliados Celestiais e ascenda suas unidades às fileiras dos Arcontes."

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@TOME@LORE_DESCRIPTION"
msgstr "\"Regozijem-se! Pois os Arcontes descem dos céus mais uma vez. O dia do juízo chegou, e você está exaltado ao lado de Titãs e Anjos. Anuncie sua chegada, testemunhe como sua fúria causa estragos nos ímpios e suas bênçãos concedem graça aos inocentes. Você, justo, não tema mais a morte — pois a ascensão é alcançada através do sacrifício.\""

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@TOME@NAME"
