msgid "DLC@EMPIRESANDASHES@WILDLIFE_PROPERTIES@PROGENITOR_GOLEM@ABILITY02@NAME"
msgstr "Convulsão Mágica"

msgid "DLC@EMPIRESANDASHES@WILDLIFE_PROPERTIES@PROGENITOR_GOLEM@ABILITY03@DESCRIPTION"
msgstr "A unidade inimiga alvo tem uma chance base de {LIMITED_SEAL_RESISTANCE>ResolvedStrength}% de se tornar {GLOBAL.PROPERTIES.SEAL.Hyperlink}."

msgid "DLC@EMPIRESANDASHES@WILDLIFE_PROPERTIES@PROGENITOR_GOLEM@ABILITY03@NAME"
msgstr "Selo Limitado"

msgid "DLC@EMPIRESANDASHES@WILDLIFE_PROPERTIES@PROGENITOR_GOLEM@ABILITY03@PROP_DESCRIPTION"
msgstr "Esta unidade:[bulletlist][bullet/]Não pode se mover ou agir.[bullet/]É imune a todo dano e efeitos de status.[bullet/]Não é considerada em batalha.[/bulletlist][br/]O efeito termina se a outra unidade vinculada morrer."

msgid "DLC@EMPIRESANDASHES@WILDLIFE_PROPERTIES@PROGENITOR_GOLEM@ABILITY03@PROP_NAME"
msgstr "Selada"

msgid "DLC@EMPIRESANDASHES@WILDLIFE_PROPERTIES@ROVING_FURNACE@ABILITY01@DESCRIPTION"
msgstr "Quando esta unidade ataca ou é atacada, unidades adjacentes:[bulletlist][bullet/]Sofrem {amount} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Têm uma chance base de {chance}% de se tornarem {GLOBAL.PROPERTIES.BURNING.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@WILDLIFE_PROPERTIES@ROVING_FURNACE@ABILITY01@MOD_DESCRIPTION"
msgstr "Unidades adjacentes:[bulletlist][bullet/]Sofrem {amount} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Têm uma chance base de {chance}% de se tornarem {GLOBAL.PROPERTIES.BURNING.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@WILDLIFE_PROPERTIES@ROVING_FURNACE@ABILITY01@NAME"
msgstr "Derramamento de Magma"

msgid "DLC@EMPIRESANDASHES@WILDLIFE_PROPERTIES@SCRAP_HERMIT@ABILITY01@DESCRIPTION"
msgstr "Unidades em um cone de {ACID_SPRAY_CONE_TARGETER>AREA>Length} hexes:[bulletlist][bullet/]Sofrem dano contínuo.[bullet/]Ganham {amount} {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@WILDLIFE_PROPERTIES@SCRAP_HERMIT@ABILITY01@NAME"
msgstr "Spray Ácido"

msgid "DLC@EMPIRESANDASHES@WILDLIFE_PROPERTIES@SCRAP_HERMIT@ABILITY02@DESCRIPTION"
msgstr "Ao acertar, esta unidade ganha {GATHER_METAL_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> e tem {GATHER_METAL_RESISTANCE_CHECK>ResolvedStrength}% de chance de ganhar {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink}."

msgid "DLC@EMPIRESANDASHES@WILDLIFE_PROPERTIES@SCRAP_HERMIT@ABILITY02@NAME"
msgstr "Coletar Metal"

msgid "DLC@EMPIRESANDASHES@WORLD_TRAIT@SEALS_VICTORY@ACTIVE@DESCRIPTION"
msgstr "Há Selos presentes neste reino. Capturá-los levará a um {GLOBAL.SealsVictoryConcept.Hyperlink}.[br/]- São necessários menos Pontos de Selo para alcançar a vitória."

msgid "DLC@EMPIRESANDASHES@WORLD_TRAIT@SEALS_VICTORY@ACTIVE@NAME"
msgstr "Selos Mundiais (Ativos)"

msgid "DLC@EMPIRESANDASHES@WORLD_TRAIT@SEALS_VICTORY@AMPLE@DESCRIPTION"
msgstr "Há Selos presentes neste reino. Capturá-los levará a um {GLOBAL.SealsVictoryConcept.Hyperlink}.[br/]- Há mais Selos presentes neste reino."

msgid "DLC@EMPIRESANDASHES@WORLD_TRAIT@SEALS_VICTORY@AMPLE@NAME"
msgstr "Selos Mundiais (Amplos)"

msgid "DLC@EMPIRESANDASHES@WORLD_TRAIT@SEALS_VICTORY@DEFAULT@DESCRIPTION"
msgstr "Há Selos presentes neste reino. Capturá-los levará a um {GLOBAL.SealsVictoryConcept.Hyperlink}."

msgid "DLC@EMPIRESANDASHES@WORLD_TRAIT@SEALS_VICTORY@DEFAULT@NAME"
msgstr "Selos Mundiais"

msgid "DLC@EMPIRESANDASHES@WORLD_TRAIT@SEALS_VICTORY@DORMANT@DESCRIPTION"
msgstr "Há Selos presentes neste reino. Capturá-los levará a um {GLOBAL.SealsVictoryConcept.Hyperlink}.[br/]- São necessários mais Pontos de Selo para alcançar a vitória."

msgid "DLC@EMPIRESANDASHES@WORLD_TRAIT@SEALS_VICTORY@DORMANT@NAME"
msgstr "Selos Mundiais (Inativos)"

msgid "DLC@EMPIRESANDASHES@WORLD_TRAIT@SEALS_VICTORY@SCARCE@DESCRIPTION"
msgstr "Há selos presentes neste reino. Capturá-los levará a um {GLOBAL.SealsVictoryConcept.Hyperlink}.[br/]- Há menos selos presentes neste reino."

msgid "DLC@EMPIRESANDASHES@WORLD_TRAIT@SEALS_VICTORY@SCARCE@NAME"
msgstr "Selos Mundiais (Escassos)"

