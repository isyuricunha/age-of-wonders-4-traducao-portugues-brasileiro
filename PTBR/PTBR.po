msgid "COMBATPROPERTIES_TACTICAL@FOCUSED_GAZE@NAME"
msgstr "Olhar Focado"

msgid "COMBATPROPERTIES_TACTICAL@FOCUSSED_GAZE@NAME"
msgstr "Olhar Focado"

msgid "COMBATPROPERTIES_TACTICAL@FREEZING_WINDS@DESCRIPTION"
msgstr "A cada {timer} [turn/], todas as unidades atacantes sofrem {damage} e têm {chance} de chance de sofrer {GLOBAL.PROPERTIES.FROZEN.Hyperlink}. Se falhar, as unidades sofrem {GLOBAL.SlowingConcept.Hyperlink} em vez disso."

msgid "COMBATPROPERTIES_TACTICAL@FREEZING_WINDS@NAME"
msgstr "Ventos Congelantes"

msgid "COMBATPROPERTIES_TACTICAL@FRIGID_WINDS@DESCRIPTION"
msgstr "Depois que um Relâmpago da Tempestade de Relâmpagos atinge, todas as unidades defensoras recebem {damage} {GLOBAL.FrostDamageConcept.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@FRIGID_WINDS@NAME"
