msgstr "Uma antiga terra Krazura, espalhada por místicos Selos de Poder. Quem controla os Selos pode reivindicar o reino para si."

msgid "META_EMPIRE@REALM_SEAL@TEMPLATE_NAME"
msgstr "Selos de Poder"

msgid "META_EMPIRE@REALM_SHIRE@NAME_1"
msgstr "Greenshire"

