msgid "DLC@THRONESOFBLOOD@NODES_STRATEGIC@BLOOD_GLASS@LORE"
msgstr "\"Uma flor sedutora, aprisionando suas vítimas em uma prisão espinhosa. Do sangue drenado delas brotam cristais carmesins. Meus druidas, usando pingentes deste Vidro Carmesim, sentem-se rejuvenescidos ao amanhecer, como se a força vital sugada lhes fosse concedida. Ainda assim, em sussurros noturnos invocam o nome do [hyperlink,GLOBAL.UrvatoghLoreConcept]Príncipe Pálido[/hyperlink], e eu me pergunto: é errado aproveitar sua maldição?\"[br/][br/]— Sylvani Laurel, Sobrevivendo nas Terras Sem Sol"

msgid "DLC@THRONESOFBLOOD@NODES_STRATEGIC@BLOOD_GLASS@NAME"
msgstr "Vidro Carmesim^ns"

msgid "DLC@THRONESOFBLOOD@NODES_STRATEGIC@NODES@RUINED_BLOOD_GLASS@NAME"
msgstr "Vidro Carmesim Arruinado"

msgid "DLC@THRONESOFBLOOD@ONBOARDING_OBJECTIVES@VAMPIRE_CASTLE@DESCRIPTION"
msgstr "Sua {GLOBAL.ThroneCityConcept.Hyperlink} cresceu o suficiente para que você possa construir um Castelo Vampiro. Este farol do seu poder concede muitos bônus, incluindo valioso {GLOBAL.ImperiumConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@ONBOARDING_OBJECTIVES@VAMPIRE_CASTLE@FINISHER@DESCRIPTION"
msgstr "Você concluiu a construção do primeiro andar do seu Castelo Vampiro. Agora pode construir seu primeiro conjunto de salas e melhorias!"

msgid "DLC@THRONESOFBLOOD@ONBOARDING_OBJECTIVES@VAMPIRE_CASTLE@FINISHER@INSTRUCTIONS"
msgstr "De particular interesse:[bulletlist][bullet/]O {GLOBAL.STRUCTURE_UPGRADES.LORD_CASTLE_2.Hyperlink} permite que você lance <<m:{GLOBAL.StrategicSummonSpellConcept.Hyperlink}>> mais poderosos.[bullet/]O [hyperlink,GLOBAL.ItemForgeConcept]{GLOBAL.STRUCTURE_UPGRADES.LORD_CASTLE_SOUL_FORGE.Name}[/hyperlink] permite que você crie equipamentos para seus heróis.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@ONBOARDING_OBJECTIVES@VAMPIRE_CASTLE@FINISHER@NAME"
msgstr "Castelo Vampiro Concluído"

msgid "DLC@THRONESOFBLOOD@ONBOARDING_OBJECTIVES@VAMPIRE_CASTLE@FINISHER@PAGE02@DESCRIPTION"
msgstr "Seu Castelo também permite que você comece a coletar <<m:{GLOBAL.ThrallConcept.Hyperlink}>>, que pode sacrificar para lançar o poderoso ritual <<m:{GLOBAL.SpellConcept.Hyperlink}>>."

msgid "DLC@THRONESOFBLOOD@ONBOARDING_OBJECTIVES@VAMPIRE_CASTLE@FINISHER@PAGE02@INSTRUCTIONS"
msgstr "Você pode aumentar a velocidade com que ganha escravos aumentando a renda de {GLOBAL.FoodConcept.Hyperlink} da sua {GLOBAL.ThroneCityConcept.Hyperlink}.[br/][br/]Você pode desbloquear mais <<m:{GLOBAL.SpellConcept.Hyperlink}>> ao melhorar seu castelo."

msgid "DLC@THRONESOFBLOOD@ONBOARDING_OBJECTIVES@VAMPIRE_CASTLE@FINISHER@SUMMARY"
msgstr "Tutorial sobre o seu Castelo Vampiro concluído"

msgid "DLC@THRONESOFBLOOD@ONBOARDING_OBJECTIVES@VAMPIRE_CASTLE@NAME"
msgstr "O Castelo Vampiro"

msgid "DLC@THRONESOFBLOOD@ONBOARDING_OBJECTIVES@VAMPIRE_CASTLE@OBJECTIVE"
msgstr "Castelo Vampiro Construído"

msgid "DLC@THRONESOFBLOOD@ONBOARDING_OBJECTIVES@VAMPIRE_CASTLE@SUMMARY"
msgstr "Tutorial sobre como construir um Castelo Vampiro"

msgid "DLC@THRONESOFBLOOD@RITUAL_SPELL_01@NAME"
msgstr "Ritual de Transferência de Sangue"

msgid "DLC@THRONESOFBLOOD@RITUAL_SPELL_01@SPELL_DESCRIPTION"
msgstr "No exército aliado alvo:[bulletlist][bullet/]Cura Vampiros em {amount}% de seu máximo <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[bullet/]Cura não‑Vampiros em {amount2}% de seu máximo <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@RITUAL_SPELL_02@NAME"
msgstr "Ritual de Desecração"

msgid "DLC@THRONESOFBLOOD@RITUAL_SPELL_02@SPELL_DESCRIPTION"
msgstr "Província alvo e adjacente <<m:{GLOBAL.ProvinceConcept.Hyperlink}>>:[bulletlist][bullet/]Ganha {GLOBAL.SunlessConcept.Hyperlink}.[bullet/]Exércitos inimigos recebem {amount} de {GLOBAL.FrostDamageConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@RITUAL_SPELL_03@DESCRIPTION"
msgstr "Nos próximos {amount} {GLOBAL.WorldMapConcept.Hyperlink} <<m:{GLOBAL.TurnConcept}>> Vampiros:[bulletlist][bullet/]Não sofram {GLOBAL.PROPERTIES.SUNLIGHT_WEAKNESS.Hyperlink}.[bullet/]+{amount2} {GLOBAL.HitPointConcept.Hyperlink} de regeneração no Mapa‑Múndi.[bullet/]Ganhe +{amount3}% de dano.[bullet/]Ganhe +{amount4} {GLOBAL.ResistanceConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@RITUAL_SPELL_03@DESCRIPTION_HAPPENING"
msgstr "Nos próximos 10 {GLOBAL.WorldMapConcept.Hyperlink} <<m:{GLOBAL.TurnConcept}>> Vampiros:[bulletlist][bullet/]Não sofram {GLOBAL.PROPERTIES.SUNLIGHT_WEAKNESS.Hyperlink}.[bullet/]+15 {GLOBAL.HitPointConcept.Hyperlink} de regeneração no Mapa‑Múndi.[bullet/]Ganhe +20% de dano.[bullet/]Ganhe +2 {GLOBAL.ResistanceConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@RITUAL_SPELL_03@NAME"
msgstr "Ritual da Lua de Sangue"

msgid "DLC@THRONESOFBLOOD@RITUAL_SPELL_03@PROP_DESCRIPTION"
msgstr "Esta unidade:[bulletlist][bullet/]Não sofre {GLOBAL.PROPERTIES.SUNLIGHT_WEAKNESS.Hyperlink}.[bullet/]Tem +{BLOOD_MOON_RITUAL_STAT_BONUS>BONUS>Regen} de regeneração no Mapa‑Múndi.[bullet/]Tem +{BLOOD_MOON_RITUAL_DAMAGE>ResolvedMultiplier}% de dano.[bullet/]Tem +{BLOOD_MOON_RITUAL_RESISTANCE>DEF_MOD>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@RITUAL_SPELL_04@NAME"
msgstr "Ritual de Vivissecção"

msgid "DLC@THRONESOFBLOOD@RITUAL_SPELL_04@SPELL_DESCRIPTION"
msgstr "Exército inimigo sofre {amount} {GLOBAL.PhysicalDamageConcept.Hyperlink} de dano. Em seguida ganha +{amount2} {GLOBAL.KnowledgeConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@RITUAL_SPELL_05@DISPLAY_PROPERTY_DESCRIPTION"
msgstr "Esta província ganhou temporariamente {GLOBAL.SunlessConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@RITUAL_SPELL_05@NAME"
msgstr "Ritual do Véu das Trevas"

msgid "DLC@THRONESOFBLOOD@RITUAL_SPELL_05@SPELL_DESCRIPTION"
msgstr "A superfície alvo <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> ganha {GLOBAL.SunlessConcept.Hyperlink} por {duration} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@THRONESOFBLOOD@ROSE_PALACE@REWARD_HERO_FEMALE@FIRSTNAME_01"
msgstr "Rosa^F"

msgid "DLC@THRONESOFBLOOD@ROSE_PALACE@REWARD_HERO_FEMALE@LASTNAME_01"
msgstr "de Espinhos^z"

msgid "DLC@THRONESOFBLOOD@ROSE_PALACE@REWARD_HERO_MALE@FIRSTNAME_01"
msgstr "Thorne^M"

msgid "DLC@THRONESOFBLOOD@ROSE_PALACE@REWARD_HERO_MALE@LASTNAME_01"
msgstr "de Rosas^z"

msgid "DLC@THRONESOFBLOOD@SECTORDEFINITIONS_STRATEGIC@CRIMSON_COURT_STRATEGIC_PROP@DESCRIPTION"
msgstr "[bulletlist][bullet/]Ganhe {amount} {GLOBAL.ManaConcept.Hyperlink} ao concluir com sucesso {GLOBAL.PillagingConcept.Hyperlink} um {GLOBAL.ProvinceImprovementConcept.Hyperlink}.[bullet/]Ganhe {amount2} {GLOBAL.ManaConcept.Hyperlink} ao concluir com sucesso {GLOBAL.RazingConcept.Hyperlink} uma {GLOBAL.CityConcept.Hyperlink} conquistada por {GLOBAL.PopulationConcept.Hyperlink} e {GLOBAL.ProvinceImprovementConcept.Hyperlink} que não foi saqueada.[bullet/]Ganhe {amount3} {GLOBAL.ManaConcept.Hyperlink} ao concluir com sucesso {GLOBAL.MigratingConcept.Hyperlink} uma {GLOBAL.CityConcept.Hyperlink} conquistada por {GLOBAL.PopulationConcept.Hyperlink}. Mas a Cidade perde [population/] População adicional depois.[bullet/]<<m:{GLOBAL.PvEVassalConcept.Hyperlink}>> concede {amount4} {GLOBAL.ManaConcept.Hyperlink} de renda por {GLOBAL.PopulationConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@SECTORDEFINITIONS_STRATEGIC@CRIMSON_COURT_STRATEGIC_PROP@HYPERLINK"
msgstr "[hyperlink,GLOBAL.CrimsonCourtMagistrateConcept]Magistrado da Corte Carmesim[/hyperlink]"

msgid "DLC@THRONESOFBLOOD@SECTORDEFINITIONS_STRATEGIC@CRIMSON_COURT_STRATEGIC_PROP@NAME"
msgstr "Magistrado da Corte Carmesim"

msgid "DLC@THRONESOFBLOOD@SECTORDEFINITIONS_STRATEGIC@SUNLESS_FEATURE@DESCRIPTION"
msgstr "Um {GLOBAL.ProvinceFeatureConcept.Hyperlink}[br/][br/]A ausência de luz solar espalhou flora espinhosa e sombria pontuada por rosas carmesins.[br/][bulletlist][bullet/]<<m:{GLOBAL.CityConcept.Hyperlink}>> anexando esta {GLOBAL.ProvinceConcept.Hyperlink} sofre {stabilitypenalty} {GLOBAL.CityStabilityConcept.Hyperlink}.[bullet/]<<m:{GLOBAL.UnitConcept.Hyperlink}>> regenera {regen} <<m:{GLOBAL.HitPointConcept.Hyperlink}>> por {GLOBAL.TurnConcept.Hyperlink} no {GLOBAL.WorldMapConcept.Hyperlink}.[bullet/]<<m:{GLOBAL.UnitConcept.Hyperlink}>> apenas recebe {percentage} de <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> ao ser curado em {GLOBAL.CombatConcept.Hyperlink}.[bullet/]Unidades e Cidades que possuam {GLOBAL.PROPERTIES.HEARTLESS.Hyperlink} ou pertençam a um império liderado por um {GLOBAL.VampireLordConcept.Hyperlink} são imunes a esses efeitos.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@SECTORDEFINITIONS_STRATEGIC@SUNLESS_FEATURE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.SunlessConcept]Sem Sol[/hyperlink]"

msgid "DLC@THRONESOFBLOOD@SECTORDEFINITIONS_STRATEGIC@SUNLESS_FEATURE@NAME"
msgstr "Sem Sol"

msgid "DLC@THRONESOFBLOOD@SECTORDEFINITIONS_STRATEGIC@SUNLESS_FEATURE@PROPERTY_DESCRIPTION"
msgstr "Unidades sem {GLOBAL.PROPERTIES.HEARTLESS.Hyperlink} em terreno sem Sol regeneram {regen} <<m:{GLOBAL.HitPointConcept.Hyperlink}>> por {GLOBAL.TurnConcept.Hyperlink} no {GLOBAL.WorldMapConcept.Hyperlink} e recebem apenas {percentage} de <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> ao serem curadas em {GLOBAL.CombatConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@SHAREDMODIFIERS_UNITPROPERTIES@BENEVOLENT_BLOOD_PARASITE@DESCRIPTION"
msgstr "Ao morrer, a unidade gera um {GLOBAL.UNITS.BLOOD_MAGGOT.Hyperlink} sob o controle do defensor até o fim do combate."

msgid "DLC@THRONESOFBLOOD@SHAREDMODIFIERS_UNITPROPERTIES@BENEVOLENT_BLOOD_PARASITE@NAME"
msgstr "Parasita de Sangue Benevolente"

msgid "DLC@THRONESOFBLOOD@SHAREDMODIFIERS_UNITPROPERTIES@BERSERK_BLOOD_PARASITE@DESCRIPTION"
msgstr "Ao morrer, a unidade gera um {GLOBAL.UNITS.BLOOD_MAGGOT.Hyperlink} com {GLOBAL.PROPERTIES.BERSERK.Hyperlink} sob o controle do defensor até o fim do combate."

msgid "DLC@THRONESOFBLOOD@SHAREDMODIFIERS_UNITPROPERTIES@BERSERK_BLOOD_PARASITE@NAME"
msgstr "Parasita de Sangue Frenético"

msgid "DLC@THRONESOFBLOOD@SHAREDMODIFIERS_UNITPROPERTIES@BLOOD_PARASITE@DESCRIPTION"
msgstr "[bulletlist][bullet/]A unidade sofre {BLOOD_PARASITE_DAMAGE_OVER_TIME>ATTACK>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink} a cada [turn/].[bullet/]Substitui e conta como {GLOBAL.PROPERTIES.BLEEDING.Hyperlink}, mas ignora {GLOBAL.PROPERTIES.STATUS_EFFECT_IMMUNITY_BLEEDING.Hyperlink}.[bullet/]Acumula até {amount} vezes.[/bulletlist][bulletlist][br/]Ao morrer, a unidade gera um {GLOBAL.UNITS.BLOOD_MAGGOT.Hyperlink} sob o controle do oponente até o fim do combate.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@SHAREDMODIFIERS_UNITPROPERTIES@BLOOD_PARASITE@GUARANTEED_MODIFIER_DESCRIPTION"
msgstr "Inflige {GLOBAL.PROPERTIES.BLOOD_PARASITE.Hyperlink} por {BLOOD_PARASITE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "DLC@THRONESOFBLOOD@SHAREDMODIFIERS_UNITPROPERTIES@BLOOD_PARASITE@MODIFIER_DESCRIPTION"
msgstr "Chance base de {BLOOD_PARASITE_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.BLOOD_PARASITE.Hyperlink} por {BLOOD_PARASITE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "DLC@THRONESOFBLOOD@SHAREDMODIFIERS_UNITPROPERTIES@BLOOD_PARASITE@NAME"
msgstr "Parasita de Sangue"

msgid "DLC@THRONESOFBLOOD@SHAREDMODIFIERS_UNITPROPERTIES@COAGULATE@DESCRIPTION"
msgstr "Uma vez por turno, ao ser atingido por um ataque, ganha por {BOLSTERED_DEFENSE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>:[bulletlist][bullet/]{GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink}[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@SHAREDMODIFIERS_UNITPROPERTIES@COAGULATE@NAME"
msgstr "Coagular"

msgid "DLC@THRONESOFBLOOD@SHAREDMODIFIERS_UNITPROPERTIES@LIFEDRINKER@DESCRIPTION"
msgstr "Quando uma unidade adjacente morre:[bulletlist][bullet/]Ganha {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} por {STRENGTHENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Cura {LIFEDRINKER_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@SHAREDMODIFIERS_UNITPROPERTIES@LIFEDRINKER@NAME"
msgstr "Sugador de Vida"

msgid "DLC@THRONESOFBLOOD@SHOPS_STRATEGIC@BEAST_WRANGLER@EXOTIC_DOOM_BAT"
msgstr "Contrato de Montaria de Morcego Gritante"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@TURNED_VAMPIRE_BONUS@DESCRIPTION"
msgstr "Esta unidade possui:[bulletlist][bullet/]+{TURNED_VAMPIRE_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>> e +{TURNED_VAMPIRE_BONUS>BONUS>DEFENSE>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}.[/bulletlist][br/]Um Vampiro Transformado ganha uma pilha disso para cada Habilidade Marcante que o Vampiro Ancião possui."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@TURNED_VAMPIRE_BONUS@NAME"
msgstr "Dom do Vampiro Ancião"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@BATSWARM@ABILITY_DESCRIPTION"
msgstr "Unidades inimigas adjacentes:[bulletlist][bullet/]Sofrem dano.[bullet/]Têm chance base de {BLINDED_RESISTANCE>ResolvedStrength}% de se tornar {GLOBAL.PROPERTIES.BLINDED.Hyperlink} por {BLINDED_EFFECT_DESCRIPTION>NumTurns} {GLOBAL.TurnConcept}.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@BATSWARM@ABILITY_NAME"
msgstr "Enxame de Morcegos"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@BLOOD@SKILL01@ABILITY_DESCRIPTION"
msgstr "Sofre dano inbloqueável igual a {BLOOD_EMPOWERMENT_DAMAGE>ResolvedDamageProportion}% do seu <<m:{GLOBAL.HitPointConcept.Hyperlink}>> máximo. Seu próximo ataque neste turno causa +{BLOOD_EMPOWERMENT_DAMAGE_MULTIPLIER>ResolvedMultiplier}% de dano."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@BLOOD@SKILL01@ABILITY_NAME"
msgstr "Empoderamento de Sangue"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@BLOOD@SKILL01@MOD_DESCRIPTION"
msgstr "O próximo ataque neste turno causa +{BLOOD_EMPOWERMENT_DAMAGE_MULTIPLIER>ResolvedMultiplier}% de dano."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@BLOOD@SKILL01@NAME"
msgstr "Hemomante"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@BLOOD@SKILL01@PASSIVE_DESCRIPTION"
msgstr "Recupera {BLOOD_RECOVERY_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> ao eliminar uma unidade com um ataque {GLOBAL.MagicConcept.Hyperlink}, {GLOBAL.MeleeConcept.Hyperlink} ou {GLOBAL.RangedConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@BLOOD@SKILL01@PASSIVE_NAME"
msgstr "Recuperação de Sangue"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@BLOOD@SKILL02@DESCRIPTION"
msgstr "[bulletlist][bullet/]Ataques infligem {GLOBAL.PROPERTIES.BLEEDING.Hyperlink} por {BLEEDING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>, aumentados para Disparos Únicos.[bullet/]Quando um inimigo sofre dano de {GLOBAL.PROPERTIES.BLEEDING.Hyperlink}, ganha {amount} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@BLOOD@SKILL02@NAME"
msgstr "Bebedor de Medula"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@BLOOD@SKILL03@DESCRIPTION"
msgstr "Ganha:[bulletlist][bullet/]{GLOBAL.PROPERTIES.VERY_FAST_MOVEMENT.Hyperlink}[bullet/]+{BLOOD_WARRIOR_EVASION>ResolvedAccuracyModifier}% {GLOBAL.EvasionConcept.Hyperlink}[bullet/]+{BLOOD_WARRIOR_HIT_POINTS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@BLOOD@SKILL03@NAME"
msgstr "Mestria Corporal Profana"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@BLOOD@SKILL03@PROP_DESCRIPTION"
msgstr "A unidade possui:[bulletlist][bullet/]{GLOBAL.PROPERTIES.VERY_FAST_MOVEMENT.Hyperlink}[bullet/]+{BLOOD_WARRIOR_EVASION>ResolvedAccuracyModifier}% {GLOBAL.EvasionConcept.Hyperlink}[bullet/]+{BLOOD_WARRIOR_HIT_POINTS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@BLOOD@SKILL04@ABILITY_DESCRIPTION"
msgstr "Alvo:[bulletlist][bullet/]Sofre dano que ignora {EXSANGUINATE_DEFENSE_BYPASS>MODIFIERS>ResolvedArmor}% de {GLOBAL.DefenseConcept.Hyperlink} e {GLOBAL.ResistanceConcept.Hyperlink}.[bullet/]Ganha {amount} {GLOBAL.PROPERTIES.BLEEDING.Hyperlink} por {BLEEDING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@BLOOD@SKILL04@MOD_NAME"
msgstr "Desvio de Exsanguinação"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@BLOOD@SKILL04@NAME"
msgstr "Exsanguinar"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@BLOOD@SKILL06@DESCRIPTION"
msgstr "{GLOBAL.PROPERTIES.EXSANGUINATE.Hyperlink} agora causa {VIOLENT_EXSANGUINATION_TARGETER>ResolvedEffectMultiplier}% do seu dano a inimigos adjacentes, ignorando {VIOLENT_EXSANGUINATION_TARGETER>ResolvedEffectMultiplier}% da {GLOBAL.DefenseConcept.Hyperlink} inimiga e da {GLOBAL.ResistanceConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@BLOOD@SKILL06@MOD_DESCRIPTION"
msgstr "+{amount} {GLOBAL.FireDamageConcept.Hyperlink} por pilha de {GLOBAL.PROPERTIES.BLEEDING.Hyperlink}.[br/]+{BOILING_BLOOD_BLOOD_PARASITE_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} se afetado por {GLOBAL.PROPERTIES.BLOOD_MAGGOT.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@BLOOD@SKILL06@NAME"
msgstr "Exsanguinação Violenta"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@BLOOD@SKILL07@ABILITY_DESCRIPTION"
msgstr "Alvo unidade aliada e o conjurador:[bulletlist][bullet/]Cura {BLOOD_COMMUNION_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Remove {GENERAL_DISPEL_NEGATIVE>NumThingsToDispel} efeitos de status negativos.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@BLOOD@SKILL07@NAME"
msgstr "Comunhão de Sangue"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@BLOOD@SKILL09@ABILITY_DESCRIPTION"
msgstr "Alvo unidade aliada e o conjurador:[bulletlist][bullet/]Cura {BLOOD_COMMUNION_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Remove {GENERAL_DISPEL_NEGATIVE>NumThingsToDispel} efeitos de status negativos.[/bulletlist][br/]Unidades inimigas adjacentes ao alvo e ao conjurador têm chance base de {BLOOD_PARASITE_RESISTANCE>ResolvedStrength}% de ganhar {GLOBAL.PROPERTIES.BLOOD_PARASITE.Hyperlink} por {BLOOD_PARASITE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@BLOOD@SKILL09@DESCRIPTION"
msgstr "{GLOBAL.PROPERTIES.BLOOD_COMMUNION.Hyperlink} agora tem uma chance base de {BLOOD_PARASITE_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.BLOOD_PARASITE.Hyperlink} por {BLOOD_PARASITE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>> aos inimigos adjacentes ao conjurador e ao alvo."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@BLOOD@SKILL09@NAME"
msgstr "Comunhão Parasítica"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@BLOOD@SKILL10@DESCRIPTION"
msgstr "Mover para o hexágono alvo."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@BLOOD@SKILL10@HERO_PASSIVE_DESCRIPTION"
msgstr "Esta unidade tem {GLOBAL.PROPERTIES.VERY_FAST_MOVEMENT.Hyperlink} quando não está montada."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@BLOOD@SKILL10@NAME"
msgstr "Velocidade Sobrenatural"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@BLOOD@SKILL10@PASSIVE_DESCRIPTION"
msgstr "Esta unidade e todos os Vampiros Transformados sob seu comando têm {GLOBAL.PROPERTIES.VERY_FAST_MOVEMENT.Hyperlink} quando não estão montados.[br/][br/]Se o Vampiro Ancião possui {GLOBAL.PROPERTIES.BLOOD_WARRIOR_PROP_GROUP.Hyperlink}, ele ganha +{amount}% de chance de {GLOBAL.CriticalHitConcept.Hyperlink} em vez disso, mesmo quando montado."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@BLOOD@SKILL10@PASSIVE_NAME"
msgstr "Velocidade Excepcional"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@BLOOD@SKILL10@PROP_DESCRIPTION"
msgstr "O próximo ataque neste turno causa +{SUPERNATURAL_SPEED_EXTRA_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}. O dano aumenta para ataques de Disparo Único."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@BLOODBLIGHT@ABILITY_DESCRIPTION"
