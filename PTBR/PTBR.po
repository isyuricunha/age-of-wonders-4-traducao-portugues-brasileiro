msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@DESECRATION@SKILL07@ABILITY_DESCRIPTION"
msgstr "Unidades inimigas em um raio de {CURSE_TO_UNDEATH_CIRCLE_TARGETER>AREA>Radius} hexágonos:[bulletlist][bullet/]Sofrem dano.[bullet/]Tornam-se {GLOBAL.PROPERTIES.SOULBOUND.Hyperlink} até o fim do combate.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@DESECRATION@SKILL07@NAME"
msgstr "Maldição da Não-Morte"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@DESECRATION@SKILL09@DESCRIPTION"
msgstr "No início do turno, unidades inimigas com {GLOBAL.PROPERTIES.SOULBOUND.Hyperlink} sofrem {SOULBOUND_ANGUISH_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@DESECRATION@SKILL09@NAME"
msgstr "Angústia Vinculada"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@DESECRATION@SKILL13@ABILITY_DESCRIPTION"
msgstr "Alvo unidade inimiga:[bulletlist][bullet/]Sofre dano.[bullet/]Ganha {amount} {GLOBAL.PROPERTIES.POISONED.Hyperlink} por {POISONED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Ganha {amount2} {GLOBAL.PROPERTIES.DECAYING.Hyperlink} por {DECAYING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@DESECRATION@SKILL13@NAME"
msgstr "Espinha Putrefata"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@DESECRATION@SKILL15@DESCRIPTION"
msgstr "Quando {GLOBAL.PROPERTIES.FESTERING_SPINE.Hyperlink} mata uma unidade, todas as unidades inimigas em um raio de {MIASMIC_SPINE_TARGETER>AREA>Radius} hexágonos ganham {amount} {GLOBAL.PROPERTIES.POISONED.Hyperlink} e {amount2} {GLOBAL.PROPERTIES.DECAYING.Hyperlink} por {DECAYING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@DESECRATION@SKILL15@MOD_DESCRIPTION"
msgstr "Ao matar, todas as unidades inimigas em um raio de {MIASMIC_SPINE_TARGETER>AREA>Radius} hexágonos ganham {amount} {GLOBAL.PROPERTIES.POISONED.Hyperlink} e {amount2} {GLOBAL.PROPERTIES.DECAYING.Hyperlink} por {DECAYING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@DESECRATION@SKILL15@NAME"
msgstr "Espinha Miasmática"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@NIGHTLORD@DESCRIPTION"
msgstr "[bulletlist][bullet/]Unidade é imune a {GLOBAL.PROPERTIES.BLINDED.Hyperlink}.[bullet/]Enquanto estiver em Sem Sol, Subterrâneo ou Trevas, esta unidade tem:[bulletlist][bullet/]+{amount}% de dano.[bullet/]{GLOBAL.PROPERTIES.NATURAL_REGENERATION_GROUP.Hyperlink}.[/bulletlist][/bulletlist]"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@NIGHTLORD@NAME"
msgstr "Senhor da Noite"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@NIGHTSWORN@NAME"
msgstr "Juramentado Noturno"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@NIGHTSWORN@PASSIVE_DESCRIPTION"
msgstr "No início do combate, conjure um {GLOBAL.UNITS.DOOM_BAT.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@NIGHTSWORN@PASSIVE_NAME"
msgstr "Criatura Noturna"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@REAPER@DESCRIPTION"
msgstr "Ao matar:[bulletlist][bullet/]Os tempos de recarga ativos são reduzidos em {REAPER_COOLDOWN_EFFECT>Amount of Turns} {GLOBAL.TurnConcept}.[bullet/]Ganha +{REAPER_STAT>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>> durante a batalha.[/bulletlist][br/]Dispara uma vez por turno."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@REAPER@NAME"
msgstr "Ceifador"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@REAPER@PROP_DESCRIPTION"
msgstr "A unidade tem +{REAPER_STAT>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>> por pilha."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@SHARED_UPKEEP_01@DESCRIPTION"
msgstr "A manutenção aumenta em {VAMPIRE_LORD_UPKEEP>FlatUpkeep} {GLOBAL.GoldConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@SHARED_UPKEEP_01@NAME"
msgstr "Manutenção Aumentada"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@SPREADING_BLIGHT@ABILITY_DESCRIPTION"
msgstr "Alvo unidade inimiga e {SPREADING_BLIGHT_JUMP_TARGETER>MaxJumps} outros dentro de {SPREADING_BLIGHT_JUMP_TARGETER>MaxDistance} hexágonos:[bulletlist][bullet/]Sofre dano.[bullet/]Ganha {amount} {GLOBAL.PROPERTIES.BLOOD_PARASITE.Hyperlink} por {BLOOD_PARASITE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@SPREADING_BLIGHT@DESCRIPTION"
msgstr "{GLOBAL.PROPERTIES.BLOODBLIGHT.Hyperlink} agora se espalha para {SPREADING_BLIGHT_JUMP_TARGETER>MaxJumps} unidades inimigas dentro de {SPREADING_BLIGHT_JUMP_TARGETER>MaxDistance} hexágonos."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@SPREADING_BLIGHT@NAME"
msgstr "Propagação de Calamidade"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@TYRANNY@SKILL01@ABILITY_DESCRIPTION"
msgstr "Alvo unidade inimiga:[bulletlist][bullet/]Ganha {TORMENT_REPEATER>Count} {GLOBAL.PROPERTIES.TORMENT.Hyperlink} até o fim do combate.[bullet/]Ganha {GLOBAL.PROPERTIES.STATUS_VULNERABILITY.Hyperlink} por {STATUS_VULNERABILITY_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Perde {DREAD_MORALE_DAMAGE>Morale Change Absolute} {GLOBAL.UnitMoraleConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@TYRANNY@SKILL01@ABILITY_NAME"
msgstr "Temor"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@TYRANNY@SKILL01@NAME"
msgstr "Terrível"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@TYRANNY@SKILL01@PASSIVE_DESCRIPTION"
msgstr "Ataques causam perda de {TYRANT_MORALE_CHANGE>Morale Change Absolute} {GLOBAL.UnitMoraleConcept.Hyperlink} no alvo. Dobra em ataques de Disparo Único."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@TYRANNY@SKILL01@PASSIVE_MOD_DESCRIPTION"
msgstr "Inflige perda de {TYRANT_MORALE_CHANGE>Morale Change Absolute} {GLOBAL.UnitMoraleConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@TYRANNY@SKILL01@PASSIVE_NAME"
msgstr "Tirano"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@TYRANNY@SKILL13@ABILITY_DESCRIPTION"
msgstr "Unidades inimigas dentro de um raio de {TORMENTING_MIST_TARGETER>AREA>Radius} hexágonos:[bulletlist][bullet/]Sofrem dano.[bullet/]Perdem {TORMENTING_MIST_MORALE_LOSS>Morale Change Absolute} {GLOBAL.UnitMoraleConcept.Hyperlink}.[bullet/]Ganham {TORMENT_REPEATER>Count} pilhas de {GLOBAL.PROPERTIES.TORMENT.Hyperlink} até o fim do combate.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@TYRANNY@SKILL13@NAME"
msgstr "Névoa de Tormento"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@TYRANNY@SKILL14@ABILITY_DESCRIPTION"
msgstr "Ao final do turno, inimigos adjacentes:[bulletlist][bullet/]Sofrem {AURA_OF_TORMENT_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Perdem {TORMENTING_MIST_MORALE_LOSS>Morale Change Absolute} {GLOBAL.UnitMoraleConcept.Hyperlink}.[bullet/]Ganham {TORMENT_REPEATER>Count} {GLOBAL.PROPERTIES.TORMENT.Hyperlink} até o fim do combate.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@TYRANNY@SKILL14@NAME"
msgstr "Aura de Tormento"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@VAMPIRIC_RAGE@DESCRIPTION"
msgstr "O dano aumenta à medida que <<m:{GLOBAL.HitPointConcept.Hyperlink}>> diminuem, até {VAMPIRE_RAGE_MULT>ResolvedMultiplier}% em {amount} {GLOBAL.HitPointConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@VAMPIRIC_RAGE@NAME"
msgstr "Fúria Vampírica"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@VIOLENT_EXSANGUINATION@ABILITY_DESCRIPTION"
msgstr "Alvo:[bulletlist][bullet/]Sofre dano que ignora {EXSANGUINATE_DEFENSE_BYPASS>MODIFIERS>ResolvedArmor}% de {GLOBAL.DefenseConcept.Hyperlink} e {GLOBAL.ResistanceConcept.Hyperlink}.[bullet/]Ganha {amount} {GLOBAL.PROPERTIES.BLEEDING.Hyperlink} por {BLEEDING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][bulletlist][br/]Inimigos adjacentes sofrem {VIOLENT_EXSANGUINATION_TARGETER>ResolvedEffectMultiplier}% do dano que ignora {EXSANGUINATE_DEFENSE_BYPASS>MODIFIERS>ResolvedArmor}% de {GLOBAL.DefenseConcept.Hyperlink} e {GLOBAL.ResistanceConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@SPAWNERS@PROCESSION"
msgstr "Procissão Profana"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1142_933@BODY"
msgstr "A lua sangra através de uma ferida aberta, tingindo o céu de carmesim. Animais fogem para se esconder, aldeões trancam suas portas, e as criaturas do crepúsculo celebram seu brilho. Pois a noite está vermelha e governada por horrores."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1142_933@BODY_FOOTER"
msgstr "Durante seu eclipse, a Lua de Sangue fortalece todos os [hyperlink,GLOBAL.VampireLordConcept]Vampiros[/hyperlink] e permite que eles vagueiem livremente por todo o mundo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1142_933@BODY_FOOTER@NO_AI_LORDS"
msgstr "Esta é a Lua de Sangue"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1142_933@BODY_HEADER"
msgstr "O céu escurece para escarlate. A Lua de Sangue, invocada por {BloodMoonPlayer}, eclipsa a luz do sol."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1142_933@BODY_HEADER@PLAYER_IS_CASTER"
msgstr "O céu escurece para escarlate. A Lua de Sangue que você invocou eclipsa a luz do sol."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1142_933@BODY_LORE@NO_AI_LORDS"
msgstr "Esta é a Lua de Sangue"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1142_933@BUTTON_0"
msgstr "Prepare-se para a noite vermelha."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1142_933@HAPPENING_HEADER"
msgstr "O céu escurece para escarlate. A Lua de Sangue eclipsa a luz do sol."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1142_933@TITLE"
msgstr "Lua de Sangue"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1249@BODY_FOOTER"
msgstr "De qual poço carmesim você saciará sua sede? De cujo sangue saciará o desejo?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1249@BODY_HEADER"
msgstr "Suas presas coçam. Clarões vermelhos turvam sua visão. Seu corpo anseia por sangue. Você não pode mais suprimir seus desejos profanos."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1249@BODY_LORE"
msgstr "Você sente os batimentos cardíacos dos mortais que o cercam. {EventRace.Name}. Animais. Seus tenentes de confiança e seus prisioneiros de guerra. Você tenta afastar o desejo. Não é condizente com um <<PlayerLeader{senhor/senhora}>> de sua posição, afinal. Mas a sede de sangue cresce implacavelmente até que os rugidos da sua fome abafem todos os outros sons. Sangue. Você deve beber sangue."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1249@BUTTON_0"
msgstr "Ninguém sentirá falta de alguns {EventRace} [souls/] de {EventCity}. [happiness/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1249@BUTTON_1"
msgstr "\"{EventHero} é fraco de qualquer forma. O sangue <<Co:EventHero>> me revigorará.\" [xp/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1249@BUTTON_2"
msgstr "\"Eu me banquetearei com gado.\" [food/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1249@BUTTON_3"
msgstr "Beba o sangue do homem morto [souls/], apesar de seus efeitos nocivos. [hp/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1249@BUTTON_4"
msgstr "Devore seus escravos [thralls/] para saciar a fome."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1249@BUTTON_5"
msgstr "Consuma {EventHeroB}, acorrentado em sua prisão."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1249@TITLE"
msgstr "A Ânsia"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1255@BODY_FOOTER"
msgstr "O acampamento do Caçador de Vampiros e da comitiva de <<o:EventStackLeader>> está localizado {EventDirection} de {EventCity}. Derrote <<P:EventStackLeader>>, para que não o cerquem."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1255@BODY_HEADER"
msgstr "Algo se agita em seu domínio. Seus súditos sussurram sobre um Caçador de Vampiros que chegou para acabar com seu reinado."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1255@BODY_LORE"
msgstr "Nenhum outro senão {EventStackLeader}, renomado(a) Matador(a) de <<m:{GLOBAL.ElderVampireLoreConcept.Hyperlink}>>, instalou acampamento próximo às suas fronteiras. <<Cp:EventStackLeader>> certamente planeja uma incursão para cravar uma estaca em seu coração. Por coincidência, o Caçador de Vampiros ainda não localizou seu território envolto em sombras, mas isso é apenas uma questão de tempo. <<Co:EventStackLeader>> desorientação crescente lhe oferece uma oportunidade de caçar o Caçador."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1255@BUTTON_0"
msgstr "Persiga o Caçador de Vampiros. Sede de sangue de <<o:EventStackLeader>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1255@BUTTON_1"
msgstr "Eu invoco [thralls/] a própria noite [shadowboon/] para engolir o Caçador por completo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1255@BUTTON_2"
msgstr "Envie batedores [unitprod/] para atrair a atenção deles longe de {EventCity}. [happiness/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1255@BUTTON_3"
msgstr "Ignore o Caçador de Vampiros e espere que <<p:EventStackLeader>> nunca encontre seu domínio."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1255@TITLE"
msgstr "{EventStackLeader.FirstName}, o Caçador de Vampiros"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1256@BODY_FOOTER"
msgstr "O {EventItem} que você guarda para si: usar ou desmontar. Mas o que fará com {EventStackLeader}?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1256@BODY_HEADER"
msgstr "Seu exército despedaçou os guarda-costas do Caçador de Vampiros. {EventStackLeader} jaz derrotado, a um passo da <<o:EventStackLeader>> vida."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1256@BODY_LORE"
msgstr "\"Então vá em frente,\" {EventStackLeader.FirstName} gargarra logo antes de <<p:EventStackLeader>> cuspir sangue. \"Acabe com a minha vida. Não temo a morte.\" Você se diverte com a ideia de matar o Caçador. Mas há usos melhores para <<P:EventStackLeader>>. Suas tropas saqueiam o acampamento e encontram vários itens mágicos usados contra vampiros. Mais notavelmente, um {EventItem} guardado em um saco de estopa."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1256@BUTTON_0"
msgstr "Pregue <<G:corpo ainda vivo^n,EventStackLeader>> nos portões de {EventCity}. [happiness/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1256@BUTTON_1"
msgstr "Abrace [unitHero/] {EventStackLeader}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1256@BUTTON_4"
msgstr "Deixe {EventHero} alimentar [xp/] com <<P:EventStackLeader>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1256@BUTTON_5"
msgstr "Colha as almas [souls/] do Caçador e da comitiva de <<o:EventStackLeader>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1256@TITLE"
msgstr "{EventStackLeader.FirstName}, o Caçador de Vampiros: Consequência"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1262@BODY_FOOTER"
msgstr "O {EnemyUnit}, tão cego quanto os morcegos <<o:EnemyUnit>>, avança em sua direção de forma ameaçadora. <<Co:EnemyUnit>> sanguinário <<m:EventUnit>> segue o exemplo. Como {EventHero.FirstName} prosseguirá?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1262@BODY_FOOTER@HERO_IS_PLAYELEA"
msgstr "O {EnemyUnit}, tão cego quanto os morcegos <<o:EnemyUnit>>, avança em sua direção de forma ameaçadora. <<Co:EnemyUnit>> sanguinário <<m:EventUnit>> segue o exemplo. Como você prosseguirá?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1262@BODY_HEADER"
msgstr "{EventHero} desce na escuridão do {EventStructure} e é recebido por gritos agudos que ecoam nas paredes da caverna."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1262@BODY_HEADER@HERO_IS_PLAYELEA"
msgstr "Você entra na escuridão do {EventStructure} e é recebido por gritos agudos que ecoam nas paredes da caverna."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1262@BODY_LORE"
msgstr "<<m:EventUnit>>, criados por um {EnemyUnit} desequilibrado, são a origem dos gritos. Seu horrorizado {GLOBAL.HeroConcept.Hyperlink} testemunha como o {EnemyUnit} oferece <<o:EnemyUnit>> braços ao <<m:EventUnit>>, que bebe voluntariamente o sangue de <<o:EnemyUnit>>. \"Bebam, meus bichos,\" <<p:EnemyUnit>> clama em agonia. \"Bebam e logo serei um {GLOBAL.ElderVampireLoreConcept.Hyperlink}!\" <<Cp:EnemyUnit>> então percebe a presença de suas tropas e retira o braço <<o:EnemyUnit>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1262@BODY_LORE@HERO_IS_PLAYELEA"
msgstr "<<m:EventUnit>>, criados por um {EnemyUnit} desequilibrado, são a origem dos gritos. Você testemunha, horrorizado, como o {EnemyUnit} oferece <<o:EnemyUnit>> braços ao <<m:EventUnit>>, que bebe voluntariamente o sangue de <<o:EnemyUnit>>. \"Bebam, meus bichos,\" <<p:EnemyUnit>> clama em agonia. \"Bebam e logo serei um {GLOBAL.ElderVampireLoreConcept.Hyperlink}!\" <<Cp:EnemyUnit>> então percebe sua presença e retira o braço <<o:EnemyUnit>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1262@BUTTON_0"
msgstr "Corte as asas dos morcegos! Ataque!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1262@BUTTON_1"
msgstr "Confunda os morcegos com o clangor das ferramentas dos operários [structureprod/] de {EventCity}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1262@BUTTON_2"
msgstr "Transforme as paredes da caverna para amortecer sua acústica."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1262@BUTTON_3"
msgstr "Revele todo o seu poder vampírico [thralls/] para intimidar o {EnemyUnit}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1262@TITLE"
msgstr "Ecos da Insanidade"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1265@BUTTON_4"
msgstr "Fuja da caverna de morcegos."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1266@BODY_FOOTER"
msgstr "Depois de copiar as notas de pesquisa, o que mais {EventHero} tirará da {EventStructure} limpa?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1266@BODY_HEADER"
msgstr "Os gritos ensurdecedores que ecoaram pelo {EventStructure} foram silenciados. Sangue inunda o chão da caverna coberto de guano."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1266@BODY_LORE"
msgstr "Alguns dos filhotes de {EventUnit} foram poupados do massacre. {EventHero.FirstName} logo descobre que as ilusões do {EnemyUnit} eram mais profundas do que se imaginava. Tomos mofados e rabiscos nas paredes descrevem rituais e processos relacionados ao vampirismo e à anatomia dos morcegos. Embora a ideia de <<m:EventUnit>> transformar mortais em <<m:{GLOBAL.ElderVampireLoreConcept.Hyperlink}>> pareça absurda, os experimentos podem gerar valiosos novos insights."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1266@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Alguns dos filhotes de {EventUnit} foram poupados do massacre. Você descobre que as ilusões do {EnemyUnit} eram mais profundas do que se pensava. Tomos mofados e rabiscos nas paredes descrevem rituais e processos relacionados ao vampirismo e à anatomia dos morcegos. Embora a ideia de <<m:EventUnit>> transformar mortais em <<m:{GLOBAL.ElderVampireLoreConcept.Hyperlink}>> pareça absurda, os experimentos podem gerar valiosos novos insights."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1266@BUTTON_0"
msgstr "Raspe as fezes de morcego do chão para fertilizar seus campos. [food/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1266@BUTTON_1"
msgstr "Crie um(a) {EventUnit} [unit/] para lutar por você."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1266@BUTTON_2"
msgstr "Monte um(a) {EventMount} [item/] para levá-lo(a) à batalha."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1266@TITLE"
msgstr "Ecos da Insanidade: Consequência"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1267@BODY_FOOTER"
msgstr "A <<m:EventUnit>>, liderada por um(a) {EnemyUnit}, não deixará {EventHero.FirstName} se aproximar do belo dorminhoco. Como <<p:EventHero>> responde?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1267@BODY_FOOTER@HERO_IS_PLAYELEA"
msgstr "A <<m:EventUnit>>, liderada por um(a) {EnemyUnit}, não deixará você se aproximar do belo dorminhoco. Como você responde?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1267@BODY_HEADER"
msgstr "{EventHero} lidera o exército de <<o:EventHero>> ao pátio silencioso e desolado de um antigo palácio. O pátio está coberto por trepadeiras de rosas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1267@BODY_HEADER@HERO_IS_PLAYELEA"
msgstr "Você lidera seu exército ao pátio silencioso e desolado de um antigo palácio. O pátio está coberto por trepadeiras de rosas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1267@BODY_LORE"
msgstr "Na extremidade mais distante do pátio, uma bela <<EventHero{woman/man}>> jaz imóvel sobre um leito de pedra. Uma roda de fiar decomposta está próxima, seu eixo manchado de sangue tão vermelho quanto as rosas que cobrem o pátio. {EventHero.FirstName} observa os restos de <<m:EventUnit>> sob as trepadeiras, espinhos fundidos aos seus ossos. Quando <<p:EventHero>> dá um passo à frente, os mortos se levantam."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1267@BODY_LORE@HERO_IS_PLAYELEA"
msgstr "Na extremidade mais distante do pátio, uma bela <<EventHero{woman/man}>> jaz imóvel sobre um leito de pedra. Uma roda de fiar decomposta está próxima, seu eixo manchado de sangue tão vermelho quanto as rosas que cobrem o pátio. Você observa os restos de <<m:EventUnit>> sob as trepadeiras, espinhos fundidos aos seus ossos. Quando você dá um passo à frente, os mortos se levantam."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1267@BUTTON_0"
msgstr "Ataque o {EnemyUnit} para salvar o belo dorminhoco."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1267@BUTTON_1"
msgstr "Antes de atacar, incendeie as roseiras com feitiçaria simples. [mana/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1267@BUTTON_2"
msgstr "Manipule as rosas. Faça-as perder os espinhos."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1267@BUTTON_3"
msgstr "Convoque ventos frios para murchar as trepadeiras espinhosas no {EventStructure}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1267@BUTTON_4"
msgstr "Deixe a beleza dormir e saia do {EventStructure}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1267@TITLE"
msgstr "<<EventHero{Rose/Thorne}>> of <<EventHero{Thorns/Roses}>>"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1268@BODY_FOOTER"
msgstr "A maldição foi quebrada. A magia do {EventStructure} enfraquece e as trepadeiras desmoronam. Antes de partir, que troféu {EventHero} reivindicará?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1268@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "A maldição foi quebrada. A magia do {EventStructure} enfraquece e as trepadeiras desmoronam. Antes de partir, que troféu você reivindicará?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1268@BODY_HEADER"
msgstr "Com o {EnemyUnit} reduzido a ossos e armadura espinhados, {EventHero} se aproxima do belo dorminhoco sobre o leito de pedra."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1268@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Com o {EnemyUnit} reduzido a ossos e armadura espinhados, você se aproxima do belo dorminhoco sobre o leito de pedra."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1268@BODY_LORE"
msgstr "<<Cp:EventHero>> inclina-se para frente para verificar se o dorminhoco ainda está vivo. Quando o <<G:breath^n,EventHero>> toca os lábios <<EventHeroB{do homem/da mulher}>>, <<p:EventHeroB>> abre <<o:EventHeroB>> os olhos e ofega. \"Saudações, Herói,\" <<p:EventHeroB>> suspira. \"Fui amaldiçoado por uma bruxa, ciumenta da minha juventude e habilidade. Eu sou {EventHeroB}.\" <<Cp:EventHeroB>> olha ao redor. \"Este é o castelo do meu pai? Parece... Estive dormindo por muito tempo.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1268@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Você inclina-se para frente para verificar se o dorminhoco ainda está vivo. Quando sua respiração toca os lábios <<EventHeroB{do homem/da mulher}>>, <<p:EventHeroB>> abre <<o:EventHeroB>> os olhos e ofega. \"Saudações, Herói,\" <<p:EventHeroB>> suspira. \"Fui amaldiçoado por uma bruxa, ciumenta da minha juventude e habilidade. Eu sou {EventHeroB}.\" <<Cp:EventHeroB>> olha ao redor. \"Este é o castelo do meu pai? Parece... Estive dormindo por muito tempo.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1268@BUTTON_0"
msgstr "Recrute [unitHero/] {EventHeroB}, agora despertado."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1268@BUTTON_2"
msgstr "Deixe seus estudiosos registrar [knowledge/] <<G:memórias^p,EventHeroB>> do passado."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1268@BUTTON_3"
msgstr "Deixe {EventHeroB.FirstName} ir. Pegue o <<G:{EventItem},EnemyUnit>>. [item/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1268@BUTTON_4"
msgstr "Colha o poder mágico residual [mana/] do {EventStructure}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1268@TITLE"
msgstr "<<EventHero{Rose/Thorne}>> of <<EventHero{Thorns/Roses}>>: Aftermath"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1286@BODY_FOOTER"
msgstr "\"Meu marido adúltero morreu antes de receber punição, mas meu desprezo será sofrido.\" <<G:grito repentino^n,{EnemyUnit.FirstName}>> estilhaça a estátua, antes que <<p:EnemyUnit>> ataque {EventHero.FirstName}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1286@BODY_FOOTER@HERO_IS_PLAYELEA"
msgstr "\"Meu marido adúltero morreu antes de receber punição, mas meu desprezo será sofrido.\" <<G:grito repentino^n,{EnemyUnit.FirstName}>> estilhaça a estátua, antes que <<p:EnemyUnit>> ataque você."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1286@BODY_HEADER"
msgstr "{EventHero} entra no pátio de um palácio antigo e esquecido. Uma mulher está chorando diante da estátua de um rei."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1286@BODY_HEADER@HERO_IS_PLAYELEA"
msgstr "Você entra no pátio de um palácio antigo e esquecido. Uma mulher está chorando diante da estátua de um rei."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1286@BODY_LORE"
msgstr "A estátua está profanada com sangue. Arranhões, como se fossem feitos por unhas, percorrem os olhos do homem. A mulher lamentosa sacode a cabeça de <<o:EnemyUnit>> quando <<p:EnemyUnit>> ouve a aproximação do <<G:exército^n,EventHero>>. \"Vieram zombar da Rainha Banshee?\", <<p:EnemyUnit>> geme. \"Pobre {EnemyUnit.FirstName}, traído pelo marido <<o:EnemyUnit>>, aquele Rei dos Trapaceiros.\" <<Cp:EnemyUnit>> exibe <<o:EnemyUnit>> presas enquanto <<m:EventUnit>> surgem ao redor de <<P:EnemyUnit>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1286@BODY_LORE@HERO_IS_PLAYELEA"
msgstr "A estátua está profanada com sangue. Arranhões, como se fossem feitos por unhas, percorrem os olhos do homem. A mulher lamentosa sacode a cabeça de <<o:EnemyUnit>> quando <<p:EnemyUnit>> ouve seu exército se aproximar. \"Vieram zombar da Rainha Banshee?\", <<p:EnemyUnit>> geme. \"Pobre {EnemyUnit.FirstName}, traído pelo marido <<o:EnemyUnit>>, aquele Rei dos Trapaceiros.\" <<Cp:EnemyUnit>> exibe <<o:EnemyUnit>> presas enquanto <<m:EventUnit>> surgem ao redor de <<P:EnemyUnit>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1286@BUTTON_0"
msgstr "\"Hora de silenciar a Rainha Banshee. Avante!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1286@BUTTON_1"
msgstr "Uma recompensa [gold/] para quem me trouxer <<g:head^n,{EnemyUnit.FirstName}>>!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1286@BUTTON_2"
msgstr "Convoque a imagem de <<G:cônjuge adúltero^n,{EnemyUnit.FirstName}>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1286@BUTTON_3"
msgstr "Disfarce-se como <<G:marido morto^n,{EnemyUnit.FirstName}>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1286@BUTTON_4"
msgstr "Fuja o {EventStructure} e o <<G:desprezo^n,{EnemyUnit.FirstName}>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1286@HERO@FIRSTNAME"
msgstr "Mayv^F"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1286@TITLE"
msgstr "Rainha das Banshees"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1287@BODY_FOOTER"
msgstr "Ansioso por deixar as trágicas sombras do {EventStructure} para trás <<P:EventHero>>, que lembrança {EventHero.FirstName} levará do palácio?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1287@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Ansioso por deixar as trágicas sombras do {EventStructure} para trás, que lembrança você levará do palácio?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1287@BODY_HEADER"
msgstr "A Rainha das Banshees jaz aos <<G:pés^p,EventHero>>. Seu coração agora em repouso. Seu lamento finalmente cessou."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1287@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "A Rainha das Banshees jaz aos seus pés. Seu coração agora em repouso. Seu lamento finalmente cessou."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1287@BODY_LORE"
msgstr "Os poucos <<m:EventUnit>> que restam espalham‑se para se esconder nos cantos mais sombrios da {EventStructure}. Foram atraídos pelo <<G:desdém^n,{EnemyUnit.FirstName}>> séculos atrás e isso a enlouqueceu. Quando {EventHero} vasculha as opulentas câmaras do palácio em busca de tesouros e antiguidades, <<p:EventHero>> descobre os corpos decrépitos dos servos. Suas gargantas estão marcadas por cortes longos e profundos feitos por garras ou unhas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1287@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Os poucos <<m:EventUnit>> que restam espalham‑se para se esconder nos cantos mais sombrios da {EventStructure}. Foram atraídos pelo <<G:desdém^n,{EnemyUnit.FirstName}>> séculos atrás e isso a enlouqueceu. Quando você vasculha as opulentas câmaras do palácio em busca de tesouros e antiguidades, descobre os corpos decrépitos dos servos. Suas gargantas estão marcadas por cortes longos e profundos feitos por garras ou unhas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1287@BUTTON_0"
msgstr "Restaurar a estátua do marido [influence/] para ser colocada em sua corte."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1287@BUTTON_2"
msgstr "Prenda um dos <<m:EventUnit>> errantes para que se junte [unit/] ao seu exército."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1287@BUTTON_3"
msgstr "Extraia as almas [souls/] inativas que permanecem no {EventStructure}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1287@BUTTON_4"
msgstr "Dê à Rainha Banshee um enterro adequado. [goodact/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1287@TITLE"
msgstr "Rainha das Banshees: Consequência"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1288@BODY_FOOTER"
msgstr "Um(a) {EnemyUnit} percebe {EventHero.FirstName} espiando. Todos os vampiros, sob efeito de sobriedade instantânea, viram‑se para enfrentar <<P:EventHero>>, prontos para atacar."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1288@BODY_FOOTER@HERO_IS_PLAYELEA"
msgstr "Um(a) {EnemyUnit} percebe você espiando. Todos os vampiros, sob efeito de sobriedade instantânea, viram‑se para enfrentá‑lo, prontos para atacar."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1288@BODY_HEADER"
msgstr "Ao preparar o exército de <<o:EventHero>> para explorar um(a) {EventStructure} aparentemente abandonado e coberto de vegetação, {EventHero} ouve música."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1288@BODY_HEADER@HERO_IS_PLAYELEA"
msgstr "Ao preparar seu exército para explorar um(a) {EventStructure} aparentemente abandonado e coberto de vegetação, você ouve música."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1288@BODY_LORE"
msgstr "Espiando através das altas janelas de vidro tingido a vermelho, {EventHero.FirstName} descobre um coven de vampiros festejando no pátio do palácio. Eles enchem taças de vinho com o sangue de mortais aprisionados, pendurados de cabeça para baixo e forçados a beber cerveja. Os vampiros embriagados deleitam‑se na luz que entra no pátio pelas janelas vermelhas, e brindam à Lua de Sangue e à supremacia de sua espécie."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1288@BODY_LORE@HERO_IS_PLAYELEA"
msgstr "Espiando através das altas janelas de vidro tingido a vermelho, você descobre um coven de vampiros festejando no pátio do palácio. Eles enchem taças de vinho com o sangue de mortais aprisionados, pendurados de cabeça para baixo e forçados a beber cerveja. Os vampiros embriagados deleitam‑se na luz que entra no pátio pelas janelas vermelhas, e brindam à Lua de Sangue e à supremacia de sua espécie."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1288@BUTTON_0"
msgstr "Avance para o pátio e mate os vampiros."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1288@BUTTON_1"
msgstr "Empunhe sua piedade para purificar a luz terrível."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1288@BUTTON_2"
msgstr "Quebre o vidro tingido a vermelho das janelas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1288@BUTTON_3"
msgstr "Declare seu status [thralls/] como {PlayerLeader.Title} para estabelecer domínio."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1288@BUTTON_4"
msgstr "Fuja antes que os vampiros o confrontem."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1288@TITLE"
msgstr "Banquete da Lua de Sangue"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1289@BODY_FOOTER"
msgstr "Os <<m:EventUnit>> resgatados estão ansiosos para servi‑lo em batalha. Antes que {EventHero} parta, que finalidade terão os suprimentos de {EventStructure}?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1289@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Os <<m:EventUnit>> resgatados estão ansiosos para servi‑lo em batalha. Antes de partir, que finalidade terão os suprimentos de {EventStructure}?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1289@BODY_HEADER"
msgstr "Depois de espancar os vampiros festejantes, {EventHero} liberta seus prisioneiros esgotados de sangue. Entre eles estão <<m:EventUnit>> da sua {EventRace}!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1289@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Depois de espancar os vampiros festejantes, você liberta seus prisioneiros esgotados de sangue. Entre eles estão <<m:EventUnit>> da sua {EventRace}!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1289@BODY_LORE"
msgstr "\"Louvor ao nosso {PlayerLeader.Title}\", suspira o {EventUnit} menos esgotado. \"Eu ainda tinha muito pouco sangue para dar.\" {EventHero} investiga os terrenos do palácio. Os vampiros alimentavam‑se dos prisioneiros capturados, porém o palácio estava abastecido com os melhores mantimentos para engordar seus fornecedores de sangue. Seria uma pena desperdiçar o banquete."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1289@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "\"Louvor a ti, ó {PlayerLeader.Title}!\", suspira o {EventUnit} menos esgotado. \"Eu ainda tinha muito pouco sangue para dar.\" Você investiga os terrenos do palácio. Os vampiros alimentavam‑se dos prisioneiros capturados, porém o palácio estava abastecido com os melhores mantimentos para engordar seus fornecedores de sangue. Seria uma pena desperdiçar o banquete."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1289@BUTTON_0"
msgstr "Saquear as provisões armazenadas [food/] para {EventCity}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1289@BUTTON_2"
msgstr "Envie as iguarias palacianas aos seus recrutas [unitprod/] em {EventCity}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1289@BUTTON_3"
msgstr "Permita que seu exército vitorioso termine o banquete. [morale/] Eles merecem."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1289@BUTTON_4"
msgstr "Estude o Ritual da Lua de Sangue para fortalecer [xp/] {EventHero}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1289@BUTTON_5"
msgstr "Escravizar [thralls/] os outros prisioneiros resgatados. [evilact/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1289@TITLE"
msgstr "Banquete da Lua de Sangue: Consequência"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1291@BODY_FOOTER"
msgstr "Eles percebem {EventHero} quando um(a) {EventUnit} errante tenta se agarrar à perna de <<o:EventHero>>. O <<m:EnemyUnit>> frenético move‑se imediatamente para atacar."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1291@BODY_FOOTER@HERO_IS_PLAYELEA"
msgstr "Eles percebem você quando um(a) {EventUnit} errante tenta se agarrar à sua perna. O <<m:EnemyUnit>> frenético move‑se imediatamente para atacar."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1291@BODY_HEADER"
msgstr "{EventHero} avança ao cheiro de sangue quente que emana da boca do {EventStructure}, açoitado por gritos angustiosos e chilreios."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1291@BODY_HEADER@HERO_IS_PLAYELEA"
msgstr "Você avança ao cheiro de sangue quente que emana da boca do {EventStructure}, açoitado por gritos angustiosos e chilreios."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1291@BODY_LORE"
msgstr "Ao liderar o exército de <<o:EventHero>> para dentro, {EventHero.FirstName} testemunha como <<m:EnemyUnit>> expõem seus corpos a <<m:EventUnit>>, que drenam seu sangue vorazmente. <<m:EventUnit>> inchados contorcem‑se no chão da caverna, botando ovos. Formas movem‑se sob a pele do <<m:EnemyUnit>>, que entoam cantos arcanos sobre a pureza do sangue e os Preceitos do Sangue‑escritor. Seus gritos não revelam agonia, apenas exaltação."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1291@BODY_LORE@HERO_IS_PLAYELEA"
msgstr "Ao liderar seu exército para dentro, você testemunha como <<m:EnemyUnit>> expõem seus corpos a <<m:EventUnit>>, que drenam seu sangue vorazmente. <<m:EventUnit>> inchados contorcem‑se no chão da caverna, botando ovos. Formas movem‑se sob a pele do <<m:EnemyUnit>>, que entoam cantos arcanos sobre a pureza do sangue e os Preceitos do Sangue‑escritor. Seus gritos não revelam agonia, apenas exaltação."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1291@BUTTON_0"
msgstr "Acelere o sangramento dos <<m:EnemyUnit>> enganados. Ataque!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1291@BUTTON_1"
msgstr "Infete [hp/] suas tropas com Parasitas de Sangue para compartilhar a benção dos cultistas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1291@BUTTON_2"
msgstr "Corrompa sua carne para repelir os vorazes Parasitas de Sangue."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1291@BUTTON_3"
msgstr "Invoca os impulsos primais de todos os <<m:EventUnit>> recém-eclodidos."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1291@BUTTON_4"
msgstr "Retirada. Deixe esses <<m:EnemyUnit>> miseráveis em seus rituais frenéticos por enquanto."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1291@TITLE"
msgstr "Preceitos do Sangue"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1292@BODY_FOOTER"
msgstr "O {EnemyUnit} uiva euforicamente e <<o:EnemyUnit>> discípulos se aglomeram ao redor de <<P:EnemyUnit>>: \"Ensinem a esses voyeures não convidados sobre a dor!\" Como {EventHero} responderá?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1292@BODY_FOOTER@HERO_IS_PLAYELEA"
msgstr "O {EnemyUnit} uiva euforicamente e <<o:EnemyUnit>> discípulos se aglomeram ao redor de <<P:EnemyUnit>>: \"Ensine a esses voyeures não convidados sobre a dor!\" Como você responderá?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1292@BODY_HEADER"
msgstr "{EventHero} está inicialmente apreensivo com os gritos que saem do {EventStructure} abaixo de <<P:EventHero>>. Mas o riso subsequente desperta a curiosidade de <<o:EventHero>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1292@BODY_HEADER@HERO_IS_PLAYELEA"
msgstr "Você está inicialmente apreensivo com os gritos que saem do {EventStructure} abaixo de você. Mas o riso subsequente desperta sua curiosidade."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1292@BODY_LORE"
msgstr "{EventHero.FirstName} descobre o espetáculo interior com horror. Um {EnemyUnit} instrui <<o:EnemyUnit>> acólitos nos Ensinamentos da Dor: eles beliscam, esfaqueiam, torcem e abrem um ao outro. Sangue jorra de suas feridas auto-infligidas, e gritos eufóricos ecoam de suas gargantas. O {EnemyUnit}, adornado com respingos de sangue, sorri com deleite ansioso quando <<p:EnemyUnit>> avista <<G:army^n,{EventHero.FirstName}>> e sussurra: \"Mais carne disposta?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1292@BODY_LORE@HERO_IS_PLAYELEA"
msgstr "Você descobre o espetáculo interior com horror. Um {EnemyUnit} instrui <<o:EnemyUnit>> acólitos nos Ensinamentos da Dor: eles beliscam, esfaqueiam, torcem e abrem um ao outro. Sangue jorra de suas feridas auto-infligidas, e gritos eufóricos ecoam de suas gargantas. O {EnemyUnit}, adornado com respingos de sangue, sorri com deleite ansioso quando <<p:EnemyUnit>> avista seu exército e sussurra: \"Mais carne disposta?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1292@BUTTON_0"
msgstr "\"Não há dor na morte! Derrube-os!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1292@BUTTON_1"
msgstr "\"Pensem em coisas felizes, tropas! Tirem a mente da dor deles!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1292@BUTTON_2"
msgstr "\"Desviantes, vocês deveriam se envergonhar!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1292@BUTTON_3"
msgstr "\"Isso parece a minha festa! Pode contar comigo!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1292@BUTTON_4"
msgstr "Deixe o {EnemyUnit} e os discípulos <<o:EnemyUnit>> em privacidade para seus rituais."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1292@TITLE"
msgstr "Ensinamentos do Torturador"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1293@BODY_FOOTER"
msgstr "<<m:EventUnit>> foge do {EventStructure}. Há algo que valha a pena salvar neste local abandonado?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1293@BODY_HEADER"
msgstr "Ao matar o último dos <<m:EnemyUnit>>, {EventHero} descobre o verdadeiro propósito do {EventStructure}: é um altar dedicado a {GLOBAL.UrvatoghLoreConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1293@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Ao matar o último dos <<m:EnemyUnit>>, você descobre o verdadeiro propósito do {EventStructure}: é um altar dedicado a {GLOBAL.UrvatoghLoreConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1293@BODY_LORE"
msgstr "{EventHero.FirstName} descobre tomos que mencionam o [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] e seus supostos Preceitos do Sangue. O poder da entidade sombria havia infectado as mentes dos <<m:EnemyUnit>> com a crença distorcida de que oferecer seu sangue ao <<m:EventUnit>> levaria à grandeza e ao retorno do Primeiro Vampiro. Seus rituais repetidos acumularam energias mágicas imprevisíveis, que {EventHero.FirstName} rapidamente precipita como mana."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1293@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Você descobre tomos que mencionam o [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] e seus supostos Preceitos do Sangue. O poder da entidade sombria havia infectado as mentes dos <<m:EnemyUnit>> com a crença distorcida de que oferecer seu sangue ao <<m:EventUnit>> levaria à grandeza e ao retorno do Primeiro Vampiro. Seus rituais repetidos acumularam energias mágicas imprevisíveis, que você rapidamente precipita como mana."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1293@BUTTON_0"
msgstr "Pesquise [knowledge/] as vantagens da sangria em batalha."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1293@BUTTON_1"
msgstr "Adote um {EventUnit} perdido. [unit/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1293@BUTTON_2"
msgstr "Estudar os preceitos do Deus Imortal transforma seu {EventStackUnit} em um {EnemyUnit}. [unit/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1293@BUTTON_3"
msgstr "Moa o <<m:EventUnit>> morto em fertilizante [food/] para <<G:fazendas^p,EventCity>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1293@TITLE"
msgstr "Preceitos do Sangue: Consequência"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1294@BODY_FOOTER"
msgstr "Além do {EventItem}, o que {EventHero} deve extrair do {EventStructure} antes de deixar este local depravado?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1294@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Além do {EventItem}, o que você extrairia do {EventStructure} antes de deixar este local depravado?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1294@BODY_HEADER"
msgstr "{EventHero} matou os ritualistas que ocupavam o {EventStructure}. Um sorriso satisfeito está congelado nos lábios mortos do <<G:^p,EnemyUnit>>, para <<G:desconforto^n,{EventHero.FirstName}>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1294@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você matou os ritualistas que ocupavam o {EventStructure}. Um sorriso satisfeito está congelado nos lábios mortos do <<G:^p,EnemyUnit>>, para seu desconforto."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1294@BODY_LORE"
msgstr "A luz tênue do {EventStructure} revela que o chão da caverna está agora completamente inundado com o sangue do senhor da batalha. Cidadãos de todo o reino se reuniram aqui para adorar a Dor juntos. {EventHero.FirstName} examina o elaborado conjunto de ferramentas do {EnemyUnit} e encontra <<o:EnemyUnit>> {EventItem}. <<Cp:EventHero>> se pergunta se <<p:EventHero>> poderia realmente compreender que convicção motivou esses ritualistas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1294@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "A luz tênue do {EventStructure} revela que o chão da caverna está agora completamente inundado com o sangue do senhor da batalha. Cidadãos de todo o reino se reuniram aqui para adorar a Dor juntos. Você examina o elaborado conjunto de ferramentas do {EnemyUnit} e encontra <<o:EnemyUnit>> {EventItem}. Você se pergunta se poderia realmente entender que convicção motivou esses ritualistas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1294@BUTTON_0"
msgstr "<<G:artes^p,EnemyUnit>> [unitHero/] para aumentar a <<G:durabilidade^n,{EventHero.FirstName}>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1294@BUTTON_0@HERO_IS_PLAYERLE"
msgstr "<<G:artes^p,EnemyUnit>> [unitHero/] para aumentar sua durabilidade."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1294@BUTTON_1"
msgstr "[order/] Elimine todas as evidências dos <<G:rituais aberrantes^p,EnemyUnit>> do {EventStructure}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1294@BUTTON_2"
msgstr "Beba o sangue que foi derramado por toda parte. [xp/] Não desperdice, não careça!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1294@BUTTON_3"
msgstr "Estude as <<G:lições^p,EnemyUnit>> para fortalecer seus combatentes à distância. [knowledge/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1294@TITLE"
msgstr "Ensinamentos do Torturador: Consequência"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1295@BODY_FOOTER"
msgstr "Eles pausam, esperando que você resolva a disputa volátil deles. Quem você favorecerá? O poderoso {EventHeroA.FirstName}? Ou o ambicioso {EventHeroB.FirstName}?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1295@BODY_HEADER"
msgstr "Seu banquete noturno da corte é interrompido quando as tensões entre {EventHeroA} e {EventHeroB} explodem em um confronto sibilante."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1295@BODY_LORE"
msgstr "\"Covarde!\" {EventHeroA.FirstName}, o mais forte dos dois, arrasta {EventHeroB.FirstName} pela mesa de jantar, derramando um pouco do seu melhor sangue engarrafado. O mais recém-gerado {EventHeroB.FirstName} suga <<o:EventHeroB>> dentes. \"Seu pateta,\" <<p:EventHeroB>> ri. \"Soldados não podem forjar impérios! Tecelagem de feitiços molda reinos poderosos! Todo mundo sabe disso!\" {EventHeroA} empunha sua <<o:EventHeroA>> arma. \"Vamos ver como sua tecelagem se sai contra minha lâmina, seu otário!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1295@BUTTON_0"
msgstr "Alie-se a {EventHeroB} [morale/]. Seu império deve crescer por meio da arte arcana. [knowledge/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1295@BUTTON_1"
msgstr "\"Isso não é maneira de se comportar! Vocês dois obedecerão a MIM!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1295@BUTTON_2"
msgstr "Alie-se a {EventHeroA} [morale/]. Seu império deve crescer pela espada. [unitprod/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1295@BUTTON_3"
msgstr "\"Parem com essa rivalidade infantil. Banqueteiem-se com alguns escravos [thralls/] ao invés. Saúde!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1295@BUTTON_4"
msgstr "Nenhum deles parece entender a arte da política. Ignore-os."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1295@BUTTON_5"
msgstr "\"Haha, isso será uma ótima batalha! Que o melhor Vampiro vença!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1295@TITLE"
msgstr "Rancor"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1298@BODY_FOOTER"
msgstr "Um(a) {PlayerLeader.Title} como você deve ostentar <<o:PlayerLeader>> {EventMaterial} para mostrar sua opulência. Você buscará uma nova fonte?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1298@BODY_HEADER"
msgstr "A origem dos Vampiros está ligada à substância lendária conhecida como {EventMaterial}, que revigora os Vampiros e gera sede de sangue."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1298@BODY_LORE"
msgstr "Os <<m:{GLOBAL.ArchvampireLoreConcept.Hyperlink}>>, seus senhores ancestrais, forjavam espadas, anéis e coroas a partir do vidro para exibir sua riqueza e autoridade. As janelas de seus antigos palácios eram feitas de painéis de {EventMaterial}, transformando os raios brilhantes que os atravessavam em uma luz vermelha revigorante. Os maiores reis possuíam covens inteiros de tenentes de confiança equipados com armas magistralmente {EventMaterial}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1298@BUTTON_0"
msgstr "\"O {EventMaterial} será de grande ajuda nas minhas conquistas!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1298@BUTTON_2"
msgstr "\"Exibir {EventMaterial}? Eu erigirei uma estátua [structureprod/] de mim mesmo [influence/] ao invés!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1298@BUTTON_3"
msgstr "\"Não me interesso pelas frivolidades dos reis empoeirados.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1298@TITLE"
msgstr "Vidro de Carmesim"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@BODY_FOOTER"
msgstr "Obter o {EventMaterial} aumenta sua produção de itens mágicos. Os ferreiros podem até concluir uma arma para um {GLOBAL.HeroConcept.Hyperlink} imediatamente!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@BODY_HEADER"
msgstr "Segurando um fragmento de {EventMaterial}, você sente vagamente um pulso. Percebe seus efeitos revigorantes. E sua fome crescente."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@BODY_LORE"
msgstr "Seus ferreiros chegam para informar que suas forjas estão prontas. Eles estão ansiosos para usar este material na fabricação de lâminas cortantes e placas de defesa. Seu <<m:{GLOBAL.HeroConcept.Hyperlink}>> em particular pode se beneficiar das armaduras aprimoradas que o {EventMaterial} pode fornecer. Você dá o sinal, e seus ferreiros sorridentes carregam o {EventMaterial} para suas forjas sombrias."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@BUTTON_0"
msgstr "Forje um(a) {DefenderItem} [item/] para {DefenderHero}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@BUTTON_1"
msgstr "Forje um(a) {MageItem} [item/] para {MageHero}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@BUTTON_10"
msgstr "Forje um(a) {WarriorItem} [item/] para {WarriorHero}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@BUTTON_11"
msgstr "Forje um(a) {DeathItem} [item/] para {DeathHero}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@BUTTON_4"
msgstr "Forje um(a) {RangerItem} [item/] para {RangerHero}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@BUTTON_5"
msgstr "Esqueça os Heróis. Misture-o com o armamento das minhas tropas regulares. [unitprod/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@BUTTON_6"
msgstr "\"Meus Heróis me abandonaram. Criarei uma arma para mim mesmo.\" [item/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@BUTTON_7"
msgstr "Forje um(a) {RitualistItem} [item/] para {RitualistHero}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@BUTTON_8"
msgstr "Forje um(a) {SpellbladeItem} [item/] para {SpellbladeHero}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@BUTTON_9"
msgstr "Forje um(a) {WarlockItem} [item/] para {WarlockHero}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@TITLE"
msgstr "Vidro de Carmesim: Consequência"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1302@BODY_FOOTER"
msgstr "Se desejar aprender mais sobre seus antepassados, construa <<m:{GLOBAL.ResearchPostConcept.Hyperlink}>> para estudar a história de sua linhagem com maior profundidade."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1302@BODY_HEADER"
msgstr "Como um(a) {GLOBAL.ElderVampireLoreConcept.Hyperlink} {PlayerLeader.Title}, você descende de uma grande linhagem de [hyperlink,GLOBAL.ArchvampireLoreConcept]<<PlayerLeader{Archsires/Archdams}>>[/hyperlink]. Mas qual deles?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1302@BODY_LORE"
msgstr "Havia muitos clãs, covens e casas no passado sem Sol de sua espécie. Cada um vangloriava seus próprios talentos, forças e habilidades. E embora você deseje descobrir onde suas ambições o levarão, conhecer a origem de seu poder pode ser útil. Escritores e estudiosos já trabalham incansavelmente para desvendar magias ocultas, mas precisarão de reforço para estudar sua linhagem."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1302@BUTTON_0"
msgstr "Construa o <<m:{GLOBAL.ResearchPostConcept.Name}>> para fortalecer suas capacidades acadêmicas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1302@BUTTON_2"
msgstr "Você conhece [knowledge/] o suficiente. São mãos dispostas [thralls/] que lhe faltam."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1302@BUTTON_3"
msgstr "Deixe o passado apodrecer. Seu foco é dominar o futuro."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1302@TITLE"
msgstr "Lenda dos <<PlayerLeader{Archsires/Archdams}>>"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1303@BODY_FOOTER"
msgstr "Aproveitar este novo poço de poder já o fortalece. Como usará esta descoberta para moldar seu domínio?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1303@BODY_HEADER"
msgstr "O último dos <<m:{GLOBAL.ResearchPostConcept.Hyperlink}>> foi erguido e já seus escribas relatam uma descoberta."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1303@BODY_LORE"
msgstr "Eles traduziram com sucesso pergaminhos antigos, escritos em uma língua morta, que guardam os anais de um dos filhos sombrios do [hyperlink,GLOBAL.UrvatoghLoreConcept]Blood Emperor Eternal[/hyperlink]. Comparando esses anais com a árvore dinástica de seu <<PlayerLeader{sire/dam}>>, você pode rastrear sua linhagem até {EventPhrase}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1303@BUTTON_0"
msgstr "Use o conhecimento para atrair recrutas para seu exército. [unitprod/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1303@BUTTON_1"
msgstr "Explore essa percepção para consolidar seu status de alta classe [influence/]."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1303@BUTTON_4"
msgstr "Anuncie esta descoberta para reforçar o orgulho [happiness/] da sua {EventRace}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1303@BUTTON_5"
msgstr "Apresente sua linhagem para vincular mais escravos [thralls/] à sua vontade."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1303@BUTTON_6"
msgstr "Aceite este conhecimento como prova da sua devoção [devotion/]."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1303@TITLE"
msgstr "Lenda dos <<PlayerLeader{Archsires/Archdams}>>: Consequência"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@BODY_FOOTER"
msgstr "Tantos escravos de sobra! Certamente pode encontrar um uso melhor para eles do que entupir seu [hyperlink,GLOBAL.STRUCTURE_UPGRADES.LORD_CASTLE_FOUNDATION]Castelo Vampiro[/hyperlink]?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@BODY_HEADER"
msgstr "Escravos se reúnem em sua fortaleza em {EventCity}. Eles se aglomeram em multidões, ocupando suas masmorras mais profundas e laboratórios mais mortíferos."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@BODY_LORE"
msgstr "Escravos são um símbolo da sua influência sobre os povos menores. Despojados de suas vontades e desejos, obedecem a todas as suas ordens sem pausa ou objeção. Mas para os vampiros, escravos não devem ficar ociosos. Os príncipes vampiros mais astutos e seus consortes enviaram hordas de escravos para executar seus sombrios desígnios. Muitos dos seus ainda não foram usados, assim como seu potencial."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@BUTTON_0"
msgstr "Esfolar escravos [thralls/] para entreter [morale/] seu coven."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@BUTTON_1"
msgstr "Gaste escravos [thralls/] para ganhar o favor de senhores menores. [allegiance/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@BUTTON_10"
msgstr "[nature/] Envie escravos [thralls/] aos seus açougueiros. [food/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@BUTTON_11"
msgstr "[shadow/] Drene escravos [thralls/] para aprender [knowledge/] mais sobre o Cosmos."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@BUTTON_12"
msgstr "Muitos escravos? Isso não existe. Traga-me mais! [thralls/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@BUTTON_2"
msgstr "Desfile seus escravos [thralls/] para exibir seu senhorio. [influence/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@BUTTON_3"
msgstr "[chaos/] Envie escravos [thralls/] para trabalhar nas forjas [unitprod/] de suas ferrarias."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@BUTTON_4"
msgstr "[arcana/] Gaste escravos [thralls/] para extrair mana [mana/] do Mar Astral."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@BUTTON_5"
msgstr "[order/] Desloque escravos [thralls/] como coletores de impostos [gold/]."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@BUTTON_9"
msgstr "[matter/] Envie escravos [thralls/] para escavar em suas pedreiras. [structureprod/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@TITLE"
msgstr "Multidões de Escravos"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1194_1919@BODY_FOOTER"
msgstr "<<Co:Emperor>> cript está dito estar sob o monte encharcado de sangue de um coração despedaçado. Encontre-o, pois quem o abrir decidirá o futuro de toda a espécie vampírica."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1194_1919@BODY_HEADER"
msgstr "O [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink], primeiro de todos os Vampiros, foi há muito tempo sepultado neste reino. <<Cp:Emperor>> aguarda a vinda de quem desencadeará um juízo de sangue."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1194_1919@BODY_LORE"
msgstr "O [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] é um enigma venerado por cultos sangrentos e secretos ao longo dos séculos. Eles há muito pregam a vinda de um evento, chamado 'Juízo de Sangue'. Um tempo em que {EventRealm} retorna do exílio, e o sagrado sangue do Deus Imortal será derramado ou novamente restaurado a uma glória ainda maior!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1194_1919@BUTTON_0"
msgstr "\"O juízo está próximo.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1194_1919@TITLE"
msgstr "Cripta do Deus Imortal"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_212@BODY_FOOTER"
msgstr "A figura se transforma em pó diante dos olhos de {EventHero}, deixando <<P:EventHero>> com um pedido para salvar a aldeia amaldiçoada. O que {EventHero} fará?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_212@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "A figura se transforma em pó diante dos seus olhos, deixando-o com um pedido para salvar a aldeia amaldiçoada. O que você fará?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_212@BODY_HEADER"
msgstr "Do canto do olho de <<o:EventHero>>, {EventHero} o percebe. Coçando e gravemente ferido, uma figura se aproxima de <<P:EventHero>>, gesticulando por ajuda."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_212@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Do canto do seu olho, você o percebe. Coçando e gravemente ferido, uma figura se aproxima, gesticulando por ajuda."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_212@BODY_LORE"
msgstr "\"Por favor, não podemos mais suportar. Algo terrível persegue nossa aldeia, levando nosso povo. Consegui chegar aqui para pedir ajuda. Mas meus filhos... minha família, ainda estão lá.\"\n"
"\n"
"<<Co:VillageSoulHero>> olhos de repente se fixam nas próprias feridas letais de <<o:VillageSoulHero>>. Com um olhar de terror, <<p:VillageSoulHero>> diz: \"Mas tenha cuidado... parece que não consegui sair vivo.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_212@BUTTON_0"
msgstr "Incendeie o maldito lugar — a maldição não pode se espalhar."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_212@BUTTON_1"
msgstr "Procure por sobreviventes; alguém ainda pode estar vivo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_212@BUTTON_4"
msgstr "Conecte-se à fonte do mal que assombra o local."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_212@BUTTON_5"
msgstr "Deixe a alma perdida."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_212@TITLE"
msgstr "A Aldeia Amaldiçoada"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_213@BODY_FOOTER"
msgstr "Isso não acabou. Ainda resta um último feito."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_213@BODY_HEADER"
msgstr "Depois de matar a última criatura, a aldeia deveria estar limpa. Ainda assim algo está errado, este lugar ainda parece assombrado."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_213@BODY_LORE"
msgstr "As casas apodrecem em silêncio, decadentes, abandonadas. Ainda assim você sentiu, nenhuma paz veio após matar o último monstro. Uma presença sombria persiste, seja o que for que amaldiçoou este lugar ainda está aqui. Você a vê nas sombras da cidade. Suas formas não correspondem aos edifícios."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_213@BUTTON_0"
msgstr "Prepare o combustível. Acenda as tochas. Incendeie esta cidade."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_213@BUTTON_1"
msgstr "Entre na aldeia — alguém ainda deve estar vivo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_213@BUTTON_4"
msgstr "Acesse a presença sombria."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_213@TITLE"
msgstr "A Maldição da Aldeia Amaldiçoada"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_214@BODY_FOOTER"
msgstr "O destino deste domínio está em suas mãos. O que fará?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_214@BODY_HEADER"
msgstr "O fogo purifica a corrupção desta terra. Chamas engolfam os edifícios, as sombras e a maldição."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_214@BODY_LORE"
msgstr "Você não consegue desviar o olhar da labareda. Não só a aldeia arde, as chamas consomem algo mais que paira no ar. Você ouve seu grito contorcido. Vê o fogo escurecer ao tocá‑lo. Nada escapa ao inferno. Mas, quando a terra estiver queimada, você poderá decidir o que fazer dela."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_214@BUTTON_0"
msgstr "Proíba [influence/] que alguém se estabeleça aqui. [renown/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_214@BUTTON_1"
msgstr "Transforme a terra [unitprod/] em campos agrícolas [food/]."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_214@BUTTON_4"
msgstr "Reconstrua os alicerces."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_214@BUTTON_5"
msgstr "Opção de Lorde Vampiro ou outra opção de suserano (WIP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_214@TITLE"
msgstr "Aldeia Calamitada: Em Chamas"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_215@BODY_FOOTER"
msgstr "O que fará? (WIP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_215@BODY_HEADER"
msgstr "Uma larva recém‑nascida chora, está ferida e perdida. (WIP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_215@BODY_LORE"
msgstr "Está devorando os suprimentos da aldeia. \n"
" \n"
"Uma larva de graça, quer aceitá‑la? (WIP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_215@BUTTON_0"
msgstr "Acaricie a larva [unit/] (WIP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_215@BUTTON_1"
msgstr "Mate a larva [goodact/] (WIP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_215@BUTTON_4"
msgstr "Estude a larva [knowledge/] (WIP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_215@TITLE"
msgstr "Aldeia Calamitada – Lamentando (WIP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_216@BODY_FOOTER"
msgstr "O destino da família está em suas mãos. O que fará?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_216@BODY_HEADER"
msgstr "Nenhuma casa abriga uma alma viva. Apenas uma, cuja porta range ao se aproximar."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_216@BODY_LORE"
msgstr "Os habitantes da casa saem rastejando. Um adulto e duas crianças, famintos e assustados. Você vê a corrupção percorrendo suas veias; podem transformar‑se nos mesmos monstros que os caçaram. O adulto fala com voz trêmula: \"Restou‑nos pouco… mas pode ficar com esta relíquia, se nos conceder passagem segura.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_216@BUTTON_0"
msgstr "Deixe‑os juntar‑se a {EventCity}. [unhappiness/] [goodact/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_216@BUTTON_1"
msgstr "Acabe com eles, não pode deixar a maldição se espalhar."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_216@BUTTON_4"
msgstr "Liberte‑os [mana/] do feitiço [goodact/]."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_216@BUTTON_5"
msgstr "Disperse a energia da sombra para remover a maldição deles. [goodact/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_216@BUTTON_6"
msgstr "Desfaça a energia do caos para remover a maldição deles. [goodact/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_216@TITLE"
msgstr "Aldeia Calamitada: Sobreviventes"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_217@BODY_FOOTER"
msgstr "Embora gasto e esfarrapado, o manto ainda vibra com poder antigo. Você precisará do seu {GLOBAL.ItemForgeConcept.Hyperlink} para repará‑lo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_217@BODY_HEADER"
msgstr "Embora não haja vento, um manto esfarrapado se agita sobre a superfície. Como se percebesse a presença de {EventHero}, o manto se dirige a <<P:EventHero>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_217@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Embora não haja vento, um manto esfarrapado se agita sobre a terra árida. Como se percebesse sua presença, o manto se dirige a você."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_217@BODY_LORE"
msgstr "Do manto emana uma presença fantasmagórica, mal segurando o tecido. Uma voz cansada ecoa: \n"
"\"O {EventArtifact}... prende minha linhagem a este mundo. Deve ser reparado... antes que o nome da minha família desapareça.\" \n"
"Com as últimas palavras de <<o:SoulHero>>, o espírito definha, deixando o manto cair aos seus pés. Como a pele descartada de algo que já não pertence a este mundo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_217@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Do manto emana uma presença fantasmagórica, mal segurando o tecido. Uma voz cansada ecoa: \n"
"\"O {EventArtifact}... ainda prende nossa linhagem a este mundo. Deve ser reparado... antes que nos tornemos extintos.\" \n"
"Com as últimas palavras de <<o:SoulHero>>, o espírito definha, deixando o manto cair aos seus pés. Como a pele descartada de algo que já não pertence a este mundo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_217@BUTTON_0"
msgstr "\"Esta linhagem não será relegada ao esquecimento.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_217@BUTTON_1"
msgstr "\"Este fardo não me cabe.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_217@TITLE"
msgstr "Manto do Antepassado"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_218@BODY_FOOTER"
msgstr "O fantasma anseia pelo {EventArtifact}. O que responderá?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_218@BODY_HEADER"
msgstr "Você reforjou o {EventArtifact}. Do manto remendado surge a figura espectral, <<o:SoulHero>> contorno agora nítido e presença <<o:SoulHero>> revitalizada."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_218@BODY_LORE"
msgstr "Com a sua própria essência, você reacendeu o {EventArtifact} que era meu… e dos meus ancestrais, claro. Sua generosidade é… deliciosa, {PlayerLeader}; mas eu odiaria testá‑la ainda mais. Permita‑me devolver esta vestimenta ao seu lugar legítimo, para que—sob o meu nome—novo sangue a revistam novamente.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_218@BUTTON_0"
msgstr "\"Leve‑a e lembre‑se de quem salvou sua linhagem.\" [influence/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_218@BUTTON_1"
msgstr "\"A vestimenta está sintonizada comigo agora.\" [item/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_218@TITLE"
msgstr "O Dono do Manto"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_219@BODY_FOOTER"
msgstr "O espírito que você ajudou não era uma alma perdida, mas um Vampiro envolto em necessidade. O que decretará?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_219@BODY_HEADER"
msgstr "Pessoas têm desaparecido em seu reino. Os relatórios de seus investigadores permitiram encontrar o culpado, <<o:SoulHero>> ainda com as mãos ensanguentadas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_219@BODY_LORE"
msgstr "O fantasma que você ajudou antes agora aparece <<r:SoulHero>> diante de você como um Vampiro, o {EventArtifact} drapejado sobre os ombros de <<o:SoulHero>>. \"Nos encontramos novamente, {PlayerLeader}. devo-lhe uma explicação,\" diz <<p:SoulHero>> com um sorriso. \"Derrotado e desesperado, derramei o último da minha essência no meu manto, na esperança de me esconder e recuperar minha força. O próprio manto que você restaurou à sua plena glória.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_219@BUTTON_0"
msgstr "\"Enquanto você servir [unitHero/] a mim, poderá saciar sua fome [population/] [evilact/].\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_219@BUTTON_1"
msgstr "\"Você não escapará do meu julgamento.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_219@BUTTON_4"
msgstr "\"Saiba o seu lugar, novato, você servirá [unitHero/] a mim e se banqueteará fora [thralls/] dos meus domínios.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_219@TITLE"
msgstr "Manto do Vampiro"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_221@BODY_FOOTER"
msgstr "A aparição está presa pela ira e pelo pesar. {EventHero} responderá ao seu clamor?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_221@BODY_HEADER"
msgstr "{EventHero} ouve um lamento desolado; um grito de dor que não tem ferida; um fantasma usando uma expressão eterna de agonia."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_221@BODY_LORE"
msgstr "Gesticulando entre soluços, ela diz: \"Que tipo de mundo é este onde não há justiça? Que tipo de dor é esta, que nem a própria morte pode silenciar? Meus filhos... meus pobres filhos.\"\n"
"Seu luto explode em fúria enquanto ela afirma: \"Você não escapará de mim! Posso sentir seu fedor, {FairSoulHero2}.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_221@BUTTON_0"
msgstr "\"Eu reivindicarei sua vingança.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_221@BUTTON_1"
msgstr "Deixe a alma atormentada."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_221@TITLE"
msgstr "Lamento da Dama"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_224@BODY_FOOTER"
msgstr "A ira do espectro não conhece limites. Você continuará com sua busca por vingança?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_224@BODY_HEADER"
msgstr "Após a batalha recente, entre os caídos, a aparição vingativa ergue-se sobre sua vítima aterrorizada."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_224@BODY_LORE"
msgstr "\"O que eu fiz a você\", grita o homem. \"Você pode não ser ele — mas carrega o mesmo fedor de mal. O fedor de quem é capaz de derramar o sangue de seus próprios filhos\", responde o espectro. E após avançar contra ele com toda a sua fúria, deixa o homem sem vida. \n"
"\"Não foi ele, devemos continuar a busca\", diz a aparição."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_224@BUTTON_0"
msgstr "\"Continuarei até que você descanse em paz.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_224@BUTTON_1"
msgstr "\"Não posso seguir você, perdeu o caminho.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_224@BUTTON_4"
msgstr "\"Esta carnificina precisa acabar.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_224@TITLE"
msgstr "Vingança da Dama"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_240@BODY_FOOTER"
msgstr "A ira do espectro não conhece limites. Você continuará com sua busca por vingança?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_240@BODY_HEADER"
msgstr "Após a batalha recente, entre os caídos, a aparição vingativa ergue-se sobre sua vítima aterrorizada."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_240@BODY_LORE"
msgstr "\"Continuarei até que você descanse em paz.\" \"Como eu lhe fiz mal\", exclama o homem. \n"
"\"Você pode não ser ele — mas o mesmo fedor de mal o envolve. O fedor de quem abusou da própria alma que jurou amar\", responde o espectro. E após avançar contra ele com toda a sua fúria, deixa o homem sem vida. \"Não foi ele, devemos continuar a busca\", diz a aparição."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_240@BUTTON_0"
msgstr "\"Continuarei até que você descanse em paz.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_240@BUTTON_1"
msgstr "\"Não posso seguir você, perdeu o caminho.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_240@BUTTON_4"
msgstr "\"Esta carnificina precisa acabar.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_240@TITLE"
msgstr "Vingança da Dama"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_241@BODY_FOOTER"
msgstr "A ira do espectro não conhece limites. Você continuará com sua busca por vingança?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_241@BODY_HEADER"
msgstr "Após a batalha recente, entre os caídos, a aparição vingativa ergue-se sobre sua vítima aterrorizada."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_241@BODY_LORE"
msgstr "\"Eu não sou ele, nunca o conheci\", grita o homem. \"Talvez não — mas você carrega o mesmo fedor de mal. Um fedor que cheira a mentiras, traição e tortura\", responde o espectro. E após avançar contra ele com toda a sua fúria, deixa o homem sem vida. \n"
"\"Não foi ele, devemos continuar a busca\", diz a aparição."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_241@BUTTON_0"
msgstr "\"Continuarei até que você descanse em paz.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_241@BUTTON_1"
msgstr "\"Não posso seguir você, perdeu o caminho.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_241@BUTTON_4"
msgstr "\"Você precisa parar esta carnificina.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_241@TITLE"
msgstr "Vingança da Dama"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_242@BODY_FOOTER"
msgstr "A aparição revelou suas verdadeiras faces. Como você responderá?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_242@BODY_HEADER"
msgstr "O semblante da aparição se contorce e se divide em caretas impossíveis, formando múltiplas faces e revelando sua verdadeira natureza, a de um {EventUnit}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_242@BODY_LORE"
msgstr "Suas vozes clamam: \n"
"\"Somos o sofrimento dos que foram abusados. Somos a raiva dos que morreram em agonia. Somos aqueles que nunca conheceram justiça.\n"
"Tomaram nossa sanidade. Tomaram nossas vidas. Tomaram tudo o que tínhamos.\n"
"Não tomarão nossas lágrimas. Não tomarão nossa fúria. E você não tomará nossa vingança!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_242@BUTTON_0"
msgstr "\"Você aceitará a morte — queira ou não.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_242@BUTTON_1"
msgstr "\"Talvez nossos objetivos estejam, de fato, alinhados.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_242@BUTTON_4"
msgstr "\"Continue, mas não caminharei ao seu lado.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_242@BUTTON_5"
msgstr "[reputation8/] \"Não consigo compreender sua dor, mas juntos podemos erradicar o mal.\" [unit/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_242@TITLE"
msgstr "Faces da Dama"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_243@TITLE"
msgstr "Banido da Dama"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_246@BODY_FOOTER"
msgstr "Com as pendências de <<o:SoulLoverHero>> concluídas, o fantasma desvanece. O que {EventHero} fará?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_246@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Com as pendências de <<o:SoulLoverHero>> concluídas, o fantasma desvanece. O que você fará?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_246@BODY_HEADER"
msgstr "Um fantasma se manifesta diante de {EventHero}. O olhar de <<Co:SoulLoverHero>>, encharcado de lágrimas que nunca caem, implora por ajuda."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_246@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Um fantasma se manifesta diante de você. O olhar de <<Co:SoulLoverHero>>, encharcado de lágrimas que nunca caem, implora por ajuda."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_246@BODY_LORE"
msgstr "\"Sua presença... me chama... Você pode me ajudar. Eu desvaneço, estou me desfazendo, não quero partir; não agora que posso estar com meu amado. Passamos uma vida inteira tentando nos alcançar, mas só nos encontramos na morte. Por favor, una‑nos. Una nossas almas no anel de casamento, para que possamos ficar juntos para sempre.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_246@BUTTON_0"
msgstr "\"Descanse sua alma agora, honrarei seus desejos.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_246@BUTTON_1"
msgstr "\"Você não sabe o que está pedindo.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_246@TITLE"
msgstr "Morte Nupcial"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_247@BODY_FOOTER"
msgstr "Você tem apenas um momento antes que a alma do consorte se perca para sempre. O que você fará?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_247@BODY_HEADER"
msgstr "Ao ser a alma embutida no anel, uma explosão de luz espectral irrompe. Um segundo espírito se manifesta em seu brilho."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_247@BODY_LORE"
msgstr "\"Não! O que você fez?! Onde está <<p:SoulHero>>?!\" Ao lançar um olhar ao {EventArtifact}, <<p:SoulLoverHero2>> compreende. \"Oh, minha querida, minha doce querida, o que você fez? Você era a última âncora que me mantinha aqui. Eu ansiava partir juntos... onde quer que a jornada... nos leve...\" \n"
"\n"
"Antes de quase desaparecer, a alma clama \"Eu não... quero estar... sozinha... novamente.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_247@BUTTON_0"
msgstr "Quebre o anel, permitindo que ambas as almas passem. [mana/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_247@BUTTON_1"
msgstr "Una ambas as almas ao anel. [item/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_247@BUTTON_4"
msgstr "\"Vocês ficarão juntos—mas não em vida, nem em morte.\" [evilact/] [unit/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_247@TITLE"
msgstr "Até que a Morte nos Separe"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_265@BODY_FOOTER"
msgstr "O fantasma que antes implorou por sua ajuda agora está diante de você—alma de <<o:SoulHero>> desfigurada pela vingança. O que você fará?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_265@BODY_HEADER"
msgstr "Desde que você decidiu manter {EventArtifact}, sussurros infestam os cantos, com palavras que você não consegue entender."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_265@BODY_LORE"
msgstr "Você nunca está só, mesmo quando a sala está vazia. Os murmúrios se apoderam de você nos momentos de descanso, crescendo cada vez mais alto. De repente, uma voz—fragmentada, incompleta, porém unida—sussurra com dicção perfeita: \"Não há verdadeiro sono para os perversos.\" O espírito aparece diante de você, sua sede de vingança deformou a alma de <<o:SoulHero>>, transformando‑o em um {LivingFogUnit}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_265@BUTTON_0"
msgstr "Enfrente o espírito vingativo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_265@BUTTON_1"
msgstr "\"O que é uma alma perversa para um necromante?\" [souls/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_265@BUTTON_4"
msgstr "\"Em nome de tudo que é sagrado, desapareça, presença repugnante!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_265@BUTTON_5"
msgstr "Corte a conexão de <<o:SoulHero>> com o reino dos vivos."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_265@TITLE"
msgstr "Manto da Vingança"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_356@BODY_FOOTER"
msgstr "Os despojos da batalha jazem no campo. O que você fará com eles?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_356@BODY_HEADER"
msgstr "Com o escarmuça terminada, o campo de batalha exala uma solenidade silenciosa. Uma força fantasmagórica se manifesta à distância."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_356@BODY_LORE"
msgstr "Ela aparece novamente, o espírito que o guiou aqui, surgindo ao lado do alvo de sua fúria. Mas algo está errado; ambos parecem confusos.\n"
"\n"
"Sua mente retorna ao desfecho da batalha. Não resta muito após o combate, mas o suficiente para que você possa aproveitá‑lo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_356@BUTTON_0"
msgstr "Troque os bens por ouro. [gold/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_356@BUTTON_1"
msgstr "Entregue‑os aos seus estudiosos. [knowledge/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_356@BUTTON_4"
msgstr "Destine‑os à sua cidade, {EventCity}. [happiness/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_356@TITLE"
msgstr "Despojos da Batalha"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_475@BODY_FOOTER"
msgstr "Você terá que voltar mais tarde."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_475@BODY_HEADER"
msgstr "Uma presença obscurece o ar, mas sua forma está velada."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_475@BODY_LORE"
msgstr "A alma só se manifestará diante de vontades maiores, como as de heróis e Governantes."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_475@BUTTON_0"
msgstr "Deixe a alma perdida."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_475@TITLE"
msgstr "Alma Perdida"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_515@BODY_FOOTER"
msgstr "[hyperlink,GLOBAL.VampireLordConcept]Vampiros[/hyperlink] não são mais potencializados pela Lua de Sangue e novamente sofrem as consequências de andar sob a luz do dia."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_515@BODY_HEADER"
msgstr "A Lua de Sangue minguar, e o medo da luz retorna àqueles que se deleitam na escuridão."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_515@BODY_LORE"
msgstr "O sol nasce atrás da lua que se desvanece, restaurando a cor ao mundo. Seus raios dão vida aos prados e acendem esperança nos corações cansados. As criaturas do crepúsculo recuam para suas tocas, protegidas pelas sombras que nelas habitam."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_515@BUTTON_0"
msgstr "Despeça‑se da noite rubra."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_515@TITLE"
msgstr "Lua de Sangue: Consequência"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_542@BODY_FOOTER"
msgstr "As vozes gritam para {EventHero} segui-las. Será que <<p:EventHero>> encontrará a origem do sofrimento deles?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_542@BODY_HEADER"
msgstr "{EventHero} sente a presença deles. Não um, não dois, mas uma amalgama de fantasmas. Todos falando ao mesmo tempo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_542@BODY_LORE"
msgstr "\"Parem-nos. Ajudem-nos. Nossa carne... nossas almas... consumidas.\" Uma das vozes se liberta da amalgama, \"Eles estão tentando criá-lo. A essência da vida, a tintura, a pedra da imortalidade.\" Então, como um só, falam novamente. \"Um para transformar chumbo em ouro. Um para transformar a morte em vida. Mas a magia tem um preço, e fomos nós.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_542@BUTTON_0"
msgstr "Rastreie onde eles levam."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_542@BUTTON_1"
msgstr "Deixe as almas perdidas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_542@TITLE"
msgstr "Sangue e Alma"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_543@BODY_FOOTER"
msgstr "A energia está diante de você, aguardando transmutação pela sua vontade."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_543@BODY_HEADER"
msgstr "O último cultista cai. Sangue e carne são consumidos pelo círculo ritual, completando o rito."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_543@BODY_LORE"
msgstr "À medida que os caídos são absorvidos pelo sigilo de sangue, uma energia carmesim irrompe. Ondas se propagam para fora, girando em um vórtice violento. A cada turno ele se contrai, condensando-se em uma anomalia escarlate. Ele chama por você. É poder — bruto e indomável, aguardando ser moldado."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_543@BUTTON_0"
msgstr "Crie um {BloodGlass} na área."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_543@BUTTON_1"
msgstr "Disperse a energia [mana/]. Libere as almas [goodact/]."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_543@BUTTON_4"
msgstr "Molde a energia na essência da vida necessária para forjar a pedra da imortalidade."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_543@TITLE"
msgstr "Sangue e Alma: Consequência"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_549@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "As vozes gritam para que você as siga. Você encontrará a origem do sofrimento delas?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_549@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você sente a presença deles. Não um, não dois, mas uma amalgama de fantasmas. Todos falando ao mesmo tempo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_555@BODY_FOOTER"
msgstr "O que assombra esta aldeia não é uma simples maldição, mas uma doença viva: consciente, voraz, indomável. O que você fará com ela?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_555@BODY_HEADER"
msgstr "Você fecha os olhos e busca a presença que atormenta esta aldeia. Ela é informe, antiga, paciente."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_555@BODY_LORE"
msgstr "A presença é consciente. Lâminas de memória o agarram: um homem de vermelho, rituais experimentais de sangue e almas. Uma doença que infecta o sangue, sangue que infecta a alma, alma que molda o corpo em seu reflexo perverso. Então você compreende, está vendo pelos olhos daqueles tomados pela doença. A doença é a própria presença."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_555@BUTTON_0"
msgstr "Alimente [mana/] e deixe a presença consumir a aldeia [evilact/], completando sua metamorfose [unit/]."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_555@BUTTON_1"
msgstr "Permita que a presença o infecte [hp/], concedendo-lhe seu poder [xp/]."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_555@BUTTON_4"
msgstr "Isole a doença [unitprod/], seus estudiosos aprenderão [knowledge/] com ela e impedirão sua propagação."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_555@TITLE"
msgstr "Presença Sombria"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_577@BODY_FOOTER@HERO_IS_PALYERLE"
msgstr "A aparição está presa pela ira e pelo pesar. Você atenderá ao seu clamor?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_577@BODY_HEADER@HERO_IS_PALYERLE"
msgstr "Você ouve um grito desolado; um berro de dor que não tem ferida; um fantasma usando uma expressão eterna de agonia."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_579@BODY_FOOTER"
msgstr "Suas tropas libertaram esta terra desta ameaça. Mas um rastro de pegadas fantasmagóricas de casco indica o caminho para um local incerto."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_579@BODY_HEADER"
msgstr "A cavalaria morta jaz derrotada, mas seus fantasmas não encontram descanso."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_579@BODY_LORE"
msgstr "As almas de cavaleiros e cavalos surgem de seus restos. Impulsionados por uma força imperativa, eles incitam seus corcéis e galopam para longe. Apenas o Cavaleiro Decapitado resiste ao impulso, pois por um instante <<p:RiderSoulHero>> se volta para você. Ainda assim, por esse breve momento, você sente <<o:RiderSoulHero>> desespero, como se <<p:RiderSoulHero>> não mais comandasse suas próprias ações."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_579@BUTTON_0"
msgstr "Rastreie as aparições equinas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_579@BUTTON_1"
msgstr "Deixe as almas dos cavaleiros."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_579@TITLE"
msgstr "Cavalaria Decapitada"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_580@BODY_FOOTER"
msgstr "A cabeça do fantasma voa, carregada por uma entidade desconhecida."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_580@BODY_HEADER"
msgstr "Um fantasma se manifesta diante de {EventHero}. Inconsciente da presença de <<o:EventHero>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_580@BODY_LORE"
msgstr "Como se ainda estivesse vivo, o fantasma passeia, falando com uma figura que não está lá. De repente, <<p:HeadlessSoulHero>> se vira, com medo estampado no rosto de <<o:HeadlessSoulHero>>. Você ouve o trovão fantasmagórico de cascos galopantes se aproximando — e então, SHUNK! A cabeça de <<Co:HeadlessSoulHero>> é cortada, voando dos ombros de <<o:HeadlessSoulHero>>. Uma força invisível a agarra do chão e desaparece ao longe."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_580@BUTTON_0"
msgstr "Rastreie onde ele conduz e enfrente o decapitador."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_580@BUTTON_1"
msgstr "Deixe a alma perdida."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_580@TITLE"
msgstr "Vítima Sem Cabeça"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_583@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Um fantasma se manifesta diante de você. Inconsciente da sua presença."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_600@BODY_FOOTER"
msgstr "A cabeça do cavaleiro sem cabeça está em suas mãos. Será este o fim do dever de <<o:RiderSoulHero>>?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_600@BODY_HEADER"
msgstr "Os mortos retornaram aos seus túmulos. O cemitério está em paz novamente."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_600@BODY_LORE"
msgstr "Ao lado da estátua do cavaleiro jazem várias cabeças decapitadas e ossos espalhados, circundados por runas pintadas de sangue. Os necromantes usaram esses restos para invocar a cavalaria e vinculá‑la à sua vontade. Uma cabeça irradia uma energia intimidadora, uma aura que você reconhece da Cavaleiro Decapitado."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_600@BUTTON_0"
msgstr "\"Seu juramento ainda não foi cumprido.\" [item/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_600@BUTTON_1"
msgstr "As almas perdidas [souls/] são suas para reivindicar."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_600@BUTTON_4"
msgstr "Purifique a maldição [goodact/] e deixe sua bandeira para trás. [influence/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_600@TITLE"
msgstr "Fim do Meu Dever"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_602@BODY_FOOTER"
msgstr "O cemitério parece esconder grandes perigos."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_602@BODY_HEADER"
msgstr "O relatório do seu batedor é breve: a trilha fantasmagórica termina em um cemitério sombrio."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_602@BODY_LORE"
msgstr "A mensagem está escrita às pressas com mão trêmula: \"Acho que consigo ouvir cantos dentro do cemitério. Minha montaria se recusa a se aproximar mais da área. Mas, através do portão, vislumbro um grupo cercando uma grande estátua de um cavaleiro em seu corcel. Os túmulos aqui estão vazios, {PlayerLeader.Title}. Por favor, tenha cuidado.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_602@BUTTON_0"
msgstr "Prepare suas tropas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_602@BUTTON_5"
msgstr "Deixe as almas perdidas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_602@TITLE"
msgstr "Onde meus ossos descansam"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_623@BODY_FOOTER"
msgstr "O espírito deseja que você erga um grande palácio onde <<p:FluteSoulHero>> possa executar música <<o:FluteSoulHero>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_623@BODY_HEADER"
msgstr "Uma rajada de vento assobia uma melodia. Carregada pela mesma brisa, um espírito ganha forma."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_623@BODY_LORE"
msgstr "<<Co:FluteSoulHero>> flauta canta com um ritmo dançante, porém cada nota arrasta‑se pelo chão com uma pesada melancolia. O espírito percebe a presença de {EventHero} e exclama:\n"
"\"Você pode me ouvir? Você pode me ouvir! Faz décadas que alguém consegue. Você... Você serve a um(a) {EventPlayerType}... Com a magia <<o:LeaderType>>, <<o:LeaderType>> todo o reino poderia ouvir minha canção! Por favor, construa um grande palco onde eu possa tocar.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_623@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "<<Co:FluteSoulHero>> flauta canta com um ritmo dançante, porém cada nota arrasta‑se pelo chão com uma pesada melancolia. O espírito percebe sua presença e exclama:\n"
"\"Você pode me ouvir? Você pode me ouvir! Faz décadas que alguém consegue. Você... Você é um(a) {EventPlayerType}... Com sua magia, todo o seu reino poderia ouvir minha canção! Por favor, construa um grande palco onde eu possa tocar.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_623@BUTTON_0"
msgstr "Prometa ao espírito <<o:FluteSoulHero>> um palco."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_623@BUTTON_1"
msgstr "Deixe a alma perdida."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_623@TITLE"
msgstr "Última Sinfonia"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_624@BODY_FOOTER"
msgstr "O bardo fantasma agora oferece <<o:FluteSoulHero>> serviço. O que você pedirá a <<P:FluteSoulHero>>?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_624@BODY_HEADER"
msgstr "Quando a estrutura for construída, o espírito ergue a flauta <<o:FluteSoulHero>>, e a música inunda os salões."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_624@BODY_LORE"
msgstr "A canção ecoa pelos altos salões que carregam seu nome, seu emblema, sua própria essência. Amplificada pelo vínculo do seu império com o [hyperlink,GLOBAL.AstralSeaLoreConcept]Mar Astral[/hyperlink], a melodia se espalha por todos os cantos do seu domínio. Quando a última nota se esvai, o espírito se volta para você:\n"
"\"Obrigado. Sempre desejei tocar para um reino inteiro. Antes de desaparecer, permita-me conceder-lhe algo em troca.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_624@BUTTON_0"
msgstr "\"Deixe sua flauta para que ainda possamos ouvir sua música.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_624@BUTTON_1"
msgstr "Continue a tocar, para que as pessoas venham ao meu reino."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_624@BUTTON_4"
msgstr "Cante uma canção em meu nome."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_624@TITLE"
msgstr "Última Sinfonia: Consequência"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_638@BODY_FOOTER"
msgstr "O espírito oferece ajuda <<o:KingSoulHero>> ao seu novo reinado. O que você pedirá a <<P:KingSoulHero>>?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_638@BODY_HEADER"
msgstr "O fantasma do monarca morto aparece ao seu lado enquanto você reconquista {EventHouse}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_638@BODY_LORE"
msgstr "\"O usurpador se foi, e meu domínio agora repousa em suas mãos. Quão doce é a vitória, e quão efêmera. Meu tempo aqui acabou, {PlayerLeader.Name}. Contudo, antes de partir, ainda guardo alguma força dentro de mim. Permita-me oferecer um último presente a este reino ressurgente.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_638@BUTTON_0"
msgstr "Acesso aos arquivos privados de <<o:KingSoulHero>>. [knowledge/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_638@BUTTON_1"
msgstr "Tratados antigos sobre comércio, a serem invocados à sua vontade. [gold/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_638@BUTTON_4"
msgstr "Uma carta de recomendação, endereçada às cidades livres do reino. [allegiance/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_638@TITLE"
msgstr "Destituído: Consequência"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_639@BODY_FOOTER"
msgstr "Parece que o antigo monarca de {EventHouse} permanece, exigindo vingança contra o usurpador do trono de <<o:KingSoulHero>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_639@BODY_HEADER"
msgstr "Um espírito aparece diante de {EventHero}, balbuciando e agitando‑se em fúria. A voz de <<Co:KingSoulHero>> eleva‑se em um amargo discurso:"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_639@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Um espírito aparece diante de você, balbuciando e agitando‑se em fúria. A voz de <<Co:KingSoulHero>> eleva‑se em um amargo discurso:"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_639@BODY_LORE"
msgstr "\"Maldito seja <<p:CityRuler>>! Que os esquemas de <<o:CityRuler>> apodreçam e envenenem o próprio sangue de <<o:CityRuler>>, que a bile de <<o:CityRuler>> queime <<P:CityRuler>> de dentro! <<Cp:CityRuler>> queria‑me morto, pois <<p:CityRuler>> cobiçava meu reino. E agora estou morto, e meu reino está <<o:CityRuler>>. Saiba disso, quem governa em {EventHouse} não é um Governante legítimo. Não deixarei este mundo até obter minha vingança!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_639@BUTTON_0"
msgstr "\"Executarei sua vingança.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_639@BUTTON_1"
msgstr "Deixe a alma perdida."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_639@BUTTON_5"
msgstr "Ensine‑me as melhores técnicas de colheita para estas terras."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_639@TITLE"
msgstr "Destituído"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BODY_FOOTER"
msgstr "{EventHero} tornou‑se o porta‑estandarte desta terrível procissão de almas, e eles reivindicam a essência de <<o:EventHero>>. O que <<p:EventHero>> fará?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Você se tornou o porta‑estandarte desta terrível procissão de almas, e eles reivindicam sua essência. O que você fará?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BODY_HEADER"
msgstr "O portador condenado entrega o estandarte pesado a {EventHero}. Quando a pegada de <<o:PilgrimHero>> afrouxa, <<p:PilgrimHero>> desaba sem vida no chão."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "O portador condenado entrega a você o estandarte pesado. Quando a pegada de <<o:PilgrimHero>> afrouxa, <<p:PilgrimHero>> desaba sem vida no chão."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BODY_LORE"
msgstr "Toda a marcha volta o olhar para {EventHero}. E então <<p:EventHero>> sente—a própria essência de <<o:EventHero>> é atraída para o estandarte, escorrendo como água em solo árido, desaparecendo em um vazio insondável. Os mortos exigem que os vivos conduzam sua procissão profana. {EventHero} assumiu o manto do penitente anterior, a maldição agora pertence a <<o:EventHero>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Toda a marcha volta o olhar para você. E então você sente—sua própria essência é atraída para o estandarte, escorrendo como água em solo árido, desaparecendo em um vazio insondável. Os mortos exigem que os vivos conduzam sua procissão profana. Você assumiu o manto do penitente anterior, a maldição agora é sua."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BUTTON_0"
msgstr "Banir a procissão profana."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BUTTON_1"
msgstr "{EventHero} é mais forte que a maldição, <<p:EventHero>> pode suportá‑la."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "Você é mais forte que a maldição, pode suportá‑la."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BUTTON_4"
msgstr "Alimente [mana/] de mana ao estandarte para saciá‑lo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BUTTON_5"
msgstr "Não será a alma de <<o:EventHero>> [souls/] que eles drenam."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BUTTON_5@HERO_IS_PLAYERLE"
msgstr "Não será sua alma [souls/] que eles drenam."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BUTTON_6"
msgstr "{EventHero} já caminha entre os mortos [unitUndead/], eles não têm direito sobre <<P:EventHero>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BUTTON_6@HERO_IS_PLAYERLE"
msgstr "Você já caminha entre os mortos [unitUndead/], eles não têm direito sobre você."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@TITLE"
msgstr "Fardo Penitencial"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_641@BODY_FOOTER"
msgstr "O homem condenado implora a {EventHero} que tome o estandarte <<o:PilgrimHero>> e alivie o tormento de <<o:PilgrimHero>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_641@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "O homem condenado implora que você tome o estandarte <<o:PilgrimHero>> e alivie o tormento de <<o:PilgrimHero>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_641@BODY_HEADER"
msgstr "Uma procissão de espíritos se forma diante de {EventHero}. Contudo, quem a lidera não parece uma alma de forma alguma."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_641@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Uma procissão de espíritos se forma diante de você. Contudo, quem a lidera não parece uma alma de forma alguma."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_641@BODY_LORE"
msgstr "A marcha avança em duas longas fileiras, cada peregrino fantasmagórico segurando uma vela acesa. Todos, exceto um, a figura na frente. Cadavérico e sombrio, <<p:PilgrimHero>> carrega um estandarte pesado, <<o:PilgrimHero>> voz oca chama {EventHero}:\n"
"\"Misericórdia, carregue meu fardo, ainda que por um momento.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_641@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "A marcha avança em duas longas fileiras, cada peregrino fantasmagórico segurando uma vela acesa. Todos, exceto um, a figura na frente. Cadavérico e sombrio, <<p:PilgrimHero>> carrega um estandarte pesado, <<o:PilgrimHero>> voz oca chama você:\n"
"\"Misericórdia, carregue meu fardo, ainda que por um momento.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_641@BUTTON_0"
msgstr "Ajude o porta‑estandarte."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_641@BUTTON_1"
msgstr "Deixe a alma perdida."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_641@TITLE"
msgstr "Procissão Profana"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_223@BODY_FOOTER"
msgstr "\"Se quiser meu sangue, então traga‑me a Rosa de Obsidiana do palácio em ruínas de {Emperor.FirstName} e coloque‑a aos meus pés. A oferta é feita ao pequeno '[hyperlink,GLOBAL.ElderVampireLoreConcept]Ancião[/hyperlink].' Eu estarei observando você, tchau.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_223@BODY_HEADER"
msgstr "\"Tut‑tut, bichinho,\" ronrona {Wife.TitleFirstName}, \"Mas como pretende entrar no descanso final de <<Co:Emperor>> sem nem o meu sangue, hm?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_223@BODY_HEADER@DONT_KNOW"
msgstr "{Wife.TitleFirstName} enrola o lábio <<o:Wife>>. \"Ah, que fofo. Como ficaria se a mãe lhe desse um pouquinho—de motivação?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_223@BODY_HEADER@RESIST_WIFE"
msgstr "{Wife.TitleFirstName} explode em uma risada contagiante. \"Oh, que delícia! Sua resistência mesquinha é simplesmente... Mhh, irresistível. Preciso de mais!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_223@BODY_LORE"
msgstr "\"Sim, decidi, pode ficar,\" sorri {Wife.TitleFirstName}. \"Sem dúvida, você veio aqui para abrir aquela cripta fétida do meu marido em decomposição, {Emperor.FirstName}. Mas, para isso, primeiro é preciso o meu sangue exaltado, com o qual aquele lugar está completamente selado. Contudo, se pretende matar esse bastardo miserável, talvez eu esteja disposta a fazer um pequeno—negócio...\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_223@BUTTON_0"
msgstr "\"Vou considerar isso.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_223@BUTTON_1"
msgstr "\"Vou usar seu sangue para puxar minhas cordas do coração!\" [influence/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_223@BUTTON_2"
msgstr "\"Não, obrigado.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_223@TITLE"
msgstr "Chave para a minha Corda do Coração"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_223@TITLE@DONT_KNOW"
msgstr "{Wife.TitleFirstName} enrola o lábio <<o:Wife>>. “Naw, que fofo. Como ficaria se a mãe lhe desse um pouquinho—de motivação?” (WIP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_223@TITLE@RESIST_WIFE"
msgstr "{Wife.TitleFirstName} explode em uma risada contagiante. “Oh, que delícia! Sua resistência mesquinha é simplesmente… Mhh, irresistível. Preciso de mais!” (WIP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_224@BODY_FOOTER"
msgstr "{Wife.TitleFirstName} <<o:Wife>> olhar maléfico perfura sua visão e fura sua própria corda do coração... \"Diga‑me, minha doce, o que a traz ao meu domínio?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_224@BODY_HEADER"
msgstr "Sombras estranhas cegam seus sentidos, então um sussurro agudo entra em seu ouvido interno... \"O que é isso que encontro, um desconhecido '{GLOBAL.ElderVampireLoreConcept.Hyperlink}' perambulando meu reino? Depois de tanto tempo.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_224@BODY_LORE"
msgstr "Das trevas mais profundas surge a forma aterrorizante de um(a) {GLOBAL.ArchvampireLoreConcept.Hyperlink}, {Wife.TitleName}, lendário autor do Tomo do Tormento e primeira esposa do [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] <<Cr:Emperor>>. <<Cp:Wife>> o examina com um olhar predatório, então ergue o queixo <<o:Wife>> e exibe um sorriso tênue e canino. De repente, seu peito começa a doer! Parece que <<p:Wife>> está lançando algum tipo de feitiço sobre você."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_224@BUTTON_0"
msgstr "\"Para despertar o Deus Imortal.\" [xp/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_224@BUTTON_1"
msgstr "Fique em silêncio."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_224@BUTTON_2"
msgstr "\"Isso não é da sua conta!\" [relationLvl3/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_224@BUTTON_4"
msgstr "Resista ao feitiço de <<P:Wife>>. [mana/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_224@BUTTON_5"
msgstr "\"Vim por sangue, o seu em particular!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_224@TITLE"
msgstr "O Arqui-dam do Túmulo"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_225@BODY_FOOTER"
msgstr "{Wife.TitleFirstName} estremece de fúria. \"Na verdade, este é o pedido que faço a você ao conceder meu sangue para abrir a cripta fétida de <<Co:Emperor>>... Mate <<CP:Emperor>>!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_225@BODY_HEADER"
msgstr "\"Esplêndido!\" exclama {Wife.TitleFirstName}. \"Meu, meu, parece que você conhece o caminho ao coração de um vampiro com precisão mortal. Podemos ter um interesse comum nisso, minha querida.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_225@BODY_LORE"
msgstr "{Wife.TitleFirstName} estuda a Rosa de Cruor com uma carranca feérica e melancólica. \"Esta rosa sangrenta foi cultivada para <<Co:Emperor>>... <<Co:Emperor>> maldita bruxa...\" <<Cp:Wife>> fecha <<P:Wife>> olhos por um momento e pressiona a rosa contra o peito de <<o:Wife>>. Então, os olhos de <<P:Wife>> se inflamam com um olhar sedento de sangue. \"Sim. Quero <<P:Emperor>> morto!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_225@BUTTON_0"
msgstr "\"Eu cuidarei de tudo.\" [rs_alliance/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_225@BUTTON_1"
msgstr "\"Não, obrigado. Agora entregue-me seu sangue!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_225@BUTTON_2"
msgstr "\"Qualquer coisa, por um preço...\" [thralls/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_225@BUTTON_3"
msgstr "\"O que quiser. Primeiro fortaleça-me através da dor!\" [xp/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_225@TITLE"
msgstr "Chave da minha Cordão do Coração: Conquistada"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_240@BODY_FOOTER"
msgstr "Com a cripta de <<Po:Emperor>> agora deslacrada e vazia, a herança da coroa de '{Emperor.Name}' permanece ao seu alcance — título, trono e tudo mais..."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_240@BODY_HEADER"
msgstr "Por sua mão, o [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] foi derrotado. Um ato que ecoa entre os [hyperlink,GLOBAL.ArchvampireLoreConcept]Arquivampiros[/hyperlink] por todo o {GLOBAL.AstralSeaLoreConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_240@BODY_LORE"
msgstr "Embora ainda não conheçam seu nome, todos os Arqui-sacerdotes e Arqui-dams conhecerão você por seus feitos, e o temerão para sempre! Pois, se um vampiro pôde matar o imortal — Soberano de todos — o que então impede a Prole de se levantar contra seus próprios Senhores em completa e total anarquia? Assim, por essa credencial nasce uma nova era manchada de sangue para todo o tipo vampiro."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_240@BUTTON_0"
msgstr "\"Sangue por sangue!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_240@TITLE"
msgstr "Cripta do Deus Imortal: Despedaçada"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_248@BODY_FOOTER"
msgstr "Ninguém entrou em {EventRealm} desde então, até agora. Enquanto uma noite predestinada nasce ao longe com o uivo dos lobos, você fica a refletir sobre o motivo de ter vindo aqui..."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_248@BODY_HEADER"
msgstr "Antes que você atravesse um reino sem Sol de mito e lenda, mais antigo que as memórias mais antigas até mesmo da maioria dos {GLOBAL.GodirLoreConcept.Hyperlink}. Aqui, a linhagem de sangue puro começou há muito tempo e alcançou seu zênite histórico."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_248@BODY_LORE"
msgstr "Naqueles dias passados, o tipo vampiro governava um domínio sedento de sangue que aterrorizava o {GLOBAL.AstralSeaLoreConcept.Hyperlink}. Naquela época, todos os puros-sangues estavam unidos sob um 'imperador eterno', agora lembrado apenas como o '[hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink]'. Seja por hubris ou traição, esse domínio de terror acabou desmoronando e foi banido para {GLOBAL.GrexolisLoreConcept.Hyperlink} por razões há muito esquecidas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_248@BUTTON_0"
msgstr "\"A traição destruiu nossa grandeza, mas pretendo restaurá-la novamente!\" [influence/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_248@BUTTON_1"
msgstr "\"A hubris causou a queda de Drevanya, pretendo concluir o trabalho.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_248@BUTTON_2"
msgstr "\"A noite me convocou aqui, seus filhos [unit/] me mostrarão o caminho.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_248@BUTTON_3"
msgstr "\"Quem se importa com o passado? Só sinto fome de sangue!\" [xp/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_248@TITLE"
msgstr "A Noite Cai sobre Rued Drevanya"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_257@BODY_FOOTER"
msgstr "Para quem você dá a Rosa de Cruor? (TEMP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_257@BODY_HEADER"
msgstr "Você recebeu a Rosa de Obsidiana. (TEMP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_257@BODY_LORE"
msgstr "Dê esta rosa a uma das consortes para ganhar sua confiança e receber uma aliança. (TEMP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_257@BUTTON_0"
msgstr "Dê a Rosa à Princesa Consorte Mavelith (TEMP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_257@BUTTON_1"
msgstr "Dê a Rosa ao Príncipe Consorte Wtorakh (TEMP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_257@BUTTON_2"
msgstr "Nenhum! Pegue para si mesmo. (TEMP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_257@TITLE"
msgstr "Trapaça da Rosa de Obsidiana (TEMP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_264@BODY_FOOTER"
msgstr "{Husband.TitleFirstName} dedos <<o:Husband>> lábio reluzente enquanto <<p:Husband>> secretamente lança um feitiço em você que ferve seu sangue. \"Mostre-me como um vampiro adequado cumprimenta seu superior.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_264@BODY_HEADER"
msgstr "Um estranho borbulhar e fervilhar entra em sua percepção, seguido por um chiado baixo... \"Meu, meu... Que brinquedo curioso e anômalo eu aqui avisto?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_264@BODY_LORE"
msgstr "Do canto do seu olho, você vê uma névoa quente e carmesim surgir, da qual emerge uma figura encharcada de sangue com postura distinta: o lendário {GLOBAL.ArchvampireLoreConcept.Hyperlink}, {Husband.TitleFirstName}. \"Após eras de solidão, finalmente sou agraciado com um rosto novo — e que rosto!… Você é 'um dos meus', talvez? Não importa, acredito que as apresentações são necessárias, não concorda? Ou sua geração abandonou os bons modos como antes fizeram com os {Emperor.Title}?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_264@BUTTON_0"
msgstr "Curve-se profundamente e com cortesia. [relationLvl3/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_264@BUTTON_1"
msgstr "Apenas observe <<P:Husband>> em silêncio."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_264@BUTTON_2"
msgstr "Erga-se altivo e zomba de <<P:Husband>> em desafio! [influence/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_264@BUTTON_3"
msgstr "Ofereça a <<P:Husband>> um sacrifício fresco de sangue. [thralls/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_264@BUTTON_4"
msgstr "\"Ninguém é meu superior. Pereça, seu palhaço!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_264@TITLE"
msgstr "Impressões Iniciais Ferventes"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_268@BODY_FOOTER"
msgstr "\"Se você me jurar fidelidade, seu fabuloso Príncipe, <<p:Husband>>, a Obsidian Rose do palácio do [hyperlink,GLOBAL.UrvatoghLoreConcept]Deathless God[/hyperlink]. Então estarei disposta a compartilhar uma gota do meu sangue mais puro.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_268@BODY_HEADER"
msgstr "\"Encantado, com certeza,\" sorri o {Husband.Title} com um aceno. \"Ah, juventude, lembra-me de mim mesmo nessa idade, contornando a etiqueta e a insolência. Tão ousado, tão atrevido.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_268@BODY_HEADER@BOW_LOW"
msgstr "\"Por que, meu caro suplicante,\" reconhece {Husband.TitleFirstName}, enquanto <<p:Husband>> faz uma reverência aristocrática em resposta, \"Vós agraciais vosso Príncipe^m com uma classe verdadeiramente saborosa de cortesia.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_268@BODY_HEADER@RESIST_HUSBAND"
msgstr "\"Oh? Você, um [hyperlink,GLOBAL.ElderVampireLoreConcept]Elder[/hyperlink], ousa me desafiar? Um {GLOBAL.ArchvampireLoreConcept.Hyperlink}?\" ri {Husband.TitleFirstName} com um rosnado bestial. \"Quão delicioso, quão... Elegante!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_268@BODY_LORE"
msgstr "\"Vamos tratar dos negócios, certo?\", começa o {Husband.Title}. \"Sei tudo sobre você, {Player.Name}. Busca abrir a cripta de nosso sagrado '{Emperor.Title}', não é? Para isso seria necessário o sangue dos Consortes <<Co:Emperor>> — como o meu. Agora, graças à sua... bastante... notável introdução, ouso dizer que sinto o desejo de — possivelmente — atender à sua empreitada ousada. Em troca, naturalmente, por um sacrifício insignificante.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_268@BUTTON_0"
msgstr "\"Vou considerar isso.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_268@BUTTON_1"
msgstr "\"Vou usar seu sangue para ferver o meu!\" [influence/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_268@BUTTON_2"
msgstr "\"Não, obrigado.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_268@TITLE"
msgstr "Chave do meu Desejo"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_269@BODY_FOOTER"
msgstr "<<Cp:Husband>> esmaga lentamente a Obsidian Rose em sua <<o:Husband>> punho e lambe a seiva negra de sua <<o:Husband>> palma. \"Pode guardar um pequeno segredo, meu recém‑encontrado aliado?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_269@BODY_HEADER"
msgstr "\"Para mim? Ah, não precisava,\" finge {Husband.TitleFirstName}. \"Que espécime deslumbrante e magnífico; assim como, claro, a rosa...\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_269@BODY_LORE"
msgstr "Cheirando a rosa, <<p:Husband>> levanta o olhar para você com um piscar lento. \"Ah, o aroma do amor verdadeiro,\" sorri o {Husband.Title}, \"Quão nulo... Bem, continue então. Vamos entreter essa magnífica empreitada sua, hmm? Imagine que despertássemos o [hyperlink,GLOBAL.UrvatoghLoreConcept]Deathless God[/hyperlink], e então? Louvor e glória? Ah não, devo avisá-lo: meu Sire^m não é um conto de fadas e agradar <<CP:Emperor>> é realmente insensatez. Não, nosso antigo Criador, por mais esplêndido que <<Cp:Emperor>> seja, é uma mente extremamente maléfica que não aceita iguais — se você 'entendeu a indireta...'\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_269@BUTTON_0"
msgstr "\"Mas é claro, meu Príncipe.\" [rs_alliance/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_269@BUTTON_1"
msgstr "\"Não, obrigado. Agora entregue-me seu sangue!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_269@BUTTON_2"
msgstr "\"Por um preço [thralls/], é claro.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_269@BUTTON_3"
msgstr "\"Meu Príncipe, você me lisonjeia. Segredos são a minha especialidade.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_269@TITLE"
msgstr "Chave do meu Desejo: Conquistada"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_273@BODY_FOOTER"
msgstr "\"Se você também pretende matar esse 'Deus Imortal', então tenho uma proposta a fazer,\" propõe <<p:Huntress>>, abaixando lentamente os braços <<o:Huntress>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_273@BODY_HEADER"
msgstr "Um fétido odor mortal invade suas narinas. Então, uma figura sombria e furtiva surge à vista. \"Eu reconheço um Vampiro quando o vejo.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_273@BODY_LORE"
msgstr "Mantendo a mão <<P:Huntress>> próxima à sua arma <<P:Huntress>>, <<p:Huntress>> ainda assim lhe dirige um sorriso sombrio. \"Você não é daqui, está? Acho que também procura desvendar aquele tal '[hyperlink,GLOBAL.UrvatoghLoreConcept]Deathless God[/hyperlink]' seu, não? Bem, eu também, {Huntress.TitleFirstName}. Minhas razões não precisam de explicação, espero.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_273@BUTTON_0"
msgstr "Ouça a oferta dela, por enquanto..."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_273@BUTTON_1"
msgstr "“Eu reconheço um caçador quando sinto seu cheiro, prepare-se para morrer!” (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_273@TITLE"
msgstr "Dois Predadores em Confronto"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_277@BODY_FOOTER"
msgstr "\"Declare guerra contra {Wife.FirstName} e {Husband.FirstName},\" anuncia {Huntress.FirstName} sombriamente. \"Assim sei que posso confiar em você. Matamos os Consortes, tomamos seu sangue e abatemos [hyperlink,GLOBAL.UrvatoghLoreConcept]Urvatogh[/hyperlink] de uma vez por todas. O que diz?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_277@BODY_HEADER"
msgstr "{Huntress.FirstName} devolve a você um sorriso fino e sincero. \"Obrigado por me ouvir. Vou direto ao ponto.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_277@BODY_LORE"
msgstr "\"Minha pesquisa indica que a cripta deste '[hyperlink,GLOBAL.UrvatoghLoreConcept]Deathless God[/hyperlink]' está trancada por um Rito de Sangue, realizado pelos Consortes <<o:Emperor>>,\" explica {Huntress.FirstName}. \"A maioria deles fugiu do reino antes de ser selada, exceto dois: {Wife.TitleFirstName} e {Husband.TitleFirstName}. Portanto, eles bloqueiam nosso caminho. Felizmente, também se odeiam, então, se quiser abrir aquela cripta, é assim que procedemos...\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_277@BUTTON_0"
msgstr "\"Vou pensar sobre isso.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_277@BUTTON_1"
msgstr "\"Por que devo confiar em um Caçador de Vampiros? Fora!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_277@BUTTON_2"
msgstr "\"Você ousa desperdiçar meu tempo, morra!\" [influence/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_277@BUTTON_3"
msgstr "\"Já está feito.\" [influence/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_277@TITLE"
msgstr "Inimigo do Meu Inimigo"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_278@BODY_FOOTER"
msgstr "<<Cp:Huntress>> arma a <<o:Huntress>> besta e lhe lança um olhar determinado. \"Vamos caçar alguns Vampiros.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_278@BODY_HEADER"
msgstr "\"Bem feito,\" comenta {Huntress.FirstName} com uma expressão ligeiramente perplexa."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_278@BODY_HEADER@BADASS"
msgstr "{Huntress.FirstName} fixa o olhar em você com a boca <<o:Huntress>> ligeiramente aberta, antes de corrigir <<r:Huntress>> com um sorriso surpreso."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_278@BODY_LORE"
msgstr "\"Serei honesta, duvidei que você o fizesse. Estávamos em lados opostos, por assim dizer. Mas agora que você declarou guerra contra aqueles [hyperlink,GLOBAL.ArchvampireLoreConcept]arch suckers[/hyperlink], estou bastante ansiosa para ver isso até o fim.\" <<Cp:Huntress>> revira a bolsa <<co:Huntress>>, então levanta o olhar para você, antes de jogar um saco tilintante. \"Não se preocupe, é ouro. Essa é a primeira metade da recompensa, porque agora as coisas vão ficar realmente sérias, muito em breve.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_278@BUTTON_0"
msgstr "\"Diga-me seu plano.\" [rs_defensivepact/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_278@BUTTON_1"
msgstr "\"Obrigado pelo ouro, tolo. Agora morra!\" [evilact/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_278@BUTTON_2"
msgstr "\"Preciso de mais ouro [gold/] do que isso antes de começar a ouvir.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_278@TITLE"
msgstr "Inimigo do meu Inimigo: Meu Amigo"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_284@BODY_FOOTER"
msgstr "{Wife.TitleFirstName} sorri de forma lasciva, \"Não há mais súplicas por misericórdia. Eu te encontrarei nas minhas masmorras!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_284@BODY_HEADER"
msgstr "Por um breve instante, {Wife.TitleFirstName} curva o lábio <<o:Wife>> e lança-lhe um olhar desanimado."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_284@BODY_LORE"
msgstr "\"Ah...\" <<p:Wife>> suspira levemente, \"Parece que você prefere o caminho da dor, que pena. Bem, ao menos para você. Eu, por outro lado, mal posso esperar para fazer você gritar, meu travesso pequeno [hyperlink,GLOBAL.ElderVampireLoreConcept]Ancião[/hyperlink].\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_284@BUTTON_0"
msgstr "\"Que assim seja.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_284@TITLE"
msgstr "Dor e Traição"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_285@BODY_FOOTER"
msgstr "\"Minha decisão está tomada,\" sorri o {Husband.Title} enquanto <<p:Husband>> desvia o olhar. \"Lamente este dia, patife. Em breve você conhecerá o seu lugar de direito.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_285@BODY_HEADER"
msgstr "Por um breve batimento, ou até dois, {Husband.TitleFirstName} franze a testa e lança-lhe um olhar dolorido."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_285@BODY_LORE"
msgstr "\"Ah, tanto faz,\" começa <<p:Husband>>, com um gesto despreocupado do pulso <<o:Husband>>, \"O que mais eu poderia esperar de um rústico como um '{GLOBAL.ElderVampireLoreConcept.Hyperlink}'? Não importa, ao que parece preciso conquistar minha adoração 'do jeito de sempre...' À força.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_285@BUTTON_0"
msgstr "\"Que assim seja.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_285@TITLE"
msgstr "Traição Fervente"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_290@BODY_FOOTER"
msgstr "\"É aqui que você entra, minha querida,\" sorri {Wife.FirstName}. \"Tome meu sangue, procure a cripta de <<Co:Emperor>> e mate aquele porco imundo por mim! Isso me libertaria da influência de <<Co:Emperor>>, finalmente!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_290@BODY_HEADER"
msgstr "\"Ah, gosto de você,\" observa {Wife.TitleFirstName} com um sorriso dentado. \"Confio em você. Por isso revelarei a verdade a você, e só a você.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_290@BODY_LORE"
msgstr "\"Eu fui a primeira vítima de <<Co:Emperor>>, sabe. E quando {Emperor.FirstName} me transformou, <<Cp:Emperor>> lançou uma maldição de controle mental que me impediu de jamais ferir <<CP:Emperor>>. Ah, eu odiava ser um Vampiro, e <<Cp:Emperor>> gostava de me fazer sofrer. Implorei por morte, mas <<Cp:Emperor>> me recusou todas as vezes. Então, jurei destruir <<CP:Emperor>>! Contudo... Todo esse tempo eu fui impotente para fazê‑lo eu mesmo.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_290@BUTTON_0"
msgstr "\"Vamos matar <<CP:Emperor>>, juntos.\" [relationLvl3/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_290@BUTTON_1"
msgstr "\"Qualquer coisa, por um preço...\" [gold/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_290@BUTTON_2"
msgstr "\"Não, obrigado, farei isso sozinho.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_290@TITLE"
msgstr "Sangue por Sangue"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_291@BODY_FOOTER"
msgstr "Ao longe, um lobo uiva na noite, anunciando o alvorecer de uma nova era para toda a espécie vampírica. Com o trono agora vago, cabe a você reivindicá‑lo — e compartilhá‑lo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_291@BODY_HEADER"
msgstr "Enquanto o pó da guerra se assenta e uma lua nova surge sobre este reino, {Wife.FirstName} aparece ao seu lado com um sorriso estranhamente sincero. \"Liberdade...\" <<p:Wife>> sussurra."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_291@BODY_LORE"
msgstr "\"Perdi a conta das eras que esse bastardo miserável me atormentou. Ver <<P:Emperor>> derrotado enche meu coração frio e sem vida de... De...\" De repente, {Wife.FirstName} aperta o peito <<o:Wife>> com um suspiro. Então lança um olhar para você com um largo sorriso dentado e olhos curiosos e perolados. \"O quê?\" <<p:Wife>> escarnece, enquanto um leve rubor colore o rosto <<o:Wife>>. \"Não fique apenas olhando sua Princesa^f assim, faça algo.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_291@BUTTON_0"
msgstr "Ofereça sua mão a {Wife.FirstName}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_291@TITLE"
msgstr "Sangue por Sangue: Lua Nova"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_295@BODY_FOOTER"
msgstr "\"Você, porém, pode fazer o que eu não pude,\" provoca o {Husband.Title}. \"Vá à cripta de <<Co:Emperor>>, e acabe com o {Emperor.Title} de uma vez por todas! Então, estarei livre!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_295@BODY_HEADER"
msgstr "{Husband.TitleFirstName} suspira. \"Ser um {GLOBAL.ArchvampireLoreConcept.Hyperlink} não é tudo o que parece...\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_295@BODY_LORE"
msgstr "\"Eu estava lá quando nossa espécie foi 'gerada', quando as bênçãos de <<Co:Emperor>> foram distribuídas pela primeira vez. E também, a maldição de <<Co:Emperor>>... Ser ligado ao [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] por toda a eternidade, e seguir a vontade dominante de <<Co:Emperor>> como um marionete miserável em cordas ensanguentadas. Ugh, {Emperor.FirstName} me fez fazer... coisas 'indizíveis', e eu não tive vontade de negar <<CP:Emperor>>. Então, sim, admito, compliquei‑me com {Wife.FirstName} e os outros para selar <<CP:Emperor>>! Pois, como prole miserável de <<Co:Emperor>>, eu não podia matar <<CP:Emperor>>...\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_295@BUTTON_0"
msgstr "\"Vamos acabar com <<CP:Emperor>> juntos, meu Príncipe.\" [relationLvl3/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_295@BUTTON_1"
msgstr "\"Por um preço, [gold/], é claro.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_295@BUTTON_2"
msgstr "\"Não, obrigado, farei isso sozinho.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_295@TITLE"
msgstr "Ansiando por Regicídio"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_296@BODY_FOOTER"
msgstr "Ao longe, um lobo uiva na noite, anunciando o alvorecer de uma nova era para toda a espécie vampírica. Com o trono agora vago, cabe a você reivindicá‑lo — e compartilhá‑lo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_296@BODY_HEADER"
msgstr "Enquanto o pó da batalha se assenta, uma lua nova surge sobre Drevanya. E neste momento {Husband.TitleFirstName} aparece diante de você com um sorriso diabólico."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_296@BODY_LORE"
msgstr "\"Ah, o sabor da liberdade,\" sussurra {Husband.FirstName}. \"É a coisa mais—maravilhosa! E pensar que tenho você, minha querida {Player.FirstName}, a quem devo agradecer por isso.\" Um momento silencioso passa enquanto {Husband.FirstName} o observa com curiosa delícia. \"O trono imperial de Drevanya está terrivelmente 'vazio', não concorda? Que tal, você e eu aquecê‑lo um pouco? Eu conheço o feitiço perfeito.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_296@BUTTON_0"
msgstr "Aceite a oferta de {Husband.FirstName} <<o:Husband>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_296@TITLE"
msgstr "Ansiando por Regicídio: Saciado"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_300@BODY_FOOTER"
msgstr "{Huntress.FirstName} olha nos seus olhos com determinação furiosa. \"{Emperor.FirstName} precisa ser detido. Vá, conduza o caminho até o {EventStructure}, só um Vampiro pode entrar nele.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_300@BODY_HEADER"
msgstr "\"Antes de começarmos,\" suspira {Huntress.FirstName}, \"acho importante que você saiba contra o que estamos...\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_300@BODY_LORE"
msgstr "\"Provavelmente você não precisa que lhe digam o que está em jogo aqui, mas deixarei claro de qualquer forma. {Emperor.FirstName} gerou os [hyperlink,GLOBAL.ArchvampireLoreConcept]Arquivampiros[/hyperlink], como {Wife.FirstName} e {Husband.FirstName}. Estes, por sua vez, geraram a maioria dos [hyperlink,GLOBAL.ElderVampireLoreConcept]Vampiros Anciões[/hyperlink], como você. Se {Emperor.FirstName} retornasse, todos os Arquivampiros e sua prole se reuniriam instantaneamente ao lado de <<o:Emperor>>. Juntos, eles desencadeariam uma frente imbatível e unida contra todos os {GLOBAL.WorldsWithinLoreConcept.Hyperlink}!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_300@BUTTON_0"
msgstr "\"Vamos matar este 'Deus Imortal', juntos.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_300@BUTTON_1"
msgstr "\"Pensando bem, irei sozinho.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_300@BUTTON_2"
msgstr "\"Idiota ignorante. Anseio ver todos os Vampiros unidos! Agora morra!\" [evilact/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_300@BUTTON_3"
msgstr "\"Sim, {Huntress.FirstName}, olhe nos meus olhos...\" [evilact/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_300@TITLE"
msgstr "Morte ao Deus Imortal"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_301@BODY_FOOTER"
msgstr "Ao longe, um lobo uiva na noite, anunciando uma nova era para a raça vampírica. O que o futuro reserva, ninguém pode dizer, e talvez seja melhor assim."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_301@BODY_HEADER"
msgstr "Com o banimento de <<o:Emperor>> concluído, a cripta do [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] jaz em ruínas diante de você e sua missão aqui está cumprida."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_301@BODY_LORE"
msgstr "\"Coisa impressionante,\" observa {Huntress.FirstName} com notável traço de admiração. <<Cp:Huntress>> permanece ao seu lado por um instante e contempla a devastação que você causou. \"Falo sério, sabe. Você impediu que os [hyperlink,GLOBAL.ArchvampireLoreConcept]Arquivampiros[/hyperlink] se reunissem sob um mestre comum, mais uma vez. Tenho que admitir, nunca pensei que sentiria alguma admiração por um vampiro em minha vida, mas você... Bem, você mudou tudo.\" {Huntress.FirstName} interrompe e ri. \"Qual é o seu nome, afinal?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_301@BUTTON_0"
msgstr "Caminhe para a noite."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_301@TITLE"
msgstr "Herói Não Cantado da Noite"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_305@BODY_FOOTER"
msgstr "Prepare-se bem! Explore o {EventStructure} para encontrar cara a cara o [hyperlink,GLOBAL.UrvatoghLoreConcept]Progenitor Vampiro[/hyperlink] <<Cr:Emperor>> e desencadear o tão aguardado Ajuste de Sangue."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_305@BODY_HEADER"
msgstr "Com o sangue da Consorte em sua posse, você pode finalmente deslacrar a cripta que o trouxe a este reino o tempo todo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_305@BODY_LORE"
msgstr "Toda a raça vampírica tem sua origem em uma única fonte: o [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink], o Sire^m de todos, <<Cp:Emperor>> que espalhou <<Co:Emperor>> bênção e <<Co:Emperor>> maldição sobre o {GLOBAL.WorldsWithinLoreConcept.Hyperlink} a partir da [hyperlink,GLOBAL.ArchvampireLoreConcept]Primeira Ninhada[/hyperlink], chegando até você. As terras sem Sol, os rios de sangue, a fome e o poder, tudo isso surgiu através do <<Co:Emperor>> poder magnífico e terrível."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_305@BUTTON_0"
msgstr "\"Eu sou o ajuste.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_305@BUTTON_1"
msgstr "... Alimente-se de seus escravos por sangue. (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_305@BUTTON_2"
msgstr "... Alimente-se de seus escravos por glória. (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_305@TITLE"
msgstr "Peregrinação Sepulcral"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_306@BODY_FOOTER"
msgstr "Ao longe, um lobo uiva na noite. Com o [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] derrotado, o trono e o título de <<o:Emperor>> permanecem vagos para quem os tomar..."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_306@BODY_HEADER"
msgstr "Sangue por sangue! Por sua mão, {Emperor.Name} foi derrotado e as lendas de sua grandeza 'imortal' foram provadas falsas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_306@BODY_LORE"
msgstr "Este foi o 'Ajuste de Sangue' que trouxe uma nova era para toda a raça vampírica, libertada da opressiva herança de seu criador. Suas ações neste reino derrubaram a ordem hierárquica que há muito segmentava os vampiros, desde tempos imemoriais. Pois se você, um {GLOBAL.ElderVampireLoreConcept.Hyperlink}, pôde derrubar o [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] sem consequências, o que então impediria a Prole Vampira Menor de se rebelar contra seus próprios Sires? Não, seu legado certamente inspirará gerações de vampiros que buscarão seguir seus passos."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_306@BUTTON_0"
msgstr "\"Meu legado será imortal.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_306@TITLE"
msgstr "Um Legado Imortal"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_315@BODY_FOOTER"
msgstr "\"{Player.FirstName}, meu libertador,\" <<p:Emperor>> declara sombriamente. \"Sonhei com este exato momento por dias incontáveis. E agora, como uma oração feita carne, você chegou. Bem-vindo.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_315@BODY_HEADER"
msgstr "Uma melodia crua e assombrosa reverbera pelos salões e corredores de pedra escura, abandonados pela luz, que compõem a necropólis subterrânea sob o monte sangrento."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_315@BODY_LORE"
msgstr "Seguir a música até sua origem revela uma cidade esquecida dos mortos, imersa em um tema majestoso, porém triste, reminiscente de um amor perdido há muito tempo. Então, a música termina abruptamente e um silêncio tirânico domina totalmente o vazio auditivo, um silêncio tão intenso que cria um vácuo escancarado rumo ao próprio esquecimento. Contudo, desse vazio surge uma voz profunda e sonora, imersa em soberania imemorial e remorso..."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_315@BUTTON_0"
msgstr "\"Revele-se.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_315@BUTTON_1"
msgstr "(DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_315@BUTTON_2"
msgstr "Lute e desafie o Deus Imortal! (WIP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_315@TITLE"
msgstr "Prelúdio de uma Escuridão sem Lua"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_319@BODY_FOOTER"
msgstr "\"Começamos imediatamente. Destruam todos que permanecem no reino, não deixem nenhuma alma viva ou não viva. Não me importa como será feito, mas batizem a nova Drebanya completamente com seu sangue!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_319@BODY_HEADER"
msgstr "Por um breve instante, {Emperor.FirstName} fecha <<Co:Emperor>> os olhos e derrama uma única lágrima. Então, <<Cp:Emperor>> ilumina <<Co:Emperor>> os olhos com resolução imperial. \"Drevanya se erguerá novamente.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_319@BODY_LORE"
msgstr "<<Cp:Emperor>> olha para você, e uma escuridão cobre o rosto de <<Co:Emperor>>. \"Desencadearemos um Ajuste de Sangue sobre o {GLOBAL.AstralSeaLoreConcept.Hyperlink} que semeará medo nos corações de todos. Começando com minhas criações defeituosas, {Wife.FirstName} e {Husband.FirstName}, esses sediciosos e ingratos patifes que ainda se autodenominam meus Consortes, como qualquer...\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_319@BUTTON_0"
msgstr "\"Assim se faça a tua vontade.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_319@BUTTON_1"
msgstr "\"Eis que já fiz como desejas!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_319@TITLE"
msgstr "Ajuste Sobre os Traidores"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_320@BODY_FOOTER"
msgstr "\"Una-se a mim, {Player.FirstName}, e juntos dominaremos o vasto {GLOBAL.AstralSeaLoreConcept.Hyperlink} com um domínio vampírico maior do que antes.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_320@BODY_HEADER"
msgstr "Com todo o reino coberto pelo sangue dos traidores, {Emperor.Name} aparece ao seu lado com um olhar sombrio e pensativo. \"Você fez bem.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_320@BODY_LORE"
msgstr "<<Cp:Emperor>> suspira, então se volta para você com um sorriso distante. \"Quando eu era mais jovem,\" começa <<Cp:Emperor>>, \"cometi o erro de saciar o vazio em meu coração não vivo com o conforto ocioso de Consortes indulgentes. Desde então, tenho uma eternidade para reconsiderar meus apetites infantis e entender que parceria é, em última análise, uma união de poder. E neste dia, {Player.FirstName} você é o vampiro mais poderoso que já conheci.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_320@BUTTON_0"
msgstr "\"O ajuste é nosso.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_320@TITLE"
msgstr "Um Ajuste Inigualável"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_341@BODY_FOOTER"
msgstr "Sussurros chiantes emanam da fenda velada por sombras encontrada sob o altar sacrificial... (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_341@BODY_HEADER"
msgstr "Você sacrificou o Juramento do Amante e limpou a cripta, mas não encontrou o Deus Imortal... (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_341@BODY_LORE"
msgstr "O cadáver rígido do vampiro era um engodo, isto não é o Deus Imortal. Onde poderia Ele estar? O coração desapareceu, a fonte de sangue foi toda drenada para o chão... Mas espere! Ao inspecionar o altar, detecta-se um contorno peculiar no pedestal; o altar de ébano esculpido pode ser movido para revelar um grande abismo abissal abaixo. (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_341@BUTTON_0"
msgstr "\"Será?\"... (OBSOLETO)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_341@TITLE"
msgstr "Profanando a Cripta Profana (EVENTO MARCADOR)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_377@BODY_FOOTER"
msgstr "Eis, este é o {EventStructure} desocupado. Dizem que seus salões e corredores sombrios abrigam segredos indescritíveis, além de uma única rosa de esplendor lendário..."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_377@BODY_HEADER"
msgstr "No alto daquela colina surge uma estrutura imponente porém melancólica. Parece abandonada, embora ainda emane uma aura poderosa e maléfica."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_377@BODY_LORE"
msgstr "Os terrenos diante do palácio tomado por rosas são marcados por pântanos encharcados de sangue, exalando o fétido odor da morte. Seu silencioso pátio interno é protegido por um vasto muro rastejante de arbustos de espinhos afiados como navalhas, vigiado por gárgulas petrificadas que afastam visitantes indesejados... Elas guardam o local profano onde incontáveis vidas de mortais foram sacrificadas em antigos ritos de sangue e orgias nos dias passados, quando o [hyperlink,GLOBAL.UrvatoghLoreConcept]Imperador Sangrento Eterno[/hyperlink] reinava supremo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_377@BUTTON_0"
msgstr "Avance."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_377@TITLE"
msgstr "Palácio do Príncipe Pálido"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_378@BODY_FOOTER"
msgstr "Os corredores intermináveis do labirinto dobram-se e serpenteiam com uma vastidão sobrenatural. Todos que o adentram sempre saem exatamente pelo mesmo caminho por onde entraram..."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_378@BODY_FOOTER@HAVE_QUEST"
msgstr "Os corredores intermináveis do labirinto dobram-se e serpenteiam com uma vastidão sobrenatural. Mas uma voz familiar acaricia sua mente e guia seu caminho adiante, rumo a um grupo de protetores esqueléticos e espinhados..."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_378@BODY_HEADER"
msgstr "No alto de uma saliência rochosa ergue-se o {EventStructure}, cercado por um vasto labirinto vivo de sebes tomadas por rosas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_378@BODY_LORE"
msgstr "Este labirinto diabólico exala uma terrível aura antiga, nascida de uma magia de sangue extremamente vil, tecida há muito tempo pelo [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] <<Cr:Emperor>>. Ao se aproximar, pode-se ouvir o lamento fraco e fantasmagórico de mil vítimas sacrificadas. As almas tributárias ao {Emperor.Title}, nos tempos de esplendor de Drevanya... Agora, seu sofrimento interminável alimenta e retorce a folhagem tomada por rosas de sua própria prisão."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_378@BUTTON_0"
msgstr "Disperse [mana/] o feitiço de proteção que protege o labirinto."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_378@BUTTON_1"
msgstr "Abandone o labirinto, por enquanto."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_378@BUTTON_2"
msgstr "Siga a voz da Princesa Consorte Mavelith. [relationLvl3/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_378@BUTTON_3"
msgstr "Siga a voz do Príncipe Consorte Wtorakh. [relationLvl3/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_378@TITLE"
msgstr "Afogado em Sangue e Estupefato"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_380@BODY_FOOTER"
msgstr "A Rosa de Obsidiana brilha como uma joia. É uma planta viva e imortal que exala uma poderosa aura de magia das sombras, e agora é sua."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_380@BODY_HEADER"
msgstr "Ao derrotar o grupo de guardas de rosas mortos‑vivos, o Palácio de Rosas do [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] está livre para ser explorado."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_380@BODY_LORE"
msgstr "Ao som de um trovão, as grandes portas decoradas com o emblema de uma rosa se abrem. Além delas encontra-se um palácio tomado por rosas, repleto de incontáveis salões de baile e salas de estar abandonados, cobertos de manchas secas de sangue. Subir a escadaria empoeirada leva‑o ao torreão mais alto. Suas portas se abrem revelando uma curiosa estufa, cheia de inúmeras rosas murchas. Mas, em seu centro, cresce uma única Rosa de Obsidiana, tão magnífica que deixa a mente atônita!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_380@BUTTON_0"
msgstr "Dê a Rosa de Obsidiana à Princesa Consorte Mavelith. [relationLvl3/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_380@BUTTON_1"
msgstr "Dê a Rosa de Obsidiana ao Príncipe Consorte Wtorakh. [relationLvl3/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_380@BUTTON_2"
msgstr "Pegue a rosa para si e sugue seu poder! [mana/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_380@BUTTON_2@HAVE_QUEST"
msgstr "Pegue‑a para si e sugue seu poder. [mana/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_380@BUTTON_3"
msgstr "Reivindique esta dádiva das sombras e examine seu poder. [shadowboon/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_380@BUTTON_4"
msgstr "Obtenha esta maravilha da natureza e use‑a para melhorar suas colheitas! [natureboon/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_380@TITLE"
msgstr "A Rosa de Obsidiana"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_410@BODY_FOOTER"
msgstr "Uma louca êxtase domina os cultistas enquanto todos avançam contra você, facas em mãos. À medida que mais figuras surgem das sombras da câmara..."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_410@BODY_FOOTER@NO_KEY"
msgstr "A última linha diz: \"Em Seu corpo eternamente imortal, mas em nossa memória daqui em diante não vivida. Que Ele descanse em miséria.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_410@BODY_HEADER"
msgstr "Como os movimentos de um sonho, as grandes portas de pedra que selaram esta cripta por eras incontáveis se abrem diante de você sem som ou vibração; desaparecendo, como se nunca tivessem existido..."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_410@BODY_HEADER@NO_KEY"
msgstr "Diante de você ergue‑se um grandioso memorial abandonado de fonte de sangue. Foi construído ao redor de uma maciça laje de pedra elaboradamente inscrita, que diz:"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_410@BODY_LORE"
msgstr "Ao adentrar a escuridão além, você é invadido pelo cheiro de rocha, sangue e cera de vela. Em pouco tempo, uma estreita câmara iluminada por velas se revela, cercada por um grupo de figuras encapuzadas que murmuram ao redor de uma estátua tomada por rosas do [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink]. Com sua chegada, os cultistas levantam o olhar, seus olhos cintilando de êxtase. \"O juízo final\", gargalha um cultista. \"Chegou, enfim, a hora do Juízo de Sangue! Irmãos e irmãs, regozijai‑vos! Pelo Deus Imortal, que nosso sangue seja derramado em celebração — derramem‑no agora!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_410@BODY_LORE@NO_KEY"
msgstr "\"Dois amantes despedaçados por rosas derramaram sangue e conceberam uma maldição; uma terra sem sol encharcada em rios de vermelho. Um coração partido conjurou novos amantes forçados; nunca verdadeiros amores, mas servos. Treze consortes negligenciados juraram seu sangue aqui para expiar; e assim selaram seu Soberano na perdição e no terror.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_410@BUTTON_0"
msgstr "\"Recuar!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_410@BUTTON_0@NO_KEY"
msgstr "Volte mais tarde."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_410@BUTTON_1"
msgstr "Derrame seu sangue!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_410@TITLE"
msgstr "Êxtase para o Juízo"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_410@TITLE@NO_KEY"
msgstr "Sem Amor e Imortal"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_411@BODY_FOOTER"
msgstr "Mover a estátua revela um poço de sangue oculto que leva ainda mais fundo às entranhas da terra. E, nas profundezas de sua escuridão eterna, ecoa o som tênue e assombrado — de música."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_411@BODY_HEADER"
msgstr "Vermelho! Vermelho! Vermelho! Após a batalha, toda a câmara está encharcada de sangue e corpos, cobrindo tudo tão completamente de carmesim que quase desperta sua sede vampírica de sangue até a insanidade."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_411@BODY_LORE"
msgstr "Mas enquanto você está ali, com os tornozelos mergulhados em sangue, ouvindo o som da sua própria respiração, uma súbita clareza invade sua consciência: Se esta cripta foi selada, como esses cultistas mortais entraram? E onde está <<Cp:Emperor>>? Onde, na danação, está o [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink]? Você aguça os sentidos e revira cada canto desta cripta notavelmente pequena, mas não encontra nada. Contudo, após algum tempo, percebe que todo o sangue na sala escorre em direção à base da estátua..."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_411@BUTTON_0"
msgstr "Siga a música até sua origem."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_411@TITLE"
msgstr "Rapsódia da Retribuição"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_423@BODY_FOOTER"
msgstr "'{Husband.TitleFirstName}' e '{Wife.TitleFirstName}'. Certamente eles conhecem o nome profano de <<Co:Emperor>>, talvez se você simplesmente lhes perguntar? (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_423@BODY_HEADER"
msgstr "Seguir a atração misteriosa levou‑o a um monte escuro e sagrado, onde se diz que toda a espécie vampírica teve sua origem. (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_423@BODY_LORE"
msgstr "Na sombra sul fica um monumento, banhado em sangue. Ele enumera os nomes daqueles que testemunharam o nascimento do Soberano Noturno em forma de vampiro ascendido <<Co:Emperor>>. No topo estão os nomes dos <<Co:Emperor>> consortes profanos, a maioria riscada violentamente, exceto dois... (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_423@BUTTON_0"
msgstr "Talvez eu considere isso. (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_423@TITLE"
msgstr "Estela ensanguentada (WIP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_427@BODY_FOOTER"
msgstr "Para abrir o túmulo, é preciso encontrar {Wife.TitleFirstName} e {Husband.TitleFirstName} e obter seu sangue — de um jeito ou de outro."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_427@BODY_HEADER"
msgstr "Portanto, o túmulo do [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] está selado com o sangue dos Consortes <<Co:Emperor>>, e somente o sangue deles pode desfazê‑lo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_427@BODY_LORE"
msgstr "Pouco se sabe sobre o [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] além de mitos e lendas cultuais. Mas entre os [hyperlink,GLOBAL.ElderVampireLoreConcept]Vampiros Anciões[/hyperlink] é bem conhecido que o Deus Imortal criou a Primeira Ninhada, os temíveis [hyperlink,GLOBAL.ArchvampireLoreConcept]Arquivampiros[/hyperlink]. Dentre essa ninhada, <<Cp:Emperor>> selecionou um harém de Consortes que <<Cp:Emperor>> vinculou à vontade indomável de <<Co:Emperor>>. Contudo, parece que eles conspiraram para trancar seu Deus Imortal neste túmulo. Como e por quê, bem, só os Consortes restantes podem contar."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_427@BUTTON_0"
msgstr "\"Eu sei o que fazer.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_427@TITLE"
msgstr "Caça ao Cônjuge"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_428@BODY_FOOTER"
msgstr "Cumpra a missão dos Consortes, ou derrote‑os em batalha e recolha seu sangue dos cadáveres. A escolha é sua..."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_428@BODY_HEADER"
msgstr "Você encontrou tanto {Wife.TitleFirstName} quanto {Husband.TitleFirstName}, e ambos reconheceram que selaram o {EventStructure} com seu sangue."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_428@BODY_LORE"
msgstr "Ambos pareciam ansiosos por obter esta Rosa de Obsidiana, mas seus motivos permanecem obscuros... De qualquer forma, uma escolha decisiva agora recai sobre sua consciência: você cumprirá o pequeno desafio deles na esperança de que mantenham a palavra, ou extrairá seu sangue à força?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_428@BUTTON_0"
msgstr "Obtenha a Rosa de Obsidiana, ainda que apenas por enquanto."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_428@TITLE"
msgstr "Caça ao Cônjuge: Encontrou seu Par"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_429@BUTTON_1"
msgstr "Siga o sangrento caminho da guerra!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_429@BUTTON_2"
msgstr "Continue, e torture um Escravo [thralls/] ou dois para cortejar {Wife.TitleFirstName}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_429@BUTTON_3"
msgstr "Continue, e sacrifique um Escravo [thralls/] ou dois para cortejar {Husband.TitleFirstName}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_430@BUTTON_1"
msgstr "\"Talvez eu deva permanecer vigilante...\" (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_430@BUTTON_2"
msgstr "\"Não me importo de qualquer forma; só desejo sangue!\" (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_453@BODY_FOOTER"
msgstr "O que antes foi selado com sangue será logo desselado com ele. Derrote {Wife.TitleFirstName} ou {Husband.TitleFirstName} para obter seu sangue."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_453@BODY_HEADER"
msgstr "É natural que os Vampiros rivalizem com seus pares. Da vida à não‑vida, da Prole ao Soberano^m, do par ao rival, do [hyperlink,GLOBAL.ElderVampireLoreConcept]Vampiro Ancião[/hyperlink] ao {GLOBAL.ArchvampireLoreConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_453@BODY_LORE"
msgstr "Sim. Inevitavelmente, todos os Vampiros geram nova prole. O 'Soberano^m', ou 'Dama^f', torna‑se então o administrador e suserano de sua prole, governando cada ação. Isso, até que a prole finalmente se torne poderosa o bastante para rivalizar com seu criador... Este implacável jogo de poder determina o ciclo de vida de praticamente todos os Vampiros: ou domina, ou é dominado. Então, o que será?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_453@BUTTON_0"
msgstr "\"O sangue deles será meu.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_453@TITLE"
msgstr "Escalando a Cadeia Alimentar"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_456@BODY_FOOTER"
msgstr "Você obteve o sangue exaltado de um Consorte {GLOBAL.ArchvampireLoreConcept.Hyperlink}. Contudo... Você realmente precisa de tudo isso para abrir o {EventStructure}?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_456@BODY_HEADER"
msgstr "{ConsortKilled} foi derrotado! Agora, a terra antes pálida e sem sol está manchada com o sangue puro de um {GLOBAL.ArchvampireLoreConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_456@BODY_LORE"
msgstr "Ao contrário do {GLOBAL.ElderVampireLoreConcept.Hyperlink}, apenas uma ninhada limitada e selecionada de [hyperlink,GLOBAL.ArchvampireLoreConcept]Arquivampiros[/hyperlink] foi gerada pelo [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] — muito menos transformada em Consorte <<Co:Emperor>>. Agora, por suas presas, há ainda um a menos no reino de {EventRealm}!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_456@BUTTON_0"
msgstr "Abstenha‑se de sua fome [goodact/], você é maior que isso. [influence/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_456@TITLE"
msgstr "Escalando a Cadeia Alimentar: Próximo ao Topo"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_473@BUTTON_2"
msgstr "\"O sangue do Consorte já é meu!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_474@BODY_FOOTER@GOT_BLOOD"
msgstr "Você obteve o sangue exaltado de um {GLOBAL.ArchvampireLoreConcept.Hyperlink}. Continue até o {EventStructure} para despertar o [hyperlink,GLOBAL.UrvatoghLoreConcept]Progenitor de toda a espécie vampírica[/hyperlink]."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_474@BUTTON_2"
msgstr "Cometa Diablerie [evilact/] e consuma uma parte deste sangue exaltado! [xp/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_474@BUTTON_3"
msgstr "Realize um Rito Hemoc [thralls/] com este sangue exaltado para expandir seu domínio. [food/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_474@BUTTON_4"
msgstr "Colete todo o sangue, mas reserve uma parte para seus estudos. [knowledge/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_474@BUTTON_5"
msgstr "\"A Contagem de Sangue se aproxima!\" [influence/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_485@BODY_FOOTER"
msgstr "\"Mate {Wife.TitleFirstName} ou {Husband.TitleFirstName}, e obtenha seu sangue. Então poderemos abrir o túmulo e pôr fim a {Emperor.Name}.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_485@BODY_HEADER"
msgstr "{Huntress.FirstName} olha para você com um olhar estudioso. \"Certo, agora vem a parte fácil do plano.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_485@BODY_LORE"
msgstr "\"Vamos fazer o que eu faço de melhor e ver se você também. Mate vampiros. Então, faça o que a sua espécie faz de melhor: todo aquele vodu de sangue miserável, para abrir a cripta. Conforme combinado, precisaremos do sangue dos Consortes para executar o seu—rito, então sabe o que isso significa?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_485@BUTTON_0"
msgstr "\"A caçada começou.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_485@BUTTON_2"
msgstr "\"Esse plano é terrível. Eu seguirei meu próprio caminho.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_485@BUTTON_3"
msgstr "\"O sangue deles já é meu.\" [influence/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_485@TITLE"
msgstr "A Caçada Começou"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_486@BODY_FOOTER"
msgstr "{Huntress.FirstName} ergue o olhar para você com um brilho impaciente no olho <<o:Huntress>>. \"Sua jogada, parceiro.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_486@BODY_HEADER"
msgstr "Com {ConsortKilled} derrotado, {Huntress.FirstName} se aproxima de você com um brilho ambicioso no olho <<p:Huntress>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_486@BODY_HEADER@SUPERBADASS"
msgstr "{Huntress.FirstName} recua e ofega. \"C– Como? Quem?...\" <<p:Huntress>> gagueja com os olhos arregalados. \"Isso é uma caça superior!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_486@BODY_LORE"
msgstr "\"Trabalho impressionante—'parceiro',\" sorri {Huntress.FirstName}. \"Com esse sangue podemos abrir o {EventStructure} e fazer o que antes se julgava impossível. Meu, como sonhei com este momento, e pensar que acontecerá ao lado de um Vampiro ensanguentado, pha!\" <<Cp:Huntress>> fixa o olhar no horizonte por um momento, então sussurra: \"A mãe ficaria orgulhosa...\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_486@BUTTON_0"
msgstr "\"Hora de caçar a grande presa, parceiro.\" [rs_alliance/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_486@BUTTON_2"
msgstr "\"Parceiro? Este sangue é meu e só meu, pereça!\" [evilact/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_486@BUTTON_3"
msgstr "\"Não preciso de parceiro, preciso de ouro.\" [gold/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_486@TITLE"
msgstr "A Caçada Começou: Sucesso!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_491@BODY_FOOTER"
msgstr "<<Cp:Emperor>> estende <<o:Emperor>> mão e sussurra: \"Árbitro do Julgamento de Sangue, revele-me o que anseio saber por toda a eternidade: reinaremos juntos, para sempre; ou serás minha cobiçada destruição?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_491@BODY_HEADER"
msgstr "Do vazio sem luz, duas presas de marfim surgem, seguidas por olhos flamejantes como portais para o [hyperlink,GLOBAL.EndailonLoreConcept]Endailon of Shadow[/hyperlink]. O olhar exaltado de <<Co:Emperor>> captura toda a sua atenção."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_491@BODY_LORE"
msgstr "\"Obrigado por me libertar, minha progênie incomparável,\" confidencia {Emperor.Name}. \"E que Vampiro magnífico você é... Todo o meu sono selado eu sonhei com a sua chegada {Player.Name}. Contudo, agora, ao vê-lo aqui diante de Mim, em toda a sua majestosa perfeição, devo declarar: és uma visão mais gloriosa do que os sonhos jamais poderiam conceber.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_491@BUTTON_0"
msgstr "Una-se ao Deus Imortal ao lado despertado de <<Co:Emperor>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_491@BUTTON_1"
msgstr "Jure destruir o Deus Imortal!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_491@TITLE"
msgstr "Face do Criador Dentado"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_492@BODY_FOOTER"
msgstr "DEPRECATEd"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_492@BODY_HEADER"
msgstr "DEPRECATED"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_492@BODY_LORE"
msgstr "DEPRECATED"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_492@BUTTON_0"
msgstr "DEPRECATED"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_492@TITLE"
msgstr "DEPRECATED"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_493@BODY_FOOTER"
msgstr "<<Cp:Emperor>> lança-lhe um olhar desejoso por um instante, antes de se virar e brandir sua arma <<o:Emperor>>. \"Sangue por sangue.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_493@BODY_HEADER"
msgstr "Por um breve instante, {Emperor.FirstName} sorri para você com afetuosa sinceridade. \"Você é exatamente como eu esperava que fosse, minha progênie da perdição.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_493@BODY_LORE"
msgstr "\"Oh, como anseio por sua melhor tentativa de acabar comigo, {Player.FirstName},\" lamenta {Emperor.Name} com amarga melancolia. \"Embora meu desejo possa ser em vão, como sempre. De qualquer forma—venha, vamos nos juntar nesta dança negra de derramamento de sangue que estou destinado a executar eternamente.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_493@BUTTON_0"
msgstr "\"Sangue por sangue.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_493@TITLE"
msgstr "Julgamento Sobre o Criador"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_508@BODY_FOOTER"
msgstr "{Huntress.FirstName} estuda você com intenção calculista. \"Então me diga, ainda está considerando minha oferta, ou o quê?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_508@BODY_HEADER"
msgstr "No seu momento de determinação, {Huntress.FirstName} estende a mão para você."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_508@BODY_LORE"
msgstr "<<Cp:Huntress>> olha para você com um sorriso malicioso. \"Tenho observado você. Você está tramando algo, não está?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_508@BUTTON_0"
msgstr "\"Estou, apenas seja paciente.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_508@BUTTON_1"
msgstr "\"Não, eu seguirei meu próprio caminho.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_508@BUTTON_2"
msgstr "\"Você; espionando-me? Isso significa guerra!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_508@TITLE"
msgstr "Conflito Sangrento de Interesses"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_513@BODY_FOOTER"
msgstr "Sim, aqui jaz a Cripta do [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink]. Contudo, de longe, não há entrada óbvia. Melhor inspecioná-la de perto."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_513@BODY_HEADER"
msgstr "Ao seu redor jaz um pântano de sangue, muito, muito mais antigo que qualquer {GLOBAL.ElderVampireLoreConcept.Hyperlink}. O ar fétido está estagnado e denso de podridão."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_513@BODY_LORE"
msgstr "Rios de sangue escorrem pela grande colina, conduzindo a uma profunda depressão na terra. Lá, em um vale nebuloso repleto de cadáveres, você encontra um grande monumento coberto de vegetação da antiguidade. Parece ser—um antigo sepulcro? Ou talvez até uma cripta."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_513@BUTTON_0"
msgstr "Continue sua missão."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_513@TITLE"
msgstr "Um Sepulcro Selado"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_516@BODY_FOOTER"
msgstr "Ofegante de exaustão, uma gargalhada enlouquecida surge da forma trêmula de <<o:Wife>>. \"Muito bem. Lição aprendida: Nunca. Confie. Em. Ninguém. Nunca! Hora de matar. Matar. Matar!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_516@BODY_HEADER"
msgstr "Por um longo instante, {Wife.TitleFirstName} fixa o olhar em você com olhos perplexos e arregalados, a boca <<o:Wife>> escancarada e trêmula."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_516@BODY_LORE"
msgstr "\"Você...\" <<p:Wife>> cospe com a garganta seca. \"Seu mentiroso vil e miserável! Seu rato amaldiçoado, seu! Vou arrancar sua garganta por isso! Vou puxar suas presas e despedaçar você membro por membro, eu... eu...\" O rosto e o corpo de <<Co:Wife>> tremem em um acesso de histeria enquanto <<p:Wife>> joga a cabeça <<o:Wife>> para trás e grita ao céu como uma banshee!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_516@BUTTON_0"
msgstr "\"Hora de matar, de fato.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_516@TITLE"
msgstr "Traidor Ferino Profundo"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_517@BODY_FOOTER"
msgstr "\"N–não importa,\" <<p:Husband>> gagueja com um sorriso vil e cada vez maior. \"É totalmente culpa minha confiar na classe inferior. Esse erro será corrigido em breve, com determinação furiosa!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_517@BODY_HEADER"
msgstr "{Husband.TitleFirstName} olha para você com intenção ardente e furiosa. <<Co:Husband>> narizes se inflamam e vapor sai da pele de <<o:Husband>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_517@BODY_LORE"
msgstr "\"Como pôde fazer isso comigo,\" <<p:Husband>> exige com um tremor rosnante na voz de <<o:Husband>>. \"Para mim? {Husband.TitleName}! Seu camponês insolente! Você não sabe o que fez! Você não...\" <<Cp:Husband>> corrige <<r:Husband>> com um gesto desdenhoso de <<o:Husband>> mãos trêmulas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_517@BUTTON_0"
msgstr "\"Faça o seu pior.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_517@TITLE"
msgstr "Traidor Ardente Incandescente"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_518@BODY_FOOTER"
msgstr "\"Você tornou isso pessoal agora, otário,\" <<p:Huntress>> sorri sombriamente. \"Vou cravar uma estaca com seu nome nela. Venha e pegue!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_518@BODY_HEADER"
msgstr "{Huntress.FirstName} se volta para você com um olhar de surpresa estupefata nas sobrancelhas de <<o:Huntress>>, antes de cuspir uma maldição silenciosa."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_518@BODY_LORE"
msgstr "\"Bem, não posso dizer que estou totalmente surpresa,\" <<p:Huntress>> resmunga. \"Ferido? Claro, um pouco. Mas surpresa? Por ser apunhalado por um vampiro desprezível e miserável? Não, está na sua natureza vil e sugadora de sangue, não é? Abominações miseráveis; todos vocês!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_518@BUTTON_0"
msgstr "\"Sua morte será meu prazer.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_518@TITLE"
msgstr "Cruzado Duplo Sangrento"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_521@BODY_FOOTER"
msgstr "{Wife.TitleFirstName} engasga-se no grito de <<o:Princess>> e então fica assustadoramente silenciosa enquanto {Emperor.Name} domina completamente a mente de <<o:Wife>>. (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_521@BODY_HEADER"
msgstr "\"Muito bem, {Player.FirstName},\" sorri {Emperor.Name} enquanto <<p:Emperor>> inicia um poderoso rito de sangue. \"Você não me deixa escolha senão nivelar nosso campo de batalha iminente.\" (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_521@BODY_LORE"
msgstr "Então, {Wife.TitleFirstName} é invocada, gritando e urrando enquanto ela rasga os cabelos de <<P:Wife>>. \"Não! Não! Não de novo, seu porco miserável! Saia da minha cabeça! Aaaaargh!\"[br/][br/]{Emperor.Name} sangra dos olhos de <<o:Emperor>>, enquanto <<p:Emperor>> rosna bestialmente. \"Silêncio, sua vadia insolente,\" escarnece <<p:Emperor>>. \"Lidarei com sua traição depois. Primeiro, temos um acerto a honrar. Para mim, meu Consorte!\" (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_521@BUTTON_0"
msgstr "\"Assim seja.\" (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_521@BUTTON_2"
msgstr "Tente frustrar o feitiço! (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_521@TITLE"
msgstr "Renovação Atormentada dos Votos (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_532@BODY_FOOTER"
msgstr "{Husband.TitleFirstName} engasga-se nos gaguejos de <<o:Husband>> e então fica assustadoramente silencioso enquanto {Emperor.Name} domina completamente a mente de <<o:Husband>>. (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_532@BODY_HEADER"
msgstr "\"Muito bem, {Player.FirstName},\" sorri {Emperor.Name} enquanto <<p:Emperor>> inicia um poderoso rito de sangue. \"Você não me deixa escolha senão nivelar nosso campo de batalha iminente.\" (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_532@BODY_LORE"
msgstr "Então, {Husband.TitleFirstName} é invocado, gaguejando e resistente enquanto um suor sangrento surge na testa de <<o:Husband>>. \"Misericórdia, meu Sire^m,\" suplica <<p:Husband>>. \"{Wife.FirstName} me fez fazer isso, eu juro! Sempre fui seu fiel Consorte!\"[br/][br/] {Emperor.Name} sangra dos olhos de <<o:Emperor>>, enquanto <<p:Emperor>> rosna bestialmente. \"Silêncio, seu vira‑lata insolente,\" escarnece <<p:Emperor>>. \"Lidarei com sua traição depois. Primeiro, temos um acerto a honrar. Para mim, meu Consorte!\" (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_532@BUTTON_0"
msgstr "\"Assim seja.\" (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_532@BUTTON_2"
msgstr "Tente frustrar o feitiço! (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_532@TITLE"
msgstr "Júbilo Forçoso dos Votos (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_533@BODY_FOOTER"
msgstr "\"Venha, cesse sua luta, minha êxtase,\" oferece {Emperor.Name}. \"Junte-se ao meu lado, onde você realmente pertence! E juntos, desencadearemos um acerto que inspirará terror até mesmo ao {GLOBAL.ArchonsLoreConcept.Hyperlink}!\" (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_533@BODY_HEADER"
msgstr "{Emperor.Name} aparece diante de você, os olhos de <<o:Emperor>> cintilam como uma galáxia enquanto <<p:Emperor>> lhe dirige uma fala delicada. (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_533@BODY_LORE"
msgstr "\"{Player.FirstName}, admiro seu espírito de combate,\" coaxa <<p:Emperor>>. \"De fato. Você é etereamente magnífico ao agraciar a terra com seu grandioso e impecável senso de propósito. O próprio solo sob seus pés é totalmente indigno de sua presença, e isso me enche de orgulho arrebatador e elevado ao saber que você é minha progênie. Minha criação suprema, perfeição feita carne.\" (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_533@BUTTON_0"
msgstr "\"Não significa não!\" (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_533@BUTTON_1"
msgstr "Aceite a oferta e junte‑se ao Deus Imortal afinal. (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_533@TITLE"
msgstr "Encantos do Deus Imortal (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_547@BODY_FOOTER"
msgstr "Com um sobressalto, uma realização surge... Era isso, {Emperor.Name}? Será que <<Cp:Emperor>> realmente acabou de estender a mão para você?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_547@BODY_HEADER"
msgstr "De repente, uma brisa curiosa e fria roça seus sentidos. Ela traz um murmúrio sinistro, um sussurro do além..."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_547@BODY_LORE"
msgstr "Aprimorando seus sentidos vampíricos, você percebe que o suspiro fantasmagórico contém palavras audíveis. \"Meu... Libertador...\" diz ele. \"Venha... Venha até mim. Deslacere... Deslacere a Cripta...\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_547@BUTTON_0"
msgstr "\"Ainda vou encontrá‑lo!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_547@TITLE"
msgstr "Sussurros da Cripta"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_619@TITLE"
msgstr "Sangue dos Consortes"

msgid "DLC@THRONESOFBLOOD@STORY_REALMS@NAME"
msgstr "Sangue e Corte"

msgid "DLC@THRONESOFBLOOD@STORY_REALM_01@AISTARTINGBONUS@DESCRIPTION@EMPEROR"
msgstr "Governante começa com estruturas adicionais desbloqueadas e heróis extras."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_01@AISTARTINGBONUS@NAME@EMPEROR"
msgstr "Imperador de Bônus Inicial"

msgid "DLC@THRONESOFBLOOD@STORY_REALM_01@ANCIENT_WONDER@CRIMSON_FANE@ALT_STRUCT_DESCR"
msgstr "Este sepulcro, agora há muito evitado e tomado por vegetação, foi erguido há muito tempo tanto para enterrar o [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] quanto para memorializar a criação de toda a espécie vampírica. A lenda conta que um reino de rosas prosperou nesta colina, onde, certo dia, dois amantes se encontraram e acabaram morrendo de sangue. Por meio desta provação profana, surgiu o primeiro Vampiro que, a partir de então, gerou muitos outros."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_01@ANCIENT_WONDER@FANE_CRYPT@ALT_STRUCT_NAME"
msgstr "Cripta do Deus Imortal"

msgid "DLC@THRONESOFBLOOD@STORY_REALM_01@ANCIENT_WONDER@ROSE_PALACE@ALT_STRUCT_DESCR"
msgstr "Incontáveis orgias de sangue foram realizadas dentro das muralhas deste lugar amaldiçoado. E, através do sacrifício de incontáveis almas, um feitiço maligno foi tecido ao seu redor, congelando toda a propriedade no tempo — afastando tanto a ruína quanto os saqueadores. Um labirinto encantado e espinhoso serpenteia ao seu redor, que dizem proteger uma única rosa do verdadeiro amor cultivada no topo da torre mais alta."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_01@ANCIENT_WONDER@ROSE_PALACE@ALT_STRUCT_NAME"
msgstr "Palácio da Rosa do Imperador Sangrento"

msgid "DLC@THRONESOFBLOOD@STORY_REALM_01@DESCRIPTION"
msgstr "Como {GLOBAL.ElderVampireLoreConcept.Hyperlink}, retorne ao reino de origem rued de toda a espécie vampírica. Sabote ou corteje seus dois guardiões {GLOBAL.ArchvampireLoreConcept.Hyperlink} em conflito, enquanto avança para descobrir a mítica Cripta do [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] e provocar a tão esperada Vingança de Sangue."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_01@NAME"
msgstr "Rued Drevanya"

msgid "DLC@THRONESOFBLOOD@STORY_REALM_01@SITE@FANE_CRYPT@ALT_STRUCT_NAME"
msgstr "Altar do Sanguessugador da Revivificação"

msgid "DLC@THRONESOFBLOOD@STORY_REALM_01@SITE@THORNED_HEART@ALT_STRUCT_NAME"
msgstr "Madeira de Rosa Estilhaçada de Endailon"

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@BRIEFING_01@DESCRIPTION"
msgstr "Há eras, num tempo em que as forças do poder elemental vagavam pelo cosmos, um príncipe traiu sua amada e, através desse derramamento de sangue, foi amaldiçoado. Assim surgiu um ser de grande poder e fascínio, nem morto nem vivo, que se alimentava dos vivos e prosperava nas sombras: o primeiro Vampiro."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@BRIEFING_02@DESCRIPTION"
msgstr "Esse Vampiro espalharia sua maldição de poder e danação através de seu letal 'beijo'. Por isso, tornou‑se o Deus Imortal; um flagelo que invadiu e escravizou reinos inteiros. Contudo, nascido da traição, a traição seria sua ruína... Pois a inquietação surgiu de dentro."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@BRIEFING_03@DESCRIPTION"
msgstr "Um amor falso selou o Deus Imortal em uma cripta, e a inquietação que se seguiu o condenou, bem como todo o seu Reino, ao Cofre Mundial chamado Grexolis. Enquanto o primeiro Vampiro foi reduzido a mito e lenda, os Vampiros que restaram foram caçados ou fugiram para as sombras."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@BRIEFING_04@DESCRIPTION"
msgstr "Mas então, após Eras de exílio, o reino do primeiro Vampiro imortal emergiu do esquecimento de Grexolis. Poucos lembravam do cruel Deus Imortal, mas muitos Vampiros conheciam o mito da Vingança de Sangue, quando o Deus Imortal despertaria novamente e a Era dos Vampiros começaria.[br/][br/]Esta é a história do Vampiro que traria essa Vingança de Sangue."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@CHOSE_SIDE_HUNTRESS@CUSTOM_PREDICTION_01"
msgstr "Continue a missão da Caçadora, mas termine a sua própria. (Por enquanto...)"

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@CHOSE_SIDE_HUNTRESS@CUSTOM_PREDICTION_02"
msgstr "Encerra a missão da Caçadora, continue por conta própria."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@DEBRIEFING_01_RECKONING@DESCRIPTION"
msgstr "Assim, pela mão de sua prole, o Deus Imortal foi despertado de seu sono sombrio, e por seu comando real a aristocracia vampírica espalhada foi convocada para a cripta imperial de Drevanya. Lá prestaram homenagem ao Deus Imortal e ao Godir que o libertou."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@DEBRIEFING_01_REGICIDE@DESCRIPTION"
msgstr "Assim, o Deus Imortal foi morto por um de seus próprios descendentes. Essa Vingança de Sangue foi sentida por todos os Vampiros, de longe e de perto, e em seus corações frios e enegrecidos despertou o temor ansioso da anarquia... E a oportunidade."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@DEBRIEFING_02_RECKONING@DESCRIPTION"
msgstr "As lendas da crueldade de Urvatogh fariam novamente os Mundos Interiores estremecer, pois sua longa Vingança de Sangue, jurada há tempos, apenas começara... com seu salvador ao seu lado, destinado a permanecer em sua sombra para sempre."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@DEBRIEFING_02_REGICIDE@CONSORT@DESCRIPTION"
msgstr "Com sua cripta agora deslacrada e vazia, o título, o trono e o Domínio do Imperador Sangrento Eterno pertenceriam ao Godir Vampiro que o banira. Junto a uma nova consorte, esse Godir traria a nova Era dos Vampiros."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@DEBRIEFING_02_REGICIDE@DESCRIPTION"
msgstr "Com sua cripta agora deslacrada e vazia, o título, o trono e o Domínio do Imperador Sangrento Eterno pertenceriam ao Godir que o banira. E foi esse Godir quem traria a nova Era dos Vampiros."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@DEBRIEFING_02_REGICIDE@HUNTRESS@DESCRIPTION"
msgstr "Com sua cripta agora deslacrada e vazia, o título, o trono e o Domínio do Imperador Sangrento Eterno cairiam novamente no esquecimento, enquanto a caçada contra os Vampiros se intensificava... Até mesmo por parte de seus próprios semelhantes."

