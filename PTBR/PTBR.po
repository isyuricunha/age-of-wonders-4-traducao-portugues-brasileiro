msgid "HERO_SKILLS@WARLOCK@TRANSFER_LIFE@DESCRIPTION"
msgstr "A unidade aliada alvo ganha +{TRANSFER_LIFE_HEAL>NumHitpointsToRestore} {GLOBAL.TemporaryHitPointConcept.Hyperlink} e {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}.[br/]A recarga desta habilidade é renovada quando:[bulletlist][bullet/]Unidades invocadas pelo conjurador morrem.[bullet/]Esta unidade mata um inimigo.[/bulletlist]"

msgid "HERO_SKILLS@WARLOCK@TRANSFER_LIFE@NAME"
