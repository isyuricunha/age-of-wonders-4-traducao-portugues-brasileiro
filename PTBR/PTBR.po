msgid "DLC@THRONESOFBLOOD@TOME_BLOOD_RITE@SPI@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{amount} de renda de {GLOBAL.UnitProductionConcept.Hyperlink}.[bullet/]+{amount2} {GLOBAL.UnitProductionConcept.Hyperlink} por {GLOBAL.FarmConcept.Hyperlink} adjacente.[bullet/]Ao vencer uma batalha, ganha {amount3} {GLOBAL.ManaConcept.Hyperlink}.[bullet/]Conta como um {GLOBAL.ConduitConcept.Hyperlink}.[/bulletlist]"

