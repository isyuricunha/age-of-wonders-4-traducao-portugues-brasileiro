msgid "DLC@WAYSOFWAR@TOME_CALAMITY@SKILL3@DESCRIPTION"
msgstr "Alvo {GLOBAL.ProvinceConcept.Hyperlink}:[bulletlist][bullet/]Se contiver um {GLOBAL.ProvinceImprovementConcept.Hyperlink}, torna-se [hyperlink,GLOBAL.PillagingConcept]Saqueada[/hyperlink].[bulletlist][bullet/]Você recebe suas recompensas e perde [reputation2/] {GLOBAL.AlignmentConcept.Hyperlink}.[/bulletlist][bullet/]A província ganha {GLOBAL.AshlandsConcept.Hyperlink}.[bullet/]A província perde {GLOBAL.RiverConcept.Hyperlink}, {GLOBAL.FertilePlainsConcept.Hyperlink}, {GLOBAL.SwampConcept.Hyperlink}, {GLOBAL.SnowConcept.Hyperlink}, {GLOBAL.FrozenWasteConcept.Hyperlink}, {GLOBAL.SandConcept.Hyperlink}, {GLOBAL.CavernFloorConcept.Hyperlink} e {GLOBAL.GloomTerrainConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@WAYSOFWAR@TOME_CALAMITY@SKILL3@NAME"
msgstr "Profanar Terra"

msgid "DLC@WAYSOFWAR@TOME_CALAMITY@SKILL4@DESCRIPTION"
msgstr "[bulletlist][bullet/]No início de cada {GLOBAL.TurnConcept.Hyperlink} durante o cerco, um {GLOBAL.ProvinceImprovementConcept.Hyperlink} aleatório da cidade sitiada é [hyperlink,GLOBAL.PillagingConcept]saqueado[/hyperlink], concedendo recompensas.[bullet/]No início do combate:[bulletlist][bullet/]Todos os defensores recebem uma pilha de {GLOBAL.PROPERTIES.GHOSTFIRE.Hyperlink} por {duration} <<m:{GLOBAL.TurnConcept}>>.[bullet/]{amountUnits} <<m:{GLOBAL.UNITS.ACCURSED_OGRE.Hyperlink}>> aparecem do lado do atacante.[/bulletlist][/bulletlist]"

msgid "DLC@WAYSOFWAR@TOME_CALAMITY@SKILL4@NAME"
