msgstr "Ataques base recebem:[bulletlist][bullet/]+{SEARING_STEEL_HS_EXTRA_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]+{SEARING_STEEL_DAMAGE_MULTIPLIER>ResolvedMultiplier}% de dano contra alvos que são {GLOBAL.PROPERTIES.BURNING.Hyperlink}.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

