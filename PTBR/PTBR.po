msgid "CONCEPT@LIGHTNING_RESISTANCE@NAME"
msgstr "Resistência a Relâmpagos"

msgid "CONCEPT@LINE_OF_SIGHT@DESCRIPTION"
msgstr "A maioria dos ataques à distância precisa de Linha de Visada para atingir um inimigo.[bulletlist][bullet/]Se obstáculos ou outras <<m:{GLOBAL.UnitConcept.Hyperlink}>> estiverem entre o atacante e o alvo, o alvo se torna {GLOBAL.ObscuredConcept.Hyperlink}, reduzindo {GLOBAL.AccuracyConcept.Hyperlink}.[bullet/]Unidades adjacentes ao atacante não fazem com que o alvo se torne {GLOBAL.ObscuredConcept.Hyperlink}.[/bulletlist]"

msgid "CONCEPT@LINE_OF_SIGHT@HYPERLINK"
msgstr "[hyperlink,GLOBAL.LineOfSightConcept]Linha de Visada[/hyperlink]"

msgid "CONCEPT@LINE_OF_SIGHT@NAME"
msgstr "Linha de Visada"

msgid "CONCEPT@LOWMORALE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.LowMoraleConcept]Moral Baixa[/hyperlink]"

msgid "CONCEPT@MAGIC_ABILITY@DESCRIPTION"
msgstr "Uma habilidade que causa dano à distância por meios mágicos."

msgid "CONCEPT@MAGIC_ABILITY@HYPERLINK"
msgstr "[hyperlink,GLOBAL.MagicConcept]Mágica[/hyperlink]"

msgid "CONCEPT@MAGIC_ABILITY@NAME"
msgstr "Mágica"

msgid "CONCEPT@MELEE_ABILITY@DESCRIPTION"
msgstr "Uma habilidade que causa dano em combate corpo a corpo."

msgid "CONCEPT@MELEE_ABILITY@HYPERLINK"
msgstr "[hyperlink,GLOBAL.MeleeConcept]Corpo a Corpo[/hyperlink]"

msgid "CONCEPT@MELEE_ABILITY@NAME"
msgstr "Corpo a Corpo"

msgid "CONCEPT@MORALE@SUBTITLE"
msgstr "{minvalue} para {maxvalue} {GLOBAL.UnitMoraleConcept.Hyperlink}"

msgid "CONCEPT@MOUNT@DESCRIPTION"
msgstr "Montarias podem ser equipadas por <<m:{GLOBAL.PROPERTIES.HERO.Hyperlink}>> no espaço relevante.[br/]Em geral, elas concedem {GLOBAL.PROPERTIES.FAST_MOVEMENT.Hyperlink} e um pequeno aumento em <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[br/]Certas armas poderosas não podem ser usadas enquanto montado.[br/]A montaria com a qual o {GLOBAL.PROPERTIES.HERO.Hyperlink} começa depende de sua raça e de quaisquer traços de forma que a raça possa ter."

msgid "CONCEPT@MOUNT@HYPERLINK"
msgstr "[hyperlink,GLOBAL.HeroMountConcept]Montaria do Herói[/hyperlink]"

msgid "CONCEPT@MOUNT@NAME"
msgstr "Montaria do Herói"

msgid "CONCEPT@MOVEMENT_ABILITY@DESCRIPTION"
msgstr "Uma habilidade que move a unidade que a usa para outro local.[br/][br/]Não pode ser usada por unidades que estão {GLOBAL.PROPERTIES.IMMOBILIZED.Hyperlink}."

msgid "CONCEPT@MOVEMENT_ABILITY@HYPERLINK"
msgstr "[hyperlink,GLOBAL.MovementAbilityConcept]Movimento[/hyperlink]"

msgid "CONCEPT@MOVEMENT_ABILITY@NAME"
msgstr "Habilidade de Movimento"

msgid "CONCEPT@MOVE_POINTS@DESCRIPTION"
msgstr "[bulletlist][bullet/]Pontos de Movimento representam a distância que uma unidade pode se mover em um {GLOBAL.TurnConcept}.[bullet/]No {GLOBAL.WorldMapConcept.Hyperlink}, terreno normal custa {amount1} Pontos de Movimento para atravessar.[bullet/]Às vezes, o custo em Pontos de Movimento de um terreno pode ser reduzido, como ao se mover pelo seu {GLOBAL.DomainConcept.Hyperlink}, mas nunca pode ser reduzido abaixo de {amount2} Pontos de Movimento.[bullet/]Em {GLOBAL.CombatConcept.Hyperlink}, cada hexágono custa {moveCost} Pontos de Movimento.[/bulletlist]"

msgid "CONCEPT@MOVE_POINTS@HYPERLINK"
msgstr "[hyperlink,GLOBAL.MovePointConcept]Ponto de Movimento[/hyperlink]"

msgid "CONCEPT@MOVE_POINTS@NAME"
msgstr "Ponto de Movimento"

msgid "CONCEPT@NEGATIVE_STATUS_EFFECT@DESCRIPTION"
msgstr "Um efeito de status negativo é uma condição temporária que enfraquece uma unidade de alguma forma. Eles são frequentemente aplicados por habilidades de <<{GLOBAL.DebuffSpellConcept.Hyperlink}>> e {GLOBAL.DebuffConcept.Hyperlink}.[br/][br/]Exemplos incluem:[bulletlist][bullet/]{GLOBAL.PROPERTIES.SUNDERED_RESISTANCE.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.POISONED.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.DOMINATED.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.DECAYING.Hyperlink}[/bulletlist][br/][br/]Todas as culturas têm uma habilidade de unidade ou feitiço que pode remover efeitos de status negativos.[br/][br/]Além disso, alguns efeitos de status negativos têm [hyperlink,GLOBAL.OpposingStatusEffectsConcept]contadores[/hyperlink] — por exemplo, {GLOBAL.PROPERTIES.POISONED.Hyperlink} pode ser removido aplicando {GLOBAL.PROPERTIES.REGENERATION.Hyperlink}."

msgid "CONCEPT@NEGATIVE_STATUS_EFFECT@HYPERLINK"
msgstr "[hyperlink,GLOBAL.NegativeStatusEffectConcept]Efeito de Status Negativo[/hyperlink]"

msgid "CONCEPT@NEGATIVE_STATUS_EFFECT@NAME"
msgstr "Efeito de Status Negativo"

msgid "CONCEPT@NEUTRALMORALE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.NeutralMoraleConcept]Moral Neutra[/hyperlink]"

msgid "CONCEPT@NO_REFRESH@DESCRIPTION"
msgstr "Habilidades marcadas com \"Não pode ser recarregada\" não podem ter seus tempos de recarga e status de \"uma vez por batalha\" resetados em batalha por habilidades especiais como {GLOBAL.PROPERTIES.WEAVER.Hyperlink}."

msgid "CONCEPT@NO_REFRESH@HYPERLINK"
msgstr "[hyperlink,GLOBAL.NoRefreshConcept]Não pode ser recarregada[/hyperlink]"

msgid "CONCEPT@NO_REFRESH@NAME"
msgstr "Habilidades Não Recarregáveis"

msgid "CONCEPT@OBSCURED@DESCRIPTION"
msgstr "Quando um alvo está Obscurecido, ele se torna {chance}% mais difícil de acertar com ataques à distância."

msgid "CONCEPT@OBSCURED@HYPERLINK"
msgstr "[hyperlink,GLOBAL.ObscuredConcept]Obscurecido[/hyperlink]"

msgid "CONCEPT@OBSCURED@NAME"
msgstr "Obscurecido"

msgid "CONCEPT@ONE_OF_CONTROL@DESCRIPTION"
msgstr "[bulletlist][bullet/]A Zona de Controle de uma unidade são os três hexágonos à sua frente.[bullet/]A Zona de Controle bloqueia o movimento inimigo e determina onde a unidade pode realizar um {GLOBAL.RetaliationConcept.Hyperlink}.[bullet/]Entrar em {GLOBAL.DefenseModeConcept.Hyperlink} estende a Zona de Controle para todos os hexágonos adjacentes.[/bulletlist]"

msgid "CONCEPT@OPPERTUNITY_ATTACK@DESCRIPTION"
msgstr "Ataques de Oportunidade são um tipo especial de {GLOBAL.RetaliationConcept.Hyperlink} que são acionados quando uma unidade inimiga sai da {GLOBAL.ZoneOfControlConcept.Hyperlink}."

msgid "CONCEPT@OPPERTUNITY_ATTACK@HYPERLINK"
msgstr "[hyperlink,GLOBAL.OpportunityAttackConcept]Ataque de Oportunidade[/hyperlink]"

msgid "CONCEPT@OPPERTUNITY_ATTACK@NAME"
msgstr "Ataque de Oportunidade"

msgid "CONCEPT@PHYSICAL_DAMAGE@DESCRIPTION"
msgstr "Causa [damagePhysical/] de Dano Físico."

msgid "CONCEPT@PHYSICAL_DAMAGE@HYPERLINK"
msgstr "[damagePhysical/][hyperlink,GLOBAL.PhysicalDamageConcept]Dano Físico[/hyperlink]"

msgid "CONCEPT@PHYSICAL_DAMAGE@NAME"
msgstr "Dano Físico"

msgid "CONCEPT@PHYSICAL_RESISTANCE@DESCRIPTION"
msgstr "Proteção Física reduz {GLOBAL.PhysicalDamageConcept.Hyperlink}."

msgid "CONCEPT@PHYSICAL_RESISTANCE@HYPERLINK"
msgstr "[defensephysical/] [hyperlink,GLOBAL.PhysicalResistanceConcept]Proteção Física[/hyperlink]"

msgid "CONCEPT@PHYSICAL_RESISTANCE@NAME"
msgstr "Proteção Física"

msgid "CONCEPT@POSITIVE_STATUS_EFFECT@DESCRIPTION"
msgstr "Um efeito de status positivo é uma condição temporária que fortalece uma unidade de alguma forma. Eles são frequentemente aplicados por habilidades <<m:{GLOBAL.BuffSpellConcept.Hyperlink}>> e {GLOBAL.SupportConcept.Hyperlink}.[br/][br/]Exemplos incluem:[bulletlist][bullet/]{GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.REGENERATION.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.HASTENED.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.STEADFAST.Hyperlink}[/bulletlist][br/][br/]Certas habilidades raras de unidades e feitiços podem remover efeitos de status positivos.[br/][br/]Além disso, alguns efeitos de status positivos têm [hyperlink,GLOBAL.OpposingStatusEffectsConcept]contadores[/hyperlink]—por exemplo, {GLOBAL.PROPERTIES.REGENERATION.Hyperlink} pode ser removido ao aplicar {GLOBAL.PROPERTIES.POISONED.Hyperlink}."

msgid "CONCEPT@POSITIVE_STATUS_EFFECT@HYPERLINK"
msgstr "[hyperlink,GLOBAL.PositiveStatusEffectConcept]Efeito de Status Positivo[/hyperlink]"

msgid "CONCEPT@POSITIVE_STATUS_EFFECT@NAME"
msgstr "Efeito de Status Positivo"

msgid "CONCEPT@RANGE@DESCRIPTION"
msgstr "Alcance refere-se ao número máximo de hexes de distância de uma unidade que uma habilidade pode atingir.[br/]Usar ataques em um alvo no alcance máximo geralmente incorre em uma penalidade de {GLOBAL.AccuracyConcept.Hyperlink}."

msgid "CONCEPT@RANGE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.RangeConcept][range/]Alcance[/hyperlink]"

msgid "CONCEPT@RANGE@NAME"
msgstr "[range/]Alcance"

msgid "CONCEPT@RANGED_ABILITY@DESCRIPTION"
msgstr "Uma habilidade que causa dano à distância com um projétil físico."

msgid "CONCEPT@RANGED_ABILITY@HYPERLINK"
msgstr "[hyperlink,GLOBAL.RangedConcept]À Distância Físico[/hyperlink]"

msgid "CONCEPT@RANGED_ABILITY@NAME"
msgstr "À Distância Físico"

msgid "CONCEPT@RESISTANCE@DESCRIPTION"
msgstr "Resistência reduz danos não {GLOBAL.PhysicalDamageConcept.Hyperlink}."

msgid "CONCEPT@RESISTANCE@HYPERLINK"
msgstr "[resistance/][hyperlink,GLOBAL.ResistanceConcept]Resistência[/hyperlink]"

msgid "CONCEPT@RESISTANCE@NAME"
msgstr "Resistência"

msgid "CONCEPT@RETALIATION@DESCRIPTION"
msgstr "Um Ataque de Retaliação é um ataque desencadeado por ataques ou movimentos de outra [hyperlink,GLOBAL.UnitConcept]unidade[/hyperlink].[bulletlist][bullet/]Unidades corpo a corpo podem retaliar uma vez por {GLOBAL.TurnConcept} (por padrão).[bullet/]Atacar uma unidade inimiga dentro do {GLOBAL.ZoneOfControlConcept.Hyperlink} desencadeia uma Retaliação.[bullet/]Uma unidade inimiga saindo do {GLOBAL.ZoneOfControlConcept.Hyperlink} desencadeia um {GLOBAL.OpportunityAttackConcept.Hyperlink}.[/bulletlist]"

msgid "CONCEPT@RETALIATION@HYPERLINK"
msgstr "[hyperlink,GLOBAL.RetaliationConcept]Ataque de Retaliação[/hyperlink]"

msgid "CONCEPT@RETALIATION@NAME"
msgstr "Ataque de Retaliação"

msgid "CONCEPT@RETREATING@DESCRIPTION"
msgstr "Quando uma {GLOBAL.UnitConcept.Hyperlink}unidade{GLOBAL.CombatConcept.Hyperlink} se move para um Ponto de Retirada durante o [bulletlist]combate[bullet/], ela sairá imediatamente da batalha. [morale/]Unidades amigas próximas perderão moral [bullet/].[movementwalk/]A unidade perderá Pontos de Movimento [bullet/] após a batalha.[bullet/]Recuar sua última unidade fará você perder a batalha.[/bulletlist]Se perder a batalha, a unidade morrerá ou se dispersará e reaparecerá em uma de suas cidades após alguns turnos."

msgid "CONCEPT@RETREATING@HYPERLINK"
msgstr "[hyperlink,GLOBAL.RetreatingConcept]Recuando[/hyperlink]"

msgid "CONCEPT@RETREATING@NAME"
msgstr "Recuar"

msgid "CONCEPT@ROUTING@HYPERLINK"
msgstr "[hyperlink,GLOBAL.RoutingConcept]Rota de Fuga[/hyperlink]"

msgid "CONCEPT@ROUTING@SUBTITLE"
msgstr "{value} {GLOBAL.UnitMoraleConcept.Hyperlink} de Moral"

msgid "CONCEPT@RULER@DESTINY@DESCRIPTION"
msgstr "Cada {GLOBAL.HeroConcept.Hyperlink} tem uma Ambição, que define objetivos para serem concluídos e ganhar {GLOBAL.RenownConcept.Hyperlink}. Cada uma inclui uma ambição Menor, que pode ser repetida quantas vezes quiser, e uma ambição Maior, que só pode ser concluída uma vez."

msgid "CONCEPT@RULER@DESTINY@NAME"
msgstr "Ambição do Governante"

msgid "CONCEPT@SPIRIT_DAMAGE@DESCRIPTION"
msgstr "Causa [damageSpirit/] Dano Espiritual."

msgid "CONCEPT@SPIRIT_DAMAGE@HYPERLINK"
msgstr "[damageSpirit/] [hyperlink,GLOBAL.SpiritDamageConcept]Dano Espiritual[/hyperlink]"

msgid "CONCEPT@SPIRIT_DAMAGE@NAME"
msgstr "Dano Espiritual"

msgid "CONCEPT@SPIRIT_RESISTANCE@DESCRIPTION"
msgstr "Resistência Espiritual reduz {GLOBAL.SpiritDamageConcept.Hyperlink}."

msgid "CONCEPT@SPIRIT_RESISTANCE@HYPERLINK"
msgstr "[defensespirit/] [hyperlink,GLOBAL.SpiritResistanceConcept]Resistência Espiritual[/hyperlink]"

msgid "CONCEPT@SPIRIT_RESISTANCE@NAME"
msgstr "Resistência Espiritual"

msgid "CONCEPT@STATUS_RESISTANCE@DESCRIPTION"
msgstr "Resistência a Efeitos reduz a chance de uma unidade ser afetada por <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>>."

msgid "CONCEPT@STATUS_RESISTANCE@HYPERLINK"
msgstr "[statuseffectresistance/] [hyperlink,GLOBAL.StatusResistanceConcept]Resistência a Efeitos[/hyperlink]"

msgid "CONCEPT@STATUS_RESISTANCE@NAME"
msgstr "Resistência a Efeitos"

msgid "CONCEPT@SUMMON_ABILITY@DESCRIPTION"
msgstr "Uma habilidade que invoca uma unidade durante a batalha."

msgid "CONCEPT@SUMMON_ABILITY@HYPERLINK"
msgstr "[hyperlink,GLOBAL.SummoningAbilityConcept]Invocação[/hyperlink]"

msgid "CONCEPT@SUMMON_ABILITY@NAME"
msgstr "Habilidade de Invocação"

msgid "CONCEPT@SUMMON_LIVE_SHARED"
msgstr "[br/]Esta invocação dura {SUMMON_POSITION_EFFECT>TurnsToLive} <<m:{GLOBAL.TurnConcept}>>."

msgid "CONCEPT@SUPPORT_ABILITY@DESCRIPTION"
msgstr "Uma habilidade que cura ou aplica <<m:{GLOBAL.PositiveStatusEffectConcept.Hyperlink}>> a unidades aliadas."

msgid "CONCEPT@SUPPORT_ABILITY@HYPERLINK"
msgstr "[hyperlink,GLOBAL.SupportConcept]Suporte[/hyperlink]"

msgid "CONCEPT@SUPPORT_ABILITY@NAME"
msgstr "Suporte"

msgid "CONCEPT@TELEPORT_ABILITY@DESCRIPTION"
msgstr "Uma habilidade que move instantaneamente a unidade que a usa para outro local usando magia."

msgid "CONCEPT@TELEPORT_ABILITY@HYPERLINK"
msgstr "[hyperlink,GLOBAL.TeleportAbilityConcept]Teleporte[/hyperlink]"

msgid "CONCEPT@TELEPORT_ABILITY@NAME"
msgstr "Habilidade de Teleporte"

msgid "CONCEPT@TEMPORARY_HITPOINTS@DESCRIPTION"
msgstr "[bulletlist][bullet/]Pontos de Vida Temporários são concedidos a uma {GLOBAL.UnitConcept.Hyperlink} quando ela é curada em {GLOBAL.CombatConcept.Hyperlink}.[bullet/]Quando uma Unidade sofre dano, os Pontos de Vida Temporários são perdidos primeiro.[bullet/]Quando o combate termina, todos os Pontos de Vida Temporários são removidos.[/bulletlist]"

msgid "CONCEPT@TEMPORARY_HITPOINTS@HYPERLINK"
msgstr "[hyperlink,GLOBAL.TemporaryHitPointConcept]{LOC.CONCEPT@TEMPORARY_HITPOINTS@NAME}[/hyperlink]"

msgid "CONCEPT@TEMPORARY_HITPOINTS@NAME"
msgstr "[temphp/] Ponto de Vida Temporário"

msgid "CONCEPT@UNIT_MORALE@DESCRIPTION"
msgstr "{GLOBAL.UnitConcept.Hyperlink}A Moral representa a disposição para a batalha.[br/][bulletlist][bullet/]Moral Alta aumenta {GLOBAL.CriticalHitChanceConcept.Hyperlink}.[bullet/]Moral Baixa aumenta a chance de {GLOBAL.FumbleConcept.Hyperlink} em combate e a chance de Deserção no Mapa Mundial.[bullet/]Moral Muito Baixa aumenta ainda mais a chance de {GLOBAL.FumbleConcept.Hyperlink} e pode levar a {GLOBAL.RoutingConcept.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> em combate e à chance de Deserção no Mapa Mundial.[/bulletlist][br/][br/]Estados de Moral:[bulletlist][bullet/]{GLOBAL.HighMoraleConcept.Hyperlink}[bullet/]{GLOBAL.NeutralMoraleConcept.Hyperlink}[bullet/]{GLOBAL.LowMoraleConcept.Hyperlink}.[bullet/]{GLOBAL.VeryLowMoraleConcept.Hyperlink}[bullet/]{GLOBAL.RoutingConcept.Hyperlink}[/bulletlist]"

msgid "CONCEPT@UNIT_MORALE@HYPERLINK"
msgstr "[happiness/] [hyperlink,GLOBAL.UnitMoraleConcept]Moral[/hyperlink]"

msgid "CONCEPT@UNIT_MORALE@NAME"
msgstr "Moral"

msgid "CONCEPT@UNIT_TIER@DESCRIPTION"
msgstr "{GLOBAL.UnitConcept.Hyperlink} Nível representa sua força relativa em {GLOBAL.CombatConcept.Hyperlink}.[bulletlist][bullet/]Quanto maior o nível, <<m:{GLOBAL.UnitConcept.Hyperlink}>> têm um {GLOBAL.UnitUpkeepConcept.Hyperlink} por turno mais alto.[bullet/]Unidades de Nível 3+ ganham {GLOBAL.StatusResistanceConcept.Hyperlink}, que aumenta em Níveis superiores.[bullet/]Os Níveis de Unidades variam de 1 a 5.[bullet/]<<m:{GLOBAL.HeroConcept.Hyperlink}>> são tratados como Nível 5 para habilidades e magias relevantes.[/bulletlist]"

msgid "CONCEPT@UNIT_TIER@HYPERLINK"
msgstr "[hyperlink,GLOBAL.UnitTierConcept]Nível da Unidade[/hyperlink]"

msgid "CONCEPT@UNIT_TIER@NAME"
msgstr "Nível da Unidade"

msgid "CONCEPT@VERYLOWMORALE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.VeryLowMoraleConcept]Moral Muito Baixa[/hyperlink]"

msgid "CONCEPT@WORLD_MAP_REGENERATION@DESCRIPTION"
msgstr "As unidades recuperam um certo número de <<m:{GLOBAL.HitPointConcept.Hyperlink}>> a cada {GLOBAL.TurnConcept.Hyperlink} quando não estão em combate.[br/][br/]A quantidade de pontos de vida recuperados é maior quando a unidade está no seu {GLOBAL.DomainConcept.Hyperlink} perto de uma de suas <<m:{GLOBAL.CityConcept.Hyperlink}>> ou <<m:{GLOBAL.OutpostConcept.Hyperlink}>>. Estar em domínio inimigo ou no território de um {GLOBAL.InfestationConcept.Hyperlink} reduz a regeneração.[br/][br/]A Regeneração no Mapa Mundial também pode ser aumentada por certas Habilidades de Herói e <<m:{GLOBAL.EmpireSkillConcept.Hyperlink}>>."

msgid "CONCEPT@WORLD_MAP_REGENERATION@HYPERLINK"
msgstr "[hyperlink,GLOBAL.WorldMapRegeneration]Regeneração no Mapa Mundial[/hyperlink]"

msgid "CONCEPT@WORLD_MAP_REGENERATION@NAME"
msgstr "Regeneração no Mapa Mundial"

msgid "CONCEPT@ZONE_OF_CONTROL@HYPERLINK"
msgstr "[hyperlink,GLOBAL.ZoneOfControlConcept]Zona de Controle[/hyperlink]"

msgid "CONCEPT@ZONE_OF_CONTROL@NAME"
msgstr "Zona de Controle"

msgid "CONCEPT@ZONE_OF_CONTROL@SHORT_DESCRIPTION"
msgstr "Dentro da [hyperlink,GLOBAL.ZoneOfControlConcept]Zona de Controle[/hyperlink] de uma unidade inimiga adjacente."

msgid "COREDEFINITIONS_MARKERS_TACTICAL@MARKERS@BLINDING@DESCRIPTION"
msgstr "Unidades sem {GLOBAL.PROPERTIES.SAND_WALK.Hyperlink} ou {GLOBAL.PROPERTIES.SAND_CAMOUFLAGE.Hyperlink} que passam por ou terminam seu turno nesta posição sofrem {GLOBAL.PROPERTIES.BLINDED.Hyperlink} por {turn} {GLOBAL.TurnConcept.Hyperlink}."

msgid "COREDEFINITIONS_MARKERS_TACTICAL@MARKERS@BLINDING@NAME"
msgstr "Cegamento"

msgid "COREDEFINITIONS_MARKERS_TACTICAL@MARKERS@BLOODLIGHT@DESCRIPTION"
msgstr "{GLOBAL.PROPERTIES.UNDEAD.Hyperlink}Unidades nesta posição ganham {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} e {GLOBAL.PROPERTIES.REGENERATION.Hyperlink} no fim do turno delas."

msgid "COREDEFINITIONS_MARKERS_TACTICAL@MARKERS@BLOODLIGHT@NAME"
msgstr "Luz Sangrenta"

msgid "COREDEFINITIONS_OBSTACLES@ARCHON_RUINS@NAME"
msgstr "Ruínas Ancestrais"

msgid "COREDEFINITIONS_OBSTACLES@ARCHON_STATUES@NAME"
msgstr "Estátua Ancestral"

msgid "COREDEFINITIONS_OBSTACLES@ASTRAL_FRACTURE@NAME"
msgstr "Fratura Astral"

msgid "COREDEFINITIONS_OBSTACLES@BANSHEE_PODS@NAME"
msgstr "Ninhos de Banshee"

msgid "COREDEFINITIONS_OBSTACLES@BATTLEMENT@NAME"
msgstr "Muralha"

msgid "COREDEFINITIONS_OBSTACLES@BATTLEMENT_DESTROYED@NAME"
msgstr "Muralhas Destruídas"

msgid "COREDEFINITIONS_OBSTACLES@BEAST_BONES@NAME"
msgstr "Ossos de Fera"

msgid "COREDEFINITIONS_OBSTACLES@BOATS@NAME"
