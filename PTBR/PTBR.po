msgid "TOME_WARDING@PASSIVE@NAME"
msgstr "Adepts da Proteção"

msgid "TOME_WARDING@SKILL1@DESCRIPTION"
msgstr "Alvo unidade amiga:[bulletlist][bullet/]Torna‑se {GLOBAL.PROPERTIES.INVULNERABLE.Hyperlink} por {amount} {GLOBAL.TurnConcept}. [bullet/]Tem seu <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>> removido.[/bulletlist][br/]Não pode ser usado em uma unidade mais de uma vez por batalha."

msgid "TOME_WARDING@SKILL1@NAME"
msgstr "Marca da Invulnerabilidade"

msgid "TOME_WARDING@SKILL2@DESCRIPTION"
msgstr "Concede {GLOBAL.SupportConcept.Hyperlink} habilidades das unidades encantadas:[bulletlist][bullet/]Concede +{amount} {GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink} às unidades afetadas.[/bulletlist]"

msgid "TOME_WARDING@SKILL2@MOD_DESCRIPTION"
msgstr "Alvo ganha {amount} {GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink}."

