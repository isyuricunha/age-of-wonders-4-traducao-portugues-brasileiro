msgid "WILDLIFE_UNITPROPERTIES@BLINDING_GALE@ENHANCED_DESCRIPTION"
msgstr "Vendaval Cegante:[bulletlist][bullet/]Causa um dano adicional de {BLINDING_GALE_ENHANCED_DAMAGE>DAMAGE>Shock}{GLOBAL.LightningDamageConcept.Hyperlink}.[bullet/]Tem uma chance base de {BLINDED_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.BLINDED.Hyperlink}.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@BLINDING_GALE@ENHANCED_NAME"
msgstr "Vendaval Cegante Aprimorado"

msgid "WILDLIFE_UNITPROPERTIES@BLINDING_GALE@MASTER_DESCRIPTION"
msgstr "Vendaval Cegante:[bulletlist][bullet/]Causa um dano adicional de {BLINDING_GALE_MASTER_DAMAGE>DAMAGE>Shock}{GLOBAL.LightningDamageConcept.Hyperlink}.[bullet/]Tem uma chance base de {BLINDED_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.BLINDED.Hyperlink}.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@BLINDING_GALE@MASTER_NAME"
msgstr "Vendaval Cegante Campeão"

msgid "WILDLIFE_UNITPROPERTIES@BLINDING_GALE@NAME"
msgstr "Vendaval Cegante"

msgid "WILDLIFE_UNITPROPERTIES@BLIZZARD_SMASH@NAME"
msgstr "Golpe da Nevasca"

msgid "WILDLIFE_UNITPROPERTIES@BLOOMING_LIFE@DESCRIPTION"
msgstr "Unidades aliadas em um raio de {BLOOMING_LIFE_TARGETER>AREA>Radius} hexágonos:[bulletlist][bullet/]Cura +{BLOOMING_LIFE_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Ganham {GLOBAL.PROPERTIES.REGENERATION.Hyperlink}.[bullet/]Têm seus <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>> removidos.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@BLOOMING_LIFE@DESCRIPTION_2"
msgstr "Unidades amigas em um raio de {BLOOMING_LIFE_TARGETER>AREA>Radius} hexes:[bulletlist][bullet/]Recuperam +{BLOOMING_LIFE_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Ganham {regenAmount} {GLOBAL.PROPERTIES.REGENERATION.Hyperlink}.[bullet/]Têm seus <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>> removidos.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@BLOOMING_LIFE@DESCRIPTION_CHAMPION"
msgstr "Vida Florescente:[bulletlist][bullet/]Concede um adicional de {regenAmount} {GLOBAL.PROPERTIES.REGENERATION.Hyperlink}.[bullet/]Recarga reduzida em {cooldown}{GLOBAL.TurnConcept.Hyperlink}.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@BLOOMING_LIFE@NAME"
msgstr "Vida Florescente"

msgid "WILDLIFE_UNITPROPERTIES@BLOOMING_LIFE@NAME_CHAMPION"
msgstr "Vida Florescente do Campeão"

msgid "WILDLIFE_UNITPROPERTIES@BONE_SHATTERING_HOWL@DESCRIPTION"
msgstr "Unidades inimigas em um raio de {BONE_SHATTERING_HOWL_TARGETER>AREA>Radius} hexes sofrem dano e perdem {BONE_SHATTERING_HOWL_MORALE_CHANGE>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}."

msgid "WILDLIFE_UNITPROPERTIES@BONE_SHATTERING_HOWL@NAME"
msgstr "Uivo Esmagador de Ossos"

msgid "WILDLIFE_UNITPROPERTIES@BREAK_SYMB@DESCRIPTION"
msgstr "Cancela todos os vínculos simbióticos."

msgid "WILDLIFE_UNITPROPERTIES@BREAK_SYMB@NAME"
msgstr "Quebrar Simbiose"

msgid "WILDLIFE_UNITPROPERTIES@BRILLIANT_PHASE@DESCRIPTION"
msgstr "Causa dano e aplica {GLOBAL.PROPERTIES.BLINDED.Hyperlink} a unidades em um raio de {BRILLIANT_PHASE_CIRCLE_TARGETER>AREA>Radius} hexes. A unidade então se teleporta para o hexágono alvo."

msgid "WILDLIFE_UNITPROPERTIES@BRILLIANT_PHASE@NAME"
msgstr "Fase Brilhante"

msgid "WILDLIFE_UNITPROPERTIES@BUDDING_STRENGTH@DESCRIPTION"
msgstr "Unidades amigas em um raio de {BUDDING_STRENGTH_TARGETER>AREA>Radius} hexes ganham:[bulletlist][bullet/]{amount} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.TRUE_STRIKE.Hyperlink}[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@BUDDING_STRENGTH@DESCRIPTION_2"
msgstr "Unidades aliadas em um raio de {BUDDING_STRENGTH_TARGETER>AREA>Radius} hexágonos ganham:[bulletlist][bullet/]{amount} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.TRUE_STRIKE.Hyperlink}[bullet/]{randomAmount} <<m:{GLOBAL.PositiveStatusEffectConcept.Hyperlink}>> aleatório[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@BUDDING_STRENGTH@DESCRIPTION_CHAMPION"
msgstr "Força Brotante:[bulletlist][bullet/]Concede um {amount} adicional aleatório de <<m:{GLOBAL.PositiveStatusEffectConcept.Hyperlink}>>.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@BUDDING_STRENGTH@NAME"
msgstr "Força Brotante"

msgid "WILDLIFE_UNITPROPERTIES@BUDDING_STRENGTH@NAME_CHAMPION"
msgstr "Força Brotante Campeã"

msgid "WILDLIFE_UNITPROPERTIES@BURNING@NAME"
msgstr "Queimando"

msgid "WILDLIFE_UNITPROPERTIES@BURNING@PROP"
msgstr "Inflige {GLOBAL.PROPERTIES.BURNING.Hyperlink}."

msgid "WILDLIFE_UNITPROPERTIES@BUTCHERS_CUT@DESCRIPTION"
msgstr "Causa dano à unidade alvo. Com base na vida faltante, o alvo tem uma chance aumentada de:[bulletlist][bullet/]Ganhar {amount} {GLOBAL.PROPERTIES.BLEEDING.Hyperlink} por {BLEEDING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Ganhar {amount} {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink} por {SUNDERED_DEFENSE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Em caso de sucesso, o ogro se cura em {BUTCHERS_CUT_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@BUTCHERS_CUT@NAME"
msgstr "Golpe Sangrento"

msgid "WILDLIFE_UNITPROPERTIES@BUTCHERS_CUT@RES_OVERRIDE"
msgstr "[bulletlist][bullet/]{amount}x Sangramento[bullet/]{amount}x Defesa Despedaçada[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@CAPTIVE_GLAMOUR@DESCRIPTION"
msgstr "[bulletlist][bullet/]A unidade alvo danificada tem chance de se tornar {GLOBAL.PROPERTIES.DOMINATED.Hyperlink} até o fim do combate.[bullet/]A chance aumenta conforme a vida faltante do alvo.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@CAPTIVE_GLAMOUR@NAME"
msgstr "Encanto Cativo"

msgid "WILDLIFE_UNITPROPERTIES@CARRION_FEED@DESCRIPTION"
msgstr "Consome o cadáver do alvo e cura +{CARRION_FEED_DESTROY_CORPSE>HealCasterAmount} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>."

msgid "WILDLIFE_UNITPROPERTIES@CARRION_FEED@NAME"
msgstr "Alimentação de Carniça"

msgid "WILDLIFE_UNITPROPERTIES@CAUSTIC_ERUPTION@DESCRIPTION"
msgstr "Causa dano a unidades inimigas em um raio de {CAUSTIC_ERUPTION_TARGETER>AREA>Radius} hexes."

msgid "WILDLIFE_UNITPROPERTIES@CAUSTIC_ERUPTION@NAME"
msgstr "Erupção Cáustica"

msgid "WILDLIFE_UNITPROPERTIES@CHAIN_LIGHTNING@DESCRIPTION"
msgstr "Causa dano à unidade alvo e a até {CHAIN_LIGHTNING_JUMP_TARGETER>MaxDistance} outras unidades em {CHAIN_LIGHTNING_JUMP_TARGETER>MaxJumps} hexes."

msgid "WILDLIFE_UNITPROPERTIES@CHAIN_LIGHTNING@NAME"
msgstr "Raio Encadeado"

msgid "WILDLIFE_UNITPROPERTIES@CLEANSING_TOUCH@DESCRIPTION"
msgstr "Target unit:[bulletlist][bullet/]Heals {CLEANSING_TOUCH_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Removes {GENERAL_DISPEL_NEGATIVE>NumThingsToDispel} Negative Status Effects.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@CLEANSING_TOUCH@NAME"
msgstr "Cleansing Touch"

msgid "WILDLIFE_UNITPROPERTIES@CONDEMNING_BLAST@NAME"
msgstr "Explosão Condenatória"

msgid "WILDLIFE_UNITPROPERTIES@COSMIC_BARRAGE@DESCRIPTION"
msgstr "Causa dano em um raio de {COSMIC_BARRAGE_TARGETER>AREA>Radius} hexágonos."

msgid "WILDLIFE_UNITPROPERTIES@COSMIC_BARRAGE@NAME"
msgstr "Barragem Cósmica"

msgid "WILDLIFE_UNITPROPERTIES@COSMIC_SPARK@DESCRIPTION"
msgstr "Causa {COSMIC_SPARK_EXTRA_DAMAGE>DAMAGE>Shock} {GLOBAL.LightningDamageConcept.Hyperlink}, {COSMIC_SPARK_EXTRA_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} ou {COSMIC_SPARK_EXTRA_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink} aleatoriamente."

msgid "WILDLIFE_UNITPROPERTIES@COSMIC_SPARK@NAME"
msgstr "Faísca Cósmica"

msgid "WILDLIFE_UNITPROPERTIES@CRUEL_CHARGE@NAME"
msgstr "Carga Cruel em Corpo a Corpo"

msgid "WILDLIFE_UNITPROPERTIES@CRUSHING_ANGUISH@DESCRIPTION"
msgstr "Unidade alvo com {GLOBAL.UnitMoraleConcept.Hyperlink} de \"Baixo\" ou pior:[bulletlist][bullet/]Tem chance de morrer instantaneamente.[bullet/]Quanto menor a moral da unidade alvo, maior essa chance.[bullet/]Se a unidade não morrer, sofre {CRUSHING_ANGUISH_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink} em vez disso.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@CRUSHING_ANGUISH@NAME"
msgstr "Angústia Esmagadora"

msgid "WILDLIFE_UNITPROPERTIES@DEFLECTION@NAME"
msgstr "Deflexão"

msgid "WILDLIFE_UNITPROPERTIES@DEFLECTIONRIER@DESCRIPTION"
msgstr "A unidade tem +{DEFLECTION>ResolvedAccuracyModifier}% de {GLOBAL.EvasionConcept.Hyperlink}."

msgid "WILDLIFE_UNITPROPERTIES@DEVOUR_MIND@DESCRIPTION"
msgstr "A unidade inimiga alvo tem uma chance base de {DEVOUR_MIND_RESISTANCE_CHECK>ResolvedStrength}% de:[bulletlist][bullet/]Ganhar {GLOBAL.PROPERTIES.INSANITY.Hyperlink} por {INSANITY_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bulletlist][bullet/]Se bem-sucedido, o atacante ganha uma pilha de {GLOBAL.PROPERTIES.DEVOUR_MIND_STAT_UP.Hyperlink} até o fim da batalha.[bullet/]Se falhar, o alvo sofre:[bulletlist][bullet/]{DEVOUR_MIND_DAMAGE>DAMAGE>Shock} {GLOBAL.LightningDamageConcept.Hyperlink}[bullet/]{DEVOUR_MIND_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}[bullet/]{DEVOUR_MIND_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[/bulletlist][/bulletlist][/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@DEVOUR_MIND@NAME"
msgstr "Devorar Mente"

msgid "WILDLIFE_UNITPROPERTIES@DEVOUR_MIND@PROP_DESCRIPTION"
msgstr "[bulletlist][bullet/]+{DEVOUR_MIND_STAT_UP>BONUS>HitPoints} de <<m:{GLOBAL.HitPointConcept.Hyperlink}>> máximo[bullet/]+{DEVOUR_MIND_STAT_UP>BONUS>DEFENSE>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}.[bullet/]Acumula até {amount} vezes.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@DEVOUR_MIND@PROP_NAME"
msgstr "Mente Absorvida"

msgid "WILDLIFE_UNITPROPERTIES@DISTRACTING_AURA@DESCRIPTION"
msgstr "No início do turno, inflige {GLOBAL.PROPERTIES.DISTRACTED.Hyperlink} a unidades inimigas adjacentes por {DISTRACTED_EFFECT_DESCRIPTION>NumTurns} {GLOBAL.TurnConcept}."

msgid "WILDLIFE_UNITPROPERTIES@DISTRACTING_AURA@NAME"
msgstr "Aura de Distração"

msgid "WILDLIFE_UNITPROPERTIES@DRACONIC_RAGE@DESCRIPTION"
msgstr "Quando o total de <<m:{GLOBAL.HitPointConcept.Hyperlink}>> desta unidade atingir {DRACONIC_RAGE>ResolvedTriggerProportion}% ou menos, ela causa +{DRACONIC_RAGE_ABILITY_MODIFIER_DAMAGE>ResolvedMultiplier}% de dano."

msgid "WILDLIFE_UNITPROPERTIES@DRACONIC_RAGE@NAME"
msgstr "Fúria Dracônica"

msgid "WILDLIFE_UNITPROPERTIES@DRACONIC_RAGE@PROP_DESCRIPTION"
msgstr "A unidade causa +{DRACONIC_RAGE_ABILITY_MODIFIER_DAMAGE>ResolvedMultiplier}% de dano."

msgid "WILDLIFE_UNITPROPERTIES@DRAGON_BREATH@DESCRIPTION"
msgstr "Causa dano a todas as unidades em um cone de {DRAGON_BREATH_TARGETER>AREA>Length} hexes."

msgid "WILDLIFE_UNITPROPERTIES@DRAIN_ENCHANTMENT@DESCRIPTION"
msgstr "Remove [abilityblue]Encantamento de Unidade[/abilityblue] aleatório ao acertar."

msgid "WILDLIFE_UNITPROPERTIES@DRAIN_ENCHANTMENT@NAME"
msgstr "Drenar Encantamento"

msgid "WILDLIFE_UNITPROPERTIES@DRENCHING_PHASE@DESCRIPTION"
msgstr "Teleporta a unidade para o hex alvo, então causa dano e inflige {GLOBAL.PROPERTIES.WET.Hyperlink} em unidades adjacentes."

msgid "WILDLIFE_UNITPROPERTIES@DRENCHING_PHASE@NAME"
msgstr "Fase Encharcante"

msgid "WILDLIFE_UNITPROPERTIES@DRINK@DESCRIPTION"
msgstr "A unidade ganha:[bulletlist][bullet/]{stacks} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}[bullet/]{stacks2} {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.FRIGID_BELCH.Hyperlink} habilidade.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@DRINK@NAME"
msgstr "Beba!"

msgid "WILDLIFE_UNITPROPERTIES@EARTHEN_FURY@DESCRIPTION"
msgstr " +{damageincrease}% de dano contra unidades {GLOBAL.PROPERTIES.IMMOBILIZED.Hyperlink} e {GLOBAL.PROPERTIES.SLOWED.Hyperlink}."

msgid "WILDLIFE_UNITPROPERTIES@EARTHEN_FURY@NAME"
msgstr "Fúria Terrena"

msgid "WILDLIFE_UNITPROPERTIES@EARTHQUAKE@DESCRIPTION"
msgstr "Unidades inimigas em um raio de {QUAKE_ABILITY_TARGETER>AREA>Radius} hexes sofrem dano. Entra em {GLOBAL.DefenseModeConcept.Hyperlink}."

msgid "WILDLIFE_UNITPROPERTIES@EARTHQUAKE_SMASH@DESCRIPTION"
msgstr "Causa dano à unidade alvo. Unidades inimigas dentro de {EARQUAKE_SMASH_OUTER_TARGETER>AREA>Radius} hexes do alvo sofrem {EARQUAKE_SMASH_OUTER_TARGETER>ResolvedEffectMultiplier}% do dano."

msgid "WILDLIFE_UNITPROPERTIES@EARTHQUAKE_SMASH@NAME"
msgstr "Esmagamento Sísmico"

msgid "WILDLIFE_UNITPROPERTIES@ENFEEBLING_HOWL@DESCRIPTION"
msgstr "Unidades inimigas em um cone de {ENFEEBLING_HOWL_TARGETER>AREA>Length} hexes sofrem dano e ganham {stack} <<m:stack>> de {GLOBAL.PROPERTIES.WEAKENED.Hyperlink}."

msgid "WILDLIFE_UNITPROPERTIES@ENFEEBLING_HOWL@NAME"
msgstr "Uivo Enfraquecedor"

msgid "WILDLIFE_UNITPROPERTIES@ENHANCING_SYMB@DESCRIPTION"
msgstr "Vincular a uma unidade aliada.[br/]Enquanto vinculada, ao final de cada {GLOBAL.TurnConcept}:[bulletlist][bullet/]A unidade aliada ganha {amount} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}.[bullet/]Esta unidade ganha {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink} e {GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink}.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@ENHANCING_SYMB@NAME"
msgstr "Simbiose Aprimoradora"

msgid "WILDLIFE_UNITPROPERTIES@ENHANCING_SYMB@PROP_DESCRIPTION_CASTER"
msgstr "Esta unidade ganha {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink} e {GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink} ao final de cada {GLOBAL.TurnConcept}."

msgid "WILDLIFE_UNITPROPERTIES@ENHANCING_SYMB@PROP_DESCRIPTION_TARGET"
msgstr "Esta unidade ganha {amount} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} no fim de cada {GLOBAL.TurnConcept}."

msgid "WILDLIFE_UNITPROPERTIES@ENTWINE@DESCRIPTION"
msgstr "Unidade inimiga alvo, não {GLOBAL.PROPERTIES.ETHEREAL.Hyperlink}, não {GLOBAL.HeroConcept.Hyperlink}:[bulletlist][bullet/]Sofre dano[bullet/]Tem {ENTWINE_RESISTANCE>ResolvedStrength}% de chance base de ficar {GLOBAL.PROPERTIES.ENTWINED.Hyperlink} por {ENTWINED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@ENTWINE@DESCRIPTION_2"
msgstr "Unidade inimiga alvo não {GLOBAL.PROPERTIES.ETHEREAL.Hyperlink}, não {GLOBAL.HeroConcept.Hyperlink}:[bulletlist][bullet/]Sofre dano.[bullet/]Fica {GLOBAL.PROPERTIES.ENTWINED.Hyperlink} por {ENTWINED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@ENTWINE@DESCRIPTION_3"
msgstr "Unidade inimiga alvo, não {GLOBAL.PROPERTIES.ETHEREAL.Hyperlink}, não {GLOBAL.HeroConcept.Hyperlink}, mais outra dentro de {ENTWINE_MASTER_JUMP_TARGETER>MaxDistance} hexes:[bulletlist][bullet/]Sofre dano[bullet/]Tem {ENTWINE_RESISTANCE>ResolvedStrength}% de chance base de ficar {GLOBAL.PROPERTIES.ENTWINED.Hyperlink} por {ENTWINED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@ENTWINE@ENHANCED_DESCRIPTION"
msgstr "Entrelaçar:[bulletlist][bullet/]Causa um {ENTWINE_ENHANCE_DAMAGE>DAMAGE>Blight} adicional{GLOBAL.BlightDamageConcept.Hyperlink}.[bullet/]Tem garantia de infligir {GLOBAL.PROPERTIES.ENTWINED.Hyperlink}.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@ENTWINE@ENHANCED_NAME"
msgstr "Entrelaçamento Aprimorado"

msgid "WILDLIFE_UNITPROPERTIES@ENTWINE@MASTER_DESCRIPTION"
msgstr "Entrelaçar:[bulletlist][bullet/]Agora afeta outro inimigo em até {ENTWINE_MASTER_JUMP_TARGETER>MaxDistance} hexes.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@ENTWINE@MASTER_NAME"
msgstr "Entrelaçamento do Campeão"

msgid "WILDLIFE_UNITPROPERTIES@ENTWINE@MODIFIER"
msgstr "Base {ENTWINE_RESISTANCE>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.ENTWINED.Hyperlink} for {ENTWINED_EFFECT_DESCRIPTION>NumTurns} {GLOBAL.TurnConcept}."

msgid "WILDLIFE_UNITPROPERTIES@ENTWINE@NAME"
msgstr "Entrelaçado"

msgid "WILDLIFE_UNITPROPERTIES@ENTWINE@PROP_DESCRIPTION"
msgstr "A unidade está {GLOBAL.PROPERTIES.IMMOBILIZED.Hyperlink} e sofre {ENTWINED_DAMAGE_OVER_TIME>ATTACK>Blight} {GLOBAL.BlightDamageConcept.Hyperlink} a cada turno.[br/]Se esta unidade morrer sob este efeito, ela se transforma em um(a) {GLOBAL.UNITS.ENTWINED_THRALL_UNIT.Hyperlink} sob controle inimigo."

msgid "WILDLIFE_UNITPROPERTIES@ENTWINE@PROP_NAME"
msgstr "Entrelaçar"

msgid "WILDLIFE_UNITPROPERTIES@EXPLOSIVE_PHASE@DESCRIPTION"
msgstr "Causa dano e deixa terreno flamejante em um raio de {EXPLOSIVE_PHASE_TARGETER>AREA>Radius} hexes ao redor da unidade. A unidade então se teleporta para o hex alvo."

msgid "WILDLIFE_UNITPROPERTIES@EXPLOSIVE_PHASE@NAME"
msgstr "Fase Explosiva"

msgid "WILDLIFE_UNITPROPERTIES@FIERY_AURA@DESCRIPTION"
msgstr "No início do turno, unidades inimigas adjacentes:[bulletlist][bullet/]Sofrem {FIRE_AURA_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Ficam afligidas com {GLOBAL.PROPERTIES.BURNING.Hyperlink} por {BURNING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@FIERY_AURA@NAME"
msgstr "Aura de Fogo"

msgid "WILDLIFE_UNITPROPERTIES@FIERY_REBIRTH@DESCRIPTION"
msgstr "{FIERY_REBIRTH>TurnsTilRes} <<m:{GLOBAL.TurnConcept}>> após esta unidade morrer, ela:[bulletlist][bullet/]Volta à vida com {FIERY_REBIRTH>ResolvedHealthProportion}% do seu total de <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[bullet/]Causa {FIERY_REBIRTH_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} a unidades inimigas adjacentes.[/bulletlist][br/][br/]Funciona uma vez por batalha."

msgid "WILDLIFE_UNITPROPERTIES@FIERY_REBIRTH@NAME"
msgstr "Renascimento Flamejante"

msgid "WILDLIFE_UNITPROPERTIES@FIRE_BREATH@NAME"
msgstr "Bafo de Fogo"

msgid "WILDLIFE_UNITPROPERTIES@FIRE_GIANT_RESISTANCE@NAME"
msgstr "Fraqueza do Gigante de Fogo"

msgid "WILDLIFE_UNITPROPERTIES@FORBIDDEN_TOME@DESCRIPTION"
msgstr "A unidade ganha um feitiço esquecido, que pode ser usado como uma única ação até o final do turno."

msgid "WILDLIFE_UNITPROPERTIES@FORBIDDEN_TOME@NAME"
msgstr "Tomo Proibido"

msgid "WILDLIFE_UNITPROPERTIES@FREEZING_BURST@DESCRIPTION"
msgstr "Causa dano à unidade alvo."

msgid "WILDLIFE_UNITPROPERTIES@FREEZING_BURST@NAME"
msgstr "Explosão Congelante"

msgid "WILDLIFE_UNITPROPERTIES@FREEZING_PHASE@DESCRIPTION"
msgstr "Teleporta a unidade para o hex alvo e causa dano a unidades inimigas adjacentes."

msgid "WILDLIFE_UNITPROPERTIES@FREEZING_PHASE@NAME"
msgstr "Fase Gélida"

msgid "WILDLIFE_UNITPROPERTIES@FRIGID_BELCH@DESCRIPTION"
msgstr "Um arroto pútrido que causa dano em um cone de {FRIGID_BELCH_TARGETER>AREA>Length} hexes."

msgid "WILDLIFE_UNITPROPERTIES@FRIGID_BELCH@NAME"
msgstr "Eructação Gélida"

msgid "WILDLIFE_UNITPROPERTIES@FRIGID_BELCH@PROP_NAME"
msgstr "Habilidade Adquirida: Arroto Gélido"

msgid "WILDLIFE_UNITPROPERTIES@FROST_AURA@DESCRIPTION"
msgstr "No início do turno, unidades inimigas adjacentes:[bulletlist][bullet/]Sofrem {FROST_AURA_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Têm uma chance base de {SLOWED_RESISTANCE>ResolvedStrength}% de ficarem {GLOBAL.PROPERTIES.SLOWED.Hyperlink} por {SLOWED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@FROST_AURA@NAME"
msgstr "Aura de Gelo"

msgid "WILDLIFE_UNITPROPERTIES@FROST_BREATH@NAME"
msgstr "Sopro Gélido"

msgid "WILDLIFE_UNITPROPERTIES@FROZEN_WEB@DESCRIPTION"
msgstr "Causa dano a unidades inimigas em um cone de {FROZEN_WEBS_TARGETER>AREA>Length} hexes."

msgid "WILDLIFE_UNITPROPERTIES@FROZEN_WEB@NAME"
msgstr "Teia Congelante"

msgid "WILDLIFE_UNITPROPERTIES@GREATER_PHASE@NAME"
msgstr "Fase Maior"

msgid "WILDLIFE_UNITPROPERTIES@HEALING_SAP@DESCRIPTION"
msgstr "Esta unidade e todas as unidades amigas adjacentes recuperam +{HEALING_SAP_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>. Em seguida, esta unidade entra em {GLOBAL.DefenseModeConcept}."

msgid "WILDLIFE_UNITPROPERTIES@HEALING_SAP@NAME"
msgstr "Seiva Curativa"

msgid "WILDLIFE_UNITPROPERTIES@HINDERING_BLIZZARD@DESCRIPTION"
msgstr "Unidades em um raio de {HINDERING_BLIZZARD_TARGETER>AREA>Radius} hexágonos sofrem dano."

msgid "WILDLIFE_UNITPROPERTIES@HINDERING_BLIZZARD@ENHANCED_DESCRIPTION"
msgstr "Nevasca Atrapalhante:[bulletlist][bullet/]Causa um adicional de {HINDERING_BLIZZARD_ENHANCED_DAMAGE>DAMAGE>Frost}{GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Tem garantia de infligir {GLOBAL.PROPERTIES.SLOWED.Hyperlink}.[/bulletlist]"

