msgid "INTERFACE@TEXT@CITY_MORALE_DESCRIPTION"
msgstr "[happiness/] Estabilidade da Cidade representa seu controle geral sobre uma {GLOBAL.CityConcept.Hyperlink}. [br/][bulletlist][bullet/]Alta Estabilidade aumenta a renda de {GLOBAL.FoodConcept.Hyperlink}, {GLOBAL.UnitProductionConcept.Hyperlink} e {GLOBAL.StructureProductionConcept.Hyperlink}. [bullet/]Baixa Estabilidade reduz toda a {GLOBAL.CityIncomeConcept.Hyperlink}. [bullet/]Estabilidade Muito Baixa pode fazer a cidade perder <<m:{GLOBAL.ProvinceConcept.Hyperlink}>>. [/bulletlist][br/]Ela diminui à medida que o {GLOBAL.DomainConcept.Hyperlink} da cidade cresce, e pode ser recuperada construindo certas <<m:{GLOBAL.CityStructureConcept.Hyperlink}>>. [br/][bulletlist][bullet/]{harmonymin} a {harmonymax}: {GLOBAL.CityStabilityHarmony.Hyperlink}. [bullet/]{ordermin} a {ordermax}: {GLOBAL.CityStabilityOrderly.Hyperlink}. [bullet/]{stablemin} a {stablemax}: {GLOBAL.CityStabilityStable.Hyperlink}. [bullet/]{neutralmin} a {neutralmax}: Neutro. [bullet/]{unstablemin} a {unstablemax}: {GLOBAL.CityStabilityUnstable.Hyperlink}. [bullet/]{unrestmin} a {unrestmax}: {GLOBAL.CityStabilityUnrest.Hyperlink}. [bullet/]{riotmin} a {riotmax}: {GLOBAL.CityStabilityRioting.Hyperlink}. [/bulletlist]"

msgid "INTERFACE@TEXT@CITY_MORALE_DESCRIPTION_HARMONY"
msgstr "{harmonyvalue} {GLOBAL.StructureProductionConcept.Hyperlink}, {GLOBAL.UnitProductionConcept.Hyperlink} e {GLOBAL.FoodConcept.Hyperlink} de renda."

msgid "INTERFACE@TEXT@CITY_MORALE_DESCRIPTION_ORDERLY"
msgstr "{ordervalue} {GLOBAL.StructureProductionConcept.Hyperlink}, {GLOBAL.UnitProductionConcept.Hyperlink} e {GLOBAL.FoodConcept.Hyperlink} de renda."

msgid "INTERFACE@TEXT@CITY_MORALE_DESCRIPTION_RIOTING"
