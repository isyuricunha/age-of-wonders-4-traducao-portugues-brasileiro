msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@TRAIT_LAVA_ISLANDS@DESCRIPTION"
msgstr "Este reino está coberto de lava e várias pequenas ilhas, mas contém um vasto subsolo para explorar. [bulletlist][bullet/]Os seguintes <<m:{GLOBAL.ProvinceFeatureConcept.Hyperlink}>> são [abilityblue]Abundantes[/abilityblue]:[bulletlist][bullet/]{GLOBAL.AshlandsConcept.Hyperlink}, {GLOBAL.ChasmConcept.Hyperlink}, e {GLOBAL.LavaConcept.Hyperlink}.[/bulletlist][bullet/]O seguinte Recurso de Província é [abilityblue]Escasso[/abilityblue]:[bulletlist][bullet/]{GLOBAL.SandConcept.Hyperlink}.[/bulletlist][bullet/]Os seguintes Recursos de Província são [abilityblue]Ausentes[/abilityblue]:[bulletlist][bullet/]{GLOBAL.FrozenWasteConcept.Hyperlink}[/bulletlist][/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@TRAIT_LAVA_ISLANDS@NAME"
msgstr "Reino Encharcado de Lava"

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@TRAIT_MISTWALKER_INCURSION@DESCRIPTION"
msgstr "Os Caminhantes da Névoa invadiram este reino, estabelecendo uma presença militar permanente.[bulletlist][bullet/]Acampamento dos Caminhantes da Névoa <<m:{GLOBAL.InfestationConcept.Hyperlink}>> é [abilityblue]Comum[/abilityblue].[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@TRAIT_MISTWALKER_INCURSION@NAME"
