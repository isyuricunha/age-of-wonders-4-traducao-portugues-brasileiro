msgid "INTERFACE@TEXT@CITY_DEFENSE_STRUCTURE"
msgstr "Estrutura de Defesa da Cidade"

msgid "INTERFACE@TEXT@CITY_DEFENSE_STRUCTURE_DESCRIPTION"
msgstr "Estruturas de Defesa de Cidade são <<m:{GLOBAL.CityStructureConcept.Hyperlink}>> que normalmente concedem {GLOBAL.FortificationHealthConcept.Hyperlink} e oferecem benefícios defensivos em {GLOBAL.CombatConcept.Hyperlink} durante um {GLOBAL.SiegeConcept.Hyperlink}.[br/][br/]Existem diferentes tipos de Estruturas de Defesa:[bulletlist][bullet/]<<m:{GLOBAL.CityWallStructureConcept.Hyperlink}>>[bullet/]<<m:{GLOBAL.CityTowerStructureConcept.Hyperlink}>>[bullet/]<<m:{GLOBAL.CitySupportStructureConcept.Hyperlink}>>[bullet/]<<m:{GLOBAL.CityBattlementStructureConcept.Hyperlink}>>[/bulletlist]"

