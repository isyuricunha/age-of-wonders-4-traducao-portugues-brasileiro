msgstr "Servos Mortos-vivos"

msgid "COMBATPROPERTIES_TACTICAL@EXPEDITION_LEADER@DESCRIPTION"
msgstr "O Herói que lidera este exército é o Líder da Expedição. Se o Líder da Expedição fugir ou morrer, mas a batalha for vencida, as forças restantes reviverão o Líder da Expedição após a batalha."

msgid "COMBATPROPERTIES_TACTICAL@EXPEDITION_LEADER@NAME"
msgstr "Líder da Expedição"

msgid "COMBATPROPERTIES_TACTICAL@FIRESTARTER@DESCRIPTION"
msgstr "Várias áreas e obstáculos inflamáveis estão {GLOBAL.OnFireConcept.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@FIRESTARTER@NAME"
msgstr "Fogo Desenfreado"

msgid "COMBATPROPERTIES_TACTICAL@FIRE_IMMUNITY@DESCRIPTION"
