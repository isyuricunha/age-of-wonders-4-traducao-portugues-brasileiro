msgid "DIPLOMATICSTATES_DEFINITIONS@ALLOWCLAIMEDSECTORSFORTURNS@DESCRIPTION"
msgstr "Ambos os Governantes podem construir nas províncias reclamadas um do outro por um período fixo.[br/][br/]Efeitos:[bulletList][bullet/]{RelationValue}[goodRelation/] Relações[bullet/]Governantes podem capturar e construir nas províncias reclamadas sem incorrer em penalidade.[/bulletList]"

msgid "DIPLOMATICSTATES_DEFINITIONS@BREAK_ALLIANCE@AI_DESC"
msgstr "Esta aliança já não me parece favorável. É aqui que nos separamos."

msgid "DIPLOMATICSTATES_DEFINITIONS@BREAK_ALLIANCE@DESCRIPTION"
msgstr "Rompa sua aliança e retorne ao estado de paz."

msgid "DIPLOMATICSTATES_DEFINITIONS@BREAK_ALLIANCE@NAME"
msgstr "Romper Aliança"

msgid "DIPLOMATICSTATES_DEFINITIONS@BREAK_ALLOWCLAIMEDSECTORS@DESCRIPTION"
