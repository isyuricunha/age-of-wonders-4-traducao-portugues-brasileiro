msgid "DLC@EMPIRESANDASHES@STORY_REALM_MISSION_02@VICTORY"
msgstr "Revelou o Endailon do Caos!"

msgid "DLC@EMPIRESANDASHES@STORY_REALM_MISSION_02@VICTORY_TEXT"
msgstr "Você revelou o Endailon do Caos e impediu Edward Portsmith de sucumbir à sua natureza violenta. Vitorioso, você e Laryssa conduzem Edward a Magehaven."

msgid "DLC@EMPIRESANDASHES@STRUCTURE_STRATEGIC@SEAL@DESCRIPTION"
msgstr "Concede +{amount1} ponto ao {GLOBAL.SealsVictoryConcept.Hyperlink} a cada turno para o {GLOBAL.EmpireConcept.Hyperlink} que tem unidades sobre o Selo."

msgid "DLC@EMPIRESANDASHES@STRUCTURE_STRATEGIC@SEAL@LORE"
msgstr "[lorefontsize][lorefont]Selos foram construídos por ordem dos antigos {GLOBAL.ArchonsLoreConcept.Hyperlink}, para proteger o {GLOBAL.WorldsWithinLoreConcept.Hyperlink} das influências do {GLOBAL.AstralSeaLoreConcept.Hyperlink}... ou vice‑versa. Quem ativar essas estruturas poderosas terá controle total sobre quem entrar ou sair do reino. Assim, os Selos foram deixados fortemente guardados. Na maioria dos mundos, essas maquinações arcanas agora jazem inativas e esquecidas... A menos que um poderoso {GLOBAL.GodirLoreConcept.Hyperlink} encontre um modo de ativá‑las novamente.[/lorefont][/lorefontsize]"

msgid "DLC@EMPIRESANDASHES@STRUCTURE_STRATEGIC@SEAL@NAME"
msgstr "[sealsvictory/] Selo"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@PROVINCE_IMPROVEMENT@DESCRIPTION"
