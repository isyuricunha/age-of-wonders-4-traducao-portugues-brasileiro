msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@ICEBOUND_BEHEMOTH@DESCRIPTION"
msgstr "<<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacente a este Marco ganha:[bulletlist][bullet/]{income}.[bullet/] Um [researchpost/] Posto de Pesquisa nesta província concede {income2}.[bullet/]O {combatproperty} {GLOBAL.CombatEnchantmentConcept.Hyperlink}[/bulletlist][br/]Uma {GLOBAL.CityConcept.Hyperlink} com {amount} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacente a este Marco ganha:[bulletlist][bullet/]Ganha {visionbonus} {GLOBAL.VisionRangeConcept.Hyperlink} e {sensingbonus} {GLOBAL.SensorRangeConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@ICEBOUND_BEHEMOTH@LORE"
msgstr "\"Olhar para esses vastos olhos congelados é estar à beira da própria eternidade. Mesmo selados em gelo, eles me perfuram—através da carne, da alma, da própria trama do cosmos. Nós, que reivindicamos domínio do arcano, nada sabemos comparado a este colosso do {GLOBAL.UrwildernessLoreConcept.Hyperlink}. O que somos para tal vidente atemporal e esquecido?\"[br/][br/]— Merlin, o Errante, diários recuperados da Quarta Era"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@ICEBOUND_BEHEMOTH@NAME"
msgstr "Behemoth Congelado"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@ICEBOUND_BEHEMOTH@NAME_OVERRIDE_01"
msgstr "Urwilder Congelado"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@ICEBOUND_BEHEMOTH@NAME_OVERRIDE_02"
msgstr "Olhar Véu de Gelo"

