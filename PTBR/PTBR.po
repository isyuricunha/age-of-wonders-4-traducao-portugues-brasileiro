msgid "DLC@EMPIRESANDASHES@STORY_REALM_MISSION_02@REALM_TRAIT_OASIS@DESCRIPTION"
msgstr "Este reino consiste em um oásis central cercado por desertos.[bulletlist][bullet/]Desertos <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> são [abilityblue]Comuns[/abilityblue].[bullet/]Árticos, Terras Altas e <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> Temperados são [abilityblue]Ausentes[/abilityblue].[bullet/]Florestas <<m:{GLOBAL.ProvinceFeatureConcept.Hyperlink}>> e Pântanos <<m:{GLOBAL.ProvinceFeatureConcept.Hyperlink}>> são [abilityblue]Raros[/abilityblue].[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@STORY_REALM_MISSION_02@REALM_TRAIT_OASIS@NAME"
msgstr "Oásis"

msgid "DLC@EMPIRESANDASHES@STORY_REALM_MISSION_02@VICTORY"
msgstr "O Endailon do Caos foi revelado!"

msgid "DLC@EMPIRESANDASHES@STORY_REALM_MISSION_02@VICTORY_TEXT"
msgstr "Você revelou o Endailon do Caos e impediu Edward Portsmith de sucumbir à sua natureza violenta. Vitoriosos, você e Laryssa guiam Edward até Refúgio dos Magos."

msgid "DLC@EMPIRESANDASHES@STRUCTURE_STRATEGIC@SEAL@DESCRIPTION"
msgstr "Fornece +{amount1} ponto para o(a) {GLOBAL.SealsVictoryConcept.Hyperlink} a cada turno para o(a) {GLOBAL.EmpireConcept.Hyperlink} que tiver unidades sobre o Selo."

msgid "DLC@EMPIRESANDASHES@STRUCTURE_STRATEGIC@SEAL@LORE"
msgstr "[lorefontsize][lorefont]Os Selos foram construídos por ordem dos antigos {GLOBAL.ArchonsLoreConcept.Hyperlink}, para proteger o(a) {GLOBAL.WorldsWithinLoreConcept.Hyperlink} das influências do(a) {GLOBAL.AstralSeaLoreConcept.Hyperlink}... ou o contrário. Quem ativar essas estruturas poderosas terá controle total sobre quem entra ou sai do reino. Por isso, os Selos foram deixados fortemente guardados. Na maioria dos mundos, essas maquinarias arcanas agora estão dormentes e esquecidas... A menos que um(a) poderoso(a) {GLOBAL.GodirLoreConcept.Hyperlink} encontre uma maneira de ativá-los novamente.[/lorefont][/lorefontsize]"

msgid "DLC@EMPIRESANDASHES@STRUCTURE_STRATEGIC@SEAL@NAME"
msgstr "[sealsvictory/] Selo"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@PROVINCE_IMPROVEMENT@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{baseamount} {GLOBAL.KnowledgeConcept.Hyperlink}.[bullet/]+{bonusamount} {GLOBAL.KnowledgeConcept.Hyperlink} por {GLOBAL.ProvinceImprovementConcept.Hyperlink} único(a) adjacente.[bullet/]Conta como um(a) {GLOBAL.ResearchPostConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@PROVINCE_IMPROVEMENT@NAME"
msgstr "[researchpost/] Laboratório do Alquimista"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL1@ABILITY_DESCRIPTION"
msgstr "Unidade alvo:[bulletlist][bullet/]Ganha {amount} <<m:{GLOBAL.PositiveStatusEffectConcept.Hyperlink}>> aleatório(a).[bullet/]Tem um(a) de seus(suas) <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>> dissipado(a).[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL1@ABILITY_NAME"
msgstr "Distribuir Tônico"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL1@DESCRIPTION"
msgstr "Concede a unidades encantadas:[bulletlist][bullet/]{GLOBAL.PROPERTIES.DISTRIBUTE_TONIC.Hyperlink}, concedendo <<m:{GLOBAL.PositiveStatusEffectConcept.Hyperlink}>> enquanto remove um(a) negativo(a).[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL1@NAME"
msgstr "Tônico Misterioso"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL1@PROP_DESCRIPTION"
msgstr "A unidade tem:[bulletlist][bullet/]A habilidade {GLOBAL.PROPERTIES.DISTRIBUTE_TONIC.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL2@DESCRIPTION"
msgstr "Criar {GLOBAL.AfflictingMiasmaHazard.Hyperlink} em um raio de {hex}."

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL2@NAME"
msgstr "Dispersar Miasma Debilitante"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL3@DESCRIPTION"
msgstr "{GLOBAL.PROPERTIES.RANGED_UNIT.Hyperlink} que pode criar Miasmas para debilitar inimigos."

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL3@NAME"
msgstr "Afligidor^f"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL4@DESCRIPTION"
msgstr "Unidades aliadas em um raio de {ANTIMAGIC_TINCTURE_CIRCLE>AREA>Radius} hex:[bulletlist][bullet/]Ter {ANTIMAGIC_TINCTURE_DISPEL>NumThingsToDispel} <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>> dissipado.[bullet/]Ganhar {amount} {GLOBAL.PROPERTIES.STATUS_PROTECTION.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL4@NAME"
msgstr "Tintura Antimágica"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL5@DESCRIPTION"
msgstr "No início do combate, unidades defendendo a cidade:[bulletlist][bullet/]Sofrer {amount} {GLOBAL.BlightDamageConcept.Hyperlink}.[bullet/]Sofrer {PoisonAmount} {GLOBAL.PROPERTIES.WEAKENED.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL5@NAME"
msgstr "Fumigação"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL6@DESCRIPTION"
msgstr "[bulletlist][bullet/]{KnowledgeBonus}{GLOBAL.KnowledgeConcept.Hyperlink} renda.[bullet/]{GoldBonus}{GLOBAL.GoldConcept.Hyperlink} renda.[bullet/]{KnowledgePerMaterial}{GLOBAL.KnowledgeConcept.Hyperlink} renda por {GLOBAL.MagicMaterialConcept.Hyperlink} nesta {GLOBAL.DomainConcept.Hyperlink} da cidade.[bullet/]{GoldPerMaterial}{GLOBAL.GoldConcept.Hyperlink} renda por {GLOBAL.MagicMaterialConcept.Hyperlink} nesta {GLOBAL.DomainConcept.Hyperlink} da cidade.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL6@NAME"
msgstr "Refinaria de Materiais"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@TACTICALOBSTACLES@AFFLICTING_MIASMA@DESCRIPTION"
msgstr "Unidades que passarem ou terminarem o turno neste hex serão afligidas com {GLOBAL.PROPERTIES.WEAKENED.Hyperlink}.[br/]Unidades neste hex têm {GLOBAL.PROPERTIES.AFFLICTING_MIASMA_STATUS_EFFECT.Hyperlink}."

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@TACTICALOBSTACLES@AFFLICTING_MIASMA@NAME"
msgstr "Miasma Debilitante"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Afligir seus inimigos com <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>> e mitigá-lo em suas próprias unidades. Tinturas e uma unidade de ataque à distância poderosa ajudarão você a manipular os rumos da batalha."

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@TOME@LORE_AUTHOR"
msgstr "Fauster, o Meticuloso"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@TOME@LORE_DESCRIPTION"
msgstr "\"A fórmula alquímica perfeita exige uma medida igual de tempo e sorte. Quem mais, além do alquimista, passa anos em pesquisas meticulosas para entender a própria essência da natureza... Apenas para encontrar a solução por puro acaso! A alquimia é, de fato, uma aposta com a natureza, envolvendo o poder tanto de criar quanto de destruir.\""

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@TOME@NAME"
msgstr "Tomo de Alquimia"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@UNIT_ABILITY_1@DESCRIPTION"
msgstr "Causar dano à unidade alvo e criar {GLOBAL.AfflictingMiasmaHazard.Hyperlink} no hex dela."

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@UNIT_ABILITY_1@NAME"
msgstr "Disparo de Miasma"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@HERO_SKILL1@DESCRIPTION"
msgstr "Enquanto líder do exército, todas as <<m:{GLOBAL.PROPERTIES.CONSTRUCT.Hyperlink}>> têm:[bulletlist][bullet/]+{EXPERIENCED_WARSMITH_DEFENSE>DEF_MOD>Armor} {GLOBAL.DefenseConcept.Hyperlink}[bullet/]Curar +{EXPERIENCED_WARSMITH_REGENERATION>BONUS>Regen} <<m:{GLOBAL.HitPointConcept.Hyperlink}>> por {GLOBAL.WorldMapConcept.Hyperlink} {GLOBAL.TurnConcept.Hyperlink}.[/bulletlist][br/]Iniciar o combate com um {GLOBAL.UNITS.IRON_GOLEM_ASSISTANT_UNIT.Hyperlink}, um {GLOBAL.PROPERTIES.FIGHTER.Hyperlink} de Nível I (não funciona em batalhas aquáticas)."

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@HERO_SKILL1@NAME"
msgstr "Mestre Ferreiro Experiente"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@LINKED_MINDS_DESCRIPTION"
msgstr "Esta unidade recebe {GLOBAL.PROPERTIES.HYPER_AWARE_UNIT_PASSIVE.Hyperlink} quando estiver adjacente a um {GLOBAL.PROPERTIES.CONSTRUCT.Hyperlink} ou unidade com Mentes Ligadas."

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@PROVINCE_IMPROVEMENT@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{baseamount} {GLOBAL.StructureProductionConcept.Hyperlink}.[bullet/]{amount1} {GLOBAL.FoodConcept.Name} por {GLOBAL.FarmConcept.Hyperlink} adjacente.[bullet/]{amount2} {GLOBAL.StructureProductionConcept.Hyperlink} por {GLOBAL.QuarryConcept.Hyperlink} ou {GLOBAL.ForesterConcept.Hyperlink} adjacente.[bullet/]{amount4} {GLOBAL.ManaConcept.Hyperlink} por {GLOBAL.ConduitConcept.Hyperlink} adjacente. [bullet/]{amount5} {GLOBAL.KnowledgeConcept.Hyperlink} por {GLOBAL.ResearchPostConcept.Hyperlink} adjacente.[bullet/]{amount6} {GLOBAL.GoldConcept.Name} por {GLOBAL.MineConcept.Hyperlink} adjacente.[bullet/]Conta como um {GLOBAL.QuarryConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@PROVINCE_IMPROVEMENT@TITLE"
msgstr "[quarry/] Nexo de Construtos Operários"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@SKILL1@DESCRIPTION"
msgstr "Um {GLOBAL.PROPERTIES.POLEARM_UNIT.Hyperlink} capaz de infligir {GLOBAL.PROPERTIES.WEAKENED.Hyperlink}."

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@SKILL1@NAME"
msgstr "Golem de Bronze"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@SKILL2@DESCRIPTION"
msgstr "Unidade {GLOBAL.PROPERTIES.CONSTRUCT.Hyperlink} ou {GLOBAL.PROPERTIES.LINKED_MINDS_PROPERTY_GROUP.Hyperlink} aliada alvo: [bulletlist][bullet/]Recebe {GLOBAL.PROPERTIES.DEFENSIVE_MASTERS.Hyperlink} por {CASCADING_COMMAND_DEFEND_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Tem {CASCADING_COMMAND_DEFEND_EFFECT_DISPEL>NumThingsToDispel} <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>> dissipado.[bullet/]Este efeito então se aplica a unidades aliadas adjacentes do tipo Construto ou com Mentes Ligadas e se repete.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@SKILL2@NAME"
msgstr "Comando em Cascata: Defender"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@SKILL3@DESCRIPTION"
msgstr "Quando adjacente a outra unidade com Defesa Composta, esta unidade recebe:[bulletlist][bullet/]+{COMPOUNDING_DEFENSE_DEFENSE>DEF_MOD>Armor} {GLOBAL.DefenseConcept.Hyperlink}[bullet/]+{COMPOUNDING_DEFENSE_DEFENSE>DEF_MOD>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@SKILL3@NAME"
msgstr "Defesa Composta"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@SKILL4@DESCRIPTION"
msgstr "Unidade {GLOBAL.PROPERTIES.CONSTRUCT.Hyperlink} ou {GLOBAL.PROPERTIES.LINKED_MINDS_PROPERTY_GROUP.Hyperlink} aliada alvo recebe:[bulletlist][bullet/]{GLOBAL.PROPERTIES.HASTENED.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}[bullet/]Este efeito então se propaga para unidades aliadas adjacentes do tipo Construto ou com Mentes Ligadas e se repete.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@SKILL4@NAME"
msgstr "Comando em Cascata: Reposicionar"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@SKILL5@DESCRIPTION"
msgstr "Cidade aliada alvo recebe +{amount} {GLOBAL.FoodConcept.Hyperlink}.[br/]Este feitiço custa Essência Vinculante."

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@SKILL5@NAME"
msgstr "População de Construtos"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@SKILL6@DESCRIPTION"
msgstr "Unidades desta raça ganham a habilidade de compartilhar sentidos, concedendo-lhes:[bulletlist][bullet/]{GLOBAL.PROPERTIES.HYPER_AWARE_UNIT_PASSIVE.Hyperlink} quando estiverem ao lado de um {GLOBAL.PROPERTIES.CONSTRUCT.Hyperlink} ou outra unidade com Mentes Ligadas.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@SKILL6@NAME"
msgstr "Mentes Ligadas"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Comande legiões de construtos, lutando em formações sinistramente sincronizadas, controlando-os perfeitamente e esmagando seus inimigos sob a marcha de suas botas."

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@TOME@LORE_DESCRIPTION"
msgstr "\"Construtos são 'vivos'? Para isso, tenho apenas uma resposta: Isso importa? Construtos são máquinas de guerra obedientes criadas com um único propósito: esmagar tudo em seu caminho. Na minha opinião, a verdadeira pergunta que alguém deveria fazer é: 'Como escapar de sua marcha mortal?'\""

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@TOME@NAME"
msgstr "Tomo do Construto"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@ABILITY1@DESCRIPTION"
msgstr "Dispara o canhão principal no alvo e o empurra para trás."

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@ABILITY1@NAME"
msgstr "Disparo Direto"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@ABILITY2@DESCRIPTION"
msgstr "Causa dano em um raio de {BARRAGE_CIRCLE_TARGETER>AREA>Radius} hexes."

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@ABILITY2@FLAG@DESCRIPTION"
msgstr "Este hex será atingido por {amount} {GLOBAL.PhysicalDamageConcept.Hyperlink} no início do [turn/] [hyperlink,GLOBAL.TurnConcept]Próximo Turno[/hyperlink] do proprietário."

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@ABILITY2@NAME"
msgstr "Barragem"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@ABILITY3@DESCRIPTION"
msgstr "Atinge a unidade inimiga alvo.[bulletlist][bullet/]Recuar[br/]O alvo é recuado em {hex} hex. [bullet/]Move-se para o hex vazio.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@ABILITY3@NAME"
msgstr "Avanço Implacável"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@ABILITY4@DESCRIPTION"
msgstr "Causa dano em um raio de {BOMBARD_CIRCLE_TARGETER>AREA>Radius} hexes."

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@ABILITY4@NAME"
msgstr "Bombardear"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@ABILITY_AMMO_1@DESCRIPTION"
msgstr "Ganha {GLOBAL.PROPERTIES.AMMUNITION_SUNDERING_SHOT_PROPERTY.Hyperlink}"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@ABILITY_AMMO_1@NAME"
msgstr "Carregar Tiro Despedaçador"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@ABILITY_AMMO_2@DESCRIPTION"
msgstr "Ganha {GLOBAL.PROPERTIES.AMMUNITION_INCENDIARY_SHOT_PROPERTY.Hyperlink}"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@ABILITY_AMMO_2@NAME"
msgstr "Carregar Tiro Incendiário"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@ABILITY_AMMO_3@DESCRIPTION"
msgstr "Ganha {GLOBAL.PROPERTIES.AMMUNITION_SHRAPNEL_SHOT_PROPERTY.Hyperlink}"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@ABILITY_AMMO_3@NAME"
msgstr "Carregar Tiro de Metralha"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@AMMUNITION_PROPERTY_TYPE@NAME"
msgstr "Munição"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@HERO_SKILL1@DESCRIPTION"
msgstr "O herói ganha a habilidade {GLOBAL.PROPERTIES.ARTILLERY_BARRAGE.Hyperlink}."

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@HERO_SKILL1@NAME"
msgstr "Artilheiro"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@HERO_SKILL@DESCRIPTION"
msgstr "Alveje um raio de {ARTILLERY_BARRAGE_CIRCLE_TARGETER_MARKED>AREA>Radius} hexes.[bulletlist][bullet/]Inflige {GLOBAL.PROPERTIES.MARKED.Hyperlink}.[bullet/]No início do próximo turno, inflige {amount} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@HERO_SKILL@NAME"
msgstr "Barragem de Artilharia"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@MODIFIER_AMMO_2@TARGETER_DESCRIPTION"
msgstr "Hexes aleatórios na Área alvo ganham {GLOBAL.OnFireConcept.Hyperlink}."

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@OVERCHARGED@DESCRIPTION"
msgstr "Esta unidade possui:[bulletlist][bullet/]+{DamageBonus}% de dano nos ataques.[bullet/]Uma chance de {Stunchance}% de sofrer {GLOBAL.PROPERTIES.STUNNED.Hyperlink} por {duration} <<m:{GLOBAL.TurnConcept}>> após concluir uma ação de ataque.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@OVERCHARGED@MODIFIER_DESCRIPTION"
msgstr "[bulletlist][bullet/]+{DamageBonus}% de dano.[bullet/]{Stunchance}% de chance de esta unidade sofrer {GLOBAL.PROPERTIES.STUNNED.Hyperlink} por {duration} <<m:{GLOBAL.TurnConcept}>> após concluir este ataque.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@OVERCHARGED@NAME"
msgstr "Sobrecarregado"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@OVERCHARGE_ABILITY@DESCRIPTION"
msgstr "Unidade aliada alvo:[bulletlist][bullet/]Ganha {GLOBAL.PROPERTIES.OVERCHARGED.Hyperlink} até o fim do combate.[bullet/]Cura {HS_ARTIFICERS_KIT_HEAL>NumHitpointsToRestore} {GLOBAL.TemporaryHitPointConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@OVERCHARGE_ABILITY@DESCRIPTION_CONSTRUCT"
msgstr "Unidade aliada {GLOBAL.PROPERTIES.CONSTRUCT.Hyperlink} alvo:[bulletlist][bullet/]Ganha {GLOBAL.PROPERTIES.OVERCHARGED.Hyperlink} até o fim do combate.[bullet/]Cura {HS_ARTIFICERS_KIT_HEAL>NumHitpointsToRestore} {GLOBAL.TemporaryHitPointConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@OVERCHARGE_ABILITY@NAME"
msgstr "Sobrecarga"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@PROPERTY_AMMO_1@DESCRIPTION"
msgstr "Próximo ataque:[bulletlist][bullet/]Inflige {sunderingcount} {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink}.[bullet/]Ignora {PIERCING>MODIFIERS>ResolvedArmor}% da {GLOBAL.DefenseConcept.Hyperlink} do alvo.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@PROPERTY_AMMO_1@NAME"
msgstr "Munição: Tiro Despedaçador"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@PROPERTY_AMMO_2@DESCRIPTION"
msgstr "Próximo ataque:[bulletlist][bullet/]Inflige {DamageBonus} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Hexágonos aleatórios na Área alvo ganham {GLOBAL.OnFireConcept.Hyperlink}[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@PROPERTY_AMMO_2@NAME"
msgstr "Munição: Tiro Incendiário"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@PROPERTY_AMMO_2@TARGETERS_DESCRIPTION"
msgstr "Hexágonos aleatórios na área alvo ou próxima ganham {GLOBAL.OnFireConcept.Hyperlink}"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@PROPERTY_AMMO_3@DESCRIPTION"
msgstr "Próximo ataque:[bulletlist][bullet/]Inflige {Bleedcount} {GLOBAL.PROPERTIES.BLEEDING.Hyperlink}[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@PROPERTY_AMMO_3@NAME"
msgstr "Munição: Tiro de Metralha"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@PROVINCE_IMPROVEMENT@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{baseamount} {GLOBAL.UnitProductionConcept.Hyperlink}.[bullet/]+{bonusamount} {GLOBAL.UnitProductionConcept.Hyperlink} por {GLOBAL.QuarryConcept.Hyperlink} ou {GLOBAL.MineConcept.Hyperlink} {GLOBAL.ProvinceConcept.Hyperlink} adjacente.[bullet/]{GLOBAL.PROPERTIES.CONSTRUCT.Hyperlink} Unidades produzidas na cidade proprietária ganham +{rankamount}[medalGold/] Níveis.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@PROVINCE_IMPROVEMENT@NAME"
msgstr "[quarry/] Fundição de Guerra"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL1@DESCRIPTION"
msgstr "Um {GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink} blindado com um poderoso canhão de três canos capaz de carregar e disparar projéteis especializados a uma distância significativa."

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL1@NAME"
msgstr "Encouraçado^n"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL2@DESCRIPTION"
msgstr "Unidades em um raio de {PINNING_BARRAGE_UNIT_TARGETER_CIRCLE>AREA>Radius} hexágonos:[bulletlist][bullet/]Sofrem {PINNING_BARRAGE_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Ficam {GLOBAL.PROPERTIES.MARKED.Hyperlink}.[bullet/]Têm uma chance base de {IMMOBILIZED_RESISTANCE>ResolvedStrength}% de ficarem {GLOBAL.PROPERTIES.IMMOBILIZED.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL2@NAME"
msgstr "Barragem Fixa"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL3@DESCRIPTION"
msgstr "Concede a unidades encantadas:[bulletlist][bullet/]A habilidade {GLOBAL.PROPERTIES.OVERCHARGE_ABILITY.Hyperlink}, que pode conceder a uma unidade {GLOBAL.PROPERTIES.CONSTRUCT.Hyperlink} {GLOBAL.PROPERTIES.OVERCHARGED.Hyperlink} até o fim da batalha.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL3@NAME"
msgstr "Kits de Ajuste"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL3@PROP_DESCRIPTION"
msgstr "A unidade tem:[bulletlist][bullet/]a habilidade {GLOBAL.PROPERTIES.OVERCHARGE_ABILITY.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL4@DESCRIPTION"
msgstr "No início da batalha, ganhe {GLOBAL.UNITS.GREAT_BOMBARD_UNIT.Hyperlink} no lado do atacante até o fim da batalha. [bulletlist][bullet/]Grande Bombard é uma {GLOBAL.PROPERTIES.SIEGECRAFT_UNIT.Hyperlink} imóvel {GLOBAL.UnitConcept.Hyperlink}.[bullet/] Apenas um tipo de unidade de Cerco pode ser levado para {GLOBAL.CombatConcept.Hyperlink}. Se múltiplas <<m:{GLOBAL.SiegeProjectConcept.Hyperlink}>> trouxerem-nas, apenas a mais forte aparecerá.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL4@NAME"
msgstr "Construir Grande Bombard"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL5@DESCRIPTION"
msgstr "Concede a unidades encantadas:[bulletlist][bullet/]{GLOBAL.PROPERTIES.WARDED.Hyperlink} aumentando sua {GLOBAL.ResistanceConcept.Hyperlink} contra ataques mágicos.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL5@NAME"
msgstr "Metais Protetores"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL5@PROP_DESCRIPTION"
msgstr "A unidade tem:[bulletlist][bullet/]{GLOBAL.PROPERTIES.WARDED.Hyperlink}[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL6@DESCRIPTION"
msgstr "Unidades em um raio de {DESTABILIZED_MANA_CORE_CIRCLE_TARGETER_MARKED>AREA>Radius} hexes estão {GLOBAL.PROPERTIES.MARKED.Hyperlink}. Após {time} {GLOBAL.TurnConcept.Hyperlink}, o Núcleo de Mana explode, causando:[bulletlist][bullet/]{amount} {GLOBAL.PhysicalDamageConcept.Hyperlink}[bullet/]{amount2} {GLOBAL.LightningDamageConcept.Hyperlink}.[bullet/]{amount3}% de chance base de receber {GLOBAL.PROPERTIES.DISRUPTION_TOOLTIP_PROPERTY.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL6@FLAG@DESCRIPTION"
msgstr "Este hex será atingido por {amount} {GLOBAL.PhysicalDamageConcept.Hyperlink} e {amount} {GLOBAL.LightningDamageConcept.Hyperlink} no início do [turn/] [hyperlink,GLOBAL.TurnConcept] do proprietário.Próximo Turno[/hyperlink]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL6@NAME"
msgstr "Núcleo de Mana Desestabilizado"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Invoque o poder de máquinas poderosas e aniquile seus inimigos com poderosas barragens."

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@TOME@LORE_AUTHOR"
msgstr "Edward Portsmith, Último Dreadnought da Comunidade"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@TOME@LORE_DESCRIPTION"
msgstr "\"As tecnologias Dreadnought são inigualáveis no campo de batalha. Imagine uma fusão de aço e habilidade, dominando tudo em seu caminho. Explosões despedaçam a terra e chovem fogo sobre seus inimigos. Uma visão impressionante. De fato, quando um Couraçado de Ferro entra em batalha, o combate já está decidido.\""

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@TOME@NAME"
msgstr "Tomo do Dreadnought"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@UNIT2@NAME"
msgstr "Grande Bombard"

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@ABILITY02@DESCRIPTION"
msgstr "Até {MAGICAL_DISRUPTION_COMBAT_UNIT_AUTO_SPELL>MinCastCount} inimigos aleatórios:[bulletlist][bullet/]Sustentar {MAGICAL_DISRUPTION_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Têm {DISRUPTION_RESISTANCE>ResolvedStrength}% de chance base de se tornarem {GLOBAL.PROPERTIES.DISRUPTION_TOOLTIP_PROPERTY.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@ABILITY02@NAME"
msgstr "Interrupção Mágica"

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@ABILITY03@DESCRIPTION"
msgstr "[bulletlist][bullet/]Cada unidade aliada em um raio de {DISPELLING_FIELD_TARGETER>AREA>Radius} hexes tem um de seus <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>> dissipado.[bullet/]Para cada unidade que teve um status dissipado dessa forma, esta unidade ganha:[bulletlist][bullet/]{GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} por {STRENGTHENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]{GLOBAL.PROPERTIES.STATUS_PROTECTION.Hyperlink} por {STATUS_PROTECTION_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@ABILITY03@NAME"
msgstr "Campo Dissipador"

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@HERO_SKILL@DESCRIPTION"
msgstr "Ataques físicos corpo a corpo e à distância têm {DISRUPTION_RESISTANCE>ResolvedStrength}% de chance de infligir {GLOBAL.PROPERTIES.DISRUPTION_TOOLTIP_PROPERTY.Hyperlink}."

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@HERO_SKILL@NAME"
msgstr "Mestre da Interrupção"

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@SKILL1@DESCRIPTION"
msgstr "Alvo {GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink} {GLOBAL.UnitConcept.Hyperlink}: [bulletlist][bullet/]Tem uma chance base de {ASTRAL_SEVERANCE_RESISTANCE_CHECK>ResolvedStrength}% de ser morto.[bullet/]Se não for bem-sucedido, inflige {GLOBAL.PROPERTIES.DISRUPTION_TOOLTIP_PROPERTY.Hyperlink} e {amount} acúmulos de {GLOBAL.PROPERTIES.DECAYING.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@SKILL1@NAME"
msgstr "Separação Astral"

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@SKILL2@COMBAT_PROPERTY_DESCRIPTION"
msgstr "Inimigo <<m:{GLOBAL.SpellConcept.Hyperlink}>> custa +{amount1}% <<m:{GLOBAL.CombatCastingPointConcept.Hyperlink}>> em {GLOBAL.CombatConcept.Hyperlink} em <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacente a uma estrutura Escudomágico."

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@SKILL2@DESCRIPTION"
msgstr "Conjura um Escudomágico em um hexágono vazio no alvo {GLOBAL.ProvinceConcept.Hyperlink}. Essa estrutura:[bulletlist][bullet/]Funciona como um {GLOBAL.SpellJammerConcept.Hyperlink} para esta e províncias adjacentes.[bullet/]Fornece visão em um raio de {hex} hexágonos.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@SKILL2@NAME"
msgstr "Conjurar Escudomágico"

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@SKILL2@OPERATION_DESCRIPTION"
msgstr "Destruir o Escudomágico."

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@SKILL2@OPERATION_NAME"
msgstr "Destruir Escudomágico"

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@SKILL2@STRUCTURE_DESCRIPTION"
msgstr "[bulletlist][bullet/]Inimigos não podem mirar <<m:{GLOBAL.WorldMapSpellConcept.Hyperlink}>> nesta e em <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacentes.[bullet/]Inimigo <<m:{GLOBAL.SpellConcept.Hyperlink}>> custa +{amount1}% <<m:{GLOBAL.CombatCastingPointConcept.Hyperlink}>> em {GLOBAL.CombatConcept.Hyperlink} nesta e em <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacentes.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@SKILL2@STRUCTURE_NAME"
msgstr "Escudomágico"

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@SKILL3@DEFENSE_MODE@PROPERTY@NAME"
