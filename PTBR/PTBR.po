msgid "COMBATPROPERTIES_TACTICAL@PRIMA_MATERIA_ATTACK_REBIRTH@NAME"
msgstr "Renascimento Menor"

msgid "COMBATPROPERTIES_TACTICAL@PRIMA_MATERIA_FIRE_RES@DESCRIPTION"
msgstr "Todas as unidades atacantes iniciam o combate com {value} {GLOBAL.FireResistanceConcept.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@PRIMA_MATERIA_FIRE_RES@NAME"
msgstr "Proteção Avançada contra Fogo"

msgid "COMBATPROPERTIES_TACTICAL@PRIMA_MATERIA_GILDED@DESCRIPTION"
msgstr "A cada {value} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, um Golem do lado defensor torna-se {GLOBAL.PROPERTIES.GILDED.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@PRIMA_MATERIA_GILDED@NAME"
msgstr "Construto Dourado"

msgid "COMBATPROPERTIES_TACTICAL@PRIMA_MATERIA_NO_FIRE@DESCRIPTION"
msgstr "Todos os golems defensores recebem {GLOBAL.PROPERTIES.FIERY_REBIRTH.Hyperlink}, mas o {GLOBAL.PROPERTIES.FIERY_REBIRTH.Hyperlink} não causa {GLOBAL.FireDamageConcept.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@PRIMA_MATERIA_NO_FIRE@NAME"
msgstr "Reconstrução Resfriada"

msgid "COMBATPROPERTIES_TACTICAL@PRIMA_MATERIA_RETALIATION@DESCRIPTION"
msgstr "Todas as unidades atacantes ganham {GLOBAL.PROPERTIES.HS_DEFENSE_DEFENSE.Hyperlink} extra contra <<m:{GLOBAL.RetaliationConcept.Name}>>."

msgid "COMBATPROPERTIES_TACTICAL@PRIMA_MATERIA_RETALIATION@NAME"
