msgid "TOME_CYCLES@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Domine os ciclos naturais da vida e da morte e especialize-se em enfraquecer inimigos e curar aliados."

msgid "TOME_CYCLES@TOME@LORE_AUTHOR"
msgstr "Serena, Feiticeira Élfica da Vida"

msgid "TOME_CYCLES@TOME@LORE_DESCRIPTION"
msgstr "\"Há um ciclo em todas as coisas. A fera se alimenta de sua presa, ganhando força. O cadáver apodrece, nutrindo a terra. A vida cede lugar à morte, que, por sua vez, dá lugar a mais vida. Domine esse fluxo e refluxo, e você verá que pode manipular tanto seus dons quanto o preço que ele cobra!\""

msgid "TOME_CYCLES@TOME@NAME"
msgstr "Tomo dos Ciclos"

msgid "TOME_CYCLES@UNIT@NAME"
msgstr "Druida do Ciclo"

msgid "TOME_DEMON_GATE@HERO_SKILL@DESCRIPTION"
msgstr "Enquanto esta unidade for a líder do exército, unidades amigas não {GLOBAL.PROPERTIES.FIEND} e não {GLOBAL.HeroConcept} no exército:[bulletlist][bullet/]Transformam-se em <<m:{GLOBAL.PROPERTIES.FIEND.Hyperlink}>> de Nível I ao morrer em batalha.[bullet/]Têm uma pequena chance de se transformar em <<m:{GLOBAL.PROPERTIES.FIEND.Hyperlink}>> de Nível II.[/bulletlist]"

