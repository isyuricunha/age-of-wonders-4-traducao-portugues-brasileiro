msgid "DLC@RISEFROMRUIN@CULTURE_NOMAD@SUBCULTURE@CONQUERERS@DESCRIPTION"
msgstr "Para seu povo, a sobrevivência é um conflito eterno, no qual eles se destacam:[bulletlist][bullet/]Anexe províncias inimigas saqueadas para obter {GLOBAL.UnitProductionConcept.Hyperlink}, {GLOBAL.StructureProductionConcept.Hyperlink} e {GLOBAL.GoldConcept.Hyperlink} por meio de {GLOBAL.AggressiveExpansionConcept.Hyperlink}.[bullet/]Saquear províncias fornece {GLOBAL.FoodConcept.Hyperlink}.[bullet/]Movimento concede às unidades {GLOBAL.PROPERTIES.EMPOWERING_MOMENTUM.Hyperlink}.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@CULTURE_NOMAD@SUBCULTURE@CONQUERERS@FPG_DESCRIPTION"
msgstr "[bulletlist][bullet/]Cidades móveis que favorecem assentamentos agressivos perto de domínios hostis.[bullet/]Fortalece-se com o movimento em combate.[/bulletlist]"

