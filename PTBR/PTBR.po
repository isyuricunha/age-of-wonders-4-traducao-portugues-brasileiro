msgid "MAGIC_VICTORY@RESULT@VICTORY"
msgstr "Magia"

msgid "MAGIC_VICTORY@SHADOWRESULT@VICTORY"
msgstr "Era da Sombra"

msgid "MAGIC_VICTORY@VICTORY_CONDITION@ATTACKERS_SPAWNED"
msgstr "Invasores surgiram"

msgid "MAGIC_VICTORY@VICTORY_CONDITION@AWAIT_COUNTDOWN"
msgstr "{INT_Count}/{INT_Total} [turn/] Turnos de Ouro Vinculado [sitegold/] <<m:{GLOBAL.AncientWonderConcept.Hyperlink}>> Defendido"

msgid "MAGIC_VICTORY@VICTORY_CONDITION@BUILD_UPGRADES"
msgstr " {INT_Value}/{INT_Required} Ouro [sitegold/] <<m:{GLOBAL.AncientWonderConcept.Hyperlink}>> Vinculado"

msgid "MAGIC_VICTORY@VICTORY_CONDITION@DESCRIPTION"
msgstr "Para alcançar a Vitória Mágica, um {GLOBAL.EmpireConcept.Hyperlink} precisa conjurar e sustentar um número de feitiços Vincular [siteGold/] Ouro {GLOBAL.AncientWonderConcept.Hyperlink}, desbloqueados ao escolher um {GLOBAL.TomeConcept.Hyperlink} de Nível III.[br/][br/]Ao escolher um {GLOBAL.TomeConcept.Hyperlink} de Nível V, você desbloqueia o Feitiço de Vitória Mágica da mesma afinidade do tomo. Você pode conjurá-lo ao ter Ancestrais Dourados Vinculados suficientes.[br/][br/]Canalizar o feitiço leva {turn} <<m:{GLOBAL.TurnConcept.Hyperlink}>> até a vitória ser alcançada. Se você perder uma Maravilha Ancestral vinculada e não tiver mais a quantidade suficiente, o feitiço será cancelado."

msgid "MAGIC_VICTORY@VICTORY_CONDITION@FINISHER_UNLOCKED_SELF"
msgstr "{Finisher.Name} pronto para pesquisa"

msgid "MAGIC_VICTORY@VICTORY_CONDITION@INCREASE_TOME_TIER"
msgstr "Pesquise um Tomo de Nível 3 e desbloqueie o feitiço Vincular Maravilha Ancestral Dourada"

msgid "MAGIC_VICTORY@VICTORY_CONDITION@INITIAL_EVENT"
msgstr "Nós Raiz descobertos!"

msgid "MAGIC_VICTORY@VICTORY_CONDITION@INITIAL_EVENT_EVENT"
msgstr "Nós-Raiz apareceram ao redor do {GLOBAL.WorldMapConcept.Hyperlink}! Capture e converta-os para o seu principal {GLOBAL.AffinityConcept.Hyperlink} a fim de competir pela {VictoryConditionName}."

msgid "MAGIC_VICTORY@VICTORY_CONDITION@LAUNCH_FINISHER"
msgstr "{STR_Operation} Feitiço Lançado"

msgid "MAGIC_VICTORY@VICTORY_CONDITION@LOSING"
msgstr "Capture a [siteGold/] Dourada vinculada de {STR_WinningPlayer} <<m:{GLOBAL.AncientWonderConcept.Hyperlink}>> {INT_Turns} [turn/]"

msgid "MAGIC_VICTORY@VICTORY_CONDITION@NODES_CONVERTED"
msgstr "{Player.Name} converteu nós raiz suficientes!"

msgid "MAGIC_VICTORY@VICTORY_CONDITION@NODES_CONVERTED_EVENT"
msgstr "{Player.Name} converteu a quantidade necessária de Nós-Raiz para conjurar seu feitiço {Finisher.Name}!"

msgid "MAGIC_VICTORY@VICTORY_CONDITION@NODES_CONVERTED_SELF"
