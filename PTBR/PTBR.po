msgid "INTERFACE@LORD_LOAD_FAILURE@DIALOG_HEADER"
msgstr "Falha ao carregar Governantes!"

msgid "INTERFACE@LORD_LOAD_FAILURE@DIALOG_MESSAGE"
msgstr "O arquivo de dados do Governante falhou ao carregar. Cancelar este diálogo pode significar descartar todos os Governantes personalizados criados anteriormente."

