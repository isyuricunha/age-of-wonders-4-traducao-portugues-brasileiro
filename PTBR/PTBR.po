msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@SKILL4@NAME"
msgstr "Invocar Juggernaut Umbral"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@SKILL5@DESCRIPTION"
msgstr "Concede à raça-alvo as bênçãos do Abismo Umbral, garantindo:[bulletlist][bullet/]{GLOBAL.PROPERTIES.SHADOW_SICKNESS_IMMUNITY.Hyperlink}[bullet/]Enquanto em terreno de {GLOBAL.GloomTerrainConcept.Hyperlink}, as unidades ganham:[bulletlist][bullet/]+{UMBRAL_FLESH_MORALE>MoraleBonus} {GLOBAL.UnitMoraleConcept.Hyperlink}[bullet/]+{GLOOM_SHEPHERD_HEALTH_REGEN>BONUS>Regen} {GLOBAL.HitPointConcept.Hyperlink} por {GLOBAL.TurnConcept.Hyperlink} no mapa-múndi.[/bulletlist][bullet/]<<m:{GLOBAL.CityConcept.Hyperlink}>> da raça:[bulletlist][bullet/]Ganham +{KnowledgeAmount} renda de {GLOBAL.KnowledgeConcept.Hyperlink} para cada província com terreno de Trevas.[bullet/]Ignoram penalidades de {GLOBAL.CityStabilityConcept.Hyperlink} de terreno de Trevas.[/bulletlist][bullet/]Unidades de Herói ganham {GLOBAL.PROPERTIES.GLOOM_SHEPHERD.Hyperlink}.[/bulletlist][br/]Esta transformação é incompatível com {GLOBAL.SPECIAL_OPERATIONS.PURE_SOUL.Hyperlink}."

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@SKILL5@NAME"
msgstr "Carne Umbral"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@SKILL5@PROPERTY_DESCRIPTION"
msgstr "Esta unidade tem {GLOBAL.PROPERTIES.SHADOW_SICKNESS_IMMUNITY.Hyperlink} e, enquanto em terreno de {GLOBAL.GloomTerrainConcept.Hyperlink}:[bulletlist][bullet/]+{UMBRAL_FLESH_MORALE>MoraleBonus} {GLOBAL.UnitMoraleConcept.Hyperlink}[bullet/]+{GLOOM_SHEPHERD_HEALTH_REGEN>BONUS>Regen} {GLOBAL.HitPointConcept.Hyperlink} por {GLOBAL.TurnConcept.Hyperlink} no mapa-múndi.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@SKILL6@DESCRIPTION"
msgstr "Todos os <<m:{GLOBAL.UnitConcept.Hyperlink}>> no seu {GLOBAL.EmpireConcept.Hyperlink} ganham {GLOBAL.PROPERTIES.SHADOW_SICKNESS_IMMUNITY.Hyperlink}."

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@SKILL6@NAME"
msgstr "Ritual do Véu das Trevas"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@TOME@DESCRIPTION"
msgstr "Esses benefícios podem ser comprados de um {GLOBAL.UmbralDwellingConcept.Hyperlink} ao alcançar uma {GLOBAL.EldritchPactConcept.Hyperlink} com eles. Eles ajudam seu Império a se adaptar ao {GLOBAL.UmbralAbyssConcept.Hyperlink} e espalhar {GLOBAL.GloomTerrainConcept.Hyperlink}."

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@TOME@NAME"
msgstr "Pacto Arcano"

