msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@SKILL3@MODIFIER_DESCRIPTION_SIMPLE"
msgstr "Chance base de {CONSTRICTED_RESISTANCE_CHECK>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.CONSTRICTED.Hyperlink} por {duration} {GLOBAL.TurnConcept}."

