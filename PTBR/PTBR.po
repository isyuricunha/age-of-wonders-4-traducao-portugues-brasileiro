msgid "TOME_AMPLIFICATION@SKILL2@DESCRIPTION"
msgstr "Unidade inimiga alvo:[bulletlist][bullet/]Sofre {CHAIN_LIGHTNING_DAMAGE>DAMAGE>Shock} {GLOBAL.LightningDamageConcept.Hyperlink}.[bullet/]É afetada por {electrifiedCount} {GLOBAL.PROPERTIES.ELECTRIFIED.Hyperlink}.[bullet/]Este efeito se propaga para outro inimigo dentro de {CHAIN_LIGHTNING_JUMP>MaxDistance} hexágonos.[bullet/]Propaga até {CHAIN_LIGHTNING_JUMP>MaxJumps} vezes.[/bulletlist]"

msgid "TOME_AMPLIFICATION@SKILL2@NAME"
msgstr "Corrente de Relâmpago"

msgid "TOME_AMPLIFICATION@SKILL3@DESCRIPTION"
