msgid "DLC@RISEFROMRUIN@NAMES_RACES@FORM_HAREFOLK@NOUN_2"
msgstr "Jackrabbits"

msgid "DLC@RISEFROMRUIN@NAMES_RACES@FORM_HAREFOLK@NOUN_3"
msgstr "Fofolk"

msgid "DLC@RISEFROMRUIN@NAMES_RACES@FORM_HAREFOLK@NOUN_4"
msgstr "Leporídeos"

msgid "DLC@RISEFROMRUIN@NAMES_RACES@FORM_HAREFOLK@NOUN_5"
msgstr "Orelhudos"

msgid "DLC@RISEFROMRUIN@PRIMAL_CHECK@AFTERMATH_EVENT_TSR@BUTTON"
msgstr "Tente engolir a essência de seu camarada caído e contaminado [hp/]."

msgid "DLC@RISEFROMRUIN@REALM_TRAIT@TSR_FRACTURED_TALES@DESCRIPTION"
msgstr "Há muito tempo, este reino foi lar de alguns dos experimentos dos {GLOBAL.UnmakersLoreConcept.Hyperlink}.[br/][bulletlist][bullet/]Existem Regiões Fadadas presentes no mapa que oferecem cadeias de missões explorando o presente e o passado de {GLOBAL.TheFracturingLoreConcept.Hyperlink}.[bullet/]Ganhe <<m:{GLOBAL.ArtifactConcept.Hyperlink}>> ao completar Regiões Fadadas, que concedem controle sobre o {GLOBAL.CataclysmConcept.Hyperlink} que devasta este reino. Obter três deles levará a uma {GLOBAL.CataclysmVictoryConcept.Hyperlink}.[bullet/]Regiões Fadadas são afetadas por {GLOBAL.PROPERTIES.WARDED_BY_FATE.Hyperlink}.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@REALM_TRAIT@TSR_FRACTURED_TALES@NAME"
msgstr "Ecos do Fracturamento"

msgid "DLC@RISEFROMRUIN@RELIC@ANTI_ESSENCE@DESCRIPTION"
msgstr "[bulletlist][bullet/]Desbloqueia a magia {GLOBAL.SPECIAL_OPERATIONS.MEND_FRACTURE.Hyperlink}.[bullet/]Desbloqueia a magia de {GLOBAL.RaceTransformationConcept.Hyperlink} {GLOBAL.SPECIAL_OPERATIONS.FRACTURED_TRANSFORMATION.Hyperlink}.[bullet/]Desbloqueia a magia {GLOBAL.SPECIAL_OPERATIONS.DETONATE_INFESTATION_WINDS.Hyperlink}.[bulletlist]"

msgid "DLC@RISEFROMRUIN@RELIC@ANTI_ESSENCE@LORE"
msgstr "\"O sangue mancha a praia, de um lar perdido e dolorido[br/]Sangue que carrega a maldição, que os Desfazedores vestiram[br/]Tudo que tocaram se desfez, tudo que tocaram fraturou e rasgou[br/]O futuro, a terra, nós mesmos; carne, vida, e mais, mais, mais...\""

msgid "DLC@RISEFROMRUIN@RELIC@ANTI_ESSENCE@NAME"
msgstr "Elixir Anti-Essência"

msgid "DLC@RISEFROMRUIN@RELIC@DETONATE_INFESTATION@SPELL@DESCRIPTION"
msgstr "Alvo {GLOBAL.STRUCTURES.FRACTURED_INFESTATION.Hyperlink} ou {GLOBAL.STRUCTURES.FLEETING_FRACTURED_INFESTATION.Hyperlink} é destruído, não concede suas recompensas.[br/][br/]Esta magia não contribui para o {GLOBAL.FracturingWindsConcept.Hyperlink} e não pode [hyperlink,GLOBAL.BackfireConcept]Fracassar[/hyperlink]."

msgid "DLC@RISEFROMRUIN@RELIC@DETONATE_INFESTATION@SPELL@NAME"
msgstr "Detonar Infestação"

msgid "DLC@RISEFROMRUIN@RELIC@DIVERT_WINDS@SPELL@DESCRIPTION"
msgstr "Alvo {GLOBAL.ProvinceConcept.Hyperlink} que está marcado para ser atingido por um {GLOBAL.CataclysmConcept.Hyperlink} perde sua marca e não será atingido no próximo Cataclisma.[br/][br/]Esta magia não contribui para o {GLOBAL.FracturingWindsConcept.Hyperlink} e não pode [hyperlink,GLOBAL.BackfireConcept]Fracassar[/hyperlink]."

msgid "DLC@RISEFROMRUIN@RELIC@DIVERT_WINDS@SPELL@NAME"
msgstr "Desviar Ventos Devoradores"

msgid "DLC@RISEFROMRUIN@RELIC@ESSENCE_SHEATH@DESCRIPTION"
msgstr "[bulletlist][bullet/]Desbloqueia a magia {GLOBAL.SPECIAL_OPERATIONS.MEND_FRACTURE.Hyperlink}.[bullet/]Restaurar um {GLOBAL.RuinedNodeConcept.Hyperlink} é {amount}% mais barato. Escala com a quantidade de [hyperlink,GLOBAL.ArtifactConcept]Artefatos[/hyperlink] dos {GLOBAL.UnmakersLoreConcept.Hyperlink} possuídos pelo jogador.[bullet/]Receba {GLOBAL.GoldConcept.Hyperlink} e {GLOBAL.StructureProductionConcept.Hyperlink} adicionais em {GLOBAL.AstralBarrensConcept.Hyperlink} e {GLOBAL.SandConcept.Hyperlink}.[bulletlist]"

msgid "DLC@RISEFROMRUIN@RELIC@ESSENCE_SHEATH@LORE"
msgstr "\"Ruínas surgem das areias vermelhas, fantasmas que ainda seguem ordens[br/]Há um cerco congelado no tempo, mas apenas um lado resiste[br/]Como uma tapeçaria de nosso passado, quando podíamos chamar de lar estas terras perdidas\""

msgid "DLC@RISEFROMRUIN@RELIC@ESSENCE_SHEATH@NAME"
msgstr "Invólucro de Essência^n"

msgid "DLC@RISEFROMRUIN@RELIC@MEND_FRACTURE@SPELL@DESCRIPTION"
msgstr "Reduz o valor de {GLOBAL.FracturingWindsConcept.Hyperlink} em {value}, reduzindo temporariamente a chance de um {GLOBAL.CataclysmConcept.Hyperlink}.[br/]O custo desta magia é reduzido com base na quantidade de [hyperlink,GLOBAL.ArtifactConcept]Artefatos[/hyperlink] do {GLOBAL.UnmakersLoreConcept.Hyperlink} que o lançador possui.[br/][br/]Esta magia não contribui para o {GLOBAL.FracturingWindsConcept.Hyperlink} e não pode [hyperlink,GLOBAL.BackfireConcept]Backfire[/hyperlink]."

msgid "DLC@RISEFROMRUIN@RELIC@MEND_FRACTURE@SPELL@NAME"
msgstr "Reparar Fratura"

msgid "DLC@RISEFROMRUIN@RELIC@WELLS_TEAR@SPELL@NAME"
msgstr "Rasgar Fratura"

msgid "DLC@RISEFROMRUIN@RELIC@WELLS_TEAR@SPELL@NAME2"
msgstr "Rasgar Fratura 2 Antiga"

msgid "DLC@RISEFROMRUIN@RELIC@WELL_TEAR@DESCRIPTION"
msgstr "[bulletlist][bullet/]Desbloqueia a magia {GLOBAL.SPECIAL_OPERATIONS.MEND_FRACTURE.Hyperlink}.[bullet/]Desbloqueia a magia {GLOBAL.SPECIAL_OPERATIONS.TEAR_FRACTURE.Hyperlink}.[bullet/]Desbloqueia a magia {GLOBAL.SPECIAL_OPERATIONS.IRRADIANT_FLARE.Hyperlink}.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@RELIC@WELL_TEAR@FLAG@DESCRIPTION"
msgstr "Unidades neste hex serão atingidas por {amount} {GLOBAL.PhysicalDamageConcept.Hyperlink} e têm uma chance base de {amount2}% de receber {GLOBAL.PROPERTIES.MANA_DRAINED.Hyperlink} no início do turno do dono [turn/] [hyperlink,GLOBAL.TurnConcept]Próximo Turno[/hyperlink]"

msgid "DLC@RISEFROMRUIN@RELIC@WELL_TEAR@LORE"
msgstr "\"Nas profundezas, jaz um lugar pelo destino amaldiçoado[br/]Irradiação corrupta, contaminação coroada[br/]Não a procure, há segredos, melhor perdidos que encontrados\""

msgid "DLC@RISEFROMRUIN@RELIC@WELL_TEAR@NAME"
msgstr "Lágrima do Poço^n"

msgid "DLC@RISEFROMRUIN@RELIC@WELL_TEAR@SPELL@DESCRIPTION"
msgstr "O hex alvo fica marcado. Unidades em um raio de {TEAR_FRACTURE_CIRCLE_TARGETER_DISRUPTED>AREA>Radius} hex do hex marcado têm uma chance base de {amount1}% de receber {GLOBAL.PROPERTIES.DISRUPTION_TOOLTIP_PROPERTY.Hyperlink}. Após {time} {GLOBAL.TurnConcept.Hyperlink}, o hex marcado explode e inflige o seguinte em um raio de {TEAR_FRACTURE_CIRCLE_TARGETER_DISRUPTED>AREA>Radius} hex:[bulletlist][bullet/]Unidades sofrem {amount2} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Unidades têm {amount3}% de chance base de sofrer {GLOBAL.PROPERTIES.MANA_DRAINED.Hyperlink}.[bullet/]Cada hex tem {amount4}% de chance de criar um obstáculo de Fratura de Mana, que possuem {GLOBAL.DrainingConcept.Hyperlink} e se espalham para hexes adjacentes quando magias são lançadas.[/bulletlist][br/][br/]Esta magia não pode [hyperlink,GLOBAL.BackfireConcept]Backfire[/hyperlink]."

msgid "DLC@RISEFROMRUIN@RELIC@WIND_ROSE@DESCRIPTION"
msgstr "[bulletlist][bullet/]Desbloqueia a magia {GLOBAL.SPECIAL_OPERATIONS.MEND_FRACTURE.Hyperlink}.[bullet/]O jogador ganha {GLOBAL.BackfireTailwindsConcept.Hyperlink}.[bullet/]Desbloqueia a magia {GLOBAL.SPECIAL_OPERATIONS.DIVERT_DEVOURING_WINDS.Hyperlink}.[bullet/] Todas as suas <<m:{GLOBAL.UnitConcept.Hyperlink}>> ganham {GLOBAL.PROPERTIES.SAND_WALK.Hyperlink}.[bulletlist]"

msgid "DLC@RISEFROMRUIN@RELIC@WIND_ROSE@LORE"
msgstr "\"Três Fraturas devoram, toda magia e poder[br/]Não ouça o murmúrio do vento, da Torre do Mago perdida[br/]Que sussurra segredos condenados, da hora mais sombria do mundo\""

msgid "DLC@RISEFROMRUIN@RELIC@WIND_ROSE@NAME"
msgstr "Rosa dos Ventos Devoradora^n"

msgid "DLC@RISEFROMRUIN@RELIC_SET@HUBRIS_OF_THE_UNMAKERS@BONUS"
msgstr "Hubris dos Desfazedores"

msgid "DLC@RISEFROMRUIN@RELIC_SET@HUBRIS_OF_THE_UNMAKERS@DESCRIPTION"
msgstr "No turno após coletar todos os Artefatos deste conjunto, o Evento \"O Fraturamento\" será acionado."

msgid "DLC@RISEFROMRUIN@RELIC_SET@TALES_OF_THE_FRACTURING@NAME"
msgstr "Contos do Fraturamento"

msgid "DLC@RISEFROMRUIN@RUINED_WONDER_EVENT_BUTTONS@TEMPLE_NEW_CREED"
msgstr "\"Não mais credos. A própria {EventStructure} [unit/] servirá aos meus desígnios.\" [evilact/]"

msgid "DLC@RISEFROMRUIN@RUINED_WONDER_EVENT_BUTTONS@TEMPLE_NEW_CREED@PROPERTY_TOOLTIP"
msgstr "<<CA:EventUnit>> ganha {GLOBAL.PROPERTIES.BOON_STEALING_PROPERTY_GROUP.Hyperlink}."

msgid "DLC@RISEFROMRUIN@RUINED_WONDER_EVENT_BUTTONS@TEMPLE_SCROLLS_TERROR"
msgstr "Liberte [evilact/] todo o potencial do pergaminho [unit/] e desintegre a {EventStructure}."

msgid "DLC@RISEFROMRUIN@RUINED_WONDER_EVENT_BUTTONS@TEMPLE_SCROLLS_TERROR@GAIN_6_EVENTUNIT"
msgstr "Você ganha um exército de 6 unidades {EventUnit.Name} que possuem o traço {Trait.Name}."

msgid "DLC@RISEFROMRUIN@RUINED_WONDER_EVENT_BUTTONS@WELLSPRING_FAIRY_COURT"
msgstr "Saqueie [evilact/] [influence/] a {EventStructure}. Pegue sua comida [food/] e tesouro. [gold/]"

msgid "DLC@RISEFROMRUIN@RUINED_WONDER_EVENT_BUTTONS@WELLSPRING_FROZEN_LAKE"
msgstr "Destrua a {EventStructure} para aproveitar os segredos [knowledge/] do gelo. [mana/]"

msgid "DLC@RISEFROMRUIN@RUINED_WONDER_EVENT_BUTTONS@WELLSPRING_FROZEN_LAKE_KNOWLEDGE_ONLY"
msgstr "Destrua a {EventStructure} para aproveitar os segredos [knowledge/] do gelo."

msgid "DLC@RISEFROMRUIN@RUINED_WONDER_EVENT_BUTTONS@WORLD_TREE_GUARDIAN"
msgstr "\"Agora dreno [evilact/] sua energia vital [hp/] e a da {EventStructure}.\""

msgid "DLC@RISEFROMRUIN@RUINED_WONDER_EVENT_BUTTONS@WORLD_TREE_THUNDERED"
msgstr "Empunhe o <<G:lightning^n,EventUnit>> [mana/] para destruir a {EventStructure}. [structureprod/]"

msgid "DLC@RISEFROMRUIN@RUINED_WONDER_EVENT_BUTTONS@WORLD_TREE_THUNDERED_KNOWLEDGE"
msgstr "Empunhe o <<G:lightning^n,EventUnit>> [knowledge/] para destruir a {EventStructure}. [structureprod/]"

msgid "DLC@RISEFROMRUIN@SECTORDEFINITIONS_STRATEGIC@ASTRAL_BARRENS_FEATURE@DESCRIPTION"
msgstr "Uma {GLOBAL.ProvinceFeatureConcept.Hyperlink}.[br/][br/]Essas terras foram erodidas por um vento que arranca todas as formas de magia de todos e tudo.[br/][bulletlist][bullet/]{GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> não regeneram <<m:{GLOBAL.HitPointConcept.Hyperlink}>> nesta província.[bullet/]<<m:{GLOBAL.WorldMapSpellConcept.Hyperlink}>> e <<m:{GLOBAL.CombatSpellConcept.Hyperlink}>> lançados nesta província têm uma chance de {percentage} de {GLOBAL.BackfireConcept.Hyperlink}.[bullet/]Nenhuma renda de {GLOBAL.ManaConcept.Hyperlink} pode ser obtida desta Província.[bullet/]<<m:{GLOBAL.NodeConcept.Hyperlink}>> na província se tornam [hyperlink,GLOBAL.RuinedNodeConcept]Ruined[/hyperlink].[bullet/]Nós Ruinados não podem ser restaurados enquanto esta província tiver Astral Barrens.[bullet/]O terreno não pode ser alterado pela maioria das magias e efeitos.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@SECTORDEFINITIONS_STRATEGIC@MAGIC_EROSION@DESCRIPTION"
msgstr "Esta unidade está sendo afetada por estar em {GLOBAL.AstralBarrensConcept.Hyperlink} e portanto não regenera <<m:{GLOBAL.HitPointConcept.Hyperlink}>> no mapa mundial."

msgid "DLC@RISEFROMRUIN@SECTORDEFINITIONS_STRATEGIC@MAGIC_EROSION@NAME"
msgstr "Erosão Mágica"

