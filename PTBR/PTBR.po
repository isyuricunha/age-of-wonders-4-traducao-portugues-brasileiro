msgid "TOME_GREAT_TRANSFORMATION@SKILL5@DESCRIPTION"
msgstr "Alvo um nó de recurso em seu domínio:[bulletlist][bullet/]O nó fornece renda de {mana} {GLOBAL.SoulConcept.Hyperlink}.[bullet/]Se perder a província, o efeito cessa.[/bulletlist]"

