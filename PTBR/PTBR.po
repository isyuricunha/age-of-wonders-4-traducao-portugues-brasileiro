msgid "INTERFACE@TEXT@CITY_CAP"
msgstr "Limite de Cidades"

msgid "INTERFACE@TEXT@CITY_CAP_DESCRIPTION"
msgstr "O número de <<m:{GLOBAL.CityConcept.Hyperlink}>> que seu {GLOBAL.EmpireConcept.Hyperlink} pode controlar.[br/][br/]Exceder seu Limite de Cidades resulta em {incomepercentage} {GLOBAL.CityIncomeConcept.Hyperlink} para todas as suas <<m:{GLOBAL.CityConcept.Hyperlink}>> por cada {GLOBAL.CityConcept.Hyperlink} acima do Limite de Cidades.[br/][br/]Seu Limite de Cidades pode ser aumentado por meio de {GLOBAL.EmpireDevelopmentConcept.Hyperlink}"

msgid "INTERFACE@TEXT@CITY_CAP_DESCRIPTION_SHORT"
msgstr "O número de <<m:{GLOBAL.CityConcept.Hyperlink}>> que você pode controlar sem sofrer penalidades econômicas.[br/]O Limite de Cidades pode ser aumentado por meio da árvore {GLOBAL.EmpireDevelopmentConcept.Hyperlink}."

msgid "INTERFACE@TEXT@CITY_CAP_HYPERLINK"
msgstr "[hyperlink,GLOBAL.CityCapConcept]Limite de Cidades[/hyperlink]"

msgid "INTERFACE@TEXT@CITY_CAP_PENALTY"
