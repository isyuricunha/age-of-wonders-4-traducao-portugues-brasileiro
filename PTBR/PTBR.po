msgstr "{AP1_COUNCIL_COMMUNED}/1 Alto Conselho dos Arcontes Contactado"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@MAIN_OBJECTIVE_FINAL_ALT"
