msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_CRYSTAL_FOREST@DESCRIPTION"
msgstr "[bulletlist][bullet/]{manabonus} {GLOBAL.ManaConcept.Hyperlink} por {GLOBAL.ConduitConcept.Hyperlink} em {GLOBAL.CityConcept.Hyperlink} {GLOBAL.DomainConcept.Hyperlink}. [bullet/]Adiciona a unidade {GLOBAL.UNITS.ASTRAL_KEEPER_UNIT.Hyperlink} ao {GLOBAL.RequestMilitaryAidConcept.Hyperlink}. [/bulletlist]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_CRYSTAL_FOREST@LORE"
msgstr "Poderosas [hyperlink,GLOBAL.AstralFlowsLoreConcept]Correntes Astrais[/hyperlink] convergem neste local. Em vez de formar um Nó de Mana comum, essas energias cristalizaram-se em uma floresta de árvores cintilantes. Ramos intrincados e sistemas de raízes profundos e sinuosos sugerem uma interconexão com grande parte do universo; <<c:{GLOBAL.SoulsLoreConcept.Hyperlink}>>, [hyperlink,GLOBAL.WorldsWithinLoreConcept]Mundos[/hyperlink], até eras. Tempo e espaço não têm significado aqui."

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_CRYSTAL_FOREST@NAME"
msgstr "Floresta de Cristal"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ENCHANTED_CAVE@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{amount} {GLOBAL.ManaConcept.Hyperlink} por {GLOBAL.QuarryConcept.Hyperlink} em {GLOBAL.CityConcept.Hyperlink} {GLOBAL.DomainConcept.Hyperlink}. [bullet/]Adiciona as unidades {GLOBAL.UNITS.STORMSCALE_SERPENT.Hyperlink} e {GLOBAL.UNITS.PLAGUE_SERPENT.Hyperlink} ao {GLOBAL.RequestMilitaryAidConcept.Hyperlink}. [/bulletlist]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ENCHANTED_CAVE@LORE"
msgstr "[lorefontsize][lorefont]Uma caverna antiga que remonta ao tempo da criação deste mundo, numa era em que Dragões e Gigantes moldaram as próprias terras em forma física. Dentro desses santuários naturais, as primeiras criaturas encontraram refúgio enquanto o mundo exterior se assentava violentamente. Até hoje, a própria caverna permanece um santuário para aqueles que conseguem encontrar o caminho até ela.[/lorefont][/lorefontsize]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ENCHANTED_CAVE@NAME"
msgstr "Caverna Antiga"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_FORBIDDEN_CRYPT@DESCRIPTION"
msgstr "[bulletlist][bullet/]{manaincome} {GLOBAL.ManaConcept.Hyperlink}, {knowledgeincome} {GLOBAL.KnowledgeConcept.Hyperlink}, e {soulsincome} {GLOBAL.SoulConcept.Hyperlink} (se obtido) para cada {GLOBAL.HeroConcept.Hyperlink} em {GLOBAL.CryptConcept.Hyperlink}. [bullet/]Adiciona a unidade {GLOBAL.UNITS.CORRUPT_SOUL.Hyperlink} ao {GLOBAL.RequestMilitaryAidConcept.Hyperlink}. [/bulletlist]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_FORBIDDEN_CRYPT@LORE"
msgstr "[lorefontsize][lorefont]Uma necrópole sinistra criada pelos antigos Shad'rai. Seus túneis e câmaras funerárias parecem expandir-se, quase como se estivessem vivas e buscassem acomodar novos habitantes ao longo das eras. Esta tumba não apenas anseia pelos corpos dos mortos, mas deseja devorar suas próprias <<c:{GLOBAL.SoulsLoreConcept.Hyperlink}>>.[/lorefont][/lorefontsize]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_FORBIDDEN_CRYPT@NAME"
msgstr "Tumba Perdida"

