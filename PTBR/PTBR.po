msgstr "Causam {amount} {GLOBAL.LightningDamageConcept.Hyperlink} em unidades inimigas adjacentes."

msgid "DLC@PRIMALFURY@PRIMAL_FURY_ABILITY@CROW_FURY@NAME"
msgstr "Fúria do Corvo da Tempestade"

msgid "DLC@PRIMALFURY@PRIMAL_FURY_ABILITY@MAMMOTH@DESCRIPTION"
msgstr "Unidade abençoada pelo Mamute Glacial:[bulletlist][bullet/]Ela ganha uma pilha de {GLOBAL.PROPERTIES.PRIMAL_FURY_MAMMOTH.Hyperlink} ao atacar.[bullet/]Com {amount} pilhas, elas se transformam em pilhas de {GLOBAL.PROPERTIES.FURY_MAMMOTH.Hyperlink}. Os ataques básicos da unidade ganham:[bulletlist][bullet/]+{FURY_MAMMOTH_EXTRA_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Chance base de {amount2}% de infligir {GLOBAL.PROPERTIES.FROZEN.Hyperlink}.[/bulletlist][bullet/]Cada ataque remove uma pilha de {GLOBAL.PROPERTIES.FURY_MAMMOTH.Hyperlink}.[/bulletlist]"

msgid "DLC@PRIMALFURY@PRIMAL_FURY_ABILITY@MAMMOTH@NAME"
msgstr "Dádiva do Mamute Glacial"

msgid "DLC@PRIMALFURY@PRIMAL_FURY_ABILITY@MAMMOTH_FURY@DESCRIPTION"
msgstr "Ataques:[bulletlist][bullet/]Ganham +{FURY_MAMMOTH_EXTRA_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Têm uma chance base de {amount}% de infligir {GLOBAL.PROPERTIES.FROZEN.Hyperlink}.[/bulletlist][br/]Cada ataque remove uma pilha deste efeito."

msgid "DLC@PRIMALFURY@PRIMAL_FURY_ABILITY@MAMMOTH_FURY@NAME"
msgstr "Fúria do Mamute Glacial"

msgid "DLC@PRIMALFURY@PRIMAL_FURY_ABILITY@SABERTOOTH@DESCRIPTION"
msgstr "Unidade abençoada pela Onça das Cinzas:[bulletlist][bullet/]Ela ganha uma pilha de {GLOBAL.PROPERTIES.PRIMAL_FURY_SABERTOOTH.Hyperlink} ao atacar.[bullet/]Com {amount} pilhas, elas se transformam em pilhas de {GLOBAL.PROPERTIES.FURY_SABERTOOTH.Hyperlink}. Os ataques básicos da unidade ganham:[bulletlist][bullet/]+{FURY_SABERTOOTH_EXTRA_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Causam {FURY_SABERTOOTH_JUMP_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} em outra unidade a até {FURY_SABERTOOTH_JUMP_TARGETER>MaxDistance} hexes de distância.[/bulletlist][bullet/]Cada ataque remove uma pilha de {GLOBAL.PROPERTIES.FURY_SABERTOOTH.Hyperlink}.[/bulletlist]"

msgid "DLC@PRIMALFURY@PRIMAL_FURY_ABILITY@SABERTOOTH@NAME"
msgstr "Bênção da Presa de Cinzas"

