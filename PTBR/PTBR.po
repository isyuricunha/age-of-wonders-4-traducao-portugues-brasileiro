msgid "TOME_WILD@BEASTMASTER@ABILITY_1@NAME"
msgstr "Libere a Fera"

msgid "TOME_WILD@BEASTMASTER@ABILITY_2@DESCRIPTION"
msgstr "Invoca uma unidade animal aleatória de Nível I.{LOC.CONCEPT@SUMMON_LIVE_SHARED}[br/][br/]Entre em {GLOBAL.DefenseModeConcept.Hyperlink} após o uso."

msgid "TOME_WILD@BEASTMASTER@ABILITY_2@DESCRIPTION_2"
msgstr "Invoca uma unidade animal aleatória de Nível II.{LOC.CONCEPT@SUMMON_LIVE_SHARED}[br/][br/]Entre em {GLOBAL.DefenseModeConcept.Hyperlink} após o uso."

msgid "TOME_WILD@BEASTMASTER@ABILITY_2@DESCRIPTION_CHAMPION"
msgstr "Conjurar Animal:[bulletlist][bullet/]Agora invoca um animal de Nível II.[/bulletlist]"

