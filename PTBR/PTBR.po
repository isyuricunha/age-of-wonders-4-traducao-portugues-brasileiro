msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_03@COMBAT_DESCRIPTION"
msgstr "Unidades amigas do dono deste efeito recebem:[bulletlist][bullet/]Se esta unidade atacou, ao final do seu turno ganha uma pilha de {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} e {GLOBAL.PROPERTIES.NATURES_MIGHT.Hyperlink} por {NATURES_MIGHT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_03@DESCRIPTION"
msgstr "Enquanto esta unidade está em batalha, todas as unidades amigas recebem:[bulletlist][bullet/]Se esta unidade atacou, ao final do seu turno ganha uma pilha de {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} e {GLOBAL.PROPERTIES.NATURES_MIGHT.Hyperlink} por {NATURES_MIGHT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

