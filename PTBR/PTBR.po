msgstr "[hyperlink,GLOBAL.StoneGiantKingConcept]Rei Gigante das Rochas[/hyperlink]"

msgid "DLC@GIANTKINGS@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@GIANT_KING_STORM@DESCRIPTION"
msgstr "{LOC.DLC@GIANTKINGS@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@GIANT_KING_STORM@DESCRIPTION_SHORT}[br/][bulletlist][bullet/]A cidade capital começa com {GLOBAL.STRUCTURE_UPGRADES.WIZARD_TOWER_ITEM_FORGE.Hyperlink}.[bullet/]Tem o feitiço {GLOBAL.SPECIAL_OPERATIONS.ABRADE_MOUNTAIN.Hyperlink}.[bullet/]Províncias com Rios ou Água fornecem +{amount} {GLOBAL.FoodConcept.Hyperlink} e +{amount2} {GLOBAL.ManaConcept.Hyperlink}.[bullet/]Reis Gigantes são <<m:{GLOBAL.PROPERTIES.HEROTRAIT_GOVERNANCE_GIANT_GOVERNOR.Hyperlink}>>.[bullet/]Reis Gigantes têm um(a) {amount3} {GLOBAL.ManaConcept.Hyperlink} {GLOBAL.UnitUpkeepConcept.Hyperlink} e não podem equipar itens de Montaria.[/bulletlist]"

