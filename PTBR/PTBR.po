msgid "TOME_VIGOR@SKILL3@PROP_DESCRIPTION"
msgstr "Unidade tem:[bulletlist][bullet/]+{SUPERGROWTH_STAT_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]+{VIGILANT_NUM_OVERWATCH>NumTriggersToAdd} {GLOBAL.RetaliationConcept.Hyperlink}[/bulletlist]"

msgid "TOME_VIGOR@SKILL4@DESCRIPTION"
msgstr "Faz unidades encantadas:[bulletlist][bullet/]Causarem +{EMPOWERED_BEASTS_DAMAGE_MULTIPLIER>ResolvedMultiplier}% de dano.[bullet/]Ganham +{EMPOWERED_BEASTS_HP_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[bullet/]Ganham {GLOBAL.PROPERTIES.DEMOLISHER.Hyperlink}, permitindo que destruam obstáculos reforçados.[bullet/]Número reduzido de unidades na formação.[/bulletlist]"

msgid "TOME_VIGOR@SKILL4@NAME"
msgstr "Feras Potencializadas"

msgid "TOME_VIGOR@SKILL4@PROP_DESCRIPTION"
msgstr "Unidade encantada:[bulletlist][bullet/]Causa +{EMPOWERED_BEASTS_DAMAGE_MULTIPLIER>ResolvedMultiplier}% de dano.[bullet/]Ganha +{EMPOWERED_BEASTS_HP_BONUS>BONUS>HitPoints}<<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[bullet/]Ganha {GLOBAL.PROPERTIES.DEMOLISHER.Hyperlink}.[/bulletlist]"

msgid "TOME_VIGOR@SKILL5@DESCRIPTION"
msgstr "Invoca um {GLOBAL.UNITS.TOTEM_OF_THE_WILD_UNIT.Hyperlink}, que gera uma unidade animal aleatória de Nível I ou II quando criado e no início do seu próximo {count} <<m:{GLOBAL.TurnConcept}>>.[br/][br/]{LOC.TACTICAL@ABILITY@NEVER_IN_WATER}"

msgid "TOME_VIGOR@SKILL5@NAME"
msgstr "Totem da Selva^n"

msgid "TOME_VIGOR@SKILL5@PROP_DESCRIPTION"
msgstr "No início de cada {GLOBAL.TurnConcept.Hyperlink}, invoca uma unidade Animal aleatória de Nível I ou II.{LOC.CONCEPT@SUMMON_LIVE_SHARED}"

msgid "TOME_VIGOR@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Fortaleça suas unidades e exércitos com o poder bruto das feras selvagens. Especialize‑se em fortalecer <<m:{GLOBAL.PROPERTIES.ANIMAL.Hyperlink}>> e aumentar <<m:{GLOBAL.HitPointConcept}>>."

msgid "TOME_VIGOR@TOME@LORE_AUTHOR"
msgstr "Zaethyl, Guardião Selvagem dos Primeiros Elfos"

msgid "TOME_VIGOR@TOME@LORE_DESCRIPTION"
msgstr "\"O poder indomável da manada que troveja sobre a planície, a força bruta do urso majestoso ao fechar sobre sua presa. Ouça a música primal que pulsa nos tendões e ossos das bestas! Então você poderá dominá‑la e fortalecer seu bando com a própria força da natureza.\""

msgid "TOME_VIGOR@TOME@NAME"
msgstr "Tomo de Vigor"

msgid "TOME_VIGOR@UNIT1@NAME"
msgstr "Totem da Selva"

msgid "TOME_WARDING@HERO_SKILL@DESCRIPTION"
msgstr "{GLOBAL.SupportConcept.Hyperlink} concedem {amount} {GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink} às unidades afetadas."

msgid "TOME_WARDING@HERO_SKILL@NAME"
msgstr "Suporte Reforçador"

msgid "TOME_WARDING@PASSIVE@DESCRIPTION"
