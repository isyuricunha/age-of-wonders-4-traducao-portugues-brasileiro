msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@MOF@HEADER_ASSAULT"
msgstr "As manifestações dos seus medos estão atacando suas cidades!"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@MOF@MANA_DEBUFF"
msgstr "Enquanto qualquer exército de crise estiver ativo, suas <<m:{GLOBAL.CityConcept.Hyperlink}>> têm {AP1_MOF_INCOME_DEBUFF}% de renda de {GLOBAL.ManaConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@MOF@NEXT_TOOLTIP"
msgstr "O próximo exército de crise surgirá em {CrisisTimer} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@MOF@OBJ_ARMIES"
msgstr "Exércitos de Crise Ativos: {AP1_MOF_NUM_ARMIES}"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@MOF@POP_LOSS_DEBUFF"
msgstr "Enquanto qualquer exército de crise estiver ativo, uma das suas <<m:{GLOBAL.CityConcept.Hyperlink}>> perde uma {GLOBAL.PopulationConcept.Hyperlink} a cada {AP1_MOF_DEBUFF_INTERVAL} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@MOF@SIEGE_DAMAGE"
msgstr "Enquanto qualquer exército de crise estiver ativo, suas <<m:{GLOBAL.CityConcept.Hyperlink}>> perdem {AP1_MOF_SIEGE_DAMAGE} {GLOBAL.FortificationHealthConcept.Hyperlink} a cada {AP1_MOF_DEBUFF_INTERVAL} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@MOF@STABILITY_DEBUFF"
msgstr "Enquanto qualquer exército de crise estiver ativo, suas <<m:{GLOBAL.CityConcept.Hyperlink}>> têm {AP1_MOF_INCOME_DEBUFF} {GLOBAL.CityStabilityConcept.Hyperlink}."

