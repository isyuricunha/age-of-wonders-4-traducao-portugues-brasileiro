msgstr "Todas as unidades defensoras foram transformadas em Pinguins Terríveis."

msgid "COMBATPROPERTIES_TACTICAL@DIRE_PENGUIN_MENACE@NAME"
msgstr "Ameaça dos Pinguins Terríveis"

