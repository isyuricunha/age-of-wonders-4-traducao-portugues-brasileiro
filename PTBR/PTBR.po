msgstr "A unidade inimiga-alvo sofre:[bulletlist][bullet/]{BLAZE_OF_THE_HORDE_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]+{BLAZE_OF_THE_HORDE_COUNT_ADJACENT>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} para cada unidade amiga adjacente[/bulletlist]"

msgid "TOME_HORDE@SKILL5@NAME"
msgstr "Chama da Horda"

msgid "TOME_HORDE@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Transforme suas unidades mais baratas em exércitos grandes e mortais. Especialize-se em invocar e fortalecer unidades de Nível I."

msgid "TOME_HORDE@TOME@LORE_AUTHOR"
msgstr "Chamador do Enxame Trass, Chefe de Guerra Ratkin"

msgid "TOME_HORDE@TOME@LORE_DESCRIPTION"
msgstr "\"Os Mestres da Horda entendem o poder dos grandes números, das massas enfurecidas. No fim, nossos cães de guerra despedaçarão os cavaleiros mais fortes e os feiticeiros mais astutos. O maior erro de nossos inimigos é subestimar quantos servos comandamos e o quanto pouco nos importamos com suas vidas.\""

msgid "TOME_HORDE@TOME@NAME"
msgstr "Tomo da Horda"

msgid "TOME_HORDE@UNIT2@NAME"
msgstr "Cão de Guerra^n"

