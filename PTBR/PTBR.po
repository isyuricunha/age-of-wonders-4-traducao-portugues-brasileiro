msgid "DIPLOMACY@CALLTOWAR@ITEM_TOOLTIP_FAIL_COOLDOWN"
msgstr "{Player.Lord.FirstName} recusou recentemente seu chamado à guerra e não pode ser chamado novamente por {Cooldown}<<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DIPLOMACY@CALLTOWAR@ITEM_TOOLTIP_FAIL_COOLDOWNWAR"
msgstr "{Player.Lord.FirstName} e {Target.Lord.FirstName} estiveram recentemente em guerra e não podem ser convocados um contra o outro. Aguarde {Cooldown}<<m:{GLOBAL.TurnConcept.Hyperlink}>> para fazer um chamado à guerra."

msgid "DIPLOMACY@CALLTOWAR@ITEM_TOOLTIP_FAIL_TRUCE"
msgstr "{Player.Lord.FirstName} e {Target.Lord.FirstName} compartilham um {GLOBAL.TruceConcept.Hyperlink} e não podem ser convocados um contra o outro. A trégua ainda dura {Cooldown}<<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DIPLOMACY@CALLTOWAR@TITLE"
msgstr "Chamado à guerra"

msgid "DIPLOMACY@CANTBREAKTREATY@TITLE"
msgstr "Tratados duram indefinidamente, mas podem ser rompidos manualmente ou ao declarar {GLOBAL.WarConcept.Hyperlink}. Alguns tratados diplomáticos dependem de um estado diplomático específico ou de outro tratado. Quando um tratado termina, qualquer outro tratado feito no mesmo acordo comercial também expira."

