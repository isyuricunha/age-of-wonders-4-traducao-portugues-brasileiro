msgstr "Campeão Olhar da Ruína"

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_05@NAME"
msgstr "Olhar da Ruína"

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_06@DESCRIPTION"
msgstr "Unidade inimiga não‑herói alvo tem {SERPENTINE_CURSE_RESISTANCE_CHECK>ResolvedStrength}% de chance base de se transformar em um {GLOBAL.UNITS.PLAGUE_SERPENT.Hyperlink} sob controle do conjurador.[br/][br/]Não pode ser usado em batalhas aquáticas."

