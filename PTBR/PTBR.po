msgid "TOME_ASTRAL_CONVERGENCE@PASSIVE@NAME"
msgstr "Tecer Feitiços com Eficiência"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL1@ATTUNEMNT_DESCRIPTION"
msgstr "Quando um feitiço aliado é conjurado, esta unidade ganha um {GLOBAL.PositiveStatusEffectConcept.Hyperlink} aleatório."

msgid "TOME_ASTRAL_CONVERGENCE@SKILL1@ATTUNEMNT_NAME"
msgstr "Sintonia: Presságio Astral"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL1@DESCRIPTION"
msgstr "Vincula a raça-alvo ao Mar Astral, concedendo:[bulletlist][bullet/]O tipo de unidade {GLOBAL.PROPERTIES.ETHEREAL.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.ATTUNEMENT_ASTRAL_OMEN.Hyperlink}, concedendo um {GLOBAL.PositiveStatusEffectConcept.Hyperlink} aleatório quando um feitiço é conjurado em combate.[/bulletlist]"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL1@NAME"
msgstr "Sintonia Astral"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL1@PROPERTY_DESCRIPTION"
msgstr "A unidade tem:[bulletlist][bullet/]O tipo de unidade {GLOBAL.PROPERTIES.ETHEREAL.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.ATTUNEMENT_ASTRAL_OMEN.Hyperlink}[/bulletlist]"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL2@DESCRIPTION"
msgstr "Hex alvo desocupado:[bulletlist][bullet/]Conjura uma unidade {GLOBAL.UNITS.ASTRAL_SERPENT_UNIT.Hyperlink} ou {GLOBAL.UNITS.ASTRAL_SIPHONER_UNIT.Hyperlink} aleatória que dura por {SUMMON_POSITION_EFFECT>TurnsToLive} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Todas as unidades adjacentes sofrem {EXPLOSIVE_MANIFESTATION_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}, {EXPLOSIVE_MANIFESTATION_DAMAGE>DAMAGE>Shock} {GLOBAL.LightningDamageConcept.Hyperlink} e {EXPLOSIVE_MANIFESTATION_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL2@NAME"
msgstr "Manifestação Explosiva"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL3@DESCRIPTION"
