msgid "DIPLOMACY@CALLTOWAR@BUTTON_ANSWER_TOOLTIP"
msgstr "Responder ao Chamado à Guerra de {Player.Name} contra {Target.Name}. Aceitar o chamado concederá a você <<m:{GLOBAL.CasusBelliConcept.Hyperlink}>> adicionais, enquanto recusar prejudicará suas relações."

msgid "DIPLOMACY@CALLTOWAR@BUTTON_INTO"
