msgid "DLC@PRIMALFURY@PRIMAL_FURY_ABILITY@SPIDER_FURY@NAME"
msgstr "Fúria da Aranha Escavadora"

msgid "DLC@PRIMALFURY@PRIMAL_FURY_ABILITY@WOLF@DESCRIPTION"
msgstr "Unidade é abençoada pelo Lobo Silvano:[bulletlist][bullet/]Ganha uma pilha de {GLOBAL.PROPERTIES.PRIMAL_FURY_WOLF.Hyperlink} ao atacar.[bullet/]Com {amount} pilhas, estas se transformam em pilhas de {GLOBAL.PROPERTIES.FURY_WOLF.Hyperlink}. Os ataques básicos da unidade ganham:[bulletlist][bullet/]+{FURY_WOLF_EXTRA_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink}.[bullet/]+{FURY_WOLF_EXTRA_DAMAGE_COUNTING>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink} por unidade aliada adjacente ao alvo.[/bulletlist][bullet/]Cada ataque remove uma pilha de {GLOBAL.PROPERTIES.FURY_WOLF.Hyperlink}.[/bulletlist]"

msgid "DLC@PRIMALFURY@PRIMAL_FURY_ABILITY@WOLF@NAME"
msgstr "Bênção do Lobo Silvano"

msgid "DLC@PRIMALFURY@PRIMAL_FURY_ABILITY@WOLF_FURY@DESCRIPTION"
msgstr "Ataques ganham:[bulletlist][bullet/]+{FURY_WOLF_EXTRA_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink}.[bullet/]+{FURY_WOLF_EXTRA_DAMAGE_COUNTING>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink} por unidade aliada adjacente ao alvo.[/bulletlist][br/]Perde uma pilha deste efeito ao atacar."

msgid "DLC@PRIMALFURY@PRIMAL_FURY_ABILITY@WOLF_FURY@NAME"
msgstr "Fúria do Lobo Silvestre"

msgid "DLC@PRIMALFURY@PRIMAL_FURY_ABILITY@WOLF_FURY@PROP_DESCRIPTION"
