msgstr "[hyperlink,GLOBAL.NekronLoreConcept]Nekron, o Ressuscitado^M[/hyperlink]"

msgid "INTERFACE@LORE_CONCEPT@NEKRON@NAME"
msgstr "Nekron, o Ressuscitado^M"

