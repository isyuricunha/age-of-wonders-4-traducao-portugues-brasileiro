msgid "DLC@GIANTKINGS@BASE_ABILITY@MAGIC_BLAST@ETERNALS"
msgstr "Explosão Eterna"

msgid "DLC@GIANTKINGS@BASE_ABILITY@MAGIC_BLAST@ETERNALS_DESCRIPTION"
msgstr "Causa dano a unidades em um raio de {ETERNALS_BLAST_TARGETER>AREA>Radius} hexes."

msgid "DLC@GIANTKINGS@BASE_ABILITY@MAGIC_BLAST@VOLATILE"
msgstr "Explosão Volátil"

msgid "DLC@GIANTKINGS@BOON_STEAL@CHANCE_MODIFIER"
msgstr "Chance base de {BOON_STEALING_RESISTANCE_CHECK>ResolvedStrength}% de roubar {amount1} {GLOBAL.PositiveStatusEffectConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@CITYDEFINITION_STRATEGIC@CRYSTAL_DWELLING@DESCRIPTION"
msgstr "As Moradas de Cristal são um tipo de {GLOBAL.DwellingConcept.Hyperlink} habitado por remanescentes dos Reis Gigantes em formas de Litorina.[br/][bulletlist][bullet/]Apenas 1 Morada de Cristal existe em um reino.[bullet/]A única forma de melhorar {GLOBAL.HouseInfluenceConcept.Hyperlink} com a Morada é por meio de Missões.[bullet/]Ter um Pacto com a Morada de Cristal desbloqueará várias opções de comércio com eles, como conteúdo de {GLOBAL.TomeConcept.Hyperlink}, <<m:{GLOBAL.ArtifactConcept.Hyperlink}>>, <<m:{GLOBAL.UnitConcept.Hyperlink}>> de Litorina e revelar pontos de interesse no mapa.[bullet/]Uma vez capturada, a Morada de Cristal é imediatamente destruída e concede alguns dos itens de comércio da Morada ao conquistador.[/bulletlist]"

msgid "DLC@GIANTKINGS@CITYDEFINITION_STRATEGIC@CRYSTAL_DWELLING@NAME"
msgstr "Morada de Cristal"

msgid "DLC@GIANTKINGS@CITYDEFINITION_STRATEGIC@CRYSTAL_DWELLING@TYPE"
msgstr "Moradas de Cristal"

msgid "DLC@GIANTKINGS@CITYDEFINITION_STRATEGIC@LITHORINE_WALLS@NAME"
msgstr "Muralhas de Litorita"

msgid "DLC@GIANTKINGS@CITYDEFINITION_STRATEGIC@LITHORINE_WALLS@UNLOCK"
msgstr "Obstáculos de Muralha de Litorita em combate"

msgid "DLC@GIANTKINGS@CITYDEFINITION_STRATEGIC@LITHORINE_WALLS@UNLOCK_DESCRIPTION"
msgstr "Obstáculos de Muralha de Litorita são {GLOBAL.FortifiedConcept.Hyperlink} com uma grande quantidade de <<m:{GLOBAL.HitPointConcept.Hyperlink}>> e infligem {GLOBAL.PROPERTIES.VOLATILE_CHARGE.Hyperlink} em Unidades em um raio de {radius} hexes quando destruídos."

msgid "DLC@GIANTKINGS@CITYDEFINITION_STRATEGIC@VOLATILE_RUNES@NAME"
msgstr "Runas Voláteis"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@ACIDIC_VAPOURS@DESCRIPTION"
msgstr "A cada {GLOBAL.TurnConcept.Hyperlink}, algumas posições se tornam {GLOBAL.PROPERTIES.POISONOUS.Hyperlink} por {timer} turnos. Todas as unidades defensoras são imunes ao efeito de veneno."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@ACIDIC_VAPOURS@NAME"
msgstr "Poças Ácidas"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@ANCIENT_DRACONIC_INSTINCT@DESCRIPTION"
msgstr "Todas as {GLOBAL.PROPERTIES.DRAGON.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> ganham {GLOBAL.PROPERTIES.FRENZY.Hyperlink} até o fim do combate."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@ANCIENT_DRACONIC_INSTINCT@NAME"
msgstr "Frenesi Dracônico Ancestral"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@BEHEMOTHS_DREADFUL_PRESENCE@DESCRIPTION"
msgstr "A cada {GLOBAL.TurnConcept.Hyperlink}, cada unidade sofre {chance} de sofrimento {GLOBAL.PROPERTIES.REMORSE.Hyperlink}."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@BEHEMOTHS_DREADFUL_PRESENCE@NAME"
msgstr "Presença Aterradora do Beemote"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@BERSERK_WYRMS@DESCRIPTION"
msgstr "Serpentes menores se tornam {GLOBAL.PROPERTIES.BERSERK.Hyperlink}."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@BERSERK_WYRMS@NAME"
msgstr "Frenesi Serpentino"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@BINDING_HEX@DESCRIPTION"
msgstr "Várias posições no mapa contêm uma Maldição Vinculante. Quando um Demônio Infernal atravessa uma Maldição Vinculante, ele fica {GLOBAL.PROPERTIES.STUNNED.Hyperlink} por {timer} {GLOBAL.TurnConcept.Hyperlink} e a Maldição Vinculante é removida."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@BINDING_HEX@NAME"
msgstr "Maldição Vinculante"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@BLINDED_MOTH@DESCRIPTION"
msgstr "No início do combate, a Mariposa Primordial fica {GLOBAL.PROPERTIES.BLINDED.Hyperlink} por {value} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@BLINDED_MOTH@NAME"
msgstr "Sobrecarga Sensorial"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@BRING_IN_DEVASTATORS@DESCRIPTION"
msgstr "No início do combate, o líder da sua pilha traz {NumberOfSpheres} <<m:{GLOBAL.UNITS.DEVASTATOR_SPHERE_UNIT}>>."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@BRING_IN_DEVASTATORS@NAME"
msgstr "Trazendo Devastadores"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@CHAINED_BASILISK@DESCRIPTION"
msgstr "O Basilisco Primordial inicia a batalha {GLOBAL.PROPERTIES.STUNNED.Hyperlink} por {timer} {GLOBAL.TurnConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@CHAINED_BASILISK@NAME"
msgstr "Basilisco Acorrentado"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@CINDER_STORM@DESCRIPTION"
msgstr "A cada {value} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, a Mariposa Primordial bate suas asas, fazendo com que uma das unidades atacantes fique {GLOBAL.PROPERTIES.BLINDED.Hyperlink} por {BlindValue} <<m:{GLOBAL.TurnConcept.Hyperlink}>> e {GLOBAL.PROPERTIES.BURNING.Hyperlink} por {BurnValue} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@CINDER_STORM@NAME"
msgstr "Tempestade de Cinzas"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@CLAY_REBIRTH@DESCRIPTION"
msgstr "Os soldados de argila defensores ganham {GLOBAL.PROPERTIES.FIERY_REBIRTH.Hyperlink}."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@CLAY_REBIRTH@NAME"
msgstr "Criados por chamas primordiais"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@DELAYED_SURGE@DESCRIPTION"
msgstr "A cada {value} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, todas as unidades atacantes têm {chance} de chance de sofrer Carga Volátil."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@DELAYED_SURGE@NAME"
msgstr "Onda Volátil Tardia"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@DEMORALIZED_DEFENDERS@DESCRIPTION"
msgstr "No início do combate, todas as unidades defensoras ganham {numberOfStacks} pilhas de {GLOBAL.PROPERTIES.DEMORALIZED.Hyperlink} até o fim do combate."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@DEMORALIZED_DEFENDERS@NAME"
msgstr "Defensores Desmoralizados"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@DISPERSE_DEFENDERS@DESCRIPTION"
msgstr "No início do combate, metade das unidades de Lithorine defensoras se tornam {GLOBAL.PROPERTIES.HASTENED.Hyperlink} por {value} <<m:{GLOBAL.TurnConcept.Hyperlink}>> e metade delas se tornam {GLOBAL.PROPERTIES.SLOWED.Hyperlink} por {value} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@DISPERSE_DEFENDERS@NAME"
msgstr "Dispersar Defensores"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@ELEMENTAL_ATTUNEMENT@DESCRIPTION"
msgstr "Todas as {GLOBAL.PROPERTIES.ELEMENTAL.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> ganham {GLOBAL.PROPERTIES.ELEMENTAL_ATTUNEMENT_UNITPROP.Hyperlink} até o fim do combate."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@ELEMENTAL_ATTUNEMENT@NAME"
msgstr "Sintonia Elemental"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@ELEMENTAL_ATTUNEMENT@PROPERTY_DESCRIPTION"
msgstr "Quando um {GLOBAL.SpellConcept.Hyperlink} é conjurado, o ataque base desta unidade ganha +{amount} de dano baseado na {GLOBAL.AffinityConcept.Hyperlink} do feitiço:[bulletlist][bullet/]{GLOBAL.OrderConcept.Hyperlink} - {GLOBAL.SpiritDamageConcept.Hyperlink}[bullet/]{GLOBAL.ChaosConcept.Hyperlink} - {GLOBAL.FireDamageConcept.Hyperlink}[bullet/]{GLOBAL.AstralConcept.Hyperlink} - {GLOBAL.LightningDamageConcept.Hyperlink}[bullet/]{GLOBAL.MateriumConcept.Hyperlink} - {GLOBAL.PhysicalDamageConcept.Hyperlink}[bullet/]{GLOBAL.NatureConcept.Hyperlink} - {GLOBAL.BlightDamageConcept.Hyperlink}[bullet/]{GLOBAL.ShadowConcept.Hyperlink} - {GLOBAL.FrostDamageConcept.Hyperlink}[/bulletlist][br/]Acumula até {STAR_BLADES_STATUS_DESCRIPTION>MaxStacks} vezes.[br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@GIANTS_BLESSING@DESCRIPTION"
msgstr "A cada {GLOBAL.TurnConcept.Hyperlink}, uma das unidades defensoras que ainda não foi alvo ganha o {GLOBAL.PROPERTIES.SUPERGROWTH_PROPERTY_GROUP.Hyperlink} {GLOBAL.RaceTransformationConcept.Hyperlink} e se cura até o <<m:{GLOBAL.HitPointConcept.Hyperlink}>> completo."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@GIANTS_BLESSING@NAME"
msgstr "Bênção do Gigante"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@GIANTS_BLESSING_ATTACKERS@DESCRIPTION"
msgstr "A cada {GLOBAL.TurnConcept.Hyperlink}, uma das unidades atacantes que ainda não foi alvo ganha o {GLOBAL.PROPERTIES.SUPERGROWTH_PROPERTY_GROUP.Hyperlink} {GLOBAL.RaceTransformationConcept.Hyperlink} e se cura até o <<m:{GLOBAL.HitPointConcept.Hyperlink}>> completo."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@GIANTS_JUDGEMENT@DESCRIPTION"
msgstr "Os ataques do seu Governante Gigante infligem {GLOBAL.PROPERTIES.REMORSE.Hyperlink} por {NumberOfTurns} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@GIANTS_JUDGEMENT@NAME"
msgstr "Julgamento do Gigante"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@GIANT_DISTRACTION_TACTICS@DESCRIPTION"
msgstr "Os ataques {GLOBAL.FlankingConcept.Hyperlink} das unidades atacantes têm {chance} de chance de infligir {GLOBAL.PROPERTIES.DISTRACTED.Hyperlink}."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@GIANT_DISTRACTION_TACTICS@NAME"
msgstr "Táticas de Distração do Gigante"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@GIANT_SLAYING_LEGEND@DESCRIPTION"
msgstr "O {GLOBAL.PROPERTIES.EXPEDITION_LEADER.Hyperlink} ganha a propriedade {GLOBAL.SKILLS.HUNTERS_CROSSBOW_SKILL.Hyperlink}."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@GIANT_SLAYING_LEGEND@NAME"
msgstr "Lenda de Matador de Gigantes"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@INFERNAL_FEED@DESCRIPTION"
msgstr "Toda vez que os Invasores Infernais geram uma unidade, seu Líder de Expedição ganha {StackCount} acúmulos de {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} por {timer} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@INFERNAL_FEED@NAME"
msgstr "Alimentação Infernal"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@INFERNAL_INVADERS@DESCRIPTION"
msgstr "A cada {timer} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, enquanto o Cão Primordial defensor estiver vivo, um Demônio defensor de nível {tiers} surge perto dele. Essas unidades duram até o fim do combate."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@INFERNAL_INVADERS@NAME"
msgstr "Invasores Infernais"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@LITHORITE_DISRUPTION@DESCRIPTION"
msgstr "Metade das unidades de Lithorine defensoras começam a batalha {GLOBAL.PROPERTIES.STUNNED.Hyperlink} por {value} {GLOBAL.TurnConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@LITHORITE_DISRUPTION@NAME"
msgstr "Perturbação Lithorita"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@LITHORITE_RECOMBINATION@DESCRIPTION"
msgstr "Enquanto o Sangueprimordial Costas-de-Pedra estiver vivo, sempre que uma Unidade Litorina de Nível 1 a 3 defensora morrer, se houver outro Cadáver de Litorina no mapa, ressuscite-o como uma Unidade Litorina de nível 1 acima da Unidade Litorina que acabou de morrer."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@LITHORITE_RECOMBINATION@NAME"
msgstr "Reciclagem de Lascas de Pedra"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@PUNY_SLAYING@DESCRIPTION"
msgstr "Todas as unidades defensoras ganham {GLOBAL.PROPERTIES.PUNY_SLAYER.Hyperlink} até o fim do combate."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@PUNY_SLAYING@NAME"
msgstr "Matança de Frágeis"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@REVERSE_GROWTH@DESCRIPTION"
msgstr "A cada {GLOBAL.TurnConcept.Hyperlink}, uma das unidades defensoras que ainda não foi alvo ganha {GLOBAL.PROPERTIES.SPAWNKIN_PROPERTY_GROUP.Hyperlink} {GLOBAL.RaceTransformationConcept.Hyperlink} e tem seu Máximo de {GLOBAL.HitPointConcept.Hyperlink} reduzido em {ReducedHealth}."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@REVERSE_GROWTH@NAME"
msgstr "Maldição dos Frágeis"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@SLOWED_INVADERS@DESCRIPTION"
msgstr "Unidades invocadas por Invasores Infernais sofrem {GLOBAL.PROPERTIES.SLOWED.Hyperlink} por {timer} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@SLOWED_INVADERS@NAME"
msgstr "Invasores Desacelerados"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@STAND_TOGETHER@DESCRIPTION"
msgstr "Todas as unidades atacantes ganham {GLOBAL.PROPERTIES.STAND_TOGETHER.Hyperlink} até o fim do combate."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@STAND_TOGETHER@NAME"
msgstr "Juntos Resistimos"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@STOKED_FIRE@DESCRIPTION"
msgstr "As unidades de argila defensoras iniciam o combate {GLOBAL.PROPERTIES.BURNING.Hyperlink}."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@STOKED_FIRE@NAME"
msgstr "Fogo Atiçado"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@STOP_UNDYING@DESCRIPTION"
msgstr "Todos os soldados de argila defensores não podem usar sua habilidade {GLOBAL.PROPERTIES.UNDYING.Hyperlink} e {GLOBAL.PROPERTIES.FIERY_REBIRTH.Hyperlink}."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@STOP_UNDYING@NAME"
msgstr "Ressurreição Selada"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@TAUNTED_SENTRIES@DESCRIPTION"
msgstr "Cada unidade defensora é {GLOBAL.PROPERTIES.TAUNTED.Hyperlink} por uma unidade atacante aleatória até o fim da batalha."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@TAUNTED_SENTRIES@NAME"
msgstr "Sentinelas Provocadas"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@UNDYING_BATTLEFIELD@DESCRIPTION"
msgstr "A cada {GLOBAL.TurnConcept.Hyperlink}, cada cadáver é ressuscitado como uma Unidade Esqueleto aleatória com {GLOBAL.PROPERTIES.BERSERK.Hyperlink}.[br/][br/]. Unidades Esqueleto não são ressuscitadas por esse efeito, são {GLOBAL.PROPERTIES.NON_VITAL.Hyperlink} e morrem ao fim do combate."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@UNDYING_BATTLEFIELD@NAME"
msgstr "Campo de Batalha Imortal"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@VOLATILE_SURGE@DESCRIPTION"
msgstr "A cada {value} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, todas as unidades atacantes têm {Chance}% de chance de sofrer {GLOBAL.PROPERTIES.VOLATILE_CHARGE.Hyperlink}."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@VOLATILE_SURGE@NAME"
msgstr "Surto Volátil"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@VOLATILE_WAVE@DESCRIPTION"
msgstr "A cada {turn} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, todas as unidades atacantes têm {Chance} de chance de sofrer {GLOBAL.PROPERTIES.VOLATILE_CHARGE.Hyperlink}, a menos que já sofram desse efeito. {GLOBAL.PROPERTIES.VOLATILE_CHARGE.Hyperlink} expira em {turn2} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@VOLATILE_WAVE@NAME"
msgstr "Onda Volátil"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@VOLATILE_WAVE@UNLOCK"
msgstr "Onda Volátil durante o combate"

msgid "DLC@GIANTKINGS@CRISIS@1167_878@DESCRIPTION"
msgstr "Os {GLOBAL.EternalSagesLoreConcept.Hyperlink} buscam se comunicar com seus parentes através do {GLOBAL.AstralSeaLoreConcept.Hyperlink}. Eles contrataram alguém com o poder de um {GLOBAL.GodirLoreConcept.Hyperlink} para atuar como seu Médium."

msgid "DLC@GIANTKINGS@CRISIS@1167_878@DESCRIPTION_ACTIVE"
