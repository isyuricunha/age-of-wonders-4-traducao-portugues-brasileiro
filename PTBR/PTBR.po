msgid "COMBATPROPERTIES_TACTICAL@ORDER_OF_GLUTTON_ABILITY@DESCRIPTION"
msgstr "Consuma comida para ganhar 1 pilha de {GLOBAL.PROPERTIES.COMBATPROPERTY_DEVOURED_POWER.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@ORDER_OF_GLUTTON_ABILITY@NAME"
msgstr "Devorar Comida"

msgid "COMBATPROPERTIES_TACTICAL@ORDER_OF_GLUTTON_CONDEMN@DESCRIPTION"
msgstr "Todas as unidades defensoras sofrem {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink} até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@ORDER_OF_GLUTTON_CONDEMN@NAME"
msgstr "Defensores Condenados"

msgid "COMBATPROPERTIES_TACTICAL@ORDER_OF_GLUTTON_DEVOURED_POWER@DESCRIPTION"
msgstr "[bulletlist][bullet/]Máx. de <<m:{GLOBAL.HitPointConcept.Hyperlink}>> aumentado em {value}. [bullet/]Ganha 1 pilha de {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}.[/bulletlist]"

msgid "COMBATPROPERTIES_TACTICAL@ORDER_OF_GLUTTON_DEVOURED_POWER@NAME"
msgstr "Poder Devorado"

msgid "COMBATPROPERTIES_TACTICAL@ORDER_OF_GLUTTON_HASTENED@DESCRIPTION"
msgstr "No início da batalha, todas as unidades atacantes têm {GLOBAL.PROPERTIES.HASTENED.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@ORDER_OF_GLUTTON_HASTENED@NAME"
msgstr "Atacantes Acelerados"

msgid "COMBATPROPERTIES_TACTICAL@ORDER_OF_GLUTTON_NO_GORGING@DESCRIPTION"
msgstr "O Karagh não pode usar sua habilidade {GLOBAL.PROPERTIES.TERRIFYING_GORGING.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@ORDER_OF_GLUTTON_NO_GORGING@NAME"
msgstr "Pouco Apetitoso"

msgid "COMBATPROPERTIES_TACTICAL@ORDER_OF_GLUTTON_POISON@DESCRIPTION"
msgstr "Envenene a comida dos Karaghs, fazendo com que o Karagh ganhe 1 pilha de {GLOBAL.PROPERTIES.POISONED.Hyperlink} e {GLOBAL.PROPERTIES.DISEASED.Hyperlink} sempre que comer um caixote de comida."

msgid "COMBATPROPERTIES_TACTICAL@ORDER_OF_GLUTTON_POISON@NAME"
msgstr "Comida Envenenada"

msgid "COMBATPROPERTIES_TACTICAL@OUT_OF_CONTROL_STORM@DESCRIPTION"
msgstr "Nos primeiros {numOfTurns} {GLOBAL.TurnConcept.Hyperlink}, a Tempestade de Raios só atingirá as unidades defensoras."

msgid "COMBATPROPERTIES_TACTICAL@OUT_OF_CONTROL_STORM@NAME"
msgstr "Manipulação da Tempestade"

msgid "COMBATPROPERTIES_TACTICAL@POISONED_TREE@DESCRIPTION"
msgstr "Esta árvore foi afetada por uma praga e está secretando veneno![br/][bulletlist][bullet/]Todos os obstáculos de Flora são venenosos.[bullet/]A cada {wait} <<m:{GLOBAL.TurnConcept}>>, todas as unidades atacantes têm uma chance base de {chance} de sofrer {GLOBAL.PROPERTIES.POISONED.Hyperlink} por {duration} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "COMBATPROPERTIES_TACTICAL@POISONED_TREE@NAME"
msgstr "Árvore Envenenada"

msgid "COMBATPROPERTIES_TACTICAL@POISON_ANTIDOTES@DESCRIPTION"
msgstr "Até o fim do combate, todas as habilidades de suporte das unidades atacantes dissiparão {GLOBAL.PROPERTIES.POISONED.Hyperlink} no(s) alvo(s)."

msgid "COMBATPROPERTIES_TACTICAL@POISON_ANTIDOTES@NAME"
msgstr "Antídotos contra Veneno"

msgid "COMBATPROPERTIES_TACTICAL@PREDICTED_CRASHING_RUBBLE@NAME"
msgstr "Queda de Escombros Previsível"

msgid "COMBATPROPERTIES_TACTICAL@PRIMA_MATERIA@DESCRIPTION"
msgstr "Todos os Golems defensores ganham {GLOBAL.PROPERTIES.FIERY_REBIRTH.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@PRIMA_MATERIA@NAME"
msgstr "Reconstrução Ígnea"

msgid "COMBATPROPERTIES_TACTICAL@PRIMA_MATERIA_ATTACK_REBIRTH@DESCRIPTION"
msgstr "Todas as unidades atacantes de Nível 1 a 3 ganham {GLOBAL.PROPERTIES.FIERY_REBIRTH.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@PRIMA_MATERIA_ATTACK_REBIRTH@NAME"
msgstr "Renascimento Menor"

msgid "COMBATPROPERTIES_TACTICAL@PRIMA_MATERIA_FIRE_RES@DESCRIPTION"
msgstr "Todas as unidades atacantes iniciam o combate com {value} {GLOBAL.FireResistanceConcept.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@PRIMA_MATERIA_FIRE_RES@NAME"
msgstr "Resistência ao Fogo Avançada"

msgid "COMBATPROPERTIES_TACTICAL@PRIMA_MATERIA_GILDED@DESCRIPTION"
msgstr "A cada {value} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, um Golem no lado defensor se torna {GLOBAL.PROPERTIES.GILDED.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@PRIMA_MATERIA_GILDED@NAME"
msgstr "Constructo Dourado"

msgid "COMBATPROPERTIES_TACTICAL@PRIMA_MATERIA_NO_FIRE@DESCRIPTION"
msgstr "Todos os Golems defensores ganham {GLOBAL.PROPERTIES.FIERY_REBIRTH.Hyperlink}, mas o {GLOBAL.PROPERTIES.FIERY_REBIRTH.Hyperlink} não causa {GLOBAL.FireDamageConcept.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@PRIMA_MATERIA_NO_FIRE@NAME"
msgstr "Reconstrução Resfriada"

msgid "COMBATPROPERTIES_TACTICAL@PRIMA_MATERIA_RETALIATION@DESCRIPTION"
msgstr "Todas as unidades atacantes ganham {GLOBAL.PROPERTIES.HS_DEFENSE_DEFENSE.Hyperlink} extra contra <<m:{GLOBAL.RetaliationConcept.Name}>>."

msgid "COMBATPROPERTIES_TACTICAL@PRIMA_MATERIA_RETALIATION@NAME"
msgstr "Reorganizar Tropas"

msgid "COMBATPROPERTIES_TACTICAL@RAINFALL@DESCRIPTION"
msgstr "Chuva contínua torna todas as unidades {GLOBAL.PROPERTIES.WET.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@RAINFALL@NAME"
msgstr "Precipitação"

msgid "COMBATPROPERTIES_TACTICAL@RAMPANT_FLORA@DESCRIPTION"
msgstr "Há vários obstáculos de flora {GLOBAL.ObscuringConcept.Hyperlink} extras presentes no combate."

msgid "COMBATPROPERTIES_TACTICAL@RAMPANT_FLORA@NAME"
msgstr "Flora Exuberante"

msgid "COMBATPROPERTIES_TACTICAL@RAZED@DESCRIPTION"
msgstr "Este local foi arrasado ou saqueado. Muitos obstáculos estão danificados, destruídos ou em chamas."

msgid "COMBATPROPERTIES_TACTICAL@RAZED@NAME"
msgstr "Arrasado"

msgid "COMBATPROPERTIES_TACTICAL@REVEALED_TRAPS@DESCRIPTION"
msgstr "Várias armadilhas foram reveladas no mapa! Se uma unidade passar por cima delas, sofrerá {GLOBAL.PROPERTIES.BLEEDING.Hyperlink} por {turns} <<m:{GLOBAL.TurnConcept}>> e revelará a armadilha! [br/][br/]Não afeta unidades {GLOBAL.PROPERTIES.FLOATING_MOVEMENT.Hyperlink}, {GLOBAL.PROPERTIES.FLYING_MOVEMENT.Hyperlink} ou {GLOBAL.PROPERTIES.ETHEREAL.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@REVEALED_TRAPS@NAME"
msgstr "Armadilhas Reveladas"

msgid "COMBATPROPERTIES_TACTICAL@SEIZED_DEMONIC_SUMMONING@DESCRIPTION"
msgstr "O atacante tomou o controle do ritual! Em {turns} [turn/], um {GLOBAL.UNITS.BALOR.Hyperlink} com {GLOBAL.PROPERTIES.BERSERK.Hyperlink} se juntará ao atacante até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@SILVERTONGUE_WHISPERS@DESCRIPTION"
msgstr "A cada {turn} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, uma das unidades atacantes tem {chance}% de chance base de sofrer {GLOBAL.PROPERTIES.DISTRACTED.Hyperlink} até o fim do combate."

msgid "COMBATPROPERTIES_TACTICAL@SILVERTONGUE_WHISPERS@NAME"
msgstr "Sussurros Distraentes"

msgid "COMBATPROPERTIES_TACTICAL@SILVER_KNIGHT@DESCRIPTION"
msgstr "O duelista sofre dano reduzido de todas as unidades, exceto do líder da pilha do exército inimigo."

msgid "COMBATPROPERTIES_TACTICAL@SILVER_KNIGHT@NAME"
msgstr "Proteção do Duelista"

msgid "COMBATPROPERTIES_TACTICAL@SILVER_KNIGHT_TAUNT@DESCRIPTION"
msgstr "Os exércitos atacantes {GLOBAL.PROPERTIES.EXPEDITIONLEADER.Hyperlink} <<m:{GLOBAL.PROPERTIES.TAUNT.Hyperlink}>> o Cavaleiro Prateado até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@SILVER_KNIGHT_TAUNT@NAME"
msgstr "Provocando o Cavaleiro"

msgid "COMBATPROPERTIES_TACTICAL@SKELETON_SUMMON_ON_DEATH@DESCRIPTION"
msgstr "Sempre que um obstáculo Sarcófago é destruído, ele invoca um {GLOBAL.UNITS.SKELETON_UNIT.Hyperlink} no lado do defensor até o fim do combate."

msgid "COMBATPROPERTIES_TACTICAL@SKELETON_SUMMON_ON_DEATH@NAME"
msgstr "Caixões Assombrados"

msgid "COMBATPROPERTIES_TACTICAL@SLAVE_REVOLT@DESCRIPTION"
msgstr "No início da batalha, algumas unidades de Cão de Guerra afetadas por {GLOBAL.PROPERTIES.BERSERK.Hyperlink} se juntam ao combate adjacentes às unidades defensoras."

msgid "COMBATPROPERTIES_TACTICAL@SLAVE_REVOLT@NAME"
msgstr "Animais Fugitivos"

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_INSANE_IMMUNITY@DESCRIPTION"
msgstr "Todas as unidades atacantes são imunes a {GLOBAL.PROPERTIES.INSANITY.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_INSANE_IMMUNITY@NAME"
msgstr "Estabilidade Mental"

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_IN_SHADOW@DESCRIPTION"
msgstr "A cada {GLOBAL.TurnConcept.Hyperlink}, 1 unidade atacante é alvo; se ela tiver {GLOBAL.LowMoraleConcept.Hyperlink}, ganha {GLOBAL.PROPERTIES.INSANITY.Hyperlink}, caso contrário, perde {value} {GLOBAL.UnitMoraleConcept.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_IN_SHADOW@NAME"
msgstr "Presença do Rei Morto"

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_IN_SHADOW_DISTRACTED@DESCRIPTION"
msgstr "Fica imune ao efeito {GLOBAL.PROPERTIES.SLOWED.Hyperlink} do Rei Morto, mas inicia o combate {GLOBAL.PROPERTIES.DISTRACTED.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_IN_SHADOW_DISTRACTED@NAME"
msgstr "Imunidade a Lentidão"

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_IN_SHADOW_FROST_RESISTANCE@DESCRIPTION"
msgstr "Todas as unidades atacantes iniciam o combate com {value} {GLOBAL.FrostResistanceConcept.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_IN_SHADOW_FROST_RESISTANCE@NAME"
msgstr "Resistência ao Gelo"

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_IN_SHADOW_INSANE_IMMUNE@DESCRIPTION"
msgstr "Esta unidade é imune a {GLOBAL.PROPERTIES.INSANITY.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_IN_SHADOW_INSANE_IMMUNE@NAME"
msgstr "Imunidade à Insanidade"

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_IN_SHADOW_RALLY@DESCRIPTION"
msgstr "As habilidades de apoio dos atacantes concedem um efeito {GLOBAL.PROPERTIES.RALLYING.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_IN_SHADOW_RALLY@NAME"
msgstr "Apoio Motivador"

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_IN_SHADOW_SLOWED@DESCRIPTION"
msgstr "O Rei Morto causa {GLOBAL.PROPERTIES.SLOWED.Hyperlink} em acertos."

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_IN_SHADOW_SLOWED@NAME"
msgstr "Letargia"

msgid "COMBATPROPERTIES_TACTICAL@SLOWED_ARMY@DESCRIPTION"
msgstr "No início da batalha, todas as unidades atacantes têm {GLOBAL.PROPERTIES.SLOWED.Hyperlink} por {time} [turn/]."

msgid "COMBATPROPERTIES_TACTICAL@SLOWED_ARMY@NAME"
msgstr "Atacantes Lentificados"

msgid "COMBATPROPERTIES_TACTICAL@SLOWED_ENEMIES@DESCRIPTION"
msgstr "No início da batalha, todas as unidades defensoras têm {GLOBAL.PROPERTIES.SLOWED.Hyperlink} por {time} [turn/]."

msgid "COMBATPROPERTIES_TACTICAL@SLOWED_ENEMIES@NAME"
msgstr "Defensores Lentificados"

msgid "COMBATPROPERTIES_TACTICAL@SLUMBERING_SOULS@DESCRIPTION"
msgstr "A cada {time} [turn/], uma unidade atacante se torna {GLOBAL.PROPERTIES.HAUNTED.Hyperlink}.[br/][br/]Se uma unidade {GLOBAL.PROPERTIES.HAUNTED.Hyperlink} estiver adjacente a um obstáculo Sarcófago, o Sarcófago é destruído e invocará um Esqueleto {GLOBAL.UnitConcept.Hyperlink} no lado do defensor."

msgid "COMBATPROPERTIES_TACTICAL@SLUMBERING_SOULS@NAME"
msgstr "Esqueletos Agitados"

msgid "COMBATPROPERTIES_TACTICAL@SLUMBERING_SOULS@PROPERTY@DESCRIPTION"
msgstr "Quando este efeito expirar, qualquer obstáculo Sarcófago adjacente será destruído e invocará uma unidade Esqueleto {GLOBAL.UnitConcept.Hyperlink} no lado do defensor."

msgid "COMBATPROPERTIES_TACTICAL@SLUMBERING_SOULS@PROPERTY@NAME"
msgstr "Assombrado"

msgid "COMBATPROPERTIES_TACTICAL@SLUMBERING_SOULS_DELAYED@NAME"
msgstr "Esqueletos Agitados Tardios"

msgid "COMBATPROPERTIES_TACTICAL@SOOTHING_WELLSPRING@DESCRIPTION"
msgstr "Unidades que estão {GLOBAL.PROPERTIES.WET.Hyperlink} recuperam 5 [hp/] Pontos de Vida no início do turno delas."

msgid "COMBATPROPERTIES_TACTICAL@SOOTHING_WELLSPRING@NAME"
msgstr "Nascente Calmante"

msgid "COMBATPROPERTIES_TACTICAL@SPELL@DESCRIPTION"
msgstr "Adiciona {combatproperty} à batalha."

msgid "COMBATPROPERTIES_TACTICAL@SPIDERLAIR@DESCRIPTION"
msgstr "No início do combate, vários obstáculos Teia de Aranha {GLOBAL.SlowingConcept.Hyperlink} estão presentes."

msgid "COMBATPROPERTIES_TACTICAL@SPIDERLAIR@NAME"
msgstr "Teias de Aranha Expansivas"

msgid "COMBATPROPERTIES_TACTICAL@SPLITTING_MAGMA@DESCRIPTION"
msgstr "Quando uma unidade defensora {GLOBAL.UNITS.MAGMA_SPIRIT.Hyperlink} é derrotada, ela gera {amount} <<m:{GLOBAL.UNITS.LESSER_MAGMA_SPIRIT.Hyperlink}>>."

msgid "COMBATPROPERTIES_TACTICAL@SPLITTING_MAGMA@NAME"
msgstr "Divisão de Magma"

msgid "COMBATPROPERTIES_TACTICAL@SPRINGS_GROWTH@DESCRIPTION"
msgstr "Cada vez que as unidades do dono sofrem dano, elas ganham {amount} pilha(s) de {GLOBAL.PROPERTIES.REGENERATION.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@SPRINGS_GROWTH@NAME"
msgstr "Crescimento Primaveril"

msgid "COMBATPROPERTIES_TACTICAL@SPRINGS_GROWTH@SPELL_DESCRIPTION"
msgstr "Adiciona {GLOBAL.PROPERTIES.COMBATPROPERTY_FEY_SPRING.Hyperlink} à batalha."

msgid "COMBATPROPERTIES_TACTICAL@STATUS_RESISTANCE_ARMY@DESCRIPTION"
msgstr "Unidades atacantes têm {amount}{GLOBAL.StatusResistanceConcept.Hyperlink} até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@STATUS_RESISTANCE_ENEMIES@DESCRIPTION"
msgstr "Unidades defensoras têm {amount}{GLOBAL.StatusResistanceConcept.Hyperlink} até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@STRENGTHENED_ARMY@DESCRIPTION"
msgstr "Todos os ataques das unidades atacantes causam {damage} de dano até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@STRENGTHENED_ARMY@NAME"
msgstr "Atacantes Fortalecidos"

msgid "COMBATPROPERTIES_TACTICAL@STRENGTHENED_ENEMIES@DESCRIPTION"
msgstr "Todos os ataques das unidades defensoras causam {damage} de dano até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@STRENGTHENED_ENEMIES@NAME"
msgstr "Defensores Fortalecidos"

msgid "COMBATPROPERTIES_TACTICAL@SUMMERS_HEAT@DESCRIPTION"
msgstr "No início do turno do dono, unidades inimigas adjacentes às unidades do dono têm {chance}% de chance de sofrer {GLOBAL.PROPERTIES.BURNING.Hyperlink} e sofrem {damage} para cada pilha de {GLOBAL.PROPERTIES.BURNING.Hyperlink} que tiverem."

msgid "COMBATPROPERTIES_TACTICAL@SUMMERS_HEAT@NAME"
msgstr "Calor do Verão"

msgid "COMBATPROPERTIES_TACTICAL@SUNDERED_ARMOR_ARMY@DESCRIPTION"
msgstr "Todas as unidades atacantes têm {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink} até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@SUNDERED_ARMOR_ARMY@NAME"
msgstr "Atacantes Indefesos"

msgid "COMBATPROPERTIES_TACTICAL@SUNDERED_ARMOR_ENEMIES@DESCRIPTION"
msgstr "Todas as unidades defensoras têm {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink} até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@SUNDERED_ARMOR_ENEMIES@NAME"
msgstr "Defensores Indefesos"

msgid "COMBATPROPERTIES_TACTICAL@SUNDERED_RESISTANCE_ARMY@DESCRIPTION"
msgstr "Todas as unidades atacantes têm {GLOBAL.PROPERTIES.SUNDERED_RESISTANCE.Hyperlink} até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@SUNDERED_RESISTANCE_ARMY@NAME"
msgstr "Atacantes Vulneráveis"

msgid "COMBATPROPERTIES_TACTICAL@SUNDERED_RESISTANCE_ENEMIES@DESCRIPTION"
msgstr "Todas as unidades defensoras têm {GLOBAL.PROPERTIES.SUNDERED_RESISTANCE.Hyperlink} até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@SUNDERED_RESISTANCE_ENEMIES@NAME"
msgstr "Defensores Vulneráveis"

msgid "COMBATPROPERTIES_TACTICAL@SUNDERED_STATUS_RESISTANCE_ARMY@NAME"
msgstr "Resistência a Efeitos Reduzida dos Atacantes"

msgid "COMBATPROPERTIES_TACTICAL@SUNDERED_STATUS_RESISTANCE_ENEMIES@NAME"
msgstr "Resistência a Efeitos Reduzida dos Defensores"

msgid "COMBATPROPERTIES_TACTICAL@THE_ONE@DESCRIPTION"
msgstr "A cada {GLOBAL.TurnConcept.Hyperlink}, as unidades do atacante perdem {MoraleValue} de moral."

msgid "COMBATPROPERTIES_TACTICAL@THE_ONE@NAME"
msgstr "O Lamento"

msgid "COMBATPROPERTIES_TACTICAL@UNDEADQUEEN@DESCRIPTION"
msgstr "Matar a Rainha Morta-Viva matará imediatamente todos os seus [abilityred]Servos Mortos-Vivos[/abilityred]."

msgid "COMBATPROPERTIES_TACTICAL@UNDEADQUEEN@NAME"
msgstr "Rainha Morta-Viva"

msgid "COMBATPROPERTIES_TACTICAL@WAVE_OF_TRANQUILITY@DESCRIPTION"
msgstr "A cada {turn} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, todos os Efeitos de Status em todas as unidades são dissipados."

msgid "COMBATPROPERTIES_TACTICAL@WAVE_OF_TRANQUILITY@NAME"
msgstr "Onda de Tranquilidade"

msgid "COMBATPROPERTIES_TACTICAL@WEAKENED_ARMY@DESCRIPTION"
msgstr "Todas as unidades atacantes ficam {GLOBAL.PROPERTIES.WEAKENED.Hyperlink} até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@WEAKENED_ARMY@NAME"
msgstr "Atacantes Enfraquecidos"

msgid "COMBATPROPERTIES_TACTICAL@WEAKENED_ENEMIES@DESCRIPTION"
msgstr "Todas as unidades defensoras ficam {GLOBAL.PROPERTIES.WEAKENED.Hyperlink} até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@WEAKENED_ENEMIES@NAME"
msgstr "Defensores Enfraquecidos"

msgid "COMBATPROPERTIES_TACTICAL@WINTERS_SORROW@DESCRIPTION"
msgstr "Unidades inimigas sofrem {amount} pilha(s) de {GLOBAL.PROPERTIES.DEMORALIZED.Hyperlink} sempre que matarem outra unidade."

msgid "COMBATPROPERTIES_TACTICAL@WINTERS_SORROW@NAME"
msgstr "Tristeza do Inverno"

msgid "COMBAT_TUTORIAL@ACCURACY@DESCRIPTION"
msgstr "Este {GLOBAL.UnitConcept.Hyperlink} tem uma habilidade de ataque à distância selecionada. Habilidades de ataque à distância têm uma classificação de {GLOBAL.AccuracyConcept}, que é a chance da habilidade acertar o alvo pretendido."

msgid "COMBAT_TUTORIAL@ACCURACY@DESCRIPTION_SECONDARY"
msgstr "Se uma habilidade errar, ela atingirá outro alvo ou não fará nada. Algumas habilidades também podem \"raspar\", o que significa que afetaram o alvo, mas com força reduzida."

msgid "COMBAT_TUTORIAL@ACCURACY@TITLE"
msgstr "Precisão"

msgid "COMBAT_TUTORIAL@ACTION_POINTS@DESCRIPTION"
msgstr "Você selecionou um {GLOBAL.UnitConcept.Hyperlink}. Ele tem 3 <<m:{GLOBAL.ActionPointConcept}>> para gastar em movimento e uso de habilidades."

msgid "COMBAT_TUTORIAL@ACTION_POINTS@DESCRIPTION_SECONDARY"
msgstr "Habilidades diferentes têm custos diferentes de [actionpoint/] pontos de ação, e algumas são acionadas uma vez por ponto de ação disponível. Usar uma habilidade quase sempre encerrará o turno de uma unidade![br/][br/]Ao planejar o movimento, você pode ver o número de [fullaction/] pontos de ação que terá disponível no destino."

msgid "COMBAT_TUTORIAL@ACTION_POINTS@TITLE"
msgstr "Pontos de Ação"

msgid "COMBAT_TUTORIAL@AI_TAKEOVER_NPC@DESCRIPTION"
msgstr "Você assumiu temporariamente o comando de um exército Independente.[br/][br/]Enquanto estiver no controle de um {GLOBAL.IndependentCityConcept.Hyperlink} ou <<m:GLOBAL.MarauderConcept.Hyperlink>>, você poderá dar ordens aos seus <<m:GLOBAL.UnitConcept.Hyperlink>>. A habilidade de lançar <<m:GLOBAL.CombatSpellConcept.Hyperlink>> fica desativada durante o turno Independente."

msgid "COMBAT_TUTORIAL@AI_TAKEOVER_NPC@TITLE"
msgstr "Tomada de Controle em Combate: Independentes"

msgid "COMBAT_TUTORIAL@AI_TAKEOVER_PLAYER@DESCRIPTION"
msgstr "Você assumiu temporariamente o comando de um exército pertencente a um {GLOBAL.LeaderConcept.Hyperlink} da IA.[br/][br/]Ao assumir o controle de um Governante da IA, você pode comandar seus <<m:GLOBAL.UnitConcept.Hyperlink>> e usar seus <<m:GLOBAL.CombatSpellConcept.Hyperlink>> durante o combate."

msgid "COMBAT_TUTORIAL@AI_TAKEOVER_PLAYER@TITLE"
msgstr "Tomada de Combate: Governante da IA"

msgid "COMBAT_TUTORIAL@BATTLE_MAGE_UNITS@DESCRIPTION"
msgstr "Este é um Mago de Batalha {GLOBAL.UnitConcept.Hyperlink}, que se destaca em causar dano mágico e aplicar efeitos de status. Ele é vulnerável a ataques de {GLOBAL.MeleeConcept} e deve ser mantido na linha de trás."

msgid "COMBAT_TUTORIAL@BATTLE_MAGE_UNITS@TITLE"
msgstr "Unidades de Mago de Batalha [unitBattleMage/]"

msgid "COMBAT_TUTORIAL@CASUALTIES@DESCRIPTION"
msgstr "Este {GLOBAL.UnitConcept.Hyperlink} sofreu <<m:{GLOBAL.CasualtyConcept}>>. Baixas ocorrem quando uma unidade recebe dano, o que também faz com que ela cause menos dano com seus ataques."

msgid "COMBAT_TUTORIAL@CASUALTIES@DESCRIPTION_SECONDARY"
msgstr "Unidades representadas por uma única figura, como <<m:{GLOBAL.HeroConcept}>> e gigantes, são imunes a baixas."

msgid "COMBAT_TUTORIAL@CASUALTIES@TITLE"
msgstr "Baixas"

msgid "COMBAT_TUTORIAL@COMBAT_STARTS@DESCRIPTION"
msgstr "Bem-vindo ao campo de batalha! Aqui, você deve matar ou fazer seus inimigos recuarem para reivindicar a vitória."

msgid "COMBAT_TUTORIAL@COMBAT_STARTS@DESCRIPTION_SECONDARY"
msgstr "O {GLOBAL.ArmyConcept} defensor sempre age primeiro, seguido pelo exército atacante."

msgid "COMBAT_TUTORIAL@COMBAT_STARTS@TITLE"
msgstr "A Batalha Começa"

msgid "COMBAT_TUTORIAL@FLANKING@DESCRIPTION"
msgstr "Seu {GLOBAL.UnitConcept.Hyperlink} acabou de atacar um inimigo pelas costas. Isso é chamado de {GLOBAL.FlankingConcept} e concede um bônus de dano."

msgid "COMBAT_TUTORIAL@FLANKING@DESCRIPTION_SECONDARY"
msgstr "Lembre-se de que unidades em {GLOBAL.DefenseModeConcept.Hyperlink} não podem ser flanqueadas!"

msgid "COMBAT_TUTORIAL@FLANKING@TITLE"
msgstr "Ataques de Flanco"

msgid "COMBAT_TUTORIAL@LEADER@DESCRIPTION"
msgstr "Você selecionou seu {GLOBAL.LeaderConcept}. Seu Governante é um combatente poderoso que pode empunhar equipamentos mágicos e aprender uma variedade de habilidades."

msgid "COMBAT_TUTORIAL@LEADER@DESCRIPTION_SECONDARY"
msgstr "Se seu Governante [hyperlink,GLOBAL.RulerVoidConcept]cair[/hyperlink] em combate, ele retornará ao seu {GLOBAL.ThroneCityConcept.Hyperlink} após um curto período."

msgid "COMBAT_TUTORIAL@LEADER@TITLE"
msgstr "Governantes em Batalha [unitLeader/]"

msgid "COMBAT_TUTORIAL@LOW_MORALE@DESCRIPTION"
msgstr "Um {GLOBAL.UnitConcept.Hyperlink} está com [hyperlink,GLOBAL.LowMoraleConcept]Moral Baixa[/hyperlink], pois a maré da batalha está virando contra ele. Unidades com moral baixa podem {GLOBAL.FumbleConcept} ataques, enquanto moral alta pode levar a [hyperlink,GLOBAL.CriticalHitConcept]Ataques Críticos[/hyperlink]."

msgid "COMBAT_TUTORIAL@LOW_MORALE@DESCRIPTION_SECONDARY"
msgstr "Se a moral de uma unidade cair muito, ela começará a {GLOBAL.RoutingConcept.Hyperlink} e fugirá do campo de batalha."

msgid "COMBAT_TUTORIAL@LOW_MORALE@TITLE"
msgstr "Moral da Unidade"

msgid "COMBAT_TUTORIAL@MAGIC_FIGHTER_UNITS@DESCRIPTION"
msgstr "Esta é uma unidade Lutadora Mágica {GLOBAL.UnitConcept.Hyperlink}, uma lutadora corpo a corpo de linha de frente. Ela se especializa em ataques {GLOBAL.MagicConcept.Hyperlink}, sendo ideal para danificar unidades com alta {GLOBAL.DefenseConcept.Hyperlink} como Unidades com Escudo."

msgid "COMBAT_TUTORIAL@MAGIC_FIGHTER_UNITS@TITLE"
msgstr "[unitMagicFighter/]Unidades Lutadoras Mágicas"

msgid "COMBAT_TUTORIAL@POLEARM_UNIT@DESCRIPTION"
msgstr "Este é um {GLOBAL.UnitConcept.Hyperlink} de Arma de Haste, um combatente corpo a corpo de linha de frente. Com suas habilidades de {GLOBAL.FirstStrikeConcept} e [hyperlink,GLOBAL.ChargeConcept]Resistência a Carga[/hyperlink], ele é perfeito para absorver ataques inimigos de {GLOBAL.MeleeConcept}."

msgid "COMBAT_TUTORIAL@POLEARM_UNIT@TITLE"
msgstr "Unidades de Arma de Haste [unitPolearm/]"

msgid "COMBAT_TUTORIAL@RANGED_UNIT@DESCRIPTION"
msgstr "Esta é uma {GLOBAL.UnitConcept.Hyperlink} de Ataque à Distância, que se destaca em causar dano físico de longe. Ela é vulnerável a ataques de {GLOBAL.MeleeConcept} e deve ser mantida na retaguarda."

msgid "COMBAT_TUTORIAL@RANGED_UNIT@TITLE"
msgstr "[unitRanged/]Unidades de Ataque à Distância"

msgid "COMBAT_TUTORIAL@RETALIATION@DESCRIPTION"
msgstr "Uma {GLOBAL.UnitConcept.Hyperlink} acabou de ser atingida por um {GLOBAL.RetaliationConcept.Hyperlink}. Isso acontece quando uma unidade {GLOBAL.MeleeConcept} é atacada dentro de sua Zona de Controle."

msgid "COMBAT_TUTORIAL@RETALIATION@DESCRIPTION_SECONDARY"
msgstr "Uma unidade tem um número limitado de <<m:{GLOBAL.RetaliationConcept.Hyperlink}>> por turno, indicado por marcas vermelhas abaixo de sua bandeira."

msgid "COMBAT_TUTORIAL@RETALIATION@TITLE"
msgstr "Retaliação"

msgid "COMBAT_TUTORIAL@SCOUT_UNIT@DESCRIPTION"
msgstr "Esta é uma {GLOBAL.UnitConcept.Hyperlink} Batedora, que é frágil e deve ser mantida fora do combate. Se forçada a lutar, sua alta velocidade e ataques à distância a tornam uma boa unidade para {GLOBAL.FlankingConcept}."

msgid "COMBAT_TUTORIAL@SCOUT_UNIT@TITLE"
msgstr "[unitScout/]Unidades Batedoras"

msgid "COMBAT_TUTORIAL@SHIELD_UNIT@DESCRIPTION"
msgstr "Esta é uma {GLOBAL.UnitConcept.Hyperlink} Escudeira, uma lutadora de {GLOBAL.MeleeConcept} de linha de frente. Ao entrar em {GLOBAL.DefenseModeConcept}, ela concede um bônus a aliados adjacentes, protegendo-os contra dano físico."

msgid "COMBAT_TUTORIAL@SHIELD_UNIT@TITLE"
msgstr "[unitShield/]Unidades Escudeiras"

msgid "COMBAT_TUTORIAL@SHOCK_UNITS@DESCRIPTION"
msgstr "Esta é uma {GLOBAL.UnitConcept.Hyperlink} de Choque, uma lutadora corpo a corpo poderosa especializada em <<m:{GLOBAL.ChargeConcept}>> de alto dano. Seus ataques podem cancelar {GLOBAL.DefenseModeConcept}, tornando-a forte contra Unidades Escudeiras e Unidades de Apoio."

msgid "COMBAT_TUTORIAL@SHOCK_UNITS@TITLE"
msgstr "[unitShock/]Unidades de Choque"

msgid "COMBAT_TUTORIAL@SKIRMISHER_UNIT@DESCRIPTION"
msgstr "Esta é uma {GLOBAL.UnitConcept.Hyperlink} Escaramuçadora, que é versátil e usa ataques à distância e {GLOBAL.MeleeConcept}. Com sua alta velocidade e habilidade Escorregadia, é a unidade perfeita para ataques relâmpago."

msgid "COMBAT_TUTORIAL@SKIRMISHER_UNIT@TITLE"
msgstr "[unitSkirmisher/]Unidades Escaramuçadoras"

msgid "COMBAT_TUTORIAL@SPELL_CASTING@DESCRIPTION"
msgstr "Seus Feitiços estão prontos para serem conjurados! Feitiços podem ter uma variedade de efeitos poderosos e virar o jogo quando usados corretamente."

msgid "COMBAT_TUTORIAL@SPELL_CASTING@DESCRIPTION_SECONDARY"
msgstr "Feitiços não estão disponíveis no primeiro turno de combate e exigem {GLOBAL.ManaConcept.Hyperlink} e <<m:{GLOBAL.CombatCastingPointConcept.Hyperlink}>> para serem usados."

msgid "COMBAT_TUTORIAL@SPELL_CASTING@TITLE"
msgstr "Conjuração de Feitiços"

msgid "COMBAT_TUTORIAL@SUPPORT_UNITS@DESCRIPTION"
msgstr "Esta é uma {GLOBAL.UnitConcept.Hyperlink} de Apoio, que pode usar habilidades mágicas para curar e fortalecer seus aliados."

msgid "COMBAT_TUTORIAL@SUPPORT_UNITS@INSTRUCTION"
msgstr "Ao entrar em {GLOBAL.DefenseModeConcept.Hyperlink}, ela concede um bônus a aliados adjacentes, protegendo-os contra ataques mágicos."

msgid "COMBAT_TUTORIAL@SUPPORT_UNITS@TITLE"
msgstr "[unitSupport/]Unidades de Apoio"

msgid "COMBAT_TUTORIAL@ZONE_OF_CONTORL@DESCRIPTION"
msgstr "Sua {GLOBAL.UnitConcept.Hyperlink} está na Zona de Controle de um inimigo. Quando uma unidade entra na Zona de Controle de um inimigo, ela fica temporariamente imobilizada e não pode se mover pelo resto do turno."

msgid "COMBAT_TUTORIAL@ZONE_OF_CONTORL@DESCRIPTION_SECONDARY"
msgstr "Sair de uma Zona de Controle pode desencadear um {GLOBAL.OpportunityAttackConcept}.[br/][br/]Enquanto estiver em uma Zona de Controle inimiga, muitas habilidades de longo alcance e mágicas ficarão indisponíveis."

msgid "COMBAT_TUTORIAL@ZONE_OF_CONTORL@TITLE"
msgstr "Zona de Controle"

msgid "CONCEPT@ACCURACY@DESCRIPTION"
msgstr "Precisão é a probabilidade de ataques acertarem com sucesso. Se o ataque não acertar, ele erra ou raspa o alvo.[bulletlist][bullet/]Raspões causam metade do dano.[bullet/]Erros não causam dano.[bullet/]Erros podem atingir unidades adjacentes aleatórias próximas ao alvo.[/bulletlist]"

msgid "CONCEPT@ACCURACY@HYPERLINK"
msgstr "[hyperlink,GLOBAL.AccuracyConcept][accuracy/] Precisão[/hyperlink]"

msgid "CONCEPT@ACCURACY@NAME"
msgstr "[accuracy/]Precisão"

msgid "CONCEPT@ACTION_POINTS@DESCRIPTION"
msgstr "[bulletlist][bullet/]<<m:{GLOBAL.UnitConcept.Hyperlink}>> usam Pontos de Ação para atacar e usar habilidades.[bullet/]Unidades recebem 3 Pontos de Ação por {GLOBAL.TurnConcept} e podem usar até 2 deles para se mover.[/bulletlist][br/][br/]Habilidades usam Pontos de Ação de diferentes formas:[bulletlist][bullet/][singleuseaction/] {LOC.CONCEPT@ACTION_POINTS@DESCRIPTION_SINGLE}[bullet/][repeatingaction/] {LOC.CONCEPT@ACTION_POINTS@DESCRIPTION_REPEATING}[bullet/][fullaction/]{LOC.CONCEPT@ACTION_POINTS@DESCRIPTION_FULL}[bullet/][freeaction/] {LOC.CONCEPT@ACTION_POINTS@DESCRIPTION_FREE}[bullet/][leaveoneaction/] {LOC.CONCEPT@ACTION_POINTS@DESCRIPTION_LEAVE_ONE}[bullet/][fullactioncontinue/] {LOC.CONCEPT@ACTION_POINTS@DESCRIPTION_FULL_ACTION_CONTINUE}[/bulletlist]"

msgid "CONCEPT@ACTION_POINTS@DESCRIPTION_FREE"
msgstr "Habilidade custa 0 pontos de ação."

msgid "CONCEPT@ACTION_POINTS@DESCRIPTION_FULL"
msgstr "Habilidade custa 3 pontos de ação. O turno da unidade termina em seguida."

msgid "CONCEPT@ACTION_POINTS@DESCRIPTION_FULL_ACTION_CONTINUE"
msgstr "Habilidade requer 3 pontos de ação. A unidade mantém 1 ponto de ação em seguida."

msgid "CONCEPT@ACTION_POINTS@DESCRIPTION_LEAVE_ONE"
msgstr "Habilidade custa 0 pontos de ação. A unidade mantém 1 ponto de ação em seguida."

msgid "CONCEPT@ACTION_POINTS@DESCRIPTION_REPEATING"
msgstr "Habilidade é acionada uma vez por ponto de ação restante. O turno da unidade termina em seguida."

msgid "CONCEPT@ACTION_POINTS@DESCRIPTION_SINGLE"
msgstr "Habilidade custa um único ponto de ação. O turno da unidade termina em seguida."

msgid "CONCEPT@ACTION_POINTS@HYPERLINK"
msgstr "[hyperlink,GLOBAL.ActionPointConcept]Ponto de Ação[/hyperlink]"

msgid "CONCEPT@ACTION_POINTS@NAME"
msgstr "Ponto de Ação"

msgid "CONCEPT@BASE_ABILITY@DESCRIPTION"
msgstr "Um ataque básico é um ataque normal que uma unidade geralmente pode usar a cada turno no combate.[br/][br/]Alguns <<m:{GLOBAL.UnitEnchantmentConcept.Hyperlink}>> afetam apenas os ataques básicos de uma unidade."

msgid "CONCEPT@BASE_ABILITY@HYPERLINK"
msgstr "[hyperlink,GLOBAL.BaseAbilityConcept]Básico[/hyperlink]"

msgid "CONCEPT@BASE_ABILITY@NAME"
msgstr "Ataque Básico"

msgid "CONCEPT@BLIGHT_DAMAGE@DESCRIPTION"
msgstr "Causa [damageBlight/] Dano de Praga."

msgid "CONCEPT@BLIGHT_DAMAGE@HYPERLINK"
msgstr "[damageBlight/] [hyperlink,GLOBAL.BlightDamageConcept]Dano de Praga[/hyperlink]"

msgid "CONCEPT@BLIGHT_DAMAGE@NAME"
msgstr "Dano de Praga"

msgid "CONCEPT@BLIGHT_RESISTANCE@DESCRIPTION"
msgstr "Resistência a Praga reduz {GLOBAL.BlightDamageConcept.Hyperlink}."

msgid "CONCEPT@BLIGHT_RESISTANCE@HYPERLINK"
msgstr "[defenseblight/] [hyperlink,GLOBAL.BlightResistanceConcept]Resistência a Praga[/hyperlink]"

msgid "CONCEPT@BLIGHT_RESISTANCE@NAME"
msgstr "Resistência a Praga"

msgid "CONCEPT@CASUALTIES@DESCRIPTION"
msgstr "Quando um(a) {GLOBAL.UnitConcept.Hyperlink} sofre dano, membros da unidade são perdidos.[br/][br/]Cada membro perdido reduz proporcionalmente o dano causado pela unidade. A chance de a unidade aplicar <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>> também é reduzida.[br/][br/]Uma unidade {GLOBAL.LeaderConcept.Hyperlink} ou {GLOBAL.HeroConcept.Hyperlink} e monstros grandes possuem apenas um membro e não são afetados por esta regra."

msgid "CONCEPT@CASUALTIES@HYPERLINK"
msgstr "[hyperlink,GLOBAL.CasualtyConcept]Baixa[/hyperlink]"

msgid "CONCEPT@CASUALTIES@NAME"
msgstr "Baixas"

msgid "CONCEPT@CHARGE@DESCRIPTION"
msgstr "Ataque de Carga:[bulletlist][bullet/]Ganha dano extra por hexágono percorrido, até {GLOBAL.ChargeHexes} hexágonos.[bullet/]Cancela {GLOBAL.DefenseModeConcept.Hyperlink}.[bullet/]Remove {GLOBAL.RetaliationConcept.Hyperlink}.[/bulletlist][br/][br/]Esses efeitos são anulados por {GLOBAL.PROPERTIES.CHARGE_RESISTANCE.Hyperlink}, a menos que o ataque seja um {GLOBAL.PROPERTIES.HEAVYMELEESTRIKE.Hyperlink}."

msgid "CONCEPT@CHARGE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.ChargeConcept]Carga[/hyperlink]"

msgid "CONCEPT@CHARGE@NAME"
msgstr "Carga"

msgid "CONCEPT@CHARGE_HEAVY@DESCRIPTION"
msgstr "Um ataque de Carga Pesada:[bulletlist]{LOC.CONCEPT@CHARGE_SHARED}[bullet/]Cargas Pesadas ignoram {GLOBAL.PROPERTIES.CHARGE_RESISTANCE.Hyperlink}.[/bulletlist]"

msgid "CONCEPT@CHARGE_NORMAL@DESCRIPTION"
msgstr "Ataque de Carga:[bulletlist]{LOC.CONCEPT@CHARGE_SHARED}[/bulletlist]"

msgid "CONCEPT@CHARGE_SHARED"
msgstr "[bullet/]Ganha {CHARGE_DAMAGE_MULTIPLIER>ResolvedDamageMultiplier}% de dano por hexágono percorrido, até {GLOBAL.ChargeHexes} hexágonos.[bullet/]Cancela {GLOBAL.DefenseModeConcept.Hyperlink}.[bullet/]Remove {GLOBAL.RetaliationConcept.Hyperlink}."

msgid "CONCEPT@COMBAT_SPEED@DESCRIPTION"
msgstr "[bulletlist][bullet/]A Velocidade de Combate representa o quão longe uma unidade pode se mover dentro de um {GLOBAL.TurnConcept} em {GLOBAL.CombatConcept.Hyperlink}.[bullet/]Cada hexágono no combate custa {amount} ponto para atravessar.[bullet/]Terreno {GLOBAL.SlowingConcept.Hyperlink} custa {amount2} pontos para atravessar.[/bulletlist]"

msgid "CONCEPT@COMBAT_SPEED@HYPERLINK"
msgstr "[combatspeed/][hyperlink,GLOBAL.CombatSpeedConcept]{LOC.CONCEPT@COMBAT_SPEED@NAME}[/hyperlink]"

msgid "CONCEPT@COMBAT_SPEED@NAME"
msgstr "Velocidade de Combate"

msgid "CONCEPT@CONTROL_LOSS_IMMUNITY@DESCRIPTION"
msgstr "Imune a efeitos que fazem você perder o controle de uma unidade, como {GLOBAL.PROPERTIES.BERSERK.Hyperlink} e {GLOBAL.PROPERTIES.DOMINATED.Hyperlink}.[br/]Também concede imunidade a ser {GLOBAL.CapturedConcept.Hyperlink}."

msgid "CONCEPT@CONTROL_LOSS_IMMUNITY@HYPERLINK"
msgstr "[hyperlink,GLOBAL.ControlLossImmunityConcept]Imunidade à Perda de Controle[/hyperlink]"

msgid "CONCEPT@CONTROL_LOSS_IMMUNITY@NAME"
msgstr "Imunidade à Perda de Controle"

msgid "CONCEPT@CRITICAL_HIT@DESCRIPTION"
msgstr "[bulletlist][bullet/]Se o ataque de uma unidade for um Golpe Crítico, seu dano é aumentado em {damage}.[bullet/]Golpes Críticos geralmente são causados por alto(a) {GLOBAL.UnitMoraleConcept.Hyperlink}.[bullet/]A chance de Golpe Crítico nunca pode ser maior que a chance de acertar o ataque.[/bulletlist]"

msgid "CONCEPT@CRITICAL_HIT@HYPERLINK"
msgstr "[hyperlink,GLOBAL.CriticalHitConcept]Acerto Crítico[/hyperlink]"

msgid "CONCEPT@CRITICAL_HIT@NAME"
msgstr "Golpe Crítico"

msgid "CONCEPT@CRITICAL_HIT_CHANCE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.CriticalHitConcept][crit/]Chance de Acerto Crítico[/hyperlink]"

msgid "CONCEPT@CRITICAL_HIT_CHANCE@NAME"
msgstr "[crit/]Chance de Golpe Crítico"

msgid "CONCEPT@DEBUFF_ABILITY@DESCRIPTION"
msgstr "Uma habilidade que tenta infligir um(a) {GLOBAL.NegativeStatusEffectConcept.Hyperlink} em um inimigo sem causar dano diretamente."

msgid "CONCEPT@DEBUFF_ABILITY@HYPERLINK"
msgstr "[hyperlink,GLOBAL.DebuffConcept]Efeito Negativo[/hyperlink]"

msgid "CONCEPT@DEFENSE@DESCRIPTION"
msgstr "Defesa reduz {GLOBAL.PhysicalDamageConcept.Hyperlink}."

msgid "CONCEPT@DEFENSE@HYPERLINK"
msgstr "[defense/] [hyperlink,GLOBAL.DefenseConcept]Defesa[/hyperlink]"

msgid "CONCEPT@DEFENSE@NAME"
msgstr "Defesa"

msgid "CONCEPT@DEFENSE_MODE@DESCRIPTION"
msgstr "O Modo Defesa é uma habilidade {GLOBAL.UnitConcept.Hyperlink}. Quando em Modo Defesa, uma unidade:[bulletlist][bullet/]Estende seu {GLOBAL.ZoneOfControlConcept.Hyperlink} para todos os hexágonos adjacentes.[bullet/]Ganha {defense} {GLOBAL.DefenseConcept.Hyperlink}.[bullet/]Ganha {resistance} {GLOBAL.ResistanceConcept.Hyperlink}.[bullet/]É imune a {GLOBAL.FlankingConcept.Hyperlink}.[/bulletlist]"

msgid "CONCEPT@DEFENSE_MODE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.DefenseModeConcept]Modo Defesa[/hyperlink]"

msgid "CONCEPT@DEFENSE_MODE@NAME"
msgstr "Modo Defesa"

msgid "CONCEPT@ENGAGED@DESCRIPTION"
msgstr "Enquanto estiver dentro do {GLOBAL.ZoneOfControlConcept.Hyperlink} de um inimigo, uma unidade está Engajada em Combate Corpo a Corpo e não pode usar a maioria dos ataques à distância ou habilidades mágicas."

msgid "CONCEPT@ENGAGED@HYPERLINK"
msgstr "[hyperlink,GLOBAL.EngagedInMeleeConcept]Engajada em Combate Corpo a Corpo[/hyperlink]"

msgid "CONCEPT@ENGAGED@NAME"
msgstr "Engajada em Combate Corpo a Corpo"

msgid "CONCEPT@ETHEREAL_IMMUNITY"
msgstr "[bulletlist][bullet/]{GLOBAL.PROPERTIES.BLEEDING.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.DISEASED.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.IMMOBILIZED.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.POISONED.Hyperlink}[/bulletlist]"

msgid "CONCEPT@EVASION@DESCRIPTION"
msgstr "Aumenta a chance de ataques {GLOBAL.RangedConcept.Hyperlink} e {GLOBAL.MagicConcept.Hyperlink} errarem."

msgid "CONCEPT@EVASION@HYPERLINK"
msgstr "[hyperlink,GLOBAL.EvasionConcept]Esquiva[/hyperlink]"

msgid "CONCEPT@EVASION@NAME"
msgstr "Esquiva"

msgid "CONCEPT@EXPERIENCE@DESCRIPTION"
msgstr "Experiência é um valor que indica o progresso de uma unidade em direção à próxima patente. A experiência é obtida principalmente ao vencer combates."

msgid "CONCEPT@EXPERIENCE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.ExperienceConcept][xp/]Experiência[/hyperlink]"

msgid "CONCEPT@FIRE_DAMAGE@DESCRIPTION"
msgstr "Causa [damageFire/] Dano de Fogo."

msgid "CONCEPT@FIRE_DAMAGE@HYPERLINK"
msgstr "[damageFire/] [hyperlink,GLOBAL.FireDamageConcept]Dano de Fogo[/hyperlink]"

msgid "CONCEPT@FIRE_DAMAGE@NAME"
msgstr "Dano de Fogo"

msgid "CONCEPT@FIRE_LIGHTNING_DAMAGE@NAME"
msgstr "Dano de Arcofogo"

msgid "CONCEPT@FIRE_LIGHTNING_FROST_DAMAGE@NAME"
msgstr "Dano Cósmico"

msgid "CONCEPT@FIRE_RESISTANCE@DESCRIPTION"
msgstr "Resistência ao Fogo reduz {GLOBAL.FireDamageConcept.Hyperlink}."

msgid "CONCEPT@FIRE_RESISTANCE@HYPERLINK"
msgstr "[defensefire/] [hyperlink,GLOBAL.FireResistanceConcept]Resistência a Fogo[/hyperlink]"

msgid "CONCEPT@FIRE_RESISTANCE@NAME"
msgstr "Resistência a Fogo"

msgid "CONCEPT@FIRE_SPIRIT_DAMAGE@NAME"
msgstr "Dano Radiante"

msgid "CONCEPT@FIRST_STRIKE@DESCRIPTION"
msgstr "Quando atacada, uma unidade com Ataque Preferencial usará um {GLOBAL.RetaliationConcept.Hyperlink} para atacar primeiro."

msgid "CONCEPT@FIRST_STRIKE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.FirstStrikeConcept]Ataque Preferencial[/hyperlink]"

msgid "CONCEPT@FIRST_STRIKE@NAME"
msgstr "Ataque Preferencial"

msgid "CONCEPT@FLANKING@DESCRIPTION"
msgstr "Ataques de flanqueamento são acionados ao atacar um alvo por trás ou pelo lado.[bulletlist][bullet/]Ataques de flanqueamento causam {damage} de dano.[bullet/]Unidades em {GLOBAL.DefenseModeConcept.Hyperlink} não podem ser flanqueadas.[bullet/]Se uma unidade começar seu turno na {GLOBAL.ZoneOfControlConcept.Hyperlink} de um inimigo, ela não poderá flanqueá-lo naquele turno.[/bulletlist]"

msgid "CONCEPT@FLANKING@HYPERLINK"
msgstr "[hyperlink,GLOBAL.FlankingConcept][flank/] Flanqueamento[/hyperlink]"

msgid "CONCEPT@FLANKING@NAME"
msgstr "[flank/] Flanqueamento"

msgid "CONCEPT@FORTIFIED@DESCRIPTION"
msgstr "Só pode ser danificada por habilidades ou feitiços que tenham {GLOBAL.PROPERTIES.DEMOLISHER.Hyperlink}."

msgid "CONCEPT@FORTIFIED@HYPERLINK"
msgstr "[hyperlink,GLOBAL.FortifiedConcept]Fortificada[/hyperlink]"

msgid "CONCEPT@FORTIFIED@NAME"
msgstr "Fortificada"

msgid "CONCEPT@FROEST_RESISTANCE@NAME"
msgstr "Resistência a Gelo"

msgid "CONCEPT@FROST_BLIGHT_DAMAGE@NAME"
msgstr "Dano Mortal"

msgid "CONCEPT@FROST_DAMAGE@DESCRIPTION"
msgstr "Inflige [damageFrost/] de Dano de Gelo."

msgid "CONCEPT@FROST_DAMAGE@HYPERLINK"
msgstr "[damageFrost/] [hyperlink,GLOBAL.FrostDamageConcept]Dano de Gelo[/hyperlink]"

msgid "CONCEPT@FROST_DAMAGE@NAME"
msgstr "Dano de Gelo"

msgid "CONCEPT@FROST_RESISTANCE@DESCRIPTION"
msgstr "Resistência a Gelo reduz {GLOBAL.FrostDamageConcept.Hyperlink}."

msgid "CONCEPT@FROST_RESISTANCE@HYPERLINK"
msgstr "[defensefrost/] [hyperlink,GLOBAL.FrostResistanceConcept]Resistência a Gelo[/hyperlink]"

msgid "CONCEPT@FUMBLE@DESCRIPTION"
msgstr "[bulletlist][bullet/]Se o ataque de uma unidade for uma Falha:[bulletlist][bullet/]Um acerto se torna um Acertou Por Pouco, causando metade do dano.[bullet/]Um Acertou Por Pouco se torna uma Errada.[/bulletlist][bullet/]Falhas geralmente são causadas por baixa {GLOBAL.UnitMoraleConcept.Hyperlink}.[/bulletlist]"

msgid "CONCEPT@FUMBLE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.FumbleConcept]Fracasso Crítico[/hyperlink]"

msgid "CONCEPT@FUMBLE@NAME"
msgstr "Fracasso Crítico"

msgid "CONCEPT@HEROES@AMBITION@NAME"
msgstr "Ambições do Herói"

msgid "CONCEPT@HEROES@AMBITIONS@DESCRIPTION"
msgstr "Cada {GLOBAL.HeroConcept.Hyperlink} possui uma Ambição, que define objetivos para serem concluídos e ganhar {GLOBAL.RenownConcept.Hyperlink}. Cada uma inclui uma Ambição Menor, que pode ser repetida quantas vezes desejar, e uma Ambição Maior, que só pode ser concluída uma vez.[br/][br/]Completar essas ambições concede {GLOBAL.RenownConcept.Hyperlink}, enquanto concluir a Ambição Maior também concede uma propriedade única ao herói.[br/][br/]A Ambição de um herói pode ser alterada por meio de um evento caso ele não consiga concluir seus objetivos em um período determinado."

msgid "CONCEPT@HEROES@AMBITIONS@HYPERLINK"
msgstr "[hyperlink,GLOBAL.AmbitionConcept]Ambição[/hyperlink]"

msgid "CONCEPT@HEROES@AMBITIONS@NAME"
msgstr "Classes do Herói"

msgid "CONCEPT@HEROES@CLASS@DESCRIPTION"
msgstr "Cada {GLOBAL.HeroConcept.Hyperlink} possui uma Classe, escolhida durante a criação. Cada classe permite que o herói se especialize em funções específicas e geralmente oferece duas variações gerais dessa função.[br/][br/]Classes do Herói:[bulletlist][bullet/]{GLOBAL.HeroClassDefender.Hyperlink}[bullet/]{GLOBAL.HeroClassWarrior.Hyperlink}[bullet/]{GLOBAL.HeroClassMage.Hyperlink}[bullet/]{GLOBAL.HeroClassRitualist.Hyperlink}[bullet/]{GLOBAL.HeroClassRanger.Hyperlink}[bullet/]{GLOBAL.HeroClassDeathKnight.Hyperlink}[bullet/]{GLOBAL.HeroClassSpellblade.Hyperlink}[/bulletlist]"

msgid "CONCEPT@HEROES@CLASS@HYPERLINK"
msgstr "[hyperlink,GLOBAL.HeroClass]Classe do Herói[/hyperlink]"

msgid "CONCEPT@HEROES@CLASS@NAME"
msgstr "Classe do Herói"

msgid "CONCEPT@HEROES@DEDICATION@DESCRIPTION"
msgstr "Em determinados níveis, os heróis ganham a habilidade de escolher Habilidades de Assinatura. Para <<m:{GLOBAL.MortalChampionConcept.Hyperlink}>>, <<m:{GLOBAL.WizardKingConcept.Hyperlink}>> e Senhores dos Dragões, elas assumem a forma de Dedicatórias de Afinidade.[br/][br/]Cada nível de Dedicatória de Afinidade fica disponível com base na <<m:{GLOBAL.AffinityConcept.Hyperlink}>> do seu império e no nível do seu herói:[br/][bulletlist][bullet/]Iniciante – Requer 1 ponto de afinidade e um Herói de nível 4.[bullet/]Adepto – Requer 4 pontos de afinidade e um Herói de nível 8.[bullet/]Mestre – Requer 6 pontos de afinidade e um Herói de nível 12.[bullet/]Paragon – Requer 8 pontos de afinidade e um Herói de nível 16.[/bulletlist][br/][br/][br/]Essas Dedicatórias concedem um benefício próprio e desbloqueiam novas Habilidades do Herói.[br/][br/]Alguns tipos de Herói, como Soberanos Arcanos, possuem Habilidades de Assinatura especiais que não estão relacionadas à afinidade."

msgid "CONCEPT@HEROES@DEDICATION@HYPERLINK"
msgstr "[hyperlink,GLOBAL.HeroDedication]Habilidades de Assinatura do Herói[/hyperlink]"

msgid "CONCEPT@HEROES@DEDICATION@NAME"
msgstr "Habilidades de Assinatura do Herói"

msgid "CONCEPT@HEROES@DESTINY@DESCRIPTION"
msgstr "Cada Herói possui um Destino, que define objetivos para serem concluídos e ganhar {GLOBAL.RenownConcept.Hyperlink}. Cada Destino tem uma Ambição Menor, que pode ser repetida quantas vezes desejar, e uma Ambição Maior, que só pode ser concluída uma vez.[br/][br/]Completar Ambições concede {GLOBAL.RenownConcept.Hyperlink}, e concluir Ambições Maiores também concede uma propriedade única ao herói.[br/][br/]O Destino de um Herói pode ser alterado por meio de um evento caso ele não consiga concluir suas ambições em um período determinado."

msgid "CONCEPT@HEROES@DESTINY@HYPERLINK"
msgstr "[hyperlink,GLOBAL.DestinyConcept]Destino[/hyperlink]"

msgid "CONCEPT@HEROES@DESTINY@NAME"
msgstr "Destino do Herói"

msgid "CONCEPT@HEROES@ORIGIN@DESCRIPTION"
msgstr "A Origem é determinada pelo tipo de herói criado durante a criação da facção; para a maioria dos <<m:{GLOBAL.HeroConcept.Hyperlink}>> encontrados aleatoriamente, será <<m:{GLOBAL.MortalChampionConcept.Hyperlink}>>.[br/][br/]É aqui que se encontram habilidades exclusivas desses tipos, como ataques de baforada para Senhores dos Dragões ou encantamentos de feitiços para <<m:{GLOBAL.WizardKingConcept.Hyperlink}>>."

msgid "CONCEPT@HEROES@ORIGIN@HYPERLINK"
msgstr "[hyperlink,GLOBAL.HeroOrigin]Origem do Herói[/hyperlink]"

msgid "CONCEPT@HEROES@ORIGIN@NAME"
msgstr "Origem do Herói"

msgid "CONCEPT@HEROES@RENOWN@DESCRIPTION"
msgstr "Os heróis ganham Renome ao concluírem os objetivos associados ao seu {GLOBAL.AmbitionConcept.Hyperlink}. Ganhar renome suficiente aumenta seu Nível de Renome, o que aumenta os bônus que a [hyperlink,GLOBAL.GovernorConcept]Cidade Governada[/hyperlink] recebe do traço de Governança do herói.[br/]Além disso, níveis de renome concedem moral adicional às unidades no exército do herói e reduzem a chance de perder unidades quando {GLOBAL.RoutingConcept.Hyperlink}."

msgid "CONCEPT@HEROES@RENOWN@HYPERLINK"
msgstr "[renown/][hyperlink,GLOBAL.RenownConcept]Renome[/hyperlink]"

msgid "CONCEPT@HEROES@RENOWN@NAME"
msgstr "Fama do Herói"

msgid "CONCEPT@HERO_CLASS@DEATH_KNIGHT@DESCRIPTION"
msgstr "{LOC.CONCEPT@HERO_CLASS@DEATH_KNIGHT@DESCRIPTION_SHORT}[br/][br/]Armas compatíveis:[bulletlist][bullet/]{GLOBAL.GreatWeaponConcept.Hyperlink}[bullet/]{GLOBAL.OneHandedWeaponConcept.Hyperlink}[bullet/]{GLOBAL.ShieldConcept.Hyperlink}[bullet/]{GLOBAL.FistWeaponConcept.Hyperlink}[bullet/]{GLOBAL.PolearmWeaponConcept.Hyperlink}[bullet/]{GLOBAL.SkirmishingWeaponConcept.Hyperlink}[/bulletlist]"

msgid "CONCEPT@HERO_CLASS@DEATH_KNIGHT@DESCRIPTION_SHORT"
msgstr "Uma Classe de Herói especializada em ataques {GLOBAL.MeleeConcept.Hyperlink} de alto dano, apoiados por <<m:{GLOBAL.DebuffConcept.Hyperlink}>> e unidades {GLOBAL.PROPERTIES.UNDEAD.Hyperlink} invocadas."

msgid "CONCEPT@HERO_CLASS@DEATH_KNIGHT@GAMEPLAY_HYPERLINK"
msgstr "[classDeathknight/] [hyperlink,GLOBAL.HeroClassDeathKnight]Cavaleiro da Morte[/hyperlink]"

msgid "CONCEPT@HERO_CLASS@DEATH_KNIGHT@HYPERLINK"
msgstr "[hyperlink,GLOBAL.HeroClassDeathKnight]Classe de Herói: Cavaleiro da Morte[/hyperlink]"

msgid "CONCEPT@HERO_CLASS@DEFENDER@DESCRIPTION"
msgstr "{LOC.CONCEPT@HERO_CLASS@DEFENDER@DESCRIPTION_SHORT}[br/][br/]Armas compatíveis:[bulletlist][bullet/]{GLOBAL.OneHandedWeaponConcept.Hyperlink}[bullet/]{GLOBAL.ShieldConcept.Hyperlink}[bullet/]{GLOBAL.FistWeaponConcept.Hyperlink}[bullet/]{GLOBAL.PolearmWeaponConcept.Hyperlink}[bullet/]{GLOBAL.SkirmishingWeaponConcept.Hyperlink}[/bulletlist]"

msgid "CONCEPT@HERO_CLASS@DEFENDER@DESCRIPTION_SHORT"
msgstr "Uma Classe de Herói especializada em defender seus aliados, sobrevivência e retaliação."

msgid "CONCEPT@HERO_CLASS@DEFENDER@GAMEPLAY_HYPERLINK"
msgstr "[classDefender/] [hyperlink,GLOBAL.HeroClassDefender]Defensor[/hyperlink]"

msgid "CONCEPT@HERO_CLASS@DEFENDER@HYPERLINK"
msgstr "[hyperlink,GLOBAL.HeroClassDefender]Classe de Herói: Defensor[/hyperlink]"

msgid "CONCEPT@HERO_CLASS@MAGE@DESCRIPTION"
msgstr "{LOC.CONCEPT@HERO_CLASS@MAGE@DESCRIPTION_SHORT}[br/][br/]Armas compatíveis:[bulletlist][bullet/]{GLOBAL.MagicOrbWeaponConcept.Hyperlink}[bullet/]{GLOBAL.MagicStaffWeaponConcept.Hyperlink}[bullet/]{GLOBAL.EldritchRelicWeaponConcept.Hyperlink}[/bulletlist]"

msgid "CONCEPT@HERO_CLASS@MAGE@DESCRIPTION_SHORT"
msgstr "Elementalistas são causadores de dano mágico que preparam ataques ou desferem o golpe final com poderosas habilidades Elementais.[br/]Cada Herói Elementalista escolhe uma disciplina que determina o elemento de suas habilidades."

msgid "CONCEPT@HERO_CLASS@MAGE@GAMEPLAY_HYPERLINK"
msgstr "[classMage/] [hyperlink,GLOBAL.HeroClassMage]Elementalista[/hyperlink]"

msgid "CONCEPT@HERO_CLASS@MAGE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.HeroClassMage]Classe de Herói: Elementalista[/hyperlink]"

msgid "CONCEPT@HERO_CLASS@RANGER@DESCRIPTION"
msgstr "{LOC.CONCEPT@HERO_CLASS@RANGER@DESCRIPTION_SHORT}[br/][br/]Armas compatíveis:[bulletlist][bullet/]{GLOBAL.RangedWeaponConcept.Hyperlink}[bullet/]{GLOBAL.SkirmishingWeaponConcept.Hyperlink}[/bulletlist]"

msgid "CONCEPT@HERO_CLASS@RANGER@DESCRIPTION_SHORT"
msgstr "Uma Classe de Herói especializada em dano à distância, escaramuças e desestabilização de inimigos."

msgid "CONCEPT@HERO_CLASS@RANGER@GAMEPLAY_HYPERLINK"
msgstr "[classRanger/] [hyperlink,GLOBAL.HeroClassRanger]Patrulheiro[/hyperlink]"

msgid "CONCEPT@HERO_CLASS@RANGER@HYPERLINK"
msgstr "[hyperlink,GLOBAL.HeroClassRanger]Classe de Herói: Patrulheiro[/hyperlink]"

msgid "CONCEPT@HERO_CLASS@RITUALIST@DESCRIPTION"
msgstr "{LOC.CONCEPT@HERO_CLASS@RITUALIST@DESCRIPTION_SHORT}[br/][br/]Armas compatíveis:[bulletlist][bullet/]{GLOBAL.MagicOrbWeaponConcept.Hyperlink}[bullet/]{GLOBAL.MagicStaffWeaponConcept.Hyperlink}[bullet/]{GLOBAL.EldritchRelicWeaponConcept.Hyperlink}[/bulletlist]"

msgid "CONCEPT@HERO_CLASS@RITUALIST@DESCRIPTION_SHORT"
msgstr "Uma Classe de Herói especializada em suporte por meio de cura e buffs."

msgid "CONCEPT@HERO_CLASS@RITUALIST@GAMEPLAY_HYPERLINK"
msgstr "[classRitualist/] [hyperlink,GLOBAL.HeroClassRitualist]Ritualista[/hyperlink]"

msgid "CONCEPT@HERO_CLASS@RITUALIST@HYPERLINK"
msgstr "[hyperlink,GLOBAL.HeroClassRitualist]Classe de Herói: Ritualista[/hyperlink]"

msgid "CONCEPT@HERO_CLASS@SPELLBLADE@DESCRIPTION"
msgstr "{LOC.CONCEPT@HERO_CLASS@SPELLBLADE@DESCRIPTION_SHORT}[br/][br/]Armas compatíveis:[bulletlist][bullet/]{GLOBAL.GreatWeaponConcept.Hyperlink}[bullet/]{GLOBAL.OneHandedWeaponConcept.Hyperlink}[bullet/]{GLOBAL.ShieldConcept.Hyperlink}[bullet/]{GLOBAL.FistWeaponConcept.Hyperlink}[bullet/]{GLOBAL.PolearmWeaponConcept.Hyperlink}[bullet/]{GLOBAL.SkirmishingWeaponConcept.Hyperlink}[/bulletlist]"

msgid "CONCEPT@HERO_CLASS@SPELLBLADE@DESCRIPTION_SHORT"
msgstr "Uma classe de herói que usa ataques de {GLOBAL.MeleeConcept.Hyperlink} e {GLOBAL.MagicConcept.Hyperlink} para causar dano mágico à distância e dano físico quando o inimigo se aproxima."

msgid "CONCEPT@HERO_CLASS@SPELLBLADE@GAMEPLAY_HYPERLINK"
msgstr "[classSpellblade/] [hyperlink,GLOBAL.HeroClassSpellblade]Lâmina Mágica[/hyperlink]"

msgid "CONCEPT@HERO_CLASS@SPELLBLADE@HYPERLINK"
