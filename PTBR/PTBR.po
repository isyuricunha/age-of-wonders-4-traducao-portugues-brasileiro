msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@CINDER_STORM@DESCRIPTION"
msgstr "A cada {value} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, a Mariposa Primordial bate as asas, fazendo com que uma das unidades atacantes fique {GLOBAL.PROPERTIES.BLINDED.Hyperlink} por {BlindValue} <<m:{GLOBAL.TurnConcept.Hyperlink}>> e {GLOBAL.PROPERTIES.BURNING.Hyperlink} por {BurnValue} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@CINDER_STORM@NAME"
