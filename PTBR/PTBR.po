msgid "TOMEOFWONDERS@GENERATE_ENERGY@TEXT"
msgstr "Converte {INT_Percentage}% de {GLOBAL.StructureProductionConcept.Hyperlink} em {GLOBAL.GoldConcept.Hyperlink}"

msgid "TOMEOFWONDERS@GENERATE_FOOD@TEXT"
msgstr "Converte {INT_Percentage}% de {GLOBAL.UnitProductionConcept.Hyperlink} em {GLOBAL.FoodConcept.Hyperlink}"

msgid "TOMEOFWONDERS@GENERATE_KNOWLEDGE@TEXT"
msgstr "Converte {INT_Percentage}% de {GLOBAL.UnitProductionConcept.Hyperlink} em {GLOBAL.KnowledgeConcept.Hyperlink}"

msgid "TOMEOFWONDERS@GENERATE_RESEARCH@TEXT"
msgstr "Converte {INT_Percentage}% de {GLOBAL.StructureProductionConcept.Hyperlink} em {GLOBAL.KnowledgeConcept.Hyperlink}"

msgid "TOMEOFWONDERS@GRUDGE@NAME"
msgstr "Rancor"

msgid "TOMEOFWONDERS@HARBOR@NAME"
msgstr "Porto"

msgid "TOMEOFWONDERS@HARBOR@TEXT"
msgstr "Um porto é automaticamente atribuído ao primeiro {GLOBAL.ProvinceConcept.Hyperlink} aquático que uma cidade reivindicar. <<m:{GLOBAL.UnitConcept.Hyperlink}>> aquáticos construídos em uma cidade aparecerão em seu porto quando concluídos."

msgid "TOMEOFWONDERS@RESOURCES@NAME"
msgstr "Recursos"

msgid "TOMEOFWONDERS@TERRAFORMING@DESCRIPTION"
msgstr "Efeitos de terraformação podem alterar a aparência e o <<m:{GLOBAL.ProvinceFeatureConcept.Hyperlink}>> em uma {GLOBAL.ProvinceConcept.Hyperlink}. A terraformação pode mudar quais <<m:{GLOBAL.ProvinceImprovementConcept.Hyperlink}>> podem ser construídos em uma Província, mas não destrói ou altera Melhorias de Província já construídas.[br/][br/]Quando a terraformação tem origem em uma fonte, como um {GLOBAL.CityConcept.Hyperlink} ou Melhoria de Província, remover a fonte reverterá os efeitos da terraformação. Quando não há uma fonte que possa ser removida, a terraformação é permanente até ser sobrescrita por um novo efeito de terraformação.[br/][br/]<<m:{GLOBAL.WorldMapSpellConcept.Hyperlink}>> podem aplicar efeitos de terraformação. Quando você cancela um efeito sustentado, como um {GLOBAL.SustainedWorldSpellConcept.Hyperlink}, suas alterações de terraformação não serão revertidas.[br/][br/]Certas províncias ou características, como Lava, Água e províncias Inabitáveis, normalmente não podem ser terraformadas."

msgid "TOMEOFWONDERS@TERRAFORMING@HYPERLINK"
msgstr "[hyperlink,GLOBAL.TerraformingConcept]Terraformação[/hyperlink]"

msgid "TOMEOFWONDERS@TERRAFORMING@NAME"
msgstr "Terraformação"

msgid "TOMEOFWONDERS@TREATY_TRUCE@NAME"
msgstr "Tratado: Trégua"

msgid "TOMEOFWONDERS@TREATY_TRUCE@TEXT"
msgstr "Uma trégua é um {GLOBAL.TreatyConcept.Hyperlink} formado entre dois <<m:{GLOBAL.EmpireConcept.Hyperlink}>> para encerrar uma {GLOBAL.WarConcept.Hyperlink} pacificamente. Eles podem então optar por melhorar suas relações por meio de <<m:{GLOBAL.TradeConcept.Hyperlink}>>.[br/][br/]Uma trégua dura {Duration} <<m:{GLOBAL.TurnConcept.Hyperlink}>> e concede {AlignmentBonus}. Se um dos Governantes decidir declarar guerra ao outro durante a trégua, receberá uma penalidade severa de alinhamento.[br/][br/]Os Governantes só podem formar este tratado ao passar de guerra para {GLOBAL.DSNeutralConcept.Hyperlink}."

msgid "TOMEOFWONDERS@VASSALAGE@NAME"
msgstr "Vassalagem"

msgid "TOMEOFWONDERS@VICTORY@NAME"
msgstr "Vitória"

msgid "TOME_AMPLIFICATION@HERO_SKILL@NAME"
msgstr "Amplificação de Feitiços"

msgid "TOME_AMPLIFICATION@PASSIVE@DESCRIPTION"
msgstr "Custo de <<m:{GLOBAL.DamageSpellConcept.Hyperlink}>> -{amount} <<m:{GLOBAL.CombatCastingPointConcept.Hyperlink}>>."

msgid "TOME_AMPLIFICATION@PASSIVE@NAME"
msgstr "Magos de Guerra"

msgid "TOME_AMPLIFICATION@SKILL1@DESCRIPTION"
msgstr "Conjura um {GLOBAL.UNITS.AMPLIFICATION_PYLON_UNIT.Hyperlink}, uma estrutura estacionária que causa dano e aumenta o dano dos seus feitiços em {damage}.{LOC.CONCEPT@SUMMON_LIVE_SHARED}[br/][br/]{LOC.TACTICAL@ABILITY@NEVER_IN_WATER}"

msgid "TOME_AMPLIFICATION@SKILL1@NAME"
msgstr "Invocar Pilar de Amplificação"

msgid "TOME_AMPLIFICATION@SKILL2@DESCRIPTION"
msgstr "Unidade inimiga alvo:[bulletlist][bullet/]Sustenta {CHAIN_LIGHTNING_DAMAGE>DAMAGE>Shock} {GLOBAL.LightningDamageConcept.Hyperlink}.[bullet/]É infligida com {electrifiedCount} {GLOBAL.PROPERTIES.ELECTRIFIED.Hyperlink}.[bullet/]Este efeito passa para outro inimigo em até {CHAIN_LIGHTNING_JUMP>MaxDistance} hexes.[bullet/]Passa até {CHAIN_LIGHTNING_JUMP>MaxJumps} vezes.[/bulletlist]"

msgid "TOME_AMPLIFICATION@SKILL2@NAME"
msgstr "Raio Encadeado"

msgid "TOME_AMPLIFICATION@SKILL3@DESCRIPTION"
msgstr "Concede a unidades encantadas:[bulletlist][bullet/]{GLOBAL.PROPERTIES.FRENZY.Hyperlink}, que aumenta o dano causado quando atacam.[bullet/]+{ARCANE_FRENZY_RANGE_MODIFIER>ADD>MaxRange} {GLOBAL.RangeConcept.Hyperlink} em ataques base.[/bulletlist]"

msgid "TOME_AMPLIFICATION@SKILL3@NAME"
msgstr "Foco Frenético"

msgid "TOME_AMPLIFICATION@SKILL3@PROPERTY_DESCRIPTION"
msgstr "A unidade possui:[bulletlist][bullet/]{GLOBAL.PROPERTIES.FRENZY.Hyperlink}.[bullet/]+{ARCANE_FRENZY_RANGE_MODIFIER>ADD>MaxRange} {GLOBAL.RangeConcept.Hyperlink} em ataques base.[/bulletlist]"

msgid "TOME_AMPLIFICATION@SKILL4@DESCRIPTION"
msgstr "Faz a magia começar a fluir pelas veias da raça-alvo, concedendo:[bulletlist][bullet/]{GLOBAL.PROPERTIES.ATTUNEMENT_FORTUNE.Hyperlink}, que aumenta {GLOBAL.CriticalHitChanceConcept.Hyperlink} quando feitiços são conjurados.[/bulletlist]"

msgid "TOME_AMPLIFICATION@SKILL4@NAME"
msgstr "Sangue Astral"

msgid "TOME_AMPLIFICATION@SKILL4@PROPERTY_DESCRIPTION"
msgstr "A unidade possui:[bulletlist][bullet/]{GLOBAL.PROPERTIES.ATTUNEMENT_FORTUNE.Hyperlink}.[/bulletlist]"

msgid "TOME_AMPLIFICATION@SKILL5@DESCRIPTION"
msgstr "Cidade própria alvo ganha:[bulletlist][bullet/]{knowledge} renda de {GLOBAL.KnowledgeConcept.Hyperlink}[bullet/]{happiness} {GLOBAL.CityStabilityConcept.Hyperlink}[/bulletlist]"

msgid "TOME_AMPLIFICATION@SKILL5@NAME"
msgstr "Amplificar Mentes"

msgid "TOME_AMPLIFICATION@SKILL6@DESCRIPTION"
msgstr "Faz com que os ataques de unidades encantadas:[bulletlist][bullet/]Causem +{LIGHTNING_FOCUS_EXTRA_DAMAGE>DAMAGE>Shock} {GLOBAL.LightningDamageConcept.Hyperlink}.[bullet/]Tenha uma chance base de {ELECTRIFIED_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.ELECTRIFIED.Hyperlink}, um efeito de dano ao longo do tempo.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_AMPLIFICATION@SKILL6@NAME"
msgstr "Foco em Relâmpago"

msgid "TOME_AMPLIFICATION@SKILL6@PROPERTY_DESCRIPTION"
msgstr "Os ataques da unidade têm:[bulletlist][bullet/]+{LIGHTNING_FOCUS_EXTRA_DAMAGE>DAMAGE>Shock} {GLOBAL.LightningDamageConcept.Hyperlink}.[bullet/]Uma chance base de {ELECTRIFIED_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.ELECTRIFIED.Hyperlink}.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_AMPLIFICATION@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Aprimore seus magos e sua conjuração de feitiços com magia arcana mais avançada."

msgid "TOME_AMPLIFICATION@TOME@LORE_AUTHOR"
msgstr "Merlin, o Errante"

msgid "TOME_AMPLIFICATION@TOME@LORE_DESCRIPTION"
msgstr "\"Um dos aspectos mais fascinantes do arcano é que ele pode ser voltado contra si mesmo, aumentando e amplificando sua própria essência. Qualquer mago pode lançar um feitiço, mas um verdadeiro mestre busca aperfeiçoá-lo e elevar a si mesmo e à sua magia além do que meros praticantes julgam possível.\""

msgid "TOME_AMPLIFICATION@TOME@NAME"
msgstr "Tomo da Amplificação"

msgid "TOME_AMPLIFICATION@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Faz com que feitiços táticos causem +{SPELL_AMPLIFICATION_DAMAGE_MULTIPLIER>ResolvedMultiplier}% de dano. Isso não é cumulativo."

msgid "TOME_AMPLIFICATION@UNIT1@ABILITY1@NAME"
msgstr "Amplificação de Feitiço"

msgid "TOME_AMPLIFICATION@UNIT1@DESCRIPTION"
msgstr "Torre estacionária que atira em inimigos e amplifica o dano de feitiços."

msgid "TOME_AMPLIFICATION@UNIT1@NAME"
msgstr "Pilar de Amplificação^n"

msgid "TOME_ANIMISM@UNIT_1@NAME"
msgstr "Gavião Espiritual"

msgid "TOME_ARCHDRUID@HERO_SKILL@DESCRIPTION"
msgstr "Todos os <<m:{GLOBAL.PROPERTIES.ANIMAL.Hyperlink}>> e <<m:{GLOBAL.PROPERTIES.PLANT.Hyperlink}>> amigos em até {NATURE_AVENGER_UNIT_TARGETER_CIRCLE>AREA>Radius} hexes se tornam {stacks} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}."

msgid "TOME_ARCHDRUID@HERO_SKILL@NAME"
msgstr "Vingador da Natureza"

msgid "TOME_ARCHDRUID@PASSIVE@DESCRIPTION"
msgstr "Após capturar um(a) {GLOBAL.CityConcept}, você pode optar por devolvê-lo(a) à natureza. Se fizer isso:[bulletlist][bullet/]O(a) {GLOBAL.CityConcept} será arrasado(a).[bullet/]Cada {amount1} de {amount2} membros do(a) {GLOBAL.CityConcept} {GLOBAL.PopulationConcept} será distribuído(a) uniformemente pelo seu {GLOBAL.EmpireConcept}.[bullet/]O(a) {GLOBAL.ProvinceConcept} alvo será transformado(a) em floresta.[/bulletlist]"

msgid "TOME_ARCHDRUID@PASSIVE@NAME"
msgstr "Retorno à Natureza"

msgid "TOME_ARCHDRUID@PASSIVE@OPERATION@DESCRIPTION"
msgstr "[bulletlist][bullet/]O(a) {GLOBAL.CityConcept} será arrasado(a).[bullet/]Cada {amount1} de {amount2} membros do(a) {GLOBAL.CityConcept} {GLOBAL.PopulationConcept} será distribuído(a) uniformemente pelo seu {GLOBAL.EmpireConcept}.[bullet/]O(a) {GLOBAL.ProvinceConcept} alvo será transformado(a) em floresta.[/bulletlist]"

msgid "TOME_ARCHDRUID@PASSIVE@OPERATION_PROGRESS@DESCRIPTION"
msgstr "A cidade está sendo devolvida à natureza. O processo será concluído em {Duration.Turn}."

msgid "TOME_ARCHDRUID@PIERCING_ROOTS@DESCRIPTION"
msgstr "Unidade inimiga alvo:[bulletlist][bullet/]Sofre {GLOBAL.BlightDamageConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_ARCHDRUID@ROOT_BURST@DESCRIPTION"
msgstr "Todas as unidades adjacentes:[bulletlist][bullet/]Recebem {GLOBAL.BlightDamageConcept.Hyperlink}.[bullet/]São [abilityred]Deslocadas[/abilityred] em {hex} [range/] hex[/bulletlist]"

msgid "TOME_ARCHDRUID@SKILL1@DESCRIPTION"
msgstr "Inimigo que não seja {GLOBAL.PROPERTIES.HERO.Hyperlink}:[bulletlist][bullet/]Tem {DEVOLVE_RESISTANCE_CHECK>ResolvedStrength}% de chance base de ser transformado em um animal aleatório de Nível I até o fim da batalha.[bullet/]Se resistir, inflige {GLOBAL.PROPERTIES.STUNNED.Hyperlink} em vez disso.[/bulletlist][br/][br/]{LOC.TACTICAL@ABILITY@NEVER_IN_WATER}"

msgid "TOME_ARCHDRUID@SKILL1@NAME"
msgstr "Reverter"

msgid "TOME_ARCHDRUID@SKILL2@DESCRIPTION"
msgstr "No(a) {GLOBAL.ProvinceConcept.Hyperlink} alvo:[bulletlist][bullet/]Unidades inimigas sofrem {damageamount} {GLOBAL.BlightDamageConcept.Hyperlink}.[bullet/]Se contiver um(a) {GLOBAL.ProvinceImprovementConcept.Hyperlink} inimigo(a), ele(a) fica [hyperlink,GLOBAL.PillagingConcept]Pilhado(a)[/hyperlink].[bulletlist][bullet/]Você não recebe suas recompensas nem perde {GLOBAL.AlignmentConcept.Hyperlink}.[/bulletlist][bullet/]A província ganha {GLOBAL.ForestConcept.Hyperlink} se estiver na Superfície ou {GLOBAL.MushroomForestConcept.Hyperlink} se estiver no Subterrâneo.[/bulletlist]"

msgid "TOME_ARCHDRUID@SKILL2@NAME"
msgstr "Regeneração Destrutiva"

msgid "TOME_ARCHDRUID@SKILL3@DESCRIPTION"
msgstr "Invoca o Deus Chifrudo, um(a) {GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink} de Nível V com habilidades de invocação poderosas."

msgid "TOME_ARCHDRUID@SKILL3@NAME"
msgstr "Invocar Deus Chifrudo"

msgid "TOME_ARCHDRUID@SKILL4@DESCRIPTION"
msgstr "Todas as unidades aliadas em um raio de {AWAKEN_INSTINCTS_CIRCLE_TARGETER>AREA>Radius} hexes:[bulletlist][bullet/]Cura +{AWAKEN_INSTINCTS_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Recupera todos os <<m:{GLOBAL.ActionPointConcept.Hyperlink}>>.[bullet/]Ficam {GLOBAL.PROPERTIES.BERSERK.Hyperlink} por {BERSERK_DESCRIPTION_2>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][br/]Não afeta unidades com {GLOBAL.ControlLossImmunityConcept.Hyperlink}."

msgid "TOME_ARCHDRUID@SKILL4@NAME"
msgstr "Despertar Instintos"

msgid "TOME_ARCHDRUID@SKILL5@DESCRIPTION"
msgstr "Alvo {GLOBAL.ProvinceConcept.Hyperlink} com {GLOBAL.ForestConcept.Hyperlink}:[bulletlist][bullet/]Perde {GLOBAL.ForestConcept.Hyperlink}.[bullet/]Um(a) {GLOBAL.ArmyConcept.Hyperlink} de <<m:{GLOBAL.PROPERTIES.ANIMAL.Hyperlink}>> e <<m:{GLOBAL.PROPERTIES.PLANT.Hyperlink}>> é invocado(a) sob seu controle.[/bulletlist]"

msgid "TOME_ARCHDRUID@SKILL5@NAME"
msgstr "Despertar a Floresta"

msgid "TOME_ARCHDRUID@SKILL5@UNIT_DESCRIPTION"
msgstr "Um(a) poderoso(a) guardião(ã) da natureza e a personificação de sua fúria. Capaz de invocar e curar."

msgid "TOME_ARCHDRUID@SKILL5@UNIT_NAME"
msgstr "Deus Chifrudo^n"

msgid "TOME_ARCHDRUID@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Concede feitiços poderosos que liberam o poder incontrolável da natureza."

msgid "TOME_ARCHDRUID@TOME@LORE_AUTHOR"
msgstr "Serena, Feiticeira Élfica da Vida"

msgid "TOME_ARCHDRUID@TOME@LORE_DESCRIPTION"
msgstr "\"A natureza é a folha ao vento, o cordeiro recém-nascido. Mas também é a tempestade furiosa que rasga a terra, o poderoso turbilhão que despedaça pedra e carne. A natureza pode ser cruel, implacável... poderosa! Domine-a e você comandará as energias primordiais que deixam os seres inferiores tremendo de medo.\""

msgid "TOME_ARCHDRUID@TOME@NAME"
msgstr "Tomo da Ira da Natureza"

msgid "TOME_ARCHDRUID@UNIT1@ABILITY1@JUMP@DESCRIPTION"
msgstr "Cura uma unidade aliada adjacente ao alvo +{RECLAIMING_BOLT_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>."

msgid "TOME_ARCHDRUID@UNIT1@ABILITY1@JUMP@NAME"
msgstr "Reivindicar"

msgid "TOME_ARCHDRUID@UNIT1@ABILITY1@NAME"
msgstr "Raio Recuperador"

msgid "TOME_ARCHDRUID@UNIT1@ABILITY2@DESCRIPTION"
msgstr "Em um raio de {WILD_ERUPTION_POSITION_TARGETER_CIRCLE>AREA>Radius} hexes:[bulletlist][bullet/]Causa {GLOBAL.PhysicalDamageConcept.Hyperlink} a todas as unidades e obstáculos.[bullet/]Invoca Vinhas Vivas em cada hex vazio.[/bulletlist]"

msgid "TOME_ARCHDRUID@UNIT1@ABILITY2@NAME"
msgstr "Erupção Selvagem"

msgid "TOME_ARCHDRUID@UNIT1@ABILITY3@DESCRIPTION"
msgstr "O alvo {GLOBAL.FloraObstacleConcept.Hyperlink} se transforma em uma unidade {GLOBAL.UNITS.FLORAL_STINGER.Hyperlink} sob seu controle.{LOC.CONCEPT@SUMMON_LIVE_SHARED}"

msgid "TOME_ARCHDRUID@UNIT1@ABILITY3@NAME"
msgstr "Animar Flora"

msgid "TOME_ARCHDRUID@UNIT1@ABILITY4@DESCRIPTION"
msgstr "Unidades aliadas {GLOBAL.PROPERTIES.ANIMAL.Hyperlink} e {GLOBAL.PROPERTIES.PLANT.Hyperlink} estão {GLOBAL.PROPERTIES.FEARLESS.Hyperlink}."

msgid "TOME_ARCHDRUID@UNIT1@ABILITY4@NAME"
msgstr "Pastor dos Ermos"

msgid "TOME_ARCHDRUID@VINE_ERUPTION@DESCRIPTION"
msgstr "Em um raio de {radius} hexes [range/]:[bulletlist][bullet/]Unidades sofrem {GLOBAL.BlightDamageConcept.Hyperlink}.[bullet/]Obstáculos sofrem dano dobrado.[/bulletlist]"

msgid "TOME_ARCHDRUID@VINE_ERUPTION@NAME"
msgstr "Erupção de Vinhas"

msgid "TOME_ARCH_MAGE@HERO_SKILL@DESCRIPTION"
msgstr "Concede {GLOBAL.MagicConcept.Hyperlink} ataques:[bulletlist][bullet/]+{MAXIMIZED_MAGIC_CRITICAL_CHANCE>ResolvedCritChanceBonus}% de {GLOBAL.CriticalHitChanceConcept.Hyperlink}[bullet/]+{MAXIMIZED_MAGIC_ACCURACY_BOOST>ResolvedAccuracyModifier}% de {GLOBAL.AccuracyConcept.Hyperlink}[/bulletlist]"

msgid "TOME_ARCH_MAGE@HERO_SKILL@MODIFIER@DESCRIPTION"
msgstr "Concede +{MAXIMIZED_MAGIC_CRITICAL_CHANCE>ResolvedCritChanceBonus}% de {GLOBAL.CriticalHitChanceConcept.Hyperlink} e +{amount2}% de {GLOBAL.AccuracyConcept.Hyperlink}."

msgid "TOME_ARCH_MAGE@HERO_SKILL@NAME"
msgstr "Magia Maximizada"

msgid "TOME_ARCH_MAGE@PASSIVE@DESCRIPTION"
msgstr "Quando seu(sua) {GLOBAL.LeaderConcept} entra em batalha, a unidade ganha {amount} <<m:{GLOBAL.CombatCastingPointConcept}>> até o fim da batalha."

msgid "TOME_ARCH_MAGE@PASSIVE@NAME"
msgstr "Mestre Tecelão de Feitiços"

msgid "TOME_ARCH_MAGE@SKILL1@DESCRIPTION"
msgstr "Faz seu líder se teletransportar para o hex alvo no mundo."

msgid "TOME_ARCH_MAGE@SKILL1@NAME"
msgstr "Viagem Astral"

msgid "TOME_ARCH_MAGE@SKILL2@DESCRIPTION"
msgstr "Unidades inimigas em um raio de {TIME_STOP_UNIT_TARGETER_CIRCLE>AREA>Radius} hexes:[bulletlist][bullet/]Ficam {GLOBAL.PROPERTIES.STUNNED.Hyperlink} por {STUNNED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Ficam {GLOBAL.PROPERTIES.DISTRACTED.Hyperlink} por {DISTRACTED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Ganham {stacks} {GLOBAL.PROPERTIES.MARKED.Hyperlink} por {MARKED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "TOME_ARCH_MAGE@SKILL2@NAME"
msgstr "Parada no Tempo"

msgid "TOME_ARCH_MAGE@SKILL3@DESCRIPTION"
msgstr "Concede a unidades encantadas:[bulletlist][bullet/]+{COSMIC_OVERDRIVE_DAMAGE_MULTIPLIER>ResolvedMultiplier}% de dano.[bullet/]{GLOBAL.PROPERTIES.VERY_FAST_MOVEMENT.Hyperlink}.[/bulletlist]"

msgid "TOME_ARCH_MAGE@SKILL3@NAME"
msgstr "Sobrecarga Cósmica"

msgid "TOME_ARCH_MAGE@SKILL3@PROPERTY_DESCRIPTION"
msgstr "A unidade tem:[bulletlist][bullet/]+{COSMIC_OVERDRIVE_DAMAGE_MULTIPLIER>ResolvedMultiplier}% de dano.[bullet/]{GLOBAL.PROPERTIES.VERY_FAST_MOVEMENT.Hyperlink}.[/bulletlist]"

msgid "TOME_ARCH_MAGE@SKILL4@DESCRIPTION"
msgstr "[bulletlist][bullet/]Unidades inimigas têm {DISRUPTION_RESISTANCE>ResolvedStrength}% de chance base de se tornarem {GLOBAL.PROPERTIES.DISRUPTION_TOOLTIP_PROPERTY.Hyperlink} por {DISRUPTION_DISABLE>Duration} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Dissipa {DISRUPTION_WAVE_PROPERTY_DISPEL_ENEMIES>NumThingsToDispel} <<m:{GLOBAL.PositiveStatusEffectConcept.Hyperlink}>> dos inimigos.[bullet/]Dissipa {DISRUPTION_WAVE_DISPEL_ALLIES>NumThingsToDispel} <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>> dos aliados.[/bulletlist]"

msgid "TOME_ARCH_MAGE@SKILL4@NAME"
msgstr "Onda de Disrupção"

msgid "TOME_ARCH_MAGE@SKILL5@NAME"
msgstr "Era Astral"

msgid "TOME_ARCH_MAGE@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Alcance o ápice das artes arcanas dobrando o espaço e o tempo à sua vontade."

msgid "TOME_ARCH_MAGE@TOME@LORE_AUTHOR"
msgstr "Conselheiro-Mor Gabriel, Guardião de Evermore"

msgid "TOME_ARCH_MAGE@TOME@LORE_DESCRIPTION"
msgstr "\"Quando sua capacidade de comandar o arcano atinge seu ápice, você percebe que sua conexão com o Mar Astral começa a transbordar para este reino e afeta sua própria realidade. Distância, por exemplo, é um problema para seres inferiores. Para você, o canto mais distante do mundo está a apenas um pensamento de distância.\""

msgid "TOME_ARCH_MAGE@TOME@NAME"
msgstr "Tomo do Arquimago"

msgid "TOME_ARTIFICER@PASSIVE@DESCRIPTION"
msgstr "<<m:{GLOBAL.SiegeProjectConcept}>> são {amount}% mais baratos(as)."

msgid "TOME_ARTIFICER@TOME@LORE_AUTHOR"
msgstr "Edward Portsmith, Último Dreadnought da Comunidade"

msgid "TOME_ARTIFICER@TOME@LORE_DESCRIPTION"
msgstr "\"Engenhosidade, gosto de pensar, é a expressão máxima do gênio tornado físico. Traduzir algo tão intangível quanto uma ideia em um autômato funcional e ambulante é realmente algo magnífico. Quando se pode transformar tais criações em gigantes, unindo máquina e magia capazes de arrasar ou erguer uma cidade... pode-se verdadeiramente reivindicar o título de artífice!\""

msgid "TOME_ARTIFICER@TOME@NAME"
msgstr "Tomo da Arte da Engenharia"

msgid "TOME_ARTIFICING@ABILITY1@DESCRIPTION"
msgstr "Esta unidade termina seu turno e entra em modo defensivo:[bulletlist][bullet/]Estende seu(sua) {GLOBAL.ZoneOfControlConcept.Hyperlink} para todos os hexes adjacentes.[bullet/]Ganha +{PROTECTIVE_WALL_DEFENSE_INCREASE>DEF_MOD>Armor} {GLOBAL.DefenseConcept.Hyperlink}.[bullet/]Ganha +{PROTECTIVE_WALL_DEFENSE_INCREASE>DEF_MOD>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}.[bullet/]Imune a {GLOBAL.FlankingConcept.Hyperlink}.[bullet/]Todas as unidades amigas adjacentes ganham +{SHIELD_DEFENSE_DEFENSE>DEF_MOD>Armor} {GLOBAL.DefenseConcept.Hyperlink}[bullet/]Todas as unidades amigas adjacentes ganham +{PROTECTIVE_WALL_STATUS_RESISTANCE>Resistance} {GLOBAL.StatusResistanceConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_ARTIFICING@ABILITY1@NAME"
msgstr "Modo Defesa: Muralha Protetora"

msgid "TOME_ARTIFICING@ABILITY1@PROP_NAME"
msgstr "Muralha Protetora"

msgid "TOME_ARTIFICING@ABILITY2@DESCRIPTION"
msgstr "Causa dano em um raio de {HAIL_OF_BOLTS_UNIT_TARGETER>AREA>Radius} hexes."

msgid "TOME_ARTIFICING@ABILITY2@NAME"
msgstr "Grande Raio"

msgid "TOME_ARTIFICING@PASSIVE@NAME"
msgstr "Engenheiros Artesãos"

msgid "TOME_ARTIFICING@SKILL1@DESCRIPTION"
msgstr "[bulletlist]No início da batalha, ganhe {amount} {GLOBAL.UNITS.BOLT_REPEATER_UNIT.Hyperlink} unidades do lado do atacante até o fim da batalha.[bullet/] <<m:{GLOBAL.UNITS.BOLT_REPEATER_UNIT.Hyperlink}>> são {GLOBAL.PROPERTIES.SIEGECRAFT_UNIT.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> imóveis com ataques de longo alcance e área de efeito repetitivos, ao contrário de <<m:{GLOBAL.UNITS.CATAPULT_UNIT.Hyperlink}>>.[bullet/]Apenas um tipo de unidade de Cerco pode ser levado para {GLOBAL.CombatConcept.Hyperlink}. Se vários <<m:{GLOBAL.SiegeProjectConcept.Hyperlink}>> trouxerem essas unidades, apenas a mais forte aparecerá.[/bulletlist]"

msgid "TOME_ARTIFICING@SKILL1@NAME"
msgstr "Construir Repetidores de Dardos"

msgid "TOME_ARTIFICING@SKILL2@DESCRIPTION"
msgstr "Concede a unidades encantadas:[bulletlist][bullet/]+{ARTISAN_BLADES_CRITICAL_CHANCE>ResolvedCritChanceBonus}% de {GLOBAL.CriticalHitChanceConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_ARTIFICING@SKILL2@NAME"
msgstr "Armamentos Artesanais"

msgid "TOME_ARTIFICING@SKILL2@PROP_DESCRIPTION"
msgstr "A unidade tem:[bulletlist][bullet/]+{ARTISAN_BLADES_CRITICAL_CHANCE>ResolvedCritChanceBonus}% de {GLOBAL.CriticalHitChanceConcept.Hyperlink}.[/bulletlist]"

