msgid "DLC@GIANTKINGS@DIPLOMACY@CRYSTAL_DWELLING@STONE_PACT@DESRCIPTION"
msgstr "[bulletlist][bullet/]O {GLOBAL.CrystalDwellingConcept.Hyperlink} abre suas fronteiras.[bullet/]Desbloqueia a compra dos seguintes itens comerciais via Cooperação:[bulletlist][bullet/]{GLOBAL.TOKENDEFINITION.LITHORITE_SCROLL_ARTIFACT.Hyperlink}[bullet/]{GLOBAL.UNITS.LITHORINE_NEEDLER.Hyperlink}[bullet/]{GLOBAL.EQUIPMENT.GOLDSEEKERS_PICKAXE.Hyperlink}[bullet/]{GLOBAL.EQUIPMENT.LITHORITE_ORB.Hyperlink}[bullet/]{GLOBAL.EQUIPMENT.SHATTER_BLADES.Hyperlink}[bullet/]{GLOBAL.EQUIPMENT.TITANS_GREATBOW.Hyperlink}[/bulletlist][bullet/]Completar missões de Moradia recompensa itens garantidos de herói, além das outras recompensas.[/bulletlist]"

