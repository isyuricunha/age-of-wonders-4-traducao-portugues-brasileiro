msgid "DLC@RISEFROMRUIN@CULTURE_NOMAD@MARKER@LOOT@DESCRIPTION"
msgstr "Pode ser recolhido por qualquer unidade com a propriedade {GLOBAL.PROPERTIES.SCAVENGER.Hyperlink} movendo-se para este hexágono.[br/]Ao recolher, a unidade:[bulletlist][bullet/]Ganha {GLOBAL.PROPERTIES.LOOTED_POWER.Hyperlink}.[bullet/]Cura +{HealBonus} {GLOBAL.HitPointConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@CULTURE_NOMAD@MARKER@LOOT@HYPERLINK"
