msgid "TOME_DEMON_GATE@SKILL4@NAME"
msgstr "Matança Sacrificial"

msgid "TOME_DEMON_GATE@SKILL5@DESCRIPTION"
msgstr "Alvo {GLOBAL.ProvinceConcept.Hyperlink}:[bulletlist][bullet/]Inimigo <<m:{GLOBAL.UnitConcept.Hyperlink}>> sofre -{amount} {GLOBAL.FireResistanceConcept.Hyperlink} por {duration} {GLOBAL.WorldMapConcept.Hyperlink} {GLOBAL.TurnConcept}.[bullet/]As províncias ganham {GLOBAL.AshlandsConcept.Hyperlink}.[bullet/]As províncias perdem {GLOBAL.RiverConcept.Hyperlink}, {GLOBAL.FertilePlainsConcept.Hyperlink}, {GLOBAL.SwampConcept.Hyperlink}, {GLOBAL.SnowConcept.Hyperlink}, {GLOBAL.FrozenWasteConcept.Hyperlink}, {GLOBAL.SandConcept.Hyperlink}, {GLOBAL.CavernFloorConcept.Hyperlink} e {GLOBAL.GloomTerrainConcept.Hyperlink}.[bullet/]Convoque um {GLOBAL.UNITS.MAGMA_SPIRIT.Hyperlink} no hexágono alvo.[/bulletlist]"

