msgid "DIPLOMATICSTATES_DEFINITIONS@BREAK_VASSALAGE@NAME"
msgstr "Encerrar Vassalagem"

msgid "DIPLOMATICSTATES_DEFINITIONS@CONSULATE@AI_DESC"
msgstr "Um vínculo de feiticeiros melhorará nossas relações e expandirá nossas opções diplomáticas."

msgid "DIPLOMATICSTATES_DEFINITIONS@CONSULATE@DESCRIPTION"
msgstr "Tanto <<m:{GLOBAL.LeaderConcept.Hyperlink}>> concordam em estabelecer um vínculo de feiticeiros para melhorar {GLOBAL.EmpireRelationConcept.Hyperlink} e acessar novos <<m:{GLOBAL.TreatyConcept.Hyperlink}>> e Estados Diplomáticos.[br/][br/]Efeitos:[bulletList][bullet/]Os {GLOBAL.ThroneCityConcept.Hyperlink} de cada Governante serão revelados.[bullet/]Os Governantes podem [hyperlink,GLOBAL.CallToWarConcept]convocar um ao outro para a guerra[/hyperlink].[/bulletList][br/][br/]Leva a:[bulletlist][bullet/]{GLOBAL.DefensivePactConcept.Hyperlink}[bullet/]{GLOBAL.OpenBordersConcept.Hyperlink}[bullet/]{GLOBAL.AllowClaimedSectorsConcept.Hyperlink}[bullet/]{GLOBAL.TeleporterPactConcept.Hyperlink}[/bulletlist]"

msgid "DIPLOMATICSTATES_DEFINITIONS@CONSULATE@HYPERLINK"
