msgid "CONCEPT@HERO_CLASS@WARRIOR@DESCRIPTION_SHORT"
msgstr "Uma classe de herói especializada em ataques de carga, causando dano e ganhando força durante o combate."

msgid "CONCEPT@HERO_CLASS@WARRIOR@GAMEPLAY_HYPERLINK"
