msgstr "Enquanto esta unidade estiver em combate, unidades Animais e Dragões ganham:[bulletlist][bullet/]+{BEASTMASTER_STAT_BONUS>BONUS>DEFENSE>Armor} {GLOBAL.DefenseConcept.Hyperlink}[bullet/]+{BEASTMASTER_STAT_BONUS>BONUS>DEFENSE>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}[bullet/]+{BEASTMASTER_DAMAGE>ResolvedMultiplier}% de dano[/bulletlist]"

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_09@NAME"
msgstr "Mestre das Feras"

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_09@PROP_DESCRIPTION"
msgstr "A unidade tem:[bulletlist][bullet/]+{BEASTMASTER_STAT_BONUS>BONUS>DEFENSE>Armor} {GLOBAL.DefenseConcept.Hyperlink}[bullet/]+{BEASTMASTER_STAT_BONUS>BONUS>DEFENSE>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}[bullet/]+{BEASTMASTER_DAMAGE>ResolvedMultiplier}% de dano[/bulletlist]"

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_10@DESCRIPTION"
msgstr "Quando esta unidade morre, unidades aliadas Animais e Dragões ganham:[bulletlist][bullet/]{amount} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} por {STRENGTHENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]{GLOBAL.PROPERTIES.BERSERK.Hyperlink} por {BERSERK_DESCRIPTION_2>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_10@NAME"
msgstr "Pai do Rebanho"

msgid "DLC@GIANTKINGS@SOTTK_FINISHER@CULT_LEADER_EFFECTS_TOOLTIP"
msgstr "Sempre que você conjurar um feitiço de maldição de alma, há uma chance de {IntChance}% de um exército de cultistas se juntar ao seu governante. A força desse exército escala com o nível do feitiço de maldição de alma conjurado. Quando vários desses efeitos extras de conjuração de maldição de alma puderem ser acionados, suas chances de acionamento são somadas, mas um máximo de {IntMax} efeitos são acionados."

msgid "DLC@GIANTKINGS@SOTTK_FINISHER@CULT_LEADER_TOOLTIP"
msgstr "Pelo resto do jogo, você se torna o Líder do Culto do {GLOBAL.TraitorKingCultLoreConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@SPAWNERS@LITHORINE_SPAWNER@DESCRIPTION"
msgstr "Uma formação cristalina que replica o Litório de maneira descontrolada.[br/]Se não for controlada, crescerá em força, expandirá seu território e enviará exércitos invasores."

msgid "DLC@GIANTKINGS@SPAWNERS@LITHORINE_SPAWNER@LORE"
msgstr "Um jardim potente que cultiva rochas e Litório, expelindo hordas territoriais de aberrações em forma de pedra. Os Gigantes Anciões da há muito perdida Mirrida um dia criaram e comandaram os organismos sintéticos coloquialmente chamados de Litorinos. Desafiando a Natureza, as criaturas neste jardim de alguma forma reproduzem sua centelha de vida. Evidentemente, até mesmo a vida sintética acaba encontrando um jeito."

msgid "DLC@GIANTKINGS@SPAWNERS@LITHORINE_SPAWNER@NAME"
msgstr "Berço Litorino"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_722@BODY_FOOTER"
msgstr "O {EnemyUnit} fugitivo nota os guerreiros. Com um rosnado, <<p:EnemyUnit>> agarra um {EventUnit} próximo e o arremessa em {EventHero.FirstName}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_722@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "O {EnemyUnit} fugitivo nota seus guerreiros. Com um rosnado, <<p:EnemyUnit>> agarra um {EventUnit} próximo e o arremessa em você."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_722@BODY_HEADER"
msgstr "<<G:army^n,EventHero>> segue sons de rachaduras e estrondos até uma poça de lava, na qual um imponente {EventStructure} foi construído."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_722@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Seu exército segue sons de rachaduras e estrondos até uma poça de lava, na qual um imponente {EventStructure} foi construído."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_722@BODY_LORE"
msgstr "Lá dentro, {EventHero.FirstName} encontra <<a:EnemyUnit>> fugido da cela <<o:EnemyUnit>>, agachado no chão da prisão. Dezenas de criaturas Litorinas, que fizeram sua colmeia aqui, rastejam ao redor de <<P:EnemyUnit>>. O {EnemyUnit} pega dois <<m:EventUnit>> e os esmaga um contra o outro. Para <<G:bewilderment^n,{EventHero.FirstName}>>, e o <<G:entertainment^n,EnemyUnit>>, os <<m:EventUnit>> se reagrupam em um {EventUnitB}!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_722@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Lá dentro, você encontra <<a:EnemyUnit>> fugido da cela <<o:EnemyUnit>>, agachado no chão da prisão. Dezenas de criaturas Litorinas, que fizeram sua colmeia aqui, rastejam ao redor de <<P:EnemyUnit>>. O {EnemyUnit} pega dois <<m:EventUnit>> e os esmaga um contra o outro. Para seu espanto, e o <<G:entertainment^n,EnemyUnit>>, os <<m:EventUnit>> se reagrupam em um {EventUnitB}!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_722@BUTTON_0"
msgstr "\"Defendam-se! Às armas!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_722@BUTTON_1"
msgstr "Lance um feitiço de atordoamento emergencial [mana/] no <<m:EventUnit>>."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_722@BUTTON_2"
msgstr "Manipule a velocidade de movimento das pragas Litorinas."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_722@BUTTON_3"
msgstr "Fugir da cena."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_722@BUTTON_4"
msgstr "\"Até os mais poderosos caem diante de mil golpes dados como um só, tropas!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_722@BUTTON_5"
msgstr "Ordene que mineradores [structureprod/] de {EventCity} ataquem as carapaças das criaturas Litorinas."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_722@TITLE"
msgstr "Argila Primordial"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_723@BODY_FOOTER"
msgstr "Carcaças de Litorinos são enviadas para {EventCity} para serem usadas como materiais de construção. O que mais você confiscará antes de deixar o <<G:walls^p,EventStructure>>?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_723@BODY_HEADER"
msgstr "O último dos bichinhos Litorinos desmorona. O {EnemyUnit} jaz aos pés de <<G:feet^p,EventHero>>, derrotado."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_723@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "O último dos bichinhos Litorinos desmorona. O {EnemyUnit} jaz aos seus pés, derrotado."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_723@BODY_LORE"
msgstr "{EventHero.FirstName} deduz que a infestação de Litorinos tornou as paredes da prisão porosas e frágeis, permitindo que o {EnemyUnit} escapasse. A besta finalmente ergue <<r:EnemyUnit>> e observa <<G:every action^n,{EventHero.FirstName}>> cautelosamente. Usando gestos, seu [hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink] comunica ao {EnemyUnit} que <<p:EventHero>> libertará <<P:EnemyUnit>> da {EventStructure} se <<p:EnemyUnit>> estiver disposto a lutar por você. O colosso acaba assentindo."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_723@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Você deduz que a infestação de Litorinos tornou as paredes da prisão porosas e frágeis, permitindo que o {EnemyUnit} escapasse. A besta finalmente ergue <<r:EnemyUnit>> e observa cada um de seus movimentos cautelosamente. Usando gestos, você comunica ao {EnemyUnit} que libertará <<P:EnemyUnit>> da {EventStructure} se <<p:EnemyUnit>> estiver disposto a lutar por você. O colosso acaba assentindo."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_723@BUTTON_0"
msgstr "Extraia gemas preciosas [gold/] das carcaças de Litorina."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_723@BUTTON_1"
msgstr "Reconstrua um {EventUnit} a partir dos escombros. [unit/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_723@BUTTON_2"
msgstr "O membro de um {EventUnitB} servirá como um {EventItem}. [item/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_723@TITLE"
msgstr "Argila Primordial: Consequências"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_724@BODY_FOOTER"
msgstr "Quando o <<G:collar^n,EnemyUnit>> se quebrar, <<o:EnemyUnit>> poder total retornará! Como {EventHero.FirstName} defenderá <<r:EventHero>> contra os parentes e aliados de <<o:EnemyUnit>>?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_724@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Quando o <<G:collar^n,EnemyUnit>> se quebrar, <<o:EnemyUnit>> poder total retornará! Como você se defenderá contra os parentes e aliados de <<o:EnemyUnit>>?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_724@BODY_HEADER"
msgstr "Enquanto <<G:troops^p,EventHero>> marcham rumo ao temível {EventStructure}, {EventHero.FirstName} percebe sulcos rasos na lama quente, levando à sua entrada. <<Cp:EventHero>> entra."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_724@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Enquanto suas tropas marcham rumo ao temível {EventStructure}, você percebe sulcos rasos na lama quente, levando à sua entrada. Você entra."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_724@BODY_LORE"
msgstr "Cheira a ácido aqui dentro. Murais imponentes retratam como os destemidos {GLOBAL.GiantsLoreConcept.Hyperlink} subjugaram bestas colossais da {GLOBAL.UrwildernessLoreConcept.Hyperlink}. Os murais destacam um {EnemyUnit} excepcionalmente cruel e seu eventual aprisionamento por [hyperlink,GLOBAL.ArchonsLoreConcept]Arcontes[/hyperlink]. {EventHero.FirstName} logo descobre uma terrível verdade: esta {EventStructure} abriga aquele mesmo {EnemyUnit}! Pior ainda, adoradores da Serpente <<o:EnemyUnit>> quebraram as correntes de <<o:EnemyUnit>> e agora tentam corroer a coleira dos Arcontes de <<o:EnemyUnit>>!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_724@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "O cheiro aqui dentro é de ácido. Murais imponentes retratam como os destemidos {GLOBAL.GiantsLoreConcept.Hyperlink} subjugaram beemotes do {GLOBAL.UrwildernessLoreConcept.Hyperlink}. Os murais destacam um {EnemyUnit} excepcionalmente implacável e seu eventual aprisionamento pelos [hyperlink,GLOBAL.ArchonsLoreConcept]Arcontes[/hyperlink]. Logo você descobre uma verdade terrível: esta {EventStructure} abriga aquele mesmo {EnemyUnit}! Pior ainda, adoradores da Serpente <<o:EnemyUnit>> romperam as correntes <<o:EnemyUnit>> e agora tentam corroer a coleira dos <<o:EnemyUnit>>Arcontes!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_724@BUTTON_0"
msgstr "Avance para decepar a cabeça de <<o:EnemyUnit>>!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_724@BUTTON_1"
msgstr "Neutralize as poças cáusticas das Serpentes com feitiços simples. [mana/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_724@BUTTON_2"
msgstr "Reforce a coleira do Arconte para atrasar o <<G:escape^n,EnemyUnit>>"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_724@BUTTON_3"
msgstr "Recue da cova primordial das serpentes."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_724@BUTTON_4"
msgstr "Provoque as Serpentes a se atacarem!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_724@BUTTON_5"
msgstr "Tome o remédio {EventCity} [food/] para se proteger do veneno das Serpentes."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_724@TITLE"
msgstr "Guerras das Serpes"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_725@BODY_FOOTER"
msgstr "Em breve, os vapores corrosivos persistentes derreterão tudo dentro do {EventStructure}. O que {EventHero} levará, antes que seja tarde demais?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_725@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Em breve, os vapores corrosivos persistentes derreterão tudo dentro do {EventStructure}. O que você levará, antes que seja tarde demais?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_725@BODY_HEADER"
msgstr "Com veneno e ácido na altura dos joelhos, seus guerreiros vitoriosos estão cercados por Serpentes mortas. E um {EnemyUnit} abatido."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_725@BODY_LORE"
msgstr "{EventUnit} atordoado tenta rastejar discretamente para fora. {EventHero.FirstName} mal presta atenção em <<P:EventUnit>>, inspecionando, em vez disso, o cadáver já em decomposição do Basilisco. <<Cp:EventHero>> arranca um dos <<G:fangs^p,EnemyUnit>> e julga que serve como um {EventItem}. Só então <<p:EventHero>> descobre o ovo do Basilisco. Ele balança e racha. A cria do Basilisco pode ser criada para lutar por você!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_725@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Um {EventUnit} atordoado tenta rastejar discretamente para fora. Você mal presta atenção em <<P:EventUnit>>, inspecionando, em vez disso, o cadáver já em decomposição do Basilisco. Você arranca um dos <<G:fangs^p,EnemyUnit>> e julga que serve como um {EventItem}. Só então você descobre o ovo do Basilisco. Ele balança e racha. A cria do Basilisco pode ser criada para lutar por você!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_725@BUTTON_0"
msgstr "Coletar as escamas e presas das Serpentes caídas. [unitprod/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_725@BUTTON_1"
msgstr "Capturar o(a) {EventUnit} [unit/] antes que fuja rastejando."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_725@BUTTON_2"
msgstr "Criar um novo(a) {EventUnitB} [unit/] a partir do(a) <<G:corpse^n,EnemyUnit>>."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_725@BUTTON_3"
msgstr "Aprender a usar o(a) <<G:poison^n,EnemyUnit>> [knowledge/] em batalha."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_725@GUARANTEED_REWARD_PRISONER"
msgstr "Você obtém acesso ao Prisioneiro Primordial Livre, que lhe concede um(a) {unit}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_725@TITLE"
msgstr "Guerras dos Vermes: Consequências"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_736@BODY_FOOTER"
msgstr "\"Apoiará nossa missão?\" Os {GLOBAL.EternalSagesLoreConcept.Hyperlink} buscam colaborar com você em troca de segredos dos cofres de {EventHouse}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_736@BODY_HEADER"
msgstr "Uma formação flutuante de rostos de pedra se dirige a você: \"Nós o saudamos.\" A voz monótona de {EventHouseLord.FirstName} do(a) {GLOBAL.CrystalDwellingConcept.Hyperlink} de {EventHouse.Name} ressoa dentro do seu crânio."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_736@BODY_LORE"
msgstr "A entidade de rosto de pedra continua: \"Não tema, pois não pretendemos lhe fazer mal. Já compartilhamos suas ambições, quando ainda governávamos poderosos(as) {GLOBAL.MyrridaLoreConcept.Hyperlink}. Agora somos ainda maiores. Somos os(as) {GLOBAL.EternalSagesLoreConcept.Hyperlink}. Observamos. Registramos. Preservamos e coletamos tudo o que o cosmos contém.\" Os rostos da formação não demonstram emoção, mas há um tom esperançoso em sua voz."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_736@BUTTON_0"
msgstr "Inspecionar o(a) {GLOBAL.EternalSagesLoreConcept.Name} de {EventHouse}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_736@BUTTON_1"
msgstr "\"Deixarei você com suas buscas por conhecimento.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_736@BUTTON_2"
msgstr "Descobrir quais missões os(as) {GLOBAL.EternalSagesLoreConcept.Name} têm a oferecer."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_736@TITLE"
msgstr "Encontro com os(as) {EventHouse} Sedentários(as)"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_737@BODY_FOOTER"
msgstr "\"Nós, os(as) {GLOBAL.EternalSagesLoreConcept.Name}, recompensaremos sua ajuda\", conclui {EventHouseLord}. \"Você está eternamente convidado ao nosso(a) {GLOBAL.CrystalDwellingConcept.Hyperlink} para trocar conhecimento e segredos.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_737@BODY_HEADER"
msgstr "Uma formação flutuante de rostos de pedra se dirige a você: \"{EventHouse} o(a) recebe, <<PlayerLeader{brother/sister}>>. Eu sou {EventHouseLord.FirstName}.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_737@BODY_LORE"
msgstr "\"Compartilhamos uma antiga afinidade, embora nossos caminhos tenham se separado há eras.\" Você já ouviu falar dos(as) [hyperlink,GLOBAL.GiantKingLoreConcept]Gigantes Anciões[/hyperlink] que se transformaram em cristais para preservar não apenas a si mesmos, mas também seu conhecimento. \"Nós, estudiosos do cosmos, notamos com interesse sua mobilidade, Gigante. Não por inveja. Mas por utilidade. Assim como nossos(as) {EventHouseRace}, nossa sabedoria pode guiá-lo à erudição.\" A voz da entidade de rosto de pedra é monótona, mas não sem um tom esperançoso."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_737@BUTTON_0"
msgstr "Inspecionar o assentamento de cristais de {EventHouse}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_737@BUTTON_1"
msgstr "\"Adeus. Talvez um dia você possa me ensinar os segredos perdidos de Myrrida.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_737@BUTTON_2"
msgstr "Oferecer ajuda ao {GLOBAL.EternalSagesLoreConcept.Name} em uma busca por conhecimento."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_737@TITLE"
msgstr "Encontro com os Perpétuos {EventHouse}"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BODY_FOOTER"
msgstr "O {EventStackLeader} e o grupo {EventHouseRace} são exploradores enviados pelo {GLOBAL.CrystalDwellingConcept.Hyperlink}. Como {EventHero.FirstName} vai proceder?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "O {EventStackLeader} e o grupo {EventHouseRace} são exploradores enviados pelo {GLOBAL.CrystalDwellingConcept.Hyperlink}. Como você vai proceder?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BODY_HEADER"
msgstr "Suas tropas encontram um bando de guerreiros de {EventHouse} observando um {EventStructure} em silêncio. <<Ca:EventStackLeader>> nota você."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Suas tropas encontram um bando de guerreiros de {EventHouse} observando um {EventStructure} em silêncio. <<Ca:EventStackLeader>> nota {EventHero}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BODY_HEADER@NO_HERO_IN_STACK"
msgstr "Suas tropas encontram um bando de guerreiros de {EventHouse} observando um {EventStructure} em silêncio. <<Ca:EventStackLeader>> nota seu exército."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BODY_LORE"
msgstr "Enquanto as tropas de <<o:EventStackLeader>> continuam a observar o {EventStructure} como estátuas, o {EventStackLeader} se vira para encarar {EventHero.FirstName}. <<Cp:EventStackLeader>> recita um discurso decorado: \"Este território está sendo mapeado pelos {GLOBAL.EternalSagesLoreConcept.Hyperlink}. Nossa missão é registrar conhecimentos ainda não coletados. Por favor, deixe-nos trabalhar.\" O {EventStackLeader} observa {EventHero.FirstName}, mas o olhar de <<o:EventStackLeader>> está vazio, como se estivesse ouvindo algo — ou alguém — distante."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Enquanto as tropas de <<o:EventStackLeader>> continuam a observar o {EventStructure} como estátuas, o {EventStackLeader} se vira para encarar você. <<Cp:EventStackLeader>> recita um discurso decorado: \"Este território está sendo mapeado pelos {GLOBAL.EternalSagesLoreConcept.Hyperlink}. Nossa missão é registrar conhecimentos ainda não coletados. Por favor, deixe-nos trabalhar.\" O {EventStackLeader} observa você, mas o olhar de <<o:EventStackLeader>> está vazio, como se estivesse ouvindo algo — ou alguém — distante."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BODY_LORE@NO_HERO_IN_STACK"
msgstr "Enquanto as tropas de <<o:EventStackLeader>> continuam a observar o {EventStructure} como estátuas, o {EventStackLeader} se vira para encarar seus guerreiros. <<Cp:EventStackLeader>> recita um discurso decorado: \"Este território está sendo mapeado pelos {GLOBAL.EternalSagesLoreConcept.Hyperlink}. Nossa missão é registrar conhecimentos ainda não coletados. Por favor, deixe-nos trabalhar.\" O {EventStackLeader} observa seu exército, mas o olhar de <<o:EventStackLeader>> está vazio, como se estivesse ouvindo algo — ou alguém — distante."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BUTTON_0"
msgstr "Ajudar o {EventStackLeader} a concluir seu levantamento [knowledge/] do {EventStructure}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BUTTON_1"
msgstr "\"Esqueça este {EventStructure}. Entregue meu {EventItem} [item/] ao {GLOBAL.EternalSagesLoreConcept.Name} para exame.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BUTTON_2"
msgstr "Presentear cristais mágicos [mana/] ao {EventHouse} para fazer os guerreiros do {EventHouseRace} partirem."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BUTTON_3"
msgstr "Forçar os guerreiros imbuídos de cristal a abandonar o {EventStructure}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BUTTON_4"
msgstr "Atacar os servos imóveis do {GLOBAL.EternalSagesLoreConcept.Name}!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BUTTON_5"
msgstr "Deixar o {EventStructure} para os guerreiros do {GLOBAL.EternalSagesLoreConcept.Name}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@TITLE"
msgstr "Eruditos Eternos"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_764@BODY_FOOTER"
msgstr "\"Já que não podemos sair de {EventHouse}, agradecemos sua capacidade de recuperar o que não conseguimos obter sozinhos,\" concluem os {GLOBAL.EternalSagesLoreConcept.Hyperlink}. \"Por favor, considere nos ajudar em uma busca por conhecimento.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_764@BODY_HEADER"
msgstr "O {GLOBAL.EternalSagesLoreConcept.Hyperlink} entra em contato com você de dentro de sua biblioteca cristalina em {EventHouse}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_764@BODY_LORE"
msgstr "\"Saudações, {PlayerLeader.TitleName},\" murmura o {EventHouseLord}. \"Faz algum tempo desde a última vez que nos comunicamos. Como sabe, vasculhamos o reino em busca de conhecimento. Buscamos registrar e preservar todo o saber do cosmos. Supomos que você teria interesse em ajudar nossa causa. Naturalmente, recompensaremos seus esforços.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_764@BUTTON_2"
msgstr "Rejeite a oferta apresentada pelo(a) {GLOBAL.EternalSagesLoreConcept.Name}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_764@TITLE"
msgstr "Sede Eterna Encantadora"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@BODY_FOOTER"
msgstr "Os guerreiros animados de argila miram suas armas em {EventHero.FirstName}, obrigados a proteger seu criador: o(a) agitado(a) {EnemyUnit}! Defenda-se!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Os guerreiros animados de argila miram suas armas em você, obrigados a proteger seu criador: o(a) agitado(a) {EnemyUnit}! Defenda-se!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@BODY_HEADER"
msgstr "Em meio a um vasto lago de lava, {EventHero} encontra um(a) {EventStructure} incomumente elevado(a). Um pequeno portão oferece uma entrada."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Em meio a um vasto lago de lava, você encontra um(a) {EventStructure} incomumente elevado(a). Um pequeno portão oferece uma entrada."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@BODY_LORE"
msgstr "Seu exército adentra o pátio abobadado adornado com estátuas de argila, como guardas prisionais imóveis, onde {EventHero.FirstName} descobre um(a) {EnemyUnit} voando bem acima deles! O calor inerente de <<Co:EnemyUnit>> derreteu a corrente de [hyperlink,GLOBAL.ArchonsLoreConcept]Arconte[/hyperlink] que drenava o poder de <<o:EnemyUnit>>. Chamas revigorantes caem do(a) <<G:wings^p,EnemyUnit>>, que tocam as estátuas de guerreiros de terracota, despertando vida nos guardas esculpidos!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Seu exército adentra o pátio abobadado adornado com estátuas de argila, como guardas prisionais imóveis, onde você descobre um(a) {EnemyUnit} voando bem acima de você! O calor inerente de <<Co:EnemyUnit>> derreteu a corrente de [hyperlink,GLOBAL.ArchonsLoreConcept]Arconte[/hyperlink] que drenava o poder de <<o:EnemyUnit>>. Chamas revigorantes caem do(a) <<G:wings^p,EnemyUnit>>, que tocam as estátuas de guerreiros de terracota, despertando vida nos guardas esculpidos!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@BUTTON_0"
msgstr "Ataque! Derrube a mariposa e seus protetores de argila!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@BUTTON_1"
msgstr "Anule a habilidade de [mana/] dos soldados de argila de ressuscitar."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@BUTTON_2"
msgstr "Quebre a argila dos soldados com ventos gélidos."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@BUTTON_3"
msgstr "Fuja do(a) {EventStructure} e retorne em outra ocasião."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@BUTTON_4"
msgstr "Cegue {EnemyUnit} com uma brilhante esfera de relâmpago."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@BUTTON_5"
msgstr "Envie armadura adicional [unitprod/] de {EventCity} para proteger suas tropas."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@BUTTON_6"
msgstr "Extraia das piscinas de lava ao redor para incendiar os guerreiros de argila!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@TITLE"
msgstr "Tocado(a) Pela Chama"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_766@BODY_FOOTER"
msgstr "Antes que o(a) {EventStructure} desabe na poça de lava, o que {EventHero} tentará resgatar?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_766@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Antes que o(a) {EventStructure} desabe na poça de lava, o que você tentará resgatar?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_766@BODY_HEADER"
msgstr "Seu exército está vitorioso sobre os escombros dos guerreiros de argila desmoronados e a carcaça gigantesca do(a) {EnemyUnit}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_766@BODY_LORE"
msgstr "A Mariposa caiu sobre a corrente de [hyperlink,GLOBAL.ArchonsLoreConcept]Arconte[/hyperlink] que drenava vida do(a) {EnemyUnit} por tantos séculos. Inesperadamente, energia se arqueia da corrente de volta para o(a) {EnemyUnit}, que revive mais uma vez, assim como as duas estátuas de argila restantes de um(a) {EventUnit} e um(a) {EventUnitB}. O(a) {EnemyUnit} revitalizado(a) obedece a você. No entanto, para que ele(a) deixe o(a) {EventStructure}, a estrutura deve ser destruída."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_766@BUTTON_0"
msgstr "Leve os fragmentos de argila [structureprod/] das estátuas derrotadas para {EventCity}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_766@BUTTON_1"
msgstr "Colete as armas [unitprod/] empunhadas pelos guerreiros de argila para {PlayerCapital}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_766@BUTTON_2"
msgstr "Estude os efeitos revigorantes do Pyremoth para aumentar [unitHero/] {EventHero.FirstName}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_766@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "Estude os efeitos revigorantes do Pyremoth para aumentar [unitHero/] a si mesmo."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_766@TITLE"
msgstr "Tocado Pela Chama: Consequências"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_780@BODY_FOOTER"
msgstr "Você vai limpar o {EventSpawner} para recuperar o {EventArtifact} para a Morada de Cristal?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_780@BODY_HEADER"
msgstr "Os {GLOBAL.EternalSagesLoreConcept.Hyperlink} se aproximam de você com um pedido."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_780@BODY_LORE"
msgstr "\"Descobrimos a localização de uma relíquia há muito considerada perdida. O {EventArtifact} está localizado em um(a) {EventSpawner} {EventDirection} {EventCity},\" eles dizem com uma voz monótona. \"Desejamos estudar o(a) {EventArtifact} e guardá-lo(a) em nossas vastas bibliotecas cristalinas. No entanto, o(a) {EventSpawner} não está sem defensores, o que complica a recuperação do(a) {EventArtifact}.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_780@BUTTON_0"
msgstr "\"Eu vou recuperar essa relíquia dos {EventSpawner}.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_780@TITLE"
msgstr "Recuperando o(a) {EventArtifact}"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_781@BODY_FOOTER"
msgstr "Os {GLOBAL.EternalSagesLoreConcept.Hyperlink} estão ansiosos para estudar o(a) {EventArtifact}. Você vai manter sua palavra e devolvê-lo(a)?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_781@BODY_HEADER"
msgstr "Você recuperou o(a) {EventArtifact} dos {EventSpawner}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_781@BODY_LORE"
msgstr "Os {GLOBAL.EternalSagesLoreConcept.Name} já notaram seu sucesso e se comunicam com você à distância. \"Você se saiu bem, {PlayerLeader.Title},\" diz o emissário com voz monótona. \"Finalmente poderemos revelar os segredos que o(a) {EventArtifact} guarda.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_781@BUTTON_0"
msgstr "Entregue o(a) {EventArtifact} aos {GLOBAL.EternalSagesLoreConcept.Name}. [allegiance/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_781@BUTTON_1"
msgstr "Fique com o(a) {EventArtifact} para si, enfurecendo os {GLOBAL.EternalSagesLoreConcept.Name}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_781@TITLE"
msgstr "Recuperando o(a) {EventArtifact}: Consequências"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_798@BODY_FOOTER"
msgstr "\"Você pode capturar o(a) {EventStackLeader}, depois de derrotar <<P:EventStackLeader>> no(a) {EventSpawner}, usando esta cápsula de Lithorita. Ela perpetuará <<p:EventStackLeader>> dentro.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_798@BODY_HEADER"
msgstr "Os {GLOBAL.EternalSagesLoreConcept.Hyperlink} se aproximam de você com um pedido."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_798@BODY_LORE"
msgstr "\"Temos interesse em estudar e preservar as várias criaturas que povoam os reinos,\" eles declaram. \"Uma das criaturas que falta em nossa coleção é um(a) {EventStackLeader}. Recentemente, descobrimos um(a) <<G:nest^n,EventStackLeader>> próximo(a): um(a) {EventSpawner} {EventDirection} {EventCity}.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_798@BUTTON_0"
msgstr "\"Eu retornarei com o(a) {EventStackLeader} capturado(a).\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_798@TITLE"
msgstr "Enredando <<m:EventStackLeader>>"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_799@BODY_FOOTER"
msgstr "Os {GLOBAL.EternalSagesLoreConcept.Hyperlink} estão ansiosos para adquirir o {EventStackLeader}. Você vai concluir sua missão e entregá-<<P:EventStackLeader>> a eles?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_799@BODY_HEADER"
msgstr "O(a) {EventStackLeader} foi encapsulado(a) com sucesso dentro do grande cristal de Litório. O(a) {EventSpawner} foi desmontado(a)."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_799@BODY_LORE"
msgstr "Os {GLOBAL.EternalSagesLoreConcept.Name} já notaram seu sucesso e se comunicam com você de longe. \"Você fez bem, {PlayerLeader.Title},\" diz o emissário deles, monotonamente. \"Podemos finalmente estudar o(a) {EventStackLeader} e o comportamento do(a) <<o:EventStackLeader>> por toda a eternidade.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_799@BUTTON_0"
msgstr "Oferecer o(a) {EventStackLeader} ao(à) {GLOBAL.EternalSagesLoreConcept.Name} [allegiance/]."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_799@BUTTON_1"
msgstr "Domesticar o(a) {EventStackLeader} para você [unit/], enfurecendo os {GLOBAL.EternalSagesLoreConcept.Name}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_799@TITLE"
msgstr "Enredando <<m:EventStackLeader>>: Consequências"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_821@BODY_FOOTER"
msgstr "Você vai forjar o(a) {EventArtifact} para a Morada de Cristal, para que eles possam estudá-lo(a)? Você receberá um(a) [hyperlink,GLOBAL.ItemForgeConcept]Planta[/hyperlink] personalizado(a)."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_821@BODY_FOOTER@FORGE_ITEM_VAR1"
msgstr "Você vai reforjar o(a) {EventArtifact} para a Morada de Cristal, para que eles possam estudá-lo(a)? Você receberá um(a) [hyperlink,GLOBAL.ItemForgeConcept]Planta[/hyperlink] personalizado(a)."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_821@BODY_HEADER"
msgstr "Os {GLOBAL.EternalSagesLoreConcept.Hyperlink} se aproximam de você com um pedido."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_821@BODY_LORE"
msgstr "\"Há muito filosofamos sobre os poderes de uma arma hipotética. Um(a) {EventArtifact}, se preferir.\" eles explicam com uma voz oca. \"Caso este(a) {EventArtifact} venha a existir, desejamos mantê-lo(a) e estudá-lo(a). Acreditamos que você possui um(a) {GLOBAL.ItemForgeConcept.Hyperlink}. Podemos fornecer as instruções de forja se concordar.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_821@BODY_LORE@FORGE_ITEM_VAR1"
msgstr "\"Há muito guardamos os fragmentos de um(a) {EventArtifact}, uma relíquia de uma era há muito perdida. Seu poder é registrado em lendas.\" Apesar da voz monótona, há um toque de constrangimento nas palavras do(a) {GLOBAL.EternalSagesLoreConcept.Name}. \"Infelizmente, não conseguimos reparar o item nós mesmos. Sabemos que você controla um(a) {GLOBAL.ItemForgeConcept.Hyperlink}. Seria capaz de reforjar o(a) {EventArtifact}?\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_821@BUTTON_0"
msgstr "\"Vou forjar o(a) {EventArtifact} para você.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_821@TITLE"
msgstr "Forjando o(a) {EventArtifact}"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_822@BODY_FOOTER"
msgstr "Os {GLOBAL.EternalSagesLoreConcept.Hyperlink} estão ansiosos para estudar os efeitos do(a) {EventArtifact}. Você vai entregá-lo(a)?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_822@BODY_HEADER"
msgstr "Você forjou o(a) {EventArtifact} em sua Forja de Itens."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_822@BODY_LORE"
msgstr "Os {GLOBAL.EternalSagesLoreConcept.Name} sentiram seu sucesso e se aproximam novamente. \"Você fez bem, {PlayerLeader.Title},\" diz o emissário deles, monotonamente. \"Estamos curiosos sobre o(a) {EventArtifact} e seu potencial.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_822@BUTTON_0"
msgstr "Entregar o(a) {EventArtifact} ao(à) {GLOBAL.EternalSagesLoreConcept.Name}. [allegiance/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_822@BUTTON_1"
msgstr "Manter o(a) {EventArtifact} para você, enfurecendo os {GLOBAL.EternalSagesLoreConcept.Name}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_822@TITLE"
msgstr "Forjando o(a) {EventArtifact}: Consequências"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_880@BODY_FOOTER"
msgstr "Você aceitará o convite dos Sábios Eternos para se tornar um Meio para o ritual deles e se comunicar com outros <<m:{GLOBAL.CrystalDwellingConcept.Hyperlink}>>?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_880@BODY_HEADER"
msgstr "Já se tornou uma visão familiar: a saudação formal dos {GLOBAL.EternalSagesLoreConcept.Hyperlink} em sua biblioteca cristalina em {EventHouse}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_880@BODY_LORE"
msgstr "<<G:droning voice^n,EventHouseLord>> explica: \"Você provou ser um aliado valioso para nossa causa, {PlayerLeader.TitleName}. Resta um último favor. Buscamos nos conectar com nossos parentes espalhados pelos {GLOBAL.AstralSeaLoreConcept.Hyperlink}. Para nos comunicarmos e trocarmos o conhecimento acumulado de todos os reinos e mundos. O ritual exige um indivíduo para atuar como Meio. Alguém com os poderes de um {GLOBAL.GodirLoreConcept.Hyperlink}.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_880@BUTTON_0"
msgstr "Concordar em se tornar o Meio deles. Os Sábios Eternos preparam o ritual com gratidão."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_880@BUTTON_1"
msgstr "Fingir concordar com [evilact/], com a intenção de atrapalhar o ritual do Conclave."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_880@BUTTON_2"
msgstr "Recusar educadamente. Solicitar uma comunhão privada com os [knowledge/] Habitantes em vez disso."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_880@TITLE"
msgstr "Comunhão Entre Cristais"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_881@BODY_FOOTER"
msgstr "Este é o Conclave Cósmico que {EventHouse} manifestou, com você em seu centro. O poder do conhecimento absoluto de todo o {GLOBAL.AstralSeaLoreConcept.Hyperlink} flui através do seu corpo imortal."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_881@BODY_FOOTER@PLAYER_NOT_MEDIU"
msgstr "O Conclave Cósmico faz com que este reino fique repleto do poder do conhecimento absoluto de todo o {GLOBAL.AstralSeaLoreConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_881@BODY_HEADER"
msgstr "Estrelas surgem de repente no céu, seguidas por zumbidos profundos que reverberam pelo chão. O ar tem gosto de cerejas."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_881@BODY_LORE"
msgstr "Conexões astrais são estabelecidas entre <<m:{GLOBAL.CrystalDwellingConcept.Hyperlink}>> em outros reinos, tomando a forma de um redemoinho arcano. Fios de energia roxa emergem entre as estrelas, estendendo-se para se conectar a um Meio. De uma só vez, todos os fios tocam o solo em {EventHouse}, fazendo a energia retornar ao cosmos. Os surtos logo atingem um equilíbrio. As conexões estão estabilizadas. O Conclave Cósmico, uma comunhão entre {GLOBAL.EternalSagesLoreConcept.Hyperlink}, começou."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_881@BUTTON_0"
msgstr "\"Os segredos do cosmos, revelados diante de mim.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_881@BUTTON_2"
msgstr "\"Podemos aprender muito com este presságio auspicioso.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_881@TITLE"
msgstr "O Conclave Cósmico"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_882@BODY_FOOTER"
msgstr "Após a culminação cósmica da sua parceria com {EventHouse}, você celebra suas conquistas na pesquisa que contribuíram para suas ambições pessoais."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_882@BODY_FOOTER@PLAYER_NOT_MEDIU"
msgstr "Sua pesquisa se beneficiou do Conclave Cósmico. Quanto seus rivais lucraram com o evento, ainda está por ser visto."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_882@BODY_HEADER"
msgstr "O Conclave Cósmico terminou. Os {GLOBAL.CrystalDwellingConcept.Hyperlink} se comunicaram com sucesso com seus parentes por todo o cosmos."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_882@BODY_LORE"
msgstr "A clareza com que você contemplou o mundo e seus segredos além está se dissipando. É como se sua mente estivesse de repente envolta em algodão. Mas, embora a acuidade tenha diminuído, os frutos desta Era do Conhecimento permanecem. Os {GLOBAL.EternalSagesLoreConcept.Hyperlink} já se retiraram serenamente de volta para suas fortalezas de cristal, a fim de retomar seus estudos eternos."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_882@BUTTON_0"
msgstr "\"Agora sei o quanto ainda resta para aprender.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_882@TITLE"
msgstr "O Conclave Cósmico: Consequências"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_883@BODY_FOOTER"
msgstr "Após descobrir sua traição, {EventHouseLord.TitleName} de {EventHouse} entra em contato com você. \"Você pagará por essa profanação!\", <<p:EventHouseLord>> troveja. Mas você já tem o seu prêmio."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_883@BODY_HEADER"
msgstr "Estrelas surgem de repente no céu, seguidas por zumbidos que reverberam pelo chão. O ar tem gosto de cerejas."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_883@BODY_LORE"
msgstr "Conexões astrais são traçadas entre <<m:{GLOBAL.CrystalDwellingConcept.Hyperlink}>> em outros reinos, formando um redemoinho arcano. Fios de energia roxa emergem entre as estrelas, tentando se conectar a um Meio: você. Mas eles nunca atingem o alvo. Seus magos iniciam o contra-ritual, fazendo com que os fios se emaranhem e atinjam {EventHouse} como raios. Suas estruturas eternas desmoronam; seus defensores se desintegram."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_883@BUTTON_0"
msgstr "\"Tenho domínio sobre o conhecimento. [knowledge/] Terei domínio sobre você.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_883@TITLE"
msgstr "Engano Eterno"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_905@BODY_FOOTER"
msgstr "Como você resumiria suas ambições para os {EventUnit}?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_905@BODY_HEADER"
msgstr "Um {EventUnit}, um de seus súditos Hastefolk, pergunta corajosamente sobre seus planos para o futuro."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_905@BODY_LORE"
msgstr "\"Meu {PlayerLeader.Title}, você descende de uma linhagem de [hyperlink,GLOBAL.GiantKingLoreConcept]reis poderosos[/hyperlink] e guerreiros imponentes. Seus ancestrais já definiram a forma das terras, o curso dos rios e o fluxo das montanhas. Como herdeiro do poder de {GLOBAL.MyrridaLoreConcept.Hyperlink}, seus {EventRace} estão curiosos para saber... que planos você tem para este reino?\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_905@BUTTON_0"
msgstr "Restaurar a antiga majestade de Myrrida [influence/]."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_905@BUTTON_1"
msgstr "Remodelar os reinos [structureprod/] como eu achar melhor."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_905@BUTTON_2"
msgstr "Proteger [goodact/] aqueles menores que eu."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_905@BUTTON_3"
msgstr "Forjar [bindingessence/] itens poderosos que decidirão o destino dos reinos."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_905@BUTTON_4"
msgstr "Invocar tempestades poderosas, como meus ancestrais fizeram há eras. [mana/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_905@BUTTON_5"
msgstr "Erguer mares de lava, como meus ancestrais fizeram há eras. [mana/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_905@BUTTON_6"
msgstr "Cobrir continentes de neve, como meus ancestrais fizeram há eras. [mana/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_905@BUTTON_7"
msgstr "Erguer montanhas eternas, como meus ancestrais fizeram há eras. [mana/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_905@TITLE"
msgstr "Ambições Gigantescas"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_906@BODY_FOOTER"
msgstr "Seus {EventRace} dependem de você para liberar todo o seu potencial. Que caminho você escolherá para seus súditos?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_906@BODY_HEADER"
msgstr "Você possui o poder de remodelar os reinos. Conforme sua majestade cresce, é hora de remodelar seus {EventRace}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_906@BODY_LORE"
msgstr "Nem mesmo os [hyperlink,GLOBAL.GiantKingLoreConcept]Reis Gigantes[/hyperlink] do passado puderam governar os reinos sem a ajuda de seus seguidores. Línguas maldosas afirmam que eles eram notórios por fazer experimentos com seus súditos menores. Seja como for, você depende dos seus Hastefolk para manter o controle sobre seu domínio. É seu dever e responsabilidade desenvolver seus {EventRace}. Eles anseiam por sua orientação."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_906@BUTTON_0"
msgstr "\"Só quero mantê-lo(a) longe de perigos.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_906@BUTTON_1"
msgstr "\"Você crescerá alto e poderoso como os Gigantes de outrora.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_906@BUTTON_2"
msgstr "\"Vou lhe emprestar o poder dos Gigantes da Tempestade.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_906@BUTTON_3"
msgstr "\"Vou lhe emprestar o poder dos Gigantes do Fogo.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_906@BUTTON_4"
msgstr "\"Vou lhe emprestar o poder dos Gigantes do Gelo.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_906@BUTTON_5"
msgstr "\"Vou lhe emprestar o poder dos Gigantes da Rocha.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_906@BUTTON_6"
msgstr "\"Você já é perfeito exatamente como é.\" [happiness/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_906@TITLE"
msgstr "Desenvolvimentos Formativos"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1367@BODY_FOOTER"
msgstr "Sentinelas Lithorine entram no salão. Ondas arcanas percorrem o prédio enquanto elas zumbem com poder e notam {EventHero.FirstName}..."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1367@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Sentinelas Lithorine entram no salão. Ondas arcanas percorrem o prédio enquanto elas zumbem com poder e notam você..."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1367@BODY_HEADER"
msgstr "Um majestoso {EventStructure} se ergue diante de {EventHero.TitleName}, o nome do {GLOBAL.GiantKingLoreConcept.Hyperlink} retratado esquecido pelo tempo."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1367@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Um majestoso {EventStructure} se ergue diante de você, o nome do {GLOBAL.GiantKingLoreConcept.Hyperlink} retratado esquecido pelo tempo."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1367@BODY_LORE"
msgstr "Sob o trono imponente, {EventHero.FirstName} entra em um grande salão, o movimento de <<o:EventHero>> ecoando pelo prédio. Não há sinal de vida aqui. Nenhuma teia de aranha, praga ou mesmo poeira cobre os salões. E, no entanto, não há nenhum zelador à vista... Até que {EventHero.FirstName} sente um formigamento familiar percorrer a <<o:EventHero>> espinha — uma onda de energia arcana."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1367@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Sob o trono imponente, você entra em um grande salão, seu movimento ecoando pelo prédio. Não há sinal de vida aqui. Nenhuma teia de aranha, praga ou mesmo poeira cobre os salões. E, no entanto, não há nenhum zelador à vista... Até que você sente um formigamento familiar percorrer sua espinha — uma onda de energia arcana."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1367@BUTTON_0"
msgstr "\"Ataquem essas sentinelas rebeldes!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1367@BUTTON_1"
msgstr "Lance um feitiço de proteção [mana/] sobre seu exército."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1367@BUTTON_2"
msgstr "Use seu conhecimento arcano para retardar as ondas de magia."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1367@BUTTON_3"
msgstr "Fuja do {EventStructure}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1367@BUTTON_4"
msgstr "Invoque os poderes do Caos para provocar e confundir as sentinelas."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1367@BUTTON_5"
msgstr "Invoque os poderes do {EventStructure} para fortalecer a armadura do seu exército."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1367@TITLE"
msgstr "Sentinelas Fragmentados"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1368@BODY_FOOTER"
msgstr "Ao lado do conhecimento encontrado aqui dentro, {EventHero.FirstName} encontra tesouros escondidos e até uma sala com sentinelas de Lithorina adormecidos."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1368@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Ao lado do conhecimento encontrado aqui dentro, você encontra tesouros escondidos e até uma sala com sentinelas de Lithorina adormecidos."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1368@BODY_HEADER"
msgstr "Após destruir os sentinelas de Lithorina do {EventStructure}, {EventHero.Name} está livre para explorar os salões imaculados."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1368@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Após destruir os sentinelas de Lithorina do {EventStructure}, você está livre para explorar os salões imaculados."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1368@BODY_LORE"
msgstr "Com os sentinelas obcecadamente limpando e protegendo os salões por séculos, tudo aqui dentro foi preservado. Runas claras, entalhes e fileiras de livros alinham as paredes, compartilhando uma riqueza de histórias sobre {GLOBAL.MyrridaLoreConcept.Hyperlink}. Há representações dos [hyperlink,GLOBAL.GiantKingLoreConcept]Reis Gigantes[/hyperlink] e seus pactos com os {GLOBAL.ArchonsLoreConcept.Hyperlink}, a queda de Myrrida e os {GLOBAL.TraitorKingsLoreConcept.Hyperlink}, e até lendas secretas dos {GLOBAL.EternalCouncilLoreConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1368@BUTTON_0"
msgstr "Pegue uma arma coberta de cristais. [item/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1368@BUTTON_1"
msgstr "Reivindique o tesouro que [gold/] encontrou dentro do {EventStructure}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1368@BUTTON_2"
msgstr "Subjugue alguns dos sentinelas ao seu lado. [unit/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1368@BUTTON_3"
msgstr "Reúna os cristais de Lithorita. [mana/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1368@TITLE"
msgstr "Sentinelas Fragmentados: Consequências"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1370@BODY_FOOTER"
msgstr "Seu líder aponta para {EventHero.FirstName} e grita: \"Grandes Reis de outrora! Abençoai-nos com vossa força para esmagar esses hereges!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1370@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Seu líder aponta para você e grita: \"Grandes Reis de outrora! Abençoai-nos com vossa força para esmagar esses hereges!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1370@BODY_HEADER"
msgstr "{EventHero.FirstName} entra no {EventStructure} e encontra um grupo de figuras adorando a estátua de um antigo {GLOBAL.GiantKingLoreConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1370@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você entra no {EventStructure} e encontra um grupo de figuras adorando a estátua de um antigo {GLOBAL.GiantKingLoreConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1370@BODY_LORE"
msgstr "A princípio, os adoradores não parecem notar {EventHero,FirstName}, continuando a cantar na língua antiga de {GLOBAL.MyrridaLoreConcept.Hyperlink}. É apenas quando {EventHero.FirstName} se aproxima da estátua que seu líder ergue o olhar<<o:EnemyUnit>>. \"Vocês não são adoradores dos Gigantes. Estão profanando solo sagrado! Ousam macular os grandiosos degraus do {EventStructure} com seus soldados?!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1370@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "A princípio, os adoradores não parecem notar você, continuando a cantar na língua antiga de {GLOBAL.MyrridaLoreConcept.Hyperlink}. É apenas quando você se aproxima da estátua que seu líder ergue o olhar<<o:EnemyUnit>>. \"Vocês não são adoradores dos Gigantes. Estão profanando solo sagrado! Ousam macular os grandiosos degraus do {EventStructure} com seus soldados?!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1370@BUTTON_0"
msgstr "\"Ataquem!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1370@BUTTON_1"
msgstr "\"Vocês querem se tornar gigantes, serão abatidos como eles!\" [influence/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1370@BUTTON_2"
msgstr "\"A bênção do crescimento pode ser concedida, mas também posso tirá-la.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1370@BUTTON_3"
msgstr "Deixe os cultistas com sua cerimônia."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1370@BUTTON_4"
msgstr "\"Vocês adoram meus parentes! Inclinem-se diante de mim, meus seguidores!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1370@TITLE"
msgstr "Proeza Primeva"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1371@BODY_FOOTER"
msgstr "Sem os cultistas para proteger o tesouro, os objetos estão livres para serem reivindicados."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1371@BODY_HEADER"
msgstr "Após matar os adoradores do {EventStructure}, {EventHero.FirstName} pode se aproximar livremente da estátua."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1371@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Após matar os adoradores do {EventStructure}, você pode se aproximar livremente da estátua."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1371@BODY_LORE"
msgstr "Nenhum trovão ressoa, nenhum raio ou ira divina atinge {EventHero.FirstName} ou o exército de <<o:EventHero>>. Em vez disso, o {EventStructure} permanece em silêncio, os grandes salões ecoando cada passo enquanto a estátua se ergue acima do exército. Na base gigante da estátua, os cultistas haviam reunido um monte de artefatos para adorar e sacrificar ao seu amado {GLOBAL.GiantKingLoreConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1371@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Nenhum trovão ressoa, nenhum raio ou ira divina o atinge ou atinge seu exército. Em vez disso, o {EventStructure} permanece em silêncio, os grandes salões ecoando cada passo enquanto a estátua se ergue acima do exército. Na base gigante da estátua, os cultistas haviam reunido um monte de artefatos para adorar e sacrificar ao seu amado {GLOBAL.GiantKingLoreConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1371@BUTTON_0"
msgstr "Reúna tudo de valor para vender. [gold/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1371@BUTTON_1"
msgstr "Pegue o pergaminho ritual da Graça do Colosso."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1371@BUTTON_2"
msgstr "Reivindique o {EventItem}. [item/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1371@BUTTON_3"
msgstr "Pegue o tomo de sabedoria antiga [knowledge/] sobre Gigantes e sua magia."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1371@BUTTON_4"
msgstr "Não reivindique nada. Este remanescente da civilização deve ser mantido intacto. [materiumboon/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1371@TITLE"
msgstr "Proeza Primeva: Consequências"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1373@BODY_FOOTER"
msgstr "O Gigante olha para {EventHero.FirstName} enquanto <<p:EventHero>> se aproxima. \"Intrusos! Este é o meu trono! Ataquem-nos!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1373@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "O Gigante olha para você enquanto se aproxima. \"Intrusos! Este é o meu trono! Ataquem-nos!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1373@BODY_HEADER"
msgstr "Dentro do imponente {EventStructure}, remanescente da glória de {GLOBAL.MyrridaLoreConcept.Hyperlink}, {EventHero.Name} encontra um {GiantUnit}, junto com um grupo de Demigigantes."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1373@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Dentro do imponente {EventStructure}, remanescente da glória de {GLOBAL.MyrridaLoreConcept.Hyperlink}, você encontra um {GiantUnit}, junto com um grupo de Demigigantes."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1373@BODY_LORE"
msgstr "\"Há éons, os [hyperlink,GLOBAL.GiantKingLoreConcept]Reis Gigantes[/hyperlink] governavam todas as raças inferiores,\" o Gigante se vangloria para seus seguidores Demigigantes, <<o:EnemyUnit>>. \"É justo que eu reivindique este trono mais uma vez, conforme a ordem natural.\" Um silêncio confuso se instala, e o Gigante grita, frustrado: \"Os pequenos seguem os grandes, seus tolos!\" Os Demigigantes comemoram, aliviados por terem entendido, enquanto o Gigante suspira."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1373@BUTTON_0"
msgstr "Ataque esses tolos desajeitados!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1373@BUTTON_1"
msgstr "\"Meus parentes dragões já derrotaram você antes, Gigante! Vou fazer isso de novo!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1373@BUTTON_2"
msgstr "Confunda os Demigigantes com retórica [knowledge/] sobre Gigantes e seus parentes."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1373@BUTTON_3"
msgstr "Deixe o Gigante e os seguidores <<o:EnemyUnit>>."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1373@BUTTON_4"
msgstr "\"Como na lenda do pastor de ovelhas, nós também podemos derrotar Gigantes!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1373@BUTTON_5"
msgstr "\"Um grupo de caçadores pode abater a maior das presas!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1373@TITLE"
msgstr "O Tamanho Importa"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1374@BODY_FOOTER"
msgstr "O Demigigante solitário não representa ameaça para {EventHero.FirstName}. O que você pede a <<P:EventUnit>>?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1374@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "O Demigigante solitário não representa ameaça para você. O que você pede a <<P:EventUnit>>?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1374@BODY_HEADER"
msgstr "{EventHero.FirstName} matou um suposto {GLOBAL.GiantKingLoreConcept.Hyperlink} e seus seguidores. Com isso, o {EventStructure} é seu e pode ser explorado livremente."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1374@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você matou um suposto {GLOBAL.GiantKingLoreConcept.Hyperlink} e seus seguidores. Com isso, o {EventStructure} é seu e pode ser explorado livremente."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1374@BODY_LORE"
msgstr "Enquanto {EventHero.FirstName} perambula pelos corredores, <<p:EventHero>> encontra um {EventUnit} solitário, que ergue <<o:EventUnit>> braços. \"Você pisoteou o Gigante? Você venceu. O Gigante me mandou guardar o tesouro... Mas eu me entediei e saí andando.\" O Demigigante dá uma risadinha. \"Você pisoteou o Gigante. Estou livre.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1374@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Enquanto você perambula pelos corredores, encontra um {EventUnit} solitário, que ergue <<o:EventUnit>> braços. \"Você pisoteou o Gigante? Você venceu. Ele era mau mesmo. Nos chamava de burros. Me mandou guardar o tesouro... Mas eu me entediei e saí andando.\" O demigigante dá uma risadinha. \"Agora ele foi pisoteado e estou livre.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1374@BUTTON_0"
msgstr "Recrute o Demigigante para o seu lado. [unit/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1374@BUTTON_1"
msgstr "Exija que o Demigigante o guie até os tesouros que reuniu. [gold/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1374@BUTTON_2"
msgstr "\"Você está livre para ir, {EventUnit}.\" [goodact/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1374@BUTTON_3"
msgstr "Mate o {EventUnit} que se rendeu como exemplo para suas tropas. [evilact/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1374@TITLE"
msgstr "O Tamanho Importa: Consequências"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1476@BODY_FOOTER@NO_AI_LORDS"
msgstr "O {EventUnit} ergue <<o:EventUnit>> mãos e grita em êxtase. \"Você é abençoado pelos [hyperlink,GLOBAL.TraitorKingsLoreConcept]Kjörnoe[/hyperlink]! Nós o adoraremos como fizemos com eles!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1476@BODY_LORE@NO_AI_LORDS"
msgstr "\"Sou um <<EventUnit{Son/Daughter}>> dos Kjörnoe, seguidor dos verdadeiros [hyperlink,GLOBAL.GiantKingLoreConcept]Reis Gigantes[/hyperlink], tão injustamente declarados 'Traidores'. Há muito seguimos os Artefatos que agora possui, esperando por alguém que encarne as bênçãos dos Kjörnoe. Você é <<P:PlayerLeader>>! E assim, os Filhos dos Kjörnoe juram lealdade a você!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1490@BUTTON_5"
msgstr "Guie as almas fragmentadas até {ReplacedPlayerFallback}. [evilact/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1490@BUTTON_6"
msgstr "Pare o ritual e use os Artefatos para governar os Filhos de Kjörnoe você mesmo."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1490@BUTTON_7"
msgstr "Sacrifique seu <<EventHero{hero/heroine}>> {EventHero.TitleName} para trazer o Rei Traidor de volta sob seu comando. [unit/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1498@BODY_FOOTER"
msgstr "{PreviousPlayer.TitleName} foi lançado no {GLOBAL.AstralVoidLoreConcept.Hyperlink} por {TriggeringPlayer}. O [hyperlink,GLOBAL.TraitorKingsLoreConcept]Rei Traidor[/hyperlink] {TraitorKingLord} agora governa o {ReplacedPlayerRace} no lugar de <<o:PreviousPlayer>>."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1498@BODY_HEADER"
msgstr "Seus planos são interrompidos por uma onda sombria de magia arcana, que varre o reino."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1498@BODY_LORE"
msgstr "Após investigar a causa, você descobre que {TriggeringPlayer} usou o {CauldronRelic}, {MirrorRelic} e {GrailRelic} para despertar o antigo {GLOBAL.TraitorKingsLoreConcept.Hyperlink}. O processo de invocação lançou {PreviousPlayer} no {GLOBAL.AstralVoidLoreConcept.Hyperlink} e substituiu <<P:PreviousPlayer>> por {TraitorKingLord}. Infelizmente, não há nada que você possa fazer contra essa magia do Rei Traidor."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1498@BUTTON_0"
msgstr "\"Vou aprender [knowledge/] com a magia sombria deste Rei Traidor!\" [evilact/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1498@BUTTON_2"
msgstr "Envie algumas esmolas ao {ReplacedPlayerRace} [gold/] por compaixão. [goodact/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1498@BUTTON_3"
msgstr "\"Esse ato proibido não pode ficar sem resposta.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1498@TITLE"
msgstr "Retorno dos Kjörnoe: Invocação Sombria"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6766@BODY_FOOTER"
msgstr "Jatos de chamas surgem nos céus, dissipando a tempestade até que a barreira no centro do platô desabe."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6766@BODY_HEADER"
msgstr "Gruntindo satisfeito, o {EventUnit} pega todos os núcleos de Lithorine que você reuniu. Então <<p:EventUnit>> ergue <<o:EventUnit>> mãos:"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6766@BODY_HEADER@OGRE_DEFEATED"
msgstr "Derrotado e ameaçado pelo poder de você e suas tropas, o {EventUnit} relutantemente começa <<o:EventUnit>> invocação:"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6766@BODY_LORE"
msgstr "\"Acende, runinha![br/]Ouve a chama[br/]Fendas além[br/]Nome gravado:[br/]Frustra e explode[br/]—bum!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6766@BUTTON_0"
msgstr "Prepare-se para enfrentar o que está além da barreira."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6766@TITLE"
msgstr "Platô Cristalino: Invocação da Barreira Quebrada"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6768@BODY_FOOTER"
msgstr "Os Gigantes {GLOBAL.StormClanLoreConcept.Hyperlink} dominaram o {EventStackLeader}. Eles estão prontos para liberá-lo contra qualquer um que ouse interferir."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6768@BODY_HEADER"
msgstr "Chegando ao centro do platô, suas tropas observam um enorme {EventStackLeader}."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6768@BODY_LORE"
msgstr "Distraídos pelo tamanho do {EventStackLeader}, leva alguns momentos até que suas tropas notem os Gigantes reunidos ao redor de um grande menir, cujas runas esculpidas brilham com magia. Há alguma agitação entre esses Gigantes, como se tivessem sido interrompidos em um ritual. Ao ver o brasão do {GLOBAL.StormClanLoreConcept.Hyperlink}, só se pode presumir que a fúria do {GLOBAL.PROPERTIES.TSR_CRYSTAL_STORM_AUTO_SPELL.Hyperlink} foi obra deles."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6768@BUTTON_0"
msgstr "\"Devemos recuar, por enquanto.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6768@BUTTON_1"
msgstr "\"Este {GLOBAL.StormClanLoreConcept.Name} não é páreo para nós, ataquem!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6768@TITLE"
msgstr "Planalto Cristalestronde: Ritual do Clã da Tempestade"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6791@BODY_FOOTER"
msgstr "Você sente uma magia forte de lealdade vinculada dentro do {EventRelic.Name}. Enquanto a região finalmente fica sem vento, você pode reivindicar sua vitória."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6791@BODY_HEADER"
msgstr "Você derrotou o {GLOBAL.StormClanLoreConcept.Hyperlink} e sua Litória evocada. Seu líder atual, um {EventUnit}, reúne suas últimas forças para erguer a voz de <<o:EventUnit>>."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6791@BODY_LORE"
msgstr "\"Malditos traidores {GLOBAL.FireClanLoreConcept.Hyperlink}, malditos todos os Povo da Pressa!\" <<p:EventUnit>> grita violentamente. \"Eles lançaram vocês contra nós, quebraram nosso feitiço...\" Lentamente, {EventUnit} move <<o:EventUnit>> enorme punho. \"Nós persistiremos. Domamos a Litória. O poder dos Reis Gigantes será legitimamente nosso! Uma tempestade irá surgir. Todos os Povo da Pressa... tremerão!\" {EventUnit} exala <<o:EventUnit>> último suspiro, desabando ao lado do {EventRelic.Name}."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6791@BUTTON_0"
msgstr "Absorva as energias astrais remanescentes de [mana/] antes que se dissipem."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6791@BUTTON_3"
msgstr "Declare seu domínio [influence/] sobre o {GLOBAL.StormClanLoreConcept.Name} em todo o reino."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6791@BUTTON_4"
msgstr "Rastreie os ecos ondulantes da tempestade para invocar seres [unit/] de puro relâmpago."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6791@BUTTON_5"
msgstr "O que puder ser aprendido sobre a magia de {GLOBAL.StormClanLoreConcept.Name} deve ser compartilhado com a Morada de Cristal. [allegiance/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6791@TITLE"
msgstr "Planalto Cristalestronde: Consequências"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6922@BUTTON_6"
msgstr "\"Compartilhe o que aprendeu sobre o {EventBeastName} com o {GLOBAL.EternalSagesLoreConcept.Name}.\" [allegiance/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6989@BODY_FOOTER@ENIGMA_LOCKED"
msgstr "Você deve retornar aos outros salões e resolver seus enigmas. Somente depois o Criador falará com você."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6989@BODY_HEADER@ENIGMA_LOCKED"
msgstr "Na câmara central, suas tropas encontram um {EventStackLeader}, observando a região em silêncio."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6989@BODY_LORE@ENIGMA_LOCKED"
msgstr "Eles não ousam se aproximar do {EventStackLeader}, como se uma montanha intransponível bloqueasse seu caminho. Não é preciso falar para perceber que esse Criador, adorado pelo {GLOBAL.StoneClanLoreConcept.Hyperlink}, não está aqui para conversar com você, mas aguarda outro {GLOBAL.GodirLoreConcept.Hyperlink} envolvido no Salão dos Enigmas."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6989@BUTTON_0@ENIGMA_LOCKED"
msgstr "Partir."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6989@TITLE@ENIGMA_LOCKED"
msgstr "Salão dos Enigmas: Criador Observador"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7003@BUTTON_6"
msgstr "Compartilhe o conhecimento sobre o Criador com o {GLOBAL.EternalSagesLoreConcept.Name}. [allegiance/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7060@BUTTON_4"
msgstr "\"Convoque o exército gélido [unit/] do Clã do Gelo!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7309@BODY_FOOTER"
msgstr "O {EventUnit} examina suas tropas. \"Somente quando as manifestações de <<ge:malice^n,{EventHero.FirstName}>> tiverem sido enfraquecidas, o espírito de {EventHero} <<r:EventHero>> poderá ser desafiado e destruído para sempre.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7309@BODY_HEADER"
msgstr "Assustadas pelas vastas ruínas desoladas que se estendem até o horizonte, suas tropas são contatadas por um espírito cintilante à distância."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7309@BODY_LORE"
msgstr "\"Cuidado, bravos cidadãos!\" O {EventUnit} grita, enquanto <<p:EventUnit>> se aproxima. \"Pois vocês estão entrando em uma terra amaldiçoada. Em eras passadas, este era o domínio de um terrível [hyperlink,GLOBAL.TraitorKingsLoreConcept]Rei Traidor[/hyperlink]. Embora {EventHero} tenha caído sob o justo castigo de [hyperlink,GLOBAL.ArchonsLoreConcept]meu povo[/hyperlink], <<o:EventHero>> espírito corrompido continua a assolar o reino, infectando bestas, vermes e até mesmo o solo com uma fome insaciável.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7309@BUTTON_0"
msgstr "Considere o aviso do {EventUnit} enquanto suas tropas adentram as ruínas."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7309@BUTTON_3"
msgstr "Peça ao {EventUnit} para consagrar suas tropas [statuseffectresistance/] antes que prossigam."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7309@BUTTON_4"
msgstr "Sifone as energias sagradas do [mana/][evilact/] do {EventUnit} para proteger [statuseffectresistance/] suas próprias tropas."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7309@TITLE"
msgstr "Explorando os Campos Famintos"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7315@BODY_FOOTER"
msgstr "O {EventStackLeader} sacode a <<o:EventStackLeader>> cabeça violentamente. Então <<p:EventStackLeader>> fixa seu olhar nas suas tropas: \"Que refeição ou presa vocês trouxeram ao meu prato?\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7315@BODY_FOOTER@SPIRIT_WEAKENED"
msgstr "Para confrontar o {EventHero}, você deve encontrar e enfraquecer os outros aspectos."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7315@BODY_HEADER"
msgstr "Engolindo o {EventStructure}, um terrível {EventStackLeader} é interrompido por suas tropas. Quando <<p:EventStackLeader>> se vira para elas, <<p:EventStackLeader>> fala com a voz sinistra de {EventHero}."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7315@BODY_HEADER@SPIRIT_WEAKENED"
msgstr "Você enfraqueceu o aspecto da fome."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7315@BODY_LORE"
msgstr "\"Eu venho a todos, meu hálito é eterno,\" diz o {EventStackLeader}, mostrando os <<o:EventStackLeader>> enormes dentes. \"Em meu rastro, trago a morte voraz. Ossos são roídos, árvores devoradas, arbustos engolidos, <<m:{EventSmallAnimal}>> tragados, <<m:{EventLargeAnimal}>> comidos aos poucos. Tudo consumido em meu poço.\" O {EventStackLeader} ruge. \"Não fui eu o rei deles, para que me alimentassem? Governar é meu direito de nascença; banquetear-se, meu prazer primordial. No entanto, todos me falharam...\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7315@BODY_LORE@SPIRIT_WEAKENED"
msgstr "Fraco como está, ele não representa mais uma ameaça para você."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7315@BUTTON_0@SPIRIT_WEAKENED"
msgstr "Deixe o {EventStackLeader} para o <<r:EventStackLeader>>."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7315@BUTTON_1"
msgstr "\"A cabeça de um {EventStackLeader}, recém-servida!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7315@BUTTON_2"
msgstr "\"Já basta de {RandomFood} [food/] do nosso reino para engordar a própria fome.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7315@BUTTON_3"
msgstr "\"Trazemos a ruína de todos os glutões: O Tomo do Jejum!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7315@BUTTON_4"
msgstr "\"O rabo perdido de um lagarto, escapando das mandíbulas...\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7315@TITLE"
msgstr "Campos Famintos: Aspecto da Fome"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7320@BODY_FOOTER"
msgstr "O {EventStackLeader} pega a <<o:EventStackLeader>> faca novamente. \"Qual de vocês será o primeiro?\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7320@BODY_HEADER"
msgstr "No calor de uma cozinha infernal abastecida por lava, um {EventStackLeader} se vira do {EventStructure} para receber suas tropas com a voz profunda de {EventHero}."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7320@BODY_HEADER@SPIRIT_WEAKENED"
msgstr "Você enfraqueceu o aspecto do massacre."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7320@BODY_LORE"
msgstr "\"Ah, visitantes!\" <<p:EventStackLeader>> exclama, largando a <<o:EventStackLeader>> grande faca de açougueiro. \"Que prato vocês desejam hoje, queridos convidados? Um pouco de {EventRace1}, fresquinho do forno? {EventRace2} ensopado? Ou melhor ainda, {EventRace3} picado no espeto?\" O {EventStackLeader} se inclina para frente, como se <<p:EventStackLeader>> estivesse compartilhando um segredo. \"Esses arrivistas de {GLOBAL.ObbadothLoreConcept.Hyperlink} acham que seus templos de massacre são novidade. Deviam ter visto esta Arena do Matadouro em todo o seu esplendor! Servíamos reis e realizávamos banquetes de cavaleiros sem igual...\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7320@BODY_LORE@SPIRIT_WEAKENED"
msgstr "Encharcado de sangue e exausto, o {EventStackLeader} não representa mais uma ameaça às suas tropas."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7320@BUTTON_0"
msgstr "Fuja do {EventStackLeader}."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7320@BUTTON_1"
msgstr "\"Você, {EventHero}... este massacre acaba agora!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7320@BUTTON_2"
msgstr "Ferva o {EventStructure} [mana/] para cozinhar o {EventStackLeader} <<r:EventStackLeader>>."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7320@TITLE"
msgstr "Campos Famintos: Aspecto da Carnificina"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7321@BODY_FOOTER"
msgstr "O olhar do {EventStackLeader} penetra suas tropas, encarando você — o {EventPlayerType} — observando de longe, buscando uma forma de entrar em sua mente..."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7321@BODY_HEADER"
msgstr "Nos [hyperlink,GLOBAL.AstralVoidLoreConcept]declives da realidade[/hyperlink], onde o mundo físico parece devorar a si mesmo, um {EventStackLeader} caça os {GLOBAL.SoulsLoreConcept.Hyperlink} perdidos em uma era há muito passada."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7321@BODY_HEADER@SPIRIT_WEAKENED"
msgstr "Você enfraqueceu o aspecto do delírio."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7321@BODY_LORE"
msgstr "\"Sem dentes, eu mordo. Sem boca, eu engulo,\" murmura o {EventStackLeader}, envolto em um silêncio sobrenatural. \"Nenhuma carne saciaria minhas necessidades. A própria terra deve desaparecer em minhas mandíbulas. Uma dúzia de mentes, um banquete para me alimentar. Mas, acima de tudo, eu anseio por almas deliciosas!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7321@BODY_LORE@SPIRIT_WEAKENED"
msgstr "Flutuando em silêncio, o {EventStackLeader} não representa mais uma ameaça às suas tropas."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7321@BUTTON_0"
msgstr "Fuja do {EventStackLeader}."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7321@BUTTON_1"
msgstr "\"Destrua essa abominação, antes que ela escravize seus pensamentos!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7321@BUTTON_2"
msgstr "Alimente o {EventStackLeader} com almas [souls/] amaldiçoadas pelo esquecimento."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7321@TITLE"
msgstr "Campos Famintos: Aspecto do Delírio"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7324@BUTTON_0@SPIRIT_WEAKENED"
msgstr "Deixe o {EventStackLeader} para <<r:EventStackLeader>>."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7328@BUTTON_0@SPIRIT_WEAKENED"
msgstr "Deixe o {EventStackLeader} para <<r:EventStackLeader>>."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7328@BUTTON_4"
msgstr "Atraia o {EventStackLeader} para dentro, para esmagá-lo com a força da sua vontade [knowledge/]."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7461@BODY_FOOTER"
msgstr "Por meio de magia vil, {EventHero} invoca os lacaios <<o:EventHero>> para proteger <<o:EventHero>> miserável não-vida. Apenas um exército poderoso pode desafiar o [hyperlink,GLOBAL.TraitorKingsLoreConcept]Rei Traidor[/hyperlink]."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7461@BODY_HEADER"
msgstr "Tendo enfraquecido os aspectos da fome, da carnificina e do delírio, {EventHero} é forçado a revelar <<o:EventHero>> verdadeira forma, um espírito amaldiçoado e vingativo."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7461@BODY_LORE"
msgstr "\"Quem você pensa que é para ousar me desafiar?\" ruge <<p:EventHero>>, tomado pela fúria. \"Enganei os {GLOBAL.EternalCouncilLoreConcept.Hyperlink}, escapei da ira do [hyperlink,GLOBAL.ArchonsLoreConcept]Arconte[/hyperlink]. {GLOBAL.DragonsLoreConcept.Hyperlink} evitam meu domínio, temendo meu alcance inevitável.\" <<Cge:voice^n,EventHero.FirstName>> rosna como um trovão, e as ruínas ao redor começam a desmoronar. \"Tornei-me um poder primordial. EU SOU A FOME. EU SOU A MORTE!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7461@BUTTON_0"
msgstr "Prepare-se para enfrentar {EventHero} e acabar com a maldade de <<o:EventHero>>."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7461@TITLE"
msgstr "Campos Esfomeados: {EventHero} Exposto"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7466@BODY_FOOTER"
msgstr "O {EventUnit} desaparece em um clarão radiante, e a luz de <<o:EventUnit>> rejuvenesce o solo que toca. Sozinho em meio à vida que brota, você decide o destino dos Campos Esfomeados."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7466@BODY_HEADER"
msgstr "Com o desaparecimento de {EventHero}, suspiros profundos ecoam pelas paredes da cidade em ruínas, e as poucas árvores murmuram aliviadas."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7466@BODY_LORE"
msgstr "O {EventUnit} que o havia alertado sobre a maldição do [hyperlink,GLOBAL.TraitorKingsLoreConcept]Rei Traidor[/hyperlink] retorna às suas tropas. \"{EventHero} foi derrotado... finalmente!\" <<p:EventUnit>> exclama, radiante de alegria. \"Você, {PlayerLeader.TitleName}, libertou os Campos Esfomeados de sua maldição e restaurou a paz nesta terra. Tome o {EventRelic} de <<ge:remains^p,EventHero.FirstName>> e vigie <<p:EventRelic>> bem. Há um mal ali que nunca se dissipa.\" O {EventUnit} depõe <<o:EventUnit>> armas, colocando <<o:EventUnit>> mão translúcida no chão para uma última prece: \"Minha vigília termina aqui. Este é meu presente de despedida...\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7466@BUTTON_0"
msgstr "\"Isto será um memorial à vitória do bem [goodact/] sobre o mal!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7466@BUTTON_3"
msgstr "\"O poder de {GLOBAL.TraitorKingsLoreConcept.Name} era grande. No entanto, estou acima de tudo!\" [influence/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7466@BUTTON_4"
msgstr "\"Onde havia fome e miséria, haverá fartura [food/] e abundância!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7466@BUTTON_5"
msgstr "\"Para estudar a cidade e seu destino, devemos convidar {GLOBAL.EternalSagesLoreConcept.Name}.\" [allegiance/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7466@BUTTON_6"
msgstr "\"Precisamos aprender [knowledge/] tudo o que pudermos sobre <<ge:potent soulcurse magic^n,EventHero.FirstName>>...\" [evilact/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7466@TITLE"
msgstr "Campos Esfomeados: Consequências"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7496@BODY_FOOTER"
msgstr "\"Recupere {EventUnit} Trono! Castigue {GLOBAL.TraitorKingCultLoreConcept.Hyperlink}!\" ordena o troll. \"Cultistas lançam feitiço. Esmague cultistas. Esmague feitiço!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7496@BODY_HEADER"
msgstr "Ao pé de uma montanha imponente, o caminho de suas tropas é subitamente bloqueado por um troll grande e régio."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7496@BODY_LORE"
msgstr "\"Curve-se diante do Monte Godkeep\", grita o troll, apontando para as estruturas reluzentes no alto do platô montanhoso, \"assento de {GLOBAL.BloodClanLoreConcept.Hyperlink} e trono do mais poderoso {EventUnit}!\" <<Cp:EventUnit>> exibe a coroa em <<o:EventUnit>> cabeça. \"Mas {EventUnit} traiu. {GLOBAL.TraitorKingCultLoreConcept.Hyperlink} vieram. Envenenaram a mente de {GLOBAL.BloodClanLoreConcept.Hyperlink} com orgulho. Ogros e trolls se rebelaram... servem aos traidores!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7496@BUTTON_0"
msgstr "Pergunte ao {EventUnit} onde encontrar o {GLOBAL.TraitorKingCultLoreConcept.Name}."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7496@TITLE"
msgstr "Descobrindo o Monte Godkeep"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7514@BODY_FOOTER"
msgstr "Com um grito terrível, o {EventUnit} derrama <<o:EventUnit>> própria alma, tentando escapar de seu alcance."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7514@BODY_HEADER"
msgstr "Derrotado e ferido, um {EventUnit} de {GLOBAL.TraitorKingCultLoreConcept.Hyperlink} fala às suas tropas, ainda tomado pelo orgulho."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7514@BODY_LORE"
msgstr "\"Acha que pode nos deter?\" grita o {EventUnit}, <<o:EventUnit>> mandíbula movida apenas por magia negra. \"Para nossos deuses, [hyperlink,GLOBAL.TraitorKingsLoreConcept]os Kjörnoe[/hyperlink], a morte era apenas uma porta, um mero caminho para novos poderes.\" <<Cp:EventUnit>> arranca um estilhaço de gelo de <<o:EventUnit>> ombro, esmagando-o com <<o:EventUnit>> punhos. \"Eles ousaram se opor à falsa ordem dos {GLOBAL.ArchonsLoreConcept.Hyperlink}. Como {GLOBAL.TraitorKingCultLoreConcept.Hyperlink}, continuamos seu legado e dominamos sua magia. A imortalidade está próxima...\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7514@BUTTON_0"
msgstr "Deixe a alma de <<o:EventUnit>> escapar para <<o:EventUnit>> mestres."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7514@BUTTON_4"
msgstr "Expulse a alma de [mana/] para acabar com a malícia de <<o:EventUnit>>. [goodact/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7514@BUTTON_5"
msgstr "Prenda a alma de [mana/] para extrair os doces segredos [knowledge/] da magia de Kjörnoe... [evilact/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7514@TITLE"
msgstr "Monte Godkeep: O {EventRace}"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7515@BODY_FOOTER"
msgstr "O {EventUnit} desmorona. Se as últimas palavras daquele lunático <<o:EventUnit>> continham um pingo de verdade, o {GLOBAL.TraitorKingCultLoreConcept.Hyperlink} está usando os {GLOBAL.BloodClanLoreConcept.Hyperlink} como sacrifícios em seus rituais vis."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7515@BODY_HEADER"
msgstr "À beira do último suspiro de <<o:EventUnit>>, um {EventUnit} do {GLOBAL.TraitorKingCultLoreConcept.Hyperlink} de repente solta uma gargalhada."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7515@BODY_LORE"
msgstr "\"Você viu os ogros?\", pergunta o {EventUnit}, rindo, <<o:EventUnit>> sanidade há muito perdida. \"Eles espirram como rãs grandes. Intestinos verdes, gosma azul. Pintam as paredes. Enchem eles de essência mágica, espetam com um caco de gelo e... ploft! É engraçado, idiota!\" <<Cp:EventUnit>> cospe sangue enquanto <<p:EventUnit>> ri. \"Eles acham que nós daríamos poder a eles. Ah, sim, poder de rã espirrante verde!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7515@BUTTON_0"
msgstr "\"Logo descobriremos.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7515@TITLE"
msgstr "Monte Godkeep: Sacrifícios de {GLOBAL.BloodClanLoreConcept.Name}"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7516@BODY_FOOTER"
msgstr "\"Líder do culto é forte\", avisa o {EventUnit}. \"{EventUnit} tem três servos leais. Um se junta a {PlayerLeader}, luta contra {EventHero}. {PlayerLeader} escolha.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7516@BODY_HEADER"
msgstr "Suas tropas dizimaram os {GLOBAL.TraitorKingCultLoreConcept.Hyperlink} que vagavam pelas encostas do Monte Godkeep. O {EventUnit} retorna a eles, sorrindo com alegria maliciosa."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7516@BODY_LORE"
msgstr "\"Cultistas riem e torturam {GLOBAL.BloodClanLoreConcept.Hyperlink},\" diz {EventUnit} com ressentimento. \"Quem ri agora?\" <<Cp:EventUnit>> balança <<o:EventUnit>> grande maça em direção ao topo da montanha. \"Escudo de feitiço dos Cultistas quebrado. Agora, {EventHero} teme {EventUnit} vingança. Esconder-se na sala do trono. <<Co:EventHero>> colar de caveiras para {EventUnit}.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7516@BUTTON_0"
msgstr "Escolha o {BeastOgre} [unit/] acolhedor."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7516@BUTTON_4"
msgstr "Escolha o {TrainerOgre} [unit/] habilidoso."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7516@BUTTON_5"
msgstr "Escolha o {SeerOgre} [unit/] astuto."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7516@TITLE"
msgstr "Monte Godkeep: Ao Trono!"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7522@BODY_FOOTER"
msgstr "\"Não vejo presentes nem escravos dignos da minha magnificência\", conclui {CultHero}. \"Então vocês morrem.\" Atrás do trono, grandes {GLOBAL.BloodClanLoreConcept.Hyperlink} rosnam, prontos para defender seu \"<<CultHero{King/Queen}>>\" recém-encontrado."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7522@BODY_FOOTER@ENTRY_BLOCKED"
msgstr "Parece que {EventUnit} falou a verdade e só é possível entrar em {EventStructure} depois que um número suficiente de {GLOBAL.TraitorKingCultLoreConcept.Hyperlink} for morto para interromper seu feitiço."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7522@BODY_HEADER"
msgstr "Ao entrar pelo portão principal do complexo imponente, com suas grandes muralhas e estátuas, suas tropas se deparam com um salão imaculado de grandeza sem igual."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7522@BODY_HEADER@ENTRY_BLOCKED"
msgstr "Ao se aproximar do complexo imponente, com suas grandes muralhas e estátuas, suas tropas descobrem que todos os caminhos para dentro estão bloqueados."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7522@BODY_LORE"
msgstr "\"Vieram me oferecer reverência?\", uma voz gélida chama, ecoando pela câmara gigante. \"Ou terminarão suas vidas em desafio tolo? Pois quando olhei no Espelho, previ meu destino de empunhar os poderes dos deuses. Eu, {CultHero}, que trago a marca secreta de [hyperlink,GLOBAL.TraitorKingsLoreConcept]Kjörnoe[/hyperlink] e lidero seus Filhos para o domínio sombrio.\" À distância, a coroa de Netherice de {CultHero} revela os <<o:CultHero>> suportes abaixo do antigo trono gigante."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7522@BODY_LORE@ENTRY_BLOCKED"
msgstr "Um feitiço poderoso sela cada portão, cada porta, cada pequena brecha nas antigas muralhas, bloqueando-as com uma barreira impenetrável de Gelo Infernal."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7522@BUTTON_0"
msgstr "Faça este falso <<CultHero{King/Queen}>> se ajoelhar diante de <<o:CultHero>>!"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7522@BUTTON_1"
msgstr "Reprimenda [influence/], os trolls e ogros, por traírem seu rei."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7522@BUTTON_2"
msgstr "Fugir."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7522@TITLE"
msgstr "Monte Guardião: O Falso <<CultHero{King/Queen}>>"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7522@TITLE@ENTRY_BLOCKED"
msgstr "Monte Guardião: Barreira de Gelo"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7523@BODY_FOOTER"
msgstr "O {EventUnit} tira a coroa de <<o:EventUnit>>. \"{PlayerLeader} não é um {PlayerLeader.Title} digno. {EventUnit} não tem mais {GLOBAL.BloodClanLoreConcept.Hyperlink}. Seguirei {PlayerLeader}!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7523@BODY_HEADER"
msgstr "Com o {CultHero} caído vítima da <<o:CultHero>> arrogância, o {EventUnit} retorna à sala do trono que <<p:EventUnit>> já governou."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7523@BODY_LORE"
msgstr "\"{EventUnit} irmãos, todos mortos...\" <<p:EventUnit>> diz, olhando para os corpos dos {GLOBAL.BloodClanLoreConcept.Hyperlink} caídos espalhados pelas muitas câmaras de {EventStructure}. O {EventUnit} abaixa <<o:EventUnit>> cabeça enorme, <<o:EventUnit>> olhos horríveis ficando turvos. \"Culpa de {EventUnit}. {EventRelic} condenou {EventUnit}. Mostrou glória. Trouxe morte. Agora {EventRelic} condenou {CultHero}.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7523@BUTTON_3"
msgstr "Aceitar a vassalagem do {EventUnit} [unit/]."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7523@BUTTON_6"
msgstr "Enviar o {EventUnit} para o {GLOBAL.EternalSagesLoreConcept.Name} [allegiance/], compartilhando conhecimento sobre o {GLOBAL.BloodClanLoreConcept.Hyperlink} e o {GLOBAL.TraitorKingCultLoreConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7523@BUTTON_7"
msgstr "Sacrificar o {EventUnit} [evilact/] para reanimar {CultHero} [hero/] como seu servo das trevas."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7523@BUTTON_8"
msgstr "Sacrificar o {EventUnit} [evilact/] para reanimar {CultHero} [hero/] como seu servo das trevas."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7523@BUTTON_9"
msgstr "Apenas tomar a coroa do {EventUnit}, como um emblema [influence/] da sua crescente magnificência."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7523@TITLE"
msgstr "Monte Guardião: Consequências"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7754@BUTTON_3"
msgstr "\"Os sábios sabem [knowledge/] que só podem encontrar o que carregavam dentro de si.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7754@BUTTON_4"
msgstr "\"As energias arcanas [mana/] emanadas pelos cristais desta ilha aguçam nossas mentes.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7774@BODY_FOOTER@TRIAL_FAILED"
msgstr "A voz uníssona encerra seu discurso: \"Você será detido nestas ilhas, como muitos ladrões e saqueadores insignificantes que vieram antes!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7774@BODY_FOOTER@TRIAL_LOCKED"
msgstr "Você deve retornar aos locais do julgamento e responder ao {EventStackLeader} lá."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7774@BODY_HEADER@TRIAL_LOCKED"
msgstr "Suas tropas se aproximam cuidadosamente do {EventStackLeader}, flutuando entre as três ilhas, mas <<p:EventStackLeader>> as ignora."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7774@BODY_LORE@TRIAL_FAILED"
msgstr "\"Você enfrentou nossas provações,\" diz {EventStackLeader}, \"e consideramos suas respostas indignas!\" Há reflexos cristalinos na água, cegando suas tropas, mas eles desaparecem novamente quando {EventStackLeader} continua: \"Os <<m:{GLOBAL.GiantKingLoreConcept.Hyperlink}>> governaram {GLOBAL.MyrridaLoreConcept.Hyperlink} com grande sabedoria. Havia igualdade entre gigantes e os parentes menores, e até mesmo os <<m:{GLOBAL.GiantKingLoreConcept.Hyperlink}>> obedeciam à lei e aos vereditos dos {GLOBAL.EternalCouncilLoreConcept.Hyperlink}.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7774@BODY_LORE@TRIAL_LOCKED"
msgstr "\"Viemos julgar outro {GLOBAL.GodirLoreConcept.Hyperlink},\" exclama {EventStackLeader}. \"Volte até nós quando tiver respondido em nossas provações.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7774@BUTTON_0@TRIAL_LOCKED"
msgstr "Sair."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7774@BUTTON_1@TRIAL_FAILED"
msgstr "\"Você subestima os poderes de um {GLOBAL.GodirLoreConcept.Name}. Este aprisionamento termina agora!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7774@BUTTON_5"
msgstr "\"Coragem.\" [unitprod/][chaosboon/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7774@BUTTON_6"
msgstr "\"Caridade.\" [gold/][orderboon/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7774@BUTTON_7"
msgstr "\"Frugalidade.\" [food/][natureboon/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7774@TITLE@TRIAL_LOCKED"
msgstr "Ilha da Trindade: Os {EventStackLeader}"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7777@BODY_HEADER@TRIAL_FAILED"
msgstr "Você destruiu os {EventUnit} e arrancou a Ilha da Trindade das garras eternas de <<o:EventUnit>>."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7800@BODY_FOOTER"
msgstr "\"A Última Legião aguarda suas ordens,\" diz {EventUnit}. \"Somos os defensores de {GLOBAL.MyrridaLoreConcept.Hyperlink}. Dê a palavra e expulsaremos qualquer invasor.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7800@BODY_HEADER"
msgstr "Ao examinar os Artefatos de Flowrock que você possui, eles de repente ganham vida e, dentro do triângulo que formam, um {EventUnit} se ergue, puxado das profundezas do reino."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7800@BODY_LORE"
msgstr "\"Você nos convocou em seu auxílio, mestre?\" pergunta <<p:EventUnit>>, proferindo com uma voz sem boca. \"Dormimos ao longo das eras, esperando sob a terra. Este é o dia em que finalmente nos erguemos, expulsando todos os invasores que ameaçam {GLOBAL.MyrridaLoreConcept.Hyperlink}?\" Em sua mente, surgem imagens de intermináveis fileiras de soldados de argila, abrindo seus olhos sem pálpebras em túmulos eternos. Seus flancos são guardados por armas flutuantes dos antigos <<m:{GLOBAL.GiantKingLoreConcept.Hyperlink}>>, presas por uma magia imortal."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7800@BUTTON_0"
msgstr "Liberte a Última Legião sobre o reino!"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7800@BUTTON_1"
msgstr "Diga que convocará a Última Legião um a um, como verdadeiros defensores."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7800@BUTTON_2"
msgstr "Alivie a Última Legião de seu dever eterno, absorvendo a essência mágica [mana/][bindingessence/][bindingfragments/] que os mantinha vivos."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7800@TITLE"
msgstr "A Última Legião: Introdução"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7819@BODY_FOOTER"
msgstr "A Última Legião está emergindo de suas câmaras enterradas de outrora para atacar o reino. Como deseja se preparar para o ataque?"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7819@BODY_HEADER"
msgstr "O reino é tomado pelo medo enquanto histórias apocalípticas de uma mítica Última Legião de {GLOBAL.MyrridaLoreConcept.Hyperlink} se espalham."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7819@BODY_LORE"
msgstr "De fato, a terra está em tumulto. Você sente seus tremores, ouve seus murmúrios ancestrais. Camponeses de todo o reino contam histórias de figuras de argila se movendo na escuridão de seus campos. Ferreiros falam de armas ganhando vida e deixando as forjas para se juntar às fileiras da Última Legião. A veracidade dessas histórias ainda está por ser julgada, mas você sente um perigo iminente."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7819@BUTTON_0"
msgstr "\"Reúnam os vassalos! [influence/] Este é o momento em que honrarão nossos pactos.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7819@BUTTON_1"
msgstr "\"Que os arautos [influence/] reúnam qualquer homem ou mulher [unitprod/] dispostos a defender nossas cidades!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7819@BUTTON_2"
msgstr "\"Um Godir não teme nem montes de argila nem armas enferrujadas.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7819@TITLE"
msgstr "A Última Legião: Agitações na Terra"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7821@BODY_FOOTER"
msgstr "Os exércitos da Última Legião marcham contra suas cidades. Rechaçe seus ataques, ou tudo será reduzido a nada!"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7821@BODY_HEADER"
msgstr "Um silêncio perturbador recai sobre suas cidades enquanto intermináveis fileiras de Soldados de Argila emergem da terra."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7821@BODY_LORE"
msgstr "Eles não pronunciam palavra, tampouco as armas encantadas que flutuam a seus flancos. Mas fica claro que esta Última Legião de Myrrida tem um único propósito: eliminar qualquer um que tenha presença no antigo reino perdido deles — exceto nas terras de {EventPlayer}. Neste momento de maior perigo, a traição dos {EventPlayer.Title} de {EventRace} se revela. Foi <<P:EventPlayer>> quem libertou a Última Legião!"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7821@BUTTON_0"
msgstr "\"Assim que superarmos esta tempestade, {EventPlayer} pagará por isso!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7821@TITLE"
msgstr "A Última Legião: Ataque Global"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7848@BODY_FOOTER"
msgstr "Neste momento de vitória pesarosa, os {EventRace} se voltam para seus {PlayerLeader.Title}. Você fecha os olhos e remodela a argila e as armas espalhadas em..."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7848@BODY_HEADER"
msgstr "Com a Última Legião esmagada e derrotada, um senso de paz finalmente retorna ao seu reino."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7848@BODY_LORE"
msgstr "No entanto, há pouco motivo para uma vitória alegre. Pois quando os inimigos eram apenas argila e aço sem coração, os corpos nos campos de batalha ilustram claramente as perdas do seu povo. Há rumores de outros Godir ainda resistindo à Última Legião em seus domínios. Mas isso não deve preocupá-lo, pois os {EventRace} estão a salvo."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7848@BUTTON_0"
msgstr "...um monumento de guerra. [unitprod/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7848@BUTTON_2"
msgstr "...um monumento de paz. [goodact/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7848@BUTTON_3"
msgstr "...um mausoléu para os caídos. [influence/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7848@BUTTON_4"
msgstr "...trabalhadores de argila para reconstruir suas cidades. [structureprod/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7848@TITLE"
msgstr "A Última Legião: Fragmentos de Argila"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7857@BODY_FOOTER"
msgstr "\"Um batalhão está sob seu comando direto, mestre,\" conclui {EventUnit}. \"Que você nos conduza à vitória!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7857@BODY_HEADER"
msgstr "A Última Legião chega em terrível esplendor enquanto intermináveis fileiras de Soldados de Argila emergem da terra."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7857@BODY_LORE"
msgstr "\"A hora está próxima, mestre,\" fala um {EventUnit} que se manifestou <<r:EventUnit>> em seu salão do trono. \"Hoje emergimos de nossas câmaras profundas para defender os vestígios de {GLOBAL.MyrridaLoreConcept.Hyperlink}. Finalmente, nosso propósito será cumprido!\" Os incontáveis exércitos da Última Legião iniciam sua marcha contra os outros Godir do reino. Ao perceberem sua traição, amaldiçoam seu nome, mas já é tarde demais."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7857@BUTTON_0"
msgstr "\"E a vitória será nossa!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7857@TITLE"
msgstr "A Última Legião: Glória de Myrrida"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_1@DESCRIPTION"
msgstr "Ataques base de {GLOBAL.MagicConcept.Hyperlink} de unidades encantadas ganham:[bulletlist][bullet/]Uma chance base de {VOLATILE_CHARGE_RESISTANCE>ResolvedStrength}% de aplicar {GLOBAL.PROPERTIES.VOLATILE_CHARGE.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_1@NAME"
msgstr "Foco de Cristal"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_1@PROP_DESCRIPTION"
msgstr "Ataques base de {GLOBAL.MagicConcept.Hyperlink} da unidade têm:[bulletlist][bullet/]Uma chance base de {VOLATILE_CHARGE_RESISTANCE>ResolvedStrength}% de aplicar {GLOBAL.PROPERTIES.VOLATILE_CHARGE.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_2@DESCRIPTION"
msgstr "Unidades inimigas em um raio de {VOLATILE_CHARGE_TARGETER>AREA>Radius} hexes:[bulletlist][bullet/]Sofrem {CRYSTAL_CRASH_UNIT_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Sofrem {CRYSTAL_CRASH_UNIT_DAMAGE>DAMAGE>Shock} {GLOBAL.LightningDamageConcept.Hyperlink}.[bullet/]Têm uma chance base de {VOLATILE_CHARGE_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.VOLATILE_CHARGE.Hyperlink} por {VOLATILE_CHARGE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_2@NAME"
msgstr "Impacto de Cristal"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_3@DESCRIPTION"
msgstr "Um(a) {GLOBAL.PROPERTIES.POLEARM_UNIT.Hyperlink} que imobiliza inimigos. Recrutável em cidades."

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_3@NAME"
msgstr "Lanceiro de Fragmento de Litorina"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_4@DESCRIPTION"
msgstr "Um(a) {GLOBAL.PROPERTIES.BATTLE_MAGE.Hyperlink} que inflige {GLOBAL.PROPERTIES.VOLATILE_CHARGE.Hyperlink} em uma grande área. Recrutável em cidades."

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_4@NAME"
msgstr "Lançador de Gemas de Litorina"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_5@DESCRIPTION"
msgstr "Revive uma unidade não-Litorina e não-Herói alvo como uma Litorina de seu Nível.[br/][br/]Se vitoriosa em combate, unidades revividas podem ser mantidas por um custo de {GLOBAL.ManaConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_5@NAME"
msgstr "Cristalizar Essência"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_6@DESCRIPTION"
msgstr "[bulletlist][bullet/]{amount} {GLOBAL.ManaConcept.Hyperlink}[bullet/]{amount2} {GLOBAL.KnowledgeConcept.Hyperlink}[bullet/]{amount3} {GLOBAL.ImperiumConcept.Hyperlink}[/bulletlist]"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_6@NAME"
msgstr "Embaixada Eterna"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_7@DESCRIPTION"
msgstr "Um(a) {GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink} com um ataque forte de carga e a habilidade de criar uma corrente de raios que pode ativar {GLOBAL.PROPERTIES.VOLATILE_CHARGE.Hyperlink}. Recrutável em cidades."

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_7@NAME"
msgstr "Simulacro de Litorina"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_8@DESCRIPTION"
msgstr "Um(a) {GLOBAL.PROPERTIES.SUPPORT_UNIT.Hyperlink} que pode se conectar a unidades e receber o dano por elas. Recrutável em cidades."

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_8@NAME"
msgstr "Núcleo de Litorina"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_9@DESCRIPTION"
msgstr "Um(a) {GLOBAL.PROPERTIES.RANGED_UNIT.Hyperlink} com um ataque à distância que aplica {GLOBAL.PROPERTIES.VOLATILE_CHARGE.Hyperlink}. Recrutável em cidades."

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_9@NAME"
msgstr "Aguilhador de Litorina"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@TOME@DESCRIPTION"
msgstr "Estes benefícios podem ser comprados de um {GLOBAL.CrystalDwellingConcept.Hyperlink} ao alcançar um Pacto de Cristal ou Eterno com eles. Eles lhe darão acesso a unidades de Lithorine e ao poder dos Eternos."

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@TOME@NAME"
msgstr "Pacto de Cristal"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL1@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{amount1} {GLOBAL.GoldConcept.Hyperlink}[bullet/]+{amount2} {GLOBAL.GoldConcept.Hyperlink} por Masmorra adjacente {GLOBAL.ProvinceConcept.Hyperlink}.[bullet/]+{amount3} {GLOBAL.BindingEssenceConcept.Hyperlink} por Masmorra adjacente {GLOBAL.ProvinceConcept.Hyperlink}[bullet/]Conta como um {GLOBAL.MineConcept.Hyperlink}[/bulletlist]"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL1@NAME"
msgstr "[mine/] Cofre Subterrâneo"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL2@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{amount1} {GLOBAL.StructureProductionConcept.Hyperlink} por Masmorra adjacente {GLOBAL.ProvinceConcept.Hyperlink}.[bullet/]+{amount2} {GLOBAL.UnitProductionConcept.Hyperlink} por Masmorra adjacente {GLOBAL.ProvinceConcept.Hyperlink}.[bullet/]Permite o recrutamento das unidades {GLOBAL.UNITS.CLAY_ARBALEST.Hyperlink}, {GLOBAL.UNITS.CLAY_CHARGER.Hyperlink} e {GLOBAL.UNITS.CLAY_DEFENDER.Hyperlink}.[bullet/]Conta como um {GLOBAL.QuarryConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL2@NAME"
msgstr "[quarry/] Forja de Argila"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL3@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{amount1} {GLOBAL.FortificationHealthConcept.Hyperlink} por Masmorra adjacente {GLOBAL.ProvinceConcept.Hyperlink}.[bullet/]+{amount2} {GLOBAL.CityStabilityConcept.Hyperlink} por Masmorra adjacente {GLOBAL.ProvinceConcept.Hyperlink}.[bullet/]Um {GLOBAL.UNITS.CLAY_ARBALEST.Hyperlink}, {GLOBAL.UNITS.CLAY_CHARGER.Hyperlink} ou um {GLOBAL.UNITS.CLAY_DEFENDER.Hyperlink} entra em combate ao seu lado quando lutando no domínio desta cidade (não funciona em água ou lava).[bullet/]Conta como um {GLOBAL.QuarryConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL3@EFFECT_DESCRIPTION"
msgstr "Adiciona aleatoriamente uma unidade {GLOBAL.UNITS.CLAY_ARBALEST.Hyperlink}, {GLOBAL.UNITS.CLAY_CHARGER.Hyperlink} ou {GLOBAL.UNITS.CLAY_DEFENDER.Hyperlink} a esta batalha."

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL3@NAME"
msgstr "[quarry/] Quartel Silencioso"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL4@DESCRIPTION"
msgstr "Exército inimigo alvo:[bulletlist][bullet/]Sofre {amount} {GLOBAL.PhysicalDamageConcept.Hyperlink}, dobrado se conjurado em uma Masmorra {GLOBAL.ProvinceConcept.Hyperlink}.[bullet/]Por {duration} {GLOBAL.WorldMapConcept.Hyperlink} {GLOBAL.TurnConcept}, no início do combate as unidades neste exército ficam {GLOBAL.PROPERTIES.SLOWED.Hyperlink} por {duration2} {GLOBAL.TurnConcept}.[/bulletlist]"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL4@NAME"
msgstr "Perigo de Masmorra"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL4@PROP_DESCRIPTION"
msgstr "No início do combate, esta unidade fica {GLOBAL.PROPERTIES.SLOWED.Hyperlink} por {SLOWED_EFFECT_DESCRIPTION>NumTurns} {GLOBAL.TurnConcept}."

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL5@DESCRIPTION"
msgstr "Unidades encantadas ganham:[bulletlist][bullet/]{GLOBAL.PROPERTIES.CAVE_WALK.Hyperlink}[bullet/]Enquanto no Subterrâneo:[bulletlist][bullet/]+{amount1} {GLOBAL.DefenseConcept.Hyperlink}[bullet/]+{amount2} {GLOBAL.ResistanceConcept.Hyperlink}[/bulletlist][bullet/]Enquanto na superfície:[bulletlist][bullet/]Causa +{amount3}% de dano[/bulletlist][/bulletlist]"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL5@NAME"
msgstr "Invasores das Profundezas"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL5@PROP_DESCRIPTION"
msgstr "Esta unidade possui:[bulletlist][bullet/]{GLOBAL.PROPERTIES.CAVE_WALK.Hyperlink}[bullet/]Enquanto no Subterrâneo:[bulletlist][bullet/]+{amount1} {GLOBAL.DefenseConcept.Hyperlink}[bullet/]+{amount2} {GLOBAL.ResistanceConcept.Hyperlink}[/bulletlist][bullet/]Enquanto na superfície:[bulletlist][bullet/]Causa +{amount3}% de dano[/bulletlist][/bulletlist]"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SPI@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{amount} {GLOBAL.KnowledgeConcept.Hyperlink} [bullet/]A cada {GLOBAL.TurnConcept.Hyperlink}, um {GLOBAL.ProvinceConcept.Hyperlink} no {GLOBAL.CityConcept.Hyperlink} do {GLOBAL.DomainConcept.Hyperlink}:[bulletlist][bullet/]Ganha {GLOBAL.DungeonConcept.Hyperlink}.[/bulletlist][bullet/]Ganha +{amount2} {GLOBAL.StructureProductionConcept.Hyperlink} por Masmorra adjacente {GLOBAL.ProvinceConcept.Hyperlink}.[bullet/]Conta como um {GLOBAL.ResearchPostConcept.Hyperlink}.[/bulletlist]"

