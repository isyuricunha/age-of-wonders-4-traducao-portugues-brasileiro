msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@ELEMENTAL_ATTUNEMENT@DESCRIPTION"
msgstr "Todas as {GLOBAL.PROPERTIES.ELEMENTAL.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> recebem {GLOBAL.PROPERTIES.ELEMENTAL_ATTUNEMENT_UNITPROP.Hyperlink} até o fim do combate."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@ELEMENTAL_ATTUNEMENT@NAME"
