msgstr "Cajados da Proteção"

msgid "TOME_WARDING@SKILL2@PROPERRTY_DESCRIPTION"
msgstr "{GLOBAL.SupportConcept.Hyperlink} concedem +{amount} {GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink} às unidades afetadas."

msgid "TOME_WARDING@SKILL3@DESCRIPTION"
msgstr "Invoca um {GLOBAL.UNITS.PHANTASM_WARRIOR_UNIT.Hyperlink}, um {GLOBAL.PROPERTIES.SHIELD_UNIT.Hyperlink} que atinge com {GLOBAL.LightningDamageConcept.Hyperlink}."

msgid "TOME_WARDING@SKILL3@NAME"
msgstr "Invocar Guerreiro Fantasma"

msgid "TOME_WARDING@SKILL4@DESCRIPTION"
msgstr "Alvo unidade amiga e outra dentro de {STATIC_SHIELD_UNIT_TARGETER_JUMP>MaxDistance} hexágonos ganham {GLOBAL.PROPERTIES.STATIC_SHIELD_GROUP.Hyperlink} por {STATIC_SHIELD_STATUS_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "TOME_WARDING@SKILL4@NAME"
msgstr "Escudo Estático"

msgid "TOME_WARDING@SKILL4@PROP_DESCRIPTION"
msgstr "Atacantes têm uma chance base de {STUNNED_RESISTANCE>ResolvedStrength}% de se tornarem {GLOBAL.PROPERTIES.STUNNED.Hyperlink}."

msgid "TOME_WARDING@SKILL5@DESCRIPTION"
msgstr "Inscreve guardas mágicas na raça alvo, concedendo:[bulletlist][bullet/]+{MAGIAL_WARDS_RESISTANCE>REDUCTION>Shock} {GLOBAL.LightningResistanceConcept.Hyperlink}[bullet/]+{MAGIAL_WARDS_RESISTANCE>REDUCTION>Fire} {GLOBAL.FireResistanceConcept.Hyperlink}[bullet/]+{MAGIAL_WARDS_RESISTANCE>REDUCTION>Frost} {GLOBAL.FrostResistanceConcept.Hyperlink}[/bulletlist]"

msgid "TOME_WARDING@SKILL5@NAME"
msgstr "Guardas Mágicas"

msgid "TOME_WARDING@SKILL5@PROPERTY_DESCRIPTION"
msgstr "Unidade tem:[bulletlist][bullet/]+{MAGIAL_WARDS_RESISTANCE>REDUCTION>Shock} {GLOBAL.LightningResistanceConcept.Hyperlink}[bullet/]+{MAGIAL_WARDS_RESISTANCE>REDUCTION>Fire} {GLOBAL.FireResistanceConcept.Hyperlink}[bullet/]+{MAGIAL_WARDS_RESISTANCE>REDUCTION>Frost} {GLOBAL.FrostResistanceConcept.Hyperlink}[/bulletlist]"

msgid "TOME_WARDING@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Especialize-se em magia que protege suas unidades do dano e retalia contra inimigos que o atacam."

msgid "TOME_WARDING@TOME@LORE_AUTHOR"
msgstr "Tempest, Mestre das Tempestades"

msgid "TOME_WARDING@TOME@LORE_DESCRIPTION"
msgstr "\"Aqueles que dominam o arcano são como uma brisa suave sobre seus aliados, envolvendo‑os em um manto protetor de ar, afastando golpes e canalizando o relâmpago para castigar quem ousa chegar muito perto! Um mestre da proteção encontrará inúmeras maneiras de manter seus súditos seguros.\""

msgid "TOME_WARDING@TOME@NAME"
msgstr "Tomo da Proteção"

msgid "TOME_WARDING@UNIT@NAME"
msgstr "Guerreiro Fantasma"

msgid "TOME_WILD@BEASTMASTER@ABILITY_1@DESCRIPTION"
