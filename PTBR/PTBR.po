msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@ANCIENT_BATTLEFIELD@DESCRIPTION"
msgstr "<<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacente a este Marco ganha:[bulletlist][bullet/]{income}.[bullet/]Se <<m:{GLOBAL.SoulConcept.Hyperlink}>> forem obtidos, esta província concede {income2}.[bullet/]O {combatproperty} {GLOBAL.CombatEnchantmentConcept.Hyperlink}[/bulletlist][br/]Uma {GLOBAL.CityConcept.Hyperlink} com {amount} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacente a este Marco ganha:[bulletlist][bullet/]Unidades de <<m:{GLOBAL.UnitConcept.Hyperlink}>> de Nível 1 têm seu custo de recrutamento reduzido em {discount} na Cidade.[bullet/]Se <<m:{GLOBAL.SoulConcept.Hyperlink}>> forem obtidos, desbloqueia o recrutamento de unidades Esqueleto de Nível 1.[/bulletlist]"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@ANCIENT_BATTLEFIELD@LORE"
msgstr "\"Você sente? A magia proibida persiste neste campo de batalha... Não de criação, mas de não-vida. Meu povo conta a história de um [hyperlink,GLOBAL.TraitorKingsLoreConcept]Rei Traidor[/hyperlink] que amaldiçoou o solo com magias antigas onde caiu... Nenhum que lutou aqui conhecerá paz. E assim, as almas dos caídos permanecem entre seus ossos, lutando eternamente, morrendo eternamente...\"[br/][br/]— Fjalla Tor-Builder, Nos Passos do Gigante: Conforme citado por Ham Binger"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@ANCIENT_BATTLEFIELD@NAME"
msgstr "Campo de Batalha Assombrado"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@CASCADE_FALLS@DESCRIPTION"
msgstr "<<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacente a este Marco ganha:[bulletlist][bullet/]{income}.[bullet/]Uma [farm/] Fazenda ou [forester/] Silvicultor nesta província concede {income2}.[/bulletlist][br/]Uma {GLOBAL.CityConcept.Hyperlink} com {amount} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacente a este Marco ganha:[bulletlist][bullet/]Desbloqueia o recrutamento de <<{GLOBAL.UNITS.LESSER_TIDE_SPIRIT.Hyperlink}>> e <<{GLOBAL.UNITS.TIDE_SPIRIT.Hyperlink}>>.[bullet/]Aliado <<m:{GLOBAL.UnitConcept.Hyperlink}>> no domínio [hyperlink,GLOBAL.WorldMapRegeneration]regenera[/hyperlink] {regen} a cada {GLOBAL.TurnConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@CASCADE_FALLS@LORE"
msgstr "\"Quando a coroa pesava sobre minha mãe, ela buscava refúgio no santuário das quedas. Dizia que a cascata afoga todo o caos. Em minha busca por ela, também venho a este lugar de paz. Eu vado ao rio, deixo a torrente me envolver, e em seu ritmo implacável redescubro clareza e força.\"[br/][br/]— Sundren da Casa Inioch, Memórias da Corte Élfica"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@CASCADE_FALLS@NAME"
msgstr "Cachoeira da Cascata"

