msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@DEFEAT_REVENANT_QUEST_OBJECTIVE"
msgstr "{INT_0}/{INT_1} Revenantes Derrotados"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@DESCRIPTION"
msgstr "Entre no reino oculto de Emnora, fortaleza dos {GLOBAL.ArchonsLoreConcept.Hyperlink}, em busca de ajuda contra {GLOBAL.UrrathLoreConcept.Hyperlink}. Lute ou negocie seu caminho pelas camadas da Ordem Celestial para provar seu valor e {GLOBAL.MagehavenLoreConcept.Hyperlink} digno da atenção do Alto Conselho dos Arcontes."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@EFFECT@WIZARD_TOWER_REWARD"
msgstr "Sua {GLOBAL.ThroneCityConcept.Hyperlink} {EventCity} ganha o {GLOBAL.STRUCTURE_UPGRADES.WIZARD_TOWER_FOUNDATION.Hyperlink} {GLOBAL.CityStructureConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@FALLEN_ANGEL_NO_UPKEEP_PROP@DESCRIPTION"
msgstr "Esta unidade está vinculada ao seu dono pela Maldição dos Revenantes e não tem manutenção."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@FALLEN_ANGEL_NO_UPKEEP_PROP@NAME"
msgstr "Vínculo da Corrupção"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@GLOOMWATCH_RACE@DESCRIPTION"
msgstr "No {GLOBAL.GloomwatchLoreConcept.Hyperlink} pessoas de muitas raças e origens diferentes se unem, ligadas ao serviço do {GLOBAL.DreamersLoreConcept.Hyperlink} — e à resistência contra {GLOBAL.UrrathLoreConcept.Hyperlink}. Um grupo particularmente misterioso entre eles são os Enviados da Vigília Sombria. Eles têm aparência justa e são devotos inabaláveis do {GLOBAL.AllfatherLoreConcept.Hyperlink}. Como tal, são muito bem informados sobre o {GLOBAL.ArchonsLoreConcept.Hyperlink} e estão dispostos a ajudar [hyperlink,GLOBAL.MagehavenLoreConcept]Magehaven's[/hyperlink] {GLOBAL.GodirLoreConcept.Hyperlink} em sua busca por contato com o Arconte."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@GLOOMWATCH_RACE@NAME"
msgstr "Enviados da Vigília Sombria^p"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@HIGH_COUNCIL@NAME"
msgstr "Sede do Conselho^N"

