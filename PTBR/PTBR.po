msgstr "Transforme suas unidades enquanto elas absorvem ritualmente sangue de um Exarca, concedendo-lhes:[bulletlist][bullet/]O tipo de unidade {GLOBAL.PROPERTIES.UNDEAD.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.LIFEDRINKER.Hyperlink}.[bullet/]Ataques base têm uma chance base de {BLOOD_PARASITE_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.BLOOD_PARASITE.Hyperlink} por {BLOOD_PARASITE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>. Esse efeito é aumentado para ataques de Tiro Único.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@SKILL5@NAME"
msgstr "Dádiva do Sangue Antigo"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@SKILL5@PROP_DESCRIPTION"
msgstr "Unidade tem:[bulletlist][bullet/]O tipo de unidade {GLOBAL.PROPERTIES.UNDEAD.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.LIFEDRINKER.Hyperlink}.[bullet/]Ataques base têm uma chance base de {BLOOD_PARASITE_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.BLOOD_PARASITE.Hyperlink} por {BLOOD_PARASITE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>. Esse efeito é aumentado para ataques de Tiro Único.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Abraçe uma magia esquecida e corrupta que fortalece suas unidades de alto nível e faz sua facção adotar uma forma antiga de não-morte, ganhando o poder de espalhar <<m:{GLOBAL.PROPERTIES.BLOOD_PARASITE.Hyperlink}>> sobre seus inimigos."

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@TOME@LORE_DESCRIPTION"
msgstr "\"O sangue carrega um poder maior do que os mortais imaginam. O sangue dos Arcontes não carrega sua essência? Não usamos o sangue como pagamento por nossa magia? O sangue é onde a alma reside! E assim, nós bebemos, para preencher o vazio dentro de nós. Pois a Dádiva do Sangue Antigo exige almas para sacrificar... E há muito deixamos de gastar as nossas.\""

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@TOME@NAME"
msgstr "Tomo do Reinado Carmesim"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@ABILITY01@DESCRIPTION"
msgstr "Ataque a unidade alvo e ganhe <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> igual a {DRAINING_STRIKE_LIFE_STEAL>ResolvedHealProportion}% do dano causado."

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@ABILITY01@NAME"
msgstr "Golpe Drenante"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@ABILITY02@NAME"
msgstr "Chicote Atormentador"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@ABILITY03@DESCRIPTION"
msgstr "Teleporte para a casa-alvo."

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@ABILITY03@NAME"
msgstr "Passo das Sombras"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@GAMEPLAY_DESCRIPTION"
msgstr "Atormente seus inimigos, fazendo com que suas próprias ações se voltem contra eles, e deixe suas unidades fortalecidas pela dor."

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@LORE_DESCRIPTION"
msgstr "\"Faça seus corpos tremerem de tormento. A cada passo que dão, pagarão com grunhidos de agonia. Que o sofrimento escorra como mel sobre sua pele pulsante. Faça-os se curvar, faça-os implorar, faça-os suplicar ao seu portador da dor... E guarde um pouco de tormento para si, pois o sofrimento é melhor infligido quando desfrutado em primeira mão.\""

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@NAME"
msgstr "Tomo do Tormento"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@PAIN_BRINGER@NAME"
msgstr "Portador da Dor^f"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SKILL1@DESCRIPTION"
msgstr "A raça-alvo aceita a dor e, quando atingida por um ataque, ganha:[bulletlist][bullet/]{PAINBOUND_MORALE>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}.[bullet/]Um efeito de status positivo aleatório.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SKILL1@NAME"
msgstr "Vinculado à Dor"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SKILL1@PROP_DESCRIPTION"
msgstr "Quando esta unidade é atingida por um ataque, ela ganha:[bulletlist][bullet/]{PAINBOUND_MORALE>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}.[bullet/]Um efeito de status positivo aleatório.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SKILL2@DESCRIPTION"
msgstr "{GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink} que atormenta seus inimigos e pode flanqueá-los com facilidade, drenando sua vitalidade."

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SKILL2@NAME"
msgstr "Portador da Dor"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SKILL3@DESCRIPTION"
msgstr "{GLOBAL.RangedConcept.Hyperlink} e {GLOBAL.MagicConcept.Hyperlink} ataques de unidades encantadas:[bulletlist][bullet/]Têm uma chance base de {TORMENTED_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.TORMENT.Hyperlink} até o fim do combate.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SKILL3@NAME"
msgstr "Projéteis Atormentadores"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SKILL3@PROP_DESCRIPTION"
msgstr "{GLOBAL.RangedConcept.Hyperlink} e {GLOBAL.MagicConcept.Hyperlink} ataques:[bulletlist][bullet/]Têm uma chance base de {TORMENTED_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.TORMENT.Hyperlink} até o fim do combate.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SKILL4@DESCRIPTION"
msgstr "Unidades inimigas em um raio de {AGONIZE_UNIT_TARGETER_CIRCLE>AREA>Radius} casas:[bulletlist][bullet/]Sustentam {AGONIZE_UNIT_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}[bullet/]Têm uma chance base de {AGONIZE_RESISTANCE_CHECK>ResolvedStrength}% de ganhar {TORMENT_REPEATER>Count} pilhas de {GLOBAL.PROPERTIES.TORMENT.Hyperlink} até o fim do combate. Em caso de falha, infligem {amount} pilha de {GLOBAL.PROPERTIES.TORMENT.Hyperlink} em vez disso.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SKILL4@NAME"
msgstr "Agonizar"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SKILL5@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{amount} {GLOBAL.ManaConcept.Hyperlink}.[bullet/]+{amount2} <<m:{GLOBAL.CombatCastingPointConcept.Hyperlink}>>.[bullet/]<<m:{GLOBAL.DamageSpellConcept.Hyperlink}>> e <<m:{GLOBAL.DebuffSpellConcept.Hyperlink}>> aplicam uma perda extra de {amount3} {GLOBAL.UnitMoraleConcept.Hyperlink}.[/bulletlist][br/][br/]Só pode ser construído no(a) {GLOBAL.ThroneCityConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SKILL5@MOD_DESCRIPTION"
msgstr "Alvos perdem {amount} {GLOBAL.UnitMoraleConcept.Hyperlink}"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SKILL5@NAME"
msgstr "Lente da Angústia"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SPI@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{amount} de renda de {GLOBAL.ManaConcept.Hyperlink}.[bullet/]+{amount2} de renda de {GLOBAL.KnowledgeConcept.Hyperlink}.[bullet/]+{amount3} {GLOBAL.CityStabilityConcept.Hyperlink}[bullet/]+{amount4} {GLOBAL.ManaConcept.Hyperlink} por {GLOBAL.FarmConcept.Hyperlink} adjacente.[bullet/]+{amount5} {GLOBAL.KnowledgeConcept.Hyperlink} por {GLOBAL.ForesterConcept.Hyperlink} adjacente.[bullet/]Conta como um(a) {GLOBAL.ConduitConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SPI@NAME"
msgstr "[conduit/] Basílica do Lamento"

msgid "DLC@THRONESOFBLOOD@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@VAMPIRE_LORD@DESCRIPTION"
msgstr "{LOC.DLC@THRONESOFBLOOD@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@VAMPIRE_LORD@DESCRIPTION_SHORT}[br/][bulletlist][bullet/]Uma unidade {GLOBAL.PROPERTIES.UNDEAD.Hyperlink} com uma [hyperlink,GLOBAL.PROPERTIES.SUNLIGHT_WEAKNESS]aversão à luz[/hyperlink].[bullet/]Tem acesso ao {GLOBAL.STRUCTURE_UPGRADES.LORD_CASTLE_FOUNDATION.Hyperlink}, que substitui o {GLOBAL.STRUCTURE_UPGRADES.WIZARD_TOWER_FOUNDATION.Hyperlink} e concede o uso de <<m:{GLOBAL.ThrallConcept.Hyperlink}>> para lançar poderosos <<m:{GLOBAL.SpellConcept.Hyperlink}>> rituais.[bullet/]Drena {amountXP}% da {GLOBAL.ExperienceConcept.Hyperlink} de combate obtida por heróis Vampiros Transformados a cada turno.[bullet/]A facção é imune às penalidades de terreno Sem Sol em {GLOBAL.CityStabilityConcept.Hyperlink} e {GLOBAL.UnitMoraleConcept.Hyperlink}.[bullet/]Vampiros Anciões são <<m:{GLOBAL.PROPERTIES.HEROTRAIT_GOVERNANCE_VAMPIRE_GOVERNOR.Hyperlink}>>.[bullet/]Vampiros Anciões têm uma {amount3} {GLOBAL.GoldConcept.Hyperlink} {GLOBAL.UnitUpkeepConcept.Hyperlink}[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@VAMPIRE_LORD@DESCRIPTION_SHORT"
msgstr "[helpcolor]Um Vampiro imortal que drena a vida dos inimigos sob o manto da noite.[/helpcolor]"

msgid "DLC@THRONESOFBLOOD@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@VAMPIRE_LORD@HYPERLINK"
msgstr "[hyperlink,GLOBAL.VampireLordConcept]Vampiro Ancião[/hyperlink]"

msgid "DLC@THRONESOFBLOOD@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@VAMPIRE_LORD_HYBRID@DESCRIPTION"
msgstr "{LOC.DLC@THRONESOFBLOOD@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@VAMPIRE_LORD_HYBRID@DESCRIPTION_SHORT}[br/][bulletlist][bullet/]Pode ter qualquer forma.[/bulletlist][br/]"

msgid "DLC@THRONESOFBLOOD@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@VAMPIRE_LORD_HYBRID@DESCRIPTION_SHORT"
msgstr "[helpcolor]Um Vampiro descendente de uma das muitas raças que habitam o Mar Astral.[/helpcolor]"

msgid "DLC@THRONESOFBLOOD@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@VAMPIRE_LORD_PUREBLOOD@DESCRIPTION"
msgstr "{LOC.DLC@THRONESOFBLOOD@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@VAMPIRE_LORD_PUREBLOOD@DESCRIPTION_SHORT}[br/][bulletlist][bullet/]Tem opções de aparência exclusivas.[/bulletlist][br/]"

msgid "DLC@THRONESOFBLOOD@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@VAMPIRE_LORD_PUREBLOOD@DESCRIPTION_SHORT"
msgstr "[helpcolor]Um Vampiro descendente dos Arqui-Vampiros de Drevanya.[/helpcolor]"

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_ECHOES_01@AFFINITY_CHOICE_MATERIUM@FAILURE"
msgstr "Suas tentativas de transmutação não surtiram efeito."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_ECHOES_01@AFFINITY_CHOICE_MATERIUM@HEADER"
msgstr "Anule os ecos que ricocheteiam nas paredes da caverna:"

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_ECHOES_01@AFFINITY_CHOICE_MATERIUM@SUCCESS"
msgstr "A determinação do seu exército cresce contra o <<m:EventUnit>>."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_MAGGOTS_01@AFFINITY_CHOICE_NATURE@FAILURE"
msgstr "A natureza não consegue superar a manipulação do <<m:EventUnit>>."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_MAGGOTS_01@AFFINITY_CHOICE_NATURE@HEADER"
msgstr "Anule qualquer influência que os <<m:EnemyUnit>> tenham sobre os <<m:EventUnit>>:"

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_MAGGOTS_01@AFFINITY_CHOICE_NATURE@SUCCESS"
msgstr "Recém-nascidos <<m:EventUnit>> atacam seus hospedeiros voluntários primeiro."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_MAGGOTS_01@AFFINITY_CHOICE_SHADOW@FAILURE"
msgstr "A sede de sangue dos <<m:EventUnit>> transcende sua carne de gosto repugnante."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_MAGGOTS_01@AFFINITY_CHOICE_SHADOW@HEADER"
msgstr "Encante seu exército para dissuadir os <<m:EventUnit>> de beberem seu sangue:"

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_MAGGOTS_01@AFFINITY_CHOICE_SHADOW@SUCCESS"
msgstr "Os <<m:EventUnit>> têm menos chances de injetar parasitas sanguíneos em seus guerreiros."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_TORMENT_01@AFFINITY_CHOICE_CHAOS@FAILURE"
msgstr "Para <<G:disappointment^n,{EventHero.FirstName}>>, a dor ainda causa dano."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_TORMENT_01@AFFINITY_CHOICE_CHAOS@HEADER"
msgstr "{EventHero} também busca prazer na dor:"

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_TORMENT_01@AFFINITY_CHOICE_CHAOS@SUCCESS"
msgstr "A mesma exaltação que inspira os ritualistas também beneficia {EventHero.FirstName}."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_TORMENT_01@AFFINITY_CHOICE_ORDER@FAILURE"
msgstr "Os discípulos de {EnemyUnit} e <<o:EnemyUnit>> zombam da sua desaprovação pudica."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_TORMENT_01@AFFINITY_CHOICE_ORDER@HEADER"
msgstr "Tentar condenar <<G:ritualists^p,EnemyUnit>>:"

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_TORMENT_01@AFFINITY_CHOICE_ORDER@SUCCESS"
msgstr "Suas palavras acertam em cheio. Seus oponentes são tomados pela vergonha."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@ENTHRALL_HUNTRESS@AFFINITY_CHOICE@FAILURE"
msgstr "Furioso, {Huntress.FirstName} resiste à sua tentativa de subjugar <<o:Huntress>>."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@ENTHRALL_HUNTRESS@AFFINITY_CHOICE@HEADER"
msgstr "Tentar subjugar {Huntress.FirstName} no momento de distração de <<P:Huntress>>."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@ENTHRALL_HUNTRESS@AFFINITY_CHOICE@SUCCESS"
msgstr "{Huntress.FirstName} se torna seu servo e <<P:Huntress>> {Huntress.Race} o segue."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@ENTHRALL_HUNTRESS@AFFINITY_CHOICE@SUCCESS_ALT"
msgstr "{Huntress.FirstName} é subjugado. Todos os <<o:Huntress>> <<m:{GLOBAL.CityConcept.Hyperlink}>> e <<m:{GLOBAL.UnitConcept.Hyperlink}>> serão removidos do mapa."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@LOST_SOUL@LEVEL_UP_TWICE"
msgstr "{EventHero} ganha experiência suficiente para subir de nível [xp/] duas vezes."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@LOST_SOUL@SPIRIT_RES"
msgstr "{EventHero} ganha +2 {GLOBAL.SpiritResistanceConcept.Name}[defensespirit/]."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@ROSE_PALACE_BANQUET_01@AFFINITY_CHOICE_MATERIUM@FAILURE"
msgstr "Seus tremores conjurados não conseguem rachar as janelas de Vidro Sangrento."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@ROSE_PALACE_BANQUET_01@AFFINITY_CHOICE_MATERIUM@HEADER"
msgstr "Quebre as janelas de Vidro Sangrento para dispersar a luz maléfica:"

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@ROSE_PALACE_BANQUET_01@AFFINITY_CHOICE_MATERIUM@SUCCESS"
msgstr "O vidro rachado permite que menos raios da Lua Sangrenta passem por ele."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@ROSE_PALACE_BANQUET_01@AFFINITY_CHOICE_ORDER@FAILURE"
msgstr "A luz maléfica se recusa a se curvar à sua piedade."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@ROSE_PALACE_BANQUET_01@AFFINITY_CHOICE_ORDER@HEADER"
msgstr "Tentar dobrar a luz vermelha traiçoeira em uma Aura Sagrada:"

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@ROSE_PALACE_BANQUET_01@AFFINITY_CHOICE_ORDER@SUCCESS"
msgstr "Quando a luz vermelha toca {EventHero}, ela fortalece a santidade de <<o:EventHero>>."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@ROSE_PALACE_BANSHEE_01@AFFINITY_CHOICE_ASTRAL@FAILURE"
msgstr "{EnemyUnit} lança <<o:EnemyUnit>> <<m:EventUnit>> voando através da aparição para atacá-lo."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@ROSE_PALACE_BANSHEE_01@AFFINITY_CHOICE_ASTRAL@HEADER"
msgstr "Conjurar uma ilusão espectral de <<G:husband^n,{EnemyUnit.FirstName}>>, como se ele ainda estivesse vivo:"

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@ROSE_PALACE_BANSHEE_01@AFFINITY_CHOICE_ASTRAL@SUCCESS"
msgstr "{EnemyUnit} e <<o:EnemyUnit>> <<m:EventUnit>> gritam e se encolhem brevemente de desespero."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@ROSE_PALACE_BANSHEE_01@AFFINITY_CHOICE_SHADOW@FAILURE"
msgstr "Suas ilusões não surtem efeito. {EnemyUnit} sibila: \"Já não fui enganado o suficiente?\""

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@ROSE_PALACE_BANSHEE_01@AFFINITY_CHOICE_SHADOW@HEADER"
msgstr "{EventHero} assume a aparência do marido da Rainha Banshee:"

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@ROSE_PALACE_BANSHEE_01@AFFINITY_CHOICE_SHADOW@SUCCESS"
msgstr "\"Você?!\", {EnemyUnit} lamenta. \"Ataque primeiro o meu marido traidor!\""

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@ROSE_PALACE_THORNS_01@AFFINITY_CHOICE_NATURE@FAILURE"
msgstr "Os espinhos resistem, fortalecidos por uma magia mais poderosa que a sua"

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@ROSE_PALACE_THORNS_01@AFFINITY_CHOICE_NATURE@HEADER"
msgstr "Tentar remover os espinhos dos cipós de rosa rastejantes:"

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@ROSE_PALACE_THORNS_01@AFFINITY_CHOICE_NATURE@SUCCESS"
msgstr "Os cipós de rosa perdem seus espinhos e não causam mais dano ao seu exército."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@ROSE_PALACE_THORNS_01@AFFINITY_CHOICE_SHADOW@FAILURE"
msgstr "Os cipós rastejantes resistiram aos seus ventos gélidos."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@ROSE_PALACE_THORNS_01@AFFINITY_CHOICE_SHADOW@HEADER"
msgstr "Fazer murchar os cipós rastejantes que cobrem o pátio."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@ROSE_PALACE_THORNS_01@AFFINITY_CHOICE_SHADOW@SUCCESS"
msgstr "Metade dos cipós no pátio murcha."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@VAMPIRE_RULER_EVENT@BAD_BLOOD@AFFINITY_CHOICE_CHAOS@FAILURE"
msgstr "{EventHeroB} vence o duelo, matando {EventHeroA}."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@VAMPIRE_RULER_EVENT@BAD_BLOOD@AFFINITY_CHOICE_CHAOS@HEADER"
msgstr "Incentivar seus Heróis a resolver a discussão com um duelo de sangue:"

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@VAMPIRE_RULER_EVENT@BAD_BLOOD@AFFINITY_CHOICE_CHAOS@SUCCESS"
msgstr "{EventHeroA} vence o duelo, matando {EventHeroB}."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@VAMPIRE_RULER_EVENT@BAD_BLOOD@AFFINITY_CHOICE_ORDER@FAILURE"
msgstr "Os Heróis rivais continuam a discussão, desrespeitando sua autoridade."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@VAMPIRE_RULER_EVENT@BAD_BLOOD@AFFINITY_CHOICE_ORDER@HEADER"
msgstr "Exercer autoridade sobre seus Heróis aliados:"

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@VAMPIRE_RULER_EVENT@BAD_BLOOD@AFFINITY_CHOICE_ORDER@SUCCESS"
msgstr "{EventHeroA} e {EventHeroB} se desculpam e retornam ao banquete."

