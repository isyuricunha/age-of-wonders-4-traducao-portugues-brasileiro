msgstr "Espinha Supurante"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@DESECRATION@SKILL15@DESCRIPTION"
msgstr "Quando {GLOBAL.PROPERTIES.FESTERING_SPINE.Hyperlink} matar uma unidade, todas as unidades inimigas em um raio de {MIASMIC_SPINE_TARGETER>AREA>Radius} hexes ganham {amount} {GLOBAL.PROPERTIES.POISONED.Hyperlink} e {amount2} {GLOBAL.PROPERTIES.DECAYING.Hyperlink} por {DECAYING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@DESECRATION@SKILL15@MOD_DESCRIPTION"
msgstr "Ao matar, todas as unidades inimigas em um raio de {MIASMIC_SPINE_TARGETER>AREA>Radius} hexes ganham {amount} {GLOBAL.PROPERTIES.POISONED.Hyperlink} e {amount2} {GLOBAL.PROPERTIES.DECAYING.Hyperlink} por {DECAYING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@DESECRATION@SKILL15@NAME"
msgstr "Espinha Miasmática"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@NIGHTLORD@DESCRIPTION"
msgstr "[bulletlist][bullet/]Unidade é imune a {GLOBAL.PROPERTIES.BLINDED.Hyperlink}.[bullet/]Enquanto estiver em Sem Luz, Subterrâneo ou Penumbra, esta unidade tem:[bulletlist][bullet/]+{amount}% de dano.[bullet/]{GLOBAL.PROPERTIES.NATURAL_REGENERATION_GROUP.Hyperlink}.[/bulletlist][/bulletlist]"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@NIGHTLORD@NAME"
msgstr "Senhor da Noite"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@NIGHTSWORN@NAME"
msgstr "Consagrado pela Noite"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@NIGHTSWORN@PASSIVE_DESCRIPTION"
msgstr "No início do combate, conjure um(a) {GLOBAL.UNITS.DOOM_BAT.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@NIGHTSWORN@PASSIVE_NAME"
msgstr "Criatura Noturna"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@REAPER@DESCRIPTION"
msgstr "Ao matar:[bulletlist][bullet/]Os tempos de recarga ativos são reduzidos em {REAPER_COOLDOWN_EFFECT>Amount of Turns} {GLOBAL.TurnConcept}.[bullet/]Ganha +{REAPER_STAT>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>> para a batalha.[/bulletlist][br/]Dispara uma vez por turno."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@REAPER@NAME"
msgstr "Ceifador"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@REAPER@PROP_DESCRIPTION"
msgstr "A unidade tem +{REAPER_STAT>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>> por pilha."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@SHARED_UPKEEP_01@DESCRIPTION"
msgstr "O custo de manutenção aumenta em {VAMPIRE_LORD_UPKEEP>FlatUpkeep} {GLOBAL.GoldConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@SHARED_UPKEEP_01@NAME"
msgstr "Custo de Manutenção Aumentado"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@SPREADING_BLIGHT@ABILITY_DESCRIPTION"
msgstr "Unidade inimiga alvo e {SPREADING_BLIGHT_JUMP_TARGETER>MaxJumps} outras em até {SPREADING_BLIGHT_JUMP_TARGETER>MaxDistance} hexágonos:[bulletlist][bullet/]Sofre dano contínuo.[bullet/]Ganha {amount} {GLOBAL.PROPERTIES.BLOOD_PARASITE.Hyperlink} por {BLOOD_PARASITE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@SPREADING_BLIGHT@DESCRIPTION"
msgstr "{GLOBAL.PROPERTIES.BLOODBLIGHT.Hyperlink} agora se espalha para {SPREADING_BLIGHT_JUMP_TARGETER>MaxJumps} unidades inimigas em até {SPREADING_BLIGHT_JUMP_TARGETER>MaxDistance} hexágonos."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@SPREADING_BLIGHT@NAME"
msgstr "Praga Disseminadora"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@TYRANNY@SKILL01@ABILITY_DESCRIPTION"
msgstr "Unidade inimiga alvo:[bulletlist][bullet/]Ganha {TORMENT_REPEATER>Count} {GLOBAL.PROPERTIES.TORMENT.Hyperlink} até o fim do combate.[bullet/]Ganha {GLOBAL.PROPERTIES.STATUS_VULNERABILITY.Hyperlink} por {STATUS_VULNERABILITY_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Perde {DREAD_MORALE_DAMAGE>Morale Change Absolute} {GLOBAL.UnitMoraleConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@TYRANNY@SKILL01@ABILITY_NAME"
msgstr "Temor"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@TYRANNY@SKILL01@NAME"
msgstr "Terrível"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@TYRANNY@SKILL01@PASSIVE_DESCRIPTION"
msgstr "Ataques causam perda de {TYRANT_MORALE_CHANGE>Morale Change Absolute} {GLOBAL.UnitMoraleConcept.Hyperlink} no alvo. Dobrado para ataques de Tiro Único."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@TYRANNY@SKILL01@PASSIVE_MOD_DESCRIPTION"
msgstr "Inflige perda de {TYRANT_MORALE_CHANGE>Morale Change Absolute} {GLOBAL.UnitMoraleConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@TYRANNY@SKILL01@PASSIVE_NAME"
msgstr "Tirano"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@TYRANNY@SKILL13@ABILITY_DESCRIPTION"
msgstr "Unidades inimigas em um raio de {TORMENTING_MIST_TARGETER>AREA>Radius} hexágonos:[bulletlist][bullet/]Sofrem dano contínuo.[bullet/]Perdem {TORMENTING_MIST_MORALE_LOSS>Morale Change Absolute} {GLOBAL.UnitMoraleConcept.Hyperlink}.[bullet/]Ganham {TORMENT_REPEATER>Count} pilhas de {GLOBAL.PROPERTIES.TORMENT.Hyperlink} até o fim do combate.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@TYRANNY@SKILL13@NAME"
msgstr "Névoa Torturante"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@TYRANNY@SKILL14@ABILITY_DESCRIPTION"
msgstr "No fim do turno, inimigos adjacentes:[bulletlist][bullet/]Sofrem {AURA_OF_TORMENT_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Perdem {TORMENTING_MIST_MORALE_LOSS>Morale Change Absolute} {GLOBAL.UnitMoraleConcept.Hyperlink}.[bullet/]Ganham {TORMENT_REPEATER>Count} {GLOBAL.PROPERTIES.TORMENT.Hyperlink} até o fim do combate.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@TYRANNY@SKILL14@NAME"
msgstr "Aura de Tormento"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@VAMPIRIC_RAGE@DESCRIPTION"
msgstr "O dano aumenta conforme os <<m:{GLOBAL.HitPointConcept.Hyperlink}>> são reduzidos, chegando a {VAMPIRE_RAGE_MULT>ResolvedMultiplier}% em {amount} {GLOBAL.HitPointConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@VAMPIRIC_RAGE@NAME"
msgstr "Fúria Vampírica"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@VIOLENT_EXSANGUINATION@ABILITY_DESCRIPTION"
msgstr "Alvo:[bulletlist][bullet/]Sofre dano que ignora {EXSANGUINATE_DEFENSE_BYPASS>MODIFIERS>ResolvedArmor}% de {GLOBAL.DefenseConcept.Hyperlink} e {GLOBAL.ResistanceConcept.Hyperlink}.[bullet/]Ganha {amount} {GLOBAL.PROPERTIES.BLEEDING.Hyperlink} por {BLEEDING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][bulletlist][br/]Inimigos adjacentes sofrem {VIOLENT_EXSANGUINATION_TARGETER>ResolvedEffectMultiplier}% do dano que ignora {EXSANGUINATE_DEFENSE_BYPASS>MODIFIERS>ResolvedArmor}% de {GLOBAL.DefenseConcept.Hyperlink} e {GLOBAL.ResistanceConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@SPAWNERS@PROCESSION"
msgstr "Procissão Profana"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1142_933@BODY"
msgstr "A lua sangra através de uma ferida aberta, tingindo o céu de carmesim. Os animais fogem para se esconder, os aldeões trancam suas portas, e as criaturas do crepúsculo se alegram sob seu brilho. Pois a noite é vermelha e governada por horrores."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1142_933@BODY_FOOTER"
msgstr "Durante seu eclipse, a Lua Sangrenta fortalece todos os [hyperlink,GLOBAL.VampireLordConcept]Vampiros[/hyperlink] e permite que vagueiem livremente pelo mundo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1142_933@BODY_FOOTER@NO_AI_LORDS"
msgstr "Esta é a Lua de Sangue"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1142_933@BODY_HEADER"
msgstr "O céu escurece em escarlate. A Lua Sangrenta, invocada por {BloodMoonPlayer}, eclipsa a luz do sol."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1142_933@BODY_HEADER@PLAYER_IS_CASTER"
msgstr "O céu escurece em escarlate. A Lua Sangrenta que você invocou eclipsa a luz do sol."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1142_933@BODY_LORE@NO_AI_LORDS"
msgstr "Esta é a Lua de Sangue"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1142_933@BUTTON_0"
msgstr "Prepare-se para a noite vermelha."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1142_933@HAPPENING_HEADER"
msgstr "O céu escurece em escarlate. A Lua Sangrenta eclipsa a luz do sol."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1142_933@TITLE"
msgstr "Lua Sangrenta"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1249@BODY_FOOTER"
msgstr "De qual poço carmesim você saciará sua sede? De quem será o sangue que aplacará seu desejo?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1249@BODY_HEADER"
msgstr "Seus dentes coçam. Lampejos de vermelho turvam sua visão. Seu corpo anseia por sangue. Você não consegue mais reprimir seus desejos profanos."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1249@BODY_LORE"
msgstr "Você sente as batidas dos corações dos mortais ao seu redor. {EventRace.Name}. Animais. Seus tenentes de confiança e seus prisioneiros de guerra. Você tenta afastar o desejo. Afinal, não é digno de um <<PlayerLeader{lord/lady}>> do seu nível. Mas a sede de sangue cresce implacavelmente, até que os rugidos de sua fome abafam todos os outros sons. Sangue. Você precisa beber sangue."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1249@BUTTON_0"
msgstr "\"Ninguém sentirá falta de alguns {EventRace} [souls/] de {EventCity}. [happiness/]\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1249@BUTTON_1"
msgstr "\"{EventHero} é fraco mesmo. O sangue de <<Co:EventHero>> me revigorará.\" [xp/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1249@BUTTON_2"
msgstr "\"Vou me banquetear com o gado.\" [food/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1249@BUTTON_3"
msgstr "Beber o sangue de [souls/] de um morto, apesar de seus efeitos prejudiciais. [hp/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1249@BUTTON_4"
msgstr "Devore seus escravos [thralls/] para saciar a fome."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1249@BUTTON_5"
msgstr "Consuma {EventHeroB}, acorrentado em sua prisão."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1249@TITLE"
msgstr "A Avidez"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1255@BODY_FOOTER"
msgstr "O acampamento do Caçador de Vampiros e sua comitiva <<o:EventStackLeader>> está localizado {EventDirection} de {EventCity}. Derrote <<P:EventStackLeader>>, antes que eles o ataquem."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1255@BODY_HEADER"
msgstr "Algo se agita em seu domínio. Seus súditos sussurram sobre um Caçador de Vampiros que veio para acabar com seu reinado."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1255@BODY_LORE"
msgstr "Ninguém menos que {EventStackLeader}, renomado Matador de <<m:{GLOBAL.ElderVampireLoreConcept.Hyperlink}>>, montou acampamento perto de suas fronteiras. <<Cp:EventStackLeader>> certamente planeja uma incursão para cravar uma estaca em seu coração. Por sorte, o Caçador de Vampiros ainda não localizou seu território envolto em sombras, mas é questão de tempo. <<Co:EventStackLeader>> desorientação passageira lhe oferece uma oportunidade de caçar o Caçador."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1255@BUTTON_0"
msgstr "Persiga o Caçador de Vampiros. Sede por sangue <<o:EventStackLeader>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1255@BUTTON_1"
msgstr "Eu invoco [thralls/] a própria noite [shadowboon/] para engolir o Caçador por inteiro."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1255@BUTTON_2"
msgstr "Envie batedores [unitprod/] para atraí-los para longe de {EventCity}. [happiness/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1255@BUTTON_3"
msgstr "Ignore o Caçador de Vampiros e espere que <<p:EventStackLeader>> nunca encontre seu domínio."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1255@TITLE"
msgstr "{EventStackLeader.FirstName}, o Caçador de Vampiros"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1256@BODY_FOOTER"
msgstr "O {EventItem} que você guarda para si: para usar ou desmantelar. Mas o que fará com {EventStackLeader}?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1256@BODY_HEADER"
msgstr "Seu exército destroçou os guarda-costas do Caçador de Vampiros. {EventStackLeader} jaz derrotado, a um passo <<o:EventStackLeader>> da morte."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1256@BODY_LORE"
msgstr "\"Vamos, então,\" {EventStackLeader.FirstName} gorgoleja pouco antes de <<p:EventStackLeader>> tossir sangue. \"Acabe com minha vida. Não temo a morte.\" Você se diverte com a ideia de matar o Caçador. Mas há usos melhores para <<P:EventStackLeader>>. Suas tropas saqueiam o acampamento e encontram vários itens mágicos usados para matar vampiros. O mais notável é um {EventItem} escondido em um saco de aniagem."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1256@BUTTON_0"
msgstr "Pregue <<G:still living body^n,EventStackLeader>> nos portões de {EventCity}. [happiness/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1256@BUTTON_1"
msgstr "Abraçe [unitHero/] {EventStackLeader}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1256@BUTTON_4"
msgstr "Deixe {EventHero} se alimentar [xp/] de <<P:EventStackLeader>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1256@BUTTON_5"
msgstr "Colha as almas [souls/] do Caçador e de <<o:EventStackLeader>> comitiva."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1256@TITLE"
msgstr "{EventStackLeader.FirstName}, o Caçador de Vampiros: Consequências"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1262@BODY_FOOTER"
msgstr "O {EnemyUnit}, tão cego quanto <<o:EnemyUnit>> morcegos, avança ameaçadoramente em sua direção. <<Co:EnemyUnit>> sedentos por sangue <<m:EventUnit>> o seguem. Como {EventHero.FirstName} procederá?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1262@BODY_FOOTER@HERO_IS_PLAYELEA"
msgstr "O {EnemyUnit}, tão cego quanto <<o:EnemyUnit>> morcegos, avança em sua direção ameaçadoramente. <<Co:EnemyUnit>> sanguinários <<m:EventUnit>> o seguem. Como você vai proceder?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1262@BODY_HEADER"
msgstr "{EventHero} adentra a escuridão do {EventStructure} e é recebido por guinchos agudos que ecoam pelas paredes da caverna."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1262@BODY_HEADER@HERO_IS_PLAYELEA"
msgstr "Você adentra a escuridão do {EventStructure} e é recebido por guinchos agudos que ecoam pelas paredes da caverna."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1262@BODY_LORE"
msgstr "<<m:EventUnit>>, criados por um {EnemyUnit} enlouquecido, são a fonte dos guinchos. Seu {GLOBAL.HeroConcept.Hyperlink} horrorizado testemunha como o {EnemyUnit} oferece os braços de <<o:EnemyUnit>> ao <<m:EventUnit>>, que bebem avidamente o sangue de <<o:EnemyUnit>>. \"Bebam, meus bichinhos\", <<p:EnemyUnit>> grita em agonia. \"Bebam e logo serei um {GLOBAL.ElderVampireLoreConcept.Hyperlink}!\" <<Cp:EnemyUnit>> então percebe a presença de suas tropas e recolhe o braço de <<o:EnemyUnit>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1262@BODY_LORE@HERO_IS_PLAYELEA"
msgstr "<<m:EventUnit>>, criados por um {EnemyUnit} enlouquecido, são a fonte dos guinchos. Você testemunha horrorizado como o {EnemyUnit} oferece os braços de <<o:EnemyUnit>> ao <<m:EventUnit>>, que bebem avidamente o sangue de <<o:EnemyUnit>>. \"Bebam, meus bichinhos\", <<p:EnemyUnit>> grita em agonia. \"Bebam e logo serei um {GLOBAL.ElderVampireLoreConcept.Hyperlink}!\" <<Cp:EnemyUnit>> então percebe sua presença e recolhe o braço de <<o:EnemyUnit>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1262@BUTTON_0"
msgstr "Corte as asas dos morcegos! Ataque!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1262@BUTTON_1"
msgstr "Confunda os morcegos com o barulho das ferramentas dos trabalhadores [structureprod/] vindos de {EventCity}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1262@BUTTON_2"
msgstr "Transforme as paredes da caverna para abafar a acústica."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1262@BUTTON_3"
msgstr "Revele todo o seu poder Vampírico [thralls/] para intimidar o {EnemyUnit}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1262@TITLE"
msgstr "Ecos da Loucura"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1265@BUTTON_4"
msgstr "Fugir da caverna dos morcegos."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1266@BODY_FOOTER"
msgstr "Após copiar as anotações de pesquisa, o que mais {EventHero} vai levar do {EventStructure} desocupado?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1266@BODY_HEADER"
msgstr "Os guinchos ensurdecedores que ecoavam pelo {EventStructure} foram silenciados. Sangue inunda o chão da caverna coberto de guano."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1266@BODY_LORE"
msgstr "Alguns dos filhotes de {EventUnit} foram poupados do massacre. {EventHero.FirstName} logo descobre que os delírios do {EnemyUnit} eram mais profundos do que se pensava. Tomos mofados e rabiscos nas paredes descrevem rituais e processos sobre vampirismo e anatomia de morcegos. Embora a ideia de <<m:EventUnit>> transformar mortais em <<m:{GLOBAL.ElderVampireLoreConcept.Hyperlink}>> continue absurda, os experimentos podem render novos conhecimentos valiosos."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1266@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Alguns dos filhotes de {EventUnit} foram poupados do massacre. Você descobre que os delírios do {EnemyUnit} eram mais profundos do que imaginava. Tomos mofados e rabiscos nas paredes descrevem rituais e processos sobre vampirismo e anatomia de morcegos. Embora a ideia de <<m:EventUnit>> transformar mortais em <<m:{GLOBAL.ElderVampireLoreConcept.Hyperlink}>> continue absurda, os experimentos podem render novos conhecimentos valiosos."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1266@BUTTON_0"
msgstr "Raspe os excrementos de morcego do chão para fertilizar seus campos. [food/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1266@BUTTON_1"
msgstr "Crie um {EventUnit} [unit/] para lutar por você."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1266@BUTTON_2"
msgstr "Monte um {EventMount} [item/] para levá-lo à batalha."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1266@TITLE"
msgstr "Ecos da Loucura: Consequências"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1267@BODY_FOOTER"
msgstr "O <<m:EventUnit>>, liderado por um {EnemyUnit}, não deixa {EventHero.FirstName} se aproximar da bela adormecida. Como <<p:EventHero>> reage?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1267@BODY_FOOTER@HERO_IS_PLAYELEA"
msgstr "O <<m:EventUnit>>, liderado por um {EnemyUnit}, não vai deixar você se aproximar da bela adormecida. Como você responde?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1267@BODY_HEADER"
msgstr "{EventHero} lidera o exército de <<o:EventHero>> para o pátio silencioso de um palácio antigo. O pátio está tomado por roseiras."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1267@BODY_HEADER@HERO_IS_PLAYELEA"
msgstr "Você lidera seu exército para o pátio silencioso de um palácio antigo. O pátio está tomado por roseiras."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1267@BODY_LORE"
msgstr "Na extremidade mais distante do pátio, uma bela <<EventHero{woman/man}>> jaz imóvel em um leito de pedra. Uma roca decomposta está próxima, seu fuso manchado de sangue tão vermelho quanto as rosas que cobrem o pátio. {EventHero.FirstName} nota os restos de <<m:EventUnit>> sob as trepadeiras, espinhos fundidos aos ossos. Quando <<p:EventHero>> avança um passo, os mortos se erguem."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1267@BODY_LORE@HERO_IS_PLAYELEA"
msgstr "Na extremidade mais distante do pátio, uma bela <<EventHero{woman/man}>> jaz imóvel em um leito de pedra. Uma roca decomposta está próxima, seu fuso manchado de sangue tão vermelho quanto as rosas que cobrem o pátio. Você nota os restos de <<m:EventUnit>> sob as trepadeiras, espinhos fundidos aos ossos. Quando você avança um passo, os mortos se erguem."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1267@BUTTON_0"
msgstr "Atacar o {EnemyUnit} para salvar a bela adormecida."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1267@BUTTON_1"
msgstr "Antes de atacar, atear fogo nos arbustos de rosas com magia simples. [mana/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1267@BUTTON_2"
msgstr "Manipular as rosas. Fazer com que percam os espinhos."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1267@BUTTON_3"
msgstr "Invocar ventos gélidos para murchar as trepadeiras espinhosas no {EventStructure}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1267@BUTTON_4"
msgstr "Deixar a beleza dormir e abandonar o {EventStructure}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1267@TITLE"
msgstr "<<EventHero{Rose/Thorne}>> de <<EventHero{Thorns/Roses}>>"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1268@BODY_FOOTER"
msgstr "A maldição foi quebrada. A magia do {EventStructure} enfraquece e as trepadeiras desmoronam. Antes de partir, qual troféu {EventHero} reivindicará?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1268@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "A maldição foi quebrada. A magia do {EventStructure} enfraquece e as trepadeiras desmoronam. Antes de partir, qual troféu você reivindicará?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1268@BODY_HEADER"
msgstr "Com o {EnemyUnit} reduzido a ossos e armadura espinhosos, {EventHero} se aproxima da bela adormecida no leito de pedra."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1268@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Com o {EnemyUnit} reduzido a ossos e armadura espinhosos, você se aproxima da bela adormecida no leito de pedra."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1268@BODY_LORE"
msgstr "<<Cp:EventHero>> se inclina para verificar se a adormecida ainda vive. Quando <<G:breath^n,EventHero>> toca o <<EventHeroB{man's lips/woman's lips}>>, <<p:EventHeroB>> abre <<o:EventHeroB>> olhos e suspira. \"Saudações, Herói\", <<p:EventHeroB>> diz. \"Fui amaldiçoada por uma bruxa, invejosa da minha juventude e habilidade. Sou {EventHeroB}.\" <<Cp:EventHeroB>> olha ao redor. \"Este é o castelo do meu pai? Parece... que dormi por muito tempo.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1268@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Você se inclina para verificar se a adormecida ainda vive. Quando seu hálito toca o <<EventHeroB{man's lips/woman's lips}>>, <<p:EventHeroB>> abre <<o:EventHeroB>> olhos e suspira. \"Saudações, Herói\", <<p:EventHeroB>> diz. \"Fui amaldiçoada por uma bruxa, invejosa da minha juventude e habilidade. Sou {EventHeroB}.\" <<Cp:EventHeroB>> olha ao redor. \"Este é o castelo do meu pai? Parece... que dormi por muito tempo.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1268@BUTTON_0"
msgstr "Recrutar [unitHero/] {EventHeroB}, agora despertada."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1268@BUTTON_2"
msgstr "Deixar que seus estudiosos registrem [knowledge/] <<G:memories^p,EventHeroB>> de outrora."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1268@BUTTON_3"
msgstr "Deixar {EventHeroB.FirstName} partir. Pegar o <<G:{EventItem},EnemyUnit>>. [item/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1268@BUTTON_4"
msgstr "Colha o poder mágico residual [mana/] do(a) {EventStructure}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1268@TITLE"
msgstr "<<EventHero{Rose/Thorne}>> do(a) <<EventHero{Thorns/Roses}>>: Consequências"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1286@BODY_FOOTER"
msgstr "\"Meu marido adúltero morreu antes de receber punição, mas meu desprezo será sofrido.\" <<G:sudden scream^n,{EnemyUnit.FirstName}>> estilhaça a estátua antes de <<p:EnemyUnit>> avançar contra {EventHero.FirstName}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1286@BODY_FOOTER@HERO_IS_PLAYELEA"
msgstr "\"Meu marido adúltero morreu antes de receber punição, mas meu desprezo será sofrido.\" <<G:sudden scream^n,{EnemyUnit.FirstName}>> estilhaça a estátua antes de <<p:EnemyUnit>> avançar contra você."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1286@BODY_HEADER"
msgstr "{EventHero} entra no pátio de um palácio antigo e esquecido. Uma mulher chora diante da estátua de um rei."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1286@BODY_HEADER@HERO_IS_PLAYELEA"
msgstr "Você entra no pátio de um palácio antigo e esquecido. Uma mulher chora diante da estátua de um rei."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1286@BODY_LORE"
msgstr "A estátua está profanada com sangue. Arranhões, como se feitos por unhas, cobrem os olhos do homem. A mulher lamentosa vira a cabeça de <<o:EnemyUnit>> quando <<p:EnemyUnit>> ouve <<G:army^n,EventHero>> se aproximar. \"Veio zombar da Rainha Banshee?\", <<p:EnemyUnit>> sussurra. \"Pobre {EnemyUnit.FirstName}, traída por <<o:EnemyUnit>> marido, aquele Rei dos Trapaceiros.\" <<Cp:EnemyUnit>> mostra <<o:EnemyUnit>> presas enquanto <<m:EventUnit>> aparecem ao redor de <<P:EnemyUnit>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1286@BODY_LORE@HERO_IS_PLAYELEA"
msgstr "A estátua está profanada com sangue. Arranhões, como se feitos por unhas, cobrem os olhos do homem. A mulher que chora convulsivamente vira a cabeça de <<o:EnemyUnit>> quando <<p:EnemyUnit>> ouve seu exército se aproximar. \"Veio para zombar da Rainha das Almas Penadas?\", <<p:EnemyUnit>> sussurra. \"Pobre {EnemyUnit.FirstName}, traída por <<o:EnemyUnit>> marido, aquele Rei dos Trapaceiros.\" <<Cp:EnemyUnit>> mostra <<o:EnemyUnit>> presas enquanto <<m:EventUnit>> aparecem ao redor de <<P:EnemyUnit>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1286@BUTTON_0"
msgstr "\"Hora de silenciar a Rainha Banshee. À carga!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1286@BUTTON_1"
msgstr "Uma recompensa [gold/] para quem me trouxer <<g:head^n,{EnemyUnit.FirstName}>>!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1286@BUTTON_2"
msgstr "Convoque uma aparição de <<G:adulterous spouse^n,{EnemyUnit.FirstName}>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1286@BUTTON_3"
msgstr "Disfarce-se de <<G:dead husband^n,{EnemyUnit.FirstName}>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1286@BUTTON_4"
msgstr "Fuja do(a) {EventStructure} e do(a) <<G:scorn^n,{EnemyUnit.FirstName}>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1286@HERO@FIRSTNAME"
msgstr "Mayv^F"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1286@TITLE"
msgstr "Rainha das Banshees"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1287@BODY_FOOTER"
msgstr "Ansioso(a) para deixar as tragédias sombrias do(a) {EventStructure} para trás, <<P:EventHero>>, qual lembrança {EventHero.FirstName} levará do palácio?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1287@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Ansioso para deixar as tragédias sombrias do(a) {EventStructure} para trás, qual lembrança você levará do palácio?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1287@BODY_HEADER"
msgstr "A Rainha das Banshees jaz aos pés de <<G:feet^p,EventHero>>. Seu coração agora em paz. Seu lamento finalmente cessou."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1287@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "A Rainha das Banshees jaz a seus pés. Seu coração agora em paz. Seu lamento finalmente cessou."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1287@BODY_LORE"
msgstr "Os poucos <<m:EventUnit>> que restam fogem para se esconder nos cantos mais escuros do(a) {EventStructure}. Eles foram atraídos por <<G:scorn^n,{EnemyUnit.FirstName}>> séculos atrás e a enlouqueceram. Quando {EventHero} examina os aposentos opulentos do palácio em busca de tesouros e antiguidades, <<p:EventHero>> descobre os corpos decompostos de servos. Suas gargantas apresentam cortes longos e profundos feitos por garras. Ou unhas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1287@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Os poucos <<m:EventUnit>> que restam se dispersam para se esconder nos cantos mais escuros do {EventStructure}. Eles foram atraídos para <<G:scorn^n,{EnemyUnit.FirstName}>> séculos atrás e a haviam enlouquecido. Ao vasculhar as câmaras opulentas do palácio em busca de tesouros e antiguidades, você descobre os corpos decompostos de serviçais. Suas gargantas apresentam cortes longos e profundos feitos por garras. Ou unhas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1287@BUTTON_0"
msgstr "Restaurar a estátua do marido [influence/] para ser colocada em sua corte."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1287@BUTTON_2"
msgstr "Vincular um dos <<m:EventUnit>> errantes para se juntar a [unit/] seu exército."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1287@BUTTON_3"
msgstr "Extrair as almas dormentes [souls/] que pairam no {EventStructure}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1287@BUTTON_4"
msgstr "Dar à Rainha das Banquis um enterro digno. [goodact/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1287@TITLE"
msgstr "Rainha das Banquis: Consequências"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1288@BODY_FOOTER"
msgstr "Um {EnemyUnit} percebe {EventHero.FirstName} espiando. Todos os Vampiros, voltando à sobriedade em um instante, viram-se para encarar <<P:EventHero>>, prontos para atacar."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1288@BODY_FOOTER@HERO_IS_PLAYELEA"
msgstr "Um {EnemyUnit} percebe você espiando. Todos os Vampiros, voltando à sobriedade em um instante, viram-se para encarar você, prontos para atacar."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1288@BODY_HEADER"
msgstr "Enquanto prepara o exército <<o:EventHero>> para explorar um {EventStructure}, aparentemente abandonado e tomado pela vegetação, {EventHero} ouve música."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1288@BODY_HEADER@HERO_IS_PLAYELEA"
msgstr "Enquanto prepara seu exército para explorar um {EventStructure}, aparentemente abandonado e tomado pela vegetação, você ouve música."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1288@BODY_LORE"
msgstr "Olhando através das altas janelas de vidro vermelho-sangue, {EventHero.FirstName} descobre um covil de Vampiros banquetando no pátio do palácio. Eles enchem taças de vinho com o sangue de mortais amarrados, pendurados de cabeça para baixo e forçados a beber cerveja. Os Vampiros embriagados se deleitam com a luz que entra no pátio através das janelas vermelho-sangue e brindam à Lua Sangrenta e à supremacia de sua espécie."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1288@BODY_LORE@HERO_IS_PLAYELEA"
msgstr "Olhando através das altas janelas de vidro vermelho-sangue, você descobre um covil de Vampiros banquetando no pátio do palácio. Eles enchem taças de vinho com o sangue de mortais amarrados, pendurados de cabeça para baixo e forçados a beber cerveja. Os Vampiros embriagados se deleitam com a luz que entra no pátio através das janelas vermelho-sangue e brindam à Lua Sangrenta e à supremacia de sua espécie."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1288@BUTTON_0"
msgstr "Investir contra o pátio para matar os Vampiros."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1288@BUTTON_1"
msgstr "Usar sua piedade para purificar a luz medonha."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1288@BUTTON_2"
msgstr "Quebrar os vidros vermelho-sangue das janelas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1288@BUTTON_3"
msgstr "Declarar sua posição [thralls/] como {PlayerLeader.Title} para estabelecer domínio."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1288@BUTTON_4"
msgstr "Fugir antes que os Vampiros o confrontem."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1288@TITLE"
msgstr "Banquete da Lua Sangrenta"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1289@BODY_FOOTER"
msgstr "Os <<m:EventUnit>> resgatados estão ansiosos para servi-lo em batalha. Antes de {EventHero} partir, qual será o propósito dos estoques de {EventStructure}?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1289@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Os <<m:EventUnit>> resgatados estão ansiosos para servi-lo em batalha. Antes de partir, qual será o propósito dos estoques de {EventStructure}?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1289@BODY_HEADER"
msgstr "Após esmagar as orgias dos Vampiros, {EventHero} liberta os prisioneiros exauridos de sangue. Entre eles estão <<m:EventUnit>> do seu {EventRace}!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1289@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Após esmagar as orgias dos Vampiros, você liberta os prisioneiros exauridos de sangue. Entre eles estão <<m:EventUnit>> do seu {EventRace}!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1289@BODY_LORE"
msgstr "\"Glória ao nosso {PlayerLeader.Title}\", suspira o {EventUnit} menos exaurido. \"Eu já tinha muito pouco sangue para dar.\" {EventHero} investiga os arredores do palácio. Os Vampiros se alimentavam dos prisioneiros capturados, mas o palácio estava abastecido com as melhores iguarias para engordar seus fornecedores de sangue. Seria um desperdício deixar o banquete se perder."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1289@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "\"Glória a você, ó {PlayerLeader.Title}!\", suspira o {EventUnit} menos exaurido. \"Eu já tinha muito pouco sangue para dar.\" Você investiga os arredores do palácio. Os Vampiros se alimentavam dos prisioneiros capturados, mas o palácio estava abastecido com as melhores iguarias para engordar seus fornecedores de sangue. Seria um desperdício deixar o banquete se perder."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1289@BUTTON_0"
msgstr "Saqueie os suprimentos estocados [food/] para {EventCity}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1289@BUTTON_2"
msgstr "Envie as iguarias palacianas para seus recrutas [unitprod/] em {EventCity}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1289@BUTTON_3"
msgstr "Permita que seu exército vitorioso termine o banquete. [morale/] Eles mereceram."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1289@BUTTON_4"
msgstr "Estude o Ritual da Lua Sangrenta para fortalecer [xp/] {EventHero}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1289@BUTTON_5"
msgstr "Subjugue [thralls/] os outros prisioneiros resgatados. [evilact/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1289@TITLE"
msgstr "Banquete da Lua Sangrenta: Consequências"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1291@BODY_FOOTER"
msgstr "Eles percebem {EventHero} quando um {EventUnit} desgarrado tenta se agarrar à perna de <<o:EventHero>>. Os <<m:EnemyUnit>> enfurecidos se movem imediatamente para atacar."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1291@BODY_FOOTER@HERO_IS_PLAYELEA"
msgstr "Eles percebem você quando um {EventUnit} desgarrado tenta se agarrar à sua perna. Os <<m:EnemyUnit>> enfurecidos se movem imediatamente para atacar."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1291@BODY_HEADER"
msgstr "{EventHero} marcha em direção ao cheiro de sangue quente que emana da bocarra do {EventStructure}, atingido por gritos lancinantes e ruídos estridentes."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1291@BODY_HEADER@HERO_IS_PLAYELEA"
msgstr "Você marcha em direção ao cheiro de sangue quente que emana da bocarra do {EventStructure}, atingido por gritos lancinantes e ruídos estridentes."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1291@BODY_LORE"
msgstr "Ao liderar o exército de <<o:EventHero>> para dentro, {EventHero.FirstName} testemunha como <<m:EnemyUnit>> expõem seus corpos a <<m:EventUnit>>, que vorazmente drenam seu sangue. <<m:EventUnit>> inchados se contorcem no chão da caverna, botando ovos. Formas se movem sob a pele dos <<m:EnemyUnit>>, que entoam cânticos arcanos sobre pureza de sangue e os Preceitos do Sanguinário. Seus gritos não revelam agonia, apenas exaltação."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1291@BODY_LORE@HERO_IS_PLAYELEA"
msgstr "Ao liderar seu exército para dentro, você testemunha como <<m:EnemyUnit>> expõem seus corpos a <<m:EventUnit>>, que vorazmente drenam seu sangue. <<m:EventUnit>> inchados se contorcem no chão da caverna, botando ovos. Formas se movem sob a pele dos <<m:EnemyUnit>>, que entoam cânticos arcanos sobre pureza de sangue e os Preceitos do Sanguinário. Seus gritos não revelam agonia, apenas exaltação."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1291@BUTTON_0"
msgstr "Acelere o sangramento dos <<m:EnemyUnit>> equivocados. Ataque!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1291@BUTTON_1"
msgstr "Infeste [hp/] suas tropas com Parasitas Sanguíneos para compartilhar a dádiva dos cultistas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1291@BUTTON_2"
msgstr "Corrompa sua carne para repelir os vorazes Parasitas Sanguíneos."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1291@BUTTON_3"
msgstr "Invoque os instintos primitivos de todos os <<m:EventUnit>> recém-eclodidos."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1291@BUTTON_4"
msgstr "Recuar. Deixar esses miseráveis <<m:EnemyUnit>> com seus rituais insanos por enquanto."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1291@TITLE"
msgstr "Preceitos do Esfolador"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1292@BODY_FOOTER"
msgstr "O {EnemyUnit} uiva em êxtase e <<o:EnemyUnit>> discípulos se reúnem ao redor de <<P:EnemyUnit>>: \"Ensinem a esses intrusos intrometidos o que é dor!\" Como {EventHero} responderá?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1292@BODY_FOOTER@HERO_IS_PLAYELEA"
msgstr "O {EnemyUnit} uiva em êxtase e <<o:EnemyUnit>> discípulos se reúnem ao redor de <<P:EnemyUnit>>: \"Ensinem a esses intrusos intrometidos o que é dor!\" Como você responderá?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1292@BODY_HEADER"
msgstr "{EventHero} fica inicialmente apreensivo com os gritos vindos do {EventStructure} abaixo de <<P:EventHero>>. Mas as risadas subsequentes despertam a curiosidade de <<o:EventHero>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1292@BODY_HEADER@HERO_IS_PLAYELEA"
msgstr "Você fica inicialmente apreensivo com os gritos vindos do {EventStructure} abaixo de você. Mas as risadas subsequentes despertam sua curiosidade."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1292@BODY_LORE"
msgstr "{EventHero.FirstName} descobre o espetáculo com horror. Um {EnemyUnit} instrui <<o:EnemyUnit>> acólitos nos Ensinamentos da Dor: eles beliscam, esfaqueiam, torcem e cortam uns aos outros. O sangue jorra de seus ferimentos autoinfligidos, e gritos eufóricos saem de suas gargantas. O {EnemyUnit}, enfeitado com respingos de sangue, sorri com deleite ávido quando <<p:EnemyUnit>> avista <<G:army^n,{EventHero.FirstName}>> e sussurra: \"Mais carne disposta?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1292@BODY_LORE@HERO_IS_PLAYELEA"
msgstr "Você descobre o espetáculo com horror. Um {EnemyUnit} instrui <<o:EnemyUnit>> acólitos nos Ensinamentos da Dor: eles beliscam, esfaqueiam, torcem e cortam uns aos outros. O sangue jorra de seus ferimentos autoinfligidos, e gritos eufóricos saem de suas gargantas. O {EnemyUnit}, enfeitado com respingos de sangue, sorri com deleite ávido quando <<p:EnemyUnit>> avista seu exército e sussurra: \"Mais carne disposta?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1292@BUTTON_0"
msgstr "\"Não há dor na morte! Acabem com eles!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1292@BUTTON_1"
msgstr "\"Pensem em coisas felizes, tropas! Distraiam-se do tormento deles!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1292@BUTTON_2"
msgstr "\"Vocês, depravados, deviam ter vergonha de si mesmos!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1292@BUTTON_3"
msgstr "\"Isso parece a minha praia! Contem comigo!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1292@BUTTON_4"
msgstr "Deixar o {EnemyUnit} e <<o:EnemyUnit>> discípulos com seus rituais em privacidade."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1292@TITLE"
msgstr "Ensinamentos do Atormentador"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1293@BODY_FOOTER"
msgstr "<<m:EventUnit>> fogem do {EventStructure}. Há algo que valha a pena resgatar neste lugar abandonado?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1293@BODY_HEADER"
msgstr "Após matar o último dos <<m:EnemyUnit>>, {EventHero} descobre o verdadeiro propósito do {EventStructure}: é um altar para {GLOBAL.UrvatoghLoreConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1293@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Após matar o último dos <<m:EnemyUnit>>, você descobre o verdadeiro propósito do {EventStructure}: é um altar para {GLOBAL.UrvatoghLoreConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1293@BODY_LORE"
msgstr "{EventHero.FirstName} descobre tomos que mencionam o [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] e seus chamados Preceitos do Esfolador. O poder da entidade das trevas havia infectado as mentes dos <<m:EnemyUnit>> com a crença distorcida de que oferecer seu sangue ao <<m:EventUnit>> levaria à grandeza e ao retorno do Primeiro Vampiro. Seus rituais repetidos acumularam energias mágicas imprevisíveis, que {EventHero.FirstName} rapidamente precipita como mana."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1293@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Você descobre tomos que mencionam o [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] e seus chamados Preceitos do Esfolador. O poder da entidade das trevas havia infectado as mentes dos <<m:EnemyUnit>> com a crença distorcida de que oferecer seu sangue ao <<m:EventUnit>> levaria à grandeza e ao retorno do Primeiro Vampiro. Seus rituais repetidos acumularam energias mágicas imprevisíveis, que você rapidamente precipita como mana."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1293@BUTTON_0"
msgstr "Pesquisar [knowledge/] as vantagens da sangria em batalha."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1293@BUTTON_1"
msgstr "Adote um {EventUnit} perdido. [unit/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1293@BUTTON_2"
msgstr "Estudar os princípios do Deus Imortal transforma seu {EventStackUnit} em um {EnemyUnit}. [unit/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1293@BUTTON_3"
msgstr "Triture o <<m:EventUnit>> morto em adubo [food/] para <<G:farms^p,EventCity>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1293@TITLE"
msgstr "Princípios do Sanguinário: Consequências"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1294@BODY_FOOTER"
msgstr "Além do {EventItem}, o que {EventHero} deve extrair do {EventStructure} antes de deixar este local depravado?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1294@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Além do {EventItem}, o que você extrairia do {EventStructure} antes de deixar este local depravado?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1294@BODY_HEADER"
msgstr "{EventHero} matou os ritualistas que ocupavam o {EventStructure}. Um sorriso de deleite está congelado no <<G:lips^p,EnemyUnit>> morto, para <<G:discomfort^n,{EventHero.FirstName}>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1294@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você matou os ritualistas que ocupavam o {EventStructure}. Um sorriso de deleite está congelado no <<G:lips^p,EnemyUnit>> morto, para seu desconforto."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1294@BODY_LORE"
msgstr "A fraca luz do {EventStructure} revela que o chão da caverna agora está completamente inundado com o sangue dos mortos em batalha. Cidadãos de todo o reino se reuniram aqui para adorar a Dor juntos. {EventHero.FirstName} examina o elaborado kit de ferramentas do {EnemyUnit} e encontra <<o:EnemyUnit>> {EventItem}. <<Cp:EventHero>> se pergunta se <<p:EventHero>> poderia realmente entender que convicção movia esses ritualistas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1294@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "A fraca luz do {EventStructure} revela que o chão da caverna agora está completamente inundado com o sangue dos mortos em batalha. Cidadãos de todo o reino se reuniram aqui para adorar a Dor juntos. Você examina o elaborado kit de ferramentas do {EnemyUnit} e encontra <<o:EnemyUnit>> {EventItem}. Você se pergunta se poderia realmente entender que convicção movia esses ritualistas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1294@BUTTON_0"
msgstr "Experimente com o <<G:arts^p,EnemyUnit>> [unitHero/] para aumentar <<G:durability^n,{EventHero.FirstName}>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1294@BUTTON_0@HERO_IS_PLAYERLE"
msgstr "Experimente com o <<G:arts^p,EnemyUnit>> [unitHero/] para aumentar sua durabilidade."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1294@BUTTON_1"
msgstr "[order/] Elimine todas as evidências do <<G:aberrant rituals^p,EnemyUnit>> no {EventStructure}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1294@BUTTON_2"
msgstr "Beba o sangue derramado por toda parte. [xp/] Desperdiçar é perder!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1294@BUTTON_3"
msgstr "Estude o <<G:lessons^p,EnemyUnit>> para fortalecer seus combatentes à distância. [knowledge/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1294@TITLE"
msgstr "Ensinamentos do Atormentador: Consequências"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1295@BODY_FOOTER"
msgstr "Eles param, esperando que você resolva a discussão volátil. A quem você favorecerá? Ao poderoso {EventHeroA.FirstName}? Ou ao ambicioso {EventHeroB.FirstName}?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1295@BODY_HEADER"
msgstr "Seu banquete noturno na corte é interrompido quando as tensões entre {EventHeroA} e {EventHeroB} explodem em uma discussão acalorada."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1295@BODY_LORE"
msgstr "\"Covarde!\" rosna {EventHeroA.FirstName}, o mais forte dos dois, arrastando {EventHeroB.FirstName} pela mesa de jantar, derramando parte do seu melhor sangue engarrafado. O mais recentemente criado, {EventHeroB.FirstName}, estala <<o:EventHeroB>> dentes. \"Seu brutamontes\", <<p:EventHeroB>> ri. \"Soldados não forjam impérios! Tecer feitiços molda reinos poderosos! Todo mundo sabe disso!\" {EventHeroA} saca <<o:EventHeroA>> arma. \"Vamos ver como seu tecer se sai contra minha lâmina, cão!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1295@BUTTON_0"
msgstr "Fique ao lado de {EventHeroB} [morale/]. Seu império deve crescer por meio da magia arcana. [knowledge/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1295@BUTTON_1"
msgstr "\"Esse comportamento não é aceitável! Vocês dois vão me obedecer!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1295@BUTTON_2"
msgstr "Aliar-se a {EventHeroA} [morale/]. Seu império deve crescer pela espada. [unitprod/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1295@BUTTON_3"
msgstr "\"Parem com essa rivalidade infantil. Banqueteiem-se com alguns escravos [thralls/], em vez disso. Saúde!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1295@BUTTON_4"
msgstr "Nenhum deles parece entender de política. Ignore-os."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1295@BUTTON_5"
msgstr "\"Haha, isso vai ser uma ótima luta! Que vença o melhor Vampiro!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1295@TITLE"
msgstr "Inimizade Sangrenta"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1298@BODY_FOOTER"
msgstr "Um {PlayerLeader.Title} como você deveria exibir <<o:PlayerLeader>> {EventMaterial} para mostrar sua opulência. Vai caçar uma nova fonte?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1298@BODY_HEADER"
msgstr "A origem dos Vampiros está ligada à substância lendária comumente chamada de {EventMaterial}, que revigora os Vampiros e gera a sede de sangue."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1298@BODY_LORE"
msgstr "Os <<m:{GLOBAL.ArchvampireLoreConcept.Hyperlink}>>, seus senhores ancestrais, forjavam espadas, anéis e coroas com o vidro para exibir sua riqueza e autoridade. As janelas de seus antigos palácios eram feitas de painéis de {EventMaterial}, transformando os raios brilhantes que as atravessavam em uma luz vermelha revigorante. Os maiores reis tinham covens inteiros de tenentes de confiança equipados com armas magistrais de {EventMaterial}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1298@BUTTON_0"
msgstr "\"O {EventMaterial} será de grande ajuda nas minhas conquistas!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1298@BUTTON_2"
msgstr "\"Exibir {EventMaterial}? Vou erguer uma estátua [structureprod/] de mim mesmo [influence/], em vez disso!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1298@BUTTON_3"
msgstr "\"Não tenho interesse nas loucuras de reis empoeirados.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1298@TITLE"
msgstr "Vidro Carmesim"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@BODY_FOOTER"
msgstr "Adquirir o {EventMaterial} aumenta sua produção de itens mágicos. Os ferreiros podem até terminar uma arma para um {GLOBAL.HeroConcept.Hyperlink} imediatamente!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@BODY_HEADER"
msgstr "Segurando um fragmento de {EventMaterial}, você sente um leve pulsar. Percebe seus efeitos revigorantes. E sua fome crescente."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@BODY_LORE"
msgstr "Seus ferreiros chegam para informar que as forjas estão prontas. Eles estão ansiosos para usar esse material e forjar lâminas cortantes e placas resistentes. Seu <<m:{GLOBAL.HeroConcept.Hyperlink}>> em particular pode se beneficiar dos armamentos aprimorados que o {EventMaterial} pode fornecer. Você dá o sinal, e seus ferreiros sorridentes levam o {EventMaterial} para suas forjas sombrias."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@BUTTON_0"
msgstr "Forjar um(a) {DefenderItem} [item/] para {DefenderHero}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@BUTTON_1"
msgstr "Forjar um(a) {MageItem} [item/] para {MageHero}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@BUTTON_10"
msgstr "Forjar um(a) {WarriorItem} [item/] para {WarriorHero}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@BUTTON_11"
msgstr "Forjar um(a) {DeathItem} [item/] para {DeathHero}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@BUTTON_4"
msgstr "Forje um(a) {RangerItem} [item/] para {RangerHero}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@BUTTON_5"
msgstr "Esqueça os Heróis. Misture isso com os armamentos das minhas tropas comuns. [unitprod/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@BUTTON_6"
msgstr "\"Meus Heróis me abandonaram. Criarei uma arma para mim mesmo.\" [item/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@BUTTON_7"
msgstr "Forje um(a) {RitualistItem} [item/] para {RitualistHero}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@BUTTON_8"
msgstr "Forje um(a) {SpellbladeItem} [item/] para {SpellbladeHero}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@BUTTON_9"
msgstr "Forje um(a) {WarlockItem} [item/] para {WarlockHero}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1299@TITLE"
msgstr "Cálice de Carmesim: Consequências"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1302@BODY_FOOTER"
msgstr "Se quiser saber mais sobre seus antepassados, construa <<m:{GLOBAL.ResearchPostConcept.Hyperlink}>> para estudar a história de sua linhagem mais profundamente."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1302@BODY_HEADER"
msgstr "Como um(a) {GLOBAL.ElderVampireLoreConcept.Hyperlink} {PlayerLeader.Title}, você descende de uma grande linhagem de [hyperlink,GLOBAL.ArchvampireLoreConcept]<<PlayerLeader{Archsires/Archdams}>>[/hyperlink]. Mas qual delas?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1302@BODY_LORE"
msgstr "Havia muitos clãs, covens e casas no passado sem sol do seu povo. Cada um exaltava seus próprios talentos, forças e habilidades. E embora você esteja ansioso para descobrir aonde suas ambições o levarão, conhecer a origem do seu poder pode ser útil. Escribas e estudiosos já trabalham incansavelmente para descobrir magias ocultas, mas precisarão de reforços para estudar sua linhagem."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1302@BUTTON_0"
msgstr "Construa o(a) <<m:{GLOBAL.ResearchPostConcept.Name}>> para fortalecer suas capacidades acadêmicas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1302@BUTTON_2"
msgstr "Você já sabe [knowledge/] o suficiente. O que lhe falta são mãos dispostas [thralls/]."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1302@BUTTON_3"
msgstr "Deixe o passado apodrecer. Seu foco é dominar o futuro."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1302@TITLE"
msgstr "Conhecimento do(a) <<PlayerLeader{Archsires/Archdams}>>"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1303@BODY_FOOTER"
msgstr "Aproveitar essa nova fonte de poder já o fortalece. Como usará essa descoberta para moldar seu domínio?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1303@BODY_HEADER"
msgstr "O último dos <<m:{GLOBAL.ResearchPostConcept.Hyperlink}>> foi erguido e seus escribas já relatam uma descoberta."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1303@BODY_LORE"
msgstr "Eles traduziram com sucesso pergaminhos antigos, escritos em uma língua morta, que guardam os anais de um dos filhos sombrios do(a) [hyperlink,GLOBAL.UrvatoghLoreConcept]Imperador Sanguinário Eterno[/hyperlink]. Comparando esses anais com a árvore genealógica do seu <<PlayerLeader{sire/dam}>>, você pode rastrear sua linhagem até {EventPhrase}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1303@BUTTON_0"
msgstr "Use o conhecimento para atrair recrutas para seu exército. [unitprod/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1303@BUTTON_1"
msgstr "Explore essa descoberta para consolidar seu status de [influence/] da alta classe."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1303@BUTTON_4"
msgstr "Anuncie essa descoberta para reforçar o orgulho [happiness/] do seu {EventRace}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1303@BUTTON_5"
msgstr "Proclame sua linhagem para submeter mais escravos [thralls/] à sua vontade."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1303@BUTTON_6"
msgstr "Aceite este conhecimento como prova da sua devoção [devotion/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1303@TITLE"
msgstr "Conhecimento do <<PlayerLeader{Archsires/Archdams}>>: Consequências"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@BODY_FOOTER"
msgstr "Tantos escravos sobrando! Com certeza você pode dar um uso melhor a eles do que lotar seu [hyperlink,GLOBAL.STRUCTURE_UPGRADES.LORD_CASTLE_FOUNDATION]Castelo Vampírico[/hyperlink], não?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@BODY_HEADER"
msgstr "Escravos se reúnem em sua fortaleza em {EventCity}. Eles se amontoam em multidões, ocupando seus calabouços mais profundos e laboratórios mais letais."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@BODY_LORE"
msgstr "Escravos são um símbolo da sua influência sobre os mais fracos. Desprovidos de vontade e desejos, eles seguem suas ordens sem hesitar ou questionar. Mas, para os Vampiros, escravos não devem ficar ociosos. Os príncipes e consortes vampiros mais astutos enviavam hordas de escravos para executar suas ordens sombrias. Muitos dos seus estão intocados, assim como seu potencial."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@BUTTON_0"
msgstr "Esfolar escravos [thralls/] para entreter [morale/] seu coven."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@BUTTON_1"
msgstr "Gastar escravos [thralls/] para conquistar o favor de lordes menores. [allegiance/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@BUTTON_10"
msgstr "[nature/] Envie escravos [thralls/] para seus açougueiros. [food/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@BUTTON_11"
msgstr "[shadow/] Drene escravos [thralls/] para aprender [knowledge/] mais sobre o Cosmos."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@BUTTON_12"
msgstr "Escravos demais? Isso não existe. Traga-me mais! [thralls/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@BUTTON_2"
msgstr "Exiba seus escravos [thralls/] para demonstrar sua soberania. [influence/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@BUTTON_3"
msgstr "[chaos/] Envie escravos [thralls/] para trabalhar nas forjas [unitprod/] de suas ferrarias."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@BUTTON_4"
msgstr "[arcana/] Gastar escravos [thralls/] para extrair mana [mana/] do Mar Astral."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@BUTTON_5"
msgstr "[order/] Designe escravos [thralls/] como cobradores de impostos [gold/]."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@BUTTON_9"
msgstr "[matter/] Envie escravos [thralls/] para escavar em suas pedreiras. [structureprod/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1167_1304@TITLE"
msgstr "Multidões de Escravos"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1194_1919@BODY_FOOTER"
msgstr "Dizem que a cripta de <<Co:Emperor>> está sob o monte ensanguentado de um coração partido. Encontre-a, pois aquele que a abrir decidirá o destino futuro de toda a raça vampírica."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1194_1919@BODY_HEADER"
msgstr "O [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink], o primeiro de todos os Vampiros, foi há muito tempo sepultado neste reino. <<Cp:Emperor>> aguarda a chegada de quem desencadeará um ajuste de contas sangrento."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1194_1919@BODY_LORE"
msgstr "Odiado ou amado, o [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] é um enigma venerado por cultos secretos do sangue ao longo dos tempos. Eles há muito pregam a chegada de um evento, chamado de 'Ajuste de Contas Sangrento'. Uma época em que {EventRealm} retornará do exílio, e o sangue sagrado do Deus Imortal será derramado ou novamente reinstaurado com glória ainda maior!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1194_1919@BUTTON_0"
msgstr "\"O ajuste de contas está próximo.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1194_1919@TITLE"
msgstr "Cripta do Deus Imortal"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_212@BODY_FOOTER"
msgstr "A figura se desfaz em pó diante dos olhos de {EventHero}, deixando <<P:EventHero>> com um pedido para salvar a aldeia amaldiçoada. O que {EventHero} fará?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_212@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "A figura se desfaz em pó diante dos seus olhos, deixando você com um pedido para salvar a aldeia amaldiçoada. O que você fará?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_212@BODY_HEADER"
msgstr "Pelo canto do olho de <<o:EventHero>>, {EventHero} pressente. Mancando e gravemente ferida, uma figura se aproxima de <<P:EventHero>>, gesticulando por ajuda."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_212@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Pelo canto do seu olho, você pressente. Mancando e gravemente ferida, uma figura se aproxima, gesticulando por ajuda."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_212@BODY_LORE"
msgstr "\"Por favor, não aguentamos mais. Algo terrível está rondando nossa aldeia, levando nosso povo. Consegui chegar aqui para pedir ajuda. Mas meus filhos... minha família, eles ainda estão lá.\"\n"
"\n"
"Os olhos de <<Co:VillageSoulHero>> se fixam repentinamente nos ferimentos letais de <<o:VillageSoulHero>>. Com um olhar de terror, <<p:VillageSoulHero>> diz: \"Mas tenha cuidado... parece que eu não escapei com vida.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_212@BUTTON_0"
msgstr "Queime esse lugar amaldiçoado — a praga não pode se espalhar."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_212@BUTTON_1"
msgstr "Procure por sobreviventes; alguém ainda pode estar vivo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_212@BUTTON_4"
msgstr "Conecte-se à fonte do mal que assombra o lugar."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_212@BUTTON_5"
msgstr "Abandone a alma perdida."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_212@TITLE"
msgstr "A Aldeia Amaldiçoada"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_213@BODY_FOOTER"
msgstr "Isso não acabou. Uma última ação ainda resta."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_213@BODY_HEADER"
msgstr "Após matar a última criatura, a aldeia deveria estar livre. No entanto, algo está errado, este lugar ainda parece assombrado."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_213@BODY_LORE"
msgstr "As casas apodrecem em silêncio, dilapidadas, abandonadas. No entanto, você sentiu: nenhuma sensação de paz veio após matar o último monstro. Uma presença sombria persiste, o que quer que tenha amaldiçoado este lugar ainda está aqui. Você a vê nas sombras da cidade. Suas formas não combinam com as construções."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_213@BUTTON_0"
msgstr "Prepare o combustível. Acenda as tochas. Incendeie esta cidade."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_213@BUTTON_1"
msgstr "Entre na aldeia — alguém ainda deve estar vivo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_213@BUTTON_4"
msgstr "Conecte-se à presença sombria."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_213@TITLE"
msgstr "A Maldição da Aldeia Amaldiçoada"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_214@BODY_FOOTER"
msgstr "O destino deste domínio está em suas mãos. O que você fará?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_214@BODY_HEADER"
msgstr "O fogo purifica a corrupção nesta terra. Chamas envolvem os edifícios, as sombras, a maldição."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_214@BODY_LORE"
msgstr "Você não consegue desviar o olhar do clarão. Não é apenas a vila que queima, as chamas estão consumindo algo mais que paira no ar. Você pode ouvi-lo guinchar e se contorcer. Pode ver o fogo ficar negro ao tocá-lo. Nada escapa do inferno. Mas, uma vez que a terra for queimada, você poderá escolher o que será dela."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_214@BUTTON_0"
msgstr "Proibir [influence/] de se estabelecer aqui. [renown/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_214@BUTTON_1"
msgstr "Transformar a terra [unitprod/] em campos agrícolas [food/]."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_214@BUTTON_4"
msgstr "Reconstruir os alicerces."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_214@BUTTON_5"
msgstr "Opção de Lorde Vampiro ou outra opção de lorde (WIP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_214@TITLE"
msgstr "A Vila Amaldiçoada: Em Chamas"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_215@BODY_FOOTER"
msgstr "O que você fará? (WIP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_215@BODY_HEADER"
msgstr "Uma larva recém-nascida chora, está ferida e perdida. (WIP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_215@BODY_LORE"
msgstr "Ela está comendo os suprimentos da vila. \n"
" \n"
"Uma larva de graça, você a quer? (WIP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_215@BUTTON_0"
msgstr "Acariciar a larva [unit/] (WIP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_215@BUTTON_1"
msgstr "Matar a larva [goodact/] (WIP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_215@BUTTON_4"
msgstr "Estudar a larva [knowledge/] (WIP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_215@TITLE"
msgstr "A Vila Amaldiçoada - Lamentação (WIP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_216@BODY_FOOTER"
msgstr "O destino da família está em suas mãos. O que você fará?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_216@BODY_HEADER"
msgstr "Nenhuma casa abriga uma alma viva. Nenhuma, exceto uma, cuja porta range ao se abrir quando você se aproxima."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_216@BODY_LORE"
msgstr "Os habitantes da casa saem rastejando. Um dos pais e duas crianças, famintos e assustados. Você vê a corrupção correndo em suas veias, eles podem se transformar nos mesmos monstros que os caçaram. O adulto fala com a voz quebrada: \"Pouco nos resta... mas você pode ficar com esta herança, se nos conceder passagem segura.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_216@BUTTON_0"
msgstr "Permitir que se juntem a {EventCity}. [unhappiness/] [goodact/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_216@BUTTON_1"
msgstr "Acabar com eles, você não pode deixar a maldição se espalhar."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_216@BUTTON_4"
msgstr "Libertá-los [mana/] da malefício [goodact/]."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_216@BUTTON_5"
msgstr "Dissipe a energia da sombra para levantar a maldição deles. [goodact/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_216@BUTTON_6"
msgstr "Desfaça a energia do caos para levantar a maldição deles. [goodact/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_216@TITLE"
msgstr "A Aldeia Devastada: Sobreviventes"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_217@BODY_FOOTER"
msgstr "Embora desgastado e esfarrapado, o manto ainda emana um poder ancestral. Você precisará do seu {GLOBAL.ItemForgeConcept.Hyperlink} para consertá-lo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_217@BODY_HEADER"
msgstr "Embora não haja vento, uma capa esfarrapada se agita na superfície. Como se sentisse a presença de {EventHero}, a capa se volta para <<P:EventHero>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_217@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Embora não haja vento, uma capa esfarrapada se agita na terra árida. Como se sentisse sua presença, a capa se volta para você."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_217@BODY_LORE"
msgstr "Do manto emana uma presença espectral, mal segurando o tecido. Uma voz cansada ecoa:\n"
"\"O {EventArtifact}... prende minha linhagem a este mundo. Ele precisa ser consertado... antes que o nome da minha família desapareça.\"\n"
"Com as últimas palavras de <<o:SoulHero>>, o espírito se esvai, deixando o manto cair a seus pés. Como a pele descartada de algo que já não pertence a este mundo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_217@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Do manto emana uma presença espectral, mal segurando o tecido. Uma voz cansada ecoa:\n"
"\"O {EventArtifact}... ainda prende nossa linhagem a este mundo. Ele precisa ser consertado... antes que nos tornemos extintos.\"\n"
"Com as últimas palavras de <<o:SoulHero>>, o espírito se esvai, deixando o manto cair a seus pés. Como a pele descartada de algo que já não pertence a este mundo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_217@BUTTON_0"
msgstr "\"Esta linhagem não será condenada ao esquecimento.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_217@BUTTON_1"
msgstr "\"Este fardo não é meu para carregar.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_217@TITLE"
msgstr "Manto do Ancestral"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_218@BODY_FOOTER"
msgstr "O fantasma anseia pelo {EventArtifact}. O que você responderá?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_218@BODY_HEADER"
msgstr "Você refez o {EventArtifact}. Da capa remendada surge a figura espectral, o contorno de <<o:SoulHero>> agora nítido e sua presença <<o:SoulHero>> revigorada."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_218@BODY_LORE"
msgstr "Com sua própria essência, você reacendeu o {EventArtifact} que foi meu... e de meus ancestrais, é claro. Sua generosidade é... deliciosa, {PlayerLeader}; mas eu odiaria testá-la ainda mais. Permita-me devolver esta vestimenta ao seu devido lugar, para que—em meu nome—novo sangue possa vesti-la mais uma vez.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_218@BUTTON_0"
msgstr "\"Leve-o e lembre-se de quem salvou sua linhagem.\" [influence/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_218@BUTTON_1"
msgstr "\"A vestimenta agora está sintonizada comigo.\" [item/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_218@TITLE"
msgstr "O Dono do Manto"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_219@BODY_FOOTER"
msgstr "O espírito que você ajudou não era uma alma perdida, mas um Vampiro disfarçado de necessitado. O que você decretará?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_219@BODY_HEADER"
msgstr "Pessoas têm desaparecido em seu reino. Os relatórios de seus investigadores permitiram que você encontrasse o culpado, com as mãos de <<o:SoulHero>> ainda ensanguentadas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_219@BODY_LORE"
msgstr "The ghost you once aided now shows <<r:SoulHero>> before you as a Vampire, the {EventArtifact} draped over <<o:SoulHero>> shoulders. \"We meet again, {PlayerLeader}. I owe you an explanation,\" <<p:SoulHero>> says with a grin. \"Vanquished and in desperation, I poured the last of my essence into my cloak, hoping to hide and regain my strength. The very cloak you restored to its full glory.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_219@BUTTON_0"
msgstr "\"Enquanto você me servir, [unitHero/], poderá saciar sua fome [population/] [evilact/].\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_219@BUTTON_1"
msgstr "\"Você não escapará do meu julgamento.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_219@BUTTON_4"
msgstr "\"Saiba qual é o seu lugar, novato. Você servirá a [unitHero/] mim e se banqueteará fora [thralls/] dos meus domínios.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_219@TITLE"
msgstr "Manto do Vampiro"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_221@BODY_FOOTER"
msgstr "A aparição é consumida pela ira e pela dor. {EventHero} responderá ao seu clamor?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_221@BODY_HEADER"
msgstr "{EventHero} ouve um grito de partir o coração; um berro de dor que não tem ferida; um fantasma com uma careta eterna de agonia."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_221@BODY_LORE"
msgstr "Gesticulando entre soluços, ela diz: \"Que tipo de mundo é este onde não há justiça? Que tipo de dor é esta, que nem mesmo a morte pode silenciar? Meus filhos... meus pobres filhos.\"\n"
"Sua dor se transforma em fúria quando ela declara: \"Você não escapará de mim! Posso sentir seu fedor, {FairSoulHero2}.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_221@BUTTON_0"
msgstr "\"Eu reivindicarei sua vingança.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_221@BUTTON_1"
msgstr "Deixar a alma atormentada."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_221@TITLE"
msgstr "Lamento da Dama Justa"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_224@BODY_FOOTER"
msgstr "A ira do espectro não tem limites. Você persistirá em sua busca por vingança?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_224@BODY_HEADER"
msgstr "Após a batalha recente, entre os caídos, a aparição vingativa se ergue sobre sua vítima aterrorizada."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_224@BODY_LORE"
msgstr "\"O que eu lhe fiz\", chora o homem. \"Você pode não ser ele — mas carrega o mesmo fedor do mal. O fedor de alguém capaz de derramar o sangue dos próprios filhos\", responde o espectro. E, após atacar com toda sua fúria, ela deixa o homem sem vida.\n"
"\"Não era ele, devemos continuar procurando\", diz a aparição."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_224@BUTTON_0"
msgstr "\"Continuarei até que você descanse em paz.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_224@BUTTON_1"
msgstr "\"Não posso segui-la, você perdeu o rumo.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_224@BUTTON_4"
msgstr "\"Este massacre precisa cessar.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_224@TITLE"
msgstr "Vingança da Dama Justa"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_240@BODY_FOOTER"
msgstr "A ira do espectro não tem limites. Você persistirá em sua busca por vingança?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_240@BODY_HEADER"
msgstr "Após a batalha recente, entre os caídos, a aparição vingativa se ergue sobre sua vítima aterrorizada."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_240@BODY_LORE"
msgstr "\"Como eu a ofendi\", exclama o homem.\n"
"\"Você pode não ser ele — mas o mesmo fedor do mal o acompanha. O fedor de quem abusou da própria alma que jurou amar\", responde o espectro. E, após atacar com toda sua fúria, ela deixa o homem sem vida. \"Não era ele, devemos continuar procurando\", diz a aparição."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_240@BUTTON_0"
msgstr "\"Continuarei até que você descanse em paz.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_240@BUTTON_1"
msgstr "\"Não posso segui-lo, você perdeu o rumo.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_240@BUTTON_4"
msgstr "\"Esta carnificina precisa cessar.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_240@TITLE"
msgstr "Vingança da Dama Justa"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_241@BODY_FOOTER"
msgstr "A fúria do espectro não tem limites. Você persistirá em sua busca por vingança?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_241@BODY_HEADER"
msgstr "Após a batalha recente, entre os caídos, a aparição vingativa ergue-se sobre sua vítima aterrorizada."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_241@BODY_LORE"
msgstr "\"Não sou ele, nunca a conheci\", grita o homem. \"Talvez não... mas você exala o mesmo fedor do mal. Um fedor que cheira a mentiras, traição e tortura\", responde o espectro. E, após atacá-lo com toda a sua fúria, ela deixa o homem sem vida. \n"
"\"Não era ele, devemos continuar procurando\", diz a aparição."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_241@BUTTON_0"
msgstr "\"Continuarei até que você descanse em paz.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_241@BUTTON_1"
msgstr "\"Não posso segui-la, você perdeu o rumo.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_241@BUTTON_4"
msgstr "\"Você precisa parar com esta carnificina.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_241@TITLE"
msgstr "Vingança da Dama Justa"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_242@BODY_FOOTER"
msgstr "A aparição revelou suas verdadeiras faces. Como você responderá?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_242@BODY_HEADER"
msgstr "O rosto da aparição se contorce e se divide em caretas impossíveis, formando múltiplas faces e revelando sua verdadeira natureza, a de um(a) {EventUnit}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_242@BODY_LORE"
msgstr "Suas vozes clamam: \n"
"\"Somos o sofrimento daqueles que foram abusados. Somos a ira daqueles que morreram em agonia. Somos aqueles que nunca conheceram justiça.\n"
"Eles levaram nossa sanidade. Levaram nossas vidas. Levaram tudo o que tínhamos.\n"
"Eles não levarão nossas lágrimas. Não levarão nossa raiva. E você não levará nossa vingança!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_242@BUTTON_0"
msgstr "\"Você aceitará a morte... de bom grado ou não.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_242@BUTTON_1"
msgstr "\"Talvez nossos objetivos estejam, de fato, alinhados.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_242@BUTTON_4"
msgstr "\"Siga em frente, mas não caminharei ao seu lado.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_242@BUTTON_5"
msgstr "[reputation8/] \"Não consigo compreender sua dor, mas juntos podemos erradicar o mal.\" [unit/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_242@TITLE"
msgstr "Faces da Dama Justa"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_243@TITLE"
msgstr "A Banida da Dama Justa"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_246@BODY_FOOTER"
msgstr "Com os assuntos inacabados de <<o:SoulLoverHero>> resolvidos, o fantasma se dissipa. O que {EventHero} fará?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_246@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Com os <<o:SoulLoverHero>> assuntos inacabados resolvidos, o fantasma se dissipa. O que você fará?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_246@BODY_HEADER"
msgstr "Um fantasma se manifesta diante de {EventHero}. <<Co:SoulLoverHero>> olhar, banhado em lágrimas que nunca caem, implora por ajuda."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_246@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Um fantasma se manifesta diante de você. <<Co:SoulLoverHero>> olhar, banhado em lágrimas que nunca caem, implora por ajuda."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_246@BODY_LORE"
msgstr "\"Sua presença... me chama... Você pode me ajudar. Estou desaparecendo, me desfazendo, não quero partir; não agora que posso estar com meu amado. Passamos uma vida tentando nos encontrar, mas nos reunimos apenas na morte. Por favor, nos una. Una nossas almas em nossa aliança de casamento, para que possamos estar sempre juntos.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_246@BUTTON_0"
msgstr "\"Descanse sua alma agora, honrarei seus desejos.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_246@BUTTON_1"
msgstr "\"Você não sabe o que está pedindo.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_246@TITLE"
msgstr "Morte Nupcial"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_247@BODY_FOOTER"
msgstr "Você tem apenas um momento antes que a alma do consorte se perca para sempre. O que você fará?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_247@BODY_HEADER"
msgstr "À medida que a alma é incorporada ao anel, uma explosão de luz espectral irrompe. Um segundo espírito se manifesta em seu brilho."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_247@BODY_LORE"
msgstr "\"Não! O que você fez?! Onde está <<p:SoulHero>>?!\" Com um olhar para o {EventArtifact}, <<p:SoulLoverHero2>> entende. \"Oh, meu querido, meu doce querido, o que você fez? Você era o último elo que me mantinha aqui. Eu ansiava partir juntos... para onde quer que a jornada... nos leve...\n"
"\n"
"Antes de quase desaparecer, a alma grita: \"Eu não quero... ficar... sozinho... de novo.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_247@BUTTON_0"
msgstr "Quebre o anel, permitindo que ambas as almas partam. [mana/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_247@BUTTON_1"
msgstr "Una ambas as almas ao anel. [item/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_247@BUTTON_4"
msgstr "\"Vocês ficarão juntos — mas não na vida, nem na morte.\" [evilact/] [unit/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_247@TITLE"
msgstr "Até Que a Morte Nos Separe"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_265@BODY_FOOTER"
msgstr "O fantasma que um dia implorou por sua ajuda agora está diante de você — <<o:SoulHero>> alma desfigurada pela vingança. O que você fará?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_265@BODY_HEADER"
msgstr "Desde que você decidiu manter {EventArtifact}, sussurros assombram os cantos, com palavras que você não consegue distinguir."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_265@BODY_LORE"
msgstr "Você nunca está sozinho, mesmo quando o cômodo está vazio. Os murmúrios o assaltam nos momentos de descanso, ficando cada vez mais altos. De repente, uma voz — quebrada, incompleta, mas unida — sussurra com perfeita dicção: \"Não há verdadeiro descanso para os ímpios.\" O espírito aparece diante de você, sua sede de vingança deformou <<o:SoulHero>> alma, transformando-o em um {LivingFogUnit}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_265@BUTTON_0"
msgstr "Enfrente o espírito vingativo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_265@BUTTON_1"
msgstr "\"O que é uma alma perversa para um necromante?\" [souls/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_265@BUTTON_4"
msgstr "\"Em nome de tudo que é sagrado, desapareça, presença imunda!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_265@BUTTON_5"
msgstr "Corte <<o:SoulHero>> conexão com o reino dos vivos."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_265@TITLE"
msgstr "Manto da Vingança"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_356@BODY_FOOTER"
msgstr "Os espólios da escaramuça jazem no campo. O que você fará com eles?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_356@BODY_HEADER"
msgstr "Com a escaramuça encerrada, o campo de batalha emana uma quietude solene. Uma força espectral se manifesta à distância."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_356@BODY_LORE"
msgstr "Ela aparece novamente, o espírito que o guiou até aqui, surgindo ao lado do alvo de sua fúria. Mas algo está errado; ambos parecem confusos.\n"
"\n"
"Sua mente volta aos despojos da batalha. Não sobrou muito após o combate, mas o suficiente para que você possa tirar proveito."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_356@BUTTON_0"
msgstr "Trocar os bens por ouro. [gold/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_356@BUTTON_1"
msgstr "Entregá-los aos seus estudiosos. [knowledge/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_356@BUTTON_4"
msgstr "Destiná-los à sua cidade, {EventCity}. [happiness/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_356@TITLE"
msgstr "Espólios da Escaramuça"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_475@BODY_FOOTER"
msgstr "Você terá que voltar mais tarde."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_475@BODY_HEADER"
msgstr "Uma presença turva o ar, mas sua forma está velada."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_475@BODY_LORE"
msgstr "A alma só se manifestará diante de vontades maiores, como as de heróis e Governantes."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_475@BUTTON_0"
msgstr "Deixe a alma perdida."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_475@TITLE"
msgstr "Alma Perdida"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_515@BODY_FOOTER"
msgstr "[hyperlink,GLOBAL.VampireLordConcept]Vampiros[/hyperlink] não são mais fortalecidos pela Lua Sangrenta e voltam a sofrer as consequências de caminhar sob a luz do dia."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_515@BODY_HEADER"
msgstr "A Lua Sangrenta se esvai, e o medo da luz retorna àqueles que se deleitam na escuridão."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_515@BODY_LORE"
msgstr "O sol nasce por trás da lua que se apaga, restaurando as cores do mundo. Seus raios dão vida aos prados e acendem a esperança em corações cansados. As criaturas do crepúsculo recuam para seus covis, abrigadas pelas sombras que carregam dentro de si."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_515@BUTTON_0"
msgstr "Diga adeus à noite vermelha."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_515@TITLE"
msgstr "Lua Sangrenta: Consequências"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_542@BODY_FOOTER"
msgstr "As vozes gritam para que {EventHero} as siga. Será que <<p:EventHero>> encontrará a origem de seu sofrimento?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_542@BODY_HEADER"
msgstr "{EventHero} consegue sentir a presença delas. Não uma, não duas, mas uma amálgama de fantasmas. Todas falando ao mesmo tempo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_542@BODY_LORE"
msgstr "\"Pare-os. Nos ajude. Nossa carne... nossas almas... consumidas.\" Uma das vozes se desprende da amálgama, \"Eles estão tentando criá-lo. A essência da vida, o elixir, a pedra da imortalidade.\" Então, como uma só, elas falam novamente. \"Uma para transformar chumbo em ouro. Outra para transformar morte em vida. Mas a magia exige um preço, e fomos nós.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_542@BUTTON_0"
msgstr "Siga para onde elas levam."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_542@BUTTON_1"
msgstr "Deixe as almas perdidas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_542@TITLE"
msgstr "Sangue e Alma"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_543@BODY_FOOTER"
msgstr "A energia está diante de você, aguardando a transmutação pela sua vontade."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_543@BODY_HEADER"
msgstr "O último cultista cai. Sangue e carne são consumidos pelo círculo ritualístico, completando o rito."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_543@BODY_LORE"
msgstr "À medida que os caídos são absorvidos pelo sigilo de sangue, uma energia carmesim irrompe. Ondas se espalham para fora, girando em um vórtice violento. A cada volta, ele se contrai, condensando-se em uma anomalia escarlate. Ela o chama. É poder — cru e ilimitado, esperando para ser moldado."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_543@BUTTON_0"
msgstr "Crie um(a) {BloodGlass} na área."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_543@BUTTON_1"
msgstr "Dissipe a energia [mana/]. Liberte as almas [goodact/]."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_543@BUTTON_4"
msgstr "Moldar a energia na essência da vida necessária para forjar a pedra da imortalidade."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_543@TITLE"
msgstr "Sangue e Alma: Consequências"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_549@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "As vozes gritam para que você as siga. Conseguirá descobrir a origem de seu sofrimento?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_549@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Você consegue sentir a presença deles. Não é um, nem dois, mas uma amálgama de fantasmas. Todos falando ao mesmo tempo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_555@BODY_FOOTER"
msgstr "O que assombra esta vila não é uma simples maldição, mas uma doença viva: consciente, voraz, sem limites. O que fará com ela?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_555@BODY_HEADER"
msgstr "Você fecha os olhos e busca a presença que assombra esta vila. Ela é informe, antiga, paciente."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_555@BODY_LORE"
msgstr "A presença é consciente. Flashes de memória tomam conta de você: um homem de vermelho, rituais experimentais de sangue e almas. Uma doença que infecta o sangue, sangue que infecta a alma, alma que molda o corpo em seu reflexo perverso. Então você entende: está vendo pelos olhos daqueles tomados pela enfermidade. A enfermidade é a própria presença."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_555@BUTTON_0"
msgstr "Alimente [mana/] e deixe a presença consumir a vila [evilact/], completando sua metamorfose [unit/]."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_555@BUTTON_1"
msgstr "Permita que a presença o infecte [hp/], concedendo-lhe seu poder [xp/]."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_555@BUTTON_4"
msgstr "Isole a doença [unitprod/]; seus estudiosos aprenderão [knowledge/] com ela e evitarão que se espalhe."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_555@TITLE"
msgstr "Presença Sombria"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_577@BODY_FOOTER@HERO_IS_PALYERLE"
msgstr "A aparição é movida pela ira e pelo sofrimento. Responderá ao seu clamor?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_577@BODY_HEADER@HERO_IS_PALYERLE"
msgstr "Você ouve um grito de partir o coração; um berro de dor sem ferida; um fantasma com uma careta eterna de agonia."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_579@BODY_FOOTER"
msgstr "Suas tropas libertaram esta terra dessa ameaça. Mas um rastro de pegadas espectrais de cascos leva a um local incerto."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_579@BODY_HEADER"
msgstr "A cavalaria morta jaz derrotada, mas seus fantasmas não encontram descanso."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_579@BODY_LORE"
msgstr "As almas dos cavaleiros e cavalos se erguem de seus restos. Impelidos por uma força imperativa, esporeiam seus corcéis e galopam para longe. Apenas o Cavaleiro Decapitado resiste ao impulso, por um instante <<p:RiderSoulHero>> se volta para você. Porém, nesse breve momento, você sente <<o:RiderSoulHero>> desespero, como se <<p:RiderSoulHero>> não comandasse mais suas próprias ações."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_579@BUTTON_0"
msgstr "Rastrear as aparições equinas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_579@BUTTON_1"
msgstr "Deixar as almas dos cavaleiros."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_579@TITLE"
msgstr "Cavalaria Decapitada"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_580@BODY_FOOTER"
msgstr "A cabeça do fantasma voa para longe, carregada por uma entidade desconhecida."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_580@BODY_HEADER"
msgstr "Um fantasma se manifesta diante de {EventHero}. Sem perceber a presença de <<o:EventHero>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_580@BODY_LORE"
msgstr "Como se ainda estivesse vivo, o fantasma passeia, falando com uma figura que não está ali. De repente, <<p:HeadlessSoulHero>> se vira, com medo estampado no rosto de <<o:HeadlessSoulHero>>. Você ouve o trovão espectral de cascos galopando se aproximando — e então, CHUNK! A cabeça de <<Co:HeadlessSoulHero>> é decepada, voando dos ombros de <<o:HeadlessSoulHero>>. Uma força invisível a arrebata do chão e some na distância."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_580@BUTTON_0"
msgstr "Rastreie para onde ela leva e enfrente o decapitador."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_580@BUTTON_1"
msgstr "Deixe a alma perdida."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_580@TITLE"
msgstr "Vítima Decapitada"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_583@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Um fantasma se manifesta diante de você. Sem perceber sua presença."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_600@BODY_FOOTER"
msgstr "A cabeça do cavaleiro sem cabeça está em suas mãos. Será este o fim do dever de <<o:RiderSoulHero>>?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_600@BODY_HEADER"
msgstr "Os mortos retornaram aos seus túmulos. O cemitério repousa em paz mais uma vez."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_600@BODY_LORE"
msgstr "Ao lado da estátua do cavaleiro, há várias cabeças decepadas e ossos espalhados, cercados por runas pintadas com sangue. Os necromantes usaram esses restos para invocar a cavalaria e subjugá-los à sua vontade. Uma cabeça emana uma energia assustadora, uma aura que você reconhece do Cavaleiro Decapitado."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_600@BUTTON_0"
msgstr "\"Seu juramento ainda não foi cumprido.\" [item/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_600@BUTTON_1"
msgstr "As almas perdidas de [souls/] estão sob seu comando."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_600@BUTTON_4"
msgstr "Purifique a maldição de [goodact/] e deixe sua bandeira para trás. [influence/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_600@TITLE"
msgstr "Fim do Meu Dever"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_602@BODY_FOOTER"
msgstr "O cemitério parece esconder grandes perigos."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_602@BODY_HEADER"
msgstr "O relatório do seu batedor é breve: o rastro fantasmagórico termina em um cemitério sombrio."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_602@BODY_LORE"
msgstr "A mensagem está escrita às pressas, com uma letra trêmula: \"Acho que consigo ouvir cânticos dentro do cemitério. Minha montaria se recusa a se aproximar mais da área. Mas, pelo portão, vejo um grupo ao redor de uma grande estátua de um cavaleiro em seu corcel. Os túmulos aqui estão vazios, {PlayerLeader.Title}. Tome cuidado.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_602@BUTTON_0"
msgstr "Prepare suas tropas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_602@BUTTON_5"
msgstr "Deixe as almas perdidas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_602@TITLE"
msgstr "Onde Meus Ossos Descansam"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_623@BODY_FOOTER"
msgstr "O espírito anseia que você erga um grande palácio onde <<p:FluteSoulHero>> possa executar música <<o:FluteSoulHero>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_623@BODY_HEADER"
msgstr "Uma rajada de vento assobia uma melodia. Levado pela mesma brisa, um espírito toma forma."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_623@BODY_LORE"
msgstr "<<Co:FluteSoulHero>> flauta canta com um ritmo dançante, mas cada nota arrasta-se pelo chão com uma tristeza pesada. O espírito nota a presença de {EventHero} e exclama:\n"
"\"Você consegue me ouvir? Você consegue me ouvir! Faz décadas que ninguém conseguia. Você... Você serve a um {EventPlayerType}... Com a magia <<o:LeaderType>>, todo o seu reino <<o:LeaderType>> poderia ouvir minha canção! Por favor, construa um grande palco onde eu possa tocar.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_623@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "<<Co:FluteSoulHero>> flauta canta com um ritmo dançante, mas cada nota arrasta-se pelo chão com uma tristeza pesada. O espírito nota sua presença e exclama:\n"
"\"Você consegue me ouvir? Você consegue me ouvir! Faz décadas que ninguém conseguia. Você... Você é um {EventPlayerType}... Com sua magia, todo o seu reino poderia ouvir minha canção! Por favor, construa um grande palco onde eu possa tocar.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_623@BUTTON_0"
msgstr "Prometa ao espírito um palco <<o:FluteSoulHero>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_623@BUTTON_1"
msgstr "Abandone a alma perdida."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_623@TITLE"
msgstr "Última Sinfonia"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_624@BODY_FOOTER"
msgstr "O bardo espectral agora oferece seus serviços <<o:FluteSoulHero>>. O que você pedirá a <<P:FluteSoulHero>>?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_624@BODY_HEADER"
msgstr "Assim que a estrutura é construída, o espírito ergue <<o:FluteSoulHero>> flauta, e a música inunda os salões."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_624@BODY_LORE"
msgstr "A canção ecoa pelas altas câmaras que levam seu nome, seu emblema, sua própria essência. Amplificada pelo elo do seu império com o [hyperlink,GLOBAL.AstralSeaLoreConcept]Mar Astral[/hyperlink], a melodia se espalha por todos os cantos do seu domínio. Quando a última nota se dissipa, o espírito se volta para você:\n"
"\"Obrigado. Sempre desejei tocar para um reino inteiro. Antes de desaparecer, permita-me conceder algo em troca.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_624@BUTTON_0"
msgstr "\"Deixe sua flauta para que ainda possamos ouvir sua música.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_624@BUTTON_1"
msgstr "Continue tocando, para que as pessoas venham ao meu reino."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_624@BUTTON_4"
msgstr "Cante uma canção em meu nome."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_624@TITLE"
msgstr "Última Sinfonia: Consequências"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_638@BODY_FOOTER"
msgstr "O espírito oferece ajuda de <<o:KingSoulHero>> em seu novo reinado. O que você pedirá a <<P:KingSoulHero>>?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_638@BODY_HEADER"
msgstr "O fantasma do monarca morto aparece ao seu lado enquanto você reconquista {EventHouse}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_638@BODY_LORE"
msgstr "\"O usurpador se foi, e meu domínio agora repousa em suas mãos. Quão doce é a vitória, e quão passageira. Meu tempo aqui acabou, {PlayerLeader.Name}. No entanto, antes de partir, ainda guardo alguma força dentro de mim. Permita-me oferecer um último presente a este reino renascente.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_638@BUTTON_0"
msgstr "Acesso aos arquivos privados de <<o:KingSoulHero>>. [knowledge/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_638@BUTTON_1"
msgstr "Tratados antigos sobre comércio, para serem invocados à sua vontade. [gold/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_638@BUTTON_4"
msgstr "Uma carta de recomendação, endereçada às cidades livres do reino. [allegiance/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_638@TITLE"
msgstr "Derrubado: Consequências"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_639@BODY_FOOTER"
msgstr "Parece que o antigo monarca de {EventHouse} ainda permanece, exigindo vingança contra o usurpador do trono de <<o:KingSoulHero>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_639@BODY_HEADER"
msgstr "Um espírito aparece diante de {EventHero}, balbuciando e se debatendo em fúria. A voz de <<Co:KingSoulHero>> se eleva em um discurso amargo:"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_639@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Um espírito aparece diante de você, balbuciando e se debatendo em fúria. A voz de <<Co:KingSoulHero>> se eleva em um discurso amargo:"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_639@BODY_LORE"
msgstr " \"Maldito seja <<p:CityRuler>>! Que <<o:CityRuler>> esquemas apodreçam e envenenem o próprio sangue de <<o:CityRuler>>, que <<o:CityRuler>> bile queime <<P:CityRuler>> por dentro! <<Cp:CityRuler>> queria me morto, pois <<p:CityRuler>> cobiçava meu reino. E agora estou morto, e meu reino é <<o:CityRuler>>. Saiba disso: quem reina em {EventHouse} não é um Governante legítimo. Não deixarei este mundo até ter minha vingança!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_639@BUTTON_0"
msgstr "\"Executarei sua vingança.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_639@BUTTON_1"
msgstr "Deixar a alma perdida."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_639@BUTTON_5"
msgstr "Ensine-me as melhores técnicas de colheita para estas terras."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_639@TITLE"
msgstr "Derrubado"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BODY_FOOTER"
msgstr "{EventHero} tornou-se o porta-estandarte desta terrível procissão de almas, e elas reivindicam a essência de <<o:EventHero>>. O que <<p:EventHero>> fará?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Você se tornou o porta-estandarte desta terrível procissão de almas, e elas reivindicam sua essência. O que você fará?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BODY_HEADER"
msgstr "O portador condenado entrega o pesado estandarte a {EventHero}. Quando o aperto de <<o:PilgrimHero>> se afrouxa, <<p:PilgrimHero>> desaba sem vida no chão."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "O portador condenado entrega a você o pesado estandarte. Quando o aperto de <<o:PilgrimHero>> se afrouxa, <<p:PilgrimHero>> desaba sem vida no chão."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BODY_LORE"
msgstr "Toda a marcha volta o olhar para {EventHero}. E então <<p:EventHero>> sente — a própria essência de <<o:EventHero>> é sugada para dentro do estandarte, desaparecendo como água em solo árido, sumindo em um vazio insondável. Os mortos precisam dos vivos para liderar sua procissão profana. {EventHero} assumiu o manto do penitente anterior, a maldição é de <<o:EventHero>> agora."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Toda a marcha volta o olhar para você. E então você sente — sua própria essência é sugada para o estandarte, escorrendo como água em solo árido, desaparecendo em um vazio insondável. Os mortos precisam dos vivos para liderar sua procissão profana. Você assumiu o manto do penitente anterior, a maldição é sua agora."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BUTTON_0"
msgstr "Expulsar a procissão profana."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BUTTON_1"
msgstr "{EventHero} é mais forte que a maldição, <<p:EventHero>> pode suportá-la."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "Você é mais forte que a maldição, pode suportá-la."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BUTTON_4"
msgstr "Alimentar o estandarte com mana [mana/] para saciá-lo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BUTTON_5"
msgstr "It will not be <<o:EventHero>> soul [souls/] that they drain."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BUTTON_5@HERO_IS_PLAYERLE"
msgstr "Não será a sua alma [souls/] que eles drenarão."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BUTTON_6"
msgstr "{EventHero} já caminha entre os mortos [unitUndead/], eles não têm direito sobre <<P:EventHero>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@BUTTON_6@HERO_IS_PLAYERLE"
msgstr "Você já caminha entre os mortos [unitUndead/], eles não têm direito sobre você."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_640@TITLE"
msgstr "Fardo Penitencial"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_641@BODY_FOOTER"
msgstr "O condenado implora a {EventHero} que pegue <<o:PilgrimHero>> estandarte e alivie <<o:PilgrimHero>> tormento."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_641@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "O condenado implora que você pegue <<o:PilgrimHero>> estandarte e alivie <<o:PilgrimHero>> tormento."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_641@BODY_HEADER"
msgstr "Uma procissão de espíritos toma forma diante de {EventHero}. No entanto, aquele que a lidera não parece uma alma."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_641@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Uma procissão de espíritos toma forma diante de você. No entanto, aquele que a lidera não parece uma alma."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_641@BODY_LORE"
msgstr "A marcha avança em duas longas filas, cada peregrino espectral segurando uma vela acesa. Todos, exceto um, a figura à frente. Cadavérico e sombrio, <<p:PilgrimHero>> carrega um estandarte pesado, <<o:PilgrimHero>> voz oca chama {EventHero}:\n"
"\"Misericórdia, carregue meu fardo, nem que seja por um momento.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_641@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "A marcha avança em duas longas filas, cada peregrino espectral segurando uma vela acesa. Todos, exceto um, a figura à frente. Cadavérico e sombrio, <<p:PilgrimHero>> carrega um estandarte pesado, <<o:PilgrimHero>> voz oca chama você:\n"
"\"Misericórdia, carregue meu fardo, nem que seja por um momento.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_641@BUTTON_0"
msgstr "Ajude o porta-estandarte."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_641@BUTTON_1"
msgstr "Deixe a alma perdida."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1224_641@TITLE"
msgstr "Procissão Profana"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_223@BODY_FOOTER"
msgstr "\"Se quer meu sangue, então traga-me a Rosa Obsidiana do palácio em ruínas de {Emperor.FirstName} e coloque-a diante dos meus pés. A oferta é feita, pequeno '[hyperlink,GLOBAL.ElderVampireLoreConcept]Ancião[/hyperlink]'. Estarei observando você, tchau-tchau.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_223@BODY_HEADER"
msgstr "\"Tsc-tsc, bichinho\", ronrona {Wife.TitleFirstName}, \"Como é que você pretende entrar no local de descanso final de <<Co:Emperor>> sem nem mesmo meu sangue, hmm?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_223@BODY_HEADER@DONT_KNOW"
msgstr "{Wife.TitleFirstName} curva <<o:Wife>> lábio. \"Ah, que fofo. Como você gostaria se a mamãe lhe desse um pouco de... motivação?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_223@BODY_HEADER@RESIST_WIFE"
msgstr "{Wife.TitleFirstName} explode em uma gargalhada estridente. \"Ah, que delícia! Sua resistência mesquinha é simplesmente... Mhh, irresistível. Preciso de mais disso!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_223@BODY_LORE"
msgstr "\"Sim, decidi, você pode ficar\", sorri {Wife.TitleFirstName}. \"Sem dúvida, você veio aqui para destrancar aquela cripta fedorenta do meu marido podre, {Emperor.FirstName}. Mas para fazer isso, primeiro é preciso meu sangue exaltado, com o qual aquele lugar está completamente selado. No entanto, se você realmente pretende matar aquele bastardo miserável, então talvez eu esteja aberta a fazer um pequeno... acordo...\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_223@BUTTON_0"
msgstr "\"Vou considerar isso.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_223@BUTTON_1"
msgstr "\"Vou querer seu sangue por mexer com os meus sentimentos!\" [influence/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_223@BUTTON_2"
msgstr "\"Não, obrigado.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_223@TITLE"
msgstr "Chave do Meu Coração"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_223@TITLE@DONT_KNOW"
msgstr "{Wife.TitleFirstName} torce <<o:Wife>> lábio. “Ora, não é adorável. E se sua mãe lhe desse um pouco de… motivação?” (WIP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_223@TITLE@RESIST_WIFE"
msgstr "{Wife.TitleFirstName} solta uma gargalhada estridente. “Ah, que delícia! Sua resistência patética é simplesmente… Mhh, irresistível. Preciso de mais!” (WIP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_224@BODY_FOOTER"
msgstr "{Wife.TitleFirstName} <<o:Wife>> olhar maléfico penetra sua visão e toca as cordas do seu coração... \"Diga-me, meu doce, o que o traz ao meu domínio?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_224@BODY_HEADER"
msgstr "Sombras estranhas cegam seus sentidos, então um sussurro cortante invade seu ouvido… “O que é isso que encontro, um '{GLOBAL.ElderVampireLoreConcept.Hyperlink}' desconhecido vagando pelo meu reino? Depois de tanto tempo.”"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_224@BODY_LORE"
msgstr "Das profundezas da escuridão surge a forma aterradora de um(a) {GLOBAL.ArchvampireLoreConcept.Hyperlink}, {Wife.TitleName}, lendário(a) autor(a) do Tomo do Tormento e primeira esposa do [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] <<Cr:Emperor>>. <<Cp:Wife>> o(a) examina com um olhar predatório, então ergue <<o:Wife>> queixo e esboça um sorriso fraco e cheio de presas. De repente, seu peito começa a doer! Parece que <<p:Wife>> está lançando algum tipo de feitiço sobre você."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_224@BUTTON_0"
msgstr "\"Despertar o Deus Imortal.\" [xp/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_224@BUTTON_1"
msgstr "Ficar em silêncio."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_224@BUTTON_2"
msgstr "\"Isso não é da sua conta!\" [relationLvl3/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_224@BUTTON_4"
msgstr "Resistir ao feitiço de <<P:Wife>>. [mana/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_224@BUTTON_5"
msgstr "\"Vim em busca de sangue, o seu em especial!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_224@TITLE"
msgstr "O Grande Arco da Tumba"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_225@BODY_FOOTER"
msgstr "{Wife.TitleFirstName} treme de fúria. “Na verdade, é esse o pedido que faço ao conceder meu sangue para abrir <<Co:Emperor>> cripta fedorenta… Mate <<CP:Emperor>>!”"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_225@BODY_HEADER"
msgstr "\"Maravilhoso!\" guincha {Wife.TitleFirstName}. “Meu Deus, você parece saber o caminho para o coração de um Vampiro com precisão mortal. Talvez tenhamos um interesse em comum, meu doce.”"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_225@BODY_LORE"
msgstr "{Wife.TitleFirstName} examina a Rosa Cruor com uma expressão melancólica e feérica. “Esta rosa sangrenta foi cultivada para <<Co:Emperor>>… <<Co:Emperor>> maldita bruxa…” <<Cp:Wife>> fecha <<P:Wife>> olhos por um momento e aperta a rosa contra <<o:Wife>> peito. Então, <<P:Wife>> olhos se abrem com um olhar faminto por sangue. “Sim. Quero <<P:Emperor>> morta!”"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_225@BUTTON_0"
msgstr "\"Eu cuidarei de tudo.\" [rs_alliance/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_225@BUTTON_1"
msgstr "\"Não, obrigado. Agora me dê seu sangue!”"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_225@BUTTON_2"
msgstr "\"Qualquer coisa, por um preço…\" [thralls/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_225@BUTTON_3"
msgstr "\"O que você quiser. Primeiro, me fortaleça através da dor!\" [xp/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_225@TITLE"
msgstr "Chave do Meu Coração: Obtida"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_240@BODY_FOOTER"
msgstr "Com a cripta <<Po:Emperor>> agora desselada e vazia, a herança da coroa de '{Emperor.Name}' continua sua para ser tomada — título, trono e tudo mais..."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_240@BODY_HEADER"
msgstr "Por sua mão, o [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] foi derrotado. Um ato que é sentido por [hyperlink,GLOBAL.ArchvampireLoreConcept]Arquivampiros[/hyperlink] distantes, por todo o {GLOBAL.AstralSeaLoreConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_240@BODY_LORE"
msgstr "Embora ainda não conheçam seu nome, todos os Arquissires e Arquidamas o conhecerão por seus feitos e o temerão para sempre! Pois, se um vampiro pôde matar o imortal — Sire de todos — o que impede que a Prole se levante contra seus próprios Sires em completa e total anarquia? Assim, por essa crença, nasce uma nova era manchada de sangue para toda a espécie vampírica."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_240@BUTTON_0"
msgstr "\"Sangue por sangue!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_240@TITLE"
msgstr "Cripta do Deus Imortal: Destruída"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_248@BODY_FOOTER"
msgstr "Ninguém mais entrou em {EventRealm} desde então, até agora. Enquanto uma noite destinada amanhece ao uivo distante de lobos, você é deixado a refletir sobre a razão de ter vindo aqui..."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_248@BODY_HEADER"
msgstr "Diante de você se estende um reino sem sol de mito e lenda, mais antigo que as memórias mais remotas até mesmo da maioria dos {GLOBAL.GodirLoreConcept.Hyperlink}. Aqui, a linhagem de sangue puro começou há muito tempo e alcançou seu ápice histórico."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_248@BODY_LORE"
msgstr "Naqueles dias passados, a espécie vampírica governava um domínio faminto por sangue que aterrorizava o {GLOBAL.AstralSeaLoreConcept.Hyperlink}. Naquela época, todos os de sangue puro estavam unidos sob um 'imperador eterno', hoje lembrado apenas como o '[hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink]'. Seja por arrogância ou traição, esse domínio de terror acabou ruindo e foi banido para {GLOBAL.GrexolisLoreConcept.Hyperlink} por razões há muito esquecidas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_248@BUTTON_0"
msgstr "\"A traição destruiu nossa grandeza, mas pretendo restaurá-la mais uma vez!\" [influence/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_248@BUTTON_1"
msgstr "\"A arrogância causou a queda de Drevanya, pretendo terminar o trabalho.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_248@BUTTON_2"
msgstr "\"A noite me convocou aqui, seus filhos [unit/] me mostrarão o caminho.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_248@BUTTON_3"
msgstr "\"Quem se importa com o passado? Eu só tenho sede de sangue!\" [xp/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_248@TITLE"
msgstr "A Noite Cai sobre Rued Drevanya"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_257@BODY_FOOTER"
msgstr "A quem você dá a Rosa Cruor? (TEMP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_257@BODY_HEADER"
msgstr "Você obteve a Rosa de Obsidiana. (TEMP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_257@BODY_LORE"
msgstr "Dê esta rosa a um dos consortes para ganhar sua confiança e ser oferecida uma aliança. (TEMP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_257@BUTTON_0"
msgstr "Dar Rosa à Princesa Consorte Mavelith (TEMP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_257@BUTTON_1"
msgstr "Dar Rosa ao Príncipe Consorte Wtorakh (TEMP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_257@BUTTON_2"
msgstr "Nenhum! Fique com ela para você. (TEMP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_257@TITLE"
msgstr "Rosa Obsidiana Trapaça (TEMP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_264@BODY_FOOTER"
msgstr "{Husband.TitleFirstName} passa os dedos em <<o:Husband>> lábio reluzente enquanto <<p:Husband>> lança secretamente um feitiço em você que faz seu sangue ferver. \"Mostre-me como um verdadeiro Vampiro saúda seu superior.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_264@BODY_HEADER"
msgstr "Um estranho borbulhar e fervilhar invade sua percepção, seguido por um silvo baixo... \"Meu Deus, meu Deus... Que brinquedinho peculiar e anômalo eu aqui avisto?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_264@BODY_LORE"
msgstr "Pelo canto do olho, você vê uma névoa quente e carmesim irromper, da qual emerge uma figura ensanguentada com uma postura distinta: a lendária {GLOBAL.ArchvampireLoreConcept.Hyperlink}, {Husband.TitleFirstName}. \"Após eras de solidão, finalmente sou agraciado com um rosto novo e fresco... e que rosto! Talvez seja 'um dos meus', quem sabe? Não importa, creio que apresentações são necessárias, não concorda? Ou será que sua geração abandonou os modos assim como abandonou {Emperor.Title}?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_264@BUTTON_0"
msgstr "Curvar-se profundamente e com cortesia. [relationLvl3/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_264@BUTTON_1"
msgstr "Simplesmente observar <<P:Husband>> em silêncio."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_264@BUTTON_2"
msgstr "Manter-se ereto e zombar de <<P:Husband>> em desafio! [influence/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_264@BUTTON_3"
msgstr "Oferecer a <<P:Husband>> um sacrifício fresco de sangue. [thralls/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_264@BUTTON_4"
msgstr "\"Ninguém é meu superior. Morra, palhaço!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_264@TITLE"
msgstr "Primeiras Impressões Ferventes"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_268@BODY_FOOTER"
msgstr "\"Se jurar lealdade a mim, seu fabuloso Príncipe, <<p:Husband>>, a Rosa Obsidiana do palácio do [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink], então estaria disposto a compartilhar uma gota do meu sangue mais puro.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_268@BODY_HEADER"
msgstr "\"Encantado, certamente,\" sorri {Husband.Title} com um aceno. \"Ah, juventude... me lembra de mim mesmo nessa idade, contornando a etiqueta e a insolência. Tão ousado, tão descarado.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_268@BODY_HEADER@BOW_LOW"
msgstr "\"Ora, meu caro suplicante,\" reconhece {Husband.TitleFirstName}, enquanto <<p:Husband>> faz uma reverência aristocrática em resposta, \"você agracia seu Príncipe^m com uma classe de cortesia verdadeiramente saborosa.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_268@BODY_HEADER@RESIST_HUSBAND"
msgstr "\"Oh? Você, um [hyperlink,GLOBAL.ElderVampireLoreConcept]Ancião[/hyperlink], ousa me desafiar? Um {GLOBAL.ArchvampireLoreConcept.Hyperlink}?\" ri {Husband.TitleFirstName} com um rosnado bestial. \"Que delicioso, que apetitoso, que... elegante!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_268@BODY_LORE"
msgstr "\"Vamos tratar de negócios, sim?\" começa {Husband.Title}. \"Eu sei tudo sobre você, {Player.Name}. Busca abrir a cripta do nosso sagrado '{Emperor.Title}', não é? Para esse propósito, seria necessário o sangue dos <<Co:Emperor>>Consortes — como o meu. Agora, devido à sua... digamos... notável introdução, confesso que estou começando a desejar — potencialmente — apoiar sua empreitada audaciosa. Em troca, naturalmente, de um pequeno sacrifício.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_268@BUTTON_0"
msgstr "\"Vou considerar isso.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_268@BUTTON_1"
msgstr "\"Vou tomar seu sangue por ferver o meu!\" [influence/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_268@BUTTON_2"
msgstr "\"Não, obrigado.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_268@TITLE"
msgstr "Chave para Meu Desejo"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_269@BODY_FOOTER"
msgstr "<<Cp:Husband>> esmaga lentamente a Rosa Obsidiana na <<o:Husband>> mão e lambe a seiva negra da <<o:Husband>> palma. \"Consegue guardar um segredinho, meu novo aliado?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_269@BODY_HEADER"
msgstr "\"Pra mim? Ah, você não precisava\", finge {Husband.TitleFirstName}. \"Ora, que espécime magnífico e esplêndido; assim como, é claro, a rosa...\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_269@BODY_LORE"
msgstr "Cheirando a rosa, <<p:Husband>> olha para você com um piscar lento. \"Ah, o cheiro do verdadeiro amor\", sorri o(a) {Husband.Title}, \"Que nulo... Bem, vá em frente. Vamos entreter essa magnífica empreitada sua, hã? Imagine se fôssemos despertar o(a) [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink], e então? Louvor e glória? Ah, não, devo avisá-lo(a): meu Sire^m não é conto de fadas, e agradar <<CP:Emperor>> é pura loucura. Não, nosso antigo Criador, esplêndido como <<Cp:Emperor>> possa ser, é uma mente perversamente maligna que não aceita iguais — se é que você me entende...\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_269@BUTTON_0"
msgstr "\"Mas é claro, meu Príncipe.\" [rs_alliance/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_269@BUTTON_1"
msgstr "\"Sem agradecimentos. Agora me dê seu sangue!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_269@BUTTON_2"
msgstr "\"Por um preço [thralls/], é claro.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_269@BUTTON_3"
msgstr "\"Meu Príncipe, o senhor me lisonjeia. Segredos são minha especialidade.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_269@TITLE"
msgstr "Chave do Meu Desejo: Conquistada"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_273@BODY_FOOTER"
msgstr "\"Se você também está atrás de matar esse 'Deus Imortal', então tenho uma proposta\", sugere <<p:Huntress>>, baixando lentamente os braços de <<o:Huntress>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_273@BODY_HEADER"
msgstr "Um fedor mortal e repugnante invade suas narinas. Então, uma figura escura e furtiva aparece à vista. \"Eu reconheço um Vampiro quando vejo um.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_273@BODY_LORE"
msgstr "Mantendo a mão de <<P:Huntress>> perto da arma de <<P:Huntress>>, <<p:Huntress>> ainda assim olha para você com um sorriso sombrio. \"Você não é daqui, não é? Imagino que também esteja buscando desvendar esse tal '[hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink]', não é? Bem, eu também, {Huntress.TitleFirstName}. Meus motivos não exigem explicação, espero.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_273@BUTTON_0"
msgstr "Ouça a proposta dela, por enquanto..."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_273@BUTTON_1"
msgstr "“Eu reconheço um caçador pelo cheiro, prepare-se para morrer!” (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_273@TITLE"
msgstr "Dois Predadores se Cruzando"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_277@BODY_FOOTER"
msgstr "\"Declare guerra a {Wife.FirstName} e {Husband.FirstName}\", anuncia {Huntress.FirstName} sombriamente. \"Assim saberei que posso confiar em você. Matamos os Consortes, pegamos o sangue deles e destruímos [hyperlink,GLOBAL.UrvatoghLoreConcept]Urvatogh[/hyperlink] de uma vez por todas. O que me diz?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_277@BODY_HEADER"
msgstr "{Huntress.FirstName} devolve um sorriso fino e sincero. \"Obrigado por me ouvir. Vou direto ao ponto.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_277@BODY_LORE"
msgstr "\"Minhas pesquisas indicam que a cripta desse '[hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink]' está trancada por um rito de sangue, lançado por <<o:Emperor>> Consortes\", explica {Huntress.FirstName}. \"A maioria deles fugiu do reino antes de ser selado, exceto dois: {Wife.TitleFirstName} e {Husband.TitleFirstName}. Então, eles estão no nosso caminho. Felizmente, eles também se odeiam, então, se quiser abrir essa cripta, é isso que fazemos...\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_277@BUTTON_0"
msgstr "\"Vou pensar no assunto.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_277@BUTTON_1"
msgstr "\"Por que deveria confiar em uma Caçadora de Vampiros? Vá embora!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_277@BUTTON_2"
msgstr "\"Ousa desperdiçar meu tempo, morra!\" [influence/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_277@BUTTON_3"
msgstr "\"Já está feito.\" [influence/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_277@TITLE"
msgstr "Inimigo do Meu Inimigo"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_278@BODY_FOOTER"
msgstr "<<Cp:Huntress>> arma <<o:Huntress>> besta e lança um olhar determinado para você. \"Vamos caçar alguns Vampiros.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_278@BODY_HEADER"
msgstr "\"Bom trabalho\", diz {Huntress.FirstName} com uma careta levemente perplexa."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_278@BODY_HEADER@BADASS"
msgstr "{Huntress.FirstName} olha para você com a boca de <<o:Huntress>> ligeiramente aberta, antes de corrigir <<r:Huntress>> com um sorriso surpreso."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_278@BODY_LORE"
msgstr "\"Vou ser honesto, duvidei que você fosse fazer isso. Afinal, estamos em lados opostos, por assim dizer. Mas agora que você declarou guerra àqueles sugadores de [hyperlink,GLOBAL.ArchvampireLoreConcept]arch[/hyperlink], estou bem ansioso para ver isso até o fim.\" <<Cp:Huntress>> remexe na <<co:Huntress>> bolsa, então olha para você antes de jogar uma bolsa tilintante. \"Não se preocupe, é ouro. Essa é a primeira metade da recompensa, porque agora as coisas vão ficar sérias, muito em breve.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_278@BUTTON_0"
msgstr "\"Diga-me seu plano.\" [rs_defensivepact/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_278@BUTTON_1"
msgstr "\"Obrigado pelo ouro, idiota. Agora morra!\" [evilact/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_278@BUTTON_2"
msgstr "\"Preciso de mais ouro [gold/] do que isso antes de começar a ouvir.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_278@TITLE"
msgstr "Inimigo do Meu Inimigo: Meu Amigo"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_284@BODY_FOOTER"
msgstr "{Wife.TitleFirstName} sorri lascivamente, \"Não há súplicas por misericórdia agora. Vou vê-lo nas minhas masmorras!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_284@BODY_HEADER"
msgstr "Por um breve momento, {Wife.TitleFirstName} franze <<o:Wife>> lábio e lança um olhar desanimado para você."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_284@BODY_LORE"
msgstr "\"Ah...\" <<p:Wife>> suspira levemente, \"Parece que você prefere o caminho da dor, que pena. Bem, pelo menos para você. Eu, por outro lado, vou adorar fazê-lo gritar, meu [hyperlink,GLOBAL.ElderVampireLoreConcept]Ancião[/hyperlink] safadinho.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_284@BUTTON_0"
msgstr "\"Que assim seja.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_284@TITLE"
msgstr "Dor e Traição"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_285@BODY_FOOTER"
msgstr "\"Minha decisão está tomada\", sorri o {Husband.Title} enquanto <<p:Husband>> desvia o olhar. \"Lamente este dia, plebeu. Você logo aprenderá seu lugar.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_285@BODY_HEADER"
msgstr "Por um breve instante, ou até dois, {Husband.TitleFirstName} franze a testa e lança um olhar magoado para você."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_285@BODY_LORE"
msgstr "\"Bem\", começa <<p:Husband>>, com um gesto indiferente de <<o:Husband>> pulso, \"O que mais eu poderia esperar de um rústico como um '{GLOBAL.ElderVampireLoreConcept.Hyperlink}'? Não importa, parece que terei que obter minha adoração 'do jeito usual...' Pela força.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_285@BUTTON_0"
msgstr "\"Que assim seja.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_285@TITLE"
msgstr "Traição Ardente"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_290@BODY_FOOTER"
msgstr "\"É aqui que você entra, meu doce\", sorri {Wife.FirstName}. \"Tome meu sangue, procure o túmulo de <<Co:Emperor>> e mate aquele porco vil para mim! Isso me libertaria da influência <<Co:Emperor>>, finalmente!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_290@BODY_HEADER"
msgstr "\"Ah, eu gosto de você\", observa {Wife.TitleFirstName} com um sorriso cheio de dentes. \"Confio em você até. É por isso que vou revelar a verdade para você, e somente para você.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_290@BODY_LORE"
msgstr "\"Eu fui a primeira vítima de <<Co:Emperor>>, sabe. E quando {Emperor.FirstName} me transformou, <<Cp:Emperor>> lançou uma maldição de controle mental que me impedia de ferir <<CP:Emperor>>. Ah, eu odiava ser uma Vampira, e <<Cp:Emperor>> adorava me fazer sofrer. Eu implorava pela morte, mas <<Cp:Emperor>> me negava toda vez. Então, jurei ver <<CP:Emperor>> destruído! No entanto... Todo esse tempo, eu fui impotente para fazer isso sozinha.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_290@BUTTON_0"
msgstr "\"Vamos matar <<CP:Emperor>> juntos.\" [relationLvl3/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_290@BUTTON_1"
msgstr "\"Qualquer coisa... por um preço...\" [gold/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_290@BUTTON_2"
msgstr "\"Não, obrigado, vou agir sozinho.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_290@TITLE"
msgstr "Sangue por Sangue"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_291@BODY_FOOTER"
msgstr "Ao longe, um lobo uiva para a noite, sinalizando o despontar de uma nova era para toda a espécie Vampira. Com o trono agora vago, cabe a você reivindicá-lo... e compartilhá-lo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_291@BODY_HEADER"
msgstr "Enquanto a poeira da guerra se assenta e uma nova lua surge sobre este reino, {Wife.FirstName} aparece ao seu lado com um sorriso estranhamente sincero. \"Liberdade...\" <<p:Wife>> sussurra."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_291@BODY_LORE"
msgstr "\"Perdi a conta das eras em que esse maldito bastardo me atormentou. Ver <<P:Emperor>> derrotado enche meu frio coração inanimado com... Com...\" De repente, {Wife.FirstName} segura o <<o:Wife>> peito com um suspiro. Então olha para você com um largo sorriso cheio de dentes e olhos curiosos e perolados. \"O quê?\" <<p:Wife>> resmunga, enquanto um leve rubor preenche o <<o:Wife>> rosto. \"Não fique só olhando para a sua Princesa^f assim, faça alguma coisa.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_291@BUTTON_0"
msgstr "Ofereça a mão a {Wife.FirstName}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_291@TITLE"
msgstr "Sangue por Sangue: Lua Nova"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_295@BODY_FOOTER"
msgstr "\"Você, no entanto, pode fazer o que eu não pude\", provoca {Husband.Title}. \"Vá até a cripta de <<Co:Emperor>> e acabe com {Emperor.Title} de uma vez por todas! Então, eu estarei livre!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_295@BODY_HEADER"
msgstr "{Husband.TitleFirstName} suspira. \"Ser um {GLOBAL.ArchvampireLoreConcept.Hyperlink} não é tudo o que parece...\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_295@BODY_LORE"
msgstr "\"Eu estava lá quando nossa espécie 'nasceu', quando as bênçãos de <<Co:Emperor>> foram distribuídas pela primeira vez. E também a maldição de <<Co:Emperor>>... Estar preso ao [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] por toda a eternidade, e seguir a vontade dominante de <<Co:Emperor>> como um fantoche miserável em cordas ensanguentadas. Ugh, {Emperor.FirstName} me obrigou a fazer... coisas 'indizíveis', e eu não tinha vontade de recusar <<CP:Emperor>>. Então sim, admito, eu conspirei com {Wife.FirstName} e os outros para selar <<CP:Emperor>>! Pois, como prole miserável de <<Co:Emperor>>, eu não podia matar <<CP:Emperor>>...\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_295@BUTTON_0"
msgstr "\"Vamos acabar com <<CP:Emperor>> juntos, meu Príncipe.\" [relationLvl3/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_295@BUTTON_1"
msgstr "\"Por um preço, é claro, [gold/].\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_295@BUTTON_2"
msgstr "\"Não, obrigado, vou agir sozinho.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_295@TITLE"
msgstr "Sede de Regicídio"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_296@BODY_FOOTER"
msgstr "Ao longe, um lobo uiva para a noite, sinalizando o despontar de uma nova era para toda a espécie Vampira. Com o trono agora vago, cabe a você reivindicá-lo... e compartilhá-lo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_296@BODY_HEADER"
msgstr "Enquanto a poeira da batalha se assenta, uma nova lua surge sobre Drevanya. E nesse momento, {Husband.TitleFirstName} aparece diante de você com um sorriso diabólico."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_296@BODY_LORE"
msgstr "\"Ah, o sabor da liberdade\", sussurra {Husband.FirstName}. \"É a coisa mais... maravilhosa! E pensar que tenho você, meu querido {Player.FirstName}, para agradecer por isso.\" Um momento de silêncio passa enquanto {Husband.FirstName} apenas olha para você com curiosidade e deleite. \"O trono imperial de Drevanya está terrivelmente 'vazio', você não acha? Que tal nós dois aquecermos um pouco esse trono? Eu conheço o feitiço perfeito.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_296@BUTTON_0"
msgstr "Aceite a oferta de {Husband.FirstName} em <<o:Husband>>."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_296@TITLE"
msgstr "Sede de Regicídio: Saciada"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_300@BODY_FOOTER"
msgstr "{Huntress.FirstName} olha nos seus olhos com determinação furiosa. \"{Emperor.FirstName} precisa ser detido. Vá, guie o caminho até o {EventStructure}, apenas um Vampiro pode entrar nele.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_300@BODY_HEADER"
msgstr "\"Antes de começarmos\", suspira {Huntress.FirstName}, \"acho importante que você saiba contra o que estamos lutando...\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_300@BODY_LORE"
msgstr "\"Você provavelmente não precisa que eu diga o que está em jogo aqui, mas vou deixar claro mesmo assim. {Emperor.FirstName} gerou os [hyperlink,GLOBAL.ArchvampireLoreConcept]Arquivampiros[/hyperlink], como {Wife.FirstName} e {Husband.FirstName}. Estes, por sua vez, geraram a maioria dos [hyperlink,GLOBAL.ElderVampireLoreConcept]Vampiros Anciões[/hyperlink], como você. Se {Emperor.FirstName} retornar, todos os Arquivampiros e sua prole se unirão instantaneamente ao lado de <<o:Emperor>>. Juntos, eles desencadeariam uma frente unida e imparável contra todos os {GLOBAL.WorldsWithinLoreConcept.Hyperlink}!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_300@BUTTON_0"
msgstr "\"Vamos matar esse 'Deus Imortal', juntos.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_300@BUTTON_1"
msgstr "\"Pensando melhor, eu irei sozinho.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_300@BUTTON_2"
msgstr "\"Insensato ignorante. Eu anseio ver todos os Vampiros unidos! Agora morra!\" [evilact/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_300@BUTTON_3"
msgstr "\"Sim, {Huntress.FirstName}, olhe nos meus olhos...\" [evilact/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_300@TITLE"
msgstr "Morte ao Deus Imortal"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_301@BODY_FOOTER"
msgstr "Ao longe, um lobo uiva para a noite, anunciando uma nova era para os Vampiros. Ninguém sabe o que o futuro reserva, e talvez seja melhor assim."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_301@BODY_HEADER"
msgstr "Com o banimento de <<o:Emperor>> completo, a cripta do [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] jaz em ruínas diante de você, e sua missão aqui está cumprida."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_301@BODY_LORE"
msgstr "\"Impressionante\", observa {Huntress.FirstName} com um toque notável de admiração. <<Cp:Huntress>> fica ao seu lado por um tempo e contempla a devastação que você causou. \"Falo sério, você sabe. Impediu que os [hyperlink,GLOBAL.ArchvampireLoreConcept]Arquivampiros[/hyperlink] se reunissem sob um mestre comum mais uma vez. Tenho que admitir, nunca pensei que sentiria qualquer tipo de admiração por um Vampiro na minha vida, mas você... Bem, você mudou tudo.\" {Huntress.FirstName} faz uma pausa e ri. \"Qual é o seu nome, afinal?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_301@BUTTON_0"
msgstr "Partir noite adentro."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_301@TITLE"
msgstr "Herói Anônimo da Noite"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_305@BODY_FOOTER"
msgstr "Prepare-se bem! Explore o {EventStructure} para enfrentar o [hyperlink,GLOBAL.UrvatoghLoreConcept]Progenitor dos Vampiros[/hyperlink] <<Cr:Emperor>> e trazer o tão aguardado Ajuste de Contas Sangrento."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_305@BODY_HEADER"
msgstr "Com o sangue da Consorte em seu poder, você finalmente pode destravar a cripta que o atraiu a este reino desde o início."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_305@BODY_LORE"
msgstr "Toda a espécie Vampira tem origem em uma única fonte: o [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink], o Progenitor^m de todos, <<Cp:Emperor>> que espalhou <<Co:Emperor>> bênção e <<Co:Emperor>> maldição sobre os {GLOBAL.WorldsWithinLoreConcept.Hyperlink} desde o [hyperlink,GLOBAL.ArchvampireLoreConcept]Primeiro Ninhada[/hyperlink], até chegar a você. As terras sem sol, os rios de sangue, a fome e o poder, tudo isso surgiu através do <<Co:Emperor>> poder impressionante e terrível."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_305@BUTTON_0"
msgstr "\"Eu sou o ajuste de contas.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_305@BUTTON_1"
msgstr "... Alimente-se de seus escravos em busca de sangue. (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_305@BUTTON_2"
msgstr "... Alimente-se de seus escravos em busca de glória. (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_305@TITLE"
msgstr "Peregrinação Sepulcral"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_306@BODY_FOOTER"
msgstr "Ao longe, um lobo uiva para a noite. Com o [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] derrotado, o <<o:Emperor>> trono e título permanecem vagos para quem ousar reivindicá-los..."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_306@BODY_HEADER"
msgstr "Sangue por sangue! Por sua mão, {Emperor.Name} foi derrotado e as lendas de sua 'imortalidade' foram provadas falsas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_306@BODY_LORE"
msgstr "Este foi o 'Acerto de Contas Sangrento' que inaugurou uma nova era para toda a espécie Vampírica, livre da herança opressora de seu criador. Suas ações neste reino nivelaram a ordem hierárquica que há muito segmentava os Vampiros, desde tempos imemoriais. Pois se você, um {GLOBAL.ElderVampireLoreConcept.Hyperlink}, pôde derrubar o [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] sem consequências, o que impediria, então, os Vampiros Menores de se rebelarem contra seus próprios Senhores? Não, seu legado certamente inspirará gerações de Vampiros que buscarão seguir seus passos."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_306@BUTTON_0"
msgstr "\"Meu legado será imortal.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_306@TITLE"
msgstr "Um Legado Imortal"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_315@BODY_FOOTER"
msgstr "\"{Player.FirstName}, meu libertador,\" <<p:Emperor>> declara com voz sombria. \"Sonhei com este momento por incontáveis dias. E agora, como uma prece feita carne, você chegou. Seja bem-vindo.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_315@BODY_HEADER"
msgstr "Uma melodia sombria e arrepiante ressoa pelos salões e corredores abandonados pela luz, feitos de pedra escura que compõem a necrópole subterrânea sob o monte ensanguentado."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_315@BODY_LORE"
msgstr "Seguindo a música até sua origem, revela-se uma cidade esquecida dos mortos, banhada em um leitmotiv majestoso, porém melancólico, que lembra um amor há muito perdido. Então, a música cessa abruptamente, e um silêncio tirânico domina completamente o vazio auditivo, tão intenso que cria um abismo rumo ao próprio esquecimento. No entanto, desse vazio emerge uma voz profunda e sonora, impregnada de soberania imemorial e remorso..."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_315@BUTTON_0"
msgstr "\"Revele-se.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_315@BUTTON_1"
msgstr "(OBSOLETO)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_315@BUTTON_2"
msgstr "Lute e desafie o Deus Imortal! (WIP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_315@TITLE"
msgstr "Prelúdio de uma Escuridão sem Lua"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_319@BODY_FOOTER"
msgstr "\"Começamos agora. Destruam todos que restam neste reino, não deixem alma viva, nem morta-viva. Não me importa como será feito, mas batizem a nova Drevanya com o sangue deles!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_319@BODY_HEADER"
msgstr "Por um breve instante, {Emperor.FirstName} fecha <<Co:Emperor>> olhos e derrama uma única lágrima. Então, <<Cp:Emperor>> abre <<Co:Emperor>> olhos com determinação imperial. \"Drevanya ressurgirá.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_319@BODY_LORE"
msgstr "<<Cp:Emperor>> olha para você, e uma escuridão recai sobre <<Co:Emperor>> rosto. \"Desencadearemos um Acerto de Contas Sangrento sobre os {GLOBAL.AstralSeaLoreConcept.Hyperlink} que instilará medo nos corações de todos. Começando com minhas criações falhas, {Wife.FirstName} e {Husband.FirstName}, aqueles sediciosos e ingratos que ainda se intitulam meus Consortes, assim como qualquer um que ousar se opor a nós.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_319@BUTTON_0"
msgstr "\"Que seja feita a tua vontade.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_319@BUTTON_1"
msgstr "\"Veja, já fiz como desejou!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_319@TITLE"
msgstr "Julgamento aos Traidores"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_320@BODY_FOOTER"
msgstr "\"Una-se a mim, {Player.FirstName}, e juntos dominaremos o vasto {GLOBAL.AstralSeaLoreConcept.Hyperlink} com um domínio Vampírico mais grandioso do que antes.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_320@BODY_HEADER"
msgstr "Com todo o reino coberto pelo sangue dos traidores, {Emperor.Name} aparece ao seu lado com um olhar sombrio e pensativo. \"Você se saiu bem.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_320@BODY_LORE"
msgstr "<<Cp:Emperor>> suspira e então se vira para você com um sorriso distante. \"Quando eu era mais jovem,\" começa <<Cp:Emperor>>, \"cometi o erro de saciar o vazio em meu coração não-vivo com o conforto ocioso de Consortes indulgentes. Desde então, tive uma eternidade para reconsiderar meus apetites infantis e compreender que uma parceria é, em última análise, uma união de poder. E neste dia, {Player.FirstName}, você é o Vampiro mais poderoso que já conheci.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_320@BUTTON_0"
msgstr "\"O julgamento é nosso.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_320@TITLE"
msgstr "Um Julgamento Inigualável"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_341@BODY_FOOTER"
msgstr "Sussurros sibilantes emanam do abismo envolto em sombras encontrado abaixo do altar sacrificial... (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_341@BODY_HEADER"
msgstr "Você sacrificou o Juramento do Amante e limpou a cripta, mas não descobriu o Deus Imortal... (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_341@BODY_LORE"
msgstr "O cadáver rígido do Vampiro era um engodo; este não é o Deus Imortal. Onde Ele poderia estar? O coração se foi, a fonte de sangue foi toda sugada para o chão... Mas espere! Ao inspecionar o altar, um contorno peculiar é detectado no estrado. O altar de ébano esculpido pode ser movido para revelar um grande e abissal abismo abaixo. (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_341@BUTTON_0"
msgstr "\"Poderia ser?\"... (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_341@TITLE"
msgstr "Profanando a Cripta Profana (EVENTO DE ESPAÇO RESERVADO)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_377@BODY_FOOTER"
msgstr "Eis o abandonado {EventStructure}. Dizem que seus salões e corredores sombreados guardam segredos indizíveis, além de uma única rosa de esplendor lendário..."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_377@BODY_HEADER"
msgstr "No alto daquela colina ergue-se uma estrutura impressionante, porém sombria. Parece abandonada, embora ainda emane uma aura maligna e poderosa."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_377@BODY_LORE"
msgstr "Os terrenos diante do palácio tomado por roseiras estão marcados por pântanos ensanguentados, exalando o fedor odioso da morte. Seu silencioso pátio interno é protegido por uma vasta muralha de espinheiros afiados como navalhas, vigiada por gárgulas petrificadas que afastam visitantes indesejados... Elas protegem o lugar profano onde incontáveis vidas mortais foram sacrificadas em antigos rituais de sangue e orgias, nos tempos passados em que o [hyperlink,GLOBAL.UrvatoghLoreConcept]Imperador Sanguinário Eterno[/hyperlink] reinava supremo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_377@BUTTON_0"
msgstr "Avançar."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_377@TITLE"
msgstr "Palácio do Príncipe Pálido"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_378@BODY_FOOTER"
msgstr "Os corredores sem fim do labirinto se curvam e serpenteiam com uma vastidão sobrenatural. Todos que entram sempre saem exatamente pelo mesmo caminho que entraram..."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_378@BODY_FOOTER@HAVE_QUEST"
msgstr "Os corredores sem fim do labirinto se curvam e serpenteiam com uma vastidão sobrenatural. Mas uma voz familiar acaricia sua mente e guia seu caminho adiante, em direção a um grupo de protetores esqueléticos e espinhosos..."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_378@BODY_HEADER"
msgstr "No alto de uma saliência rochosa ergue-se o {EventStructure}, cercado por um vasto labirinto vivo de sebes tomadas por roseiras."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_378@BODY_LORE"
msgstr "Este labirinto diabólico exala uma aura antiga e terrível, nascida de uma magia sanguinária das mais vis, há muito tecida pelo [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] <<Cr:Emperor>>. Ao se aproximar, é possível ouvir o fraco e espectral lamento de milhares de vítimas sacrificadas. As almas tributárias ao {Emperor.Title}, nos dias de glória do esplendor de Drevanya... Agora, seu sofrimento sem fim alimenta e distorce a folhagem tomada por roseiras de sua própria prisão."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_378@BUTTON_0"
msgstr "Dissipe [mana/] o feitiço de proteção que guarda o labirinto."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_378@BUTTON_1"
msgstr "Abandone o labirinto, por enquanto."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_378@BUTTON_2"
msgstr "Siga a voz da Princesa Consorte Mavelith. [relationLvl3/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_378@BUTTON_3"
msgstr "Siga a voz do Príncipe Consorte Wtorakh. [relationLvl3/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_378@TITLE"
msgstr "Atordoados e Encharcados de Sangue"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_380@BODY_FOOTER"
msgstr "A Rosa Obsidiana brilha como uma joia. É uma planta viva e imortal que exala uma aura poderosa de magia das sombras, e agora ela é sua."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_380@BODY_HEADER"
msgstr "Após derrotar o exército de guardas rosas mortos-vivos, o Palácio da Rosa do [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] está livre para ser explorado."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_380@BODY_LORE"
msgstr "Ao som de um trovão, as grandes portas decoradas com o brasão de uma rosa se abrem. Além delas, há um palácio tomado por rosas, repleto de inúmeros salões de baile e salas de estar abandonados, todos cobertos por respingos secos de sangue. Subindo as escadas empoeiradas, você chega à torre mais alta. Suas portas se abrem para revelar uma estufa curiosa, cheia de rosas murchas. Mas em seu centro cresce uma única Rosa Obsidiana, tão magnífica que desafia a compreensão!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_380@BUTTON_0"
msgstr "Entregue a Rosa Obsidiana à Princesa Consorte Mavelith. [relationLvl3/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_380@BUTTON_1"
msgstr "Entregue a Rosa Obsidiana ao Príncipe Consorte Wtorakh. [relationLvl3/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_380@BUTTON_2"
msgstr "Fique com a rosa para si e absorva seu poder! [mana/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_380@BUTTON_2@HAVE_QUEST"
msgstr "Fique com ela para si e absorva seu poder. [mana/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_380@BUTTON_3"
msgstr "Reivindique esta dádiva das sombras e examine seu poder. [shadowboon/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_380@BUTTON_4"
msgstr "Obtenha esta maravilha da natureza e use-a para aprimorar suas plantações! [natureboon/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_380@TITLE"
msgstr "A Rosa Obsidiana"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_410@BODY_FOOTER"
msgstr "Um êxtase insano toma conta dos cultistas, que avançam contra você com facas em punho. Ainda mais figuras emergem das sombras da câmara..."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_410@BODY_FOOTER@NO_KEY"
msgstr "A última linha diz: \"Em Seu corpo, eternamente imortal, mas em nossa memória, doravante não vivido. Que Ele descanse em miséria.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_410@BODY_HEADER"
msgstr "Como os movimentos de um sonho, as grandes portas de pedra que selavam esta cripta por eras incontáveis se abrem diante de você sem som ou vibração; desaparecendo, como se nunca tivessem existido..."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_410@BODY_HEADER@NO_KEY"
msgstr "Diante de você está um grandioso memorial abandonado, uma fonte de sangue. Ele é construído ao redor de uma enorme laje de pedra ricamente inscrita, que diz:"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_410@BODY_LORE"
msgstr "Ao adentrar a escuridão, você é tomado pelo cheiro de rocha, sangue e cera de vela. Em pouco tempo, uma câmara estreita e iluminada por velas se revela, cercada por uma hoste de figuras encapuzadas murmurando ao redor de uma estátua tomada por rosas do [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink]. Com sua chegada, os cultistas erguem os olhos, seus olhares brilhando de êxtase. \"O ajuste de contas\", um cultista gargalha. \"A hora do Ajuste de Contas Sangrento chegou, finalmente! Irmãos e irmãs, rejubilem! Pelo Deus Imortal, que nosso sangue seja derramado em celebração — derramem-no agora!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_410@BODY_LORE@NO_KEY"
msgstr "\"Dois amantes dilacerados pelo amor derramaram sangue e conceberam uma maldição; uma terra sem sol banhada em rios de vermelho. Um coração partido conjurou novos amantes forçados; para nunca serem amores verdadeiros, mas servos em vez disso. Treze consortes negligenciados, juraram seu sangue aqui para punir; e assim selaram seu Sire em perdição e pavor.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_410@BUTTON_0"
msgstr "\"Recuar!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_410@BUTTON_0@NO_KEY"
msgstr "Volte mais tarde."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_410@BUTTON_1"
msgstr "Derrame seu sangue!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_410@TITLE"
msgstr "Arrebatados para o Juízo Final"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_410@TITLE@NO_KEY"
msgstr "Sem Amor e Imortal"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_411@BODY_FOOTER"
msgstr "Mover a estátua revela um poço oculto de sangue, levando ainda mais fundo às entranhas da terra. E das profundezas de sua escuridão eterna ecoa um som assombroso e tênue — de música."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_411@BODY_HEADER"
msgstr "Vermelho! Vermelho! Vermelho! Após a batalha, toda a câmara está encharcada de sangue e corpos cobrindo tudo tão completamente de carmesim que quase desperta seu frenesi vampírico a ponto do delírio."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_411@BODY_LORE"
msgstr "Mas enquanto você está ali, com sangue até os tornozelos, ouvindo o som da sua própria respiração, uma súbita clareza invade sua consciência: se esta cripta foi selada, como esses cultistas mortais entraram? E onde está <<Cp:Emperor>>? Onde diabos está o [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink]? Você aguça seus sentidos e vasculha cada canto desta cripta notavelmente pequena, mas não encontra nada. Porém, após um tempo, percebe como todo o sangue na sala escorre em direção à base da estátua..."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_411@BUTTON_0"
msgstr "Siga a música até sua origem."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_411@TITLE"
msgstr "Rapsódia de um Juízo Final"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_423@BODY_FOOTER"
msgstr "'{Husband.TitleFirstName}' e '{Wife.TitleFirstName}'. Certamente eles devem conhecer o nome <<Co:Emperor>> profano, talvez se você simplesmente perguntar a eles? (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_423@BODY_HEADER"
msgstr "Seguir o chamado misterioso levou você a um monte escuro e sagrado, onde se diz que toda a espécie vampírica teve origem. (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_423@BODY_LORE"
msgstr "Em sua sombra ao sul ergue-se um monumento, banhado em sangue. Ele lista os nomes daqueles que testemunharam o nascimento do Sire Nightborne em sua forma vampírica ascendida de <<Co:Emperor>>. No topo estão os nomes dos <<Co:Emperor>> consortes profanos, a maioria violentamente riscada, restando apenas dois... (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_423@BUTTON_0"
msgstr "Posso considerar isso. (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_423@TITLE"
msgstr "Estela Ensanguentada (WIP)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_427@BODY_FOOTER"
msgstr "Para desbloquear a cripta, é preciso procurar {Wife.TitleFirstName} e {Husband.TitleFirstName}, e obter seu sangue — de um jeito ou de outro."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_427@BODY_HEADER"
msgstr "Então, a cripta do [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] está selada com o sangue dos <<Co:Emperor>> Consortes, e apenas o sangue deles pode desfazer o selo."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_427@BODY_LORE"
msgstr "Pouco se sabe sobre o [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] além de mitos e lendas de cultos. Mas entre os [hyperlink,GLOBAL.ElderVampireLoreConcept]Vampiros Anciões[/hyperlink] é sabido que o Deus Imortal criou a Primeira Ninhada, os temidos [hyperlink,GLOBAL.ArchvampireLoreConcept]Arquivampiros[/hyperlink]. Desta ninhada, <<Cp:Emperor>> selecionou um harém de Consortes que <<Cp:Emperor>> vinculou à <<Co:Emperor>> vontade indomável. Parece, no entanto, que conspiraram para trancar seu Deus Imortal nesta cripta. Como e por quê, bem, apenas as Consortes restantes poderiam contar."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_427@BUTTON_0"
msgstr "\"Eu sei o que fazer.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_427@TITLE"
msgstr "Caça ao Cônjuge"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_428@BODY_FOOTER"
msgstr "Ou atenda aos desejos dos Consortes em sua busca, ou os derrote em batalha e colete seu sangue de seus cadáveres. A escolha é sua..."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_428@BODY_HEADER"
msgstr "Você encontrou tanto {Wife.TitleFirstName} quanto {Husband.TitleFirstName}, e ambos reconheceram que selaram o {EventStructure} com seu sangue."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_428@BODY_LORE"
msgstr "Ambos pareciam ansiosos para obter esta Rosa de Obsidiana, os motivos permanecem obscuros... Independentemente disso, uma escolha decisiva agora pesa em sua consciência: você atenderá ao desafio deles e esperará que cumpram sua palavra, ou derramará seu sangue à força?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_428@BUTTON_0"
msgstr "Obtenha a Rosa de Obsidiana, ao menos por enquanto."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_428@TITLE"
msgstr "Caça ao Cônjuge: Encontrou Sua Alma Gêmea"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_429@BUTTON_1"
msgstr "Siga o caminho sangrento da guerra!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_429@BUTTON_2"
msgstr "Continue e torture um Escravo [thralls/] ou dois para conquistar {Wife.TitleFirstName}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_429@BUTTON_3"
msgstr "Continue e sacrifique um Escravo [thralls/] ou dois para conquistar {Husband.TitleFirstName}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_430@BUTTON_1"
msgstr "\"Talvez eu deva permanecer vigilante...\" (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_430@BUTTON_2"
msgstr "\"Não me importo de qualquer forma; só desejo sangue!\" (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_453@BODY_FOOTER"
msgstr "O que um dia foi selado com sangue, em breve será desfeito com ele. Derrote {Wife.TitleFirstName} ou {Husband.TitleFirstName} para obter seu sangue."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_453@BODY_HEADER"
msgstr "É natural que Vampiros rivalizem entre seus pares. Da vida à não-vida, de Prole a Sire^m, de par a rival, de [hyperlink,GLOBAL.ElderVampireLoreConcept]Ancião[/hyperlink] a {GLOBAL.ArchvampireLoreConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_453@BODY_LORE"
msgstr "Sim. Inevitavelmente, todos os Vampiros geram novas proles. O 'Sire^m' ou 'Dam^f' é, a partir de então, o guardião e senhor de sua progênie, muitas vezes controlando cada ação deles. Isso é, até que a prole se torne poderosa o suficiente para rivalizar com seu criador... Esse jogo implacável de dominação dita o ciclo de vida de praticamente todos os Vampiros: ou se domina, ou é dominado. Então, o que será?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_453@BUTTON_0"
msgstr "\"O sangue deles será meu.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_453@TITLE"
msgstr "Subindo na Cadeia Alimentar"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_456@BODY_FOOTER"
msgstr "Você obteve o sangue exaltado de um Consorte {GLOBAL.ArchvampireLoreConcept.Hyperlink}. Embora... Você realmente precisa de tudo isso para abrir o {EventStructure}?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_456@BODY_HEADER"
msgstr "{ConsortKilled} foi derrotado! Agora, a terra outrora pálida e sem sol está manchada com o sangue puro de um {GLOBAL.ArchvampireLoreConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_456@BODY_LORE"
msgstr "Ao contrário do {GLOBAL.ElderVampireLoreConcept.Hyperlink}, apenas uma ninhada seleta e limitada de [hyperlink,GLOBAL.ArchvampireLoreConcept]Arquivampiros[/hyperlink] foi criada pelo [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] — quanto mais transformada em <<Co:Emperor>>Consorte. Agora, por suas presas, existe um a menos no {EventRealm}reino!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_456@BUTTON_0"
msgstr "Contenha sua fome [goodact/], você é maior que isso. [influence/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_456@TITLE"
msgstr "Subindo na Cadeia Alimentar: Quase no Topo"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_473@BUTTON_2"
msgstr "\"O sangue do Consorte já é meu!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_474@BODY_FOOTER@GOT_BLOOD"
msgstr "Você obteve o sangue exaltado de um(a) {GLOBAL.ArchvampireLoreConcept.Hyperlink}. Avance até o(a) {EventStructure} para despertar o(a) [hyperlink,GLOBAL.UrvatoghLoreConcept]Progenitor de Todo o Povo Vampiro[/hyperlink]."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_474@BUTTON_2"
msgstr "Cometa a Diablerie [evilact/] e consuma uma porção deste sangue exaltado! [xp/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_474@BUTTON_3"
msgstr "Realize um Rito Hemoc [thralls/] com este sangue exaltado para expandir seu reinado. [food/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_474@BUTTON_4"
msgstr "Reúna todo o sangue, mas reserve uma porção para seus estudos. [knowledge/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_474@BUTTON_5"
msgstr "\"A Reckoning Sangrenta está próxima!\" [influence/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_485@BODY_FOOTER"
msgstr "\"Mate {Wife.TitleFirstName} ou {Husband.TitleFirstName} e obtenha o sangue deles. Então poderemos abrir a cripta e dar um fim a {Emperor.Name}.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_485@BODY_HEADER"
msgstr "{Huntress.FirstName} olha para você com um olhar estudioso. \"Tudo bem, agora vem a parte fácil do plano.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_485@BODY_LORE"
msgstr "\"Vamos fazer o que eu faço de melhor e ver se você também consegue. Matar Vampiros. Depois, você faz o que sua espécie faz de melhor: toda aquela maldita magia de sangue para abrir a cripta. Como já foi estabelecido, precisaremos do sangue dos Consortes para realizar seu... rito, então você sabe o que isso significa?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_485@BUTTON_0"
msgstr "\"A caçada começou.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_485@BUTTON_2"
msgstr "\"Esse é um plano terrível. Vou seguir meu próprio caminho.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_485@BUTTON_3"
msgstr "\"O sangue deles já é meu.\" [influence/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_485@TITLE"
msgstr "A Caçada Começou"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_486@BODY_FOOTER"
msgstr "{Huntress.FirstName} olha para você com um brilho impaciente em <<o:Huntress>> olho. \"Sua vez, parceiro.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_486@BODY_HEADER"
msgstr "Com {ConsortKilled} derrotado, {Huntress.FirstName} se aproxima de você com um brilho ambicioso em <<p:Huntress>> olho."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_486@BODY_HEADER@SUPERBADASS"
msgstr "{Huntress.FirstName} recua e arfa. \"C– Como? Quem?...\" <<p:Huntress>> gagueja com os olhos arregalados. \"Isso é uma caçada de nível superior!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_486@BODY_LORE"
msgstr "\"Trabalho impressionante — 'parceiro(a)',\" sorri {Huntress.FirstName}. \"Com este sangue, podemos abrir o(a) {EventStructure} e fazer o que há muito se pensava ser impossível. Nossa, como sonhei com este momento, e pensar que aconteceria ao lado de um Vampiro sanguinário, bah!\" <<Cp:Huntress>> olha para longe por um momento, então sussurra, \"Mãe ficaria orgulhosa...\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_486@BUTTON_0"
msgstr "\"Hora de caçar a grande presa, parceiro(a).\" [rs_alliance/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_486@BUTTON_2"
msgstr "\"Parceiro(a)? Este sangue é meu e somente meu, pereça!\" [evilact/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_486@BUTTON_3"
msgstr "\"Não preciso de um parceiro, preciso de ouro.\" [gold/]"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_486@TITLE"
msgstr "A Caçada Começou: Sucesso!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_491@BODY_FOOTER"
msgstr "<<Cp:Emperor>> estende a mão <<o:Emperor>> e sussurra: \"Árbitro da Conta Sangrenta, revele-me o que ansiei saber por toda a eternidade: reinaremos juntos para sempre ou você será minha tão cobiçada destruição?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_491@BODY_HEADER"
msgstr "Das trevas do vazio, emergem duas presas de marfim, seguidas por olhos flamejantes como portais para o próprio [hyperlink,GLOBAL.EndailonLoreConcept]Endailon de Sombra[/hyperlink]. O olhar <<Co:Emperor>> exaltado prende toda a sua atenção."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_491@BODY_LORE"
msgstr "\"Obrigado por me libertar, minha prole incomparável\", confidencia {Emperor.Name}. \"E que Vampiro magnífico você é... Durante todo o Meu sono selado, sonhei com a sua chegada {Player.Name}. No entanto, agora, ao vê-lo aqui diante de Mim, em toda a sua perfeição majestosa, devo declarar: você é uma visão mais gloriosa do que os sonhos jamais poderiam conceber.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_491@BUTTON_0"
msgstr "Una-se ao Deus Imortal ao lado <<Co:Emperor>> desperto."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_491@BUTTON_1"
msgstr "Jure destruir o Deus Imortal!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_491@TITLE"
msgstr "Rosto do Criador Presas"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_492@BODY_FOOTER"
msgstr "OBSOLETO"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_492@BODY_HEADER"
msgstr "OBSOLETO"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_492@BODY_LORE"
msgstr "OBSOLETO"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_492@BUTTON_0"
msgstr "OBSOLETO"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_492@TITLE"
msgstr "OBSOLETO"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_493@BODY_FOOTER"
msgstr "<<Cp:Emperor>> olha para você com desejo por um momento, antes de se virar e sacar <<o:Emperor>> arma. \"Sangue por sangue.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_493@BODY_HEADER"
msgstr "Por um breve instante, {Emperor.FirstName} sorri para você com afeto sincero. \"Você é exatamente como eu esperava que fosse, minha prole da desgraça.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_493@BODY_LORE"
msgstr "\"Ah, como anseio pelo seu melhor ataque à minha vida, {Player.FirstName}\", lamenta {Emperor.Name} com melancolia amarga. \"Embora meu desejo possa muito bem ser em vão, como sempre. Independentemente disso... venha, vamos nos unir nesta dança sombria de derramamento de sangue que estou eternamente fadado a realizar.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_493@BUTTON_0"
msgstr "\"Sangue por sangue.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_493@TITLE"
msgstr "Acerto de Contas com o Criador"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_508@BODY_FOOTER"
msgstr "{Huntress.FirstName} estuda você com intenção calculista. \"Então me diga, ainda está considerando minha oferta ou não?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_508@BODY_HEADER"
msgstr "No momento da sua determinação, {Huntress.FirstName} estende a mão para você."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_508@BODY_LORE"
msgstr "<<Cp:Huntress>> olha para você com um sorriso maldoso. \"Tenho observado você. Está aprontando alguma coisa, não está?\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_508@BUTTON_0"
msgstr "\"Estou, só tenha paciência.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_508@BUTTON_1"
msgstr "\"Não, vou seguir meu próprio caminho.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_508@BUTTON_2"
msgstr "\"Você... espionando-me? Isso significa guerra!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_508@TITLE"
msgstr "Conflito Sangrento de Interesses"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_513@BODY_FOOTER"
msgstr "Sim, aqui está a Cripta do [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink]. Porém, de longe, não há entrada visível. Melhor inspecioná-la de perto."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_513@BODY_HEADER"
msgstr "Ao seu redor, estende-se um charco de sangue, muito, muito mais antigo que qualquer {GLOBAL.ElderVampireLoreConcept.Hyperlink}. O ar pútrido está estagnado e carregado de decomposição."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_513@BODY_LORE"
msgstr "Rios de sangue escorrem pela grande colina, seguindo em direção a uma depressão profunda na terra. Lá, em um vale enevoado e repleto de cadáveres, você encontra um grande monumento antigo coberto pela vegetação. Parece ser... um sepulcro ancestral? Ou talvez uma cripta."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_513@BUTTON_0"
msgstr "Continue sua missão."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_513@TITLE"
msgstr "Um Sepulcro Selado"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_516@BODY_FOOTER"
msgstr "Ofegante de exaustão, uma risada enlouquecida escapa da forma trêmula de <<o:Wife>>. \"Muito bem. Lição aprendida: Nunca. Confie. Em. Ninguém. Nunca! Hora de matar. Matar. Matar!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_516@BODY_HEADER"
msgstr "Por um longo instante, {Wife.TitleFirstName} encara você com olhos perplexos arregalados, <<o:Wife>> boca entreaberta e trêmula."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_516@BODY_LORE"
msgstr "\"Você...\" <<p:Wife>> sibila com a garganta seca. \"Seu mentiroso nojento! Seu rato maldito! Vou arrancar sua garganta por isso! Vou arrancar seus dentes e despedaçar você, vou... vou...\" <<Co:Wife>> rosto e corpo tremem em um acesso de histeria enquanto <<p:Wife>> joga <<o:Wife>> cabeça para trás e solta um grito para o céu como uma alma penada!"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_516@BUTTON_0"
msgstr "\"Hora de matar, de fato.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_516@TITLE"
msgstr "Traidor Doloroso Profundo"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_517@BODY_FOOTER"
msgstr "\"N–não importa\", <<p:Husband>> gagueja com um sorriso vil e crescente. \"A culpa é toda minha por confiar na classe inferior. Esse erro será corrigido em breve, com determinação furiosa!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_517@BODY_HEADER"
msgstr "{Husband.TitleFirstName} olha para você com intenção furiosa e incandescente. <<Co:Husband>> narinas se dilatam e vapor sai de <<o:Husband>> pele."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_517@BODY_LORE"
msgstr "\"Como pôde fazer isso comigo\", <<p:Husband>> exige com um tremor rosnado na <<o:Husband>> voz. \"Comigo? {Husband.TitleName}! Seu camponês insolente! Você não sabe o que fez! Você não...\" <<Cp:Husband>> corrige <<r:Husband>> com um gesto desdenhoso das <<o:Husband>> mãos trêmulas."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_517@BUTTON_0"
msgstr "\"Faça o seu pior.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_517@TITLE"
msgstr "Traidor Fervente Ardente"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_518@BODY_FOOTER"
msgstr "\"Agora você fez isso ficar pessoal, seu idiota\", <<p:Huntress>> sorri sinistramente. \"Vou esculpir uma estaca com seu nome. Venha pegá-la!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_518@BODY_HEADER"
msgstr "{Huntress.FirstName} se vira para você com uma expressão de surpresa aturdida em <<o:Huntress>> sobrancelhas, antes de cuspir uma maldição silenciosa."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_518@BODY_LORE"
msgstr "\"Bem, não posso dizer que estou totalmente surpreso\", <<p:Huntress>> resmunga. \"Dói? Claro, um pouco. Mas surpreso? Por ser apunhalado pelas costas por um Vampiro nojento e desprezível? Não, isso está na sua natureza vil e sugadora de sangue, não está? Abominações miseráveis; todos vocês!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_518@BUTTON_0"
msgstr "\"Sua morte será um prazer para mim.\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_518@TITLE"
msgstr "Traidor Sanguinário"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_521@BODY_FOOTER"
msgstr "{Wife.TitleFirstName} engasga com <<o:Princess>> grito e então cai em um silêncio sinistro enquanto {Emperor.Name} domina completamente <<o:Wife>> mente. (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_521@BODY_HEADER"
msgstr "\"Muito bem, {Player.FirstName}\", sorri {Emperor.Name} enquanto <<p:Emperor>> inicia um poderoso ritual de sangue. \"Você não me deixa escolha senão nivelar nosso campo de batalha iminente.\" (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_521@BODY_LORE"
msgstr "Então, {Wife.TitleFirstName} é invocada, gritando e berrando enquanto arranca <<P:Wife>> cabelo. \"Não! Não! De novo não, seu porco nojento! Saia da minha cabeça! Aaaaargh!\"[br/][br/]{Emperor.Name} sangra dos olhos de <<o:Emperor>>, enquanto <<p:Emperor>> rosna bestialmente. \"Silêncio, sua rameira insolente\", zomba <<p:Emperor>>. \"Lidarei com sua traição depois. Primeiro, temos uma vingança a honrar. Venha a mim, meu Consorte!\" (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_521@BUTTON_0"
msgstr "\"Que assim seja.\" (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_521@BUTTON_2"
msgstr "Tentar frustrar o feitiço! (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_521@TITLE"
msgstr "Renovação Atormentada de Votos (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_532@BODY_FOOTER"
msgstr "{Husband.TitleFirstName} engasga com <<o:Husband>> gaguejos e então cai em um silêncio sinistro enquanto {Emperor.Name} domina completamente <<o:Husband>> mente. (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_532@BODY_HEADER"
msgstr "\"Muito bem, {Player.FirstName}\", sorri {Emperor.Name} enquanto <<p:Emperor>> inicia um poderoso ritual de sangue. \"Você não me deixa escolha senão nivelar nosso campo de batalha iminente.\" (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_532@BODY_LORE"
msgstr "Então, {Husband.TitleFirstName} é invocada, gaguejando e resistindo enquanto um suor sangrento brota em <<o:Husband>> testa. \"Misericórdia, meu Sire^m\", implora <<p:Husband>>. \"{Wife.FirstName} me obrigou, juro! Eu sempre fui seu Consorte fiel!\"[br/][br/] {Emperor.Name} sangra dos olhos de <<o:Emperor>>, enquanto <<p:Emperor>> rosna bestialmente. \"Silêncio, seu cão insolente\", zomba <<p:Emperor>>. \"Lidarei com sua traição depois. Primeiro, temos uma vingança a honrar. Venha a mim, meu Consorte!\" (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_532@BUTTON_0"
msgstr "\"Que assim seja.\" (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_532@BUTTON_2"
msgstr "Tentar frustrar o feitiço! (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_532@TITLE"
msgstr "Jubileu Forçado de Votos (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_533@BODY_FOOTER"
msgstr "\"Venha, pare de lutar, meu êxtase\", oferece {Emperor.Name}. \"Una-se ao meu lado, onde você realmente pertence! E juntos, desencadearemos uma vingança que inspirará terror até mesmo no {GLOBAL.ArchonsLoreConcept.Hyperlink}!\" (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_533@BODY_HEADER"
msgstr "{Emperor.Name} se aproxima de você, <<o:Emperor>> olhos brilham e cintilam como uma galáxia enquanto <<p:Emperor>> se dirige a você com palavras delicadas. (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_533@BODY_LORE"
msgstr "\"{Player.FirstName}, admiro seu espírito de luta\", elogia <<p:Emperor>>. \"De fato. Você é etereamente magnífica enquanto engrandece a terra com seu grandioso e impecável senso de propósito. O próprio chão sob seus pés é totalmente indigno da sua presença, e isso me enche de um orgulho elevado e arrebatador por saber que você é minha prole. Minha criação suprema, a perfeição feita carne.\" (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_533@BUTTON_0"
msgstr "\"Não significa não!\" (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_533@BUTTON_1"
msgstr "Aceitar a oferta e se juntar ao Deus Imortal afinal. (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_533@TITLE"
msgstr "Encantos do Deus Imortal (DEPRECATED)"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_547@BODY_FOOTER"
msgstr "Com um arrepio, uma compreensão surge... Seria isso, {Emperor.Name}? Será que <<Cp:Emperor>> realmente acabou de entrar em contato com você?"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_547@BODY_HEADER"
msgstr "De repente, uma brisa fria e curiosa toca seus sentidos. Ela carrega um murmúrio assustador, um sussurro do além..."

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_547@BODY_LORE"
msgstr "Aguçando seus sentidos vampíricos, você percebe que o suspiro medonho contém palavras audíveis. \"Meu... Libertador...\" diz. \"Venha... Venha até mim. Quebre o selo... Quebre o selo da Cripta...\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_547@BUTTON_0"
msgstr "\"Ainda vou encontrar você!\""

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_547@TITLE"
msgstr "Sussurros da Cripta"

msgid "DLC@THRONESOFBLOOD@STORY_EVENT@1229_619@TITLE"
msgstr "Sangue dos Consortes"

msgid "DLC@THRONESOFBLOOD@STORY_REALMS@NAME"
msgstr "Sangue e Cortejo"

msgid "DLC@THRONESOFBLOOD@STORY_REALM_01@AISTARTINGBONUS@DESCRIPTION@EMPEROR"
msgstr "O governante começa com estruturas adicionais desbloqueadas e heróis extras."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_01@AISTARTINGBONUS@NAME@EMPEROR"
msgstr "Bônus Inicial do Imperador"

msgid "DLC@THRONESOFBLOOD@STORY_REALM_01@ANCIENT_WONDER@CRIMSON_FANE@ALT_STRUCT_DESCR"
msgstr "Esta sepultura, há muito evitada e tomada pelo mato, foi erguida tanto para sepultar o [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] quanto para homenagear a criação de toda a espécie vampírica. A lenda conta que um reino de rosas já prosperou nesta colina, onde, um dia, dois amantes se encontraram e, por fim, sangraram até a morte. Através desse ritual profano, o primeiro vampiro surgiu e, depois, gerou muitos outros."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_01@ANCIENT_WONDER@FANE_CRYPT@ALT_STRUCT_NAME"
msgstr "Cripta do Deus Imortal"

msgid "DLC@THRONESOFBLOOD@STORY_REALM_01@ANCIENT_WONDER@ROSE_PALACE@ALT_STRUCT_DESCR"
msgstr "Incontáveis orgias de sangue ocorreram dentro dos muros deste lugar amaldiçoado. E, através do sacrifício de incontáveis almas, um feitiço maligno foi tecido ao seu redor, paralisando toda a propriedade no tempo — afastando tanto a ruína quanto saqueadores. Pois um labirinto encantado e espinhoso se espalha ao seu redor, que dizem proteger uma única rosa do verdadeiro amor, cultivada na torre mais alta."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_01@ANCIENT_WONDER@ROSE_PALACE@ALT_STRUCT_NAME"
msgstr "Palácio da Rosa do Imperador Sanguinário"

msgid "DLC@THRONESOFBLOOD@STORY_REALM_01@DESCRIPTION"
msgstr "Como {GLOBAL.ElderVampireLoreConcept.Hyperlink}, retorne ao reino de origem amaldiçoado de toda a espécie vampírica. Enfrente ou corteje seus dois {GLOBAL.ArchvampireLoreConcept.Hyperlink} guardiões rivais, enquanto se aventura para descobrir a mítica Cripta do [hyperlink,GLOBAL.UrvatoghLoreConcept]Deus Imortal[/hyperlink] e provocar um ajuste de contas há muito esperado com sangue."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_01@NAME"
msgstr "Drevanya Amaldiçoada"

msgid "DLC@THRONESOFBLOOD@STORY_REALM_01@SITE@FANE_CRYPT@ALT_STRUCT_NAME"
msgstr "Altar de Revivescência Sanguinária"

msgid "DLC@THRONESOFBLOOD@STORY_REALM_01@SITE@THORNED_HEART@ALT_STRUCT_NAME"
msgstr "Roseira Partida dos Endailon"

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@BRIEFING_01@DESCRIPTION"
msgstr "Há eras, em um tempo em que as forças do poder elemental vagavam pelo cosmos, um príncipe traiu sua amada e, por esse derramamento de sangue, foi amaldiçoado. Assim surgiu uma criatura de grande poder e fascínio, nem morta nem viva, que se alimentava dos vivos e prosperava nas sombras: o primeiro Vampiro."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@BRIEFING_02@DESCRIPTION"
msgstr "Esse Vampiro espalharia sua maldição de poder e danação por meio de seu 'beijo' letal. Com isso, tornou-se o Deus Imortal; um flagelo que invadiu e escravizou reinos inteiros. No entanto, nascido da traição, a traição seria sua ruína... Pois a inquietação surgiu de dentro."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@BRIEFING_03@DESCRIPTION"
msgstr "Um falso amor selou o Deus Imortal em uma cripta, e a revolta que se seguiu o condenou, junto com todo o seu Reino, ao Cofre-Mundo chamado Grexolis. Conforme o primeiro Vampiro se tornava mito e lenda, os Vampiros remanescentes foram caçados ou fugiram para as sombras."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@BRIEFING_04@DESCRIPTION"
msgstr "Porém, após Eras de exílio, o reino do primeiro Vampiro imortal emergiu do esquecimento de Grexolis. Poucos se lembravam do cruel Deus Imortal, mas muitos Vampiros conheciam o mito da Reckoning Sangrenta, quando o Deus Imortal despertaria mais uma vez e a Era dos Vampiros teria início.[br/][br/]Esta é a história do Vampiro que traria essa Reckoning Sangrenta."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@CHOSE_SIDE_HUNTRESS@CUSTOM_PREDICTION_01"
msgstr "Continue com a Missão da Caçadora, mas encerre a sua própria. (Por enquanto...)"

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@CHOSE_SIDE_HUNTRESS@CUSTOM_PREDICTION_02"
msgstr "Encerra a Missão da Caçadora e continue por conta própria."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@DEBRIEFING_01_RECKONING@DESCRIPTION"
msgstr "Assim, pela mão de sua prole, o Deus Imortal foi erguido de seu sono sombrio, e por seu comando real, a aristocracia Vampira dispersa foi convocada para a cripta imperial de Drevanya. Lá, prestaram homenagem ao Deus Imortal e ao Godir que o libertou."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@DEBRIEFING_01_REGICIDE@DESCRIPTION"
msgstr "Assim, o Deus Imortal foi morto por um de seus próprios descendentes. Essa Reckoning Sangrenta foi sentida por todos os Vampiros, longe e perto, e em seus corações frios e enegrecidos agitou-se o temor ansioso da anarquia... E da oportunidade."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@DEBRIEFING_02_RECKONING@DESCRIPTION"
msgstr "As lendas da grande crueldade de Urvatogh fariam os Mundos Interiores estremecerem mais uma vez, pois sua tão prometida Reckoning Sangrenta estava apenas começando... com sua salvadora ao seu lado, destinada a permanecer em sua sombra para sempre."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@DEBRIEFING_02_REGICIDE@CONSORT@DESCRIPTION"
msgstr "Com sua cripta agora descerrada e vazia, o título, trono e Domínio do Imperador Sanguinário Eterno pertenceriam ao Vampiro Godir que o havia banido. Junto a uma nova consorte, esse Godir traria a nova Era dos Vampiros."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@DEBRIEFING_02_REGICIDE@DESCRIPTION"
msgstr "Com sua cripta agora descerrada e vazia, o título, trono e Domínio do Imperador Sanguinário Eterno pertenceriam ao Godir que o havia banido. E foi esse Godir que traria a nova Era dos Vampiros."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@DEBRIEFING_02_REGICIDE@HUNTRESS@DESCRIPTION"
msgstr "Com sua cripta agora descerrada e vazia, o título, trono e Domínio do Imperador Sanguinário Eterno cairiam mais uma vez no esquecimento, à medida que a caça aos Vampiros se intensificava... Até mesmo por seus próprios parentes."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@GIVE_ROSE_HUSBAND@CUSTOM_PREDICTION_01"
msgstr "Você ganha três <<m:{EventUnit}>> do(a) {EventRace.Name}."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@HUNTRESS_MEET@CUSTOM_PREDICTION_01"
msgstr "Declare guerra à Caçadora-Chefe Griselda. (OBSOLETO)"

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@KILL_CONSORT@CUSTOM_PREDICTION"
msgstr "Com o Sangue da Consorte, você pode entrar no(a) {EventStructure}."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@MAIN_QUEST@CUSTOM_PREDICTION_01@AVENGE_SIRE"
msgstr "Você herda os Escravos domésticos restantes de seu Arqusire. (OBSOLETO)"

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@MAIN_QUEST@CUSTOM_PREDICTION_01@REMEMBER_THIS"
msgstr "{EventLeader.Name} se lembrará disso e lhe oferecerá uma nova Missão."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@MAIN_QUEST@CUSTOM_PREDICTION_01@REMEMBER_THIS_HUSBAND"
msgstr "{Husband.TitleFirstName} se lembrará disso e lhe oferecerá uma nova Missão. [relationLvl3/]"

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@MAIN_QUEST@CUSTOM_PREDICTION_01@REMEMBER_THIS_WIFE"
msgstr "{Wife.TitleFirstName} se lembrará disso e lhe oferecerá uma nova Missão. [relationLvl3/]"

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@MAIN_QUEST@CUSTOM_PREDICTION_01@REVELRY"
msgstr "Você arromba os cofres de seu falecido Arqusire! (OBSOLETO)"

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@MEET_HUSBAND@CUSTOM_PREDICTION_01"
msgstr "Com uma liberação extática, seu sangue para de ferver instantaneamente."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@MEET_HUSBAND@CUSTOM_PREDICTION_02"
msgstr "A sensação de fervura atinge o ápice e depois diminui lentamente."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@MEET_HUSBAND@CUSTOM_PREDICTION_03"
msgstr "Seu sangue ferve em vapor quente, mas você mantém a compostura!"

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@MEET_WIFE@CUSTOM_PREDICTION_01"
msgstr "Enfurecida, a Princesa-Consorte Mavelith rasga uma corda do coração. (Requer 40 [hp/] PV)"

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@MEET_WIFE@CUSTOM_PREDICTION_02"
msgstr "Divertida, a Princesa-Consorte Mavelith apenas arranha uma corda do coração."

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@MEET_WIFE@CUSTOM_PREDICTION_03"
msgstr "Eufórica, a Princesa-Consorte Mavelith arranca uma corda do coração inteira! (Requer 80 [hp/] PV)"

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@QUEST_LOSTSOUL_EMPEROR_@OBJECTIVE"
msgstr "Voz {INT_0}/{INT_1} Encontrada"

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@QUEST_LOSTSOUL_EMPEROR_ITEM@NAME"
msgstr "Memento Amori^n"

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@QUEST_TOB1_DEFEAT_EMPEROR@OBJECTIVE"
msgstr "{INT_0}/{INT_1} Urvatogh, o Deus Imortal, Derrotado"

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@QUEST_TOB1_DEFEAT_EMPEROR@OBJECTIVE_00"
msgstr "{INT_0}/{INT_1} Cripta Localizada"

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@QUEST_TOB1_DEFEAT_EMPEROR@OBJECTIVE_01"
msgstr "{INT_0}/{INT_1} Nome do Deus Imortal Pronunciado (OBSOLETO)"

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@QUEST_TOB1_DEFEAT_EMPEROR@OBJECTIVE_02"
msgstr "{INT_0}/{INT_1} Sangue das Consortes Obtido"

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@QUEST_TOB1_DEFEAT_EMPEROR@OBJECTIVE_03"
msgstr "{INT_0}/{INT_1} Cripta do Deus Imortal Desegredada"

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@QUEST_TOB1_DEFEAT_EMPEROR@OBJECTIVE_04"
msgstr "{INT_0}/{INT_1} Juízo Final Liberado sobre Urvatogh"

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@QUEST_TOB1_DEFEAT_EMPEROR@OBJECTIVE_ALT"
msgstr "{INT_0}/{INT_1} Deus Imortal Despertado"

msgid "DLC@THRONESOFBLOOD@STORY_REALM_MISSION_01@QUEST_TOB1_JOIN_EMPEROR@MAIN_OBJECTIVE_ALT"
msgstr "{INT_0}/{INT_1} Urvatogh, o Deus Imortal, Protegido"

