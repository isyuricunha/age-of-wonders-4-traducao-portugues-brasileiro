msgid "EXPANSION_VICTORY@VICTORY_CONDITION@DESCRIPTION"
msgstr "Quando um {GLOBAL.EmpireConcept.Hyperlink} cresce o suficiente, seja por si {GLOBAL.DomainConcept.Hyperlink} mesmo ou por [hyperlink,GLOBAL.PactOfVassalageConcept]Vassalizar[/hyperlink] <<m:{GLOBAL.IndependentCityConcept.Hyperlink}>>, ele pode buscar a vitória por expansão. Para isso, será necessário construir três <<m:{GLOBAL.STRUCTURE_UPGRADES.BEACONOFUNITY.Hyperlink}>> e acendê-las. Se o império e seus [hyperlink,GLOBAL.DSAllianceConcept]Aliados[/hyperlink] conseguirem defender e manter suas balizas por tempo suficiente, serão vitoriosos."

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ANCIENT_TREE@DESCRIPTION"
msgstr "[bulletlist][bullet/]{manabonus} {GLOBAL.ManaConcept.Hyperlink} e {knowledgebonus} {GLOBAL.KnowledgeConcept.Hyperlink} por {GLOBAL.ForesterConcept.Hyperlink} em {GLOBAL.CityConcept.Hyperlink} {GLOBAL.DomainConcept.Hyperlink}.[bullet/]Adiciona {GLOBAL.UNITS.ENTWINED_THRALL_UNIT.Hyperlink}, {GLOBAL.UNITS.ENTWINED_PROTECTOR_UNIT.Hyperlink} e {GLOBAL.UNITS.ENTWINED_SCOURGE_UNIT.Hyperlink} ao {GLOBAL.RequestMilitaryAidConcept.Hyperlink}.[/bulletlist]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ANCIENT_TREE@LORE"
msgstr "[lorefontsize][lorefont]As Escrituras descrevem como os Primeiros Elfos visitaram todos os [hyperlink,GLOBAL.WorldsWithinLoreConcept]Mundos[/hyperlink] para semeá-los com vida. Esta árvore magnífica é um testemunho daquela era. Diz-se que as almas desses Primeiros ainda residem dentro dela, às vezes se manifestando como os Entrelaçados, eternamente ligados para proteger seu crescimento.[/lorefont][/lorefontsize]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ANCIENT_TREE@NAME"
msgstr "Árvore do Mundo"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ANCIENT_WELLSPRING@DESCRIPTION"
msgstr "[bulletlist][bullet/]{stabilitybonus} {GLOBAL.CityStabilityConcept.Hyperlink} por {GLOBAL.FarmConcept.Hyperlink} e {GLOBAL.ForesterConcept.Hyperlink} em {GLOBAL.CityConcept.Hyperlink} {GLOBAL.DomainConcept.Hyperlink}.[bullet/]Unidades <<m:{GLOBAL.UnitConcept.Hyperlink}>> amigas em {GLOBAL.DomainConcept.Hyperlink} são curadas em {healamount} <<m:{GLOBAL.HitPointConcept.Hyperlink}>> ao final de cada {GLOBAL.TurnConcept.Hyperlink} estratégico.[bullet/]Adiciona {GLOBAL.UNITS.SPRING_FAIRY.Hyperlink}, {GLOBAL.UNITS.SUMMER_FAIRY.Hyperlink}, {GLOBAL.UNITS.AUTUMN_FAIRY.Hyperlink} e {GLOBAL.UNITS.WINTER_FAIRY.Hyperlink} ao {GLOBAL.RequestMilitaryAidConcept.Hyperlink}.[/bulletlist]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ANCIENT_WELLSPRING@LORE"
msgstr "[lorefontsize][lorefont]Este local exuberante é alimentado por uma fonte mágica que flui diretamente do reino das fadas. Águas místicas atraem todo tipo de criatura, alheias ao fato de que podem ser vítimas de truques do povo feérico. O que uma fada considera travessura pode ser potencialmente mortal para outros! Até os seres mais poderosos devem prosseguir com cautela.[/lorefont][/lorefontsize]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ANCIENT_WELLSPRING@NAME"
msgstr "Fonte Oculta"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ARCHON_RUINS@DESCRIPTION"
msgstr "[bulletlist][bullet/]{quarryincome} por {GLOBAL.QuarryConcept.Hyperlink} em {GLOBAL.CityConcept.Hyperlink} {GLOBAL.DomainConcept.Hyperlink}.[bullet/]Pode ser definido como um local de {GLOBAL.UnitConcept.Hyperlink} implantação.[bullet/]Adiciona as unidades {GLOBAL.UNITS.BREWER_OGRE.Hyperlink} e {GLOBAL.UNITS.BUTCHER_OGRE.Hyperlink} ao {GLOBAL.RequestMilitaryAidConcept.Hyperlink}.[/bulletlist]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ARCHON_RUINS@LORE"
msgstr "[lorefontsize][lorefont]As ruínas de uma fortaleza maciça que remontam a uma era em que as primeiras civilizações resistiram a monstros gigantescos e tempestades mágicas desenfreadas. Embora desgastadas, suas muralhas ainda oferecem um grau de proteção àqueles que estão dentro e próximos em tempos de conflito.[/lorefont][/lorefontsize]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ARCHON_RUINS@NAME"
msgstr "Ruínas do Castelo"

