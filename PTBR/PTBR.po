msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_07@PROP_DESCRIPTION"
msgstr "Os ataques desta unidade têm {BOON_STEALING_RESISTANCE_CHECK>ResolvedStrength}% de chance de roubar um {GLOBAL.PositiveStatusEffectConcept.Hyperlink}.[br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_08@NAME"
