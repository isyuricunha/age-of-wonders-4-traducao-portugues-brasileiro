msgstr "Pastor das Trevas"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@HERO_SKILL@PROPERTY_DESCRIPTION"
msgstr "Esta unidade tem:[bulletlist][bullet/]{GLOBAL.PROPERTIES.SHADOW_SICKNESS_IMMUNITY.Hyperlink}.[bullet/][hyperlink,GLOBAL.WorldMapRegeneration]Regenerar[/hyperlink] +{GLOOM_SHEPHERD_HEALTH_REGEN>BONUS>Regen} {GLOBAL.HitPointConcept.Hyperlink} por {GLOBAL.TurnConcept.Hyperlink} no mapa-múndi enquanto estiver em terreno de Trevas.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@PROVINCE_IMPROVEMENT@DESCRIPTION"
msgstr "[bulletlist][bullet/]{basemanaamount} renda de {GLOBAL.ManaConcept.Hyperlink}.[bullet/]A cada {GLOBAL.TurnConcept.Hyperlink}, {amount} {GLOBAL.ProvinceConcept.Hyperlink} em um raio igual ao Nível da Cidade:[bulletlist][bullet/]Ganha {GLOBAL.GloomTerrainConcept.Hyperlink}.[bullet/]Perde {GLOBAL.ChasmConcept.Hyperlink}, {GLOBAL.RiverConcept.Hyperlink}, {GLOBAL.SwampConcept.Hyperlink}, {GLOBAL.SandConcept.Hyperlink}, {GLOBAL.SnowConcept.Hyperlink}, {GLOBAL.FrozenWasteConcept.Hyperlink} e {GLOBAL.AshlandsConcept.Hyperlink}.[/bulletlist][bullet/]Conta como um {GLOBAL.ConduitConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@PROVINCE_IMPROVEMENT@NAME"
msgstr "[conduit/] Altar da Marcha das Trevas"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@SKILL1@DESCRIPTION"
msgstr "Alvo {GLOBAL.ProvinceConcept.Hyperlink} e <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacentes:[bulletlist][bullet/]Ganham {GLOBAL.GloomTerrainConcept.Hyperlink}[bullet/]Perdem {GLOBAL.ChasmConcept.Hyperlink}, {GLOBAL.RiverConcept.Hyperlink}, {GLOBAL.SandConcept.Hyperlink}, {GLOBAL.SnowConcept.Hyperlink}, {GLOBAL.FrozenWasteConcept.Hyperlink}, {GLOBAL.AshlandsConcept.Hyperlink}, {GLOBAL.SwampConcept.Hyperlink}, {GLOBAL.CavernFloorConcept.Hyperlink} e {GLOBAL.DungeonConcept.Hyperlink}.[bullet/]Unidades inimigas <<m:{GLOBAL.UnitConcept.Hyperlink}>> sofrem {colddamage} {GLOBAL.FrostDamageConcept.Hyperlink} e {blightdamage} {GLOBAL.BlightDamageConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@SKILL1@NAME"
msgstr "Manto de Trevas"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@SKILL2@DESCRIPTION"
msgstr "Cria uma Fenda Umbral na província-alvo do Abismo Umbral e outra próxima na camada da Superfície."

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@SKILL2@NAME"
msgstr "Fenda Umbral"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@SKILL3@DESCRIPTION"
msgstr "A unidade-alvo tem {UMBRAL_EXILE_RESIST>ResolvedStrength}% de chance base de:[bulletlist][bullet/]Ser removida imediatamente do combate.[bullet/]Aparecer em um local aleatório no Abismo Umbral após a batalha.[bullet/]Se falhar, inflige {GLOBAL.PROPERTIES.STUNNED.Hyperlink} por {STUNNED_EFFECT_DESCRIPTION>NumTurns}{GLOBAL.TurnConcept.Name}.[/bulletlist][br/][br/]Não pode ser usada em Combate Aquático."

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@SKILL3@LOG_MESSAGE"
msgstr "Exilado"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@SKILL3@NAME"
