msgid "TOME_AMPLIFICATION@SKILL5@NAME"
msgstr "Amplificar Mentes"

msgid "TOME_AMPLIFICATION@SKILL6@DESCRIPTION"
msgstr "Faz os ataques das unidades encantadas:[bulletlist][bullet/]causarem +{LIGHTNING_FOCUS_EXTRA_DAMAGE>DAMAGE>Shock} {GLOBAL.LightningDamageConcept.Hyperlink}.[bullet/]Concedem chance base de {ELECTRIFIED_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.ELECTRIFIED.Hyperlink}, um efeito de dano ao longo do tempo.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

