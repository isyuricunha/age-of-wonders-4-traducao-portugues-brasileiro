msgid "CULTURE_DARK@CULTOFTYRANNY@CULT_OF_TYRANNY@DESCRIPTION"
msgstr "Inimigos adjacentes têm {StatusResistanceCount} {GLOBAL.StatusResistanceConcept.Hyperlink}."

msgid "CULTURE_DARK@CULTOFTYRANNY@CULT_OF_TYRANNY@GROUP_DESCRIPTION"
msgstr "[bulletlist][bullet/]{GLOBAL.PROPERTIES.AURA_OF_TYRANNY.Hyperlink}[bullet/]Os ataques têm uma chance base de {CULT_OF_TYRANNY_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.STATUS_VULNERABILITY.Hyperlink} e curar esta unidade em {CULT_OF_TYRANNY_HEALING>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "CULTURE_DARK@CULTOFTYRANNY@CULT_OF_TYRANNY@MODIFIER_DESCRIPTION"
msgstr "Chance base de {CULT_OF_TYRANNY_RESISTANCE>ResolvedStrength}% de:[bulletlist][bullet/]Infligir {GLOBAL.PROPERTIES.STATUS_VULNERABILITY.Hyperlink} por {STATUS_VULNERABILITY_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept.Hyperlink}>>.[bullet/]Curar a si mesmo em {CULT_OF_TYRANNY_HEALING>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[/bulletlist]"

msgid "CULTURE_DARK@CULTOFTYRANNY@CULT_OF_TYRANNY@MODIFIER_NAME"
msgstr "Explorar Vulnerabilidade"

msgid "CULTURE_DARK@CULTOFTYRANNY@CULT_OF_TYRANNY@MODIFIER_PROPERTY_DESCRIPTION"
msgstr "Os ataques da unidade têm uma chance base de {CULT_OF_TYRANNY_RESISTANCE>ResolvedStrength}% de:[bulletlist][bullet/]Infligir {GLOBAL.PROPERTIES.STATUS_VULNERABILITY.Hyperlink} por {STATUS_VULNERABILITY_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept.Hyperlink}>>.[bullet/]Curar a si mesmo em {CULT_OF_TYRANNY_HEALING>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

