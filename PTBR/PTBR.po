msgid "TOME_HERALDS_DOOM@SKILL5@DESCRIPTION"
msgstr "Faz a raça alvo se tornar sugadoras de moral vivas, fazendo com que seus ataques:[bulletlist][bullet/]Roubem {JOY_SIPHONERS_CHANGE_MORALE>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink} por acerto.[bullet/]A perda de moral é dobrada se o alvo tiver moral Alta.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_HERALDS_DOOM@SKILL5@NAME"
msgstr "Sifões de Alegria"

