msgid "DLC@RISEFROMRUIN@SPAWNERS_STRATEGIC@FLEETING_FRACTURED_INFESTATION@DESCRIPTION"
msgstr "Uma cicatriz temporária habitada por criaturas {GLOBAL.PROPERTIES.MANA_STARVED.Hyperlink} que espalha {GLOBAL.AstralBarrensConcept.Hyperlink} em seu território.[br/][br/]Se não for contida, elas crescerão em força, expandirão seu território e enviarão exércitos de invasão."

msgid "DLC@RISEFROMRUIN@SPAWNERS_STRATEGIC@FLEETING_FRACTURED_INFESTATION@NAME"
msgstr "Infestação Fraturada Passageira"

msgid "DLC@RISEFROMRUIN@SPAWNERS_STRATEGIC@FRACTURED_INFESTATION@DESCRIPTION"
msgstr "Uma enorme cicatriz habitada por criaturas {GLOBAL.PROPERTIES.MANA_STARVED.Hyperlink}.[br/]Esta infestação espalha {GLOBAL.AstralBarrensConcept.Hyperlink} em seu território.[br/]Se não for contida, elas crescerão em força, expandirão seu território e enviarão exércitos de invasão."

msgid "DLC@RISEFROMRUIN@SPAWNERS_STRATEGIC@FRACTURED_INFESTATION@LORE"
msgstr "Uma {GLOBAL.FractureLoreConcept.Hyperlink} deixa apenas morte e devastação. A terra se torna estéril, seus habitantes retorcidos e deformados. Aqueles amaldiçoados a sobreviver se tornam cascas ocas que mal lembram seus antigos eus, movidos por uma fome voraz por mana. Sua mera presença drena a energia de seus arredores, transformando os lugares que habitam e espalhando ainda mais a poluição."

msgid "DLC@RISEFROMRUIN@SPAWNERS_STRATEGIC@FRACTURED_INFESTATION@NAME"
msgstr "Infestação Fraturada"

msgid "DLC@RISEFROMRUIN@SPAWNERS_STRATEGIC@GREAT_WORM_INFESTATION@DESCRIPTION"
msgstr "Uma enorme cicatriz habitada pelo Grande Vermes e sua prole.[br/]Esta infestação espalha {GLOBAL.AstralBarrensConcept.Hyperlink} em seu território.[br/]Se não for contida, elas crescerão em força, expandirão seu território e enviarão exércitos de invasão. O território do Grande Vermes sofrerá {GLOBAL.PROPERTIES.TSR_RFR_GWL_WORM_PROPERTY.Hyperlink}."

msgid "DLC@RISEFROMRUIN@SPAWNERS_STRATEGIC@GREAT_WORM_INFESTATION@NAME"
msgstr "Infestação do Grande Vermes"

msgid "DLC@RISEFROMRUIN@SPELL_PROPERTY@IRRADIANT_FLARE@DESCRIPTION"
msgstr "Exército alvo:[bulletlist][bullet/]Sofre {amount} {GLOBAL.PhysicalDamageConcept.Hyperlink}, dobrado se lançado em um {GLOBAL.AstralBarrensConcept.Hyperlink}.[bullet/]Por {duration} {GLOBAL.WorldMapConcept.Hyperlink} {GLOBAL.TurnConcept}, no início do combate as unidades neste exército têm uma chance de {amount2}% de se tornarem {GLOBAL.PROPERTIES.MANA_DRAINED.Hyperlink}.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@SPELL_PROPERTY@VOLATILE_FRACTURE@DESCRIPTION"
msgstr "Exército alvo:[bulletlist][bullet/]Sofre {amount} {GLOBAL.PhysicalDamageConcept.Hyperlink}, dobrado se lançado em um {GLOBAL.AstralBarrensConcept.Hyperlink}.[bullet/]Por {duration} {GLOBAL.WorldMapConcept.Hyperlink} {GLOBAL.TurnConcept}, no início do combate as unidades neste exército têm uma chance de {amount2}% de se tornarem {GLOBAL.PROPERTIES.MANA_DRAINED.Hyperlink}.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1329@BODY_HEADER"
msgstr "Você é recebido por {EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name}: \"Uma bênção no cruzamento de nossos caminhos!\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1329@BODY_LORE"
msgstr "{EventHouseLord.Name} fala como se estivesse se dirigindo a um <<PlayerLeader{irmão/irmã}>>. \"O mesmo vento que guia meu {EventHouseRace} também impulsiona seu {PlayerRace} adiante, ó {PlayerLeader.Title}. {EventPhrase}\" O {EventHouseLord.Title} sorri. \"Que ventos quentes o levem à fortuna, meu companheiro de viagem.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1329@BUTTON_0"
msgstr "Inspecione {EventHouse}, onde os {EventHouseRace} acamparam."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1329@BUTTON_1"
msgstr "\"E que tempestades nunca o encontrem. Adeus por agora.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1329@TITLE"
msgstr "Encontrando {EventHouse} Companheira"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1332@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} acena para você. \"A estrada nos apresenta um amigo hoje!\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1332@BODY_LORE"
msgstr "{EventHouseLord.Name} inspeciona sua comitiva. \"Posso ver que seu {PlayerRace} segue um caminho diferente do meu {EventHouseRace}. {EventPhrase} Enquanto você, {EventPhrase2}.\" O {EventHouseLord.Title} sorri e dá de ombros. \"Há muito espaço neste reino para vagar. Seja bem-vindo. Não estaremos em seu caminho.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1332@BUTTON_0"
msgstr "Visite {EventHouse}, onde Conquistadores habitam."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1332@BUTTON_1"
msgstr "\"Que nossos caminhos se cruzem favoravelmente novamente.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1332@BUTTON_2"
msgstr "Visite {EventHouse}, onde Catadores habitam."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1332@TITLE"
msgstr "Encontro com {EventAdjective} {EventHouse}"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1333@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} inclina-se diante de você. Há curiosidade nos olhos de <<o:EventHouseLord>>. \"Bem-vindo, viajante.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1333@BODY_LORE"
msgstr "Não é necessário se apresentar ao sorridente {EventHouseLord.Title}: \"Já vimos sua {EventCity}, sua pedra e madeira firmemente assentadas sobre <<m:EventGeo>>. Muito antes de sua chegada, os {EventHouseRace} vagaram por este reino em busca de riquezas e tesouros.\" {EventHouseLord.Name} coloca <<o:EventHouseLord>> mão sobre <<o:EventHouseLord>> peito. \"No entanto, prometemos não armar nossas tendas em seu domínio.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1333@BUTTON_0"
msgstr "Inspecione as versáteis tendas de {EventHouse}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1333@BUTTON_1"
msgstr "\"Está resolvido. Viaje em paz.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1333@TITLE"
msgstr "Encontro com {EventHouse.Name} Nômade"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1334@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} o saúda. Mas antes que você possa falar, o {EventHouseLord.Title} levanta <<o:EventHouseLord>> mão. \"Eu falarei.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1334@BODY_LORE"
msgstr "{EventHouseLord.Name} parece indiferente. \"Meus batedores viram onde seus {PlayerRace} se estabeleceram. Não entendo por que alguém se estabeleceria em <<m:EventGeo>> {EventDirection} de uma {EventStructure}. Os {EventHouseRace} arrumariam nossas coisas e nos mudaríamos para terras mais abundantes. Mas o que sabemos sobre o funcionamento das mentes de {GLOBAL.GodirLoreConcept.Hyperlink}?\" {EventHouseLord} zomba. \"Se você me deixar em paz, retribuirei a cortesia.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1334@BUTTON_0"
msgstr "Veja onde {EventHouse} foi erguido."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1334@BUTTON_1"
msgstr "\"Um prazer. Adeus.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1334@TITLE"
msgstr "Encontro com {EventHouse} Errante"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1335@BODY_HEADER"
msgstr "Assim que {EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} o vê, <<p:EventHouseLord>> o encara com desconfiança."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1335@BODY_LORE"
msgstr "\"Não temos nada para discutir, {PlayerLeader.Title},\" o {EventHouseLord.Title} resmunga. \"Direi apenas isto: a estrada que leva a {EventCity} é um caminho de guerra. Os {EventHouseRace} marcharão até você com machados afiados e flechas longas. Nossa chegada será como uma tempestade, cheia de fúria e apressada pelos ventos.\" O {EventHouseLord.Title} lhe lança um último olhar carrancudo antes de desaparecer."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1335@BUTTON_0"
msgstr "Espie {EventHouse}, o acampamento hostil dos {EventHouseRace}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1335@BUTTON_1"
msgstr "\"Então nos encontraremos no caminho da guerra.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1335@TITLE"
msgstr "Encontro com {EventHouse} Marchante"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1339@BODY_FOOTER"
msgstr "A Nascente Represada permite que a {EnemyUnit} produza vastas quantidades de <<m:EventUnit>> na {EventStructure}. {EventHero} irá tolerar isso?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1339@BODY_FOOTER@HERO_IS_PLAYELEA"
msgstr "A Nascente Represada permite que a {EnemyUnit} produza vastas quantidades de <<m:EventUnit>> na {EventStructure}. Você irá tolerar isso?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1339@BODY_HEADER"
msgstr "{EventHero} é atraído para a {EventStructure} pelos sons metálicos de ferramentas e maquinário. Uma oficina de cerco está construída aqui."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1339@BODY_HEADER@HERO_IS_PLAYELEA"
msgstr "Você é atraído para a {EventStructure} pelos sons metálicos de ferramentas e maquinário. Uma oficina de cerco está construída aqui."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1339@BODY_LORE"
msgstr "Mercenários industriosos represaram a {GLOBAL.STRUCTURES.HIDDEN_WELLSPRING.Hyperlink} que se origina aqui, desviando suas águas infinitas para alimentar uma manufatura de engines de cerco. O leito do lago seco e drenado está indefeso contra os caprichos dos ventos fortes. Tempestades de areia perigosas, agitadas pelos ventos furiosos, varrem o deserto árido. Um {EnemyUnit} berra ordens para trabalhadores acorrentados, chicoteando-os com <<o:EnemyUnit>> {EventItem}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1339@BODY_LORE@HERO_IS_PLAYELEA"
msgstr "Mercenários industriosos represaram a {GLOBAL.STRUCTURES.HIDDEN_WELLSPRING.Hyperlink} que se origina aqui, desviando suas águas infinitas para alimentar uma manufatura de engines de cerco. Ao drenar a nascente, o leito do lago seco que permanece está sujeito aos caprichos dos ventos fortes que sopram sobre ele. Tempestades de areia perigosas são agitadas pelos ventos furiosos, varrendo o deserto árido. Um {EnemyUnit} Supervisor berra ordens."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1339@BUTTON_0"
msgstr "Atacar os bandidos industriosos."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1339@BUTTON_1"
msgstr "Chamar trabalhadores [structureprod/] de {EventCity} para sabotar a manufatura de cerco."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1339@BUTTON_2"
msgstr "Alimentar os fogos que impulsionam os construtos de cerco."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1339@BUTTON_3"
msgstr "Assumir o controle sobre as tempestades de areia furiosas."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1339@BUTTON_4"
msgstr "Permitir que os bandidos continuem seu trabalho por enquanto."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1339@TITLE"
msgstr "Desvio Represado"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1340@BODY_FOOTER"
msgstr "Ferramentas recuperadas da oficina ajudarão <<G:laborers^p,EventCity>>. A {EventStructure} potencialmente abrigará outra bênção para apoiar seus esforços de guerra."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1340@BODY_FOOTER@HERO_IS_PLAYELEA"
msgstr "Ferramentas encontradas na oficina de cerco ajudarão muito {EventCity}. Mas certamente você reclamará outro prêmio da {EventStructure}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1340@BODY_HEADER"
msgstr "Após a batalha contra o {EnemyUnit} e <<o:EnemyUnit>> <<m:EventUnit>>, {EventHero} inspeciona a oficina de cerco e a represa."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1340@BODY_HEADER@HERO_IS_PLAYELEA"
msgstr "Após a batalha contra o {EnemyUnit} e <<o:EnemyUnit>> <<m:EventUnit>>, você inspeciona a oficina de cerco e a represa."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1340@BODY_LORE"
msgstr "{EventHero.FirstName} não tem certeza se o {EnemyUnit} estava criando o <<m:EventUnit>> para outros senhores, ou se <<p:EnemyUnit>> estava construindo um exército para <<r:EnemyUnit>>. <<m:EventUnitB>> caminham cautelosamente para fora da oficina de cerco, capturados pelos mercenários e forçados a trabalhar nas máquinas. Eles entregam depoimentos arrepiantes sobre a <<G:cruelty^n,EnemyUnit>> e <<o:EnemyUnit>> rindo enquanto <<p:EnemyUnit>> os esfolava com <<o:EnemyUnit>> {EventItem}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1340@BODY_LORE@HERO_IS_PLAYELEA"
msgstr "Você não tem certeza se o {EnemyUnit} estava criando o <<m:EventUnit>> para outros senhores, ou se <<p:EnemyUnit>> estava construindo um exército para <<r:EnemyUnit>>. <<m:EventUnitB>> caminham cautelosamente para fora da oficina de cerco, capturados pelos mercenários e forçados a trabalhar nas máquinas. Eles entregam depoimentos arrepiantes sobre a <<G:cruelty^n,EnemyUnit>> e <<o:EnemyUnit>> rindo enquanto <<p:EnemyUnit>> os esfolava com <<o:EnemyUnit>> {EventItem}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1340@BUTTON_0"
msgstr "Recuperar bronze e aço não utilizados para <<G:forges^p,EventCity>>. [unitprod/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1340@BUTTON_1"
msgstr "Completar a produção de um {EventUnit}. [unit/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1340@BUTTON_2"
msgstr "Alistar [unit/] os <<m:EventUnitB>> libertados."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1340@BUTTON_3"
msgstr "Encontrar o {EventItem} que o {EnemyUnit} empunhava."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1340@BUTTON_4"
msgstr "Romper a represa para honrar a Natureza. [natureboon/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1340@TITLE"
msgstr "Desvio Represado: Consequências"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1341@BODY_FOOTER"
msgstr "Os [hyperlink,GLOBAL.PROPERTIES.BATTLE_MAGE]Magos de Batalha[/hyperlink] entombados, tecendo um redemoinho de magia, gritam: \"Prove seu valor ao Cabal da Magia.\" Como {EventHero.FirstName} reagirá?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1341@BODY_FOOTER@HERO_IS_PLAYELEA"
msgstr "Os [hyperlink,GLOBAL.PROPERTIES.BATTLE_MAGE]Magos de Batalha[/hyperlink] entombados, tecendo um redemoinho de magia, gritam: \"Prove seu valor ao Cabal da Magia.\" Como você reagirá?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1341@BODY_HEADER"
msgstr "{EventHero} encontra a entrada para um {EventStructure}. Suas portas estão seladas. Ninguém esteve aqui por séculos."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1341@BODY_HEADER@HERO_IS_PLAYELEA"
msgstr "Você encontra a entrada para um {EventStructure}. Suas portas estão seladas. Ninguém esteve aqui por séculos."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1341@BODY_HEADER@PLAYER_REVISITS"
msgstr "Seu exército retorna ao {EventStructure}. Nada indica que outra alma esteve aqui desde sua última visita."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1341@BODY_LORE"
msgstr "No entanto, dentro, tochas acesas conduzem o caminho por afrescos cobertos de teias e estátuas cobertas de musgo até um santuário interno, onde vários [hyperlink,GLOBAL.PROPERTIES.BATTLE_MAGE]Magos de Batalha[/hyperlink] sentam-se à uma mesa redonda entre pilhas de tomos. Os Magos de Batalha voltam-se para você em uníssono. \"É você quem nos libertará?\" eles dizem antes de se levantarem. Raios faíscam entre eles. \"Aquele digno de nossos segredos?\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1341@BODY_LORE@HERO_IS_PLAYELEA"
msgstr "No entanto, dentro, tochas acesas conduzem o caminho por afrescos cobertos de teias e estátuas cobertas de musgo até um santuário interno, onde vários [hyperlink,GLOBAL.PROPERTIES.BATTLE_MAGE]Magos de Batalha[/hyperlink] sentam-se à uma mesa redonda entre pilhas de tomos. Os Magos de Batalha voltam-se para {EventHero.FirstName} em uníssono. \"É você quem nos libertará?\" eles dizem antes de se levantarem. Raios faíscam entre eles. \"Aquele digno de nossos segredos?\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1341@BUTTON_0"
msgstr "Mergulhe no caos mágico para destruir o Cabal."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1341@BUTTON_1"
msgstr "Proteja [mana/] seus guerreiros contra as aflições dos feitiços dos Magos."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1341@BUTTON_2"
msgstr "Demonstre seu comando sobre o arcano."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1341@BUTTON_3"
msgstr "Delicie-se com o redemoinho de magia desatada pelos Magos."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1341@BUTTON_4"
msgstr "Fuja do Cabal da Magia e ressele o {EventStructure}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1341@TITLE"
msgstr "Cabal of Casting"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1342@BODY_FOOTER"
msgstr "Um grande {EnemyUnit} irrompe do chão, ameaçando {EventHero.FirstName}. <<p:EventHero>> ficará e lutará, ou fugirá para salvar <<o:EventHero>> vida?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1342@BODY_FOOTER@HERO_IS_PLAYELEA"
msgstr "Um grande {EnemyUnit} irrompe do chão, ameaçando você. Você ficará e lutará, ou fugirá para salvar sua vida?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1342@BODY_HEADER"
msgstr "O {EventStructure} que se ergue sobre {EventHero} e o exército de <<o:EventHero>> é oco e cheio de buracos. Trilhos levam ao tronco cavernoso."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1342@BODY_HEADER@HERO_IS_PLAYELEA"
msgstr "O {EventStructure} que se ergue sobre você e seu exército é oco e cheio de buracos. Trilhos levam ao tronco cavernoso."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1342@BODY_LORE"
msgstr "<<Cp:EventHero>> encontra um {RandomUnit} assustado dentro. De repente, a terra sob <<G:feet^p,{EventHero.FirstName}>> treme. O {RandomUnit} olha para o chão freneticamente... e então desaparece em uma fonte de terra. O tumulto expulsa vermes e criaturas da madeira apodrecida do {EventStructure}, à procura de alimento. O chão então começa a tremer novamente."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1342@BODY_LORE@HERO_IS_PLAYELEA"
msgstr "Você encontra um {RandomUnit} assustado dentro. De repente, a terra sob seus pés treme. O {RandomUnit} olha para o chão freneticamente... e então desaparece em uma fonte de terra. O tumulto expulsa vermes e criaturas da madeira apodrecida do {EventStructure}, à procura de alimento. O chão então começa a tremer novamente."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1342@BUTTON_0"
msgstr "Extermine as pragas que infestam o {EventStructure}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1342@BUTTON_1"
msgstr "Caminhe lentamente e de forma irregular para interromper a <<G:detection^n,EnemyUnit>> do seu exército."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1342@BUTTON_2"
msgstr "Detectar os movimentos subterrâneos da {EnemyUnit}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1342@BUTTON_3"
msgstr "Cultive o <<G:desire to consume^n,EnemyUnit>>:"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1342@BUTTON_4"
msgstr "Afastar-se da {EventStructure} infestada."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1342@TITLE"
msgstr "Wormed Wood"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1343@BODY_FOOTER"
msgstr "A {EventStructure} desabará em breve, permitindo que {EventHero.FirstName} tenha apenas momentos para extrair um último segredo do Cabal of Casting."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1343@BODY_FOOTER@HERO_IS_PLAYELEA"
msgstr "A {EventStructure} desabará em breve, permitindo que você tenha apenas momentos para extrair um último segredo do Cabal of Casting."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1343@BODY_HEADER"
msgstr "Quando o último dos [hyperlink,GLOBAL.PROPERTIES.BATTLE_MAGE]Battle Mages[/hyperlink] cai para o seu exército, todos se levantam novamente, mas não atacam."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1343@BODY_LORE"
msgstr "\"Guardas somos nós,\" declaram as almas do Cabal of Casting. \"Aguardando para conferir nosso conhecimento secreto àquele que foi profetizado como merecedor. Você!\" Naquele momento, inúmeras percepções e lendas inundam {EventHero.FirstName}. O Cabal of Casting, sua profecia finalmente cumprida, desaparece da existência. A {EventStructure} começa a tremer enquanto seu teto ameaça desabar!"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1343@BODY_LORE@HERO_IS_PLAYELEA"
msgstr "\"Guardas somos nós,\" declaram as almas do Cabal of Casting. \"Aguardando para conferir nosso conhecimento secreto àquele que foi profetizado como merecedor. Você!\" Naquele momento, inúmeras percepções e lendas inundam você. O Cabal of Casting, sua profecia finalmente cumprida, desaparece da existência. A {EventStructure} começa a tremer enquanto seu teto ameaça desabar!"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1343@BUTTON_0"
msgstr "Obtenha uma reserva de fragmentos de ligação. [bindingfragments/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1343@BUTTON_1"
msgstr "Aprenda [knowledge/] os segredos proibidos [evilact/] do Cabal."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1343@BUTTON_2"
msgstr "Não deixe os Battle Mages descansarem. Reivindique suas almas. [souls/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1343@BUTTON_3"
msgstr "Drene as energias mágicas [mana/] dos Battle Mages que estão desaparecendo."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1343@TITLE"
msgstr "Cabal of Casting: Consequências"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1344@BODY_FOOTER"
msgstr "Suas tropas coletam as armaduras e armas descartadas. O que mais elas podem reclamar da {EventStructure} antes que os <<m:EnemyUnit>> retornem?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1344@BODY_HEADER"
msgstr "A maioria dos vermes que infestaram a {EventStructure} foram exterminados. A Árvore Murcha pode ser explorada."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1344@BODY_LORE"
msgstr "Armas e armaduras estão semi-enterradas na terra. Esta {EventStructure} era uma armadilha mortal: os próprios campos de caça de colossais <<m:EnemyUnit>>. Essas armaduras descartadas atraíam presas desavisadas, à procura de tesouros antes de serem devoradas pelos <<m:EnemyUnit>>. Já o chão treme novamente enquanto a maior {EnemyUnit} escava através do solo, prestes a reemergir e devorar mais presas."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1344@BUTTON_0"
msgstr "Envie a madeira [structureprod/] que caiu do tronco morto para {EventCity}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1344@BUTTON_1"
msgstr "Armadilhe e domestique [unit/] um dos <<m:EnemyUnit>>."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1344@BUTTON_2"
msgstr "Fashion a {EventItem} [item/] from the dead <<G:chitin^n,EnemyUnit>>."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1344@BUTTON_3"
msgstr "Secure the best armaments for your army to upgrade [xp/] their equipment."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1344@TITLE"
msgstr "Wormed Wood: Aftermath"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1350@BODY_FOOTER"
msgstr "How will you entertain these guests sent by {EventHouseLord.FirstName}?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1350@BODY_HEADER"
msgstr "A land barge from {EventHouse} sails across the <<m:EventGeo>> toward {EventCity}. It transports a group of young warriors of the {EventRace}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1350@BODY_LORE"
msgstr "As a rite of passage, Nomad adolescents are sent out into the world to learn about other Cultures. As one of <<G:allies^p,EventHouse>>, {EventHouseLord} presents <<o:EventHouseLord>> candidates to you. Several <<m:EventUnit>> alight the barge, impressed by your great City."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1350@BUTTON_0"
msgstr "Ask that two <<m:EventUnitB>> [unit/] will stay with you."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1350@BUTTON_1"
msgstr "Take in a {EventUnit} [unit/] as your ward."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1350@BUTTON_2"
msgstr "Request that the <<m:EventUnit>> share some of their combat training. [unitprod/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1350@BUTTON_3"
msgstr "Exchange lore [knowledge/] with the visitors from {EventHouse}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1350@BUTTON_4"
msgstr "Commission [gold/] a feast [happiness/] in honor of your guests."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1350@BUTTON_5"
msgstr "Kill the visitors. [souls/] No one will ever know. [evilact/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1350@BUTTON_8"
msgstr "Be a gracious host, expecting nothing in return. [relationLvl3/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1350@TITLE"
msgstr "<<m:EventUnit>> From Faraway <<Cm:EventGeo>>"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1351@BODY_FOOTER"
msgstr "{EventHouse} seeks to gift you some of the heavier resources they've harvested over time. Which one will you accept from them?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1351@BODY_HEADER"
msgstr "The {EventHouseRace} of {EventHouse} are a nomadic people and should always be ready to migrate. {EventHouseLord} contacts you with a generous offer."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1351@BODY_LORE"
msgstr "They possess some resources they do not wish to take along with them on their next trek. \"Stone and tools that would overencumber our ships. Too many weapons for our soldiers to wield. Books and scrolls that have now been memorized by our <<m:EventUnit>>. We seek to offload these resources to someone we deem trustworthy.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1351@BUTTON_0"
msgstr "Take the stone and tools. [structureprod/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1351@BUTTON_1"
msgstr "Claim the weapons and anvils. [unitprod/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1351@BUTTON_2"
msgstr "Request the books and scrolls. [knowledge/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1351@BUTTON_3"
msgstr "Demand [evilact/] you take the weapons [unitprod/] and tools. [structureprod/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1351@BUTTON_4"
msgstr "Donate [allegiance/] the resources to {EventHouseB}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1351@BUTTON_5"
msgstr "Enchant [mana/] the resources' weight so {EventHouse} can take everything along. [goodact/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1351@TITLE"
msgstr "Risks of Encumbrance"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1357@BODY_FOOTER"
msgstr "Will you wait until the <<m:EventStackLeader>> have finished their survey, or will you try to speed up the process?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1357@BODY_HEADER"
msgstr "An {EventStackLeader} and <<o:EventStackLeader>> companions from {EventHouse} are appraising the {EventStructure} to see if they should strip its resources."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1357@BODY_LORE"
msgstr "Should the {EventStackLeader} deem the {EventStructure} fit for extraction, {EventHouse} may decide to claim it for themselves. As the {EventHouseRace} are wont to do, they would then eventually delve all {EventResource} from it until it is fully depleted. But, given <<G:furrowed brow^n,EventStackLeader>> and the frequency of <<o:EventStackLeader>> sighs, any real interest in this {EventStructure} seems unlikely."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1357@BUTTON_0"
msgstr "Share your insights [knowledge/] of the {EventStructure} to speed up the survey."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1357@BUTTON_2"
msgstr "Pay {EventResource} to {EventHouse}, to gain access to the {EventStructure}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1357@BUTTON_3"
msgstr "Have the {EventStructure} yield some of its resources willingly."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1357@BUTTON_4"
msgstr "Cast an illusion on the {EventStructure} to make it look depleted."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1357@BUTTON_5"
msgstr "Press a claim for this land. Fend off {EventHouse}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1357@BUTTON_6"
msgstr "Allow the {EventHouseRace} from {EventHouse} to resume their appraisal."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1357@TITLE"
msgstr "Fit for Extraction"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1358@BODY_FOOTER"
msgstr "The {EventStackLeader} grins: \"You know. The old paths.\" How will you deal with the Merchant and <<o:EventStackLeader>> bodyguards?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1358@BODY_FOOTER@PLAYER_==_YAKA"
msgstr "The {EventStackLeader} then realizes who <<p:EventStackLeader>> is dealing with and grovels: \"My Lord Yaka! I am but a humble servant!\" How will you deal with the Merchant and <<o:EventStackLeader>> bodyguards?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1358@BODY_HEADER"
msgstr "A {EventStackLeader} from {EventHouse}, guarded by other warriors, has set up a trading post at a {EventStructure}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1358@BODY_LORE"
msgstr "The {EventStackLeader} sizes {SourceStackLeader} up carefully. \"We are all Nomads now,\" <<p:EventStackLeader>> proclaims before leaning in to whisper: \"But some of us still walk the old paths.\" An amulet falls out of the garments of the {EventStackLeader}, which <<p:EventStackLeader>> hastily tucks away again. The amulet resembles an old idol of {GLOBAL.YakaLoreConcept.Hyperlink}. In one of the <<G:tents^p,EventStackLeader>>, several <<m:EventUnit>> are chained to posts."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1358@BODY_LORE@PLAYER_==_YAKA"
msgstr "The {EventStackLeader} sizes {SourceStackLeader} up carefully. \"We are all Nomads now,\" <<p:EventStackLeader>> proclaims before leaning in to whisper: \"But some of us still walk the old paths.\" An amulet falls out of the garments of the {EventStackLeader}, which <<p:EventStackLeader>> hastily tucks away again. The amulet resembles an old idol of {GLOBAL.YakaLoreConcept.Hyperlink}. Of you. In one of the <<G:tents^p,EventStackLeader>>, several <<m:EventUnit>> are chained to posts."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1358@BUTTON_0"
msgstr "Trade food [food/] with the {EventStackLeader} [gold/] to make <<P:EventStackLeader>> depart."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1358@BUTTON_2"
msgstr "Buy [gold/] the <<m:EventUnit>> [unit/] off the {EventStackLeader} to serve [evilact/] you."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1358@BUTTON_3"
msgstr "\"You are violating the laws of {EventHouse}. I will report you promptly.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1358@BUTTON_4"
msgstr "No living creature should be chained by another."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1358@BUTTON_5"
msgstr "Attack the {EventStackLeader} to free the slaves. [goodact/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1358@BUTTON_6"
msgstr "Turn a blind eye to the <<G:mercantile activities^p,{EventStackLeader} >>"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1358@BUTTON_7"
msgstr "\"Loyal servants such as yourself [unit/] should fight for me.\" [evilact/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1358@TITLE"
msgstr "Followers of Old Paths"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1359@BODY_FOOTER"
msgstr "Unless someone intervenes, this battle can know no end. Will {EventHero} step up and harmonize the elements of the {EventStructure}?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1359@BODY_FOOTER@HERO_IS_PLAYELEA"
msgstr "Unless someone intervenes, this battle can know no end. Will you step up and harmonize the elements of the {EventStructure}?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1359@BODY_HEADER"
msgstr "{EventHero} arrives at a {EventStructure}, expecting to quench <<o:EventHero>> thirst. Instead, <<p:EventHero>> is met by hostile <<m:EnemyUnit>> rampaging about."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1359@BODY_HEADER@HERO_IS_PLAYELEA"
msgstr "You arrive at a {EventStructure}, expecting to quench your thirst. Instead, you are met by hostile <<m:EnemyUnit>> rampaging about."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1359@BODY_LORE"
msgstr "An elemental imbalance has dried up the {GLOBAL.STRUCTURES.HIDDEN_WELLSPRING.Hyperlink} that is normally lush with life. On the barren lake bed, various <<m:{GLOBAL.PROPERTIES.ELEMENTAL.Hyperlink}>> lash out against any interlopers. It is a primordial battle to decide what element will persevere and take over the {EventStructure}. {EventHero} witnesses how a {EventUnit} is incinerated by a {EventUnitA}, but then turns into a {EventUnitB} to resume the fight."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1359@BODY_LORE@HERO_IS_PLAYELEA"
msgstr "An elemental imbalance has dried up the {GLOBAL.STRUCTURES.HIDDEN_WELLSPRING.Hyperlink} that is normally lush with life. On the barren lake bed, various <<m:{GLOBAL.PROPERTIES.ELEMENTAL.Hyperlink}>> lash out against any interlopers. It is a primordial battle to decide what element will persevere and take over the {EventStructure}. You witness how a {EventUnit} is incinerated by a {EventUnitA}, but then turns into a {EventUnitB} to resume the fight."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1359@BUTTON_0"
msgstr "Attack the Elementals to restore balance to the {EventStructure}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1359@BUTTON_1"
msgstr "Deharmonize [mana/] the tumultuous nature of the attacking Elementals."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1359@BUTTON_2"
msgstr "Reseed the {EventStructure}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1359@BUTTON_3"
msgstr "Disrupt the {EventGeo} revealed by the drained {EventStructure}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1359@BUTTON_4"
msgstr "Escape the unstable Elements' rage."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1359@TITLE"
msgstr "Dried Up Disarray"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1360@BODY_FOOTER"
msgstr "By restoring balance to the {EventStructure}, it now has a chance to heal. Some Elementals' remains can be repurposed for boons."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1360@BODY_HEADER"
msgstr "{EventHero} has overcome the elemental imbalance caused by the <<G:drought^n,EventStructure>>."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1360@BODY_HEADER@HERO_IS_PLAYELEA"
msgstr "You have overcome the elemental imbalance caused by the <<G:drought^n,EventStructure>>."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1360@BODY_LORE"
msgstr "The hostile <<m:{GLOBAL.PROPERTIES.ELEMENTAL.Hyperlink}>> were warped, twisted, and driven mad by the magical disruption that the dried up Wellspring wrought. Now that their physical manifestations are shattered, the dry lake bed is covered in mana crystals, which {EventHero} gratefully collects."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1360@BODY_LORE@HERO_IS_PLAYELEA"
msgstr "The hostile <<m:{GLOBAL.PROPERTIES.ELEMENTAL.Hyperlink}>> were warped, twisted, and driven mad by the magical disruption that the dried up Wellspring wrought. Now that their physical manifestations are shattered, the dry lake bed is covered in mana crystals, which your warriors dutifully collect."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1360@BUTTON_0"
msgstr "Restore one shattered {RandomElemental} [unit/] to fight for you."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1360@BUTTON_1"
msgstr "Gather the <<G:remains^p,EventUnit>> to fuel <<G:forges^p,EventCity>>. [unitprod/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1360@BUTTON_2"
msgstr "Collect the <<G:remains^p,EventUnitA>> to fertilize <<G:fields^p,EventCity>>. [food/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1360@BUTTON_3"
msgstr "Pick up the <<G:remains^p,EventUnitB>> to build <<G:structures^p,EventCity>>. [structureprod/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1360@BUTTON_4"
msgstr "Drain the <<G:remains^p,EventUnitC>> to boost your majesty. [influence/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1360@TITLE"
msgstr "Dried Up Disarray: Aftermath"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1361@BODY_FOOTER"
msgstr "In the Temple of {EventGod}, the Forsaken <<EventGod{God/Goddess}>>, nothing truly dies. Not forever. How can {EventHero} defend <<r:EventHero>> against <<G:priests^p,{<<EventGod{God/Goddess}>>}>>?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1361@BODY_FOOTER@HERO_IS_PLAYELEA"
msgstr "In the Temple of {EventGod}, the Forsaken <<EventGod{God/Goddess}>>, nothing truly dies. Not forever. How can you defend yourself against <<G:priests^p,EventGod>>?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1361@BODY_HEADER"
msgstr "{EventHero} discovers an {EventStructure} where a long-forgotten <<EventGod{God/Goddess}>> of {EventAttribute} was once worshiped. Timeless oblivion has effectively killed the <<EventGod{God/Goddess}>>."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1361@BODY_HEADER@HERO_IS_PLAYELEA"
msgstr "You discover an {EventStructure} where a long-forgotten <<EventGod{God/Goddess}>> of {EventAttribute} was once worshiped. Timeless oblivion has effectively killed the <<EventGod{God/Goddess}>>."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1361@BODY_LORE"
msgstr "A shrine is built inside the {EventStructure}. {EventHero} wipes the dust and cobwebs from the shrine to learn that this Temple belonged to the god {EventGod} long ago. Yet <<G:presence^n,{EventHero.FirstName}>> involuntarily feeds the dormant eternal flame of {EventGod}, which in turn animates <<EventGod{his/her}>> decayed followers. They rise from the dead to worship their deity and protect <<o:EventGod>> sanctuary once more."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1361@BODY_LORE@HERO_IS_PLAYELEA"
msgstr "A shrine is built inside the {EventStructure}. You wipe the dust and cobwebs from the shrine to learn that this Temple belonged to the god {EventGod} long ago. Yet your presence involuntarily feeds the dormant eternal flame of {EventGod}, which in turn animates <<EventGod{his/her}>> decayed followers. They rise from the dead to worship their deity and protect <<o:EventGod>> sanctuary once more."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1361@BUTTON_0"
msgstr "Attack the priests of the Forsaken <<EventGod{God/Goddess}>>."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1361@BUTTON_1"
msgstr "Make an offering [gold/] to <<G:shrine^n,EventGod>> to receive <<o:EventGod>> favor in combat."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1361@BUTTON_2"
msgstr "Draw power from the revival of the dead."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1361@BUTTON_3"
msgstr "Hallow the {EventStructure}, laying any revived spirits to rest."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1361@BUTTON_4"
msgstr "Depart from the {EventStructure}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1361@TITLE"
msgstr "The Forsaken <<EventGod{God/Goddess}>>"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1362@BODY_FOOTER"
msgstr "<<G:battle^n,{EventHero.FirstName}>> rekindled some of <<G:divine power^n,EventGod>>. <<Cp:EventHero>> may claim the {EventItem} as <<o:EventHero>> prize. And perhaps even take more."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1362@BODY_FOOTER@HERO_IS_PLAYELEA"
msgstr "Your battle rekindled some of <<G:divine power^n,EventGod>>. You may claim the {EventItem} as your prize. And perhaps even take more."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1362@BODY_HEADER"
msgstr "While the resurrected priests of {EventGod} have resumed their sleep of death—for now—{EventHero} inspects the {EventStructure} more closely."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1362@BODY_HEADER@HERO_IS_PLAYELEA"
msgstr "While the resurrected priests of {EventGod} have resumed their sleep of death—for now—you may inspect the {EventStructure} more closely."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1362@BODY_LORE"
msgstr "The Temple to {EventGod} contains many age-old relics and riches. This <<EventGod{God/Goddess}>> of {EventAttribute} must have been an important deity to whatever culture of this realm worshiped <<P:EventGod>> so many years ago. Their history is told in the engravings in stone that cover the walls. A holy light then shines down on the golden shrine, and a {EventItem} appears."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1362@BUTTON_0"
msgstr "Leave the {EventStructure} untouched [influence/] and say a prayer to {EventGod}. [goodact/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1362@BUTTON_1"
msgstr "Siphon whatever remains of the {EventReward} in the {EventStructure}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1362@BUTTON_2"
msgstr "Study the engravings [knowledge/] scrawled on the Temple walls."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1362@BUTTON_3"
msgstr "Call forth the souls [souls/] that forever linger in the Forsaken Temple."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1362@BUTTON_4"
msgstr "Melt down [evilact/] the shrine and golden artifacts. [gold/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1362@TITLE"
msgstr "The Forsaken <<EventGod{God/Goddess}>>: Aftermath"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1363@BODY_FOOTER"
msgstr "A {EnemyUnit} senses the magical aura of {EventHero.FirstName} and turns to <<P:EventHero>> with a roar. Will <<p:EventHero>> risk an assault?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1363@BODY_FOOTER@HERO_IS_PLAYELEA"
msgstr "A {EnemyUnit} senses your magical aura and turns to you with a roar. Will you risk an assault?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1363@BODY_HEADER"
msgstr "{EventHero} stands in the long shadow of a {EventStructure}. Entities feed on the last of its remaining magical energies."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1363@BODY_HEADER@HERO_IS_PLAYELEA"
msgstr "You stand in the long shadow of a {EventStructure}. Entities feed on the last of its remaining magical energies."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1363@BODY_LORE"
msgstr "Where once a {GLOBAL.STRUCTURES.WORLD_TREE.Hyperlink} bloomed, now stands a husk, drained of its magic. The creatures feeding on it are known as {GLOBAL.PROPERTIES.MANA_STARVED.Hyperlink}: profoundly deprived of enchantments and mana, haunted by a limitless hunger to consume magic. They sapped all life and energy from the {EventStructure}, yet still continue to suck the last traces of power from its dry and dead roots."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1363@BODY_LORE@HERO_IS_PLAYELEA"
msgstr "Where once a {GLOBAL.STRUCTURES.WORLD_TREE.Hyperlink} bloomed, now stands a husk, drained of its magic. You recognize the creatures to be {GLOBAL.PROPERTIES.MANA_STARVED.Hyperlink}: thoroughly deprived of magic and mana, driven by a limitless hunger to consume all things magical. They have sapped all life and energy from the {EventStructure}, yet still they continue to drain the dry and dead roots."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1363@BUTTON_0"
msgstr "Attack the {EnemyUnit} and <<o:EnemyUnit>> {GLOBAL.PROPERTIES.MANA_STARVED.Name} host."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1363@BUTTON_1"
msgstr "Cover {EventHero} in mana crystals [mana/] to taunt the {EnemyUnit}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1363@BUTTON_1@HERO_IS_PLAYELEA"
msgstr "Cover yourself in mana crystals [mana/] to taunt the {EnemyUnit}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1363@BUTTON_2"
msgstr "Let your holy might grow your warriors' strength."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1363@BUTTON_3"
msgstr "Feed the {GLOBAL.PROPERTIES.MANA_STARVED.Name} creatures corrupted magic."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1363@BUTTON_4"
msgstr "Flee the {EventStructure}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1363@TITLE"
msgstr "Sapped and Fractured"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1364@BODY_FOOTER"
msgstr "Even without its sappers, the {EventStructure} is too dangerous a place to stay. What should {EventHero} salvage before leaving?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1364@BODY_FOOTER@HERO_IS_PLAYELEA"
msgstr "Even without its sappers, the {EventStructure} is too dangerous a place to stay. What should you salvage before leaving?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1364@BODY_HEADER"
msgstr "Your army finally bested the {EnemyUnit} and the other {GLOBAL.PROPERTIES.MANA_STARVED.Hyperlink} creatures, driven mad by their craving for magic."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1364@BODY_LORE"
msgstr "<<G:troops^p,EventHero>> pack up the <<G:head^n,EnemyUnit>> to be mounted above your seat in {EventCity}. Meanwhile, {EventHero.FirstName} gazes upon the {EventStructure} to take in the utter devastation, spotting a {EventItem} lodged in the drained wood. Madness is all that remains here. And yet... Witnessing the ferocity and strength of the {GLOBAL.PROPERTIES.MANA_STARVED.Hyperlink} makes you wonder if it may lead your {EventRace} to greatness."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1364@BODY_LORE@HERO_IS_PLAYELEA"
msgstr "Your troops pack up the <<G:head^n,EnemyUnit>> to be mounted above your seat in {EventCity}. Meanwhile, you gaze upon the {EventStructure} to take in the utter devastation, spotting a {EventItem} lodged in the drained wood. Madness is all that remains here. And yet... witnessing the ferocity and strength of the {GLOBAL.PROPERTIES.MANA_STARVED.Hyperlink} makes you wonder if it may lead your {EventRace} to greatness."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1364@BUTTON_0"
msgstr "Dislodge the {EventItem} [item/] from the trunk of the {EventStructure}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1364@BUTTON_1"
msgstr "Steel your army's resolve against the {GLOBAL.PROPERTIES.MANA_STARVED.Name} onslaught."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1364@BUTTON_2"
msgstr "Praise [xp/] <<G:tenacity^n,EventHero>> in battle."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1364@BUTTON_2@HERO_IS_PLAYELEA"
msgstr "Celebrate [xp/] your prowess in battle."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1364@BUTTON_3"
msgstr "Sacrifice your magic to turn your {EventRace} {GLOBAL.PROPERTIES.MANA_STARVED.Name}. [knowledge/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1364@BUTTON_4"
msgstr "Study the aberrant magic [knowledge/] of the {GLOBAL.PROPERTIES.MANA_STARVED.Hyperlink} entities."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1364@TITLE"
msgstr "Sapped and Fractured: Aftermath"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1171_4500@BODY_FOOTER"
msgstr "Casting <<m:{GLOBAL.WorldMapSpellConcept.Hyperlink}>> will build up to a {GLOBAL.CataclysmConcept.Hyperlink}. But perhaps there are ways to mitigate this crisis."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1171_4500@BODY_HEADER"
msgstr "The winds roar with hunger. This realm is being affected by the {GLOBAL.FracturingWindsConcept.Hyperlink}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1171_4500@BODY_LORE"
msgstr "The breeze siphons and redirects magic from everything it passes through. Should a great surge of magic flood it, the winds would wreak havoc, bringing dire consequences for spellcasters and the landscape of the realm."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1171_4500@TITLE"
msgstr "The Devouring Winds"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1171_4501@BUTTON_0"
msgstr "Investigate this phenomenon."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1197@BODY_FOOTER"
msgstr "The voice of the winds compels you to approach the <<m:{GLOBAL.FractureLoreConcept.Hyperlink}>>. How will you prepare?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1197@BODY_HEADER"
msgstr "Your troops reach the barren plateau while the devouring winds flow with great strength. They sound strange here, like a susurrant voice talking inwards."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1197@BODY_LORE"
msgstr "The region is overrun with Fractures, floating shards of ruins orbiting around them. Suddenly the winds begin whispering: \"Come to us. Draw near to the [hyperlink,GLOBAL.FractureLoreConcept]Fractures[/hyperlink] and you shall gain knowledge and power beyond your imagination. Fools fear what they do not understand; the wise seek to comprehend it.\" As the gust sweeps, the air crackles with sparks of refracting energy. Magic is extremely volatile here."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1197@BUTTON_0"
msgstr "Let the winds pull [hp/] your troops towards [movementgeneral/] the Fractures."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1197@BUTTON_3"
msgstr "The winds cannot be trusted, shield [mana/] your troops [resistance/] from them."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1197@BUTTON_4"
msgstr "Continue at your own pace."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1197@TITLE"
msgstr "Ascending to the Crackling Mesa"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1198@BODY_FOOTER"
msgstr "\"Activate the sigils to bind the complex back together. Protect it, and I will reveal more secrets of [hyperlink,GLOBAL.UnmakersLoreConcept]these wizards[/hyperlink]. Beware, for the energy surge will attract fractured beasts.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1198@BODY_HEADER"
msgstr "An ancient magical complex exists only as drifting fragments beyond access, caught in orbit around a {GLOBAL.FractureLoreConcept.Hyperlink}. The wind-born voice sounds louder here:"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1198@BODY_LORE"
msgstr "\"The great minds who raised this place succeeded in creating an almost perfect echo of [hyperlink,GLOBAL.TheWellLoreConcept]The Well Of Creation[/hyperlink]. The powers and knowledge of the {GLOBAL.AllfatherLoreConcept.Hyperlink} were within their grasp. Thus, they split open this magical essence that held the secrets of creation and... It was void. So void that it engulfed us all and drained the world of its very existence, unleashing [hyperlink,GLOBAL.TheFracturingLoreConcept]the cataclysm[/hyperlink].\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1198@BUTTON_1"
msgstr "Activate the sigils, protect the place. [knowledge/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1198@BUTTON_2"
msgstr "Activate the sigils and pillage [unitprod/] the area [item/] before the beasts arrive."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1198@BUTTON_4"
msgstr "Abandon the ruins."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1198@TITLE"
msgstr "Crackling Mesa: Splitting of Essence"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1200@BODY_FOOTER"
msgstr "The voice of the winds reverberates in fury: \"Looters, foolish vermin. Kill them, and I shall reveal where the secrets of this place lie hidden.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1200@BODY_HEADER"
msgstr "Around the ominous {GLOBAL.FractureLoreConcept.Hyperlink}, inaccessible pieces of a shattered building float adrift. The voice carried by the winds roar: \"Activate the sigils to bind it back.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1200@BODY_LORE"
msgstr "As your troops ready themselves to follow your command, a band of Nomads emerges. Their leader takes a hostile stance and shouts: \"Wanderer, you do not understand the forces you are meddling with. Do not listen to the voices of the devils of the wind. Leave this place before it is too late for all of us—this is your only warning.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1200@BUTTON_1"
msgstr "Activate the sigils and face the nomads. [knowledge/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1200@BUTTON_2"
msgstr "Awaken the sigils and entice [gold/] the nomads to stand with you [unit/]."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1200@BUTTON_4"
msgstr "Leave the place for now."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1200@TITLE"
msgstr "Crackling Mesa: Conflict of Voices"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1202@BODY_FOOTER"
msgstr "\"Activate the sigils to bind back the library and eradicate the fractured archivists, for they will eventually awaken in madness and destroy everything here.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1202@BODY_HEADER"
msgstr "A ruined library floats around the {GLOBAL.FractureLoreConcept.Hyperlink}, full of sigils, books written in codex, and dormant <<m:{EventUnit}>>. The voice of the winds resonates loudly:"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1202@BODY_LORE"
msgstr "\"Great is the tragedy of the knowledge lost in [hyperlink,GLOBAL.TheFracturingLoreConcept]the great cataclysm[/hyperlink]. Ages have passed, and still no one has discovered that the {GLOBAL.AstralFlowsLoreConcept.Hyperlink} are reversed near the fractures. And that, like any current, they can be navigated and diverted. No one has dared to gaze again into the void of creation. But those who tried... Documented everything. Obey me, and I shall teach you how to decipher their code.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1202@BUTTON_1"
msgstr "Activate the sigils and take down the archivists. [knowledge/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1202@BUTTON_2"
msgstr "Leave the library for now."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1202@BUTTON_5"
msgstr "Activate the sigils, appraise [knowledge/] the books to sell them [gold/], and leave."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1202@TITLE"
msgstr "Crackling Mesa: Inverted Flows"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1204@BODY_FOOTER"
msgstr "A colossal Fracture has manifested at the heart of the Crackling Mesa. And from it, a figure emerges... The figure of an [hyperlink,GLOBAL.UnmakersLoreConcept]Unmaker[/hyperlink]."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1204@BODY_HEADER"
msgstr "When you activate the third sigil, the very air begins to tremble. The three [hyperlink,GLOBAL.FractureLoreConcept]Fractures[/hyperlink] crackle with energy, drawing in powerful devouring winds."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1204@BODY_LORE"
msgstr "These currents surge toward the fissures, siphoning the energy of everything in their path. The Fractures swell as they feed on this power—and then, suddenly, they implode, releasing the devouring winds that are pulled toward the center of the region. When the gusts converge, a massive Fracture reappears, restoring a fragment of the plateau it once consumed."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1204@BUTTON_0"
msgstr "Approach the Unmaker."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1204@TITLE"
msgstr "Crackling Mesa: Echos of the Fracturing"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1206@BODY_FOOTER"
msgstr "The Great Fracture remains open. With the Unmakers' {GLOBAL.ArtifactConcept.Hyperlink}, you might draw something out from the other side before sealing it."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1206@BODY_FOOTER@UNMAKER_ALLY"
msgstr "As the Unmaker leaves, the Great Fracture remains open. With the {GLOBAL.ArtifactConcept.Hyperlink}, you might draw something out from the other side before sealing it."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1206@BODY_HEADER"
msgstr "{EventHero} lies defeated at last. Once again, <<o:EventHero>> abilities fell short of <<o:EventHero>> arrogance. From his hand slips an object, the {EventRelic}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1206@BODY_HEADER@UNMAKER_ALLY"
msgstr "{EventHero} looks at you, as if finally seeing you for the first time. The Unmaker raises an object in his hand—the {EventRelic}. His voice rings out:"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1206@BODY_LORE"
msgstr "The intricate compass radiates negative energy. The devouring winds pass through the artifact before rushing toward the Great Fracture, as though it were redirecting them. It seems {EventHero} used the energy and alignment of the sigils you activated to create one himself and return... from the other side of the fracture. Now that power rests in your hands."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1206@BODY_LORE@UNMAKER_ALLY"
msgstr "\"A great feat indeed, to discern the voice of knowledge amid the cries of the ignorant. My word binds me, {PlayerLeader}. Here is your reward.\" The intricate compass radiates negative energy. The devouring winds pass through the artifact before rushing toward the Great Fracture, as though it were redirecting them. It seems {EventHero} used the energy and alignment of the sigils you activated to create one himself and return... From the other side of the fracture."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1206@BUTTON_0"
msgstr "Seal the Fracture and redirect the mana [mana/] to your empire."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1206@BUTTON_3"
msgstr "Bring a battalion of fractured beings [unit/] under your command."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1206@BUTTON_4"
msgstr "Bring back a whole city [citytier1/] from the Unmakers. (NOT FUNCTIONAL)"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1206@BUTTON_5"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1206@BUTTON_6"
msgstr "Bring forth a Fractured Tower [siteGold/] where the Unmakers once conducted their experiments."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1206@TITLE"
msgstr "Crackling Mesa: Aftermath"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1233@BODY_FOOTER"
msgstr "One of the Unmakers has returned through a Fracture, and now challenges all who dare to oppose <<P:EventHero>>."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1233@BODY_HEADER"
msgstr "The figure beside the great Fracture turns, <<o:{EventHero}>> empty gaze cuts straight through you. <<Co:{EventHero}>> voice—one you have heard before in the winds—claims:"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1233@BODY_LORE"
msgstr "\"Knowledge is power, traveler. That is why we were punished, because the power of even the {GLOBAL.AllfatherLoreConcept.Hyperlink} was within our reach. But not even his unjust punishment could stop me. The one the myths speak of has returned! I, {EventHero}, who has stared back to the void of creation, claim this realm and all that lies within it. Come then—bring your worst!\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1233@BUTTON_0"
msgstr "Prepare to fight the Unmaker."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1233@BUTTON_1"
msgstr "I fulfilled your every demand; I do not stand against you. [influence/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1233@TITLE"
msgstr "Crackling Mesa: Herald of the Fracturing"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1333@BODY_FOOTER"
msgstr "What will you do with all this power? Will you embrace it—or free this realm from its yoke?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1333@BODY_HEADER"
msgstr "As you claim the {LAST_ARTIFACT}, the other artifacts begin to crackle. Bolts of negative energy coil out from them imbuing you with their power."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1333@BODY_LORE"
msgstr "The energy courses through you from head to toe, your eyes blaze like beacons of hollow flame, and you feel your body drawing magic from the very air. For just an instant, you can feel it—a power so vast it could change the realm. A power that could defy existence itself. In that moment, that seems to last forever, you must make a choice."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1333@BUTTON_0"
msgstr "Unleash the power of the Fractures as their herald."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1333@BUTTON_1"
msgstr "Redirect the energy to heal the Fractures of the realm."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1333@BUTTON_2"
msgstr "Cast off the energy, releasing the power [mana/]. You will safeguard the {GLOBAL.ArtifactConcept.Hyperlink} as their guardian [influence/] [allegiance/]."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1333@TITLE"
msgstr "Echoes of the Fracturing: Hubris of the Unmakers"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1383@BODY_FOOTER"
msgstr "This world is lost. {PlayerLeader} has achieved the {GLOBAL.CataclysmVictoryConcept.Hyperlink}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1383@BODY_FOOTER@PLAYER_IS_HERALD"
msgstr "If you retain all three <<m:{GLOBAL.ArtifactConcept.Hyperlink}>>, you will achieve victory in 5 turns. You will lose the Artifacts if {PlayerLeader} is defeated in combat."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1383@BODY_HEADER"
msgstr "The entire realm trembles. You can feel a brutal disturbance ripple through the Astral Sea. {PlayerLeader} has gathered the Unmakers' artifacts and embraced their power."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1383@BODY_HEADER@PLAYER_IS_HERALD"
msgstr "The entire realm trembles. You can feel the brutal disturbance you have unleashed upon the Astral Sea. You have gathered the Unmakers' artifacts and embraced their power."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1383@BODY_LORE"
msgstr "The Devouring Winds roar with fury. Their new master summons them, and they answer the call. Storms of negative energy begin to darken the skies.<<m:{GLOBAL.FractureLoreConcept.Hyperlink}>> erupt across the land. The magical balance of the realm has been shattered, a new Fracturing is imminent."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1383@BODY_LORE@PLAYER_IS_HERALD"
msgstr "The Devouring Winds roar with fury. Their new master summons them, and they answer your call. Storms of negative energy begin to darken the skies.<<m:{GLOBAL.FractureLoreConcept.Hyperlink}>> tear open everywhere. The magical balance of the realm has been shattered, a new Fracturing is about to occur. Others will attempt to stop you before you consume the realm."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1383@BUTTON_0"
msgstr "Leave the realm."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1383@BUTTON_0@PLAYER_IS_HERALD"
msgstr "The end is near."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1383@BUTTON_1"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1383@BUTTON_2"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1383@TITLE"
msgstr "Echoes of the Fracturing: Fractured Realm"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1384@BODY_FOOTER"
msgstr "Soon there will be no cataclysm or hubris to torment this realm, and {PlayerLeader} will be empowered by the tribes. Does this serve your interests?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1384@BODY_FOOTER@PLAYER_IS_HERALD"
msgstr "Soon there will be no cataclysm or hubris to torment this realm."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1384@BODY_HEADER"
msgstr "The wind falls still, and a strange calm settles over the realm. {PlayerLeader} has gathered the Unmakers' artifacts and is using their power to heal the world."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1384@BODY_HEADER@PLAYER_IS_HERALD"
msgstr "The wind falls still, and a strange calm settles over the realm. You have gathered the Unmakers' artifacts and are using their power to heal the world."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1384@BODY_LORE"
msgstr "The <<m:{GLOBAL.FractureLoreConcept.Hyperlink}>> that scar this barren land begin to wane, shrinking in both number and size. The [hyperlink,GLOBAL.AstralFlowsLoreConcept]Astral Currents[/hyperlink] flow once more through the world, filling it with life. The nomadic tribes sense the change and flock in great numbers to their savior. Their prophecy of the Mender of the Fractured Age is becoming true."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1384@BUTTON_0"
msgstr "It is in your hands to support the healing of this realm... or its destruction."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1384@BUTTON_0@PLAYER_IS_HERALD"
msgstr "The mending is near."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1384@BUTTON_1"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1384@BUTTON_2"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1384@TITLE"
msgstr "Echoes of the Fracturing: Mender of the Fractures"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1385@BODY_FOOTER"
msgstr "Something, deep within the Astral Sea, calls out to you... With a mere gesture, you open a colossal Fracture to cross it."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1385@BODY_HEADER"
msgstr "The entire realm trembles. You can feel a brutal disturbance ripple through the {GLOBAL.AstralSeaLoreConcept.Hyperlink}. You have finally gathered the Unmakers' artifacts and embraced their power."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1385@BODY_LORE"
msgstr "The Devouring Winds roar with fury. Their new master summons them, and they answer your call. Storms of negative energy begin to darken the skies. <<m:{GLOBAL.FractureLoreConcept.Hyperlink}>> tear open everywhere. Before you, empires kneel amid the remnants of a world consumed by your ambition. All the magic of the realm now courses through your veins. Yet, it is not enough. Even greater power lies within your reach."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1385@BUTTON_0"
msgstr "You are the Herald of the Fracturing, nothing and no one will stand in your way."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1385@BUTTON_1"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1385@BUTTON_2"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1385@TITLE"
msgstr "Echoes of the Fracturing: A New Herald"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1386@BODY_FOOTER"
msgstr "Your path here is not yet finished; your legend still has verses left unwritten."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1386@BODY_HEADER"
msgstr "You have held the artifacts till the {GLOBAL.CataclysmConcept.Hyperlink} was cleansed. You have become the supreme savior of this realm."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1386@BODY_HEADER@PLAYER_IS_NOT_HE"
msgstr "{PlayerLeader} held the artifacts till the {GLOBAL.CataclysmConcept.Hyperlink} was cleansed. <<Cp:{PlayerLeader}>> has become the supreme savior of this realm."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1386@BODY_LORE"
msgstr "With the support of the nomads, you have united the roaming tribes under your rule. Vegetation will bloom once more, animals will return to these lands. And in one very, very distant day, all the suffering and destruction caused by {GLOBAL.TheFracturingLoreConcept.Hyperlink} will be nothing more than a tale. One passed down through generations, to remember that long ago, a great {EventPlayerType} brought peace and life back to this world."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1386@BODY_LORE@PLAYER_IS_NOT_HE"
msgstr "Vegetation will bloom once more, animals will return to these lands. And in one very, very distant day, all the suffering and destruction caused by {GLOBAL.TheFracturingLoreConcept.Hyperlink} will be nothing more than a tale. One passed down through generations, to remember that long ago, a great {EventPlayerType} brought peace and life back to this world."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1386@BUTTON_0"
msgstr "Continue your story."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1386@BUTTON_1"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1386@BUTTON_2"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1386@TITLE"
msgstr "Echoes of the Fracturing: Healed Realm"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1430@BODY_FOOTER"
msgstr "\"We know how to reward those who aid us, wanderers. Will you raise your sword to purge the curse of the [hyperlink,GLOBAL.FractureLoreConcept]hollowing winds[/hyperlink]?\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1430@BODY_FOOTER@PLAYER_FRACTURED"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1430@BODY_HEADER"
msgstr "Your troops come upon the waters of an underground oasis. Its shores are crowded with Nomads, steel at hand."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1430@BODY_LORE"
msgstr "\"Halt, wanderers!\" a voice shouts. Leading a band of warriors, a proud chieftain steps forward. \"I am {EventHero} of the {EventTribe}, and this is the last oasis of the realm. You do not look like rotters, perhaps we can help one another. Those Undone abominations at the other side of the lake are poisoning our animals, our scarce waters, and our people, condemning them to the same fate they suffer.\" <<Co:EventHero>> face hardens into a mask of hatred as <<p:EventHero>> adds: \"I will not see another friend die.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1430@BODY_LORE@PLAYER_FRACTURED"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1430@BUTTON_0"
msgstr "\"Point me to those rabid dogs.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1430@BUTTON_1"
msgstr "\"I will meet with the cursed ones on my own terms.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1430@BUTTON_3"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1430@TITLE"
msgstr "Cursed Shores of the Great Worm Lake"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1431@BODY_FOOTER"
msgstr "The prisoner awaits your verdict. What will you do with <<P:{EventUnit}>>?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1431@BODY_HEADER"
msgstr "Some Nomads lie before you, while others flee to regroup. Your troops have managed to capture an {EventUnit}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1431@BODY_LORE"
msgstr "It does not take long for the prisoner to speak: \"What would you have done, {PlayerLeader}? If your pastures, your livestock, and your kin were sickened by the Undones? What would you have done if you watched your children die of thirst or madness? Perhaps we should be judged for our actions—but you are not one to pass that judgment.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1431@BUTTON_0"
msgstr "Spare <<o:{EventUnit}>> life in exchange for some of <<o:{EventUnit}>> loot. [gold/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1431@BUTTON_1"
msgstr "Execute <<P:{EventUnit}>> [evilact/] for all <<o:{EventUnit}>> loot. [gold/] [item/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1431@BUTTON_2"
msgstr "\"If it is green pastures [food/] you seek, you shall find them under my rule.\" [unit/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1431@TITLE"
msgstr "Great Worm Lake: Judge and Jury"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1432@BODY_FOOTER"
msgstr "Will you save the life of this {EventUnit} so he can fight you another day? Or loot <<P:EventUnit>>?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1432@BODY_HEADER"
msgstr "After the clash, your troops find a travel journal on a dying {EventUnit}. The final entry reads:"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1432@BODY_LORE"
msgstr "\"After another cycle of the stars, we return to the Great Worm Lake. Now the last oasis. Legends of our tribe speak of this place as a paradise. They tell of a great worm, mother of all others and protector of the desert. But everything the cursed gods touched fell undone. They experimented on the Great Mother and her brood, seeking answers to questions that should never have been asked. The Great Mother now lies in the water, her offspring vanished.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1432@BUTTON_0"
msgstr "Heal <<o:{EventUnit}>> wounds. [goodact/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1432@BUTTON_1"
msgstr "Loot <<P:{EventUnit}>>. [gold/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1432@TITLE"
msgstr "Great Worm Lake: Lost Paradise"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1436@BODY_FOOTER"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1436@BODY_HEADER"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1436@BODY_LORE"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1436@BUTTON_0"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1436@TITLE"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1437@BODY_FOOTER"
msgstr "\"We must destroy them, or nothing will remain of us. My troops will aid you, {PlayerLeader}. I must prepare to bring down that beast.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1437@BODY_HEADER"
msgstr "The Undone withdraw—their weakened forces can no longer hold the territory. But suddenly, a violent tremor shakes the subterranean lake."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1437@BODY_HEADER@SIDED_WITH_UNDON"
msgstr "The Nomads withdraw—their weakened forces can no longer hold the territory. But suddenly, a violent tremor shakes the subterranean lake."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1437@BODY_LORE"
msgstr "A gargantuan beast rises at the center of the oasis. A Fractured Worm, vast as a city roars with hunger. And with her, her brood erupts from the earth, devouring everything in their path. Nomads and Undone alike are swallowed by the worms' maws. {EventHero} stares in disbelief. \"It can't be. The Great Worm died, but one of its deformed daughters survived the experiments, and she has never stopped growing.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1437@BODY_LORE@SIDED_WITH_UNDON"
msgstr "A gargantuan beast rises at the center of the oasis. A Fractured Worm, vast as a city roars with hunger. And with her, her brood erupts from the earth, devouring everything in their path. Nomads and Undone alike are swallowed by the worms' maws. {EventHero} looks on, shaken. \"Not even the Great Worm shows us mercy... To arms! Hunger knows no sides. It is breeding season—it's them or us!\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1437@BUTTON_0"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1437@BUTTON_1"
msgstr "Face the Great Worm."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1437@TITLE"
msgstr "Great Worm Lake: Awakening"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1440@BODY_FOOTER"
msgstr "\"Our tamed beast will be at your disposal. But what else can we do to repay this debt?\" asks the chieftain of the Nomads."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1440@BODY_FOOTER@SIDED_WITH_UNDON"
msgstr "\"Our tamed beast will be at your disposal. But what else can we do to repay this debt?\" asks the chieftain of the Undone."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1440@BODY_HEADER"
msgstr "The last of the hatchlings falls, and the Great Worm roars in grief and fury. Harpooned by the Nomads, the beast bleeds profusely."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1440@BODY_HEADER@SIDED_WITH_UNDON"
msgstr "The last of the hatchlings falls, and the Great Worm roars in grief and fury. Harpooned by the Undone, the beast bleeds profusely as it retreats."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1440@BODY_LORE"
msgstr "As the beast retreats, the blue blood falls into the oasis, creating bubbling pools. The downpour hits {EventHero}, and the corruption takes hold at once. <<Co:EventHero>> body rapidly changes—turning <<P:EventHero>> into one of the Undone. <<Co:EventHero>> anguished scream echoes across the lake: \"No! The oasis has been purged, and I will never see it bloom again.\" Seeing their tribe gather around, <<p:EventHero>> grows calm, recalling <<o:EventHero>> duty. \"I must depart in eternal penance. But my tribe owes you a great debt, {PlayerLeader}.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1440@BODY_LORE@SIDED_WITH_UNDON"
msgstr "From her wounds, streams of blue blood spills across the oasis, forming vast pools of bubbling fluid. \"Do not go near them!\" cries the voice of {EventHero}, chieftain of the Undone. \"The Great Worm has been devouring mana for generations, strengthening the Unmakers' curse. Its blood is so powerful that it would curse and transform anyone who touched it. I would not have our savior suffer our fate.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1440@BUTTON_0"
msgstr "\"My cities need to grow, your people will finally have a place to call home.\" [population/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1440@BUTTON_0@SIDED_WITH_UNDON"
msgstr "\"Tell me the myth of the Great Worm, and how it came to be.\" [knowledge/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1440@BUTTON_3"
msgstr "\"Teach me to commune with the power of the <<m:{EventUnit}>>.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1440@BUTTON_3@SIDED_WITH_UNDON"
msgstr "\"Teach me to commune with the power of the <<m:{EventUnit}>>.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1440@BUTTON_4"
msgstr "\"May your people spread the tales of the {PlayerLeader.TitleName}.\" [influence/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1440@BUTTON_5"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1440@TITLE"
msgstr "Great Worm Lake: Aftermath"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1470@BODY_FOOTER"
msgstr "\"My name is {EventHero}, and in the name of my people, I ask for your aid. We seek only to live out the time we have left in peace.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1470@BODY_HEADER"
msgstr "Your troops come upon the waters of an underground oasis. Its shores are crowded with warped Nomads, steel at hand."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1470@BODY_LORE"
msgstr "\"Who are you, who walk the land of the cursed?\" A figure with hollow eyes pushes through the diseased. \"You do not bear the mark of the Undone, nor the hatred of the {EventTribe}. You may traverse this sacred place, now dimmed by the war that rages across its waters and along its shores. Nevertheless, you cannot stay, for the place and we ourselves carry a plague that devours the mind and soul. If you defend us, however, we would not hesitate to reward you generously, wanderers.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1470@BUTTON_0"
msgstr "\"I will free you from those who pursue you.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1470@BUTTON_1"
msgstr "\"It is too soon to choose sides.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1470@BUTTON_3"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1470@TITLE"
msgstr "Sacred Shores of the Great Worm Lake"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1476@BODY_FOOTER"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1476@BODY_HEADER"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1476@BODY_LORE"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1476@BUTTON_0"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1476@BUTTON_1"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1476@BUTTON_3"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1498@BODY_FOOTER"
msgstr "The scrap of papyrus is rapidly deteriorating. Will you retrieve the scroll or pursue the fleeing Undone?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1498@BODY_HEADER"
msgstr "After the battle, your troops corner one of the Undone against the lake. With <<o:EventUnit>> hands raised, <<p:EventUnit>> begins to slowly back away, chanting a litany:"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1498@BODY_LORE"
msgstr "\"This place is sacred. The Great Worm brought us here. In its waters we bathe in communion with her. She protects us from all harm—she will protect us from the intruders.\" With a sudden movement, the Undone throws <<r:EventUnit>> into the contaminated lake and begins to swim away. A scroll surfaces, seemingly dropped from <<o:EventUnit>> grasp. You can make out ancient engravings of a great, twisted worm."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1498@BUTTON_0"
msgstr "Save the scroll. [knowledge/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1498@BUTTON_1"
msgstr "Practice some target shooting. [evilact/] [xp/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1498@TITLE"
msgstr "Great Worm Lake: Found Paradise"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1499@BODY_FOOTER"
msgstr "\"My head... No... I need my bag... Mana... Please.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1499@BODY_HEADER"
msgstr "The defeated Undones lie before you. Your troops have captured one of them, clutching a heavy satchel of mana."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1499@BODY_LORE"
msgstr "<<Co:EventUnit>> sobs echo as <<p:EventUnit>> speaks: \"Have we not suffered enough? They call us Undone, devoided, rotten. They hunt us, for the sole crime of wanting to keep living. We withdrew to the oasis to contain it, yet they still persecuted us. Are we not even allowed to... Die in... P-peace?.\" You can see the fracture in <<o:EventUnit>> skull spreading."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1499@BUTTON_0"
msgstr "Give <<P:{EventUnit}>> the bag. [goodact/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1499@BUTTON_1"
msgstr "Keep the mana. [mana/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1499@BUTTON_2"
msgstr "\"I could supply you with mana [mana/] and safety under my empire.\" [unit/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1499@TITLE"
msgstr "Great Worm Lake: Sin of Living"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_805@BODY_FOOTER"
msgstr "(WIP)"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_805@BODY_HEADER"
msgstr "The Hero has come to open the barrier(WIP)"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_805@BODY_LORE"
msgstr "Magic magic(WIP)"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_805@BUTTON_0"
msgstr "Lets gooo(WIP)"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_805@TITLE"
msgstr "Danger (WIP)"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_808@BODY_FOOTER"
msgstr "It seems the Unmakers were trying to replicate the Well of Creation. But what went wrong?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_808@BODY_HEADER"
msgstr "As you excavate the final area, a {EventStructure} rises before you. Mana crystals pierce its frame, contaminated by the negative energy."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_808@BODY_LORE"
msgstr "A lifeless hand protrudes from the rubble, clutching a journal as the final proof of its existence. Reading through it you find a passage: \"More [hyperlink,GLOBAL.FractureLoreConcept]Fractures[/hyperlink] are appearing, but the experiments are promising. We may create an infinite source of energy, a Tear from {GLOBAL.TheWellLoreConcept.Hyperlink}. We're so close; we just need to isolate and condense mana into its purest form. We must hurry to be the first, rumors say the experiment has already succeeded in another realm.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_808@BUTTON_0"
msgstr "Press on to the tower, if there are answers, they lie there."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_808@TITLE"
msgstr "Core of Contamination: The Source"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_811@BODY_FOOTER"
msgstr "The air quivers around the fractured humanoids; their very presence warps the fabric of magic itself. Suddenly, they turn toward you drawn by your magic."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_811@BODY_HEADER"
msgstr "After clearing away rubble and soil, you uncover a {GLOBAL.STRUCTURES.FRACTURED_INFESTATION.Hyperlink}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_811@BODY_LORE"
msgstr "Humanoids, or what remains of them, wander through the area. Their twisted bodies radiate the same energy as the cracks in the ground. \"Misshapen abominations... If you linger too long near a Fracture, you'll end up like them,\" whispers {EventHero}. \"That is why our people are cursed to wander forever, because of the arrogance of the {GLOBAL.UnmakersLoreConcept.Hyperlink}.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_811@BUTTON_0"
msgstr "Ready your troops to move."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_811@TITLE"
msgstr "Core of Contamination: Infestation"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_813@BODY_FOOTER"
msgstr "Large shipments of crystallized mana lie scattered across the site, all pointing toward the source of the contamination."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_813@BODY_HEADER"
msgstr "As you excavate the area, you uncover a disturbing scene: collapsed buildings, half-disintegrated bones, fissures and crystals that emit a frightening energy, which pull in your troops from their inside."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_813@BODY_LORE"
msgstr "\"These are ruins,\" says {EventHero}. \"Ruins of the civilization that existed before {GLOBAL.TheFracturingLoreConcept.Hyperlink}. [hyperlink,GLOBAL.UnmakersLoreConcept]Those who condemned this realm[/hyperlink] to be devoured by itself. In this city, as in many others, they sought to create something. They experimented with the very origin of magic. And through their arrogance, they tore the fabric of both magic and reality.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_813@BUTTON_0"
msgstr "Continue your path, following the fissures."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_813@TITLE"
msgstr "Core of Contamination: Ruins"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_814@BODY_FOOTER"
msgstr "The source of the contamination is close, you can sense it just beyond the next layer of earth. What were they trying to create with so much mana?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_814@BODY_HEADER"
msgstr "You excavate the next area. The further you go, the more mana crystals surround you, dim, contaminated, lifeless."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_814@BODY_LORE"
msgstr "The tainted fissures begin to converge toward their source. The energy emanating from them is so intense that you can feel it trying to pull something out from within you. Your troops feel it too, their magic wanes quickly, their enchantments require constant renewal. The energy is draining your mana. How can an energy drain? Whatever experiment the Unmakers conducted... They did it here."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_814@BUTTON_0"
msgstr "Prepare your troops to dig."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_814@TITLE"
msgstr "Core of Contamination: Hazard"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_821@TITLE"
msgstr "Fracture Tower (WIP)"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_835@BODY_FOOTER"
msgstr "\"My tribe... We are the descendants of the Unmakers,\" says {TribeHero} in shock. \"My duty is not over {EventHero}, I shall always guard this place, by your side\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_835@BODY_HEADER"
msgstr "The {EventRelic} lies before {EventHero}, finally disconnected from the {EventStructure}, stopping the source of contamination. You see {TribeHero} pick up a journal from the ground."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_835@BODY_LORE"
msgstr "<<Cp:TribeHero>> reads: \"A surge of negative magic from the Astral Sea has struck us. We believe an experiment went terribly wrong in another realm. The surge has triggered a chain reaction. The Fractures are erupting, devouring everything in their path. We are trying to shut the experiment down but it is too late, we must seal the city... With ourselves inside. A few will escape, vowing to guard this place forever. They will be called the... {TribeName}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_835@BUTTON_10"
msgstr "Gather as many journals [knowledge/] as you can."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_835@BUTTON_3"
msgstr "Collect the experimental equipment [item/] of the mages."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_835@BUTTON_9"
msgstr "Synchronize with the fractured energy at your own risk [hp/]."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_835@TITLE"
msgstr "Core of Contamination: Aftermath"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_836@BODY_FOOTER"
msgstr "It seems that some {GLOBAL.DragonsLoreConcept.Hyperlink} aided [hyperlink,GLOBAL.UnmakersLoreConcept]The Unmakers[/hyperlink] to create the {EventRelic}. And that their carcasses roam this place."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_836@BODY_HEADER"
msgstr "The {EventStructure} swallows energy from the surroundings, feeding something at its core. The pull is so strong that your troops are being depleted of mana."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_836@BODY_LORE"
msgstr "{EventHero} crosses the threshold of the structure. Lifting <<o:EventHero>> gaze to the heart of the tower, <<p:EventHero>> sees it: a miniature [hyperlink,GLOBAL.TheWellLoreConcept]Well of Creation[/hyperlink], the {EventRelic}. Starved for ages, stands a {EventUnit}, a majestic creature that once bore a name of its own, now driven mad by the devouring energy. The mages who were trapped within rise beside it, the remnants of the Unmakers."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_836@BUTTON_0"
msgstr "Put an end to this experiment."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_836@BUTTON_1"
msgstr "Send troops [unitprod/] to collapse part of the tower onto the Fractured beings."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_836@BUTTON_2"
msgstr "Draw protective mana [mana/] sigils on your troops."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_836@BUTTON_3"
msgstr "Stabilize the mana of your troops."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_836@BUTTON_4"
msgstr "Retreat."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_836@BUTTON_5"
msgstr "Tap into the cracks of the {EventStructure}, collapsing it over your enemies."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_836@TITLE"
msgstr "Core of Contamination: Fractured Tower"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_868@TITLE"
msgstr "Echoes of the Fracturing: Devouring Winds"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_869@BODY_FOOTER"
msgstr "Whether you seek the origin or the power of the [hyperlink,GLOBAL.FractureLoreConcept]Fractures[/hyperlink], you will find what you covet in the Fated Regions."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_869@BODY_HEADER"
msgstr "Both wind and wanderers whisper the same tales: legends of a world-shattering calamity long past."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_869@BODY_LORE"
msgstr "These tales speak of places where devouring energies converge, lands that existed long before [hyperlink,GLOBAL.TheFracturingLoreConcept]the Fracturing[/hyperlink]. To the nomadic tribes of {EventRealm}, they are forbidden territory, perilous places full of secrets best left undiscovered. Each fable tells of an {GLOBAL.ArtifactConcept.Hyperlink} of immense power and arrogance, and of a legend claiming that whoever unites three will be able to heal the world... Or to rule it."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_869@BUTTON_0"
msgstr "Venture into {EventRealm}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_869@TITLE"
msgstr "Echoes of the Fracturing: The Fated Regions"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_110@BODY_FOOTER"
msgstr "Driven by madness, the {EventUnit} raises the {EventRelic.NoLink}: \"Come! Fight me, {PlayerLeader}! I know you want this—over my dead body!\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_110@BODY_HEADER"
msgstr "With <<o:EventUnit>> ghostly host reassembled, the {EventUnit} marches out to complete <<o:EventUnit>> unending siege of {EventCityName}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_110@BODY_LORE"
msgstr "Yet the deeper <<p:EventUnit>> ventures into the ruined city, the more discontented the {EventUnit} grows. \"Where are those spell-slinging dastards!?\" <<p:EventUnit>> shouts angrily, searching for opposition. At last the {EventUnit} reaches the central crater, silent memorial of {GLOBAL.TheFracturingLoreConcept.Hyperlink}. Guided by some ghostly intuition <<p:EventUnit>> plunges into the rubble, soon after returning with a radiant object. \"What sorcery is this? This cannot be, unless...\" The {EventUnit} gazes directly at you, piercing the Astral veil. \"You!\" <<p:EventUnit>> screams, \"you are an [hyperlink,GLOBAL.UnmakersLoreConcept]Unmaker[/hyperlink], {PlayerLeader}!\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_110@BUTTON_0"
msgstr "Unmaker or not, you will put <<o:EventUnit>> deranged spirit to rest."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_110@TITLE"
msgstr "Phantom Hills: A Mad Truth"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_112@BODY_FOOTER"
msgstr "The {EventUnit} hands over the {EventRelic}: \"The {GLOBAL.UnmakersLoreConcept.Hyperlink}, they trapped the waters of creation. Yet when they sought to release rain, they unleashed a deluge.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_112@BODY_HEADER"
msgstr "As <<o:EventUnit>> spirit is about to violently perish, the {EventUnit} is able to finally see the truth."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_112@BODY_LORE"
msgstr "\"<<C:{GLOBAL.TheFracturingLoreConcept.Hyperlink}>>!\" <<p:EventUnit>> calls out in dismay, as if <<p:EventUnit>> was reliving the last moments of <<o:EventUnit>> distant life. \"All these years—this eternity—I have been... dead.\" The {EventUnit} sheathes <<o:EventUnit>> weapon. \"I bow to your might and valor, {PlayerLeader},\" <<p:EventUnit>> exclaims. \"You have ended my vengeful curse and liberated my soldiers. May they all find their peace, at last.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_112@BUTTON_0"
msgstr "Before <<p:EventUnit>> vanishes, ask the spirit for <<o:EventUnit>> mark of the {EventUnit}. [xp/][renown/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_112@BUTTON_3"
msgstr "Claim the siege engines [unit/] of the dissipating host."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_112@BUTTON_4"
msgstr "Spread the legend of the {EventUnit} to inspire instructors [unitprod/] across your realm."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_112@BUTTON_5"
msgstr "Share the tale of the Phantom Hills with the {GLOBAL.EternalSagesLoreConcept.Name}. [allegiance/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_112@BUTTON_6"
msgstr "Bind <<o:EventUnit>> spirit to your will [unit/], in eternal servitude. [evilact/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_112@TITLE"
msgstr "Phantom Hills: Aftermath"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_82@BODY_FOOTER"
msgstr "Caught in a long-gone past, the {EventUnit} commands your troops to prepare for the siege of an already ruined [hyperlink,GLOBAL.UnmakersLoreConcept]Unmaker[/hyperlink] bastion."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_82@BODY_HEADER"
msgstr "Entering a fractured wasteland, your troops espy ghostly apparitions straying on the hills. One of them, a formidable {EventUnit}, bars the way."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_82@BODY_LORE"
msgstr "\"Reinforcements, at last!\" <<p:EventUnit>> calls out with brisk fervor. \"Those damned {GLOBAL.UnmakersLoreConcept.Hyperlink} have halted our advance for too long, their unstable magics wreaking havoc left and right. They messed up my soldiers' minds, disabled our siegecraft, infiltrated our positions...\" The {EventUnit} pauses for a moment, maybe realizing <<o:EventUnit>> words won't inspire much confidence. \"With your arrival, the tide has turned. By {EventGodirName}, we will breach their defenses before their magic experiments blast the whole darn realm to oblivion!\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_82@BUTTON_0"
msgstr "Let them follow <<o:EventUnit>> delusional orders, for now."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_82@BUTTON_3"
msgstr "Persuade [influence/] the {EventUnit} to drill your troops [xp/] first."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_82@TITLE"
msgstr "Climbing the Phantom Hills"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BODY_FOOT@FRACTURE_1_DONE"
msgstr "Nothing can be done here anymore."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BODY_FOOT@FRACTURE_2_DONE"
msgstr "Nothing can be done here anymore."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BODY_FOOT@FRACTURE_3_DONE"
msgstr "Nothing can be done here anymore."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BODY_FOOTER"
msgstr "The {EventAnimal} and their horde of wasteland dwellers have infested the <<m:EventStackLeader>>."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BODY_FOOTER@GOLEM_REPAIRED"
msgstr "The <<m:EventStackLeader>> are ready to be employed."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BODY_HEADER"
msgstr "Approaching the inactive siege machines marked by the {EventUnit}, your troops start to hear a multitude of clicking and hissing noises."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BODY_HEADER@FRACTURE_1_DONE"
msgstr "Your troops return to the {GLOBAL.FractureLoreConcept.Hyperlink} in the magic complex."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BODY_HEADER@FRACTURE_2_DONE"
msgstr "Your troops return to the {GLOBAL.FractureLoreConcept.Hyperlink} where you found the nomads."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BODY_HEADER@FRACTURE_3_DONE"
msgstr "Your troops return to the {GLOBAL.FractureLoreConcept.Hyperlink} in the library."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BODY_HEADER@GOLEM_REPAIRED"
msgstr "Your troops return to the smoldering <<m:EventStackLeader>>."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BODY_LORE"
msgstr "Carefully observing from a distance, they notice blurry movements within the metallic carcasses of the <<m:EventStackLeader>>. At last a large {EventAnimal} comes forward, assuming an aggressive posture, while the clickety-clack of <<o:EventAnimal>> scissors echoes down the hills.[br/][br/]It is clear that these wasteland creatures, attracted by the still emanated heat of the <<m:EventStackLeader>>—or their scorpion guise—have made the abandoned siege machines their shelter."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BODY_LORE@FRACTURE_1_DONE"
msgstr "The place remains calm, its sigils still glowing with power."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BODY_LORE@FRACTURE_2_DONE"
msgstr "The place remains calm, its sigils still glowing with power."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BODY_LORE@FRACTURE_3_DONE"
msgstr "The place remains calm, its sigils still glowing with power."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BODY_LORE@GOLEM_REPAIRED"
msgstr "The siege machines barely move or make a sound. But the heat from their molten cores warms up the surroundings."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BUTTON_0"
msgstr "Flee, for now."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BUTTON_0@GOLEM_REPAIRED"
msgstr "Leave."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BUTTON_1"
msgstr "Fight off the wasteland creatures."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BUTTON_2"
msgstr "Lure them away with an abundance of food. [food/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BUTTON_4"
msgstr "Bond with the {EventAnimal} and become their new <<PlayerLeader{Sire/Matriarch}>>."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BUTTON_5"
msgstr "Ignite the <<m:EventStackLeader>> with life, incinerating the creatures."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@TITLE"
msgstr "Phantom Hills: Repurposed Constructs"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_91@BODY_FOOTER"
msgstr "\"The will of our {EventUnit} holds us captive,\" the {EventStackLeader} ends <<o:EventStackLeader>> tale. \"We are hapless ghosts, forever chained to a lost purpose.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_91@BODY_FOOTER@MORALE_RESTORED"
msgstr "The host is ready to assault {EventCityName}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_91@BODY_HEADER"
msgstr "On this hill, the lonely ghost of a {EventStackLeader} lingers. As your troops approach, <<p:EventStackLeader>> starts to mumble."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_91@BODY_HEADER@MORALE_RESTORED"
msgstr "Returning to the hill, your troops find the ghostly host rallied around the {EventStackLeader}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_91@BODY_LORE"
msgstr "\"We were positioning all battalions on these hills,\" <<p:EventStackLeader>> speaks with a stale voice, \"ready to descend upon the {GLOBAL.UnmakersLoreConcept.Hyperlink}. But too late...\" The stare of the <<EventStackLeader{man/woman}>> intensifies. \"In a flash of teal lightning the city and all its surroundings became torn apart—torn within. We all perished in {GLOBAL.TheFracturingLoreConcept.Hyperlink}. But it was not the end.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_91@BODY_LORE@MORALE_RESTORED"
msgstr "Their long lines of armed phantasmal shapes invoke a sense of wonder and terror at once. No eagerness or zeal prevails in their weathered faces, only the fatigue of serving their {EventUnit} for a thousand lifetimes."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_91@BUTTON_0"
msgstr "Leave <<P:EventStackLeader>>, for now."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_91@BUTTON_0@MORALE_RESTORED"
msgstr "Leave."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_91@BUTTON_1"
msgstr "\"I shall teach you to obey the commands of your {EventUnit} beyond death!\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_91@BUTTON_2"
msgstr "\"Friendship and loyalty [influence/] can outlast death. March and your lost purpose will be fulfilled.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_91@BUTTON_4"
msgstr "\"Rally your troops one last time, and I pledge you shall find peace.\" [goodact/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_91@BUTTON_5"
msgstr "\"The fallen do not question. The fallen obey power.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_91@TITLE"
msgstr "Phantom Hills: Will of the Warlord"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_94@BODY_FOOTER"
msgstr "The {EventStackLeader} is feeding on your mana. Whatever information the {EventUnit} is after, you should try to attain it quickly."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_94@BODY_FOOTER@SPY_INTERROGATED"
msgstr "There is nothing more to be learned from this {EventStackLeader}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_94@BODY_HEADER"
msgstr "Entering the prison pit of the ghostly encampment, your troops shudder at the sight of the locked-in \"spy.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_94@BODY_HEADER@SPY_INTERROGATED"
msgstr "With great caution your troops return to the imprisoned {EventStackLeader}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_94@BODY_LORE"
msgstr "\"More questions?\" the entity's mouth asks, while your men gaze into the abyss of its fractured head. \"It's high time. I've been starving... To talk.\" As the entity speaks you sense an astral pull, its very presence draining your magic. \"Ahh,\" it sighs in relief, \"such pleasant... Company. If only I could return to {EventCityName}. With my people... Our {EventRelic.NoLink}, my hunger would cease.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_94@BODY_LORE@SPY_INTERROGATED"
msgstr "<<Cp:EventStackLeader>> seems to have entered a trance-like state, as if the answers you found emptied <<o:EventStackLeader>> mind. Even the astral pull you sensed earlier appears to have subsided, for now."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_94@BUTTON_0"
msgstr "Flee from the mana drain, for now."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_94@BUTTON_0@SPY_INTERROGATED"
msgstr "Leave."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_94@BUTTON_1"
msgstr "Confront the entity's shattered memories, reliving {GLOBAL.TheFracturingLoreConcept.Name}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_94@BUTTON_2"
msgstr "Grapple the broken mind [knowledge/] of the {EventStackLeader} to reave <<o:EventStackLeader>> knowledge."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_94@BUTTON_4"
msgstr "Squeeze every droplet of mana out of the {EventStackLeader} until <<p:EventStackLeader>> squeals."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_94@BUTTON_5"
msgstr "Feed the {EventStackLeader} with an abundance of mana [mana/] to mellow <<o:EventStackLeader>> answers."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_94@TITLE"
msgstr "Phantom Hills: Fractured Memories"

msgid "DLC@RISEFROMRUIN@TERRAINDEFINITIONS_STRATEGIC@ASTRAL_BARRENS@COMBAT_PROPERTY@DESCRIPTION"
msgstr "<<m:{GLOBAL.CombatSpellConcept.Hyperlink}>> have a {percentage} chance of {GLOBAL.BackfireConcept.Hyperlink}.[br/][br/]In addition, several Astral Fracture obstacles are present which are {GLOBAL.DrainingConcept.Hyperlink} and duplicate whenever a {GLOBAL.CombatSpellConcept.Hyperlink} is cast."

msgid "DLC@RISEFROMRUIN@TERRAINDEFINITIONS_STRATEGIC@ASTRAL_BARRENS@NAME"
msgstr "Astral Barrens"

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@PASSIVE@DESCRIPTION"
msgstr "Able to build <<m:{GLOBAL.FarmConcept.Hyperlink}>> on Sand terrain.[br/][br/]<<m:{GLOBAL.FarmConcept.Hyperlink}>> on Sand terrain gain +{amount} {GLOBAL.FoodConcept.Hyperlink} if your race has Desert Adaptation."

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@PASSIVE@NAME"
msgstr "Desert Farming"

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@PASSIVE_STABILITY@DESCRIPTION"
msgstr "<<m:{GLOBAL.ProvinceConcept.Hyperlink}>> with Sand give +{amount} {GLOBAL.CityStabilityConcept.Hyperlink}."

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@PASSIVE_STABILITY@NAME"
msgstr "Sand Preference"

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@SKILL1@DESCRIPTION"
msgstr "Summon a {GLOBAL.UNITS.SAND_SCORPION.Hyperlink}, a {GLOBAL.PROPERTIES.SHIELD_UNIT.Hyperlink} unit with a debilitating poison."

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@SKILL1@NAME"
msgstr "Summon Sand Scorpion"

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@SKILL2@DESCRIPTION"
msgstr "Target and adjacent <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> on the surface gain {GLOBAL.SandConcept.Hyperlink}."

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@SKILL2@NAME"
msgstr "Desertification"

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@SKILL3@DESCRIPTION"
msgstr "Target race becomes one with the desert, granting them:[bulletlist][bullet/]{GLOBAL.PROPERTIES.SAND_WALK.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.SAND_CAMOUFLAGE.Hyperlink}[bullet/]When on {GLOBAL.SandConcept.Hyperlink} terrain gain:[bulletlist][bullet/]Very Fast Movement in combat.[bullet/]+{amount}% {GLOBAL.FlankingConcept.Hyperlink} damage.[/bulltlist][/bulltlist]"

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@SKILL3@MOD_DESCRIPTION"
msgstr "Unit deals +{DUNESTALKERS_FLANK_DAMAGE>ResolvedMultiplier}% damage when {GLOBAL.FlankingConcept.Hyperlink}."

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@SKILL3@NAME"
msgstr "Dunestalkers"

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@SKILL3@PROP_DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]{GLOBAL.PROPERTIES.SAND_WALK.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.SAND_CAMOUFLAGE.Hyperlink}[bullet/]When on {GLOBAL.SandConcept.Hyperlink} terrain gain:[bulletlist][bullet/]Very Fast Movement in combat.[bullet/]+{amount}% {GLOBAL.FlankingConcept.Hyperlink} damage.[/bulltlist][/bulltlist]"

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@SKILL4@DESCRIPTION"
msgstr "Conjure a {GLOBAL.SandstormConcept.Hyperlink} in a {SANDSTORM_POSITION_TARGETER_CIRCLE>AREA>Radius}-hex radius that lasts for {SANDSTORM_PLACE_MARKER>Duration} <<m:{GLOBAL.TurnConcept}>>."

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@SKILL4@MARKER_DESCRIPTION"
msgstr "Units passing through or ending their turn on this hex:[bulletlist][bullet/]Have a base {chance}% chance of becoming {GLOBAL.PROPERTIES.BLINDED.Hyperlink} for {amount} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Become {GLOBAL.PROPERTIES.SLOWED.Hyperlink} for {amount} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][br/]Units with {GLOBAL.PROPERTIES.SAND_WALK.Hyperlink} are immune to this effect."

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@SKILL4@MARKER_HYPERLINK"
msgstr "[hyperlink,GLOBAL.SandstormConcept]Sandstorm[/hyperlink]"

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@SKILL4@NAME"
msgstr "Sandstorm"

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@SKILL5@DESCRIPTION"
msgstr "{GLOBAL.MeleeConcept.Hyperlink} attacks of enchanted units gain:[bulletlist][bullet/]A base {WEAKENED_RESISTANCE>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.WEAKENED.Hyperlink} for {WEAKENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]A base {POISONED_RESISTANCE>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.POISONED.Hyperlink} for {POISONED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]+{SCORPION_VENOM_BLADES_FLANKING_DAMAGE>DAMAGE>Blight} {GLOBAL.BlightDamageConcept.Hyperlink} when flanking.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@SKILL5@NAME"
msgstr "Scorpion Venom Blades"

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@SKILL5@PROP_DESCRIPTION"
msgstr "{GLOBAL.MeleeConcept.Hyperlink} attacks have:[bulletlist][bullet/]A base {WEAKENED_RESISTANCE>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.WEAKENED.Hyperlink} for {WEAKENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]A base {POISONED_RESISTANCE>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.POISONED.Hyperlink} for {POISONED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]+{SCORPION_VENOM_BLADES_FLANKING_DAMAGE>DAMAGE>Blight} {GLOBAL.BlightDamageConcept.Hyperlink} when flanking.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@SPI@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{amount1} {GLOBAL.GoldConcept.Hyperlink} income.[bullet/]Per adjacent {GLOBAL.ProvinceConcept.Hyperlink} with {GLOBAL.SandConcept.Hyperlink}:[bulletlist][bullet/]+{amount2} {GLOBAL.GoldConcept.Hyperlink}.[bullet/]+{amount3} {GLOBAL.FoodConcept.Hyperlink}.[/bulletlist][bullet/]Counts as a {GLOBAL.MineConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@SPI@NAME"
msgstr "[mine/] Grand Bazaar"

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Spread deserts, stalk and blind your enemies, and summon a Guardian of the Desert to protect you."

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@TOME@LORE_DESCRIPTION"
msgstr "\"Most call the desert a perilous place, a death trap without water, food or shelter. We call it home. We are the mirage in the heat, we are the raiders in the wind. Our steel stings with venom, kindred with the scorpion. We are the ones that call the sandstorm. We are the Sand Stalkers.\""

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@TOME@NAME"
msgstr "Tome of the Sand Stalkers"

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@UNIT@ABILITY01@DESCRIPTION"
msgstr "Target enemy unit:[bulletlist][bullet/]Sustains damage.[bullet/]Gains {amount1} {GLOBAL.PROPERTIES.WEAKENED.Hyperlink} for {WEAKENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Gains {amount2} {GLOBAL.PROPERTIES.POISONED.Hyperlink} for {POISONED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][br/]Enter {GLOBAL.DefenseModeConcept.Hyperlink}."

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@UNIT@ABILITY01@NAME"
msgstr "Debilitating Sting"

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@UNIT@ABILITY02@DESCRIPTION"
msgstr "Move to target hex."

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@UNIT@ABILITY02@NAME"
msgstr "Sand Shift"

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@UNIT@ABILITY02@PROP_DESCRIPTION"
msgstr "Unit gains {GLOBAL.PROPERTIES.SAND_SHIFT.Hyperlink} when on {GLOBAL.SandConcept.Hyperlink} terrain."

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@UNIT@NAME"
msgstr "Sand Scorpion^n"

msgid "DLC@RISEFROMRUIN@TOME_WARBAND@ABILITY01@DESCRIPTION"
msgstr "Target enemy unit and all units of that type gain:[bulletlist][bullet/]{amount} {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink} for {SUNDERED_DEFENSE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]{amount} {GLOBAL.PROPERTIES.SUNDERED_RESISTANCE.Hyperlink} for {SUNDERED_RESISTANCE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@TOME_WARBAND@ABILITY01@NAME"
msgstr "Discern Weakness"

msgid "DLC@RISEFROMRUIN@TOME_WARBAND@ABILITY02@DESCRIPTION"
msgstr "[bulletlist][bullet/]When this unit attacks, a random friendly unit within {LIEUTENANTS_LEAD_ON_ATTACK_JUMP>MaxDistance} hexes gains {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} for {STRENGTHENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]When this unit enters {GLOBAL.DefenseModeConcept.Hyperlink}, a random friendly unit within {LIEUTENANTS_LEAD_ON_DEFENSE_MODE_JUMP>MaxDistance} hexes gains {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink} and {GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink} for {BOLSTERED_DEFENSE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@TOME_WARBAND@ABILITY02@NAME"
msgstr "Lieutenant's Lead"

msgid "DLC@RISEFROMRUIN@TOME_WARBAND@SKILL1@DESCRIPTION"
msgstr "A {GLOBAL.PROPERTIES.FIGHTER.Hyperlink} unit that empowers others in battle through their own actions."

msgid "DLC@RISEFROMRUIN@TOME_WARBAND@SKILL1@NAME"
msgstr "Lieutenant"

msgid "DLC@RISEFROMRUIN@TOME_WARBAND@SKILL2@DESCRIPTION"
msgstr "Target owned city:[bulletlist][bullet/]Gains {amount1} {GLOBAL.UnitProductionConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@TOME_WARBAND@SKILL2@NAME"
msgstr "Training Regimen"

msgid "DLC@RISEFROMRUIN@TOME_WARBAND@SKILL3@BUFF_DESCRIPTION"
msgstr "Unit gains +{MENTORSHIP_XP_PER_TURN>XP} {GLOBAL.ExperienceConcept.Hyperlink} per {GLOBAL.WorldMapConcept.Hyperlink} {GLOBAL.TurnConcept}."

msgid "DLC@RISEFROMRUIN@TOME_WARBAND@SKILL3@DESCRIPTION"
msgstr "All heroes under your control gain:[bulletlist][bullet/]While army leader, the non-Hero unit with the least {GLOBAL.ExperienceConcept.Hyperlink} in the army gains +{amount} {GLOBAL.ExperienceConcept.Hyperlink} per {GLOBAL.WorldMapConcept.Hyperlink} {GLOBAL.TurnConcept}.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@TOME_WARBAND@SKILL3@NAME"
msgstr "Mentorship"

msgid "DLC@RISEFROMRUIN@TOME_WARBAND@SKILL3@PROP_DESCRIPTION"
msgstr "While army leader, the non-Hero unit with the least {GLOBAL.ExperienceConcept.Hyperlink} in the army gains +{MENTORSHIP_XP_PER_TURN>XP} {GLOBAL.ExperienceConcept.Hyperlink} per {GLOBAL.WorldMapConcept.Hyperlink} {GLOBAL.TurnConcept}."

msgid "DLC@RISEFROMRUIN@TOME_WARBAND@SKILL4@DESCRIPTION"
msgstr "Transformed units become stronger and more battle ready gaining:[bulletlist][bullet/]+{BRED_FOR_WAR_HP>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[bullet/]+{BRED_FOR_WAR_MORALE_RESIST>ResolvedMoraleDropModifier}% {GLOBAL.UnitMoraleConcept.Hyperlink} resistance to morale loss, plus +{BRED_FOR_WAR_MORALE_RESIST>ResolvedMoraleDropModifier}% for each adjacent friendly unit.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@TOME_WARBAND@SKILL4@NAME"
msgstr "Bred for War"

msgid "DLC@RISEFROMRUIN@TOME_WARBAND@SKILL4@PROP_DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]+{BRED_FOR_WAR_HP>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[bullet/]+{BRED_FOR_WAR_MORALE_RESIST>ResolvedMoraleDropModifier}% {GLOBAL.UnitMoraleConcept.Hyperlink} resistance to morale loss, plus +{BRED_FOR_WAR_MORALE_RESIST>ResolvedMoraleDropModifier}% for each adjacent friendly unit.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@TOME_WARBAND@SKILL5@DESCRIPTION"
msgstr "Friendly units in a {COMMANDERS_CALL_TARGETER>AREA>Radius}-hex radius:[bulletlist][bullet/]Heal {COMMANDERS_CALL_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>[bullet/]Gain {COMMANDERS_CALL_CHANGE_MORALE>Morale Change Absolute} {GLOBAL.UnitMoraleConcept.Hyperlink}[/bulletlist]"

msgid "DLC@RISEFROMRUIN@TOME_WARBAND@SKILL5@NAME"
msgstr "Commander's Call"

msgid "DLC@RISEFROMRUIN@TOME_WARBAND@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Build strong martial armies and mentor your units through the ranks."

msgid "DLC@RISEFROMRUIN@TOME_WARBAND@TOME@LORE_DESCRIPTION"
msgstr "\"Magic is fickle; you can only trust your strength. Here you learn to hold a weapon before the age of seven, for at seven you stand watch. You turn war drills into your games; your pastimes are hunting your own food and winning pit fights. Our lieutenant says that we shall never know peace, for we were bred for war.\""

msgid "DLC@RISEFROMRUIN@TOME_WARBAND@TOME@NAME"
msgstr "Tome of the Warband"

msgid "DLC@RISEFROMRUIN@TOME_WARBAND@UNIT@NAME"
msgstr "Lieutenant^m"

msgid "DLC@RISEFROMRUIN@TOME_WARLORD@ABILITY01@DESCRIPTION"
msgstr "+{WAR_VETERAN>ResolvedCritChanceBonus}% {GLOBAL.CriticalHitConcept.Hyperlink} chance."

msgid "DLC@RISEFROMRUIN@TOME_WARLORD@ABILITY01@NAME"
msgstr "War Veteran"

msgid "DLC@RISEFROMRUIN@TOME_WARLORD@ABILITY02@DESCRIPTION"
msgstr "On unit kill, reset the cooldowns of all Command abilities."

msgid "DLC@RISEFROMRUIN@TOME_WARLORD@ABILITY02@NAME"
msgstr "Command Momentum"

msgid "DLC@RISEFROMRUIN@TOME_WARLORD@ABILITY03@DESCRIPTION"
msgstr "This unit ends its turn and goes into a defensive mode:[bulletlist][bullet/]Extends its {GLOBAL.ZoneOfControlConcept.Hyperlink} to all adjacent hexes.[bullet/]Gains +{HOLD_YOUR_GROUND_DEFENSE_INCREASE>DEF_MOD>Armor} {GLOBAL.DefenseConcept.Hyperlink}.[bullet/]Gains +{HOLD_YOUR_GROUND_DEFENSE_INCREASE>DEF_MOD>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}.[bullet/]Immune to {GLOBAL.FlankingConcept.Hyperlink}.[bullet/]All adjacent friendly units gain +{HOLD_YOUR_GROUND_DEFENSE>DEF_MOD>Armor} {GLOBAL.DefenseConcept.Hyperlink}.[bullet/]All adjacent friendly units gain +{HOLD_YOUR_GROUND_DEFENSE>DEF_MOD>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}.[bullet/]All adjacent friendly units gain {GLOBAL.PROPERTIES.CHARGE_RESISTANCE.Hyperlink}.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@TOME_WARLORD@ABILITY03@NAME"
msgstr "Defense Mode: Hold your Ground"

msgid "DLC@RISEFROMRUIN@TOME_WARLORD@ABILITY03@PROP_DESCRIPTION"
msgstr "This unit has:[bulletlist][bullet/]+{HOLD_YOUR_GROUND_DEFENSE>DEF_MOD>Armor} {GLOBAL.DefenseConcept.Hyperlink}[bullet/]+{HOLD_YOUR_GROUND_DEFENSE>DEF_MOD>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.CHARGE_RESISTANCE.Hyperlink}[/bulletlist]"

msgid "DLC@RISEFROMRUIN@TOME_WARLORD@ABILITY03@PROP_NAME"
msgstr "Hold your Ground"

msgid "DLC@RISEFROMRUIN@TOME_WARLORD@ABILITY04@DESCRIPTION"
