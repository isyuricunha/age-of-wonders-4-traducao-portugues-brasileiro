msgid "DIPLOMATICSTATES_DEFINITIONS@ALLOWCLAIMEDSECTORS@DESCRIPTION"
msgstr "Ambos <<m:{GLOBAL.LeaderConcept.Hyperlink}>> podem construir nas [hyperlink,GLOBAL.ClaimConcept]reclamadas[/hyperlink] <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> um do outro sem desencadear <<m:{GLOBAL.CasusBelliConcept.Hyperlink}>>."

