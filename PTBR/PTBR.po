msgid "DLC@RISEFROMRUIN@RUINED_WONDER_EVENT_BUTTONS@WORLD_TREE_THUNDERED"
msgstr "Empunhe o <<G:relâmpago^n,EventUnit>> [mana/] para despedaçar o {EventStructure}. [structureprod/]"

msgid "DLC@RISEFROMRUIN@RUINED_WONDER_EVENT_BUTTONS@WORLD_TREE_THUNDERED_KNOWLEDGE"
msgstr "Empunhe o <<G:relâmpago^n,EventUnit>> [knowledge/] para despedaçar o {EventStructure}. [structureprod/]"

msgid "DLC@RISEFROMRUIN@SECTORDEFINITIONS_STRATEGIC@ASTRAL_BARRENS_FEATURE@DESCRIPTION"
msgstr "A {GLOBAL.ProvinceFeatureConcept.Hyperlink}.[br/][br/]Estas terras foram erodidas por um vento que arranca todas as formas de magia de todos e de tudo.[br/][bulletlist][bullet/]{GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> não regeneram <<m:{GLOBAL.HitPointConcept.Hyperlink}>> nesta província.[bullet/]<<m:{GLOBAL.WorldMapSpellConcept.Hyperlink}>> e <<m:{GLOBAL.CombatSpellConcept.Hyperlink}>> lançados nesta província ganham {percentage} de chance de {GLOBAL.BackfireConcept.Hyperlink}.[bullet/]Nenhuma renda de {GLOBAL.ManaConcept.Hyperlink} pode ser obtida nesta Província.[bullet/]<<m:{GLOBAL.NodeConcept.Hyperlink}>> na província tornam-se [hyperlink,GLOBAL.RuinedNodeConcept]Arruinado[/hyperlink].[bullet/]Nós Arruinados não podem ser restaurados enquanto esta província tem Astral Barrens.[bullet/]O terreno não pode ser alterado pela maioria dos feitiços e efeitos.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@SECTORDEFINITIONS_STRATEGIC@MAGIC_EROSION@DESCRIPTION"
msgstr "Esta unidade está sendo afetada por estar em {GLOBAL.AstralBarrensConcept.Hyperlink} e, portanto, não regenera <<m:{GLOBAL.HitPointConcept.Hyperlink}>> no mapa-múndi."

msgid "DLC@RISEFROMRUIN@SECTORDEFINITIONS_STRATEGIC@MAGIC_EROSION@NAME"
msgstr "Erosão Mágica"

