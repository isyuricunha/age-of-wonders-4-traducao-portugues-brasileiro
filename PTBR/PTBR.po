msgid "TOME_HERALDS_DOOM@SKILL1@NAME"
msgstr "Causar Desespero"

msgid "TOME_HERALDS_DOOM@SKILL2@DESCRIPTION"
msgstr "Invoca uma {GLOBAL.UNITS.BANSHEE_UNIT.Hyperlink}, um espírito vingativo que reduz a moral e enfraquece inimigos com seus gritos penetrantes."

