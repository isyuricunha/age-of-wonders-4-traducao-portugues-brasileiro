msgstr "Invoca um {GLOBAL.UNITS.MORNING_SPRITE.Hyperlink} {GLOBAL.PROPERTIES.SUPPORT_UNIT.Hyperlink} ou um {GLOBAL.UNITS.EVENING_SPRITE.Hyperlink} {GLOBAL.PROPERTIES.BATTLE_MAGE.Hyperlink}."

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_SPRITE@SKILL1@DIALOG_SUBHEADER_DEFAULT"
