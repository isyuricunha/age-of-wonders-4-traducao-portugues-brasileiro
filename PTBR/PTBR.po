msgid "TOME_DEMON_GATE@SKILL2@DESCRIPTION"
msgstr "Alveje um dos seus {GLOBAL.IndependentCityConcept.Hyperlink} <<m:{GLOBAL.PvEVassalConcept.Hyperlink}>>:[bulletlist][bullet/]Invocar {summon} aleatório <<m:{GLOBAL.PROPERTIES.FIEND.Hyperlink}>> sob seu controle, um será Nível III e o outro Nível IV.[bullet/]O {GLOBAL.PvEVassalConcept.Hyperlink} perde:[bulletlist][bullet/]Um estágio diplomático {GLOBAL.VassalagePhaseConcept.Hyperlink}.[bullet/]{pop} {GLOBAL.PopulationConcept.Hyperlink}.[/bulletlist][/bulletlist][br/]Não pode ser usado em um {GLOBAL.PactOfVassalageLvl-3Concept.Hyperlink}."

msgid "TOME_DEMON_GATE@SKILL2@NAME"
msgstr "Invocação Demoníaca"

msgid "TOME_DEMON_GATE@SKILL3@DESCRIPTION"
msgstr "Dois {GLOBAL.PROPERTIES.FIEND.Hyperlink} unidades do mesmo Nível no exército alvo lutam entre si. Uma morre e a outra se transforma em um {GLOBAL.PROPERTIES.FIEND.Hyperlink} com um Nível um degrau acima do anterior."

msgid "TOME_DEMON_GATE@SKILL3@DIALOG_SUBHEADER"
