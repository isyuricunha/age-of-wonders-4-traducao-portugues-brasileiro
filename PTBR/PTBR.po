msgid "TOME_SOULS@HERO_SKILL@DESCRIPTION"
msgstr "Ataques básicos ganham:[bulletlist][bullet/]Infligem {GLOBAL.PROPERTIES.SOULBOUND.Hyperlink}[bullet/]Base de {REMORSE_RESISTANCE>ResolvedStrength}% de chance de infligir {GLOBAL.PROPERTIES.REMORSE.Hyperlink}[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_SOULS@HERO_SKILL@NAME"
msgstr "Golpes Sugadores de Alma"

msgid "TOME_SOULS@PASSIVE2@DESCRIPTION"
msgstr "Concede acesso a {GLOBAL.UNITS.SKELETON_UNIT.Hyperlink}, um(a) {GLOBAL.PROPERTIES.UNDEAD.Hyperlink} {GLOBAL.PROPERTIES.POLEARM_UNIT.Hyperlink} que custa <<m:{GLOBAL.SoulConcept.Hyperlink}>> para recrutar."

msgid "TOME_SOULS@PASSIVE2@NAME"
msgstr "Esqueleto"

msgid "TOME_SOULS@PASSIVE@DESCRIPTION"
msgstr "Ganha <<m:{GLOBAL.SoulConcept}>> quando inimigos morrem em batalha.[br/][br/]Desbloqueia a habilidade de animar {GLOBAL.CityRuinConcept.Hyperlink} e animar <<m:{GLOBAL.HeroConcept.Hyperlink}>> em sua cripta como seus servos mortos-vivos."

msgid "TOME_SOULS@PASSIVE@NAME"
msgstr "Colheita de Almas"

msgid "TOME_SOULS@SKELETON_1@NAME"
msgstr "Milícia Esquelética^n"

msgid "TOME_SOULS@SKELETON_2@NAME"
