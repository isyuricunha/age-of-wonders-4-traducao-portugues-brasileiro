msgid "TOME_MAYHEM@PASSIVE@NAME"
msgstr "Guerra Ritualística"

msgid "TOME_MAYHEM@SKILL1@DESCRIPTION"
msgstr "Faz com que os ataques de unidades encantadas:[bulletlist][bullet/]Inflijam {GLOBAL.PROPERTIES.MISFORTUNE.Hyperlink}.[/bulletlist] [br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_MAYHEM@SKILL1@DESCRIPTION_HS"
msgstr "Ataques básicos do herói:[bulletlist][bullet/]Causam {GLOBAL.PROPERTIES.MISFORTUNE.Hyperlink}[/bulletlist] [br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_MAYHEM@SKILL1@NAME"
msgstr "Marca do Infortúnio"

msgid "TOME_MAYHEM@SKILL1@PROP_DESCRIPTION"
msgstr "Ataques da unidade:[bulletlist][bullet/]Causam {GLOBAL.PROPERTIES.MISFORTUNE.Hyperlink}.[/bulletlist] [br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_MAYHEM@SKILL2@DESCRIPTION"
msgstr "Invoca um {GLOBAL.UNITS.GREMLIN_UNIT.Hyperlink} no hexágono-alvo no mundo. Esta unidade é um {GLOBAL.PROPERTIES.SKIRMISHER.Hyperlink} disruptivo e demoníaco."

msgid "TOME_MAYHEM@SKILL2@NAME"
msgstr "Invocar Diabrete"

msgid "TOME_MAYHEM@SKILL3@DESCRIPTION"
msgstr "Alvos em um raio de {CURSE_OF_MISFORTUNE_UNIT_TARGETER_CIRCLE>AREA>Radius} hexágonos sofrem {stacks} {GLOBAL.PROPERTIES.MISFORTUNE.Hyperlink}."

