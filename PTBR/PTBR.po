msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_SPRITE@UNIT1@NAME"
msgstr "Sprite da Manhã^n"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_SPRITE@UNIT2@NAME"
msgstr "Sprite da Noite^n"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_WEAVER@ABILITY1@NAME"
msgstr "Explosão de Teia"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_WEAVER@ABILITY2@CHAMPION_DESCRIPTION"
