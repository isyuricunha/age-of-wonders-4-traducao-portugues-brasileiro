msgid "DLC@ELDRITCHREALMS@NODES_STRATEGIC@VOID_INK@DESCRIPTION"
msgstr "[bulletlist][bullet/]<<m:{GLOBAL.PvEVassalConcept.Hyperlink}>> concedem +{amount1} {GLOBAL.KnowledgeConcept.Hyperlink}.[bullet/]<<m:{GLOBAL.UmbralDwellingConcept.Hyperlink}>> com um(a) {GLOBAL.EldritchPactConcept.Hyperlink} concedem +{amount2}.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@NODES_STRATEGIC@VOID_INK@NAME"
msgstr "Tinta do Vazio"

msgid "DLC@ELDRITCHREALMS@NODES_STRATEGIC@VOID_STONES@DESCRIPTION"
msgstr "Efeito global único: [bulletlist][bullet/]Ganhe {allegiance}{GLOBAL.HouseInfluenceConcept.Hyperlink} com <<m:{GLOBAL.UmbralDwellingConcept.Hyperlink}>> descoberto(a) por {GLOBAL.TurnConcept.Hyperlink}.[bullet/]Permite a forja de itens diversos que concedem imunidade a {GLOBAL.PROPERTIES.SHADOW_SICKNESS.Hyperlink} no(a) {GLOBAL.ItemForgeConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@NODES_STRATEGIC@VOID_STONES@LORE"
msgstr "\"Pedras flutuantes, lisas como seda, diferentes de qualquer uma que encontrei nos mundos conhecidos ou sob eles. Toque uma, e as palavras proibidas dos habitantes Umbrais fluem da sua língua. Bata em uma com um martelo, e sua sintonia Astral ressoa. Parecem impossíveis de partir ao meio, mas suspeito que sejam, na verdade, geodos. Que tesouro está guardado dentro delas?\"[br/][br/]—Fangir Rockborne, Diários da Segunda Era: Apêndice"

msgid "DLC@ELDRITCHREALMS@NODES_STRATEGIC@VOID_STONES@NAME"
msgstr "Pedras do Vazio"

msgid "DLC@ELDRITCHREALMS@NODES_STRATEGIC@VOID_STONES_SET_BONUS@DESCRIPTION"
msgstr "[bulletlist][bullet/]<<m:{GLOBAL.UmbralDwellingConcept.Hyperlink}>> com um bônus de {GLOBAL.EldritchPactConcept.Hyperlink} que concede +{amount1} {GLOBAL.KnowledgeConcept.Hyperlink}.[bullet/]<<m:{GLOBAL.PvEVassalConcept.Hyperlink}>> concede +{amount2} {GLOBAL.KnowledgeConcept.Hyperlink}.[/bulletlist][br/][br/]Requer:[bulletlist][bullet/]{amount3} {GLOBAL.STRUCTURES.VOID_STONES.Hyperlink}[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@NODES_STRATEGIC@VOID_STONES_SET_BONUS@NAME"
msgstr "Tinta do Vazio"

msgid "DLC@ELDRITCHREALMS@PICKUPS_STRATEGIC@CHITIN_PICKUP@DESCRIPTION"
msgstr "Carapaças descartadas e endurecidas de várias criaturas Demoníacas Umbrais. Podem ser usadas na construção de armaduras ou edifícios, ou vendidas como materiais exóticos.[br/][br/]Podem conceder uma grande quantidade de {GLOBAL.GoldConcept.Hyperlink}, {GLOBAL.UnitProductionConcept.Hyperlink} ou {GLOBAL.StructureProductionConcept.Hyperlink}."

msgid "DLC@ELDRITCHREALMS@PICKUPS_STRATEGIC@CHITIN_PICKUP@NAME"
msgstr "Quitina Descartada"

msgid "DLC@ELDRITCHREALMS@PICKUPS_STRATEGIC@SOULS_PICKUP@DESCRIPTION"
msgstr "Carapaças de seres outrora poderosos, assombrando a área ao redor. Elas podem guardar segredos sombrios ou ser transformadas em poder bruto.[br/][br/]Podem conceder uma grande quantidade de {GLOBAL.ManaConcept.Hyperlink} e {GLOBAL.KnowledgeConcept.Hyperlink}. Se disponível, também concede {amount} <<m:{GLOBAL.SoulConcept.Hyperlink}>>."

msgid "DLC@ELDRITCHREALMS@PICKUPS_STRATEGIC@SOULS_PICKUP@NAME"
msgstr "Almas Atormentadas"

msgid "DLC@ELDRITCHREALMS@PICKUPS_STRATEGIC@TOME_PICKUP@DESCRIPTION"
