msgid "DLC@GIANTKINGS@DIPLOMACY@CRYSTAL_DWELLING@CRYSTAL_PACT@DESCRIPTION"
msgstr "[bulletlist][bullet/]O(a) [hyperlink,GLOBAL.ReinforcementRuleConcept] irá [/hyperlink]reforçar{GLOBAL.CombatConcept.Hyperlink} em <<m:{GLOBAL.MarauderConcept.Hyperlink}>> contra <<m:{GLOBAL.LeaderConcept.Hyperlink}>> e {GLOBAL.DwellingConcept.Hyperlink} o(a) {GLOBAL.IndependentCityWarConcept.Hyperlink} estiver em [bullet/] com.[bulletlist]Desbloqueia a compra dos seguintes itens comerciais via Cooperação:[bullet/]{GLOBAL.TOKENDEFINITION.LITHORITE_PRISM_ARTIFACT.Hyperlink}[bullet/]{GLOBAL.SPECIAL_OPERATIONS.CRYSTAL_FOCUS.Hyperlink}[bullet/]{GLOBAL.SPECIAL_OPERATIONS.CRYSTALLIZE_ESSENCE.Hyperlink}[bullet/]{GLOBAL.SPECIAL_OPERATIONS.CRYSTAL_CRASH.Hyperlink}[bullet/]{GLOBAL.UNITS.LITHORINE_SHARDLANCER.Hyperlink}[bullet/]{GLOBAL.UNITS.LITHORINE_GEMCASTER.Hyperlink}[/bulletlist][bullet/]Completar missões de Moradia recompensa garantidamente {GLOBAL.ManaConcept.Hyperlink} além das outras recompensas.[/bulletlist]"

msgid "DLC@GIANTKINGS@DIPLOMACY@CRYSTAL_DWELLING@CRYSTAL_PACT@HYPERLINK"
