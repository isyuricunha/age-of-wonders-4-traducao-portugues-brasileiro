msgid "COMBATPROPERTIES_TACTICAL@LOST_PUPPETEER@NAME"
msgstr "Sussurros das Trevas"

msgid "COMBATPROPERTIES_TACTICAL@LOST_PUPPETEER_IMMUNITY@DESCRIPTION"
msgstr "Unidades atacantes que são {GLOBAL.PROPERTIES.FAITHFUL.Hyperlink} recebem {GLOBAL.ControlLossImmunityConcept.Hyperlink}."

