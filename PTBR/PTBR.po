msgid "TOME_SANCTUARY@SKILL6@PROPERTY_DESCRIPTION"
msgstr "A unidade tem:[bulletlist][bullet/]+{ANOINTED_PEOPLE_STATUS_RESISTANCE>Resistance} {GLOBAL.StatusResistanceConcept.Hyperlink}[bullet/]+{ANOINTED_PEOPLE_DEFENSE>REDUCTION>Spirit} {GLOBAL.SpiritResistanceConcept.Hyperlink}[/bulletlist]"

msgid "TOME_SANCTUARY@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Crie um refúgio seguro para todos os crentes. Especialize-se em curar e fortalecer defesas."

msgid "TOME_SANCTUARY@TOME@LORE_AUTHOR"
msgstr "Anon, Arcon Feiticeiro da Vida"

msgid "TOME_SANCTUARY@TOME@LORE_DESCRIPTION"
msgstr "\"Minha fé é meu escudo. Sou protegido pelo amor. Envolvo o mundo com esta armadura, para protegê‑lo e abençoá‑lo com luz curativa! Sou o bastião dos fracos. Fortaleço os fortes. Os guerreiros da verdade seguem-me, como uma onda de justiça feita carne!\""

msgid "TOME_SANCTUARY@TOME@NAME"
msgstr "Tomo de Santuário"

msgid "TOME_SANCTUARY@UNIT1@NAME"
msgstr "Torre de Cura^n"

msgid "TOME_SANCTUARY@UNIT_ABILITY1@DESCRIPTION"
msgstr "Alvo unidade amiga:[bulletlist][bullet/]Cura +{PROVIDE_SANCTUARY_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>[bullet/]Ganha {amount2} {GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink}[/bulletlist]"

msgid "TOME_SANCTUARY@UNIT_ABILITY1@NAME"
msgstr "Conceder Santuário"

msgid "TOME_SCRYING@PASSIVE@DESCRIPTION"
msgstr "<<m:{GLOBAL.UnitConcept}>> tem {amount} {GLOBAL.VisionRangeConcept}."

msgid "TOME_SCRYING@PASSIVE@NAME"
msgstr "Visão Scry"

msgid "TOME_SCRYING@SKILL1@DEBUFF_DESCRIPTION"
msgstr "Esta unidade está revelando sua visão a um inimigo."

msgid "TOME_SCRYING@SKILL1@DEBUFF_NAME"
msgstr "Viu"

msgid "TOME_SCRYING@SKILL1@DESCRIPTION"
msgstr "Todos os inimigos no exército-alvo fornecem a você visão por {amount} <<m:{GLOBAL.TurnConcept}>>."

msgid "TOME_SCRYING@SKILL1@NAME"
msgstr "Scry Inimigo"

msgid "TOME_SCRYING@SKILL2@DESCRIPTION"
msgstr "Alvo Inimigos em um raio de {MENTAL_MARK_UNIT_TARGETER_CIRCLE>AREA>Radius} hexágonos recebem:[bulletlist][bullet/]{amount1} {GLOBAL.PROPERTIES.MARKED.Hyperlink}.[bullet/]{amount2} {GLOBAL.PROPERTIES.SUNDERED_RESISTANCE.Hyperlink}.[/bulletlist]"

msgid "TOME_SCRYING@SKILL2@NAME"
msgstr "Marca Mental"

msgid "TOME_SCRYING@SKILL3@DESCRIPTION"
msgstr "Invoca um {GLOBAL.UNITS.WATCHER_UNIT.Hyperlink}, um {GLOBAL.PROPERTIES.BATTLE_MAGE.Hyperlink} com capacidades de visão aumentadas."

msgid "TOME_SCRYING@SKILL3@NAME"
msgstr "Invocar Vigilante"

msgid "TOME_SCRYING@SKILL4@DESCRIPTION"
msgstr "Faz os ataques base de unidades encantadas:[bulletlist][bullet/]Fogo {GUIDED_PROJECTILES_RANGE>ADD>OptimalRange} hexágonos mais longe sem penalidades de Alcance Longo {GLOBAL.AccuracyConcept.Hyperlink}.[bullet/]Ignora penalidades de {GLOBAL.AccuracyConcept.Hyperlink} da condição {GLOBAL.ObscuringConcept.Hyperlink} causada por unidades que estão no caminho e por certos terrenos.[/bulletlist]"

msgid "TOME_SCRYING@SKILL4@NAME"
msgstr "Projéteis Guiados"

msgid "TOME_SCRYING@SKILL4@PROPERTY_DESCRIPTION"
msgstr "Ataques base da unidade:[bulletlist][bullet/]Dispara {GUIDED_PROJECTILES_RANGE>ADD>OptimalRange} hexágonos a mais sem penalidades de Alcance Longo {GLOBAL.AccuracyConcept.Hyperlink}.[bullet/]Ignora penalidades de {GLOBAL.ObscuringConcept.Hyperlink} causadas por unidades no caminho e por certos terrenos.[/bulletlist]"

msgid "TOME_SCRYING@SKILL5@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{stabilityAmount}{GLOBAL.CityStabilityConcept.Hyperlink}[bullet/]+{knowledgeAmount}{GLOBAL.KnowledgeConcept.Hyperlink}[bullet/]+{amount1} {GLOBAL.VisionRangeConcept.Hyperlink}[bullet/]Visão Verdadeira que permite detectar inimigos camuflados perto da cidade.[/bulletlist]"

msgid "TOME_SCRYING@SKILL5@NAME"
msgstr "Torre da Visão Verdadeira"

msgid "TOME_SCRYING@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Observe seus inimigos e não deixe nada passar despercebido. Especialize‑se em ganhar mais visão e {GLOBAL.PROPERTIES.TRUE_SIGHT.Hyperlink} e infligir {GLOBAL.PROPERTIES.MARKED.Hyperlink}."

msgid "TOME_SCRYING@TOME@LORE_AUTHOR"
msgstr "Werlac de Insaldur, Cultista Shadowborn"

msgid "TOME_SCRYING@TOME@LORE_DESCRIPTION"
msgstr "\"Desperte o olho da sua mente para contemplar além do reino físico. Segredos próximos e distantes se revelarão, e os verdadeiramente observadores poderão até vislumbrar o futuro imediato! O olhar de choque do seu inimigo quando você desvia habilidosamente de seu ataque antes mesmo que ele seja lançado é realmente um espetáculo digno de ser contemplado.\""

msgid "TOME_SCRYING@TOME@NAME"
msgstr "Tomo de Scrying"

msgid "TOME_SCRYING@UNIT@NAME"
msgstr "Vigilante^n"

msgid "TOME_SCRYING@UNIT_ABILITY@DESCRIPTION"
msgstr "A unidade inimiga alvo sofre dano."

msgid "TOME_SCRYING@UNIT_ABILITY@DESCRIPTION_2"
msgstr "A unidade inimiga alvo e outra dentro de {amount} hexágonos sofrem dano."

msgid "TOME_SCRYING@UNIT_ABILITY@ENHANCED_DESCRIPTION"
msgstr "Olhar Psíquico:[bulletlist][bullet/]Causa {PSYCHIC_GAZE_ENHANCED_DAMAGE>DAMAGE>Shock}{GLOBAL.LightningDamageConcept.Hyperlink} adicional.[bullet/]Tem {STUNNED_RESISTANCE>ResolvedStrength}% de chance de infligir {GLOBAL.PROPERTIES.STUNNED.Hyperlink}.[/bulletlist]"

msgid "TOME_SCRYING@UNIT_ABILITY@ENHANCED_NAME"
msgstr "Olhar Psíquico Aprimorado"

msgid "TOME_SCRYING@UNIT_ABILITY@MASTER_DESCRIPTION"
msgstr "Olhar Psíquico:[bulletlist][bullet/]Tem {STUNNED_RESISTANCE>ResolvedStrength}% de chance base de aplicar {GLOBAL.PROPERTIES.STUNNED.Hyperlink}.[bullet/]Aplica uma camada adicional de {GLOBAL.PROPERTIES.MARKED.Hyperlink}.[/bulletlist]"

msgid "TOME_SCRYING@UNIT_ABILITY@MASTER_NAME"
msgstr "Olhar Psíquico Campeão"

msgid "TOME_SCRYING@UNIT_ABILITY@NAME"
msgstr "Olhar Psíquico"

msgid "TOME_SCRYING@UNIT_ABILITY_2@DESCRIPTION"
msgstr "A unidade é imune a {GLOBAL.FlankingConcept.Hyperlink} e é imune a tornar‑se {GLOBAL.PROPERTIES.DISTRACTED.Hyperlink}."

msgid "TOME_SCRYING@UNIT_ABILITY_2@NAME"
msgstr "Olho de Scrying"

msgid "TOME_SEVERING@SKILL3@DEFENSE_MODE@PROPERTY@NAME"
msgstr "Defesa de Escudo Nulo"

msgid "TOME_SOULS@HERO_SKILL@DESCRIPTION"
msgstr "Ganhos dos ataques base:[bulletlist][bullet/]Inflige {GLOBAL.PROPERTIES.SOULBOUND.Hyperlink}[bullet/]Chance base de {REMORSE_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.REMORSE.Hyperlink}[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_SOULS@HERO_SKILL@NAME"
msgstr "Golpes de Chuva de Almas"

msgid "TOME_SOULS@PASSIVE2@DESCRIPTION"
msgstr "Concede acesso a {GLOBAL.UNITS.SKELETON_UNIT.Hyperlink}, um {GLOBAL.PROPERTIES.UNDEAD.Hyperlink} {GLOBAL.PROPERTIES.POLEARM_UNIT.Hyperlink} que custa <<m:{GLOBAL.SoulConcept.Hyperlink}>> para recrutar."

msgid "TOME_SOULS@PASSIVE2@NAME"
msgstr "Esqueleto"

msgid "TOME_SOULS@PASSIVE@DESCRIPTION"
msgstr "Ganhe <<m:{GLOBAL.SoulConcept}>> quando inimigos morrem em combate.[br/][br/]Desbloqueia a habilidade de animar {GLOBAL.CityRuinConcept.Hyperlink} e de animar <<m:{GLOBAL.HeroConcept.Hyperlink}>> em sua cripta como servos não‑mortos."

msgid "TOME_SOULS@PASSIVE@NAME"
msgstr "Colheita de Almas"

msgid "TOME_SOULS@SKELETON_1@NAME"
msgstr "Milícia Esqueleto^n"

msgid "TOME_SOULS@SKELETON_2@NAME"
msgstr "Guerreiro Esqueleto^n"

msgid "TOME_SOULS@SKELETON_3@NAME"
msgstr "Arqueiro Esqueleto^n"

msgid "TOME_SOULS@SKELETON_4@NAME"
msgstr "Mago Esqueleto^n"

msgid "TOME_SOULS@SKILL1@DESCRIPTION"
msgstr "Ritos avançados permitem a criação de {GLOBAL.UNITS.BONE_GOLEM.Hyperlink}. Eles podem ser criados em um {GLOBAL.CityConcept} usando <<m:{GLOBAL.SoulConcept}>> ou fundindo duas unidades {GLOBAL.UNITS.SKELETON_UNIT.Hyperlink}."

msgid "TOME_SOULS@SKILL1@NAME"
msgstr "Horror Ósseo"

msgid "TOME_SOULS@SKILL1@SPELL_DESCRIPTION"
msgstr "Cria um {GLOBAL.UNITS.BONE_GOLEM.Hyperlink} combinando duas unidades {GLOBAL.UNITS.SKELETON_UNIT.Hyperlink}."

msgid "TOME_SOULS@SKILL1@SPELL_NAME"
msgstr "Criar Horror Ósseo"

msgid "TOME_SOULS@SKILL2@DESCRIPTION"
msgstr "Unidade inimiga alvo:[bulletlist][bullet/]Sofre {SOUL_FIRE_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink} e {SOUL_FIRE_DAMAGE>DAMAGE>Blight} {GLOBAL.BlightDamageConcept.Hyperlink}[bullet/]Ganha {amount} camadas de {GLOBAL.PROPERTIES.DECAYING.Hyperlink} por {DECAYING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Quando morre, torna‑se um {GLOBAL.UNITS.DECAYING_ZOMBIE.Hyperlink} sob seu controle até o fim do combate.[/bulletlist]"

msgid "TOME_SOULS@SKILL2@NAME"
msgstr "Necrotizar"

msgid "TOME_SOULS@SKILL3@DESCRIPTION"
msgstr "Unidades inimigas no exército alvo ganham {GLOBAL.PROPERTIES.SOULBOUND.Hyperlink} até a próxima vez que estiverem em batalha."

msgid "TOME_SOULS@SKILL3@NAME"
msgstr "Exército de Ligação de Alma"

msgid "TOME_SOULS@SKILL4@DESCRIPTION"
msgstr "Concede unidades encantadas:[bulletlist][bullet/]Chance base de {SOULBOUND_RESISTANCE_90>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.SOULBOUND.Hyperlink} nos ataques, aumentando o ganho de {GLOBAL.SoulConcept.Hyperlink} quando o alvo é morto.[bullet/]+{SOULBINDERS_DAMAGE_MULTIPLIER>ResolvedMultiplier}% de dano contra unidades com {GLOBAL.PROPERTIES.SOULBOUND.Hyperlink}.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_SOULS@SKILL4@NAME"
msgstr "Ligadores de Alma"

msgid "TOME_SOULS@SKILL4@PROP_DESCRIPTION"
msgstr "A unidade possui:[bulletlist][bullet/]Chance base de {SOULBOUND_RESISTANCE_90>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.SOULBOUND.Hyperlink} nos ataques.[bullet/]+{SOULBINDERS_DAMAGE_MULTIPLIER>ResolvedMultiplier}% de dano contra unidades que são {GLOBAL.PROPERTIES.SOULBOUND.Hyperlink}.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_SOULS@SKILL5@DESCRIPTION"
msgstr "Unidades amigas em um raio de {SOUL_OVERFLOW_TARGETER>AREA>Radius} hexágonos:[bulletlist][bullet/]Ganha {amount} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}.[bullet/]Ganha +{SOUL_OVERFLOW_STAT_BONUS>BONUS>HitPoints} de <<m:{GLOBAL.HitPointConcept.Hyperlink}>> máximo até o fim da batalha.[bullet/]Remove {GENERAL_DISPEL_NEGATIVE>NumThingsToDispel} <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>>.[/bulletlist]"

msgid "TOME_SOULS@SKILL5@EFFECT@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{SOUL_OVERFLOW_STAT_BONUS>BONUS>HitPoints} máximo de <<m:{GLOBAL.HitPointConcept.Hyperlink}>> até o fim da batalha.[/bulletlist]"

msgid "TOME_SOULS@SKILL5@NAME"
msgstr "Transbordo de Alma"

msgid "TOME_SOULS@SKILL5@PROP_DESCRIPTION"
msgstr "+{SOUL_OVERFLOW_STAT_BONUS>BONUS>HitPoints} máximo de <<m:{GLOBAL.HitPointConcept.Hyperlink}>> até o fim da batalha."

msgid "TOME_SOULS@SKILL6@DESCRIPTION"
msgstr "[bulletlist][bullet/]Ganha +{amount1} <<m:{GLOBAL.SoulConcept.Hyperlink}>> de renda.[bullet/]Custa {amount2} {GLOBAL.GoldConcept.Hyperlink} de manutenção.[/bulletlist]"

msgid "TOME_SOULS@SKILL6@NAME"
msgstr "Coleta de Alma"

msgid "TOME_SOULS@SKILL7@DESCRIPTION"
msgstr "Ao eliminar unidades raciais, ganha a opção de gastar <<m:{GLOBAL.SoulConcept.Hyperlink}>> para criar Esqueletos após o combate."

msgid "TOME_SOULS@SKILL7@NAME"
msgstr "Reanimação de Esqueletos"

msgid "TOME_SOULS@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Colha <<m:{GLOBAL.SoulConcept}>> dos seus inimigos e crie criaturas {GLOBAL.PROPERTIES.UNDEAD.Hyperlink}. Especialize-se em unidades descartáveis e no início da sua economia {GLOBAL.SoulConcept}."

msgid "TOME_SOULS@TOME@LORE_AUTHOR"
msgstr "Nocrom, a Mão Amaldiçoada"

msgid "TOME_SOULS@TOME@LORE_DESCRIPTION"
msgstr "\"Os corpos são frágeis, porém forte é a vontade de todas as almas de se agarrar à vida. Conceda-lhes seu desejo! Forje-lhes vasos de carne podre e osso! Até o inimigo mais feroz servirá aos seus desejos quando ressuscitado do campo de batalha. Pois a morte alcança a todos e, na morte, você habitará.\""

msgid "TOME_SOULS@TOME@NAME"
msgstr "Tomo de Almas"

msgid "TOME_SOULS@UNIT_1@NAME"
msgstr "Esqueleto^n"

msgid "TOME_SOULS@UNIT_2@NAME"
msgstr "Zumbi^n"

msgid "TOME_SOULS@UNIT_3@NAME"
msgstr "Zumbi Decomposto^n"

msgid "TOME_SUBJUGATION@PASSIVE@DESCRIPTION"
msgstr "O tempo necessário para absorver ou migrar <<m:{GLOBAL.CityConcept}>> é reduzido em {turns} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "TOME_SUBJUGATION@PASSIVE@NAME"
msgstr "Subjugação Ágil"

msgid "TOME_SUBJUGATION@SKILL1@DESCRIPTION"
msgstr "Uma {GLOBAL.PROPERTIES.SHOCK_UNIT.Hyperlink} pesada que se especializa em reduzir {GLOBAL.UnitMoraleConcept.Hyperlink}."

msgid "TOME_SUBJUGATION@SKILL1@NAME"
msgstr "Subjugador^m"

msgid "TOME_SUBJUGATION@SKILL2@DESCRIPTION"
msgstr "Concede unidades encantadas:[bulletlist][bullet/]{GLOBAL.PROPERTIES.INTIMIDATING_AURA.Hyperlink}, que reduz {GLOBAL.UnitMoraleConcept.Hyperlink} dos inimigos próximos.[/bulletlist]"

msgid "TOME_SUBJUGATION@SKILL2@NAME"
msgstr "Aura de Intimidação"

msgid "TOME_SUBJUGATION@SKILL2@PROPERTY_DESCRIPTION"
msgstr "A unidade tem:[bulletlist][bullet/]{GLOBAL.PROPERTIES.INTIMIDATING_AURA.Hyperlink}.[/bulletlist]"

msgid "TOME_SUBJUGATION@SKILL3@DESCRIPTION"
msgstr "[bulletlist][bullet/]Quando as muralhas são rompidas, a {GLOBAL.CityConcept.Hyperlink} sitiada perde {populationLost} {GLOBAL.PopulationConcept.Hyperlink}.[bullet/]A {GLOBAL.CityConcept.Hyperlink} mais próxima ganha {populationGain} {GLOBAL.PopulationConcept.Hyperlink}.[bullet/]No início da batalha, todas as unidades inimigas têm {morale}{GLOBAL.UnitMoraleConcept.Hyperlink} até o fim da batalha.[/bulletlist]"

msgid "TOME_SUBJUGATION@SKILL3@NAME"
msgstr "Incursão de Subjugação"

msgid "TOME_SUBJUGATION@SKILL3@PROPERTY@DESCRIPTION"
msgstr "Todos os inimigos iniciam o combate com {morale} {GLOBAL.UnitMoraleConcept.Hyperlink}."

msgid "TOME_SUBJUGATION@SKILL4@DESCRIPTION"
msgstr "Alveje {GLOBAL.RoutingConcept.Hyperlink} unidade inimiga não-{GLOBAL.PROPERTIES.HERO.Hyperlink}:[bulletlist][bullet/]Tem uma chance base de {FINAL_ULTIMATUM_RESISTANCE_CHECK>ResolvedStrength}% de ficar permanentemente controlada mentalmente.[bullet/]Se for bem-sucedido, ganha +{FINAL_ULTIMATUM_CHANGE_MORALE>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}.[bullet/]Se resistir, a unidade morre ao invés disso.[/bulletlist]"

msgid "TOME_SUBJUGATION@SKILL4@NAME"
msgstr "Ultimato Final"

msgid "TOME_SUBJUGATION@SKILL5@DESCRIPTION"
msgstr "[bulletlist][bullet/]Só pode ser construído em cidades de outra raça.[bullet/]{gold} {GLOBAL.GoldConcept.Hyperlink} de renda.[bullet/]{stability} {GLOBAL.CityStabilityConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_SUBJUGATION@SKILL5@NAME"
msgstr "Palácio do Barão"

msgid "TOME_SUBJUGATION@SKILL5@STRUCTURE_DESCRIPTION"
msgstr "Esta cidade ganha:[bulletlist][bullet/]{happinessAmount} {GLOBAL.CityStabilityConcept.Hyperlink}[bullet/]{draftAmount} {GLOBAL.UnitProductionConcept.Hyperlink}[/bulletlist][br/]Sua {GLOBAL.ThroneCityConcept.Hyperlink} ganha:[bulletlist][bullet/]{goldAmount} {GLOBAL.GoldConcept.Hyperlink}[bullet/]{foodAmount} {GLOBAL.FoodConcept.Hyperlink}[bullet/]{imperiumAmount} {GLOBAL.ImperiumConcept.Hyperlink}[/bulletlist][br/][br/]Só pode ser construída em cidades de outra raça."

msgid "TOME_SUBJUGATION@SKILL6@NAME"
msgstr "Refinaria de Materiais"

msgid "TOME_SUBJUGATION@SKILL6@STRUCTURE_DESCRIPTION"
msgstr "Ganhe {KnowledgeBonus}{GLOBAL.KnowledgeConcept.Hyperlink} e {GoldBonus}{GLOBAL.GoldConcept.Hyperlink}. Ganhe {KnowledgePerMaterial}{GLOBAL.KnowledgeConcept.Hyperlink} e {GoldPerMaterial}{GLOBAL.GoldConcept.Hyperlink} adicionais por cada {GLOBAL.MagicMaterialConcept.Hyperlink} na {GLOBAL.DomainConcept.Hyperlink} desta cidade."

msgid "TOME_SUBJUGATION@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Expande e subjulga cidades de outras raças. Especializa‑se em reduzir a {GLOBAL.UnitMoraleConcept.Hyperlink} inimiga e conquistar cidades."

msgid "TOME_SUBJUGATION@TOME@LORE_AUTHOR"
msgstr "Turiel, Guardião Exaltado de Grexolis"

msgid "TOME_SUBJUGATION@TOME@LORE_DESCRIPTION"
msgstr "\"Aos justos é concedido o dever de trazer luz àqueles que ainda permanecem na escuridão. Quem assumir esse dever receberá o direito ao poder. A semente errante deve ser esmagada sob o calcanhar da virtude antes de poder germinar! Seus inimigos podem recuar inicialmente, mas seus exércitos serão sempre encorajados por seu glorioso propósito.\""

msgid "TOME_SUBJUGATION@TOME@NAME"
msgstr "Tomo da Subjugação"

msgid "TOME_SUBJUGATION@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Chance base de {DEMOIRALIZING_CHARGE_RESISTANCE_CHECK>ResolvedStrength}% de infligir {DEMOIRALIZING_CHARGE_CHANGE_MORALE>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}."

msgid "TOME_SUBJUGATION@UNIT1@ABILITY1@NAME"
msgstr "Golpe de Carga Demoralizante"

msgid "TOME_SUBJUGATION@UNIT1@ABILITY2@DESCRIPTION"
msgstr "A unidade inimiga alvo tem uma chance base de {OPPRESS_RESISTANCE_CHECK>ResolvedStrength}% de perder {mor1} {GLOBAL.UnitMoraleConcept.Hyperlink}. Em caso de falha, perde {mor2} {GLOBAL.UnitMoraleConcept.Hyperlink}."

msgid "TOME_SUBJUGATION@UNIT1@ABILITY2@NAME"
msgstr "Oprimir"

msgid "TOME_SUMMONING@ABILITY_01@DESCRIPTION"
msgstr "A unidade teleporta para o hexágono alvo, causando dano às unidades adjacentes. Em seguida, a unidade ganha {GLOBAL.PROPERTIES.REFUGED.Hyperlink}."

msgid "TOME_SUMMONING@ABILITY_01@NAME"
msgstr "Refúgio Estilhaçado"

msgid "TOME_SUMMONING@ABILITY_02@DESCRIPTION"
msgstr "Unidade amiga alvo:[bulletlist][bullet/]Cura +{ASTRAL_BLESSING_UNIT_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Ganha {GLOBAL.PROPERTIES.STATIC_CHARGE.Hyperlink} por {STATIC_CHARGE_STATUS_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "TOME_SUMMONING@ABILITY_02@DESCRIPTION_2"
msgstr "Unidade amiga alvo:[bulletlist][bullet/]Cura +{ASTRAL_BLESSING_UNIT_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Perde {dispelAmount} {GLOBAL.NegativeStatusEffectConcept.Hyperlink}.[bullet/]Ganha {GLOBAL.PROPERTIES.STATIC_CHARGE.Hyperlink} por {STATIC_CHARGE_STATUS_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "TOME_SUMMONING@ABILITY_02@DESCRIPTION_CHAMPION"
msgstr "Bênção Astral:[bulletlist][bullet/]Cura adicional {healAmount}<<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>[bullet/]Remove {GENERAL_DISPEL_NEGATIVE>NumThingsToDispel} {GLOBAL.NegativeStatusEffectConcept.Hyperlink}[/bulletlist]"

msgid "TOME_SUMMONING@ABILITY_02@NAME"
msgstr "Bênção Astral"

msgid "TOME_SUMMONING@ABILITY_02@NAME_CHAMPION"
msgstr "Bênção Astral do Campeão"

msgid "TOME_SUMMONING@ABILITY_03@DESCRIPTION"
msgstr "Unidade morre:[bulletlist][bullet/]Aciona {GLOBA.PROPERTIES.ASTRAL_TORRENT.Hyperlink}.[bullet/]Cura adicional {amount} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> a unidades amigas dentro de {amount2} hexágonos.[/bulletlist]"

msgid "TOME_SUMMONING@ABILITY_03@NAME"
msgstr "Destruir a Si Mesmo"

msgid "TOME_SUMMONING@HERO_SKILL@DESCRIPTION"
msgstr "Inicie o combate com um(a) {GLOBAL.UNITS.ASTRAL_WISP_UNIT.Hyperlink}."

msgid "TOME_SUMMONING@HERO_SKILL@NAME"
msgstr "Familiar de Vagalume"

msgid "TOME_SUMMONING@PASSIVE@DESCRIPTION"
msgstr "{GLOBAL.CombatSummonSpellConcept.Hyperlink} e {GLOBAL.StrategicSummonSpellConcept.Hyperlink} custam -{amount}% <<m:{GLOBAL.CombatCastingPointConcept.Hyperlink}>>."

msgid "TOME_SUMMONING@PASSIVE@NAME"
msgstr "Doutrina da Conjuração"

msgid "TOME_SUMMONING@SKILL1@DESCRIPTION"
msgstr "Unidade inimiga {GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink} alvo tem uma chance base de {ARCANE_BIND_RESISTANCE_CHECK>ResolvedStrength}% de se tornar {GLOBAL.PROPERTIES.DOMINATED.Hyperlink} por {ARCANE_BIND_MIND_CONTROL>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[br/][br/]Se falhar, causa {ARCANE_BIND_UNIT_DAMAGE>DAMAGE>Shock} {GLOBAL.LightningDamageConcept.Hyperlink}."

msgid "TOME_SUMMONING@SKILL1@NAME"
msgstr "Vínculo Arcano"

msgid "TOME_SUMMONING@SKILL2@DESCRIPTION"
msgstr "Cura todas as unidades amigas {GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink} +{ARCANE_RESTORATION_UNIT_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>."

msgid "TOME_SUMMONING@SKILL2@NAME"
msgstr "Restauração Arcana"

msgid "TOME_SUMMONING@SKILL3@DESCRIPTION"
msgstr "Invoca um(a) {GLOBAL.UNITS.ASTRAL_KEEPER_UNIT.Hyperlink}, um(a) {GLOBAL.PROPERTIES.SUPPORT_UNIT.Hyperlink} que cura unidades mesmo na morte.{LOC.CONCEPT@SUMMON_LIVE_SHARED}"

msgid "TOME_SUMMONING@SKILL3@NAME"
msgstr "Conjurar Guardião Astral"

msgid "TOME_SUMMONING@SKILL4@DESCRIPTION"
msgstr "Por {STATIC_CHARGE_STATUS_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>, a unidade amiga {GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink} alvo ganha:[bulletlist][bullet/]{amount} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}[bullet/]{amount2} {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink}[bullet/]{amount3} {GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.STATIC_CHARGE.Hyperlink}[/bulletlist]"

msgid "TOME_SUMMONING@SKILL4@NAME"
msgstr "Supercarga Arcana"

msgid "TOME_SUMMONING@SKILL5@DESCRIPTION"
msgstr "Invoca um(a) {GLOBAL.UNITS.ASTRAL_SERPENT_UNIT.Hyperlink}, um(a) {GLOBAL.PROPERTIES.FIGHTER.Hyperlink} que pode teleportar para as linhas de frente de forma explosiva."

msgid "TOME_SUMMONING@SKILL5@NAME"
msgstr "Invocar Serpente Astral"

msgid "TOME_SUMMONING@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Convoca, controla e aprimora unidades {GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink}."

msgid "TOME_SUMMONING@TOME@LORE_AUTHOR"
msgstr "Werlac de Insaldur, Cultista Shadowborn"

msgid "TOME_SUMMONING@TOME@LORE_DESCRIPTION"
msgstr "\"Através da arte da invocação, pode‑se tornar mestre em todos os sentidos da palavra. Convide servos arcanos e dobre‑os à sua vontade. Fortaleça a conexão deles com o mundo e observe enquanto entregam sua existência a você, aquele que os trouxe à existência.\""

msgid "TOME_SUMMONING@TOME@NAME"
msgstr "Tomo da Invocação"

msgid "TOME_SUMMONING@UNIT_1@NAME"
msgstr "Serpente Astral^n"

msgid "TOME_SUMMONING@UNIT_2@NAME"
msgstr "Guardião Astral^n"

msgid "TOME_SUPREMACY@HERO_SKILL@DESCRIPTION"
msgstr "Faz com que a unidade exploda ao ser morta, causando {SUPREME_MAGIC_UNIT_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink} a unidades inimigas adjacentes."

msgid "TOME_SUPREMACY@HERO_SKILL@NAME"
msgstr "Magia Suprema"

msgid "TOME_SUPREMACY@PASSIVE@DESCRIPTION"
msgstr "Ao vassalizar <<m:{GLOBAL.IndependentCityConcept.Hyperlink}>>, você ganha +{amount} de nível de {GLOBAL.HouseInfluenceConcept}."

msgid "TOME_SUPREMACY@PASSIVE@NAME"
msgstr "Conquistadores Benevolentes"

msgid "TOME_SUPREMACY@SKILL1@DESCRIPTION"
msgstr "Um {GLOBAL.PROPERTIES.SHIELD_UNIT.Hyperlink} voador que se destaca em aumentar o {GLOBAL.UnitMoraleConcept.Hyperlink} das suas unidades."

msgid "TOME_SUPREMACY@SKILL1@NAME"
msgstr "Exemplar^m"

msgid "TOME_SUPREMACY@SKILL2@DESCRIPTION"
msgstr "[bulletlist][bullet/]{unitProduction} {GLOBAL.UnitProductionConcept.Hyperlink}[bullet/]{stability} {GLOBAL.CityStabilityConcept.Hyperlink} por Monumento da Supremacia construído em seu império[/bulletlist]"

msgid "TOME_SUPREMACY@SKILL2@NAME"
msgstr "Monumento da Supremacia"

msgid "TOME_SUPREMACY@SKILL2@STRUCTURE_DESCRIPTION"
msgstr "{stability} {GLOBAL.CityStabilityConcept.Hyperlink} por Monumento da Supremacia em seu império."

msgid "TOME_SUPREMACY@SKILL3@DESCRIPTION"
msgstr "Exército inimigo alvo:[bulletlist][bullet/]Recebe {damage} de {GLOBAL.SpiritDamageConcept.Hyperlink}[bullet/]Torna-se {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink} por {turn} {GLOBAL.WorldMapConcept.Hyperlink} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "TOME_SUPREMACY@SKILL3@NAME"
msgstr "Condenar Exército"

msgid "TOME_SUPREMACY@SKILL4@DESCRIPTION"
msgstr "Para unidades encantadas:[bulletlist][bullet/]Concede {GLOBAL.PROPERTIES.ZEAL.Hyperlink}, que faz os ataques causarem {GLOBAL.SpiritDamageConcept.Hyperlink} extra.[bullet/]Os ataques ignoram {SUPREME_MAGIC_RESISTANCE_CHECK_BYPASS>ResistanceBypass} {GLOBAL.StatusResistanceConcept.Hyperlink}.[bullet/]Matar uma unidade faz com que ela exploda, causando {SUPREME_MAGIC_UNIT_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink} às unidades inimigas adjacentes.[/bulletlist]"

msgid "TOME_SUPREMACY@SKILL4@MODIFIER_DESCRIPTION"
msgstr "Matar uma unidade faz com que ela exploda, causando {SUPREME_MAGIC_UNIT_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink} às unidades inimigas adjacentes."

msgid "TOME_SUPREMACY@SKILL4@NAME"
msgstr "Magia Suprema"

msgid "TOME_SUPREMACY@SKILL4@PROPERTY_DESCRIPTION"
msgstr "[bulletlist][bullet/]A unidade tem {GLOBAL.PROPERTIES.ZEAL.Hyperlink}.[bullet/]Os ataques ignoram {SUPREME_MAGIC_RESISTANCE_CHECK_BYPASS>ResistanceBypass} {GLOBAL.StatusResistanceConcept.Hyperlink}.[bullet/]Matar uma unidade faz com que ela exploda, causando {SUPREME_MAGIC_UNIT_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink} às unidades inimigas adjacentes.[/bulletlist]"

msgid "TOME_SUPREMACY@SKILL5@DESCRIPTION"
msgstr "Todas as unidades aliadas recebem:[bulletlist][bullet/]{strengthened} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}.[bullet/]+{ANTHEM_OF_VICTORY_CHANGE_MORALE>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_SUPREMACY@SKILL5@NAME"
msgstr "Hino da Vitória"

msgid "TOME_SUPREMACY@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Lidere seu povo rumo a uma vitória gloriosa. Especialize-se em aumentar o {GLOBAL.UnitMoraleConcept.Hyperlink.} e em administrar um grande império."

msgid "TOME_SUPREMACY@TOME@LORE_AUTHOR"
msgstr "Inioch, Imperador da Corte Élfica"

msgid "TOME_SUPREMACY@TOME@LORE_DESCRIPTION"
msgstr "\"Nós, que buscamos pastorear e guiar nosso povo, somos agraciados com um propósito glorioso. Esta glória justa surge de nosso próprio ser, permeando a carne e o espírito de nossos súditos, e inspirando-os à grandeza! A vitória, para aqueles que trilham este caminho divino, não é uma possibilidade, mas uma certeza.\""

msgid "TOME_SUPREMACY@TOME@NAME"
msgstr "Tomo da Supremacia"

msgid "TOME_SUPREMACY@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Unidades amigas dentro de um raio de {EMBOLDEN_ALLIES_CIRCLE_AROUND_CASTER>AREA>Radius} hexágonos ganham, por {RALLYING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>: [bulletlist][bullet/]{amount} {GLOBAL.PROPERTIES.RALLYING.Hyperlink}.[bullet/]{strengthened} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}.[/bulletlist][br/]Entre {GLOBAL.DefenseModeConcept.Hyperlink}."

msgid "TOME_SUPREMACY@UNIT1@ABILITY1@NAME"
msgstr "Encorajar Aliados"

msgid "TOME_SUPREMACY@UNIT1@ABILITY2@DESCRIPTION"
msgstr "Em combate, esta e todas as demais unidades amigas recebem um modificador de +{INSPIRING_PRESENCE_MORALE_RESISTANCE>ResolvedMoraleRiseModifier}% ao ganho positivo de {GLOBAL.UnitMoraleConcept.Hyperlink}.[br/][br/]Este efeito não acumula."

msgid "TOME_SUPREMACY@UNIT1@ABILITY2@NAME"
msgstr "Presença Inspiradora"

msgid "TOME_SUPREMACY@UNIT1@ABILITY2@PROPERTY@NAME"
msgstr "Inspirado"

msgid "TOME_SUPREMACY@UNIT1@ABILITY2@PROPERY@DESCRIPTION"
msgstr "Ganha {GLOBAL.UnitMoraleConcept.Hyperlink} {INSPIRING_PRESENCE_MORALE_RESISTANCE>ResolvedMoraleRiseModifier}% mais rápido."

msgid "TOME_TELEPORTATION@HERO_SKILL@DESCRIPTION"
msgstr "Faz o conjurador teleportar para o hexágono alvo."

msgid "TOME_TELEPORTATION@HERO_SKILL@NAME"
msgstr "Fase Rápida"

msgid "TOME_TELEPORTATION@PASSIVE@DESCRIPTION"
msgstr "Todos os <<m:{GLOBAL.ProvinceConcept}>> podem ser definidos como ponto de surgimento do exército da Cidade."

msgid "TOME_TELEPORTATION@PASSIVE@NAME"
msgstr "Portais de Implantação"

msgid "TOME_TELEPORTATION@SKILL1@DESCRIPTION"
msgstr "Faz o exército aliado alvo teleportar de volta à cidade mais próxima que você possui."

msgid "TOME_TELEPORTATION@SKILL1@NAME"
msgstr "Recall em Massa"

msgid "TOME_TELEPORTATION@SKILL2@DESCRIPTION"
msgstr "Invoca um {GLOBAL.UNITS.PHASE_BEAST_UNIT.Hyperlink} no hexágono mundial alvo."

msgid "TOME_TELEPORTATION@SKILL2@NAME"
msgstr "Invocar Fera de Fase"

msgid "TOME_TELEPORTATION@SKILL3@DESCRIPTION"
msgstr "Teleporta a unidade aliada mais próxima dentro de {EMERGENCY_TELEPORTATION_UNIT_TARGETER_NEAREST_TO_TARGET>MaxDista} hexágonos para o hexágono vazio alvo.[br/]Essa unidade cura +{EMERGENCY_TELEPORTATION_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> e tem todos os <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>> removidos."

msgid "TOME_TELEPORTATION@SKILL3@NAME"
msgstr "Teleporte de Emergência"

msgid "TOME_TELEPORTATION@SKILL4@DESCRIPTION"
msgstr "Concede unidades encantadas:[bulletlist][bullet/]A habilidade {GLOBAL.PROPERTIES.CHARGED_PHASE_TELEPORT.Hyperlink}, que permite que elas teleportem em batalha.[/bulletlist]"

msgid "TOME_TELEPORTATION@SKILL4@NAME"
msgstr "Encantamento de Fase"

msgid "TOME_TELEPORTATION@SKILL4@PROPERTY_DESCRIPTION"
msgstr "A unidade tem:[bulletlist][bullet/]A habilidade {GLOBAL.PROPERTIES.CHARGED_PHASE_TELEPORT.Hyperlink}.[/bulletlist]"

msgid "TOME_TELEPORTATION@SKILL5@DESCRIPTION"
msgstr "[bulletlist][bulletlist][bullet/]{gold} de renda em {GLOBAL.GoldConcept.Hyperlink}.[bullet/]{goldStack} de renda em {GLOBAL.GoldConcept.Hyperlink} por cada Relay de Comércio Astral construído em seu império.[/bulletlist][/bulletlist]"

msgid "TOME_TELEPORTATION@SKILL5@NAME"
msgstr "Relay de Comércio Astral"

msgid "TOME_TELEPORTATION@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Explore todo o potencial da magia espacial. Reposicione estrategicamente suas unidades em batalha num instante."

msgid "TOME_TELEPORTATION@TOME@LORE_AUTHOR"
msgstr "Laryssa Mirabilis, Feiticeira da Commonwealth"

msgid "TOME_TELEPORTATION@TOME@LORE_DESCRIPTION"
msgstr "\"O mago que explora plenamente o potencial da magia para ampliar suas opções táticas no campo de batalha... esse é um mago astuto. Imagine um comandante desavisado, todo preparado para um ataque iminente, que de repente se vê cercado por um ataque de pinça. A arte da teletransporte oferece possibilidades infinitas ao verdadeiro estrategista criativo.\""

msgid "TOME_TELEPORTATION@TOME@NAME"
msgstr "Tomo de Teletransporte"

msgid "TOME_TELEPORTATION@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Executa um ataque de Carga de Fase que:[bulletlist][bullet/]Teleporta a unidade para trás do alvo.{LOC.CONCEPT@CHARGE_SHARED}[/bulletlist]"

msgid "TOME_TELEPORTATION@UNIT1@ABILITY1@NAME"
msgstr "Carga de Fase"

msgid "TOME_TELEPORTATION@UNIT1@DESCRIPTION"
msgstr "Uma unidade de choque ágil e evasiva, capaz de teletransporte."

msgid "TOME_TELEPORTATION@UNIT1@NAME"
msgstr "Fera de Fase^n"

msgid "TOME_TERRA@@SKILL6@NAME"
msgstr "Montanhas Baixas"

msgid "TOME_TERRA@HERO_SKILL@DESCRIPTION"
msgstr "Faz com que ataques base {GLOBAL.MeleeConcept.Hyperlink} ganhem:[bulletlist][bullet/]+{LEADEN_BLOW_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Chance base de {SLOWED_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.SLOWED.Hyperlink}.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_TERRA@HERO_SKILL@NAME"
msgstr "Golpes de Chumbo"

msgid "TOME_TERRA@SKILL1@DESCRIPTION"
msgstr "Alvo unidade inimiga:[bulletlist][bullet/]Sofre {CRUSHING_EARTH_UNIT_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Sofre {amount} {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink} por {SUNDERED_DEFENSE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Tem chance base de {STUNNED_RESISTANCE>ResolvedStrength}% de ficar {GLOBAL.PROPERTIES.STUNNED.Hyperlink} por {STUNNED_EFFECT_DESCRIPTION>NumTurns} {GLOBAL.TurnConcept}.[/bulletlist]"

msgid "TOME_TERRA@SKILL1@NAME"
msgstr "Esmagamento da Terra"

msgid "TOME_TERRA@SKILL2@DESCRIPTION"
msgstr "Causa {SEISMIC_SHOCK_UNIT_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink} a unidades em um raio de {SEISMIC_SHOCK_OBSTACLE_TARGETER>AREA>Radius} hexágonos e inflige {GLOBAL.PROPERTIES.SLOWED.Hyperlink}.[br/]Este feitiço causa dano dobrado a obstáculos."

msgid "TOME_TERRA@SKILL2@NAME"
msgstr "Choque Sísmico"

msgid "TOME_TERRA@SKILL3@DESCRIPTION"
msgstr "Na província alvo habitável ou inabitável {GLOBAL.ProvinceConcept.Hyperlink}:[bulletlist][bullet/]Unidade inimiga <<m:{GLOBAL.UnitConcept.Hyperlink}>> sofre {damage}.[bullet/]A província perde quaisquer {GLOBAL.MountainConcept.Hyperlink}, {GLOBAL.StalagmitesConcept.Hyperlink} e {GLOBAL.DiggableEarthConcept.Hyperlink}.[bullet/]Invoca um {GLOBAL.UNITS.STONE_SPIRIT.Hyperlink} no hexágono alvo.[/bulletlist]"

msgid "TOME_TERRA@SKILL3@NAME"
msgstr "Ruptura da Terra"

msgid "TOME_TERRA@SKILL4@DESCRIPTION"
msgstr "[bulletlist][bullet/]Em batalha, a cada {turn} uma unidade inimiga aleatória é atingida por um terremoto:[bulletlist][bullet/]Unidades inimigas não voadoras e não flutuantes dentro de raio de {range} hexágonos recebem {damage}.[bullet/]Unidades inimigas não voadoras e não flutuantes dentro de raio de {range} hexágonos têm {chance} de chance de sofrer {GLOBAL.PROPERTIES.SLOWED.Hyperlink} por {turn2}.[bullet/]Obstáculos, incluindo Muros, Torres e Baluartes dentro de raio de {range} hexágonos são destruídos.[/bulletlist][/bulletlist]"

msgid "TOME_TERRA@SKILL4@NAME"
msgstr "Ritual de Tremor"

msgid "TOME_TERRA@SKILL5@DESCRIPTION"
msgstr "Invoca um {GLOBAL.UNITS.ROCK_GIANT.Hyperlink}, um {GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink} que lança rochas que atrapalham inimigos e os esmaga com tremores semelhantes a terremotos."

msgid "TOME_TERRA@SKILL5@NAME"
msgstr "Invocar Gigante de Rocha"

msgid "TOME_TERRA@SKILL6@BUFF_DESCRIPTION"
msgstr "Até que a unidade se mova, ela possui:[bulletlist][bullet/]+{LEY_LINE_FOCUS_DAMAGE_MULT>ResolvedMultiplier}% de dano[bullet/]+{LEY_LINE_FOCUS_DEFENSE>DEF_MOD>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_TERRA@SKILL6@DESCRIPTION"
msgstr "Unidades encantadas recebem:[bulletlist][bullet/]No início do turno e até que a unidade se mova, esta unidade tem:[bulletlist][bullet/]+{LEY_LINE_FOCUS_DAMAGE_MULT>ResolvedMultiplier}% de dano[bullet/]+{LEY_LINE_FOCUS_DEFENSE>DEF_MOD>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}.[/bulletlist][/bulletlist]"

msgid "TOME_TERRA@SKILL6@MOD_DESCRIPTION"
msgstr "+{LEY_LINE_FOCUS_DAMAGE_MULT>ResolvedMultiplier}% de dano até se mover."

msgid "TOME_TERRA@SKILL6@NAME"
msgstr "Foco da Linha Ley"

msgid "TOME_TERRA@SKILL6@PROP_DESCRIPTION"
msgstr "No início do turno e até que a unidade se mova, esta unidade tem:[bulletlist][bullet/]+{LEY_LINE_FOCUS_DAMAGE_MULT>ResolvedMultiplier}% de dano[bullet/]+{LEY_LINE_FOCUS_DEFENSE>DEF_MOD>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}[/bulletlist]"

msgid "TOME_TERRAMANCY@PASSIVE@DESCRIPTION"
msgstr "<<m:{GLOBAL.CityConcept}>> ganha {amount} {GLOBAL.FortificationHealthConcept} por cada {GLOBAL.ProvinceConcept} rochosa."

msgid "TOME_TERRAMANCY@PASSIVE@NAME"
msgstr "Moldadores da Terra"

msgid "TOME_TERRAMANCY@TOME@GAMEPLAY"
msgstr "Manipule a terra à vontade. Especialize-se em causar {GLOBAL.PhysicalDamageConcept.Hyperlink} e dificultar o Movimento inimigo."

msgid "TOME_TERRAMANCY@TOME@LORE"
msgstr "\"Ignore os magos medianos que buscam ressuscitar os mortos ou dominar relâmpagos e fogo para lançar contra você. Esses tolos desconhecem o poder que repousa sob seus próprios pés! Mas eles... nos momentos finais de suas insignificantes existências, quando você os enterrar sob uma montanha e rasgar a terra sob suas cidades.\""

msgid "TOME_TERRAMANCY@TOME@LORE_AUTHOR"
msgstr "Mãe Mab, Deusa dos Goblins"

msgid "TOME_TERRAMANCY@TOME@NAME"
msgstr "Tomo de Terramancia"

msgid "TOME_TRANSMUTATION@PASSIVE@DESCRIPTION"
msgstr "Pedreiras concedem {amount} {GLOBAL.FoodConcept}."

msgid "TOME_TRANSMUTATION@PASSIVE@NAME"
msgstr "Transustento"

msgid "TOME_TRANSMUTATION@SKILL1@DESCRIPTION"
msgstr "Uma vez a cada {GLOBAL.TurnConcept}, sempre que unidades encantadas são danificadas por ataques ou feitiços {GLOBAL.MagicConcept.Hyperlink}, elas recebem:[bulletlist][bullet/]{GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink}, aumentando sua resistência a dano mágico.[bullet/]{GLOBAL.PROPERTIES.STATUS_PROTECTION.Hyperlink}, reduzindo a chance de a unidade ser afetada por <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>>.[/bulletlist]"

msgid "TOME_TRANSMUTATION@SKILL1@NAME"
msgstr "Armadura Adaptativa"

msgid "TOME_TRANSMUTATION@SKILL1@PROP_DESCRIPTION"
msgstr "Uma vez a cada {GLOBAL.TurnConcept}, quando esta unidade é danificada por ataques ou feitiços {GLOBAL.MagicConcept.Hyperlink}, ela recebe:[bulletlist][bullet/]{GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.STATUS_PROTECTION.Hyperlink}[/bulletlist]"

msgid "TOME_TRANSMUTATION@SKILL2@DESCRIPTION"
msgstr "A cidade-alvo controlada converte sua renda de {GLOBAL.ManaConcept}, ganhando {GLOBAL.GoldConcept}, {GLOBAL.StructureProductionConcept} e {GLOBAL.FoodConcept} iguais a {amount}% da renda de {GLOBAL.ManaConcept}."

msgid "TOME_TRANSMUTATION@SKILL2@NAME"
msgstr "Transmutar Recursos"

msgid "TOME_TRANSMUTATION@SKILL3@DESCRIPTION"
msgstr "Alveje inimigos em um raio de {MELT_ARMOR_OBSTACLE_TARGETER_CIRCLE>AREA>Radius} hexágonos:[bulletlist][bullet/]Ganhe {stacks} {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink}.[bullet/]Sustente {MELT_ARMOR_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_TRANSMUTATION@SKILL3@NAME"
msgstr "Derreter Armadura"

msgid "TOME_TRANSMUTATION@SKILL4@DESCRIPTION"
msgstr "Um {GLOBAL.PROPERTIES.BATTLE_MAGE.Hyperlink} que transforma inimigos em ouro e pode roubar sua armadura, concedendo‑a a unidades amigas."

msgid "TOME_TRANSMUTATION@SKILL4@NAME"
msgstr "Transmutador"

msgid "TOME_TRANSMUTATION@SKILL5@DESCRIPTION"
msgstr "Transmuta a pele da raça-alvo em aço, concedendo‑les:[bulletlist][bullet/]+{STEELSKIN_DEFENSE>REDUCTION>Physical} {GLOBAL.PhysicalResistanceConcept.Hyperlink}.[bullet/]+{STEELSKIN_DEFENSE>REDUCTION>Blight} {GLOBAL.BlightResistanceConcept.Hyperlink}[bullet/]{STEELSKIN_DEFENSE>REDUCTION>Shock} {GLOBAL.LightningResistanceConcept.Hyperlink}[/bulletlist]"

msgid "TOME_TRANSMUTATION@SKILL5@NAME"
msgstr "Pele de Aço"

msgid "TOME_TRANSMUTATION@SKILL5@PROP_DESCRIPTION"
msgstr "Unidade tem:[bulletlist][bullet/]+{STEELSKIN_DEFENSE>REDUCTION>Physical} {GLOBAL.PhysicalResistanceConcept.Hyperlink}.[bullet/]+{STEELSKIN_DEFENSE>REDUCTION>Blight} {GLOBAL.BlightResistanceConcept.Hyperlink}.[bullet/]{STEELSKIN_DEFENSE>REDUCTION>Shock} {GLOBAL.LightningResistanceConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_TRANSMUTATION@TOME@GAMEPLAY@DESCRIPTION"
msgstr "Altere substâncias físicas usando grandes quantidades de mana. Especialize‑se em enfraquecer inimigos, fortalecer aliados e transformar sua economia."

msgid "TOME_TRANSMUTATION@TOME@LORE@AUTHOR"
msgstr "Tugrum Hammerhall, Mestre Artífice Anão"

msgid "TOME_TRANSMUTATION@TOME@LORE@DESCRIPTION"
msgstr "\"Uma vez dominado o reino mineral, pode‑se alcançar o realmente maravilhoso. Imagine a capacidade de manipular e alterar a própria natureza do físico. Olhar para uma substância e decidir \\\"não ser esta coisa, ser aquela em vez\\\". E assim pode‑se começar a compreender o que pode ser realizado ao aproveitar os inúmeros dons da transmutação.\""

msgid "TOME_TRANSMUTATION@TOME@NAME"
msgstr "Tomo de Transmutação"

msgid "TOME_TRANSMUTATION@UNIT1@ABILITY1@BOLT_NAME"
msgstr "Setas Derretidas"

msgid "TOME_TRANSMUTATION@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Inflige {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink} enquanto concede {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink} a um aliado aleatório dentro de {SHIFT_ARMOR_UNIT_TARGETER_JUMP>MaxDistance} hexágonos."

msgid "TOME_TRANSMUTATION@UNIT1@ABILITY1@NAME"
msgstr "Deslocar Armadura"

msgid "TOME_TRANSMUTATION@UNIT1@ABILITY2@DESCRIPTION"
msgstr "Unidades inimigas em um raio de {TRANSMUTE_UNIT_TARGETER_CIRCLE>AREA>Radius} hexágonos:[bulletlist][bullet/]Sofrem dano.[bullet/]Ganham {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink} por {SUNDERED_DEFENSE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Ganham {GLOBAL.PROPERTIES.SUNDERED_RESISTANCE.Hyperlink} por {SUNDERED_RESISTANCE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][br/]Se bem‑sucedido, concedem {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink} e {GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink} por {SUNDERED_DEFENSE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>> a todas as unidades amigas dentro de {TRANSMUTE_CIRCLE_ROUND_CASTER>AREA>Radius} hexágonos do conjurador."

msgid "TOME_TRANSMUTATION@UNIT1@ABILITY2@MASTER_DESCRIPTION"
msgstr "Unidades inimigas em um raio de {TRANSMUTE_UNIT_TARGETER_CIRCLE>AREA>Radius} hexágonos:[bulletlist][bullet/]Sofrem dano.[bullet/]Ganham {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink} por {SUNDERED_DEFENSE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Têm uma chance base de {GILDED_RESISTANCE>ResolvedStrength}% de se tornarem {GLOBAL.PROPERTIES.GILDED.Hyperlink} por {GILDED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][br/]Se bem‑sucedido, concedem {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink} por {SUNDERED_DEFENSE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>> a todas as unidades amigas dentro de {TRANSMUTE_CIRCLE_ROUND_CASTER>AREA>Radius} hexágonos do conjurador."

msgid "TOME_TRANSMUTATION@UNIT1@ABILITY2@MASTER_NAME"
msgstr "Transmutar Campeão"

msgid "TOME_TRANSMUTATION@UNIT1@ABILITY2@MASTER_PROP_DESCRIPTION"
msgstr "Transmutar:[bulletlist][bullet/]Ganha uma chance base de {GILDED_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.GILDED.Hyperlink} aos inimigos.[/bulletlist]"

msgid "TOME_TRANSMUTATION@UNIT1@ABILITY2@NAME"
msgstr "Transmutar"

msgid "TOME_TRANSMUTATION@UNIT@NAME"
msgstr "Transmutador^f"

msgid "TOME_UNDEATH@UNIT_2@NAME"
msgstr "Zumbi"

msgid "TOME_VIGOR@HERO_SKILL@DESCRIPTION"
msgstr "Enquanto esta unidade for o líder do exército, unidades não‑herói ganham:[bulletlist][bullet/]+{VIGOROUS_LEADER_STAT_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]Cura +{VIGOROUS_LEADER_STAT_BONUS>BONUS>Regen} <<m:{GLOBAL.HitPointConcept.Hyperlink}>> por turno no mapa‑múndi.[/bulletlist]"

msgid "TOME_VIGOR@HERO_SKILL@NAME"
msgstr "Líder Vigoroso"

msgid "TOME_VIGOR@PASSIVE@DESCRIPTION"
msgstr "<<m:{GLOBAL.NodeConcept}>> em seu {GLOBAL.DomainConcept} concedem {amount} {GLOBAL.FoodConcept.Hyperlink} e {GLOBAL.UnitProductionConcept.Hyperlink}."

msgid "TOME_VIGOR@PASSIVE@NAME"
