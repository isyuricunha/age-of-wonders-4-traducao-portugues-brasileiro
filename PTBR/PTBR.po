msgid "DLC@ELDRITCHREALMS@NODES_STRATEGIC@GOLD_NODE@DESCRIPTION"
msgstr "Essas formações grotescas depositam líquido e minério valiosos em velocidade antinatural."

msgid "DLC@ELDRITCHREALMS@NODES_STRATEGIC@GOLD_NODE@NAME"
msgstr "Crescimentos Quitinosos"

msgid "DLC@ELDRITCHREALMS@NODES_STRATEGIC@KNOWLEDGE_NODE@DESCRIPTION"
