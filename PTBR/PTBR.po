msgstr "Destruir Infestações concede {amount} {GLOBAL.ManaConcept} e invoca um Espírito de Fogo Menor."

msgid "TOME_PYROMANCY@PASSIVE@NAME"
msgstr "Chamas Purificadoras"

msgid "TOME_PYROMANCY@PYROMANCER@ABILITY_1@DESCRIPTION"
msgstr "Causa dano em um raio de {FLAMESTRIKE_OBSTAXCLE_TARGETER_CIRCLE>AREA>Radius} hexágonos e deixa esses hexágonos {GLOBAL.OnFireConcept.Hyperlink}."

msgid "TOME_PYROMANCY@PYROMANCER@ABILITY_1@ENCHANCED_DESCRIPTION"
msgstr "Golpe de Chama:[bulletlist][bullet/]Causa um adicional {FLAMESTRIKE_VETERAN_DAMAGE>DAMAGE>Fire}{GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Garante infligir {GLOBAL.PROPERTIES.BURNING.Hyperlink}.[/bulletlist]"

msgid "TOME_PYROMANCY@PYROMANCER@ABILITY_1@ENCHANCED_NAME"
msgstr "Golpe de Chama Aprimorado"

msgid "TOME_PYROMANCY@PYROMANCER@ABILITY_1@MASTER_DESCRIPTION"
msgstr "Golpe de Chama:[bulletlist][bullet/]Causa um adicional {FLAMESTRIKE_VETERAN_DAMAGE>DAMAGE>Fire}{GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Tem uma chance base de {BURNING_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.BURNING.Hyperlink}.[/bulletlist]"

msgid "TOME_PYROMANCY@PYROMANCER@ABILITY_1@MASTER_NAME"
msgstr "Golpe de Chama do Campeão"

msgid "TOME_PYROMANCY@PYROMANCER@ABILITY_1@NAME"
msgstr "Golpe de Chama"

msgid "TOME_PYROMANCY@SKILL1@DESCRIPTION"
msgstr "Alvo unidade inimiga:[bulletlist][bullet/]Sofre {FIREBALL_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]É infligido {GLOBAL.PROPERTIES.BURNING.Hyperlink}.[bullet/]O solo fica {GLOBAL.OnFireConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_PYROMANCY@SKILL1@NAME"
msgstr "Incendiar"

msgid "TOME_PYROMANCY@SKILL2@DESCRIPTION"
msgstr "Faz os ataques de unidades encantadas causarem:[bulletlist][bullet/]+{SEARING_STEEL_EXTRA_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]+{SEARING_STEEL_DAMAGE_MULTIPLIER>ResolvedMultiplier}% de dano contra alvos que são {GLOBAL.PROPERTIES.BURNING.Hyperlink}.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_PYROMANCY@SKILL2@MODIFIER_DESCRIPTION"
msgstr "+{SEARING_STEEL_DAMAGE_MULTIPLIER>ResolvedMultiplier}% de dano contra alvos {GLOBAL.PROPERTIES.BURNING.Hyperlink}."

msgid "TOME_PYROMANCY@SKILL2@NAME"
msgstr "Lâminas Abrasadoras"

msgid "TOME_PYROMANCY@SKILL2@PROPERTY_DESCRIPTION"
msgstr "Ataques da unidade têm:[bulletlist][bullet/]+{SEARING_STEEL_EXTRA_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]+{SEARING_STEEL_DAMAGE_MULTIPLIER>ResolvedMultiplier}% de dano contra alvos que são {GLOBAL.PROPERTIES.BURNING.Hyperlink}.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_PYROMANCY@SKILL3@DESCRIPTION"
msgstr "Um {GLOBAL.PROPERTIES.BATTLE_MAGE.Hyperlink} que espalha fogo e inflige {GLOBAL.PROPERTIES.BURNING.Hyperlink}."

msgid "TOME_PYROMANCY@SKILL3@NAME"
