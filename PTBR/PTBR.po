msgid "DLC@RISEFROMRUIN@LORDS@HERO_RACENAME@YLAC"
msgstr "Errantes Amaldiçoados"

msgid "DLC@RISEFROMRUIN@LORDS@HERO_TITLE@HAR'ACRAN"
