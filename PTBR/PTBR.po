msgid "DLC@GIANTKINGS@DIPLOMACY@CRYSTAL_DWELLING@ETERNAL_PACT@DESCRIPTION"
msgstr "[bulletlist][bullet/]O {GLOBAL.DwellingConcept.Hyperlink} compartilha sua visão.[bullet/]Desbloqueia a compra dos seguintes itens de comércio via Cooperação:[bulletlist][bullet/]{GLOBAL.TOKENDEFINITION.LITHORITE_ASTROLABE_ARTIFACT.Hyperlink}[bullet/]{GLOBAL.STRUCTURE_UPGRADES.ETERNAL_EMBASSY.Hyperlink}[bullet/]{GLOBAL.UNITS.LITHORINE_SIMULACRUM.Hyperlink}[bullet/]{GLOBAL.EQUIPMENT.ETERNAL_GOLDSEEKERS_PICKAXE.Hyperlink}[bullet/]{GLOBAL.EQUIPMENT.ETERNAL_LITHORINE_ORB.Hyperlink}[bullet/]{GLOBAL.EQUIPMENT.ETERNAL_SHATTERBLADES.Hyperlink}[bullet/]{GLOBAL.EQUIPMENT.ETERNAL_TITANS_GREATBOW.Hyperlink}[/bulletlist][bullet/]Completar missões de Moradia garante {GLOBAL.ImperiumConcept.Hyperlink} além das outras recompensas.[bullet/]O {GLOBAL.DwellingConcept.Hyperlink} concede um bônus substancial de renda de {GLOBAL.KnowledgeConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@DIPLOMACY@CRYSTAL_DWELLING@ETERNAL_PACT@HYPERLINK"
