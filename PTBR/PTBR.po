msgid "TOME_HERALDS_DOOM@SKILL3@HERO_DESCRIPTION"
msgstr "O Herói ganha +{CRUEL_DAMAGE_MULTIPLIER>ResolvedMultiplier}% de dano contra unidades com {GLOBAL.UnitMoraleConcept.Hyperlink} de \"Baixo\" ou pior."

