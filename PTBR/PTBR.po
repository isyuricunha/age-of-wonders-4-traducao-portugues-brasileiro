msgid "TOME_GREAT_TRANSFORMATION@SKILL6@DESCRIPTION"
msgstr "Ao matar unidades não raciais de Tier {amount} ou Tier {amount1}, ganhe a opção de gastar <<m:{GLOBAL.SoulConcept.Hyperlink}>> para criar um {GLOBAL.UNITS.BONE_DRAGON.Hyperlink} após o combate."

msgid "TOME_GREAT_TRANSFORMATION@SKILL6@NAME"
msgstr "Reanimação de Dragão de Ossos"

msgid "TOME_GREAT_TRANSFORMATION@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Transforme seu povo nos {GLOBAL.PROPERTIES.UNDEAD.Hyperlink} e transforme seu império em um paraíso para que prosperem."

msgid "TOME_GREAT_TRANSFORMATION@TOME@LORE_AUTHOR"
msgstr "Nekron, Mestre da Morte"

msgid "TOME_GREAT_TRANSFORMATION@TOME@LORE_DESCRIPTION"
msgstr "\"Quando você sente o poder da necromancia, começa a compreender uma verdade maior. Um império não precisa realmente de vida para existir. A vida é bagunçada. É imprevisível e ineficiente. Conceda ao seu povo o dom da morte-vida eterna e eles retribuirão com obediência eterna e ordenada.\""

msgid "TOME_GREAT_TRANSFORMATION@TOME@NAME"
msgstr "Tomo da Grande Transformação"

msgid "TOME_GREAT_TRANSFORMATION@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Um cadáver não-zumbi alvo é ressuscitado como um {GLOBAL.UNITS.DECAYING_ZOMBIE.Hyperlink} ao seu lado."

msgid "TOME_GREAT_TRANSFORMATION@UNIT1@ABILITY1@NAME"
msgstr "Invocar Zumbi em Decomposição"

msgid "TOME_GREAT_TRANSFORMATION@UNIT1@DESCRIPTION"
