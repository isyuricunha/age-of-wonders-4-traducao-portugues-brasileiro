msgstr "Valente Sombrio"

msgid "CULTURE_DARK@DARK_SURGE@DESCRIPTION"
msgstr "Causa dano a inimigos em um cone de {DARK_SURGE_TARGETER>AREA>Length} hexes. Causa o dobro de dano a unidades com {GLOBAL.NegativeStatusEffectConcept.Hyperlink}."

msgid "CULTURE_DARK@DARK_SURGE@NAME"
msgstr "Surto Sombrio"

msgid "CULTURE_DARK@DEATHLY_VITALITY@DESCRIPTION"
msgstr "Esta unidade recebe:[bulletlist][bullet/]+{DEATHLY_VITALITY_HEAL_BASELINE>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]+{DEATHLY_VITALITY_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> para cada pilha de {GLOBAL.PROPERTIES.MORTAL_BLESSING.Hyperlink}.[/bulletlist][br/]Esta unidade então entra em {GLOBAL.DefenseModeConcept}."

msgid "CULTURE_DARK@DEATHLY_VITALITY@NAME"
msgstr "Vitalidade Mortal"

msgid "CULTURE_DARK@DEATHSTALK@DESCRIPTION"
msgstr "Salta sobre a unidade inimiga alvo, empurrando-a, e então entra em {GLOBAL.DefenseModeConcept}."

