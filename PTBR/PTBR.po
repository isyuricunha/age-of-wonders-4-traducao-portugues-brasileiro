msgid "DLC@GIANTKINGS@CRISIS@1167_878@DESCRIPTION"
msgstr "Os {GLOBAL.EternalSagesLoreConcept.Hyperlink} buscam comunicar-se com seus semelhantes através do {GLOBAL.AstralSeaLoreConcept.Hyperlink}. Eles recrutaram alguém com o poder de um {GLOBAL.GodirLoreConcept.Hyperlink} para atuar como seu Mediador."

msgid "DLC@GIANTKINGS@CRISIS@1167_878@DESCRIPTION_ACTIVE"
msgstr "[bulletlist][bullet/]Cidades ganham +100% de renda de {GLOBAL.KnowledgeConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@CRISIS@1167_878@DESCRIPTION_ACTIVE_MEDIUM"
msgstr "[bulletlist][bullet/]Cidades recebem +100% de renda {GLOBAL.KnowledgeConcept.Hyperlink}.[bullet/]Como o Mediador, você recebe recompensas adicionais quando qualquer jogador completa {GLOBAL.ResearchConcept.Hyperlink}:[bulletlist][bullet/]{GLOBAL.OrderConcept.Hyperlink} pesquisa gera {GLOBAL.CityStabilityConcept.Hyperlink} em todas as suas Cidades.[bullet/]{GLOBAL.ChaosConcept.Hyperlink} pesquisa gera {GLOBAL.UnitProductionConcept.Hyperlink} em todas as suas Cidades.[bullet/]{GLOBAL.AstralConcept.Hyperlink} pesquisa gera {GLOBAL.ManaConcept.Hyperlink}.[bullet/]{GLOBAL.MateriumConcept.Hyperlink} pesquisa gera {GLOBAL.GoldConcept.Hyperlink}.[bullet/]{GLOBAL.NatureConcept.Hyperlink} pesquisa gera {GLOBAL.FoodConcept.Hyperlink} em todas as suas Cidades.[bullet/]{GLOBAL.ShadowConcept.Hyperlink} pesquisa gera {GLOBAL.KnowledgeConcept.Hyperlink} em todas as suas Cidades.[bullet/]Pesquisa sem nenhuma {GLOBAL.AffinityConcept.Hyperlink} lhe concede {GLOBAL.ImperiumConcept.Hyperlink}.[bullet/]Pesquisa dupla de {GLOBAL.AffinityConcept.Hyperlink} concede as recompensas para ambas as Afinidades.[/bulletlist][/bulletlist]"

msgid "DLC@GIANTKINGS@CRISIS@1167_878@NAME"
msgstr "O Conclave Cósmico"

msgid "DLC@GIANTKINGS@CRISIS@1167_878@SUB_HEADER"
msgstr "O {GLOBAL.CrystalDwellingConcept.Hyperlink} inicia o ritual do Conclave Cósmico."

msgid "DLC@GIANTKINGS@CRISIS@1167_878@SUB_HEADER_ACTIVE"
msgstr "[bulletlist][bullet/]Renda global de {GLOBAL.KnowledgeConcept.Hyperlink} aumentou em +100%.[/bulletlist]"

msgid "DLC@GIANTKINGS@CRISIS@1167_878@SUB_HEADER_ACTIVE_MEDIUM"
msgstr "[bulletlist][bullet/]Renda global de {GLOBAL.KnowledgeConcept.Hyperlink} aumentou em +100%.[bullet/] Você ganha bônus adicionais quando qualquer jogador completa {GLOBAL.ResearchConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@CRISIS@1194_1502@DESCRIPTION"
msgstr "O culto dos Filhos dos Kjörnoe acredita que você, o proprietário dos Artefatos Malditos da Alma, pode reavivar seus amados Reis Traidores. Para que isso aconteça, um ritual sombrio precisa ser realizado, exigindo um sacrifício poderoso..."

msgid "DLC@GIANTKINGS@CRISIS@1194_1502@NAME"
msgstr "Retorno dos Kjörnoe"

msgid "DLC@GIANTKINGS@CRISIS@1194_1502@SUB_HEADER"
msgstr "Um culto estranho se aproxima do Guardião dos Artefatos Malditos da Alma."

msgid "DLC@GIANTKINGS@CRISIS@991_7303@DESCRIPTION"
msgstr "Os Campos Famintos são amaldiçoados por uma fome incessante. Envolto em malícia, o guloso {TSR_TRAITOR_KING} manifestou <<r:TSR_TRAITOR_KING>> com três aspectos diferentes para desafiar e enfraquecer."

msgid "DLC@GIANTKINGS@CRISIS@991_7303@NAME"
msgstr "Campos Famintos"

msgid "DLC@GIANTKINGS@CRISIS@991_7303@SUB_HEADER"
msgstr "Esta região está amaldiçoada com {GLOBAL.PROPERTIES.TSR_FF_MALDICTION_OF_GLUTTONY.Hyperlink}."

msgid "DLC@GIANTKINGS@CRISIS@991_7797@DESCRIPTION"
msgstr "Ao obter os três Artefatos de Flowrock da antiga {GLOBAL.MyrridaLoreConcept.Hyperlink}, você despertou a Última Legião, um exército de Soldados de Argila e Armas Animadas que remonta ao período em que {GLOBAL.MyrridaLoreConcept.Hyperlink} foi sitiada. Seguindo suas ordens ancestrais, tomando você como um {GLOBAL.GiantKingLoreConcept.Hyperlink}, a Última Legião agora busca atacar qualquer \"invasor\" do reino."

msgid "DLC@GIANTKINGS@CRISIS@991_7797@NAME"
msgstr "A Última Legião"

msgid "DLC@GIANTKINGS@CRISIS@991_7797@SUB_HEADER"
msgstr "A Última Legião está preparando seu ataque ao reino!"

