msgid "DLC@RISEFROMRUIN@TSR_SOE@WONDER_PROPERTY@DESCRIPTION"
msgstr "Esta unidade sofre {amount} de [damagePhysical/] [hyperlink,GLOBAL.PhysicalDamageConcept]Dano Físico[/hyperlink] ao final de seu {GLOBAL.TurnConcept.Hyperlink} se nenhum {GLOBAL.CombatSpellConcept.Hyperlink} for lançado neste turno.[br/][br/]Quando um {GLOBAL.CombatSpellConcept.Hyperlink} aliado for lançado, esta unidade ganha {GLOBAL.PROPERTIES.NEW_LIFE_STEAL.Hyperlink} por {buffduration} {GLOBAL.TurnConcept.Hyperlink}."

msgid "DLC@RISEFROMRUIN@TSR_SOE@WONDER_PROPERTY@NAME"
msgstr "Deficiência de Mana"

msgid "DLC@RISEFROMRUIN@TUTORIAL@NOMADS@DESCRIPTION"
msgstr "Tutorial sobre a cultura Nômade"

msgid "DLC@RISEFROMRUIN@TUTORIAL@NOMADS@TITLE"
msgstr "Supercolheita"

msgid "DLC@RISEFROMRUIN@TUTORIAL@NOMAD_CONQUERORS@DESCRIPTION"
msgstr "Tutorial sobre a cultura dos Conquistadores Nômades"

msgid "DLC@RISEFROMRUIN@TUTORIAL@NOMAD_CONQUERORS@PAGE02@DESCRIPTION"
msgstr "Quando o <<m:{GLOBAL.NodeConcept.Hyperlink}>> ao alcance de uma cidade nômade se esgota, a cidade pode querer realocar.[br/][br/]Cidades Nômades podem embalar tudo em um {GLOBAL.NomadSettlerConcept.Hyperlink} e mudar para um novo local."

msgid "DLC@RISEFROMRUIN@TUTORIAL@NOMAD_CONQUERORS@PAGE02@INSTRUCTIONS"
msgstr "Conquistadores, em particular, preferem fundar suas cidades perto de {GLOBAL.DomainConcept.Hyperlink} hostis, pois obtêm benefício adicional ao anexar províncias hostis por meio de {GLOBAL.AggressiveExpansionConcept.Hyperlink}."

msgid "DLC@RISEFROMRUIN@TUTORIAL@NOMAD_CONQUERORS@TITLE"
msgstr "Cidades Conquistadoras Nômades"

msgid "DLC@RISEFROMRUIN@TUTORIAL@NOMAD_SCAVENGER@DESCRIPTION"
msgstr "Tutorial sobre a cultura dos Saqueadores Nômades"

msgid "DLC@RISEFROMRUIN@TUTORIAL@NOMAD_SCAVENGER@TITLE"
msgstr "Cidades Saqueadoras Nômades"

msgid "DLC@RISEFROMRUIN@TUTORIAL@NOMAD_SCAVENGERS@PAGE02@DESCRIPTION"
msgstr "Quando o <<m:{GLOBAL.NodeConcept.Hyperlink}>> ao alcance de uma cidade nômade se esgota, a cidade pode querer mudar para um novo local.[br/][br/]Cidades Nômades podem embalar tudo em um {GLOBAL.NomadSettlerConcept.Hyperlink} e mudar para um novo local."

msgid "DLC@RISEFROMRUIN@TUTORIAL@NOMAD_SCAVENGERS@PAGE02@INSTRUCTIONS"
msgstr "Saqueadores, em particular, buscam <<m:{GLOBAL.AncientWonderConcept.Hyperlink}>> para explorar {GLOBAL.WonderScavengingConcept.Hyperlink}. Procure locais perto de <<m:{GLOBAL.AncientWonderConcept.Hyperlink}>> com abundância de <<m:{GLOBAL.NodeConcept.Hyperlink}>>."

msgid "DLC@RISEFROMRUIN@TUTORIAL@OVERHARVESTING@PAGE01@DESCRIPTION"
msgstr "Cidades da cultura nômade [hyperlink,GLOBAL.OverharvestingConcept]Supercolhem[/hyperlink] <<m:{GLOBAL.NodeConcept.Hyperlink}>> em seu {GLOBAL.DomainConcept.Hyperlink}.[br/][br/]Quando esse processo termina, o {GLOBAL.NodeConcept.Hyperlink} se esgota e a cidade ganha um {GLOBAL.EssenceConcept.Hyperlink} que concede renda baseada no Nó ou {GLOBAL.MagicMaterialConcept.Hyperlink} que foi colhido."

msgid "DLC@RISEFROMRUIN@TUTORIAL@OVERHARVESTING@PAGE01@INSTRUCTIONS"
msgstr "A supercolheita de um nó pode ser acelerada usando {GLOBAL.ImperiumConcept.Hyperlink} proporcional ao tempo restante."

msgid "DLC@RISEFROMRUIN@TUTORIAL@OVERHARVESTING@TITLE"
msgstr "Supercolheita"

