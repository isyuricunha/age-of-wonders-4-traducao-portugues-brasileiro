msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALABYSS@DESCRIPTION"
msgstr "Tutorial sobre o Abismo Umbral"

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALABYSS@PAGE1@DESCRIPTION"
msgstr "Você entrou no {GLOBAL.UmbralAbyssConcept.Hyperlink}! [br/]Grandes recompensas e recursos abundantes aguardam enquanto você explora e conquista dentro desta camada {GLOBAL.WorldMapConcept.Hyperlink}."

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALABYSS@PAGE1@INSTRUCTION"
msgstr "O Abismo Umbral é um local hostil, habitado por poderosos <<m:{GLOBAL.PROPERTIES.UMBRAL_DEMON.Hyperlink}>> que se agrupam em locais como Ninho Umbral <<m:{GLOBAL.InfestationConcept.Hyperlink}>>. Além disso, seu <<m:{GLOBAL.ArmyConcept.Hyperlink}>> sofre de {GLOBAL.PROPERTIES.SHADOW_SICKNESS.Hyperlink} enquanto está no Abismo Umbral."

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALABYSS@PAGE2@DESCRIPTION"
msgstr "Para sobreviver no Abismo Umbral, você deve construir <<m:{GLOBAL.SanctuaryOutpostConcept.Hyperlink}>>, que protege seu <<m:{GLOBAL.ArmyConcept.Hyperlink}>> de {GLOBAL.PROPERTIES.SHADOW_SICKNESS.Hyperlink}. Isso também permitirá anexar <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> no Abismo Umbral."

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALABYSS@PAGE2@INSTRUCTION"
msgstr "<<m:{GLOBAL.SanctuaryOutpostConcept.Hyperlink}>> só pode ser construído em <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> com um {GLOBAL.BeaconOfLightConcept.Hyperlink}. Eles podem ser encontrados ao explorar o {GLOBAL.UmbralAbyssConcept.Hyperlink} e ao derrotar Ninho Umbral <<m:{GLOBAL.InfestationConcept.Hyperlink}>>.[br/]Postos Avançados Santuário não podem ser usados para fundar <<m:{GLOBAL.CityConcept.Hyperlink}>>."

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALABYSS@PAGE2@TITLE"
msgstr "Faróis de Luz"

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALABYSS@TITLE"
msgstr "O Abismo Umbral"

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALDWELLING@DESCRIPTION"
msgstr "Tutorial sobre Moradias Umbriais"

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALDWELLING@PAGE1@DESCRIPTION"
msgstr "Você encontrou um {GLOBAL.UmbralDwellingConcept.Hyperlink}! [br/]Esses <<m:{GLOBAL.DwellingConcept.Hyperlink}>> estão repletos de <<m:{GLOBAL.PROPERTIES.UMBRAL_DEMON.Hyperlink}>> e espalham {GLOBAL.GloomTerrainConcept.Hyperlink} enquanto se expandem por todo o {GLOBAL.UmbralAbyssConcept.Hyperlink} e para as outras camadas {GLOBAL.WorldMapConcept.Hyperlink}."

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALDWELLING@PAGE1@INSTRUCTION"
msgstr "Portanto, são uma ameaça que deve ser destruída. Uma Moradia Umbral destruída deixará para trás um {GLOBAL.BeaconOfLightConcept.Hyperlink}."

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALDWELLING@PAGE2@DESCRIPTION"
msgstr "Você também pode escolher fazer amizade com o {GLOBAL.UmbralDwellingConcept.Hyperlink} para ganhar bônus únicos.[br/]Para acessá-los, você deve alcançar um {GLOBAL.EldritchPactConcept.Hyperlink}. Isso pode ser feito aumentando {GLOBAL.HouseInfluenceConcept.Hyperlink} com o {GLOBAL.UmbralDwellingConcept.Hyperlink}."

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALDWELLING@PAGE2@INSTRUCTION"
msgstr "<<m:{GLOBAL.UmbralDwellingConcept.Hyperlink}>> são sempre considerados {GLOBAL.PROPERTIES.EVIL_3_UNIT_PROPERTY.Hyperlink} e não aceitarão um {GLOBAL.DiplomaticTokenConcept.Hyperlink}. Para [hyperlink,GLOBAL.AlignmentConcept][reputation2/] Mal [/hyperlink] <<m:{GLOBAL.LeaderConcept.Hyperlink}>>, {GLOBAL.HouseInfluenceConcept.Hyperlink} aumentará lentamente ao longo do tempo.[br/][br/]Cumprir as exigências de [reputation2/] Mal da Moradia Umbral também aumentará a [allegiance/] Aliança."

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALDWELLING@PAGE2@TITLE"
msgstr "Ofertas ou destruição"

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALDWELLING@TITLE"
msgstr "Moradias Umbrais"

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALGATE@DESCRIPTION"
msgstr "Tutorial sobre Portais Umbriais"

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALGATE@PAGE1@DESCRIPTION"
msgstr "Você encontrou um Portal Umbral! [br/]Portais Umbriais são portais para o {GLOBAL.UmbralAbyssConcept.Hyperlink}, que é uma camada no {GLOBAL.WorldMapConcept.Hyperlink} repleta de recompensas e perigos."

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALGATE@PAGE1@INSTRUCTION"
msgstr "Portais Umbriais são a única forma de acessar a camada {GLOBAL.UmbralAbyssConcept.Hyperlink}. Eles estão espalhados por todas as camadas no {GLOBAL.WorldMapConcept.Hyperlink}.[br/][br/]Dentro do Abismo Umbral há valiosos <<m:{GLOBAL.NodeConcept.Hyperlink}>>, únicos <<m:{GLOBAL.PickupConcept.Hyperlink}>> e exóticos <<m:{GLOBAL.VisitSiteConcept.Hyperlink}>>."

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALGATE@PAGE2@DESCRIPTION"
msgstr "Esteja ciente de que o terreno próximo aos Portais Umbriais e no {GLOBAL.UmbralAbyssConcept.Hyperlink} é afetado por {GLOBAL.GloomTerrainConcept.Hyperlink}."

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALGATE@PAGE2@GLOOM"
msgstr "Penumbra"

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALGATE@PAGE2@INSTRUCTION"
msgstr "<<m:{GLOBAL.UnitConcept.Hyperlink}>> em <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> afetado por {GLOBAL.GloomTerrainConcept.Hyperlink} sofrerá {GLOBAL.PROPERTIES.SHADOW_SICKNESS.Hyperlink}, [warningred]causando-lhe perda de <<m:{GLOBAL.HitPointConcept.Hyperlink}>> a cada {GLOBAL.TurnConcept.Hyperlink}[/warningred] e seu Alcance de Visão será reduzido.[br/][br/]Dano da Maldição Umbral nunca reduzirá uma unidade abaixo de {HPPercentage}% de seus [hp/] Pontos de Vida."

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALGATE@TITLE"
msgstr "Portais Umbriais"

msgid "DLC@ELDRITCHREALMS@UMBRAL_DWELLING@CITY_ADJECTIVE_01@NAME"
msgstr "Ur^a"

