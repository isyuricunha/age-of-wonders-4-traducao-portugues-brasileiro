msgstr "Praga Escarlate"

msgid "DLC@THRONESOFBLOOD@TOME_BLOOD_RITE@ABILITY02@DESCRIPTION"
msgstr "O conjurador:[bulletlist][bullet/]Sustenta {DAGGER_OF_THE_RITE_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink} imparável.[bullet/]Ganha +{DAGGER_OF_THE_RITE_DAMAGE_MULT>ResolvedMultiplier}% de dano.[bullet/]Ganha {GLOBAL.PROPERTIES.RESURGENCE.Hyperlink}[bullet/]Morre no fim do turno.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_BLOOD_RITE@ABILITY02@NAME"
msgstr "Adaga do Rito"

msgid "DLC@THRONESOFBLOOD@TOME_BLOOD_RITE@ABILITY02@PROP_DESCRIPTION"
