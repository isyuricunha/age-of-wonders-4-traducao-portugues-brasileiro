msgid "DLC@GIANTKINGS@TOME_GEOMANCY@SKILL3@NAME"
msgstr "Armas Ressonantes"

msgid "DLC@GIANTKINGS@TOME_GEOMANCY@SKILL3@PROP_DESCRIPTION"
msgstr "Ataques desta unidade:[bulletlist][bullet/]Aplicam dano extra e <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>> conforme o terreno.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@GIANTKINGS@TOME_GEOMANCY@SKILL4@DESCRIPTION"
msgstr "Convoque uma unidade {GLOBAL.PROPERTIES.ELEMENTAL.Hyperlink} de Nível III no hexágono alvo. O Elemental convocado varia de acordo com o tipo de terreno."

msgid "DLC@GIANTKINGS@TOME_GEOMANCY@SKILL4@NAME"
msgstr "Conjurar Elemental"

msgid "DLC@GIANTKINGS@TOME_GEOMANCY@SKILL5@DESCRIPTION"
msgstr "Cidade ganha recursos diferentes conforme as características de terreno da localização do núcleo da cidade:[bulletlist][bullet/]+{amount1} {GLOBAL.FoodConcept.Hyperlink} se estiver em Campos de Grama, Pântano ou Campos de Fungos.[bullet/]+{amount2} {GLOBAL.StructureProductionConcept.Hyperlink} se estiver em Floresta, Floresta de Cogumelos, Região Rochosa ou Montanhas.[bullet/]+{amount3} {GLOBAL.GoldConcept.Hyperlink} se estiver em Terras de Cinzas.[bullet/]+{amount4} {GLOBAL.ManaConcept.Hyperlink} se estiver em Neve, Gelo ou Areia.[/bulletlist]"

msgid "DLC@GIANTKINGS@TOME_GEOMANCY@SKILL5@NAME"
msgstr "Salão da Ressonância Geomântica"

msgid "DLC@GIANTKINGS@TOME_GEOMANCY@TOME@DESCRIPTION"
msgstr "Torne‑se sintonizado com as energias Ley sob você e use‑as para mudar o dano e as resistências de seus exércitos de acordo com a posição deles."

msgid "DLC@GIANTKINGS@TOME_GEOMANCY@TOME@LORE_DESCRIPTION"
msgstr "\"A Geomancia acessa a conexão arcana mais pura da terra. Firme os pés para sentir as linhas Ley invisíveis e conectar‑se aos Fluxos Astrais que ressoam abaixo. Perceba os sutis contrastes entre areia e cinza, rocha e gelo. Abrace essas distinções, torne‑se o cristal que vibra com esta canção ancestral. Abra‑se à magia da terra e testemunhe suas ofertas ilimitadas.\""

msgid "DLC@GIANTKINGS@TOME_GEOMANCY@TOME@NAME"
msgstr "Tomo de Geomancia"

msgid "DLC@GIANTKINGS@TOOLTIP@LANDMARK@DESCRIPTION"
msgstr "Marcos são um tipo de localização do tamanho de uma região inteira. Marcos não podem ser anexados ou reivindicados. Em vez disso, os marcos concedem efeitos a todas as <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacentes.[br/][br/]Se um {GLOBAL.CityConcept.Hyperlink} possuir certa quantidade de províncias em seu domínio adjacentes a um Marco, ele ganha um efeito bônus adicional dependendo do tipo de marco.[br/][br/]Marcos contam como <<m:{GLOBAL.HandcraftedRegionConcept.Hyperlink}>>, o que significa que podem ser desativados com o Traço de Reino Intocado."

msgid "DLC@GIANTKINGS@TOOLTIP@LANDMARK@HYPERLINK"
msgstr "[hyperlink,GLOBAL.LandmarkConcept]Marco[/hyperlink]"

msgid "DLC@GIANTKINGS@TOOLTIP@LANDMARK@TITLE"
msgstr "Marco"

msgid "DLC@GIANTKINGS@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@ETERNAL_COUNCIL@HYPERLINK"
