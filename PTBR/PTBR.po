msgid "DLC@RISEFROMRUIN@RUINED_WONDER_EVENT_BUTTONS@TEMPLE_SCROLLS_TERROR"
msgstr "Liberte [evilact/] todo o potencial do pergaminho [unit/] e faça ruir o {EventStructure}."

msgid "DLC@RISEFROMRUIN@RUINED_WONDER_EVENT_BUTTONS@TEMPLE_SCROLLS_TERROR@GAIN_6_EVENTUNIT"
msgstr "Você ganha um exército de 6 unidades {EventUnit.Name} que todas têm o traço {Trait.Name}."

msgid "DLC@RISEFROMRUIN@RUINED_WONDER_EVENT_BUTTONS@WELLSPRING_FAIRY_COURT"
