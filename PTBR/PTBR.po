msgid "DLC@ELDRITCHREALMS@TRAITS_BACKGROUND_CHARACTERS@ELDRITCH02@DESCRIPTION"
msgstr "{GLOBAL.LeaderConcept.Hyperlink} começa com:[bulletlist][bullet/]Uma {GLOBAL.EQUIPMENT.RELIC_OF_FLESH.Hyperlink}, uma arma de longo alcance que causa {GLOBAL.BlightDamageConcept.Hyperlink} e inflige {GLOBAL.PROPERTIES.DECAYING.Hyperlink} e {GLOBAL.PROPERTIES.POISONED.Hyperlink}.[bullet/]{GLOBAL.SKILLS.ELDRITCH_RITUALS.Hyperlink}, uma habilidade de herói que concede feitiços econômicos custando <<m:{GLOBAL.ThrallConcept.Hyperlink}>>.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TRAITS_BACKGROUND_CHARACTERS@ELDRITCH02@NAME"
msgstr "{LOC.INTERFACE@TEXT@CLASS@RITUALIST} Relíquia da Carne"

msgid "DLC@ELDRITCHREALMS@TRAITS_BACKGROUND_CHARACTERS@ELDRITCH03@DESCRIPTION"
msgstr "{GLOBAL.LeaderConcept.Hyperlink} começa com:[bulletlist][bullet/]Uma {GLOBAL.EQUIPMENT.RELIC_OF_HAVOC.Hyperlink}, uma arma de longo alcance que causa {GLOBAL.FireDamageConcept.Hyperlink} e inflige um {GLOBAL.NegativeStatusEffectConcept.Hyperlink} aleatório.[bullet/]{GLOBAL.PROPERTIES.ELDRITCH_PHASE.Hyperlink}, uma habilidade que permite um teleporte rápido em combate.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TRAITS_BACKGROUND_CHARACTERS@ELDRITCH03@NAME"
msgstr "{LOC.INTERFACE@TEXT@CLASS@MAGE} Relíquia do Caos"

msgid "DLC@ELDRITCHREALMS@TRAITS_BACKGROUND_CHARACTERS@ELDRITCH04@DESCRIPTION"
msgstr "{GLOBAL.LeaderConcept.Hyperlink} começa com:[bulletlist][bullet/]Uma {GLOBAL.EQUIPMENT.RELIC_OF_THE_COSMOS.Hyperlink}, uma arma de longo alcance que causa {GLOBAL.FireDamageConcept.Hyperlink}, {GLOBAL.FrostDamageConcept.Hyperlink} e {GLOBAL.LightningDamageConcept.Hyperlink}.[bullet/]{GLOBAL.SKILLS.HS_ASTRAL_WISP_RITUAL.Hyperlink}, uma habilidade que permite a invocação de um {GLOBAL.UNITS.ASTRAL_WISP_UNIT.Hyperlink} ao custo de <<m:{GLOBAL.ThrallConcept.Hyperlink}>>.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TRAITS_BACKGROUND_CHARACTERS@ELDRITCH04@NAME"
msgstr "{LOC.INTERFACE@TEXT@CLASS@MAGE} Relíquia do Cosmos"

