msgid "CULTURE_DARK@CULL_THE_WEAK@DESCRIPTION"
msgstr "[bulletlist][bullet/]{GLOBAL.RangedConcept.Hyperlink} e {GLOBAL.MagicConcept.Hyperlink} têm uma chance base de {chance}% de infligir {GLOBAL.PROPERTIES.WEAKENED.Hyperlink}.[bullet/]{GLOBAL.MeleeConcept.Hyperlink} contra unidades {GLOBAL.PROPERTIES.WEAKENED.Hyperlink}:[bulletlist][bullet/]Causam +{CULL_THE_WEAK_DAMAGE>ResolvedMultiplier}% de dano.[bullet/]Curam o atacante em {healing} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>, uma vez por turno.[/bulletlist][/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

