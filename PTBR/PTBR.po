msgstr "[bulletlist][bullet/]+{amount1} <<m:{GLOBAL.CombatCastingPointConcept.Hyperlink}>>[bullet/]+{amount2} <<m:{GLOBAL.WorldMapCastingPointConcept.Hyperlink}>>[/bulletlist]"

msgid "HERO_SKILLS@WIZARD_KING_02@NAME"
msgstr "Rei-Feiticeiro II"

msgid "HERO_SKILLS@WIZARD_KING_03@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{amount1} <<m:{GLOBAL.CombatCastingPointConcept.Hyperlink}>>[bullet/]+{amount2} <<m:{GLOBAL.WorldMapCastingPointConcept.Hyperlink}>>[bullet/]O herói ganha {GLOBAL.PROPERTIES.SPELL_CHANNELING.Hyperlink}[/bulletlist]"

