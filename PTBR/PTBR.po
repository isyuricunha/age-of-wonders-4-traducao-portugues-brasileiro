msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@BENEVOLENT_BLOOD_PARASITES@NAME"
msgstr "Parasitas Sanguíneos Benevolentes"

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@BENEVOLENT_BLOOD_PARASITES_2@DESCRIPTION"
msgstr "Tanto as unidades defensoras quanto as atacantes têm {GLOBAL.PROPERTIES.BENEVOLENT_BLOOD_PARASITE.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@BERSERK_BLOOD_PARASITES@DESCRIPTION"
msgstr "Todas as unidades defensoras têm {GLOBAL.PROPERTIES.BERSERK_BLOOD_PARASITE.Hyperlink} até o fim da batalha."

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@BERSERK_BLOOD_PARASITES@NAME"
msgstr "Parasitas Sanguíneos Berserkers"

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@BLOODLIGHT_REFLECTIONS@DESCRIPTION"
msgstr "A cada {GLOBAL.TurnConcept.Hyperlink}, várias áreas de {radius} hexes ganham Sangue-Luz por {turn}.[br/][br/]{GLOBAL.PROPERTIES.UNDEAD.Hyperlink} Unidades em Sangue-Luz ganham {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} e {GLOBAL.PROPERTIES.REGENERATION.Hyperlink} no fim do Turno."

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@BLOODLIGHT_REFLECTIONS@NAME"
msgstr "Reflexos da Pedra-de-Sangue"

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@BLOODLIGHT_REFRACTION@DESCRIPTION"
msgstr "Seu {GLOBAL.PROPERTIES.EXPEDITION_LEADER.Hyperlink} refrata Sangue-Luz.[br/][br/]Ao terminar o turno, removem Sangue-Luz em um raio de {radius} hexes.[br/]Se removerem Sangue-Luz dessa forma, ganham {GLOBAL.PROPERTIES.REFLECTION_SPIRIT_SHIELD.Hyperlink} por {duration}."

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@BLOODLIGHT_REFRACTION@NAME"
msgstr "Refração de Sangue-Luz"

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@ECHOING_ACOUSTICS@DESCRIPTION"
msgstr "Todos os <<m:{GLOBAL.UNITS.SHRIEKING_BAT.Hyperlink}>> têm seus ataques afetando todos os alvos em uma área de {radius} hexes do alvo principal e têm {GLOBAL.PROPERTIES.DEMOLISHER.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@ECHOING_ACOUSTICS@NAME"
msgstr "Acústica Reverberante"

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@FRAGMENTED_BLOODLIGHT_REFLECTIONS@DESCRIPTION"
msgstr "A cada {GLOBAL.TurnConcept.Hyperlink}, algumas posições ganham Sangue-Luz por {turn}.[br/][br/]{GLOBAL.PROPERTIES.UNDEAD.Hyperlink} Unidades em Sangue-Luz ganham {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} e {GLOBAL.PROPERTIES.REGENERATION.Hyperlink} no fim do Turno."

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@FRAGMENTED_BLOODLIGHT_REFLECTIONS@NAME"
msgstr "Reflexos Fragmentados da Pedra-de-Sangue"

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@JOINING_THE_FUN@DESCRIPTION"
msgstr "Seu {GLOBAL.PROPERTIES.EXPEDITION_LEADER.Hyperlink} ganha {GLOBAL.PROPERTIES.PAINBOUND_PROPERTY_GROUP.Hyperlink} e {GLOBAL.PROPERTIES.CURSE_EATER.Hyperlink} até o fim da batalha."

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@JOINING_THE_FUN@NAME"
msgstr "Entrando na Brincadeira"

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@OVERGROWN_BUSH_GARDEN@DESCRIPTION"
msgstr "Em vez de obstáculos adicionais de Roseira Rastejante, há obstáculos adicionais de Arbusto durante a batalha, que são {GLOBAL.ObscuringConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@OVERGROWN_BUSH_GARDEN@NAME"
msgstr "Jardim de Arbustos Crescidos"

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@OVERGROWN_ROSE_GARDEN@DESCRIPTION"
msgstr "Há obstáculos adicionais de Roseira Rastejante durante a batalha. Eles são {GLOBAL.SharpConcept.Hyperlink} e {GLOBAL.CreepingConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@OVERGROWN_ROSE_GARDEN@NAME"
msgstr "Jardim de Rosas Crescidas"

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@PARASITIC_INFECTION@DESCRIPTION"
msgstr "A cada {GLOBAL.TurnConcept.Hyperlink}, todas as unidades inimigas com {GLOBAL.PROPERTIES.BLEEDING.Hyperlink} têm {chance} de chance de sofrer {GLOBAL.PROPERTIES.BLOOD_PARASITE.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@PARASITIC_INFECTION@NAME"
msgstr "Contaminação Parasitária"

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@PLEASURE_FROM_PAIN@DESCRIPTION"
msgstr "Todas as unidades defensoras têm {GLOBAL.PROPERTIES.CURSE_EATER.Hyperlink} e {GLOBAL.PROPERTIES.PAINBOUND_PROPERTY_GROUP.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@PLEASURE_FROM_PAIN@NAME"
msgstr "Prazer na Dor"

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@STUNNING_SOUNDS@DESCRIPTION"
msgstr "A cada {turns}, um {GLOBAL.UNITS.SHRIEKING_BAT.Hyperlink} tem uma {chance} de sofrer {GLOBAL.PROPERTIES.STUNNED.Hyperlink} por {turns2}. Se falhar, sofre {GLOBAL.PROPERTIES.DISTRACTED.Hyperlink} por {turns2} em vez disso."

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@STUNNING_SOUNDS@NAME"
msgstr "Sons Estonteantes"

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@TAUNTED_QUEEN@DESCRIPTION"
msgstr "Todo o exército inimigo fica {GLOBAL.PROPERTIES.TAUNTED.Hyperlink} pela {GLOBAL.PROPERTIES.EXPEDITION_LEADER.Hyperlink} atacante até o fim da batalha."

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@TAUNTED_QUEEN@NAME"
msgstr "Rainha Provocada"

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@WAILING_PODS_GARDEN@DESCRIPTION"
msgstr "Obstáculos adicionais de Cápsulas Lamentosas estão presentes durante a batalha. Elas ativam {GLOBAL.PROPERTIES.WAIL_OF_THE_BANSHEE.Hyperlink} quando destruídas."

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@WAILING_PODS_GARDEN@NAME"
msgstr "Jardim de Cápsulas Lamentosas"

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@WITHERING_GARDEN@DESCRIPTION"
msgstr "A cada {GLOBAL.TurnConcept.Hyperlink}, cada Roseira Rastejante tem uma chance de {chance} de ser destruída."

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@WITHERING_GARDEN@NAME"
msgstr "Jardim Murchante"

msgid "DLC@THRONESOFBLOOD@CONCEPT@BLOOD_DRAIN_ABILITY@DESCRIPTION"
msgstr "As habilidades de drenagem de sangue de um Vampiro: {GLOBAL.PROPERTIES.DRAINING_BITE.Hyperlink} e {GLOBAL.PROPERTIES.SIPHON_BLOOD.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@CONCEPT@BLOOD_DRAIN_ABILITY@HYPERLINK"
msgstr "[hyperlink,GLOBAL.BloodDrainConcept]Drenagem de Sangue[/hyperlink]"

msgid "DLC@THRONESOFBLOOD@CONCEPT@BLOOD_DRAIN_ABILITY@NAME"
msgstr "Drenagem de Sangue"

msgid "DLC@THRONESOFBLOOD@DESCRIPTION"
msgstr "Tronos de Sangue"

msgid "DLC@THRONESOFBLOOD@DISPLAYDESCRIPTION"
msgstr "Abraçe a noite e comande legiões de condenados com a expansão Age of Wonders 4: Tronos de Sangue. Erga-se como um poderoso governante Vampiro, construa seu império sombrio nas sombras e use a antiga magia do sangue para dominar os reinos. Explore terras sem sol onde rios de sangue correm e forje pactos com criaturas da noite para garantir seu reinado eterno."

msgid "DLC@THRONESOFBLOOD@DISPLAYNAME"
msgstr "Age of Wonders 4: Tronos de Sangue"

msgid "DLC@THRONESOFBLOOD@EMPIRE_CORE@SUNLESS_REGIONS@DESCRIPTION"
msgstr "There are various places on this realm's surface the sun never seems to touch.[bulletlist][bullet/]Several hand-crafted regions with {GLOBAL.SunlessConcept.Hyperlink} can appear on the Surface.[bullet/]The {GLOBAL.STRUCTURES.THORN_HEART_LANDMARK.Hyperlink} can appear on the Surface.[bullet/]{GLOBAL.STRUCTURES.BLOOD_GLASS.Hyperlink} can appear on the Surface.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@EMPIRE_CORE@SUNLESS_REGIONS@NAME"
msgstr "Sunless Regions"

msgid "DLC@THRONESOFBLOOD@EXPLORATIONSITES_STRATEGIC@CRIMSON_FANE@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{amount} {GLOBAL.ManaConcept.Hyperlink} por {GLOBAL.ResearchPostConcept.Hyperlink} em {GLOBAL.CityConcept.Hyperlink} {GLOBAL.DomainConcept.Hyperlink}.[bullet/]Adiciona a unidade {GLOBAL.UNITS.SHRIEKING_BAT.Hyperlink} ao {GLOBAL.RequestMilitaryAidConcept.Hyperlink}.[bullet/]Se <<m:{GLOBAL.ThrallConcept.Hyperlink}>> estiverem disponíveis, a ação Sacrifício de Escravo [thralls/] neste edifício se torna disponível para ganhar permanentemente +{castingpoints1} <<m:{GLOBAL.WorldMapCastingPointConcept.Hyperlink}>> e +{castingpoints2} <<m:{GLOBAL.CombatCastingPointConcept.Hyperlink}>> deste edifício.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@EXPLORATIONSITES_STRATEGIC@CRIMSON_FANE@LORE"
msgstr "Em buracos escuros e esquecidos que perfuram a superfície do reino, portões sinistros levam a santuários sombrios. Ali, horrores indizíveis se desenvolvem nas mãos de cultistas loucos e dos abandonados. Ainda mais perturbador que o fedor metálico de sangue que sobe dessas fossas profanas são os gritos enlouquecedores e guinchos que ecoam da escuridão interna."

msgid "DLC@THRONESOFBLOOD@EXPLORATIONSITES_STRATEGIC@CRIMSON_FANE@NAME"
msgstr "Santuário Carmesim"

msgid "DLC@THRONESOFBLOOD@EXPLORATIONSITES_STRATEGIC@CRIMSON_FANE@OPERATION@DESCRIPTION"
msgstr "Sacrifique {thralls} <<m:{GLOBAL.ThrallConcept.Hyperlink}>> para ganhar permanentemente +{castingpoints1} <<m:{GLOBAL.WorldMapCastingPointConcept.Hyperlink}>> e +{castingpoints2} <<m:{GLOBAL.CombatCastingPointConcept.Hyperlink}>> desta estrutura.[br/][br/]Só pode ser feito uma vez."

msgid "DLC@THRONESOFBLOOD@EXPLORATIONSITES_STRATEGIC@CRIMSON_FANE@OPERATION@NAME"
msgstr "[thralls/] Sacrifício de Escravo"

msgid "DLC@THRONESOFBLOOD@EXPLORATIONSITES_STRATEGIC@ROSE_CHOKED_PALACE@DESCRIPTION"
msgstr "[bulletlist][bullet/]O {GLOBAL.CityConcept.Hyperlink} ignora a penalidade de {GLOBAL.CityStabilityConcept.Hyperlink} de {GLOBAL.SunlessConcept.Hyperlink} em seu {GLOBAL.DomainConcept.Hyperlink}.[bullet/]Adiciona o {GLOBAL.UNITS.ROSE_KNIGHT.Hyperlink} e várias unidades Esqueleto Enredado por Rosas ao {GLOBAL.RequestMilitaryAidConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@EXPLORATIONSITES_STRATEGIC@ROSE_CHOKED_PALACE@LORE"
msgstr "Mansões imponentes erguidas há muito tempo por senhores das trevas, o crescimento excessivo de rosas carmesins e trepadeiras espinhosas sugere abandono e decadência. No entanto, à noite, luzes bruxuleantes aparecem atrás de janelas de vidro manchado de vermelho, sugerindo que nem toda vida — ou de fato não-vida — deixou os grandiosos salões e pátios labirínticos do palácio."

msgid "DLC@THRONESOFBLOOD@EXPLORATIONSITES_STRATEGIC@ROSE_CHOKED_PALACE@NAME"
msgstr "Palácio Enredado por Rosas"

msgid "DLC@THRONESOFBLOOD@EXPLORATIONSITES_STRATEGIC@STRUCTURE_CRIMSONFANE@NAME_OVERRIDE@BLOODLETTERS_1"
