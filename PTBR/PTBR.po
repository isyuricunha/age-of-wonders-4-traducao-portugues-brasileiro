msgstr "Alvo {GLOBAL.PROPERTIES.ANIMAL.Hyperlink} ou {GLOBAL.PROPERTIES.CAVALRY_GROUP.Hyperlink} recebe, por {UNLEASH_BEAST_STATUS_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>:[bulletlist][bullet/]{amount2} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}[bullet/]{amount3} {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.BERSERK.Hyperlink}.[/bulletlist]"

msgid "TOME_VIGOR@SKILL1@NAME"
