msgid "PLAYER_INTERACTION@EVENT_IDLE@POSITIVE"
msgstr "\"Não ouvi nada sobre suas conquistas há algum tempo. Espero que esteja bem em seus esforços para expandir seu império, para que possamos nos erguer das ruínas juntos.\""

msgid "PLAYER_INTERACTION@EVENT_IMPROVEDRELATIONWITHFACTION@NEGATIVE"
