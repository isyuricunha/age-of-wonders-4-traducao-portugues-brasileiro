msgstr "Elimine os Fracos"

msgid "CULTURE_DARK@CULTOFDEATH@MORTAL_BLESSING@DESCRIPTION"
msgstr "A morte de outra unidade concedeu a esta unidade:[bulletlist][bullet/]+{MORTAL_BLESSING_STAT>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]+{MORTAL_BLESSING_MOD>ResolvedCritChanceBonus}% de {GLOBAL.CriticalHitChanceConcept.Hyperlink}[/bulletlist][br/]Acumula até {MaxStacks} vezes."

msgid "CULTURE_DARK@CULTOFDEATH@MORTAL_BLESSING@NAME"
msgstr "Bênção Mortal"

msgid "CULTURE_DARK@CULTOFDEATH@POWER_FROM_DEATH@DESCRIPTION"
msgstr "Sempre que uma unidade morre:[bulletlist][bullet/]Ganha +{Amount} {GLOBAL.PROPERTIES.MORTAL_BLESSING.Hyperlink}[bullet/]Se esta unidade desferiu o golpe final, +{KillAmount} {GLOBAL.PROPERTIES.MORTAL_BLESSING.Hyperlink} adicionais[/bulletlist]"

