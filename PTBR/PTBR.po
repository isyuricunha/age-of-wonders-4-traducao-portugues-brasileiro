msgid "DLC@ARCHONPROPHECY@STORY_REALM_MISSION_03@BRIEFING_02@DESCRIPTION"
msgstr "Esta Profecia proibia os Arcontes de se envolverem diretamente, então coube aos Godir de Magehaven escolher um dos seus que considerassem poderoso o suficiente para cumprir essa missão vital. Os Arcontes emprestariam sua força enviando seu campeão — um protegido élfico que haviam acolhido sob suas asas divinas."

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SKILL1@DESCRIPTION"
msgstr "Convoque um(a) {GLOBAL.UNITS.ARCHON_ASTRA.Hyperlink} {GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink}, uma Unidade Anjo com ataques poderosos e habilidades de cura."

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SKILL1@NAME"
msgstr "Invocar Astra"

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SKILL2@DESCRIPTION"
msgstr "Purifique as almas da raça-alvo, concedendo-lhes:[bulletlist][bullet/]No início de cada turno em combate, dissipe {amount} {GLOBAL.NegativeStatusEffectConcept.Hyperlink}.[bullet/]Se o Efeito de Status Negativo removido tiver um(a) [hyperlink,GLOBAL.OpposingStatusEffectsConcept]contador[/hyperlink] positivo(a), ganhe o(a) {GLOBAL.PositiveStatusEffectConcept.Hyperlink}.[/bulletlist][br/]Esta transformação é incompatível com {GLOBAL.SPECIAL_OPERATIONS.UMBRAL_FLESH.Hyperlink} e {GLOBAL.SPECIAL_OPERATIONS.GLOOMSTRIDER_TRANSFORMATION.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SKILL2@NAME"
msgstr "Alma Pura"

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SKILL2@PROP_DESCRIPTION"
msgstr "Unidade tem:[bulletlist][bullet/]No início de cada turno em combate, dissipa {amount} {GLOBAL.NegativeStatusEffectConcept.Hyperlink}.[bullet/]Se o Efeito de Status Negativo removido tiver um [hyperlink,GLOBAL.OpposingStatusEffectsConcept]contrário[/hyperlink] positivo, ganha o {GLOBAL.PositiveStatusEffectConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SKILL3@DESCRIPTION"
msgstr "Alvo: unidade morta que não seja Herói ou Celestial:[bulletlist][bullet/]Ressuscita como um {GLOBAL.UNITS.ARCHON_ANGEL.Hyperlink} sob o controle do conjurador até o fim do combate.[bullet/]Ao ressuscitar, todas as unidades amigas em um raio de {ASCENDED_REBIRTH_HEAL_TARGETER>AREA>Radius} hexes são curadas em {ASCENDED_REBIRTH_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SKILL3@NAME"
msgstr "Ressurreição Ascendente"

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SKILL4@DESCRIPTION"
