msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Convoque mutações e criaturas tentaculares das profundezas para restringir e imobilizar seus inimigos, mantendo-os exatamente onde você quer."

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@HERO_SKILL@DESCRIPTION"
msgstr "Conjura uma unidade {GLOBAL.UNITS.TENTACLE_UNIT.Hyperlink} no hexágono alvo.{LOC.CONCEPT@SUMMON_LIVE_SHARED}"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@HERO_SKILL@NAME"
msgstr "Manifestação de Tentáculo"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@LORE_DESCRIPTION"
msgstr "\"Deixe-se inspirar pelo tentáculo e veja como os limites da sua carne são meras restrições autoimpostas. Toque, segure, aperte seu domínio sobre seguidores e adversários. Encante seu povo com a bênção dos muitos braços para que eles também possam espalhar seu amor. Seja embalado pelo abraço do tentáculo e perceba que o único limite para o seu alcance é a sua própria imaginação.\""

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@NAME"
msgstr "Tomo do Tentáculo"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@SKILL1@DESCRIPTION"
msgstr "Um {GLOBAL.PROPERTIES.POLEARM_UNIT.Hyperlink} capaz de puxar e imobilizar oponentes."

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@SKILL1@NAME"
msgstr "Constritor"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@SKILL1@STATUS_EFFECT_NAME"
msgstr "Constringindo"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@SKILL2@DESCRIPTION"
msgstr "Invoca um(a) [hyperlink,GLOBAL.PROPERTIES.IMMOBILIZED]Imóvel[/hyperlink] {GLOBAL.PROPERTIES.FIGHTER.Hyperlink} com {GLOBAL.PROPERTIES.HYPER_AWARE_UNIT_PASSIVE.Hyperlink}.{LOC.CONCEPT@SUMMON_LIVE_SHARED}"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@SKILL2@NAME"
msgstr "Conjurar Tentáculo"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@SKILL3@DESCRIPTION"
msgstr "Faz com que os ataques base {GLOBAL.MagicConcept.Hyperlink} das unidades encantadas:[bulletlist][bullet/]Ganhem {CONSTRICTED_RESISTANCE_CHECK>ResolvedStrength}% de chance base de infligir {GLOBAL.PROPERTIES.CONSTRICTED.Hyperlink} por {CONSTRICTED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Chance aumentada para {strongerChance}% contra unidades {GLOBAL.PROPERTIES.MARKED.Hyperlink} ou {GLOBAL.PROPERTIES.SLOWED.Hyperlink}.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@SKILL3@MODIFIER_DESCRIPTION"
