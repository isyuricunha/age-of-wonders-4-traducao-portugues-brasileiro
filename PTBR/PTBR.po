msgid "HERO_SKILLS@WARLOCK@LIFESTEAL_BOND@DESCRIPTION"
msgstr "{GLOBAL.PROPERTIES.BLOOD_PACT_ABILITY.Hyperlink} ganha:[bulletlist][bullet/]O alvo ganha {GLOBAL.PROPERTIES.NEW_LIFE_STEAL.Hyperlink}[bullet/]O alvo ganha {GLOBAL.PROPERTIES.RESURGENCE.Hyperlink}[/bulletlist]"

msgid "HERO_SKILLS@WARLOCK@LIFESTEAL_BOND@NAME"
msgstr "Pacto de Servidão Eterna"

msgid "HERO_SKILLS@WARLOCK@LIFESTEAL_BOND@PROPERTY_DESCRIPTION"
msgstr "Esta unidade está vinculada a outra unidade:[bulletlist][bullet/]Qualquer dano causado à outra unidade também é causado a esta unidade.[bullet/]{GLOBAL.PROPERTIES.NEW_LIFE_STEAL.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.RESURGENCE.Hyperlink}[/bulletlist]"

msgid "HERO_SKILLS@WARLOCK@LIFESTEAL_BOND@PROPERTY_DESCRIPTION_EMPOWERED"
msgstr "Esta unidade está ligada a outra unidade:[bulletlist][bullet/]Qualquer dano causado à outra unidade também é causado a esta unidade.[bullet/]{GLOBAL.PROPERTIES.NEW_LIFE_STEAL.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.RESURGENCE.Hyperlink}[bullet/]+{BLOOD_PACT_CRITICAL>ResolvedCritChanceBonus}% {GLOBAL.CriticalHitChanceConcept.Hyperlink}[/bulletlist]"

msgid "HERO_SKILLS@WARLOCK@LIFESTEAL_BOND_ABILITY@DESCRIPTION"
msgstr "Vincula-se à unidade aliada alvo; enquanto ativo, o alvo ganha:[bulletlist][bullet/]Qualquer dano causado ao conjurador também é causado ao alvo.[bullet/]{GLOBAL.PROPERTIES.NEW_LIFE_STEAL.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.RESURGENCE.Hyperlink}[/bulletlist][br/]O conjurador ganha:[bulletlist][bullet/]+{BLOOD_PACT_DAMAGE_MULT>ResolvedMultiplier}% de dano[bullet/]Ignora {BLOOD_PACT_RESISTANCE_CHECK_BOOST>ResistanceBypass} {GLOBAL.StatusResistanceConcept.Hyperlink}[/bulletlist]"

msgid "HERO_SKILLS@WARLOCK@RITUALIZED_CURSE@DESCRIPTION"
msgstr "{GLOBAL.PROPERTIES.HS_MAGE_CURSE.Hyperlink} agora se torna uma habilidade com recarga de 2 turnos, custando uma única ação, mas pode atingir inimigos em um raio de 2 hexes."

