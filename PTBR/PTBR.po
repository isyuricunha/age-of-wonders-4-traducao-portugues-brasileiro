msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_CRYSTAL_FOREST@DESCRIPTION"
msgstr "[bulletlist][bullet/]{manabonus} {GLOBAL.ManaConcept.Hyperlink} por {GLOBAL.ConduitConcept.Hyperlink} em {GLOBAL.CityConcept.Hyperlink} {GLOBAL.DomainConcept.Hyperlink}.[bullet/]Adiciona a unidade {GLOBAL.UNITS.ASTRAL_KEEPER_UNIT.Hyperlink} ao {GLOBAL.RequestMilitaryAidConcept.Hyperlink}.[/bulletlist]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_CRYSTAL_FOREST@LORE"
msgstr "Poderosas [hyperlink,GLOBAL.AstralFlowsLoreConcept]Correntes Astrais[/hyperlink] convergem neste local. Em vez de formar um Nó de Mana comum, essas energias se cristalizaram em uma floresta de árvores cintilantes. Ramos intricados e sistemas de raízes profundos e sinuosos sugerem uma interconexão com muito do universo; <<c:{GLOBAL.SoulsLoreConcept.Hyperlink}>>, [hyperlink,GLOBAL.WorldsWithinLoreConcept]Mundos[/hyperlink], até mesmo eras. Tempo e espaço não têm significado aqui."

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_CRYSTAL_FOREST@NAME"
msgstr "Floresta de Cristal"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ENCHANTED_CAVE@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{amount} {GLOBAL.ManaConcept.Hyperlink} por {GLOBAL.QuarryConcept.Hyperlink} em {GLOBAL.CityConcept.Hyperlink} {GLOBAL.DomainConcept.Hyperlink}.[bullet/]Adiciona as unidades {GLOBAL.UNITS.STORMSCALE_SERPENT.Hyperlink} e {GLOBAL.UNITS.PLAGUE_SERPENT.Hyperlink} ao {GLOBAL.RequestMilitaryAidConcept.Hyperlink}.[/bulletlist]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ENCHANTED_CAVE@LORE"
msgstr "[lorefontsize][lorefont]Uma caverna ancestral que remonta à época da criação deste mundo, em uma era em que Dragões e Gigantes moldavam as próprias terras em forma física. Dentro desses santuários naturais, as primeiras criaturas encontraram abrigo enquanto o mundo exterior se assentava violentamente. Até hoje, a caverna permanece um santuário para aqueles que conseguem encontrá-la.[/lorefont][/lorefontsize]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ENCHANTED_CAVE@NAME"
msgstr "Caverna Ancestral"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_FORBIDDEN_CRYPT@DESCRIPTION"
msgstr "[bulletlist][bullet/]{manaincome} {GLOBAL.ManaConcept.Hyperlink}, {knowledgeincome} {GLOBAL.KnowledgeConcept.Hyperlink} e {soulsincome} {GLOBAL.SoulConcept.Hyperlink} (se obtíveis) para cada {GLOBAL.HeroConcept.Hyperlink} em {GLOBAL.CryptConcept.Hyperlink}.[bullet/]Adiciona a unidade {GLOBAL.UNITS.CORRUPT_SOUL.Hyperlink} ao {GLOBAL.RequestMilitaryAidConcept.Hyperlink}.[/bulletlist]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_FORBIDDEN_CRYPT@LORE"
msgstr "[lorefontsize][lorefont]Uma necrópole sinistra criada pelos antigos Shad'rai. Seus túneis e câmaras funerárias parecem se expandir, quase como se estivessem vivos e buscassem acomodar novos habitantes ao longo das eras. Este túmulo não apenas anseia pelos corpos dos mortos, mas também deseja devorar suas próprias <<c:{GLOBAL.SoulsLoreConcept.Hyperlink}>>.[/lorefont][/lorefontsize]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_FORBIDDEN_CRYPT@NAME"
msgstr "Tumba Perdida"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_FORBIDDEN_TEMPLE@DESCRIPTION"
msgstr "[bulletlist][bullet/]{knowledgebonus} {GLOBAL.KnowledgeConcept.Hyperlink} por {GLOBAL.ResearchPostConcept.Hyperlink} em {GLOBAL.CityConcept.Hyperlink} {GLOBAL.DomainConcept.Hyperlink}.[bullet/]Adiciona a unidade {GLOBAL.UNITS.BLESSED_SOUL.Hyperlink} ao {GLOBAL.RequestMilitaryAidConcept.Hyperlink}.[/bulletlist]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_FORBIDDEN_TEMPLE@LORE"
msgstr "[lorefontsize][lorefont]Este complexo de templos ocultos foi esquecido pelo tempo. Aqui, os {GLOBAL.ArchonsLoreConcept.Hyperlink} um dia adoraram o {GLOBAL.AllfatherLoreConcept.Hyperlink}. No entanto, a luz que ajudava as massas a se conectarem com o divino há muito se extinguiu. Os grandiosos salões do local agora atraem cultistas e entidades sinistras que buscam despertar e corromper seu poder.[/lorefont][/lorefontsize]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_FORBIDDEN_TEMPLE@NAME"
msgstr "Templo Secreto"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_FORGE@NAME_OVERRIDE@ELEMENTALS_1"
msgstr "Fundição Fogocoração"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_FORGE@NAME_OVERRIDE@ELEMENTALS_2"
msgstr "Forja Brasafonte"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_FORGE@NAME_OVERRIDE@ELEMENTALS_3"
msgstr "Forja Calcinada"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_FORGE@NAME_OVERRIDE@GIANTS_1"
msgstr "Forja Escóriafundida"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_FORGE@NAME_OVERRIDE@GIANTS_2"
msgstr "Fundição do Gigante"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_FORGE@NAME_OVERRIDE@GIANTS_3"
msgstr "Fornalha Rugidora"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_FORGE@NAME_OVERRIDE@THEONE_1"
msgstr "Bigorna da Perdição"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_FORGE@NAME_OVERRIDE@THEONE_2"
msgstr "Ferraria Espíritosavia"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_FORGE@NAME_OVERRIDE@THEONE_3"
msgstr "Fornalha Martelo Negro"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_GOLDEN_ZIGGURAT@DESCRIPTION"
msgstr "[bulletlist][bullet/]{GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> exigem {amount}% menos {GLOBAL.GoldConcept.Hyperlink} e {GLOBAL.ManaConcept.Hyperlink} {GLOBAL.UnitUpkeepConcept.Hyperlink} base nesta {GLOBAL.CityConcept.Hyperlink} {GLOBAL.DomainConcept.Hyperlink}.[bullet/]Adiciona a unidade {GLOBAL.UNITS.PHOENIX.Hyperlink} ao {GLOBAL.RequestMilitaryAidConcept.Hyperlink}.[/bulletlist]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_GOLDEN_ZIGGURAT@LORE"
msgstr "[lorefontsize][lorefont][hyperlink,GLOBAL.ArchonsLoreConcept]A civilização dos Arcontes[/hyperlink] ergueu essas estruturas monolíticas a um custo elevado. Estudiosos especulam que elas foram usadas como portais para outros [hyperlink,GLOBAL.WorldsWithinLoreConcept]Mundos[/hyperlink]. No entanto, com os construtores originais dos zigurates há muito desaparecidos, aqueles com motivos oportunistas e potencialmente sinistros vêm tentar desvendar seus poderes esquecidos.[/lorefont][/lorefontsize]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_GOLDEN_ZIGGURAT@NAME"
msgstr "Zigurate Dourado"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_GOLDEN_ZIGGURAT@UNIT_PROPERTY"
msgstr "Esta unidade exige {amount1}% menos {GLOBAL.GoldConcept.Hyperlink} e {GLOBAL.ManaConcept.Hyperlink} {GLOBAL.UnitUpkeepConcept.Hyperlink} base."

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_MAGMA_FORGE@DESCRIPTION"
msgstr "[bulletlist][bullet/]Unidades custam {amount}% {GLOBAL.GoldConcept.Hyperlink} para recrutar.[bullet/]Adiciona a unidade {GLOBAL.UNITS.FIRE_GIANT.Hyperlink} ao {GLOBAL.RequestMilitaryAidConcept.Hyperlink}.[/bulletlist]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_MAGMA_FORGE@LORE"
msgstr "[lorefontsize][lorefont]Uma forja verdadeiramente grandiosa que extrai seu calor diretamente das profundezas flamejantes do mundo. Lendas contam que os Titãs um dia utilizaram essas grandes ferramentas em seus grandiosos projetos e que os primeiros Anões podem até mesmo ter surgido desses locais primordiais.[/lorefont][/lorefontsize]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_MAGMA_FORGE@NAME"
