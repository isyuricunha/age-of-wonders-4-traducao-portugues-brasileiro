msgid "DLC@RISEFROMRUIN@CATACLYSM@TOOLTIP@DEFEAT_PLAYER"
msgstr "A cada {GLOBAL.TurnConcept.Hyperlink}, o nível do {GLOBAL.CataclysmConcept.Hyperlink} diminuirá. Quando chegar a 0, o mundo será purificado das energias fraturadas, destruindo o cataclismo e o <<m:{GLOBAL.ArtifactConcept.Hyperlink}>>, e encerrando qualquer Região Predestinada incompleta. Você pode impedir isso e conquistar os artefatos derrotando {PlayerLeader}."

msgid "DLC@RISEFROMRUIN@CATACLYSM@TOOLTIP@DEFEAT_PLAYER_SELF"
msgstr "A cada {GLOBAL.TurnConcept.Hyperlink}, o nível do {GLOBAL.CataclysmConcept.Hyperlink} diminuirá. Quando chegar a 0, o mundo será purificado das energias fraturadas, destruindo o cataclismo e o <<m:{GLOBAL.ArtifactConcept.Hyperlink}>>, e encerrando qualquer Região Predestinada incompleta."

msgid "DLC@RISEFROMRUIN@CATACLYSM@TOOLTIP@NEW_HERALD"
msgstr "Em 5 turnos, {PlayerLeader} alcançará a vitória se <<p:PlayerLeader>> não for derrotado em batalha. Durante esse período, um {GLOBAL.CataclysmConcept.Hyperlink} atacará o reino a cada turno."

msgid "DLC@RISEFROMRUIN@CATACLYSM@TOOLTIP@NEW_HERALD_PLAYER"
msgstr "Se você mantiver os três <<m:{GLOBAL.ArtifactConcept.Hyperlink}>>, alcançará a vitória em 5 turnos.\n"
"Você perderá os Artefatos se {PlayerLeader} for derrotado em combate."

msgid "DLC@RISEFROMRUIN@CATACLYSM_VICTORY@DEFEAT"
msgstr "Você foi derrotado. Os Ventos Devoradores foram dominados e consumiram tudo. As ruínas do seu império ainda podem ser redescobertas neste reino disperso."

msgid "DLC@RISEFROMRUIN@CATACLYSM_VICTORY@DEFEAT_NAME"
msgstr "{OtherPlayer.Name} alcançou o {GLOBAL.CataclysmVictoryConcept.Hyperlink}."

msgid "DLC@RISEFROMRUIN@CATACLYSM_VICTORY@DESCRIPTION"
msgstr "Encontre Hubris suficiente dos Unmakers <<m:{GLOBAL.ArtifactConcept.Hyperlink}>> para dominar os Ventos Devoradores, que podem ser encontrados ao explorar Regiões Predestinadas ou ao tomá‑los de outros jogadores. Quando 3 forem encontrados, você poderá reivindicar a vitória!"

msgid "DLC@RISEFROMRUIN@CATACLYSM_VICTORY@SUB_TEXT"
msgstr "Dominando os Ventos Devoradores"

msgid "DLC@RISEFROMRUIN@CATACLYSM_VICTORY@VICTORY"
msgstr "Era do Cataclismo"

msgid "DLC@RISEFROMRUIN@CATACLYSM_VICTORY@VICTORY@ALLY_DESCRIPTION"
msgstr "{OtherPlayer.Name} dominou os Ventos Devoradores com os Artefatos dos Unmakers. Juntos, vocês empunham o poder dos Cataclismos!"

msgid "DLC@RISEFROMRUIN@CATACLYSM_VICTORY@VICTORY@DESCRIPTION"
msgstr "Os Ventos Devoradores foram dominados pelos Artefatos dos Unmakers. Seu poder corre em suas veias.[br/]Hubris ou não, agora você empunha o poder dos Cataclismos!"

msgid "DLC@RISEFROMRUIN@CATACLYSM_VICTORY@VICTORY_CONDITION@DESCRIPTION"
msgstr "Para alcançar a Vitória do Cataclismo, explore os Ecos da Fraturação em busca do <<m:{GLOBAL.ArtifactConcept.Hyperlink}>> dos {GLOBAL.UnmakersLoreConcept.Hyperlink} nas Regiões Predestinadas.[br/][br/]Adquira 3 <<m:{GLOBAL.ArtifactConcept.Hyperlink}>> para reivindicar a vitória."

msgid "DLC@RISEFROMRUIN@CATACLYSM_VICTORY@VICTORY_CONDITION@HYPERLINK"
msgstr "[hyperlink,GLOBAL.CataclysmVictoryConcept]Vitória do Cataclismo[/hyperlink]"

