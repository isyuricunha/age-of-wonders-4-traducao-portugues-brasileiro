msgid "COMBATPROPERTIES_TACTICAL@HASTENED_ARMY@NAME"
msgstr "Atacantes Acelerados"

msgid "COMBATPROPERTIES_TACTICAL@HASTENED_ENEMIES@DESCRIPTION"
msgstr "No início da batalha, todas as unidades defensoras recebem {GLOBAL.PROPERTIES.HASTENED.Hyperlink} por {time} [turn/]."

msgid "COMBATPROPERTIES_TACTICAL@HASTENED_ENEMIES@NAME"
msgstr "Defensores Acelerados"

msgid "COMBATPROPERTIES_TACTICAL@HASTENING_STORM@DESCRIPTION"
msgstr "No início de um turno, pelos próximos {TimeToLive} <<m:{GLOBAL.TurnConcept}>> uma unidade atacante aleatória recebe {Shock} {GLOBAL.LightningDamageConcept.Hyperlink}, mas também se torna {GLOBAL.PROPERTIES.HASTENED.Hyperlink} por {valueOfHaste} {GLOBAL.TurnConcept}."

msgid "COMBATPROPERTIES_TACTICAL@HASTENING_STORM@NAME"
