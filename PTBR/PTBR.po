msgid "DLC@ELDRITCHREALMS@RACETRAITS_WORLD@KEEPERS_OF_KNOWLEDGE@EFFECT1@DESCRIPTION"
msgstr "Desbloquear uma nova Habilidade de Pesquisa concede +10 {GLOBAL.HouseInfluenceConcept.Hyperlink} com todas as <<m:{GLOBAL.IndependentCityConcept.Hyperlink}>> às quais você designou um {GLOBAL.DiplomaticTokenConcept.Hyperlink}."

msgid "DLC@ELDRITCHREALMS@RACETRAITS_WORLD@KEEPERS_OF_KNOWLEDGE@EFFECT2@DESCRIPTION"
msgstr "Desbloquear um novo {GLOBAL.TomeConcept.Hyperlink} concede +{amount} de Relação com todos os <<m:{GLOBAL.EmpireConcept.Hyperlink}>>."

msgid "DLC@ELDRITCHREALMS@RACETRAITS_WORLD@KEEPERS_OF_KNOWLEDGE@EFFECT3@DESCRIPTION"
msgstr "Ganhe +{amount} de renda de {GLOBAL.KnowledgeConcept.Hyperlink} para cada império com o qual você tenha {GLOBAL.OpenBordersConcept.Hyperlink}."

