msgid "DLC@GIANTKINGS@GOM_FINISHER@DESCRIPTION_NON_HEIR"
msgstr "A Última Legião está despertando para atacar todas as cidades do reino. Eles parecem agir sob as antigas ordens do <<m:{GLOBAL.GiantKingLoreConcept.Hyperlink}>> de {GLOBAL.MyrridaLoreConcept.Hyperlink}, sem saber que o império que buscam defender há muito foi destruído."

msgid "DLC@GIANTKINGS@GOM_FINISHER@GRIEVANCE"
msgstr "{STR_leaderName} libertou a Última Legião sobre este reino!"

