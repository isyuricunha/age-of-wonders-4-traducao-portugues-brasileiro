msgid "UNITPROPERTIES@ARMY_MOUNTAIN_WALK@NAME"
msgstr "Escalada de Exército"

msgid "UNITPROPERTIES@ARMY_RECUPERATION@DESCRIPTION"
msgstr "Todas as unidades no exército recuperam +{ARMY_RECUPERATION_STAT_BONUS>BONUS>Regen} <<m:{GLOBAL.HitPointConcept.Hyperlink}>> a cada {GLOBAL.WorldMapConcept.Hyperlink} {GLOBAL.TurnConcept.Hyperlink}.[br/][br/]Não acumula."

msgid "UNITPROPERTIES@ARMY_RECUPERATION@NAME"
msgstr "Recuperação de Exército"

