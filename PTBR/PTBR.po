msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@CONJURE_ROSE_KNIGHT@PASSIVE_NAME"
msgstr "Recrutamento de Cavaleiro da Rosa"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@DESECRATION@SKILL01@ABILITY_DESCRIPTION"
msgstr "Alvo cadáver explode e todas as unidades inimigas em um raio de {DARK_SACRAMENT_CIRCLE_TARGETER>AREA>Radius} hexágonos dele sofrem dano."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@DESECRATION@SKILL01@ABILITY_NAME"
msgstr "Sacramento Sombrio"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@DESECRATION@SKILL01@NAME"
msgstr "Profanador"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@DESECRATION@SKILL01@PASSIVE_DESCRIPTION"
msgstr "No início do combate, conjure um {GLOBAL.UNITS.ZOMBIE.Hyperlink}.[br/][br/]Não funciona em Combate Aquático."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@DESECRATION@SKILL01@PASSIVE_NAME"
msgstr "Servos Mortos-Vivos"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@DESECRATION@SKILL02@DESCRIPTION"
msgstr "Ataques removem {GENERAL_DISPEL_POSITIVE>NumThingsToDispel} {GLOBAL.PositiveStatusEffectConcept.Hyperlink}. Ataques de Disparo Único removem {amount2} <<m:{GLOBAL.PositiveStatusEffectConcept.Hyperlink}>> em vez disso."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@DESECRATION@SKILL02@MOD_DESCRIPTION"
msgstr "Chance base de {DIFILER_MAGE_RESISTANCE_CHECK>ResolvedStrength}% de remover um efeito de status positivo. Ao ter sucesso, cura {DEFILER_MAGE_HEAL>NumHitpointsToRestore}."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@DESECRATION@SKILL02@NAME"
msgstr "Profanador"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@DESECRATION@SKILL04@ABILITY_DESCRIPTION"
msgstr "Conjure {GRAVEMARCH_POSITION_TARGETER>RandomHexes} cadáveres de unidades Esqueleto Espinhoso de Nível I em um raio de {GRAVEMARCH_POSITION_TARGETER>AREA>Radius} hexágonos.[br/]Durante os próximos {GRAVEMARCH_AUTO_SPELL>TimeToLive} <<m:{GLOBAL.TurnConcept}>>, ressuscite um cadáver aleatório no campo de batalha sob seu controle até o fim do combate."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@DESECRATION@SKILL04@COMBAT_DESCRIPTION"
msgstr "No início do turno do conjurador, um cadáver aleatório ressuscita sob o controle do conjurador."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@DESECRATION@SKILL04@NAME"
msgstr "Marcha dos Túmulos"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@DESECRATION@SKILL05@ABILITY_DESCRIPTION"
msgstr "Conjure {GRAVEMARCH_POSITION_TARGETER>RandomHexes} cadáveres de unidades {GLOBAL.PROPERTIES.UNDEAD.Hyperlink} de Nível III e, às vezes, de Nível IV em um raio de {GRAVEMARCH_POSITION_TARGETER>AREA>Radius} hexágonos. Durante os próximos {GRAVEMARCH_AUTO_SPELL>TimeToLive} <<m:{GLOBAL.TurnConcept}>>, ressuscite um cadáver aleatório no campo de batalha sob seu controle."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@DESECRATION@SKILL05@DESCRIPTION"
msgstr "{GLOBAL.PROPERTIES.GRAVEMARCH.Hyperlink} agora conjura os corpos de unidades Mortas-Vivas de Nível 3 e Nível 4 e tem seu tempo de recarga reduzido em {amount}."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@DESECRATION@SKILL05@NAME"
