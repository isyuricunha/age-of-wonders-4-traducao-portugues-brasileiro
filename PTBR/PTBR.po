msgid "DIPLOMATICSTATES_DEFINITIONS@BREAK_ALLOWCLAIMEDSECTORS@NAME"
msgstr "Romper Pacto de Reclamação de Províncias"

msgid "DIPLOMATICSTATES_DEFINITIONS@BREAK_CONSULATE@DESCRIPTION"
