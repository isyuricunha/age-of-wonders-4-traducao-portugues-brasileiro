msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_05@ENHANCED_DESCRIPTION"
msgstr "Olhar da Ruína:[bulletlist][bullet/]Causa um dano adicional de {DOOMGAZE_ENHANCED_DAMAGE>DAMAGE>Blight}{GLOBAL.BlightDamageConcept.Hyperlink}[bullet/] e garante infligir {GLOBAL.PROPERTIES.STUNNED.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_05@ENHANCED_NAME"
msgstr "Olhar da Ruína Aprimorado"

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_05@MASTER_DESCRIPTION"
