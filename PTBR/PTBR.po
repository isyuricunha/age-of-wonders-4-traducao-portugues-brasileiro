msgid "DLC@RISEFROMRUIN@CULTURE_NOMAD@SUBCULTURE@CONQUERERS@RESEARCH_SKILL@SWIFTSTRIKE_BLESSING@DESCRIPTION"
msgstr "Unidade aliada alvo que tem pontos de ação restantes e outra dentro de {SWIFTSTRIKE_BLESSING_TARGETER>MaxDistance} hexes ganha:[bulletlist][bullet/]{GLOBAL.PROPERTIES.EMPOWERING_MOMENTUM.Hyperlink} por {MOMENTUM_STATUS_EFFECT>NumTurns} <<m:{GLOBAL.TurnConcept.Hyperlink}>>.[bullet/]{GLOBAL.PROPERTIES.FORTUNE.Hyperlink} por {FORTUNE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept.Hyperlink}>>.[/bulletlist]"

