msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@ASCENSION_TRAIT@FIERY_SEDUCTOR@HERO_TRAIT_DESCRIPTION"
msgstr "[bulletlist][bullet/]Obtenha a habilidade {GLOBAL.PROPERTIES.KISS_OF_SEDUCTION.Hyperlink}.[bullet/]Os ataques recebem +{FIERY_SEDUCTOR_EXTRA_DMG>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}. Aumento para Disparo Único.[bullet/]Ganhe +{FIERY_SEDUCTOR_FIRE_RESISTANCE>REDUCTION>Fire} {GLOBAL.FireResistanceConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@ASCENSION_TRAIT@FIERY_SEDUCTOR@HERO_TRAIT_NAME"
msgstr "Ascensão: Sedutor Flamejante"

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@ASCENSION_TRAIT@FIERY_SEDUCTOR@NAME"
