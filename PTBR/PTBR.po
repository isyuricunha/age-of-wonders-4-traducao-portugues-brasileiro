msgid "TOME_DEMON_GATE@SKILL1@DESCRIPTION"
msgstr "A cidade-alvo perde {amount} {GLOBAL.PopulationConcept.Hyperlink} e gera um {GLOBAL.UNITS.BALOR.Hyperlink}, uma unidade mítica que causa estragos aos seus inimigos."

msgid "TOME_DEMON_GATE@SKILL1@NAME"
