msgid "SPEC_WILDMAGIC@SWAP_LOCATION@NAME"
msgstr "Trocar de Posição"

msgid "STACK@CONFIRM_SPEED_MARCH@DESCRIPTION"
msgstr "Unidades neste exército recuperam {movepointgain} de seu total de <<m:{GLOBAL.MovePointConcept.Hyperlink}>>.[br/]Unidades perdem {STR_HitpointPcnt}% de seu total de <<m:{GLOBAL.HitPointConcept.Hyperlink}>> e tornam‑se {GLOBAL.PROPERTIES.EXHAUSTED.Hyperlink} por {STR_ExhaustTurns} <<m:{GLOBAL.TurnConcept.Hyperlink}>>.[br/]Custo: {STR_Cost} ({STR_UnitCost} por unidade)."

msgid "STACK@CONFIRM_SPEED_MARCH@TITLE"
msgstr "Marcha Forçada"

