msgid "TOME_DEMON_GATE@SKILL2@DESCRIPTION"
msgstr "Escolha um(a) dos seus {GLOBAL.IndependentCityConcept.Hyperlink} <<m:{GLOBAL.PvEVassalConcept.Hyperlink}>>:[bulletlist][bullet/]Invoca {summon} <<m:{GLOBAL.PROPERTIES.FIEND.Hyperlink}>> aleatórios sob seu controle, um será de Nível III e o outro de Nível IV.[bullet/]O(a) {GLOBAL.PvEVassalConcept.Hyperlink} perde:[bulletlist][bullet/]Um estágio diplomático de {GLOBAL.VassalagePhaseConcept.Hyperlink}.[bullet/]{pop} {GLOBAL.PopulationConcept.Hyperlink}.[/bulletlist][/bulletlist][br/]Não pode ser conjurado em um(a) {GLOBAL.PactOfVassalageLvl-3Concept.Hyperlink}."

msgid "TOME_DEMON_GATE@SKILL2@NAME"
