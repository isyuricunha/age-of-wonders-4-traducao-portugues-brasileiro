msgid "DLC@ELDRITCHREALMS@ELDRITCH_SPECIALIZATION@MADCASTER@ABILITY01@DESCRIPTION"
msgstr "Inimigos em um raio de {hex} hexes sofrem {amount} destes efeitos aleatoriamente:[bulletlist][bullet/]Se transformam em uma {GLOBAL.PROPERTIES.ANIMAL.Hyperlink} Aleatória de Nível I por {animalDuration} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Sofrem {firedamage} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Ganham {GLOBAL.PROPERTIES.INSANITY.Hyperlink} por {InsaneDuration} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Ficam {GLOBAL.PROPERTIES.BLINDED.Hyperlink} até o final do combate.[bullet/]{moraleAmount} {GLOBAL.UnitMoraleConcept.Hyperlink}.[bullet/]Sofrem {frostdamage} {GLOBAL.FrostDamageConcept.Hyperlink} e ficam {GLOBAL.PROPERTIES.FROZEN.Hyperlink} por {frozenDuration} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Ganham {GLOBAL.PROPERTIES.INFERNAL_REBIRTH.Hyperlink} até o final do combate.[bullet/]Ganham {electrifyAmount} {GLOBAL.PROPERTIES.ELECTRIFIED.Hyperlink}.[bullet/]Recuperam {healAmount} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@ELDRITCH_SPECIALIZATION@MADCASTER@ABILITY01@NAME"
