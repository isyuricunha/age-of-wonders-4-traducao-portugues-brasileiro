msgid "EXPANSION_VICTORY@VICTORY_CONDITION@DESCRIPTION"
msgstr "Quando um {GLOBAL.EmpireConcept.Hyperlink} cresce o suficiente, seja por si próprio {GLOBAL.DomainConcept.Hyperlink} ou por [hyperlink,GLOBAL.PactOfVassalageConcept]Vassalizando[/hyperlink] <<m:{GLOBAL.IndependentCityConcept.Hyperlink}>>, ele pode buscar a vitória de expansão. Para isso, precisará construir três <<m:{GLOBAL.STRUCTURE_UPGRADES.BEACONOFUNITY.Hyperlink}>> e acendê‑los. Se o império e seus [hyperlink,GLOBAL.DSAllianceConcept]Aliados[/hyperlink] puderem defender e manter seus faróis por tempo suficiente, serão vitoriosos."

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ANCIENT_TREE@DESCRIPTION"
msgstr "[bulletlist][bullet/]{manabonus} {GLOBAL.ManaConcept.Hyperlink} e {knowledgebonus} {GLOBAL.KnowledgeConcept.Hyperlink} por {GLOBAL.ForesterConcept.Hyperlink} em {GLOBAL.CityConcept.Hyperlink} {GLOBAL.DomainConcept.Hyperlink}. [bullet/]Adiciona {GLOBAL.UNITS.ENTWINED_THRALL_UNIT.Hyperlink}, {GLOBAL.UNITS.ENTWINED_PROTECTOR_UNIT.Hyperlink} e {GLOBAL.UNITS.ENTWINED_SCOURGE_UNIT.Hyperlink} ao {GLOBAL.RequestMilitaryAidConcept.Hyperlink}.[/bulletlist]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ANCIENT_TREE@LORE"
msgstr "[lorefontsize][lorefont]A Escritura descreve como os Primeiros Elfos visitaram todos os [hyperlink,GLOBAL.WorldsWithinLoreConcept]Mundos[/hyperlink] para semear vida neles. Esta magnífica árvore permanece como um testemunho daquela era. Dizem que as almas desses Primeiros ainda residem dentro dela, às vezes manifestando‑se como os Entwined, eternamente ligados a proteger seu crescimento.[/lorefont][/lorefontsize]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ANCIENT_TREE@NAME"
msgstr "Árvore-Mundo"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ANCIENT_WELLSPRING@DESCRIPTION"
msgstr "[bulletlist][bullet/]{stabilitybonus} {GLOBAL.CityStabilityConcept.Hyperlink} por {GLOBAL.FarmConcept.Hyperlink} e {GLOBAL.ForesterConcept.Hyperlink} em {GLOBAL.CityConcept.Hyperlink} {GLOBAL.DomainConcept.Hyperlink}.[bullet/]Amigáveis <<m:{GLOBAL.UnitConcept.Hyperlink}>> em {GLOBAL.DomainConcept.Hyperlink} são curadas em {healamount} <<m:{GLOBAL.HitPointConcept.Hyperlink}>> ao final de cada {GLOBAL.TurnConcept.Hyperlink} estratégico.[bullet/]Adiciona {GLOBAL.UNITS.SPRING_FAIRY.Hyperlink}, {GLOBAL.UNITS.SUMMER_FAIRY.Hyperlink}, {GLOBAL.UNITS.AUTUMN_FAIRY.Hyperlink} e {GLOBAL.UNITS.WINTER_FAIRY.Hyperlink} ao {GLOBAL.RequestMilitaryAidConcept.Hyperlink}.[/bulletlist]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ANCIENT_WELLSPRING@LORE"
msgstr "[lorefontsize][lorefont]Esta localização exuberante é alimentada por uma nascente mágica que flui diretamente do reino feérico. Águas místicas atraem todo tipo de criaturas, sem saber que são potenciais vítimas das travessuras do povo das fadas. Embora o que uma fada considere travessura possa ser potencialmente mortal para outros! Mesmo os seres mais poderosos devem prosseguir com certa cautela.[/lorefont][/lorefontsize]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ANCIENT_WELLSPRING@NAME"
msgstr "Nascente Oculta"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ARCHON_RUINS@DESCRIPTION"
msgstr "[bulletlist][bullet/]{quarryincome} por {GLOBAL.QuarryConcept.Hyperlink} em {GLOBAL.CityConcept.Hyperlink} {GLOBAL.DomainConcept.Hyperlink}. [bullet/]Pode ser definido como um local de implantação de {GLOBAL.UnitConcept.Hyperlink}. [bullet/]Adiciona as unidades {GLOBAL.UNITS.BREWER_OGRE.Hyperlink} e {GLOBAL.UNITS.BUTCHER_OGRE.Hyperlink} ao {GLOBAL.RequestMilitaryAidConcept.Hyperlink}. [/bulletlist]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ARCHON_RUINS@LORE"
msgstr "[lorefontsize][lorefont]As ruínas de uma imensa fortaleza que remonta a uma era em que as primeiras civilizações se ergueram contra monstros gigantescos e tempestades mágicas desenfreadas. Embora castigada, suas paredes desgastadas ainda oferecem certo grau de proteção aos que estão dentro e aos que estão próximos durante tempos de discórdia.[/lorefont][/lorefontsize]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ARCHON_RUINS@NAME"
msgstr "Ruínas do Castelo"

