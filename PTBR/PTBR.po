msgid "INTERFACE@MAP_SETUP_TOOLTIP@PLAYER_DISTANCE"
msgstr "Gera um tamanho de mapa com base no número de jogadores, com uma distância variável entre as posições iniciais dos jogadores."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@PLAYER_EMPIRE_MECHANICS"
msgstr "Quando ativado, {GLOBAL.PantheonLoreConcept.Hyperlink} <<m:{GLOBAL.LeaderConcept.Hyperlink}>> começarão com <<m:{GLOBAL.AscensionTraitConcept.Hyperlink}>>, <<m:{GLOBAL.AscendedTransformationConcept.Hyperlink}>> e habilidades de herói ascendido. Além disso, governantes do panteão marcados como heróis recrutáveis podem ser oferecidos como herói e, na vitória, um governante pode ascender ao Panteão.[br/][br/]Governantes do panteão sempre podem ser selecionados independentemente desta configuração."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@PLAYER_EMPIRE_MECHANICS_BONUSTRAIT"
msgstr "Quando ativado, {GLOBAL.PantheonLoreConcept.Hyperlink} <<m:{GLOBAL.LeaderConcept.Hyperlink}>> começarão com <<m:{GLOBAL.AscensionTraitConcept.Hyperlink}>>.{LOC.INTERFACE@MAP_SETUP_TOOLTIP@PLAYER_EMPIRE_MECHANICS_GENERAL}"

msgid "INTERFACE@MAP_SETUP_TOOLTIP@PLAYER_EMPIRE_MECHANICS_GENERAL"
msgstr "[br/][br/]Governantes do panteão sempre podem ser selecionados independentemente desta configuração e, na vitória, um governante pode ascender ao Panteão."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@PLAYER_EMPIRE_MECHANICS_HERORECRUITMENT"
msgstr "Quando ativado, {GLOBAL.PantheonLoreConcept.Hyperlink} <<m:{GLOBAL.LeaderConcept.Hyperlink}>> marcados como heróis recrutáveis podem ser oferecidos como herói. Em Multijogador e Reinos de História, governantes do panteão não podem ser recrutados como heróis.{LOC.INTERFACE@MAP_SETUP_TOOLTIP@PLAYER_EMPIRE_MECHANICS_GENERAL}"

msgid "INTERFACE@MAP_SETUP_TOOLTIP@PLAYER_EMPIRE_MECHANICS_TRANSFORMATIONS"
msgstr "Quando ativado, {GLOBAL.PantheonLoreConcept.Hyperlink} <<m:{GLOBAL.LeaderConcept.Hyperlink}>> começarão com <<m:{GLOBAL.AscendedTransformationConcept.Hyperlink}>> e habilidades de herói ascendido.{LOC.INTERFACE@MAP_SETUP_TOOLTIP@PLAYER_EMPIRE_MECHANICS_GENERAL}"

msgid "INTERFACE@MAP_SETUP_TOOLTIP@RANDOM_TRAIT_FILTER_LIST"
