msgid "DIPLOMATICSTATES_DEFINITIONS@BREAK_VASSALAGE@NAME"
msgstr "Encerrar Vassalagem"

msgid "DIPLOMATICSTATES_DEFINITIONS@CONSULATE@AI_DESC"
msgstr "O vínculo do feiticeiro melhorará nossas relações e ampliará nossas opções diplomáticas."

msgid "DIPLOMATICSTATES_DEFINITIONS@CONSULATE@DESCRIPTION"
msgstr "Ambos <<m:{GLOBAL.LeaderConcept.Hyperlink}>> concordam com um Vínculo de Feiticeiro para melhorar {GLOBAL.EmpireRelationConcept.Hyperlink} e acessar novos <<m:{GLOBAL.TreatyConcept.Hyperlink}>> e Estados Diplomáticos.[br/][br/]Efeitos:[bulletList][bullet/]A {GLOBAL.ThroneCityConcept.Hyperlink} de cada Governante será revelada.[bullet/]Governantes podem [hyperlink,GLOBAL.CallToWarConcept]convocar uns aos outros para a guerra[/hyperlink].[/bulletList][br/][br/]Leva a:[bulletlist][bullet/]{GLOBAL.DefensivePactConcept.Hyperlink}[bullet/]{GLOBAL.OpenBordersConcept.Hyperlink}[bullet/]{GLOBAL.AllowClaimedSectorsConcept.Hyperlink}[bullet/]{GLOBAL.TeleporterPactConcept.Hyperlink}[/bulletlist]"

msgid "DIPLOMATICSTATES_DEFINITIONS@CONSULATE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.MutualConsulateConcept]Vínculo do Feiticeiro[/hyperlink]"

msgid "DIPLOMATICSTATES_DEFINITIONS@CONSULATE@NAME"
msgstr "Vínculo do Feiticeiro"

msgid "DIPLOMATICSTATES_DEFINITIONS@DEFENSIVEPACT@AI_DESC"
msgstr "Um pacto defensivo garantirá que nenhum outro Governante ouse nos desafiar."

msgid "DIPLOMATICSTATES_DEFINITIONS@DEFENSIVEPACT@DESCRIPTION"
msgstr "Um Estado Diplomático no qual os <<m:{GLOBAL.LeaderConcept.Hyperlink}>> prometem ajudar um ao outro em guerras defensivas.[br/][br/]Quando a guerra for declarada contra qualquer Governante, eles enviarão automaticamente um {GLOBAL.CallToWarConcept.Hyperlink} ao outro, pedindo que o ajude na guerra. Responder a esse chamado à guerra concederá ao Governante <<m:{GLOBAL.CasusBelliConcept.Hyperlink}>> adicionais para usar diretamente. Os Governantes ainda podem recusar esse chamado, mas romperão o pacto defensivo se o fizerem.[br/][br/]Leva a:[bulletlist][bullet/]{GLOBAL.DSAllianceConcept.Hyperlink}[bullet/]{GLOBAL.ShareVisionConcept.Hyperlink}[/bulletlist]"

msgid "DIPLOMATICSTATES_DEFINITIONS@DEFENSIVEPACT@HYPERLINK"
msgstr "[rs_defensivepact/][hyperlink,GLOBAL.DefensivePactConcept]Pacto Defensivo[/hyperlink]"

msgid "DIPLOMATICSTATES_DEFINITIONS@DEFENSIVEPACT@NAME"
msgstr "Pacto Defensivo"

msgid "DIPLOMATICSTATES_DEFINITIONS@OPENBORDERS@AI_DESC"
msgstr "Abramos nossas fronteiras um ao outro. Isso melhoraria muito nossa mobilidade."

msgid "DIPLOMATICSTATES_DEFINITIONS@OPENBORDERS@DESCRIPTION"
msgstr "Ambos <<m:{GLOBAL.LeaderConcept}>> abrem suas fronteiras um ao outro. Isso permite que <<m:{GLOBAL.ArmyConcept.Hyperlink}>> se mova através de <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> do Governante adversário sem [hyperlink,GLOBAL.TrespassingConcept]invadir[/hyperlink]."

msgid "DIPLOMATICSTATES_DEFINITIONS@OPENBORDERS@HYPERLINK"
msgstr "[hyperlink,GLOBAL.OpenBordersConcept]Fronteiras Abertas[/hyperlink]"

msgid "DIPLOMATICSTATES_DEFINITIONS@OPENBORDERS@NAME"
msgstr "Fronteiras Abertas"

msgid "DIPLOMATICSTATES_DEFINITIONS@OPENBORDERSFORTURNS@DESCRIPTION"
msgstr "Ambos os Governantes abrem suas fronteiras um ao outro por um período determinado.[br/][br/]Efeitos:[bulletList][bullet/]{RelationValue}[goodRelation/] Relações.[bullet/]Os Governantes podem mover seus exércitos livremente pelo domínio um do outro.[/bulletList]"

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_ALLIANCE@AI_DESC"
msgstr "Proponho que forjemos uma aliança para que possamos ajudar um ao outro em tempos de guerra."

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_ALLIANCE@DESCRIPTION"
msgstr "Proponha um {GLOBAL.DSAllianceConcept.Hyperlink} com o outro Governante. Estas são as relações mais fortes que se pode ter. Ambos os Governantes precisam concordar primeiro com um {GLOBAL.DefensivePactConcept.Hyperlink}. {LOC.DIPLOMATICSTATES_DEFINITIONS@OPTION_RETURNCAPTUREDHEROES@DESCRIPTION_TRADE}"

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_ALLIANCE@NAME"
msgstr "Propor Aliança"

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_NEUTRAL@AI_DESC"
msgstr "Esqueçamos o passado e avancemos para um novo futuro!"

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_NEUTRAL@DESCRIPTION"
msgstr "Ambos os Governantes concordam em encerrar a guerra e declarar uma trégua, prometendo cessar toda ação hostil."

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_NEUTRAL@NAME"
