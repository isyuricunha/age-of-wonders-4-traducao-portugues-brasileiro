msgid "DLC@EMPIRESANDASHES@RACETRAITS_WORLD@HERMIT_KINGDOM@BIO"
msgstr "Eles acreditam que paz e silêncio são essenciais para o estudo e lutarão para garantir que esses valores sejam alcançados."

msgid "DLC@EMPIRESANDASHES@RACETRAITS_WORLD@HERMIT_KINGDOM@EFFECT1@DESCRIPTION"
msgstr "<<m:{GLOBAL.CityConcept.Hyperlink}>> ganha {knowledgeIncome} {GLOBAL.KnowledgeConcept.Hyperlink}, {amount2} {GLOBAL.FoodConcept.Hyperlink}, {amount3} {GLOBAL.StructureProductionConcept.Hyperlink} e {HappinessIncome} {GLOBAL.CityStabilityConcept.Hyperlink} de renda quando seu {GLOBAL.DomainConcept.Hyperlink} não faz fronteira com o {GLOBAL.DomainConcept.Hyperlink} de qualquer outra {GLOBAL.CityConcept.Hyperlink} ou {GLOBAL.OutpostConcept.Hyperlink}."

msgid "DLC@EMPIRESANDASHES@RACETRAITS_WORLD@HERMIT_KINGDOM@EFFECT2@DESCRIPTION"
msgstr "Os agravos infligidos por outros impérios que invadem seu território aumentam em {GrievanceMultiplier}%."

msgid "DLC@EMPIRESANDASHES@RACETRAITS_WORLD@HERMIT_KINGDOM@LORE"
msgstr "Eles desejam apenas ser deixados em paz para seus estudos e protegerão agressivamente seu isolamento estudioso de quaisquer perturbações."

msgid "DLC@EMPIRESANDASHES@RACETRAITS_WORLD@HERMIT_KINGDOM@NAME"
msgstr "Reino do Ermitão"

msgid "DLC@EMPIRESANDASHES@RACETRAITS_WORLD@RECLAIMERS@BIO"
msgstr "Eles acreditam que tudo deve ser recuperado e forjado novamente, mais forte."

msgid "DLC@EMPIRESANDASHES@RACETRAITS_WORLD@RECLAIMERS@EFFECT1@DESCRIPTION"
msgstr "Ganhe [hyperlink,GLOBAL.BindingEssenceConcept][bindingessence/] Essência Vinculante e [bindingfragments/] Fragmentos[/hyperlink] ao limpar <<m:{GLOBAL.InfestationSpawnerConcept.Hyperlink}>>, limpar <<m:{GLOBAL.AncientWonderConcept.Hyperlink}>>, [hyperlink,GLOBAL.RazingConcept]Razing[/hyperlink] <<m:{GLOBAL.CityConcept.Hyperlink}>>, e {GLOBAL.PillagingConcept.Hyperlink} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>>."

msgid "DLC@EMPIRESANDASHES@RACETRAITS_WORLD@RECLAIMERS@LORE"
msgstr "Eles acreditam que tudo pode ser forjado novamente em algo melhor, mas antes disso ser feito, é preciso recuperá‑lo."

msgid "DLC@EMPIRESANDASHES@RACETRAITS_WORLD@RECLAIMERS@NAME"
msgstr "Recuperadores"

msgid "DLC@EMPIRESANDASHES@REALM_TRAIT@AMAZONIAN_REALM@DESCRIPTION"
msgstr "O reino é uma selva exuberante, cercada por Vazio Astral.[bulletlist][bullet/]Tropical <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> e floresta <<m:{GLOBAL.ProvinceFeatureConcept.Hyperlink}>> são [abilityblue]Comum[/abilityblue].[bullet/]Rio <<m:{GLOBAL.ProvinceFeatureConcept.Hyperlink}>> são [abilityblue]Comum[/abilityblue].[bullet/]Ártico, deserto e <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> desolados são [abilityblue]Raro[/abilityblue].[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@REALM_TRAIT@AMAZONIAN_REALM@NAME"
msgstr "Selva Perdida"

msgid "DLC@EMPIRESANDASHES@REALM_TRAIT@AVIAN_INHABITANTS@DESCRIPTION"
msgstr "O reino abriga muitas aves, civilizadas e selvagens.[bulletlist][bullet/]Aviar <<m:{GLOBAL.IndependentCityConcept.Hyperlink}>> são [abilityblue]Comum[/abilityblue].[bullet/]<<m:{GLOBAL.STRUCTURES.GREAT_BIRD_NEST_SPAWNER.Hyperlink}>> são [abilityblue]Comum[/abilityblue].[bullet/]Ave <<m:{GLOBAL.UnitConcept.Hyperlink}>> são [abilityblue]Comum[/abilityblue].[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@REALM_TRAIT@AVIAN_INHABITANTS@NAME"
msgstr "Pássaros do Paraíso"

msgid "DLC@EMPIRESANDASHES@REALM_TRAIT@WARDEN_OF_MANUHARI@DESCRIPTION"
msgstr "Este reino é protegido por um poderoso {GLOBAL.UNITS.PROGENITOR_GOLEM.Hyperlink}, que lançará ataques periodicamente contra quaisquer inimigos dos nativos [hyperlink,GLOBAL.AncientKrazuraLoreConcept]Krazura[/hyperlink]."

msgid "DLC@EMPIRESANDASHES@REALM_TRAIT@WARDEN_OF_MANUHARI@NAME"
msgstr "Guardião de Manuhari"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT01@DESCRIPTION"
msgstr "A cada {amount} <<m:{GLOBAL.TurnConcept}>>, unidades inimigas:[bulletlist][bullet/]Sustentam {CONDEMNATION_STRIKE_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink}.[bullet/]Têm uma chance base de {CONDEMN_RESISTANCE>ResolvedStrength}% de se tornarem {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT01@NAME"
msgstr "Surto Condenatório"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT02@DESCRIPTION"
msgstr "Quando uma unidade amiga morre, todas as unidades inimigas adjacentes:[bulletlist][bullet/]Sofrem {MARTYRDOM_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink}.[bullet/]Tornam‑se {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT02@NAME"
msgstr "Martírio"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT02@PROP_DESCRIPTION"
msgstr "Quando esta unidade morre, todas as unidades inimigas adjacentes:[bulletlist][bullet/]Sofrem {MARTYRDOM_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink}[bullet/]Tornam‑se {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT03@DESCRIPTION"
msgstr "A cada {amount} <<m:{GLOBAL.TurnConcept}>>, uma unidade amiga aleatória:[bulletlist][bullet/]Ganha {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink}.[bullet/]Ganha {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}.[bullet/]Esse efeito então se aplica às unidades amigas adjacentes e se repete.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT03@NAME"
msgstr "Empoderamento em Cascata"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT04@DESCRIPTION"
msgstr "A cada {amount} <<m:{GLOBAL.TurnConcept}>>, unidades inimigas:[bulletlist][bullet/]Têm uma chance base de {MISFORTUNE_RESISTANCE>ResolvedStrength}% de ganhar {GLOBAL.PROPERTIES.MISFORTUNE.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT04@NAME"
msgstr "Onda de Infortúnio"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT05@DESCRIPTION"
msgstr "A cada {amount} <<m:{GLOBAL.TurnConcept}>>, {amount2} unidades inimigas aleatórias têm:[bulletlist][bullet/]Chance base de {GHOSTFIRE_RESISTANCE>ResolvedStrength}% de serem afetadas por {GLOBAL.PROPERTIES.GHOSTFIRE.Hyperlink}.[bullet/]Chance base de {ELECTRIFIED_RESISTANCE>ResolvedStrength}% de serem afetadas por {GLOBAL.PROPERTIES.ELECTRIFIED.Hyperlink}.[bullet/]Chance base de {FROZEN_RESISTANCE>ResolvedStrength}% de serem afetadas por {GLOBAL.PROPERTIES.FROZEN.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT05@NAME"
msgstr "Maldição Elemental"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT06@DESCRIPTION"
msgstr "A cada turno, uma unidade aleatória dos inimigos do proprietário, e unidades inimigas adjacentes:[bulletlist][bullet/]Sofrem {METEOR_SHOWER_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Sofrem {METEOR_SHOWER_UNIT_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT06@NAME"
msgstr "Meteoros Minúsculos"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT07@DESCRIPTION"
msgstr "Um {GLOBAL.UNITS.DECAYING_ZOMBIE.Hyperlink} é invocado ao lado de uma das unidades do proprietário a cada {amount} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT07@NAME"
msgstr "Abrir Túmulos"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT08@DESCRIPTION"
msgstr "A cada {GLOBAL.TurnConcept}, {amount2} unidades aleatórias dos inimigos do proprietário sofrem:[bulletlist][bullet/]{COSMIC_BOLT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}[bullet/]{COSMIC_BOLT_DAMAGE>DAMAGE>Shock} {GLOBAL.LightningDamageConcept.Hyperlink}[bullet/]{COSMIC_BOLT_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT08@NAME"
msgstr "Raios Cósmicos"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT09@DESCRIPTION"
msgstr "Um {GLOBAL.UNITS.GREMLIN_UNIT.Hyperlink} é invocado ao lado de uma das unidades do proprietário a cada {amount} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@CONDITION@DESCRIPTION"
msgstr "Para alcançar a Vitória dos Selos, um {GLOBAL.EmpireConcept.Hyperlink} precisa acumular pontos suficientes capturando e mantendo Selos.[br/][br/]Selos são encontrados por todo o mundo e podem ser capturados a qualquer momento. Para cada selo que você capturou, ganha 1 ponto a cada {GLOBAL.TurnConcept.Hyperlink}. Durante esse período, defensores dos Selos surgirão a cada poucos <<m:{GLOBAL.TurnConcept.Hyperlink}>> em um dos seus Selos reclamados e tentarão retomar o Selo sob seu controle. Se você controlar mais Selos, eles surgirão com mais frequência.[br/][br/]A Vitória dos Selos deve ser ativada adicionando um dos Traços de Reino dos Selos."

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@CONDITION@NAME"
msgstr "Vitória dos Selos"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@EVENT_SEAL_CAPTURED@OTHER"
msgstr "É evidente que <<p:{Player.Name}>> está buscando uma {GLOBAL.SealsVictoryConcept.Hyperlink}. Você precisará impedir que <<P:{Player.Name}>> mantenha Selos, ou manter Selos por conta própria."

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@EVENT_SEAL_CAPTURED@YOU"
msgstr "Enquanto você mantiver um exército no Selo, ganhará pontos para uma {GLOBAL.SealsVictoryConcept.Hyperlink}. Cuidado, pois os Guardiões do Selo tentarão reconquistá‑lo!"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@NOTIFY_ATTACKERS_SPAWNED@YOU"
msgstr "Defensores do Selo surgiram"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@NOTIFY_SEAL_CAPTURED@OTHER"
msgstr "{Player.Name} capturou o primeiro Selo de <<o:{Player.Name}>>"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@NOTIFY_SEAL_CAPTURED@YOU"
msgstr "Você capturou um Selo"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@NOTIFY_SEAL_LOST@OTHER"
msgstr "{Player.Name} perdeu um Selo"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@NOTIFY_SEAL_LOST@YOU"
msgstr "Você perdeu um Selo"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@NOTIFY_VICTORY_IMMINENT@OTHER"
msgstr "{Player.Name} alcançará a Vitória dos Selos em {Turns} turnos"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@NOTIFY_VICTORY_IMMINENT@UNMET"
msgstr "Um Governante não cumprido alcançará a Vitória dos Selos em {Turns} turnos"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@NOTIFY_VICTORY_IMMINENT@YOU"
msgstr "Você alcançará a Vitória dos Selos em {Turns} turnos"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@RESULT@ALLIED_VICTORY@TEXT"
msgstr "Seu aliado {OtherPlayer.Name} ativou os Selos Mundiais inativos e assumiu o controle deles, banindo todos os outros Godot deste reino. Após os cataclismos resultantes, o povo não tem escolha senão aceitar você e {OtherPlayer.Name} como seu único Godot pelos séculos vindouros."

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@RESULT@DEFEAT"
msgstr "{OtherPlayer.Name} alcançou a Vitória dos Selos"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@RESULT@VICTORY"
msgstr "Selos"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@RESULT@VICTORY@TEXT"
msgstr "Você ativou os Selos Mundiais inativos e assumiu o controle deles, banindo todos os outros Godir deste reino. Após os cataclismos resultantes, o povo não tem escolha senão aceitá‑lo como seu único {OtherPlayer.Title}."

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@SETTING"
msgstr "Todas as notificações da Vitória dos Selos"

