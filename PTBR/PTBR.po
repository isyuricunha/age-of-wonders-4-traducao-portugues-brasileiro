msgid "COMBATPROPERTIES_TACTICAL@HASTEFUL_ONSLAUGHT@NAME"
msgstr "Velocidade Anormal"

msgid "COMBATPROPERTIES_TACTICAL@HASTENED_ARMY@DESCRIPTION"
