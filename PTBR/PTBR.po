msgstr "Praga Escarlate"

msgid "DLC@THRONESOFBLOOD@TOME_BLOOD_RITE@ABILITY02@DESCRIPTION"
msgstr "O conjurador:[bulletlist][bullet/]Sofre {DAGGER_OF_THE_RITE_DAMAGE>DAMAGE>Physical} inbloqueável {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Ganha +{DAGGER_OF_THE_RITE_DAMAGE_MULT>ResolvedMultiplier}% de dano.[bullet/]Ganha {GLOBAL.PROPERTIES.RESURGENCE.Hyperlink}[bullet/]Morre ao final do turno.[/bulletlist]"

