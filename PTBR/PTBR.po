msgid "INTERFACE@STRATEGIC_MAP@CITY_TIER_HYPERLINK"
msgstr "[hyperlink,GLOBAL.CityTierConcept]Nível da Cidade[/hyperlink]"

msgid "INTERFACE@STRATEGIC_MAP@CONDUIT_DESCRIPTION"
msgstr "Um Conduto é um {GLOBAL.ProvinceImprovementConcept.Hyperlink} base com os seguintes benefícios:[bulletlist][bullet/]Fornece renda de {GLOBAL.ManaConcept.Hyperlink}.{LOC.INTERFACE@STRATEGIC_MAP@BASE_IMPROVEMENT_DESCRIPTION}[/bulletlist]"

