msgid "TOME_DEMON_GATE@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Abra fendas para invocar <<m:{GLOBAL.PROPERTIES.FIEND.Hyperlink}>> e queimar o mundo em seu rastro."

msgid "TOME_DEMON_GATE@TOME@LORE_AUTHOR"
msgstr "Kruul Flagelorde, Príncipe do Caos"

msgid "TOME_DEMON_GATE@TOME@LORE_DESCRIPTION"
msgstr "\"Aqueles que dominam a arte da invocação sempre terão aliados à disposição, embora talvez não totalmente voluntários. Demônios podem ser aterrorizantes para alguns, mas, se invocados corretamente, são os servos mais valiosos que um Godir pode encontrar. É claro que eles prefeririam arrancar a carne do seu rosto se pudessem... mas não podem, então o ponto é irrelevante!\""

msgid "TOME_DEMON_GATE@TOME@NAME"
msgstr "Tomo do Portal Demoníaco"

