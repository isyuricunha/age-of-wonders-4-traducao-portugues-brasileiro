msgid "DLC@ELDRITCHREALMS@ELDRITCH_SPECIALIZATION@MADCASTER@ABILITY01@DESCRIPTION"
msgstr "Inimigos em um raio de {hex} hexágonos têm {amount} desses efeitos ocorrendo aleatoriamente:[bulletlist][bullet/]Transforme‑se em um {GLOBAL.PROPERTIES.ANIMAL.Hyperlink} aleatório de Nível I por {animalDuration} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Sofre {firedamage} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Ganha {GLOBAL.PROPERTIES.INSANITY.Hyperlink} por {InsaneDuration} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Torna‑se {GLOBAL.PROPERTIES.BLINDED.Hyperlink} até o fim do combate.[bullet/]{moraleAmount} {GLOBAL.UnitMoraleConcept.Hyperlink}.[bullet/]Sofre {frostdamage} {GLOBAL.FrostDamageConcept.Hyperlink} e torna‑se {GLOBAL.PROPERTIES.FROZEN.Hyperlink} por {frozenDuration} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Ganha {GLOBAL.PROPERTIES.INFERNAL_REBIRTH.Hyperlink} até o fim do combate.[bullet/]Ganha {electrifyAmount} {GLOBAL.PROPERTIES.ELECTRIFIED.Hyperlink}.[bullet/]Cura {healAmount} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@ELDRITCH_SPECIALIZATION@MADCASTER@ABILITY01@NAME"
msgstr "Pulso de Caos"

msgid "DLC@ELDRITCHREALMS@ELDRITCH_SPECIALIZATION@MADCASTER@ABILITY02@DESCRIPTION"
