msgstr "Unidade ganha:[bulletlist][bullet/]{GLOBAL.PROPERTIES.VERY_FAST_MOVEMENT.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.CAVALRY_GROUP.Hyperlink} tipo de unidade.[bullet/]{GLOBAL.PROPERTIES.LARGE_TARGET.Hyperlink}.[/bulletlist]"

