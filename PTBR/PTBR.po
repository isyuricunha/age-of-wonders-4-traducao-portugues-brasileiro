msgid "CONCEPT@HITPOINTS@DESCRIPTION"
msgstr "[bulletlist][bullet/]Pontos de Vida representam a quantidade de dano que um(a) {GLOBAL.UnitConcept.Hyperlink} pode sofrer antes de morrer.[bullet/]A maioria das unidades sofrerá <<m:{GLOBAL.CasualtyConcept.Hyperlink}>> conforme seus Pontos de Vida diminuem.[/bulletlist]"

msgid "CONCEPT@HITPOINTS@HYPERLINK"
msgstr "[hyperlink,GLOBAL.HitPointConcept]{LOC.CONCEPT@HITPOINTS@NAME}[/hyperlink]"

msgid "CONCEPT@HITPOINTS@NAME"
