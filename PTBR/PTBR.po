msgid "TOME_SUPREMACY@HERO_SKILL@NAME"
msgstr "Magia Suprema"

msgid "TOME_SUPREMACY@PASSIVE@DESCRIPTION"
msgstr "<<m:{GLOBAL.IndependentCityConcept.Hyperlink}>> que você vassaliza ganham +{amount} nível de {GLOBAL.HouseInfluenceConcept}."

msgid "TOME_SUPREMACY@PASSIVE@NAME"
msgstr "Conquistadores Benevolentes"

msgid "TOME_SUPREMACY@SKILL1@DESCRIPTION"
msgstr "Um(a) {GLOBAL.PROPERTIES.SHIELD_UNIT.Hyperlink} voador(a) que se destaca em aumentar o(a) {GLOBAL.UnitMoraleConcept.Hyperlink} de suas unidades."

msgid "TOME_SUPREMACY@SKILL1@NAME"
msgstr "Exemplar^m"

msgid "TOME_SUPREMACY@SKILL2@DESCRIPTION"
msgstr "[bulletlist][bullet/]{unitProduction} {GLOBAL.UnitProductionConcept.Hyperlink}[bullet/]{stability} {GLOBAL.CityStabilityConcept.Hyperlink} por Monumento da Supremacia construído em seu império[/bulletlist]"

msgid "TOME_SUPREMACY@SKILL2@NAME"
msgstr "Monumento da Supremacia"

msgid "TOME_SUPREMACY@SKILL2@STRUCTURE_DESCRIPTION"
msgstr "{stability} {GLOBAL.CityStabilityConcept.Hyperlink} por Monumento da Supremacia em seu império."

msgid "TOME_SUPREMACY@SKILL3@DESCRIPTION"
msgstr "Exército inimigo alvo:[bulletlist][bullet/]Recebe {damage} {GLOBAL.SpiritDamageConcept.Hyperlink}[bullet/]Torna-se {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink} por {turn} {GLOBAL.WorldMapConcept.Hyperlink} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "TOME_SUPREMACY@SKILL3@NAME"
msgstr "Condenar Exército"

msgid "TOME_SUPREMACY@SKILL4@DESCRIPTION"
msgstr "Para unidades encantadas:[bulletlist][bullet/]Concede {GLOBAL.PROPERTIES.ZEAL.Hyperlink}, que faz com que ataques causem {GLOBAL.SpiritDamageConcept.Hyperlink} extra.[bullet/]Matar uma unidade faz com que ela exploda, causando {SUPREME_MAGIC_UNIT_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink} em unidades inimigas adjacentes.[/bulletlist]"

msgid "TOME_SUPREMACY@SKILL4@MODIFIER_DESCRIPTION"
msgstr "Matar uma unidade faz com que ela exploda, causando {SUPREME_MAGIC_UNIT_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink} em unidades inimigas adjacentes."

msgid "TOME_SUPREMACY@SKILL4@NAME"
msgstr "Magia Suprema"

msgid "TOME_SUPREMACY@SKILL4@PROPERTY_DESCRIPTION"
msgstr "[bulletlist][bullet/]A unidade possui {GLOBAL.PROPERTIES.ZEAL.Hyperlink}.[bullet/]Matar uma unidade faz com que ela exploda, causando {SUPREME_MAGIC_UNIT_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink} em unidades inimigas adjacentes.[/bulletlist]"

msgid "TOME_SUPREMACY@SKILL5@DESCRIPTION"
msgstr "Todas as unidades aliadas ganham:[bulletlist][bullet/]{strengthened} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}.[bullet/]+{ANTHEM_OF_VICTORY_CHANGE_MORALE>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_SUPREMACY@SKILL5@NAME"
msgstr "Hino da Vitória"

msgid "TOME_SUPREMACY@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Lidere seu povo à vitória gloriosa. Especialize-se em aumentar {GLOBAL.UnitMoraleConcept.Hyperlink.} e gerenciar um grande império."

msgid "TOME_SUPREMACY@TOME@LORE_AUTHOR"
msgstr "Inioch, Imperador da Corte Élfica"

msgid "TOME_SUPREMACY@TOME@LORE_DESCRIPTION"
msgstr "\"Nós, que buscamos guiar e proteger nosso povo, somos agraciados com um propósito glorioso. Essa glória justa emana do nosso próprio ser, permeando a carne e o espírito de nossos súditos, inspirando-os à grandeza! A vitória, para aqueles neste caminho divino, não é uma possibilidade, mas uma certeza.\""

msgid "TOME_SUPREMACY@TOME@NAME"
msgstr "Tomo da Supremacia"

msgid "TOME_SUPREMACY@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Unidades amigas em um raio de {EMBOLDEN_ALLIES_CIRCLE_AROUND_CASTER>AREA>Radius} hexágonos ganham, por {RALLYING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>:[bulletlist][bullet/]{amount} {GLOBAL.PROPERTIES.RALLYING.Hyperlink}.[bullet/]{strengthened} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}.[/bulletlist][br/]Entram em {GLOBAL.DefenseModeConcept.Hyperlink}."

msgid "TOME_SUPREMACY@UNIT1@ABILITY1@NAME"
msgstr "Encorajar Aliados"

msgid "TOME_SUPREMACY@UNIT1@ABILITY2@DESCRIPTION"
msgstr "Durante o combate, esta e todas as outras unidades amigas têm um modificador de +{INSPIRING_PRESENCE_MORALE_RESISTANCE>ResolvedMoraleRiseModifier}% para ganho positivo de {GLOBAL.UnitMoraleConcept.Hyperlink}.[br/][br/]Este efeito não é cumulativo."

msgid "TOME_SUPREMACY@UNIT1@ABILITY2@NAME"
msgstr "Presença Inspiradora"

msgid "TOME_SUPREMACY@UNIT1@ABILITY2@PROPERTY@NAME"
msgstr "Inspirado"

msgid "TOME_SUPREMACY@UNIT1@ABILITY2@PROPERY@DESCRIPTION"
msgstr "Ganha {GLOBAL.UnitMoraleConcept.Hyperlink} {INSPIRING_PRESENCE_MORALE_RESISTANCE>ResolvedMoraleRiseModifier}% mais rápido."

msgid "TOME_TELEPORTATION@HERO_SKILL@DESCRIPTION"
msgstr "Faz o conjurador se teletransportar para o hexágono alvo."

msgid "TOME_TELEPORTATION@HERO_SKILL@NAME"
msgstr "Fase Rápida"

msgid "TOME_TELEPORTATION@PASSIVE@DESCRIPTION"
msgstr "Todos os <<m:{GLOBAL.ProvinceConcept}>> podem ser definidos como ponto de surgimento do exército de uma Cidade."

msgid "TOME_TELEPORTATION@PASSIVE@NAME"
msgstr "Portais de Deslocamento"

msgid "TOME_TELEPORTATION@SKILL1@DESCRIPTION"
msgstr "Faz o exército amigo alvo se teletransportar de volta para a cidade possuída mais próxima."

msgid "TOME_TELEPORTATION@SKILL1@NAME"
msgstr "Recall em Massa"

msgid "TOME_TELEPORTATION@SKILL2@DESCRIPTION"
msgstr "Invoca um(a) {GLOBAL.UNITS.PHASE_BEAST_UNIT.Hyperlink} no hexágono alvo do mundo."

msgid "TOME_TELEPORTATION@SKILL2@NAME"
msgstr "Invocar Fera da Fase"

msgid "TOME_TELEPORTATION@SKILL3@DESCRIPTION"
msgstr "Teletransporta a unidade aliada mais próxima dentro de {EMERGENCY_TELEPORTATION_UNIT_TARGETER_NEAREST_TO_TARGET>MaxDista} hexágonos para o hexágono vazio alvo.[br/]Essa unidade cura +{EMERGENCY_TELEPORTATION_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> e tem todos os <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>> removidos."

msgid "TOME_TELEPORTATION@SKILL3@NAME"
msgstr "Teletransporte de Emergência"

msgid "TOME_TELEPORTATION@SKILL4@DESCRIPTION"
msgstr "Concede às unidades encantadas:[bulletlist][bullet/]A habilidade {GLOBAL.PROPERTIES.CHARGED_PHASE_TELEPORT.Hyperlink}, que permite teletransportá-las em batalha.[/bulletlist]"

msgid "TOME_TELEPORTATION@SKILL4@NAME"
msgstr "Encantamento de Fase"

msgid "TOME_TELEPORTATION@SKILL4@PROPERTY_DESCRIPTION"
msgstr "Unidade tem:[bulletlist][bullet/]A habilidade {GLOBAL.PROPERTIES.CHARGED_PHASE_TELEPORT.Hyperlink}.[/bulletlist]"

msgid "TOME_TELEPORTATION@SKILL5@DESCRIPTION"
msgstr "[bulletlist][bulletlist][bullet/]{gold} renda de {GLOBAL.GoldConcept.Hyperlink}.[bullet/]{goldStack} {GLOBAL.GoldConcept.Hyperlink} de renda para cada Posto de Comércio Astral construído em seu império.[/bulletlist][/bulletlist]"

msgid "TOME_TELEPORTATION@SKILL5@NAME"
msgstr "Relé de Comércio Astral"

msgid "TOME_TELEPORTATION@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Explore a magia espacial em todo o seu potencial. Reposicione suas unidades estrategicamente em batalha em um mero instante."

msgid "TOME_TELEPORTATION@TOME@LORE_AUTHOR"
msgstr "Laryssa Mirabilis, Feiticeira da Comunidade"

msgid "TOME_TELEPORTATION@TOME@LORE_DESCRIPTION"
msgstr "\"O mago que utiliza plenamente o potencial da magia para expandir suas opções táticas no campo de batalha... esse é um mago astuto. Imagine um comandante desavisado, todo preparado para um ataque iminente, só para de repente se ver diante de um ataque em pinça. A arte da teletransporte oferece possibilidades infinitas para o verdadeiro estrategista criativo.\""

msgid "TOME_TELEPORTATION@TOME@NAME"
msgstr "Tomo de Teletransporte"

msgid "TOME_TELEPORTATION@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Realiza um Ataque de Carga de Fase que:[bulletlist][bullet/]Teletransporta a unidade para trás do alvo.{LOC.CONCEPT@CHARGE_SHARED}[/bulletlist]"

msgid "TOME_TELEPORTATION@UNIT1@ABILITY1@NAME"
msgstr "Carga de Fase"

msgid "TOME_TELEPORTATION@UNIT1@DESCRIPTION"
msgstr "Uma unidade de choque rápida e esquiva, capaz de se teletransportar."

msgid "TOME_TELEPORTATION@UNIT1@NAME"
msgstr "Fera de Fase^n"

msgid "TOME_TERRA@@SKILL6@NAME"
msgstr "Montanhas Baixas"

msgid "TOME_TERRA@HERO_SKILL@DESCRIPTION"
msgstr "Faz com que ataques base de {GLOBAL.MeleeConcept.Hyperlink} ganhem:[bulletlist][bullet/]+{LEADEN_BLOW_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]{SLOWED_RESISTANCE>ResolvedStrength}% de chance base de infligir {GLOBAL.PROPERTIES.SLOWED.Hyperlink}.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_TERRA@HERO_SKILL@NAME"
msgstr "Golpes Pesados"

msgid "TOME_TERRA@SKILL1@DESCRIPTION"
msgstr "Unidade inimiga alvo:[bulletlist][bullet/]Sofre {CRUSHING_EARTH_UNIT_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Recebe {amount} {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink} por {SUNDERED_DEFENSE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Tem uma chance base de {STUNNED_RESISTANCE>ResolvedStrength}% de se tornar {GLOBAL.PROPERTIES.STUNNED.Hyperlink} por {STUNNED_EFFECT_DESCRIPTION>NumTurns} {GLOBAL.TurnConcept}.[/bulletlist]"

msgid "TOME_TERRA@SKILL1@NAME"
msgstr "Terra Esmagadora"

msgid "TOME_TERRA@SKILL2@DESCRIPTION"
msgstr "Causa {SEISMIC_SHOCK_UNIT_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink} em unidades em um raio de {SEISMIC_SHOCK_OBSTACLE_TARGETER>AREA>Radius} hexágonos e inflige {GLOBAL.PROPERTIES.SLOWED.Hyperlink}.[br/]Este feitiço causa o dobro de dano em obstáculos."

msgid "TOME_TERRA@SKILL2@NAME"
msgstr "Choque Sísmico"

msgid "TOME_TERRA@SKILL3@DESCRIPTION"
msgstr "No(a) {GLOBAL.ProvinceConcept.Hyperlink} habitável ou inabitável alvo:[bulletlist][bullet/]Unidades <<m:{GLOBAL.UnitConcept.Hyperlink}>> inimigas sofrem {damage}.[bullet/]A província perde qualquer {GLOBAL.MountainConcept.Hyperlink}, {GLOBAL.StalagmitesConcept.Hyperlink} e {GLOBAL.DiggableEarthConcept.Hyperlink}.[bullet/]Invoca um(a) {GLOBAL.UNITS.STONE_SPIRIT.Hyperlink}[/bulletlist]"

msgid "TOME_TERRA@SKILL3@NAME"
msgstr "Fratura da Terra"

msgid "TOME_TERRA@SKILL4@DESCRIPTION"
msgstr "[bulletlist][bullet/]Em batalha, a cada {turn} uma unidade inimiga aleatória é atingida por um terremoto:[bulletlist][bullet/]Unidades inimigas não voadoras e não flutuantes em um raio de {range} hexágonos recebem {damage}.[bullet/]Unidades inimigas não voadoras e não flutuantes em um raio de {range} hexágonos têm {chance}% de chance de sofrer {GLOBAL.PROPERTIES.SLOWED.Hyperlink} por {turn2}.[bullet/]Obstáculos, incluindo Paredes, Torres e Baluartes em um raio de {range} hexágonos são destruídos.[/bulletlist][/bulletlist]"

msgid "TOME_TERRA@SKILL4@NAME"
msgstr "Ritual do Tremor"

msgid "TOME_TERRA@SKILL5@DESCRIPTION"
msgstr "Invoca um(a) {GLOBAL.UNITS.ROCK_GIANT.Hyperlink}, um(a) {GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink} que lança rochas para atrapalhar inimigos e os esmaga com golpes semelhantes a terremotos."

msgid "TOME_TERRA@SKILL5@NAME"
msgstr "Invocar Gigante de Pedra"

msgid "TOME_TERRA@SKILL6@BUFF_DESCRIPTION"
msgstr "Até a unidade se mover, ela tem:[bulletlist][bullet/]+{LEY_LINE_FOCUS_DAMAGE_MULT>ResolvedMultiplier}% de dano[bullet/]+{LEY_LINE_FOCUS_DEFENSE>DEF_MOD>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_TERRA@SKILL6@DESCRIPTION"
msgstr "Unidades encantadas ganham:[bulletlist][bullet/]No início do turno e até a unidade se mover, esta unidade tem:[bulletlist][bullet/]+{LEY_LINE_FOCUS_DAMAGE_MULT>ResolvedMultiplier}% de dano[bullet/]+{LEY_LINE_FOCUS_DEFENSE>DEF_MOD>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}.[/bulletlist][/bulletlist]"

msgid "TOME_TERRA@SKILL6@MOD_DESCRIPTION"
msgstr "+{LEY_LINE_FOCUS_DAMAGE_MULT>ResolvedMultiplier}% de dano até se mover."

msgid "TOME_TERRA@SKILL6@NAME"
msgstr "Foco em Linhas Ley"

msgid "TOME_TERRA@SKILL6@PROP_DESCRIPTION"
msgstr "No início do turno e até a unidade se mover, esta unidade tem:[bulletlist][bullet/]+{LEY_LINE_FOCUS_DAMAGE_MULT>ResolvedMultiplier}% de dano[bullet/]+{LEY_LINE_FOCUS_DEFENSE>DEF_MOD>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}[/bulletlist]"

msgid "TOME_TERRAMANCY@PASSIVE@DESCRIPTION"
msgstr "<<m:{GLOBAL.CityConcept}>> ganham {amount} {GLOBAL.FortificationHealthConcept} por {GLOBAL.ProvinceConcept} Rochoso."

msgid "TOME_TERRAMANCY@PASSIVE@NAME"
msgstr "Terraformadores"

msgid "TOME_TERRAMANCY@TOME@GAMEPLAY"
msgstr "Manipule a terra à vontade. Especialize-se em causar {GLOBAL.PhysicalDamageConcept.Hyperlink} e dificultar o Movimento inimigo."

msgid "TOME_TERRAMANCY@TOME@LORE"
msgstr "\"Ignore os magos medíocres que buscam ressuscitar os mortos ou dominar raios e fogo para lançar contra você. Esses tolos não conhecem o poder que repousa sob seus próprios pés! Mas eles conhecerão... nos últimos momentos de suas existências insignificantes, quando você os enterrar sob uma montanha e rasgar a terra sob suas cidades.\""

msgid "TOME_TERRAMANCY@TOME@LORE_AUTHOR"
msgstr "Mãe Mab, Deusa dos Goblins"

msgid "TOME_TERRAMANCY@TOME@NAME"
msgstr "Tomo de Terramancia"

msgid "TOME_TRANSMUTATION@PASSIVE@DESCRIPTION"
msgstr "Pedreiras concedem {amount} {GLOBAL.FoodConcept}."

msgid "TOME_TRANSMUTATION@PASSIVE@NAME"
msgstr "Transmutação Vital"

msgid "TOME_TRANSMUTATION@SKILL1@DESCRIPTION"
msgstr "Uma vez a cada {GLOBAL.TurnConcept}, sempre que unidades encantadas forem atingidas por dano não {GLOBAL.PhysicalDamageConcept.Hyperlink}, elas ganham:[bulletlist][bullet/]{GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink}, aumentando sua resistência a dano mágico.[bullet/]{GLOBAL.PROPERTIES.STATUS_PROTECTION.Hyperlink}, reduzindo a chance de a unidade ser afetada por <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>>.[/bulletlist]"

msgid "TOME_TRANSMUTATION@SKILL1@NAME"
msgstr "Armadura Adaptativa"

msgid "TOME_TRANSMUTATION@SKILL1@PROP_DESCRIPTION"
msgstr "Uma vez a cada {GLOBAL.TurnConcept}, sempre que esta unidade for atingida por dano não {GLOBAL.PhysicalDamageConcept.Hyperlink}, ela ganha:[bulletlist][bullet/]{GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.STATUS_PROTECTION.Hyperlink}[/bulletlist]"

msgid "TOME_TRANSMUTATION@SKILL2@DESCRIPTION"
msgstr "A cidade alvo converte sua renda de {GLOBAL.ManaConcept}, ganhando renda de {GLOBAL.GoldConcept}, {GLOBAL.StructureProductionConcept} e {GLOBAL.FoodConcept} igual a {amount}% da renda de {GLOBAL.ManaConcept}."

msgid "TOME_TRANSMUTATION@SKILL2@NAME"
msgstr "Transmutar Recursos"

msgid "TOME_TRANSMUTATION@SKILL3@DESCRIPTION"
msgstr "Unidades inimigas em um raio de {MELT_ARMOR_OBSTACLE_TARGETER_CIRCLE>AREA>Radius} hexes:[bulletlist][bullet/]Recebem dano contínuo.{stacks}Ganham {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink} por [bullet/] {MELT_ARMOR_UNIT_DAMAGE>DAMAGE>Fire}.{GLOBAL.FireDamageConcept.Hyperlink}[/bulletlist]Se bem-sucedido, concede @@TOK9@@ por @@TOK10@@ @@TOK11@@ a todas as unidades amigas em um raio de @@TOK12@@ hexes do conjurador."

msgid "TOME_TRANSMUTATION@SKILL3@NAME"
msgstr "Derreter Armadura"

msgid "TOME_TRANSMUTATION@SKILL4@DESCRIPTION"
msgstr "Um {GLOBAL.PROPERTIES.BATTLE_MAGE.Hyperlink} que transforma inimigos em ouro e pode roubar suas armaduras e concedê-las a unidades amigas."

msgid "TOME_TRANSMUTATION@SKILL4@NAME"
msgstr "Transmutador"

msgid "TOME_TRANSMUTATION@SKILL5@DESCRIPTION"
msgstr "Transmuta a pele da raça alvo em aço, concedendo-lhes:[bulletlist][bullet/]+{STEELSKIN_DEFENSE>DEF_MOD>Armor} {GLOBAL.DefenseConcept.Hyperlink}.[bullet/]+{STEELSKIN_DEFENSE>REDUCTION>Blight} {GLOBAL.BlightResistanceConcept.Hyperlink}.[bullet/]{STEELSKIN_DEFENSE>REDUCTION>Shock} {GLOBAL.LightningResistanceConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_TRANSMUTATION@SKILL5@NAME"
msgstr "Pele de Aço"

msgid "TOME_TRANSMUTATION@SKILL5@PROP_DESCRIPTION"
msgstr "A unidade possui:[bulletlist][bullet/]+{STEELSKIN_DEFENSE>DEF_MOD>Armor} {GLOBAL.DefenseConcept.Hyperlink}.[bullet/]+{STEELSKIN_DEFENSE>REDUCTION>Blight} {GLOBAL.BlightResistanceConcept.Hyperlink}.[bullet/]{STEELSKIN_DEFENSE>REDUCTION>Shock} {GLOBAL.LightningResistanceConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_TRANSMUTATION@TOME@GAMEPLAY@DESCRIPTION"
msgstr "Altere substâncias físicas usando vastas quantidades de mana. Especialize-se em enfraquecer inimigos, fortalecer aliados e mudar sua economia."

msgid "TOME_TRANSMUTATION@TOME@LORE@AUTHOR"
msgstr "Tugrum Martelo-forja, Mestre Artesão Anão"

msgid "TOME_TRANSMUTATION@TOME@LORE@DESCRIPTION"
msgstr "\"Uma vez alcançada a maestria do reino mineral, pode-se realizar verdadeiras maravilhas. Imagine a habilidade de manipular e alterar a própria natureza do físico. Olhar para uma substância e decidir 'não seja esta coisa, seja aquela outra'. E assim pode-se começar a compreender o que pode ser alcançado ao dominar os muitos dons da transmutação.\""

msgid "TOME_TRANSMUTATION@TOME@NAME"
msgstr "Tomo da Transmutação"

msgid "TOME_TRANSMUTATION@UNIT1@ABILITY1@BOLT_NAME"
msgstr "Dardos Derretidos"

msgid "TOME_TRANSMUTATION@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Inflige {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink} enquanto concede {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink} a um aliado aleatório em até {SHIFT_ARMOR_UNIT_TARGETER_JUMP>MaxDistance} hexes."

msgid "TOME_TRANSMUTATION@UNIT1@ABILITY1@NAME"
msgstr "Mudar Armadura"

msgid "TOME_TRANSMUTATION@UNIT1@ABILITY2@DESCRIPTION"
msgstr "Unidades inimigas em um raio de {TRANSMUTE_UNIT_TARGETER_CIRCLE>AREA>Radius} hexes:[bulletlist][bullet/]Recebem dano contínuo.[bullet/]Ganham {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink} por {SUNDERED_DEFENSE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][br/]Se bem-sucedido, concede {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink} por {SUNDERED_DEFENSE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>> a todas as unidades amigas em um raio de {TRANSMUTE_CIRCLE_ROUND_CASTER>AREA>Radius} hexes do conjurador."

msgid "TOME_TRANSMUTATION@UNIT1@ABILITY2@MASTER_DESCRIPTION"
msgstr "Unidades inimigas em um raio de {TRANSMUTE_UNIT_TARGETER_CIRCLE>AREA>Radius} hexes:[bulletlist][bullet/]Sofrem dano contínuo.[bullet/]Ganham {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink} por {SUNDERED_DEFENSE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Têm uma chance base de {GILDED_RESISTANCE>ResolvedStrength}% de ficarem {GLOBAL.PROPERTIES.GILDED.Hyperlink} por {GILDED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][br/]Se bem-sucedido, concedem {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink} por {SUNDERED_DEFENSE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>> a todas as unidades amigas em até {TRANSMUTE_CIRCLE_ROUND_CASTER>AREA>Radius} hexes do conjurador."

msgid "TOME_TRANSMUTATION@UNIT1@ABILITY2@MASTER_NAME"
msgstr "Transmutar Campeão"

msgid "TOME_TRANSMUTATION@UNIT1@ABILITY2@MASTER_PROP_DESCRIPTION"
msgstr "Transmutar:[bulletlist][bullet/]Têm uma chance base de {GILDED_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.GILDED.Hyperlink} a inimigos.[/bulletlist]"

msgid "TOME_TRANSMUTATION@UNIT1@ABILITY2@NAME"
msgstr "Transmutar"

msgid "TOME_TRANSMUTATION@UNIT@NAME"
msgstr "Transmutador^f"

msgid "TOME_UNDEATH@UNIT_2@NAME"
msgstr "Zumbi"

msgid "TOME_VIGOR@HERO_SKILL@DESCRIPTION"
msgstr "Enquanto esta unidade for a líder do exército, unidades não-heróis ganham:[bulletlist][bullet/]+{VIGOROUS_LEADER_STAT_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]Recuperam +{VIGOROUS_LEADER_STAT_BONUS>BONUS>Regen} <<m:{GLOBAL.HitPointConcept.Hyperlink}>> por turno no mapa estratégico.[/bulletlist]"

msgid "TOME_VIGOR@HERO_SKILL@NAME"
msgstr "Líder Vigoroso"

msgid "TOME_VIGOR@PASSIVE@DESCRIPTION"
msgstr "<<m:{GLOBAL.NodeConcept}>> em seu {GLOBAL.DomainConcept} concedem {amount} {GLOBAL.FoodConcept.Hyperlink} e {GLOBAL.UnitProductionConcept.Hyperlink}."

msgid "TOME_VIGOR@PASSIVE@NAME"
msgstr "Jardins Ancestrais"

msgid "TOME_VIGOR@SKILL1@DESCRIPTION"
msgstr "Unidade alvo {GLOBAL.PROPERTIES.ANIMAL.Hyperlink} ou {GLOBAL.PROPERTIES.CAVALRY_GROUP.Hyperlink} ganha, por {UNLEASH_BEAST_STATUS_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>:[bulletlist][bullet/]{amount2} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}[bullet/]{amount3} {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.BERSERK.Hyperlink}.[/bulletlist]"

msgid "TOME_VIGOR@SKILL1@NAME"
msgstr "Liberar Fera"

msgid "TOME_VIGOR@SKILL2@DESCRIPTION"
msgstr "[bulletlist][bullet/]Escolha uma unidade {GLOBAL.PROPERTIES.ANIMAL.Hyperlink} de Tier III ou Tier IV para adicionar ao seu exército.[bullet/]As unidades <<m:{GLOBAL.PROPERTIES.ANIMAL.Hyperlink}>> disponíveis dependem do tipo de terreno onde o feitiço é conjurado.[/bulletlist]"

msgid "TOME_VIGOR@SKILL2@NAME"
msgstr "Invocar Animal Maior"

msgid "TOME_VIGOR@SKILL3@DESCRIPTION"
msgstr "Faz a raça alvo crescer em massa e estatura, concedendo-lhes:[bulletlist][bullet/]+{SUPERGROWTH_STAT_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[bullet/]+{WATCHFUL_NUM_OVERWATCH>NumTriggersToAdd} {GLOBAL.RetaliationConcept.Hyperlink}.[bullet/]Número reduzido de unidades na formação.[/bulletlist][br/]Esta transformação é incompatível com {GLOBAL.PROPERTIES.SPAWNKIN_PROPERTY_GROUP.Hyperlink}."

msgid "TOME_VIGOR@SKILL3@NAME"
msgstr "Supercrescimento"

msgid "TOME_VIGOR@SKILL3@PROP_DESCRIPTION"
msgstr "Unidade possui:[bulletlist][bullet/]+{SUPERGROWTH_STAT_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]+{WATCHFUL_NUM_OVERWATCH>NumTriggersToAdd} {GLOBAL.RetaliationConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_VIGOR@SKILL4@DESCRIPTION"
msgstr "Faz com que unidades encantadas:[bulletlist][bullet/]Causem +{EMPOWERED_BEASTS_DAMAGE_MULTIPLIER>ResolvedMultiplier}% de dano.[bullet/]Ganhem +{EMPOWERED_BEASTS_HP_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[bullet/]Ganhem {GLOBAL.PROPERTIES.DEMOLISHER.Hyperlink}, permitindo-lhes destruir obstáculos reforçados.[bullet/]Número reduzido de unidades na formação.[/bulletlist]"

msgid "TOME_VIGOR@SKILL4@NAME"
msgstr "Bestas Empoderadas"

msgid "TOME_VIGOR@SKILL4@PROP_DESCRIPTION"
msgstr "Unidade encantada:[bulletlist][bullet/]Causa +{EMPOWERED_BEASTS_DAMAGE_MULTIPLIER>ResolvedMultiplier}% de dano.[bullet/]Ganha +{EMPOWERED_BEASTS_HP_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[bullet/]Ganha {GLOBAL.PROPERTIES.DEMOLISHER.Hyperlink}.[/bulletlist]"

msgid "TOME_VIGOR@SKILL5@DESCRIPTION"
msgstr "Invoca um(a) {GLOBAL.UNITS.TOTEM_OF_THE_WILD_UNIT.Hyperlink}, que gera uma unidade animal aleatória de Tier I ou II quando é criado(a) e no início do seu próximo {count} <<m:{GLOBAL.TurnConcept}>>.[br/][br/]{LOC.TACTICAL@ABILITY@NEVER_IN_WATER}"

msgid "TOME_VIGOR@SKILL5@NAME"
msgstr "Totem da Natureza^n"

msgid "TOME_VIGOR@SKILL5@PROP_DESCRIPTION"
msgstr "No início de cada {GLOBAL.TurnConcept.Hyperlink}, invoca uma unidade animal aleatória de Tier I ou II.{LOC.CONCEPT@SUMMON_LIVE_SHARED}"

msgid "TOME_VIGOR@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Fortaleça suas unidades e exércitos com o poder bruto das feras selvagens. Especialize-se em fortalecer <<m:{GLOBAL.PROPERTIES.ANIMAL.Hyperlink}>> e aumentar <<m:{GLOBAL.HitPointConcept}>>."

msgid "TOME_VIGOR@TOME@LORE_AUTHOR"
msgstr "Zaethyl, Guardião Selvagem dos Primeiros Elfos"

msgid "TOME_VIGOR@TOME@LORE_DESCRIPTION"
msgstr "\"O poder indomável da manada trovejando pela planície, a força pura do poderoso urso ao se aproximar de sua presa. Ouça a música primordial que pulsa nos tendões e ossos das feras! Então, você será capaz de dominá-la e fortalecer sua matilha com a força da própria natureza.\""

msgid "TOME_VIGOR@TOME@NAME"
msgstr "Tomo do Vigor"

msgid "TOME_VIGOR@UNIT1@NAME"
msgstr "Totem da Natureza"

msgid "TOME_WARDING@HERO_SKILL@DESCRIPTION"
msgstr "Habilidades {GLOBAL.SupportConcept.Hyperlink} concedem {amount} {GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink} às unidades afetadas."

msgid "TOME_WARDING@HERO_SKILL@NAME"
msgstr "Suporte Fortificante"

msgid "TOME_WARDING@PASSIVE@DESCRIPTION"
msgstr "Custo de <<m:{GLOBAL.BuffSpellConcept.Hyperlink}>> -{amount} <<m:{GLOBAL.CombatCastingPointConcept.Hyperlink}>>."

msgid "TOME_WARDING@PASSIVE@NAME"
msgstr "Adeptos Protetores"

msgid "TOME_WARDING@SKILL1@DESCRIPTION"
msgstr "Unidade aliada alvo:[bulletlist][bullet/]Fica {GLOBAL.PROPERTIES.INVULNERABLE.Hyperlink} por {amount} {GLOBAL.TurnConcept}.[bullet/]Tem seu(a) <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>> removido(a).[/bulletlist][br/]Não pode ser usado em uma unidade mais de uma vez por batalha."

msgid "TOME_WARDING@SKILL1@NAME"
msgstr "Marca da Invulnerabilidade"

msgid "TOME_WARDING@SKILL2@DESCRIPTION"
msgstr "Faz as habilidades {GLOBAL.SupportConcept.Hyperlink} de unidades encantadas:[bulletlist][bullet/]Concederem +{amount} {GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink} às unidades afetadas.[/bulletlist]"

msgid "TOME_WARDING@SKILL2@MOD_DESCRIPTION"
msgstr "O alvo ganha {amount} {GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink}."

msgid "TOME_WARDING@SKILL2@NAME"
msgstr "Cajados de Proteção"

msgid "TOME_WARDING@SKILL2@PROPERRTY_DESCRIPTION"
msgstr "Habilidades {GLOBAL.SupportConcept.Hyperlink} concedem +{amount} {GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink} às unidades afetadas."

msgid "TOME_WARDING@SKILL3@DESCRIPTION"
msgstr "Invoca um(a) {GLOBAL.UNITS.PHANTASM_WARRIOR_UNIT.Hyperlink}, um(a) {GLOBAL.PROPERTIES.SHIELD_UNIT.Hyperlink} que ataca com {GLOBAL.LightningDamageConcept.Hyperlink}."

msgid "TOME_WARDING@SKILL3@NAME"
msgstr "Invocar Guerreiro Fantasma"

msgid "TOME_WARDING@SKILL4@DESCRIPTION"
msgstr "Unidade aliada alvo e outra em até {STATIC_SHIELD_UNIT_TARGETER_JUMP>MaxDistance} hexes ganham {GLOBAL.PROPERTIES.STATIC_SHIELD_GROUP.Hyperlink} por {STATIC_SHIELD_STATUS_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "TOME_WARDING@SKILL4@NAME"
msgstr "Escudo Estático"

msgid "TOME_WARDING@SKILL4@PROP_DESCRIPTION"
msgstr "Atacantes têm uma chance base de {STUNNED_RESISTANCE>ResolvedStrength}% de ficarem {GLOBAL.PROPERTIES.STUNNED.Hyperlink}."

msgid "TOME_WARDING@SKILL5@DESCRIPTION"
msgstr "Inscreve runas mágicas na raça alvo, concedendo:[bulletlist][bullet/]+{MAGIAL_WARDS_RESISTANCE>REDUCTION>Shock} {GLOBAL.LightningResistanceConcept.Hyperlink}[bullet/]+{MAGIAL_WARDS_RESISTANCE>REDUCTION>Fire} {GLOBAL.FireResistanceConcept.Hyperlink}[bullet/]+{MAGIAL_WARDS_RESISTANCE>REDUCTION>Frost} {GLOBAL.FrostResistanceConcept.Hyperlink}[/bulletlist]"

msgid "TOME_WARDING@SKILL5@NAME"
msgstr "Barreiras Mágicas"

msgid "TOME_WARDING@SKILL5@PROPERTY_DESCRIPTION"
msgstr "A unidade possui:[bulletlist][bullet/]+{MAGIAL_WARDS_RESISTANCE>REDUCTION>Shock} {GLOBAL.LightningResistanceConcept.Hyperlink}[bullet/]+{MAGIAL_WARDS_RESISTANCE>REDUCTION>Fire} {GLOBAL.FireResistanceConcept.Hyperlink}[bullet/]+{MAGIAL_WARDS_RESISTANCE>REDUCTION>Frost} {GLOBAL.FrostResistanceConcept.Hyperlink}[/bulletlist]"

msgid "TOME_WARDING@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Especialize-se em magia que protege suas unidades de dano e revida contra inimigos que as atacam."

msgid "TOME_WARDING@TOME@LORE_AUTHOR"
msgstr "Tempestade, Mestre das Tormentas"

msgid "TOME_WARDING@TOME@LORE_DESCRIPTION"
msgstr "\"Aqueles que dominam o arcano são como uma brisa suave para seus aliados, envolvendo-os em um cobertor protetor de ar, desviando golpes e canalizando o relâmpago para punir quem ousar se aproximar demais! Um mestre em proteção encontrará inúmeras formas de manter seus súditos a salvo.\""

msgid "TOME_WARDING@TOME@NAME"
msgstr "Tomo da Proteção"

msgid "TOME_WARDING@UNIT@NAME"
msgstr "Guerreiro Fantasma"

msgid "TOME_WILD@BEASTMASTER@ABILITY_1@DESCRIPTION"
msgstr "Por {UNLEASH_THE_BEAST_STATUS_EFFETC_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>, a unidade {GLOBAL.PROPERTIES.ANIMAL.Hyperlink} amiga alvo ganha:[bulletlist][bullet/]{GLOBAL.PROPERTIES.KILLING_MOMENTUM.Hyperlink}[bullet/]{strengthened} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}[bullet/]{regen} {GLOBAL.PROPERTIES.REGENERATION.Hyperlink}[/bulletlist]"

msgid "TOME_WILD@BEASTMASTER@ABILITY_1@NAME"
msgstr "Liberte a Fera"

msgid "TOME_WILD@BEASTMASTER@ABILITY_2@DESCRIPTION"
msgstr "Invoca uma unidade animal aleatória de Nível I.{LOC.CONCEPT@SUMMON_LIVE_SHARED}[br/][br/]Entra em {GLOBAL.DefenseModeConcept.Hyperlink} após o uso."

msgid "TOME_WILD@BEASTMASTER@ABILITY_2@DESCRIPTION_2"
msgstr "Invoca uma unidade animal aleatória de Tier II.{LOC.CONCEPT@SUMMON_LIVE_SHARED}[br/][br/]Entra em {GLOBAL.DefenseModeConcept.Hyperlink} após o uso."

msgid "TOME_WILD@BEASTMASTER@ABILITY_2@DESCRIPTION_CHAMPION"
msgstr "Conjurar Animal:[bulletlist][bullet/]Agora invoca um animal de Nível II.[/bulletlist]"

msgid "TOME_WILD@BEASTMASTER@ABILITY_2@NAME"
msgstr "Conjurar Animal"

msgid "TOME_WILD@BEASTMASTER@ABILITY_2@NAME_CHAMPION"
msgstr "Invocar Campeão Animal"

msgid "TOME_WILD@BEASTMASTER@ABILITY_3@DESCRIPTION"
msgstr "Animais neste exército requerem {CARETAKER_UPKEEP_MODIFIER>ResolvedUpkeepModifier}% menos {GLOBAL.UnitUpkeepConcept.Hyperlink} base."

msgid "TOME_WILD@BEASTMASTER@ABILITY_3@NAME"
msgstr "Guardião"

msgid "TOME_WILD@HERO_SKILL@DESCRIPTION"
msgstr "Enquanto esta unidade for a líder do exército, concede a outras unidades {GLOBAL.PROPERTIES.CAVALRY_GROUP.Hyperlink} e {GLOBAL.PROPERTIES.ANIMAL.Hyperlink}:[bulletlist][bullet/]{GLOBAL.PROPERTIES.FLANKER.Hyperlink}[bullet/]+{PACK_LEADER_CRIT_CHANCE>ResolvedCritChanceBonus}% de {GLOBAL.CriticalHitChanceConcept.Hyperlink}[/bulletlist]"

msgid "TOME_WILD@HERO_SKILL@NAME"
msgstr "Líder da Matilha"

msgid "TOME_WILD@HERO_SKILL@PROPERTY@DESCRIPTION"
msgstr "[bulletlist][bullet/]{GLOBAL.PROPERTIES.FLANKER.Hyperlink}[bullet/]+{PACK_LEADER_CRIT_CHANCE>ResolvedCritChanceBonus}% de {GLOBAL.CriticalHitChanceConcept.Hyperlink}[/bulletlist]"

msgid "TOME_WILD@HERO_SKILL@PROPERTY@NAME"
msgstr "Membro da Matilha"

msgid "TOME_WILD@SKILL1@DESCRIPTION"
msgstr "Inimigo alvo:[bulletlist][bullet/]Fica {GLOBAL.PROPERTIES.DISTRACTED.Hyperlink}.[bullet/]Sofre {stacks} {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink}.[/bulletlist]"

msgid "TOME_WILD@SKILL1@NAME"
msgstr "Marcar como Presa"

msgid "TOME_WILD@SKILL2@DESCRIPTION"
msgstr "Torna a raça alvo mais bestial e conectada aos animais. Quando adjacente a uma unidade aliada {GLOBAL.PROPERTIES.ANIMAL.Hyperlink}, ambas as unidades recebem:[bulletlist][bullet/]+{Damage}% de dano[bullet/]+{CriticalChance}% de {GLOBAL.CriticalHitChanceConcept}[/bulletlist]"

msgid "TOME_WILD@SKILL2@NAME"
msgstr "Parentesco Animal"

msgid "TOME_WILD@SKILL2@PROPERTY@ANIMAL_DESCRIPTION_BUFF"
msgstr "Esta unidade está adjacente a uma unidade aliada com {GLOBAL.PROPERTIES.ANIMAL_KINSHIP.Hyperlink} e ganha:[bulletlist][bullet/]+{ANIMAL_KINSHIP_DAMAGE>ResolvedMultiplier}% de dano[bullet/]+{ANIMAL_KINSHIP_CRIT_CHANCE>ResolvedCritChanceBonus}% de {GLOBAL.CriticalHitChanceConcept}[/bulletlist]"

msgid "TOME_WILD@SKILL2@PROPERTY@DESCRIPTION"
msgstr "Quando adjacente a uma {GLOBAL.PROPERTIES.ANIMAL.Hyperlink} aliada, ambas as unidades ganham:[bulletlist][bullet/]+{Damage}% de dano[bullet/]+{CriticalChance}% de {GLOBAL.CriticalHitChanceConcept}[/bulletlist]"

msgid "TOME_WILD@SKILL2@PROPERTY@DESCRIPTION_BUFF"
msgstr "Esta unidade está adjacente a uma unidade aliada {GLOBAL.PROPERTIES.ANIMAL.Hyperlink} e ganha:[bulletlist][bullet/]+{ANIMAL_KINSHIP_DAMAGE>ResolvedMultiplier}% de dano[bullet/]+{ANIMAL_KINSHIP_CRIT_CHANCE>ResolvedCritChanceBonus}% de {GLOBAL.CriticalHitChanceConcept}[/bulletlist]"

msgid "TOME_WILD@SKILL3@DESCRIPTION"
msgstr "[bulletlist][bullet/]Escolha uma unidade de {GLOBAL.PROPERTIES.ANIMAL.Hyperlink} de Nível I ou II para adicionar ao seu exército.[bullet/]As <<m:{GLOBAL.PROPERTIES.ANIMAL.Hyperlink}>> disponíveis dependem do tipo de terreno onde o feitiço é conjurado.[/bulletlist]"

msgid "TOME_WILD@SKILL3@DIALOG_CONFIRM"
msgstr "Escolher Esta Unidade"

msgid "TOME_WILD@SKILL3@DIALOG_DISMISS"
msgstr "Dispensar Unidades"

msgid "TOME_WILD@SKILL3@DIALOG_SUBHEADER_ARCTIC_UNDERGROUND"
msgstr "Várias feras emergem das cavernas congeladas, atendendo ao seu chamado."

msgid "TOME_WILD@SKILL3@DIALOG_SUBHEADER_ASTRAL_BARRENS"
msgstr "Several beasts emerge from the barren wastes, answering your call."

msgid "TOME_WILD@SKILL3@DIALOG_SUBHEADER_COLD"
msgstr "Várias feras emergem das brumas gélidas, atendendo ao seu chamado."

msgid "TOME_WILD@SKILL3@DIALOG_SUBHEADER_DEFAULT"
msgstr "Várias feras emergem da natureza selvagem, atendendo ao seu chamado."

msgid "TOME_WILD@SKILL3@DIALOG_SUBHEADER_HOT"
msgstr "Várias feras emergem dos ermos ardentes, atendendo ao seu chamado."

msgid "TOME_WILD@SKILL3@DIALOG_SUBHEADER_SUNLESS"
msgstr "Várias feras emergem dos ermos sombrios, atendendo ao seu chamado."

msgid "TOME_WILD@SKILL3@DIALOG_SUBHEADER_UNDERGROUND"
msgstr "Várias feras emergem das cavernas sombrias, atendendo ao seu chamado."

msgid "TOME_WILD@SKILL3@DIALOG_SUBHEADER_UNDERGROUND_FIRE"
msgstr "Várias feras emergem das cavernas flamejantes, atendendo ao seu chamado."

msgid "TOME_WILD@SKILL3@DIALOG_SUBHEADER_WATER"
msgstr "Várias feras emergem debaixo das ondas, atendendo ao seu chamado."

msgid "TOME_WILD@SKILL3@NAME"
msgstr "Invocar Animal Selvagem"

msgid "TOME_WILD@SKILL4@DESCRIPTION"
msgstr "Um(a) {GLOBAL.PROPERTIES.SUPPORT_UNIT.Hyperlink} que invoca e fortalece <<m:{GLOBAL.PROPERTIES.ANIMAL.Hyperlink}>>."

msgid "TOME_WILD@SKILL4@NAME"
msgstr "FaladorSelvagem^f"

msgid "TOME_WILD@SKILL5@DESCRIPTION"
msgstr "Unidades {GLOBAL.PROPERTIES.ANIMAL.Hyperlink} e {GLOBAL.PROPERTIES.CAVALRY_GROUP.Hyperlink} amigas em um raio de {CALL_OF_THE_WILD_CIRCLE_TARGETER>AREA>Radius} hexes ganham:[bulletlist][bullet/]{defense} {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink}[bullet/]{damage} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}[/bulletlist]"

msgid "TOME_WILD@SKILL5@NAME"
msgstr "Chamado da Natureza"

msgid "TOME_WILD@TOME@DESCRIPTION"
msgstr "Caminhe ao lado dos <<m:{GLOBAL.PROPERTIES.ANIMAL.Hyperlink}>> da natureza. Especialize-se em invocar e fortalecer <<m:{GLOBAL.PROPERTIES.ANIMAL.Hyperlink}>> e fique mais forte ao ficar próximo(a) delas."

msgid "TOME_WILD@TOME@LORE_AUTHOR"
msgstr "Serena, Feiticeira Élfica da Vida"

msgid "TOME_WILD@TOME@LORE_DESCRIPTION"
msgstr "\"São as feras que herdarão o mundo. Suas patas pisarão em nossos túmulos muito depois de suas presas terem triturado nossos ossos em pó. Invoca seu poder, se ousar. Comande sua ferocidade e a alimente, para que possa colher os benefícios desse poder primordial.\""

msgid "TOME_WILD@TOME@NAME"
msgstr "Tomo das Feras"

msgid "TOME_WILD_MAGIC@SKILL1@DESCRIPTION"
msgstr "[bulletlist][bullet/]No início da batalha, o atacante ganha {amount} {GLOBAL.UNITS.DEVASTATOR_SPHERE_UNIT.Hyperlink} até o fim da batalha.[bullet/]<<m:{GLOBAL.UNITS.DEVASTATOR_SPHERE_UNIT.Hyperlink}>> são {GLOBAL.PROPERTIES.SIEGECRAFT_UNIT.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> que podem se detonar em um obstáculo ou {GLOBAL.UnitConcept.Hyperlink} alvo para causar dano massivo e destruir obstáculos.[bullet/]Apenas um tipo de unidade de Cerco pode ser levado para {GLOBAL.CombatConcept.Hyperlink}. Se vários <<m:{GLOBAL.SiegeProjectConcept.Hyperlink}>> trouxessem essas unidades, apenas a mais forte aparecerá.[/bulletlist]"

msgid "TOME_WILD_MAGIC@SKILL1@DETONATE@DESCRIPTION"
msgstr "A unidade se autodestrói. Em um raio de {DETONATE_UNIT_TARGETER_CIRCLE>AREA>Radius} hexes:[bulletlist][bullet/]Unidades sofrem dano.[bullet/]Todos os obstáculos são destruídos.[bullet/]Define hexes como {GLOBAL.OnFireConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_WILD_MAGIC@SKILL1@DETONATE@NAME"
msgstr "Detonar e Devastar"

msgid "TOME_WILD_MAGIC@SKILL1@NAME"
msgstr "Construir Esferas Devastadoras"

msgid "TOME_WILD_MAGIC@SKILL2@DESCRIPTION"
msgstr "Um(a) {GLOBAL.PROPERTIES.SHOCK_UNIT.Hyperlink} monstruoso(a) usado(a) como arma de cerco viva."

msgid "TOME_WILD_MAGIC@SKILL2@NAME"
msgstr "RaçaGuerreira"

msgid "TOME_WILD_MAGIC@SKILL3@DESCRIPTION"
msgstr "Concede a unidades encantadas:[bulletlist][bullet/]+{FLAMEBURST_WEAPONS_CRITICAL>ResolvedCritChanceBonus}% de {GLOBAL.CriticalHitChanceConcept.Hyperlink}.[bullet/]Matar uma unidade faz com que ela exploda, inimigos adjacentes:[bulletlist][bullet/]Sustentar {FLAMEBURST_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Ganhar {amount} {GLOBAL.PROPERTIES.BURNING.Hyperlink} por {BURNING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][/bulletlist]"

msgid "TOME_WILD_MAGIC@SKILL3@MODIFIER_DESCRIPTION"
msgstr "Matar uma unidade faz com que ela exploda, inimigos adjacentes:[bulletlist][bullet/]Sofrem {FLAMEBURST_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Ganha {amount} {GLOBAL.PROPERTIES.BURNING.Hyperlink} por {BURNING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "TOME_WILD_MAGIC@SKILL3@NAME"
msgstr "Armas Explosivas de Chamas"

msgid "TOME_WILD_MAGIC@SKILL3@PROPERTY_DESCRIPTION"
msgstr "Esta unidade possui:[bulletlist][bullet/]+{FLAMEBURST_WEAPONS_CRITICAL>ResolvedCritChanceBonus}% {GLOBAL.CriticalHitChanceConcept.Hyperlink}[bullet/]Matar uma unidade faz com que ela exploda, inimigos adjacentes:[bulletlist][bullet/]Sofrem {FLAMEBURST_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Ganha {amount} {GLOBAL.PROPERTIES.BURNING.Hyperlink} por {BURNING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][/bulletlist]"

msgid "TOME_WILD_MAGIC@SKILL4@DESCRIPTION"
msgstr "[bulletlist][bullet/]No início da batalha, ganha {amount} unidades {GLOBAL.UNITS.WAR_HOUND_UNIT.Hyperlink} no lado do atacante até o fim da batalha.[/bulletlist]"

msgid "TOME_WILD_MAGIC@SKILL4@NAME"
msgstr "Liberar os Cães de Guerra"

msgid "TOME_WILD_MAGIC@SKILL6@DESCRIPTION"
msgstr "Alvo: unidade aliada de Nível I, II ou III, não {GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink}, não {GLOBAL.PROPERTIES.CONSTRUCT.Hyperlink}:[bulletlist][bullet/]Transforma-se em um(a) {GLOBAL.UNITS.WARBREED_UNIT.Hyperlink}.[bullet/]Cura {MONSTROUS_REBIRTH_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Morre no fim do combate.[/bulletlist][br][br/]Não pode ser usado em Combate Aquático."

msgid "TOME_WILD_MAGIC@SKILL6@NAME"
msgstr "Renascimento Monstruoso"

msgid "TOME_WILD_MAGIC@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Adquira os meios para tomar cidades com força avassaladora. Especialize-se em <<m:{GLOBAL.SiegeConcept.Hyperlink}>> e em causar dano."

msgid "TOME_WILD_MAGIC@TOME@LORE_AUTHOR"
msgstr "Asgera RachadordeEspinhos, Rainha da Guerra dos Orcs PresaSangrenta"

msgid "TOME_WILD_MAGIC@TOME@LORE_DESCRIPTION"
msgstr "\"Acima de tudo, a luta! Aqueles que vivem e respiram a guerra sempre lutarão pela vitória, mesmo depois de suas lâminas se quebrarem, seus ossos se partirem e seus cérebros virarem polpa. Construa as máquinas de guerra mais poderosas e incuta em seu exército uma fome por vitória. Então... Então você será imparável!\""

msgid "TOME_WILD_MAGIC@TOME@NAME"
msgstr "Tomo da Devastação"

msgid "TOME_WILD_MAGIC@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Desloca o alvo atacado e se move para o hex dele."

msgid "TOME_WILD_MAGIC@UNIT1@ABILITY1@DESCRIPTION_IF_MOVED"
msgstr "Se a unidade se moveu, desloca o alvo atacado e se move para seu hex."

msgid "TOME_WILD_MAGIC@UNIT1@ABILITY1@NAME"
msgstr "Deslocar e Substituir"

msgid "TOME_WILD_MAGIC@UNIT1@ABILITY2@DESCRIPTION"
msgstr "Ataca unidades em um cone de {unitsAmount} hexes.[bulletlist][bullet/]Cancela {GLOBAL.DefenseModeConcept.Hyperlink}.[bullet/]Remove {GLOBAL.RetaliationConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_WILD_MAGIC@UNIT1@ABILITY2@NAME"
msgstr "Golpe Poderoso"

msgid "TOME_WILD_MAGIC@UNIT1@NAME"
msgstr "RaçaGuerreira^m"

msgid "TOME_WILD_MAGIC@UNIT2@NAME"
msgstr "Esfera Devastadora^n"

msgid "TOME_WINDS@HERO_SKILL@DESCRIPTION"
msgstr "Sempre que esta unidade é atingida por um ataque, o atacante tem uma chance base de {AVENGING_WINDS_RESISTANCE_CHECK>ResolvedStrength}% de ser empurrado para trás {push} <<m:hex>>."

msgid "TOME_WINDS@HERO_SKILL@NAME"
msgstr "Ventos Vingativos"

msgid "TOME_WINDS@PASSIVE@DESCRIPTION"
msgstr "[bulletlist][bullet/]Rios contam como Estradas para fins de Movimento[bullet/]Rios <<m:{GLOBAL.ProvinceConcept}>> concedem +{amount} {GLOBAL.GoldConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_WINDS@PASSIVE@NAME"
msgstr "Navegantes dos Rios"

msgid "TOME_WINDS@SKILL1@DESCRIPTION"
msgstr "Puxa o inimigo mais próximo dentro de {ABDUCTING_CYCLONE_UNIT_TARGETER_NEAREST_TO_TARGET>MaxDistance} hexes para um hex vazio. Eles têm uma chance base de {STUNNED_RESISTANCE>ResolvedStrength}% de ficarem {GLOBAL.PROPERTIES.STUNNED.Hyperlink} por {STUNNED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "TOME_WINDS@SKILL1@NAME"
msgstr "Ciclone Abduzidor"

msgid "TOME_WINDS@SKILL2@DESCRIPTION"
msgstr "Concede a unidades encantadas:[bulletlist][bullet/]Montarias voadoras.[/bulletlist]"

msgid "TOME_WINDS@SKILL2@NAME"
msgstr "Batedores Alados"

msgid "TOME_WINDS@SKILL2@PROP_DESCRIPTION"
msgstr "A unidade possui:[bulletlist][bullet/]Uma montaria voadora.[/bulletlist]"

msgid "TOME_WINDS@SKILL3@DESCRIPTION"
msgstr "Unidades inimigas em um raio de {DUST_STORM_UNIT_TARGETER_SINGLE>AREA>Radius} hexes:[bulletlist][bullet/]Sustentar {DUST_STORM_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Têm uma chance base de {BLINDED_RESISTANCE>ResolvedStrength}% de ficarem {GLOBAL.PROPERTIES.BLINDED.Hyperlink} por {BLINDED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "TOME_WINDS@SKILL3@NAME"
msgstr "Tempestade de Poeira"

msgid "TOME_WINDS@SKILL4@DESCRIPTION"
msgstr "O exército aliado alvo recupera todos os seus pontos de Movimento se estiver na água. Metade se estiver em terra.[br/]Uma unidade não pode se beneficiar deste feitiço mais de uma vez por turno."

msgid "TOME_WINDS@SKILL4@NAME"
msgstr "Ventos Favoráveis"

msgid "TOME_WINDS@SKILL5@DESCRIPTION"
msgstr "Invoca um(a) {GLOBAL.UNITS.WIND_RAGER_UNIT.Hyperlink}, um(a) {GLOBAL.PROPERTIES.FIGHTER.Hyperlink} rápido(a) e disruptivo(a)."

msgid "TOME_WINDS@SKILL5@NAME"
msgstr "Invocar Fúria dos Ventos"

msgid "TOME_WINDS@SKILL6@DESCRIPTION"
msgstr "Um(a) {GLOBAL.PROPERTIES.RANGED_UNIT.Hyperlink} com alcance extra e uma habilidade de área de efeito."

msgid "TOME_WINDS@SKILL6@NAME"
msgstr "Arqueiro Zéfiro"

msgid "TOME_WINDS@TOME@DESCRIPTION"
msgstr "Aproveite os poderes do vento para ganhar impulsos de velocidade e atrapalhar inimigos."

msgid "TOME_WINDS@TOME@LORE_AUTHOR"
msgstr "Tempestade, Mestre das Tormentas"

msgid "TOME_WINDS@TOME@LORE_DESCRIPTION"
msgstr "\"Muito acima das mesquinhas maquinações dos mortais, fica o domínio do céu. Aqui, os ventos fluem selvagens e livres, desimpedidos pela terra abaixo, indiferentes, poderosos. Aqueles que conseguem dobrar esses ventos à sua vontade dominam uma força verdadeiramente poderosa e libertadora. Inimigos são varridos, arrancados da segurança, e aliados são amparados, fortalecidos além de suas capacidades limitadas pela terra.\""

msgid "TOME_WINDS@TOME@NAME"
msgstr "Tomo dos Ventos"

msgid "TOME_WINDS@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Causa dano a todos os inimigos adjacentes e os desloca até {WHIRLWIND_DISPLACEMENT>MaxDistance} hexes."

msgid "TOME_WINDS@UNIT1@ABILITY1@NAME"
msgstr "Redemoinho"

msgid "TOME_WINDS@UNIT1@ABILITY2@DESCRIPTION"
msgstr "Unidades amigas adjacentes têm {WIND_BARRIER>ResolvedAccuracyModifier}% mais chance de desviar de ataques {GLOBAL.RangedConcept.Hyperlink} e {GLOBAL.MagicConcept.Hyperlink}."

msgid "TOME_WINDS@UNIT1@ABILITY2@NAME"
msgstr "Aura de Barreira de Vento"

msgid "TOME_WINDS@UNIT1@NAME"
msgstr "Furioso do Vento^n"

msgid "TOME_WINDS@UNIT2@ABILITY1@DESCRIPTION"
msgstr "Causa dano à unidade alvo. Unidades inimigas adjacentes sofrem {ZEPHYR_SHOT_CIRCLE_TARGETER>ResolvedEffectMultiplier}% do dano."

msgid "TOME_WINDS@UNIT2@ABILITY1@NAME"
msgstr "Disparo Zéfiro"

msgid "TOME_WINDS@UNIT@NAME"
msgstr "Arqueiro Zéfiro"

msgid "TOME_ZEAL@HERO_SKILL@DESCRIPTION"
msgstr "A unidade inimiga alvo fica {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink} até o fim da batalha."

msgid "TOME_ZEAL@HERO_SKILL@NAME"
msgstr "Condenar"

msgid "TOME_ZEAL@PASSIVE@DESCRIPTION"
msgstr "Esta unidade se cura em +{ZEALOUS_ENDURANCE_AFTER_BATTLE_HEAL>Health} <<m:{GLOBAL.HitPointConcept.Hyperlink}>> após a batalha."

msgid "TOME_ZEAL@PASSIVE@NAME"
msgstr "Resistência Fanática"

msgid "TOME_ZEAL@SKILL1@DESCRIPTION"
msgstr "Invoca um {GLOBAL.UNITS.ZEALOT_UNIT.Hyperlink} no hexágono alvo do mundo. Um Zelote é um {GLOBAL.PROPERTIES.FIGHTER.Hyperlink} imprudente que tem vantagem contra unidades {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink}."

msgid "TOME_ZEAL@SKILL1@NAME"
msgstr "Invocar Zelote"

msgid "TOME_ZEAL@SKILL2@DESCRIPTION"
