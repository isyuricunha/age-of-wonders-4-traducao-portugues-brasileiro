msgid "TOME_BEACON@SKILL6@NAME"
msgstr "Conjurar Farol Divino"

msgid "TOME_BEACON@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Libera o brilho interior do(a) {GLOBAL.PROPERTIES.FAITHFUL.Hyperlink} para punir inimigos e fortalecer aliados."

msgid "TOME_BEACON@TOME@LORE_AUTHOR"
msgstr "Sola, a Pura, Humana Exaltada"

msgid "TOME_BEACON@TOME@LORE_DESCRIPTION"
msgstr "\"Fé, fervor, glória justa: tais coisas podem se espalhar como uma chama sagrada, trazendo a luz da verdade até mesmo aos olhos de seus inimigos! Um verdadeiro farol de fé brilha tão intensamente que cura as feridas dos fiéis e instila dúvida nos infiéis, conduzindo-os ao verdadeiro caminho... o seu caminho.\""

msgid "TOME_BEACON@TOME@NAME"
msgstr "Tomo do Farol"

msgid "TOME_BEACON@UNIT2@NAME"
msgstr "Farol Divino^n"

msgid "TOME_BEACON@UNIT2_ABILITY@DESCRIPTION"
msgstr "Unidades aliadas em até {DIVINE_BEACONS_GRACE_UNIT_TARGETER_CIRCLE>AREA>Radius} hexes:[bulletlist][bullet/]Cura +{DIVINE_BEACONS_GRACE_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Ganha {DIVINE_BEACONS_GRACE_MORALE_GAIN>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_BEACON@UNIT2_ABILITY@NAME"
msgstr "Graça do Farol Divino"

msgid "TOME_BEACON@UNIT@NAME"
msgstr "Portador da Luz^n"

msgid "TOME_BEASTS@PASSIVE@DESCRIPTION"
msgstr "<<m:{GLOBAL.PROPERTIES.ANIMAL.Hyperlink}>> têm Posto {amount}."

msgid "TOME_BEASTS@PASSIVE@NAME"
msgstr "Aguçar Instintos"

msgid "TOME_CHAOS_CHANNELING@HERO_SKILL@DESCRIPTION"
msgstr "Atacantes inimigos em até {CHAOTIC_REBUKE_MAGIC_EFFECT_SHIELD>MaxAttackerDistance} hexes têm uma chance base de {chance}% de ganhar um efeito de status aleatório."

msgid "TOME_CHAOS_CHANNELING@HERO_SKILL@NAME"
msgstr "Repúdio Caótico"

msgid "TOME_CHAOS_CHANNELING@PASSIVE@DESCRIPTION"
msgstr "Saquear <<m:{GLOBAL.ProvinceConcept}>> concede {amount} {GLOBAL.ManaConcept}."

msgid "TOME_CHAOS_CHANNELING@PASSIVE@NAME"
msgstr "Extrair Caos"

msgid "TOME_CHAOS_CHANNELING@SKILL1@DESCRIPTION"
msgstr "[bulletlist][bullet/]Invoca um exército completo de unidades aleatórias não-Explorador de Nível I que podem ser produzidas em uma cidade no hex alvo.[bullet/]Se conjurado dentro de um(a) {GLOBAL.ProvinceConcept.Hyperlink} inimigo(a), saqueia-o(a) instantaneamente.[/bulletlist]"

msgid "TOME_CHAOS_CHANNELING@SKILL1@NAME"
msgstr "Horda Dourada"

msgid "TOME_CHAOS_CHANNELING@SKILL2@DESCRIPTION"
msgstr "Todas as unidades inimigas:[bulletlist][bullet/]Sofrem {FAN_THE_INFERNO_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]São afetadas por {GLOBAL.PROPERTIES.BURNING.Hyperlink}.[/bulletlist]"

msgid "TOME_CHAOS_CHANNELING@SKILL2@NAME"
msgstr "Alimentar o Inferno"

msgid "TOME_CHAOS_CHANNELING@SKILL3@DESCRIPTION"
msgstr "Torna a raça alvo a personificação do fogo, concedendo-lhes:[bulletlist][bullet/]{SCION_OF_FLAME_DEFENSE>REDUCTION>Fire} {GLOBAL.FireResistanceConcept.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.VENGEFUL_FLAMES.Hyperlink}, que causa dano a {GLOBAL.MeleeConcept.Hyperlink} atacantes.[bullet/]{GLOBAL.PROPERTIES.FIERY_WAKE.Hyperlink}, que incendeia terrenos inflamáveis como <<m:{GLOBAL.FloraObstacleConcept.Hyperlink}>>.[bullet/]Imunidade a {GLOBAL.PROPERTIES.BURNING.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.LAVA_WALK.Hyperlink}.[bullet/]<<m:{GLOBAL.CityConcept.Hyperlink}>> desta raça ignoram a penalidade de {GLOBAL.CityStabilityConcept.Hyperlink} de Abismo e Lava em seu(a) {GLOBAL.DomainConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CHAOS_CHANNELING@SKILL3@NAME"
msgstr "Descendente das Chamas"

msgid "TOME_CHAOS_CHANNELING@SKILL3@PROPERTY_DESCRIPTION"
msgstr "A unidade tem:[bulletlist][bullet/]{SCION_OF_FLAME_DEFENSE>REDUCTION>Fire} {GLOBAL.FireResistanceConcept.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.VENGEFUL_FLAMES.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.FIERY_WAKE.Hyperlink}[bullet/]Imunidade a {GLOBAL.PROPERTIES.BURNING.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.LAVA_WALK.Hyperlink}[/bulletlist]"

msgid "TOME_CHAOS_CHANNELING@SKILL4@DESCRIPTION"
msgstr "Sempre que outra unidade morre em batalha, concede a unidades encantadas:[bulletlist][bullet/]{GLOBAL.PROPERTIES.INFERNAL_MIGHT.Hyperlink} por {INFERNAL_BLAZE_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]+{DEMONIC_SIPHON_MORALE>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}.[br/]Não é acionado pela morte de unidades <<m:{GLOBAL.PROPERTIES.COMBAT_SUMMON.Hyperlink}>>, {GLOBAL.PROPERTIES.TOWER_UNIT.Hyperlink} e {GLOBAL.PROPERTIES.SIEGECRAFT_UNIT.Hyperlink}.[/bulletlist]"

msgid "TOME_CHAOS_CHANNELING@SKILL4@NAME"
msgstr "Foco Infernal"

msgid "TOME_CHAOS_CHANNELING@SKILL4@PROPERTY_DESCRIPTION"
msgstr "Sempre que outra unidade morre em batalha, esta unidade ganha:[bulletlist][bullet/]{GLOBAL.PROPERTIES.INFERNAL_MIGHT.Hyperlink} por {INFERNAL_BLAZE_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]+{DEMONIC_SIPHON_MORALE>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}.[br/]Não é acionado pela morte de unidades <<m:{GLOBAL.PROPERTIES.COMBAT_SUMMON.Hyperlink}>>, {GLOBAL.PROPERTIES.TOWER_UNIT.Hyperlink} e {GLOBAL.PROPERTIES.SIEGECRAFT_UNIT.Hyperlink}.[/bulletlist]"

msgid "TOME_CHAOS_CHANNELING@SKILL4@PROP_DESCRIPTION"
msgstr "[bulletlist][bullet/]Ataques têm +{amount} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Pode ser acumulado até {amountStacks} vezes.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CHAOS_CHANNELING@SKILL4@PROP_NAME"
msgstr "Poder Infernal"

msgid "TOME_CHAOS_CHANNELING@SKILL5@DESCRIPTION"
msgstr "Afeta uma cidade e, sempre que você lutar nesse domínio, um(a) {GLOBAL.UNITS.GREMLIN_UNIT.Hyperlink} é invocado(a) ao lado de uma de suas unidades a cada {GLOBAL.TurnConcept.Hyperlink}.[br/]Até {amount} <<m:{GLOBAL.UNITS.GREMLIN_UNIT.Hyperlink}>> podem ser invocados(as) por batalha."

msgid "TOME_CHAOS_CHANNELING@SKILL5@NAME"
msgstr "Emboscadores Gremlins"

msgid "TOME_CHAOS_CHANNELING@SKILL5@PROP_DESCRIPTION"
msgstr "Um(a) {GLOBAL.UNITS.GREMLIN_UNIT.Hyperlink} é invocado(a) ao lado de uma de suas unidades a cada {GLOBAL.TurnConcept.Hyperlink}."

msgid "TOME_CHAOS_CHANNELING@SKILL6@DESCRIPTION"
msgstr "Invoca um(a) {GLOBAL.UNITS.MAGMA_SPIRIT.Hyperlink}, uma unidade de Nível III {GLOBAL.PROPERTIES.BATTLE_MAGE.Hyperlink}."

msgid "TOME_CHAOS_CHANNELING@SKILL6@NAME"
msgstr "Invocar Espírito de Magma"

msgid "TOME_CHAOS_CHANNELING@SKILL7@ABILITY_DESCRIPTION"
msgstr "Deal damage to units in a {FIRE_BOMB_TARGETER_CIRCLE>AREA>Radius}-hex radius."

msgid "TOME_CHAOS_CHANNELING@SKILL7@ABILITY_NAME"
msgstr "Fire Bomb"

msgid "TOME_CHAOS_CHANNELING@SKILL7@DESCRIPTION"
msgstr "Enchanted units gain:[bulletlist][bullet/]The {GLOBAL.PROPERTIES.FIRE_BOMB.Hyperlink} ability, which deals magical damage in an area.[bullet/]The damage of this ability increases with the unit's tier.[/bulletlist]"

msgid "TOME_CHAOS_CHANNELING@SKILL7@NAME"
msgstr "Flamer Focus"

msgid "TOME_CHAOS_CHANNELING@SKILL7@PROP_DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]The {GLOBAL.PROPERTIES.FIRE_BOMB.Hyperlink} ability.[/bulletlist]"

msgid "TOME_CHAOS_CHANNELING@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Torne-se o mestre do caos explorando seus poderes caóticos acumulados de {GLOBAL.ChaosConcept.Hyperlink} <<m:{GLOBAL.TomeConcept.Hyperlink}>> anteriores."

msgid "TOME_CHAOS_CHANNELING@TOME@LORE_AUTHOR"
msgstr "Karissa, a Vermelha, Senhora das Paixões"

msgid "TOME_CHAOS_CHANNELING@TOME@LORE_DESCRIPTION"
msgstr "\"Abraçe o caos, e ele também o abraçará, espalhando fervor por tudo que tocar! Um verdadeiro agente do caos verá a ordem e a lógica se transformarem em loucura e tumulto, sempre distorcidos a seu favor!\""

msgid "TOME_CHAOS_CHANNELING@TOME@NAME"
msgstr "Tomo da Canalização do Caos"

msgid "TOME_CHAOS_LORD@HERO_SKILL@DESCRIPTION"
msgstr "Invoca uma unidade aleatória de Nível I {GLOBAL.PROPERTIES.INFERNAL_FIEND.Hyperlink} sempre que esta unidade matar outra unidade. Há uma pequena chance de invocar uma unidade de Nível II {GLOBAL.PROPERTIES.INFERNAL_FIEND.Hyperlink} em vez disso.[br/]Não funciona em batalhas na Água."

msgid "TOME_CHAOS_LORD@HERO_SKILL@NAME"
msgstr "Matança Demoníaca"

msgid "TOME_CHAOS_LORD@PASSIVE@DESCRIPTION"
msgstr "Substitui um Ataque Impetuoso por um Ataque Irrefreável, que:[bulletlist][bullet/]Causa mais dano às {GLOBAL.FortificationHealthConcept} da cidade.[bullet/]Não reduz a <<m:{GLOBAL.HitPointConcept}>> de suas unidades.[bullet/]Não faz suas unidades ficarem {GLOBAL.PROPERTIES.EXHAUSTED.Hyperlink}.[/bulletlist]"

msgid "TOME_CHAOS_LORD@PASSIVE@NAME"
msgstr "Assalto Implacável"

msgid "TOME_CHAOS_LORD@PASSIVE@PROPERTY@DESCRIPTION"
msgstr "Acelera significativamente um cerco."

msgid "TOME_CHAOS_LORD@SKILL1@DESCRIPTION"
msgstr "Transforma a raça-alvo em seres demoníacos, concedendo-lhes:[bulletlist][bullet/]o tipo de unidade {GLOBAL.PROPERTIES.INFERNAL_FIEND.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.FLYING_MOVEMENT.Hyperlink}, aumentando a mobilidade.[bullet/]{GLOBAL.PROPERTIES.FRENZY.Hyperlink}, aumentando o dano conforme atacam.[bullet/]<<m:{GLOBAL.CityConcept.Hyperlink}>> desta raça ignoram a penalidade de {GLOBAL.CityStabilityConcept.Hyperlink} de Abismo e Lava em seu {GLOBAL.DomainConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CHAOS_LORD@SKILL1@NAME"
msgstr "Demônio-humano"

msgid "TOME_CHAOS_LORD@SKILL2@DESCRIPTION"
msgstr "Todas as unidades atacantes ganham {GLOBAL.PROPERTIES.KILLING_MOMENTUM.Hyperlink} e {GLOBAL.PROPERTIES.HASTENED.Hyperlink} por {HASTENED_EFFECT_DESCRIPTION_3>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "TOME_CHAOS_LORD@SKILL2@NAME"
msgstr "Investida Demoníaca"

msgid "TOME_CHAOS_LORD@SKILL3@DESCRIPTION"
msgstr "[bulletlist][bullet/]Após {turn} [turn/] em batalha, {Number} unidades inimigas não-{GLOBAL.HeroConcept.Hyperlink} são {GLOBAL.PROPERTIES.MIND_CONTROLLED} até o fim do combate.[bullet/]A cidade sofre -{HappinessDebuff} {GLOBAL.CityStabilityConcept.Hyperlink} enquanto estiver sitiada.[/bulletlist]"

msgid "TOME_CHAOS_LORD@SKILL3@NAME"
msgstr "Incitar Rebelião"

msgid "TOME_CHAOS_LORD@SKILL4@DESCRIPTION"
msgstr "Invoca um avatar de sua {GLOBAL.LeaderConcept.Hyperlink} em uma batalha. O avatar possui as mesmas habilidades que seu Governante e surge com <<m:{GLOBAL.ActionPointConcept.Hyperlink}>> completo. Todas as <<m:{GLOBAL.PROPERTIES.FIEND.Hyperlink}>> ganham +{AVATAR_OF_CHAOS_MORALE>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}.[br/][br/]{LOC.TACTICAL@ABILITY@NEVER_IN_WATER}[br/]Não pode ser usado em batalhas onde seu {GLOBAL.LeaderConcept.Hyperlink} estiver presente."

msgid "TOME_CHAOS_LORD@SKILL4@NAME"
msgstr "Invocar Avatar do Caos"

msgid "TOME_CHAOS_LORD@SKILL5@NAME"
msgstr "Era do Caos"

msgid "TOME_CHAOS_LORD@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Liberte forças caóticas sobre o mundo. Especialize-se em buffs ofensivos."

msgid "TOME_CHAOS_LORD@TOME@LORE_AUTHOR"
msgstr "Karissa, a Vermelha, Senhora das Paixões"

msgid "TOME_CHAOS_LORD@TOME@LORE_DESCRIPTION"
msgstr "\"Deleite-se com a desordem! Cresça no tumulto! Sua aura de caos é como uma névoa insidiosa que distorce a realidade e incita a loucura. A própria terra parece tremer com sua chegada, enquanto seres de reinos demoníacos tomam conhecimento. Nasça no fogo e no sangue, ó Godir, e traga a Era do Caos!\""

msgid "TOME_CHAOS_LORD@TOME@NAME"
msgstr "Tomo do Senhor do Caos"

msgid "TOME_COLD_DARK@HERO_SKILL@DESCRIPTION"
msgstr "Ataques base {GLOBAL.MagicConcept.Hyperlink} têm {BLINDED_RESISTANCE>ResolvedStrength}% de chance base de infligir {GLOBAL.PROPERTIES.BLINDED.Hyperlink}.[br/][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_COLD_DARK@HERO_SKILL@NAME"
msgstr "Magia Cegante"

msgid "TOME_COLD_DARK@PASSIVE@DESCRIPTION"
msgstr "Destruir <<m:{GLOBAL.CityConcept}>> e saquear <<m:{GLOBAL.ProvinceConcept}>> transforma a {GLOBAL.ProvinceConcept} em uma província Ártica."

msgid "TOME_COLD_DARK@PASSIVE@NAME"
msgstr "Ruínas Congeladas"

msgid "TOME_COLD_DARK@PASSIVE_FARMING@DESCRIPTION"
msgstr "Able to build <<m:{GLOBAL.FarmConcept.Hyperlink}>> on Snow terrain.[br/][br/]<<m:{GLOBAL.FarmConcept.Hyperlink}>> on Snow terrain gain +{amount} {GLOBAL.FoodConcept.Hyperlink} if your race has Arctic Adaptation."

msgid "TOME_COLD_DARK@PASSIVE_FARMING@NAME"
msgstr "Arctic Farming"

msgid "TOME_COLD_DARK@PASSIVE_STABILITY@DESCRIPTION"
msgstr "<<m:{GLOBAL.ProvinceConcept.Hyperlink}>> with Snow give +{amount} {GLOBAL.CityStabilityConcept.Hyperlink}."

msgid "TOME_COLD_DARK@PASSIVE_STABILITY@NAME"
msgstr "Snow Preference"

msgid "TOME_COLD_DARK@SKILL1@DESCRIPTION"
msgstr "A cada turno, para {BLINDING_MIST_AUTO_SPELL>TimeToLive} <<m:{GLOBAL.TurnConcept}>>, todos os inimigos:[bulletlist][bullet/]Sofrem {WITHERING_MIST_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Têm uma chance base de {BLINDED_RESISTANCE>ResolvedStrength}% de se tornarem {GLOBAL.PROPERTIES.BLINDED.Hyperlink} por {BLINDED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Têm uma chance base de {WEAKENED_RESISTANCE>ResolvedStrength}% de se tornarem {GLOBAL.PROPERTIES.WEAKENED.Hyperlink} por {WEAKENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "TOME_COLD_DARK@SKILL1@NAME"
msgstr "Névoa Murchante"

msgid "TOME_COLD_DARK@SKILL1@PROPERTY@DESCRIPTION"
msgstr "A cada turno, todos os inimigos:[bulletlist][bullet/]Sofrem {WITHERING_MIST_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Têm uma chance base de {BLINDED_RESISTANCE>ResolvedStrength}% de se tornarem {GLOBAL.PROPERTIES.BLINDED.Hyperlink} por {BLINDED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Têm uma chance base de {WEAKENED_RESISTANCE>ResolvedStrength}% de se tornarem {GLOBAL.PROPERTIES.WEAKENED.Hyperlink} por {WEAKENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "TOME_COLD_DARK@SKILL2@DESCRIPTION"
msgstr "Invoca um(a) {GLOBAL.UNITS.SNOW_SPIRIT.Hyperlink}, um(a) {GLOBAL.PROPERTIES.SKIRMISHER.Hyperlink} com ataques que infligem {GLOBAL.PROPERTIES.FROZEN.Hyperlink}."

msgid "TOME_COLD_DARK@SKILL2@NAME"
msgstr "Invocar Espírito da Neve"

msgid "TOME_COLD_DARK@SKILL3@DESCRIPTION"
msgstr "Faz o inverno correr nas veias da raça-alvo, concedendo-lhes:[bulletlist][bullet/]{FROSTLING_TRANSFORMATION_DEFENSE>REDUCTION>Frost} {GLOBAL.FrostResistanceConcept.Hyperlink}.[bullet/]Imunidade a {GLOBAL.PROPERTIES.FROZEN.Hyperlink}.[bullet/]+{FROSTLING_TRANSFORMATION_MORALE_BONUS_FROZEN_WASTE>MoraleBonus} {GLOBAL.UnitMoraleConcept.Hyperlink} em terreno frio.[bullet/]{GLOBAL.PROPERTIES.ARCTIC_WALK.Hyperlink}, permitindo que atravessem terrenos frios mais rápido.[/bulletlist]"

msgid "TOME_COLD_DARK@SKILL3@NAME"
msgstr "Transformação em Frostling"

msgid "TOME_COLD_DARK@SKILL3@PROP_DESCRIPTION"
msgstr "A unidade possui:[bulletlist][bullet/]{FROSTLING_TRANSFORMATION_DEFENSE>REDUCTION>Frost} {GLOBAL.FrostResistanceConcept.Hyperlink}.[bullet/]Imunidade a {GLOBAL.PROPERTIES.FROZEN.Hyperlink}.[bullet/]+{FROSTLING_TRANSFORMATION_MORALE_BONUS_FROZEN_WASTE>MoraleBonus} {GLOBAL.UnitMoraleConcept.Hyperlink} em terreno frio.[bullet/]{GLOBAL.PROPERTIES.ARCTIC_WALK.Hyperlink}.[/bulletlist]"

msgid "TOME_COLD_DARK@SKILL4@DESCRIPTION"
msgstr "O alvo que lidera um exército ganha {GLOBAL.PROPERTIES.UNIVERSAL_CAMOUFLAGE.Hyperlink} para todo o exército por {turns} <<m:{GLOBAL.TurnConcept}>>."

msgid "TOME_COLD_DARK@SKILL4@NAME"
msgstr "Véu das Trevas"

msgid "TOME_COLD_DARK@SKILL4@PROPERTY@DESCRIPTION"
msgstr "Todo o exército ganha {GLOBAL.PROPERTIES.UNIVERSAL_CAMOUFLAGE.Hyperlink}."

msgid "TOME_COLD_DARK@SKILL5@DESCRIPTION"
msgstr "A {GLOBAL.CityConcept.Hyperlink} amiga-alvo ganha:[bulletlist]A cada {GLOBAL.TurnConcept.Hyperlink}, {amount} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> dentro ou adjacentes à {GLOBAL.DomainConcept.Hyperlink}:[bulletlist][bullet/]Ganham {GLOBAL.SnowConcept.Hyperlink} e {GLOBAL.FrozenWasteConcept.Hyperlink}.[bullet/]Perdem {GLOBAL.ChasmConcept.Hyperlink}, {GLOBAL.SwampConcept.Hyperlink}, {GLOBAL.AshlandsConcept.Hyperlink}, {GLOBAL.SandConcept.Hyperlink}, {GLOBAL.CavernFloorConcept.Hyperlink}, {GLOBAL.FungusFieldsConcept.Hyperlink} e {GLOBAL.GloomTerrainConcept.Hyperlink}.[/bulletlist][bullet/]Províncias no domínio com Neve ou Gelo fornecem +{resources} de renda de {GLOBAL.FoodConcept.Hyperlink} e +{resources} de renda de {GLOBAL.StructureProductionConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_COLD_DARK@SKILL5@NAME"
msgstr "Inverno Marchante"

msgid "TOME_COLD_DARK@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Espalhe o terreno Ártico pelo mundo e envolva suas unidades com seu poder, para que sejam fortalecidas por sua presença."

msgid "TOME_COLD_DARK@TOME@LORE_AUTHOR"
msgstr "Artica, a Fria, Rainha dos Frostlings"

msgid "TOME_COLD_DARK@TOME@LORE_DESCRIPTION"
msgstr "\"A luz traz calor e esperança. Apague-a e mergulhe seus inimigos em uma noite fria e eterna! Roube-lhes o conforto, destrua sua esperança, deixe-os com membros dormentes e olhos cegos. A escuridão minará a vontade de lutar, de vencer, de viver dos seus inimigos!\""

msgid "TOME_COLD_DARK@TOME@NAME"
msgstr "Tomo do Frio Sombrio"

msgid "TOME_CREATOR@HERO_SKILL@DESCRIPTION"
msgstr "A unidade cresce em tamanho e ganha:[bulletlist][bullet/]{GLOBAL.PROPERTIES.LARGE_TARGET.Hyperlink}[bullet/]+{ANCIENT_OF_EARTH_STAT_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]+{ANCIEN_OF_EARTH_DAMAGE_MULTIPLIER>ResolvedMultiplier}% de dano[/bulletlist][br/]A unidade não pode mais usar uma montaria."

msgid "TOME_CREATOR@HERO_SKILL@DESCRIPTION_DRGON"
msgstr "A unidade ganha:[bulletlist][bullet/]+{ANCIENT_OF_EARTH_STAT_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]+{ANCIEN_OF_EARTH_DAMAGE_MULTIPLIER>ResolvedMultiplier}% de dano[/bulletlist]"

msgid "TOME_CREATOR@HERO_SKILL@ES_NAME"
msgstr "Antigo(a)"

msgid "TOME_CREATOR@HERO_SKILL@NAME"
msgstr "Antigo da Terra"

msgid "TOME_CREATOR@PASSIVE@DESCRIPTION"
msgstr "Unidades não-{GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink} são produzidas com a Patente {amount}."

msgid "TOME_CREATOR@PASSIVE@NAME"
msgstr "Forjas Lendárias"

msgid "TOME_CREATOR@SKILL1@SPELL2@DESCRIPTION"
msgstr "A província Montanha-alvo se torna uma província Rochosa."

msgid "TOME_CREATOR@SKILL1@SPELL2@NAME"
msgstr "Montanhas Baixas"

msgid "TOME_CREATOR@SKILL2@DESCRIPTION"
msgstr "[bulletlist][bullet/]Invoca um(a) {GLOBAL.UNITS.EARTH_TITAN_UNIT.Hyperlink} no hexágono desocupado-alvo.[bullet/]Todos os inimigos adjacentes perdem {GLOBAL.DefenseModeConcept.Hyperlink} e {GLOBAL.RetaliationConcept.Hyperlink}.[/bulletlist][br/][br/]{LOC.TACTICAL@ABILITY@NEVER_IN_WATER}"

msgid "TOME_CREATOR@SKILL2@NAME"
msgstr "Invocar o Titã da Terra"

msgid "TOME_CREATOR@SKILL3@DESCRIPTION"
msgstr "[bulletlist][bullet/]Todos os inimigos sofrem {TECTONIC_SHATTER_UNIT_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Todos os inimigos têm {STUNNED_RESISTANCE>ResolvedStrength}% de chance base de serem {GLOBAL.PROPERTIES.STUNNED.Hyperlink}.[bullet/]Todos os obstáculos no mapa têm {obstacles}% de chance de serem destruídos.[/bulletlist]"

msgid "TOME_CREATOR@SKILL3@NAME"
msgstr "Fratura Tectônica"

msgid "TOME_CREATOR@SKILL4@DESCRIPTION"
msgstr "Concede às unidades encantadas:[bulletlist][bullet/]{GLOBAL.PROPERTIES.NATURAL_REGENERATION_GROUP.Hyperlink}[bullet/]+{SHAPERS_TOUCH_STAT_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]+{SHAPERS_TOUCH_DEFENSE>REDUCTION>Shock} {GLOBAL.LightningResistanceConcept.Hyperlink}[/bulletlist]"

msgid "TOME_CREATOR@SKILL4@NAME"
msgstr "Toque do Moldador"

msgid "TOME_CREATOR@SKILL4@PROP_DESCRIPTION"
msgstr "A unidade possui:[bulletlist][bullet/]{GLOBAL.PROPERTIES.NATURAL_REGENERATION_GROUP.Hyperlink}[bullet/]+{SHAPERS_TOUCH_STAT_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]+{SHAPERS_TOUCH_DEFENSE>REDUCTION>Shock} {GLOBAL.LightningResistanceConcept.Hyperlink}[/bulletlist]"

msgid "TOME_CREATOR@SKILL5@NAME"
msgstr "Era do Materium"

msgid "TOME_CREATOR@SKILL6@DESCRIPTION"
msgstr "[bulletlist][bullet/]No início da batalha, todos os obstáculos de Muralha são danificados.[bullet/]No início da batalha, ganhe {amount} unidades {GLOBAL.UNITS.EARTHSHATTER_ENGINE_UNIT.Hyperlink} no lado do atacante até o fim da batalha.[bullet/]<<m:{GLOBAL.UNITS.EARTHSHATTER_ENGINE_UNIT.Hyperlink}>> são {GLOBAL.PROPERTIES.SIEGECRAFT_UNIT.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> com ataques de curto alcance e área de efeito que podem destruir obstáculos e derrubar unidades inimigas de {GLOBAL.DefenseModeConcept.Hyperlink}.[bullet/]Apenas um tipo de unidade de Cerco pode ser levado para {GLOBAL.CombatConcept.Hyperlink}. Se múltiplos <<m:{GLOBAL.SiegeProjectConcept.Hyperlink}>> trouxessem-nas, apenas o mais forte aparecerá.[/bulletlist]"

msgid "TOME_CREATOR@SKILL6@NAME"
msgstr "Criar Motores de Terraquebrar"

msgid "TOME_CREATOR@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Molde o mundo, invoque titãs adormecidos e torne-se o mestre da terra."

msgid "TOME_CREATOR@TOME@LORE_AUTHOR"
msgstr "Mãe Mab, Deusa dos Goblins"

msgid "TOME_CREATOR@TOME@LORE_DESCRIPTION"
msgstr "\"Aqueles que dominam o Materium estão acima do mundo, arrasando e derrubando terras por capricho, e dominando as forças primordiais da criação. Os próprios titãs caminharão ao seu lado, enquanto as essências de elemento e mineral se ajoelham. Você é o Criador, um moldador de mundos.\""

msgid "TOME_CREATOR@TOME@NAME"
msgstr "Tomo do Criador"

msgid "TOME_CREATOR@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Afeta todos os inimigos em um raio de {SEISMIC_SLAM_UNIT_TARGETER_CIRCLE>AREA>Radius} hexágonos."

msgid "TOME_CREATOR@UNIT1@ABILITY1@NAME"
msgstr "Golpe Sísmico"

msgid "TOME_CREATOR@UNIT1@DESCRIPTION"
msgstr "Obedecendo apenas aos mestres absolutos da terra, o Titã da Terra é uma força imparável e a personificação da fúria da terra."

msgid "TOME_CREATOR@UNIT1@NAME"
msgstr "Titã da Terra^n"

msgid "TOME_CREATOR@UNIT2@ABILITY1@DESCRIPTION"
msgstr "Unidades inimigas em um raio de {EARTH_TREMOR_UNIT_TARGETER_CIRCLE>AREA>Radius} hexágonos:[bulletlist][bullet/]Sofrem dano[bullet/]Perdem {GLOBAL.DefenseModeConcept.Hyperlink}[bullet/]Perdem {GLOBAL.RetaliationConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CREATOR@UNIT2@ABILITY1@NAME"
msgstr "Tremor de Terra"

msgid "TOME_CREATOR@UNIT2@DESCRIPTION"
msgstr "Aríete lento, mas poderoso, capaz de destruir seções inteiras de muralhas em instantes."

msgid "TOME_CREATOR@UNIT2@NAME"
msgstr "Motor de Terraquebrar^n"

msgid "TOME_CRICIBLE@SKILL2@DEFENSE_DESCRIPTION"
msgstr "Adiciona obstáculos de Bastiões de Cadinho em {GLOBAL.CombatConcept.Hyperlink} durante um(a) {GLOBAL.SiegeConcept.Hyperlink}.[br/][br/]Obstáculos de Bastião de Cadinho concedem ataques de {GLOBAL.RangedConcept.Hyperlink} e {GLOBAL.MagicConcept.Hyperlink}:[bulletlist][bullet/]Causam {damage} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Deixam os hexágonos afetados {GLOBAL.OnFireConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CRUCIBLE@HERO_SKILL@DESCRIPTION"
msgstr "[bulletlist][bullet/]Ataques base causam {METEOR_ARROWS_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} ao alvo e inimigos adjacentes.[bullet/]Todos os ataques ganham {GLOBAL.PROPERTIES.DEMOLISHER.Hyperlink}.[br/][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}[/bulletlist]"

msgid "TOME_CRUCIBLE@HERO_SKILL@MOD_DESCRIPTION"
msgstr "+{METEOR_ARROWS_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} ao alvo e inimigos adjacentes."

msgid "TOME_CRUCIBLE@HERO_SKILL@NAME"
msgstr "Impactos de Meteoro"

msgid "TOME_CRUCIBLE@PASSIVE@DESCRIPTION"
msgstr "[bulletlist][bullet/]Minas concedem renda de {amount} {GLOBAL.ManaConcept}.[bullet/]Minas agora podem ser construídas em <<m:{GLOBAL.ProvinceConcept}>> com características de Lava ou Abismo.[/bulletlist]"

msgid "TOME_CRUCIBLE@PASSIVE@NAME"
msgstr "Mineração Pirossifônica"

msgid "TOME_CRUCIBLE@SKILL1@DESCRIPTION"
msgstr "Alvo {GLOBAL.ProvinceConcept.Hyperlink}:[bulletlist][bullet/]Se contiver um(a) {GLOBAL.ProvinceImprovementConcept.Hyperlink} inimigo(a), ele(a) será [hyperlink,GLOBAL.PillagingConcept]Pilhado(a)[/hyperlink].[bulletlist][bullet/]Você não ganhará suas recompensas nem perderá {GLOBAL.AlignmentConcept.Hyperlink}.[/bulletlist][bullet/]<<m:{GLOBAL.UnitConcept.Hyperlink}>> inimigos(as) na província sofrem {damage} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]A província ganha {GLOBAL.AshlandsConcept.Hyperlink}.[bullet/]A província perde {GLOBAL.RiverConcept.Hyperlink}, {GLOBAL.FertilePlainsConcept.Hyperlink}, {GLOBAL.SwampConcept.Hyperlink}, {GLOBAL.SnowConcept.Hyperlink}, {GLOBAL.FrozenWasteConcept.Hyperlink}, {GLOBAL.SandConcept.Hyperlink}, {GLOBAL.CavernFloorConcept.Hyperlink} e {GLOBAL.GloomTerrainConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CRUCIBLE@SKILL1@NAME"
msgstr "Erupção Piroclástica"

msgid "TOME_CRUCIBLE@SKILL2@DEFENSE_DESCRIPTION"
msgstr "Adiciona obstáculos de Bastiões de Cadinho em {GLOBAL.CombatConcept.Hyperlink} durante um(a) {GLOBAL.SiegeConcept.Hyperlink}.[br/][br/]Obstáculos de Bastião de Cadinho concedem ataques de {GLOBAL.RangedConcept.Hyperlink} e {GLOBAL.MagicConcept.Hyperlink}:[bulletlist][bullet/]Causam {damage} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Deixam os hexágonos afetados {GLOBAL.OnFireConcept.Hyperlink}.[bullet/]Ignoram {GLOBAL.ObscuredConcept.Hyperlink} nos alvos.[bullet/]{rangebonus} {GLOBAL.RangeConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CRUCIBLE@SKILL2@DESCRIPTION"
msgstr "{GLOBAL.CityBattlementStructureConcept.Hyperlink}[br/][bulletlist][bullet/]Muralhas concedem {GLOBAL.RangedConcept.Hyperlink} e ataques {GLOBAL.MagicConcept.Hyperlink}:[bulletlist][bullet/]Causam {damage}.[bullet/]Definem os hexes afetados como {GLOBAL.OnFireConcept.Hyperlink}.[bullet/]Ignoram {GLOBAL.ObscuredConcept.Hyperlink} nos alvos.[bullet/]{rangebonus} {GLOBAL.RangeConcept.Hyperlink}[/bulletlist][bullet/]A cidade ignora penalidades negativas de {GLOBAL.CityStabilityConcept.Hyperlink} ao anexar províncias com {GLOBAL.ChasmConcept.Hyperlink} ou {GLOBAL.LavaConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CRUCIBLE@SKILL2@MARKER@DESCRIPTION"
msgstr "Ataques base de {GLOBAL.RangedConcept.Hyperlink} e {GLOBAL.MagicConcept.Hyperlink}:[bulletlist][bullet/]Causam {damage} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Deixam o terreno {GLOBAL.OnFireConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CRUCIBLE@SKILL2@MARKER@NAME"
msgstr "Runas da Imolação"

msgid "TOME_CRUCIBLE@SKILL2@MODIFIER_DESCRIPTION"
msgstr "Esta unidade foi construída em uma Cidade com a estrutura Cadinho Fortificado, fazendo com que os ataques desta unidade causem {damage}."

msgid "TOME_CRUCIBLE@SKILL2@NAME"
msgstr "Muralhas do Cadinho"

msgid "TOME_CRUCIBLE@SKILL2@UNLOCK@NAME"
msgstr "Batalhas de Parapeitos do Cadinho em Combate"

msgid "TOME_CRUCIBLE@SKILL3@DESCRIPTION"
msgstr "Afeta um raio de {LAVA_BURST_OBSTACLE_TARGETER_CIRCLE>AREA>Radius} hexes:[bulletlist][bullet/]Todas as unidades sofrem {LAVA_BURST_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Todas as unidades são afetadas por {GLOBAL.PROPERTIES.BURNING.Hyperlink}.[bullet/]Todas as unidades ficam {GLOBAL.PROPERTIES.SLOWED.Hyperlink}.[bullet/]O terreno é definido como {GLOBAL.OnFireConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CRUCIBLE@SKILL3@NAME"
msgstr "Erupção de Lava"

msgid "TOME_CRUCIBLE@SKILL4@DESCRIPTION"
msgstr "Até {METEOR_SHOWER_AUTO_SPELL>MaxCastCount} unidades inimigas aleatórias e inimigos adjacentes a elas:[bulletlist][bullet/]Sofrem {METEOR_SHOWER_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} e {METEOR_SHOWER_UNIT_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[/bulletlist][br/]Este feitiço se repete no início de cada turno pelos próximos {METEOR_SHOWER_AUTO_SPELL>TimeToLive} <<m:{GLOBAL.TurnConcept}>>."

msgid "TOME_CRUCIBLE@SKILL4@NAME"
msgstr "Chuva de Meteoros"

msgid "TOME_CRUCIBLE@SKILL5@DESCRIPTION"
msgstr "Faz com que os ataques base das unidades encantadas:[bulletlist][bullet/]Causem +{METEOR_ARROWS_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} ao alvo e inimigos adjacentes.[bullet/]Ganhem {GLOBAL.PROPERTIES.DEMOLISHER.Hyperlink}, permitindo destruir obstáculos reforçados.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CRUCIBLE@SKILL5@MOD_DESCRIPTION"
msgstr "[bulletlist][bullet/]+{METEOR_ARROWS_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} no alvo e inimigos adjacentes.[bullet/]Tem {GLOBAL.PROPERTIES.DEMOLISHER.Hyperlink}[/bulletlist]"

msgid "TOME_CRUCIBLE@SKILL5@NAME"
msgstr "Projéteis de Meteoro"

msgid "TOME_CRUCIBLE@SKILL5@PROP_DESCRIPTION"
msgstr "Os ataques básicos da unidade têm:[bulletlist][bullet/]+{METEOR_ARROWS_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} no alvo e inimigos adjacentes.[bullet/]{GLOBAL.PROPERTIES.DEMOLISHER.Hyperlink}.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CRUCIBLE@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Enterre seus inimigos em lava e molde a terra usando as forças destrutivas da terra e do fogo."

msgid "TOME_CRUCIBLE@TOME@LORE_AUTHOR"
msgstr "Yaka, o autoproclamado Deus do Fogo"

msgid "TOME_CRUCIBLE@TOME@LORE_DESCRIPTION"
msgstr "\"Não é a magma um espetáculo glorioso de se contemplar? Uma união de fogo e terra fluindo inexoravelmente em direção aos seus inimigos, engolindo-os, trazendo morte flamejante! A própria paisagem é remodelada quando ela flui, com belas cicatrizes traçadas sobre o reino.\""

msgid "TOME_CRUCIBLE@TOME@NAME"
msgstr "Tomo do Cadinho"

msgid "TOME_CRYOMANCY@PASSIVE@DESCRIPTION"
msgstr "Ganha {amount} {GLOBAL.KnowledgeConcept} por cada nível {GLOBAL.UnitConcept} morto em {GLOBAL.CombatConcept}."

msgid "TOME_CRYOMANCY@PASSIVE@NAME"
msgstr "Preservar Espécimes"

msgid "TOME_CRYOMANCY@SKILL_1@DESCRIPTION"
msgstr "Alvo inimigo:[bulletlist][bullet/]Sofre {ICE_COFFIN_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Tem uma chance base de {FROZEN_RESISTANCE>ResolvedStrength}% de se tornar {GLOBAL.PROPERTIES.FROZEN.Hyperlink}. Se não for bem-sucedido, inflige {GLOBAL.PROPERTIES.STATUS_VULNERABILITY.Hyperlink}.[/bulletlist]"

msgid "TOME_CRYOMANCY@SKILL_1@NAME"
msgstr "Caixão de Gelo"

msgid "TOME_CRYOMANCY@SKILL_2@DESCRIPTION"
msgstr "Concede acesso a um {GLOBAL.PROPERTIES.BATTLE_MAGE.Hyperlink} que inflige {GLOBAL.PROPERTIES.FROZEN.Hyperlink}."

msgid "TOME_CRYOMANCY@SKILL_2@NAME"
msgstr "Bruxa Branca^f"

msgid "TOME_CRYOMANCY@SKILL_3@DESCRIPTION"
msgstr "Ataques base {GLOBAL.MeleeConcept.Hyperlink} de unidades encantadas causam:[bulletlist][bullet/]+{FROST_BLADES_EXTRA_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]{FROST_BLADES_EXTRA_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]+{FROST_BLADES_DAMAGE_MULTIPLIER>ResolvedMultiplier}% de dano contra unidades {GLOBAL.PROPERTIES.FROZEN.Hyperlink} ou {GLOBAL.PROPERTIES.SLOWED.Hyperlink}.[/bulletlist] [br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CRYOMANCY@SKILL_3@NAME"
msgstr "Lâminas de Gelo"

msgid "TOME_CRYOMANCY@SKILL_3@PROP_DESCRIPTION"
msgstr "Ataques base {GLOBAL.MeleeConcept.Hyperlink} da unidade têm:[bulletlist][bullet/]+{FROST_BLADES_EXTRA_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]{FROST_BLADES_EXTRA_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]+{FROST_BLADES_DAMAGE_MULTIPLIER>ResolvedMultiplier}% de dano contra unidades {GLOBAL.PROPERTIES.FROZEN.Hyperlink} e {GLOBAL.PROPERTIES.SLOWED.Hyperlink}.[/bulletlist] [br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CRYOMANCY@SKILL_4@DESCRIPTION"
msgstr "Invoca um(a) {GLOBAL.UNITS.LESSER_SNOW_SPIRIT.Hyperlink}, um(a) {GLOBAL.PROPERTIES.SKIRMISHER.Hyperlink} com ataques que infligem {GLOBAL.PROPERTIES.FROZEN.Hyperlink}."

msgid "TOME_CRYOMANCY@SKILL_4@NAME"
msgstr "Invocar Espírito da Neve Menor"

msgid "TOME_CRYOMANCY@SKILL_5@DESCRIPTION"
msgstr "Todas as unidades no exército inimigo alvo:[bulletlist][bullet/]Sofrem {amount} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Recebem {vulnerability} {GLOBAL.StatusResistanceConcept.Hyperlink} por {turn} {GLOBAL.WorldMapConcept.Name} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "TOME_CRYOMANCY@SKILL_5@NAME"
msgstr "Nevasca"

msgid "TOME_CRYOMANCY@SKILL_5@PROPERTY@DESCRIPTION"
msgstr "{BLIZZARD_STATUS_RESISTANCE>Resistance} {GLOBAL.StatusResistanceConcept.Hyperlink}"

msgid "TOME_CRYOMANCY@SKILL_6@DESCRIPTION"
msgstr "Ataques base {GLOBAL.RangedConcept.Hyperlink} de unidades encantadas ganham:[bulletlist][bullet/]+{FROST_BLADES_EXTRA_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]{FROST_BLADES_EXTRA_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Uma chance base de {SLOWED_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.SLOWED.Hyperlink}.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CRYOMANCY@SKILL_6@NAME"
msgstr "Flechas de Gelo"

msgid "TOME_CRYOMANCY@SKILL_6@PROP_DESCRIPTION"
msgstr "Ataques base {GLOBAL.RangedConcept.Hyperlink} da unidade têm:[bulletlist][bullet/]+{FROST_BLADES_EXTRA_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]{FROST_BLADES_EXTRA_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Uma chance base de {SLOWED_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.SLOWED.Hyperlink}.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CRYOMANCY@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Especializado em causar {GLOBAL.FrostDamageConcept.Hyperlink} e infligir {GLOBAL.PROPERTIES.FROZEN.Hyperlink}."

msgid "TOME_CRYOMANCY@TOME@LORE_AUTHOR"
msgstr "Ártica, a Fria, Rainha dos Frostlings"

msgid "TOME_CRYOMANCY@TOME@LORE_DESCRIPTION"
msgstr "\"Quando todo o mundo se transformar em gelo, vejo um paraíso puro dos Frostlings! Congele seus membros e torne seus ossos frágeis, aprisionados em sangue gélido! Convoca a nevasca para congelar a carne e inspirar o medo que remonta a uma época em que os mortais se encolhiam em cavernas, temendo que o frio os levasse...\""

msgid "TOME_CRYOMANCY@TOME@NAME"
msgstr "Tomo de Criomancia"

msgid "TOME_CRYOMANCY@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Causa dano a uma unidade inimiga alvo."

msgid "TOME_CRYOMANCY@UNIT1@ABILITY1@ENHANCED_DESCRIPTION"
msgstr "Explosão Congelante:[bulletlist][bullet/]Causa {FREEZING_BLAST_ENHANCED_DAMAGE>DAMAGE>Frost} adicional {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Não tem tempo de recarga.[/bulletlist]"

msgid "TOME_CRYOMANCY@UNIT1@ABILITY1@ENHANCED_NAME"
msgstr "Explosão Congelante Aprimorada"

msgid "TOME_CRYOMANCY@UNIT1@ABILITY1@MASTER_DESCRIPTION"
msgstr "Explosão Congelante:[bulletlist][bullet/]Causa {FREEZING_BLAST_ENHANCED_DAMAGE>DAMAGE>Frost} adicional {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Tem uma chance base de {FROZEN_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.FROZEN.Hyperlink}.[/bulletlist]"

msgid "TOME_CRYOMANCY@UNIT1@ABILITY1@MASTER_NAME"
msgstr "Explosão Congelante do Campeão"

msgid "TOME_CRYOMANCY@UNIT1@ABILITY1@NAME"
msgstr "Explosão Congelante"

msgid "TOME_CYCLES@ABILITY1@DESCRIPTION"
msgstr "Quando esta unidade mata outra, seus tempos de recarga são reiniciados."

msgid "TOME_CYCLES@ABILITY1@NAME"
msgstr "Vida da Morte"

msgid "TOME_CYCLES@ABILITY_2@DESCRIPTION"
msgstr "Pequena chance de matar instantaneamente um alvo ferido. Essa chance aumenta quanto menor for o(a) <<m:{GLOBAL.HitPointConcept}>> do alvo. Se não for bem-sucedido, o alvo ganha {amount2} {GLOBAL.PROPERTIES.WEAKENED.Hyperlink}."

msgid "TOME_CYCLES@ABILITY_2@NAME"
msgstr "Fim do Ciclo"

msgid "TOME_CYCLES@ABILITY_3@DESCRIPTION"
msgstr "Unidade aliada alvo:[bulletlist][bullet/]Se estiver viva, cura +{RESTART_THE_CYCLE_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Se estiver morta, é ressuscitada com {RESTART_THE_CYCLE_RESSURECT>ResolvedHitPoints}% do seu total de <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[/bulletlist]"

msgid "TOME_CYCLES@ABILITY_3@DESCRIPTION_CHAMPION"
msgstr "Reiniciar o Ciclo: [bulletlist][bullet/]Cura {healAmount} adicional <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Ressuscita unidades com {resurrectPercentage}% adicional de seu total de <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[/bulletlist]"

msgid "TOME_CYCLES@ABILITY_3@ERROR_MESSAGE"
msgstr "Requer {GLOBAL.PROPERTIES.LIFE_FROM_DEATH_ABILITY_MODIFIER.Hyperlink} para ser usado."

msgid "TOME_CYCLES@ABILITY_3@NAME"
msgstr "Reiniciar o Ciclo"

msgid "TOME_CYCLES@ABILITY_3@NAME_CHAMPION"
msgstr "Reiniciar o Ciclo do Campeão"

msgid "TOME_CYCLES@ABILITY_4@DESCRIPTION"
msgstr "Uma unidade aliada não-herói é morta, inimigos adjacentes sofrem {SACRIFICIAL_BLIGHT_DAMAGE>DAMAGE>Blight} {GLOBAL.BlightDamageConcept.Hyperlink} por nível da unidade sacrificada.[br/][br/]Esta habilidade sempre é ativada {GLOBAL.PROPERTIES.LIFE_FROM_DEATH_ABILITY_MODIFIER.Hyperlink},"

msgid "TOME_CYCLES@ABILITY_4@NAME"
msgstr "Praga Sacrificial"

msgid "TOME_CYCLES@HERO_SKILL@DESCRIPTION"
msgstr "Ataques base têm uma chance base de {DECAYING_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.DECAYING.Hyperlink}.[br/][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CYCLES@HERO_SKILL@NAME"
msgstr "Deterioração Debilitante"

msgid "TOME_CYCLES@PASSIVE@DESCRIPTION"
msgstr "Reduz pela metade as quedas de moral causadas pela morte de unidades aliadas."

msgid "TOME_CYCLES@PASSIVE@NAME"
msgstr "Ciclo da Vida"

msgid "TOME_CYCLES@SKILL1@DESCRIPTION"
msgstr "Ataques base de unidades encantadas:[bulletlist][bullet/]Infligem {GLOBAL.PROPERTIES.DECAYING.Hyperlink}, um efeito de dano contínuo que reduz a cura recebida.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CYCLES@SKILL1@NAME"
msgstr "Lâminas da Decadência"

msgid "TOME_CYCLES@SKILL1@PROP_DESCRIPTION"
msgstr "Ataques base da unidade:[bulletlist][bullet/]Infligem {GLOBAL.PROPERTIES.DECAYING.Hyperlink}.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CYCLES@SKILL2@DESCRIPTION"
msgstr "{GLOBAL.PROPERTIES.SUPPORT_UNIT.Hyperlink} que manipula a vida e a morte como parte do ciclo natural."

msgid "TOME_CYCLES@SKILL2@NAME"
msgstr "Druida do Ciclo^n"

msgid "TOME_CYCLES@SKILL3@DESCRIPTION"
msgstr "Unidade inimiga alvo:[bulletlist][bullet/]Sofre {DIFFUSE_HEALTH_DAMAGE>DAMAGE>Blight} {GLOBAL.BlightDamageConcept.Hyperlink}.[bullet/]Ganha {amountDecaying} {GLOBAL.PROPERTIES.DECAYING_DAMAGE_OVER_TIME.Hyperlink}.[/bulletlist][br/]Unidades aliadas em um alcance de {DIFFUSE_HEALTH_UNIT_TARGETER_FRIENDLY>AREA>Radius} hexes. [bulletlist][bullet/]Cura +{DIFFUSE_HEALTH_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Ganha {amountRegeneration} {GLOBAL.PROPERTIES.REGENERATION.Hyperlink}.[/bulletlist]"

msgid "TOME_CYCLES@SKILL3@NAME"
msgstr "Saúde Difusa"

msgid "TOME_CYCLES@SKILL4@DESCRIPTION"
msgstr "Até o fim da batalha, sempre que uma unidade aliada morrer, todas as outras unidades aliadas a até {PARTING_GIFTS_UNIT_TARGETER_CIRCLE>AREA>Radius} hexes de distância curam +{PARTING_GIFTS_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>."

msgid "TOME_CYCLES@SKILL4@NAME"
msgstr "Presentes de Despedida"

msgid "TOME_CYCLES@SKILL4@PROP_DESCRIPTION"
msgstr "Quando esta unidade morrer, unidades aliadas a até {amount} hexes de distância a curam +{amount2} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>."

msgid "TOME_CYCLES@SKILL5@AUTUMN_DESCRIPTION"
msgstr "Inimigos do dono são afligidos com {amount4} {GLOBAL.PROPERTIES.WEAKENED.Hyperlink}."

msgid "TOME_CYCLES@SKILL5@AUTUMN_NAME"
msgstr "Ciclo das Estações: Outono"

msgid "TOME_CYCLES@SKILL5@DESCRIPTION"
msgstr "Todas as batalhas que ocorrem no domínio da cidade-alvo ganham [abilityblue]Ciclo das Estações[/abilityblue], concedendo um efeito diferente a cada turno de batalha na seguinte ordem:[bulletlist][bullet/]Inverno: Todos os inimigos sofrem {amount} [damageFrost/].[bullet/]Primavera: Todas as unidades aliadas se tornam {amount2} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}.[bullet/]Verão: Todas as unidades aliadas recuperam +{amount3} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Outono: Todos os inimigos se tornam {amount4} {GLOBAL.PROPERTIES.WEAKENED.Hyperlink}.[/bulletlist]"

msgid "TOME_CYCLES@SKILL5@DISPLAY_DESCRIPTION"
msgstr "Concede um efeito diferente a cada turno na seguinte ordem:"

msgid "TOME_CYCLES@SKILL5@NAME"
msgstr "Ciclo das Estações"

msgid "TOME_CYCLES@SKILL5@SPRING_DESCRIPTION"
msgstr "As unidades do dono se tornam {amount2} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}."

msgid "TOME_CYCLES@SKILL5@SPRING_NAME"
msgstr "Ciclo das Estações: Primavera"

msgid "TOME_CYCLES@SKILL5@SUMMER_DESCRIPTION"
msgstr "As unidades do dono curam +{amount3}<<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>."

msgid "TOME_CYCLES@SKILL5@SUMMER_NAME"
msgstr "Ciclo das Estações: Verão"

msgid "TOME_CYCLES@SKILL5@WINTER_NAME"
msgstr "Ciclo das Estações: Inverno"

msgid "TOME_CYCLES@SKILL5@WINTER_PROP_DESCRIPTION"
msgstr "Inimigos do dono sofrem {amount} {GLOBAL.FrostDamageConcept.Hyperlink}."

msgid "TOME_CYCLES@SKILL6@DESCRIPTION"
