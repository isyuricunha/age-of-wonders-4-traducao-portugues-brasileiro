msgid "DLC@RISEFROMRUIN@SPAWNERS_STRATEGIC@FLEETING_FRACTURED_INFESTATION@DESCRIPTION"
msgstr "Uma cicatriz temporária habitada por criaturas {GLOBAL.PROPERTIES.MANA_STARVED.Hyperlink} que se espalham {GLOBAL.AstralBarrensConcept.Hyperlink} em seu território.[br/][br/]Se não forem contidas, elas crescerão em força, expandirão seu território e enviarão exércitos de invasão."

msgid "DLC@RISEFROMRUIN@SPAWNERS_STRATEGIC@FLEETING_FRACTURED_INFESTATION@NAME"
msgstr "Infestação Fraturada Efêmera"

msgid "DLC@RISEFROMRUIN@SPAWNERS_STRATEGIC@FRACTURED_INFESTATION@DESCRIPTION"
msgstr "Uma cicatriz maciça habitada por criaturas {GLOBAL.PROPERTIES.MANA_STARVED.Hyperlink}.[br/]Esta infestação se espalha {GLOBAL.AstralBarrensConcept.Hyperlink} em seu território.[br/]Se não forem contidos, eles crescerão em força, expandirão seu território e enviarão exércitos de invasão."

msgid "DLC@RISEFROMRUIN@SPAWNERS_STRATEGIC@FRACTURED_INFESTATION@LORE"
msgstr "Um {GLOBAL.FractureLoreConcept.Hyperlink} deixa apenas morte e devastação. A terra torna‑se árida, seus habitantes torcidos e deformados. Os amaldiçoados que sobrevivem tornam‑se cascas vazias que mal se assemelham a seus antigos eus, impulsionados por uma fome voraz de mana. Sua própria presença drena a energia ao redor, transformando os lugares que habitam e espalhando a poluição ainda mais."

msgid "DLC@RISEFROMRUIN@SPAWNERS_STRATEGIC@FRACTURED_INFESTATION@NAME"
msgstr "Infestação Fraturada"

msgid "DLC@RISEFROMRUIN@SPAWNERS_STRATEGIC@GREAT_WORM_INFESTATION@DESCRIPTION"
msgstr "Uma cicatriz maciça habitada pelo Grande Verme e sua prole.[br/]Esta infestação se espalha {GLOBAL.AstralBarrensConcept.Hyperlink} em seu território.[br/]Se não forem contidos, eles crescerão em força, expandirão seu território e enviarão exércitos de invasão. O território do Grande Verme sofrerá {GLOBAL.PROPERTIES.TSR_RFR_GWL_WORM_PROPERTY.Hyperlink}."

msgid "DLC@RISEFROMRUIN@SPAWNERS_STRATEGIC@GREAT_WORM_INFESTATION@NAME"
msgstr "Grande Infestação de Vermes"

msgid "DLC@RISEFROMRUIN@SPELL_PROPERTY@IRRADIANT_FLARE@DESCRIPTION"
msgstr "Exército-alvo:[bulletlist][bullet/]Concede {amount} {GLOBAL.PhysicalDamageConcept.Hyperlink}, dobrado se lançado sobre um {GLOBAL.AstralBarrensConcept.Hyperlink}.[bullet/]Por {duration} {GLOBAL.WorldMapConcept.Hyperlink} {GLOBAL.TurnConcept}, no início do combate, as unidades deste exército têm {amount2}% de chance de se tornarem {GLOBAL.PROPERTIES.MANA_DRAINED.Hyperlink}.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@SPELL_PROPERTY@VOLATILE_FRACTURE@DESCRIPTION"
msgstr "Exército-alvo:[bulletlist][bullet/]Concede {amount} {GLOBAL.PhysicalDamageConcept.Hyperlink}, dobrado se lançado sobre um {GLOBAL.AstralBarrensConcept.Hyperlink}.[bullet/]Por {duration} {GLOBAL.WorldMapConcept.Hyperlink} {GLOBAL.TurnConcept}, no início do combate, as unidades deste exército têm {amount2}% de chance de se tornarem {GLOBAL.PROPERTIES.MANA_DRAINED.Hyperlink}.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1329@BODY_HEADER"
msgstr "Você é saudado por {EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name}: \"Uma bênção ao cruzarmos nossos caminhos!\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1329@BODY_LORE"
msgstr "{EventHouseLord.Name} fala como se dirigisse a um <<PlayerLeader{irmão/irmã}>>. \"O mesmo vento que guia o meu {EventHouseRace} também impulsiona o seu {PlayerRace} adiante, ó {PlayerLeader.Title}. {EventPhrase}\" O {EventHouseLord.Title} sorri. \"Que ventos quentes o levem à fortuna, meu companheiro de viagem.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1329@BUTTON_0"
msgstr "Inspecione {EventHouse}, onde a {EventHouseRace} montou acampamento."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1329@BUTTON_1"
msgstr "\"E que as tempestades jamais o encontrem. Adeus por enquanto.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1329@TITLE"
msgstr "Encontro Amigável {EventHouse}"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1332@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} chama você. \"A estrada nos apresenta um amigo hoje!\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1332@BODY_LORE"
msgstr "{EventHouseLord.Name} inspeciona sua comitiva. \"Posso perceber que seu {PlayerRace} segue um caminho diferente do meu {EventHouseRace}. {EventPhrase} Enquanto você, {EventPhrase2}.\" O {EventHouseLord.Title} sorri e dá de ombros. \"Há muito espaço neste reino para vagar. Seja bem-vindo. Não estaremos em seu caminho.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1332@BUTTON_0"
msgstr "Visite {EventHouse}, onde habitam os Conquistadores."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1332@BUTTON_1"
msgstr "\"Que nossos caminhos se cruzem favoravelmente novamente.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1332@BUTTON_2"
msgstr "Visite {EventHouse}, onde habitam os Saqueadores."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1332@TITLE"
msgstr "Encontro com {EventAdjective} {EventHouse}"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1333@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} inclina-se perante você. Há curiosidade nos olhos de <<o:EventHouseLord>>. \"Saudações e boas-vindas, viajante.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1333@BODY_LORE"
msgstr "Não precisa se apresentar ao {EventHouseLord.Title} sorridente: \"Já vimos seu {EventCity}, sua pedra e madeira firmemente assentadas sobre o <<m:EventGeo>>. Muito antes de sua chegada, os {EventHouseRace} vagam por este reino em busca de recompensas e tesouros.\" {EventHouseLord.Name} coloca a mão <<o:EventHouseLord>> sobre o peito <<o:EventHouseLord>>. \"No entanto, prometemos não erguer nossas tendas em seu domínio.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1333@BUTTON_0"
msgstr "Inspecione as versáteis tendas de {EventHouse}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1333@BUTTON_1"
msgstr "\"Está decidido. Viaje em paz.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1333@TITLE"
msgstr "Encontro com {EventHouse.Name} Errante"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1334@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} saúda você. Mas antes que possa falar, o {EventHouseLord.Title} levanta <<o:EventHouseLord>> mão. \"Falarei.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1334@BODY_LORE"
msgstr "{EventHouseLord.Name} parece morno. \"Meus batedores viram onde seu {PlayerRace} se estabeleceu. Não entendo por que alguém se instalaria em <<m:EventGeo>> {EventDirection} de um {EventStructure}. O {EventHouseRace} faria as malas e se mudaria para terras mais abundantes. Mas o que sabemos sobre o funcionamento das mentes dos {GLOBAL.GodirLoreConcept.Hyperlink}?\" {EventHouseLord} zombou. \"Se me deixar em paz, retribuirei a cortesia.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1334@BUTTON_0"
msgstr "Veja onde {EventHouse} foi criado."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1334@BUTTON_1"
msgstr "\"Um prazer. Adeus.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1334@TITLE"
msgstr "Encontre {EventHouse} Errante"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1335@BODY_HEADER"
msgstr "Assim que {EventHouseLord.TitleName} da {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} o vê, <<p:EventHouseLord>> lança-lhe o olhar maligno."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1335@BODY_LORE"
msgstr "\"Não temos nada a discutir, {PlayerLeader.Title},\" o {EventHouseLord.Title} resmunga \"Direi apenas isto: a estrada que leva a {EventCity} é um caminho de guerra. O {EventHouseRace} marchará até você com machados afiados e longas flechas. Nossa chegada será como a de uma tempestade, cheia de fúria e impulsionada pelos ventos.\" O {EventHouseLord.Title} lhe lança um último olhar desdenhoso antes de desaparecer."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1335@BUTTON_0"
msgstr "Espie {EventHouse}, o acampamento hostil dos {EventHouseRace}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1335@BUTTON_1"
msgstr "\"Então encontrarei você na estrada da guerra.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1335@TITLE"
msgstr "Encontro com {EventHouse} em marcha"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1339@BODY_FOOTER"
msgstr "A nascente represada permite que o {EnemyUnit} produza vastas quantidades de <<m:EventUnit>> no {EventStructure}. Será que {EventHero} tolerará isso?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1339@BODY_FOOTER@HERO_IS_PLAYELEA"
msgstr "A nascente represada permite que o {EnemyUnit} produza vastas quantidades de <<m:EventUnit>> no {EventStructure}. Você tolerará isso?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1339@BODY_HEADER"
msgstr "{EventHero} é atraído para o {EventStructure} pelos sons metálicos de ferramentas e máquinas. Um ateliê de cerco é construído aqui."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1339@BODY_HEADER@HERO_IS_PLAYELEA"
msgstr "Você é atraído para o {EventStructure} pelos sons metálicos de ferramentas e máquinas. Um ateliê de cerco é construído aqui."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1339@BODY_LORE"
msgstr "Mercenários industriosos represaram o {GLOBAL.STRUCTURES.HIDDEN_WELLSPRING.Hyperlink} que nasce aqui, desviando suas águas intermináveis para alimentar uma manufatura de máquinas de cerco. O leito seco e drenado do lago está indefeso perante os caprichos dos ventos fortes. Tempestades de areia perigosas, agitadas pelos ventos furiosos, varrem o deserto árido. Um {EnemyUnit} grita ordens aos trabalhadores acorrentados, chicoteando-os com <<o:EnemyUnit>> {EventItem}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1339@BODY_LORE@HERO_IS_PLAYELEA"
msgstr "Mercenários industriosos represaram o {GLOBAL.STRUCTURES.HIDDEN_WELLSPRING.Hyperlink} que nasce aqui, desviando suas águas intermináveis para alimentar uma manufatura de máquinas de cerco. Ao drenar a nascente, o leito seco que resta fica sujeito aos caprichos dos ventos fortes que o atravessam. Tempestades de areia perigosas são agitadas pelos ventos furiosos, varrendo o deserto árido. Um {EnemyUnit} supervisor grita ordens."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1339@BUTTON_0"
msgstr "Ataque os bandoleiros industriosos."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1339@BUTTON_1"
msgstr "Chame os trabalhadores [structureprod/] de {EventCity} para sabotar a manufatura de cerco."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1339@BUTTON_2"
msgstr "Alimente as chamas que movem as construções de cerco."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1339@BUTTON_3"
msgstr "Assuma o controle das tempestades de areia furiosas."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1339@BUTTON_4"
msgstr "Permita que os bandoleiros continuem seu trabalho por enquanto."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1339@TITLE"
msgstr "Desvio Barrado"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1340@BODY_FOOTER"
msgstr "Ferramentas recuperadas da oficina ajudarão <<G:trabalhadores^p,EventCity>>. O {EventStructure} pode abrigar outra benção para apoiar seus esforços de guerra."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1340@BODY_FOOTER@HERO_IS_PLAYELEA"
msgstr "Ferramentas encontradas na oficina de cerco ajudarão muito {EventCity}. Mas certamente você reivindicará outro prêmio do {EventStructure}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1340@BODY_HEADER"
msgstr "Após a batalha contra o {EnemyUnit} e o <<o:EnemyUnit>> <<m:EventUnit>>, {EventHero} inspeciona a oficina de cerco e a barragem."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1340@BODY_HEADER@HERO_IS_PLAYELEA"
msgstr "Após a batalha contra o {EnemyUnit} e o <<o:EnemyUnit>> <<m:EventUnit>>, você inspeciona a oficina de cerco e a barragem."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1340@BODY_LORE"
msgstr "{EventHero.FirstName} não tem certeza se o {EnemyUnit} estava criando o <<m:EventUnit>> para outros suseranos, ou se <<p:EnemyUnit>> estava formando um exército para <<r:EnemyUnit>>. <<m:EventUnitB>> saem cautelosamente da oficina de cerco, capturados pelos mercenários e forçados a operar a maquinaria. Eles entregam testemunhos assustadores sobre a <<G:crueldade^n,EnemyUnit>> e o <<o:EnemyUnit>> rindo enquanto <<p:EnemyUnit>> os despedaçaria com <<o:EnemyUnit>> {EventItem}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1340@BODY_LORE@HERO_IS_PLAYELEA"
msgstr "Você não tem certeza se o {EnemyUnit} estava criando o <<m:EventUnit>> para outros suseranos, ou se <<p:EnemyUnit>> estava formando um exército para <<r:EnemyUnit>>. <<m:EventUnitB>> saem cautelosamente da oficina de cerco, capturados pelos mercenários e forçados a operar a maquinaria. Eles entregam testemunhos assustadores sobre a <<G:crueldade^n,EnemyUnit>> e o <<o:EnemyUnit>> rindo enquanto <<p:EnemyUnit>> os despedaçaria com <<o:EnemyUnit>> {EventItem}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1340@BUTTON_0"
msgstr "Recupere bronze e aço não utilizados para <<G:forjas^p,EventCity>>. [unitprod/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1340@BUTTON_1"
msgstr "Conclua a produção de um(a) {EventUnit}. [unit/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1340@BUTTON_2"
msgstr "Aliste [unit/] o(a) <<m:EventUnitB>> libertado(a)."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1340@BUTTON_3"
msgstr "Encontre o {EventItem} que o {EnemyUnit} empunhou."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1340@BUTTON_4"
msgstr "Quebre a barragem para honrar a Natureza. [natureboon/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1340@TITLE"
msgstr "Desvio Barrado: Consequência"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1341@BODY_FOOTER"
msgstr "Os [hyperlink,GLOBAL.PROPERTIES.BATTLE_MAGE]Magos de Batalha[/hyperlink] sepultados, tecendo um redemoinho de magia, gritam: \"Prove seu valor ao Cabal da Conjuração.\" Como {EventHero.FirstName} reagirá?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1341@BODY_FOOTER@HERO_IS_PLAYELEA"
msgstr "Os [hyperlink,GLOBAL.PROPERTIES.BATTLE_MAGE]Magos de Batalha[/hyperlink] sepultados, tecendo um redemoinho de magia, gritam: \"Prove seu valor ao Cabal da Conjuração.\" Como você reagirá?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1341@BODY_HEADER"
msgstr "{EventHero} encontra a entrada de um(a) {EventStructure}. Suas portas estão seladas. Ninguém esteve aqui por séculos."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1341@BODY_HEADER@HERO_IS_PLAYELEA"
msgstr "Você encontra a entrada de um(a) {EventStructure}. Suas portas estão seladas. Ninguém esteve aqui por séculos."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1341@BODY_HEADER@PLAYER_REVISITS"
msgstr "Seu exército retorna ao {EventStructure}. Nada indica que outra alma esteve aqui desde sua última visita."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1341@BODY_LORE"
msgstr "Entretanto, dentro, tochas acesas guiam o caminho entre afrescos emaranhados de teias e estátuas cobertas de musgo até um santuário interno, onde vários [hyperlink,GLOBAL.PROPERTIES.BATTLE_MAGE]Magos de Batalha[/hyperlink] sentam-se à mesa redonda entre pilhas de tomos. Os Magos de Batalha se voltam para você em uníssono. \"És tu quem nos libertará?\" dizem antes de se levantar. Relâmpagos arcos entre eles. \"Aquele digno de nossos segredos?\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1341@BODY_LORE@HERO_IS_PLAYELEA"
msgstr "Entretanto, dentro, tochas acesas guiam o caminho entre afrescos emaranhados de teias e estátuas cobertas de musgo até um santuário interno, onde vários [hyperlink,GLOBAL.PROPERTIES.BATTLE_MAGE]Magos de Batalha[/hyperlink] sentam-se à mesa redonda entre pilhas de tomos. Os Magos de Batalha se voltam para {EventHero.FirstName} em uníssono. \"És tu quem nos libertará?\" dizem antes de se levantar. Relâmpagos arcos entre eles. \"Aquele digno de nossos segredos?\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1341@BUTTON_0"
msgstr "Mergulhe no caos mágico para destruir o Cabal."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1341@BUTTON_1"
msgstr "Proteja [mana/] seus guerreiros contra as aflições dos feitiços dos Magos."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1341@BUTTON_2"
msgstr "Demonstre seu domínio sobre o arcano."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1341@BUTTON_3"
msgstr "Banhe-se no redemoinho de magia liberado pelos Magos."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1341@BUTTON_4"
msgstr "Fuja do Cabal da Conjuração e resele o {EventStructure}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1341@TITLE"
msgstr "Cabal da Conjuração"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1342@BODY_FOOTER"
msgstr "Um grande {EnemyUnit} irrompe do solo, ameaçando {EventHero.FirstName}. <<p:EventHero>> ficará e lutará, ou fugirá para salvar a vida de <<o:EventHero>>?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1342@BODY_FOOTER@HERO_IS_PLAYELEA"
msgstr "Um grande {EnemyUnit} irrompe do solo, ameaçando você. Você ficará e lutará, ou fugirá para salvar sua vida?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1342@BODY_HEADER"
msgstr "O {EventStructure} que paira sobre o exército de {EventHero} e <<o:EventHero>> é oco e repleto de furos. Trilhas conduzem ao tronco cavernoso."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1342@BODY_HEADER@HERO_IS_PLAYELEA"
msgstr "O {EventStructure} que paira sobre você e seu exército é oco e repleto de furos. Trilhas conduzem ao tronco cavernoso."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1342@BODY_LORE"
msgstr "<<Cp:EventHero>> encontra um(a) {RandomUnit} assustado(a) dentro. De repente, o chão sob os <<G:pés^p,{EventHero.FirstName}>> treme. O {RandomUnit} olha freneticamente para o solo... e então desaparece em uma fonte de terra. O tumulto afasta vermes e criaturas da madeira podre do {EventStructure}, que buscam alimento. O chão volta a tremer."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1342@BODY_LORE@HERO_IS_PLAYELEA"
msgstr "Você encontra um(a) {RandomUnit} assustado(a) dentro. De repente, o chão sob seus pés treme. O {RandomUnit} olha freneticamente para o solo... e então desaparece em uma fonte de terra. O tumulto afasta vermes e criaturas da madeira podre do {EventStructure}, que buscam alimento. O chão volta a tremer."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1342@BUTTON_0"
msgstr "Extermine as pragas que infestam o {EventStructure}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1342@BUTTON_1"
msgstr "Pise devagar e de forma irregular para atrapalhar a <<G:detecção^n,EnemyUnit>> do seu exército."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1342@BUTTON_2"
msgstr "Detecte os movimentos subterrâneos do {EnemyUnit}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1342@BUTTON_3"
msgstr "Alimente o <<G:desejo de consumir^n,EnemyUnit>>:"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1342@BUTTON_4"
msgstr "Afaste-se do {EventStructure} infestado."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1342@TITLE"
msgstr "Madeira Infestada"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1343@BODY_FOOTER"
msgstr "O {EventStructure} colapsará em breve, permitindo a {EventHero.FirstName} apenas momentos para extrair um último segredo do Cabal da Conjuração."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1343@BODY_FOOTER@HERO_IS_PLAYELEA"
msgstr "O {EventStructure} colapsará em breve, permitindo a você apenas momentos para extrair um último segredo do Cabal da Conjuração."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1343@BODY_HEADER"
msgstr "Quando o último dos [hyperlink,GLOBAL.PROPERTIES.BATTLE_MAGE]Mago de Batalha[/hyperlink] cair sob seu exército, todos se levantam novamente, mas não atacam."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1343@BODY_LORE"
msgstr "\"Somos Guardiões\", declaram as almas da Cabala da Conjuração. \"Aguardando conceder nosso conhecimento secreto ao que foi profetizado como merecedor. Você!\" Nesse instante, abundantes revelações e saberes inundam {EventHero.FirstName}. A Cabala da Conjuração, sua profecia finalmente cumprida, desvanece. O {EventStructure} começa a tremer, enquanto seu teto ameaça desabar!"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1343@BODY_LORE@HERO_IS_PLAYELEA"
msgstr "\"Somos Guardiões\", declaram as almas da Cabala da Conjuração. \"Aguardando conceder nosso conhecimento secreto ao que foi profetizado como merecedor. Você!\" Nesse instante, abundantes revelações e saberes inundam você. A Cabala da Conjuração, sua profecia finalmente cumprida, desvanece. O {EventStructure} começa a tremer, enquanto seu teto ameaça desabar!"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1343@BUTTON_0"
msgstr "Pegue um estoque de Fragmentos de Vinculação. [bindingfragments/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1343@BUTTON_1"
msgstr "Aprenda [knowledge/] os segredos proibidos [evilact/] da Cabala."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1343@BUTTON_2"
msgstr "Não deixe os Magos de Batalha descansarem. Reivindique suas almas. [souls/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1343@BUTTON_3"
msgstr "Drene as energias mágicas [mana/] dos Magos de Batalha desvanecidos."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1343@TITLE"
msgstr "Cabala da Conjuração: Consequência"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1344@BODY_FOOTER"
msgstr "Suas tropas recolhem as armaduras e armas descartadas. O que mais podem reivindicar do {EventStructure} antes que o <<m:EnemyUnit>> retorne?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1344@BODY_HEADER"
msgstr "A maioria dos vermes que se infiltraram no {EventStructure} foi exterminada. A Árvore Murcha pode ser explorada."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1344@BODY_LORE"
msgstr "Armaduras e armas estão semi-enterradas na terra. Este {EventStructure} era uma armadilha mortal: o próprio território de caça de colossais <<m:EnemyUnit>>. Essas armas descartadas atraíam presas desavisadas, que saqueavam tesouros antes de serem devoradas pelos <<m:EnemyUnit>>. Já o chão treme novamente enquanto o maior {EnemyUnit} escava o solo, prestes a ressurgir e devorar mais presas."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1344@BUTTON_0"
msgstr "Envie a madeira [structureprod/] que caiu do tronco morto para {EventCity}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1344@BUTTON_1"
msgstr "Capture e domestique [unit/] um dos <<m:EnemyUnit>>."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1344@BUTTON_2"
msgstr "Forje um {EventItem} [item/] a partir da <<G:chitin^n,EnemyUnit>> morta."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1344@BUTTON_3"
msgstr "Garanta as melhores armas para sua tropa melhorar [xp/] seu equipamento."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1344@TITLE"
msgstr "Madeira Infestada: Consequência"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1350@BODY_FOOTER"
msgstr "Como você entreterá esses convidados enviados por {EventHouseLord.FirstName}?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1350@BODY_HEADER"
msgstr "Uma barca terrestre de {EventHouse} navega pelo <<m:EventGeo>> em direção a {EventCity}. Ela transporta um grupo de jovens guerreiros da {EventRace}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1350@BODY_LORE"
msgstr "Como rito de passagem, adolescentes Nômades são enviados ao mundo para aprender sobre outras Culturas. Como um dos <<G:aliados^p,EventHouse>>, {EventHouseLord} apresenta <<o:EventHouseLord>> candidatos a você. Vários <<m:EventUnit>> embarcam na barca, impressionados com sua grande Cidade."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1350@BUTTON_0"
msgstr "Peça que dois <<m:EventUnitB>> [unit/] fiquem com você."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1350@BUTTON_1"
msgstr "Acolha um {EventUnit} [unit/] como seu protegido."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1350@BUTTON_2"
msgstr "Solicite que o <<m:EventUnit>> compartilhe parte de seu treinamento de combate. [unitprod/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1350@BUTTON_3"
msgstr "Troque saberes [knowledge/] com os visitantes de {EventHouse}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1350@BUTTON_4"
msgstr "Encomende [gold/] um banquete [happiness/] em honra dos seus convidados."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1350@BUTTON_5"
msgstr "Mate os visitantes. [souls/] Ninguém jamais saberá. [evilact/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1350@BUTTON_8"
msgstr "Seja um anfitrião generoso, sem esperar nada em troca. [relationLvl3/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1350@TITLE"
msgstr "<<m:EventUnit>> De Longe <<Cm:EventGeo>>"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1351@BODY_FOOTER"
msgstr "{EventHouse} deseja presentear você com alguns dos recursos mais pesados que colheu ao longo do tempo. Qual você aceitará?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1351@BODY_HEADER"
msgstr "Os {EventHouseRace} de {EventHouse} são um povo nômade e devem estar sempre prontos para migrar. {EventHouseLord} entra em contato com você com uma oferta generosa."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1351@BODY_LORE"
msgstr "Eles possuem alguns recursos que não desejam levar na próxima jornada. \"Pedras e ferramentas que sobrecarregariam nossos navios. Armas demais para nossos soldados manejarem. Livros e pergaminhos que agora foram memorizados por nossos <<m:EventUnit>>. Queremos descarregar esses recursos para alguém em quem confiamos.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1351@BUTTON_0"
msgstr "Pegue as pedras e ferramentas. [structureprod/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1351@BUTTON_1"
msgstr "Reivindique as armas e bigornas. [unitprod/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1351@BUTTON_2"
msgstr "Solicite os livros e pergaminhos. [knowledge/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1351@BUTTON_3"
msgstr "Exija [evilact/] que você tome as armas [unitprod/] e ferramentas. [structureprod/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1351@BUTTON_4"
msgstr "Doe [allegiance/] os recursos para {EventHouseB}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1351@BUTTON_5"
msgstr "Encante [mana/] o peso dos recursos para que {EventHouse} possa levar tudo. [goodact/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1351@TITLE"
msgstr "Riscos de Sobrecarga"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1357@BODY_FOOTER"
msgstr "Você esperará até que o <<m:EventStackLeader>> termine sua pesquisa, ou tentará acelerar o processo?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1357@BODY_HEADER"
msgstr "Um {EventStackLeader} e <<o:EventStackLeader>> companheiros de {EventHouse} estão avaliando o {EventStructure} para ver se devem extrair seus recursos."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1357@BODY_LORE"
msgstr "Caso o {EventStackLeader} considere o {EventStructure} adequado para extração, {EventHouse} pode decidir reivindicá‑lo para si. Como o {EventHouseRace} costuma fazer, eles então eventualmente extrairão todo o {EventResource} dele até que se esgote completamente. Mas, dado <<G:furrowed brow^n,EventStackLeader>> e a frequência dos <<o:EventStackLeader>> suspiros, qualquer interesse real neste {EventStructure} parece improvável."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1357@BUTTON_0"
msgstr "Compartilhe seus insights [knowledge/] da {EventStructure} para acelerar a pesquisa."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1357@BUTTON_2"
msgstr "Pague {EventResource} a {EventHouse} para obter acesso à {EventStructure}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1357@BUTTON_3"
msgstr "Faça com que o {EventStructure} ceda alguns de seus recursos voluntariamente."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1357@BUTTON_4"
msgstr "Lance uma ilusão sobre o {EventStructure} para fazê-lo parecer esgotado."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1357@BUTTON_5"
msgstr "Reivindique esta terra. Afaste {EventHouse}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1357@BUTTON_6"
msgstr "Permita que o {EventHouseRace} de {EventHouse} retome sua avaliação."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1357@TITLE"
msgstr "Apto para Extração"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1358@BODY_FOOTER"
msgstr "O {EventStackLeader} sorri: \"Você conhece. Os caminhos antigos.\" Como você lidará com o Mercador e os guardas de <<o:EventStackLeader>>?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1358@BODY_FOOTER@PLAYER_==_YAKA"
msgstr "O {EventStackLeader} então percebe com quem <<p:EventStackLeader>> está lidando e se ajoelha: \"Meu Senhor Yaka! Sou apenas um servo humilde!\" Como você lidará com o Mercador e os guardas de <<o:EventStackLeader>>?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1358@BODY_HEADER"
msgstr "Um {EventStackLeader} de {EventHouse}, guardado por outros guerreiros, estabeleceu um posto comercial em um {EventStructure}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1358@BODY_LORE"
msgstr "O {EventStackLeader} observa {SourceStackLeader} atentamente. \"Somos todos Nômades agora,\" <<p:EventStackLeader>> proclama antes de se inclinar e sussurrar: \"Mas alguns de nós ainda seguem os caminhos antigos.\" Um amuleto cai das vestes do {EventStackLeader}, que <<p:EventStackLeader>> rapidamente guarda novamente. O amuleto se assemelha a um antigo ídolo de {GLOBAL.YakaLoreConcept.Hyperlink}. Em uma das <<G:tendas^p,EventStackLeader>>, vários <<m:EventUnit>> estão acorrentados a postes."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1358@BODY_LORE@PLAYER_==_YAKA"
msgstr "O {EventStackLeader} observa {SourceStackLeader} atentamente. \"Somos todos Nômades agora,\" <<p:EventStackLeader>> proclama antes de se inclinar e sussurrar: \"Mas alguns de nós ainda seguem os caminhos antigos.\" Um amuleto cai das vestes do {EventStackLeader}, que <<p:EventStackLeader>> rapidamente guarda novamente. O amuleto se assemelha a um antigo ídolo de {GLOBAL.YakaLoreConcept.Hyperlink}. De você. Em uma das <<G:tendas^p,EventStackLeader>>, vários <<m:EventUnit>> estão acorrentados a postes."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1358@BUTTON_0"
msgstr "Troque alimentos [food/] com o {EventStackLeader} [gold/] para fazer <<P:EventStackLeader>> partir."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1358@BUTTON_2"
msgstr "Compre [gold/] o <<m:EventUnit>> [unit/] do {EventStackLeader} para servir [evilact/] a você."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1358@BUTTON_3"
msgstr "\"Você está violando as leis de {EventHouse}. Reportarei você imediatamente.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1358@BUTTON_4"
msgstr "Nenhuma criatura viva deve ser acorrentada por outra."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1358@BUTTON_5"
msgstr "Ataque o {EventStackLeader} para libertar os escravos. [goodact/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1358@BUTTON_6"
msgstr "Feche os olhos para as <<G:atividades mercantis^p,{EventStackLeader} >>"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1358@BUTTON_7"
msgstr "\"Servos leais como você [unit/] devem lutar por mim.\" [evilact/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1358@TITLE"
msgstr "Seguidores dos Caminhos Antigos"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1359@BODY_FOOTER"
msgstr "A menos que alguém intervenha, esta batalha pode não ter fim. {EventHero} assumirá e harmonizará os elementos do {EventStructure}?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1359@BODY_FOOTER@HERO_IS_PLAYELEA"
msgstr "Você assumirá e harmonizará os elementos do {EventStructure}?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1359@BODY_HEADER"
msgstr "{EventHero} chega a um {EventStructure}, esperando saciar a sede de <<o:EventHero>>. Em vez disso, <<p:EventHero>> encontra <<m:EnemyUnit>> hostis que vagueiam furiosos."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1359@BODY_HEADER@HERO_IS_PLAYELEA"
msgstr "Você chega a um {EventStructure}, esperando saciar sua sede. Em vez disso, você é encontrado por <<m:EnemyUnit>> hostis que vagueiam furiosos."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1359@BODY_LORE"
msgstr "Um desequilíbrio elemental secou o {GLOBAL.STRUCTURES.HIDDEN_WELLSPRING.Hyperlink} que normalmente é exuberante. No leito seco do lago, vários <<m:{GLOBAL.PROPERTIES.ELEMENTAL.Hyperlink}>> atacam qualquer intruso. É uma batalha primordial para decidir qual elemento prevalecerá e dominará o {EventStructure}. {EventHero} testemunha como um {EventUnit} é incinerado por um {EventUnitA}, mas então se transforma em um {EventUnitB} para retomar a luta."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1359@BODY_LORE@HERO_IS_PLAYELEA"
msgstr "Um desequilíbrio elemental secou o {GLOBAL.STRUCTURES.HIDDEN_WELLSPRING.Hyperlink} que normalmente é exuberante. No leito seco do lago, vários <<m:{GLOBAL.PROPERTIES.ELEMENTAL.Hyperlink}>> atacam qualquer intruso. É uma batalha primordial para decidir qual elemento prevalecerá e dominará o {EventStructure}. Você testemunha como um {EventUnit} é incinerado por um {EventUnitA}, mas então se transforma em um {EventUnitB} para retomar a luta."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1359@BUTTON_0"
msgstr "Ataque os Elementais para restaurar o equilíbrio do {EventStructure}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1359@BUTTON_1"
msgstr "Desharmonize [mana/] a natureza tumultuada dos Elementais atacantes."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1359@BUTTON_2"
msgstr "Replante o {EventStructure}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1359@BUTTON_3"
msgstr "Desfaça o {EventGeo} revelado pelo {EventStructure} drenado."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1359@BUTTON_4"
msgstr "Escape da fúria dos Elementos instáveis."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1359@TITLE"
msgstr "Desordem Secada"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1360@BODY_FOOTER"
msgstr "Ao restaurar o equilíbrio do {EventStructure}, ele agora tem chance de se curar. Restos de alguns Elementais podem ser reaproveitados para benções."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1360@BODY_HEADER"
msgstr "{EventHero} superou o desequilíbrio elemental causado pela <<G:seca^n,EventStructure>>."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1360@BODY_HEADER@HERO_IS_PLAYELEA"
msgstr "Você superou o desequilíbrio elemental causado pela <<G:seca^n,EventStructure>>."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1360@BODY_LORE"
msgstr "Os hostis <<m:{GLOBAL.PROPERTIES.ELEMENTAL.Hyperlink}>> foram deformados, torcidos e enlouquecidos pela perturbação mágica provocada pelo Poço Seco. Agora, com suas manifestações físicas despedaçadas, o leito seco está coberto de cristais de mana, que {EventHero} coleta agradecidamente."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1360@BODY_LORE@HERO_IS_PLAYELEA"
msgstr "Os hostis <<m:{GLOBAL.PROPERTIES.ELEMENTAL.Hyperlink}>> foram deformados, torcidos e enlouquecidos pela perturbação mágica provocada pelo Poço Seco. Agora, com suas manifestações físicas despedaçadas, o leito seco está coberto de cristais de mana, que seus guerreiros coletam diligentemente."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1360@BUTTON_0"
msgstr "Restaure um {RandomElemental} [unit/] despedaçado para lutar por você."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1360@BUTTON_1"
msgstr "Reúna os <<G:restos^p,EventUnit>> para abastecer as <<G:forjas^p,EventCity>>. [unitprod/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1360@BUTTON_2"
msgstr "Colete os <<G:restos^p,EventUnitA>> para fertilizar os <<G:campos^p,EventCity>>. [food/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1360@BUTTON_3"
msgstr "Pegue os <<G:restos^p,EventUnitB>> para construir <<G:estruturas^p,EventCity>>. [structureprod/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1360@BUTTON_4"
msgstr "Drene os <<G:restos^p,EventUnitC>> para aumentar sua majestade. [influence/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1360@TITLE"
msgstr "Desordem Secada: Consequência"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1361@BODY_FOOTER"
msgstr "No Templo de {EventGod}, o(a) <<EventGod{God/Goddess}>>, nada realmente morre. Não para sempre. Como {EventHero} pode defender <<r:EventHero>> contra <<G:sacerdotes^p,{<<EventGod{God/Goddess}>>}>>?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1361@BODY_FOOTER@HERO_IS_PLAYELEA"
msgstr "No Templo de {EventGod}, o(a) <<EventGod{God/Goddess}>>, nada realmente morre. Não para sempre. Como você pode defender-se contra <<G:sacerdotes^p,EventGod>>?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1361@BODY_HEADER"
msgstr "{EventHero} descobre um {EventStructure} onde um(a) <<EventGod{God/Goddess}>> de {EventAttribute} foi adorado(a) uma vez. O esquecimento atemporal matou efetivamente o(a) <<EventGod{God/Goddess}>>."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1361@BODY_HEADER@HERO_IS_PLAYELEA"
msgstr "Você descobre um {EventStructure} onde um(a) <<EventGod{God/Goddess}>> de {EventAttribute} foi adorado(a) uma vez. O esquecimento atemporal matou efetivamente o(a) <<EventGod{God/Goddess}>>."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1361@BODY_LORE"
msgstr "Um santuário é construído dentro do {EventStructure}. {EventHero} limpa a poeira e as teias do santuário para descobrir que este Templo pertencia ao deus {EventGod} há muito tempo. Ainda assim, <<G:presença^n,{EventHero.FirstName}>> alimenta involuntariamente a chama eterna adormecida de {EventGod}, que por sua vez anima <<EventGod{his/her}>> seguidores decadentes. Eles se levantam dos mortos para adorar sua divindade e proteger o santuário de <<o:EventGod>> mais uma vez."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1361@BODY_LORE@HERO_IS_PLAYELEA"
msgstr "Um santuário é construído dentro do {EventStructure}. Você limpa a poeira e as teias do santuário para descobrir que este Templo pertencia ao deus {EventGod} há muito tempo. Ainda assim, sua presença alimenta involuntariamente a chama eterna adormecida de {EventGod}, que por sua vez anima <<EventGod{his/her}>> seguidores decadentes. Eles se levantam dos mortos para adorar sua divindade e proteger o santuário de <<o:EventGod>> mais uma vez."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1361@BUTTON_0"
msgstr "Ataque os sacerdotes do(a) <<EventGod{God/Goddess}>>."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1361@BUTTON_1"
msgstr "Faça uma oferenda [gold/] ao <<G:santuário^n,EventGod>> para receber <<o:EventGod>> favor em combate."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1361@BUTTON_2"
msgstr "Extraia poder da ressurreição dos mortos."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1361@BUTTON_3"
msgstr "Santifique o {EventStructure}, colocando quaisquer espíritos revividos em repouso."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1361@BUTTON_4"
msgstr "Saia do {EventStructure}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1361@TITLE"
msgstr "O(a) Abandonado(a) <<EventGod{God/Goddess}>>"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1362@BODY_FOOTER"
msgstr "<<G:batalha^n,{EventHero.FirstName}>> reacendeu parte do <<G:poder divino^n,EventGod>>. <<Cp:EventHero>> pode reivindicar o {EventItem} como <<o:EventHero>> prêmio. E talvez até levar mais."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1362@BODY_FOOTER@HERO_IS_PLAYELEA"
msgstr "Sua batalha reacendeu parte do <<G:poder divino^n,EventGod>>. Você pode reivindicar o {EventItem} como seu prêmio. E talvez até levar mais."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1362@BODY_HEADER"
msgstr "Enquanto os sacerdotes ressuscitados de {EventGod} retomaram seu sono da morte — por enquanto — {EventHero} inspeciona o {EventStructure} mais de perto."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1362@BODY_HEADER@HERO_IS_PLAYELEA"
msgstr "Enquanto os sacerdotes ressuscitados de {EventGod} retomaram seu sono da morte — por enquanto — você pode inspecionar o {EventStructure} mais de perto."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1362@BODY_LORE"
msgstr "O Templo de {EventGod} contém muitas relíquias e riquezas ancestrais. Este <<EventGod{God/Goddess}>> de {EventAttribute} deve ter sido uma divindade importante para qualquer cultura deste reino que adorava <<P:EventGod>> há tantos anos. Sua história é contada nas gravuras em pedra que cobrem as paredes. Uma luz sagrada então ilumina o santuário dourado, e um {EventItem} aparece."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1362@BUTTON_0"
msgstr "Deixe o {EventStructure} intocado [influence/] e faça uma oração a {EventGod}. [goodact/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1362@BUTTON_1"
msgstr "Esgote o que resta do {EventReward} no {EventStructure}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1362@BUTTON_2"
msgstr "Estude as gravações [knowledge/] rabiscadas nas paredes do Templo."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1362@BUTTON_3"
msgstr "Convide as almas [souls/] que permanecem eternamente no Templo Abandonado."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1362@BUTTON_4"
msgstr "Derreta [evilact/] o santuário e os artefatos dourados. [gold/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1362@TITLE"
msgstr "O(a) Abandonado(a) <<EventGod{God/Goddess}>>: Consequência"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1363@BODY_FOOTER"
msgstr "Um {EnemyUnit} sente a aura mágica de {EventHero.FirstName} e se volta para <<P:EventHero>> com um rugido. <<p:EventHero>> arriscará um ataque?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1363@BODY_FOOTER@HERO_IS_PLAYELEA"
msgstr "Um {EnemyUnit} sente sua aura mágica e se volta para você com um rugido. Você arriscará um ataque?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1363@BODY_HEADER"
msgstr "{EventHero} está na longa sombra de um(a) {EventStructure}. Entidades se alimentam do que resta de suas energias mágicas."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1363@BODY_HEADER@HERO_IS_PLAYELEA"
msgstr "Você está na longa sombra de um(a) {EventStructure}. Entidades se alimentam do que resta de suas energias mágicas."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1363@BODY_LORE"
msgstr "Onde antes florescia um {GLOBAL.STRUCTURES.WORLD_TREE.Hyperlink}, agora há um casulo, drenado de sua magia. As criaturas que se alimentam dele são conhecidas como {GLOBAL.PROPERTIES.MANA_STARVED.Hyperlink}: profundamente privadas de encantamentos e mana, assombradas por uma fome ilimitada de consumir magia. Elas drenaram toda a vida e energia do {EventStructure}, mas ainda continuam a sugar os últimos vestígios de poder de suas raízes secas e mortas."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1363@BODY_LORE@HERO_IS_PLAYELEA"
msgstr "Onde antes florescia um {GLOBAL.STRUCTURES.WORLD_TREE.Hyperlink}, agora há um casulo, drenado de sua magia. Você reconhece que as criaturas são {GLOBAL.PROPERTIES.MANA_STARVED.Hyperlink}: totalmente privadas de magia e mana, movidas por uma fome ilimitada de consumir tudo que é mágico. Elas drenaram toda a vida e energia do {EventStructure}, mas ainda continuam a drenar as raízes secas e mortas."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1363@BUTTON_0"
msgstr "Ataque o {EnemyUnit} e o <<o:EnemyUnit>> {GLOBAL.PROPERTIES.MANA_STARVED.Name} hospedeiro."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1363@BUTTON_1"
msgstr "Cubra {EventHero} com cristais de mana [mana/] para provocar o {EnemyUnit}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1363@BUTTON_1@HERO_IS_PLAYELEA"
msgstr "Cubra-se com cristais de mana [mana/] para provocar o {EnemyUnit}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1363@BUTTON_2"
msgstr "Deixe seu poder sagrado aumentar a força de seus guerreiros."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1363@BUTTON_3"
msgstr "Alimente as criaturas {GLOBAL.PROPERTIES.MANA_STARVED.Name} com magia corrompida."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1363@BUTTON_4"
msgstr "Fuja do {EventStructure}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1363@TITLE"
msgstr "Esgotado e Fraturado"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1364@BODY_FOOTER"
msgstr "Mesmo sem seus escavadores, o {EventStructure} é um lugar perigoso demais para permanecer. O que {EventHero} deve salvar antes de partir?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1364@BODY_FOOTER@HERO_IS_PLAYELEA"
msgstr "Mesmo sem seus sapadores, o {EventStructure} é um lugar perigoso demais para permanecer. O que você deve salvar antes de partir?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1364@BODY_HEADER"
msgstr "Seu exército finalmente derrotou o {EnemyUnit} e as outras criaturas {GLOBAL.PROPERTIES.MANA_STARVED.Hyperlink}, enlouquecidas pela sede de magia."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1364@BODY_LORE"
msgstr "<<G:tropas^p,EventHero>> empacotam a <<G:cabeça^n,EnemyUnit>> para ser montada acima do seu assento em {EventCity}. Enquanto isso, {EventHero.FirstName} observa o {EventStructure} para contemplar a devastação total, avistando um {EventItem} cravado na madeira drenada. A loucura é tudo o que resta aqui. E ainda... testemunhar a ferocidade e a força do {GLOBAL.PROPERTIES.MANA_STARVED.Hyperlink} faz você se perguntar se isso pode levar seu {EventRace} à grandeza."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1364@BODY_LORE@HERO_IS_PLAYELEA"
msgstr "Suas tropas empacotam a <<G:cabeça^n,EnemyUnit>> para ser montada acima do seu assento em {EventCity}. Enquanto isso, você observa o {EventStructure} para contemplar a devastação total, avistando um {EventItem} cravado na madeira drenada. A loucura é tudo o que resta aqui. E ainda... testemunhar a ferocidade e a força do {GLOBAL.PROPERTIES.MANA_STARVED.Hyperlink} faz você se perguntar se isso pode levar seu {EventRace} à grandeza."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1364@BUTTON_0"
msgstr "Desprenda o {EventItem} [item/] do tronco do {EventStructure}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1364@BUTTON_1"
msgstr "Fortaleça a determinação do seu exército contra o {GLOBAL.PROPERTIES.MANA_STARVED.Name}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1364@BUTTON_2"
msgstr "Elogie [xp/] <<G:tenacidade^n,EventHero>> em batalha."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1364@BUTTON_2@HERO_IS_PLAYELEA"
msgstr "Celebre [xp/] sua destreza em batalha."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1364@BUTTON_3"
msgstr "Sacrifique sua magia para transformar seu {EventRace} {GLOBAL.PROPERTIES.MANA_STARVED.Name}. [knowledge/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1364@BUTTON_4"
msgstr "Estude a magia aberrante [knowledge/] das entidades {GLOBAL.PROPERTIES.MANA_STARVED.Hyperlink}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1167_1364@TITLE"
msgstr "Esgotado e Fraturado: Consequência"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1171_4500@BODY_FOOTER"
msgstr "Conjurar <<m:{GLOBAL.WorldMapSpellConcept.Hyperlink}>> acumulará até um {GLOBAL.CataclysmConcept.Hyperlink}. Mas talvez existam maneiras de mitigar esta crise."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1171_4500@BODY_HEADER"
msgstr "Os ventos rugem famintos. Este reino está sendo afetado pelo {GLOBAL.FracturingWindsConcept.Hyperlink}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1171_4500@BODY_LORE"
msgstr "A brisa suga e redireciona a magia de tudo o que atravessa. Se um grande surto de magia a inundar, os ventos causarão devastação, trazendo graves consequências para os conjuradores e para a paisagem do reino."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1171_4500@TITLE"
msgstr "Os Ventos Devoradores"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1171_4501@BUTTON_0"
msgstr "Investigue este fenômeno."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1197@BODY_FOOTER"
msgstr "A voz dos ventos o incita a se aproximar do <<m:{GLOBAL.FractureLoreConcept.Hyperlink}>>. Como você se preparará?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1197@BODY_HEADER"
msgstr "Suas tropas chegam ao planalto árido enquanto os ventos devoradores sopram com grande força. Eles soam estranhos aqui, como uma voz sussurrante que fala para dentro."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1197@BODY_LORE"
msgstr "A região está infestada de Fraturas, fragmentos flutuantes de ruínas orbitando ao seu redor. De repente, os ventos começam a sussurrar: \"Venha até nós. Aproxe-se das [hyperlink,GLOBAL.FractureLoreConcept]Fraturas[/hyperlink] e você obterá conhecimento e poder além da sua imaginação. Tolos temem o que não compreendem; os sábios buscam entendê‑lo.\" À medida que a rajada varre, o ar crepita com faíscas de energia refratária. A magia é extremamente volátil aqui."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1197@BUTTON_0"
msgstr "Deixe os ventos puxarem [hp/] suas tropas em direção [movementgeneral/] às Fraturas."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1197@BUTTON_3"
msgstr "Os ventos não são confiáveis, proteja [mana/] suas tropas [resistance/] deles."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1197@BUTTON_4"
msgstr "Continue ao seu próprio ritmo."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1197@TITLE"
msgstr "Ascendendo à Mesa Crepitante"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1198@BODY_FOOTER"
msgstr "\"Ative os sigilos para recompor o complexo. Proteja‑o, e revelarei mais segredos [hyperlink,GLOBAL.UnmakersLoreConcept]destes magos[/hyperlink]. Cuidado, pois a onda de energia atrairá bestas fraturadas.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1198@BODY_HEADER"
msgstr "Um antigo complexo mágico existe apenas como fragmentos à deriva fora de alcance, presos em órbita ao redor de um {GLOBAL.FractureLoreConcept.Hyperlink}. A voz nascida do vento soa mais alta aqui:"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1198@BODY_LORE"
msgstr "\"As grandes mentes que ergueram este local conseguiram criar um eco quase perfeito do [hyperlink,GLOBAL.TheWellLoreConcept]Poço da Criação[/hyperlink]. Os poderes e o conhecimento do {GLOBAL.AllfatherLoreConcept.Hyperlink} estavam ao seu alcance. Assim, abriram essa essência mágica que continha os segredos da criação e... Era o vazio. Tão vazio que engoliu a todos nós e drenou o mundo de sua própria existência, desencadeando [hyperlink,GLOBAL.TheFracturingLoreConcept]o cataclismo[/hyperlink].\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1198@BUTTON_1"
msgstr "Ative os sigilos, proteja o local. [knowledge/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1198@BUTTON_2"
msgstr "Ative os sigilos e saqueie [unitprod/] a área [item/] antes que as bestas cheguem."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1198@BUTTON_4"
msgstr "Abandone as ruínas."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1198@TITLE"
msgstr "Mesa Crepitante: Divisão da Essência"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1200@BODY_FOOTER"
msgstr "A voz dos ventos reverbera em fúria: \"Saqueadores, vermes tolos. Mate‑os, e eu revelarei onde os segredos deste lugar estão ocultos.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1200@BODY_HEADER"
msgstr "Ao redor do ominoso {GLOBAL.FractureLoreConcept.Hyperlink}, pedaços inacessíveis de um edifício despedaçado flutuam à deriva. A voz carregada pelos ventos ruge: \"Ative os sigilos para recompor isso.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1200@BODY_LORE"
msgstr "Enquanto suas tropas se preparam para seguir sua ordem, um grupo de Nômades surge. Seu líder adota uma postura hostil e grita: \"Viajante, você não compreende as forças com as quais está mexendo. Não escute as vozes dos demônios do vento. Deixe este lugar antes que seja tarde demais para todos nós — este é o seu único aviso.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1200@BUTTON_1"
msgstr "Ative os sigilos e enfrente os nômades. [knowledge/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1200@BUTTON_2"
msgstr "Desperte os sigilos e convença [gold/] os nômades a ficar ao seu lado [unit/]."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1200@BUTTON_4"
msgstr "Deixe o local por enquanto."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1200@TITLE"
msgstr "Mesa Crepitante: Conflito de Vozes"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1202@BODY_FOOTER"
msgstr "\"Ative os sigilos para recompor a biblioteca e erradicar os arquivistas fraturados, pois eles acabarão despertando em loucura e destruirão tudo aqui.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1202@BODY_HEADER"
msgstr "Uma biblioteca arruinada flutua ao redor do {GLOBAL.FractureLoreConcept.Hyperlink}, cheia de sigilos, livros escritos em códice e <<m:{EventUnit}>> adormecidos. A voz dos ventos ressoa alto:"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1202@BODY_LORE"
msgstr "\"Grande é a tragédia do conhecimento perdido no [hyperlink,GLOBAL.TheFracturingLoreConcept]grande cataclismo[/hyperlink]. Séculos se passaram, e ainda ninguém descobriu que os {GLOBAL.AstralFlowsLoreConcept.Hyperlink} estão invertidos perto das fraturas. E que, como qualquer corrente, podem ser navegados e desviados. Ninguém ousou olhar novamente para o vazio da criação. Mas aqueles que tentaram... Documentaram tudo. Obedeça-me, e eu lhe ensinarei a decifrar seu código.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1202@BUTTON_1"
msgstr "Ative os sigilos e elimine os arquivistas. [knowledge/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1202@BUTTON_2"
msgstr "Saia da biblioteca por enquanto."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1202@BUTTON_5"
msgstr "Ative os sigilos, avalie [knowledge/] os livros para vendê-los por [gold/], e saia."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1202@TITLE"
msgstr "Mesa Crepitante: Fluxos Invertidos"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1204@BODY_FOOTER"
msgstr "Uma Fratura colossal manifestou‑se no coração da Mesa Crepitante. E dela surge uma figura... A figura de um [hyperlink,GLOBAL.UnmakersLoreConcept]Unmaker[/hyperlink]."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1204@BODY_HEADER"
msgstr "Ao ativar o terceiro sigilo, o próprio ar começa a tremer. As três [hyperlink,GLOBAL.FractureLoreConcept]Fraturas[/hyperlink] crepitam com energia, atraindo ventos devoradores poderosos."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1204@BODY_LORE"
msgstr "Essas correntes avançam em direção às fissuras, sugando a energia de tudo que encontram. As Fraturas incham ao se alimentarem desse poder — e então, subitamente, implodem, liberando os ventos devoradores que são puxados para o centro da região. Quando as rajadas convergem, uma Fratura maciça reaparece, restaurando um fragmento da planície que antes consumiu."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1204@BUTTON_0"
msgstr "Aproxime‑se do Unmaker."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1204@TITLE"
msgstr "Mesa Crepitante: Ecos da Fratura"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1206@BODY_FOOTER"
msgstr "A Grande Fratura permanece aberta. Com o {GLOBAL.ArtifactConcept.Hyperlink} dos Unmakers, você pode extrair algo do outro lado antes de selá‑la."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1206@BODY_FOOTER@UNMAKER_ALLY"
msgstr "Quando o Unmaker parte, a Grande Fratura permanece aberta. Com o {GLOBAL.ArtifactConcept.Hyperlink}, você pode extrair algo do outro lado antes de selá‑la."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1206@BODY_HEADER"
msgstr "{EventHero} jaz derrotado, finalmente. Mais uma vez, as habilidades de <<o:EventHero>> foram insuficientes diante da arrogância de <<o:EventHero>>. De sua mão escapa um objeto, o {EventRelic}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1206@BODY_HEADER@UNMAKER_ALLY"
msgstr "{EventHero} olha para você, como se finalmente o visse pela primeira vez. O Unmaker levanta um objeto em sua mão — o {EventRelic}. Sua voz ecoa:"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1206@BODY_LORE"
msgstr "A bússola intrincada irradia energia negativa. Os ventos devoradores atravessam o artefato antes de se precipitarem rumo à Grande Fratura, como se a redirecionassem. Parece que {EventHero} usou a energia e o alinhamento dos sigilos que você ativou para criar um próprio e retornar... do outro lado da fratura. Agora esse poder repousa em suas mãos."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1206@BODY_LORE@UNMAKER_ALLY"
msgstr "\"Um feito grandioso, de fato, discernir a voz do conhecimento entre os gritos dos ignorantes. Minha palavra me vincula, {PlayerLeader}. Eis sua recompensa.\" A bússola intrincada irradia energia negativa. Os ventos devoradores atravessam o artefato antes de se precipitarem rumo à Grande Fratura, como se a redirecionassem. Parece que {EventHero} usou a energia e o alinhamento dos sigilos que você ativou para criar um próprio e retornar... do outro lado da fratura."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1206@BUTTON_0"
msgstr "Sela a Fratura e redirecione o [mana/] ao seu império."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1206@BUTTON_3"
msgstr "Traga um batalhão de seres fraturados [unit/] sob seu comando."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1206@BUTTON_4"
msgstr "Recupere uma cidade inteira [citytier1/] dos Unmakers. (NÃO FUNCIONAL)"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1206@BUTTON_5"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1206@BUTTON_6"
msgstr "Erga uma Torre Fraturada [siteGold/] onde os Unmakers antes conduziam seus experimentos."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1206@TITLE"
msgstr "Mesa Crepitante: Consequência"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1233@BODY_FOOTER"
msgstr "Um dos Unmakers retornou através de uma Fratura e agora desafia todos que ousam se opor a <<P:EventHero>>."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1233@BODY_HEADER"
msgstr "A figura ao lado da grande Fratura se volta, o olhar vazio de <<o:{EventHero}>> atravessa você. A voz de <<Co:{EventHero}>> — que você já ouviu antes nos ventos — proclama:"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1233@BODY_LORE"
msgstr "\"Conhecimento é poder, viajante. Por isso fomos punidos, porque o poder até mesmo do {GLOBAL.AllfatherLoreConcept.Hyperlink} estava ao nosso alcance. Mas nem mesmo sua punição injusta pôde me deter. Aquele de quem os mitos falam retornou! Eu, {EventHero}, que encarei o vazio da criação, reivindico este reino e tudo que nele existe. Venha então — traga o seu pior!\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1233@BUTTON_0"
msgstr "Prepare‑se para enfrentar o Unmaker."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1233@BUTTON_1"
msgstr "Atendi a todas as suas exigências; não me oponho a você. [influence/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1233@TITLE"
msgstr "Mesa Crepitante: Arauto da Fratura"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1333@BODY_FOOTER"
msgstr "O que fará com todo esse poder? Abraçá‑lo‑á — ou libertar este reino de seu jugo?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1333@BODY_HEADER"
msgstr "Ao reivindicar o {LAST_ARTIFACT}, os demais artefatos começam a crepitar. Raios de energia negativa emanam deles, imbuindo‑o com seu poder."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1333@BODY_LORE"
msgstr "A energia percorre você da cabeça aos pés, seus olhos ardem como faróis de chama oca, e sente seu corpo absorvendo magia do próprio ar. Por um instante, você a sente — um poder tão vasto que poderia mudar o reino. Um poder que poderia desafiar a própria existência. Nesse momento, que parece durar para sempre, você deve fazer uma escolha."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1333@BUTTON_0"
msgstr "Liberte o poder das Fraturas como seu arauto."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1333@BUTTON_1"
msgstr "Redirecione a energia para curar as Fraturas do reino."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1333@BUTTON_2"
msgstr "Descarte a energia, liberando o [mana/]. Você protegerá o {GLOBAL.ArtifactConcept.Hyperlink} como guardião [influence/] [allegiance/]."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1333@TITLE"
msgstr "Ecos da Fratura: Arrogância dos Unmakers"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1383@BODY_FOOTER"
msgstr "Este mundo está perdido. {PlayerLeader} alcançou o {GLOBAL.CataclysmVictoryConcept.Hyperlink}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1383@BODY_FOOTER@PLAYER_IS_HERALD"
msgstr "Se você mantiver os três <<m:{GLOBAL.ArtifactConcept.Hyperlink}>>, alcançará a vitória em 5 turnos. Perderá os Artefatos se {PlayerLeader} for derrotado em combate."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1383@BODY_HEADER"
msgstr "Todo o reino treme. Você sente uma perturbação brutal ondular através do Mar Astral. {PlayerLeader} reuniu os artefatos dos Unmakers e abraçou seu poder."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1383@BODY_HEADER@PLAYER_IS_HERALD"
msgstr "Todo o reino treme. Você sente a perturbação brutal que desencadeou no Mar Astral. Você reuniu os artefatos dos Unmakers e abraçou seu poder."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1383@BODY_LORE"
msgstr "Os Ventos Devoradores rugem com fúria. Seu novo mestre os convoca, e eles atendem ao chamado. Tempestades de energia negativa começam a escurecer os céus. <<m:{GLOBAL.FractureLoreConcept.Hyperlink}>> irrompem por toda a terra. O equilíbrio mágico do reino foi quebrado, uma nova Fratura é iminente."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1383@BODY_LORE@PLAYER_IS_HERALD"
msgstr "Os Ventos Devoradores rugem com fúria. Seu novo mestre os convoca, e eles atendem ao seu chamado. Tempestades de energia negativa começam a escurecer os céus. <<m:{GLOBAL.FractureLoreConcept.Hyperlink}>> rasgam tudo ao redor. O equilíbrio mágico do reino foi quebrado, uma nova Fratura está prestes a acontecer. Outros tentarão impedi‑lo antes que consuma o reino."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1383@BUTTON_0"
msgstr "Saia do reino."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1383@BUTTON_0@PLAYER_IS_HERALD"
msgstr "O fim está próximo."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1383@BUTTON_1"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1383@BUTTON_2"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1383@TITLE"
msgstr "Ecos da Fratura: Reino Fraturado"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1384@BODY_FOOTER"
msgstr "Em breve não haverá cataclismo nem arrogância para atormentar este reino, e {PlayerLeader} será fortalecido pelas tribos. Isso serve aos seus interesses?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1384@BODY_FOOTER@PLAYER_IS_HERALD"
msgstr "Em breve não haverá cataclismo nem arrogância para atormentar este reino."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1384@BODY_HEADER"
msgstr "O vento cessa, e uma estranha calmaria se instala sobre o reino. {PlayerLeader} reuniu os artefatos dos Unmakers e está usando seu poder para curar o mundo."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1384@BODY_HEADER@PLAYER_IS_HERALD"
msgstr "O vento cessa, e uma estranha calmaria se instala sobre o reino. Você reuniu os artefatos dos Unmakers e está usando seu poder para curar o mundo."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1384@BODY_LORE"
msgstr "As <<m:{GLOBAL.FractureLoreConcept.Hyperlink}>> que marcam esta terra árida começam a diminuir, reduzindo-se tanto em número quanto em tamanho. As [hyperlink,GLOBAL.AstralFlowsLoreConcept]Correntes Astrais[/hyperlink] fluem novamente pelo mundo, preenchendo-o de vida. As tribos nômades percebem a mudança e se reúnem em grande número ao seu salvador. Sua profecia do Curador da Era Fraturada está se tornando realidade."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1384@BUTTON_0"
msgstr "Está em suas mãos apoiar a cura deste reino... ou sua destruição."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1384@BUTTON_0@PLAYER_IS_HERALD"
msgstr "A restauração está próxima."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1384@BUTTON_1"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1384@BUTTON_2"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1384@TITLE"
msgstr "Ecos da Fratura: Curador das Fraturas"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1385@BODY_FOOTER"
msgstr "Algo, nas profundezas do Mar Astral, chama por você... Com um simples gesto, você abre uma colossal Fratura para atravessá-lo."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1385@BODY_HEADER"
msgstr "Todo o reino treme. Você sente uma violenta perturbação ondular através do {GLOBAL.AstralSeaLoreConcept.Hyperlink}. Finalmente você reuniu os artefatos dos Unmakers e abraçou seu poder."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1385@BODY_LORE"
msgstr "Os Ventos Devoradores rugem com fúria. Seu novo mestre os convoca, e eles atendem ao seu chamado. Tempestades de energia negativa começam a escurecer os céus. <<m:{GLOBAL.FractureLoreConcept.Hyperlink}>> rasgam tudo ao redor. Diante de você, impérios se ajoelham entre os remanescentes de um mundo consumido por sua ambição. Toda a magia do reino agora corre em suas veias. Contudo, não é suficiente. Um poder ainda maior está ao seu alcance."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1385@BUTTON_0"
msgstr "Você é o Arauto da Fratura, nada e ninguém se oporá ao seu caminho."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1385@BUTTON_1"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1385@BUTTON_2"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1385@TITLE"
msgstr "Ecos da Fratura: Um Novo Arauto"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1386@BODY_FOOTER"
msgstr "Sua jornada aqui ainda não terminou; sua lenda ainda tem versos por escrever."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1386@BODY_HEADER"
msgstr "Você segurou os artefatos até que o {GLOBAL.CataclysmConcept.Hyperlink} fosse purificado. Você se tornou o supremo salvador deste reino."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1386@BODY_HEADER@PLAYER_IS_NOT_HE"
msgstr "{PlayerLeader} segurou os artefatos até que o {GLOBAL.CataclysmConcept.Hyperlink} fosse purificado. <<Cp:{PlayerLeader}>> se tornou o supremo salvador deste reino."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1386@BODY_LORE"
msgstr "Com o apoio dos nômades, você uniu as tribos errantes sob seu domínio. A vegetação florescerá novamente, os animais retornarão a estas terras. E, em um dia muito, muito distante, todo o sofrimento e destruição causados por {GLOBAL.TheFracturingLoreConcept.Hyperlink} não passarão de uma história. Uma que será contada por gerações, para lembrar que, há muito tempo, um grande {EventPlayerType} trouxe paz e vida de volta a este mundo."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1386@BODY_LORE@PLAYER_IS_NOT_HE"
msgstr "Vegetação florescerá novamente, animais retornarão a estas terras. E, em um dia muito, muito distante, todo o sofrimento e destruição causados por {GLOBAL.TheFracturingLoreConcept.Hyperlink} não passarão de uma história. Uma que será contada por gerações, para lembrar que, há muito tempo, um grande {EventPlayerType} trouxe paz e vida de volta a este mundo."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1386@BUTTON_0"
msgstr "Continue sua história."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1386@BUTTON_1"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1386@BUTTON_2"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1386@TITLE"
msgstr "Ecos da Fratura: Reino Curado"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1430@BODY_FOOTER"
msgstr "\"Sabemos como recompensar aqueles que nos ajudam, errantes. Você erguerá sua espada para purgar a maldição dos [hyperlink,GLOBAL.FractureLoreConcept]ventos ocos[/hyperlink]?\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1430@BODY_FOOTER@PLAYER_FRACTURED"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1430@BODY_HEADER"
msgstr "Suas tropas chegam às águas de um oásis subterrâneo. Suas margens estão cheias de Nômades, com aço em mãos."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1430@BODY_LORE"
msgstr "\"Parem, errantes!\" grita uma voz. Liderando um grupo de guerreiros, um orgulhoso chefe avança. \"Sou {EventHero} do {EventTribe}, e este é o último oásis do reino. Vocês não parecem saqueadores, talvez possamos ajudar uns aos outros. Aqueles horrores Desfeitos do outro lado do lago estão envenenando nossos animais, nossas escassas águas e nosso povo, condenando-os ao mesmo destino que sofrem.\" O rosto de <<Co:EventHero>> endurece em uma máscara de ódio enquanto <<p:EventHero>> acrescenta: \"Não permitirei que outro amigo morra.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1430@BODY_LORE@PLAYER_FRACTURED"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1430@BUTTON_0"
msgstr "\"Aponte-me aqueles cães raivosos.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1430@BUTTON_1"
msgstr "\"Encontrarei os amaldiçoados nos meus próprios termos.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1430@BUTTON_3"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1430@TITLE"
msgstr "Margens Amaldiçoadas do Lago do Grande Verme"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1431@BODY_FOOTER"
msgstr "O prisioneiro aguarda seu veredicto. O que fará com <<P:{EventUnit}>>?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1431@BODY_HEADER"
msgstr "Alguns Nômades jazem diante de você, enquanto outros fogem para se reagrupar. Suas tropas conseguiram capturar um {EventUnit}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1431@BODY_LORE"
msgstr "Não demora muito para o prisioneiro falar: \"O que teria feito, {PlayerLeader}? Se seus pastos, seu gado e seus parentes fossem envenenados pelos Desfeitos? O que teria feito se visse seus filhos morrerem de sede ou loucura? Talvez devêssemos ser julgados por nossas ações — mas você não é quem passa esse julgamento.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1431@BUTTON_0"
msgstr "Poupe a vida de <<o:{EventUnit}>> em troca de parte do saque de <<o:{EventUnit}>>. [gold/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1431@BUTTON_1"
msgstr "Execute <<P:{EventUnit}>> [evilact/] por todo o saque de <<o:{EventUnit}>>. [gold/] [item/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1431@BUTTON_2"
msgstr "\"Se são pastos verdes [food/] que procura, encontrará sob meu domínio.\" [unit/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1431@TITLE"
msgstr "Lago do Grande Verme: Juiz e Júri"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1432@BODY_FOOTER"
msgstr "Você salvará a vida deste {EventUnit} para que ele possa lutar contra você outro dia? Ou saqueará <<P:EventUnit>>?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1432@BODY_HEADER"
msgstr "Após o confronto, suas tropas encontram um diário de viagem em um {EventUnit} moribundo. A última anotação diz:"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1432@BODY_LORE"
msgstr "\"Após outro ciclo das estrelas, retornamos ao Lago do Grande Verme. Agora o último oásis. Lendas de nossa tribo falam deste lugar como um paraíso. Contam sobre um grande verme, mãe de todos os outros e protetor do deserto. Mas tudo o que os deuses amaldiçoados tocaram foi desfeito. Eles experimentaram com a Grande Mãe e sua prole, buscando respostas para perguntas que nunca deveriam ter sido feitas. A Grande Mãe agora jaz na água, sua progênie desaparecida.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1432@BUTTON_0"
msgstr "Cure as feridas de <<o:{EventUnit}>>. [goodact/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1432@BUTTON_1"
msgstr "Saquear <<P:{EventUnit}>>. [gold/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1432@TITLE"
msgstr "Lago do Grande Verme: Paraíso Perdido"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1436@BODY_FOOTER"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1436@BODY_HEADER"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1436@BODY_LORE"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1436@BUTTON_0"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1436@TITLE"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1437@BODY_FOOTER"
msgstr "\"Devemos destruí‑los, ou nada restará de nós. Minhas tropas ajudarão você, {PlayerLeader}. Preciso me preparar para derrubar aquela besta.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1437@BODY_HEADER"
msgstr "Os Desfeitos recuam—suas forças enfraquecidas não podem mais manter o território. Mas, de repente, um violento tremor abala o lago subterrâneo."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1437@BODY_HEADER@SIDED_WITH_UNDON"
msgstr "Os Nômades recuam—suas forças enfraquecidas não podem mais manter o território. Mas, de repente, um violento tremor abala o lago subterrâneo."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1437@BODY_LORE"
msgstr "Uma besta gargantuana ergue‑se no centro do oásis. Um Verme Fraturado, tão vasto quanto uma cidade, ruge faminto. E, com ela, sua prole irrompe da terra, devorando tudo em seu caminho. Nômades e Desfeitos são engolidos pelas bocas dos vermes. {EventHero} observa incrédulo. \"Não pode ser. O Grande Verme morreu, mas uma de suas filhas deformadas sobreviveu aos experimentos, e nunca deixou de crescer.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1437@BODY_LORE@SIDED_WITH_UNDON"
msgstr "Uma besta gargantuana ergue‑se no centro do oásis. Um Verme Fraturado, tão vasto quanto uma cidade, ruge faminto. E, com ela, sua prole irrompe da terra, devorando tudo em seu caminho. Nômades e Desfeitos são engolidos pelas bocas dos vermes. {EventHero} observa, abalado. \"Nem o Grande Verme nos mostra misericórdia... Às armas! A fome não tem lados. É época de reprodução—é eles ou nós!\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1437@BUTTON_0"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1437@BUTTON_1"
msgstr "Enfrente o Grande Verme."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1437@TITLE"
msgstr "Lago do Grande Verme: Despertar"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1440@BODY_FOOTER"
msgstr "\"Nossa besta domada estará à sua disposição. Mas o que mais podemos fazer para pagar essa dívida?\" pergunta o chefe dos Nômades."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1440@BODY_FOOTER@SIDED_WITH_UNDON"
msgstr "\"Nossa besta domada estará à sua disposição. Mas o que mais podemos fazer para pagar essa dívida?\" pergunta o chefe dos Desfeitos."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1440@BODY_HEADER"
msgstr "O último dos filhotes cai, e o Grande Verme ruge em dor e fúria. Arpoados pelos Nômades, a besta sangra profusamente."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1440@BODY_HEADER@SIDED_WITH_UNDON"
msgstr "O último dos filhotes cai, e o Grande Verme ruge em dor e fúria. Arpoados pelos Desfeitos, a besta sangra profusamente enquanto recua."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1440@BODY_LORE"
msgstr "Enquanto a besta recua, o sangue azul cai no oásis, formando poças borbulhantes. A forte chuva atinge {EventHero}, e a corrupção se instaura de imediato. O corpo de <<Co:EventHero>> muda rapidamente—transformando <<P:EventHero>> em um dos Desfeitos. O grito angustiado de <<Co:EventHero>> ecoa pelo lago: \"Não! O oásis foi purificado, e nunca mais o verei florescer.\" Ao ver sua tribo se reunir ao redor, <<p:EventHero>> acalma‑se, lembrando seu dever de <<o:EventHero>>. \"Devo partir em penitência eterna. Mas minha tribo lhe deve uma grande dívida, {PlayerLeader}.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1440@BODY_LORE@SIDED_WITH_UNDON"
msgstr "De suas feridas, correntes de sangue azul se espalham pelo oásis, formando vastas poças de líquido borbulhante. \"Não se aproximem delas!\" clama a voz de {EventHero}, chefe dos Desfeitos. \"O Grande Verme tem devorado mana por gerações, fortalecendo a maldição dos Unmakers. Seu sangue é tão poderoso que amaldiçoaria e transformaria qualquer um que o tocasse. Eu não permitiria que nosso salvador sofresse nosso destino.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1440@BUTTON_0"
msgstr "\"Minhas cidades precisam crescer, seu povo finalmente terá um lugar para chamar de lar.\" [population/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1440@BUTTON_0@SIDED_WITH_UNDON"
msgstr "\"Conte‑me o mito do Grande Verme e como ele surgiu.\" [knowledge/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1440@BUTTON_3"
msgstr "\"Ensine‑me a comungar com o poder do <<m:{EventUnit}>>.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1440@BUTTON_3@SIDED_WITH_UNDON"
msgstr "\"Ensine‑me a comungar com o poder do <<m:{EventUnit}>>.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1440@BUTTON_4"
msgstr "\"Que seu povo espalhe as histórias do {PlayerLeader.TitleName}.\" [influence/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1440@BUTTON_5"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1440@TITLE"
msgstr "Lago do Grande Verme: Consequência"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1470@BODY_FOOTER"
msgstr "\"Meu nome é {EventHero}, e em nome do meu povo, peço sua ajuda. Buscamos apenas viver o tempo que nos resta em paz.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1470@BODY_HEADER"
msgstr "Suas tropas chegam às águas de um oásis subterrâneo. Suas margens estão repletas de Nômades deformados, com aço em mãos."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1470@BODY_LORE"
msgstr "\"Quem são vocês, que caminham pela terra dos amaldiçoados?\" Uma figura de olhos vazios avança entre os enfermos. \"Vocês não carregam a marca dos Desfeitos, nem o ódio dos {EventTribe}. Podem atravessar este lugar sagrado, agora obscurecido pela guerra que assola suas águas e margens. Contudo, não podem permanecer, pois este local e nós mesmos carregamos uma praga que devora mente e alma. Se nos defenderem, porém, não hesitaremos em recompensá‑los generosamente, viajantes.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1470@BUTTON_0"
msgstr "\"Eu os libertarei daqueles que os perseguem.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1470@BUTTON_1"
msgstr "\"É cedo demais para escolher lados.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1470@BUTTON_3"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1470@TITLE"
msgstr "Margens Sagradas do Lago do Grande Verme"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1476@BODY_FOOTER"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1476@BODY_HEADER"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1476@BODY_LORE"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1476@BUTTON_0"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1476@BUTTON_1"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1476@BUTTON_3"
msgstr "A"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1498@BODY_FOOTER"
msgstr "O pedaço de papiro está se deteriorando rapidamente. Você vai recuperar o pergaminho ou perseguir os Desfeitos em fuga?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1498@BODY_HEADER"
msgstr "Após a batalha, suas tropas encurralam um dos Desfeitos junto ao lago. Com as mãos <<o:EventUnit>> erguidas, <<p:EventUnit>> começa a recuar lentamente, entoando uma ladainha:"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1498@BODY_LORE"
msgstr "\"Este lugar é sagrado. O Grande Verme nos trouxe aqui. Em suas águas nos banhamos em comunhão com ela. Ela nos protege de todo mal—protegerá‑nos dos intrusos.\" Com um movimento súbito, o Desfeito arremessa <<r:EventUnit>> no lago contaminado e começa a nadar para longe. Um pergaminho surge, aparentemente deixado cair da mão de <<o:EventUnit>>. Você consegue ver antigas gravuras de um grande verme retorcido."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1498@BUTTON_0"
msgstr "Salve o pergaminho. [knowledge/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1498@BUTTON_1"
msgstr "Pratique um pouco de tiro ao alvo. [evilact/] [xp/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1498@TITLE"
msgstr "Lago do Grande Verme: Paraíso Encontrado"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1499@BODY_FOOTER"
msgstr "\"Minha cabeça... Não... Preciso da minha bolsa... Mana... Por favor.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1499@BODY_HEADER"
msgstr "Os Desfeitos derrotados jazem diante de você. Suas tropas capturaram um deles, segurando uma pesada bolsa de mana."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1499@BODY_LORE"
msgstr "<<Co:EventUnit>> soluços ecoam enquanto <<p:EventUnit>> fala: \"Não já sofremos o bastante? Chamam‑nos Desfeitos, vazios, podres. Caçam‑nos, pelo único crime de querer continuar vivos. Retiramo‑nos para o oásis para contê‑lo, mas ainda assim nos perseguiram. Não nos é permitido nem... morrer em... p-paz?\" Você vê a fratura no crânio de <<o:EventUnit>> se espalhar."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1499@BUTTON_0"
msgstr "Dê a <<P:{EventUnit}>> a bolsa. [goodact/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1499@BUTTON_1"
msgstr "Guarde a mana. [mana/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1499@BUTTON_2"
msgstr "\"Posso lhe fornecer mana [mana/] e segurança sob meu império.\" [unit/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_1499@TITLE"
msgstr "Lago do Grande Verme: Pecado da Vida"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_805@BODY_FOOTER"
msgstr "(WIP)"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_805@BODY_HEADER"
msgstr "O Herói chegou para abrir a barreira(WIP)"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_805@BODY_LORE"
msgstr "Magia magia(WIP)"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_805@BUTTON_0"
msgstr "Vamos láaa(WIP)"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_805@TITLE"
msgstr "Perigo (WIP)"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_808@BODY_FOOTER"
msgstr "Parece que os Unmakers estavam tentando replicar o Poço da Criação. Mas o que deu errado?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_808@BODY_HEADER"
msgstr "Ao escavar a área final, um {EventStructure} ergue‑se diante de você. Cristais de mana perfuram sua estrutura, contaminados pela energia negativa."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_808@BODY_LORE"
msgstr "Uma mão sem vida protrai‑se dos escombros, segurando um diário como a última prova de sua existência. Ao lê‑lo, você encontra a passagem: \"Mais [hyperlink,GLOBAL.FractureLoreConcept]Fraturas[/hyperlink] estão surgindo, mas os experimentos são promissores. Podemos criar uma fonte infinita de energia, uma Fenda de {GLOBAL.TheWellLoreConcept.Hyperlink}. Estamos tão perto; só precisamos isolar e condensar mana em sua forma mais pura. Devemos nos apressar para ser os primeiros, dizem que o experimento já teve sucesso em outro reino.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_808@BUTTON_0"
msgstr "Siga até a torre; se houver respostas, elas estão lá."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_808@TITLE"
msgstr "Núcleo da Contaminação: A Fonte"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_811@BODY_FOOTER"
msgstr "O ar vibra ao redor dos humanoides fraturados; sua mera presença distorce o próprio tecido da magia. De repente, eles se voltam para você, atraídos por sua magia."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_811@BODY_HEADER"
msgstr "Depois de remover os escombros e o solo, você descobre um {GLOBAL.STRUCTURES.FRACTURED_INFESTATION.Hyperlink}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_811@BODY_LORE"
msgstr "Humanoides, ou o que resta deles, vagueiam pela área. Seus corpos retorcidos irradiam a mesma energia das fissuras no chão. \"Abominações deformadas... Se você permanecer muito tempo perto de uma Fratura, acabará como eles,\" sussurra {EventHero}. \"É por isso que nosso povo está amaldiçoado a vagar para sempre, por causa da arrogância dos {GLOBAL.UnmakersLoreConcept.Hyperlink}.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_811@BUTTON_0"
msgstr "Prepare suas tropas para avançar."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_811@TITLE"
msgstr "Núcleo da Contaminação: Infestação"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_813@BODY_FOOTER"
msgstr "Grandes carregamentos de mana cristalizada estão espalhados pelo local, todos apontando para a fonte da contaminação."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_813@BODY_HEADER"
msgstr "Ao escavar a área, você revela uma cena perturbadora: edifícios desabados, ossos meio desintegrados, fissuras e cristais que emitem uma energia assustadora, que atrai suas tropas para dentro deles."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_813@BODY_LORE"
msgstr "\"Estas são ruínas,\" diz {EventHero}. \"Ruínas da civilização que existiu antes de {GLOBAL.TheFracturingLoreConcept.Hyperlink}. [hyperlink,GLOBAL.UnmakersLoreConcept]Aqueles que condenaram este reino[/hyperlink] a ser devorado por si mesmo. Nesta cidade, como em muitas outras, eles buscavam criar algo. Experimentaram com a própria origem da magia. E, por sua arrogância, rasgaram o tecido tanto da magia quanto da realidade.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_813@BUTTON_0"
msgstr "Continue seu caminho, seguindo as fissuras."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_813@TITLE"
msgstr "Núcleo da Contaminação: Ruínas"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_814@BODY_FOOTER"
msgstr "A fonte da contaminação está próxima, você pode senti‑la logo após a próxima camada de terra. O que eles estavam tentando criar com tanta mana?"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_814@BODY_HEADER"
msgstr "Você escava a próxima área. Quanto mais avança, mais cristais de mana o cercam, opacos, contaminados, sem vida."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_814@BODY_LORE"
msgstr "As fissuras contaminadas começam a convergir para sua fonte. A energia que delas emana é tão intensa que você sente que tenta extrair algo de dentro de você. Suas tropas também a sentem, sua magia diminui rapidamente, seus encantamentos exigem renovação constante. A energia está drenando seu mana. Como pode uma energia drenar? Seja qual for o experimento que os Unmakers conduziram... Eles o fizeram aqui."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_814@BUTTON_0"
msgstr "Prepare suas tropas para cavar."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_814@TITLE"
msgstr "Núcleo da Contaminação: Perigo"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_821@TITLE"
msgstr "Torre da Fratura (WIP)"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_835@BODY_FOOTER"
msgstr "\"Minha tribo... Somos descendentes dos Unmakers,\" diz {TribeHero} em choque. \"Meu dever não termina {EventHero}, guardarei este lugar sempre, ao seu lado\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_835@BODY_HEADER"
msgstr "O {EventRelic} está diante de {EventHero}, finalmente desconectado do {EventStructure}, interrompendo a fonte da contaminação. Você vê {TribeHero} pegar um diário do chão."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_835@BODY_LORE"
msgstr "<<Cp:TribeHero>> lê: \"Uma onda de magia negativa do Mar Astral nos atingiu. Acreditamos que um experimento deu terrivelmente errado em outro reino. A onda desencadeou uma reação em cadeia. As Fraturas estão surgindo, devorando tudo em seu caminho. Estamos tentando encerrar o experimento, mas é tarde demais, devemos selar a cidade... Com nós mesmos dentro. Poucos escaparão, jurando guardar este lugar para sempre. Eles serão chamados de... {TribeName}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_835@BUTTON_10"
msgstr "Reúna o maior número possível de diários [knowledge/]."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_835@BUTTON_3"
msgstr "Colete o equipamento experimental [item/] dos magos."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_835@BUTTON_9"
msgstr "Sincronize com a energia fraturada por sua conta e risco [hp/]."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_835@TITLE"
msgstr "Núcleo da Contaminação: Consequência"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_836@BODY_FOOTER"
msgstr "Parece que alguns {GLOBAL.DragonsLoreConcept.Hyperlink} ajudaram [hyperlink,GLOBAL.UnmakersLoreConcept]os Unmakers[/hyperlink] a criar o {EventRelic}. E que seus carcaças vagueiam por este local."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_836@BODY_HEADER"
msgstr "O {EventStructure} suga energia dos arredores, alimentando algo em seu núcleo. A atração é tão forte que suas tropas têm seu mana drenado."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_836@BODY_LORE"
msgstr "{EventHero} atravessa o limiar da estrutura. Erguendo <<o:EventHero>> olhar ao coração da torre, <<p:EventHero>> vê: um miniatura [hyperlink,GLOBAL.TheWellLoreConcept]Poço da Criação[/hyperlink], o {EventRelic}. Faminto há eras, ergue‑se um {EventUnit}, uma criatura majestosa que antes possuía um nome próprio, agora enlouquecida pela energia devoradora. Os magos que estavam presos dentro levantam‑se ao seu lado, os remanescentes dos Unmakers."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_836@BUTTON_0"
msgstr "Ponha fim a este experimento."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_836@BUTTON_1"
msgstr "Envie tropas [unitprod/] para derrubar parte da torre sobre os seres Fraturados."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_836@BUTTON_2"
msgstr "Desenhe sigilos de mana protetora [mana/] em suas tropas."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_836@BUTTON_3"
msgstr "Estabilize o mana de suas tropas."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_836@BUTTON_4"
msgstr "Recuar."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_836@BUTTON_5"
msgstr "Aproveite as fissuras da {EventStructure}, fazendo-a desabar sobre seus inimigos."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_836@TITLE"
msgstr "Núcleo da Contaminação: Torre Fraturada"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_868@TITLE"
msgstr "Ecos da Fraturação: Ventos Devoradores"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_869@BODY_FOOTER"
msgstr "Quer você busque impedir ou empunhar o poder destrutivo da {GLOBAL.FracturingWindsConcept.Hyperlink}, encontrará o que deseja nas Regiões Predestinadas."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_869@BODY_HEADER"
msgstr "Com uma onda tumultuosa que varreu o reino, ocorreu um {GLOBAL.CataclysmConcept.Hyperlink}. As terras tornam‑se [hyperlink,GLOBAL.AstralBarrensConcept]áridas[/hyperlink] em sua esteira, e a conjuração de feitiços torna‑se instável."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_869@BODY_LORE"
msgstr "Quando o pó deste acontecimento assenta, as energias devoradoras convergem para locais específicos, terras que existiam muito antes [hyperlink,GLOBAL.TheFracturingLoreConcept]da Fraturação[/hyperlink]. Para as tribos nômades de {EventRealm}, são territórios proibidos, lugares perigosos repletos de segredos que seria melhor deixar ocultos. Cada fábula narra um {GLOBAL.ArtifactConcept.Hyperlink} de imenso poder e arrogância, e uma lenda afirma que quem unir três poderá curar o mundo... Ou dominá‑lo."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_869@BUTTON_0"
msgstr "Aventure‑se, em busca dessas Regiões Predestinadas."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1224_869@TITLE"
msgstr "Um Cataclismo Ataca"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_110@BODY_FOOTER"
msgstr "Impulsionado pela loucura, o {EventUnit} ergue o {EventRelic.NoLink}: \"Venha! Lute comigo, {PlayerLeader}! Eu sei que você quer isso—sobre o meu cadáver!\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_110@BODY_HEADER"
msgstr "Com o <<o:EventUnit>> fantasmagórico reagrupado, o {EventUnit} marcha para concluir o <<o:EventUnit>> cerco interminável de {EventCityName}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_110@BODY_LORE"
msgstr "Ainda que quanto mais <<p:EventUnit>> se aprofunda na cidade arruinada, mais descontente o {EventUnit} fica. \"Onde estão aqueles desordeiros lançadores de feitiços!?\" <<p:EventUnit>> grita irritado, buscando oposição. Finalmente, o {EventUnit} alcança a cratera central, memorial silencioso de {GLOBAL.TheFracturingLoreConcept.Hyperlink}. Guiado por alguma intuição fantasmagórica, <<p:EventUnit>> mergulha nos escombros, retornando logo depois com um objeto radiante. \"Que feitiçaria é essa? Isso não pode ser, a menos que...\" O {EventUnit} fixa o olhar diretamente em você, perfurando o véu Astral. \"Você!\" <<p:EventUnit>> grita, \"você é um [hyperlink,GLOBAL.UnmakersLoreConcept]Unmaker[/hyperlink], {PlayerLeader}!\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_110@BUTTON_0"
msgstr "Unmaker ou não, você porá o espírito perturbado <<o:EventUnit>> em repouso."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_110@TITLE"
msgstr "Colinas Fantasmas: Uma Verdade Louca"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_112@BODY_FOOTER"
msgstr "O {EventUnit} entrega o {EventRelic}: \"Os {GLOBAL.UnmakersLoreConcept.Hyperlink}, eles aprisionaram as águas da criação. Contudo, quando tentaram liberar a chuva, desencadearam um dilúvio.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_112@BODY_HEADER"
msgstr "À medida que o espírito <<o:EventUnit>> está prestes a perecer violentamente, o {EventUnit} finalmente consegue ver a verdade."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_112@BODY_LORE"
msgstr "\"<<C:{GLOBAL.TheFracturingLoreConcept.Hyperlink}>>!\" <<p:EventUnit>> exclama consternado, como se <<p:EventUnit>> revivesse os últimos momentos da vida distante de <<o:EventUnit>>. \"Todos esses anos—esta eternidade—eu estive... morto.\" O {EventUnit} enfunda <<o:EventUnit>>. \"Curvo‑me à sua força e valor, {PlayerLeader},\" <<p:EventUnit>> exclama. \"Você acabou com minha maldição vingativa e libertou meus soldados. Que todos encontrem paz, finalmente.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_112@BUTTON_0"
msgstr "Antes que <<p:EventUnit>> desapareça, solicite ao espírito a marca <<o:EventUnit>> do {EventUnit}. [xp/][renown/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_112@BUTTON_3"
msgstr "Reivindique as máquinas de cerco [unit/] do exército que se dissipa."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_112@BUTTON_4"
msgstr "Divulgue a lenda do {EventUnit} para inspirar instrutores [unitprod/] em todo o seu reino."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_112@BUTTON_5"
msgstr "Compartilhe a história das Colinas Fantasmas com o {GLOBAL.EternalSagesLoreConcept.Name}. [allegiance/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_112@BUTTON_6"
msgstr "Ligue o espírito <<o:EventUnit>> à sua vontade [unit/], em servidão eterna. [evilact/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_112@TITLE"
msgstr "Colinas Fantasmas: Consequência"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_82@BODY_FOOTER"
msgstr "Preso em um passado já distante, o {EventUnit} ordena que suas tropas se preparem para o cerco de um bastião já arruinado [hyperlink,GLOBAL.UnmakersLoreConcept]Unmaker[/hyperlink]."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_82@BODY_HEADER"
msgstr "Ao entrar em um ermo fraturado, suas tropas avistam aparições fantasmagóricas vagando nas colinas. Uma delas, um formidável {EventUnit}, bloqueia o caminho."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_82@BODY_LORE"
msgstr "\"Reforços, finalmente!\" <<p:EventUnit>> grita com vigor. \"Aqueles malditos {GLOBAL.UnmakersLoreConcept.Hyperlink} impediram nosso avanço por tempo demais, suas magias instáveis causando caos por toda parte. Elas enlouqueceram a mente dos meus soldados, desativaram nosso cerco, infiltraram‑se em nossas posições...\" O {EventUnit} faz uma pausa, talvez percebendo que as palavras de <<o:EventUnit>> não inspirarão muita confiança. \"Com a sua chegada, a maré virou. Até {EventGodirName}, romperemos as defesas deles antes que seus experimentos mágicos detonem todo este maldito reino ao esquecimento!\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_82@BUTTON_0"
msgstr "Deixe‑os seguir as ordens delirantes de <<o:EventUnit>>, por enquanto."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_82@BUTTON_3"
msgstr "Persuada [influence/] o {EventUnit} a treinar suas tropas [xp/] primeiro."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_82@TITLE"
msgstr "Escalando as Colinas Fantasmas"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BODY_FOOT@FRACTURE_1_DONE"
msgstr "Não se pode fazer nada aqui mais."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BODY_FOOT@FRACTURE_2_DONE"
msgstr "Não se pode fazer nada aqui mais."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BODY_FOOT@FRACTURE_3_DONE"
msgstr "Não se pode fazer nada aqui mais."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BODY_FOOTER"
msgstr "O {EventAnimal} e sua horda de habitantes do ermo infestaram o <<m:EventStackLeader>>."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BODY_FOOTER@GOLEM_REPAIRED"
msgstr "Os <<m:EventStackLeader>> estão prontos para serem empregados."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BODY_HEADER"
msgstr "Ao se aproximar das máquinas de cerco inativas marcadas pelo {EventUnit}, suas tropas começam a ouvir uma multidão de ruídos de estalo e chiado."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BODY_HEADER@FRACTURE_1_DONE"
msgstr "Suas tropas retornam ao {GLOBAL.FractureLoreConcept.Hyperlink} no complexo mágico."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BODY_HEADER@FRACTURE_2_DONE"
msgstr "Suas tropas retornam ao {GLOBAL.FractureLoreConcept.Hyperlink} onde você encontrou os nômades."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BODY_HEADER@FRACTURE_3_DONE"
msgstr "Suas tropas retornam ao {GLOBAL.FractureLoreConcept.Hyperlink} na biblioteca."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BODY_HEADER@GOLEM_REPAIRED"
msgstr "Suas tropas retornam ao <<m:EventStackLeader>> fumegante."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BODY_LORE"
msgstr "Observando cuidadosamente à distância, eles percebem movimentos indistintos dentro das carcaças metálicas do <<m:EventStackLeader>>. Finalmente, um grande {EventAnimal} avança, adotando postura agressiva, enquanto o estalo das tesouras <<o:EventAnimal>> ecoa pelas colinas.[br/][br/]É evidente que essas criaturas do ermo, atraídas pelo calor ainda emanado do <<m:EventStackLeader>>—ou sua aparência de escorpião—transformaram as máquinas de cerco abandonadas em seu refúgio."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BODY_LORE@FRACTURE_1_DONE"
msgstr "O local permanece calmo, seus sigilos ainda brilham com poder."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BODY_LORE@FRACTURE_2_DONE"
msgstr "O local permanece calmo, seus sigilos ainda brilham com poder."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BODY_LORE@FRACTURE_3_DONE"
msgstr "O local permanece calmo, seus sigilos ainda brilham com poder."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BODY_LORE@GOLEM_REPAIRED"
msgstr "As máquinas de cerco mal se movem ou fazem barulho. Mas o calor de seus núcleos fundidos aquece o entorno."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BUTTON_0"
msgstr "Fuja, por enquanto."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BUTTON_0@GOLEM_REPAIRED"
msgstr "Parta."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BUTTON_1"
msgstr "Afaste as criaturas do ermo."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BUTTON_2"
msgstr "Atraia-as com abundância de alimento. [food/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BUTTON_4"
msgstr "Una‑se ao {EventAnimal} e torne‑se o novo <<PlayerLeader{Sire/Matriarch}>>."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@BUTTON_5"
msgstr "Incendeie o <<m:EventStackLeader>> com vida, incinerando as criaturas."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_86@TITLE"
msgstr "Colinas Fantasmas: Construtos Reaproveitados"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_91@BODY_FOOTER"
msgstr "\"A vontade do nosso {EventUnit} nos mantém cativos,\" o {EventStackLeader} encerra a <<o:EventStackLeader>> história. \"Somos fantasmas desamparados, eternamente acorrentados a um propósito perdido.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_91@BODY_FOOTER@MORALE_RESTORED"
msgstr "O exército está pronto para atacar {EventCityName}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_91@BODY_HEADER"
msgstr "Nesta colina, o fantasma solitário de um {EventStackLeader} permanece. Quando suas tropas se aproximam, <<p:EventStackLeader>> começa a resmungar."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_91@BODY_HEADER@MORALE_RESTORED"
msgstr "Ao retornar à colina, suas tropas encontram o exército fantasmagórico reunido ao redor do {EventStackLeader}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_91@BODY_LORE"
msgstr "\"Estávamos posicionando todos os batalhões nestas colinas,\" <<p:EventStackLeader>> fala com voz cansada, \"prontos para descer sobre o {GLOBAL.UnmakersLoreConcept.Hyperlink}. Mas tarde demais...\" O olhar do <<EventStackLeader{homem/mulher}>> se intensifica. \"Num lampejo de relâmpago azul‑turquesa, a cidade e tudo ao redor foram dilacerados — dilacerados por dentro. Todos perecemos em {GLOBAL.TheFracturingLoreConcept.Hyperlink}. Mas não foi o fim.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_91@BODY_LORE@MORALE_RESTORED"
msgstr "Suas longas fileiras de formas armadas e fantasmagóricas despertam simultaneamente admiração e terror. Nenhum entusiasmo ou zelo domina seus rostos marcados, apenas o cansaço de servir ao {EventUnit} por mil vidas."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_91@BUTTON_0"
msgstr "Deixe <<P:EventStackLeader>> por enquanto."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_91@BUTTON_0@MORALE_RESTORED"
msgstr "Parta."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_91@BUTTON_1"
msgstr "\"Ensinarei a você a obedecer aos comandos do seu {EventUnit} além da morte!\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_91@BUTTON_2"
msgstr "\"Amizade e lealdade [influence/] podem sobreviver à morte. Marquem e seu propósito perdido será cumprido.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_91@BUTTON_4"
msgstr "\"Reúnam suas tropas uma última vez, e eu prometo que encontrarão a paz.\" [goodact/]"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_91@BUTTON_5"
msgstr "\"Os caídos não questionam. Os caídos obedecem ao poder.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_91@TITLE"
msgstr "Colinas Fantasmas: Vontade do Senhor da Guerra"

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_94@BODY_FOOTER"
msgstr "O {EventStackLeader} está drenando seu mana. Seja qual for a informação que o {EventUnit} procura, tente obtê‑la rapidamente."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_94@BODY_FOOTER@SPY_INTERROGATED"
msgstr "Não há mais nada a aprender com este {EventStackLeader}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_94@BODY_HEADER"
msgstr "Ao entrar na cova da prisão do acampamento fantasmagórico, suas tropas estremecem ao avistar o \"espião\" aprisionado."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_94@BODY_HEADER@SPY_INTERROGATED"
msgstr "Com grande cautela, suas tropas retornam ao {EventStackLeader} aprisionado."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_94@BODY_LORE"
msgstr "\"Mais perguntas?\" a boca da entidade pergunta, enquanto seus homens encaram o abismo de sua cabeça fraturada. \"Já era hora. Estou faminto... Para conversar.\" Ao falar, você sente uma atração astral, sua presença suga sua magia. \"Ahh,\" suspira aliviada, \"que companhia agradável... Se ao menos eu pudesse voltar para {EventCityName}. Com meu povo... Nosso {EventRelic.NoLink}, minha fome cessaria.\""

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_94@BODY_LORE@SPY_INTERROGATED"
msgstr "<<Cp:EventStackLeader>> parece ter entrado em um estado semelhante a transe, como se as respostas que você encontrou esvaziaram a mente de <<o:EventStackLeader>>. Até a atração astral que você sentiu antes parece ter diminuído, por enquanto."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_94@BUTTON_0"
msgstr "Fuja do esgotamento de mana, por enquanto."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_94@BUTTON_0@SPY_INTERROGATED"
msgstr "Parta."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_94@BUTTON_1"
msgstr "Confronte as memórias despedaçadas da entidade, revivendo {GLOBAL.TheFracturingLoreConcept.Name}."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_94@BUTTON_2"
msgstr "Agarre a mente quebrada [knowledge/] do {EventStackLeader} para arrancar o conhecimento de <<o:EventStackLeader>>."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_94@BUTTON_4"
msgstr "Esprema cada gota de mana do {EventStackLeader} até que <<p:EventStackLeader>> grite."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_94@BUTTON_5"
msgstr "Alimente o {EventStackLeader} com abundância de mana [mana/] para acalmar as respostas de <<o:EventStackLeader>>."

msgid "DLC@RISEFROMRUIN@STORY_EVENT@1252_94@TITLE"
msgstr "Colinas Fantasmas: Memórias Fraturadas"

msgid "DLC@RISEFROMRUIN@TERRAINDEFINITIONS_STRATEGIC@ASTRAL_BARRENS@COMBAT_PROPERTY@DESCRIPTION"
msgstr "<<m:{GLOBAL.CombatSpellConcept.Hyperlink}>> tem {percentage} de chance de {GLOBAL.BackfireConcept.Hyperlink}.[br/][br/]Além disso, vários obstáculos de Fratura Astral estão presentes, que são {GLOBAL.DrainingConcept.Hyperlink} e se duplicam sempre que um {GLOBAL.CombatSpellConcept.Hyperlink} é lançado."

msgid "DLC@RISEFROMRUIN@TERRAINDEFINITIONS_STRATEGIC@ASTRAL_BARRENS@NAME"
msgstr "Ermos Astrais"

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@PASSIVE@DESCRIPTION"
msgstr "É possível construir <<m:{GLOBAL.FarmConcept.Hyperlink}>> em terreno de Areia.[br/][br/]<<m:{GLOBAL.FarmConcept.Hyperlink}>> em terreno de Areia ganha +{amount} {GLOBAL.FoodConcept.Hyperlink} se sua raça possui Adaptação ao Deserto."

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@PASSIVE@NAME"
msgstr "Agricultura do Deserto"

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@PASSIVE_STABILITY@DESCRIPTION"
msgstr "<<m:{GLOBAL.ProvinceConcept.Hyperlink}>> com Areia concede +{amount} {GLOBAL.CityStabilityConcept.Hyperlink}."

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@PASSIVE_STABILITY@NAME"
msgstr "Preferência por Areia"

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@SKILL1@DESCRIPTION"
msgstr "Convoque um {GLOBAL.UNITS.SAND_SCORPION.Hyperlink}, uma unidade {GLOBAL.PROPERTIES.SHIELD_UNIT.Hyperlink} com veneno debilitante."

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@SKILL1@NAME"
msgstr "Convoque Escorpião de Areia"

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@SKILL2@DESCRIPTION"
msgstr "Alvo e província adjacente <<m:{GLOBAL.ProvinceConcept.Hyperlink}>>:[bulletlist][bullet/]Ganha {GLOBAL.SandConcept.Hyperlink}.[bullet/]Perde {GLOBAL.ChasmConcept.Hyperlink}, {GLOBAL.SwampConcept.Hyperlink}, {GLOBAL.SnowConcept.Hyperlink}, {GLOBAL.FrozenWasteConcept.Hyperlink}, {GLOBAL.AshlandsConcept.Hyperlink} e {GLOBAL.GloomTerrainConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@SKILL2@NAME"
msgstr "Desertificação"

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@SKILL3@DESCRIPTION"
msgstr "A raça-alvo torna‑se uma com o deserto, concedendo‑lhe:[bulletlist][bullet/]{GLOBAL.PROPERTIES.SAND_WALK.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.SAND_CAMOUFLAGE.Hyperlink}[bullet/]Quando estiver em terreno {GLOBAL.SandConcept.Hyperlink}, ganha:[bulletlist][bullet/]Movimento Muito Rápido em combate.[bullet/]+{amount}% {GLOBAL.FlankingConcept.Hyperlink} de dano.[/bulletlist][/bulletlist]"

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@SKILL3@MOD_DESCRIPTION"
msgstr "A unidade causa +{DUNESTALKERS_FLANK_DAMAGE>ResolvedMultiplier}% de dano quando {GLOBAL.FlankingConcept.Hyperlink}."

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@SKILL3@NAME"
msgstr "Caminhantes das Dunas"

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@SKILL3@PROP_DESCRIPTION"
msgstr "A unidade tem:[bulletlist][bullet/]{GLOBAL.PROPERTIES.SAND_WALK.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.SAND_CAMOUFLAGE.Hyperlink}[bullet/]Quando estiver em terreno {GLOBAL.SandConcept.Hyperlink} ganha:[bulletlist][bullet/]Movimento Muito Rápido em combate.[bullet/]+{amount}% {GLOBAL.FlankingConcept.Hyperlink} de dano.[/bulletlist][/bulletlist]"

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@SKILL4@DESCRIPTION"
msgstr "Convoque um {GLOBAL.SandstormConcept.Hyperlink} em um raio de {SANDSTORM_POSITION_TARGETER_CIRCLE>AREA>Radius} hexágonos que dura {SANDSTORM_PLACE_MARKER>Duration} <<m:{GLOBAL.TurnConcept}>>."

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@SKILL4@MARKER_DESCRIPTION"
msgstr "Unidades que passam ou terminam o turno neste hexágono:[bulletlist][bullet/]Têm chance base de {chance}% de se tornar {GLOBAL.PROPERTIES.BLINDED.Hyperlink} por {amount} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Tornam‑se {GLOBAL.PROPERTIES.SLOWED.Hyperlink} por {amount} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][br/]Unidades com {GLOBAL.PROPERTIES.SAND_WALK.Hyperlink} são imunes a este efeito."

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@SKILL4@MARKER_HYPERLINK"
msgstr "[hyperlink,GLOBAL.SandstormConcept]Tempestade de Areia[/hyperlink]"

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@SKILL4@NAME"
msgstr "Tempestade de Areia"

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@SKILL5@DESCRIPTION"
msgstr "Ataques de unidades encantadas recebem:[bulletlist][bullet/]Uma chance base de {WEAKENED_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.WEAKENED.Hyperlink} por {WEAKENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Uma chance base de {POISONED_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.POISONED.Hyperlink} por {POISONED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]+{SCORPION_VENOM_BLADES_FLANKING_DAMAGE>DAMAGE>Blight} {GLOBAL.BlightDamageConcept.Hyperlink} ao flanquear.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@SKILL5@NAME"
msgstr "Armas de Veneno de Escorpião"

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@SKILL5@PROP_DESCRIPTION"
msgstr "Ataques recebem:[bulletlist][bullet/]Uma chance base de {WEAKENED_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.WEAKENED.Hyperlink} por {WEAKENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Uma chance base de {POISONED_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.POISONED.Hyperlink} por {POISONED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]+{SCORPION_VENOM_BLADES_FLANKING_DAMAGE>DAMAGE>Blight} {GLOBAL.BlightDamageConcept.Hyperlink} ao flanquear.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@SPI@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{amount1} {GLOBAL.GoldConcept.Hyperlink} de renda.[bullet/]Por cada {GLOBAL.ProvinceConcept.Hyperlink} adjacente com {GLOBAL.SandConcept.Hyperlink}:[bulletlist][bullet/]+{amount2} {GLOBAL.GoldConcept.Hyperlink}.[bullet/]+{amount3} {GLOBAL.FoodConcept.Hyperlink}.[/bulletlist][bullet/]Conta como um {GLOBAL.MineConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@SPI@NAME"
msgstr "[mine/] Grande Bazar"

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Espalhe desertos, persiga e cegue seus inimigos, e convoque um Guardião do Deserto para protegê‑lo."

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@TOME@LORE_DESCRIPTION"
msgstr "\"A maioria chama o deserto de lugar perigoso, uma armadilha mortal sem água, comida ou abrigo. Nós o chamamos de lar. Somos a miragem no calor, somos os saqueadores no vento. Nosso aço fere com veneno, irmãos do escorpião. Somos aqueles que invocam a tempestade de areia. Somos os Caminhantes das Dunas.\""

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@TOME@NAME"
msgstr "Tomo dos Caminhantes das Dunas"

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@UNIT@ABILITY01@DESCRIPTION"
msgstr "Unidade inimiga alvo:[bulletlist][bullet/]Sofre dano.[bullet/]Ganha {amount1} {GLOBAL.PROPERTIES.WEAKENED.Hyperlink} por {WEAKENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Ganha {amount2} {GLOBAL.PROPERTIES.POISONED.Hyperlink} por {POISONED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][br/]Entre em {GLOBAL.DefenseModeConcept.Hyperlink}."

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@UNIT@ABILITY01@NAME"
msgstr "Ferrão Debilitante"

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@UNIT@ABILITY02@DESCRIPTION"
msgstr "Mover para o hexágono alvo."

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@UNIT@ABILITY02@NAME"
msgstr "Deslocamento de Areia"

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@UNIT@ABILITY02@PROP_DESCRIPTION"
msgstr "A unidade ganha {GLOBAL.PROPERTIES.SAND_SHIFT.Hyperlink} quando está em terreno {GLOBAL.SandConcept.Hyperlink}."

msgid "DLC@RISEFROMRUIN@TOME_SAND_STALKER@UNIT@NAME"
msgstr "Escorpião de Areia^n"

msgid "DLC@RISEFROMRUIN@TOME_WARBAND@ABILITY01@DESCRIPTION"
msgstr "Unidade inimiga alvo e todas as unidades desse tipo ganham:[bulletlist][bullet/]{amount} {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink} por {SUNDERED_DEFENSE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]{amount} {GLOBAL.PROPERTIES.SUNDERED_RESISTANCE.Hyperlink} por {SUNDERED_RESISTANCE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@TOME_WARBAND@ABILITY01@NAME"
msgstr "Discernir Fraqueza"

msgid "DLC@RISEFROMRUIN@TOME_WARBAND@ABILITY02@DESCRIPTION"
msgstr "[bulletlist][bullet/]Quando esta unidade ataca, uma unidade aliada aleatória dentro de {LIEUTENANTS_LEAD_ON_ATTACK_JUMP>MaxDistance} hexágonos ganha {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} por {STRENGTHENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Quando esta unidade entra em {GLOBAL.DefenseModeConcept.Hyperlink}, uma unidade aliada aleatória dentro de {LIEUTENANTS_LEAD_ON_DEFENSE_MODE_JUMP>MaxDistance} hexágonos ganha {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink} e {GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink} por {BOLSTERED_DEFENSE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@TOME_WARBAND@ABILITY02@NAME"
