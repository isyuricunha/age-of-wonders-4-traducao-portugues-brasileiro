msgid "TOME_CYCLES@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Domine os ciclos naturais da vida e da morte e especialize-se em enfraquecer inimigos e curar aliados."

msgid "TOME_CYCLES@TOME@LORE_AUTHOR"
msgstr "Serena, Feiticeira Élfica da Vida"

msgid "TOME_CYCLES@TOME@LORE_DESCRIPTION"
msgstr "\"Existe um ciclo em todas as coisas. A besta se alimenta de sua presa, ganhando força. O cadáver apodrece, nutrindo a terra. A vida dá lugar à morte, que, por sua vez, dá lugar a mais vida. Domine esse fluxo e refluxo, e descobrirá que pode manipular tanto seus dons quanto o preço que eles exigem!\""

msgid "TOME_CYCLES@TOME@NAME"
msgstr "Tomo dos Ciclos"

msgid "TOME_CYCLES@UNIT@NAME"
msgstr "Druida do Ciclo"

msgid "TOME_DEMON_GATE@HERO_SKILL@DESCRIPTION"
msgstr "Enquanto esta unidade for o líder do exército, unidades amigas que não sejam {GLOBAL.PROPERTIES.FIEND} e que não sejam {GLOBAL.HeroConcept} no exército:[bulletlist][bullet/]Transformam‑se em <<m:{GLOBAL.PROPERTIES.FIEND.Hyperlink}>> de Nível I ao morrer em batalha.[bullet/]Tem uma pequena chance de transformar‑se em <<m:{GLOBAL.PROPERTIES.FIEND.Hyperlink}>> de Nível II em vez disso.[/bulletlist]"

msgid "TOME_DEMON_GATE@HERO_SKILL@NAME"
msgstr "Hino Demoníaco"

msgid "TOME_DEMON_GATE@HERO_SKILL@PROP_DESCRIPTION"
msgstr "Quando esta unidade morre, transforma‑se em um {GLOBAL.PROPERTIES.FIEND} de Nível I. Tem uma pequena chance de transformar‑se em um {GLOBAL.PROPERTIES.FIEND} de Nível II em vez disso."

msgid "TOME_DEMON_GATE@PASSIVE@DESCRIPTION"
