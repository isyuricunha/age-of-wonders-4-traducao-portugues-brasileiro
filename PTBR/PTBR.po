msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@SKILL2@DESCRIPTION"
msgstr "Quando conjurado e pelos próximos {TEARS_OF_THE_CRIMSON_SOVEREIGN_UNIT_AUTO_SPELL>TimeToLive} <<m:{GLOBAL.TurnConcept}>>:[bulletlist][bullet/]Até {TEARS_OF_THE_CRIMSON_SOVEREIGN_ENEMY_TARGETER>NumTargets} unidades inimigas:[bulletlist][bullet/]Sustentar {TEARS_OF_THE_CRIMSON_SOVEREIGN_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Ter uma chance base de {BLOOD_PARASITE_RESISTANCE>ResolvedStrength}% de ganhar {GLOBAL.PROPERTIES.BLOOD_PARASITE.Hyperlink} por {BLOOD_PARASITE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][bullet/]Até {TEARS_OF_THE_CRIMSON_SOVEREIGN_FRIENDLY_TARGETER>NumTargets} unidades aliadas:[bulletlist][bullet/]Curar em {TEARS_OF_THE_CRIMSON_SOVEREIGN_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Ganhar {GLOBAL.PROPERTIES.FORTUNE.Hyperlink} por {FORTUNE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@SKILL2@NAME"
msgstr "Lágrimas do Soberano Carmesim"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@SKILL3@BUFF_DESCRIPTION"
msgstr "Unidade:[bulletlist][bullet/]Tem +{MANTLE_OF_THE_BLOOD_NOBLE_HP_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[bullet/]Recebe +{MANTLE_OF_THE_BLOOD_NOBLE_HEAL_MODIFIER>ResolvedHealing Multipli}% de cura em combate.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@SKILL3@DESCRIPTION"
msgstr "Concede a unidades encantadas:[bulletlist][bullet/]{GLOBAL.PROPERTIES.COAGULATE.Hyperlink}[bullet/]No início do combate, para cada unidade aliada não invocada de Tier I e Tier II:[bulletlist][bullet/]+{amount1} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]+{amount2}% de cura recebida em combate.[/bulletlist][/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@SKILL3@NAME"
msgstr "Manto do Nobre Sangrento"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@SKILL3@PROP_DESCRIPTION"
msgstr "Unidade:[bulletlist][bullet/]Tem {GLOBAL.PROPERTIES.COAGULATE.Hyperlink}[bullet/]No início do combate, para cada unidade aliada não invocada de Tier I e Tier II, ganha:[bulletlist][bullet/]+{amount1} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]+{amount2}% de cura recebida em combate.[/bulletlist][/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@SKILL4@DESCRIPTION"
msgstr "[bulletlist][bullet/]Unidades de Tier III, IV e V que você possui ganham:[bulletlist][bullet/]+{amount1} {GLOBAL.HitPointConcept.Hyperlink} de regeneração no mapa estratégico.[bullet/]Ganhar {amount2} {GLOBAL.ExperienceConcept.Hyperlink} por turno no mapa estratégico.[/bulletlist][bullet/]Ganhar {GLOBAL.CrimsonCourtMagistrateConcept.Hyperlink}, permitindo que você ganhe mana de Vassalos e ao Migrar, Saquear ou Pilhar.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@SKILL4@NAME"
