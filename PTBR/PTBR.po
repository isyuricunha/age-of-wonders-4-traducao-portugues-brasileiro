msgid "DLC@RISEFROMRUIN@INTERFACE@FRACTURE@DESCRIPTION"
msgstr "Fracturas são rasgos no tecido da magia e da realidade.[br/][br/]Mover uma unidade [unit/] disparará um Evento relacionado a ela."

msgid "DLC@RISEFROMRUIN@INTERFACE@FRACTURE@ERROR"
