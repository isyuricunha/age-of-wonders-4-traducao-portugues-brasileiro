msgid "COMBATPROPERTIES_TACTICAL@ELECTRIFIED@DESCRIPTION"
msgstr "[bulletlist][bullet/]Unidade sofre {ELECRIFIED_DAMAGE_OVER_TIME>ATTACK>Shock} {GLOBAL.LightningDamageConcept.Hyperlink} a cada [turn/]. [bullet/]Acúmulo de até {stacksMax} vezes.[/bulletlist]"

msgid "COMBATPROPERTIES_TACTICAL@ELECTRIFIED@NAME"
