msgid "TOME_INQUISITION@SKILL4@DESCRIPTION"
msgstr "Faz com que os ataques de unidades encantadas tenham:[bulletlist][bullet/]Chance base de {CONDEMN_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink} até o fim do combate, reduzindo a {GLOBAL.StatusResistanceConcept.Hyperlink} do inimigo.[bullet/]Chance base de {WEAKENED_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.WEAKENED.Hyperlink}, reduzindo o dano do inimigo.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_INQUISITION@SKILL4@NAME"
