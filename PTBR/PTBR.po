msgid "ONBOARDING_OBJECTIVES@ANNEX_EXPLORATION_SITE@FINISHER@DESCRIPTION"
msgstr "Você anexou um {GLOBAL.AncientWonderConcept.Hyperlink} que agora lhe concederá um rendimento poderoso em uma das suas <<m:{GLOBAL.CityConcept.Hyperlink}>>."

msgid "ONBOARDING_OBJECTIVES@ANNEX_EXPLORATION_SITE@INSTRUCTION"
msgstr "Maravilhas Ancestrais fornecem unidades únicas ao {GLOBAL.RequestMilitaryAidConcept.Hyperlink} além de grandes quantidades de renda de recursos, incluindo valiosos {GLOBAL.ImperiumConcept.Hyperlink}, quando são adicionadas ao seu império."

msgid "ONBOARDING_OBJECTIVES@ANNEX_EXPLORATION_SITE@NAME"
msgstr "Anexação de Maravilha Ancestral"

msgid "ONBOARDING_OBJECTIVES@ANNEX_EXPLORATION_SITE@OBJECTIVE"
