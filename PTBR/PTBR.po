msgid "CULTURE_DARK@CULL_THE_WEAK@DESCRIPTION"
msgstr "[bulletlist][bullet/]{GLOBAL.RangedConcept.Hyperlink} e {GLOBAL.MagicConcept.Hyperlink} ataques têm base {chance}% de infligir {GLOBAL.PROPERTIES.WEAKENED.Hyperlink}.[bullet/]{GLOBAL.MeleeConcept.Hyperlink} ataques contra {GLOBAL.PROPERTIES.WEAKENED.Hyperlink} unidades:[bulletlist][bullet/]Causa +{CULL_THE_WEAK_DAMAGE>ResolvedMultiplier}% de dano.[bullet/]Cura o atacante em {healing} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>, uma vez por turno.[/bulletlist][/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "CULTURE_DARK@CULL_THE_WEAK@NAME"
msgstr "Eliminar os Fracos"

msgid "CULTURE_DARK@CULTOFDEATH@MORTAL_BLESSING@DESCRIPTION"
msgstr "A morte de outro concedeu a esta unidade:[bulletlist][bullet/]+{MORTAL_BLESSING_STAT>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]+{MORTAL_BLESSING_MOD>ResolvedCritChanceBonus}% {GLOBAL.CriticalHitChanceConcept.Hyperlink}[/bulletlist][br/]Acúmulo de até {MaxStacks} vezes."

msgid "CULTURE_DARK@CULTOFDEATH@MORTAL_BLESSING@NAME"
msgstr "Bênção Mortal"

msgid "CULTURE_DARK@CULTOFDEATH@POWER_FROM_DEATH@DESCRIPTION"
msgstr "Sempre que uma unidade morre:[bulletlist][bullet/]Ganhe +{Amount} {GLOBAL.PROPERTIES.MORTAL_BLESSING.Hyperlink}[bullet/]Se esta unidade desferiu o golpe final +{KillAmount} adicional {GLOBAL.PROPERTIES.MORTAL_BLESSING.Hyperlink}[/bulletlist]"

msgid "CULTURE_DARK@CULTOFDEATH@POWER_FROM_DEATH@NAME"
msgstr "Poder da Morte"

msgid "CULTURE_DARK@CULTOFTYRANNY@CULT_OF_TYRANNY@DESCRIPTION"
msgstr "Inimigos adjacentes têm {StatusResistanceCount} {GLOBAL.StatusResistanceConcept.Hyperlink}."

msgid "CULTURE_DARK@CULTOFTYRANNY@CULT_OF_TYRANNY@GROUP_DESCRIPTION"
msgstr "[bulletlist][bullet/]{GLOBAL.PROPERTIES.AURA_OF_TYRANNY.Hyperlink}[bullet/]Os ataques ganham chance base de {CULT_OF_TYRANNY_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.STATUS_VULNERABILITY.Hyperlink} e curar esta unidade em {CULT_OF_TYRANNY_HEALING>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "CULTURE_DARK@CULTOFTYRANNY@CULT_OF_TYRANNY@MODIFIER_DESCRIPTION"
msgstr "Chance base de {CULT_OF_TYRANNY_RESISTANCE>ResolvedStrength}% de:[bulletlist][bullet/]Infligir {GLOBAL.PROPERTIES.STATUS_VULNERABILITY.Hyperlink} por {STATUS_VULNERABILITY_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept.Hyperlink}>>.[bullet/]Curar a si mesmo por {CULT_OF_TYRANNY_HEALING>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[/bulletlist]"

msgid "CULTURE_DARK@CULTOFTYRANNY@CULT_OF_TYRANNY@MODIFIER_NAME"
msgstr "Explorar Vulnerabilidade"

msgid "CULTURE_DARK@CULTOFTYRANNY@CULT_OF_TYRANNY@MODIFIER_PROPERTY_DESCRIPTION"
msgstr "Os ataques da unidade têm chance base de {CULT_OF_TYRANNY_RESISTANCE>ResolvedStrength}% de:[bulletlist][bullet/]Infligir {GLOBAL.PROPERTIES.STATUS_VULNERABILITY.Hyperlink} por {STATUS_VULNERABILITY_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept.Hyperlink}>>.[bullet/]Curar a si mesmo por {CULT_OF_TYRANNY_HEALING>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "CULTURE_DARK@CULTOFTYRANNY@CULT_OF_TYRANNY@NAME"
msgstr "Culto da Tirania"

msgid "CULTURE_DARK@CULTOFTYRANNY@CULT_OF_TYRANNY@PREVIEW_OVERRIDE"
msgstr "{GLOBAL.PROPERTIES.STATUS_VULNERABILITY.Hyperlink} {effectDuration}[turn/][br/]Cure a si mesmo +{Heal} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>"

msgid "CULTURE_DARK@CULTOFTYRANNY@CULT_OF_TYRANNY@PROPERTY_DESCRIPTION"
msgstr "{StatusResistanceCount} {GLOBAL.StatusResistanceConcept.Hyperlink}."

msgid "CULTURE_DARK@CULTOFTYRANNY@CULT_OF_TYRANNY@PROPERTY_NAME"
msgstr "Aura da Tirania"

msgid "CULTURE_DARK@DARK@BIO"
msgstr "Eles buscam poder e frequentemente recorrem à magia sombria e proibida, pouco se importando com o bem‑estar de seu povo."

msgid "CULTURE_DARK@DARK@DESCRIPTION"
msgstr "[bulletlist][bullet/]Unidades agressivas que priorizam dano em vez de defesa e cura.[bullet/]Exploram heróis inimigos derrotados, dependendo da subcultura escolhida.[/bulletlist]"

msgid "CULTURE_DARK@DARK@LORE"
msgstr "[br/][helpcolor]Uma civilização ditatorial onde os fortes e impiedosos dominam os fracos. Eles usam magias proibidas para manter o controle e enfraquecer seus inimigos.[/helpcolor]"

msgid "CULTURE_DARK@DARK@NAME"
msgstr "Sombrio"

msgid "CULTURE_DARK@DARK@TOME_DESCRIPTION"
msgstr "Esta pesquisa está disponível para Governantes da cultura {GLOBAL.DarkConcept.Hyperlink}."

msgid "CULTURE_DARK@DARK_STALWART@DESCRIPTION"
msgstr "No final do turno desta unidade, unidades inimigas adjacentes têm chance base de {SUNDERED_RESISTANCE_RESISTANCE>ResolvedStrength}% de receber:[bulletlist][bullet/]{GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.SUNDERED_RESISTANCE.Hyperlink}[/bulletlist]"

msgid "CULTURE_DARK@DARK_STALWART@NAME"
msgstr "Defensor Sombrio"

msgid "CULTURE_DARK@DARK_SURGE@DESCRIPTION"
msgstr "Causa dano aos inimigos em um cone de {DARK_SURGE_TARGETER>AREA>Length} hexágonos. Causa dano dobrado a unidades com um {GLOBAL.NegativeStatusEffectConcept.Hyperlink}."

msgid "CULTURE_DARK@DARK_SURGE@NAME"
msgstr "Surto Sombrio"

msgid "CULTURE_DARK@DEATHLY_VITALITY@DESCRIPTION"
msgstr "Esta unidade ganha:[bulletlist][bullet/]+{DEATHLY_VITALITY_HEAL_BASELINE>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]+{DEATHLY_VITALITY_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> por cada pilha de {GLOBAL.PROPERTIES.MORTAL_BLESSING.Hyperlink}.[/bulletlist][br/]Esta unidade então entra em {GLOBAL.DefenseModeConcept}."

msgid "CULTURE_DARK@DEATHLY_VITALITY@NAME"
msgstr "Vitalidade Mortífera"

msgid "CULTURE_DARK@DEATHSTALK@DESCRIPTION"
msgstr "Salte sobre a unidade inimiga alvo, empurrando‑a para trás, então entre em {GLOBAL.DefenseModeConcept}."

msgid "CULTURE_DARK@DEATHSTALK@MODIFIER_DESCRIPTION"
msgstr "O dano aumenta com base na perda de <<m:{GLOBAL.HitPointConcept.Hyperlink}>> do alvo."

msgid "CULTURE_DARK@DEATHSTALK@NAME"
msgstr "Perseguição da Morte"

msgid "CULTURE_DARK@DEATH_HEX@DESCRIPTION"
msgstr "A unidade inimiga alvo e outra dentro de {DEATH_HEX_MASTER_JUMP_TARGETER>MaxDistance} hexágonos sofrem dano."

msgid "CULTURE_DARK@DEATH_HEX@MASTER_DESCRIPTION"
msgstr "Hex da Morte:[bulletlist][bullet/]Inflige +{Damage} {GLOBAL.BlightDamageConcept.Hyperlink}[bullet/]Inflige +{Decaying} {GLOBAL.PROPERTIES.DECAYING.Hyperlink}[/bulletlist]"

msgid "CULTURE_DARK@DEATH_HEX@MASTER_NAME"
msgstr "Hex da Morte Campeão"

msgid "CULTURE_DARK@DEATH_HEX@NAME"
msgstr "Hex da Morte"

msgid "CULTURE_DARK@DESPOTIC_VITALITY@DESCRIPTION"
msgstr "No final do turno desta unidade:[bulletlist][bullet/]Cure por {DESPOTIC_VITALITY_MODIFIER>BoostPerUnit} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> por cada unidade inimiga adjacente.[/bulletlist]"

msgid "CULTURE_DARK@DESPOTIC_VITALITY@NAME"
msgstr "Vitalidade Despótica"

msgid "CULTURE_DARK@FATEBRINGER@DESCRIPTION"
