msgstr "Munição: Tiro de Fragmentos"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@PROVINCE_IMPROVEMENT@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{baseamount} {GLOBAL.UnitProductionConcept.Hyperlink}.[bullet/]+{bonusamount} {GLOBAL.UnitProductionConcept.Hyperlink} por cada {GLOBAL.QuarryConcept.Hyperlink} ou {GLOBAL.MineConcept.Hyperlink} adjacente {GLOBAL.ProvinceConcept.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.CONSTRUCT.Hyperlink} Unidades produzidas na cidade do proprietário ganham +{rankamount}[medalGold/] postos.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@PROVINCE_IMPROVEMENT@NAME"
msgstr "[quarry/] Fundição de Guerra"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL1@DESCRIPTION"
msgstr "Um {GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink} blindado com um poderoso canhão de três canos capaz de carregar e disparar projéteis especializados a longo alcance."

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL1@NAME"
msgstr "Blindado^n"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL2@DESCRIPTION"
msgstr "Unidades em um raio de {PINNING_BARRAGE_UNIT_TARGETER_CIRCLE>AREA>Radius} hexágonos:[bulletlist][bullet/]Sofrem {PINNING_BARRAGE_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Tornam‑se {GLOBAL.PROPERTIES.MARKED.Hyperlink}.[bullet/]Têm uma chance base de {IMMOBILIZED_RESISTANCE>ResolvedStrength}% de se tornarem {GLOBAL.PROPERTIES.IMMOBILIZED.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL2@NAME"
msgstr "Barragem de Imobilização"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL3@DESCRIPTION"
msgstr "Concede unidades encantadas:[bulletlist][bullet/]A habilidade {GLOBAL.PROPERTIES.OVERCHARGE_ABILITY.Hyperlink}, que pode conceder a uma unidade {GLOBAL.PROPERTIES.CONSTRUCT.Hyperlink} {GLOBAL.PROPERTIES.OVERCHARGED.Hyperlink} até o fim da batalha.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL3@NAME"
msgstr "Kits de Sintonia"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL3@PROP_DESCRIPTION"
msgstr "Unidade possui:[bulletlist][bullet/]A habilidade {GLOBAL.PROPERTIES.OVERCHARGE_ABILITY.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL4@DESCRIPTION"
msgstr "No início da batalha, ganha {GLOBAL.UNITS.GREAT_BOMBARD_UNIT.Hyperlink} do lado do atacante até o fim da batalha. [bulletlist][bullet/]Grande Bombardeiro é uma unidade {GLOBAL.PROPERTIES.SIEGECRAFT_UNIT.Hyperlink} {GLOBAL.UnitConcept.Hyperlink}.[bullet/] Apenas um tipo de unidade de Cerco pode ser levado para {GLOBAL.CombatConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL4@NAME"
msgstr "Construir Grande Bombardeiro"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL5@DESCRIPTION"
msgstr "Concede unidades encantadas:[bulletlist][bullet/]+{TEMPERED_METALS_DEFENSE>DEF_MOD>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL5@NAME"
msgstr "Metais de Proteção"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL5@PROP_DESCRIPTION"
msgstr "Unidade possui:[bulletlist][bullet/]+{TEMPERED_METALS_DEFENSE>DEF_MOD>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL6@DESCRIPTION"
msgstr "Unidades em raio de {DESTABILIZED_MANA_CORE_CIRCLE_TARGETER_MARKED>AREA>Radius} hexágonos ficam {GLOBAL.PROPERTIES.MARKED.Hyperlink}. Após {time} {GLOBAL.TurnConcept.Hyperlink} o Núcleo de Mana explode infligindo:[bulletlist][bullet/]{amount} {GLOBAL.PhysicalDamageConcept.Hyperlink}[bullet/]{amount2} {GLOBAL.LightningDamageConcept.Hyperlink}.[bullet/]{amount3}% de chance base de receber {GLOBAL.PROPERTIES.DISRUPTION_TOOLTIP_PROPERTY.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL6@FLAG@DESCRIPTION"
msgstr "Este hexágono será atingido por {amount} {GLOBAL.PhysicalDamageConcept.Hyperlink} e {amount} {GLOBAL.LightningDamageConcept.Hyperlink} no início do [turn/][hyperlink,GLOBAL.TurnConcept]Próximo Turno[/hyperlink] do proprietário."

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL6@NAME"
msgstr "Núcleo de Mana Destabilizado"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Invoca o poder das máquinas poderosas e aniquila teus inimigos com barragens poderosas."

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@TOME@LORE_AUTHOR"
msgstr "Edward Portsmith, Último Dreadnought da Commonwealth"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@TOME@LORE_DESCRIPTION"
msgstr "\"As tecnologias Dreadnought são incomparáveis no campo de batalha. Imagine uma fusão de aço e artesanato, dominando tudo em seu caminho. Explosões despedaçam a terra e chovem fogo sobre seus inimigos. Um espetáculo impressionante de se ver. De fato, quando um Blindado avança para a batalha, a luta já está decidida.\""

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@TOME@NAME"
msgstr "Tomo do Dreadnought"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@UNIT2@NAME"
msgstr "Grande Bombardeiro"

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@ABILITY02@DESCRIPTION"
msgstr "Até {MAGICAL_DISRUPTION_COMBAT_UNIT_AUTO_SPELL>MinCastCount} inimigos aleatórios:[bulletlist][bullet/]Sofrem {MAGICAL_DISRUPTION_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Têm uma chance base de {DISRUPTION_RESISTANCE>ResolvedStrength}% de se tornarem {GLOBAL.PROPERTIES.DISRUPTION_TOOLTIP_PROPERTY.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@ABILITY02@NAME"
msgstr "Disrupção Mágica"

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@ABILITY03@DESCRIPTION"
msgstr "[bulletlist][bullet/]Cada unidade amiga dentro de {DISPELLING_FIELD_TARGETER>AREA>Radius} hexágonos tem um de seus <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>> dissipado.[bullet/]Para cada unidade que teve um status dissipado desta forma, esta unidade ganha:[bulletlist][bullet/]{GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} por {STRENGTHENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]{GLOBAL.PROPERTIES.STATUS_PROTECTION.Hyperlink} por {STATUS_PROTECTION_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@ABILITY03@NAME"
msgstr "Campo de Dissipação"

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@HERO_SKILL@DESCRIPTION"
msgstr "Ataques físicos Corpo a Corpo e à Distância ganham {DISRUPTION_RESISTANCE>ResolvedStrength}% de chance de infligir {GLOBAL.PROPERTIES.DISRUPTION_TOOLTIP_PROPERTY.Hyperlink}."

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@HERO_SKILL@NAME"
msgstr "Mestre da Disrupção"

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@SKILL1@DESCRIPTION"
msgstr "Alvo {GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink} {GLOBAL.UnitConcept.Hyperlink}:[bulletlist][bullet/]Tem uma chance base de {ASTRAL_SEVERANCE_RESISTANCE_CHECK>ResolvedStrength}% de ser morto.[bullet/]Se falhar, inflige {GLOBAL.PROPERTIES.DISRUPTION_TOOLTIP_PROPERTY.Hyperlink} e {amount} pilhas de {GLOBAL.PROPERTIES.DECAYING.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@SKILL1@NAME"
msgstr "Corte Astral"

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@SKILL2@COMBAT_PROPERTY_DESCRIPTION"
msgstr "Custo do inimigo <<m:{GLOBAL.SpellConcept.Hyperlink}>> +{amount1}% <<m:{GLOBAL.CombatCastingPointConcept.Hyperlink}>> em {GLOBAL.CombatConcept.Hyperlink} na <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacente a uma estrutura de Barreira de Feitiço."

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@SKILL2@DESCRIPTION"
msgstr "Conjura uma Barreira de Feitiço em um hexágono vazio no {GLOBAL.ProvinceConcept.Hyperlink} alvo. Esta estrutura:[bulletlist][bullet/]Funciona como um {GLOBAL.SpellJammerConcept.Hyperlink} para esta e províncias adjacentes.[bullet/]Fornece visão em raio de {hex} hexágonos.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@SKILL2@NAME"
msgstr "Conjurar Barreira de Feitiço"

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@SKILL2@OPERATION_DESCRIPTION"
msgstr "Destrua a Barreira de Feitiço."

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@SKILL2@OPERATION_NAME"
msgstr "Demolir Barreira de Feitiço"

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@SKILL2@STRUCTURE_DESCRIPTION"
msgstr "[bulletlist][bullet/]Inimigos não podem mirar em <<m:{GLOBAL.WorldMapSpellConcept.Hyperlink}>> nesta e nas províncias adjacentes <<m:{GLOBAL.ProvinceConcept.Hyperlink}>>.[bullet/]Custo do inimigo <<m:{GLOBAL.SpellConcept.Hyperlink}>> +{amount1}% <<m:{GLOBAL.CombatCastingPointConcept.Hyperlink}>> em {GLOBAL.CombatConcept.Hyperlink} nesta e nas províncias adjacentes <<m:{GLOBAL.ProvinceConcept.Hyperlink}>>.[/bulletlist]"

