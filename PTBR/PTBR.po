msgstr "Esses crescimentos grotescos depositam líquido e minério valiosos em velocidade sobrenatural."

msgid "DLC@ELDRITCHREALMS@NODES_STRATEGIC@GOLD_NODE@NAME"
msgstr "Crescimentos Quitinosos"

