msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@ASCENSION_TRAIT@LIVING_SPIDER_NEST@HERO_TRAIT_DESCRIPTION"
msgstr "[bulletlist][bullet/]Quando o total de <<m:{GLOBAL.HitPointConcept.Hyperlink}>> desta unidade atingir {LIVING_SPIDER_NEST_THRESHOLD_60>ResolvedTriggerProportion}% ou menos, conjure um Nível {tier2} {GLOBAL.PROPERTIES.SPIDER.Hyperlink}.[bullet/]Quando o total de <<m:{GLOBAL.HitPointConcept.Hyperlink}>> desta unidade atingir {LIVING_SPIDER_NEST_THRESHOLD_30>ResolvedTriggerProportion}% ou menos, conjure um Nível {tier2} {GLOBAL.PROPERTIES.SPIDER.Hyperlink}.[/bulletlist]{LOC.CONCEPT@SUMMON_LIVE_SHARED}[br/][br/]Permite ainda o alistamento de Aranhas de Nível {tier1} e Nível {tier2} nas cidades."

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@ASCENSION_TRAIT@LIVING_SPIDER_NEST@HERO_TRAIT_NAME"
msgstr "Ascensão: Ninho de Aranha Viva"

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@ASCENSION_TRAIT@LIVING_SPIDER_NEST@NAME"
msgstr "Ninho de Aranha Viva"

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@ASCENSION_TRAIT@OVERLORDS_HUNGER@DESCRIPTION"
msgstr "[bulletlist][bullet/]Ganhe uma pilha permanente de {GLOBAL.PROPERTIES.GORGED.Hyperlink}:[bulletlist][bullet/]No início do combate.[bullet/]Ao matar uma unidade inimiga.[/bulletlist][bullet/]Ao alcançar {amount} pilhas de {GLOBAL.PROPERTIES.GORGED.Hyperlink}, remova-as e:[bulletlist][bullet/]Ganhe uma pilha permanente de {GLOBAL.PROPERTIES.DEMONIC_SATIATION.Hyperlink}.[bullet/]Todas as unidades amigas dentro de {IMPS_HUNGER_CIRCLE>AREA>Radius} hexágonos:[bulletlist][bullet/]Cure {IMPS_HUNGER_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Ganhe {GLOBAL.PROPERTIES.GORGED.Hyperlink} se possuírem {GLOBAL.PROPERTIES.DEMONIC_HUNGER_PROPERTY_GROUP.Hyperlink}.[/bulletlist][/bulletlist][/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@ASCENSION_TRAIT@OVERLORDS_HUNGER@HERO_TRAIT_NAME"
msgstr "Ascensão: Fome do Suserano"

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@ASCENSION_TRAIT@OVERLORDS_HUNGER@NAME"
msgstr "Fome do Suserano"

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@ASCENSION_TRAIT@SPIRIT_CALLER@HERO_TRAIT_DESCRIPTION"
msgstr "No início do combate, invoque um {GLOBAL.UNITS.MORNING_SPRITE.Hyperlink} ou um {GLOBAL.UNITS.EVENING_SPRITE.Hyperlink} que permanece até o final do combate."

