msgid "DLC@GIANTKINGS@DIPLOMACY@CRYSTAL_DWELLING@ETERNAL_PACT@DESCRIPTION"
msgstr "[bulletlist][bullet/]A {GLOBAL.DwellingConcept.Hyperlink} compartilha sua visão.[bullet/]Desbloqueia a compra dos seguintes itens comerciais via Cooperação:[bulletlist][bullet/]{GLOBAL.TOKENDEFINITION.LITHORITE_ASTROLABE_ARTIFACT.Hyperlink}[bullet/]{GLOBAL.STRUCTURE_UPGRADES.ETERNAL_EMBASSY.Hyperlink}[bullet/]{GLOBAL.UNITS.LITHORINE_SIMULACRUM.Hyperlink}[bullet/]{GLOBAL.EQUIPMENT.ETERNAL_GOLDSEEKERS_PICKAXE.Hyperlink}[bullet/]{GLOBAL.EQUIPMENT.ETERNAL_LITHORINE_ORB.Hyperlink}[bullet/]{GLOBAL.EQUIPMENT.ETERNAL_SHATTERBLADES.Hyperlink}[bullet/]{GLOBAL.EQUIPMENT.ETERNAL_TITANS_GREATBOW.Hyperlink}[/bulletlist][bullet/]Completar missões de habitação garante recompensas garantidas de {GLOBAL.ImperiumConcept.Hyperlink} além de outras recompensas.[bullet/]A {GLOBAL.DwellingConcept.Hyperlink} concede um considerável benefício de renda de {GLOBAL.KnowledgeConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@DIPLOMACY@CRYSTAL_DWELLING@ETERNAL_PACT@HYPERLINK"
msgstr "[rs_eternal/] [hyperlink,GLOBAL.CrystalDwellingEternalPactConcept]Pacto Eterno[/hyperlink]"

msgid "DLC@GIANTKINGS@DIPLOMACY@CRYSTAL_DWELLING@ETERNAL_PACT@NAME"
msgstr "Pacto Eterno"

msgid "DLC@GIANTKINGS@DIPLOMACY@CRYSTAL_DWELLING@STONE_PACT@DESRCIPTION"
msgstr "[bulletlist][bullet/]A {GLOBAL.CrystalDwellingConcept.Hyperlink} abre suas fronteiras.[bullet/]Desbloqueia a compra dos seguintes itens comerciais via Cooperação:[bulletlist][bullet/]{GLOBAL.TOKENDEFINITION.LITHORITE_SCROLL_ARTIFACT.Hyperlink}[bullet/]{GLOBAL.UNITS.LITHORINE_NEEDLER.Hyperlink}[bullet/]{GLOBAL.EQUIPMENT.GOLDSEEKERS_PICKAXE.Hyperlink}[bullet/]{GLOBAL.EQUIPMENT.LITHORITE_ORB.Hyperlink}[bullet/]{GLOBAL.EQUIPMENT.SHATTER_BLADES.Hyperlink}[bullet/]{GLOBAL.EQUIPMENT.TITANS_GREATBOW.Hyperlink}[/bulletlist][bullet/]Completar missões de Moradia recompensa itens de herói garantidos além de suas outras recompensas.[/bulletlist]"

msgid "DLC@GIANTKINGS@DIPLOMACY@CRYSTAL_DWELLING@STONE_PACT@HYPERLINK"
msgstr "[rs_stone/] [hyperlink,GLOBAL.CrystalDwellingStonePactConcept]Pacto de Pedra[/hyperlink]"

msgid "DLC@GIANTKINGS@DIPLOMACY@CRYSTAL_DWELLING@STONE_PACT@NAME"
msgstr "Pacto de Pedra"

msgid "DLC@GIANTKINGS@DIPLOMACY@CRYSTAL_DWELLING@TRUCE@DESCRIPTION"
msgstr "A {GLOBAL.CrystalDwellingConcept.Hyperlink} tolera você.[br/][br/]É considerado estado {GLOBAL.IndependentCityNeutralConcept.Hyperlink}.[br/][br/]Moradias de Cristal não se importam com Reivindicações de Província.[br/][br/]Você não pode atribuir um {GLOBAL.DiplomaticTokenConcept.Hyperlink} às Moradias de Cristal. Em vez disso, completar missões permitirá alcançar estados diplomáticos superiores e, eventualmente, um {GLOBAL.CrystalDwellingEternalPactConcept.Hyperlink}.[br/][br/]Desbloqueia a compra dos seguintes itens comerciais via Cooperação:[br/][bulletlist][bullet/]{GLOBAL.UNITS.LITHORINE_CORE.Hyperlink}[bullet/]{GLOBAL.EQUIPMENT.CRYSTALRUNNER_MOUNT.Hyperlink}[/bulletlist]"

msgid "DLC@GIANTKINGS@DIPLOMACY@CRYSTAL_DWELLING@TRUCE@HYPERLINK"
msgstr "[rs_neutral/] [hyperlink,GLOBAL.CrystalDwellingTruceConcept]Trégua[/hyperlink]"

msgid "DLC@GIANTKINGS@DIPLOMACY@CRYSTAL_DWELLING@TRUCE@NAME"
msgstr "Trégua"

msgid "DLC@GIANTKINGS@DIPLOMACY@HOUSE_DIPLOMATIC_STATE@CRYSTAL_DWELLING_DECLARE_WAR"
msgstr "Um {GLOBAL.CrystalDwellingConcept.Name} declarou guerra contra você"

msgid "DLC@GIANTKINGS@DIPLOMACY@HOUSE_INFLUENCE_BOOST@CRYSTAL_DWELLING@DESCRIPTION"
msgstr "Interaja com a {GLOBAL.CrystalDwellingConcept.Hyperlink} para iniciar uma missão que conquiste seu {GLOBAL.HouseInfluenceConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@DISPLAYDESCRIPTION"
msgstr "Restaure os Gigantes Anciões ao seu lugar legítimo como mestres do Mar Astral. Explore as ruínas de seu império caído, busque a magia cristalina esquecida para fortalecer seus exércitos e mergulhe nas profundezas em busca de tesouros perdidos."

