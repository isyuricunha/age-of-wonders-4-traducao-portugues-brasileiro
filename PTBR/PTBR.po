msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_OVERLORD@NAME"
msgstr "Você se torna suserano "

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_RETURNCAPTUREDHEROES@DESCRIPTION"
msgstr "Quando <<m:{GLOBAL.HeroConcept.Hyperlink}>> capturados são devolvidos ao seu dono original, eles ficarão disponíveis para recrutamento (gratuitamente). Heróis no {GLOBAL.CryptConcept.Hyperlink} serão devolvidos à cripta do dono original.[br/][br/]Ao alcançar um {GLOBAL.DSAllianceConcept.Hyperlink}, <<m:{GLOBAL.LeaderConcept.Hyperlink}>> devolverá automaticamente seus heróis capturados ao outro Governante."

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_RETURNCAPTUREDHEROES@DESCRIPTION_TRADE"
msgstr "Ambos os lados [hyperlink,GLOBAL.ReturnCapturedHeroesConcept]devolverão seus heróis capturados[/hyperlink]."

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_RETURNCAPTUREDHEROES@HYPERLINK"
msgstr "[hyperlink,GLOBAL.ReturnCapturedHeroesConcept]devolver heróis capturados[/hyperlink]."

