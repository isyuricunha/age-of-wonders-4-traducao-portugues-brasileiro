msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_02@NAME"
msgstr "Arremessar Rocha Grande"

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_03@COMBAT_DESCRIPTION"
msgstr "Unidades aliadas do dono deste efeito ganham:[bulletlist][bullet/]Se esta unidade atacou, no final do turno elas ganham uma pilha de {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} e {GLOBAL.PROPERTIES.NATURES_MIGHT.Hyperlink} por {NATURES_MIGHT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_03@DESCRIPTION"
msgstr "Enquanto esta unidade estiver em batalha, todas as unidades aliadas ganham:[bulletlist][bullet/]Se esta unidade atacou, no final do turno elas ganham uma pilha de {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} e {GLOBAL.PROPERTIES.NATURES_MIGHT.Hyperlink} por {NATURES_MIGHT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_03@NAME"
msgstr "Força Primordial"

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_03@PROP_DESCRIPTION"
msgstr "Se esta unidade atacou, no final do turno elas ganham uma pilha de {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} e {GLOBAL.PROPERTIES.NATURES_MIGHT.Hyperlink} por {NATURES_MIGHT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_04@DESCRIPTION"
msgstr "Causa dano à unidade alvo e a até {BLIGHT_COIL_JUMP_TARGETER>MaxJumps} outros inimigos em até {BLIGHT_COIL_JUMP_TARGETER>MaxDistance} hexes."

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_04@NAME"
msgstr "Espiral da Praga"

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_05@DESCRIPTION"
msgstr "Unidades inimigas em um raio de {DOOM_GAZE_UNIT_TARGETER_CIRCLE>AREA>Radius} hexes sofrem dano."

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_05@ENHANCED_DESCRIPTION"
msgstr "Olhar do Fim:[bulletlist][bullet/]Causa um adicional de {DOOMGAZE_ENHANCED_DAMAGE>DAMAGE>Blight}{GLOBAL.BlightDamageConcept.Hyperlink}[bullet/]Tem garantia de infligir {GLOBAL.PROPERTIES.STUNNED.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_05@ENHANCED_NAME"
msgstr "Olhar do Fim Aprimorado"

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_05@MASTER_DESCRIPTION"
msgstr "Olhar da Perdição:[bulletlist][bullet/]Afeta um raio de {DOOMGAZE_MASTER_TARGETER>AREA>Radius} hexes.[/bulletlist]"

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_05@MASTER_NAME"
msgstr "Olhar da Perdição do Campeão"

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_05@NAME"
msgstr "Olhar da Perdição"

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_06@DESCRIPTION"
msgstr "A unidade inimiga não-herói alvo tem uma chance base de {SERPENTINE_CURSE_RESISTANCE_CHECK>ResolvedStrength}% de se transformar em um(a) {GLOBAL.UNITS.PLAGUE_SERPENT.Hyperlink} sob o controle do conjurador.[br/][br/]Não pode ser usado em batalhas aquáticas."

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_06@NAME"
msgstr "Maldição Serpentina"

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_07@COMBAT_DESCRIPTION"
msgstr "Unidades aliadas do dono deste efeito ganham:[bulletlist][bullet/]Uma chance de {BOON_STEALING_RESISTANCE_CHECK>ResolvedStrength}% de roubar um(a) {GLOBAL.PositiveStatusEffectConcept.Hyperlink}.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_07@DESCRIPTION"
msgstr "Enquanto esta unidade estiver em batalha, todos os ataques de unidades aliadas ganham:[bulletlist][bullet/]Uma chance de {BOON_STEALING_RESISTANCE_CHECK>ResolvedStrength}% de roubar um(a) {GLOBAL.PositiveStatusEffectConcept.Hyperlink}.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_07@NAME"
msgstr "Inveja Primordial"

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_07@PROP_DESCRIPTION"
msgstr "Os ataques desta unidade têm uma chance de {BOON_STEALING_RESISTANCE_CHECK>ResolvedStrength}% de roubar um(a) {GLOBAL.PositiveStatusEffectConcept.Hyperlink}.[br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_08@NAME"
msgstr "Explosão de Escamas Flamejantes"

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_09@DESCRIPTION"
msgstr "Consome todas as pilhas de {GLOBAL.PROPERTIES.BURNING.Hyperlink} da unidade inimiga alvo.[bulletlist][bullet/]Para cada pilha consumida, o inimigo sofre {REJUVENATING_FLAMES_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Unidades aliadas em um raio de 2 hexes do alvo:[bulletlist][bullet/]Recuperam {REJUVENATING_FLAMES_FRIENDLY_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Ganham uma pilha de {GLOBAL.PROPERTIES.REGENERATION.Hyperlink} por {REGENERATION_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][/bulletlist]"

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_09@NAME"
msgstr "Chamas Rejuvenescedoras"

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_10@COMBAT_DESCRIPTION"
msgstr "Unidades aliadas do dono deste efeito ganham:[bulletlist][bullet/]Uma vez por turno, quando esta unidade for atingida por um ataque, o atacante ganha uma pilha de {GLOBAL.PROPERTIES.BURNING.Hyperlink} por {BURNING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_10@DESCRIPTION"
msgstr "Enquanto esta unidade estiver em batalha, todas as unidades aliadas ganham:[bulletlist][bullet/]Uma vez por turno, quando esta unidade for atingida por um ataque, o atacante ganha uma pilha de {GLOBAL.PROPERTIES.BURNING.Hyperlink} por {BURNING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_10@NAME"
msgstr "Orgulho Primordial"

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_10@PROP_DESCRIPTION"
msgstr "Uma vez por turno, quando esta unidade for atingida por um ataque, o atacante ganha uma pilha de {GLOBAL.PROPERTIES.BURNING.Hyperlink} por {BURNING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_11@DESCRIPTION"
msgstr "Causa dano a unidades inimigas em um raio de {BURNING_DUST_OBSTACLE_TARGETER_CIRCLE>AREA>Radius} hexes."

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_11@DESCRIPTION_CHAMPION"
msgstr "Poeira Flamejante:[bulletlist][bullet/]Causa {BURNING_DAMAGE_OVER_TIME>ATTACK>Fire}{GLOBAL.FireDamageConcept.Hyperlink} adicionais.[bullet/]Inflige uma pilha adicional de {GLOBAL.PROPERTIES.BURNING.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_11@NAME"
msgstr "Poeira Flamejante"

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_11@NAME_CHAMPION"
msgstr "Poeira Flamejante do Campeão"

msgid "DLC@GIANTKINGS@RACE_NAMES@RACE1@NAME"
msgstr "Povo da Terra"

