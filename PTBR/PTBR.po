msgid "DLC@THRONESOFBLOOD@TOME_BLOOD_RITE@BLOOD_CULTIST@NAME"
msgstr "Cultista Sanguinário^m"

msgid "DLC@THRONESOFBLOOD@TOME_BLOOD_RITE@GAMEPLAY_DESCRIPTION"
msgstr "Realize ritos proibidos e perigosos em suas unidades para enfraquecer seus inimigos e fortalecer seus aliados."

msgid "DLC@THRONESOFBLOOD@TOME_BLOOD_RITE@LORE_DESCRIPTION"
msgstr "\"Ritos proibidos em uma língua esquecida, pergaminhos queimados de um reino erguido sobre sangue e sacrifício. Estas são as memórias daquele a quem agora chamamos de Deus Imortal. Seus princípios — agora Ele os sussurra em minha mente, como palavras a serem gravadas em nossa carne. Pois cada dádiva que Ele concede exige um preço. E esse preço é sangue.\""

msgid "DLC@THRONESOFBLOOD@TOME_BLOOD_RITE@NAME"
msgstr "Tomo do Rito Sangrento"

msgid "DLC@THRONESOFBLOOD@TOME_BLOOD_RITE@SKILL1@DESCRIPTION"
msgstr "A unidade aliada alvo sustenta {RITE_OF_LIFE_LEECHING_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink} imparável. Então, todas as unidades aliadas adjacentes ganham:[bulletlist][bullet/]{GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} por {STRENGTHENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]{GLOBAL.PROPERTIES.NEW_LIFE_STEAL.Hyperlink} por {RITE_OF_LIFE_LEECHING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_BLOOD_RITE@SKILL1@NAME"
