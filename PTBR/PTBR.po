msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_OFFER_ENDWAR_WINNING_VASSALAGE"
msgstr "\"Você perdeu esta guerra {HouseALord.Name}, mas não desejo lançá-lo ao vazio. Ajoelhe‑se e una‑se a mim na glória!\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_OFFER_FAIR_DEFAULT"
msgstr "\"{HouseALord.Name}, você teria interesse em um comércio? Parece-me uma proposta justa.\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_OFFER_REQUEST_DEFAULT"
