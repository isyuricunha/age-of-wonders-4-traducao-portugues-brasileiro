msgid "TOME_ASTRAL_CONVERGENCE@SKILL3@NAME"
msgstr "Acúmulo Arcano"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL3@PROPERTY@DESCRIPTION"
msgstr "A cada turno em combate, até {amount} inimigos aleatórios:[bulletlist][bullet/]Se tornam {GLOBAL.PROPERTIES.ELECTRIFIED.Hyperlink}.[bullet/]Sofrem {damage} {GLOBAL.FireDamageConcept.Hyperlink}, {damage} {GLOBAL.LightningDamageConcept.Hyperlink} ou {damage} {GLOBAL.FrostDamageConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL4@DESCRIPTION"
msgstr "Alvo {GLOBAL.ProvinceConcept.Hyperlink}:[bulletlist][bullet/]Se contiver uma unidade inimiga {GLOBAL.ProvinceImprovementConcept.Hyperlink} e nenhum {GLOBAL.AncientWonderConcept.Hyperlink}, torna-se ruínas.[bullet/]Invoca um poderoso {GLOBAL.ArmyConcept.Hyperlink} errante do Mar Astral de <<m:{GLOBAL.UnitConcept.Hyperlink}>>.[/bulletlist]"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL4@NAME"
msgstr "Fragmentação Astral"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL5@DESCRIPTION"
