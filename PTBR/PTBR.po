msgid "DIPLOMACY@PRESSURE@LEVEL_1"
msgstr "À vontade"

msgid "DIPLOMACY@PRESSURE@LEVEL_1_DESCRIPTION"
msgstr "O {GLOBAL.LeaderConcept.Hyperlink} sente confiança em relação ao seu {GLOBAL.EmpireConcept.Hyperlink}, o que afeta suas [hyperlink,GLOBAL.EmpireRelationConcept]Relações[/hyperlink] com ele em {RelationValue}[goodRelation/]."

