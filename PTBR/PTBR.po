msgid "DLC@GIANTKINGS@META_EMPIRE@REALM_MYRRIDA@NAME_05"
msgstr "Caminho dos Antigos"

msgid "DLC@GIANTKINGS@META_EMPIRE@REALM_MYRRIDA@SUBTITLE"
msgstr "Um reino outrora governado pelos <<m:{GLOBAL.GiantKingLoreConcept.Hyperlink}>> de {GLOBAL.MyrridaLoreConcept.Hyperlink}, seus antigos salões subterrâneos esperando para serem redescobertos."

msgid "DLC@GIANTKINGS@META_EMPIRE@REALM_MYRRIDA@TEMPLATE_NAME"
msgstr "Vestígios de Myrrida"

msgid "DLC@GIANTKINGS@MINORFACTIONS_WORLD@ETERNALS_RACE@BIO_1"
msgstr "Nas eras de {GLOBAL.MyrridaLoreConcept.Hyperlink}, os <<m:{GLOBAL.GiantKingLoreConcept.Hyperlink}>> governavam os reinos que remodelaram em todos os cantos do {GLOBAL.AstralSeaLoreConcept.Hyperlink}. Mas sua remodelação não terminou com o terreno, pois também modificaram os habitantes dos reinos que os Gigantes dominavam, infundindo-os com cristais especiais que tornavam seus corpos mortais imortais. Os Gigantes Anciões mais tarde usariam esses mesmos cristais para armazenar memórias e emoções. Desde a queda de Myrrida, os {GLOBAL.EternalSagesLoreConcept.Hyperlink} que restam são governados por Conselhos Eternos."

msgid "DLC@GIANTKINGS@MINORFACTIONS_WORLD@ETERNALS_RACE@NAME_1"
msgstr "Sentinelas Siäldryh"

msgid "DLC@GIANTKINGS@MINOR_FACTION@UPGRADE_SET@CRYSTAL@DESCRIPTION"
msgstr "Estes são os servidores do {GLOBAL.EternalSagesLoreConcept.Hyperlink}. Seus corpos foram aprimorados com cristais mágicos que fortalecem o corpo e impregnam a mente com memórias de Gigantes há muito desaparecidos."

msgid "DLC@GIANTKINGS@OBELISK@BONE@NAME"
msgstr "Obelisco de Ossos^n"

msgid "DLC@GIANTKINGS@OBELISK@STORM@NAME"
