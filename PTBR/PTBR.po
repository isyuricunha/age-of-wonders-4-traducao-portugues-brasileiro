msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@DEMORALIZED_DEFENDERS@DESCRIPTION"
msgstr "No início do combate, todas as unidades defensoras recebem {numberOfStacks} pilhas de {GLOBAL.PROPERTIES.DEMORALIZED.Hyperlink} até o fim do combate."

