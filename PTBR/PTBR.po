msgid "TOME_SCRYING@TOME@LORE_DESCRIPTION"
msgstr "\"Desperte o olho da mente para enxergar além do reino físico. Segredos próximos e distantes se revelarão, e os verdadeiramente observadores poderão até mesmo vislumbrar o futuro imediato! A expressão de choque do seu inimigo quando você esquiva habilmente do ataque deles antes mesmo de ser lançado é realmente uma visão impressionante.\""

msgid "TOME_SCRYING@TOME@NAME"
msgstr "Tomo da Vidência"

msgid "TOME_SCRYING@UNIT@NAME"
msgstr "Vigia^n"

msgid "TOME_SCRYING@UNIT_ABILITY@DESCRIPTION"
msgstr "A unidade inimiga alvo sofre dano."

msgid "TOME_SCRYING@UNIT_ABILITY@DESCRIPTION_2"
msgstr "Unidade inimiga alvo e outra a até {amount} hexes sofrem dano."

msgid "TOME_SCRYING@UNIT_ABILITY@ENHANCED_DESCRIPTION"
msgstr "Olhar Psíquico:[bulletlist][bullet/]Causa {PSYCHIC_GAZE_ENHANCED_DAMAGE>DAMAGE>Shock} adicional de {GLOBAL.LightningDamageConcept.Hyperlink}.[bullet/]Tem {STUNNED_RESISTANCE>ResolvedStrength}% de chance de infligir {GLOBAL.PROPERTIES.STUNNED.Hyperlink}.[/bulletlist]"

msgid "TOME_SCRYING@UNIT_ABILITY@ENHANCED_NAME"
msgstr "Olhar Psíquico Aprimorado"

msgid "TOME_SCRYING@UNIT_ABILITY@MASTER_DESCRIPTION"
msgstr "Olhar Psíquico:[bulletlist][bullet/]Tem {STUNNED_RESISTANCE>ResolvedStrength}% de chance base de aplicar {GLOBAL.PROPERTIES.STUNNED.Hyperlink}.[bullet/]Aplica uma pilha adicional de {GLOBAL.PROPERTIES.MARKED.Hyperlink}.[/bulletlist]"

msgid "TOME_SCRYING@UNIT_ABILITY@MASTER_NAME"
msgstr "Olhar Psíquico do Campeão"

msgid "TOME_SCRYING@UNIT_ABILITY@NAME"
msgstr "Olhar Psíquico"

msgid "TOME_SCRYING@UNIT_ABILITY_2@DESCRIPTION"
msgstr "A unidade é imune a {GLOBAL.FlankingConcept.Hyperlink} e imune a se tornar {GLOBAL.PROPERTIES.DISTRACTED.Hyperlink}."

msgid "TOME_SCRYING@UNIT_ABILITY_2@NAME"
