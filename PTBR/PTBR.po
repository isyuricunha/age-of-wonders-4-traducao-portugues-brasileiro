msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@ELEMENTAL_FRAGILITY@DESCRIPTION"
msgstr "A primeira vez que cada unidade defensiva {GLOBAL.PROPERTIES.ELEMENTAL.Hyperlink} {GLOBAL.UnitConcept.Hyperlink} cai abaixo de {percent} de seus <<m:{GLOBAL.HitPointConcept.Hyperlink}>>:[bulletlist][bullet/]A Unidade se teletransporta até {hex} hexes longe dos atacantes.[bullet/]A Unidade se transforma em uma Unidade Elemental aleatória.[bullet/]A Unidade sofre {stack} {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink}.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@ELEMENTAL_FRAGILITY@NAME"
msgstr "Elemental Fragility"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@ELEMENTAL_MAYHEM@DESCRIPTION"
msgstr "A primeira vez que cada unidade defensiva {GLOBAL.PROPERTIES.ELEMENTAL.Hyperlink} {GLOBAL.UnitConcept.Hyperlink} cai abaixo de {percent} de seus <<m:{GLOBAL.HitPointConcept.Hyperlink}>>:[bulletlist][bullet/]A Unidade se teletransporta até {hex} hexes longe dos atacantes.[bullet/]A Unidade se transforma em uma Unidade Elemental de Nível 1 aleatória.[bullet/]A Unidade é curada em {hp} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>[/bulletlist]"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@ELEMENTAL_MAYHEM@NAME"
msgstr "Elemental Mayhem"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@FADING_SOULS@DESCRIPTION"
msgstr "A cada {turn} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, todos os corpos das unidades defensivas <<m:{GLOBAL.UnitConcept.Hyperlink}>> são ressuscitados como um {GLOBAL.UNITS.PHANTASM_WARRIOR_UNIT.Hyperlink} que morre após {turn} [turn/] Turnos."

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@FADING_SOULS@NAME"
msgstr "Fading Souls"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@FRACTURING_DRAGON@DESCRIPTION"
msgstr "O {GLOBAL.UNITS.FRACTURED_DRAGON.Hyperlink} defensor deixa para trás Fraturas de Mana em cada hex alvo de seus ataques. Fraturas de Mana têm {GLOBAL.DrainingConcept.Hyperlink} e se espalham para um hex adjacente toda vez que uma Magia é lançada."

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@FRACTURING_DRAGON@NAME"
msgstr "Fracturing Wake"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@FRIENDLY_FIRE_WORM@DESCRIPTION"
msgstr "A cada {turn} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, um raio de {radius} hexes próximo a uma unidade defensiva fica marcado por tremores.[bulletlist][bullet/]Todas as unidades atacantes <<m:{GLOBAL.UnitConcept.Hyperlink}>> sem {GLOBAL.PROPERTIES.FLYING_MOVEMENT.Hyperlink}, {GLOBAL.PROPERTIES.FLOATING_MOVEMENT.Hyperlink} ou {GLOBAL.PROPERTIES.SAND_WALK.Hyperlink} no raio sofrem {GLOBAL.PROPERTIES.SLOWED.Hyperlink} por {turn2} [turn/] Turno.[bullet/]No final do próximo Turno, todas as Unidades ainda dentro do raio são mortas.[bulletlist][bullet/]Unidades mortas dessa forma ignoram {GLOBAL.PROPERTIES.RESURGENCE.Hyperlink} e {GLOBAL.PROPERTIES.STEADFAST.Hyperlink} e não deixam um corpo para trás.[bullet/]O Líder da Expedição ainda é revivido com {hp} {GLOBAL.HitPointConcept.Hyperlink} se seu lado for vitorioso na batalha.[/bulletlist][/bulletlist]"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@FRIENDLY_FIRE_WORM@NAME"
msgstr "Agitated Tremors"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@GIANT_WORM@DESCRIPTION"
msgstr "A cada {turn} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, um raio de {radius} hexes próximo a uma unidade atacante fica marcado por tremores.[bulletlist][bullet/]Todas as unidades atacantes <<m:{GLOBAL.UnitConcept.Hyperlink}>> sem {GLOBAL.PROPERTIES.FLYING_MOVEMENT.Hyperlink}, {GLOBAL.PROPERTIES.FLOATING_MOVEMENT.Hyperlink} ou {GLOBAL.PROPERTIES.SAND_WALK.Hyperlink} no raio sofrem {GLOBAL.PROPERTIES.SLOWED.Hyperlink} por {turn2} [turn/] Turno.[bullet/]No final do próximo [turn/] Turno, todas as Unidades ainda dentro do raio são mortas.[bulletlist][bullet/]Unidades mortas dessa forma ignoram {GLOBAL.PROPERTIES.RESURGENCE.Hyperlink} e {GLOBAL.PROPERTIES.STEADFAST.Hyperlink} e não deixam um corpo para trás.[bullet/]O Líder da Expedição ainda é revivido com {hp} {GLOBAL.HitPointConcept.Hyperlink} se seu lado for vitorioso na batalha.[/bulletlist][/bulletlist]"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@GIANT_WORM@DESCRIPTION_TSR"
msgstr "A cada {turn} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, um raio de {radius} hexes próximo a uma unidade atacante fica marcado por tremores.[bulletlist][bullet/]Todas as unidades atacantes <<m:{GLOBAL.UnitConcept.Hyperlink}>> sem {GLOBAL.PROPERTIES.FLYING_MOVEMENT.Hyperlink}, {GLOBAL.PROPERTIES.FLOATING_MOVEMENT.Hyperlink} ou {GLOBAL.PROPERTIES.SAND_WALK.Hyperlink} no raio sofrem {GLOBAL.PROPERTIES.SLOWED.Hyperlink} por {turn2} [turn/] Turno.[bullet/]No final do próximo [turn/] Turno, todas as Unidades ainda dentro do raio são mortas.[bulletlist][bullet/]Unidades mortas dessa forma ignoram {GLOBAL.PROPERTIES.RESURGENCE.Hyperlink} e {GLOBAL.PROPERTIES.STEADFAST.Hyperlink} e não deixam um corpo para trás.[/bulletlist][/bulletlist]"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@GIANT_WORM@NAME"
msgstr "Gargantuan Tremors"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@MOVING_SANDSTORMS@DESCRIPTION"
msgstr "A cada {turns} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, várias tempestades de areia com raio de {hex} hexes são geradas em locais aleatórios.[bulletlist][bullet/]<<m:{GLOBAL.UnitConcept.Hyperlink}>> sem {GLOBAL.PROPERTIES.SAND_WALK.Hyperlink} sofrem {GLOBAL.PROPERTIES.SLOWED.Hyperlink} e têm {chance} de sofrer {GLOBAL.PROPERTIES.BLINDED.Hyperlink} por {turn} [turn/] Turno ao passar ou terminar seu Turno em uma Tempestade de Areia.[bullet/]Tempestades de Areia duram {turns} [turn/] Turnos.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@MOVING_SANDSTORMS@NAME"
msgstr "Creeping Sandstorms"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@REJUVINATING_SOULS@DESCRIPTION"
msgstr "A cada {turn} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, todos os cadáveres das unidades defensivas <<m:{GLOBAL.UnitConcept.Hyperlink}>> são ressuscitados como um {GLOBAL.UNITS.PHANTASM_WARRIOR_UNIT.Hyperlink}. Quando isso acontece, todas as unidades atacantes dentro de um raio de {radius}-hex do cadáver são curadas em {heal} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>."

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@REJUVINATING_SOULS@NAME"
msgstr "Almas Rejuvenescidas"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@SABOTAGED_CONSTRUCTS@DESCRIPTION"
msgstr "Todas as unidades defensivas {GLOBAL.PROPERTIES.CONSTRUCT.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> sofrem {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink} por {turn} <<m:{GLOBAL.TurnConcept.Hyperlink}>>. Todas as unidades defensivas não-Construtos sofrem {GLOBAL.PROPERTIES.DEMORALIZED.Hyperlink} por {turn} [/turn] Turnos em vez disso."

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@SABOTAGED_CONSTRUCTS@NAME"
msgstr "Construtos Sabotados"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@STATIC_SANDSTORMS@DESCRIPTION"
msgstr "Várias tempestades de areia com raio de {hex}-hex estão presentes na batalha.[bulletlist][bullet/]<<m:{GLOBAL.UnitConcept.Hyperlink}>> sem {GLOBAL.PROPERTIES.SAND_WALK.Hyperlink} sofrem {GLOBAL.PROPERTIES.SLOWED.Hyperlink} e têm {chance} de sofrer {GLOBAL.PROPERTIES.BLINDED.Hyperlink} por {turn} {GLOBAL.TurnConcept.Hyperlink} ao passar por ou terminar seu turno em uma Tempestade de Areia.[bullet/]Essas tempestades de areia não se movem e permanecem em suas posições até o final da batalha.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@STATIC_SANDSTORMS@NAME"
msgstr "Tempestades de Areia Estáticas"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@TAUNTED_DRAGON@DESCRIPTION"
msgstr "O Dragão Fraturado defensivo é provocado pelo {GLOBAL.PROPERTIES.EXPEDITION_LEADER.Hyperlink} atacante até o final da batalha!"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@TAUNTED_DRAGON@NAME"
msgstr "Provocação do Dragão Fraturado"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@UNDYING_SOULS@DESCRIPTION"
msgstr "A cada {turn} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, todos os cadáveres das unidades defensivas <<m:{GLOBAL.UnitConcept.Hyperlink}>> são ressuscitados como <<m:{GLOBAL.UNITS.PHANTASM_WARRIOR_UNIT.Hyperlink}>>."

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@UNDYING_SOULS@NAME"
msgstr "Almas Imortais"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@VOLATILE_CONSTRUCTS@DESCRIPTION"
msgstr "Construtos defensivos {GLOBAL.PROPERTIES.CONSTRUCT.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> explodem ao morrer, causando {damage} {GLOBAL.FireDamageConcept.Hyperlink} a todas as unidades defensivas adjacentes."

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@VOLATILE_CONSTRUCTS@NAME"
msgstr "Construtos Voláteis"

msgid "DLC@RISEFROMRUIN@CRISIS@1171_4502@SUB_HEADER"
msgstr "Encontre uma das Regiões Fadadas."

msgid "DLC@RISEFROMRUIN@CRISIS@1171_4503@DESCRIPTION"
msgstr "Os {GLOBAL.FracturingWindsConcept.Hyperlink} uivam no ar e trarão o <<m:{GLOBAL.CataclysmConcept.Hyperlink}>> quando muitas <<m:{GLOBAL.WorldMapSpellConcept.Hyperlink}>> forem lançadas. Talvez, ao encontrar as origens desse fenômeno, você pudesse se proteger contra ele ou até mesmo usá-lo como arma."

msgid "DLC@RISEFROMRUIN@CRISIS@1171_4503@NAME"
msgstr "Os Ventos Devoradores"

msgid "DLC@RISEFROMRUIN@CRISIS@1224_1337@DESCRIPTION"
msgstr "Duas facções lutam pelo controle do oásis subterrâneo. Uma tribo nômade busca erradicar aqueles que envenenam a terra, a água e seu povo—enquanto uma tribo de párias fraturados luta para defender o que consideram terra sagrada."

msgid "DLC@RISEFROMRUIN@CRISIS@1224_1337@NAME"
msgstr "Lago do Grande Vermis"

msgid "DLC@RISEFROMRUIN@CRISIS@1224_1337@SUB_HEADER"
msgstr "Uma batalha feroz está ocorrendo no Lago do Grande Vermis."

msgid "DLC@RISEFROMRUIN@CRISIS@1252_70@DESCRIPTION"
msgstr "As Colinas Fantasma são pontilhadas com os acampamentos de guerra de um exército fantasmagórico. Seus estandartes ondulantes falam de uma época em que campeões ousados marchavam sobre as cidades dos {GLOBAL.UnmakersLoreConcept.Hyperlink} para proteger o reino de seus perigosos experimentos arcanos."

msgid "DLC@RISEFROMRUIN@CRISIS@1252_70@NAME"
msgstr "Colinas Fantasma"

msgid "DLC@RISEFROMRUIN@CRISIS@1252_70@SUB_HEADER"
msgstr "O exército de um {TSR_WARLORD} espectral permanece nesta região..."

msgid "DLC@RISEFROMRUIN@CRISIS@FRACTURING_WINDS@PHASE2@DESCRIPTION"
msgstr "Os {GLOBAL.FracturingWindsConcept.Hyperlink} parecem ter sido criados acidentalmente através da arrogância desses chamados {GLOBAL.UnmakersLoreConcept.Hyperlink}. Agora há muito tempo desaparecidos, alguns de seus <<m:{GLOBAL.ArtifactConcept.Hyperlink}>> permanecem nas Regiões Fadadas espalhadas pelo reino.[br/][br/]Esses Artefatos provam ser capazes de manipular e parcialmente controlar os Ventos Devoradores.[br/][br/]Coletar o suficiente deles e canalizá-los por um tempo permitirá armar os ventos, resultando em uma vitória decisiva para quem os empunhar, pois poderão restaurar ou dispersar o reino à vontade."

msgid "DLC@RISEFROMRUIN@CRISIS@TSR_RFR_CM@DESCRIPTION"
msgstr "Vozes criadas pelos Ventos Devoradores assombram esta área, onde a energia {GLOBAL.FractureLoreConcept.Hyperlink} é tão volátil que o ar crepita com ela. As vozes pedem que você se aproxime das Fracturas, prometendo conhecimento inimaginável."

msgid "DLC@RISEFROMRUIN@CRISIS@TSR_RFR_CM@NAME"
msgstr "Meseta Crepitante"

msgid "DLC@RISEFROMRUIN@CRISIS@TSR_RFR_CM@SUB_HEADER"
msgstr "Os Ventos Devoradores sussurram promessas de conhecimento."

