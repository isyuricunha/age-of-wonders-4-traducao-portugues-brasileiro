msgstr "Ganhe {GLOBAL.PROPERTIES.DUNGEON_KEEPER_AUTO_SPELL.Hyperlink}."

msgid "DLC@GIANTKINGS@META_EMPIRE@ASCENSION_TRAIT@DUNGEON_DEPTHS@HERO_TRAIT_NAME"
msgstr "Ascensão: Guardião do Calabouço"

msgid "DLC@GIANTKINGS@META_EMPIRE@ASCENSION_TRAIT@DUNGEON_DEPTHS@PROP_DESCRIPTION"
msgstr "No início do combate, invoque uma unidade {GLOBAL.UNITS.CLAY_ARBALEST.Hyperlink}, {GLOBAL.UNITS.CLAY_CHARGER.Hyperlink} ou {GLOBAL.UNITS.CLAY_DEFENDER.Hyperlink}."

msgid "DLC@GIANTKINGS@META_EMPIRE@ASCENSION_TRAIT@DUNGEON_DEPTHS@PROP_NAME"
