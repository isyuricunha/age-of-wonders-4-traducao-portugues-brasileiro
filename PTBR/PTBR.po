msgstr "Dardos Sangrentos"

msgid "DLC@THRONESOFBLOOD@BASE_ABILITY@MAGIC_BOLTS@EXTRACTION"
msgstr "Dardos Hemorrágicos"

msgid "DLC@THRONESOFBLOOD@BASE_ABILITY@MAGIC_BOLTS@EXTRACTION_DESCRIPTION"
msgstr "Dispara um dardo mágico no inimigo alvo. Causa +{amount}% de dano extra por pilha de {GLOBAL.PROPERTIES.BLEEDING.Hyperlink} no alvo."

msgid "DLC@THRONESOFBLOOD@BASE_ABILITY@MAGIC_BOLTS@SANGUINE"
msgstr "Dardos Sanguíneos"

msgid "DLC@THRONESOFBLOOD@COLONYUPGRADES_STRATEGIC@DESECRATION_CHAMBERS@DESCRIPTION"
msgstr "A cada {GLOBAL.TurnConcept.Hyperlink}, {amount} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> dentro ou adjacente ao {GLOBAL.DomainConcept.Hyperlink} se transforma em terreno {GLOBAL.SunlessConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@COLONYUPGRADES_STRATEGIC@DESECRATION_CHAMBERS@NAME"
msgstr "Câmaras de Desecração"

msgid "DLC@THRONESOFBLOOD@COLONYUPGRADES_STRATEGIC@LORDS_CASTLE@DESCRIPTION"
msgstr "[bulletlist][bullet/]Libera <<m:{GLOBAL.ThrallConcept.Hyperlink}>> na cidade, produzida como {GLOBAL.PopulationConcept.Hyperlink}.[bullet/]Ganha {GLOBAL.SPECIAL_OPERATIONS.CLAIRVOYANCE_RITUAL.Hyperlink}[bullet/]Se {GLOBAL.SoulConcept.Hyperlink} estiverem liberados:[bulletlist][bullet/]Ganha o feitiço {GLOBAL.SPECIAL_OPERATIONS.SOUL_DRAIN_RITUAL.Hyperlink}.[bullet/]Ganha o feitiço {GLOBAL.SPECIAL_OPERATIONS.THRALL_EFFIGY.Hyperlink}.[/bulletlist][/bulletlist]"

msgid "DLC@THRONESOFBLOOD@COLONYUPGRADES_STRATEGIC@LORDS_CASTLE@NAME"
msgstr "Castelo Vampiro: Fundação"

msgid "DLC@THRONESOFBLOOD@COLONYUPGRADES_STRATEGIC@LORDS_CASTLE_ABATTOIR@DESCRIPTION"
msgstr "[bulletlist][bullet/]<<m:{GLOBAL.HeroConcept.Hyperlink}>> na {GLOBAL.PrisonConcept.Hyperlink} podem ser convertidas.[bullet/]<<m:{GLOBAL.HeroConcept.Hyperlink}>> na {GLOBAL.PrisonConcept.Hyperlink} podem ser consumidas para conceder {GLOBAL.ExperienceConcept.Hyperlink} aos seus heróis.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@COLONYUPGRADES_STRATEGIC@LORDS_CASTLE_ABATTOIR@NAME"
msgstr "Castelo Vampiro: Matadouro"

msgid "DLC@THRONESOFBLOOD@COLONYUPGRADES_STRATEGIC@LORDS_CASTLE_DEEP_CRYPTS@DESCRIPTION"
msgstr "[bulletlist][bullet/]<<m:{GLOBAL.HeroConcept.Hyperlink}>> na {GLOBAL.CryptConcept.Hyperlink} podem ser ressuscitadas.[bullet/]Neste domínio, Vampiros ganham +{amount} de regeneração de {GLOBAL.HitPointConcept.Hyperlink} por {GLOBAL.WorldMapConcept.Hyperlink} {GLOBAL.TurnConcept}.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@COLONYUPGRADES_STRATEGIC@LORDS_CASTLE_DEEP_CRYPTS@NAME"
msgstr "Castelo Vampiro: Criptas Profundas"

msgid "DLC@THRONESOFBLOOD@COLONYUPGRADES_STRATEGIC@LORDS_CASTLE_DEEP_CRYPTS@PROP_DESCRIPTION"
msgstr "Neste domínio, Vampiros ganham +{amount} de regeneração de {GLOBAL.HitPointConcept.Hyperlink} por {GLOBAL.WorldMapConcept.Hyperlink} {GLOBAL.TurnConcept}."

msgid "DLC@THRONESOFBLOOD@COLONYUPGRADES_STRATEGIC@LORDS_CASTLE_LABORATORY@DESCRIPTION"
msgstr "[bulletlist][bullet/]Libera o feitiço {GLOBAL.SPECIAL_OPERATIONS.VIVISECTION_RITUAL.Hyperlink}.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@COLONYUPGRADES_STRATEGIC@LORDS_CASTLE_LABORATORY@NAME"
msgstr "Castelo Vampiro: Laboratório"

msgid "DLC@THRONESOFBLOOD@COLONYUPGRADES_STRATEGIC@LORDS_CASTLE_LEVEL_I@DESCRIPTION"
msgstr "[bulletlist][bullet/]{Rankbonus}[medalGold/] Posto Inicial para toda unidade de {GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink} de Nível 1.[bullet/]Libera a Invocação de Unidades de Nível II.[bullet/]Libera o feitiço {GLOBAL.SPECIAL_OPERATIONS.BLOOD_TRANSFER_RITUAL.Hyperlink}.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@COLONYUPGRADES_STRATEGIC@LORDS_CASTLE_LEVEL_I@NAME"
msgstr "Castelo Vampiro: Câmaras"

msgid "DLC@THRONESOFBLOOD@COLONYUPGRADES_STRATEGIC@LORDS_CASTLE_LEVEL_II@DESCRIPTION"
msgstr "[bulletlist][bullet/]{Rankbonus}[medalGold/] Posto Inicial para toda unidade de {GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink} de Nível 1 e Nível 2.[bullet/]Desbloqueia a Invocação de Unidades de Nível III.[bullet/]Desbloqueia o feitiço {GLOBAL.SPECIAL_OPERATIONS.DESECRATION_RITUAL.Hyperlink}.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@COLONYUPGRADES_STRATEGIC@LORDS_CASTLE_LEVEL_II@NAME"
msgstr "Castelo Vampiro: Salões Grandiosos"

msgid "DLC@THRONESOFBLOOD@COLONYUPGRADES_STRATEGIC@LORDS_CASTLE_LEVEL_III@DESCRIPTION"
msgstr "[bulletlist][bullet/]{Rankbonus}[medalGold/] Posto Inicial para toda unidade de {GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink} de Nível 1, Nível 2 e Nível 3.[bullet/]Desbloqueia a Invocação de Unidades de Nível IV e V.[bullet/]Desbloqueia o feitiço {GLOBAL.SPECIAL_OPERATIONS.BLOOD_MOON_RITUAL.Hyperlink}.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@COLONYUPGRADES_STRATEGIC@LORDS_CASTLE_LEVEL_III@NAME"
msgstr "Castelo Vampiro: Trono de Sangue"

msgid "DLC@THRONESOFBLOOD@COLONYUPGRADES_STRATEGIC@LORDS_CASTLE_RITUAL_CHAMBER@DESCRIPTION"
msgstr "[bulletlist][bullet/]Feitiços que custam <<m:{GLOBAL.ThrallConcept.Hyperlink}>> têm seu custo reduzido em {amount}, mas não podem ficar abaixo de {amount} {GLOBAL.ThrallConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@COLONYUPGRADES_STRATEGIC@LORDS_CASTLE_RITUAL_CHAMBER@NAME"
msgstr "Castelo Vampiro: Câmara Ritual"

msgid "DLC@THRONESOFBLOOD@COLONYUPGRADES_STRATEGIC@LORDS_CASTLE_ROOM_RECALL@NAME"
msgstr "Castelo Vampiro: Sala da Lembrança"

msgid "DLC@THRONESOFBLOOD@COLONYUPGRADES_STRATEGIC@LORDS_CASTLE_SOUL_FORGE@DESCRIPTION"
msgstr "[bulletlist][bullet/]Libera o {GLOBAL.ItemForgeConcept.Hyperlink}, permitindo que você crie Itens Personalizados para Herói usando {GLOBAL.BindingEssenceConcept.Hyperlink}.[bullet/]Libera o recrutamento das unidades {GLOBAL.UNITS.VAMPIRE_SPIDER_HATCHLING.Hyperlink}, {GLOBAL.UNITS.DOOM_BAT.Hyperlink}, {GLOBAL.UNITS.SHRIEKING_BAT.Hyperlink} e {GLOBAL.UNITS.VAMPIRE_SPIDER_MATRIARCH.Hyperlink}. Essas unidades têm um custo de {GLOBAL.ThrallConcept.Hyperlink} para recrutar.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@COLONYUPGRADES_STRATEGIC@LORDS_CASTLE_SOUL_FORGE@NAME"
msgstr "Castelo Vampiro: Forja das Almas"

msgid "DLC@THRONESOFBLOOD@COLONYUPGRADES_STRATEGIC@LORDS_CASTLE_STYGIAN_OBSERVERS@DESCRIPTION"
msgstr "[bulletlist][bullet/]{visionbonus} de Alcance de Visão e Visão Verdadeira para este {GLOBAL.CityConcept}.[bullet/]Vampiros ganham {GLOBAL.PROPERTIES.UNIVERSAL_CAMOUFLAGE.Hyperlink} enquanto estiverem em Terreno sem Sol ou se o feitiço {GLOBAL.SPECIAL_OPERATIONS.BLOOD_MOON_RITUAL.Hyperlink} estiver ativo.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@COLONYUPGRADES_STRATEGIC@LORDS_CASTLE_STYGIAN_OBSERVERS@NAME"
msgstr "Castelo Vampiro: Observadores Estígios"

msgid "DLC@THRONESOFBLOOD@COLONYUPGRADES_STRATEGIC@LORDS_CASTLE_STYGIAN_OBSERVERS@PROP_DESCRIPTION"
msgstr "Esta unidade tem {GLOBAL.PROPERTIES.UNIVERSAL_CAMOUFLAGE.Hyperlink} enquanto estiver em Terreno sem Sol ou se o feitiço {GLOBAL.SPECIAL_OPERATIONS.BLOOD_MOON_RITUAL.Hyperlink} estiver ativo."

msgid "DLC@THRONESOFBLOOD@COLONYUPGRADES_STRATEGIC@LORDS_CASTLE_STYGIAN_OBSERVERS@PROP_NAME"
msgstr "Sombras Estígias"

msgid "DLC@THRONESOFBLOOD@COLONYUPGRADES_STRATEGIC@LORDS_CASTLE_TELEPORTATION_CIRCLE@NAME"
msgstr "Castelo Vampiro: Círculo de Teletransporte"

msgid "DLC@THRONESOFBLOOD@COLONYUPGRADES_STRATEGIC@PROVINCE_IMPROVEMENT_TRANSMUTER@BLOOD_GLASS"
msgstr "Efeito local: [bulletlist][bullet/]+{Bonus} {GLOBAL.UnitProductionConcept.Hyperlink}[/bulletlist]\n"
"Efeito global único:[bulletlist][bullet/]<<m:{GLOBAL.UnitConcept.Hyperlink}>> ganham +{amount} de regeneração de {GLOBAL.HitPointConcept.Hyperlink} por {GLOBAL.WorldMapConcept.Hyperlink} {GLOBAL.TurnConcept}.[/bulletlist]\n"
"Conjunto: {GLOBAL.TOKENSETBONUS.RINGS_OF_BINDING.Hyperlink}"

msgid "DLC@THRONESOFBLOOD@COLONYUPGRADES_STRATEGIC@PROVINCE_IMPROVEMENT_TRANSMUTER@BLOOD_GLASS@LOGIC"
msgstr "Este Círculo de Transmutação está transmutando [bloodglass/] {GLOBAL.STRUCTURES.BLOOD_GLASS.Hyperlink}"

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@ATTACKER_BENEVOLENT_BLOOD_PARASITES@NAME"
msgstr "Benevolência Compartilhada"

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@BANSHEE_QUEEN@DESCRIPTION"
msgstr "Os ataques do {GLOBAL.HeroConcept.Hyperlink} defensor infligem {GLOBAL.PROPERTIES.TORMENT.Hyperlink}.[br/][br/]Além disso, obstáculos de Cápsulas Lamentosas adornam seu jardim, que ativam um {GLOBAL.PROPERTIES.WAIL_OF_THE_BANSHEE.Hyperlink} quando destruídos."

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@BANSHEE_QUEEN@NAME"
