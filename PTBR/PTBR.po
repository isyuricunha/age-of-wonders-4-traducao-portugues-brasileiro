msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@COMBAT_CASTERS@NAME"
msgstr "Defensores Magos Corpo a Corpo"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@DELAYED_WORM@NAME"
msgstr "Tremores Atrasados"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@ELEMENTAL_FRAGILITY@DESCRIPTION"
msgstr "Na primeira vez que cada {GLOBAL.PROPERTIES.ELEMENTAL.Hyperlink} {GLOBAL.UnitConcept.Hyperlink} defensor cair abaixo de {percent} de seus <<m:{GLOBAL.HitPointConcept.Hyperlink}>>:[bulletlist][bullet/]A unidade teleporta até {hex} hexágonos longe dos atacantes.[bullet/]A unidade se transforma em outra Unidade Elemental aleatória.[bullet/]A unidade sofre {stack} {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink}.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@ELEMENTAL_FRAGILITY@NAME"
msgstr "Fragilidade Elemental"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@ELEMENTAL_MAYHEM@DESCRIPTION"
msgstr "Na primeira vez que cada {GLOBAL.PROPERTIES.ELEMENTAL.Hyperlink} {GLOBAL.UnitConcept.Hyperlink} defensor cair abaixo de {percent} de seus <<m:{GLOBAL.HitPointConcept.Hyperlink}>>:[bulletlist][bullet/]A unidade teleporta até {hex} hexágonos longe dos atacantes.[bullet/]A unidade se transforma em outra Unidade Elemental de Nível 1 aleatória.[bullet/]A unidade recebe cura de {hp} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@ELEMENTAL_MAYHEM@NAME"
msgstr "Caos Elemental"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@FADING_SOULS@DESCRIPTION"
msgstr "A cada {turn} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, todos os cadáveres das <<m:{GLOBAL.UnitConcept.Hyperlink}>> defensoras são ressuscitados como um {GLOBAL.UNITS.PHANTASM_WARRIOR_UNIT.Hyperlink} que morre após {turn} [turn/] turnos."

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@FADING_SOULS@NAME"
msgstr "Almas Desvanecidas"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@FRACTURING_DRAGON@DESCRIPTION"
msgstr "O {GLOBAL.UNITS.FRACTURED_DRAGON.Hyperlink} defensor deixa Fraturas de Mana em cada hexágono alvo de seus ataques. As Fraturas de Mana têm {GLOBAL.DrainingConcept.Hyperlink} e se espalham para um hexágono adjacente a cada vez que um Feitiço é lançado."

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@FRACTURING_DRAGON@NAME"
msgstr "Rastro Fraturante"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@FRIENDLY_FIRE_WORM@DESCRIPTION"
msgstr "A cada {turn} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, um raio de {radius}-hex próximo a uma Unidade defensora fica marcado por tremores.[bulletlist][bullet/]Todas as <<m:{GLOBAL.UnitConcept.Hyperlink}>> atacantes sem {GLOBAL.PROPERTIES.FLYING_MOVEMENT.Hyperlink}, {GLOBAL.PROPERTIES.FLOATING_MOVEMENT.Hyperlink} ou {GLOBAL.PROPERTIES.SAND_WALK.Hyperlink} no raio sofrem {GLOBAL.PROPERTIES.SLOWED.Hyperlink} por {turn2} [turn/] Turno.[bullet/]No final do próximo Turno, todas as Unidades ainda dentro do raio são mortas.[bulletlist][bullet/]Unidades mortas desta forma ignoram {GLOBAL.PROPERTIES.RESURGENCE.Hyperlink} e {GLOBAL.PROPERTIES.STEADFAST.Hyperlink} e não deixam cadáver.[bullet/]O Líder da Expedição ainda é revivido em {hp} {GLOBAL.HitPointConcept.Hyperlink} se seu lado for vitorioso na batalha.[/bulletlist][/bulletlist]"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@FRIENDLY_FIRE_WORM@NAME"
msgstr "Tremores Agitados"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@GIANT_WORM@DESCRIPTION"
msgstr "A cada {turn} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, um raio de {radius} hexágonos ao redor de uma Unidade atacante fica marcado por tremores.[bulletlist][bullet/]Todas as <<m:{GLOBAL.UnitConcept.Hyperlink}>> atacantes sem {GLOBAL.PROPERTIES.FLYING_MOVEMENT.Hyperlink}, {GLOBAL.PROPERTIES.FLOATING_MOVEMENT.Hyperlink} ou {GLOBAL.PROPERTIES.SAND_WALK.Hyperlink} no raio sofrem {GLOBAL.PROPERTIES.SLOWED.Hyperlink} por {turn2} [turn/] Turno.[bullet/]No final do próximo [turn/] Turno, todas as Unidades ainda dentro do raio são mortas.[bulletlist][bullet/]Unidades mortas desta forma ignoram {GLOBAL.PROPERTIES.RESURGENCE.Hyperlink} e {GLOBAL.PROPERTIES.STEADFAST.Hyperlink} e não deixam cadáver.[bullet/]O Líder da Expedição ainda é revivido em {hp} {GLOBAL.HitPointConcept.Hyperlink} se seu lado for vitorioso na batalha.[/bulletlist][/bulletlist]"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@GIANT_WORM@DESCRIPTION_TSR"
msgstr "Cada {turn} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, um raio de {radius} hexágonos próximo a uma Unidade atacante fica marcado por tremores.[bulletlist][bullet/]Todas as unidades atacantes <<m:{GLOBAL.UnitConcept.Hyperlink}>> sem {GLOBAL.PROPERTIES.FLYING_MOVEMENT.Hyperlink}, {GLOBAL.PROPERTIES.FLOATING_MOVEMENT.Hyperlink} ou {GLOBAL.PROPERTIES.SAND_WALK.Hyperlink} no raio sofrem {GLOBAL.PROPERTIES.SLOWED.Hyperlink} por {turn2} [turn/] Turno.[bullet/]No final do próximo [turn/] Turno, todas as unidades ainda dentro do raio são mortas.[bulletlist][bullet/]Unidades mortas dessa forma ignoram {GLOBAL.PROPERTIES.RESURGENCE.Hyperlink} e {GLOBAL.PROPERTIES.STEADFAST.Hyperlink} e não deixam cadáver.[/bulletlist][/bulletlist]"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@GIANT_WORM@NAME"
msgstr "Tremores Gigantescos"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@MOVING_SANDSTORMS@DESCRIPTION"
msgstr "Cada {turns} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, várias tempestades de areia de raio de {hex} hexágonos são geradas em locais aleatórios.[bulletlist][bullet/]<<m:{GLOBAL.UnitConcept.Hyperlink}>> sem {GLOBAL.PROPERTIES.SAND_WALK.Hyperlink} sofrem {GLOBAL.PROPERTIES.SLOWED.Hyperlink} e têm {chance} de sofrer {GLOBAL.PROPERTIES.BLINDED.Hyperlink} por {turn} [turn/] Turno ao atravessar ou terminar seu turno em uma Tempestade de Areia.[bullet/]Tempestades de Areia duram {turns} [turn/] Turnos.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@MOVING_SANDSTORMS@NAME"
msgstr "Tempestades de Areia Rastejantes"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@REJUVINATING_SOULS@DESCRIPTION"
msgstr "Cada {turn} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, todos os cadáveres dos <<m:{GLOBAL.UnitConcept.Hyperlink}>> defensores são ressuscitados como um {GLOBAL.UNITS.PHANTASM_WARRIOR_UNIT.Hyperlink}. Quando isso ocorre, todas as unidades atacantes dentro de um raio de {radius} hexágonos do cadáver são curadas em {heal} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>."

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@REJUVINATING_SOULS@NAME"
msgstr "Almas Revigorantes"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@SABOTAGED_CONSTRUCTS@DESCRIPTION"
msgstr "Todas as {GLOBAL.PROPERTIES.CONSTRUCT.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> defensoras sofrem {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink} por {turn} <<m:{GLOBAL.TurnConcept.Hyperlink}>>. Todas as Unidades Defensoras Não-Construto sofrem {GLOBAL.PROPERTIES.DEMORALIZED.Hyperlink} por {turn} [/turn] Turnos."

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@SABOTAGED_CONSTRUCTS@NAME"
msgstr "Construtos Sabotados"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@STATIC_SANDSTORMS@DESCRIPTION"
msgstr "Várias tempestades de areia de raio de {hex} hexágonos estão presentes na batalha.[bulletlist][bullet/]<<m:{GLOBAL.UnitConcept.Hyperlink}>> sem {GLOBAL.PROPERTIES.SAND_WALK.Hyperlink} sofrem {GLOBAL.PROPERTIES.SLOWED.Hyperlink} e têm {chance} de sofrer {GLOBAL.PROPERTIES.BLINDED.Hyperlink} por {turn} {GLOBAL.TurnConcept.Hyperlink} turno ao atravessar ou terminar seu turno em uma Tempestade de Areia.[bullet/]Essas Tempestades de Areia não se movem e permanecem em suas posições até o final da batalha.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@STATIC_SANDSTORMS@NAME"
msgstr "Tempestades de Areia Estáticas"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@TAUNTED_DRAGON@DESCRIPTION"
msgstr "O {GLOBAL.UNITS.FRACTURED_DRAGON.Hyperlink} defensor é provocado pelo {GLOBAL.PROPERTIES.EXPEDITION_LEADER.Hyperlink} atacante até o final da batalha!"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@TAUNTED_DRAGON@NAME"
msgstr "Provocação do Dragão Fraturado"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@UNDYING_SOULS@DESCRIPTION"
msgstr "Cada {turn} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, todos os cadáveres dos <<m:{GLOBAL.UnitConcept.Hyperlink}>> defensores são ressuscitados como <<m:{GLOBAL.UNITS.PHANTASM_WARRIOR_UNIT.Hyperlink}>>."

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@UNDYING_SOULS@NAME"
msgstr "Almas Imortais"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@VOLATILE_CONSTRUCTS@DESCRIPTION"
msgstr "Os {GLOBAL.PROPERTIES.CONSTRUCT.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> defensores explodem ao morrer, causando {damage} {GLOBAL.FireDamageConcept.Hyperlink} a todas as Unidades defensoras adjacentes."

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@VOLATILE_CONSTRUCTS@NAME"
msgstr "Construtos Voláteis"

msgid "DLC@RISEFROMRUIN@CRISIS@1171_4502@SUB_HEADER"
msgstr "Encontre uma das Regiões Predestinadas."

msgid "DLC@RISEFROMRUIN@CRISIS@1171_4503@DESCRIPTION"
msgstr "Os {GLOBAL.FracturingWindsConcept.Hyperlink} uivam no ar e provocarão <<m:{GLOBAL.CataclysmConcept.Hyperlink}>> quando muitas <<m:{GLOBAL.WorldMapSpellConcept.Hyperlink}>> forem lançadas. Talvez, ao encontrar as origens desse fenômeno, você possa se proteger dele ou até mesmo transformá‑lo em arma."

msgid "DLC@RISEFROMRUIN@CRISIS@1171_4503@NAME"
msgstr "Ventos Devoradores"

msgid "DLC@RISEFROMRUIN@CRISIS@1224_1337@DESCRIPTION"
msgstr "Duas facções entram em conflito pelo controle do oásis subterrâneo. Uma tribo Nômade busca erradicar aqueles que envenenam a terra, a água e seu povo — enquanto uma tribo de exilados fraturados luta para defender o que consideram solo sagrado."

msgid "DLC@RISEFROMRUIN@CRISIS@1224_1337@NAME"
msgstr "Lago do Grande Verme"

msgid "DLC@RISEFROMRUIN@CRISIS@1224_1337@SUB_HEADER"
msgstr "Uma batalha encenada está em curso no Lago do Grande Verme."

msgid "DLC@RISEFROMRUIN@CRISIS@1252_70@DESCRIPTION"
msgstr "As Colinas Fantasmas estão salpicadas de acampamentos de guerra de um exército fantasmagórico. Seus estandartes ondulantes falam de um tempo em que valentes campeões marcharam contra as cidades do {GLOBAL.UnmakersLoreConcept.Hyperlink} para proteger o reino de seus perigosos experimentos arcanos."

msgid "DLC@RISEFROMRUIN@CRISIS@1252_70@NAME"
msgstr "Colinas Fantasmas"

msgid "DLC@RISEFROMRUIN@CRISIS@1252_70@SUB_HEADER"
msgstr "O exército de um {TSR_WARLORD} fantasmagórico permanece nesta região..."

msgid "DLC@RISEFROMRUIN@CRISIS@FRACTURING_WINDS@PHASE2@DESCRIPTION"
msgstr "Os {GLOBAL.FracturingWindsConcept.Hyperlink} parecem ter sido criados inadvertidamente pela arrogância desses chamados {GLOBAL.UnmakersLoreConcept.Hyperlink}. Agora desaparecidos, alguns de seus <<m:{GLOBAL.ArtifactConcept.Hyperlink}>> permanecem nas Regiões Predestinadas espalhadas pelo reino.[br/][br/]Esses Artefatos demonstram ser capazes de manipular e controlar parcialmente os Ventos Devoradores.[br/][br/]Coletar o suficiente deles e canalizá‑los por um tempo permitirá transformar os ventos em arma, resultando em uma vitória decisiva para quem os empunha, pois poderá restaurar ou dispersar o reino à vontade."

msgid "DLC@RISEFROMRUIN@CRISIS@FRACTURING_WINDS@SUB_HEADER"
msgstr "Continue sua jornada, cuidado com os [hyperlink,GLOBAL.FracturingWindsConcept.Hyperlink]Ventos[/hyperlink]."

msgid "DLC@RISEFROMRUIN@CRISIS@TSR_RFR_CM@DESCRIPTION"
msgstr "Vozes criadas pelos ventos devoradores assombram esta área, onde a energia {GLOBAL.FractureLoreConcept.Hyperlink} é tão volátil que o ar crepita com ela. As vozes pedem que você se aproxime das Fraturas, prometendo conhecimento inimaginável."

msgid "DLC@RISEFROMRUIN@CRISIS@TSR_RFR_CM@NAME"
msgstr "Mesa Crepitante"

msgid "DLC@RISEFROMRUIN@CRISIS@TSR_RFR_CM@SUB_HEADER"
msgstr "Os ventos devoradores sussurram promessas de conhecimento."

