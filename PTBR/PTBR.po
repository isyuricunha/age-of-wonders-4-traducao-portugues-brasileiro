msgid "TOME_REVELRY@HERO_SKILL@NAME"
msgstr "Triunfo dos Foliões"

msgid "TOME_REVELRY@HERO_SKILL@PROPERTY@DESCRIPTION"
msgstr "Unidade tem +{amount}% de dano {GLOBAL.CriticalHitConcept.Hyperlink}."

msgid "TOME_REVELRY@PASSIVE@DESCRIPTION"
msgstr "Quando uma unidade é construída em uma cidade, essa cidade ganha {food} {GLOBAL.FoodConcept}."

msgid "TOME_REVELRY@PASSIVE@NAME"
msgstr "Festim de Provocação"

msgid "TOME_REVELRY@SKILL1@DESCRIPTION"
msgstr "Um {GLOBAL.PROPERTIES.SUPPORT_UNIT.Hyperlink} que garante que a folia nunca pare, inspirando suas unidades."

msgid "TOME_REVELRY@SKILL1@NAME"
msgstr "Skald"

msgid "TOME_REVELRY@SKILL2@DESCRIPTION"
msgstr "Unidades no exército amigo alvo ganham +{amount}% de {GLOBAL.ExperienceConcept.Hyperlink} em combate por {turn} <<m:{GLOBAL.TurnConcept}>>."

msgid "TOME_REVELRY@SKILL2@NAME"
msgstr "Festas da Carnificina"

msgid "TOME_REVELRY@SKILL2@PROP_DESCRIPTION"
msgstr "A unidade ganha +{amount}% de {GLOBAL.ExperienceConcept.Hyperlink} em combate."

msgid "TOME_REVELRY@SKILL3@DESCRIPTION"
msgstr "Concede a unidades encantadas:[bulletlist][bullet/]+{BLOODFURY_WEAPONS_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink} em ataques básicos.[bullet/]Ao matar, inimigos adjacentes ao alvo ganham {amount} {GLOBAL.PROPERTIES.BLEEDING.Hyperlink} por {BLEEDING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_REVELRY@SKILL3@NAME"
msgstr "Armas da Fúria Sangrenta"

msgid "TOME_REVELRY@SKILL3@PROPERTY_DESCRIPTION"
msgstr "Esta unidade tem:[bulletlist][bullet/]+{BLOODFURY_WEAPONS_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink} em ataques básicos.[bullet/]Ao matar, inimigos adjacentes ao alvo ganham {amount} {GLOBAL.PROPERTIES.BLEEDING.Hyperlink} por {BLEEDING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_REVELRY@SKILL4@DESCRIPTION"
msgstr "No início da batalha, as unidades atacantes ganham {amount} {GLOBAL.UnitMoraleConcept.Hyperlink} e as unidades defensoras são afetadas com {amount2} {GLOBAL.PROPERTIES.BLEEDING.Hyperlink} por {duration} <<m:{GLOBAL.TurnConcept}>>"

msgid "TOME_REVELRY@SKILL4@NAME"
msgstr "Festas de Sangue"

msgid "TOME_REVELRY@SKILL4@PROP_DESCRIPTION"
msgstr "Atacantes ganham {amount} {GLOBAL.UnitMoraleConcept.Hyperlink}[br/]Defensores são afetados com {amount2} {GLOBAL.PROPERTIES.BLEEDING.Hyperlink} por {duration} <<m:{GLOBAL.TurnConcept}>>"

msgid "TOME_REVELRY@SKILL5@DESCRIPTION"
msgstr "Domina a raça alvo com um fervor intenso, concedendo-lhes:[bulletlist][bullet/]+{REVELERS_HEART_MORALE_RESISTANCE>ResolvedMoraleRiseModifier}% de {GLOBAL.UnitMoraleConcept.Hyperlink} de todas as fontes.[/bulletlist]"

msgid "TOME_REVELRY@SKILL5@NAME"
msgstr "Coração do Devasso"

msgid "TOME_REVELRY@SKILL5@PROP_DESCRIPTION"
