msgid "TOME_ASTRAL_CONVERGENCE@SKILL5@NAME"
msgstr "Poder em Cascata"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL5@PROP_DESCRIPTION"
msgstr "[bulletlist][bullet/]Uma unidade inimiga aleatória sofre {amount} {GLOBAL.LightningDamageConcept.Hyperlink} no início do {GLOBAL.TurnConcept} do dono.[bullet/]Para cada pilha, outra unidade inimiga aleatória sofre dano.[/bulletlist]"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL5@PROP_NAME"
