msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@MOF@GLOOM_DEBUFF"
msgstr "Enquanto qualquer exército de crise estiver ativo, um {GLOBAL.ProvinceConcept.Hyperlink} aleatório dentro do seu {GLOBAL.DomainConcept.Hyperlink} será terraformado em {GLOBAL.GloomTerrainConcept.Hyperlink} a cada {AP1_MOF_DEBUFF_INTERVAL} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@MOF@GOLD_DEBUFF"
