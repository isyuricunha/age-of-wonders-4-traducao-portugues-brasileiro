msgid "DLC@EMPIRESANDASHES@STORY_REALM_MISSION_02@REALM_TRAIT_OASIS@DESCRIPTION"
msgstr "Este reino consiste em um Oásis central cercado por desertos.[bulletlist][bullet/]Desertos <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> são [abilityblue]Comuns[/abilityblue].[bullet/]Ártico, Altiplanos e Temperados <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> são [abilityblue]Ausentes[/abilityblue].[bullet/]Florestas <<m:{GLOBAL.ProvinceFeatureConcept.Hyperlink}>> e Pântanos <<m:{GLOBAL.ProvinceFeatureConcept.Hyperlink}>> são [abilityblue]Raros[/abilityblue].[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@STORY_REALM_MISSION_02@REALM_TRAIT_OASIS@NAME"
