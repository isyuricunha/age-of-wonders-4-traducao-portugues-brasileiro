msgid "DLC@PRIMALFURY@PRIMAL_FURY_ABILITY@CROCODILE@NAME"
msgstr "Bênção do Crocodilo do Pântano"

msgid "DLC@PRIMALFURY@PRIMAL_FURY_ABILITY@CROCODILE_FURY@DESCRIPTION"
