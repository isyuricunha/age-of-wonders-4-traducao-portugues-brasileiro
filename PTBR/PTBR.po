msgid "CORE_SIEGEPROJECTS@CONSTRUCT_CATAPULTS@DESCRIPTION"
msgstr "[bulletlist][bullet/]No início da batalha, ganhe {amount} <<m:{GLOBAL.UNITS.CATAPULT_UNIT.Hyperlink}>> no lado do atacante até o fim da batalha.[bullet/]<<m:{GLOBAL.UNITS.CATAPULT_UNIT.Hyperlink}>> são {GLOBAL.PROPERTIES.SIEGECRAFT_UNIT.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> imóveis com ataques de longo alcance e área de efeito, ótimos para destruir obstáculos, mas imprecisos contra <<m:{GLOBAL.UnitConcept.Hyperlink}>>[bullet/]Apenas um tipo de unidade de Cerco pode ser levado para {GLOBAL.CombatConcept.Hyperlink}. Se múltiplos <<m:{GLOBAL.SiegeProjectConcept.Hyperlink}>> trouxerem-nas, apenas a mais forte aparecerá.[/bulletlist]"

msgid "CORE_SIEGEPROJECTS@CONSTRUCT_CATAPULTS@NAME"
msgstr "Construir Onagros"

msgid "CORE_SIEGEPROJECTS@CONSTRUCT_TREBUCHETS@DESCRIPTION"
msgstr "[bulletlist][bullet/]2 unidades de Trabuco se juntarão ao lado atacante durante a batalha de cerco.[bullet/]Trabuquetes são unidades de longo alcance poderosas, excelentes para destruir obstáculos, mas imprecisas ao mirar em unidades.[/bulletlist]"

msgid "CORE_SIEGEPROJECTS@CONSTRUCT_TREBUCHETS@NAME"
msgstr "Construir Trabuquetes"

