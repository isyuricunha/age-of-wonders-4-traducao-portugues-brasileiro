msgid "INTERFACE@TEXT@CITY_MORALE"
msgstr "[happiness/] Estabilidade da Cidade"

msgid "INTERFACE@TEXT@CITY_MORALE_DESCRIPTION"
msgstr "[happiness/] Estabilidade da Cidade representa seu controle geral sobre uma {GLOBAL.CityConcept.Hyperlink}.[br/][bulletlist][bullet/]Alta Estabilidade aumenta a {GLOBAL.FoodConcept.Hyperlink}, a {GLOBAL.UnitProductionConcept.Hyperlink} e a renda de {GLOBAL.StructureProductionConcept.Hyperlink}.[bullet/]Baixa Estabilidade reduz todas as {GLOBAL.CityIncomeConcept.Hyperlink}.[bullet/]Estabilidade Muito Baixa pode levar a cidade a perder <<m:{GLOBAL.ProvinceConcept.Hyperlink}>>.[/bulletlist][br/]Ela diminui conforme o {GLOBAL.DomainConcept.Hyperlink} da cidade cresce e pode ser recuperada ao construir certas <<m:{GLOBAL.CityStructureConcept.Hyperlink}>>.[br/][bulletlist][bullet/]{harmonymin} de {harmonymax}: {GLOBAL.CityStabilityHarmony.Hyperlink}.[bullet/]{ordermin} de {ordermax}: {GLOBAL.CityStabilityOrderly.Hyperlink}.[bullet/]{stablemin} de {stablemax}: {GLOBAL.CityStabilityStable.Hyperlink}.[bullet/]{neutralmin} a {neutralmax}: Neutra.[bullet/]{unstablemin} a {unstablemax}: {GLOBAL.CityStabilityUnstable.Hyperlink}.[bullet/]{unrestmin} a {unrestmax}: {GLOBAL.CityStabilityUnrest.Hyperlink}.[bullet/]{riotmin} a {riotmax}: {GLOBAL.CityStabilityRioting.Hyperlink}.[/bulletlist]"

msgid "INTERFACE@TEXT@CITY_MORALE_DESCRIPTION_HARMONY"
msgstr "{harmonyvalue} renda de {GLOBAL.StructureProductionConcept.Hyperlink}, {GLOBAL.UnitProductionConcept.Hyperlink} e {GLOBAL.FoodConcept.Hyperlink}."

msgid "INTERFACE@TEXT@CITY_MORALE_DESCRIPTION_ORDERLY"
msgstr "{ordervalue} renda de {GLOBAL.StructureProductionConcept.Hyperlink}, {GLOBAL.UnitProductionConcept.Hyperlink} e {GLOBAL.FoodConcept.Hyperlink}."

msgid "INTERFACE@TEXT@CITY_MORALE_DESCRIPTION_RIOTING"
msgstr "{riotingvalue} {GLOBAL.CityIncomeConcept.Hyperlink}. Há uma chance de que as províncias possam se rebelar contra a cidade."

