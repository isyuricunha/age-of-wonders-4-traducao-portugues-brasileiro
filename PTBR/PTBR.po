msgstr "No fim do turno, inimigos adjacentes têm uma chance base de {OPPRESSING_AURA_RESISTANCE>ResolvedStrength}% de sofrer:[bulletlist][bullet/]{GLOBAL.PROPERTIES.MISFORTUNE.Hyperlink} por {MISFORTUNE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]{OPPRESSING_AURA_MORALE_CHANGE>Morale Change Absolute} perda de {GLOBAL.UnitMoraleConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@BLOOD_EXARCH@ABILITY05@NAME"
