msgid "TOME_GREAT_TRANSFORMATION@UNIT1@NAME"
msgstr "Pináculo Necrótico^n"

msgid "TOME_HELL_GATE@UNIT_ABILITY_2@NAME"
msgstr "Marca do Caos"

msgid "TOME_HELL_GATE@UNIT_ABILITY_2@PROP_DESCRIPTION"
