msgstr "Alvo inimigo:[bulletlist][bullet/]Torna‑se {GLOBAL.PROPERTIES.DISTRACTED.Hyperlink}.[bullet/]Sofre {stacks} {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink}.[/bulletlist]"

msgid "TOME_WILD@SKILL1@NAME"
msgstr "Marcar como Presa"

