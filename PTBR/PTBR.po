msgid "TOME_INQUISITION@SKILL5@DESCRIPTION"
msgstr "Alvo exército inimigo:[bulletlist][bullet/]Sofre {damage} {GLOBAL.SpiritDamageConcept.Hyperlink}.[bullet/]Perde {amount}% de sua <<m:{GLOBAL.MovePointConcept}>> no {GLOBAL.WorldMapConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_INQUISITION@SKILL5@NAME"
msgstr "Fardo da Culpa"

msgid "TOME_INQUISITION@SKILL6@DESCRIPTION"
msgstr "Invoca um(a) {GLOBAL.UNITS.LIGHTBRINGER_UNIT.Hyperlink} {GLOBAL.PROPERTIES.BATTLE_MAGE.Hyperlink} que pode converter outras unidades à sua causa."

msgid "TOME_INQUISITION@SKILL6@NAME"
msgstr "Invocar Portador da Luz"

msgid "TOME_INQUISITION@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Persiga aqueles que não concordam com sua autoridade. Cause {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink} em inimigos e restrinja o Movimento deles."

msgid "TOME_INQUISITION@TOME@LORE_AUTHOR"
msgstr "Shira Snowblood, Godir da Aliança"

msgid "TOME_INQUISITION@TOME@LORE_DESCRIPTION"
msgstr "\"Os ímpios sentirão a ira de nossa virtude infalível. Nós os golpearemos com devoção furiosa e vingança implacável! Seus membros ficarão pesados com o peso de sua maldade, enquanto nossos súditos serão impulsionados pela nobreza de espírito!\""

msgid "TOME_INQUISITION@TOME@NAME"
