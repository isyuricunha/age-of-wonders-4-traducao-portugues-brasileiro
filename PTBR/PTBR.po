msgstr "Geleira do Vigia"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@ICEBOUND_BEHEMOTH@NAME_OVERRIDE_05"
msgstr "Geleira Urwilder"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@LITHORITE_PEAKS@DESCRIPTION"
msgstr "<<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacentes a este Marco ganham:[bulletlist][bullet/]{income} e {income2}.[bullet/]Permite a construção de um {GLOBAL.ConduitConcept.Hyperlink}.[bullet/]O {combatproperty} {GLOBAL.CombatEnchantmentConcept.Hyperlink}.[/bulletlist][br/]Um {GLOBAL.CityConcept.Hyperlink} com {amount} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacente a este Marco ganha:[bulletlist][bullet/]Libera o recrutamento de <<m:{GLOBAL.UnitConcept.Hyperlink}>> Lithorine.[bullet/]{income3} e {income4}.[/bulletlist]"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@LITHORITE_PEAKS@LORE"
msgstr "\"Ao contrário da magia 'fria' do Cristal de Foco, a Lithorita emite um calor pulsante. Talvez seja por isso que os antigos [hyperlink,GLOBAL.GiantKingLoreConcept]Reis Gigantes[/hyperlink] escolheram esse material para criar criaturas Lithorine. Embora sejam bastante comuns, grandes aglomerados do material em si são raros. Quando o sol atinge os picos cristalinos, é realmente uma visão deslumbrante.\"[br/][br/]— Edward Portsmith, Relatórios Avançados sobre Infusão de Mana"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@LITHORITE_PEAKS@NAME"
msgstr "Picos Lithorine"

