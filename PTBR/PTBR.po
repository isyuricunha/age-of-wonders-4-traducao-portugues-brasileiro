msgid "DIPLOMACY@DISCUSSION_DECLARATIONOFFRIENDSHIP@INFOPANEL"
msgstr "{PlayerB.Name} declarou uma [hyperlink,GLOBAL.DeclFriendshipConcept]Amizade[/hyperlink] com {Target.Name}. Com o tempo, as relações deles podem melhorar e evoluir para uma {GLOBAL.DSAllianceConcept.Hyperlink}. Declarar uma [hyperlink,GLOBAL.DeclFriendshipConcept]Amizade[/hyperlink] com {Target.Name} pode fortalecer suas relações com {PlayerB.Name}, enquanto uma [hyperlink,GLOBAL.DeclRivalryConcept]Rivalidade[/hyperlink] pode virar {PlayerB.Name} contra você."

msgid "DIPLOMACY@DISCUSSION_DECLARATIONOFFRIENDSHIP@INFOPANEL_SELF"
