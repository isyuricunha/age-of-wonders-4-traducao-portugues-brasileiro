msgid "DLC@RISEFROMRUIN@PRIMAL_CHECK@AFTERMATH_EVENT_TSR@BUTTON"
msgstr "Tente absorver a essência do seu camarada caído e contaminado [hp/]."

msgid "DLC@RISEFROMRUIN@REALM_TRAIT@TSR_FRACTURED_TALES@DESCRIPTION"
msgstr "Há muito tempo, este reino abrigava alguns dos experimentos dos {GLOBAL.UnmakersLoreConcept.Hyperlink}.[br/][bulletlist][bullet/]Existem Regiões Predestinadas no mapa que oferecem cadeias de missões explorando o presente e o passado de {GLOBAL.TheFracturingLoreConcept.Hyperlink}.[bullet/]Obtenha <<m:{GLOBAL.ArtifactConcept.Hyperlink}>> ao completar Regiões Predestinadas, que concedem controle sobre o {GLOBAL.CataclysmConcept.Hyperlink} que devasta este reino. Obter três delas levará a um {GLOBAL.CataclysmVictoryConcept.Hyperlink}.[bullet/]Regiões Predestinadas são afetadas por {GLOBAL.PROPERTIES.WARDED_BY_FATE.Hyperlink}.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@REALM_TRAIT@TSR_FRACTURED_TALES@NAME"
msgstr "Ecos da Fratura"

msgid "DLC@RISEFROMRUIN@RELIC@ANTI_ESSENCE@DESCRIPTION"
msgstr "[bulletlist][bullet/]Desbloqueia o feitiço {GLOBAL.SPECIAL_OPERATIONS.MEND_FRACTURE.Hyperlink}.[bullet/]Desbloqueia o feitiço {GLOBAL.RaceTransformationConcept.Hyperlink} {GLOBAL.SPECIAL_OPERATIONS.FRACTURED_TRANSFORMATION.Hyperlink}.[bullet/]Desbloqueia o feitiço {GLOBAL.SPECIAL_OPERATIONS.DETONATE_INFESTATION_WINDS.Hyperlink}.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@RELIC@ANTI_ESSENCE@LORE"
msgstr "\"O sangue mancha a costa, de um lar perdido e ferido[br/]Sangue que carrega a maldição, que os Unmakers vestiam[br/]Tudo que tocaram desfez-se, tudo que tocaram fraturou e rasgou[br/]O futuro, a terra, o nosso; carne, vida e mais, mais, mais...\""

msgid "DLC@RISEFROMRUIN@RELIC@ANTI_ESSENCE@NAME"
msgstr "Elixir Antiessência"

msgid "DLC@RISEFROMRUIN@RELIC@DETONATE_INFESTATION@SPELL@DESCRIPTION"
msgstr "Alvo {GLOBAL.STRUCTURES.FRACTURED_INFESTATION.Hyperlink} ou {GLOBAL.STRUCTURES.FLEETING_FRACTURED_INFESTATION.Hyperlink} é destruído, não concede suas recompensas.[br/][br/]Este feitiço não contribui para o {GLOBAL.FracturingWindsConcept.Hyperlink} e não pode [hyperlink,GLOBAL.BackfireConcept]Backfire[/hyperlink]."

msgid "DLC@RISEFROMRUIN@RELIC@DETONATE_INFESTATION@SPELL@NAME"
msgstr "Detonar Infestação"

msgid "DLC@RISEFROMRUIN@RELIC@DIVERT_WINDS@SPELL@DESCRIPTION"
msgstr "Alvo {GLOBAL.ProvinceConcept.Hyperlink} que está marcado para ser atingido por um {GLOBAL.CataclysmConcept.Hyperlink} perde a marca e não será atingido no próximo Cataclismo.[br/][br/]Este feitiço não contribui para o {GLOBAL.FracturingWindsConcept.Hyperlink} e não pode [hyperlink,GLOBAL.BackfireConcept]Backfire[/hyperlink]."

msgid "DLC@RISEFROMRUIN@RELIC@DIVERT_WINDS@SPELL@NAME"
msgstr "Desviar Ventos Devoradores"

msgid "DLC@RISEFROMRUIN@RELIC@ESSENCE_SHEATH@DESCRIPTION"
msgstr "[bulletlist][bullet/]Desbloqueia o feitiço {GLOBAL.SPECIAL_OPERATIONS.MEND_FRACTURE.Hyperlink}.[bullet/]Restaurar um {GLOBAL.RuinedNodeConcept.Hyperlink} custa {amount}% menos. Escala com a quantidade de [hyperlink,GLOBAL.ArtifactConcept]Artefatos[/hyperlink] do {GLOBAL.UnmakersLoreConcept.Hyperlink} possuído pelo jogador.[bullet/]Receba {IntGoldAmount} {GLOBAL.GoldConcept.Hyperlink} adicionais e {IntProductionAmount} {GLOBAL.StructureProductionConcept.Hyperlink} em {GLOBAL.AstralBarrensConcept.Hyperlink} e {GLOBAL.SandConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@RELIC@ESSENCE_SHEATH@LORE"
msgstr "\"Ruínas surgem das areias vermelhas, fantasmas que ainda obedecem a ordens[br/]Há um cerco congelado no tempo, porém só um lado resiste[br/]Como um tapeçário do nosso passado, quando podíamos chamar de lar estas terras perdidas\""

msgid "DLC@RISEFROMRUIN@RELIC@ESSENCE_SHEATH@NAME"
msgstr "Capa de Essência^n"

msgid "DLC@RISEFROMRUIN@RELIC@MEND_FRACTURE@SPELL@DESCRIPTION"
msgstr "Reduz o valor de {GLOBAL.FracturingWindsConcept.Hyperlink} em {value}, diminuindo temporariamente a chance de um {GLOBAL.CataclysmConcept.Hyperlink}.[br/]O custo deste feitiço é reduzido com base na quantidade de [hyperlink,GLOBAL.ArtifactConcept]Artefatos[/hyperlink] do {GLOBAL.UnmakersLoreConcept.Hyperlink} que o conjurador possui.[br/][br/]Este feitiço não contribui para o {GLOBAL.FracturingWindsConcept.Hyperlink} e não pode [hyperlink,GLOBAL.BackfireConcept]Backfire[/hyperlink]."

msgid "DLC@RISEFROMRUIN@RELIC@MEND_FRACTURE@SPELL@NAME"
msgstr "Consertar Fratura"

msgid "DLC@RISEFROMRUIN@RELIC@WELLS_TEAR@SPELL@NAME"
msgstr "Rasgar Fratura"

msgid "DLC@RISEFROMRUIN@RELIC@WELLS_TEAR@SPELL@NAME2"
msgstr "Rasgar Fratura 2 Antiga"

msgid "DLC@RISEFROMRUIN@RELIC@WELL_TEAR@DESCRIPTION"
msgstr "[bulletlist][bullet/]Desbloqueia o feitiço {GLOBAL.SPECIAL_OPERATIONS.MEND_FRACTURE.Hyperlink}.[bullet/]Desbloqueia o feitiço {GLOBAL.SPECIAL_OPERATIONS.TEAR_FRACTURE.Hyperlink}.[bullet/]Desbloqueia o feitiço {GLOBAL.SPECIAL_OPERATIONS.IRRADIANT_FLARE.Hyperlink}.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@RELIC@WELL_TEAR@FLAG@DESCRIPTION"
msgstr "Unidades neste hexágono serão atingidas por {amount} {GLOBAL.PhysicalDamageConcept.Hyperlink} e terão {amount2}% de chance base de receber {GLOBAL.PROPERTIES.MANA_DRAINED.Hyperlink} no início do [turn/] [hyperlink,GLOBAL.TurnConcept]Próximo Turno[/hyperlink]"

msgid "DLC@RISEFROMRUIN@RELIC@WELL_TEAR@LORE"
msgstr "\"Nas profundezas do subsolo, jaz um lugar ligado ao destino[br/]Manchando de radiação, a contaminação coroada[br/]Não o procure, há segredos que é melhor perder do que encontrar\""

msgid "DLC@RISEFROMRUIN@RELIC@WELL_TEAR@NAME"
msgstr "Lágrima do Poço^n"

msgid "DLC@RISEFROMRUIN@RELIC@WELL_TEAR@SPELL@DESCRIPTION"
msgstr "Hexágono alvo fica marcado, Unidades em um raio de {TEAR_FRACTURE_CIRCLE_TARGETER_DISRUPTED>AREA>Radius} hexágonos do hexágono marcado têm {amount1}% de chance base de receber {GLOBAL.PROPERTIES.DISRUPTION_TOOLTIP_PROPERTY.Hyperlink}. Após {time} {GLOBAL.TurnConcept.Hyperlink}, o hexágono marcado explode e inflige o seguinte em um raio de {TEAR_FRACTURE_CIRCLE_TARGETER_DISRUPTED>AREA>Radius} hexágonos:[bulletlist][bullet/]Unidades sofrem {amount2} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Unidades têm {amount3}% de chance base de sofrer {GLOBAL.PROPERTIES.MANA_DRAINED.Hyperlink}.[bullet/]Cada hexágono tem {amount4}% de chance de criar um obstáculo de Fratura de Mana, que tem {GLOBAL.DrainingConcept.Hyperlink} e se espalha para hexágonos adjacentes quando feitiços são lançados.[/bulletlist][br/][br/]Esta magia não pode causar [hyperlink,GLOBAL.BackfireConcept]Retrocesso[/hyperlink]."

msgid "DLC@RISEFROMRUIN@RELIC@WIND_ROSE@DESCRIPTION"
msgstr "[bulletlist][bullet/]Desbloqueia o feitiço {GLOBAL.SPECIAL_OPERATIONS.MEND_FRACTURE.Hyperlink}.[bullet/]O jogador ganha {GLOBAL.BackfireTailwindsConcept.Hyperlink}.[bullet/]Desbloqueia o feitiço {GLOBAL.SPECIAL_OPERATIONS.DIVERT_DEVOURING_WINDS.Hyperlink}.[bullet/]Todas as suas <<m:{GLOBAL.UnitConcept.Hyperlink}>> recebem {GLOBAL.PROPERTIES.SAND_WALK.Hyperlink}.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@RELIC@WIND_ROSE@LORE"
msgstr "\"Três Fraturas devoram, toda magia e poder[br/]Não ouça o murmúrio do vento, da Torre do Feiticeiro desaparecida[br/]Que sussurra segredos condenados, da hora mais sombria do mundo\""

msgid "DLC@RISEFROMRUIN@RELIC@WIND_ROSE@NAME"
msgstr "Rosa do Vento Devorador^n"

