msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_OFFER_SELL_DEFAULT"
msgstr "\"Saudações, {HouseALord.Name}. Meu império tem algo a oferecer, tem interesse?\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_PROPOSAL_DEMAND_DEFAULT"
msgstr "\"Seu pedido é razoável, mas exijo algo em troca. Talvez um dos itens a seguir.\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_PROPOSAL_DEMAND_RESOURCE_DEFAULT"
msgstr "\"Posso estar disposto a fornecer alguns dos meus recursos, mas também exijo algo de você, {HouseALord.FirstName}.\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_PROPOSAL_GIFT_DEFAULT"
msgstr "\"Uma proposta interessante, {HouseALord.Name}, posso oferecer o seguinte em troca.\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_PROPOSAL_GIFT_RESOURCE_DEFAULT"
