msgid "TOME_SUMMONING@SKILL3@NAME"
msgstr "Conjurar Guardião Astral"

msgid "TOME_SUMMONING@SKILL4@DESCRIPTION"
msgstr "Por {STATIC_CHARGE_STATUS_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>, a unidade aliada alvo {GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink} ganha:[bulletlist][bullet/]{amount} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}[bullet/]{amount2} {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink}[bullet/]{amount3} {GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.STATIC_CHARGE.Hyperlink}[/bulletlist]"

msgid "TOME_SUMMONING@SKILL4@NAME"
msgstr "Supercarga Arcana"

msgid "TOME_SUMMONING@SKILL5@DESCRIPTION"
msgstr "Invoca um(a) {GLOBAL.UNITS.ASTRAL_SERPENT_UNIT.Hyperlink}, um(a) {GLOBAL.PROPERTIES.FIGHTER.Hyperlink} que pode se teletransportar para as linhas de frente de maneira explosiva."

msgid "TOME_SUMMONING@SKILL5@NAME"
msgstr "Invocar Serpente Astral"

msgid "TOME_SUMMONING@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Invocar, controlar e aprimorar unidades {GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink}."

msgid "TOME_SUMMONING@TOME@LORE_AUTHOR"
msgstr "Werlac de Insaldur, Cultista Nascido das Sombras"

msgid "TOME_SUMMONING@TOME@LORE_DESCRIPTION"
msgstr "\"Através da arte da invocação, pode-se tornar um mestre em todos os sentidos da palavra. Invocar lacaios arcanos e submetê-los à sua vontade. Fortalecer sua conexão com o mundo e observar enquanto eles sacrificam sua existência por você, aquele que os trouxe à existência.\""

msgid "TOME_SUMMONING@TOME@NAME"
msgstr "Tomo de Invocação"

msgid "TOME_SUMMONING@UNIT_1@NAME"
msgstr "Serpente Astral^n"

msgid "TOME_SUMMONING@UNIT_2@NAME"
msgstr "Guardião Astral^n"

