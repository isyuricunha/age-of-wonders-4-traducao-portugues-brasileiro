msgid "DLC@WAYSOFWAR@TOME_CALAMITY@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Traga calamidade ao reino e queime seus inimigos com o frio {GLOBAL.PROPERTIES.GHOSTFIRE.Hyperlink}."

msgid "DLC@WAYSOFWAR@TOME_CALAMITY@TOME@LORE_DESCRIPTION"
msgstr "\"Eis o Dragão da Calamidade; a desolação em seu nome! Contemple a marca amaldiçoada; a cicatriz da chama congelada; aquele inferno glacial, gelo e fogo entrelaçados. Ó portador da gloriosa devastação; contempla seus santuários de profanação; das pétalas cinzentas ao vento!\""

