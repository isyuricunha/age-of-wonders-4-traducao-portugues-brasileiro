msgstr "Unidades inimigas em um raio de {SAP_STRENGTH_TARGETER>AREA>Radius} hexágonos:[bulletlist][bullet/]Têm chance base de {chance}% de receber {amount} pilhas de {GLOBAL.PROPERTIES.WEAKENED.Hyperlink} por {WEAKENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][br/]O conjurador ganha:[bulletlist][bullet/]{GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} por {STRENGTHENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>> para cada inimigo afetado.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@SAP_STRENGTH@DESCRIPTION_2"
msgstr "Unidades inimigas em um raio de {SAP_STRENGTH_TARGETER>AREA>Radius} hexágonos:[bulletlist][bullet/]Têm chance base de {chance}% de receber {amount} pilhas de {GLOBAL.PROPERTIES.WEAKENED.Hyperlink} por {WEAKENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][br/]O conjurador ganha:[bulletlist][bullet/]{GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} e {GLOBAL.PROPERTIES.FORTUNE.Hyperlink} por {STRENGTHENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>> para cada inimigo afetado.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@SAP_STRENGTH@DESCRIPTION_MASTER"
msgstr "Drenar Força:[bulletlist][bullet/]Tem chance base de {chance}% de infligir {GLOBAL.PROPERTIES.WEAKENED.Hyperlink}.[bullet/]Concede também {GLOBAL.PROPERTIES.FORTUNE.Hyperlink} ao conjurador.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@SAP_STRENGTH@NAME"
msgstr "Drenar Força"

msgid "WILDLIFE_UNITPROPERTIES@SAP_STRENGTH@NAME_MASTER"
msgstr "Drenar Força Campeão"

msgid "WILDLIFE_UNITPROPERTIES@SCALE_RESISTANCE@NAME"
msgstr "Resistência à Escama"

msgid "WILDLIFE_UNITPROPERTIES@SHADOW@DESCRIPTION"
msgstr "Um Espírito corrompido pelo toque da magia de Urrath com:[bulletlist][bullet/]{SPIRIT_WEAKNESS>REDUCTION>Spirit} {GLOBAL.SpiritResistanceConcept.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.SLIPPERY.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.ELUSIVE.Hyperlink}[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@SHADOW@NAME"
msgstr "Sombra"

msgid "WILDLIFE_UNITPROPERTIES@SHOCKING_PHASE@DESCRIPTION"
msgstr "Esta unidade teleporta-se para o hexágono alvo, causa dano e cria terreno {GLOBAL.PROPERTIES.ELECTRIFIED.Hyperlink} em um raio de {SHOCKING_PHASE_TARGETER>AREA>Radius} hexágonos ao seu redor."

msgid "WILDLIFE_UNITPROPERTIES@SHOCKING_PHASE@NAME"
msgstr "Fase de Choque"

msgid "WILDLIFE_UNITPROPERTIES@SPAWN_HATCHLING@DESCRIPTION"
msgstr "Gera uma aranha filhote."

msgid "WILDLIFE_UNITPROPERTIES@SPAWN_HATCHLING@NAME"
msgstr "Gerar Filhote"

msgid "WILDLIFE_UNITPROPERTIES@SPELL_DEVOURER@DESCRIPTION"
msgstr "Enquanto esta unidade está em batalha, ela age como um Jamador de Feitiços, aumentando o custo de {GLOBAL.SpellConcept.Hyperlink} dos inimigos em {amount1}% <<m:{GLOBAL.CombatCastingPointConcept.Hyperlink}>>."

msgid "WILDLIFE_UNITPROPERTIES@SPELL_DEVOURER@NAME"
msgstr "Jamador de Feitiços Inato"

msgid "WILDLIFE_UNITPROPERTIES@SPIDER_RESISTANCE@NAME"
msgstr "Resistência a Aranhas"

msgid "WILDLIFE_UNITPROPERTIES@SPIRIT_BEACON@DESCRIPTION"
msgstr "Quando uma unidade que não seja Invocação nem {GLOBAL.PROPERTIES.UNDEAD.Hyperlink} morre, a habilidade {GLOBAL.PROPERTIES.SUMMON_GHOST.Hyperlink} pode ser usada novamente. Só dispara uma vez por turno."

msgid "WILDLIFE_UNITPROPERTIES@SPIRIT_BEACON@NAME"
msgstr "Baluarte de Espírito"

msgid "WILDLIFE_UNITPROPERTIES@STATICALLY_CHARGED@DESCRIPTION"
msgstr "Quando a unidade é atingida por um ataque corpo a corpo, o atacante sofre {STATICALLYCHARGED_DAMAGE>DAMAGE>Shock} {GLOBAL.LightningDamageConcept.Hyperlink}."

msgid "WILDLIFE_UNITPROPERTIES@STATICALLY_CHARGED@NAME"
msgstr "Carregado Estaticamente"

msgid "WILDLIFE_UNITPROPERTIES@SUMMON_GHOST@DESCRIPTION"
msgstr "Invoca uma Banshee enfraquecida no hexágono alvo.{LOC.CONCEPT@SUMMON_LIVE_SHARED}[br/][br/]Depois de usada, esta habilidade não pode ser reutilizada até que {GLOBAL.PROPERTIES.SPIRIT_BEACON.Hyperlink} seja acionado."

msgid "WILDLIFE_UNITPROPERTIES@SUMMON_GHOST@NAME"
msgstr "Invocar Fantasma"

msgid "WILDLIFE_UNITPROPERTIES@SWAMP_TROLL_RESISTANCES@NAME"
msgstr "Resistência ao Troll do Pântano"

msgid "WILDLIFE_UNITPROPERTIES@TAIL_SWIPE@DESCRIPTION"
msgstr "Ataca {amount} unidades adjacentes e remove sua {GLOBAL.DefenseModeConcept.Hyperlink} e {GLOBAL.RetaliationConcept.Hyperlink}.[br/]Entra em {GLOBAL.DefenseModeConcept.Hyperlink} após o uso."

msgid "WILDLIFE_UNITPROPERTIES@TAIL_SWIPE@NAME"
msgstr "Golpe de Cauda"

msgid "WILDLIFE_UNITPROPERTIES@TEMPESTUOUS_SMASH@DESCRIPTION"
msgstr "Causa dano à unidade alvo e às unidades inimigas em uma linha de {TEMPESTUOUS_SMASH_TARGETER>AREA>Length} hexágonos atrás dela."

msgid "WILDLIFE_UNITPROPERTIES@TEMPESTUOUS_SMASH@NAME"
msgstr "Esmagamento Tempestuoso"

msgid "WILDLIFE_UNITPROPERTIES@TENTACLE_VORTEX@DESCRIPTION"
msgstr "Causa dano aos inimigos adjacentes. Inimigos que estejam a {TENTACLE_VORTEX_OUTER_TARGETER>AREA>Radius} hexágonos de distância recebem metade do dano e são puxados para esta unidade."

msgid "WILDLIFE_UNITPROPERTIES@TENTACLE_VORTEX@NAME"
msgstr "Vórtice de Tentáculos"

msgid "WILDLIFE_UNITPROPERTIES@TERRIFYING_GORGING@DESCRIPTION"
msgstr "Tem uma chance base de {TERRIFYING_GORGING_RESISTANCE>ResolvedStrength}% de consumir a unidade inimiga de nível I, II ou III.[bulletlist][bullet/]Se bem-sucedido, cura esta unidade em +{TERRIFYING_GORGING_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Se resistido, causa {TERRIFYING_GORGING_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink} em vez disso.[/bulletlist][br/]Quando esta unidade é morta, a última unidade consumida é ressuscitada."

msgid "WILDLIFE_UNITPROPERTIES@TERRIFYING_GORGING@NAME"
msgstr "Devoração Aterrorizante"

msgid "WILDLIFE_UNITPROPERTIES@THROW_BOULDER@DESCRIPTION"
msgstr "Causa dano ao alvo."

msgid "WILDLIFE_UNITPROPERTIES@THROW_BOULDER@NAME"
msgstr "Arremessar Pedregulho"

msgid "WILDLIFE_UNITPROPERTIES@THROW_ICE_BOULDER@NAME"
msgstr "Arremessar Pedregulho de Gelo"

msgid "WILDLIFE_UNITPROPERTIES@THROW_RUNESTONE@DESCRIPTION"
msgstr "Invoca um {GLOBAL.UNITS.FIRE_RUNESTONE.Hyperlink} na localização alvo.{LOC.CONCEPT@SUMMON_LIVE_SHARED}"

msgid "WILDLIFE_UNITPROPERTIES@THROW_RUNESTONE@NAME"
msgstr "Conjurar Pedra Rúnica"

msgid "WILDLIFE_UNITPROPERTIES@THUNDERCLAP@DESCRIPTION"
msgstr "Unidades em um raio de {THUNDERCLAP_TARGETER>AREA>Radius} hexágonos:[bulletlist][bullet/]Sofrem dano.[bullet/]São deslocadas {THUNDERCLAP_DISPLACE>MaxDistance} hexágonos.[bullet/]Perdem seu {GLOBAL.DefenseModeConcept.Hyperlink}.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@THUNDERCLAP@ENHANCED_DESCRIPTION"
msgstr "Estrondo:[bulletlist][bullet/]Causa um adicional {THUNDERCLAP_ENHANCED_DAMAGE>DAMAGE>Shock}{GLOBAL.LightningDamageConcept.Hyperlink}.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@THUNDERCLAP@ENHANCED_NAME"
msgstr "Estrondo Aprimorado"

msgid "WILDLIFE_UNITPROPERTIES@THUNDERCLAP@MASTER_DESCRIPTION"
msgstr "Estrondo:[bulletlist][bullet/]Agora afeta um raio de {THUNDERCLAP_TARGETER_MASTER>AREA>Radius} hexágonos.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@THUNDERCLAP@MASTER_NAME"
msgstr "Estrondo do Campeão"

msgid "WILDLIFE_UNITPROPERTIES@THUNDERCLAP@NAME"
msgstr "Estrondo"

msgid "WILDLIFE_UNITPROPERTIES@TIDAL_WAVE@DESCRIPTION"
msgstr "Causa dano e empurra unidades para longe em um cone de {TIDAL_WAVE_TARGETER>AREA>Length} hexágonos."

msgid "WILDLIFE_UNITPROPERTIES@TIDAL_WAVE@NAME"
msgstr "Onda de Maré"

msgid "WILDLIFE_UNITPROPERTIES@TINY@DESCRIPTION"
msgstr "A unidade é muito pequena, tornando-a {TINY>ResolvedAccuracyModifier}% mais difícil de ser atingida por ataques {GLOBAL.RangedConcept.Hyperlink} e à distância {GLOBAL.MagicConcept.Hyperlink}."

msgid "WILDLIFE_UNITPROPERTIES@TINY@NAME"
msgstr "Minúsculo"

msgid "WILDLIFE_UNITPROPERTIES@TROLL_REGEN@DESCRIPTION"
msgstr "[bulletlist][bullet/]Cura {TROLL_REGENERATION_HEAL_OVER_TIME>ResolvedProportionHeal}% dos Pontos de Vida máximos como <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> ao final do seu turno em combate.[bullet/]Cura {TROLL_REGENERATION_STATS>BONUS>Regen}<<m:{GLOBAL.HitPointConcept.Hyperlink}>> no início do seu turno no mapa-múndi.[bullet/]Se esta unidade sofrer {GLOBAL.FireDamageConcept.Hyperlink}, a regeneração para por {TROLL_REGENERATION_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@TROLL_REGEN@NAME"
msgstr "Regeneração Natural do Troll"

msgid "WILDLIFE_UNITPROPERTIES@VIOLENT_GORGING@DESCRIPTION"
msgstr "Consome o cadáver alvo e cura +{VIOLENT_GORGING_DESTROY_DEAD>HealCasterAmount} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>."

msgid "WILDLIFE_UNITPROPERTIES@VIOLENT_GORGING@NAME"
msgstr "Devoração Violenta"

msgid "WILDLIFE_UNITPROPERTIES@VOLCANIC_SMASH@DESCRIPTION"
msgstr "Causa dano à unidade alvo e às unidades inimigas dentro de {VOLCANIC_SMASH_OUTER_TARGETER>AREA>Radius} hexágonos."

msgid "WILDLIFE_UNITPROPERTIES@VOLCANIC_SMASH@NAME"
msgstr "Esmagamento Vulcânico"

msgid "WILDLIFE_UNITPROPERTIES@WAIL_OF_THE_LOST@DESCRIPTION"
msgstr "Causa dano a unidades inimigas dentro de um raio de {WAIL_OF_THE_LOST_TAGETER>AREA>Radius} hexágonos."

msgid "WILDLIFE_UNITPROPERTIES@WAIL_OF_THE_LOST@NAME"
msgstr "Lamento dos Perdidos"

msgid "WILDLIFE_UNITPROPERTIES@WEB@DESCRIPTION"
msgstr "Unidades inimigas em um cone de {WEB_TARGETER>AREA>Length} hexágonos:[bulletlist][bullet/]Sofrem dano continuamente.[bullet/]Tornam‑se {GLOBAL.PROPERTIES.SLOWED.Hyperlink} por {duration} {GLOBAL.TurnConcept}[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@WEB@NAME"
msgstr "Teia"

msgid "WILDLIFE_UNITPROPERTIES@WET_ELEMENTAL@NAME"
msgstr "Encharcado"

msgid "WILDLIFE_UNITPROPERTIES@WET_ELEMENTAL@PROP"
msgstr "Inflige {GLOBAL.PROPERTIES.WET.Hyperlink}"

msgid "WILDLIFE_UNITPROPERTIES@WHITE_WOLF_RESISTANCE@NAME"
msgstr "Resistência do Lobo Branco"

msgid "WILDLIFE_UNITPROPERTIES@WILDHUNT_PRESENCE_01@DESCRIPTION"
