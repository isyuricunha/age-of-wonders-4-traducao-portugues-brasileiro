msgid "INTERFACE@STRATEGIC_MAP@DOMAIN"
msgstr "Domínio"

msgid "INTERFACE@STRATEGIC_MAP@DOMAIN_DESCRIPTION"
msgstr "A coleção de <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> pertencente à cidade. O Governante terá um {GLOBAL.ClaimConcept.Hyperlink} nas províncias adjacentes ao domínio da sua cidade. Unidades amigas precisam gastar {amount1} menos <<m:{GLOBAL.MovePointConcept.Hyperlink}>> para atravessar terrenos em domínios amistosos."

