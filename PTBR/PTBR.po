msgstr "{INT_0}/{INT_1} {GLOBAL.STRUCTURES.GOLDEN_ZIGGURAT.Hyperlink} examinada"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@STORYREALM_VICTORY@ALT@DESCRIPTION"
msgstr "Você forçou seu caminho até o anel mais alto de Emnora, vislumbrando o Alto Conselho dos Arcontes e seus segredos Celestiais."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@STORYREALM_VICTORY@ALT@VICTORY"
msgstr "Infiltrou os Arcontes!"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@STORYREALM_VICTORY@DESCRIPTION"
msgstr "Você se comunicou com o Alto Conselho dos Arcontes, convencendo‑os a lutar contra as forças de Urrath lado a lado com o Godir de Magehaven."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@STORYREALM_VICTORY@VICTORY"
msgstr "Contactou os Arcontes!"

