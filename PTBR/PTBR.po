msgid "NODES_STRATEGIC@NATURE_ROOT_NODE@NAME"
msgstr "Nó-Raiz da Natureza"

msgid "NODES_STRATEGIC@NODE@INCOME"
msgstr "{income}"

msgid "NODES_STRATEGIC@NODES@RUINED_ARCANIUMORE_NODE@NAME"
msgstr "Ruined Arcanium Ore^ns"

msgid "NODES_STRATEGIC@NODES@RUINED_ARCHONBLOOD_NODE@NAME"
msgstr "Ruined Archon Blood^ns"

msgid "NODES_STRATEGIC@NODES@RUINED_ASTRALDEW_NODE@NAME"
msgstr "Ruined Astral Dew^ns"

msgid "NODES_STRATEGIC@NODES@RUINED_FIREFORGESTONE_NODE@NAME"
msgstr "Ruined Fireforge Stone^ns"

msgid "NODES_STRATEGIC@NODES@RUINED_FISH_NODE@NAME"
msgstr "Ruined Fishing Grounds"

msgid "NODES_STRATEGIC@NODES@RUINED_FOCUSCRYSTALS_NODE@NAME"
msgstr "Ruined Focus Crystals^ns"

msgid "NODES_STRATEGIC@NODES@RUINED_FOOD_NODE@NAME"
msgstr "Ruined Pastures"

msgid "NODES_STRATEGIC@NODES@RUINED_GOLD_NODE@NAME"
msgstr "Ruined Gold Vein"

msgid "NODES_STRATEGIC@NODES@RUINED_HASTE_BERRIES_NODE@NAME"
msgstr "Ruined Haste Berries^ns"

msgid "NODES_STRATEGIC@NODES@RUINED_MANA_NODE@NAME"
msgstr "Ruined Mana Node"

msgid "NODES_STRATEGIC@NODES@RUINED_NODE@DESCRIPTION"
msgstr "This {GLOBAL.NodeConcept.Hyperlink} is ruined and provides no income or bonuses. It can be restored at a cost which will make it provide its income and bonuses again."

msgid "NODES_STRATEGIC@NODES@RUINED_OASIS_NODE@NAME"
msgstr "Ruined Oasis"

msgid "NODES_STRATEGIC@NODES@RUINED_PEARL_NODE@NAME"
msgstr "Ruined Pearl Reef"

msgid "NODES_STRATEGIC@NODES@RUINED_PRODUTION_NODE@NAME"
msgstr "Ruined Iron Deposit"

msgid "NODES_STRATEGIC@NODES@RUINED_RAINBOWCLOVER_NODE@NAME"
msgstr "Ruined Rainbow Clover^ns"

msgid "NODES_STRATEGIC@NODES@RUINED_SILVERTONGUEFRUIT_NODE@NAME"
msgstr "Ruined Silvertongue Fruit^ns"

msgid "NODES_STRATEGIC@NODES@RUINED_TRANQUILITYPOOL_NODE@NAME"
msgstr "Ruined Tranquility Pool^ns"

msgid "NODES_STRATEGIC@OASIS@DESCRIPTION"
msgstr "Um oásis exuberante repleto de alimentos nutritivos."

msgid "NODES_STRATEGIC@OASIS@NAME"
msgstr "Oásis"

msgid "NODES_STRATEGIC@ORDER_ROOT_NODE@DESCRIPTION"
msgstr "Este Nó-Raiz foi convertido para {GLOBAL.OrderConcept.Hyperlink} e está transbordando poder. Ele contribuirá para a Vitória Mágica."

msgid "NODES_STRATEGIC@ORDER_ROOT_NODE@NAME"
msgstr "Nó Raiz da Ordem"

msgid "NODES_STRATEGIC@OYSTER@DESCRIPTION"
msgstr "Uma floração de pérolas valiosas."

msgid "NODES_STRATEGIC@OYSTER@NAME"
msgstr "Recife de Pérolas"

msgid "NODES_STRATEGIC@PASTURES@DESCRIPTION"
msgstr "Rebanhos errantes em campos exuberantes."

msgid "NODES_STRATEGIC@PASTURES@NAME"
msgstr "Pastagens"

msgid "NODES_STRATEGIC@ROOT_NODE@DESCRIPTION"
msgstr "Um Nó-Raiz é um {GLOBAL.LocationConcept.Hyperlink} onde os fluxos mágicos do reino convergem em uma única fonte de poder. [br/][br/]Nós-Raiz podem ser convertidos para um {GLOBAL.AffinityConcept.Hyperlink} por meio de um {GLOBAL.WorldSpellConcept.Hyperlink}. Nós-Raiz convertidos fornecem recursos adicionais e contribuem para a Vitória Mágica. {LOC.AFFINITYCONTENT@NODE_CONVERSION@CASUSBELLIWARNING}"

msgid "NODES_STRATEGIC@ROOT_NODE@LORE"
msgstr "À medida que o poder de um Godir cresce, ele começa a desenvolver uma compreensão quase inata e sintonia com locais de ressonância poderosa. Os Nós Raiz são confluências fisicamente manifestas de magia ambiente presentes em toda a terra. Os Godir mais poderosos conseguem sentir esses locais e até manipular e alterar as magias latentes neles para refletir suas próprias afinidades."

msgid "NODES_STRATEGIC@ROOT_NODE@NAME"
msgstr "Nó-Raiz"

msgid "NODES_STRATEGIC@RUINED_NODE_SETTINGS@RUINED_NODE_RESTORATION_OPERATION@DESCRIPTION"
msgstr "Requires this location to be within your {GLOBAL.DomainConcept.Hyperlink} or occupied by one of your <<m:{GLOBAL.UnitConcept.Hyperlink}>>. Replaces this ruined node with a {NodeName}, providing income and bonuses again.[br/][br/]The cost of this action decreases per {GLOBAL.TurnConcept.Hyperlink} till it reaches a minimum cost."

msgid "NODES_STRATEGIC@RUINED_NODE_SETTINGS@RUINED_NODE_RESTORATION_OPERATION@NAME"
msgstr "Restore Node"

msgid "NODES_STRATEGIC@SHADOW_ROOT_NODE@DESCRIPTION"
msgstr "Este Nó Raiz foi convertido para {GLOBAL.ShadowConcept.Hyperlink} e está transbordando poder. Ele contribuirá para a Vitória Mágica."

msgid "NODES_STRATEGIC@SHADOW_ROOT_NODE@NAME"
msgstr "Nó-Raiz da Sombra"

msgid "ONBOARDING_OBJECTIVES@ANNEX_EXPLORATION_SITE@DESCRIPTION"
msgstr "Agora que você reivindicou este {GLOBAL.AncientWonderConcept.Hyperlink}, pode adicioná-lo ao seu domínio anexando-o a uma Cidade. Se não tiver uma cidade próxima, pode fundar um {GLOBAL.OutpostConcept.Hyperlink} em um setor adjacente e anexá-lo com ele."

msgid "ONBOARDING_OBJECTIVES@ANNEX_EXPLORATION_SITE@FINISHER@DESCRIPTION"
msgstr "Você anexou um {GLOBAL.AncientWonderConcept.Hyperlink} que agora fornecerá um rendimento poderoso em uma de suas <<m:{GLOBAL.CityConcept.Hyperlink}>>."

msgid "ONBOARDING_OBJECTIVES@ANNEX_EXPLORATION_SITE@INSTRUCTION"
msgstr "Maravilhas Ancestrais fornecem unidades únicas para o {GLOBAL.RequestMilitaryAidConcept.Hyperlink}, além de grandes quantidades de recursos, incluindo valiosos {GLOBAL.ImperiumConcept.Hyperlink}, quando são adicionadas ao seu império."

msgid "ONBOARDING_OBJECTIVES@ANNEX_EXPLORATION_SITE@NAME"
msgstr "Anexação de Maravilha Ancestral"

msgid "ONBOARDING_OBJECTIVES@ANNEX_EXPLORATION_SITE@OBJECTIVE"
msgstr "Maravilha Ancestral Anexada"

msgid "ONBOARDING_OBJECTIVES@ANNEX_WATER@DESCRIPTION"
msgstr "O domínio de uma de suas cidades se expandiu até a costa. Províncias na água podem ser anexadas como qualquer outra província, e a primeira Melhoria de Província construída na água se tornará automaticamente o porto daquela cidade. O porto de uma cidade é o local onde qualquer novo navio construído nessa cidade aparecerá. Expandir sua cidade para a água desbloqueará mais estruturas urbanas."

msgid "ONBOARDING_OBJECTIVES@ANNEX_WATER@NAME"
msgstr "Domine os Mares"

msgid "ONBOARDING_OBJECTIVES@ANNEX_WATER@OBJECTIVE"
msgstr "Província Aquática Anexada"

msgid "ONBOARDING_OBJECTIVES@DIPLOMACY_FIRST_CITY@DESCRIPTION"
msgstr "Você encontrou uma cidade livre amigável! Agora que estabeleceu contato, pode presenteá-los com um {GLOBAL.DiplomaticTokenConcept.Hyperlink}. Esse artefato influenciará a relação deles com você ao longo do tempo, até que estejam prontos para se tornarem seus vassalos."

msgid "ONBOARDING_OBJECTIVES@DIPLOMACY_FIRST_CITY@NAME"
msgstr "Negociando com Cidades Livres"

msgid "ONBOARDING_OBJECTIVES@DIPLOMACY_FIRST_CITY@OBJECTIVE"
msgstr "Pedra Sussurrante Atribuída"

msgid "ONBOARDING_OBJECTIVES@DIPLOMACY_FIRST_CITY_NO_WHISPERINGSTONE@DESCRIPTION"
msgstr "Você encontrou uma {GLOBAL.IndependentCityConcept.Hyperlink} amigável! Agora que estabeleceu contato, pode investigá-la e decidir como negociar."

msgid "ONBOARDING_OBJECTIVES@DIPLOMACY_FIRST_CITY_NO_WHISPERINGSTONE@INSTRUCTION"
msgstr "Se você tiver um {GLOBAL.DiplomaticTokenConcept.Hyperlink}, pode dar um a eles. Caso contrário, sua cultura pode oferecer outras formas de ganhar {GLOBAL.HouseInfluenceConcept.Hyperlink} sobre eles.[br/][br/]Quando {GLOBAL.HouseInfluenceConcept.Hyperlink} suficiente for obtido, a Cidade Livre se tornará seu {GLOBAL.PvEVassalConcept.Hyperlink} e poderá ser [hyperlink,GLOBAL.PactOfIntegrationConcept]integrada[/hyperlink]. Isso a transformará em uma cidade totalmente funcional sob seu controle direto. [br/][br/]Lembre-se do seu {GLOBAL.CityCapConcept.Hyperlink} para avaliar se deseja integrar uma cidade livre ou mantê-la como vassala!"

msgid "ONBOARDING_OBJECTIVES@DIPLOMACY_FIRST_CITY_NO_WHISPERINGSTONE@OBJECTIVE"
msgstr "Cidade Livre Investigada"

msgid "ONBOARDING_OBJECTIVES@EXPAND_ARMY@DESCRIPTION"
msgstr "Agora que você tem um segundo batedor, precisará de exércitos mais poderosos para reivindicar os locais valiosos que encontrar no reino. Você pode acessar novos tipos de unidades por meio de pesquisa e aprimoramento de suas cidades. [br/]Lembre-se: batedores não são feitos para combate, então construa seu {GLOBAL.ArmyConcept.Hyperlink} com sabedoria."

msgid "ONBOARDING_OBJECTIVES@EXPAND_ARMY@FINISHER@DESCRIPTION"
msgstr "Agora que você tem um exército suficiente, está pronto para expandir e conquistar. Exércitos são caros, então use-os bem. Envie-os com um {GLOBAL.HeroConcept.Hyperlink} para ganhar {GLOBAL.ExperienceConcept.Hyperlink} e descobrir novos <<m:{GLOBAL.NodeConcept.Hyperlink}>> ou possíveis locais de {GLOBAL.CityConcept.Hyperlink}."

msgid "ONBOARDING_OBJECTIVES@EXPAND_ARMY@FINISHER@DESCRIPTION_2"
msgstr "Não se esqueça de construir mais unidades. Conforme seu império cresce, você precisará de mais exércitos, e é uma boa ideia começar a construí-los cedo!"

msgid "ONBOARDING_OBJECTIVES@EXPAND_ARMY@NAME"
msgstr "Formando um Exército Completo"

msgid "ONBOARDING_OBJECTIVES@EXPAND_ARMY@OBJECTIVE"
msgstr "Exército de Seis Unidades Criado"

msgid "ONBOARDING_OBJECTIVES@EXPLORATION@DESCRIPTION"
msgstr "Você está prestes a começar a explorar seus arredores. Embora o vasto mundo tenha muitas coisas para descobrir, dois dos lugares mais valiosos que você pode encontrar são <<m:{GLOBAL.IndependentCityConcept.Hyperlink}>> e <<m:{GLOBAL.AncientWonderConcept.Hyperlink}>>."

msgid "ONBOARDING_OBJECTIVES@EXPLORATION@NAME"
msgstr "Exploração"

msgid "ONBOARDING_OBJECTIVES@EXPLORE_EXPLORATION_SITE@DESCRIPTION"
msgstr "Você descobriu uma {GLOBAL.AncientWonderConcept.Hyperlink}! Ela agora precisa ser explorada antes de ser reivindicada. Apenas exércitos liderados por um {GLOBAL.HeroConcept.Hyperlink} podem explorar Maravilhas Ancestrais. Durante a exploração, você pode encontrar obstáculos que podem ser superados de várias maneiras, embora sempre possam ser eliminados por meio de {GLOBAL.CombatConcept.Hyperlink}."

msgid "ONBOARDING_OBJECTIVES@EXPLORE_EXPLORATION_SITE@NAME"
msgstr "Exploração de Maravilha Ancestral"

msgid "ONBOARDING_OBJECTIVES@EXPLORE_EXPLORATION_SITE@OBJECTIVE"
msgstr "Maravilha Ancestral Explorada"

msgid "ONBOARDING_OBJECTIVES@FIND_EXPLORATION_SITE@DESCRIPTION"
msgstr "Maravilhas Ancestrais são alguns dos locais mais valiosos que podem ser encontrados em um reino. Existem três níveis diferentes de Maravilhas Ancestrais: bronze, prata e ouro. Quanto maior o nível de uma Maravilha Ancestral, mais desafiador será reivindicá-la para si."

msgid "ONBOARDING_OBJECTIVES@FIND_EXPLORATION_SITE@NAME"
msgstr "As Maravilhas Ancestrais"

msgid "ONBOARDING_OBJECTIVES@FIND_EXPLORATION_SITE@OBJECTIVE"
msgstr "Maravilha Ancestral Descoberta"

msgid "ONBOARDING_OBJECTIVES@FOOD_CITY@DESCRIPTION"
msgstr "Para que suas cidades cresçam e prosperem, é essencial que tenham renda suficiente de alimentos para um crescimento populacional saudável. Para aumentar a renda de alimentos de uma cidade, você pode construir fazendas nas províncias vizinhas e construir estruturas urbanas que forneçam renda de alimentos."

msgid "ONBOARDING_OBJECTIVES@FOOD_CITY@NAME"
msgstr "Uma Cidade Saudável"

msgid "ONBOARDING_OBJECTIVES@FOOD_CITY@OBJECTIVE"
msgstr "Aumente sua Renda de Comida"

msgid "ONBOARDING_OBJECTIVES@FOUND_CITY@DESCRIPTION"
msgstr "Seu novo Posto Avançado está pronto! Você pode transformá-lo em outra cidade gastando {GLOBAL.ImperiumConcept.Hyperlink}.[br/][br/]As cidades se desenvolvem com o tempo e são a principal fonte de renda do seu império.[br/][br/]No entanto, fique atento ao seu {GLOBAL.CityCapConcept.Hyperlink}, pois ultrapassar esse limite reduzirá a renda de todas as suas cidades."

msgid "ONBOARDING_OBJECTIVES@FOUND_CITY@FINISHER@DESCRIPTION"
msgstr "Parabéns, ó {PlayerLeader.Title}! Sua nova cidade está concluída e pode começar a crescer. Lembre-se de que {GLOBAL.FoodConcept.Hyperlink}, {GLOBAL.StructureProductionConcept.Hyperlink} e {GLOBAL.UnitProductionConcept.Hyperlink} não são compartilhados entre cidades, então cada cidade é responsável por seu próprio crescimento e construção."

msgid "ONBOARDING_OBJECTIVES@FOUND_CITY@FINISHER@INSTRUCTION"
msgstr "Se você já tiver um segundo {GLOBAL.HeroConcept.Hyperlink}, pode designar este herói como o novo {GLOBAL.GovernorConcept.Hyperlink} da sua cidade, concedendo bônus extras a ela."

msgid "ONBOARDING_OBJECTIVES@FOUND_CITY@FINISHER@SUMMARY"
msgstr "Tutorial sobre sua nova cidade"

msgid "ONBOARDING_OBJECTIVES@FOUND_CITY@NAME"
msgstr "Uma Nova Cidade"

msgid "ONBOARDING_OBJECTIVES@FOUND_CITY@OBJECTIVE"
msgstr "Cidade Fundada"

msgid "ONBOARDING_OBJECTIVES@FOUND_CITY@SUMMARY"
msgstr "Tutorial sobre fundação de cidades a partir de postos avançados"

msgid "ONBOARDING_OBJECTIVES@INFESTATION@DESCRIPTION"
msgstr "Infestações são locais perigosos que continuarão enviando exércitos contra você, queimando e saqueando seu reino... a menos que você ataque primeiro, é claro."

msgid "ONBOARDING_OBJECTIVES@INFESTATION@NAME"
msgstr "A Primeira Infestação"

msgid "ONBOARDING_OBJECTIVES@INFESTATION@OBJECTIVE"
msgstr "Infestação Destruída"

msgid "ONBOARDING_OBJECTIVES@INTEGRATE_FREE_CITY@DESCRIPTION"
msgstr "Você estabeleceu o primeiro contato! Quando {GLOBAL.HouseInfluenceConcept.Hyperlink} suficiente for obtido com um {GLOBAL.IndependentCityConcept.Hyperlink} e ele se tornar seu {GLOBAL.PvEVassalConcept.Hyperlink}, poderá ser integrado. [br/][br/] Integrar uma cidade livre a transformará em uma cidade totalmente funcional sob seu controle direto. Lembre-se do seu {GLOBAL.CityCapConcept.Hyperlink} para avaliar se deseja integrar uma cidade livre ou mantê-la como vassala!"

msgid "ONBOARDING_OBJECTIVES@INTEGRATE_FREE_CITY@FINISHER@DESCRIPTION"
msgstr "Uma {GLOBAL.IndependentCityConcept.Hyperlink} foi integrada com sucesso ao seu {GLOBAL.EmpireConcept.Hyperlink}, concedendo-lhe controle total sobre seus recursos e produção.[br/][br/]Se a cidade for de uma raça diferente da sua, você poderá construir unidades dessa raça. Também é possível migrar a cidade para sua própria raça na tela de [cityinformation/] Informações da Cidade. No entanto, isso é considerado um ato [evilact/] do Mal."

msgid "ONBOARDING_OBJECTIVES@INTEGRATE_FREE_CITY@NAME"
msgstr "Integração de Vassalo"

msgid "ONBOARDING_OBJECTIVES@INTEGRATE_FREE_CITY@OBJECTIVE"
msgstr "Cidade Livre Integrada"

msgid "ONBOARDING_OBJECTIVES@INTEGRATE_FREE_CITY_NO_WHISPERINGSTONE@DESCRIPTION"
msgstr "Quando {GLOBAL.HouseInfluenceConcept.Hyperlink} suficiente for obtido com um {GLOBAL.IndependentCityConcept.Hyperlink} e ele se tornar seu {GLOBAL.PvEVassalConcept.Hyperlink}, poderá ser [hyperlink,GLOBAL.PactOfIntegrationConcept]integrado[/hyperlink]. [br/][br/] Integrar uma cidade livre a transformará em uma cidade totalmente funcional sob seu controle direto. Lembre-se do seu {GLOBAL.CityCapConcept.Hyperlink} para avaliar se deseja integrar uma cidade livre ou mantê-la como vassala!"

msgid "ONBOARDING_OBJECTIVES@LEVEL_HERO@DESCRIPTION"
msgstr "Heróis são unidades poderosas, assim como seu Governante. Um exército pode conter vários heróis, mas lembre-se de que habilidades de suporte de herói que afetam todo o exército só serão concedidas às unidades desse exército pelo herói que for o líder. O herói de nível mais alto sempre será o líder do exército."

msgid "ONBOARDING_OBJECTIVES@LEVEL_HERO@NAME"
msgstr "Herói Digno"

msgid "ONBOARDING_OBJECTIVES@LEVEL_HERO@OBJECTIVE"
msgstr "Alcance o Nível 5 com um Herói"

msgid "ONBOARDING_OBJECTIVES@LEVEL_RULER@DESCRIPTION"
msgstr "Quando seu Governante ganhar experiência suficiente, ele subirá de nível. Cada vez que subir de nível, você poderá escolher uma habilidade de herói em Guerra, Magia de Batalha ou Suporte. A cada cinco níveis, seu herói poderá escolher uma habilidade de herói exclusiva. Essas são habilidades poderosas, únicas dos heróis, que podem virar a maré em combate e alterarão permanentemente a afinidade desse herói."

msgid "ONBOARDING_OBJECTIVES@LEVEL_RULER@NAME"
msgstr "Lidere pelo Exemplo"

msgid "ONBOARDING_OBJECTIVES@LEVEL_RULER@OBJECTIVE"
msgstr "Alcance o Nível 5 com um Governante"

msgid "ONBOARDING_OBJECTIVES@MEET_FREE_CITY@DESCRIPTION"
msgstr "Nem todas as <<m:{GLOBAL.CityConcept.Hyperlink}>> que você encontrar pertencerão aos seus oponentes. <<m:{GLOBAL.IndependentCityConcept.Hyperlink}>> são pequenas facções neutras que podem ser vassalizadas, integradas ou conquistadas. A velocidade é essencial, pois, uma vez que uma {GLOBAL.IndependentCityConcept.Hyperlink} jure um {GLOBAL.HouseInfluenceConcept.Hyperlink}, torna-se impossível convencê-la a se juntar a você. Uma cidade vassalizada fornecerá unidades para seu {GLOBAL.RequestMilitaryAidConcept.Hyperlink}."

msgid "ONBOARDING_OBJECTIVES@MEET_FREE_CITY@NAME"
msgstr "A Primeira Cidade Livre"

msgid "ONBOARDING_OBJECTIVES@MEET_FREE_CITY@OBJECTIVE"
msgstr "Descubra uma Cidade Livre Amigável"

msgid "ONBOARDING_OBJECTIVES@MULTI_SELECT@DESCRIPTION"
msgstr "Você pode selecionar vários exércitos de uma vez, permitindo movê-los em grupo."

msgid "ONBOARDING_OBJECTIVES@MULTI_SELECT@INSTRUCTIONS"
msgstr "[bulletlist][bullet/]Selecione um exército que você possui.[bullet/]Use SHIFT+[leftMouseButton/] para selecionar outro exército que você possui.[bullet/]Use [rightMouseButton/] para mover o primeiro exército.[bullet/]O segundo exército se moverá para ficar o mais próximo possível do primeiro.[/bulletlist][br/]Você pode selecionar até {amount} exércitos dessa forma."

msgid "ONBOARDING_OBJECTIVES@MULTI_SELECT@INSTRUCTIONS_CONTROLLER"
msgstr "[bulletlist][bullet/]Selecione um exército que você possui.[bullet/]Use [ci_rightstickpress/] para selecionar outro exército que você possui.[bullet/]Quando mover o primeiro exército, o segundo se moverá para ficar o mais próximo possível do primeiro.[/bulletlist][br/]Você pode selecionar até {amount} exércitos dessa forma."

msgid "ONBOARDING_OBJECTIVES@MULTI_SELECT@SUMMARY"
msgstr "Tutorial sobre mover vários exércitos de uma vez."

msgid "ONBOARDING_OBJECTIVES@MULTI_SELECT@TITLE"
msgstr "Selecionando Vários Exércitos"

msgid "ONBOARDING_OBJECTIVES@OUTPOST@DESCRIPTION"
msgstr "Você conseguiu derrotar sua primeira infestação! Infestações são frequentemente encontradas perto de <<m:{GLOBAL.NodeConcept.Hyperlink}>>, então esses são bons lugares para colocar <<m:{GLOBAL.OutpostConcept.Hyperlink}>>."

msgid "ONBOARDING_OBJECTIVES@OUTPOST@DESCRIPTION_2"
msgstr "Depois de construído, seu Posto Avançado pode ser atualizado para uma nova {GLOBAL.CityConcept.Hyperlink} gastando {GLOBAL.ImperiumConcept.Hyperlink}."

msgid "ONBOARDING_OBJECTIVES@OUTPOST@INSTRUCTION"
msgstr "Postos Avançados podem ser usados para {GLOBAL.ClaimConcept.Hyperlink} províncias próximas e podem coletar recursos de Nós de Recursos em seu domínio.[br/][br/]Você precisa de uma {GLOBAL.HeroConcept.Hyperlink} para construir um Posto Avançado em uma província."

msgid "ONBOARDING_OBJECTIVES@OUTPOST@INSTRUCTION_2"
msgstr "As cidades também podem fazer uso de {GLOBAL.FoodConcept.Hyperlink}, {GLOBAL.StructureProductionConcept.Hyperlink} e {GLOBAL.UnitProductionConcept.Hyperlink}, ao contrário dos Postos Avançados, que só podem coletar {GLOBAL.GoldConcept.Hyperlink}, {GLOBAL.ManaConcept.Hyperlink} e {GLOBAL.KnowledgeConcept.Hyperlink}."

msgid "ONBOARDING_OBJECTIVES@OUTPOST@NAME"
msgstr "Expansão por meio de Postos Avançados"

msgid "ONBOARDING_OBJECTIVES@OUTPOST@OBJECTIVE"
msgstr "Posto Avançado Construído"

msgid "ONBOARDING_OBJECTIVES@RESEARCH@DESCRIPTION"
msgstr "A pesquisa arcana do seu império está em dificuldades. Se desejamos desbloquear mais tomos de poder e os feitiços que eles contêm, devemos investir na construção de estruturas em nossas cidades que gerem renda de conhecimento."

msgid "ONBOARDING_OBJECTIVES@RESEARCH@NAME"
msgstr "Mais Conhecimento Necessário"

msgid "ONBOARDING_OBJECTIVES@RESEARCH@OBJECTIVE"
msgstr "Estrutura de Pesquisa Construída"

msgid "ONBOARDING_OBJECTIVES@SCOUTING@DESCRIPTION"
msgstr "Como costuma acontecer, conhecimento é poder. Para reunir informações sobre seus arredores, batedores são de extrema importância devido à sua velocidade e alcance de visão. Sem eles, seus rivais podem encontrar e reivindicar locais valiosos antes de você!"

msgid "ONBOARDING_OBJECTIVES@SCOUTING@NAME"
msgstr "Preparando-se para Explorar"

msgid "ONBOARDING_OBJECTIVES@SCOUTING@OBJECTIVE"
msgstr "[unitScout/] {GLOBAL.PROPERTIES.SCOUT_UNIT} Recrutado"

msgid "ONBOARDING_OBJECTIVES@SKIP_SHOW_OF_FORCE@DESCRIPTION"
msgstr "Agora que você tem um segundo batedor e um exército suficiente, está pronto para expandir e conquistar. Exércitos são caros, então use-os bem. Envie-os com um {GLOBAL.HeroConcept.Hyperlink} para ganhar {GLOBAL.ExperienceConcept.Hyperlink} e descobrir novos <<m:{GLOBAL.NodeConcept.Hyperlink}>> ou possíveis locais de {GLOBAL.CityConcept.Hyperlink}."

msgid "ONBOARDING_OBJECTIVES@SKIP_SHOW_OF_FORCE@NAME"
msgstr "Expanda e Conquiste"

msgid "ONBOARDING_OBJECTIVES@TO_BATTLE@DESCRIPTION"
msgstr "Seus exércitos precisam de um propósito para pagar sua manutenção. O uso comum para exércitos em tempos de paz é a eliminação de Guardas Saqueadores e Infestações ao redor do seu Império."

msgid "ONBOARDING_OBJECTIVES@TO_BATTLE@TITLE"
msgstr "À Batalha"

msgid "ONBOARDING_OBJECTIVES@TRANSFORM_RACE@DESCRIPTION"
msgstr "Um dos seus tomos de magia contém um novo feitiço poderoso capaz de transformar seu povo. Esses feitiços adicionam bônus poderosos ao seu povo, além de alterar sua aparência. Existem transformações menores e maiores. Uma raça pode ter várias transformações menores, embora algumas não possam ser combinadas com outras. Uma raça só pode ter uma transformação maior."

msgid "ONBOARDING_OBJECTIVES@TRANSFORM_RACE@NAME"
msgstr "Transformador"

msgid "ONBOARDING_OBJECTIVES@TRANSFORM_RACE@OBJECTIVE"
msgstr "Transforme sua Raça"

msgid "ONBOARDING_OBJECTIVES@VASSAL_FREE_CITY@DESCRIPTION"
msgstr "A velocidade de transformar uma cidade livre em seu vassalo pode ser aumentada gastando Império. Isso pode ser útil caso outro império concorra com você para obter a lealdade deles. Esteja ciente de que, se uma cidade livre for vassalizada, ela devolverá todas as Pedras Sussurrantes atribuídas a ela, exceto as de seu suserano."

msgid "ONBOARDING_OBJECTIVES@VASSAL_FREE_CITY@NAME"
msgstr "Vassalização de Cidade Livre"

msgid "ONBOARDING_OBJECTIVES@VASSAL_FREE_CITY@OBJECTIVE"
msgstr "Vassalizar uma Cidade Livre"

msgid "ONBOARDING_OBJECTIVES@VICTORY@DESCRIPTION"
