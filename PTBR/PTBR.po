msgid "DLC@THRONESOFBLOOD@HERO_SKILL@CATEGORY@NAME"
msgstr "Vampiro"

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@ABILITY_TYPE@NAME"
msgstr "Drenagem de Sangue"

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL01@DESCRIPTION"
msgstr "Causa dano à unidade alvo e cura em {DRAIN_LIFESTEAL>ResolvedHealProportion}% do dano causado.[br/][br/]Não pode atingir unidades imunes a {GLOBAL.PROPERTIES.BLEEDING.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL01@NAME"
msgstr "Mordida Drenante"

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL02@NAME"
msgstr "Sugar Sangue"

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL03@DESCRIPTION"
msgstr "{GLOBAL.PROPERTIES.DRAINING_BITE.Hyperlink} remove {GLOBAL.DefenseModeConcept.Hyperlink} e <<m:{GLOBAL.RetaliationConcept.Hyperlink}>> a menos que o alvo tenha {GLOBAL.PROPERTIES.CHARGE_RESISTANCE.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL03@MOD_DESCRIPTION"
msgstr "Cancela {GLOBAL.DefenseModeConcept.Hyperlink} e <<m:{GLOBAL.RetaliationConcept.Hyperlink}>> a menos que o alvo tenha {GLOBAL.PROPERTIES.CHARGE_RESISTANCE.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL03@NAME"
msgstr "Mordida Atordoante"

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL04@DESCRIPTION"
msgstr "Habilidades {GLOBAL.BloodDrainConcept.Hyperlink} têm uma chance base de {STUNNED_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.STUNNED.Hyperlink} por {STUNNED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL04@NAME"
msgstr "Drenagem Atordoante"

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL05@DESCRIPTION"
msgstr "Habilidades {GLOBAL.BloodDrainConcept.Hyperlink} agora têm chance de infligir {GLOBAL.PROPERTIES.MIND_CONTROLLED.Hyperlink} por {MIND_CONTROL_TEMP>NumTurns} <<m:{GLOBAL.TurnConcept}>> em vez de {GLOBAL.PROPERTIES.STUNNED.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL05@NAME"
msgstr "Encanto Drenante"

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL06@DESCRIPTION"
msgstr "Habilidades {GLOBAL.BloodDrainConcept.Hyperlink} agora têm chance de infligir {GLOBAL.PROPERTIES.DOMINATED.Hyperlink} em vez de {GLOBAL.PROPERTIES.MIND_CONTROLLED.Hyperlink}, que dura até o fim do combate."

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL06@NAME"
msgstr "Drenagem Hipnotizante"

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL07@DESCRIPTION"
msgstr "Causa dano inevitável à unidade aliada alvo. Então, o conjurador:[bulletlist][bullet/]Cura {DRAIN_FAMILIAR_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Ganha {amount} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} por {STRENGTHENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL07@NAME"
msgstr "Familiar Drenante"

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL08@ABILITY_DESCRIPTION"
msgstr "Causa dano inevitável à unidade aliada alvo, que ganha:[bulletlist][bullet/]{amount} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} por {STRENGTHENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][br/]Então, o conjurador:[bulletlist][bullet/]Cura {DRAIN_FAMILIAR_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Ganha {amount2} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} por {STRENGTHENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL08@DESCRIPTION"
msgstr "{GLOBAL.PROPERTIES.DRAIN_FAMILIAR.Hyperlink} agora concede à unidade alvo {amount} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL08@NAME"
msgstr "Força Profana"

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL09@ABILITY_DESCRIPTION"
msgstr "Causa dano inevitável à unidade aliada alvo. Ela ganha:[bulletlist][bullet/]{amount} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}[bullet/]{amount2} {GLOBAL.PROPERTIES.REGENERATION.Hyperlink}[/bulletlist][br/]O conjurador então:[bulletlist][bullet/]Cura {DRAIN_FAMILIAR_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Ganha {amount3} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} por {STRENGTHENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL09@DESCRIPTION"
msgstr "{GLOBAL.PROPERTIES.DRAIN_FAMILIAR.Hyperlink} também concede à unidade alvo {amount} {GLOBAL.PROPERTIES.REGENERATION.Hyperlink} e a cura é aumentada para {amount2} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>."

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL09@NAME"
msgstr "Laço Profundo"

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL10@DESCRIPTION"
msgstr "Reduz o tempo de recarga da sua habilidade {GLOBAL.BloodDrainConcept.Hyperlink} em {amount} {GLOBAL.TurnConcept}."

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL10@NAME"
msgstr "Fome Profunda"

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL11@DESCRIPTION"
msgstr "{GLOBAL.PROPERTIES.SIPHON_BLOOD.Hyperlink} ganha +{amount} de alcance."

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL11@NAME"
msgstr "Drenagem Alcançada"

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL12@DESCRIPTION"
msgstr "Sua habilidade {GLOBAL.BloodDrainConcept.Hyperlink} ignora {GLOBAL.DefenseConcept.Hyperlink} e {GLOBAL.ResistanceConcept.Hyperlink} de unidades que sofrem de {GLOBAL.PROPERTIES.BLEEDING.Hyperlink} ou {GLOBAL.PROPERTIES.BLOOD_PARASITE.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL12@MOD_DESCRIPTION"
msgstr "Ignora {SANGUINE_EXTRACTION_DEFENSE_BYPASS>MODIFIERS>ResolvedArmor}% de {GLOBAL.DefenseConcept.Hyperlink} e {GLOBAL.ResistanceConcept.Hyperlink} de unidades que sofrem de {GLOBAL.PROPERTIES.BLEEDING.Hyperlink} ou {GLOBAL.PROPERTIES.BLOOD_PARASITE.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL12@NAME"
msgstr "Extração Sanguínea"

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL13@DESCRIPTION"
msgstr "Quando os <<m:{GLOBAL.HitPointConcept.Hyperlink}>> desta unidade são reduzidos a zero, ela é deslocada em {MIST_AWAY_DISPLACEMENT>MaxDistance} hexes e cura +{hp} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[br/]Funciona uma vez por batalha."

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL13@NAME"
msgstr "Névoa Fugaz"

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL14@DESCRIPTION"
msgstr "Quando não estiver montada, esta unidade ganha:[bulletlist][bullet/]{GLOBAL.PROPERTIES.FLYING_MOVEMENT.Hyperlink} de movimento.[bullet/]{GLOBAL.PROPERTIES.FAST_MOVEMENT.Hyperlink}[bullet/]{VAMPIRIC_FLIGHT_ACCURACY>ResolvedAccuracyModifier}% de esquiva contra ataques {GLOBAL.RangedConcept.Hyperlink} e {GLOBAL.MagicConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL14@NAME"
msgstr "Voo Vampírico"

