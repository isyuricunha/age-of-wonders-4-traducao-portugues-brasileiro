msgid "HERO_SKILLS@WIZARD_KING_04@ABILITY@DESCRIPTION"
msgstr "[bulletlist][bullet/]Permite lançar um {GLOBAL.SpellConcept.Hyperlink} adicional neste {GLOBAL.TurnConcept.Hyperlink}.[bullet/]Cura em {CHANNELING_CASTER_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Entre em modo de defesa.[bullet/]Este efeito não é acumulável.[/bulletlist]"

