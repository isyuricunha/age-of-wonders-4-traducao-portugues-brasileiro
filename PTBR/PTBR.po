msgid "DLC@SECRETSOFTHEARCHMAGES@MINORFACTIONS_WORLD@RACE01@BIO"
msgstr "Os discípulos da {GLOBAL.HorwyndLoreConcept.Hyperlink} Escola de Guardiões foram originalmente encarregados de preservar o conhecimento da batalha e da guerra. Quando o {GLOBAL.ArchonsLoreConcept.Hyperlink} estabeleceu o <<m:{GLOBAL.CircleOfDeogaiLoreConcept.Hyperlink}>>, a Escola de guerreiros e cavaleiros honoráveis empregou seu poder sagrado para proteger os Portais para a <<m:{GLOBAL.ShroudedIsleConcept.Hyperlink}>> contra as forças invasoras e os agentes inquisitivos dos Arcontes."

msgid "DLC@SECRETSOFTHEARCHMAGES@MINORFACTIONS_WORLD@RACE01@NAME"
msgstr "Eruditos da Guarda"

msgid "DLC@SECRETSOFTHEARCHMAGES@MINORFACTIONS_WORLD@RACE02@BIO"
