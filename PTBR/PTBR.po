msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_WARCOORDINATION_UPDATE_RUNNING_PAUSED_DEFAULT"
msgstr "\"Infelizmente, minhas prioridades mudaram, {HouseALord.TitleName}. Talvez eu consiga retomar o progresso para cumprir a recompensa mais tarde.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_WARCOORDINATION_UPDATE_RUNNING_POSITIVE_DEFAULT"
msgstr "\"Meu exército está se aproximando do alvo, espero alcançá-lo em breve.\""

