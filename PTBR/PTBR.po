msgid "TOME_HERALD_DOOM@ABILITY_1@MASTER_DESCRIPTION"
msgstr "Grito da Banshee:[bulletlist][bullet/]Tem {WAIL_OF_THE_BANSHEE_RESISTANCE_CHECK_MASTER>ResolvedStrength}% de chance base de infligir seus efeitos.[bullet/]Causa {WAIL_OF_THE_BANSHEE_MASTER_DAMAGE>DAMAGE>Frost} adicional{GLOBAL.FrostDamageConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_HERALD_DOOM@ABILITY_1@MASTER_NAME"
