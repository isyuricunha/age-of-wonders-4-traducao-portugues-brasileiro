msgid "ONBOARDING_OBJECTIVES@DIPLOMACY_FIRST_CITY@NAME"
msgstr "Negociando com Cidades Livres"

msgid "ONBOARDING_OBJECTIVES@DIPLOMACY_FIRST_CITY@OBJECTIVE"
msgstr "Pedra de Sussurro Atribuída"

msgid "ONBOARDING_OBJECTIVES@DIPLOMACY_FIRST_CITY_NO_WHISPERINGSTONE@DESCRIPTION"
msgstr "Você encontrou um {GLOBAL.IndependentCityConcept.Hyperlink} amigável! Agora que estabeleceu contato, pode investigá‑lo e decidir como negociar."

msgid "ONBOARDING_OBJECTIVES@DIPLOMACY_FIRST_CITY_NO_WHISPERINGSTONE@INSTRUCTION"
msgstr "Se você possui um {GLOBAL.DiplomaticTokenConcept.Hyperlink}, pode dar um a eles. Caso contrário, sua cultura pode oferecer outras formas de obter {GLOBAL.HouseInfluenceConcept.Hyperlink} sobre eles.[br/][br/]Quando suficiente {GLOBAL.HouseInfluenceConcept.Hyperlink} for acumulado, a Cidade Livre se tornará seu {GLOBAL.PvEVassalConcept.Hyperlink}, e poderá ser [hyperlink,GLOBAL.PactOfIntegrationConcept]integrada[/hyperlink]. Isso a transformará em uma cidade plenamente funcional sob seu controle direto. [br/][br/]Fique atento ao seu {GLOBAL.CityCapConcept.Hyperlink} para avaliar se deseja integrar uma cidade livre ou mantê‑la como vassalo!"

msgid "ONBOARDING_OBJECTIVES@DIPLOMACY_FIRST_CITY_NO_WHISPERINGSTONE@OBJECTIVE"
