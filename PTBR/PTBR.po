msgid "STATUSEFFECTS_UNITPROPERTIES@MIND_CONTROLLED@MODIFIER_DESCRIPTION"
msgstr "Chance base de {MIND_CONTROL_RESISTANCE>ResolvedStrength}% de infligir {GLOBAL.PROPERTIES.MIND_CONTROLLED.Hyperlink} por {MIND_CONTROL_TEMP>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "STATUSEFFECTS_UNITPROPERTIES@MIND_CONTROLLED@NAME"
msgstr "Controlado pela Mente"

msgid "STATUSEFFECTS_UNITPROPERTIES@RALLYING@DESCRIPTION"
msgstr "[bulletlist][bullet/]Esta unidade ganha {RALLYING_CHANGE_MORALE>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink} no final de seu turno.[bullet/]Acumula até {stacksMax} vezes.[/bulletlist][br/][br/]Ajuntamento {GLOBAL.OpposingStatusEffectsConcept.Hyperlink} {GLOBAL.PROPERTIES.REMORSE.Hyperlink}."

msgid "STATUSEFFECTS_UNITPROPERTIES@RALLYING@NAME"
msgstr "Ajuntamento"

msgid "STATUSEFFECTS_UNITPROPERTIES@SPIRIT_DISTRACTED@ABILITY_DESCRIPTION"
msgstr "Todos os ataques que visam esta unidade são ataques {GLOBAL.FlankingConcept.Hyperlink}.[br/][br/]Distraído {GLOBAL.OpposingStatusEffectsConcept.Hyperlink} {GLOBAL.PROPERTIES.HYPER_AWARE.Hyperlink}."

msgid "STATUSEFFECTS_UNITPROPERTIES@SPIRIT_DISTRACTED@ABILITY_NAME"
msgstr "Distraído"

