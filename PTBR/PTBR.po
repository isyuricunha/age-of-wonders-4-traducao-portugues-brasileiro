msgstr "Titan Smithcraft"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@TITAN_XP_BONUS@DESC"
msgstr "<<m:{GLOBAL.UnitConcept.Hyperlink}>> nesta {GLOBAL.CityConcept.Hyperlink} são recrutados com +{Rankbonus1} de Rank [medalGold/]."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@TOOLTIP@ASTRA_CONVINCED"
msgstr "Você convence o {EventUnit} a ouvir {EventPlayer}."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@TOOLTIP@CASTING_POINT_BUFF"
