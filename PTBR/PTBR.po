msgid "CONCEPT@HERO_CLASS@WARLOCK@DESCRIPTION_SHORT"
msgstr "Bruxos são especialistas em penalidades e mortos-vivos, usando poderosas penalidades e fortalecendo invocações de mortos-vivos que eles erguem durante a batalha."

msgid "CONCEPT@HERO_CLASS@WARLOCK@GAMEPLAY_HYPERLINK"
