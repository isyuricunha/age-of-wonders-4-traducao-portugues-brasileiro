msgid "COMBATPROPERTIES_TACTICAL@SILVERTONGUE_WHISPERS@NAME"
msgstr "Sussurros Distrativos"

msgid "COMBATPROPERTIES_TACTICAL@SILVER_KNIGHT@DESCRIPTION"
msgstr "O duelista recebe dano reduzido de todas as unidades, exceto do líder de pilha do exército inimigo."

msgid "COMBATPROPERTIES_TACTICAL@SILVER_KNIGHT@NAME"
msgstr "Proteção do Duelista"

msgid "COMBATPROPERTIES_TACTICAL@SILVER_KNIGHT_TAUNT@DESCRIPTION"
msgstr "Os exércitos atacantes {GLOBAL.PROPERTIES.EXPEDITIONLEADER.Hyperlink} <<m:{GLOBAL.PROPERTIES.TAUNT.Hyperlink}>> o Cavaleiro de Prata até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@SILVER_KNIGHT_TAUNT@NAME"
msgstr "Provocando o Cavaleiro"

msgid "COMBATPROPERTIES_TACTICAL@SKELETON_SUMMON_ON_DEATH@DESCRIPTION"
msgstr "Sempre que um obstáculo Sarcófago for destruído, ele invoca um {GLOBAL.UNITS.SKELETON_UNIT.Hyperlink} do lado do defensor até o fim do combate."

msgid "COMBATPROPERTIES_TACTICAL@SKELETON_SUMMON_ON_DEATH@NAME"
msgstr "Caixões Assombrados"

msgid "COMBATPROPERTIES_TACTICAL@SLAVE_REVOLT@DESCRIPTION"
msgstr "No início da batalha, alguns unidades Cão de Guerra afetadas por {GLOBAL.PROPERTIES.BERSERK.Hyperlink} juntam-se ao combate ao lado das unidades defensoras."

msgid "COMBATPROPERTIES_TACTICAL@SLAVE_REVOLT@NAME"
msgstr "Animais Fugitivos"

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_INSANE_IMMUNITY@DESCRIPTION"
msgstr "Todas as unidades atacantes são imunes a {GLOBAL.PROPERTIES.INSANITY.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_INSANE_IMMUNITY@NAME"
msgstr "Estável Mentalmente"

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_IN_SHADOW@DESCRIPTION"
msgstr "A cada {GLOBAL.TurnConcept.Hyperlink}, 1 unidade atacante é alvo; se ela tem {GLOBAL.LowMoraleConcept.Hyperlink}, ganha {GLOBAL.PROPERTIES.INSANITY.Hyperlink}, caso contrário perde {value} {GLOBAL.UnitMoraleConcept.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_IN_SHADOW@NAME"
msgstr "Presença do Rei Morto"

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_IN_SHADOW_DISTRACTED@DESCRIPTION"
msgstr "Torne-se imune ao efeito {GLOBAL.PROPERTIES.SLOWED.Hyperlink} do Rei Morto, mas inicie o combate {GLOBAL.PROPERTIES.DISTRACTED.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_IN_SHADOW_DISTRACTED@NAME"
msgstr "Imunidade à Lentidão"

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_IN_SHADOW_FROST_RESISTANCE@DESCRIPTION"
msgstr "Todas as unidades atacantes iniciam o combate com {value} {GLOBAL.FrostResistanceConcept.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_IN_SHADOW_FROST_RESISTANCE@NAME"
msgstr "Proteção ao Gelo"

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_IN_SHADOW_INSANE_IMMUNE@DESCRIPTION"
msgstr "Esta unidade é imune a {GLOBAL.PROPERTIES.INSANITY.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_IN_SHADOW_INSANE_IMMUNE@NAME"
msgstr "Imunidade à Insanidade"

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_IN_SHADOW_RALLY@DESCRIPTION"
msgstr "As habilidades de apoio dos atacantes concedem um efeito {GLOBAL.PROPERTIES.RALLYING.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_IN_SHADOW_RALLY@NAME"
msgstr "Apoio de Ajuntamento"

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_IN_SHADOW_SLOWED@DESCRIPTION"
msgstr "O Rei Morto inflige {GLOBAL.PROPERTIES.SLOWED.Hyperlink} nos acertos."

msgid "COMBATPROPERTIES_TACTICAL@SLEEPER_IN_SHADOW_SLOWED@NAME"
msgstr "Letargia"

msgid "COMBATPROPERTIES_TACTICAL@SLOWED_ARMY@DESCRIPTION"
msgstr "No início da batalha, todas as unidades atacantes têm {GLOBAL.PROPERTIES.SLOWED.Hyperlink} por {time} [turn/]."

msgid "COMBATPROPERTIES_TACTICAL@SLOWED_ARMY@NAME"
msgstr "Atacantes Lentificados"

msgid "COMBATPROPERTIES_TACTICAL@SLOWED_ENEMIES@DESCRIPTION"
msgstr "No início da batalha, todas as unidades defensoras têm {GLOBAL.PROPERTIES.SLOWED.Hyperlink} por {time} [turn/]."

msgid "COMBATPROPERTIES_TACTICAL@SLOWED_ENEMIES@NAME"
msgstr "Defensores Lentificados"

msgid "COMBATPROPERTIES_TACTICAL@SLUMBERING_SOULS@DESCRIPTION"
msgstr "A cada {time} [turn/], uma unidade atacante torna‑se {GLOBAL.PROPERTIES.HAUNTED.Hyperlink}.[br/][br/]Se uma unidade {GLOBAL.PROPERTIES.HAUNTED.Hyperlink} ficar adjacente a um obstáculo Sarcófago, o Sarcófago é destruído e invocará um Esqueleto {GLOBAL.UnitConcept.Hyperlink} do lado do defensor."

msgid "COMBATPROPERTIES_TACTICAL@SLUMBERING_SOULS@NAME"
msgstr "Esqueletos Agitados"

msgid "COMBATPROPERTIES_TACTICAL@SLUMBERING_SOULS@PROPERTY@DESCRIPTION"
msgstr "Quando este efeito expira, qualquer obstáculo Sarcófago adjacente é destruído e invoca uma unidade Esqueleto {GLOBAL.UnitConcept.Hyperlink} do lado do defensor."

msgid "COMBATPROPERTIES_TACTICAL@SLUMBERING_SOULS@PROPERTY@NAME"
msgstr "Assombrado"

msgid "COMBATPROPERTIES_TACTICAL@SLUMBERING_SOULS_DELAYED@NAME"
msgstr "Esqueletos Agitados Atrasados"

msgid "COMBATPROPERTIES_TACTICAL@SOOTHING_WELLSPRING@DESCRIPTION"
msgstr "Unidades que estão {GLOBAL.PROPERTIES.WET.Hyperlink} curarão 5 [hp/] Pontos de Vida no início de seu turno."

msgid "COMBATPROPERTIES_TACTICAL@SOOTHING_WELLSPRING@NAME"
msgstr "Fonte Calmante"

msgid "COMBATPROPERTIES_TACTICAL@SPELL@DESCRIPTION"
msgstr "Adiciona {combatproperty} à batalha."

msgid "COMBATPROPERTIES_TACTICAL@SPIDERLAIR@DESCRIPTION"
msgstr "No início do combate, vários obstáculos de Teia de Aranha {GLOBAL.SlowingConcept.Hyperlink} estão presentes."

msgid "COMBATPROPERTIES_TACTICAL@SPIDERLAIR@NAME"
msgstr "Teias de Aranha Extensas"

msgid "COMBATPROPERTIES_TACTICAL@SPLITTING_MAGMA@DESCRIPTION"
msgstr "Quando um {GLOBAL.UNITS.MAGMA_SPIRIT.Hyperlink} defensor é morto, ele gera {amount} <<m:{GLOBAL.UNITS.LESSER_MAGMA_SPIRIT.Hyperlink}>>."

msgid "COMBATPROPERTIES_TACTICAL@SPLITTING_MAGMA@NAME"
msgstr "Divisão de Magma"

msgid "COMBATPROPERTIES_TACTICAL@SPRINGS_GROWTH@DESCRIPTION"
msgstr "Cada vez que as unidades do proprietário sofrem dano, ganham {amount} pilha(s) de {GLOBAL.PROPERTIES.REGENERATION.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@SPRINGS_GROWTH@NAME"
msgstr "Crescimento da Primavera"

msgid "COMBATPROPERTIES_TACTICAL@SPRINGS_GROWTH@SECTOR_DISPLAY@DESCRIPTION"
msgstr "{GLOBAL.PROPERTIES.COMBATPROPERTY_FEY_SPRING.Hyperlink} está ativo nesta província."

msgid "COMBATPROPERTIES_TACTICAL@SPRINGS_GROWTH@SECTOR_DISPLAY@NAME"
msgstr "Domínio da Primavera"

msgid "COMBATPROPERTIES_TACTICAL@SPRINGS_GROWTH@SPELL_DESCRIPTION"
msgstr "Adiciona {GLOBAL.PROPERTIES.COMBATPROPERTY_FEY_SPRING.Hyperlink} à batalha."

msgid "COMBATPROPERTIES_TACTICAL@STATUS_RESISTANCE_ARMY@DESCRIPTION"
msgstr "Unidades atacantes têm {amount} {GLOBAL.StatusResistanceConcept.Hyperlink} até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@STATUS_RESISTANCE_ENEMIES@DESCRIPTION"
msgstr "Unidades defensoras têm {amount} {GLOBAL.StatusResistanceConcept.Hyperlink} até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@STRENGTHENED_ARMY@DESCRIPTION"
msgstr "Todos os ataques das unidades atacantes causam {damage} de dano até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@STRENGTHENED_ARMY@NAME"
msgstr "Atacantes Fortalecidos"

msgid "COMBATPROPERTIES_TACTICAL@STRENGTHENED_ENEMIES@DESCRIPTION"
msgstr "Todos os ataques das unidades defensoras causam {damage} de dano até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@STRENGTHENED_ENEMIES@NAME"
msgstr "Defensores Fortalecidos"

msgid "COMBATPROPERTIES_TACTICAL@SUMMERS_HEAT@DESCRIPTION"
msgstr "No início do turno do proprietário, unidades inimigas adjacentes às unidades do proprietário têm {chance}% de chance de sofrer {GLOBAL.PROPERTIES.BURNING.Hyperlink} e sofrem {damage} por cada pilha de {GLOBAL.PROPERTIES.BURNING.Hyperlink} que possuam."

msgid "COMBATPROPERTIES_TACTICAL@SUMMERS_HEAT@NAME"
msgstr "Calor do Verão"

msgid "COMBATPROPERTIES_TACTICAL@SUMMERS_HEAT@SECTOR_DISPLAY@DESCRIPTION"
msgstr "{GLOBAL.PROPERTIES.COMBATPROPERTY_FEY_SUMMER.Hyperlink} está ativo nesta província."

msgid "COMBATPROPERTIES_TACTICAL@SUMMERS_HEAT@SECTOR_DISPLAY@NAME"
msgstr "Domínio do Verão"

msgid "COMBATPROPERTIES_TACTICAL@SUNDERED_ARMOR_ARMY@DESCRIPTION"
msgstr "Todas as unidades atacantes têm {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink} até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@SUNDERED_ARMOR_ARMY@NAME"
msgstr "Atacantes Desprotegidos"

msgid "COMBATPROPERTIES_TACTICAL@SUNDERED_ARMOR_ENEMIES@DESCRIPTION"
msgstr "Todas as unidades defensoras têm {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink} até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@SUNDERED_ARMOR_ENEMIES@NAME"
msgstr "Defensores Desprotegidos"

msgid "COMBATPROPERTIES_TACTICAL@SUNDERED_RESISTANCE_ARMY@DESCRIPTION"
msgstr "Todas as unidades atacantes têm {GLOBAL.PROPERTIES.SUNDERED_RESISTANCE.Hyperlink} até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@SUNDERED_RESISTANCE_ARMY@NAME"
msgstr "Atacantes Vulneráveis"

msgid "COMBATPROPERTIES_TACTICAL@SUNDERED_RESISTANCE_ENEMIES@DESCRIPTION"
msgstr "Todas as unidades defensoras têm {GLOBAL.PROPERTIES.SUNDERED_RESISTANCE.Hyperlink} até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@SUNDERED_RESISTANCE_ENEMIES@NAME"
msgstr "Defensores Vulneráveis"

msgid "COMBATPROPERTIES_TACTICAL@SUNDERED_STATUS_RESISTANCE_ARMY@NAME"
msgstr "Atacantes com Resistência de Status Despedaçada"

msgid "COMBATPROPERTIES_TACTICAL@SUNDERED_STATUS_RESISTANCE_ENEMIES@NAME"
msgstr "Defensores com Resistência de Status Despedaçada"

msgid "COMBATPROPERTIES_TACTICAL@THE_ONE@DESCRIPTION"
msgstr "A cada {GLOBAL.TurnConcept.Hyperlink}, as unidades do atacante perdem {MoraleValue} de moral."

msgid "COMBATPROPERTIES_TACTICAL@THE_ONE@NAME"
msgstr "O Lamento"

msgid "COMBATPROPERTIES_TACTICAL@UNDEADQUEEN@DESCRIPTION"
msgstr "Matar a Rainha Morta-viva matará imediatamente todos os seus [abilityred]Servos Mortos-vivos[/abilityred]."

msgid "COMBATPROPERTIES_TACTICAL@UNDEADQUEEN@NAME"
msgstr "Rainha Morta-viva"

msgid "COMBATPROPERTIES_TACTICAL@WAVE_OF_TRANQUILITY@DESCRIPTION"
msgstr "A cada {turn} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, todos os Efeitos de Status em todas as unidades são dissipados."

msgid "COMBATPROPERTIES_TACTICAL@WAVE_OF_TRANQUILITY@NAME"
msgstr "Onda de Tranquilidade"

msgid "COMBATPROPERTIES_TACTICAL@WEAKENED_ARMY@DESCRIPTION"
msgstr "Todas as unidades atacantes tornam-se {GLOBAL.PROPERTIES.WEAKENED.Hyperlink} até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@WEAKENED_ARMY@NAME"
msgstr "Atacantes Enfraquecidos"

msgid "COMBATPROPERTIES_TACTICAL@WEAKENED_ENEMIES@DESCRIPTION"
msgstr "Todas as unidades defensoras tornam-se {GLOBAL.PROPERTIES.WEAKENED.Hyperlink} até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@WEAKENED_ENEMIES@NAME"
msgstr "Defensores Enfraquecidos"

msgid "COMBATPROPERTIES_TACTICAL@WINTERS_SORROW@DESCRIPTION"
msgstr "Unidades inimigas sofrem {amount} pilha(s) de {GLOBAL.PROPERTIES.DEMORALIZED.Hyperlink} sempre que matam outra unidade."

msgid "COMBATPROPERTIES_TACTICAL@WINTERS_SORROW@NAME"
msgstr "Lamento Invernal"

msgid "COMBATPROPERTIES_TACTICAL@WINTERS_SORROW@SECTOR_DISPLAY@DESCRIPTION"
msgstr "{GLOBAL.PROPERTIES.COMBATPROPERTY_FEY_WINTER.Hyperlink} está ativo nesta província."

msgid "COMBATPROPERTIES_TACTICAL@WINTERS_SORROW@SECTOR_DISPLAY@NAME"
msgstr "Domínio do Inverno"

msgid "COMBAT_TUTORIAL@ACCURACY@DESCRIPTION"
msgstr "Esta {GLOBAL.UnitConcept.Hyperlink} tem uma habilidade à distância selecionada. Habilidades à distância têm uma classificação {GLOBAL.AccuracyConcept}, que é a chance da habilidade acertar o alvo pretendido."

msgid "COMBAT_TUTORIAL@ACCURACY@DESCRIPTION_SECONDARY"
msgstr "Se uma habilidade errar, ela atingirá outro alvo ou não fará nada. Algumas habilidades também podem arranhar, o que significa que a habilidade afetou o alvo, porém com força reduzida."

msgid "COMBAT_TUTORIAL@ACCURACY@TITLE"
msgstr "Precisão"

msgid "COMBAT_TUTORIAL@ACTION_POINTS@DESCRIPTION"
msgstr "Você selecionou um(a) {GLOBAL.UnitConcept.Hyperlink}. Ele(a) tem 3 <<m:{GLOBAL.ActionPointConcept}>> para gastar em movimento e uso de habilidades."

msgid "COMBAT_TUTORIAL@ACTION_POINTS@DESCRIPTION_SECONDARY"
msgstr "Habilidades diferentes têm custos diferentes de [actionpoint/], e algumas são acionadas uma vez por ponto de ação disponível. Usar uma habilidade quase sempre encerra o turno da unidade![br/][br/]Ao planejar o movimento, você pode ver a quantidade de [fullaction/] pontos de ação que terá disponível no destino."

msgid "COMBAT_TUTORIAL@ACTION_POINTS@TITLE"
msgstr "Pontos de Ação"

msgid "COMBAT_TUTORIAL@AI_TAKEOVER_NPC@DESCRIPTION"
msgstr "Você assumiu temporariamente o comando de um exército Independente.[br/][br/]Enquanto estiver no controle de uma {GLOBAL.IndependentCityConcept.Hyperlink} ou <<m:GLOBAL.MarauderConcept.Hyperlink>>, pode emitir ordens para seus <<m:GLOBAL.UnitConcept.Hyperlink>>. A capacidade de lançar <<m:GLOBAL.CombatSpellConcept.Hyperlink>> está desativada durante o turno Independente."

msgid "COMBAT_TUTORIAL@AI_TAKEOVER_NPC@TITLE"
msgstr "Tomada de Controle em Combate: Independentes"

msgid "COMBAT_TUTORIAL@AI_TAKEOVER_PLAYER@DESCRIPTION"
msgstr "Você assumiu temporariamente o comando de um exército pertencente a um(a) {GLOBAL.LeaderConcept.Hyperlink} de IA.[br/][br/]Ao assumir o controle de um Governante de IA, você pode comandar suas <<m:GLOBAL.UnitConcept.Hyperlink>> e usar seus <<m:GLOBAL.CombatSpellConcept.Hyperlink>> durante o combate."

msgid "COMBAT_TUTORIAL@AI_TAKEOVER_PLAYER@TITLE"
msgstr "Tomada de Controle em Combate: Governante de IA"

msgid "COMBAT_TUTORIAL@BATTLE_MAGE_UNITS@DESCRIPTION"
msgstr "Este é um {GLOBAL.UnitConcept.Hyperlink} Mago de Batalha, que se destaca em causar dano mágico e aplicar efeitos de status. É vulnerável a ataques {GLOBAL.MeleeConcept} e deve ser mantido na linha de trás."

msgid "COMBAT_TUTORIAL@BATTLE_MAGE_UNITS@TITLE"
msgstr "[unitBattleMage/]Unidades de Mago de Batalha"

msgid "COMBAT_TUTORIAL@CASUALTIES@DESCRIPTION"
msgstr "Esta {GLOBAL.UnitConcept.Hyperlink} sofreu <<m:{GLOBAL.CasualtyConcept}>>. Baixas ocorrem quando uma unidade recebe dano, o que também faz com que a unidade cause menos dano em seus ataques."

msgid "COMBAT_TUTORIAL@CASUALTIES@DESCRIPTION_SECONDARY"
msgstr "Unidades representadas por uma única figura, como <<m:{GLOBAL.HeroConcept}>> e gigantes, são imunes a baixas."

msgid "COMBAT_TUTORIAL@CASUALTIES@TITLE"
msgstr "Baixas"

msgid "COMBAT_TUTORIAL@COMBAT_STARTS@DESCRIPTION"
msgstr "Bem-vindo ao campo de batalha! Aqui você deve matar ou fazer fugir seus inimigos para conquistar a vitória."

msgid "COMBAT_TUTORIAL@COMBAT_STARTS@DESCRIPTION_SECONDARY"
msgstr "O {GLOBAL.ArmyConcept} defensor sempre tem a primeira rodada, seguida pelo exército atacante."

msgid "COMBAT_TUTORIAL@COMBAT_STARTS@TITLE"
msgstr "A Batalha Começa"

msgid "COMBAT_TUTORIAL@FLANKING@DESCRIPTION"
msgstr "Seu {GLOBAL.UnitConcept.Hyperlink} acabou de atacar um inimigo por trás. Isso é chamado de {GLOBAL.FlankingConcept}, e concede um bônus de dano."

msgid "COMBAT_TUTORIAL@FLANKING@DESCRIPTION_SECONDARY"
msgstr "Lembre-se de que unidades em {GLOBAL.DefenseModeConcept.Hyperlink} não podem ser flanqueadas!"

msgid "COMBAT_TUTORIAL@FLANKING@TITLE"
msgstr "Ataques de Flanco"

msgid "COMBAT_TUTORIAL@LEADER@DESCRIPTION"
msgstr "Você selecionou seu {GLOBAL.LeaderConcept}. Seu Governante é um combatente poderoso que pode empunhar equipamentos mágicos e aprender uma variedade de habilidades."

msgid "COMBAT_TUTORIAL@LEADER@DESCRIPTION_SECONDARY"
msgstr "Se o seu Governante [hyperlink,GLOBAL.RulerVoidConcept]cair[/hyperlink] em combate, ele retornará ao seu {GLOBAL.ThroneCityConcept.Hyperlink} após um curto período."

msgid "COMBAT_TUTORIAL@LEADER@TITLE"
msgstr "[unitRuler/]Governantes em Batalha"

msgid "COMBAT_TUTORIAL@LOW_MORALE@DESCRIPTION"
msgstr "Um(a) {GLOBAL.UnitConcept.Hyperlink} tem [hyperlink,GLOBAL.LowMoraleConcept]Baixo Moral[/hyperlink], porque a maré da batalha está se voltando contra ele. Unidades com baixo moral podem {GLOBAL.FumbleConcept} ataques, enquanto alto moral pode levar a [hyperlink,GLOBAL.CriticalHitConcept]Ataques Críticos[/hyperlink]."

msgid "COMBAT_TUTORIAL@LOW_MORALE@DESCRIPTION_SECONDARY"
msgstr "Se o moral de uma unidade cair muito, ela começará a {GLOBAL.RoutingConcept.Hyperlink} e fugirá do campo de batalha."

msgid "COMBAT_TUTORIAL@LOW_MORALE@TITLE"
msgstr "Moral da Unidade"

msgid "COMBAT_TUTORIAL@MAGIC_FIGHTER_UNITS@DESCRIPTION"
msgstr "Este é um {GLOBAL.UnitConcept.Hyperlink} Lutador Mágico, um combatente de linha de frente corpo a corpo. Ele se especializa em ataques {GLOBAL.MagicConcept.Hyperlink}, tornando-o ideal para danificar unidades com alta {GLOBAL.DefenseConcept.Hyperlink} como Unidades de Escudo."

msgid "COMBAT_TUTORIAL@MAGIC_FIGHTER_UNITS@TITLE"
msgstr "[unitMagicFighter/]Unidades de Lutador Mágico"

msgid "COMBAT_TUTORIAL@POLEARM_UNIT@DESCRIPTION"
msgstr "Este é um {GLOBAL.UnitConcept.Hyperlink} de Haste, um combatente de linha de frente corpo a corpo. Com suas habilidades {GLOBAL.FirstStrikeConcept} e [hyperlink,GLOBAL.ChargeConcept]Carga[/hyperlink] Resistência, ele está perfeitamente preparado para absorver ataques {GLOBAL.MeleeConcept} inimigos."

msgid "COMBAT_TUTORIAL@POLEARM_UNIT@TITLE"
msgstr "[unitPolearm/]Unidades de Haste"

msgid "COMBAT_TUTORIAL@RANGED_UNIT@DESCRIPTION"
msgstr "Este é um {GLOBAL.UnitConcept.Hyperlink} à Distância, que se destaca em causar dano físico à distância. É vulnerável a ataques {GLOBAL.MeleeConcept} e deve ser mantido na linha de trás."

msgid "COMBAT_TUTORIAL@RANGED_UNIT@TITLE"
msgstr "[unitRanged/]Unidades à Distância"

msgid "COMBAT_TUTORIAL@RETALIATION@DESCRIPTION"
msgstr "Um(a) {GLOBAL.UnitConcept.Hyperlink} acabou de ser atingido(a) por um(a) {GLOBAL.RetaliationConcept.Hyperlink}. Isso ocorre quando uma unidade {GLOBAL.MeleeConcept} é atingida de dentro de sua Zona de Controle."

msgid "COMBAT_TUTORIAL@RETALIATION@DESCRIPTION_SECONDARY"
msgstr "Uma unidade tem um número limitado de <<m:{GLOBAL.RetaliationConcept.Hyperlink}>> por turno, indicado por marcas vermelhas sob sua bandeira."

msgid "COMBAT_TUTORIAL@RETALIATION@TITLE"
msgstr "Retaliação"

msgid "COMBAT_TUTORIAL@SCOUT_UNIT@DESCRIPTION"
msgstr "Este é um Batedor {GLOBAL.UnitConcept.Hyperlink}, que é fraco e deve ser mantido fora de combate. Se for forçado a lutar, sua alta velocidade e ataques à distância o tornam uma boa unidade para {GLOBAL.FlankingConcept}."

msgid "COMBAT_TUTORIAL@SCOUT_UNIT@TITLE"
msgstr "[unitScout/]Unidades Batedor"

msgid "COMBAT_TUTORIAL@SHIELD_UNIT@DESCRIPTION"
msgstr "Esta é uma Escudo {GLOBAL.UnitConcept.Hyperlink}, um combatente de linha de frente {GLOBAL.MeleeConcept}. Ao entrar em {GLOBAL.DefenseModeConcept}, concede um bônus aos aliados adjacentes, protegendo-os contra dano físico."

msgid "COMBAT_TUTORIAL@SHIELD_UNIT@TITLE"
msgstr "[unitShield/]Unidades Escudo"

msgid "COMBAT_TUTORIAL@SHOCK_UNITS@DESCRIPTION"
msgstr "Este é um Choque {GLOBAL.UnitConcept.Hyperlink}, um combatente corpo a corpo poderoso especializado em <<m:{GLOBAL.ChargeConcept}>> de alto dano. Seus ataques podem cancelar {GLOBAL.DefenseModeConcept}, o que o torna forte contra Unidades Escudo e Unidades de Suporte."

msgid "COMBAT_TUTORIAL@SHOCK_UNITS@TITLE"
msgstr "[unitShock/]Unidades Choque"

msgid "COMBAT_TUTORIAL@SKIRMISHER_UNIT@DESCRIPTION"
msgstr "Este é um Escaramuçador {GLOBAL.UnitConcept.Hyperlink}, que é flexível e usa ataques à distância e {GLOBAL.MeleeConcept}. Com sua alta velocidade e a habilidade Escorregadio, é a unidade perfeita para ataques de golpe e fuga."

msgid "COMBAT_TUTORIAL@SKIRMISHER_UNIT@TITLE"
msgstr "[unitSkirmisher/]Unidades Escaramuçador"

msgid "COMBAT_TUTORIAL@SPELL_CASTING@DESCRIPTION"
msgstr "Seus Feitiços estão prontos para serem lançados! Feitiços podem ter uma variedade de efeitos poderosos e podem mudar o rumo da batalha quando usados corretamente."

msgid "COMBAT_TUTORIAL@SPELL_CASTING@DESCRIPTION_SECONDARY"
msgstr "Feitiços não estão disponíveis no primeiro turno de combate e requerem {GLOBAL.ManaConcept.Hyperlink} e <<m:{GLOBAL.CombatCastingPointConcept.Hyperlink}>> para serem usados."

msgid "COMBAT_TUTORIAL@SPELL_CASTING@TITLE"
msgstr "Conjuração de Feitiço"

msgid "COMBAT_TUTORIAL@SUPPORT_UNITS@DESCRIPTION"
msgstr "Esta é uma Unidade de Suporte {GLOBAL.UnitConcept.Hyperlink}, que pode usar habilidades mágicas para curar e fortalecer seus aliados."

msgid "COMBAT_TUTORIAL@SUPPORT_UNITS@INSTRUCTION"
msgstr "Ao entrar em {GLOBAL.DefenseModeConcept.Hyperlink}, concede um bônus aos aliados adjacentes, protegendo-os contra ataques mágicos."

msgid "COMBAT_TUTORIAL@SUPPORT_UNITS@TITLE"
msgstr "[unitSupport/]Unidades de Suporte"

msgid "COMBAT_TUTORIAL@ZONE_OF_CONTORL@DESCRIPTION"
msgstr "Sua {GLOBAL.UnitConcept.Hyperlink} está na Zona de Controle de um inimigo. Quando uma unidade entra na zona de controle do inimigo, ela fica temporariamente presa e não pode se mover pelo resto do turno."

msgid "COMBAT_TUTORIAL@ZONE_OF_CONTORL@DESCRIPTION_SECONDARY"
msgstr "Sair de uma Zona de Controle pode desencadear um {GLOBAL.OpportunityAttackConcept}.[br/][br/]Enquanto estiver em uma Zona de Controle inimiga, muitas habilidades à distância e mágicas ficarão indisponíveis."

msgid "COMBAT_TUTORIAL@ZONE_OF_CONTORL@TITLE"
msgstr "Zona de Controle"

msgid "CONCEPT@ACCURACY@DESCRIPTION"
msgstr "Precisão é a probabilidade de ataques acertarem com sucesso. Se o ataque não acertar, ele erra ou arranha o alvo.[bulletlist][bullet/]Arranhões causam metade do dano.[bullet/]Erros não causam dano algum.[bullet/]Erros podem atingir unidades adjacentes aleatórias ao lado do alvo.[/bulletlist]"

msgid "CONCEPT@ACCURACY@HYPERLINK"
msgstr "[hyperlink,GLOBAL.AccuracyConcept][accuracy/] Precisão[/hyperlink]"

msgid "CONCEPT@ACCURACY@NAME"
msgstr "[accuracy/]Precisão"

msgid "CONCEPT@ACTION_POINTS@DESCRIPTION"
msgstr "[bulletlist][bullet/]<<m:{GLOBAL.UnitConcept.Hyperlink}>> usa Pontos de Ação para atacar e usar habilidades.[bullet/]Unidades recebem 3 Pontos de Ação por {GLOBAL.TurnConcept}, e podem usar até 2 deles para mover.[/bulletlist][br/][br/]Habilidades usam Pontos de Ação de diferentes maneiras:[bulletlist][bullet/][singleuseaction/] {LOC.CONCEPT@ACTION_POINTS@DESCRIPTION_SINGLE}[bullet/][repeatingaction/] {LOC.CONCEPT@ACTION_POINTS@DESCRIPTION_REPEATING}[bullet/][fullaction/]{LOC.CONCEPT@ACTION_POINTS@DESCRIPTION_FULL}[bullet/][freeaction/] {LOC.CONCEPT@ACTION_POINTS@DESCRIPTION_FREE}[bullet/][leaveoneaction/] {LOC.CONCEPT@ACTION_POINTS@DESCRIPTION_LEAVE_ONE}[bullet/][fullactioncontinue/] {LOC.CONCEPT@ACTION_POINTS@DESCRIPTION_FULL_ACTION_CONTINUE}[/bulletlist]"

msgid "CONCEPT@ACTION_POINTS@DESCRIPTION_FREE"
msgstr "A habilidade custa 0 pontos de ação."

msgid "CONCEPT@ACTION_POINTS@DESCRIPTION_FULL"
msgstr "A habilidade custa 3 pontos de ação. O turno da unidade termina em seguida."

msgid "CONCEPT@ACTION_POINTS@DESCRIPTION_FULL_ACTION_CONTINUE"
msgstr "A habilidade requer 3 pontos de ação. A unidade mantém 1 ponto de ação depois."

msgid "CONCEPT@ACTION_POINTS@DESCRIPTION_LEAVE_ONE"
msgstr "A habilidade custa 0 pontos de ação. A unidade mantém 1 ponto de ação depois."

msgid "CONCEPT@ACTION_POINTS@DESCRIPTION_REPEATING"
msgstr "A habilidade dispara uma vez por ponto de ação restante. O turno da unidade termina em seguida."

msgid "CONCEPT@ACTION_POINTS@DESCRIPTION_SINGLE"
msgstr "A habilidade custa um ponto de ação. O turno da unidade termina em seguida."

msgid "CONCEPT@ACTION_POINTS@HYPERLINK"
msgstr "[hyperlink,GLOBAL.ActionPointConcept]Ponto de Ação[/hyperlink]"

msgid "CONCEPT@ACTION_POINTS@NAME"
msgstr "Ponto de Ação"

msgid "CONCEPT@BASE_ABILITY@DESCRIPTION"
msgstr "Um ataque básico é um ataque normal que uma unidade pode normalmente usar a cada turno em combate.[br/][br/]Alguns <<m:{GLOBAL.UnitEnchantmentConcept.Hyperlink}>> afetam apenas os ataques básicos da unidade."

msgid "CONCEPT@BASE_ABILITY@HYPERLINK"
msgstr "[hyperlink,GLOBAL.BaseAbilityConcept]Base[/hyperlink]"

msgid "CONCEPT@BASE_ABILITY@NAME"
msgstr "Ataque Básico"

msgid "CONCEPT@BLIGHT_DAMAGE@DESCRIPTION"
msgstr "Inflige [damageBlight/] Dano de Calamidade."

msgid "CONCEPT@BLIGHT_DAMAGE@HYPERLINK"
msgstr "[damageBlight/] [hyperlink,GLOBAL.BlightDamageConcept]Dano de Calamidade[/hyperlink]"

msgid "CONCEPT@BLIGHT_DAMAGE@NAME"
msgstr "Dano de Calamidade"

msgid "CONCEPT@BLIGHT_RESISTANCE@DESCRIPTION"
msgstr "Proteção contra Calamidade reduz {GLOBAL.BlightDamageConcept.Hyperlink}."

msgid "CONCEPT@BLIGHT_RESISTANCE@HYPERLINK"
msgstr "[defenseblight/] [hyperlink,GLOBAL.BlightResistanceConcept]Proteção contra Calamidade[/hyperlink]"

msgid "CONCEPT@BLIGHT_RESISTANCE@NAME"
msgstr "Proteção contra Calamidade"

msgid "CONCEPT@CASUALTIES@DESCRIPTION"
msgstr "Quando um {GLOBAL.UnitConcept.Hyperlink} sustenta dano, membros da unidade são perdidos.[br/][br/]Cada membro perdido reduz proporcionalmente o dano causado pela unidade. A chance da unidade de aplicar <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>> também diminui.[br/][br/]Um {GLOBAL.LeaderConcept.Hyperlink} ou {GLOBAL.HeroConcept.Hyperlink} e grandes monstros têm apenas um membro e não são afetados por esta regra."

msgid "CONCEPT@CASUALTIES@HYPERLINK"
msgstr "[hyperlink,GLOBAL.CasualtyConcept]Baixa[/hyperlink]"

msgid "CONCEPT@CASUALTIES@NAME"
msgstr "Baixa"

msgid "CONCEPT@CHARGE@DESCRIPTION"
msgstr "Um ataque de Carga:[bulletlist][bullet/]Ganha dano extra por hexágono percorrido, até {GLOBAL.ChargeHexes} hexágonos.[bullet/]Cancela {GLOBAL.DefenseModeConcept.Hyperlink}.[bullet/]Remove {GLOBAL.RetaliationConcept.Hyperlink}.[/bulletlist][br/][br/]Esses efeitos são anulados por {GLOBAL.PROPERTIES.CHARGE_RESISTANCE.Hyperlink}, a menos que o ataque seja um {GLOBAL.PROPERTIES.HEAVYMELEESTRIKE.Hyperlink}."

msgid "CONCEPT@CHARGE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.ChargeConcept]Carga[/hyperlink]"

msgid "CONCEPT@CHARGE@NAME"
msgstr "Carga"

msgid "CONCEPT@CHARGE_HEAVY@DESCRIPTION"
msgstr "Um ataque de Carga Pesada:[bulletlist]{LOC.CONCEPT@CHARGE_SHARED}[bullet/]Cargas Pesadas ignoram {GLOBAL.PROPERTIES.CHARGE_RESISTANCE.Hyperlink}.[/bulletlist]"

msgid "CONCEPT@CHARGE_NORMAL@DESCRIPTION"
msgstr "Um ataque de Carga:[bulletlist]{LOC.CONCEPT@CHARGE_SHARED}[/bulletlist]"

msgid "CONCEPT@CHARGE_SHARED"
msgstr "[bullet/]Ganha {CHARGE_DAMAGE_MULTIPLIER>ResolvedDamageMultiplier}% de dano por hexágono percorrido, até {GLOBAL.ChargeHexes} hexágonos.[bullet/]Cancela {GLOBAL.DefenseModeConcept.Hyperlink}.[bullet/]Remove {GLOBAL.RetaliationConcept.Hyperlink}."

msgid "CONCEPT@COMBAT_SPEED@DESCRIPTION"
msgstr "[bulletlist][bullet/]Velocidade de Combate representa a distância que uma unidade pode percorrer dentro de um {GLOBAL.TurnConcept} em {GLOBAL.CombatConcept.Hyperlink}.[bullet/]Cada hexágono em combate custa {amount} ponto para atravessar.[bullet/]{GLOBAL.SlowingConcept.Hyperlink} terreno custa {amount2} pontos para atravessar.[/bulletlist]"

msgid "CONCEPT@COMBAT_SPEED@HYPERLINK"
msgstr "[combatspeed/][hyperlink,GLOBAL.CombatSpeedConcept]{LOC.CONCEPT@COMBAT_SPEED@NAME}[/hyperlink]"

msgid "CONCEPT@COMBAT_SPEED@NAME"
msgstr "Velocidade de Combate"

msgid "CONCEPT@CONTROL_LOSS_IMMUNITY@DESCRIPTION"
msgstr "Imune a efeitos que fazem perder o controle de uma unidade, como {GLOBAL.PROPERTIES.BERSERK.Hyperlink} e {GLOBAL.PROPERTIES.DOMINATED.Hyperlink}.[br/]Também concede imunidade a ser {GLOBAL.CapturedConcept.Hyperlink}."

msgid "CONCEPT@CONTROL_LOSS_IMMUNITY@HYPERLINK"
msgstr "[hyperlink,GLOBAL.ControlLossImmunityConcept]Imunidade à Perda de Controle[/hyperlink]"

msgid "CONCEPT@CONTROL_LOSS_IMMUNITY@NAME"
msgstr "Imunidade à Perda de Controle"

msgid "CONCEPT@CRITICAL_HIT@DESCRIPTION"
msgstr "[bulletlist][bullet/]Se o ataque de uma unidade for um Acerto Crítico, seu dano aumenta em {damage}.[bullet/]Acertos Críticos geralmente são causados por alto {GLOBAL.UnitMoraleConcept.Hyperlink}.[bullet/]A chance de Acerto Crítico nunca pode ser maior que a chance de acerto do ataque.[/bulletlist]"

msgid "CONCEPT@CRITICAL_HIT@HYPERLINK"
msgstr "[hyperlink,GLOBAL.CriticalHitConcept]Acerto Crítico[/hyperlink]"

msgid "CONCEPT@CRITICAL_HIT@NAME"
msgstr "Acerto Crítico"

msgid "CONCEPT@CRITICAL_HIT_CHANCE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.CriticalHitConcept][crit/]Chance de Acerto Crítico[/hyperlink]"

msgid "CONCEPT@CRITICAL_HIT_CHANCE@NAME"
msgstr "[crit/]Chance de Acerto Crítico"

msgid "CONCEPT@DEBUFF_ABILITY@DESCRIPTION"
msgstr "Uma habilidade que tenta infligir um {GLOBAL.NegativeStatusEffectConcept.Hyperlink} em um inimigo sem causar dano diretamente."

msgid "CONCEPT@DEBUFF_ABILITY@HYPERLINK"
msgstr "[hyperlink,GLOBAL.DebuffConcept]Debuff[/hyperlink]"

msgid "CONCEPT@DEFENSE@DESCRIPTION"
msgstr "Defesa reduz dano de ataques {GLOBAL.MeleeConcept.Hyperlink} e {GLOBAL.RangedConcept.Hyperlink}."

msgid "CONCEPT@DEFENSE@HYPERLINK"
msgstr "[defense/] [hyperlink,GLOBAL.DefenseConcept]Defesa[/hyperlink]"

msgid "CONCEPT@DEFENSE@NAME"
msgstr "Defesa"

msgid "CONCEPT@DEFENSE_MODE@DESCRIPTION"
msgstr "Modo de Defesa é uma habilidade {GLOBAL.UnitConcept.Hyperlink}. Quando está no Modo de Defesa, uma unidade:[bulletlist][bullet/]Estende sua {GLOBAL.ZoneOfControlConcept.Hyperlink} a todos os hexágonos adjacentes.[bullet/]Ganha {defense} {GLOBAL.DefenseConcept.Hyperlink}.[bullet/]Ganha {resistance} {GLOBAL.ResistanceConcept.Hyperlink}.[bullet/]É imune a {GLOBAL.FlankingConcept.Hyperlink}.[/bulletlist]"

msgid "CONCEPT@DEFENSE_MODE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.DefenseModeConcept]Modo de Defesa[/hyperlink]"

msgid "CONCEPT@DEFENSE_MODE@NAME"
msgstr "Modo de Defesa"

msgid "CONCEPT@ENGAGED@DESCRIPTION"
msgstr "Enquanto estiver dentro da {GLOBAL.ZoneOfControlConcept.Hyperlink} de um inimigo, a unidade está Engajada em Corpo a Corpo e não pode usar a maioria dos ataques à distância ou habilidades mágicas."

msgid "CONCEPT@ENGAGED@HYPERLINK"
msgstr "[hyperlink,GLOBAL.EngagedInMeleeConcept]Engajada em Corpo a Corpo[/hyperlink]"

msgid "CONCEPT@ENGAGED@NAME"
msgstr "Engajada em Corpo a Corpo"

msgid "CONCEPT@ETHEREAL_IMMUNITY"
msgstr "[bulletlist][bullet/]{GLOBAL.PROPERTIES.BLEEDING.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.DISEASED.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.IMMOBILIZED.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.POISONED.Hyperlink}[/bulletlist]"

msgid "CONCEPT@EVASION@DESCRIPTION"
msgstr "Aumenta a chance de {GLOBAL.RangedConcept.Hyperlink} e de ataques {GLOBAL.MagicConcept.Hyperlink} à distância errarem."

msgid "CONCEPT@EVASION@HYPERLINK"
msgstr "[hyperlink,GLOBAL.EvasionConcept]Evasão[/hyperlink]"

msgid "CONCEPT@EVASION@NAME"
msgstr "Evasão"

msgid "CONCEPT@EXPERIENCE@DESCRIPTION"
msgstr "Pontos de experiência são ganhos pelas unidades para que alcancem postos mais altos, aprimorando suas habilidades.[br/][br/]As unidades ganham experiência ao vencer batalhas. Também recebem uma pequena quantidade a cada turno no mapa-múndi."

msgid "CONCEPT@EXPERIENCE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.ExperienceConcept][xp/] Experiência[/hyperlink]"

msgid "CONCEPT@FIRE_DAMAGE@DESCRIPTION"
msgstr "Inflige [damageFire/] Dano de Fogo."

msgid "CONCEPT@FIRE_DAMAGE@HYPERLINK"
msgstr "[damageFire/] [hyperlink,GLOBAL.FireDamageConcept]Dano de Fogo[/hyperlink]"

msgid "CONCEPT@FIRE_DAMAGE@NAME"
msgstr "Dano de Fogo"

msgid "CONCEPT@FIRE_LIGHTNING_DAMAGE@NAME"
msgstr "Dano de Fogo Arcano"

msgid "CONCEPT@FIRE_LIGHTNING_FROST_DAMAGE@NAME"
msgstr "Dano Cósmico"

msgid "CONCEPT@FIRE_RESISTANCE@DESCRIPTION"
msgstr "Proteção contra Fogo reduz {GLOBAL.FireDamageConcept.Hyperlink}."

msgid "CONCEPT@FIRE_RESISTANCE@HYPERLINK"
msgstr "[defensefire/] [hyperlink,GLOBAL.FireResistanceConcept]Proteção contra Fogo[/hyperlink]"

msgid "CONCEPT@FIRE_RESISTANCE@NAME"
msgstr "Proteção contra Fogo"

msgid "CONCEPT@FIRE_SPIRIT_DAMAGE@NAME"
msgstr "Dano Radiante"

msgid "CONCEPT@FIRST_STRIKE@DESCRIPTION"
msgstr "Ao ser atacada, uma unidade com Primeiro Golpe usará um {GLOBAL.RetaliationConcept.Hyperlink} para atacar primeiro."

msgid "CONCEPT@FIRST_STRIKE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.FirstStrikeConcept]Primeiro Golpe[/hyperlink]"

msgid "CONCEPT@FIRST_STRIKE@NAME"
msgstr "Primeiro Golpe"

msgid "CONCEPT@FLANKING@DESCRIPTION"
msgstr "Os ataques de flanco são desencadeados ao atacar um alvo por trás ou pelos lados.[bulletlist][bullet/]Ataques de flanco causam {damage} de dano.[bullet/]Unidades em {GLOBAL.DefenseModeConcept.Hyperlink} não podem ser flanqueadas.[bullet/]Se uma unidade iniciar seu turno dentro da {GLOBAL.ZoneOfControlConcept.Hyperlink} de um inimigo, não poderá flanqueá‑la naquele turno.[/bulletlist]"

msgid "CONCEPT@FLANKING@HYPERLINK"
msgstr "[hyperlink,GLOBAL.FlankingConcept][flank/] Flanco[/hyperlink]"

msgid "CONCEPT@FLANKING@NAME"
msgstr "[flank/] Flanco"

msgid "CONCEPT@FORTIFIED@DESCRIPTION"
msgstr "Só pode ser danificado por habilidades ou feitiços que possuam {GLOBAL.PROPERTIES.DEMOLISHER.Hyperlink}."

msgid "CONCEPT@FORTIFIED@HYPERLINK"
msgstr "[hyperlink,GLOBAL.FortifiedConcept]Fortificado[/hyperlink]"

msgid "CONCEPT@FORTIFIED@NAME"
msgstr "Fortificado"

msgid "CONCEPT@FROEST_RESISTANCE@NAME"
msgstr "Proteção contra Gelo"

msgid "CONCEPT@FROST_BLIGHT_DAMAGE@NAME"
msgstr "Dano de Morte"

msgid "CONCEPT@FROST_DAMAGE@DESCRIPTION"
msgstr "Inflige [damageFrost/] Dano de Gelo."

msgid "CONCEPT@FROST_DAMAGE@HYPERLINK"
msgstr "[damageFrost/] [hyperlink,GLOBAL.FrostDamageConcept]Dano de Gelo[/hyperlink]"

msgid "CONCEPT@FROST_DAMAGE@NAME"
msgstr "Dano de Gelo"

msgid "CONCEPT@FROST_RESISTANCE@DESCRIPTION"
msgstr "Proteção contra Gelo reduz {GLOBAL.FrostDamageConcept.Hyperlink}."

msgid "CONCEPT@FROST_RESISTANCE@HYPERLINK"
msgstr "[defensefrost/] [hyperlink,GLOBAL.FrostResistanceConcept]Proteção contra Gelo[/hyperlink]"

msgid "CONCEPT@FUMBLE@DESCRIPTION"
msgstr "[bulletlist][bullet/]Se o ataque de uma unidade for uma Falha:[bulletlist][bullet/]Um acerto torna‑se um Acerto Fraco, causando metade do dano.[bullet/]Um Acerto Fraco torna‑se um erro.[/bulletlist][bullet/]Falhas geralmente são causadas por baixo {GLOBAL.UnitMoraleConcept.Hyperlink}.[/bulletlist]"

msgid "CONCEPT@FUMBLE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.FumbleConcept]Falha[/hyperlink]"

msgid "CONCEPT@FUMBLE@NAME"
msgstr "Falha"

msgid "CONCEPT@HEROES@AMBITION@NAME"
msgstr "Ambições de Herói"

msgid "CONCEPT@HEROES@AMBITIONS@DESCRIPTION"
msgstr "Cada {GLOBAL.HeroConcept.Hyperlink} tem uma Ambição, que define metas a serem concluídas para ganhar {GLOBAL.RenownConcept.Hyperlink}. Cada inclui uma Ambição Menor, que pode ser repetida quantas vezes quiser, e uma Ambição Maior, que só pode ser concluída uma vez.[br/][br/]Completar essas ambições concede {GLOBAL.RenownConcept.Hyperlink}, enquanto concluir a Ambição Maior concede adicionalmente uma propriedade única de herói.[br/][br/]A Ambição de um herói pode ser alterada por um evento caso ele não cumpra suas metas dentro do período estabelecido."

msgid "CONCEPT@HEROES@AMBITIONS@HYPERLINK"
msgstr "[hyperlink,GLOBAL.AmbitionConcept]Ambição[/hyperlink]"

msgid "CONCEPT@HEROES@AMBITIONS@NAME"
msgstr "Ambições de Herói"

msgid "CONCEPT@HEROES@CLASS@DESCRIPTION"
msgstr "Cada {GLOBAL.HeroConcept.Hyperlink} tem uma Classe, escolhida na criação. Cada classe permite que o herói se especialize em papéis específicos e geralmente oferece duas variações gerais desse papel.[br/][br/]Classes de Herói:[bulletlist][bullet/]{GLOBAL.HeroClassDefender.Hyperlink}[bullet/]{GLOBAL.HeroClassWarrior.Hyperlink}[bullet/]{GLOBAL.HeroClassMage.Hyperlink}[bullet/]{GLOBAL.HeroClassRitualist.Hyperlink}[bullet/]{GLOBAL.HeroClassRanger.Hyperlink}[bullet/]{GLOBAL.HeroClassDeathKnight.Hyperlink}[bullet/]{GLOBAL.HeroClassSpellblade.Hyperlink}[/bulletlist]"

msgid "CONCEPT@HEROES@CLASS@HYPERLINK"
msgstr "[hyperlink,GLOBAL.HeroClass]Classe de Herói[/hyperlink]"

msgid "CONCEPT@HEROES@CLASS@NAME"
msgstr "Classe de Herói"

msgid "CONCEPT@HEROES@DEDICATION@DESCRIPTION"
msgstr "Em certos níveis, os heróis adquirem a capacidade de escolher Habilidades Marcantes. Para <<m:{GLOBAL.MortalChampionConcept.Hyperlink}>>, <<m:{GLOBAL.WizardKingConcept.Hyperlink}>> e Lordes Dragão, elas assumem a forma de Dedicações de Afinidade.[br/][br/]Cada nível de Dedicação de Afinidade torna‑se disponível com base na <<m:{GLOBAL.AffinityConcept.Hyperlink}>> do seu império e no nível do seu herói:[br/][bulletlist][bullet/]Iniciante – Requer 1 ponto de afinidade e um Herói de nível 4.[bullet/]Adepto – Requer 4 pontos de afinidade e um Herói de nível 8.[bullet/]Mestre – Requer 6 pontos de afinidade e um Herói de nível 12.[bullet/]Exemplar – Requer 8 pontos de afinidade e um Herói de nível 16.[/bulletlist][br/][br/][br/]Essas Dedicações concedem um benefício próprio e desbloqueiam novas Habilidades de Herói.[br/][br/]Alguns tipos de herói, como Soberanos Arcano, possuem Habilidades Marcantes especiais que não estão relacionadas à afinidade."

msgid "CONCEPT@HEROES@DEDICATION@HYPERLINK"
msgstr "[hyperlink,GLOBAL.HeroDedication]Habilidades Marcantes de Herói[/hyperlink]"

msgid "CONCEPT@HEROES@DEDICATION@NAME"
msgstr "Habilidades Marcantes de Herói"

msgid "CONCEPT@HEROES@DESTINY@DESCRIPTION"
msgstr "Cada Herói tem um Destino, que define metas a serem cumpridas para ganhar {GLOBAL.RenownConcept.Hyperlink}. Cada Destino inclui uma Ambição Menor, que pode ser repetida quantas vezes quiser, e uma Ambição Maior, que só pode ser concluída uma vez.[br/][br/]Completar as Ambições concede {GLOBAL.RenownConcept.Hyperlink}, e concluir as Ambições Maiores concede também uma propriedade única de herói.[br/][br/]O destino de um Herói pode ser alterado por um evento caso ele não cumpra suas ambições dentro do período estabelecido."

msgid "CONCEPT@HEROES@DESTINY@HYPERLINK"
msgstr "[hyperlink,GLOBAL.DestinyConcept]Destino[/hyperlink]"

msgid "CONCEPT@HEROES@DESTINY@NAME"
msgstr "Destino de Herói"

msgid "CONCEPT@HEROES@ORIGIN@DESCRIPTION"
msgstr "A Origem é determinada pelo tipo de herói criado durante a fundação da facção; para a maioria dos <<m:{GLOBAL.HeroConcept.Hyperlink}>> encontrados aleatoriamente, será <<m:{GLOBAL.MortalChampionConcept.Hyperlink}>>.[br/][br/]É aqui que se encontram habilidades únicas desses tipos, como ataques de sopro para Lordes Dragão ou encantamentos de feitiço para <<m:{GLOBAL.WizardKingConcept.Hyperlink}>>."

msgid "CONCEPT@HEROES@ORIGIN@HYPERLINK"
msgstr "[hyperlink,GLOBAL.HeroOrigin]Origem do Herói[/hyperlink]"

msgid "CONCEPT@HEROES@ORIGIN@NAME"
msgstr "Origem do Herói"

msgid "CONCEPT@HEROES@RENOWN@DESCRIPTION"
msgstr "Heróis ganham Renome ao completar as metas associadas à sua {GLOBAL.AmbitionConcept.Hyperlink}. Acumular renome suficiente eleva o Nível de Renome, que aumenta os bônus que sua [hyperlink,GLOBAL.GovernorConcept]Cidade Governada[/hyperlink] recebe do traço de Governança do herói.[br/]Além disso, níveis de renome concedem às unidades do exército do herói moral adicional e reduzem a chance de perder unidades ao {GLOBAL.RoutingConcept.Hyperlink}."

msgid "CONCEPT@HEROES@RENOWN@HYPERLINK"
msgstr "[renown/] [hyperlink,GLOBAL.RenownConcept]Renome[/hyperlink]"

msgid "CONCEPT@HEROES@RENOWN@NAME"
msgstr "Renome de Herói"

msgid "CONCEPT@HERO_CLASS@DEATH_KNIGHT@DESCRIPTION"
msgstr "{LOC.CONCEPT@HERO_CLASS@DEATH_KNIGHT@DESCRIPTION_SHORT}[br/][br/]Armas compatíveis:[bulletlist][bullet/]{GLOBAL.GreatWeaponConcept.Hyperlink}[bullet/]{GLOBAL.OneHandedWeaponConcept.Hyperlink}[bullet/]{GLOBAL.ShieldConcept.Hyperlink}[bullet/]{GLOBAL.FistWeaponConcept.Hyperlink}[bullet/]{GLOBAL.PolearmWeaponConcept.Hyperlink}[bullet/]{GLOBAL.SkirmishingWeaponConcept.Hyperlink}[/bulletlist]"

msgid "CONCEPT@HERO_CLASS@DEATH_KNIGHT@DESCRIPTION_SHORT"
msgstr "Uma Classe de Herói que se especializa em ataques de {GLOBAL.MeleeConcept.Hyperlink} de alto dano, sustentados por <<m:{GLOBAL.DebuffConcept.Hyperlink}>> e unidades {GLOBAL.PROPERTIES.UNDEAD.Hyperlink} invocadas."

msgid "CONCEPT@HERO_CLASS@DEATH_KNIGHT@GAMEPLAY_HYPERLINK"
msgstr "[classDeathknight/] [hyperlink,GLOBAL.HeroClassDeathKnight]Cavaleiro da Morte[/hyperlink]"

msgid "CONCEPT@HERO_CLASS@DEATH_KNIGHT@HYPERLINK"
msgstr "[hyperlink,GLOBAL.HeroClassDeathKnight]Classe de Herói: Cavaleiro da Morte[/hyperlink]"

msgid "CONCEPT@HERO_CLASS@DEFENDER@DESCRIPTION"
msgstr "{LOC.CONCEPT@HERO_CLASS@DEFENDER@DESCRIPTION_SHORT}[br/][br/]Armas compatíveis:[bulletlist][bullet/]{GLOBAL.OneHandedWeaponConcept.Hyperlink}[bullet/]{GLOBAL.ShieldConcept.Hyperlink}[bullet/]{GLOBAL.FistWeaponConcept.Hyperlink}[bullet/]{GLOBAL.PolearmWeaponConcept.Hyperlink}[bullet/]{GLOBAL.SkirmishingWeaponConcept.Hyperlink}[/bulletlist]"

msgid "CONCEPT@HERO_CLASS@DEFENDER@DESCRIPTION_SHORT"
msgstr "Uma Classe de Herói que se especializa em defender seus aliados, em sobrevivência e em retaliação."

msgid "CONCEPT@HERO_CLASS@DEFENDER@GAMEPLAY_HYPERLINK"
msgstr "[classDefender/] [hyperlink,GLOBAL.HeroClassDefender]Defensor[/hyperlink]"

msgid "CONCEPT@HERO_CLASS@DEFENDER@HYPERLINK"
msgstr "[hyperlink,GLOBAL.HeroClassDefender]Classe de Herói: Defensor[/hyperlink]"

msgid "CONCEPT@HERO_CLASS@MAGE@DESCRIPTION"
msgstr "{LOC.CONCEPT@HERO_CLASS@MAGE@DESCRIPTION_SHORT}[br/][br/]Armas compatíveis:[bulletlist][bullet/]{GLOBAL.MagicOrbWeaponConcept.Hyperlink}[bullet/]{GLOBAL.MagicStaffWeaponConcept.Hyperlink}[bullet/]{GLOBAL.EldritchRelicWeaponConcept.Hyperlink}[/bulletlist]"

msgid "CONCEPT@HERO_CLASS@MAGE@DESCRIPTION_SHORT"
msgstr "Elementalistas são causadores de dano mágico que preparam ataques ou dão o golpe final com poderosas habilidades elementais.[br/]Cada herói Elementalista escolhe uma disciplina que determina o elemento de suas habilidades."

msgid "CONCEPT@HERO_CLASS@MAGE@GAMEPLAY_HYPERLINK"
msgstr "[classMage/] [hyperlink,GLOBAL.HeroClassMage]Elementalista[/hyperlink]"

msgid "CONCEPT@HERO_CLASS@MAGE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.HeroClassMage]Classe de Herói: Elementalista[/hyperlink]"

msgid "CONCEPT@HERO_CLASS@RANGER@DESCRIPTION"
msgstr "{LOC.CONCEPT@HERO_CLASS@RANGER@DESCRIPTION_SHORT}[br/][br/]Armas compatíveis:[bulletlist][bullet/]{GLOBAL.RangedWeaponConcept.Hyperlink}[bullet/]{GLOBAL.SkirmishingWeaponConcept.Hyperlink}[/bulletlist]"

msgid "CONCEPT@HERO_CLASS@RANGER@DESCRIPTION_SHORT"
msgstr "Uma Classe de Herói que se especializa em dano à distância, escaramuça e em perturbar inimigos."

msgid "CONCEPT@HERO_CLASS@RANGER@GAMEPLAY_HYPERLINK"
msgstr "[classRanger/] [hyperlink,GLOBAL.HeroClassRanger]Patrulheiro[/hyperlink]"

msgid "CONCEPT@HERO_CLASS@RANGER@HYPERLINK"
msgstr "[hyperlink,GLOBAL.HeroClassRanger]Classe de Herói: Patrulheiro[/hyperlink]"

msgid "CONCEPT@HERO_CLASS@RITUALIST@DESCRIPTION"
msgstr "{LOC.CONCEPT@HERO_CLASS@RITUALIST@DESCRIPTION_SHORT}[br/][br/]Armas compatíveis:[bulletlist][bullet/]{GLOBAL.MagicOrbWeaponConcept.Hyperlink}[bullet/]{GLOBAL.MagicStaffWeaponConcept.Hyperlink}[bullet/]{GLOBAL.EldritchRelicWeaponConcept.Hyperlink}[/bulletlist]"

msgid "CONCEPT@HERO_CLASS@RITUALIST@DESCRIPTION_SHORT"
msgstr "Uma Classe de Herói que se especializa em suporte por meio de cura e bônus."

msgid "CONCEPT@HERO_CLASS@RITUALIST@GAMEPLAY_HYPERLINK"
msgstr "[classRitualist/] [hyperlink,GLOBAL.HeroClassRitualist]Ritualista[/hyperlink]"

msgid "CONCEPT@HERO_CLASS@RITUALIST@HYPERLINK"
msgstr "[hyperlink,GLOBAL.HeroClassRitualist]Classe de Herói: Ritualista[/hyperlink]"

msgid "CONCEPT@HERO_CLASS@SPELLBLADE@DESCRIPTION"
msgstr "{LOC.CONCEPT@HERO_CLASS@SPELLBLADE@DESCRIPTION_SHORT}[br/][br/]Armas compatíveis:[bulletlist][bullet/]{GLOBAL.GreatWeaponConcept.Hyperlink}[bullet/]{GLOBAL.OneHandedWeaponConcept.Hyperlink}[bullet/]{GLOBAL.ShieldConcept.Hyperlink}[bullet/]{GLOBAL.FistWeaponConcept.Hyperlink}[bullet/]{GLOBAL.PolearmWeaponConcept.Hyperlink}[bullet/]{GLOBAL.SkirmishingWeaponConcept.Hyperlink}[/bulletlist]"

msgid "CONCEPT@HERO_CLASS@SPELLBLADE@DESCRIPTION_SHORT"
msgstr "Uma Classe de Herói que usa ataques {GLOBAL.MeleeConcept.Hyperlink} e {GLOBAL.MagicConcept.Hyperlink} para causar dano mágico à distância e dano físico quando o inimigo se aproxima."

msgid "CONCEPT@HERO_CLASS@SPELLBLADE@GAMEPLAY_HYPERLINK"
msgstr "[classSpellblade/] [hyperlink,GLOBAL.HeroClassSpellblade]Espadachim Arcano[/hyperlink]"

msgid "CONCEPT@HERO_CLASS@SPELLBLADE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.HeroClassSpellblade]Classe de Herói: Espadachim Arcano[/hyperlink]"

msgid "CONCEPT@HERO_CLASS@WARLOCK@DESCRIPTION"
msgstr "{LOC.CONCEPT@HERO_CLASS@WARLOCK@DESCRIPTION_SHORT}[br/][br/]Armas compatíveis:[bulletlist][bullet/]{GLOBAL.MagicOrbWeaponConcept.Hyperlink}[bullet/]{GLOBAL.MagicStaffWeaponConcept.Hyperlink}[bullet/]{GLOBAL.EldritchRelicWeaponConcept.Hyperlink}[/bulletlist]"

msgid "CONCEPT@HERO_CLASS@WARLOCK@DESCRIPTION_SHORT"
msgstr "Bruxos são especialistas em efeitos de enfraquecimento e necromancia, usando efeitos de enfraquecimento poderosos e fortalecendo as invocações de mortos‑vivos que levantam durante a batalha."

msgid "CONCEPT@HERO_CLASS@WARLOCK@GAMEPLAY_HYPERLINK"
msgstr "[classWarlock/] [hyperlink,GLOBAL.HeroClassWarlock]Bruxo[/hyperlink]"

msgid "CONCEPT@HERO_CLASS@WARLOCK@HYPERLINK"
msgstr "[hyperlink,GLOBAL.HeroClassWarlock]Classe de Herói: Bruxo[/hyperlink]"

msgid "CONCEPT@HERO_CLASS@WARRIOR@DESCRIPTION"
msgstr "{LOC.CONCEPT@HERO_CLASS@WARRIOR@DESCRIPTION_SHORT}[br/][br/]Armas compatíveis:[bulletlist][bullet/]{GLOBAL.GreatWeaponConcept.Hyperlink}[bullet/]{GLOBAL.OneHandedWeaponConcept.Hyperlink}[bullet/]{GLOBAL.ShieldConcept.Hyperlink}[bullet/]{GLOBAL.FistWeaponConcept.Hyperlink}[bullet/]{GLOBAL.PolearmWeaponConcept.Hyperlink}[bullet/]{GLOBAL.SkirmishingWeaponConcept.Hyperlink}[/bulletlist]"

msgid "CONCEPT@HERO_CLASS@WARRIOR@DESCRIPTION_SHORT"
msgstr "Uma Classe de Herói que se especializa em ataques de carga, causando dano e ganhando força ao lutar."

msgid "CONCEPT@HERO_CLASS@WARRIOR@GAMEPLAY_HYPERLINK"
msgstr "[classWarrior/] [hyperlink,GLOBAL.HeroClassWarrior]Guerreiro[/hyperlink]"

msgid "CONCEPT@HERO_CLASS@WARRIOR@HYPERLINK"
msgstr "[hyperlink,GLOBAL.HeroClassWarrior]Classe de Herói: Guerreiro[/hyperlink]"

msgid "CONCEPT@HERO_SKILL_ADEPT@DESCRIPTION"
msgstr "Habilidades Adept são desbloqueadas ao adquirir {amount} outras habilidades na mesma categoria."

msgid "CONCEPT@HERO_SKILL_ADEPT@HYPERLINK"
msgstr "[hyperlink,GLOBAL.AdeptHeroSkill]Habilidade de Herói Adept[/hyperlink]"

msgid "CONCEPT@HERO_SKILL_EXPERT@DESCRIPTION"
msgstr "Habilidades Expert são desbloqueadas ao adquirir {amount} outras habilidades na mesma categoria."

msgid "CONCEPT@HERO_SKILL_EXPERT@HYPERLINK"
msgstr "[hyperlink,GLOBAL.ExpertHeroSkill]Habilidade de Herói Expert[/hyperlink]"

msgid "CONCEPT@HERO_SKILL_MASTER@DESCRIPTION"
msgstr "Habilidades Mestre são desbloqueadas ao adquirir {amount} outras habilidades na mesma categoria."

msgid "CONCEPT@HERO_SKILL_MASTER@HYPERLINK"
msgstr "[hyperlink,GLOBAL.MasterHeroSkill]Habilidade de Herói Mestre[/hyperlink]"

msgid "CONCEPT@HERO_SKILL_NOVICE@DESCRIPTION"
msgstr "Uma habilidade básica de herói."

msgid "CONCEPT@HERO_SKILL_NOVICE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.NoviceHeroSkill]Habilidade de Herói Novato[/hyperlink]"

msgid "CONCEPT@HIGHMORALE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.HighMoraleConcept]Moral Alta[/hyperlink]"

msgid "CONCEPT@HITPOINTS@DESCRIPTION"
msgstr "[bulletlist][bullet/]Pontos de Vida representam a quantidade de dano que uma {GLOBAL.UnitConcept.Hyperlink} pode suportar antes de morrer.[bullet/]A maioria das unidades sofrerá <<m:{GLOBAL.CasualtyConcept.Hyperlink}>> à medida que seus Pontos de Vida diminuem.[/bulletlist]"

msgid "CONCEPT@HITPOINTS@HYPERLINK"
msgstr "[hyperlink,GLOBAL.HitPointConcept]{LOC.CONCEPT@HITPOINTS@NAME}[/hyperlink]"

msgid "CONCEPT@HITPOINTS@NAME"
msgstr "[hp/] Ponto de Vida"

msgid "CONCEPT@LIGHTNING_DAMAGE@DESCRIPTION"
msgstr "Inflige [damageLightning/] Dano de Relâmpago."

msgid "CONCEPT@LIGHTNING_DAMAGE@HYPERLINK"
msgstr "[damageLightning/] [hyperlink,GLOBAL.LightningDamageConcept]Dano de Relâmpago[/hyperlink]"

msgid "CONCEPT@LIGHTNING_DAMAGE@NAME"
msgstr "Dano de Relâmpago"

msgid "CONCEPT@LIGHTNING_RESISTANCE@DESCRIPTION"
msgstr "Proteção contra Relâmpago reduz {GLOBAL.LightningDamageConcept.Hyperlink}."

msgid "CONCEPT@LIGHTNING_RESISTANCE@HYPERLINK"
msgstr "[defenselightning/] [hyperlink,GLOBAL.LightningResistanceConcept]Proteção contra Relâmpago[/hyperlink]"

msgid "CONCEPT@LIGHTNING_RESISTANCE@NAME"
msgstr "Proteção contra Relâmpago"

msgid "CONCEPT@LINE_OF_SIGHT@DESCRIPTION"
msgstr "A maioria dos ataques à Distância precisa de Linha de Visão para atingir um inimigo.[bulletlist][bullet/]Se obstáculos ou outras <<m:{GLOBAL.UnitConcept.Hyperlink}>> estiverem entre o atacante e o alvo, o alvo torna‑se {GLOBAL.ObscuredConcept.Hyperlink}, reduzindo {GLOBAL.AccuracyConcept.Hyperlink}.[bullet/]Unidades adjacentes ao atacante não fazem o alvo ficar {GLOBAL.ObscuredConcept.Hyperlink}.[/bulletlist]"

msgid "CONCEPT@LINE_OF_SIGHT@HYPERLINK"
msgstr "[hyperlink,GLOBAL.LineOfSightConcept]Linha de Visão[/hyperlink]"

msgid "CONCEPT@LINE_OF_SIGHT@NAME"
msgstr "Linha de Visão"

msgid "CONCEPT@LOWMORALE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.LowMoraleConcept]Moral Baixa[/hyperlink]"

msgid "CONCEPT@MAGIC_ABILITY@DESCRIPTION"
msgstr "Ataques Mágicos são ataques realizados com implementos mágicos como orbes e cajados.[br/][br/]Muitos dos ataques especiais que criaturas possuem, como o sopro de dragão, também são considerados ataques Mágicos.[br/][br/]Ataques Mágicos são resistidos por {GLOBAL.ResistanceConcept.Hyperlink}."

msgid "CONCEPT@MAGIC_ABILITY@HYPERLINK"
msgstr "[hyperlink,GLOBAL.MagicConcept]Magia[/hyperlink]"

msgid "CONCEPT@MAGIC_ABILITY@NAME"
msgstr "Magia"

msgid "CONCEPT@MELEE_ABILITY@DESCRIPTION"
msgstr "Ataques Corpo a Corpo são ataques de curto alcance realizados com armas como espadas, lanças, garras e dentes.[br/][br/]Eles geralmente causam {GLOBAL.PhysicalDamageConcept.Hyperlink} e são resistidos por {GLOBAL.DefenseConcept.Hyperlink}."

msgid "CONCEPT@MELEE_ABILITY@HYPERLINK"
msgstr "[hyperlink,GLOBAL.MeleeConcept]Corpo a Corpo[/hyperlink]"

msgid "CONCEPT@MELEE_ABILITY@NAME"
msgstr "Corpo a Corpo"

msgid "CONCEPT@MORALE@SUBTITLE"
msgstr "{minvalue} a {maxvalue} {GLOBAL.UnitMoraleConcept.Hyperlink}"

msgid "CONCEPT@MOUNT@DESCRIPTION"
msgstr "Montarias podem ser equipadas por <<m:{GLOBAL.PROPERTIES.HERO.Hyperlink}>> na respectiva ranura.[br/]Elas geralmente concedem {GLOBAL.PROPERTIES.FAST_MOVEMENT.Hyperlink} e um pequeno aumento em <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[br/]Certas armas poderosas não podem ser empunhadas enquanto montado.[br/]A montaria que o {GLOBAL.PROPERTIES.HERO.Hyperlink} inicia depende de sua raça e de quaisquer traços de forma que a raça possua."

msgid "CONCEPT@MOUNT@HYPERLINK"
msgstr "[hyperlink,GLOBAL.HeroMountConcept]Montaria de Herói[/hyperlink]"

msgid "CONCEPT@MOUNT@NAME"
msgstr "Montaria de Herói"

msgid "CONCEPT@MOVEMENT_ABILITY@DESCRIPTION"
msgstr "Uma habilidade que move a unidade que a utiliza para outra localização.[br/][br/]Não pode ser usada por unidades que estejam {GLOBAL.PROPERTIES.IMMOBILIZED.Hyperlink}."

msgid "CONCEPT@MOVEMENT_ABILITY@HYPERLINK"
msgstr "[hyperlink,GLOBAL.MovementAbilityConcept]Movimento[/hyperlink]"

msgid "CONCEPT@MOVEMENT_ABILITY@NAME"
msgstr "Habilidade de Movimento"

msgid "CONCEPT@MOVE_POINTS@DESCRIPTION"
msgstr "[bulletlist][bullet/]Pontos de Movimento representam a distância que uma unidade pode percorrer dentro de um {GLOBAL.TurnConcept} no {GLOBAL.WorldMapConcept.Hyperlink}.[bullet/]Terreno normal custa {amount1} Pontos de Movimento para ser atravessado.[bullet/]Às vezes o custo de Pontos de Movimento do terreno pode ser reduzido, como ao atravessar seu {GLOBAL.DomainConcept.Hyperlink}, mas nunca pode ficar abaixo de {amount2} Pontos de Movimento.[bullet/]Em {GLOBAL.CombatConcept.Hyperlink} Pontos de Movimento não são usados, {GLOBAL.CombatSpeedConcept.Hyperlink} é usado em seu lugar.[/bulletlist]"

msgid "CONCEPT@MOVE_POINTS@HYPERLINK"
msgstr "[movementgeneral/] [hyperlink,GLOBAL.MovePointConcept]Ponto de Movimento[/hyperlink]"

msgid "CONCEPT@MOVE_POINTS@NAME"
msgstr "[movementgeneral/] Ponto de Movimento"

msgid "CONCEPT@NEGATIVE_STATUS_EFFECT@DESCRIPTION"
msgstr "Um efeito de status negativo é uma condição temporária que enfraquece uma unidade de alguma forma. São frequentemente aplicados por habilidades de <<{GLOBAL.DebuffSpellConcept.Hyperlink}>> e {GLOBAL.DebuffConcept.Hyperlink}. [br/][br/]Exemplos incluem:[bulletlist][bullet/]{GLOBAL.PROPERTIES.SUNDERED_RESISTANCE.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.POISONED.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.DOMINATED.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.DECAYING.Hyperlink}[/bulletlist][br/][br/]Todas as culturas têm uma habilidade de unidade ou feitiço que pode remover efeitos de status negativos.[br/][br/]Além disso, alguns efeitos de status negativos têm [hyperlink,GLOBAL.OpposingStatusEffectsConcept]contra‑medidas[/hyperlink]—por exemplo, {GLOBAL.PROPERTIES.POISONED.Hyperlink} pode ser removido ao aplicar {GLOBAL.PROPERTIES.REGENERATION.Hyperlink}."

msgid "CONCEPT@NEGATIVE_STATUS_EFFECT@HYPERLINK"
msgstr "[hyperlink,GLOBAL.NegativeStatusEffectConcept]Efeito de Status Negativo[/hyperlink]"

msgid "CONCEPT@NEGATIVE_STATUS_EFFECT@NAME"
msgstr "Efeito de Status Negativo"

msgid "CONCEPT@NEUTRALMORALE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.NeutralMoraleConcept]Moral Neutra[/hyperlink]"

msgid "CONCEPT@NO_REFRESH@DESCRIPTION"
msgstr "Habilidades marcadas como \"Não pode ser recarregada\" não podem ter seus tempos de recarga e o status \"uma vez por batalha\" redefinidos durante a batalha por habilidades especiais, como {GLOBAL.PROPERTIES.WEAVER.Hyperlink}."

msgid "CONCEPT@NO_REFRESH@HYPERLINK"
msgstr "[hyperlink,GLOBAL.NoRefreshConcept]Não pode ser recarregada[/hyperlink]"

msgid "CONCEPT@NO_REFRESH@NAME"
msgstr "Habilidades Não Recarregáveis"

msgid "CONCEPT@OBSCURED@DESCRIPTION"
msgstr "Quando um alvo está Obscurecido, ele fica {chance}% mais difícil de ser atingido por ataques à distância."

msgid "CONCEPT@OBSCURED@HYPERLINK"
msgstr "[hyperlink,GLOBAL.ObscuredConcept]Obscurecido[/hyperlink]"

msgid "CONCEPT@OBSCURED@NAME"
msgstr "Obscurecido"

msgid "CONCEPT@ONE_OF_CONTROL@DESCRIPTION"
msgstr "[bulletlist][bullet/]A Zona de Controle de uma unidade são os três hexágonos à sua frente.[bullet/]A Zona de Controle bloqueia o movimento inimigo e determina onde a unidade pode executar uma {GLOBAL.RetaliationConcept.Hyperlink}.[bullet/]Entrar em {GLOBAL.DefenseModeConcept.Hyperlink} amplia a Zona de Controle para todos os hexágonos adjacentes.[/bulletlist]"

msgid "CONCEPT@OPPERTUNITY_ATTACK@DESCRIPTION"
msgstr "Ataques de Oportunidade são um tipo especial de {GLOBAL.RetaliationConcept.Hyperlink} que são acionados quando uma unidade inimiga deixa a {GLOBAL.ZoneOfControlConcept.Hyperlink}."

msgid "CONCEPT@OPPERTUNITY_ATTACK@HYPERLINK"
msgstr "[hyperlink,GLOBAL.OpportunityAttackConcept]Ataque de Oportunidade[/hyperlink]"

msgid "CONCEPT@OPPERTUNITY_ATTACK@NAME"
msgstr "Ataque de Oportunidade"

msgid "CONCEPT@PHYSICAL_DAMAGE@DESCRIPTION"
msgstr "Inflige [damagePhysical/] Dano Físico."

msgid "CONCEPT@PHYSICAL_DAMAGE@HYPERLINK"
msgstr "[damagePhysical/] [hyperlink,GLOBAL.PhysicalDamageConcept]Dano Físico[/hyperlink]"

msgid "CONCEPT@PHYSICAL_DAMAGE@NAME"
msgstr "Dano Físico"

msgid "CONCEPT@PHYSICAL_RESISTANCE@DESCRIPTION"
msgstr "Proteção Física reduz {GLOBAL.PhysicalDamageConcept.Hyperlink}."

msgid "CONCEPT@PHYSICAL_RESISTANCE@HYPERLINK"
msgstr "[defensephysical/] [hyperlink,GLOBAL.PhysicalResistanceConcept]Proteção Física[/hyperlink]"

msgid "CONCEPT@PHYSICAL_RESISTANCE@NAME"
msgstr "Proteção Física"

msgid "CONCEPT@POSITIVE_STATUS_EFFECT@DESCRIPTION"
msgstr "Um efeito de status positivo é uma condição temporária que fortalece uma unidade de alguma forma. Eles são frequentemente aplicados por <<m:{GLOBAL.BuffSpellConcept.Hyperlink}>> e {GLOBAL.SupportConcept.Hyperlink} habilidades.[br/][br/]Exemplos incluem:[bulletlist][bullet/]{GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.REGENERATION.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.HASTENED.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.STEADFAST.Hyperlink}[/bulletlist][br/][br/]Algumas habilidades raras de unidades e feitiços podem remover efeitos de status positivos.[br/][br/]Além disso, alguns efeitos de status positivos têm [hyperlink,GLOBAL.OpposingStatusEffectsConcept]contra‑medidas[/hyperlink] — por exemplo, {GLOBAL.PROPERTIES.REGENERATION.Hyperlink} pode ser removido ao aplicar {GLOBAL.PROPERTIES.POISONED.Hyperlink}."

msgid "CONCEPT@POSITIVE_STATUS_EFFECT@HYPERLINK"
msgstr "[hyperlink,GLOBAL.PositiveStatusEffectConcept]Efeito de Status Positivo[/hyperlink]"

msgid "CONCEPT@POSITIVE_STATUS_EFFECT@NAME"
msgstr "Efeito de Status Positivo"

msgid "CONCEPT@RANGE@DESCRIPTION"
msgstr "Alcance refere‑se ao número máximo de hexágonos que uma unidade pode estar distante para que uma habilidade a possa atingir.[br/]Usar ataques contra um alvo no alcance máximo geralmente impõe uma penalidade de {GLOBAL.AccuracyConcept.Hyperlink}."

msgid "CONCEPT@RANGE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.RangeConcept][range/]Alcance[/hyperlink]"

msgid "CONCEPT@RANGE@NAME"
msgstr "[range/]Alcance"

msgid "CONCEPT@RANGED_ABILITY@DESCRIPTION"
msgstr "Ataques de projéteis são ataques de alcance médio a longo realizados com armas como arcos ou facas arremessáveis.[br/][br/]Eles infligem principalmente {GLOBAL.PhysicalDamageConcept.Hyperlink} e são resistidos por {GLOBAL.DefenseConcept.Hyperlink}."

msgid "CONCEPT@RANGED_ABILITY@HYPERLINK"
msgstr "[hyperlink,GLOBAL.RangedConcept]Projétil[/hyperlink]"

msgid "CONCEPT@RANGED_ABILITY@NAME"
msgstr "Projétil"

msgid "CONCEPT@RESISTANCE@DESCRIPTION"
msgstr "Resistência reduz o dano causado por ataques {GLOBAL.MagicConcept.Hyperlink} e <<m:{GLOBAL.CombatSpellConcept.Hyperlink}>>."

msgid "CONCEPT@RESISTANCE@HYPERLINK"
msgstr "[resistance/] [hyperlink,GLOBAL.ResistanceConcept]Resistência[/hyperlink]"

msgid "CONCEPT@RESISTANCE@NAME"
msgstr "Resistência"

msgid "CONCEPT@RETALIATION@DESCRIPTION"
msgstr "Um Ataque de Retaliação é um ataque desencadeado pelos ataques ou movimento de outra [hyperlink,GLOBAL.UnitConcept]Unidade[/hyperlink][bulletlist][bullet/]Unidades corpo a corpo podem retaliar uma vez por {GLOBAL.TurnConcept} (por padrão).[bullet/]Atacar uma unidade inimiga dentro da {GLOBAL.ZoneOfControlConcept.Hyperlink} desencadeia uma Retaliação.[bullet/]Uma unidade inimiga que se move para fora da {GLOBAL.ZoneOfControlConcept.Hyperlink} desencadeia um {GLOBAL.OpportunityAttackConcept.Hyperlink}.[/bulletlist]"

msgid "CONCEPT@RETALIATION@HYPERLINK"
msgstr "[hyperlink,GLOBAL.RetaliationConcept]Ataque de Retaliação[/hyperlink]"

msgid "CONCEPT@RETALIATION@NAME"
msgstr "Ataque de Retaliação"

msgid "CONCEPT@RETREATING@DESCRIPTION"
msgstr "{GLOBAL.UnitConcept.Hyperlink} avança para um Ponto de Retirada durante {GLOBAL.CombatConcept.Hyperlink}, e sai imediatamente da batalha.[bulletlist][bullet/]Unidades aliadas próximas perderão moral [morale/].[bullet/]A unidade perderá Pontos de Movimento [movementwalk/] após a batalha.[bullet/]Retirar sua última unidade fará com que você perca a batalha.[bullet/]Se você perder a batalha, a unidade morrerá ou se dispersará e reaparecerá em uma de suas cidades após alguns turnos.[/bulletlist]"

msgid "CONCEPT@RETREATING@HYPERLINK"
msgstr "[hyperlink,GLOBAL.RetreatingConcept]Retirada[/hyperlink]"

msgid "CONCEPT@RETREATING@NAME"
msgstr "Retirada"

msgid "CONCEPT@ROUTING@HYPERLINK"
msgstr "[hyperlink,GLOBAL.RoutingConcept]Fuga[/hyperlink]"

msgid "CONCEPT@ROUTING@SUBTITLE"
msgstr "{value} {GLOBAL.UnitMoraleConcept.Hyperlink}"

msgid "CONCEPT@RULER@DESTINY@DESCRIPTION"
msgstr "Cada {GLOBAL.HeroConcept.Hyperlink} tem uma Ambição, que define objetivos a serem cumpridos para ganhar {GLOBAL.RenownConcept.Hyperlink}. Cada uma inclui uma ambição Menor, que pode ser repetida indefinidamente, e uma ambição Maior, que só pode ser concluída uma vez."

msgid "CONCEPT@RULER@DESTINY@NAME"
msgstr "Ambição do Governante"

msgid "CONCEPT@SPIRIT_DAMAGE@DESCRIPTION"
msgstr "Inflige [damageSpirit/] Dano de Espírito."

msgid "CONCEPT@SPIRIT_DAMAGE@HYPERLINK"
msgstr "[damageSpirit/] [hyperlink,GLOBAL.SpiritDamageConcept]Dano de Espírito[/hyperlink]"

msgid "CONCEPT@SPIRIT_DAMAGE@NAME"
msgstr "Dano de Espírito"

msgid "CONCEPT@SPIRIT_RESISTANCE@DESCRIPTION"
msgstr "Proteção de Espírito reduz {GLOBAL.SpiritDamageConcept.Hyperlink}."

msgid "CONCEPT@SPIRIT_RESISTANCE@HYPERLINK"
msgstr "[defensespirit/] [hyperlink,GLOBAL.SpiritResistanceConcept]Proteção de Espírito[/hyperlink]"

msgid "CONCEPT@SPIRIT_RESISTANCE@NAME"
msgstr "Proteção de Espírito"

msgid "CONCEPT@STATUS_RESISTANCE@DESCRIPTION"
msgstr "Resistência de Status reduz a chance de que uma unidade seja afetada por <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>>."

msgid "CONCEPT@STATUS_RESISTANCE@HYPERLINK"
msgstr "[statuseffectresistance/] [hyperlink,GLOBAL.StatusResistanceConcept]Resistência de Status[/hyperlink]"

msgid "CONCEPT@STATUS_RESISTANCE@NAME"
msgstr "Resistência de Status"

msgid "CONCEPT@SUMMON_ABILITY@DESCRIPTION"
msgstr "Uma habilidade que invoca uma unidade durante a batalha."

msgid "CONCEPT@SUMMON_ABILITY@HYPERLINK"
msgstr "[hyperlink,GLOBAL.SummoningAbilityConcept]Invocação[/hyperlink]"

msgid "CONCEPT@SUMMON_ABILITY@NAME"
msgstr "Habilidade de Invocação"

msgid "CONCEPT@SUMMON_LIVE_SHARED"
msgstr "[br/]Esta invocação dura {SUMMON_POSITION_EFFECT>TurnsToLive} <<m:{GLOBAL.TurnConcept}>>."

msgid "CONCEPT@SUPPORT_ABILITY@DESCRIPTION"
msgstr "Uma habilidade que cura ou aplica <<m:{GLOBAL.PositiveStatusEffectConcept.Hyperlink}>> a unidades amigas."

msgid "CONCEPT@SUPPORT_ABILITY@HYPERLINK"
msgstr "[hyperlink,GLOBAL.SupportConcept]Suporte[/hyperlink]"

msgid "CONCEPT@SUPPORT_ABILITY@NAME"
msgstr "Suporte"

msgid "CONCEPT@TELEPORT_ABILITY@DESCRIPTION"
msgstr "Uma habilidade que move instantaneamente a unidade que a usa para outra localização usando magia."

msgid "CONCEPT@TELEPORT_ABILITY@HYPERLINK"
msgstr "[hyperlink,GLOBAL.TeleportAbilityConcept]Teleporte[/hyperlink]"

msgid "CONCEPT@TELEPORT_ABILITY@NAME"
msgstr "Habilidade de Teleporte"

msgid "CONCEPT@TEMPORARY_HITPOINTS@DESCRIPTION"
msgstr "[bulletlist][bullet/]Pontos de Vida Temporários são concedidos a um {GLOBAL.UnitConcept.Hyperlink} quando ele é curado em {GLOBAL.CombatConcept.Hyperlink}.[bullet/]Quando uma Unidade recebe dano, os Pontos de Vida Temporários são perdidos primeiro.[bullet/]Quando o combate termina, todos os Pontos de Vida Temporários são removidos.[/bulletlist]"

msgid "CONCEPT@TEMPORARY_HITPOINTS@HYPERLINK"
msgstr "[hyperlink,GLOBAL.TemporaryHitPointConcept]Pontos de Vida Temporários[/hyperlink]"

msgid "CONCEPT@TEMPORARY_HITPOINTS@NAME"
msgstr "[temphp/] Ponto de Vida Temporário"

msgid "CONCEPT@UNIT_MORALE@DESCRIPTION"
msgstr "{GLOBAL.UnitConcept.Hyperlink} Moral representa a disposição para a batalha.[br/][bulletlist][bullet/]Moral Alta aumenta {GLOBAL.CriticalHitChanceConcept.Hyperlink}.[bullet/]Moral Baixa aumenta a chance de {GLOBAL.FumbleConcept.Hyperlink} em combate e a chance de deserção no Mapa-Múndi.[bullet/]Moral Muito Baixa aumenta ainda mais a chance de {GLOBAL.FumbleConcept.Hyperlink} e pode levar ao {GLOBAL.RoutingConcept.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> em combate e à chance de deserção no Mapa-Múndi.[/bulletlist][br/][br/]Estados de Moral:[bulletlist][bullet/]{GLOBAL.HighMoraleConcept.Hyperlink}[bullet/]{GLOBAL.NeutralMoraleConcept.Hyperlink}[bullet/]{GLOBAL.LowMoraleConcept.Hyperlink}[bullet/]{GLOBAL.VeryLowMoraleConcept.Hyperlink}[bullet/]{GLOBAL.RoutingConcept.Hyperlink}[/bulletlist]"

msgid "CONCEPT@UNIT_MORALE@HYPERLINK"
msgstr "[happiness/] [hyperlink,GLOBAL.UnitMoraleConcept]Moral[/hyperlink]"

msgid "CONCEPT@UNIT_MORALE@NAME"
msgstr "Moral"

msgid "CONCEPT@UNIT_TIER@DESCRIPTION"
msgstr "{GLOBAL.UnitConcept.Hyperlink} Nível representa sua força relativa em {GLOBAL.CombatConcept.Hyperlink}.[bulletlist][bullet/]Unidades de nível superior <<m:{GLOBAL.UnitConcept.Hyperlink}>> têm um {GLOBAL.UnitUpkeepConcept.Hyperlink} maior por turno.[bullet/]Unidades de Nível 3+ ganham {GLOBAL.StatusResistanceConcept.Hyperlink} que aumenta com níveis superiores.[bullet/]Os níveis das unidades variam de 1 a 5.[bullet/]<<m:{GLOBAL.HeroConcept.Hyperlink}>> são tratados como Nível 5 para habilidades e habilidades relevantes.[/bulletlist]"

msgid "CONCEPT@UNIT_TIER@HYPERLINK"
msgstr "[hyperlink,GLOBAL.UnitTierConcept]Nível da Unidade[/hyperlink]"

msgid "CONCEPT@UNIT_TIER@NAME"
msgstr "Nível da Unidade"

msgid "CONCEPT@VERYLOWMORALE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.VeryLowMoraleConcept]Moral Muito Baixa[/hyperlink]"

msgid "CONCEPT@WORLD_MAP_REGENERATION@DESCRIPTION"
msgstr "Unidades recuperam um certo número de <<m:{GLOBAL.HitPointConcept.Hyperlink}>> a cada {GLOBAL.TurnConcept.Hyperlink} quando não estão em combate.[br/][br/]A quantidade de pontos de vida recuperados é maior quando a unidade está em seu {GLOBAL.DomainConcept.Hyperlink} próximo a uma de suas <<m:{GLOBAL.CityConcept.Hyperlink}>> ou <<m:{GLOBAL.OutpostConcept.Hyperlink}>>. Estar no domínio inimigo ou no território de um {GLOBAL.InfestationConcept.Hyperlink} reduz a regeneração.[br/][br/]A Regeneração no Mapa-Múndi também pode ser aumentada por certas Habilidades de Herói e <<m:{GLOBAL.EmpireSkillConcept.Hyperlink}>>."

msgid "CONCEPT@WORLD_MAP_REGENERATION@HYPERLINK"
msgstr "[hyperlink,GLOBAL.WorldMapRegeneration]Regeneração no Mapa-Múndi[/hyperlink]"

msgid "CONCEPT@WORLD_MAP_REGENERATION@NAME"
msgstr "Regeneração no Mapa-Múndi"

msgid "CONCEPT@ZONE_OF_CONTROL@HYPERLINK"
msgstr "[hyperlink,GLOBAL.ZoneOfControlConcept]Zona de Controle[/hyperlink]"

msgid "CONCEPT@ZONE_OF_CONTROL@NAME"
msgstr "Zona de Controle"

msgid "CONCEPT@ZONE_OF_CONTROL@SHORT_DESCRIPTION"
