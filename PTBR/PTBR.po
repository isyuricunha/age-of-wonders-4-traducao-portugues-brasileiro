msgid "DLC@GIANTKINGS@RACE_NAMES@RACE3@NAME"
msgstr "Sapos-de-Pedra"

msgid "DLC@GIANTKINGS@RACE_NAMES@RACE4@NAME"
msgstr "Nascidos do Gelo"

msgid "DLC@GIANTKINGS@REALMTRAITS_TSR_GOM@GIANT_FORUM@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{baseincome} {GLOBAL.StructureProductionConcept.Hyperlink}.[bullet/]+{adjacentgoldincome} {GLOBAL.ImperiumConcept.Hyperlink} por {GLOBAL.SpecialImprovementConcept.Hyperlink} adjacente.[bullet/]Conta como um(a) {GLOBAL.QuarryConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@REALMTRAITS_TSR_GOM@GIANT_FORUM@NAME"
msgstr "[quarry/] Fórum dos Gigantes"

msgid "DLC@GIANTKINGS@REALM_TRAIT@CRYSTAL_DWELLING@DESCRIPTION"
msgstr "Há um(a) {GLOBAL.CrystalDwellingConcept.Hyperlink} presente neste mapa, envolvido(a) em sua eterna busca por conhecimento."

msgid "DLC@GIANTKINGS@REALM_TRAIT@CRYSTAL_DWELLING@NAME"
msgstr "Morada de Cristal"

msgid "DLC@GIANTKINGS@REALM_TRAIT@MRN_MOUNTAIN_KING@DESCRIPTION"
msgstr "Este reino já fez parte do lendário reino dos Gigantes chamado {GLOBAL.MyrridaLoreConcept.Hyperlink}.[br/][bulletlist][bullet/]Há Regiões Fatídicas presentes no mapa que oferecem cadeias de missões explorando o presente e o passado de {GLOBAL.MyrridaLoreConcept.Hyperlink}.[bullet/]Ganhe <<m:{GLOBAL.ArtifactConcept.Hyperlink}>> ao completar Regiões Fatídicas, que concedem bônus únicos e podem ser coletadas para iniciar Eventos de Impacto subsequentes.[bullet/]Regiões Fatídicas são afetadas por {GLOBAL.PROPERTIES.WARDED_BY_FATE.Hyperlink}.[bullet/]Apenas algumas das Regiões Fatídicas disponíveis estarão presentes, deixando mais para serem exploradas em outro reino.[/bulletlist]"

msgid "DLC@GIANTKINGS@REALM_TRAIT@MRN_MOUNTAIN_KING@NAME"
msgstr "Lendas de Myrrida"

msgid "DLC@GIANTKINGS@REALM_TRAIT@TSR_SET_01@NAME"
msgstr "Conjunto TSR: Herdeiros dos Reis Gigantes (NÃO ENVIAR ESTE)"

msgid "DLC@GIANTKINGS@REALM_TRAIT@TSR_SET_02@NAME"
msgstr "Conjunto TSR: Pecados dos Reis Traidores (NÃO ENVIAR ESTE)"

msgid "DLC@GIANTKINGS@REALM_TRAIT@TSR_SET_03@NAME"
msgstr "Conjunto TSR: Glória de Myrrida (NÃO ENVIAR ESTE)"

msgid "DLC@GIANTKINGS@RELIC@FLOWROCK_CORNUCOPIA@DESCRIPTION"
msgstr "[bulletlist][bullet/]Libera a produção do(a) {GLOBAL.STRUCTURE_UPGRADES.GIANT_FORUM_SPI.Hyperlink} {GLOBAL.SpecialImprovementConcept.Hyperlink} em seu(sua) <<m:{GLOBAL.CityConcept.Hyperlink}>>.[bullet/]O(A) {GLOBAL.STRUCTURE_UPGRADES.GIANT_FORUM_SPI.Hyperlink} recebe os seguintes benefícios:[bulletlist][bullet/]{IntProdBonus} renda de {GLOBAL.StructureProductionConcept.Hyperlink}.[bullet/]{IntFoodBonus} {GLOBAL.FoodConcept.Hyperlink} por {GLOBAL.FarmConcept.Hyperlink} ou {GLOBAL.ForesterConcept.Hyperlink} adjacente.[bullet/]Conta como um(a) {GLOBAL.FarmConcept.Hyperlink} e {GLOBAL.ForesterConcept.Hyperlink} além de seus outros tipos.[/bulletlist][/bulletlist]"

msgid "DLC@GIANTKINGS@RELIC@FLOWROCK_CORNUCOPIA@LORE"
msgstr "“Prometo minha proteção aos sobreviventes[br/]Das garras da Urselva[br/]Guiá-los é minha missão, alimentá-los, meu dever”"

msgid "DLC@GIANTKINGS@RELIC@FLOWROCK_CORNUCOPIA@NAME"
msgstr "Cornucópia de Rocha Fluida^n"

msgid "DLC@GIANTKINGS@RELIC@FLOWROCK_CREST@DESCRIPTION"
msgstr "[bulletlist][bullet/]Libera a produção do(a) {GLOBAL.STRUCTURE_UPGRADES.GIANT_FORUM_SPI.Hyperlink} {GLOBAL.SpecialImprovementConcept.Hyperlink} em seu(sua) <<m:{GLOBAL.CityConcept.Hyperlink}>>.[bullet/]O(A) {GLOBAL.STRUCTURE_UPGRADES.GIANT_FORUM_SPI.Hyperlink} recebe os seguintes benefícios:[bulletlist][bullet/]{IntProdBonus} renda de {GLOBAL.StructureProductionConcept.Hyperlink}.[bullet/]{IntGoldBonus} {GLOBAL.GoldConcept.Hyperlink} por {GLOBAL.MineConcept.Hyperlink} ou {GLOBAL.QuarryConcept.Hyperlink} adjacente.[bullet/]Conta como um(a) {GLOBAL.MineConcept.Hyperlink} além de seus outros tipos.[/bulletlist][/bulletlist]"

msgid "DLC@GIANTKINGS@RELIC@FLOWROCK_CREST@LORE"
msgstr "“O abrigo que eu esculpo suporta o peso da civilização[br/]Construirei grandioso e firme[br/]Na riqueza habitarão todos que adentrarem meus salões”"

msgid "DLC@GIANTKINGS@RELIC@FLOWROCK_CREST@NAME"
msgstr "Crista de Rocha Fluida^n"

msgid "DLC@GIANTKINGS@RELIC@FLOWROCK_SCALES@DESCRIPTION"
msgstr "[bulletlist][bullet/]Libera a produção do(a) {GLOBAL.STRUCTURE_UPGRADES.GIANT_FORUM_SPI.Hyperlink} {GLOBAL.SpecialImprovementConcept.Hyperlink} em seu(sua) <<m:{GLOBAL.CityConcept.Hyperlink}>>.[bullet/]O(A) {GLOBAL.STRUCTURE_UPGRADES.GIANT_FORUM_SPI.Hyperlink} recebe os seguintes benefícios:[bulletlist][bullet/]{IntProdBonus} renda de {GLOBAL.StructureProductionConcept.Hyperlink}.[bullet/]{IntKnowledgeBonus} {GLOBAL.KnowledgeConcept.Hyperlink} por {GLOBAL.ConduitConcept.Hyperlink} ou {GLOBAL.ResearchPostConcept.Hyperlink} adjacente.[bullet/]Conta como um(a) {GLOBAL.ConduitConcept.Hyperlink} e {GLOBAL.ResearchPostConcept.Hyperlink} além de seus outros tipos.[/bulletlist][/bulletlist]"

msgid "DLC@GIANTKINGS@RELIC@FLOWROCK_SCALES@LORE"
msgstr "“Onde a igualdade reina entre as raças, grandes e pequenas[br/]Com sabedoria devo forjar e moldar a lei[br/]Tudo isso juro pelo sangue de Gudfjalla[br/]Que os Titãs sejam os juízes deste Rei Gigante”"

msgid "DLC@GIANTKINGS@RELIC@FLOWROCK_SCALES@NAME"
msgstr "Escamas de Rocha Fluida^n"

msgid "DLC@GIANTKINGS@RELIC@LITHORITE_GLOBE@DESCRIPTION"
msgstr "[bulletlist][bullet/]Desbloqueia Estudos Eternos no seu <<m:{GLOBAL.CityConcept.Hyperlink}>>, que converte o(a) {GLOBAL.StructureProductionConcept.Hyperlink} da cidade em {GLOBAL.KnowledgeConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@RELIC@LITHORITE_GLOBE@KNOWLEDGE_CONVERSION@NAME"
msgstr "Estudos Eternos"

msgid "DLC@GIANTKINGS@RELIC@LITHORITE_GLOBE@LORE"
msgstr "“Para escapar da ordem justa, devemos quadrar o círculo[br/]Para fugir do fogo do dragão, realizar um verdadeiro milagre[br/]Transcendendo nossas almas em gaiolas cristalinas[br/]Não mais Reis Gigantes, tornamo-nos Sábios Eternos”"

msgid "DLC@GIANTKINGS@RELIC@LITHORITE_GLOBE@NAME"
msgstr "Astrolábio de Litório^n"

msgid "DLC@GIANTKINGS@RELIC@LITHORITE_PRISM@DESCRIPTION"
msgstr "[bulletlist][bullet/]Seus(as) <<m:{GLOBAL.CityConcept.Hyperlink}>> ganham:[bulletlist][bullet/]{IntStabilityBuff} {GLOBAL.CityStabilityConcept.Hyperlink} se você tiver um(a) {GLOBAL.OrderConcept.Hyperlink} {GLOBAL.TomeConcept.Hyperlink} na sua biblioteca.[bullet/]{IntFoodBuff} {GLOBAL.FoodConcept.Hyperlink} se você tiver um(a) {GLOBAL.NatureConcept.Hyperlink} {GLOBAL.TomeConcept.Hyperlink} na sua biblioteca.[bullet/]{IntGoldBuff} {GLOBAL.GoldConcept.Hyperlink} se você tiver um(a) {GLOBAL.MateriumConcept.Hyperlink} {GLOBAL.TomeConcept.Hyperlink} na sua biblioteca.[bullet/]{IntDraftBuff} {GLOBAL.UnitProductionConcept.Hyperlink} se você tiver um(a) {GLOBAL.ChaosConcept.Hyperlink} {GLOBAL.TomeConcept.Hyperlink} na sua biblioteca.[bullet/]{IntKnowledgeBuff} {GLOBAL.KnowledgeConcept.Hyperlink} se você tiver um(a) {GLOBAL.ShadowConcept.Hyperlink} {GLOBAL.TomeConcept.Hyperlink} na sua biblioteca.[bullet/]{IntManaBuff} {GLOBAL.ManaConcept.Hyperlink} se você tiver um(a) {GLOBAL.AstralConcept.Hyperlink} {GLOBAL.TomeConcept.Hyperlink} na sua biblioteca.[bullet/]Para afinidades duplas <<m:{GLOBAL.TomeConcept.Hyperlink}>>, esses bônus são reduzidos pela metade.[/bulletlist][/bulletlist]"

msgid "DLC@GIANTKINGS@RELIC@LITHORITE_PRISM@LORE"
msgstr "“Das profundezas da história, provas registradas[br/]Em bibliotecas reunimos conhecimento ilimitado[br/]Os segredos cósmicos ocultos sob a terra”"

msgid "DLC@GIANTKINGS@RELIC@LITHORITE_PRISM@NAME"
msgstr "Prisma de Litório^n"

msgid "DLC@GIANTKINGS@RELIC@LITHORITE_SCROLL@DESCRIPTION"
msgstr "[bulletlist][bullet/]{IntAffinityIncrease} {GLOBAL.OrderConcept.Hyperlink}[bullet/]{IntAffinityIncrease} {GLOBAL.NatureConcept.Hyperlink}[bullet/]{IntAffinityIncrease} {GLOBAL.MateriumConcept.Hyperlink}[bullet/]{IntAffinityIncrease} {GLOBAL.ChaosConcept.Hyperlink}[bullet/]{IntAffinityIncrease} {GLOBAL.ShadowConcept.Hyperlink}[bullet/]{IntAffinityIncrease} {GLOBAL.AstralConcept.Hyperlink}[/bulletlist]"

msgid "DLC@GIANTKINGS@RELIC@LITHORITE_SCROLL@LORE"
msgstr "“Há música nestes cristais, ouça[br/]Que os sinos de dias esquecidos brilhem[br/]Discernir as notas é ler a verdade”"

msgid "DLC@GIANTKINGS@RELIC@LITHORITE_SCROLL@NAME"
msgstr "Pergaminho de Litório^n"

msgid "DLC@GIANTKINGS@RELIC@MENHIR_OF_FIRE@DESCRIPTION"
msgstr "[bulletlist][bullet/]Adiciona {IntRallyPoints} <<m:{GLOBAL.RecruitmentPointsConcept.Hyperlink}>> e a unidade {GLOBAL.UNITS.FIRE_GIANT.Hyperlink} ao(a) {GLOBAL.RequestMilitaryAidConcept.Hyperlink}.[bullet/]Todas as unidades não-herói <<m:{GLOBAL.PROPERTIES.GIANT.Hyperlink} >> e Demigigantes que você controla ganham {GLOBAL.PROPERTIES.TSR_MS_RELIC_UNIT_PROP.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@RELIC@MENHIR_OF_FIRE@LORE"
msgstr "“Funesto o fogo que abalou o Henge dos Titãs[br/]Irradiando a luz da vingança dos Arcontes[br/]Escancarando as mandíbulas do enxame de Lindworms”"

msgid "DLC@GIANTKINGS@RELIC@MENHIR_OF_FIRE@NAME"
msgstr "Menir do Fogo^n"

msgid "DLC@GIANTKINGS@RELIC@MENHIR_OF_FIRE@UNIT_PROP@DESCRIPTION"
msgstr "Unidade tem:[bulletlist][bullet/]+{RELIC_UNIT_EXTRA_DMG>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} em ataques básicos, [hyperlink,GLOBAL.EnchantingNonRepeatingConcept]aumentado[/hyperlink] para ataques de Tiro Único.[bullet/]+{RELIC_UNIT_EXTRA_RESISTANCE>DEF_MOD>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}[bullet/]+{RELIC_UNIT_EXTRA_RESISTANCE>REDUCTION>Fire} {GLOBAL.FireResistanceConcept.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.VENGEFUL_FLAMES.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.STATUS_EFFECT_IMMUNITY_BURNING.Hyperlink}[/bulletlist]"

msgid "DLC@GIANTKINGS@RELIC@MENHIR_OF_FIRE@UNIT_PROP@NAME"
msgstr "Bênção da Chama"

msgid "DLC@GIANTKINGS@RELIC@MENHIR_OF_STONE@DESCRIPTION"
msgstr "[bulletlist][bullet/]Adiciona {IntRallyPoints} <<m:{GLOBAL.RecruitmentPointsConcept.Hyperlink}>> e a unidade {GLOBAL.UNITS.ROCK_GIANT.Hyperlink} ao(a) {GLOBAL.RequestMilitaryAidConcept.Hyperlink}.[bullet/]Todas as unidades não-herói <<m:{GLOBAL.PROPERTIES.GIANT.Hyperlink} >> e Demigigantes que você controla ganham {GLOBAL.PROPERTIES.TSR_HOE_RELIC_UNIT_PROP.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@RELIC@MENHIR_OF_STONE@LORE"
msgstr "“Thagnokar caiu, triturado como uma pedra[br/]Myrrida sua carne, Myrrida seu osso[br/]Lembrem-se, meus parentes, nosso sangue que encharcou[br/]Estas rochas rúnicas sagradas do Henge dos Titãs”"

msgid "DLC@GIANTKINGS@RELIC@MENHIR_OF_STONE@NAME"
msgstr "Menir da Rocha^n"

msgid "DLC@GIANTKINGS@RELIC@MENHIR_OF_STONE@UNIT_PROP@DESCRIPTION"
msgstr "Unidade tem:[bulletlist][bullet/]+{RELIC_UNIT_EXTRA_DMG>ResolvedMultiplier}% de dano.[bullet/]+{RELIC_UNIT_EXTRA_RESISTANCE>DEF_MOD>Armor} {GLOBAL.DefenseConcept.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.EXPEDITED_MOUNTAIN.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.CAVE_WALK.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.STATUS_EFFECT_IMMUNITY_BLEEDING.Hyperlink}[/bulletlist]"

msgid "DLC@GIANTKINGS@RELIC@MENHIR_OF_STONE@UNIT_PROP@NAME"
msgstr "Bênção da Rocha"

msgid "DLC@GIANTKINGS@RELIC@MENHIR_OF_STORMS@DESCRIPTION"
msgstr "[bulletlist][bullet/]Adiciona {IntRallyPoints} <<m:{GLOBAL.RecruitmentPointsConcept.Hyperlink}>> e a unidade {GLOBAL.UNITS.STORM_GIANT.Hyperlink} ao {GLOBAL.RequestMilitaryAidConcept.Hyperlink}.[bullet/]Todos os <<m:{GLOBAL.PROPERTIES.GIANT.Hyperlink} >> e Demigigantes não-heróis que você controla ganham {GLOBAL.PROPERTIES.TSR_CSP_RELIC_UNIT_PROP.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@RELIC@MENHIR_OF_STORMS@LORE"
msgstr "\"No entanto, Thagnokar permaneceu, montanha na tempestade[br/]Seu martelo ele brandiu, esmagando inimigo após inimigo[br/]Angústia dracônica, desespero celestial\""

msgid "DLC@GIANTKINGS@RELIC@MENHIR_OF_STORMS@NAME"
msgstr "Menir das Tempestades^n"

msgid "DLC@GIANTKINGS@RELIC@MENHIR_OF_STORMS@UNIT_PROP@DESCRIPTION"
msgstr "Unidade tem:[bulletlist][bullet/]+{RELIC_UNIT_EXTRA_DMG>DAMAGE>Shock} {GLOBAL.LightningDamageConcept.Hyperlink} em ataques básicos, [hyperlink,GLOBAL.EnchantingNonRepeatingConcept]aumentado[/hyperlink] para ataques de Tiro Único.[bullet/]+{RELIC_UNIT_EXTRA_RESISTANCE>DEF_MOD>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}[bullet/]+{RELIC_UNIT_EXTRA_RESISTANCE>REDUCTION>Shock} {GLOBAL.LightningResistanceConcept.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.ATTUNEMENT_FORTUNE.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.STATUS_EFFECT_IMMUNITY_ELECTRIFY.Hyperlink}[/bulletlist]"

msgid "DLC@GIANTKINGS@RELIC@MENHIR_OF_STORMS@UNIT_PROP@NAME"
msgstr "Bênção das Tempestades"

msgid "DLC@GIANTKINGS@RELIC@SOULCURSED_CAULDRON@DESCRIPTION"
msgstr "[bulletlist][bullet/]Desbloqueia o feitiço {GLOBAL.SPECIAL_OPERATIONS.SOULCURSE_OF_GLUTTONY.Hyperlink}.[bullet/]Sempre que você conjurar um feitiço de maldição de alma, há uma chance de {IntChance} do seu governante ganhar um pouco de {GLOBAL.ExperienceConcept.Hyperlink}.[bulletlist][bullet/]A quantidade de {GLOBAL.ExperienceConcept.Hyperlink} ganha dessa forma escala com o nível do feitiço de maldição de alma conjurado.[bullet/]Quando vários desses efeitos extras de conjuração de maldição de alma puderem ser acionados, suas chances de acionamento são somadas, mas um máximo de {IntEffects} efeitos são acionados.[/bulletlist][/bulletlist]"

msgid "DLC@GIANTKINGS@RELIC@SOULCURSED_CAULDRON@LORE"
msgstr "“Comece, maldição, executora da desgraça[br/]Rasteje dentro de sua vítima, cause uma ferida purulenta[br/]Primeiro uma fome insaciável, uma saciedade faminta“"

msgid "DLC@GIANTKINGS@RELIC@SOULCURSED_CAULDRON@NAME"
msgstr "Caldeirão Amaldiçoado^n"

msgid "DLC@GIANTKINGS@RELIC@SOULCURSED_CAULDRON@NOTIFICATION_CULTISTS"
msgstr "Feitiço Amaldiçoado: Pequeno Exército de Sectários Reunido"

msgid "DLC@GIANTKINGS@RELIC@SOULCURSED_CAULDRON@NOTIFICATION_GOLD"
msgstr "Feitiço Amaldiçoado: {INT_CAULDRON_GOLD} [gold/] Ouro Ganho"

msgid "DLC@GIANTKINGS@RELIC@SOULCURSED_CAULDRON@NOTIFICATION_IMPERIUM"
msgstr "Feitiço Amaldiçoado: {INT_CAULDRON_IMPERIUM} [influence/] Império Ganho"

