msgid "TOME_ARCH_MAGE@PASSIVE@NAME"
msgstr "Mestre Tecelão de Feitiços"

msgid "TOME_ARCH_MAGE@SKILL1@DESCRIPTION"
msgstr "Faz seu governante teleportar para o hexágono mundial alvo."

msgid "TOME_ARCH_MAGE@SKILL1@NAME"
msgstr "Viagem Astral"

