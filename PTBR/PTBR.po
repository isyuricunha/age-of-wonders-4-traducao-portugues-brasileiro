msgid "DIPLOMATICSTATES_DEFINITIONS@CONSULATE@NAME"
msgstr "Vínculo de Feiticeiros"

msgid "DIPLOMATICSTATES_DEFINITIONS@DEFENSIVEPACT@AI_DESC"
msgstr "Um pacto defensivo garantirá que nenhum outro Governante ouse nos desafiar."

msgid "DIPLOMATICSTATES_DEFINITIONS@DEFENSIVEPACT@DESCRIPTION"
msgstr "Um Estado Diplomático no qual <<m:{GLOBAL.LeaderConcept.Hyperlink}>> juram ajudar um ao outro em guerras defensivas.[br/][br/]Quando uma guerra é declarada contra qualquer um dos Governantes, eles enviarão automaticamente uma {GLOBAL.CallToWarConcept.Hyperlink} ao outro, pedindo ajuda. Atender a esse chamado à guerra dará ao Governante <<m:{GLOBAL.CasusBelliConcept.Hyperlink}>> adicionais para usar diretamente. Os Governantes ainda podem recusar o chamado, mas quebrarão o pacto defensivo se o fizerem.[br/][br/]Leva a:[bulletlist][bullet/]{GLOBAL.DSAllianceConcept.Hyperlink}[bullet/]{GLOBAL.ShareVisionConcept.Hyperlink}[/bulletlist]"

msgid "DIPLOMATICSTATES_DEFINITIONS@DEFENSIVEPACT@HYPERLINK"
msgstr "[rs_defensivepact/][hyperlink,GLOBAL.DefensivePactConcept]Pacto Defensivo[/hyperlink]"

msgid "DIPLOMATICSTATES_DEFINITIONS@DEFENSIVEPACT@NAME"
msgstr "Pacto Defensivo"

msgid "DIPLOMATICSTATES_DEFINITIONS@OPENBORDERS@AI_DESC"
msgstr "Vamos abrir nossas fronteiras um para o outro. Isso melhoraria muito nossa mobilidade."

msgid "DIPLOMATICSTATES_DEFINITIONS@OPENBORDERS@DESCRIPTION"
msgstr "Tanto <<m:{GLOBAL.LeaderConcept}>> abrem suas fronteiras um para o outro. Isso permite que <<m:{GLOBAL.ArmyConcept.Hyperlink}>> se movam pelo <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> do Governante oposto sem [hyperlink,GLOBAL.TrespassingConcept]invadir[/hyperlink]."

msgid "DIPLOMATICSTATES_DEFINITIONS@OPENBORDERS@HYPERLINK"
msgstr "[hyperlink,GLOBAL.OpenBordersConcept]Abrir Fronteiras[/hyperlink]"

msgid "DIPLOMATICSTATES_DEFINITIONS@OPENBORDERS@NAME"
msgstr "Fronteiras Abertas"

msgid "DIPLOMATICSTATES_DEFINITIONS@OPENBORDERSFORTURNS@DESCRIPTION"
msgstr "Ambos os Governantes abrem suas fronteiras um para o outro por uma duração fixa.[br/][br/]Efeitos:[bulletList][bullet/]{RelationValue}[goodRelation/] Relações.[bullet/]Os Governantes podem mover seus exércitos livremente pelo domínio um do outro.[/bulletList]"

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_ALLIANCE@AI_DESC"
msgstr "Proponho que forjemos uma aliança para que possamos nos ajudar em tempos de guerra."

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_ALLIANCE@DESCRIPTION"
msgstr "Propor um(a) {GLOBAL.DSAllianceConcept.Hyperlink} ao outro Governante. Esta é a relação mais forte possível que se pode ter. Ambos os Governantes precisam concordar com um(a) {GLOBAL.DefensivePactConcept.Hyperlink} primeiro. {LOC.DIPLOMATICSTATES_DEFINITIONS@OPTION_RETURNCAPTUREDHEROES@DESCRIPTION_TRADE}"

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_ALLIANCE@NAME"
msgstr "Propor Aliança"

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_NEUTRAL@AI_DESC"
msgstr "Vamos esquecer o passado e seguir para um novo futuro!"

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_NEUTRAL@DESCRIPTION"
msgstr "Ambos os Governantes concordam em encerrar a guerra e declarar uma trégua, prometendo cessar todas as ações hostis."

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_NEUTRAL@NAME"
