msgid "DLC@WAYSOFWAR@TOME_CALAMITY@SKILL1@DESCRIPTION"
msgstr "Alvo possuído não arruinado {GLOBAL.ProvinceConcept.Hyperlink} se transforma em Ruínas e terreno Desolado e então invoca um {GLOBAL.UNITS.DRAGON_OF_CALAMITY.Hyperlink}, uma unidade {GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink} com fortes capacidades ofensivas."

msgid "DLC@WAYSOFWAR@TOME_CALAMITY@SKILL1@NAME"
msgstr "Invocar Dragão da Calamidade"

msgid "DLC@WAYSOFWAR@TOME_CALAMITY@SKILL2@DESCRIPTION"
msgstr "Unidades em um raio de {METEOR_OF_CALAMITY_UNIT_TARGETER_CIRCLE>AREA>Radius} hexágonos:[bulletlist][bullet/]Sustenta {METEOR_OF_CALAMITY_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Sustenta {METEOR_OF_CALAMITY_UNIT_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Tem {FROZEN_RESISTANCE>ResolvedStrength}% de chance base de se tornar {GLOBAL.PROPERTIES.FROZEN.Hyperlink} por {FROZEN_EFFECT_DESCRIPTION>NumTurns} {GLOBAL.TurnConcept}.[bullet/]Ganha {amountStacks1} pilhas de {GLOBAL.PROPERTIES.GHOSTFIRE.Hyperlink} por {GHOSTFIRE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@WAYSOFWAR@TOME_CALAMITY@SKILL2@NAME"
