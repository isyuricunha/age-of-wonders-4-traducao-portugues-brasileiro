msgid "TOME_SUMMONING@ABILITY_03@NAME"
msgstr "Fragmentar-se"

msgid "TOME_SUMMONING@HERO_SKILL@DESCRIPTION"
msgstr "Começa o combate com um(a) {GLOBAL.UNITS.ASTRAL_WISP_UNIT.Hyperlink}."

msgid "TOME_SUMMONING@HERO_SKILL@NAME"
msgstr "Familiar Espectral"

msgid "TOME_SUMMONING@PASSIVE@DESCRIPTION"
msgstr "{GLOBAL.CombatSummonSpellConcept.Hyperlink} e {GLOBAL.StrategicSummonSpellConcept.Hyperlink} custam -{amount}% de <<m:{GLOBAL.CombatCastingPointConcept.Hyperlink}>>."

msgid "TOME_SUMMONING@PASSIVE@NAME"
msgstr "Doutrina de Conjuração"

msgid "TOME_SUMMONING@SKILL1@DESCRIPTION"
msgstr "Unidade inimiga alvo {GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink} tem uma chance base de {ARCANE_BIND_RESISTANCE_CHECK>ResolvedStrength}% de ficar {GLOBAL.PROPERTIES.DOMINATED.Hyperlink} por {ARCANE_BIND_MIND_CONTROL>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[br/][br/]Se não for bem-sucedido, causa {ARCANE_BIND_UNIT_DAMAGE>DAMAGE>Shock} {GLOBAL.LightningDamageConcept.Hyperlink} em vez disso."

msgid "TOME_SUMMONING@SKILL1@NAME"
msgstr "Vínculo Arcano"

msgid "TOME_SUMMONING@SKILL2@DESCRIPTION"
msgstr "Cura todas as unidades aliadas {GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink} em +{ARCANE_RESTORATION_UNIT_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>."

msgid "TOME_SUMMONING@SKILL2@NAME"
msgstr "Restauração Arcana"

