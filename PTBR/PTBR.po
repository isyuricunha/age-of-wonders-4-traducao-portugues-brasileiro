msgid "DLC@GIANTKINGS@HOTGK_FINISHER@DESCRIPTION_NON_HEIR"
msgstr "Os Clãs Gigantes se uniram para atacar todos os impérios do reino. Eles invocam \"Herdeiro de Thagnokar\" para conduzi‑los à vitória contra as raças menores."

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@GRIEVANCE"
msgstr "{STR_leaderName} está liderando o assalto dos Clãs Gigantes a este reino!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@HEADER_ACTIVE_ASSAULT"
msgstr "Defenda {HOTGK_TARGET_CITY} contra o exército {HOTGK_CLAN_NAME}!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@HEADER_ACTIVE_ASSAULT_HEIR"
msgstr "Os Clãs Gigantes estão assaltando o reino!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@HEADER_CITY_CONQUERED"
msgstr "Pare o {HOTGK_CLAN_NAME} antes que arrasem {HOTGK_TARGET_CITY}!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@HEADER_CITY_RAZED"
msgstr "Depois de arrasar {HOTGK_TARGET_CITY}, o {HOTGK_CLAN_NAME} retirou‑se do seu domínio."

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@HEADER_CITY_RAZED_OTHER"
msgstr "Depois que {HOTGK_TARGET_CITY} foi arrasada, o {HOTGK_CLAN_NAME} abortou o assalto."

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@HEADER_CITY_TARGET_SCRIED"
msgstr "Herdeiro de Thagnokar: {HOTGK_TARGET_CITY} será atacada!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@HEADER_CITY_TARGET_SCRIED_DESC"
msgstr "Por meio da sua conexão com a terra, você percebeu que os Clãs Gigantes estão se dirigindo à sua cidade de {HOTGK_TARGET_CITY}. Todas as defesas devem ser preparadas!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@HEADER_DEFEATED_ASSAULT"
msgstr "Você derrotou o invasor {HOTGK_CLAN_NAME}!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@HEADER_END"
msgstr "Os assaltos dos Clãs Gigantes terminaram."

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@HEADER_INCOMING_ASSAULT"
msgstr "Prepare‑se para o assalto dos Clãs Gigantes!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@ARMY_DESTROYED@DESCRIPTION"
msgstr "Um dos exércitos dos Clãs Gigantes que atacavam o reino foi destruído por outro jogador."

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@ARMY_DESTROYED@HEADER"
msgstr "Herdeiro de Thagnokar: Exército do Clã destruído!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@CITY_LOST@DESCRIPTION"
msgstr "O {HOTGK_CLAN_NAME} capturou {HOTGK_TARGET_CITY} e começou a arrasá‑la. Reconquiste a cidade para detê‑los!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@CITY_LOST@HEADER"
msgstr "Herdeiro de Thagnokar: {HOTGK_TARGET_CITY} perdeu!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@CITY_RAZED@DESCRIPTION"
msgstr "O {HOTGK_CLAN_NAME} arrasou {HOTGK_TARGET_CITY}. Após sua obra de devastação, retirou‑se do seu domínio, mas os acontecimentos deste dia marcaram seu império para as eras vindouras."

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@CITY_RAZED@HEADER"
msgstr "Herdeiro de Thagnokar: {HOTGK_TARGET_CITY} arrasada!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@CITY_RAZED_HEIR@DESCRIPTION"
msgstr "Um dos exércitos dos Clãs Gigantes arrasou a cidade que atacou. Eles dedicaram essa vitória a você, Herdeiro de Thagnokar, e você recebe {HOTGK_RAZE_IMP_REWARD} {GLOBAL.ImperiumConcept.Hyperlink}. Depois, o exército do clã retirou‑se com seus despojos para se recuperar da batalha."

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@CITY_RAZED_HEIR@HEADER"
msgstr "Herdeiro de Thagnokar: Saque do clã bem‑sucedido!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@CITY_RAZED_OTHER@DESCRIPTION"
msgstr "Irritado pela destruição de seu alvo {HOTGK_TARGET_CITY}, o {HOTGK_CLAN_NAME} retirou‑se para suas profundas salas ocultas."

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@CITY_RAZED_OTHER@HEADER"
msgstr "Herdeiro de Thagnokar: O {HOTGK_CLAN_NAME} retirou‑se!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@CITY_RAZED_OTHER_HEIR@DESCRIPTION"
msgstr "Ao ver a cidade que atacaram destruída por outra facção, um dos exércitos dos Clãs Gigantes abortou o saque e retirou‑se para suas profundas salas ocultas."

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@CITY_RAZED_OTHER_HEIR@HEADER"
msgstr "Herdeiro de Thagnokar: Saque do clã abortado!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@CITY_SIEGED@DESCRIPTION"
msgstr "O {HOTGK_CLAN_NAME} está sitiando {HOTGK_TARGET_CITY}. Traga reforços para romper o cerco ou confie no poder de suas defesas."

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@CITY_SIEGED@HEADER"
msgstr "Herdeiro de Thagnokar: {HOTGK_TARGET_CITY} sitiada!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@NO_CITY_TO_RAID@DESCRIPTION"
msgstr "Como seu império não possui mais cidades, os Clãs Gigantes não enviaram nenhum exército ao seu domínio."

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@NO_CITY_TO_RAID@HEADER"
msgstr "Herdeiro de Thagnokar: Clãs Gigantes abortaram o ataque"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@OBJECTIVE_ACTIVE_ASSAULT_HEIR"
msgstr "Exércitos de Clã restantes: {HOTGK_ARMY_COUNT_GLOBAL}"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@OBJECTIVE_ACTIVE_ASSAULT_HEIR_02"
msgstr "Ganhe {HOTGK_RAZE_IMP_REWARD} {GLOBAL.ImperiumConcept.Hyperlink} quando os Clãs arrasam uma cidade."

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@OBJECTIVE_DEFEAT_ARMY"
msgstr "{HOTGK_ARMY_COUNT_CURRENT}/{HOTGK_ARMY_COUNT_MAX} {HOTGK_CLAN_NAME} Unidades Mortas"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@TOOLTIP@ATTACK_CITY_PREDICTED"
msgstr "Você descobre quais de suas cidades os Clãs Gigantes atacarão."

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@TOOLTIP@FIRE_CLAN_ARMY_JOIN"
msgstr "Você recebe um exército de unidades do {GLOBAL.FireClanLoreConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@TOOLTIP@FRIEND_OF_DEMIGIANTS"
msgstr "Os orgulhosos gigantes recusam sua oferta, mas seus irmãos Demigigantes ouvem. Você desbloqueia a produção de todas as unidades Demigigante em todas as suas cidades!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@TOOLTIP@FROST_CLAN_ARMY_JOIN"
msgstr "Você recebe um exército de unidades do Clã do Gelo."

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@TOOLTIP@GRIEVANCE_OTHERS"
msgstr "Todos os outros governantes deste reino ganham um {GLOBAL.CasusBelliConcept.Hyperlink} maior contra você."

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@TOOLTIP@INVASION_FORECAST"
msgstr "Em {IntDuration} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, um exército dos Clãs Gigantes aparecerá para cada outro jogador e atacará uma de suas cidades. Esses jogadores ganharão um {GLOBAL.CasusBelliConcept.Hyperlink} maior contra você quando isso acontecer."

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@TOOLTIP@STONE_CLAN_ARMY_JOIN"
msgstr "Você recebe um exército de unidades do {GLOBAL.StoneClanLoreConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@TOOLTIP@STORM_CLAN_ARMY_JOIN"
msgstr "Você recebe um exército de unidades do {GLOBAL.StormClanLoreConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@TOOLTIP@UNLOCK_DEMIGIANTS"
msgstr "Durante o resto do jogo, você passa a ser conhecido como Herdeiro de Thagnokar, desbloqueando o recrutamento de todas as unidades Demigigante em todas as suas cidades."

msgid "DLC@GIANTKINGS@IINTERFACE@TEXT@CRYSTAL_DWELLING_INCOME_TOOLTIP"
msgstr "A {GLOBAL.CrystalDwellingConcept.Hyperlink} concederá renda passiva de {GLOBAL.KnowledgeConcept.Hyperlink} quando estiver em um {GLOBAL.CrystalDwellingEternalPactConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@INTERFACE@CRYSTAL_DWELLING@HYPERLINK"
msgstr "[hyperlink,GLOBAL.CrystalDwellingConcept]Moradia de Cristal[/hyperlink]"

msgid "DLC@GIANTKINGS@INTERFACE@DIPLOMACY@CRYSTAL_DWELLING_WAR@DESCRIPTION"
msgstr "Um estado de [rs_war/] Guerra com um {GLOBAL.DwellingConcept.Hyperlink} significa que <<m:{GLOBAL.ArmyConcept.Hyperlink}>> pode engajar em {GLOBAL.CombatConcept.Hyperlink} e <<m:{GLOBAL.CityConcept.Hyperlink}>> pode ser atacado.[br/][br/]Durante a guerra, Moradias ocasionalmente enviam exércitos para atacar seus inimigos.[br/][br/]As guerras terminam por derrota de um dos lados ou negociando a paz."

msgid "DLC@GIANTKINGS@INTERFACE@DIPLOMACY@CRYSTAL_DWELLING_WAR@HYPERLINK"
msgstr "[rs_war/] [hyperlink,GLOBAL.CrystalDwellingWarConcept]Guerra[/hyperlink]"

