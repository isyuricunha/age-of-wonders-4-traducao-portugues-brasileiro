msgid "DLC@PRIMALFURY@TOME_FEY_MIST@TOME@LORE_DESCRIPTION"
msgstr "\"The mist conceals all. It obscures vision and confuses the senses as it claims fields and forests. Envelop yourself in this mystery, breathe in its damp, cold air and cloak yourself in the fog of the Fey-folk. Let it swallow your enemies and have them discover that there is no hiding in the haze from you.\""

msgid "DLC@PRIMALFURY@TOME_FEY_MIST@TOME@NAME"
msgstr "Tome of Fey Mists"

