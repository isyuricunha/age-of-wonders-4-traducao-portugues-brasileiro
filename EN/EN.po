msgid "DLC@EMPIRESANDASHES@RACETRAITS_WORLD@HERMIT_KINGDOM@BIO"
msgstr "They believe peace and quiet is vital for study, and will fight to ensure that peace and quiet is achieved."

msgid "DLC@EMPIRESANDASHES@RACETRAITS_WORLD@HERMIT_KINGDOM@EFFECT1@DESCRIPTION"
msgstr "<<m:{GLOBAL.CityConcept.Hyperlink}>> gain {knowledgeIncome} {GLOBAL.KnowledgeConcept.Hyperlink}, {amount2} {GLOBAL.FoodConcept.Hyperlink}, {amount3} {GLOBAL.StructureProductionConcept.Hyperlink}, and {HappinessIncome} {GLOBAL.CityStabilityConcept.Hyperlink} income when their {GLOBAL.DomainConcept.Hyperlink} does not border the {GLOBAL.DomainConcept.Hyperlink} of any other {GLOBAL.CityConcept.Hyperlink} or {GLOBAL.OutpostConcept.Hyperlink}."

msgid "DLC@EMPIRESANDASHES@RACETRAITS_WORLD@HERMIT_KINGDOM@EFFECT2@DESCRIPTION"
msgstr "Grievances inflicted by other empires encroaching on your territory are increased by {GrievanceMultiplier}%."

msgid "DLC@EMPIRESANDASHES@RACETRAITS_WORLD@HERMIT_KINGDOM@LORE"
msgstr "They seek only to be left alone to their studies and will aggressively protect their studious isolation from any disturbances."

msgid "DLC@EMPIRESANDASHES@RACETRAITS_WORLD@HERMIT_KINGDOM@NAME"
msgstr "Hermit Kingdom"

msgid "DLC@EMPIRESANDASHES@RACETRAITS_WORLD@RECLAIMERS@BIO"
msgstr "They believe everything must be reclaimed and reforged stronger."

msgid "DLC@EMPIRESANDASHES@RACETRAITS_WORLD@RECLAIMERS@EFFECT1@DESCRIPTION"
msgstr "Gain [hyperlink,GLOBAL.BindingEssenceConcept][bindingessence/] Binding Essence and [bindingfragments/] Fragments[/hyperlink] for clearing <<m:{GLOBAL.InfestationSpawnerConcept.Hyperlink}>>, clearing <<m:{GLOBAL.AncientWonderConcept.Hyperlink}>>, [hyperlink,GLOBAL.RazingConcept]Razing[/hyperlink] <<m:{GLOBAL.CityConcept.Hyperlink}>>, and {GLOBAL.PillagingConcept.Hyperlink} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>>."

msgid "DLC@EMPIRESANDASHES@RACETRAITS_WORLD@RECLAIMERS@LORE"
msgstr "They believe anything can be reforged into something better, but before that can be done, it must be reclaimed."

msgid "DLC@EMPIRESANDASHES@RACETRAITS_WORLD@RECLAIMERS@NAME"
msgstr "Reclaimers"

msgid "DLC@EMPIRESANDASHES@REALM_TRAIT@AMAZONIAN_REALM@DESCRIPTION"
msgstr "The realm is a lush jungle, surrounded by Astral Void.[bulletlist][bullet/]Tropical <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> and forest <<m:{GLOBAL.ProvinceFeatureConcept.Hyperlink}>> are [abilityblue]Common[/abilityblue].[bullet/]River <<m:{GLOBAL.ProvinceFeatureConcept.Hyperlink}>> are [abilityblue]Common[/abilityblue].[bullet/]Arctic, desert, and desolate <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> are [abilityblue]Rare[/abilityblue].[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@REALM_TRAIT@AMAZONIAN_REALM@NAME"
msgstr "Lost Jungle"

msgid "DLC@EMPIRESANDASHES@REALM_TRAIT@AVIAN_INHABITANTS@DESCRIPTION"
msgstr "The realm is home to many birds, civilized and wild.[bulletlist][bullet/]Avian <<m:{GLOBAL.IndependentCityConcept.Hyperlink}>> are [abilityblue]Common[/abilityblue].[bullet/]<<m:{GLOBAL.STRUCTURES.GREAT_BIRD_NEST_SPAWNER.Hyperlink}>> are [abilityblue]Common[/abilityblue].[bullet/]Bird <<m:{GLOBAL.UnitConcept.Hyperlink}>> are [abilityblue]Common[/abilityblue].[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@REALM_TRAIT@AVIAN_INHABITANTS@NAME"
msgstr "Birds of Paradise"

msgid "DLC@EMPIRESANDASHES@REALM_TRAIT@WARDEN_OF_MANUHARI@DESCRIPTION"
msgstr "This realm is protected by a powerful {GLOBAL.UNITS.PROGENITOR_GOLEM.Hyperlink}, which will periodically launch attacks on any enemies of the native [hyperlink,GLOBAL.AncientKrazuraLoreConcept]Krazura[/hyperlink]."

msgid "DLC@EMPIRESANDASHES@REALM_TRAIT@WARDEN_OF_MANUHARI@NAME"
msgstr "Warden of Manuhari"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT01@DESCRIPTION"
msgstr "Every {amount} <<m:{GLOBAL.TurnConcept}>>, enemy units:[bulletlist][bullet/]Sustain {CONDEMNATION_STRIKE_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink}.[bullet/]Have a base {CONDEMN_RESISTANCE>ResolvedStrength}% chance of becoming {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT01@NAME"
msgstr "Condemning Surge"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT02@DESCRIPTION"
msgstr "When a friendly unit dies, all adjacent enemy units:[bulletlist][bullet/]Suffer {MARTYRDOM_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink}.[bullet/]Become {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT02@NAME"
msgstr "Martyrdom"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT02@PROP_DESCRIPTION"
msgstr "When this unit dies, all adjacent enemy units:[bulletlist][bullet/]Suffer {MARTYRDOM_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink}[bullet/]Become {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT03@DESCRIPTION"
msgstr "Every {amount} <<m:{GLOBAL.TurnConcept}>>, a random friendly unit:[bulletlist][bullet/]Gains {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink}.[bullet/]Gains {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}.[bullet/]This effect then applies to adjacent friendly units and is repeated.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT03@NAME"
msgstr "Cascading Empowerment"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT04@DESCRIPTION"
msgstr "Every {amount} <<m:{GLOBAL.TurnConcept}>>, enemy units:[bulletlist][bullet/]Have a base {MISFORTUNE_RESISTANCE>ResolvedStrength}% chance of gaining {GLOBAL.PROPERTIES.MISFORTUNE.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT04@NAME"
msgstr "Wave of Misfortune"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT05@DESCRIPTION"
msgstr "Every {amount} <<m:{GLOBAL.TurnConcept}>>, {amount2} random enemy units have a:[bulletlist][bullet/]Base {GHOSTFIRE_RESISTANCE>ResolvedStrength}% chance of being inflicted with {GLOBAL.PROPERTIES.GHOSTFIRE.Hyperlink}.[bullet/]Base {ELECTRIFIED_RESISTANCE>ResolvedStrength}% chance of being inflicted with {GLOBAL.PROPERTIES.ELECTRIFIED.Hyperlink}.[bullet/]Base {FROZEN_RESISTANCE>ResolvedStrength}% chance of being inflicted with {GLOBAL.PROPERTIES.FROZEN.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT05@NAME"
msgstr "Elemental Bane"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT06@DESCRIPTION"
msgstr "Each turn, a random unit of the owner's enemies, and adjacent enemy units:[bulletlist][bullet/]Sustain {METEOR_SHOWER_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Sustain {METEOR_SHOWER_UNIT_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT06@NAME"
msgstr "Minute Meteors"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT07@DESCRIPTION"
msgstr "A {GLOBAL.UNITS.DECAYING_ZOMBIE.Hyperlink} is summoned next to one of the owner's units every {amount} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT07@NAME"
msgstr "Open Graves"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT08@DESCRIPTION"
msgstr "Every {GLOBAL.TurnConcept}, {amount2} random units of the owner's enemies suffer:[bulletlist][bullet/]{COSMIC_BOLT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}[bullet/]{COSMIC_BOLT_DAMAGE>DAMAGE>Shock} {GLOBAL.LightningDamageConcept.Hyperlink}[bullet/]{COSMIC_BOLT_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT08@NAME"
msgstr "Cosmic Bolts"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT09@DESCRIPTION"
msgstr "A {GLOBAL.UNITS.GREMLIN_UNIT.Hyperlink} is summoned next to one of the owner's units every {amount} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@CONDITION@DESCRIPTION"
msgstr "To achieve the Seals Victory, an {GLOBAL.EmpireConcept.Hyperlink} needs to accumulate enough points from capturing and holding Seals.[br/][br/]Seals are found throughout the world and can be captured at any time. For each seal you have captured, you gain 1 point each {GLOBAL.TurnConcept.Hyperlink}. During this time, Seal defenders will spawn every few <<m:{GLOBAL.TurnConcept.Hyperlink}>> at one of your claimed Seals and attempt to take back the Seal from your control. If you control more Seals, they will spawn more often.[br/][br/]The Seals Victory has to be enabled by adding one of the Seal Realm Traits."

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@CONDITION@NAME"
msgstr "Seals Victory"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@EVENT_SEAL_CAPTURED@OTHER"
msgstr "It is clear <<p:{Player.Name}>> is going for a {GLOBAL.SealsVictoryConcept.Hyperlink}. You will either need to prevent <<P:{Player.Name}>> from holding Seals, or hold Seals of your own."

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@EVENT_SEAL_CAPTURED@YOU"
msgstr "As long as you have an army on the Seal, you will earn points towards a {GLOBAL.SealsVictoryConcept.Hyperlink}. Beware, for the Guardians of the Seal will attempt to reclaim it!"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@NOTIFY_ATTACKERS_SPAWNED@YOU"
msgstr "Seal Defenders have spawned"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@NOTIFY_SEAL_CAPTURED@OTHER"
msgstr "{Player.Name} has captured <<o:{Player.Name}>> first Seal"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@NOTIFY_SEAL_CAPTURED@YOU"
msgstr "You have captured a Seal"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@NOTIFY_SEAL_LOST@OTHER"
msgstr "{Player.Name} has lost a Seal"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@NOTIFY_SEAL_LOST@YOU"
msgstr "You lost a Seal"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@NOTIFY_VICTORY_IMMINENT@OTHER"
msgstr "{Player.Name} will currently achieve Seals Victory in {Turns} turns"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@NOTIFY_VICTORY_IMMINENT@UNMET"
msgstr "An unmet Ruler will currently achieve Seals Victory in {Turns} turns"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@NOTIFY_VICTORY_IMMINENT@YOU"
msgstr "You will currently achieve Seals Victory in {Turns} turns"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@RESULT@ALLIED_VICTORY@TEXT"
msgstr "Your ally {OtherPlayer.Name} has activated the dormant World Seals and gained control of them, banishing all other Godir from this realm. After the resulting cataclysms, the people have no choice but to accept you and {OtherPlayer.Name} as their only Godir for Ages to come."

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@RESULT@DEFEAT"
msgstr "{OtherPlayer.Name} achieved Seals Victory"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@RESULT@VICTORY"
msgstr "Seals"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@RESULT@VICTORY@TEXT"
msgstr "You have activated the dormant World Seals and gained control of them, banishing all other Godir from this realm. After the resulting cataclysms, the people have no choice but to accept you as their sole {OtherPlayer.Title}."

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@SETTING"
msgstr "All Seals Victory notifications"

