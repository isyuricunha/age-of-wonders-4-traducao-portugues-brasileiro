msgstr "Silverdell"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_CRYSTAL@NAME_OVERRIDE@SILVERKNIGHT_2"
msgstr "Argent Weald"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_CRYSTAL@NAME_OVERRIDE@SILVERKNIGHT_3"
msgstr "Knight's Rest"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_CRYSTAL_FOREST@DESCRIPTION"
msgstr "[bulletlist][bullet/]{manabonus} {GLOBAL.ManaConcept.Hyperlink} per {GLOBAL.ConduitConcept.Hyperlink} in {GLOBAL.CityConcept.Hyperlink} {GLOBAL.DomainConcept.Hyperlink}.[bullet/]Adds the {GLOBAL.UNITS.ASTRAL_KEEPER_UNIT.Hyperlink} unit to the {GLOBAL.RequestMilitaryAidConcept.Hyperlink}.[/bulletlist]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_CRYSTAL_FOREST@LORE"
msgstr "Powerful [hyperlink,GLOBAL.AstralFlowsLoreConcept]Astral Currents[/hyperlink] converge at this location. Rather than forming an ordinary Mana Node, these energies have crystallized into a forest of shimmering trees. Intricate branches and deep, meandering root systems suggest an interconnectedness to much in the universe; <<c:{GLOBAL.SoulsLoreConcept.Hyperlink}>>, [hyperlink,GLOBAL.WorldsWithinLoreConcept]Worlds[/hyperlink], even ages. Time and space have no meaning here."

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_CRYSTAL_FOREST@NAME"
msgstr "Crystal Forest"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ENCHANTED_CAVE@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{amount} {GLOBAL.ManaConcept.Hyperlink} per {GLOBAL.QuarryConcept.Hyperlink} in {GLOBAL.CityConcept.Hyperlink} {GLOBAL.DomainConcept.Hyperlink}.[bullet/]Adds the {GLOBAL.UNITS.STORMSCALE_SERPENT.Hyperlink} and {GLOBAL.UNITS.PLAGUE_SERPENT.Hyperlink} units to the {GLOBAL.RequestMilitaryAidConcept.Hyperlink}.[/bulletlist]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ENCHANTED_CAVE@LORE"
msgstr "[lorefontsize][lorefont]An ancient cavern that heralds from the time of this world's creation, during an era when Dragons and Giants molded the very lands into physical form. Within these natural sanctuaries, the first creatures found shelter as the world outside violently settled into place. To this day, the cave itself remains a sanctuary for those that are able to find their way to it.[/lorefont][/lorefontsize]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ENCHANTED_CAVE@NAME"
msgstr "Ancient Cave"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_FORBIDDEN_CRYPT@DESCRIPTION"
msgstr "[bulletlist][bullet/]{manaincome} {GLOBAL.ManaConcept.Hyperlink}, {knowledgeincome} {GLOBAL.KnowledgeConcept.Hyperlink}, and {soulsincome} {GLOBAL.SoulConcept.Hyperlink} (if obtainable) for each {GLOBAL.HeroConcept.Hyperlink} in {GLOBAL.CryptConcept.Hyperlink}.[bullet/]Adds the {GLOBAL.UNITS.CORRUPT_SOUL.Hyperlink} unit to the {GLOBAL.RequestMilitaryAidConcept.Hyperlink}.[/bulletlist]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_FORBIDDEN_CRYPT@LORE"
msgstr "[lorefontsize][lorefont]A sinister necropolis crafted by the ancient Shad'rai. Its tunnels and burial chambers seem to expand, almost as if they are alive and seek to accommodate any new inhabitants throughout the ages. This tomb doesn't merely hunger for the bodies of the dead, it yearns to feast upon their very <<c:{GLOBAL.SoulsLoreConcept.Hyperlink}>>.[/lorefont][/lorefontsize]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_FORBIDDEN_CRYPT@NAME"
msgstr "Lost Tomb"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_FORBIDDEN_TEMPLE@DESCRIPTION"
msgstr "[bulletlist][bullet/]{knowledgebonus} {GLOBAL.KnowledgeConcept.Hyperlink} per {GLOBAL.ResearchPostConcept.Hyperlink} in {GLOBAL.CityConcept.Hyperlink} {GLOBAL.DomainConcept.Hyperlink}.[bullet/]Adds the {GLOBAL.UNITS.BLESSED_SOUL.Hyperlink} unit to the {GLOBAL.RequestMilitaryAidConcept.Hyperlink}.[/bulletlist]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_FORBIDDEN_TEMPLE@LORE"
msgstr "[lorefontsize][lorefont]This hidden temple complex is forgotten by time. Herein did the {GLOBAL.ArchonsLoreConcept.Hyperlink} once worship the {GLOBAL.AllfatherLoreConcept.Hyperlink}. However, the light that aided the masses in connecting with the divine has long since been extinguished. The site's once grand halls now attract cultists and sinister entities seeking to awaken and twist its power.[/lorefont][/lorefontsize]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_FORBIDDEN_TEMPLE@NAME"
msgstr "Secret Temple"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_FORGE@NAME_OVERRIDE@ELEMENTALS_1"
msgstr "Firehearth Foundry"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_FORGE@NAME_OVERRIDE@ELEMENTALS_2"
msgstr "Embersource Furnace"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_FORGE@NAME_OVERRIDE@ELEMENTALS_3"
msgstr "Scorched Forge"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_FORGE@NAME_OVERRIDE@GIANTS_1"
msgstr "Slagsmelter Forge"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_FORGE@NAME_OVERRIDE@GIANTS_2"
msgstr "Giant's Foundry"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_FORGE@NAME_OVERRIDE@GIANTS_3"
msgstr "Roaring Furnace"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_FORGE@NAME_OVERRIDE@THEONE_1"
msgstr "Anvil of Doom"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_FORGE@NAME_OVERRIDE@THEONE_2"
msgstr "Spiritsap Smithy"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_FORGE@NAME_OVERRIDE@THEONE_3"
msgstr "Blackhammer Furnace"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_GOLDEN_ZIGGURAT@DESCRIPTION"
msgstr "[bulletlist][bullet/]{GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> require -{amount}% less {GLOBAL.GoldConcept.Hyperlink} and {GLOBAL.ManaConcept.Hyperlink} base {GLOBAL.UnitUpkeepConcept.Hyperlink} in this {GLOBAL.CityConcept.Hyperlink} {GLOBAL.DomainConcept.Hyperlink}.[bullet/]Adds the {GLOBAL.UNITS.PHOENIX.Hyperlink} unit to the {GLOBAL.RequestMilitaryAidConcept.Hyperlink}.[/bulletlist]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_GOLDEN_ZIGGURAT@LORE"
msgstr "[lorefontsize][lorefont][hyperlink,GLOBAL.ArchonsLoreConcept]The Archon civilization[/hyperlink] raised these monolithic structures at great cost. Scholars speculate they were once utilized as portals to other [hyperlink,GLOBAL.WorldsWithinLoreConcept]Worlds[/hyperlink]. However, with the ziggurat's original builders now long gone, those with opportunistic and potentially sinister motives come to try and unravel its forgotten powers.[/lorefont][/lorefontsize]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_GOLDEN_ZIGGURAT@NAME"
msgstr "Golden Ziggurat"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_GOLDEN_ZIGGURAT@UNIT_PROPERTY"
