msgid "DLC@WAYSOFWAR@TOME_SHADES@SKILL5@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{amount} {GLOBAL.KnowledgeConcept.Hyperlink} income.[bullet/]+{amount2} {GLOBAL.KnowledgeConcept.Hyperlink} for each non-owned city that shares a border with this {GLOBAL.CityConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@WAYSOFWAR@TOME_SHADES@SKILL5@NAME"
msgstr "Shade Network"

msgid "DLC@WAYSOFWAR@TOME_SHADES@SMUGGLING_OPERATION@DESCRIPTION"
