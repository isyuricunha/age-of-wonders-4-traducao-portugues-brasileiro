msgstr "{INT_numCasusBelli}[casusBelli/] <<m:{GLOBAL.CasusBelliConcept.Hyperlink}>> removed!"

msgid "DIPLOMACY@ENTERCLAIMED@CONFIRMATION_DESCRIPTION"
msgstr "This [hyperlink,GLOBAL.ProvinceConcept]Province[/hyperlink] has already been [hyperlink,GLOBAL.ClaimConcept]claimed[/hyperlink]. Capturing it causes other [hyperlink,GLOBAL.LeaderConcept]Rulers[/hyperlink] to gain a {GLOBAL.CasusBelliConcept.Hyperlink} ({CasusBelliValue}[casusBelli/] or {DistantCasusBelliValue}[casusBelli/] for distant claims) against you, making it easier for them to declare {GLOBAL.WarConcept.Hyperlink} on you. [minorCity/] [hyperlink,GLOBAL.IndependentCityConcept]Free Cities[/hyperlink] will receive a relations penalty for ignoring their [hyperlink,GLOBAL.ClaimConcept]claims[/hyperlink].[br/][br/]The following [hyperlink,GLOBAL.LeaderConcept]Rulers[/hyperlink] and [minorCity/] [hyperlink,GLOBAL.IndependentCityConcept]Free Cities[/hyperlink] have [hyperlink,GLOBAL.ClaimConcept]claimed[/hyperlink] this [hyperlink,GLOBAL.ProvinceConcept]province[/hyperlink]:"

msgid "DIPLOMACY@ENTERCLAIMED@CONFIRMATION_DESCRIPTION_POST"
msgstr "Are you sure you want to enter this structure?"

msgid "DIPLOMACY@ENTERCLAIMED@CONFIRMATION_TITLE"
msgstr "Do you want to enter this claimed structure?"

msgid "DIPLOMACY@FABRICATED@NAME"
msgstr "Fabricated"

msgid "DIPLOMACY@FIRSTMEET@NEGATIVE"
msgstr "Give threatening welcome [badRelation/]"

msgid "DIPLOMACY@FIRSTMEET@NEGATIVE_TOOLTIP"
msgstr "Insult the other {GLOBAL.LeaderConcept.Hyperlink} — who needs them anyway?! Your [hyperlink,GLOBAL.EmpireRelationConcept]relations[/hyperlink] with them will suffer {INT_value}[badRelation/] and they may eventually be lured into {GLOBAL.WarConcept.Hyperlink}."

msgid "DIPLOMACY@FIRSTMEET@NEUTRAL"
msgstr "Start negotiating"

msgid "DIPLOMACY@FIRSTMEET@POSITIVE"
msgstr "Send welcome gift {Cost}"

msgid "DIPLOMACY@FIRSTMEET@POSITIVE_TOOLTIP"
msgstr "Greet the other {GLOBAL.LeaderConcept.Hyperlink} with a gift. They might make a formidable [hyperlink,GLOBAL.DSAllianceConcept]ally[/hyperlink] in the future. You gift {Cost} and your [hyperlink,GLOBAL.EmpireRelationConcept]relations[/hyperlink] with this Ruler improve by {Relation}[goodRelation/]."

msgid "DIPLOMACY@FIRSTMEET@SHOW_LOCATION"
msgstr "Show first contact location"

msgid "DIPLOMACY@HOSTAGE_ALLEGIANCE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.HostageAllegianceConcept]Hostage Allegiance[/hyperlink]"

msgid "DIPLOMACY@HOSTILEACTION@FIXED_HEADER"
msgstr "Cannot Perform Hostile Action"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@COOPERATION"
msgstr "Pact of Cooperation"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@COOPERATION_DESCRIPTION"
msgstr "[bulletlist][bullet/]The {GLOBAL.IndependentCityConcept.Hyperlink} opens its borders.[bullet/][hyperlink,GLOBAL.IndependentCityTradeConcept]Trading[/hyperlink] is enabled.[bulletlist][bullet/]Up to two resource trades are available.[bullet/]<<m:{GLOBAL.MagicMaterialConcept.Hyperlink}>> can be traded.[/bulletlist][/bulletlist]"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@COOPERATION_HYPERLINK"
msgstr "[rs_cooperation/] [hyperlink,GLOBAL.PactOfCooperationConcept]Pact of Cooperation[/hyperlink]"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@HOUSE_DECLARE_WAR"
msgstr "A {GLOBAL.IndependentCityConcept.Name} declared war on you"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@HOUSE_DECLARE_WAR_FROM_VASSALAGE"
msgstr "Your vassal has been taken from you"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@INTEGRATION"
msgstr "Pact of Integration"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@INTEGRATION_BUTTON"
msgstr "Integrate City"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@INTEGRATION_DESCRIPTION"
msgstr "[bulletlist][bullet/]City ownership is given to the {GLOBAL.EmpireConcept.Hyperlink} forging this pact.[bullet/]Ceases to exist as a diplomatic entity.[bullet/]The {GLOBAL.FreeCityLordConcept.Hyperlink} can be recruited as a {GLOBAL.HeroConcept.Hyperlink} of the {GLOBAL.EmpireConcept.Hyperlink} forging this pact.[bullet/]Any <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> will be released.[/bulletlist]"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@INTEGRATION_HYPERLINK"
msgstr "[rs_intergration/] [hyperlink,GLOBAL.PactOfIntegrationConcept]Pact of Integration[/hyperlink]"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@LOYALTY"
msgstr "Pact of Loyalty"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@LOYALTY_DESCRIPTION"
msgstr "[bulletlist][bullet/]The {GLOBAL.IndependentCityConcept.Hyperlink} shares its vision.[bullet/]The {GLOBAL.IndependentCityConcept.Hyperlink} allows building on claimed provinces.[bullet/]Contributes {commandPoints}[recruitmentPoints/] to the {GLOBAL.RequestMilitaryAidConcept.Hyperlink}.[bullet/]Will [hyperlink,GLOBAL.ReinforcementRuleConcept]reinforce[/hyperlink] in {GLOBAL.CombatConcept.Hyperlink} against <<m:{GLOBAL.MarauderConcept.Hyperlink}>> and <<m:{GLOBAL.LeaderConcept.Hyperlink}>> the {GLOBAL.IndependentCityConcept.Hyperlink} is at {GLOBAL.IndependentCityWarConcept.Hyperlink} with.[/bulletlist]"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@LOYALTY_HYPERLINK"
msgstr "[rs_loyalty/] [hyperlink,GLOBAL.PactOfLoyaltyConcept]Pact of Loyalty[/hyperlink]"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@NEGOTIATION_IN_PROGRESS"
msgstr "{STR_stateName} in {INT_turns}[turn/]."

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@NEGOTIATION_IN_PROGRESS_SHORT"
msgstr "{STR_stateTML} in {INT_turns}[turn/]"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@NEUTRAL"
msgstr "Neutral"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@NEUTRAL_BUTTON"
msgstr "Make Peace"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@NEUTRAL_BUTTON_DESCRIPTION"
msgstr "Make [rs_neutral/] [hyperlink,GLOBAL.DSNeutralConcept]Peace[/hyperlink] with the {GLOBAL.IndependentCityConcept.Hyperlink} to resume [hyperlink,GLOBAL.NegotiationConcept]negotiations[/hyperlink]"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@NEUTRAL_DESCRIPTION"
msgstr "The default {GLOBAL.PvEDiplStateConcept.Hyperlink}. The {GLOBAL.IndependentCityConcept.Hyperlink} and the {GLOBAL.EmpireConcept.Hyperlink} have not yet [hyperlink,GLOBAL.NegotiationConcept]negotiated[/hyperlink] any better terms. This can be done using a {GLOBAL.DiplomaticTokenConcept.Hyperlink}."

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@VASSALAGE"
msgstr "Pact of Vassalage"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@VASSALAGE_DESCRIPTION"
msgstr "[bulletlist][bullet/]The {GLOBAL.IndependentCityConcept.Hyperlink} shares its income and <<m:{GLOBAL.MagicMaterialConcept.Hyperlink}>>.[bullet/]Other <<m:{GLOBAL.EmpireConcept.Hyperlink}>> may no longer [hyperlink,GLOBAL.NegotiationConcept]negotiate[/hyperlink] better <<m:{GLOBAL.PvEDiplStateConcept.Hyperlink}>> with the {GLOBAL.IndependentCityConcept.Hyperlink}.[bullet/]The{GLOBAL.IndependentCityConcept.Hyperlink} will join its overlord in any <<m:{GLOBAL.WarConcept.Hyperlink}>> they are fighting, can assist in combat, and can be given directives in War Coordination.[bullet/]Switches to the {GLOBAL.VassalagePhaseConcept.Hyperlink}, during which further {GLOBAL.HouseInfluenceConcept.Hyperlink} can be earned to improve the benefits of vassalage. Eventually the {GLOBAL.IndependentCityConcept.Hyperlink} may be [hyperlink,GLOBAL.PactOfIntegrationConcept]integrated[/hyperlink] into the empire of its overlord.[/bulletlist]"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@VASSALAGE_HYPERLINK"
msgstr "[rs_vassalage/] [hyperlink,GLOBAL.PactOfVassalageConcept]Pact of Vassalage[/hyperlink]"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@VASSALAGE_LEVEL_-1"
msgstr "Tributary"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@VASSALAGE_LEVEL_-1_DESCRIPTION"
msgstr "[bulletlist][bullet/]The {GLOBAL.IndependentCityConcept.Hyperlink} shares {incomePercentage}% of its income.[bullet/]Shares all of its <<m:{GLOBAL.MagicMaterialConcept.Hyperlink}>>.[bullet/]Contributes {commandPoints}[recruitmentPoints/] to the {GLOBAL.RequestMilitaryAidConcept.Hyperlink}.[bullet/][hyperlink,GLOBAL.IndependentCityTradeConcept]Trading[/hyperlink] costs increase by {tradingCost}%.[bullet/]War Coordination is disabled and no new armies will be sent out.[/bulletlist]"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@VASSALAGE_LEVEL_-1_HYPERLINK"
msgstr "[rs_vassalage-1/] [hyperlink,GLOBAL.PactOfVassalageLvl-1Concept]Tributary[/hyperlink]"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@VASSALAGE_LEVEL_-2"
msgstr "Minor Tributary"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@VASSALAGE_LEVEL_-2_DESCRIPTION"
msgstr "[bulletlist][bullet/]The {GLOBAL.IndependentCityConcept.Hyperlink} shares {incomePercentage}% of its income.[bullet/]Shares all of its <<m:{GLOBAL.MagicMaterialConcept.Hyperlink}>>.[bullet/]Contributes {commandPoints}[recruitmentPoints/] to the {GLOBAL.RequestMilitaryAidConcept.Hyperlink}.[bullet/][hyperlink,GLOBAL.IndependentCityTradeConcept]Trading[/hyperlink] costs increase by {tradingCost}%.[/bulletlist]"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@VASSALAGE_LEVEL_-2_HYPERLINK"
msgstr "[rs_vassalage-2/] [hyperlink,GLOBAL.PactOfVassalageLvl-2Concept]Minor Tributary[/hyperlink]"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@VASSALAGE_LEVEL_-3"
msgstr "Denying Tributary"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@VASSALAGE_LEVEL_-3_DESCRIPTION"
msgstr "[bulletlist][bullet/]The {GLOBAL.IndependentCityConcept.Hyperlink} shares none of its income.[bullet/]Shares none of its <<m:{GLOBAL.MagicMaterialConcept.Hyperlink}>>.[bullet/]Contributes nothing to the Rally of the Lieges.[bullet/][hyperlink,GLOBAL.IndependentCityTradeConcept]Trading[/hyperlink] costs increase by {tradingCost}%.[/bulletlist]"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@VASSALAGE_LEVEL_-3_HYPERLINK"
msgstr "[rs_vassalage-3/] [hyperlink,GLOBAL.PactOfVassalageLvl-3Concept]Denying Tributary[/hyperlink]"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@VASSALAGE_LEVEL_0"
msgstr "Vassalage"

msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@VASSALAGE_LEVEL_0_DESCRIPTION"
