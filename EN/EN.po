msgid "DLC@EMPIRESANDASHES@WILDLIFE_PROPERTIES@SCRAP_HERMIT@ABILITY01@DESCRIPTION"
msgstr "Units in a {ACID_SPRAY_CONE_TARGETER>AREA>Length}-hex cone:[bulletlist][bullet/]Sustain damage.[bullet/]Gain {amount} {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@WILDLIFE_PROPERTIES@SCRAP_HERMIT@ABILITY01@NAME"
msgstr "Acid Spray"

msgid "DLC@EMPIRESANDASHES@WILDLIFE_PROPERTIES@SCRAP_HERMIT@ABILITY02@DESCRIPTION"
msgstr "On hit, this unit gains {GATHER_METAL_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> and has a {GATHER_METAL_RESISTANCE_CHECK>ResolvedStrength}% chance of gaining {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink}."

msgid "DLC@EMPIRESANDASHES@WILDLIFE_PROPERTIES@SCRAP_HERMIT@ABILITY02@NAME"
msgstr "Gather Metal"

msgid "DLC@EMPIRESANDASHES@WORLD_TRAIT@SEALS_VICTORY@ACTIVE@DESCRIPTION"
