msgid "DIPLOMACY@CALLTOARMS@STATUS_RUNNING"
msgstr "Busy"

msgid "DIPLOMACY@CALLTOARMS@TIMER_FROZEN"
msgstr "Timer paused"

msgid "DIPLOMACY@CALLTOARMS@TIMER_FROZEN_DESCRIPTION"
msgstr "While the Bounty target is being [hyperlink,GLOBAL.SiegeConcept]sieged[/hyperlink] or an operation is active, the timer will pause. The timer will also not run out if an AI Ruler is actively attempting the bounty."

msgid "DIPLOMACY@CALLTOARMS@TITLE"
msgstr "Bounty"

msgid "DIPLOMACY@CALLTOARMS@VIABILITYREASON_ALLIED"
msgstr "{RequestedPlayer.Lord.FirstName} is allied with the target."

msgid "DIPLOMACY@CALLTOARMS@VIABILITYREASON_DUPLICATE"
msgstr "{RequestedPlayer.Lord.FirstName} already has a bounty on the target."

msgid "DIPLOMACY@CALLTOARMS@VIABILITYREASON_NOMADBLOCKED"
msgstr "Unable to target Nomad cities"

msgid "DIPLOMACY@CALLTOARMS@VIABILITYREASON_NOTATWAR"
msgstr "{RequestedPlayer.Lord.FirstName} is not at war with the target."

msgid "DIPLOMACY@CALLTOARMS@VIABILITYREASON_NOTEXPLORED"
msgstr "{RequestedPlayer.Lord.FirstName} has not explored the target."

msgid "DIPLOMACY@CALLTOARMS@VIABILITYREASON_PERSONALITY"
msgstr "{RequestedPlayer.Lord.FirstName} will not accept because of their personality ({RequestedPlayer.Personality})"

msgid "DIPLOMACY@CALLTOARMS@VIABILITYREASON_SUCCESS"
msgstr "{RequestedPlayer.Lord.FirstName} can accept the Bounty."

msgid "DIPLOMACY@CALLTOARMS@VIABILITYREASON_TOOFAR"
msgstr "The target is too far away for {RequestedPlayer.Lord.FirstName}."

msgid "DIPLOMACY@CALLTOARMS@VIABILITYREASON_TOOMUCHRISK"
msgstr "Attacking poses too much risk for {RequestedPlayer.Lord.FirstName}."

msgid "DIPLOMACY@CALLTOARMS@VIABILITYREASON_TOOSTRONG"
msgstr "The target is too well defended for {RequestedPlayer.Lord.FirstName}."

msgid "DIPLOMACY@CALLTOARMS@VIABILITY_BAD"
msgstr "Poor"

msgid "DIPLOMACY@CALLTOARMS@VIABILITY_BAD_RESPONSE"
msgstr "[hyperlink,RequestedPlayer]{RequestedPlayer.Lord.FirstName}[/hyperlink] is doubtful about being able to complete this bounty."

msgid "DIPLOMACY@CALLTOARMS@VIABILITY_BEST"
msgstr "Excellent"

msgid "DIPLOMACY@CALLTOARMS@VIABILITY_BEST_RESPONSE"
msgstr "[hyperlink,RequestedPlayer]{RequestedPlayer.Lord.FirstName}[/hyperlink] is certain <<p:{RequestedPlayer.Lord.Name}>> can complete the bounty."

msgid "DIPLOMACY@CALLTOARMS@VIABILITY_IMPOSSIBLE"
msgstr "Impossible"

msgid "DIPLOMACY@CALLTOARMS@VIABILITY_IMPOSSIBLE_RESPONSE"
msgstr "[hyperlink,RequestedPlayer]{RequestedPlayer.Lord.FirstName}[/hyperlink] cannot complete this bounty."

msgid "DIPLOMACY@CALLTOARMS@VIABILITY_NORMAL"
msgstr "Good"

msgid "DIPLOMACY@CALLTOARMS@VIABILITY_NORMAL_RESPONSE"
msgstr "[hyperlink,RequestedPlayer]{RequestedPlayer.Lord.FirstName}[/hyperlink] thinks <<p:{RequestedPlayer.Lord.Name}>> can maybe complete the bounty."

msgid "DIPLOMACY@CALLTOWAR@BUTTON_AGAINST"
msgstr "Call a Ruler into war against {Target.Lord.FirstName}"

msgid "DIPLOMACY@CALLTOWAR@BUTTON_AGAINST_TOOLTIP"
msgstr "Call a {GLOBAL.LeaderConcept.Hyperlink} into your war against {Target.Lord.FirstName}. If they accept, they will receive a {GLOBAL.CasusBelliConcept.Hyperlink} against {Target.Name} to justify their cause. This will be equal to your own Grievance + {CBBonus}[casusBelli/]."

msgid "DIPLOMACY@CALLTOWAR@BUTTON_ANSWER"
msgstr "Answer Call to War from {Player.Lord.FirstName}"

msgid "DIPLOMACY@CALLTOWAR@BUTTON_ANSWER_AGAINST"
msgstr "Answer Call to War against {Target.Lord.FirstName}"

msgid "DIPLOMACY@CALLTOWAR@BUTTON_ANSWER_TOOLTIP"
msgstr "Answer Call to War from {Player.Name} against {Target.Name}. Accepting their call will give you additional <<m:{GLOBAL.CasusBelliConcept.Hyperlink}>>, while declining will damage your relations."

msgid "DIPLOMACY@CALLTOWAR@BUTTON_INTO"
msgstr "Call {Player.Lord.FirstName} to War"

msgid "DIPLOMACY@CALLTOWAR@BUTTON_INTO_TOOLTIP"
msgstr "Send a request to {Player.Lord.FirstName} to join you in a war you are fighting. If <<p:{Player.Name}>> accepts, <<p:{Player.Name}>> will receive a {GLOBAL.CasusBelliConcept.Hyperlink} against the target {GLOBAL.LeaderConcept.Hyperlink} to justify <<o:{Player.Name}>> cause. This will be equal to your own Grievance + {CBBonus}[casusBelli/]."

msgid "DIPLOMACY@CALLTOWAR@CONFIRMATION"
msgstr "{Player.Name} will respond to your call within {Turns}[turn/]. <<Cp:{Player.Name}>> will receive {CBTotal}[casusBelli/] if <<p:{Player.Name}>> accepts and joins you in your war against {Target.Name}. However, you will gain {CBPenalty}[casusBelli/] on {Player.Lord.FirstName} if <<p:{Player.Name}>> declines your call."

msgid "DIPLOMACY@CALLTOWAR@DESCRIPTION"
msgstr "<<m:{GLOBAL.LeaderConcept.Hyperlink}>> may call each other into {GLOBAL.WarConcept.Hyperlink} with a Ruler who they themselves are already at war with.[br/][br/]The Rulers must share at least a {GLOBAL.MutualConsulateConcept.Hyperlink} to send a call to war. The receiving Ruler may choose to accept or decline the call. Accepting gives them a {GLOBAL.CasusBelliConcept.Hyperlink} bonus, whereas declining will result in considerable [hyperlink,GLOBAL.EmpireRelationConcept]relations[/hyperlink] penalties."

msgid "DIPLOMACY@CALLTOWAR@HYPERLINK"
msgstr "[hyperlink,GLOBAL.CallToWarConcept]Call to War[/hyperlink]"

msgid "DIPLOMACY@CALLTOWAR@ITEM"
msgstr "Call {Player.Lord.FirstName} to war against {Target.Lord.FirstName}"

msgid "DIPLOMACY@CALLTOWAR@ITEM_ANSWER"
msgstr "Answer call to war from {Player.Lord.FirstName} against {Target.Lord.FirstName}"

msgid "DIPLOMACY@CALLTOWAR@ITEM_TOOLTIP"
msgstr "Call {Player.Name} into your war against {Target.Name}. They will receive {CBTotal}[casusBelli/] against {Target.Name} to justify their cause."

msgid "DIPLOMACY@CALLTOWAR@ITEM_TOOLTIP_FAIL_COOLDOWN"
msgstr "{Player.Lord.FirstName} recently declined your call to war and cannot be called to war again for {Cooldown}<<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DIPLOMACY@CALLTOWAR@ITEM_TOOLTIP_FAIL_COOLDOWNWAR"
msgstr "{Player.Lord.FirstName} and {Target.Lord.FirstName} were recently in a war and cannot be called to war against each other. Wait {Cooldown}<<m:{GLOBAL.TurnConcept.Hyperlink}>> to make a call to war."

msgid "DIPLOMACY@CALLTOWAR@ITEM_TOOLTIP_FAIL_TRUCE"
msgstr "{Player.Lord.FirstName} and {Target.Lord.FirstName} share a {GLOBAL.TruceConcept.Hyperlink} and cannot be called to war against each other. The truce still lasts {Cooldown}<<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DIPLOMACY@CALLTOWAR@TITLE"
msgstr "Call to war"

msgid "DIPLOMACY@CANTBREAKTREATY@TITLE"
msgstr "Treaties last indefinitely but can be broken manually or by declaring {GLOBAL.WarConcept.Hyperlink}. Some diplomatic treaties rely on a specific diplomatic state or another treaty. When a treaty ends, any other treaty made in the same trade deal also expires."

msgid "DIPLOMACY@CASUSBELLI@AGAINST_OTHER_SHORT"
msgstr "Your <<m:{GLOBAL.CasusBelliConcept}>>:"

msgid "DIPLOMACY@CASUSBELLI@AGAINST_YOU_SHORT"
msgstr "Their <<m:{GLOBAL.CasusBelliConcept}>>:"

msgid "DIPLOMACY@CASUSBELLI@CANT_AFFORD_OTHER"
msgstr "They cannot afford to pay off this {GLOBAL.CasusBelliConcept.Hyperlink}!"

msgid "DIPLOMACY@CASUSBELLI@CANT_AFFORD_SELF"
msgstr "You cannot afford to pay off this {GLOBAL.CasusBelliConcept.Hyperlink}!"

msgid "DIPLOMACY@CASUSBELLI@CANT_TRADE"
msgstr "This {GLOBAL.CasusBelliConcept.Hyperlink} cannot be traded."

msgid "DIPLOMACY@CASUSBELLI@COOLDOWN"
msgstr "It is too soon for them to buy another {GLOBAL.CasusBelliConcept.Hyperlink}, try in {Cooldown}<<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DIPLOMACY@CASUSBELLI@COOLDOWN_SELL"
msgstr "It is too soon for them to sell another {GLOBAL.CasusBelliConcept.Hyperlink}. Try in {Cooldown}<<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DIPLOMACY@CASUSBELLI@DESCRIPTION"
msgstr "[casusBelli/] Grievances determine your {GLOBAL.WarJustificationConcept.Hyperlink} against other <<m:{GLOBAL.LeaderConcept.Hyperlink}>>. They are your reason for going to war.[br/][br/]Obtained primarily by:[bulletlist][bullet/]Seeing a trespasser.[bullet/]Having another Ruler build on a {GLOBAL.ProvinceConcept.Hyperlink} you've claimed.[bullet/][hyperlink,GLOBAL.FabricatedCasusBelliConcept]Fabricating a [casusBelli/] Grievance[/hyperlink].[bullet/]Being attacked.[/bulletlist][br/][br/][casusBelli/] Grievances can be exchanged for <<m:{GLOBAL.ResourceConcept.Hyperlink}>> with the Ruler they're held against."

msgid "DIPLOMACY@CASUSBELLI@DESCRIPTION_LEVEL_-1"
msgstr "A war would be unjustified and so our alignment and relations with other Rulers and cities will suffer deeply."

msgid "DIPLOMACY@CASUSBELLI@DESCRIPTION_LEVEL_0"
msgstr "Starting a war with no justification will damage our alignment and relations with other Rulers and cities."

msgid "DIPLOMACY@CASUSBELLI@DESCRIPTION_LEVEL_1"
msgstr "War is possible, but our alignment and relations would still suffer."

msgid "DIPLOMACY@CASUSBELLI@DESCRIPTION_LEVEL_2"
msgstr "Our vassal cities will support our war, but other parties maintain a neutral stance."

msgid "DIPLOMACY@CASUSBELLI@DESCRIPTION_LEVEL_3"
msgstr "The people demand war! Our vassals and other Rulers will support our decision."

msgid "DIPLOMACY@CASUSBELLI@HYPERLINK"
msgstr "[casusBelli/] [hyperlink,GLOBAL.CasusBelliConcept]Grievance[/hyperlink]"

msgid "DIPLOMACY@CASUSBELLI@MINUS_RIVAL_JUSTIFICATION_OTHER"
msgstr "Minus our {GLOBAL.RivalJustificationConcept.Hyperlink}"

msgid "DIPLOMACY@CASUSBELLI@MINUS_RIVAL_JUSTIFICATION_SELF"
msgstr "Minus their {GLOBAL.RivalJustificationConcept.Hyperlink}"

msgid "DIPLOMACY@CASUSBELLI@RIVAL_JUSTIFICATION"
msgstr "Rival Justification"

msgid "DIPLOMACY@CASUSBELLI@RIVAL_JUSTIFICATION_DESCRIPTION"
msgstr "Rival justification is a one-sided {GLOBAL.WarJustificationConcept.Hyperlink} that allows you to ignore the opponent's {GLOBAL.CasusBelliConcept.Hyperlink} points up to the same amount as your Rival Justification when declaring {GLOBAL.WarConcept.Hyperlink} on them.[br/]The opposing {GLOBAL.LeaderConcept.Hyperlink} is not affected by your Rival Justification when they declare war on you, nor are you affected by their Rival Justification."

msgid "DIPLOMACY@CASUSBELLI@RIVAL_JUSTIFICATION_HYPERLINK"
msgstr "[hyperlink,GLOBAL.RivalJustificationConcept]Rival Justification[/hyperlink]"

msgid "DIPLOMACY@CASUSBELLI@TITLE"
msgstr "[casusBelli/] Grievance"

msgid "DIPLOMACY@CASUSBELLI@TITLE_LEVEL_0"
msgstr "None"

msgid "DIPLOMACY@CASUSBELLI@TITLE_LEVEL_1"
msgstr "Minor"

msgid "DIPLOMACY@CASUSBELLI@TITLE_LEVEL_2"
msgstr "Moderate"

msgid "DIPLOMACY@CASUSBELLI@TITLE_LEVEL_3"
msgstr "Major"

msgid "DIPLOMACY@CASUSBELLI@TITLE_LEVEL_N1"
msgstr "Unjust"

msgid "DIPLOMACY@CASUSBELLI@TITLE_LEVEL_N2"
msgstr "Very unjust"

msgid "DIPLOMACY@CASUSBELLI@TITLE_LEVEL_N3"
msgstr "Completely unjust"

msgid "DIPLOMACY@CASUSBELLI@TRADE_BUY"
msgstr "Pay for your transgression"

msgid "DIPLOMACY@CASUSBELLI@TRADE_DESCRIPTION_OTHER"
msgstr "Do you want to pay off this {GLOBAL.CasusBelliConcept.Name}?"

msgid "DIPLOMACY@CASUSBELLI@TRADE_DESCRIPTION_SELF"
msgstr "Do you want to sell this {GLOBAL.CasusBelliConcept.Name}?"

msgid "DIPLOMACY@CASUSBELLI@TRADE_FORGIVE"
msgstr "Forgive transgression"

msgid "DIPLOMACY@CASUSBELLI@TRADE_FORGIVE_FABRICATED"
msgstr "Cannot forgive a Fabricated {GLOBAL.CasusBelliConcept.Hyperlink}."

msgid "DIPLOMACY@CASUSBELLI@TRADE_FORGIVE_TOOLTIP"
msgstr "Forgiving the opposing Ruler for their transgression will remove the {GLOBAL.CasusBelliConcept.Hyperlink}. This counts as an act of good [goodact/] and will also give a relations bonus."

msgid "DIPLOMACY@CASUSBELLI@TRADE_SELL"
msgstr "Sell Grievance"

msgid "DIPLOMACY@CASUSBELLI@TRADE_TOOLTIP"
msgstr "The {GLOBAL.CasusBelliConcept.Hyperlink} and its effects on your relations will be removed for the given price."

msgid "DIPLOMACY@CASUSBELLI@USAGEBLOCKED"
msgstr "[fireCol]Due to ongoing effects, you cannot currently make use of your <<m:{GLOBAL.CasusBelliConcept.Hyperlink}>>.[/fireCol]"

msgid "DIPLOMACY@CASUSBELLI@WAR_JUSTIFICATION"
msgstr "War Justification"

msgid "DIPLOMACY@CASUSBELLI@WAR_JUSTIFICATION_DESCRIPTION"
msgstr "War Justification is the balance of <<m:{GLOBAL.CasusBelliConcept}>> between two <<m:{GLOBAL.LeaderConcept.Hyperlink}>> and is used to determine the impact of declaring {GLOBAL.WarConcept.Hyperlink}.[br/][br/]When starting a {GLOBAL.WarConcept.Hyperlink}:[bulletlist][bullet/]{GLOBAL.AlignmentConcept.Hyperlink} may be affected.[bullet/]{GLOBAL.ImperiumConcept.Hyperlink} income may be affected.[bullet/]Non-allied rulers can receive <<m:{GLOBAL.CasusBelliConcept}>>.[bullet/]{GLOBAL.EmpireRelationConcept.Hyperlink} with other Rulers as well as [hyperlink,GLOBAL.IndependentCityRelationConcept]relations[/hyperlink] with ([hyperlink,GLOBAL.PactOfVassalageConcept]Vassal[/hyperlink])[hyperlink,GLOBAL.IndependentCityConcept]Cities[/hyperlink] may be affected.[/bulletlist][br/][br/]The following War Justification levels can be reached:[bulletlist][bullet/]{GLOBAL.WarJustificationLvl3Concept.Hyperlink} ({LVL3Min}+[casusBelli/])[bullet/]{GLOBAL.WarJustificationLvl2Concept.Hyperlink} ({LVL2Max}[casusBelli/] to {LVL2Min}[casusBelli/])[bullet/]{GLOBAL.WarJustificationLvl1Concept.Hyperlink} ({LVL1Max}[casusBelli/] to {LVL1Min}[casusBelli/])[bullet/]{GLOBAL.WarJustificationLvl0Concept.Hyperlink} ({LVL0Min}[casusBelli/])[bullet/]{GLOBAL.WarJustificationLvlN1Concept.Hyperlink} ({LVL-1Max}[casusBelli/] to {LVL-1Min}[casusBelli/])[bullet/]{GLOBAL.WarJustificationLvlN2Concept.Hyperlink} ({LVL-2Max}[casusBelli/] to {LVL-2Min}[casusBelli/])[bullet/]{GLOBAL.WarJustificationLvlN3Concept.Hyperlink} ({LVL-3Min}[casusBelli/])[/bulletlist]"

msgid "DIPLOMACY@CASUSBELLI@WAR_JUSTIFICATION_HYPERLINK"
msgstr "[hyperlink,GLOBAL.WarJustificationConcept]War Justification[/hyperlink]"

msgid "DIPLOMACY@CASUSBELLI@WAR_JUSTIFICATION_INCOMEEFFECTEXPLANATION"
msgstr "When you are involved in multiple wars which you declared, only the income effect of the war with the worst War Justification will be applied."

msgid "DIPLOMACY@CASUSBELLI@WAR_JUSTIFICATION_LEVEL_0_DESCRIPTION"
msgstr "With no {GLOBAL.WarJustificationConcept} (0[casusBelli/]), declaring {GLOBAL.WarConcept.Hyperlink} becomes more damaging to your {GLOBAL.EmpireConcept.Hyperlink}.[br/][br/]Unjustified wars are considered an [evilact/] [hyperlink,GLOBAL.AlignmentConcept]evil[/hyperlink] act, affect all of your relations negatively, and impact your {ResourcePenalty} income by {ResourcePenaltyValue} while the war lasts. {LOC.DIPLOMACY@CASUSBELLI@WAR_JUSTIFICATION_INCOMEEFFECTEXPLANATION}"

msgid "DIPLOMACY@CASUSBELLI@WAR_JUSTIFICATION_LEVEL_0_HYPERLINK"
msgstr "[hyperlink,GLOBAL.WarJustificationLvl0Concept]None[/hyperlink]"

msgid "DIPLOMACY@CASUSBELLI@WAR_JUSTIFICATION_LEVEL_0_TITLE"
msgstr "War Justification: None"

msgid "DIPLOMACY@CASUSBELLI@WAR_JUSTIFICATION_LEVEL_1_DESCRIPTION"
msgstr "Having only minor {GLOBAL.WarJustificationConcept} ({Max}[casusBelli/] to {Min}[casusBelli/]), means that declaring {GLOBAL.WarConcept.Hyperlink} is justified but still frowned upon by other <<m:{GLOBAL.LeaderConcept.Hyperlink}>>.[br/][br/]Wars are still considered an [evilact/] [hyperlink,GLOBAL.AlignmentConcept]evil[/hyperlink] act and your {GLOBAL.EmpireRelationConcept.Hyperlink} with other Rulers will suffer a penalty."

msgid "DIPLOMACY@CASUSBELLI@WAR_JUSTIFICATION_LEVEL_1_HYPERLINK"
msgstr "[hyperlink,GLOBAL.WarJustificationLvl1Concept]Minor[/hyperlink]"

msgid "DIPLOMACY@CASUSBELLI@WAR_JUSTIFICATION_LEVEL_1_TITLE"
msgstr "War Justification: Minor"

msgid "DIPLOMACY@CASUSBELLI@WAR_JUSTIFICATION_LEVEL_2_DESCRIPTION"
msgstr "With Moderate {GLOBAL.WarJustificationConcept} ({Max}[casusBelli/] to {Min}[casusBelli/]), declaring {GLOBAL.WarConcept.Hyperlink} is now supported by your [hyperlink,GLOBAL.PactOfVassalageConcept]Vassal[/hyperlink] [hyperlink,GLOBAL.IndependentCityConcept]Cities[/hyperlink] as they gain a [hyperlink,GLOBAL.IndependentCityRelationConcept]Relations[/hyperlink] bonus, and your {ResourceBonus} income increases by {ResourceBonusValue} while the war lasts. {LOC.DIPLOMACY@CASUSBELLI@WAR_JUSTIFICATION_INCOMEEFFECTEXPLANATION}"

msgid "DIPLOMACY@CASUSBELLI@WAR_JUSTIFICATION_LEVEL_2_HYPERLINK"
msgstr "[hyperlink,GLOBAL.WarJustificationLvl2Concept]Moderate[/hyperlink]"

msgid "DIPLOMACY@CASUSBELLI@WAR_JUSTIFICATION_LEVEL_2_TITLE"
msgstr "War Justification: Moderate"

msgid "DIPLOMACY@CASUSBELLI@WAR_JUSTIFICATION_LEVEL_3_DESCRIPTION"
msgstr "With Major {GLOBAL.WarJustificationConcept} ({Max}+[casusBelli/]), declaring {GLOBAL.WarConcept.Hyperlink} is fully justified. Your [hyperlink,GLOBAL.PactOfVassalageConcept]Vassal[/hyperlink] [hyperlink,GLOBAL.IndependentCityConcept]Cities[/hyperlink] gain a [hyperlink,GLOBAL.IndependentCityRelationConcept]Relations[/hyperlink] bonus, and your {ResourceBonus} income increases by {ResourceBonusValue} while the war lasts. {LOC.DIPLOMACY@CASUSBELLI@WAR_JUSTIFICATION_INCOMEEFFECTEXPLANATION}"

msgid "DIPLOMACY@CASUSBELLI@WAR_JUSTIFICATION_LEVEL_3_HYPERLINK"
msgstr "[hyperlink,GLOBAL.WarJustificationLvl3Concept]Major[/hyperlink]"

msgid "DIPLOMACY@CASUSBELLI@WAR_JUSTIFICATION_LEVEL_3_TITLE"
msgstr "War Justification: Major"

msgid "DIPLOMACY@CASUSBELLI@WAR_JUSTIFICATION_LEVEL_N1_DESCRIPTION"
msgstr "With negative {GLOBAL.WarJustificationConcept} ({Max}[casusBelli/] to {Min}[casusBelli/]), declaring {GLOBAL.WarConcept.Hyperlink} becomes even more damaging to your {GLOBAL.EmpireConcept.Hyperlink}![br/][br/]Unjustified wars are considered an [evilact/] [hyperlink,GLOBAL.AlignmentConcept]evil[/hyperlink] act, affect all of your relations negatively and, impact your {ResourcePenalty} income by {ResourcePenaltyValue} while the war lasts. {LOC.DIPLOMACY@CASUSBELLI@WAR_JUSTIFICATION_INCOMEEFFECTEXPLANATION}"

msgid "DIPLOMACY@CASUSBELLI@WAR_JUSTIFICATION_LEVEL_N1_HYPERLINK"
msgstr "[hyperlink,GLOBAL.WarJustificationLvlN1Concept]Unjust[/hyperlink]"

msgid "DIPLOMACY@CASUSBELLI@WAR_JUSTIFICATION_LEVEL_N1_TITLE"
msgstr "War Justification: Unjust"

msgid "DIPLOMACY@CASUSBELLI@WAR_JUSTIFICATION_LEVEL_N2_DESCRIPTION"
msgstr "With negative {GLOBAL.WarJustificationConcept} ({Max}[casusBelli/] to {Min}[casusBelli/]), declaring {GLOBAL.WarConcept.Hyperlink} becomes even more damaging to your {GLOBAL.EmpireConcept.Hyperlink}![br/][br/]Unjustified wars are considered an [evilact/] [hyperlink,GLOBAL.AlignmentConcept]evil[/hyperlink] act, affect all of your relations negatively and, impact your {ResourcePenalty} income by {ResourcePenaltyValue} while the war lasts. {LOC.DIPLOMACY@CASUSBELLI@WAR_JUSTIFICATION_INCOMEEFFECTEXPLANATION}"

msgid "DIPLOMACY@CASUSBELLI@WAR_JUSTIFICATION_LEVEL_N2_HYPERLINK"
msgstr "[hyperlink,GLOBAL.WarJustificationLvlN2Concept]Very unjust[/hyperlink]"

msgid "DIPLOMACY@CASUSBELLI@WAR_JUSTIFICATION_LEVEL_N2_TITLE"
msgstr "War Justification: Very unjust"

msgid "DIPLOMACY@CASUSBELLI@WAR_JUSTIFICATION_LEVEL_N3_DESCRIPTION"
msgstr "With completely negative {GLOBAL.WarJustificationConcept} ({Min}[casusBelli/]), declaring {GLOBAL.WarConcept.Hyperlink} can severely damage your {GLOBAL.EmpireConcept.Hyperlink}![br/][br/]Unjustified wars are considered an [evilact/] [hyperlink,GLOBAL.AlignmentConcept]evil[/hyperlink] act, affect all of your relations negatively, and impact your {ResourcePenalty} income by {ResourcePenaltyValue} while the war lasts. {LOC.DIPLOMACY@CASUSBELLI@WAR_JUSTIFICATION_INCOMEEFFECTEXPLANATION}"

msgid "DIPLOMACY@CASUSBELLI@WAR_JUSTIFICATION_LEVEL_N3_HYPERLINK"
msgstr "[hyperlink,GLOBAL.WarJustificationLvlN3Concept]Completely unjust[/hyperlink]"

msgid "DIPLOMACY@CASUSBELLI@WAR_JUSTIFICATION_LEVEL_N3_TITLE"
msgstr "War Justification: Completely unjust"

msgid "DIPLOMACY@CASUSBELLI@WAR_JUSTIFICATION_TOOLTIP"
msgstr "War Justification: {INT_Count} [casusbelli/]"

msgid "DIPLOMACY@CASUSBELLI@WONTSELL"
msgstr "[fireCol]{GLOBAL.CasusBelliConcept.Hyperlink} can't be traded[/fireCol]"

msgid "DIPLOMACY@CASUSBELLI_FABRICATED@DESCRIPTION"
msgstr "A fabricated {GLOBAL.CasusBelliConcept.Hyperlink} is a Grievance about an event that did not actually happen but can still be used as a cause for {GLOBAL.WarConcept.Hyperlink}.[br/][br/]<<m:{GLOBAL.LeaderConcept}>> can only have one fabricated grievance against another Ruler and can use these to declare War or {GLOBAL.DenounceConcept.Hyperlink} them. Fabricated Grievances can be sold to the opposing Ruler but cannot be forgiven.[br/][br/]Grievances can be fabricated through <<m:{GLOBAL.PronouncementsConcept.Hyperlink}>>."

msgid "DIPLOMACY@CASUSBELLI_FABRICATED@HYPERLINK"
msgstr "[casusBelli/] [hyperlink,GLOBAL.FabricatedCasusBelliConcept]Fabricated Grievance[/hyperlink]"

msgid "DIPLOMACY@CASUSBELLI_FABRICATED@TITLE"
msgstr "[casusBelli/] Fabricated Grievance"

msgid "DIPLOMACY@CONFIRM_DECLAREWAR@REFERENCED"
msgstr "In order to declare war on {Vassal.Name}, you must instead declare war on their overlord {STR_LeaderName}."

msgid "DIPLOMACY@CONFIRM_DECLAREWAR_CB@DESCRIPTION"
msgstr "You declare war on {STR_leaderName}. Depending on your {GLOBAL.WarJustificationConcept.Hyperlink} balance, relations with other Rulers and cities may be affected along with your {GLOBAL.AlignmentConcept.Hyperlink} and {GLOBAL.ImperiumConcept.Hyperlink} income."

msgid "DIPLOMACY@CONFIRM_DECLAREWAR_CB@TITLE"
msgstr "Declare war?"

msgid "DIPLOMACY@CONFIRM_DECLAREWAR_INFESTATION@DESCRIPTION"
msgstr "You are about to become hostile with the {STR_infestationName}. Once done, you will have no way of befriending this {GLOBAL.InfestationConcept} again."

msgid "DIPLOMACY@CONFIRM_DECLAREWAR_NOCB@DESCRIPTION"
msgstr "You declare war on {STR_leaderName}. Without any {GLOBAL.CasusBelliConcept.Hyperlink}, your {GLOBAL.AlignmentConcept.Hyperlink}, {GLOBAL.ImperiumConcept.Hyperlink} income and relations with other (non-allied) Rulers and cities will suffer heavily."

msgid "DIPLOMACY@CONFIRM_DECLAREWAR_NOCB@TITLE"
msgstr "Declare war without any {GLOBAL.WarJustificationConcept.Name}?"

msgid "DIPLOMACY@CONFIRM_DENOUNCEPLAYER@DESCRIPTION"
msgstr "A denouncement is a verbal warning about a {GLOBAL.CasusBelliConcept.Hyperlink} that affects the targeted Ruler and their relations with other AI Rulers that you both have met.[br/][br/]A Ruler may only be denounced once for each unique Grievance a Ruler has against them.[br/][br/]Denouncing a Ruler using <<m:{GLOBAL.FabricatedCasusBelliConcept.Hyperlink}>> will cause them to have a grievance against you![br/][br/]Denouncements can be made through <<m:{GLOBAL.PronouncementsConcept.Hyperlink}>>."

msgid "DIPLOMACY@CRYSTAL_DWELLING_BOOST@TEXT"
msgstr "Quests"

msgid "DIPLOMACY@DECLARATION_RIVALRY_REMOVED"
msgstr "The [hyperlink,GLOBAL.DeclRivalryConcept]Declaration of Rivalry[/hyperlink] of {HouseALord.Name} will be removed."

msgid "DIPLOMACY@DECLAREWAREFFECT@CASUSBELLI"
msgstr "Grievances awarded to non-Allied Rulers"

msgid "DIPLOMACY@DECLAREWAREFFECT@CASUSBELLI_GOODVSEVIL"
