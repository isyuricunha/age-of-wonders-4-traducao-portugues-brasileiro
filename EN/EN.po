msgstr "Crystal Dwelling"

msgid "DLC@GIANTKINGS@REALM_TRAIT@MRN_MOUNTAIN_KING@DESCRIPTION"
msgstr "This realm was once part of the fabled Giant kingdom called {GLOBAL.MyrridaLoreConcept.Hyperlink}.[br/][bulletlist][bullet/]There are Fated Regions present on the map which offer quest chains exploring the present and past of {GLOBAL.MyrridaLoreConcept.Hyperlink}.[bullet/]Gain <<m:{GLOBAL.ArtifactConcept.Hyperlink}>> when completing Fated Regions, which grant unique bonuses and can be collected to start impactful follow-up Happenings.[bullet/]Fated Regions are affected by {GLOBAL.PROPERTIES.WARDED_BY_FATE.Hyperlink}.[bullet/]Only some of the Fated Regions available will be present, leaving more to be explored on another realm.[/bulletlist]"

msgid "DLC@GIANTKINGS@REALM_TRAIT@MRN_MOUNTAIN_KING@NAME"
msgstr "Legends of Myrrida"

msgid "DLC@GIANTKINGS@REALM_TRAIT@TSR_SET_01@NAME"
