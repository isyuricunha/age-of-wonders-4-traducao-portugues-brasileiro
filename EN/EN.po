msgstr "Dwelling"

msgid "DLC@ELDRITCHREALMS@CITYDEFINITIONS_STRATEGIC@SANCTUARY@DESCRIPTION"
msgstr "A type of {GLOBAL.OutpostConcept.Hyperlink} that can only be built in a {GLOBAL.ProvinceConcept.Hyperlink} in the {GLOBAL.UmbralAbyssConcept.Hyperlink} with a {GLOBAL.BeaconOfLightConcept.Hyperlink}.[bulletlist][bullet/]Friendly <<m:{GLOBAL.UnitConcept.Hyperlink}>> inside the {GLOBAL.DomainConcept.Hyperlink} of a Sanctuary Outpost are immune to {GLOBAL.PROPERTIES.SHADOW_SICKNESS.Hyperlink}.[bullet/]<<m:{GLOBAL.CityConcept}>> cannot be founded in Sanctuary Outposts.[bullet/]Once built, can be upgraded to annex {amount} additional provinces.[bullet/]Grants {gold} {GLOBAL.GoldConcept.Hyperlink}, {mana} {GLOBAL.ManaConcept.Hyperlink}, and {knowledge} {GLOBAL.KnowledgeConcept.Hyperlink}.[/bulletlist]"

