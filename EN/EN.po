msgstr "Fey Guile"

msgid "STATUSEFFECTS_UNITPROPERTIES@GENERAL_DEMOLISHER@DESCRIPTION"
msgstr "This unit's attacks damage {GLOBAL.FortifiedConcept.Hyperlink} obstacles."

msgid "STATUSEFFECTS_UNITPROPERTIES@GENERAL_DEMOLISHER@MODIFIER_DESCRIPTION"
msgstr "Damages {GLOBAL.FortifiedConcept.Hyperlink} Obstacles."

msgid "STATUSEFFECTS_UNITPROPERTIES@GENERAL_DEMOLISHER@NAME"
msgstr "Demolisher"

msgid "STATUSEFFECTS_UNITPROPERTIES@GENERAL_JUGGERNAUGHT@NAME"
msgstr "Juggernaut"

msgid "STATUSEFFECTS_UNITPROPERTIES@GENERAL_JUGGERNAUGHT@PROPERTY_DESCRIPTION"
msgstr "This unit may crush non-{GLOBAL.FortifiedConcept.Hyperlink} obstacles."

msgid "STATUSEFFECTS_UNITPROPERTIES@GENERAL_OBSCURED@DESCRIPTION"
msgstr "This unit is {OBSCURED>ResolvedAccuracyModifier}% harder to hit with {GLOBAL.RangedConcept.Hyperlink} and ranged {GLOBAL.MagicConcept.Hyperlink} attacks."

msgid "STATUSEFFECTS_UNITPROPERTIES@GENERAL_OBSCURED@NAME"
msgstr "Obscured"

msgid "STATUSEFFECTS_UNITPROPERTIES@GENERAL_UNSTOPPABLE_JUGGERNAUGHT@NAME"
msgstr "Unstoppable Juggernaut"

msgid "STATUSEFFECTS_UNITPROPERTIES@GENERAL_UNSTOPPABLE_JUGGERNAUGHT@PROPERTY_DESCRIPTION"
msgstr "This unit can crush non-{GLOBAL.FortifiedConcept.Hyperlink} obstacles without slowing."

msgid "STATUSEFFECTS_UNITPROPERTIES@HYPER_AWARE@DESCRIPTION"
msgstr "Unit is immune to {GLOBAL.FlankingConcept.Hyperlink}[br/][br/]Hyper Awareness {GLOBAL.OpposingStatusEffectsConcept.Hyperlink} {GLOBAL.PROPERTIES.DISTRACTED.Hyperlink}."

msgid "STATUSEFFECTS_UNITPROPERTIES@HYPER_AWARE@NAME"
msgstr "Hyper-Awareness"

msgid "STATUSEFFECTS_UNITPROPERTIES@INFECTIOUS_INSANITY@DESCRIPTION"
msgstr "[bulletlist][bullet/]Unit is inflicted with {GLOBAL.PROPERTIES.INSANITY.Hyperlink}.[bullet/]Attacks have a base {INFECTIOUS_INSANITY_RESISTANCE>ResolvedStrength}% chance of inflicting Infectious Insanity.[/bulletlist]"

msgid "STATUSEFFECTS_UNITPROPERTIES@INFECTIOUS_INSANITY@MODIFIER_DESCRIPTION"
msgstr "Base {INFECTIOUS_INSANITY_RESISTANCE>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.INFECTIOUS_INSANITY.Hyperlink} for {INFECTIOUS_INSANITY_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "STATUSEFFECTS_UNITPROPERTIES@INFECTIOUS_INSANITY@NAME"
msgstr "Infectious Insanity"

msgid "STATUSEFFECTS_UNITPROPERTIES@INSANITY@DESCRIPTION"
msgstr "The unit:[bulletlist][bullet/]Is uncontrollable and always attacks the closest allied target.[bullet/]If no ally is in range, it will attack its enemies.[/bulletlist]"

msgid "STATUSEFFECTS_UNITPROPERTIES@INSANITY@MODIFIER_DESCRIPTION"
msgstr "Base {INSANITY_RESISTANCE>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.INSANITY.Hyperlink} for {INSANITY_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "STATUSEFFECTS_UNITPROPERTIES@INSANITY@MODIFIER_DESCRIPTION_GUARANTEED"
msgstr "Inflicts {GLOBAL.PROPERTIES.INSANITY.Hyperlink} for {INSANITY_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "STATUSEFFECTS_UNITPROPERTIES@INSANITY@NAME"
msgstr "Insanity"

msgid "STATUSEFFECTS_UNITPROPERTIES@MIND_CONTROLLED@DESCRIPTION"
msgstr "This unit is controlled by the opponent.[br/]If the effect lasts until the end of combat, the unit will die, unless its original owner wins."

msgid "STATUSEFFECTS_UNITPROPERTIES@MIND_CONTROLLED@DESCRIPTION_KEEP"
msgstr "This unit is controlled by the opponent.[br/]If the opponent wins the combat and this unit survives, then the opponent will keep the unit."

msgid "STATUSEFFECTS_UNITPROPERTIES@MIND_CONTROLLED@END_OF_COMBAT@MODIFIER_DESCRIPTION"
msgstr "Base {MIND_CONTROL_RESISTANCE>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.MIND_CONTROLLED.Hyperlink} until the end of combat."

msgid "STATUSEFFECTS_UNITPROPERTIES@MIND_CONTROLLED@MODIFIER_DESCRIPTION"
msgstr "Base {MIND_CONTROL_RESISTANCE>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.MIND_CONTROLLED.Hyperlink} for {MIND_CONTROL_TEMP>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "STATUSEFFECTS_UNITPROPERTIES@MIND_CONTROLLED@NAME"
msgstr "Mind-Controlled"

msgid "STATUSEFFECTS_UNITPROPERTIES@RALLYING@DESCRIPTION"
msgstr "[bulletlist][bullet/]This unit gains {RALLYING_CHANGE_MORALE>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink} at the end of its turn.[bullet/]Stacks up to {stacksMax} times.[/bulletlist][br/][br/]Rallying {GLOBAL.OpposingStatusEffectsConcept.Hyperlink} {GLOBAL.PROPERTIES.REMORSE.Hyperlink}."

msgid "STATUSEFFECTS_UNITPROPERTIES@RALLYING@NAME"
msgstr "Rally"

msgid "STATUSEFFECTS_UNITPROPERTIES@SPIRIT_DISTRACTED@ABILITY_DESCRIPTION"
msgstr "All attacks targeting this unit are {GLOBAL.FlankingConcept.Hyperlink} attacks.[br/][br/]Distracted {GLOBAL.OpposingStatusEffectsConcept.Hyperlink} {GLOBAL.PROPERTIES.HYPER_AWARE.Hyperlink}."

msgid "STATUSEFFECTS_UNITPROPERTIES@SPIRIT_DISTRACTED@ABILITY_NAME"
msgstr "Distracted"

msgid "STATUSEFFECTS_UNITPROPERTIES@SPIRIT_DISTRACTED@MODIFIER"
msgstr "Base {DISTRACTED_RESISTANCE>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.DISTRACTED.Hyperlink} for {DISTRACTED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "STATUSEFFECTS_UNITPROPERTIES@SPIRIT_DISTRACTED@MODIFIER_GUARANTEED"
msgstr "Inflicts {GLOBAL.PROPERTIES.DISTRACTED.Hyperlink} for {DISTRACTED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "STATUSEFFECTS_UNITPROPERTIES@SPIRIT_DISTRACTED@MODIFIER_GUARANTEED_IF_MOVED"
msgstr "If the unit moved, inflict {GLOBAL.PROPERTIES.DISTRACTED.Hyperlink} for {DISTRACTED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "STATUSEFFECTS_UNITPROPERTIES@TAUNTED@DESCRIPTION"
msgstr "This unit is uncontrollable and will always attack the unit that taunted it.[br/]A unit can taunt multiple opponents."

msgid "STATUSEFFECTS_UNITPROPERTIES@TAUNTED@GUARANTEED_MODIFIER_DESCRIPTION"
msgstr "Inflict {GLOBAL.PROPERTIES.TAUNTED.Hyperlink} for {TAUNTED_LINK_EFFECT>Duration} <<m:{GLOBAL.TurnConcept}>>."

msgid "STATUSEFFECTS_UNITPROPERTIES@TAUNTED@MODIFIER_DESCRIPTION"
msgstr "Base {TAUNTED_RESISTANCE>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.TAUNTED.Hyperlink} for {TAUNTED_LINK_EFFECT>Duration} <<m:{GLOBAL.TurnConcept}>>."

msgid "STATUSEFFECTS_UNITPROPERTIES@TAUNTED@MODIFIER_DESCRIPTION_IF_MOVED"
msgstr "If the unit moved, base {TAUNTED_RESISTANCE>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.TAUNTED.Hyperlink} for {TAUNTED_LINK_EFFECT>Duration} <<m:{GLOBAL.TurnConcept}>>."

msgid "STATUSEFFECTS_UNITPROPERTIES@TAUNTED@NAME"
msgstr "Taunted"

msgid "STATUSEFFECTS_UNITPROPERTIES@THRILLING_DOMINATION@DESCRIPTION"
msgstr "[bulletlist][bullet/]This unit is {GLOBAL.PROPERTIES.BERSERK.Hyperlink}.[bullet/]This unit is controlled by the opponent.[br/]If the effect lasts until the end of combat, the controller will have the option to spend [mana/] to keep the unit permanently.[/bulletlist]"

msgid "STATUSEFFECTS_UNITPROPERTIES@THRILLING_DOMINATION@NAME"
msgstr "Thrilling Domination"

msgid "STATUSEFFECTS_UNITPROPERTIES@TORMENT@DESCRIPTION"
msgstr "When the unit uses an ability:[bulletlist][bullet/]It sustains {TORMENT_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Loses {TORMENT_MORALE_LOSS>Morale Change Absolute} {GLOBAL.UnitMoraleConcept.Hyperlink}.[bullet/]Loses one stack of this effect.[bullet/]Stacks up to {maxStacks} times.[/bulletlist][br/][br/]Torment {GLOBAL.OpposingStatusEffectsConcept.Hyperlink} {GLOBAL.PROPERTIES.GRACE.Hyperlink}."

msgid "STATUSEFFECTS_UNITPROPERTIES@TORMENT@MODIFIER_DESCRIPTION"
msgstr "Base {TORMENTED_RESISTANCE>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.TORMENT.Hyperlink} until the end of combat."

msgid "STATUSEFFECTS_UNITPROPERTIES@TORMENT@MODIFIER_GUARANTEED_DESCRIPTION"
msgstr "Inflicts {TORMENT_REPEATER>Count} {GLOBAL.PROPERTIES.TORMENT.Hyperlink} until the end of combat."

msgid "STATUSEFFECTS_UNITPROPERTIES@TORMENT@NAME"
msgstr "Torment"

msgid "STORYREALM_VICTORY@01_VALLEYOFWONDERS@VICTORY"
msgstr "Defended the Valley of Wonders!"

msgid "STORYREALM_VICTORY@02_ENCHANTEDARCHIPELAGO@VICTORY"
msgstr "Freed the Enchanted Archipelago!"

msgid "STORYREALM_VICTORY@03_CRIMSONCALDERA@VICTORY"
msgstr "Claimed the Gildercoil!"

msgid "STORYREALM_VICTORY@04_ETERNALCOURT@VICTORY"
msgstr "Lifted the curse!"

msgid "STORYREALM_VICTORY@05_GREXOLIS@VICTORY"
msgstr "Conquered Grexolis!"

msgid "STORYREALM_VICTORY@DLC2_MISSION_01@VICTORY"
msgstr "Uncovered the mysteries of Manuhari!"

msgid "STORYREALM_VICTORY@DLC4_MISSION_02@VICTORY"
msgstr "Saved Athla from the eldritch clutches of Urrath!"

msgid "STORY_EVENT@1013_1019@BODY_FOOTER"
msgstr "The <<m:EnemyUnit>> beckon to {EventHero.FirstName} to join them in the waters. As <<p:EventHero>> approaches, their smiles darken. \"Come on in! Do not resist.\""

msgid "STORY_EVENT@1013_1019@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "The <<m:EnemyUnit>> beckon to you to join them in the waters. As your troops approach, their smiles darken. \"Come on in! Do not resist.\""

msgid "STORY_EVENT@1013_1019@BODY_HEADER"
msgstr "After arduous travels, the bubbling waters of the refreshing {EventStructure.Name} seem very inviting to {EventHero.Name} and <<o:EventHero>> army. The peaceful murmur of the stream is punctuated by playful laughter."

msgid "STORY_EVENT@1013_1019@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "After arduous travels, the bubbling waters of the refreshing {EventStructure.Name} seem very inviting to you and your army. The peaceful murmur of the stream is punctuated by playful laughter."

msgid "STORY_EVENT@1013_1019@BODY_LORE"
msgstr "\"Don't just stand there!\" calls a welcoming, seductive voice, joined by a chorus of laughter. Fair <<m:EnemyUnit>> are frolicking in the waters of the spring. They beckon invitingly with their bare arms, blocking out the humanoid shapes floating lifelessly under the surface. The <<m:EnemyUnit>> call out, almost imploring with eager requests. \"Join us! Come bathe with us...\""

msgid "STORY_EVENT@1013_1019@BUTTON_0"
msgstr "\"It's a trap! Attack!\""

msgid "STORY_EVENT@1013_1019@BUTTON_1"
msgstr "Order your troops to avert their eyes before attacking the <<m:EnemyUnit>>."

msgid "STORY_EVENT@1013_1019@BUTTON_3"
msgstr "\"Do not give in to temptation! Our faith will guide us through this!\""

msgid "STORY_EVENT@1013_1019@BUTTON_4"
msgstr "Back away from these temptresses."

msgid "STORY_EVENT@1013_1019@TITLE"
msgstr "Bait and Bathe"

msgid "STORY_EVENT@1013_1020@BODY_FOOTER"
msgstr "The {EventUnit.Name} smiles. \"I don't have much I can offer you except my gratitude, brave <<EventHero{hero/heroine}>>. The {EventStructure.Name} is yours.\""

msgid "STORY_EVENT@1013_1020@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "The {EventUnit.Name} smiles. \"I don't have much I can offer you except my gratitude, O {PlayerLeader.Title}. The {EventStructure.Name} is yours.\""

msgid "STORY_EVENT@1013_1020@BODY_HEADER"
msgstr "{EventHero.Name} emerges victorious from the {EventStructure.Name}. One final {EventUnit} approaches, arms raised. \"Did I miss all the fun?\" She asks playfully."

msgid "STORY_EVENT@1013_1020@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "You emerge victorious from the {EventStructure.Name}. One final {EventUnit} approaches, arms raised. \"Did I miss all the fun?\" She asks playfully."

msgid "STORY_EVENT@1013_1020@BODY_LORE"
msgstr "She continues: \"Those hags tricked people only to drown them for sport. They even tried it on me, once, before chasing me away. I'm glad they're...\" she pauses to choose her words carefully, \"... gone.\" I'm not like them, I've always wanted to leave the {EventStructure.Name} and learn about the world, rather than drown everyone.\""

msgid "STORY_EVENT@1013_1020@BUTTON_0"
msgstr "\"We are only interested in the riches [gold/] your treacherous sisters looted.\""

msgid "STORY_EVENT@1013_1020@BUTTON_0@HERO_IS_PLAYERLE"
msgstr "\"I am only interested in the riches [gold/] your treacherous sisters looted.\""

msgid "STORY_EVENT@1013_1020@BUTTON_1"
msgstr "\"We will take the fruits and plants [food/] you grow here.\""

msgid "STORY_EVENT@1013_1020@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"I will take the fruits and plants [food/] you grow here.\""

msgid "STORY_EVENT@1013_1020@BUTTON_2"
msgstr "\"Join us, {EventUnit.Name}. [unit/] Then you can learn all that you desire.\""

msgid "STORY_EVENT@1013_1020@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "\"Join me, {EventUnit.Name}. [unit/] Then you can learn all that you desire.\""

msgid "STORY_EVENT@1013_1020@TITLE"
msgstr "Bait and Bathe: Aftermath"

msgid "STORY_EVENT@1013_1024@BODY_FOOTER"
msgstr "She smiles coldly as ice creatures rise from the pristine snow. \"Come embrace the {EventUnit}, and be preserved.\""

msgid "STORY_EVENT@1013_1024@BODY_HEADER"
msgstr "After traveling some distance in the hot midday sun, {EventHero.Name} heads toward a wellspring, expecting refreshment..."

msgid "STORY_EVENT@1013_1024@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "After traveling some distance in the hot midday sun, you head toward a wellspring, expecting refreshment..."

msgid "STORY_EVENT@1013_1024@BODY_LORE"
msgstr "Despite the heat of the day, the wellspring is frozen solid. Upon its surface sits a family of ducks, frozen in ice. A woman, crowned in glittering icicles, glides closer over the frozen waters. Ice spreads from beneath her icy bare feet. She gingerly caresses the frozen animals, before her head snaps toward {EventHero.FirstName}. \"Warm blood disturbs my tranquil lake.\""

msgid "STORY_EVENT@1013_1024@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Despite the heat of the day, the wellspring is frozen solid. Upon its surface sits a family of ducks, frozen in ice. A woman, crowned in glittering icicles, glides closer over the frozen waters. Ice spreads from beneath her icy bare feet. She gingerly caresses the frozen animals, before her head snaps toward you. \"Warm blood disturbs my tranquil lake.\""

msgid "STORY_EVENT@1013_1024@BUTTON_0"
msgstr "\"Time to break the ice! To arms!\""

msgid "STORY_EVENT@1013_1024@BUTTON_1"
msgstr "Use magic [mana/] to protect yourself from the cold."

msgid "STORY_EVENT@1013_1024@BUTTON_3"
msgstr "Stoke your inner fire to withstand the cold."

msgid "STORY_EVENT@1013_1024@BUTTON_4"
msgstr "Flee from the icy cold."

msgid "STORY_EVENT@1013_1024@TITLE"
msgstr "The Frozen Lake"

msgid "STORY_EVENT@1013_1025@BODY_FOOTER"
msgstr "\"No time to delay, my secrets melt away.\" The fast melting symbols are nearly gone."

msgid "STORY_EVENT@1013_1025@BODY_HEADER"
msgstr "As the sun melts the last of the ice, the sound of quacking returns to the spring."

msgid "STORY_EVENT@1013_1025@BODY_LORE"
msgstr "The White Witch fades, her voice a faint cool breeze. \"I am but a remnant of the Queen who once ruled here. She raided the warm lands, preserving all life in ice. Frozen markers lead to her treasure vault, but now, they melt.\" {EventHero.FirstName} notices in the last traces of ice there is some kind of map, detailing the hiding place of a lost treasure."

msgid "STORY_EVENT@1013_1025@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "The White Witch fades, her voice a faint cool breeze. \"I am but a remnant of the Queen who once ruled here. She raided the warm lands, preserving all life in ice. Frozen markers lead to her treasure vault, but now, they melt.\" You notice in the last traces of ice there is some kind of map, detailing the hiding place of a lost treasure."

msgid "STORY_EVENT@1013_1025@BUTTON_0"
msgstr "Follow directions in the ice depicting a treasure chest. [gold/]"

msgid "STORY_EVENT@1013_1025@BUTTON_1"
msgstr "Follow directions in the ice depicting a {EventItem.Name}."

msgid "STORY_EVENT@1013_1025@BUTTON_2"
msgstr "Follow directions in the ice depicting a cold star. [mana/]"

msgid "STORY_EVENT@1013_1025@BUTTON_4"
msgstr "Ignore the treasure, nurse the wellspring’s natural wildlife [natureboon/] to life."

msgid "STORY_EVENT@1013_1025@TITLE"
msgstr "The Frozen Lake: Aftermath"

msgid "STORY_EVENT@1013_1046@BODY_FOOTER"
msgstr "The smiths look to {EventHero.FirstName} and <<o:EventHero>> troops; hope draining from their flame-blasted faces. \"How do you quench an unquenchable fire?\""

msgid "STORY_EVENT@1013_1046@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "The smiths look to you and your troops; hoping a {PlayerLeader.Title} like you can help them. \"How do you quench an unquenchable fire?\""

msgid "STORY_EVENT@1013_1046@BODY_HEADER"
msgstr "{EventHero.Name} approaches the {EventStructure.Name}, expecting to see the workers busily smithing. Instead, frowning smiths are standing outside the forge, muttering."

msgid "STORY_EVENT@1013_1046@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "You approach the {EventStructure.Name}, expecting to see the workers busily smithing. Instead, frowning smiths are standing outside the forge, muttering."

msgid "STORY_EVENT@1013_1046@BODY_LORE"
msgstr "The forgemaster explains that the entire forge suddenly overheated. \"No matter how we doused the flames, the heat only grew more intense. It's as though Yaka himself decided to make this place his throne!\" The smiths behind him nod in agreement. \"I swear, the flames have come alive!\" one of them adds, soot covering his face."

msgid "STORY_EVENT@1013_1046@BUTTON_0"
msgstr "\"This fire shall be quenched with blood! To arms!\""

msgid "STORY_EVENT@1013_1046@BUTTON_1"
msgstr "Order engineers of {EventCity.Name} [structureprod/] to open cooling vents within the {EventStructure.Name} before entering."

msgid "STORY_EVENT@1013_1046@BUTTON_4"
msgstr "Use your knowledge of earth and forges to open the cooling vents beneath the {EventStructure.Name} yourself."

msgid "STORY_EVENT@1013_1046@BUTTON_5"
msgstr "Retreat from the volatile forge."

msgid "STORY_EVENT@1013_1046@TITLE"
msgstr "Too Hot to Handle"

msgid "STORY_EVENT@1013_1047@BODY_FOOTER"
msgstr "The forgemaster nods. We are indebted to you, <<EventHero{hero/heroine}>> of the {EventStructure.Name}. Name your prize.\""

msgid "STORY_EVENT@1013_1047@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "The forgemaster nods. \"We are indebted to you, {PlayerLeader.Title}, Godir of the {EventStructure.Name}. Name your prize.\""

msgid "STORY_EVENT@1013_1047@BODY_HEADER"
msgstr "The forge flames flicker and glow, no longer raging out of control. The forgemaster grins from ear to ear."

msgid "STORY_EVENT@1013_1047@BODY_LORE"
msgstr "\"Your clever resourcefulness is something we need at the forge. I don't suppose you want a job working here with us?\" Before {EventHero.FirstName} can answer, the forgemaster gives <<P:EventHero>> a strong pat on the back and bursts into an explosive laugh. \"I am sure your duties are far more important than the simple work we do here. Still…\""

msgid "STORY_EVENT@1013_1047@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "\"Your clever resourcefulness is rare, O {PlayerLeader.Title}. I don't suppose you want a job working here with us?\" Before you can respond, the forgemaster bursts into an explosive laugh. \"No offense meant, {PlayerLeader.TitleName}. I am sure your ambitions are far bigger than the simple work we do here. Still…\""

msgid "STORY_EVENT@1013_1047@BUTTON_1"
msgstr "\"I require a new armor.\" [item/]"

msgid "STORY_EVENT@1013_1047@BUTTON_2"
msgstr "\"Your debt will be paid in gold [gold/].\""

msgid "STORY_EVENT@1013_1047@BUTTON_3"
msgstr "\"Your good word and hard work for our realm is payment enough, forgemaster.\" [goodact/]"

msgid "STORY_EVENT@1013_1047@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "\"Your good word and hard work for this realm is payment enough, forgemaster.\" [goodact/]"

msgid "STORY_EVENT@1013_1047@BUTTON_4"
msgstr "\"Forge me a new weapon.\" [item/]"

msgid "STORY_EVENT@1013_1047@TITLE"
msgstr "Too Hot To Handle: Aftermath"

msgid "STORY_EVENT@1013_1054@BODY_FOOTER"
msgstr "The ringmaster proclaims: \"Join the carnage, defeat my [hyperlink,GLOBAL.HeroConcept]Heroes[/hyperlink], and win the gold! Or run back home to your mother, like all {EventHeroRace.Name} do.\""

msgid "STORY_EVENT@1013_1054@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "The ringmaster proclaims: \"Join the carnage, defeat my [hyperlink,GLOBAL.HeroConcept]Heroes[/hyperlink], and win the gold! Or use those pretty legs to run straight back home.\""

msgid "STORY_EVENT@1013_1054@BODY_HEADER"
msgstr "While traveling past a hill crowned with the vestiges of a ruined castle, {EventHero.Name} can hear the remote echo of a cheering crowd. Intrigued, <<p:EventHero>> moves closer to investigate."

msgid "STORY_EVENT@1013_1054@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "While traveling past a hill crowned with the vestiges of a ruined castle, you hear the remote echo of a cheering crowd. You move closer to investigate."

msgid "STORY_EVENT@1013_1054@BODY_LORE"
msgstr "The ruins open out into a makeshift fighting arena. In the gap formed by a broken wall stands a group of {EventRace.Name}, led by a ringmaster, gesturing at {EventHero.FirstName}. \"Welcome, bloodthirsty onlookers!\" <<Cp:EventUnit>> smiles with a mouth missing most of its teeth. \"I run this mobile fighting establishment. The toughest gladiators bring home the gold!\" <<Cp:EventUnit>> holds up a pouch filled with coins."

msgid "STORY_EVENT@1013_1054@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "The ruins open out into a makeshift fighting arena. In the gap formed by a broken wall stands a group of {EventRace.Name}, led by a ringmaster, gesturing at you. \"A noble {PlayerLeader.Title} graces us with <<o:PlayerLeader>> presence! Welcome, bloodthirsty onlooker!\" <<Cp:EventUnit>> smiles with a mouth missing most of its teeth. \"I run this mobile fighting establishment. The toughest gladiators bring home the gold!\" <<Cp:EventUnit>> holds up a pouch filled with coins."

msgid "STORY_EVENT@1013_1054@BUTTON_0"
msgstr "\"We will show all of you what you are dealing with.\""

msgid "STORY_EVENT@1013_1054@BUTTON_0@HERO_IS_PLAYERLE"
msgstr "\"I will show all of you what you are dealing with.\""

msgid "STORY_EVENT@1013_1054@BUTTON_1"
msgstr "Make a wager [gold/] that you will win, encouraging your army."

msgid "STORY_EVENT@1013_1054@BUTTON_2"
msgstr "Leave the arena."

msgid "STORY_EVENT@1013_1054@TITLE"
msgstr "Gold and Gladiators"

msgid "STORY_EVENT@1013_1055@BODY_FOOTER"
msgstr "\"Here’s your cut of the winnings, now we'll take our leave...\" <<Cp:EventUnit>> says, holding out a much smaller bag of coins."

msgid "STORY_EVENT@1013_1055@BODY_HEADER"
msgstr "{EventHero.Name} was victorious against a band of fierce gladiators. The ringmaster grins and weaves <<o:EventUnit>> way past expired combatants."

msgid "STORY_EVENT@1013_1055@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "You were victorious against a band of fierce gladiators. The ringmaster grins and weaves <<o:EventUnit>> way past expired combatants."

msgid "STORY_EVENT@1013_1055@BODY_LORE"
msgstr "\"Amazing! By the {GLOBAL.GodirLoreConcept.Hyperlink}, I haven’t seen that sort of fighting in ages!” <<Cp:EventUnit>> pats the fat coinpurse on <<o:EventUnit>> belt. Coins jingle. \"I suppose your mighty {PlayerLeader.Title} expects payment.\" <<Cp:EventUnit>> looks around and says, \"Pack up, boys! The {EventStructure.Name} has a new owner, and <<o:EventHero>> name is {EventHero.FirstName}.\" <<Cp:EventUnit>> grins at {EventHero.FirstName} while <<o:EventUnit>> underlings mutter and leave."

msgid "STORY_EVENT@1013_1055@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "\"Amazing! By the {GLOBAL.GodirLoreConcept.Hyperlink}, I haven’t seen that sort of fighting in ages!\" <<Cp:EventUnit>> pats the fat coinpurse on <<o:EventUnit>> belt. Coins jingle. \"I suppose you expect payment, my {PlayerLeader.Title}.\" <<Cp:EventUnit>> looks around and says, \"Pack up, boys! The {EventStructure.Name} has a new owner, and <<o:EventHero>> name is {EventHero.FirstName}.\" <<Cp:EventUnit>> grins at {EventHero.FirstName} while <<o:EventUnit>> underlings mutter and leave."

msgid "STORY_EVENT@1013_1055@BUTTON_0"
msgstr "Demand all the gold you are owed before allowing <<P:EventUnit>> to leave. [gold/]"

msgid "STORY_EVENT@1013_1055@BUTTON_1"
msgstr "\"We could use your fighters to instruct the soldiers in {EventCity.Name}.\" [unitprod/]"

msgid "STORY_EVENT@1013_1055@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"I could use your fighters to instruct my soldiers in {EventCity.Name}.\" [unitprod/]"

msgid "STORY_EVENT@1013_1055@BUTTON_2"
msgstr "\"Illegal arenas are a blight. Best you leave before the law [order/] catches up with you.\""

msgid "STORY_EVENT@1013_1055@BUTTON_3"
msgstr "\"We ask your strongest champion to join us [unit/] in the future.\""

msgid "STORY_EVENT@1013_1055@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "\"I ask your strongest champion to join me [unit/] in the future.\""

msgid "STORY_EVENT@1013_1055@BUTTON_4"
msgstr "\"We ask your strongest champion to join us [unit/].\""

msgid "STORY_EVENT@1013_1055@BUTTON_4@HERO_IS_PLAYERLE"
msgstr "\"I ask your strongest champion to join me [unit/].\""

msgid "STORY_EVENT@1013_1055@TITLE"
msgstr "Gold and Gladiators: Aftermath"

msgid "STORY_EVENT@1013_1056@BODY_FOOTER"
msgstr "The rugged stranger grins, keeping <<o:EventHeroB>> distance. \"Those bastards laid out traps. I can help you find them. Scratch my back and I'll scratch yours, whaddaya say?\""

msgid "STORY_EVENT@1013_1056@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "The rugged stranger grins, keeping <<o:EventHeroB>> distance. \"Those bastards laid out traps. I can help you find them. Scratch my back and I'll scratch yours, whaddaya say?\""

msgid "STORY_EVENT@1013_1056@BODY_HEADER"
msgstr "Before {EventHero.Name} can enter a bandit-infested fortress, <<p:EventHero>> is stopped by a whistle from nearby."

msgid "STORY_EVENT@1013_1056@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Before you can enter a bandit-infested fortress, you are stopped by a whistle from nearby."

msgid "STORY_EVENT@1013_1056@BODY_LORE"
msgstr "A coarse-looking woman appears from behind a broken wall. \"Hey, psst! I see you're tryin' to enter my old camp. I used to lead the gang of idiots in there. But, after our last raid, they booted me out! Mutiny! Hey, if you teach them a lesson, I'll gladly point you to our secret stash of loot. Sharin' the spoils, y'know?\""

msgid "STORY_EVENT@1013_1056@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "A coarse-looking woman appears from behind a broken wall. \"Hey, psst, my {PlayerLeader.Title}! I see you're tryin' to enter my old camp. I used to lead the gang of idiots in there. But, after our last raid, they booted me out! Mutiny! Hey, if you teach them a lesson, I'll gladly point you to our secret stash of loot. Sharin' the spoils, y'know?\""

msgid "STORY_EVENT@1013_1056@BUTTON_0"
msgstr "\"I don't need help from brigands like you, I'll clear these ruins myself.\" [goodact/]"

msgid "STORY_EVENT@1013_1056@BUTTON_1"
msgstr "Allow the bandit \"leader\" to reveal the traps before entering the ruins."

msgid "STORY_EVENT@1013_1056@BUTTON_2"
msgstr "Figure out where the traps are using your knowledge of stone and architecture."

msgid "STORY_EVENT@1013_1056@BUTTON_4"
msgstr "Leave the bandit and her former crew."

msgid "STORY_EVENT@1013_1056@TITLE"
msgstr "Wrath and Mutiny"

msgid "STORY_EVENT@1013_1057@BODY_FOOTER"
msgstr "{EventHeroB.Name} leads {EventHero.FirstName} to a room filled with bandit loot. \"Ta-dah. I'll leave you to it...\" <<Cp:EventHeroB>> quickly fills <<o:EventHeroB>> pockets with gold and attempts to leave."

msgid "STORY_EVENT@1013_1057@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "{EventHeroB.Name} leads you to a room filled with bandit loot. \"Ta-dah. I'll leave you to it...\" <<Cp:EventHeroB>> quickly fills <<o:EventHeroB>> pockets with gold and attempts to leave."

msgid "STORY_EVENT@1013_1057@BODY_HEADER"
msgstr "After dealing with the den of bandits, {EventHero.Name} can search the ruins. <<Cp:EventHero>> is quickly joined by the former bandit leader."

msgid "STORY_EVENT@1013_1057@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "After dealing with the den of bandits, you can search the ruins. You're quickly joined by the former bandit leader."

msgid "STORY_EVENT@1013_1057@BODY_LORE"
msgstr "The stranger sighs as <<p:EventHeroB>> sees the bodies of <<o:EventHeroB>> former comrades. \"Shame. They were decent cronies, while it lasted.\" <<Cp:EventHeroB>> leads {EventHero.Name} to a secret room, hidden behind a stone slab. \"Anyways, here's the stash. Some fine loot too, even a {EventItem.Name}... The name's {EventHeroB.Name} by the way. Should our paths cross again.\""

msgid "STORY_EVENT@1013_1057@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "The stranger sighs as <<p:EventHeroB>> sees the bodies of <<o:EventHeroB>> former comrades. \"Shame. They were decent cronies, while it lasted.\" <<Cp:EventHeroB>> leads you to a secret room, hidden behind a stone slab. \"Anyways, here's the stash. Some fine loot too, even a {EventItem.Name}... The name's {EventHeroB.Name} by the way. Should our paths cross again.\""

msgid "STORY_EVENT@1013_1057@BUTTON_0"
msgstr "Allow the soldiers of {EventHero.Name} to loot what they want. [morale/]"

msgid "STORY_EVENT@1013_1057@BUTTON_0@HERO_IS_PLAYERLE"
msgstr "Allow your soldiers to loot what they want. [morale/]"

msgid "STORY_EVENT@1013_1057@BUTTON_1"
msgstr "\"We could use a bold leader [unit/] like you in the future, {EventHeroB.Name}.\""

msgid "STORY_EVENT@1013_1057@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"I could use a bold leader [unit/] like you in the future, {EventHeroB.Name}.\""

msgid "STORY_EVENT@1013_1057@BUTTON_3"
msgstr "\"Not so fast! You will be tried [order/] for your crimes and these stolen goods confiscated.\""

msgid "STORY_EVENT@1013_1057@BUTTON_4"
msgstr "\"We could use a bold leader [unit/] like you on our side, {EventHeroB.Name}.\""

msgid "STORY_EVENT@1013_1057@BUTTON_4@HERO_IS_PLAYERLE"
msgstr "\"I could use a bold leader [unit/] like you on my side, {EventHeroB.Name}.\""

msgid "STORY_EVENT@1013_1057@BUTTON_5"
msgstr "Claim all the loot [gold/] for the empire."

msgid "STORY_EVENT@1013_1057@TITLE"
msgstr "Wrath and Mutiny: Aftermath"

msgid "STORY_EVENT@1013_1058@BODY_FOOTER"
msgstr "{EventHero.FirstName} realizes that many souls will be freed upon the defeat of the {EnemyUnit.Name}."

msgid "STORY_EVENT@1013_1058@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "You realize that many souls will be freed upon the defeat of the {EnemyUnit.Name}."

msgid "STORY_EVENT@1013_1058@BODY_HEADER"
msgstr "As {EventHero.Name} enters the {EventStructure.Name}, <<p:EventHero>> feels incomprehensible dread. Slowly, <<p:EventHero>> crouches closer."

msgid "STORY_EVENT@1013_1058@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "As you enter the {EventStructure.Name}, you feel incomprehensible dread. Slowly, you crouch closer."

msgid "STORY_EVENT@1013_1058@BODY_LORE"
msgstr "In the courtyard, a shadowy creature moves with unnatural grace. <<Cp:EnemyUnit>> touches the ground which groans in protest. A flickering light rises from it... <<Cp:EnemyUnit>> grasps the light and pulls it into <<r:EnemyUnit>>.[br/]{EventHero.FirstName} realizes this is a {EnemyUnit.Name} from the {GLOBAL.AstralSeaLoreConcept.Hyperlink}, a being that, according to folklore, feeds on magic and lost {GLOBAL.SoulsLoreConcept.Hyperlink}..."

msgid "STORY_EVENT@1013_1058@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "In the courtyard, a shadowy creature moves with unnatural grace. <<Cp:EnemyUnit>> touches the ground which groans in protest. A flickering light rises from it... <<Cp:EnemyUnit>> grasps the light and pulls it into <<r:EnemyUnit>>.[br/]You realize this is a {EnemyUnit.Name} from the {GLOBAL.AstralSeaLoreConcept.Hyperlink}, a being that, according to folklore, feeds on magic and lost {GLOBAL.SoulsLoreConcept.Hyperlink}..."

msgid "STORY_EVENT@1013_1058@BUTTON_0"
msgstr "\"No time to waste! This {EnemyUnit.Name} must be stopped!\""

msgid "STORY_EVENT@1013_1058@BUTTON_1"
msgstr "Channel raw magical prowess [mana/] to weaken the {EnemyUnit.Name} before attacking."

msgid "STORY_EVENT@1013_1058@BUTTON_2"
msgstr "Leave the {EventStructure.Name}."

msgid "STORY_EVENT@1013_1058@BUTTON_3"
msgstr "Grant {EventHero.FirstName} your knowledge of the arcane to weaken the <<g:link^n,EnemyUnit>> to this realm."

msgid "STORY_EVENT@1013_1058@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "Call upon your knowledge of the arcane to weaken the <<g:link^n,EnemyUnit>> to this realm."

msgid "STORY_EVENT@1013_1058@TITLE"
msgstr "Heroes and Horrors"

msgid "STORY_EVENT@1013_1059@BODY_FOOTER"
msgstr "Two freed {GLOBAL.SoulsLoreConcept.Hyperlink} linger, wishing to lead {EventHero.Name} to their mortal possessions out of gratitude before they move on. Which of them does {EventHero.FirstName} follow?"

msgid "STORY_EVENT@1013_1059@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Two freed souls linger, wishing to lead you to their mortal possessions out of gratitude before they move on. Which of them do you follow?"

msgid "STORY_EVENT@1013_1059@BODY_HEADER"
msgstr "Light bursts from the defeated monsters' wounds, tiny darts of energy zigzagging into the sky toward freedom."

msgid "STORY_EVENT@1013_1059@BODY_LORE"
msgstr "{EventHero.FirstName} takes a short moment to look at the fleeting lights before shifting <<o:EventHero>> gaze downward again. Many bodies lie strewn across the ruins. A few of the lights float to the bodies, as if saying goodbye, before disappearing into the sky. Two of them waver, floating nearby. They seem to want to lead {EventHero.FirstName} to their possessions."

msgid "STORY_EVENT@1013_1059@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "You take a short moment to look at the fleeting lights before shifting your gaze downward again. Many bodies lie strewn across the ruins. A few of the lights float to the bodies, as if saying goodbye, before disappearing into the sky. Two of them waver, floating nearby. They seem to want to lead you to their possessions."

msgid "STORY_EVENT@1013_1059@BUTTON_0"
msgstr "Follow the soul of the merchant, who offers his savings [gold/]."

msgid "STORY_EVENT@1013_1059@BUTTON_1"
msgstr "Follow the soul of the commander, who fell wielding an {EventItem.Name} [item/]."

msgid "STORY_EVENT@1013_1059@BUTTON_2"
msgstr "Give all bodies a proper funeral. Ask for nothing but the peace of these spirits. [goodact/]"

msgid "STORY_EVENT@1013_1059@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "\"Saving lost souls is its own reward. I ask for nothing else.\" [goodact/]"

msgid "STORY_EVENT@1013_1059@BUTTON_3"
msgstr "Quickly claim these freed souls for yourself. [evilact/]"

msgid "STORY_EVENT@1013_1059@TITLE"
msgstr "Heroes and Horrors: Aftermath"

msgid "STORY_EVENT@1013_1060@BODY_FOOTER"
msgstr "Blinking in the light, {EventHero.FirstName} realizes this maze would be the ideal place for an ambush. Something approaches..."

msgid "STORY_EVENT@1013_1060@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Blinking in the light, you realize this maze would be the ideal place for an ambush. Something approaches..."

msgid "STORY_EVENT@1013_1060@BODY_HEADER"
msgstr "{EventHero.Name} discovers a thicket of trees made of pure crystal. <<Cp:EventHero>> finds <<r:EventHero>> confused by the reflected light around <<P:EventHero>>"

msgid "STORY_EVENT@1013_1060@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "You discover a thicket of trees made of pure crystal. You find yourself confused by the reflected light around you."

msgid "STORY_EVENT@1013_1060@BODY_LORE"
msgstr "{EventHero.FirstName} discovers that the further <<p:EventHero>> explores, the more disorienting and twisty this maze becomes. The forest of crystal and light confuses <<o:EventHero>> sense of direction. As <<p:EventHero>> and <<o:EventHero>> army stumble through the maze, they are not sure what is and what is not a path—or merely a reflection."

msgid "STORY_EVENT@1013_1060@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "You discover that the further you explore, the more disorienting and twisty this maze becomes. The forest of crystal and light confuses your sense of direction. As you and your army stumble through the maze, you are not sure what is and what is not a path—or merely a reflection."

msgid "STORY_EVENT@1013_1060@BUTTON_0"
msgstr "\"Ambush or not, retreating shows weakness! To arms!\""

msgid "STORY_EVENT@1013_1060@BUTTON_1"
msgstr "Use your arcane knowledge to twist the effects of the reflective maze to your advantage."

msgid "STORY_EVENT@1013_1060@BUTTON_2"
msgstr "Retreat the way you came in."

msgid "STORY_EVENT@1013_1060@BUTTON_4"
msgstr "Use magic [mana/] to use the reflective maze to your advantage."

msgid "STORY_EVENT@1013_1060@TITLE"
msgstr "Maze of Crystal"

msgid "STORY_EVENT@1013_1061@BODY_FOOTER"
msgstr "After helping <<P:EventUnit>>, the minstrel opens <<o:EventUnit>> wagon and gestures inside. \"Thank you, {EventHero.FirstName}. Pick your reward.\""

msgid "STORY_EVENT@1013_1061@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "After helping <<P:EventUnit>>, the minstrel opens <<o:EventUnit>> wagon and gestures inside. \"Thank you, O {PlayerLeader.Title}. Pick your reward.\""

msgid "STORY_EVENT@1013_1061@BODY_HEADER"
msgstr "After fending off an ambush, {EventHero.Name} progresses through the dizzying crystal forest. <<Cp:EventHero>> discovers a wandering minstrel."

msgid "STORY_EVENT@1013_1061@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "After fending off an ambush, you progress through the dizzying crystal forest. You discover a wandering minstrel."

msgid "STORY_EVENT@1013_1061@BODY_LORE"
msgstr "The minstrel jumps down from <<o:EventUnit>> wagon. <<Cp:EventUnit>> is excited to see {EventHero.FirstName}. \"Oh great {EventHero.TitleName}, you are a wonder! I am so lost! And the ambushers! Ruffians everywhere! If you could guide me through the mirror maze, I will give you a reward from my wagon.\" Having mastered the maze, this is no problem for {EventHero.FirstName}."

msgid "STORY_EVENT@1013_1061@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "The minstrel jumps down from <<o:EventUnit>> wagon. <<Cp:EventUnit>> is excited to see you. \"Oh great {PlayerLeader.TitleName}, you are a wonder! I am so lost! And the ambushers! Ruffians everywhere! If you could guide me through the mirror maze, I will give you a reward from my wagon.\" Having mastered the maze, this is no problem for you."

msgid "STORY_EVENT@1013_1061@BUTTON_0"
msgstr "Ask the minstrel to perform in {EventCity}. [happiness/]"

msgid "STORY_EVENT@1013_1061@BUTTON_1"
msgstr "Ask the minstrel for a share of <<o:EventUnit>> gold [gold/]."

msgid "STORY_EVENT@1013_1061@BUTTON_3"
msgstr "Ask the minstrel to share all <<p:EventUnit>> learned [knowledge/] during <<o:EventUnit>> travels."

msgid "STORY_EVENT@1013_1061@BUTTON_4"
msgstr "\"Sing about how you were saved by the legendary [influence/] {PlayerLeader.TitleName}.\""

msgid "STORY_EVENT@1013_1061@TITLE"
msgstr "Maze of Crystal: Aftermath"

msgid "STORY_EVENT@1013_1066@BODY_FOOTER"
msgstr "\"Confess, and prove your {PlayerLeader.Title} is worthy of our devotion.\" <<g:army^n,EventHero>> looks at <<P:EventHero>>, curious how <<p:EventHero>> will respond."

msgid "STORY_EVENT@1013_1066@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "\"Confess, and prove you are worthy of our devotion.\" Your army looks at you, curious how you will respond."

msgid "STORY_EVENT@1013_1066@BODY_HEADER"
msgstr "{EventHero.Name} approaches the {EventStructure}. Fading, unreadable words are emblazoned across the first footstone."

msgid "STORY_EVENT@1013_1066@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "You approach the {EventStructure}. Fading, unreadable words are emblazoned across the first footstone."

msgid "STORY_EVENT@1013_1066@BODY_LORE"
msgstr "{EventHero.FirstName} sees a crumbling statue at the far end of the temple, depicting an ancient unknown {GLOBAL.GodirLoreConcept.Hyperlink}. Before <<p:EventHero>> can progress further, a {EnemyUnit} appears, followed by a booming voice. \"You walk in divine halls of a Godir long lost. Is your {PlayerLeader.Title} to be its new patron? Prove <<p:PlayerLeader>> is worthy through this trial.\""

msgid "STORY_EVENT@1013_1066@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "You see a crumbling statue at the far end of the temple, depicting an ancient unknown {GLOBAL.GodirLoreConcept.Hyperlink}. Before you can progress further, a {EnemyUnit} appears, followed by a booming voice. \"You walk in divine halls of a Godir long lost. Are you, {PlayerLeader.Title}, to be its new patron? Prove you are worthy through this trial.\""

msgid "STORY_EVENT@1013_1066@BUTTON_0"
msgstr "\"I have nothing to confess to you. Challenge me!\""

msgid "STORY_EVENT@1013_1066@BUTTON_1"
msgstr "Pay penance [gold/] and confess your sins before facing the {EnemyUnit}."

msgid "STORY_EVENT@1013_1066@BUTTON_2"
msgstr "Confess your sins with vigor and gravitas."

msgid "STORY_EVENT@1013_1066@BUTTON_3"
msgstr "\"You want to hear about my sins? Where should I start?\""

msgid "STORY_EVENT@1013_1066@BUTTON_5"
msgstr "Leave the {EventStructure}."

msgid "STORY_EVENT@1013_1066@BUTTON_6"
msgstr "[goodact/] \"None are free of sin, but I aim to be better.\""

msgid "STORY_EVENT@1013_1066@TITLE"
msgstr "A New Creed"

msgid "STORY_EVENT@1013_1067@BODY_FOOTER"
msgstr "The voice fades, and with it, the original words of the temple. A silence falls... As if the temple waits for a new creed."

msgid "STORY_EVENT@1013_1067@BODY_HEADER"
msgstr "{EventHero.Name} has withstood the trials of the {EventStructure} in your name. The halls fall silent."

msgid "STORY_EVENT@1013_1067@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "You have withstood the trials of the {EventStructure}. The halls fall silent."

msgid "STORY_EVENT@1013_1067@BODY_LORE"
msgstr "As {EventHero} ventures further, a shimmering passes over a massive statue at the far end of the temple. When the light disappears, the statue has changed to show none other but you, {PlayerLeader.TitleName}. The voice booms once more. \"You have proven yourself a worthy {GLOBAL.GodirLoreConcept.Hyperlink}, O {PlayerLeader.Title}. Henceforth this Temple will be dedicated to you and your divine word.\""

msgid "STORY_EVENT@1013_1067@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "As you venture further, a shimmering passes over a massive statue at the far end of the temple. When the light disappears, the statue has changed to show none other but you, {PlayerLeader.TitleName}. The voice booms once more. \"You have proven yourself a worthy {GLOBAL.GodirLoreConcept.Hyperlink}, O {PlayerLeader.Title}. Henceforth this Temple will be dedicated to you and your divine word.\""

msgid "STORY_EVENT@1013_1067@BUTTON_0"
msgstr "\"Perfection through change.\" [chaosboon/]"

msgid "STORY_EVENT@1013_1067@BUTTON_1"
msgstr "\"Balance through growth.\" [natureboon/]"

msgid "STORY_EVENT@1013_1067@BUTTON_2"
msgstr "\"Stability through law.\" [orderboon/]"

msgid "STORY_EVENT@1013_1067@BUTTON_3"
msgstr "\"Truth through understanding.\" [astralboon/]"

msgid "STORY_EVENT@1013_1067@BUTTON_4"
msgstr "\"Legacy through fortitude.\" [materiumboon/]"

msgid "STORY_EVENT@1013_1067@BUTTON_5"
msgstr "\"Unity through sacrifice.\" [goodact/]"

msgid "STORY_EVENT@1013_1067@BUTTON_6"
msgstr "\"Life through death.\" [shadowboon/]"

msgid "STORY_EVENT@1013_1067@BUTTON_7"
msgstr "\"Power through greed.\" [evilact/]"

msgid "STORY_EVENT@1013_1067@BUTTON_8"
msgstr "\"Divinity through majesty.\" [influence/]"

msgid "STORY_EVENT@1013_1067@TITLE"
msgstr "A New Creed: Aftermath"

msgid "STORY_EVENT@1013_1124@BODY_FOOTER"
msgstr "\"We took the liberty of making some tactical decisions to ease your burdens, my {EventHero.Title}! We hope it pleases you!\""

msgid "STORY_EVENT@1013_1124@BODY_HEADER"
msgstr "The siege of {EventCity.Name} is well underway, except for one issue..."

msgid "STORY_EVENT@1013_1124@BODY_LORE"
msgstr "When doing {EventHero.Possessive} rounds around the siege camp, {EventHero.Name} notices some oddities. Armies are wrongly deployed, guards do not patrol critical locations... {EventHero.FirstName} realizes continuing in this way is going to cause problems and will prolong the siege unnecessarily. A commander salutes proudly at {EventHero.PronounObject} approach. \"Greetings, {EventHero.TitleName}!\""

msgid "STORY_EVENT@1013_1124@BUTTON_0"
msgstr "Teach the soldiers about proper siege strategy."

msgid "STORY_EVENT@1013_1124@BUTTON_1"
msgstr "\"Step aside you fools, and never make these decisions without me again.\" [morale/]"

msgid "STORY_EVENT@1013_1124@BUTTON_2"
msgstr "\"Initiative, however foolish, can only be rewarded.\" [morale/]"

msgid "STORY_EVENT@1013_1124@TITLE"
msgstr "Siege \"Masters\""

msgid "STORY_EVENT@1013_1126@BODY_FOOTER"
msgstr "<<g:soldiers^p,EventHero>> have captured fleeing {EventRace.Name} from {EventCity.Name}. What does <<p:EventHero>> do with them?"

msgid "STORY_EVENT@1013_1126@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Your soldiers have captured fleeing nobility from {EventCity.Name}. What do you do with them?"

msgid "STORY_EVENT@1013_1126@BODY_HEADER"
msgstr "During the siege of {EventCity.Name} led by your [hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink] {EventHero.Name}, a group of captured citizens are presented to <<P:EventHero>>."

msgid "STORY_EVENT@1013_1126@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "During the siege of {EventCity.Name}, a group of captured citizens are presented to you."

msgid "STORY_EVENT@1013_1126@BODY_LORE"
msgstr "It's a group of distraught {EventRace.Name} from {EventCity.Name} who tried to escape through the underground sewers. Regardless of their origins, they all look equally bedraggled and scared as they are pushed toward {EventHero.FirstName}. One of <<o:EventHero>> soldiers speaks. \"Our scouts found them, my {EventHero.Title}. We're sure we can get some useful information out of them...\""

msgid "STORY_EVENT@1013_1126@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "It's a group of distraught {EventRace.Name} from {EventCity.Name} who tried to escape through the underground sewers. Regardless of their origins, they all look equally bedraggled and scared as they are pushed toward you. One of your soldiers speaks. \"Our scouts found them, my {PlayerLeader.Title}. We're sure we can get some useful information out of them...\""

msgid "STORY_EVENT@1013_1126@BUTTON_0"
msgstr "\"Question them about possible weaknesses in the city's defenses.\""

msgid "STORY_EVENT@1013_1126@BUTTON_2"
msgstr "\"Kill them and throw their heads over the city wall. That should weaken the resistance.\" [evilact/]"

msgid "STORY_EVENT@1013_1126@BUTTON_3"
msgstr "\"Let them go. These citizens are not our target.\" [goodact/]"

msgid "STORY_EVENT@1013_1126@TITLE"
msgstr "Captured Escapees"

msgid "STORY_EVENT@1013_1127@BODY_FOOTER"
msgstr "The major guilds of {EventCity.Name} plan to hold a parade in your honor, but they cannot decide on the theme."

msgid "STORY_EVENT@1013_1127@BODY_HEADER"
msgstr "You have treated your citizens in {EventCity.Name} well and a parade was organized to celebrate you as their {PlayerLeader.Title}."

msgid "STORY_EVENT@1013_1127@BODY_LORE"
msgstr "During parade preparations, the city's {EventHero.Title} seeks your counsel. \"The guild masters cannot decide on the theme of the parade!\" {EventHero.TitleName} says. \"They all wanted to show off their various skills. I tried reasoning with them, even threatened corporal punishment, but they won't agree. Of course, they will obey you, my {PlayerLeader.Title}...\""

msgid "STORY_EVENT@1013_1127@BUTTON_0"
msgstr "\"The city's guards and soldiers [unitprod/] should be saluted.\""

msgid "STORY_EVENT@1013_1127@BUTTON_1"
msgstr "\"Celebrate our flourishing city and its people!\" [food/]"

msgid "STORY_EVENT@1013_1127@BUTTON_2"
msgstr "\"The artisans [structureprod/] of {EventCity.Name} are its pride and joy.\""

msgid "STORY_EVENT@1013_1127@BUTTON_4"
msgstr "\"We will honor the most virtuous citizens of {EventCity.Name}. [influence/]\""

msgid "STORY_EVENT@1013_1127@BUTTON_5"
msgstr "\"I demand obedience [influence/]. Parade prisoners through the city toward their execution.\""

msgid "STORY_EVENT@1013_1127@TITLE"
msgstr "<<g:Parade^n,PlayerLeader.Title>>"

msgid "STORY_EVENT@1013_1131@BODY_FOOTER"
msgstr "{EventCity.Name} is being overrun by outlaws due to its {GLOBAL.CityStabilityConcept.Hyperlink}. How do you respond?"

msgid "STORY_EVENT@1013_1131@BODY_HEADER"
msgstr "You have neglected your populace of {EventCity.Name}. Now, crime has risen to an all-time high."

msgid "STORY_EVENT@1013_1131@BODY_LORE"
msgstr "Pickpockets roam the streets and thugs raid houses in the night. Shopkeepers have resorted to paying gangs for \"protection,\" but this has led to conflict between city districts. It won't be long before the city falls into rioting and anarchy."

msgid "STORY_EVENT@1013_1131@BUTTON_0"
msgstr "End this anarchy [happiness/] by deploying your full garrison [unitprod/]."

msgid "STORY_EVENT@1013_1131@BUTTON_1"
msgstr "The city doesn't \"fall\" to chaos. It is healed by it!"

msgid "STORY_EVENT@1013_1131@BUTTON_2"
msgstr "Call in support from {PlayerCapital.Name} to help {EventCity.Name} recover. [unitprod/] [gold/] [happiness/]"

msgid "STORY_EVENT@1013_1131@BUTTON_3"
msgstr "Arrest the families of the criminals and execute [population/] them all. [evilact/] [happiness/]"

msgid "STORY_EVENT@1013_1131@BUTTON_4"
msgstr "\"I have no time for this.\""

msgid "STORY_EVENT@1013_1131@TITLE"
msgstr "City of Outlaws"

msgid "STORY_EVENT@1013_1166@BODY_FOOTER"
msgstr "There is no reasoning with {EventNimue}. You can only liberate the realm by defeating her."

msgid "STORY_EVENT@1013_1166@BODY_HEADER"
msgstr "You meet {EventNimue.Name} herself, her eyes seething with hatred and insanity."

msgid "STORY_EVENT@1013_1166@BODY_LORE"
msgstr "\"You! Intruder, trespasser! What are you doing in my realm?! Your ugly, so-called \"{EventRace}\" taint it with imperfection! No matter. You will be easily destroyed by my beloved {EventNimueRace}, and then I will use your essences to empower my people even further! You should be grateful, then you will be a part of true perfection.\""

msgid "STORY_EVENT@1013_1166@BUTTON_0"
msgstr "\"War it is!\""

msgid "STORY_EVENT@1013_1166@TITLE"
msgstr "The {EventNimue.Title}"

msgid "STORY_EVENT@1013_1194@BODY_FOOTER"
msgstr "\"If you truly aim to free us from her, help my people to no longer live in fear. Destroy the infestation and defeat the hunters who threaten us.\""

msgid "STORY_EVENT@1013_1194@BODY_HEADER"
msgstr "{EventPlayerLeader} sighs with relief. \"We have waited so long for a benevolent {GLOBAL.GodirLoreConcept.Hyperlink} to help us.\""

msgid "STORY_EVENT@1013_1194@BODY_LORE"
msgstr "\"Ever since {EventNimue.FirstName} discarded us, we have been living in fear. Her thralls hunt our people as if we were trophies, and the wildlife torments us everywhere we go. I try to convince my people we could grow strong enough to fight back, but their fear is... deep-rooted. Meanwhile monsters close in on us. Soon, there will be no place left for us to flee to.\""

msgid "STORY_EVENT@1013_1194@BUTTON_0"
msgstr "\"I will aid you and your {EventPlayerRace.Name}.\""

msgid "STORY_EVENT@1013_1194@BUTTON_1"
msgstr "\"I have no time for this quest.\""

msgid "STORY_EVENT@1013_1194@TITLE"
msgstr "The {EventPlayerRace.Name}"

msgid "STORY_EVENT@1013_1195@BODY_FOOTER"
msgstr "{EventPlayerLeader.FirstName} rubs <<o:EventPlayerLeader>> temple. \"If you wish to convince me, convince the {EventHouseLord.Title} of {EventHouse.Name} of your good intentions first. I respect <<o:EventHouseLord>> insights.\""

msgid "STORY_EVENT@1013_1195@BODY_HEADER"
msgstr "{EventPlayerLeader} harrumphs. \"You have stories about my goddess? Lies, no doubt...\" <<Cp:EventPlayerLeader>> pauses for a moment. \"Very well, I must respect the rules of negotiation.\""

msgid "STORY_EVENT@1013_1195@BODY_LORE"
msgstr "\"Through my duties, I have met others with whom I share good contacts. Some tell the strangest stories about the goddess' love... turning to wrath. But that can't be! These people, they fell out of the goddess' grace, but I'm sure that's a misunderstanding. She would never truly drown us... Would she?\" <<Cp:EventPlayerLeader>> winces, as <<p:EventPlayerLeader>> is being scolded by something you cannot hear."

msgid "STORY_EVENT@1013_1195@BUTTON_0"
msgstr "\"Very well, {EventPlayerLeader.TitleName}. I will convince <<P:EventHouseLord>>, and you.\""

msgid "STORY_EVENT@1013_1195@BUTTON_2"
msgstr "\"I have no time to mingle with minor cities.\""

msgid "STORY_EVENT@1013_1195@TITLE"
msgstr "Voice of Reason"

msgid "STORY_EVENT@1013_1260@BODY_FOOTER"
msgstr "Returning here with a {GLOBAL.HeroConcept.Hyperlink} will allow you to take over the {EventStructure} peacefully."

msgid "STORY_EVENT@1013_1260@BODY_HEADER"
msgstr "Your army encounters troops from {EventHouse.Name} guarding a {EventStructure.Name}."

msgid "STORY_EVENT@1013_1260@BODY_LORE"
msgstr "The troops, led by a {EventStackLeader}, call out from afar. \"State your intent. Where is your leader? We have orders to speak with no one but true [hyperlink,GLOBAL.HeroConcept]Heroes[/hyperlink].\""

msgid "STORY_EVENT@1013_1260@BUTTON_0"
msgstr "Arrange a diplomatic audience with {EventHouseLord.Name} of {EventHouse.Name}."

msgid "STORY_EVENT@1013_1260@BUTTON_2"
msgstr "Attack! This is the opportunity to strike!"

msgid "STORY_EVENT@1013_1260@BUTTON_3"
msgstr "Disengage and let them be."

msgid "STORY_EVENT@1013_1260@TITLE"
msgstr "{EventHouse.Name} Guards of the {EventStructure.Name}."

msgid "STORY_EVENT@1013_1272@BODY_FOOTER"
msgstr "\"Something here... affects me.\" {Sundren.FirstName} says. \"I do not trust my senses. I will follow your lead, {PlayerLeader.FirstName}. We should find what ails the Eternal Court.\""

msgid "STORY_EVENT@1013_1272@BODY_HEADER"
msgstr "You arrive at the realm called the Eternal Court. Even though the flowers bloom and birds sing, the air feels... stale."

msgid "STORY_EVENT@1013_1272@BODY_LORE"
msgstr "You are joined by {Sundren.TitleName}, who frowns upon arrival. \"This is not how {GLOBAL.AuldwealdLoreConcept.Hyperlink} was described to me. As one of the origin worlds of the Elves, it was to be lush, and grand. Deep down, all Elves long for this world, but...\" <<Cp:Sundren>> suddenly winces and grabs her head. \"I hear... do you hear that? Whispers... Something is very wrong in this realm.\""

msgid "STORY_EVENT@1013_1272@BUTTON_0"
msgstr "\"I will investigate what happened here.\""

msgid "STORY_EVENT@1013_1272@TITLE"
msgstr "The Eternal Court"

msgid "STORY_EVENT@1013_1274@BODY_FOOTER"
msgstr "\"Now, the only task left is to escort {Meandor.TitleName} to Magehaven to meet the Covenant.\""

msgid "STORY_EVENT@1013_1274@BODY_FOOTER@SUNDRENQUEST_NOT"
msgstr "\"I still have unfinished business on this realm. I would ask you to remain here to lend your aid. But... I cannot force you, O {PlayerLeader.Title}.\""

msgid "STORY_EVENT@1013_1274@BODY_HEADER"
msgstr "You have freed the Eternal Court from its curse, thereby saving an important part of {GLOBAL.AuldwealdLoreConcept.Hyperlink} from certain doom."

msgid "STORY_EVENT@1013_1274@BODY_HEADER@SUNDRENQUEST_NOT"
msgstr "You have broken the curse that affected Meandor and the Eternal Court. Before you can escort {Meandor.FirstName} to {GLOBAL.MagehavenLoreConcept.Hyperlink}, however, {Sundren.FirstName} approaches you."

msgid "STORY_EVENT@1013_1274@BODY_LORE"
msgstr "It will take time for the forests of Auldweald to recover, but you made it possible. The {GLOBAL.SoulsLoreConcept.Hyperlink} who were trapped within can now move on to {GLOBAL.TheWellLoreConcept.Hyperlink}, and beyond. {Sundren.TitleName} nods sternly."

msgid "STORY_EVENT@1013_1274@BODY_LORE@SUNDRENQUEST_NOT"
msgstr "\"Congratulations, {PlayerLeader.TitleName}. You have broken the spell on {Meandor.FirstName}, and thereby saved the Eternal Court from its deathly curse. However... I still feel haunted, even now the curse is broken. Perhaps a remnant still lingers... Keeping me here.\""

msgid "STORY_EVENT@1013_1274@BUTTON_0"
msgstr "'Tis good to be a Godir."

msgid "STORY_EVENT@1013_1274@BUTTON_0@SUNDRENQUEST_NOT"
msgstr "Leave her to return to Magehaven, victorious!"

msgid "STORY_EVENT@1013_1274@BUTTON_1"
msgstr "Stay until Sundren has found the source of these voices."

msgid "STORY_EVENT@1013_1274@TITLE"
msgstr "The Eternal Court: Victory"

msgid "STORY_EVENT@1013_1274@TITLE@SUNDRENQUEST_NOT"
msgstr "Unfinished Business"

msgid "STORY_EVENT@1013_1295@BODY_FOOTER"
msgstr "\"I believe {Meandor.FirstName} is afflicted by a powerful spell, and I have located apparitions that seem to be connected to it. However, I cannot properly investigate them myself.\""

msgid "STORY_EVENT@1013_1295@BODY_HEADER"
msgstr "{Melenis.FirstName} laughs scornfully. \"If you wish to change the fate of this realm, you should deal with my husband.\""

msgid "STORY_EVENT@1013_1295@BODY_LORE"
msgstr "\"I ventured here to find him, hoping our reunion would lead to a renewed alliance. But he has become pathetically obsessed with the fate of all {GLOBAL.SoulsLoreConcept.Hyperlink} within the {GLOBAL.AstralSeaLoreConcept.Hyperlink}. Whenever I dare to even come close to his translucent pets, he calls me a \"mortal traitor\" and threatens to attack me. Me! I tried to reason with him, but he pays me no heed. Disappointing.\""

msgid "STORY_EVENT@1013_1295@BUTTON_0"
msgstr "\"I will visit the sources you mention.\""

msgid "STORY_EVENT@1013_1295@BUTTON_2"
msgstr "\"Defeating {Meandor.FirstName} in battle is a better way to solve his affliction!\""

msgid "STORY_EVENT@1013_1295@BUTTON_3"
msgstr "\"If anything afflicts this realm, it is you, Melenis! Prepare for war!\""

msgid "STORY_EVENT@1013_1295@TITLE"
msgstr "Web of Madness"

msgid "STORY_EVENT@1013_1297@BODY_FOOTER"
msgstr "\"A powerful Godir must claim this realm to change its fate. Perhaps.. that Godir should not be me.\""

msgid "STORY_EVENT@1013_1297@BODY_FOOTER@MEANDOR_DEFEATED"
msgstr "His words fade. \"What have I done... In my absence... free the realm from my curse.\""

msgid "STORY_EVENT@1013_1297@BODY_HEADER"
msgstr "By eliminating its sources, you have broken the spell which has kept Meandor occupied for so long. You are contacted by the {Meandor.Title} himself."

msgid "STORY_EVENT@1013_1297@BODY_HEADER@MEANDOR_DEFEATED"
msgstr "By eliminating its sources you have broken the spell which has kept Meandor occupied. Even through the {GLOBAL.AstralVoidLoreConcept.Hyperlink} he manages to contact you."

msgid "STORY_EVENT@1013_1297@BODY_LORE"
msgstr "\"A haze.. is lifting. Did you do this, {PlayerLeader.TitleName}? Perhaps not all who visit are invaders, after all.\"[br/]His gaze drifts toward the ghostly realm around him. \"It seems even I cannot give myself the solace I yearn for. During my... affliction, I have set things in motion that I cannot undo alone. More and more souls will be pulled here.\""

msgid "STORY_EVENT@1013_1297@BODY_LORE@MEANDOR_DEFEATED"
msgstr "\"In the void, I feel a haze is... lifting. Did you do this, {PlayerLeader.TitleName}? I see now that I was... afflicted. I have set things in motion that I cannot undo. Even now... I sense how more and more {GLOBAL.SoulsLoreConcept.Hyperlink} are pulled toward the realm I created. They will soon fall victim to predators from the {GLOBAL.AstralSeaLoreConcept.Hyperlink}...\""

msgid "STORY_EVENT@1013_1297@BUTTON_0"
msgstr "\"Accept your defeat, then, {Meandor.TitleName}, and leave this realm so I can resolve what you caused.\""

msgid "STORY_EVENT@1013_1297@BUTTON_6"
msgstr "\"I propose an alliance. Let us claim this realm and free its souls, together!\""

msgid "STORY_EVENT@1013_1297@BUTTON_7"
msgstr "Leave the {Meandor.Title} to journey through the void for now."

msgid "STORY_EVENT@1013_1297@TITLE"
msgstr "Web of Madness: Aftermath"

msgid "STORY_EVENT@1013_1298@BODY_FOOTER"
msgstr "Meandor's voice booms throughout the realm. \"I will not be left for dead again, I will not let this court fall again. The Eternal Court will remain preserved and silent. Forever!\""

msgid "STORY_EVENT@1013_1298@BODY_HEADER"
msgstr "{Meandor.Name} appears, furious. \"I warned you to leave me be, and yet you insist on disrupting my peace?!\""

msgid "STORY_EVENT@1013_1298@BODY_LORE"
msgstr "\"All you mortals are the same, envious of our superiority. You could not let us live, and now you cannot leave me to mourn. My father was a fool for trusting you the first time you set foot on {GLOBAL.AthlaLoreConcept.Hyperlink}, as was my sister!\""

msgid "STORY_EVENT@1013_1298@BUTTON_0"
msgstr "\"If it takes a war to disrupt this lifeless realm, so be it.\""

msgid "STORY_EVENT@1013_1298@TITLE"
msgstr "Meandor Fights Back"

msgid "STORY_EVENT@1013_1334@BODY_FOOTER"
msgstr "\"Are you here to aid me in this quest for death and oblivion? Or will you join the many cursed {GLOBAL.SoulsLoreConcept.Hyperlink} on this realm?\""

msgid "STORY_EVENT@1013_1334@BODY_HEADER"
msgstr "{Melenis.Name} greets you with a cold smile. \"Ah. Another lost soul, roaming this realm of death and destruction.\""

msgid "STORY_EVENT@1013_1334@BODY_LORE"
msgstr "\"My husband may want to relive his memories, but I cannot sit still while he focuses on the ghosts from his past.\" She sighs, frustrated. \"I will not stop until every [hyperlink,GLOBAL.WorldsWithinLoreConcept]world[/hyperlink] in the {GLOBAL.AstralSeaLoreConcept.Hyperlink} is nothing but dust, stopping the cycle of destruction and creation at the desolation in between. I had hoped my husband would join me, but he is... afflicted.\""

msgid "STORY_EVENT@1013_1334@BODY_LORE@CURSE_BROKEN"
msgstr "\"I will not stop until every realm, every [hyperlink,GLOBAL.WorldsWithinLoreConcept]world[/hyperlink] in the {GLOBAL.AstralSeaLoreConcept.Hyperlink} is nothing but dust, stopping the cycle of destruction and creation at the desolation in between. I ventured here to find my husband {Meandor.FirstName}, hoping our reunion would lead to a renewed alliance. But even now that the curse on my husband is broken, he seems pathetically passive.\""

msgid "STORY_EVENT@1013_1334@BUTTON_1"
msgstr "\"I am here to claim this realm.\""

msgid "STORY_EVENT@1013_1334@BUTTON_2"
msgstr "\"Our goals align, {Melenis.FirstName}. Together, we shall build an empire of bones!\""

msgid "STORY_EVENT@1013_1334@BUTTON_3"
msgstr "\"If anything afflicts this realm, it is you, Melenis! Prepare for war!\""

msgid "STORY_EVENT@1013_1334@TITLE"
msgstr "Meeting {Melenis.Name}"

msgid "STORY_EVENT@1013_1336@BODY_FOOTER"
msgstr "Meandor snarls. \"I am Godir! I raise the dead and command the spirits! How dare you lecture me in my own domain!\""

msgid "STORY_EVENT@1013_1336@BODY_HEADER"
msgstr "You enter the ghostly domain of {Meandor.TitleName}. \"You!\" he says. \"Invader! Tormenter. Why can you not let me be?!\""

msgid "STORY_EVENT@1013_1336@BODY_LORE"
msgstr "Sundren pitches in. “Meandor, Uncle, please. The {GLOBAL.GodirLoreConcept.Hyperlink} of the {GLOBAL.CovenantFactionLoreConcept.Hyperlink} need you... I need you. I do not wish to fight you, but I will if I must. I too know loss, but this is no way to rule. You and your realm lie stagnant… You cannot reverse the past, no matter how much you wish for it.”"

msgid "STORY_EVENT@1013_1336@BUTTON_0"
msgstr "\"You are being tricked, Meandor. There is a curse affecting you.\""

msgid "STORY_EVENT@1013_1336@BUTTON_1"
msgstr "\"There is no use in reasoning with Meandor right now.\""

msgid "STORY_EVENT@1013_1336@TITLE"
msgstr "Domain of the {Meandor.Title}"

msgid "STORY_EVENT@1013_1355@BODY_FOOTER"
msgstr "Meandor rubs his temple, haunted once more. \"No, you are only here to take advantage of my grief. Leave! Leave...\""

msgid "STORY_EVENT@1013_1355@BODY_HEADER"
msgstr "You speak of the curse that affects Meandor. His expression grows more troubled with every word you speak."

msgid "STORY_EVENT@1013_1355@BODY_LORE"
msgstr "\"A... curse?\" He says. \"Impossible, no {GLOBAL.GodirLoreConcept.Hyperlink} could trick me - but... the {GLOBAL.ShadraiFactionLoreConcept.Hyperlink}... Is it because of the Gildercoil? They want to use it - it is a key...\" Invisible strings seem to pull on him, and his expression hardens once more. \"No. I am the {Meandor.Title}, first son of Inioch. You mortals attempt to mislead me and take my rightful throne.\""

msgid "STORY_EVENT@1013_1355@BUTTON_0"
msgstr "\"Casting you into the void will be a mercy, Meandor.\""

msgid "STORY_EVENT@1013_1355@TITLE"
msgstr "Domain of the {Meandor.Title}: Continued"

msgid "STORY_EVENT@1013_1357@BODY_FOOTER"
msgstr "\"I will preserve every soul that arrives here...\" {Meandor.FirstName} does not seem interested in negotiations with you in his current state."

msgid "STORY_EVENT@1013_1357@BODY_HEADER"
msgstr "You meet the Ruler of this realm, the {Meandor.Title} himself. <<Co:Meandor>> gaze is absent; he seems to look right through you."

msgid "STORY_EVENT@1013_1357@BODY_LORE"
msgstr "“So, I meet {PlayerLeader.TitleName}. Are you here to become a part of my Eternal Court? Or are you intruders, here to ransack my realm as Humans did my father’s? All Elves are connected to this world. When they are torn from life, many Elven {GLOBAL.SoulsLoreConcept.Hyperlink} attempt to return here. So many never make it, becoming lost. I will not let that happen again.”"

msgid "STORY_EVENT@1013_1357@BUTTON_0"
msgstr "Continue to listen to his mutterings."

msgid "STORY_EVENT@1013_1357@BUTTON_1"
msgstr "\"There is no reasoning with you. To arms!\""

msgid "STORY_EVENT@1013_1357@BUTTON_2"
msgstr "\"Just stay out of my way.\""

msgid "STORY_EVENT@1013_1357@TITLE"
msgstr "Meeting {Meandor.FirstName}"

msgid "STORY_EVENT@1013_1497@BODY_FOOTER"
msgstr "You could send the lowly {EventHouseLord.TitleName}, one of your [whisperingStone/] Whispering Stones, to start gaining influence over {EventHouse.Name}."

msgid "STORY_EVENT@1013_1497@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} trembles before you, clearly aware of your [hyperlink,GLOBAL.AlignmentConcept]reputation[/hyperlink] in the realm."

msgid "STORY_EVENT@1013_1497@BODY_LORE"
msgstr "\"Salutations, {PlayerLeader.TitleName}. We are... impressed with the methods you use to expand your realm. We {EventHouseRace.Name} humbly ask you to respect our territory and independence nonetheless.\""

msgid "STORY_EVENT@1013_1497@BUTTON_0"
msgstr "\"Let me assess whether {EventHouse.Name} deserves my attention.\""

msgid "STORY_EVENT@1013_1497@BUTTON_2"
msgstr "\"Enjoy your freedom... for now.\""

msgid "STORY_EVENT@1013_1497@TITLE"
msgstr "Meeting Anxious {EventHouse.Name}"

msgid "STORY_EVENT@1013_1498@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} with you."

msgid "STORY_EVENT@1013_1498@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} bows deeply to you, clearly aware of your [hyperlink,GLOBAL.AlignmentConcept]reputation[/hyperlink] in the realm."

msgid "STORY_EVENT@1013_1498@BODY_LORE"
msgstr "\"Greetings, {PlayerLeader.TitleName}! We rarely meet a {PlayerLeader.Title} as [hyperlink,GLOBAL.AlignmentConcept]benevolent[/hyperlink] as you. We are honored to be graced with your glory and hope all {EventHouseRace.Name} will learn from your wisdom.\""

msgid "STORY_EVENT@1013_1498@BUTTON_0"
msgstr "Inspect the reverent city {EventHouse.Name}."

msgid "STORY_EVENT@1013_1498@BUTTON_2"
msgstr "\"Let us speak with each other more in the future.\""

msgid "STORY_EVENT@1013_1498@TITLE"
msgstr "Meeting Humble {EventHouse.Name}"

msgid "STORY_EVENT@1013_1499@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} with you."

msgid "STORY_EVENT@1013_1499@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} greets you with some suspicion."

msgid "STORY_EVENT@1013_1499@BODY_LORE"
msgstr "\"Salutations, {PlayerLeader.TitleName}. Your [hyperlink,GLOBAL.AlignmentConcept]reputation[/hyperlink] precedes you... Forgive us for being wary. We may not share your beliefs, but we ask you to respect <<g:territory^n,EventHouse>> and independence nevertheless.\""

msgid "STORY_EVENT@1013_1499@BUTTON_0"
msgstr "\"Let me assess if puny {EventHouse.Name} is worthy of my attention.\""

msgid "STORY_EVENT@1013_1499@BUTTON_2"
msgstr "\"Enjoy your freedom... for now.\""

msgid "STORY_EVENT@1013_1499@TITLE"
msgstr "Meeting Vigilant {EventHouse.Name}"

msgid "STORY_EVENT@1013_1500@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} with you."

msgid "STORY_EVENT@1013_1500@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} greets you with some reverence."

msgid "STORY_EVENT@1013_1500@BODY_LORE"
msgstr "\"Salutations, {PlayerLeader.TitleName}. Your [hyperlink,GLOBAL.AlignmentConcept]reputation[/hyperlink] precedes you. It gives us hope to meet a {PlayerLeader.Title} who shares our beliefs. We look forward to learning from you, and we trust you to respect <<g:territory^n,EventHouse>> and independence.\""

msgid "STORY_EVENT@1013_1500@BUTTON_0"
msgstr "Inspect {EventHouse.Name}."

msgid "STORY_EVENT@1013_1500@BUTTON_2"
msgstr "\"We will surely encounter each other again in the future.\""

msgid "STORY_EVENT@1013_1500@TITLE"
msgstr "Meeting Kind-Hearted {EventHouse.Name}"

msgid "STORY_EVENT@1013_1501@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} with you."

msgid "STORY_EVENT@1013_1501@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} greets you with a wily smile."

msgid "STORY_EVENT@1013_1501@BODY_LORE"
msgstr "\"Salutations, {PlayerLeader.TitleName}. Your [hyperlink,GLOBAL.AlignmentConcept]reputation[/hyperlink] precedes you. It pleases us to meet a {PlayerLeader.Title} who shares our convictions. Nevertheless, we ask you to respect <<g:independence^n,EventHouse>>.\""

msgid "STORY_EVENT@1013_1501@BUTTON_0"
msgstr "Assess whether the kindred spirits of {EventHouse.Name} are worthy of your attention."

msgid "STORY_EVENT@1013_1501@BUTTON_2"
msgstr "\"Enjoy your independence... for now.\""

msgid "STORY_EVENT@1013_1501@TITLE"
msgstr "Meeting Nefarious {EventHouse.Name}"

msgid "STORY_EVENT@1013_1503@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} with you."

msgid "STORY_EVENT@1013_1503@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} greets you with curiosity."

msgid "STORY_EVENT@1013_1503@BODY_LORE"
msgstr "\"Salutations, {PlayerLeader.TitleName}. Your [hyperlink,GLOBAL.AlignmentConcept]reputation[/hyperlink] precedes you. We may not share your noble convictions, but we trust you will honor <<g:territory^n,EventHouse>> and independence.\""

msgid "STORY_EVENT@1013_1503@BUTTON_0"
msgstr "Inspect {EventHouse.Name}."

msgid "STORY_EVENT@1013_1503@BUTTON_2"
msgstr "\"We will surely encounter each other again in the future.\""

msgid "STORY_EVENT@1013_1503@TITLE"
msgstr "Meeting Neutral {EventHouse.Name}"

msgid "STORY_EVENT@1013_1506@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} with you."

msgid "STORY_EVENT@1013_1506@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} of {EventHouse.Name} greets you with a barely restrained sneer."

msgid "STORY_EVENT@1013_1506@BODY_LORE"
msgstr "\"Well met, {PlayerLeader.Name}. We are well aware of your [hyperlink,GLOBAL.AlignmentConcept]reputation[/hyperlink]. Your type of rule is not one that aligns with our, shall we say, more steely methods. We hope we can coexist without any need for hostilities. {EventHouse.Name} shall stay out of your way, if you would kindly stay out of ours.\""

msgid "STORY_EVENT@1013_1506@BUTTON_0"
msgstr "\"Loathsome as {EventHouse.Name} is, perhaps it can be redeemed.\""

msgid "STORY_EVENT@1013_1506@BUTTON_2"
msgstr "\"Let's go our separate ways... for now.\""

msgid "STORY_EVENT@1013_1506@TITLE"
msgstr "Meeting Odious {EventHouse.Name}"

msgid "STORY_EVENT@1013_1507@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} with you."

msgid "STORY_EVENT@1013_1507@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} of {EventHouse.Name} greets you with restrained disdain."

msgid "STORY_EVENT@1013_1507@BODY_LORE"
msgstr "\"Greetings, {PlayerLeader.Name}. Your [hyperlink,GLOBAL.AlignmentConcept]reputation[/hyperlink] is known far and wide. We admit your \"methods\" vary greatly from our own, so we request you rein in your darker aspirations and respect the sovereignty of {EventHouse.Name}.\""

msgid "STORY_EVENT@1013_1507@BUTTON_0"
msgstr "\"Let's see whether the self-righteous {EventHouse.Name} are worthy of my scrutiny.\""

msgid "STORY_EVENT@1013_1507@BUTTON_2"
msgstr "\"Proceed unharmed... for now.\""

msgid "STORY_EVENT@1013_1507@TITLE"
msgstr "Meeting Righteous {EventHouse.Name}"

msgid "STORY_EVENT@1013_1508@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} with you."

msgid "STORY_EVENT@1013_1508@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} of {EventHouse.Name} greets you with a sage smile."

msgid "STORY_EVENT@1013_1508@BODY_LORE"
msgstr "\"Salutations and greetings, learned {PlayerLeader.Name}. The [hyperlink,GLOBAL.AstralFlowsLoreConcept]astral winds[/hyperlink] whisper far and wide of your presence. We, too, study the arcane arts, though not with anywhere near your storied grasp of the higher mysteries {EventHouse.Name} is here to observe and to learn from. We hope you will extend to us the same level of neighborly neutrality.\""

msgid "STORY_EVENT@1013_1508@BUTTON_0"
msgstr "\"Let's see if the people of {EventHouse.Name} are really so artistically gifted.\""

msgid "STORY_EVENT@1013_1508@BUTTON_2"
msgstr "\"We part as friends... for now.\""

msgid "STORY_EVENT@1013_1508@TITLE"
msgstr "Meeting Scholarly {EventHouse.Name}"

msgid "STORY_EVENT@1013_1512@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} with you."

msgid "STORY_EVENT@1013_1512@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} of {EventHouse.Name} greets you cautiously."

msgid "STORY_EVENT@1013_1512@BODY_LORE"
msgstr "\"Well met, {PlayerLeader.Name}. The {EventHouseRace.Name} of {EventHouse.Name} have heard much of your arcane prowess. In truth, many of us find your people's curiosity somewhat... unsettling. We hope you honor our independence and choice to stay blissfully ignorant of the ways of greater magic.\""

msgid "STORY_EVENT@1013_1512@BUTTON_0"
msgstr "Assess whether the simple-minded folk of {EventHouse.Name} deserve your scrutiny."

msgid "STORY_EVENT@1013_1512@BUTTON_2"
msgstr "\"Enjoy your ignorance... for now.\""

msgid "STORY_EVENT@1013_1512@TITLE"
msgstr "Meeting Skeptical {EventHouse.Name}"

msgid "STORY_EVENT@1013_1513@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} with you."

msgid "STORY_EVENT@1013_1513@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} of {EventHouse.Name} greets you with a sage, vaguely insufferable expression."

msgid "STORY_EVENT@1013_1513@BODY_LORE"
msgstr "\"Salutations, {PlayerLeader.Name}. The {EventHouseRace.Name} of {EventHouse.Name} extend a hopeful wish of mutual neutrality. Our diviners foretold of your presence in these lands! We seek only to further our understanding of the arcane arts and remain amenable to fostering a mutually beneficial relationship with your mighty empire. If we cannot, we hope that we can at least stay out of each other's way.\""

msgid "STORY_EVENT@1013_1513@BUTTON_0"
msgstr "\"I wonder if {EventHouse.Name} with its sage reputation is worth my time.\""

msgid "STORY_EVENT@1013_1513@BUTTON_2"
msgstr "\"Be at peace... for now.\""

msgid "STORY_EVENT@1013_1513@TITLE"
msgstr "Meeting Enigmatic {EventHouse.Name}"

msgid "STORY_EVENT@1013_1514@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} with you."

msgid "STORY_EVENT@1013_1514@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} of {EventHouse.Name} greets you with flashing eyes, a big grin, and a proud stance."

msgid "STORY_EVENT@1013_1514@BODY_LORE"
msgstr "\"Strength and blood! Glory to you, {PlayerLeader.Name}. We {EventHouseRace.Name} of {EventHouse.Name} welcome you to these lands of strife! We look forward to seeing your strength on the battlefield, be it alongside or against you!\""

msgid "STORY_EVENT@1013_1514@BUTTON_0"
msgstr "\"Let me see if the proud {EventHouse.Name} is worthy of my strength.\""

msgid "STORY_EVENT@1013_1514@BUTTON_2"
msgstr "\"Go about your way... for now.\""

msgid "STORY_EVENT@1013_1514@TITLE"
msgstr "Meeting Fierce {EventHouse.Name}"

msgid "STORY_EVENT@1013_1515@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} with you."

msgid "STORY_EVENT@1013_1515@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} of {EventHouse.Name} thumps their chest."

msgid "STORY_EVENT@1013_1515@BODY_LORE"
msgstr "\"Blood and ashes! Watch your step, {PlayerLeader.Name}. You may be a {PlayerLeader.Title}, but we can make even a {GLOBAL.GodirLoreConcept.Hyperlink} bleed! For us, blood and death are constant companions that we readily quaff ale with! Respect us or face the wrath of the {EventHouseRace.Name}!\""

msgid "STORY_EVENT@1013_1515@BUTTON_0"
msgstr "\"Let's see if the folk of {EventHouse.Name} are right to be so confident.\""

msgid "STORY_EVENT@1013_1515@BUTTON_2"
msgstr "\"Peace... for now.\""

msgid "STORY_EVENT@1013_1515@TITLE"
msgstr "Encountering Brash {EventHouse.Name}"

msgid "STORY_EVENT@1013_1516@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} with you."

msgid "STORY_EVENT@1013_1516@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} of {EventHouse.Name} greets you nervously, as if they might invoke your wrath at any given moment."

msgid "STORY_EVENT@1013_1516@BODY_LORE"
msgstr "\"Well met, {PlayerLeader.Name}. We {EventHouseRace.Name} of {EventHouse.Name} have heard many stories about the {GLOBAL.ShadowTrialLoreConcept.Hyperlink} you went through and the power you wield. We hate to imagine what you forsook to earn it. Hopefully, you will curb any potentially power-hungry tendencies as you make your way through these lands.\""

msgid "STORY_EVENT@1013_1516@BUTTON_0"
msgstr "\"Let me see if the people of {EventHouse.Name} are of interest.\""

msgid "STORY_EVENT@1013_1516@BUTTON_2"
msgstr "\"Until we meet again, mortal.\""

msgid "STORY_EVENT@1013_1516@TITLE"
msgstr "Meeting Apprehensive {EventHouse.Name}"

msgid "STORY_EVENT@1013_1517@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} with you."

msgid "STORY_EVENT@1013_1517@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} of {EventHouse.Name} greets you with a small measure of awe."

msgid "STORY_EVENT@1013_1517@BODY_LORE"
msgstr "\"Most valiant {PlayerLeader.Name}, {EventHouse.Name} extends a cautious hand in welcome. Apprehension and excitement steer our words in equal measure. Seldom have we encountered one such as you, risen through the ranks of mortality to [GLOBAL.AscendedChampLoreConcept]champion[/hyperlink] their people! How, one cannot help but wonder, will you endeavor to rule these lands... For good, or for ill?\""

msgid "STORY_EVENT@1013_1517@BUTTON_0"
msgstr "\"Let me see if the people of {EventHouse.Name} are of interest.\""

msgid "STORY_EVENT@1013_1517@BUTTON_2"
msgstr "\"Thank you. That is all, for now.\""

msgid "STORY_EVENT@1013_1517@TITLE"
msgstr "Meeting Inquisitive {EventHouse.Name}"

msgid "STORY_EVENT@1013_1518@BODY_FOOTER"
msgstr "Give the mortal {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} with you."

msgid "STORY_EVENT@1013_1518@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} of {EventHouse.Name} greets you with some curiosity."

msgid "STORY_EVENT@1013_1518@BODY_LORE"
msgstr "\"Legendary {PlayerLeader.Name}! It is rare for {EventHouse.Name} to meet an {GLOBAL.AscendedChampLoreConcept.Hyperlink} like you. Nevertheless, we ask that you respect the territory and independence of {EventHouse.Name}.\""

msgid "STORY_EVENT@1013_1518@BUTTON_0"
msgstr "\"Let me see if the people of {EventHouse.Name} are of interest.\""

msgid "STORY_EVENT@1013_1518@BUTTON_2"
msgstr "\"Thank you. That is all, for now.\""

msgid "STORY_EVENT@1013_1518@TITLE"
msgstr "Meeting Curious {EventHouse.Name}"

msgid "STORY_EVENT@1013_1519@BODY_FOOTER"
msgstr "\"Please, {PlayerLeader.Title}, share some of your wisdom with me so I can pass it on to my people!\""

msgid "STORY_EVENT@1013_1519@BODY_HEADER"
msgstr "{EventHouseLord.Name} of {EventHouse.Name} approaches you regarding a matter of research and philosophy."

msgid "STORY_EVENT@1013_1519@BODY_LORE"
msgstr "\"As a {EventHouseLord.Title} of the {EventHouseRace.Name}, I am expected to write a journal, to be added to our grand library. I have chosen to devote mine to the philosophies of the greatest Godir on the realm. Of course I immediately thought of the greatest {PlayerLeader.Title} in the realm—you! It would be an honor if you would share your ideologies with me.\""

msgid "STORY_EVENT@1013_1519@BUTTON_0"
msgstr "\"Only from destruction can one build anew. [chaosboon/].\""

msgid "STORY_EVENT@1013_1519@BUTTON_1"
msgstr "\"Life is circular. [natureboon/] From ashes we grew, like others from ours.\""

msgid "STORY_EVENT@1013_1519@BUTTON_2"
msgstr "\"Concepts are but writings in the sand until they are materialized. [materiumboon/]\""

msgid "STORY_EVENT@1013_1519@BUTTON_3"
msgstr "\"Only the most righteous and lawful can find salvation. [orderboon/].\""

msgid "STORY_EVENT@1013_1519@BUTTON_4"
msgstr "\"To gain wisdom, we must advance the limits of the known [astralboon/].\""

msgid "STORY_EVENT@1013_1519@BUTTON_6"
msgstr "\"Rulers must remember that benevolence and honor trump all other virtues.\" [goodact/]"

msgid "STORY_EVENT@1013_1519@BUTTON_7"
msgstr "\"Only in death [shadowboon/] can spirit and body reach their individual potential.\""

msgid "STORY_EVENT@1013_1519@BUTTON_8"
msgstr "\"We are defined by the impressions we leave [influence/] on others.\""

msgid "STORY_EVENT@1013_1519@TITLE"
msgstr "Inside the Mind"

msgid "STORY_EVENT@1013_1521@BODY_FOOTER"
msgstr "\"We boast about our feats and achievements,\" {EventHouseLord.TitleName} shouts over the noise. \"Won't you join in?\""

msgid "STORY_EVENT@1013_1521@BODY_HEADER"
msgstr "To celebrate your brotherhood, {EventHouseLord.Name} of {EventHouse.Name} has invited you to a competition—one less bloody than the usual type."

msgid "STORY_EVENT@1013_1521@BODY_LORE"
msgstr "A rowdy crowd has gathered in the great hall of {EventHouse.Name}. Several {EventHouseRace.Name} stand on tables and chairs, waving tankards while yelling battle cries and thumping on wooden furniture. The crowd cheers. A {EventUnit.Name} shows <<o:EventUnit>> scars and loudly boasts about <<o:EventUnit>> latest adventure."

msgid "STORY_EVENT@1013_1521@BUTTON_0"
msgstr "Boast about your vast empire [influence/] and its people."

msgid "STORY_EVENT@1013_1521@BUTTON_1"
msgstr "Boast about the lucrative trade in your empire [gold/]."

msgid "STORY_EVENT@1013_1521@BUTTON_3"
msgstr "Boast about your martial feats and impressive [morale/] armies."

msgid "STORY_EVENT@1013_1521@BUTTON_6"
msgstr "\"I could never compete with the great braggarts of {EventHouse.Name}.\""

msgid "STORY_EVENT@1013_1521@TITLE"
msgstr "Crowing Competition"

msgid "STORY_EVENT@1013_1526@BODY_FOOTER"
msgstr "\"Pray tell, as a {PlayerLeader.Title}, which layer of our society do you think deserves the most appreciation and support?\""

msgid "STORY_EVENT@1013_1526@BODY_HEADER"
msgstr "Your supporter, {EventHouseLord.Name} of {EventHouse.Name}, asks your opinion on a matter of society and civilization."

msgid "STORY_EVENT@1013_1526@BODY_LORE"
msgstr "\"The {EventHouseRace.Name} of {EventHouse.Name} believe in a clear structure of society,\" {EventHouseLord.FirstName} says. \"We, noble Rulers of the land, provide protection to the clergy who provide wisdom, and the peasantry working the fields. We cannot eat our military prowess, and the peasantry will fall to chaos without our rulership.\""

msgid "STORY_EVENT@1013_1526@BUTTON_0"
msgstr "\"Me, of course. I am above all.\""

msgid "STORY_EVENT@1013_1526@BUTTON_1"
msgstr "\"Scholars and priests [knowledge/] are the spiritual core of our domains.\""

msgid "STORY_EVENT@1013_1526@BUTTON_3"
msgstr "\"You noble Lords and Ladies [influence/], who carry the weight of responsibility.\""

msgid "STORY_EVENT@1013_1526@BUTTON_6"
msgstr "\"The peasants and serfs [food/] are the base of all society.\""

msgid "STORY_EVENT@1013_1526@TITLE"
msgstr "A Question of Class"

msgid "STORY_EVENT@1013_1527@BODY_FOOTER"
msgstr "{EventHouseLord.TitleName} offers you an object forged by the smiths of {EventCity.Name} as a gift. Which one do you pick?"

msgid "STORY_EVENT@1013_1527@BODY_HEADER"
msgstr "To celebrate the bonds you forged with {EventHouse.Name}, {EventHouseLord.Name} invites you to visit <<o:EventHouseLord>> craftsmen."

msgid "STORY_EVENT@1013_1527@BODY_LORE"
msgstr "<<Cp:EventHouseLord>> takes you to a street filled with the clamor of forges and smithies. \"We of {EventHouse} believe a soldier is only as good as the quality of their armaments, so we strive for the best.\" {EventHouseLord.TitleName} stops at a shop and gestures at some finely crafted objects. \"We offer you one of our products, {PlayerLeader.Title}, to show our appreciation.\""

msgid "STORY_EVENT@1013_1527@BUTTON_0"
msgstr "The protective {EventItem1.Name} [item/], covered in intricate runes."

msgid "STORY_EVENT@1013_1527@BUTTON_1"
msgstr "The impressive {EventItem3.Name} [item/] that shines in the light of the forge."

msgid "STORY_EVENT@1013_1527@BUTTON_3"
msgstr "The finely crafted {EventItem2.Name} [item/], a worthy prize despite its size."

msgid "STORY_EVENT@1013_1527@BUTTON_6"
msgstr "\"Since you appreciate me so, I accept all three objects [item/].\""

msgid "STORY_EVENT@1013_1527@TITLE"
msgstr "Forging Friendships"

msgid "STORY_EVENT@1013_1528@BODY_FOOTER"
msgstr "{EventHouseLord.Name} offers you one item from the odd auction table. What do you bring to {EventCity.Name}?"

msgid "STORY_EVENT@1013_1528@BODY_HEADER"
msgstr "To celebrate your bond, {EventHouseLord.Name} of {EventHouse.Name} has invited you to an auction."

msgid "STORY_EVENT@1013_1528@BODY_LORE"
msgstr "The grand hall is dark, except for a lit stage where eerie curiosities are displayed. \"Amusing, isn't it?\" {EventHouseLord.TitleName} says. \"Recreation for those burdened with too much power and gold. Of course, lords less... cultured frown upon most of what is sold here. But that is precisely why this so interesting. Tell me, {PlayerLeader.Title}, which of these objects intrigues you?\""

msgid "STORY_EVENT@1013_1528@BUTTON_0"
msgstr "\"The cursed notebook [knowledge/] of the Frozen Hermit, to enhance my library.\""

msgid "STORY_EVENT@1013_1528@BUTTON_1"
msgstr "\"The farmer's head [food/] in a jar, to keep my citizens motivated.\" [evilact/]"

msgid "STORY_EVENT@1013_1528@BUTTON_3"
msgstr "\"The Obsidian Throne [influence/], to impress other Rulers of the realm.\""

msgid "STORY_EVENT@1013_1528@BUTTON_6"
msgstr "\"This dark auction must visit my empire [shadowboon/]. My people will love it.\""

msgid "STORY_EVENT@1013_1528@BUTTON_7"
msgstr "\"The {EventItem.Name} [item/], to dominate the battlefield.\""

msgid "STORY_EVENT@1013_1528@TITLE"
msgstr "Dark Bidding"

msgid "STORY_EVENT@1013_1529@BODY_FOOTER"
msgstr "The \"Children of the {PlayerLeader.Title}\" seek your blessing as they assemble to celebrate their zeal. What do you say?"

msgid "STORY_EVENT@1013_1529@BODY_HEADER"
msgstr "A newly found cult has become very popular among the general populace in your city {EventCity.Name}. They preach in your name."

msgid "STORY_EVENT@1013_1529@BODY_LORE"
msgstr "Followers of this cult have spread across the city, into nearly every industry of the town. The cult preaches a doctrine of hard work and selflessness. The whole movement makes your citizenry very productive. Instead of hoarding their wealth, they seek to share their abundance, out of gratitude to you and because of your benevolence."

msgid "STORY_EVENT@1013_1529@BUTTON_0"
msgstr "\"Raise your tools, my {EventRace.Name}, and build [structureprod/] the future of our empire!\""

msgid "STORY_EVENT@1013_1529@BUTTON_1"
msgstr "\"Honor your scholars [knowledge/], my {EventRace.Name} and write our history!\""

msgid "STORY_EVENT@1013_1529@BUTTON_2"
msgstr "\"Let the people thrive and grow [food/], my {EventRace.Name}!\""

msgid "STORY_EVENT@1013_1529@BUTTON_3"
msgstr "\"Before I was Godir, I was like you. I am not to be worshiped.\" [goodact/]"

msgid "STORY_EVENT@1013_1529@BUTTON_4"
msgstr "\"I may be Godir, but I am not to be worshiped.\" [goodact/]"

msgid "STORY_EVENT@1013_1529@TITLE"
msgstr "Cult of Personality"

msgid "STORY_EVENT@1013_1530@BODY_FOOTER"
msgstr "The Eye of {PlayerLeader.FirstName} rules {EventCity.Name} with an iron fist. They expect you to guide their piercing gaze."

msgid "STORY_EVENT@1013_1530@BODY_HEADER"
msgstr "A new cult called the \"Eye of {PlayerLeader.FirstName}\" has risen in your city {EventCity.Name}."

msgid "STORY_EVENT@1013_1530@BODY_LORE"
msgstr "Followers of this cult have spread across the city. The priests claim you are all-seeing and all-knowing, and thus preach a doctrine of unquestioning submission to you. The whole movement makes your citizenry very obedient, be it out of reverence or out of fear for the cult's punishments. They are known to make \"heretics\" disappear."

msgid "STORY_EVENT@1013_1530@BUTTON_0"
msgstr "\"Build temples and structures [structureprod/] in my name, until your backs break.\""

msgid "STORY_EVENT@1013_1530@BUTTON_1"
msgstr "\"A cult of war [unitprod/]! The strongest may join my glorious conquest.\""

msgid "STORY_EVENT@1013_1530@BUTTON_2"
msgstr "\"As your radiant {PlayerLeader.Title}, relinquish all of your possessions [gold/] to me.\""

msgid "STORY_EVENT@1013_1530@BUTTON_4"
msgstr "\"Let my entire empire know [influence/] that their {PlayerLeader.Title} sees and knows all.\""

msgid "STORY_EVENT@1013_1530@TITLE"
msgstr "The Eye of {PlayerLeader.FirstName}"

msgid "STORY_EVENT@1013_1531@BODY_FOOTER"
msgstr "The guildmaster looks at you. \"Which approach do you prefer, my {PlayerLeader.Title}?\""

msgid "STORY_EVENT@1013_1531@BODY_HEADER"
msgstr "You have treated your citizens in {EventCity.Name} well. Now, the citizens wish to invite the people of {EventHouse.Name} to celebrate."

msgid "STORY_EVENT@1013_1531@BODY_LORE"
msgstr "A local guildmaster titters excitedly. \"We were thinking of organizing a collective festival, my {PlayerLeader.Title}. It seems the {EventHouseRace.Name} of {EventHouse.Name} love our {RandomFood}, and they promised to share one of their delicacies in return. We're planning on musical performances, a grand market, a feast for all... These festivities will be a great opportunity to strengthen our bonds with their city!\""

msgid "STORY_EVENT@1013_1531@BUTTON_0"
msgstr "\"A shared festival with {EventCity.Name} will help us all.\""

msgid "STORY_EVENT@1013_1531@BUTTON_1"
msgstr "\"Invite {EventHouse.Name} and all {EventRace.Name} to celebrate in {EventCity.Name}!\""

msgid "STORY_EVENT@1013_1531@BUTTON_2"
msgstr "\"Festivities for foreigners are unnecessary. We must care for our own.\" [happiness/]"

msgid "STORY_EVENT@1013_1531@BUTTON_4"
msgstr "\"This wealth should flow into the economy [gold/] of {EventCity.Name}!\""

msgid "STORY_EVENT@1013_1531@TITLE"
msgstr "{RandomFood} Festival"

msgid "STORY_EVENT@1013_1554@BODY_FOOTER"
msgstr "\"Your blessing would hallow this celebration, O {PlayerLeader.Title}. Would you share a few words for our fallen brethren?\""

msgid "STORY_EVENT@1013_1554@BODY_HEADER"
msgstr "Your citizens in {EventCity} host a celebration during which they placate the dead so their deceased loved ones may rest peacefully."

msgid "STORY_EVENT@1013_1554@BODY_LORE"
msgstr "A magistrate explains: \"To keep the dead from rising and wreaking havoc, our citizens share stories and happiness during festivities around the city's crypt. That way, the deceased know we're doing fine without them, and they can continue their journey without needing to come back and haunt us.\""

msgid "STORY_EVENT@1013_1554@BUTTON_0"
msgstr "\"Your sacrifice allowed my empire to prosper [influence/]. Enjoy your rest.\""

msgid "STORY_EVENT@1013_1554@BUTTON_1"
msgstr "\"While you rest, others will wake [population/] in your stead.\""

msgid "STORY_EVENT@1013_1554@BUTTON_2"
msgstr "\"Great cities like {EventCity} are built [production/] because of your sacrifice.\""

msgid "STORY_EVENT@1013_1554@BUTTON_4"
msgstr "\"Fear not the rising dead! [shadow/] Witness how useful [unit/] they are.\""

msgid "STORY_EVENT@1013_1554@TITLE"
msgstr "Cadaver's Cavalcade"

msgid "STORY_EVENT@1013_1555@BODY_FOOTER"
msgstr "\"The effects of these so-called Slumber Spores are temporary, but they may help {EventCity.Name} overcome these... challenging times.\""

msgid "STORY_EVENT@1013_1555@BODY_HEADER"
msgstr "You have neglected the needs of your citizens in {EventCity.Name}, causing unrest. An expert apothecary proposes a unique solution..."

msgid "STORY_EVENT@1013_1555@BODY_LORE"
msgstr "<<Cp:EventUnit>> bows and explains with a nasal voice, \"All my life, I've pursued the study of magical fungal infestations that dot this world. I have located one variety whose spores induce a strong sedative effect. If you find it advisable, {PlayerLeader.Title}, one might shower the restless congregations of {EventCity.Name} in these spores.\""

msgid "STORY_EVENT@1013_1555@BUTTON_0"
msgstr "\"Deploy the spores throughout {EventCity.Name} [mana/] to calm its populace.\""

msgid "STORY_EVENT@1013_1555@BUTTON_1"
msgstr "\"Deploy the spores and execute [population/] the sedated troublemakers.\" [evilact/]"

msgid "STORY_EVENT@1013_1555@BUTTON_2"
msgstr "Do not unleash the spores upon your people. Well, not yet..."

msgid "STORY_EVENT@1013_1555@TITLE"
msgstr "Slumber Spores"

msgid "STORY_EVENT@1013_1556@BODY_FOOTER"
msgstr "\"This cannot go on, my {PlayerLeader.Title}. Your city will rot from the inside!\" How will you end the corruption?"

msgid "STORY_EVENT@1013_1556@BODY_HEADER"
msgstr "Corruption rules your city of {EventCity.Name}, its people governed by crooked guards and fraudulent guild masters. A citizen explains the situation to you."

msgid "STORY_EVENT@1013_1556@BODY_LORE"
msgstr "The citizen kneels before you in deference, but speaks with a boldness that increases with every word. \"My {PlayerLeader.Title}, corruption has festered in {EventCity.Name} for far too long. Disease, chaos, and poverty reign in the streets, while the guild leaders buy luxuries. The guards themselves raid our houses and rob us instead of protecting us!\""

msgid "STORY_EVENT@1013_1556@BUTTON_0"
msgstr "Cull the city guard [unitprod/] to weed out their corruption."

msgid "STORY_EVENT@1013_1556@BUTTON_1"
msgstr "Punish the fraudulent guild leaders [gold/] for their missteps."

msgid "STORY_EVENT@1013_1556@BUTTON_2"
msgstr "\"I will deal with the unrest within {EventCity.Name} later.\""

msgid "STORY_EVENT@1013_1556@BUTTON_4"
msgstr "Slow the city's growth [food/] until the corruption is pushed out."

msgid "STORY_EVENT@1013_1556@TITLE"
msgstr "Corruption in {EventCity.Name}"

msgid "STORY_EVENT@1013_1605@BODY_FOOTER"
msgstr "Will you allow the pitiful {EventStackLeader.Name} and other beings to leave this world behind, or will you attack?"

msgid "STORY_EVENT@1013_1605@BODY_HEADER"
msgstr "Your troops engage the {EventStackLeader.Name} and other ethereal entities, but instead of responding, they simply wait, looking confused."

msgid "STORY_EVENT@1013_1605@BODY_LORE"
msgstr "Expressions of despair and turmoil wash over the features of the shimmering beings. Rather than displaying hostility, they seem helpless and bewildered by some unseen plight."

msgid "STORY_EVENT@1013_1605@BUTTON_0"
msgstr "Attack! [evilact/]"

msgid "STORY_EVENT@1013_1605@BUTTON_1"
msgstr "Grant them mercy. [goodact/]"

msgid "STORY_EVENT@1013_1605@BUTTON_2"
msgstr "Transport [mana/] them to the Astral Sea in exchange for eldritch secrets. [knowledge/]"

msgid "STORY_EVENT@1013_1605@TITLE"
msgstr "Low Spirits"

msgid "STORY_EVENT@1013_1611@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} with you."

msgid "STORY_EVENT@1013_1611@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} of {EventHouse.Name} approaches with fanfare."

msgid "STORY_EVENT@1013_1611@BODY_LORE"
msgstr "\"We, the people of {EventHouse.Name} greet you, O {PlayerLeader.TitleName}. You will find here a place of honor, glory, and devotion to chivalry. We anticipate that either peace will be achieved between us because of values we share, or we will engage in glorious combat that the bards will sing of for ages to come.\""

msgid "STORY_EVENT@1013_1611@BUTTON_0"
msgstr "Engage in conversation with these enthusiasts of honor."

msgid "STORY_EVENT@1013_1611@BUTTON_2"
msgstr "Exit discussions at this time."

msgid "STORY_EVENT@1013_1611@TITLE"
msgstr "Meeting Gallant {EventHouse.Name}"

msgid "STORY_EVENT@1013_1612@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} with you."

msgid "STORY_EVENT@1013_1612@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} of {EventHouse.Name} acknowledges you with an elegant curtsy."

msgid "STORY_EVENT@1013_1612@BODY_LORE"
msgstr "\"Hail, great {PlayerLeader.Name}. The people of {EventHouse.Name} greet you, and wish you well. We look forward to introducing you to our arts and culture so that you may taste of our opulence.\""

msgid "STORY_EVENT@1013_1612@BUTTON_0"
msgstr "Discover more of these ethereal beings."

msgid "STORY_EVENT@1013_1612@BUTTON_2"
msgstr "Leave them to their arts and crafts."

msgid "STORY_EVENT@1013_1612@TITLE"
msgstr "Meeting Lavish {EventHouse.Name}"

msgid "STORY_EVENT@1013_1613@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} with you."

msgid "STORY_EVENT@1013_1613@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} of {EventHouse.Name} greets you with a nefarious sneer."

msgid "STORY_EVENT@1013_1613@BODY_LORE"
msgstr "\"Salutations, great and powerful {PlayerLeader.Name}. Please excuse the stench of death you may have noticed before our discussions. This is part and parcel of our dark ways, not an omen of what is to come, now that the people of {EventHouse.Name} have made your acquaintance... unless we are provoked.\""

msgid "STORY_EVENT@1013_1613@BUTTON_0"
msgstr "See if you can find common ground... or put them in the ground."

msgid "STORY_EVENT@1013_1613@BUTTON_2"
msgstr "Take your leave for the time being."

msgid "STORY_EVENT@1013_1613@TITLE"
msgstr "Meeting Spine-Chilling {EventHouse.Name}"

msgid "STORY_EVENT@1013_1629@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} with you."

msgid "STORY_EVENT@1013_1629@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} greets you with a nefarious grin."

msgid "STORY_EVENT@1013_1629@BODY_LORE"
msgstr "\"Salutations, {PlayerLeader.Name}. It's delightful to meet a {PlayerLeader.Title} of our... persuasion. Though we understand a desire to control and even subjugate those beneath us, we ask that you'd allow us,{EventHouse.Name}, to remain independent of your murderous grasp.\""

msgid "STORY_EVENT@1013_1629@BUTTON_0"
msgstr "Investigate your fellow devotee of the darkness."

msgid "STORY_EVENT@1013_1629@BUTTON_2"
msgstr "Withdraw from their evil presence for now..."

msgid "STORY_EVENT@1013_1629@TITLE"
msgstr "Meeting Deathly {EventHouse.Name}"

msgid "STORY_EVENT@1013_1630@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} with you."

msgid "STORY_EVENT@1013_1630@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} greets you with a look of fear."

msgid "STORY_EVENT@1013_1630@BODY_LORE"
msgstr "\"{PlayerLeader.TitleName}... we must admit that your presence fills us with dread, but we acknowledge your magnificence. We are not accustomed to being surrounded by so much death. We hope that there may be a path forward on which we can get to know you, while still remaining in the land of the living.\""

msgid "STORY_EVENT@1013_1630@BUTTON_0"
msgstr "Enter a discussion with these living souls."

msgid "STORY_EVENT@1013_1630@BUTTON_2"
msgstr "Allow them to continue living... for now..."

msgid "STORY_EVENT@1013_1630@TITLE"
msgstr "Meeting Careful {EventHouse.Name}"

msgid "STORY_EVENT@1013_1631@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} with you."

msgid "STORY_EVENT@1013_1631@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} of {EventHouse.Name} greets you with a friendly smile."

msgid "STORY_EVENT@1013_1631@BODY_LORE"
msgstr "\"Welcome and many greetings, {PlayerLeader.TitleName}! It seems we share much, and we look forward to a strong relationship between {EventHouse.Name} and you. Together, we could do great and honorable deeds.\""

msgid "STORY_EVENT@1013_1631@BUTTON_0"
msgstr "Discuss a path forward with your fellow honorable knights."

msgid "STORY_EVENT@1013_1631@BUTTON_2"
msgstr "Retire from these negotiations, with the possibility of returning later."

msgid "STORY_EVENT@1013_1631@TITLE"
msgstr "Meeting Amicable {EventHouse.Name}"

msgid "STORY_EVENT@1013_1632@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} with you."

msgid "STORY_EVENT@1013_1632@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} of {EventHouse.Name} greets you with an intrigued glance."

msgid "STORY_EVENT@1013_1632@BODY_LORE"
msgstr "\"Well met, oh valiant {PlayerLeader.TitleName}. Though our ways differ from your own, your pursuit of glory intrigues us. We hope that we here in {EventHouse.Name} might be able to live in peace as opposed to facing your armies.\""

msgid "STORY_EVENT@1013_1632@BUTTON_0"
msgstr "Discover more of this different society."

msgid "STORY_EVENT@1013_1632@BUTTON_2"
msgstr "Leave them to their ways for the moment..."

msgid "STORY_EVENT@1013_1632@TITLE"
msgstr "Meeting Inquisitive {EventHouse.Name}"

msgid "STORY_EVENT@1013_1633@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} with you."

msgid "STORY_EVENT@1013_1633@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} of {EventHouse.Name} addresses you with a professional formality."

msgid "STORY_EVENT@1013_1633@BODY_LORE"
msgstr "\"Ah! A new potential business partner! It is fantastic to make your acquaintance, {PlayerLeader.Name}. I know that if we cooperate, {EventHouse.Name} can help you build great things... or destroy them.\""

msgid "STORY_EVENT@1013_1633@BUTTON_0"
msgstr "Learn more of these enterprising individuals."

msgid "STORY_EVENT@1013_1633@BUTTON_2"
msgstr "Choose to not engage at this time."

msgid "STORY_EVENT@1013_1633@TITLE"
msgstr "Meeting Productive {EventHouse.Name}"

msgid "STORY_EVENT@1013_1670@BODY_FOOTER"
msgstr "{EventCity.Name} is threatened by a group of creatures from the {GLOBAL.AstralSeaLoreConcept.Hyperlink}, driven by an otherworldly hunger!"

msgid "STORY_EVENT@1013_1670@BODY_HEADER"
msgstr "A {EventSpawner} has emerged near {EventCity.Name}, your city. Creatures spawn forth from it, led by a fearsome {EventStackLeader.Name}."

msgid "STORY_EVENT@1013_1670@BODY_LORE"
msgstr "Originating from the depths of the {GLOBAL.AstralSeaLoreConcept.Hyperlink}, these creatures are driven by a hunger not for flesh, but for the arcane. This craving now drives them toward {EventCity.Name}. Your citizens are terrified, begging you to protect them from these [hyperlink,GLOBAL.AstralMonstersLoreConcept]monsters[/hyperlink] that surpass their capacity of comprehension."

msgid "STORY_EVENT@1013_1670@BUTTON_0"
msgstr "Sacrifice some of your magic [mana/] to satiate their cravings."

msgid "STORY_EVENT@1013_1670@BUTTON_1"
msgstr "Feed them enough [mana/] to put the entire {EventSpawner.Name} to rest."

msgid "STORY_EVENT@1013_1670@BUTTON_2"
msgstr "Use your bond to the Astral Sea to bring these creatures and the {EventSpawner.Name} to rest."

msgid "STORY_EVENT@1013_1670@BUTTON_3"
msgstr "These creatures are no match for <<g:defenses^p,EventCity>>. Let them come."

msgid "STORY_EVENT@1013_1670@TITLE"
msgstr "Monsters Beyond Comprehension"

msgid "STORY_EVENT@1013_1671@BODY_FOOTER"
msgstr "The fearsome {EventStackLeader.Name} has emerged from the {EventSpawner.Name}, <<o:EventStackLeader>> greedy gaze locked on {EventCity.Name}."

msgid "STORY_EVENT@1013_1671@BODY_HEADER"
msgstr "Your citizens in {EventCity.Name} are terrified of a {EventStackLeader.Name} who spawned from the {EventSpawner.Name} nearby and now threatens your domain."

msgid "STORY_EVENT@1013_1671@BODY_LORE"
msgstr "This creature was once a proud mage, traveling through the {GLOBAL.AstralSeaLoreConcept.Hyperlink} to uncover its secrets and treasures. Instead of finding treasures, however, the {EventStackLeader.Name} met with <<o:EventStackLeader>> demise, succumbing to the twisted nature of the sea between worlds. This turned <<P:EventStackLeader>> into a [hyperlink,GLOBAL.LostWizardLoreConcept]monstrosity[/hyperlink]—a being that only lusts for more power, and survives solely upon the knowledge <<p:EventStackLeader>> possessed before."

msgid "STORY_EVENT@1013_1671@BUTTON_0"
msgstr "Call upon the arcane [mana/] to banish the {EventStackLeader.Name} from your lands."

msgid "STORY_EVENT@1013_1671@BUTTON_1"
msgstr "Gather all knowledge [knowledge/] from your empire to banish the {EventStackLeader.Name} and put the {EventSpawner.Name} to rest."

msgid "STORY_EVENT@1013_1671@BUTTON_2"
msgstr "Use your bond to the Astral Sea to banish this creature and put the {EventSpawner.Name} to rest."

msgid "STORY_EVENT@1013_1671@BUTTON_3"
msgstr "This mage has fallen before and <<p:EventStackLeader>> will do so again if <<p:EventStackLeader>> dares to oppose me."

msgid "STORY_EVENT@1013_1671@TITLE"
msgstr "Terror of the Lost"

msgid "STORY_EVENT@1013_1673@BODY_FOOTER"
msgstr "\"Do you accept the terms of my surrender?\""

msgid "STORY_EVENT@1013_1673@BODY_HEADER"
msgstr "\"Peace, {PlayerLeader.TitleName},\" {EventStackLeader.Name} calls out before your troops close in."

msgid "STORY_EVENT@1013_1673@BODY_LORE"
msgstr "\"Your prowess is known to me. I see no victory here. Grant my army mercy, allow them to quit the field unharmed, and I shall surrender myself to your judgment.\" {EventStackLeader.Name} seems both genuine and contrite in <<o:EventStackLeader>> entreaty of mercy."

msgid "STORY_EVENT@1013_1673@BUTTON_0"
msgstr "\"No, you all die!\" [evilact/]"

msgid "STORY_EVENT@1013_1673@BUTTON_1"
msgstr "\"Nay, I grant you all mercy. Take your troops and go.\" [goodact/]"

msgid "STORY_EVENT@1013_1673@BUTTON_2"
msgstr "\"You all live, but {EventStackLeader.FirstName} swears loyalty to me.\" [unit/]"

msgid "STORY_EVENT@1013_1673@BUTTON_3"
msgstr "\"You all live, but {EventStackLeader.FirstName} will be my prisoner.\""

msgid "STORY_EVENT@1013_1673@TITLE"
msgstr "A Heroic Proposition"

msgid "STORY_EVENT@1013_167@BODY_FOOTER"
msgstr "\"We humbly request that you leave the {EventGeo} near {EventCity} for {EventHouse.Name}.\""

msgid "STORY_EVENT@1013_167@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of {EventHouse.Name} approaches you to settle a territorial dispute."

msgid "STORY_EVENT@1013_167@BODY_LORE"
msgstr "\"We of {EventCity.Name} are impressed by the expanse of your {PlayerRace.Name}, {PlayerLeader.TitleName}. Although it now seems that we have a misunderstanding considering one of your possible territorial claims.\" <<Cp:EventHouseLord>> clears <<o:EventHouseLord>> throat. \"My city, {EventHouse.Name}, is rapidly expanding. We need more space for our people. The area in question was claimed by us for that reason.\""

msgid "STORY_EVENT@1013_167@BODY_LORE@RACE_IS_PLAYERRA"
msgstr "\"We of {EventCity.Name} are impressed by your rulership over our brethren {PlayerRace.Name}, {PlayerLeader.TitleName}. Although it now seems that we have a misunderstanding considering one of your possible territorial claims.\" <<Cp:EventHouseLord>> clears <<o:EventHouseLord>> throat. \"My city, {EventHouse.Name}, is rapidly expanding. We need more space for our people. The area in question was claimed by us for that reason.\""

msgid "STORY_EVENT@1013_167@BUTTON_0"
msgstr "\"Very well. <<EventGeo{That/Those}>> {EventGeo} shall be yours.\""

msgid "STORY_EVENT@1013_167@BUTTON_1"
msgstr "\"Thank you for disclosing which area I must claim for my empire.\" [evilact/]"

msgid "STORY_EVENT@1013_167@TITLE"
msgstr "Clash of Claims"

msgid "STORY_EVENT@1013_1687@BODY_FOOTER"
msgstr "<<G:eyes^n,EventHouseLord>> meet yours in sinister anticipation. \"This prisoner's fate is yours to decide, O {PlayerLeader.Title}.\""

msgid "STORY_EVENT@1013_1687@BODY_HEADER"
msgstr "Before negotiations with {EventHouse} resume, {EventHouseLord} greets you. <<Cp:EventHouseLord>> is flanked by two guards holding a malnourished man in chains."

msgid "STORY_EVENT@1013_1687@BODY_LORE"
msgstr "{EventHouseLord.Name} bares <<o:EventHouseLord>> teeth with an unsettling grin. \"To honor your might, I offer you this gift for our mutual entertainment! We caught this miscreant trespassing in my private forest.\" The prisoner scoffs and prepares to object, but a quick punch to the gut from the {EventHouseLord.Title} knocks the wind out of him. The fire in his eyes, however, remains."

msgid "STORY_EVENT@1013_1687@BUTTON_0"
msgstr "\"What madness befalls you? Release [goodact/] this man!\""

msgid "STORY_EVENT@1013_1687@BUTTON_1"
msgstr "\"I'd rather we continue our negotiations.\""

msgid "STORY_EVENT@1013_1687@BUTTON_2"
msgstr "\"Sacrifice [evilact/] him in Urrath's name!\""

msgid "STORY_EVENT@1013_1687@BUTTON_3"
msgstr "\"This outcome is so predictable. True entertainment comes from chaos.\""

msgid "STORY_EVENT@1013_1687@BUTTON_4"
msgstr "\"A fine addition for my army of the damned! [evilact/]\""

msgid "STORY_EVENT@1013_1687@BUTTON_5"
msgstr "\"Greetings, unfortunate trespasser. You decide which foot stays attached. [evilact/]\""

msgid "STORY_EVENT@1013_1687@TITLE"
msgstr "Grim Entertainment"

msgid "STORY_EVENT@1013_168@BODY_FOOTER"
msgstr "\"Please, O {PlayerLeader.Title}, will you share some of your prosperity with my starving city?\""

msgid "STORY_EVENT@1013_168@BODY_HEADER"
msgstr "The kind {EventHouseLord.TitleName} of {EventHouse.Name} appears before you with a gaunt face."

msgid "STORY_EVENT@1013_168@BODY_LORE"
msgstr "\"Noble {PlayerLeader.TitleName}, a dark era has befallen {EventHouse.Name}. My people are famished; the harvests failed and our storehouses lie empty. Mothers can not feed their children, my city guard is mutinous... I fear many of my proud citizens will starve before this sad time is over.\""

msgid "STORY_EVENT@1013_168@BUTTON_0"
msgstr "\"{EventCity.Name} will help you [food/] through this famine.\" [goodact/]"

msgid "STORY_EVENT@1013_168@BUTTON_1"
msgstr "\"{EventCity.Name} will help you [food/]... for a price.\" [gold/]"

msgid "STORY_EVENT@1013_168@BUTTON_2"
msgstr "\"I have nothing to spare for {EventHouse.Name}. [relationLvl-3/] Find another solution.\""

msgid "STORY_EVENT@1013_168@BUTTON_3"
msgstr "\"If your people are starving, they are better off under my care.\""

msgid "STORY_EVENT@1013_168@TITLE"
msgstr "{EventHouse.Name} in Peril"

msgid "STORY_EVENT@1013_1692@BODY_FOOTER"
msgstr "\"With your permission, my {PlayerLeader.Title}, we shall set sail to find these people and their Rulers.\""

msgid "STORY_EVENT@1013_1692@BODY_HEADER"
msgstr "Your <<m:EventUnit>> report interesting sightings from beyond the horizon."

msgid "STORY_EVENT@1013_1692@BODY_LORE"
msgstr "One of them approaches you. \"My {PlayerLeader.Title}, we have seen ships of unknown origin on the western horizon, and trodden underground passages in the east. It seems that some of <<G:creations^m,EventNimue>> have survived her wrath. Perhaps they can even be persuaded to join you on your quest to liberate the realm.\""

msgid "STORY_EVENT@1013_1692@BUTTON_0"
msgstr "\"I shall find these stranded creations.\""

msgid "STORY_EVENT@1013_1692@TITLE"
msgstr "Stranded Creations"

msgid "STORY_EVENT@1013_1698@BODY_FOOTER"
msgstr "The {EventNimue.Title} keeps this realm in a drowning embrace, but resistance slowly spreads. Perhaps others can be convinced to join your cause."

msgid "STORY_EVENT@1013_1698@BODY_HEADER"
msgstr "You have met the other Rulers in this realm, both <<G:stranded creations^m,EventNimue>>. Talk of your arrival spreads across the realm."

msgid "STORY_EVENT@1013_1698@BODY_LORE"
msgstr "Exiles of all kinds flock to your {GLOBAL.ThroneCityConcept}, calling you their savior. They all share the same story: their people were once favored by {EventNimue.FirstName}, but then abandoned when she grew disappointed with them. Disenchanted with their goddess, they flock to you for deliverance."

msgid "STORY_EVENT@1013_1698@BUTTON_0"
msgstr "Allow these exiled people to live in your cities. [population/]"

msgid "STORY_EVENT@1013_1698@BUTTON_1"
msgstr "Dismiss these exiles. You are their liberator, not their caretaker. [influence/]"

msgid "STORY_EVENT@1013_1698@TITLE"
msgstr "Stranded Creations: Aftermath"

msgid "STORY_EVENT@1013_169@BODY_FOOTER"
msgstr "{EventHouse.Name} is unpopular across the realm, rumored to delight in foul \"delicacies.\" Yet, {EventHouseLord.TitleName} asks you to endorse their feast."

msgid "STORY_EVENT@1013_169@BODY_HEADER"
msgstr "Your friend, {EventHouseLord.TitleName} of {EventHouse.Name} is hosting a feast and appears before you, dejected."

msgid "STORY_EVENT@1013_169@BODY_LORE"
msgstr "\"I have a favor to ask, O {PlayerLeader.Title},\" <<p:EventHouseLord>> says, before <<p:EventHouseLord>> takes a deep breath. \"I will host a feast soon, for all the nobles of this realm. I already paid for everything—bards, beverages, and so forth, but so far it seems no one will attend. If a {PlayerLeader.Title} like you would endorse it, however...\""

msgid "STORY_EVENT@1013_169@BUTTON_0"
msgstr "\"Very well. I will endorse you.\" [influence/]"

msgid "STORY_EVENT@1013_169@BUTTON_1"
msgstr "\"You disgust your guests. Why should my reputation suffer alongside yours?\""

msgid "STORY_EVENT@1013_169@BUTTON_2"
msgstr "\"A suitable offering [gold/] would persuade me to vouch for you.\" [influence/]"

msgid "STORY_EVENT@1013_169@TITLE"
msgstr "{EventHouse.Name} Party"

msgid "STORY_EVENT@1013_1705@BODY_FOOTER"
msgstr "{EventPlayerLeader.FirstName} is not so easily convinced, but you have sown the seeds of doubt in <<o:EventPlayerLeader>> faith."

msgid "STORY_EVENT@1013_1705@BODY_FOOTER@WAR_WITH_LOYALIS"
msgstr "{EventPlayerLeader.FirstName} is not so easily convinced, but you have instigated a peace and sown the seeds of doubt in <<o:EventPlayerLeader>> faith."

msgid "STORY_EVENT@1013_1705@BODY_HEADER"
msgstr "Through negotiations with the {EventHouseLord.Title} of {EventHouse}, you have persuaded {EventPlayerLeader} to consider that your goals of stopping {EventNimue.FirstName} may be justified."

msgid "STORY_EVENT@1013_1705@BODY_LORE"
msgstr "{EventPlayerLeader.FirstName} looks distraught. \"{EventHouseLord.TitleName} tells me you are reasonable, but your words, they cannot be true. {EventNimue.FirstName}, she's in my head—whispering still... Did she really drown all those people? Are the stories true? They can't be...\" <<Cp:EventPlayerLeader>> winces once more. \"I need time to think. I thank you, {PlayerLeader.TitleName}, for your efforts.\""

msgid "STORY_EVENT@1013_1705@BODY_LORE@WAR_WITH_LOYALIS"
msgstr "{EventPlayerLeader.FirstName} looks distraught. \"{EventHouseLord.TitleName} tells me you are reasonable, but your words, they cannot be true. {EventNimue.FirstName}, she's in my head—whispering still... Did she really drown all those people? That can't be... I am already at war against you!\" <<Cp:EventPlayerLeader>> winces once more. \"I need time to think. I cannot fight you anymore. Not with the questions I have.\""

msgid "STORY_EVENT@1013_1705@BUTTON_0"
msgstr "\"I only wish for freedom for all who reside in this realm.\" [goodact/]"

msgid "STORY_EVENT@1013_1705@BUTTON_1"
msgstr "Use the confusion of the {EventRace} to lure a few of them to your cause. [evilact/]"

msgid "STORY_EVENT@1013_1705@TITLE"
msgstr "Voice of Reason: Aftermath"

msgid "STORY_EVENT@1013_1709@BODY_FOOTER"
msgstr "\"Leave this realm, intruder! Or you will feel the wrath of our beloved {EventNimue.Title}!\""

msgid "STORY_EVENT@1013_1709@BODY_HEADER"
msgstr "You encounter a group of trackers who were stalking a group of {EventPlayerRace}. They look at you with feverish hatred in their eyes."

msgid "STORY_EVENT@1013_1709@BODY_LORE"
msgstr "It is clear they have been altered by strong magic. These are creations of {EventNimue.FirstName}, doing her dirty work.[br/]\"Intruders,\" the {EventStackLeader} shouts. \"Are you here to stop the {EventNimue.Title} from creating her beloved children? We will never let you! We carry the glorious burden of cleansing the imperfect from this realm. We will prove ourselves worthy of her love!\""

msgid "STORY_EVENT@1013_1709@BUTTON_0"
msgstr "\"Your hunt is over. Surrender or die!\""

msgid "STORY_EVENT@1013_1709@BUTTON_1"
msgstr "Leave these hunters to their task."

msgid "STORY_EVENT@1013_1709@BUTTON_2"
msgstr "Break Nimue's enchantment [mana/] on these thralls, leaving them to realize what they've done."

msgid "STORY_EVENT@1013_1709@TITLE"
msgstr "Hunters of the {EventPlayerRace.Name}"

msgid "STORY_EVENT@1013_170@BODY_FOOTER"
msgstr "{EventHouseLord.TitleName} requests for you to consider peace between you and {EventHouse.Name}."

msgid "STORY_EVENT@1013_170@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of {EventHouse.Name} laments your ongoing war."

msgid "STORY_EVENT@1013_170@BODY_LORE"
msgstr "\"{PlayerLeader.Name},\" <<p:EventHouseLord>> says, \"I have seen the folly of our war. Please, O {PlayerLeader.Title}, would you consider a truce? Hasn't enough blood been spilled over this realm?\""

msgid "STORY_EVENT@1013_170@BUTTON_0"
msgstr "\"You may be right. Let us end the bloodshed.\""

msgid "STORY_EVENT@1013_170@BUTTON_1"
msgstr "\"This war has only just begun, {EventHouseLord.FirstName}.\""

msgid "STORY_EVENT@1013_170@TITLE"
msgstr "Request for Peace"

msgid "STORY_EVENT@1013_1716@BODY_FOOTER"
msgstr "The Covenant urges you to visit the native city of [minorcity/][hyperlink,GLOBAL.IndependentCityConcept]Edendam[/hyperlink] which should be near you. Its people may be of aid for your investigation."

msgid "STORY_EVENT@1013_1716@BODY_HEADER"
msgstr "The voice of an unknown {GLOBAL.GodirLoreConcept.Hyperlink} reaches you from beyond the {GLOBAL.AstralSeaLoreConcept.Hyperlink}. \"{PlayerLeader.TitleName}. The Godir of the {GLOBAL.CovenantFactionLoreConcept.Hyperlink} hope you arrived safely.\""

msgid "STORY_EVENT@1013_1716@BODY_LORE"
msgstr "\"My name is {CovenantRuler.Name}. I was one of the Godir who heard the song of the being called {GLOBAL.ElyaLoreConcept.Hyperlink}. I am glad you volunteered to investigate. We of the Covenant must act upon any call for help, but first we must verify these allegations against {EventNimue.FirstName}.\""

msgid "STORY_EVENT@1013_1716@BUTTON_0"
msgstr "\"Very well, I will do as the Covenant suggests.\""

msgid "STORY_EVENT@1013_1716@TITLE"
msgstr "Call of the Covenant"

msgid "STORY_EVENT@1013_1717@BODY_FOOTER"
msgstr "\"The fate of this realm lies in your hands. For this, the Covenant has decided to lend its knowledge. Ask, {PlayerLeader.TitleName}, and you shall receive.\""

msgid "STORY_EVENT@1013_1717@BODY_HEADER"
msgstr "After reporting the state of the drowned city you encountered, the {GLOBAL.CovenantFactionLoreConcept.Hyperlink} sends an answer."

msgid "STORY_EVENT@1013_1717@BODY_LORE"
msgstr "\"We are deeply saddened to hear about the fate of the city we asked you to visit. It seems the words of {GLOBAL.ElyaLoreConcept.Hyperlink} are true, and that the Water Wizard {EventNimue.FirstName} has drowned these people. This is worse than we thought. We urge you to approach {EventNimue} with the utmost caution.\""

msgid "STORY_EVENT@1013_1717@BUTTON_0"
msgstr "\"Grant me the knowledge to sail the seas, so I may traverse this realm of islands.\""

msgid "STORY_EVENT@1013_1717@BUTTON_1"
msgstr "\"Grant me the knowledge of Expert Seafaring, so I may traverse this realm at unprecedented speeds.\""

msgid "STORY_EVENT@1013_1717@BUTTON_2"
msgstr "\"Grant me the knowledge of Expert Seafaring, so I may traverse this realm at unforeseen speeds.\""

msgid "STORY_EVENT@1013_1717@BUTTON_3"
msgstr "\"My {EventRace.Name} and I require no aid from any other Godir.\" [influence/]"

msgid "STORY_EVENT@1013_1717@TITLE"
msgstr "Call of the Covenant: Aftermath"

msgid "STORY_EVENT@1013_1719@BODY_FOOTER"
msgstr "\"If good {GLOBAL.GodirLoreConcept.Hyperlink} truly exist, please, deliver us from her wrath.\""

msgid "STORY_EVENT@1013_1719@BODY_HEADER"
msgstr "A ruler of an unmet people slowly comes out of hiding, addressing you with gathered courage. \"You.. are not {EventNimue}.\""

msgid "STORY_EVENT@1013_1719@BODY_LORE"
msgstr "\"I am {EventPlayerLeader.Name}, Ruler of the {EventPlayerRace.Name}. Once, we were the goddess' favorites, until she became... disappointed with us. She drowned so many of us when we fled her wrath. We have survived by staying hidden, but her power grows with every creature she builds and drowns. Please, you must stop her, before she catches us.\""

msgid "STORY_EVENT@1013_1719@BUTTON_0"
msgstr "\"Tell me what I can do to help.\""

msgid "STORY_EVENT@1013_1719@BUTTON_1"
msgstr "\"Just stay out of my way.\""

msgid "STORY_EVENT@1013_1719@TITLE"
msgstr "Meeting {EventPlayerLeader.Name}"

msgid "STORY_EVENT@1013_1720@BODY_FOOTER"
msgstr "{EventPlayerLeader.FirstName} sounds desperate. \"The {EventNimue.Title} will love us again!\""

msgid "STORY_EVENT@1013_1720@BODY_HEADER"
msgstr "You meet {EventPlayerLeader.Name} of the {EventPlayerRace.Name}. <<Cp:EventPlayerLeader>> eyes you and puffs up <<o:EventPlayerLeader>> chest."

msgid "STORY_EVENT@1013_1720@BODY_LORE"
msgstr "\"My name was given to me by the {EventNimue.Title} herself! As blessed children of {EventNimue.FirstName} we only aim to please her. Unfortunately, she has deemed us—imperfect. Without her guidance, we have taken it upon ourselves to patrol and protect the realm. I know she will love us again if we prove ourselves worthy.\""

msgid "STORY_EVENT@1013_1720@BUTTON_0"
msgstr "\"Is there anything I can do to convince you of the true nature of your goddess?\""

msgid "STORY_EVENT@1013_1720@BUTTON_1"
msgstr "\"Just stay out of my way.\""

msgid "STORY_EVENT@1013_1720@TITLE"
msgstr "Meeting {EventPlayerLeader.Name}"

msgid "STORY_EVENT@1013_1734@BODY_FOOTER"
msgstr "{EventPlayerLeader.FirstName} sighs and nods. \"Lead us to our freedom, {PlayerLeader.TitleName}.\""

msgid "STORY_EVENT@1013_1734@BODY_HEADER"
msgstr "You have formed an alliance with {EventPlayerLeader.TitleName} of the {EventPlayerRace}. A shrieking voice echoes from the south of the realm."

msgid "STORY_EVENT@1013_1734@BODY_LORE"
msgstr "\"{EventPlayerLeader.FirstName}! You DARE to make alliances with invaders?!\" The voice of {EventNimue.FirstName} shrieks. \"I should have drowned you weaklings when I had the chance! Next time, I will be more thorough!\" [br/]{EventPlayerLeader.TitleName} flinches under the verbal assault, but then <<p:EventPlayerLeader>> straightens <<o:EventPlayerLeader>> back. \"We are not weak. We will no longer run from you, {EventNimue.FirstName}.\" <<Cp:EventPlayerLeader>> says."

msgid "STORY_EVENT@1013_1734@BUTTON_0"
msgstr "\"Together we will bring an end to the terror of the {EventNimue.Title}.\""

msgid "STORY_EVENT@1013_1734@TITLE"
msgstr "Discarded Alliance"

msgid "STORY_EVENT@1013_1742@BODY_FOOTER"
msgstr "{EventPlayerLeader.FirstName} sighs and nods. \"It is my duty to free this realm alongside you. Lead the way, {PlayerLeader.TitleName}.\""

msgid "STORY_EVENT@1013_1742@BODY_HEADER"
msgstr "You have formed an alliance with {EventPlayerLeader.TitleName} of the {EventPlayerRace}. A shrieking voice echoes from the south of the realm."

msgid "STORY_EVENT@1013_1742@BODY_LORE"
msgstr "\"{EventPlayerLeader.FirstName}! You DARE to make alliances with invaders?!\" The voice of {EventNimue.FirstName} shrieks. \"I should have drowned you the first time you disappointed me. My beloved {EventNimueRace} will eradicate you overgrown failures!\" [br/]{EventPlayerLeader.TitleName} straightens <<o:EventPlayerLeader>> back. \"It seems you were right about our goddess, {PlayerLeader.FirstName}.\""

msgid "STORY_EVENT@1013_1742@BUTTON_0"
msgstr "\"Together we will bring an end to the terror of the {EventNimue.Title}.\""

msgid "STORY_EVENT@1013_1742@TITLE"
msgstr "Shifting Loyalty"

msgid "STORY_EVENT@1013_1744@BODY_FOOTER"
msgstr "\"Whoever killed <<P:EventPlayerLeader>>, thank you for doing my dirty work. You will meet the same fate at the hands of the {EventNimue.Title} and her {EventNimueRace}!\""

msgid "STORY_EVENT@1013_1744@BODY_FOOTER@NIMUE_DEFEATED"
msgstr "With {EventPlayerLeader.FirstName} defeated, you are one step closer to victory over the Enchanted Archipelago."

msgid "STORY_EVENT@1013_1744@BODY_HEADER"
msgstr "{EventPlayerLeader} was defeated. <<Co:EventPlayerLeader>> {EventPlayerRace} scatter, terrified."

msgid "STORY_EVENT@1013_1744@BODY_LORE"
msgstr "Cackling laughter reaches your ears. \"So those miscreants are finally dead! Good riddance to them! <<Cp:EventPlayerLeader>> wanted to play {GLOBAL.GodirLoreConcept.Hyperlink}, and now <<o:EventPlayerLeader>> essence will empower my new, better children. Surely, my next experiment will be perfect!\""

msgid "STORY_EVENT@1013_1744@BODY_LORE@NIMUE_DEFEATED"
msgstr "{EventPlayerLeader.TitleName} is cast into the {GLOBAL.AstralVoidLoreConcept.Hyperlink}. Echoing laughter chimes across the realm, as if it were an echo of the fallen {EventNimue.Title}. If anything, <<o:EventNimue>> experiment has failed <<o:EventNimue>> final test... To stand against you."

msgid "STORY_EVENT@1013_1744@BUTTON_0"
msgstr "\"You will be next, {EventNimue.FirstName}.\""

msgid "STORY_EVENT@1013_1744@BUTTON_0@NIMUE_DEFEATED"
msgstr "\"Thus ends the reign of {EventPlayerLeader.Title} {EventPlayerLeader.FirstName}.\""

msgid "STORY_EVENT@1013_1744@TITLE"
msgstr "{EventPlayerLeader} Defeated"

msgid "STORY_EVENT@1013_1745@BODY_FOOTER"
msgstr "\"Whoever killed <<P:EventPlayerLeader>>, thank you for doing my dirty work. You will meet the same fate at the hands of the {EventNimue.Title} and her {EventNimueRace}!\""

msgid "STORY_EVENT@1013_1745@BODY_FOOTER@NIMUE_DEFEATED"
msgstr "With {EventPlayerLeader.FirstName} defeated, you are one step closer to victory over the Enchanted Archipelago."

msgid "STORY_EVENT@1013_1745@BODY_HEADER"
msgstr "{EventPlayerLeader} was defeated. <<o:EventPlayerLeader>> {EventPlayerRace} gather together, fearful but bravely facing {EventNimue.FirstName} herself."

msgid "STORY_EVENT@1013_1745@BODY_HEADER@NIMUE_DEFEATED"
msgstr "{EventPlayerLeader} was defeated. <<Co:EventPlayerLeader>> {EventPlayerRace} gather together, fearful but brave."

msgid "STORY_EVENT@1013_1745@BODY_LORE"
msgstr "Cackling laughter reaches your ears. \"And that is the end of {EventPlayerLeader.TitleName}. <<Cp:EventPlayerLeader>> did not live up to <<o:EventPlayerLeader>> name, did <<p:EventPlayerLeader>>. Of course, I already knew that. <<Cp:EventPlayerLeader>> wanted to play Godir, and now <<o:EventPlayerLeader>> essence will empower my new, better children. Surely, my next experiment will be perfect!\""

msgid "STORY_EVENT@1013_1745@BODY_LORE@NIMUE_DEFEATED"
msgstr "{EventPlayerLeader.TitleName} is cast into the {GLOBAL.AstralVoidLoreConcept.Hyperlink}. Echoing laughter chimes across the realm, as if it were an echo of the fallen {EventNimue.Title}. If anything, <<o:EventNimue>> experiment has failed <<o:EventNimue>> final test... To stand against you."

msgid "STORY_EVENT@1013_1745@BUTTON_0"
msgstr "\"You will be next, {EventNimue.FirstName}.\""

msgid "STORY_EVENT@1013_1745@BUTTON_0@NIMUE_DEFEATED"
msgstr "Thus ends the reign of {EventPlayerLeader.Title} {EventPlayerLeader.FirstName}.\""

msgid "STORY_EVENT@1013_1745@TITLE"
msgstr "{EventPlayerLeader} Defeated"

msgid "STORY_EVENT@1013_1775@BODY_FOOTER"
msgstr "You must claim this realm to stop it from succumbing to the Astral Sea."

msgid "STORY_EVENT@1013_1775@BODY_HEADER"
msgstr "You have defeated {Meandor.TitleName}, the wizard who had altered this world into a realm of ghosts and reminiscence. However..."

msgid "STORY_EVENT@1013_1775@BODY_LORE"
msgstr "The oppressive cloud of death remains. It seems that even Meandor could no longer control the incursion of {GLOBAL.SoulsLoreConcept.Hyperlink} on this realm, which in turn attracts creatures from the {GLOBAL.AstralSeaLoreConcept.Hyperlink}. The veil between {GLOBAL.AuldwealdLoreConcept.Hyperlink} and the Astral Sea grows thinner and thinner..."

msgid "STORY_EVENT@1013_1775@BUTTON_0"
msgstr "This is but one step on the way to victory."

msgid "STORY_EVENT@1013_1775@TITLE"
msgstr "Meandor Defeated"

msgid "STORY_EVENT@1013_1814@BODY_FOOTER"
msgstr "\"All invaders in this realm will be eradicated. This Court will be Eternal.\" The apparition of {Inioch.TitleName} can not be negotiated with."

msgid "STORY_EVENT@1013_1814@BODY_HEADER"
msgstr "You are greeted by an apparition. Once, this was a powerful emperor, but now merely a fragment of his [hyperlink,GLOBAL.SoulsLoreConcept]soul[/hyperlink] is left."

msgid "STORY_EVENT@1013_1814@BODY_LORE"
msgstr "<<Cp:Inioch>> does not seem to notice <<o:Inioch>> own incorporeality. \"You address {Inioch.Name}, {Inioch.Title} of the {IniochRace}, Ruler of the {IniochCity}. I will not allow my throne to be taken, not by [hyperlink,GLOBAL.ArchonsLoreConcept]Archon[/hyperlink] \"law\" nor by lesser mortals. The {GLOBAL.ValleyofWondersLoreConcept.Hyperlink} is mine and mine alone, forever, as is my eternal birthright. All who oppose me are nothing but usurpers.\""

msgid "STORY_EVENT@1013_1814@BUTTON_0"
msgstr "\"So be it.\""

msgid "STORY_EVENT@1013_1814@TITLE"
msgstr "Meeting {Inioch.TitleName}"

msgid "STORY_EVENT@1013_1818@BODY_FOOTER"
msgstr "\"Please, allow me to visit the sources of the voices I keep hearing.\""

msgid "STORY_EVENT@1013_1818@BODY_FOOTER@SARIDAS_MET"
msgstr "\"Please, {PlayerLeader.TitleName}, I beg you to end this torment. The {GLOBAL.SoulsLoreConcept.Hyperlink} of my father and brother must not remain trapped on this realm.\""

msgid "STORY_EVENT@1013_1818@BODY_HEADER"
msgstr "{Sundren.FirstName} approaches you, disturbed. She rubs her temples."

msgid "STORY_EVENT@1013_1818@BODY_LORE"
msgstr "\"The realm, it—whispers to me. I hear voices, of those I thought long lost. They call me. They ask for me... to meet them. I can no longer ignore these voices. Please, {PlayerLeader.TitleName}, I must go to them.\""

msgid "STORY_EVENT@1013_1818@BODY_LORE@SARIDAS_MET"
msgstr "\"My father and brother, their voices keep haunting me. They keep calling for me, calling me—terrible things. They blame me, they want me to join them. I can't—I can't go through the {GLOBAL.ShadowTrialLoreConcept.Hyperlink} again.\""

msgid "STORY_EVENT@1013_1818@BUTTON_0"
msgstr "\"Very well, we shall venture there.\""

msgid "STORY_EVENT@1013_1818@BUTTON_2"
msgstr "\"Focus, Sundren. We have a realm to claim.\""

msgid "STORY_EVENT@1013_1818@TITLE"
msgstr "Dark Losses"

msgid "STORY_EVENT@1013_1819@BODY_FOOTER"
msgstr "\"Now I have freed my brother and father, I feel strengthened in my quest. Thank you, {PlayerLeader.FirstName}. I will not forget this.\""

msgid "STORY_EVENT@1013_1819@BODY_HEADER"
msgstr "{Sundren.Name} breathes deeply after the spirit of her father and brother have faded. She stares into the distance before she speaks."

msgid "STORY_EVENT@1013_1819@BODY_LORE"
msgstr "\"My father and brother died because I could not protect them, and during my {GLOBAL.ShadowTrialLoreConcept.Hyperlink} I have seen dangers even we {GLOBAL.GodirLoreConcept.Hyperlink} can barely comprehend. I must protect those who cannot protect themselves. For this, I must make hard choices, do things others may not understand. And currently that means breaking the curse on my uncle, by any means necessary, so he can lend his aid in turn.\""

msgid "STORY_EVENT@1013_1819@BODY_LORE@CURSE_BROKEN"
msgstr "\"My father and brother died because I could not protect them, and during my {GLOBAL.ShadowTrialLoreConcept.Hyperlink} I have seen dangers even we {GLOBAL.GodirLoreConcept.Hyperlink} can barely comprehend. I must protect those who cannot protect themselves. For this, I must make hard choices, do things others may not understand. This is why I wanted to talk to my uncle. Only he can understand.\""

msgid "STORY_EVENT@1013_1819@BUTTON_0"
msgstr "\"Together, we can free this realm.\""

msgid "STORY_EVENT@1013_1819@BUTTON_0@CURSE_BROKEN"
msgstr "Return to Magehaven with Sundren."

msgid "STORY_EVENT@1013_1819@TITLE"
msgstr "Dark Losses: Aftermath"

msgid "STORY_EVENT@1013_182@BODY_FOOTER"
msgstr "The people of {EventHouseB.Name} seem very eager to help you crush {EventHouse.Name}."

msgid "STORY_EVENT@1013_182@BODY_HEADER"
msgstr "The obliging {EventHouseBLord.TitleName} of {EventHouseB.Name} offers <<o:EventHouseBLord>> help during your war with {EventHouse.Name}."

msgid "STORY_EVENT@1013_182@BODY_LORE"
msgstr "\"Great {PlayerLeader.Name}! It has come to my attention that you have finally seen the true colors of the horrible {EventHouseLord.TitleName} of {EventHouse.Name}. I would like to offer you my finest warriors to aid you in your war.\""

msgid "STORY_EVENT@1013_182@BUTTON_0"
msgstr "Welcome the units [unit/] from {EventHouseB.Name}."

msgid "STORY_EVENT@1013_182@BUTTON_1"
msgstr "Ask them to train [unitprod/] your own soldiers instead."

msgid "STORY_EVENT@1013_182@BUTTON_2"
msgstr "Ask for funds [gold/] for your war chest instead."

msgid "STORY_EVENT@1013_182@TITLE"
msgstr "Enemy of Thine Enemy"

msgid "STORY_EVENT@1013_1836@BODY_FOOTER"
msgstr "\"Now that you know what I am doing here, I must kill you. Meandor must not awaken from the spell I wove.\" "

msgid "STORY_EVENT@1013_1836@BODY_HEADER"
msgstr "{Arachna.TitleName} seems surprised to meet you. \"I should have known this day was coming. You caught me, {PlayerLeader.TitleName}.\" "

msgid "STORY_EVENT@1013_1836@BODY_LORE"
msgstr "\"Let it be known it was not my intention for {Meandor.FirstName} to turn this realm into a well of {GLOBAL.SoulsLoreConcept.Hyperlink}. I merely aimed to keep him... distracted.\"[br/]\n"
"\"Who ordered you to do this?!\" {Sundren.FirstName} demands to know. \"The {GLOBAL.ShadraiFactionLoreConcept.Hyperlink}?!\" [br/]\n"
"{Arachna.FirstName} answers coldly: \"Unlike many others in this web of {GLOBAL.GodirLoreConcept.Hyperlink}, I act on my own volition. I saw a problem and I solved it, for now.\""

msgid "STORY_EVENT@1013_1836@BUTTON_2"
msgstr "\"What spell did you weave?\""

msgid "STORY_EVENT@1013_1836@BUTTON_3"
msgstr "\"Enough talk, Arachna! War it is!\""

msgid "STORY_EVENT@1013_1836@TITLE"
msgstr "Meeting the Spellweaver"

msgid "STORY_EVENT@1013_1838@BODY_FOOTER"
msgstr "{Sundren.FirstName} snarls and {Arachna.FirstName} laughs, an unnerving sound. \"Perhaps Meandor will trap your {GLOBAL.SoulsLoreConcept.Hyperlink} here too, after I defeat you.\""

msgid "STORY_EVENT@1013_1838@BODY_HEADER"
msgstr "{Arachna.FirstName} smiles. \"Tricking the legendary {Meandor.FirstName} was easy, actually. Every {GLOBAL.GodirLoreConcept.Hyperlink} has their strings to pull. I merely weave webs with them.\""

msgid "STORY_EVENT@1013_1838@BODY_LORE"
msgstr "\"I learned {Meandor.FirstName} was snooping around the {GLOBAL.ShadraiFactionLoreConcept.Hyperlink}. But I could not defeat <<P:Meandor>> and even if I did, he would undoubtedly crawl back to {GLOBAL.MagehavenLoreConcept.Hyperlink}. So instead, I used the ghosts of his past to keep him occupied. Have you met them yet? His father, especially, was a challenge, since only a fracture of his soul was roaming Auldweald. But I made do.\""

msgid "STORY_EVENT@1013_1838@BUTTON_2"
msgstr "\"Enough talk, {Arachna.FirstName}! Prepare for battle!\" "

msgid "STORY_EVENT@1013_1838@TITLE"
msgstr "Confession of the Spellweaver"

msgid "STORY_EVENT@1013_1852@BODY_FOOTER"
msgstr "You have defeated {Arachna.TitleName}, breaking a part of the spell which kept {Meandor.Name} occupied. The {GLOBAL.SoulsLoreConcept.Hyperlink} on the realm seem unaffected, however."

msgid "STORY_EVENT@1013_1852@BODY_HEADER"
msgstr "You have defeated {Arachna.TitleName}. Her spiderlings skitter off, chittering in the dark."

msgid "STORY_EVENT@1013_1852@BODY_LORE"
msgstr "{Sundren.FirstName} perks up. \"A part of the pressure on my mind has lifted. The painful memories, the feelings of grief and wrath... They are slowly diminishing. I still feel them, but I can deal with them, now.\" <<p:Sundren>> shivers. \"The whispers remain, though. We must hurry, {PlayerLeader.TitleName}. I fear for the fate of this realm.\""

msgid "STORY_EVENT@1013_1852@BUTTON_0"
msgstr "\"One step closer to victory.\""

msgid "STORY_EVENT@1013_1852@TITLE"
msgstr "The Spellweaver, Defeated"

msgid "STORY_EVENT@1013_1853@BODY_FOOTER"
msgstr "{Arachna.FirstName} laughs, her {ArachnaRace.Name} skittering around her. \"Go forth, my children! Make mother proud!\""

msgid "STORY_EVENT@1013_1853@BODY_HEADER"
msgstr "You enter the domain of {Arachna.TitleName}. It seems a final battle looms."

msgid "STORY_EVENT@1013_1853@BODY_LORE"
msgstr "\"Fighting on the front lines is not my preferred style, {PlayerLeader.FirstName}. I take pride in my more... subtle approaches to conflict. However, as you have entered my domain, you leave me no choice. Let us see if your soul lingers in my web as well!\" "

msgid "STORY_EVENT@1013_1853@BUTTON_0"
msgstr "\"Your days are numbered, Arachna!\""

msgid "STORY_EVENT@1013_1853@TITLE"
msgstr "Domain of the Spellweaver"

msgid "STORY_EVENT@1013_1867@BODY_FOOTER"
msgstr "\"I will not fight you, {EventHero.TitleName}. Remove the threads that bind me to the spell cast by that spindly witch, hiding underground.\""

msgid "STORY_EVENT@1013_1867@BODY_HEADER"
msgstr "{EventHero.Name} enters the tomb dedicated to the Lost Mother, {Eleanor.TitleName}. She herself appears, frustrated."

msgid "STORY_EVENT@1013_1867@BODY_LORE"
msgstr "\"I was an empress, the wife of {Inioch.TitleName}, returning here after giving life to the crown prince of the {GLOBAL.ValleyofWondersLoreConcept.Hyperlink}. Now I am used as a mere pawn to bewitch my very own son! I will not stand for this. I demand that you free my son from this disgrace.\" She gestures and faint lines appear around her, like webbing... or the ropes of a puppeteer."

msgid "STORY_EVENT@1013_1867@BUTTON_0"
msgstr "Use your connection to death and souls to free the soul of {Eleanor.TitleName} from the spell that affects her."

msgid "STORY_EVENT@1013_1867@BUTTON_10"
msgstr "Leave the tomb of the {Eleanor.Title}, until you've gathered enough ({EventCheckStrength}) [hyperlink,GLOBAL.AffinitiesLoreConcept]Affinity[/hyperlink] to break the spell."

msgid "STORY_EVENT@1013_1867@BUTTON_5"
msgstr "Use your mastery of the arcane to reach into the Astral Sea and break the spell."

msgid "STORY_EVENT@1013_1867@BUTTON_6"
msgstr "Use your powers of growth and healing to undo the curse of death, freeing {Eleanor.TitleName}."

msgid "STORY_EVENT@1013_1867@BUTTON_7"
msgstr "Call upon the powers of chaos to destroy this spell with fire and old-fashioned violence."

msgid "STORY_EVENT@1013_1867@BUTTON_8"
msgstr "No curse can withstand holy justice. Invoke your divine powers to break this spell."

msgid "STORY_EVENT@1013_1867@BUTTON_9"
msgstr "Using your powers of matter, pull the webs into the physical realm to break them."

msgid "STORY_EVENT@1013_1867@TITLE"
msgstr "The Lost Mother"

msgid "STORY_EVENT@1013_1868@BODY_FOOTER"
msgstr "\"Before I go, answer the Empress of the {GLOBAL.ValleyofWondersLoreConcept.Hyperlink}. Why are you here, on this realm?\""

msgid "STORY_EVENT@1013_1868@BODY_HEADER"
msgstr "{Eleanor.TitleName} nods as the webs disappear. \"Good. Now I can rest once more.\""

msgid "STORY_EVENT@1013_1868@BODY_LORE"
msgstr "\"My {Meandor.FirstName} visited me often. He has seen so much loss. I fear he even feels guilty for my death, although there is no need. I am at peace. And I am proud to see my child has grown to become even more powerful than Inioch was. Thank you, {PlayerLeader.TitleName}, for granting me, my son, and the {GLOBAL.SoulsLoreConcept.Hyperlink} of our proud Elven homeworld the peace they deserve.\""

msgid "STORY_EVENT@1013_1868@BUTTON_0"
msgstr "\"I am here to save this realm and to release the souls who wander here.\" [goodact/]"

msgid "STORY_EVENT@1013_1868@BUTTON_3"
msgstr "\"I am here to compete with the masters of shadow and death.\" [shadowboon/]"

msgid "STORY_EVENT@1013_1868@BUTTON_4"
msgstr "\"I am here to reshape this realm to my vision.\" [materiumboon/]"

msgid "STORY_EVENT@1013_1868@BUTTON_5"
msgstr "\"I am here to turn this realm into a paradise once more.\" [natureboon/]"

msgid "STORY_EVENT@1013_1868@BUTTON_6"
msgstr "\"I am here to test my mettle and claim this realm through contest!\" [chaosboon/]"

msgid "STORY_EVENT@1013_1868@BUTTON_7"
msgstr "\"Because it is a Godir's duty to protect the realms.\" [orderboon/]"

msgid "STORY_EVENT@1013_1868@BUTTON_8"
msgstr "\"I am here to uncover the many secrets the Astral Sea has to offer.\" [astralboon/]"

msgid "STORY_EVENT@1013_1868@BUTTON_9"
msgstr "\"I am here to claim this world for myself alone.\" [evilact/]"

msgid "STORY_EVENT@1013_1868@TITLE"
msgstr "The Lost Mother: Aftermath"

msgid "STORY_EVENT@1013_1871@BODY_FOOTER"
msgstr "{Meandor.FirstName} pulls in more souls, but with them, other dangers approach from the Astral Sea..."

msgid "STORY_EVENT@1013_1871@BODY_FOOTER@MEANDOR_DEFEATED"
msgstr "A part of the curse that affected Meandor is lifted, but the roaming spirits remain. With them, danger approaches from the {GLOBAL.AstralSeaLoreConcept.Hyperlink}..."

msgid "STORY_EVENT@1013_1871@BODY_FOOTER@QUEST_DONE"
msgstr "\"These visions... What is happening? Is my mind playing tricks on me? What are you doing to me?\" Meandor mutters to himself, confused, as the last part of his curse is broken."

msgid "STORY_EVENT@1013_1871@BODY_HEADER"
msgstr "The fragment of {Inioch.TitleName}, former ruler of the [hyperlink,GLOBAL.AthlaLoreConcept]Athlan[/hyperlink] Elven Court, evaporates into thin air. {Meandor.TitleName} appears before you, seething with rage."

msgid "STORY_EVENT@1013_1871@BODY_HEADER@MEANDOR_DEFEATED"
msgstr "The fragment of {Inioch.TitleName}, former ruler of the [hyperlink,GLOBAL.AthlaLoreConcept]Athlan[/hyperlink] Elven Court, evaporates into thin air."

msgid "STORY_EVENT@1013_1871@BODY_HEADER@QUEST_DONE"
msgstr "The fragment of {Inioch.TitleName}, former Ruler of the [hyperlink,GLOBAL.AthlaLoreConcept]Athlan[/hyperlink] Elven Court, evaporates into thin air. {Meandor.TitleName} appears before you, bewildered."

msgid "STORY_EVENT@1013_1871@BODY_LORE"
msgstr "\"You DARE to attack {Inioch.Title} {Inioch.Name}, my father, in his own court?! I should have known, you are all nothing but treacherous wretches, out to destroy everything beautiful in the cursed {GLOBAL.AstralSeaLoreConcept.Hyperlink}. No matter. I will save all souls of {GLOBAL.AuldwealdLoreConcept.Hyperlink} and the Astral Sea!\" Before you can react, {Meandor.FirstName} raises <<o:Meandor>> arms and pulls in even more {GLOBAL.SoulsLoreConcept.Hyperlink}."

msgid "STORY_EVENT@1013_1871@BODY_LORE@MEANDOR_DEFEATED"
msgstr "With the apparition, a powerful spell cast on this realm seems to weaken. With {Meandor.TitleName} already defeated, many {GLOBAL.SoulsLoreConcept.Hyperlink} sigh a sigh of relief. However, they remain trapped."

msgid "STORY_EVENT@1013_1871@BODY_LORE@QUEST_DONE"
msgstr "\"You DARE to attack Emperor Inioch, my father, in his own court?! You—You are nothing but invaders, out to get the Elven Court--\" he pauses, as the threads from the spell weaken around him. \"I—you... My father...\""

msgid "STORY_EVENT@1013_1871@BUTTON_0"
msgstr "Allow these new dangers to appear."

msgid "STORY_EVENT@1013_1871@BUTTON_1"
msgstr "Use your magical prowess [mana/] to stop the dangers from the Astral Sea from appearing."

msgid "STORY_EVENT@1013_1871@BUTTON_3"
msgstr "End the curse that tormented Meandor."

msgid "STORY_EVENT@1013_1871@TITLE"
msgstr "Defeated {Inioch.TitleName}"

msgid "STORY_EVENT@1013_1873@BODY_FOOTER"
msgstr "\"I believe {Meandor.TitleName} is the cause of all this. His undead consort {Melenis.TitleName} arrived recently and claimed a throne in the south. She may know more.\""

msgid "STORY_EVENT@1013_1873@BODY_HEADER"
msgstr "{ElfSurvivor.FirstName} inhales deeply. \"It all started after {Meandor.TitleName} settled here. He is a savior of many, but I fear he has gone mad.\""

msgid "STORY_EVENT@1013_1873@BODY_LORE"
msgstr "\"When {Meandor.FirstName} arrived in this realm, he was welcomed with open arms, as any Elf would be. However, as time passed he grew more... disturbed. He would mutter about past betrayals and speak to 'people' no-one else saw... But we dared not intervene. Not long after, {GLOBAL.SoulsLoreConcept.Hyperlink} started to roam.\""

msgid "STORY_EVENT@1013_1873@BUTTON_2"
msgstr "\"Thank you, {ElfSurvivor.TitleName}.\""

msgid "STORY_EVENT@1013_1873@TITLE"
msgstr "Curse of the Eternal Court"

msgid "STORY_EVENT@1013_1907@BODY_FOOTER"
msgstr "\"I must protect this realm, every soul. None must leave, all must be preserved. My beloved Elven Court, eternal... as it should be.\""

msgid "STORY_EVENT@1013_1907@BODY_HEADER"
msgstr "Meandor continues. \"There is irony in seeing how mortals rush to their inevitable deaths. So many eternal lives, lost to foolish mortal ambition.\" "

msgid "STORY_EVENT@1013_1907@BODY_LORE"
msgstr "\"My first attempts to bring back the dead were... flawed. It brought back my father, {Inioch.TitleName}, but he was not the same. The undead have their uses, but they lack - soul. The answer was right in front of us. We were using {GLOBAL.SoulsLoreConcept.Hyperlink} as currency, whilst they themselves are the key. I must preserve their souls.\""

msgid "STORY_EVENT@1013_1907@BUTTON_0"
msgstr "\"There is no reasoning with you. To arms!\""

msgid "STORY_EVENT@1013_1907@BUTTON_1"
msgstr "Leave the {Meandor.Title} to his visions... for now."

msgid "STORY_EVENT@1013_1907@TITLE"
msgstr "Mutterings of a Mad {Meandor.Title}"

msgid "STORY_EVENT@1013_191@BODY_FOOTER"
msgstr "It seems as though a band of pyromaniacs have claimed this heap of stone, and are now spending their time setting captured wildlife ablaze."

msgid "STORY_EVENT@1013_191@BODY_HEADER"
msgstr "As {EventHero.Name} approaches the smoking ruins of a once proud castle, <<p:EventHero>> notices a faded sigil above the charred gate."

msgid "STORY_EVENT@1013_191@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "As you approach the smoking ruins of a once proud castle, you notice a faded sigil above the charred gate."

msgid "STORY_EVENT@1013_191@BODY_LORE"
msgstr "Through the ages, this keep has been home to many beasts and vagabonds, leaving it in ruins. {EventHero.FirstName} smells smoke as <<p:EventHero>> enters the gate. A red glow illuminates the corridors close to the courtyard where cackling laughter and fearful screaming can be heard. There {EventHero.Name} sees the dancing shadows of a {EnemyUnit.Name} and <<o:EnemyUnit>> followers. They are setting several pyres ablaze, to which frightened animals are tied."

msgid "STORY_EVENT@1013_191@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Through the ages, this keep has been home to many beasts and vagabonds, leaving it in ruins. You smell smoke as you enter the gate. A red glow illuminates the corridors close to the courtyard where cackling laughter and fearful screaming can be heard. There you see the dancing shadows of a {EnemyUnit.Name} and <<o:EnemyUnit>> followers. They are setting several pyres ablaze, to which frightened animals are tied."

msgid "STORY_EVENT@1013_191@BUTTON_0"
msgstr "Attack the firestarters!"

msgid "STORY_EVENT@1013_191@BUTTON_1"
msgstr "Use your magical prowess [mana/] to protect your army from the blaze before entering."

msgid "STORY_EVENT@1013_191@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "Use your magical prowess [mana/] to protect yourself and your army from the blaze before entering."

msgid "STORY_EVENT@1013_191@BUTTON_2"
msgstr "Leave."

msgid "STORY_EVENT@1013_191@BUTTON_3"
msgstr "Channel water to douse the flames before entering."

msgid "STORY_EVENT@1013_191@TITLE"
msgstr "Smoke and Ruins"

msgid "STORY_EVENT@1013_192@BODY_FOOTER"
msgstr "The {EventItem.Name} you have discovered seems to belong to {EventHouse.Name}."

msgid "STORY_EVENT@1013_192@BODY_FOOTER@NO_HOUSE"
msgstr "The origins of the {EventItem.Name} you have discovered are unknown."

msgid "STORY_EVENT@1013_192@BODY_FOOTER@NO_HOUSE_PLAYERL"
msgstr "The origins of the {EventItem.Name} you have discovered are unknown."

msgid "STORY_EVENT@1013_192@BODY_HEADER"
msgstr "With the pyromaniacs gone, {EventHero.Name} and <<o:EventHero>> companions are free to search the rest of the ruins."

msgid "STORY_EVENT@1013_192@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "With the pyromaniacs gone, you and your companions are free to search the rest of the ruins."

msgid "STORY_EVENT@1013_192@BODY_LORE"
msgstr "<<g:soldiers^p,EventHero>> free the tormented animals, who quickly flee the keep. Upon further inspection, {EventHero.FirstName} notices that the pyromancers left behind stashes of scorched loot throughout the building. Among it {EventHero.FirstName} discovers a {EventItem.Name}, engraved with the same sigil as <<p:EventHero>> saw above the castle gate. It looks very valuable once {EventHero.FirstName} has wiped away the soot."

msgid "STORY_EVENT@1013_192@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Your soldiers free the tormented animals, who quickly flee the keep. Upon further inspection You notice that the pyromancers left behind stashes of scorched loot throughout the building. Among it you discover a {EventItem.Name}, engraved with the same sigil as you saw above the castle gate. It looks very valuable once you have wiped away the soot."

msgid "STORY_EVENT@1013_192@BUTTON_0"
msgstr "Finders, keepers. [item/]"

msgid "STORY_EVENT@1013_192@BUTTON_1"
msgstr "Return the {EventItem.Name} to {EventHouse.Name}."

msgid "STORY_EVENT@1013_192@BUTTON_2"
msgstr "Display the {EventItem.Name} in {EventCity}."

msgid "STORY_EVENT@1013_192@TITLE"
msgstr "Smoke and Ruins: Aftermath"

msgid "STORY_EVENT@1013_193@BODY_FOOTER"
msgstr "\"We are merely traders of a... specific livestock. Are you interested in our merchandise?\""

msgid "STORY_EVENT@1013_193@BODY_HEADER"
msgstr "{EventHero.Name} approaches the castle carefully. It seems abandoned, but distraught voices can be heard from within the castle walls."

msgid "STORY_EVENT@1013_193@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "You approach the castle carefully. It seems abandoned, but distraught voices can be heard from within the castle walls."

msgid "STORY_EVENT@1013_193@BODY_LORE"
msgstr "Inside <<p:EventHero>> notices caged animals and a group of scared captives, bound and guarded by captors led by a {EnemyUnit}. The latter sees {EventHero.FirstName} and bows. \"Ah, a customer!\" <<p:EnemyUnit>> says with a sly grin. \"Welcome to our humble merchant caravan.\""

msgid "STORY_EVENT@1013_193@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Inside, you notice caged animals and a group of scared captives, bound and guarded by captors led by a {EnemyUnit}. The latter sees {EventHero.FirstName} and bows, grinning slyly. \"Ah, a customer!\" <<p:EnemyUnit>> says. \"Welcome to our humble merchant caravan.\""

msgid "STORY_EVENT@1013_193@BUTTON_0"
msgstr "Attack the captors!"

msgid "STORY_EVENT@1013_193@BUTTON_1"
msgstr "\"We will buy [gold/] your stock. All of it.\""

msgid "STORY_EVENT@1013_193@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"I will buy [gold/] your stock. All of it.\""

msgid "STORY_EVENT@1013_193@BUTTON_2"
msgstr "Leave."

msgid "STORY_EVENT@1013_193@BUTTON_3"
msgstr "Destroy the locks on the animals' cages before engaging the captors."

msgid "STORY_EVENT@1013_193@BUTTON_4"
msgstr "\"You had better flee before you invoke the wrath of the spirits haunting this keep!\""

msgid "STORY_EVENT@1013_193@TITLE"
msgstr "Castles and Captives"

msgid "STORY_EVENT@1013_1949@BODY_FOOTER"
msgstr "Sundren whimpers as the spirits beckon her. [br/]\"Join us in death. Join us in eternity. You know you want to.\""

msgid "STORY_EVENT@1013_1949@BODY_HEADER"
msgstr "You meet the ghosts of two regal Elves, ruling the ghostly city of {EventHouse}. {Sundren.FirstName} gasps. \"Father! {Thannis.FirstName}! This... this isn't possible...\""

msgid "STORY_EVENT@1013_1949@BODY_LORE"
msgstr "\"Hello, Sundren,\" the {Saridas.Title} and his son, {Thannis.FirstName} say in unison. \"Daughter, sister. It has been a long time. We have missed you.\" [br/] {Sundren.FirstName} recoils, covering her ears. \"No,\" she begs, \"make it stop...\"[br/]\"You did not save us,\" the two spirits continue, \"when we were betrayed, when we were killed. You were weak, tried to hide your dark side. You can unmask, now. Join us.\""

msgid "STORY_EVENT@1013_1949@BUTTON_3"
msgstr "\"Do not listen to them, Sundren! We must fight to release them from their curse!\""

msgid "STORY_EVENT@1013_1949@TITLE"
msgstr "Dark Losses: Father and Brother"

msgid "STORY_EVENT@1013_194@BODY_FOOTER"
msgstr "The captives from {EventHouse.Name} anxiously await their fate."

msgid "STORY_EVENT@1013_194@BODY_FOOTER@NO_HOUSE"
msgstr "The released captives are grateful for your arrival. How do you proceed?"

msgid "STORY_EVENT@1013_194@BODY_FOOTER@NO_HOUSE_PLAYERL"
msgstr "The released captives are grateful for your arrival. How do you proceed?"

msgid "STORY_EVENT@1013_194@BODY_HEADER"
msgstr "The slavers are gone and the surviving captives gather around {EventHero.FirstName}."

msgid "STORY_EVENT@1013_194@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "The slavers are gone and the surviving captives flock around you appreciatively yet anxiously."

msgid "STORY_EVENT@1013_194@BODY_LORE"
msgstr "From amidst the captives, a {EventUnit} of the {EventRace.Name} steps forward. \"We are civilians under the protection of {EventHouse.Name}.\" <<p:EventUnit>> says. \"We were ambushed on the roads near this castle and brought here... What do you plan to do with us?\""

msgid "STORY_EVENT@1013_194@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "From amidst the captives, a {EventUnit} of the {EventRace.Name} steps forward and bows deeply. \"We are civilians under the protection of {EventHouse.Name}.\" <<p:EventUnit>> says. \"We were ambushed on the roads near this castle and brought here... What do you plan to do with us, {PlayerLeader.Name}?\""

msgid "STORY_EVENT@1013_194@BODY_LORE@NO_HOUSE"
msgstr "From amidst the captives, a {EventUnit} of the {EventRace.Name} steps forward. \"We are civilians under the protection of {EventCity}.\" <<p:EventUnit>> says. \"We were ambushed on the roads near this castle and brought here... We are eternally grateful for the rescue.\""

msgid "STORY_EVENT@1013_194@BODY_LORE@NO_HOUSE_NO_CITY"
msgstr "From amidst the captives, a {EventUnit} of the {EventRace.Name} steps forward. \"We were ambushed on the roads near this castle and brought here... We are eternally grateful for the rescue.\""

msgid "STORY_EVENT@1013_194@BODY_LORE@NO_HOUSE_PLAYERL"
msgstr "From amidst the captives, a {EventUnit} of the {EventRace.Name} steps forward and bows deeply. \"We are civilians under the protection of {EventCity}.\" <<p:EventUnit>> says. \"We were ambushed on the roads near this castle and brought here... We are eternally grateful for the rescue, O {PlayerLeader.Title}!\""

msgid "STORY_EVENT@1013_194@BUTTON_0"
msgstr "Capture the civilians yourself [evilact/], intimidating {EventHouse.Name}. Surprise!"

msgid "STORY_EVENT@1013_194@BUTTON_1"
msgstr "Release the civilians to return to {EventHouse.Name}."

msgid "STORY_EVENT@1013_194@BUTTON_2"
msgstr "\"The soldiers [unitprod/] from {EventCity.Name} will escort you home to {EventHouse.Name}.\" [goodact/]"

msgid "STORY_EVENT@1013_194@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "\"My soldiers [unitprod/] from {EventCity.Name} will escort you home to {EventHouse.Name}.\" [goodact/]"

msgid "STORY_EVENT@1013_194@BUTTON_3"
msgstr "\"Soldiers [unitprod/] from {EventCity.Name} will escort you home.\" [goodact/]"

msgid "STORY_EVENT@1013_194@BUTTON_4"
msgstr "Send the civilians on their way."

msgid "STORY_EVENT@1013_194@TITLE"
msgstr "Castles and Captives: Aftermath"

msgid "STORY_EVENT@1013_1950@BODY_FOOTER"
msgstr "{Sundren.FirstName} embraces her father and brother one last time, before they fade away."

msgid "STORY_EVENT@1013_1950@BODY_HEADER"
msgstr "The ghost of {Saridas.TitleName} is defeated. He and {Thannis.FirstName} appear in front of {Sundren.FirstName} one last time."

msgid "STORY_EVENT@1013_1950@BODY_LORE"
msgstr "\"We can see clearly, now that we are freed from this realm. We are sorry, {Sundren.FirstName}. We did not intend to fight you -this realm, it affects the [hyperlink,GLOBAL.SoulsLoreConcept]soul[/hyperlink]. Thank you for releasing us.\"[br/]{Thannis.FirstName} steps forward. \"We must go now. I see a darkness in you, sister. Do not let it overtake your heart. Honor me by protecting those who cannot protect themselves.\" He smiles.[br/][br/]\"Someday, we will meet again.\""

msgid "STORY_EVENT@1013_1950@BUTTON_0"
msgstr "..."

msgid "STORY_EVENT@1013_1950@TITLE"
msgstr "Bittersweet Goodbyes"

msgid "STORY_EVENT@1013_195@BODY_FOOTER"
msgstr "\"Welcome, intruders!\" {EnemyUnit} grins. \"Have you come to reignite the flames of our passion with your essence?\""

msgid "STORY_EVENT@1013_195@BODY_HEADER"
msgstr "It is said only fools would disturb the eternal bedchambers of <<EnemyUnit{king/queen}>> {EnemyUnit}. This, however, does not stop {EventHero.Name}."

msgid "STORY_EVENT@1013_195@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "It is said only fools would disturb the eternal bedchambers of <<EnemyUnit{king/queen}>> {EnemyUnit}. This, however, does not stop you."

msgid "STORY_EVENT@1013_195@BODY_LORE"
msgstr "In the center of the tomb {EventHero.FirstName} finds a large altar with several preserved corpses draped around a decorated <<EnemyUnit{king/queen}>>, looking like sleeping lovers even after centuries of being buried. Suddenly the decorated corpse stirs and opens <<o:EnemyUnit>> eyes, <<o:EnemyUnit>> undead lovers following suit. Raspy voices echo through the tomb as they arise and beckon {EventHero.FirstName}."

msgid "STORY_EVENT@1013_195@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "In the center of the tomb you find a large altar with several preserved corpses draped around a decorated <<EnemyUnit{king/queen}>>, looking like sleeping lovers even after centuries of being buried. Suddenly the decorated corpse stirs and opens <<o:EnemyUnit>> eyes, <<o:EnemyUnit>> undead lovers following suit. Raspy voices echo through the tomb as they arise and beckon you."

msgid "STORY_EVENT@1013_195@BUTTON_0"
msgstr "\"This debauchery must end! To arms!\""

msgid "STORY_EVENT@1013_195@BUTTON_1"
msgstr "\"I give you the essence of the people [population/] of {EventCity}.\" [evilact/]"

msgid "STORY_EVENT@1013_195@BUTTON_2"
msgstr "Leave."

msgid "STORY_EVENT@1013_195@BUTTON_3"
msgstr "Use your knowledge of the undead to weaken the <<EnemyUnit{king/queen}>> and <<o:EnemyUnit>> companions before attacking."

msgid "STORY_EVENT@1013_195@BUTTON_4"
msgstr "\"You call this passion? Watch me...\""

msgid "STORY_EVENT@1013_195@TITLE"
msgstr "Eternal Bedchambers"

msgid "STORY_EVENT@1013_196@BODY_FOOTER"
msgstr "The lich <<EnemyUnit{king/queen}>> bows. \"I am yours, {EventHero.Name}, as is my wealth. I no longer have need of it.\""

msgid "STORY_EVENT@1013_196@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "The lich <<EnemyUnit{king/queen}>> bows. \"I am yours, o {PlayerLeader.Title}, as is my wealth. I no longer have need of it.\""

msgid "STORY_EVENT@1013_196@BODY_HEADER"
msgstr "{EventHero.Name} has defeated the undead <<EnemyUnit{king/queen}>> and <<o:EnemyUnit>> lovers. The <<EnemyUnit{king/queen}>> rises once more and claps <<o:EnemyUnit>> hands, impressed."

msgid "STORY_EVENT@1013_196@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "You have defeated the undead <<EnemyUnit{king/queen}>> and <<o:EnemyUnit>> lovers. The <<EnemyUnit{king/queen}>> rises once more and claps <<o:EnemyUnit>> hands, impressed."

msgid "STORY_EVENT@1013_196@BODY_LORE"
msgstr "<<Co:EnemyUnit>> raspy voice once again echoes through the {EventStructure.Name}. \"You have impressed me, <<EventHero{hero/heroine}>>. Not many are able to do so. You have ignited passions within me I had long forgotten. For that, I wish to thank you.\""

msgid "STORY_EVENT@1013_196@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "<<Co:EnemyUnit>> raspy voice once again echoes through the {EventStructure.Name}. \"You have impressed me, {PlayerLeader.TitleName}. Not many are able to do so. You have ignited passions within me I had long forgotten. For that, I wish to thank you.\""

msgid "STORY_EVENT@1013_196@BUTTON_0"
msgstr "Take <<o:EnemyUnit>> {EventItem} and leave the undead <<EnemyUnit{king/queen}>>."

msgid "STORY_EVENT@1013_196@BUTTON_1"
msgstr "\"Rest now forever, {EnemyUnit.Name}. That is all I can ask.\" [goodact/]"

msgid "STORY_EVENT@1013_196@BUTTON_2"
msgstr "Recruit {EnemyUnit.Name} [unit/] later."

msgid "STORY_EVENT@1013_196@BUTTON_3"
msgstr "Ask {EnemyUnit} to share <<o:EnemyUnit>> ancient knowledge [knowledge/] before leaving <<P:EnemyUnit>> to rest."

msgid "STORY_EVENT@1013_196@BUTTON_4"
msgstr "Recruit {EnemyUnit.Name}. [unit/]"

msgid "STORY_EVENT@1013_196@TITLE"
msgstr "Eternal Bedchambers: Aftermath"

msgid "STORY_EVENT@1013_1980@BODY_FOOTER"
msgstr "\"I have tried to investigate, but I could not venture far. Nevertheless, I will share everything I know.\""

msgid "STORY_EVENT@1013_1980@BODY_HEADER"
msgstr "You meet {ElfSurvivor.TitleName}, who leads what seems to be the few remaining living souls on this realm. \"Thank the Allfather for your arrival, {PlayerLeader.TitleName}!\""

msgid "STORY_EVENT@1013_1980@BODY_LORE"
msgstr "\"The Eternal Court, this realm on our beloved homeworld, was once a beautiful place,\" {ElfSurvivor.FirstName} laments. \"Now, a terrible curse has taken it. {GLOBAL.SoulsLoreConcept.Hyperlink} of the dead roam like the living. Many who lived here either fled or perished themselves, their souls unable to move on. Something - or someone, is keeping them here.\""

msgid "STORY_EVENT@1013_1980@BUTTON_0"
msgstr "\"Go on...\""

msgid "STORY_EVENT@1013_1980@TITLE"
msgstr "Meeting the Elves of Auldweald"

msgid "STORY_EVENT@1013_1993@BODY_FOOTER"
msgstr "\"Nothing you can say can convince me now. This is war, {PlayerLeader.TitleName}.\""

msgid "STORY_EVENT@1013_1993@BODY_HEADER"
msgstr "{EventPlayerLeader} harrumphs. \"You wage war against the fair <<m:{GLOBAL.IndependentCityConcept.Hyperlink}>> in this realm and now claim my goddess is the evil one?!\""

msgid "STORY_EVENT@1013_1993@BODY_LORE"
msgstr "<<Cp:EventPlayerLeader>> grinds <<o:EventPlayerLeader>> teeth. \"I must respect the rules of negotiation, so I will not strike you down where you stand. You chose to defeat the {GLOBAL.IndependentCityConcept.Hyperlink} I was sworn to protect. Nothing you say about the {EventNimue.Title} can convince me. I grant you this chance of leaving, or to gather your armies.\""

msgid "STORY_EVENT@1013_1993@BUTTON_0"
msgstr "\"So be it.\""

msgid "STORY_EVENT@1013_1993@TITLE"
msgstr "Too Late for Reason"

msgid "STORY_EVENT@1013_1994@BODY_FOOTER"
msgstr "{EventRuler.TitleName} offers <<o:EventRuler>> aid as a [hyperlink,GLOBAL.HeroConcept]<<EventRuler{hero/heroine}>>[/hyperlink] under your command in this realm! Do you accept?"

msgid "STORY_EVENT@1013_1994@BODY_HEADER"
msgstr "You receive a message from {EventRuler.TitleName}, sent through the far currents of the Astral Sea."

msgid "STORY_EVENT@1013_1994@BODY_LORE"
msgstr "\"{PlayerLeader.TitleName}, I received word about your campaign in this realm. I am impressed by your efforts and hereby formally offer my aid. Allow me to fight as your [hyperlink,GLOBAL.HeroConcept]<<EventRuler{hero/heroine}>>[/hyperlink]. Together we shall claim this realm and show all {GLOBAL.GodirLoreConcept.Hyperlink} the power of our {GLOBAL.PantheonLoreConcept.Hyperlink}!\""

msgid "STORY_EVENT@1013_1994@BUTTON_0"
msgstr "\"I welcome your aid, {EventRuler.TitleName}!\" [unit/]"

msgid "STORY_EVENT@1013_1994@BUTTON_1"
msgstr "Currently, I cannot accommodate your arrival, but I will welcome your aid in the future. {EventRuler.TitleName}.\""

msgid "STORY_EVENT@1013_1994@BUTTON_2"
msgstr "\"I do not need for help from other Godir at this moment.\""

msgid "STORY_EVENT@1013_1994@TITLE"
msgstr "A Godir's Aid"

msgid "STORY_EVENT@1013_1999@BODY_FOOTER"
msgstr "Will you commit to building more <<m:{GLOBAL.FarmConcept.Hyperlink}>> per the proposal of the {EventRace.Name}?"

msgid "STORY_EVENT@1013_1999@BODY_HEADER"
msgstr "The {EventRace.Name} Council sends their chief deputy to meet you with a request."

msgid "STORY_EVENT@1013_1999@BODY_LORE"
msgstr "The deputy bows deeply before <<p:EventUnit>> speaks. \"If the {EventRace.Name} are to be victorious in this realm, we need to grow our borders, expand our cities... feed our people. In order to do so, your Council proposes to claim more farmland. Your empire will grow and your people will be grateful.\""

msgid "STORY_EVENT@1013_1999@BUTTON_0"
msgstr "\"Very well. I shall see to it that more farmland is cultivated.\""

msgid "STORY_EVENT@1013_1999@BUTTON_1"
msgstr "\"Wanton expansion is not the only path toward victory. Soon, you will learn.\""

msgid "STORY_EVENT@1013_1999@BUTTON_2"
msgstr "\"Satisfaction only leads to meekness. I need my people hungry, ready to fight [unitprod/] for their next meal!\""

msgid "STORY_EVENT@1013_1999@TITLE"
msgstr "Quest for Cultivation"

msgid "STORY_EVENT@1013_199@BODY_FOOTER"
msgstr "{EventHouseLord.TitleName} requests the release of {EventHero.Name} from your prison."

msgid "STORY_EVENT@1013_199@BODY_HEADER"
msgstr "You receive a plea from {EventHouse.Name} regarding their imprisoned hero {EventHero.Name}."

msgid "STORY_EVENT@1013_199@BODY_LORE"
msgstr "\"We know you hold {EventHero.Name} captive. We may just be one city compared to your grand empire, but {EventHero.FirstName} is a great [hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink], an example to our city and all {EventRace.Name}. <<Cp:EventHero>> should not languish in a prison cell. Do the honorable thing. Allow {EventHero.FirstName} to return to <<o:EventHero>> people.\" "

msgid "STORY_EVENT@1013_199@BUTTON_0"
msgstr "Release {EventHero.FirstName}."

msgid "STORY_EVENT@1013_199@BUTTON_1"
msgstr "Demand a ransom [gold/] before releasing {EventHero.FirstName}."

msgid "STORY_EVENT@1013_199@BUTTON_2"
msgstr "Reject the request to release {EventHero.FirstName}."

msgid "STORY_EVENT@1013_199@BUTTON_3"
msgstr "\"You appeal to my honor? {EventHero.Name} will die for your insolence! [evilact/]\""

msgid "STORY_EVENT@1013_199@TITLE"
msgstr "Let <<P:EventHero>> Go"

msgid "STORY_EVENT@1013_2000@BODY_FOOTER"
msgstr "Your people are grateful for this prosperity and gather to hear your wisdom. What message do you proclaim to your {EventRace.Name}?"

msgid "STORY_EVENT@1013_2000@BODY_HEADER"
msgstr "The first sowing of the season has passed, and returned to you a pleased {EventRace.Name} Council deputy."

msgid "STORY_EVENT@1013_2000@BODY_LORE"
msgstr "\"A grand day for the {EventRace.Name}!\" The deputy proclaims. \"With this new farmland our people thrive and our cities will expand greatly. Your wisdom truly knows no bounds, {PlayerLeader.Title}. The Council of the {EventRace.Name} is grateful.\""

msgid "STORY_EVENT@1013_2000@BUTTON_0"
msgstr "\"Nurture the crops [food/] that I have given you.\""

msgid "STORY_EVENT@1013_2000@BUTTON_1"
msgstr "\"Magic is what drives us. Bring offerings to the spirits [mana/] of the land.\""

msgid "STORY_EVENT@1013_2000@BUTTON_3"
msgstr "\"True honor for the {EventRace.Name} lies in military service.\" [unitprod/]"

msgid "STORY_EVENT@1013_2000@TITLE"
msgstr "Quest for Cultivation: Aftermath"

msgid "STORY_EVENT@1013_2002@BODY_FOOTER"
msgstr "\"Give us what we want, and we will remember your generosity the next time the winds and tides bring us to {EventCity.Name}.\""

msgid "STORY_EVENT@1013_2002@BODY_HEADER"
msgstr "Dreaded pirates from an {EventSpawner} are intruding in your domain near {EventCity.Name}! They demand a parlay."

msgid "STORY_EVENT@1013_2002@BODY_LORE"
msgstr "Their captain, a {EventStackLeader.Name}, greets you. \"Greetings, {PlayerLeader.TitleName}. We are proud sailors, we travel the sea and take what we want with her blessing. And now her benevolent tides have brought us to the shores of your fine city of {EventCity.Name}, with the promise of gold... Of course, there is no need for violence, if we can come to an agreement.\""

msgid "STORY_EVENT@1013_2002@BUTTON_0"
msgstr "Pay [gold/] the pirates so they leave {EventCity.Name}."

msgid "STORY_EVENT@1013_2002@BUTTON_1"
msgstr "Offer enough gold [gold/] to appease the {EventSpawner.Name} for a while."

msgid "STORY_EVENT@1013_2002@BUTTON_2"
msgstr "\"You are nothing more than brigands on boats. Your ships will break on the shores of {EventCity.Name}.\""

msgid "STORY_EVENT@1013_2002@BUTTON_3"
msgstr "\"I have a better offer. Become my privateers [influence/] and enjoy the luxuries of looting under my banner!\""

msgid "STORY_EVENT@1013_2002@TITLE"
msgstr "Benevolent Tides"

msgid "STORY_EVENT@1013_2003@BODY_FOOTER"
msgstr "\"Perhaps, together, we can convince <<P:EventPlayerLeader>> of Nimue's true nature... If you prove yourself to be truly different from her.\""

msgid "STORY_EVENT@1013_2003@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} of {EventHouse.Name} greets you. \"I must admit, I am happy to meet you. Did {EventPlayerLeader.FirstName} send you?\""

msgid "STORY_EVENT@1013_2003@BODY_LORE"
msgstr "\"I am an old friend of {EventPlayerLeader.TitleName} and one of <<o:EventPlayerLeader>> most trusted advisors. We have supported each other through many hardships, including the moment when {EventNimue.FirstName} first discarded my people, and soon after, <<o:EventPlayerLeader>>... Although {EventPlayerLeader.FirstName} still denies the truth. Myself-- I had my time to grieve. Now, I merely wish for the freedom of the people on this realm.\""

msgid "STORY_EVENT@1013_2003@BUTTON_0"
msgstr "Enter negotiations with {EventHouse.Name}."

msgid "STORY_EVENT@1013_2003@BUTTON_2"
msgstr "Leave them to their survival."

msgid "STORY_EVENT@1013_2003@TITLE"
msgstr "Meeting {EventHouse}, Voice Of Reason"

msgid "STORY_EVENT@1013_200@BODY_FOOTER"
msgstr "{EventHero.FirstName} desperately pleads to be released from your prison."

msgid "STORY_EVENT@1013_200@BODY_HEADER"
msgstr "Prison guards relay a message from {EventHero.Name}, who has been your prisoner for a while."

msgid "STORY_EVENT@1013_200@BODY_LORE"
msgstr "\"Resisting the great {PlayerLeader.Name} was a grave mistake,\" {EventHero.FirstName} says. \"I see that now. I can no longer go on like this, I was not born to die in chains. Please, {PlayerLeader.Title}, I can give information, knowledge, I will do anything if you let me breathe fresh air again!\""

msgid "STORY_EVENT@1013_200@BUTTON_0"
msgstr "\"Swear loyalty to me, then I will release you.\" [unit/]"

msgid "STORY_EVENT@1013_200@BUTTON_2"
msgstr "\"I will release you after you share the secrets [knowledge/] to <<g:prosperity^n,EventHouse>>.\" [gold/]"

msgid "STORY_EVENT@1013_200@BUTTON_3"
msgstr "Deny <<g:request^n,EventHero>> for freedom."

msgid "STORY_EVENT@1013_200@TITLE"
msgstr "Plea of Desperation"

msgid "STORY_EVENT@1013_201@BODY_FOOTER"
msgstr "{EventHouseBLord.TitleName} smiles deviously, eager to take {EventHero.Name} under <<o:EventHouseBLord>> \"care\"."

msgid "STORY_EVENT@1013_201@BODY_HEADER"
msgstr "{EventHouseBLord.Name} of {EventHouseB.Name} shares a request concerning your prisoner, {EventHero.Name} of {EventHouse.Name}."

msgid "STORY_EVENT@1013_201@BODY_LORE"
msgstr "\"O {PlayerLeader.Title}, word has reached me you've captured an important hero of {EventHouse.Name}!\" {EventHouseBLord.TitleName} rubs <<o:EventHouseBLord>> hands. \"This so-called \"[hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink]\"{EventHero.Name} has killed many of my soldiers. Capturing <<P:EventHero>> would surely increase our leverage over <<o:EventHero>> wretched city. We prepared a... special treatment for {EventHero.TitleName} of the {EventHero.Race}.\""

msgid "STORY_EVENT@1013_201@BUTTON_0"
msgstr "Send {EventHero.FirstName} to <<o:EventHero>> rival: {EventHouseBLord.TitleName} of {EventHouseB.Name}. [evilact/]"

msgid "STORY_EVENT@1013_201@BUTTON_1"
msgstr "Reject <<g:request^n,EventHouseBLord>> and keep {EventHero.FirstName} imprisoned yourself."

msgid "STORY_EVENT@1013_201@BUTTON_2"
msgstr "\"Make it worth my while [gold/] and {EventHero.Name} is yours.\" [evilact/]"

msgid "STORY_EVENT@1013_201@BUTTON_3"
msgstr "\"Even prisoners deserve respect. {EventHero.FirstName} will endure no torture [goodact/].\""

msgid "STORY_EVENT@1013_201@TITLE"
msgstr "Special Guest"

msgid "STORY_EVENT@1013_2024@BODY_FOOTER"
msgstr "\"The Shad'rai tasked us to guard this prison. We must not let you free the creature, it is too valuable.\""

msgid "STORY_EVENT@1013_2024@BODY_HEADER"
msgstr "You enter a meadow that would have been peaceful, were it not for the group of creatures that greet you, led by a {EnemyUnit}."

msgid "STORY_EVENT@1013_2024@BODY_LORE"
msgstr "\"So you have found the prison of the {GLOBAL.MaerLoreConcept.Hyperlink},\" the {EnemyUnit} says. \"The {EventNimue.Title} studies this creature to enhance her people. With every newborn race, Nimue's followers become better, more powerful. The {GLOBAL.ShadraiFactionLoreConcept.Hyperlink} see merit in her efforts. That is why they assigned us to guard the Maer, to uphold the spells that bind her below the surface of the lake.\""

msgid "STORY_EVENT@1013_2024@BUTTON_0"
msgstr "Attack the guards!"

msgid "STORY_EVENT@1013_2024@BUTTON_10"
msgstr "Leave the lake."

msgid "STORY_EVENT@1013_2024@TITLE"
msgstr "Elya's Prison"

msgid "STORY_EVENT@1013_2025@BODY_FOOTER"
msgstr "\"I can not fight for your cause, but I can be of help. During my time as Nimue's prisoner I have learned of her experiments. I can tell you what I know.\""

msgid "STORY_EVENT@1013_2025@BODY_HEADER"
msgstr "You have defeated the guards of Elya's prison and freed the mythical {GLOBAL.MaerLoreConcept.Hyperlink}. {GLOBAL.ElyaLoreConcept.Hyperlink} emerges gracefully, floating on unseen currents."

msgid "STORY_EVENT@1013_2025@BODY_LORE"
msgstr "\"I thank you, {PlayerLeader.TitleName}, for following my song. My name is Elya. I was captured by {EventNimue}. She claims she will shape the perfect people, an army for the {GLOBAL.GodirLoreConcept.Hyperlink} who call themselves the {GLOBAL.ShadraiFactionLoreConcept.Hyperlink}. Please, {PlayerLeader.TitleName}, you must claim this realm to ensure she can never torment it again.\""

msgid "STORY_EVENT@1013_2025@BUTTON_0"
msgstr "\"Teach me about a tome I do not yet know.\""

msgid "STORY_EVENT@1013_2025@BUTTON_10"
msgstr "\"Tell me all you know about her experiments.\" [knowledge/]"

msgid "STORY_EVENT@1013_2025@BUTTON_11"
msgstr "\"I reject any knowledge gained from Nimue's tainted experiments..\" [goodact/]"

msgid "STORY_EVENT@1013_2025@BUTTON_9"
msgstr "\"Teach me what Nimue did to transform her {EventNimueRace}.\""

msgid "STORY_EVENT@1013_2025@TITLE"
msgstr "Elya's Prison: Aftermath"

msgid "STORY_EVENT@1013_202@BODY_FOOTER"
msgstr "You could easily beat {EventHouseLord.TitleName}, but perhaps there are more important things at stake than winning this small victory..."

msgid "STORY_EVENT@1013_202@BODY_HEADER"
msgstr "During diplomatic negotiations, {EventHouseLord.TitleName} of {EventHouse.Name} invites you to a game of high-stakes Wizards and Kings."

msgid "STORY_EVENT@1013_202@BODY_LORE"
msgstr "Very soon, it becomes clear that the {EventHouseLord.Title} from {EventHouse} is not up to the intricacies of a game meant to be played by {GLOBAL.GodirLoreConcept.Hyperlink}. What should have been a pleasant way to exchange favors slowly turns into a diplomatic disaster as {EventHouseLord.FirstName} grows more and more frustrated with every move you make."

msgid "STORY_EVENT@1013_202@BUTTON_0"
msgstr "Beat {EventHouseLord} to claim the stakes [gold/]."

msgid "STORY_EVENT@1013_202@BUTTON_1"
msgstr "Let {EventHouseLord} win [allegiance/], flattering <<o:EventHouseLord>> ego."

msgid "STORY_EVENT@1013_202@BUTTON_3"
msgstr "Summon an illusionary double to lose against {EventHouseLord}."

msgid "STORY_EVENT@1013_202@BUTTON_4"
msgstr "Humiliate {EventHouseLord} [evilact/] to claim <<o:EventHouseLord>> stake [gold/] and fame [influence/]."

msgid "STORY_EVENT@1013_202@BUTTON_5"
msgstr "Bluff imminent defeat to raise [gold/] and claim the stakes."

msgid "STORY_EVENT@1013_202@TITLE"
msgstr "High Stakes"

msgid "STORY_EVENT@1013_2033@BODY_FOOTER"
msgstr "By defeating {EventNimue} and her {EventNimueRace}, you have freed the Enchanted Archipelago. But the {GLOBAL.ShadraiFactionLoreConcept.Hyperlink} seem to have bigger plans..."

msgid "STORY_EVENT@1013_2033@BODY_HEADER"
msgstr "{EventNimue} was defeated. She screams as she is cast into the {GLOBAL.AstralVoidLoreConcept.Hyperlink}. The entire realm seems to sigh in relief."

msgid "STORY_EVENT@1013_2033@BODY_LORE"
msgstr "Your armies search her capital, where she conducted her \"experiments\" and abused the currents of creation to create new people. You find notes and diaries describing communications between her and other {GLOBAL.GodirLoreConcept.Hyperlink}, including {EventYaka.FirstName} and someone named {EventLithyl.FirstName}. The latter is looking for an object and demands {EventNimue.FirstName} ready her armies, no matter how \"imperfect\" they may be."

msgid "STORY_EVENT@1013_2033@BUTTON_0"
msgstr "I will bring my findings to the Covenant."

msgid "STORY_EVENT@1013_2033@BUTTON_1"
msgstr "Take all her mana [mana/] reserves."

msgid "STORY_EVENT@1013_2033@BUTTON_2"
msgstr "I need nothing from a mad Godir like Nimue. [influence/]"

msgid "STORY_EVENT@1013_2033@TITLE"
msgstr "{EventNimue.FirstName} Defeated"

msgid "STORY_EVENT@1013_2034@BODY_FOOTER"
msgstr "{EventNimue.FirstName} cackles with laughter as {EventPlayerLeader.TitleName} turns to you. \"My goddess calls upon my duty, {PlayerLeader.TitleName}. This means war.\""

msgid "STORY_EVENT@1013_2034@BODY_HEADER"
msgstr "You enter the drowned domain of {EventNimue.Name}. You hear her scream. \"You dare encroach on my domain?!\""

msgid "STORY_EVENT@1013_2034@BODY_LORE"
msgstr "\"This is unacceptable, how dare you oppose me!\"[br/]She calls upon {EventPlayerLeader.FirstName}, one of her former creations. \"{EventPlayerLeader.FirstName}! My loyal subject! Your {EventNimue.Title} is in danger! Prove your worth to me and destroy this cretin, before I drown you myself!\"[br/]{EventPlayerLeader.TitleName} of the {EventPlayerRace} jumps to attention and bows. \"Yes, my {EventNimue.Title}.\""

msgid "STORY_EVENT@1013_2034@BUTTON_0"
msgstr "\"So be it.\""

msgid "STORY_EVENT@1013_2034@TITLE"
msgstr "Loyal Subject"

msgid "STORY_EVENT@1013_2056@BODY_FOOTER"
msgstr "Nimue screams with rage as her once loyal subject defies her demand. {EventPlayerLeader.FirstName} himself turns to you. \"I will not fight you. {PlayerLeader.TitleName}. Not for her.\""

msgid "STORY_EVENT@1013_2056@BODY_HEADER"
msgstr "You enter the drowned domain of {EventNimue.Name}. You hear her scream. \"You dare encroach on my domain?!\""

msgid "STORY_EVENT@1013_2056@BODY_LORE"
msgstr "\"This is unacceptable, how dare you oppose me!\"[br/]She calls upon {EventPlayerLeader.FirstName}, one of her former creations. \"{EventPlayerLeader.FirstName}! My loyal subject! Your {EventNimue.Title} is in danger! Prove your worth to me and destroy this cretin!\"[br/]{EventPlayerLeader.TitleName} jumps to attention, but wavers. He then shakes his head. \"No, {EventNimue.Name}. I cannot do that.\""

msgid "STORY_EVENT@1013_2056@BUTTON_0"
msgstr "\"Glad to have you on my side.\""

msgid "STORY_EVENT@1013_2056@TITLE"
msgstr "Disloyal Subject"

msgid "STORY_EVENT@1013_2057@BODY_FOOTER"
msgstr "\"You don't know what true perfection, true divinity feels like. Taste defeat by my hand, and you may learn!\""

msgid "STORY_EVENT@1013_2057@BODY_HEADER"
msgstr "You encounter an army of {EventNimue.Name}. She herself appears before you. \"You're still here?!\" she yells."

msgid "STORY_EVENT@1013_2057@BODY_LORE"
msgstr "\"So you and your {PlayerRaceInsult} made it up to here. Surprising, but no matter. You have no idea what's coming, what the other Shad'rai and I are planning. My masterpieces will crush you. This will be their final test to prove they are worthy of my love! Go, my {EventNimueRace.Name}, and show your {EventNimue.Title} how much you love her!\""

msgid "STORY_EVENT@1013_2057@BUTTON_0"
msgstr "\"Your reign of terror will end, Nimue!\""

msgid "STORY_EVENT@1013_2057@TITLE"
msgstr "Battle against the {EventNimue.Title}"

msgid "STORY_EVENT@1013_205@BODY_FOOTER"
msgstr "You open the bottle and feel nauseous from the smell alone. Is your relation with {EventHouse} truly worth... this?"

msgid "STORY_EVENT@1013_205@BODY_HEADER"
msgstr "During diplomatic negotiations, {EventHouseLord.TitleName} of {EventHouse} sends you a bottle filled with an unknown substance."

msgid "STORY_EVENT@1013_205@BODY_LORE"
msgstr "\"O {PlayerLeader.TitleName}, we {EventRace} feel blessed by your presence. In anticipation of our new pact, we had this small gift sent to you.\" {EventHouseLord} holds up a glass. \"In our culture, we share this drink when we forge a bond.\" <<Cp:EventHouseLord>> takes a sip and coughs heavily, waiting for you to return the gesture. "

msgid "STORY_EVENT@1013_205@BUTTON_0"
msgstr "Make a toast and take a sip."

msgid "STORY_EVENT@1013_205@BUTTON_1"
msgstr "Decline to drink this foul concoction."

msgid "STORY_EVENT@1013_205@BUTTON_2"
msgstr "Sneak in an antidote and down the entire bottle."

msgid "STORY_EVENT@1013_205@TITLE"
msgstr "The Taste of Friendship"

msgid "STORY_EVENT@1013_206@BODY_FOOTER"
msgstr "{EventHouseLord} seems to be deeply insulted by the actions of your [hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink] {EventHero}."

msgid "STORY_EVENT@1013_206@BODY_HEADER"
msgstr "During diplomatic negotiations, {EventHouseLord.TitleName} of {EventHouse} approaches you, quaking with anger."

msgid "STORY_EVENT@1013_206@BODY_LORE"
msgstr "\"This is an outrage!\" {EventHouseLord} shouts. \"I received reports of your [hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink] {EventHero} bad-mouthing me, insulting my appearance, even doing an impression of me while wearing a {EventUnit} mask. {EventHero} seems to think <<p:EventHero>> can hide <<r:EventHero>> behind you, <<o:EventHero>> {PlayerLeader.Title}, but I demand there be consequences!\""

msgid "STORY_EVENT@1013_206@BUTTON_0"
msgstr "\"When it comes to minor <<m:EventHouseLord.Title>>, {EventHero} can say whatever <<p:EventHero>> pleases.\""

msgid "STORY_EVENT@1013_206@BUTTON_1"
msgstr "\"Rest assured that {EventHero} will be disciplined for <<o:EventHero>> transgressions.\""

msgid "STORY_EVENT@1013_206@BUTTON_2"
msgstr "\"Despite <<G:misconduct^n,EventHero>>, are you not above such petty jokes, {EventHouseLord}?\""

msgid "STORY_EVENT@1013_206@TITLE"
msgstr "Faux Pas"

msgid "STORY_EVENT@1013_2075@BODY_FOOTER"
msgstr "\"Nothing you can say can convince me now. This is war, {PlayerLeader.TitleName}.\""

msgid "STORY_EVENT@1013_2075@BODY_HEADER"
msgstr "{EventPlayerLeader} harrumphs. \"You wage war against the fair <<m:{GLOBAL.IndependentCityConcept.Hyperlink}>> in this realm and now claim my goddess is the evil one?!\""

msgid "STORY_EVENT@1013_2075@BODY_LORE"
msgstr "<<Cp:EventPlayerLeader>> grinds <<o:EventPlayerLeader>> teeth. \"I must respect the rules of negotiation, so I will not strike you down where you stand. You chose to defeat the {GLOBAL.IndependentCityConcept.Hyperlink} I was sworn to protect. Nothing you say about the {EventNimue.Title} can convince me. I grant you this chance of leaving, or to gather your armies.\""

msgid "STORY_EVENT@1013_2075@BUTTON_0"
msgstr "\"So be it.\""

msgid "STORY_EVENT@1013_2075@TITLE"
msgstr "Too Late for Reason"

msgid "STORY_EVENT@1013_2077@BODY_FOOTER"
msgstr "\"If good Godir truly exist, please, deliver us from her wrath.\""

msgid "STORY_EVENT@1013_2077@BODY_HEADER"
msgstr "\"Be careful!\" A Ruler of a people you haven't properly met before slowly comes out of hiding. \"There are monsters lurking nearby.\""

msgid "STORY_EVENT@1013_2077@BODY_LORE"
msgstr "\"I am {EventPlayerLeader.Name}, Ruler of the {EventPlayerRace.Name}. Once, we were the goddess' favorites, until she became... disappointed with us. She drowned so many of us when we fled her wrath. We have survived by staying hidden, but her power grows with every creature she builds and drowns. Please, you must stop her, before she catches us.\""

msgid "STORY_EVENT@1013_2077@BUTTON_0"
msgstr "\"Tell me what I can do to help.\""

msgid "STORY_EVENT@1013_2077@BUTTON_1"
msgstr "\"Just stay out of my way.\""

msgid "STORY_EVENT@1013_2077@TITLE"
msgstr "Meeting {EventPlayerLeader.Name}"

msgid "STORY_EVENT@1013_268@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} with you."

msgid "STORY_EVENT@1013_268@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} is delighted to meet you for the first time."

msgid "STORY_EVENT@1013_268@BODY_LORE"
msgstr "\"Well met, {PlayerLeader.TitleName}! It is an honor for other {EventHouseRace.Name} like us to meet a great {PlayerLeader.Title} like you. We look forward to seeing your empire grow.\""

msgid "STORY_EVENT@1013_268@BUTTON_0"
msgstr "\"Let me see whether {EventHouse.Name} is worthy of the attention they crave.\""

msgid "STORY_EVENT@1013_268@BUTTON_2"
msgstr "\"Goodbye for now.\""

msgid "STORY_EVENT@1013_268@TITLE"
msgstr "Meeting Friendly {EventHouse.Name}"

msgid "STORY_EVENT@1013_271@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} with you."

msgid "STORY_EVENT@1013_271@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} greets you for the first time."

msgid "STORY_EVENT@1013_271@BODY_LORE"
msgstr "\"Salutations. It is an honor to meet a {PlayerLeader.Title} of the {EventHouseRace.Name} here. Nevertheless, we humbly ask you to respect the territory and independence of {EventHouse.Name}.\""

msgid "STORY_EVENT@1013_271@BUTTON_0"
msgstr "\"Let me see whether {EventHouse.Name} is worthy of my attention.\""

msgid "STORY_EVENT@1013_271@BUTTON_2"
msgstr "\"Goodbye for now.\""

msgid "STORY_EVENT@1013_271@TITLE"
msgstr "Meeting Neutral {EventHouse.Name}"

msgid "STORY_EVENT@1013_272@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} with you."

msgid "STORY_EVENT@1013_272@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} greets you warily."

msgid "STORY_EVENT@1013_272@BODY_LORE"
msgstr "\"Just because you are a {PlayerLeader.Title} of the {EventHouseRace.Name}, that does not mean that {EventHouse.Name} will bow to you without question. We will be keeping an eye on you, {PlayerLeader.Name}.\""

msgid "STORY_EVENT@1013_272@BUTTON_0"
msgstr "\"Let me see whether {EventHouse.Name} is worthy of reconciliation.\""

msgid "STORY_EVENT@1013_272@BUTTON_2"
msgstr "\"I will deal with your insolence later.\""

msgid "STORY_EVENT@1013_272@TITLE"
msgstr "Meeting Wary {EventHouse.Name}"

msgid "STORY_EVENT@1013_273@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} with you."

msgid "STORY_EVENT@1013_273@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} is enthused about meeting you for the first time."

msgid "STORY_EVENT@1013_273@BODY_LORE"
msgstr "\"Well met, {PlayerLeader.TitleName}! We heard great things about you. We {EventHouseRace.Name} hope our humble {GLOBAL.IndependentCityConcept.Hyperlink} can learn from you.\""

msgid "STORY_EVENT@1013_273@BUTTON_0"
msgstr "\"Let me see whether {EventHouse.Name} is worthy of the attention they crave.\""

msgid "STORY_EVENT@1013_273@BUTTON_2"
msgstr "\"Goodbye for now.\""

msgid "STORY_EVENT@1013_273@TITLE"
msgstr "Meeting Friendly {EventHouse.Name}"

msgid "STORY_EVENT@1013_274@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} with you."

msgid "STORY_EVENT@1013_274@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} greets you for the first time."

msgid "STORY_EVENT@1013_274@BODY_LORE"
msgstr "\"Salutations, {PlayerLeader.Title} of the {PlayerRace.Name}. We {EventHouseRace.Name} humbly ask you to respect <<g:territory^n,EventHouse>> and independence.\""

msgid "STORY_EVENT@1013_274@BUTTON_0"
msgstr "\"Let me see whether {EventHouse.Name} is worthy of my attention.\""

msgid "STORY_EVENT@1013_274@BUTTON_2"
msgstr "\"Goodbye for now.\""

msgid "STORY_EVENT@1013_274@TITLE"
msgstr "Meeting Neutral {EventHouse.Name}"

msgid "STORY_EVENT@1013_275@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} with you."

msgid "STORY_EVENT@1013_275@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} regards you with unveiled suspicion."

msgid "STORY_EVENT@1013_275@BODY_LORE"
msgstr "\"So! The proud citizens of {EventHouse.Name} meet with a {PlayerLeader.Title}. We suggest you approach us {EventHouseRace.Name} with caution, for you will find we do not bow as easily as you {PlayerRace.Name}.\""

msgid "STORY_EVENT@1013_275@BUTTON_0"
msgstr "\"Let me see whether {EventHouse.Name} is worthy of reconciliation.\""

msgid "STORY_EVENT@1013_275@BUTTON_2"
msgstr "\"I will deal with your insolence later.\""

msgid "STORY_EVENT@1013_275@TITLE"
msgstr "Meeting Wary {EventHouse.Name}"

msgid "STORY_EVENT@1013_431@BODY_FOOTER"
msgstr "You are currently passing through the domain of {EventHouse.Name}."

msgid "STORY_EVENT@1013_431@BODY_HEADER"
msgstr "Friendly guards from {EventHouse.Name} quickly rise from where they were resting when your army approaches."

msgid "STORY_EVENT@1013_431@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Friendly guards from {EventHouse.Name} quickly rise from where they were resting when you approach."

msgid "STORY_EVENT@1013_431@BODY_LORE"
msgstr "\"Good day, travelers,\" the {EventStackLeader.Name} says as the others scramble to their positions. \"You are followers of {PlayerLeader.TitleName}, are you not? Welcome to the domain of {EventHouse.Name}. What brings you to our lands?\""

msgid "STORY_EVENT@1013_431@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "\"Good day, {PlayerLeader.TitleName},\" the {EventStackLeader.Name} says as the others scramble to their positions. \"Welcome to the domain of {EventHouse.Name}. What brings you to our lands?\""

msgid "STORY_EVENT@1013_431@BUTTON_1"
msgstr "\"We have a message for your {EventHouseLord.TitleName}.\""

msgid "STORY_EVENT@1013_431@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"I have a message for your {EventHouseLord.TitleName}.\""

msgid "STORY_EVENT@1013_431@BUTTON_2"
msgstr "\"We have come to destroy you!\" "

msgid "STORY_EVENT@1013_431@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "\"I have come to destroy you!\""

msgid "STORY_EVENT@1013_431@BUTTON_3"
msgstr "\"We are merely passing through...\""

msgid "STORY_EVENT@1013_431@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "\"I am merely passing through...\""

msgid "STORY_EVENT@1013_431@TITLE"
msgstr "Greetings, Traveler!"

msgid "STORY_EVENT@1013_431@TITLE@HERO_IS_PLAYERLE"
msgstr "Greetings, {PlayerLeader.Title}!"

msgid "STORY_EVENT@1013_432@BODY_FOOTER"
msgstr "These guards from {EventHouse.Name} seem unsure of your intentions."

msgid "STORY_EVENT@1013_432@BODY_HEADER"
msgstr "Guards from the independent city of {EventHouse.Name} call out from a distance when your army approaches."

msgid "STORY_EVENT@1013_432@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Guards from the independent city of {EventHouse.Name} call out from a distance when you approach."

msgid "STORY_EVENT@1013_432@BODY_LORE"
msgstr "\"Halt, traveler! Know you are traveling through the domain of {EventHouse.Name}. State your business or begone!\""

msgid "STORY_EVENT@1013_432@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "They mutter but one musters up courage to shout: \"Halt, {PlayerLeader.Title}! Know you are travelling through the domain of {EventHouse.Name}. State your business or begone!\""

msgid "STORY_EVENT@1013_432@BUTTON_1"
msgstr "\"We have a message for your {EventHouseLord.TitleName}.\""

msgid "STORY_EVENT@1013_432@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"I have a message for your {EventHouseLord.TitleName}.\""

msgid "STORY_EVENT@1013_432@BUTTON_2"
msgstr "\"We have come to destroy you!\""

msgid "STORY_EVENT@1013_432@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "\"I have come to destroy you!\""

msgid "STORY_EVENT@1013_432@BUTTON_3"
msgstr "\"At ease, we are merely passing through...\""

msgid "STORY_EVENT@1013_432@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "\"At ease, I am merely passing through...\""

msgid "STORY_EVENT@1013_432@TITLE"
msgstr "Halt, Traveler!"

msgid "STORY_EVENT@1013_432@TITLE@HERO_IS_PLAYERLE"
msgstr "Halt, {PlayerLeader.Title}!"

msgid "STORY_EVENT@1013_433@BODY_FOOTER"
msgstr "\"Fine city you've got there!\" the {EventStackLeader.Name} says. \"Would be a shame if someone were to ransack it, repeatedly...\""

msgid "STORY_EVENT@1013_433@BODY_HEADER"
msgstr "A group of bandits has set up camp nearby and is encroaching on your borders near {EventCity.Name}!"

msgid "STORY_EVENT@1013_433@BODY_LORE"
msgstr "\"G'day, neighbor!\" a rugged-looking {EventStackLeader.Name} shouts from a distance. \"Pleased to make yer acquaintance. Let me explain how things go around here. We offer protection... from horrible bandits roaming these lands. But to be able to protect you from us—err... I mean, them—we'll need payment. Upfront. That's clear enough, eh?\""

msgid "STORY_EVENT@1013_433@BUTTON_0"
msgstr "Pay their fee [gold/] so the {EventStackLeader.Name} leaves {EventCity.Name} alone."

msgid "STORY_EVENT@1013_433@BUTTON_1"
msgstr "\"Here is an offer [gold/] to appease your entire {EventSpawner.Name} for a while.\""

msgid "STORY_EVENT@1013_433@BUTTON_2"
msgstr "\"We are not afraid of you bandits and your weak threats.\""

msgid "STORY_EVENT@1013_433@TITLE"
msgstr "Business Proposition"

msgid "STORY_EVENT@1013_434@BODY_FOOTER"
msgstr "While <<p:EventHero>> struggles to move through the sticky web, {EventHero.FirstName} hears the excited chitter of the cave's many-legged inhabitants. They can sense more prey!"

msgid "STORY_EVENT@1013_434@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "While you struggle to move through the sticky web, you hear the excited chitter of the cave's many-legged inhabitants. They can sense more prey!"

msgid "STORY_EVENT@1013_434@BODY_HEADER"
msgstr "The cave is dark and eerily silent as {EventHero.Name} approaches. A thin layer of silky webbing covers the entrance."

msgid "STORY_EVENT@1013_434@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "The cave is dark and eerily silent as you approach. A thin layer of silky webbing covers the entrance."

msgid "STORY_EVENT@1013_434@BODY_LORE"
msgstr "{EventHero.FirstName} and <<o:EventHero>> party venture further through the maze-like cave system, passing cocoons filled with all types of creatures whilst searching for the secrets hidden under the cobwebs. Before long the webbing gets so thick that it is noticeably harder to move. Then, {EventHero.FirstName} hears something in the darkness."

msgid "STORY_EVENT@1013_434@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "You and your party venture further through the maze-like cave, passing cocoons filled with all sorts of creatures whilst searching for the secrets hidden beneath the cobwebs. Before long, the webbing gets so thick that it becomes noticeably harder to move. Then, you hear something in the darkness."

msgid "STORY_EVENT@1013_434@BUTTON_0"
msgstr "\"Slay these vile creatures! Attack!\""

msgid "STORY_EVENT@1013_434@BUTTON_1"
msgstr "Set fire to the webbing around {EventHero.FirstName}."

msgid "STORY_EVENT@1013_434@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "Set fire to the webbing around you."

msgid "STORY_EVENT@1013_434@BUTTON_2"
msgstr "Collapse part of the cave on top of the spiders, damaging them before engaging."

msgid "STORY_EVENT@1013_434@BUTTON_4"
msgstr "Retreat."

msgid "STORY_EVENT@1013_434@TITLE"
msgstr "Lair of Silk"

msgid "STORY_EVENT@1013_435@BODY_FOOTER"
msgstr "\"I owe you my life.\" {EventHeroB.Name} says. \"If you need my help in the future, you need only ask.\""

msgid "STORY_EVENT@1013_435@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "\"I owe you my life, o {PlayerLeader.Title}.\" {EventHeroB.Name} says. \"If you need my help in the future, you need only ask.\""

msgid "STORY_EVENT@1013_435@BODY_HEADER"
msgstr "After the spiders are dealt with, {EventHero.FirstName} can search the cave with ease."

msgid "STORY_EVENT@1013_435@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "After the spiders are dealt with, you can search the cave with ease."

msgid "STORY_EVENT@1013_435@BODY_LORE"
msgstr "<<Cp:EventHero>> finds several cocoons, most of them empty or with their contents decayed. Then, one of <<o:EventHero>> companions calls <<P:EventHero>> over. \"This one's still breathing!\" {EventHero.FirstName} quickly frees the living victim and after a moment of respite, <<p:EventHeroB>> is able to speak. \"Thank the {GLOBAL.GodirLoreConcept.Hyperlink} for your arrival. My name is {EventHeroB.Name} of {EventHouse.Name}. We traveled here to investigate this so-called safe haven, and then... well.\" <<Cp:EventHeroB>> gestures towards the cocoons."

msgid "STORY_EVENT@1013_435@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "You find several cocoons, most of them empty or with their contents decayed. Then, one of your companions calls you over. \"This one's still breathing!\" You quickly free the living victim and after a moment of respite, <<p:EventHeroB>> is able to speak. \"Thank the {GLOBAL.GodirLoreConcept.Hyperlink} for your arrival. My name is {EventHeroB} of {EventHouse}. We traveled here to investigate this so-called safe haven, and then... well.\" <<Cp:EventHeroB>> gestures towards the cocoons."

msgid "STORY_EVENT@1013_435@BODY_LORE@NO_EVENTHOUSE"
msgstr "<<Cp:EventHero>> finds several cocoons, most of them empty or with their contents decayed. Then, one of <<o:EventHero>> companions calls <<P:EventHero>> over. \"This one's still breathing!\" {EventHero.FirstName} quickly frees the living victim and after a moment of respite, <<p:EventHeroB>> is able to speak. \"Thank the {GLOBAL.GodirLoreConcept.Hyperlink} for your arrival. My name is {EventHeroB.Name} of {EventCity.Name}. We traveled here to investigate this so-called safe haven, and then... well.\" <<Cp:EventHeroB>> gestures towards the cocoons."

msgid "STORY_EVENT@1013_435@BODY_LORE@NO_HOUSE_NO_CITY"
msgstr "<<Cp:EventHero>> finds several cocoons, most of them empty or with their contents decayed. Then, one of <<o:EventHero>> companions calls <<P:EventHero>> over. \"This one's still breathing!\" {EventHero.FirstName} quickly frees the living victim and after a moment of respite, <<p:EventHeroB>> is able to speak. \"Thank the {GLOBAL.GodirLoreConcept.Hyperlink} for your arrival. My name is {EventHeroB.Name}. We traveled here to investigate this so-called safe haven, and then... Well.\" <<Cp:EventHeroB>> gestures towards the cocoons."

msgid "STORY_EVENT@1013_435@BODY_LORE@NO_HOUSE_PLAYERL"
msgstr "You find several cocoons, most of them empty or with their contents decayed. Then, one of your companions calls you over. \"This one's still breathing!\" You quickly free the living victim and after a moment of respite, <<p:EventHeroB>> is able to speak. \"Thank the {GLOBAL.GodirLoreConcept.Hyperlink} for your arrival. My name is {EventHeroB} of {EventCity}. We traveled here to investigate this so-called safe haven, and then... well.\" <<Cp:EventHeroB>> gestures towards the cocoons."

msgid "STORY_EVENT@1013_435@BUTTON_0"
msgstr "Send {EventHeroB.Name} home [goodact/] to {EventHouse.Name}."

msgid "STORY_EVENT@1013_435@BUTTON_1"
msgstr "Strip {EventHeroB.Name} of <<o:EventHeroB>> belongings [gold/] and imprison <<P:EventHeroB>>. [evilact/]"

msgid "STORY_EVENT@1013_435@BUTTON_2"
msgstr "Send {EventHeroB.Name} home [goodact/] to {EventCity.Name}."

msgid "STORY_EVENT@1013_435@BUTTON_3"
msgstr "Demand tribute [gold/] for the rescue and send {EventHeroB.FirstName} on <<o:EventHeroB>> way."

msgid "STORY_EVENT@1013_435@TITLE"
msgstr "Lair of Silk: Aftermath"

msgid "STORY_EVENT@1013_443@BODY_FOOTER"
msgstr "These soldiers from {EventHouse.Name} clearly do not trust your intentions."

msgid "STORY_EVENT@1013_443@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "These soldiers from {EventHouse.Name} clearly do not trust your intentions."

msgid "STORY_EVENT@1013_443@BODY_HEADER"
msgstr "Hostile guards from {EventHouse.Name} call out from defensive positions when your army approaches."

msgid "STORY_EVENT@1013_443@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Hostile guards from {EventHouse.Name} call out from defensive positions when you approach."

msgid "STORY_EVENT@1013_443@BODY_LORE"
msgstr "\"Halt! Not a step closer!\" their leader shouts, arms crossed, standing in front of <<g:banner^n,EventHouse>>. \"You can't fool us. You carry the banner of the despicable {PlayerLeader.TitleName}! We'll be keeping an eye on you, so don't try anything!\""

msgid "STORY_EVENT@1013_443@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "\"Halt, {PlayerLeader.Title}! Not a step closer!\" their leader shouts, arms crossed, standing in front of <<g:banner^n,EventHouse>>. \"You can't fool or intimidate us. We heard all about you! We'll be keeping an eye on you, so don't try anything!\""

msgid "STORY_EVENT@1013_443@BUTTON_1"
msgstr "\"We have a message for your {EventHouseLord.TitleName}.\""

msgid "STORY_EVENT@1013_443@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"I have a message for your {EventHouseLord.TitleName}.\""

msgid "STORY_EVENT@1013_443@BUTTON_2"
msgstr "\"Your suspicions are correct! To arms!\""

msgid "STORY_EVENT@1013_443@BUTTON_3"
msgstr "\"At ease, we are merely passing through...\""

msgid "STORY_EVENT@1013_443@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "\"At ease, I am merely passing through...\""

msgid "STORY_EVENT@1013_443@TITLE"
msgstr "Not a Step Closer!"

msgid "STORY_EVENT@1013_444@BODY_FOOTER"
msgstr "{EventHouse.Name} requests the body of {EventHero.Name} so they can bury <<P:EventHero>> in their own crypt."

msgid "STORY_EVENT@1013_444@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of {EventHouse.Name} has a request for you regarding <<o:EventHouseLord>> deceased hero {EventHero.Name}, resting in your {GLOBAL.CryptConcept}."

msgid "STORY_EVENT@1013_444@BODY_LORE"
msgstr "\"We entrusted our beloved {EventHero.Name} to you, and now <<p:EventHero>> has died a hero’s death under your command. Please, allow us to take <<P:EventHero>> home so <<p:EventHero>> can rest with <<o:EventHero>> ancestors.\""

msgid "STORY_EVENT@1013_444@BUTTON_0"
msgstr "Deliver the body of {EventHero.Name} to {EventHouse.Name}."

msgid "STORY_EVENT@1013_444@BUTTON_1"
msgstr "\"{EventHero.FirstName} will stay here.\""

msgid "STORY_EVENT@1013_444@TITLE"
msgstr "Final Journey Home"

msgid "STORY_EVENT@1013_445@BODY_FOOTER"
msgstr "{EventHouse.Name} asks you to perform special funeral rites that will mean {EventHero.Name} can never be resurrected."

msgid "STORY_EVENT@1013_445@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of {EventHouse.Name} has a request regarding <<o:EventHouseLord>> deceased hero {EventHero.Name}, resting in your {GLOBAL.CryptConcept}."

msgid "STORY_EVENT@1013_445@BODY_LORE"
msgstr "\"We are in deep mourning for {EventHero.Name}, but we firmly believe the dead must rest forever. We of {EventHouse.Name} share the tradition of performing funeral rites that ensure no necromancy can taint our [hyperlink,GLOBAL.SoulsLoreConcept]fallen brethren[/hyperlink] on their journey through the afterlife. We humbly ask you to honor that tradition and conduct the rite for {EventHero.Name}, who has served you so well.\""

msgid "STORY_EVENT@1013_445@BUTTON_0"
msgstr "Perform the funeral rites [mana/] and send {EventHero} to {EventHouse}."

msgid "STORY_EVENT@1013_445@BUTTON_1"
msgstr "Deliver <<G:body^n,EventHero>> to {EventHouse.Name} where they will perform the rites."

msgid "STORY_EVENT@1013_445@BUTTON_2"
msgstr "\"I cannot perform these rites for {EventHero.Name}.\""

msgid "STORY_EVENT@1013_445@BUTTON_3"
msgstr "\"Foolish mortals. Let me educate you in the blessings of undeath.\""

msgid "STORY_EVENT@1013_445@TITLE"
msgstr "Funeral Rites"

msgid "STORY_EVENT@1013_446@BODY_FOOTER"
msgstr "Do you let the scared {EventStackLeader.Name} and other creatures go, or attack them regardless?"

msgid "STORY_EVENT@1013_446@BODY_HEADER"
msgstr "Your troops engage the {EventStackLeader.Name} and <<o:EventStackLeader>> minions, but they cower in fear rather than put up a fight."

msgid "STORY_EVENT@1013_446@BODY_LORE"
msgstr "Most of them try to hide, while others huddle on the ground. They seem to be begging for mercy through panicked hisses and cries."

msgid "STORY_EVENT@1013_446@BUTTON_0"
msgstr "Attack! [evilact/]"

msgid "STORY_EVENT@1013_446@BUTTON_1"
msgstr "Let them go. [goodact/]"

msgid "STORY_EVENT@1013_446@TITLE"
msgstr "Fight or Flight"

msgid "STORY_EVENT@1013_449@BODY_FOOTER"
msgstr "Hungry, wild animals threaten the borders of {EventCity.Name}."

msgid "STORY_EVENT@1013_449@BODY_HEADER"
msgstr "Your villagers from {EventCity.Name} report concerning sightings..."

msgid "STORY_EVENT@1013_449@BODY_LORE"
msgstr "\"Beasts, my {PlayerLeader.Title}! We saw them lurking in the dark, and we found dead livestock on our fields. These beasts are driven by hunger, and almost took the mason's son when he went into the woods! If we don't do something, they're sure to attack our homes next! Think of the children, my {Player.Title}. Think of the mason's son!\""

msgid "STORY_EVENT@1013_449@BUTTON_0"
msgstr "\"Poison some food [food/] and leave it for the animals in the fields.\""

msgid "STORY_EVENT@1013_449@BUTTON_1"
msgstr "\"Poison enough food [food/] to drive them back to their {EventSpawner}.\""

msgid "STORY_EVENT@1013_449@BUTTON_2"
msgstr "\"Let them come, we are not afraid of a few hungry beasts.\""

msgid "STORY_EVENT@1013_449@TITLE"
msgstr "Lurking in the Wilds"

msgid "STORY_EVENT@1013_450@BODY_FOOTER"
msgstr "How do you wish to celebrate this fruitful feat?"

msgid "STORY_EVENT@1013_450@BODY_HEADER"
msgstr "The harvest in the domain of your city {EventCity.Name} has been bountiful this year."

msgid "STORY_EVENT@1013_450@BODY_LORE"
msgstr "The city is well-known for its impressive agriculture, and now it has outdone even itself. Food stalls turn the grand square into a maze filled with aromas and flavors, as children parade the streets with baskets full of the latest yield. There is no doubt that all of the other rulers are in awe of this display of prosperity."

msgid "STORY_EVENT@1013_450@BUTTON_0"
msgstr "Sell [gold/] the extra produce from this year's harvest."

msgid "STORY_EVENT@1013_450@BUTTON_1"
msgstr "Donate the excesses of this year's harvest with your poorest families. [goodact/]"

msgid "STORY_EVENT@1013_450@BUTTON_2"
msgstr "Commemorate the laborers of {EventCity.Name} [happiness/] for their hard work."

msgid "STORY_EVENT@1013_450@BUTTON_3"
msgstr "Throw lavish parties for the lesser Lords [influence/] in this realm."

msgid "STORY_EVENT@1013_450@TITLE"
msgstr "Harvest Festival"

msgid "STORY_EVENT@1013_451@BODY_FOOTER"
msgstr "{EventHero.FirstName} freezes when an ear-piercing shriek resounds through the cave and the same bloodthirsty {EnemyUnit.Name} emerges from the dark, <<o:EnemyUnit>> rabid eyes fixed on {EventHero.FirstName}."

msgid "STORY_EVENT@1013_451@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "You freeze when an ear-piercing shriek resounds through the cave and the same bloodthirsty {EnemyUnit.Name} emerges from the dark, <<o:EnemyUnit>> rabid eyes fixed on you..."

msgid "STORY_EVENT@1013_451@BODY_HEADER"
msgstr "As {EventHero.Name} approaches the cave, <<p:EventHero>> smells fresh blood, but finds no signs of life."

msgid "STORY_EVENT@1013_451@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "As you approach the cave, you smell fresh blood, but find no signs of life."

msgid "STORY_EVENT@1013_451@BODY_LORE"
msgstr "Having entered the cave, {EventHero.FirstName} and <<o:EventHero>> companions find the remains of a brutal fight. The carcass of an adult {EventUnit.Name} lies alongside her offspring; the two of them appear to have been ambushed in what was supposed to be a safe haven. Upon closer inspection, it looks as though the animals were viciously attacked by a wild {EnemyUnit.Name}."

msgid "STORY_EVENT@1013_451@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Having entered the cave, you and your companions find the remains of a brutal fight. The carcass of an adult {EventUnit.Name} lies alongside her offspring; the two of them appear to have been ambushed in what was supposed to be a safe haven. Upon closer inspection, it looks as though the animals were viciously attacked by a wild {EnemyUnit.Name}."

msgid "STORY_EVENT@1013_451@BUTTON_0"
msgstr "\"No time to waste! Attack!\""

msgid "STORY_EVENT@1013_451@BUTTON_1"
msgstr "Try and calm the crazed {EnemyUnit.Name} before putting it down."

msgid "STORY_EVENT@1013_451@BUTTON_2"
msgstr "Feed the beast [food/] until it can barely move, then attack."

msgid "STORY_EVENT@1013_451@BUTTON_3"
msgstr "Flee."

msgid "STORY_EVENT@1013_451@TITLE"
msgstr "Cave of Carnage"

msgid "STORY_EVENT@1013_452@BODY_FOOTER"
msgstr "A young {EventUnit.Name} has survived the carnage at the {EventStructure.Name} and clings to {EventHero.FirstName}."

msgid "STORY_EVENT@1013_452@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "A young {EventUnit.Name} has survived the carnage at the {EventStructure.Name} and clings to you."

msgid "STORY_EVENT@1013_452@BODY_HEADER"
msgstr "The wild threat has been dealt with and {EventHero.Name} has the opportunity to search the cave."

msgid "STORY_EVENT@1013_452@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "The wild threat has been dealt with and you have the opportunity to search the cave."

msgid "STORY_EVENT@1013_452@BODY_LORE"
msgstr "{EventHero.FirstName} orders the bodies of the {EventUnit} and her offspring to be removed. As others go to lift the heavy animal, something softly whines from underneath it — and a young {EventUnit.Name} emerges, the sole survivor of the pack. It seems as though its mother's body protected it from harm. It looks up to {EventHero.Name} and whines again."

msgid "STORY_EVENT@1013_452@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "You order the bodies of the {EventUnit} and her offspring to be removed. As others go to lift the heavy animal, something softly whines from underneath it — and a young {EventUnit.Name} emerges, the sole survivor of the pack. It seems as though its mother's body protected it from harm. It looks up to you and whines again."

msgid "STORY_EVENT@1013_452@BUTTON_0"
msgstr "Keep the {EventUnit.Name} and raise it as your mount. [mount/]"

msgid "STORY_EVENT@1013_452@BUTTON_1"
msgstr "Nurse the {EventUnit.Name} to strength and release it into the wild. [goodact/]"

msgid "STORY_EVENT@1013_452@BUTTON_2"
msgstr "The hide of this {EventUnit} would make a for a very fine {EventItem.Name} [item/]..."

msgid "STORY_EVENT@1013_452@TITLE"
msgstr "Cave of Carnage: Aftermath"

msgid "STORY_EVENT@1013_457@BODY_FOOTER"
msgstr "You are invited to celebrate the name day of {EventHouseLord.Name}. What gift will you bring?"

msgid "STORY_EVENT@1013_457@BODY_HEADER"
msgstr "You receive an official invitation from the friendly {EventHouseLord.Title} of {EventHouse.Name}."

msgid "STORY_EVENT@1013_457@BODY_LORE"
msgstr "\"The great {PlayerLeader.TitleName}! We of {EventHouse.Name} hereby humbly invite you to join the name day celebration of our {EventHouseLord.TitleName}. We would be honored if you would attend, and we look forward to your gift.\" "

msgid "STORY_EVENT@1013_457@BUTTON_0"
msgstr "Order your finest artists [gold/] to paint a flattering portrait of {EventHouseLord.TitleName}."

msgid "STORY_EVENT@1013_457@BUTTON_1"
msgstr "A small trinket [gold/] will suffice."

msgid "STORY_EVENT@1013_457@BUTTON_2"
msgstr "Present the {EventHouseLord.Title} with a tamed beast from the homeland of the {PlayerRace.Name}."

msgid "STORY_EVENT@1013_457@BUTTON_3"
msgstr "Make an excuse to not attend the celebration."

msgid "STORY_EVENT@1013_457@BUTTON_4"
msgstr "\"My gift is that {EventHouseLord.TitleName} is allowed to live another day.\" [evilact/]"

msgid "STORY_EVENT@1013_457@TITLE"
msgstr "Name Day Celebration"

msgid "STORY_EVENT@1013_462@BODY_FOOTER"
msgstr "\"I ask you to kindly lend me your cooks, to teach my people how to make a proper meal.\""

msgid "STORY_EVENT@1013_462@BODY_HEADER"
msgstr "{EventHouseLord.Name} of {EventHouse.Name} has a question regarding your <<gu:cuisine^n,EventRace>>."

msgid "STORY_EVENT@1013_462@BODY_LORE"
msgstr "\"We have heard stories about the delicacies made by the {EventRace.Name}. Delightful appetizers, roasts worthy of a song, desserts to die for... Meanwhile, I sit here, eating dry bread and raw meat, because my cooks do not know how to make a decent meal. This cannot go on. The {EventHouseRace.Name} must be educated in the culinary arts!\""

msgid "STORY_EVENT@1013_462@BUTTON_0"
msgstr "\"Very well. Chefs [food/] from {EventCity.Name} will instruct yours for a time.\""

msgid "STORY_EVENT@1013_462@BUTTON_1"
msgstr "What a perfect opportunity to poison the citizens of {EventHouse.Name}... [evilact/]"

msgid "STORY_EVENT@1013_462@BUTTON_2"
msgstr "\"I have my own people to feed...\""

msgid "STORY_EVENT@1013_462@BUTTON_3"
msgstr "\"I propose a trade. Your builders [structureprod/] for my chefs [food/].\""

msgid "STORY_EVENT@1013_462@TITLE"
msgstr "Culinary Curiosity"

msgid "STORY_EVENT@1013_463@BODY_FOOTER"
msgstr "{EventHouseLord.TitleName} bows. \"I bow before your arcane expertise, my {PlayerLeader.Title}, and humbly ask for your scholars to instruct mine.\""

msgid "STORY_EVENT@1013_463@BODY_HEADER"
msgstr "{EventHouseLord.Name} of {EventHouse.Name} has heard of your progress in education and knowledge."

msgid "STORY_EVENT@1013_463@BODY_LORE"
msgstr "\"Every time I hear about {EventCity.Name}, I am amazed by your newest arcane breakthrough. It seems like you are advancing by leaps and bounds, while we still crawl like newborn babes. Would you, the brilliant {PlayerLeader.TitleName}, be interested in educating my people, so that we may follow you on this path of knowledge?\""

msgid "STORY_EVENT@1013_463@BUTTON_0"
msgstr "\"Knowledge should be shared. Scholars from {EventCity.Name} [knowledge/] will enlighten yours.\""

msgid "STORY_EVENT@1013_463@BUTTON_2"
msgstr "\"I need all my scholars at my side...\""

msgid "STORY_EVENT@1013_463@BUTTON_3"
msgstr "\"I will personally tutor you, {EventHouseLord.TitleName}.\""

msgid "STORY_EVENT@1013_463@BUTTON_4"
msgstr "\"Scholars from {EventCity.Name} [knowledge/] will enlighten yours, for a fee.\" [gold/]"

msgid "STORY_EVENT@1013_463@TITLE"
msgstr "Knowledge Sharing"

msgid "STORY_EVENT@1013_465@BODY_FOOTER"
msgstr "\"It would certainly put the citizens of {EventHouse.Name} at ease if they saw the great {PlayerLeader.Title} you are.\""

msgid "STORY_EVENT@1013_465@BODY_HEADER"
msgstr "Your supporter, {EventHouseLord.Name} of {EventHouse.Name}, ponders your diplomatic bonds."

msgid "STORY_EVENT@1013_465@BODY_LORE"
msgstr "\"It has been an honor to get acquainted with you, O {PlayerLeader.Title}. {EventCity.Name} basks in your glory. Yet, there are still those who question our bond with you. Some of my citizens are... wary of you. My word alone is not enough to convince them.\""

msgid "STORY_EVENT@1013_465@BUTTON_0"
msgstr "Use your influence [influence/] to promote yourself in {EventHouse.Name}."

msgid "STORY_EVENT@1013_465@BUTTON_2"
msgstr "Give an eloquent speech to delight {EventHouse.Name}."

msgid "STORY_EVENT@1013_465@BUTTON_3"
msgstr "\"It is not my responsibility to convince your people.\""

msgid "STORY_EVENT@1013_465@BUTTON_4"
msgstr "Send a sizeable gift [gold/] to {EventHouse.Name} to appease the citizens."

msgid "STORY_EVENT@1013_465@TITLE"
msgstr "Bonds and Benevolence"

msgid "STORY_EVENT@1013_466@BODY_FOOTER"
msgstr "{EventHouseLord.Name} looks at you, jaw clenched and slightly trembling. \"Others dare not defy you, my {PlayerLeader.Title}... but I will!\""

msgid "STORY_EVENT@1013_466@BODY_HEADER"
msgstr "The critical {EventHouseLord.Name} of {EventHouse.Name} stands before you, defiantly."

msgid "STORY_EVENT@1013_466@BODY_LORE"
msgstr "\"{PlayerLeader.TitleName}. For too long, the good people of this realm have bowed to you. No more! No longer shall we be inveigled or intimidated by you. {EventHouse.Name} will stand against the blight you cast upon this realm!\""

msgid "STORY_EVENT@1013_466@BUTTON_0"
msgstr "\"If you want a war with a {PlayerLeader.Title}, so be it!\""

msgid "STORY_EVENT@1013_466@BUTTON_1"
msgstr "Attempt to mend your diplomatic relations [influence/] with {EventHouseLord.Name}."

msgid "STORY_EVENT@1013_466@BUTTON_2"
msgstr "\"Remember that you address a {PlayerLeader.Title}. Mind your tone, {EventHouseLord.Title}\""

msgid "STORY_EVENT@1013_466@TITLE"
msgstr "Daring Defiance"

msgid "STORY_EVENT@1013_467@BODY_FOOTER"
msgstr "\"Please, share some of your architectural wisdom with me, so I can protect my citizens!\""

msgid "STORY_EVENT@1013_467@BODY_HEADER"
msgstr "{EventHouseLord.Name} appears before you, concerned about the defenses of {EventHouse.Name}."

msgid "STORY_EVENT@1013_467@BODY_LORE"
msgstr "\"{PlayerLeader.TitleName}, I have long been impressed by your feats of construction and humbly ask for your help. My building plans have seen some delays, and now <<g:defenses^p,EventHouse>> are falling behind. With rising tensions in the realm, I fear my city may not withstand a siege, were such a thing to happen.\""

msgid "STORY_EVENT@1013_467@BUTTON_0"
msgstr "\"My builders [structureprod/] from {EventCity.Name} will support yours for a while.\""

msgid "STORY_EVENT@1013_467@BUTTON_1"
msgstr "\"I will personally help you with your defenses.\""

msgid "STORY_EVENT@1013_467@BUTTON_3"
msgstr "\"My builders [structureprod/] will help you, for the right tribute [gold/].\""

msgid "STORY_EVENT@1013_467@BUTTON_4"
msgstr "\"You admit your weakness. A foolish mistake. Rally the troops!\" [evilact/]"

msgid "STORY_EVENT@1013_467@BUTTON_5"
msgstr "\"I will not share the secrets of my defenses with you.\""

msgid "STORY_EVENT@1013_467@TITLE"
msgstr "Decaying Defenses"

msgid "STORY_EVENT@1013_468@BODY_FOOTER"
msgstr "\"I beg of you, my {PlayerLeader.Title}. Lend me some of your wisdom to save {EventHouse.Name} from an uprising.\""

msgid "STORY_EVENT@1013_468@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of malevolent {EventHouse.Name} is in a somber mood."

msgid "STORY_EVENT@1013_468@BODY_LORE"
msgstr "\"I don't understand, {PlayerLeader.TitleName}!\" <<cp:EventHouseLord>> says. \"I thought I was doing everything right. I hanged those who sowed dissent, banished those who spoke ill of me. And yet my citizens grow more and more angry every day. They are at my gates as we speak, shouting about tyranny. But you, my {PlayerLeader.Title}... Everyone respects you.\""

msgid "STORY_EVENT@1013_468@BUTTON_0"
msgstr "\"My envoys [influence/] will help to improve your legacy.\""

msgid "STORY_EVENT@1013_468@BUTTON_1"
msgstr "\"Convincing people requires hard work and sacrifice, not gallows and banishments.\" [goodact/]"

msgid "STORY_EVENT@1013_468@BUTTON_2"
msgstr "\"I need to focus on my people. You should do the same.\""

msgid "STORY_EVENT@1013_468@TITLE"
msgstr "Pursuit of Happiness"

msgid "STORY_EVENT@1013_469@BODY_FOOTER"
msgstr "\"I plead for your support and would be forever grateful.\""

msgid "STORY_EVENT@1013_469@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of {EventHouse.Name} seems desperate."

msgid "STORY_EVENT@1013_469@BODY_LORE"
msgstr "\"Noble {PlayerLeader.TitleName}, I am ruined. I have gotten myself and my people into debt. My treasury lies empty, and my former benefactors are out for my blood. They have taken members of my family hostage, making threats of mutilation and death.\""

msgid "STORY_EVENT@1013_469@BUTTON_0"
msgstr "\"To err is mortal. Tell me how much [gold/] you need.\""

msgid "STORY_EVENT@1013_469@BUTTON_1"
msgstr "\"I will help you to make your lands more profitable.\""

msgid "STORY_EVENT@1013_469@BUTTON_2"
msgstr "\"Your family will pay the consequences of your actions.\""

msgid "STORY_EVENT@1013_469@BUTTON_3"
msgstr "\"Your creditors shall meet a painful end.\""

msgid "STORY_EVENT@1013_469@TITLE"
msgstr "Debt and Death"

msgid "STORY_EVENT@1013_482@BODY_FOOTER"
msgstr "Do you acknowledge the farmers' concerns regarding <<g:agriculture^n,EventCity.Name>>?"

msgid "STORY_EVENT@1013_482@BODY_HEADER"
msgstr "Your farmers from {EventCity.Name} declare that there's an issue with their yields."

msgid "STORY_EVENT@1013_482@BODY_LORE"
msgstr "\"{PlayerLeader.TitleName}, we farmers are your humble servants, but it seems we aren't enough to support your ambitions. We hear tales about {EventGoldenCity.Name}, where the pastures are greener, and the people have food to last them forever. We struggle to feed our children, and there they feast like kings. Why can't we live like them? Why aren't we thriving like they are?\""

msgid "STORY_EVENT@1013_482@BUTTON_0"
msgstr "Improve [gold/] these peasant's tools to secure better yields [food/]."

msgid "STORY_EVENT@1013_482@BUTTON_1"
msgstr "Swear [influence/] to assign temporary laborers [population/] to the fields."

msgid "STORY_EVENT@1013_482@BUTTON_2"
msgstr "Consult your lore to increase the quality of the crops and yields."

msgid "STORY_EVENT@1013_482@BUTTON_3"
msgstr "Ignore their concerns."

msgid "STORY_EVENT@1013_482@TITLE"
msgstr "Greener Pastures"

msgid "STORY_EVENT@1013_483@BODY_FOOTER"
msgstr "It seems {EventCity.Name} and your empire have become a laughing stock regarding its level of education."

msgid "STORY_EVENT@1013_483@BODY_HEADER"
msgstr "A council member from your city {EventCity.Name} approaches you, waving a pamphlet."

msgid "STORY_EVENT@1013_483@BODY_LORE"
msgstr "\"We received this pamphlet from {EventGoldenCity.Name}, my {PlayerLeader.Title}! It took a while to decipher, but I believe they are laughing at us and calling us idiots! What does \"dulbert\" even mean? Is that even a word? We can't just let them insult us like this, my {PlayerLeader.Title}. There must be something we can do to prove them wrong...\""

msgid "STORY_EVENT@1013_483@BUTTON_0"
msgstr "Invest [gold/] in educating [knowledge/] the citizens of {EventCity.Name}."

msgid "STORY_EVENT@1013_483@BUTTON_1"
msgstr "{EventCity} needs schools. Swear [influence/] to recruit more builders. [production/]"

msgid "STORY_EVENT@1013_483@BUTTON_2"
msgstr "Tutor the citizens of {EventCity.Name} yourself for a while."

msgid "STORY_EVENT@1013_483@BUTTON_3"
msgstr "Do not get involved."

msgid "STORY_EVENT@1013_483@TITLE"
msgstr "Eloquent Insult"

msgid "STORY_EVENT@1013_484@BODY_FOOTER"
msgstr "How would you have the winner serve you?"

msgid "STORY_EVENT@1013_484@BODY_HEADER"
msgstr "A local tournament is hosted at your city {EventCity.Name}."

msgid "STORY_EVENT@1013_484@BODY_LORE"
msgstr "The city is well known for its local military prowess, and it shows. Cheers echo through the streets as contestants clash in the city square. Although each round is harmless in nature, the duels get more serious as victory draws closer. Eventually one contestant, a {EventUnit.Name}, kneels before you, badly bruised but victorious!"

msgid "STORY_EVENT@1013_484@BUTTON_0"
msgstr "The winner shall be your gladiator. As patron, you claim the spoils [gold/]!"

msgid "STORY_EVENT@1013_484@BUTTON_1"
msgstr "Hire the winner to instruct recruits [unitprod/] in the arts of battle."

msgid "STORY_EVENT@1013_484@BUTTON_2"
msgstr "Congratulate and praise the winner [happiness/] for <<o:EventUnit>> well-deserved victory."

msgid "STORY_EVENT@1013_484@BUTTON_3"
msgstr "Allow the winning {EventUnit.Name} [unit/] to join your army."

msgid "STORY_EVENT@1013_484@TITLE"
msgstr "Bread and Circuses"

msgid "STORY_EVENT@1013_487@BODY_FOOTER"
msgstr "What will you say to end the escalating argument between {EventHouseLord.TitleName} and {EventHouseBLord.TitleName}?"

msgid "STORY_EVENT@1013_487@BODY_HEADER"
msgstr "During diplomatic negotiations, {EventHouseLord.TitleName} of {EventHouse} invites you and {EventHouseBLord.TitleName} of {EventHouseB} to an evening of friendly chatter."

msgid "STORY_EVENT@1013_487@BODY_LORE"
msgstr "As the evening progresses, {EventHouseLord} and {EventHouseBLord} start to argue.[br/]\"The {GLOBAL.AstralSeaLoreConcept.Hyperlink} is a flat plane, you dolt!\" {EventHouseLord.FirstName} yells, gesturing wildly.[br/][br/]\"No, it behaves like a sphere, stretching in every direction!\" {EventHouseBLord.FirstName} slams <<o:EventHouseBLord>> hands on the table.[br/][br/]Then both turn to you, expecting a {PlayerLeader.Title} to settle their quarrel."

msgid "STORY_EVENT@1013_487@BUTTON_0"
msgstr "\"{EventHouseLord.Name} is right. The Astral Sea is flat.\""

msgid "STORY_EVENT@1013_487@BUTTON_1"
msgstr "\"{EventHouseBLord.Name} makes a compelling argument. It looks more like a sphere.\""

msgid "STORY_EVENT@1013_487@BUTTON_3"
msgstr "Appeal to their friendship [influence/] to quell the debate."

msgid "STORY_EVENT@1013_487@BUTTON_4"
msgstr "Cast a projection of the Astral Sea that is flat AND spherical."

msgid "STORY_EVENT@1013_487@TITLE"
msgstr "Heated Debate"

msgid "STORY_EVENT@1013_488@BODY_FOOTER"
msgstr "{EventHero.FirstName} offers you the {EventItem}. \"I took the weapon for you, my {PlayerLeader.Title}, to help you gain victory!\""

msgid "STORY_EVENT@1013_488@BODY_HEADER"
msgstr "Before resuming diplomatic negotiations, {EventHouseLord.TitleName} of {EventHouse.Name} accuses one of your [hyperlink,GLOBAL.HeroConcept]Heroes[/hyperlink]. \"{EventHero.Name} stole my coveted {EventItem.Name}!\""

msgid "STORY_EVENT@1013_488@BODY_LORE"
msgstr "{EventHouseLord.TitleName} is fuming. \"I would not accuse anyone of theft without proof, my {PlayerLeader.Title}. But two of my servants caught {EventHero.Name} in the act! I trust in your judgment and expect the weapon to be returned to me post haste.\"[br/][br/]Upon inquiry {EventHero.FirstName} immediately admits the theft to you without any regret."

msgid "STORY_EVENT@1013_488@BUTTON_0"
msgstr "{EventHero.Name} is right. Keep the {EventItem.Name}. [item/]"

msgid "STORY_EVENT@1013_488@BUTTON_1"
msgstr "Secretly sell [gold/] the {EventItem.Name} before {EventHouseLord.Name} accuses you further."

msgid "STORY_EVENT@1013_488@BUTTON_2"
msgstr "Return a forgery of the {EventItem.Name} to {EventHouse.Name}. Keep the original. [item/]"

msgid "STORY_EVENT@1013_488@BUTTON_3"
msgstr "Make {EventHero} formally apologize [happiness/]. {EventHouse.Name} receives the {EventItem.Name}."

msgid "STORY_EVENT@1013_488@BUTTON_4"
msgstr "Return the weapon and send {EventHero.Name} to {EventHouse.Name} for punishment."

msgid "STORY_EVENT@1013_488@TITLE"
msgstr "Sticky Fingers"

msgid "STORY_EVENT@1013_489@BODY_FOOTER"
msgstr "<<Cp:EventStackLeader>> gestures at you. \"Would you care to play a tune?\""

msgid "STORY_EVENT@1013_489@BODY_HEADER"
msgstr "The troops of {EventHouse.Name} stationed at the {EventStructure.Name} are listening to a musical performance."

msgid "STORY_EVENT@1013_489@BODY_LORE"
msgstr "The soft strains of music reach the ears of {EventHero.Name} when <<p:EventHero>> draws closer. A {EventStackLeader.Name} looks up and approaches. \"Please, tarry with us a while. We were just enjoying some sweet melodies played by our highly talented friends. You serve {PlayerLeader.TitleName}, do you not? A {PlayerLeader.Title} who knows something of culture! Pray tell. Are you skilled in the musical arts as well?\""

msgid "STORY_EVENT@1013_489@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "The soft strains of music reach your ears when you draw closer. A {EventStackLeader.Name} looks up and approaches you. \"Please, tarry with us a while. We were just enjoying some sweet melodies played by our highly talented friends. You are {PlayerLeader.TitleName}, are you not? A {PlayerLeader.Title} who knows something of culture! Pray tell. Are you refined in the musical arts as well?\""

msgid "STORY_EVENT@1013_489@BUTTON_1"
msgstr "\"{EventHouseLord.TitleName} will agree [influence/] to leave this location to me.\""

msgid "STORY_EVENT@1013_489@BUTTON_2"
msgstr "\"My music will bring you to tears. In return, you will grant me the {EventStructure}.\" "

msgid "STORY_EVENT@1013_489@BUTTON_3"
msgstr "\"The only instruments I play are the drums of war! Attack!\""

msgid "STORY_EVENT@1013_489@BUTTON_4"
msgstr "\"We're just appreciating the music. Please, do go on...\""

msgid "STORY_EVENT@1013_489@TITLE"
msgstr "Sweet Melodies"

msgid "STORY_EVENT@1013_490@BODY_FOOTER"
msgstr "\"I know we're supposed to be guarding this location, but you're good folk, right? Have a drink!\""

msgid "STORY_EVENT@1013_490@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "\"I know we're supposed to be guarding this location... but you understand, right, {PlayerLeader.Title}? Have a drink!\""

msgid "STORY_EVENT@1013_490@BODY_HEADER"
msgstr "The troops of {EventHouse.Name} are dancing around the {EventStructure.Name} and barely notice the approach of {EventHero.Name}."

msgid "STORY_EVENT@1013_490@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "The troops of {EventHouse.Name} are dancing around the {EventStructure.Name} and barely notice your approach."

msgid "STORY_EVENT@1013_490@BODY_LORE"
msgstr "The troops were meant to guard the {EventStructure.Name}, but instead they are celebrating. \"Our general got married, so we have the day off duty,\" says the {EventStackLeader.Name} when {EventHero.FirstName} inquires about their behavior. \"Well, he didn't really give us the day off... but we seized the initiative and took it off anyway. Join us!\""

msgid "STORY_EVENT@1013_490@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "The troops were meant to guard the {EventStructure.Name}, but instead they are celebrating. \"Our general got married, so we have the day off duty,\" says the {EventStackLeader.Name} when you inquire about their behavior. \"Well, he didn't really give us the day off... but we seized the initiative and took it off anyway. Join us!\""

msgid "STORY_EVENT@1013_490@BUTTON_0"
msgstr "\"Your {EventHouseLord.Title} won't mind [influence/] if you take even more time off.\""

msgid "STORY_EVENT@1013_490@BUTTON_1"
msgstr "{EventHero.Name} joins the party to trick them into giving up the {EventStructure}..."

msgid "STORY_EVENT@1013_490@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "Join the festivities to trick them into signing the location over to you..."

msgid "STORY_EVENT@1013_490@BUTTON_2"
msgstr "\"In this distracted state they will be easy pickings! Attack!\""

msgid "STORY_EVENT@1013_490@BUTTON_3"
msgstr "\"We will be on our way, have fun...\""

msgid "STORY_EVENT@1013_490@TITLE"
msgstr "Work Hard, Feast Hard"

msgid "STORY_EVENT@1013_510@BODY_FOOTER"
msgstr "{EventHero.FirstName}'s scouts found a hidden weak spot in the city's foundations. What does <<p:EventHero>> do with the information?"

msgid "STORY_EVENT@1013_510@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Your scouts found a hidden weak spot in the city's foundations. Do you want to use it to your advantage?"

msgid "STORY_EVENT@1013_510@BODY_HEADER"
msgstr "During the siege of {EventCity.Name} led by your [hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink] {EventHero.Name}, <<o:EventHero>> scouts return with exciting news."

msgid "STORY_EVENT@1013_510@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "During the siege of {EventCity.Name}, your scouts return with exciting news."

msgid "STORY_EVENT@1013_510@BODY_LORE"
msgstr "\"We found a weakness in the southern wall, my {EventHero.Title},\" the scout proudly proclaims, after catching his breath. \"Its foundations are crumbling, and it's barely being supported. All it will take is some concentrated effort to tip the scales—and the wall—in our favor!\""

msgid "STORY_EVENT@1013_510@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "\"We found a weakness in the southern wall, my {PlayerLeader.Title},\" the scout proudly proclaims, after catching his breath. \"Its foundations are crumbling, and it's barely being supported. All it will take is some concentrated effort to tip the scales—and the wall—in our favor!\""

msgid "STORY_EVENT@1013_510@BUTTON_0"
msgstr "\"Put some extra effort [structureprod/] into assaulting these weakened defenses!\""

msgid "STORY_EVENT@1013_510@BUTTON_1"
msgstr "\"With some well-placed precision attacks, we may break through...\""

msgid "STORY_EVENT@1013_510@BUTTON_2"
msgstr "\"We will continue as we did before.\""

msgid "STORY_EVENT@1013_510@TITLE"
msgstr "Shaky Foundations"

msgid "STORY_EVENT@1013_514@BODY_FOOTER"
msgstr "\"Our reluctance to obey forced us into this life of savagery,\" the deserters claim, \"but we will fight for what is right and survive, we will even claim {EventCity.Name} itself if we have to!\""

msgid "STORY_EVENT@1013_514@BODY_HEADER"
msgstr "A group of {EventRace.Name}, who are deserters, have claimed an area near {EventCity.Name} and are now threatening your citizens!"

msgid "STORY_EVENT@1013_514@BODY_LORE"
msgstr "They steal from villages surrounding {EventCity.Name} and despoil travelers who enter their \"territory.\" Despite this, they now profess a love for peace.[br/][br/]\"Lay down your weapons. We mean no harm! We refused to fight in hopeless wars, and now we're shunned everywhere we go. But we will fight for a righteous cause—our freedom!\""

msgid "STORY_EVENT@1013_514@BUTTON_0"
msgstr "Help the encroaching group to find refuge in {EventCity.Name}, despite public protest [happiness/]. [goodact/]"

msgid "STORY_EVENT@1013_514@BUTTON_1"
msgstr "Allow all willing deserters from the {EventSpawner.Name} to live in {EventCity.Name}, upsetting the populace [happiness/]. [goodact/]"

msgid "STORY_EVENT@1013_514@BUTTON_2"
msgstr "\"We do not fear or share sympathy for deserters who threaten {EventCity.Name}.\""

msgid "STORY_EVENT@1013_514@BUTTON_3"
msgstr "Order your garrison [unitprod/] to hunt down the group threatening {EventCity.Name} directly."

msgid "STORY_EVENT@1013_514@BUTTON_4"
msgstr "Promise all willing deserters sanctuary in {EventCity.Name}, then execute them for their crimes.[evilact/]"

msgid "STORY_EVENT@1013_514@TITLE"
msgstr "Shunned Deserters"

msgid "STORY_EVENT@1013_515@BODY_FOOTER"
msgstr "The {EventStackLeader.Name} stands firm before your might. \"Give us the information we seek, or we will have to resort to more extreme measures.\""

msgid "STORY_EVENT@1013_515@BODY_HEADER"
msgstr "A group of bandits who call themselves \"aspiring astral travelers\" are encroaching on your borders near {EventCity.Name}."

msgid "STORY_EVENT@1013_515@BODY_LORE"
msgstr "\"We have toiled in this damned realm long enough. We're looking for a way to leave, and the only safe way to do so seems to be through something called \"[hyperlink,GLOBAL.WorldGateLoreConcept]World Gates[/hyperlink]\" to the {GLOBAL.AstralSeaLoreConcept.Hyperlink}. We know that you {GLOBAL.GodirLoreConcept.Hyperlink} know how to build them. We want that knowledge! We’ll take it by force if necessary. Anything so we can get to paradise!\""

msgid "STORY_EVENT@1013_515@BUTTON_0"
msgstr "Grant these \"travelers\" limited access to your knowledge [knowledge/] to keep them busy... for now."

msgid "STORY_EVENT@1013_515@BUTTON_1"
msgstr "Allow these \"travelers\" to learn what they want [knowledge/], quelling the {EventSpawner.Name} for a while."

msgid "STORY_EVENT@1013_515@BUTTON_2"
msgstr "If they dare approach {EventCity.Name} they will know the true cost of knowledge."

msgid "STORY_EVENT@1013_515@TITLE"
msgstr "Astral Aspirations"

msgid "STORY_EVENT@1013_516@BODY_FOOTER"
msgstr "Creatures threaten to infest {EventCity.Name} and only seem to be appeased with sweets and pastries."

msgid "STORY_EVENT@1013_516@BODY_HEADER"
msgstr "A group of creatures led by a {EventStackLeader.Name} is threatening your villages near {EventCity.Name}, driven by a particular craving."

msgid "STORY_EVENT@1013_516@BODY_LORE"
msgstr "According to local folklore, the creatures hunt for villagers, unless they are placated with sweets and other sugary goods. Villagers have resorted to leaving piles of confections in offering at the edges of the empire, in hopes of appeasing the {EventSpawner.Name}, but it seems the <<g:cravings^p,EventStackLeader>> for sweets are not so easily satisfied..."

msgid "STORY_EVENT@1013_516@BUTTON_0"
msgstr "Gather some sweets [food/] to appease those closest to {EventCity.Name}."

msgid "STORY_EVENT@1013_516@BUTTON_1"
msgstr "Gather all the pastries [food/] the city can muster to satiate the entire {EventSpawner.Name} for a while."

msgid "STORY_EVENT@1013_516@BUTTON_2"
msgstr "Let them come, our revenge shall be sweeter than any confection."

msgid "STORY_EVENT@1013_516@TITLE"
msgstr "Sweet Cravings"

msgid "STORY_EVENT@1013_517@BODY_FOOTER"
msgstr "\"Give shinies!\" The {EventStackLeader.Name} roars, \"or {EventUnit.Name} eat!\" <<o:EventStackLeader>> {EventUnit.Name} sniffs and growls, moving closer and closer to {EventCity.Name}. "

msgid "STORY_EVENT@1013_517@BODY_HEADER"
msgstr "A nearby group of {EventStackLeader.Name} and <<o:EventStackLeader>> pets are getting closer and closer to {EventCity.Name}, your city."

msgid "STORY_EVENT@1013_517@BODY_LORE"
msgstr "The message of the {EventStackLeader.Name} is simple. \"{EventUnit.Name} smell shinies. Sniff sniff. {EventUnit.Name} finds. I take. If little {EventRace.Name} keep shinies, {EventUnit.Name} eat {EventRace.Name}. Then I take.\" "

msgid "STORY_EVENT@1013_517@BUTTON_0"
msgstr "Appease this {EventStackLeader.Name} with some gold shiny [gold/]."

msgid "STORY_EVENT@1013_517@BUTTON_1"
msgstr "Leave enough shiny gold [gold/] for the entire {EventSpawner.Name} to be satisfied for a long time."

msgid "STORY_EVENT@1013_517@BUTTON_2"
msgstr "\"I do not give into petty demands like these. Let them come.\""

msgid "STORY_EVENT@1013_517@TITLE"
msgstr "Scent of Gold"

msgid "STORY_EVENT@1013_518@BODY_FOOTER"
msgstr "{EventHero.FirstName} wonders if <<p:EventHero>> should allow the summoning ritual to continue, or stop it before it is too late."

msgid "STORY_EVENT@1013_518@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "You wonder if you should allow the summoning ritual to continue, or stop it before it is too late..."

msgid "STORY_EVENT@1013_518@BODY_HEADER"
msgstr "{EventHero.Name} and <<o:EventHero>> retinue approach the grand {EventStructure.Name}, decorated with depictions of stern-looking {GLOBAL.GodirLoreConcept.Hyperlink}."

msgid "STORY_EVENT@1013_518@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "You and your retinue approach the grand {EventStructure.Name}, decorated with depictions of stern-looking {GLOBAL.GodirLoreConcept.Hyperlink}."

msgid "STORY_EVENT@1013_518@BODY_LORE"
msgstr "{EventHero.Name} hears eerie chanting coming from within and espies a group of hooded figures performing some sort of ritual. Suddenly, a blood-curdling scream echoes through the temple. The group is summoning something... Something big, and otherworldly. <<Cg:companions^p,EventHero>> swallow nervously as they look on, awaiting orders."

msgid "STORY_EVENT@1013_518@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "You hear eerie chanting coming from within and espy a group of hooded figures performing some sort of ritual. Suddenly, a blood-curdling scream echoes through the temple. This group is summoning something... Something big, and otherworldly. Your companions swallow nervously as they look on, awaiting orders."

msgid "STORY_EVENT@1013_518@BUTTON_0"
msgstr "\"Stop this ritual NOW! To arms!\""

msgid "STORY_EVENT@1013_518@BUTTON_1"
msgstr "Delay the ritual for as long as possible [mana/] and attack."

msgid "STORY_EVENT@1013_518@BUTTON_2"
msgstr "Leave."

msgid "STORY_EVENT@1013_518@BUTTON_3"
msgstr "\"Faith will help us in delaying this desecration!\""

msgid "STORY_EVENT@1013_518@BUTTON_4"
msgstr "Take over the ritual. Whatever is summoned belongs to you."

msgid "STORY_EVENT@1013_518@TITLE"
msgstr "Scrolls of Terror"

msgid "STORY_EVENT@1013_519@BODY_FOOTER"
msgstr "The demonic scroll is silent, and yet incredibly captivating. So much knowledge rests within..."

msgid "STORY_EVENT@1013_519@BODY_HEADER"
msgstr "With the cultists gone and their ritual undone, the {EventStructure} at last falls silent and {EventHero.Name} is free to investigate."

msgid "STORY_EVENT@1013_519@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "With the cultists gone and their ritual undone, the {EventStructure} at last falls silent and you are free to investigate."

msgid "STORY_EVENT@1013_519@BODY_LORE"
msgstr "The cultists were not praising the deities for whom the {EventStructure.Name} was built at all. A malicious-looking scroll sits in the center of the ritual circle: an artifact used to summon beings from a world called Obbadoth, bearing illustrations of beings like <<m:EventUnit>>. It seems the cultists were using this scroll to call on this demonic power."

msgid "STORY_EVENT@1013_519@BUTTON_0"
msgstr "The knowledge [knowledge/] contained within this fiendish scroll could certainly be of use to you..."

msgid "STORY_EVENT@1013_519@BUTTON_1"
msgstr "Use the scroll to summon and control a unit [unit/] of true evil origin... [evilact/]"

msgid "STORY_EVENT@1013_519@BUTTON_2"
msgstr "Burn the scroll. Cleanse the {EventStructure.Name}. [goodact/]"

msgid "STORY_EVENT@1013_519@TITLE"
msgstr "Scrolls of Terror: Aftermath"

msgid "STORY_EVENT@1013_551@BODY_FOOTER"
msgstr "\"Will you take down {TargetHouse} so we of {EventHouse} will no longer be harassed?!\""

msgid "STORY_EVENT@1013_551@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of {EventHouse} approaches you with <<o:EventHouseLord>> jaw set."

msgid "STORY_EVENT@1013_551@BODY_LORE"
msgstr "\"We of {EventHouse} have a long and bloody history with {TargetHouse}. The rivalry between our cities started generations ago for reasons even I do not know. Yet, any attempts at peace have resulted in treachery and more bloodshed. I feared it would never end. But with a {PlayerLeader.Title} like you on our side, no one will dare cross us ever again.\""

msgid "STORY_EVENT@1013_551@BUTTON_0"
msgstr "\"I hear you. I will take down {TargetHouse}.\""

msgid "STORY_EVENT@1013_551@BUTTON_1"
msgstr "\"I decree that [influence/] you both shall be united as friends [goodact/] under my protection instead.\""

msgid "STORY_EVENT@1013_551@BUTTON_2"
msgstr "\"I have no time for the petty squabbles of minor cities.\""

msgid "STORY_EVENT@1013_551@TITLE"
msgstr "Bitter Rivalry"

msgid "STORY_EVENT@1013_552@BODY_FOOTER"
msgstr "What do you ask of {EventHouse.Name} for your troubles?"

msgid "STORY_EVENT@1013_552@BODY_HEADER"
msgstr "You have successfully conquered {TargetHouse}, resulting in a very happy {EventHouseLord.TitleName}."

msgid "STORY_EVENT@1013_552@BODY_LORE"
msgstr "\"I can't believe you've done it! You actually crushed them! I knew your prowess was legendary, but I have never seen the like of it in all my days. I am grateful, {PlayerLeader}, truly grateful. {EventHouse} owes you a great debt. We have not much to offer a great {PlayerLeader.Title} like you, but know that you have made a friend for life in us.\""

msgid "STORY_EVENT@1013_552@BUTTON_0"
msgstr "\"Let us seal this great achievement with a new treaty [allegiance/]!\""

msgid "STORY_EVENT@1013_552@BUTTON_1"
msgstr "\"I could use some of your fighting men and women [unit/] on my side.\""

msgid "STORY_EVENT@1013_552@BUTTON_3"
msgstr "My people paid with blood. You will pay with gold [gold/]."

msgid "STORY_EVENT@1013_552@TITLE"
msgstr "Bitter Rivalry: Aftermath"

msgid "STORY_EVENT@1013_558@BODY_FOOTER"
msgstr "It seems {EventHero.FirstName} has unexpected \"allies\" on the inside in {EventCity.Name}. Does <<p:EventHero>> call for their help?"

msgid "STORY_EVENT@1013_558@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "It seems you have unexpected \"allies\" on the inside in {EventCity.Name}. Do you call for their help?"

msgid "STORY_EVENT@1013_558@BODY_HEADER"
msgstr "During the siege of {EventCity.Name}, your [hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink] {EventHero.Name} receives a hastily written note that was tied to a rock and thrown over the wall."

msgid "STORY_EVENT@1013_558@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "During the siege of {EventCity.Name} you receive a hastily written note that was tied to a rock and thrown over the wall."

msgid "STORY_EVENT@1013_558@BODY_LORE"
msgstr "\"We share no love for {EventCity.Name} or {EventCityLord.TitleName}. Will help from within, for safety and gold. Deliver answer and reward at midnight and it will be done.\""

msgid "STORY_EVENT@1013_558@BUTTON_0"
msgstr "Pay [gold/] the turncoats for their help."

msgid "STORY_EVENT@1013_558@BUTTON_1"
msgstr "Promise to pay them when the siege is over... and then \"forget\" all about it."

msgid "STORY_EVENT@1013_558@BUTTON_2"
msgstr "\"We will continue as we are.\""

msgid "STORY_EVENT@1013_558@TITLE"
msgstr "Friends On the Other Side"

msgid "STORY_EVENT@1013_559@BODY_FOOTER"
msgstr "Smugglers and thieves from {EventCity.Name} are offering their expertise in getting supplies into the city, for a promise of leniency."

msgid "STORY_EVENT@1013_559@BODY_HEADER"
msgstr "While your city {EventCity.Name} is besieged by {EnemyUnit.Name} you receive an unexpected offer of help."

msgid "STORY_EVENT@1013_559@BODY_LORE"
msgstr "A shady {EventUnit.Name} bows sarcastically and grins. \"I represent a 'particular' enterprise within these city walls. We have ways of moving contraband in and out of this patch, even during times like these. Now, none of us have ever gotten nabbed, and we'd like to keep it that way. So, if we lend you a hand, we need your guards to sniff elsewhere in the future, if you catch my drift.\""

msgid "STORY_EVENT@1013_559@BUTTON_0"
msgstr "\"I accept your offer, and will ensure your future exploits are... overlooked.\" "

msgid "STORY_EVENT@1013_559@BUTTON_1"
msgstr "\"Show me your routes or I'll have you 'nabbed' before this city falls!\""

msgid "STORY_EVENT@1013_559@BUTTON_2"
msgstr "\"I do not need help from petty criminals.\" "

msgid "STORY_EVENT@1013_559@TITLE"
msgstr "Honor Among Thieves"

msgid "STORY_EVENT@1013_565@BODY_FOOTER"
msgstr "Acknowledging a shared ancestry with the {EventRace} would overjoy {EventHouseLord}, yet will cause controversy among your people."

msgid "STORY_EVENT@1013_565@BODY_HEADER"
msgstr "During diplomatic negotiations, {EventHouseLord} of {EventHouse} believes an important discovery has been made."

msgid "STORY_EVENT@1013_565@BODY_LORE"
msgstr "\"I knew it,\" {EventHouseLord} yells in excitement, \"I knew that we of {EventHouse} are destined for greatness. Forgive my impulsiveness, O {PlayerLeader.Title}, but the wisest scholars among the {EventRace.Name} have been poring over countless scrolls delineating family trees and it seems evident that you and I... share common ancestors. Isn't this wonderful!?\""

msgid "STORY_EVENT@1013_565@BUTTON_0"
msgstr "\"Well, if it delights you, {EventHouseLord.FirstName}... You may call me cousin.\""

msgid "STORY_EVENT@1013_565@BUTTON_1"
msgstr "\"Me, related to the {EventRace}? Laughable!\" "

msgid "STORY_EVENT@1013_565@BUTTON_2"
msgstr "Avoid the subject."

msgid "STORY_EVENT@1013_565@BUTTON_3"
msgstr "\"All life is connected. Related or not, our people should live in harmony.\""

msgid "STORY_EVENT@1013_565@TITLE"
msgstr "Family Reunion"

msgid "STORY_EVENT@1013_566@BODY_FOOTER"
msgstr "Silence descends on the gathering. All look to you, expecting you to perform the famous dance..."

msgid "STORY_EVENT@1013_566@BODY_HEADER"
msgstr "During an illustrious gathering to advance your political bonds with {EventHouse}, {EventHouseLord} boasts about <<o:EventHouseLord>> dancers."

msgid "STORY_EVENT@1013_566@BODY_LORE"
msgstr "\"We of {EventHouse} may not have the military might of a {PlayerLeader.Title}, but the {EventRace} have dancers who know no equal in this realm!\"[br/][br/]Incited by the atmosphere and one drink too many, one of your courtiers rises up, claiming you are better. \"{PlayerLeader.TitleName} is the epitome of grace! Hic! <<p:PlayerLeader>> can dance the fabled Dance of the 10,000 Veils!\" "

msgid "STORY_EVENT@1013_566@BUTTON_0"
msgstr "\"Dance? 10,000 veils? Sure! how hard can it be?\""

msgid "STORY_EVENT@1013_566@BUTTON_1"
msgstr "Call forth [mana/] a captivating tune, inspiring everyone else to dance instead."

msgid "STORY_EVENT@1013_566@BUTTON_2"
msgstr "\"Hear that drunkard? A coin [gold/] to whoever makes him dance!\""

msgid "STORY_EVENT@1013_566@BUTTON_3"
msgstr "\"I have studied the Dance of the 10,000 Veils for years. Observe!\""

msgid "STORY_EVENT@1013_566@BUTTON_4"
msgstr "\"<<m:PlayerLeader.Title>> don't dance. They are entertained. Music! Dancers!\""

msgid "STORY_EVENT@1013_566@TITLE"
msgstr "A Perilous Dance"

msgid "STORY_EVENT@1013_568@BODY_FOOTER"
msgstr "{EventHero.Name} would appreciate it if you forge a {EventPact.Hyperlink} with {EventCity}, <<g:city of origin^n,EventHero>>."

msgid "STORY_EVENT@1013_568@BODY_HEADER"
msgstr "{EventHero.Name} asks to speak to you. \"As you know I was born in {EventCity.Name}, a city I still hold dear.\""

msgid "STORY_EVENT@1013_568@BODY_LORE"
msgstr "\"Barely a day goes by without me thinking about my hometown. The bright lights in the towers at night, the hubbub of the marketplace... It's unlike any other. A particular thought has become a growing obsession with me, and I must speak my mind, my {PlayerLeader.Title}, for it would bring me much joy if you forged a closer bond with {EventCity.Name}.\""

msgid "STORY_EVENT@1013_568@BUTTON_0"
msgstr "\"Together with {EventCity.Name} we shall prosper.\""

msgid "STORY_EVENT@1013_568@BUTTON_2"
msgstr "\"I do not have time for {EventCity.Name}.\""

msgid "STORY_EVENT@1013_568@TITLE"
msgstr "City of Birth"

msgid "STORY_EVENT@1013_569@BODY_FOOTER"
msgstr "\"You have done me and my beloved {EventCity.Name} a great favor. Please, tell me what we can do for you.\""

msgid "STORY_EVENT@1013_569@BODY_HEADER"
msgstr "You have successfully forged a {EventPact.Hyperlink} with {EventCity.Name}. {EventHero.Name} is grateful."

msgid "STORY_EVENT@1013_569@BODY_LORE"
msgstr "\"I am glad you have seen the beauty of {EventCity.Name}, {PlayerLeader.TitleName}, and even gladder to know it sheltered by your protecting hand. My heart is at peace, yet my spirit is kindled evermore to perform great deeds in your name!\""

msgid "STORY_EVENT@1013_569@BUTTON_0"
msgstr "\"Through tale and song, you shall herald the glory [influence/] of my empire.\""

msgid "STORY_EVENT@1013_569@BUTTON_1"
msgstr "\"Further the bonds with {EventHouseLord} of {EventCity} even more.\""

msgid "STORY_EVENT@1013_569@BUTTON_3"
msgstr "\"Convoke the lieges [unit/] of {EventCity} to reinforce my armies.\""

msgid "STORY_EVENT@1013_569@TITLE"
msgstr "City of Birth: Aftermath"

msgid "STORY_EVENT@1013_573@BODY_FOOTER"
msgstr "The hellspawn cannot get away with their flagrant rampage. Won't you save your people and purge these devils, Holy {PlayerLeader.Title}?"

msgid "STORY_EVENT@1013_573@BODY_HEADER"
msgstr "After bolstering your empire through order and discipline, you receive reports that demons are assembling near {EventCity}, striking fear into your citizens' hearts."

msgid "STORY_EVENT@1013_573@BODY_LORE"
msgstr "The fiendish infestation, demons who either killed or escaped their masters, are led by a gruesome {EventStackLeader}. Like diabolical moths, the infernal deviants are drawn to the gleaming light that hallows your empire, preying on the meek and weak-willed among your followers. Several pious citizens have reportedly been tempted, seduced, tricked, compromised, or simply slain by these godless guests."

msgid "STORY_EVENT@1013_573@BUTTON_0"
msgstr "\"These profane invaders will be cleansed by my holy fire!\""

msgid "STORY_EVENT@1013_573@BUTTON_1"
msgstr "\"After they've devoured the faithless, these orderless demons will surely scatter.\""

msgid "STORY_EVENT@1013_573@BUTTON_2"
msgstr "\"An unchecked {EventStackLeader}? My zealous incantations [mana/] will dominate [unit/] it [ordercrisis/]!\""

msgid "STORY_EVENT@1013_573@TITLE"
msgstr "Infernal Invaders"

msgid "STORY_EVENT@1013_574@BODY_FOOTER"
msgstr "From {EventCity}, inquisitive citizens prepare to pilfer the abandoned hoard. You must declare what is yours and what is theirs to collect."

msgid "STORY_EVENT@1013_574@BODY_FOOTER@NO_CITY"
msgstr "As your troops begin to pilfer the abandoned hoard, you must declare what is yours and what is theirs to collect."

msgid "STORY_EVENT@1013_574@BODY_HEADER"
msgstr "The impious demons are vanquished! Divine order is restored to your realm. Scouts report what the fiends stockpiled in their nest."

msgid "STORY_EVENT@1013_574@BODY_LORE"
msgstr "The unholy invaders had raided the surrounding lands for several days. Bloodstained treasure is piled high on the nest's edges. Perched atop the highest heap, a {EventItem} is found, riddled with claw marks. Dozens of dead animals were dragged into the center of the rallying point. Some of the slain cattle is partially devoured, but most fresh carcasses remain untouched."

msgid "STORY_EVENT@1013_574@BUTTON_0"
msgstr "Take the besmirched treasure [gold/] and order it to be washed clean."

msgid "STORY_EVENT@1013_574@BUTTON_1"
msgstr "Send the untainted carcasses [food/] to {EventCity} before rot sets in."

msgid "STORY_EVENT@1013_574@BUTTON_3"
msgstr "Claim the {EventItem} to commemorate your pious might."

msgid "STORY_EVENT@1013_574@BUTTON_4"
msgstr "Take all rewards [gold/] [food/] [item/] for yourself. They do not befit commoners [evilact/]."

msgid "STORY_EVENT@1013_574@TITLE"
msgstr "Infernal Invaders: Aftermath"

msgid "STORY_EVENT@1013_577@BODY_FOOTER"
msgstr "{GLOBAL.ElyaLoreConcept.Hyperlink} the Maer joins you as you leave for Magehaven, victorious."

msgid "STORY_EVENT@1013_577@BODY_HEADER"
msgstr "You have cast the Siren Goddess into the void and claimed the Enchanted Archipelago from her drowning embrace!"

msgid "STORY_EVENT@1013_577@BODY_LORE"
msgstr "From your capital, the mythical {GLOBAL.MaerLoreConcept.Hyperlink} emerges once more. \"I thank you, {PlayerLeader.TitleName}, for hearing my song and freeing the realm. I fear I have naught that resembles a {GLOBAL.GodirLoreConcept.Hyperlink}'s reward... But if you allow me to join you on your travels, I may share what I have learned as Nimue's prisoner.\""

msgid "STORY_EVENT@1013_577@BODY_LORE@ELYA_NOT_FREED"
msgstr "From her hidden prison a mythical {GLOBAL.MaerLoreConcept.Hyperlink} emerges, floating on unseen currents. \"I thank you, {PlayerLeader.TitleName}, for hearing my song and freeing the realm. My name is {GLOBAL.ElyaLoreConcept.Hyperlink}. I fear I have naught to give as a reward for a Godir... But if you allow me to join you on your travels, I may share what I have learned as Nimue's prisoner.\""

msgid "STORY_EVENT@1013_577@BUTTON_0"
msgstr "Elya the Maer joins you as you leave for Magehaven victoriously."

msgid "STORY_EVENT@1013_577@TITLE"
msgstr "The Enchanted Archipelago: Victory"

msgid "STORY_EVENT@1013_614@BODY_FOOTER"
msgstr "\"Great {PlayerLeader.Title}, can you relieve us of these dissenters?\""

msgid "STORY_EVENT@1013_614@BODY_HEADER"
msgstr "Your [hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink] {EventHero.Name}, appointed governor of {EventCity.Name}, approaches you in distress."

msgid "STORY_EVENT@1013_614@BODY_LORE"
msgstr "\"Wise {PlayerLeader.Title}, I would like to ask for your advice on the following matter. A group of disgruntled veterans have been stirring up trouble in the city. They have set up camp just outside the gates, where they continue to sow dissent and make demands. Yet, the city guard does not want to take up arms against their own.\""

msgid "STORY_EVENT@1013_614@BUTTON_0"
msgstr "\"I will deal with these insurrectionists.\""

msgid "STORY_EVENT@1013_614@BUTTON_2"
msgstr "\"Are you not the governor of {EventCity}, {EventHero}? You will find a solution.\""

msgid "STORY_EVENT@1013_614@TITLE"
msgstr "Troublesome Veterans"

msgid "STORY_EVENT@1013_615@BODY_FOOTER"
msgstr "\"It seems the veterans of the city are eager to show their worth once more. What should we have them do?\""

msgid "STORY_EVENT@1013_615@BODY_HEADER"
msgstr "You dealt with the disgruntled veterans and restored peace to {EventCity}. {EventHero} is relieved."

msgid "STORY_EVENT@1013_615@BODY_LORE"
msgstr "\"Thank you, {PlayerLeader.TitleName}, for restoring order in {EventCity.Name}. The citizens are very impressed by your actions. They won't rise up again for a while. Even the elderly are more motivated than ever!\""

msgid "STORY_EVENT@1013_615@BUTTON_0"
msgstr "Give them a say in the {EventRace} council. [happiness/]"

msgid "STORY_EVENT@1013_615@BUTTON_1"
msgstr "Let them protect trade caravans [gold/] traveling to and from {EventCity.Name}."

msgid "STORY_EVENT@1013_615@BUTTON_3"
msgstr "Use their experience to train [unitprod/] the guards of {EventCity.Name}."

msgid "STORY_EVENT@1013_615@TITLE"
msgstr "Troublesome Veterans: Aftermath"

msgid "STORY_EVENT@1013_616@BODY_FOOTER"
msgstr "\"We do not wish to fight you, o {PlayerLeader.Title}. But we will fight for the well-being of those who served you.\""

msgid "STORY_EVENT@1013_616@BODY_HEADER"
msgstr "You encounter the insurrectionists of {EventCity}, a group commanded by a {EventStackLeader}, who takes a brave stance when seeing your troops."

msgid "STORY_EVENT@1013_616@BODY_LORE"
msgstr "\"So you've heard about our protest?\" <<p:EventStackLeader>> asks. \"Then you must have heard about the way we are treated, too. Long have we guarded your city, fought alongside you. But what then? The old and wounded are tossed aside, like old dishrags. No more! Our work and sacrifice deserves respect. We demand food and shelter for the wounded and elderly!\""

msgid "STORY_EVENT@1013_616@BUTTON_0"
msgstr "\"You made your bed, now die in it. [evilact/] To battle!\""

msgid "STORY_EVENT@1013_616@BUTTON_1"
msgstr "\"I will make sure the veterans of {EventCity} are looked after [food/].\" [goodact/]"

msgid "STORY_EVENT@1013_616@BUTTON_2"
msgstr "\"Please return to {EventCity.Name} [population/], I promise you will no longer go unrecognized.\""

msgid "STORY_EVENT@1013_616@BUTTON_3"
msgstr "Leave."

msgid "STORY_EVENT@1013_616@TITLE"
msgstr "Encountering Troublesome Veterans"

msgid "STORY_EVENT@1013_645@BODY_FOOTER"
msgstr "Will you conquer {EventHouse.Name} for the {EventRace.Name}?"

msgid "STORY_EVENT@1013_645@BODY_HEADER"
msgstr "The Council of the {EventRace.Name} requests an audience concerning the war with the independent city of {EventHouse.Name}."

msgid "STORY_EVENT@1013_645@BODY_LORE"
msgstr "\"{PlayerLeader.TitleName}, our protector, we want to lay before you the misdeeds of {EventHouse.Name} against our people. Since the war broke out innocent {EventRace.Name} have been subject to persecution and murder. For us this war with {EventHouse.Name} can only end in one way: with the end of the dynasty of {EventHouseLord.TitleName}, the instigators of this murderous campaign.\""

msgid "STORY_EVENT@1013_645@BUTTON_0"
msgstr "\"You will have their heads.\""

msgid "STORY_EVENT@1013_645@BUTTON_1"
msgstr "\"Wanton destruction brings no profit. I will find more lucrative ways [materiumboon/] to use {EventHouse.Name}.\""

msgid "STORY_EVENT@1013_645@BUTTON_2"
msgstr "\"There could still be other ways to resolve this conflict.\""

msgid "STORY_EVENT@1013_645@TITLE"
msgstr "Heads on a Platter"

msgid "STORY_EVENT@1013_646@BODY_FOOTER"
msgstr "\"How do you wish your people to remember this momentous day, oh {PlayerLeader.Title} of the {EventRace}?\""

msgid "STORY_EVENT@1013_646@BODY_HEADER"
msgstr "You have defeated {EventHouse.Name}. The Council of the {EventRace} rejoices."

msgid "STORY_EVENT@1013_646@BODY_LORE"
msgstr "\"Blood for blood. Bone for bone. The end of {EventHouse} gives comfort to all {EventRace} who had to suffer by their hands. The spoils of conquest will not mend all wounds, but they spread a sense of justice even if some wrongs may never be repaid.\""

msgid "STORY_EVENT@1013_646@BUTTON_0"
msgstr "\"Remember the glorious battles [unitprod/] that brought down our enemies.\""

msgid "STORY_EVENT@1013_646@BUTTON_1"
msgstr "\"Remember our grand cities [structureprod/], whose walls gave shelter to us all.\""

msgid "STORY_EVENT@1013_646@TITLE"
msgstr "Heads on a Platter: Aftermath"

msgid "STORY_EVENT@1013_682@BODY_FOOTER"
msgstr "Will you stop these ice creatures before they freeze everything within their grasp?"

msgid "STORY_EVENT@1013_682@BODY_HEADER"
msgstr "Through fate or blind luck, the currents of change and chaos bring your attention to a chilling scene."

msgid "STORY_EVENT@1013_682@BODY_LORE"
msgstr "A {EventStackLeader} and <<o:EventStackLeader>> frost-ridden followers are slowly turning the area around them to ice. They freeze the earth, beast and man alike, leaving behind a desolate lifeless wasteland. All will to live, movement and impulse is quenched as if the entire region had become frozen in time."

msgid "STORY_EVENT@1013_682@BUTTON_0"
msgstr "\"Winter is over. Let's melt some ice!\""

msgid "STORY_EVENT@1013_682@BUTTON_1"
msgstr "\"Change comes and goes. Their ice won't last for long.\""

msgid "STORY_EVENT@1013_682@BUTTON_2"
msgstr "\"Stop them? I will support [mana/] this experiment in freezing!\" "

msgid "STORY_EVENT@1013_682@TITLE"
msgstr "Eternal Freeze"

msgid "STORY_EVENT@1013_683@BODY_FOOTER"
msgstr "What reward do you choose to save before chaos reduces it to astral dust?"

msgid "STORY_EVENT@1013_683@BODY_HEADER"
msgstr "With the frost creatures gone, their magical ice starts to melt."

msgid "STORY_EVENT@1013_683@BODY_LORE"
msgstr "Icicles shatter and water drips as the cold fades away, revealing various objects that had been locked in the ice. You see weapons, gold, and a stack of books. But, as the ice melts, chaos and decay make up for lost time, for you can see the objects deteriorate in front of your very eyes. You have to choose fast."

msgid "STORY_EVENT@1013_683@BUTTON_0"
msgstr "Grab a {EventItem} [item/]."

msgid "STORY_EVENT@1013_683@BUTTON_1"
msgstr "Grab a chest of riches [gold/]."

msgid "STORY_EVENT@1013_683@BUTTON_3"
msgstr "Grab a tome of ancient knowledge [knowledge/]."

msgid "STORY_EVENT@1013_683@BUTTON_4"
msgstr "Let all the objects decay and gather the magical reagents afterwards. [Mana/]"

msgid "STORY_EVENT@1013_683@TITLE"
msgstr "Eternal Freeze: Aftermath"

msgid "STORY_EVENT@1013_695@BODY_FOOTER"
msgstr "{EventHouseLord} asks for your permission to breed <<o:EventHouseLord>> own mount with your {EventMount}."

msgid "STORY_EVENT@1013_695@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of {EventHouse} seeks a favor concerning your mount."

msgid "STORY_EVENT@1013_695@BODY_LORE"
msgstr "\"Great {PlayerLeader.Title}, you ride a {EventMount} almost matching your own grace and power. Meanwhile my faithful {HouseLordMount} was wounded and I can no longer ride <<p:HouseLordMount>> into battle. I humbly ask you to consider breeding yours with mine. With some {GLOBAL.GodirLoreConcept.Hyperlink} magic, I expect our combined mounts will make a magnificent creature that will bring new glory to {EventHouse}.\""

msgid "STORY_EVENT@1013_695@BUTTON_0"
msgstr "\"No! Such crimes against nature [natureboon/] would only produce abominations.\""

msgid "STORY_EVENT@1013_695@BUTTON_1"
msgstr "\"For a generous compensation [gold/] I may allow our mounts to breed.\""

msgid "STORY_EVENT@1013_695@BUTTON_2"
msgstr "\"No, you may not breed my mount.\""

msgid "STORY_EVENT@1013_695@BUTTON_3"
msgstr "\"In all my generosity, I will gift you my {EventMount}.\""

msgid "STORY_EVENT@1013_695@BUTTON_4"
msgstr "\"They may breed, but their first offspring [mount/] is mine.\""

msgid "STORY_EVENT@1013_695@TITLE"
msgstr "Quality Breeding"

msgid "STORY_EVENT@1013_721@BODY_FOOTER"
msgstr "This rebellious scribe is only a symptom of the underlying {GLOBAL.CityStabilityConcept.Hyperlink} issues this city is facing."

msgid "STORY_EVENT@1013_721@BODY_HEADER"
msgstr "You have neglected the needs of your populace in {EventCity.Name} and now someone in your city is writing inciting poetry on the buildings."

msgid "STORY_EVENT@1013_721@BODY_LORE"
msgstr "The guards drag in a young scribe who looks at you defiantly. \"You don't care about us,\" <<p:EventUnit>> says, \"not unless we damage your legacy. Do what you must, your people already know what type of {GLOBAL.GodirLoreConcept.Hyperlink} you are.\" The city guards look to you with unease and the scribe closes <<o:EventUnit>> eyes, awaiting your judgment."

msgid "STORY_EVENT@1013_721@BUTTON_0"
msgstr "Pay [gold/] to have the writing removed. [happiness/]"

msgid "STORY_EVENT@1013_721@BUTTON_1"
msgstr "Use your transmutation powers to restore the walls. [happiness/]"

msgid "STORY_EVENT@1013_721@BUTTON_2"
msgstr "Set the scribe free. [goodact/] Criticism is a gift."

msgid "STORY_EVENT@1013_721@BUTTON_3"
msgstr "Publicly execute the scribe [evilact/]. That should be a lesson to all. [happiness/]"

msgid "STORY_EVENT@1013_721@BUTTON_4"
msgstr "\"I have no time for this.\""

msgid "STORY_EVENT@1013_721@TITLE"
msgstr "Writing on the Wall"

msgid "STORY_EVENT@1013_722@BODY_FOOTER"
msgstr "<<Co:EventHeroB>> pensive gaze shifts to the {EventStructure}. \"I do not ask this lightly, <<EventHero{hero/heroine}>>... But this corrupted {EnemyUnit} must be stopped.\""

msgid "STORY_EVENT@1013_722@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "<<Co:EventHeroB>> pensive gaze shifts to the {EventStructure}. \"I do not ask this lightly, o {PlayerLeader.Title}... But this corrupted {EnemyUnit} must be stopped.\""

msgid "STORY_EVENT@1013_722@BODY_HEADER"
msgstr "While approaching the majestic {EventStructure}, {EventHero.Name} is stopped by a regal {EventHeroB.Title} emerging from a hut nearby."

msgid "STORY_EVENT@1013_722@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "While approaching the majestic {EventStructure}, you are stopped by a regal {EventHeroB.Title} emerging from a hut nearby."

msgid "STORY_EVENT@1013_722@BODY_LORE"
msgstr "<<Cp:EventHeroB>> greets {EventHero} warmly. \"I bid thee well, traveler. My fellow Guardians of the Tree and I once saved it from being destroyed by demons, undead and even mortals. Now, though, an unexpected enemy threatens us... one of our own! Corruption has taken hold of the {EnemyUnit}, who has taken to consuming the life of the Tree itself.\""

msgid "STORY_EVENT@1013_722@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "<<Cp:EventHeroB>> greets you warmly. \"I bid thee well, o {PlayerLeader.Title}. My fellow Guardians of the Tree and I once saved it from being destroyed by demons, undead and even mortals. Now, though, an unexpected enemy threatens us... one of our own! Corruption has taken hold of the {EnemyUnit}, who has taken to consuming the life of the Tree itself.\""

msgid "STORY_EVENT@1013_722@BUTTON_0"
msgstr "\"I will free the {EventStructure} from this corrupted {EnemyUnit}.\""

msgid "STORY_EVENT@1013_722@BUTTON_1"
msgstr "\"Grant me the <<G:support^n,EventStructure>> [mana/] and I will protect it.\""

msgid "STORY_EVENT@1013_722@BUTTON_3"
msgstr "Back away."

msgid "STORY_EVENT@1013_722@BUTTON_4"
msgstr "Call upon the power of the {EventStructure} yourself."

msgid "STORY_EVENT@1013_722@TITLE"
msgstr "Corrupted Guardian"

msgid "STORY_EVENT@1013_723@BODY_FOOTER"
msgstr "Then <<p:EventHeroB>> smiles. \"Enough lectures. The {EventStructure} and its guardians are indebted to you, brave <<EventHero{hero/heroine}>>. State your wish.\""

msgid "STORY_EVENT@1013_723@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Then <<p:EventHeroB>> smiles. \"Enough lectures. The {EventStructure} and its guardians are indebted to you, o {PlayerLeader.Title}. State your wish.\""

msgid "STORY_EVENT@1013_723@BODY_HEADER"
msgstr "The wise {EventHeroB.Title} greets {EventHero.FirstName} after the sounds of battle have faded. \"Thank you. Now the {EventStructure} can heal once more.\" "

msgid "STORY_EVENT@1013_723@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "The wise {EventHeroB.Title} greets you after the sounds of battle have faded. \"Thank you. Now the {EventStructure} can heal once more.\" "

msgid "STORY_EVENT@1013_723@BODY_LORE"
msgstr "\"I know you seek resources to strengthen your forces,\" <<Cp:EventHeroB>> says, before <<p:EventHeroB>> looks upon the fallen enemies who once stood with <<P:EventHeroB>>. \"... Obsession corrupts the purest of souls. Be careful that your quest for power does not corrupt the things you once cherished. Even the grandest tree will fall when its roots are rotting.\""

msgid "STORY_EVENT@1013_723@BUTTON_0"
msgstr "\"I seek for my population in {EventCity} to grow [food/] with the Tree's blessing.\""

msgid "STORY_EVENT@1013_723@BUTTON_1"
msgstr "\"I seek aid [unit/] from the other guardians of the {EventStructure}.\""

msgid "STORY_EVENT@1013_723@BUTTON_2"
msgstr "\"Do not lecture me on greed. Give me the {EventItem} [item/] your corrupted guardian carried.\" [evilact/]"

msgid "STORY_EVENT@1013_723@BUTTON_4"
msgstr "\"Allow me to commune [natureboon/] with the Tree, noble {EventHeroB.Title}.\""

msgid "STORY_EVENT@1013_723@TITLE"
msgstr "Corrupted Guardian: Aftermath"

msgid "STORY_EVENT@1013_724@BODY_FOOTER"
msgstr "<<Cg:troops^n,EventHero>> scramble and shout in confusion as their reflections come to life and reveal themselves to be <<m:EnemyUnit>>. "

msgid "STORY_EVENT@1013_724@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Your troops scramble and shout in confusion as their reflections come to life and reveal themselves to be <<m:EnemyUnit>>. "

msgid "STORY_EVENT@1013_724@BODY_HEADER"
msgstr "{EventHero.Name} enters a forest of glowing crystal formations, showing eerie reflections of {EventHero.FirstName} and <<o:EventHero>> troops."

msgid "STORY_EVENT@1013_724@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "You enter a forest of glowing crystal formations, showing eerie reflections of you and your troops."

msgid "STORY_EVENT@1013_724@BODY_LORE"
msgstr "As <<p:EventHero>> keeps going through the forest, memories overwhelm <<P:EventHero>>. Reflections of <<r:EventHero>> fade into visions of the past, present and future, into memories of the good and bad things that <<p:EventHero>> has wrought. <<Co:EventHero>> troops weep and wail, apologizing to their own mirror images. Then, the visions start to take physical form... as creatures appear from the crystal maze."

msgid "STORY_EVENT@1013_724@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "As you keep going through the forest, memories overwhelm you. Reflections of yourself fade into visions of the past, present and future, into memories of the good and bad things that you have wrought. Your troops weep and wail, apologizing to their own mirror images. Then, the visions start to take physical form... as creatures appear from the crystal maze."

msgid "STORY_EVENT@1013_724@BUTTON_0"
msgstr "\"Do not despair! To arms!\""

msgid "STORY_EVENT@1013_724@BUTTON_1"
msgstr "Use your mystic knowledge to fortify your troops against the <<m:EnemyUnit>>."

msgid "STORY_EVENT@1013_724@BUTTON_2"
msgstr "Retreat before the reflections get a hold of you."

msgid "STORY_EVENT@1013_724@BUTTON_3"
msgstr "\"Be not afraid, troops! These mirrors can break like any other!\""

msgid "STORY_EVENT@1013_724@BUTTON_4"
msgstr "Use magic [mana/] to fortify your troops against the <<m:EnemyUnit>>."

msgid "STORY_EVENT@1013_724@TITLE"
msgstr "Reflections"

msgid "STORY_EVENT@1013_725@BODY_FOOTER"
msgstr "The reflections of the {EventStructure.Name} now show fond memories of the past. {EventHero.FirstName} gazes into the crystal and remembers..."

msgid "STORY_EVENT@1013_725@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "The reflections of the {EventStructure.Name} now show fond memories of the past. You gaze into the crystal and remember..."

msgid "STORY_EVENT@1013_725@BODY_HEADER"
msgstr "As the ambush of the strange reflections dissipates, <<g:troops^p,EventHero>> sigh in relief. The {EventStructure.Name} pulsates with a new energy."

msgid "STORY_EVENT@1013_725@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "As the ambush of the strange reflections dissipates, your troops sigh in relief. The {EventStructure.Name} pulsates with a new energy."

msgid "STORY_EVENT@1013_725@BODY_LORE"
msgstr "{EventHero.FirstName} sees a path with many forks up ahead, each one leading to freedom. The crystals shimmer and <<g:troops^p,EventHero>> smile as the new reflections show fond memories from their past. If only for a moment, they find solace and peace within this forest of crystal. {EventHero.FirstName} goes to take a closer look at the crystals <<r:EventHero>>."

msgid "STORY_EVENT@1013_725@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "You see a path with many forks up ahead, each one leading to freedom. The crystals shimmer and your troops smile as the new reflections show fond memories from their past. If only for a moment, they find solace and peace within this forest of crystal. You go to take a closer look at the crystals yourself."

msgid "STORY_EVENT@1013_725@BUTTON_0"
msgstr "Remember when {EventHero.FirstName} earned <<o:EventHero>> first wages [gold/]."

msgid "STORY_EVENT@1013_725@BUTTON_0@HERO_IS_PLAYERLE"
msgstr "Remember when you earned your first coin [gold/]."

msgid "STORY_EVENT@1013_725@BUTTON_1"
msgstr "Remember when {EventHero.FirstName} made <<o:EventHero>> first true friend. [unit/]"

msgid "STORY_EVENT@1013_725@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "Remember when you first found companionship. [unit/]"

msgid "STORY_EVENT@1013_725@BUTTON_2"
msgstr "Remember <<o:EventHero>> first day training with a weapon [item/]."

msgid "STORY_EVENT@1013_725@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "Remember your first day training with a weapon [item/]."

msgid "STORY_EVENT@1013_725@BUTTON_3"
msgstr "Remember the day {EventHero.FirstName} cast <<o:EventHero>> first spell [mana/]."

msgid "STORY_EVENT@1013_725@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "Remember the day you cast your first spell [mana/]."

msgid "STORY_EVENT@1013_725@BUTTON_4"
msgstr "Remember the first day {EventHero.FirstName} became a hero [happiness/] among <<o:EventHero>> people."

msgid "STORY_EVENT@1013_725@BUTTON_4@HERO_IS_PLAYERLE"
msgstr "Remember the first day you became a {PlayerLeader.Title} [happiness/] among your people."

msgid "STORY_EVENT@1013_725@TITLE"
msgstr "Reflections: Aftermath"

msgid "STORY_EVENT@1013_730@BODY_FOOTER"
msgstr "When the {EnemyUnit} notices {EventHero.FirstName} <<p:EnemyUnit>> rises to <<o:EnemyUnit>> full height, ready to fight off this claimant for <<o:EnemyUnit>> power."

msgid "STORY_EVENT@1013_730@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "When the {EnemyUnit} notices you, <<p:EnemyUnit>> rises to <<o:EnemyUnit>> full height, ready to fight off this challenge for <<o:EnemyUnit>> power."

msgid "STORY_EVENT@1013_730@BODY_HEADER"
msgstr "{EventHero} enters the looming {EventStructure}. Once it was a beacon of magical power. Now only fading remnants are left."

msgid "STORY_EVENT@1013_730@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "You enter the looming {EventStructure}. Once it was a beacon of magical power. Now only fading remnants are left."

msgid "STORY_EVENT@1013_730@BODY_LORE"
msgstr "As {EventHero.Name} ascends the twisting spire, an uncanny feeling overcomes <<P:EventHero>>. Then <<p:EventHero>> notices a {GLOBAL.LostWizardLoreConcept.Hyperlink} scurrying through the tower, frantically searching for... something. <<Cp:EnemyUnit>> suddenly stops when <<p:EnemyUnit>> finds a rotting book and picks up the tome with surprising care. The {EnemyUnit} trembles when the tome crumbles to dust in <<o:EnemyUnit>> claws, and releases a blood-curdling scream before continuing <<o:EnemyUnit>> frantic rampage."

msgid "STORY_EVENT@1013_730@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "As you ascend the twisting spire, an uncanny feeling overcomes you. Then you notice a {GLOBAL.LostWizardLoreConcept.Hyperlink} scurrying through the tower, frantically searching for... something. <<Cp:EnemyUnit>> suddenly stops when <<p:EnemyUnit>> finds a rotting book, picking up the tome with surprising care. The {EnemyUnit} trembles when the tome crumbles to dust in <<o:EnemyUnit>> tentacles, and releases a blood-curdling scream before continuing <<o:EnemyUnit>> frantic rampage."

msgid "STORY_EVENT@1013_730@BUTTON_0"
msgstr "Kill this {EnemyUnit}!"

msgid "STORY_EVENT@1013_730@BUTTON_1"
msgstr "Use raw magical prowess [mana/] to weaken the {EnemyUnit} against your attacks."

msgid "STORY_EVENT@1013_730@BUTTON_3"
msgstr "Call upon your great knowledge of the Astral Sea to weaken this {EnemyUnit} against your attacks."

msgid "STORY_EVENT@1013_730@BUTTON_4"
msgstr "Take out a book and burn it in front of the {EnemyUnit} to provoke <<P:EnemyUnit>>."

msgid "STORY_EVENT@1013_730@BUTTON_5"
msgstr "Back away and leave the tower."

msgid "STORY_EVENT@1013_730@TITLE"
msgstr "Undying Obsession"

msgid "STORY_EVENT@1013_731@BODY_FOOTER"
msgstr "A voice emanates from the floating orb, unaware {EventHero.FirstName} is not the wizard who resided here. \"What shall I retrieve from your treasury today?\""

msgid "STORY_EVENT@1013_731@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "A voice emanates from the floating orb, unaware you are not the wizard who resided here. \"What shall I retrieve from your treasury today?\""

msgid "STORY_EVENT@1013_731@BODY_HEADER"
msgstr "The threat in the {EventStructure} having been dealt with, {EventHero} is able to search the broken spire <<r:EventHero>>."

msgid "STORY_EVENT@1013_731@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "The threat in the {EventStructure} having been dealt with, you are able to search the broken spire yourself."

msgid "STORY_EVENT@1013_731@BODY_LORE"
msgstr "While rampaging through the tower, the {GLOBAL.LostWizardLoreConcept.Hyperlink} missed a secret door, one cleverly hidden by the wizard who resided here before. It leads to a well-protected treasury. All of its contents are in a remarkably good condition when compared to the rest of the {EventStructure}. In the center of the room, a floating orb hums and rises when {EventHero.FirstName} enters. \"Welcome back, master.\""

msgid "STORY_EVENT@1013_731@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "While rampaging through the tower, the {GLOBAL.LostWizardLoreConcept.Hyperlink} missed a secret door, one cleverly hidden by the wizard who resided here before. It leads to a well-protected treasury. All of its contents are in a remarkably good condition when compared to the rest of the {EventStructure}. In the center of the room, a floating orb hums and rises when you enter. \"Welcome back, master.\""

msgid "STORY_EVENT@1013_731@BUTTON_1"
msgstr "\"Hand me my strongest weapon.\" [item/]"

msgid "STORY_EVENT@1013_731@BUTTON_2"
msgstr "\"Bring me my wealth.\" [gold/]"

msgid "STORY_EVENT@1013_731@BUTTON_3"
msgstr "\"Summon my defenses.\" [unit/]"

msgid "STORY_EVENT@1013_731@BUTTON_4"
msgstr "\"Hand me my journals. I wish to learn about... my own domain.\" [influence/]"

msgid "STORY_EVENT@1013_731@TITLE"
msgstr "Undying Obsession: Aftermath"

msgid "STORY_EVENT@1013_732@BODY_FOOTER"
msgstr "{EventHero.FirstName} peers past the blacksmith, toward the collapsing {EventStructure}. A rumbling and roaring can be heard from within."

msgid "STORY_EVENT@1013_732@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "You peer past the blacksmith, toward the collapsing {EventStructure}. A rumbling and roaring can be heard from within."

msgid "STORY_EVENT@1013_732@BODY_HEADER"
msgstr "A grizzled blacksmith stands between {EventHero.Name} and an ancient forge. \"Forge's closed.\" <<Cp:EventUnit>> sighs, defeated."

msgid "STORY_EVENT@1013_732@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "A grizzled blacksmith stands between you and an ancient forge. \"Forge's closed.\" <<Cp:EventUnit>> sighs, defeated."

msgid "STORY_EVENT@1013_732@BODY_LORE"
msgstr "\"I think our work disturbed a {EnemyUnit} and <<o:EnemyUnit>> minions,\" the blacksmith laments. \"They are on a rampage, tearing the forge apart... We barely made it out alive. The entire structure is collapsing...\" the blacksmith wipes <<o:EventUnit>> sweaty forehead, tears welling up in <<o:EventUnit>> eyes. \"Our entire livelihood, gone.\""

msgid "STORY_EVENT@1013_732@BUTTON_0"
msgstr "\"I will save the {EventStructure.Name} from collapse. To arms!\""

msgid "STORY_EVENT@1013_732@BUTTON_1"
msgstr "Before entering, ask the blacksmiths [gold/] to enhance your army."

msgid "STORY_EVENT@1013_732@BUTTON_5"
msgstr "Leave the {EventStructure}."

msgid "STORY_EVENT@1013_732@BUTTON_6"
msgstr "Before entering, use your structural knowledge to predict any future collapse."

msgid "STORY_EVENT@1013_732@TITLE"
msgstr "Giants and Debris"

msgid "STORY_EVENT@1013_733@BODY_FOOTER"
msgstr "\"We will need some time to rebuild the {EventStructure}, but I can offer you one of our masterworks as a token of our gratitude.\""

msgid "STORY_EVENT@1013_733@BODY_HEADER"
msgstr "With the {EventStructure} saved, the blacksmith happily returns to {EventHero.Name}."

msgid "STORY_EVENT@1013_733@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "With the {EventStructure} saved, the blacksmith happily returns to you, bowing deeply."

msgid "STORY_EVENT@1013_733@BODY_LORE"
msgstr "The smiths of the forge immediately start to clear out the debris. \"We thank you, {EventHero.Name}...\" The blacksmith harrumphs as <<p:EventUnit>> lifts up a big chunk of debris, laughing as <<p:EventUnit>> reveals a locked chest. \"There it is! Our lockbox made it through!\" <<Cp:EventUnit>> opens it to reveal many masterfully crafted objects."

msgid "STORY_EVENT@1013_733@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "The smiths of the forge immediately start to clear out the debris. \"We thank you, {PlayerLeader.TitleName}.\" The blacksmith harrumphs as <<p:EventUnit>> lifts up a big chunk of debris, laughing as <<p:EventUnit>> reveals a locked chest. \"There it is! Our lockbox made it through!\" <<Cp:EventUnit>> opens it to reveal many masterfully crafted objects."

msgid "STORY_EVENT@1013_733@BUTTON_0"
msgstr "Take the {EventArmor}. [item/]"

msgid "STORY_EVENT@1013_733@BUTTON_1"
msgstr "Take the {EventWeapon}. [item/]"

msgid "STORY_EVENT@1013_733@BUTTON_2"
msgstr "Take the {EventTrinket}. [item/]"

msgid "STORY_EVENT@1013_733@BUTTON_3"
msgstr "\"Since you are so grateful, I will take all three objects.\" [item/] [evilact/]"

msgid "STORY_EVENT@1013_733@BUTTON_4"
msgstr "\"I need no reward for helping you.\" [goodact/]"

msgid "STORY_EVENT@1013_733@TITLE"
msgstr "Giants and Debris: Aftermath"

msgid "STORY_EVENT@1013_736@BODY_FOOTER"
msgstr "{EventHero.FirstName} realizes this is not a way out for <<P:EventHero>>... but a way in for otherworldly creatures, lurking beyond."

msgid "STORY_EVENT@1013_736@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "You realize this is not a way out for you... It's a way in for otherworldly creatures, lurking beyond."

msgid "STORY_EVENT@1013_736@BODY_HEADER"
msgstr "{EventHero} approaches the looming {EventStructure}. Its golden halls are lined with statues of ancient {GLOBAL.ArchonsLoreConcept.Hyperlink} looking down upon the visitors."

msgid "STORY_EVENT@1013_736@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "You approach the looming {EventStructure}. Its golden halls are lined with statues of ancient {GLOBAL.ArchonsLoreConcept.Hyperlink} looking down upon the visitors."

msgid "STORY_EVENT@1013_736@BODY_LORE"
msgstr "Before long {EventHero.FirstName} and <<o:EventHero>> troops enter a grand hall with a rune-covered arch at the opposite end. It is said these structures were once used as [hyperlink,GLOBAL.WorldGateLoreConcept]gates[/hyperlink] to other worlds, but this one has been dormant for ages... At least, until {EventHero.FirstName} steps inside. Suddenly the ancient arch crackles with energy and a star-lit vortex appears in its center. Shadows emerge behind the veil..."

msgid "STORY_EVENT@1013_736@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Before long you and your troops enter a grand hall with a rune-covered arch at the opposite end. It is said these structures were once used as [hyperlink,GLOBAL.WorldGateLoreConcept]gates[/hyperlink] to other worlds, but this one has been dormant for ages... At least, until you step inside. Suddenly the ancient arch crackles with energy and a star-lit vortex appears in its center. Shadows emerge behind the veil..."

msgid "STORY_EVENT@1013_736@BUTTON_0"
msgstr "\"Stand fast, troops! We will survive whatever steps through that gate!\""

msgid "STORY_EVENT@1013_736@BUTTON_1"
msgstr "Bolster your troops [mana/] against the astral invaders."

msgid "STORY_EVENT@1013_736@BUTTON_3"
msgstr "\"We will hold the {EventStructure}, shielded by the miracles of faith!\""

msgid "STORY_EVENT@1013_736@BUTTON_4"
msgstr "Use the magic that surges through the {EventStructure} to empower your own spells."

msgid "STORY_EVENT@1013_736@BUTTON_7"
msgstr "Retreat before the gate opens."

msgid "STORY_EVENT@1013_736@TITLE"
msgstr "Dormant Gate"

msgid "STORY_EVENT@1013_737@BODY_FOOTER"
msgstr "Whilst scholars trickle in to investigate the grand {EventStructure}, {EventHero.FirstName} can decide how to spend <<o:EventHero>> time before <<p:EventHero>> leaves."

msgid "STORY_EVENT@1013_737@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Whilst scholars trickle in to investigate the grand {EventStructure}, you can decide how to spend your time before you leave."

msgid "STORY_EVENT@1013_737@BODY_HEADER"
msgstr "{EventHero.Name} and <<o:EventHero>> troops have survived the onslaught at the {EventStructure}. Slowly, the gate closes and the magical energy in the air dissipates."

msgid "STORY_EVENT@1013_737@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "You and your troops have survived the onslaught at the {EventStructure}. Slowly, the gate closes and the magical energy in the air dissipates."

msgid "STORY_EVENT@1013_737@BODY_LORE"
msgstr "After catching <<o:EventHero>> breath, {EventHero.FirstName} can walk the golden halls with ease. Almost every surface is covered in runes and murals depicting legendary battles and journeys to unknown worlds. It does not take long for eager scholars from your empire to enter the {EventStructure} themselves, their muttered debates about its history and potential usages filling the once abandoned halls."

msgid "STORY_EVENT@1013_737@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "After catching your breath, you can walk the golden halls with ease. Almost every surface is covered in runes and murals depicting legendary battles and journeys to unknown worlds. It does not take long for eager scholars from your empire to enter the {EventStructure} themselves, their muttered debates about its history and potential usages filling the once abandoned halls."

msgid "STORY_EVENT@1013_737@BUTTON_0"
msgstr "Take the {EventItem} [item/] which rests in the center of the {EventStructure}."

msgid "STORY_EVENT@1013_737@BUTTON_1"
msgstr "Loot the {EventStructure} [gold/]."

msgid "STORY_EVENT@1013_737@BUTTON_2"
msgstr "\"The {EventStructure} will be a beacon of power [influence/] for my {PlayerLeader.Title}.\""

msgid "STORY_EVENT@1013_737@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "\"This {EventStructure} will be my beacon of power [influence/].\""

msgid "STORY_EVENT@1013_737@BUTTON_3"
msgstr "Stay and learn from the legends covering the golden walls."

msgid "STORY_EVENT@1013_737@TITLE"
msgstr "Dormant Gate: Aftermath"

msgid "STORY_EVENT@1013_790@BODY_FOOTER"
msgstr "Encroaching on {EventCity.Name}, the <<m:EventStackLeader>> cannot wait to start their first hoard!"

msgid "STORY_EVENT@1013_790@BODY_HEADER"
msgstr "A nest of draconic creatures has hatched near {EventCity.Name}, their [hyperlink,GLOBAL.DragonsLoreConcept]dragon[/hyperlink] nature compelling them to claim part of your domain."

msgid "STORY_EVENT@1013_790@BODY_LORE"
msgstr "They are fully grown yet too young to speak, but the demands of the majestic beasts are clear as they look at {EventCity.Name} with greedy eyes. Their parents taught them what a good nest smells and feels like. Filled with shiny, sparkly, metal things, to roll around and frolic in. To sleep on, and to protect. To hoard."

msgid "STORY_EVENT@1013_790@BUTTON_0"
msgstr "Leave some gold [gold/] outside of {EventCity.Name} to appease the {EventStackLeader.Name}."

msgid "STORY_EVENT@1013_790@BUTTON_1"
msgstr "Empty your treasury [gold/] to satisfy the greed of the entire {EventSpawner.Name} for a while."

msgid "STORY_EVENT@1013_790@BUTTON_2"
msgstr "{EventCity.Name} is not afraid of a few young dragons. Let them come."

msgid "STORY_EVENT@1013_790@BUTTON_3"
msgstr "Transmute rocks into a gilded hoard of false gold to trick the {EventStackLeader.Name}."

msgid "STORY_EVENT@1013_790@TITLE"
msgstr "Young Greed"

msgid "STORY_EVENT@1013_791@BODY_FOOTER"
msgstr "The [hyperlink,GLOBAL.DragonsLoreConcept]dragon[/hyperlink] grins through razor-sharp teeth. \"Will it be gold or blood?\""

msgid "STORY_EVENT@1013_791@BODY_HEADER"
msgstr "From the peaks of the {EventSpawner.Name} near your city {EventCity.Name}, a mighty shadow has descended to darken the skies."

msgid "STORY_EVENT@1013_791@BODY_LORE"
msgstr "A chilling roar echoes through the realm of {EventCity.Name} as the {EventStackLeader.Name} approaches, spreading its massive wings. \"You have settled in our domain without any right to do so,\" it utters in a roaring, guttural voice. \"Pay the tithe and you may yet be spared.\""

msgid "STORY_EVENT@1013_791@BUTTON_0"
msgstr "Sacrifice livestock [food/] to pay the blood tithe... for now."

msgid "STORY_EVENT@1013_791@BUTTON_1"
msgstr "Gather enough gold [gold/] to appease the dragons for a long time."

msgid "STORY_EVENT@1013_791@BUTTON_2"
msgstr "We do not fear <<m:EventStackLeader>>. Let them come."

msgid "STORY_EVENT@1013_791@BUTTON_3"
msgstr "Sacrifice some of your citizens [population/] for the greater good. [evilact/]"

msgid "STORY_EVENT@1013_791@BUTTON_4"
msgstr "Invoke a violent storm to best the dragons."

msgid "STORY_EVENT@1013_791@TITLE"
msgstr "Tributes from {EventCity}"

msgid "STORY_EVENT@1013_792@BODY_FOOTER"
msgstr "A {EventStackLeader} and its swarm fly closer and closer to {EventCity.Name}, attacking anyone they deem prey."

msgid "STORY_EVENT@1013_792@BODY_HEADER"
msgstr "Winged beasts have built a {EventSpawner} near {EventCity}, threatening your people."

msgid "STORY_EVENT@1013_792@BODY_LORE"
msgstr "Farmers are lamenting about the beasts swooping down on their livestock, leaving the animals mangled or worse. Traders arrive in the city with claw marks covering their carts. \"It's a nightmare,\" they say. \"We barely hear them coming before they descend. We try to steer clear of their territory, but it seems the birds venture further with every passing day.\""

msgid "STORY_EVENT@1013_792@BUTTON_0"
msgstr "Send the bravest men from {EventCity} [unitprod/] to fight off the immediate threat."

msgid "STORY_EVENT@1013_792@BUTTON_1"
msgstr "Muster all the city's men [unitprod/] to attack the nest. "

msgid "STORY_EVENT@1013_792@BUTTON_2"
msgstr "We are not afraid of <<m:EventStackLeader>>. Let them come."

msgid "STORY_EVENT@1013_792@BUTTON_3"
msgstr "Set the skies ablaze to drive off the flying beasts."

msgid "STORY_EVENT@1013_792@TITLE"
msgstr "Death from Above"

msgid "STORY_EVENT@1013_923@BODY_FOOTER"
msgstr "Artists from {EventHouse.Name} present their finest crafts to you in hopes of gaining your favor. Which one do you commend?"

msgid "STORY_EVENT@1013_923@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} has invited you to an event celebrating culture and artistry in {EventHouse.Name}."

msgid "STORY_EVENT@1013_923@BODY_LORE"
msgstr "Many aspiring master artists eagerly show off their work. An actor's monologue is interrupted by another artist claiming the stage, provoking glances of spite and jealousy. {EventHouseLord.Name} hums thoughtfully. \"Even our finest artists are not above competition and rivalry, it seems. They want us to pick the one we deem the best. Did any stand out for you, {PlayerLeader.TitleName}?\""

msgid "STORY_EVENT@1013_923@BUTTON_0"
msgstr "A dancer whose moves were as mesmerizing [chaosboon/] as the eddies of a storm."

msgid "STORY_EVENT@1013_923@BUTTON_1"
msgstr "A painter who caught the essence of the landscape [natureboon/] in a single stroke."

msgid "STORY_EVENT@1013_923@BUTTON_2"
msgstr "A sculptor who created a statue [materiumboon/] that will withstand the test of time."

msgid "STORY_EVENT@1013_923@BUTTON_3"
msgstr "A poet whose tale of friendship [orderboon/] almost brought a tear to your eye."

msgid "STORY_EVENT@1013_923@BUTTON_4"
msgstr "A singer who performed a truly enchanting [astralboon/] aria."

msgid "STORY_EVENT@1013_923@BUTTON_6"
msgstr "An actor who cleverly exposed the alliances and intrigues [influence/] at court."

msgid "STORY_EVENT@1013_923@BUTTON_7"
msgstr "Art is for the weak. [evilact/] You only appreciate the beauty of bloodshed and battle [unitprod/]."

msgid "STORY_EVENT@1013_923@BUTTON_8"
msgstr "A musician whose solemn song sent a chill [shadowboon/] down your spine."

msgid "STORY_EVENT@1013_923@TITLE"
msgstr "Art Competition"

msgid "STORY_EVENT@1013_925@BODY_FOOTER"
msgstr "{EventHouseLord.FirstName} gestures to the models. \"If it would please you, my {PlayerLeader.Title}, I would grant you the honor to choose the final design.\""

msgid "STORY_EVENT@1013_925@BODY_HEADER"
msgstr "{EventHouseLord.Name} of {EventHouse.Name} requests a moment of your time for a matter of construction."

msgid "STORY_EVENT@1013_925@BODY_LORE"
msgstr "\"As proud {EventRace.Name} we need to keep improving our city,\" {EventHouseLord.TitleName} explains. \"Our newest project will upgrade my own mansion. My architects have suggested a few designs.\" <<Cp:EventHouseLord>> reveals a few wooden models, flanked by nervous architects."

msgid "STORY_EVENT@1013_925@BUTTON_0"
msgstr "The design that used asymmetrical patterns as inspiration, with a new surprise in every corner. [chaosboon/]"

msgid "STORY_EVENT@1013_925@BUTTON_1"
msgstr "The design that included plenty of open plazas and gardens, including a grand central tree. [natureboon/]"

msgid "STORY_EVENT@1013_925@BUTTON_2"
msgstr "The design that was both sturdy and effective in its use of materials. [materiumboon/]"

msgid "STORY_EVENT@1013_925@BUTTON_3"
msgstr "The design whose grand hall was the focal point, encouraging all to bask in its glory. [orderboon/]"

msgid "STORY_EVENT@1013_925@BUTTON_4"
msgstr "The design that implemented tall towers and arcane patterns, almost reaching into the Astral Sea itself. [astralboon/]"

msgid "STORY_EVENT@1013_925@BUTTON_6"
msgstr "\"Those designs [structureprod/] look interesting. I'll take them. [evilact/]\""

msgid "STORY_EVENT@1013_925@BUTTON_7"
msgstr "\"For an offering [gold/] I will ask my builders to share their insights.\""

msgid "STORY_EVENT@1013_925@BUTTON_8"
msgstr "\"The imposing design that allows the wind to howl through, as though it were haunted.\" [shadowboon/]"

msgid "STORY_EVENT@1013_925@TITLE"
msgstr "Grand Plans"

msgid "STORY_EVENT@1013_927@BODY_FOOTER"
msgstr "{EventHouseLord.TitleName} asks you to think of a punishment for the {EventUnit.Name} who betrayed <<P:EventHouseLord>>."

msgid "STORY_EVENT@1013_927@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of {EventHouse.Name} has requested your insight on a matter of espionage and betrayal."

msgid "STORY_EVENT@1013_927@BODY_LORE"
msgstr "\"{PlayerLeader.Title}, it has come to my attention that my most trusted {EventUnit.Name} has betrayed me. <<Cp:EventUnit>> is conspiring with my rival, {EventHouseB.Name}, selling my defensive plans and the secrets of my—err... of a personal nature. As the {PlayerLeader.Title} in these lands, you are the one I humbly beseech to mete out a proper punishment so this will not happen again.\""

msgid "STORY_EVENT@1013_927@BUTTON_0"
msgstr "\"Curse a dagger so that it stabs <<P:EventUnit>> in the back forever, reflecting what <<p:EventUnit>> did to you.\" [chaosboon/]"

msgid "STORY_EVENT@1013_927@BUTTON_1"
msgstr "\"Make <<o:EventUnit>> food turn to ashes in <<o:EventUnit>> mouth, and <<o:EventUnit>> every drink taste like poison.\" [natureboon/]"

msgid "STORY_EVENT@1013_927@BUTTON_2"
msgstr "\"Curse <<o:EventUnit>> hands so everything and everyone <<p:EventUnit>> touches turns to stone.\" [materiumboon/]"

msgid "STORY_EVENT@1013_927@BUTTON_3"
msgstr "\"Curse <<o:EventUnit>> family and friends instead so that <<p:EventUnit>> will never have allies again.\" [orderboon/]"

msgid "STORY_EVENT@1013_927@BUTTON_4"
msgstr "\"Make sure <<p:EventUnit>> is tortured by visions of <<o:EventUnit>> betrayal every time <<p:EventUnit>> sleeps.\" [astralboon/]"

msgid "STORY_EVENT@1013_927@BUTTON_6"
msgstr "\"I will hire the {EventUnit.Name} instead. Betrayals are my specialty.\" [evilact/]"

msgid "STORY_EVENT@1013_927@BUTTON_7"
msgstr "\"Simple. Kill <<P:EventUnit>> and make <<P:EventUnit>> your undead thrall.\" [shadowboon/]"

msgid "STORY_EVENT@1013_927@BUTTON_8"
msgstr "\"You brought this on yourself, {EventHouseLord.Name}. I will not mete out a punishment.\" [goodact/]"

msgid "STORY_EVENT@1013_927@TITLE"
msgstr "A Personal Curse"

msgid "STORY_EVENT@1013_973@BODY_FOOTER"
msgstr "Which extra guest will you bring to the feast of {EventHouse.Name}?"

msgid "STORY_EVENT@1013_973@BODY_HEADER"
msgstr "To celebrate your alliance, {EventHouseLord.Name} of {EventHouse.Name} has invited you and one guest to a gala."

msgid "STORY_EVENT@1013_973@BODY_LORE"
msgstr "As expected, the gala will be packed with events. {EventHouseLord.TitleName} promises all sorts of extremely cultured entertainment. There's a debate, a stage for performances, and ample opportunities to forge bonds with other cities of the realm. You can only send one extra guest, though."

msgid "STORY_EVENT@1013_973@BUTTON_0"
msgstr "Bring your best architect [structureprod/] from {EventCity.Name} to be inspired by {EventHouse.Name}."

msgid "STORY_EVENT@1013_973@BUTTON_1"
msgstr "Bring an entourage [influence/] to stress the importance of your realm."

msgid "STORY_EVENT@1013_973@BUTTON_2"
msgstr "Bring the wisest scholar [knowledge/] from {EventCity.Name} to lead the debate."

msgid "STORY_EVENT@1013_973@BUTTON_3"
msgstr "Bring your best tradesman [gold/] to improve trade with {EventCity.Name}."

msgid "STORY_EVENT@1013_973@TITLE"
msgstr "Civilized Gala"

msgid "STORY_EVENT@1038_10@BODY_FOOTER"
msgstr "The bard wishes to write a song for you. What sentiment do you want it to convey?"

msgid "STORY_EVENT@1038_10@BODY_HEADER"
msgstr "You have treated your citizens in {EventCity.Name} well. Now a famed bard contacts you with a charming smile wreathing <<o:EventUnit>> face."

msgid "STORY_EVENT@1038_10@BODY_LORE"
msgstr "\"It is an honor to speak with you, great {PlayerLeader.TitleName}!\" the flamboyant musician says, strumming a lute. \"I am known throughout the realm as a humble bard, storyteller, and lyricist extraordinaire. Your legend is truly inspiring to me. I simply must write a ballad about you. A song worthy of your legacy!\""

msgid "STORY_EVENT@1038_10@BUTTON_0"
msgstr "\"Make it a song that instills power [unitprod/] and obedience!\""

msgid "STORY_EVENT@1038_10@BUTTON_1"
msgstr "\"Make it a song my troops will sing [morale/] when they go to battle!\""

msgid "STORY_EVENT@1038_10@BUTTON_2"
msgstr "\"Make it an inspiring working song! [structureprod/] [food/] [knowledge/].\""

msgid "STORY_EVENT@1038_10@BUTTON_3"
msgstr "\"A song about honor and benevolence [influence/]. We must stand together to thrive.\""

msgid "STORY_EVENT@1038_10@BUTTON_4"
msgstr "\"A song that instills terror [influence/], intimidating my allies and enemies alike.\""

msgid "STORY_EVENT@1038_10@TITLE"
msgstr "Song of Ages"

msgid "STORY_EVENT@1038_174@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} to you."

msgid "STORY_EVENT@1038_174@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} greets you with graceful hesitation."

msgid "STORY_EVENT@1038_174@BODY_LORE"
msgstr "\"Greetings {PlayerLeader.Name}. In truth, we find your ways abhorrent, perhaps even disgusting... Yet, I must say that I am intrigued. We may yet find an accord between {EventHouse.Name} and yourself. Our path forward should prove interesting, at the very least.\""

msgid "STORY_EVENT@1038_174@BUTTON_0"
msgstr "Engage in discussions with these pretentious cretins."

msgid "STORY_EVENT@1038_174@BUTTON_1"
msgstr "Leave their dismissive presence for the moment."

msgid "STORY_EVENT@1038_174@TITLE"
msgstr "Meeting Snobby {EventHouse.Name}"

msgid "STORY_EVENT@1038_175@BODY_FOOTER"
msgstr "A {EventStackLeader.Name} of {EventHouse.Name} inquires about your intentions within their domain."

msgid "STORY_EVENT@1038_175@BODY_HEADER"
msgstr "A {EventStackLeader} calls down as your army approaches the {EventStructure.Name}."

msgid "STORY_EVENT@1038_175@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "A {EventStackLeader} calls down as you approach the {EventStructure.Name}."

msgid "STORY_EVENT@1038_175@BODY_LORE"
msgstr "\"Strength, friend of {EventHouse.Name}! What type of wind has brought you into our ancestral lands this day? One wafting by the longhouse, bringing smells of mead and merrymaking? Or one passing over a battlefield, bearing the stench of death, decay, and ill intentions?\""

msgid "STORY_EVENT@1038_175@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "\"Strength, friend of {EventHouse.Name}! What type of wind has brought you into our ancestral lands this day? One wafting by the longhouse, bringing smells of mead and merrymaking? Or one passing over a battlefield, bearing the stench of death, decay, and ill intentions?\""

msgid "STORY_EVENT@1038_175@BUTTON_1"
msgstr "\"We would speak to your {EventHouseLord.TitleName}.\""

msgid "STORY_EVENT@1038_175@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"I would speak to your {EventHouseLord.TitleName}.\""

msgid "STORY_EVENT@1038_175@BUTTON_2"
msgstr "\"It is time to test your mettle. Draw your weapons!\""

msgid "STORY_EVENT@1038_175@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "\"It is time to test your mettle. Draw your weapons!\""

msgid "STORY_EVENT@1038_175@BUTTON_3"
msgstr "\"Peace, warrior. We are merely passing through...\""

msgid "STORY_EVENT@1038_175@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "\"Peace, warrior. I am merely passing through...\""

msgid "STORY_EVENT@1038_175@TITLE"
msgstr "Still Friend... or Foe?"

msgid "STORY_EVENT@1038_175@TITLE@HERO_IS_PLAYERLE"
msgstr "Still Friend... or Foe?"

msgid "STORY_EVENT@1038_176@BODY_FOOTER"
msgstr "Casting <<o:EventHero>> eyes upward, {EventHero.FirstName} sees shadows writhing in the branches, rapidly descending. The poor {EventUnit} looks at {EventHero.FirstName}, pleading for help."

msgid "STORY_EVENT@1038_176@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Casting your eyes upward, you see shadows writhing in the branches, rapidly descending. The poor {EventUnit} looks at you, pleading for help."

msgid "STORY_EVENT@1038_176@BODY_HEADER"
msgstr "The majestic {EventStructure} unfurls before {EventHero}, light shimmering through its leaves. Something stirs in the canopy."

msgid "STORY_EVENT@1038_176@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "The majestic {EventStructure} unfurls before you, light shimmering through its leaves. Something stirs in the canopy."

msgid "STORY_EVENT@1038_176@BODY_LORE"
msgstr "\"Help! Help! Great <<EventHero{hero/heroine}>>! Help!\" Scampering down the massive tree's trunk are <<m:EventUnit>>, their cheeks streaked with tears. Their pointy ears twitch as they cry out to {EventHero.FirstName}. \"Please help us! The poisonous {EnemyUnit} and <<o:EnemyUnit>> horrid friends assault our treetop den and seek to consume our friends and our babies...\" "

msgid "STORY_EVENT@1038_176@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "\"Help! Help! Great {PlayerLeader.Title}! Help!\" Scampering down the massive tree's trunk are <<m:EventUnit>>, their cheeks streaked with tears. Their pointy ears twitch as they cry out to you. \"Please help us! The poisonous {EnemyUnit} and <<o:EnemyUnit>> horrid friends assault our treetop den and seek to consume our friends and our babies...\""

msgid "STORY_EVENT@1038_176@BUTTON_0"
msgstr "Aid the fairies, and attack the {EnemyUnit}!"

msgid "STORY_EVENT@1038_176@BUTTON_1"
msgstr "Search for an antidote [food/] against the poisonous {EnemyUnit}."

msgid "STORY_EVENT@1038_176@BUTTON_3"
msgstr "Use your knowledge about poison to create an antidote to the {EnemyUnit}."

msgid "STORY_EVENT@1038_176@BUTTON_4"
msgstr "Leave the pleading fairies and the {EventStructure}."

msgid "STORY_EVENT@1038_176@TITLE"
msgstr "Poison and Protection"

msgid "STORY_EVENT@1038_177@BODY_FOOTER"
msgstr "\"Make a wish, and if it's true, this reward will be for you!\""

msgid "STORY_EVENT@1038_177@BODY_HEADER"
msgstr "With the immediate menace vanquished, tiny voices in the treetops sing your praises. "

msgid "STORY_EVENT@1038_177@BODY_LORE"
msgstr "{EventHero.FirstName} also notices various animals emerging from hiding spots, including an {EventMount}. The animals whoop and howl and the fairies sing: \"<<EventHero{hero/heroine}>> of the broken branches, thank you for your deliverance. Let us sing your praises now, and reward you with equivalence!\""

msgid "STORY_EVENT@1038_177@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "You also notice various animals emerging from hiding spots, including an {EventMount}. The animals whoop and howl and the fairies sing: \"{PlayerLeader.Title} of the broken branches, thank you for your deliverance. Let us sing your praises now, and reward you with equivalence!\""

msgid "STORY_EVENT@1038_177@BUTTON_0"
msgstr "\"I wish for the poisonous power I fought.\" [item/]"

msgid "STORY_EVENT@1038_177@BUTTON_1"
msgstr "\"I wish to ride the {EventMount.Name} [mount/] during my adventures!\""

msgid "STORY_EVENT@1038_177@BUTTON_2"
msgstr "\"I wish for aid [unit/] of the creatures of the {EventStructure}.\""

msgid "STORY_EVENT@1038_177@BUTTON_4"
msgstr "\"I only wish for all creatures to be safe.\" [goodact/]"

msgid "STORY_EVENT@1038_177@TITLE"
msgstr "Poison and Protection: Aftermath"

msgid "STORY_EVENT@1038_183@BODY_FOOTER"
msgstr "Tough luck, we will fight."

msgid "STORY_EVENT@1038_242@BODY_FOOTER"
msgstr "\"The {EventPlayerRace.Name} and I are forever in your debt, {PlayerLeader.Title}. Tell us what you need in your quest.\""

msgid "STORY_EVENT@1038_242@BODY_HEADER"
msgstr "You have defeated the threats that tormented {EventPlayerLeader.TitleName} and <<o:EventPlayerLeader>> people."

msgid "STORY_EVENT@1038_242@BODY_LORE"
msgstr "{EventPlayerLeader.FirstName} bows deeply to you. \"Your actions bring hope to my people, O {PlayerLeader.TitleName}. We thought all was lost, but with you... we may stand a chance against {EventNimue.FirstName}.\""

msgid "STORY_EVENT@1038_242@BUTTON_0"
msgstr "\"I ask for your best and bravest warriors [unit/] to join me!\""

msgid "STORY_EVENT@1038_242@BUTTON_1"
msgstr "\"I will need all the resources I can get. Send your aid [food/] [structureprod/] [unitprod/] to {EventCity}.\""

msgid "STORY_EVENT@1038_242@BUTTON_2"
msgstr "\"I propose an alliance, {EventPlayerLeader}. Together we can free this realm!\""

msgid "STORY_EVENT@1038_242@BUTTON_3"
msgstr "\"I merely ask you to remember that there is good to be found in the Astral Sea.\" [goodact/]"

msgid "STORY_EVENT@1038_242@TITLE"
msgstr "The {EventPlayerRace.Name}: Aftermath"

msgid "STORY_EVENT@1038_286@BODY_FOOTER"
msgstr "\"I have tried to investigate, but I could not venture far. Nevertheless, I will share everything I know.\""

msgid "STORY_EVENT@1038_286@BODY_HEADER"
msgstr "You meet {ElfSurvivor.TitleName}, who leads what seems to be the few remaining living souls on this realm. \"Thank the Allfather for your arrival, {PlayerLeader.TitleName}!\""

msgid "STORY_EVENT@1038_286@BODY_LORE"
msgstr "\"The Eternal Court, this realm on our beloved homeworld, was once a beautiful place,\" {ElfSurvivor.FirstName} laments. \"Now, a terrible curse has taken it. Souls of the dead roam like the living. Many who lived here either fled or perished themselves, their souls unable to move on. Something... or someone, is keeping them here.\""

msgid "STORY_EVENT@1038_286@BUTTON_0"
msgstr "\"Go on...\""

msgid "STORY_EVENT@1038_286@TITLE"
msgstr "Meeting the Elves of Auldweald"

msgid "STORY_EVENT@1038_287@BODY_FOOTER"
msgstr "\"There used to be an Elven empire in the east. I suggest we venture there, and find others who may know more.\""

msgid "STORY_EVENT@1038_287@BODY_HEADER"
msgstr "{Sundren.FirstName} approaches you, concerned. \"{PlayerLeader.TitleName}, I've received some concerning reports from my scouts. Many people in this realm seem to be... ghostly.\""

msgid "STORY_EVENT@1038_287@BODY_LORE"
msgstr "\"I am not sure why these spirits are here. Lingering {GLOBAL.SoulsLoreConcept.Hyperlink} are not uncommon, but this density is... problematic. Perhaps those are the voices I keep hearing, whispering...\" She gazes over the realm, and seems to remember something. \"I heard this realm was home to many Elven cities. Surely, one of them withstood this ghostly incursion.\""

msgid "STORY_EVENT@1038_287@BUTTON_0"
msgstr "\"I will look for life in the east.\""

msgid "STORY_EVENT@1038_287@TITLE"
msgstr "Elves of Auldweald"

msgid "STORY_EVENT@1038_293@BODY_FOOTER"
msgstr "This entire city, an entire people, were drowned. Your army stands silent as the rain falls, wondering what to do."

msgid "STORY_EVENT@1038_293@BODY_HEADER"
msgstr "Your army approaches what should have been a proud city, but what now seems to be nothing but a brackish swamp."

msgid "STORY_EVENT@1038_293@BODY_HEADER@HERO"
msgstr "{EventHero.Name} approaches what should have been a proud city, but which now seems to be nothing but a brackish swamp."

msgid "STORY_EVENT@1038_293@BODY_HEADER@LORD"
msgstr "You approach what should have been a proud city, but which now seems to be nothing but a brackish swamp."

msgid "STORY_EVENT@1038_293@BODY_LORE"
msgstr "Broken stone structures jut out from the waters, quickly crumbling under the constant lashing of the elements. Splashing through the once bustling streets, your army finds no signs of life. Bloated corpses riddle the streets and rotting markets. It seems as if they did not even have time to flee the tide that took their lives."

msgid "STORY_EVENT@1038_293@BUTTON_0"
msgstr "\"One day, we shall rebuild this city. It shall not be forgotten.\" [influence/]"

msgid "STORY_EVENT@1038_293@BUTTON_2"
msgstr "\"Grant these people their last rites [goodact/]. They deserve at least that.\""

msgid "STORY_EVENT@1038_293@BUTTON_3"
msgstr "\"We shall study this lost civilization. Their knowledge [knowledge/] will not be lost.\""

msgid "STORY_EVENT@1038_293@BUTTON_4"
msgstr "\"Loot [gold/] whatever you can find. It looks like we will need it.\""

msgid "STORY_EVENT@1038_293@BUTTON_5"
msgstr "\"This is what happens when you disobey [happiness/] your {PlayerLeader.Title}, my {EventRace}.\" [evilact/]"

msgid "STORY_EVENT@1038_293@TITLE"
msgstr "Drowned Echoes"

msgid "STORY_EVENT@1038_307@BODY_FOOTER"
msgstr "Suddenly {EventHero.FirstName} finds <<r:EventHero>> standing eye to eye with a {EnemyUnit}, before it disappears again. Danger approaches..."

msgid "STORY_EVENT@1038_307@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Suddenly your troops find themselves standing eye to eye with a {EnemyUnit}, before it disappears again. Danger approaches..."

msgid "STORY_EVENT@1038_307@BODY_HEADER"
msgstr "{EventHero} enters the dark {EventStructure}. It used to be a grand, stable beacon for all magical beings. But now..."

msgid "STORY_EVENT@1038_307@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "You enter the dark {EventStructure}. It used to be a grand, stable beacon for all magical beings. But now..."

msgid "STORY_EVENT@1038_307@BODY_LORE"
msgstr "{EventHero.FirstName} and <<o:EventHero>> army quickly notice something is off. Without moving, they find themselves at the other end of the hallway, up the stairs... or back at the door. It becomes clear that some force here is warping the tower and displacing its furniture—and everyone in it. <<g:army^n,EventHero>> scrambles as they find themselves displaced throughout the tower."

msgid "STORY_EVENT@1038_307@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "You and your army quickly notice something is off. Without moving, you find yourself at the other end of the hallway, up the stairs... or back at the door. It becomes clear that some force here is warping the tower and displacing its furniture—and everyone in it. Your army scrambles as they find themselves displaced throughout the tower."

msgid "STORY_EVENT@1038_307@BUTTON_0"
msgstr "Attack the creatures that haunt the cursed {EventStructure}!"

msgid "STORY_EVENT@1038_307@BUTTON_1"
msgstr "Use your arcane prowess [mana/] to delay the displacements."

msgid "STORY_EVENT@1038_307@BUTTON_3"
msgstr "Connect to the wild flows of the Astral Sea. Use them to your advantage."

msgid "STORY_EVENT@1038_307@BUTTON_5"
msgstr "Leave the warping {EventStructure}."

msgid "STORY_EVENT@1038_307@TITLE"
msgstr "Warping Tower"

msgid "STORY_EVENT@1038_308@BODY_FOOTER"
msgstr "A failed experiment caused the problems at the tower. What object does {EventHero.FirstName} save before it is warped into the {GLOBAL.AstralSeaLoreConcept.Hyperlink}?"

msgid "STORY_EVENT@1038_308@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "A failed arcane experiment caused the problems at the tower. What object do you save before it is warped into the {GLOBAL.AstralSeaLoreConcept.Hyperlink}?"

msgid "STORY_EVENT@1038_308@BODY_HEADER"
msgstr "After defeating the creatures in the warping {EventStructure}, some sense of peace returns to the twisted spire."

msgid "STORY_EVENT@1038_308@BODY_LORE"
msgstr "The tower can now be traversed with relative ease, although the warping continues. <<g:army^n,EventHero>> tries to collect as many books and riches as they can to stop the objects from popping in and out of existence. {EventHero.FirstName} enters the top spire of the tower, where the displacement seems strongest, and finds the body of a wizard... warped into a wall."

msgid "STORY_EVENT@1038_308@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "The tower can now be traversed with relative ease, although the warping continues. Your army tries to collect as many books and riches as they can to stop the objects from popping in and out of existence. You enter the top spire of the tower, where the displacement seems strongest, and find the body of a wizard... warped into a wall."

msgid "STORY_EVENT@1038_308@BUTTON_1"
msgstr "Save the {EventItem}."

msgid "STORY_EVENT@1038_308@BUTTON_2"
msgstr "Save the chest filled with riches [gold/]."

msgid "STORY_EVENT@1038_308@BUTTON_3"
msgstr "Save the Ancient Tome."

msgid "STORY_EVENT@1038_308@BUTTON_4"
msgstr "Save the vat of souls [soul/]."

msgid "STORY_EVENT@1038_308@TITLE"
msgstr "Warping Tower: Aftermath"

msgid "STORY_EVENT@1038_309@BODY_FOOTER"
msgstr "The two dragons rise, towering above {EventHero.FirstName}. \"Leave our hoards, or face our wrath!\""

msgid "STORY_EVENT@1038_309@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "The two dragons rise, towering above you. \"Leave our hoards, or face our wrath!\""

msgid "STORY_EVENT@1038_309@BODY_HEADER"
msgstr "The ancient {EventStructure} looms before {EventHero.Name}. Inside <<p:EventHero>> encounters two resting {GLOBAL.DragonsLoreConcept.Hyperlink} on opposite ends of the hall."

msgid "STORY_EVENT@1038_309@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "The ancient {EventStructure} looms before you. Inside you encounter two resting {GLOBAL.DragonsLoreConcept.Hyperlink} at opposite ends of the hall."

msgid "STORY_EVENT@1038_309@BODY_LORE"
msgstr "Each dragon seems to be guarding one half of a considerable hoard. \"Intruder,\" the first one, a royal {EventDragon} says. \"Thou darest enter my hoard? Leave thy tribute, lest I rain down fiery wrath upon thee!\"[br/]The second, a {EventDragon2}, glares at the other before turning back to {EventHero.FirstName} with a cold grin. \"I suggest you run, little mouse.\""

msgid "STORY_EVENT@1038_309@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Each dragon seems to be guarding one half of a considerable hoard. \"Intruder,\" the first one, a royal {EventDragon} says. \"Thou darest enter my hoard? Leave thy tribute, lest I rain down fiery wrath upon thee!\"[br/]The second, a {EventDragon2}, glares at the other before turning back to {EventHero.FirstName} with a cold grin. \"I suggest you run, little {PlayerLeader.Title}.\""

msgid "STORY_EVENT@1038_309@BUTTON_0"
msgstr "Attack the dragons!"

msgid "STORY_EVENT@1038_309@BUTTON_1"
msgstr "Cast a quick spell [mana/] to protect your troops before engaging."

msgid "STORY_EVENT@1038_309@BUTTON_3"
msgstr "Question whose hoard is bigger, to trigger a fight."

msgid "STORY_EVENT@1038_309@BUTTON_4"
msgstr "\"I bring thee both tribute [gold/], mighty dragons. Go back to sleep.\" "

msgid "STORY_EVENT@1038_309@BUTTON_7"
msgstr "Flee."

msgid "STORY_EVENT@1038_309@TITLE"
msgstr "Two Dragons"

msgid "STORY_EVENT@1038_310@BODY_FOOTER"
msgstr "The dragons' hoard is yours to take. Which item catches <<g:eye^n,EventHero>>?"

msgid "STORY_EVENT@1038_310@BODY_HEADER"
msgstr "With the threat of the {GLOBAL.DragonsLoreConcept.Hyperlink} removed, {EventHero} has gained access to the {EventStructure}."

msgid "STORY_EVENT@1038_310@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "With the threat of the {GLOBAL.DragonsLoreConcept.Hyperlink} removed, you have gained access to the {EventStructure}."

msgid "STORY_EVENT@1038_310@BODY_LORE"
msgstr "Through the ages they spent in this realm, the dragons had amassed a considerable hoard, its contents meticulously split in half. {EventHero.FirstName} even finds some broken objects, as if the dragons did not know how to divide the wealth otherwise. Luckily, most of the treasures were kept intact."

msgid "STORY_EVENT@1038_310@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Through the ages they spent in this realm, the dragons had amassed a considerable hoard, its contents meticulously split in half. You even find some broken objects, as if the dragons did not know how to divide the wealth otherwise. Luckily, most of the treasures were kept intact."

msgid "STORY_EVENT@1038_310@BUTTON_0"
msgstr "The {EventRing} of the {EventDragon}. [item/]"

msgid "STORY_EVENT@1038_310@BUTTON_2"
msgstr "The {EventWeapon} of the {EventDragon2}. [item/]"

msgid "STORY_EVENT@1038_310@BUTTON_3"
msgstr "Repair the broken throne. [influence/]"

msgid "STORY_EVENT@1038_310@BUTTON_4"
msgstr "Repair the deactivated {EventUnit}. [unit/]"

msgid "STORY_EVENT@1038_310@TITLE"
msgstr "Two Dragons: Aftermath"

msgid "STORY_EVENT@1038_317@BODY_FOOTER"
msgstr "\"A powerful {GLOBAL.GodirLoreConcept.Hyperlink} must claim this realm to change its fate. Perhaps.. that Godir should not be me.\""

msgid "STORY_EVENT@1038_317@BODY_FOOTER@MEANDOR_DEFEATED"
msgstr "\"What have I done...\" His words fade. \"In my absence... free the realm from my curse.\""

msgid "STORY_EVENT@1038_317@BODY_HEADER"
msgstr "By eliminating its sources, you have broken the spell which has kept Meandor occupied for so long. You are contacted by the {Meandor.Title} himself."

msgid "STORY_EVENT@1038_317@BODY_HEADER@MEANDOR_DEFEATED"
msgstr "By eliminating its sources you have broken the spell which has kept Meandor occupied. Even through the void he manages to contact you."

msgid "STORY_EVENT@1038_317@BODY_LORE"
msgstr "\"A haze.. is lifting. Did you do this, {PlayerLeader.TitleName}? Perhaps not all who visit are invaders, after all.\"[br/]His gaze drifts toward the ghostly realm around him. \"It seems even I cannot give myself the solace I yearn for. During my... affliction, I have set things in motion that I cannot undo alone. More and more {GLOBAL.SoulsLoreConcept.Hyperlink} will be pulled here.\""

msgid "STORY_EVENT@1038_317@BODY_LORE@MEANDOR_DEFEATED"
msgstr "\"In the void, I feel a haze is... lifting. Did you do this, {PlayerLeader.TitleName}? I see now that I was... afflicted. I have set things in motion that cannot be undone. Even now... I sense how more and more souls are pulled toward the realm I created. They will soon fall victim to predators from the Astral Sea...\""

msgid "STORY_EVENT@1038_317@BUTTON_0"
msgstr "\"Accept your defeat, then, {Meandor.TitleName}, and leave this realm so I can resolve what you caused.\""

msgid "STORY_EVENT@1038_317@BUTTON_6"
msgstr "\"I propose an alliance. Let us claim this realm and free its souls, together!\""

msgid "STORY_EVENT@1038_317@BUTTON_7"
msgstr "Leave the {Meandor.Title} to journey through the void for now."

msgid "STORY_EVENT@1038_317@TITLE"
msgstr "Torn Web of Madness"

msgid "STORY_EVENT@1038_319@BODY_FOOTER"
msgstr "{Sundren.Name} was wounded, but has escaped death. It will take some time for her to regain her strength."

msgid "STORY_EVENT@1038_319@BODY_HEADER"
msgstr "{Sundren.TitleName} was defeated in battle under your command!"

msgid "STORY_EVENT@1038_319@BODY_LORE"
msgstr "Through effort, luck or something else entirely, she managed to survive the onslaught and made it back to safety, where she appears in a cloud of shadows. She grimaces, a darker expression marking her face before the shadows disappear and she turns to you again. \"I have withstood many hardships in the {GLOBAL.AstralVoidLoreConcept.Hyperlink}. It shall not claim me yet.\""

msgid "STORY_EVENT@1038_319@BUTTON_3"
msgstr "So be it."

msgid "STORY_EVENT@1038_319@TITLE"
msgstr "Sundren Defeated"

msgid "STORY_EVENT@1038_4@BODY_FOOTER"
msgstr "The citizens offer to sculpt a statue in your likeness! Which pose best captures your qualities?"

msgid "STORY_EVENT@1038_4@BODY_HEADER"
msgstr "You have treated your citizens in {EventCity.Name} well. Now a sculptor approaches you, bowing reverently."

msgid "STORY_EVENT@1038_4@BODY_LORE"
msgstr "\"Greetings, {PlayerLeader.TitleName}. The populace of {EventCity.Name} have hired me, a humble sculptor in the likenesses of Kings and Godir, to immortalize your image in marble and flowrock. Tough materials to work with, but I would use nothing less for a {PlayerLeader.Title} of your stature. Please, if you would be so kind as to strike a pose...\""

msgid "STORY_EVENT@1038_4@BUTTON_0"
msgstr "A pondering attitude [knowledge/], searching for answers."

msgid "STORY_EVENT@1038_4@BUTTON_1"
msgstr "A defensive stance [production/], protector of the city."

msgid "STORY_EVENT@1038_4@BUTTON_3"
msgstr "A battle roar [unitprod/], weapon raised high."

msgid "STORY_EVENT@1038_4@BUTTON_4"
msgstr "A benevolent gesture [influence/], helping hand reached out."

msgid "STORY_EVENT@1038_4@BUTTON_5"
msgstr "An imposing posture; a tyrant [influence/] to be feared."

msgid "STORY_EVENT@1038_4@TITLE"
msgstr "Set in Stone"

msgid "STORY_EVENT@1038_52@BODY_FOOTER"
msgstr "Something has awakened the dead nearby. The approaching horde is heading for {EventCity.Name}!"

msgid "STORY_EVENT@1038_52@BODY_HEADER"
msgstr "A dark threat looms at the edge of {EventCity.Name}, your city."

msgid "STORY_EVENT@1038_52@BODY_LORE"
msgstr "A widow approaches you, supported by a city guard. She is very upset. \"{PlayerLeader.Title}, it's... it's terrible! I went to visit the grave of my late husband. I go there often to place fresh flowers on it, and he, he...\" She starts crying, and the guardsman continues her story.[br/][br/]\"Her husband arose from the grave and attacked her. When she fled, she saw other... other bodies, shambling toward the city.\""

msgid "STORY_EVENT@1038_52@BUTTON_0"
msgstr "Lure the dead away with light and magic tricks [mana/]... for now."

msgid "STORY_EVENT@1038_52@BUTTON_1"
msgstr "Send a specialized group of mages [mana/] to drive the dead back to their {EventSpawner}."

msgid "STORY_EVENT@1038_52@BUTTON_2"
msgstr "Use your connection to the dead to turn the approaching horde to your side."

msgid "STORY_EVENT@1038_52@BUTTON_3"
msgstr "\"The dead do not scare us. {EventCity} is ready for them.\""

msgid "STORY_EVENT@1038_52@TITLE"
msgstr "Restless Dead"

msgid "STORY_EVENT@1038_55@BODY_FOOTER"
msgstr "\"Fear our summons. Fear the wrath of the Shad'rai!\""

msgid "STORY_EVENT@1038_55@BODY_HEADER"
msgstr "For too long has the {EventSpawner} near your city of {EventCity} been left undisturbed. Now their dark creations roam freely, threatening the entire area."

msgid "STORY_EVENT@1038_55@BODY_LORE"
msgstr "\"Behold, the grand {EventUnit}!\" one of the cultists shouts from afar. \"In the glorious light of Yaka and with the swift winds of Artica we will conquer you all and prove ourselves worthy of the {GLOBAL.ShadraiFactionLoreConcept.Hyperlink}! For they are the true {GLOBAL.GodirLoreConcept.Hyperlink} and only they have true power.\""

msgid "STORY_EVENT@1038_55@BUTTON_0"
msgstr "Order your mages [mana/] to destroy the cultists closest to {EventCity}."

msgid "STORY_EVENT@1038_55@BUTTON_1"
msgstr "Order your mages [mana/] to drive all cultists back to the {EventSpawner.Name}."

msgid "STORY_EVENT@1038_55@BUTTON_2"
msgstr "Their rituals will be as nothing against the might of {EventCity.Name}."

msgid "STORY_EVENT@1038_55@BUTTON_3"
msgstr "Bind the {EventUnit} to your own will."

msgid "STORY_EVENT@1038_55@TITLE"
msgstr "Shad'rai Business"

msgid "STORY_EVENT@1038_56@BODY_FOOTER"
msgstr "{EventHouseLord.Name} and the winner of the brutal arena battle look at you, expecting words of recognition."

msgid "STORY_EVENT@1038_56@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} has invited you to see <<o:EventHouseLord>> warriors from {EventHouse.Name} in action."

msgid "STORY_EVENT@1038_56@BODY_LORE"
msgstr "Their improvised \"arena\" is a bloodstained mess of gore. The loud yelling and stench of sweat is hard to ignore as motley squads pummel each other into the ground. When the battle ends, the victor reveals a grinning mouth full of broken teeth, one eye swollen shut. The crowd cheers and the winner raises a fist to you in victory."

msgid "STORY_EVENT@1038_56@BUTTON_0"
msgstr "\"Well done. Fortune favors the brave [chaosboon/] and you certainly were!\""

msgid "STORY_EVENT@1038_56@BUTTON_1"
msgstr "\"Well done. Your inner beast [natureboon/] secured your victory.\""

msgid "STORY_EVENT@1038_56@BUTTON_2"
msgstr "\"Well done. Your victory is a sign of true weapon mastery. [materiumboon/]\""

msgid "STORY_EVENT@1038_56@BUTTON_3"
msgstr "\"Well done. Let this victory strengthen your faith [orderboon/] and convictions.\""

msgid "STORY_EVENT@1038_56@BUTTON_4"
msgstr "\"Well done. Your victory speaks for your knowledge [astralboon/] and insight.\""

msgid "STORY_EVENT@1038_56@BUTTON_6"
msgstr "\"Well done. I invite <<g:Pit Champion^n,EventHouseLord>> [unit/] to join my ranks.\""

msgid "STORY_EVENT@1038_56@BUTTON_7"
msgstr "\"This display of violence appalls me [goodact/]. You all should be ashamed.\""

msgid "STORY_EVENT@1038_56@BUTTON_8"
msgstr "\"Well done. I never encountered such an ally of death before.\" [shadowboon/]."

msgid "STORY_EVENT@1038_56@TITLE"
msgstr "Pit Champion"

msgid "STORY_EVENT@1038_62@BODY_FOOTER"
msgstr "{EventHouseLord.TitleName} asks you to say something to the contending knights. What speech do you give?"

msgid "STORY_EVENT@1038_62@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} has invited you to watch a joust, hosted in {EventHouse.Name}."

msgid "STORY_EVENT@1038_62@BODY_LORE"
msgstr "Six knights of the {EventHouseRace.Name} ride up and bow reverently to you and their {EventHouseLord.Title}. \"Jousts and tournaments are perfect opportunities for our knights to show their worth,\" {EventHouseLord.Name} says. \"We are all glad to see your interest in our culture, {PlayerLeader.TitleName}. If it pleases you, these knights would be honored if you would given them a few words.\""

msgid "STORY_EVENT@1038_62@BUTTON_0"
msgstr "\"May your sword be sharp and luck [chaosboon/] be on your side!\""

msgid "STORY_EVENT@1038_62@BUTTON_1"
msgstr "\"Never forget your progenitors [natureboon/], who gave you your strength.\""

msgid "STORY_EVENT@1038_62@BUTTON_2"
msgstr "\"May your armor be sturdy [materiumboon/] and your shield unbreakable.\""

msgid "STORY_EVENT@1038_62@BUTTON_3"
msgstr "\"May you be a beacon of hope [orderboon/] to your people.\""

msgid "STORY_EVENT@1038_62@BUTTON_4"
msgstr "\"Hone your mind [astralboon/] as you would your sword to achieve victory.\""

msgid "STORY_EVENT@1038_62@BUTTON_6"
msgstr "\"The best of you [unit/] is allowed to join my army!\""

msgid "STORY_EVENT@1038_62@BUTTON_7"
msgstr "\"Chivalrous virtues [goodact/] elevate knights over common soldiers.\""

msgid "STORY_EVENT@1038_62@BUTTON_8"
msgstr "\"When death is on your side, you need fear nothing.\" [shadowboon/]"

msgid "STORY_EVENT@1038_62@TITLE"
msgstr "Favor of the {PlayerLeader.Title}"

msgid "STORY_EVENT@1038_9@BODY_FOOTER"
msgstr "The rioting citizens are affected by {GLOBAL.CityStabilityConcept.Hyperlink} and demand some form of succor."

msgid "STORY_EVENT@1038_9@BODY_HEADER"
msgstr "You have neglected your populace of {EventCity.Name}. Now, they are rioting in the streets."

msgid "STORY_EVENT@1038_9@BODY_LORE"
msgstr "The sounds of shouting and breaking glass echo through the city. Merchants hide as their shops are looted by a raging mob. A large group of citizens advance to confront you. \"You and your so-called lords and ladies sit there in luxury while we toil in the mud! You have denied us every chance of comfort. No more!\""

msgid "STORY_EVENT@1038_9@BUTTON_0"
msgstr "Have your mages [mana/] distract them [happiness/] with magic and fireworks."

msgid "STORY_EVENT@1038_9@BUTTON_1"
msgstr "Create some form of distraction for the citizens [happiness/] yourself for now."

msgid "STORY_EVENT@1038_9@BUTTON_2"
msgstr "Deploy the garrison [unitprod/] to restore order [happiness/] by force."

msgid "STORY_EVENT@1038_9@BUTTON_3"
msgstr "Round up the rioters and execute them. [evilact/]. [happiness/]"

msgid "STORY_EVENT@1038_9@BUTTON_4"
msgstr "\"I have no time for this.\""

msgid "STORY_EVENT@1038_9@TITLE"
msgstr "Riot in {EventCity.Name}"

msgid "STORY_EVENT@1042_10@BODY_FOOTER"
msgstr "The group guarding the {EventStructure.Name} are waiting for you to show your intent."

msgid "STORY_EVENT@1042_10@BODY_HEADER"
msgstr "{EventHero.Name} approaches a delegation of {EventHouse.Name} and is greeted by friendly faces."

msgid "STORY_EVENT@1042_10@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "You approach a delegation of {EventHouse.Name} and you are greeted by friendly faces."

msgid "STORY_EVENT@1042_10@BODY_LORE"
msgstr "\"Salutations, traveler! What brings you here?\" The {EventStackLeader.Name} smiles, obviously at ease with <<g:presence^n,{EventHero.FirstName}>>. \"We have secured the {EventStructure.Name} for {EventHouse.Name}, and are guarding it against brigands.\""

msgid "STORY_EVENT@1042_10@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "\"Salutations, {PlayerLeader.Title}! What brings you here?\" The {EventStackLeader.Name} smiles, obviously at ease with your presence. \"We have secured the {EventStructure.Name} for {EventHouse.Name}, and are guarding it against brigands.\""

msgid "STORY_EVENT@1042_10@BUTTON_0"
msgstr "\"Surely {EventHouseLord.Name} won't mind [influence/] if we occupy this location.\""

msgid "STORY_EVENT@1042_10@BUTTON_0@HERO_IS_PLAYERLE"
msgstr "\"Surely {EventHouseLord.Name} won't mind [influence/] if I take this location into my hands.\""

msgid "STORY_EVENT@1042_10@BUTTON_1"
msgstr "\"Leave your posts or face our steel.\""

msgid "STORY_EVENT@1042_10@BUTTON_2"
msgstr "\"We will wipe those smiles off your faces! To arms!\""

msgid "STORY_EVENT@1042_10@BUTTON_3"
msgstr "\"We are merely passing through...\""

msgid "STORY_EVENT@1042_10@TITLE"
msgstr "Gullible Guards"

msgid "STORY_EVENT@1042_1@BODY_FOOTER"
msgstr "The {EventStackLeader} leading this army seems suspicious of your motives, but perhaps <<p:EventStackLeader>> can be persuaded."

msgid "STORY_EVENT@1042_1@BODY_HEADER"
msgstr "A {EventStackLeader} bearing the banner of {EventHouse.Name} steps forward as {EventHero.Name} approaches."

msgid "STORY_EVENT@1042_1@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "A {EventStackLeader} bearing the banner of {EventHouse.Name} steps forward as you approach."

msgid "STORY_EVENT@1042_1@BODY_LORE"
msgstr "\"Stop right there!\" The appearance of the {EventStackLeader} clearly indicates that <<p:EventStackLeader>> is the leader of this army. \"We're here on behalf of {EventHouse.Name} to protect the local {EventStructure.Name} and its resources, even from a {PlayerLeader.Title}.\" The suspicion is clear in <<o:EventStackLeader>> eyes as <<p:EventStackLeader>> sizes up your forces. \"What brings you here?\""

msgid "STORY_EVENT@1042_1@BUTTON_1"
msgstr "\"Here's a bag of reasons [gold/] for you to leave without bloodshed.\""

msgid "STORY_EVENT@1042_1@BUTTON_2"
msgstr "\"If you wish to be our enemy, so be it.\""

msgid "STORY_EVENT@1042_1@BUTTON_3"
msgstr "\"We are merely passing through...\""

msgid "STORY_EVENT@1042_1@TITLE"
msgstr "A Tense Encounter"

msgid "STORY_EVENT@1042_8@BODY_FOOTER"
msgstr "The army guarding the {EventStructure.Name} seems downtrodden and demoralized."

msgid "STORY_EVENT@1042_8@BODY_HEADER"
msgstr "{EventHero.Name} comes across an army of {EventHouse.Name}, their appearance ragged and unkempt."

msgid "STORY_EVENT@1042_8@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "You come across an army of {EventHouse.Name}, their appearance ragged and unkempt."

msgid "STORY_EVENT@1042_8@BODY_LORE"
msgstr "\"Thank the {GLOBAL.GodirLoreConcept.Hyperlink}! We are so happy to see a friendly face!\" their leader says, relieved to have found some company. \"We were tasked with guarding the {EventStructure.Name}, but we've been here for ages without relief... We're sick, hungry, and weary!\" The guards behind <<P:EventStackLeader>> grumble in agreement."

msgid "STORY_EVENT@1042_8@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "\"Thank the {GLOBAL.GodirLoreConcept.Hyperlink}! We are so happy to see a friendly face!\" their leader says, relieved to have found some company. \"We were tasked with guarding the {EventStructure.Name}, but we've been here for ages without relief... We're sick, hungry, and weary!\" The guards behind <<P:EventStackLeader>> grumble in agreement."

msgid "STORY_EVENT@1042_8@BUTTON_0"
msgstr "\"Would some food [food/] persuade you to leave this location to us?\""

msgid "STORY_EVENT@1042_8@BUTTON_0@HERO_IS_PLAYERLE"
msgstr "\"Would some food [food/] persuade you to leave this location to me?\""

msgid "STORY_EVENT@1042_8@BUTTON_1"
msgstr "\"Join us! You will never be weary again...\""

msgid "STORY_EVENT@1042_8@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"Join me! You will never be weary again...\""

msgid "STORY_EVENT@1042_8@BUTTON_2"
msgstr "\"We will end your suffering, then. To arms!\""

msgid "STORY_EVENT@1042_8@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "\"I shall end your suffering, then. To arms!\""

msgid "STORY_EVENT@1042_8@BUTTON_3"
msgstr "\"We are merely passing through...\""

msgid "STORY_EVENT@1042_8@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "\"I am merely passing through...\""

msgid "STORY_EVENT@1042_8@TITLE"
msgstr "Restless Guards"

msgid "STORY_EVENT@1048_18@BODY_FOOTER"
msgstr "You vastly outnumber these guards. Do you let them leave the {EventStructure.Name} without a fight?"

msgid "STORY_EVENT@1048_18@BODY_HEADER"
msgstr "As your troops approach the band of mercenary guards, they raise the white flag."

msgid "STORY_EVENT@1048_18@BODY_LORE"
msgstr "\"We were hired by a rich merchant to look after the {EventStructure.Name},\" the leader of the gang, a {EventStackLeader.Name}, explains. \"We expected to protect it from roaming scoundrels, not against a full-fledged assault! Please accept our surrender and let us go!\""

msgid "STORY_EVENT@1048_18@BUTTON_0"
msgstr "\"That's what you get for becoming mercenaries! [evilact/] Attack!\""

msgid "STORY_EVENT@1048_18@BUTTON_1"
msgstr "\"We have no quarrel with you. [goodact/] Leave in peace.\""

msgid "STORY_EVENT@1048_18@BUTTON_2"
msgstr "\"How about we change your contract [gold/]... to serve me!\" [unit/]"

msgid "STORY_EVENT@1048_18@TITLE"
msgstr "Occupational Hazard"

msgid "STORY_EVENT@1048_22@BODY_FOOTER"
msgstr "Do you let them go and plead for peace with {EventHouse.Name}?"

msgid "STORY_EVENT@1048_22@BODY_HEADER"
msgstr "Your troops catch an enemy division who have split off from {EventHouse.Name}."

msgid "STORY_EVENT@1048_22@BODY_LORE"
msgstr "Anxiously, they send forth their captain, a {EventStackLeader.Name}, to negotiate their surrender. \"Our {EventHouseLord.TitleName} of {EventHouse.Name} is a great governor, but a weak marshal. We are losing this war. <<Co:EventHouseLord>> other generals are too proud to admit it, but someone has to stand up to {EventHouseLord.Name}. Let us retreat, and I promise there will be peace again.\""

msgid "STORY_EVENT@1048_22@BUTTON_0"
msgstr "\"This war has only just begun. [evilact/] Attack!\""

msgid "STORY_EVENT@1048_22@BUTTON_1"
msgstr "\"Today, you may leave unharmed. [goodact/] But know that there will not be peace tomorrow.\""

msgid "STORY_EVENT@1048_22@BUTTON_2"
msgstr "\"You may leave if you ensure our good intentions are known to {EventHouseLord.Name}.\""

msgid "STORY_EVENT@1048_22@TITLE"
msgstr "Lost Cause"

msgid "STORY_EVENT@1048_23@BODY_FOOTER"
msgstr "The troops see your prowess and want to join your cause!"

msgid "STORY_EVENT@1048_23@BODY_HEADER"
msgstr "The enemy army from {EventHouse.Name} welcomes your troops with friendly cheers."

msgid "STORY_EVENT@1048_23@BODY_LORE"
msgstr "With a pathetic air, their captain comes forward: \"Salutations, {PlayerLeader.TitleName}! Long live the {PlayerLeader.Title} whose feats on the battlefield command the admiration of even <<o:PlayerLeader>> enemies. My division has long dreamed of following a leader of such might. We are sick of the lowly {EventHouseLord.Name} and <<o:EventHouseLord>> {EventHouse.Name}—allow us to fight in your name!\""

msgid "STORY_EVENT@1048_23@BUTTON_0"
msgstr "\"Allowing an enemy to join forces? Die [evilact/], you fools!\""

msgid "STORY_EVENT@1048_23@BUTTON_1"
msgstr "\"There is no room for traitors within my ranks [goodact/]. Begone!\""

msgid "STORY_EVENT@1048_23@BUTTON_2"
msgstr "\"Who would reject the service [unit/] of someone with such good taste?\""

msgid "STORY_EVENT@1048_23@TITLE"
msgstr "Daring Defectors"

msgid "STORY_EVENT@1048_27@BODY_FOOTER"
msgstr "How do you wish to commemorate the ingenuity displayed by your {EventRace}?"

msgid "STORY_EVENT@1048_27@BODY_HEADER"
msgstr "At the grand square of your city {EventCity.Name}, a construction fair is taking place."

msgid "STORY_EVENT@1048_27@BODY_LORE"
msgstr "Builders from all across the continent have gathered to marvel at the latest machines and inventions devised by the {EventRace.Name}. The production methods developed by your people have piqued the interest of many rulers."

msgid "STORY_EVENT@1048_27@BUTTON_0"
msgstr "Sell [gold/] the production plans to the highest bidders."

msgid "STORY_EVENT@1048_27@BUTTON_1"
msgstr "Give a speech [happiness/] about the importance of Production for your empire."

msgid "STORY_EVENT@1048_27@BUTTON_2"
msgstr "Look to the future and the innovations [knowledge/] still to come."

msgid "STORY_EVENT@1048_27@TITLE"
msgstr "Engines of Awe"

msgid "STORY_EVENT@1048_34@BODY_FOOTER"
msgstr "Will you back up their ambitions to increase productivity at {EventCity.Name}?"

msgid "STORY_EVENT@1048_34@BODY_HEADER"
msgstr "Your builders' guild at {EventCity.Name} requests your support."

msgid "STORY_EVENT@1048_34@BODY_LORE"
msgstr "\"The apprentices from our guild are crestfallen!\" their master craftsman exclaims. \"On their journeys through the empire of {EventGoldenCityPlayer.Name}, they have witnessed the elaborate workmanship and monumental buildings in {EventGoldenCity.Name}. Now they dream of equal grandeur, but our own means are limited...\""

msgid "STORY_EVENT@1048_34@BUTTON_0"
msgstr "Invest [gold/] in materials and tools [structureprod/] to get them started."

msgid "STORY_EVENT@1048_34@BUTTON_1"
msgstr "Vow [influence/] to attract more workers [population/] to {EventCity.Name}."

msgid "STORY_EVENT@1048_34@BUTTON_2"
msgstr "Bend stones and earth to your will to inspire them."

msgid "STORY_EVENT@1048_34@BUTTON_3"
msgstr "Ignore their request."

msgid "STORY_EVENT@1048_34@TITLE"
msgstr "Foreign Wonders"

msgid "STORY_EVENT@1048_39@BODY_FOOTER"
msgstr "A hollow echo shakes the cavern: \"Disssciplesss of the Gorgon Goddesss, choossse your sssacrificcce... Lessst you find your greedy heartsss turned to ssstone.\""

msgid "STORY_EVENT@1048_39@BODY_HEADER"
msgstr "As soon as {EventHero.Name} enters the {EventStructure.Name}, <<p:EventHero>> notices it is infested with snakes."

msgid "STORY_EVENT@1048_39@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "As soon as you enter the {EventStructure.Name}, you notice it is infested with snakes."

msgid "STORY_EVENT@1048_39@BODY_LORE"
msgstr "The entire scene looks like a shrine dedicated to an outlawed deity. Ornate rock formations surround a stone-shaped altar, where the idol of a snake-haired woman stands. The living serpents lurk in a distance, until {EventHero.Name} touches the altair."

msgid "STORY_EVENT@1048_39@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Stony serpents loom like pillars in the heart of the underground maze. The entire scene looks like a shrine dedicated to an outlawed deity. Ornate rock formations surround a stone-shaped altar, where the idol of a snake-haired woman stands. The living serpents lurk at a distance, until you touch the altar. The idol grins and crumbles, the snakes hissing in anticipation."

msgid "STORY_EVENT@1048_39@BUTTON_0"
msgstr "\"I'm not afraid of any goddess or her slithering guardians. To arms!\""

msgid "STORY_EVENT@1048_39@BUTTON_1"
msgstr "\"We offer the people [population/] of {EventCity.Name} [evilact/] to feed thy protectors, O Serpent.\""

msgid "STORY_EVENT@1048_39@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"I offer the people [population/] of {EventCity.Name} [evilact/] to feed thy protectors.\""

msgid "STORY_EVENT@1048_39@BUTTON_2"
msgstr "Stone magic is one of your strengths. Use it to predict the targets of the Gorgon's Curse."

msgid "STORY_EVENT@1048_39@BUTTON_4"
msgstr "Retreat."

msgid "STORY_EVENT@1048_39@TITLE"
msgstr "Pit of Vipers"

msgid "STORY_EVENT@1048_40@BODY_FOOTER"
msgstr "Does {EventHero.Name} keep the scroll of litho-shaping or use it to revive the petrified victims <<p:EventHero>> found?"

msgid "STORY_EVENT@1048_40@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Do you keep the scroll of litho-shaping or use it to revive the petrified victims you found?"

msgid "STORY_EVENT@1048_40@BODY_HEADER"
msgstr "Having survived the trial of the Gorgon Goddess, a shifting stone plate reveals her chamber of offerings."

msgid "STORY_EVENT@1048_40@BODY_LORE"
msgstr "Inside the hidden room, a line of petrified adventurers bears silent witness to the magic of the Curse {EventHero.FirstName} withstood. {EventHero.FirstName} finds a scroll created by the old worshipers of the Gorgon Goddess, which seems to contain a litho-shaping spell."

msgid "STORY_EVENT@1048_40@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Inside the hidden room, a line of petrified adventurers bears silent witness to the magic of the Curse you withstood. You find a scroll created by the old worshipers of the Gorgon Goddess, which seems to contain a litho-shaping spell."

msgid "STORY_EVENT@1048_40@BUTTON_0"
msgstr "\"Their time has passed. The scroll [knowledge/] will help us in future battles.\""

msgid "STORY_EVENT@1048_40@BUTTON_0@HERO_IS_PLAYERLE"
msgstr "\"Their time has passed. The scroll [knowledge/] will help me in future battles.\""

msgid "STORY_EVENT@1048_40@BUTTON_1"
msgstr "\"Bring the victims to life! They are free to return to their homes [influence/].\" [goodact/]"

msgid "STORY_EVENT@1048_40@BUTTON_2"
msgstr "\"Revive the victims of the curse! Our army [unit/] can use these <<m:EventUnit>>!\""

msgid "STORY_EVENT@1048_40@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "\"Revive the victims of the curse! My army [unit/] can use these <<m:EventUnit>>!\""

msgid "STORY_EVENT@1048_40@TITLE"
msgstr "Pit of Vipers: Aftermath"

msgid "STORY_EVENT@1048_45@BODY_FOOTER"
msgstr "The beasts are a threat even to {EventCity.Name} itself. What will you do to end this terror?"

msgid "STORY_EVENT@1048_45@BODY_HEADER"
msgstr "A pack of the mighty {EventStackLeader.Name} is roaming the plains near your city {EventCity.Name}."

msgid "STORY_EVENT@1048_45@BODY_LORE"
msgstr "The blood-crazed beasts have been terrorizing the surrounding villages, a broken spear still stuck in the flank of the alpha {EventStackLeader.Name}. Many stories have been told about the {EventSpawner.Name} in the region and the wild animals emerging from its depths. None of them end well."

msgid "STORY_EVENT@1048_45@BUTTON_0"
msgstr "Arm the villagers [unitprod/] to drive the pack off our borders."

msgid "STORY_EVENT@1048_45@BUTTON_1"
msgstr "Muster the populace [unitprod/] to force the pack back to its {EventSpawner.Name}!"

msgid "STORY_EVENT@1048_45@BUTTON_2"
msgstr "The {EventStackLeader.Name} looks like it’s suffering. Carefully tending its wounds might make it turn docile... though the {EventSpawner.Name} will remain."

msgid "STORY_EVENT@1048_45@BUTTON_3"
msgstr "Let the animals come. Our garrisons are prepared."

msgid "STORY_EVENT@1048_45@TITLE"
msgstr "Terror in the Fields"

msgid "STORY_EVENT@1060_1@BODY_FOOTER"
msgstr "To declare the winner, you are asked to pick the most compelling dictum."

msgid "STORY_EVENT@1060_1@BODY_HEADER"
msgstr "On the high rostrum at {EventCity.Name} the grand scholars of your empire are competing in public debate."

msgid "STORY_EVENT@1060_1@BODY_LORE"
msgstr "Demonstrating the knowledge and wits that the {EventRace.Name} have become famous for, each of the participants is laying out the inevitable proof of his own world theory in eloquent ways. Their performance marks another high point in this scholastic golden age of your people."

msgid "STORY_EVENT@1060_1@BUTTON_0"
msgstr "\"The world is a lock. Knowledge [knowledge/] is the key.\""

msgid "STORY_EVENT@1060_1@BUTTON_1"
msgstr "\"Knowledge inspires people [happiness/] to greatness.\""

msgid "STORY_EVENT@1060_1@BUTTON_2"
msgstr "\"Knowledge is the wind [mana/] that lets us sail the astral sea.\""

msgid "STORY_EVENT@1060_1@TITLE"
msgstr "Battle of Wits"

msgid "STORY_EVENT@1060_29@BODY_FOOTER"
msgstr "{EventHouseLord.Name} desires the service of your hero {EventHero.Name}."

msgid "STORY_EVENT@1060_29@BODY_HEADER"
msgstr "During diplomatic negotiations, {EventHouseLord.TitleName} of {EventHouse.Name} contacts you with an unusual request."

msgid "STORY_EVENT@1060_29@BODY_LORE"
msgstr "\"In {EventHouse.Name},\" {EventHouseLord.Pronoun} begins, \"it is customary to seal a new friendship with an exchange of servants. Your envoys showed me a drawing of the fair {EventHero.Name} devoted to your cause. I want {EventHero.PronounObject}. I demand {EventHero.PronounObject}! Choose any of {EventHouse.Name}'s heroes in return...\""

msgid "STORY_EVENT@1060_29@BUTTON_0"
msgstr "\"It's a deal: My {EventHero.Name} for your {EventHouseHero.Name}!\""

msgid "STORY_EVENT@1060_29@BUTTON_1"
msgstr "\"I might be convinced [gold/], to let {EventHero.Name} join you. But {EventHero.Pronoun} comes at a different price [evilact/]...\""

msgid "STORY_EVENT@1060_29@BUTTON_2"
msgstr "\"The people serving me have their own free will [goodact/]. I will not force {EventHero.Name}.\""

msgid "STORY_EVENT@1060_29@TITLE"
msgstr "Personnel Exchange"

msgid "STORY_EVENT@1060_2@BODY_FOOTER"
msgstr "\"Now that you have heard about us being condemned to this unworthy task, what is it that brings you here?\""

msgid "STORY_EVENT@1060_2@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "\"Now that you have heard about us being condemned to this unworthy task, what is it that brings you here, o {PlayerLeader.Title}?\""

msgid "STORY_EVENT@1060_2@BODY_HEADER"
msgstr "Approaching the {EventStructure.Name}, {EventHero.Name} meets the {EventStackLeader.Name}, who seems to be lamenting <<o:EventStackLeader>> fate of having to lead the guards of {EventHouse.Name}."

msgid "STORY_EVENT@1060_2@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Approaching the {EventStructure.Name}, you meet the {EventStackLeader.Name}, who seems to be lamenting <<o:EventStackLeader>> fate of having to lead the guards of {EventHouse.Name}."

msgid "STORY_EVENT@1060_2@BODY_LORE"
msgstr "\"We should be out in the wilds,\" <<p:EventStackLeader>> says, \"slaying a dragon, or assaulting the castle of a robber-knight. Instead, we're stuck keeping watch over the {EventStructure.Name} that nobody cares about. It's a job so lowly, only peasants should have to do it.\""

msgid "STORY_EVENT@1060_2@BUTTON_1"
msgstr "\"I will set you and your men free and buy [gold/] this {EventStructure.Name} from {EventHouse.Name}.\""

msgid "STORY_EVENT@1060_2@BUTTON_2"
msgstr "\"Do you hear that? You're being called back to the defense of {EventHouse.Name}!\""

msgid "STORY_EVENT@1060_2@BUTTON_3"
msgstr "\"I am here to grant you a heroic fight - to the death!\""

msgid "STORY_EVENT@1060_2@BUTTON_4"
msgstr "\"Just seeking adventures. We will be on our way...\""

msgid "STORY_EVENT@1060_2@TITLE"
msgstr "A Job for Peasants"

msgid "STORY_EVENT@1060_30@BODY_FOOTER"
msgstr "What are your orders?"

msgid "STORY_EVENT@1060_30@BODY_FOOTER@STACKLEADER_IS_P"
msgstr "What do you do?"

msgid "STORY_EVENT@1060_30@BODY_HEADER"
msgstr "Your troops engage with a military contingent of {EventHouse.Name}."

msgid "STORY_EVENT@1060_30@BODY_HEADER@STACKLEADER_IS_P"
msgstr "You engage with a military contingent of {EventHouse.Name}."

msgid "STORY_EVENT@1060_30@BODY_LORE"
msgstr "The army of {EventHouseLord.Name} is on the move, with little time or interest in diplomatic pleasantries. Still, their captain is respectful enough to leave time to parley, as an opportunity for your troops to make contact."

msgid "STORY_EVENT@1060_30@BODY_LORE@STACKLEADER_IS_P"
msgstr "The army of {EventHouseLord.Name} is on the move, with little time or interest in diplomatic pleasantries. Still, their captain is respectful enough to leave time to parley, as an opportunity for your troops to make contact."

msgid "STORY_EVENT@1060_30@BUTTON_1"
msgstr "Arrange a diplomatic audience with {EventHouseLord.Name}."

msgid "STORY_EVENT@1060_30@BUTTON_3"
msgstr "Attack! This is the opportunity to strike!"

msgid "STORY_EVENT@1060_30@BUTTON_4"
msgstr "Disengage and let them be on their way."

msgid "STORY_EVENT@1060_30@TITLE"
msgstr "Troop Movement: {EventHouse.Name}"

msgid "STORY_EVENT@1060_3@BODY_FOOTER"
msgstr "\"Not so shy! Dare to join the rout and play? The winner takes the {EventStructure.Name}. It's your skulls against ours!\""

msgid "STORY_EVENT@1060_3@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "\"Not so shy, {PlayerLeader.Title}! Dare to join the rout and play? The winner takes the {EventStructure.Name}. It's your skulls against ours!\""

msgid "STORY_EVENT@1060_3@BODY_HEADER"
msgstr "The rowdy troops of {EventHouse.Name} stationed at the {EventStructure.Name} are indulging in a morbid game."

msgid "STORY_EVENT@1060_3@BODY_LORE"
msgstr "They keep re-arranging the same set of suspiciously humanoid looking bones, only to later knock them over again with skulls hurled from a distance. Their leader, a fierce-looking {EventStackLeader.Name}, eyeballs {EventHero.Name} and laughs."

msgid "STORY_EVENT@1060_3@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "They keep re-arranging the same set of suspiciously humanoid looking bones, only to later knock them over again with skulls hurled from a distance. Their leader, a fierce-looking {EventStackLeader.Name}, eyeballs you and laughs."

msgid "STORY_EVENT@1060_3@BUTTON_1"
msgstr "\"Why settle for bones when you could have enough cattle [food/] to feast on for weeks?\""

msgid "STORY_EVENT@1060_3@BUTTON_2"
msgstr "Grant strength to {EventHero.Name} to play."

msgid "STORY_EVENT@1060_3@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "Gather your strength to play."

msgid "STORY_EVENT@1060_3@BUTTON_3"
msgstr "\"Game over. We'll smash your bones for real!\""

msgid "STORY_EVENT@1060_3@BUTTON_4"
msgstr "\"You keep playing. We will watch from afar...\""

msgid "STORY_EVENT@1060_3@TITLE"
msgstr "Skull Bowling"

msgid "STORY_EVENT@1060_4@BODY_FOOTER"
msgstr "\"Now I keep thinking, was this man's death supposed to be my own? Do you seek my demise, {PlayerLeader.Name}?\""

msgid "STORY_EVENT@1060_4@BODY_HEADER"
msgstr "After a diplomatic dinner with your envoys, you are contacted by a pale {EventHouseLord.TitleName} of {EventHouse.Name}."

msgid "STORY_EVENT@1060_4@BODY_LORE"
msgstr "\"I know I am just a lesser {EventHouseLord.Title} in the eyes of a {PlayerLeader.Title},\" <<p:EventHouseLord>> says anxiously. \"But I need to learn the truth... After trying the stew you {PlayerRace.Name} are famous for, my food taster bloated with gas until the poor man was ripped apart from within, turning the buffet into a nauseating mess...\""

msgid "STORY_EVENT@1060_4@BUTTON_0"
msgstr "\"This was a tragic accident. Let my treasury [gold/] vouch for our friendship.\""

msgid "STORY_EVENT@1060_4@BUTTON_1"
msgstr "\"If I wanted you dead, you would be [evilact/].\""

msgid "STORY_EVENT@1060_4@BUTTON_2"
msgstr "\"It is not my fault you {EventHouseRace.Name} can't stomach our delicacies...\""

msgid "STORY_EVENT@1060_4@BUTTON_3"
msgstr "\"A third party must have poisoned the stew to sabotage negotiations!\""

msgid "STORY_EVENT@1060_4@TITLE"
msgstr "Toxic Stew"

msgid "STORY_EVENT@1064_104@BODY_FOOTER"
msgstr "\"Grand {PlayerLeader.Title}, will you share some of your power, so we can create a magical fruit for {EventHouseLord}?\""

msgid "STORY_EVENT@1064_104@BODY_HEADER"
msgstr "In light of the negotiations with {EventHouseLord.Name}, a group of farmers from {EventHouse} is contacting you with a plea."

msgid "STORY_EVENT@1064_104@BODY_LORE"
msgstr "\"We love our {EventHouseLord.TitleName}!\" their <<EventUnit{spokesman/spokeswoman}>> explains. \"And we want to create a new fruit to honor <<o:EventHouseLord>> name. Magical delicious fruit that tastes more exquisite with every bite. {EventHouseLord} will be enamored with it!\""

msgid "STORY_EVENT@1064_104@BUTTON_0"
msgstr "\"Your request [mana/] shall be granted!\""

msgid "STORY_EVENT@1064_104@BUTTON_1"
msgstr "\"Study [knowledge/] the arcane arts at {EventCity} to learn the enchantments yourselves.\""

msgid "STORY_EVENT@1064_104@BUTTON_2"
msgstr "\"I don't have any mana to spare for this.\""

msgid "STORY_EVENT@1064_104@BUTTON_3"
msgstr "\"Infusing plants with magic is my favorite pastime.\""

msgid "STORY_EVENT@1064_104@TITLE"
msgstr "Magical Fruit Infusion"

msgid "STORY_EVENT@1064_106@BODY_FOOTER"
msgstr "\"We've been abandoned by our {EventHouseLord.Title}. We would happily work for anyone but <<P:EventHouseLord>>.”"

msgid "STORY_EVENT@1064_106@BODY_HEADER"
msgstr "As {EventHero.Name} approaches the {EventStructure.Name}, the bedraggled guards from {EventHouse.Name} look up tiredly."

msgid "STORY_EVENT@1064_106@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "As you approach the {EventStructure.Name}, the bedraggled guards from {EventHouse.Name} look up tiredly."

msgid "STORY_EVENT@1064_106@BODY_LORE"
msgstr "\"Are you interested in this {EventStructure.Name},\" the {EventStackLeader} asks. \"{EventHouseLord.TitleName} demands it be patrolled, but we lack the resources to defend ourselves properly. We lost many good {EventRace.Name} to monsters already. <<Cp:EventHouseLord>> says it's our duty to follow orders, but why follow the orders of a {EventHouseLord.Title} that abandoned us?\""

msgid "STORY_EVENT@1064_106@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "\"Are you interested in this {EventStructure.Name}, {PlayerLeader.Title},\" the {EventStackLeader} asks. \"{EventHouseLord.TitleName} demands it be patrolled, but we lack the resources to defend ourselves properly. We lost many good {EventRace.Name} to monsters already. <<Cp:EventHouseLord>> says it's our duty to follow orders, but why follow the orders of a {EventHouseLord.Title} that abandoned us?\""

msgid "STORY_EVENT@1064_106@BUTTON_1"
msgstr "\"I'll take this {EventStructure.Name} off <<g:hands^p,EventHouseLord>> [gold/]. You may go.\""

msgid "STORY_EVENT@1064_106@BUTTON_2"
msgstr "\"I will buy [gold/] both the {EventStructure.Name} and your service.\""

msgid "STORY_EVENT@1064_106@BUTTON_3"
msgstr "\"Lazy cads! Your weakness makes you an easy target.\""

msgid "STORY_EVENT@1064_106@BUTTON_4"
msgstr "\"I will think about it. Honestly...\""

msgid "STORY_EVENT@1064_106@TITLE"
msgstr "Bedraggled Guards"

msgid "STORY_EVENT@1064_1155@BODY_FOOTER"
msgstr "\"Will you sanctify the code of pacifism we have compiled, o {PlayerLeader.Title} of the {EventRace}, so that we all may openly strive for peace?\""

msgid "STORY_EVENT@1064_1155@BODY_HEADER"
msgstr "The <<EventUnit {chairman/chairwoman}>> of the {EventRace} Council approaches you in a calm, trance-like state."

msgid "STORY_EVENT@1064_1155@BODY_LORE"
msgstr "\"Over time, we {EventRace} have learned to abhor the violence that dominates this realm. We seek to lead a more secluded life, protecting what we have built if we must, but otherwise abandoning the grand battles and plots which only bring the horrors of forceful conflict upon the land and its people.\""

msgid "STORY_EVENT@1064_1155@BUTTON_0"
msgstr "\"Your wisdom pleases me. The {EventRace} shall be known as a peace-loving people.\""

msgid "STORY_EVENT@1064_1155@BUTTON_1"
msgstr "\"I must forbid [influence/] such pacifism. Your ideals, while noble, would bring doom upon the {EventRace}.\""

msgid "STORY_EVENT@1064_1155@BUTTON_2"
msgstr "\"You have been lulled by the vanities of peace. War and violence [evilact/] shall return to dictate the fates [happiness/] of the {EventRace}.\""

msgid "STORY_EVENT@1064_1155@TITLE"
msgstr "Swords to Plowshares"

msgid "STORY_EVENT@1064_1168@BODY_FOOTER"
msgstr "\"By decree of our Council, we wish to establish a custom of pilgrimage to the imperial hoard, so that all {EventRace} may marvel at its glittering beauty.\""

msgid "STORY_EVENT@1064_1168@BODY_HEADER"
msgstr "The chairman of the {EventRace} Council approaches you with a glimmer of greed in his eyes."

msgid "STORY_EVENT@1064_1168@BODY_LORE"
msgstr "\"These are truly blessed times for us {EventRace}. We prosper as things of beauty and worth are kept safe within the divine treasury of your making, o {PlayerLeader.Title}. Other empires look at us with envy, for they can only dream of the material bliss we safeguard and enjoy.\""

msgid "STORY_EVENT@1064_1168@BUTTON_0"
msgstr "\"Proceed as you desire. The worth of gold shall truly be known to all {EventRace}.\""

msgid "STORY_EVENT@1064_1168@BUTTON_1"
msgstr "\"If gold is so dear to the Council, surely a generous donation [gold/] would change your minds.\""

msgid "STORY_EVENT@1064_1168@BUTTON_2"
msgstr "\"Worshiping riches is folly [happiness/]. I will not encourage the greed of the {EventRace}.\""

msgid "STORY_EVENT@1064_1168@TITLE"
msgstr "Wealth Beyond Measure"

msgid "STORY_EVENT@1064_1171@BODY_FOOTER"
msgstr "\"We have compiled a book of tutelage, ready for transcription, so that all {EventRace} may be guided to study the past.\""

msgid "STORY_EVENT@1064_1171@BODY_HEADER"
msgstr "The <<EventUnit {chairman/chairwoman}>> of the {EventRace} Council comes before you, an ornate book in <<o:EventUnit>> hands."

msgid "STORY_EVENT@1064_1171@BODY_LORE"
msgstr "\"This,\" <<p:EventUnit>> says with pathos, \"is the legacy of the {EventRace}. In ages past, tribes, kingdoms and entire realms have disappeared into the mists of time, their knowledge seemingly lost forever. But with great dedication and spellcraft, much that was forgotten can be rediscovered, like runic messages carved deeply into the hidden roots of this world.\""

msgid "STORY_EVENT@1064_1171@BUTTON_0"
msgstr "\"You are wise. This ancient knowledge will reshape the {EventRace}.\""

msgid "STORY_EVENT@1064_1171@BUTTON_1"
msgstr "\"The past is not comprehensible to the masses. Let me enlighten [knowledge/] you...\""

msgid "STORY_EVENT@1064_1171@BUTTON_2"
msgstr "\"I forbid [happiness/] such dwelling in the past. Shape rather the future, ere all the {EventRace} have turned to dust.\""

msgid "STORY_EVENT@1064_1171@TITLE"
msgstr "Delvers of Secrets"

msgid "STORY_EVENT@1064_1179@BODY_FOOTER"
msgstr "\"Please, my {PlayerLeader.Title}, name any offering or service I can give to save me and my family from this curse.\""

msgid "STORY_EVENT@1064_1179@BODY_HEADER"
msgstr "A merchant of the {EventRace} from {EventCity}, widely known for <<o:EventUnit>> depraved feasts, has come before your throne, pleading for absolution."

msgid "STORY_EVENT@1064_1179@BODY_LORE"
msgstr "\"Do not look with wrath upon this poor sinner, O {PlayerLeader.Title},\" the <<EventUnit {man/woman}>> begs, <<o:EventUnit>> voice thick with fear. \"For too long have I ignored the divine bidding of thy faith. Now a dark curse has befallen me, slowly destroying all I hold dear. Even my own health is dwindling, draining any strength I have left.\""

msgid "STORY_EVENT@1064_1179@BUTTON_0"
msgstr "\"Renounce your worldly possessions [gold/] and your soul shall find rest.\""

msgid "STORY_EVENT@1064_1179@BUTTON_1"
msgstr "\"Study the holy scriptures [knowledge/] and the path of redemption will reveal itself to you.\""

msgid "STORY_EVENT@1064_1179@BUTTON_2"
msgstr "\"Embark on a pilgrimage [orderboon/] to seek the light of true faith.\""

msgid "STORY_EVENT@1064_1179@TITLE"
msgstr "Divine Absolution"

msgid "STORY_EVENT@1064_1181@BODY_FOOTER"
msgstr "\"Oooo, how long have we waited in darkness... Release us... Free us!\""

msgid "STORY_EVENT@1064_1181@BODY_HEADER"
msgstr "Hazy whispers emerge from the depths of your crypt, drawing your attention to a sealed jar of unknown origin."

msgid "STORY_EVENT@1064_1181@BODY_LORE"
msgstr "\"{PlayerLeader}... come beneath the shadows. Listen to us... <<p:PlayerLeader>>, who can hear our voice. Dark magic was our crime. Eternal imprisonment our sentence.\""

msgid "STORY_EVENT@1064_1181@BUTTON_0"
msgstr "Dispel the jar's curse [mana/] to free the spirits [shadowboon/]."

msgid "STORY_EVENT@1064_1181@BUTTON_1"
msgstr "Channel [mana/] the jar's souls [souls/] for your dark magic."

msgid "STORY_EVENT@1064_1181@BUTTON_2"
msgstr "Leave the jar in your crypt."

msgid "STORY_EVENT@1064_1181@BUTTON_3"
msgstr "Subdue the ancient spirits to harness their secrets [knowledge/]."

msgid "STORY_EVENT@1064_1181@TITLE"
msgstr "Whispers of Woe"

msgid "STORY_EVENT@1064_1184@BODY_FOOTER"
msgstr "\"Which hideous new shape should I give this spy of {EventHouse}? Frosty beasts are my specialty...\""

msgid "STORY_EVENT@1064_1184@BODY_HEADER"
msgstr "In the days of the war with {EventHouse} an unexpected guest appears at your court: a wicked {EventUnit} from the far north."

msgid "STORY_EVENT@1064_1184@BODY_LORE"
msgstr "\"Tremendous {PlayerLeader}, long have I observed your intriguingly eerie reign. It chilled my senses and tingled my frozen veins. I have come now with a gift.\" She shows a vicious smile as she presents a man of the {EventRace} trapped in a floating cage of ice."

msgid "STORY_EVENT@1064_1184@BUTTON_0"
msgstr "\"Make him a {TargetWolf} [unit/], let his howl scare all {EventHouse}.\""

msgid "STORY_EVENT@1064_1184@BUTTON_1"
msgstr "\"As a {TargetSpider} [unit/], he will trap other spies in his net.\""

msgid "STORY_EVENT@1064_1184@BUTTON_2"
msgstr "\"Leave him to me. His knowledge of {EventHouse} [garrison/] will be their downfall.\""

msgid "STORY_EVENT@1064_1184@BUTTON_3"
msgstr "\"Turn him to eternal ice [shadowboon/]. He shall be a fitting ornament for my court.\""

msgid "STORY_EVENT@1064_1184@TITLE"
msgstr "Wicked Homage"

msgid "STORY_EVENT@1064_1187@BODY_FOOTER"
msgstr "Do you try to prevent the destruction that could strike the {EventStructure} near your city of {EventCity}?"

msgid "STORY_EVENT@1064_1187@BODY_HEADER"
msgstr "Through your deep link to the world underneath you sense the movements of an elder earth elemental."

msgid "STORY_EVENT@1064_1187@BODY_LORE"
msgstr "Disturbed in its ancient slumber, the elemental is rumbling restlessly, shaking the world that is built on its back. A tectonic disaster seems to be imminent as the elemental slowly moves toward {EventCity}."

msgid "STORY_EVENT@1064_1187@BUTTON_0"
msgstr "Commune with the elemental [mana/] to lull it to sleep again. [materiumboon/]"

msgid "STORY_EVENT@1064_1187@BUTTON_1"
msgstr "Channel your magic [mana/] to divert the elemental to a rival's domain."

msgid "STORY_EVENT@1064_1187@BUTTON_2"
msgstr "Ignore the elder elemental until it reaches {EventCity}."

msgid "STORY_EVENT@1064_1187@TITLE"
msgstr "Moving Earth"

msgid "STORY_EVENT@1064_1338@BODY_FOOTER"
msgstr "The prison warden chokes off the <<G:pitiful sputterings^p,EventUnit>>. \"What should we do with this spy from treacherous {EventHouse.Name}?\""

msgid "STORY_EVENT@1064_1338@BODY_HEADER"
msgstr "A <<EventUnit{man/woman}>> lies before you, raw agony reflected in <<o:EventUnit>> face. \"Please... I'll do anything. Please don't kill me!\""

msgid "STORY_EVENT@1064_1338@BODY_LORE"
msgstr "Your prison warden yanks the <<G:iron leash^n,EventUnit>>. \"Caught spying for {EventHouse}!\" An audible gasp echoes through the chamber. Every courtier expresses their shock, saying they would never do such a thing, not for any reward. The spy continues to plead. \"{EventHouseLord} will kill my family. Please! I am no one. I meant no harm to your vast empire.\""

msgid "STORY_EVENT@1064_1338@BUTTON_0"
msgstr "Hang <<P:EventUnit>> from the gate [evilact/] as a message [relationLvl-3/] to {EventHouse}."

msgid "STORY_EVENT@1064_1338@BUTTON_1"
msgstr "Discretely contact {EventHouseLord} to barter a ransom [gold/]."

msgid "STORY_EVENT@1064_1338@BUTTON_2"
msgstr "End <<o:EventUnit>> life. <<Co:EventUnit>> traitorous body joins my loyal undead warriors. [shadowboon/]"

msgid "STORY_EVENT@1064_1338@BUTTON_3"
msgstr "Use <<P:EventUnit>> to feed favorable information [relationLvl3/] to {EventHouseLord}."

msgid "STORY_EVENT@1064_1338@BUTTON_4"
msgstr "\"This <<EventUnit{man/woman}>> has been tortured enough. [goodact/] Set <<P:EventUnit>> free!\""

msgid "STORY_EVENT@1064_1338@TITLE"
msgstr "The Prying Eyes of {EventHouse}"

msgid "STORY_EVENT@1064_1474@BODY_FOOTER"
msgstr "\"We have the Gildercoil, the only key to the world vault called Grexolis. Yet it may only be used when all of Grexolis is under our control.\""

msgid "STORY_EVENT@1064_1474@BODY_HEADER"
msgstr "Looking at the fragmented continents of {GLOBAL.GrexolisLoreConcept.Hyperlink}, you are approached by your {GLOBAL.ShadraiFactionLoreConcept.Hyperlink} allies."

msgid "STORY_EVENT@1064_1474@BODY_LORE"
msgstr "\"A world sacrificed to a greater purpose - commendable, yet in vain.\" {EventPlayer} speaks slowly and with gravity, as if every word <<p:EventPlayer>> pronounced was a challenge in itself. \"The {GLOBAL.ArchonsLoreConcept.Hyperlink} did what they deemed to be just, but their strength was dwindling. Where they saw danger, we see potential.\""

msgid "STORY_EVENT@1064_1474@BUTTON_0"
msgstr "Hear more of Grexolis and its warden."

msgid "STORY_EVENT@1064_1474@TITLE"
msgstr "The World Vault"

msgid "STORY_EVENT@1064_1476@BODY_FOOTER"
msgstr "{EventHero.FirstName} descends to the crater and, without hesitation, activates the Gildercoil."

msgid "STORY_EVENT@1064_1476@BODY_HEADER"
msgstr "As {EventHero.FirstName} holds up the Gildercoil, the fragmented continents of {GLOBAL.GrexolisLoreConcept.Hyperlink} are set in motion, like the cogwheels of a gargantuan engine."

msgid "STORY_EVENT@1064_1476@BODY_LORE"
msgstr "The earth shakes and buildings collapse, until a giant hollow is formed. Glowing runes surrounding the hollow point you toward the center."

msgid "STORY_EVENT@1064_1476@BUTTON_0"
msgstr "Brace yourself for the opening of the World Vault."

msgid "STORY_EVENT@1064_1476@TITLE"
msgstr "Opening Grexolis"

msgid "STORY_EVENT@1064_1512@BODY_FOOTER"
msgstr "Inspired by the moment, you feel empowered and capable of conjuring an object from the Astral Sea yourself."

msgid "STORY_EVENT@1064_1512@BODY_HEADER"
msgstr "The breach at the mana node hums like an arcane echo as the raw magic of the {GLOBAL.AstralSeaLoreConcept.Hyperlink} returns to resonate with its {GLOBAL.AstralFlowsLoreConcept.Hyperlink}."

msgid "STORY_EVENT@1064_1512@BODY_LORE"
msgstr "The astral invaders have been repelled, leaving a haunting impression of the dangers lurking beyond {GLOBAL.AthlaLoreConcept.Hyperlink}. Yet you can't shake off the feeling of having glimpsed something grand, a window opening up between worlds."

msgid "STORY_EVENT@1064_1512@BUTTON_0"
msgstr "Summon a magical artifact [item/]."

msgid "STORY_EVENT@1064_1512@BUTTON_1"
msgstr "Draw in a large mana crystal [mana/]."

msgid "STORY_EVENT@1064_1512@BUTTON_2"
msgstr "Conjure a magical companion [unit/]."

msgid "STORY_EVENT@1064_1512@TITLE"
msgstr "Hunters from Beyond: Aftermath"

msgid "STORY_EVENT@1064_1515@BODY_FOOTER"
msgstr "To protect your people and restore their faith in your rule you must seek out the {GLOBAL.AstralMonstersLoreConcept.Hyperlink} near {EventCity}."

msgid "STORY_EVENT@1064_1515@BODY_HEADER"
msgstr "For a brief while your people had found respite in this Valley of Wonders. But now panicked shouts start to echo in the streets of {EventCity}."

msgid "STORY_EVENT@1064_1515@BODY_LORE"
msgstr "\"Doom is upon us! Monsters from the beyond!\" Your scouts arrive shortly after the uproar. Creatures from the {GLOBAL.AstralSeaLoreConcept.Hyperlink} have been sighted near the city. The fear of the {EventRace} quickly leads to doubt. Was {EventHouseLord} right? Have your magic powers attracted the creatures from afar?"

msgid "STORY_EVENT@1064_1515@BUTTON_0"
msgstr "These otherworldly horrors will find that the {EventRace} are no easy prey."

msgid "STORY_EVENT@1064_1515@TITLE"
msgstr "Hunters from Beyond"

msgid "STORY_EVENT@1064_1518@BODY_FOOTER"
msgstr "It is clear that the {EventStackLeader} is striking fear into the hearts of your soldiers. What do you do?"

msgid "STORY_EVENT@1064_1518@BODY_HEADER"
msgstr "As you approach the creatures from the {GLOBAL.AstralSeaLoreConcept.Hyperlink}, their horrific nature becomes fully revealed."

msgid "STORY_EVENT@1064_1518@BODY_LORE"
msgstr "Haunting eyes gaze from disturbingly flowing limbs. An eerie quiet surrounds the monsters, while the air around them crackles with magically charged strokes."

msgid "STORY_EVENT@1064_1518@BUTTON_3"
msgstr "Fearsome or not, these monsters must die. Attack!"

msgid "STORY_EVENT@1064_1518@BUTTON_4"
msgstr "Set a bounty [gold/] on the head of the {EventStackLeader}."

msgid "STORY_EVENT@1064_1518@BUTTON_5"
msgstr "Channel your magic prowess to force the creatures back into the Astral Sea."

msgid "STORY_EVENT@1064_1518@BUTTON_7"
msgstr "Flee."

msgid "STORY_EVENT@1064_1518@BUTTON_8"
msgstr "Remind the troops of the grandeur [influence/] and bravery of their forefathers."

msgid "STORY_EVENT@1064_1518@TITLE"
msgstr "Encountering the Hunters from Beyond"

msgid "STORY_EVENT@1064_1605@BODY_FOOTER"
msgstr "\"I will talk to you through visions like these. Follow my advice and you will claim victory.\""

msgid "STORY_EVENT@1064_1605@BODY_HEADER"
msgstr "From the shrouded mists of your mind emerges a <<EventHero{man/woman}>> all clad in ethereal silk. \"I see you have arrived in the Crimson Caldera, {PlayerLeader},\" <<p:EventHero>> says, and you recognize <<P:EventHero>> as {EventHero}."

msgid "STORY_EVENT@1064_1605@BODY_LORE"
msgstr "\"All {GLOBAL.ShadraiFactionLoreConcept.Hyperlink} have put much faith in your talents. Remain alert! Mistakes are deadly in this [hyperlink,GLOBAL.ObbadothLoreConcept]demonic realm[/hyperlink], in which everyone is a prisoner of war. Betrayal looms over each moment to come, be it through the enemy, the land viciously changing shape, or even your own soldiers.\""

msgid "STORY_EVENT@1064_1605@BUTTON_0"
msgstr "\"Speak to me of the Gildercoil and its bearings.\""

msgid "STORY_EVENT@1064_1605@TITLE"
msgstr "Emissary of the Shad'rai"

msgid "STORY_EVENT@1064_1610@BODY_FOOTER"
msgstr "\"Let me conquer your heart, {PlayerLeader.FirstName}, just as I will conquer your cities. Please resist, it will be all the more alluring.\""

msgid "STORY_EVENT@1064_1610@BODY_HEADER"
msgstr "\"A new pawn has entered the playground of lust. Does it know passion? Is it the <<PlayerLeader{seducer/seductress}>> or the seduced?\" Soft whispers announce to you the coming of {EventPlayer}."

msgid "STORY_EVENT@1064_1610@BODY_LORE"
msgstr "The {EventPlayer.Title} of the {EventRace} looks at you with glaring lechery. Or feigned lechery, for <<p:EventPlayer>> surely trained this act to perfection. {EventPlayer} makes a lascivious gesture. \"Embrace your carnal desires, {PlayerLeader}. Pleasure is a feast without satiation and I invite you to take a bite.\""

msgid "STORY_EVENT@1064_1610@BUTTON_0"
msgstr "Bear the unsettling speech in silence. You will respond on the battlefield [unitprod/]."

msgid "STORY_EVENT@1064_1610@BUTTON_1"
msgstr "Listen unmoved. A focused mind [knowledge/] won't be bothered by this charade."

msgid "STORY_EVENT@1064_1610@BUTTON_2"
msgstr "<<Co:EventPlayer>> sins will be <<o:EventPlayer>> downfall. Your empire is a bastion of virtue [orderboon/]."

msgid "STORY_EVENT@1064_1610@BUTTON_3"
msgstr "You accept the challenge. No one can beat your {PlayerRace} in their violent revelry [chaosboon/]."

msgid "STORY_EVENT@1064_1610@TITLE"
msgstr "The Madness of {EventPlayer}"

msgid "STORY_EVENT@1064_1620@BODY_FOOTER"
msgstr "\"Many of the {GLOBAL.ShadraiFactionLoreConcept.Hyperlink} have expressed their desire to lend more aid. Choose what you deem the most helpful for your campaign.\""

msgid "STORY_EVENT@1064_1620@BODY_HEADER"
msgstr "\"I applaud your determination, {PlayerLeader}.\" {EventHero} claps her hands ostentatiously."

msgid "STORY_EVENT@1064_1620@BODY_LORE"
msgstr "\"You truly have become a weaver of nightmares. The trap has been prepared—time to lure your victims to their doom.\""

msgid "STORY_EVENT@1064_1620@BUTTON_0"
msgstr "Choose the <<m:{EventUnit01}>> [unit/] of Yaka Enkhanan."

msgid "STORY_EVENT@1064_1620@BUTTON_2"
msgstr "Take the {EventItem} [item/] of Ydgaard Worldbender."

msgid "STORY_EVENT@1064_1620@BUTTON_3"
msgstr "Summon the <<m:{EventUnit02}>> [unit/] of Nimue the Siren Queen."

msgid "STORY_EVENT@1064_1620@BUTTON_4"
msgstr "\"They help now my victory is drawing near? The glory [influence/] will be mine alone!\""

msgid "STORY_EVENT@1064_1620@TITLE"
msgstr "Nightmare Weaver: Aftermath"

msgid "STORY_EVENT@1064_1622@BODY_FOOTER"
msgstr "\"Cast the Mind Thread spell on a Godir, and you shall find a way to force out what they know of the Gildercoil.\""

msgid "STORY_EVENT@1064_1622@BODY_HEADER"
msgstr "\"You have found your first suspect, {PlayerLeader}.\" {EventHero} shows a cold smile. \"Then it is time to teach you about the Mind Thread spell.\""

msgid "STORY_EVENT@1064_1622@BODY_LORE"
msgstr "{EventHero.FirstName} continues: \"As our {GLOBAL.ShadraiFactionLoreConcept.Hyperlink} ally {ArachnaSecondary.FirstName} would say, a spider does not openly attack its prey; it finds a way to trap its victim in its webs. The Mind Thread spell works in similar ways. It allows you to invade the mind of a {GLOBAL.GodirLoreConcept.Hyperlink} to learn of their nightmares and trap them within their innermost fears or ambitions.\""

msgid "STORY_EVENT@1064_1622@BUTTON_0"
msgstr "\"Insidious. I like it [evilact/].\""

msgid "STORY_EVENT@1064_1622@BUTTON_1"
msgstr "\"This seems like a necessary evil.\""

msgid "STORY_EVENT@1064_1622@TITLE"
msgstr "Nightmare Weaver"

msgid "STORY_EVENT@1064_1636@BODY_FOOTER"
msgstr "\"The bloodshed of the battlefield is only the appetizer. Once the vanquished enter the slaughterhouse, the true fun begins.\""

msgid "STORY_EVENT@1064_1636@BODY_HEADER"
msgstr "A flickering flame taunts your eyes as {EventPlayer} ascends from a pool of scarlet ichor."

msgid "STORY_EVENT@1064_1636@BODY_LORE"
msgstr "\"Some say the blood of men would be an aphrodisiac,\" <<p:EventPlayer>> says with a malicious smile. \"I say it is a source of power. I drink, while my {EventRace} consume flesh and bones. It's a fair share, don't you think?\""

msgid "STORY_EVENT@1064_1636@BUTTON_0"
msgstr "\"Cannibalism? This is disgusting...\" [goodact/]"

msgid "STORY_EVENT@1064_1636@BUTTON_1"
msgstr "\"We shall see who laughs last.\""

msgid "STORY_EVENT@1064_1636@BUTTON_2"
msgstr "\"While I appreciate your morbid methods [evilact/], you must still fall before my throne.\""

msgid "STORY_EVENT@1064_1636@TITLE"
msgstr "The Madness of {EventPlayer}"

msgid "STORY_EVENT@1064_1641@BODY_FOOTER"
msgstr "\"I don't have the Gildercoil. I killed many to earn it as my prize, but to no avail. Now, take this thing away—please!\""

msgid "STORY_EVENT@1064_1641@BODY_HEADER"
msgstr "At the sight of the {EventUnit}, {EventPlayer} freezes."

msgid "STORY_EVENT@1064_1641@BODY_LORE"
msgstr "Seemingly unable to act or flee, <<p:EventPlayer>> expresses growing terror as the horrible creature slowly draws close to <<P:EventPlayer>>."

msgid "STORY_EVENT@1064_1641@BUTTON_0"
msgstr "Let the {EventUnit} drag {EventPlayer} to the Astral Sea. [evilact/]"

msgid "STORY_EVENT@1064_1641@BUTTON_1"
msgstr "\"Leave now and never come back!\" [goodact/]"

msgid "STORY_EVENT@1064_1641@BUTTON_2"
msgstr "\"If I save you, you serve me.\""

msgid "STORY_EVENT@1064_1641@TITLE"
msgstr "Tormented Past: Aftermath"

msgid "STORY_EVENT@1064_1645@BODY_FOOTER"
msgstr "\"Lay down your weapons and you may find peace in the afterlife. All who resist will be struck down and purged.\""

msgid "STORY_EVENT@1064_1645@BODY_HEADER"
msgstr "\"Begone, foul spawn of {GLOBAL.ObbadothLoreConcept.Hyperlink}!\" A righteous shout pierces the skies as {EventPlayer} descends from above with holy fury."

msgid "STORY_EVENT@1064_1645@BODY_LORE"
msgstr "\"Your dark disguises cannot fool my true sight, for your inner demons have betrayed your purpose. The Crimson Caldera is an ever-flowing chalice of violence and death. I will drink from it.\""

msgid "STORY_EVENT@1064_1645@BUTTON_0"
msgstr "\"You shall have your war.\""

msgid "STORY_EVENT@1064_1645@TITLE"
msgstr "The Madness of {EventPlayer}"

msgid "STORY_EVENT@1064_1647@BODY_FOOTER"
msgstr "\"There is one such {EventUnit} chained to the Crimson Caldera. Free <<p:EventUnit>> and <<p:EventUnit>> won't deny you the judgement of {EventPlayer}.\""

msgid "STORY_EVENT@1064_1647@BODY_HEADER"
msgstr "\"The demons of {GLOBAL.ObbadothLoreConcept.Hyperlink} bask in corruption,\" {EventHero.FirstName} elaborates. \"More than destruction, they seek to foster the inner demons of their victims.\""

msgid "STORY_EVENT@1064_1647@BODY_LORE"
msgstr "\"On rare occasions, those fiends succeed in dragging a {EventUnit} to their demonic realm, where they bind and attempt to turn it through never-ending rituals.\""

msgid "STORY_EVENT@1064_1647@BUTTON_0"
msgstr "\"Judgment day will be coming.\""

msgid "STORY_EVENT@1064_1647@TITLE"
msgstr "Unholy Ambitions"

msgid "STORY_EVENT@1064_1648@BODY_FOOTER"
msgstr "\"I do not have the Gildercoil. But take what you want, {PlayerLeader}. Anything to avert the {EventUnit} from my path.\""

msgid "STORY_EVENT@1064_1648@BODY_HEADER"
msgstr "The {EventUnit} ascends to the clouds above {EventPlayer}. <<Co:EventUnit>> mere presence causes {EventPlayer.FirstName} to unravel."

msgid "STORY_EVENT@1064_1648@BODY_LORE"
msgstr "\"Your unholy powers are beyond what I expected, {PlayerLeader.TitleName}. I shall withdraw from the Crimson Caldera and not return.\" Anxiously, {EventPlayer.FirstName} gazes at the {EventUnit} and then back at you."

msgid "STORY_EVENT@1064_1648@BUTTON_0"
msgstr "\"Let it be known throughout the realm [influence/] that you withdraw at my mercy.\""

msgid "STORY_EVENT@1064_1648@BUTTON_1"
msgstr "\"Make your most zealous troops [unit/] pledge allegiance to me.\""

msgid "STORY_EVENT@1064_1648@BUTTON_2"
msgstr "\"I don't need your pitiful offerings. Judgment awaits [evilact/].\""

msgid "STORY_EVENT@1064_1648@TITLE"
msgstr "Unholy Ambitions: Aftermath"

msgid "STORY_EVENT@1064_1650@BODY_FOOTER"
msgstr "\"What you need is a {EventUnit} to threaten <<ge:judgment^n,EventPlayer.FirstName>>.\""

msgid "STORY_EVENT@1064_1650@BODY_HEADER"
msgstr "\"There is an old saying that what an inquisitor fears the most is the inquisition itself.\" {EventHero} speaks slowly, interpreting the glimpse of <<ge:mind^n,EventPlayer.FirstName>>."

msgid "STORY_EVENT@1064_1650@BODY_LORE"
msgstr "\"It seems that the zeal of {EventPlayer} is driven by <<o:EventPlayer>> fear of not being worthy <<r:EventPlayer>>. By culling evil, <<p:EventPlayer>> attempts to prove <<o:EventPlayer>> purity of faith, yet <<p:EventPlayer>> fears the true path to ascension is still hidden from <<P:EventPlayer>>.\""

msgid "STORY_EVENT@1064_1650@BUTTON_0"
msgstr "\"The plan is good, yet where would I find a {EventUnit} in a demonic realm?\""

msgid "STORY_EVENT@1064_1650@TITLE"
msgstr "Judging the Judge"

msgid "STORY_EVENT@1064_1674@BODY_FOOTER"
msgstr "\"There are three <<m:{EventSpawner}>> dedicated to Atyngwe far to the southwest. Negotiate well, and <<ge: contract^n,EventPlayer.FirstName>> will be yours.\""

msgid "STORY_EVENT@1064_1674@BODY_HEADER"
msgstr "\"A contract with the Princes of {GLOBAL.ObbadothLoreConcept.Hyperlink} can't be broken. But it can be altered.\""

msgid "STORY_EVENT@1064_1674@BODY_LORE"
msgstr "\"If Atyngwe signs over <<ge: debt^n,EventPlayer.FirstName>> to you, <<p:EventPlayer>> will be at your mercy. Atyngwe himself has no holdings in the Crimson Caldera, but there are ways of making yourself heard.\""

msgid "STORY_EVENT@1064_1674@BUTTON_0"
msgstr "<<ge: schemes^p,EventPlayer.FirstName>> are about to end."

msgid "STORY_EVENT@1064_1674@TITLE"
msgstr "Infernal Dealings"

msgid "STORY_EVENT@1064_1675@BODY_FOOTER"
msgstr "\"Tell me, {PlayerLeader.TitleName}, what is it that you have to offer in exchange for the soul of a {GLOBAL.GodirLoreConcept.Hyperlink}?\""

msgid "STORY_EVENT@1064_1675@BODY_HEADER"
msgstr "At last, Atyngwe himself answers your calls. \"I have come.\""

msgid "STORY_EVENT@1064_1675@BODY_LORE"
msgstr "\"What you seek will be costly, {PlayerLeader}.\" Within Atyngwe's hands, a parchment scroll signed in blood appears. \"A contract with a Prince of {GLOBAL.ObbadothLoreConcept.Hyperlink} is no mere trade good. But you have piqued my interest...\""

msgid "STORY_EVENT@1064_1675@BUTTON_0"
msgstr "\"My victories [influence/] in the Crimson Caldera will be dedicated to you, O Atyngwe, greatest of all Demonic Princes.\""

msgid "STORY_EVENT@1064_1675@BUTTON_1"
msgstr "\"I gift your majesty an army [unitprod/] to command.\""

msgid "STORY_EVENT@1064_1675@BUTTON_2"
msgstr "\"One soul for the souls of a nation [population/], a sacrifice worth making [evilact/].\""

msgid "STORY_EVENT@1064_1675@BUTTON_3"
msgstr "This price is too high. Better to take on {EventPlayer} the conventional way."

msgid "STORY_EVENT@1064_1675@TITLE"
msgstr "Meeting the Devil"

msgid "STORY_EVENT@1064_1677@BODY_FOOTER"
msgstr "\"{EventPlayer.FirstName} is not the captive of the {EventRace}, but <<p:EventPlayer>> lost <<o:EventPlayer>> soul to the Demonic Prince Atyngwe and must, by contract, abide to his will.\""

msgid "STORY_EVENT@1064_1677@BODY_HEADER"
msgstr "\"Oh my, oh my...\" {EventHero} raises an eyebrow. \"Even for {GLOBAL.GodirLoreConcept.Hyperlink}, this mind is a maze not easily navigated.\""

msgid "STORY_EVENT@1064_1677@BODY_LORE"
msgstr "\"{EventPlayer} dwells in deception and trickery. Anything <<p:EventPlayer>> speaks seem to be lies, yet there is one ironic truth in <<o:EventPlayer>> staged plea for help.\""

msgid "STORY_EVENT@1064_1677@BUTTON_0"
msgstr "Ask how this will aid with your cause."

msgid "STORY_EVENT@1064_1677@TITLE"
msgstr "Weakness of Truth"

msgid "STORY_EVENT@1064_1679@BODY_FOOTER"
msgstr "It is clear that nothing of use can come from talking to the {EventUnit}."

msgid "STORY_EVENT@1064_1679@BODY_HEADER"
msgstr "As you call out to Atyngwe, a {EventUnit} emerges from the closing infernal rift the cultists had summoned. \"You calls my master, yes, yes?\""

msgid "STORY_EVENT@1064_1679@BODY_LORE"
msgstr "Having heard your case, the {EventUnit} shakes <<o:EventUnit>> head, giggling. \"Silly wizard, demon contractses are not for trade, no, no.\" <<Cp:EventUnit>> mockingly jumping from leg to leg in a twitchy manner. \"But I can throw you a burny rock. One, two and it bites!\""

msgid "STORY_EVENT@1064_1679@BUTTON_0"
msgstr "Let the {EventUnit} return to <<o:EventUnit>> master."

msgid "STORY_EVENT@1064_1679@TITLE"
msgstr "Meeting the Dirt Beneath the Devil's Advocate's Shoes"

msgid "STORY_EVENT@1064_1682@BODY_FOOTER"
msgstr "Which {GLOBAL.GodirLoreConcept.Hyperlink} will be the target of your dark intrusion?"

msgid "STORY_EVENT@1064_1682@BODY_HEADER"
msgstr "Performing the ritual taught to you by {EventHero}, you recite the incantations of the Mind Thread spell:"

msgid "STORY_EVENT@1064_1682@BODY_LORE"
msgstr "\"When darkness falls[br/]and shadows creep[br/]a weaver comes to those who sleep.[br/]Spin me a thread of dreams and fears,[br/]a net that takes me to their tears.\""

msgid "STORY_EVENT@1064_1682@BUTTON_0"
msgstr "{DarkAI}"

msgid "STORY_EVENT@1064_1682@BUTTON_1"
msgstr "{BarbAI}"

msgid "STORY_EVENT@1064_1682@BUTTON_2"
msgstr "{IndusAI}"

msgid "STORY_EVENT@1064_1682@BUTTON_3"
msgstr "{Frikka}"

msgid "STORY_EVENT@1064_1682@BUTTON_4"
msgstr "{HighAI}"

msgid "STORY_EVENT@1064_1682@BUTTON_5"
msgstr "No one to target"

msgid "STORY_EVENT@1064_1682@TITLE"
msgstr "Casting the Mind Thread Spell"

msgid "STORY_EVENT@1064_1686@BODY_FOOTER"
msgstr "\"Patience. Were you not aware that we demons invented bureaucracy? It was a stroke of genius.\""

msgid "STORY_EVENT@1064_1686@BODY_HEADER"
msgstr "Once more you challenge Atyngwe to show himself. This time a {EventUnit} comes forward."

msgid "STORY_EVENT@1064_1686@BODY_LORE"
msgstr "\"A contract modification concerning the lessee {EventPlayer}? Delightful,\" <<p:EventUnit>> says in a dry voice. \"Well, fill in the forms and we will evaluate the request. No specific deadline assured.\""

msgid "STORY_EVENT@1064_1686@BUTTON_0"
msgstr "Let the {EventUnit} return through the infernal rift."

msgid "STORY_EVENT@1064_1686@BUTTON_3"
msgstr "Command the {EventUnit} to call forth <<o:EventUnit>> master directly."

msgid "STORY_EVENT@1064_1686@BUTTON_4"
msgstr "Threaten to smite the {EventUnit} with holy light."

msgid "STORY_EVENT@1064_1686@TITLE"
msgstr "Meeting the Devil's Advocate"

msgid "STORY_EVENT@1064_1694@BODY_FOOTER"
msgstr "\"You may own me in the afterlife, but until then I am free to go. Take what pleases you most as a toll for my debt.\""

msgid "STORY_EVENT@1064_1694@BODY_HEADER"
msgstr "Noting the very familiar parchment scroll in your hands, {EventPlayer} shows clear signs of panic."

msgid "STORY_EVENT@1064_1694@BODY_LORE"
msgstr "\"How... generous of you to redeem my contract and set me free from Atyngwe's demanding grip.\" Seeing your amused reaction, <<p:EventPlayer>> stops. \"Well played, {PlayerLeader}. If I had the Gildercoil, it would be yours.\""

msgid "STORY_EVENT@1064_1694@BUTTON_0"
msgstr "\"Empty your treasury [gold/], {EventPlayer}!\""

msgid "STORY_EVENT@1064_1694@BUTTON_1"
msgstr "\"Send all mana [mana/] you have stored!\""

msgid "STORY_EVENT@1064_1694@BUTTON_2"
msgstr "\"Share your secrets [knowledge/], trickster mage!\""

msgid "STORY_EVENT@1064_1694@TITLE"
msgstr "Infernal Dealings: Aftermath"

msgid "STORY_EVENT@1064_1696@BODY_FOOTER"
msgstr "\"This hammer owes its power to the soul of a Storm Giant dwelling inside. Which of my artifacts will yours inhabit, {PlayerLeader}?\""

msgid "STORY_EVENT@1064_1696@BODY_HEADER"
msgstr "The fanfare of a thousand hammers hitting an anvil heralds the coming of {EventPlayer}, Demonic Prince of the Forge."

msgid "STORY_EVENT@1064_1696@BODY_LORE"
msgstr "\"Welcome, {PlayerLeader}, to a [hyperlink,GLOBAL.ObbadothLoreConcept]world of reclamation[/hyperlink], where even the most loathsome soul receives its purpose. Work in the crucible, fuel the fires of {EventCity} or prove worthy to augment my machines and weaponry with your life force. Either way, you are a valuable resource to {EventPlayer}.\""

msgid "STORY_EVENT@1064_1696@BUTTON_0"
msgstr "\"I will be your executioner's sword.\""

msgid "STORY_EVENT@1064_1696@TITLE"
msgstr "The Madness of {EventPlayer}"

msgid "STORY_EVENT@1064_1697@BODY_FOOTER"
msgstr "{EventHero.FirstName} twitches at <<o:EventHero>> ethereal web, which starts moving as liquid shades violently devour the horn. \"When a foe can't be trapped, it must be overwhelmed.\""

msgid "STORY_EVENT@1064_1697@BODY_HEADER"
msgstr "Trying to stalk the mind of {EventPlayer}, you sense a strong force pushing your astral grip aside, like plated armor deflecting an arrow."

msgid "STORY_EVENT@1064_1697@BODY_LORE"
msgstr "\"Invading the memory of a Demonic Prince? I admire your ambitions, {PlayerLeader}.\" {EventHero} takes out the horn of a bull and slowly covers it in dark astral strings. \"But it seems that ages of competition and betrayal have taught the Princes of {GLOBAL.ObbadothLoreConcept.Hyperlink} to protect their minds well.\""

msgid "STORY_EVENT@1064_1697@BUTTON_0"
msgstr "Accept the gift [unit/] of {EventHero}."

msgid "STORY_EVENT@1064_1697@TITLE"
msgstr "Mind Barrier"

msgid "STORY_EVENT@1064_1700@BODY_FOOTER"
msgstr "While contemplating that the Gildercoil was not to be found with either of the present {GLOBAL.GodirLoreConcept.Hyperlink}, you are approached by a suspiciously familiar figure - {EventPlayer}!"

msgid "STORY_EVENT@1064_1700@BODY_HEADER"
msgstr "The fields of the Crimson Caldera have been drenched with the blood of your adversaries."

msgid "STORY_EVENT@1064_1700@BODY_LORE"
msgstr "You have demonstrated valor and skill as a general on the field of battle and broken the curse of never-ending war in this realm. Whether the Princes of {GLOBAL.ObbadothLoreConcept.Hyperlink} will tolerate your foothold on their demonic world remains to be seen. For now there is peaceful silence."

msgid "STORY_EVENT@1064_1700@BUTTON_0"
msgstr "Let {EventPlayer.FirstName} speak."

msgid "STORY_EVENT@1064_1700@TITLE"
msgstr "The Bounty of the Crimson Caldera"

msgid "STORY_EVENT@1064_1704@BODY_FOOTER"
msgstr "The Gildercoil is not to be found with {EventPlayer}. You cast <<P:EventPlayer>> into the {GLOBAL.AstralVoidLoreConcept.Hyperlink} as a testament to what becomes of your foes."

msgid "STORY_EVENT@1064_1704@BODY_HEADER"
msgstr "Armor was shattered, strongholds breached, and {EventPlayer} lies defeated at your feet."

msgid "STORY_EVENT@1064_1704@BODY_LORE"
msgstr "\"We all came to the Crimson Caldera to claim the Gildercoil for ourselves. The whispers of the realm... promise it as a reward to the last who lives. A demon I once seduced called out the name Perumplex, but I have yet to hear its meaning.\""

msgid "STORY_EVENT@1064_1704@BUTTON_0"
msgstr "We must keep searching."

msgid "STORY_EVENT@1064_1704@TITLE"
msgstr "The Fall of {EventPlayer}"

msgid "STORY_EVENT@1064_1705@BODY_FOOTER"
msgstr "The Gildercoil is not to be found with {EventPlayer}. You cast <<P:EventPlayer>> into the {GLOBAL.AstralVoidLoreConcept.Hyperlink} as a testament to what becomes of your foes."

msgid "STORY_EVENT@1064_1705@BODY_HEADER"
msgstr "Armor was shattered, strongholds breached, and {EventPlayer} lies defeated at your feet."

msgid "STORY_EVENT@1064_1705@BODY_LORE"
msgstr "\"In the Crimson Caldera, the Gildercoil awaits as a coveted prize—or so the whispers from beyond promise. A king my {EventRace} once feasted on cried the name Liztia, yet it led to nothing further.\""

msgid "STORY_EVENT@1064_1705@BUTTON_0"
msgstr "We must keep searching."

msgid "STORY_EVENT@1064_1705@TITLE"
msgstr "The Fall of {EventPlayer}"

msgid "STORY_EVENT@1064_1706@BODY_FOOTER"
msgstr "The Gildercoil is not to be found with {EventPlayer}. {EventPlayer} flees through a hell rift opening up right below, before you can cast him into the {GLOBAL.AstralVoidLoreConcept.Hyperlink}."

msgid "STORY_EVENT@1064_1706@BODY_HEADER"
msgstr "Armor was shattered, strongholds breached, and {EventPlayer} lies defeated at your feet."

msgid "STORY_EVENT@1064_1706@BODY_LORE"
msgstr "\"Cursed be the name of Gontro, lowest and most despicable of all the Demonic Princes. He shaped this arena of eternal battle, luring in victims to fight over it to the death. The Gildercoil... I will have it... another day.\""

msgid "STORY_EVENT@1064_1706@BUTTON_0"
msgstr "We must keep searching."

msgid "STORY_EVENT@1064_1706@TITLE"
msgstr "The Fall of {EventPlayer}"

msgid "STORY_EVENT@1064_1708@BODY_FOOTER"
msgstr "The Gildercoil is not to be found with {EventPlayer}. You cast <<P:EventPlayer>> into the {GLOBAL.AstralVoidLoreConcept.Hyperlink} as a testament to what becomes of your foes."

msgid "STORY_EVENT@1064_1708@BODY_HEADER"
msgstr "Armor was shattered, strongholds breached, and {EventPlayer} lies defeated at your feet."

msgid "STORY_EVENT@1064_1708@BODY_LORE"
msgstr "\"Alas, my strength was not enough! Who will now enact vengeance on Zhitur, traitor and thief of the Gildercoil? Who will reclaim the artifact in the name of the {GLOBAL.ArchonsLoreConcept.Hyperlink} and their one true faith?\""

msgid "STORY_EVENT@1064_1708@BUTTON_0"
msgstr "We must keep searching."

msgid "STORY_EVENT@1064_1708@TITLE"
msgstr "The Fall of {EventPlayer}"

msgid "STORY_EVENT@1064_1711@BODY_FOOTER"
msgstr "The Gildercoil is not to be found with {EventPlayer}. A hell rift opens up below <<p:EventPlayer>> into which {EventPlayer.FirstName} is dragged by claws of pure shadow."

msgid "STORY_EVENT@1064_1711@BODY_HEADER"
msgstr "Armor was shattered, strongholds breached, and {EventPlayer} lies defeated at your feet."

msgid "STORY_EVENT@1064_1711@BODY_LORE"
msgstr "\"Oh {PlayerLeader}, why have you no mercy with a poor soul in need? My hour of doom draws near... I will pay for these words, but Atyngwe is who you must seek.\""

msgid "STORY_EVENT@1064_1711@BUTTON_0"
msgstr "We must keep searching."

msgid "STORY_EVENT@1064_1711@TITLE"
msgstr "The Fall of {EventPlayer}"

msgid "STORY_EVENT@1064_1720@BODY_FOOTER"
msgstr "\"You have earned the bounty of the Crimson Caldera, {PlayerLeader}. The Gildercoil gave me what I desired, and I have no regrets about signing over the item of eternal [hyperlink,GLOBAL.ArchonsLoreConcept]Archon[/hyperlink] wrath to your name.\""

msgid "STORY_EVENT@1064_1720@BODY_HEADER"
msgstr "\"Many have come and died in this arena of my personal disport. They all sought power and found ironic death—except you.\""

msgid "STORY_EVENT@1064_1720@BODY_LORE"
msgstr "{EventPlayer.FirstName} makes a gesture, as if putting down a mask, briefly revealing a horned, infernal visage. \"I have many names. Atyngwe, Liztia, Perumplex, Zhitur, Gontro... people get creative when it comes to the Demonic Prince of Deceit.\""

msgid "STORY_EVENT@1064_1720@BUTTON_0"
msgstr "Take the Gildercoil to complete your victory."

msgid "STORY_EVENT@1064_1720@TITLE"
msgstr "Finding the Gildercoil"

msgid "STORY_EVENT@1064_1725@BODY_FOOTER"
msgstr "While contemplating that the Gildercoil was not to be found with either of the present {GLOBAL.GodirLoreConcept.Hyperlink}, you are approached by a suspiciously familiar figure - {EventPlayer}!"

msgid "STORY_EVENT@1064_1725@BODY_HEADER"
msgstr "The fields of the Crimson Caldera have been drenched with the blood of your adversaries."

msgid "STORY_EVENT@1064_1725@BODY_LORE"
msgstr "You have demonstrated valor and skill as a general on the field of battle and broken the curse of never-ending war in this realm. Whether the Princes of {GLOBAL.ObbadothLoreConcept.Hyperlink} will tolerate your foothold on their demonic world remains to be seen. For now there is peaceful silence."

msgid "STORY_EVENT@1064_1725@BUTTON_0"
msgstr "Let {EventPlayer.FirstName} speak."

msgid "STORY_EVENT@1064_1725@TITLE"
msgstr "The Bounty of the Crimson Caldera"

msgid "STORY_EVENT@1064_1733@BODY_FOOTER"
msgstr "You have emerged from this conflict as a hero and savior of your people. Carried by their elation, you feel your spirits being lifted high, beyond the horizon and toward the {GLOBAL.AstralSeaLoreConcept.Hyperlink}."

msgid "STORY_EVENT@1064_1733@BODY_HEADER"
msgstr "\"Victory!\" is what echoes in the streets of {EventCity}, \"Victory!\" is what's engraved in the hearts of the {EventRace} for {EventEnemy}, {GLOBAL.GodirLoreConcept.Hyperlink} of Fire, has been defeated."

msgid "STORY_EVENT@1064_1733@BODY_HEADER@NO_CITY"
msgstr "\"Victory!\" is what echoes through the Valley of Wonders, \"Victory!\" is what's engraved in the hearts of the {EventRace} for {EventEnemy}, {GLOBAL.GodirLoreConcept.Hyperlink} of Fire, has been defeated."

msgid "STORY_EVENT@1064_1733@BODY_LORE"
msgstr "Smoke still lingers over the proud cities of the {EventEnemyRace}, while you reflect on your own accomplishments. Was it truly a [hyperlink,GLOBAL.AscendedChampLoreConcept]Mortal Hero[/hyperlink] that took down the {GLOBAL.WizardKingLoreConcept.Hyperlink} {EventEnemy.FirstName}? Or had your journey of knowledge and power already altered your destiny?"

msgid "STORY_EVENT@1064_1733@BUTTON_0"
msgstr "Let go of Athla to conclude your ascension."

msgid "STORY_EVENT@1064_1733@TITLE"
msgstr "The Fall of {EventEnemy}"

msgid "STORY_EVENT@1064_1736@BODY_FOOTER"
msgstr "Elya the Maer joins you as you leave for Magehaven, victorious."

msgid "STORY_EVENT@1064_1736@BODY_HEADER"
msgstr "You have cast the Siren Goddess into the void and claimed the Enchanted Archipelago from her drowning embrace!"

msgid "STORY_EVENT@1064_1736@BODY_LORE"
msgstr "From your capital, the mythical Maer emerges once more. \"I thank you, {PlayerLeader.TitleName}, for hearing my song and freeing the realm. I fear I have naught to give as a reward for a Godir... but if you allow me to join you on your travels I may share what I have learned as Nimue's prisoner.\""

msgid "STORY_EVENT@1064_1736@BODY_LORE@ELYA_NOT_FREED"
msgstr "From her hidden prison, a mythical Maer emerges, floating on unseen currents. \"I thank you, {PlayerLeader.TitleName}, for hearing my song and freeing the realm. My name is Elya. I fear I have naught to give as a reward for a Godir... but if you allow me to join you on your travels I may share what I have learned as Nimue's prisoner.\""

msgid "STORY_EVENT@1064_1736@BUTTON_0"
msgstr "Another realm liberated by the great {PlayerLeader.TitleName}!"

msgid "STORY_EVENT@1064_1736@TITLE"
msgstr "The Enchanted Archipelago: Victory"

msgid "STORY_EVENT@1064_1795@BODY_FOOTER"
msgstr "{EventPlayer.FirstName} crushes the figurine with <<o:EventPlayer>> left fist. \"Some sacrifices are worth making.\""

msgid "STORY_EVENT@1064_1795@BODY_HEADER"
msgstr "\"The {GLOBAL.ArchonsLoreConcept.Hyperlink} left a powerful warden to watch over their forbidden world.\" {EventPlayer} takes out a jeweled figurine and puts it on a pedestal."

msgid "STORY_EVENT@1064_1795@BODY_LORE"
msgstr "\"{TargetPlayer} is the first of the {GLOBAL.GodirLoreConcept.Hyperlink} and a loyal friend of the Archons. <<Cp:TargetPlayer>> could have been a god. Instead <<p:TargetPlayer>> became a mere watchman, waiting for a foe to strike <<P:TargetPlayer>> down.\""

msgid "STORY_EVENT@1064_1795@BUTTON_0"
msgstr "Discuss the battle plan."

msgid "STORY_EVENT@1064_1795@TITLE"
msgstr "The Battle for Grexolis"

msgid "STORY_EVENT@1064_1796@BODY_FOOTER"
msgstr "\"Nothing can withstand our combined magical force. Together, we will cast a spell that shakes the foundations of {GLOBAL.GrexolisLoreConcept.Hyperlink}.\""

msgid "STORY_EVENT@1064_1796@BODY_HEADER"
msgstr "\"Enough talk. Destiny does not wait.\" {EventPlayer} ignites the shards of the broken figurine until they incinerate."

msgid "STORY_EVENT@1064_1796@BODY_LORE"
msgstr "\"It does not matter who or what stands in the way of our victory. We are {GLOBAL.GodirLoreConcept.Hyperlink}. We are {GLOBAL.ShadraiFactionLoreConcept.Hyperlink}! Gone are the cursed times when we had to trust in the schemes of lowly mortals to achieve our goals.\""

msgid "STORY_EVENT@1064_1796@BUTTON_0"
msgstr "Perform <<gu:ritual of the pyre^N,EventPlayer.FirstName>>."

msgid "STORY_EVENT@1064_1796@BUTTON_1"
msgstr "Perform <<gu:ritual of the drowned^N,Nimue.FirstName>>."

msgid "STORY_EVENT@1064_1796@BUTTON_2"
msgstr "Perform <<gu:ritual of shattered earth^N,Ydgaard.FirstName>>."

msgid "STORY_EVENT@1064_1796@BUTTON_3"
msgstr "Perform <<gu:ritual of the mirror curse^N,Arachna.FirstName>>."

msgid "STORY_EVENT@1064_1796@TITLE"
msgstr "Shad'rai Magic"

msgid "STORY_EVENT@1064_1797@BODY_FOOTER"
msgstr "\"You cannot fathom the evil which I guard. It is not the warden you should fear, but the prisoners.\""

msgid "STORY_EVENT@1064_1797@BODY_HEADER"
msgstr "A harsh voice, which seems to resonate from the depths of the Astral Void, commands you to leave {GLOBAL.GrexolisLoreConcept.Hyperlink}: \"Flee, you fools!\""

msgid "STORY_EVENT@1064_1797@BODY_LORE"
msgstr "{EventPlayer} comes forward, stern and immovable like a lone rock within the tide. \"You have come to a forbidden world. Leave now and you may live. Stay and you will meet your doom.\""

msgid "STORY_EVENT@1064_1797@BUTTON_0"
msgstr "Heed your allies. Empty Archon lies won't scare away the Shad'rai."

msgid "STORY_EVENT@1064_1797@TITLE"
msgstr "The First Godir"

msgid "STORY_EVENT@1064_1798@BODY_FOOTER"
msgstr "The {GLOBAL.CovenantFactionLoreConcept.Hyperlink} have followed the {GLOBAL.ShadraiFactionLoreConcept.Hyperlink} to {GLOBAL.GrexolisLoreConcept.Hyperlink}. They will do anything to foil your plans."

msgid "STORY_EVENT@1064_1798@BODY_HEADER"
msgstr "From the fog of war, {Meandor}, {Sundren}, and {Fangir} emerge."

msgid "STORY_EVENT@1064_1798@BODY_LORE"
msgstr "\"It seems you forgot to invite us to your mad attempt at unleashing cosmic disaster,\" {Meandor.FirstName} says coldly.[br/][br/]\"First you brought conflict to innocent worlds,\" {Sundren.FirstName} continues, \"and now... this.\" {Fangir.FirstName} nods silently. <<Cp:Fangir>> does not fancy frivolous banter."

msgid "STORY_EVENT@1064_1798@BUTTON_0"
msgstr "They are trapped in past conflicts. But the victor rewrites history."

msgid "STORY_EVENT@1064_1798@TITLE"
msgstr "The Covenant"

msgid "STORY_EVENT@1064_1860@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} with you."

msgid "STORY_EVENT@1064_1860@BODY_HEADER"
msgstr "You meet {EventHouseLord}, who parted ways with the {EventRace} loyal to <<P:EventHouseLord>> as your tribe entered the {GLOBAL.ValleyofWondersLoreConcept.Hyperlink}."

msgid "STORY_EVENT@1064_1860@BODY_LORE"
msgstr "\"So we speak again, {PlayerLeader},\" {EventHouseLord} says with a stern voice. \"Remember, we of {EventHouse} seek no quarrel. It was magic that caused the loss of our homeland, magic that killed the elder of our tribe. When you took up the elder's {GLOBAL.TomeLoreConcept.Hyperlink} you asked for doom. We keep our distance. Evading all magic will keep us safe.\""

msgid "STORY_EVENT@1064_1860@BUTTON_0"
msgstr "\"Let us formally begin a diplomatic relationship.\""

msgid "STORY_EVENT@1064_1860@BUTTON_2"
msgstr "\"We shall see what this means for the future of the {EventRace}. For now, we part.\""

msgid "STORY_EVENT@1064_1860@TITLE"
msgstr "Meeting the Separatists"

msgid "STORY_EVENT@1064_1863@BODY_FOOTER"
msgstr "The ruins would make for a formidable location to found a {GLOBAL.CityConcept.Hyperlink} and let the burdened past make way for a new future."

msgid "STORY_EVENT@1064_1863@BODY_HEADER"
msgstr "Within the depths of the valley, your {EventStackLeader} comes across a large area of overgrown ruins."

msgid "STORY_EVENT@1064_1863@BODY_HEADER@HERO"
msgstr "Within the depths of the valley, your hero {EventStackLeader} comes across a large area of overgrown ruins."

msgid "STORY_EVENT@1064_1863@BODY_HEADER@LORD"
msgstr "Within the depths of the valley, you come across a large area of overgrown ruins."

msgid "STORY_EVENT@1064_1863@BODY_LORE"
msgstr "What has now largely been reclaimed by nature must have once been the thriving city of a great civilization. However, a lingering force of bitterness dwells beneath the peaceful surface. You can sense there are [hyperlink,GLOBAL.SoulsLoreConcept]spirits[/hyperlink] which still begrudge the ancient woe that happened here."

msgid "STORY_EVENT@1064_1863@BUTTON_0"
msgstr "\"I will consider this.\""

msgid "STORY_EVENT@1064_1863@BUTTON_2"
msgstr "\"These old spirits give me a prime opportunity to study [knowledge/] the past.\""

msgid "STORY_EVENT@1064_1863@BUTTON_3"
msgstr "\"Past atrocities are the pawns that sow what I shall reap [souls/]...\""

msgid "STORY_EVENT@1064_1863@BUTTON_4"
msgstr "\"These people had a strong link to the spirits of nature. I shall call forth their guardian.\""

msgid "STORY_EVENT@1064_1863@TITLE"
msgstr "Remnants of a Distant Past"

msgid "STORY_EVENT@1064_1868@BODY_FOOTER"
msgstr "\"Your {EventRace} may be of use to raise the monuments of my glory after all. Kneel down and save them. Now!\""

msgid "STORY_EVENT@1064_1868@BODY_HEADER"
msgstr "Columns of smoke rise above the {GLOBAL.ValleyofWondersLoreConcept.Hyperlink} and {EventPlayer.Name} is taunting you to surrender."

msgid "STORY_EVENT@1064_1868@BODY_LORE"
msgstr "\"There is no victory against the raging storm, {PlayerLeader}. The great empires of {GLOBAL.AthlaLoreConcept.Hyperlink} could not stop our mere servants, the Shadowborn. Now they crumble before the full might of the {GLOBAL.ShadraiFactionLoreConcept.Hyperlink}.\""

msgid "STORY_EVENT@1064_1868@BUTTON_0"
msgstr "\"We will never surrender to an invading {EventPlayer.Title}!\""

msgid "STORY_EVENT@1064_1868@TITLE"
msgstr "<<ge:Claim^n,EventPlayer.FirstName>>"

msgid "STORY_EVENT@1064_1875@BODY_FOOTER"
msgstr "\"You are not alone in this, {PlayerLeader}. The creatures of the Valley are joining our cause. They will answer your call...\""

msgid "STORY_EVENT@1064_1875@BODY_HEADER"
msgstr "\"Well spoken, {PlayerLeader}!\" {AllyPlayer} shouts with a fierce glimmer in <<o:AllyPlayer>> eyes."

msgid "STORY_EVENT@1064_1875@BODY_LORE"
msgstr "\"The people of {GLOBAL.AthlaLoreConcept.Hyperlink} are resourceful. Greater forces than this have failed to claim our world before. {EventPlayer.FirstName} would know this were <<o:EventPlayer>> immense ego not shrouding <<o:EventPlayer>> memory.\""

msgid "STORY_EVENT@1064_1875@BUTTON_0"
msgstr "Invoke the wardens of the forest."

msgid "STORY_EVENT@1064_1875@BUTTON_4"
msgstr "Let your voice echo through the mountains about."

msgid "STORY_EVENT@1064_1875@BUTTON_5"
msgstr "Call to the ancient spirits, keepers of the ages past."

msgid "STORY_EVENT@1064_1875@TITLE"
msgstr "<<ge:Retaliation^n,AllyPlayer.FirstName>>"

msgid "STORY_EVENT@1064_1896@BODY_FOOTER"
msgstr "\"I am immortal. If I fall, I return. Your life however,... it ends.\""

msgid "STORY_EVENT@1064_1896@BODY_HEADER"
msgstr "A calm settles on the battlefield near {EventCity}. Or so it seemed, for {EventPlayer} does not tolerate silence."

msgid "STORY_EVENT@1064_1896@BODY_LORE"
msgstr "\"Any victory you could achieve today will be meaningless, {PlayerLeader}. {GLOBAL.AthlaLoreConcept.Hyperlink} is but a pawn in this game of power. We came to punish the infidels, reward our loyal servants. In the meantime the plans of the {GLOBAL.ShadraiFactionLoreConcept.Hyperlink} are coming to fruition, beyond your reach or comprehension.\""

msgid "STORY_EVENT@1064_1896@BUTTON_0"
msgstr "\"Then let us end this, one way or the other!\""

msgid "STORY_EVENT@1064_1896@TITLE"
msgstr "<<ge:Fury^n,EventPlayer.FirstName>>"

msgid "STORY_EVENT@1064_1897@BODY_FOOTER"
msgstr "\"The Covenant are sending you a gift from {GLOBAL.MagehavenLoreConcept.Hyperlink}, {PlayerLeader}. You will bring down {EventPlayer.FirstName}, end <<o:EventPlayer>> onslaught!\""

msgid "STORY_EVENT@1064_1897@BODY_HEADER"
msgstr "\"Don't listen to those lies, {PlayerLeader}.\" {AllyPlayer.FirstName} raises <<o:AllyPlayer>> {EventItem}. \"Fighting for the ones you love is never in vain!\""

msgid "STORY_EVENT@1064_1897@BODY_LORE"
msgstr "\"{EventPlayer.FirstName} may claim that the {GLOBAL.ShadraiFactionLoreConcept.Hyperlink} are the undisputed Rulers beyond {GLOBAL.AthlaLoreConcept.Hyperlink}, but they are not. In {GLOBAL.MagehavenLoreConcept.Hyperlink}, they are only one faction among many. We of the {GLOBAL.CovenantFactionLoreConcept.Hyperlink} condemn their actions. And we confront them, where we can.\""

msgid "STORY_EVENT@1064_1897@BUTTON_0"
msgstr "Your trust in my abilities will not be misplaced."

msgid "STORY_EVENT@1064_1897@TITLE"
msgstr "<<ge:Retaliation^n,AllyPlayer.FirstName>>"

msgid "STORY_EVENT@1064_1898@BODY_FOOTER"
msgstr "\"You are making a grave mistake, {PlayerLeader}. In the end, the Shad'rai will be the only winners in this needless war.\""

msgid "STORY_EVENT@1064_1898@BODY_HEADER"
msgstr "{EventPlayer} looks at you with contempt: \"So it has come to this, and the refugees in need of shelter have become the invaders.\""

msgid "STORY_EVENT@1064_1898@BODY_LORE"
msgstr "\"History keeps repeating itself. Betrayal and aggressive migration have challenged my people in each of the ages past. Yet we persist, and will push back your {EventRace} now that we must.\""

msgid "STORY_EVENT@1064_1898@BUTTON_0"
msgstr "\"I will break the cycle of ages. We {EventRace} will claim this Valley of Wonders—and keep it.\""

msgid "STORY_EVENT@1064_1898@BUTTON_5"
msgstr "\"I write my own legend, and that has your head mounted on my throne room wall. [evilact/]\""

msgid "STORY_EVENT@1064_1898@TITLE"
msgstr "The War with {EventPlayer}"

msgid "STORY_EVENT@1064_1899@BODY_FOOTER"
msgstr "Before you can act or move, {EventPlayer.FirstName} vanishes in a blue swirl of magic, escaping to the Astral Sea."

msgid "STORY_EVENT@1064_1899@BODY_HEADER"
msgstr "The forces of {EventPlayer} have fallen on the field of battle or scattered into the woods. {EventPlayer.FirstName} <<r:EventPlayer>> stands alone."

msgid "STORY_EVENT@1064_1899@BODY_LORE"
msgstr "\"Stay back, {PlayerLeader}, or I will plunge your soul into the Astral Void!\" <<Cge:Appearance^n,EventPlayer.FirstName>> has changed. <<Cp:EventPlayer>> looks pale and ferocious, grim hatred burning in <<o:EventPlayer>> eyes. It makes you recall the myths of Dark Elves preying on the unwary in times before the old Commonwealth came to be."

msgid "STORY_EVENT@1064_1899@BUTTON_0"
msgstr "\"Flee in shame, {EventPlayer}. The glory of this victory [influence/] shall be mine regardless.\""

msgid "STORY_EVENT@1064_1899@TITLE"
msgstr "Vanquishing {EventPlayer}"

msgid "STORY_EVENT@1064_1900@BODY_FOOTER"
msgstr "{AllyPlayer.FirstName} turns to you: \"The Valley of Wonders is yours to protect now, {PlayerLeader}!\" Then she vanishes in a swirl of magic, escaping to the Astral Sea."

msgid "STORY_EVENT@1064_1900@BODY_FOOTER@SUNDREN_NOT_BEFR"
msgstr "Before {EventPlayer.FirstName} can act or move, {AllyPlayer.FirstName} vanishes in a blue swirl of magic, escaping to the Astral Sea."

msgid "STORY_EVENT@1064_1900@BODY_HEADER"
msgstr "<<Co:AllyPlayer>> {AllyRace} forces have fallen or scattered and {AllyPlayer} stands alone against the tide of {EventPlayer}."

msgid "STORY_EVENT@1064_1900@BODY_LORE"
msgstr "\"Stay back, {EventPlayer.FirstName}, or I will plunge your soul into the Astral Void!\" <<Cge:Appearance^n,AllyPlayer.FirstName>> has changed. <<Cp:AllyPlayer>> looks pale and ferocious, grim hatred burning in <<o:AllyPlayer>> eyes. It makes you recall the myths of Dark Elves preying on the unwary in times before the old Commonwealth came to be."

msgid "STORY_EVENT@1064_1900@BUTTON_0"
msgstr "\"My people will succeed [unitprod/], where the {AllyRace} failed.\""

msgid "STORY_EVENT@1064_1900@BUTTON_5"
msgstr "\"All hail {PlayerLeader} [influence/], Athla's last hope.\""

msgid "STORY_EVENT@1064_1900@TITLE"
msgstr "The Fall of {AllyPlayer}"

msgid "STORY_EVENT@1064_1967@BODY_FOOTER"
msgstr "\"You will not journey anywhere, old man.\" {AllyPlayer.FirstName} comes forward, conjuring a shadow prison into which {EventPlayer.FirstName} is forced to enter. \"Only a fool would dismiss the secrets lingering within your ancient mind.\""

msgid "STORY_EVENT@1064_1967@BODY_HEADER"
msgstr "Even in <<o:EventPlayer>> darkest hour, {EventPlayer.FirstName} stands tall, a mountain within a raging storm."

msgid "STORY_EVENT@1064_1967@BODY_LORE"
msgstr "\"I have failed,\" <<p:EventPlayer>> says, <<o:EventPlayer>> eyes staring beyond the {GLOBAL.ShadraiFactionLoreConcept.Hyperlink} toward the {GLOBAL.AstralVoidLoreConcept.Hyperlink}. \"I long... for Emnora. Yet it cannot be. Perhaps it is time for the last journey of {EventPlayer}. The {GLOBAL.ArchonsLoreConcept.Hyperlink} will know.\""

msgid "STORY_EVENT@1064_1967@BUTTON_0"
msgstr "\"The glory [influence/] of vanquishing the first Godir is ours!\""

msgid "STORY_EVENT@1064_1967@TITLE"
msgstr "The Fall of {EventPlayer}"

msgid "STORY_EVENT@1064_1971@BODY_FOOTER"
msgstr "\"The fight is over,\" {AllyPlayer} responds with authority. \"We owe you no proof of our personal strength.\""

msgid "STORY_EVENT@1064_1971@BODY_HEADER"
msgstr "With <<o:EventPlayer>> armies vanquished on the field of battle, {EventPlayer.FirstName} is being cornered by the {GLOBAL.ShadraiFactionLoreConcept.Hyperlink} Godir."

msgid "STORY_EVENT@1064_1971@BODY_LORE"
msgstr "\"Come! Fight me, if you dare!\" <<g:roar^n,EventPlayer.FirstName>> shakes the earth underneath while <<p:EventPlayer>> raises <<o:EventPlayer>> {EventItem} to challenge <<o:EventPlayer>> enemies to direct combat. \"If I die, my spirit will join with Cantarra and bolster its strength before darkness falls.\""

msgid "STORY_EVENT@1064_1971@BUTTON_0"
msgstr "Seal {EventPlayer} in a cage of magic suppression."

msgid "STORY_EVENT@1064_1971@TITLE"
msgstr "The Fall of {EventPlayer}"

msgid "STORY_EVENT@1064_1974@BODY_FOOTER"
msgstr "Which spell of your Shad'rai allies do you choose to break the remaining opposition on {GLOBAL.GrexolisLoreConcept.Hyperlink}?"

msgid "STORY_EVENT@1064_1974@BODY_HEADER"
msgstr "A momentous achievement asks for momentous magic to follow."

msgid "STORY_EVENT@1064_1974@BODY_LORE"
msgstr "Empowered by their victory and the mana stored in the Wizard's Tower of the fallen enemy, the {GLOBAL.ShadraiFactionLoreConcept.Hyperlink} are ready to perform another ritual."

msgid "STORY_EVENT@1064_1974@BUTTON_0"
msgstr "Perform <<gu:ritual of the pyre^N,EventPlayer.FirstName>>."

msgid "STORY_EVENT@1064_1974@BUTTON_3"
msgstr "Perform <<gu:ritual of the drowned^N,Nimue.FirstName>>."

msgid "STORY_EVENT@1064_1974@BUTTON_4"
msgstr "Perform <<gu:ritual of shattered earth^N,Ydgaard.FirstName>>."

msgid "STORY_EVENT@1064_1974@BUTTON_5"
msgstr "Perform <<gu:ritual of the mirror curse^N,Arachna.FirstName>>."

msgid "STORY_EVENT@1064_1974@TITLE"
msgstr "Shad'rai Magic"

msgid "STORY_EVENT@1064_1976@BODY_FOOTER"
msgstr "{EventPlayer} has retreated with grave wounds into the Wizard's Tower of {AllyPlayer}. There <<p:EventPlayer>> will rest until enough of <<o:EventPlayer>> strength has been restored."

msgid "STORY_EVENT@1064_1976@BODY_HEADER"
msgstr "The battle for {GLOBAL.GrexolisLoreConcept.Hyperlink} rages relentlessly. The clashing armies of the {GLOBAL.CovenantFactionLoreConcept.Hyperlink}, {GLOBAL.ShadraiFactionLoreConcept.Hyperlink} and the warden of Grexolis can bring down even a {GLOBAL.GodirLoreConcept.Hyperlink}."

msgid "STORY_EVENT@1064_1976@BODY_LORE"
msgstr "\"Impossible!\" <<Cg:cry of dismay^n,EventPlayer.FirstName>> rends the air of Grexolis as <<p:EventPlayer>> is overwhelmed by the host of the enemy. \"I am the {EventPlayer.Title}. My might bows before none, nor will I fall... today.\""

msgid "STORY_EVENT@1064_1976@BUTTON_0"
msgstr "Where <<p:EventPlayer>> lost, my troops will claim victory! This is not over yet."

msgid "STORY_EVENT@1064_1976@TITLE"
msgstr "The Retreat of {EventPlayer}"

msgid "STORY_EVENT@1064_1987@BODY_FOOTER"
msgstr "\"Stop! Do not move just yet!\" {EventPlayer.FirstName} who, like the Covenant Godir, has been rendered a powerless spectator, raises <<o:EventPlayer>> voice."

msgid "STORY_EVENT@1064_1987@BODY_HEADER"
msgstr "{EventPlayer}, the {GLOBAL.CovenantFactionLoreConcept.Hyperlink} - neither of them could withstand the might of the Shad'rai. With {GLOBAL.GrexolisLoreConcept.Hyperlink} secured, {AllyPlayer} beckons you to take out the Gildercoil."

msgid "STORY_EVENT@1064_1987@BODY_LORE"
msgstr "\"It is time, {PlayerLeader.FirstName}. Use the power of the Gildercoil! Do what was forbidden!\" {AllyPlayer.FirstName} entices you with a lavish smile, as if <<p:AllyPlayer>> needed to grant you an excuse for a sin of cosmic scale. Evidently, even the {GLOBAL.ShadraiFactionLoreConcept.Hyperlink} are anxious about the moment to come."

msgid "STORY_EVENT@1064_1987@BUTTON_0"
msgstr "Listen to <<g:words^n,EventPlayer.FirstName>>."

msgid "STORY_EVENT@1064_1987@TITLE"
msgstr "The World Vault: Aftermath"

msgid "STORY_EVENT@1064_1988@BODY_FOOTER"
msgstr "{AllyPlayer.FirstName} steps forward, making a gesture as if <<p:AllyPlayer>> were introducing <<r:AllyPlayer>>. \"You are right, {EventPlayer.FirstName}. It is time {PlayerLeader} learned the truth...\""

msgid "STORY_EVENT@1064_1988@BODY_HEADER"
msgstr "\"You think you know well the consequences of opening the World Vault, {PlayerLeader},\" {EventPlayer.FirstName} begins, \"but look around at whose words you trusted on this journey to oblivion.\""

msgid "STORY_EVENT@1064_1988@BODY_LORE"
msgstr "{EventPlayer.FirstName} points his hand at all the present {GLOBAL.ShadraiFactionLoreConcept.Hyperlink}: \"A self-proclaimed god-pharaoh, burning whoever questions his ego. An obsessed siren, drowning her own children. A hoarder of wealth who sold his head and heart for power. And then this one...\" <<Cg:eyes^p,EventPlayer.FirstName>> rest on {AllyPlayer.FirstName}. \"You don't even know <<o:AllyPlayer>> true name.\""

msgid "STORY_EVENT@1064_1988@BUTTON_0"
msgstr "Wait for {AllyPlayer.FirstName} to finish."

msgid "STORY_EVENT@1064_1988@TITLE"
msgstr "<<g:Intervention^n,EventPlayer.FirstName>>"

msgid "STORY_EVENT@1064_1989@BODY_FOOTER"
msgstr "{EventHero.FirstName} turns to you. \"I'm sorry, but this is too important.\" Without warning, a summoned hand snatches the Gildercoil from you, putting it in <<g:hands^p,EventHero.FirstName>>."

msgid "STORY_EVENT@1064_1989@BODY_HEADER"
msgstr "\"{EventHero.FirstName}!\" The name is gasped by the present {GLOBAL.GodirLoreConcept.Hyperlink} as {AllyPlayer.FirstName} magically shifts her appearance, revealing <<r:AllyPlayer>> to be {EventHero}."

msgid "STORY_EVENT@1064_1989@BODY_LORE"
msgstr "\"As can be witnessed here,\" <<p:AllyPlayer>> says slowly, \"things are often not as they first seem. Releasing what was seen as harmful in ages past may be the solution to problems present. The {GLOBAL.ArchonsLoreConcept.Hyperlink} are losing their war, {EventPlayer.FirstName}. Slowly but steadily the shadows are creeping forward, unless... some unexpected guests were to appear.\" Now it is {EventPlayer.FirstName} whose voice reveals dismay: \"The Endailon! You must be beyond desperate.\""

msgid "STORY_EVENT@1064_1989@BUTTON_0"
msgstr "Watch {EventHero.FirstName} open the World Vault."

msgid "STORY_EVENT@1064_1989@TITLE"
msgstr "The revelation of {EventHero.FirstName}"

msgid "STORY_EVENT@1064_1990@BODY_FOOTER"
msgstr "{EventPlayer.FirstName} remains silent. It seems <<p:EventPlayer>> does not deem <<g:words^p,AllyPlayer.FirstName>> worthy of any reaction."

msgid "STORY_EVENT@1064_1990@BODY_HEADER"
msgstr "\"It need not be like this, {EventPlayer}.\" {AllyPlayer} speaks with a tender voice, looking <<P:EventPlayer>> straight in the eyes."

msgid "STORY_EVENT@1064_1990@BODY_LORE"
msgstr "\"We have much in common. Why fight amongst us {GLOBAL.GodirLoreConcept.Hyperlink} when the true enemy is breeding new darkness by the day? Would it not be wise to leave this post and join the {GLOBAL.ArchonsLoreConcept.Hyperlink} in their fight, while retaining peace with the {GLOBAL.ShadraiFactionLoreConcept.Hyperlink}, who could be valuable future allies?\""

msgid "STORY_EVENT@1064_1990@BUTTON_0"
msgstr "<<Cp:EventPlayer>> had <<o:EventPlayer>> chance for peaceful surrender."

msgid "STORY_EVENT@1064_1990@TITLE"
msgstr "Tempting the Untemptable"

msgid "STORY_EVENT@1064_276@BODY_FOOTER"
msgstr "How will you protect the citizens of {EventCity.Name} from the appetite of the roaming Undead?"

msgid "STORY_EVENT@1064_276@BODY_HEADER"
msgstr "One of your city guards from {EventCity.Name} has unsettling news to share."

msgid "STORY_EVENT@1064_276@BODY_LORE"
msgstr "\"These creatures are kept alive by foul magic alone!\" the head of the guard explains. \"Restless Undead, risen from a {EventSpawner.Name}! First, they horrified our local farmers, who found their cattle with their brains sucked out at dawn. Now, it seems that the Undead hunger for more.\""

msgid "STORY_EVENT@1064_276@BUTTON_0"
msgstr "Repel the Undead [mana/] with a warding spell."

msgid "STORY_EVENT@1064_276@BUTTON_1"
msgstr "Channel enough mana [mana/] into the {EventSpawner.Name} to trap the Undead there."

msgid "STORY_EVENT@1064_276@BUTTON_2"
msgstr "\"Let me seal the earth at the {EventSpawner.Name}. That will put them to rest.\""

msgid "STORY_EVENT@1064_276@BUTTON_3"
msgstr "\"These pathetic brain-eaters are no match for our defenses!\""

msgid "STORY_EVENT@1064_276@BUTTON_4"
msgstr "\"If it's brains they want, we have a few scholars [knowledge/] to spare... [evilact/]\""

msgid "STORY_EVENT@1064_276@BUTTON_5"
msgstr "\"By the will of Nature, I will make these corpses rot away. Now!\""

msgid "STORY_EVENT@1064_276@TITLE"
msgstr "Braingorgers"

msgid "STORY_EVENT@1064_293@BODY_FOOTER"
msgstr "How do you respond to the terrible threat of the {EventStackLeader.Name} they call the \"Horror of {GLOBAL.UrrathLoreConcept.Hyperlink}\" and its {EventSpawner.Name}?"

msgid "STORY_EVENT@1064_293@BODY_HEADER"
msgstr "Rumors of an occultist group near your city {EventCity.Name} have long spread fear amongst your population. Now that fear is given a new form."

msgid "STORY_EVENT@1064_293@BODY_LORE"
msgstr "\"Deliver your children to us!\" the hysterical voice of a cultist can be heard from beyond the city gate. \"Or we will invoke the Horror of {GLOBAL.UrrathLoreConcept.Hyperlink} to drag your souls to the {GLOBAL.AstralSeaLoreConcept.Hyperlink}!\" They gesture wildly to the {EventStackLeader.Name} in your domain."

msgid "STORY_EVENT@1064_293@BUTTON_0"
msgstr "Rally a mob [unitprod/] to drive the cultists away."

msgid "STORY_EVENT@1064_293@BUTTON_1"
msgstr "Rally the entire city [unitprod/] to root out the very {EventSpawner.Name}."

msgid "STORY_EVENT@1064_293@BUTTON_2"
msgstr "Ignore them. This \"Horror of Urrath\" sounds pathetic."

msgid "STORY_EVENT@1064_293@BUTTON_3"
msgstr "Actually deliver the children [population/]. That will be the end of it. [evilact/]"

msgid "STORY_EVENT@1064_293@BUTTON_4"
msgstr "Invoke this {EventStackLeader.Name} yourself."

msgid "STORY_EVENT@1064_293@TITLE"
msgstr "Dark Extortion"

msgid "STORY_EVENT@1064_368@BODY_FOOTER"
msgstr "Will you appease the {EventStackLeader.Name} with a sacrifice - or put an end to <<g:tradition^n,EventCity>>?"

msgid "STORY_EVENT@1064_368@BODY_HEADER"
msgstr "Your people of {EventCity.Name} share a special link with the {EventSpawner.Name}."

msgid "STORY_EVENT@1064_368@BODY_LORE"
msgstr "They worship the {EventStackLeader.Name} and its feathered kin, believing that a great bird supports the sun on its wings. However, the birds themselves mostly only care about the sacrificial offerings. They have grown more demanding over time, and now threaten to attack {EventCity.Name}."

msgid "STORY_EVENT@1064_368@BUTTON_0"
msgstr "\"I respect their beliefs [happiness/]. Let the livestock [food/] of {EventCity.Name} nurture the {EventStackLeader.Name}.\""

msgid "STORY_EVENT@1064_368@BUTTON_1"
msgstr "Bribe [gold/] their shamans to end this madness and repel all birds from the {EventSpawner.Name}."

msgid "STORY_EVENT@1064_368@BUTTON_2"
msgstr "The birds are no match for <<g:defenses^p,EventCity>>."

msgid "STORY_EVENT@1064_368@BUTTON_3"
msgstr "\"Their primitive beliefs offend the gods. Cleansing [mana/] the birds and their {EventSpawner.Name} is the right path.\""

msgid "STORY_EVENT@1064_368@BUTTON_4"
msgstr "Foster their special link to tame the {EventStackLeader.Name}."

msgid "STORY_EVENT@1064_368@TITLE"
msgstr "Birds of Pray"

msgid "STORY_EVENT@1064_407@BODY_FOOTER"
msgstr "\"Will you help, my {PlayerLeader.Title}, in seeking the {EventMaterial} needed to reforge the weapon of my forefathers?\""

msgid "STORY_EVENT@1064_407@BODY_HEADER"
msgstr "{EventHero} approaches you with solemn determination."

msgid "STORY_EVENT@1064_407@BODY_LORE"
msgstr "\"These are the fragments of the {EventItem},\" <<p:EventHero>> says, showing you a bundle of carefully wrapped weapon shards. \"Long ago, it inspired fear in the enemies of the {EventRace}. Its keepers have long searched for a way to imbue it with new life, but never have we found the mythical {EventMaterial} it is made of.\""

msgid "STORY_EVENT@1064_407@BUTTON_0"
msgstr "\"I shall aid you. A hero is only as good as <<o:EventHero>> weapon!\""

msgid "STORY_EVENT@1064_407@BUTTON_2"
msgstr "\"There is no time for idle quests like this...\""

msgid "STORY_EVENT@1064_407@TITLE"
msgstr "{EventItem} Reforged"

msgid "STORY_EVENT@1064_408@BODY_FOOTER"
msgstr "\"I am in your debt, my {PlayerLeader.Title}\" <<p:EventHero>> says. \"Any path you set out for me, I shall follow.\""

msgid "STORY_EVENT@1064_408@BODY_HEADER"
msgstr "With the {EventMaterial} {EventHero} retreats to <<o:EventHero>> forge. At nightfall <<p:EventHero>> returns to you, the {EventItem} in <<o:EventHero>> hands."

msgid "STORY_EVENT@1064_408@BODY_LORE"
msgstr "\"At last! Our fabled weapon will return to battle, and we {EventRace} will stand triumphant!\" {EventHero} shouts out in triumph, lifting the {EventItem} toward the sky. Then, after a while, <<p:EventHero>> relaxes <<o:EventHero>> posture and turns to you."

msgid "STORY_EVENT@1064_408@BUTTON_0"
msgstr "\"Hone your smithing [unitprod/] skills! In {EventCity} there are many men who need arms.\""

msgid "STORY_EVENT@1064_408@BUTTON_3"
msgstr "\"Carry the {EventItem} for the glory [happiness/] of the {EventRace}!\""

msgid "STORY_EVENT@1064_408@BUTTON_4"
msgstr "\"Magic artifacts are worthy of in-depth study. [knowledge/] Research and learn!\""

msgid "STORY_EVENT@1064_408@BUTTON_5"
msgstr "\"Train [xp/], {EventHero}. Become worthy of the {EventItem}.\""

msgid "STORY_EVENT@1064_408@TITLE"
msgstr "{EventItem} Reforged: Aftermath"

msgid "STORY_EVENT@1064_492@BODY_FOOTER"
msgstr "Will you promise to build more <<m:{GLOBAL.FarmConcept.Hyperlink}>> to still the \"healthy\" appetite of the {EventRace.Name}?"

msgid "STORY_EVENT@1064_492@BODY_HEADER"
msgstr "The {EventRace.Name} Council sends their chief deputy to meet you with a request."

msgid "STORY_EVENT@1064_492@BODY_LORE"
msgstr "\"For too long have we {EventRace.Name} suffered want,\" the deputy, a well-fed <<EventUnit{man/woman}>>, explains. \"It is clear now, my {PlayerLeader.TitleName}, that your cities are in need of more farmland, so we can enjoy a third breakfast like any civilized people should.\""

msgid "STORY_EVENT@1064_492@BUTTON_0"
msgstr "\"A good man must eat, that is for sure!\""

msgid "STORY_EVENT@1064_492@BUTTON_1"
msgstr "\"A second breakfast will have to suffice, for now.\""

msgid "STORY_EVENT@1064_492@BUTTON_2"
msgstr "\"This self-indulgent gluttony will make you {EventRace.Name} too soft [unitprod/] for war!\""

msgid "STORY_EVENT@1064_492@TITLE"
msgstr "A Fine Meal"

msgid "STORY_EVENT@1064_493@BODY_FOOTER"
msgstr "\"The people want to thank you with a gift. What shall the Council proclaim?\""

msgid "STORY_EVENT@1064_493@BODY_HEADER"
msgstr "The first sowing of the season has passed, and returned to you a very pleased {EventRace.Name} Council deputy."

msgid "STORY_EVENT@1064_493@BODY_LORE"
msgstr "\"O jolly day!\" the deputy starts his praise. \"No longer must we {EventRace.Name} be afraid of starving when we fancy our third breakfast! Your name is on everyone's lips, my {PlayerLeader.TitleName}. Always remember: full {EventRace.Name} are happy {EventRace.Name}.\""

msgid "STORY_EVENT@1064_493@BUTTON_0"
msgstr "\"That they shall nurture the crops [food/] they so eagerly asked for.\""

msgid "STORY_EVENT@1064_493@BUTTON_1"
msgstr "\"That they must not forget to bring offerings to the spirits [mana/] of the land.\""

msgid "STORY_EVENT@1064_493@BUTTON_3"
msgstr "\"That their firstborn shall serve the army of the {EventRace.Name} [unitprod/] in military service.\""

msgid "STORY_EVENT@1064_493@TITLE"
msgstr "A Fine Meal: Aftermath"

msgid "STORY_EVENT@1064_539@BODY_FOOTER"
msgstr "You are at war with {EventHouse.Name}."

msgid "STORY_EVENT@1064_539@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} greets you with hostility."

msgid "STORY_EVENT@1064_539@BODY_LORE"
msgstr "\"{EventHouse.Name} will fight for our freedom and stand against anyone who threatens our {GLOBAL.IndependentCityConcept.Hyperlink}, even when they are led by a {PlayerLeader.Title} like you. Don't think our shared racial heritage will curb our convictions.\""

msgid "STORY_EVENT@1064_539@BUTTON_0"
msgstr "Inspect the insolent {EventHouse.Name}."

msgid "STORY_EVENT@1064_539@BUTTON_2"
msgstr "\"So be it!\""

msgid "STORY_EVENT@1064_539@TITLE"
msgstr "Meeting Hostile {EventHouse.Name}"

msgid "STORY_EVENT@1064_540@BODY_FOOTER"
msgstr "You are at war with {EventHouse.Name}."

msgid "STORY_EVENT@1064_540@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} greets you with hostility."

msgid "STORY_EVENT@1064_540@BODY_LORE"
msgstr "\"We {EventHouseRace.Name} of {EventHouse.Name} will fight for our freedom and stand against anyone who threatens our {GLOBAL.IndependentCityConcept.Hyperlink}, even when they are led by a {PlayerLeader.Title} like you. The blood of invaders, thieves and spies will nourish the fields.\""

msgid "STORY_EVENT@1064_540@BUTTON_0"
msgstr "Inspect the insolent {EventHouse.Name}."

msgid "STORY_EVENT@1064_540@BUTTON_2"
msgstr "\"So be it!\""

msgid "STORY_EVENT@1064_540@TITLE"
msgstr "Meeting Hostile {EventHouse.Name}"

msgid "STORY_EVENT@1064_594@BODY_FOOTER"
msgstr "{EventHero.FirstName} makes an elaborate gesture, after which a map showing the major strongholds of the Crimson Caldera appears. \"This is where you must seek out all suspect Godir.\""

msgid "STORY_EVENT@1064_594@BODY_HEADER"
msgstr "\"The Gildercoil is not simply secreted somewhere in the Crimson Caldera,\" {EventHero.FirstName} begins to explain. \"It is safeguarded closely by its current owner.\""

msgid "STORY_EVENT@1064_594@BODY_LORE"
msgstr "\"The challenge is to find out by whom. All the present {GLOBAL.GodirLoreConcept.Hyperlink} are inherently suspect and must therefore be sought out. Just remember, they are all insane and will only tell the truth when forced to. Once you have found the first of them we shall talk again.\""

msgid "STORY_EVENT@1064_594@BUTTON_0"
msgstr "Take the map to begin your hunt."

msgid "STORY_EVENT@1064_594@BUTTON_1"
msgstr "The map is so primitive... Channel your arcane focus [mana/] to improve it."

msgid "STORY_EVENT@1064_594@BUTTON_2"
msgstr "Burn the map. Your people can smell battle [unitprod/] from afar!"

msgid "STORY_EVENT@1064_594@TITLE"
msgstr "Traces of the Gildercoil"

msgid "STORY_EVENT@1064_595@BODY_FOOTER"
msgstr "As {PlayerLeader.Title}, you may claim any of the treasures your scouts have brought back from their journeys."

msgid "STORY_EVENT@1064_595@BODY_HEADER"
msgstr "While you ponder your strategies for this war with many fronts, your scouts are returning now from the different regions of the Crimson Caldera."

msgid "STORY_EVENT@1064_595@BODY_LORE"
msgstr "They speak of demonic encounters, vicious monsters, and rampant war bands roaming the land, mad testaments to the Rulers long fallen who came to the Crimson Caldera in search of the Gildercoil's power."

msgid "STORY_EVENT@1064_595@BUTTON_0"
msgstr "Claim the {EventItem} [item/] they unearthed."

msgid "STORY_EVENT@1064_595@BUTTON_1"
msgstr "Take the coin [gold/] they looted on the many roads they trod."

msgid "STORY_EVENT@1064_595@BUTTON_2"
msgstr "Stock the arsenal of {EventCity} [unitprod/] with salvaged weapons from the battlefields of the Crimson Caldera."

msgid "STORY_EVENT@1064_595@TITLE"
msgstr "Traces of the Gildercoil: Aftermath"

msgid "STORY_EVENT@1064_64@BODY_FOOTER"
msgstr "Will you rescue the mage and banish the magical creatures at its location before it's too late?"

msgid "STORY_EVENT@1064_64@BODY_HEADER"
msgstr "While connecting with the cosmos, you notice a disturbance in the {GLOBAL.AstralFlowsLoreConcept.Hyperlink}."

msgid "STORY_EVENT@1064_64@BODY_LORE"
msgstr "An overly curious mage has tampered with the mana currents. <<Cp:EventUnit>> accidentally opened a portal, drawing in magical creatures from the {GLOBAL.AstralSeaLoreConcept.Hyperlink}. Now, <<p:EventUnit>> is hiding behind a barrier while the summoned monsters threaten the entire area."

msgid "STORY_EVENT@1064_64@BUTTON_0"
msgstr "\"Of course I will help out a fellow arcanist in need.\""

msgid "STORY_EVENT@1064_64@BUTTON_1"
msgstr "\"Mages are resourceful. <<Cp:EventUnit>> will surely be fine...\""

msgid "STORY_EVENT@1064_64@BUTTON_2"
msgstr "\"These creatures are lost. They need to be nurtured [mana/], not slain!\" [astralcrisis/]"

msgid "STORY_EVENT@1064_64@TITLE"
msgstr "Planar Problems"

msgid "STORY_EVENT@1064_65@BODY_FOOTER"
msgstr "In which direction do you steer the {EventUnit.Name} of the {EventRace.Name} before <<o:EventUnit>> magical experiments can cause more damage?"

msgid "STORY_EVENT@1064_65@BODY_HEADER"
msgstr "With the summoned monsters banished again, the {EventUnit.Name} drops <<o:EventUnit>> magical barrier."

msgid "STORY_EVENT@1064_65@BODY_LORE"
msgstr "\"Thank you!\" <<p:EventUnit>> comes forward, enthusiastically waving <<o:EventUnit>> wand. \"My field research has never yielded more valuable results! I have another interesting hypothesis that needs confirmation. I don't suppose you would mind, if I...\""

msgid "STORY_EVENT@1064_65@BUTTON_0"
msgstr "<<Co:EventUnit>> destructive tampering makes <<P:EventUnit>> a suitable addition [unit/] to your army."

msgid "STORY_EVENT@1064_65@BUTTON_1"
msgstr "Invite the mage to share <<o:EventUnit>> findings [knowledge/] at your court."

msgid "STORY_EVENT@1064_65@BUTTON_3"
msgstr "Let <<P:EventUnit>> continue. Arcane powers [mana/] need complete freedom of the mind to develop."

msgid "STORY_EVENT@1064_65@TITLE"
msgstr "Planar Problems: Aftermath"

msgid "STORY_EVENT@1064_71@BODY_FOOTER"
msgstr "Will you shield the miners at {EventStructure} from the attacks of the {EventStackLeader.Name} before it's too late?"

msgid "STORY_EVENT@1064_71@BODY_HEADER"
msgstr "Bonding with the earth and its riches, you witness an underground tragedy."

msgid "STORY_EVENT@1064_71@BODY_LORE"
msgstr "The {EventRace.Name} have mined too far and too greedily into the depths of the earth. Their drilling stirred up a {EventStackLeader.Name}, along with a horde of underground predators. Now, these menaces are stalking the {EventStructure.Name}, killing the workers of the {EventRace.Name} one by one."

msgid "STORY_EVENT@1064_71@BUTTON_0"
msgstr "\"Their treasure - and the miners - shall be rescued!\""

msgid "STORY_EVENT@1064_71@BUTTON_1"
msgstr "\"Their fate holds no interest for us.\""

msgid "STORY_EVENT@1064_71@BUTTON_2"
msgstr "\"They were sinful to be so greedy. [materiumcrisis/] We should learn [knowledge/] from their punishment.\""

msgid "STORY_EVENT@1064_71@TITLE"
msgstr "Digging too Deep"

msgid "STORY_EVENT@1064_72@BODY_FOOTER"
msgstr "The master prospector wants to thank you with a gift from their guild chest."

msgid "STORY_EVENT@1064_72@BODY_HEADER"
msgstr "Now that the monsters at the {EventStructure.Name} have been slain, the surviving miners come out of hiding."

msgid "STORY_EVENT@1064_72@BODY_LORE"
msgstr "\"We owe our lives to you, foreigner,\" their master prospector begins to say. \"Take a look at our treasury. Name any item and it shall be yours. We will leave this perilous place and return to our homes.\""

msgid "STORY_EVENT@1064_72@BUTTON_0"
msgstr "Take a sizeable bag of [gold/] coins."

msgid "STORY_EVENT@1064_72@BUTTON_1"
msgstr "Take a jeweled accessory [item/], the {EventItem.Name}."

msgid "STORY_EVENT@1064_72@BUTTON_3"
msgstr "Ask the miners to visit your [structureprod/] craft guilds at {EventCity.Name} instead."

msgid "STORY_EVENT@1064_72@TITLE"
msgstr "Digging too Deep: Aftermath"

msgid "STORY_EVENT@1064_785@BODY_FOOTER"
msgstr "<<Cp:EventUnit>> is asking for this year's harvest to nurture the creatures of the wild. Will you make that sacrifice?"

msgid "STORY_EVENT@1064_785@BODY_HEADER"
msgstr "From the tangled depths of the wilds near your city {EventCity.Name}, the cackling song of a {EventUnit.Name} entices you."

msgid "STORY_EVENT@1064_785@BODY_LORE"
msgstr "\"Come, bless the land with apples![br/]Let the harvest rest![br/]The spoils for all to grapple[br/]feed bear, bird, fey, and nest!\""

msgid "STORY_EVENT@1064_785@BUTTON_0"
msgstr "Let {EventCity.Name} offer its harvest [food/] to the land. [natureboon/]"

msgid "STORY_EVENT@1064_785@BUTTON_1"
msgstr "Use some of the harvest [food/] instead to curry favor with the {EventUnit.Name}. [unit/]"

msgid "STORY_EVENT@1064_785@BUTTON_2"
msgstr "Ignore the <<g:song^n,EventUnit>>. [naturecrisis/]"

msgid "STORY_EVENT@1064_785@TITLE"
msgstr "Rite of Autumn"

msgid "STORY_EVENT@1064_856@BODY_FOOTER"
msgstr "To brew a love potion strong enough to enchant {EventPlayer} you must obtain {EventMaterial1} and {EventMaterial2}."

msgid "STORY_EVENT@1064_856@BODY_HEADER"
msgstr "\"One whose heart is cold will be defenseless when it is suddenly ignited.\" {EventHero} shows an empty flask."

msgid "STORY_EVENT@1064_856@BODY_LORE"
msgstr "\"The weakness of {EventPlayer} is <<o:EventPlayer>> own perfidious game, in which <<p:EventPlayer>> feeds on the love of <<o:EventPlayer>> victims for personal pleasure. Turn the tables and <<p:EventPlayer>> will be yours.\""

msgid "STORY_EVENT@1064_856@BUTTON_0"
msgstr "{EventPlayer} will abide by your wishes in no time."

msgid "STORY_EVENT@1064_856@TITLE"
msgstr "Love and Let Die"

msgid "STORY_EVENT@1064_857@BODY_FOOTER"
msgstr "It is clear that {EventPlayer} is desperately in love with you. What will you do with this fool?"

msgid "STORY_EVENT@1064_857@BODY_HEADER"
msgstr "You brew a potion with the materials you collected. Soon after, the result presents <<r:EventPlayer>> to you. \"Oh, {PlayerLeader}!\" {EventPlayer} throws you a languishing look."

msgid "STORY_EVENT@1064_857@BODY_LORE"
msgstr "\"You are surely the most stunning of all <<m:{PlayerLeader.Title}>>. Who could betray a heart that beats within a chest as sublime as yours? I regret I do not have the Gildercoil to gift, nor do I know who has it. But I will serve you for eternity, for I could not bear even a hint of your disapproval!\""

msgid "STORY_EVENT@1064_857@BUTTON_0"
msgstr "Make <<P:EventPlayer>> your personal buffoon [unit/]."

msgid "STORY_EVENT@1064_857@BUTTON_1"
msgstr "Let <<P:EventPlayer>> sing ballads of your beauty and fame [influence/]."

msgid "STORY_EVENT@1064_857@BUTTON_2"
msgstr "Allow <<P:EventPlayer>> to follow your command loyally as a hero [unit/]."

msgid "STORY_EVENT@1064_857@TITLE"
msgstr "Love and Let Die: Aftermath"

msgid "STORY_EVENT@1064_85@BODY_FOOTER"
msgstr "Will you try and forge a {EventPact.Hyperlink} with {TargetHouse}?"

msgid "STORY_EVENT@1064_85@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of {EventHouse} comes to you with a request of high importance to <<P:EventHouseLord>>."

msgid "STORY_EVENT@1064_85@BODY_LORE"
msgstr "\"{TargetHouseLord} and I, of {TargetHouse}, share a long and lasting friendship. <<Cp:TargetHouseLord>> once saved me from a boar during a hunt, we have been allies ever since. I would trust {TargetHouseLord} with my life and I believe {TargetHouse} would make a great ally for you as well, {PlayerLeader.TitleName}. I know <<p:TargetHouseLord>> would be honored to join you in your grand quest.\""

msgid "STORY_EVENT@1064_85@BUTTON_0"
msgstr "\"The more allies, the better. I will send a proposal to {TargetHouse}.\""

msgid "STORY_EVENT@1064_85@BUTTON_1"
msgstr "\"Friendships are fleeting. War [chaosboon/] is eternal.\""

msgid "STORY_EVENT@1064_85@BUTTON_2"
msgstr "\"Stop bothering me with your petty alliances.\""

msgid "STORY_EVENT@1064_85@TITLE"
msgstr "Two Cities, United"

msgid "STORY_EVENT@1064_863@BODY_FOOTER"
msgstr "Which magic source will you use to lure the {EventUnit} toward {EventPlayer}?"

msgid "STORY_EVENT@1064_863@BODY_HEADER"
msgstr "As the {EventUnit} calls out to the {GLOBAL.AstralSeaLoreConcept.Hyperlink}, it is driven by its instincts to find new prey."

msgid "STORY_EVENT@1064_863@BODY_LORE"
msgstr "This is the moment you anticipated. An attractive bait is needed to manipulate where the {EventUnit} will strike next."

msgid "STORY_EVENT@1064_863@BUTTON_0"
msgstr "Use a large conglomeration of mana crystals [mana/]."

msgid "STORY_EVENT@1064_863@BUTTON_1"
msgstr "Use your own astral energy [hp/]."

msgid "STORY_EVENT@1064_863@BUTTON_2"
msgstr "Use the souls [population/] of your own population [evilact/]."

msgid "STORY_EVENT@1064_863@TITLE"
msgstr "Luring the Horror"

msgid "STORY_EVENT@1064_864@BODY_FOOTER"
msgstr "\"If you lure out a {EventUnit} from the {GLOBAL.AstralSeaLoreConcept.Hyperlink} and confront {EventPlayer.FirstName} with it, <<p:EventPlayer>> will be paralyzed with fear.\""

msgid "STORY_EVENT@1064_864@BODY_HEADER"
msgstr "\"What's a glutton's greatest fear? That they themselves are consumed.\" {EventHero} bares a sarcastic smile."

msgid "STORY_EVENT@1064_864@BODY_LORE"
msgstr "\"After the Grand Banishment on {GLOBAL.AthlaLoreConcept.Hyperlink}, {EventPlayer} had been exposed to the {GLOBAL.ShadowTrialLoreConcept.Hyperlink} for longer than most {GLOBAL.GodirLoreConcept.Hyperlink}. <<Cp:EventPlayer>> is haunted by that past, still fears the preying <<m:{EventUnit}>> from beyond.\""

msgid "STORY_EVENT@1064_864@BUTTON_0"
msgstr "\"Play the bait for a horror specialized in hunting Godir? Let us hope this is worth it.\""

msgid "STORY_EVENT@1064_864@TITLE"
msgstr "Tormented Past"

msgid "STORY_EVENT@1064_868@BODY_FOOTER"
msgstr "\"Please, {PlayerLeader}, drive back the {EventRace} and free me from their throne of thorns.\""

msgid "STORY_EVENT@1064_868@BODY_HEADER"
msgstr "\"Blessed be this day, O {PlayerLeader}, on which we met, my heroic savior!\" {EventPlayer} makes a theatrical gesture, shaking <<o:EventPlayer>> hands in tears."

msgid "STORY_EVENT@1064_868@BODY_LORE"
msgstr "\"The {EventRace} call me their {EventPlayer.Title}, but I am not. They hold me captive and dress me up as their Ruler out of delusion or mockery. Each day I must watch their vicious ploys and endure the pain of their victims.\""

msgid "STORY_EVENT@1064_868@BUTTON_0"
msgstr "You can sense there is more to {EventPlayer} than meets the eye."

msgid "STORY_EVENT@1064_868@TITLE"
msgstr "The Madness of {EventPlayer}"

msgid "STORY_EVENT@1064_86@BODY_FOOTER"
msgstr "\"You have done both {EventHouse} and {TargetHouse} a great favor. What do you wish in return?\""

msgid "STORY_EVENT@1064_86@BODY_HEADER"
msgstr "You have successfully forged a {EventPact.Hyperlink} with {TargetHouse}. {EventHouseLord} is delighted."

msgid "STORY_EVENT@1064_86@BODY_LORE"
msgstr "\"I knew it! I knew you would find {TargetHouseLord} agreeable. I look forward to our next adventure, {PlayerLeader.TitleName}. {EventHouse} and {TargetHouse} are happy to serve!\""

msgid "STORY_EVENT@1064_86@BUTTON_0"
msgstr "\"Spread the word of my grandeur [influence/] throughout the realm.\""

msgid "STORY_EVENT@1064_86@BUTTON_1"
msgstr "\"My army could use strong soldiers [unit/] like yours.\""

msgid "STORY_EVENT@1064_86@BUTTON_3"
msgstr "\"Your loyalty and gratitude could be expressed in a new pact [allegiance/].\""

msgid "STORY_EVENT@1064_86@TITLE"
msgstr "Two Cities, United: Aftermath"

msgid "STORY_EVENT@1064_881@BODY_FOOTER"
msgstr "You feel prepared to claim the Gildercoil through cunning or force. For the glory of yourself. And for the {GLOBAL.ShadraiFactionLoreConcept.Hyperlink}!"

msgid "STORY_EVENT@1064_881@BODY_HEADER"
msgstr "Once {EventHero.FirstName} has ended the vision, you reflect on the situation at hand."

msgid "STORY_EVENT@1064_881@BODY_LORE"
msgstr "Five {GLOBAL.GodirLoreConcept.Hyperlink} dwell in the Crimson Caldera. One of them owns the Gildercoil, but to find out who, you must have each of them at your mercy. To this end, {EventHero.FirstName} taught you the Mind Thread spell, but brute force seems just as good an option in this realm of perpetual war."

msgid "STORY_EVENT@1064_881@BUTTON_0"
msgstr "\"I am a force nigh unstoppable.\""

msgid "STORY_EVENT@1064_881@TITLE"
msgstr "Finding the Gildercoil"

msgid "STORY_EVENT@1064_882@BODY_FOOTER"
msgstr "\"You have earned the bounty of the Crimson Caldera, {PlayerLeader}. The Gildercoil gave me what I desired, and I have no regrets about signing over the item of eternal [hyperlink,GLOBAL.ArchonsLoreConcept]Archon[/hyperlink] wrath to your name.\""

msgid "STORY_EVENT@1064_882@BODY_HEADER"
msgstr "\"Many have come and died in this arena of my personal disport. They all sought power and found ironic death—all except you.\""

msgid "STORY_EVENT@1064_882@BODY_LORE"
msgstr "{EventPlayer.FirstName} makes a gesture as if putting down a mask, briefly revealing a horned infernal visage. \"I have many names. Atyngwe, Liztia, Perumplex, Zhitur, Gontro... people get creative when it comes to the Demonic Prince of Deceit.\""

msgid "STORY_EVENT@1064_882@BUTTON_0"
msgstr "Take the Gildercoil to complete your victory."

msgid "STORY_EVENT@1064_882@TITLE"
msgstr "Finding the Gildercoil: Aftermath"

msgid "STORY_EVENT@1064_89@BODY_FOOTER"
msgstr "{EventHouseLord} desperately pleads for your armies to clear the {EventSpawner}."

msgid "STORY_EVENT@1064_89@BODY_HEADER"
msgstr "A troubled {EventHouseLord.TitleName} of {EventHouse} appears before you."

msgid "STORY_EVENT@1064_89@BODY_LORE"
msgstr "\"{PlayerLeader.TitleName}, please listen to my humble plea. {EventHouse} is tormented by brigands. I sent a company of soldiers to attack their camp, but instead of engaging the bandits, they defected and joined their ranks. That I should see such times, when the lure of loot is stronger than the call to protect our great city!\""

msgid "STORY_EVENT@1064_89@BUTTON_0"
msgstr "\"My forces will defeat the {EventSpawner}, and you will be in my debt.\""

msgid "STORY_EVENT@1064_89@BUTTON_1"
msgstr "\"If your soldiers [unit/] are so easily bought [gold/], I will buy them then.\""

msgid "STORY_EVENT@1064_89@BUTTON_2"
msgstr "\"I have no time for your petty problems.\""

msgid "STORY_EVENT@1064_89@TITLE"
msgstr "Lure of Loot"

msgid "STORY_EVENT@1064_90@BODY_FOOTER"
msgstr "You have protected {EventHouse} and you are offered a weapon as a token of their gratitude. What more do you ask for?"

msgid "STORY_EVENT@1064_90@BODY_HEADER"
msgstr "You destroyed the {EventSpawner} that was threatening {EventHouse}."

msgid "STORY_EVENT@1064_90@BODY_LORE"
msgstr "{EventHouseLord} is very relieved. \"My city and I are in your debt, {PlayerLeader.TitleName}. We may not have a lot to offer to a {PlayerLeader.Title} like you, but we would be honored to give you a weapon that was once wielded to protect our city from great danger, the {EventItem}.\""

msgid "STORY_EVENT@1064_90@BUTTON_0"
msgstr "\"My empire is always in need of more gold [gold/].\""

msgid "STORY_EVENT@1064_90@BUTTON_1"
msgstr "\"You can repay your debt by granting me a few of your soldiers [unit/].\""

msgid "STORY_EVENT@1064_90@BUTTON_3"
msgstr "\"Remember my deeds, {EventHouseLord}. Remember whom to trust in need.\""

msgid "STORY_EVENT@1064_90@TITLE"
msgstr "Lure of Loot: Aftermath"

msgid "STORY_EVENT@1064_946@BODY_FOOTER"
msgstr "To expand your domain, hunt down the creatures near {EventCity} and grow new population to [hyperlink,GLOBAL.ProvinceImprovementConcept]place[/hyperlink] your first {GLOBAL.FarmConcept.Hyperlink}."

msgid "STORY_EVENT@1064_946@BODY_HEADER"
msgstr "Long have the {EventRace} wandered {GLOBAL.AthlaLoreConcept.Hyperlink} as exiles, O {PlayerLeader.TitleName}. By leading them to this valley you have returned to them their hope."

msgid "STORY_EVENT@1064_946@BODY_LORE"
msgstr "The proud city of {EventCity} represents a new beginning for your people. They are eager to stride beyond the city gates and claim the surrounding land as their own."

msgid "STORY_EVENT@1064_946@BUTTON_0"
msgstr "Let this journey of us {EventRace} begin."

msgid "STORY_EVENT@1064_946@TITLE"
msgstr "A New Dawn"

msgid "STORY_EVENT@1064_947@BODY_FOOTER"
msgstr "The play in your honor will conclude with a promise for the future. How do you wish it to end?"

msgid "STORY_EVENT@1064_947@BODY_HEADER"
msgstr "You have tamed the land around {EventCity} and invoked a spirit of optimism and adventure in your people."

msgid "STORY_EVENT@1064_947@BODY_LORE"
msgstr "They are staging a play that retells the story of how you led the {EventRace} to safety: from the death of the elder, to the inherited {GLOBAL.TomeLoreConcept.Hyperlink}, the schism with {EventHouseLord} and eventually the founding of {EventCity} in the {GLOBAL.ValleyofWondersLoreConcept.Hyperlink}."

msgid "STORY_EVENT@1064_947@BUTTON_0"
msgstr "It ends with a treasury [gold/] worthy of kings."

msgid "STORY_EVENT@1064_947@BUTTON_1"
msgstr "The last scene plays on the bountiful fields [food/] of {EventCity}."

msgid "STORY_EVENT@1064_947@BUTTON_2"
msgstr "On the battlefield, [unitprod/] the valorous {EventRace} fulfill their destiny."

msgid "STORY_EVENT@1064_947@BUTTON_3"
msgstr "It last shows the scholars [knowledge/] of {EventCity} sitting in their high halls."

msgid "STORY_EVENT@1064_947@TITLE"
msgstr "A New Dawn: Aftermath"

msgid "STORY_EVENT@1064_950@BODY_FOOTER"
msgstr "Will you seek out and ally with {EventHouse} to reunite the {EventRace}?"

msgid "STORY_EVENT@1064_950@BODY_HEADER"
msgstr "Following up on a long debate, one of the <<m:EventUnit>> from {EventCity} approaches you, eager to speak."

msgid "STORY_EVENT@1064_950@BODY_LORE"
msgstr "\"As you know, my {PlayerLeader.Title}, not all of us {EventRace} had the wisdom to follow your lead to {EventCity}. Some became fearful of the magic that the elder passed on to you, our {PlayerLeader.Title}. They stayed with {EventHouseLord} to found {EventHouse} on their own.\""

msgid "STORY_EVENT@1064_950@BUTTON_0"
msgstr "\"I agree. We are strongest as one.\""

msgid "STORY_EVENT@1064_950@BUTTON_2"
msgstr "\"I shall secure their loyalty... with the sword [unitprod/]! [evilact/]\""

msgid "STORY_EVENT@1064_950@BUTTON_3"
msgstr "\"They chose their own path. Their destiny is their own.\""

msgid "STORY_EVENT@1064_950@TITLE"
msgstr "Mending the Schism"

msgid "STORY_EVENT@1064_951@BODY_FOOTER"
msgstr "\"{EventHouse} offers all it has to give, so that the {EventRace} may once more stand together.\""

msgid "STORY_EVENT@1064_951@BODY_HEADER"
msgstr "The newly forged pact with {EventHouse} seals the reunification of the {EventRace}."

msgid "STORY_EVENT@1064_951@BODY_LORE"
msgstr "\"We were fools to fear the magic you are wielding,\" {EventHouseLord} says. \"A spell can harm or kill, but it can also protect. We {EventRace} need your powers to survive in this dangerous world and will proudly call you our {PlayerLeader.Title}.\""

msgid "STORY_EVENT@1064_951@BUTTON_0"
msgstr "\"Muster your finest soldiers [unit/] for war!\""

msgid "STORY_EVENT@1064_951@BUTTON_1"
msgstr "\"The people at {EventCity} deserve a feast [food/] in honor of this occasion.\" [goodact/]"

msgid "STORY_EVENT@1064_951@BUTTON_2"
msgstr "\"Donate to my treasury [gold/], and we will prosper together.\""

msgid "STORY_EVENT@1064_951@TITLE"
msgstr "Mending the Schism: Aftermath"

msgid "STORY_EVENT@1064_95@BODY_FOOTER"
msgstr "\"Will you help me kill the {EventStackLeader} and get my revenge?\""

msgid "STORY_EVENT@1064_95@BODY_HEADER"
msgstr "{EventHero} approaches you. \"I was a lonely child,\" <<p:EventHero>> explains, and you realize you're in for a long story."

msgid "STORY_EVENT@1064_95@BODY_LORE"
msgstr "\"The only friend I had was my pet {EventMount}, {PetName}. I loved that beast.\" <<Co:EventHero>> expression darkens. \"But then, the {EventStackLeader} came and attacked our village. Everyone fled except for me and {PetName}... <<Cp:PetName>> died protecting me. On that day I swore I'd have my revenge on that {EventStackLeader} and its kin. And now I’ve tracked it down. The killer of my best friend.\""

msgid "STORY_EVENT@1064_95@BUTTON_0"
msgstr "\"You shall have your revenge, and I the head of the {EventStackLeader}.\""

msgid "STORY_EVENT@1064_95@BUTTON_2"
msgstr "\"This is no time for personal vendettas, {EventHero}.\""

msgid "STORY_EVENT@1064_95@TITLE"
msgstr "Ride for Vengeance"

msgid "STORY_EVENT@1064_965@BODY_FOOTER"
msgstr "Will you resist the demanding gripe of {EventPlayer.Name}?"

msgid "STORY_EVENT@1064_965@BODY_HEADER"
msgstr "From within the smoke of a burning cloud, a regal figure reveals itself to you."

msgid "STORY_EVENT@1064_965@BODY_LORE"
msgstr "\"Rejoice, mortal! You have been deemed worthy of gazing at the aspect of the truly sublime {EventPlayer.Name}. You may now surrender your people and temples to the God of Fire in reverential adoration—or watch them burn in retribution for a foolish mistake.\""

msgid "STORY_EVENT@1064_965@BUTTON_0"
msgstr "\"We are not scared of your fiery legions. Come, face our steel!\""

msgid "STORY_EVENT@1064_965@BUTTON_2"
msgstr "\"How could a mortal withstand the will of a god? I surrender to you, my Overlord.\""

msgid "STORY_EVENT@1064_965@TITLE"
msgstr "Fire and Sand"

msgid "STORY_EVENT@1064_966@BODY_FOOTER"
msgstr "You have emerged from this conflict as a hero and savior of your people. Carried by their elation, you feel your spirits being lifted high, beyond the horizon and toward the {GLOBAL.AstralSeaLoreConcept.Hyperlink}."

msgid "STORY_EVENT@1064_966@BODY_HEADER"
msgstr "\"Victory!\" is what echoes in the streets of {EventCity}, \"Victory!\" is what's engraved in the hearts of the {EventRace} for {EventEnemy}, {GLOBAL.GodirLoreConcept.Hyperlink} of Fire, has been defeated."

msgid "STORY_EVENT@1064_966@BODY_HEADER@NO_CITY"
msgstr "\"Victory!\" is what echoes in the Valley of Wonders, \"Victory!\" is what's engraved in the hearts of the {EventRace} for {EventEnemy}, {GLOBAL.GodirLoreConcept.Hyperlink} of Fire, has been defeated."

msgid "STORY_EVENT@1064_966@BODY_LORE"
msgstr "Smoke still lingers over the proud cities of the {EventEnemyRace}, while you reflect on your own accomplishments. Was it truly a [hyperlink,GLOBAL.AscendedChampLoreConcept]Mortal Hero[/hyperlink] that took down the {GLOBAL.WizardKingLoreConcept.Hyperlink} {EventEnemy.FirstName}? Or had your journey of knowledge and power already altered your destiny?"

msgid "STORY_EVENT@1064_966@BUTTON_0"
msgstr "Let go of Athla to conclude your ascension."

msgid "STORY_EVENT@1064_966@TITLE"
msgstr "Fire and Sand: Aftermath"

msgid "STORY_EVENT@1064_96@BODY_FOOTER"
msgstr "{EventHero} is grateful for your help in <<o:EventHero>> quest for vengeance. What do you ask for in return?"

msgid "STORY_EVENT@1064_96@BODY_HEADER"
msgstr "You succesfully hunted down and killed the {EventStackLeader}."

msgid "STORY_EVENT@1064_96@BODY_LORE"
msgstr "{EventHero} bows <<o:EventHero>> head. \"Finally, it is done. {PetName}, my old friend, you have been avenged!\" <<Cp:EventHero>> looks up. \"Thank you, {PlayerLeader.TitleName}. This means a lot to me. Tell me what I can do to repay you.\""

msgid "STORY_EVENT@1064_96@BUTTON_0"
msgstr "\"Train the new recruits [unitprod/] in {EventCity}.\""

msgid "STORY_EVENT@1064_96@BUTTON_1"
msgstr "\"We avenged your old mount. Go out and train [mount/] a new one!\""

msgid "STORY_EVENT@1064_96@BUTTON_3"
msgstr "\"Your loyalty and gratitude [happiness/] is all I can ask for.\""

msgid "STORY_EVENT@1064_96@TITLE"
msgstr "Ride to Vengeance: Aftermath"

msgid "STORY_EVENT@1064_973@BODY_FOOTER"
msgstr "{EventPlayer.FirstName} advises you to explore the nearby {EventStructure} and use its powers to ward off {EventEnemy}."

msgid "STORY_EVENT@1064_973@BODY_HEADER"
msgstr "\"The pyromancer {EventEnemy} has broken free and returned to {GLOBAL.AthlaLoreConcept.Hyperlink}. <<Co:EventEnemy>> gaze is set on the {GLOBAL.ValleyofWondersLoreConcept.Hyperlink}.\""

msgid "STORY_EVENT@1064_973@BODY_LORE"
msgstr "\"<<Cp:EventEnemy>> is building up <<o:EventEnemy>> infernal strengths and will not tolerate competition, especially from a fledgling mage like you. You must embrace the spark of magic that has awoken inside of you. Seek out the powers of the nearby {EventStructure} before {EventEnemy.FirstName} does. If you don't prepare, {EventEnemy.FirstName} will burn your settlements to the ground.\""

msgid "STORY_EVENT@1064_973@BUTTON_0"
msgstr "\"You have my gratitude, {EventPlayer}. Together, we can take on even a Wizard King.\""

msgid "STORY_EVENT@1064_973@BUTTON_2"
msgstr "\"Your advice is an insult to my rule. Be gone!\""

msgid "STORY_EVENT@1064_973@TITLE"
msgstr "The Lost Tower"

msgid "STORY_EVENT@1064_974@BODY_FOOTER"
msgstr "{EventPlayer} takes out a {EventItem} and hands it to you. \"You are ready to strike {EventEnemy.FirstName}, {PlayerLeader}. I will lend you a battalion of my warriors—choose, what best fits your strategy.\""

msgid "STORY_EVENT@1064_974@BODY_HEADER"
msgstr "While your mind is still going over the happenings at the Tower of Destinies, you are once more approached by {EventPlayer}."

msgid "STORY_EVENT@1064_974@BODY_LORE"
msgstr "\"Mind-boggling, isn't it? To think that all this knowledge had been buried on {GLOBAL.AthlaLoreConcept.Hyperlink} for ages—if only Julia or Merlin were here to ponder its meaning. Alas, there is less hope for finding them than for solving this ourselves. You have been gifted, {PlayerLeader}. Before long you will learn what that truly means.\""

msgid "STORY_EVENT@1064_974@BUTTON_0"
msgstr "Ask for archers [unit/] to shoot the enemy from afar."

msgid "STORY_EVENT@1064_974@BUTTON_2"
msgstr "Ask for healers [unit/] that will mend the wounds in battle."

msgid "STORY_EVENT@1064_974@BUTTON_3"
msgstr "Ask for pikemen [unit/] to guard the front lines."

msgid "STORY_EVENT@1064_974@TITLE"
msgstr "The Lost Tower: Aftermath"

msgid "STORY_EVENT@1064_987@BODY_FOOTER"
msgstr "The depicted races seemed ancient and forgotten, but {EventHero} shudders as shrouded figures start to emerge from the dark edges of the vault."

msgid "STORY_EVENT@1064_987@BODY_FOOTER@LEADER"
msgstr "The depicted races seemed ancient and forgotten, but your troops shudder as shrouded figures start to emerge from the dark edges of the hall."

msgid "STORY_EVENT@1064_987@BODY_HEADER"
msgstr "As {EventHero} enters the {EventStructure}, a grand hall with ornate columns at its center opens up before <<P:EventHero>>."

msgid "STORY_EVENT@1064_987@BODY_HEADER@LEADER"
msgstr "As you enter the {EventStructure}, a grand hall with ornate columns at its center opens up before you."

msgid "STORY_EVENT@1064_987@BODY_LORE"
msgstr "The reliefs worked into the columns each tell the story of a rising people, receiving gifts from a mysterious {GLOBAL.GodirLoreConcept.Hyperlink}. Some learned to endure fire, while others grew wings or started to siphon life from their enemies. In <<g:mind^m,EventHero>> a muffled message echoes: \"Only the worthy ascend.\""

msgid "STORY_EVENT@1064_987@BODY_LORE@LEADER"
msgstr "The reliefs worked into the columns each tell the story of a rising people, receiving gifts from a mysterious {GLOBAL.GodirLoreConcept.Hyperlink}. Some learned to endure fire, while others grew wings or started to siphon life from their enemies. In your mind a muffled message echoes: \"Only the worthy ascend.\""

msgid "STORY_EVENT@1064_987@BUTTON_0"
msgstr "\"Come what may come, we stand our ground!\""

msgid "STORY_EVENT@1064_987@BUTTON_1"
msgstr "Cast a lesser ward [mana/] to protect [resistance/] your troops."

msgid "STORY_EVENT@1064_987@BUTTON_3"
msgstr "Invoke the column of the supercharged storm lords."

msgid "STORY_EVENT@1064_987@BUTTON_4"
msgstr "Invoke the column of the horned demon kin."

msgid "STORY_EVENT@1064_987@BUTTON_5"
msgstr "Flee."

msgid "STORY_EVENT@1064_987@BUTTON_6"
msgstr "Invoke the column of the verdant tree herders."

msgid "STORY_EVENT@1064_987@BUTTON_7"
msgstr "Invoke the column of the exalted paladins."

msgid "STORY_EVENT@1064_987@BUTTON_8"
msgstr "Invoke the column of the steadfast craft-lords."

msgid "STORY_EVENT@1064_987@BUTTON_9"
msgstr "Invoked the column of the rotting corpse-born."

msgid "STORY_EVENT@1064_987@TITLE"
msgstr "The Tower of Destinies"

msgid "STORY_EVENT@1064_988@BODY_FOOTER"
msgstr "Upon touching the book, {EventHero} hears the same echoing voice in <<p:EventHero>> head: \"Which path do you wish to lead the {EventRace} on?\""

msgid "STORY_EVENT@1064_988@BODY_FOOTER@LEADER"
msgstr "Upon touching the book, you hear the same echoing voice in your head: \"Which path do you wish to lead the {EventRace} on?\""

msgid "STORY_EVENT@1064_988@BODY_HEADER"
msgstr "The guardians of the tower have been dispersed, leaving its secrets ripe for the taking."

msgid "STORY_EVENT@1064_988@BODY_LORE"
msgstr "On a flowrock altar, {EventHero} finds a single tome-like book, its binding old and imposing like a testament of time. Whether the mysterious Godir shown on the columns left it here or some preserver of his legacy, remains uncertain."

msgid "STORY_EVENT@1064_988@BODY_LORE@LEADER"
msgstr "On a flowrock altar, you find a single tome-like book, its binding old and imposing like a testament of time. Whether the mysterious Godir shown on the columns left it here or some preserver of his legacy, remains uncertain."

msgid "STORY_EVENT@1064_988@BUTTON_1"
msgstr "\"On the path of arcane enlightenment.\""

msgid "STORY_EVENT@1064_988@BUTTON_10"
msgstr "\"On the path of demonic powers, a pact unbroken.\""

msgid "STORY_EVENT@1064_988@BUTTON_3"
msgstr "\"To an eternal life beyond death.\""

msgid "STORY_EVENT@1064_988@BUTTON_7"
msgstr "\"Into the wilds, embracing its roots.\""

msgid "STORY_EVENT@1064_988@BUTTON_8"
msgstr "\"Toward the riches and spoils of the earth.\""

msgid "STORY_EVENT@1064_988@BUTTON_9"
msgstr "\"Toward a faith-bound paradise, free of sin.\""

msgid "STORY_EVENT@1064_988@TITLE"
msgstr "The Tower of Destinies: Aftermath"

msgid "STORY_EVENT@1064_991@BODY_FOOTER"
msgstr "\"Listen to what I have to say, and you and your {EventRace} may avoid meeting your end here.\""

msgid "STORY_EVENT@1064_991@BODY_HEADER"
msgstr "Ever since you arrived in the {GLOBAL.ValleyofWondersLoreConcept.Hyperlink}, lucid visions have appeared in your mind's eye. Now a purposeful looking Elven lady comes into focus."

msgid "STORY_EVENT@1064_991@BODY_LORE"
msgstr "\"Salutations, {PlayerLeader}. I am {EventPlayer}. My people have guarded this valley throughout the Ages. For better or for worse, its fate is connected to our own.[br/][br/]We have been watching you for some time. Other, powerful {GLOBAL.GodirLoreConcept.Hyperlink} have noticed your arrival too. Your essence emanates conflict but also great potential.\""

msgid "STORY_EVENT@1064_991@BUTTON_0"
msgstr "Continue to listen..."

msgid "STORY_EVENT@1064_991@TITLE"
msgstr "<<ge:Call^n,EventPlayer.FirstName>>"

msgid "STORY_EVENT@1064_9@BODY_FOOTER"
msgstr "The creature pleads with you to liberate her and the people of this realm from the wrath of the {EventNimue.Title}."

msgid "STORY_EVENT@1064_9@BODY_HEADER"
msgstr "You arrive at the outer edge of the Enchanted Archipelago. You are greeted by a wistful voice, the one that pulled you to this realm."

msgid "STORY_EVENT@1064_9@BODY_LORE"
msgstr "The voice sings of love turned to obsession, of a wrathful goddess and enthralled people. Of a lake, a wellspring, turned into a prison. She sings desperately for the arrival of a savior on this realm. [br/][br/]Suddenly, the voice is drowned out by cackling laughter before it falls silent, leaving nothing but the sound of the wind and waves."

msgid "STORY_EVENT@1064_9@BUTTON_0"
msgstr "I will claim this realm and liberate it from this \"Siren Goddess\"."

msgid "STORY_EVENT@1064_9@TITLE"
msgstr "The Enchanted Archipelago"

msgid "STORY_EVENT@1103_10@BODY_FOOTER"
msgstr "Would you grant the seemingly gentle {EventStackLeader.Name} mercy, or will you attack?"

msgid "STORY_EVENT@1103_10@BODY_HEADER"
msgstr "As your troops move in to engage the ancient {EventStackLeader.Name}, <<p:EventStackLeader>> surprises them by simply sitting down."

msgid "STORY_EVENT@1103_10@BODY_LORE"
msgstr "Though seated, the [hyperlink,GLOBAL.GiantsLoreConcept]primal being[/hyperlink] still towers above your army, casting a long shadow that engulfs much of <<o:EventStackLeader>> surroundings. Once, <<p:EventStackLeader>> used <<o:EventStackLeader>> tremendous power to form the mountains and seas. Now the {EventStackLeader} raises <<o:EventStackLeader>> arms in the timeless sign of surrender. Then <<p:EventStackLeader>> simply waits, <<o:EventStackLeader>> arms scraping the sky like two eerie pinnacles."

msgid "STORY_EVENT@1103_10@BUTTON_0"
msgstr "\"Death to the {EventStackLeader}!\" [evilact/]"

msgid "STORY_EVENT@1103_10@BUTTON_1"
msgstr "\"Go in peace, my gargantuan friend.\" [goodact/]"

msgid "STORY_EVENT@1103_10@BUTTON_2"
msgstr "\"Go forth, {EventStackLeader}, and tell all [influence/] that you live because I granted you mercy!\""

msgid "STORY_EVENT@1103_10@TITLE"
msgstr "Big Friendly {EventStackLeader.Name}"

msgid "STORY_EVENT@1103_11@BODY_FOOTER"
msgstr "<<Cp:EventStackLeader>> gestures at {EventHero.FirstName} and then at himself and his opponent. \"Who is worthier?\""

msgid "STORY_EVENT@1103_11@BODY_HEADER"
msgstr "Troops of {EventHouse.Name} watch two mighty but evenly matched warriors clash at the {EventStructure.Name}."

msgid "STORY_EVENT@1103_11@BODY_LORE"
msgstr "{EventStackLeader.Name}, one of the battling warriors, stops and addresses {EventHero.Name} as they approach the {EventStructure.Name}. \"Strength and glory! You serve {PlayerLeader.TitleName}, yes? Our {EventHouseLord.Title} has decreed that whoever is stronger will have the honor of guarding this site. But we are evenly matched. You decide who is worthy and who can quit the field in shame!\""

msgid "STORY_EVENT@1103_11@BUTTON_1"
msgstr "\"Neither. You both require training! My men will train you, [unitprod/] and you will leave this site to me.\""

msgid "STORY_EVENT@1103_11@BUTTON_2"
msgstr "\"Are you mewling pups?! Fight! The victor shall grant ME this site!\""

msgid "STORY_EVENT@1103_11@BUTTON_3"
msgstr "\"I see nobody worthy to guard this site. I see only a number of corpses to be!\""

msgid "STORY_EVENT@1103_11@BUTTON_4"
msgstr "\"I'll leave you to it...\""

msgid "STORY_EVENT@1103_11@TITLE"
msgstr "Dueling Barbarians"

msgid "STORY_EVENT@1103_12@BODY_FOOTER"
msgstr "<<Cp:EventStackLeader>> crosses <<o:EventStackLeader>> arms and stares {EventHero.FirstName} square in the eye. \"What is best in life?\""

msgid "STORY_EVENT@1103_12@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "<<Cp:EventStackLeader>> crosses <<o:EventStackLeader>> arms and stares you square in the eye. \"What is best in life?\""

msgid "STORY_EVENT@1103_12@BODY_HEADER"
msgstr "Troops of {EventHouse.Name} stationed at the {EventStructure.Name} sit around a fire, discussing the merits of a barbarian's way of life."

msgid "STORY_EVENT@1103_12@BODY_LORE"
msgstr "{EventStackLeader.Name} glances at {EventHero.Name} as <<p:EventHero>> approaches the {EventStructure.Name}. \"I know you, you serve {PlayerLeader.TitleName}, no? You have learned much in your travels, yes? Help us settle an argument.\""

msgid "STORY_EVENT@1103_12@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "{EventStackLeader.Name} glances at you as you approach the {EventStructure.Name}. \"I know you, you are {PlayerLeader.TitleName}, no? You have learned much in your travels, yes? Help us settle an argument.\""

msgid "STORY_EVENT@1103_12@BUTTON_1"
msgstr "\"Glory is best! [influence/] Leave and earn some for yourselves!\""

msgid "STORY_EVENT@1103_12@BUTTON_2"
msgstr "\"Valor is best. We are mightier than you. We claim this site!\""

msgid "STORY_EVENT@1103_12@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "\"Valor is best. I am mightier than you. I claim this site!\""

msgid "STORY_EVENT@1103_12@BUTTON_3"
msgstr "\"Harmony is best. This land calls for <<g:rule^n,PlayerLeader>>.\""

msgid "STORY_EVENT@1103_12@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "\"Harmony is best. This land calls for my rule.\""

msgid "STORY_EVENT@1103_12@BUTTON_4"
msgstr "\"Battle is best! To crush your enemies, see them driven before you!\""

msgid "STORY_EVENT@1103_12@BUTTON_5"
msgstr "\"Honor is best. We honor your claim to this {EventStructure}. Farewell.\""

msgid "STORY_EVENT@1103_12@BUTTON_5@HERO_IS_PLAYERLE"
msgstr "\"Honor is best. I honor your claim to this {EventStructure}. Farewell.\""

msgid "STORY_EVENT@1103_12@TITLE"
msgstr "Barbaric Philosophy"

msgid "STORY_EVENT@1103_13@BODY_FOOTER"
msgstr "The {EventStackLeader} nervously awaits your response, one hand hovering close to their weapon."

msgid "STORY_EVENT@1103_13@BODY_HEADER"
msgstr "There is something suspicious about the way a squad of troops from {EventHouse.Name} warily watch your army's approach to {EventStructure.Name}."

msgid "STORY_EVENT@1103_13@BODY_LORE"
msgstr "As {EventHero.Name} approaches, they note standards and insignia of {EventHouse.Name} cast to the side. A frowning {EventStackLeader} says, \"We just wish to be left alone, please move along.\" It would seem these troops are considering desertion..."

msgid "STORY_EVENT@1103_13@BUTTON_0"
msgstr "\"You are clearly deserters. Accept this donation [gold/] toward a fresh start. Now leave this place."

msgid "STORY_EVENT@1103_13@BUTTON_1"
msgstr "Compel them to repent and submit to you."

msgid "STORY_EVENT@1103_13@BUTTON_2"
msgstr "\"Desertion is punishable by death!\""

msgid "STORY_EVENT@1103_13@BUTTON_3"
msgstr "Leave them."

msgid "STORY_EVENT@1103_13@TITLE"
msgstr "Just Deserters"

msgid "STORY_EVENT@1103_14@BODY_FOOTER"
msgstr "<<Cp:EventStackLeader>> gestures at {EventHero.FirstName}. \"Are you an expert in magical energy convergences?\""

msgid "STORY_EVENT@1103_14@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "<<Cp:EventStackLeader>> gestures at you. \"Are you an expert in magical energy convergences?\""

msgid "STORY_EVENT@1103_14@BODY_HEADER"
msgstr "The troops of {EventHouse.Name} stationed at the {EventStructure.Name} seem to be observing the area whilst taking diligent notes."

msgid "STORY_EVENT@1103_14@BODY_LORE"
msgstr "{EventStackLeader.Name} runs up to {EventHero.Name} as your army approaches the {EventStructure.Name}. \"You can feel it as well, no?! A certain convergence of energies on this area! That must surely be why {PlayerLeader.TitleName} sent you! Are you here to study this obviously magical location too?\""

msgid "STORY_EVENT@1103_14@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "{EventStackLeader.Name} runs up to you as your army approaches the {EventStructure.Name}. \"You can feel it as well, no?! A certain convergence of energies on this area! That must surely be why you came! Are you here to study this obviously magical location too?\""

msgid "STORY_EVENT@1103_14@BUTTON_0"
msgstr "\"You may access our libraries [knowledge/], but {PlayerLeader.TitleName} now claims this {EventStructure}.\""

msgid "STORY_EVENT@1103_14@BUTTON_0@HERO_IS_PLAYERLE"
msgstr "\"You may access my libraries [knowledge/], but I now claim this {EventStructure}.\""

msgid "STORY_EVENT@1103_14@BUTTON_1"
msgstr "\"Witness the power of my magic while I claim this site!\""

msgid "STORY_EVENT@1103_14@BUTTON_2"
msgstr "\"Our blades will converge with your hearts!\""

msgid "STORY_EVENT@1103_14@BUTTON_3"
msgstr "\"We're merely passing through. Continue your studies undisturbed.\""

msgid "STORY_EVENT@1103_14@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "\"I'm merely passing through. Continue your studies undisturbed.\""

msgid "STORY_EVENT@1103_14@TITLE"
msgstr "Converging Minds"

msgid "STORY_EVENT@1103_15@BODY_FOOTER"
msgstr "The {EventStackLeader} glances at {EventHero.FirstName} as <<p:EventStackLeader>> prepares a new spell. \"Kindly wait for us to conclude our debate.\""

msgid "STORY_EVENT@1103_15@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "The {EventStackLeader} glances at you as <<p:EventStackLeader>> prepares a new spell. \"Kindly wait for us to conclude our debate.\""

msgid "STORY_EVENT@1103_15@BODY_HEADER"
msgstr "The air sizzles around {EventStructure.Name} as two groups of mages from {EventHouse.Name} hurl spells at each other."

msgid "STORY_EVENT@1103_15@BODY_LORE"
msgstr "{EventStackLeader.Name} calls for a cessation of hostilities as {EventHero.Name} approaches. <<Cp:EventStackLeader>> glares at <<o:EventStackLeader>> opponent as one final spell strikes a tree next to <<P:EventStackLeader>> before turning and addressing the hero. \"Your time of arrival is inopportune! We are determining which of us is most capable, magically speaking, of guarding this site for {EventHouse.Name}.\""

msgid "STORY_EVENT@1103_15@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "{EventStackLeader.Name} calls for a cessation of hostilities as your army approaches. <<Cp:EventStackLeader>> glares at <<o:EventStackLeader>> opponent as one final spell strikes a tree next to <<P:EventStackLeader>> before turning and addressing you. \"Your time of arrival is inopportune! We are determining which of us is most capable, magically speaking, of guarding this site for {EventHouse.Name}.\""

msgid "STORY_EVENT@1103_15@BUTTON_0"
msgstr "\"Use <<mana^n,PlayerLeader>> [mana/] to recharge, but finish your debate elsewhere.\""

msgid "STORY_EVENT@1103_15@BUTTON_0@HERO_IS_PLAYERLE"
msgstr "\"Use my mana [mana/] to recharge, but finish your debate elsewhere.\""

msgid "STORY_EVENT@1103_15@BUTTON_1"
msgstr "\"This land shall tolerate your magical transgressions no longer!\""

msgid "STORY_EVENT@1103_15@BUTTON_2"
msgstr "\"All that energy dispensed, yet none spent on defending yourselves!\""

msgid "STORY_EVENT@1103_15@BUTTON_3"
msgstr "\"We are leaving before you burn this {EventStructure} to the ground.\""

msgid "STORY_EVENT@1103_15@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "\"I am leaving before you burn this {EventStructure} to the ground.\""

msgid "STORY_EVENT@1103_15@TITLE"
msgstr "Mystical Debate"

msgid "STORY_EVENT@1103_1@BODY_FOOTER"
msgstr "Do you allow the plaintive {EventStackLeader.Name} and <<o:EventStackLeader>> gigantic clan to retreat, or will you attack?"

msgid "STORY_EVENT@1103_1@BODY_HEADER"
msgstr "The towering {EventStackLeader.Name} gibbers in terror at your army's approach. <<Cp:EventStackLeader>> hunkers down, hiding <<o:EventStackLeader>> features behind gigantic fingers."

msgid "STORY_EVENT@1103_1@BODY_LORE"
msgstr "Seeing their leader submit, the rest of <<o:EventStackLeader>> tribe follow suit. The area is soon filled with the sounds of mournful howls and deep-throated cries for mercy."

msgid "STORY_EVENT@1103_1@BUTTON_0"
msgstr "Slay them all! [evilact/]"

msgid "STORY_EVENT@1103_1@BUTTON_1"
msgstr "\"Begone, gentle giants.\" [goodact/]"

msgid "STORY_EVENT@1103_1@BUTTON_2"
msgstr "Conscript [unitprod/] them as laborers [structureprod/] in {EventCity.Name}."

msgid "STORY_EVENT@1103_1@TITLE"
msgstr "Size Matters Not"

msgid "STORY_EVENT@1103_2@BODY_FOOTER"
msgstr "Will you avoid them and allow them to escape, or will you strike first?"

msgid "STORY_EVENT@1103_2@BODY_HEADER"
msgstr "An {EventStackLeader.Name} and other undead stare at your troops with fear and hunger in equal measure."

msgid "STORY_EVENT@1103_2@BODY_LORE"
msgstr "Fear, however, soon seems to prevail, rendering the group unwilling to attack. The lifeless beings shuffle around, trying to keep their distance from your army."

msgid "STORY_EVENT@1103_2@BUTTON_0"
msgstr "\"Death to these dead!\""

msgid "STORY_EVENT@1103_2@BUTTON_1"
msgstr "Leave them dead and let them keep on causing mayhem. [evilact/]"

msgid "STORY_EVENT@1103_2@BUTTON_3"
msgstr "Using magic, [mana/] release their spirits and let these dead finally rest. [goodact/]"

msgid "STORY_EVENT@1103_2@BUTTON_4"
msgstr "\"Stop wandering around aimlessly and join my ranks!\""

msgid "STORY_EVENT@1103_2@TITLE"
msgstr "A Lease on Unlife"

msgid "STORY_EVENT@1103_3@BODY_FOOTER"
msgstr "Will you grant them mercy, or will you attack?"

msgid "STORY_EVENT@1103_3@BODY_HEADER"
msgstr "A tortured-looking {EventStackLeader.Name} and <<o:EventStackLeader>> minions gape at your army."

msgid "STORY_EVENT@1103_3@BODY_LORE"
msgstr "Wordless, the vacant beings shuffle towards you, their limbs and features wrapped in grasping vines. Leaves shudder and bark creaks in silent supplication, but they make no otherwise hostile movements."

msgid "STORY_EVENT@1103_3@BUTTON_0"
msgstr "\"Prune these shrubs!\" [evilact/]"

msgid "STORY_EVENT@1103_3@BUTTON_1"
msgstr "Let them grow. [goodact/]"

msgid "STORY_EVENT@1103_3@BUTTON_2"
msgstr "Discover [knowledge/] how to carefully harvest [food/] their vines and allow them to leave afterwards."

msgid "STORY_EVENT@1103_3@TITLE"
msgstr "Seeds of Doubt"

msgid "STORY_EVENT@1103_4@BODY_FOOTER"
msgstr "Will you allow the {EventStackLeader.Name} and <<o:EventStackLeader>> folk safe passage or will you strike them down?"

msgid "STORY_EVENT@1103_4@BODY_HEADER"
msgstr "A group of hungry and frightened Fey folk do their best to hide behind {EventStackLeader.Name} as your army approaches."

msgid "STORY_EVENT@1103_4@BODY_LORE"
msgstr "The {EventStackLeader.Name}, putting on as brave a face as possible, tries to keep <<o:EventStackLeader>> group behind <<p:EventStackLeader>> and faces your troops defiantly, but otherwise says nothing and makes no hostile movements."

msgid "STORY_EVENT@1103_4@BUTTON_0"
msgstr "\"No mercy!\" [evilact/]"

msgid "STORY_EVENT@1103_4@BUTTON_1"
msgstr "\"Peace, brave one.\" [goodact/]"

msgid "STORY_EVENT@1103_4@BUTTON_2"
msgstr "Trade them food [food/] for Fey secrets [knowledge/] and allow them to leave."

msgid "STORY_EVENT@1103_4@TITLE"
msgstr "Food for Thought"

msgid "STORY_EVENT@1103_5@BODY_FOOTER"
msgstr "Will you attack them, or allow {EventStackLeader.Name} and <<o:EventStackLeader>> temperamental allies to retreat?"

msgid "STORY_EVENT@1103_5@BODY_HEADER"
msgstr "Temperatures in the immediate area rise and fall intermittently as a group of elemental beings panic at your army's approach."

msgid "STORY_EVENT@1103_5@BODY_LORE"
msgstr "The {EventStackLeader.Name}, seemingly the leader of this group, wavers unsteadily before you. <<p:EventStackLeader>> seems aware that engaging you would result in almost certain death, but is unwilling to abandon <<o:EventStackLeader>> group."

msgid "STORY_EVENT@1103_5@BUTTON_0"
msgstr "Attack! [evilact/]"

msgid "STORY_EVENT@1103_5@BUTTON_1"
msgstr "Allow them to go. [goodact/]"

msgid "STORY_EVENT@1103_5@BUTTON_2"
msgstr "Demand a portion of their primal power [mana/] before they leave."

msgid "STORY_EVENT@1103_5@TITLE"
msgstr "Elements of Surprise"

msgid "STORY_EVENT@1103_6@BODY_FOOTER"
msgstr "Will you allow them to summon their portal to {GLOBAL.ObbadothLoreConcept.Hyperlink} and leave these lands?"

msgid "STORY_EVENT@1103_6@BODY_HEADER"
msgstr "As your troops engage the group of fiends, it becomes apparent that they had been conjuring a portal to withdraw."

msgid "STORY_EVENT@1103_6@BODY_LORE"
msgstr "The {EventStackLeader.Name}, the apparent leader of the gathering, casts a shrewd eye over your army. Seeing that there is scant hope of survival, <<p:EventStackLeader>> beckons <<o:EventStackLeader>> own troops to sit on the ground and submit before following suit <<r:EventStackLeader>>. <<Cp:EventStackLeader>> watches you with wary hope."

msgid "STORY_EVENT@1103_6@BUTTON_0"
msgstr "\"Kill them all!\" [evilact/]"

msgid "STORY_EVENT@1103_6@BUTTON_1"
msgstr "\"Begone then, fiends, and do not return!\" [goodact/]"

msgid "STORY_EVENT@1103_6@BUTTON_2"
msgstr "Bind the {EventStackLeader.Name} to you [mana/]."

msgid "STORY_EVENT@1103_6@TITLE"
msgstr "Fiend or Foe"

msgid "STORY_EVENT@1103_7@BODY_FOOTER"
msgstr "Will you allow the airborne beasts to retreat with their eggs, or will you attack?"

msgid "STORY_EVENT@1103_7@BODY_HEADER"
msgstr "Your troops rush a group of winged creatures but notice that they neither attack nor retreat."

msgid "STORY_EVENT@1103_7@BODY_LORE"
msgstr "Your foes fly around the area, flapping their wings and making alarmed noises. They don't wish to engage your superior numbers but appear loath to retreat too. It seems they are protecting some nearby nests."

msgid "STORY_EVENT@1103_7@BUTTON_0"
msgstr "\"Cull them all.\" [evilact/]"

msgid "STORY_EVENT@1103_7@BUTTON_1"
msgstr "\"Fly, you fowl!\" [goodact/]"

msgid "STORY_EVENT@1103_7@BUTTON_2"
msgstr "Build an aviary [structureprod/] in {EventCity.Name}, providing safety for the beasts [happiness/]."

msgid "STORY_EVENT@1103_7@TITLE"
msgstr "Flight or Fight"

msgid "STORY_EVENT@1103_8@BODY_FOOTER"
msgstr "Will you leave the macabre monsters to their terror or attack them anyway?"

msgid "STORY_EVENT@1103_8@BODY_HEADER"
msgstr "As your troops move to attack the {EventStackLeader.Name} and <<o:EventStackLeader>> collection of [hyperlink,GLOBAL.AstralMonstersLoreConcept]horrors[/hyperlink], the enemy squeals and submits."

msgid "STORY_EVENT@1103_8@BODY_LORE"
msgstr "Undulating flesh and writhing tentacles weave around in a grotesque show of panic, as your weapons surround the group of eldritch horrors from the {GLOBAL.AstralSeaLoreConcept.Hyperlink}. While terrifying in aspect, these beings seem to have no fight in them. At least, not for you..."

msgid "STORY_EVENT@1103_8@BUTTON_0"
msgstr "\"Put them down!\""

msgid "STORY_EVENT@1103_8@BUTTON_1"
msgstr "Allow them to flee and spread their terror in a rampage across the realm. [evilact/]"

msgid "STORY_EVENT@1103_8@BUTTON_2"
msgstr "Banish them [mana/] to the Astral Sea where they cannot harm anyone. [goodact/]"

msgid "STORY_EVENT@1103_8@TITLE"
msgstr "Fathomless Intentions"

msgid "STORY_EVENT@1103_9@BODY_FOOTER"
msgstr "The {EventStackLeader.Name} ponders: \"What shall it be then? Prudence, and we part as equals? Or glory, and one of us falls?\""

msgid "STORY_EVENT@1103_9@BODY_HEADER"
msgstr "Rather than engaging your approaching troops, the {EventStackLeader.Name} turns <<o:EventStackLeader>> sinewy neck as <<p:EventStackLeader>> regards them with an ancient, knowing gaze."

msgid "STORY_EVENT@1103_9@BODY_LORE"
msgstr "\"I see much in the way of strength and power before me,\" the great [hyperlink,GLOBAL.DragonsLoreConcept]dragon's[/hyperlink] sonorous voice booms. Ages ago, <<p:EventStackLeader>> and <<o:EventStackLeader>> kin used primal forces to shape this realm. Now the serpentine monster pauses, casting a look of vast intelligence over your army. \"I, too, you may agree, am mighty. Equally, we are matched, yes?\""

msgid "STORY_EVENT@1103_9@BUTTON_0"
msgstr "\"Glory, you overgrown worm! Attack!\" [evilact/]"

msgid "STORY_EVENT@1103_9@BUTTON_1"
msgstr "\"Peace, great dragon. Let us go our separate ways...\" [goodact/]"

msgid "STORY_EVENT@1103_9@BUTTON_2"
msgstr "\"Before we part in peace, a trade? Gold [gold/] for your hoard in exchange for ancient knowledge [knowledge/].\""

msgid "STORY_EVENT@1103_9@TITLE"
msgstr "Here Be Dragons"

msgid "STORY_EVENT@1122_103@BODY_FOOTER"
msgstr "\"Kindly extend our receiver network to allow enhanced beamforming. Or, as your workers will understand it: please build additional [hyperlink,GLOBAL.ResearchPostConcept][researchpost/]Research Posts[/hyperlink].\""

msgid "STORY_EVENT@1122_103@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of {EventHouse} respectfully greets you. \"Wise {PlayerLeader.TitleName}, we chart the stars' movements. Our beamforming mages request your support.\""

msgid "STORY_EVENT@1122_103@BODY_LORE"
msgstr "\"Beamforming is quite straightforward. Starlight arrives here from the {GLOBAL.AstralSeaLoreConcept.Hyperlink} as rays. Our mages observe these rays for a minuscule moment. However, a star's distance and velocity cause a slight discrepancy in its rays' arrival at each of our [hyperlink,GLOBAL.ProvinceImprovementConcept][researchpost/]Research Posts[/hyperlink], causing noise. Combining channeled ray observations throughout our entire domain, slightly delayed to compensate for the discrepancy, forms a stronger and clearer signal."

msgid "STORY_EVENT@1122_103@BUTTON_0"
msgstr "\"As you request. But I expect to share in your discoveries.\""

msgid "STORY_EVENT@1122_103@BUTTON_2"
msgstr "\"Alternatively, I will share my own astral observations [knowledge/] with you.\""

msgid "STORY_EVENT@1122_103@BUTTON_3"
msgstr "\"How about I directly manipulate the stars' movements instead, for you to observe?\""

msgid "STORY_EVENT@1122_103@BUTTON_4"
msgstr "\"This sounds like a waste of time and resources to me.\""

msgid "STORY_EVENT@1122_103@TITLE"
msgstr "Astral Beamforming"

msgid "STORY_EVENT@1122_104@BODY_FOOTER"
msgstr "The {EventHouseLord.Name} bows. \"Thanks to you, our <<m:EventUnit>> now harness the power of stars. We respectfully offer you any reward.\""

msgid "STORY_EVENT@1122_104@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of {EventHouse} returns to you shortly after you erected the final {EventImprovement}. \"New revelations keep pouring in, my {PlayerLeader.Title}!\""

msgid "STORY_EVENT@1122_104@BODY_LORE"
msgstr "\"We were a bit uncertain about the attunement of the channeling delay at first, but we soon found we could offset the detections against the speed of magic over which we let flow our perceptions of the starlight pulses. This yielded new constellation charts, some of which we used to forge powerful [hyperlink,GLOBAL.AstralSeaLoreConcept]astral[/hyperlink] visors, such as this!\" {EventHouseLord} proudly holds up an immaculate {EventItem}."

msgid "STORY_EVENT@1122_104@BUTTON_0"
msgstr "\"Teach me some of the secrets the stars revealed to you!\""

msgid "STORY_EVENT@1122_104@BUTTON_1"
msgstr "\"Having a {EventUnit} [unit/] in my service would benefit my own research!\""

msgid "STORY_EVENT@1122_104@BUTTON_3"
msgstr "\"In return for my aid, I welcome that beautiful {EventItem} [item/] you forged.\""

msgid "STORY_EVENT@1122_104@BUTTON_4"
msgstr "\"I value our stellar friendship over any material reward, my friend.\""

msgid "STORY_EVENT@1122_104@TITLE"
msgstr "Astral Beamforming: Aftermath"

msgid "STORY_EVENT@1122_110@BODY_FOOTER"
msgstr "Will you send a hunting party to {EventHouse} and join their hunt for the elusive Pyreborn {EventStackLeader}?"

msgid "STORY_EVENT@1122_110@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} solemnly greets you. \"Majestic {PlayerLeader}, {EventHouse} cordially invites you to join the Ceremonial Hunt of the Pyreborn {EventStackLeader}.\""

msgid "STORY_EVENT@1122_110@BODY_LORE"
msgstr "\"Once every decade, our finest hunters ride out in search of the Pyreborn {EventStackLeader}. We cull every creature we find and collect the meat for the glory of {EventHouse}, until we finally catch that flame-infused {EventStackLeader}. You would grant us a tremendous honor by joining us.\""

msgid "STORY_EVENT@1122_110@BUTTON_0"
msgstr "\"I am honored to join you.\""

msgid "STORY_EVENT@1122_110@BUTTON_2"
msgstr "\"Unfortunately, I cannot spare any hunters currently. Good hunting!\""

msgid "STORY_EVENT@1122_110@BUTTON_3"
msgstr "\"I will send several hunters [unitprod/] from {EventCity} to join you in my stead.\""

msgid "STORY_EVENT@1122_110@BUTTON_4"
msgstr "\"I will have no part in your cruel rituals! [goodact/]\""

msgid "STORY_EVENT@1122_110@BUTTON_5"
msgstr "\"Your hunt is brutal, not ceremonial. You can celebrate culture without bloodshed.\""

msgid "STORY_EVENT@1122_110@TITLE"
msgstr "The Pyreborn Hunt"

msgid "STORY_EVENT@1122_111@BODY_FOOTER"
msgstr "\"You outmatch us,\" {EventHouseLord} declares. \"As the slayer of our venerable quarry, you are the first to claim your prize.\""

msgid "STORY_EVENT@1122_111@BODY_HEADER"
msgstr "After slaying the Pyreborn {EventAnimal}, you hear the distant horns of {EventHouse}. The Hunt is over!"

msgid "STORY_EVENT@1122_111@BODY_LORE"
msgstr "It is not long before {EventHouseLord.TitleName} approaches you. <<Cp:EventHouseLord>> bows deeply. \"The Pyreborn {EventAnimal} is slain! May the great Hunter {PlayerLeader} usher in glory to our great {EventHouse}!\" The minstrels in the <<G:entourage^n,EventHouseLord>> sing a short ballad of triumph. The Hunters gather every animal killed in the hunt, forming a respectable mountain of game."

msgid "STORY_EVENT@1122_111@BUTTON_0"
msgstr "\"I will claim all the meat [food/] that we collected today.\""

msgid "STORY_EVENT@1122_111@BUTTON_1"
msgstr "\"You may keep the meat, but I will take the pelts [gold/].\""

msgid "STORY_EVENT@1122_111@BUTTON_3"
msgstr "\"Allow me to enlist [unit/] one of your formidable {EventUnit} hunters.\""

msgid "STORY_EVENT@1122_111@BUTTON_4"
msgstr "\"Mounting the head of the {EventAnimal} shall symbolize my Empire's supremacy [influence/].\""

msgid "STORY_EVENT@1122_111@TITLE"
msgstr "The Pyreborn Hunt: Aftermath"

msgid "STORY_EVENT@1122_123@BODY_FOOTER"
msgstr "\"The bad news is, those wretches over in {EventHouse} secretly stashed it in their vaults for ages! We must reclaim it!\""

msgid "STORY_EVENT@1122_123@BODY_HEADER"
msgstr "{EventHero}, your [hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink] requested an urgent audience with you. \"My liege, I have at last located the long-lost {EventItem}!\""

msgid "STORY_EVENT@1122_123@BODY_LORE"
msgstr "\"The legends that surround the {EventItem} inspired me to become an adventurer. The relic's mythos is so entwined with my people's culture! Even today I heard the children of {HeroCity} sing their nursery rhyme: '{EventItem} / all {EventRace} know its name / bakers, butchers, brigadiers / none deny its fame.' For centuries it was lost, but today I discovered its location!\""

msgid "STORY_EVENT@1122_123@BODY_LORE@HERO_RACE_=_PLAY"
msgstr "\"The legends that surround the {EventItem} inspired me to become an adventurer. The relic's mythos is so entwined with our people's culture! Even today I heard the children of {HeroCity} sing their nursery rhyme: '{EventItem} / all {EventRace} know its name / bakers, butchers, brigadiers / none deny its fame.' For centuries it was lost, but today I discovered its location!\""

msgid "STORY_EVENT@1122_123@BUTTON_0"
msgstr "\"We will defeat the tyrants of {TargetHouse} and reclaim {EventItem}!\""

msgid "STORY_EVENT@1122_123@BUTTON_2"
msgstr "\"I will not wage war over your forgotten relic.\""

msgid "STORY_EVENT@1122_123@BUTTON_3"
msgstr "\"You never told me you desire a {EventItem}. Let me replicate it!\""

msgid "STORY_EVENT@1122_123@TITLE"
msgstr "{EventItem}, Reclaimed"

msgid "STORY_EVENT@1122_124@BODY_FOOTER"
msgstr "\"We rightfully possess the {EventItem} once again! The vaults of {TargetHouse} are ours to plunder, {PlayerLeader.TitleName}. What trophy will you claim?\""

msgid "STORY_EVENT@1122_124@BODY_HEADER"
msgstr "After your victory against {TargetHouse}, {EventHero} immediately visits you. \"You vanquished the {TargetRace}! The {EventItem} is finally ours to claim!\""

msgid "STORY_EVENT@1122_124@BODY_LORE"
msgstr "\"I already had some custodians search the city's vaults, my liege. They tell me that the {EventItem} was kept in pristine condition. Moreover, the vault is laden with treasures and relics! Ours for the taking! Let us loot—no—liberate these prizes from the greedy {TargetRace}, my {PlayerLeader.Title}!\" A feverish gleam has settled in <<G:eyes^n,EventHero>>."

msgid "STORY_EVENT@1122_124@BUTTON_0"
msgstr "\"I will take their priceless treasures of gold and silver [gold/].\""

msgid "STORY_EVENT@1122_124@BUTTON_1"
msgstr "\"<<CG:crown jewels^n,TargetHouse>> will decorate my throne hall, elevating its splendor [influence/].\""

msgid "STORY_EVENT@1122_124@BUTTON_3"
msgstr "\"Who desires treasure when the city is ripe with souls [souls/] to harvest! [evilact/]\""

msgid "STORY_EVENT@1122_124@BUTTON_4"
msgstr "\"Reap everything [food/] [gold/] [influence/] they possess. The {TargetRace} shall witness the supremacy of {PlayerLeader.Name} [evilact/].\""

msgid "STORY_EVENT@1122_124@BUTTON_5"
msgstr "\"Reap everything [food/] [gold/] [influence/] [souls/] they possess. The {TargetRace} shall witness the supremacy of {PlayerLeader.Name} [evilact/].\""

msgid "STORY_EVENT@1122_124@TITLE"
msgstr "{EventItem}, Reclaimed: Aftermath"

msgid "STORY_EVENT@1122_127@BODY_FOOTER"
msgstr "{EventHero} frowns. \"I can manufacture Golems, defenders of our homelands. However, building them requires some {EventMaterial}. Could you secure that?\""

msgid "STORY_EVENT@1122_127@BODY_HEADER"
msgstr "\"{PlayerLeader.TitleName}, I urgently request an audience!\" Your [hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink] {EventHero} visits you with a concerned look in <<o:EventHero>> eyes. \"Our defense is lacking.\""

msgid "STORY_EVENT@1122_127@BODY_LORE"
msgstr "\"I arduously serve your ambitions. For you, I venture into the wilderness or invade your rivals' territories.\" {EventHero.FirstName} kneels. \"But now that I've started a family, my priorities have shifted. These days, my mind lingers with my family inside your borders. I've witnessed the ferocity of our enemies' forces. Our realm's protectors cannot withstand them. We need powerful reinforcements.\""

msgid "STORY_EVENT@1122_127@BUTTON_0"
msgstr "\"Golems offer my people extraordinary protection, {EventHero.Name}. I will deliver the {EventMaterial}.\""

msgid "STORY_EVENT@1122_127@BUTTON_2"
msgstr "\"I empathize with you, {EventHero.Name}, yet my priorities lie elsewhere.\""

msgid "STORY_EVENT@1122_127@BUTTON_3"
msgstr "\"You should settle [unit/] in {EventCity}, to protect your family and train troops [unitprod/].\""

msgid "STORY_EVENT@1122_127@TITLE"
msgstr "Hearts of Iron"

msgid "STORY_EVENT@1122_128@BODY_FOOTER"
msgstr "{EventHero.Name} used the {EventMaterial} you found to construct two <<m:EventUnitB>>. <<Cp:EventHero>> gratefully offers you a shield. Will you accept the {EventItem}?"

msgid "STORY_EVENT@1122_128@BODY_HEADER"
msgstr "{EventHero.Name} returns to you, visibly relieved. \"Great news, {PlayerLeader.TitleName}! Now that we have the {EventMaterial}, I've built the Golems!\""

msgid "STORY_EVENT@1122_128@BODY_LORE"
msgstr "\"These <<m:EventUnitB>> can defend your borders now. I can once again embark on journeys of conquest and exploration in your name, liberated from concern and hesitation.\" {EventHero.Name} produces an {EventItem}. \"My eldest <<EventUnit{son/daughter}>> took the leftover {EventMaterial} and made this in the smithy where <<p:EventUnit>> apprentices. Please accept this gift from my family to you.\""

msgid "STORY_EVENT@1122_128@BUTTON_0"
msgstr "\"Have your <<EventUnit{son/daughter}>> equip the shield <<EventUnit{himself/herself}>> and serve me as a {EventUnit}.\""

msgid "STORY_EVENT@1122_128@BUTTON_3"
msgstr "\"Thank you, {EventHero.FirstName}. I will carry the {EventItem} [item/] with pride.\""

msgid "STORY_EVENT@1122_128@BUTTON_4"
msgstr "\"With this {EventItem}, your eldest will protect your family when you're off adventuring [goodact/].\""

msgid "STORY_EVENT@1122_128@BUTTON_5"
msgstr "\"Paint my coat of arms onto the {EventItem}. It will adorn my throne room [influence/].\""

msgid "STORY_EVENT@1122_128@TITLE"
msgstr "Hearts of Iron: Aftermath"

msgid "STORY_EVENT@1122_131@BODY_FOOTER"
msgstr "\"<<Cp:EventKnight>> is a liability, my {PlayerLeader.Title}. Eventually, some travelers visiting {EventStructure} will die. Unless we stop <<P:EventKnight>>.\""

msgid "STORY_EVENT@1122_131@BODY_HEADER"
msgstr "{EventHero}, your [hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink], greets you with a warning: \"Courageous {PlayerLeader.TitleName}, it has come to my attention that a dangerous Silver Knight is attacking travelers!\""

msgid "STORY_EVENT@1122_131@BODY_LORE"
msgstr "\"This tyrannical warrior has declared <<r:EventKnight>> the <<G:sentinel^n,EventStructure>> and stops anyone traveling through. <<Cp:EventKnight>> issues the challenge of defeating <<P:EventKnight>> in close combat. Supposedly, <<p:EventKnight>> is a formidable duelist. No one is able to best <<P:EventKnight>>. I would love to challenge this Knight myself, given the opportunity.\""

msgid "STORY_EVENT@1122_131@BUTTON_0"
msgstr "\"I must find this Silver Knight. And see to <<o:EventKnight>> defeat.\""

msgid "STORY_EVENT@1122_131@BUTTON_2"
msgstr "\"I'm sure this matter will sort out itself eventually.\""

msgid "STORY_EVENT@1122_131@TITLE"
msgstr "The Silver Knight"

msgid "STORY_EVENT@1122_132@BODY_FOOTER"
msgstr "{EventStackLeader} points <<o:EventStackLeader>> blade at {TriggeringStackLeader}, who dislodges the dueling sword. Instantly, the Knight lunges forward to disembowel <<P:TriggeringStackLeader>>. {TriggeringStackLeader}..."

msgid "STORY_EVENT@1122_132@BODY_FOOTER@PLAYERLEADER_=_S"
msgstr "{EventStackLeader} points <<o:EventStackLeader>> blade at you. You dislodge the dueling sword. Instantly, the Knight lunges forward to disembowel you. You..."

msgid "STORY_EVENT@1122_132@BODY_FOOTER@QUESTGIVER_=_STA"
msgstr "{EventStackLeader} points <<o:EventStackLeader>> blade at {TriggeringStackLeader}. {TriggeringStackLeader.FirstName} dislodges the dueling sword after proclaiming: \"I've been waiting for this moment, Silver Knight!\" Immediately, the Knight lunges at {TriggeringStackLeader.FirstName} to disembowel <<P:TriggeringStackLeader>>. {TriggeringStackLeader}..."

msgid "STORY_EVENT@1122_132@BODY_HEADER"
msgstr "{TriggeringStackLeader} finds the Silver Knight still guarding the {EventStructure}. The Knight gestures at a dueling sword lodged in a tree trunk."

msgid "STORY_EVENT@1122_132@BODY_HEADER@PLAYERLEADER_=_S"
msgstr "You find the Silver Knight still guarding the {EventStructure}. The Knight gestures at a dueling sword lodged in a tree trunk."

msgid "STORY_EVENT@1122_132@BODY_LORE"
msgstr "The Silver Knight stands firm, <<o:EventStackLeader>> hands resting on the crossguards of <<o:EventStackLeader>> weapon as <<p:EventStackLeader>> appraises the martial prowess of {TriggeringStackLeader}. A company of howling <<m:EventUnit>> appear from the {GLOBAL.AstralVoidLoreConcept.Hyperlink}, flanking the {EventStackLeader}, their captain. The Knight's voice resounds like a sterling horn: \"You may pass... after you slay me.\" <<Cp:EventStackLeader>> steps forward, inviting {TriggeringStackLeader} to do the same."

msgid "STORY_EVENT@1122_132@BODY_LORE@PLAYERLEADER_=_S"
msgstr "The Silver Knight stands firm, <<o:EventStackLeader>> hands resting on the crossguards of <<o:EventStackLeader>> weapon as <<p:EventStackLeader>> appraises your martial prowess. A company of howling <<m:EventUnit>> appear from the Void, flanking the {EventStackLeader}, their captain. The Knight's voice resounds like a sterling horn: \"You may pass... after you slay me.\" <<Cp:EventStackLeader>> steps forward, inviting you to do the same."

msgid "STORY_EVENT@1122_132@BUTTON_0"
msgstr "... assumes the plow stance to deflect the Knight's tip with <<o:TriggeringStackLeader>> blade and..."

msgid "STORY_EVENT@1122_132@BUTTON_0@PLAYERLEADER_=_S"
msgstr "... assume the plow stance to deflect the Knight's tip with your blade and..."

msgid "STORY_EVENT@1122_132@BUTTON_1"
msgstr "... wrathfully strikes the Knight's blade away with a sudden but decisive swing and..."

msgid "STORY_EVENT@1122_132@BUTTON_1@PLAYERLEADER_=_S"
msgstr "... wrathfully strike the Knight's blade away with a sudden but decisive swing and..."

msgid "STORY_EVENT@1122_132@BUTTON_2"
msgstr "... feints a counterattack, sidesteps while dropping <<o:TriggeringStackLeader>> sword and..."

msgid "STORY_EVENT@1122_132@BUTTON_2@PLAYERLEADER_=_S"
msgstr "... feint a counterattack, sidestep while dropping your sword and..."

msgid "STORY_EVENT@1122_132@BUTTON_3"
msgstr "... tactically retreats to <<o:TriggeringStackLeader>> troops behind <<P:TriggeringStackLeader>>. Prepare for battle!"

msgid "STORY_EVENT@1122_132@BUTTON_3@PLAYERLEADER_=_S"
msgstr "... tactically retreat to your troops behind you. Prepare for battle!"

msgid "STORY_EVENT@1122_132@BUTTON_4"
msgstr "... turns around and flees the {EventStructure}. The Knight and <<o:EventStackLeader>> <<m:EventUnit>> mock <<o:TriggeringStackLeader>> flight."

msgid "STORY_EVENT@1122_132@BUTTON_4@PLAYERLEADER_=_S"
msgstr "... turn around and flee the {EventStructure}. The Knight and <<o:EventStackLeader>> <<m:EventUnit>> mock your flight."

msgid "STORY_EVENT@1122_132@TITLE"
msgstr "Encountering The Silver Knight"

msgid "STORY_EVENT@1122_133@BODY_FOOTER"
msgstr "Today's victory brings glory to the Empire of {PlayerLeader.TitleName}! Just before the Silver Knight explodes into stars, you claim the Knight's..."

msgid "STORY_EVENT@1122_133@BODY_FOOTER@PLAYERLEADER_=_S"
msgstr "Today's victory brings glory to your Empire! Just before the Silver Knight explodes into stars, you claim the Knight's..."

msgid "STORY_EVENT@1122_133@BODY_HEADER"
msgstr "When the {EventKnight} is defeated, he falls to the ground. Dead... but then rises again! The wailing <<m:EventMinion>> disappear."

msgid "STORY_EVENT@1122_133@BODY_LORE"
msgstr "\"Finally, a worthy opponent,\" the Silver Knight declares. \"I salute you. Songs will be sung of your victory today.\" The {EventKnight} flinches. \"Nevertheless, I issue this warning: when I am permitted to return one day, I will seek retribution.\" The Silver Knight clenches his sword's hilt. \"I will now leave this realm. Select one of my armaments as your keepsake.\""

msgid "STORY_EVENT@1122_133@BUTTON_0"
msgstr "...ornate {EventItemA} [item/] as your trophy."

msgid "STORY_EVENT@1122_133@BUTTON_1"
msgstr "...balanced {EventItemB} [item/] as your trophy."

msgid "STORY_EVENT@1122_133@BUTTON_3"
msgstr "...tough {EventItemC} [item/] as your trophy."

msgid "STORY_EVENT@1122_133@BUTTON_4"
msgstr "...supple {EventItemD} [item/] as your trophy."

msgid "STORY_EVENT@1122_133@TITLE"
msgstr "The Silver Knight: Aftermath"

msgid "STORY_EVENT@1122_164@BODY_FOOTER"
msgstr "{EventHouseLord} sighs solemnly. \"You saved my city and people from imminent doom. How can we ever repay you?\""

msgid "STORY_EVENT@1122_164@BODY_HEADER"
msgstr "\"I just received reports from our farmers.\" {EventHouseLord.TitleName} greets you with a grin. \"The siege is over! The terrible <<m:EventUnit>> are eliminated!\""

msgid "STORY_EVENT@1122_164@BODY_LORE"
msgstr "The relieved {EventHouseLord.Title} peers out over the distant lands. \"Over time, we may settle those ravaged lands once more. But I learned my lesson. We should not tamper with the gifts that nature presents to us. We will be more mindful of the risks of our cultivation practices.\""

msgid "STORY_EVENT@1122_164@BUTTON_0"
msgstr "\"Half of your crop yields [food/] sounds fair to me.\""

msgid "STORY_EVENT@1122_164@BUTTON_1"
msgstr "\"Treat {EventCity} [happiness/] to a wagonload of those Haste Berries you created.\""

msgid "STORY_EVENT@1122_164@BUTTON_3"
msgstr "\"Don't tamper with Nature, {EventHouseLord.TitleName}. It already holds all you need to prosper [natureboon/].\""

msgid "STORY_EVENT@1122_164@BUTTON_4"
msgstr "\"I require reinforcements [unitprod/] after taking care of your mess. I expect your support.\""

msgid "STORY_EVENT@1122_164@BUTTON_5"
msgstr "\"Explain to me how you created that new Haste Berry variant [knowledge/]\""

msgid "STORY_EVENT@1122_164@TITLE"
msgstr "Ravenous <<m:EventUnit>>: Aftermath"

msgid "STORY_EVENT@1122_165@BODY_FOOTER"
msgstr "\"The beasts will soon flood our lands! We lack the military might to repel them.\" {EventHouseLord} bows <<o:EventHouseLord>> head. \"{PlayerLeader.Title}. Please. Help!\""

msgid "STORY_EVENT@1122_165@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of {EventHouse} contacts you wide-eyed and panicked! \"Mighty {PlayerLeader.TitleName}, I beg you, save our people from an infestation of <<m:EventUnit>>!\""

msgid "STORY_EVENT@1122_165@BODY_LORE"
msgstr "We were elated when we cultivated a new Haste Berry variety. Extra plump and juice significantly sweeter than the original kind that grows in the fields and forests. We delighted in the fruity nectars that its blossoms secrete. But that same cursed perfume lured the ravenous {EventUnit} horde!\""

msgid "STORY_EVENT@1122_165@BUTTON_0"
msgstr "\"Leave it to me. My mighty forces will destroy the {EventSpawner}!\""

msgid "STORY_EVENT@1122_165@BUTTON_2"
msgstr "\"You created this situation, {EventHouseLord.Title}. Saving your people is your responsibility.\""

msgid "STORY_EVENT@1122_165@BUTTON_3"
msgstr "\"You require a better army. My trainers [unitprod/] are at your service.\""

msgid "STORY_EVENT@1122_165@BUTTON_4"
msgstr "\"You are unfit to rule, {EventHouseLord.TitleName}. Your people deserve a capable governor!\""

msgid "STORY_EVENT@1122_165@TITLE"
msgstr "Ravenous <<m:EventUnit>>"

msgid "STORY_EVENT@1122_197@BODY_FOOTER"
msgstr "The nearby {RandomWarriorTitle} seek to cast you into the light. They deserve to be subjected to your terrible power."

msgid "STORY_EVENT@1122_197@BODY_HEADER"
msgstr "Tales of your dealings with {GLOBAL.ShadowConcept} travel far. A company of stalwart paladins proclaim they will overthrow you."

msgid "STORY_EVENT@1122_197@BODY_LORE"
msgstr "The zealous {RandomWarriorTitle} of the {RandomIdol} are ever eager to vanquish a manifestation of Shadow in their realm. The company, led by a {EventStackLeader}, does not even care to what degree you actually pose a threat to the lands and its peoples. You are simply a means to bring honor and titles to their names."

msgid "STORY_EVENT@1122_197@BUTTON_0"
msgstr "\"They are welcome in my domain of darkness. Welcome to die.\""

msgid "STORY_EVENT@1122_197@BUTTON_1"
msgstr "\"As if these zealous fools could navigate my realm of shadow. Ignore them.\""

msgid "STORY_EVENT@1122_197@BUTTON_2"
msgstr "\"Gilded trinkets [gold/] shall convince their {EventStackLeader} commander to join [unit/] my army [shadowcrisis/].\""

msgid "STORY_EVENT@1122_197@TITLE"
msgstr "Devouring the Light"

msgid "STORY_EVENT@1122_198@BODY_FOOTER"
msgstr "All that is left to do now is decide how to utilize the dying bodies of the overconfident zealots."

msgid "STORY_EVENT@1122_198@BODY_HEADER"
msgstr "The {RandomWarriorTitle} of the {RandomIdol} proved no match for your dark power and lay mortally wounded at your troops' feet."

msgid "STORY_EVENT@1122_198@BODY_LORE"
msgstr "You ensured that not all paladins were killed outright, thinking ahead as your cunning mind is wont to do. Fresh bodies and {GLOBAL.SoulsLoreConcept.Hyperlink} are burdensome to acquire, so when lambs lead themselves to the slaughter, you make efficient use of the opportunity. The symphony of death rattles that rises from the motionless bodies is a testament of your success."

msgid "STORY_EVENT@1122_198@BUTTON_0"
msgstr "Feed [food/] them to the unholy followers at {EventCity}."

msgid "STORY_EVENT@1122_198@BUTTON_1"
msgstr "Tease out the secrets [knowledge/] from their dying brains."

msgid "STORY_EVENT@1122_198@BUTTON_3"
msgstr "Quickly harvest their souls [souls/] before they enter the afterlife."

msgid "STORY_EVENT@1122_198@BUTTON_4"
msgstr "Raise some {RandomWarriorTitle} to serve you as <<m:EventUnit>> [unit/]."

msgid "STORY_EVENT@1122_198@TITLE"
msgstr "Devouring the Light: Aftermath"

msgid "STORY_EVENT@1122_223@BODY_FOOTER"
msgstr "{EventHero} intends to mirror the generosity you display. However, <<p:EventHero>> will be spending your gold."

msgid "STORY_EVENT@1122_223@BODY_FOOTER@NO_GOVERNOR"
msgstr "The people of {EventCity} intend to mirror the generosity you display. However, {EventCity} will be spending your gold."

msgid "STORY_EVENT@1122_223@BODY_HEADER"
msgstr "Your advisors mention that {EventCity} announced costly plans to import food. You contact your <<G:governor^n,EventCity>>, {EventHero}."

msgid "STORY_EVENT@1122_223@BODY_HEADER@NO_GOVERNOR"
msgstr "Your advisors mention that {EventCity} announced costly plans to import food. You contact the city."

msgid "STORY_EVENT@1122_223@BODY_LORE"
msgstr "{EventHero} welcomes you in a good mood. \"I know what you mean to discuss, my {PlayerLeader.Title}. And you can be proud. Following your [hyperlink,GLOBAL.AlignmentConcept]benevolent[/hyperlink] decrees, I declared the importation of ample meats and produce for the hungry citizens of {EventCity}! The best part? The city is paying for it all!\""

msgid "STORY_EVENT@1122_223@BODY_LORE@NO_GOVERNOR"
msgstr "An administrator of {EventCity} welcomes you in a good mood. \"I know what you mean to discuss, my {PlayerLeader.Title}. And you can be proud. Following your benevolent decrees, {EventCity} declared the importation of ample meats and produce for our hungry citizens! The best part? The city is paying for it all!\""

msgid "STORY_EVENT@1122_223@BUTTON_0"
msgstr "Approve the plans [food/]. Gold [gold/] doesn't buy happiness [happiness/]."

msgid "STORY_EVENT@1122_223@BUTTON_1"
msgstr "Spend even more funds [gold/] of {EventCity} on food [food/] [goodact/]!"

msgid "STORY_EVENT@1122_223@BUTTON_2"
msgstr "Forbid it. {EventCity} must conform to your decrees [happiness/]."

msgid "STORY_EVENT@1122_223@BUTTON_3"
msgstr "\"Without collective contributions [gold/] from dutiful citizens, our empire cannot expand.\""

msgid "STORY_EVENT@1122_223@BUTTON_4"
msgstr "Tax {EventCity} more [gold/] instead. This is your realm [evilact/]!"

msgid "STORY_EVENT@1122_223@TITLE"
msgstr "The Greater Good"

msgid "STORY_EVENT@1122_224@BODY_FOOTER"
msgstr "\"We wish to settle near {EventCity}.\" The citizens of {EventCity} famously distrust people from {EventHouse}."

msgid "STORY_EVENT@1122_224@BODY_HEADER"
msgstr "An emissary representing a group of refugees from the free city of {EventHouse} approaches you."

msgid "STORY_EVENT@1122_224@BODY_LORE"
msgstr "\"Good tidings to you, O [hyperlink,GLOBAL.AlignmentConcept]Merciful[/hyperlink] {PlayerLeader.Title}! We have fled our birth city of {EventHouse}, freeing ourselves from the cruel yoke of {EventHouseLord.TitleName}.\" The emissary kneels before you. \"Since we could not bear living there any longer, we seek asylum in your beautiful lands, among your compassionate people.\""

msgid "STORY_EVENT@1122_224@BUTTON_0"
msgstr "Build [structureprod/] a hamlet for the refugees [goodact/], away from {EventCity}."

msgid "STORY_EVENT@1122_224@BUTTON_1"
msgstr "Defy {EventHouse} [goodact/]. Migrate the refugees into {EventCity} [population/], despite protests [happiness/]."

msgid "STORY_EVENT@1122_224@BUTTON_2"
msgstr "Send the refugees away [evilact/]. Their troubles cannot inconvenience {EventCity} [happiness/]."

msgid "STORY_EVENT@1122_224@BUTTON_3"
msgstr "Remove <<G:memories^p,EventHouseLord>> of the refugees, thus setting them free [goodact/].\""

msgid "STORY_EVENT@1122_224@BUTTON_4"
msgstr "Message {EventHouseLord} to sell [gold/] <<P:EventHouseLord>> the refugees' location. [evilact/]"

msgid "STORY_EVENT@1122_224@TITLE"
msgstr "Safe Haven"

msgid "STORY_EVENT@1122_225@BODY_FOOTER"
msgstr "\"It is high time we express our appreciation,\" proclaims {EventHouseLord.FirstName}. \"Choose whatever boon we can muster.\""

msgid "STORY_EVENT@1122_225@BODY_HEADER"
msgstr "Your allies have all convened to honor your [hyperlink,GLOBAL.AlignmentConcept]benevolent[/hyperlink] contributions to the realm."

msgid "STORY_EVENT@1122_225@BODY_LORE"
msgstr "{EventHouseLord.TitleName} of {EventHouse} leads the assembly. \"Gracious {PlayerLeader.Title}, a singular purpose drives our gathering. Everyone here benefited from one of your favors, good deeds, or supportive acts. Indeed, some of us would have fallen to those serving evil, had you been any less selfless and heroic.\" Your allies bow before you in unison."

msgid "STORY_EVENT@1122_225@BUTTON_0"
msgstr "\"Have your best commanders train [unitprod/] my troops in {EventCity}.\""

msgid "STORY_EVENT@1122_225@BUTTON_1"
msgstr "\"Grant me three of your <<m:EventUnit>> [unit/].\""

msgid "STORY_EVENT@1122_225@BUTTON_2"
msgstr "\"Teach me a mystic secret that improves my governing abilities.\""

msgid "STORY_EVENT@1122_225@BUTTON_3"
msgstr "\"Present me your insights into statecraft [influence/].\""

msgid "STORY_EVENT@1122_225@BUTTON_4"
msgstr "\"My friends, our friendship is its own reward!\""

msgid "STORY_EVENT@1122_225@TITLE"
msgstr "To Those Who Wait"

msgid "STORY_EVENT@1122_226@BODY_FOOTER"
msgstr "As your warriors start stomping on the traders, you consider their actions. Are they merely echoing your leadership?"

msgid "STORY_EVENT@1122_226@BODY_HEADER"
msgstr "Some of your <<m:EventUnit>> reportedly captured travelers peddling petty wares. Your warriors prove to be cruel prisoner guards."

msgid "STORY_EVENT@1122_226@BODY_LORE"
msgstr "Desperate, the captured traders yank their fetters and beg their captors for release. Upon seeing your arrival, they throw themselves to the ground to grovel. One of your <<m:EventUnit>> chuckles and shouts: \"You think our {PlayerLeader.Title} will save you? <<Cp:PlayerLeader>> has done more [hyperlink,GLOBAL.AlignmentConcept]heinous[/hyperlink] things to better men than you!\""

msgid "STORY_EVENT@1122_226@BUTTON_0"
msgstr "Put the traders in the pillories for <<G:entertainment^n,EventCity>> [happiness/]."

msgid "STORY_EVENT@1122_226@BUTTON_1"
msgstr "Encourage [morale/] your <<m:EventUnit>> to kick the traders harder [evilact/]"

msgid "STORY_EVENT@1122_226@BUTTON_2"
msgstr "Sell [gold/] the pitiful traders to foreign slavers [evilact/]."

msgid "STORY_EVENT@1122_226@BUTTON_3"
msgstr "Sacrifice [evilact/] the captured traders to extract their souls [souls/]."

msgid "STORY_EVENT@1122_226@BUTTON_4"
msgstr "Free [goodact/] the traders and compensate them for their maltreatment [gold/]."

msgid "STORY_EVENT@1122_226@TITLE"
msgstr "Sins of the {PlayerLeader.Title}"

msgid "STORY_EVENT@1122_227@BODY_FOOTER"
msgstr "\"To cleanse these lands of your presence, we declare WAR on you!\" The herald awaits your response with disdain."

msgid "STORY_EVENT@1122_227@BODY_HEADER"
msgstr "An obnoxious herald from the free city of {EventHouse} interrupts your [hyperlink,GLOBAL.AlignmentConcept]dark[/hyperlink] thoughts, here to deliver a message from his {EventHouseLord.Title}."

msgid "STORY_EVENT@1122_227@BODY_LORE"
msgstr "The messenger clears his throat: \"The People of {EventHouse} and their {EventHouseLord.Title} renounce you, O despicable {PlayerLeader.TitleName}. We rise up against your evil dominion. May we conquer your throne city, raze your towns, and exterminate your evil minions... for the good and benefit of the entire realm!\""

msgid "STORY_EVENT@1122_227@BUTTON_0"
msgstr "Prepare your guards for battle [morale/]. The herald returns to {EventHouse}."

msgid "STORY_EVENT@1122_227@BUTTON_1"
msgstr "Vow [influence/] that you will destroy {EventHouse}."

msgid "STORY_EVENT@1122_227@BUTTON_2"
msgstr "Send the messenger's head to {EventHouse} as your reply."

msgid "STORY_EVENT@1122_227@BUTTON_3"
msgstr "Pay [gold/] a tribute [influence/] to {EventHouseLord.TitleName} to avert the war."

msgid "STORY_EVENT@1122_227@TITLE"
msgstr "Breaking the Dawn"

msgid "STORY_EVENT@1122_228@BODY_FOOTER"
msgstr "Your elected sacrifice will grow your power. But what receptacle will be the target of your malice?"

msgid "STORY_EVENT@1122_228@BODY_HEADER"
msgstr "You embody [hyperlink,GLOBAL.AlignmentConcept]malignance[/hyperlink]. Yet your insatiable ambition has you working on your next scheme already."

msgid "STORY_EVENT@1122_228@BODY_LORE"
msgstr "Kings dread uttering your name. Mothers warn their naughty children about you. But it is not enough. You recently learned of ancient Prime Evils, who have cast the longest and darkest shadows in history. They bound their malice to animals, objects, even servants. A heinous ritual that demands great sacrifice."

msgid "STORY_EVENT@1122_228@BUTTON_0"
msgstr "[nature/] Spawn a terrible {EventMount} [mount/] from your wicked blood."

msgid "STORY_EVENT@1122_228@BUTTON_1"
msgstr "[matter/] Forge a precious {EventItem} [item/] into which you pour your malevolence."

msgid "STORY_EVENT@1122_228@BUTTON_2"
msgstr "[arcana/] Devour the very essence of magic [mana/] to gain eldritch power."

msgid "STORY_EVENT@1122_228@BUTTON_3"
msgstr "Feed [population/] your evil with the chaotic energy of {EventCity} [chaosboon/]."

msgid "STORY_EVENT@1122_228@BUTTON_4"
msgstr "Burn [population/] your obedient subjects in {EventCity} for your tyrannical malevolence [orderboon/]."

msgid "STORY_EVENT@1122_228@BUTTON_5"
msgstr "[shadow/] Anoint [souls/] a {EventUnit} [unit/] to be your Herald of Terror!"

msgid "STORY_EVENT@1122_228@BUTTON_6"
msgstr "Augment {EventHeroMin.FirstName}, your Dread Master, with the blood of <<G:young^n,EventCity>> [unitprod/]."

msgid "STORY_EVENT@1122_228@BUTTON_7"
msgstr "Sacrifice [unit/] {EventHeroMin.FirstName} the Pathetic to make {EventHeroMax.FirstName} your Champion of Malice."

msgid "STORY_EVENT@1122_228@BUTTON_8"
msgstr "Consume [unit/] {EventHeroMin.FirstName} the Pathetic to enhance your own power."

msgid "STORY_EVENT@1122_228@BUTTON_9"
msgstr "Do nothing. Your evil is already unsurpassable."

msgid "STORY_EVENT@1122_228@TITLE"
msgstr "Prime Evil"

msgid "STORY_EVENT@1122_229@BODY_FOOTER"
msgstr "The traveler shivers; <<o:EventHero>> demise imminent. <<Cp:EventHero>> whispers: \"Please, help. I am {EventHero}, <<EventHero{son/daughter}>> of {EventHouseLord}\". How will you act?"

msgid "STORY_EVENT@1122_229@BODY_HEADER"
msgstr "A traveler calls for your help. <<Cp:EventHero>> was beaten and left for dead. <<Co:EventHero>> accent betrays <<o:EventHero>> {EventHouse} origin."

msgid "STORY_EVENT@1122_229@BODY_LORE"
msgstr "The {EventHouseLord.Title} of {EventHouse}, {EventHouseLord.Name}, and you are at war. It seems this traveler was caught on the road by your warriors, and promptly mishandled."

msgid "STORY_EVENT@1122_229@BUTTON_0"
msgstr "Hire [gold/] physicians from {EventCity} [unitprod/] to save <<G:life^n,EventHero>> [goodact/]."

msgid "STORY_EVENT@1122_229@BUTTON_1"
msgstr "Nurse [food/] your enemy's <<EventHero{son/daughter}>> back to health [goodact/] as prisoner."

msgid "STORY_EVENT@1122_229@BUTTON_2"
msgstr "Ignore {EventHero} [evilact/]. Your minions eventually bring in <<o:EventHero>> cold body."

msgid "STORY_EVENT@1122_229@BUTTON_3"
msgstr "Decapitate [evilact/] {EventHero} and send <<o:EventHero>> head back to {EventHouseLord} [morale/]."

msgid "STORY_EVENT@1122_229@TITLE"
msgstr "True Colors"

msgid "STORY_EVENT@1122_233@BODY_FOOTER"
msgstr "Whatever the future holds, {EnemyPlayerLeader} is a thorn in your side no more. How will you commemorate this extraordinary victory?"

msgid "STORY_EVENT@1122_233@BODY_HEADER"
msgstr "You have crumbled the last defenses of {EnemyPlayerLeader} and cast <<P:EnemyPlayerLeader>> into the {GLOBAL.AstralVoidLoreConcept.Hyperlink}, banishing <<P:EnemyPlayerLeader>> from this realm."

msgid "STORY_EVENT@1122_233@BODY_LORE"
msgstr "Whatever schemes {EnemyPlayerLeader} had in the works, none of them shall come to fruition. The last of <<o:EnemyPlayerLeader>> misguided troops flee to hide in the hills and woods. <<Co:EnemyPlayerLeader>> {EventRace}, their spirits crushed by their false idol's yoke, now find themselves at your mercy, O glorious {PlayerLeader.Title}!"

msgid "STORY_EVENT@1122_233@BUTTON_0"
msgstr "Hold a parade to celebrate your triumph [influence/]! Spare no expense [gold/]!"

msgid "STORY_EVENT@1122_233@BUTTON_1"
msgstr "Manipulate [evilact/] the fading zeal [order/] of {EnemyPlayerLeader} to conjure divine gold [gold/]."

msgid "STORY_EVENT@1122_233@BUTTON_2"
msgstr "Tap into [evilact/] the fading bloodthirst [chaos/] of {EnemyPlayerLeader} to grow your warband [unitprod/]."

msgid "STORY_EVENT@1122_233@BUTTON_3"
msgstr "Solidify [evilact/] the fading magical attunement [arcana/] of {EnemyPlayerLeader} into mana crystals [mana/]."

msgid "STORY_EVENT@1122_233@BUTTON_4"
msgstr "Apply [evilact/] the fading craftsmanship [matter/] of {EnemyPlayerLeader} to make {EventCity} rise high [structureprod/]."

msgid "STORY_EVENT@1122_233@BUTTON_5"
msgstr "Siphon [evilact/] the fading fertility [nature/] of {EnemyPlayerLeader} to increase the harvest [food/]."

msgid "STORY_EVENT@1122_233@BUTTON_6"
msgstr "Extract [evilact/] the fading secrets [shadow/] of {EnemyPlayerLeader} to learn unspeakable lore [knowledge/]."

msgid "STORY_EVENT@1122_233@BUTTON_7"
msgstr "Spiritually guide [mana/] {EnemyPlayerLeader} to Magehaven [goodact/]."

msgid "STORY_EVENT@1122_233@BUTTON_8"
msgstr "Let the moment pass. {EnemyPlayerLeader} was just a minor inconvenience to you."

msgid "STORY_EVENT@1122_233@TITLE"
msgstr "Celebrating the defeat of {EnemyPlayerLeader}"

msgid "STORY_EVENT@1122_235@BODY_FOOTER"
msgstr "The people of {EventHouseB.Name} offer aid for gold in your war against {EventHouse.Name}."

msgid "STORY_EVENT@1122_235@BODY_HEADER"
msgstr "{EventHouseBLord.TitleName} of {EventHouseB.Name} offers <<o:EventHouseBLord>> aid during your war with {EventHouse.Name}."

msgid "STORY_EVENT@1122_235@BODY_LORE"
msgstr "\"War is truly a trying time, great {PlayerLeader.Name}, is it not? We humbly, and with only the tiniest vestige of self-interest, offer you what aid we have available. For an equally humble price, of course.\""

msgid "STORY_EVENT@1122_235@BUTTON_0"
msgstr "Buy [gold/] troops [unit/] from {EventHouseB.Name}."

msgid "STORY_EVENT@1122_235@BUTTON_1"
msgstr "\"You will voluntarily aid [unit/] us, in honor [influence/] of my majesty.\""

msgid "STORY_EVENT@1122_235@BUTTON_2"
msgstr "Reject their offer."

msgid "STORY_EVENT@1122_235@TITLE"
msgstr "Wartime Profiteer"

msgid "STORY_EVENT@1122_236@BODY_FOOTER"
msgstr "\"What say you? Will you concede defeat and bring peace to our kingdoms?\""

msgid "STORY_EVENT@1122_236@BODY_HEADER"
msgstr "Your enemy, {EventHouseLord.TitleName} of {EventHouse.Name}, smugly offers a chance of surrender."

msgid "STORY_EVENT@1122_236@BODY_LORE"
msgstr "\"War is a terrible thing, {PlayerLeader.Name}, doubly so when you lose it! My troops are closing in on your city. You have done well, but perhaps it is time to end this. Let us spare our people further bloodshed.\""

msgid "STORY_EVENT@1122_236@BUTTON_0"
msgstr "\"I... concede.\" [influence/]"

msgid "STORY_EVENT@1122_236@BUTTON_1"
msgstr "\"Concede? We have not yet BEGUN to fight!\""

msgid "STORY_EVENT@1122_236@BUTTON_2"
msgstr "\"Losing? I was just waiting for the corpses to pile up!\""

msgid "STORY_EVENT@1122_236@BUTTON_3"
msgstr "\"I shall call upon the land to aid its true master!\""

msgid "STORY_EVENT@1122_236@TITLE"
msgstr "One Last Chance"

msgid "STORY_EVENT@1122_237@BODY_FOOTER"
msgstr "\"Please end this war with {EventHouseBLord}. Otherwise... well, this mediation attempt has fulfilled my duty.\""

msgid "STORY_EVENT@1122_237@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of {EventHouse.Name} approaches, an air of tired exasperation about <<P:EventHouseLord>>."

msgid "STORY_EVENT@1122_237@BODY_LORE"
msgstr "\"I crave a humble boon, mighty {PlayerLeader.Name}. You war with {EventHouseBLord.Name} of {EventHouseB}, who happens to be my bumbling <<EventHouseBLord{brother/sister}>>-in-law... Do not ask, 'tis a strange tale. {EventHouseB} is unlikely to win against a {PlayerLeader.Title} like yourself. Even if it does, theirs will be heavy losses. Our family honor dictates that I attempt to save my <<EventHouseBLord{brother/sister}>>-in-law.\""

msgid "STORY_EVENT@1122_237@BUTTON_0"
msgstr "\"Nay. But your family will soon have one less bumbling fool!\""

msgid "STORY_EVENT@1122_237@BUTTON_1"
msgstr "\"Not a very heartfelt entreaty. But you moved me nonetheless. [goodact/]\""

msgid "STORY_EVENT@1122_237@BUTTON_2"
msgstr "\"I shall become famous [influence/] for vanquishing your entire family! [evilact/]\""

msgid "STORY_EVENT@1122_237@TITLE"
msgstr "Familial Obligation"

msgid "STORY_EVENT@1122_238@BODY_FOOTER"
msgstr "\"As one Ruler to another... surrender! I beg you...\""

msgid "STORY_EVENT@1122_238@BODY_HEADER"
msgstr "Your enemy, {EventHouseLord.TitleName} of {EventHouse.Name}, approaches. A thin veneer of pride fails to hide <<o:EventHouseLord>> obvious desperation."

msgid "STORY_EVENT@1122_238@BODY_LORE"
msgstr "\"{PlayerLeader.Name}, we're at war. It could go either way. For you, mighty {PlayerLeader.Title}, this would be just another notch on your war-table. For me, it would mean more. In truth, I fear that my subjects are losing faith in me as their {EventHouseLord.Title}. In our culture, this has... lethal consequences!\""

msgid "STORY_EVENT@1122_238@BUTTON_0"
msgstr "\"No. Return and put your affairs in order.\""

msgid "STORY_EVENT@1122_238@BUTTON_1"
msgstr "\"This war is trivial to me. Very well. Claim your victory. [goodact/]\""

msgid "STORY_EVENT@1122_238@BUTTON_2"
msgstr "\"Naturally... after you sweeten the deal [gold/].\""

msgid "STORY_EVENT@1122_238@BUTTON_3"
msgstr "\"You're pathetic [influence/]. And all of {EventHouse} will know. [morale/]\""

msgid "STORY_EVENT@1122_238@TITLE"
msgstr "Surrender! Please?"

msgid "STORY_EVENT@1122_240@BODY_FOOTER"
msgstr "\"My {PlayerLeader.Title}, your saga needs to include who you were before becoming a {GLOBAL.GodirLoreConcept.Hyperlink}.\" What can you tell the scribe?"

msgid "STORY_EVENT@1122_240@BODY_HEADER"
msgstr "\"My {PlayerLeader.Title}? Do you remember?\" The young scribe's words startled you, as you recollect your former life."

msgid "STORY_EVENT@1122_240@BODY_LORE"
msgstr "His straightforward question makes your mind regress to simpler times. Back when you were mortal, dreaming modest dreams, pursuing mundane ambitions. To ascend, you've had to sacrifice so many worldly attachments. Sacrifices that caused you to stop looking back. That caused you to forget. Only vague memories of what you were before linger."

msgid "STORY_EVENT@1122_240@BUTTON_0"
msgstr "\"[matter/] I built bulwarks [structureprod/] to protect us from invading Wizard Kings!\""

msgid "STORY_EVENT@1122_240@BUTTON_1"
msgstr "\"[nature/] I peacefully raised a family [population/] when the Wizard Kings invaded.\""

msgid "STORY_EVENT@1122_240@BUTTON_2"
msgstr "\"[chaos/] I stirred my tribe [unitprod/] to raid the invading Wizard Kings!\""

msgid "STORY_EVENT@1122_240@BUTTON_3"
msgstr "\"[order/] I defended [influence/] my vassals against the invading Wizard Kings.\""

msgid "STORY_EVENT@1122_240@BUTTON_4"
msgstr "\"[arcana/] I drew power [mana/] from the invading Wizard Kings' Astral attunement."

msgid "STORY_EVENT@1122_240@BUTTON_5"
msgstr "\"[shadow/] I repelled invading Wizard Kings using serfs [unitprod/] and dark lore [knowledge/].\""

msgid "STORY_EVENT@1122_240@BUTTON_6"
msgstr "\"I unified all peoples under one banner. Mine [unit/].\""

msgid "STORY_EVENT@1122_240@BUTTON_7"
msgstr "\"I surveyed fertile lands in which our tribe thrived [food/].\""

msgid "STORY_EVENT@1122_240@BUTTON_8"
msgstr "\"I was a student of obscure lore [knowledge/].\""

msgid "STORY_EVENT@1122_240@BUTTON_9"
msgstr "\"I was a peacemaker, befriending [happiness/] all peoples living in our realm.\""

msgid "STORY_EVENT@1122_240@TITLE"
msgstr "Humble Origins"

msgid "STORY_EVENT@1122_241@BODY_FOOTER"
msgstr "In the darkness, you had but one thing to hold on to, a piece of who you were before. What memory preserved your sanity?"

msgid "STORY_EVENT@1122_241@BODY_HEADER"
msgstr "As a {GLOBAL.WizardKingLoreConcept.Hyperlink}, you have seen the {GLOBAL.AstralVoidLoreConcept.Hyperlink}, and memories of it haunt you. Even now, you find your mind drifting back."

msgid "STORY_EVENT@1122_241@BODY_LORE"
msgstr "You are [hyperlink,GLOBAL.ShadowTrialLoreConcept]haunted[/hyperlink] by lonesome centuries spent floating in the vast nothingness of the Void, where monstrous voices from your past twisted and distorted your deepest convictions. You saw visions of a grim future riddled by loss and insanity. More than once you felt your soul dissolve in the endless void."

msgid "STORY_EVENT@1122_241@BUTTON_0"
msgstr "\"I founded empires [influence/] that impressed Wizards and Kings!\""

msgid "STORY_EVENT@1122_241@BUTTON_1"
msgstr "\"I mastered the forbidden and lost lore [knowledge/]!\""

msgid "STORY_EVENT@1122_241@BUTTON_2"
msgstr "\"[order/] I commanded legions of fervent paladins [unit/]!\""

msgid "STORY_EVENT@1122_241@BUTTON_3"
msgstr "\"[chaos/] I spawned [population/] a host of savage minions!\""

msgid "STORY_EVENT@1122_241@BUTTON_4"
msgstr "\"[arcana/] I was an artist of the arcane [mana/]!\""

msgid "STORY_EVENT@1122_241@BUTTON_5"
msgstr "\"[matter/] I crafted unparalleled treasures [gold/] envied by dragons.\""

msgid "STORY_EVENT@1122_241@BUTTON_6"
msgstr "\"[nature/] I tended both plant and beast, and savored their bounties [food/].\""

msgid "STORY_EVENT@1122_241@BUTTON_7"
msgstr "\"[shadow/] I endlessly reshaped [unitprod/] my subjects in the shadows!\""

msgid "STORY_EVENT@1122_241@BUTTON_8"
msgstr "\"Feeble mortals reveled [happiness/] in my splendor!\""

msgid "STORY_EVENT@1122_241@BUTTON_9"
msgstr "\"I erected [structureprod/] Wizard Towers in infinite realms!\""

msgid "STORY_EVENT@1122_241@TITLE"
msgstr "Echoes from the Void"

msgid "STORY_EVENT@1122_242@BODY_FOOTER"
msgstr "The {EventRace} of {EventCity} have gather in great numbers to hail their new {PlayerLeader.Title}."

msgid "STORY_EVENT@1122_242@BODY_HEADER"
msgstr "{EventCity} has grown convinced that only you lead the way to glory, O {PlayerLeader.Title}. Its {EventRace} join your empire."

msgid "STORY_EVENT@1122_242@BODY_LORE"
msgstr "From this day onward, you guide <<g:development^n,EventCity>>. Its {EventRace} merrily produce whatever you request and settle on the provinces you prefer. You may assign one of your [hyperlink,GLOBAL.HeroConcept]Heroes[/hyperlink] as its {GLOBAL.GovernorConcept} to change the effectiveness of your resource production. Lastly, the city depends on you to defend bountiful {EventCity} when pillagers appear."

msgid "STORY_EVENT@1122_242@BUTTON_0"
msgstr "Inspect {EventCity}."

msgid "STORY_EVENT@1122_242@BUTTON_1"
msgstr "Instruct {EventCity} on how to govern itself."

msgid "STORY_EVENT@1122_242@BUTTON_2"
msgstr "\"Welcome to my empire.\""

msgid "STORY_EVENT@1122_242@TITLE"
msgstr "Your empire welcomes {EventCity}"

msgid "STORY_EVENT@1122_243@BODY_FOOTER"
msgstr "You must do better against your rivals than the fallen {DefeatedPlayer.Title} could."

msgid "STORY_EVENT@1122_243@BODY_HEADER"
msgstr "A gust of rumors thunders through the realm. \"{DefeatedPlayer} has been defeated! <<Co:DefeatedPlayer>> empire lies in ruins!\""

msgid "STORY_EVENT@1122_243@BODY_LORE"
msgstr "For better or worse, the banishment of {DefeatedPlayer.TitleName} left a vacuum in this world. Fortunately, vacuum and opportunity are the same in the affairs of {GLOBAL.GodirLoreConcept.Hyperlink}."

msgid "STORY_EVENT@1122_243@BUTTON_0"
msgstr "Send the forsaken {DefeatedRace} some alms [gold/] out of sympathy [goodact/]."

msgid "STORY_EVENT@1122_243@BUTTON_1"
msgstr "Confiscate the gold [gold/] of <<g:population^n,DefeatedPlayer>> as they flee [evilact/]."

msgid "STORY_EVENT@1122_243@BUTTON_2"
msgstr "\"It was only a matter of time.\""

msgid "STORY_EVENT@1122_243@TITLE"
msgstr "{DefeatedPlayer} banished to the Void"

msgid "STORY_EVENT@1122_244@BODY_FOOTER"
msgstr "A warrior of {EventHouse.Name} inquires about your army's intentions within their domain."

msgid "STORY_EVENT@1122_244@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "A warrior of {EventHouse.Name} inquires about your intentions within their domain."

msgid "STORY_EVENT@1122_244@BODY_HEADER"
msgstr "A group of hardened warriors steps out of the shadows around {EventStructure.Name}."

msgid "STORY_EVENT@1122_244@BODY_LORE"
msgstr "\"Hail, traveler. You journey through the lands of {EventHouse.Name}. These lands are ours by right of blood and ashes, claimed over ages of turmoil. By what right, and for what reason, do you cross our borders?\""

msgid "STORY_EVENT@1122_244@BUTTON_1"
msgstr "\"We seek audience with your leader, {EventHouseLord.TitleName}.\""

msgid "STORY_EVENT@1122_244@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"I seek audience with your leader, {EventHouseLord.TitleName}.\""

msgid "STORY_EVENT@1122_244@BUTTON_2"
msgstr "\"By the right, and reason, of conquest! Prepare yourselves!\""

msgid "STORY_EVENT@1122_244@BUTTON_3"
msgstr "\"Peace, warrior. We mean you no harm.\""

msgid "STORY_EVENT@1122_244@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "\"Peace, warrior. I mean you no harm.\""

msgid "STORY_EVENT@1122_244@TITLE"
msgstr "Ancestral Lands"

msgid "STORY_EVENT@1122_245@BODY_FOOTER"
msgstr "Following a chime, the hovering globe of light awaits your response."

msgid "STORY_EVENT@1122_245@BODY_HEADER"
msgstr "As your army arrives at {EventStructure.Name}, a strange, translucent globe rises from the ground. A hollow voice issues forth."

msgid "STORY_EVENT@1122_245@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "As you arrive at {EventStructure.Name}, a strange, translucent globe rises from the ground. A hollow voice issues forth."

msgid "STORY_EVENT@1122_245@BODY_LORE"
msgstr "\"Welcome to the lands of {EventHouse.Name}. {EventHouseLord.TitleName} requests the nature of your intent at this location. Please leave your answer after the chime. Note that incorrect answers may lead to the summoning of nearby guardians.\""

msgid "STORY_EVENT@1122_245@BUTTON_1"
msgstr "\"We actually wish to talk with {EventHouseLord.TitleName}.\""

msgid "STORY_EVENT@1122_245@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"I actually wish to talk with {EventHouseLord.TitleName}.\""

msgid "STORY_EVENT@1122_245@BUTTON_2"
msgstr "\"Summon your guardians, globe. We are here to fight!\""

msgid "STORY_EVENT@1122_245@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "\"Summon your guardians, globe. I am here to fight!\""

msgid "STORY_EVENT@1122_245@BUTTON_3"
msgstr "\"Inform {EventHouseLord.TitleName} that we are merely passing through.\""

msgid "STORY_EVENT@1122_245@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "\"Inform {EventHouseLord.TitleName} that I am merely passing through.\""

msgid "STORY_EVENT@1122_245@TITLE"
msgstr "The Messenger"

msgid "STORY_EVENT@1122_246@BODY_FOOTER"
msgstr "After a chime, silence... Pulsing light from the globe lends an eerie atmosphere as it waits."

msgid "STORY_EVENT@1122_246@BODY_HEADER"
msgstr "A translucent globe, pulsing a sinister color, rises from the ground and speaks to your army in hollow tones."

msgid "STORY_EVENT@1122_246@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "A translucent globe, pulsing a sinister color, rises from the ground and speaks to your army in hollow tones."

msgid "STORY_EVENT@1122_246@BODY_LORE"
msgstr "\"You trespass upon the lands of {EventHouse.Name}. {EventHouseLord.TitleName} has summoned guardians to this location. You may leave your answer after the chime.\""

msgid "STORY_EVENT@1122_246@BUTTON_1"
msgstr "\"We would have words with {EventHouseLord.TitleName}.\""

msgid "STORY_EVENT@1122_246@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"I would have words with {EventHouseLord.TitleName}.\""

msgid "STORY_EVENT@1122_246@BUTTON_2"
msgstr "Draw your weapons and await the guardians..."

msgid "STORY_EVENT@1122_246@BUTTON_3"
msgstr "Say nothing and walk away."

msgid "STORY_EVENT@1122_246@TITLE"
msgstr "The Menacing Messenger"

msgid "STORY_EVENT@1122_247@BODY_FOOTER"
msgstr "The stony faced {EventStackLeader.Name} rests their hand on their weapon, awaiting your answer."

msgid "STORY_EVENT@1122_247@BODY_HEADER"
msgstr "Your army is met by a troop of armed barbarians as it approaches the {EventStructure.Name}."

msgid "STORY_EVENT@1122_247@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "You are met by a troop of armed barbarians as you approach the {EventStructure.Name}."

msgid "STORY_EVENT@1122_247@BODY_LORE"
msgstr "\"Hail, {EventHero}. You are known to us, and unwelcome here. Yet {EventHouse.Name} offers you a gift. The gift is this warning. Remain here, and you shall face our wrath.\""

msgid "STORY_EVENT@1122_247@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "\"Hail, {PlayerLeader.TitleName}. You are known to us, and unwelcome here. Yet {EventHouse.Name} offers you a gift. The gift is this warning. Remain here, and you shall face our wrath.\""

msgid "STORY_EVENT@1122_247@BUTTON_1"
msgstr "\"Peace, warrior. We seek to parlay with your {EventHouseLord.Title}.\""

msgid "STORY_EVENT@1122_247@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"Peace, warrior. I seek to parlay with your {EventHouseLord.Title}.\""

msgid "STORY_EVENT@1122_247@BUTTON_2"
msgstr "\"Your challenge is accepted. To arms!\""

msgid "STORY_EVENT@1122_247@BUTTON_3"
msgstr "\"Rest easy, {EventStackLeader}. We seek no quarrel and will take our leave.\""

msgid "STORY_EVENT@1122_247@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "\"Rest easy, {EventStackLeader}. I seek no quarrel and will take my leave.\""

msgid "STORY_EVENT@1122_247@TITLE"
msgstr "A Gifted Warning"

msgid "STORY_EVENT@1122_248@BODY_FOOTER"
msgstr "The {EventStackLeader}, intent seemingly made clear, awaits your response."

msgid "STORY_EVENT@1122_248@BODY_HEADER"
msgstr "A stoic, grim looking {EventStackLeader}, blocks your army's path to {EventStructure.Name}."

msgid "STORY_EVENT@1122_248@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "A stoic, grim looking {EventStackLeader}, blocks your path to {EventStructure.Name}."

msgid "STORY_EVENT@1122_248@BODY_LORE"
msgstr "\"The {EventStackLeader} speaks no word but rises when you approach. Several armed men and women lounge nearby, watching <<P:EventStackLeader>>. As your army draws closer the {EventStackLeader} raises <<o:EventStackLeader>> hand. You note the lounging guards stand to attention."

msgid "STORY_EVENT@1122_248@BUTTON_1"
msgstr "\"Peace, good <<EventStackLeader{Sir/Dame}>>. We seek an audience with your {EventHouseLord.Title}.\""

msgid "STORY_EVENT@1122_248@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"Peace, good <<EventStackLeader{Sir/Dame}>>. I seek an audience with your {EventHouseLord.Title}.\""

msgid "STORY_EVENT@1122_248@BUTTON_2"
msgstr "Saying nothing, advance and draw your weapons."

msgid "STORY_EVENT@1122_248@BUTTON_3"
msgstr "Saying nothing, move away."

msgid "STORY_EVENT@1122_248@TITLE"
msgstr "Silent Knight"

msgid "STORY_EVENT@1122_249@BODY_FOOTER"
msgstr "The {EventStackLeader} glares, hand on the hilt of <<o:EventStackLeader>> weapon, awaiting your response."

msgid "STORY_EVENT@1122_249@BODY_HEADER"
msgstr "As your army approaches {EventStructure.Name}, they are accosted by an angry looking {EventStackLeader} with a number of troops."

msgid "STORY_EVENT@1122_249@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "As you approach {EventStructure.Name}, you are accosted by an angry looking {EventStackLeader} with a number of troops."

msgid "STORY_EVENT@1122_249@BODY_LORE"
msgstr "\"You have much nerve, approaching the lands of {EventHouse.Name}. {EventHouseLord.TitleName} has made clear their feelings for your kingdom. My wrath shall be tempered by my code for but a moment. You are afforded one chance of making yourself scarce.\""

msgid "STORY_EVENT@1122_249@BUTTON_1"
msgstr "\"We seek an audience with your {EventHouseLord.Title}.\""

msgid "STORY_EVENT@1122_249@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"I seek an audience with your {EventHouseLord.Title}.\""

msgid "STORY_EVENT@1122_249@BUTTON_2"
msgstr "\"Stow your code. Draw your weapon!\""

msgid "STORY_EVENT@1122_249@BUTTON_3"
msgstr "\"We seek no quarrel this day. Farewell...\""

msgid "STORY_EVENT@1122_249@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "\"I seek no quarrel this day. Farewell...\""

msgid "STORY_EVENT@1122_249@TITLE"
msgstr "A Stormy Knight"

msgid "STORY_EVENT@1122_250@BODY_FOOTER"
msgstr "{EventHero} notes troops of {EventHouse.Name} awaiting <<o:EventHero>> answer to the skeletal apparition."

msgid "STORY_EVENT@1122_250@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "You note troops of {EventHouse.Name} awaiting your answer to the skeletal apparition."

msgid "STORY_EVENT@1122_250@BODY_HEADER"
msgstr "A small pile of mismatched bones animates and addresses your troops as they approach {EventStructure.Name}."

msgid "STORY_EVENT@1122_250@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "A small pile of mismatched bones animates and addresses you as you approach {EventStructure.Name}."

msgid "STORY_EVENT@1122_250@BODY_LORE"
msgstr "The skeletal messenger, composed of broken, moss eaten bones and resembling some sort of spider more than a person, reaches up a skeletal hand to turn its grinning skull toward {EventHero}. With a hollow voice, resembling a crypt lid dragging open, it asks, \"Whhy dooo yoou trespassss?\""

msgid "STORY_EVENT@1122_250@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "The skeletal messenger, composed of broken, moss eaten bones and resembling some sort of spider more than a person, reaches up a skeletal hand to turn its grinning skull toward you. With a hollow voice, resembling a crypt lid dragging open, it asks, \"Whhy dooo yoou trespassss?\""

msgid "STORY_EVENT@1122_250@BUTTON_1"
msgstr "\"I would have words with your <<EventHouseLord{master/mistress}>>.\""

msgid "STORY_EVENT@1122_250@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"I would have words with your <<EventHouseLord{master/mistress}>>.\""

msgid "STORY_EVENT@1122_250@BUTTON_2"
msgstr "\"Slay them all!\""

msgid "STORY_EVENT@1122_250@BUTTON_3"
msgstr "\"This is too strange... we walk away!\""

msgid "STORY_EVENT@1122_250@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "\"This is too strange... I'll walk away!\""

msgid "STORY_EVENT@1122_250@TITLE"
msgstr "Message from Beyond"

msgid "STORY_EVENT@1122_251@BODY_FOOTER"
msgstr "The shadows sway, edging closer, giving your army a very small window to respond."

msgid "STORY_EVENT@1122_251@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "The shadows sway, edging closer, giving you a very small window to respond."

msgid "STORY_EVENT@1122_251@BODY_HEADER"
msgstr "As your troops approach {EventStructure.Name}, the shadows seem to lengthen and surround them."

msgid "STORY_EVENT@1122_251@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "As you approach {EventStructure.Name}, the shadows seem to lengthen and surround you."

msgid "STORY_EVENT@1122_251@BODY_LORE"
msgstr "The shadows grow limbs and glowing eyes. When they speak, they sound like the hissing of a thousand snakes. \"{EventHouseLord.TitleName} has declared you an enemy of {EventHouse.Name}. Leave this place or perish. Guardiansss have been sssummoned. \""

msgid "STORY_EVENT@1122_251@BUTTON_1"
msgstr "\"Summon your <<EventHouseLord{master/mistress}>>, shadow. We would speak to <<P:EventHouseLord>>.\""

msgid "STORY_EVENT@1122_251@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"Summon your <<EventHouseLord{master/mistress}>>, shadow. I would speak to <<P:EventHouseLord>>.\""

msgid "STORY_EVENT@1122_251@BUTTON_2"
msgstr "\"It is you who shall perish... To arms!\""

msgid "STORY_EVENT@1122_251@BUTTON_3"
msgstr "\"Remain in the darkness, shadow. We go...\""

msgid "STORY_EVENT@1122_251@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "\"Remain in the darkness, shadow. I will go...\""

msgid "STORY_EVENT@1122_251@TITLE"
msgstr "Shadowy Sentinels"

msgid "STORY_EVENT@1122_252@BODY_FOOTER"
msgstr "\"I hope that your reasons are peaceful. It would be a shame to debase yourself by behaving otherwise.\""

msgid "STORY_EVENT@1122_252@BODY_HEADER"
msgstr "Your troops see a group of troops from {EventHouse.Name} feasting upon fine foods, engaged in deep philosophical discussions."

msgid "STORY_EVENT@1122_252@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "You see a group of troops from {EventHouse.Name} feasting upon fine foods, engaged in deep philosophical discussions."

msgid "STORY_EVENT@1122_252@BODY_LORE"
msgstr "\"Ah, {EventHero.Name}, it is lovely to see you. Please, feast upon our food and drink. Join our salon. You are welcome in our lands.\" The {EventStackLeader} beams and gently gestures toward his compatriots. \"But I must ask... what brings you here today? You were not scheduled to meet with {EventHouseLord.TitleName} or the people of {EventHouse.Name}.\""

msgid "STORY_EVENT@1122_252@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "\"Ah, {PlayerLeader.TitleName}, it is lovely to see you. Please, feast upon our food and drink. Join our salon. You are welcome in our lands.\" The {EventStack.Leader} beams and gently gestures toward his compatriots.\" But I must ask... what brings you here today? You were not scheduled to meet with {EventHouseLord.TitleName} or the people of {EventHouse.Name}.\""

msgid "STORY_EVENT@1122_252@BUTTON_1"
msgstr "\"Peace, yes. We wish to converse with {EventHouseLord.TitleName}.\""

msgid "STORY_EVENT@1122_252@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"Peace, yes. I wish to converse with {EventHouseLord.TitleName}.\""

msgid "STORY_EVENT@1122_252@BUTTON_2"
msgstr "\"Alas for you. This party shall be your last. Die!\""

msgid "STORY_EVENT@1122_252@BUTTON_3"
msgstr "\"Enjoy your revels. We'll be moving on.\""

msgid "STORY_EVENT@1122_252@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "\"Enjoy your revels. I'll be moving on.\""

msgid "STORY_EVENT@1122_252@TITLE"
msgstr "High Society"

msgid "STORY_EVENT@1122_253@BODY_FOOTER"
msgstr "\"Shall we discuss things like civilized folk, or will you disappoint— yet not surprise—us by choosing violence?\""

msgid "STORY_EVENT@1122_253@BODY_HEADER"
msgstr "An {EventStackLeader} of {EventHouse.Name} stands over his army, imposing. <<Cp:EventStackLeader>> notices your army and regards them with disdain, rolling <<o:EventStackLeader>> eyes."

msgid "STORY_EVENT@1122_253@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "An {EventStackLeader} of {EventHouse.Name} stands over his army, imposing. <<Cp:EventStackLeader>> notices you and regards you with disdain, rolling <<o:EventStackLeader>> eyes."

msgid "STORY_EVENT@1122_253@BODY_LORE"
msgstr "\"I see that you mongrels have finally made your way into our borders,\" sighs the {EventStackLeader}. \"Though all my senses cringe at your presence, I admit I am impressed that you managed to stumble your way toward {EventHouse.Name}.\""

msgid "STORY_EVENT@1122_253@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "\"I see that your mongrels have finally made their way into our borders,\" sighs the {EventStack.Leader}. \"Though all my sensitivities cringe at your presence, I admit I am impressed that you managed to stumble your way toward {EventHouseCity.Name}.\""

msgid "STORY_EVENT@1122_253@BUTTON_1"
msgstr "\"We are civilized. Fetch your {EventHouseLord.Title}... please.\""

msgid "STORY_EVENT@1122_253@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"I am civilized. Fetch your {EventHouseLord.Title}... please.\""

msgid "STORY_EVENT@1122_253@BUTTON_2"
msgstr "\"We choose violence!\""

msgid "STORY_EVENT@1122_253@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "\"I choose violence!\""

msgid "STORY_EVENT@1122_253@BUTTON_3"
msgstr "\"Neither. We are merely passing through.\""

msgid "STORY_EVENT@1122_253@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "\"Neither. I'm merely passing through.\""

msgid "STORY_EVENT@1122_253@TITLE"
msgstr "Begone, Plebeian"

msgid "STORY_EVENT@1122_254@BODY_FOOTER"
msgstr "\"If you wish to discuss things with {EventHouse.Name}, I will have one of my troops alert {EventHouseLord} immediately.\""

msgid "STORY_EVENT@1122_254@BODY_HEADER"
msgstr "Troops from {EventHouse.Name} appear to be mining the {EventStructure.Name} for materials."

msgid "STORY_EVENT@1122_254@BODY_LORE"
msgstr "The troops are working so diligently on their tasks that they barely register your approach. After a few minutes watching their efficiency, their overseer, an {EventStackLeader} finally notices your army. \"My apologies for the wait, {EventHero.Name}. We tend to dive headfirst into our work here in {EventHouse.Name}. Frankly, I do not wish to step away for too long.\""

msgid "STORY_EVENT@1122_254@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "The troops are working so diligently on their tasks that they barely register your approach. After a few minutes watching their efficiency, their overseer, an {EventStackLeader} finally notices you. \"My apologies for the wait, {PlayerLeader.TitleName}. We tend to dive headfirst into our work here in {EventHouse.Name}. Frankly, I do not wish to step away for too long.\""

msgid "STORY_EVENT@1122_254@BUTTON_1"
msgstr "\"Yes, please. We would speak with {EventHouseLord}.\""

msgid "STORY_EVENT@1122_254@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"Yes, please. I would speak with {EventHouseLord}.\""

msgid "STORY_EVENT@1122_254@BUTTON_2"
msgstr "\"You'll now be busy fighting for your lives!\""

msgid "STORY_EVENT@1122_254@BUTTON_3"
msgstr "\"Carry on with your work. We're just passing by.\""

msgid "STORY_EVENT@1122_254@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "\"Carry on with your work. I'm just passing by.\""

msgid "STORY_EVENT@1122_254@TITLE"
msgstr "Busy Bees"

msgid "STORY_EVENT@1122_255@BODY_FOOTER"
msgstr "\"You had better have distracted us for a good reason.\""

msgid "STORY_EVENT@1122_255@BODY_HEADER"
msgstr "The soldiers of {EventHouse.Name}, who'd been excavating the {EventStructure.Name}, grind their work to a halt. They now glare at you."

msgid "STORY_EVENT@1122_255@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "The soldiers of {EventHouse.Name}, who'd been excavating the {EventStructure.Name}, grind their work to a halt. They now glare at your troops."

msgid "STORY_EVENT@1122_255@BODY_LORE"
msgstr "An {EventStackLeader} approaches, hands on hips, and groans a sigh. \"Can you not see that we are a bit busy here? Your unwelcome intrusion could cost me multiple hours of productivity.\""

msgid "STORY_EVENT@1122_255@BUTTON_1"
msgstr "\"We are certain that speaking to {EventHouseLord} counts as a good reason.\""

msgid "STORY_EVENT@1122_255@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"I am certain that speaking to {EventHouseLord} counts as a good reason.\""

msgid "STORY_EVENT@1122_255@BUTTON_2"
msgstr "\"This break is, in fact, your last. Die!\""

msgid "STORY_EVENT@1122_255@BUTTON_3"
msgstr "Let them return to work."

msgid "STORY_EVENT@1122_255@TITLE"
msgstr "Hey, I'm Working Here!"

msgid "STORY_EVENT@1122_256@BODY_FOOTER"
msgstr "{EventStackLeader.Name} watches {EventHero.FirstName} impatiently. \"Well? What is it to be? I am eager to conclude our hunt!\""

msgid "STORY_EVENT@1122_256@BODY_HEADER"
msgstr "A lesser noble and <<o:EventStackLeader>> retinue almost fail to notice your army, so intent are they on stalking something within the {EventStructure.Name}."

msgid "STORY_EVENT@1122_256@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "A lesser noble and their retinue almost fail to notice you, so intent are they on stalking something within the {EventStructure.Name}."

msgid "STORY_EVENT@1122_256@BODY_LORE"
msgstr "{EventStackLeader.Name} approaches {EventHero.Name} and speaks in hushed tones. \"Well met! We believe we have cornered a most glorious beast here, a most elusive {RandomAnimal}! I would ask that you leave and allow us what is surely to be a delightful kill for {EventHouse.Name}!\""

msgid "STORY_EVENT@1122_256@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "{EventStackLeader.Name} approaches you and speaks in hushed tones. \"Well met! We believe we have cornered a most glorious beast here, a most elusive {RandomAnimal}! I would ask that you leave and allow us what is surely to be a delightful kill for {EventHouse.Name}!\""

msgid "STORY_EVENT@1122_256@BUTTON_1"
msgstr "\"Leave this site and collect venison from {EventCity} [food/] as compensation.\""

msgid "STORY_EVENT@1122_256@BUTTON_2"
msgstr "\"The noble {RandomAnimal} is under my own protection. Leave this place now!\""

msgid "STORY_EVENT@1122_256@BUTTON_3"
msgstr "Weave an illusion. \"Look yonder! The beast flees that way!\""

msgid "STORY_EVENT@1122_256@BUTTON_4"
msgstr "\"Today the penalty for poaching is death!\""

msgid "STORY_EVENT@1122_256@BUTTON_5"
msgstr "\"I have no time for your petty distractions. Farewell!\""

msgid "STORY_EVENT@1122_256@TITLE"
msgstr "The Prey"

msgid "STORY_EVENT@1122_260@BODY_FOOTER"
msgstr "The {EventStackLeader} smiles again. \"You seem like a connoisseur. Interested in buying our work? \""

msgid "STORY_EVENT@1122_260@BODY_HEADER"
msgstr "Troops of {EventHouse.Name} are gathered around the {EventStructure}, wielding what look like balls of light."

msgid "STORY_EVENT@1122_260@BODY_LORE"
msgstr "The orbs are actually swirls of artistic magic. They form colorful, glowing figurines. A {EventStackLeader.Name} notices <<G:gaze^n,EventHero>>, and grins. \"Masterpieces, are they not? With magic, we have freed these spirits from the {EventStructure} to shape statuettes. Does our work not impress you?\""

msgid "STORY_EVENT@1122_260@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "The orbs are actually swirls of artistic magic. They form colorful, glowing figurines. A {EventStackLeader.Name} notices your gaze, and grins. \"Masterpieces, are they not? With magic, we have freed these spirits from the {EventStructure} to shape statuettes. Does our work not impress you?\""

msgid "STORY_EVENT@1122_260@BUTTON_1"
msgstr "\"We shall purchase [gold/] your art if you leave this place.\""

msgid "STORY_EVENT@1122_260@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"I shall purchase [gold/] your art if you leave this place.\""

msgid "STORY_EVENT@1122_260@BUTTON_2"
msgstr "\"If we can create better, you must abandon the {EventStructure}.\""

msgid "STORY_EVENT@1122_260@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "\"If I can create better, you must abandon the {EventStructure}.\""

msgid "STORY_EVENT@1122_260@BUTTON_4"
msgstr "\"We will break your masterpieces, and your resolve!\""

msgid "STORY_EVENT@1122_260@BUTTON_4@HERO_IS_PLAYERLE"
msgstr "\"I will break your masterpieces, and your resolve!\""

msgid "STORY_EVENT@1122_260@BUTTON_5"
msgstr "Let them continue shaping their strange little dolls."

msgid "STORY_EVENT@1122_260@TITLE"
msgstr "Supernatural Statuettes"

msgid "STORY_EVENT@1122_261@BODY_FOOTER"
msgstr "\"Until we've raised enough undead workers,\" mutters the {EventStackLeader}, \"we are required to remain here.\""

msgid "STORY_EVENT@1122_261@BODY_HEADER"
msgstr "Your troops approach an {EventStructure}, greeted by a chorus of chants from a legion of {EventHouse}."

msgid "STORY_EVENT@1122_261@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "You approach an {EventStructure}, greeted by a chorus of chants from a legion of {EventHouse}."

msgid "STORY_EVENT@1122_261@BODY_LORE"
msgstr "{EventHero.Name} witnesses dozens of skeletons reanimating to the tune of the army's incantation. \"More workers for {EventHouse},\" their commander, a {EventStackLeader}, groans. \"We'd abandon this location for you, but my people rely on the labor force provided by the bones beneath this land.\""

msgid "STORY_EVENT@1122_261@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "You witness dozens of skeletons reanimating to the tune of the army's incantation. \"More workers for {EventHouse},\" their commander, a {EventStackLeader}, groans. \"We'd abandon this location for you, but my people rely on the labor force provided by the bones beneath this land.\""

msgid "STORY_EVENT@1122_261@BUTTON_1"
msgstr "\"Leave now and we will send laborers from {EventCity}.\""

msgid "STORY_EVENT@1122_261@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"Leave now and I will send laborers from {EventCity}.\""

msgid "STORY_EVENT@1122_261@BUTTON_3"
msgstr "\"How about we raise these dead for you?\""

msgid "STORY_EVENT@1122_261@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "\"How about I raise these dead for you?\""

msgid "STORY_EVENT@1122_261@BUTTON_4"
msgstr "\"You will pay for this vile desecration!\""

msgid "STORY_EVENT@1122_261@BUTTON_5"
msgstr "\"Carry on. We want no involvement.\""

msgid "STORY_EVENT@1122_261@BUTTON_5@HERO_IS_PLAYERLE"
msgstr "\"Carry on. I want no involvement.\""

msgid "STORY_EVENT@1122_261@TITLE"
msgstr "Worked to Death"

msgid "STORY_EVENT@1122_262@BODY_FOOTER"
msgstr "\"Roll for your life, {EventHero.Name}. If you win, we will disappear. If you lose... Well...\""

msgid "STORY_EVENT@1122_262@BODY_HEADER"
msgstr "Slimy rapscallions from {EventHouse.Name} are playing a game of dice at a {EventStructure} you approach."

msgid "STORY_EVENT@1122_262@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Slimy rapscallions from {EventHouse.Name} are playing a game of dice at a {EventStructure} your troops approach."

msgid "STORY_EVENT@1122_262@BODY_LORE"
msgstr "A {EventStackLeader} looks down at the fresh corpse of a {RandomUnit}, using <<o:EventStackLeader>> sleeve to clean the poor sod's blood off <<o:EventStackLeader>> dagger. <<Cp:EventStackLeader>> snarls when <<p:EventStackLeader>> notices {EventHero}. Then, <<p:EventStackLeader>> gestures at a bloody set of bone dice. <<Co:EventStackLeader>> scalawag crew cackles in anticipation."

msgid "STORY_EVENT@1122_262@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "A {EventStackLeader} looks down at the fresh corpse of a {RandomUnit}, using <<o:EventStackLeader>> sleeve to clean the poor sod's blood off <<o:EventStackLeader>> dagger. <<Cp:EventStackLeader>> snarls when <<p:EventStackLeader>> notices you. Then, <<p:EventStackLeader>> gestures at a bloody set of bone dice. <<Co:EventStackLeader>> scalawag crew cackles in anticipation."

msgid "STORY_EVENT@1122_262@BUTTON_1"
msgstr "\"Why gamble when you just hit the jackpot [gold/]. Now leave!\""

msgid "STORY_EVENT@1122_262@BUTTON_3"
msgstr "Manipulate the dice to win."

msgid "STORY_EVENT@1122_262@BUTTON_4"
msgstr "\"I fear your luck has run out!\""

msgid "STORY_EVENT@1122_262@BUTTON_5"
msgstr "\"I'm not pushing my luck today.\""

msgid "STORY_EVENT@1122_262@BUTTON_6"
msgstr "Chaos is your ally. Roll the dice."

msgid "STORY_EVENT@1122_262@TITLE"
msgstr "The Gambler"

msgid "STORY_EVENT@1122_264@BODY_FOOTER"
msgstr "The {EventStackLeader} looks at {EventHero} with exasperation. \"Pardon our... inefficiency. We'll leave this {EventStructure} for you once this is sorted.\""

msgid "STORY_EVENT@1122_264@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "The {EventStackLeader} looks at you with exasperation. \"Pardon our... inefficiency. We'll leave this {EventStructure} for you once this is sorted.\""

msgid "STORY_EVENT@1122_264@BODY_HEADER"
msgstr "Near a {EventStructure}, a coterie from {EventHouse.Name} are holding abacuses and point at the ground while arguing. Loudly."

msgid "STORY_EVENT@1122_264@BODY_LORE"
msgstr "\"Iron is more prevalent in this sector, I assure you,\" shouts one. \"No, you ignoramus. It's clear that there's more gold in this land,\" cries another. \"We'll never get to go home if you two don't stop arguing and focus!\" begs their overseer, an {EventStackLeader}."

msgid "STORY_EVENT@1122_264@BUTTON_1"
msgstr "\"Go. Miners [structureprod/] from {EventCity} will share their findings with you.\""

msgid "STORY_EVENT@1122_264@BUTTON_3"
msgstr "Use your knowledge of metal to settle their argument."

msgid "STORY_EVENT@1122_264@BUTTON_4"
msgstr "\"If it's iron you desire, then taste our sharpened blades!\""

msgid "STORY_EVENT@1122_264@BUTTON_5"
msgstr "\"I may return after you've completed your survey.\""

msgid "STORY_EVENT@1122_264@BUTTON_5@HERO_IS_PLAYERLE"
msgstr "\"I may return when you complete your survey.\""

msgid "STORY_EVENT@1122_264@TITLE"
msgstr "Surveying the Scene"

msgid "STORY_EVENT@1122_265@BODY_FOOTER"
msgstr "The {EventStackLeader} growls at {EventHero}, \"This enchantment I cannot unmake. Help us, and we'll be on our way.\""

msgid "STORY_EVENT@1122_265@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "The {EventStackLeader} growls at you, \"This enchantment I cannot unmake. Help us, and we'll be on our way.\""

msgid "STORY_EVENT@1122_265@BODY_HEADER"
msgstr "Shiny orbs circle the {EventStructure.Name}, refracting light off a hulking machine in the colors of {EventHouse}."

msgid "STORY_EVENT@1122_265@BODY_LORE"
msgstr "\"Can you get it unstuck, or is there just too much mud?\" A laborer from {EventHouse.Name} asks her superior. The {EventStackLeader} shakes <<o:EventStackLeader>> head. \"Mud isn't the problem. That {EventStructure} is! The wicked magic that flows from it has ensnared our excavator! Unless the spell can be tempered, we cannot finish our job!\""

msgid "STORY_EVENT@1122_265@BUTTON_1"
msgstr "\"Our mages [mana/] shall free your equipment.\""

msgid "STORY_EVENT@1122_265@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"My mages [mana/] shall free your equipment.\""

msgid "STORY_EVENT@1122_265@BUTTON_3"
msgstr "\"I shall dispel the enchantment myself.\""

msgid "STORY_EVENT@1122_265@BUTTON_4"
msgstr "\"Ha! Nothing easier to kill than stationary targets!\""

msgid "STORY_EVENT@1122_265@BUTTON_5"
msgstr "Wish them luck and move along."

msgid "STORY_EVENT@1122_265@TITLE"
msgstr "Bogged Down"

msgid "STORY_EVENT@1122_266@BODY_FOOTER"
msgstr "\"State your reason for coming to my {EventStructure},\" {EventHouseLord} asks."

msgid "STORY_EVENT@1122_266@BODY_HEADER"
msgstr "Before you can approach an army from {EventHouse} that occupies a {EventStructure}, its {EventHouseLord.Title}, {EventHouseLord.Name}, contacts you."

msgid "STORY_EVENT@1122_266@BODY_HEADER@STACKLEADER_IS_H"
msgstr "Before {EventHero} can approach an army from {EventHouse} that occupies a {EventStructure}, its {EventHouseLord.Title}, {EventHouseLord.Name}, contacts you."

msgid "STORY_EVENT@1122_266@BODY_LORE"
msgstr "\"What do you want with my <<m:EventStackLeader>>?\" {EventHouseLord.FirstName} warily sizes up your army to assess the situation. \"They guard this {EventStructure} per my orders.\" The <<G:troops^p,EventHouseLord.Title>> nervously observe your exchange and appear ready to attack if necessary."

msgid "STORY_EVENT@1122_266@BUTTON_0"
msgstr "\"My supreme empire now claims this {EventStructure} [influence/].\""

msgid "STORY_EVENT@1122_266@BUTTON_0@STACKLEADER_IS_H"
msgstr "\"<<G:empire^n,PlayerLeader>> now claims this {EventStructure} [influence/].\""

msgid "STORY_EVENT@1122_266@BUTTON_2"
msgstr "Appeal to your good standing [allegiance/] with {EventHouse} to claim the {EventStructure}."

msgid "STORY_EVENT@1122_266@BUTTON_3"
msgstr "Attack the <<m:EventStackLeader>>!"

msgid "STORY_EVENT@1122_266@BUTTON_4"
msgstr "Leave."

msgid "STORY_EVENT@1122_266@TITLE"
msgstr "{EventStackLeader} Guards from {EventHouse}"

msgid "STORY_EVENT@1122_267@BODY_FOOTER"
msgstr "\"I'm fairly certain these are our territorial waters,\" bellows the {EventStackLeader} to {EventHero}. \"I suggest you return to safer shores!\""

msgid "STORY_EVENT@1122_267@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "\"I'm fairly certain these are our territorial waters,\" bellows the {EventStackLeader} to you. \"I suggest you return to safer shores!\""

msgid "STORY_EVENT@1122_267@BODY_HEADER"
msgstr "\"Ahoy!\" Troops from {EventHouse} are scrambled around a {EventStructure} surrounded by deep waters."

msgid "STORY_EVENT@1122_267@BODY_LORE"
msgstr "Afraid of slipping and falling into the tempestuous waves, the regiment clings to the masts of their ships docked around the {EventStructure}. Everyone, except for their leader, a {EventStackLeader}. <<Cp:EventStackLeader>> stands tall, firm, steadfast. An unmovable pillar amid the torrents that seek to engulf <<P:EventStackLeader>>."

msgid "STORY_EVENT@1122_267@BUTTON_1"
msgstr "\"We request parley with {EventHouseLord.TitleName}!\""

msgid "STORY_EVENT@1122_267@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"I request parley with {EventHouseLord.TitleName}!\""

msgid "STORY_EVENT@1122_267@BUTTON_2"
msgstr "\"We will send you to a watery grave!\""

msgid "STORY_EVENT@1122_267@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "\"I will send you to a watery grave!\""

msgid "STORY_EVENT@1122_267@BUTTON_3"
msgstr "Drift away."

msgid "STORY_EVENT@1122_267@TITLE"
msgstr "In Foreign Waters"

msgid "STORY_EVENT@1122_268@BODY_FOOTER"
msgstr "\"You there!\" The {EventStackLeader} laughs and waves. \"Have you come to d-deliver ush more shider? Or arrrr ye our relief?\""

msgid "STORY_EVENT@1122_268@BODY_HEADER"
msgstr "Your army has braved the tides and currents to reach a {EventStructure}... to find troops from {EventHouse} already there!"

msgid "STORY_EVENT@1122_268@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "You've braved the tides and currents to reach a {EventStructure}... to find troops from {EventHouse} already there!"

msgid "STORY_EVENT@1122_268@BODY_LORE"
msgstr "A fleet of empty bottles welcomes {EventHero}, carried by gentle waves. Next, <<p:EventHero>> hears the guards' singing. Finally, <<p:EventHero>> spots the {EventStructure}, remodeled into a makeshift lighthouse. A torn flag of {EventHouse} flies high. Who knows how long these warriors have been stationed here? A {EventStackLeader} veers up and peers through a looking glass."

msgid "STORY_EVENT@1122_268@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "A fleet of empty bottles welcomes you, carried by gentle waves. Next, you hear the guards' singing. Finally, you spot the {EventStructure}, remodeled into a makeshift lighthouse. A torn flag of {EventHouse} flies high. Who knows how long these warriors have been stationed here? A {EventStackLeader} veers up and peers through a looking glass."

msgid "STORY_EVENT@1122_268@BUTTON_1"
msgstr "\"Sail for {EventCity}! They will give you your cider [food/]!\""

msgid "STORY_EVENT@1122_268@BUTTON_3"
msgstr "\"We have come from {EventHouse} to relieve you of duty!\""

msgid "STORY_EVENT@1122_268@BUTTON_4"
msgstr "\"These guards are drunk! Easy pickings for us!\""

msgid "STORY_EVENT@1122_268@BUTTON_5"
msgstr "Leave the guards alone."

msgid "STORY_EVENT@1122_268@TITLE"
msgstr "Prolonged Marooning"

msgid "STORY_EVENT@1122_272@BODY_FOOTER"
msgstr "The {EventRace} of {EventCity} gather to dutifully hear the first orders of their new {PlayerLeader.Title}."

msgid "STORY_EVENT@1122_272@BODY_HEADER"
msgstr "The {EventRace} of {EventCity} have to accept you as their {PlayerLeader.Title} and welcome a new age under your government."

msgid "STORY_EVENT@1122_272@BODY_LORE"
msgstr "From this day onward, you direct <<g:development^n,EventCity>>. Its {EventRace} merrily produce whatever you request and settle on the provinces you prefer. You may assign one of your [hyperlink,GLOBAL.HeroConcept]Heroes[/hyperlink] as its {GLOBAL.GovernorConcept} to change the effectiveness of your resource production. Lastly, the city depends on you to defend bountiful {EventCity} when pillagers appear."

msgid "STORY_EVENT@1122_272@BUTTON_0"
msgstr "Inspect {EventCity}."

msgid "STORY_EVENT@1122_272@BUTTON_1"
msgstr "Instruct {EventCity} on how to govern itself."

msgid "STORY_EVENT@1122_272@BUTTON_2"
msgstr "\"Welcome. I will return some other time.\""

msgid "STORY_EVENT@1122_272@TITLE"
msgstr "{EventCity} joins your Empire"

msgid "STORY_EVENT@1122_273@BODY_FOOTER"
msgstr "The {EventRace} of {EventCity} nervously await the inspection and first commands of their new {PlayerLeader.Title}."

msgid "STORY_EVENT@1122_273@BODY_HEADER"
msgstr "{EventCity} is utterly dysfunctional. Fortunately, most of its {EventRace} citizens cease their protest and recognize you as their {PlayerLeader.Title}."

msgid "STORY_EVENT@1122_273@BODY_LORE"
msgstr "From this day onward, you dictate <<g:development^n,EventCity>>. Its {EventRace} merrily produce whatever you request and settle on the provinces you prefer. You may assign one of your [hyperlink,GLOBAL.HeroConcept]Heroes[/hyperlink] as its {GLOBAL.GovernorConcept} to change the effectiveness of your resource production. Lastly, the city depends on you to defend bountiful {EventCity} when pillagers appear."

msgid "STORY_EVENT@1122_273@BUTTON_0"
msgstr "Inspect {EventCity}."

msgid "STORY_EVENT@1122_273@BUTTON_1"
msgstr "Instruct {EventCity} on how to govern itself."

msgid "STORY_EVENT@1122_273@BUTTON_2"
msgstr "\"Back to work! More important matters demand my attention.\""

msgid "STORY_EVENT@1122_273@TITLE"
msgstr "Your Empire annexes {EventCity}"

msgid "STORY_EVENT@1122_285@BODY_FOOTER"
msgstr "The ambassador bows deeply. \"Will you promise to appease your {EventRace} and vassalize {EventHouse}?\""

msgid "STORY_EVENT@1122_285@BODY_HEADER"
msgstr "An ambassador of the {EventRace} Council approaches you. <<Cp:EventUnit>> has a sheepish smile."

msgid "STORY_EVENT@1122_285@BODY_LORE"
msgstr "\"My {PlayerLeader.Title}. We of the {EventRace} Council discovered that you are interested in strengthening the diplomatic bonds with {EventHouse}. The {EventRace} have a long shared history with the {HouseRace} of {EventHouse}, and we would rejoice if you were to look favorably on them.\""

msgid "STORY_EVENT@1122_285@BUTTON_0"
msgstr "\"Splendid. I intended for them to become my vassal anyway.\""

msgid "STORY_EVENT@1122_285@BUTTON_1"
msgstr "\"Honestly, I'd rather befriend {EventHouse} [allegiance/] than the {EventRace} Council.\""

msgid "STORY_EVENT@1122_285@BUTTON_2"
msgstr "\"Spare me your frivolous requests. Leave me be.\""

msgid "STORY_EVENT@1122_285@TITLE"
msgstr "Kindred Spirits"

msgid "STORY_EVENT@1122_286@BODY_FOOTER"
msgstr "\"Our new vassals are eager to visit our cities. Who among the {HouseRace} should we invite first?\""

msgid "STORY_EVENT@1122_286@BODY_HEADER"
msgstr "Now that your diplomatic bonds with the {HouseRace} of {EventHouse} have developed, the {EventRace} Council ambassador revisits you."

msgid "STORY_EVENT@1122_286@BODY_LORE"
msgstr "\"We knew you wouldn't fail us, my {PlayerLeader.Title}.\" The ambassador's words are accentuated by wide gestures as <<p:EventUnit>> grins from ear to ear. \"We are gladdened to learn that your empire and {EventHouse} celebrate your mutual interests. And so do your {EventRace} and their {HouseRace}. May our people and culture prosper forevermore.\""

msgid "STORY_EVENT@1122_286@BUTTON_0"
msgstr "Invite their citizens to show off our great works and monuments [happiness/]."

msgid "STORY_EVENT@1122_286@BUTTON_1"
msgstr "Invite their traders and merchants [gold/] to visit your cities."

msgid "STORY_EVENT@1122_286@BUTTON_3"
msgstr "Invite their laborers to your cities to increase construction speed [structureprod/]."

msgid "STORY_EVENT@1122_286@TITLE"
msgstr "Kindred Spirits: Aftermath"

msgid "STORY_EVENT@1122_290@BODY_FOOTER"
msgstr "The {EventRace} will panic when they notice that <<m:EventStackLeader>> are nearby! Quickly, O {PlayerLeader.Title}, you must dispatch them!"

msgid "STORY_EVENT@1122_290@BODY_HEADER"
msgstr "A distraught member of the {EventRace} Council requests an urgent meeting."

msgid "STORY_EVENT@1122_290@BODY_LORE"
msgstr "\"Terrible news, my {PlayerLeader.Title}. Our scouts have reported sightings of an army of <<m:EventStackLeader>> roaming our lands! Our forebears told legends of these creatures, that they are bringers of death. And that seeing such a creature heralds 77 years of bad luck. We must drive it away immediately, to prevent unrest in our cities!"

msgid "STORY_EVENT@1122_290@BUTTON_0"
msgstr "\"No need to panic. I will take care of the <<m:EventStackLeader>>.\""

msgid "STORY_EVENT@1122_290@BUTTON_1"
msgstr "\"Educate [knowledge/] yourselves. Witless beliefs of the {EventRace} must be renounced!\""

msgid "STORY_EVENT@1122_290@BUTTON_2"
msgstr "\"I don't have time for your superstitious nonsense.\""

msgid "STORY_EVENT@1122_290@TITLE"
msgstr "Harbingers of Misfortune"

msgid "STORY_EVENT@1122_292@BODY_FOOTER"
msgstr "The <<m:EventStackLeader>> have noticed your troops and prepare to attack. What will you do?"

msgid "STORY_EVENT@1122_292@BODY_HEADER"
msgstr "After a tense search and long march, your army comes face to face with the roaming <<m:EventStackLeader>>."

msgid "STORY_EVENT@1122_292@BODY_LORE"
msgstr "The sight of the terrible creatures causes fear to ripple through the {EventRace} in your army. The deafening silence betrays the hesitation of your troops. Their morale won't hold."

msgid "STORY_EVENT@1122_292@BODY_LORE@NO_RACE_UNITS"
msgstr "\"The howls of the <<m:EventUnit>> do not affect your warriors. In fact, your troops don't understand what the {EventRace} find so frightening about the creatures. Some start to mock the enemy from afar.\""

msgid "STORY_EVENT@1122_292@BUTTON_0"
msgstr "Your soldiers do not fear these <<m:EventStackLeader>>. Attack!"

msgid "STORY_EVENT@1122_292@BUTTON_1"
msgstr "Order your disheartened troops to attack."

msgid "STORY_EVENT@1122_292@BUTTON_3"
msgstr "\"A bounty [gold/] for whoever brings me the head of a {EventStackLeader}!\""

msgid "STORY_EVENT@1122_292@BUTTON_4"
msgstr "Attempt to banish these creatures to whence they came."

msgid "STORY_EVENT@1122_292@BUTTON_5"
msgstr "Attempt to command these creatures to return whence they came."

msgid "STORY_EVENT@1122_292@BUTTON_6"
msgstr "Leave. Now is not the right time to attack."

msgid "STORY_EVENT@1122_292@TITLE"
msgstr "Encountering Harbingers of Misfortune"

msgid "STORY_EVENT@1122_293@BODY_FOOTER"
msgstr "\"The {EventRace} will hear of your victory. Perhaps our superstitious beliefs can be transformed into a virtue of our people?\""

msgid "STORY_EVENT@1122_293@BODY_HEADER"
msgstr "Now that the <<m:EventHarbinger>> are gone from your lands, the {EventRace} Council contacts you again."

msgid "STORY_EVENT@1122_293@BODY_LORE"
msgstr "\"Marvelous work, {PlayerLeader}, just marvelous! We managed to contain any panic with regards to the {EventHarbinger} sightings, so it seems we are in the clear. All thanks to you, of course.\""

msgid "STORY_EVENT@1122_293@BUTTON_0"
msgstr "\"This victory proves that the {EventRace} are true warriors [unitprod/].\""

msgid "STORY_EVENT@1122_293@BUTTON_1"
msgstr "\"This victory signals the luck [happiness/] of the {EventRace}.\""

msgid "STORY_EVENT@1122_293@BUTTON_3"
msgstr "\"This victory shows that the {EventRace} should build [structureprod/] better defenses.\""

msgid "STORY_EVENT@1122_293@BUTTON_4"
msgstr "\"This encounter only illustrates that my empire [influence/] can dominate any foe.\""

msgid "STORY_EVENT@1122_293@TITLE"
msgstr "Harbingers of Misfortune: Aftermath"

msgid "STORY_EVENT@1122_29@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} to you."

msgid "STORY_EVENT@1122_29@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} of {EventHouse.Name} greets you with obvious contempt."

msgid "STORY_EVENT@1122_29@BODY_LORE"
msgstr "\"Greetings, {PlayerLeader.Name}. The values your culture holds could not be any more different from ours, but we hope that you will find some manner of common ground with {EventHouse.Name}. And if not, perhaps we have found a worthy adversary.\""

msgid "STORY_EVENT@1122_29@BUTTON_0"
msgstr "Open discussions with these honorable fools."

msgid "STORY_EVENT@1122_29@BUTTON_2"
msgstr "Leave them to their chivalrous pursuits... for now..."

msgid "STORY_EVENT@1122_29@TITLE"
msgstr "Meeting Chivalrous {EventHouse.Name}"

msgid "STORY_EVENT@1122_2@BODY_FOOTER"
msgstr "\"I will make a better ally than my <<EventHouseLord{father/mother}>>.\" Will you support the scheme of {EventHero.FirstName} to supplant {EventHouseLord.TitleName}?"

msgid "STORY_EVENT@1122_2@BODY_HEADER"
msgstr "You are summoned by {EventHouse}, but you are not greeted by {EventHouseLord.TitleName}. Instead of resuming diplomatic negotiations, <<o:EventHouseLord>> eldest <<EventHero{son/daughter}>> hails you."

msgid "STORY_EVENT@1122_2@BODY_LORE"
msgstr "\"Good day, {PlayerLeader.TitleName}. I am {EventHero.Name} of {EventHouse}. I believe the rule of my <<EventHouseLord{father/mother}>> is failing. Fortunately, I am eager and capable to step in, but I fear that the uhm... 'transition' might prove arduous.\""

msgid "STORY_EVENT@1122_2@BUTTON_0"
msgstr "\"I will help you achieve your bloody ambitions [evilact/]!\""

msgid "STORY_EVENT@1122_2@BUTTON_1"
msgstr "\"Join me [unit/], {EventHero.FirstName}! Why rule a pond when I offer you the ocean?\""

msgid "STORY_EVENT@1122_2@BUTTON_2"
msgstr "\"Join me [unit/], {EventHero.FirstName}! Why rule a pond when I offer you the ocean?\""

msgid "STORY_EVENT@1122_2@BUTTON_3"
msgstr "\"Wake your <<EventHouseLord{father/mother}>>, child! I do not deal with whelps.\""

msgid "STORY_EVENT@1122_2@BUTTON_4"
msgstr "\"Visit me promptly, schemer! I crave your wicked mind's secrets!\""

msgid "STORY_EVENT@1122_2@BUTTON_5"
msgstr "\"Not interested. Deal with this matter on your own.\""

msgid "STORY_EVENT@1122_2@TITLE"
msgstr "Highborn Ambitions"

msgid "STORY_EVENT@1122_304@BODY_FOOTER"
msgstr "The creatures have since developed an appetite for us {EventRace}. We must eliminate these fiends at the source, great {PlayerLeader.Title}."

msgid "STORY_EVENT@1122_304@BODY_HEADER"
msgstr "The {EventRace} Council has called an emergency meeting with you. \"My {PlayerLeader.Title}, we are hunted by <<m:EventStackLeader>>!\""

msgid "STORY_EVENT@1122_304@BODY_LORE"
msgstr "\"We discovered a {EventSpawner} nearby {EventCity}, which was troubling enough in itself. Their incidental attacks on the {EventRace} were bothersome, but manageable. We expect them to destroy property, but could not foresee that they'd devour our kinsfolk!\""

msgid "STORY_EVENT@1122_304@BUTTON_0"
msgstr "\"Consider this threat to your people gone!\""

msgid "STORY_EVENT@1122_304@BUTTON_1"
msgstr "\"Perhaps it is better to invest in your own defense [unitprod/].\""

msgid "STORY_EVENT@1122_304@BUTTON_2"
msgstr "\"This threat of yours does not concern me.\""

msgid "STORY_EVENT@1122_304@TITLE"
msgstr "{EventRace}-sized Morsels"

msgid "STORY_EVENT@1122_305@BODY_FOOTER"
msgstr "The council of the {EventRace} wants to express their gratitude through a festival. What should they celebrate?"

msgid "STORY_EVENT@1122_305@BODY_HEADER"
msgstr "Now that the {EventSpawner} is destroyed, the {EventRace} Council congratulates you on your achievement."

msgid "STORY_EVENT@1122_305@BODY_LORE"
msgstr "\"We are happy to report that the consumption of our people has ended, O {PlayerLeader.Title}! Our kinsfolk are safe from the <<m:EventSpawnerHead>> once again, thanks to you!\""

msgid "STORY_EVENT@1122_305@BUTTON_0"
msgstr "Have a festival of fertility [population/] to replenish your people."

msgid "STORY_EVENT@1122_305@BUTTON_1"
msgstr "Build and rebuild [structureprod/] in honor of the devoured kinsfolk."

msgid "STORY_EVENT@1122_305@BUTTON_3"
msgstr "Celebrate [happiness/] that the <<m:EventSpawnerHead>> no longer threaten their kind."

msgid "STORY_EVENT@1122_305@TITLE"
msgstr "{EventRace}-sized Morsels: Aftermath"

msgid "STORY_EVENT@1122_309@BODY_FOOTER"
msgstr "\"If you support our quest to grow closer to the magic [hyperlink,GLOBAL.AstralFlowsLoreConcept]currents[/hyperlink], we kindly request you construct more [hyperlink,GLOBAL.ConduitConcept][conduit/]Conduits[/hyperlink].\""

msgid "STORY_EVENT@1122_309@BODY_HEADER"
msgstr "A distinguished envoy of the {EventRace} Council appears before you. After the required formalities, <<p:EventUnit>> states <<o:EventUnit>> business."

msgid "STORY_EVENT@1122_309@BODY_LORE"
msgstr "\"Your eminence, you know us {EventRace} as a proud and illustrious people. We seek to elevate ourselves from the worldly muck of this realm.\" The envoy smirks. \"We wish to better understand the ways of magic. Over time, we even might augment our kin with the powerful flows of the {GLOBAL.AstralSeaLoreConcept.Hyperlink}.\""

msgid "STORY_EVENT@1122_309@BUTTON_0"
msgstr "\"I will entertain your request.\""

msgid "STORY_EVENT@1122_309@BUTTON_1"
msgstr "\"I decide what to build on my lands.\""

msgid "STORY_EVENT@1122_309@BUTTON_2"
msgstr "\"Magic doesn't suit you simple {EventRace}. But farming [food/] does!\""

msgid "STORY_EVENT@1122_309@TITLE"
msgstr "Closer to Magic"

msgid "STORY_EVENT@1122_310@BODY_FOOTER"
msgstr "The envoy smirks. \"I expect you desire a token of gratitude. How can the {EventRace} reward your success?\""

msgid "STORY_EVENT@1122_310@BODY_HEADER"
msgstr "After you built the last of the requested [hyperlink,GLOBAL.ConduitConcept][conduit/]Conduits[/hyperlink], the {EventRace} Council envoy returns in a good mood."

msgid "STORY_EVENT@1122_310@BODY_LORE"
msgstr "The envoy extends <<o:EventUnit>> arms as if to further widen the grin on <<o:EventUnit>> face. \"Outstanding work, my {PlayerLeader.Title}. We now have [conduit/] conduits to connect us to the {GLOBAL.AstralFlowsLoreConcept.Hyperlink} all over this realm! We knew we could count on you!\""

msgid "STORY_EVENT@1122_310@BUTTON_0"
msgstr "Let them harvest the crystal discharge [mana/] of the conduits."

msgid "STORY_EVENT@1122_310@BUTTON_1"
msgstr "Let them use the conduits to boost their research [knowledge/]."

msgid "STORY_EVENT@1122_310@BUTTON_3"
msgstr "Let them pay more taxes [gold/], now that their wish is granted."

msgid "STORY_EVENT@1122_310@BUTTON_4"
msgstr "Just let the {EventRace} enjoy their newfound boon [happiness/]."

msgid "STORY_EVENT@1122_310@TITLE"
msgstr "Closer to Magic: Aftermath"

msgid "STORY_EVENT@1122_32@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} to you."

msgid "STORY_EVENT@1122_32@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} of {EventHouse.Name} greets you with an air of pretentious judgment."

msgid "STORY_EVENT@1122_32@BODY_LORE"
msgstr "\"All hail, {PlayerLeader.Name}. Though we do not experiment with death in the way you do, I hope our magical endeavors will help you see that you may have much in common with {EventHouse.Name}.\""

msgid "STORY_EVENT@1122_32@BUTTON_0"
msgstr "Explore a path forward with these enthusiasts of the mystical."

msgid "STORY_EVENT@1122_32@BUTTON_2"
msgstr "Exit their auric sphere for now..."

msgid "STORY_EVENT@1122_32@TITLE"
msgstr "Meeting Mystical {EventHouse.Name}"

msgid "STORY_EVENT@1122_33@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} to you."

msgid "STORY_EVENT@1122_33@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} of {EventHouse.Name} greets you with hesitant curiosity."

msgid "STORY_EVENT@1122_33@BODY_LORE"
msgstr "\"Well met, {PlayerLeader.Name}. Though my instinct is to eradicate you on sight, I do look forward to learning more of your culture and discovering whether you and {EventHouse.Name} may be able to coexist in peace. If not... then we are ready for you.\""

msgid "STORY_EVENT@1122_33@BUTTON_0"
msgstr "Attempt a conversation with these mortal primitives."

msgid "STORY_EVENT@1122_33@BUTTON_2"
msgstr "Take leave of their brutish company for the time being..."

msgid "STORY_EVENT@1122_33@TITLE"
msgstr "Meeting Brutish {EventHouse.Name}"

msgid "STORY_EVENT@1122_35@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} to you."

msgid "STORY_EVENT@1122_35@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} of {EventHouse.Name} greets you with calculated caution."

msgid "STORY_EVENT@1122_35@BODY_LORE"
msgstr "\"Salutations, o {PlayerLeader.Name}. Your power and devotion to the dark arts parallel our passion for progress here in {EventHouse.Name}. We hope that our efficiency and your power may prove a good match.\""

msgid "STORY_EVENT@1122_35@BUTTON_0"
msgstr "Enter into possible negotiations with this enterprising city."

msgid "STORY_EVENT@1122_35@BUTTON_2"
msgstr "Depart from discussions, with the possibility to resume at a later time."

msgid "STORY_EVENT@1122_35@TITLE"
msgstr "Meeting Businesslike {EventHouse.Name}"

msgid "STORY_EVENT@1122_36@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} to you."

msgid "STORY_EVENT@1122_36@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} of {EventHouse.Name} greets you with a sneer of derision."

msgid "STORY_EVENT@1122_36@BODY_LORE"
msgstr "\"Oh, it is you, {PlayerLeader.Name}. Your devotion to honor is... shall we say... somewhat repulsive for my taste. However, {EventHouse.Name} does not wish to offend... at least not immediately. Perhaps we will sort out our differences. Or your legions might eventually join mine in death. I suppose we shall see.\""

msgid "STORY_EVENT@1122_36@BUTTON_0"
msgstr "Explore what paths may await you with these odious necromancers."

msgid "STORY_EVENT@1122_36@BUTTON_2"
msgstr "Leave the presence of these vile creatures as fast as possible."

msgid "STORY_EVENT@1122_36@TITLE"
msgstr "Meeting Disdainful {EventHouse.Name}"

msgid "STORY_EVENT@1122_3@BODY_FOOTER"
msgstr "\"My people favor <<P:EventHero>>, even while I do not! And now <<p:EventHero>> desires to 'prove <<o:EventHero>> quality'. I seek your counsel!\""

msgid "STORY_EVENT@1122_3@BODY_HEADER"
msgstr "As soon as negotiations are concluded for the day, {EventHouseLord.TitleName} of {EventHouse.Name} requests advice concerning <<o:EventHouseLord>> useless youngest <<EventHero{son/daughter}>>."

msgid "STORY_EVENT@1122_3@BODY_LORE"
msgstr "\"{EventHero.FirstName} is so unlike <<o:EventHero>> older <<EventHero{brother/sister}>>,\" the {EventHouseLord.Title} sighs. \"Now, <<Zp:EventHero>> walks with Wizards and Halflings! A true paragon of bravery and courage... Whereas my youngest hides in damp caves and shoots arrows from cover like a coward. And all the while, <<p:EventHero>> thinks <<r:EventHero>> as lordly as a <<EventHero{king/queen}>> of old!\""

msgid "STORY_EVENT@1122_3@BUTTON_0"
msgstr "\"My valorous captains will train [unitprod/] {EventHero.FirstName} in {EventCity} [unit/].\""

msgid "STORY_EVENT@1122_3@BUTTON_1"
msgstr "\"My valorous captains will train [unitprod/] {EventHero.FirstName} in {EventCity} [unit/].\""

msgid "STORY_EVENT@1122_3@BUTTON_2"
msgstr "\"Take my {EventItem} [item/], claim it's cursed and send <<P:EventHero>> off to destroy it!\""

msgid "STORY_EVENT@1122_3@BUTTON_3"
msgstr "\"And yet, your blood runs through <<o:EventHero>> veins. Remember this.\""

msgid "STORY_EVENT@1122_3@BUTTON_4"
msgstr "\"Send {EventHero.FirstName} into battle. <<Cp:EventHero>> wins? Great! <<Cp:EventHero>> dies? Problem solved!\""

msgid "STORY_EVENT@1122_3@BUTTON_5"
msgstr "\"Clearly, <<o:EventHero>> qualities are abundant. You simply fail to see them.\""

msgid "STORY_EVENT@1122_3@TITLE"
msgstr "Favored <<EventHero{son/daughter}>>"

msgid "STORY_EVENT@1122_41@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} to you."

msgid "STORY_EVENT@1122_41@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} of {EventHouse.Name} greets you with an elegant yet mysterious bow."

msgid "STORY_EVENT@1122_41@BODY_LORE"
msgstr "\"Greetings, {PlayerLeader.Name}. We hope that our mystical arts and your morals may be a good match in time. {EventHouse.Name} has learned much of you from our visions, and we are interested in possibly pursuing friendship.\""

msgid "STORY_EVENT@1122_41@BUTTON_0"
msgstr "Commence a conversation with these fascinating sages."

msgid "STORY_EVENT@1122_41@BUTTON_2"
msgstr "Leave these savants to their magic for the time being..."

msgid "STORY_EVENT@1122_41@TITLE"
msgstr "Meeting Metaphysical {EventHouse.Name}"

msgid "STORY_EVENT@1122_42@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} to you."

msgid "STORY_EVENT@1122_42@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} of {EventHouse.Name} greets you with a loud, powerful shout."

msgid "STORY_EVENT@1122_42@BODY_LORE"
msgstr "\"{PlayerLeader.Name}! It is good to meet you. Though you wield strength more subtly than us, I believe we may have much in common. We of {EventHouse.Name} may be rough and ready, and not motivated by glory — but the way we revel in combat is unmatched.\""

msgid "STORY_EVENT@1122_42@BUTTON_0"
msgstr "Attempt to converse with these bestial folk."

msgid "STORY_EVENT@1122_42@BUTTON_2"
msgstr "Leave their primitive presence for now."

msgid "STORY_EVENT@1122_42@TITLE"
msgstr "Meeting Crude {EventHouse.Name}"

msgid "STORY_EVENT@1122_44@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} to you."

msgid "STORY_EVENT@1122_44@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} of {EventHouse.Name} greets you with a handshake and a knowing look."

msgid "STORY_EVENT@1122_44@BODY_LORE"
msgstr "\"Salutations, o illustrious {PlayerLeader.Name}. We have studied you and find you impressive. Though we are quite busy with numerous projects, {EventHouse.Name} will always have time for diplomacy with you, should you be interested. We certainly would like to work together.\""

msgid "STORY_EVENT@1122_44@BUTTON_0"
msgstr "Initiate a potential path forward with these enthusiasts of invention."

msgid "STORY_EVENT@1122_44@BUTTON_2"
msgstr "Take leave of discussions for the time being..."

msgid "STORY_EVENT@1122_44@TITLE"
msgstr "Meeting Diligent {EventHouse.Name}"

msgid "STORY_EVENT@1122_45@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} to you."

msgid "STORY_EVENT@1122_45@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} of {EventHouse.Name} greets you with an ostentatious smirk."

msgid "STORY_EVENT@1122_45@BODY_LORE"
msgstr "\"Well met, {PlayerLeader.Name}. Though you are a bit rougher around the edges than our society, we believe that we here in {EventHouse.Name} may have much in common with you, should you choose to pursue negotiations. Time will tell.\""

msgid "STORY_EVENT@1122_45@BUTTON_0"
msgstr "Begin an exchange with this opulent society."

msgid "STORY_EVENT@1122_45@BUTTON_2"
msgstr "Remove yourself from the conversation for the moment."

msgid "STORY_EVENT@1122_45@TITLE"
msgstr "Meeting Posh {EventHouse.Name}"

msgid "STORY_EVENT@1122_46@BODY_FOOTER"
msgstr "\"Order us to purge your cities of heretics, and their sacrifice will elevate your faithful people... or yourself.\""

msgid "STORY_EVENT@1122_46@BODY_HEADER"
msgstr "A company of <<m:EventUnit>> arrive at your court. Their captain proclaims: \"At last! We found you!\""

msgid "STORY_EVENT@1122_46@BODY_LORE"
msgstr "\"We are the {RandomWarriorTitle} of the {RandomIdol}, who discovered that virtuous communities become enlightened when liberated from their faithless. Their focused zeal may even elevate a {GLOBAL.GodirLoreConcept.Hyperlink} such as yourself! In a dream, I received the quest to aid a new paragon of [hyperlink,GLOBAL.OrderConcept]Order[/hyperlink]! {PlayerLeader.TitleName}, that paragon is you!\""

msgid "STORY_EVENT@1122_46@BUTTON_0"
msgstr "\"Illuminate my empire [orderboon/]. Purge my domain of heretics [population/].\""

msgid "STORY_EVENT@1122_46@BUTTON_1"
msgstr "\"Purge [population/] {EventCity} only, and grant me heavenly knowledge!\""

msgid "STORY_EVENT@1122_46@BUTTON_2"
msgstr "\"My empire lacks conviction [influence/]. Become my divine enforcer [unit/].\""

msgid "STORY_EVENT@1122_46@BUTTON_3"
msgstr "\"I deem your methods barbaric [ordercrisis/]. Leave my realm!\""

msgid "STORY_EVENT@1122_46@TITLE"
msgstr "Divine Salvation"

msgid "STORY_EVENT@1122_47@BODY_FOOTER"
msgstr "\"We bless thee through our sanctifying plea. Prove now thy divine right. Perform a miracle that demonstrates thy might!\""

msgid "STORY_EVENT@1122_47@BODY_HEADER"
msgstr "In a vision, a {EventUnit} visits you. An invisible choir sings: \"Forsooth, thou hast become a Beacon of [hyperlink,GLOBAL.OrderConcept]Order[/hyperlink], {PlayerLeader.TitleName}.\""

msgid "STORY_EVENT@1122_47@BODY_LORE"
msgstr "The Shrine's unrelenting gaze pierces your soul. The angelic chorus continues: \"We scavenge realms that connect to the {GLOBAL.AstralSeaLoreConcept.Hyperlink}, in search of Beacons like thou. Our song ennobles you - do not fear it! The road to ascension opens to those that hear it. We beseech you now before we depart: show the piety of your zealous heart.\""

msgid "STORY_EVENT@1122_47@BUTTON_0"
msgstr "Draw from your soul's divinity [mana/] [knowledge/] to bless your population [orderboon/]."

msgid "STORY_EVENT@1122_47@BUTTON_1"
msgstr "Construct idols [structureprod/] in every city, to display your empire's unification [influence/]."

msgid "STORY_EVENT@1122_47@BUTTON_2"
msgstr "Establish [unitprod/] the Holy Order of the Divine <<m:EventUnitB>> in {EventCity}!"

msgid "STORY_EVENT@1122_47@BUTTON_3"
msgstr "\"Begone, {EventUnit}! My glory outshines your authority [ordercrisis/]!\""

msgid "STORY_EVENT@1122_47@TITLE"
msgstr "Divine Exaltation"

msgid "STORY_EVENT@1122_4@BODY_FOOTER"
msgstr "While you analyze the masterful performance of the {EventUnit} turned jester, {EventHouseLord.FirstName} suddenly asks why you don't seem entertained."

msgid "STORY_EVENT@1122_4@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of {EventHouse} proudly summons <<o:EventHouseLord>> new court jester to entertain you during negotiations."

msgid "STORY_EVENT@1122_4@BODY_LORE"
msgstr "This jester, however, is clearly no fool! As <<p:EventUnit>> performs complex conjuration and illusion spells, <<p:EventUnit>> seems severely overqualified for <<o:EventUnit>> job. {EventHouseLord.Name} claps and cheers with joy, unable to assess how powerful the performer is. The jester pulls off another dazzling illusion with ease, <<o:EventUnit>> expression bordering on boredom."

msgid "STORY_EVENT@1122_4@BUTTON_0"
msgstr "\"My empire [influence/] knows no jesters as talented as yours, {EventHouseLord.Title}!\""

msgid "STORY_EVENT@1122_4@BUTTON_1"
msgstr "\"{EventUnit}! I will be your new patron [unit/]!\""

msgid "STORY_EVENT@1122_4@BUTTON_2"
msgstr "\"<<Cp:EventUnit>> is fine, but how are <<o:EventUnit>> juggling skills?\""

msgid "STORY_EVENT@1122_4@BUTTON_3"
msgstr "\"<<Cp:EventUnit>> is capable, all right. Now behold how the Godir perform magic tricks!\""

msgid "STORY_EVENT@1122_4@BUTTON_4"
msgstr "\"Excuse my earnestness, {EventHouseLord}. I am pondering the bright future of {EventHouse} under my protection.\""

msgid "STORY_EVENT@1122_4@TITLE"
msgstr "Foolish Games"

msgid "STORY_EVENT@1122_5@BODY_FOOTER"
msgstr "\"Surely, you will contribute to the celebration of the great {EventGodir}! What can we expect from you, O {PlayerLeader.Name}?\""

msgid "STORY_EVENT@1122_5@BODY_HEADER"
msgstr "After today's diplomatic negotiations, {EventHouseLord.TitleName} of {EventHouse} announces that their city wants to celebrate a Godir they are in awe of: {EventGodir}."

msgid "STORY_EVENT@1122_5@BODY_LORE"
msgstr "They wish to commemorate the day {EventGodir} became a Godir, and intend to make this an annual event. \"It was my idea,\" {EventHouseLord.Name} declares. \"And my people's morale has never been better! May we all be blessed by the might and glory of {EventGodir}!\""

msgid "STORY_EVENT@1122_5@BODY_LORE@ASTRAL"
msgstr "They wish to commemorate the day {EventGodir} became a Godir, and intend to make this an annual event. \"It was my idea,\" {EventHouseLord.Name} declares. \"And my people's morale has never been better! May we all be blessed by the wisdom and arcana of {EventGodir}!\""

msgid "STORY_EVENT@1122_5@BODY_LORE@CHAOS"
msgstr "They wish to commemorate the day {EventGodir} became a Godir, and intend to make this an annual event. \"It was my idea,\" {EventHouseLord.Name} declares. \"And my people's morale has never been better! May we all be blessed by the fire and chaos of {EventGodir}!\""

msgid "STORY_EVENT@1122_5@BODY_LORE@MATERIUM"
msgstr "They wish to commemorate the day {EventGodir} became a Godir, and intend to make this an annual event. \"It was my idea,\" {EventHouseLord.Name} declares. \"And my people's morale has never been better! May we all be blessed by the opulence and artisanship of {EventGodir}!\""

msgid "STORY_EVENT@1122_5@BODY_LORE@NATURE"
msgstr "They wish to commemorate the day {EventGodir} became a Godir, and intend to make this an annual event. \"It was my idea,\" {EventHouseLord.Name} declares. \"And my people's morale has never been better! May we all be blessed by the fertility and vibrancy of {EventGodir}!\""

msgid "STORY_EVENT@1122_5@BODY_LORE@ORDER"
msgstr "They wish to commemorate the day {EventGodir} became a Godir, and intend to make this an annual event. \"It was my idea,\" {EventHouseLord.Name} declares. \"And my people's morale has never been better! May we all be blessed by the light and harmony of {EventGodir}!\""

msgid "STORY_EVENT@1122_5@BODY_LORE@SHADOW"
msgstr "They wish to commemorate the day {EventGodir} became a Godir, and intend to make this an annual event. \"It was my idea,\" {EventHouseLord.Name} declares. \"And my people's morale has never been better! May we all be blessed by the secrets and decay of {EventGodir}!\""

msgid "STORY_EVENT@1122_5@BUTTON_0"
msgstr "\"{EventGodir} inspires us all. I will sponsor [gold/] your festivities.\""

msgid "STORY_EVENT@1122_5@BUTTON_1"
msgstr "\"{EventGodir} was a FOOL! You ought to worship ME instead [influence/]!\""

msgid "STORY_EVENT@1122_5@BUTTON_2"
msgstr "Teach [knowledge/] {EventHouse} about {EventGodir} and <<o:EventGodir>> accomplishments."

msgid "STORY_EVENT@1122_5@BUTTON_3"
msgstr "\"Celebrating <<G:supremacy^n,{EventGodir}>> is incomplete without a touch of magic.\""

msgid "STORY_EVENT@1122_5@BUTTON_4"
msgstr "\"These vulgar celebrations do not deserve my attention.\""

msgid "STORY_EVENT@1122_5@TITLE"
msgstr "<<G:Day^n,EventGodir>>"

msgid "STORY_EVENT@1122_61@BODY_FOOTER"
msgstr "The prospector requests miners from {EventCity} to unearth a magical stone deposit. Your share will allow a special project."

msgid "STORY_EVENT@1122_61@BODY_HEADER"
msgstr "An old prospector covered in dirt hails you. <<Cp:EventUnit>> keeps a pouch close to <<o:EventUnit>> chest."

msgid "STORY_EVENT@1122_61@BODY_LORE"
msgstr "The grimy prospector's voice is gravelly, <<o:EventUnit>> enthusiasm unbridled. \"So ye be the Forge Keeper around here, eh?\" <<Cp:EventUnit>> grinningly takes a pebble from the pouch. \"See this? Flowrock! I know of a secret deposit! But I cannot move it on me own. Spare some workers to help me, and we'll split the bounty!\""

msgid "STORY_EVENT@1122_61@BUTTON_0"
msgstr "Send miners [structureprod/] and erect an obelisk to commemorate the discovery [materiumboon/]."

msgid "STORY_EVENT@1122_61@BUTTON_1"
msgstr "Send miners [structureprod/] and forge a {EventItem} [item/]."

msgid "STORY_EVENT@1122_61@BUTTON_2"
msgstr "Send miners [structureprod/] and construct an {EventUnitB} [unit/]."

msgid "STORY_EVENT@1122_61@BUTTON_3"
msgstr "\"Flowrock? That's the most ridiculous thing [materiumcrisis/] I've ever heard.\""

msgid "STORY_EVENT@1122_61@TITLE"
msgstr "Precious Opportunity"

msgid "STORY_EVENT@1122_62@BODY_FOOTER"
msgstr "Yet the clay is rapidly decaying! You have mere seconds to decide what new element to create!"

msgid "STORY_EVENT@1122_62@BODY_HEADER"
msgstr "You've devoted your [hyperlink,GLOBAL.MateriumConcept]Materium[/hyperlink] mastery to the creation of the mythical transmuter's clay. Today, you succeeded!"

msgid "STORY_EVENT@1122_62@BODY_LORE"
msgstr "Only the primordial {GLOBAL.ArchonsLoreConcept.Hyperlink} successfully fashioned this clay which, according to legends, gives its user the power to shape never-before-seen materials! After countless unsuccessful tries, you accidentally knocked over an unlabeled flask today, spilling its contents into your cauldron. The tincture sizzled... popped... and once the fumes cleared, the clay was there!"

msgid "STORY_EVENT@1122_62@BUTTON_0"
msgstr "Transform wheat [food/] from {EventCity} into a mind-sharpening vapor [knowledge/]!"

msgid "STORY_EVENT@1122_62@BUTTON_1"
msgstr "Transmute gold [gold/] into an elixir [materiumboon/] that resurrects {EventHero} [unit/]!"

msgid "STORY_EVENT@1122_62@BUTTON_2"
msgstr "Transmute <<g:teardrops^n,EventCity>> [happiness/] into gold coins [gold/]!"

msgid "STORY_EVENT@1122_62@BUTTON_3"
msgstr "Allow the transmuter's clay to disintegrate."

msgid "STORY_EVENT@1122_62@TITLE"
msgstr "Elementary Transmutations"

msgid "STORY_EVENT@1122_63@BODY_FOOTER"
msgstr "\"{PlayerLeader.Title}, you may learn a destructive spell in exchange for... a quart of your blood.\""

msgid "STORY_EVENT@1122_63@BODY_HEADER"
msgstr "A hooded hermit requests an audience. <<Cp:EventUnit>> bears three pages that were clearly ripped from their [hyperlink,GLOBAL.TomeLoreConcept]Tomes of Magic[/hyperlink]."

msgid "STORY_EVENT@1122_63@BODY_LORE"
msgstr "\"You have a reputation of being a scholarly {PlayerLeader.TitleName}.\" The hermit's voice is deep and honeyed. You discern the outline of a barbed tail under <<o:EventUnit>> robes. \"I carry... forbidden knowledge that can be yours. If you are determined enough to claim it.\" Small horns protrude from under the hermit's hood."

msgid "STORY_EVENT@1122_63@BUTTON_0"
msgstr "Exchange your blood for the flame-licked page."

msgid "STORY_EVENT@1122_63@BUTTON_0@LEARN_SPELL_CONDEMNATION"
msgstr "{PlayerLeader} learns {Condemnation.Hyperlink}"

msgid "STORY_EVENT@1122_63@BUTTON_0@LEARN_SPELL_FIREBALL"
msgstr "{PlayerLeader} learns the spell {Fireball.Hyperlink}"

msgid "STORY_EVENT@1122_63@BUTTON_0@LEARN_SPELL_ICECOFFIN"
msgstr "{PlayerLeader} learns {IceCoffin.Hyperlink}"

msgid "STORY_EVENT@1122_63@BUTTON_1"
msgstr "Exchange your blood for the frosty page."

msgid "STORY_EVENT@1122_63@BUTTON_2"
msgstr "Exchange your blood for the illuminated page."

msgid "STORY_EVENT@1122_63@BUTTON_3"
msgstr "Turn away the trickster. The price of knowledge has its limits [astralcrisis/]."

msgid "STORY_EVENT@1122_63@TITLE"
msgstr "Devious Deal"

msgid "STORY_EVENT@1122_64@BODY_FOOTER"
msgstr "Who will become your apprentice? Your mentee's family will gift you the resource they produce."

msgid "STORY_EVENT@1122_64@BODY_HEADER"
msgstr "In keeping with traditions, any self-respecting Master of the [hyperlink,GLOBAL.AstralConcept]Astral[/hyperlink] takes on a pupil."

msgid "STORY_EVENT@1122_64@BODY_LORE"
msgstr "You invite every seventh child of a seventh child to your court. Three answer the call. The first one barges in and immediately picks a fight: a hot-headed lumberjack's <<EventHeroA{son/daughter}>>. The second calmly takes a seat at your table: a steel-faced steward's <<EventHeroB{son/daughter}>>. The third greets the guards and pours <<EventHeroC{himself/herself}>> a drink: a friendly baker's <<EventHeroC{boy/girl}>>."

msgid "STORY_EVENT@1122_64@BUTTON_0"
msgstr "\"{EventHeroA.FirstName} [unit/], the lumberjack's <<EventHeroA{son/daughter}>> [structureprod/], shall be my apprentice [knowledge/].\""

msgid "STORY_EVENT@1122_64@BUTTON_1"
msgstr "\"{EventHeroA.FirstName} [unit/], the lumberjack's <<EventHeroA{son/daughter}>> [structureprod/], shall be my apprentice [knowledge/].\""

msgid "STORY_EVENT@1122_64@BUTTON_2"
msgstr "\"{EventHeroB.FirstName} [unit/], the steward's <<EventHeroB{son/daughter}>> [gold/], shall be my apprentice [knowledge/].\""

msgid "STORY_EVENT@1122_64@BUTTON_3"
msgstr "\"{EventHeroB.FirstName} [unit/], the steward's <<EventHeroB{son/daughter}>> [gold/], shall be my apprentice [knowledge/].\""

msgid "STORY_EVENT@1122_64@BUTTON_4"
msgstr "\"{EventHeroC.FirstName} [unit/], the baker's <<EventHeroC{boy/girl}>> [food/], shall be my apprentice [knowledge/].\""

msgid "STORY_EVENT@1122_64@BUTTON_5"
msgstr "\"{EventHeroC.FirstName} [unit/], the baker's <<EventHeroC{boy/girl}>> [food/], shall be my apprentice [knowledge/].\""

msgid "STORY_EVENT@1122_64@BUTTON_6"
msgstr "\"What am I doing? Apprentices are for fools! [astralcrisis/]\""

msgid "STORY_EVENT@1122_64@TITLE"
msgstr "Sorcerer's Apprentice"

msgid "STORY_EVENT@1122_68@BODY_FOOTER"
msgstr "The Astral Storm threatens to evaporate the citizens of {EventCity}. Are you capable of deflecting the imminent mayhem?"

msgid "STORY_EVENT@1122_68@BODY_HEADER"
msgstr "Your [hyperlink,GLOBAL.AstralConcept]Astral[/hyperlink] eye senses a terrible storm of [hyperlink,GLOBAL.AstralFlowsLoreConcept]magical currents[/hyperlink] gathering over your throne city."

msgid "STORY_EVENT@1122_68@BODY_LORE"
msgstr "The flowing energies of the {GLOBAL.AstralSeaLoreConcept.Hyperlink}, that fickle mistress, ebb and flow between its main conduits. When the astral waves collide and crash, too much energy can flood a realm that houses any {PlayerLeader.Title} of note. Today, that {PlayerLeader.Title} is you."

msgid "STORY_EVENT@1122_68@BUTTON_0"
msgstr "Save {EventCity} by absorbing the devastating energies [mana/]."

msgid "STORY_EVENT@1122_68@BUTTON_1"
msgstr "Scatter the storm [mana/] to scry three Astral nexuses."

msgid "STORY_EVENT@1122_68@BUTTON_2"
msgstr "Cast the Storm into a mold and forge [structureprod/] a {EventItem} [item/]!"

msgid "STORY_EVENT@1122_68@BUTTON_3"
msgstr "Distill the currents into two <<m:EventUnit>> [unit/] with your summoners' aid [unitprod/]!"

msgid "STORY_EVENT@1122_68@BUTTON_4"
msgstr "Do nothing. The Astral Sea gives [astralboon/], and consumes [population/]."

msgid "STORY_EVENT@1122_68@TITLE"
msgstr "Astral Storm"

msgid "STORY_EVENT@1122_69@BODY_FOOTER"
msgstr "To a <<PlayerLeader{Master/Mistress}>> of Shadow, these risen warriors are a gift! What purpose shall they serve?"

msgid "STORY_EVENT@1122_69@BODY_HEADER"
msgstr "[hyperlink,GLOBAL.ShadowConcept]Shadows[/hyperlink] covering your realm cause long-dead soldiers to rise from their graves at a forgotten battle site near your city of {EventCity}."

msgid "STORY_EVENT@1122_69@BODY_LORE"
msgstr "Drawn to your dark radiance, the army marches upon {EventCity}. <<m:EventUnitB>> claw at your gates. <<m:EventUnitC>> gnaw on your walls. <<m:EventUnit>> howl at the few living souls that remain in your throne city. Where others would faint at the mere sight of this revenant horde, you see opportunity."

msgid "STORY_EVENT@1122_69@BUTTON_0"
msgstr "Bind [unit/] the undead company to your command using magic [mana/]."

msgid "STORY_EVENT@1122_69@BUTTON_1"
msgstr "\"{EventHero}! Dispatch these undead! Their souls [souls/] are mine.\""

msgid "STORY_EVENT@1122_69@BUTTON_2"
msgstr "\"Necromancers [unitprod/]! Pick their brains to harvest the ancient secrets [knowledge/].\""

msgid "STORY_EVENT@1122_69@BUTTON_3"
msgstr "Open the gates [happiness/]! The dead are welcome in {EventCity} [population/]."

msgid "STORY_EVENT@1122_69@BUTTON_4"
msgstr "Leave them be. The dead will soon resume their rest."

msgid "STORY_EVENT@1122_69@BUTTON_5"
msgstr "\"Guards [unitprod/]! Dispatch these undead! I require their souls [souls/].\""

msgid "STORY_EVENT@1122_69@TITLE"
msgstr "Revenant Horde"

msgid "STORY_EVENT@1122_6@BODY_FOOTER"
msgstr "\"What say you, my {PlayerLeader.Title}? Will you grant me access to your troves of knowledge?\""

msgid "STORY_EVENT@1122_6@BODY_HEADER"
msgstr "During negotiations, {EventHouseLord.TitleName} of {EventHouse} unexpectedly demands that you share your wisdom and lore with <<P:EventHouseLord>>."

msgid "STORY_EVENT@1122_6@BODY_LORE"
msgstr "The words of {EventHouseLord.TitleName} betray <<o:EventHouseLord>> ambition. \"I confess that I seek your tutelage in the ways of Magic. I can advance my aspirations through your generosity and compassion. Knowledge is what I desire, O {PlayerLeader.TitleName}. I would become a powerful ally to your cause!\""

msgid "STORY_EVENT@1122_6@BUTTON_0"
msgstr "\"I will share some of my lore [knowledge/] with you.\""

msgid "STORY_EVENT@1122_6@BUTTON_1"
msgstr "\"My secrets [knowledge/] can be yours... for a price! [gold/]\""

msgid "STORY_EVENT@1122_6@BUTTON_2"
msgstr "\"No. Mastering magic is a journey, not a destination, {EventHouseLord.Title}.\""

msgid "STORY_EVENT@1122_6@BUTTON_3"
msgstr "\"You covet the secrets of a Godir? Behold them, and despair!\""

msgid "STORY_EVENT@1122_6@BUTTON_4"
msgstr "\"Although your plea amuses me, I cannot comply with your request.\""

msgid "STORY_EVENT@1122_6@TITLE"
msgstr "Sharing Secrets"

msgid "STORY_EVENT@1122_79@BODY_FOOTER"
msgstr "\"Celebrate spring's fertility with me, {PlayerLeader.TitleName}! Expose me to your dominion's potency!\" Can your expansion impress the {EventUnit}?"

msgid "STORY_EVENT@1122_79@BODY_HEADER"
msgstr "A {EventUnit} comes frolicking from faraway fields and dances before you, flowers springing up from wherever <<o:EventUnit>> feet land."

msgid "STORY_EVENT@1122_79@BODY_LORE"
msgstr "You are drawn into the depths of <<o:EventUnit>> eyes, like bottomless pools of cool green water. <<Co:EventUnit>> dance grows more feral and intense. The {EventUnit} seems to receive pleasure from her exaggerated movements, until <<p:EventUnit>> suddenly stops in a suggestive pose, <<o:EventUnit>> ravenous gaze lingering on your body."

msgid "STORY_EVENT@1122_79@BUTTON_0"
msgstr "Collapse the mine [structureprod/] near {EventCityB} to sow seeds [food/] there."

msgid "STORY_EVENT@1122_79@BUTTON_1"
msgstr "Boost the birth rate [population/] [happiness/] of {EventCity} with fine wine [gold/]."

msgid "STORY_EVENT@1122_79@BUTTON_2"
msgstr "Fortify warrior bloodlines [unitprod/] in {EventCity} by increasing their rations [food/]."

msgid "STORY_EVENT@1122_79@BUTTON_3"
msgstr "Commission a husbandry expert [gold/] to breed a {EventMount}."

msgid "STORY_EVENT@1122_79@BUTTON_4"
msgstr "\"Do not seduce me, Forest Witch [naturecrisis/]!\""

msgid "STORY_EVENT@1122_79@TITLE"
msgstr "Beckoning of Spring"

msgid "STORY_EVENT@1122_7@BODY_FOOTER"
msgstr "\"Your fascination with my {EventItem} flatters me,\" {EventHouseLord.Name} says, \"but only a generous offer can convince me to part with it.\""

msgid "STORY_EVENT@1122_7@BODY_HEADER"
msgstr "During a lengthy discussion on trade terms, you discover an exquisite {EventItem} mounted on the wall of {EventHouseLord.TitleName} of {EventHouse}."

msgid "STORY_EVENT@1122_7@BODY_LORE"
msgstr "You admire the craftsmanship of the object. Even through the Whispering Stone, you can sense the powerful energy flowing from the {EventItem}. This is an artifact that belongs in the hoard of a {GLOBAL.GodirLoreConcept.Hyperlink}, not on a <<g:wall^n,{EventHouseLord.Title}>>! {EventHouseLord.Name} soon notices your interest in the object and smirks."

msgid "STORY_EVENT@1122_7@BUTTON_0"
msgstr "Offer jewels [gold/] in exchange for the {EventItem} [item/]."

msgid "STORY_EVENT@1122_7@BUTTON_1"
msgstr "Trade the {EventItem} [item/] for your immortal wisdom [knowledge/]."

msgid "STORY_EVENT@1122_7@BUTTON_2"
msgstr "\"That is certainly a spectacular {EventItem}! You must be very proud. [influence/]\""

msgid "STORY_EVENT@1122_7@BUTTON_3"
msgstr "Study its designs and craft a copy for yourself."

msgid "STORY_EVENT@1122_7@BUTTON_4"
msgstr "\"I don't want your frivolous trinket.\""

msgid "STORY_EVENT@1122_7@TITLE"
msgstr "Trade Negotiations"

msgid "STORY_EVENT@1122_80@BODY_FOOTER"
msgstr "\"We are keepers of the cycle, you and I. For new life to sprout, the elder must die. So, choose.\""

msgid "STORY_EVENT@1122_80@BODY_HEADER"
msgstr "Without warning, a flurry of leaves engulfs you. A dour {EventUnit} steps forward. \"{PlayerLeader.TitleName}! Limit your growth!\""

msgid "STORY_EVENT@1122_80@BODY_LORE"
msgstr "With a voice like wind through a hollow tree, the {EventUnit} incants: \"[hyperlink,GLOBAL.NatureConcept]Nature's[/hyperlink] way is not unending bloom. Such a foray causes everyone's doom. After the season of winter brings death, that void is the reason newborns draw breath.\" The servant of Nature draws a circle with <<o:EventUnit>> staff on the ground."

msgid "STORY_EVENT@1122_80@BUTTON_0"
msgstr "Prune the population of {EventCity}. A young hero [unit/] will bloom."

msgid "STORY_EVENT@1122_80@BUTTON_1"
msgstr "Reap seeds already sown [unitprod/] and till your realm's soil [natureboon/]."

msgid "STORY_EVENT@1122_80@BUTTON_2"
msgstr "\"Relieved from the yoke of my ambitions [influence/], my people shall multiply [population/].\""

msgid "STORY_EVENT@1122_80@BUTTON_3"
msgstr "\"You are wrong [naturecrisis/]! My empire's expansion is boundless [influence/].\""

msgid "STORY_EVENT@1122_80@BUTTON_4"
msgstr "Prune the population of {EventCity}. A young hero [unit/] will bloom."

msgid "STORY_EVENT@1122_80@TITLE"
msgstr "Redemption of Winter"

msgid "STORY_EVENT@1122_81@BODY_FOOTER"
msgstr "It has fallen to you to add spice to this dreadful \"feast.\" How will you proceed?"

msgid "STORY_EVENT@1122_81@BODY_HEADER"
msgstr "Your steward insisted you hold a formal feast for your distinguished subjects. Unsurprisingly, the event is tedious and insipid."

msgid "STORY_EVENT@1122_81@BODY_LORE"
msgstr "Guests wearing suffocating dresses and awkward robes sit at long tables, solemnly chewing bland meals. Troubadours play dull tunes reserved for refined banquets, per tradition. A dancing bear has fallen asleep. A conjurer fruitlessly tries to retrieve his doves from the great hall's rafters. Someone sneezes, then promptly apologizes."

msgid "STORY_EVENT@1122_81@BUTTON_0"
msgstr "Share your best wines and ales [gold/]! Cheers, everyone! [happiness/]"

msgid "STORY_EVENT@1122_81@BUTTON_1"
msgstr "Magically set the curtains ablaze [mana/]! Behold the spectacle! [happiness/]"

msgid "STORY_EVENT@1122_81@BUTTON_2"
msgstr "Seek pleasure in inhibited forms of entertainment [chaoscrisis/]."

msgid "STORY_EVENT@1122_81@TITLE"
msgstr "Revel Without a Cause"

msgid "STORY_EVENT@1122_82@BODY_FOOTER"
msgstr "The {EventUnitB} draws <<o:EventUnitB>> blade with quivering hand and lingering doubt in <<o:EventUnitB>> eyes. How to deal with <<P:EventUnitB>>?"

msgid "STORY_EVENT@1122_82@BODY_HEADER"
msgstr "A {EventUnitB} in shining armor confronts you. \"Today, my blade will end you, infernal scum!\""

msgid "STORY_EVENT@1122_82@BODY_LORE"
msgstr "\"This is the oath I took before the {RandomWarriorTitle} of the {RandomIdol}: to find and dispatch the emerging [hyperlink,GLOBAL.ChaosConcept]Chaos[/hyperlink] <<PlayerLeader{Master/Mistress}>> that wreaks havoc on this realm! 'Tis to be my final test after leaving behind a life of sin and depravity! That fiend I am no longer!\""

msgid "STORY_EVENT@1122_82@BUTTON_0"
msgstr "Offer riches [gold/] to corrupt the {EventUnitB} into a {EventUnit} [unit/]."

msgid "STORY_EVENT@1122_82@BUTTON_1"
msgstr "Reveal infernal secrets [knowledge/] to corrupt the {EventUnitB} into a {EventUnit} [unit/]."

msgid "STORY_EVENT@1122_82@BUTTON_2"
msgstr "Immolate [mana/] the {EventUnitB} [evilact/] for Chaos [chaosboon/]."

msgid "STORY_EVENT@1122_82@BUTTON_3"
msgstr "Use Chaos magic [mana/] to lift [goodact/] <<G:oath^n,EventUnitB>> [chaosboon/].\""

msgid "STORY_EVENT@1122_82@BUTTON_4"
msgstr "\"Stay your zealous tongue, Oathbound! Leave me in peace [chaoscrisis/].\""

msgid "STORY_EVENT@1122_82@TITLE"
msgstr "Oathbreaker"

msgid "STORY_EVENT@1122_83@BODY_FOOTER"
msgstr "The {EventUnit} notices you and bellows: \"Embody Chaos, {PlayerLeader.TitleName}! Demolish this false idol!\" Do you dare interfere?"

msgid "STORY_EVENT@1122_83@BODY_HEADER"
msgstr "In a recurring dream, a terrible {EventUnit} endlessly battles a radiant {EventUnitB} atop a mountain plateau."

msgid "STORY_EVENT@1122_83@BODY_LORE"
msgstr "You've had this terrible dream since you embraced [hyperlink,GLOBAL.ChaosConcept]Chaos[/hyperlink]. But tonight, it feels as if avatars of Chaos and [hyperlink,GLOBAL.OrderConcept]Order[/hyperlink] will settle their eternal conflict and determine who shall inherit the [hyperlink,GLOBAL.AstralSeaLoreConcept]Astral Sea's[/hyperlink] ashen ruins. You discern more {GLOBAL.GodirLoreConcept.Hyperlink} of Order and Chaos, all witnessing the duel, their eyes flooded with fear."

msgid "STORY_EVENT@1122_83@BUTTON_0"
msgstr "Strike down the {EventUnitB} and bind [unit/] the {EventUnit} to your will."

msgid "STORY_EVENT@1122_83@BUTTON_10"
msgstr "Avert your eyes [chaoscrisis/] until the vision ends."

msgid "STORY_EVENT@1122_83@BUTTON_2"
msgstr "Immolate {EventUnit}, {EventUnitB}, and yourself in a pandemonium of coiling flames [chaosboon/]!"

msgid "STORY_EVENT@1122_83@BUTTON_9"
msgstr "Slay the {EventUnit}, and the {EventUnitB} grants you <<o:EventUnitB>> secrets [chaoscrisis/]."

msgid "STORY_EVENT@1122_83@TITLE"
msgstr "Pandemoniac"

msgid "STORY_EVENT@1122_8@BODY_FOOTER"
msgstr "\"Assassins are after me! Do you desire to strengthen the bonds between our Houses? Then please, keep me safe!\""

msgid "STORY_EVENT@1122_8@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of {EventHouse} interrupts your negotiations. \"I can't pretend anymore! Why negotiate when I'll be dead tomorrow anyway!\""

msgid "STORY_EVENT@1122_8@BODY_LORE"
msgstr "<<g:voice^n,{EventHouseLord.Name}>> trembles: \"I'm certain that pretenders to my throne are stirring up my people against me. They spread lies about my incompetence as a Ruler! And now—I'm certain of it!—they intend to make their move... by taking my life!\""

msgid "STORY_EVENT@1122_8@BUTTON_0"
msgstr "\"Guards [unitprod/] from {EventCity} will keep you safe.\""

msgid "STORY_EVENT@1122_8@BUTTON_1"
msgstr "\"{EventHero} [unit/] shall be your personal bodyguard, my friend. [goodact/]\""

msgid "STORY_EVENT@1122_8@BUTTON_2"
msgstr "\"Bloodthirst will compel your pretenders to butcher each other [evilact/].\""

msgid "STORY_EVENT@1122_8@BUTTON_3"
msgstr "\"Inquisitors will judge these pretenders before a tribunal of my design!\""

msgid "STORY_EVENT@1122_8@BUTTON_4"
msgstr "\"Assassins?! Your imagination is running wild, {EventHouseLord.Title}. You'll be fine.\""

msgid "STORY_EVENT@1122_8@TITLE"
msgstr "Saving The Meek"

msgid "STORY_EVENT@1122_95@BODY_FOOTER"
msgstr "\"Will you help me find my <<EventUnit{brother/sister}>>, my {PlayerLeader.Title}? I worry for <<o:EventUnit>> safety! Let me mark the {EventStructure} on your map.\""

msgid "STORY_EVENT@1122_95@BODY_HEADER"
msgstr "\"{PlayerLeader.TitleName}!\" Your [hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink] {EventHero.Name} kneels before you, distressed. \"My little <<EventUnit{brother/sister}>>! <<Cp:EventUnit>> went dowsing for precious stones, yet never returned!\""

msgid "STORY_EVENT@1122_95@BODY_LORE"
msgstr "\"<<Cp:EventUnit>> migrated to {EventCity} when you recruited me. <<Cp:EventUnit>> has been prospecting for precious stones and metals since <<p:EventUnit>> was a wee <<EventUnit{boy/girl}>>, carrying around an oversized dowsing rod. Recently, a faraway {EventStructure} caught <<o:EventUnit>> attention. Normally, my <<EventUnit{brother/sister}>> returns with a sizable haul within three days. Today is the eighth day since <<p:EventUnit>> left.\" <<G:eyes^n,EventHero>> turn misty."

msgid "STORY_EVENT@1122_95@BUTTON_0"
msgstr "\"I will look for your <<EventUnit{brother/sister}>>, {EventHero.FirstName}. I'm sure <<p:EventUnit>> is fine."

msgid "STORY_EVENT@1122_95@BUTTON_2"
msgstr "\"I cannot aid you. May <<p:EventUnit>> return soon.\""

msgid "STORY_EVENT@1122_95@TITLE"
msgstr "Treasured <<EventUnit{Brother/Sister}>>"

msgid "STORY_EVENT@1122_96@BODY_FOOTER"
msgstr "The {EventUnit} sighs gratefully. \"For rescuing me, please accept the treasure I discovered. My skills are at the service of {PlayerLeader.TitleName}.\""

msgid "STORY_EVENT@1122_96@BODY_FOOTER@PLAYER_LEADS"
msgstr "The {EventUnit} sighs gratefully. \"For rescuing me, please accept the treasure I discovered. My skills are at your service, {PlayerLeader.TitleName}.\""

msgid "STORY_EVENT@1122_96@BODY_FOOTER@QUESTGIVER_LEADS"
msgstr "The {EventUnit} sighs gratefully. \"For rescuing me, please accept the treasure I discovered. My skills are at the service of {PlayerLeader.TitleName}.\""

msgid "STORY_EVENT@1122_96@BODY_HEADER"
msgstr "Your troops search the area and tunnels. When they pass a crack beneath the central {EventStructure}, someone whispers: \"Are they gone?\""

msgid "STORY_EVENT@1122_96@BODY_HEADER@PLAYER_LEADS"
msgstr "You search the area and tunnels. When you pass a crack beneath the central {EventStructure}, someone whispers: \"Are they gone?\""

msgid "STORY_EVENT@1122_96@BODY_HEADER@QUESTGIVER_LEADS"
msgstr "{EventHero} searches the area and tunnels. When <<p:EventHero>> passes a crack beneath the central {EventStructure}, someone whispers: \"Are they gone?\""

msgid "STORY_EVENT@1122_96@BODY_LORE"
msgstr "A {EventUnit} crawls out of <<o:EventUnit>> hiding spot. \"I knew someone would come looking for me eventually! I hid down there for days—I think—eating larvae and slimy moss to survive.\" The <<EventUnit{boy/girl}>> chuckles and produces a satchel. \"But it was worth it! The tunnels surrounding this {EventStructure} are teeming with rubies!\""

msgid "STORY_EVENT@1122_96@BODY_LORE@PLAYER_LEADS"
msgstr "A {EventUnit} crawls out of <<o:EventUnit>> hiding spot. \"I knew {EventHero.FirstName} would send someone to look for me! I never dreamed it would be YOU, {PlayerLeader.TitleName}! I hid down there for days—I think—eating larvae and slimy moss to survive.\" The <<EventUnit{boy/girl}>> chuckles and produces a satchel. \"But it was worth it! The tunnels surrounding this {EventResource} are teeming with rubies!\""

msgid "STORY_EVENT@1122_96@BODY_LORE@QUESTGIVER_LEADS"
msgstr "A {EventUnit} crawls out of <<o:EventUnit>> hiding spot. \"Oh, big <<EventHero{brother/sister}>>! I knew you would come looking for me! I hid down there for days—I think—eating larvae and slimy moss to survive.\" The <<EventUnit{boy/girl}>> chuckles and produces a satchel. \"But it was worth it! The tunnels surrounding this {EventStructure} are teeming with rubies!\""

msgid "STORY_EVENT@1122_96@BUTTON_0"
msgstr "\"Your expertise on metal and stone [structureprod/] will make {EventCity} thrive.\""

msgid "STORY_EVENT@1122_96@BUTTON_1"
msgstr "\"Teach [knowledge/] me about precious stones and metals, as well as the behavior of the <<m:EventUnitB>>.\""

msgid "STORY_EVENT@1122_96@BUTTON_3"
msgstr "\"I accept your service as an {EventUnit} [unit/].\""

msgid "STORY_EVENT@1122_96@BUTTON_4"
msgstr "\"I require no reward [goodact/]. I am happy that you are safe.\""

msgid "STORY_EVENT@1122_96@TITLE"
msgstr "Treasured <<EventUnit{Brother/Sister}>>: Aftermath"

msgid "STORY_EVENT@1122_97@BODY_FOOTER"
msgstr "How could anyone survive this infestation? Is it foolish to believe that <<G:sibling^n,EventHero>> is still alive?"

msgid "STORY_EVENT@1122_97@BODY_HEADER"
msgstr "Upon arrival at the {EventStructure}, it becomes clear that the spawn of a {EventSireUnit} hatched a few days ago."

msgid "STORY_EVENT@1122_97@BODY_LORE"
msgstr "The {EventStructure} is overrun with the writhing bodies of the <<m:EventUnit>>. Their corrosive mucus oozes into the nearby fissures. The screech of their sire can be heard echoing from deep tunnels from which the <<m:EventUnit>> hatched. The <<m:EventUnit>> have been feasting on {RandomAnimalA}, judging by the partial dissolved remains that litter the area."

msgid "STORY_EVENT@1122_97@BUTTON_0"
msgstr "Attack the <<m:EventUnit>> to clear the {EventStructure} anyway!"

msgid "STORY_EVENT@1122_97@BUTTON_1"
msgstr "Lure the {EventUnit} away from the {EventStructure} with fresh cattle [food/] from {EventCity}."

msgid "STORY_EVENT@1122_97@BUTTON_2"
msgstr "Cover your troops' bodies in {EventSireUnit} mucus to repel the <<m:EventUnit>>."

msgid "STORY_EVENT@1122_97@BUTTON_3"
msgstr "Leave. There's nothing anyone can do here."

msgid "STORY_EVENT@1122_97@TITLE"
msgstr "Treasured <<EventUnitB{Brother/Sister}>>: Location"

msgid "STORY_EVENT@1140_393@BODY_FOOTER"
msgstr "How will you use your powers against the Wizard Kings?"

msgid "STORY_EVENT@1140_393@BODY_HEADER"
msgstr "You know about the dangers that [hyperlink,GLOBAL.WizardKingLoreConcept]Wizard Kings[/hyperlink] bring. {PlayerLeaderWizard.Lord.TitleName} who you met on this realm is only one of them."

msgid "STORY_EVENT@1140_393@BODY_LORE"
msgstr "Throughout your lifetime, you heard countless stories of the powerful Wizard Kings pillaging and plundering the realms. Now you face them with your own powers. You mastered the arcane arts and gained the ability to navigate through the {GLOBAL.AstralSeaLoreConcept.Hyperlink}. You have [hyperlink,GLOBAL.GodirLoreConcept]ascended[/hyperlink]. When you saw your reflection today, you noticed your powers match those of Wizard Kings. A scary thought? Or a hopeful one?"

msgid "STORY_EVENT@1140_393@BUTTON_0"
msgstr "\"I will personally support my army [unitprod/].\""

msgid "STORY_EVENT@1140_393@BUTTON_1"
msgstr "\"My powers [mana/] will support my people [food/] [happiness/].\""

msgid "STORY_EVENT@1140_393@BUTTON_2"
msgstr "\"I will hone my powers. They will overcome theirs [mana/].\""

msgid "STORY_EVENT@1140_393@BUTTON_3"
msgstr "\"A better understanding [knowledge/] of the Astral Flows will give us an advantage.\""

msgid "STORY_EVENT@1140_393@TITLE"
msgstr "Danger of the Wizard Kings"

msgid "STORY_EVENT@1140_394@BODY_FOOTER"
msgstr "\"What shall we do against these monsters?\""

msgid "STORY_EVENT@1140_394@BODY_HEADER"
msgstr "Tales of sea monsters at the coast of {EventCity.Name} catch your attention."

msgid "STORY_EVENT@1140_394@BODY_LORE"
msgstr "Ghost stories about creatures at the {EventSpawner} are not uncommon, but recently these tales became more frequent. Your citizens describe attacks by dreadful monsters like the {EventStackLeader} in shocking detail. One of your advisors suggests: \"We could focus our military on the issue, or we could hire some mercenaries to take the {EventSpawner} out. Of course, there is always the option to take care of these so-called ghosts ourselves...\""

msgid "STORY_EVENT@1140_394@BUTTON_0"
msgstr "Order your military instructors [unitprod/] to drive the monsters from your coast."

msgid "STORY_EVENT@1140_394@BUTTON_1"
msgstr "Pay [gold/] mercenaries to put the {EventSpawner} to rest."

msgid "STORY_EVENT@1140_394@BUTTON_2"
msgstr "Do nothing. You will take care of it yourself."

msgid "STORY_EVENT@1140_394@BUTTON_3"
msgstr "Ghost stories are your forte. Show these monsters some horrors of your own..."

msgid "STORY_EVENT@1140_394@TITLE"
msgstr "Dreadful Tales"

msgid "STORY_EVENT@1140_436@BODY_FOOTER"
msgstr "\"We must bring Meandor to the Covenant. We cannot allow the Shad'rai scheme to continue without us being able to interfere.\""

msgid "STORY_EVENT@1140_436@BODY_HEADER"
msgstr "{Sundren.FirstName} approaches you. \"Meandor's state of mind is... concerning.\""

msgid "STORY_EVENT@1140_436@BODY_LORE"
msgstr "\"I can't help but feel the {GLOBAL.ShadraiFactionLoreConcept.Hyperlink} are behind this. Typical of those fools to mess with {GLOBAL.GodirLoreConcept.Hyperlink} they were told to avoid—never mind. {Meandor.FirstName} is crucial for the {GLOBAL.CovenantFactionLoreConcept.Hyperlink} to follow the Shad'rai in time. And, I have to admit, I have... personal reasons for searching for him, too. With my father gone, and my mother missing... I have questions and doubts that only he can answer.\""

msgid "STORY_EVENT@1140_436@BUTTON_3"
msgstr "\"Understood.\""

msgid "STORY_EVENT@1140_436@TITLE"
msgstr "Dark Heritage"

msgid "STORY_EVENT@1140_437@BODY_FOOTER"
msgstr "Suddenly you feel weary. Perhaps you do need to lie down, watch the stars for a while... Something is not right, but you feel your eyes close..."

msgid "STORY_EVENT@1140_437@BODY_HEADER"
msgstr "Whilst traveling the Eternal Court, your path is blocked by an apparition, claiming to be a spirit from your own past!"

msgid "STORY_EVENT@1140_437@BODY_LORE"
msgstr "\"{PlayerLeader.FirstName}, you may have forgotten about me... So many Godir forget their past. This 'quest' of yours is so tiresome. Lie down with me instead, gaze at the stars with me, like we did before. Remember? Take my hand... take your rest...\" The stars behind <<P:EventHero>> blink, and for a moment they seem like eyes."

msgid "STORY_EVENT@1140_437@BUTTON_2"
msgstr "[Order/] Use holy light to pierce through this apparition."

msgid "STORY_EVENT@1140_437@BUTTON_3"
msgstr "[Nature/] Focus on the being behind the apparition."

msgid "STORY_EVENT@1140_437@BUTTON_4"
msgstr "[Chaos/] Smash through the apparition."

msgid "STORY_EVENT@1140_437@BUTTON_5"
msgstr "[Arcana/] Enhance your vision to see through this apparition."

msgid "STORY_EVENT@1140_437@BUTTON_6"
msgstr "[Shadow/] Use your knowledge of deception to see through this apparition."

msgid "STORY_EVENT@1140_437@BUTTON_7"
msgstr "[Matter/] Reach through the apparition to find the truth behind it."

msgid "STORY_EVENT@1140_437@TITLE"
msgstr "Enchanting Past"

msgid "STORY_EVENT@1140_622@BODY_FOOTER"
msgstr "\"Six mighty forces of creation wage war to uphold their laws. And you, O {PlayerLeader.Title}. How will you end this endless war of balance and hope?\""

msgid "STORY_EVENT@1140_622@BODY_HEADER"
msgstr "After establishing yourself on the realm torn by war, a distant roar calls for your attention. \"{PlayerLeader.Title}, you tread upon the cosmic battlefields of the Ashen War.\""

msgid "STORY_EVENT@1140_622@BODY_LORE"
msgstr "The voice turns mournful. \"Six Elder {GLOBAL.DragonsLoreConcept.Hyperlink}, brothers and sisters in Creation, torn asunder by strife. On one side, the Reshapers. {CreatorDragon.FirstName}, {DestroyerDragon.FirstName} and {DeathDragon.FirstName}, guarding cosmic balance of creation and destruction. On the other, the Dawnwardens {NatureDragon.FirstName}, {OrderDragon.FirstName} and {AstralDragon.FirstName}, fighting to maintain the precious beauty of life and spirit.\""

msgid "STORY_EVENT@1140_622@BUTTON_0"
msgstr "\"Life is sacred and must be protected. I agree with the Dawnwardens.\""

msgid "STORY_EVENT@1140_622@BUTTON_1"
msgstr "\"There needs to be balance between creation and destruction. The Reshapers seem to understand that.\""

msgid "STORY_EVENT@1140_622@BUTTON_2"
msgstr "\"This Ashen War will end by my hand and mine alone.\""

msgid "STORY_EVENT@1140_622@TITLE"
msgstr "The Ashen War"

msgid "STORY_EVENT@1140_623@BODY_FOOTER"
msgstr "Your people cheer you on as you return to {GLOBAL.MagehavenLoreConcept.Hyperlink}, victorious."

msgid "STORY_EVENT@1140_623@BODY_HEADER"
msgstr "You have allied with the Dawnwardens and secured a victory for the defenders of life and spirit."

msgid "STORY_EVENT@1140_623@BODY_LORE"
msgstr "Under your watchful eye, the realm flourishes with life as the victorious {GLOBAL.DragonsLoreConcept.Hyperlink} rise in the sky to spread justice, knowledge and verdant glory. Perhaps the cosmos needs destruction and death, but not this realm. Not this day."

msgid "STORY_EVENT@1140_623@BUTTON_0"
msgstr "A glorious victory for {PlayerLeader.TitleName}."

msgid "STORY_EVENT@1140_623@TITLE"
msgstr "The Ashen War: Dawnwarden Victory"

msgid "STORY_EVENT@1140_624@BODY_FOOTER"
msgstr "Your people cheer you on as you return to {GLOBAL.MagehavenLoreConcept.Hyperlink}, victorious."

msgid "STORY_EVENT@1140_624@BODY_HEADER"
msgstr "You have allied with the Reshapers and secured a victory for the guards of rebirth and balance."

msgid "STORY_EVENT@1140_624@BODY_LORE"
msgstr "Under your watchful eye, the cycle of life and death continues. From ashes new life sprouts, from mourning new creations emerge. Life is beautiful, but it means nothing without death. This cosmic balance will not be disturbed. Not this day."

msgid "STORY_EVENT@1140_624@BUTTON_0"
msgstr "A glorious victory for {PlayerLeader.TitleName}."

msgid "STORY_EVENT@1140_624@TITLE"
msgstr "The Ashen War: Reshaper Victory"

msgid "STORY_EVENT@1140_625@BODY_FOOTER"
msgstr "Your people cheer you on as you return to {GLOBAL.MagehavenLoreConcept.Hyperlink}, victorious."

msgid "STORY_EVENT@1140_625@BODY_HEADER"
msgstr "Through tremendous effort you have brought together both the Dawnwardens and the Reshapers in an alliance they could never imagine."

msgid "STORY_EVENT@1140_625@BODY_LORE"
msgstr "Negotiations are difficult. {GLOBAL.DragonsLoreConcept.Hyperlink} are not known for their patience and forgiving nature. But you, the one they deem Dawnshaper, manage to bring them together as they were before. Life and Death, Order and Chaos, the ethereal and the physical. Destruction must not be wanton, but it is necessary to truly allow progress. You manage to form a renewed alliance between them, bringing balanced peace to the realm."

msgid "STORY_EVENT@1140_625@BUTTON_0"
msgstr "A glorious victory for {PlayerLeader.TitleName}."

msgid "STORY_EVENT@1140_625@TITLE"
msgstr "The Ashen War: Peace and Balance"

msgid "STORY_EVENT@1140_730@BODY_FOOTER"
msgstr "Please"

msgid "STORY_EVENT@1140_730@BODY_HEADER"
msgstr "{Laryssa.Name} greets you. \"Hi. {Reaver.Name} and her {ReaverRace.Name} are fighting against {Progenitor.Name} and the {ProgenitorRace.Name}. This is crazy"

msgid "STORY_EVENT@1140_743@BODY_HEADER"
msgstr "{Reaver.Name} and {Progenitor.Name}"

msgid "STORY_EVENT@1140_757@TITLE"
msgstr "Meeting the Reavers"

msgid "STORY_EVENT@1140_75@BODY_FOOTER"
msgstr "The Godir called {EventLithyl.FirstName} attempts to argue further but {EventNimue.FirstName} dismisses her, unaware that you overheard this conversation."

msgid "STORY_EVENT@1140_75@BODY_FOOTER@NIMUE_DEFEATED"
msgstr "The Godir called {EventLithyl.FirstName} attempts to argue further but the guards do not budge. None of them seem to realize that you overheard this conversation."

msgid "STORY_EVENT@1140_75@BODY_HEADER"
msgstr "Elya's song grows louder; you feel her prison is nearby. Suddenly, a rift opens, allowing you to spy on a half-masked {GLOBAL.GodirLoreConcept.Hyperlink} speaking to {EventNimue.FirstName}."

msgid "STORY_EVENT@1140_75@BODY_HEADER@NIMUE_DEFEATED"
msgstr "{GLOBAL.ElyaLoreConcept.Hyperlink}'s song grows louder, you feel her prison is nearby. Suddenly a rift opens, allowing you to spy on a half-masked {GLOBAL.GodirLoreConcept.Hyperlink} speaking to the prison guards."

msgid "STORY_EVENT@1140_75@BODY_LORE"
msgstr "\"What is this I hear about the imprisoned {GLOBAL.MaerLoreConcept.Hyperlink}?\" The unknown Godir says. \"We agreed that you would set her free. She has served her purpose.\"[br/]{EventNimue.FirstName} scoffs. \"We discussed it. And I decided against it. My work is not yet done, {EventLithyl.FirstName}!\"[br/]The half-masked Godir answers, annoyed, \"You fool. The {GLOBAL.CovenantFactionLoreConcept.Hyperlink} is investigating already. If they find out about the Gildercoil...\""

msgid "STORY_EVENT@1140_75@BODY_LORE@NIMUE_DEFEATED"
msgstr "\"What is this I hear about the imprisoned {GLOBAL.MaerLoreConcept.Hyperlink}?\" The unknown Godir says. \"I asked {EventNimue.FirstName} to set her free. She has served her purpose.\"[br/]The guard answers. \"The {EventNimue.Title} decided against it, {EventLithyl.Title} {EventLithyl.FirstName}.\"[br/]The half-masked Godir answers, annoyed, \"The fool. The {GLOBAL.CovenantFactionLoreConcept.Hyperlink} is investigating already. If they find out about the Gildercoil...\""

msgid "STORY_EVENT@1140_75@BUTTON_0"
msgstr "Leave the Shad'rai to their bickering."

msgid "STORY_EVENT@1140_75@TITLE"
msgstr "Nearing the Prison"

msgid "STORY_EVENT@1149_11@BODY_FOOTER"
msgstr "Your guard catches your attention by speaking up: \"Mighty {PlayerLeader.Title}, what are we to do with the thief?\""

msgid "STORY_EVENT@1149_11@BODY_HEADER"
msgstr "There is tumult near your hoard, where you store your precious treasures. One of your guards brings a <<EventHero{man/woman}>> of the {EventRace} in front of you."

msgid "STORY_EVENT@1149_11@BODY_LORE"
msgstr "\"We found this thief trying to steal the {EventItem} from your hoard,\" the guard explains. The thief looks up at you with fear in <<o:EventHero>> eyes. <<Cp:EventHero>> realizes how sacred a thing the hoard of a [hyperlink,GLOBAL.DragonsLoreConcept]Dragon[/hyperlink] is, and how wrathful Dragons are known to be. Having entered your vault, <<p:EventHero>> needs to be punished."

msgid "STORY_EVENT@1149_11@BUTTON_0"
msgstr "\"Strip <<P:EventHero>> of <<o:EventHero>> belongings and take what is valuable to my hoard.\" [item/]"

msgid "STORY_EVENT@1149_11@BUTTON_1"
msgstr "\"If <<p:EventHero>> values <<o:EventHero>> life, <<p:EventHero>> will enrich [gold/] my hoard instead.\""

msgid "STORY_EVENT@1149_11@BUTTON_10"
msgstr "\"The strong prey upon the weak. Remember this as I feast upon this thief.\" [evilact/] [natureboon/]"

msgid "STORY_EVENT@1149_11@BUTTON_11"
msgstr "\"Hold a ceremony. <<Cp:EventHero>> shall be sacrificed to our faith.\" [evilact/] [orderboon/]"

msgid "STORY_EVENT@1149_11@BUTTON_12"
msgstr "\"Bind <<o:EventHero>> soul to my vault to guard the place for all eternity.\" [evilact/] [shadowboon/]"

msgid "STORY_EVENT@1149_11@BUTTON_2"
msgstr "\"Kill the thief and burn down <<o:EventHero>> home village. Nobody touches my hoard!\" [evilact/] [influence/]"

msgid "STORY_EVENT@1149_11@BUTTON_3"
msgstr "\"Exile <<P:EventHero>>! <<Cp:EventHero>> will tell tales of my hoard.\" [influence/]"

msgid "STORY_EVENT@1149_11@BUTTON_4"
msgstr "\"Summon the terrors of the Astral Sea upon <<P:EventHero>>.\" [evilact/] [astralboon/]"

msgid "STORY_EVENT@1149_11@BUTTON_5"
msgstr "\"Kill the thief and burn down <<o:EventHero>> house. Nobody touches my hoard!\" [evilact/] [chaosboon/]"

msgid "STORY_EVENT@1149_11@BUTTON_6"
msgstr "\"Bathe {EventHero.FirstName} in the gold <<p:EventHero>> so desires... until <<p:EventHero>> drowns.\" [evilact/] [materiumboon/]"

msgid "STORY_EVENT@1149_11@TITLE"
msgstr "Thief"

msgid "STORY_EVENT@1149_12@BODY_FOOTER"
msgstr "\"Please, accept our tribute!\" The leader of the group removes the tarp with a flourish, revealing a giant egg. A Dragon egg."

msgid "STORY_EVENT@1149_12@BODY_HEADER"
msgstr "You hear wheels of a wagon coming closer. A tarp covers a large, round object underneath."

msgid "STORY_EVENT@1149_12@BODY_LORE"
msgstr "A group of hooded figures dragging the wagon is headed straight towards you. As they bow down in front of you, you realize they are citizens of {EventHouse}. Their leader speaks: \"We traveled far to bring you this as a tribute, O {PlayerLeader.Title}. It was kept safe in a hidden shrine, until a worthy Dragon returned.\""

msgid "STORY_EVENT@1149_12@BUTTON_0"
msgstr "\"I will hatch and grow it [food/] to become a powerful Dragon [unit/].\""

msgid "STORY_EVENT@1149_12@BUTTON_1"
msgstr "Eat it [evilact/] to gain its power [xp/]. \"I shall be the only one!\""

msgid "STORY_EVENT@1149_12@BUTTON_2"
msgstr "\"It would be an honor to see {EventHouse} hatch a new Dragonkin [allegiance/].\""

msgid "STORY_EVENT@1149_12@TITLE"
msgstr "The Gift"

msgid "STORY_EVENT@1149_13@BODY_FOOTER"
msgstr "Your can sense two groups of quarry worthy of a Dragon of your statute."

msgid "STORY_EVENT@1149_13@BODY_HEADER"
msgstr "Ancient urges inside you awaken, and you feel the desire to hunt suddenly overcome you."

msgid "STORY_EVENT@1149_13@BODY_LORE"
msgstr "As a [hyperlink,GLOBAL.DragonsLoreConcept]Dragon[/hyperlink] you have sheer limitless power. You can fly higher than birds, channel magic unknown to wizards. Kings bow before your might. However, sometimes the beast within you awakens and you get cravings. Cravings to hunt."

msgid "STORY_EVENT@1149_13@BUTTON_0"
msgstr "Hunt cattle [food/] on their way to {PlayerCity}."

msgid "STORY_EVENT@1149_13@BUTTON_1"
msgstr "Devour [evilact/] the {EventRace} in one of the border villages of {EventHouse}."

msgid "STORY_EVENT@1149_13@BUTTON_2"
msgstr "Suppress [morale/] the urge. You are not a slave to your cravings."

msgid "STORY_EVENT@1149_13@TITLE"
msgstr "Craving a Hunt"

msgid "STORY_EVENT@1149_19@BODY_FOOTER"
msgstr "You know <<G:location^n,EventHero>>. Do you want to engage?"

msgid "STORY_EVENT@1149_19@BODY_HEADER"
msgstr "A challenge passed from mouth to mouth catches your attention. {EventHero} proclaims <<r:EventHero>> a Dragon slayer and you as <<o:EventHero>> target."

msgid "STORY_EVENT@1149_19@BODY_LORE"
msgstr "There are rumors that <<p:EventHero>> killed Dragons before. <<Cp:EventHero>> is said to be a [hyperlink,GLOBAL.HeroConcept]<<EventRuler{hero/heroine}>>[/hyperlink] who takes revenge for the terror inflicted by [hyperlink,GLOBAL.DragonsLoreConcept]Dragons[/hyperlink] throughout the ages. \"We should teach <<P:EventHero>> a lesson, {PlayerLeader.TitleName}\", one of your subordinates says."

msgid "STORY_EVENT@1149_19@BUTTON_0"
msgstr "We will deal with this so-called \"hero\"."

msgid "STORY_EVENT@1149_19@BUTTON_1"
msgstr "Ignore <<P:EventHero>>."

msgid "STORY_EVENT@1149_19@BUTTON_2"
msgstr "\"I refuse to fight [goodact/], and will convince {EventHero.FirstName} [influence/] that not all dragons are evil.\""

msgid "STORY_EVENT@1149_19@TITLE"
msgstr "Dragon Slayer"

msgid "STORY_EVENT@1149_20@BODY_FOOTER"
msgstr "Your people look toward you expectantly as you ponder the fallen Dragon Slayer. What do you do?"

msgid "STORY_EVENT@1149_20@BODY_HEADER"
msgstr "{EventHero} lies dead in the dirt. The fight is over."

msgid "STORY_EVENT@1149_20@BODY_LORE"
msgstr "\"You bested <<P:EventHero>>, but more could always follow. In the history of your kin there are always dragon slayers involved. In {GLOBAL.AthlaLoreConcept.Hyperlink}, a world quite like this, {GLOBAL.DragonsLoreConcept.Hyperlink} were hunted to extinction. You will not let that happen here. You need to send a signal.\""

msgid "STORY_EVENT@1149_20@BUTTON_0"
msgstr "Let this be a lesson. No {PlayerLeader.Title}, nor the {EventRace} will bow to puny Heroes. [influence/]"

msgid "STORY_EVENT@1149_20@BUTTON_1"
msgstr "Display <<o:EventHero>> scorched body in your capital, as a message to other ambitious \"Dragon slayers.\" [happiness/]"

msgid "STORY_EVENT@1149_20@BUTTON_3"
msgstr "Give {EventHero} a Dragon burial to honor <<P:EventHero>>. [goodact/]"

msgid "STORY_EVENT@1149_20@BUTTON_4"
msgstr "Feed on the corpse for power. [evilact/] [xp/]"

msgid "STORY_EVENT@1149_20@TITLE"
msgstr "Dragon Slayer: Aftermath"

msgid "STORY_EVENT@1149_22@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> with {EventHouse} and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} to you."

msgid "STORY_EVENT@1149_22@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} of {EventHouse.Name} greets you with a nod."

msgid "STORY_EVENT@1149_22@BODY_LORE"
msgstr "\"Greetings, {PlayerLeader.TitleName}! You, like us, seem to understand what is necessary to discard the fetters that burden this realm. Your folk is united under the banner of progress. Our interests align. Let us act upon it.\""

msgid "STORY_EVENT@1149_22@BUTTON_0"
msgstr "Inspect their military might."

msgid "STORY_EVENT@1149_22@BUTTON_2"
msgstr "Leave them be. You have other plans."

msgid "STORY_EVENT@1149_22@TITLDLC@EMPIRESANDASHES@E"
msgstr "Meeting Pragmatic {EventHouse.Name}"

msgid "STORY_EVENT@1149_22@TITLE"
msgstr "Meeting Pragmatic {EventHouse.Name}"

msgid "STORY_EVENT@1149_23@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> with {EventHouse} and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} to you."

msgid "STORY_EVENT@1149_23@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} of {EventHouse.Name} greets you with a nod."

msgid "STORY_EVENT@1149_23@BODY_LORE"
msgstr "\"Greetings, {PlayerLeader.TitleName}! Your culture intrigues us, and believe a cooperation could benefit us all. With our technology and your expertise as {GLOBAL.GodirLoreConcept.Hyperlink} we can make this realm truly ours. Why don't we set up communication and become powerful allies?\""

msgid "STORY_EVENT@1149_23@BUTTON_0"
msgstr "Inspect {EventHouse.Name}."

msgid "STORY_EVENT@1149_23@BUTTON_2"
msgstr "Decline the offer, for now."

msgid "STORY_EVENT@1149_23@TITLE"
msgstr "Meeting Expansionist {EventHouse.Name}"

msgid "STORY_EVENT@1149_24@BODY_FOOTER"
msgstr "Give {EventHouseLord} one of your <<m:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>> to start <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> with {EventHouse} and gradually improve their {GLOBAL.HouseInfluenceConcept.Hyperlink} to you."

msgid "STORY_EVENT@1149_24@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} of {EventHouse.Name} greets you with a stern face."

msgid "STORY_EVENT@1149_24@BODY_LORE"
msgstr "\"What do you want on this realm, {PlayerLeader.TitleName}? Conquer? Pillage? Destroy? Our weapons are sharp, our guns are loaded. We will fight you if we must, but let us not grind ourselves to death. A peaceful solution would be more practical. Do you agree?\""

msgid "STORY_EVENT@1149_24@BUTTON_0"
msgstr "Investigate whether {EventHouse} is worthy of your attention."

msgid "STORY_EVENT@1149_24@BUTTON_2"
msgstr "Keep your business to yourself."

msgid "STORY_EVENT@1149_24@TITLE"
msgstr "Meeting Militant {EventHouse.Name}"

msgid "STORY_EVENT@1149_25@BODY_FOOTER"
msgstr "You are at war with {EventHouse.Name}."

msgid "STORY_EVENT@1149_25@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} greets you with hostility."

msgid "STORY_EVENT@1149_25@BODY_LORE"
msgstr "\"You are in our way, {PlayerLeader.Name}! War is inevitable. We {EventHouseRace.Name} of {EventHouse.Name} are proud people and will fight for our freedom. With our spears sharpened and magelocks loaded we can defeat everyone else who threatens us, even the likes of you.\""

msgid "STORY_EVENT@1149_25@BUTTON_0"
msgstr "Inspect the insolent {EventHouse.Name}."

msgid "STORY_EVENT@1149_25@BUTTON_2"
msgstr "\"So be it!\""

msgid "STORY_EVENT@1149_25@TITLE"
msgstr "Meeting Hostile {EventHouse.Name}"

msgid "STORY_EVENT@1149_26@BODY_FOOTER"
msgstr "The {EventStackLeader} nods sternly. “Unfortunately, I need to ask you to leave. This place belongs to {EventHouse}.”"

msgid "STORY_EVENT@1149_26@BODY_HEADER"
msgstr "The sound of gunfire shatters the sky. Thick clouds gather around the {EventStructure.Name}. A company of fighters of free city is practicing with magelock weapons."

msgid "STORY_EVENT@1149_26@BODY_LORE"
msgstr "One of the soldiers tries to get your attention. With a proud smile <<p:EventStackLeader>> explains: “These guns are the pinnacle of technology, strong enough to slay any beast! By flipping a switch anyone can become a powerful fighter. Your aim is important, of course, but seriously …”, <<p:EventStackLeader>> shoots the head off a practice dummy to underline <<o:EventStackLeader>> point. “We created something truly magnificent here.”"

msgid "STORY_EVENT@1149_26@BUTTON_1"
msgstr "\"Leave and {EventCity} will give you the best training possible.\""

msgid "STORY_EVENT@1149_26@BUTTON_2"
msgstr "\"I claim this {EventStructure}. {EventHouse} will fall!\""

msgid "STORY_EVENT@1149_26@BUTTON_3"
msgstr "\"I will leave you to your training.\""

msgid "STORY_EVENT@1149_26@BUTTON_4"
msgstr "\"Enter my service instead and I will shower you in gold!\""

msgid "STORY_EVENT@1149_26@BUTTON_5"
msgstr "\"I challenge you to a duel! The winner gets the {EventStructure.Name}.\""

msgid "STORY_EVENT@1149_26@TITLE"
msgstr "Magelock weapon practice"

msgid "STORY_EVENT@1149_2@BODY_FOOTER"
msgstr "Thinking of how far you've come empowers you. How will you use this sudden surge of power?"

msgid "STORY_EVENT@1149_2@BODY_HEADER"
msgstr "As a {GLOBAL.WizardKingLoreConcept.Hyperlink}, you remember your first uneasy steps as you returned from the [hyperlink,GLOBAL.AstralVoidLoreConcept]void[/hyperlink], long before arriving on this realm."

msgid "STORY_EVENT@1149_2@BODY_LORE"
msgstr "Time has passed since. You have already gained a following and made a name for yourself. The years of [hyperlink,GLOBAL.ShadowTrialLoreConcept]torment[/hyperlink] lie behind you now and you are able to live in the moment again. The {GLOBAL.AstralFlowsLoreConcept.Hyperlink} bend to your will. It is time to look forward."

msgid "STORY_EVENT@1149_2@BUTTON_0"
msgstr "Use it to impress [influence/] the entire realm."

msgid "STORY_EVENT@1149_2@BUTTON_1"
msgstr "Focus on your people instead and prepare a feast [food/]."

msgid "STORY_EVENT@1149_2@BUTTON_2"
msgstr "Create an army [unit/] to conquer this realm."

msgid "STORY_EVENT@1149_2@BUTTON_3"
msgstr "[chaos/] Inspire others to embrace their powers [unitprod/]."

msgid "STORY_EVENT@1149_2@BUTTON_4"
msgstr "[arcana/] Explore how to recreate this power surge [knowledge/]."

msgid "STORY_EVENT@1149_2@BUTTON_5"
msgstr "[matter/] Inspire your builders [structureprod/]."

msgid "STORY_EVENT@1149_2@BUTTON_6"
msgstr "[nature/] Fill {EventCity} with plants of your home realm [happiness/]."

msgid "STORY_EVENT@1149_2@BUTTON_7"
msgstr "[shadow/] Use it to gather whispered secrets and sell them [gold/]."

msgid "STORY_EVENT@1149_2@BUTTON_8"
msgstr "[order/] Pull in the faith of your people and convert it into energy [mana/]."

msgid "STORY_EVENT@1149_2@BUTTON_9"
msgstr "[order/] Store it as mana [mana/] to be used later."

msgid "STORY_EVENT@1149_2@TITLE"
msgstr "Return of the Wizard King"

msgid "STORY_EVENT@1149_34@BUTTON_3"
msgstr "\"Let me guide you to a more righteous cause.\" [orderboon/]"

msgid "STORY_EVENT@1149_38@BODY_FOOTER"
msgstr "You are at war with {EventHouse.Name}."

msgid "STORY_EVENT@1149_38@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} greets you with a wicked smile."

msgid "STORY_EVENT@1149_38@BODY_LORE"
msgstr "\"Your so-called [hyperlink,GLOBAL.AlignmentConcept]'benevolence'[/hyperlink] only makes you weak. I will prove to the people of {EventHouse}, and everyone in this realm, that there is no such thing as right and wrong... Only strength and weakness.\""

msgid "STORY_EVENT@1149_38@TITLE"
msgstr "Meeting Misguided {EventHouse.Name}"

msgid "STORY_EVENT@1149_39@BODY_FOOTER"
msgstr "You are at war with {EventHouse.Name}."

msgid "STORY_EVENT@1149_39@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} looks at you, disgusted."

msgid "STORY_EVENT@1149_39@BODY_LORE"
msgstr "\"How can you be so [hyperlink,GLOBAL.AlignmentConcept]evil[/hyperlink]? How can you sleep whilst those before you cower in fear? I may not have a chance of defeating you, but I have a responsibility to all the people on this realm to stand up to you. May the combined forces of good bring your evil reign to an end.\""

msgid "STORY_EVENT@1149_39@TITLE"
msgstr "Meeting Deluded {EventHouse.Name}"

msgid "STORY_EVENT@1149_42@BUTTON_0"
msgstr "Inspect the self-righteous {EventHouse.Name}."

msgid "STORY_EVENT@1149_42@BUTTON_1"
msgstr "\"So be it!\""

msgid "STORY_EVENT@1149_43@BUTTON_0"
msgstr "Inspect the warmongering {EventHouse.Name}."

msgid "STORY_EVENT@1149_43@BUTTON_1"
msgstr "\"So be it!\""

msgid "STORY_EVENT@1149_44@BODY_FOOTER"
msgstr "You are at war with {EventHouse.Name}."

msgid "STORY_EVENT@1149_44@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} greets you with regret in their eyes."

msgid "STORY_EVENT@1149_44@BODY_LORE"
msgstr "\"It is unfortunate we meet like this, {PlayerLeader.TitleName}, but it seems war between us is inevitable. We, the people of {EventHouse.Name} will fight for what is [hyperlink,GLOBAL.AlignmentConcept]good[/hyperlink] and for a brighter future. A future without you.\""

msgid "STORY_EVENT@1149_44@BUTTON_0"
msgstr "Inspect the bigoted {EventHouse.Name}."

msgid "STORY_EVENT@1149_44@BUTTON_1"
msgstr "\"Let me guide you to a more righteous cause.\" [orderboon/]"

msgid "STORY_EVENT@1149_44@BUTTON_2"
msgstr "\"So be it!\""

msgid "STORY_EVENT@1149_44@TITLE"
msgstr "Meeting Misled {EventHouse.Name}"

msgid "STORY_EVENT@1149_45@BODY_FOOTER"
msgstr "You are at war with {EventHouse.Name}."

msgid "STORY_EVENT@1149_45@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} threatens you."

msgid "STORY_EVENT@1149_45@BODY_LORE"
msgstr "\"Some may consider you a [hyperlink,GLOBAL.GodirLoreConcept]god[/hyperlink], I do not. I know your weaknesses, I know how to make even a Godir bleed. Fear the power of {EventHouse.Name}, for your time has come.\""

msgid "STORY_EVENT@1149_45@BUTTON_0"
msgstr "Inspect the insolent {EventHouse.Name}."

msgid "STORY_EVENT@1149_45@BUTTON_1"
msgstr "\"So be it!\""

msgid "STORY_EVENT@1149_45@TITLE"
msgstr "Meeting Vicious {EventHouse.Name}"

msgid "STORY_EVENT@1149_47@BODY_FOOTER"
msgstr "Having found no way of defeating you, the mechanical guardian seems to await your reaction. What do you do?"

msgid "STORY_EVENT@1149_47@BODY_HEADER"
msgstr "While moving in to attack your army, the mechanical {EventStackLeader} suddenly comes to a halt and inspects your troops."

msgid "STORY_EVENT@1149_47@BODY_LORE"
msgstr "The gears inside <<o:EventStackLeader>> metal body are turning. Smoke escapes the crevices of <<o:EventStackLeader>> hull. With a bone-chilling gaze the {EventStackLeader.Name} inspects every single opponent, looking for weaknesses. <<Cp:EventStackLeader>> does not seem to find any."

msgid "STORY_EVENT@1149_47@BUTTON_0"
msgstr "Attack them anyways."

msgid "STORY_EVENT@1149_47@BUTTON_1"
msgstr "Give them a new purpose and send them on their way. [goodact/]"

msgid "STORY_EVENT@1149_47@BUTTON_2"
msgstr "Use their stunned state to disable [evilact/] and disassemble them. [knowledge/]"

msgid "STORY_EVENT@1149_47@BUTTON_3"
msgstr "Attempt to change their directives to serve you. [unit/]"

msgid "STORY_EVENT@1149_47@TITLE"
msgstr "Failure to Follow Directive"

msgid "STORY_EVENT@1149_4@BODY_FOOTER"
msgstr "In the darkness, you had but one thing to hold on to, a piece of who you were before. What memory preserved your sanity?"

msgid "STORY_EVENT@1149_4@BODY_HEADER"
msgstr "As a {GLOBAL.WizardKingLoreConcept.Hyperlink}, you have seen the {GLOBAL.AstralVoidLoreConcept.Hyperlink}, and memories of it haunt you. Even now, you find your mind drifting back."

msgid "STORY_EVENT@1149_4@BODY_LORE"
msgstr "You are [hyperlink,GLOBAL.ShadowTrialLoreConcept]haunted[/hyperlink] by lonesome centuries spent floating in the vast nothingness of the Void, where monstrous voices from your past twisted and distorted your deepest convictions. You saw visions of a grim future riddled by loss and insanity. More than once you felt your soul dissolve in the endless void."

msgid "STORY_EVENT@1149_4@BUTTON_0"
msgstr "\"I founded empires [influence/] that impressed Wizards and Kings!\""

msgid "STORY_EVENT@1149_4@BUTTON_1"
msgstr "\"I mastered the forbidden and lost lore [knowledge/]!\""

msgid "STORY_EVENT@1149_4@BUTTON_2"
msgstr "\"[order/] I commanded legions of fervent paladins [unit/]!\""

msgid "STORY_EVENT@1149_4@BUTTON_3"
msgstr "\"[chaos/] I spawned [population/] a host of savage minions!\""

msgid "STORY_EVENT@1149_4@BUTTON_4"
msgstr "\"[arcana/] I was an artist of the arcane [mana/]!\""

msgid "STORY_EVENT@1149_4@BUTTON_5"
msgstr "\"[matter/] I crafted unparalleled treasures [gold/] envied by dragons.\""

msgid "STORY_EVENT@1149_4@BUTTON_6"
msgstr "\"[nature/] I tended both plant and beast, and savored their bounties [food/].\""

msgid "STORY_EVENT@1149_4@BUTTON_7"
msgstr "\"[shadow/] I endlessly reshaped [unitprod/] my subjects in the shadows!\""

msgid "STORY_EVENT@1149_4@BUTTON_8"
msgstr "\"Feeble mortals reveled [happiness/] in my splendor!\""

msgid "STORY_EVENT@1149_4@BUTTON_9"
msgstr "\"I erected [structureprod/] grand towers in infinite realms!\""

msgid "STORY_EVENT@1149_4@TITLE"
msgstr "Echoes from the void"

msgid "STORY_EVENT@1149_6@BODY_FOOTER"
msgstr "While reliving past moments from your life, you find one more item that reminds you of where you came from. What is it?"

msgid "STORY_EVENT@1149_6@BODY_HEADER"
msgstr "When looking through your army's supplies, one of your {EventRace.Name} finds a container with items you thought long lost."

msgid "STORY_EVENT@1149_6@BODY_LORE"
msgstr "The box contains belongings that survived your travels and adventures. Every item contains memories of your former life. A memory of your childhood. Of the first time you used a spell. Of the time you became a leader."

msgid "STORY_EVENT@1149_6@BUTTON_0"
msgstr "A weapon [item/] taken from a fierce enemy."

msgid "STORY_EVENT@1149_6@BUTTON_1"
msgstr "A ring [item/] representing your bond with a special someone."

msgid "STORY_EVENT@1149_6@BUTTON_10"
msgstr "The {EventItemArmor}, a gift from a late friend [item/]."

msgid "STORY_EVENT@1149_6@BUTTON_2"
msgstr "[order/] An artifact [item/] of your faith."

msgid "STORY_EVENT@1149_6@BUTTON_3"
msgstr "[chaos/] The powerful {EventItemChaos} [item/] that accompanied you whenever you created chaos."

msgid "STORY_EVENT@1149_6@BUTTON_4"
msgstr "[arcana/] An enchanted item [item/] that helped you learn magic."

msgid "STORY_EVENT@1149_6@BUTTON_5"
msgstr "[matter/] An item [item/] you helped to create."

msgid "STORY_EVENT@1149_6@BUTTON_6"
msgstr "[nature/] The {EventItemNature} [item/], representing your bond with nature."

msgid "STORY_EVENT@1149_6@BUTTON_7"
msgstr "[shadow/] A memory [item/] of the first time you walked the shadows."

msgid "STORY_EVENT@1149_6@BUTTON_9"
msgstr "Lingering in the past will only hold you back. Sell everything [gold/]."

msgid "STORY_EVENT@1149_6@TITLE"
msgstr "Mementos of your former life"

msgid "STORY_EVENT@1149_7@BODY_FOOTER"
msgstr "It seems there are rumors among your people that you have grown distant from them. How do you respond?"

msgid "STORY_EVENT@1149_7@BODY_HEADER"
msgstr "The <<EventUnit {chairman/chairwoman}>> of the {EventRace} Council approaches you: \"Greetings {PlayerLeader.TitleName}, may I speak openly?\""

msgid "STORY_EVENT@1149_7@BODY_LORE"
msgstr "Without waiting for your response <<p:EventUnit>> continues: \"You were always one of us common people, but now you have [hyperlink,GLOBAL.GodirLoreConcept]ascended[/hyperlink]. With your magical abilities and your immortality, you are far above us and we fear you will become like the [hyperlink,GLOBAL.WizardKingLoreConcept]Wizard Kings[/hyperlink].\""

msgid "STORY_EVENT@1149_7@BUTTON_0"
msgstr "Throw them a feast [gold/] to show your affection [happiness/]."

msgid "STORY_EVENT@1149_7@BUTTON_1"
msgstr "Organize [structureprod/] a fair that honors [influence/] the PlayerRace past."

msgid "STORY_EVENT@1149_7@BUTTON_2"
msgstr "Investigate [knowledge/] the rumors and learn what exactly your people want [happiness/]."

msgid "STORY_EVENT@1149_7@BUTTON_3"
msgstr "Suppress those rumors with force [unitprod/]. They shall not question you! [happiness/] [evilact/]"

msgid "STORY_EVENT@1149_7@BUTTON_4"
msgstr "Ignore them [happiness/]. You have other problems."

msgid "STORY_EVENT@1149_7@TITLE"
msgstr "The Cost of Ascension"

msgid "STORY_EVENT@1149_8@BODY_FOOTER"
msgstr "One of your advisors steps up: “We need to respond to them, otherwise their aggressive claims will cause unrest in {EventCity}. What is your plan?”"

msgid "STORY_EVENT@1149_8@BODY_HEADER"
msgstr "\"{PlayerLeader.TitleName}, we do not want you here,\" declares the tough looking {EventHero} who approaches you without hesitation."

msgid "STORY_EVENT@1149_8@BODY_LORE"
msgstr "“I am the chosen representative of the {EventRace}. We were here long before you set foot in this realm. We have heard stories of <<m:{GLOBAL.WizardKingLoreConcept.Hyperlink}>>. You bring nothing but destruction! We will rise against you!” While one of your guards seizes the troublemaker, another guard speaks up to you: \"I've heard of them. They set up their camp near {EventCity}...”"

msgid "STORY_EVENT@1149_8@BUTTON_0"
msgstr "“Assuage them with food [food/] to show your good will.\" [goodact/]"

msgid "STORY_EVENT@1149_8@BUTTON_1"
msgstr "\"Send our scholars [knowledge/] to negotiate a treaty. Have them join [population/] our nation.\""

msgid "STORY_EVENT@1149_8@BUTTON_2"
msgstr "“Offer great riches [gold/] to everyone that would join my forces.\" [unit/]"

msgid "STORY_EVENT@1149_8@BUTTON_3"
msgstr "“Kill <<P:EventHero>> and <<o:EventHero>> conspirators. Use all force necessary.\" [unitprod/]"

msgid "STORY_EVENT@1149_8@BUTTON_4"
msgstr "\"Throwing <<P:EventHero>> in our prison will deter any opposition.\" [evilact/]"

msgid "STORY_EVENT@1149_8@BUTTON_5"
msgstr "\"Leave them be.\" [happiness/]"

msgid "STORY_EVENT@1149_8@TITLE"
msgstr "Native Opposition"

msgid "STORY_EVENT@1160_1605@BODY_FOOTER"
msgstr "Though the worst has passed, the volatile energies of the realm remain in flux, driving many towards violence and delirium still—especially on the battlefield."

msgid "STORY_EVENT@1160_1605@BODY_HEADER"
msgstr "The roaring beneath the earth recedes, yet the taint of madness still clings to every soul upon across the Azh'Ruun Pit."

msgid "STORY_EVENT@1160_1605@BODY_LORE"
msgstr "Though the earth no longer convulses with anger and the boiling seas settled back into uneasy calm, the precedent of mayhem remains. Across {GLOBAL.ObbadothLoreConcept.Hyperlink}, many blood-crazed denizens wander the smoldering streets with wild eyes and trembling hands, while a thunderous rumble still echoes faintly from the abyss below. The [hyperlink,GLOBAL.DemonicOverlordLoreConcept]Demon Overlords[/hyperlink] have relented their manic goading... but only slightly."

msgid "STORY_EVENT@1160_1605@BUTTON_0"
msgstr "\"We endured. Heads down and work on.\" [production/]"

msgid "STORY_EVENT@1160_1605@TITLE"
msgstr "Mayhem Begets Carnage"

msgid "STORY_EVENT@1160_1615@BODY_FOOTER"
msgstr "The Carnage Ritual falters, thus riots break out across the Pit as the outraged abyss drives many denizens of the realm to senseless slaughter."

msgid "STORY_EVENT@1160_1615@BODY_HEADER"
msgstr "The earth shakes. The boiling seas churn. Across The Azh'Ruun Pit, something vast has grown hungry."

msgid "STORY_EVENT@1160_1615@BODY_LORE"
msgstr "Lesser Fiends scatter in shrieking terror, hurling themselves into molten fissures and scalding rivers alike. Then the roar begins. Vast. Endless. A chorus of abyssal hunger clawing through every soul upon {GLOBAL.ObbadothLoreConcept.Hyperlink}.[br/][br/]\"Carnage! Carnage! More! MORE!\" The [hyperlink,GLOBAL.DemonicOverlordLoreConcept]Demon Overlords[/hyperlink] demand their due."

msgid "STORY_EVENT@1160_1615@BUTTON_0"
msgstr "Steel yourself."

msgid "STORY_EVENT@1160_1615@TITLE"
msgstr "A Crisis of Carnage"

msgid "STORY_EVENT@1160_1616@BODY_FOOTER"
msgstr "The worst of the abyssal hunger has thus passed, yet the Carnage Ritual still demands its endless tribute, lest this ravenous ire be awakened again."

msgid "STORY_EVENT@1160_1616@BODY_HEADER"
msgstr "The turbulent madness subsides as the raging abyss beneath the realm withdraws its ravenous ire from The Azh'Ruun Pit."

msgid "STORY_EVENT@1160_1616@BODY_LORE"
msgstr "Slowly, the screams fade. The trembling earth stills.[br/]Across {GLOBAL.ObbadothLoreConcept.Hyperlink}, blood-soaked denizens stagger from their murderous delirium as though waking from a nightmare. Deep beneath the world, the ravenous fury of the [hyperlink,GLOBAL.DemonicOverlordLoreConcept]Demon Overlords[/hyperlink] recedes once more into the dark.[br/][br/]For now, the abyss is sated."

msgid "STORY_EVENT@1160_1616@BUTTON_0"
msgstr "\"The work continues...\" [production/]"

msgid "STORY_EVENT@1160_1616@TITLE"
msgstr "The Nether Realms Subside"

msgid "STORY_EVENT@1160_1617@BODY_FOOTER"
msgstr "As the Carnage Ritual falters, volatile magical currents surge across the realm, driving all but the strongest minds into frenzied abandon."

msgid "STORY_EVENT@1160_1617@BODY_HEADER"
msgstr "The abyss roars anew as escalating madness sweeps across {GLOBAL.ObbadothLoreConcept.Hyperlink} like a plague of slaughter."

msgid "STORY_EVENT@1160_1617@BODY_LORE"
msgstr "The ritual falters once more. Again the boiling earth convulses. Again the skies howl with that dreadful chorus rising from beneath the world. Yet this time, the fury is greater. Sharper. Angrier. Across The Azh'Ruun Pit, entire villages abandon all restraint, while frenzied denizens butcher neighbor and kin alike beneath the unseen gaze of the wrathful [hyperlink,GLOBAL.DemonicOverlordLoreConcept]Demon Overlords[/hyperlink].[br/][br/]\"More Carnage! MORE!\""

msgid "STORY_EVENT@1160_1617@BUTTON_0"
msgstr "Hold fast through the mayhem."

msgid "STORY_EVENT@1160_1617@TITLE"
msgstr "The Pit Gone Rabid"

msgid "STORY_EVENT@1160_769@BODY_FOOTER"
msgstr "{EventHero.FirstName} has grown frustrated with <<o:EventHero>> current ambition. Will you permit <<P:EventHero>> a change of heart?"

msgid "STORY_EVENT@1160_769@BODY_HEADER"
msgstr "You are approached by your {GLOBAL.HeroConcept.Hyperlink}, {EventHero}. <<Co:EventHero>> expression betrays dejection and vexation."

msgid "STORY_EVENT@1160_769@BODY_LORE"
msgstr "After a deep sigh, <<p:EventHero>> declares: \"My whole life, I've always thought of myself as <<a:CurrentDestiny>>. But as of late, I am haunted by doubt. Is this my destined path towards {GLOBAL.RenownConcept.Hyperlink}? Or will plotting another course lead me to the success and satisfaction I currently lack, yet desperately crave?\""

msgid "STORY_EVENT@1160_769@BUTTON_0"
msgstr "\"Stay your course. Your destiny shall be fulfilled.\""

msgid "STORY_EVENT@1160_769@BUTTON_0@TOOLTIP_AMBITION"
msgstr "{EventHero} retains <<o:EventHero>> current ambition of {CurrentDestiny}."

msgid "STORY_EVENT@1160_769@BUTTON_1"
msgstr "\"Being <<a:ReplacementDestiny1>> suits you better.\""

msgid "STORY_EVENT@1160_769@BUTTON_2"
msgstr "\"Being <<a:ReplacementDestiny2>> is an admirable ambition.\""

msgid "STORY_EVENT@1160_769@TITLE"
msgstr "Change of Heart"

msgid "STORY_EVENT@1160_815@BODY_FOOTER"
msgstr "The {StructureResource} is expected to reside in your domain for {TurnCount} turns before moving on."

msgid "STORY_EVENT@1160_815@BODY_HEADER"
msgstr "Scouts report that a {StructureResource} traded the wilderness for your domain, and has set up camp {EventDirection} of {EventCity}."

msgid "STORY_EVENT@1160_815@BODY_LORE"
msgstr "\"We have not yet seen him with our own eyes, my {PlayerLeader.Title}.\" You detect admiration in your scout's voice. \"But we have found his camp and the many creatures <<p:ShopKeeper>> keeps there. The {ShopKeeper} has a reputation for selling them as mounts to whoever has the coin for these prized beasts.\" You consider what additions would benefit your stable."

msgid "STORY_EVENT@1160_815@BUTTON_0"
msgstr "\"As long as <<o:ShopKeeper>> creatures don't eat my {EventRace}, <<p:ShopKeeper>> is welcome.\""

msgid "STORY_EVENT@1160_815@BUTTON_1"
msgstr "\"Break up <<o:ShopKeeper>> camp. <<Co:ShopKeeper>> miscreants are not welcome here.\""

msgid "STORY_EVENT@1160_815@TITLE"
msgstr "Merchant of Mounts"

msgid "STORY_EVENT@1160_824@BODY_FOOTER"
msgstr "The Training Camp will depart after {Turns} turns."

msgid "STORY_EVENT@1160_824@BODY_HEADER"
msgstr "Rumors reach you that a renowned {ShopKeeper} set up a {StructureResource} in your domain, {EventDirection} of {EventCity}."

msgid "STORY_EVENT@1160_824@BODY_LORE"
msgstr "The {ShopKeeper} arrives in your court to pay <<o:ShopKeeper>> respects. \"Strength and wisdom to you. I was in service of renowned {GLOBAL.GodirLoreConcept.Hyperlink} an' rulers. Now, I walk own path. It be my honor to offer services to such great {PlayerLeader.Title} as you.\" Then, lowering <<o:ShopKeeper>> voice, <<p:ShopKeeper>> adds: \"Or whatever other {GLOBAL.GodirLoreConcept.Hyperlink} or {GLOBAL.HeroConcept.Hyperlink} come visit me.\""

msgid "STORY_EVENT@1160_824@BUTTON_0"
msgstr "\"Welcome, instructor! May you teach my Heroes well.\""

msgid "STORY_EVENT@1160_824@BUTTON_1"
msgstr "\"Begone, mercenary! Peddle your tricks elsewhere!\""

msgid "STORY_EVENT@1160_824@TITLE"
msgstr "Trader of Talents"

msgid "STORY_EVENT@1160_825@BODY_FOOTER"
msgstr "The Mystical Seer will depart after {Turns} turns."

msgid "STORY_EVENT@1160_825@BODY_HEADER"
msgstr "An advisor reports that a {StructureResource} set up shop {EventDirection} of {EventCity}, offering knowledge of faraway territories and rulers."

msgid "STORY_EVENT@1160_825@BODY_LORE"
msgstr "<<Cp:ShopKeeper>> visits you the same day. \"I sell secrets, {PlayerLeader.Title}. I know much about this realm and its [hyperlink,GLOBAL.GodirLoreConcept]denizens[/hyperlink]. And what little I know not, I divine.\" Your advisor then leans in and whispers: \"It is worth noting that <<p:ShopKeeper>> keeps the same information on you and yours for your rivals to exploit.\" The {ShopKeeper} presents an innocuous smile."

msgid "STORY_EVENT@1160_825@BUTTON_0"
msgstr "\"This excites me. Let me inspect your shop right away.\""

msgid "STORY_EVENT@1160_825@BUTTON_1"
msgstr "\"My realm is no place for <<m:StructureResource>>!\""

msgid "STORY_EVENT@1160_825@TITLE"
msgstr "Shop of Secrets"

msgid "STORY_EVENT@1160_857@BODY_FOOTER"
msgstr "\"I follow where my animals lead me. Not other way around. Perhaps they lead me back here some day.\""

msgid "STORY_EVENT@1160_857@BODY_HEADER"
msgstr "The {StructureResource} that resided in your domain has led <<o:ShopKeeper>> full menagerie before you to announce <<o:ShopKeeper>> departure."

msgid "STORY_EVENT@1160_857@BODY_LORE"
msgstr "Despite the aural explosion of growls, neighs, and bellows, the <<G:voice^n,ShopKeeper>> still sounds most clear. \"I go now. But I wanted to thank you for allowing my presence.\" The {ShopKeeper} gestures to his creatures. \"We not always welcome everywhere.\" <<Cp:ShopKeeper>> clicks <<o:ShopKeeper>> tongue and the beasts walk away in a line, like a procession. Two <<m:EventMount>> pull the <<G:cart^n,ShopKeeper>>."

msgid "STORY_EVENT@1160_857@BUTTON_0"
msgstr "The pursuit of new beasts and critters is fickle."

msgid "STORY_EVENT@1160_857@TITLE"
msgstr "Merchant of Mounts: Aftermath"

msgid "STORY_EVENT@1160_859@BODY_FOOTER"
msgstr "\"Horizon beckon me. I go seek new [hyperlink,GLOBAL.HeroConcept]Heroes[/hyperlink] to train. Farewell!\" The {ShopKeeper} sets <<o:ShopKeeper>> carriage in motion and drives away."

msgid "STORY_EVENT@1160_859@BODY_HEADER"
msgstr "The {ShopKeeper} has packed up the {StructureResource} <<p:ShopKeeper>> set up in your domain and is ready to depart."

msgid "STORY_EVENT@1160_859@BODY_LORE"
msgstr "\"Many [hyperlink,GLOBAL.HeroConcept]Heroes[/hyperlink] come to me. Now I must go to [hyperlink,GLOBAL.HeroConcept]Heroes[/hyperlink] again.\" The {ShopKeeper} draws a wooden sword and salutes you. \"But not here. Elsewhere. Away from you.\" You wonder if this was meant as an insult."

msgid "STORY_EVENT@1160_859@BUTTON_0"
msgstr "Such is the life of a wandering instructor. Until next time."

msgid "STORY_EVENT@1160_859@TITLE"
msgstr "Trader of Talents: Departed"

msgid "STORY_EVENT@1160_860@BODY_FOOTER"
msgstr "\"Would say hope we meet again. But I already know outcome.\" And with that, the {ShopKeeper} turns around and drives her cart out of sight."

msgid "STORY_EVENT@1160_860@BODY_HEADER"
msgstr "The {StructureResource} who spent some time in your domain has packed up and is ready to depart."

msgid "STORY_EVENT@1160_860@BODY_LORE"
msgstr "<<Cp:ShopKeeper>> has come to find you to say <<o:ShopKeeper>> goodbyes in person. \"Profitable my stay was. Very few regrets. Now, time to go.\""

msgid "STORY_EVENT@1160_860@BUTTON_0"
msgstr "Perhaps your destinies will meet again in the future."

msgid "STORY_EVENT@1160_860@TITLE"
msgstr "Shop of Secrets: Departed"

msgid "STORY_EVENT@1165_1350@BODY_FOOTER"
msgstr "You find yourself between two Godir who fight over nature's domain. With whom do you side?"

msgid "STORY_EVENT@1165_1350@BODY_HEADER"
msgstr "Soon after meeting {EventPlayer.TitleName}, <<p:EventPlayer>> contacts you. \"Nature's blessings-\" <<p:EventPlayer>> starts, but before <<p:EventPlayer>> can finish her greeting, <<p:EventPlayer>> is interrupted by none other than {EventPlayer2.TitleName}!"

msgid "STORY_EVENT@1165_1350@BODY_LORE"
msgstr "Immediately the two {GLOBAL.GodirLoreConcept.Hyperlink} start bickering. \"The blessings of {GLOBAL.NatureConcept} should be protected, not twisted and devolved,\" {Serena.FirstName} sneers: \"All who threaten my domain will be exterminated, even mad 'goddesses' like {Nimue.FirstName}.\"\n"
"\n"
"{Nimue.FirstName} scoffs. \"Whilst you were hiding in your forests, I was evolving my {NimueRace}. Only the strongest survive, and for that, you must adapt. Allow me to demonstrate!\""

msgid "STORY_EVENT@1165_1350@BUTTON_0"
msgstr "Side with {Serena.TitleName}."

msgid "STORY_EVENT@1165_1350@BUTTON_1"
msgstr "Side with {Nimue.TitleName}."

msgid "STORY_EVENT@1165_1350@BUTTON_2"
msgstr "Pick no side, let nature (and war) take its course."

msgid "STORY_EVENT@1165_1350@TITLE"
msgstr "The Primal Dispute"

msgid "STORY_EVENT@1165_1351@BODY_FOOTER"
msgstr "Your people cheer you on as you return to {GLOBAL.MagehavenLoreConcept.Hyperlink}, victorious."

msgid "STORY_EVENT@1165_1351@BODY_HEADER"
msgstr "You have resolved the conflict between the two bickering {GLOBAL.GodirLoreConcept.Hyperlink} of {GLOBAL.NatureConcept}, one way or another. A sense of peace returns to the realm."

msgid "STORY_EVENT@1165_1351@BODY_LORE"
msgstr "Whether this peace will last is unclear. Alliances crumble, friendships change, and the [hyperlink,GLOBAL.AstralVoidLoreConcept]Void[/hyperlink] twists any mind it touches. In the {GLOBAL.AstralSeaLoreConcept.Hyperlink}, few things are eternal.[br/]\n"
"But for now, the lands of {RealmName} are devoted to your rule."

msgid "STORY_EVENT@1165_1351@BUTTON_0"
msgstr "Victory is ours!"

msgid "STORY_EVENT@1165_1351@TITLE"
msgstr "The Primal Dispute: Resolved"

msgid "STORY_EVENT@1165_5112@TITLE"
msgstr "Melenis' Menace"

msgid "STORY_EVENT@1165_5244@BODY_FOOTER"
msgstr "{EventLeaderDefeated.TitleName} claims this realm for her own, Defeating <<P:EventLeaderDefeated>> will make your rule undeniable."

msgid "STORY_EVENT@1165_5244@BODY_HEADER"
msgstr "The ghostly visage of {EventLeaderDefeated.TitleName} appears before you and addresses you with a contemptuous tone, as though this meeting were beneath <<P:EventLeaderDefeated>> station."

msgid "STORY_EVENT@1165_5244@BODY_LORE"
msgstr "\"You trespass on my realm, warmblood. Stay out of my way and perhaps I'll see fit to let that blood run through your veins for a few moons more. Interfere, and it will feed the earth of my realm as all who came before.\""

msgid "STORY_EVENT@1165_5244@BUTTON_0"
msgstr "The Lich Queen must fall."

msgid "STORY_EVENT@1165_5244@TITLE"
msgstr "Domain of the Lich Queen"

msgid "STORY_EVENT@1165_5245@BODY_FOOTER"
msgstr "At last, you alone stand victorious in the <<o:EventLeaderDefeated>> throne room, none can deny your power now. The Realm is yours."

msgid "STORY_EVENT@1165_5245@BODY_HEADER"
msgstr "{EventLeaderDefeated} falls with a final curse on her lips, the undead legions that served her collapse to the earth as your troops revel in their victory."

msgid "STORY_EVENT@1165_5245@BODY_LORE"
msgstr "The great necropolis of <<g:former throne city^n,EventLeaderDefeated>> holds an unfathomable count of souls, a necromantic power none can deny, and few could defy."

msgid "STORY_EVENT@1165_5245@BUTTON_0"
msgstr "Bingbong the Lich is dead!"

msgid "STORY_EVENT@1165_5245@TITLE"
msgstr "The Lich Queen falls"

msgid "STORY_EVENT@1165_5278@BODY_FOOTER"
msgstr "Footer Text"

msgid "STORY_EVENT@1165_5278@BODY_HEADER"
msgstr "Header Text"

msgid "STORY_EVENT@1165_5278@BODY_LORE"
msgstr "Lore Text"

msgid "STORY_EVENT@1165_5278@BUTTON_0"
msgstr "OK, OK, let's kill them with hammers."

msgid "STORY_EVENT@1165_5278@TITLE"
msgstr "Vision of Promise"

msgid "STORY_EVENT@1167_1467@BODY_FOOTER"
msgstr "Will you seek to crush the festering cult in {EventCity}? Or do you trust the otherworldly influence to bring boons?"

msgid "STORY_EVENT@1167_1467@BODY_HEADER"
msgstr "A magistrate addresses you with great concern. \"We have a problem, {PlayerLeader.Title}. A cult develops in {EventCity}.\""

msgid "STORY_EVENT@1167_1467@BODY_LORE"
msgstr "<<Cp:EventUnit>> continues: \"Some of your people have begun to worship otherworldy beings, false gods that they view as supreme and allmighty. Frankly, It's unnerving the general population of {EventCity}. This may become a bigger issue over time, but it may not be too late to suppress the spread of the cult's ideology to make it disappear.\""

msgid "STORY_EVENT@1167_1467@BUTTON_0"
msgstr "Dispatch the city guard [unitprod/] to arrest the cultists. [population/]"

msgid "STORY_EVENT@1167_1467@BUTTON_1"
msgstr "Magically aid [mana/] the city guard [unitprod/] to expel the cultists. [population/]"

msgid "STORY_EVENT@1167_1467@BUTTON_2"
msgstr "Openly promote [evilact/] the cult. [chaosboon/]"

msgid "STORY_EVENT@1167_1467@BUTTON_3"
msgstr "Distract the population with games and festivals. [gold/]"

msgid "STORY_EVENT@1167_1467@BUTTON_4"
msgstr "Order governs {EventCity}. It always has and always will."

msgid "STORY_EVENT@1167_1467@BUTTON_5"
msgstr "Don't get involved. [happiness/] This will likely resolve itself."

msgid "STORY_EVENT@1167_1467@TITLE"
msgstr "Festering Cult"

msgid "STORY_EVENT@1167_1472@BODY_FOOTER"
msgstr "The summoned {EventUnit} grants the {EventRace} Infernal strength. You lose face, but perhaps this is not the worst possible outcome."

msgid "STORY_EVENT@1167_1472@BODY_HEADER"
msgstr "The cult that sprouted in {EventCity} some time ago has matured. Most citizens now follow the cult's Demonic Overlord, a {EventUnit}."

msgid "STORY_EVENT@1167_1472@BODY_LORE"
msgstr "The cultists have gathered in the streets to summon their overlord into this realm under the promise of great but terrible strength."

msgid "STORY_EVENT@1167_1472@BUTTON_0"
msgstr "Embrace the Demonic influence. [evilact/]"

msgid "STORY_EVENT@1167_1472@BUTTON_1"
msgstr "Attempt to counter [mana/] the transformation with all your power."

msgid "STORY_EVENT@1167_1472@BUTTON_2"
msgstr "Bind the {EventUnit} to your will."

msgid "STORY_EVENT@1167_1472@TITLE"
msgstr "Cult Manifested"

msgid "STORY_EVENT@1167_1473@BODY_FOOTER"
msgstr "Will you permit the Order of the {RandomIdol} to build their stronghold in {EventCity}?"

msgid "STORY_EVENT@1167_1473@BODY_HEADER"
msgstr "A {EventUnit} arrives before you. \"Hail, {PlayerLeader.Title}! I represent the {RandomWarriorTitle} of the {RandomIdol}. I have a proposal for you.\""

msgid "STORY_EVENT@1167_1473@BODY_LORE"
msgstr "\"Word has reached us of your resolute measures against the Demonic cult in {EventCity}. We are looking for a patron in our everlasting battle against evil and its wicked servants. We seek to establish a knightly order in your fair city. The Order of the {RandomIdol}.\""

msgid "STORY_EVENT@1167_1473@BUTTON_0"
msgstr "Permit them to establish the Order, giving them a small allowance. [gold/]"

msgid "STORY_EVENT@1167_1473@BUTTON_1"
msgstr "Help the {RandomWarriorTitle} build [structureprod/] their stronghold. It will strengthen <<G:defenses^p,EventCity>>. [fortification/]"

msgid "STORY_EVENT@1167_1473@BUTTON_2"
msgstr "Refuse and force the {RandomWarriorTitle} to leave their weapons [unitprod/] behind."

msgid "STORY_EVENT@1167_1473@TITLE"
msgstr "Order of the {RandomIdol}"

msgid "STORY_EVENT@1167_16@BODY_FOOTER"
msgstr "\"Sturdy empires are built with mighty blocks of stone! My {PlayerLeader.Title}, build more [hyperlink,GLOBAL.QuarryConcept][quarry/]Quarries[/hyperlink]!\" The chancellor awaits your response rhapsodically."

msgid "STORY_EVENT@1167_16@BODY_HEADER"
msgstr "\"{PlayerLeader.Title}, we must converse.\" A grave chancellor approaches you. \"While your armies fight in faraway lands, what defends your people?\""

msgid "STORY_EVENT@1167_16@BODY_LORE"
msgstr "\"I'll tell you what,\" the chancellor continues. \"Walls as high as mountains! As thick as the trunks of ageless oaks! If we are to prosper, we must build, build, build!\" The chancellor dispenses <<o:EventUnit>> industrious propaganda with fervent consumption. <<Cp:EventUnit>> wipes <<o:EventUnit>> chin dry. \"Or, we build recruitment halls, granaries... Anything that helps us win the war!\""

msgid "STORY_EVENT@1167_16@BUTTON_0"
msgstr "\"I subscribe to your industrious ambition! We need those Quarries!"

msgid "STORY_EVENT@1167_16@BUTTON_1"
msgstr "\"Forget it. Laborers [structureprod/] in {EventCity} just need to work harder. [happiness/]\""

msgid "STORY_EVENT@1167_16@BUTTON_2"
msgstr "\"I know of a faster way to win blocks of stone.\""

msgid "STORY_EVENT@1167_16@BUTTON_3"
msgstr "\"Begone, laborious fool. I have no desire for stone.\""

msgid "STORY_EVENT@1167_16@TITLE"
msgstr "Structured Defenses"

msgid "STORY_EVENT@1167_18@BODY_FOOTER"
msgstr "\"Your cities rejoice! They build anything we want!\" Stone now congests your cities' streets. How will you spend the excess?"

msgid "STORY_EVENT@1167_18@BODY_HEADER"
msgstr "Your chancellor gleefully hops back into your throne room. \"[hyperlink,GLOBAL.QuarryConcept][quarry/]Quarries[/hyperlink]! [hyperlink,GLOBAL.QuarryConcept][quarry/]Quarries[/hyperlink] as far as I can see!\""

msgid "STORY_EVENT@1167_18@BODY_LORE"
msgstr "The chancellor proceeds to tell in great detail how the stone is hauled into your cities. \"All across your realm, in every city, your citizens talk about how safe they feel, knowing that we have the materials for defensive structures.\" The chancellor claps <<o:EventUnit>> hands and smirks."

msgid "STORY_EVENT@1167_18@BUTTON_0"
msgstr "\"Sell the stone in markets. [gold/]\""

msgid "STORY_EVENT@1167_18@BUTTON_1"
msgstr "\"{EventCity} lies unprotected. We will build walls there.\""

msgid "STORY_EVENT@1167_18@BUTTON_2"
msgstr "\"Build statues and monuments to celebrate me! [influence/]\""

msgid "STORY_EVENT@1167_18@BUTTON_3"
msgstr "\"Use the excess stone for hammerheads and axe-shafts [unitprod/].\""

msgid "STORY_EVENT@1167_18@BUTTON_4"
msgstr "\"Transform [mana/] the blocks into a {EventUnitB}.\""

msgid "STORY_EVENT@1167_18@BUTTON_5"
msgstr "\"Boost your production in every city. [structureprod/]\""

msgid "STORY_EVENT@1167_18@TITLE"
msgstr "Structured Defenses: Aftermath"

msgid "STORY_EVENT@1167_19@BODY_FOOTER"
msgstr "\"I suggest befriending {EventHouseLord.FirstName} of {EventHouse}, my {PlayerLeader.Title}. So <<p:EventHouseLord>> may declare war on {TargetPlayer}.\" Will you support this scheme?"

msgid "STORY_EVENT@1167_19@BODY_HEADER"
msgstr "One of your more cunning advisors proposes a compelling scheme."

msgid "STORY_EVENT@1167_19@BODY_LORE"
msgstr "Your advisor grins. \"My {PlayerLeader.Title}! Too long has your pesky rival, {TargetPlayer} of the {TargetRace}, thwarted your goals. Someone ought to challenge <<P:TargetPlayer>>!\" You are about to educate your advisor on the risks and costs of warcrafting, when <<p:EventUnit>> continues. \"But YOU needn't raise your blade! What if we can pit the disposable City of {EventHouse} against {TargetPlayer}?\""

msgid "STORY_EVENT@1167_19@BUTTON_0"
msgstr "\"Once {EventHouse} is friendly towards us, they will attack my rival!\""

msgid "STORY_EVENT@1167_19@BUTTON_1"
msgstr "\"Cease your underhanded warmongering! [influence/] I do not condone backstabbing! [goodact/]\""

msgid "STORY_EVENT@1167_19@BUTTON_2"
msgstr "\"I fight my own battles. Leave me.\""

msgid "STORY_EVENT@1167_19@TITLE"
msgstr "Puppet Master"

msgid "STORY_EVENT@1167_20@BODY_FOOTER"
msgstr "You inveigled {EventHouse} to wage war on {TargetPlayer}. How will you aid their war effort from the shadows?"

msgid "STORY_EVENT@1167_20@BODY_HEADER"
msgstr "Good tidings! The {EventHouseLord.Title} of {EventHouse} has succumbed to your charms. <<Cp:EventHouseLord>> considers you <<o:EventHouseLord>> friend."

msgid "STORY_EVENT@1167_20@BODY_LORE"
msgstr "\"We are grateful for you pointing out the schemes of {TargetPlayer} and <<o:TargetPlayer>> treacherous {EventRace} against my people. They will pay for their crimes.\" The {EventHouseLord.Title} bows dutifully before you. \"We have already declared war on {TargetPlayer}, O {PlayerLeader.Title}!\" Your scheming advisor hungrily nods from behind a curtain."

msgid "STORY_EVENT@1167_20@BUTTON_0"
msgstr "\"I will conscript [gold/] a {EventUnitA} to reinforce their army.\""

msgid "STORY_EVENT@1167_20@BUTTON_1"
msgstr "\"I will summon [mana/] a {EventUnitB} for their army!\""

msgid "STORY_EVENT@1167_20@BUTTON_2"
msgstr "\"I will focus on strengthening my bond with {EventHouse}. [allegiance/]\""

msgid "STORY_EVENT@1167_20@BUTTON_3"
msgstr "\"Their war allows me to forge a casus belli against {TargetPlayer}!\""

msgid "STORY_EVENT@1167_20@TITLE"
msgstr "Puppet Master: Aftermath"

msgid "STORY_EVENT@1167_24@BODY_FOOTER"
msgstr "Your recruitment efforts are significantly enhanced upon acquiring {EventMaterial}. Will you seek out the rare material?"

msgid "STORY_EVENT@1167_24@BODY_HEADER"
msgstr "You send out brave warriors to fight wars. But will their numbers suffice? Your council has a suggestion."

msgid "STORY_EVENT@1167_24@BODY_LORE"
msgstr "\"The millstones of war continue to grind, my {PlayerLeader.Title}. We would benefit from augmenting our recruitment efforts. The more troops we send into battle against {EnemyLeader}, the sooner we claim victory. We caught wind of an enchanted substance that quickens your warriors' training. You should claim this {EventIngredient} for yourself.\""

msgid "STORY_EVENT@1167_24@BUTTON_0"
msgstr "\"I will conquer the {EventMaterial} and amass a vast army!\""

msgid "STORY_EVENT@1167_24@BUTTON_1"
msgstr "\"Send our builders' hammers [structureprod/] to the blacksmiths [unitprod/] of {EventCity} instead.\""

msgid "STORY_EVENT@1167_24@BUTTON_2"
msgstr "\"I don't need to find {EventMaterial}. I can shape it myself!\""

msgid "STORY_EVENT@1167_24@BUTTON_3"
msgstr "\"I can already muster all the warriors that victory requires.\""

msgid "STORY_EVENT@1167_24@TITLE"
msgstr "Battle Upgrades"

msgid "STORY_EVENT@1167_25@BODY_FOOTER"
msgstr "In addition to boosting recruitment, what other bonus should your alchemists draw from the {EventMaterial}?"

msgid "STORY_EVENT@1167_25@BODY_HEADER"
msgstr "Your alchemists murmur excitedly upon learning that you added {EventMaterial} to your stores. Your council congratulates you."

msgid "STORY_EVENT@1167_25@BODY_LORE"
msgstr "\"Mark my words, seas of our warriors will flood the battlefields. Our enemies will be unable to escape our might.\" One council member examines the {EventMaterial} and cries out: \"My {PlayerLeader.Title}, this substance is so potent, your mages and alchemists can extract a secondary application!\" The council awaits your response expectantly."

msgid "STORY_EVENT@1167_25@BUTTON_0"
msgstr "Boost the morale of our troops. [morale/]"

msgid "STORY_EVENT@1167_25@BUTTON_1"
msgstr "Augment the body and skills of {EventHero}."

msgid "STORY_EVENT@1167_25@BUTTON_2"
msgstr "Assemble a {EventUnit}. [unit/]"

msgid "STORY_EVENT@1167_25@BUTTON_3"
msgstr "Extract mana [mana/] from the {EventMaterial}."

msgid "STORY_EVENT@1167_25@TITLE"
msgstr "Battle Upgrades: Aftermath"

msgid "STORY_EVENT@1167_28@BODY_FOOTER"
msgstr "Your chancellor summarizes: \"After heroically defeating the mindless <<m:EventUnitB>> that we unleashed ourselves... We claim that {EnemyPlayer} ordered the attack.\""

msgid "STORY_EVENT@1167_28@BODY_HEADER"
msgstr "You war with {EnemyPlayer}! Your people are suffering under this war you declared. Most notably the city of {EventCity}."

msgid "STORY_EVENT@1167_28@BODY_LORE"
msgstr "One of your chancellors gulps. \"If it pleases my {PlayerLeader.Title}, I may know a way to regain your people's support.\" Before you can respond, <<p:EventUnit>> continues, \"Commoners endorse fights against heinous villains. So, we unleash some <<m:EventUnitB>> within our borders.\" You notice the sweat glistening on your chancellor's brow. \"Then, we let them wreak havoc.\""

msgid "STORY_EVENT@1167_28@BUTTON_0"
msgstr "Order the false flag attack and summon <<m:EventUnitB>> near {EventCity}."

msgid "STORY_EVENT@1167_28@BUTTON_1"
msgstr "\"Risk civilian lives? No, I shall invest [gold/] in popular support! [happiness/]\""

msgid "STORY_EVENT@1167_28@BUTTON_2"
msgstr "Instead, invoke your people's sense of duty to support this war."

msgid "STORY_EVENT@1167_28@BUTTON_3"
msgstr "These trifling issues bore me. I have a war to win!"

msgid "STORY_EVENT@1167_28@TITLE"
msgstr "Rally 'Round the Flag"

msgid "STORY_EVENT@1167_29@BODY_FOOTER"
msgstr "{EventCity}, now deeply rallied, fervently supports your war against {EnemyPlayer}. How will you use their rekindled vigor?"

msgid "STORY_EVENT@1167_29@BODY_HEADER"
msgstr "Before the last {EventUnitB} falls, you hear cheers rise up from {EventCity}."

msgid "STORY_EVENT@1167_29@BODY_LORE"
msgstr "You send your chancellor to address the population. \"People of {EventCity}! These monstrous <<m:EventUnitB>> that threatened to destroy your homes and eat your children were instructed to invade our lands by the treacherous {EnemyPlayer}. Our {PlayerLeader.Title} opposes <<o:EnemyPlayer>> fell intent. Will you join the just fight?\" More cheers rise up from the city streets."

msgid "STORY_EVENT@1167_29@BUTTON_0"
msgstr "Boost the recruitment efforts [unitprod/] of the city."

msgid "STORY_EVENT@1167_29@BUTTON_1"
msgstr "Dispatch envoys to raise support in your other cities too [happiness/]"

msgid "STORY_EVENT@1167_29@BUTTON_2"
msgstr "Encourage the production of structures. [structureprod/]"

msgid "STORY_EVENT@1167_29@BUTTON_3"
msgstr "Attract more people [population/] to join the city that supports you so."

msgid "STORY_EVENT@1167_29@TITLE"
msgstr "Rally 'Round the Flag: Aftermath"

msgid "STORY_EVENT@1167_33@BODY_FOOTER"
msgstr "\"These traders proclaimed that they will travel into your realm,\" the scout concludes. How will you welcome them?"

msgid "STORY_EVENT@1167_33@BODY_HEADER"
msgstr "A scout reports to you that <<p:EventUnit>> spotted a strange band of merchant {EventRace} in the wilderness."

msgid "STORY_EVENT@1167_33@BODY_LORE"
msgstr "\"There was something off about these {EventRace},\" the scout informs you. \"They swear that they are traders. However, I noticed they carried concealed weapons.\" The scout then leans in and whispers: \"These 'traders' possess surprisingly few wares to trade. Yet their mounts were sturdy and bred for battle.\""

msgid "STORY_EVENT@1167_33@BUTTON_0"
msgstr "Seek out the suspicious traders."

msgid "STORY_EVENT@1167_33@BUTTON_1"
msgstr "Send guards [unitprod/] from {EventCity} to repel the traders from your realm."

msgid "STORY_EVENT@1167_33@BUTTON_2"
msgstr "Conceal the paths leading across our borders."

msgid "STORY_EVENT@1167_33@BUTTON_3"
msgstr "Ignore them. People may freely travel to and fro my realm. [knowledge/]"

msgid "STORY_EVENT@1167_33@TITLE"
msgstr "Cross Purposes"

msgid "STORY_EVENT@1167_344@BODY_FOOTER"
msgstr "What will you do with this fool and <<o:EventHero>> far-fetched claims about a {EventRealm} lost to the mists?"

msgid "STORY_EVENT@1167_344@BODY_HEADER"
msgstr "The city guards of {EventCity} bring before you a bedraggled <<EventHero{man/woman}>>, accused of sowing panic with <<o:EventHero>> stories of impending doom."

msgid "STORY_EVENT@1167_344@BODY_LORE"
msgstr "\"The mists will come, {PlayerLeader}!\" <<Cp:EventHero>> speaks with terror in <<o:EventHero>> eyes. \"They spread from the fields, creep through the cracks in your city walls... and then—swoosh—everyone is gone! Stolen by the Fey!\" The <<EventHero{man/woman}>> stares into space until <<p:EventHero>> takes out a broken {EventItem}. \"This,\" <<p:EventHero>> yells, shaking <<o:EventHero>> fists, \"is all that's left of my {EventRealm}.\""

msgid "STORY_EVENT@1167_344@BUTTON_0"
msgstr "Interrogate the <<EventHero{man/woman}>> to learn more about the threat from the mists."

msgid "STORY_EVENT@1167_344@BUTTON_1"
msgstr "Better safe than sorry. Increase the recruitment [unitprod/] efforts!"

msgid "STORY_EVENT@1167_344@BUTTON_2"
msgstr "Jail the troublemaker for causing public unrest."

msgid "STORY_EVENT@1167_344@BUTTON_3"
msgstr "Banish the fool, but keep <<o:EventHero>> {EventItem} [item/] after mending it."

msgid "STORY_EVENT@1167_344@BUTTON_4"
msgstr "\"The mist cannot touch a mighty Godir such as myself!\" [influence/]"

msgid "STORY_EVENT@1167_344@TITLE"
msgstr "For Doom the Bells Toll"

msgid "STORY_EVENT@1167_345@BODY_FOOTER"
msgstr "\"Every night, <<G:song^n,EventDuathadae>> beckons me. I wish to obey. I must return!\" You should address the survivor's ensorcellment."

msgid "STORY_EVENT@1167_345@BODY_HEADER"
msgstr "{EventCity} guards inform you that one of the {PlayerRace} you rescued from the {EventRace} is displaying erratic behavior. <<Cp:EventUnit>> wants to return to the {EventRace}."

msgid "STORY_EVENT@1167_345@BODY_LORE"
msgstr "The survivor has clothed <<r:EventUnit>> in the style of the {EventRace}. <<Cp:EventUnit>> shrieks: \"I must know! I must know if I am worthy!\" You ask what <<p:EventUnit>> means. \"I've witnessed those taken by the {EventRace} being brought before four {GLOBAL.DuathadaeLoreConcept.Hyperlink}, those otherworldly gods they worship. They devoured all, except those they deemed worthy, whom they... malformed. Twisted, to become one of... of THEM!\""

msgid "STORY_EVENT@1167_345@BUTTON_0"
msgstr "\"Receive my amnesia spell [mana/] to make you forget.\" [goodact/]"

msgid "STORY_EVENT@1167_345@BUTTON_1"
msgstr "\"My guards [unitprod/] will interrogate you to learn more [knowledge/] about Duatha.\""

msgid "STORY_EVENT@1167_345@BUTTON_2"
msgstr "\"Be remade worthy [mana/] as a {EventUnitA} [unit/] for my army.\""

msgid "STORY_EVENT@1167_345@BUTTON_3"
msgstr "Permit the survivor to leave. His departure will disquiet [happiness/] {EventCity}."

msgid "STORY_EVENT@1167_345@TITLE"
msgstr "Shrouded Torments"

msgid "STORY_EVENT@1167_346@BODY_FOOTER"
msgstr "The {EventRace} defectors seek refuge in your realm. What will you ask in exchange for their accommodation?"

msgid "STORY_EVENT@1167_346@BODY_HEADER"
msgstr "Your daily routine is interrupted unexpectedly: a company of {EventRace} emerged from {GLOBAL.DuathaLoreConcept.Hyperlink}. Their commander seeks an audience with you."

msgid "STORY_EVENT@1167_346@BODY_LORE"
msgstr "The {EventUnit} kneels. \"Salutations, Supreme {PlayerLeader.Title}, Keeper of the {EventRelic}. Once we belonged to the Grey Cohort, as swords for {EventDuathadae}, {EventDuathadaeTitle}. But my masters have failed the {GLOBAL.DuathadaeLoreConcept.Hyperlink}. {PlayerLeader.Name}, possessor of the power to create <<m:EventScourgeUnit>>, your splendor now rivals that of {EventDuathadae}! Permit us to serve you, {PlayerLeader.Title}. Our secrets will fortify your eminence. Or shall I attune the {EventRelic} with <<G:power^n,EventDuathadae>>?\""

msgid "STORY_EVENT@1167_346@BUTTON_0"
msgstr "Allow the {EventRace} asylum and chronicle their secrets. [knowledge/]"

msgid "STORY_EVENT@1167_346@BUTTON_1"
msgstr "Enlist the {EventUnit} [unit/] and their company."

msgid "STORY_EVENT@1167_346@BUTTON_2"
msgstr "\"Attune the {EventRelic} for me!\""

msgid "STORY_EVENT@1167_346@BUTTON_3"
msgstr "Execute [evilact/] the insolent {EventRace} as compensation [happiness/] for the crimes of their kin."

msgid "STORY_EVENT@1167_346@BUTTON_4"
msgstr "Turn the company of {EventRace} away."

msgid "STORY_EVENT@1167_346@TITLE"
msgstr "Hazy Elucidations"

msgid "STORY_EVENT@1167_34@BODY_FOOTER"
msgstr "\"Leave now. We will depart soon enough,\" the leader says mockingly. Something is awry. What will you do?"

msgid "STORY_EVENT@1167_34@BODY_HEADER"
msgstr "You have found the group of traders that your scout described."

msgid "STORY_EVENT@1167_34@BODY_LORE"
msgstr "Their leader steps forward. \"Why are you bothering us? We are but simple traders who did nothing wrong.\" <<Co:EventStackLeader>> companions gather around <<P:EventStackLeader>>, their grim eyes fixed on you. Most of them have their hands underneath their loose robes, as if they clutch something."

msgid "STORY_EVENT@1167_34@BUTTON_0"
msgstr "Attack the suspicious group of traders!"

msgid "STORY_EVENT@1167_34@BUTTON_1"
msgstr "Bribe [gold/] the group to make them go away."

msgid "STORY_EVENT@1167_34@BUTTON_2"
msgstr "\"Troops! Swear oaths that you will protect our borders!\""

msgid "STORY_EVENT@1167_34@BUTTON_3"
msgstr "Divine the traders' identity."

msgid "STORY_EVENT@1167_34@BUTTON_4"
msgstr "\"Alright. I'll leave. For now.\""

msgid "STORY_EVENT@1167_34@TITLE"
msgstr "Cross Purposes: Encounter"

msgid "STORY_EVENT@1167_35@BODY_FOOTER"
msgstr "\"We will spill <<G:secrets^p,EventHouse>>!\", cries the spy leader. <<CG:transgression^n,EventHouse>> demands a strong response. What will you do?"

msgid "STORY_EVENT@1167_35@BODY_HEADER"
msgstr "The true identity of the \"traders\" is revealed! They are spies sent by {EventHouse}!"

msgid "STORY_EVENT@1167_35@BODY_LORE"
msgstr "Following your confrontation, you interrogate the leader of the group of spies. The {TraderLeader} refuses to speak at first. Fortunately, some veterans in your entourage have keen methods to make people talk. The {TraderLeader} breaks even before anyone lays a hand on <<P:TraderLeader>>."

msgid "STORY_EVENT@1167_35@BUTTON_0"
msgstr "\"{EventHouse} must pay. To WAR!\""

msgid "STORY_EVENT@1167_35@BUTTON_1"
msgstr "\"This proves we need to prioritize our defenses in {EventCity}! [unitprod/]\""

msgid "STORY_EVENT@1167_35@BUTTON_2"
msgstr "Forget {EventHouse}. Make it look like your rival, {EnemyPlayer}, orchestrated the incursion."

msgid "STORY_EVENT@1167_35@BUTTON_3"
msgstr "\"I am willing to forget [relation/]... for a price. [gold/]\""

msgid "STORY_EVENT@1167_35@BUTTON_4"
msgstr "\"I forgive [goodact/] their act of aggression. [relation/]\""

msgid "STORY_EVENT@1167_35@TITLE"
msgstr "Cross Purposes: Aftermath"

msgid "STORY_EVENT@1167_37@BODY_FOOTER"
msgstr "The dissenting warchief and <<o:EventStackLeader>> warriors will ravage across your lands. What will you do to stop <<P:EventStackLeader>>?"

msgid "STORY_EVENT@1167_37@BODY_HEADER"
msgstr "A wounded scout arrives at your court, <<o:EventUnit>> armor torn and battered. \"The Butcher... here..!\", <<p:EventUnit>> stammers."

msgid "STORY_EVENT@1167_37@BODY_LORE"
msgstr "After the scout found <<o:EventUnit>> tongue by gulping down two goblets of wine, <<p:EventUnit>> shakily gives you <<o:EventUnit>> report. \"My {PlayerLeader.Title}. Your enemy, the wicked {EventHouseLord.Title} of {EventHouse}, set loose <<o:EventHouseLord>> most terrifying warchief upon your peoples, giving the bastard free rein.\" <<Cp:EventUnit>> looks at you soberly. \"{EventStackLeader.FirstName}, the Butcher of {EventHouse} kills, pillages, and desecrates... like a wild beast!\""

msgid "STORY_EVENT@1167_37@BUTTON_0"
msgstr "Seek out {EventStackLeader} and <<o:EventStackLeader>> band of warriors."

msgid "STORY_EVENT@1167_37@BUTTON_1"
msgstr "Rally guards [unitprod/] to protect my people [happiness/] and deal with {EventStackLeader.FirstName}."

msgid "STORY_EVENT@1167_37@BUTTON_2"
msgstr "Summon shades to distract the warband."

msgid "STORY_EVENT@1167_37@BUTTON_3"
msgstr "Take your chances and do nothing. [evilact/]"

msgid "STORY_EVENT@1167_37@TITLE"
msgstr "Brutal Incursion"

msgid "STORY_EVENT@1167_38@BODY_FOOTER"
msgstr "Warchief {EventStackLeader.FirstName} is busy talking, granting you an opportunity to improve your chances of victory over him."

msgid "STORY_EVENT@1167_38@BODY_HEADER"
msgstr "Your troops have found the brutish warchief and <<o:EventStackLeader>> raiders. Both sides prepare for battle, when {EventStackLeader} addresses the {PlayerStackLeader}."

msgid "STORY_EVENT@1167_38@BODY_HEADER@PLAYERSTACKLEADE"
msgstr "You have found the brutish warchief and <<o:EventStackLeader>> raiders. Both sides prepare for battle, when {EventStackLeader} addresses you."

msgid "STORY_EVENT@1167_38@BODY_LORE"
msgstr "\"I've heard of ye. Did ya come to stop me?\" The terrible Butcher lets out a bellowing laugh. \"Look 'ere, boys! This one thinks <<r:PlayerStackLeader>> some sorta hero!\" The warchief's smirk then turns into a scowl. <<Cp:EventStackLeader>> taps on the necklace <<p:EventStackLeader>> wears. It's made of ears. \"These lot also thought they were heroes,\" <<p:EventStackLeader>> growls."

msgid "STORY_EVENT@1167_38@BODY_LORE@PLAYERSTACKLEADE"
msgstr "\"I've heard of ye. Did ya come to stop me?\" The terrible Butcher lets out a bellowing laugh. \"Look 'ere, boys! This one thinks <<r:PlayerStackLeader>> invincible or sumthin'!\" The warchief's smirk then turns into a scowl. <<Cp:EventStackLeader>> taps on the necklace <<p:EventStackLeader>> wears. It's made of ears. \"These lot also thought they were invincible,\" <<p:EventStackLeader>> growls."

msgid "STORY_EVENT@1167_38@BUTTON_0"
msgstr "Fight them head on! [goodact/]"

msgid "STORY_EVENT@1167_38@BUTTON_1"
msgstr "Cast simple spells [mana/] to bolster your own troops before battle."

msgid "STORY_EVENT@1167_38@BUTTON_2"
msgstr "\"Take these coffers of coin [gold/] and fight for me. [unit/]\""

msgid "STORY_EVENT@1167_38@BUTTON_3"
msgstr "\"If it's carnage you're after, warchief {EventStackLeader.FirstName}, prey on a weaker opponent.\""

msgid "STORY_EVENT@1167_38@BUTTON_4"
msgstr "Back away. You can confront the warband later."

msgid "STORY_EVENT@1167_38@BUTTON_5"
msgstr "\"Take these coffers of coin [gold/] and leave. Your {EventUnit} [unit/] stays with me.\" [evilact/]"

msgid "STORY_EVENT@1167_38@TITLE"
msgstr "Encountering Brutal Incursion"

msgid "STORY_EVENT@1167_39@BODY_FOOTER"
msgstr "Your relieved citizens celebrate, and your soldiers most of all. How will you use this victory to your best advantage?"

msgid "STORY_EVENT@1167_39@BODY_HEADER"
msgstr "The terrifying warchief has been dealt with. <<Cp:EventStackLeader>> and <<o:EventStackLeader>> troops are no longer a threat."

msgid "STORY_EVENT@1167_39@BODY_LORE"
msgstr "Shortly after, you receive a message from your despised enemy, {EventHouseLord.FirstName} of {EventHouse}. <<Cp:EventHouseLord>> informs you that {EventStackLeader} was acting on <<o:EventStackLeader>> own accord, and that the {EventHouseLord.Title} had no involvement in the unfortunate rampage. It matters not. Your strength won the day. You crumple the letter into a ball and cast it into a nearby bonfire."

msgid "STORY_EVENT@1167_39@BUTTON_0"
msgstr "Inspire all of your troops! [morale/]"

msgid "STORY_EVENT@1167_39@BUTTON_1"
msgstr "Attract more recruits for the war! [unitprod/]"

msgid "STORY_EVENT@1167_39@BUTTON_2"
msgstr "Nail the Butcher's body to <<G:gates^p,EventCity>> [evilact/] to demonstrate your supremacy. [influence/]"

msgid "STORY_EVENT@1167_39@BUTTON_3"
msgstr "Accept no reward. The lands are safe again! [goodact/]"

msgid "STORY_EVENT@1167_39@TITLE"
msgstr "Brutal Incursion: Aftermath"

msgid "STORY_EVENT@1167_48@BODY_FOOTER"
msgstr "The pitiful {EventHouseLord.Title} mocks your abilities to craft war. How will you respond?"

msgid "STORY_EVENT@1167_48@BODY_HEADER"
msgstr "A messenger delivers an official declaration of your enemy, {EventHouseLord} of {EventHouse} to {EventCity}, your throne city."

msgid "STORY_EVENT@1167_48@BODY_LORE"
msgstr "\"To the craven {PlayerLeader.Title}. You are the worst Ruler of this world. All the other {GLOBAL.IndependentCityConcept.Hyperlink} Rulers laugh at you behind your back. We are surprised you have not yet slipped and fallen back into the Void by accident. Your enemy in war, {EventHouseLord.TitleFirstName}.\""

msgid "STORY_EVENT@1167_48@BUTTON_0"
msgstr "Convert <<G:stone^n,EventCity>> [structureprod/] to mana [mana/] to bolster your summoning capacity."

msgid "STORY_EVENT@1167_48@BUTTON_1"
msgstr "Find more recruits [unitprod/] in {EventCity} by promising them ale! [food/]"

msgid "STORY_EVENT@1167_48@BUTTON_2"
msgstr "Promptly conscript a mercenary {EventUnit}! [unit/] Empty the Empire coffers! [gold/]"

msgid "STORY_EVENT@1167_48@BUTTON_3"
msgstr "Summon a {EventUnitB} [unit/] right now! Expend our mana [mana/] reserves!"

msgid "STORY_EVENT@1167_48@BUTTON_4"
msgstr "\"Insults betray your weakness, {EventHouseLord.Title}. [influence/]\""

msgid "STORY_EVENT@1167_48@TITLE"
msgstr "Barks and Bites"

msgid "STORY_EVENT@1167_49@BODY_FOOTER"
msgstr "The {EventHouseLord.Title} sighs. \"I am willing to submit to your rule, if you vow to help my people recover!\""

msgid "STORY_EVENT@1167_49@BODY_HEADER"
msgstr "Your opponent in war, {EventHouseLord} of {EventHouse}, contacts you, <<o:EventHouseLord>> face war-worn and grim."

msgid "STORY_EVENT@1167_49@BODY_LORE"
msgstr "\"I am not too proud to admit that my people's suffering outweighs my desire to best you in battle. My {EventRace} are underfed and many are displaced. I am slowly accepting that I must bow to your might.\" {EventHouseLord.FirstName} looks you in the eye. \"But I have terms.\""

msgid "STORY_EVENT@1167_49@BUTTON_0"
msgstr "\"Join me. {EventCity} will feed [food/] your people and build [structureprod/] shelters.\""

msgid "STORY_EVENT@1167_49@BUTTON_1"
msgstr "\"Let us end the war. {EventHouse} will remain independent. [goodact/]\""

msgid "STORY_EVENT@1167_49@BUTTON_2"
msgstr "\"How much [gold/] is peace worth to you?\""

msgid "STORY_EVENT@1167_49@BUTTON_3"
msgstr "\"What other option is there but to submit to my glory?\""

msgid "STORY_EVENT@1167_49@BUTTON_4"
msgstr "\"The battlefield will decide if you are worthy of survival.\""

msgid "STORY_EVENT@1167_49@TITLE"
msgstr "City of White Flags"

msgid "STORY_EVENT@1167_50@BODY_FOOTER"
msgstr "\"Your citizens in {EventCity} clearly suffer the most from this war. What resource can we send to aid them?\""

msgid "STORY_EVENT@1167_50@BODY_HEADER"
msgstr "You consult your advisors on your war strategy against {EnemyHouse}, when the {EventHouseLord.Title} of {EventHouse} requests an audience."

msgid "STORY_EVENT@1167_50@BODY_LORE"
msgstr "{EventHouseLord} greets you formally. \"I will keep this brief, O {PlayerLeader.Title}, for I know you have <<g:sons^p,EventCity>> to slay. What carnage you inflict on your warriors is your own business. Yet when innocents suffer, we cannot abide. Thus, while we will not help your forces in this war against {EnemyHouse}, we selflessly offer your people relief.\""

msgid "STORY_EVENT@1167_50@BUTTON_0"
msgstr "\"Food [food/] for the hungry children.\""

msgid "STORY_EVENT@1167_50@BUTTON_1"
msgstr "\"Timber and stone [structureprod/] to build new homes.\""

msgid "STORY_EVENT@1167_50@BUTTON_2"
msgstr "\"Forms of entertainment [happiness/] to help cope with the onslaught.\""

msgid "STORY_EVENT@1167_50@BUTTON_3"
msgstr "\"You ask me to choose? {EventCity} requires all!\""

msgid "STORY_EVENT@1167_50@BUTTON_4"
msgstr "\"I appreciate the offer, but other people need it more.\" [goodact/]"

msgid "STORY_EVENT@1167_50@TITLE"
msgstr "Sympathetic Support"

msgid "STORY_EVENT@1167_53@BODY_FOOTER"
msgstr "{EventHouse} calls for aid against their enemy, {RivalPlayer}. Will you offer them any succor?"

msgid "STORY_EVENT@1167_53@BODY_HEADER"
msgstr "The desperate plea from {EventHouseLord} of {EventHouse} reaches you! {EventHouseLord.FirstName} is losing the war to {RivalPlayer}!"

msgid "STORY_EVENT@1167_53@BODY_LORE"
msgstr "\"Help us, {PlayerLeader}! You're our only hope!\" The {EventHouseLord.Title} folds <<o:EventHouseLord>> hands. \"That aggressor, {RivalPlayer}, is out to take my lands! I know I am not one of your vassals, O {PlayerLeader.Title}, but if your heart favors mercy and kindness, please help us against this tyrant!\" {EventHouseLord.FirstName} falls to <<o:EventHouseLord>> knees, tears streaming down <<o:EventHouseLord>> face."

msgid "STORY_EVENT@1167_53@BUTTON_0"
msgstr "Denounce {RivalPlayer} [relation/] in support of {EventHouse}. [allegiance/]"

msgid "STORY_EVENT@1167_53@BUTTON_1"
msgstr "Discreetly summon [mana/] a {EventUnitB} to help their cause. [relation/]"

msgid "STORY_EVENT@1167_53@BUTTON_2"
msgstr "Train [unitprod/] a {EventUnitA} from {EventCity} for the army of {EventHouse}. [relation/]"

msgid "STORY_EVENT@1167_53@BUTTON_3"
msgstr "Gift {EventHouse} [relation/] a relief package of crops [food/] and timber [structureprod/]."

msgid "STORY_EVENT@1167_53@BUTTON_3_PREDICTION"
msgstr "{EventHouse} gains 1 {GLOBAL.PopulationConcept} and the {GLOBAL.StructureProductionConcept} donated by {EventCity}."

msgid "STORY_EVENT@1167_53@BUTTON_4"
msgstr "Wish them good luck against their enemies."

msgid "STORY_EVENT@1167_53@TITLE"
msgstr "Call for Aid"

msgid "STORY_EVENT@1167_558@BODY_FOOTER"
msgstr "\"I have tracked the thieves back to their {EventSpawner}. I demand swift justice, my {PlayerLeader.Title}. Allow me to deliver it!\""

msgid "STORY_EVENT@1167_558@BODY_HEADER"
msgstr "\"My family name is stained!\" your [hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink], {EventHero}, cries to you. \"Bandits took my {EventItem} during the night!\""

msgid "STORY_EVENT@1167_558@BODY_LORE"
msgstr "Your stalwart champion is deeply distraught. \"It was entrusted to me by my <<EventHero{father/mother}>>, who received it from <<o:EventHero>> <<EventHero{father/mother}>> before <<P:EventHero>>. The relic can be traced all the way back to the first ancestor of the <<m:{EventHero.LastName}>>. I was its Keeper, but now I have put my forebears to shame.\" The despair in <<G:eyes^p,EventHero>> then turns to vengeful rage."

msgid "STORY_EVENT@1167_558@BUTTON_0"
msgstr "\"Go and reclaim your honor, {EventHero.FirstName}, with my blessing.\""

msgid "STORY_EVENT@1167_558@BUTTON_1"
msgstr "Recreate the {EventItem} for {EventHero}."

msgid "STORY_EVENT@1167_558@BUTTON_2"
msgstr "{EventCity} guards [unitprod/] will clear the bandit camp. [morale/] The spoils [gold/] are mine."

msgid "STORY_EVENT@1167_558@BUTTON_3"
msgstr "\"I cannot tend to your troubles right now, {EventHero.FirstName}. Another time, perhaps.\""

msgid "STORY_EVENT@1167_558@TITLE"
msgstr "Stolen Honor"

msgid "STORY_EVENT@1167_559@BODY_FOOTER"
msgstr "\"I am but your humble servant, O {PlayerLeader.Title}.\"{EventHero} bows. \"Ask how I may reward you, and I shall.\""

msgid "STORY_EVENT@1167_559@BODY_HEADER"
msgstr "{EventHero} greets you grinningly. \"The {EventItem} of my forebears is mine once more. I thank you, my {PlayerLeader.Title}.\""

msgid "STORY_EVENT@1167_559@BODY_LORE"
msgstr "{EventHero.FirstName} locks the {EventItem} in a strongbox. \"There! None may claim it now. I shall keep it, and my family's honor, until I may pass it down to an heir of my choosing.\" Your <<EventHero{hero/heroine}>> stands taller than ever before and is beaming with confidence and determination."

msgid "STORY_EVENT@1167_559@BUTTON_0"
msgstr "Appropriate [evilact/] the ancestral {EventItem}. [item/]"

msgid "STORY_EVENT@1167_559@BUTTON_1"
msgstr "\"May your reclaimed honor deliver you strength.\" [xp/]"

msgid "STORY_EVENT@1167_559@BUTTON_2"
msgstr "\"Lead your troops with grace and fervor, {EventHero.FirstName}!\" [unitHero/]"

msgid "STORY_EVENT@1167_559@BUTTON_3"
msgstr "\"Your wronging being amended is the only reward I require.\"[goodact/]"

msgid "STORY_EVENT@1167_559@BUTTON_4"
msgstr "\"I was merely upholding my end of our oath.\" [devotedact/]"

msgid "STORY_EVENT@1167_559@BUTTON_5"
msgstr "Propose a finder's fee as thanks. [gold/]"

msgid "STORY_EVENT@1167_559@TITLE"
msgstr "Stolen Honor: Aftermath"

msgid "STORY_EVENT@1167_562@BODY_FOOTER"
msgstr "\"My {PlayerLeader.Title}, as your devout servant, permit me a {EventStackLeader}. We shall share its flesh... and its power.\""

msgid "STORY_EVENT@1167_562@BODY_HEADER"
msgstr "\"Have you ever tasted... {EventStackLeader}, my {PlayerLeader.Title}?\", your [hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink], {EventHero}, asks casually. You wonder where this is going."

msgid "STORY_EVENT@1167_562@BODY_LORE"
msgstr "\"It is said to be quite sweet... and full of invigorating power.\" {EventHero.FirstName} feigns nonchalance, but you detect the quivering in <<o:EventHero>> voice. <<Cp:EventHero>> wets <<o:EventHero>> lips. Your raised eyebrow is all the encouragement your <<EventHero{hero/heroine}>> requires. \"Legends of this realm say that the flesh of a {EventStackLeader} grants strength and wisdom to its consumer!\""

msgid "STORY_EVENT@1167_562@BUTTON_0"
msgstr "Help {EventHero} sate <<o:EventHero>> hunger for power."

msgid "STORY_EVENT@1167_562@BUTTON_1"
msgstr "\"The only power [influence/] I tolerate in this realm is my own.\" [morale/]"

msgid "STORY_EVENT@1167_562@BUTTON_2"
msgstr "Leech the insolent {EventHero.FirstName} of <<o:EventHero>> strength to empower yourself. [xp/]"

msgid "STORY_EVENT@1167_562@BUTTON_3"
msgstr "\"You cannot hunt the {EventStackLeader}, {EventHero.FirstName}. At least, not today.\""

msgid "STORY_EVENT@1167_562@TITLE"
msgstr "Power Made Flesh"

msgid "STORY_EVENT@1167_563@BODY_FOOTER"
msgstr "\"I can already feel its power surging through my veins. I am become your weapon, {PlayerLeader.Title}. Wield me.\""

msgid "STORY_EVENT@1167_563@BODY_HEADER"
msgstr "\"At last! The flesh of the {EventStackLeader} is mine!\" {EventHero} grins, baring <<o:EventHero>> teeth voraciously."

msgid "STORY_EVENT@1167_563@BODY_LORE"
msgstr "After gathering a broad selection of powders and tonics, your [hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink] ceremoniously proceeds to prepare the meat of the {EventStackLeader} in <<o:EventHero>> quarters. A sordid odor soon permeates your abode. As your courtiers gather in protest, {EventHero.FirstName} reemerges triumphantly, chewing on what looks to be a braised haunch of the {EventStackLeader}. <<Cp:EventHero>> exudes newfound strength."

msgid "STORY_EVENT@1167_563@BUTTON_0"
msgstr "\"Give me a taste of that.\" [xp/]"

msgid "STORY_EVENT@1167_563@BUTTON_1"
msgstr "\"Sapping strength suits you, {EventHero}. Develop [unitHero/] these instincts some more.\""

msgid "STORY_EVENT@1167_563@BUTTON_2"
msgstr "\"All power comes at a price. Time to pay.\" [gold/]"

msgid "STORY_EVENT@1167_563@BUTTON_3"
msgstr "\"Mix the <<G:carcass^n,EventStackLeader>> into the rations of your troops, {EventHero.FirstName}.\" [xp/]"

msgid "STORY_EVENT@1167_563@TITLE"
msgstr "Power Made Flesh: Aftermath"

msgid "STORY_EVENT@1167_566@BODY_FOOTER"
msgstr "{EventHero.FirstName} sighs. \"My deepest desire remains: to witness a {EventStackLeader} with my own eyes. Might I go find one?\""

msgid "STORY_EVENT@1167_566@BODY_HEADER"
msgstr "Your [hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink], {EventHero}, greets you warmly. \"{PlayerLeader.Title}. As your servant, I feel lucky to have traveled far and seen much.\""

msgid "STORY_EVENT@1167_566@BODY_LORE"
msgstr "Before you can send the <<EventHero{hero/heroine}>> off to another faraway site, <<p:EventHero>> continues. \"Part of why I chose the life of an adventuring <<EventHero{hero/heroine}>> is because I wish to witness the wonders of the realms.\" {EventHero.FirstName} blushes. \"My Grandnan {EventHero.LastName} used to tell me stories of the {EventStackLeader} and the heroes that garnered renown just by encountering one.\""

msgid "STORY_EVENT@1167_566@BUTTON_0"
msgstr "\"Go then. May you soon lay eyes on a {EventStackLeader}.\""

msgid "STORY_EVENT@1167_566@BUTTON_1"
msgstr "Have {EventHero} herd cattle [food/] to take <<o:EventHero>> mind off <<m:EventStackLeader>>."

msgid "STORY_EVENT@1167_566@BUTTON_2"
msgstr "\"A {EventStackLeader}? I can show you a {EventStackLeader} right now!\""

msgid "STORY_EVENT@1167_566@BUTTON_3"
msgstr "\"Trouble me with these idle dreams of yours at another time, {EventHero.FirstName}.\""

msgid "STORY_EVENT@1167_566@TITLE"
msgstr "Profound Desire For <<m:EventStackLeader>>"

msgid "STORY_EVENT@1167_567@BODY_FOOTER"
msgstr "It doesn't take long before the {EventStackLeader} catches <<G:scent^n,EventHero>>. It turns to face <<P:EventHero>> and gets ready to charge!"

msgid "STORY_EVENT@1167_567@BODY_FOOTER@HERO_NOT_PRESENT"
msgstr "You should return with {EventHero}."

msgid "STORY_EVENT@1167_567@BODY_HEADER"
msgstr "{EventHero.FirstName} cannot contain <<o:EventHero>> excitement. \"There! A {EventStackLeader} it is! They really do exist!\""

msgid "STORY_EVENT@1167_567@BODY_HEADER@HERO_NOT_PRESENT"
msgstr "Your army currently approaching the {EventStackLeader} does not include {EventHero}. <<Cp:EventHero>> is the one who wants to see the {EventStackLeader}."

msgid "STORY_EVENT@1167_567@BODY_HEADER@TEST"
msgstr "{EventPhrase}"

msgid "STORY_EVENT@1167_567@BODY_LORE"
msgstr "The mighty {EventStackLeader} wanders aimlessly near the {EventStructure} while {EventHero.FirstName} continues to observe it. Some <<m:EventUnit>> have a den nearby, but seem unbothered by the great beast trespassing on their territory. <<Cp:EventHero>> mumbles: \"So there really are <<m:EventStackLeader>>! And now, I have seen one!\" <<Cp:EventHero>> is too mesmerized by the sight of the great beast to notice the wind turning unexpectedly."

msgid "STORY_EVENT@1167_567@BODY_LORE@HERO_NOT_PRESENT"
msgstr "The mighty {EventStackLeader} wanders aimlessly near the {EventStructure}. Some <<m:EventUnit>> have a den nearby, but seem unbothered by the great beast trespassing on their territory."

msgid "STORY_EVENT@1167_567@BUTTON_0"
msgstr "\"Take it down! I want its head on my wall!\""

msgid "STORY_EVENT@1167_567@BUTTON_1"
msgstr "\"Troops, learn [xp/] from this mighty creature's attacks.\""

msgid "STORY_EVENT@1167_567@BUTTON_2"
msgstr "Tame the formidable beast."

msgid "STORY_EVENT@1167_567@BUTTON_3"
msgstr "\"Positions! Do not let the beast trample you!\""

msgid "STORY_EVENT@1167_567@BUTTON_4"
msgstr "Return later with {EventHero}."

msgid "STORY_EVENT@1167_567@BUTTON_4@TOOLTIP"
msgstr "{EventHero.FirstName} will approach the {EventStackLeader} later."

msgid "STORY_EVENT@1167_567@BUTTON_5"
msgstr "Attack the {EventStackLeader} anyway."

msgid "STORY_EVENT@1167_567@TITLE"
msgstr "Profound Desire For <<m:EventStackLeader>>: Encounter"

msgid "STORY_EVENT@1167_568@BODY_FOOTER"
msgstr "<<Cp:EventHero>> concludes: \"No one at home will ever believe me. Nevertheless, what a life!' You claim a trophy from the {EventStackLeader}."

msgid "STORY_EVENT@1167_568@BODY_FOOTER@HERO_NOT_PRESENT"
msgstr "You leave the scene hoping that {EventHero.FirstName} won't be too disappointed by your decision."

msgid "STORY_EVENT@1167_568@BODY_HEADER"
msgstr "{EventHero} has bested the {EventStackLeader} <<p:EventHero>> so passionately wished to see. <<Cp:EventHero>> sheds a single tear for the creature's fate."

msgid "STORY_EVENT@1167_568@BODY_HEADER@HERO_NOT_PRESENT"
msgstr "Your troops have slain the {EventStackLeader} that your {GLOBAL.HeroConcept.Hyperlink}, {EventHero}, so passionately wished to see."

msgid "STORY_EVENT@1167_568@BODY_LORE"
msgstr "{EventHero.FirstName} stares at the horizon for a spell, then whispers: \"Such a majestic and magnificent creature. I wish it still roamed the lands, free and unbound.\" <<Cp:EventHero>> then cuts off some hair off the creature and puts it in a locket. \"If only Grandnan {EventHero.LastName} could see me now. Tiny {EventHero.FirstName}, serving a Godir.\""

msgid "STORY_EVENT@1167_568@BODY_LORE@HERO_NOT_PRESENT"
msgstr "However, your Hero did not partake in the encounter. The world has grown still and quiet, as if mourning. You can't shake the feeling that this was a failed endeavor, or at least a missed opportunity."

msgid "STORY_EVENT@1167_568@BUTTON_0"
msgstr "Have {EventHero.FirstName} reflect [xp/] on the encounter with the {EventStackLeader}."

msgid "STORY_EVENT@1167_568@BUTTON_1"
msgstr "Claim a trophy from the {EventStackLeader}: a {EventItem}. [item/]"

msgid "STORY_EVENT@1167_568@BUTTON_3"
msgstr "\"You toppled the mighty {EventStackLeader}! Inspire others [unitHero/] to strike relentlessly.\""

msgid "STORY_EVENT@1167_568@BUTTON_4"
msgstr "Stimulate {EventHero} to develop <<o:EventHero>> fascination with beasts. [unitHero/]"

msgid "STORY_EVENT@1167_568@BUTTON_5"
msgstr "Inform {EventHero} of the unfortunate news. [morale/]"

msgid "STORY_EVENT@1167_568@TITLE"
msgstr "Profound Desire For <<m:EventStackLeader>>: Aftermath"

msgid "STORY_EVENT@1167_568@TITLE@HERO_NOT_PRESENT"
msgstr "Profound Desire For <<m:EventStackLeader>>: Failed"

msgid "STORY_EVENT@1167_571@BODY_FOOTER"
msgstr "\"My {PlayerLeader.Title}, a {EventStackLeader} made its nest nearby. Permit me to find the beast. And kill it. Or be killed.\""

msgid "STORY_EVENT@1167_571@BODY_HEADER"
msgstr "\"Do you consider me brave enough to face a {EventStackLeader}?\", asks your [hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink], {EventHero}. \"They are an honorable hunter's prey.\""

msgid "STORY_EVENT@1167_571@BODY_LORE"
msgstr "{EventHero.FirstName} does not wait for your reply. <<Cp:EventHero>> speaks with a glint in <<o:EventHero>> eye. \"This is not a creature you hunt for its meat. Nor will it yield an ichor to apply as poison or medicine. This is a beast you hunt to fight.\" {EventHero.FirstName} lowers <<o:EventHero>> voice and <<o:EventHero>> expression turns solemn. \"To fight to the death.\""

msgid "STORY_EVENT@1167_571@BUTTON_0"
msgstr "\"Go and win your honor, {EventHero.FirstName}.\""

msgid "STORY_EVENT@1167_571@BUTTON_1"
msgstr "\"Killing a beast for sport alone? This is not our way.\""

msgid "STORY_EVENT@1167_571@BUTTON_2"
msgstr "Deny {EventHero} <<o:EventHero>> request."

msgid "STORY_EVENT@1167_571@TITLE"
msgstr "Into the <<G:den^n,EventStackLeader>>"

msgid "STORY_EVENT@1167_572@BODY_FOOTER"
msgstr "What shall you do with the spoils of the {EventSpawner}?"

msgid "STORY_EVENT@1167_572@BODY_FOOTER@HERO_WAS_PRESENT"
msgstr "{EventHero} is invigorated by the ordeal. Yours is the gold. What shall you do with the remains of the {EventSpawner}?"

msgid "STORY_EVENT@1167_572@BODY_HEADER"
msgstr "After a fierce battle, your forces have cleared the <<G:nest^n,EventStackLeader>>."

msgid "STORY_EVENT@1167_572@BODY_HEADER@HERO_WAS_PRESENT"
msgstr "After a fierce battle, {EventHero} have cleared the <<G:nest^n,EventStackLeader>>."

msgid "STORY_EVENT@1167_572@BODY_LORE"
msgstr "Built from crude materials, the {EventSpawner} housed not only the {EventStackLeader}, but offered shelter for more creatures. The den is littered with small treasures: all that remains of less fortunate challengers. While your troops collect the discarded coins, a faint warble catches their attention. Underneath some rubble, they find a {EventItem}, and a young orphaned {EventUnit} that immediately scurries off."

msgid "STORY_EVENT@1167_572@BUTTON_0"
msgstr "Collect the crude {EventItem} [item/] as your trophy."

msgid "STORY_EVENT@1167_572@BUTTON_1"
msgstr "Catch the orphaned {EventUnit} [unit/] and have it fight for you."

msgid "STORY_EVENT@1167_572@BUTTON_2"
msgstr "Strip the nest's remains for building materials [structureprod/] for {EventCity}."

msgid "STORY_EVENT@1167_572@BUTTON_3"
msgstr "\"Bask in the glory [morale/] of your victory [unitHero/], {EventHero}!\""

msgid "STORY_EVENT@1167_572@BUTTON_4"
msgstr "Claim the orphaned {EventUnit} as your prize pet [influence/] for entertainment. [evilact/]"

msgid "STORY_EVENT@1167_572@TITLE"
msgstr "Into the <<G:den^n,EventStackLeader>>: Aftermath"

msgid "STORY_EVENT@1167_575@BODY_FOOTER"
msgstr "{EventHero.FirstName} pleads for you to find and secure {EventMaterial}, to cure <<o:EventHero>> <<EventUnit{brother's/sister's}>> illness."

msgid "STORY_EVENT@1167_575@BODY_HEADER"
msgstr "Your [hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink], {EventHero}, gravely approaches you. \"My {PlayerLeader.Title}, my <<EventUnit{brother/sister}>> has fallen ill. I fear <<o:EventUnit>> demise is imminent.\""

msgid "STORY_EVENT@1167_575@BODY_LORE"
msgstr "Your <<EventHero{hero/heroine}>> unfurls an ancient scroll. \"It's a well-guarded secret of the {EventRace} that the {EventMaterial} has specific medicinal applications. I wager that your herbalists are able to concoct a healing salve of fresh <<m:EventMaterial>>.\" {EventHero.FirstName} stows the scroll and kneels while teardrops wet the floor. \"I beg you, my {PlayerLeader.Title}. <<Cp:EventUnit>> is the only family I have left.\""

msgid "STORY_EVENT@1167_575@BUTTON_0"
msgstr "Agree to finding the {EventMaterial}."

msgid "STORY_EVENT@1167_575@BUTTON_2"
msgstr "Attempt a spell of recovery to heal the <<EventUnit{brother/sister}>>"

msgid "STORY_EVENT@1167_575@BUTTON_3"
msgstr "\"I have more pressing matters to attend, {EventHero.FirstName}.\""

msgid "STORY_EVENT@1167_575@TITLE"
msgstr "Medicinal Application"

msgid "STORY_EVENT@1167_576@BODY_FOOTER"
msgstr "\"My <<EventUnit{brother/sister}>>, a capable {EventUnit}, shall fully recover. Kindly let us know how we may serve you.\""

msgid "STORY_EVENT@1167_576@BODY_HEADER"
msgstr "Now that you've secured the {EventMaterial}, {EventHero.FirstName} dutifully answers your summons. <<Cp:EventHero>> notices the harvested material and grins."

msgid "STORY_EVENT@1167_576@BODY_LORE"
msgstr "\"Thank you! A thousand times thank you, O {PlayerLeader.Title}. I shall take this to the herbalists at once!\" {EventHero} bows before you, sincerely moved by your generosity. \"I possess little wealth. But for aiding us, I would gift you this family heirloom: a {EventItem}.\""

msgid "STORY_EVENT@1167_576@BUTTON_0"
msgstr "{EventCity} shall benefit [population/] from the medicinal effects of the {EventMaterial}."

msgid "STORY_EVENT@1167_576@BUTTON_1"
msgstr "Recruit the recovered {EventUnit}. [unit/]"

msgid "STORY_EVENT@1167_576@BUTTON_2"
msgstr "Have {EventHero.FirstName} develop <<o:EventHero>> healing skills. [unitHero/]"

msgid "STORY_EVENT@1167_576@BUTTON_3"
msgstr "\"Thank the {EventRace} and their healing lore.\" [happiness/]"

msgid "STORY_EVENT@1167_576@TITLE"
msgstr "Medicinal Application: Aftermath"

msgid "STORY_EVENT@1167_670@BODY_FOOTER"
msgstr "You can choose to press on, but perhaps it is wiser to return with {EventHero} present."

msgid "STORY_EVENT@1167_670@BODY_HEADER"
msgstr "Your forces approach the {EventSpawner}, ready to attack."

msgid "STORY_EVENT@1167_670@BODY_LORE"
msgstr "However, {EventHero} desires that <<p:EventHero>> <<r:EventHero>> joins the assault of this {EventSpawner}."

msgid "STORY_EVENT@1167_670@BUTTON_0"
msgstr "The threat of the {EventSpawner} is too acute! Attack!"

msgid "STORY_EVENT@1167_670@BUTTON_1"
msgstr "Return with {EventHero} later."

msgid "STORY_EVENT@1167_670@TITLE"
msgstr "Second thoughts"

msgid "STORY_EVENT@1167_726@BODY_FOOTER"
msgstr "The Silver Knight points <<o:SilverKnight>> blade at {EventHero.FirstName} and lunges forward. \"We will fight each other. Until one of us falls.\""

msgid "STORY_EVENT@1167_726@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "The Silver Knight points <<o:SilverKnight>> blade at you and lunges forward. \"We will fight each other. Until one of us falls.\""

msgid "STORY_EVENT@1167_726@BODY_HEADER"
msgstr "{EventHero} explores the {EventStructure} of vitreous trees. A tall Knight, clad in silver armor, waits for <<P:EventHero>>."

msgid "STORY_EVENT@1167_726@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "You explore the {EventStructure} of vitreous trees. A tall Knight, clad in silver armor, waits for you."

msgid "STORY_EVENT@1167_726@BODY_LORE"
msgstr "The Silver Knight draws <<o:SilverKnight>> sword. \"Visitors in the Silver Realm? Has my master finally sent relief?\" Howling <<m:EventUnit>> step forward from the trees. \"I see. As I am not yet permitted to venture outside, you are not permitted to venture within.\" The <<m:EventUnit>> turn to <<G:troops^p,{EventHero.FirstName}>>, snarling. \"It appears my master wishes you dead,\" the Knight declares."

msgid "STORY_EVENT@1167_726@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "The Silver Knight draws <<o:SilverKnight>> sword. \"Visitors in the Silver Realm? Has my master finally sent relief?\" Howling <<m:EventUnit>> step forward from the trees. \"I see. As I am not yet permitted to venture outside, you are not permitted to venture within.\" The <<m:EventUnit>> turn to your troops, snarling. \"It appears my master wishes you dead,\" the Knight declares."

msgid "STORY_EVENT@1167_726@BUTTON_0"
msgstr "Defend against the Silver Knight's attacks."

msgid "STORY_EVENT@1167_726@BUTTON_1"
msgstr "\"We've defeated you before. We will defeat you again.\" [morale/]"

msgid "STORY_EVENT@1167_726@BUTTON_2"
msgstr "Replicate the Duelist's Protection that safeguards the Silver Knight."

msgid "STORY_EVENT@1167_726@BUTTON_4"
msgstr "\"You and me until death, Silver Knight!\" [mana/]"

msgid "STORY_EVENT@1167_726@BUTTON_5"
msgstr "Retreat from this Silver Realm."

msgid "STORY_EVENT@1167_726@TITLE"
msgstr "The Silver Realm"

msgid "STORY_EVENT@1167_727@BODY_FOOTER"
msgstr "{EventHero} has an opportunity to break the Silver Knight's curse or seize another boon from the abandoned {EventStructure}."

msgid "STORY_EVENT@1167_727@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "You have an opportunity to break the Silver Knight's curse or seize another boon from the abandoned {EventStructure}."

msgid "STORY_EVENT@1167_727@BODY_HEADER"
msgstr "The Silver Knight lies at <<G:feet^p,EventHero>>, <<o:SilverKnight>> blade cracked, but not broken."

msgid "STORY_EVENT@1167_727@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "The Silver Knight lies at your feet, <<o:SilverKnight>> blade cracked, but not broken."

msgid "STORY_EVENT@1167_727@BODY_LORE"
msgstr "The Knight scoffs. \"Once,\" <<p:SilverKnight>> says, \"I was the Wanderer. I sailed the {GLOBAL.AstralSeaLoreConcept.Hyperlink} on a quest of my own. Until my master bound me in this form. Now I am doomed to return in another {EventStructure}, in another Realm.\" Already the Silver Knight's body begins to fade away. \"In an everlasting cycle, until my master decides otherwise.\""

msgid "STORY_EVENT@1167_727@BUTTON_0"
msgstr "Destroy the Silver Knight's blade [bindingfragments/] and end the curse. [goodact/]"

msgid "STORY_EVENT@1167_727@BUTTON_1"
msgstr "Bind one of the ambling <<m:EventUnit>> [unit/] to your will."

msgid "STORY_EVENT@1167_727@BUTTON_3"
msgstr "Study [knowledge/] the forest and the Silver Knight's blade before they vanish."

msgid "STORY_EVENT@1167_727@BUTTON_4"
msgstr "Sever the Knight's hand [evilact/] to display as a trophy. [influence/]"

msgid "STORY_EVENT@1167_727@TITLE"
msgstr "The Silver Realm: Aftermath"

msgid "STORY_EVENT@1167_728@BODY_FOOTER"
msgstr "Despite the mist, a {EventUnit} spots your warband and shrieks: \"Kill the interlopers! Protect the secrets of the Court!\""

msgid "STORY_EVENT@1167_728@BODY_HEADER"
msgstr "Traversing the wilderness, {EventHero} and <<o:EventHero>> army happen upon a clearing near a wellspring, where a Fairy Court has assembled."

msgid "STORY_EVENT@1167_728@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Traversing the wilderness, you and your army happen upon a clearing near a wellspring, where a Fairy Court has assembled."

msgid "STORY_EVENT@1167_728@BODY_LORE"
msgstr "{EventHero.FirstName} has heard about these gatherings in legends. Emissaries of the {GLOBAL.DuathadaeLoreConcept.Hyperlink} and other Fey Folk convene in magical places to hold a Fairy Court, where they consult and scheme. Fairy Courts are protected by the veil of lingering mists, but somehow your [hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink] must have broken through their concealing veil. Around a stone table, Fairies chatter and eat enchanting viands."

msgid "STORY_EVENT@1167_728@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "You have heard about these gatherings in legends. Emissaries of the {GLOBAL.DuathadaeLoreConcept.Hyperlink} and other Fey Folk convene in magical places to hold a Fairy Court, where they consult and scheme. Fairy Courts are protected by the veil of lingering mists, but somehow you must have broken through their concealing veil. Around a stone table, Fairies chatter and eat enchanting viands."

msgid "STORY_EVENT@1167_728@BUTTON_0"
msgstr "Attack the Fairies in the mist."

msgid "STORY_EVENT@1167_728@BUTTON_1"
msgstr "Magically alter [mana/] how mist affects the Fairies."

msgid "STORY_EVENT@1167_728@BUTTON_3"
msgstr "Conjure magical defenses against the Fey attacks."

msgid "STORY_EVENT@1167_728@BUTTON_4"
msgstr "Draw power from the {EventStructure} to lower the Fairies' resistance."

msgid "STORY_EVENT@1167_728@BUTTON_5"
msgstr "Call forth a gale to drive the mists from the {EventStructure}."

msgid "STORY_EVENT@1167_728@BUTTON_6"
msgstr "Retrace your steps to escape the Court's ire."

msgid "STORY_EVENT@1167_728@TITLE"
msgstr "The Fairy Court"

msgid "STORY_EVENT@1167_729@BODY_FOOTER"
msgstr "The {EventUnit} pleads: \"In exchange for keeping the Fairy Court a secret, go now with one treasure from our gathering.\""

msgid "STORY_EVENT@1167_729@BODY_HEADER"
msgstr "{EventHero} stands victorious amid the Fairy Court. \"Enough! We yield!\" cries a {EventUnit}. \"Take a prize from our hoard and go!\""

msgid "STORY_EVENT@1167_729@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "You stand victorious amid the Fairy Court. \"Enough! We yield!\" cries a {EventUnit}. \"Take a prize from our hoard and go!\""

msgid "STORY_EVENT@1167_729@BODY_LORE"
msgstr "The Fairies use this brief moment of respite to wrap themselves in layers of protective spells. \"You must leave,\" says the {EventUnit}. \"But you needn't leave empty-handed.\" <<Cp:EventUnit>> waves <<o:EventUnit>> little hands and appears to sing a short song. \"A blessing I laid upon your {PlayerLeader.Title}: our Gift of Gab! [hyperlink,GLOBAL.AscendedChampLoreConcept]Mortals[/hyperlink] and [hyperlink,GLOBAL.WizardKingLoreConcept]Wizard Kings[/hyperlink] will find <<o:PlayerLeader>> words irresistible.\""

msgid "STORY_EVENT@1167_729@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "The Fairies use this brief moment of respite to wrap themselves in layers of protective spells. \"You must leave,\" says the {EventUnit}. \"But you needn't leave empty-handed.\" <<Cp:EventUnit>> waves <<o:EventUnit>> little hands and appears to sing a short song. \"A blessing I laid upon you: our Gift of Gab! [hyperlink,GLOBAL.AscendedChampLoreConcept]Mortals[/hyperlink] and [hyperlink,GLOBAL.WizardKingLoreConcept]Wizard Kings[/hyperlink] will find your words irresistible.\""

msgid "STORY_EVENT@1167_729@BUTTON_0"
msgstr "Take Fairy food [food/] from the stone table."

msgid "STORY_EVENT@1167_729@BUTTON_1"
msgstr "Take the pot of gold [gold/] stashed under the table."

msgid "STORY_EVENT@1167_729@BUTTON_2"
msgstr "Claim a supply of Rainbow Clover."

msgid "STORY_EVENT@1167_729@BUTTON_4"
msgstr "Choose the power to call Mist."

msgid "STORY_EVENT@1167_729@BUTTON_4@LEARN_SPELL_MISTY_MAGIC"
msgstr "{PlayerLeader} learns the {GLOBAL.SPECIAL_OPERATIONS.MISTY_MAGIC.Hyperlink} Combat Spell."

msgid "STORY_EVENT@1167_729@TITLE"
msgstr "The Fairy Court: Aftermath"

msgid "STORY_EVENT@1167_730@BODY_FOOTER"
msgstr "Eventually, the {EventItem} will complete and the [hyperlink,GLOBAL.ShadowRealmLoreConcept]Umbral Deity[/hyperlink] will enter this realm. Being in its presence dwindles <<G:spirit^n,EventHero.FirstName>>."

msgid "STORY_EVENT@1167_730@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Eventually, the {EventItem} will complete and the [hyperlink,GLOBAL.ShadowRealmLoreConcept]Umbral Deity[/hyperlink] will enter this realm. Being in its presence dwindles your spirit."

msgid "STORY_EVENT@1167_730@BODY_HEADER"
msgstr "{EventHero} enters the {EventStructure} to the sound of clinking hammers and anvils. <<m:EventUnit>> are working the forge."

msgid "STORY_EVENT@1167_730@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "You enter the {EventStructure} to the sound of clinking hammers and anvils. <<m:EventUnit>> are working the forge."

msgid "STORY_EVENT@1167_730@BODY_LORE"
msgstr "With every beat of the hammer, {EventHero.FirstName} feels a darkness tugging at <<o:EventHero>> resolve. <<Cp:EventHero>> wishes to flee. Abandon hope. Forsake whatever oaths <<p:EventHero>> has taken. The <<m:EventUnit>>, who have not yet noticed your army, chant. They sing of an [hyperlink,GLOBAL.ShadowRealmLoreConcept]Umbral Deity[/hyperlink], portended to return once the forging of the {EventItem} is completed. Fear grips <<G:heart^n,EventHero.FirstName>>."

msgid "STORY_EVENT@1167_730@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "With every beat of the hammer, you sense a darkness tugging at your resolve. You wish to flee. Abandon hope. Forsake whatever oaths you have taken. The <<m:EventUnit>>, who have not yet noticed your army, chant. They sing of an [hyperlink,GLOBAL.ShadowRealmLoreConcept]Umbral Deity[/hyperlink], portended to return once the forging of the {EventItem} is completed. Fear grips your heart."

msgid "STORY_EVENT@1167_730@BUTTON_0"
msgstr "Attack the devious forgemasters!"

msgid "STORY_EVENT@1167_730@BUTTON_1"
msgstr "Use simple wintry spells [mana/] to cool the forge!"

msgid "STORY_EVENT@1167_730@BUTTON_5"
msgstr "Steel your troops' souls against the spirit-sapping influence."

msgid "STORY_EVENT@1167_730@BUTTON_6"
msgstr "Stand proud. [influence/] This realm's fate hinges on your resolve [morale/] today."

msgid "STORY_EVENT@1167_730@BUTTON_7"
msgstr "Leave the {EventStructure}. The <<m:EventUnit>> seem busy after all."

msgid "STORY_EVENT@1167_730@TITLE"
msgstr "The Wailing {EventItem}"

msgid "STORY_EVENT@1167_731@BODY_FOOTER"
msgstr "While <<o:EventHero>> troops gather the armaments created in the {EventStructure}, {EventHero.FirstName} ponders what to do with the unfinished {EventItem}."

msgid "STORY_EVENT@1167_731@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "While your troops gather the armaments created in the {EventStructure}, you ponder what you should do with the unfinished {EventItem}."

msgid "STORY_EVENT@1167_731@BODY_HEADER"
msgstr "{EventHero} has cleansed the {EventStructure} of the forgemasters' cult's presence and denied the [hyperlink,GLOBAL.ShadowRealmLoreConcept]Umbral Deity[/hyperlink] its return."

msgid "STORY_EVENT@1167_731@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "You have cleansed the {EventStructure} of the forgemasters' cult's presence and denied the [hyperlink,GLOBAL.ShadowRealmLoreConcept]Umbral Deity[/hyperlink] its return."

msgid "STORY_EVENT@1167_731@BODY_LORE"
msgstr "Upon closer inspection, it is clear to {EventHero.FirstName} that the <<m:EventUnit>> have been laboring towards their Deity's return for years. The forging of the {EventItem} was to be their final achievement, yet they had already created an army's worth of weapons and armor. This was not merely some unholy worship. This would have become an abominable invasion."

msgid "STORY_EVENT@1167_731@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Upon closer inspection, it is clear to you that the <<m:EventUnit>> have been laboring towards their Deity's return for years. The forging of the {EventItem} was to be their final achievement, yet they had already created an army's worth of weapons and armor. This was not merely some unholy worship. This would have become an abominable invasion."

msgid "STORY_EVENT@1167_731@BUTTON_0"
msgstr "Destroy [goodact/] the {EventItem}! [influence/]"

msgid "STORY_EVENT@1167_731@BUTTON_1"
msgstr "Take [evilact/] the cursed {EventItem}. [item/]"

msgid "STORY_EVENT@1167_731@BUTTON_2"
msgstr "Reforge [bindingfragments/] the {EventItem}."

msgid "STORY_EVENT@1167_731@TITLE"
msgstr "The Wailing {EventItem}: Aftermath"

msgid "STORY_EVENT@1167_732@BODY_FOOTER"
msgstr "From the shadows, a {EventStackLeader} puppeteers the {EventUnitA} and the other victims, who draw their weapons silently to attack {EventHero.FirstName}."

msgid "STORY_EVENT@1167_732@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "From the shadows, a {EventStackLeader} puppeteers the {EventUnitA} and the other victims, who draw their weapons silently to attack you."

msgid "STORY_EVENT@1167_732@BODY_HEADER"
msgstr "{EventHero} enters the {EventStructure} with healthy trepidation. A voice, eerily devoid of emotion, rings out: \"Help us. You must help us.\""

msgid "STORY_EVENT@1167_732@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "You enter the {EventStructure} with healthy trepidation. A voice, eerily devoid of emotion, rings out: \"Help us. You must help us.\""

msgid "STORY_EVENT@1167_732@BODY_LORE"
msgstr "A {EventUnitA} looks straight at {EventHero.FirstName}, <<o:EventUnitA>> expression blank. Other mages and warriors are huddled together in the Tower's shadowy hall. \"Yes. Come closer. You must help us,\" speaks a {EventUnitB}, but {EventHero.FirstName} again detects no spirit in <<o:EventUnitB>> voice. More hollow-eyed people shamble towards the center of the hall. A hoarse hiss from the darkest shadows then draws <<G:attention^n,EventHero>>."

msgid "STORY_EVENT@1167_732@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "A {EventUnitA} looks straight at you, <<o:EventUnitA>> expression blank. Other mages and warriors are huddled together in the Tower's shadowy hall. \"Yes. Come closer. You must help us,\" speaks a {EventUnitB}, but you again detect no spirit in <<o:EventUnitB>> voice. More hollow-eyed people shamble towards the center of the hall. A hoarse hiss from the darkest shadows then draws your attention."

msgid "STORY_EVENT@1167_732@BUTTON_0"
msgstr "Attack the {EventStackLeader} and <<o:EventStackLeader>> unwilling flock."

msgid "STORY_EVENT@1167_732@BUTTON_1"
msgstr "Break [mana/] the <<G:hold^n,EventStackLeader>> over the {EventUnitA}."

msgid "STORY_EVENT@1167_732@BUTTON_3"
msgstr "Let your stupefying glory [influence/] shield your warrior from the <<G:dominance^n,EventStackLeader>>."

msgid "STORY_EVENT@1167_732@BUTTON_5"
msgstr "\"Our faith is stronger than this cretin's dark curse.\""

msgid "STORY_EVENT@1167_732@BUTTON_6"
msgstr "Convert one of the mind controlled warriors to your side."

msgid "STORY_EVENT@1167_732@BUTTON_7"
msgstr "Leave the {EventStructure} before your army falls to the <<G:spell^n,EventStackLeader>>."

msgid "STORY_EVENT@1167_732@TITLE"
msgstr "Forlorn Puppeteer"

msgid "STORY_EVENT@1167_733@BODY_FOOTER"
msgstr "{EventHero.FirstName} carves out the <<G:third eye^n,EventStackLeader>> and spends some time studying it. What will <<p:EventHero>> focus on?"

msgid "STORY_EVENT@1167_733@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "You carve out the <<G:third eye^n,EventStackLeader>> and spend some time studying it. What will you focus on?"

msgid "STORY_EVENT@1167_733@BODY_HEADER"
msgstr "{EventHero} felled the puppeteering {EventStackLeader} and <<o:EventStackLeader>> victims."

msgid "STORY_EVENT@1167_733@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "You felled the puppeteering {EventStackLeader} and <<o:EventStackLeader>> victims."

msgid "STORY_EVENT@1167_733@BODY_LORE"
msgstr "Released from the foul creature's control, surviving <<m:EventUnit>> vacantly shamble throughout the {EventStructure}. {EventHero.FirstName} ignores them; <<p:EventHero>> looks to investigate how this {GLOBAL.LostWizardLoreConcept.Hyperlink} gained mind-controlling abilities. As <<p:EventHero>> studies the corpse, a third eye suddenly pops open in the <<G:forehead^n,EventStackLeader>>. {EventHero.FirstName} wonders if this particular {EventStackLeader} had been enthralled by {GLOBAL.ShadowDemonsLoreConcept.Hyperlink} before arriving in this realm."

msgid "STORY_EVENT@1167_733@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Released from the foul creature's control, surviving <<m:EventUnit>> vacantly shamble throughout the {EventStructure}. You ignore them. Instead, you look to investigate how this {GLOBAL.LostWizardLoreConcept.Hyperlink} gained mind-controlling abilities. As you study the corpse, a third eye suddenly pops open in the <<G:forehead^n,EventStackLeader>>. You wonder if this particular {EventStackLeader} had been enthralled by {GLOBAL.ShadowDemonsLoreConcept.Hyperlink} before arriving in this realm."

msgid "STORY_EVENT@1167_733@BUTTON_1"
msgstr "Restore the sanity of the ambling <<m:EventUnit>> [unit/] and recruit them."

msgid "STORY_EVENT@1167_733@BUTTON_2"
msgstr "Assimilate the Lost Wizard's mutation [evilact/] to gain [unitHero/] domination powers."

msgid "STORY_EVENT@1167_733@BUTTON_3"
msgstr "Bestow permanent mind control immunity upon the warriors who fought this {EventStackLeader}."

msgid "STORY_EVENT@1167_733@BUTTON_7"
msgstr "Craft a {EventItem} [item/] from the eye."

msgid "STORY_EVENT@1167_733@TITLE"
msgstr "Forlorn Puppeteer: Aftermath"

msgid "STORY_EVENT@1167_832@BODY_FOOTER"
msgstr "\"Walk away!\", bellows a {EventUnit} that spots {EventHero.FirstName}. \"If you interfere, our thunderous fury will strike you too!\""

msgid "STORY_EVENT@1167_832@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "\"Walk away!\", bellows a {EventUnit} that spots you. \"If you interfere, our thunderous fury will strike you too!\""

msgid "STORY_EVENT@1167_832@BODY_HEADER"
msgstr "Lighting strikes the ground, not a stone's throw from where {EventHero} stands. Another bolt hits the towering {EventStructure} before <<P:EventHero>>."

msgid "STORY_EVENT@1167_832@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Lighting strikes the ground, not a stone's throw from where you stands. Another bolt hits the towering {EventStructure} before you."

msgid "STORY_EVENT@1167_832@BODY_LORE"
msgstr "The <<m:EventUnit>>, no longer content with flattening mountains, have set their eyes on the {EventStructure}. They besiege it with the intent of felling it entirely in accordance to their efforts to reshape the realm. They brought thunder, lightning, and axes, along with a host of electrifying beasts."

msgid "STORY_EVENT@1167_832@BUTTON_0"
msgstr "Attack the <<m:EventUnit>> and their beasts!"

msgid "STORY_EVENT@1167_832@BUTTON_1"
msgstr "Manipulate [mana/] the storms to hit the <<m:EventUnit>> first."

msgid "STORY_EVENT@1167_832@BUTTON_3"
msgstr "Command lightning to hasten your warriors if it hits them."

msgid "STORY_EVENT@1167_832@BUTTON_4"
msgstr "Ask the {EventStructure} to help your warriors resist the storm."

msgid "STORY_EVENT@1167_832@BUTTON_5"
msgstr "Ground your troops to protect them from the lightning."

msgid "STORY_EVENT@1167_832@BUTTON_6"
msgstr "Call forth the cold to infuse the raging thunderstorm with frost."

msgid "STORY_EVENT@1167_832@BUTTON_7"
msgstr "Heed the <<G:warning^n,EventUnit>> and walk away."

msgid "STORY_EVENT@1167_832@TITLE"
msgstr "Thundered Timber"

msgid "STORY_EVENT@1167_833@BODY_FOOTER"
msgstr "{EventHero.FirstName} collects the fallen timber and looks for a memento or prize to commemorate the siege of the {EventStructure}."

msgid "STORY_EVENT@1167_833@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "You collect the fallen timber and look for a memento or prize to commemorate the siege of the {EventStructure}."

msgid "STORY_EVENT@1167_833@BODY_HEADER"
msgstr "The {EventStructure} still stands, which is more than {EventHero} can say about the <<m:EventUnit>> and their followers."

msgid "STORY_EVENT@1167_833@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "The {EventStructure} still stands, which is more than you can say about the <<m:EventUnit>> and their followers."

msgid "STORY_EVENT@1167_833@BODY_LORE"
msgstr "The thunderous horde of the <<m:EventUnit>> are dead or scattered. A few <<m:EventUnitB>> roost in the canopy of the {EventStructure}, which survived the siege despite manifold scorch marks and broken branches. And several axes still stuck in its trunk. The surrounding fields crackle with weaponry infused with lightning that litter the grasslands like autumn leaves after a storm."

msgid "STORY_EVENT@1167_833@BUTTON_0"
msgstr "Display a broken branch [influence/] in {EventCity} to commemorate today's achievement."

msgid "STORY_EVENT@1167_833@BUTTON_1"
msgstr "Pick up the {EventItem} [item/] that the {EventUnit} chieftain dropped."

msgid "STORY_EVENT@1167_833@BUTTON_2"
msgstr "Tame two <<m:EventUnitB>> [unit/] that flutter nearby still."

msgid "STORY_EVENT@1167_833@BUTTON_3@LEARN_SPELL_AMPLIFICATION_ARROWS"
msgstr "{PlayerLeader} learns the {GLOBAL.SPECIAL_OPERATIONS.AMPLIFIED_ARROWS.Hyperlink} Enchantment."

msgid "STORY_EVENT@1167_833@BUTTON_3@LEARN_SPELL_LIGHTNING_BLADES"
msgstr "{PlayerLeader} learns the {GLOBAL.SPECIAL_OPERATIONS.LIGHTNING_BLADES.Hyperlink} Enchantment."

msgid "STORY_EVENT@1167_833@BUTTON_4"
msgstr "Harness the lingering lightning force to augment your weaponry."

msgid "STORY_EVENT@1167_833@TITLE"
msgstr "Thundered Timber: Aftermath"

msgid "STORY_EVENT@1167_834@BODY_FOOTER"
msgstr "The influx of [hyperlink,GLOBAL.ChaosConcept]Chaos[/hyperlink] animates the Golems that line the <<G:walls^p,EventStructure>> with fiery intent. \"It is the only way,\" confesses the {EventUnit}."

msgid "STORY_EVENT@1167_834@BODY_HEADER"
msgstr "Upon entering the {EventStructure}, {EventHero} is greeted by a flustered {EventUnit}. \"Did your research lead you here, too?\", <<p:EventUnit>> asks."

msgid "STORY_EVENT@1167_834@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Upon entering the {EventStructure}, you are greeted by a flustered {EventUnit}. \"Did your research lead you here, too?\", <<p:EventUnit>> asks."

msgid "STORY_EVENT@1167_834@BODY_LORE"
msgstr "<<Cp:EventUnit>> knows <<G:puzzled look^n,{EventHero.FirstName}>> all too well. \"I am an alchemist,\" <<p:EventUnit>> explains, \"seeking to create the Prima Materia. I'm about to prove my hypothesis!\" The {EventUnit} turns several gold dials, prompting the {EventStructure} to hum and vibrate. \"I am sorry,\" the {EventUnit} suddenly says. \"To make the Prima Materia, the [hyperlink,GLOBAL.OrderConcept]Order[/hyperlink] in [hyperlink,GLOBAL.MateriumConcept]Materium[/hyperlink] must be countered with [hyperlink,GLOBAL.ChaosConcept]Chaos[/hyperlink].\""

msgid "STORY_EVENT@1167_834@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "<<Cp:EventUnit>> knows your puzzled look all too well. \"I am an alchemist,\" <<p:EventUnit>> explains, \"seeking to create the Prima Materia. I'm about to prove my hypothesis!\" The {EventUnit} turns several gold dials, prompting the {EventStructure} to hum and vibrate. \"I am sorry,\" the {EventUnit} suddenly says. \"To make the Prima Materia, the [hyperlink,GLOBAL.OrderConcept]Order[/hyperlink] in [hyperlink,GLOBAL.MateriumConcept]Materium[/hyperlink] must be countered with [hyperlink,GLOBAL.ChaosConcept]Chaos[/hyperlink].\""

msgid "STORY_EVENT@1167_834@BUTTON_0"
msgstr "Attack the {EventUnit} and the hostile Golems!"

msgid "STORY_EVENT@1167_834@BUTTON_1"
msgstr "Magically [mana/] protect your army against fire."

msgid "STORY_EVENT@1167_834@BUTTON_10"
msgstr "Leave the {EventUnit} and the {EventStructure}."

msgid "STORY_EVENT@1167_834@BUTTON_3"
msgstr "Train [unitprod/] your troops to recognize the fighting patterns of the Golems."

msgid "STORY_EVENT@1167_834@BUTTON_7"
msgstr "Quench the inner flames that augmented the Golems."

msgid "STORY_EVENT@1167_834@BUTTON_8"
msgstr "Use your control over metals to slowly turn the Golems to gold."

msgid "STORY_EVENT@1167_834@BUTTON_9"
msgstr "Redirect the influx of Chaos energy to enhance your weaker soldiers."

msgid "STORY_EVENT@1167_834@TITLE"
msgstr "Prima Materia"

msgid "STORY_EVENT@1167_835@BODY_FOOTER"
msgstr "The Prima Materia is yours, although its full potential is unknown to you. What other boon of creation shall {EventHero.FirstName} claim in your name?"

msgid "STORY_EVENT@1167_835@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "The Prima Materia is yours, although its full potential is unknown to you. What other boon of creation shall be yours?"

msgid "STORY_EVENT@1167_835@BODY_HEADER"
msgstr "The {EventUnit} has been slain. Your army has survived the torrent of [hyperlink,GLOBAL.MateriumConcept]Materium[/hyperlink] and [hyperlink,GLOBAL.ChaosConcept]Chaos[/hyperlink]."

msgid "STORY_EVENT@1167_835@BODY_LORE"
msgstr "Despite the treacherous hostility of the {EventUnit}, <<p:EventUnit>> spoke no lie. The {EventStructure} is a trove of alchemical discoveries. And now, at <<o:EventStructure>> center, suspended in mid-air, a transmorphic substance shifts and twists non-stop. The Prima Materia. It will allow you to forge powerful artifacts and weapons."

msgid "STORY_EVENT@1167_835@BUTTON_0"
msgstr "Pilfer the gold [gold/] that plates the walls and the Golems."

msgid "STORY_EVENT@1167_835@BUTTON_2"
msgstr "Take the {EventItem} [item/] that the {EventUnit} tucked in <<o:EventUnit>> knapsack."

msgid "STORY_EVENT@1167_835@BUTTON_3"
msgstr "Collect the metals and stone [structureprod/] that litter the {EventStructure}."

msgid "STORY_EVENT@1167_835@BUTTON_4"
msgstr "Study the alchemical secrets [knowledge/] of the {EventStructure}."

msgid "STORY_EVENT@1167_835@TITLE"
msgstr "Prima Materia: Aftermath"

msgid "STORY_EVENT@1167_836@BODY_FOOTER"
msgstr "The kingly Ghoul whispers: \"I am the Sleeper in Shadow. Won't you join me inside?\" {EventHero.FirstName} unwillingly puts one step forward."

msgid "STORY_EVENT@1167_836@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "The kingly Ghoul whispers: \"I am the Sleeper in Shadow. Won't you join me inside?\" You unwillingly put one step forward."

msgid "STORY_EVENT@1167_836@BODY_HEADER"
msgstr "{EventHero} prepares to explore the {EventStructure} when a wide-eyed scribe sprints out: \"He slumbers no more! Flee, fools! Flee!\""

msgid "STORY_EVENT@1167_836@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "You prepare to explore the {EventStructure} when a wide-eyed scribe sprints out: \"He slumbers no more! Flee, fools! Flee!\""

msgid "STORY_EVENT@1167_836@BODY_LORE"
msgstr "A chilling wind, as if a monster inhales, pulls {EventHero.FirstName} towards the entrance. The ground then trembles, but there is no rumbling. A black fog creeps from the mouth of the {EventStructure}. It conceals a ghastly figure that feels as ancient and evil as it does regal. Your army's resolve dwindles, while insanity claws at <<G:mind^n,EventHero>>."

msgid "STORY_EVENT@1167_836@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "A chilling wind, as if a monster inhales, pulls you towards the entrance. The ground then trembles, but there is no rumbling. A black fog creeps from the mouth of the {EventStructure}. It conceals a ghastly figure that feels as ancient and evil as it does regal. Your army's resolve dwindles, while insanity claws at your mind."

msgid "STORY_EVENT@1167_836@BUTTON_0"
msgstr "Run in to attack the Sleeper in Shadow."

msgid "STORY_EVENT@1167_836@BUTTON_1"
msgstr "\"Troops, keep your mind off whatever sluggish power lingers here!\""

msgid "STORY_EVENT@1167_836@BUTTON_2"
msgstr "\"The Natural Order will always prevail against darkness.\""

msgid "STORY_EVENT@1167_836@BUTTON_4"
msgstr "Kindle the inspiring power of your supporting forces."

msgid "STORY_EVENT@1167_836@BUTTON_5"
msgstr "\"Madness is no match against Chaos.\""

msgid "STORY_EVENT@1167_836@BUTTON_6"
msgstr "Snap out of the dreadful enchantment and retreat!"

msgid "STORY_EVENT@1167_836@BUTTON_7"
msgstr "Ward [mana/] yourself against the icy attacks of the damned and beshadowed."

msgid "STORY_EVENT@1167_836@TITLE"
msgstr "The Sleeper in Shadow"

msgid "STORY_EVENT@1167_837@BODY_FOOTER"
msgstr "While your warriors search the {EventStructure} for treasure, {EventHero.FirstName} ponders how this ordeal changed <<P:EventHero>> for the better."

msgid "STORY_EVENT@1167_837@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "While your warriors search the {EventStructure} for treasure, you ponder how this ordeal changed you for the better."

msgid "STORY_EVENT@1167_837@BODY_HEADER"
msgstr "After a fatiguing and nightmarish battle, the Sleeper in Shadow lies crumbled at <<G:feet^p,{EventHero.FirstName}>>. The shadow has passed."

msgid "STORY_EVENT@1167_837@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "After a fatiguing and nightmarish battle, the Sleeper in Shadow lies crumbled at your feet. The shadow has passed."

msgid "STORY_EVENT@1167_837@BODY_LORE"
msgstr "{EventHero.FirstName} recalls ancient legends of the {EventRace} about an ancient tyrant who was eventually slain and cursed. It was foretold that he would return to challenge any new power that seeks to claim these lands. {EventHero.FirstName} realizes that <<G:presence^n,PlayerLeader>> in the realm likely awoke the Sleeper in Shadow."

msgid "STORY_EVENT@1167_837@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "You recall ancient legends of the {EventRace} about an ancient tyrant who was eventually slain and cursed. It was foretold that he would return to challenge any new power that seeks to claim these lands. You realize that your presence in the realm likely awoke the Sleeper in Shadow."

msgid "STORY_EVENT@1167_837@BUTTON_0"
msgstr "Study [knowledge/] the archaic engravings and murals in the tomb."

msgid "STORY_EVENT@1167_837@BUTTON_2"
msgstr "Take the Sleeper in Shadow's black crown. [item/]"

msgid "STORY_EVENT@1167_837@BUTTON_4"
msgstr "The {EventStructure} is bloated with souls. [souls/]. Harvest them."

msgid "STORY_EVENT@1167_837@BUTTON_5"
msgstr "Spread joy [happiness/] in your cities by sealing the tomb undisturbed."

msgid "STORY_EVENT@1167_837@TITLE"
msgstr "The Sleeper in Shadow: Aftermath"

msgid "STORY_EVENT@1167_838@BODY_FOOTER"
msgstr "The Order of the Glutton will soon set the devouring {EnemyUnit} loose on the world. Their mad scheme should be stopped."

msgid "STORY_EVENT@1167_838@BODY_HEADER"
msgstr "{EventHero.Name} approaches a {EventStructure} built by the {GLOBAL.ArchonsLoreConcept.Hyperlink} long ago, and is greeted by chanting and a most foul odor."

msgid "STORY_EVENT@1167_838@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "You approach the {EventStructure} built by the {GLOBAL.ArchonsLoreConcept.Hyperlink} long ago, and are greeted by chanting and a most foul odor."

msgid "STORY_EVENT@1167_838@BODY_LORE"
msgstr "Peeking inside, {EventHero.FirstName} witnesses the mass of a cult, who have built half a dozen piles of bone and flesh. A their center, a {EventUnit} feeds a gluttonous {EnemyUnit} rotting carcasses to empower it. The cultists chant about the coming of The World Devourer, augured to consume the realm. Once the {EnemyUnit} is sufficiently fed, the cultists will unleash it."

msgid "STORY_EVENT@1167_838@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Peeking inside, you witness the mass of a cult, who have built half a dozen piles of bone and flesh. A their center, a {EventUnit} feeds a gluttonous {EnemyUnit} rotting carcasses to empower it. The cultists chant about the coming of The World Devourer, augured to consume the realm. Once the {EnemyUnit} is sufficiently fed, the cultists will unleash it."

msgid "STORY_EVENT@1167_838@BUTTON_0"
msgstr "\"Today your cult ends, you madmen!\""

msgid "STORY_EVENT@1167_838@BUTTON_1"
msgstr "Magically hasten [mana/] your fighters to quickly strike at the flesh piles."

msgid "STORY_EVENT@1167_838@BUTTON_2"
msgstr "\"By the legacy of the Archons, I rebuke and denounce you!\""

msgid "STORY_EVENT@1167_838@BUTTON_3"
msgstr "Poison the piles of bone and flesh that the {EnemyUnit} will devour."

msgid "STORY_EVENT@1167_838@BUTTON_5"
msgstr "Flee the {EventStructure} and the cult, for now."

msgid "STORY_EVENT@1167_838@BUTTON_6"
msgstr "Beguile the {EnemyUnit} to view your army as most unappetizing."

msgid "STORY_EVENT@1167_838@TITLE"
msgstr "Order Of The Glutton"

msgid "STORY_EVENT@1167_839@BODY_FOOTER"
msgstr "Yet the {EventStructure} is still befouled by filth and decay. How will {EventHero.FirstName} deal with the cult's mess?"

msgid "STORY_EVENT@1167_839@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Yet the {EventStructure} is still befouled by filth and decay. How will you deal with the cult's mess?"

msgid "STORY_EVENT@1167_839@BODY_HEADER"
msgstr "{EventHero.Name} has thwarted the scheme of the Order of the Glutton and slain the gorging {EnemyUnit}."

msgid "STORY_EVENT@1167_839@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "You have thwarted the scheme of the Order of the Glutton and slain the gorging {EnemyUnit}."

msgid "STORY_EVENT@1167_839@BODY_LORE"
msgstr "While inspecting the {EventStructure}, another {EventUnit} jumps out from a hidden alcove, attempting to escape. With the last corruptor leaving the Temple, the grace of the {GLOBAL.ArchonsLoreConcept.Hyperlink} that once ennobled this {EventStructure} is restored, and {EventHero.FirstName} feels their arcane blessing surge through <<o:EventHero>> body."

msgid "STORY_EVENT@1167_839@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "While inspecting the {EventStructure}, another {EventUnit} jumps out from a hidden alcove, attempting to escape. With the last corruptor leaving the Temple, the grace of the {GLOBAL.ArchonsLoreConcept.Hyperlink} that once ennobled this {EventStructure} is restored, and you feel their arcane blessing surge through your body."

msgid "STORY_EVENT@1167_839@BUTTON_0"
msgstr "Strip the {EventStructure} of its last remaining treasures. [gold/]"

msgid "STORY_EVENT@1167_839@BUTTON_1"
msgstr "Clean up the {EventStructure} to restore some of its former glory. [influence/]"

msgid "STORY_EVENT@1167_839@BUTTON_2"
msgstr "Deliver the meat [food/] intended for the {EnemyUnit} to {EventCity}."

msgid "STORY_EVENT@1167_839@BUTTON_3"
msgstr "Run after the {EventUnit} [unit/] and enlist <<P:EventUnit>>."

msgid "STORY_EVENT@1167_839@TITLE"
msgstr "Order Of The Glutton: Aftermath"

msgid "STORY_EVENT@1194_1362@BODY_FOOTER"
msgstr "Do you let the scared {EventStackLeader.Name} and other creatures go, or attack them regardless?"

msgid "STORY_EVENT@1194_1362@BODY_HEADER"
msgstr "Your troops engage the {EventStackLeader.Name} and <<o:EventStackLeader>> minions, but they cower in fear rather than put up a fight."

msgid "STORY_EVENT@1194_1362@BODY_LORE"
msgstr "Even with the freedom of the depths below them, the creatures tense up and remain frozen with their eyes wide open and fixed on your troops. The only sound coming from them is the occasional splash of water as they fearfully await their fate."

msgid "STORY_EVENT@1194_1362@BUTTON_0"
msgstr "Attack! [evilact/]"

msgid "STORY_EVENT@1194_1362@BUTTON_1"
msgstr "Let them go. [goodact/]"

msgid "STORY_EVENT@1194_1362@TITLE"
msgstr "Deep Fear"

msgid "STORY_EVENT@1194_1476@BODY_FOOTER"
msgstr "\"Aid us, O {PlayerLeader.Title}! Three Kjörnoe will merge for one to return! Riches, prosperity, and power will be our reward!\""

msgid "STORY_EVENT@1194_1476@BODY_HEADER"
msgstr "You have collected the {CauldronRelic}, {MirrorRelic}, and {GrailRelic}. Now, a strange cultist approaches you. \"You hold the relics of the [hyperlink,GLOBAL.TraitorKingsLoreConcept]Kjörnoe[/hyperlink],\" <<p:EventUnit>> whispers."

msgid "STORY_EVENT@1194_1476@BODY_LORE"
msgstr "\"I am a <<EventUnit{Son/Daughter}>> of the Kjörnoe, destined to reawaken the [hyperlink,GLOBAL.GiantKingLoreConcept]Giant Kings[/hyperlink] who were so unfairly declared 'Traitors.' For long, we have followed the Artifacts you now possess, waiting for someone to aid us. With the Sins of Three, your powers as a {GLOBAL.GodirLoreConcept.Hyperlink}, and an unwitting sacrifice, we can mend the Kjörnoe and return them to us!\""

msgid "STORY_EVENT@1194_1476@BUTTON_0"
msgstr "Initiate the ritual to bring back a Traitor King."

msgid "STORY_EVENT@1194_1476@BUTTON_1"
msgstr "Use the Artifacts to rule the Sons of the Kjörnoe yourself."

msgid "STORY_EVENT@1194_1476@BUTTON_2"
msgstr "Reject the cult of the Sons of the Kjörnoe. [goodact/]"

msgid "STORY_EVENT@1194_1476@TITLE"
msgstr "Return of the Kjörnoe"

msgid "STORY_EVENT@1194_1481@BODY_FOOTER"
msgstr "\"We were shattered, fragmented. Now we... I am {TraitorKingLord.FirstName}. My fate, bound to you. I pay our debts. Name yours.\""

msgid "STORY_EVENT@1194_1481@BODY_HEADER"
msgstr "Using your own {GLOBAL.GodirLoreConcept.Hyperlink} powers and the Artifacts of the {GLOBAL.TraitorKingsLoreConcept.Hyperlink}, you guide their fragmented souls to an unwilling host."

msgid "STORY_EVENT@1194_1481@BODY_LORE"
msgstr "Unable to respond to the sudden assault, {PreviousPlayer} is cast into the {GLOBAL.AstralVoidLoreConcept.Hyperlink}. <<Co:PreviousPlayer>> fading screams and the manic laughter of the Sons of the [hyperlink,GLOBAL.TraitorKingsLoreConcept]Kjörnoe[/hyperlink] herald the arrival of the {GLOBAL.TraitorKingsLoreConcept.Hyperlink}. Their fragmented souls merge to form one {GLOBAL.GiantKingLoreConcept.Hyperlink}, who roars with three voices before finding <<o:TraitorKingLord>> composure. <<Cp:TraitorKingLord>> turns to you: \"You have reawakened us.\""

msgid "STORY_EVENT@1194_1481@BUTTON_0"
msgstr "\"Grant me the riches [gold/] I was promised.\""

msgid "STORY_EVENT@1194_1481@BUTTON_1"
msgstr "\"I was told you brought prosperity.\" [food/]"

msgid "STORY_EVENT@1194_1481@BUTTON_2"
msgstr "\"Grant me your reverence!\" [influence/]"

msgid "STORY_EVENT@1194_1481@TITLE"
msgstr "Return of the Kjörnoe: Reawakening"

msgid "STORY_EVENT@1194_1490@BODY_FOOTER"
msgstr "The cultist wails in ecstasy. \"Channel the souls of the Kjörnoe, mend their fragments whole! Guide them to their host and throne!\""

msgid "STORY_EVENT@1194_1490@BODY_HEADER"
msgstr "Tears well in the eyes of the cultist. \"Yes! We shall commence the ritual immediately!\""

msgid "STORY_EVENT@1194_1490@BODY_LORE"
msgstr "Later, you find yourself in the center of an elaborate rune, the Artifacts of the {GLOBAL.TraitorKingsLoreConcept.Hyperlink} placed around you. Dark smoke envelops you as the cultist chants. \"The Kjörnoe sense your power,\" <<p:EventUnit>> exclaims. \"With you as their conduit, they lack merely a host, an unwitting {GLOBAL.GodirLoreConcept.Hyperlink} lamb to sacrifice! Find one, O {PlayerLeader.Title}! Grant the [hyperlink,GLOBAL.AstralVoidLoreConcept]Void[/hyperlink] its prize!\""

msgid "STORY_EVENT@1194_1490@BUTTON_0"
msgstr "Guide the fragmented souls to the chaos of {ReplacedPlayerChaos}. [evilact/]"

msgid "STORY_EVENT@1194_1490@BUTTON_1"
msgstr "Guide the fragmented souls to the steadfast aura of {ReplacedPlayerMaterium}. [evilact/]"

msgid "STORY_EVENT@1194_1490@BUTTON_2"
msgstr "Guide the fragmented souls to the thunderous spirit of {ReplacedPlayerAstral}. [evilact/]"

msgid "STORY_EVENT@1194_1490@BUTTON_3"
msgstr "Guide the fragmented souls to the cold soul of {ReplacedPlayerShadow}. [evilact/]"

msgid "STORY_EVENT@1194_1490@BUTTON_4"
msgstr "This goes too far. Stop the ritual and banish the cultist. [goodact/]"

msgid "STORY_EVENT@1194_1490@TITLE"
msgstr "Return of the Kjörnoe: Dark Ritual"

msgid "STORY_EVENT@1194_1595@BODY_FOOTER"
msgstr "The distance may be a blessing. For now the Umbral Abyss may slumber, but their forces may be overwhelming if you stir them without preparation."

msgid "STORY_EVENT@1194_1595@BODY_HEADER"
msgstr "You have settled on an island off the {EventRealm}. A light mist rests on the islands around you, obscuring the coast in the distance."

msgid "STORY_EVENT@1194_1595@BODY_LORE"
msgstr "You remember the description of the realm you were given. To the north and south, you see the outlines of jagged islands, small patches of land dotting the ocean. To the east, you imagine the looming Cliffs of Sordünn, claimed by the {GLOBAL.ShadowRealmLoreConcept.Hyperlink}. The ocean blocks them from your reach—and you from theirs."

msgid "STORY_EVENT@1194_1595@BUTTON_0"
msgstr "We must prepare our invasion of the Umbral Abyss."

msgid "STORY_EVENT@1194_1595@TITLE"
msgstr "The {EventRealm}"

msgid "STORY_EVENT@1194_1632@BODY_FOOTER"
msgstr "Or is it?"

msgid "STORY_EVENT@1194_1632@BODY_HEADER"
msgstr "Defeat {Merlin.TitleName}"

msgid "STORY_EVENT@1194_1632@BODY_LORE"
msgstr "T'is the only way"

msgid "STORY_EVENT@1194_1632@BUTTON_0"
msgstr "Mayhaps"

msgid "STORY_EVENT@1194_1632@TITLE"
msgstr "Save the Realm"

msgid "STORY_EVENT@1194_1633@BODY_FOOTER"
msgstr "Your soldiers sweep across the {EventRealm}, clearing out the last infestations of Umbral influence. This [hyperlink,GLOBAL.WorldsWithinLoreConcept]World[/hyperlink] and its [hyperlink,GLOBAL.DreamersLoreConcept]Dreamer[/hyperlink] can heal once more."

msgid "STORY_EVENT@1194_1633@BODY_HEADER"
msgstr "You have defeated {Merlin.TitleName} and <<o:Merlin>> [hyperlink,GLOBAL.ShadowDemonsLoreConcept]Umbral forces[/hyperlink]. <<Cp:Merlin>> sinks to the ground. {Sundren.FirstName} and {Julia.FirstName} appear and kneel next to <<P:Merlin>>."

msgid "STORY_EVENT@1194_1633@BODY_LORE"
msgstr "{Julia.FirstName} gently closes <<o:Merlin>> eyes. \"I am sorry, my old friend.\" <<Cp:Julia>> whispers, a single tear running down <<o:Julia>> face. {Sundren.FirstName} fixes her gaze on you. \"I tried to do right by my father, mother, and mentor. Perhaps I was wrong. Take me to Magehaven, to face my judgment, as {Merlin.FirstName} did here.\""

msgid "STORY_EVENT@1194_1633@BUTTON_0"
msgstr "A hard-earned victory."

msgid "STORY_EVENT@1194_1633@TITLE"
msgstr "The {EventRealm}, liberated"

msgid "STORY_EVENT@1194_1654@BODY_FOOTER"
msgstr "\"I sense a familiar presence, wreathed in shadows. My nature rejects the darkness, and yet a part of me urges us to investigate... I implore you to do so, {PlayerLeader.TitleName}. I feel it is important.\""

msgid "STORY_EVENT@1194_1654@BODY_HEADER"
msgstr "As you travel the {EventRealm}, {Julia.FirstName} contacts you. \"{PlayerLeader.FirstName}, I know we have an important mission to focus on, but I sense another presence on this realm.\""

msgid "STORY_EVENT@1194_1654@BODY_LORE"
msgstr "\"Something, or someone, reaches out to me from the {GLOBAL.ShadowRealmLoreConcept.Hyperlink}. It feels familiar, yet twisted, almost as if... No, I must not hope in vain.\" {Julia.FirstName} pleads: \"Whoever they are, they need our help.\""

msgid "STORY_EVENT@1194_1654@BUTTON_0"
msgstr "\"We shall see.\""

msgid "STORY_EVENT@1194_1654@TITLE"
msgstr "Flicker in the Dark"

msgid "STORY_EVENT@1194_1655@BODY_FOOTER"
msgstr "{Sundren.FirstName} barely reacts to her mother's stern tone. \"I did not make my decisions lightly, mother... I am here to save those I care about.\""

msgid "STORY_EVENT@1194_1655@BODY_HEADER"
msgstr "You have defeated the last [hyperlink,GLOBAL.ShadowDemonsLoreConcept]Umbral Demon[/hyperlink] that threatened the entity hidden in the watchtower. Now, a figure emerges from it."

msgid "STORY_EVENT@1194_1655@BODY_LORE"
msgstr "\"You recognize the figure as a female Elf, wreathed in defensive shadows. {Julia.FirstName} gasps. \"... Sundren? Is it truly you?\"[br/]The harsh gaze of the shadowy Elf shifts and her eyes widen. \"Mother?!\"\" {Sundren.FirstName} exclaims, and {Julia.FirstName} and {Sundren.FirstName} reunite, emotionally.[br/]\n"
"\"I have scoured the [hyperlink,GLOBAL.AstralSeaLoreConcept]Astral Sea[/hyperlink] for you,\" {Sundren.FirstName} finally says.[br/] {Julia.FirstName} nods. \"I have heard much of your endeavors, my daughter... And the ire you provoke.\""

msgid "STORY_EVENT@1194_1655@BUTTON_0"
msgstr "Keep listening."

msgid "STORY_EVENT@1194_1655@TITLE"
msgstr "Flicker in the Dark: Aftermath"

msgid "STORY_EVENT@1194_1658@BODY_FOOTER"
msgstr "\"There is a watchtower, where I made my stand. Free me, and I will be in your debt.\" The voice pauses for a moment. \"... Please.\""

msgid "STORY_EVENT@1194_1658@BODY_HEADER"
msgstr "Your troops enter the {GLOBAL.ShadowRealmLoreConcept.Hyperlink}. Immediately, a whisper reaches you, growing into an ethereal voice carried through the heavy air of the Umbral Abyss."

msgid "STORY_EVENT@1194_1658@BODY_LORE"
msgstr "\"I am on an important mission that will change the war against the {GLOBAL.ShadowRealmLoreConcept.Hyperlink}. But these cursed {GLOBAL.ShadowDemonsLoreConcept.Hyperlink} have proven to be... challenging. Help me, so I can finish my mission.\""

msgid "STORY_EVENT@1194_1658@BUTTON_0"
msgstr "\"I will consider this.\""

msgid "STORY_EVENT@1194_1658@TITLE"
msgstr "Flicker in the Dark: Into the Abyss"

msgid "STORY_EVENT@1194_1673@BODY_FOOTER"
msgstr "\"As a token of goodwill, I offer you the knowledge to traverse the seas of Sordünn. I also realize you may have more questions for me.\""

msgid "STORY_EVENT@1194_1673@BODY_HEADER"
msgstr "You are approached by a regal Elven woman. <<Co:Julia>> stature is proud, but <<o:Julia>> eyes betray ages of strife, loss, and hope."

msgid "STORY_EVENT@1194_1673@BODY_LORE"
msgstr "\"Hail, {PlayerLeader.TitleName},\" <<p:Julia>> says. \"My name is {Julia.Name}, {Julia.Title}. I was sent here by the {GLOBAL.ArchonsLoreConcept.Hyperlink} to aid you on this realm.\" <<Cp:Julia>> gazes upon the coast in the distance, and her voice fades for a moment. \"So many worlds, ravaged by the darkness... We must fight back.\""

msgid "STORY_EVENT@1194_1673@BUTTON_0"
msgstr "\"Who are you?\""

msgid "STORY_EVENT@1194_1673@BUTTON_1"
msgstr "\"Do you know anything about the Prophecy that brought us here?\""

msgid "STORY_EVENT@1194_1673@BUTTON_2"
msgstr "\"Have you fought the Umbral Abyss before?\""

msgid "STORY_EVENT@1194_1673@BUTTON_3"
msgstr "\"I accept your aid. Let us fight the Umbral Abyss, together.\""

msgid "STORY_EVENT@1194_1673@TITLE"
msgstr "The Archon Champion"

msgid "STORY_EVENT@1194_1676@BODY_FOOTER"
msgstr "\"The {EventRealm} used to be part of {GLOBAL.MyrridaLoreConcept.Hyperlink}. The {GLOBAL.ArchonsLoreConcept.Hyperlink} believe themselves to be the divine guard, and we are the new powers to rise. As for the stanza about Traitor's Blood... They could not agree upon its interpretation.\""

msgid "STORY_EVENT@1194_1676@BODY_HEADER"
msgstr "{Julia.FirstName} nods slowly. \"I know of the Prophecy of Golianth.\""

msgid "STORY_EVENT@1194_1676@BODY_LORE"
msgstr "{Julia.FirstName} recites: \"Divine Myopia, Balance Enchained;\n"
"Giant Empires Fall, Corruption Reigns;\n"
"\n"
"From Traitor’s Blood, Fate’s Trail Divides;\n"
"Darkness Slain, Through Fractured Light;\n"
"\n"
"Divine Guard must Rest, For New Powers to Rise;\n"
"Who Weigh the Cost of Mercy, To a Vengeful Demise.\""

msgid "STORY_EVENT@1194_1676@BUTTON_0"
msgstr "\"Who are you?\""

msgid "STORY_EVENT@1194_1676@BUTTON_1"
msgstr "\"Do you know anything about the Prophecy that brought us here?\""

msgid "STORY_EVENT@1194_1676@BUTTON_2"
msgstr "\"Have you fought the Umbral Abyss before?\""

msgid "STORY_EVENT@1194_1676@BUTTON_3"
msgstr "\"I accept your aid. Let us fight the Umbral Abyss, together.\""

msgid "STORY_EVENT@1194_1676@TITLE"
msgstr "The Prophecy of Golianth"

msgid "STORY_EVENT@1194_1677@BODY_FOOTER"
msgstr "\"I was found by an [hyperlink,GLOBAL.ArchonsLoreConcept]Archon[/hyperlink] vanguard and led to Emnora. Since then I have traveled the {GLOBAL.WorldsWithinLoreConcept.Hyperlink}, preserving life and rebuilding where I can.\""

msgid "STORY_EVENT@1194_1677@BODY_HEADER"
msgstr "{Julia.FirstName} sighs and nods. \"I have fought the forces of the {GLOBAL.ShadowRealmLoreConcept.Hyperlink} many times before... The final time, I lost.\""

msgid "STORY_EVENT@1194_1677@BODY_LORE"
msgstr "\"When the [hyperlink,GLOBAL.WorldGateLoreConcept]World Gates[/hyperlink] opened, the Empires of {GLOBAL.AthlaLoreConcept.Hyperlink} were already torn by war and conspiracy. We stood valiantly, but... My husband, he was—assassinated. I was captured instead.\" A bitter tone creeps into <<o:Julia>> voice as she continues: \"One day, I was freed, through an act as kind as it was foolish.\""

msgid "STORY_EVENT@1194_1677@BUTTON_0"
msgstr "\"Who are you?\""

msgid "STORY_EVENT@1194_1677@BUTTON_1"
msgstr "\"Do you know anything about the Prophecy that brought us here?\""

msgid "STORY_EVENT@1194_1677@BUTTON_2"
msgstr "\"Have you fought the Umbral Abyss before?\""

msgid "STORY_EVENT@1194_1677@BUTTON_3"
msgstr "\"I accept your aid. Let us fight the Umbral Abyss, together.\""

msgid "STORY_EVENT@1194_1677@TITLE"
msgstr "Lithyl's Prisoner"

msgid "STORY_EVENT@1194_1678@BODY_FOOTER"
msgstr "\"... But above all, I am a mother. To my two children: Thannis and [hyperlink,GLOBAL.SundrenLoreConcept]Sundren[/hyperlink]... wherever they may be.\""

msgid "STORY_EVENT@1194_1678@BODY_HEADER"
msgstr "{Julia.FirstName} smiles with a profound sadness. \"Who am I? That is a hard question to answer...\""

msgid "STORY_EVENT@1194_1678@BODY_LORE"
msgstr "\"I am the daughter of the late Emperor Inioch of {GLOBAL.AthlaLoreConcept.Hyperlink}, who I have loved and warred against. I am sister to [hyperlink,GLOBAL.MeandorLoreConcept]Meandor[/hyperlink], who I have warred against and loved. I am-\" her voice catches, only shortly: \"... Widow to my beloved king Saridas. I have warred, loved, followed and reigned. I have seen great atrocities, and beautiful kindness... I have been an outcast, and a queen to many.\""

msgid "STORY_EVENT@1194_1678@BUTTON_0"
msgstr "\"Who are you?\""

msgid "STORY_EVENT@1194_1678@BUTTON_1"
msgstr "\"Do you know anything about the Prophecy that brought us here?\""

msgid "STORY_EVENT@1194_1678@BUTTON_2"
msgstr "\"Have you fought the Umbral Abyss before?\""

msgid "STORY_EVENT@1194_1678@BUTTON_3"
msgstr "\"I accept your aid. Let us fight the Umbral Abyss, together.\""

msgid "STORY_EVENT@1194_1678@TITLE"
msgstr "Rebel, Queen, Mother"

msgid "STORY_EVENT@1194_1684@BODY_FOOTER"
msgstr "Too bad"

msgid "STORY_EVENT@1194_1684@BODY_HEADER"
msgstr "You meet {Merlin.TitleName}"

msgid "STORY_EVENT@1194_1684@BODY_LORE"
msgstr "He goes to war with you"

msgid "STORY_EVENT@1194_1684@BUTTON_0"
msgstr "Too bad"

msgid "STORY_EVENT@1194_1684@BUTTON_1"
msgstr "I can save you"

msgid "STORY_EVENT@1194_1684@TITLE"
msgstr "Meeting {Merlin.TitleName}"

msgid "STORY_EVENT@1194_1690@BODY_FOOTER"
msgstr "Sundren cannot do this herself, since she is too closely aligned with Shadow. She also realizes she cannot do everything alone (the Player needs to help her)"

msgid "STORY_EVENT@1194_1690@BODY_HEADER"
msgstr "Sundren shares that Merlin is attempting to corrupt the other Affinities, and the Archons (into Revenants)."

msgid "STORY_EVENT@1194_1690@BODY_LORE"
msgstr "\"He is currently the primary general of the Umbral Abyss, and is using his knowledge of the spheres/affinities to corrupt them.\"\n"
"Sundren shares that Merlin can potentially be cleansed, through channeling the different Affinities. \"There are others like me on this realm, we need to free all of them.\""

msgid "STORY_EVENT@1194_1690@BUTTON_0"
msgstr "I'll see what I can do."

msgid "STORY_EVENT@1194_1690@TITLE"
msgstr "Through Fractured Light"

msgid "STORY_EVENT@1194_1691@BODY_FOOTER"
msgstr "Confront him"

msgid "STORY_EVENT@1194_1691@BODY_HEADER"
msgstr "You collected all Affinities"

msgid "STORY_EVENT@1194_1691@BODY_LORE"
msgstr "Now you can set Merlin on a path of redemption"

msgid "STORY_EVENT@1194_1691@BUTTON_0"
msgstr "let's go"

msgid "STORY_EVENT@1194_1691@TITLE"
msgstr "Through Fractured Light: Aftermath"

msgid "STORY_EVENT@1194_1726@BODY_FOOTER"
msgstr "choose"

msgid "STORY_EVENT@1194_1726@BODY_HEADER"
msgstr "But you can use the affinities to cleanse him"

msgid "STORY_EVENT@1194_1726@BODY_LORE"
msgstr "will you do so?"

msgid "STORY_EVENT@1194_1726@BUTTON_0"
msgstr "I will put him on a path of redemption"

msgid "STORY_EVENT@1194_1726@BUTTON_1"
msgstr "nah, he deserves to die"

msgid "STORY_EVENT@1194_1726@TITLE"
msgstr "You defeated Merlin"

msgid "STORY_EVENT@1194_1738@BODY_FOOTER"
msgstr "gg"

msgid "STORY_EVENT@1194_1738@BODY_HEADER"
msgstr "Triggered the Order location"

msgid "STORY_EVENT@1194_1738@BODY_LORE"
msgstr "nice"

msgid "STORY_EVENT@1194_1738@BUTTON_0"
msgstr "cool"

msgid "STORY_EVENT@1194_1738@TITLE"
msgstr "Test"

msgid "STORY_EVENT@1194_1758@BODY_FOOTER"
msgstr "cool"

msgid "STORY_EVENT@1194_1758@BODY_HEADER"
msgstr "he is undead"

msgid "STORY_EVENT@1194_1758@BODY_LORE"
msgstr "also more lore"

msgid "STORY_EVENT@1194_1758@BUTTON_0"
msgstr "war it is"

msgid "STORY_EVENT@1194_1758@TITLE"
msgstr "meet the revenant"

msgid "STORY_EVENT@1194_1927@BODY_FOOTER"
msgstr "The ghost sighs, the scent of roses almost overwhelms you. \"How beautiful we were. How passionate our love...\""

msgid "STORY_EVENT@1194_1927@BODY_HEADER"
msgstr "You have found the source of the alluring call you heard before. The scent of roses and ashes grows stronger."

msgid "STORY_EVENT@1194_1927@BODY_LORE"
msgstr "Not long after, a faint figure appears before you. \"My Prince...\" She pauses. \"You are not my Pale Prince... But you carry his curse... my curse.\" She wails. \"Oh [hyperlink,GLOBAL.UrvatoghLoreConcept]Urvatogh[/hyperlink], what have I done...\"[br/][br/]She turns to you and gestures to the {EventStructure}. \"This is where we fought, this is where I cursed him. Where we betrayed each other...\""

msgid "STORY_EVENT@1194_1927@BUTTON_0"
msgstr "\"Tell me more.\""

msgid "STORY_EVENT@1194_1927@BUTTON_1"
msgstr "\"I've had quite enough of this ghost story. Begone.\""

msgid "STORY_EVENT@1194_1927@TITLE"
msgstr "Fire and Roses: Aftermath"

msgid "STORY_EVENT@1194_1941@BODY_FOOTER"
msgstr "\"Those beautiful roses, turned to {EventMaterial}... Forever out of my reach!\" She wails again, lost in agony. \"Why did he keep the roses away from me? Why? WHY?!\""

msgid "STORY_EVENT@1194_1941@BODY_HEADER"
msgstr "The ghost continues. \"I was a witch, blessed by Chaos... he was a Prince, favored by Shadow.\""

msgid "STORY_EVENT@1194_1941@BODY_LORE"
msgstr "\"My Prince... He grew roses of glass... Such beautiful roses! We fell in love. I gave him... Everything. And yet, he would not. He spared no rose for me. Why would he keep them from me? Our love turned to ash. And so, I decided to take what he would not give. I betrayed him, I... I...\""

msgid "STORY_EVENT@1194_1941@BUTTON_0"
msgstr "\"I will claim {EventMaterial} for you.\""

msgid "STORY_EVENT@1194_1941@BUTTON_1"
msgstr "\"Find something else to obsess over.\""

msgid "STORY_EVENT@1194_1941@TITLE"
msgstr "Heart of Glass"

msgid "STORY_EVENT@1194_1942@BODY_FOOTER"
msgstr "\"Now, I can rest... And I give you my weapon, to grant him the same relief.\" The witch disappears, the scent of roses fading with her memory."

msgid "STORY_EVENT@1194_1942@BODY_HEADER"
msgstr "You have claimed the {EventIngredient}. You hear a deep sigh as the ghost appears once more."

msgid "STORY_EVENT@1194_1942@BODY_LORE"
msgstr "\"...I betrayed my [hyperlink,GLOBAL.UrvatoghLoreConcept]Pale Prince[/hyperlink], tried to take a rose by force. We fought,\" she continues. \"My Chaos met his Shadow... In our final moment, I cursed him and his roses... He consumed me in his rage. I did not know... He had been growing a rose for me all along.\""

msgid "STORY_EVENT@1194_1942@BUTTON_0"
msgstr "Have your scholars [knowledge/] chronicle this story."

msgid "STORY_EVENT@1194_1942@BUTTON_1"
msgstr "Guide the lost soul [mana/] on her way to the Astral Sea. [goodact/]"

msgid "STORY_EVENT@1194_1942@BUTTON_2"
msgstr "Drain the witch of her essence [mana/] as she fades. [evilact/]"

msgid "STORY_EVENT@1194_1942@TITLE"
msgstr "Heart of Glass: Aftermath"

msgid "STORY_EVENT@1194_1945@BODY_FOOTER"
msgstr "\"Find me,\" the voice whispers, the scent almost irresistible: \"Return to me... My Prince...\""

msgid "STORY_EVENT@1194_1945@BODY_HEADER"
msgstr "As you travel through {EventRealm}, a faint scent catches your attention. It smells of fire, and roses, and passion."

msgid "STORY_EVENT@1194_1945@BODY_LORE"
msgstr "Your attention shifts to the strange scent, and as you focus you start hearing a voice, a faint whisper on the wind. \"Vampire... My Prince. Find me... Where we fought... Where we fell... Where my blood touched your lips.\""

msgid "STORY_EVENT@1194_1945@BUTTON_0"
msgstr "Follow the alluring scent."

msgid "STORY_EVENT@1194_1945@BUTTON_1"
msgstr "Focus on your other tasks."

msgid "STORY_EVENT@1194_1945@TITLE"
msgstr "Fire and Roses"

msgid "STORY_EVENT@1194_27@BODY_HEADER"
msgstr "Tales of a wicked {GLOBAL.GodirLoreConcept.Hyperlink} make even the most tenacious of your people shiver. While investigating these tales, you are contacted by none other than {EventRuler.TitleName}."

msgid "STORY_EVENT@1194_27@BODY_LORE"
msgstr "\"It seems my [hyperlink,GLOBAL.AlignmentConcept]reputation[/hyperlink] precedes me... And so does yours. Many so-called Rulers lack the willpower to claim and conquer what is theirs to take, but you don't hesitate. We have that in common. Accept my offer, and I can aid you on your path of domination, through any means necessary.\""

msgid "STORY_EVENT@1194_27@BUTTON_0"
msgstr "\"I accept your offer. Let us conquer the realm.\" [unit/]"

msgid "STORY_EVENT@1194_27@BUTTON_1"
msgstr "\"Currently, I cannot accommodate your arrival, but I will welcome your aid in the future.\""

msgid "STORY_EVENT@1194_27@BUTTON_2"
msgstr "\"Begone, scoundrel! I have no place for you.\""

msgid "STORY_EVENT@1194_27@TITLE"
msgstr "A Notorious Godir's Aid"

msgid "STORY_EVENT@1194_31@BODY_HEADER"
msgstr "One of your messengers approaches you. \"Benevolent {PlayerLeader.Title}, a message from {GLOBAL.MagehavenLoreConcept.Hyperlink} has arrived. {EventRuler.TitleName} contacts you.\""

msgid "STORY_EVENT@1194_31@BODY_LORE"
msgstr "You have heard poems and songs about virtuous {EventRuler.Name} in the past. \"Greetings, O {PlayerLeader.Title},\" <<p:EventRuler>> says. \"I am traveling the realms, helping out fellow {GLOBAL.GodirLoreConcept.Hyperlink} who are fighting for a noble cause. Seeing that you have a [hyperlink,GLOBAL.AlignmentConcept]good heart[/hyperlink] as well, I offer to join you and lend you my aid. \""

msgid "STORY_EVENT@1194_31@BUTTON_0"
msgstr "\"I accept. Let us bring peace and prosperity to this Realm together!\" [unit/]"

msgid "STORY_EVENT@1194_31@BUTTON_1"
msgstr "\"You are most welcome. I will enlist you as soon as fate permits.\""

msgid "STORY_EVENT@1194_31@BUTTON_2"
msgstr "\"I thank you for your offer, but I need to find my own way.\""

msgid "STORY_EVENT@1194_31@TITLE"
msgstr "A Virtuous Godir's Aid"

msgid "STORY_EVENT@1194_33@BODY_HEADER"
msgstr "The {GLOBAL.AstralFlowsLoreConcept.Hyperlink} are restless today. A powerful {GLOBAL.GodirLoreConcept.Hyperlink} contacts you through the arcane haze."

msgid "STORY_EVENT@1194_33@BODY_LORE"
msgstr "{EventRuler.TitleName} appears before you. \"I see you have learned the arcane arts, {PlayerLeader.TitleName}. The {GLOBAL.AstralSeaLoreConcept.Hyperlink} hums with your presence. Your studies of the [hyperlink,GLOBAL.AstralConcept]Astral[/hyperlink] are of interest to me. Allow me to walk amongst your {PlayerRace}, so I can learn from you and your people. In return, I offer my expertise.\""

msgid "STORY_EVENT@1194_33@BUTTON_0"
msgstr "\"Join me and together we can master the arcane.\" [unit/]"

msgid "STORY_EVENT@1194_33@BUTTON_1"
msgstr "\"I will prepare for your arrival and will invite you in the future.\""

msgid "STORY_EVENT@1194_33@BUTTON_2"
msgstr "\"No, I have other plans.\""

msgid "STORY_EVENT@1194_33@TITLE"
msgstr "An Astral Godir's Aid"

msgid "STORY_EVENT@1194_38@BODY_HEADER"
msgstr "A strange current in the {GLOBAL.AstralSeaLoreConcept.Hyperlink} catches your attention. An enticing feeling of anarchy and passion overcomes you, as a {GLOBAL.GodirLoreConcept.Hyperlink} contacts you."

msgid "STORY_EVENT@1194_38@BODY_LORE"
msgstr "In the vision of turbulent heat, {EventRuler.TitleName} appears. \"Your [hyperlink,GLOBAL.ChaosConcept]Chaos[/hyperlink] causes inconsistency in this perpetual universe. I like it. Anarchy and mayhem will lead us to true freedom! What say you, {PlayerLeader.TitleName}, if I join your forces and we shake the very foundations of this realm?\""

msgid "STORY_EVENT@1194_38@BUTTON_0"
msgstr "\"I always have room for powerful Godir.\" [unit/]"

msgid "STORY_EVENT@1194_38@BUTTON_1"
msgstr "\"I will prepare for your arrival and will welcome you later, my <<EventRuler{brother/sister}>> in chaos.\""

msgid "STORY_EVENT@1194_38@BUTTON_2"
msgstr "\"I do not need your help.\""

msgid "STORY_EVENT@1194_38@TITLE"
msgstr "A Chaos Godir's Aid"

msgid "STORY_EVENT@1194_39@BODY_HEADER"
msgstr "A handcrafted contraption with arcane engravings is delivered to you. After you accept it the contraption opens, revealing that none other than {EventRuler.TitleName} has an offer for you!"

msgid "STORY_EVENT@1194_39@BODY_LORE"
msgstr "{EventRuler.Title} {EventRuler.FirstName} appears. \"Your interest in [hyperlink,GLOBAL.MateriumConcept]Materium[/hyperlink] has caught my eye. The power of creation and transmutation runs through you, and the elements bend to your will. I ask only to join you in your quest to master all matter. Will you welcome me?\""

msgid "STORY_EVENT@1194_39@BUTTON_0"
msgstr "\"Join me and you will see all the wonders of this realm.\" [unit/]"

msgid "STORY_EVENT@1194_39@BUTTON_1"
msgstr "\"You can join me as soon as I have the capacity.\""

msgid "STORY_EVENT@1194_39@BUTTON_2"
msgstr "\"I do not need your help.\""

msgid "STORY_EVENT@1194_39@TITLE"
msgstr "A Materium Godir's Aid"

msgid "STORY_EVENT@1194_40@BODY_HEADER"
msgstr "In the rustling leaves and rushing water, you hear the voice of a {GLOBAL.GodirLoreConcept.Hyperlink}."

msgid "STORY_EVENT@1194_40@BODY_LORE"
msgstr "{EventRuler.TitleName} appears before you. \"The winds of spring whisper of another [hyperlink,GLOBAL.NatureConcept]friend of nature[/hyperlink]. It seems you embrace life and growth as much as I do. Let us join forces. Together we can bring prosperity to this realm!\""

msgid "STORY_EVENT@1194_40@BUTTON_0"
msgstr "\"I accept your offer. Join me on this realm!\" [unit/]"

msgid "STORY_EVENT@1194_40@BUTTON_1"
msgstr "\"Currently, I cannot accommodate your arrival, but I will welcome your aid in the future.\""

msgid "STORY_EVENT@1194_40@BUTTON_2"
msgstr "\"No, I have to follow my path alone.\""

msgid "STORY_EVENT@1194_40@TITLE"
msgstr "A Nature Godir's Aid"

msgid "STORY_EVENT@1194_41@BODY_HEADER"
msgstr "In a beam of celestial light, a formal message is delivered to you."

msgid "STORY_EVENT@1194_41@BODY_LORE"
msgstr "\"To the just {PlayerLeader.TitleName} of the {PlayerRace},[br/]I wish to express my approval of the [hyperlink,GLOBAL.OrderConcept]Path of Faith[/hyperlink] you have chosen. As {GLOBAL.GodirLoreConcept.Hyperlink}, we must stand strong against the lawless and the darkness. Therefore, I ask you to enlist me in your army, so I may walk among mortals once more and aid you in your quest.[br/]May faith and order guide you on your path.[br/][br/]- {EventRuler.TitleName}.\""

msgid "STORY_EVENT@1194_41@BUTTON_0"
msgstr "Enlist {EventRuler.Title} {EventRuler.FirstName} in your army. [unit/]"

msgid "STORY_EVENT@1194_41@BUTTON_1"
msgstr "Explain that you can not accommodate {EventRuler.FirstName} at the moment, but would like to in the future."

msgid "STORY_EVENT@1194_41@BUTTON_2"
msgstr "Decline <<o:EventRuler>> offer."

msgid "STORY_EVENT@1194_41@TITLE"
msgstr "An Order Godir's Aid"

msgid "STORY_EVENT@1194_42@BODY_HEADER"
msgstr "Shadows around you shimmer and shift, until a figure appears from the darkness. It is none other than {EventRuler.TitleName}!"

msgid "STORY_EVENT@1194_42@BODY_LORE"
msgstr "\"You, who gazes into the [hyperlink,GLOBAL.ShadowConcept]Shadow[/hyperlink] without fear, have caught the attention of those beyond oblivion. Death becomes thee, {PlayerLeader.TitleName}. Allow me to join you on your path to become Eternal."

msgid "STORY_EVENT@1194_42@BUTTON_0"
msgstr "\"Join me in shadows, {EventRuler.Title} {EventRuler.Name}!\" [unit/]"

msgid "STORY_EVENT@1194_42@BUTTON_1"
msgstr "\"Currently, I cannot accommodate your arrival, but I will welcome your aid in the future.\""

msgid "STORY_EVENT@1194_42@BUTTON_2"
msgstr "\"I walk this path of shadow alone.\""

msgid "STORY_EVENT@1194_42@TITLE"
msgstr "A Shadow Godir's Aid"

msgid "STORY_EVENT@1194_641@BODY_FOOTER"
msgstr "Your courtiers warn you, with all that's going on in the Empire of the {IntrigueVictimPlayerLeader.Title}, this may very well be a trap..."

msgid "STORY_EVENT@1194_641@BODY_HEADER"
msgstr "Your courtiers deliver a letter from the Empire of the {IntrigueVictimPlayerLeader.Title}, found hidden amongst regular merchandise.[br/]\"To the great {PlayerLeader.Title}...\""

msgid "STORY_EVENT@1194_641@BODY_LORE"
msgstr "\"I do not call upon the help of a {GLOBAL.GodirLoreConcept.Hyperlink} lightly, but it has become clear our {IntrigueVictimPlayerLeader.Title} has succumbed to forces beyond our own, in a plot that spans beyond our Empire. The {IntrigueVictimPlayerLeader.Title} has eyes and ears everywhere. If you are truly the savior we need, we shall meet at the {EventOverlay}. - A Concerned Citizen.\""

msgid "STORY_EVENT@1194_641@BUTTON_0"
msgstr "Send a party to meet the {IntrigueVictimUnit}."

msgid "STORY_EVENT@1194_641@BUTTON_1"
msgstr "Decline to mingle in the affairs of other Empires."

msgid "STORY_EVENT@1194_641@TITLE"
msgstr "Fiendish Takeover"

msgid "STORY_EVENT@1194_643@BODY_FOOTER"
msgstr "From the shadows around you, smoke gathers and more demons appear. Roaring laughter rumbles through the realm. An ambush!"

msgid "STORY_EVENT@1194_643@BODY_HEADER"
msgstr "You sent an entourage to meet the \"Concerned Citizen\", who contacted you about the {IntrigueVictimPlayerLeader.Title} of the {IntrigueVictimPlayerRace}."

msgid "STORY_EVENT@1194_643@BODY_LORE"
msgstr "Not long after arriving, a <<EventHero{man/woman}>> emerges, bowing deeply. \"Hail, great {PlayerLeader.Title}. I must be quick, for I fear I was followed. Our {IntrigueVictimPlayerLeader.Title} was captured and replaced by a {IntrigueVictimPlayerLeader.Title} from {GLOBAL.ObbadothLoreConcept.Hyperlink}. I know the {EventStructure} where the summoning took place, But more importantly, there is a contra-\" Before <<p:IntrigueUnit>> can finish <<o:IntrigueUnit>> sentence, <<p:IntrigueUnit>> is struck down by an infernal claw."

msgid "STORY_EVENT@1194_643@BUTTON_0"
msgstr "Stand strong!"

msgid "STORY_EVENT@1194_643@TITLE"
msgstr "Fiendish Takeover: Concerned Citizen"

msgid "STORY_EVENT@1194_667@BODY_FOOTER"
msgstr "\"So nosy...\" {IntrigueVictimPlayer.FirstName} says. \"There is no need to dig further. Surely, we can find a solution that is... satisfying, for both of us.\""

msgid "STORY_EVENT@1194_667@BODY_HEADER"
msgstr "You have succesfully sent a courtier into the court of {IntrigueVictimPlayer.TitleName}, who has started behaving erratically."

msgid "STORY_EVENT@1194_667@BODY_LORE"
msgstr "Not long after, your courtier contacts you, frantically. \"I have news, my {IntriguePlayer.Title}, but I must be quick. {IntrigueVictimPlayer.FirstName} is possessed by a demon from {GLOBAL.ObbadothLoreConcept.Hyperlink}. I have learned the location of a {EventStructure}, where the possession took place. There, you can destroy-\" Before <<p:IntrigueUnit>> can finish <<o:IntrigueUnit>> sentence, <<p:IntrigueUnit>> is struck down by an infernal claw."

msgid "STORY_EVENT@1194_667@BUTTON_0"
msgstr "\"I will send you back to Obbadoth, foul spawn!\""

msgid "STORY_EVENT@1194_667@BUTTON_1"
msgstr "\"An alliance with a demonic {IntrigueVictimPlayer.Title} would certainly be beneficial.\""

msgid "STORY_EVENT@1194_667@BUTTON_2"
msgstr "\"Share your infernal knowledge with me, fiend, and I will leave you be.\""

msgid "STORY_EVENT@1194_667@BUTTON_3"
msgstr "Cease all investigations into {IntrigueVictimPlayer}."

msgid "STORY_EVENT@1194_667@TITLE"
msgstr "A {IntrigueVictimPlayer.Title} Possessed"

msgid "STORY_EVENT@1194_668@BUTTON_0"
msgstr "Continue"

msgid "STORY_EVENT@1194_668@TITLE"
msgstr "Quest 2A finished"

msgid "STORY_EVENT@1194_669@BODY_FOOTER"
msgstr "\"I would suggest vassalizing the city of {EventHouse}. Once they are under your rule, you can enforce your interrogation.\""

msgid "STORY_EVENT@1194_669@BODY_HEADER"
msgstr "You have succesfully sent a courtier into the court of {IntrigueVictimPlayer.TitleName}, who has started behaving erratically."

msgid "STORY_EVENT@1194_669@BODY_LORE"
msgstr "Not long after, your courtier contacts you with news. \"I spoke with several chambermaids and court wizards, my {IntriguePlayer.Title}. They whisper about a curse, cast upon {IntrigueVictimPlayer.Title} {IntrigueVictimPlayer.FirstName}. It would certainly explain the sudden change of character... Every time I inquire, one name comes up: {EventHouseLord.Name}. I expect <<p:EventHouseLord>> knows more.\""

msgid "STORY_EVENT@1194_669@BUTTON_0"
msgstr "Investigate further, aim to vassalize {EventHouse}."

msgid "STORY_EVENT@1194_669@BUTTON_1"
msgstr "Stop investigating, use your current knowledge as leverage against {IntrigueVictimPlayer}."

msgid "STORY_EVENT@1194_669@TITLE"
msgstr "A {IntrigueVictimPlayer.Title} Possessed"

msgid "STORY_EVENT@1194_670@BUTTON_0"
msgstr "Continue"

msgid "STORY_EVENT@1194_670@TITLE"
msgstr "Quest 2B finished"

msgid "STORY_EVENT@1194_672@BODY_FOOTER"
msgstr "\"I understand you are the one who cleansed the infernal taint on my soul, {PlayerLeader.Name}. I am in your debt.\""

msgid "STORY_EVENT@1194_672@BODY_HEADER"
msgstr "You have destroyed the site where {IntrigueVictimPlayer.TitleName} became possessed. A roar rumbles through the realm as the demon is exorcized."

msgid "STORY_EVENT@1194_672@BODY_LORE"
msgstr "Not long after, you are contacted by {IntrigueVictimPlayer.FirstName} who has returned to <<o:IntrigueVictimPlayer>> former state. <<Cp:IntrigueVictimPlayer>> explains what happened: \"I was personally investigating a ritual site. It seemed barely a threat and thus, I became careless. The demon had laid in waiting, hiding, preying... until it overtook me. I thought myself invincible, and possession was the punishment for my carelessness.\""

msgid "STORY_EVENT@1194_672@BUTTON_0"
msgstr "\"Let us be allies, then, and claim this realm together!\""

msgid "STORY_EVENT@1194_672@BUTTON_1"
msgstr "\"I take my reward in gold [gold/] and mana [mana/].\""

msgid "STORY_EVENT@1194_672@BUTTON_2"
msgstr "\"Your carelessness cost you your claim on this realm. Become my vassal instead.\""

msgid "STORY_EVENT@1194_672@TITLE"
msgstr "A {IntrigueVictimPlayer.Title} Possessed: Aftermath"

msgid "STORY_EVENT@1194_673@BODY_FOOTER"
msgstr "\"Through your actions you have broken my pact, and I am left without the rewards I was promised.\""

msgid "STORY_EVENT@1194_673@BODY_HEADER"
msgstr "You have destroyed the site where {IntrigueVictimPlayer.TitleName} became possessed. A roar rumbles through the realm as the demon is exorcized."

msgid "STORY_EVENT@1194_673@BODY_LORE"
msgstr "Not long after, you are contacted by {IntrigueVictimPlayer.FirstName} who has returned to <<o:IntrigueVictimPlayer>> former state. \"What have you done?\" <<p:IntrigueVictimPlayer>> demands. \"I had everything under control! The deal I struck was perfect. I would slumber in my own body, and when I would awaken again in a year and a day, I would rebuild on the ashes of this realm, my soul untainted by any necessary atrocities.\""

msgid "STORY_EVENT@1194_673@BUTTON_0"
msgstr "\"Pay [gold/] me, or the entire realm will know what you did.\""

msgid "STORY_EVENT@1194_673@TITLE"
msgstr "A {IntrigueVictimPlayer.Title} Possessed: Aftermath"

msgid "STORY_EVENT@1194_674@BODY_FOOTER"
msgstr "\"I know how to break this curse, and have proof of the plans of {IntrigueCulpritPlayer.FirstName}. Please, as my overlord, protect me from <<o:IntrigueCulpritPlayer>> wrath!\""

msgid "STORY_EVENT@1194_674@BODY_HEADER"
msgstr "You have vassalized the {EventHouseLord.Title} of {EventHouse}, whom you suspect knows more about the cursed {IntrigueVictimPlayer.TitleName}. You summon {EventHouseLord.FirstName} to interrogate <<P:EventHouseLord>>."

msgid "STORY_EVENT@1194_674@BODY_LORE"
msgstr "As soon as the interrogation starts, {EventHouseLord.FirstName} breaks down. \"Please, o {PlayerLeader.Title}, my hand was forced. The {IntrigueCulpritPlayer.Title} threatened me with ruination if I did not join <<P:IntrigueCulpritPlayer>> in cursing the {IntrigueVictimPlayer.FirstName}. I was tasked with summoning a demon from {GLOBAL.ObbadothLoreConcept.Hyperlink}, whilst {IntrigueCulpritPlayer.Title} {IntrigueCulpritPlayer.FirstName} bound it to {IntrigueVictimPlayer.FirstName}. I will tell you all I know!\""

msgid "STORY_EVENT@1194_674@BUTTON_0"
msgstr "Break the curse on {IntrigueVictimPlayer}, let all know who was responsible."

msgid "STORY_EVENT@1194_674@TITLE"
msgstr "A {IntrigueVictimPlayer.Title} Possessed: Aftermath"

msgid "STORY_EVENT@1194_675@BODY_FOOTER"
msgstr "\"It was the cursed {EventItem} that possessed {IntrigueVictimPlayer}. It will take the power of a {GLOBAL.GodirLoreConcept.Hyperlink} to free <<P:IntrigueVictimPlayer>>.\""

msgid "STORY_EVENT@1194_675@BODY_HEADER"
msgstr "You have vassalized the {EventHouseLord.Title} of {EventHouse}, whom you suspect knows more about the cursed {IntrigueVictimPlayer.TitleName}. You summon {EventHouseLord.FirstName} to interrogate <<P:EventHouseLord>>."

msgid "STORY_EVENT@1194_675@BODY_LORE"
msgstr "\"I have seen {IntrigueVictimPlayer.FirstName} carrying something I recognized it as the {EventItem}, which is said to carry a curse of {GLOBAL.ObbadothLoreConcept.Hyperlink}. I tried to warn <<P:IntrigueVictimPlayer>>, but to no avail. I have seen <<o:IntrigueVictimPlayer>> transformation, and I have searched for a way to break the curse... Yet I knew not who to trust with the answer.\""

msgid "STORY_EVENT@1194_675@BUTTON_0"
msgstr "Take the cursed {EventItem} for yourself, maintain the curse on {IntrigueVictimPlayer}."

msgid "STORY_EVENT@1194_675@TITLE"
msgstr "A {IntrigueVictimPlayer.Title} Possessed: Aftermath"

msgid "STORY_EVENT@1224_790@BODY_FOOTER"
msgstr "The eyes of {EventHero} suddenly fall upon your troops. \"And yet... Perhaps the winds have blessed me with your aid.\""

msgid "STORY_EVENT@1224_790@BODY_HEADER"
msgstr "Your troops are making their way through the depths {EventDirection} {EventCity}. They are surrounded by tall, massive walls once carved by ancient hands, now fissured with unsettling vibrant cracks."

msgid "STORY_EVENT@1224_790@BODY_LORE"
msgstr "\"What you see is our doom,\" a voice calls out. The figure sits upon a cluster of stones, gazing at the fissures. \"My name is {EventHero}, sole survivor of the {TribeName} tribe. My people bore a duty passed down through generations, to renew the seals so that [hyperlink,GLOBAL.AstralBarrensConcept]the taint of the vile Unmakers[/hyperlink] would not consume the realm. But now, the design of those seals has been lost, and I am fated to die seeking the source of this contamination, in the hope of eradicating it.\""

msgid "STORY_EVENT@1224_790@BUTTON_0"
msgstr "Continue to the fractured region."

msgid "STORY_EVENT@1224_790@BUTTON_4"
msgstr "Produce [structureprod/] the tools to excavate the area."

msgid "STORY_EVENT@1224_790@BUTTON_5"
msgstr "Bring archaeologists [gold/] to help you research [knowledge/] the ruins you will find."

msgid "STORY_EVENT@1224_790@TITLE"
msgstr "Finding the Core of Contamination"

msgid "STORY_EVENT@1224_83@BODY_FOOTER"
msgstr "Will you slay the {EventStackLeader.Name} and <<o:EventHero>> infant offspring, or find a different solution?"

msgid "STORY_EVENT@1224_83@BODY_HEADER"
msgstr "Your troops engage the {EventStackLeader.Name} and <<o:EventStackLeader>> minions, but they seem to be withdrawing in defensive formations instead of attacking."

msgid "STORY_EVENT@1224_83@BODY_LORE"
msgstr "Their panicked grunts and hisses sound like pleas for mercy. When you take a closer look, you realize that they are defending their newborn offspring. They can feel that they are no match for you, but they will fight for their infants till their last breath."

msgid "STORY_EVENT@1224_83@BUTTON_0"
msgstr "Attack! [evilact/]"

msgid "STORY_EVENT@1224_83@BUTTON_1"
msgstr "Let them gather their younglings and leave. [goodact/]"

msgid "STORY_EVENT@1224_83@BUTTON_3"
msgstr "Lure [food/] some of the creatures away and recruit the {EventStackLeader.Name}. [unit/]"

msgid "STORY_EVENT@1224_83@TITLE"
msgstr "Defenseless Progeny"

msgid "STORY_EVENT@1224_84@BODY_FOOTER"
msgstr "{EventHero.FirstName} has doubts about <<o:EventHero>> current ambition. Will <<o:EventHero>> heritage provide <<P:EventHero>> a new purpose?"

msgid "STORY_EVENT@1224_84@BODY_HEADER"
msgstr "Holding <<o:EventHero>> family heirloom, your {GLOBAL.HeroConcept.Hyperlink}, {EventHero}, approaches you with a formal greeting and proclaims:"

msgid "STORY_EVENT@1224_84@BODY_LORE"
msgstr "\"I am the heir of a proud bloodline. One of my ancestors was a <<a:ReplacementDestiny1>>, another one a <<a:ReplacementDestiny2>>—their {GLOBAL.RenownConcept.Hyperlink} echoed through time. I grew up defying those values, so I became a <<a:CurrentDestiny>>. But now I'm older, and embracing tradition feels like a way to honor my ancestors. To remember who they were. I seek for your advice in this matter, my {PlayerLeader.Title}.\""

msgid "STORY_EVENT@1224_84@BUTTON_0"
msgstr "\"Continue your path, you are your own legacy.\""

msgid "STORY_EVENT@1224_84@BUTTON_1"
msgstr "\"Your linage will be the one of a <<a:ReplacementDestiny1>>.\""

msgid "STORY_EVENT@1224_84@BUTTON_2"
msgstr "\"Your descendants will remember you as a <<a:ReplacementDestiny2>>.\""

msgid "STORY_EVENT@1224_84@TITLE"
msgstr "A Question of Heritage"

msgid "STORY_EVENT@1224_85@BODY_FOOTER"
msgstr "{EventHero.FirstName} has grown frustrated with <<o:EventHero>> current ambition. Will you mend what envy has broken?"

msgid "STORY_EVENT@1224_85@BODY_HEADER"
msgstr "Your {GLOBAL.HeroConcept.Hyperlink}, {EventHero}, asks you for an audience. Gazing to the floor <<p:EventHero>> pronounces:"

msgid "STORY_EVENT@1224_85@BODY_LORE"
msgstr "\"I see how others achieve their ambitions while I lay waiting for my chance to prove myself as a <<a:CurrentDestiny>>. I seek {GLOBAL.RenownConcept.Hyperlink} like any other. Do I not deserve it, my {PlayerLeader.Title}? Am I unworthy of glory? I plead for your guidance once again.\""

msgid "STORY_EVENT@1224_85@BUTTON_0"
msgstr "\"Be proud of who you are and you shall achieve glory.\""

msgid "STORY_EVENT@1224_85@BUTTON_1"
msgstr "\"Being a <<a:ReplacementDestiny1>> will give you the credit you seek.\""

msgid "STORY_EVENT@1224_85@BUTTON_2"
msgstr "\"You will find your value as a <<a:ReplacementDestiny2>>.\""

msgid "STORY_EVENT@1224_85@TITLE"
msgstr "Envy’s Thorn"

msgid "STORY_EVENT@1224_87@BODY_FOOTER"
msgstr "What will you do with the exotic {EventStackLeader.Name}?"

msgid "STORY_EVENT@1224_87@BODY_HEADER"
msgstr "Your troops engage the {EventStackLeader.Name} and <<o:EventStackLeader>> minions, but they cower in fear rather than put up a fight."

msgid "STORY_EVENT@1224_87@BODY_LORE"
msgstr "They tremble helplessly, cornered by your army. But before you can give the order to attack, you are addressed by your scholars who yell out excitedly: \"Wait, my {PlayerLeader.Title}! Look at the rare coloration of the tongue, and the pattern on their backs! These are specimens worthy of investigation! Allow us to lead them away so we can study them in their natural environment\""

msgid "STORY_EVENT@1224_87@BUTTON_0"
msgstr "Attack! [evilact/]"

msgid "STORY_EVENT@1224_87@BUTTON_1"
msgstr "Let them go. [goodact/]"

msgid "STORY_EVENT@1224_87@BUTTON_3"
msgstr "Allow your scholars [knowledge/] to document them. [influence/]"

msgid "STORY_EVENT@1224_87@TITLE"
msgstr "Exotic Animals"

msgid "STORY_EVENT@1224_88@BODY_FOOTER"
msgstr "{EventHero.FirstName} has grown frustrated with <<o:EventHero>> current ambition. Will you indulge <<o:EventHero>> desires?"

msgid "STORY_EVENT@1224_88@BODY_HEADER"
msgstr "Your {GLOBAL.HeroConcept.Hyperlink}, {EventHero}, stands tall before you. <<Cp:EventHero>> puffs out <<o:EventHero>> chest and tilts <<o:EventHero>> chin upward as <<p:EventHero>> declares:"

msgid "STORY_EVENT@1224_88@BODY_LORE"
msgstr "\"By omission or prejudice, I find myself being far less than what I could be. Be honest with me, my {PlayerLeader.Title}. Does my ambition as a <<a:CurrentDestiny>> not interest you? I was born to be great, so direct me towards {GLOBAL.RenownConcept.Hyperlink}. What path shall I follow?\""

msgid "STORY_EVENT@1224_88@BUTTON_0"
msgstr "\"Know your place {EventHero} and stay your course.\""

msgid "STORY_EVENT@1224_88@BUTTON_1"
msgstr "\"Actions speak louder than words, prove yourself as a <<a:ReplacementDestiny1>>.\""

msgid "STORY_EVENT@1224_88@BUTTON_2"
msgstr "\"Ambitious, you will fit as <<a:ReplacementDestiny2>>.\""

msgid "STORY_EVENT@1224_88@TITLE"
msgstr "Consumed by Arrogance"

msgid "STORY_EVENT@1224_89@BODY_FOOTER"
msgstr "{EventHero.FirstName} has doubts about <<o:EventHero>> current ambition. Will you allow <<P:EventHero>> to pursue <<o:EventHero>> dreams?"

msgid "STORY_EVENT@1224_89@BODY_HEADER"
msgstr "In the early hours of the morning, you find your {GLOBAL.HeroConcept.Hyperlink} {EventHero}, waiting outside your quarters."

msgid "STORY_EVENT@1224_89@BODY_LORE"
msgstr "\"O {PlayerLeader.Title}, I had a vision in my dreams last night! There was a <<a:ReplacementDestiny1>>, revered by the masses. Next to <<P:EventHero>> there was a <<a:ReplacementDestiny2>>, surrounded and appreciated by the ones <<p:EventHero>> loved. This seems to be a sign to change my destiny as a <<a:CurrentDestiny>>. What {GLOBAL.RenownConcept.Hyperlink} shall I seek?\""

msgid "STORY_EVENT@1224_89@BUTTON_0"
msgstr "\"Dreams are for those who slumber, you are awake now.\""

msgid "STORY_EVENT@1224_89@BUTTON_1"
msgstr "\"Being a <<a:ReplacementDestiny1>> suits you better.\""

msgid "STORY_EVENT@1224_89@BUTTON_2"
msgstr "\"Being a <<a:ReplacementDestiny2>> is an admirable ambition.\""

msgid "STORY_EVENT@1224_89@TITLE"
msgstr "Ambitious Dreams"

msgid "STORY_EVENT@1224_90@BODY_FOOTER"
msgstr "{EventHero.FirstName} has doubts about <<o:EventHero>> current ambition. Will you allow <<P:EventHero>> to follow your path?"

msgid "STORY_EVENT@1224_90@BODY_HEADER"
msgstr "Your {GLOBAL.HeroConcept.Hyperlink}, {EventHero}, makes a reverence before approaching. With <<o:EventHero>> fist on <<o:EventHero>> chest, <<p:EventHero>> says:"

msgid "STORY_EVENT@1224_90@BODY_LORE"
msgstr "My {PlayerLeader.Title}, I see you follow your ambition as a {PlayerLeader.Destiny}. I am merely a <<a:CurrentDestiny>>, who would feel praised with the chance of following your dreams. Would you allow me to share your ambitions for the greatness and {GLOBAL.RenownConcept.Hyperlink} of the empire?"

msgid "STORY_EVENT@1224_90@BUTTON_0"
msgstr "\"Stay your course. Your destiny shall be fulfilled.\""

msgid "STORY_EVENT@1224_90@BUTTON_1"
msgstr "\"Join me as a <<a:ReplacementDestiny1>>.\""

msgid "STORY_EVENT@1224_90@BUTTON_2"
msgstr "\"Being a <<a:ReplacementDestiny2>> is an admirable ambition.\""

msgid "STORY_EVENT@1224_90@TITLE"
msgstr "A Rule Model"

msgid "STORY_EVENT@1229_17@BODY_FOOTER"
msgstr "Flocks of <<m:EventUnit>> are swarming the castle, chasing the common folk and causing havoc. What shall you do?"

msgid "STORY_EVENT@1229_17@BODY_HEADER"
msgstr "Your apprentice, {EventHero.Name}, rushes into your chambers in a panic, it’s clear that something has gone wrong..."

msgid "STORY_EVENT@1229_17@BODY_LORE"
msgstr "While working through your collection of grimoires and tomes, {EventHero.Name} stumbled across an incantation scribbled on an ancient parchment, forgotten in the pages of a treatise on animal summoning. Curiosity overcame <<o:EventHero>> and <<p:EventHero>> spoke the words aloud—accidentally opening a rift to a realm that teems with feral pigs!"

msgid "STORY_EVENT@1229_17@BUTTON_0"
msgstr "\"Perhaps they can be of some use, [unit/] I shall prepare a counter-spell.\" [mana/]"

msgid "STORY_EVENT@1229_17@BUTTON_1"
msgstr "\"This is part of the learning process. [happiness/] You’ll figure it out somehow.\" [xp/]"

msgid "STORY_EVENT@1229_17@BUTTON_2"
msgstr "\"Rally the troops. [unitprod/] There’s good eating on those, don’t let them escape!\" [food/]"

msgid "STORY_EVENT@1229_17@BUTTON_3"
msgstr "\"Pigs are our friends, I’ll deal with this!\" [unit/]"

msgid "STORY_EVENT@1229_17@TITLE"
msgstr "A Simple Mistake"

msgid "STORY_EVENT@1229_18@BODY_FOOTER"
msgstr "\"Now pay your fine or it's off to jail.\""

msgid "STORY_EVENT@1229_18@BODY_HEADER"
msgstr "\"Stop right there, criminal scum!\""

msgid "STORY_EVENT@1229_18@BODY_LORE"
msgstr "\"Nobody breaks the law on my watch! I'm confiscating your stolen goods.\""

msgid "STORY_EVENT@1229_18@BUTTON_0"
msgstr "P"

msgid "STORY_EVENT@1229_18@BUTTON_1"
msgstr "Resist Arrest"

msgid "STORY_EVENT@1229_18@BUTTON_2"
msgstr "Pay Gold [gold/]"

msgid "STORY_EVENT@1229_18@TITLE"
msgstr "Follow-Up Materium Event TEST"

msgid "STORY_EVENT@1229_21@BUTTON_1"
msgstr "Find the mind yourself"

msgid "STORY_EVENT@1229_21@TITLE"
msgstr "Astral Sub-Quest"

msgid "STORY_EVENT@991_4465@BODY_FOOTER"
msgstr "{EventHouse.Name} petitions a memorial for the dead {EventHero.Name}."

msgid "STORY_EVENT@991_4465@BODY_HEADER"
msgstr "An architect of {EventHouse.Name} relays a plea to you regarding the deceased hero {EventHero.Name}, resting in your {GLOBAL.CryptConcept}."

msgid "STORY_EVENT@991_4465@BODY_LORE"
msgstr "\"{EventHero.Name} was a legend. <<Cp:EventHero>> represented the best of House {EventHouse.Name}. The tales of <<o:EventHero>> deeds live on in the hearts of <<o:EventHero>> people. Letting our {EventHero.FirstName} rot inside a common grave would be ignoble. <<Cp:EventHero>> deserves a mausoleum, an inspiring monument for future generations to come.\""

msgid "STORY_EVENT@991_4465@BUTTON_0"
msgstr "\"This [gold/] should suffice to do justice to <<G:honor^n,EventHero>>.\""

msgid "STORY_EVENT@991_4465@BUTTON_1"
msgstr "\"My coin is better spent on the living!\""

msgid "STORY_EVENT@991_4465@BUTTON_2"
msgstr "Call on your deathly powers to design a mausoleum befitting {EventHero.Name}."

msgid "STORY_EVENT@991_4465@TITLE"
msgstr "Beloved Beyond Death"

msgid "STORY_EVENT@991_4466@BODY_FOOTER"
msgstr "The corpse of {EventHero.Name} is requested by <<o:EventHero>> people."

msgid "STORY_EVENT@991_4466@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of {EventHouse.Name} appeals to your honor regarding <<o:EventHouseLord>> deceased hero {EventHero.Name}, resting in your {GLOBAL.CryptConcept}."

msgid "STORY_EVENT@991_4466@BODY_LORE"
msgstr "\"The feud between {EventHouse.Name} and your empire has been relentless. We grieve for the fallen {EventHero.Name}... and would regard it as a sign of benevolence if you honored <<o:EventHero>> death and returned <<o:EventHero>> remains to us.\""

msgid "STORY_EVENT@991_4466@BUTTON_0"
msgstr "Deliver the dead body of {EventHero.Name} to {EventHouse.Name}."

msgid "STORY_EVENT@991_4466@BUTTON_1"
msgstr "\"{EventHero.Name} will remain in my crypt for as long as I please.\""

msgid "STORY_EVENT@991_4466@BUTTON_2"
msgstr "\"No [evilact/]. {EventHero.Name} will be my reminder of your impertinence.\""

msgid "STORY_EVENT@991_4466@TITLE"
msgstr "Post Mortem"

msgid "STORY_EVENT@991_4469@BODY_FOOTER"
msgstr "Should {EventHero.Name} interfere before the {EnemyUnit.Name} and <<o:EnemyUnit>> comrades have agreed how to best cook their captives?"

msgid "STORY_EVENT@991_4469@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Will you interfere before the {EnemyUnit.Name} and <<o:EnemyUnit>> comrades have agreed how to best cook their captives?"

msgid "STORY_EVENT@991_4469@BODY_HEADER"
msgstr "Scouting the castle, {EventHero.Name} witnesses a rather morbid argument."

msgid "STORY_EVENT@991_4469@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Scouting the castle, you witness a rather morbid argument."

msgid "STORY_EVENT@991_4469@BODY_LORE"
msgstr "\"We steam them with mushrooms!\" {EventHero.FirstName} hears the deep voice of a {EnemyUnit.Name} say. \"More creamy that way!\"[br/][br/]\"No!\" another voice that sounds the same disagrees. \"We cook little {EventRace.Name} in butter!\"[br/][br/]\"You idiot!\" yet another of them yells. \"We roast them with vinegar!\"[br/][br/]None of them listen to the protests of their \"ingredients,\" a group of {EventRace.Name} cowering in a corner."

msgid "STORY_EVENT@991_4469@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "\"We steam them with mushrooms!\" you hear the deep voice of a {EnemyUnit.Name} say. \"More creamy that way!\"[br/][br/]\"No!\" another voice that sounds the same disagrees. \"We cook little {EventRace.Name} in butter!\"[br/][br/]\"You idiot!\" yet another of them yells. \"We roast them with vinegar!\"[br/][br/]None of them listen to the protests of their \"ingredients,\" a group of {EventRace.Name} cowering in a corner."

msgid "STORY_EVENT@991_4469@BUTTON_0"
msgstr "\"To the rescue! Attack!\""

msgid "STORY_EVENT@991_4469@BUTTON_1"
msgstr "Appease the {EnemyUnit.Name} and <<o:EnemyUnit>> comrades with cattle [food/] from {EventCity.Name}."

msgid "STORY_EVENT@991_4469@BUTTON_2"
msgstr "Leave."

msgid "STORY_EVENT@991_4469@BUTTON_3"
msgstr "Fan the flames of their argument until they turn on each other..."

msgid "STORY_EVENT@991_4469@TITLE"
msgstr "Salt and Vinegar"

msgid "STORY_EVENT@991_4470@BODY_FOOTER"
msgstr "The {EventUnit.Name} bows <<o:EventUnit>> head. \"Everyone in this company owes you their lives - how can we repay you?\""

msgid "STORY_EVENT@991_4470@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "\"We are indebted to you, {PlayerLeader.TitleName}. Everyone in this company owes you their lives - how can we repay you?\""

msgid "STORY_EVENT@991_4470@BODY_HEADER"
msgstr "With the hungry brutes no longer a threat, {EventHero.Name} can rescue their traumatized victims."

msgid "STORY_EVENT@991_4470@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "With the hungry brutes no longer a threat, you can rescue their traumatized victims."

msgid "STORY_EVENT@991_4470@BODY_LORE"
msgstr "\"It was all my fault!\" their leader, a {EventUnit.Name}, explains. \"These merchants trusted us to protect them, but, two days ago, those monstrous cannibals overwhelmed us at nightfall.\""

msgid "STORY_EVENT@991_4470@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "\"It was all my fault, {PlayerLeader.Title}!\" their leader, a {EventUnit.Name}, explains. \"These merchants trusted us to protect them, but, two days ago, those monstrous cannibals overwhelmed us at nightfall.\""

msgid "STORY_EVENT@991_4470@BUTTON_0"
msgstr "\"Market your goods [structureprod/] at {EventCity.Name} and we will all reap the benefits of this adventure.\""

msgid "STORY_EVENT@991_4470@BUTTON_1"
msgstr "\"Your craft chest [gold/] is what we are interested in...\""

msgid "STORY_EVENT@991_4470@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "\"Your craft chest [gold/] is what I am interested in...\""

msgid "STORY_EVENT@991_4470@BUTTON_2"
msgstr "\"Serve my army, {EventUnit.Name} [unit/], and you can redeem yourself in combat.\""

msgid "STORY_EVENT@991_4470@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "\"Join my army, {EventUnit.Name}, and you can redeem yourself in combat.\""

msgid "STORY_EVENT@991_4470@TITLE"
msgstr "Salt and Vinegar: Aftermath"

msgid "STORY_EVENT@991_4471@BODY_FOOTER"
msgstr "The grave robbers' greed has awakened the dead! And {EventHero.FirstName} finds <<r:EventHero>> in the middle of it..."

msgid "STORY_EVENT@991_4471@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "The grave robbers' greed has awakened the dead! And you find yourself in the middle of it..."

msgid "STORY_EVENT@991_4471@BODY_HEADER"
msgstr "As {EventHero.Name} nears the gate of the {EventStructure}, the noise of busy pickaxes echoes from its walls."

msgid "STORY_EVENT@991_4471@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "As you near the gate of the {EventStructure}, the noise of busy pickaxes echoes from its walls."

msgid "STORY_EVENT@991_4471@BODY_LORE"
msgstr "A band of grave robbers can be spotted working inside. But before {EventHero.FirstName} can act, one of the grave robbers yells in horror when a skeletal hand grabs his arm. The grave robbers flee, leaving {EventHero.FirstName} and <<o:EventHero>> army to deal with the {EnemyUnit} and other horrors that emerge from the coffins around them."

msgid "STORY_EVENT@991_4471@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "A band of grave robbers can be spotted working inside. But before you can act, one of the grave robbers yells in horror when a skeletal hand grabs his arm. The grave robbers flee, leaving you and your army to deal with the {EnemyUnit} and other horrors that emerge from the coffins around them."

msgid "STORY_EVENT@991_4471@BUTTON_0"
msgstr "Attack the undead!"

msgid "STORY_EVENT@991_4471@BUTTON_1"
msgstr "Cast a spell [mana/] to delay the undead."

msgid "STORY_EVENT@991_4471@BUTTON_2"
msgstr "Flee the {EventStructure}."

msgid "STORY_EVENT@991_4471@BUTTON_4"
msgstr "Call upon powerful death magics to delay the undead assault."

msgid "STORY_EVENT@991_4471@TITLE"
msgstr "Raiders of the {EventItem.Name}"

msgid "STORY_EVENT@991_4472@BODY_FOOTER"
msgstr "One of <<g:soldiers^p,EventHero>> points to a few decorated coffins, elevated above the others. Their contents ought to be special..."

msgid "STORY_EVENT@991_4472@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "One of your soldiers points to a few decorated coffins, elevated above the others. Their contents ought to be special..."

msgid "STORY_EVENT@991_4472@BODY_HEADER"
msgstr "{EventHero.Name} has survived the undead onslaught in the {EventStructure}. Now, the tomb is safe to be searched."

msgid "STORY_EVENT@991_4472@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "You have survived the undead onslaught in the {EventStructure}. Now, the tomb is safe to be searched."

msgid "STORY_EVENT@991_4472@BODY_LORE"
msgstr "With the grave robbers long gone, your army wastes no time and immediately starts to gather any knowledge they can find about the people who were buried here. This tomb belonged to a fallen king, who was buried with his entire court after his assassination."

msgid "STORY_EVENT@991_4472@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "With the grave robbers long gone, your army wastes no time and immediately starts to gather any knowledge they can find about the people who were buried here. This tomb belonged to a fallen king, who was buried with his entire court after his assassination."

msgid "STORY_EVENT@991_4472@BUTTON_0"
msgstr "Loot the coffin of the king's marshal. [unitprod/]"

msgid "STORY_EVENT@991_4472@BUTTON_2"
msgstr "Loot the coffin of the king's steward. [gold/]"

msgid "STORY_EVENT@991_4472@BUTTON_4"
msgstr "Loot the coffin of the poisoned king himself. [item/]"

msgid "STORY_EVENT@991_4472@BUTTON_5"
msgstr "I am no grave robber. [goodact/]"

msgid "STORY_EVENT@991_4472@TITLE"
msgstr "Raiders of the {EventItem.Name}: Aftermath"

msgid "STORY_EVENT@991_4484@BODY_FOOTER"
msgstr "Will you interfere before the {EventStackLeader.Name} and its army burns the entire forest?"

msgid "STORY_EVENT@991_4484@BODY_HEADER"
msgstr "As your mind wanders the wilds, your meditations are disrupted by a sudden scene of destruction."

msgid "STORY_EVENT@991_4484@BODY_LORE"
msgstr "You see the fiery creations of a Pyromancer desolating the forest {EventDirection} {EventCity}. The very earth seems to weep as they set the area ablaze, threatening all that grows and blooms."

msgid "STORY_EVENT@991_4484@BUTTON_0"
msgstr "Swear to destroy the fire creatures threatening the forest."

msgid "STORY_EVENT@991_4484@BUTTON_1"
msgstr "These forests are not your concern."

msgid "STORY_EVENT@991_4484@BUTTON_2"
msgstr "\"The fire warms my soul. I... shall kindle [mana/] its flames!\" [naturecrisis/]"

msgid "STORY_EVENT@991_4484@TITLE"
msgstr "Reckless Incinerators"

msgid "STORY_EVENT@991_4485@BODY_FOOTER"
msgstr "Which gift do you wish the {EventUnit.Name} to bestow upon you?"

msgid "STORY_EVENT@991_4485@BODY_HEADER"
msgstr "With the fire creatures stopped, the warden of the forest reveals itself to you."

msgid "STORY_EVENT@991_4485@BODY_LORE"
msgstr "It is a {EventUnit.Name}, just as pristine and majestic as it is described in the many stories of old. The fair creature approaches you with a benevolent glimmer in its eyes. It is clear that it wants to thank you."

msgid "STORY_EVENT@991_4485@BUTTON_0"
msgstr "Ask the {EventUnit.Name} [unit/] to follow you."

msgid "STORY_EVENT@991_4485@BUTTON_1"
msgstr "You sense a deep connection. From now on you will ride the {EventMount.Name} [mount/] into battle!"

msgid "STORY_EVENT@991_4485@BUTTON_3"
msgstr "Ask the {EventUnit.Name} to share some of its magic essence [mana/] with you."

msgid "STORY_EVENT@991_4485@TITLE"
msgstr "Reckless Incinerators: Aftermath"

msgid "STORY_EVENT@991_4561@BODY_FOOTER"
msgstr "\"How melodramatic,\" {AllyPlayer} remarks sarcastically. \"But also presumptuous. You don't know what will happen when we open the World Vault. What it will mean for the Pantheon. Either way, you will be our guest of honor to watch...\""

msgid "STORY_EVENT@991_4561@BODY_HEADER"
msgstr "The Prince of Shadows has been raging against the {GLOBAL.ShadraiFactionLoreConcept.Hyperlink} on the field of battle. But now, as <<p:EventPlayer>> sees <<o:EventPlayer>> armies vanquished, {EventPlayer.FirstName} keeps a sarcastic calm."

msgid "STORY_EVENT@991_4561@BODY_LORE"
msgstr "\"This may be my hour to perish, but I have gone through death, shadow and nightmares for too many times to be pained by this. You, on the other hand,\"—{EventPlayer.FirstName} briefly glances at the other Shad'rai—\"you have clung to your \"immortal\" lives for ages over and over, ready to pay any price. And now your demise will arrive by your own hands. A pity it will cost the cosmos.\""

msgid "STORY_EVENT@991_4561@BUTTON_0"
msgstr "Imprison {EventPlayer.FirstName} for future interrogation."

msgid "STORY_EVENT@991_4561@TITLE"
msgstr "The Fall of {EventPlayer}"

msgid "STORY_EVENT@991_4562@BODY_FOOTER"
msgstr "Moved by this scene of sorrow, {AllyPlayer} signals <<o:AllyPlayer>> allies to leave {EventPlayer.FirstName} be. One needs no prison for a man ensnared in a maze of mourning."

msgid "STORY_EVENT@991_4562@BODY_HEADER"
msgstr "Rock was crushed, entire mountains crumbled until {EventPlayer} succumbed to the might of the {GLOBAL.ShadraiFactionLoreConcept.Hyperlink}."

msgid "STORY_EVENT@991_4562@BODY_LORE"
msgstr "Silently {EventPlayer.FirstName} stands, a stalwart statue of grief, lamenting the fate of the {EventRace} and loss of their monuments on {GLOBAL.GrexolisLoreConcept.Hyperlink}. For even on a fractured world without future, {EventPlayer.FirstName} sought to shape stone and earth into new homes."

msgid "STORY_EVENT@991_4562@BUTTON_0"
msgstr "In time, we shall return to make <<P:EventPlayer>> our rightful prisoner."

msgid "STORY_EVENT@991_4562@TITLE"
msgstr "The Fall of {EventPlayer}"

msgid "STORY_EVENT@991_4844@BODY_FOOTER"
msgstr "\"The ease of magic has become omnipresent in our lives. Now we wish to inscribe our humble applications into a tome for all {EventRace} to study.\""

msgid "STORY_EVENT@991_4844@BODY_HEADER"
msgstr "With crackling noise and a bright blue flash, the <<EventUnit {chairman/chairwoman}>> of the {EventRace} Council emerges before your throne."

msgid "STORY_EVENT@991_4844@BODY_LORE"
msgstr "\"My {PlayerLeader.Title}!\" <<p:EventUnit>> exclaims wheezingly, still staggered by excitement. \"Your proficiency in the arcane is inspiring! We {EventRace} look up to your wizardry in awe, and the abundant mana you harness lets us humbly follow your example: farmers animate their scythes to reap the harvest, builders make wood and stone light like a feather in the wind.\""

msgid "STORY_EVENT@991_4844@BUTTON_0"
msgstr "\"I concur. All mana shall flow freely for the {EventRace}.\""

msgid "STORY_EVENT@991_4844@BUTTON_1"
msgstr "\"The currents of magic are capricious. The Council's share [mana/] is all I can spare.\""

msgid "STORY_EVENT@991_4844@BUTTON_2"
msgstr "\"The {EventRace} [happiness/] mustn't waste my magic wealth for inanities.\""

msgid "STORY_EVENT@991_4844@BUTTON_3"
msgstr "\"This tome of yours [knowledge/] could serve a greater purpose. I demand it for myself!\""

msgid "STORY_EVENT@991_4844@TITLE"
msgstr "Arcane Applications"

msgid "STORY_EVENT@991_4848@BODY_FOOTER"
msgstr "\"The aesthetic standards of the {EventRace} cities should be held in the highest esteem, so that their splendor becomes well-known throughout the realm.\""

msgid "STORY_EVENT@991_4848@BODY_HEADER"
msgstr "Gesturing towards the balcony of your throne room, the <<EventUnit {chairman/chairwoman}>> of the {EventRace} Council requests a private audience."

msgid "STORY_EVENT@991_4848@BODY_LORE"
msgstr "\"Oh {PlayerLeader.TitleName},\" <<p:EventUnit>> says with a lavish smile, \"what a sight it is to behold {EventCity} at sunset. The refined architecture, the grand squares and towers—clearly the expression of civilization has peaked within our fair cities.\""

msgid "STORY_EVENT@991_4848@BUTTON_0"
msgstr "\"Indeed, the {EventRace} shall be known for their sublime architecture.\""

msgid "STORY_EVENT@991_4848@BUTTON_1"
msgstr "\"Aesthetics are a privilege. The council hall shall be grand [influence/], but not the huts of the common folk.\""

msgid "STORY_EVENT@991_4848@BUTTON_2"
msgstr "\"You should not indulge yourselves [happiness/] with vanity buildings. First and foremost our cities must accommodate my empire.\""

msgid "STORY_EVENT@991_4848@TITLE"
msgstr "Privileged Position"

msgid "STORY_EVENT@991_4852@BODY_FOOTER"
msgstr "\"We {EventRace} are the vessels of war. All shall hear our battle cry and despair!\""

msgid "STORY_EVENT@991_4852@BODY_HEADER"
msgstr "With confidence the <<EventUnit {chairman/chairwoman}>> of the {EventRace} Council walks towards your throne, <<o:EventUnit>> weapon lifted high."

msgid "STORY_EVENT@991_4852@BODY_LORE"
msgstr "\"Hail {PlayerLeader.TitleName}!\" <<p:EventUnit>> shouts. \"What a glorious age of the {EventRace} is at its dawn! Tempered by battle and molded through victory our people have cleaved their new destiny into the lines of our enemies.\""

msgid "STORY_EVENT@991_4852@BUTTON_0"
msgstr "\"Go forth, my armies! All {EventRace} shall bask in blood!\""

msgid "STORY_EVENT@991_4852@BUTTON_1"
msgstr "\"You deem yourselves ready, yet you are not. Train well [unitprod/] and we shall talk again.\""

msgid "STORY_EVENT@991_4852@BUTTON_2"
msgstr "\"After each war, there comes a time of peace [happiness/] and prosperity.\""

msgid "STORY_EVENT@991_4852@TITLE"
msgstr "<<EventUnit {Sons/Daughters}>> of War"

msgid "STORY_EVENT@991_4859@BODY_FOOTER"
msgstr "\"With this bestiary compendium the Council wishes to encourage all {EventRace} to seek out companionship with their kindred animal.\""

msgid "STORY_EVENT@991_4859@BODY_HEADER"
msgstr "The <<EventUnit{chairman/chairwoman}>> of the {EventRace} Council approaches your throne, a young {AnimalUnit} cuddled within <<o:EventUnit>> arms."

msgid "STORY_EVENT@991_4859@BODY_HEADER@CUB_ANIMAL"
msgstr "The <<EventUnit{chairman/chairwoman}>> of the {EventRace} Council approaches your throne, a {AnimalUnit} cuddled within <<o:EventUnit>> arms."

msgid "STORY_EVENT@991_4859@BODY_LORE"
msgstr "\"<<m:{AnimalUnit}>> are magnificent creatures, my {PlayerLeader.Title},\" the <<EventUnit{chairman/chairwoman}>> says with a caring smile. \"Did you know about their {EventAnimalTopic}? There is so much to learn from bonding with the animals of the wild, and we {EventRace} nurture all of them with great passion.\""

msgid "STORY_EVENT@991_4859@BUTTON_0"
msgstr "\"All life is sacred. The {EventRace} may embrace the creatures of this realm!\""

msgid "STORY_EVENT@991_4859@BUTTON_1"
msgstr "\"My {AnimalUnit} [unit/] I gift to the Council, but more I must forbid.\""

msgid "STORY_EVENT@991_4859@BUTTON_2"
msgstr "\"You mustn't forget [happiness/] that the place of animals is below, not among us.\""

msgid "STORY_EVENT@991_4859@TITLE"
msgstr "Primal Bond"

msgid "STORY_EVENT@991_4877@BODY_FOOTER"
msgstr "\"The Council has collected your general's most effective tactics, so that all {EventRace} may be drilled for victory.\""

msgid "STORY_EVENT@991_4877@BODY_HEADER"
msgstr "Wrapped in bloody bandages, the <<EventUnit{chairman/chairwoman}>> of the {EventRace} Council greets you with pride."

msgid "STORY_EVENT@991_4877@BODY_LORE"
msgstr "\"Strength and blood, {PlayerLeader.TitleName}!\" <<p:EventUnit>> exclaims with a raised fist. \"The weak fall on the battlefield. The frail are culled like vermin in their holes. No tactic is too gruesome when it wins a battle. We {EventRace} adapt, adopt our enemies' strengths—and we triumph.\""

msgid "STORY_EVENT@991_4877@BUTTON_0"
msgstr "\"Do whatever it takes. The {EventRace} shall be feared for their ruthlessness.\""

msgid "STORY_EVENT@991_4877@BUTTON_1"
msgstr "\"Glory to the Council [influence/], but the military training you leave to me.\""

msgid "STORY_EVENT@991_4877@BUTTON_2"
msgstr "\"Victory turns to defeat [happiness/] if it makes us abandon our principles.\" [goodact/]"

msgid "STORY_EVENT@991_4877@TITLE"
msgstr "Gore Galore"

msgid "STORY_EVENT@991_5037@BODY_FOOTER"
msgstr "There seems to be only one way to get hold of <<ge: riches^p,EventHouse.Name>>: to take it by storm and plunder it as you please."

msgid "STORY_EVENT@991_5037@BODY_HEADER"
msgstr "As your mind wanders through the glimmering abundance of your hoard, you find yourself pondering the city of {EventHouse}."

msgid "STORY_EVENT@991_5037@BODY_LORE"
msgstr "Since you first met {EventHouseLord}, a nagging feeling has been growing inside your mighty chest. Rumors about <<g: wealth^n,EventHouseLord.FirstName>> poisoned your thoughts. Tales of a secret treasure vault below {EventHouse} grappled your mind. The {EventHouseLord.Title} eluded all inquiries, fearful of a Dragon's greed."

msgid "STORY_EVENT@991_5037@BUTTON_0"
msgstr "Plan the invasion of {EventHouse}."

msgid "STORY_EVENT@991_5037@BUTTON_1"
msgstr "Reconsider. As {PlayerLeader.Title}, you get other opportunities to increase your hoard."

msgid "STORY_EVENT@991_5037@BUTTON_2"
msgstr "Befriend [influence/] {EventHouseLord} instead to siphon <<o:EventHouseLord>> wealth through tributes."

msgid "STORY_EVENT@991_5037@TITLE"
msgstr "<<ge:Treasury^n,EventHouse.Name>>"

msgid "STORY_EVENT@991_5038@BODY_FOOTER"
msgstr "What will you do with the heirlooms of the fallen {EventHouse}?"

msgid "STORY_EVENT@991_5038@BODY_HEADER"
msgstr "With the walls of {EventHouse} breached and {EventHouseLord} perished, their riches are yours to claim."

msgid "STORY_EVENT@991_5038@BODY_LORE"
msgstr "Your lackeys have been searching the <<g:palace^n,EventHouseLord>> rigorously, yet it is your unerring instinct which reveals the entrance to the treasure vault. Between sizable piles of gold you find a carefully crafted vitrine, containing the finest artifacts of <<ge:dynasty^n,EventHouse>>."

msgid "STORY_EVENT@991_5038@BUTTON_0"
msgstr "Seize the items [item/] for your hoard."

msgid "STORY_EVENT@991_5038@BUTTON_1"
msgstr "Establish a new hoard to attract a {EventUnit} [unit/]."

msgid "STORY_EVENT@991_5038@BUTTON_3"
msgstr "Hand them to the smiths of {EventCity} [unitprod/] to enhance their skill."

msgid "STORY_EVENT@991_5038@TITLE"
msgstr "<<ge:Treasury^n,EventHouse.Name>>: Aftermath"

msgid "STORY_EVENT@991_5696@BODY_FOOTER"
msgstr "How do you react to the horrors lurking within the mists, threatening the population of your city?"

msgid "STORY_EVENT@991_5696@BODY_HEADER"
msgstr "A thick unnatural mist is spreading from the {EventGeo} {EventDirection} {EventCity}."

msgid "STORY_EVENT@991_5696@BODY_LORE"
msgstr "An eerie silence engulfs the world outside the city gates. Reports of strange figures creeping in the shadows sow panic among your citizens, while the surrounding villages speak of people disappearing within the fog."

msgid "STORY_EVENT@991_5696@BUTTON_0"
msgstr "Empty your treasure chests [gold/] to muster the militia [unitprod/] of {EventCity}."

msgid "STORY_EVENT@991_5696@BUTTON_1"
msgstr "Surround the city with warding spells [mana/] to delay the approaching dread."

msgid "STORY_EVENT@991_5696@BUTTON_2"
msgstr "Let the people take refuge in {EventCity}. Your defenses are prepared."

msgid "STORY_EVENT@991_5696@TITLE"
msgstr "Toll of Spring"

msgid "STORY_EVENT@991_5696@TITLE@AUTUMN"
msgstr "Toll of Autumn"

msgid "STORY_EVENT@991_5696@TITLE@SUMMER"
msgstr "Toll of Summer"

msgid "STORY_EVENT@991_5696@TITLE@WINTER"
msgstr "Toll of Winter"

msgid "STORY_EVENT@991_5701@BODY_FOOTER"
msgstr "There is little time left before the {EventStructure} collapses."

msgid "STORY_EVENT@991_5701@BODY_FOOTER@POP_LOST"
msgstr "There is little time left before the {EventStructure} collapses and any hope of rescuing the captives from {EventCity} ends."

msgid "STORY_EVENT@991_5701@BODY_HEADER"
msgstr "You have driven the {EventRace} away from {EventCity}."

msgid "STORY_EVENT@991_5701@BODY_LORE"
msgstr "Their remnants, following the trail of the terrible {EventUnit}, retreated into the dissipating mists. As the air slowly becomes clear again, a {EventStructure} is revealed in the {EventGeo}. Without a doubt, this is where the {EventRace} returned to their realm of the Fey."

msgid "STORY_EVENT@991_5701@BODY_LORE@POP_LOST"
msgstr "Their remnants, following the trail of the terrible {EventUnit}, retreated into the dissipating mists. As the air slowly becomes clear again, a {EventStructure} is revealed in the {EventGeo}. Is this where your people from {EventCity} were taken? Abducted to the realm of the Fey?"

msgid "STORY_EVENT@991_5701@BUTTON_0"
msgstr "Let all make haste!"

msgid "STORY_EVENT@991_5701@TITLE"
msgstr "Retreating Mists"

msgid "STORY_EVENT@991_5713@BODY_FOOTER"
msgstr "Will you send your army into the {EventStructure} to pursue the {EventRace}?"

msgid "STORY_EVENT@991_5713@BODY_FOOTER@POP_LOST"
msgstr "Will you send your army into the {EventStructure} to pursue the {EventRace} and liberate your people?"

msgid "STORY_EVENT@991_5713@BODY_HEADER"
msgstr "Approaching the {EventStructure}, you can sense a dwindling presence of Fey magic."

msgid "STORY_EVENT@991_5713@BODY_LORE"
msgstr "There is no doubt that the {EventStructure} leads to the Fey realm, {GLOBAL.DuathaLoreConcept.Hyperlink}, and to the remaining {EventRace}. You must weigh your options. The {EventRace} may still be numerous. They will be hard to surprise in their own, erratic domain. You can't shake off the feeling that following them without a sufficiently large host would be suicide."

msgid "STORY_EVENT@991_5713@BUTTON_0"
msgstr "\"We fear nothing. We shall go through!\""

msgid "STORY_EVENT@991_5713@BUTTON_1"
msgstr "Seal the fissure to siphon the last droplets of Fey magic [mana/]."

msgid "STORY_EVENT@991_5713@BUTTON_2"
msgstr "Retreat, for now."

msgid "STORY_EVENT@991_5713@TITLE"
msgstr "The Path to Duatha"

msgid "STORY_EVENT@991_5714@BODY_FOOTER"
msgstr "Screams of your troops alert you of the collapsing {EventStructure}. Whatever you intend to do with the Fey relic, it must be done quickly!"

msgid "STORY_EVENT@991_5714@BODY_FOOTER@HERO"
msgstr "Screams of your troops alert {EventHero} of the soon collapsing {EventStructure}. Whatever <<p:EventHero>> intended to do with the Fey relic, it must be done quickly!"

msgid "STORY_EVENT@991_5714@BODY_HEADER"
msgstr "You have driven the remaining {EventRace} deeper into the Fey realm."

msgid "STORY_EVENT@991_5714@BODY_HEADER@POP_LOST"
msgstr "You have driven the remaining {EventRace} deeper into the Fey realm, and their captives—your citizens from {EventCity}—are free again."

msgid "STORY_EVENT@991_5714@BODY_LORE"
msgstr "While the troops watch out for any ill Fey trickery, your attention is drawn to the tree shrine placed at the center of the settlement. At its heart rests an otherworldly relic, echoing the whispers of a distant entity as you come close enough to touch it. The relic radiates great power, but also menace."

msgid "STORY_EVENT@991_5714@BODY_LORE@HERO"
msgstr "While the troops watch out for any ill Fey trickery, <<ge:attention^n,EventHero.Name>> is drawn to the tree shrine placed at the center of the settlement. At its heart rests an otherworldly relic, echoing the whispers of a distant entity as {EventHero} comes close enough to touch it. The relic emanates great power, but also menace."

msgid "STORY_EVENT@991_5714@BUTTON_0"
msgstr "Break the relic to liberate the spell dwelling inside."

msgid "STORY_EVENT@991_5714@BUTTON_2"
msgstr "Disenchant the relic into binding essence [bindingfragments/]."

msgid "STORY_EVENT@991_5714@BUTTON_3"
msgstr "Take the relic. Their powers shall be yours!"

msgid "STORY_EVENT@991_5714@TITLE"
msgstr "The Path to Duatha: Aftermath"

msgid "STORY_EVENT@991_5737@BODY_FOOTER"
msgstr "\"Return the {EventRelic}, and we will move our affairs to an empire that you suggest. Decline, and you summon the mists of {GLOBAL.DuathaLoreConcept.Hyperlink}.\""

msgid "STORY_EVENT@991_5737@BODY_HEADER"
msgstr "A feeling of unsettledness creeps into the deep chambers of your wizard's tower, as an emissary of the {EventRace} appears from a sudden waft of mist."

msgid "STORY_EVENT@991_5737@BODY_LORE"
msgstr "\"I am {EventHero}, descendant of the great Raven Tharic and servant of the {GLOBAL.DuathadaeLoreConcept.Hyperlink}. Our lords,\" <<p:EventHero>> says, \"do not tolerate the loss of the gifts they gave.\" The Fey holds up a sheath with ornamental markings depicting the {EventRelic}. \"Lucky for you, {PlayerLeader}, the {GLOBAL.DuathadaeLoreConcept.Hyperlink} are generous with their offerings,\" {EventHero} continues as <<p:EventHero>> briefly shifts <<o:EventHero>> face into a {EventUnit} visage."

msgid "STORY_EVENT@991_5737@BUTTON_0"
msgstr "Return the Fey relic and ask the {EventRace} to attack {TargetPlayerA}."

msgid "STORY_EVENT@991_5737@BUTTON_2"
msgstr "Deny the return of the idol."

msgid "STORY_EVENT@991_5737@BUTTON_3"
msgstr "... ask the {EventRace} to attack {TargetPlayerB}."

msgid "STORY_EVENT@991_5737@BUTTON_4"
msgstr "... ask the {EventRace} to attack {TargetPlayerC}."

msgid "STORY_EVENT@991_5737@TITLE"
msgstr "An Unexpected Offer"

msgid "STORY_EVENT@991_5738@BODY_FOOTER"
msgstr "The time for negotiations has passed. How will you prepare for the final attack of the Fey?"

msgid "STORY_EVENT@991_5738@BODY_HEADER"
msgstr "The spreading fog of the {EventRace} heralds the near beginning of the battle for {EventCity}."

msgid "STORY_EVENT@991_5738@BODY_LORE"
msgstr "There is no eerie uncertainty, no doubt about the nature of the mists or the figures creeping within. The {GLOBAL.DuathadaeLoreConcept.Hyperlink} demand back what they deem rightfully theirs, and the {EventRace} are their instrument of war."

msgid "STORY_EVENT@991_5738@BUTTON_0"
msgstr "Promise any reward [gold/] for troops [unitprod/] to join the last stand at {EventCity}."

msgid "STORY_EVENT@991_5738@BUTTON_1"
msgstr "Surround the city with warding spells [mana/] to delay the invasion force."

msgid "STORY_EVENT@991_5738@BUTTON_2"
msgstr "Let the people take refuge in {EventCity}. Your defenses are prepared."

msgid "STORY_EVENT@991_5738@TITLE"
msgstr "Duatha Unleashed"

msgid "STORY_EVENT@991_5739@BODY_FOOTER"
msgstr "Thanks to your victory the realm must no longer fear the Toll of Seasons."

msgid "STORY_EVENT@991_5739@BODY_HEADER"
msgstr "You have vanquished the {EventRace} and ended their onslaught. The people of {EventCity} are rejoicing!"

msgid "STORY_EVENT@991_5739@BODY_LORE"
msgstr "In the meantime, you have withdrawn to your wizard's tower to return to the {EventRelic}, which is now yours and yours alone. The relic of the {GLOBAL.DuathadaeLoreConcept.Hyperlink} intrigues and excites you, and spending more time attuned to it has revealed to you more of its secrets."

msgid "STORY_EVENT@991_5739@BUTTON_0"
msgstr "I do what must be done. [happiness/] [influence/]"

msgid "STORY_EVENT@991_5739@TITLE"
msgstr "End of the Mists"

msgid "STORY_EVENT@991_6428@BODY_FOOTER"
msgstr "Will you construct the <<m:{GLOBAL.ForesterConcept.Hyperlink}>> to gather the wood {EventHero} requires for <<o:EventHero>> {EventImprovement}?"

msgid "STORY_EVENT@991_6428@BODY_HEADER"
msgstr "Your [hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink] {EventHero} approaches you, a burning torch in <<o:EventHero>> hands."

msgid "STORY_EVENT@991_6428@BODY_LORE"
msgstr "\"Behold the flame, my {EventPlayer.Title}, and watch it devour the material essence of this [hyperlink,GLOBAL.WorldsWithinLoreConcept]world within[/hyperlink]! Has it not birthed entire civilizations and destroyed them at its will?\" <<Cge:eyes^p,EventHero.FirstName>> flash up in the light of <<o:EventHero>> torch. \"You are {GLOBAL.GodirLoreConcept.Hyperlink}. You know the arcane powers that burst from every bonfire. Let me fan the flames, {PlayerLeader}! Let me create a {EventImprovement} worthy of your magnificence!\""

msgid "STORY_EVENT@991_6428@TITLE"
msgstr "Ashes to Ashes"

msgid "STORY_EVENT@991_6429@BODY_FOOTER"
msgstr "Empowered by the {EventImprovement}, you feel an arcane surge rippling through your body. What do you do?"

msgid "STORY_EVENT@991_6429@BODY_HEADER"
msgstr "With feverish elation, {EventHero} presents to you <<o:EventHero>> flaring {EventImprovement}."

msgid "STORY_EVENT@991_6429@BODY_LORE"
msgstr "\"Burn, eternal flame, and light up the skies! Let all on this realm see the splendor of {PlayerLeader.TitleName}!\" {EventHero.FirstName} raises <<o:EventHero>> hands and as the fire scorches <<ge:offerings^p,EventHero.FirstName>>, you can sense the [hyperlink,GLOBAL.AstralFlowsLoreConcept]astral currents[/hyperlink] shift until they converge in your position."

msgid "STORY_EVENT@991_6429@TITLE"
msgstr "Ashes to Ashes: Aftermath"

msgid "STORY_EVENT@991_6432@BUTTON_0"
msgstr "You channel the mana to summon a being of pure fire [unit/]."

msgid "STORY_EVENT@991_6432@BUTTON_1"
msgstr "You cast a flame-bound blessing [unitHero/] on {EventHero}."

msgid "STORY_EVENT@991_6432@BUTTON_2"
msgstr "You absorb the arcane energies [mana/]."

msgid "STORY_EVENT@991_6433@BUTTON_0"
msgstr "\"Kindle the flame, {EventHero}. It will empower my reign.\""

msgid "STORY_EVENT@991_6433@BUTTON_1"
msgstr "\"I have no interest in your {EventImprovement}, {EventHero}.\""

msgid "STORY_EVENT@991_6446@BODY_FOOTER"
msgstr "\"Say the word where to place my {EventImprovement}, and it shall be done!\""

msgid "STORY_EVENT@991_6446@BODY_HEADER"
msgstr "Your <<m:{GLOBAL.ForesterConcept.Hyperlink}>> have collected the wood {EventHero} needed for <<o:EventHero>> {EventImprovement}."

msgid "STORY_EVENT@991_6446@BODY_LORE"
msgstr "\"It is time, my {EventPlayer.Title},\" {EventHero.FirstName} says, a fire burning in <<o:EventHero>> eyes. \"The stakes are prepared and my fingers are itching to light the spark that sets the stage ablaze...\""

msgid "STORY_EVENT@991_6446@BUTTON_0"
msgstr "\"I will inspect my cities to give the order...\""

msgid "STORY_EVENT@991_6446@TITLE"
msgstr "Ashes to Ashes: Interlude"

msgid "STORY_EVENT@991_6463@BODY_FOOTER"
msgstr "Will you construct the <<m:{GLOBAL.ForesterConcept.Hyperlink}>> to gather the wood {EventHero} requires for <<o:EventHero>> {EventImprovement}?"

msgid "STORY_EVENT@991_6463@BODY_HEADER"
msgstr "With a doleful expression on <<o:EventHero>> face and the fur of a {EventUnit} in <<o:EventHero>> hands, {EventHero} is seeking your audience."

msgid "STORY_EVENT@991_6463@BODY_LORE"
msgstr "\"This, my {PlayerLeader.Title},\" <<p:EventHero>> begins, \"was a {EventUnit}, a proud creature once roaming the lands far and wide. But in this day and age, where our cities encroach on the wilds, they are slain like mere pests.\" {EventHero.FirstName} shows the bloodstained scar where the fur had been pierced. \"The animals of this realm need a shelter, secluded within our domain. Allow me to build a {EventImprovement}, {PlayerLeader}, and we can prosper in harmony again.\""

msgid "STORY_EVENT@991_6463@BUTTON_0"
msgstr "\"You are wise, {EventHero}. The beasts of this land should be tamed, not hunted.\""

msgid "STORY_EVENT@991_6463@BUTTON_1"
msgstr "\"The <<m:{EventUnit}>> are none of my concern, {EventHero}.\""

msgid "STORY_EVENT@991_6463@TITLE"
msgstr "A Shelter Unspoiled"

msgid "STORY_EVENT@991_6464@BODY_FOOTER"
msgstr "\"Your instincts are infallible, my {PlayerLeader.Title}. Tell me, where shall I construct the {EventImprovement}?\""

msgid "STORY_EVENT@991_6464@BODY_HEADER"
msgstr "Your <<m:{GLOBAL.ForesterConcept.Hyperlink}>> have collected the wood {EventHero} needed for <<o:EventHero>> {EventImprovement}."

msgid "STORY_EVENT@991_6464@BODY_LORE"
msgstr "\"Your benevolence is a blessing for the creatures of this land, {PlayerLeader},\" {EventHero} says, holding a {EventTreeBranch}. \"I have it all planned out. The mangers, the fencing, the bait on animal trails...\" <<Cp:EventHero>> uses <<o:EventHero>> {EventTreeBranch} to put drawings on the ground, presumably forming a map, though it remains unreadable."

msgid "STORY_EVENT@991_6464@BUTTON_0"
msgstr "\"My 'instincts' are examining the land surrounding our cities...\""

msgid "STORY_EVENT@991_6464@TITLE"
msgstr "A Shelter Unspoiled: Interlude"

msgid "STORY_EVENT@991_6465@BODY_FOOTER"
msgstr "\"You fostered this sanctuary, my {PlayerLeader.Title}. Please, choose your gift from it, ripe for the taking.\""

msgid "STORY_EVENT@991_6465@BODY_HEADER"
msgstr "Overjoyed and proud, {EventHero} invites you to visit <<o:EventHero>> {EventImprovement}."

msgid "STORY_EVENT@991_6465@BODY_LORE"
msgstr "Surrounded by the <<m:{EventGeo}>> {EventDirection} {EventCity}, the {EventImprovement} is roaming with many beasts, great and small. Even a {EventUnit} already found its way here. \"Is it not marvelous,\" {EventHero.FirstName} asks, gesturing around. \"The creatures of the land have accepted my offering. Their troubled spirits are finding rest and bestowing peace upon the wilds.\""

msgid "STORY_EVENT@991_6465@BUTTON_0"
msgstr "\"I will nurture the {EventUnit} [unit/] until it grows to full strength.\""

msgid "STORY_EVENT@991_6465@BUTTON_1"
msgstr "\"You are the gift, {EventHero}. Lead this new 'pack' of yours with wisdom [unitHero/].\""

msgid "STORY_EVENT@991_6465@BUTTON_2"
msgstr "\"Tame me a mount [mount/] from your {EventImprovement}, {EventHero}, to ride into battle!\""

msgid "STORY_EVENT@991_6465@TITLE"
msgstr "A Shelter Unspoiled: Aftermath"

msgid "STORY_EVENT@991_6484@BODY_FOOTER"
msgstr "\"If you entrust me with a {GLOBAL.ResearchPostConcept.Hyperlink}, my {PlayerLeader.Title}, I will found this realm's first {EventImprovement}!\""

msgid "STORY_EVENT@991_6484@BODY_HEADER"
msgstr "A creeping cold enters the room as {EventHero} seeks your company."

msgid "STORY_EVENT@991_6484@BODY_LORE"
msgstr "\"When people hear about frost magic, my {PlayerLeader.Title}, they think of winter and death,\" <<p:EventHero>> says slowly, \"while they should consider the hauntingly beautiful ice crystal structures and their useful applications. Did you know I could deep-freeze the meat of a {EventUnit} and it would not spoil in years? To end this ignorance,\" {EventHero.FirstName} concludes, \"I dream of a {EventImprovement}, where frost mages break the ice—and study its mysteries.\""

msgid "STORY_EVENT@991_6484@BUTTON_0"
msgstr "\"Gather your apprentices, {EventHero}. It shall be done.\""

msgid "STORY_EVENT@991_6484@BUTTON_1"
msgstr "\"I cannot endorse your plans of ice and cold, {EventHero}.\""

msgid "STORY_EVENT@991_6484@TITLE"
msgstr "Gelid Yearnings"

msgid "STORY_EVENT@991_6485@BODY_FOOTER"
msgstr "\"Now tell me, my {PlayerLeader.Title}, which frozen wasteland may I claim for my {EventImprovement}?\""

msgid "STORY_EVENT@991_6485@BODY_HEADER"
msgstr "Within the {GLOBAL.ResearchPostConcept.Hyperlink} you lent to <<P:EventHero>>, {EventHero} has finalized <<o:EventHero>> preparations to found the {EventImprovement}."

msgid "STORY_EVENT@991_6485@BODY_LORE"
msgstr "\"The cold arts are ready to be taught, O {PlayerLeader.TitleName},\" {EventHero} declares with dignity. \"I have acquired the scrolls and materials, planned out building complex and subject matters. My future students are eager to enroll for their first term. Now all it takes is some snowfall at your command...\" {EventHero.FirstName} shows a rare smile."

msgid "STORY_EVENT@991_6485@BUTTON_0"
msgstr "\"Frozen wasteland? Let me see if my cities can accommodate your wishes...\""

msgid "STORY_EVENT@991_6485@TITLE"
msgstr "Gelid Yearnings: Interlude"

msgid "STORY_EVENT@991_6486@BODY_FOOTER"
msgstr "\"Your patronage has enabled the founding of this college. Any favor you ask for, I shall oblige.\""

msgid "STORY_EVENT@991_6486@BODY_HEADER"
msgstr "Wearing an archmage's attire {EventHero} receives you at <<o:EventHero>> {EventImprovement}."

msgid "STORY_EVENT@991_6486@BODY_LORE"
msgstr "\"Welcome to the College of {EventCity},\" <<p:EventHero>> pronounces, opening the front gate, \"where the initiates summon the storms of winter and the fern frost blooms. Of course,\" <<p:EventHero>> adds cautiously, \"all of this pales besides your magecraft, {PlayerLeader.TitleName}.\""

msgid "STORY_EVENT@991_6486@BUTTON_0"
msgstr "\"Let your adepts call forth a frosty creature [unit/] for me to command!\""

msgid "STORY_EVENT@991_6486@BUTTON_1"
msgstr "\"Head the College of {EventCity} [unitHero/] with the firmness of ice.\""

msgid "STORY_EVENT@991_6486@BUTTON_2"
msgstr "\"Your finest student shall serve me as a {EventUnit} [unit/].\""

msgid "STORY_EVENT@991_6486@TITLE"
msgstr "Gelid Yearnings: Aftermath"

msgid "STORY_EVENT@991_6495@BODY_FOOTER"
msgstr "Will you construct the <<m:{GLOBAL.QuarryConcept.Hyperlink}>> to supply {EventHero} with the worked stones required for <<o:EventHero>> {EventImprovement}?"

msgid "STORY_EVENT@991_6495@BODY_HEADER"
msgstr "With <<o:EventHero>> armor and garments neat and polished, {EventHero} kneels before your throne."

msgid "STORY_EVENT@991_6495@BODY_LORE"
msgstr "\"Most assuredly, my {PlayerLeader.Title}, you have heard of the power that can be bound in magical runes.\" <<Cp:EventHero>> reveals a runestone embedded in <<o:EventHero>> armor. \" Since I bear this enchantment, the blows I receive lose potency and the arrows deflect in my favor—and it has become my craving to protect more of our troops through such runecraft and set up a {EventImprovement}.\""

msgid "STORY_EVENT@991_6495@BUTTON_0"
msgstr "\"You shall have your workshop, skillful {EventHero.FirstName}.\""

msgid "STORY_EVENT@991_6495@BUTTON_1"
msgstr "\"Your {EventImprovement} does not align with my plans, {EventHero}.\""

msgid "STORY_EVENT@991_6495@TITLE"
msgstr "Runes of Magic"

msgid "STORY_EVENT@991_6497@BODY_FOOTER"
msgstr "\"I owe you a debt of gratitude, O {PlayerLeader},\" {EventHero} concludes. \"Take any compensation this {EventImprovement} can provide.\""

msgid "STORY_EVENT@991_6497@BODY_HEADER"
msgstr "Between stockpiled armor and blocks of stone {EventHero} awaits you to present <<o:EventHero>> {EventImprovement}."

msgid "STORY_EVENT@991_6497@BODY_LORE"
msgstr "\"Look at this fine craftsmanship, my <<EventPlayer{lord/lady}>>!\" <<Cp:EventHero>> beckons a servant over who is holding a locked display case. {EventHero.FirstName} opens the lock. Inside you see necklaces rings and amulets, but also ornate leather armor, all imbued with enchanted runestones. \"Though beautiful to behold, the true value of these magic items will be revealed in battle.\""

msgid "STORY_EVENT@991_6497@BUTTON_0"
msgstr "Take the blue runes of <<A:{EventShieldSpell}>>."

msgid "STORY_EVENT@991_6497@BUTTON_1"
msgstr "Take the red runes of <<A:{EventBladeSpell}>>."

msgid "STORY_EVENT@991_6497@BUTTON_2"
msgstr "Take the yellow runes of <<A:{EventArrowSpell}>>."

msgid "STORY_EVENT@991_6497@BUTTON_3"
msgstr "Elect the rune-enchanted {EventArmor} and {EventJewelry} [item/] from the display case."

msgid "STORY_EVENT@991_6497@TITLE"
msgstr "Runes of Magic: Aftermath"

msgid "STORY_EVENT@991_6501@BODY_FOOTER"
msgstr "\"Say the word, my {PlayerLeader.Title}, and I will set up my {EventImprovement} at your command.\""

msgid "STORY_EVENT@991_6501@BODY_HEADER"
msgstr "Your <<m:{GLOBAL.QuarryConcept.Hyperlink}>> have worked the stones {EventHero} needed for <<o:EventHero>> {EventImprovement}."

msgid "STORY_EVENT@991_6501@BODY_LORE"
msgstr "\"O {PlayerLeader.TitleName}, \" <<p:EventHero>> welcomes you with a bow, \"all preparations to commence the crafting of runes have come to completion. The stone cutters have worked wonders, and so has your warrant, allowing me to secure tools, artisans and scrolls of enchantment.\" {EventHero.FirstName} exhibits industrious joy."

msgid "STORY_EVENT@991_6501@BUTTON_0"
msgstr "\"I will inspect my cities to give the order...\""

msgid "STORY_EVENT@991_6501@TITLE"
msgstr "Runes of Magic: Interlude"

msgid "STORY_EVENT@991_6513@BODY_FOOTER"
msgstr "Will you construct the {GLOBAL.ConduitConcept.Hyperlink} {EventHero} needs to harness for <<o:EventHero>> {EventImprovement}?"

msgid "STORY_EVENT@991_6513@BODY_HEADER"
msgstr "The air starts to sizzle with arcane energies as {EventHero} enters your throne room."

msgid "STORY_EVENT@991_6513@BODY_LORE"
msgstr "\"Your magecraft is awe-inspiring, O {PlayerLeader.TitleName},\" <<p:EventHero>> says with a respectful voice. \"As your humble servant I seek to emulate just a fraction of your powers. You are a {GLOBAL.GodirLoreConcept.Hyperlink}, capable of raising Wizard's Towers that pierce the sky. I am a simple mage. Yet I dream of a {EventImprovement} where sorcery can be practiced by the initiates of the arcane, to the glory of our {PlayerLeader.Title}.\""

msgid "STORY_EVENT@991_6513@BUTTON_0"
msgstr "\"Your ambitions flatter me, {EventHero}. Proceed.\""

msgid "STORY_EVENT@991_6513@BUTTON_1"
msgstr "\"Despite your sweet-talk, I have no interest in your {EventImprovement}, {EventHero}.\""

msgid "STORY_EVENT@991_6513@TITLE"
msgstr "Sorcerer's Spire"

msgid "STORY_EVENT@991_6515@BODY_FOOTER"
msgstr "\"This {EventImprovement} is a mere droplet in your pool of arcane wealth. Still, if you desire anything it offers, you may take it.\""

msgid "STORY_EVENT@991_6515@BODY_HEADER"
msgstr "Visiting the {EventImprovement} of {EventHero}, you are welcomed by a {MagicUnit} familiar."

msgid "STORY_EVENT@991_6515@BODY_LORE"
msgstr "The {MagicUnit} shows you round the different levels of the tower, from the mana cellar to the library, the training grounds and at last the sorcerer's spire at the top. There {EventHero} greets you, overjoyed: \"Excuse my initial absence, my {PlayerLeader.Title}. But the opportunities this tower provides are exhilarating and it costs me to put my studies aside...\""

msgid "STORY_EVENT@991_6515@BUTTON_0"
msgstr "\"Share the findings of your mystic studies [knowledge/], {EventHero.FirstName}.\""

msgid "STORY_EVENT@991_6515@BUTTON_1"
msgstr "\"Embrace this role as a sorcerer [unitHero/], {EventHero}. It suits you well.\""

msgid "STORY_EVENT@991_6515@BUTTON_2"
msgstr "\"I like your {MagicUnit} familiar [unit/]. Let me keep it.\""

msgid "STORY_EVENT@991_6515@TITLE"
msgstr "Sorcerer's Spire: Aftermath"

msgid "STORY_EVENT@991_6519@BODY_FOOTER"
msgstr "{EventHero} has the urge to release <<o:EventHero>> astral energies and create the {EventImprovement} at your will."

msgid "STORY_EVENT@991_6519@BODY_HEADER"
msgstr "Drawing astral energies from the {GLOBAL.ConduitConcept.Hyperlink} you constructed for <<P:EventHero>>, {EventHero} has finalized <<o:EventHero>> preparations to shape the {EventImprovement}."

msgid "STORY_EVENT@991_6519@BODY_LORE"
msgstr "\"You have empowered me, my {PlayerLeader.Title}!\" <<Cp:EventHero>> speaks with confidence, <<o:EventHero>> eyes flashing with blue light. \"The {GLOBAL.AstralFlowsLoreConcept.Hyperlink}, they surge through my body; the mana, it runs through my veins. I must unleash its creative potential while the vision of the {EventImprovement} is strong within me. {PlayerLeader}, please...\""

msgid "STORY_EVENT@991_6519@BUTTON_0"
msgstr "\"Where the Conduits hum, your {EventImprovement} will thrive...\""

msgid "STORY_EVENT@991_6519@TITLE"
msgstr "Sorcerer's Spire: Interlude"

msgid "STORY_EVENT@991_6523@BODY_FOOTER"
msgstr "Will you construct the <<m:{GLOBAL.FarmConcept.Hyperlink}>> to supply {EventHero} with the crops required for <<o:EventHero>> {EventImprovement}?"

msgid "STORY_EVENT@991_6523@BODY_HEADER"
msgstr "With pious solemnity you are visited by {EventHero}, holding a figurine that appears to model—you!"

msgid "STORY_EVENT@991_6523@BODY_LORE"
msgstr "\"O {PlayerLeader.TitleName}!\" <<p:EventHero>> calls out, briefly pausing in <<o:EventHero>> devotion. \"Officially I may serve you as a general. But you are not just a ruler to me. You are {GLOBAL.GodirLoreConcept.Hyperlink}, a {GLOBAL.GodirLoreConcept.Hyperlink}, I worship and adore. In the Order of {PlayerLeader.FirstName} many desire to render your {EventPlayerAttribute} religious service. We seek to build an {EventImprovement} where we can commune as monks. Alas, we lack the farming grounds to grow the crops for our rituals...\""

msgid "STORY_EVENT@991_6523@BUTTON_0"
msgstr "\"Worshiping my {EventPlayerAttribute}? You may proceed...\""

msgid "STORY_EVENT@991_6523@BUTTON_1"
msgstr "\"Your order should restrain themselves, for now.\""

msgid "STORY_EVENT@991_6523@BUTTON_2"
msgstr "\"Come to your senses, <<EventHero{brother/sister}>>! Only to the Allfather we should pray...\" [goodact/]"

msgid "STORY_EVENT@991_6523@TITLE"
msgstr "The Order of {PlayerLeader.FirstName}"

msgid "STORY_EVENT@991_6524@BODY_FOOTER"
msgstr "\"The disciples eagerly await the prophetic words of their {GLOBAL.GodirLoreConcept.Hyperlink}: where shall we build the {EventImprovement}?\""

msgid "STORY_EVENT@991_6524@BODY_HEADER"
msgstr "Your <<m:{GLOBAL.FarmConcept.Hyperlink}>> have harvested the crops {EventHero} needed for <<o:EventHero>> {EventImprovement}."

msgid "STORY_EVENT@991_6524@BODY_LORE"
msgstr "\"O most generous {PlayerLeader.TitleName},\" {EventHero.FirstName} shouts in excitement, \"these herbs and progeny will serve our ritual masters well. In the meantime,\" <<p:EventHero>> continues, \"your followers have not been idle, securing architects, work force and building materials for the {EventImprovement}.\""

msgid "STORY_EVENT@991_6524@BUTTON_0"
msgstr "\"Once I have inspected my cities, you will be given a sign...\""

msgid "STORY_EVENT@991_6524@TITLE"
msgstr "The Order of {PlayerLeader.FirstName}: Interlude"

msgid "STORY_EVENT@991_6525@BODY_FOOTER"
msgstr "\"Our order and this {EventImprovement} exist solely to do you service. How may we please you, our {EventPlayerType}, today?\""

msgid "STORY_EVENT@991_6525@BODY_HEADER"
msgstr "Carrying a tome adorned with your countenance, {EventHero} welcomes you at the new {EventImprovement}."

msgid "STORY_EVENT@991_6525@BODY_LORE"
msgstr "\"You bless us with your presence, O {PlayerLeader.TitleName}!\" <<Cp:EventHero>> lifts <<o:EventHero>> arms, preaching to the monks gathering in the <<Ge:central court^n,EventImprovement.Name>>. \"Through our rituals we can now transcend our consciousness and grow closer to your {EventPlayerAttribute}. But nothing is nearly as elevating as our {GLOBAL.GodirLoreConcept.Hyperlink} walking among us.\""

msgid "STORY_EVENT@991_6525@BUTTON_0"
msgstr "\"Inscribe your rituals and epiphanies into holy books of knowledge.\" [knowledge/]"

msgid "STORY_EVENT@991_6525@BUTTON_1"
msgstr "\"Spread the words of my godly nature in {EventCity}!\" [happiness/]"

msgid "STORY_EVENT@991_6525@BUTTON_2"
msgstr "\"Let the faith of your order strengthen my reign.\" [influence/]"

msgid "STORY_EVENT@991_6525@BUTTON_DRAGON"
msgstr "\"I crave your order's relics for my hoard!\" [item/]"

msgid "STORY_EVENT@991_6525@BUTTON_ELDRITCH"
msgstr "\"[runicfont]The tentacle gives and the tentacle takes.[/runicfont]\"[thralls/]"

msgid "STORY_EVENT@991_6525@TITLE"
msgstr "The Order of {PlayerLeader.FirstName}: Aftermath"

msgid "STORY_EVENT@991_6558@BODY_FOOTER"
msgstr "Eager to hunt for the treasures of the old Giant Kings, your men await further orders."

msgid "STORY_EVENT@991_6558@BODY_HEADER"
msgstr "Making their way through the underground, your troops enter a cavern glittering in shades of gold."

msgid "STORY_EVENT@991_6558@BODY_LORE"
msgstr "It appears indeed that there once must have been an abundance of the precious metal in the region. Scattered ruins of Myrridan architecture connected by a railroad network and a myriad of mining carts suggest that in the days of ancient {GLOBAL.MyrridaLoreConcept.Hyperlink} this must have been a flourishing gold mining complex. What still remains of this gilded splendor remains to be seen, but the glimmer in the eyes of your troops speaks volumes."

msgid "STORY_EVENT@991_6558@BUTTON_0"
msgstr "Allow them to press on. [movementgeneral/]"

msgid "STORY_EVENT@991_6558@BUTTON_1"
msgstr "You sense danger. They should rest [hp/] before they continue."

msgid "STORY_EVENT@991_6558@BUTTON_2"
msgstr "Refrain from giving any special orders."

msgid "STORY_EVENT@991_6558@BUTTON_3"
msgstr "Connect with the earth to scry for the riches lying ahead."

msgid "STORY_EVENT@991_6558@TITLE"
msgstr "Entering the Gilded Wastes"

msgid "STORY_EVENT@991_6576@BODY_FOOTER"
msgstr "Scared by the ghostly whispers your soldiers seek your guidance."

msgid "STORY_EVENT@991_6576@BODY_HEADER"
msgstr "As the sound of chinking coins echoes through the cavern it is answered by the uttered sighs of a thousand mouthless voices."

msgid "STORY_EVENT@991_6576@BODY_LORE"
msgstr "\"Leave us!\" \"Save us!\" \"Join us!\" \"Savior!\" \"Traitor!\" \"Damned!\" The roused whispers filling the cave, discordant and covetous, instill your troops with fear. Some of them claim to see armed ghostly figures moving in the dark. Eventually the voices subside and the Gilded Wastes return to a state of silence. But it is no longer a silence that knows comfort."

msgid "STORY_EVENT@991_6576@BUTTON_0"
msgstr "Dismiss their fears [happiness/]."

msgid "STORY_EVENT@991_6576@BUTTON_1"
msgstr "Appeal [influence/] to their bravery."

msgid "STORY_EVENT@991_6576@BUTTON_2"
msgstr "Demonstrate your arcane might [mana/]. The phantasms should tremble!"

msgid "STORY_EVENT@991_6576@TITLE"
msgstr "Gilded Wastes: Phantasmal Whispers"

msgid "STORY_EVENT@991_6579@BODY_FOOTER"
msgstr "Armed phantasms step out of the shadows, blocking any path forward or backward."

msgid "STORY_EVENT@991_6579@BODY_HEADER"
msgstr "After your troops salvaged another stash of gold within the ruins, a single wrathful voice fills the cavern."

msgid "STORY_EVENT@991_6579@BODY_LORE"
msgstr "\"Raiders! Looters! Thieves!\" the voice shouts, violently booming in the ears of your troops. \"You are all guilty of greed, staining your hands with the blood of the {EventRace}. We mined till death. We smelted till death. Crumbling beneath the iron feet of {EventGiantKing}. Accursed is <<o:EventGiantKing>> name. Accursed, the gold. Accursed, all who touch a single coin!\""

msgid "STORY_EVENT@991_6579@BUTTON_0"
msgstr "\"Take up arms! These ghosts are no match for us!\""

msgid "STORY_EVENT@991_6579@BUTTON_1"
msgstr "\"Our hearts know no greed. To prove it, we will sacrifice our wealth [gold/].\""

msgid "STORY_EVENT@991_6579@TITLE"
msgstr "Gilded Wastes: Phantasmal Rage"

msgid "STORY_EVENT@991_6580@BODY_FOOTER"
msgstr "Blinded by agony, the phantasm sends out more of <<o:EventHero>> brethren to falsely avenge their fate."

msgid "STORY_EVENT@991_6580@BODY_HEADER"
msgstr "With more gold taken from the ruins, the phantasm voice returns in anger."

msgid "STORY_EVENT@991_6580@BODY_LORE"
msgstr "\"Stop! Stop! Why won't you die, relentless raiders? Have we not suffered enough...\" The phantasm sounds desperate, defeated. \"{EventGiantKing} craved tireless golems to do <<o:EventGiantKing>> bidding, without rest, will or needs,\" the voice continues. \"When the forges failed <<o:EventGiantKing>> demands, {EventGiantKing} turned to wicked magic, attempting to twist our bodies into a race of golem servants. Instead... we became this!\" The phantasm reveals <<o:EventHero>> face, half ghostly flesh and half metal."

msgid "STORY_EVENT@991_6580@BUTTON_0"
msgstr "\"Stand together! No mercy for the merciless!\""

msgid "STORY_EVENT@991_6580@BUTTON_1"
msgstr "\"Your troubled souls seek rest. Allow me to aid [mana/] you...\""

msgid "STORY_EVENT@991_6580@TITLE"
msgstr "Gilded Wastes: Phantasmal Sorrows"

msgid "STORY_EVENT@991_6581@BODY_FOOTER"
msgstr "\"I am opening the path to {EventGiantKing} and <<o:EventGiantKing>> treasury. Slay the accursed, {PlayerLeader}, fulfill our revenge!\""

msgid "STORY_EVENT@991_6581@BODY_HEADER"
msgstr "You have taken many of the Gilded Waste's treasures. The phantasm hero comes before you, calm at last."

msgid "STORY_EVENT@991_6581@BODY_LORE"
msgstr "\"Perhaps,\" <<p:EventHero>> says, half to <<r:EventHero>>, \"this is not a moment of bane but of fortune. When the {GLOBAL.ArchonsLoreConcept.Hyperlink} rode to justice and {EventGiantKing} foresaw <<o:EventGiantKing>> doom, <<p:EventGiantKing>> hid <<o:EventGiantKing>> soul inside a grail powering a {EventUnit}. There <<p:EventGiantKing>> survived the fall of {GLOBAL.MyrridaLoreConcept.Hyperlink}, and though we locked <<P:EventGiantKing>> inside <<o:EventGiantKing>> own treasury we could never complete our vengeance as <<o:EventGiantKing>> powers are beyond our own.\""

msgid "STORY_EVENT@991_6581@BUTTON_0"
msgstr "\"This {EventGiantKing} will be no match for us!\" [influence/]"

msgid "STORY_EVENT@991_6581@BUTTON_1"
msgstr "\"I accept your calling, but your phantasms [unit/] will join me in battle.\""

msgid "STORY_EVENT@991_6581@TITLE"
msgstr "Gilded Wastes: Phantasmal Vengeance"

msgid "STORY_EVENT@991_6584@BODY_HEADER@CALMED_PHANTASM"
msgstr "Your actions have calmed the phantasm hero. <<Cp:EventHero>> seems to be able to see past <<o:EventHero>> rage again."

msgid "STORY_EVENT@991_6591@BODY_FOOTER"
msgstr "The phantasm bows to you, before it leaves: \"The Gilded Wastes are yours now, {PlayerLeader.TitleName}.\""

msgid "STORY_EVENT@991_6591@BODY_HEADER"
msgstr "With an earsplitting noise the {EventUnit} collapses at the feet of your troops. The leader of the phantasms appears, the gilded core containing <<ge:soul^n,EventGiantKing>> in <<o:EventHero>> hands."

msgid "STORY_EVENT@991_6591@BODY_LORE"
msgstr "\"It is done,\" <<p:EventHero>> says, staring in disbelief at the gleaming artifact. \"You relieved us from our curse. At last, the souls of the {EventRace} can rest in peace.\" The phantasm hero hands you the {EventRelic}. \"Take it. You will know how to destroy or contain {EventGiantKing}.\" As you touch the trinket, you can sense great power, but also—disruption! This is no integral soul dwelling inside the {EventRelic}. It is a fragment, a wretched memorial to the vain pursuit of immortality."

msgid "STORY_EVENT@991_6591@BUTTON_0"
msgstr "\"I claim these lands to renew the splendor [influence/] of ancient Myrrida.\""

msgid "STORY_EVENT@991_6591@BUTTON_1"
msgstr "\"We will not rest until each coin [gold/] left in those mines is ours.\""

msgid "STORY_EVENT@991_6591@BUTTON_3"
msgstr "\"The mysteries uncovered here, I gift to the {GLOBAL.EternalSagesLoreConcept.Name}.\" [allegiance/]"

msgid "STORY_EVENT@991_6591@TITLE"
msgstr "Gilded Wastes: Aftermath"

msgid "STORY_EVENT@991_6672@BODY_FOOTER"
msgstr "The flows within the barrier are overwhelming your astral senses, making it impossible to descry what is lying inside."

msgid "STORY_EVENT@991_6672@BODY_HEADER"
msgstr "Nearing the eye of the storm, your troops find their path blocked by an impenetrable vortex barrier."

msgid "STORY_EVENT@991_6672@BODY_LORE"
msgstr "Here, the astral discharges are charged up to a maximum—sending anyone through the barrier would amount to a death sentence. Within the barrier the shape of something enormous can be glimpsed, like a titan kept in stasis by the maelstrom around."

msgid "STORY_EVENT@991_6672@BUTTON_0"
msgstr "\"We will retreat, for now.\""

msgid "STORY_EVENT@991_6672@TITLE"
msgstr "Crystalstorm Plateau: Storm Barrier"

msgid "STORY_EVENT@991_6690@BODY_FOOTER"
msgstr "The crystal storm entices you, seizing your attention. Yet how will you protect your troops from the dangers lying ahead?"

msgid "STORY_EVENT@991_6690@BODY_HEADER"
msgstr "At the top of the mountain slopes {EventDirection} {EventCity} your troops find themselves in an elevated area sizzling with astral energy."

msgid "STORY_EVENT@991_6690@BODY_LORE"
msgstr "Bizarre crystalline formations are spread throughout the region, some growing from the ground, others kept in levitation by the shearing forces of the storm raging at the center of the plateau. In the distance, an abundance of Lithorine creatures can be seen roaming the landscape. Whether they were attracted by the crystals, created them, or protect them is uncertain."

msgid "STORY_EVENT@991_6690@BUTTON_0"
msgstr "Cast upon them [mana/] a spell of warding [resistance/]."

msgid "STORY_EVENT@991_6690@BUTTON_1"
msgstr "Order them to ground themselves [defenselightning/] at the expense of a slower [movementwalk/] advance."

msgid "STORY_EVENT@991_6690@BUTTON_3"
msgstr "The troops will manage without your direct support."

msgid "STORY_EVENT@991_6690@TITLE"
msgstr "Climbing the Crystalstorm Plateau"

msgid "STORY_EVENT@991_6740@BODY_FOOTER"
msgstr "\"Bring crystal cores of Lithorine,\" the {EventUnit} concludes, \"and I shatter ward.\""

msgid "STORY_EVENT@991_6740@BODY_HEADER"
msgstr "As your troops step away from the storm barrier, they are approached by a {EventUnit} signaling <<o:EventUnit>> peaceful intentions."

msgid "STORY_EVENT@991_6740@BODY_LORE"
msgstr "\"Strong magic of the <<m:{GLOBAL.GiantKingLoreConcept.Hyperlink}>>,\" the {EventUnit} calls out, \"many runestones buried beneath mighty realm.\" <<Cp:EventUnit>> reaches under <<o:EventUnit>> shabby cloak to reveal a polished orb, bearing semblance to the seeing stones of the Godir. \"See past. See future. Can destroy spell of giant kin—Hastefolk pay prize.\""

msgid "STORY_EVENT@991_6740@BUTTON_0"
msgstr "Accept the deal of the {EventUnit}."

msgid "STORY_EVENT@991_6740@BUTTON_1"
msgstr "Overwhelm the {EventUnit} to make <<P:EventUnit>> break the barrier by force."

msgid "STORY_EVENT@991_6740@TITLE"
msgstr "Crystalstorm Plateau: Runestones of the Past"

msgid "STORY_EVENT@991_6837@BODY_FOOTER"
msgstr "\"Whatever the {GLOBAL.FireClanLoreConcept.Hyperlink} intends to do with the caged beasts, it cannot be good,\" the druid concludes. \"You free them, we all win, right?\""

msgid "STORY_EVENT@991_6837@BODY_HEADER"
msgstr "Entering a fiery cavern {EventDirection} {EventCity}, your troops hear the hushed shouts of a <<EventHero{man/woman}>>, desperate to draw their attention."

msgid "STORY_EVENT@991_6837@BODY_LORE"
msgstr "\"Shush—over here!\" As your {EventStackLeader} approaches the <<EventHero{man/woman}>> clad in druid's clothing, <<p:EventHero>> stares at <<P:EventStackLeader>> in disbelief, but does not recede. \"See the large figures down at the fissures? Those are {GLOBAL.FireClanLoreConcept.Hyperlink} grunts,\" <<p:EventHero>> whispers. \"They have captured the beasts of the land, badgering them in cages, brutalizing them for combat.\" The druid anxiously bites <<o:EventHero>> nails. \"I... cannot bear this any longer. This maltreatment must end!\""

msgid "STORY_EVENT@991_6837@BODY_LORE@RULER_STACK_LEAD"
msgstr "\"Shush—over here!\" As you approach the <<EventHero{man/woman}>> clad in druid's clothing, <<p:EventHero>> stares at you in disbelief, but does not recede. \"See the large figures down at the fissures? Those are {GLOBAL.FireClanLoreConcept.Hyperlink} grunts,\" <<p:EventHero>> whispers. \"They have captured the beasts of the land, badgering them in cages, brutalizing them for combat.\" The druid anxiously bites <<o:EventHero>> nails. \"I... cannot bear this any longer. This maltreatment must end!\""

msgid "STORY_EVENT@991_6837@BUTTON_0"
msgstr "\"Fine. We will take care of the {GLOBAL.FireClanLoreConcept.Name}.\""

msgid "STORY_EVENT@991_6837@BUTTON_1"
msgstr "\"I feel your sorrows. Those poor creatures must be freed!\" [goodact/]"

msgid "STORY_EVENT@991_6837@BUTTON_3"
msgstr "\"Once chained to my lash, those war beasts will be free... to kill!\" [evilact/]"

msgid "STORY_EVENT@991_6837@TITLE"
msgstr "Discovering the Molten Scar"

msgid "STORY_EVENT@991_6850@BODY_FOOTER"
msgstr "The {EventStackLeader} and <<o:EventStackLeader>> {GLOBAL.FireClanLoreConcept.Hyperlink} fighters are closing in on your troops. How do you order your army to engage them?"

msgid "STORY_EVENT@991_6850@BODY_HEADER"
msgstr "Carefully taming the caged {EventUnit}, your troops are taken by surprise as they become surrounded by the war cries of the {GLOBAL.FireClanLoreConcept.Hyperlink}."

msgid "STORY_EVENT@991_6850@BODY_HEADER@CHAINED_CREATURE"
msgstr "Binding the \"freed\" {EventUnit} with a chained necklace, your troops are taken by surprise as they become surrounded by the war cries of the {GLOBAL.FireClanLoreConcept.Hyperlink}."

msgid "STORY_EVENT@991_6850@BODY_HEADER@FREED_CREATURE"
msgstr "Watching the unpent {EventUnit} escape into the wilds, your troops are taken by surprise as they become surrounded by the war cries of the {GLOBAL.FireClanLoreConcept.Hyperlink}."

msgid "STORY_EVENT@991_6850@BODY_LORE"
msgstr "Led by a {EventStackLeader}, the brutes of the {GLOBAL.FireClanLoreConcept.Hyperlink} encircle your army, blocking any paths of retreat. \"Who thinks can steal from giant clan? Free beasts? Break chains?\" they shout, baring their hideous teeth. \"Now Hastefolk put in cage. Squeak and twitch! When {EventBeastName} wakens, Hastefolk become fodder.\""

msgid "STORY_EVENT@991_6850@BODY_LORE@SECOND_EVENT"
msgstr "The {GLOBAL.FireClanLoreConcept.Hyperlink} brutes almost sound desperate, seeing that you cross their plans one by one. \"Shoo, pesky Hastefolk! Beasts trained for war. When {EventBeastName} sees, joins mighty {GLOBAL.FireClanLoreConcept.Hyperlink}.\" They mount an enormous cauldron on a hastily lit bonfire. \"Tonight we eat'za Hastefolk stew!\""

msgid "STORY_EVENT@991_6850@BUTTON_0"
msgstr "Let them engage the attackers without giving special orders."

msgid "STORY_EVENT@991_6850@BUTTON_1"
msgstr "Tell the troops to rush at the enemy [movementwalk/], exposing their own flanks [armor/]."

msgid "STORY_EVENT@991_6850@BUTTON_2"
msgstr "Make them stay in a tight formation [armor/], sacrificing their own mobility [movementwalk/]."

msgid "STORY_EVENT@991_6850@BUTTON_3"
msgstr "Summon [mana/] a body of water above them, to protect them [defensefire/] from fiery attacks."

msgid "STORY_EVENT@991_6850@TITLE"
msgstr "Molten Scar: {GLOBAL.FireClanLoreConcept.Name} Ambush!"

msgid "STORY_EVENT@991_6852@BODY_FOOTER"
msgstr "\"While scouting the region I learned of all the cages the {GLOBAL.FireClanLoreConcept.Hyperlink} set up,\" {EventHero} concludes. \"Here, let me show you...\""

msgid "STORY_EVENT@991_6852@BODY_FOOTER@CHAINED_CREATURE"
msgstr "\"As a wildspeaker I know all life is sacred,\" {EventHero} concludes, \"but seeing your brutish actions, I feel doubt in my heart.\""

msgid "STORY_EVENT@991_6852@BODY_HEADER"
msgstr "While your troops tend to the caged {EventUnit}, the druid from the cavern entrance returns to talk."

msgid "STORY_EVENT@991_6852@BODY_HEADER@CHAINED_CREATURE"
msgstr "As your troops grimly enchain the {EventUnit}, the druid from the cavern entrance returns, full of bitterness."

msgid "STORY_EVENT@991_6852@BODY_HEADER@FREED_CREATURE"
msgstr "As your troops carefully set the {EventUnit} free, the druid from the cavern entrance returns, overjoyed."

msgid "STORY_EVENT@991_6852@BODY_LORE"
msgstr "\"It is good to see people handling their animals with respect,\" <<p:EventHero>> says, showing a smile. \"I am {EventHero}, wildspeaker and veteran adventurer enlisted in the {GLOBAL.ColtLoreConcept.Hyperlink}. When I heard of an uncovered map that would lead to the Molten Scar, I knew the path that was laid out for me...\""

msgid "STORY_EVENT@991_6852@BODY_LORE@CHAINED_CREATURE"
msgstr "\"This display of violence is infuriating!\" <<p:EventHero>> shouts, clearly dismayed. \"I am {EventHero}, wildspeaker and veteran adventurer enlisted in the {GLOBAL.ColtLoreConcept.Hyperlink}. When I heard of an uncovered map that would lead to the Molten Scar, I knew the path that was laid out for me...\""

msgid "STORY_EVENT@991_6852@BODY_LORE@FREED_CREATURE"
msgstr "\"It is clear that the blessing of nature runs within your veins,\" <<p:EventHero>> says with a hearty smile. \"I am {EventHero}, wildspeaker and veteran adventurer enlisted in the {GLOBAL.ColtLoreConcept.Hyperlink}. When I heard of an uncovered map that would lead to the Molten Scar, I knew the path that was laid out for me...\""

msgid "STORY_EVENT@991_6852@BUTTON_0"
msgstr "Learn the locations of the remaining cages."

msgid "STORY_EVENT@991_6852@BUTTON_1"
msgstr "Let the fool babble. <<Cp:EventHero>> might still be of use."

msgid "STORY_EVENT@991_6852@TITLE"
msgstr "Molten Scar: A Formal Introduction"

msgid "STORY_EVENT@991_6853@BODY_FOOTER"
msgstr "The Flowrock key revealed to you a {EventStructure}. Without doubt, this is where the {GLOBAL.FireClanLoreConcept.Hyperlink} and \"their\" {EventBeastName} are to be found."

msgid "STORY_EVENT@991_6853@BODY_HEADER"
msgstr "To the surprise of your troops, there is no creature to be found in the last opened cage, but a large block of Flowrock."

msgid "STORY_EVENT@991_6853@BODY_LORE"
msgstr "As your soldiers touch the block, the Flowrock shifts into the shape of an enormous key—without a doubt a work of ancient giant magic. The key seems to register your {GLOBAL.GodirLoreConcept.Hyperlink} powers. It calls to you, drags your attention to the {EventDirection} the Molten Scar. You see a dungeon island amidst boiling lava, chains leading to darkest prison depths... until you hear the echo of a primal scream."

msgid "STORY_EVENT@991_6853@BUTTON_0"
msgstr "Send out one of your heroes to face the dangers of the {EventStructure}."

msgid "STORY_EVENT@991_6853@TITLE"
msgstr "Molten Scar: Caged Visions"

msgid "STORY_EVENT@991_6905@BODY_FOOTER"
msgstr "\"I feel that the {GLOBAL.FireClanLoreConcept.Hyperlink} must know about the myth of {EventBeastName},\" {EventHero} ends <<o:EventHero>> speech. \"If only I... I mean, their presence here can't be a coincidence!\""

msgid "STORY_EVENT@991_6905@BODY_FOOTER@CHAINED_CREATURE"
msgstr "\"If {EventBeastName} was still around,\" {EventHero} ends <<o:EventHero>> speech with morbid glee, \"it would surely avenge your sins against nature.\""

msgid "STORY_EVENT@991_6905@BODY_HEADER"
msgstr "While your troops tend to the caged {EventUnit}, {EventHero} returns to talk."

msgid "STORY_EVENT@991_6905@BODY_HEADER@CHAINED_CREATURE"
msgstr "As your troops grimly enchain the {EventUnit}, {EventHero} returns, full of bitterness."

msgid "STORY_EVENT@991_6905@BODY_HEADER@FREED_CREATURE"
msgstr "As your troops carefully set the {EventUnit} free, {EventHero} returns, overjoyed."

msgid "STORY_EVENT@991_6905@BODY_LORE"
msgstr "\"To those versed in the lore of the land, the Molten Scar is a place of legend,\" <<p:EventHero>> begins to narrate. \"It is said that [hyperlink,GLOBAL.UrwildernessLoreConcept]in the days of the Great Hunt[/hyperlink], when the [hyperlink,GLOBAL.GiantKingLoreConcept]Elder Giants[/hyperlink] fought the Primordial Beasts, a {PrimordialUnit} called {EventBeastName} dwelt in this region. When {EventBeastName} clashed with the giant hunters, their mighty blows split the earth, pouring boiling magma from the depths of this world; the forming chasms a memorial, for eternity.\""

msgid "STORY_EVENT@991_6905@BUTTON_0"
msgstr "Thank {EventHero} for <<o:EventHero>> insights."

msgid "STORY_EVENT@991_6905@BUTTON_1"
msgstr "The time for {EventHero} has not come... just yet."

msgid "STORY_EVENT@991_6905@TITLE"
msgstr "Molten Scar: Primordial Myths"

msgid "STORY_EVENT@991_6921@BODY_FOOTER"
msgstr "\"I had aeons to bear a grudge,\" {DruidHero} squeals, while large compound eyes light up in the darkness above. \"Now I must feed, and feed I shall!\""

msgid "STORY_EVENT@991_6921@BODY_FOOTER@APE"
msgstr "\"I had aeons to bear a grudge,\" {DruidHero} screams, while the mighty figure of {EventBeastName} comes into focus. \"Now I must feed, and feed I shall!\""

msgid "STORY_EVENT@991_6921@BODY_FOOTER@ENTRY_BLOCKED"
msgstr "There appears to be no way to cross the lava and enter the {EventStructure}."

msgid "STORY_EVENT@991_6921@BODY_FOOTER@SERPENT"
msgstr "\"I had aeons to bear a grudge,\" {DruidHero} screams, while the sound of an enormous body slithering down the pillars can be heard from above. \"Now I must feed, and feed I shall!\""

msgid "STORY_EVENT@991_6921@BODY_HEADER"
msgstr "When your troops reach the brim of the lava lake, the Flowrock key shifts into a razer-thin slope, forming a bridge to the {EventStructure} in the middle."

msgid "STORY_EVENT@991_6921@BODY_HEADER@ENTRY_BLOCKED"
msgstr "Temperatures are rising to a maximum, as your troops reach the searing brim of a lava lake."

msgid "STORY_EVENT@991_6921@BODY_LORE"
msgstr "Once inside, the unworldly squeal of {EventBeastName} can be heard. Large corridors, spun into moth web tunnels, lead to the hall in which the {PrimordialUnit} was imprisoned. Now, the celestial chains lie broken on the ground, at the feet of the triumphant {GLOBAL.FireClanLoreConcept.Hyperlink}.[br/][br/]Suddenly a strangely familiar voice begins to speak: \"It is unusual for prey,\" it says, \"to come freely to its own engulfment. Yet freely <<p:DruidHero>> came, seeking to soothe my rage. WHEN NEVER NATURE KNEW GREATER WRATH!\" Violently shouting, {DruidHero} leaps out of the shadows, <<o:DruidHero>> face expressionless and <<o:DruidHero>> eyes filled with <<ge:fire^n,EventBeastName>>!"

msgid "STORY_EVENT@991_6921@BODY_LORE@APE"
msgstr "Once inside, the drum-like chest beating of {EventBeastName} can be heard. Large corridors, tangled with sprouting lianas, lead to the hall in which the {PrimordialUnit} was imprisoned. Now, the celestial chains lie broken on the ground, at the feet of the triumphant {GLOBAL.FireClanLoreConcept.Hyperlink}.[br/][br/]Suddenly a strangely familiar voice begins to talk: \"It is unusual for prey,\" it says, \"to come freely to its own engulfment. Yet freely <<p:DruidHero>> came, seeking to soothe my rage. WHEN NEVER NATURE KNEW GREATER WRATH!\" Violently shouting, {DruidHero} leaps out of the shadows, <<o:DruidHero>> face expressionless and <<o:DruidHero>> eyes filled with <<ge:fury^n,EventBeastName>>!"

msgid "STORY_EVENT@991_6921@BODY_LORE@ENTRY_BLOCKED"
msgstr "In the distance, a large fortress towers within the lava. It appears almost like a mirage, for who would build a fortress in such inhospitable place without bridge or door to enter it?"

msgid "STORY_EVENT@991_6921@BODY_LORE@NO_RULER"
msgstr "Once inside, the unworldly squeal of {EventBeastName} can be heard. Large corridors, spun into moth web tunnels, lead to the hall in which the {PrimordialUnit} was imprisoned. Now, the celestial chains lie broken on the ground, at the feet of the triumphant {GLOBAL.FireClanLoreConcept.Hyperlink}.[br/][br/]Suddenly a strangely familiar voice begins to speak: \"It is unusual for prey,\" it says, \"to come freely to its own engulfment. Yet freely <<p:DruidHero>> came, seeking to soothe my rage. WHEN NEVER NATURE KNEW GREATER WRATH!\" Violently shouting, {DruidHero} leaps out of the shadows, <<o:DruidHero>> face expressionless and <<o:DruidHero>> eyes filled with <<ge:fire^n,EventBeastName>>!"

msgid "STORY_EVENT@991_6921@BODY_LORE@SERPENT"
msgstr "Once inside, the eerie hissing of {EventBeastName} can be heard. Large corridors, crawling with hatched snakelets, lead to the hall in which the {PrimordialUnit} was imprisoned. Now, the celestial chains lie broken on the ground, at the feet of the triumphant {GLOBAL.FireClanLoreConcept.Hyperlink}.[br/][br/]Suddenly a strangely familiar voice begins to talk: \"It is unusual for prey,\" it says, \"to come freely to its own engulfment. Yet freely <<p:DruidHero>> came, seeking to soothe my rage. WHEN NEVER NATURE KNEW GREATER WRATH!\" Violently shouting, {DruidHero} leaps out of the shadows, <<o:DruidHero>> face expressionless and <<o:DruidHero>> eyes filled with <<ge:venom^n,EventBeastName>>!"

msgid "STORY_EVENT@991_6921@BUTTON_0"
msgstr "Attack the {GLOBAL.FireClanLoreConcept.Name}, {DruidHero} and the terrible {EventBeastName}!"

msgid "STORY_EVENT@991_6921@BUTTON_1"
msgstr "Gain the blessing of Giants [mana/] and let the Great Hunt commence once more!"

msgid "STORY_EVENT@991_6921@BUTTON_2"
msgstr "Leave, for now."

msgid "STORY_EVENT@991_6921@TITLE"
msgstr "Molten Scar: A Moth Unchained"

msgid "STORY_EVENT@991_6921@TITLE@APE"
msgstr "Molten Scar: An Ape Unchained"

msgid "STORY_EVENT@991_6921@TITLE@ENTRY_BLOCKED"
msgstr "Molten Scar: The {EventStructure}"

msgid "STORY_EVENT@991_6921@TITLE@SERPENT"
msgstr "Molten Scar: A Serpent Unchained"

msgid "STORY_EVENT@991_6922@BODY_FOOTER"
msgstr "\"You have saved this world from {EventBeastName}, {PlayerLeader},\" {DruidHero} ends. \"The {EventRelic} the Giants invoked to liberate the beast is yours—and my fate in your hands.\""

msgid "STORY_EVENT@991_6922@BODY_HEADER"
msgstr "With the mighty {EventBeastName} subdued and returned to its chains, {DruidHero} comes to <<o:DruidHero>> senses again."

msgid "STORY_EVENT@991_6922@BODY_LORE"
msgstr "\"What... what have I done?\" <<p:DruidHero>> calls out in dismay, looking at <<o:DruidHero>> hands, still searing with primordial fire. \"I thought I could bond with {EventBeastName}, amend what the Great Hunt had afflicted in the creature I called noble. Instead I found burning hatred, incinerating my beliefs within moments. I was defenseless. If the {GLOBAL.FireClanLoreConcept.Hyperlink} unleashed {EventBeastName}, its primal wrath would have devoured the realms...\""

msgid "STORY_EVENT@991_6922@BODY_LORE@APE"
msgstr "\"What... what have I done?\" <<p:DruidHero>> calls out in dismay, looking at <<o:DruidHero>> hands, still pulsing with primordial fury. \"I thought I could bond with {EventBeastName}, amend what the Great Hunt had afflicted in the creature I called noble. Instead I found unbounded hatred, crushing my beliefs within moments. I was defenseless. If the {GLOBAL.FireClanLoreConcept.Hyperlink} unleashed {EventBeastName}, its primal wrath would have devoured the realms...\""

msgid "STORY_EVENT@991_6922@BODY_LORE@SERPENT"
msgstr "\"What... what have I done?\" <<p:DruidHero>> calls out in dismay, looking at <<o:DruidHero>> hands, still dripping with primordial poison. \"I thought I could bond with {EventBeastName}, amend what the Great Hunt had afflicted in the creature I called noble. Instead I found venomous hatred, corroding my beliefs within moments. I was defenseless. If the {GLOBAL.FireClanLoreConcept.Hyperlink} unleashed {EventBeastName}, its primal wrath would have devoured the realms...\""

msgid "STORY_EVENT@991_6922@BUTTON_0"
msgstr "\"A <<DruidHero{man/woman}>> with your talents is welcome [unitHero/] in my army.\""

msgid "STORY_EVENT@991_6922@BUTTON_1"
msgstr "\"Your compassion with the creatures of the land [natureboon/] is inspiring. Do not abandon this path!\" [goodact/]"

msgid "STORY_EVENT@991_6922@BUTTON_2"
msgstr "\"I shall consume you and the powers [xp/] you leeched from {EventBeastName}!\" [evilact/]"

msgid "STORY_EVENT@991_6922@BUTTON_3"
msgstr "\"You will be a valuable asset to extort [gold/] the {GLOBAL.ColtLoreConcept.Name}.\""

msgid "STORY_EVENT@991_6922@BUTTON_4"
msgstr "\"Use your powers as a wildspeaker to bolster my ranks [unit/]!\""

msgid "STORY_EVENT@991_6922@TITLE"
msgstr "Molten Scar: Aftermath"

msgid "STORY_EVENT@991_6954@BODY_FOOTER"
msgstr "\"The Creator watches over these halls,\" the {EventUnit} concludes. \"Solve its enigmas and you can carve out your own reward. Seek bloodshed, however, and that too you will find.\""

msgid "STORY_EVENT@991_6954@BODY_HEADER"
msgstr "Climbing down pristine stairs hewn into stone, your troops find their path blocked by a {EventUnit}, towering at a large hall's entrance."

msgid "STORY_EVENT@991_6954@BODY_LORE"
msgstr "\"Halt,\" the {EventUnit} says slowly, <<o:EventUnit>> voice echoing from the walls. \"Halt, foreigners, before you enter the hallowed halls of the {GLOBAL.StoneClanLoreConcept.Hyperlink}. Here, we ponder the enigmas of the material world. Unlike the other clans, we seek no quarrel with the Hastefolk. We create.\" Indeed the chambers stretching out behind the {EventUnit} are not ruined like other remnants of old {GLOBAL.MyrridaLoreConcept.Hyperlink}. They are built anew, a monument to the raw potential still dwelling within the Giant kin."

msgid "STORY_EVENT@991_6954@BUTTON_0"
msgstr "Enter the Hall of Enigmas."

msgid "STORY_EVENT@991_6954@TITLE"
msgstr "Entering the Hall of Enigmas"

msgid "STORY_EVENT@991_6955@BODY_FOOTER"
msgstr "\"For long none were worthy of even a flask. If I were your servant, what would be my task?\""

msgid "STORY_EVENT@991_6955@BODY_FOOTER@ENIGMA_SOLVED"
msgstr "You already answered this enigma. Go to the other chambers to continue the trial."

msgid "STORY_EVENT@991_6955@BODY_HEADER"
msgstr "At the heart of this chamber, a Flowrock fountain sputters earth and stone. As your troops come close, it shifts into a {EventStackLeader} and begins to speak:"

msgid "STORY_EVENT@991_6955@BODY_HEADER@ENIGMA_SOLVED"
msgstr "Your troops return to the {EventStackLeader} at the center of this chamber."

msgid "STORY_EVENT@991_6955@BODY_LORE"
msgstr "\"[hyperlink,GLOBAL.GiantKingLoreConcept]The Giants[/hyperlink] granted me sinew and bone.[br/]Am I a liquid or am I a stone?[br/]{GLOBAL.MyrridaLoreConcept.Hyperlink} I raised, halls and towers, sublime.[br/]My walls unaffected by the ravages of time.[br/]Withstood Dragon fire, withstood Archon wrath.[br/]Yet lost were my masters on their ill-fated path.\""

msgid "STORY_EVENT@991_6955@BODY_LORE@ENIGMA_SOLVED"
msgstr "The {EventStackLeader} stays silent, as if <<p:EventStackLeader>> is still pondering the answers you gave."

msgid "STORY_EVENT@991_6955@BUTTON_0"
msgstr "Do not answer the {EventStackLeader}, for now."

msgid "STORY_EVENT@991_6955@BUTTON_0@ENIGMA_SOLVED"
msgstr "Leave."

msgid "STORY_EVENT@991_6955@BUTTON_1"
msgstr "\"To rise as elementals, invulnerable warriors of rock!\""

msgid "STORY_EVENT@991_6955@BUTTON_2"
msgstr "\"To build walls high and mighty [structureprod/], a new empire's core.\""

msgid "STORY_EVENT@991_6955@BUTTON_3"
msgstr "\"To erect monuments [influence/] for the aeons to behold!\""

msgid "STORY_EVENT@991_6955@BUTTON_4"
msgstr "\"To engrave the world's wisdom [knowledge/] in tomes of stone.\""

msgid "STORY_EVENT@991_6955@TITLE"
msgstr "Hall of Enigmas: Visions of Flowrock"

msgid "STORY_EVENT@991_6956@BODY_FOOTER"
msgstr "\"We did all their bidding, yet their hearts sank in mist. They sought life and saw failure. Say: when does life exist?\""

msgid "STORY_EVENT@991_6956@BODY_FOOTER@ENIGMA_SOLVED"
msgstr "You already answered this enigma. Go to the other chambers to continue the trial."

msgid "STORY_EVENT@991_6956@BODY_HEADER"
msgstr "In this chamber clinking with crystalline energies, your troops are greeted by a {EventStackLeader}:"

msgid "STORY_EVENT@991_6956@BODY_HEADER@ENIGMA_SOLVED"
msgstr "Your troops return to the {EventStackLeader} at the center of this chamber."

msgid "STORY_EVENT@991_6956@BODY_LORE"
msgstr "\"We were gemstones of the earth, lucent and tall.[br/]The <<m:{GLOBAL.GiantKingLoreConcept.Hyperlink}>> mined us and lighted their halls.[br/]Forged us into weapons, ground, and smelted each day.[br/]They were the sculptors, and we were the clay.[br/]At last they imbued us with faces and soul.[br/]We were wondrous and wondering and foreign to all.\""

msgid "STORY_EVENT@991_6956@BODY_LORE@ENIGMA_SOLVED"
msgstr "The {EventStackLeader} stays silent, as if <<p:EventStackLeader>> is still pondering the answers you gave."

msgid "STORY_EVENT@991_6956@BUTTON_0"
msgstr "Do not answer the {EventStackLeader}, for now."

msgid "STORY_EVENT@991_6956@BUTTON_0@ENIGMA_SOLVED"
msgstr "Leave."

msgid "STORY_EVENT@991_6956@BUTTON_1"
msgstr "\"Alive is he who fights for survival!\""

msgid "STORY_EVENT@991_6956@BUTTON_2"
msgstr "\"All the living must feed [food/] and sprout.\""

msgid "STORY_EVENT@991_6956@BUTTON_3"
msgstr "\"Life is the magic spark [mana/] that kindles our souls.\""

msgid "STORY_EVENT@991_6956@BUTTON_4"
msgstr "\"As Godir [influence/] we grant life to whatever we desire.\""

msgid "STORY_EVENT@991_6956@TITLE"
msgstr "Hall of Enigmas: Visions of Lithorite"

msgid "STORY_EVENT@991_6957@BODY_FOOTER"
msgstr "\"The essence they bound fuels the forges to this date. Yet which item is the most worthy to make?\""

msgid "STORY_EVENT@991_6957@BODY_FOOTER@ENIGMA_SOLVED"
msgstr "You already answered this enigma. Go to the other chambers to continue the trial."

msgid "STORY_EVENT@991_6957@BODY_HEADER"
msgstr "Between two mighty pillars, a lone {EventStackLeader} awaits your troops in this chamber. It speaks with a tinny voice:"

msgid "STORY_EVENT@991_6957@BODY_HEADER@ENIGMA_SOLVED"
msgstr "Your troops return to the {EventStackLeader} at the center of this chamber."

msgid "STORY_EVENT@991_6957@BODY_LORE"
msgstr "\"Rich are the elements beneath the earth's shade.[br/]Rich who distills their purity grade.[br/]The <<m:{GLOBAL.GiantKingLoreConcept.Hyperlink}>> gifted like none were before[br/]Refined and bound the material core.[br/]Forgemasters, mages, and anvil in one[br/]They fashioned marvels that rivaled the sun.\""

msgid "STORY_EVENT@991_6957@BODY_LORE@ENIGMA_SOLVED"
msgstr "The {EventStackLeader} stays silent, as if <<p:EventStackLeader>> is still pondering the answers you gave."

msgid "STORY_EVENT@991_6957@BUTTON_0"
msgstr "Do not answer the {EventStackLeader}, for now."

msgid "STORY_EVENT@991_6957@BUTTON_0@ENIGMA_SOLVED"
msgstr "Leave."

msgid "STORY_EVENT@991_6957@BUTTON_1"
msgstr "\"The sword that cuts through enemy lines!\""

msgid "STORY_EVENT@991_6957@BUTTON_2"
msgstr "\"The ring that binds all [influence/] to my will!\""

msgid "STORY_EVENT@991_6957@BUTTON_3"
msgstr "\"The forging hammer [bindingessence/] that enhances all future creations.\""

msgid "STORY_EVENT@991_6957@BUTTON_4"
msgstr "\"The scrying orb [mana/] that lets me glimpse both future and past.\""

msgid "STORY_EVENT@991_6957@TITLE"
msgstr "Hall of Enigmas: Binding Visions"

msgid "STORY_EVENT@991_6989@BODY_FOOTER"
msgstr "The {EventStackLeader} begins to talk: \"I observed, {PlayerLeader}. I know your convictions.\""

msgid "STORY_EVENT@991_6989@BODY_HEADER"
msgstr "As your troops return to the center chamber, immovable energies weigh on you like a mountain, threatening to slowly crush all your senses."

msgid "STORY_EVENT@991_6989@BODY_LORE"
msgstr "Despite this fundamental clutch, you feel invigorated, inspired to create, build, shape what no {GLOBAL.GodirLoreConcept.Hyperlink} has devised before...! Then you notice the entity observing you, giving itself the guise of a {EventStackLeader}. Yet, you instinctively know its true form is much larger. Insurmountable. Encompassing the cosmos. This Creator worshiped by the {GLOBAL.StoneClanLoreConcept.Hyperlink}, could it be the {GLOBAL.EndailonLoreConcept.Hyperlink} of Materium?"

msgid "STORY_EVENT@991_6989@BUTTON_0"
msgstr "Flee the grasp of the Creator."

msgid "STORY_EVENT@991_6989@BUTTON_1"
msgstr "\"I am the earthquake that crumbles the world.\""

msgid "STORY_EVENT@991_6989@BUTTON_2"
msgstr "\"I am the builder [structureprod/], raising cities and walls.\""

msgid "STORY_EVENT@991_6989@BUTTON_3"
msgstr "\"I am the artisan [influence/] who perfects his work.\""

msgid "STORY_EVENT@991_6989@BUTTON_4"
msgstr "\"I am the architect [knowledge/] of civilizations to last.\""

msgid "STORY_EVENT@991_6989@TITLE"
msgstr "Hall of Enigmas: Visions of the Creator"

msgid "STORY_EVENT@991_7003@BODY_FOOTER"
msgstr "\"You have earned the possession of these halls, {PlayerLeader},\" the Creator ends as his presence fades. \"Take the {EventRelic}. The {GLOBAL.StoneClanLoreConcept.Hyperlink} is a rough diamond. Refine or sell—I observe.\""

msgid "STORY_EVENT@991_7003@BODY_HEADER"
msgstr "The {EventStackLeader} nods. \"Constant creation is the purest material virtue. Yet without focus the creator may immure himself within a maze.\""

msgid "STORY_EVENT@991_7003@BODY_HEADER@AMBITION"
msgstr "The {EventStackLeader} nods. \"Immaculacy is the ideal of creation. Such ambitions can lead to eternity—or the void of an unfinishable task.\""

msgid "STORY_EVENT@991_7003@BODY_HEADER@DEVASTATION"
msgstr "The {EventStackLeader} nods. \"Destruction paves the way for creation. From devastation new civilizations can be born—or all turned to dust.\""

msgid "STORY_EVENT@991_7003@BODY_HEADER@WISDOM"
msgstr "The {EventStackLeader} nods. \"Only the connoisseur of the elements may employ them to their greatest effect. Unless the knowledge collects dust within a tome never put into practice.\""

msgid "STORY_EVENT@991_7003@BODY_LORE"
msgstr "\"The <<m:{GLOBAL.GiantKingLoreConcept.Hyperlink}>> were favored beyond comparison,\" the Creator continues. \"They shaped the realms, tamed the {GLOBAL.UrwildernessLoreConcept.Hyperlink}, championed the elements through might and through craft. Their kingdom, {GLOBAL.MyrridaLoreConcept.Hyperlink}, fanned the flames of civilization and their cosmic knowledge challenged even the {GLOBAL.ArchonsLoreConcept.Hyperlink}.\" The entity sighs like a mountain during a stormy night. \"They abandoned the path of creation. Though they lasted longer than any before or after.\""

msgid "STORY_EVENT@991_7003@BUTTON_0"
msgstr "Accept the gift of devastation. [unit/]"

msgid "STORY_EVENT@991_7003@BUTTON_3"
msgstr "Accept the gift of ambition. [mine/][quarry/][conduit/]"

msgid "STORY_EVENT@991_7003@BUTTON_4"
msgstr "Accept the gift of creation. [bindingessence/]"

msgid "STORY_EVENT@991_7003@BUTTON_5"
msgstr "Accept the gift of wisdom. [knowledge/]"

msgid "STORY_EVENT@991_7003@TITLE"
msgstr "Hall of Enigmas: Aftermath"

msgid "STORY_EVENT@991_7028@BODY_FOOTER"
msgstr "The {GLOBAL.StormClanLoreConcept.Hyperlink}, {GLOBAL.FireClanLoreConcept.Hyperlink}, and {GLOBAL.StoneClanLoreConcept.Hyperlink} regard you as the one to fulfill the Legend of Thagnokar and lead their clans to a war against the realm. Do you accept their fealty?"

msgid "STORY_EVENT@991_7028@BODY_HEADER"
msgstr "Studying the inscriptions on the Myrridan Menhirs you possess, you are interrupted by a delegation of the three major Giant clans."

msgid "STORY_EVENT@991_7028@BODY_LORE"
msgstr "The {StoneGiant} begins to speak: \"For long we have awaited the coming of one, who is like Thagnokar, the Enduring, who fell in defense of Titan's Henge.\"[br/][br/]\"One, who summons the storm that breaks the thrones of all Hastefolk,\" the {StormGiant} continues, \"and hews the cornerstone of a new {GLOBAL.MyrridaLoreConcept.Hyperlink}.\"[br/][br/]\"You wrested the {FireRelic}, {StormRelic}, and {StoneRelic} from our clans, {PlayerLeader.TitleName},\" the {FireGiant} concludes. \"You are the flame that can forge us into one. If only you ignite the spark...\""

msgid "STORY_EVENT@991_7028@BUTTON_0"
msgstr "\"The reign of the Giant kin shall be restored!\""

msgid "STORY_EVENT@991_7028@BUTTON_1"
msgstr "\"I cannot lead you to war. But I can grant your kin sanctuary within my realm.\""

msgid "STORY_EVENT@991_7028@BUTTON_2"
msgstr "\"Myrrida was built upon peace and equality, not bloodshed and slaughter!\" [influence/][goodact/]"

msgid "STORY_EVENT@991_7028@TITLE"
msgstr "Thagnokar's Heir: Introduction"

msgid "STORY_EVENT@991_7040@BODY_FOOTER"
msgstr "The Giant Clans are planning an assault upon the empires of this realm. How do you wish to prepare for their onslaught?"

msgid "STORY_EVENT@991_7040@BODY_HEADER"
msgstr "Alarming rumors are reaching your empire, speaking of rallying armies of Giants all across the realm."

msgid "STORY_EVENT@991_7040@BODY_LORE"
msgstr "Indeed the earth has been trembling ever so slightly and the clouds darkened with thunder, instilling not only the people of your own empire with fear. Everywhere the word is spreading that the different Giant Clans are invoking the name of Thagnokar's Heir, a leader that has risen to unite their clans and return them their rightful place above all smaller races."

msgid "STORY_EVENT@991_7040@BUTTON_0"
msgstr "Connect with the land [mana/] to discern their movements beneath the earth."

msgid "STORY_EVENT@991_7040@BUTTON_1"
msgstr "Send heralds [influence/] to muster anyone willing to defend [unitprod/] their homes."

msgid "STORY_EVENT@991_7040@BUTTON_2"
msgstr "\"We are well prepared to face any foe. Be it Demon, Dragon or Giant.\""

msgid "STORY_EVENT@991_7040@TITLE"
msgstr "Thagnokar's Heir: Growling Thunder"

msgid "STORY_EVENT@991_7042@BODY_FOOTER"
msgstr "The Giants and their monstrous troops are marching towards {EventCity}, determined to raze it to the ground."

msgid "STORY_EVENT@991_7042@BODY_HEADER"
msgstr "Tremors announce the invasion of the {EventClan} army, their leader, the dreaded {EventHero}, towering above the {EventGeo} {EventDirection} {EventCity}."

msgid "STORY_EVENT@991_7042@BODY_LORE"
msgstr "Even from a great distance the shouts of {EventHero} can be heard: \"The Age of the Hastefolk has reached its abrupt ending,\" <<p:EventHero>> declares, swinging <<o:EventHero>> {EventItem}. \"For Thagnokar's Heir, {EventPlayer.TitleName}, has returned our kin to unity. Now, we reclaim our rightful place as rulers of this realm!\""

msgid "STORY_EVENT@991_7042@BUTTON_0"
msgstr "\"{EventPlayer} will pay for this in time!\""

msgid "STORY_EVENT@991_7042@TITLE"
msgstr "Thagnokar's Heir: Attack on {EventCity}"

msgid "STORY_EVENT@991_7060@BODY_FOOTER"
msgstr "\"I am chosen to be your general in this war that ends all, {PlayerLeader.TitleName},\" {EventHero} concludes. \"Which clan army do you wish me to command?\""

msgid "STORY_EVENT@991_7060@BODY_HEADER"
msgstr "Tremors announce the invasions of the Giant Clans all throughout the realm. One of their leaders, {EventHero}, proudly approaches you."

msgid "STORY_EVENT@991_7060@BODY_LORE"
msgstr "\"So it begins, Heir of Thagnokar!\" <<p:EventHero>> says, pointing to a far distance invisible to you. \"We have raised armies worthy of even the mightiest {GLOBAL.GiantKingLoreConcept.Hyperlink}. Walls will be breached; thrones will be shattered; and our kin shall rise as lords from the ashes!\""

msgid "STORY_EVENT@991_7060@BUTTON_0"
msgstr "\"Lead the blazing legion [unit/] of the {GLOBAL.FireClanLoreConcept.Name}!\""

msgid "STORY_EVENT@991_7060@BUTTON_2"
msgstr "\"Field the sturdy troops [unit/] of the {GLOBAL.StoneClanLoreConcept.Name}!\""

msgid "STORY_EVENT@991_7060@BUTTON_3"
msgstr "\"Command the tempestuous hordes [unit/] unleashed by the {GLOBAL.StormClanLoreConcept.Name}!\""

msgid "STORY_EVENT@991_7060@TITLE"
msgstr "Thagnokar's Heir: The Clans Unleashed"

msgid "STORY_EVENT@991_7065@BODY_FOOTER"
msgstr "The battlefield abounds with the bodies and equipment of the {EventClan}. What do you order your troops to salvage in your name?"

msgid "STORY_EVENT@991_7065@BODY_HEADER"
msgstr "You have bested the {EventClan} and saved {EventCity}!"

msgid "STORY_EVENT@991_7065@BODY_HEADER@CITY_RAZED"
msgstr "You have bested the {EventClan}, though your empire will long mourn the destruction of {EventCity}."

msgid "STORY_EVENT@991_7065@BODY_LORE"
msgstr "The colossal corpses of the Giants and the churned earth still give testament to the momentous clash with the primal forces of the {EventClan}. They sought glory and destruction and they achieved it—twisted by fate into their own demise. For many generations to come the {EventRace} will remember this day when the Giants were felled at their doorsteps."

msgid "STORY_EVENT@991_7065@BUTTON_0"
msgstr "\"The weapons and armor to resmelt [bindingessence/] in the forges.\""

msgid "STORY_EVENT@991_7065@BUTTON_2"
msgstr "\"The primitive adornments of gold [gold/] and of gemstones.\""

msgid "STORY_EVENT@991_7065@BUTTON_3"
msgstr "\"The enchanted trinkets [item/], a sizable reward for my heroes.\""

msgid "STORY_EVENT@991_7065@BUTTON_4"
msgstr "\"Leaving their souls [souls/] untouched would be misplaced mercy...\""

msgid "STORY_EVENT@991_7065@TITLE"
msgstr "Thagnokar's Heir: Crumbling Giants"

msgid "STORY_EVENT@991_7111@BODY_FOOTER"
msgstr "Will you face the {EventStackLeader} to retrieve the {EventArtifact} for the Crystal Dwelling?"

msgid "STORY_EVENT@991_7111@BODY_HEADER"
msgstr "The {GLOBAL.EternalSagesLoreConcept.Hyperlink} approach you with a request."

msgid "STORY_EVENT@991_7111@BODY_LORE"
msgstr "\"We have long kept records of a relic called the {EventArtifact}. At last, we have learned of <<o:EventArtifact>> location in the {EventGeo} {EventDirection} {EventCity},\" they say to you in a monotonous voice. \"We wish to study the {EventArtifact} and store it within our vast crystalline libraries. However, <<p:EventArtifact>> is defended by a {EventStackLeader} and its army.\""

msgid "STORY_EVENT@991_7111@BUTTON_0"
msgstr "\"I will win you this relic.\""

msgid "STORY_EVENT@991_7111@TITLE"
msgstr "Retrieving the {EventArtifact}"

msgid "STORY_EVENT@991_7112@BODY_FOOTER"
msgstr "The {GLOBAL.EternalSagesLoreConcept.Hyperlink} are eager to study the {EventArtifact}. Will you complete your quest and return it?"

msgid "STORY_EVENT@991_7112@BODY_HEADER"
msgstr "You have wrested the {EventArtifact} from the {EventStackLeader}."

msgid "STORY_EVENT@991_7112@BODY_LORE"
msgstr "The {GLOBAL.EternalSagesLoreConcept.Name} have already spied on your triumph, contacting you from afar. \"You have done well, {PlayerLeader.Title},\" their emissary speaks to you. \"At last we can satiate our curiosity and learn what there is to know of the {EventArtifact}.\""

msgid "STORY_EVENT@991_7112@BUTTON_0"
msgstr "Give the {EventArtifact} to the {GLOBAL.EternalSagesLoreConcept.Name}. [allegiance/]"

msgid "STORY_EVENT@991_7112@BUTTON_1"
msgstr "Keep the {EventArtifact} for yourself, angering the {GLOBAL.EternalSagesLoreConcept.Name}."

msgid "STORY_EVENT@991_7112@TITLE"
msgstr "Retrieving the {EventArtifact}: Aftermath"

msgid "STORY_EVENT@991_7202@BODY_FOOTER"
msgstr "\"As we cannot leave {EventHouse}, you possess the power to retrieve what we cannot procure ourselves,\" the {GLOBAL.EternalSagesLoreConcept.Hyperlink} conclude. \"Will you lend us your aid in this quest for wisdom?\""

msgid "STORY_EVENT@991_7202@BODY_HEADER"
msgstr "The {GLOBAL.EternalSagesLoreConcept.Hyperlink} greet you from within their crystalline library in {EventHouse}."

msgid "STORY_EVENT@991_7202@BODY_LORE"
msgstr "\"Welcome, {PlayerLeader.TitleName},\" the {EventHouseLord} hums. \"We predicted your interest in helping us. Curiosity and ambition define most {GLOBAL.GodirLoreConcept.Hyperlink}, which makes you valuable allies in our pursuit of knowledge. We chronicle and collect all there is to know of the cosmos.\""

msgid "STORY_EVENT@991_7202@BUTTON_0"
msgstr "Ask the {GLOBAL.EternalSagesLoreConcept.Name} for a quest."

msgid "STORY_EVENT@991_7202@BUTTON_1"
msgstr "Ask the {GLOBAL.EternalSagesLoreConcept.Name} for a challenging quest."

msgid "STORY_EVENT@991_7202@BUTTON_2"
msgstr "Leave the {GLOBAL.EternalSagesLoreConcept.Name} to their studies for now."

msgid "STORY_EVENT@991_7202@BUTTON_3"
msgstr "Pay [mana/] the {GLOBAL.EternalSagesLoreConcept.Name} to reveal a location of special interest."

msgid "STORY_EVENT@991_7202@BUTTON_4"
msgstr "Share your insights as a {EventPlayerType} [knowledge/] with the {GLOBAL.EternalSagesLoreConcept.Name}."

msgid "STORY_EVENT@991_7202@BUTTON_5"
msgstr "Offer your {EventItem} [item/] for the {GLOBAL.EternalSagesLoreConcept.Name} to study."

msgid "STORY_EVENT@991_7202@TITLE"
msgstr "Eternal Thirst for Knowledge"

msgid "STORY_EVENT@991_7233@BODY_FOOTER"
msgstr "\"To capture the {EventStackLeader} you must employ this Lithorite capsule. It will seal the creature within a crystal, ripe for our studies.\""

msgid "STORY_EVENT@991_7233@BODY_HEADER"
msgstr "The {GLOBAL.EternalSagesLoreConcept.Hyperlink} approach you with a request."

msgid "STORY_EVENT@991_7233@BODY_LORE"
msgstr "\"We have an interest in studying and preserving the different specimens growing on each world,\" they lay out to you. \"Among the creatures we still aim to collect is the {EventStackLeader}. We have learned of a {EventStackLeader} in the {EventGeo} {EventDirection} {EventCity}.\""

msgid "STORY_EVENT@991_7233@BUTTON_0"
msgstr "\"I shall return with the {EventStackLeader}.\""

msgid "STORY_EVENT@991_7233@TITLE"
msgstr "Capturing <<m:{EventStackLeader}>>"

msgid "STORY_EVENT@991_7234@BODY_FOOTER"
msgstr "The {GLOBAL.EternalSagesLoreConcept.Hyperlink} are eager to study the {EventStackLeader}. Will you complete your quest and return it?"

msgid "STORY_EVENT@991_7234@BODY_HEADER"
msgstr "You have encapsulated the {EventStackLeader} within a large Lithorite crystal."

msgid "STORY_EVENT@991_7234@BODY_LORE"
msgstr "The {GLOBAL.EternalSagesLoreConcept.Name} have already spied on your triumph, contacting you from afar. \"You have done well, {PlayerLeader.Title},\" their emissary speaks to you. \"At last we can satiate our curiosity and learn what there is to know of the {EventStackLeader}.\""

msgid "STORY_EVENT@991_7234@BUTTON_0"
msgstr "Offer the {EventStackLeader} to the {GLOBAL.EternalSagesLoreConcept.Name} [allegiance/]."

msgid "STORY_EVENT@991_7234@BUTTON_1"
msgstr "Tame the {EventStackLeader} for yourself [unit/], angering the {GLOBAL.EternalSagesLoreConcept.Name}."

msgid "STORY_EVENT@991_7234@TITLE"
msgstr "Capturing <<m:{EventStackLeader}>>: Aftermath"

msgid "STORY_EVENT@991_7573@BODY_FOOTER"
msgstr "\"Tread this excavation site at your own risk and watch the <<m:EventUnit>>\", {EventHero} concludes. \"This bedrock requires some big bombs to break.\""

msgid "STORY_EVENT@991_7573@BODY_HEADER"
msgstr "Delving into the depths {EventDirection} {EventCity}, your troops are startled by echoing explosions and the sound of bustling pickaxes."

msgid "STORY_EVENT@991_7573@BODY_LORE"
msgstr "\"Careful, over there!\" someone yells, and emerging from among a group of workers, a richly clad <<EventHero{man/woman}>> plants <<r:EventHero>> before your troops. \"{EventHero} of the {GLOBAL.ColtLoreConcept.Hyperlink},\" <<p:EventHero>> introduces <<r:EventHero>>. \"We are excavating the ruins of an entombed city from the ancient kingdom of {GLOBAL.MyrridaLoreConcept.Hyperlink}. Our adventurers are well outfitted to deal with whatever hazards we may encounter. However —\" <<p:EventHero>> eyes your troops one by one \"— capable contractors are always welcome. For a fair share of the spoils.\""

msgid "STORY_EVENT@991_7573@BUTTON_0"
msgstr "Enter the excavation area."

msgid "STORY_EVENT@991_7573@BUTTON_4"
msgstr "Use the opportunity to conscript [gold/] some workers [structureprod/] for {PlayerCity}."

msgid "STORY_EVENT@991_7573@BUTTON_5"
msgstr "Ask {EventHero} about the famous adventurer's gear [item/] sold [gold/] by the {GLOBAL.ColtLoreConcept.Name}."

msgid "STORY_EVENT@991_7573@TITLE"
msgstr "Entering the Deepglitter Chambers"

msgid "STORY_EVENT@991_7588@BODY_FOOTER"
msgstr "The spiders and their {EventStructure} pose a severe threat to anyone trying to delve deeper into the ruins."

msgid "STORY_EVENT@991_7588@BODY_HEADER"
msgstr "Digging through the earth, your troops find themselves in a chamber covered with thick cobwebs."

msgid "STORY_EVENT@991_7588@BODY_LORE"
msgstr "Hissing noises echo in the darkness, while many-legged silhouettes lurk without movement, awaiting the arrival of new prey. In the center of the chamber where the webbing is the most dense, your troops believe they spot a {EventStackLeader}, likely the queen of this infestation."

msgid "STORY_EVENT@991_7588@BUTTON_0"
msgstr "Prepare to wipe out the {EventStructure}."

msgid "STORY_EVENT@991_7588@TITLE"
msgstr "Deepglitter Chambers: Arachnoid Nightmares"

msgid "STORY_EVENT@991_7595@BODY_FOOTER"
msgstr "The dungeon is filled with traps and deathless defenders. It seems clear that what lies beyond must have been of greatest value..."

msgid "STORY_EVENT@991_7595@BODY_HEADER"
msgstr "Breaking through a mound, your troops reach a well-preserved dungeon area."

msgid "STORY_EVENT@991_7595@BODY_LORE"
msgstr "Masterfully built, this chamber endured the ages undamaged. Undoubtedly its purpose was to deny passage into the most precious chambers of the city—and to eradicate anyone daring to intrude. Deadly dungeon traps hang on pillars and walls as a clear warning, with likely more hidden along the way. <<m:EventStackLeader>> can be spotted in a distance, tirelessly patrolling the paved floors, while animated weapons lurk in the shadows."

msgid "STORY_EVENT@991_7595@BUTTON_0"
msgstr "\"We will break down these dungeon defenses!\""

msgid "STORY_EVENT@991_7595@TITLE"
msgstr "Deepglitter Chambers: Dungeon Crawling"

msgid "STORY_EVENT@991_7603@BODY_FOOTER"
msgstr "While your troops still marvel at {EventStructure}, a series of booming explosions is rupturing the chamber the {GLOBAL.ColtLoreConcept.Hyperlink} have forced their way in from the other side!"

msgid "STORY_EVENT@991_7603@BODY_HEADER"
msgstr "Wearing out pickaxe after pickaxe, your troops carve their path through ever frozen ground until they reach a new chamber at last."

msgid "STORY_EVENT@991_7603@BODY_LORE"
msgstr "Glittering in a rare beam of refracted sunlight falling through endless layers of ice in the ceiling, {EventStructure} towers at the center of this last chamber. Built from immaculate flowrock marble the likes only the <<m:{GLOBAL.GiantKingLoreConcept.Hyperlink}>> of old could hew, {EventStructure} is a symbol of overwhelming power and craftsmanship alike."

msgid "STORY_EVENT@991_7603@BUTTON_0"
msgstr "Let all make haste to reach {EventStructure}!"

msgid "STORY_EVENT@991_7603@TITLE"
msgstr "Deepglitter Chambers: {EventStructure}"

msgid "STORY_EVENT@991_7613@BODY_FOOTER"
msgstr "The {GLOBAL.ColtLoreConcept.Hyperlink} have betrayed your agreement and lay sole claim to {EventStructure}."

msgid "STORY_EVENT@991_7613@BODY_HEADER"
msgstr "Arriving at the grand gates of {EventStructure}, {EventHero} finds the structure complex already roaming with looting adventurers."

msgid "STORY_EVENT@991_7613@BODY_HEADER@HERO_IS_RULER"
msgstr "Arriving at the grand gates of {EventStructure}, you find the structure complex already roaming with looting adventurers."

msgid "STORY_EVENT@991_7613@BODY_LORE"
msgstr "\"Vacate the premises!\" the familiar voice of {ColtHero} can be heard shouting from afar. \"This archaeological site has been found and registered by the {GLOBAL.ColtLoreConcept.Hyperlink}. We are the rightful owners of this area and we will use force to defend our new property, if necessary.\" A glimpse into the throne room indeed reveals drawn weapons and grim faces hiding behind hastily setup barricades."

msgid "STORY_EVENT@991_7613@BUTTON_0"
msgstr "\"They must pay for this insolence. Attack!\""

msgid "STORY_EVENT@991_7613@BUTTON_1"
msgstr "Create your own [production/] <<m:{GLOBAL.UNITS.DEVASTATOR_SPHERE_UNIT}>> in {EventCity} to blow away their barricades."

msgid "STORY_EVENT@991_7613@BUTTON_2"
msgstr "Flee."

msgid "STORY_EVENT@991_7613@TITLE"
msgstr "Deepglitter Chambers: A Company of Thieves"

msgid "STORY_EVENT@991_7614@BODY_FOOTER"
msgstr "You defended your claim to the Deepglitter Chambers. Taking the {EventRelic}, the fate of the pitiful {ColtHero} remains yours to decide."

msgid "STORY_EVENT@991_7614@BODY_HEADER"
msgstr "Just as the last of <<o:ColtHero>> adventurers is felled by your troops, {ColtHero} reveals <<o:ColtHero>> hiding position, raising both hands in surrender."

msgid "STORY_EVENT@991_7614@BODY_LORE"
msgstr "\"I give up!\" <<p:ColtHero>> squeals in deadly terror, holding up an ornate strongbox. \"Here, take this! I am rich. I am of greatest value to the {GLOBAL.ColtLoreConcept.Hyperlink}... when alive, I assure you!\" {ColtHero} slowly regains <<o:ColtHero>> countenance, opening the strongbox. \"Behold, the {EventRelic}, the gem of this Giant King's treasury—a worthy present for a {PlayerLeader.Title}, is it not?\""

msgid "STORY_EVENT@991_7614@BUTTON_10"
msgstr "Interrogate {ColtHero} to learn all about <<o:ColtHero>> stashed equipment hoard. [item/]"

msgid "STORY_EVENT@991_7614@BUTTON_11"
msgstr "Send {ColtHero} as a gift [allegiance/] to the {GLOBAL.EternalSagesLoreConcept.Name}, so they may recover Myrridan secrets pillaged by the {GLOBAL.ColtLoreConcept.Name}."

msgid "STORY_EVENT@991_7614@BUTTON_3"
msgstr "Barter a ransom [gold/] with the {GLOBAL.ColtLoreConcept.Name}."

msgid "STORY_EVENT@991_7614@BUTTON_9"
msgstr "Sentence {ColtHero} and expose [influence/] the shady practices of the {GLOBAL.ColtLoreConcept.Name}."

msgid "STORY_EVENT@991_7614@TITLE"
msgstr "Deepglitter Chambers: Aftermath"

msgid "STORY_EVENT@991_7615@BODY_FOOTER"
msgstr "The earth violently shakes as the <<m:EventUnit>> blast open a tunnel towards the First Chamber."

msgid "STORY_EVENT@991_7615@BODY_FOOTER@SECOND_TUNNEL"
msgstr "The earth violently shakes as the <<m:EventUnit>> blast open a tunnel towards the Second Chamber."

msgid "STORY_EVENT@991_7615@BODY_FOOTER@THIRD_TUNNEL"
msgstr "The earth violently shakes as the <<m:EventUnit>> blast open a tunnel towards the Third Chamber."

msgid "STORY_EVENT@991_7615@BODY_HEADER"
msgstr "Just as the conversation with {EventHero} ends, warnings from the far end of the cavern give notice of the <<m:EventUnit>> set up for detonation."

msgid "STORY_EVENT@991_7615@BODY_HEADER@SECOND_TUNNEL"
msgstr "With the spiders culled, the {GLOBAL.ColtLoreConcept.Hyperlink} are burning away all cobwebs, opening the path for their <<m:EventUnit>>."

msgid "STORY_EVENT@991_7615@BODY_HEADER@THIRD_TUNNEL"
msgstr "With the dungeon defenders destroyed, the {GLOBAL.ColtLoreConcept.Hyperlink} carefully disarm most of the remaining traps, opening the path for their <<m:EventUnit>>."

msgid "STORY_EVENT@991_7615@BODY_LORE"
msgstr "\"Light the fuses[br/]Expect some bruises[br/]They built these halls in centuries past[br/]We bring 'em down, an instant blast[br/]3... 2... 1...[br/]BOOM!\""

msgid "STORY_EVENT@991_7615@BUTTON_0"
msgstr "Time to do some digging!"

msgid "STORY_EVENT@991_7615@TITLE"
msgstr "Deepglitter Chambers: Devastating Excavation"

msgid "STORY_EVENT@991_7681@BODY_FOOTER"
msgstr "\"Draconic brood, ever envious of the Giants' work, has intruded in this garden,\" the {EventUnit} ends. \"Cull them. Root out this weed before it can spread!\""

msgid "STORY_EVENT@991_7681@BODY_HEADER"
msgstr "Gazing at the enormous, ancient colonnade encircling a black-peaked mountain, your troops are startled by a thundering voice."

msgid "STORY_EVENT@991_7681@BODY_LORE"
msgstr "\"May you enter in peace!\" The command echoes from the mountain as a large {EventUnit} emerges between the pillars. \"For the foundations of this garden date back to the times of blessed {GLOBAL.MyrridaLoreConcept.Hyperlink}, and I shall not have it destroyed.\" The {EventUnit} lowers <<o:EventUnit>> staff, sheltering a bird's nest. \"Albeit the peace it long brought is yet in jeopardy once more.\""

msgid "STORY_EVENT@991_7681@BUTTON_0"
msgstr "Ask the {EventUnit} for the location of these Draconic creatures."

msgid "STORY_EVENT@991_7681@BUTTON_DRAGON"
msgstr "\"I shall reclaim this 'brood', puny giant, to help you in your misery.\""

msgid "STORY_EVENT@991_7681@TITLE"
msgstr "Entering Colonnade Garden"

msgid "STORY_EVENT@991_7684@BODY_FOOTER"
msgstr "The {EventUnit} plucks a fruit from a twig of <<o:EventUnit>> tangly mantle. \"My magic has preserved this progeny for ages. Come, taste the glory of {GLOBAL.MyrridaLoreConcept.Hyperlink}!\""

msgid "STORY_EVENT@991_7684@BODY_HEADER"
msgstr "As your troops fell the Draconic creatures one by one, the {EventUnit} returns, pensively."

msgid "STORY_EVENT@991_7684@BODY_LORE"
msgstr "\"These branches have witnessed the ripening of the fruits of peace, these roots tasted the wine of unburdened life,\" <<p:EventUnit>> says slowly, touching the eldest of the trees. \"Within the grand cities of {GLOBAL.MyrridaLoreConcept.Hyperlink}, the small people found prosperity and shelter. Never again were the harvests so bountiful, the fields so irenic.\""

msgid "STORY_EVENT@991_7684@BUTTON_0"
msgstr "Send the fruit to {EventCity} to nourish [food/] the populous."

msgid "STORY_EVENT@991_7684@BUTTON_4"
msgstr "Eat the fruit [xp/]."

msgid "STORY_EVENT@991_7684@BUTTON_5"
msgstr "Portion the fruit, so it may strengthen [xp/] your troops."

msgid "STORY_EVENT@991_7684@BUTTON_6"
msgstr "Immolate the fruit in a bonfire. [chaosboon/]"

msgid "STORY_EVENT@991_7684@TITLE"
msgstr "Colonnade Garden: Overgrown Past"

msgid "STORY_EVENT@991_7686@BODY_FOOTER"
msgstr "\"The Dragon that devastated this city was called {EventDragonName},\" the {EventUnit} ends <<o:EventUnit>> doleful speech. \"But I call <<P:{EventDragonName}>> the Calamity.\""

msgid "STORY_EVENT@991_7686@BODY_HEADER"
msgstr "With growing satisfaction, the {EventUnit} watches your troops kill the Draconic creatures."

msgid "STORY_EVENT@991_7686@BODY_LORE"
msgstr "\"They were called allies of the {GLOBAL.ArchonsLoreConcept.Hyperlink}, fighting for justice and order,\" the {EventUnit} growls. \"But the {GLOBAL.DragonsLoreConcept.Hyperlink} descended upon {GLOBAL.MyrridaLoreConcept.Hyperlink} as harbingers of death and destruction.\" The <<Ge:fists^p,EventUnit.Name>> are shaking with rage. \"Too long had the Dragons envied the civilization we built. This was their opportunity to retaliate upon the Giant kin—and the {GLOBAL.ArchonsLoreConcept.Hyperlink} stayed blind to their ravages after they had so harshly condemned all <<m:{GLOBAL.GiantKingLoreConcept.Hyperlink}>>.\""

msgid "STORY_EVENT@991_7686@BUTTON_0"
msgstr "Leave the {EventUnit} to <<o:EventUnit>> thoughts."

msgid "STORY_EVENT@991_7686@TITLE"
msgstr "Colonnade Garden: War and Woe"

msgid "STORY_EVENT@991_7687@BODY_FOOTER"
msgstr "A sudden storm is gathering as the {EventUnit} raises <<o:EventUnit>> staff. Dark clouds thicken until a mighty lightning bolt shatters the black mountain, revealing the {EventStructure} within."

msgid "STORY_EVENT@991_7687@BODY_HEADER"
msgstr "Your troops have culled the Draconic creatures within Colonnade Garden. The {EventUnit} approaches them with stern determination."

msgid "STORY_EVENT@991_7687@BODY_LORE"
msgstr "\"I have watched over these ruins throughout the ages, and as they slowly became overgrown, I too became one with the forest.\" The leaves covering the {EventUnit} have turned colorful, as if they spruced themselves up for a last golden autumn day.[br/][br/]\"Now, however, my vigil is nearing its end. Hidden inside the black mountain, doused in enchanted sleep lies {EventDragonName}, the Calamity. This is how I trapped <<P:{EventDragonName}>>, waiting for someone powerful enough to end the beast. That someone is you, {PlayerLeader.TitleName}!\""

msgid "STORY_EVENT@991_7687@BUTTON_0"
msgstr "\"The fame [influence/] of slaying {EventDragonName} will be mine, and mine alone!\""

msgid "STORY_EVENT@991_7687@BUTTON_4"
msgstr "\"Lend me the aid of your forces of nature [unit/] in this upcoming fight!\""

msgid "STORY_EVENT@991_7687@TITLE"
msgstr "Colonnade Garden: An Autumn Storm"

msgid "STORY_EVENT@991_7690@BODY_FOOTER"
msgstr "A gentle breeze takes the <<Ge:foliage^n,{EventUnit}>> scattering it to the four winds. <<Co:EventUnit>> antlers and staff remain, passing the stewardship of Colonnade Garden unto you."

msgid "STORY_EVENT@991_7690@BODY_FOOTER@DRAGON_ALLY"
msgstr "{EventDragonName} departs into the skies, leaving you with the {EventRelic}, the antlers, and the staff of the {EventUnit}—and the dominion over Colonnade Garden."

msgid "STORY_EVENT@991_7690@BODY_HEADER"
msgstr "With {EventDragonName} gone, the {EventUnit} carefully examines the remainders of the {EventStructure}."

msgid "STORY_EVENT@991_7690@BODY_HEADER@DRAGON_ALLY"
msgstr "With the mighty {EventUnit} felled, {EventDragonName} reascends the flattened peak of the black mountain in triumph."

msgid "STORY_EVENT@991_7690@BODY_LORE"
msgstr "\"Peace, at last,\" the {EventUnit} calls out, combing through rubble and broken eggshells. The <<Ge:leaves^p,{EventUnit}>> have lost most of their color, wearing a brown that heralds the coming of winter. Near the center of the hollow the {EventUnit} suddenly stops. \"Behold,\" <<p:EventUnit>> calls out, \"the {EventRelic}! Most bountiful among the marvels of blessed {GLOBAL.MyrridaLoreConcept.Hyperlink}. A gift worthy of any {PlayerLeader.Title}.\" The {EventUnit} places the {EventRelic} on a pedestal. \"My vigil has ended, {PlayerLeader}. Yours only just begun...\""

msgid "STORY_EVENT@991_7690@BODY_LORE@DRAGON_ALLY"
msgstr "\"My slumber has ended,\" {EventDragonName} speaks with majesty, \"and the last of the detested Giants is no more.\" <<Cp:{EventDragonName}>> lets <<o:{EventDragonName}>> gaze wander towards the horizon. \"The times have changed. The reach of the {GLOBAL.ArchonsLoreConcept.Hyperlink} has grown distant and much that was spoken of only in prophecy has awoken. I must wander once more, {PlayerLeader}. Take this, the {EventRelic}, for your deeds. It was crafted by the Giant lords of this ruined city, but brought me only ill.\""

msgid "STORY_EVENT@991_7690@BUTTON_0"
msgstr "Use antlers and staff to build the {EventUnit} a shrine. [natureboon/]"

msgid "STORY_EVENT@991_7690@BUTTON_3"
msgstr "Connect with the staff to call forth a servant [unit/] of nature, one last time."

msgid "STORY_EVENT@991_7690@BUTTON_4"
msgstr "Beseech {EventDragonName} to share <<o:{EventDragonName}>> ancient knowledge [knowledge/] with you before leaving."

msgid "STORY_EVENT@991_7690@BUTTON_5"
msgstr "Invite the {GLOBAL.EternalSagesLoreConcept.Name} [allegiance/] to study the Myrridan ruins of Colonnade Garden."

msgid "STORY_EVENT@991_7690@BUTTON_6"
msgstr "Claim the antlers as an adornment [influence/] for your throne."

msgid "STORY_EVENT@991_7690@TITLE"
msgstr "Colonnade Garden: Aftermath"

msgid "STORY_EVENT@991_7703@BODY_FOOTER"
msgstr "{EventDragonName} fixes you with <<o:{EventDragonName}>> enormous, piercing eyes: \"You must decide, {PlayerLeader}, will it be truth or death?\""

msgid "STORY_EVENT@991_7703@BODY_HEADER"
msgstr "Nearing the {EventStructure}, the sneering voice of {EventDragonName} calls out to you."

msgid "STORY_EVENT@991_7703@BODY_LORE"
msgstr "\"So, {PlayerLeader.TitleName}, do you really trust the words of a Giant,\" <<p:{EventDragonName}>> asks, grinning through enormous teeth. \"They never speak of what caused the Great War or which casualties they inflicted. Convenient, isn't it? As if the {GLOBAL.TraitorKingsLoreConcept.Hyperlink} and their soulcurses never existed...\""

msgid "STORY_EVENT@991_7703@BUTTON_0"
msgstr "\"Death! Your desolation ends now, {EventDragonName}!\""

msgid "STORY_EVENT@991_7703@BUTTON_4"
msgstr "\"Truth! Let us fight the vengeful {EventUnit} side by side!\""

msgid "STORY_EVENT@991_7703@BUTTON_DRAGON"
msgstr "\"There must be no quarrel among primal equals, my <<EventDragonName{brother/sister}>>.\""

msgid "STORY_EVENT@991_7703@TITLE"
msgstr "Colonnade Garden: <<ge:Spite^n,{EventDragonName}>>"

msgid "STORY_EVENT@991_7754@BODY_FOOTER"
msgstr "\"Will you share their fates?\" the voice pronounces as it fades, \"Or will you learn from their folly, demonstrating the worth to inherit the secrets of Trinity Island?\""

msgid "STORY_EVENT@991_7754@BODY_HEADER"
msgstr "Navigating the seas, with a distant archipelago in sight, your troops hear a deep voice resonating inside their skulls."

msgid "STORY_EVENT@991_7754@BODY_LORE"
msgstr "\"Raiders. Looters. Thieves.\" Each word has the gravity of an accusation, yet the unison voices pronouncing them reveal no emotion. \"Throughout the ages many have come to these isles to steal the secrets of the {GLOBAL.EternalCouncilLoreConcept.Hyperlink}. We evaluated their intentions. And then we detained them, appalled by their vulgar ambitions.\" Visions of large expressionless faces, carved into crystal, manifest themselves in your troops' minds. \"Now they exist as living statues, a warning to all those who seek power without sagacity.\""

msgid "STORY_EVENT@991_7754@BUTTON_0"
msgstr "\"A <<{EventPlayerType}>> needs no proof of their splendor!\" [influence/]"

msgid "STORY_EVENT@991_7754@TITLE"
msgstr "Discovering Trinity Island"

msgid "STORY_EVENT@991_7757@BODY_FOOTER"
msgstr "The {EventUnit} questions with authority: \"Among the many atrocities that the {GLOBAL.TraitorKingsLoreConcept.Hyperlink} committed, what was their greatest sin?\""

msgid "STORY_EVENT@991_7757@BODY_FOOTER@COMPLETED"
msgstr "You have already answered this trial. Visit the prisoners on the other islands to obtain the judgment of the {EventUnit}!"

msgid "STORY_EVENT@991_7757@BODY_HEADER"
msgstr "Examining the {EventStackLeader} frozen in crystals, your troops hear the {EventUnit} speak to them once more."

msgid "STORY_EVENT@991_7757@BODY_HEADER@COMPLETED"
msgstr "Your troops return to the {EventStackLeader}, sealed within the crystal prison of the {EventUnit}."

msgid "STORY_EVENT@991_7757@BODY_LORE"
msgstr "\"Power-hungry as their deceased masters, the {GLOBAL.TraitorKingCultLoreConcept.Hyperlink} are a posthumous enemy of the {GLOBAL.EternalCouncilLoreConcept.Hyperlink}.\" The voice of the {EventUnit} grows louder. \"When the {GLOBAL.TraitorKingsLoreConcept.Hyperlink} tried to steal the secret of our immortality, they made a crucial mistake. They took our knowledge. They took our crystals. They experimented on their followers in gruesome rituals. Yet when the time came, they only fractured their souls, an immortalized shadow of their former selves.\""

msgid "STORY_EVENT@991_7757@BODY_LORE@COMPLETED"
msgstr "One can only wonder if the {EventStackLeader} is still truly alive or if the confinement within the crystals has detained all <<o:EventStackLeader>> thoughts and sensations."

msgid "STORY_EVENT@991_7757@BUTTON_0"
msgstr "Do not answer the {EventUnit}, for now."

msgid "STORY_EVENT@991_7757@BUTTON_1"
msgstr "\"Treachery. They betrayed their oath as Giant Kings and the people they ought to protect.\""

msgid "STORY_EVENT@991_7757@BUTTON_2"
msgstr "\"Greed. [gold/] Where the Giant Kings mined riches to craft and create, the Traitor Kings hoarded wealth without reason.\""

msgid "STORY_EVENT@991_7757@BUTTON_3"
msgstr "\"Pride. [influence/] They acted as capricious gods, sacrificing all to the pursuit of immortality.\""

msgid "STORY_EVENT@991_7757@BUTTON_4"
msgstr "\"Ignorance. [knowledge/] They sought forbidden knowledge without comprehending the doom it brought upon themselves and ultimately all Giant kin.\""

msgid "STORY_EVENT@991_7757@TITLE"
msgstr "Trinity Island: Trial of Sin"

msgid "STORY_EVENT@991_7761@BODY_FOOTER"
msgstr "The {EventUnit} asks: \"Imagine a library with the collected history of a realm being gifted to a <<PlayerLeader{king/queen}>>. What should the <<PlayerLeader{king/queen}>> do?\""

msgid "STORY_EVENT@991_7761@BODY_FOOTER@COMPLETED"
msgstr "You have already answered this trial. Visit the prisoners on the other islands to obtain the judgment of the {EventUnit}!"

msgid "STORY_EVENT@991_7761@BODY_HEADER"
msgstr "As your troops find a lone rogue, sealed within a Lithorite crystal, the {EventUnit} speaks of <<o:EventStackLeader>> fate."

msgid "STORY_EVENT@991_7761@BODY_HEADER@COMPLETED"
msgstr "Your troops return to the {EventStackLeader}, sealed within the crystal prison of the {EventUnit}."

msgid "STORY_EVENT@991_7761@BODY_LORE"
msgstr "\"<<Co:EventStackLeader>> name is {EventStackLeader}, yet <<p:EventStackLeader>> was merely an expendable tool for the {GLOBAL.ColtLoreConcept.Hyperlink}.\" While the {EventUnit} speaks, your troops begin to see the shape of a large crystalline structure glimmering within the coastal waters. Yet as the voice continues, the image vanishes again, like a mirage: \"They outfit and hire adventurers to raid [hyperlink,GLOBAL.MyrridaLoreConcept]Myrrida's[/hyperlink] secret treasures, destroying much of its legacy beyond retrieval. Thus, they are the counter force to the {GLOBAL.EternalSagesLoreConcept.Hyperlink}, who chronicle and preserve all knowledge within their crystal libraries.\""

msgid "STORY_EVENT@991_7761@BODY_LORE@COMPLETED"
msgstr "One can only wonder if the {EventStackLeader} is still truly alive or if the confinement within the crystals has detained all <<o:EventStackLeader>> thoughts and sensations."

msgid "STORY_EVENT@991_7761@BUTTON_0"
msgstr "Do not answer the {EventUnit}, for now."

msgid "STORY_EVENT@991_7761@BUTTON_1"
msgstr "\"Burn the library! History is written by the victors!\""

msgid "STORY_EVENT@991_7761@BUTTON_2"
msgstr "\"Share the library with the local governors, to reform the administration [food/][structureprod/] system.\""

msgid "STORY_EVENT@991_7761@BUTTON_3"
msgstr "\"Use the knowledge within to forge grievances [influence/] against rival kingdoms.\""

msgid "STORY_EVENT@991_7761@BUTTON_4"
msgstr "\"Study the chronicles [knowledge/] to learn from past empires' mistakes.\""

msgid "STORY_EVENT@991_7761@TITLE"
msgstr "Trinity Island: Trial of Wisdom"

msgid "STORY_EVENT@991_7764@BODY_FOOTER"
msgstr "The voice inquires with determination: \"A troll and a <<PlayerLeader{man/woman}>> seek justice in the court of a {GLOBAL.GiantKingLoreConcept.Hyperlink}. Who should the {GLOBAL.GiantKingLoreConcept.Hyperlink} favor?\""

msgid "STORY_EVENT@991_7764@BODY_FOOTER@COMPLETED"
msgstr "You have already answered this trial. Visit the prisoners on the other islands to obtain the judgment of the {EventUnit}!"

msgid "STORY_EVENT@991_7764@BODY_HEADER"
msgstr "Astounded by the huge crystal encapsulating a {EventStackLeader}, your troops hear the deep resonating voice return."

msgid "STORY_EVENT@991_7764@BODY_HEADER@COMPLETED"
msgstr "Your troops return to the {EventStackLeader}, sealed within the crystal prison of the {EventUnit}."

msgid "STORY_EVENT@991_7764@BODY_LORE"
msgstr "\"Alas, this is what the progeny of Giant kin has become: Uncivilized brutes, eager to steal their own heritage.\" The voice falters for a moment, as if lost in thought. Then it continues: \"The Giant Clans accuse the 'Hastefolk' of suppression, yet they themselves stoke hatred against the smaller kin, evoking a vision of {GLOBAL.MyrridaLoreConcept.Hyperlink} that never existed.\""

msgid "STORY_EVENT@991_7764@BODY_LORE@COMPLETED"
msgstr "One can only wonder if the {EventStackLeader} is still truly alive or if the confinement within the crystals has detained all <<o:EventStackLeader>> thoughts and sensations."

msgid "STORY_EVENT@991_7764@BUTTON_0"
msgstr "Do not answer the {EventUnit}, for now."

msgid "STORY_EVENT@991_7764@BUTTON_1"
msgstr "\"The <<PlayerLeader{man/woman}>>! A troll is a degenerate offspring that must be culled from the realms!\""

msgid "STORY_EVENT@991_7764@BUTTON_2"
msgstr "\"Both! Mercy [goodact/] is a gift granted by true kings.\""

msgid "STORY_EVENT@991_7764@BUTTON_3"
msgstr "\"The troll! In a Giant Kingdom the Giants rule supreme!\" [influence/]"

msgid "STORY_EVENT@991_7764@BUTTON_4"
msgstr "\"Neither! Justice should be dispensed only after studying [knowledge/] all evidence!\""

msgid "STORY_EVENT@991_7764@TITLE"
msgstr "Trinity Island: Trial of Balance"

msgid "STORY_EVENT@991_7774@BODY_FOOTER"
msgstr "The unison voices end their ordeal: \"To inherit our secrets, speak one last time: Which quality must a <<PlayerLeader{king/queen}>> represent above all?\""

msgid "STORY_EVENT@991_7774@BODY_HEADER"
msgstr "Your troops carefully approach the {EventStackLeader}, floating amidst the three islands, awaiting <<o:EventStackLeader>> judgment."

msgid "STORY_EVENT@991_7774@BODY_LORE"
msgstr "\"You have answered our trials,\" the {EventStackLeader} speaks, \"and we have deemed your responses worthy of a {PlayerLeader.Title}.\" There are crystal reflections in the water, blinding your troops, but they vanish again as the {EventStackLeader} continues: \"The <<m:{GLOBAL.GiantKingLoreConcept.Hyperlink}>> ruled {GLOBAL.MyrridaLoreConcept.Hyperlink} with great wisdom. There was equality between giants and the smaller kin and even the <<m:{GLOBAL.GiantKingLoreConcept.Hyperlink}>> themselves abided by the law and the verdicts of the {GLOBAL.EternalCouncilLoreConcept.Hyperlink}.\""

msgid "STORY_EVENT@991_7774@BUTTON_0"
msgstr "Do not answer the {EventStackLeader}, for now."

msgid "STORY_EVENT@991_7774@BUTTON_1"
msgstr "\"Your trials are an insult to my power. Die now, vexatious {EventStackLeader}!\""

msgid "STORY_EVENT@991_7774@BUTTON_2"
msgstr "\"Tenacity.\" [structureprod/][materiumboon/]"

msgid "STORY_EVENT@991_7774@BUTTON_3"
msgstr "\"Nobility.\" [influence/][shadowboon/]"

msgid "STORY_EVENT@991_7774@BUTTON_4"
msgstr "\"Prudence.\" [knowledge/][astralboon/]"

msgid "STORY_EVENT@991_7774@TITLE"
msgstr "Trinity Island: The Ordeal of the {EventStackLeader}"

msgid "STORY_EVENT@991_7777@BODY_FOOTER"
msgstr "Where the {EventUnit} floated, now only an artifact is adrift in the waves. It is the {EventRelic}, reward and proof of your dominion over Trinity Island."

msgid "STORY_EVENT@991_7777@BODY_HEADER"
msgstr "The {EventUnit} hums. \"A sagacious response. With this, we can lift our spell and return to the glimmering halls of our brethren. Marvel at the {EventStructure}, {PlayerLeader}, and its secrets that are now yours!\""

msgid "STORY_EVENT@991_7777@BODY_LORE"
msgstr "An arcane sizzling stirs up the waters of Trinity Island and as the illusion of the {EventUnit} fades away, large monumental crystals become revealed to your troops. They form a structure complex stretching between the three islands, a {EventStructure} holding the crystallized knowledge of the {GLOBAL.EternalCouncilLoreConcept.Hyperlink}."

msgid "STORY_EVENT@991_7777@BUTTON_0"
msgstr "Activate the dormant Lithorine guards [unit/] hidden within the {EventStructure}."

msgid "STORY_EVENT@991_7777@BUTTON_4"
msgstr "Claim any magical items [item/] stored among the knowledge crystals."

msgid "STORY_EVENT@991_7777@BUTTON_5"
msgstr "Absorb the abundant astral energies [mana/] impounded within the {EventStructure}."

msgid "STORY_EVENT@991_7777@BUTTON_6"
msgstr "Invite the {GLOBAL.EternalSagesLoreConcept.Name} [allegiance/] to the {EventStructure}."

msgid "STORY_EVENT@991_7777@TITLE"
msgstr "Trinity Island: Aftermath"

msgid "STORY_EVENT@993_7337@BODY_FOOTER"
msgstr "{EventLeaderDefeated.Name} holds a strong influence over this realm. Defeating <<p:var>> will assure your dominance."

msgid "STORY_EVENT@993_7337@BODY_HEADER"
msgstr "{EventLeaderDefeated.TitleName} regards you with contempt, weighing the relevance of your intrusion into <<o:EventLeaderDefeated>> realm."

msgid "STORY_EVENT@993_7337@BODY_LORE"
msgstr "\"I shall not suffer the presence of pretenders in my realm. Stay out of my way and perhaps you'll survive the cold long enough to regret coming here.\""

msgid "STORY_EVENT@993_7337@BUTTON_0"
msgstr "This realm will be ours."

msgid "STORY_EVENT@993_7337@TITLE"
msgstr "Realm of the Frost Queen"

msgid "STORY_EVENT@993_7338@BODY_FOOTER"
msgstr "With the power of the Frozen Heart in your hands, none can stand in your way. This realm is yours."

msgid "STORY_EVENT@993_7338@BODY_HEADER"
msgstr "{EventLeaderDefeated} is defeated. As <<p:EventLeaderDefeated>> is cast into the void, <<o:EventLeaderDefeated>> control over this realm falters."

msgid "STORY_EVENT@993_7338@BODY_LORE"
msgstr "Ransacking through the <<g:former throne city^n,EventLeaderDefeated>>, the secret to <<o:EventLeaderDefeated>> control of the realm is revealed: a frozen heart seemingly made of many elemental creatures, gruesomely melded together."

msgid "STORY_EVENT@993_7338@BUTTON_0"
msgstr "Victory is ours!"

msgid "STORY_EVENT@993_7338@TITLE"
msgstr "The Frost Queen Defeated"

msgid "STORY_EVENT@993_7347@BODY_FOOTER"
msgstr "{EventLeaderDefeated.TitleName} is the prime threat to your control of this realm. Defeating such a powerful being will leave no doubts about your right to rule."

msgid "STORY_EVENT@993_7347@BODY_HEADER"
msgstr "With roaring flames, {EventLeaderDefeated.TitleName} appears, <<o:EventLeaderDefeated>> eyes flickering with a terrifying intensity."

msgid "STORY_EVENT@993_7347@BODY_LORE"
msgstr "\"A new lamb arrives in my realm.\" <<Cp:EventLeaderDefeated>> regards your form, appraising you as one would select cattle for slaughter. \"You have not yet lost your fire. This is good... I will enjoy taking it from you.\""

msgid "STORY_EVENT@993_7347@BUTTON_0"
msgstr "\"{EventLeaderDefeated.TitleName} must fall.\""

msgid "STORY_EVENT@993_7347@TITLE"
msgstr "Realm of the {EventLeaderDefeated.Title}"

msgid "STORY_EVENT@993_7348@BODY_FOOTER"
msgstr "The <<g:final defeat^n,EventLeaderdefeated>> proves your supremacy over this realm. With <<o:EventLeaderDefeated>> powers added to your own, the other lords surrender or scramble to flee."

msgid "STORY_EVENT@993_7348@BODY_HEADER"
msgstr "{EventLeaderDefeated.TitleName} is embraced by the flames <<p:EventLeaderDefeated>> once called <<o:EventLeaderDefeated>> own, roaring as <<p:EventLeaderDefeated>> is taken."

msgid "STORY_EVENT@993_7348@BODY_LORE"
msgstr "The {EventLeaderDefeated.Title} is defeated, <<o:EventLeaderDefeated>> armies scattering and succumbing to infighting. You now wield the power to command <<o:EventLeaderDefeated>> legions, or to banish them."

msgid "STORY_EVENT@993_7348@BUTTON_0"
msgstr "Victory is ours!"

msgid "STORY_EVENT@993_7348@TITLE"
msgstr "The {EventLeaderDefeated.Title} Defeated"

msgid "STORY_EVENT@993_7354@BODY_FOOTER"
msgstr "Through conquest or diplomacy, {WarlordLeader.Name}, {BastardLeader.Name} and {HeirLeader.Name} must be brought to heel."

msgid "STORY_EVENT@993_7354@BODY_HEADER"
msgstr "Having met with the kings that rule the remnants of this once mighty kingdom, you have a new goal set before you, the reunification of Vossin... under your banner."

msgid "STORY_EVENT@993_7354@BODY_LORE"
msgstr "The once-mighty kingdom of Vossin is now shattered, its people suffering as kings squabble. Something must be done."

msgid "STORY_EVENT@993_7354@BUTTON_0"
msgstr "Vossin shall be made whole under my banner."

msgid "STORY_EVENT@993_7354@TITLE"
msgstr "The Conquest of Vossin"

msgid "STORY_EVENT@993_7355@BODY_FOOTER"
msgstr "The throne is now yours to ascend and the reforged Kingdom of Vossin yours to command."

msgid "STORY_EVENT@993_7355@BODY_HEADER"
msgstr "With your control over the last splinter kingdom assured, there is now no doubt as to your claim to this realm."

msgid "STORY_EVENT@993_7355@BODY_LORE"
msgstr "The remaining kings swear fealty to you, their subjects hailing you as a great uniter, the one who reforged a shattered kingdom."

msgid "STORY_EVENT@993_7355@BUTTON_0"
msgstr "Victory is ours!"

msgid "STORY_EVENT@993_7355@TITLE"
msgstr "Vossin Conquered"

msgid "STORY_EVENT@993_8062@BODY_FOOTER"
msgstr "{EventLeaderDefeated.Name} holds a strong influence over the houses of this realm, defeating <<P:EventLeaderDefeated>> will prove your dominance."

msgid "STORY_EVENT@993_8062@BODY_HEADER"
msgstr "An image of {EventLeaderDefeated.TitleName} appears surrounded by an imperious air; <<p:EventLeaderDefeated>> smiles warmly."

msgid "STORY_EVENT@993_8062@BODY_LORE"
msgstr "\"Welcome, pretender. You enter a Realm already saved, enlightened by the will of the [hyperlink,GLOBAL.ArchonsLoreConcept]Archons[/hyperlink]. You would be wise to fall in line and join our covenant... or find yourself banished.\""

msgid "STORY_EVENT@993_8062@BUTTON_0"
msgstr "{EventLeaderDefeated.TitleName} must fall."

msgid "STORY_EVENT@993_8062@TITLE"
msgstr "Realm of the {EventLeaderDefeated.Title}"

msgid "STORY_EVENT@993_8063@BODY_FOOTER"
msgstr "With the Houses bent to your will, none can stand in your way. This Realm is yours."

msgid "STORY_EVENT@993_8063@BODY_HEADER"
msgstr "{EventLeaderDefeated.Title} is defeated. Yet, as <<p:EventLeaderDefeated>> is cast into the void, no divine retribution comes."

msgid "STORY_EVENT@993_8063@BODY_LORE"
msgstr "The {EventLeaderDefeated.Title} could bleed after all... as a representative of the many Houses, we surrender our allegiance to you, vanquisher of prophets. May you show us mercy."

