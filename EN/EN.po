msgstr "Eternal Studies"

msgid "DLC@GIANTKINGS@RELIC@LITHORITE_GLOBE@LORE"
msgstr "“To escape righteous order, we must square the circle[br/]To flee dragon fire, perform one true miracle[br/]Transcending our souls into crystalline cages[br/]Giant Kings no longer, become Eternal Sages”"

msgid "DLC@GIANTKINGS@RELIC@LITHORITE_GLOBE@NAME"
msgstr "Lithorite Astrolabe^n"

msgid "DLC@GIANTKINGS@RELIC@LITHORITE_PRISM@DESCRIPTION"
msgstr "[bulletlist][bullet/]Your <<m:{GLOBAL.CityConcept.Hyperlink}>> gain:[bulletlist][bullet/]{IntStabilityBuff} {GLOBAL.CityStabilityConcept.Hyperlink} if you have an {GLOBAL.OrderConcept.Hyperlink} {GLOBAL.TomeConcept.Hyperlink} in your library.[bullet/]{IntFoodBuff} {GLOBAL.FoodConcept.Hyperlink} if you have a {GLOBAL.NatureConcept.Hyperlink} {GLOBAL.TomeConcept.Hyperlink} in your library.[bullet/]{IntGoldBuff} {GLOBAL.GoldConcept.Hyperlink} if you have a {GLOBAL.MateriumConcept.Hyperlink} {GLOBAL.TomeConcept.Hyperlink} in your library.[bullet/]{IntDraftBuff} {GLOBAL.UnitProductionConcept.Hyperlink} if you have a {GLOBAL.ChaosConcept.Hyperlink} {GLOBAL.TomeConcept.Hyperlink} in your library.[bullet/]{IntKnowledgeBuff} {GLOBAL.KnowledgeConcept.Hyperlink} if you have a {GLOBAL.ShadowConcept.Hyperlink} {GLOBAL.TomeConcept.Hyperlink} in your library.[bullet/]{IntManaBuff} {GLOBAL.ManaConcept.Hyperlink} if you have an {GLOBAL.AstralConcept.Hyperlink} {GLOBAL.TomeConcept.Hyperlink} in your library.[bullet/]For dual affinity <<m:{GLOBAL.TomeConcept.Hyperlink}>> these bonuses are halved.[/bulletlist][/bulletlist]"

msgid "DLC@GIANTKINGS@RELIC@LITHORITE_PRISM@LORE"
msgstr "“From the depths of history, chronicled proof[br/]In libraries we collect knowledge unbound[br/]The cosmic secrets concealed below ground”"

msgid "DLC@GIANTKINGS@RELIC@LITHORITE_PRISM@NAME"
msgstr "Lithorite Prism^n"

msgid "DLC@GIANTKINGS@RELIC@LITHORITE_SCROLL@DESCRIPTION"
msgstr "[bulletlist][bullet/]{IntAffinityIncrease} {GLOBAL.OrderConcept.Hyperlink}[bullet/]{IntAffinityIncrease} {GLOBAL.NatureConcept.Hyperlink}[bullet/]{IntAffinityIncrease} {GLOBAL.MateriumConcept.Hyperlink}[bullet/]{IntAffinityIncrease} {GLOBAL.ChaosConcept.Hyperlink}[bullet/]{IntAffinityIncrease} {GLOBAL.ShadowConcept.Hyperlink}[bullet/]{IntAffinityIncrease} {GLOBAL.AstralConcept.Hyperlink}[/bulletlist]"

msgid "DLC@GIANTKINGS@RELIC@LITHORITE_SCROLL@LORE"
msgstr "“There is music in these crystals, listen[br/]Let the chimes of forgotten days glisten[br/]Discerning the notes is reading the truth“"

msgid "DLC@GIANTKINGS@RELIC@LITHORITE_SCROLL@NAME"
msgstr "Lithorite Scroll^n"

msgid "DLC@GIANTKINGS@RELIC@MENHIR_OF_FIRE@DESCRIPTION"
