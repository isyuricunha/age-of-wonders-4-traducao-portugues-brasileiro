msgid "DLC@RISEFROMRUIN@CATACLYSM_VICTORY@SUB_TEXT"
msgstr "Harnessing the Devouring Winds"

msgid "DLC@RISEFROMRUIN@CATACLYSM_VICTORY@VICTORY"
msgstr "Age of Cataclysm"

msgid "DLC@RISEFROMRUIN@CATACLYSM_VICTORY@VICTORY@ALLY_DESCRIPTION"
msgstr "{OtherPlayer.Name} has harnessed the Devouring Winds with the Artifacts of the Unmakers. Together you wield the power of the Cataclysms!"

