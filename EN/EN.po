msgid "INTERFACE@DIPLOMACY@FREE_CITIES"
msgstr "Free Cities"

msgid "INTERFACE@DIPLOMACY@HOUSE"
msgstr "[minorcity/] Free City"

msgid "INTERFACE@DIPLOMACY@HOUSE_CONFIRMBUTTON"
msgstr "Go to {GLOBAL.IndependentCityConcept.Name}"

msgid "INTERFACE@DIPLOMACY@HOUSE_DESCRIPTION"
msgstr "[minorcity/]Free Cities are <<m:{GLOBAL.CityConcept.Hyperlink}>> that do not belong to an {GLOBAL.EmpireConcept.Hyperlink}. They have a {GLOBAL.FreeCityLordConcept.Hyperlink} with whom it is possible to [hyperlink,GLOBAL.NegotiationConcept]negotiate[/hyperlink].[br/][br/]With a higher {GLOBAL.PvEDiplStateConcept.Hyperlink}, a [minorcity/] Free City offers:[bulletlist][bullet/][hyperlink,GLOBAL.IndependentCityTradeConcept]Trading[/hyperlink].[bullet/]<<m:{GLOBAL.RecruitmentPointsConcept.Hyperlink}>> for the {GLOBAL.RequestMilitaryAidConcept.Hyperlink}.[bullet/]Shared Income.[/bulletlist][br/][br/]When an {GLOBAL.EmpireConcept.Hyperlink} reaches the highest {GLOBAL.PvEDiplStateConcept.Hyperlink} with a [minorcity/] Free City, the city may become part of that empire through a {GLOBAL.PactOfIntegrationConcept.Hyperlink}. Alternatively {GLOBAL.IndependentCityWarConcept.Hyperlink} may be declared to acquire the [minorcity/] Free City through conquest."

msgid "INTERFACE@DIPLOMACY@HOUSE_HYPERLINK"
msgstr "[minorcity/][hyperlink,GLOBAL.IndependentCityConcept]Free City[/hyperlink]"

msgid "INTERFACE@DIPLOMACY@HOUSE_LORD"
msgstr "Free City Lord"

msgid "INTERFACE@DIPLOMACY@HOUSE_LORD@DESCRIPTION"
msgstr "A Free City Lord or Lady is the designated ruler of a {GLOBAL.IndependentCityConcept.Hyperlink}. They represent their {GLOBAL.IndependentCityConcept.Name} in all diplomatic interactions with an {GLOBAL.EmpireConcept.Hyperlink} and fight for their city as <<m:{GLOBAL.HeroConcept.Hyperlink}>> on the {GLOBAL.WorldMapConcept.Hyperlink}.[br/][br/]When the Free City Lord dies (and their Free City has not been conquered or integrated) they will be replaced by their heir, who will become the new Free City Lord after {IntDuration} <<m:{GLOBAL.TurnConcept.Hyperlink}>>. The free city will not be able to cast {GLOBAL.CombatSpellConcept.Hyperlink} until this has happened."

msgid "INTERFACE@DIPLOMACY@HOUSE_LORD@HYPERLINK"
msgstr "[hyperlink,GLOBAL.FreeCityLordConcept]Free City Lord[/hyperlink]"

msgid "INTERFACE@DIPLOMACY@HOUSE_WARS"
msgstr "[rs_war/][hyperlink,GLOBAL.IndependentCityWarConcept]Wars[/hyperlink]"

msgid "INTERFACE@DIPLOMACY@INACTIVE_CITIES"
msgstr "Inactive Cities"

msgid "INTERFACE@DIPLOMACY@INDEPENDENT_CITY_DIPL_STATE"
msgstr "Free City Diplomatic State"

msgid "INTERFACE@DIPLOMACY@INDEPENDENT_CITY_DIPL_STATE_DESCRIPTION"
msgstr "The diplomatic state with a {GLOBAL.IndependentCityConcept.Hyperlink} is the formal expression of their {GLOBAL.HouseInfluenceConcept.Hyperlink}. A newly met {GLOBAL.IndependentCityConcept.Hyperlink} will be on [rs_neutral/] [hyperlink,GLOBAL.IndependentCityNeutralConcept]neutral terms[/hyperlink] with an {GLOBAL.EmpireConcept.Hyperlink} (in some cases [rs_war/] [hyperlink,GLOBAL.IndependentCityWarConcept]War[/hyperlink] is declared instantly). By sending their {GLOBAL.FreeCityLordConcept.Hyperlink} a {GLOBAL.DiplomaticTokenConcept.Hyperlink}, the {GLOBAL.HouseInfluenceConcept.Hyperlink} of the {GLOBAL.IndependentCityConcept.Hyperlink} with that {GLOBAL.EmpireConcept.Hyperlink} will improve over time.[br/][br/]Higher {GLOBAL.HouseInfluenceConcept.Hyperlink} leads to better diplomatic states with more valuable benefits. This [hyperlink,GLOBAL.NegotiationConcept]negotiation process[/hyperlink] is divided into the {GLOBAL.NegotiationPhaseConcept.Hyperlink} and the {GLOBAL.VassalagePhaseConcept.Hyperlink}, which eventually leads to the {GLOBAL.PactOfIntegrationConcept.Hyperlink}."

msgid "INTERFACE@DIPLOMACY@INDEPENDENT_CITY_DIPL_STATE_HYPERLINK"
msgstr "[hyperlink,GLOBAL.PvEDiplStateConcept]Diplomatic State[/hyperlink]"

msgid "INTERFACE@DIPLOMACY@INDEPENDENT_CITY_NEGOTIATE"
msgstr "[hyperlink,GLOBAL.NegotiationConcept]Negotiate:[/hyperlink]"

msgid "INTERFACE@DIPLOMACY@INDEPENDENT_CITY_NEUTRAL"
msgstr "Neutral diplomatic state with a Free City"

msgid "INTERFACE@DIPLOMACY@INDEPENDENT_CITY_NEUTRAL_HYPERLINK"
msgstr "[rs_neutral/] [hyperlink,GLOBAL.IndependentCityNeutralConcept]Neutral[/hyperlink]"

msgid "INTERFACE@DIPLOMACY@INDEPENDENT_CITY_RELATION"
msgstr "Free City relations"

msgid "INTERFACE@DIPLOMACY@INDEPENDENT_CITY_RELATION_DESCRIPTION"
msgstr "Relations with a {GLOBAL.IndependentCityConcept.Hyperlink} represent their opinion of a Ruler. The relation value can affect the amount of {GLOBAL.HouseInfluenceConcept.Hyperlink} gained during <<m:{GLOBAL.NegotiationConcept.Hyperlink}>> and with very low relations the free city may also declare {GLOBAL.IndependentCityWarConcept.Hyperlink} when on the {GLOBAL.IndependentCityNeutralConcept.Hyperlink} diplomatic state."

msgid "INTERFACE@DIPLOMACY@INDEPENDENT_CITY_RELATION_HYPERLINK"
msgstr "[hyperlink,GLOBAL.IndependentCityRelationConcept]Relations[/hyperlink]"

msgid "INTERFACE@DIPLOMACY@INDEPENDENT_CITY_TIER"
