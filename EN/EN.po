msgstr "You gain an unending supply of <<m:EventUnit>>[bulletlist][bullet/]You immediately start off with a large army of <<m:EventUnit>>.[bullet/]So long as the {EventStructure} remains in your possession, it will generate new <<m:EventUnit>> to replace any who fall in battle.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@STORY_REALM_MISSION_02@TOOLTIP@ORDER_INFESTATION"
msgstr "Multiple neutral forces of Order will descend upon the realm to take up the fight against evil."

msgid "DLC@SECRETSOFTHEARCHMAGES@STORY_REALM_MISSION_02@TOOLTIP@PRINCES_DECLARE_WAR"
msgstr "All remaining [hyperlink,GLOBAL.DemonicPrinceLoreConcept]Demonic Princes[/hyperlink] instantly declare {GLOBAL.WarConcept.Hyperlink} on you!"

msgid "DLC@SECRETSOFTHEARCHMAGES@STORY_REALM_MISSION_02@TOOLTIP@SUMMON_YSARIEL"
