msgid "CORE_SIEGEPROJECTS@BREAK_BATTLEMENTS@DESCRIPTION"
msgstr "[bulletlist][bullet/][hyperlink,GLOBAL.CityBattlementStructureConcept]Battlement[/hyperlink] positions have {chance} chance of being {GLOBAL.OnFireConcept.Hyperlink} at the start of combat.[/bulletlist]"

msgid "CORE_SIEGEPROJECTS@BREAK_BATTLEMENTS@NAME"
msgstr "Burn Battlements"

msgid "CORE_SIEGEPROJECTS@CONSTRUCT_CATAPULTS@DESCRIPTION"
msgstr "[bulletlist][bullet/]At the start of the battle, gain {amount} <<m:{GLOBAL.UNITS.CATAPULT_UNIT.Hyperlink}>> on the attacker's side until the end of battle.[bullet/]<<m:{GLOBAL.UNITS.CATAPULT_UNIT.Hyperlink}>> are immobile {GLOBAL.PROPERTIES.SIEGECRAFT_UNIT.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> with long range, area of effect attacks that are great for destroying obstacles, but are inaccurate against <<m:{GLOBAL.UnitConcept.Hyperlink}>>.[bullet/]Only one type of Siegecraft unit can be brought into {GLOBAL.CombatConcept.Hyperlink}.[/bulletlist]"

msgid "CORE_SIEGEPROJECTS@CONSTRUCT_CATAPULTS@NAME"
msgstr "Construct Onagers"

msgid "CORE_SIEGEPROJECTS@CONSTRUCT_TREBUCHETS@DESCRIPTION"
msgstr "[bulletlist][bullet/]2 Trebuchet units will join the attacking side during the siege battle.[bullet/]Trebuchets are powerful long-ranged units that excel at destroying obstacles, but are inaccurate when targeting units.[/bulletlist]"

msgid "CORE_SIEGEPROJECTS@CONSTRUCT_TREBUCHETS@NAME"
msgstr "Construct Trebuchets"

msgid "CORE_SIEGEPROJECTS@HARASS_DEFENDERS@DESCRIPTION"
msgstr "[bulletlist][bullet/]Units defending the city take {damage} {GLOBAL.PhysicalDamageConcept.Hyperlink} at the start of combat.[/bulletlist]"

msgid "CORE_SIEGEPROJECTS@HARASS_DEFENDERS@NAME"
msgstr "Harass Defenders"

msgid "CORE_SIEGEPROJECTS@HASTEFUL_ASSAULT@DESCRIPTION"
