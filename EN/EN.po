msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@ANCIENT_BATTLEFIELD@DESCRIPTION"
msgstr "<<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacent to this Landmark gain:[bulletlist][bullet/]{income}.[bullet/]If <<m:{GLOBAL.SoulConcept.Hyperlink}>> are obtainable, this province grants {income2}.[bullet/]The {combatproperty} {GLOBAL.CombatEnchantmentConcept.Hyperlink}[/bulletlist][br/]A {GLOBAL.CityConcept.Hyperlink} with {amount} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacent to this Landmark gain:[bulletlist][bullet/]Tier 1 <<m:{GLOBAL.UnitConcept.Hyperlink}>> have their recruitment cost reduced by {discount} in the City.[bullet/]If <<m:{GLOBAL.SoulConcept.Hyperlink}>> are obtainable, unlocks recruitment of Tier 1 Skeleton units.[/bulletlist]"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@ANCIENT_BATTLEFIELD@LORE"
msgstr "\"Do you feel it? Forbidden magic lingers on this battlefield... Not of creation, but of un-life. My kin tell the story of a [hyperlink,GLOBAL.TraitorKingsLoreConcept]Traitor King[/hyperlink] who cursed the grounds with ancient magics where he fell... None who fought here shall ever know peace. And so, the souls of the fallen remain among their bones, forever fighting, forever dying...\"[br/][br/]— Fjalla Tor-Builder, In the Giant's Footsteps: As cited by Ham Binger"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@ANCIENT_BATTLEFIELD@NAME"
msgstr "Haunted Battlefield"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@CASCADE_FALLS@DESCRIPTION"
msgstr "<<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacent to this Landmark gain:[bulletlist][bullet/]{income}.[bullet/]A [farm/] Farm or [forester/] Forester in this province grants {income2}.[/bulletlist][br/]A {GLOBAL.CityConcept.Hyperlink} with {amount} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacent to this Landmark gain:[bulletlist][bullet/]Unlocks recruitment of <<{GLOBAL.UNITS.LESSER_TIDE_SPIRIT.Hyperlink}>> and <<{GLOBAL.UNITS.TIDE_SPIRIT.Hyperlink}>>.[bullet/]Friendly <<m:{GLOBAL.UnitConcept.Hyperlink}>> in the domain [hyperlink,GLOBAL.WorldMapRegeneration]regenerate[/hyperlink] {regen} every {GLOBAL.TurnConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@CASCADE_FALLS@LORE"
msgstr "\"When the crown weighed heavily upon my mother, she would turn to the sanctuary of the falls. She said the cascade drowns out all chaos. In my search for her I, too, visit this place of peace. I wade into the stream, I let the torrent wash over me, and in its relentless rhythm I rediscover clarity and strength.\"[br/][br/]— Sundren of House Inioch, Memories of the Elven Court"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@CASCADE_FALLS@NAME"
msgstr "Cascade Falls"

