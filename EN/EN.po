msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_03@COMBAT_DESCRIPTION"
msgstr "Friendly units of this effect's owner gain:[bulletlist][bullet/]If this unit attacked, at the end of their turn they gain a stack of {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} and {GLOBAL.PROPERTIES.NATURES_MIGHT.Hyperlink} for {NATURES_MIGHT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_03@DESCRIPTION"
msgstr "While this unit is in battle all friendly units gain:[bulletlist][bullet/]If this unit attacked, at the end of their turn they gain a stack of {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} and {GLOBAL.PROPERTIES.NATURES_MIGHT.Hyperlink} for {NATURES_MIGHT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_03@NAME"
msgstr "Primordial Strength"

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_03@PROP_DESCRIPTION"
