msgid "CAMPAIGN@ORDER_REALM@FORBIDDEN_DOMAIN_TRAIT@DESCRIPTION"
msgstr "Entrance to the world is forbidden by Celestial Decree. Units of all players, except the custodian of the realm, are permanently affected by {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink}."

msgid "CAMPAIGN@ORDER_REALM@FORBIDDEN_DOMAIN_TRAIT@NAME"
msgstr "Forbidden Domain"

msgid "CAMPAIGN@ORDER_REALM@HOLY_PROTECTORS_TRAIT@DESCRIPTION"
msgstr "This realm has been blessed with the purity of Archon faith. All roaming wildlife is affected by Celestial Enchantments.[br/][br/]The custodian of the realm may invoke the spirits of the ancient Archons themselves to come to their aid."

msgid "CAMPAIGN@ORDER_REALM@HOLY_PROTECTORS_TRAIT@NAME"
msgstr "Holy Protectors"

msgid "CAMPAIGN@ORDER_REALM@NIMUE_RITUAL@PREDICTION"
msgstr "Perform the Ritual of the Drowned, which has an active effect for the rest of the game:[bulletlist][bullet/]Every {turn} <<m:{GLOBAL.TurnConcept}>>, an army of the Drowned races from the Enchanted Archipelago rises under control of the Shad'rai.[/bulletlist]"

msgid "CAMPAIGN@ORDER_REALM@NO_FREE_CITIES_TRAIT@DESCRIPTION"
msgstr "All civilized inhabitants of this realm are subjects of the Custodian.[bulletlist][bullet/]<<m:{GLOBAL.IndependentCityConcept.Hyperlink}>> are [abilityblue]Rare[/abilityblue] and can not be negotiated with.[/bulletlist]"

msgid "CAMPAIGN@ORDER_REALM@NO_FREE_CITIES_TRAIT@NAME"
msgstr "Custodian's Dogma"

msgid "CAMPAIGN@ORDER_REALM@TURIEL_SHADRAI_WAR@TOOLTIP"
msgstr "The diplomatic state between {EventPlayer.Name} and all Shad'rai changes to {GLOBAL.WarConcept.Hyperlink}."

msgid "CAMPAIGN@ORDER_REALM@YAKA_RITUAL@DESCRIPTION"
msgstr "Every {turn} <<m:{GLOBAL.TurnConcept}>>, all units not owned by the Shad'rai have a base {chance}% chance of being inflicted with {GLOBAL.PROPERTIES.BURNING.Hyperlink}."

msgid "CAMPAIGN@ORDER_REALM@YAKA_RITUAL@NAME"
msgstr "Ritual of the Pyre"

msgid "CAMPAIGN@ORDER_REALM@YAKA_RITUAL@PREDICTION"
msgstr "Perform the Ritual of the Pyre, which has an active effect for the rest of the game:[bulletlist][bullet/]Every {turn} <<m:{GLOBAL.TurnConcept}>> while in combat, all units not owned by the Shad'rai have a base {chance}% chance of being inflicted with {GLOBAL.PROPERTIES.BURNING.Hyperlink}.[/bulletlist]"

msgid "CAMPAIGN@ORDER_REALM@YDGAARD_RITUAL@PREDICTION"
msgstr "Perform the Ritual of Shattered Earth, which has an active effect for the rest of the game:[bulletlist][bullet/]Every {turn} <<m:{GLOBAL.TurnConcept}>>, a random province owned by an enemy player is hit by the {GLOBAL.SPECIAL_OPERATIONS.PYROCLASTIC_ERUPTION.Hyperlink} spell.[/bulletlist]"

