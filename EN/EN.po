msgstr "Sylvan Wolf's Boon"

msgid "DLC@PRIMALFURY@PRIMAL_FURY_ABILITY@WOLF_FURY@DESCRIPTION"
msgstr "Attacks gain:[bulletlist][bullet/]+{FURY_WOLF_EXTRA_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink}.[bullet/]+{FURY_WOLF_EXTRA_DAMAGE_COUNTING>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink} per friendly unit adjacent to the target.[/bulletlist][br/]On attack lose a stack of this effect."

msgid "DLC@PRIMALFURY@PRIMAL_FURY_ABILITY@WOLF_FURY@NAME"
msgstr "Fury of the Sylvan Wolf"

msgid "DLC@PRIMALFURY@PRIMAL_FURY_ABILITY@WOLF_FURY@PROP_DESCRIPTION"
msgstr "+{FURY_WOLF_EXTRA_DAMAGE_COUNTING>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink} per friendly unit adjacent to the target."

msgid "DLC@PRIMALFURY@PRIMAL_FURY_ABILITY@WOLF_STACK@DESCRIPTION"
msgstr "At {amount} stacks, this unit gains {amount} stacks of {GLOBAL.PROPERTIES.FURY_WOLF.Hyperlink}."

