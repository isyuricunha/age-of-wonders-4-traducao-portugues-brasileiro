msgid "ADVICE@RULERKILLED_REMINDER@DESCRIPTION"
msgstr "Your {GLOBAL.LeaderConcept.Hyperlink}, {RulerDead.Name}, has perished in {GLOBAL.CombatConcept.Hyperlink}.[br/][br/] Your Ruler is the most important unit of your {GLOBAL.EmpireConcept.Hyperlink}, since they allow you to cast <<m:{GLOBAL.SpellConcept.Hyperlink}>> in and out of combat. Additionally, when your Ruler is dead, your {GLOBAL.ResearchConcept.Hyperlink} progress will be halted.[br/][br/] If your {GLOBAL.ThroneCityConcept.Hyperlink} is taken while your Ruler is dead, you will be defeated.[br/][br/] Your Ruler will stay in the void for 3 <<m:{GLOBAL.TurnConcept.Hyperlink}>>, before being brought back to life in your Throne City."

msgid "ADVICE@RULERKILLED_REMINDER@INSTRUCTION"
msgstr "Select to check on {RulerDead.Name}"

msgid "ADVICE@RULERKILLED_REMINDER@TITLE"
msgstr "{RulerDead.Name} has been killed"

msgid "ADVICE@RULERRES_REMINDER@TITLE"
