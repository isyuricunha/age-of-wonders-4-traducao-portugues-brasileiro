msgstr "Conjure Amplification Pylon"

msgid "TOME_AMPLIFICATION@SKILL2@DESCRIPTION"
msgstr "Target enemy unit:[bulletlist][bullet/]Sustains {CHAIN_LIGHTNING_DAMAGE>DAMAGE>Shock} {GLOBAL.LightningDamageConcept.Hyperlink}.[bullet/]Is inflicted with {electrifiedCount} {GLOBAL.PROPERTIES.ELECTRIFIED.Hyperlink}.[bullet/]This effect passes on to another enemy within {CHAIN_LIGHTNING_JUMP>MaxDistance} hexes.[bullet/]Passes on up to {CHAIN_LIGHTNING_JUMP>MaxJumps} times.[/bulletlist]"

msgid "TOME_AMPLIFICATION@SKILL2@NAME"
msgstr "Chain Lightning"

msgid "TOME_AMPLIFICATION@SKILL3@DESCRIPTION"
msgstr "Grants enchanted units:[bulletlist][bullet/]{GLOBAL.PROPERTIES.FRENZY.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.NEW_LIFE_STEAL.Hyperlink}[/bulletlist]"

msgid "TOME_AMPLIFICATION@SKILL3@NAME"
