msgstr "Souldraining Strikes"

msgid "TOME_SOULS@PASSIVE2@DESCRIPTION"
msgstr "Grants access to {GLOBAL.UNITS.SKELETON_UNIT.Hyperlink}, an {GLOBAL.PROPERTIES.UNDEAD.Hyperlink} {GLOBAL.PROPERTIES.POLEARM_UNIT.Hyperlink} that costs <<m:{GLOBAL.SoulConcept.Hyperlink}>> to recruit."

msgid "TOME_SOULS@PASSIVE2@NAME"
msgstr "Skeleton"

msgid "TOME_SOULS@PASSIVE@DESCRIPTION"
msgstr "Gain <<m:{GLOBAL.SoulConcept}>> when enemies die in battle.[br/][br/]Unlocks the ability to animate {GLOBAL.CityRuinConcept.Hyperlink} and to animate <<m:{GLOBAL.HeroConcept.Hyperlink}>> in your crypt as your undead servants."

msgid "TOME_SOULS@PASSIVE@NAME"
msgstr "Soul Harvest"

msgid "TOME_SOULS@SKELETON_1@NAME"
msgstr "Skeleton Militia^n"

msgid "TOME_SOULS@SKELETON_2@NAME"
msgstr "Skeleton Warrior^n"

msgid "TOME_SOULS@SKELETON_3@NAME"
msgstr "Skeleton Archer^n"

msgid "TOME_SOULS@SKELETON_4@NAME"
msgstr "Skeleton Mage^n"

msgid "TOME_SOULS@SKILL1@DESCRIPTION"
msgstr "Advanced rites allow the creation of {GLOBAL.UNITS.BONE_GOLEM.Hyperlink}. These can be created in a {GLOBAL.CityConcept} by using <<m:{GLOBAL.SoulConcept}>> or by fusing two {GLOBAL.UNITS.SKELETON_UNIT.Hyperlink} units."

msgid "TOME_SOULS@SKILL1@NAME"
msgstr "Bone Horror"

msgid "TOME_SOULS@SKILL1@SPELL_DESCRIPTION"
msgstr "Creates a {GLOBAL.UNITS.BONE_GOLEM.Hyperlink} by combining two {GLOBAL.UNITS.SKELETON_UNIT.Hyperlink} units."

msgid "TOME_SOULS@SKILL1@SPELL_NAME"
msgstr "Create Bone Horror"

msgid "TOME_SOULS@SKILL2@DESCRIPTION"
msgstr "Target enemy unit:[bulletlist][bullet/]Sustains {SOUL_FIRE_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink} and {SOUL_FIRE_DAMAGE>DAMAGE>Blight} {GLOBAL.BlightDamageConcept.Hyperlink}[bullet/]Gains {amount} stacks of {GLOBAL.PROPERTIES.DECAYING.Hyperlink} for {DECAYING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]When it dies, it becomes a {GLOBAL.UNITS.DECAYING_ZOMBIE.Hyperlink} under your control until the end of combat.[/bulletlist]"

msgid "TOME_SOULS@SKILL2@NAME"
msgstr "Necrotize"

msgid "TOME_SOULS@SKILL3@DESCRIPTION"
msgstr "Enemy units in target army gain {GLOBAL.PROPERTIES.SOULBOUND.Hyperlink} until the next time they are in battle."

msgid "TOME_SOULS@SKILL3@NAME"
msgstr "Soulbind Army"

msgid "TOME_SOULS@SKILL4@DESCRIPTION"
msgstr "Grants enchanted units:[bulletlist][bullet/]Base {SOULBOUND_RESISTANCE_90>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.SOULBOUND.Hyperlink} on attacks, increasing the {GLOBAL.SoulConcept.Hyperlink} gain when the target is killed.[bullet/]+{SOULBINDERS_DAMAGE_MULTIPLIER>ResolvedMultiplier}% damage against units with {GLOBAL.PROPERTIES.SOULBOUND.Hyperlink}.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_SOULS@SKILL4@NAME"
msgstr "Soulbinders"

msgid "TOME_SOULS@SKILL4@PROP_DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]A base {SOULBOUND_RESISTANCE_90>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.SOULBOUND.Hyperlink} on attacks.[bullet/]+{SOULBINDERS_DAMAGE_MULTIPLIER>ResolvedMultiplier}% damage against units that are {GLOBAL.PROPERTIES.SOULBOUND.Hyperlink}.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_SOULS@SKILL5@DESCRIPTION"
msgstr "Friendly units in a {SOUL_OVERFLOW_TARGETER>AREA>Radius}-hex radius:[bulletlist][bullet/]Gain {amount} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}.[bullet/]Gain +{SOUL_OVERFLOW_STAT_BONUS>BONUS>HitPoints} maximum <<m:{GLOBAL.HitPointConcept.Hyperlink}>> until the end of battle.[bullet/]Have {GENERAL_DISPEL_NEGATIVE>NumThingsToDispel} <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>> removed.[/bulletlist]"

msgid "TOME_SOULS@SKILL5@EFFECT@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{SOUL_OVERFLOW_STAT_BONUS>BONUS>HitPoints} maximum <<m:{GLOBAL.HitPointConcept.Hyperlink}>> until the end of battle.[/bulletlist]"

msgid "TOME_SOULS@SKILL5@NAME"
msgstr "Soul Overflow"

msgid "TOME_SOULS@SKILL5@PROP_DESCRIPTION"
msgstr "+{SOUL_OVERFLOW_STAT_BONUS>BONUS>HitPoints} maximum <<m:{GLOBAL.HitPointConcept.Hyperlink}>> until the end of battle."

msgid "TOME_SOULS@SKILL6@DESCRIPTION"
msgstr "[bulletlist][bullet/]Gain +{amount1} <<m:{GLOBAL.SoulConcept.Hyperlink}>> income.[bullet/]Costs {amount2} {GLOBAL.GoldConcept.Hyperlink} upkeep.[/bulletlist]"

msgid "TOME_SOULS@SKILL6@NAME"
msgstr "Soul Collection"

msgid "TOME_SOULS@SKILL7@DESCRIPTION"
msgstr "When killing racial units, gain the option to spend <<m:{GLOBAL.SoulConcept.Hyperlink}>> to create Skeletons after combat."

msgid "TOME_SOULS@SKILL7@NAME"
msgstr "Skeleton Reanimation"

msgid "TOME_SOULS@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Harvest <<m:{GLOBAL.SoulConcept}>> from your enemies and create {GLOBAL.PROPERTIES.UNDEAD.Hyperlink} creatures. Specialize in expendable units and starting your {GLOBAL.SoulConcept} economy."

msgid "TOME_SOULS@TOME@LORE_AUTHOR"
msgstr "Nocrom, the Cursed Hand"

msgid "TOME_SOULS@TOME@LORE_DESCRIPTION"
msgstr "\"Bodies are frail, yet strong is the will of all souls to cling to life. Grant them their desire! Craft them vessels of rotten flesh and bone! Even the fiercest foe shall serve your wishes when raised from the battlefield. For death reaches all, and, in death, you will dwell.\""

msgid "TOME_SOULS@TOME@NAME"
msgstr "Tome of Souls"

msgid "TOME_SOULS@UNIT_1@NAME"
msgstr "Skeleton^n"

msgid "TOME_SOULS@UNIT_2@NAME"
msgstr "Zombie^n"

msgid "TOME_SOULS@UNIT_3@NAME"
msgstr "Decaying Zombie^n"

msgid "TOME_SUBJUGATION@PASSIVE@DESCRIPTION"
msgstr "The time required to absorb or migrate <<m:{GLOBAL.CityConcept}>> is reduced by {turns} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "TOME_SUBJUGATION@PASSIVE@NAME"
msgstr "Swift Subjugation"

msgid "TOME_SUBJUGATION@SKILL1@DESCRIPTION"
msgstr "A heavy {GLOBAL.PROPERTIES.SHOCK_UNIT.Hyperlink} that specializes in lowering {GLOBAL.UnitMoraleConcept.Hyperlink}."

msgid "TOME_SUBJUGATION@SKILL1@NAME"
msgstr "Subjugator^m"

msgid "TOME_SUBJUGATION@SKILL2@DESCRIPTION"
msgstr "Grants enchanted units:[bulletlist][bullet/]{GLOBAL.PROPERTIES.INTIMIDATING_AURA.Hyperlink}, which reduces {GLOBAL.UnitMoraleConcept.Hyperlink} of nearby enemies.[/bulletlist]"

msgid "TOME_SUBJUGATION@SKILL2@NAME"
msgstr "Intimidation Aura"

msgid "TOME_SUBJUGATION@SKILL2@PROPERTY_DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]{GLOBAL.PROPERTIES.INTIMIDATING_AURA.Hyperlink}.[/bulletlist]"

msgid "TOME_SUBJUGATION@SKILL3@DESCRIPTION"
msgstr "[bulletlist][bullet/]When the walls are breached, the besieged {GLOBAL.CityConcept.Hyperlink} loses {populationLost} {GLOBAL.PopulationConcept.Hyperlink}.[bullet/]Closest owned {GLOBAL.CityConcept.Hyperlink} gains {populationGain} {GLOBAL.PopulationConcept.Hyperlink}.[bullet/]At the start of the battle, all enemy units have {morale}{GLOBAL.UnitMoraleConcept.Hyperlink} until the end of battle.[/bulletlist]"

msgid "TOME_SUBJUGATION@SKILL3@NAME"
msgstr "Subjugating Raid"

msgid "TOME_SUBJUGATION@SKILL3@PROPERTY@DESCRIPTION"
msgstr "All enemies start combat with {morale} {GLOBAL.UnitMoraleConcept.Hyperlink}."

msgid "TOME_SUBJUGATION@SKILL4@DESCRIPTION"
msgstr "Target {GLOBAL.RoutingConcept.Hyperlink} non-{GLOBAL.PROPERTIES.HERO.Hyperlink} enemy unit:[bulletlist][bullet/]Has a base {FINAL_ULTIMATUM_RESISTANCE_CHECK>ResolvedStrength}% chance of becoming permanently mind controlled.[bullet/]If successful, it gains +{FINAL_ULTIMATUM_CHANGE_MORALE>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}.[bullet/]If resisted, the unit dies instead.[/bulletlist]"

msgid "TOME_SUBJUGATION@SKILL4@NAME"
msgstr "Final Ultimatum"

msgid "TOME_SUBJUGATION@SKILL5@DESCRIPTION"
msgstr "[bulletlist][bullet/]Can only be built in cities of another race.[bullet/]{gold} {GLOBAL.GoldConcept.Hyperlink} income.[bullet/]{stability} {GLOBAL.CityStabilityConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_SUBJUGATION@SKILL5@NAME"
msgstr "Baron's Palace"

msgid "TOME_SUBJUGATION@SKILL5@STRUCTURE_DESCRIPTION"
msgstr "This city gains:[bulletlist][bullet/]{happinessAmount} {GLOBAL.CityStabilityConcept.Hyperlink}[bullet/]{draftAmount} {GLOBAL.UnitProductionConcept.Hyperlink}[/bulletlist][br/]Your {GLOBAL.ThroneCityConcept.Hyperlink} gains:[bulletlist][bullet/]{goldAmount} {GLOBAL.GoldConcept.Hyperlink}[bullet/]{foodAmount} {GLOBAL.FoodConcept.Hyperlink}[bullet/]{imperiumAmount} {GLOBAL.ImperiumConcept.Hyperlink}[/bulletlist][br/][br/]Can only be built in cities of another race."

msgid "TOME_SUBJUGATION@SKILL6@NAME"
msgstr "Material Refinery"

msgid "TOME_SUBJUGATION@SKILL6@STRUCTURE_DESCRIPTION"
msgstr "Gain {KnowledgeBonus}{GLOBAL.KnowledgeConcept.Hyperlink} and {GoldBonus}{GLOBAL.GoldConcept.Hyperlink}. Gain an additional {KnowledgePerMaterial}{GLOBAL.KnowledgeConcept.Hyperlink} and {GoldPerMaterial}{GLOBAL.GoldConcept.Hyperlink} per {GLOBAL.MagicMaterialConcept.Hyperlink} in this city's {GLOBAL.DomainConcept.Hyperlink}."

msgid "TOME_SUBJUGATION@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Expands and subjugates cities from other races. Specializes in lowering enemy {GLOBAL.UnitMoraleConcept.Hyperlink} and conquering cities."

msgid "TOME_SUBJUGATION@TOME@LORE_AUTHOR"
msgstr "Turiel, Exalted Warden of Grexolis"

msgid "TOME_SUBJUGATION@TOME@LORE_DESCRIPTION"
msgstr "\"To the righteous is given the duty of bringing light unto those still in the dark. Whoever takes on this duty shall be granted the right of might. The errant seed must be ground beneath the heel of virtue before it can grow! Your enemies may cower at first, but your armies shall be ever emboldened by their glorious purpose.\""

msgid "TOME_SUBJUGATION@TOME@NAME"
msgstr "Tome of Subjugation"

msgid "TOME_SUBJUGATION@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Base {DEMOIRALIZING_CHARGE_RESISTANCE_CHECK>ResolvedStrength}% chance of inflicting {DEMOIRALIZING_CHARGE_CHANGE_MORALE>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}."

msgid "TOME_SUBJUGATION@UNIT1@ABILITY1@NAME"
msgstr "Demoralizing Charge Strike"

msgid "TOME_SUBJUGATION@UNIT1@ABILITY2@DESCRIPTION"
msgstr "Target enemy unit has a base {OPPRESS_RESISTANCE_CHECK>ResolvedStrength}% chance of losing {mor1} {GLOBAL.UnitMoraleConcept.Hyperlink}. On failure, loses {mor2} {GLOBAL.UnitMoraleConcept.Hyperlink} instead."

msgid "TOME_SUBJUGATION@UNIT1@ABILITY2@NAME"
msgstr "Oppress"

msgid "TOME_SUMMONING@ABILITY_01@DESCRIPTION"
msgstr "Unit teleports to target hex dealing damage to adjacent units. Then this unit gains {GLOBAL.PROPERTIES.REFUGED.Hyperlink}."

msgid "TOME_SUMMONING@ABILITY_01@NAME"
msgstr "Shattering Refuge"

msgid "TOME_SUMMONING@ABILITY_02@DESCRIPTION"
msgstr "Target friendly unit:[bulletlist][bullet/]Heals +{ASTRAL_BLESSING_UNIT_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Gains {GLOBAL.PROPERTIES.STATIC_CHARGE.Hyperlink} for {STATIC_CHARGE_STATUS_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "TOME_SUMMONING@ABILITY_02@DESCRIPTION_2"
msgstr "Target friendly unit:[bulletlist][bullet/]Heals +{ASTRAL_BLESSING_UNIT_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Loses {dispelAmount} {GLOBAL.NegativeStatusEffectConcept.Hyperlink}.[bullet/]Gains {GLOBAL.PROPERTIES.STATIC_CHARGE.Hyperlink} for {STATIC_CHARGE_STATUS_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "TOME_SUMMONING@ABILITY_02@DESCRIPTION_CHAMPION"
msgstr "Astral Blessing:[bulletlist][bullet/]Heals an additional {healAmount}<<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>[bullet/]Removes {GENERAL_DISPEL_NEGATIVE>NumThingsToDispel} {GLOBAL.NegativeStatusEffectConcept.Hyperlink}[/bulletlist]"

msgid "TOME_SUMMONING@ABILITY_02@NAME"
msgstr "Astral Blessing"

msgid "TOME_SUMMONING@ABILITY_02@NAME_CHAMPION"
msgstr "Champion Astral Blessing"

msgid "TOME_SUMMONING@ABILITY_03@DESCRIPTION"
msgstr "Unit dies:[bulletlist][bullet/]Triggering {GLOBA.PROPERTIES.ASTRAL_TORRENT.Hyperlink}.[bullet/]Heals an additional {amount} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> to friendly units within {amount2} hexes.[/bulletlist]"

msgid "TOME_SUMMONING@ABILITY_03@NAME"
msgstr "Shatter Self"

msgid "TOME_SUMMONING@HERO_SKILL@DESCRIPTION"
msgstr "Start combat with an {GLOBAL.UNITS.ASTRAL_WISP_UNIT.Hyperlink}."

msgid "TOME_SUMMONING@HERO_SKILL@NAME"
msgstr "Wisp Familiar"

msgid "TOME_SUMMONING@PASSIVE@DESCRIPTION"
msgstr "{GLOBAL.CombatSummonSpellConcept.Hyperlink} and {GLOBAL.StrategicSummonSpellConcept.Hyperlink} cost -{amount}% <<m:{GLOBAL.CombatCastingPointConcept.Hyperlink}>>."

msgid "TOME_SUMMONING@PASSIVE@NAME"
msgstr "Conjuration Doctrine"

msgid "TOME_SUMMONING@SKILL1@DESCRIPTION"
msgstr "Target enemy {GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink} unit has a base {ARCANE_BIND_RESISTANCE_CHECK>ResolvedStrength}% chance of becoming {GLOBAL.PROPERTIES.DOMINATED.Hyperlink} for {ARCANE_BIND_MIND_CONTROL>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[br/][br/]If unsuccessful, deals {ARCANE_BIND_UNIT_DAMAGE>DAMAGE>Shock} {GLOBAL.LightningDamageConcept.Hyperlink} instead."

msgid "TOME_SUMMONING@SKILL1@NAME"
msgstr "Arcane Bond"

msgid "TOME_SUMMONING@SKILL2@DESCRIPTION"
msgstr "Heals all friendly {GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink} units +{ARCANE_RESTORATION_UNIT_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>."

msgid "TOME_SUMMONING@SKILL2@NAME"
msgstr "Arcane Restoration"

msgid "TOME_SUMMONING@SKILL3@DESCRIPTION"
msgstr "Summons an {GLOBAL.UNITS.ASTRAL_KEEPER_UNIT.Hyperlink}, a {GLOBAL.PROPERTIES.SUPPORT_UNIT.Hyperlink} that heals units even in death.{LOC.CONCEPT@SUMMON_LIVE_SHARED}"

msgid "TOME_SUMMONING@SKILL3@NAME"
msgstr "Conjure Astral Keeper"

msgid "TOME_SUMMONING@SKILL4@DESCRIPTION"
msgstr "For {STATIC_CHARGE_STATUS_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>, target friendly {GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink} unit gains:[bulletlist][bullet/]{amount} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}[bullet/]{amount2} {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink}[bullet/]{amount3} {GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.STATIC_CHARGE.Hyperlink}[/bulletlist]"

msgid "TOME_SUMMONING@SKILL4@NAME"
msgstr "Arcane Supercharge"

msgid "TOME_SUMMONING@SKILL5@DESCRIPTION"
msgstr "Summons an {GLOBAL.UNITS.ASTRAL_SERPENT_UNIT.Hyperlink}, a {GLOBAL.PROPERTIES.FIGHTER.Hyperlink} that can teleport into the front lines in an explosive manner."

msgid "TOME_SUMMONING@SKILL5@NAME"
msgstr "Summon Astral Serpent"

msgid "TOME_SUMMONING@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Call forth, control, and enhance {GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink} units."

msgid "TOME_SUMMONING@TOME@LORE_AUTHOR"
msgstr "Werlac of Insaldur, Shadowborn Cultist"

msgid "TOME_SUMMONING@TOME@LORE_DESCRIPTION"
msgstr "\"Through the art of summoning, one may become a master in every sense of the word. Call forth arcane minions and bend them to your will. Strengthen their connection to the world and watch as they lay down their existence for you, the one who willed them into being.\""

msgid "TOME_SUMMONING@TOME@NAME"
msgstr "Tome of Summoning"

msgid "TOME_SUMMONING@UNIT_1@NAME"
msgstr "Astral Serpent^n"

msgid "TOME_SUMMONING@UNIT_2@NAME"
msgstr "Astral Keeper^n"

msgid "TOME_SUPREMACY@HERO_SKILL@DESCRIPTION"
msgstr "Causes a unit to explode when killed, dealing {SUPREME_MAGIC_UNIT_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink} to adjacent enemy units."

msgid "TOME_SUPREMACY@HERO_SKILL@NAME"
msgstr "Supreme Magic"

msgid "TOME_SUPREMACY@PASSIVE@DESCRIPTION"
msgstr "<<m:{GLOBAL.IndependentCityConcept.Hyperlink}>> you vassalize gain +{amount} {GLOBAL.HouseInfluenceConcept} level."

msgid "TOME_SUPREMACY@PASSIVE@NAME"
msgstr "Benevolent Conquerors"

msgid "TOME_SUPREMACY@SKILL1@DESCRIPTION"
msgstr "A flying {GLOBAL.PROPERTIES.SHIELD_UNIT.Hyperlink} that excels at increasing the {GLOBAL.UnitMoraleConcept.Hyperlink} of your units."

msgid "TOME_SUPREMACY@SKILL1@NAME"
msgstr "Exemplar^m"

msgid "TOME_SUPREMACY@SKILL2@DESCRIPTION"
msgstr "[bulletlist][bullet/]{unitProduction} {GLOBAL.UnitProductionConcept.Hyperlink}[bullet/]{stability} {GLOBAL.CityStabilityConcept.Hyperlink} per Monument of Supremacy built in your empire[/bulletlist]"

msgid "TOME_SUPREMACY@SKILL2@NAME"
msgstr "Monument of Supremacy"

msgid "TOME_SUPREMACY@SKILL2@STRUCTURE_DESCRIPTION"
msgstr "{stability} {GLOBAL.CityStabilityConcept.Hyperlink} per Monument of Supremacy in your empire."

msgid "TOME_SUPREMACY@SKILL3@DESCRIPTION"
msgstr "Target enemy army:[bulletlist][bullet/]Takes {damage} {GLOBAL.SpiritDamageConcept.Hyperlink}[bullet/]Becomes {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink} for {turn} {GLOBAL.WorldMapConcept.Hyperlink} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "TOME_SUPREMACY@SKILL3@NAME"
msgstr "Condemn Army"

msgid "TOME_SUPREMACY@SKILL4@DESCRIPTION"
msgstr "For enchanted units:[bulletlist][bullet/]Grants {GLOBAL.PROPERTIES.ZEAL.Hyperlink}, which makes attacks deal extra {GLOBAL.SpiritDamageConcept.Hyperlink}.[bullet/]Attacks ignore {SUPREME_MAGIC_RESISTANCE_CHECK_BYPASS>ResistanceBypass} {GLOBAL.StatusResistanceConcept.Hyperlink}.[bullet/]Killing a unit causes it to explode, dealing {SUPREME_MAGIC_UNIT_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink} to adjacent enemy units.[/bulletlist]"

msgid "TOME_SUPREMACY@SKILL4@MODIFIER_DESCRIPTION"
msgstr "Killing a unit causes it to explode, dealing {SUPREME_MAGIC_UNIT_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink} to adjacent enemy units."

msgid "TOME_SUPREMACY@SKILL4@NAME"
msgstr "Supreme Magic"

msgid "TOME_SUPREMACY@SKILL4@PROPERTY_DESCRIPTION"
msgstr "[bulletlist][bullet/]Unit has {GLOBAL.PROPERTIES.ZEAL.Hyperlink}.[bullet/]Attacks ignore {SUPREME_MAGIC_RESISTANCE_CHECK_BYPASS>ResistanceBypass} {GLOBAL.StatusResistanceConcept.Hyperlink}.[bullet/]Killing a unit causes it to explode, dealing {SUPREME_MAGIC_UNIT_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink} to adjacent enemy units.[/bulletlist]"

msgid "TOME_SUPREMACY@SKILL5@DESCRIPTION"
msgstr "All allied units gain:[bulletlist][bullet/]{strengthened} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}.[bullet/]+{ANTHEM_OF_VICTORY_CHANGE_MORALE>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_SUPREMACY@SKILL5@NAME"
msgstr "Anthem of Victory"

msgid "TOME_SUPREMACY@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Lead your people to glorious victory. Specialize in increasing {GLOBAL.UnitMoraleConcept.Hyperlink.} and managing a big empire."

msgid "TOME_SUPREMACY@TOME@LORE_AUTHOR"
msgstr "Inioch, Emperor of the Elven Court"

msgid "TOME_SUPREMACY@TOME@LORE_DESCRIPTION"
msgstr "\"We, who seek to shepherd and guide our people, are gifted with glorious purpose. This righteous glory surges from our very being, permeating into the flesh and spirit of our subjects, and inspiring them to greatness! Victory, for those on this divine path, is not a possibility, but a certainty.\""

msgid "TOME_SUPREMACY@TOME@NAME"
msgstr "Tome of Supremacy"

msgid "TOME_SUPREMACY@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Friendly units within a {EMBOLDEN_ALLIES_CIRCLE_AROUND_CASTER>AREA>Radius}-hex radius gain, for {RALLYING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>:[bulletlist][bullet/]{amount} {GLOBAL.PROPERTIES.RALLYING.Hyperlink}.[bullet/]{strengthened} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}.[/bulletlist][br/]Enter {GLOBAL.DefenseModeConcept.Hyperlink}."

msgid "TOME_SUPREMACY@UNIT1@ABILITY1@NAME"
msgstr "Embolden Allies"

msgid "TOME_SUPREMACY@UNIT1@ABILITY2@DESCRIPTION"
msgstr "While in combat, this and all other friendly units have a +{INSPIRING_PRESENCE_MORALE_RESISTANCE>ResolvedMoraleRiseModifier}% modifier to positive {GLOBAL.UnitMoraleConcept.Hyperlink} gain.[br/][br/]This effect doesn't stack."

msgid "TOME_SUPREMACY@UNIT1@ABILITY2@NAME"
msgstr "Inspiring Presence"

msgid "TOME_SUPREMACY@UNIT1@ABILITY2@PROPERTY@NAME"
msgstr "Inspired"

msgid "TOME_SUPREMACY@UNIT1@ABILITY2@PROPERY@DESCRIPTION"
msgstr "Gains {GLOBAL.UnitMoraleConcept.Hyperlink} {INSPIRING_PRESENCE_MORALE_RESISTANCE>ResolvedMoraleRiseModifier}% faster."

msgid "TOME_TELEPORTATION@HERO_SKILL@DESCRIPTION"
msgstr "Makes the caster teleport to target hex."

msgid "TOME_TELEPORTATION@HERO_SKILL@NAME"
msgstr "Quick Phase"

msgid "TOME_TELEPORTATION@PASSIVE@DESCRIPTION"
msgstr "All <<m:{GLOBAL.ProvinceConcept}>> can be set as a City's army Spawn point."

msgid "TOME_TELEPORTATION@PASSIVE@NAME"
msgstr "Deployment Portals"

msgid "TOME_TELEPORTATION@SKILL1@DESCRIPTION"
msgstr "Makes target friendly army teleport back to the nearest owned city."

msgid "TOME_TELEPORTATION@SKILL1@NAME"
msgstr "Mass Recall"

msgid "TOME_TELEPORTATION@SKILL2@DESCRIPTION"
msgstr "Summons a {GLOBAL.UNITS.PHASE_BEAST_UNIT.Hyperlink} onto the target world hex."

msgid "TOME_TELEPORTATION@SKILL2@NAME"
msgstr "Summon Phase Beast"

msgid "TOME_TELEPORTATION@SKILL3@DESCRIPTION"
msgstr "Teleport the closest allied unit within {EMERGENCY_TELEPORTATION_UNIT_TARGETER_NEAREST_TO_TARGET>MaxDista} hexes to target empty hex.[br/]That unit heals +{EMERGENCY_TELEPORTATION_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> and has all <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>> removed."

msgid "TOME_TELEPORTATION@SKILL3@NAME"
msgstr "Emergency Teleportation"

msgid "TOME_TELEPORTATION@SKILL4@DESCRIPTION"
msgstr "Grants enchanted units:[bulletlist][bullet/]The {GLOBAL.PROPERTIES.CHARGED_PHASE_TELEPORT.Hyperlink} ability, which allows them to teleport in battle.[/bulletlist]"

msgid "TOME_TELEPORTATION@SKILL4@NAME"
msgstr "Phasing Enchantment"

msgid "TOME_TELEPORTATION@SKILL4@PROPERTY_DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]The {GLOBAL.PROPERTIES.CHARGED_PHASE_TELEPORT.Hyperlink} ability.[/bulletlist]"

msgid "TOME_TELEPORTATION@SKILL5@DESCRIPTION"
msgstr "[bulletlist][bulletlist][bullet/]{gold} {GLOBAL.GoldConcept.Hyperlink} income.[bullet/]{goldStack} {GLOBAL.GoldConcept.Hyperlink} income for each Astral Trade Relay built in your empire.[/bulletlist][/bulletlist]"

msgid "TOME_TELEPORTATION@SKILL5@NAME"
msgstr "Astral Trade Relay"

msgid "TOME_TELEPORTATION@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Exploit spatial magic to its full potential. Strategically reposition your units in battle in a mere instant."

msgid "TOME_TELEPORTATION@TOME@LORE_AUTHOR"
msgstr "Laryssa Mirabilis, Sorceress of the Commonwealth"

msgid "TOME_TELEPORTATION@TOME@LORE_DESCRIPTION"
msgstr "\"The mage who fully utilizes the potential of magic to expand their tactical options on the field of battle... that is a cunning mage. Imagine a hapless commander, all prepared for an oncoming assault, only to suddenly find themselves facing a pincer attack. The art of teleportation provides endless possibilities for the truly creative tactician.\""

msgid "TOME_TELEPORTATION@TOME@NAME"
msgstr "Tome of Teleportation"

msgid "TOME_TELEPORTATION@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Performs a Phasing Charge attack which:[bulletlist][bullet/]Teleports the unit behind the target.{LOC.CONCEPT@CHARGE_SHARED}[/bulletlist]"

msgid "TOME_TELEPORTATION@UNIT1@ABILITY1@NAME"
msgstr "Phasing Charge"

msgid "TOME_TELEPORTATION@UNIT1@DESCRIPTION"
msgstr "An elusive and fast shock unit, capable of teleportation."

msgid "TOME_TELEPORTATION@UNIT1@NAME"
msgstr "Phase Beast^n"

msgid "TOME_TERRA@@SKILL6@NAME"
msgstr "Lower Mountains"

msgid "TOME_TERRA@HERO_SKILL@DESCRIPTION"
msgstr "Makes base {GLOBAL.MeleeConcept.Hyperlink} attacks gain:[bulletlist][bullet/]+{LEADEN_BLOW_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Base {SLOWED_RESISTANCE>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.SLOWED.Hyperlink}.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_TERRA@HERO_SKILL@NAME"
msgstr "Leaden Blows"

msgid "TOME_TERRA@SKILL1@DESCRIPTION"
msgstr "Target enemy unit:[bulletlist][bullet/]Sustains {CRUSHING_EARTH_UNIT_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Suffers {amount} {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink} for {SUNDERED_DEFENSE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Has a base {STUNNED_RESISTANCE>ResolvedStrength}% chance of becoming {GLOBAL.PROPERTIES.STUNNED.Hyperlink} for {STUNNED_EFFECT_DESCRIPTION>NumTurns} {GLOBAL.TurnConcept}.[/bulletlist]"

msgid "TOME_TERRA@SKILL1@NAME"
msgstr "Crushing Earth"

msgid "TOME_TERRA@SKILL2@DESCRIPTION"
msgstr "Deals {SEISMIC_SHOCK_UNIT_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink} to units in a {SEISMIC_SHOCK_OBSTACLE_TARGETER>AREA>Radius}-hex radius and inflicts {GLOBAL.PROPERTIES.SLOWED.Hyperlink}.[br/]This spell deals double damage to obstacles."

msgid "TOME_TERRA@SKILL2@NAME"
msgstr "Seismic Shock"

msgid "TOME_TERRA@SKILL3@DESCRIPTION"
msgstr "In target habitable or uninhabitable {GLOBAL.ProvinceConcept.Hyperlink}:[bulletlist][bullet/]Enemy <<m:{GLOBAL.UnitConcept.Hyperlink}>> sustain {damage}.[bullet/]The province loses any {GLOBAL.MountainConcept.Hyperlink}, {GLOBAL.StalagmitesConcept.Hyperlink}, and {GLOBAL.DiggableEarthConcept.Hyperlink}.[bullet/]Summon a {GLOBAL.UNITS.STONE_SPIRIT.Hyperlink} on the target hex.[/bulletlist]"

msgid "TOME_TERRA@SKILL3@NAME"
msgstr "Earth Shatter"

msgid "TOME_TERRA@SKILL4@DESCRIPTION"
msgstr "[bulletlist][bullet/]In battle, every {turn} a random enemy unit is struck by an earthquake:[bulletlist][bullet/]Enemy non-flying, non-floating units within {range}-hex radius take {damage}.[bullet/]Enemy non-flying, non-floating units within {range}-hex radius have {chance} chance of suffering {GLOBAL.PROPERTIES.SLOWED.Hyperlink} for {turn2}.[bullet/]Obstacles, including Walls, Towers, and Battlements within {range}-hex radius are destroyed.[/bulletlist][/bulletlist]"

msgid "TOME_TERRA@SKILL4@NAME"
msgstr "Tremor Ritual"

msgid "TOME_TERRA@SKILL5@DESCRIPTION"
msgstr "Summons a {GLOBAL.UNITS.ROCK_GIANT.Hyperlink}, a {GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink} that throws boulders that hinder enemies and crushes them with earthquake like smashes."

msgid "TOME_TERRA@SKILL5@NAME"
msgstr "Summon Rock Giant"

msgid "TOME_TERRA@SKILL6@BUFF_DESCRIPTION"
msgstr "Until the unit moves it has:[bulletlist][bullet/]+{LEY_LINE_FOCUS_DAMAGE_MULT>ResolvedMultiplier}% damage[bullet/]+{LEY_LINE_FOCUS_DEFENSE>DEF_MOD>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_TERRA@SKILL6@DESCRIPTION"
msgstr "Enchanted units gain:[bulletlist][bullet/]At the start of the turn and until the unit moves this unit has:[bulletlist][bullet/]+{LEY_LINE_FOCUS_DAMAGE_MULT>ResolvedMultiplier}% damage[bullet/]+{LEY_LINE_FOCUS_DEFENSE>DEF_MOD>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}.[/bulletlist][/bulletlist]"

msgid "TOME_TERRA@SKILL6@MOD_DESCRIPTION"
msgstr "+{LEY_LINE_FOCUS_DAMAGE_MULT>ResolvedMultiplier}% damage until moved."

msgid "TOME_TERRA@SKILL6@NAME"
msgstr "Ley Line Focus"

msgid "TOME_TERRA@SKILL6@PROP_DESCRIPTION"
msgstr "At the start of the turn and until the unit moves, this unit has:[bulletlist][bullet/]+{LEY_LINE_FOCUS_DAMAGE_MULT>ResolvedMultiplier}% damage[bullet/]+{LEY_LINE_FOCUS_DEFENSE>DEF_MOD>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}[/bulletlist]"

msgid "TOME_TERRAMANCY@PASSIVE@DESCRIPTION"
msgstr "<<m:{GLOBAL.CityConcept}>> gain {amount} {GLOBAL.FortificationHealthConcept} per Rocky {GLOBAL.ProvinceConcept}."

msgid "TOME_TERRAMANCY@PASSIVE@NAME"
msgstr "Earthshapers"

msgid "TOME_TERRAMANCY@TOME@GAMEPLAY"
msgstr "Manipulate the earth at will. Specialize in dealing {GLOBAL.PhysicalDamageConcept.Hyperlink} and hindering enemy Movement."

msgid "TOME_TERRAMANCY@TOME@LORE"
msgstr "\"Ignore the middling mages who seek to raise the dead or harness lightning and fire to hurl at you. These fools know not the power resting beneath their own feet! But they will... in the final moments of their insignificant existences, when you bury them beneath a mountain and rend the land beneath their cities.\""

msgid "TOME_TERRAMANCY@TOME@LORE_AUTHOR"
msgstr "Mother Mab, Goddess of Goblins"

msgid "TOME_TERRAMANCY@TOME@NAME"
msgstr "Tome of Terramancy"

msgid "TOME_TRANSMUTATION@PASSIVE@DESCRIPTION"
msgstr "Quarries grant {amount} {GLOBAL.FoodConcept}."

msgid "TOME_TRANSMUTATION@PASSIVE@NAME"
msgstr "Transustenance"

msgid "TOME_TRANSMUTATION@SKILL1@DESCRIPTION"
msgstr "Once per {GLOBAL.TurnConcept}, whenever enchanted units are damaged by {GLOBAL.MagicConcept.Hyperlink} attacks or spells, they gain:[bulletlist][bullet/]{GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink}, increasing their resistance to magical damage.[bullet/]{GLOBAL.PROPERTIES.STATUS_PROTECTION.Hyperlink}, reducing the chance that the unit will be affected by <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>>.[/bulletlist]"

msgid "TOME_TRANSMUTATION@SKILL1@NAME"
msgstr "Adaptive Armor"

msgid "TOME_TRANSMUTATION@SKILL1@PROP_DESCRIPTION"
msgstr "Once per {GLOBAL.TurnConcept}, when this unit is damaged by {GLOBAL.MagicConcept.Hyperlink} attacks or spells it gains:[bulletlist][bullet/]{GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.STATUS_PROTECTION.Hyperlink}[/bulletlist]"

msgid "TOME_TRANSMUTATION@SKILL2@DESCRIPTION"
msgstr "Target owned city converts their {GLOBAL.ManaConcept} income, gaining {GLOBAL.GoldConcept}, {GLOBAL.StructureProductionConcept}, and {GLOBAL.FoodConcept} income equal to {amount}% of the {GLOBAL.ManaConcept} income."

msgid "TOME_TRANSMUTATION@SKILL2@NAME"
msgstr "Transmute Resources"

msgid "TOME_TRANSMUTATION@SKILL3@DESCRIPTION"
msgstr "Target enemies in a {MELT_ARMOR_OBSTACLE_TARGETER_CIRCLE>AREA>Radius}-hex radius:[bulletlist][bullet/]Gain {stacks} {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink}.[bullet/]Sustain {MELT_ARMOR_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_TRANSMUTATION@SKILL3@NAME"
msgstr "Melt Armor"

msgid "TOME_TRANSMUTATION@SKILL4@DESCRIPTION"
msgstr "A {GLOBAL.PROPERTIES.BATTLE_MAGE.Hyperlink} that turns enemies to gold and can steal their armor and grant it to friendly units."

msgid "TOME_TRANSMUTATION@SKILL4@NAME"
msgstr "Transmuter"

msgid "TOME_TRANSMUTATION@SKILL5@DESCRIPTION"
msgstr "Transmutes the target race's skin into steel, granting them:[bulletlist][bullet/]+{STEELSKIN_DEFENSE>REDUCTION>Physical} {GLOBAL.PhysicalResistanceConcept.Hyperlink}.[bullet/]+{STEELSKIN_DEFENSE>REDUCTION>Blight} {GLOBAL.BlightResistanceConcept.Hyperlink}[bullet/]{STEELSKIN_DEFENSE>REDUCTION>Shock} {GLOBAL.LightningResistanceConcept.Hyperlink}[/bulletlist]"

msgid "TOME_TRANSMUTATION@SKILL5@NAME"
msgstr "Steel Skin"

msgid "TOME_TRANSMUTATION@SKILL5@PROP_DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]+{STEELSKIN_DEFENSE>REDUCTION>Physical} {GLOBAL.PhysicalResistanceConcept.Hyperlink}.[bullet/]+{STEELSKIN_DEFENSE>REDUCTION>Blight} {GLOBAL.BlightResistanceConcept.Hyperlink}.[bullet/]{STEELSKIN_DEFENSE>REDUCTION>Shock} {GLOBAL.LightningResistanceConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_TRANSMUTATION@TOME@GAMEPLAY@DESCRIPTION"
msgstr "Change physical substances using vast amounts of mana. Specialize in debuffing enemies, buffing allies, and changing your economy."

msgid "TOME_TRANSMUTATION@TOME@LORE@AUTHOR"
msgstr "Tugrum Hammerhall, Dwarven Master Artificer"

msgid "TOME_TRANSMUTATION@TOME@LORE@DESCRIPTION"
msgstr "\"Once mastery of the mineral realm has been achieved, one may bring about the truly wondrous. Imagine the ability to manipulate and alter the very nature of the physical. To look at a substance, and decide \"be not this thing, be that instead.\" And thus one may begin to grasp what can be achieved by harnessing the many gifts of transmutation.\""

msgid "TOME_TRANSMUTATION@TOME@NAME"
msgstr "Tome of Transmutation"

msgid "TOME_TRANSMUTATION@UNIT1@ABILITY1@BOLT_NAME"
msgstr "Molten Bolts"

msgid "TOME_TRANSMUTATION@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Inflicts {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink} while granting {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink} to a random ally within {SHIFT_ARMOR_UNIT_TARGETER_JUMP>MaxDistance} hexes."

msgid "TOME_TRANSMUTATION@UNIT1@ABILITY1@NAME"
msgstr "Shift Armor"

msgid "TOME_TRANSMUTATION@UNIT1@ABILITY2@DESCRIPTION"
msgstr "Enemy units in a {TRANSMUTE_UNIT_TARGETER_CIRCLE>AREA>Radius}-hex radius:[bulletlist][bullet/]Sustain damage.[bullet/]Gain {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink} for {SUNDERED_DEFENSE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Gain {GLOBAL.PROPERTIES.SUNDERED_RESISTANCE.Hyperlink} for {SUNDERED_RESISTANCE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][br/]If successful, grant {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink} and {GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink} for {SUNDERED_DEFENSE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>> to all friendly units within {TRANSMUTE_CIRCLE_ROUND_CASTER>AREA>Radius}-hexes of the caster."

msgid "TOME_TRANSMUTATION@UNIT1@ABILITY2@MASTER_DESCRIPTION"
msgstr "Enemy units in a {TRANSMUTE_UNIT_TARGETER_CIRCLE>AREA>Radius}-hex radius:[bulletlist][bullet/]Sustain damage.[bullet/]Gain {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink} for {SUNDERED_DEFENSE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Have a base {GILDED_RESISTANCE>ResolvedStrength}% chance of becoming {GLOBAL.PROPERTIES.GILDED.Hyperlink} for {GILDED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][br/]If successful, grant {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink} for {SUNDERED_DEFENSE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>> to all friendly units within {TRANSMUTE_CIRCLE_ROUND_CASTER>AREA>Radius} hexes of the caster."

msgid "TOME_TRANSMUTATION@UNIT1@ABILITY2@MASTER_NAME"
msgstr "Champion Transmute"

msgid "TOME_TRANSMUTATION@UNIT1@ABILITY2@MASTER_PROP_DESCRIPTION"
msgstr "Transmute:[bulletlist][bullet/]Gains a base {GILDED_RESISTANCE>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.GILDED.Hyperlink} to enemies.[/bulletlist]"

msgid "TOME_TRANSMUTATION@UNIT1@ABILITY2@NAME"
msgstr "Transmute"

msgid "TOME_TRANSMUTATION@UNIT@NAME"
msgstr "Transmuter^f"

msgid "TOME_UNDEATH@UNIT_2@NAME"
msgstr "Zombie"

msgid "TOME_VIGOR@HERO_SKILL@DESCRIPTION"
msgstr "While this unit is the leader of the army, non-hero units gain:[bulletlist][bullet/]+{VIGOROUS_LEADER_STAT_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]Heal +{VIGOROUS_LEADER_STAT_BONUS>BONUS>Regen} <<m:{GLOBAL.HitPointConcept.Hyperlink}>> per turn on the world map.[/bulletlist]"

msgid "TOME_VIGOR@HERO_SKILL@NAME"
msgstr "Vigorous Leader"

msgid "TOME_VIGOR@PASSIVE@DESCRIPTION"
msgstr "<<m:{GLOBAL.NodeConcept}>> in your {GLOBAL.DomainConcept} grant {amount} {GLOBAL.FoodConcept.Hyperlink} and {GLOBAL.UnitProductionConcept.Hyperlink}."

msgid "TOME_VIGOR@PASSIVE@NAME"
msgstr "Ancient Gardens"

msgid "TOME_VIGOR@SKILL1@DESCRIPTION"
msgstr "Target {GLOBAL.PROPERTIES.ANIMAL.Hyperlink} or {GLOBAL.PROPERTIES.CAVALRY_GROUP.Hyperlink} unit gains, for {UNLEASH_BEAST_STATUS_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>:[bulletlist][bullet/]{amount2} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}[bullet/]{amount3} {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.BERSERK.Hyperlink}.[/bulletlist]"

msgid "TOME_VIGOR@SKILL1@NAME"
msgstr "Unleash Beast"

msgid "TOME_VIGOR@SKILL2@DESCRIPTION"
msgstr "[bulletlist][bullet/]Choose a Tier III or Tier IV {GLOBAL.PROPERTIES.ANIMAL.Hyperlink} unit to add to your army.[bullet/]The available <<m:{GLOBAL.PROPERTIES.ANIMAL.Hyperlink}>> depend on the type of terrain the spell is cast on.[/bulletlist]"

msgid "TOME_VIGOR@SKILL2@NAME"
msgstr "Call Greater Animal"

msgid "TOME_VIGOR@SKILL3@DESCRIPTION"
msgstr "Makes the target race grow in mass and stature, granting them:[bulletlist][bullet/]+{SUPERGROWTH_STAT_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[bullet/]+{VIGILANT_NUM_OVERWATCH>NumTriggersToAdd} {GLOBAL.RetaliationConcept.Hyperlink}.[bullet/]Decreased number of units in formation.[/bulletlist][br/]This transformation is incompatible with {GLOBAL.PROPERTIES.SPAWNKIN_PROPERTY_GROUP.Hyperlink}."

msgid "TOME_VIGOR@SKILL3@NAME"
msgstr "Supergrowth"

msgid "TOME_VIGOR@SKILL3@PROP_DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]+{SUPERGROWTH_STAT_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]+{VIGILANT_NUM_OVERWATCH>NumTriggersToAdd} {GLOBAL.RetaliationConcept.Hyperlink}[/bulletlist]"

msgid "TOME_VIGOR@SKILL4@DESCRIPTION"
msgstr "Makes enchanted units:[bulletlist][bullet/]Deal +{EMPOWERED_BEASTS_DAMAGE_MULTIPLIER>ResolvedMultiplier}% damage.[bullet/]Gain +{EMPOWERED_BEASTS_HP_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[bullet/]Gain {GLOBAL.PROPERTIES.DEMOLISHER.Hyperlink}, making them able to destroy reinforced obstacles.[bullet/]Decreased number of units in formation.[/bulletlist]"

msgid "TOME_VIGOR@SKILL4@NAME"
msgstr "Empowered Beasts"

msgid "TOME_VIGOR@SKILL4@PROP_DESCRIPTION"
msgstr "Enchanted unit:[bulletlist][bullet/]Deals +{EMPOWERED_BEASTS_DAMAGE_MULTIPLIER>ResolvedMultiplier}% damage.[bullet/]Gains +{EMPOWERED_BEASTS_HP_BONUS>BONUS>HitPoints}<<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[bullet/]Gains {GLOBAL.PROPERTIES.DEMOLISHER.Hyperlink}.[/bulletlist]"

msgid "TOME_VIGOR@SKILL5@DESCRIPTION"
msgstr "Summons a {GLOBAL.UNITS.TOTEM_OF_THE_WILD_UNIT.Hyperlink}, which spawns a random Tier I or II animal unit when it's created and at the start of your next {count} <<m:{GLOBAL.TurnConcept}>>.[br/][br/]{LOC.TACTICAL@ABILITY@NEVER_IN_WATER}"

msgid "TOME_VIGOR@SKILL5@NAME"
msgstr "Totem of the Wild^n"

msgid "TOME_VIGOR@SKILL5@PROP_DESCRIPTION"
msgstr "At the start of each {GLOBAL.TurnConcept.Hyperlink}, summons a random Tier I or II Animal unit.{LOC.CONCEPT@SUMMON_LIVE_SHARED}"

msgid "TOME_VIGOR@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Strengthen your units and armies with the brute power of wild beasts. Specialize in buffing <<m:{GLOBAL.PROPERTIES.ANIMAL.Hyperlink}>> and increasing <<m:{GLOBAL.HitPointConcept}>>."

msgid "TOME_VIGOR@TOME@LORE_AUTHOR"
msgstr "Zaethyl, Wild Guardian of the First Elves"

msgid "TOME_VIGOR@TOME@LORE_DESCRIPTION"
msgstr "\"The unbridled power of the herd thundering over the plain, the sheer strength of the mighty bear as it closes in upon its prey. Hear the primal music that beats in the sinews and bones of beasts! Then you will be able to harness it and strengthen your pack with the force of nature itself.\""

msgid "TOME_VIGOR@TOME@NAME"
msgstr "Tome of Vigor"

msgid "TOME_VIGOR@UNIT1@NAME"
msgstr "Totem of the Wild"

msgid "TOME_WARDING@HERO_SKILL@DESCRIPTION"
msgstr "{GLOBAL.SupportConcept.Hyperlink} abilities grant {amount} {GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink} to affected units."

msgid "TOME_WARDING@HERO_SKILL@NAME"
msgstr "Bolstering Support"

msgid "TOME_WARDING@PASSIVE@DESCRIPTION"
msgstr "<<m:{GLOBAL.BuffSpellConcept.Hyperlink}>> cost -{amount} <<m:{GLOBAL.CombatCastingPointConcept.Hyperlink}>>."

msgid "TOME_WARDING@PASSIVE@NAME"
msgstr "Warding Adepts"

msgid "TOME_WARDING@SKILL1@DESCRIPTION"
msgstr "Target friendly unit:[bulletlist][bullet/]Becomes {GLOBAL.PROPERTIES.INVULNERABLE.Hyperlink} for {amount} {GLOBAL.TurnConcept}.[bullet/]Has their <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>> removed.[/bulletlist][br/]Cannot be used on a unit more than once per battle."

msgid "TOME_WARDING@SKILL1@NAME"
msgstr "Mark of Invulnerability"

msgid "TOME_WARDING@SKILL2@DESCRIPTION"
msgstr "Makes {GLOBAL.SupportConcept.Hyperlink} abilities of enchanted units:[bulletlist][bullet/]Grant +{amount} {GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink} to affected units.[/bulletlist]"

msgid "TOME_WARDING@SKILL2@MOD_DESCRIPTION"
msgstr "Target gains {amount} {GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink}."

msgid "TOME_WARDING@SKILL2@NAME"
msgstr "Staves of Warding"

msgid "TOME_WARDING@SKILL2@PROPERRTY_DESCRIPTION"
msgstr "{GLOBAL.SupportConcept.Hyperlink} abilities grant +{amount} {GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink} to affected units."

msgid "TOME_WARDING@SKILL3@DESCRIPTION"
msgstr "Summons a {GLOBAL.UNITS.PHANTASM_WARRIOR_UNIT.Hyperlink}, a {GLOBAL.PROPERTIES.SHIELD_UNIT.Hyperlink} that strikes with {GLOBAL.LightningDamageConcept.Hyperlink}."

msgid "TOME_WARDING@SKILL3@NAME"
msgstr "Summon Phantasm Warrior"

msgid "TOME_WARDING@SKILL4@DESCRIPTION"
msgstr "Target friendly unit and another within {STATIC_SHIELD_UNIT_TARGETER_JUMP>MaxDistance} hexes gain {GLOBAL.PROPERTIES.STATIC_SHIELD_GROUP.Hyperlink} for {STATIC_SHIELD_STATUS_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "TOME_WARDING@SKILL4@NAME"
msgstr "Static Shield"

msgid "TOME_WARDING@SKILL4@PROP_DESCRIPTION"
msgstr "Attackers have a base {STUNNED_RESISTANCE>ResolvedStrength}% chance of becoming {GLOBAL.PROPERTIES.STUNNED.Hyperlink}."

msgid "TOME_WARDING@SKILL5@DESCRIPTION"
msgstr "Inscribes magical wards onto the target race, granting:[bulletlist][bullet/]+{MAGIAL_WARDS_RESISTANCE>REDUCTION>Shock} {GLOBAL.LightningResistanceConcept.Hyperlink}[bullet/]+{MAGIAL_WARDS_RESISTANCE>REDUCTION>Fire} {GLOBAL.FireResistanceConcept.Hyperlink}[bullet/]+{MAGIAL_WARDS_RESISTANCE>REDUCTION>Frost} {GLOBAL.FrostResistanceConcept.Hyperlink}[/bulletlist]"

msgid "TOME_WARDING@SKILL5@NAME"
msgstr "Magical Wards"

msgid "TOME_WARDING@SKILL5@PROPERTY_DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]+{MAGIAL_WARDS_RESISTANCE>REDUCTION>Shock} {GLOBAL.LightningResistanceConcept.Hyperlink}[bullet/]+{MAGIAL_WARDS_RESISTANCE>REDUCTION>Fire} {GLOBAL.FireResistanceConcept.Hyperlink}[bullet/]+{MAGIAL_WARDS_RESISTANCE>REDUCTION>Frost} {GLOBAL.FrostResistanceConcept.Hyperlink}[/bulletlist]"

msgid "TOME_WARDING@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Specialize in magic that protects your units from damage and retaliates against enemies that attack you."

msgid "TOME_WARDING@TOME@LORE_AUTHOR"
msgstr "Tempest, Master of Storms"

msgid "TOME_WARDING@TOME@LORE_DESCRIPTION"
msgstr "\"Those who master the arcane are as a soothing breeze upon their allies, cushioning them in a protective blanket of air, buffeting away blows, and harnessing the lightning to smite those who dare to come too close! A master of warding will find a myriad of ways to keep their subjects safe.\""

msgid "TOME_WARDING@TOME@NAME"
msgstr "Tome of Warding"

msgid "TOME_WARDING@UNIT@NAME"
msgstr "Phantasm Warrior"

msgid "TOME_WILD@BEASTMASTER@ABILITY_1@DESCRIPTION"
msgstr "For {UNLEASH_THE_BEAST_STATUS_EFFETC_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>, target friendly {GLOBAL.PROPERTIES.ANIMAL.Hyperlink} unit gains:[bulletlist][bullet/]{GLOBAL.PROPERTIES.KILLING_MOMENTUM.Hyperlink}[bullet/]{strengthened} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}[bullet/]{regen} {GLOBAL.PROPERTIES.REGENERATION.Hyperlink}[/bulletlist]"

msgid "TOME_WILD@BEASTMASTER@ABILITY_1@NAME"
msgstr "Unleash the Beast"

msgid "TOME_WILD@BEASTMASTER@ABILITY_2@DESCRIPTION"
msgstr "Summon a random Tier I animal unit.{LOC.CONCEPT@SUMMON_LIVE_SHARED}[br/][br/]Enter {GLOBAL.DefenseModeConcept.Hyperlink} after use."

msgid "TOME_WILD@BEASTMASTER@ABILITY_2@DESCRIPTION_2"
msgstr "Summon a random Tier II animal unit.{LOC.CONCEPT@SUMMON_LIVE_SHARED}[br/][br/]Enter {GLOBAL.DefenseModeConcept.Hyperlink} after use."

msgid "TOME_WILD@BEASTMASTER@ABILITY_2@DESCRIPTION_CHAMPION"
msgstr "Conjure Animal:[bulletlist][bullet/]Now summons a Tier II animal.[/bulletlist]"

msgid "TOME_WILD@BEASTMASTER@ABILITY_2@NAME"
msgstr "Conjure Animal"

msgid "TOME_WILD@BEASTMASTER@ABILITY_2@NAME_CHAMPION"
msgstr "Champion Conjure Animal"

msgid "TOME_WILD@BEASTMASTER@ABILITY_3@DESCRIPTION"
msgstr "Animals in this army require {CARETAKER_UPKEEP_MODIFIER>ResolvedUpkeepModifier}% less base {GLOBAL.UnitUpkeepConcept.Hyperlink}."

msgid "TOME_WILD@BEASTMASTER@ABILITY_3@NAME"
msgstr "Caretaker"

msgid "TOME_WILD@HERO_SKILL@DESCRIPTION"
msgstr "While this unit is the army leader, grants other {GLOBAL.PROPERTIES.CAVALRY_GROUP.Hyperlink} and {GLOBAL.PROPERTIES.ANIMAL.Hyperlink} units:[bulletlist][bullet/]{GLOBAL.PROPERTIES.FLANKER.Hyperlink}[bullet/]+{PACK_LEADER_CRIT_CHANCE>ResolvedCritChanceBonus}% {GLOBAL.CriticalHitChanceConcept.Hyperlink}[/bulletlist]"

msgid "TOME_WILD@HERO_SKILL@NAME"
msgstr "Pack Leader"

msgid "TOME_WILD@HERO_SKILL@PROPERTY@DESCRIPTION"
msgstr "[bulletlist][bullet/]{GLOBAL.PROPERTIES.FLANKER.Hyperlink}[bullet/]+{PACK_LEADER_CRIT_CHANCE>ResolvedCritChanceBonus}% {GLOBAL.CriticalHitChanceConcept.Hyperlink}[/bulletlist]"

msgid "TOME_WILD@HERO_SKILL@PROPERTY@NAME"
msgstr "Pack Member"

msgid "TOME_WILD@SKILL1@DESCRIPTION"
msgstr "Target enemy:[bulletlist][bullet/]Becomes {GLOBAL.PROPERTIES.DISTRACTED.Hyperlink}.[bullet/]Suffers {stacks} {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink}.[/bulletlist]"

msgid "TOME_WILD@SKILL1@NAME"
msgstr "Mark as Prey"

msgid "TOME_WILD@SKILL2@DESCRIPTION"
msgstr "Makes the target race more bestial and connected to animals. When adjacent to a friendly {GLOBAL.PROPERTIES.ANIMAL.Hyperlink}, both units are granted:[bulletlist][bullet/]+{Damage}% damage[bullet/]+{CriticalChance}% {GLOBAL.CriticalHitChanceConcept}[/bulletlist]"

msgid "TOME_WILD@SKILL2@NAME"
msgstr "Animal Kinship"

msgid "TOME_WILD@SKILL2@PROPERTY@ANIMAL_DESCRIPTION_BUFF"
msgstr "This unit is adjacent to a friendly unit with {GLOBAL.PROPERTIES.ANIMAL_KINSHIP.Hyperlink} and gains:[bulletlist][bullet/]+{ANIMAL_KINSHIP_DAMAGE>ResolvedMultiplier}% damage[bullet/]+{ANIMAL_KINSHIP_CRIT_CHANCE>ResolvedCritChanceBonus}% {GLOBAL.CriticalHitChanceConcept}[/bulletlist]"

