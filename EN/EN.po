msgid "DLC@ARCHONPROPHECY@STORY_REALM_MISSION_02@QUEST_AP2_DEFEAT_OR_SAVE_MERLIN_CAPITAL@OBJECTIVE"
msgstr "{INT_0}/{INT_1} Merlin Defeated or Confronted in Capital"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_MISSION_02@QUEST_AP2_FIND_JULIA@OBJECTIVE"
msgstr "{INT_0}/{INT_1} Archon Champion Met"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_MISSION_02@QUEST_AP2_FREE_SUNDREN@OBJECTIVE"
msgstr "{INT_0}/{INT_1} Umbral Abyss Pocket Investigated"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_MISSION_02@QUEST_AP2_MATERIUM_SUBQUEST@OBJECTIVE"
msgstr "{INT_0}/{INT_1} Path Cleared"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_MISSION_02@QUEST_AP2_MATERIUM_SUBQUEST_CAPITAL@OBJECTIVE"
msgstr "{INT_0}/{INT_1} Giant Met"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_MISSION_02@RELATIONMODIFIER_ALLY_MYRRIDA@TITLE"
msgstr "Ally of Myrrida"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_MISSION_02@RELATIONMODIFIER_ENEMY_MYRRIDA@TITLE"
msgstr "Enemy of Myrrida"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_MISSION_02@RELATIONMODIFIER_REDEMPTION@TITLE"
msgstr "Path to Redemption"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_MISSION_02@RELATIONMODIFIER_VENGEFUL@TITLE"
msgstr "Ally of the Archons"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_MISSION_02@TRIGGER@EFFECT@TOOLTIP_CANCEL_CLEANSE"
msgstr "Your attempt to break Urrath's grasp on {Merlin.FirstName} will end."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_MISSION_02@TRIGGER@EFFECT@TOOLTIP_INSTAWIN"
msgstr "You win the realm (TEMP)"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_MISSION_02@TRIGGER@EFFECT@TOOLTIP_JULIA_SUNDREN_RECRUIT"
msgstr "{Player.TitleName} recruits {Unit.Name}."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_MISSION_02@VICTORY"
msgstr "Victory on Sordünn!"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_MISSION_02@VICTORY_TEXT"
msgstr "You have destroyed the stronghold of the Umbral Abyss on Sordünn. Victorious, you return to Magehaven..."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_MISSION_03@BRIEFING_02@DESCRIPTION"
msgstr "This Prophecy forbade the Archons from getting involved directly, and thus it fell to the Godir of Magehaven to choose one of their own who they deemed powerful enough to fulfill this vital mission. The Archons would lend their strength by sending their champion—an Elven protégé they had taken beneath their divine wings."

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SKILL1@DESCRIPTION"
msgstr "Summon an {GLOBAL.UNITS.ARCHON_ASTRA.Hyperlink} {GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink}, an Angel unit with strong attacks and healing abilities."

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SKILL1@NAME"
msgstr "Summon Astra"

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SKILL2@DESCRIPTION"
msgstr "Purify the souls of target race, granting them:[bulletlist][bullet/]At the start of each turn in combat, dispel {amount} {GLOBAL.NegativeStatusEffectConcept.Hyperlink}.[bullet/]If the Negative Status Effect removed had a positive [hyperlink,GLOBAL.OpposingStatusEffectsConcept]counter[/hyperlink], gain the {GLOBAL.PositiveStatusEffectConcept.Hyperlink}.[/bulletlist][br/]This transformation is incompatible with {GLOBAL.SPECIAL_OPERATIONS.UMBRAL_FLESH.Hyperlink} and {GLOBAL.SPECIAL_OPERATIONS.GLOOMSTRIDER_TRANSFORMATION.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SKILL2@NAME"
msgstr "Pure Soul"

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SKILL2@PROP_DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]At the start of each turn in combat, dispel {amount} {GLOBAL.NegativeStatusEffectConcept.Hyperlink}.[bullet/]If the Negative Status Effect removed had a positive [hyperlink,GLOBAL.OpposingStatusEffectsConcept]counter[/hyperlink], gain the {GLOBAL.PositiveStatusEffectConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SKILL3@DESCRIPTION"
msgstr "Target dead non-Hero and non-Celestial unit:[bulletlist][bullet/]Revives as an {GLOBAL.UNITS.ARCHON_ANGEL.Hyperlink} under the caster's control until the end of combat.[bullet/]On revive, all friendly units in a {ASCENDED_REBIRTH_HEAL_TARGETER>AREA>Radius}-hex radius are healed for {ASCENDED_REBIRTH_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SKILL3@NAME"
msgstr "Ascended Rebirth"

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SKILL4@DESCRIPTION"
msgstr "Target leader of an army gains {GLOBAL.PROPERTIES.CELESTIAL_GUARDIANS_AUTO_SPELL.Hyperlink} for {amount2} {GLOBAL.WorldMapConcept.Hyperlink} {GLOBAL.TurnConcept}, conjuring {amount} Tier III Archon units at the start of combat for the duration."

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SKILL4@NAME"
msgstr "Celestial Guardians"

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SKILL4@PROP_DESCRIPTION"
msgstr "Conjure {amount} Tier III Archon units on combat start."

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SKILL5@DESCRIPTION"
msgstr "Grants enchanted units:[bulletlist][bullet/]{GLOBAL.PROPERTIES.HOLY_AURA_PROP.Hyperlink}, granting status protection to adjacent friendly units and damaging adjacent enemies.[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SKILL5@NAME"
msgstr "Holy Aura"

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SKILL5@PROP_DESCRIPTION"
msgstr "Unit has:{LOC.DLC@ARCHONPROPHECY@WILDLIFE_UNITPROPERTIES@HOLY_AURA@DESCRIPTION}"

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SPI@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{amount} {GLOBAL.CityStabilityConcept.Hyperlink}[bullet/]{GLOBAL.UnitConcept.Hyperlink} deployment location.[bullet/]Allows the drafting of <<m:{GLOBAL.UNITS.ARCHON_TITAN.Hyperlink}>>.[bullet/]Functions as a {GLOBAL.TeleporterConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SPI@NAME"
msgstr "[teleporter/] Archon Gate"

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Summon Celestial allies and ascend your units to the ranks of the Archons."

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@TOME@LORE_DESCRIPTION"
msgstr "\"Rejoice! For the Archons descend from the heavens once again. The day of reckoning has arrived, and you stand exalted with Titans and Angels. Herald their arrival, witness how their wrath wreaks havoc on the wicked and their blessings bestow grace upon the blameless. You, righteous one, fear death no more—for ascension is attained through sacrifice.\""

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@TOME@NAME"
msgstr "Tome of the Archon"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@EVENT_PROPERTY@DESCRIPTION"
msgstr "Unit has a {HAND_OF_PROVIDENCE_RESISTANCE_CHECK>ResolvedStrength}% chance at the start of a turn to gain:[bulletlist][bullet/]{GLOBAL.PROPERTIES.TRUE_STRIKE.Hyperlink} for {TRUE_STRIKE_EFFECT_DESCRIPTION>NumTurns} {GLOBAL.TurnConcept}.[bullet/]{GLOBAL.PROPERTIES.FORTUNE.Hyperlink} for {FORTUNE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@EVENT_PROPERTY@NAME"
msgstr "Hand of Providence"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@SKILL1@DESCRIPTION"
msgstr "A {GLOBAL.PROPERTIES.SUPPORT_UNIT.Hyperlink} that can foresee the future and use that knowledge to strengthen and protect other units."

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@SKILL2@AUTOSPELL"
msgstr "Apply these effect to the battle in the following order:"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@SKILL2@DESCRIPTION"
msgstr "When cast and for the next {duration} <<m:{GLOBAL.TurnConcept}>>, apply effect to the battle in the following order:[bulletlist][bullet/]All friendly units gain +{amount}% {GLOBAL.EvasionConcept.Hyperlink} for the turn.[bullet/]All friendly units gain {GLOBAL.PROPERTIES.PRECOGNITION.Hyperlink}.[bullet/]All friendly units gain +{damage}% damage for the turn.[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@SKILL2@NAME"
msgstr "Battle Divination"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@SKILL2@NAME_PROP"
msgstr "Battle Divination - Damage"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@SKILL2@NAME_PROP_EVASION"
msgstr "Battle Divination - Evasion"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@SKILL2@PROP1_DESCRIPTION"
msgstr "All friendly units gain +{amount}% {GLOBAL.EvasionConcept.Hyperlink} for the turn."

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@SKILL2@PROP2_DESCRIPTION"
msgstr "All friendly units gain {GLOBAL.PROPERTIES.PRECOGNITION.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@SKILL2@PROP3_DESCRIPTION"
msgstr "All friendly units gain +{BATTLE_DIVINATION_DAMAGE_MULT>ResolvedMultiplier}% damage for the turn."

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@SKILL3@DESCRIPTION"
msgstr "At the start of combat:[bulletlist][bullet/]Friendly units gain:[bulletlist][bullet/]{GLOBAL.PROPERTIES.PRECOGNITION.Hyperlink}[bullet/]+{amount2}% {GLOBAL.CriticalHitChanceConcept.Hyperlink} for the duration of combat.[/bulletlist][bullet/]Enemy units gain:[bulletlist][bullet/]A {amount4}% {GLOBAL.FumbleConcept.Hyperlink} chance for the duration of combat.[/bulletlist][/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@SKILL3@NAME"
msgstr "Foresee Downfall"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@SKILL4@DESCRIPTION"
msgstr "Grants enchanted units:[bulletlist][bullet/]+{FATED_PROJECTILES_CRITICAL_CHANCE>ResolvedCritChanceBonus}% {GLOBAL.CriticalHitChanceConcept.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.FAITHFUL.Hyperlink}.[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@SKILL4@NAME"
msgstr "Fateful Imbuement"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@SKILL4@PROP_DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]+{FATED_PROJECTILES_CRITICAL_CHANCE>ResolvedCritChanceBonus}% {GLOBAL.CriticalHitChanceConcept.Hyperlink}[bullet/]Has {GLOBAL.PROPERTIES.FAITHFUL.Hyperlink}[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@SKILL5@DESCRIPTION"
msgstr "Grants enchanted units:[bulletlist][bullet/]Gain {GLOBAL.PROPERTIES.PRECOGNITION.Hyperlink} when entering {GLOBAL.DefenseModeConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@SKILL5@NAME"
msgstr "Prescient Circlets"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@SKILL5@PROP_DESCRIPTION"
msgstr "Unit gains {GLOBAL.PROPERTIES.PRECOGNITION.Hyperlink} when entering {GLOBAL.DefenseModeConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@SPI@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{manaamount} {GLOBAL.ManaConcept.Hyperlink}.[bullet/]+{knowledgeamount} {GLOBAL.KnowledgeConcept.Hyperlink} per adjacent {GLOBAL.ConduitConcept.Hyperlink}.[bullet/]Counts as a {GLOBAL.ConduitConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@SPI@NAME"
msgstr "[conduit/] Temple of the Prophet"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Prevent enemy attacks and foresee the downfall of your enemies."

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@TOME@LORE_DESCRIPTION"
msgstr "\"To know one's destiny can be a blessing or a curse. Oracles ensure that the enemy foresee their downfall, and the ally, their fortune—as divination stirs the future, hastening its course. Woe to those who mistake prophecies for mere words—for there is no greater power than destiny, determined to fulfill its promise.\""

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@TOME@NAME"
msgstr "Tome of Prophecies"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@UNIT@ABILITY1@DESCRIPTION"
msgstr "Friendly units in a {HEALING_PORTENT_UNIT_TARGETER_SINGLE>AREA>Radius}-hex radius:[bulletlist][bullet/]Heal {HEALING_PORTENT_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Gain {GLOBAL.PROPERTIES.PRECOGNITION.Hyperlink}.[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@UNIT@ABILITY1@DESCRIPTION_CHAMPION"
msgstr "Healing Portent:[bulletlist][bullet/]Heals an additional {healAmount}<<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@UNIT@ABILITY1@NAME"
msgstr "Healing Portent"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@UNIT@ABILITY1@NAME_CHAMPION"
msgstr "Champion Healing Portent"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@UNIT@ABILITY2@DESCRIPTION"
msgstr "Friendly units in a {STRIKING_PORTENT_UNIT_TARGETER_SINGLE>AREA>Radius}-hex radius:[bulletlist][bullet/]Gain {GLOBAL.PROPERTIES.TRUE_STRIKE.Hyperlink} for {TRUE_STRIKE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Gain {amount} {GLOBAL.PROPERTIES.FORTUNE.Hyperlink} for {FORTUNE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@UNIT@ABILITY2@NAME"
msgstr "Striking Portent"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@UNIT@NAME"
msgstr "Oracle^f"

msgid "DLC@ARCHONPROPHECY@TOME_REVENANT@SKILL1@DESCRIPTION"
msgstr "Summon a {GLOBAL.UNITS.FALLEN_ANGEL.Hyperlink} {GLOBAL.PROPERTIES.BATTLE_MAGE.Hyperlink}, that causes decay and corruption."

msgid "DLC@ARCHONPROPHECY@TOME_REVENANT@SKILL1@NAME"
msgstr "Summon Fallen Angel"

msgid "DLC@ARCHONPROPHECY@TOME_REVENANT@SKILL2@DESCRIPTION"
msgstr "Undead units drafted in this city gain {GLOBAL.PROPERTIES.NATURAL_REGENERATION_GROUP.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@TOME_REVENANT@SKILL2@NAME"
msgstr "Chamber of the Rite"

msgid "DLC@ARCHONPROPHECY@TOME_REVENANT@SKILL3@DESCRIPTION"
msgstr "Grants enchanted units:[bulletlist][bullet/]+{UNDEAD_RESENTMENT_RESISTANCES>REDUCTION>Spirit} {GLOBAL.SpiritResistanceConcept.Hyperlink}[bullet/]+{UNDEAD_RESENTMENT_RESISTANCES>REDUCTION>Fire} {GLOBAL.FireResistanceConcept.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.VICIOUS_KILLER.Hyperlink}[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_REVENANT@SKILL3@NAME"
msgstr "Undead Resentment"

msgid "DLC@ARCHONPROPHECY@TOME_REVENANT@SKILL3@PROP_DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]+{UNDEAD_RESENTMENT_RESISTANCES>REDUCTION>Spirit} {GLOBAL.SpiritResistanceConcept.Hyperlink}[bullet/]+{UNDEAD_RESENTMENT_RESISTANCES>REDUCTION>Fire} {GLOBAL.FireResistanceConcept.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.VICIOUS_KILLER.Hyperlink}[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_REVENANT@SKILL4@COMBAT_DESCRIPTION"
msgstr "Spawn {amount} Skeletons with {GLOBAL.PROPERTIES.UNHOLY_CHAMPION_PROPERTY_GROUP.Hyperlink} on the attacker's side."

msgid "DLC@ARCHONPROPHECY@TOME_REVENANT@SKILL4@DESCRIPTION"
msgstr "For {amount} {GLOBAL.WorldMapConcept.Hyperlink} {GLOBAL.TurnConcept}, target enemy army gains:[bulletlist][bullet/]{amount2} {GLOBAL.PROPERTIES.DEMORALIZED}.[bullet/]When attacked, conjure {amount3} Skeletons with {GLOBAL.PROPERTIES.UNHOLY_CHAMPION_PROPERTY_GROUP.Hyperlink} on the attacker side.[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_REVENANT@SKILL4@NAME"
msgstr "Revenant Whispers"

msgid "DLC@ARCHONPROPHECY@TOME_REVENANT@SKILL4@STRAT_DEBUFF_DESCRIPTION"
msgstr "When attacked, conjure {amount} Skeletons with {GLOBAL.PROPERTIES.UNHOLY_CHAMPION_PROPERTY_GROUP.Hyperlink} on the attacker's side."

msgid "DLC@ARCHONPROPHECY@TOME_REVENANT@SKILL5@DESCRIPTION"
msgstr "Target friendly unit gains:[bulletlist][bullet/]+{UNHOLY_CHAMPION_DAMAGE_MULTIPLIER>ResolvedMultiplier}% damage.[bullet/]{GLOBAL.PROPERTIES.UNDYING.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.ARMOR_OF_FEAR.Hyperlink}[/bulletlist][br/]On cast, enemy units in a {UNHOLY_CHAMPION_CIRCLE_TARGETER>AREA>Radius}-hex radius lose {amount} {GLOBAL.UnitMoraleConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@TOME_REVENANT@SKILL5@MODIFIER@DESCRIPTION"
msgstr "Deals +{UNHOLY_CHAMPION_DAMAGE_MULTIPLIER>ResolvedMultiplier}% damage."

msgid "DLC@ARCHONPROPHECY@TOME_REVENANT@SKILL5@MOD_DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]+{UNHOLY_CHAMPION_DAMAGE_MULTIPLIER>ResolvedMultiplier}% damage[bullet/]{GLOBAL.PROPERTIES.UNDYING.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.ARMOR_OF_FEAR.Hyperlink}[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_REVENANT@SKILL5@NAME"
msgstr "Unholy Champion"

msgid "DLC@ARCHONPROPHECY@TOME_REVENANT@SPI@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{amount} {GLOBAL.SoulConcept.Hyperlink}[bullet/]+{amount2} {GLOBAL.SoulConcept.Hyperlink} per adjacent {GLOBAL.ResearchPostConcept.Hyperlink}.[bullet/]Allows the drafting of Skeletons, <<m:{GLOBAL.UNITS.CORRUPT_SOUL.Hyperlink}>> and <<m:{GLOBAL.UNITS.UNDEAD_TITAN.Hyperlink}>>.[bullet/]Counts as a {GLOBAL.ResearchPostConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_REVENANT@SPI@NAME"
msgstr "[researchpost/] Necropolis"

msgid "DLC@ARCHONPROPHECY@TOME_REVENANT@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Raise an army of corrupted and undead Archons and use their knowledge to make your undead come back again and again, while protecting them from those who would use the powers of light and fire."

msgid "DLC@ARCHONPROPHECY@TOME_REVENANT@TOME@LORE_DESCRIPTION"
msgstr "\"We, who perished for the light, whilst they bask in its glory. We, who are forsaken, whilst they are beloved. We shall build our necropolises, from the bones of their failures. From the darkness of exile, we shall plot their demise.\""

msgid "DLC@ARCHONPROPHECY@TOME_REVENANT@TOME@NAME"
msgstr "Tome of the Revenant"

msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@SKILL1@DESCRIPTION"
msgstr "A {GLOBAL.PROPERTIES.SHIELD_UNIT.Hyperlink} with healing capabilities and a powerful smite."

msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@SKILL2@DESCRIPTION"
msgstr "Summon an {GLOBAL.UNITS.ARCHON_ANGEL.Hyperlink} {GLOBAL.PROPERTIES.BATTLE_MAGE.Hyperlink}, a unit that delivers holy fire to purify their enemies."

msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@SKILL2@NAME"
msgstr "Summon Vigil"

msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@SKILL3@BUFF_PROPERTY_DESCRIPTION"
msgstr "Unit:[bulletlist][bullet/]Ignores {VIRTUOUS_SPIRIT_REDUCE_HEALTH_LOSS_PENALTY>ResolvedPenaltyMultip}% of <<m:{GLOBAL.CasualtyConcept.Hyperlink}>>.[bullet/]Has +{VIRTUOUS_SPIRIT_DEFENSE>DEF_MOD>Armor} {GLOBAL.DefenseConcept.Hyperlink}.[bullet/]Has +{VIRTUOUS_SPIRIT_DEFENSE>DEF_MOD>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@SKILL3@DESCRIPTION"
msgstr "Gives target race strength in moments of weakness, giving them:[bulletlist][bullet/]+{VIRTUOUS_SPIRIT_SPIRIT_DEFENSE>REDUCTION>Spirit} {GLOBAL.SpiritResistanceConcept.Hyperlink}[bullet/]When this unit drops below {VIRTUOUS_SPIRIT_THRESHOLD>ResolvedTriggerProportion}% of their maximum <<m:{GLOBAL.HitPointConcept.Hyperlink}>>:[bulletlist][bullet/]Ignores {VIRTUOUS_SPIRIT_REDUCE_HEALTH_LOSS_PENALTY>ResolvedPenaltyMultip}% of its <<m:{GLOBAL.CasualtyConcept.Hyperlink}>>.[bullet/]Gains +{VIRTUOUS_SPIRIT_DEFENSE>DEF_MOD>Armor} {GLOBAL.DefenseConcept.Hyperlink}.[bullet/]Gains +{VIRTUOUS_SPIRIT_DEFENSE>DEF_MOD>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}.[/bulletlist][/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@SKILL3@NAME"
msgstr "Virtuous Spirit"

msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@SKILL3@PROPERTY_DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]+{VIRTUOUS_SPIRIT_SPIRIT_DEFENSE>REDUCTION>Spirit} {GLOBAL.SpiritResistanceConcept.Hyperlink}[bullet/]When this unit drops below {VIRTUOUS_SPIRIT_THRESHOLD>ResolvedTriggerProportion}% of their maximum <<m:{GLOBAL.HitPointConcept.Hyperlink}>>:[bulletlist][bullet/]Ignores {VIRTUOUS_SPIRIT_REDUCE_HEALTH_LOSS_PENALTY>ResolvedPenaltyMultip}% of its <<m:{GLOBAL.CasualtyConcept.Hyperlink}>>.[bullet/]Gains +{VIRTUOUS_SPIRIT_DEFENSE>DEF_MOD>Armor} {GLOBAL.DefenseConcept.Hyperlink}.[bullet/]Gains +{VIRTUOUS_SPIRIT_DEFENSE>DEF_MOD>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}.[/bulletlist][/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@SKILL4@DESCRIPTION"
msgstr "Target friendly unit:[bulletlist][bullet/]Has their <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>> removed.[bullet/]Gains {GLOBAL.PROPERTIES.STEADFAST.Hyperlink} for {HEROIC_STAND_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Ignores the penalties from <<m:{GLOBAL.CasualtyConcept.Hyperlink}>> for {HEROIC_STAND_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][br/][br/]Can only affect a unit once per battle."

msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@SKILL4@NAME"
msgstr "Heroic Stand"

msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@SKILL4@PROP_DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]{GLOBAL.PROPERTIES.STEADFAST.Hyperlink}[bullet/]Ignores the penalties from <<m:{GLOBAL.CasualtyConcept.Hyperlink}>>.[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@SKILL5@DESCRIPTION"
msgstr "The city loses {amount}% of its {GLOBAL.GoldConcept.Hyperlink} income, and gains double that amount as {GLOBAL.FoodConcept.Hyperlink} and {GLOBAL.StructureProductionConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@SKILL5@NAME"
msgstr "House of Charity"

msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Create a virtuous army and make them fight strong until the end."

msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@TOME@LORE_DESCRIPTION"
msgstr "\"Not in the darkest night, not in the face of horror, not even in their last breath should the virtuous yield. You are the last bastion against vileness, the last light in the abyss. An age may come when hope dies, when there are no more righteous people—but it is not this age, for you have not yet fallen.\""

msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@TOME@NAME"
msgstr "Tome of Virtue"

msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@UNIT@ABILITY1@DESCRIPTION"
msgstr "Deal damage to target unit. Enter {GLOBAL.DefenseModeConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@UNIT@ABILITY1@NAME"
msgstr "Smite"

msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@UNIT@ABILITY2@DESCRIPTION"
msgstr "Target friendly unit:[bulletlist][bullet/]Heals for {LAY_ON_HANDS_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Gains {amount} {GLOBAL.PROPERTIES.STATUS_PROTECTION.Hyperlink} for {STATUS_PROTECTION_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@UNIT@ABILITY2@NAME"
msgstr "Lay on Hands"

msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@UNIT@NAME"
msgstr "Paladin^m"

msgid "DLC@ARCHONPROPHECY@TOOLTIP@ANGELIC_ENVOY@MORALE"
msgstr "Grants all units in this army bonus {GLOBAL.UnitMoraleConcept.Hyperlink} until the next combat."

msgid "DLC@ARCHONPROPHECY@TOOLTIP@ANGELIC_ENVOY@RANK_UP"
