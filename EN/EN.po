msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@SKILL3@NAME"
msgstr "Null Shield"

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@SKILL3@UNIT_DESCRIPTION"
