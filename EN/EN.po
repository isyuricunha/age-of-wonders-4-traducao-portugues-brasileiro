msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@COMBAT_CASTERS@DESCRIPTION"
msgstr "All defending <<m:{GLOBAL.UnitConcept.Hyperlink}>> have {GLOBAL.PROPERTIES.MELEE_MAGE.Hyperlink} until the end of the battle."

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@COMBAT_CASTERS@NAME"
msgstr "Melee Mage Defenders"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@DELAYED_WORM@NAME"
msgstr "Delayed Tremors"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@ELEMENTAL_FRAGILITY@DESCRIPTION"
msgstr "The first time each defending {GLOBAL.PROPERTIES.ELEMENTAL.Hyperlink} {GLOBAL.UnitConcept.Hyperlink} falls below {percent} of its <<m:{GLOBAL.HitPointConcept.Hyperlink}>>:[bulletlist][bullet/]The Unit teleports up to {hex} hexes away from attackers.[bullet/]The Unit transforms into a random other Elemental Unit.[bullet/]The Unit suffers {stack} {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink}.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@ELEMENTAL_FRAGILITY@NAME"
msgstr "Elemental Fragility"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@ELEMENTAL_MAYHEM@DESCRIPTION"
msgstr "The first time each defending {GLOBAL.PROPERTIES.ELEMENTAL.Hyperlink} {GLOBAL.UnitConcept.Hyperlink} falls below {percent} of its <<m:{GLOBAL.HitPointConcept.Hyperlink}>>:[bulletlist][bullet/]The Unit teleports up to {hex} hexes away from attackers.[bullet/]The Unit transforms into a random other Tier 1 Elemental Unit.[bullet/]The Unit is healed for {hp} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>[/bulletlist]"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@ELEMENTAL_MAYHEM@NAME"
msgstr "Elemental Mayhem"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@FADING_SOULS@DESCRIPTION"
msgstr "Every {turn} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, all corpses of defending <<m:{GLOBAL.UnitConcept.Hyperlink}>> are resurrected as a {GLOBAL.UNITS.PHANTASM_WARRIOR_UNIT.Hyperlink} which dies after {turn} [turn/] Turns."

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@FADING_SOULS@NAME"
msgstr "Fading Souls"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@FRACTURING_DRAGON@DESCRIPTION"
msgstr "The defending {GLOBAL.UNITS.FRACTURED_DRAGON.Hyperlink} leaves behind Mana Fractures on each hex targeted by its attacks. Mana Fractures have {GLOBAL.DrainingConcept.Hyperlink} and spread to an adjacent hex every time a Spell is cast."

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@FRACTURING_DRAGON@NAME"
msgstr "Fracturing Wake"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@FRIENDLY_FIRE_WORM@DESCRIPTION"
msgstr "Every {turn} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, a {radius}-hex radius near a defending Unit becomes marked by tremors.[bulletlist][bullet/]All attacking <<m:{GLOBAL.UnitConcept.Hyperlink}>> without {GLOBAL.PROPERTIES.FLYING_MOVEMENT.Hyperlink}, {GLOBAL.PROPERTIES.FLOATING_MOVEMENT.Hyperlink}, or {GLOBAL.PROPERTIES.SAND_WALK.Hyperlink} in the radius suffer {GLOBAL.PROPERTIES.SLOWED.Hyperlink} for {turn2} [turn/] Turn.[bullet/]At the end of the next Turn, all Units still inside the radius are killed.[bulletlist][bullet/]Units killed this way ignore {GLOBAL.PROPERTIES.RESURGENCE.Hyperlink} and {GLOBAL.PROPERTIES.STEADFAST.Hyperlink} and do not leave behind a corpse.[bullet/]The Expedition Leader is still revived at {hp} {GLOBAL.HitPointConcept.Hyperlink} if their side is victorious in battle.[/bulletlist][/bulletlist]"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@FRIENDLY_FIRE_WORM@NAME"
msgstr "Agitated Tremors"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@GIANT_WORM@DESCRIPTION"
msgstr "Every {turn} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, a {radius}-hex radius near an attacking Unit becomes marked by tremors.[bulletlist][bullet/]All attacking <<m:{GLOBAL.UnitConcept.Hyperlink}>> without {GLOBAL.PROPERTIES.FLYING_MOVEMENT.Hyperlink}, {GLOBAL.PROPERTIES.FLOATING_MOVEMENT.Hyperlink}, or {GLOBAL.PROPERTIES.SAND_WALK.Hyperlink} in the radius suffer {GLOBAL.PROPERTIES.SLOWED.Hyperlink} for {turn2} [turn/] Turn.[bullet/]At the end of the next [turn/] Turn, all Units still inside the radius are killed.[bulletlist][bullet/]Units killed this way ignore {GLOBAL.PROPERTIES.RESURGENCE.Hyperlink} and {GLOBAL.PROPERTIES.STEADFAST.Hyperlink} and do not leave behind a corpse.[bullet/]The Expedition Leader is still revived at {hp} {GLOBAL.HitPointConcept.Hyperlink} if their side is victorious in battle.[/bulletlist][/bulletlist]"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@GIANT_WORM@DESCRIPTION_TSR"
msgstr "Every {turn} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, a {radius}-hex radius near an attacking Unit becomes marked by tremors.[bulletlist][bullet/]All attacking <<m:{GLOBAL.UnitConcept.Hyperlink}>> without {GLOBAL.PROPERTIES.FLYING_MOVEMENT.Hyperlink}, {GLOBAL.PROPERTIES.FLOATING_MOVEMENT.Hyperlink}, or {GLOBAL.PROPERTIES.SAND_WALK.Hyperlink} in the radius suffer {GLOBAL.PROPERTIES.SLOWED.Hyperlink} for {turn2} [turn/] Turn.[bullet/]At the end of the next [turn/] Turn, all Units still inside the radius are killed.[bulletlist][bullet/]Units killed this way ignore {GLOBAL.PROPERTIES.RESURGENCE.Hyperlink} and {GLOBAL.PROPERTIES.STEADFAST.Hyperlink} and do not leave behind a corpse.[/bulletlist][/bulletlist]"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@GIANT_WORM@NAME"
msgstr "Gargantuan Tremors"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@MOVING_SANDSTORMS@DESCRIPTION"
msgstr "Every {turns} <<m:{GLOBAL.TurnConcept.Hyperlink}>> several {hex}-hex radius Sandstorms are spawned in random locations.[bulletlist][bullet/]<<m:{GLOBAL.UnitConcept.Hyperlink}>> without {GLOBAL.PROPERTIES.SAND_WALK.Hyperlink} suffer {GLOBAL.PROPERTIES.SLOWED.Hyperlink} and have {chance} of suffering {GLOBAL.PROPERTIES.BLINDED.Hyperlink} for {turn} [turn/] Turn when passing through or ending their Turn in a Sandstorm.[bullet/]Sandstorms last for {turns} [turn/] Turns.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@MOVING_SANDSTORMS@NAME"
msgstr "Creeping Sandstorms"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@REJUVINATING_SOULS@DESCRIPTION"
msgstr "Every {turn} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, all corpses of defending <<m:{GLOBAL.UnitConcept.Hyperlink}>> are resurrected as a {GLOBAL.UNITS.PHANTASM_WARRIOR_UNIT.Hyperlink}. When this happens, all attacking units within a {radius}-hex radius of the corpse are healed for {heal} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>."

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@REJUVINATING_SOULS@NAME"
msgstr "Rejuvenating Souls"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@SABOTAGED_CONSTRUCTS@DESCRIPTION"
msgstr "All defending {GLOBAL.PROPERTIES.CONSTRUCT.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> suffer {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink} for {turn} <<m:{GLOBAL.TurnConcept.Hyperlink}>>. All defending Non-Construct Units suffer {GLOBAL.PROPERTIES.DEMORALIZED.Hyperlink} for {turn} [/turn] Turns instead."

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@SABOTAGED_CONSTRUCTS@NAME"
msgstr "Sabotaged Constructs"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@STATIC_SANDSTORMS@DESCRIPTION"
msgstr "Several {hex}-hex radius Sandstorms are present in battle.[bulletlist][bullet/]<<m:{GLOBAL.UnitConcept.Hyperlink}>> without {GLOBAL.PROPERTIES.SAND_WALK.Hyperlink} suffer {GLOBAL.PROPERTIES.SLOWED.Hyperlink} and have {chance} of suffering {GLOBAL.PROPERTIES.BLINDED.Hyperlink} for {turn} {GLOBAL.TurnConcept.Hyperlink} when passing through or ending their turn in a Sandstorm.[bullet/]These Sandstorms do not move and stay in their positions until the end of the battle.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@STATIC_SANDSTORMS@NAME"
msgstr "Static Sandstorms"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@TAUNTED_DRAGON@DESCRIPTION"
msgstr "The defending {GLOBAL.UNITS.FRACTURED_DRAGON.Hyperlink} is taunted by the attacking {GLOBAL.PROPERTIES.EXPEDITION_LEADER.Hyperlink} until the end of the battle!"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@TAUNTED_DRAGON@NAME"
msgstr "Fractured Dragon Taunt"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@UNDYING_SOULS@DESCRIPTION"
msgstr "Every {turn} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, all corpses of defending <<m:{GLOBAL.UnitConcept.Hyperlink}>> are resurrected as <<m:{GLOBAL.UNITS.PHANTASM_WARRIOR_UNIT.Hyperlink}>>."

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@UNDYING_SOULS@NAME"
msgstr "Undying Souls"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@VOLATILE_CONSTRUCTS@DESCRIPTION"
msgstr "Defending {GLOBAL.PROPERTIES.CONSTRUCT.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> explode on death, dealing {damage} {GLOBAL.FireDamageConcept.Hyperlink} to all adjacent defending Units."

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@VOLATILE_CONSTRUCTS@NAME"
msgstr "Volatile Constructs"

msgid "DLC@RISEFROMRUIN@CRISIS@1171_4502@SUB_HEADER"
msgstr "Find one of the Fated Regions."

msgid "DLC@RISEFROMRUIN@CRISIS@1171_4503@DESCRIPTION"
msgstr "The {GLOBAL.FracturingWindsConcept.Hyperlink} howl in the air and will bring about <<m:{GLOBAL.CataclysmConcept.Hyperlink}>> when too many <<m:{GLOBAL.WorldMapSpellConcept.Hyperlink}>> are cast. Perhaps by finding the origins of this phenomenon, you could shield yourself against it or even weaponize it."

msgid "DLC@RISEFROMRUIN@CRISIS@1171_4503@NAME"
msgstr "The Devouring Winds"

msgid "DLC@RISEFROMRUIN@CRISIS@1224_1337@DESCRIPTION"
msgstr "Two factions clash for control of the subterranean oasis. One Nomadic tribe seeks to eradicate those who poison the land, the water, and their people—while a tribe of fractured outcasts fights to defend what they consider sacred ground."

msgid "DLC@RISEFROMRUIN@CRISIS@1224_1337@NAME"
msgstr "Great Worm Lake"

msgid "DLC@RISEFROMRUIN@CRISIS@1224_1337@SUB_HEADER"
msgstr "A pitched battle is raging at Great Worm Lake."

msgid "DLC@RISEFROMRUIN@CRISIS@1252_70@DESCRIPTION"
msgstr "The Phantom Hills are dotted with the war camps of a ghostly host. Their waving banners speak of a time when bold champions marched on the cities of the {GLOBAL.UnmakersLoreConcept.Hyperlink} to protect the realm from their hazardous arcane experiments."

msgid "DLC@RISEFROMRUIN@CRISIS@1252_70@NAME"
msgstr "Phantom Hills"

msgid "DLC@RISEFROMRUIN@CRISIS@1252_70@SUB_HEADER"
msgstr "The host of a ghostly {TSR_WARLORD} lingers in this region..."

msgid "DLC@RISEFROMRUIN@CRISIS@FRACTURING_WINDS@PHASE2@DESCRIPTION"
msgstr "The {GLOBAL.FracturingWindsConcept.Hyperlink} seem to have been unintentionally created through the hubris of these so-called {GLOBAL.UnmakersLoreConcept.Hyperlink}. Now long gone, some of their <<m:{GLOBAL.ArtifactConcept.Hyperlink}>> remain in the Fated Regions scattered through the realm.[br/][br/]These Artifacts prove capable of manipulating and partially taking control over the Devouring Winds.[br/][br/]Collecting enough of them and channeling them for a time will mean weaponizing the winds, resulting in a decisive victory for the wielder as they can restore or scatter the realm at will."

msgid "DLC@RISEFROMRUIN@CRISIS@FRACTURING_WINDS@SUB_HEADER"
msgstr "Continue your journey, beware the [hyperlink,GLOBAL.FracturingWindsConcept.Hyperlink]Winds[/hyperlink]."

msgid "DLC@RISEFROMRUIN@CRISIS@TSR_RFR_CM@DESCRIPTION"
msgstr "Voices created by the devouring winds haunt this area, where the {GLOBAL.FractureLoreConcept.Hyperlink} energy is so volatile that the air crackles with it. The voices ask you to draw near the Fractures, promising unimaginable knowledge."

msgid "DLC@RISEFROMRUIN@CRISIS@TSR_RFR_CM@NAME"
msgstr "Crackling Mesa"

msgid "DLC@RISEFROMRUIN@CRISIS@TSR_RFR_CM@SUB_HEADER"
msgstr "The devouring winds whisper promises of knowledge."

