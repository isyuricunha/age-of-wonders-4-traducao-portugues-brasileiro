msgid "DLC@GIANTKINGS@HOTGK_FINISHER@OBJECTIVE_ACTIVE_ASSAULT_HEIR_02"
msgstr "Gain {HOTGK_RAZE_IMP_REWARD} {GLOBAL.ImperiumConcept.Hyperlink} when the Clans raze a city."

