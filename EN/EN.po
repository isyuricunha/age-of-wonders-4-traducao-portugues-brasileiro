msgid "EXPANSION_VICTORY@EVENT_FINAL_STAGE_ENTER@PLAYER"
msgstr "{Player.Name} has lit the Beacons of Unity and is on their way to win the game through {VictoryConditionName}![br/][br/]The {VictoryConditionName} can be canceled by occupying one of the three provinces containing a {GLOBAL.STRUCTURE_UPGRADES.BEACONOFUNITY.Hyperlink}."

msgid "EXPANSION_VICTORY@EVENT_FINAL_STAGE_ENTER@YOU"
msgstr "You have lit the Beacons of Unity and are approaching the {VictoryConditionName}![br/][br/]Maintain control over all three Beacons of Unity for long enough to achieve victory!"

msgid "EXPANSION_VICTORY@EVENT_FINAL_STAGE_LEAVE@PLAYER"
msgstr "{Player.Name}'s Beacons of Unity have been extinguished, and their attempt to achieve the {VictoryConditionName} has been thwarted!"

msgid "EXPANSION_VICTORY@EVENT_FINAL_STAGE_LEAVE@YOU"
msgstr "Your Beacons of Unity have been extinguished, and the victory timer for the {VictoryConditionName} has been canceled!"

