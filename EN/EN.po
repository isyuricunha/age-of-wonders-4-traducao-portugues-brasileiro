msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_579@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} greets you with the ceremonial greeting of <<o:EventHouseLord>> {EventHouseRace}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_579@BODY_LORE"
msgstr "\"We celebrate your arrival, {PlayerLeader.FirstName}-kan. {EventPhrase} Let us renew our Oaths in each other's presence. May it offer a strong foundation for both of our Houses. What business have you with {EventHouse}? How may our aspirations benefit yours, and yours mine?"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_579@BUTTON_0"
msgstr "Inspect {EventHouse}, bastion of your brothers in arms."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_579@BUTTON_1"
msgstr "\"I shall return to you another day, {EventHouseLord.FirstName}-hem.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_579@EVENTPHRASE_HARMONY"
msgstr "Your balanced stance informs me that you, like us, are guided by {EventOath}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_579@EVENTPHRASE_RIGHTEOUSNESS"
msgstr "Your earnest posture informs me that you, like us, are guided by {EventOath}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_579@EVENTPHRASE_STRIFE"
msgstr "Your forceful demeanor informs me that you, like us, are guided by {EventOath}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_579@TITLE"
msgstr "Meeting Fraternal {EventHouse.Name}"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_588@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} salutes you with respect, as is the way of the {EventHouseRace}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_588@BODY_LORE"
msgstr "It then falls to you to salute {EventHouseLord.FirstName} in the style of your {PlayerRace}. The gesture appeases the {EventHouseLord.Title}. \"Though you and I walk different paths, you the Way of {PlayerOath}, I the Way of {EventOath}, peace between our people paves the road to prosperity and triumph, {PlayerLeader.FirstName}-kan.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_588@BUTTON_0"
msgstr "Inspect the Disciples of {EventOath} in {EventHouse}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_588@BUTTON_1"
msgstr "\"May {EventOath} direct your hands, {EventHouseLord.FirstName}-hem.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_588@TITLE"
msgstr "Meeting Heroic {EventHouse.Name}"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_589@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} greets you formally. The honor guard of the {EventHouseRace} flank <<P:EventHouseLord>>."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_589@BODY_LORE"
msgstr "\"Your reputation precedes you, {PlayerLeader.FirstName}-kan.\" The <<G:face^n,{EventHouseLord.Title}>> is strict, but there is sincere respect in <<o:EventHouseLord>> eyes. \"We have no quarrel with you. Although you are a stranger to our ways, the oath we took requires us to welcome you as a friend.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_589@BUTTON_0"
msgstr "Inspect {EventHouse} and the honored {EventHouseRace}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_589@BUTTON_1"
msgstr "Promise to return another time."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_589@TITLE"
msgstr "Meeting Honorable {EventHouse.Name}"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_590@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} cautiously greets you. <<Co:EventHouseLord>> hand rests on the hilt of his sword."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_590@BODY_LORE"
msgstr "{EventHouseLord.FirstName} stands tall yet frozen, like a statue, but keenly observes your every move. \"Until we have decided whether you are a threat to our way of life, {PlayerLeader.FirstName}-do, I think it best you keep your distance.\" <<Co:EventHouseLord>> voice holds no threat, yet <<p:EventHouseLord>> speaks with stern and unwavering intent. \"You choose what destiny awaits you,\" concludes the {EventHouseLord.Title}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_590@BUTTON_0"
msgstr "Inspect {EventHouse} with caution."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_590@BUTTON_1"
msgstr "\"Our destinies will surely meet. But not today, {EventHouseLord.Title}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_590@TITLE"
msgstr "Meeting Rigorous {EventHouse.Name}"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_591@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of the {GLOBAL.IndependentCityConcept.Hyperlink} {EventHouse.Name} meets you with <<o:EventHouseLord>> weapon raised."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_591@BODY_LORE"
msgstr "\"A curse on this day, on which you set foot in our lands, {PlayerLeader.FirstName}-uch\", the {EventHouseLord.Title} spits out. \"I hereby swear I will destroy you and your {PlayerRace}.\" {EventHouseLord.FirstName} slices the palm of <<o:EventHouseLord>> hand and lets the blood drip into the soil. \"The {EventHouseRace} denounce all that you stand for, so-called {PlayerLeader.Title}!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_591@BUTTON_0"
msgstr "Inspect brazen {EventHouse}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_591@BUTTON_1"
msgstr "\"Either you break your oath, or I break {EventHouse}!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_591@TITLE"
msgstr "Meeting Warmongering {EventHouse.Name}"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_594@BODY_FOOTER"
msgstr "The {EventStackLeader} vows: \"{EventOath} shall ennoble us, Sentries of the {EventStructure}!\" Can these sentinels be convinced to abandon their post?"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_594@BODY_HEADER"
msgstr "As your army nears a {EventStructure.Name}, they are addressed by sentinels from {EventHouse} that are stationed there. \"Halt!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_594@BODY_LORE"
msgstr "A fledgling {EventStackLeader} steps forward to size up your company. \"You have no business here! This is the domain of the {EventRace} of {EventHouse}.\" The other guards stand motionless in formation. Their novice commander nods approvingly to acknowledge their discipline, then continues to bark: \"We will not budge! As sentinels of {EventHouse}, we have taken oaths of loyalty.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_594@BUTTON_0"
msgstr "Pay honor and respect [influence/] to {EventHouse} to be permitted access."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_594@BUTTON_2"
msgstr "\"You have proven your dedication. It is time to return home honorably.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_594@BUTTON_3"
msgstr "\"Good! This was your test. You passed. Now leave.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_594@BUTTON_4"
msgstr "\"Your oath shall be your end! To arms!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_594@BUTTON_5"
msgstr "Leave the duty-bound sentinels from {EventHouse}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_594@TITLE"
msgstr "Staunch Sentinels"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_598@BODY_FOOTER"
msgstr "The victors from {EventHouse} will not leave the {EventStructure} before the celebration is over. What will you do?"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_598@BODY_HEADER"
msgstr "Your troops visit a {EventStructure}, only to find a {EventHouse} army gathered around the corpse of a great {EventUnitB}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_598@BODY_LORE"
msgstr "The company's leader, an {EventStackLeader} greets you kind-heartedly. \"Ah, you've come at the right time!\" he exclaims. \"My troops just bested this nasty {EventUnitB} in an epic battle. Per the tenets of the {EventRace}, we must now hold a celebratory banquet. Mighty foes warrant much honor, so we are about to hold a great feasts! Won't you join us and pay respect to our slain mark?\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_598@BUTTON_0"
msgstr "Move the celebration [food/] to {EventCity}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_598@BUTTON_2"
msgstr "Conjure a visage of the <<G:reanimation^n,EventUnitB>>."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_598@BUTTON_3"
msgstr "\"Let's show these lightweights from {EventHouse} how the {PlayerRace} party, troops!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_598@BUTTON_4"
msgstr "Vanquish them while their guard is down!"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_598@BUTTON_5"
msgstr "Allow the soldiers to revel in peace."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_598@BUTTON_6"
msgstr "Have guards [unitprod/] from {EventCity} join the banquet to elevate its honor."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_598@TITLE"
msgstr "Banquet of Triumph"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_599@BODY_FOOTER"
msgstr "How will you celebrate the presentation of this year's Champion of {EventHouse}, who visits all benevolent Godir of the realm?"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_599@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of {EventHouse} visits you with a formidable {EventUnit} in tow. \"{PlayerLeader.Title}, I proudly present this year's Champion!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_599@BODY_LORE"
msgstr "{EventHouseLord.FirstName} is eager to explain what this is all about. \"Every year, the Council of {EventOath} elects the most devout paragon of {EventHouse} culture from the most experienced soldiers in our army. That fighter is laureled as this year's Champion: the consummate {EventHouseRace} warrior.\" The {EventHouseLord.Title} grins. \"As is our tradition, we visit every ally to share in the celebrations!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_599@BUTTON_0"
msgstr "Ask the Champion to train the recruits [unitprod/] of {EventCity}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_599@BUTTON_1"
msgstr "Obtain a piece of the <<G:armor^n,EventUnit>> [item/] as a token of respect."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_599@BUTTON_2"
msgstr "\"I simply MUST [influence/] have your Champion [unit/] within my ranks.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_599@BUTTON_3"
msgstr "\"Let your mettle inspire [morale/] my troops!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_599@BUTTON_4"
msgstr "\"Share your selfless virtues [goodact/] with us!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_599@BUTTON_5"
msgstr "\"Teach my {EventRace} how to live harmoniously [happiness/], Champion.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_599@TITLE"
msgstr "The Champion's Tour"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_600@BODY_FOOTER"
msgstr "The {EventHouseLord.Title} awaits your suggestion for how to deal with the accused Oathbreakers."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_600@BODY_HEADER"
msgstr "{EventHouseLord} of {EventHouse} contacts you, <<o:EventHouseLord>> face betraying doubt and disgust. Chained <<m:EventUnit>> stand behind him."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_600@BODY_LORE"
msgstr "\"O {PlayerLeader.Title}, we are struggling to declare the fate of these Oathbreakers,\" {EventHouseLord.FirstName} utters. <<Cp:EventHouseLord>> nods to the <<m:EventUnit>> behind <<P:EventHouseLord>>. \"We caught these degenerates red-handed. {EventPhrase} Now we must decide their sentence.\" The {EventHouseLord.Title} smiles. \"I value your opinion, {PlayerLeader.FirstName}-kan. What penance must befall the Oathbreakers?\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_600@BUTTON_0"
msgstr "\"I will deal with these <<m:EventUnit>>.\" [unit/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_600@BUTTON_1"
msgstr "Make an example of the <<m:EventUnit>>. Harvest their souls. [soul/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_600@BUTTON_2"
msgstr "\"By my oath, [undevotedact/] restore these Oathbreakers' honor.\" [allegiance/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_600@BUTTON_3"
msgstr "Demand that the <<m:EventUnit>> receive a fair trial."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_600@BUTTON_4"
msgstr "\"If their guilt is certain, a judicial duel shall seal <<o:EventUnit>> fate.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_600@BUTTON_5"
msgstr "Strip them of their arms and armor. [item/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_600@EVENTPHRASE_HARMONY"
msgstr "They rallied the {EventHouseRace} to take up arms against you!"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_600@EVENTPHRASE_RIGHTEOUSNESS"
msgstr "They were stealing food from the sick and poor."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_600@EVENTPHRASE_STRIFE"
msgstr "They laid down their weapons to become pig farmers."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_600@TITLE"
msgstr "Oathbreakers"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_602@BODY_FOOTER"
msgstr "\"<<Ca:EventStructure>> is causing dissonance,\" they say in unison. \"Level it to bring harmony to the realm. And your heart.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_602@BODY_HEADER"
msgstr "\"You reflect on your past actions, many of which opposed the values of {PlayerOath} when, suddenly, two <<m:EventUnit>> appear."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_602@BODY_LORE"
msgstr "One {EventUnit}, darker in color, grimly observes you. <<Cp:EventUnit>> then opens <<o:EventUnit>> mouth to speak. \"Oathbreaker!\" <<Cp:EventUnit>> is clearly not used to using <<o:EventUnit>> voice. \"Dissonance threatens harmony. The errors in your ways unbalanced yourself and the {PlayerRace}.\" The other, lighter in color and grinning cheekily, continues with similar atypical voice: \"Fortunately, two orchestrated dissonances may resonate and cause harmony.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_602@TITLE"
msgstr "Harmonizing Dissonance"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_603@BODY_FOOTER"
msgstr "The <<m:EventUnit>> fold their hands, close their eyes and chant: \"Repeat our words. Retake your oath. Reclaim harmony.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_603@BODY_HEADER"
msgstr "You barely had time to inspect the spoils of the <<G:ruins^p,EventStructure>>, when the <<m:EventUnit>> reappear, side by side."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_603@BODY_LORE"
msgstr "\"Admirable, simply admirable,\" speaks the lighter, grinning variant with <<o:EventUnit>> unusual voice. <<Co:EventUnit>> darker counterpart still wears <<o:EventUnit>> grim expression, though you see a glimmer of approval in <<o:EventUnit>> eyes. The lighter {EventUnit} winks and continues. \"The dissonance of the {EventStructure} has countered your own. You are ready.\" The darker {EventUnit} finally speaks: \"Ready for redemption.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_603@TITLE"
msgstr "Harmonizing Dissonance: Aftermath"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_614@BUTTON_0"
msgstr "Repeat their words and retake your oath. [devotedact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_614@BUTTON_1"
msgstr "Instead of following harmony, [undevotedact/] feed your dormant Berserker's Rage. [unitHero/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_614@BUTTON_2"
msgstr "Slay the <<m:EventUnit>> [evilact/] to carve a {EventItem} [item/] from their shells. [undevotedact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_614@BUTTON_3"
msgstr "Strip the <<m:EventUnit>> of their Blessed Armor while their guard is lowered."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_614@BUTTON_4"
msgstr "\"I will harmonize with [arcana/] Astral instead. [undevotedact/] It has never abandoned me.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_614@BUTTON_5"
msgstr "\"I will harmonize with [chaos/] Chaos instead. [undevotedact/] It has never abandoned me.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_614@BUTTON_6"
msgstr "\"I will harmonize with [matter/] Materium instead. [undevotedact/] It has never abandoned me.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_614@BUTTON_7"
msgstr "\"I will harmonize with [nature/] Nature instead. [undevotedact/] It has never abandoned me.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_614@BUTTON_8"
msgstr "\"I will harmonize with [order/] Order instead. [undevotedact/] It has never abandoned me.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_614@BUTTON_9"
msgstr "\"I will harmonize with [shadow/] Shadow instead. [undevotedact/] It has never abandoned me.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_615@BUTTON_0"
msgstr "\"Wise <<m:EventUnit>>, my resolve shall deliver harmony to the realm.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_615@BUTTON_1"
msgstr "\"My dissonance would only grow, <<m:EventUnit>>. I decline your gesture.\" [undevotedact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_625@BODY_FOOTER"
msgstr "\"To restore your honor, I bid you banish the {EventStackLeader}. But beware: the fiend surrounds itself with powerful protectors.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_625@BODY_HEADER"
msgstr "You reflect on your past actions, many of which opposed the values of {PlayerOath} when, suddenly, a {EventUnit} presents itself."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_625@BODY_LORE"
msgstr "The noble creature briefly observes you, then speaks with a stern yet inspiring voice: \"You are known to me, Oathbreaker. You have disgraced yourself and your {PlayerRace}. Still, not all is lost. A test I offer you. My nemesis, the treacherous {EventStackLeader}, preys on inexperienced warriors, catching them in <<o:EventStackLeader>> webs of lies and deceit.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_625@BUTTON_0"
msgstr "\"I shall righteously vanquish the terror that stalks this realm.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_625@BUTTON_1"
msgstr "\"I have forsaken Righteousness, {EventUnit}. [undevotedact/] Leave me be.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_625@TITLE"
msgstr "Saving Grace"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@BODY_FOOTER"
msgstr "\"Touch my crown, take the pledge, and the power of Righteousness shall again flow through your veins.\" The {EventUnit} bows."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@BODY_HEADER"
msgstr "The <<G:reign of terror^n,EventStackLeader>> has ended as you inspect <<o:EventStackLeader>> lifeless carapace. The {EventUnit} returns, bathed in glorious light."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@BODY_LORE"
msgstr "When <<p:EventUnit>> speaks, <<o:EventUnit>> words warm your soul: \"My wicked foe is defeated. You have done as I asked, and you have done what is just. Remember today as your dawn of hope and reclamation.\" An aura of gold envelops you. The noble creature finally commands:"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@BUTTON_0"
msgstr "Renew your oath, for Righteousness. [devotedact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@BUTTON_1"
msgstr "Forget your oath. [undevotedact/] This hunt awakened your hunger for death. [unitHero/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@BUTTON_2"
msgstr "Strike down [evilact/] the {EventUnit} while <<p:EventUnit>> has lowered <<o:EventUnit>> head. [xp/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@BUTTON_3"
msgstr "Steal the secrets of {GLOBAL.PROPERTIES.ACCURSED_ARMORS_GROUP.Hyperlink} from the <<G:corpse^n,EventStackLeader>>."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@BUTTON_4"
msgstr "Abandon Righteousness. [undevotedact/] [arcana/] Astral shall be your true path."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@BUTTON_5"
msgstr "Abandon Righteousness. [undevotedact/] [chaos/] Chaos shall be your true path."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@BUTTON_6"
msgstr "Abandon Righteousness. [undevotedact/] [matter/] Materium shall be your true path."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@BUTTON_7"
msgstr "Abandon Righteousness. [undevotedact/] [nature/] Nature shall be your true path."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@BUTTON_8"
msgstr "Abandon Righteousness. [undevotedact/] [order/] Order shall be your true path."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@BUTTON_9"
msgstr "Abandon Righteousness. [undevotedact/] [shadow/] Shadow shall be your true path."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_626@TITLE"
msgstr "Saving Grace: Aftermath"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_627@BODY_FOOTER"
msgstr "\"Prove that Strife still governs your actions, Oathbreaker,\" the {EventUnit} bellows. \"Conquer {EventHouse} and I shall restore your honor!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_627@BODY_HEADER"
msgstr "You reflect on your past actions, many of which opposed the values of {PlayerOath} when, suddenly, a {EventUnit} reveals itself."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_627@BODY_LORE"
msgstr "You hear the Dragon's voice resound in your head, as <<o:EventUnit>> eyes seem to pierce right into your heart. \"You have led your {PlayerRace} and yourself astray, Oathbreaker {PlayerLeader.FirstName}. Power that you once held, has slipped through your fingers.\" The {EventUnit} grins. \"Power that I may return to you, if you so desire.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_627@BUTTON_0"
msgstr "\"I will not disappoint you, {EventUnit}! For Strife!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_627@BUTTON_1"
msgstr "\"I decline, for I am beyond redemption.\" [undevotedact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_627@TITLE"
msgstr "Hard-knocked Strife"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_628@BODY_FOOTER"
msgstr "\"Now, it is time to re-embrace the tenets of Strife, {PlayerLeader.Title}.\" The {EventUnit} chuckles. \"Unless you have other plans.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_628@BODY_HEADER"
msgstr "After you've claimed victory over {EventHouse}, the {EventUnit} appears before you again. <<Co:EventUnit>> woeful grin oozes with delight."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_628@BODY_LORE"
msgstr "The sounds of turmoil rising from the fallen city delight the Dragon. <<Co:EventUnit>> voice once again penetrates your skull. \"Aah, the cacophony of chaos and calamity. A symphony to the servants of Strife!\" The {EventUnit} constricts you with <<o:EventUnit>> coiling body, moving <<o:EventUnit>> maw inches away from your face. Vapors wafting from out of the serpentine shape invigorate your soul."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_628@BUTTON_0"
msgstr "Renew your oath [devotedact/] to become an agent of Strife once more."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_628@BUTTON_1"
msgstr "Reject the oath [undevotedact/] and embrace your desires to burn cities. [unitHero/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_628@BUTTON_2"
msgstr "Attempt to bind the {EventUnit} to your will."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_628@BUTTON_3"
msgstr "Abandon Strife. [undevotedact/] Wield [arcana/] Astral as if it is your weapon."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_628@BUTTON_4"
msgstr "Abandon Strife. [undevotedact/] Wield [chaos/] Chaos as if it is your weapon."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_628@BUTTON_5"
msgstr "Abandon Strife. [undevotedact/] Wield [matter/] Materium as if it is your weapon."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_628@BUTTON_6"
msgstr "Abandon Strife. [undevotedact/] Wield [nature/] Nature as if it is your weapon."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_628@BUTTON_7"
msgstr "Abandon Strife. [undevotedact/] Wield [order/] Order as if it is your weapon."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_628@BUTTON_8"
msgstr "Abandon Strife. [undevotedact/] Wield [shadow/] Shadow as if it is your weapon."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1167_628@TITLE"
msgstr "Hard-knocked Strife: Aftermath"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1010@BODY_FOOTER"
msgstr "{IntriguePreviousRuler.TitleName} cannot be saved, but you can take one action before the Cage of Binding collapses."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1010@BODY_HEADER"
msgstr "You have defeated {IntrigueVictimPlayerLeader.TitleName} and taken <<o:IntrigueVictimPlayerLeader>> capital, amidst <<o:IntrigueVictimPlayerLeader>> regency. Your armies storm the former capital, flooding into its main halls."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1010@BODY_LORE"
msgstr "Deep within the city you find a hidden dungeon, where you see the {IntriguePreviousRuler.Title}, slumbering in elaborate construct of ritual, arcane sigils and machine that you recognize as a {GLOBAL.CageOfBindingLoreConcept.Hyperlink}. Unfortunately, the former {IntrigueVictimPlayerLeader.Title} had set a trap. Without having taken the proper precautions, the trap triggers and the cage starts to disintegrate, no doubt resulting in the defeat of {IntriguePreviousRuler.TitleName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1010@BUTTON_0"
msgstr "Overcharge the siphon to claim its power [mana/] in one burst, destroying the Cage and banishing {IntriguePreviousRuler.FirstName} instantly."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1010@BUTTON_2"
msgstr "Save whatever you can from the Cage before it collapses to study it. [knowledge/]."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1010@BUTTON_3"
msgstr "Spiritually guide [mana/] {IntriguePreviousRuler.TitleName} to Magehaven [goodact/]."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1010@TITLE"
msgstr "A Short-Lived Regency"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1034@BODY_FOOTER"
msgstr "It seems the {IntriguePreviousRuler.Title} of the {IntrigueVictimPlayerRace} has been replaced. How could this have happened to <<P:IntriguePreviousRuler>>? Is this a threat... or an opportunity for you?"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1034@BODY_HEADER"
msgstr "As you ponder the realm, you are suddenly contacted by none other than a {CalamityDragonUnit}, who now seems to rule the {IntrigueVictimPlayerRace}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1034@BODY_LORE"
msgstr "With a thundering voice, the {IntrigueVictimPlayerLeader.Title} announces: \"Behold the arrival of {IntrigueVictimPlayerLeader.Name}, Calamity incarnate! The {IntrigueVictimPlayerRace} have been deemed worthy of my guidance into [hyperlink,GLOBAL.ChaosConcept]Chaos[/hyperlink]. Join me or face your demise!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1034@BUTTON_0"
msgstr "I must be ready for whatever is to come."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1034@TITLE"
msgstr "Omen of Destruction"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1038@BODY_FOOTER"
msgstr "\"Your people are wondering what our great Empire is doing to stop the doom heralded by the {IntrigueVictimPlayerLeader.Title}. What should we tell them?\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1038@BODY_HEADER"
msgstr "You are approached by one of your council members. \"My {PlayerLeader.Title}, there are reports of concern from the outer areas of your empire.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1038@BODY_LORE"
msgstr "\"The villagers fear the {IntrigueVictimPlayerLeader.Title} heralds the end of the world. For a {GLOBAL.GodirLoreConcept.Hyperlink} such as you this realm may be but a small speck within the {GLOBAL.AstralSeaLoreConcept.Hyperlink}, but for these villagers this is their home and will be so for generations. They want to know their {PlayerLeader.Title} will protect them and their livelihoods.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1038@BUTTON_0"
msgstr "\"Have no fear. By my authority we shall find a way to stop the {IntrigueVictimPlayerLeader.Title}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1038@BUTTON_1"
msgstr "\"The people are overreacting, the {IntrigueVictimPlayerLeader.Title} is here to stay\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1038@BUTTON_2"
msgstr "\"Calamity is a blessed herald of change and the eternal cycle! Rejoice in its splendor!\" [chaosboon/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1038@TITLE"
msgstr "Heralding the End"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1039@BODY_FOOTER"
msgstr "<<g:voice^n,IntriguePreviousRuler>> turns bitter: \"The {IntrigueVictimPlayerLeader.Title} overwhelmed me, drained me of my {GLOBAL.GodirLoreConcept.Hyperlink} powers and took my throne, MY Empire.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1039@BODY_HEADER"
msgstr "You have sent inquiries on the appearance of the {IntrigueVictimPlayerLeader.Title}. Then, an unexpected visitor requests an audience."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1039@BODY_LORE"
msgstr "None other than {IntriguePreviousRuler.TitleName} enters your court. \"{PlayerLeader.TitleName},\" <<p:IntriguePreviousRuler>> says: \"I stand before you bearing no arms. I noticed you were investigating the {IntrigueVictimPlayerLeader.Title}, and you need look no further. I bring you all the answers you need, for I am responsible for <<o:IntrigueVictimPlayerLeader>> presence. In my pursuit of [hyperlink,GLOBAL.ChaosConcept]Chaos[/hyperlink], I attracted the <<P:IntrigueVictimPlayerLeader>> to this realm...\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1039@BUTTON_0"
msgstr "Gesture for {IntriguePreviousRuler.FirstName} to continue."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1039@TITLE"
msgstr "Heralding the End: Aftermath"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1049@BODY_FOOTER"
msgstr "\"To fight the force of desolation, one needs the power of growth. To weaken the {IntrigueVictimPlayerLeader.Title}, one must claim the {EventStructure}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1049@BODY_HEADER"
msgstr "\"It pains me to admit this,\" {IntriguePreviousRuler.FirstName} continues, \"but without my powers as a {GLOBAL.GodirLoreConcept.Hyperlink} I will need your aid.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1049@BODY_LORE"
msgstr "\"It will be tempting to attack the {IntrigueVictimPlayerLeader.Title} directly; it is what I would do. But <<p:IntrigueVictimPlayerLeader>> is a force of destruction, and defeating <<P:IntrigueVictimPlayerLeader>> directly would mean the end of my Empire. So, I ask you to weaken <<o:IntrigueVictimPlayerLeader>> grip on [hyperlink,GLOBAL.ChaosConcept]Chaos[/hyperlink] first, before defeating <<P:IntrigueVictimPlayerLeader>>. It is the only way for me to reclaim my throne.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1049@BUTTON_0"
msgstr "\"I will claim this {EventStructure}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1049@BUTTON_1"
msgstr "\"No, I do not think I will.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1049@BUTTON_4"
msgstr "\"You were a fool to approach me at your weakest. [influence/] Enjoy the Void.\" [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1049@TITLE"
msgstr "Calamity and Wonder"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1050@BODY_FOOTER"
msgstr "By combining <<g:chaos powers^p,IntriguePreviousRuler>> and your own, you weaken the {IntrigueVictimPlayerLeader.Title} and can channel something else..."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1050@BODY_HEADER"
msgstr "You have claimed the {EventStructure}. As you gaze up to it, you feel the primordial power that emanates from it."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1050@BODY_LORE"
msgstr "\"Life after desolation,\" {IntriguePreviousRuler.FirstName} says, looking up at the massive tree. \"The pure power of the {EventStructure} will halt <<g:trail of destruction^n,IntrigueVictimPlayerLeader>>, and weaken <<P:IntrigueVictimPlayerLeader>>. This will allow me to reclaim my Empire.\" <<Cp:IntriguePreviousRuler>> glances at you. \"My powers are limited, but I can aid you to channel the power of the {EventStructure} into something that can help our endeavor.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1050@BUTTON_0"
msgstr "Summon an army to aid you! [unit/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1050@BUTTON_1"
msgstr "Summon an army of chaos and fire! [unit/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1050@BUTTON_2"
msgstr "Summon an army of natural protectors! [unit/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1050@BUTTON_3"
msgstr "Summon a magical weapon! [item/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1050@BUTTON_4"
msgstr "Channel the Tree's force of Life to expand your knowledge! [knowledge/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1050@TITLE"
msgstr "Calamity and Wonder: Aftermath"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1054@BODY_FOOTER"
msgstr "\"Some of my most loyal subjects have escaped <<g:ashen grasp^n,IntrigueVictimPlayerLeader>> and offer to join you.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1054@BODY_HEADER"
msgstr "With the force of the {EventStructure} on your side, your gaze shifts to the destruction wrought by the {IntrigueVictimPlayerLeader.Title}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1054@BODY_LORE"
msgstr "As you ponder possible strategies, {IntriguePreviousRuler.FirstName} joins you. \"To defeat the {IntrigueVictimPlayerLeader.Title} you must take {EventCity}. I take no joy in scheming against my own {IntrigueVictimPlayerRace}, but as the {IntrigueVictimPlayerLeader.Title} controls them, I see no other way.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1054@BUTTON_0"
msgstr "\"I accept Their aid.\" [unit/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1054@BUTTON_1"
msgstr "\"I refuse to take further part in your failures.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1054@BUTTON_4"
msgstr "\"My army is strong enough.\" [morale/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1054@TITLE"
msgstr "Mountains of Ash"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1055@BODY_FOOTER"
msgstr "Hatred shines in the eyes of {IntriguePreviousRuler.FirstName}. \"{PlayerLeader.FirstName}, allow me to show this {IntrigueVictimPlayerLeader.Title} what happens when you try to dethrone a {GLOBAL.GodirLoreConcept.Hyperlink}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1055@BODY_HEADER"
msgstr "You have conquered {EventCity}. The {IntrigueVictimPlayerLeader.Title} roars and the {IntrigueVictimPlayerRace} look on with bated breath as {IntriguePreviousRuler.Name} marches to the throne room."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1055@BODY_LORE"
msgstr "There, the {IntrigueVictimPlayerLeader.Title} floats, {GLOBAL.GodirLoreConcept.Hyperlink} powers of chaos and destruction diminished. <<Cp:IntrigueVictimPlayerLeader>> recoils and bares <<o:IntrigueVictimPlayerLeader>> fangs, but {IntriguePreviousRuler.FirstName} does not hesitate as <<p:IntriguePreviousRuler>> marches onward. \"You take MY city, take MY throne, destroy MY Empire?!\" {IntriguePreviousRuler.FirstName} yells. \"You wretched snake!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1055@BUTTON_0"
msgstr "Allow {IntriguePreviousRuler.FirstName} <<o:IntriguePreviousRuler>> revenge, and <<o:IntriguePreviousRuler>> title."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1055@BUTTON_1"
msgstr "Destroy {IntriguePreviousRuler.FirstName}, subjugate the {IntrigueVictimPlayerLeader.Title} and {IntrigueVictimPlayerRace}. [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1055@BUTTON_2"
msgstr "Destroy both the {IntrigueVictimPlayerLeader.Title} and {IntriguePreviousRuler.Name}, causing <<o:IntriguePreviousRuler>> Empire to collapse. [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1055@TITLE"
msgstr "Mountains of Ash: Aftermath"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1056@BODY_FOOTER"
msgstr "{IntrigueVictimPlayerLeader.TitleName} sighs as <<p:IntrigueVictimPlayerLeader>> sinks in <<o:IntrigueVictimPlayerLeader>> throne. \"I suppose I owe you, don't I.\" {IntrigueVictimPlayerLeader.FirstName} nods. \"Name your reward.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1056@BODY_HEADER"
msgstr "You step back as {IntrigueVictimPlayerLeader.FirstName} approaches the {IntriguePreviousRuler.Title} with murderous intent."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1056@BODY_LORE"
msgstr "With every step, <<g:powers^p,IntrigueVictimPlayerLeader>> grow and those of the {IntriguePreviousRuler.Title} dwindle. Still, the {IntriguePreviousRuler.Title} grins, baring a large row of teeth. \"Do you see now, dearest {IntrigueVictimPlayerLeader.FirstName}, the promise of true Calamity? Decay is the natural state of the world, just you wai...\"[br/]Before <<p:IntriguePreviousRuler>> can finish <<o:IntriguePreviousRuler>> monologue, {IntrigueVictimPlayerLeader.FirstName} obliterates <<P:IntriguePreviousRuler>>. \"Shut. Up.\" {IntrigueVictimPlayerLeader.FirstName} snarls. Without further ado, <<p:IntrigueVictimPlayerLeader>> takes <<o:IntrigueVictimPlayerLeader>> throne."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1056@BUTTON_0"
msgstr "\"I will need an ally on this realm. Join me, to victory!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1056@BUTTON_1"
msgstr "\"Share your knowledge [knowledge/] and prosperity with me, {IntrigueVictimPlayerLeader.FirstName}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1056@BUTTON_2"
msgstr "\"You cannot be trusted to rule. Become my vassal instead.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1056@BUTTON_3"
msgstr "\"You are too weak to be called Godir, and I will face you in war yet.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1056@TITLE"
msgstr "From the Ashes"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1057@BODY_FOOTER"
msgstr "The {IntrigueVictimPlayerLeader.Title} regards you with morbid curiosity. \"I am bound to you. What could a {PlayerLeader.Title} ask of a bested {IntrigueVictimPlayerLeader.Title}?\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1057@BODY_HEADER"
msgstr "{IntriguePreviousRuler.FirstName} approaches the {IntrigueVictimPlayerLeader.Title} with murderous intent. The Dragon coils around and grins, fangs bared for the upcoming battle."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1057@BODY_LORE"
msgstr "As {IntriguePreviousRuler.FirstName} turns <<o:IntriguePreviousRuler>> back to you, you signal your soldiers to attack. The weakened former {IntriguePreviousRuler.Title} is no match for your treachery. \"You... deceiving wretch...\" {IntriguePreviousRuler.FirstName} gasps, before the [hyperlink,GLOBAL.AstralVoidLoreConcept]Void[/hyperlink] takes <<P:IntriguePreviousRuler>>.[br/]The {IntrigueVictimPlayerLeader.Title} laughs, a thunder that causes cracks to appear in the walls. \"Yes! Destruction, decay... Calamity! You have bested me at this game of chaos, O {PlayerLeader.Title}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1057@BUTTON_0"
msgstr "Force the {IntrigueVictimPlayerLeader.Title} to share more knowledge [knowledge/] on Calamity."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1057@BUTTON_1"
msgstr "Force a tribute of gold [gold/] and magic [mana/]."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1057@BUTTON_2"
msgstr "Claim a host of Accursed soldiers [unit/] on your side."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1057@TITLE"
msgstr "Calamity Conquered"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1058@BODY_FOOTER"
msgstr "As the Empire of {IntriguePreviousRuler.TitleName} crumbles, you can claim one object from the throne room before it collapses completely."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1058@BODY_HEADER"
msgstr "{IntriguePreviousRuler.FirstName} approaches the {IntrigueVictimPlayerLeader.Title} with murderous intent. The Dragon coils around and grins, fangs bared for the upcoming battle."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1058@BODY_LORE"
msgstr "None of them expected you to order your soldiers to swarm in and send both to the {GLOBAL.AstralVoidLoreConcept.Hyperlink}. \"You... dare...\" {IntriguePreviousRuler.FirstName} gasps, before <<p:IntriguePreviousRuler>> fades. The {IntrigueVictimPlayerLeader.Title} only roars with laughter as your armies surround <<P:IntrigueVictimPlayerLeader>>. With a final swoop of <<o:IntrigueVictimPlayerLeader>> tail, <<p:IntrigueVictimPlayerLeader>> destroys the throne and collapses the pillars that uphold the bastion, before <<p:IntrigueVictimPlayerLeader>> too fades."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1058@BUTTON_0"
msgstr "Claim the throne, as a reminder of your might. [influence/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1058@BUTTON_1"
msgstr "Tap into [evilact/] the fading Chaos [chaos/] of the two Rulers to grow your power [mana/]."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1058@BUTTON_2"
msgstr "Force a host of {EventRace} soldiers to join you. [unit/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1058@TITLE"
msgstr "End of an Empire"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1059@BODY_FOOTER"
msgstr "The {IntrigueVictimPlayerLeader.TitleName} revels in the destruction <<p:IntrigueVictimPlayerLeader>> causes."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1059@BODY_HEADER"
msgstr "The {IntrigueVictimPlayerLeader.Title} rises to a darkening sky. Ashen clouds gather and cinders swirl as the air grows heavy with pressure."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1059@BODY_LORE"
msgstr "The dragon roars: \"Let the Age of War commence! Let comets strike! Let fire rain! Behold the glory of Calamity!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1059@BUTTON_0"
msgstr "We will persevere."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1059@BUTTON_1"
msgstr "Rejoice in the destruction! [chaosboon/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1059@TITLE"
msgstr "Shadow of Entropy"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1060@BODY_FOOTER"
msgstr "{IntriguePreviousRuler.TitleName} leaves for {GLOBAL.MagehavenLoreConcept.Hyperlink} as <<o:IntriguePreviousRuler>> Empire crumbles. You can claim one object from its crumbling throne room before it collapses completely."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1060@BODY_HEADER"
msgstr "You defeated the {IntrigueVictimPlayerLeader.Title} without greater precautions. {IntriguePreviousRuler.FirstName} appears before you. \"What have you done?!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1060@BODY_LORE"
msgstr "In a last act of defiance, the {IntrigueVictimPlayerLeader.Title} roars with laughter and takes to the air to destroy the throne of the {IntrigueVictimPlayerRace}, before fading into the {GLOBAL.AstralVoidLoreConcept.Hyperlink}.[br/]{IntriguePreviousRuler.FirstName} looks at the destruction. \"My {IntrigueVictimPlayerRace}, my throne... All gone.\" <<Cp:IntriguePreviousRuler>> can barely withhold her rage. \"I will rebuild elsewhere. This is not the end of my story.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1060@BUTTON_0"
msgstr "Claim the throne, as a reminder of your might. [influence/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1060@BUTTON_1"
msgstr "Tap into [evilact/] the fading Chaos [chaos/] of the two Rulers to grow your warband [unitprod/]."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1060@BUTTON_2"
msgstr "Force a host of {EventRace} soldiers to join you. [unit/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1060@TITLE"
msgstr "End of an Empire"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1125@BODY_FOOTER"
msgstr "\"Those who can rule with faith and [hyperlink,GLOBAL.OrderConcept]Order[/hyperlink] have nothing to fear. Soon, I will contact those worthy of redemption.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1125@BODY_HEADER"
msgstr "Be it near or far, this realm has seen war and strife. As you contemplate this, a new Ruler announces <<r:IntrigueVictimPlayerLeader>>."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1125@BODY_LORE"
msgstr "\"Greetings, {GLOBAL.GodirLoreConcept.Hyperlink}. Given the present state of the realm, {IntriguePreviousRuler.TitleName} has been divested of <<o:IntriguePreviousRuler>> rule until the manifold troubles are settled. In <<o:IntriguePreviousRuler>> stead, the mantle of authority over all {IntrigueVictimPlayerRace} has been bestowed upon me, as the {IntrigueVictimPlayerLeader.Title}. By the sacred powers vested in me, I shall henceforth render judgment upon all who rule here.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1125@BUTTON_0"
msgstr "\"Finally, a devotee of Order [order/] such as I!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1125@BUTTON_1"
msgstr "\"I recognize no authority but my own!\" [imperium/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1125@BUTTON_2"
msgstr "\"Very well...\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1125@TITLE"
msgstr "Day of Judgment"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1129@BODY_FOOTER"
msgstr "Undergoing these trials is the only way to bring back {IntriguePreviousRuler.TitleName}..."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1129@BODY_HEADER"
msgstr "The {IntrigueVictimPlayerLeader.Title} contacts you. \"This realm is a pit of chaos and hostility, and the {GLOBAL.GodirLoreConcept.Hyperlink} here have failed to enforce [hyperlink,GLOBAL.OrderConcept]Order[/hyperlink].\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1129@BODY_LORE"
msgstr "\"These are the very circumstances that compelled my intervention. Yet, the forces of faith are nothing if not merciful. You, {PlayerLeader.TitleName}, are hereby given the opportunity to prove yourself as a worthy Ruler, which will free me of my duty as {IntrigueVictimPlayerLeader.Title}. To do so, you shall prove you can restore order to the realm. Do you accept these trials?\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1129@BUTTON_0"
msgstr "\"I accept this trial.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1129@BUTTON_1"
msgstr "\"I decline these trials, you upstart pack animal!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1129@BUTTON_2"
msgstr "a"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1129@TITLE"
msgstr "Trials of Redemption"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1130@BODY_FOOTER"
msgstr "\"[hyperlink,GLOBAL.OrderConcept]Order[/hyperlink] should be its own reward, yet I recognize old patterns may not be easily broken. As such, I am giving you the authority to present a reward of your choosing.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1130@BODY_HEADER"
msgstr "You have befriended a {GLOBAL.IndependentCityConcept}. The {IntrigueVictimPlayerLeader.Title} appears once more and nods. \"You may prove yourself worthy yet.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1130@BODY_LORE"
msgstr "\"In the grander scheme, many {GLOBAL.GodirLoreConcept.Hyperlink} forget about the power of lower lifeforms. Yet, one must try to find alliances even with those one may dismiss at first.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1130@BUTTON_0"
msgstr "Choose a monetary [gold/] reward."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1130@BUTTON_2"
msgstr "Decide on a blessing on {EventCity}. [food/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1130@BUTTON_3"
msgstr "Decline any reward [influence/], you do this for your empire, not anyone else."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1130@TITLE"
msgstr "Honor the Meek"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1134@BODY_FOOTER"
msgstr "\"Destroy the {EventStructure}, prove you can both pass the sentence and yield the executioner's sword.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1134@BODY_HEADER"
msgstr "The {IntrigueVictimPlayerLeader.Title} hums: \"You have passed the first trial, now you must prove your zeal.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1134@BODY_LORE"
msgstr "\"[hyperlink,GLOBAL.OrderConcept]Order[/hyperlink] balances the scales of harmony and righteous violence. Some creatures are simply irredeemable. There are times when one must cleanse the realm of those who mean harm. That will be your next trial, to prove your worth as this realm's custodian.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1134@BUTTON_0"
msgstr "\"I accept this trial.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1134@BUTTON_1"
msgstr "\"I decline this trial. You have no say over me!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1134@TITLE"
msgstr "Smite the Wicked"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1135@BODY_FOOTER"
msgstr "\"Through this display of might and judgment, you have earned a reward, {PlayerLeader.TitleName}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1135@BODY_HEADER"
msgstr "The {IntrigueVictimPlayerLeader.Title} appears once more. \"You have cleansed the realm of one of its threats. Well done.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1135@BODY_LORE"
msgstr "\"The powers of [hyperlink,GLOBAL.OrderConcept]Order[/hyperlink] summon me to realms that need my judgment. It pleases me to see you are a promising prospect as its guardian. To become the divine hand that gives, but smites when necessary... It is a mantle of honor, but also of obligation.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1135@BUTTON_0"
msgstr "Ask to learn more about Order and its merits."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1135@BUTTON_3"
msgstr "Choose a blessing [happiness/] for all your {EventRace}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1135@BUTTON_4"
msgstr "Decide that any reward should go to those who fight in your name. [morale/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1135@TITLE"
msgstr "Smite the Wicked: Aftermath"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1139@BODY_FOOTER"
msgstr "\"Decide whether this Ruler deserves your mercy, or your wrath.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1139@BODY_HEADER"
msgstr "\"Now, for your final trial,\" the {IntrigueVictimPlayerLeader.Title} says, \"you must balance the scales of justice between benevolence and bloodshed.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1139@BODY_LORE"
msgstr "\"This realm needs to be at peace, which can be found through the blessings of faith, or the force of subjugation. As {GLOBAL.GodirLoreConcept.Hyperlink}, you must weigh the merits of both and choose wisely between them. There are Rulers on this realm who need to be judged, and you will do so.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1139@BUTTON_0"
msgstr "\"I accept this trial.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1139@BUTTON_4"
msgstr "\"I decline this trial. I decide who's worthy of my judgment!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1139@TITLE"
msgstr "Scales of Justice"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1140@BODY_FOOTER"
msgstr "\"My duty as {IntrigueVictimPlayerLeader.Title} is fulfilled. I leave the final decision of the fate of {IntriguePreviousRuler.TitleName} to you.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1140@BODY_HEADER"
msgstr "You have judged and acted upon the fate of a fellow Ruler. Now, the {IntrigueVictimPlayerLeader.Title} appears one more time. \"Well done.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1140@BODY_LORE"
msgstr "\"By deciding between defeat and diplomacy, you have brought a sense of peace and [hyperlink,GLOBAL.OrderConcept]Order[/hyperlink] to the realm, and have proven to be a righteous and capable custodian.\" The {IntrigueVictimPlayerLeader.Title} bows deeply, <<o:IntrigueVictimPlayerLeader>> horns almost touch the floor. \"You are worthy of the title of {GLOBAL.GodirLoreConcept.Hyperlink}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1140@BUTTON_0"
msgstr "\"Leave, then, and allow {IntriguePreviousRuler.Name} to return.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1140@BUTTON_1"
msgstr "\"Stay, {IntrigueVictimPlayerLeader.FirstName}. I can use your guidance.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1140@BUTTON_2"
msgstr "\"{IntriguePreviousRuler.Name} is unworthy. Leave, <<o:IntriguePreviousRuler>> Empire is forfeit.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1140@TITLE"
msgstr "Scales of Justice: Aftermath"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1141@BODY_FOOTER"
msgstr "{IntrigueVictimPlayerLeader.TitleName} sighs as <<p:IntrigueVictimPlayerLeader>> sinks in <<o:IntrigueVictimPlayerLeader>> throne. \"Name your reward.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1141@BODY_HEADER"
msgstr "The {IntriguePreviousRuler.Title} nods. \"So be it. Goodbye, {PlayerLeader.TitleName}.\" With a flash of light, <<p:PreviousRuler>> disappears, and {IntrigueVictimPlayerLeader.TitleName} appears with a spark."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1141@BODY_LORE"
msgstr "\"What... what happened?\" {IntrigueVictimPlayerLeader.FirstName} says, stumbling. \"I was here, ruling my Empire, until a grandiose voice ranted about my so-called failures... It trapped me in the {GLOBAL.AstralVoidLoreConcept.Hyperlink}, and then... it told me you had proven your worth and requested my return. I do not know what you did... but I suppose I owe you my gratitude.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1141@BUTTON_0"
msgstr "\"I will need an ally on this realm. Join me, to victory!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1141@BUTTON_1"
msgstr "\"Share your knowledge [knowledge/] and prosperity [gold/] [mana/] with me, {IntrigueVictimPlayerLeader.FirstName}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1141@BUTTON_2"
msgstr "\"After your absence you cannot be trusted to rule. Become my vassal instead.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1141@BUTTON_3"
msgstr "\"You are too weak to be called Godir, and I will face you in war yet.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1141@TITLE"
msgstr "Justice, Delivered"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1142@BODY_FOOTER"
msgstr "\"I suppose the only question remaining is what our bonds should look like, {PlayerLeader.TitleName}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1142@BODY_HEADER"
msgstr "The {IntrigueVictimPlayerLeader.Title} perks up. \"You request for me to stay? How... unorthodox. I suppose I could.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1142@BODY_LORE"
msgstr "The {IntrigueVictimPlayerLeader.Title} is silent for a moment, then nods. \"It is done. {IntriguePreviousRuler.TitleName} will remain in the {GLOBAL.AstralVoidLoreConcept.Hyperlink} to find <<o:IntriguePreviousRuler>> own way, as you decree. And I will stay on this realm as the new Ruler of the {IntrigueVictimPlayerRace}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1142@BUTTON_0"
msgstr "\"I will need an ally on this realm. Join me, to victory!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1142@BUTTON_1"
msgstr "\"Share your knowledge [knowledge/] and prosperity [gold/] [mana/] with me, {IntrigueVictimPlayerLeader.FirstName}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1142@BUTTON_2"
msgstr "\"You are not ready to fully rule. Become my vassal instead.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1142@BUTTON_3"
msgstr "\"As a new Ruler, you will need to find your own way, with a clean slate.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1142@TITLE"
msgstr "Just Us"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1143@BODY_FOOTER"
msgstr "The {IntrigueVictimPlayerRace} leave for your cities at your decree. All that is left is the fate of their former capital."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1143@BODY_HEADER"
msgstr "The {IntrigueVictimPlayerLeader.Title} nods. \"So be it. I will leave, and {IntriguePreviousRuler.TitleName} shall remain in the {GLOBAL.AstralVoidLoreConcept.Hyperlink}, per your decree.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1143@BODY_LORE"
msgstr "\"This realm is left in your hands, {PlayerLeader.TitleName}. Rule it well.\" With a last bow, the {IntrigueVictimPlayerLeader.Title} disappears."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1143@BUTTON_0"
msgstr "Claim the throne, as a reminder of your might. [influence/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1143@BUTTON_1"
msgstr "Demand some {IntrigueVictimPlayerRace} join you. [unit/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1143@BUTTON_2"
msgstr "Let your benevolence and might be known [happiness/] to all your cities."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1143@TITLE"
msgstr "Clean Slate"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1144@BODY_FOOTER"
msgstr "{IntrigueWarVictimPlayerLeader.TitleName} is outraged and attempts to protest, but nothing can be done about the declaration of {IntrigueVictimPlayerLeader.FirstName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1144@BODY_HEADER"
msgstr "The {IntrigueVictimPlayerLeader.Title} has another announcement to make."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1144@BODY_LORE"
msgstr "\"{IntrigueWarVictimPlayerLeader.TitleName} has failed as a sovereign, <<o:IntrigueWarVictimPlayerLeader>> rule tarnished by incompetence and lack of faith. By decree of the {IntrigueVictimPlayerLeader.Title}, <<o:IntrigueWarVictimPlayerLeader>> crown is forfeit. War shall be <<o:IntrigueWarVictimPlayerLeader>> sentence, as the armies of justice march upon <<o:IntrigueWarVictimPlayerLeader>> kingdom. Let it be known that <<o:IntrigueWarVictimPlayerLeader>> reign ends in fire and steel, for the good of all.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1144@BUTTON_0"
msgstr "So be it."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1144@TITLE"
msgstr "The Hammer Falls"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1145@BODY_FOOTER"
msgstr "Although you cannot bring back {ItnriguePreviousRuler.Name}, you can claim anything from the fading {IntrigueVictimPlayerLeader.Title}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1145@BODY_HEADER"
msgstr "You have defeated {IntrigueVictimPlayerLeader.TitleName} and taken <<o:IntrigueVictimPlayerLeader>> capital. The {IntrigueVictimPlayerLeader.Title} appears once more, <<o:IntrigueVictimPlayerLeader>> haughty demeanor diminished. \"This is an outrage!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1145@BODY_LORE"
msgstr "<<Co:IntrigueVictimPlayerLeader>> panic increases as <<p:IntrigueVictimPlayerLeader>> fades. \"Your insolence can not go unanswered! [hyperlink,GLOBAL.OrderConcept]Order[/hyperlink] will prevail... It must! Justice must be served... I am not done yet! No!\" With a final sparkle of light, the {IntrigueVictimPlayerLeader.Title} disappears into the {GLOBAL.AstralSeaLoreConcept.Hyperlink}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1145@BUTTON_0"
msgstr "Channel [mana/] <<g:fading zeal^n,IntrigueVictimPlayerLeader>> to enhance your own magic."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1145@BUTTON_1"
msgstr "Welcome the {IntrigueVictimPlayerRace} in {EventCity}. [population/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1145@BUTTON_2"
msgstr "Take <<o:IntrigueVictimPlayerLeader>> horns to display them as a symbol of your power. [influence/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1145@TITLE"
msgstr "You and Whose Army"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1156@BODY_FOOTER"
msgstr "With <<g:final words to you^p,IntrigueVictimPlayerLeader>>, all hope of bringing back {IntriguePreviousRuler.Name} is lost. \"You have been judged, and you have been found wanting.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1156@BODY_HEADER"
msgstr "You have failed to convince the {IntrigueVictimPlayerLeader.Title} of your just intentions. <<Cp:IntrigueVictimPlayerLeader>> contacts you with barely veiled disgust."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1156@BODY_LORE"
msgstr "\"Whether by intent or incompetence, you have proven yourself unworthy of your mantle as a {GLOBAL.LeaderConcept}. By the authority vested in me as {IntrigueVictimPlayerLeader.Title}, I decree your removal from this realm for the greater good. Let this stand as an official declaration of {GLOBAL.WarConcept} upon you and all other unworthy sovereigns who dare claim dominion here.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1156@BUTTON_0"
msgstr "\"So be it!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1156@TITLE"
msgstr "Lest Ye Be Judged"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1233@BODY_FOOTER"
msgstr "The {IntriguePreviousRuler.Title} of the {IntrigueVictimPlayerRace} has lost a game with the {IntrigueVictimPlayerLeader.Title} and has been... supplanted."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1233@BODY_HEADER"
msgstr "During a moment of respite, you suddenly feel a cold chill, as a {ReaperUnit} appears before you."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1233@BODY_LORE"
msgstr "The faceless {ReaperUnit} whispers in a voice both immensely loud and soft as the rustle of dead leaves: \"{IntriguePreviousRuler.TitleName} summoned me. <<Cp:IntriguePreviousRuler>> thought <<p:IntriguePreviousRuler>> could chain me, cheat me, but no chains can hold death itself. {IntriguePreviousRuler.Name} gambled with <<o:IntriguePreviousRuler>> [hyperlink,GLOBAL.SoulsLoreConcept]Soul[/hyperlink] and lost. And thus I claim it, and the [hyperlink,GLOBAL.SoulsLoreConcept]Souls[/hyperlink] of the {IntrigueVictimPlayerRace}. I have no name... but you may call me {IntrigueVictimPlayerLeader.FirstName}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1233@BUTTON_0"
msgstr "One must play the hand one is dealt..."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1233@TITLE"
msgstr "A Gamble with Death"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1237@BODY_FOOTER"
msgstr "If you want to investigate the {IntriguePreviousRuler.Title} and the {IntrigueVictimPlayerLeader.Title}, you will need to sift fact from fiction."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1237@BODY_HEADER"
msgstr "Rumors about the fate of {IntriguePreviousRuler.TitleName} and the {ReaperUnit} who now rules the {IntrigueVictimPlayerRace} reach your court. Your advisors are divided."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1237@BODY_LORE"
msgstr "\"No {GLOBAL.GodirLoreConcept.Hyperlink} stands above the primal forces of death, not even {IntriguePreviousRuler.TitleName},\" one of them says. \"I say we let <<P:IntriguePreviousRuler>> learn <<o:IntriguePreviousRuler>> lesson in the [hyperlink,GLOBAL.AstralVoidLoreConcept]Void[/hyperlink].\"[br/]Another councilor is more calculating. \"The {IntrigueVictimPlayerLeader.Title} is a legend among many. Learning more may aid you in avoiding the same fate as {IntriguePreviousRuler.FirstName}. Besides, think of the favor <<p:IntriguePreviousRuler>> would owe you...\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1237@BUTTON_0"
msgstr "\"I will unravel death's mysteries.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1237@BUTTON_1"
msgstr "\"Let {IntriguePreviousRuler.FirstName} rot in the Void, I have other matters to attend to.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1237@TITLE"
msgstr "Death and Legends"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1238@BODY_FOOTER"
msgstr "\"We theorize that to defeat the {IntrigueVictimPlayerLeader.Title}, one must challenge <<P:IntrigueVictimPlayerLeader>> to a game of one's own design.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1238@BODY_HEADER"
msgstr "You have investigated the {IntrigueVictimPlayerLeader.Title} and the fate that befell {IntriguePreviousRuler.TitleName}. One of your scholars approaches you with the results."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1238@BODY_LORE"
msgstr "\"It is widely known that {GLOBAL.SoulsLoreConcept.Hyperlink} of the deceased travel to {GLOBAL.TheWellLoreConcept.Hyperlink}, but the beliefs on how and why differ per-\" The scholar notices your gaze. \"...I digress. The {IntrigueVictimPlayerLeader.Title} said <<p:IntrigueVictimPlayerLeader>> came to rule the {IntrigueVictimPlayerRace} through a wager. It is widely believed that death has a strong connection to fate... and therefore <<m:ReaperUnit>> love games of chance, because they always win.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1238@BUTTON_0"
msgstr "\"Go on...\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1238@TITLE"
msgstr "Death and Legends: Aftermath"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1242@BODY_FOOTER"
msgstr "\"We firmly believe the {EventStructure} holds an artifact that will help you against the {IntrigueVictimPlayerLeader.Title}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1242@BODY_HEADER"
msgstr "The scholar nods, happy that you haven't dismissed <<P:EventUnit>> yet. \"During our search we also investigated myths and legends from other Empires.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1242@BODY_LORE"
msgstr "\"It was the legends of the {IntrigueRandomRace} which led us to the {EventStructure}. Apparently it hides the prison of a legendary thief who cheated <<o:IntrigueWonderHero>> soul away from the grasp of death itself. How ironic, to be entombed after escaping death... It is said <<p:IntrigueWonderHero>> still carries the secret to the greatest trick <<p:IntrigueWonderHero>> played.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1242@BUTTON_0"
msgstr "\"Very well, I will explore this '{EventStructure}'.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1242@BUTTON_1"
msgstr "\"I will not chase myths and legends any longer. I decline.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1242@TITLE"
msgstr "Cheating Fate"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1243@BODY_FOOTER"
msgstr "\"With the {IntrigueItem} in your possession you are ready to confront the {IntrigueVictimPlayerLeader.Title}...\" your scholar says. \"The only question is how.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1243@BODY_HEADER"
msgstr "You have found {IntrigueItem}, a magical artifact that allows you to turn any game in your favor. Your scholar is ecstatic."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1243@BODY_LORE"
msgstr "\"So the legends were true! How glorious, what a great day for us historians!\" The scholar cheers. \"Ahem, but, of course, most importantly, this allows you to challenge the {IntrigueVictimPlayerLeader.Title} to a game of dice. From what I heard, <<p:IntrigueVictimPlayerLeader>> is sure to accept!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1243@BUTTON_0"
msgstr "\"Surely you are about to tell me.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1243@BUTTON_7"
msgstr "\"Putting me in that vulnerable position? Preposterous! I will find another way to deal with this.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1243@TITLE"
msgstr "Cheating Fate: Aftermath"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1247@BODY_FOOTER"
msgstr "\"In order to challenge the {IntrigueVictimPlayerLeader.Title}, you will need to carry the {IntrigueItem} with you... and cast yourself into the {GLOBAL.AstralVoidLoreConcept.Hyperlink}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1247@BODY_HEADER"
msgstr "Your scholar shifts uncomfortably. \"I have considered how to tell you this, my {PlayerLeader.Title}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1247@BODY_LORE"
msgstr "\"In order to properly challenge the {IntrigueVictimPlayerLeader.Title}, we need to give <<P:IntrigueVictimPlayerLeader>> the impression that you are at <<o:IntrigueVictimPlayerLeader>> mercy. Only then will <<p:IntrigueVictimPlayerLeader>> be willing to accept any wager from you.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1247@BUTTON_0"
msgstr "\"...Very well. If I must face death, then die I shall!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1247@BUTTON_1"
msgstr "\"Me, in that vulnerable position? Never! I will find another way to deal with this.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1247@TITLE"
msgstr "Fear no Reaper"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1248@BODY_FOOTER"
msgstr "\"I accept your challenge, {PlayerLeader.TitleName}. Let this moment decide your fate. What do you wager?\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1248@BODY_HEADER"
msgstr "You find yourself teetering on the edge of the {GLOBAL.AstralVoidLoreConcept.Hyperlink}. As you feel the darkness pulling you in, the {IntrigueVictimPlayerLeader.Title} appears."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1248@BODY_LORE"
msgstr "Even in the darkness <<o:IntrigueVictimPlayerLeader>> form is clearly visible. \"I sense no fear or rage in you,\" <<o:IntrigueVictimPlayer>> sighs. \"You welcome my presence. Why?\" When you challenge <<P:IntrigueVictimPlayerLeader>> to a game of dice, <<o:IntrigueVictimPlayerLeader>> voice shifts slightly, almost with... excitement. \"A game of chance, of Fate, I can not resist.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1248@BUTTON_0"
msgstr "\"I wager my soul for the return of {IntriguePreviousRuler.TitleName}, who rightfully rules the {IntrigueVictimPlayerRace}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1248@BUTTON_1"
msgstr "\"I wager my soul for an alliance with you, O {IntrigueVictimPlayerLeader.Title}!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1248@BUTTON_2"
msgstr "\"I wager my soul for you leaving this realm.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1248@TITLE"
msgstr "Fear no Reaper: Confrontation"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1249@BODY_FOOTER"
msgstr "You are immediately contacted by {IntrigueVictimPlayerLeader.TitleName}. \"You... brought me back. I thought this was to be the end of me. I owe you, {PlayerLeader.FirstName}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1249@BODY_HEADER"
msgstr "You cast the {IntrigueItem}. The {IntriguePreviousRuler.Title} stares intently at it as it rolls and lands on the symbol you bet your soul on."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1249@BODY_LORE"
msgstr "The {IntriguePreviousRuler.Title} nods. \"Such an interesting artifact... Life itself is an endless gambit to elude death's grasp, yet those who win often find their prize will sour in time. You have won this day, {PlayerLeader.TitleName}. We will meet again.\" With that, <<p:IntriguePreviousRuler>> fades away and you find yourself back in your capital."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1249@BUTTON_0"
msgstr "\"Let us be allies, then, and join in our quest for victory!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1249@BUTTON_1"
msgstr "\"I take my reward in gold [gold/] and mana [mana/].\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1249@BUTTON_2"
msgstr "\"Your carelessness cost you your claim on this realm. Become my vassal instead.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1249@BUTTON_3"
msgstr "\"I only brought you back to defeat you myself!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1249@TITLE"
msgstr "Death and Life"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1250@BODY_FOOTER"
msgstr "You are now allied to the {IntrigueVictimPlayerLeader.Title}. What would be your first request of this deathly friend?"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1250@BODY_HEADER"
msgstr "You cast the {IntrigueItem}. The {IntrigueVictimPlayerLeader.Title} stares intently at it as it rolls and lands on the symbol you bet your soul on."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1250@BODY_LORE"
msgstr "The {IntriguePreviousRuler.Title} nods. \"Such an interesting artifact... Life itself is an endless gambit to elude death's grasp, yet those who win often find their prize will sour in time. You have won this day, {PlayerLeader.TitleName}. I will call you my... ally.\" You blink and find yourself back in your capital."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1250@BUTTON_0"
msgstr "Ask the {IntrigueVictimPlayerLeader.Title} to share more knowledge [knowledge/] on Death."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1250@BUTTON_1"
msgstr "Request a gift of gold [gold/] and magic [mana/]."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1250@BUTTON_2"
msgstr "Ensure the entire realm knows of your alliance with death itself. [influence/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1250@TITLE"
msgstr "As Old Friends"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1251@BODY_FOOTER"
msgstr "As the {IntrigueVictimPlayerLeader.Title} fades, the former Empire of {IntriguePreviousRuler.TitleName} crumbles, a symbol of inevitability."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1251@BODY_HEADER"
msgstr "You cast the {IntrigueItem}. The {IntrigueVictimPlayerLeader.Title} stares intently at it as it rolls and lands on the symbol you bet your soul on."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1251@BODY_LORE"
msgstr "The {IntrigueVictimPlayerLeader.Title} nods. \"Such an interesting artifact... Life itself is an endless gambit to elude death's grasp, yet those who win often find their prize will sour in time. You have won this day, {PlayerLeader.TitleName}. We will meet again.\" With that, <<p:IntrigueVictimPlayerLeader>> fades away and you find yourself back in your capital."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1251@BUTTON_0"
msgstr "Claim the throne, as a reminder of your might. [influence/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1251@BUTTON_1"
msgstr "Tap into the fading force of the {IntrigueVictimPlayerLeader.Title} [shadow/] to gather arcane energy. [mana/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1251@BUTTON_2"
msgstr "Dig into the deathly knowledge [knowledge/] to enhance your own."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1251@TITLE"
msgstr "Till We Meet Again"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1252@BODY_FOOTER"
msgstr "The <<G:head^n,ReaperUnit>> tilts as <<o:IntrigueVictimPlayerLeader>> game of chance unfolds. \"Fate has decided. The {IntrigueWarVictimPlayerLeader.TitleName} lives... for now.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1252@BODY_FOOTER@REAPERLOST"
msgstr "The <<G:head^n,ReaperUnit>> tilts as <<o:IntrigueVictimPlayerLeader>> game of chance unfolds. \"Fate has decided. The {GLOBAL.SoulsLoreConcept.Hyperlink} of {IntrigueWarVictimPlayerLeader.TitleName} and <<o:IntrigueWarVictimPlayerLeader>> {IntrigueWarVictimPlayerRace} are forfeit... And I shall collect.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1252@BODY_HEADER"
msgstr "Another {GLOBAL.LeaderConcept}, {IntrigueWarVictimPlayerLeader.TitleName}, has recently withdrawn to the {GLOBAL.AstralVoidLoreConcept.Hyperlink}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1252@BODY_LORE"
msgstr "With a sigh as weary as it is disturbingly ecstatic, the {IntrigueVictimPlayerLeader.Title} appears once more. \"Even {GLOBAL.GodirLoreConcept.Hyperlink} beg for their immortal lives when they gaze into the eternal mirror of the Void.\" A {ReaperObject} appears in <<o:IntrigueVictimPlayerLeader>> bony fingers. \"In the face of Death, the {IntrigueWarVictimPlayerLeader.Title} has chosen to gamble the fate of <<o:IntrigueWarVictimPlayerLeader>> [hyperlink,GLOBAL.SoulsLoreConcept]Soul[/hyperlink]...\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1252@BUTTON_0"
msgstr "Very well..."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1252@TITLE"
msgstr "A Game of Fate"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1253@BODY_FOOTER"
msgstr "You can claim one object from the throne room before it collapses completely."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1253@BODY_HEADER"
msgstr "You have defeated the {IntrigueVictimPlayerLeader.Title}. The self-proclaimed representative of death regards you coldly as <<p:IntrigueVictimPlayerLeader>> retreats into the {GLOBAL.AstralVoidLoreConcept.Hyperlink}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1253@BODY_LORE"
msgstr "With the defeat of the {IntrigueVictimPlayerLeader.Title} and the {IntrigueVictimPlayerRace}, all hope of returning {IntriguePreviousRuler.TitleName} is forfeit. The {IntrigueVictimPlayerRace} stumble around without their deathly overlord, and the Empire collapses."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1253@BUTTON_0"
msgstr "Claim the throne, as a reminder of your might. [influence/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1253@BUTTON_1"
msgstr "Tap into [evilact/] the fading force of death [shadow/] to gather arcane energy. [mana/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1253@BUTTON_2"
msgstr "Dig into the deathly knowledge [knowledge/] to enhance your own."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1253@TITLE"
msgstr "Death, Defeated"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1261@BODY_FOOTER"
msgstr "The {IntrigueVictimPlayerLeader.Title} challenges you to a game of chance. On one side: instant resurrection. On the other: a [hyperlink,GLOBAL.WarConcept]War[/hyperlink] with death..."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1261@BODY_HEADER"
msgstr "You were defeated and now find yourself teetering on the edge of the {GLOBAL.AstralVoidLoreConcept.Hyperlink}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1261@BODY_LORE"
msgstr "As you feel the darkness pulling you in, the {IntrigueVictimPlayerLeader.Title} appears once more, floating in the ocean of darkness. \"Even {GLOBAL.GodirLoreConcept.Hyperlink} fear the image reflected in the eternal mirror of the Void,\" the {IntrigueVictimPlayerLeader.Title} sighs. A {ReaperObject} appears in <<o:IntrigueVictimPlayerLeader>> bony fingers, glowing in the eternal darkness. \"What about you, {PlayerLeader.Name}? Would you gamble your fate for a chance of revival?\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1261@BUTTON_0"
msgstr "Take the gamble."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1261@BUTTON_1"
msgstr "Cling to life and the natural realm to influence the odds."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1261@BUTTON_2"
msgstr "Channel your control over death to influence your own."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1261@BUTTON_3"
msgstr "Chaos and fortune are your forte. Twist the odds in your favor."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1261@BUTTON_4"
msgstr "Invoke your faith and zeal to will the odds in your favor."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1261@BUTTON_5"
msgstr "Strengthen the tethers to your physical body and will the odds in your favor."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1261@BUTTON_6"
msgstr "This game is magic, and you control it. Twist the arcane flows to your advantage."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1261@BUTTON_7"
msgstr "Refuse to gamble for your soul."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1261@TITLE"
msgstr "Your Game of Fate"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1283@BODY_FOOTER"
msgstr "As your soldiers prepare to break down the wall, the sound of restless undead can be heard behind it."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1283@BODY_HEADER"
msgstr "As {EventHero.FirstName} enters the {EventStructure} it seems unremarkable, but it does not take long to find a plain wall marked with a symbol."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1283@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "As you enter the {EventStructure} it seems unremarkable, but it does not take long to find a plain wall marked with a symbol."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1283@BODY_LORE"
msgstr "{EventHero.FirstName} recognizes the symbol as a set of dice. Behind the door, however, there is only a dead end, with a sentence carved in the wall: \"Beware the tomb of the nameless thieves;[br/]As they denied even death their due;[br/]Let them choke on the dust of their haul;[br/]And let death's rest ever elude them.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1283@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "You recognize the symbol as a set of dice. Behind the door, however, there is only a dead end, with a sentence carved in the wall: \"Beware the tomb of the nameless thieves;[br/]As they denied even death their due;[br/]Let them choke on the dust of their haul;[br/]And let death's rest ever elude them.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1283@BUTTON_0"
msgstr "\"Tear down the wall, we will subjugate any resistance!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1283@BUTTON_2"
msgstr "Leave the {EventStructure}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1283@BUTTON_3"
msgstr "Use your knowledge of Shadow to weaken whatever stirs inside before opening it."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1283@BUTTON_4"
msgstr "Prepare your army [mana/] for whatever emerges."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1283@TITLE"
msgstr "The {EventStructure}"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1284@BODY_FOOTER"
msgstr " \"You can have these riches, my {IntrigueItem}. I only wish to leave this tomb.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1284@BODY_HEADER"
msgstr "You have defeated {EnemyUnit.Name}, who emerged from a hidden room within the {EventStructure}. <<Cp:EnemyUnit>> raises a hand. \"I yield... I yield.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1284@BODY_LORE"
msgstr "\"I apologize, the promise for freedom had me excited. But I was never a fighter, you see. More of a swindler. I even swindled death itself.\" <<Cp:EnemyUnit>> uncovers a magical object. \"This is {IntrigueItem}, a magically loaded die. My greatest asset... which turned into my curse. I could escape from any bond, break any lock... so they buried me, without any locks or bonds... without even death to escape to.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1284@BUTTON_0"
msgstr "\"Be free then, {EnemyUnit.FirstName}. As Godir I decree your punishment is done.\" [influence/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1284@BUTTON_2"
msgstr "\"I could use a deathless thief like you on my side.\" [unit/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1284@BUTTON_4"
msgstr "\"I could use a deathless thief like you on my side.\" [unit/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1284@BUTTON_5"
msgstr "\"I have a new crypt in {EventCity} with your name on it.\" [unit/] [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1284@TITLE"
msgstr "The {EventStructure}: Aftermath"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1298@BODY_FOOTER"
msgstr "Smoldering leaves gently rain down on your army as they avoid the stampede of animals who flee their former homes."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1298@BODY_HEADER"
msgstr "Your army approaches the {EventStructure}, its crown of leaves glowing red from a fire below."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1298@BODY_LORE"
msgstr "Inside, {EventHero.FirstName} sees several Accursed beings rampaging about, led by a {EnemyUnit}. They are hard at work to set the very roots of the {WorldTreeStructure} on fire. They seem to relish in the destruction and calamity they cause, chasing the animals who attempt to flee the inferno."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1298@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "Inside, You see several Accursed beings rampaging about, led by a {EnemyUnit}. They are hard at work to set the very roots of the {WorldTreeStructure} on fire. They seem to relish in the destruction and calamity they cause, chasing the animals who attempt to flee the inferno."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1298@BUTTON_0"
msgstr "Attack the Accursed enemies!"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1298@BUTTON_2"
msgstr "Flee the burning tree."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1298@BUTTON_4"
msgstr "Channel your magical prowess [mana/] to protect your army from the blaze before engaging."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1298@TITLE"
msgstr "The {EventStructure}"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1299@BODY_FOOTER"
msgstr "Over time, this tree will prevail and renew. Its leaves rustle, almost as if grateful to you."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1299@BODY_HEADER"
msgstr "{EventHero.Name} has slain the Accursed beings who were setting fire to the {WorldTreeStructure}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1299@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "You have slain the Accursed beings who were setting fire to the {WorldTreeStructure}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1299@BODY_LORE"
msgstr "Your army attempts to douse the flames, but the smoldering roots will take a long time to recover. As the smoke clears, however, some animals already make their return. The accursed army that was sent here by {IntrigueVictimPlayerLeader.TitleName} has not succeeded."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1299@BUTTON_0"
msgstr "Summon reinforcements [unitprod/] to help fully douse the tree. [goodact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1299@BUTTON_4"
msgstr "Capture some of these animals for your army. [unit/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1299@BUTTON_5"
msgstr "Harvest the broken branches for {EventCity}. [production/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1299@TITLE"
msgstr "The {EventStructure}: Aftermath"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1334@BODY_FOOTER"
msgstr "\"Prove to me that you can be [hyperlink,GLOBAL.AlignmentConcept]Compassionate[/hyperlink] towards all who reside on this realm.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1334@BODY_HEADER"
msgstr "\"Now, for your final trial,\" the {IntrigueVictimPlayerLeader.Title} says, \"you must show true virtue.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1334@BODY_LORE"
msgstr "\"This realm needs to be at peace, and true peace can only be found through compassion. You must rule, and serve. You must smite, but also aid. You must judge, but also forgive. Prove to me that as a {GLOBAL.GodirLoreConcept.Hyperlink}, you are able to embody these divine virtues.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1334@BUTTON_0"
msgstr "\"I accept this trial.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1334@BUTTON_4"
msgstr "\"I decline this trial. I decide who's worthy of my judgment!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1334@BUTTON_5"
msgstr "\"History is not written by the benevolent, but by those who trample them!\" [evilact/] [influence/] [happiness/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1334@TITLE"
msgstr "Divine Compassion"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1335@BODY_FOOTER"
msgstr "\"My duty as {IntrigueVictimPlayerLeader.Title} is fulfilled. I leave the final decision of the fate of {IntriguePreviousRuler.TitleName} to you.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1335@BODY_HEADER"
msgstr "You have reached a high {GLOBAL.AlignmentConcept.Hyperlink} and proven your compassion. Now, the {IntrigueVictimPlayerLeader.Title} appears one more time. \"Well done.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1335@BODY_LORE"
msgstr "\"By showing your benevolence and forgiveness, you have brought a sense of peace and [hyperlink,GLOBAL.OrderConcept]Order[/hyperlink] to the realm, and have proven to be a righteous and capable custodian.\" The {IntrigueVictimPlayerLeader.Title} bows deeply, <<o:IntrigueVictimPlayerLeader>> horns almost touch the floor. \"You are worthy of the title of {GLOBAL.GodirLoreConcept.Hyperlink}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1335@BUTTON_0"
msgstr "\"Leave, then, and allow {IntriguePreviousRuler.Name} to return.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1335@BUTTON_1"
msgstr "\"Stay, {IntrigueVictimPlayerLeader.FirstName}. I can use your guidance.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1335@BUTTON_2"
msgstr "\"{IntriguePreviousRuler.Name} is unworthy. Leave, <<o:IntriguePreviousRuler>> Empire is forfeit.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_1335@TITLE"
msgstr "Divine Compassion: Aftermath"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_669@BUTTON_2"
msgstr "Cease all investigations into {IntrigueVictimPlayer}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_672@BUTTON_3"
msgstr "\"You are too weak to be called Godir, and I will see your reign end.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_673@BUTTON_1"
msgstr "\"You are a coward and a fool. I will ensure all rulers know.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_673@BUTTON_2"
msgstr "\"Share your knowledge [knowledge/] with me, and all will be forgotten.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_673@BUTTON_3"
msgstr "\"My goal was merely to aid you. I hope to do so in the future.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_674@BUTTON_1"
msgstr "Break the curse on {IntrigueVictimPlayer}, strengthen your bonds with <<P:IntrigueVictimPlayer>>."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_674@BUTTON_2"
msgstr "Leave {IntrigueVictimPlayer} as <<p:IntrigueVictimPlayer>> is, keeping the secret of {IntrigueCulpritPlayer.FirstName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_674@BUTTON_3"
msgstr "Leave {IntrigueVictimPlayer} as <<p:IntrigueVictimPlayer>> is, demand a bribe [gold/] for your silence."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_675@BUTTON_1"
msgstr "Break the curse on {IntrigueVictimPlayer}, claim the {EventItem} and its knowledge yourself."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_675@BUTTON_2"
msgstr "Destroy the {EventItem}, free {IntrigueVictimPlayer}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_730@BODY_FOOTER"
msgstr "It seems the {IntriguePreviousRuler.Title} of the {IntrigueVictimPlayerRace} has been... replaced. How could this have happened to <<P:IntriguePreviousRuler>>? Is this a danger... or an opportunity for you?"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_730@BODY_HEADER"
msgstr "As you ponder the realm, you are suddenly contacted by none other than a {BalorUnit}, who now seems to rule the {IntrigueVictimPlayerRace}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_730@BODY_LORE"
msgstr "Before you can demand an explanation, the new {IntrigueVictimPlayerLeader.Title} grins. \"Mortals and {GLOBAL.GodirLoreConcept.Hyperlink}! The Empire of {IntriguePreviousRuler.Name} is now under new management. Bow to me, the great {IntrigueVictimPlayerLeader.Name}, and despair, for the wrath and fury of {GLOBAL.ObbadothLoreConcept.Hyperlink} has arrived!\" <<Co:IntrigueVictimPlayerLeader>> grin grows darker as <<p:IntrigueVictimPlayerLeader>> severs the connection."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_730@BUTTON_0"
msgstr "Time will tell."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_730@TITLE"
msgstr "A Disturbing Announcement"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_745@BODY_FOOTER"
msgstr "Saving the people from the refugee encampment nearby may be your only way to learn more about the {IntrigueVictimPlayerLeader.TitleName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_745@BODY_HEADER"
msgstr "You shift your focus from the fallen citizen of the {IntrigueVictimPlayerRace}, towards sounds of struggle nearby."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_745@BODY_LORE"
msgstr "You realize it is a camp of refugees who fled the Empire of the {IntrigueVictimPlayerLeader.Title}. They are ambushed by demonic forces and now fight for their lives."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_745@BUTTON_0"
msgstr "Send a party to save the refugees."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_745@BUTTON_1"
msgstr "Decline to take any further part in this."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_745@TITLE"
msgstr "Fiendish Takeover: Refuge"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_746@BODY_FOOTER"
msgstr "If you wish to investigate further, the {EventStructure} is your next target."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_746@BODY_HEADER"
msgstr "You have a new lead in your investigations into the {IntrigueVictimPlayerLeader.Title}. <<Cp:IntrigueVictimPlayerLeader>> was summoned at a {EventStructure}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_746@BODY_LORE"
msgstr "Investigating the {EventStructure} may provide more clues on how to stop the {IntrigueVictimPlayerLeader.Title} and find out who else is involved... or to find ways to profit from this situation."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_746@BUTTON_0"
msgstr "Investigate and destroy the {EventStructure}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_746@BUTTON_1"
msgstr "Cease investigations and leverage any collected evidence against {IntrigueVictimPlayer.Name}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_746@TITLE"
msgstr "Infernal Summoning"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_747@BODY_FOOTER"
msgstr "{IntrigueVictimPlayerLeader.TitleName} snarls, \"Cease your investigations or I will show you what happens when you play with infernal fire!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_747@BODY_HEADER"
msgstr "After defeating any resistance at the Ritual Circle, your troops and scholars search the area involved in the appearance of {IntrigueVictimPlayerLeader.TitleName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_747@BODY_LORE"
msgstr "\"This was indeed the location of a powerful summoning, my {PlayerLeader.Title},\" your scholar says. \"Infernal runes depict a trade between a summoning and banishment to {GLOBAL.ObbadothLoreConcept.Hyperlink}, and of an arcane Contract between the {BalorUnit} and none other than {IntrigueCulpritPlayerLeader.TitleName}!\"[br/][br/]Soon after, you are contacted by the {IntrigueVictimPlayerLeader.Title} <<r:IntrigueVictimPlayerLeader>>. \"So the foolish {GLOBAL.GodirLoreConcept.Hyperlink} insists on sticking <<o:PlayerLeader>> nose into our business.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_747@BUTTON_0"
msgstr "\"I will not be threatened into submission!\" [influence/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_747@TITLE"
msgstr "Infernal Summoning: Aftermath"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_753@BUTTON_1"
msgstr "\"Fire? You will know what fire is when I am done with you!\" [chaosboon/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_753@BUTTON_2"
msgstr "\"I will send you back to Obbadoth, foul spawn!\" [orderboon/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_753@BUTTON_3"
msgstr "\"Even infernal fire cannot melt my walls. Try me, demon!\" [materiumboon/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_753@BUTTON_4"
msgstr "\"You may threaten to scorch and burn, but life always prevails!\" [natureboon/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_753@BUTTON_5"
msgstr "\"You are nothing but a faulty summon. Face me, and I will resolve this anomaly.\" [astralboon/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_753@BUTTON_6"
msgstr "\"Even fire dies when it is starved. I will see you hunger.\" [shadowboon/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_753@BUTTON_7"
msgstr "\"I will consider this...\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_754@BODY_FOOTER"
msgstr "\"If you are the savior the {IntrigueVictimPlayerRace} seek, I shall mark a location on your map where you can meet my companions.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_754@BODY_HEADER"
msgstr "\"My {PlayerLeader.Title}, we expect you want to hear this.\" Your guards bring forward a {IntrigueVictimUnit} of the {IntrigueVictimPlayerRace}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_754@BODY_LORE"
msgstr "<<Cp:IntrigueVictimUnit>> grovels before you, <<o:IntrigueVictimUnit>> clothes ragged and dirty. \"I represent a group of refugees of the {IntrigueVictimPlayerRace}. Our {IntriguePreviousRuler.Title} has succumbed to forces beyond our own, and now the {IntrigueVictimPlayerLeader.Title} and <<o:IntrigueVictimPlayerLeader>> minions torment our Empire. Some of us know more about what happened, but for our own safety, I was not told the details.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_754@BUTTON_0"
msgstr "Send a party to meet the refugees."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_754@BUTTON_1"
msgstr "Decline to mingle in the affairs of other Empires."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_754@TITLE"
msgstr "Fiendish Takeover"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_755@BODY_FOOTER"
msgstr "The citizen slumps to the ground, unable to share more information. More sounds of struggle can be heard from nearby..."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_755@BODY_HEADER"
msgstr "You sent an entourage to meet the \"Concerned Citizen\" who contacted you about the {IntrigueVictimPlayerLeader.Title} of the {IntrigueVictimPlayerRace}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_755@BODY_LORE"
msgstr "Not long after arriving, a <<IntrigueVictimUnit{man/woman}>> emerges, bowing deeply. \"Hail, great {PlayerLeader.Title}. I must be quick, for I fear I was followed. Our {IntriguePreviousRuler.Title} was banished and replaced by a vile Demon from {GLOBAL.ObbadothLoreConcept.Hyperlink}. I know the locat-\" Before <<p:IntrigueVictimUnit>> can finish <<o:IntrigueVictimUnit>> sentence, <<p:IntrigueVictimUnit>> is struck down by an infernal claw."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_755@BUTTON_0"
msgstr "Shift your focus to the sounds of struggle nearby."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_755@TITLE"
msgstr "Fiendish Takeover: Concerned Citizen"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_771@BODY_FOOTER"
msgstr "\"There are power and riches hidden behind the arts others consider 'forbidden'. Step away now, and we can make it worth your while...\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_771@BODY_HEADER"
msgstr "You have learned {IntrigueCulpritPlayerLeader.TitleName} has summoned and signed a Fiendish Contract with the {IntrigueVictimPlayerLeader.Title}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_771@BODY_LORE"
msgstr "The Contract is the key to their shared prowess. Through your spies and contacts you learn it lies hidden in {EventCity}. Before you can ponder further, you are contacted by none other than {IntrigueCulpritPlayerLeader.Name} <<r:IntrigueCulpritPlayerLeader>>. \"Let's not be hasty, {PlayerLeader.FirstName}. Surely you see the potential in allies like I and the {IntrigueVictimPlayerLeader.Title}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_771@BUTTON_0"
msgstr "\"I will end your scheme, {IntrigueCulpritPlayerLeader.FirstName}!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_771@BUTTON_1"
msgstr "\"Very well. I will cease investigating you, for a reward.\" [evilact/] [gold/] [knowledge/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_771@TITLE"
msgstr "Deal with the {IntrigueVictimPlayerLeader.Title}"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_772@BODY_FOOTER"
msgstr "The Contract itself is a powerful magical artifact. With it, you could alter the fate of this realm..."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_772@BODY_HEADER"
msgstr "Inside the main bastion of {EventCity}, you claim the Contract of the {IntrigueVictimPlayerLeader.Title}. Its full meaning becomes clear to you."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_772@BODY_LORE"
msgstr "After a forced \"swap\" between a being from {GLOBAL.ObbadothLoreConcept.Hyperlink} and a {GLOBAL.LeaderConcept.Hyperlink} of this realm, the summoned being receives {GLOBAL.GodirLoreConcept.Hyperlink} powers from the summoner and they will remain in an {GLOBAL.DSAllianceConcept.Hyperlink}, until the realm is conquered. Then, the summoned being will be freed to invade other realms with <<o:IntrigueVictimPlayerLeader>> new thralls, leaving the ashes of this realm to the summoner: {IntrigueCulpritPlayerLeader.FirstName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_772@BUTTON_0"
msgstr "Destroy the Contract and Infernal Alliance, banishing the {IntrigueVictimPlayerLeader.Title} and bringing back {IntriguePreviousRuler.TitleName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_772@BUTTON_1"
msgstr "Use your knowledge [chaosboon/] of the Contract, join in the Alliance between {IntrigueVictimPlayerLeader.FirstName} and {IntrigueCulpritPlayerLeader.FirstName}. [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_772@BUTTON_2"
msgstr "Keep the Contract, use it to claim Infernal powers [knowledge/] [mana/] for yourself! [chaosboon/] [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_772@TITLE"
msgstr "Deal with the {IntrigueVictimPlayerLeader.Title}: Aftermath"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_781@BODY_FOOTER"
msgstr "\"Thank you, {PlayerLeader.TitleName}. Now I have returned I must repair the wrongs done to my {IntrigueVictimPlayerRace}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_781@BODY_HEADER"
msgstr "Through an impressive feat of Godir prowess, you banish the {BalorUnit} who had usurped {IntrigueVictimPlayerLeader.TitleName}, and bring back {IntrigueVictimPlayerLeader.FirstName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_781@BODY_LORE"
msgstr "Not long after, you are contacted by {IntrigueVictimPlayerLeader.Name} <<r:IntrigueVictimPlayerLeader>>. \"I understand I am in your debt, {PlayerLeader.TitleName}, the least I owe you is my side of this story. During a time of respite I was suddenly banished to {GLOBAL.ObbadothLoreConcept.Hyperlink} through foul magics, after which I knew nothing but fire and strife. I feared I may never return, until you reverted the magics that banished me.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_781@BUTTON_0"
msgstr "\"Let us be allies, then, and join in our quest for victory!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_781@BUTTON_1"
msgstr "\"I take my reward in gold [gold/] and mana [mana/]. Your revenge is your own.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_781@BUTTON_2"
msgstr "\"Your carelessness cost you your claim on this realm. Become my vassal instead.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_781@BUTTON_3"
msgstr "\"You are too weak to be called Godir, and I will see your reign end.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_781@TITLE"
msgstr "Infernal Debt"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_783@BODY_FOOTER"
msgstr "You have the opportunity to force a boon from either {IntrigueVictimPlayerLeader.FirstName} or {IntrigueCulpritPlayerLeader.FirstName}. What do you choose?"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_783@BODY_HEADER"
msgstr "You alter the Contract between {IntrigueVictimPlayerLeader.FirstName} and {IntrigueCulpritPlayerLeader.FirstName}, adding yourself to the unbreakable agreement."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_783@BODY_LORE"
msgstr "{IntrigueVictimPlayerLeader.FirstName} and {IntrigueCulpritPlayerLeader.FirstName} have no choice but to accept your {GLOBAL.DSAllianceConcept.Hyperlink}, and neither do you. With your signature, your fates are sealed: You will reach victory on this realm together, or share a fate in the {GLOBAL.AstralVoidLoreConcept.Hyperlink}. Yet, you're no fool. You realize you can alter the Contract slightly, to gain more from this Fiendish Pact."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_783@BUTTON_0"
msgstr "Force {IntrigueVictimPlayerLeader.FirstName} to share demonic knowledge."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_783@BUTTON_1"
msgstr "Force a tribute of gold [gold/] and magic [mana/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_783@BUTTON_2"
msgstr "Claim a host of Obbadothan soldiers [unit/] on your side."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_783@BUTTON_3"
msgstr "Decline to abuse the contract."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_783@TITLE"
msgstr "Three's A Party"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_784@BODY_FOOTER"
msgstr "The power within the Contract allows for one grand feat of magic. What do you choose?"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_784@BODY_HEADER"
msgstr "You claim the Contract between {IntrigueVictimPlayerLeader.FirstName} and {IntrigueCulpritPlayerLeader.FirstName} and channel its power."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_784@BODY_LORE"
msgstr "The Contract pulses with [hyperlink,GLOBAL.ChaosConcept]Chaotic[/hyperlink] energies, with the power to bind even {GLOBAL.GodirLoreConcept.Hyperlink} to the written agreements within. You realize you can channel this raw magical prowess for yourself."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_784@BUTTON_0"
msgstr "Summon a host of Obbadothan soldiers [unit/] on your side."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_784@BUTTON_1"
msgstr "Channel its powers to claim arcane secrets."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_784@BUTTON_2"
msgstr "Consume its power directly to enhance yourself and your people."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_784@BUTTON_3"
msgstr "\"With this Contract as proof, the entire realm will know what you did.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_784@TITLE"
msgstr "Forbidden Knowledge"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_791@BODY_FOOTER"
msgstr "{IntrigueWarVictimPlayerLeader.TitleName} is outraged, but nothing can be done about the declaration of {IntrigueVictimPlayerLeader.FirstName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_791@BODY_HEADER"
msgstr "{IntrigueVictimPlayerLeader.FirstName}, the {BalorUnit} who currently rules the {IntrigueVictimPlayerRace}, has another announcement to make."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_791@BODY_LORE"
msgstr "\"Let it be known that the so-called '{IntrigueWarVictimPlayerLeader.Title}' {IntrigueWarVictimPlayerLeader.FirstName} is nothing but a weakling who will soon be a speck of ash on the realm. I, the great {IntrigueVictimPlayerLeader.Name}, {IntrigueVictimPlayerLeader.Title}, will strike <<P:IntrigueWarVictimPlayerLeader>> down myself!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_791@BUTTON_0"
msgstr "So be it."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_791@TITLE"
msgstr "Sudden Declaration"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_792@BODY_FOOTER"
msgstr "\"As refugees, we lack the means to defy the {IntrigueVictimPlayerLeader.Title}. And thus we leave this knowledge, and the fate of our people, in your hands.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_792@BODY_HEADER"
msgstr "Not long after your entourage arrives, a civilian of the {IntrigueVictimPlayerRace} emerges. \"Hail, great {PlayerLeader.Title}. I am glad our message reached you.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_792@BODY_LORE"
msgstr "\"I was a part of the court of our {IntriguePreviousRuler.Title}, before <<p:IntriguePreviousRuler>> was banished and replaced by a vile Demon from {GLOBAL.ObbadothLoreConcept.Hyperlink}. I fled, for I know the location of the {EventStructure} where the {IntrigueVictimPlayerLeader.Title} was summoned. It must hold the answer as to how this came to be. I fear this was not the work of a mere cultist.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_792@BUTTON_0"
msgstr "\"The fleeing {IntrigueVictimPlayerRace} are welcome in my Empire.\" [population/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_792@BUTTON_1"
msgstr "\"Your trust in me was misplaced. Hand over your possessions [gold/], or die.\" [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_792@BUTTON_2"
msgstr "\"I will keep this in mind.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_792@TITLE"
msgstr "Fiendish Takeover: Concerned Citizen"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_831@BODY_FOOTER"
msgstr "Amidst the panic of the {IntrigueVictimPlayerRace} can sense the [hyperlink,GLOBAL.ChaosConcept]Chaos[/hyperlink] disperse. What is your final act in this infernal chapter?"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_831@BODY_HEADER"
msgstr "You have defeated the {IntrigueVictimPlayerLeader.Title}. The {IntrigueVictimPlayerRace} scatter, freed from the terror of their infernal master, but without their former {GLOBAL.GodirLoreConcept.Hyperlink}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_831@BODY_LORE"
msgstr "The {BalorUnit} roars as <<p:IntrigueVictimPlayerLeader>> is banished back to {GLOBAL.ObbadothLoreConcept.Hyperlink}, leaving ruined cities in <<o:IntrigueVictimPlayerLeader>> wake. Without the knowledge or artifact that summoned <<P:IntrigueVictimPlayerLeader>>, however, you cannot reinstate {IntriguePreviousRuler.TitleName}. Hopefully, <<p:IntriguePreviousRuler>> finds <<o:IntriguePreviousRuler>> own way back to {GLOBAL.MagehavenLoreConcept.Hyperlink}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_831@BUTTON_0"
msgstr "Channel the fleeting Chaotic power to claim arcane secrets."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_831@BUTTON_1"
msgstr "Summon a host of Obbadothan soldiers [unit/] on your side."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_831@BUTTON_2"
msgstr "Welcome fleeing {IntrigueVictimPlayerRace} in your cities. [population/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_831@TITLE"
msgstr "The {IntrigueVictimPlayerLeader.Title}, Defeated"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_832@BODY_FOOTER"
msgstr "The Contract itself is a powerful magical artifact. With it, you could alter the fate of this realm..."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_832@BODY_HEADER"
msgstr "You have defeated {IntrigueCulpritPlayerLeader.TitleName}. In the chaos of <<o:IntrigueCulpritPlayerLeader>> defeat, you find an Infernal Contract between <<P:IntrigueCulpritPlayerLeader>> and {IntrigueVictimPlayerLeader.Name}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_832@BODY_LORE"
msgstr "{IntrigueCulpritPlayerLeader.FirstName} summoned a {BalorUnit} from {GLOBAL.ObbadothLoreConcept.Hyperlink}, banishing and replacing {IntriguePreviousRuler.TitleName}. The Contract further states that <<p:IntrigueCulpritPlayerLeader>> and the {IntrigueVictimPlayerLeader.Title} will remain in an {GLOBAL.DSAllianceConcept.Hyperlink} until the realm is conquered. With the defeat of {IntrigueCulpritPlayerLeader.FirstName}, the Contract becomes void..."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_832@BUTTON_0"
msgstr "Destroy the Contract and Infernal Alliance, banishing the {IntrigueVictimPlayerLeader.Title} and bringing back {IntriguePreviousRuler.TitleName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_832@BUTTON_1"
msgstr "Keep the Contract, use it to claim Infernal powers [knowledge/] [mana/] for yourself! [chaosboon/] [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_832@TITLE"
msgstr "Infernal Summoner, Defeated"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_844@BODY_FOOTER"
msgstr "It is not abnormal for a {GLOBAL.LeaderConcept} to temporarily retreat into the Void. For someone to rule in their temporary absence, however, is certainly... unique."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_844@BODY_HEADER"
msgstr "{IntriguePreviousRuler.TitleName} has recently retreated to the {GLOBAL.AstralVoidLoreConcept.Hyperlink}. In <<o:IntriguePreviousRuler>> absence, a {IntrigueVictimPlayerLeader.Title} introduces <<r:IntrigueVictimPlayerLeader>>."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_844@BODY_LORE"
msgstr "\"Well met. Our great {IntriguePreviousRuler.TitleName} is currently... indisposed, and whilst we investigate <<o:IntriguePreviousRuler>> absence, the weight of our proud {GLOBAL.EmpireConcept} has fallen onto my shoulders. Rest assured, we will find the one responsible for the fate of our grand [hyperlink,GLOBAL.LeaderConcept]Ruler[/hyperlink], and justice will be served.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_844@BUTTON_0"
msgstr "No choice but to see how this develops."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_844@TITLE"
msgstr "A New Regency"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_862@BODY_FOOTER"
msgstr "You could investigate the magics that bind {IntriguePreviousRuler} in the {GLOBAL.AstralVoidLoreConcept.Hyperlink} to help <<P:IntriguePreviousRuler>>... Or use these findings your own advantage."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_862@BODY_HEADER"
msgstr "The {IntrigueVictimUnit} nods. \"Thank you, {PlayerLeader.TitleName}. I will share all I know about the disappearance of our {IntriguePreviousRuler.Title}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_862@BODY_LORE"
msgstr "\"Our {IntriguePreviousRuler.Title} was banished to the {GLOBAL.AstralVoidLoreConcept.Hyperlink}. Usually <<p:IntriguePreviousRuler>> would return to <<o:IntriguePreviousRuler>> throne soon after. Now, however, something binds <<P:IntriguePreviousRuler>> to the darkness. There is magic afoot, and I am certain this is <<g:doing^n,IntrigueVictimPlayerLeader>>... But I lack the power to investigate and prove this.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_862@BUTTON_0"
msgstr "\"I will investigate [knowledge/] these arcane chains.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_862@BUTTON_1"
msgstr "\"On second thought, I am too busy for this.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_862@TITLE"
msgstr "Chains of Magic"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_863@BODY_FOOTER"
msgstr "Your scholar nods. \"We have found evidence that the {IntrigueVictimPlayerLeader.Title} has captured {IntriguePreviousRuler.Name} in a Cage of Binding to enhance <<o:IntrigueVictimPlayerLeader>> power.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_863@BODY_HEADER"
msgstr "The investigation into the cause of <<g:prolonged absence^n,IntriguePreviousRuler>> has completed. Your scholars and the {IntrigueVictimUnit} who joined you present their findings."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_863@BODY_LORE"
msgstr "\"It is worse than I expected, O {PlayerLeader.Title}. My {IntriguePreviousRuler.Title} is not only bound to the {GLOBAL.AstralVoidLoreConcept.Hyperlink}, but the energies that bind <<P:IntriguePreviousRuler>> all converge in our capital {IntrigueVictimPlayerCapital}. The nature of the magics involved and the sudden rise of <<G:power^n,IntrigueVictimPlayerLeader>> strongly imply <<p:IntrigueVictimPlayerLeader>> is using a {GLOBAL.CageOfBindingLoreConcept.Hyperlink} to siphon {GLOBAL.GodirLoreConcept.Hyperlink} energy.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_863@BUTTON_0"
msgstr "\"Very concerning. Go on...\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_863@TITLE"
msgstr "Chains of Magic: Aftermath"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_873@BODY_FOOTER"
msgstr "\"I am no longer safe in {IntrigueVictimPlayerCapital}. I offer my skills as a scholar to the {GLOBAL.LeaderConcept} who aims to prove <<o:IntrigueVictimPlayerLeader>> guilt.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_873@BODY_HEADER"
msgstr "Shortly after the {IntrigueVictimPlayerLeader.Title} has risen to power, your guards bring forward a {IntrigueVictimUnit} of the {IntrigueVictimPlayerRace}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_873@BODY_LORE"
msgstr "\"{PlayerLeader.TitleName}, thank you for hearing me. I hail from {IntrigueVictimPlayerCapital}. When our {IntriguePreviousRuler.Title} was cast into the {GLOBAL.AstralVoidLoreConcept.Hyperlink}, {IntrigueVictimPlayerLeader.FirstName} took control of our {GLOBAL.EmpireConcept}. I know <<P:IntrigueVictimPlayerLeader>> as a schemer who will stop at nothing to gain the power of a {GLOBAL.GodirLoreConcept.Hyperlink}. I am sure <<p:IntrigueVictimPlayerLeader>> is behind the prolonged absence of our {IntriguePreviousRuler.Title}, but I lack the proof.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_873@BUTTON_0"
msgstr "\"Tell me more.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_873@BUTTON_1"
msgstr "\"I have no interest in the politics and drama of other Empires.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_873@TITLE"
msgstr "Suspicious Absence"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_877@BODY_FOOTER"
msgstr "\"Before you can break the Cage that holds {IntriguePreviousRuler.Title}, you will need to collect the necessary components to remove any traps.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_877@BODY_HEADER"
msgstr "You have learned {IntriguePreviousRuler.TitleName} is being kept in a {GLOBAL.CageOfBindingLoreConcept.Hyperlink} in {IntrigueVictimPlayerCapital}, used as a source of power to the {IntrigueVictimPlayerLeader.Title}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_877@BODY_LORE"
msgstr "Using this controversial—some would even say forbidden—method to steal power from a {GLOBAL.GodirLoreConcept.Hyperlink} would be a cause for war for many. \"Yet, a direct assault would be risky,\" the scholar warns you. \"{IntrigueVictimPlayerLeader.FirstName} is no fool, <<p:IntrigueVictimPlayerLeader>> will have tethered the Cage to <<r:IntrigueVictimPlayerLeader>>. We must first break that life-line before we can free my {IntriguePreviousRuler.Title}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_877@BUTTON_0"
msgstr "\"I will claim these locations.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_877@BUTTON_1"
msgstr "\"I do not have time for this.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_877@BUTTON_4"
msgstr "\"I will use all this knowledge [knowledge/] for my own gain instead...\" [influence/] [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_877@TITLE"
msgstr "Arcane Siphon"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_878@BODY_FOOTER"
msgstr "\"There is no [hyperlink,GLOBAL.CageOfBindingLoreConcept]\"Cage\"[/hyperlink] in {IntrigueVictimPlayerCapital}, but your care for my people is commendable. Cease this fruitless endeavor, and we can share our prosperity.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_878@BODY_HEADER"
msgstr "You have collected the necessary ingredients to break the {GLOBAL.CageOfBindingLoreConcept.Hyperlink} that holds {IntriguePreviousRuler.TitleName} in {IntrigueVictimPlayerCapital}. Before you can plan your next steps, however..."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_878@BODY_LORE"
msgstr "You are approached by none other than {IntrigueVictimPlayerLeader.TitleName} <<r:IntrigueVictimPlayerLeader>>. \"{PlayerLeader.TitleName}. It has come to my attention that you take advice from a known fugitive from our Empire. <<Cp:IntrigueVictimUnit>> is a delusional fraud, who has you chasing a slanderous fantasy to distract you from the schemes <<p:IntrigueVictimUnit>> plans within your {GLOBAL.EmpireConcept}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_878@BUTTON_0"
msgstr "\"You are nothing but a usurper, and I will see you fall!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_878@BUTTON_7"
msgstr "\"Very well. I will pretend to believe you.\" [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_878@BUTTON_8"
msgstr "\"My silence can be bought for a price of gold [gold/] and power.\" [influence/] [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_878@TITLE"
msgstr "Arcane Siphon: Aftermath"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_885@BODY_FOOTER"
msgstr "The Cage of Binding in {IntrigueVictimPlayerCapital} can now be approached. Take the city to reach the Cage, and {IntriguePreviousRuler.TitleName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_885@BODY_HEADER"
msgstr "As <<g:face^n,IntrigueVictimPlayerLeader>> falls, you sever the connection with <<P:IntrigueVictimPlayerLeader>> and turn to the {IntrigueVictimUnit} and your scholars."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_885@BODY_LORE"
msgstr "\"I'm relieved you did not fall for <<g:words^p,IntrigueVictimPlayerLeader>>, O {PlayerLeader.Title},\" the {IntrigueVictimUnit} says. \"Few can resist the allure of power... But I digress. Your scholars and I have prepared a ritual of disruption that will weaken the link between {IntrigueVictimPlayerLeader.FirstName} and the {GLOBAL.CageOfBindingLoreConcept.Hyperlink} in {IntrigueVictimPlayerCapital}.\" You gesture in approval, and the ritual commences."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_885@BUTTON_0"
msgstr "\"Call the banners!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_885@BUTTON_1"
msgstr "\"On second thought, I'll take <<g:deal^n,IntrigueVictimPlayerLeader>>.\" [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_885@TITLE"
msgstr "{IntriguePreviousRuler.Title} in a Cage"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_886@BODY_FOOTER"
msgstr "Before you stands the {GLOBAL.CageOfBindingLoreConcept.Hyperlink} with {IntriguePreviousRuler.TitleName} in an eternal slumber. The emanating power is almost intoxicating..."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_886@BODY_HEADER"
msgstr "You have successfully captured {EventCity}. As a {GLOBAL.GodirLoreConcept.Hyperlink}, it does not take you long to locate the source of <<g:powers^p,IntrigueVictimPlayerLeader>>."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_886@BODY_LORE"
msgstr "Stripped of <<o:IntrigueVictimPlayerLeader>> power as a {IntrigueVictimPlayerLeader.Title} and unable to stop you, {IntrigueVictimPlayerLeader.FirstName} has no choice but to watch as you force your way through <<g:bastion^n,EventCity>>. Deep within, you are assaulted by the raw powers of the slumbering {IntriguePreviousRuler.Title} as they are siphoned away through an elaborate construct of ritual, arcane sigils and machine."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_886@BUTTON_0"
msgstr "Break the Cage of Binding, free {IntriguePreviousRuler.TitleName}. [influence/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_886@BUTTON_7"
msgstr "Keep the Cage of Binding, defeat the Empire of {IntriguePreviousRuler.TitleName} and siphon [mana/] <<o:IntriguePreviousRuler>> power. [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_886@TITLE"
msgstr "{IntriguePreviousRuler.Title} in a Cage: Aftermath"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_889@BODY_FOOTER"
msgstr "\"All Rulers beware, {PlayerLeader.TitleName} has captured our beloved {IntriguePreviousRuler.Title} in a Cage of Binding!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_889@BODY_HEADER"
msgstr "The recently appointed {IntrigueVictimPlayerLeader.TitleName} of the {IntrigueVictimPlayerRace} has an announcement to make."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_889@BODY_LORE"
msgstr "\"Our investigations into the prolonged absence of our great {IntriguePreviousRuler.TitleName} have led to a concerning conclusion. It was none other than {IntriguePlayerLeader.TitleName} who put <<P:IntriguePreviousRuler>> in a {GLOBAL.CageOfBindingLoreConcept.Hyperlink}. After all, who else but a {GLOBAL.GodirLoreConcept.Hyperlink} could possess the power to create a Cage such as this? Was it not {PlayerLeader.FirstName} <<r:PlayerLeader>> who recently investigated this forbidden magic?\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_889@BUTTON_0"
msgstr "\"Lies and defamation!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_889@TITLE"
msgstr "Sudden Accusation"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_894@BODY_FOOTER"
msgstr "\"You have my gratitude, {PlayerLeader.TitleName}. Name your reward, and you shall have it.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_894@BODY_HEADER"
msgstr "Through an impressive feat of {GLOBAL.GodirLoreConcept.Hyperlink} prowess, you break the {GLOBAL.CageOfBindingLoreConcept.Hyperlink} in the center of {IntrigueVictimPlayerCapital} and free {IntrigueVictimPlayerLeader.FirstName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_894@BODY_LORE"
msgstr "Even in <<o:IntrigueVictimPlayerLeader>> weakened state, {IntrigueVictimPlayerLeader} returns to <<o:IntrigueVictimPlayerLeader>> original regality. <<Cp:IntrigueVictimPlayerLeader>> barks orders, and soon after the former {IntriguePreviousRuler.Title} is captured and dragged to the prisons of {IntrigueVictimPlayerCapital}. {IntrigueVictimPlayerLeader.TitleName} turns to you. \"You saved me from a fate worse than death. I am no stranger to the {GLOBAL.AstralVoidLoreConcept.Hyperlink}, but a {GLOBAL.CageOfBindingLoreConcept.Hyperlink} is a torture I would not wish upon my greatest enemy.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_894@BUTTON_0"
msgstr "\"I will need an ally on this realm. Join me, to victory!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_894@BUTTON_1"
msgstr "Share your resources [gold/] [mana/] [food/] [knowledge/] with my city {EventCity}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_894@BUTTON_2"
msgstr "\"You cannot be trusted to rule. Become my vassal instead.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_894@BUTTON_3"
msgstr "\"You are too weak to be called Godir, and I will see your reign end.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_894@TITLE"
msgstr "Return of the {IntrigueVictimPlayerLeader.Title}"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_895@BODY_FOOTER"
msgstr "Your Empire demands your attention. What do you do before you leave {IntriguePreviousRuler.TitleName} to <<o:IntriguePreviousRuler>> fate as an arcane source of power?"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_895@BODY_HEADER"
msgstr "As you stand before the {GLOBAL.CageOfBindingLoreConcept.Hyperlink} that holds {IntriguePreviousRuler.TitleName}, the siphoned power almost overwhelms you."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_895@BODY_LORE"
msgstr "At your command, the former {IntrigueVictimPlayerLeader.Title} of the {IntrigueVictimPlayerRace} is dragged away by an angry mob. The {IntrigueVictimUnit} leaves your court, appalled at your decision, but you don't care. If {IntrigueVictimPlayerLeader.FirstName} could use a device such as the one before you, why not you? You did not build it, nor did you imprison {IntriguePreviousRuler.FirstName}. You merely... wield the hand you are dealt."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_895@BUTTON_0"
msgstr "Overcharge the siphon [mana/] to destroy the Cage and banish {IntriguePreviousRuler} to the Void."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_895@BUTTON_1"
msgstr "Order your scholars to study the Cage of Binding and <<g:Magic^n,IntriguePreviousRuler>>. [knowledge/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_895@BUTTON_2"
msgstr "Force your Heroes to absorb some of <<g:power^n,IntriguePreviousRuler>>."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_895@BUTTON_3"
msgstr "Channel <<g:magic^n,IntriguePreviousRuler>> to {EventCity} to temporarily boost its prosperity. [food/] [unitprod/] [production/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_895@TITLE"
msgstr "A Godir's Powers"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_935@BODY_FOOTER"
msgstr "Unrest rumbles within the Empire of {IntrigueVictimPlayerLeader.TitleName}. A threat to be dealt with... or an opportunity for you?"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_935@BODY_HEADER"
msgstr "Too long the {GLOBAL.EmpireConcept} of {IntrigueVictimPlayerLeader.TitleName} has been at unrest. Now, rumors of a rebellion reach your court."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_935@BODY_LORE"
msgstr "Any dissent was met with severe punishment from {IntrigueVictimPlayerLeader.FirstName}, but that only seems to have stirred the flames within. Recently, however, the loudest voice of the {IntrigueVictimPlayerRace} has disappeared, rumored to have fled to greener pastures."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_935@BUTTON_0"
msgstr "Time will tell."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_935@TITLE"
msgstr "Rumors of Rebellion"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_939@BODY_FOOTER"
msgstr "Conquering {IntrigueHouse} seems to be the only way to take this important prisoner from {IntrigueVictimPlayerLeader.FirstName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_939@BODY_HEADER"
msgstr "As you ponder your dominion on this realm, you receive rumors about a person who may be of interest."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_939@BODY_LORE"
msgstr "There is talk of a mysterious prisoner kept in {IntrigueHouse}, blindfolded and gagged, away from all others. Officials say <<p:IntrigueHero>> is a common thief, but the \"special treatment\" seems highly suspicious. There are even whispers about the involvement of {IntrigueVictimPlayerLeader.Name} <<r:IntrigueVictimPlayerLeader>>.[br/]Freeing this prisoner will certainly irk {IntrigueVictimPlayerLeader.FirstName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_939@BUTTON_0"
msgstr "I will free this prisoner."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_939@BUTTON_1"
msgstr "I will have no further part in this."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_939@TITLE"
msgstr "Mysterious Prisoner"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_940@BODY_FOOTER"
msgstr "\"I realize a Godir's aid rarely comes without cost. Yet, I can merely be grateful to breathe fresh air again.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_940@BODY_HEADER"
msgstr "You have conquered {IntrigueHouse}. In the deepest dungeon your soldiers find the rumored blindfolded and gagged prisoner."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_940@BODY_LORE"
msgstr "When <<p:IntrigueHero>> is brought before you, it becomes clear the prisoner has not seen daylight, or any sort of comfort, in a long time. <<Co:IntrigueHero>> voice is hoarse, almost a whisper when <<p:IntrigueHero>> speaks, but <<p:IntrigueHero>> stands unafraid before you. \"My name is {IntrigueHero.FirstName}, proud citizen of {IntrigueVictimPlayerCapital}... or I was, before I was imprisoned.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_940@BUTTON_0"
msgstr "\"Tell me more about your imprisonment.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_940@BUTTON_2"
msgstr "\"Your gratitude is misplaced, you are my prisoner now!\" [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_940@TITLE"
msgstr "Mysterious Prisoner: Aftermath"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_945@BODY_FOOTER"
msgstr "\"I have many supporters in {IntrigueVictimPlayerCapital}. Aid me in taking the city, and the {IntrigueVictimPlayerRace} will be in your debt.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_945@BODY_HEADER"
msgstr "{IntrigueHero.FirstName} snarls. \"I was imprisoned because '{IntrigueVictimPlayerLeader.Title}' {IntrigueVictimPlayerLeader.FirstName} is afraid of <<o:IntrigueVictimPlayerLeader>> very own subjects, and the power of the {IntrigueVictimPlayerRace}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_945@BODY_LORE"
msgstr "\"We {IntrigueVictimPlayerRace} are treated terribly by our {IntrigueVictimPlayerLeader.Title}. People can only take so much abuse before they rise against a regime, even a [hyperlink,GLOBAL.GodirLoreConcept]Godir's[/hyperlink]. There were many voices during this uprising, but I suppose I was the loudest. And so I was silenced. Now you have freed me, I must in turn unite and free my people from <<g:tyranny^n,IntrigueVictimPlayerLeader>>.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_945@BUTTON_0"
msgstr "\"I will aid you in your rebellion, {IntrigueHero.FirstName}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_945@BUTTON_1"
msgstr "\"You are free to leave, but I will not aid a rebellion.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_945@BUTTON_4"
msgstr "\"Your trust in me is misplaced, you are my prisoner now!\" [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_945@TITLE"
msgstr "Voice of the People"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_946@BODY_FOOTER"
msgstr "{IntrigueHero.FirstName} readies <<r:IntrigueHero>> to ascend to the throne of {IntrigueVictimPlayerCapital}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_946@BODY_HEADER"
msgstr "You have taken {IntrigueVictimPlayerCapital}. As your soldiers flood its streets, {IntrigueHero.Name} marches to the capital, gathering a large following behind <<P:IntrigueHero>>."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_946@BODY_LORE"
msgstr "Before long, {IntrigueHero} stands before the throne which belonged to {IntrigueVictimPlayerLeader.TitleName}. \"Finally, our strife has come to an end.\" <<Cp:IntrigueHero>> turns to the gathered crowd before <<P:IntrigueHero>>: \"Citizens of {IntrigueVictimPlayerCapital}, this is the start of a new dawn. No more shall a tyrant rule the {IntrigueVictimPlayerRace}! No longer shall we kneel for unworthy {GLOBAL.GodirLoreConcept.Hyperlink}!\" The crowd cheers wildly."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_946@BUTTON_0"
msgstr "Support the new Rule of {IntrigueHero.FirstName} of the {IntrigueVictimPlayerRace}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_946@BUTTON_7"
msgstr "Take this chance to assassinate {IntrigueHero.FirstName} before <<p:IntrigueHero>> can ascend. [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_946@TITLE"
msgstr "Voice of the People: Aftermath"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_947@BODY_FOOTER"
msgstr "\"I and the {IntrigueVictimPlayerRace} are in your debt, {PlayerLeader.TitleName}. Name your reward.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_947@BODY_HEADER"
msgstr "The {IntrigueVictimPlayerRace} have a new {IntrigueVictimPlayerLeader.Title}: {IntrigueVictimPlayerLeader.Name}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_947@BODY_LORE"
msgstr "Having been removed from <<o:IntriguePreviousRuler>> throne by <<o:IntriguePreviousRuler>> own former subjects, {IntriguePreviousRuler.TitleName} is sent to the {GLOBAL.AstralVoidLoreConcept.Hyperlink}.[br/][br/]\"This was inevitable,\" {IntrigueVictimPlayerLeader.TitleName} says. \"The people demand their pound of flesh. Let us hope this ends the bloodshed and injustice in {IntrigueVictimPlayerCapital}.\" <<Cp:IntrigueVictimPlayerLeader>> turns to you. \"This would not have been possible without your aid.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_947@BUTTON_0"
msgstr "\"I will need supportive allies on this realm. Join me, to victory!\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_947@BUTTON_1"
msgstr "Share your resources [gold/] [mana/] [food/] [knowledge/] with my city {EventCity}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_947@BUTTON_2"
msgstr "\"Ruling an Empire is hard for the uninitiated. Become my vassal instead.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_947@TITLE"
msgstr "Long Live the {IntrigueVictimPlayerLeader.Title}"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_948@BODY_FOOTER"
msgstr "You have thoroughly destroyed any sense of unity within the Empire of {IntrigueVictimPlayerLeader.TitleName}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_948@BODY_HEADER"
msgstr "You order your soldiers to assassinate {IntrigueHero.FirstName} on the brink of ascension. <<Cp:IntrigueHero>> stares at the knives protruding from <<o:IntrigueHero>> body in disbelief."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_948@BODY_LORE"
msgstr "Without another word, the would-be {IntrigueHero.Title} slumps to the floor, blood pooling around <<P:IntrigueHero>>. The {IntrigueVictimPlayerRace} wail in agony at the loss of their liberator."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_948@BUTTON_0"
msgstr "\"This is what happens to those who defy a Godir's rule.\" [influence/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_948@BUTTON_1"
msgstr "Loot [item/] and claim <<g:body^n,IntrigueHero>> [unit/] for your own crypt."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_948@BUTTON_3"
msgstr "Reinstate {IntrigueVictimPlayerLeader.TitleName} and force <<P:IntrigueVictimPlayerLeader>> into submission."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_948@TITLE"
msgstr "Et tu, {PlayerLeader.FirstName}"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_954@BODY_FOOTER"
msgstr "\"May this siege be over soon,\" {IntrigueHero.FirstName} says, staring at the city. \"So my people need not suffer any longer.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_954@BODY_HEADER"
msgstr "You have reached {IntrigueVictimPlayerCapital}. As you initiate the siege, {IntrigueHero.FirstName} steps forward, clearly visible from the walls."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_954@BODY_LORE"
msgstr "\"{IntrigueVictimPlayerRace}!\" <<Cp:IntrigueHero>> shouts, \"Brothers, sisters! I have returned, with the aid and support of {PlayerLeader.TitleName}! We are not alone, we are many, we can never be silenced! Rise up against the tyrant {IntrigueVictimPlayerLeader.Name}!\" A faint cheering can be heard from the walls of {IntrigueVictimPlayerCapital}, followed by the sounds of riots and unrest within."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_954@BUTTON_0"
msgstr "Continue your siege."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_954@BUTTON_1"
msgstr "Take this chance to assassinate {IntrigueHero.FirstName} before <<p:IntrigueHero>> can fulfill <<o:IntrigueHero>> quest. [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_954@TITLE"
msgstr "Voice of the People: {IntrigueVictimPlayerCapital}"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_956@BODY_FOOTER"
msgstr "\"This means war, {PlayerLeader.TitleName}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_956@BODY_HEADER"
msgstr "Shortly after liberating a prisoner of {IntrigueVictimPlayerLeader.TitleName}, you are contacted by the {IntrigueVictimPlayerLeader.Title} <<r:IntrigueVictimPlayerLeader>>."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_956@BODY_LORE"
msgstr "{IntrigueVictimPlayerLeader.FirstName} speaks coldly: \"You underestimate me if you think I am unaware of what you are planning. Your only goal is to sow dissent, and I will not accept it.\" A thin smile creeps across <<o:IntrigueVictimPlayerLeader>> face: \"Luckily nothing unites a people more than a common threat.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_956@BUTTON_0"
msgstr "\"So be it.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_956@TITLE"
msgstr "No Good Deed"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_978@BODY_FOOTER"
msgstr "\"We cannot banish the {IntrigueVictimPlayerLeader.Title}, but you can. Please, {IntriguePlayerLeader.TitleName}. Destroy that vile demon. Save the {IntrigueVictimPlayerRace}...\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_978@BODY_HEADER"
msgstr "You rescued a group of refugees from a demonic assault. Battered but grateful, the survivors gather around your army."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_978@BODY_LORE"
msgstr "The last thing the concerned citizen told you before <<o:IntrigueVictimUnit>> demise, was about the summoning of {IntrigueVictimPlayerLeader.TitleName}. Upon inquiry, one of the refugees limps forward. \"You mean the {EventStructure}?\" <<Cp:IntrigueVictimUnit>> says, despite hushed warnings from <<o:IntrigueVictimUnit>> comrades. \"I... I know where it is. But I must warn you, O {PlayerLeader.Title}. This was not the work of a simple cult.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_978@BUTTON_0"
msgstr "\"The fleeing {IntrigueVictimPlayerRace} are welcome in my Empire.\" [population/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_978@BUTTON_1"
msgstr "\"Your trust in me is misplaced. Hand over your possessions [gold/], or die.\" [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_978@BUTTON_2"
msgstr "\"I will keep this in mind.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_978@TITLE"
msgstr "Fiendish Takeover: Aftermath"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_987@BODY_FOOTER"
msgstr "The remaining {IntrigueVictimPlayerRace} have no choice but to await your judgment on their fate. How do you address them?"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_987@BODY_HEADER"
msgstr "You have defeated {IntrigueVictimPlayerLeader.TitleName} and taken <<o:IntrigueVictimPlayerLeader>> capital, amidst a brewing rebellion."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_987@BODY_LORE"
msgstr "Your armies storm into the former capital, dissuading any further unrest. The fall of the grand Empire echoes through the realm, and any rumors of rebellion and prisoners disappear with those who flee your expected wrath."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_987@BUTTON_0"
msgstr "\"As this Empire falls, remember the might of {PlayerLeader.TitleName}.\" [influence/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_987@BUTTON_2"
msgstr "\"The {IntrigueVictimPlayerRace} will be aided [food/] during these times of uncertainty.\" [goodact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_987@BUTTON_3"
msgstr "You do not address the people. You loot the city. [gold/] [evilact/]"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_987@TITLE"
msgstr "Rebellion: Crushed"

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_988@BODY_FOOTER"
msgstr "You sense an arcane power rise around {IntrigueHero.FirstName}. If you let <<P:IntrigueHero>>, <<p:IntrigueHero>> will ascend to become the [hyperlink,GLOBAL.LeaderConcept]Ruler[/hyperlink] of the {IntrigueVictimPlayerRace}."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_988@BODY_HEADER"
msgstr "{IntrigueHero.FirstName} snarls. \"I was imprisoned because '{IntrigueVictimPlayerLeader.Title}' {IntrigueVictimPlayerLeader.FirstName} is afraid of <<o:IntrigueVictimPlayerLeader>> very own subjects, and the power of the {IntrigueVictimPlayerRace}.\""

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_988@BODY_LORE"
msgstr "\"<<g:power^n,IntrigueVictimPlayerLeader>> is dwindling, <<o:IntrigueVictimPlayerLeader>> capital taken, and thus I must guide my people.\" Before long, {IntrigueHero.FirstName} stands before <<o:IntrigueHero>> people. \"Proud {IntrigueVictimPlayerRace}, our strife has come to an end! No more shall a tyrant rule over us! No longer shall we kneel for unworthy {GLOBAL.GodirLoreConcept.Hyperlink}!\" The crowd cheers wildly at the return of their [hyperlink,GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink]."

msgid "DLC@WAYSOFWAR@STORY_EVENT@1194_988@TITLE"
msgstr "Voice of the People"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@BRAVERY@DESCRIPTION"
msgstr "Your people follow a path of Strife, seeking to forge their strength in the fires of war:[bulletlist][bullet/]Gain grievances against <<m:{GLOBAL.LeaderConcept.Hyperlink}>> with an overall better ranking.[bullet/]{GLOBAL.RazingConcept.Hyperlink} <<m:{GLOBAL.CityConcept.Hyperlink}>> and {GLOBAL.PillagingConcept.Hyperlink} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> takes -{duration} {GLOBAL.TurnConcept}.[bullet/]{GLOBAL.RazingConcept.Hyperlink} <<m:{GLOBAL.CityConcept.Hyperlink}>> and {GLOBAL.PillagingConcept.Hyperlink} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> yields {GLOBAL.ImperiumConcept.Hyperlink}.[bullet/]Culture units have {GLOBAL.PROPERTIES.WARRIORS_SOUL.Hyperlink}.[bullet/]Become stronger as you gain {GLOBAL.DevotionConcept.Hyperlink} to the {GLOBAL.OathOfStrife.Hyperlink}.[/bulletlist]"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@BRAVERY@LORENAME"
msgstr "Sworn^f"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@BRAVERY@NAME"
msgstr "Strife"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@HARMONY@ADHERENT_TOOLTIP_DESCRIPTION"
msgstr "[bullet/]{GLOBAL.PROPERTIES.HARMONIZE.Hyperlink}: Heal {amount} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@HARMONY@DEVOTEE_TOOLTIP_DESCRIPTION"
msgstr "[bullet/]{GLOBAL.PROPERTIES.HARMONIZE.Hyperlink}: Heal {amount} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@HARMONY@DEVOTION_DESCRIPTION"
msgstr "[bulletlist][bullet/]Gain {GLOBAL.DevotionConcept.Hyperlink} by:[bulletlist][bullet/]Having a {GLOBAL.CityConcept.Hyperlink} or {GLOBAL.PvEVassalConcept.Hyperlink} of another Race +{GLOBAL.FromVassalage} [devotedact/].[bullet/]Clearing an {GLOBAL.InfestationConcept.Hyperlink} or {GLOBAL.AncientWonderConcept.Hyperlink} +{GLOBAL.ClearInfestation} [devotedact/].[bullet/]Making a {GLOBAL.TruceConcept.Hyperlink} +{GLOBAL.MakeTruce} [devotedact/].[bullet/]Forgiving a {GLOBAL.CasusBelliConcept.Hyperlink} +{GLOBAL.ForgiveGrievence} [devotedact/].[/bulletlist][bullet/]Lose {GLOBAL.DevotionConcept.Hyperlink} by:[bulletlist][bullet/]Starting a {GLOBAL.WarConcept.Hyperlink} -{GLOBAL.HarmonyEnterWar} [undevotedact/].[bullet/]{GLOBAL.RazingConcept.Hyperlink} or {GLOBAL.MigratingConcept.Hyperlink} a hostile {GLOBAL.CityConcept.Hyperlink} -{GLOBAL.AbsorbRazeCity} [undevotedact/].[bullet/]Fabricating a {GLOBAL.CasusBelliConcept.Hyperlink} -{GLOBAL.HarmonyFabricateGrievence} [undevotedact/].[/bulletlist][/bulletlist]"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@HARMONY@DEVOTION_TOOLTIP_DESCRIPTION"
msgstr "{LOC.DLC@WAYSOFWAR@DIPLOMACY@CONCEPT_OATH_HARMONY@NAME}{LOC.DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@HARMONY@DEVOTION_DESCRIPTION}"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@HARMONY@NEUTRAL_TOOLTIP_DESCRIPTION"
msgstr "[bullet/]{GLOBAL.PROPERTIES.HARMONIZE.Hyperlink}: Heal {amount} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@HARMONY@OATHBREAKER_TOOLTIP_DESCRIPTION"
msgstr "[bullet/]{GLOBAL.PROPERTIES.HARMONIZE.Hyperlink}: Gain {amount} {GLOBAL.PROPERTIES.WEAKENED.Hyperlink} for {duration} <<m:{GLOBAL.TurnConcept}>>"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@HARMONY@PARAGON_TOOLTIP_DESCRIPTION"
msgstr "[bullet/]{GLOBAL.PROPERTIES.HARMONIZE.Hyperlink}: Heal {amount} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>[bullet/]{GLOBAL.UNITS.PEACEBRINGER.Hyperlink} units have their {GLOBAL.PROPERTIES.SWORN_PARAGON_WISDOM.Hyperlink} activated."

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@RIGHTEOUSNESS@ADHERENT_TOOLTIP_DESCRIPTION"
msgstr "[bullet/]{GLOBAL.PROPERTIES.NOBILITY.Hyperlink}: +{amount} {GLOBAL.SpiritDamageConcept.Hyperlink}"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@RIGHTEOUSNESS@DESCRIPTION"
msgstr "Your people follow a path of Righteousness, working to be a positive force for good upon the world:[bulletlist][bullet/]Negative [reputation2/] alignment gained is doubled.[bullet/]Culture units have {GLOBAL.PROPERTIES.NOBILITY.Hyperlink}.[bullet/]Become stronger as you gain {GLOBAL.DevotionConcept.Hyperlink} to the {GLOBAL.OathOfRighteousness.Hyperlink}.[/bulletlist]"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@RIGHTEOUSNESS@DEVOTEE_TOOLTIP_DESCRIPTION"
msgstr "[bullet/]{GLOBAL.PROPERTIES.NOBILITY.Hyperlink}: +{amount} {GLOBAL.SpiritDamageConcept.Hyperlink}"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@RIGHTEOUSNESS@DEVOTION_DESCRIPTION"
msgstr "[bulletlist][bullet/]Gain {GLOBAL.DevotionConcept.Hyperlink} by:[bulletlist][bullet/]Having good alignment, +{GLOBAL.goodDevotion} [devotedact/] per [reputation6/] point.[/bulletlist][bullet/]Lose {GLOBAL.DevotionConcept.Hyperlink} by:[bulletlist][bullet/]Having evil alignment, -{GLOBAL.devotionevil} [undevotedact/] per [reputation2/] point.[/bulletlist][/bulletlist]"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@RIGHTEOUSNESS@DEVOTION_TOOLTIP_DESCRIPTION"
msgstr "{LOC.DLC@WAYSOFWAR@DIPLOMACY@CONCEPT_OATH_RIGHTEOUESNESS@NAME}{LOC.DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@RIGHTEOUSNESS@DEVOTION_DESCRIPTION}"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@RIGHTEOUSNESS@LORENAME"
msgstr "Sworn^f"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@RIGHTEOUSNESS@NAME"
msgstr "Righteousness"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@RIGHTEOUSNESS@NEUTRAL_TOOLTIP_DESCRIPTION"
msgstr "[bullet/]{GLOBAL.PROPERTIES.NOBILITY.Hyperlink}: +{amount} {GLOBAL.SpiritDamageConcept.Hyperlink}"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@RIGHTEOUSNESS@OATHBREAKER_TOOLTIP_DESCRIPTION"
msgstr "[bullet/]{GLOBAL.PROPERTIES.NOBILITY.Hyperlink}: -{amount}% damage."

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@RIGHTEOUSNESS@PARAGON_TOOLTIP_DESCRIPTION"
msgstr "[bullet/]{GLOBAL.PROPERTIES.NOBILITY.Hyperlink}: +{amount} {GLOBAL.SpiritDamageConcept.Hyperlink}[bullet/]{GLOBAL.UNITS.AVENGER.Hyperlink} units have their {GLOBAL.PROPERTIES.SWORN_PARAGON_RIGHTEOUSNESS.Hyperlink} activated."

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@STRIFE@ADHERENT_TOOLTIP_DESCRIPTION"
msgstr "[bullet/]{GLOBAL.PROPERTIES.WARRIORS_SOUL.Hyperlink}: +{amount} {GLOBAL.FireDamageConcept.Hyperlink}"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@STRIFE@DEVOTEE_TOOLTIP_DESCRIPTION"
msgstr "[bullet/]{GLOBAL.PROPERTIES.WARRIORS_SOUL.Hyperlink}: +{amount} {GLOBAL.FireDamageConcept.Hyperlink}"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@STRIFE@DEVOTION_DESCRIPTION"
msgstr "[bulletlist][bullet/]Gain {GLOBAL.DevotionConcept.Hyperlink} by:[bulletlist][bullet/]Entering <<m:{GLOBAL.WarConcept.Hyperlink}>> +{GLOBAL.StrifeEnterWar} [devotedact/].[bullet/]{GLOBAL.RazingConcept.Hyperlink} a {GLOBAL.CityConcept.Hyperlink} +{GLOBAL.StrifeRazeCity} [devotedact/].[bullet/]Not letting units rout in events +{GLOBAL.StrifeNoRoutEvent} [devotedact/].[bullet/]Winning in combat:[bulletlist][bullet/]With lower army power +{GLOBAL.StrifeBattleWonWeaker} [devotedact/].[bullet/]With higher army power +{GLOBAL.StrifeBattleWonStronger} [devotedact/].[/bulletlist][/bulletlist][bullet/]Lose {GLOBAL.DevotionConcept.Hyperlink} by:[bulletlist][bullet/]Entering a {GLOBAL.TruceConcept.Hyperlink} -{GLOBAL.StrifeMadeTruce} [undevotedact/], {GLOBAL.DefensivePactConcept.Hyperlink} -{GLOBAL.StrifeMadeCoop} [undevotedact/], or {GLOBAL.DSAllianceConcept.Hyperlink} -{GLOBAL.StrifeMadePeace} [undevotedact/].[bullet/]Making a {GLOBAL.PactOfVassalageConcept.Hyperlink} -{GLOBAL.StrifeMadeVassal} [undevotedact/].[bullet/]Losing an owned {GLOBAL.CityConcept.Hyperlink} -{GLOBAL.StrifeOwnCityLost} [undevotedact/].[/bulletlist][/bulletlist]"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@STRIFE@DEVOTION_TOOLTIP_DESCRIPTION"
msgstr "{LOC.DLC@WAYSOFWAR@DIPLOMACY@CONCEPT_OATH_STRIFE@NAME}{LOC.DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@STRIFE@DEVOTION_DESCRIPTION}"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@STRIFE@NEUTRAL_TOOLTIP_DESCRIPTION"
msgstr "[bullet/]{GLOBAL.PROPERTIES.WARRIORS_SOUL.Hyperlink}: +{amount} {GLOBAL.FireDamageConcept.Hyperlink}"

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@STRIFE@OATHBREAKER_TOOLTIP_DESCRIPTION"
msgstr "[bullet/]{GLOBAL.PROPERTIES.WARRIORS_SOUL.Hyperlink}: -{amount}% damage even if not [hyperlink,GLOBAL.OutnumberedConcept]Outnumbered[/hyperlink]."

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@STRIFE@PARAGON_TOOLTIP_DESCRIPTION"
msgstr "[bullet/]{GLOBAL.PROPERTIES.WARRIORS_SOUL.Hyperlink}: +{amount} {GLOBAL.FireDamageConcept.Hyperlink}[bullet/]{GLOBAL.UNITS.WARBOUND.Hyperlink} units have their {GLOBAL.PROPERTIES.SWORN_PARAGON_BRAVERY.Hyperlink} activated."

msgid "DLC@WAYSOFWAR@SUBCULTURE_OATHSWORN@WISDOM@DESCRIPTION"
