msgstr "Call Guard"

msgid "DLC@GIANTKINGS@TROLL_KING_ABILITY02@DESCRIPTION"
msgstr "At the start of combat a random Tier II Ogre unit joins the battle.[br/][br/]Doesn't work in Water Combat."

msgid "DLC@GIANTKINGS@TROLL_KING_ABILITY02@NAME"
msgstr "Personal Guard"

msgid "DLC@GIANTKINGS@TROLL_KING_ABILITY03@DESCRIPTION"
msgstr "The third attack has a base {STUNNED_RESISTANCE>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.STUNNED.Hyperlink} for {STUNNED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "DLC@GIANTKINGS@TROLL_KING_ABILITY03@NAME"
msgstr "Combo"

