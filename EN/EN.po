msgstr "Whenever a friendly spell is cast, gain:[bulletlist][bullet/]+{ARCANE_SURGE_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>[bullet/]{stack1} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}[bullet/]{stack2} {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink}[bullet/]{stack3} {GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink}[/bulletlist]"

msgid "TOME_ASTRAL_CONVERGENCE@HERO_SKILL@NAME"
msgstr "Arcane Surge"

