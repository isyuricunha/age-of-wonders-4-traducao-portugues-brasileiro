msgstr "Limited Seal"

msgid "DLC@EMPIRESANDASHES@WILDLIFE_PROPERTIES@PROGENITOR_GOLEM@ABILITY03@PROP_DESCRIPTION"
msgstr "This unit:[bulletlist][bullet/]Cannot move or act.[bullet/]Is immune to all damage and status effects.[bullet/]Doesn't count as being in battle.[/bulletlist][br/]Effect ends if the other linked unit dies."

