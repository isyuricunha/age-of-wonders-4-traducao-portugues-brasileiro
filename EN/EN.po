msgstr "Gain {GLOBAL.PROPERTIES.AMMUNITION_SUNDERING_SHOT_PROPERTY.Hyperlink}"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@ABILITY_AMMO_1@NAME"
msgstr "Load Sundering Shot"

