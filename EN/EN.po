msgid "DIPLOMACY@SECTORCLAIMIGNORED@DESCRIPTION"
msgstr "{HouseBLord.Name} has captured one of your [hyperlink,GLOBAL.ClaimConcept]claimed[/hyperlink] <<m:{GLOBAL.ProvinceConcept.Hyperlink}>>. Because of your claims, you now have a {GLOBAL.CasusBelliConcept.Hyperlink} ({CasusBelliPoints}[casusBelli/] points) against {HouseBLord.Name}."

msgid "DIPLOMACY@SECTORCLAIMIGNORED@TITLE"
msgstr "Your claimed province has been captured"

msgid "DIPLOMACY@TRADE@BREAK_DIPLOMATIC_TREATY_DESCRIPTION"
msgstr "The following treaties will be broken:"

msgid "DIPLOMACY@TRADE@BREAK_TREATY"
msgstr "Break Treaty"

msgid "DIPLOMACY@TRADE@BREAK_TREATY_DESCRIPTION"
msgstr "Break the treaty and any other treaties made in the same deal:"

msgid "DIPLOMACY@TRADE@BREAK_TREATY_WARNING"
msgstr "[fireCol]Breaking treaties will give the opposing Ruler a {CasusBelliValue}{GLOBAL.CasusBelliConcept.Hyperlink} against you and is considered an [evilact/] [hyperlink,GLOBAL.AlignmentConcept]evil[/hyperlink] act ({AlignmentValue}).[/fireCol]"

msgid "DIPLOMACY@TRADE@CANCEL_TREATY"
msgstr "Cancel Treaty"

msgid "DIPLOMACY@TRADE@CANCEL_TREATY_DESCRIPTION"
msgstr "Both rulers agree to cancel the treaty without any penalties or breaking potentially related treaties made in the same deal."

msgid "DIPLOMACY@TRADE@END_TREATY"
msgstr "End Treaty"

msgid "DIPLOMACY@TRADE@END_TREATY_DESCRIPTION"
msgstr "End this treaty, choose to either break the treaty (and any other treaties made in the same deal) [evilact/] or propose to reach a mutual agreement for ending the treaty peacefully."

msgid "DIPLOMACY@TRADE@EQUIPMENT_DESCRIPTION"
msgstr "The equipment will be transferred to the arsenal of the other {GLOBAL.LeaderConcept.Hyperlink}."

msgid "DIPLOMACY@TRADE@GIFT_OPTION_TOOLTIP"
msgstr "Send a gift to the opposing Ruler to improve your relations with them."

msgid "DIPLOMACY@TRADE@HISTORY_UNAVAILABLE"
msgstr "Trade details unavailable. This trade happened too long ago and its records have been lost."

msgid "DIPLOMACY@TRADE@INTERESTEDIN"
msgstr "Interested in"

msgid "DIPLOMACY@TRADE@RELEASE_HERO_CRYPT_DESCRIPTION"
msgstr "Transfer the remains of {HeroData.Name} from the Crypt of {Captor.Name} to the Crypt of {Owner.Name}. {HeroData.FirstName} can then be resurrected by {Owner.Lord.FirstName}.[br/][br/]Returning the remains as a gift will yield a {Relation}[goodRelation/] Relations Bonus.[br/]{Captor.Lord.FirstName} will keep all of {HeroData.FirstName}'s equipment."

msgid "DIPLOMACY@TRADE@RELEASE_HERO_DESCRIPTION"
msgstr "Return {HeroData.Name} from the Prison of {Captor.Name} back to {Owner.Name}. {HeroData.FirstName} will return to {Owner.Lord.FirstName}.[br/][br/]Returning {HeroData.Name} as a gift will yield a {Relation}[goodRelation/] Relations Bonus and counts as an act of good, {Alignment}[goodact/].[br/]{Captor.Lord.FirstName} will keep all of {HeroData.FirstName}'s equipment."

msgid "DIPLOMACY@TRADE@TRUCE_WARNING"
msgstr "All occupied <<m:{GLOBAL.CityConcept.Hyperlink}>> that are in the process of being absorbed, razed, or migrated will instantly complete that operation."

msgid "DIPLOMACY@TRADE@VALUE"
msgstr "Trade Value"

msgid "DIPLOMACY@TREATY@ALLOWCLAIMEDSECTORS"
msgstr "Good Neighbors Pact"

msgid "DIPLOMACY@TREATY@DESCRIPTION"
msgstr "An agreement between two <<m:{GLOBAL.EmpireConcept.Hyperlink}>> where resources may be exchanged or diplomatic permissions are granted.[br/][br/]A {GLOBAL.MutualConsulateConcept.Hyperlink} needs to be established for more advanced Treaties and to achieve an {GLOBAL.DSAllianceConcept.Hyperlink}.[br/][br/]Treaties last indefinitely but may be broken manually or through declaring {GLOBAL.WarConcept.Hyperlink}. Breaking treaties is considered an [evilact/] [hyperlink,GLOBAL.AlignmentConcept]evil[/hyperlink] act and will give the opposing {GLOBAL.LeaderConcept.Hyperlink} a {GLOBAL.CasusBelliConcept.Hyperlink}."

msgid "DIPLOMACY@TREATY@NAME"
msgstr "Treaty"

msgid "DIPLOMACY@TREATY@OPENBORDERS"
msgstr "Opened Borders"

msgid "DIPLOMACY@TREATY@SHAREVISION"
msgstr "Shares Vision"

msgid "DIPLOMACY@TREATY@TREATIES_HYPERLINK"
msgstr "[hyperlink,GLOBAL.TreatyConcept]Treaties[/hyperlink]"

msgid "DIPLOMACY@TREATY@TREATY_HYPERLINK"
msgstr "[hyperlink,GLOBAL.TreatyConcept]Treaty[/hyperlink]"

msgid "DIPLOMACY@TREATY@TRUCE"
msgstr "Truce"

msgid "DIPLOMACY@TREATY@TRUCE_DESCRIPTION"
msgstr "Both <<m:{GLOBAL.LeaderConcept.Hyperlink}>> vow not to attack each other while the truce lasts. {GLOBAL.WarConcept.Hyperlink} may still be declared, but counts as an [evilact/] [hyperlink,GLOBAL.AlignmentConcept]evil[/hyperlink] act."

msgid "DIPLOMACY@TREATY@TRUCE_HYPERLINK"
msgstr "[hyperlink,GLOBAL.TruceConcept]Truce[/hyperlink]"

msgid "DIPLOMACY@TRESPASSING@DESCRIPTION"
msgstr "Armies are considered to be trespassing when they are seen moving through the <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> of another {GLOBAL.LeaderConcept.Hyperlink} or {GLOBAL.IndependentCityConcept.Hyperlink} without having an [hyperlink,GLOBAL.OpenBordersConcept]open borders agreement[/hyperlink].[br/][br/]Trespassing will give other Rulers a {GLOBAL.CasusBelliConcept.Hyperlink} and damages the relation with free cities."

msgid "DIPLOMACY@TRESPASSING@HYPERLINK"
msgstr "[hyperlink,GLOBAL.TrespassingConcept]Trespassing[/hyperlink]"

msgid "DIPLOMACY@TRESPASSING@TITLE"
msgstr "Trespassing"

msgid "DIPLOMACY@WAREFFECT@TITLE"
msgstr "Declaring war now means"

