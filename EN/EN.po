msgid "DLC@GIANTKINGS@DIPLOMACY@CRYSTAL_DWELLING@CRYSTAL_PACT@DESCRIPTION"
msgstr "[bulletlist][bullet/]Will [hyperlink,GLOBAL.ReinforcementRuleConcept]reinforce[/hyperlink] in {GLOBAL.CombatConcept.Hyperlink} against <<m:{GLOBAL.MarauderConcept.Hyperlink}>> and <<m:{GLOBAL.LeaderConcept.Hyperlink}>> the {GLOBAL.DwellingConcept.Hyperlink} is at {GLOBAL.IndependentCityWarConcept.Hyperlink} with.[bullet/]Unlocks purchase of the following trade items via Cooperation:[bulletlist][bullet/]{GLOBAL.TOKENDEFINITION.LITHORITE_PRISM_ARTIFACT.Hyperlink}[bullet/]{GLOBAL.SPECIAL_OPERATIONS.CRYSTAL_FOCUS.Hyperlink}[bullet/]{GLOBAL.SPECIAL_OPERATIONS.CRYSTALLIZE_ESSENCE.Hyperlink}[bullet/]{GLOBAL.SPECIAL_OPERATIONS.CRYSTAL_CRASH.Hyperlink}[bullet/]{GLOBAL.UNITS.LITHORINE_SHARDLANCER.Hyperlink}[bullet/]{GLOBAL.UNITS.LITHORINE_GEMCASTER.Hyperlink}[/bulletlist][bullet/]Completing Dwelling quests rewards guaranteed {GLOBAL.ManaConcept.Hyperlink} in addition to their other rewards.[/bulletlist]"

msgid "DLC@GIANTKINGS@DIPLOMACY@CRYSTAL_DWELLING@CRYSTAL_PACT@HYPERLINK"
msgstr "[rs_crystal/] [hyperlink,GLOBAL.CrystalDwellingCrystalPactConcept]Crystal Pact[/hyperlink]"

msgid "DLC@GIANTKINGS@DIPLOMACY@CRYSTAL_DWELLING@CRYSTAL_PACT@NAME"
msgstr "Crystal Pact"

msgid "DLC@GIANTKINGS@DIPLOMACY@CRYSTAL_DWELLING@ETERNAL_PACT@DESCRIPTION"
msgstr "[bulletlist][bullet/]The {GLOBAL.DwellingConcept.Hyperlink} shares its vision.[bullet/]Unlocks purchase of the following trade items via Cooperation:[bulletlist][bullet/]{GLOBAL.TOKENDEFINITION.LITHORITE_ASTROLABE_ARTIFACT.Hyperlink}[bullet/]{GLOBAL.STRUCTURE_UPGRADES.ETERNAL_EMBASSY.Hyperlink}[bullet/]{GLOBAL.UNITS.LITHORINE_SIMULACRUM.Hyperlink}[bullet/]{GLOBAL.EQUIPMENT.ETERNAL_GOLDSEEKERS_PICKAXE.Hyperlink}[bullet/]{GLOBAL.EQUIPMENT.ETERNAL_LITHORINE_ORB.Hyperlink}[bullet/]{GLOBAL.EQUIPMENT.ETERNAL_SHATTERBLADES.Hyperlink}[bullet/]{GLOBAL.EQUIPMENT.ETERNAL_TITANS_GREATBOW.Hyperlink}[/bulletlist][bullet/]Completing Dwelling quests rewards guaranteed {GLOBAL.ImperiumConcept.Hyperlink} in addition to their other rewards.[bullet/]The {GLOBAL.DwellingConcept.Hyperlink} grants a substantial {GLOBAL.KnowledgeConcept.Hyperlink} income boon.[/bulletlist]"

