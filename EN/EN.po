msgstr "Unit's attacks have:[bulletlist][bullet/]+{OBSIDIAN_BLADES_DAMAGE_REPEATING>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Have a base {BLEEDING_RESISTANCE>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.BLEEDING.Hyperlink} for {BLEEDING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_ROCK@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Smash your enemies with the force of stone. Specialize in increasing your defenses and dealing {GLOBAL.PhysicalDamageConcept.Hyperlink}."

msgid "TOME_ROCK@TOME@LORE_AUTHOR"
msgstr "Blint the Underdelver, First Protector of the Molemen"

msgid "TOME_ROCK@TOME@LORE_DESCRIPTION"
msgstr "\"Earth! Rock! The very foundation of the world beneath our feet. Embrace it. Harness it. Use its solidity for both protection and pain. Call forth minions of stone, and turn your own skin into the hardest rock!\""

msgid "TOME_ROCK@TOME@NAME"
msgstr "Tome of Rock"

msgid "TOME_ROCK@UNIT@NAME"
msgstr "Gargoyle"

