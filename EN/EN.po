msgid "CONCEPT@UNIT_MORALE@NAME"
msgstr "Morale"

msgid "CONCEPT@UNIT_TIER@DESCRIPTION"
msgstr "{GLOBAL.UnitConcept.Hyperlink} Tier represents its relative strength in {GLOBAL.CombatConcept.Hyperlink}.[bulletlist][bullet/]Higher tier <<m:{GLOBAL.UnitConcept.Hyperlink}>> have a higher per turn {GLOBAL.UnitUpkeepConcept.Hyperlink}.[bullet/]Tier 3+ Units gain {GLOBAL.StatusResistanceConcept.Hyperlink} which increases for higher Tiers.[bullet/]Unit Tiers range from 1 to 5.[bullet/]<<m:{GLOBAL.HeroConcept.Hyperlink}>> are treated as Tier 5 for relevant skills and abilities.[/bulletlist]"

msgid "CONCEPT@UNIT_TIER@HYPERLINK"
msgstr "[hyperlink,GLOBAL.UnitTierConcept]Unit tier[/hyperlink]"

msgid "CONCEPT@UNIT_TIER@NAME"
msgstr "Unit Tier"

msgid "CONCEPT@VERYLOWMORALE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.VeryLowMoraleConcept]Very Low Morale[/hyperlink]"

msgid "CONCEPT@WORLD_MAP_REGENERATION@DESCRIPTION"
msgstr "Units recover a certain number of <<m:{GLOBAL.HitPointConcept.Hyperlink}>> each {GLOBAL.TurnConcept.Hyperlink} when not in combat.[br/][br/]The amount of hit points regained is higher when the unit is in your {GLOBAL.DomainConcept.Hyperlink} near one of your <<m:{GLOBAL.CityConcept.Hyperlink}>> or <<m:{GLOBAL.OutpostConcept.Hyperlink}>>. Being in enemy domain or in the territory of a {GLOBAL.InfestationConcept.Hyperlink} reduces regeneration.[br/][br/]World Map Regeneration can also be increased by certain Hero Skills and <<m:{GLOBAL.EmpireSkillConcept.Hyperlink}>>."

msgid "CONCEPT@WORLD_MAP_REGENERATION@HYPERLINK"
