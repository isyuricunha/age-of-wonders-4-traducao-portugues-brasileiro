msgstr "Provinces with forests are affected by {GLOBAL.PROPERTIES.STARSEEDS_DISPLAY.Hyperlink}."

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@TRAIT_WARPED_SEASONS@OBJECTIVE@SUMMER_TERRAFORMING_INFO"
msgstr "Provinces change to hot and desolate climes."

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@TRAIT_WARPED_SEASONS@OBJECTIVE@SUMMER_UNIT_INFO"
msgstr "Units have {WS_DAMAGE_WEAKNESS} {GLOBAL.FireResistanceConcept.Hyperlink}."

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@TRAIT_WARPED_SEASONS@OBJECTIVE@SUMMER_WEATHER_EFFECT_INFO_01"
msgstr "Desert provinces are affected by {GLOBAL.PROPERTIES.REALMTRAIT__SANDSTORM_DISPLAY.Hyperlink}."

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@TRAIT_WARPED_SEASONS@OBJECTIVE@SUMMER_WEATHER_EFFECT_INFO_02"
msgstr "Desolate provinces are affected by {GLOBAL.PROPERTIES.VOLCANIC_ERUPTION_DISPLAY.Hyperlink}."

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@TRAIT_WARPED_SEASONS@OBJECTIVE@TERRAFORMING_INFO"
