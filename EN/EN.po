msgid "TOME_GOD_EMPEROR@SKILL5@NAME"
msgstr "Mass Revive"

msgid "TOME_GOD_EMPEROR@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Become a god to be worshiped. Your mere presence inspires your troops and your cities. Specialize in buffing your units."

msgid "TOME_GOD_EMPEROR@TOME@LORE_AUTHOR"
msgstr "Turiel, Exalted Warden of Grexolis"

msgid "TOME_GOD_EMPEROR@TOME@LORE_DESCRIPTION"
msgstr "\"Godhood is known. It is felt. One need not convince others of one's divinity, for one's very essence shall shine through. Embrace divinity. Inspire all with your presence and grant holy might to all who follow you on your righteous path. Blessed be you, shepherd, and blessed be your flock.\""

msgid "TOME_GOD_EMPEROR@TOME@NAME"
msgstr "Tome of the God Emperor"

msgid "TOME_GOLDEN@ABILITY0@DESCRIPTION"
msgstr "[bulletlist][bullet/]Deal damage to enemy units in a {unitsAmount}-hex cone.[bullet/]When hitting a {GLOBAL.PROPERTIES.GILDED.Hyperlink} target:[bulletlist][bullet/]Heal {GILDED_CLEAVE_HEAL>MinHeal} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Deal +{GILDED_CLEAVE_DAMAGE>ResolvedMultiplier}% damage.[/bulletlist][/bulletlist]"

msgid "TOME_GOLDEN@ABILITY0@NAME"
msgstr "Golden Cleave"

msgid "TOME_GOLDEN@ABILITY2@DESCRIPTION"
msgstr "Enemy melee attackers have a base {GILDED_RESISTANCE>ResolvedStrength}% chance of becoming {GLOBAL.PROPERTIES.GILDED.Hyperlink}."

msgid "TOME_GOLDEN@ABILITY2@NAME"
msgstr "Golden Curse"

msgid "TOME_GOLDEN@ABILITY3@DESCRIPTION"
msgstr "Enemy units in a {STRIKE_GOLD_UNIT_TARGETER_CIRCLE>AREA>Radius}-hex radius have a {GILDED_RESISTANCE>ResolvedStrength}% chance of becoming {GLOBAL.PROPERTIES.GILDED.Hyperlink} for {GILDED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[br/][br/]Enter {GLOBAL.DefenseModeConcept.Hyperlink}."

msgid "TOME_GOLDEN@ABILITY3@NAME"
msgstr "Gilded Emanation"

msgid "TOME_GOLDEN@ABILITY4@DESCRIPTION"
msgstr "When in {GLOBAL.DefenseModeConcept.Hyperlink}, this unit has unlimited <<m:{GLOBAL.RetaliationConcept.Hyperlink}>>."

msgid "TOME_GOLDEN@ABILITY4@NAME"
msgstr "Golden Retaliation"

msgid "TOME_GOLDEN@ABILITY5@DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]{GLOBAL.FirstStrikeConcept.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.CHARGE_RESISTANCE.Hyperlink}[bullet/]+{CAVALRY_SLAYER_DAMAGE_UP>ResolvedMultiplier}% damage against {GLOBAL.PROPERTIES.CAVALRY_GROUP.Hyperlink} and {GLOBAL.PROPERTIES.LARGE_TARGET.Hyperlink} units.[/bulletlist]"

msgid "TOME_GOLDEN@ABILITY5@NAME"
msgstr "Polearm Weapon"

msgid "TOME_GOLDEN@HERO_SKILL@DESCRIPTION"
msgstr "Makes <<m:{GLOBAL.CriticalHitConcept.Hyperlink}>> with {GLOBAL.MagicConcept.Hyperlink} attacks inflict {GLOBAL.PROPERTIES.GILDED.Hyperlink} for {GILDED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "TOME_GOLDEN@HERO_SKILL@NAME"
msgstr "Gilded Magic"

msgid "TOME_GOLDEN@PASSIVE@DESCRIPTION"
msgstr "<<m:{GLOBAL.ProvinceImprovementConcept.Hyperlink}>> grant +{Stabilitybonus} {GLOBAL.CityStabilityConcept.Hyperlink} for each adjacent {GLOBAL.ProvinceImprovementConcept.Hyperlink}."

msgid "TOME_GOLDEN@PASSIVE@NAME"
msgstr "Prosperous Provinces"

msgid "TOME_GOLDEN@SKILL1@DESCRIPTION"
msgstr "Makes the target race gain an affinity for gold, granting them:[bulletlist][bullet/]+{GOLDEN_TOUCHED_STAT_BONUS>BONUS>DEFENSE>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}.[bullet/]+{amount2} {GLOBAL.GoldConcept.Hyperlink} per {GLOBAL.PopulationConcept.Hyperlink} in their <<m:{GLOBAL.CityConcept.Hyperlink}>>.[/bulletlist]"

msgid "TOME_GOLDEN@SKILL1@NAME"
msgstr "Goldtouched"

msgid "TOME_GOLDEN@SKILL1@PROP_DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]+{GOLDEN_TOUCHED_STAT_BONUS>BONUS>DEFENSE>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_GOLDEN@SKILL2@DESCRIPTION"
msgstr "A {GLOBAL.PROPERTIES.POLEARM_UNIT.Hyperlink} that turns enemies into gold... and brings home the spoils."

msgid "TOME_GOLDEN@SKILL2@NAME"
msgstr "Gold Golem"

msgid "TOME_GOLDEN@SKILL3@DESCRIPTION"
msgstr "Buy Now is {amount}% cheaper and can be used {amount2} times per {GLOBAL.WorldMapConcept} {GLOBAL.TurnConcept}."

msgid "TOME_GOLDEN@SKILL3@NAME"
msgstr "Luxury Markets"

msgid "TOME_GOLDEN@SKILL4@DESCRIPTION"
msgstr "Grants units in a {GOLDED_BLAST_UNIT_TARGETER_CIRCLE>AREA>Radius}-hex radius a {GILDED_RESISTANCE>ResolvedStrength}% chance of becoming {GLOBAL.PROPERTIES.GILDED.Hyperlink} for {GILDED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "TOME_GOLDEN@SKILL4@NAME"
msgstr "Gilding Blast"

msgid "TOME_GOLDEN@SKILL5@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{amount3} {GLOBAL.GoldConcept.Hyperlink}[bullet/]+{amount1} {GLOBAL.FoodConcept.Hyperlink} per {GLOBAL.MagicMaterialConcept.Hyperlink} in the {GLOBAL.DomainConcept.Hyperlink}.[bullet/]+{amount2} {GLOBAL.UnitProductionConcept.Hyperlink} per {GLOBAL.MagicMaterialConcept.Hyperlink} in the {GLOBAL.DomainConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_GOLDEN@SKILL5@NAME"
msgstr "Reagent Refinery"

msgid "TOME_GOLDEN@STATUS@DESCRIPTION"
msgstr "This unit has the following effects:[bulletlist][bullet/]{GLOBAL.PROPERTIES.STUNNED.Hyperlink}.[bullet/]When this unit dies, the winner of the battle gains {amount2} {GLOBAL.GoldConcept.Hyperlink} per unit Tier.[/bulletlist]"

msgid "TOME_GOLDEN@STATUS@GOLDSEEKER_INFUSION"
msgstr "The third strike in a turn has a base {Chance}% chance of inflicting {GLOBAL.PROPERTIES.GILDED.Hyperlink} for {turn}."

msgid "TOME_GOLDEN@STATUS@GOLDSEEKER_MOD"
msgstr "The third strike in a turn has a base {GILDED_RESISTANCE>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.GILDED.Hyperlink} for {GILDED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "TOME_GOLDEN@STATUS@MODIFIER"
msgstr "Base {GILDED_RESISTANCE>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.GILDED.Hyperlink} for {GILDED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "TOME_GOLDEN@STATUS@NAME"
msgstr "Gilded"

msgid "TOME_GOLDEN@TOME@GAMEPLAY"
msgstr "Become a prosperous empire and gain large amounts of gold with new infrastructure and by turning your very enemies into gold."

msgid "TOME_GOLDEN@TOME@LORE"
msgstr "\"Gold! The king and queen of minerals, coveted by all mortals who greedily and deeply delve into the ground. Truly gain mastery over this most gilded aspect of earth and you will find that all that glitters actually IS gold! Thus you shall become one with the riches of the earth!\""

msgid "TOME_GOLDEN@TOME@LORE@AUTHOR"
msgstr "Fangir Rockborne, Master of Earth"

msgid "TOME_GOLDEN@TOME@NAME"
msgstr "Tome of the Golden Realm"

msgid "TOME_GOLDEN@UNIT1@NAME"
msgstr "Golden Golem^n"

msgid "TOME_GREAT_TRANSFORMATION@PASSIVE@DESCRIPTION"
msgstr "Reanimate a {GLOBAL.HeroConcept} in your crypt as an {GLOBAL.PROPERTIES.UNDEAD.Hyperlink} servant under your control."

msgid "TOME_GREAT_TRANSFORMATION@PASSIVE@NAME"
msgstr "Animate Hero"

msgid "TOME_GREAT_TRANSFORMATION@SKILL1@DESCRIPTION"
msgstr "Gives the target race immortality beyond life, granting them:[bulletlist][bullet/]The {GLOBAL.PROPERTIES.UNDEAD.Hyperlink} unit type.[bullet/]{GLOBAL.PROPERTIES.NEW_LIFE_STEAL.Hyperlink}, which restores <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> upon each attack.[/bulletlist]"

msgid "TOME_GREAT_TRANSFORMATION@SKILL1@NAME"
msgstr "Wightborn"

msgid "TOME_GREAT_TRANSFORMATION@SKILL1@PROPERTY@DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]The {GLOBAL.PROPERTIES.UNDEAD.Hyperlink} unit type.[bullet/]{GLOBAL.PROPERTIES.NEW_LIFE_STEAL.Hyperlink}.[/bulletlist]"

msgid "TOME_GREAT_TRANSFORMATION@SKILL2@DESCRIPTION"
msgstr "Grants enchanted units:[bulletlist][bullet/]+{FETID_LEGION_STAT_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[bullet/]{GLOBAL.PROPERTIES.WEAKENING.Hyperlink}, which inflicts  {GLOBAL.PROPERTIES.WEAKENED.Hyperlink} to adjacent enemies at the end of the turn.[/bulletlist]"

msgid "TOME_GREAT_TRANSFORMATION@SKILL2@NAME"
msgstr "Fetid Legion"

msgid "TOME_GREAT_TRANSFORMATION@SKILL2@PROP_DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]+{FETID_LEGION_STAT_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[bullet/]{GLOBAL.PROPERTIES.WEAKENING.Hyperlink}.[/bulletlist]"

msgid "TOME_GREAT_TRANSFORMATION@SKILL3@DESCRIPTION"
msgstr "{GLOBAL.CityTowerStructureConcept.Hyperlink}[br/][bulletlist][bullet/]Adds {amount} <<m:{GLOBAL.UNITS.NECROTIC_SPIRE_UNIT.Hyperlink}>> in {GLOBAL.CombatConcept.Hyperlink} during a {GLOBAL.SiegeConcept.Hyperlink}.[bullet/]Friendly {GLOBAL.PROPERTIES.UNDEAD.Hyperlink} units in the domain heal {hp} per turn.[/bulletlist]"

msgid "TOME_GREAT_TRANSFORMATION@SKILL3@MARKER_UNLOCK"
msgstr "Necrotic Spires in Combat"

msgid "TOME_GREAT_TRANSFORMATION@SKILL3@NAME"
msgstr "Necrotic Spires"

msgid "TOME_GREAT_TRANSFORMATION@SKILL4@DESCRIPTION"
msgstr "Target friendly city:[bulletlist][bullet/]Has {stability} {GLOBAL.CityStabilityConcept.Hyperlink}.[bullet/]Friendly {GLOBAL.PROPERTIES.UNDEAD.Hyperlink} units in the domain deal +{damage}% damage.[bullet/]Enemy units in the domain become {GLOBAL.PROPERTIES.SOULBOUND.Hyperlink}.[/bulletlist]"

msgid "TOME_GREAT_TRANSFORMATION@SKILL4@DISPLAY_DESCRIPTION"
msgstr "[bulletlist][bullet/]Friendly {GLOBAL.PROPERTIES.UNDEAD.Hyperlink} units in the domain deal +{damage}% damage.[bullet/]Enemy units in the domain become {GLOBAL.PROPERTIES.SOULBOUND.Hyperlink}.[/bulletlist]"

msgid "TOME_GREAT_TRANSFORMATION@SKILL4@NAME"
msgstr "Domain of Death"

msgid "TOME_GREAT_TRANSFORMATION@SKILL4@PROPERTY@DESCRIPTION"
msgstr "This unit deals +{amount}% damage."

msgid "TOME_GREAT_TRANSFORMATION@SKILL5@DESCRIPTION"
msgstr "Targets a resource node in your domain:[bulletlist][bullet/]Node provides {mana} {GLOBAL.SoulConcept.Hyperlink} income.[bullet/]If you lose the province, the effect stops.[/bulletlist]"

msgid "TOME_GREAT_TRANSFORMATION@SKILL5@NAME"
msgstr "Desecrate Structure"

msgid "TOME_GREAT_TRANSFORMATION@SKILL6@DESCRIPTION"
msgstr "When killing non-racial Tier {amount} or Tier {amount1} units, gain the option to spend <<m:{GLOBAL.SoulConcept.Hyperlink}>> to create a {GLOBAL.UNITS.BONE_DRAGON.Hyperlink} after combat."

msgid "TOME_GREAT_TRANSFORMATION@SKILL6@NAME"
msgstr "Bone Dragon Reanimation"

msgid "TOME_GREAT_TRANSFORMATION@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Turn your people into the {GLOBAL.PROPERTIES.UNDEAD.Hyperlink} and transform your empire into a paradise for them to thrive in."

msgid "TOME_GREAT_TRANSFORMATION@TOME@LORE_AUTHOR"
msgstr "Nekron, Master of Death"

msgid "TOME_GREAT_TRANSFORMATION@TOME@LORE_DESCRIPTION"
msgstr "\"Once you have felt the power of necromancy, you begin to grasp a greater truth. An empire does not really require life to truly live. Life is untidy. It is unpredictable and inefficient. Grant your people the gift of everlasting undeath and they shall repay you with eternal, ordered obedience.\""

msgid "TOME_GREAT_TRANSFORMATION@TOME@NAME"
msgstr "Tome of the Great Transformation"

msgid "TOME_GREAT_TRANSFORMATION@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Target non-Zombie corpse is resurrected as a {GLOBAL.UNITS.DECAYING_ZOMBIE.Hyperlink} on your side."

msgid "TOME_GREAT_TRANSFORMATION@UNIT1@ABILITY1@NAME"
msgstr "Summon Decaying Zombie"

msgid "TOME_GREAT_TRANSFORMATION@UNIT1@DESCRIPTION"
msgstr "A defensive structure that heals and buffs nearby friendly Undead units."

msgid "TOME_GREAT_TRANSFORMATION@UNIT1@NAME"
msgstr "Necrotic Spire^n"

msgid "TOME_HELL_GATE@UNIT_ABILITY_2@NAME"
msgstr "Chaos Brand"

msgid "TOME_HELL_GATE@UNIT_ABILITY_2@PROP_DESCRIPTION"
msgstr "When this unit dies, it turns into an {GLOBAL.UNITS.INFERNO_PUPPY.Hyperlink} under enemy control.[br/][br/]If the Puppy survives combat, it then Evolves and the enemy can pay {GLOBAL.ManaConcept.Hyperlink} to keep it."

msgid "TOME_HELL_GATE@UNIT_ABILITY_2@PROP_NAME"
msgstr "Inferno Brand"

msgid "TOME_HERALDS_DOOM@SKILL1@DESCRIPTION"
msgstr "Enemies in a {INSTILL_DESPAIR_UNIT_TARGETER_CIRCLE>AREA>Radius}-hex radius have a base {INSTILL_DESPAIR_RESISTANCE>ResolvedStrength}% chance of losing {INSTILL_DESPAIR_MORALE_EFFECT>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}."

msgid "TOME_HERALDS_DOOM@SKILL1@NAME"
msgstr "Cause Despair"

msgid "TOME_HERALDS_DOOM@SKILL2@DESCRIPTION"
msgstr "Summons a {GLOBAL.UNITS.BANSHEE_UNIT.Hyperlink}, a vengeful spirit that lowers morale and weakens enemies with its piercing wails."

msgid "TOME_HERALDS_DOOM@SKILL2@NAME"
msgstr "Summon Banshee"

msgid "TOME_HERALDS_DOOM@SKILL3@DESCRIPTION"
msgstr "Grants enchanted units:[bulletlist][bullet/]+{CRUEL_DAMAGE_MULTIPLIER>ResolvedMultiplier}% damage against units with {GLOBAL.UnitMoraleConcept.Hyperlink} of \"Low\" or worse.[/bulletlist]"

msgid "TOME_HERALDS_DOOM@SKILL3@HERO_DESCRIPTION"
msgstr "Hero gains +{CRUEL_DAMAGE_MULTIPLIER>ResolvedMultiplier}% damage against units with {GLOBAL.UnitMoraleConcept.Hyperlink} of \"Low\" or worse."

msgid "TOME_HERALDS_DOOM@SKILL3@MOD_DESCRIPTION"
msgstr "+{CRUEL_DAMAGE_MULTIPLIER>ResolvedMultiplier}% damage against units with {GLOBAL.UnitMoraleConcept.Hyperlink} of \"Low\" or worse."

msgid "TOME_HERALDS_DOOM@SKILL3@NAME"
msgstr "Cruel Weaponry"

msgid "TOME_HERALDS_DOOM@SKILL3@PROP_DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]+{CRUEL_DAMAGE_MULTIPLIER>ResolvedMultiplier}% damage against units with {GLOBAL.UnitMoraleConcept.Hyperlink} of \"Low\" or worse.[/bulletlist]"

msgid "TOME_HERALDS_DOOM@SKILL3@PROP_NAME"
msgstr "Cruel"

msgid "TOME_HERALDS_DOOM@SKILL4@DESCRIPTION"
msgstr "Target enemy army gains {amount} {GLOBAL.PROPERTIES.DEMORALIZED} for {turn} <<m:{GLOBAL.TurnConcept}>>."

msgid "TOME_HERALDS_DOOM@SKILL4@NAME"
msgstr "Prelude of Doom"

msgid "TOME_HERALDS_DOOM@SKILL5@DESCRIPTION"
msgstr "Target race becomes a living morale siphon, gaining:[bulletlist][bullet/]+{JOY_SIPHONERS_CHANGE_MORALE>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink} when attacking an enemy.[bullet/]{GLOBAL.PROPERTIES.DEMORALIZER.Hyperlink}[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_HERALDS_DOOM@SKILL5@NAME"
msgstr "Joy Siphoners"

msgid "TOME_HERALDS_DOOM@SKILL5@PROP_DESCRIPTION"
msgstr "This unit:[bulletlist][bullet/]Has {GLOBAL.PROPERTIES.DEMORALIZER.Hyperlink}[bullet/]Gains {JOY_SIPHONERS_CHANGE_MORALE>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink} when striking an enemy.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_HERALDS_DOOM@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Torment your enemies with a {GLOBAL.UnitMoraleConcept}-reducing effect and by exploiting enemies with Low {GLOBAL.UnitMoraleConcept}."

msgid "TOME_HERALDS_DOOM@TOME@LORE_AUTHOR"
msgstr "Arachna Aranea, Spider Queen"

msgid "TOME_HERALDS_DOOM@TOME@LORE_DESCRIPTION"
msgstr "\"The darkness that creeps from shadow to shadow not only brings disquiet, but also carries the promise of your arrival. Dim the light of your enemies' spirits. Shroud them in despair, so that their weapons clatter onto the ground and spells do not issue from their lips.\""

msgid "TOME_HERALDS_DOOM@TOME@NAME"
msgstr "Tome of the Doomherald"

msgid "TOME_HERALD_DOOM@ABILITY_1@DESCRIPTION"
msgstr "Enemy units within a {WAIL_OF_THE_BANSHEE_UNIT_CIRCLE_TARGETER>AREA>Radius}-hex radius sustain damage and have a base {chance}% chance of:[bulletlist][bullet/]Having their {GLOBAL.UnitMoraleConcept.Hyperlink} reduced by {morale}.[bullet/]Becoming {weakness} {GLOBAL.PROPERTIES.WEAKENED.Hyperlink}.[/bulletlist]"

msgid "TOME_HERALD_DOOM@ABILITY_1@ENHANCED_DESCRIPTION"
msgstr "Wail of the Banshee:[bulletlist][bullet/]Does an additional {WAIL_OF_THE_BANSHEE_ENHANCE_DAMAGE>DAMAGE>Frost} damage.[bullet/]Has a base {WAIL_OF_THE_BANSHEE_RESISTANCE_CHECK_ENHANCED>ResolvedStrength}% chance of inflicting its effects.[/bulletlist]"

msgid "TOME_HERALD_DOOM@ABILITY_1@ENHANCED_NAME"
msgstr "Enhanced Wail of the Banshee"

msgid "TOME_HERALD_DOOM@ABILITY_1@MASTER_DESCRIPTION"
msgstr "Wail of the Banshee:[bulletlist][bullet/]Has a base {WAIL_OF_THE_BANSHEE_RESISTANCE_CHECK_MASTER>ResolvedStrength}% chance of inflicting its effects.[bullet/]Does an additional {WAIL_OF_THE_BANSHEE_MASTER_DAMAGE>DAMAGE>Frost}{GLOBAL.FrostDamageConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_HERALD_DOOM@ABILITY_1@MASTER_NAME"
msgstr "Champion Wail of the Banshee"

msgid "TOME_HERALD_DOOM@ABILITY_1@NAME"
msgstr "Wail of the Banshee"

msgid "TOME_HERALD_DOOM@MAGIC_BOLTS@CRUEL"
msgstr "Cruel Bolts"

msgid "TOME_HERALD_DOOM@UNIT@NAME"
msgstr "Banshee^n"

msgid "TOME_HORDE@ABILITY_1@DESCRIPTION"
msgstr "At the start of battle, summon a {GLOBAL.UNITS.WAR_HOUND_UNIT.Hyperlink} {GLOBAL.PROPERTIES.SHOCK_UNIT.Hyperlink} that inflicts {GLOBAL.PROPERTIES.MARKED.Hyperlink} and {GLOBAL.PROPERTIES.BLEEDING.Hyperlink} with its attack.[br/][br/]Doesn't work in water combat and cannot benefit from Unit Enchantments."

msgid "TOME_HORDE@ABILITY_1@NAME"
msgstr "Unleash the Hounds"

msgid "TOME_HORDE@ABILITY_2@DESCRIPTION"
msgstr "Target Friendly {GLOBAL.PROPERTIES.ANIMAL.Hyperlink} unit gains {amount} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}."

msgid "TOME_HORDE@ABILITY_2@DESCRIPTION_PROP"
msgstr "Gains +{WEAK_POINT_SHOT>ResolvedMultiplier}% damage against {GLOBAL.PROPERTIES.MARKED.Hyperlink} units."

msgid "TOME_HORDE@ABILITY_2@NAME"
msgstr "Weak Point Shot"

msgid "TOME_HORDE@ABILITY_2@NAME_PROP"
msgstr "Weak Point"

msgid "TOME_HORDE@HERO_SKILL@DESCRIPTION"
msgstr "While this unit is the leader of the army, all Tier I units in the army gain:[bulletlist][bullet/]+{BATTLE_SEEKER_STATUS_STATS>BONUS>DEFENSE>Armor}{GLOBAL.DefenseConcept.Hyperlink}[bullet/]+{BATTLE_SEEKER_STATUS_STATS>BONUS>DEFENSE>Resistance}{GLOBAL.ResistanceConcept.Hyperlink}[bullet/]+{BATTLE_SEEKER_STATUS_STATS>BONUS>HitPoints}{GLOBAL.HitPointConcept.Hyperlink}[bullet/]+{BATTLE_SEEKER_STATUS_RESIST>Resistance}{GLOBAL.StatusResistanceConcept.Hyperlink}[/bulletlist]"

msgid "TOME_HORDE@HERO_SKILL@NAME"
msgstr "Battle Seeker Training"

msgid "TOME_HORDE@PASSIVE@DESCRIPTION"
msgstr "When you win in battle, you have a {chance}% chance of gaining a Tier {tier} unit."

msgid "TOME_HORDE@PASSIVE@NAME"
msgstr "Lure of the Horde"

msgid "TOME_HORDE@SKILL1@DESCRIPTION"
msgstr "A {GLOBAL.PROPERTIES.RANGED_UNIT.Hyperlink} that summons a {GLOBAL.UNITS.WAR_HOUND_UNIT.Hyperlink} to debilitate enemies."

msgid "TOME_HORDE@SKILL1@NAME"
msgstr "Houndmaster^n"

msgid "TOME_HORDE@SKILL2@DESCRIPTION"
msgstr "Tier I and Tier II friendly units in a {FURY_OF_THE_HORDE_UNIT_TARGETER_ALL>AREA>Radius}-hex radius gain:[bulletlist][bullet/]{amount} stacks of {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}.[/bulletlist]"

msgid "TOME_HORDE@SKILL2@NAME"
msgstr "Fury of the Horde"

msgid "TOME_HORDE@SKILL3@DESCRIPTION"
msgstr "Makes the target race smaller and more numerous, granting them:[bulletlist][bullet/]Increased number of units in formation.[bullet/]+{SPAWNKIN_DAMAGE_MULTIPLIER>ResolvedMultiplier}% damage for non-hero units.[bullet/]+{SPAWNKIN_HERO_EVASION>ResolvedAccuracyModifier}% {GLOBAL.EvasionConcept.Hyperlink} for hero units. [bullet/]Incompatible with {GLOBAL.PROPERTIES.SUPERGROWTH_PROPERTY_GROUP.Hyperlink}.[/bulletlist]"

msgid "TOME_HORDE@SKILL3@NAME"
msgstr "Spawnkin"

msgid "TOME_HORDE@SKILL3@PROPERTY_DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]An increased number of units in formation.[bullet/]+{SPAWNKIN_DAMAGE_MULTIPLIER>ResolvedMultiplier}% damage.[/bulletlist]"

msgid "TOME_HORDE@SKILL3@PROPERTY_DESCRIPTION_HERO"
msgstr "Unit has:[bulletlist][bullet/]+{SPAWNKIN_HERO_EVASION>ResolvedAccuracyModifier}% {GLOBAL.EvasionConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_HORDE@SKILL4@DESCRIPTION"
msgstr "Summons a random non-Scout Tier I unit that can be produced in a city on the target hex."

msgid "TOME_HORDE@SKILL4@NAME"
msgstr "Summon Irregulars"

msgid "TOME_HORDE@SKILL5@DESCRIPTION"
msgstr "Target enemy unit suffers:[bulletlist][bullet/]{BLAZE_OF_THE_HORDE_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]+{BLAZE_OF_THE_HORDE_COUNT_ADJACENT>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} for each adjacent friendly unit[/bulletlist]"

msgid "TOME_HORDE@SKILL5@NAME"
msgstr "Blaze of the Horde"

msgid "TOME_HORDE@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Turn your cheapest units into large, deadly armies. Specialize in summoning and buffing low tier units."

msgid "TOME_HORDE@TOME@LORE_AUTHOR"
msgstr "Swarmcaller Trass, Ratkin War-chief"

msgid "TOME_HORDE@TOME@LORE_DESCRIPTION"
msgstr "\"Masters of the Horde understand the power of large numbers, of masses riled up into a frenzy. Ultimately, our hounds of war will tear apart the strongest knights and most cunning warlocks. Our enemies' biggest mistake is to underestimate how many thralls we command, and how little we care about their lives.\""

msgid "TOME_HORDE@TOME@NAME"
msgstr "Tome of the Horde"

msgid "TOME_HORDE@UNIT2@NAME"
msgstr "War Hound^n"

msgid "TOME_HORDE@UNIT@NAME"
msgstr "Houndmaster^m"

msgid "TOME_INQUISITION@PASSIVE@DESCRIPTION"
msgstr "Gains {amount} {GLOBAL.ImperiumConcept} per {GLOBAL.HeroConcept} in your empire's prison."

msgid "TOME_INQUISITION@PASSIVE@NAME"
msgstr "Inquisitional Interrogators"

msgid "TOME_INQUISITION@SKILL1@DESCRIPTION"
msgstr "Grants access to an aggressive {GLOBAL.PROPERTIES.SKIRMISHER.Hyperlink} that can inflict {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink} and {GLOBAL.PROPERTIES.STUNNED.Hyperlink}."

msgid "TOME_INQUISITION@SKILL1@NAME"
msgstr "Inquisitor^m"

msgid "TOME_INQUISITION@SKILL2@DESCRIPTION"
msgstr "Enemies in a {MASS_CONDEMN_UNIT_TARGETER_CIRCLE>AREA>Radius}-hex radius:[bulletlist][bullet/]Sustain {MASS_CONDEMN_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink}.[bullet/]Become {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink} until the end of battle.[/bulletlist]"

msgid "TOME_INQUISITION@SKILL2@NAME"
msgstr "Mass Condemnation"

msgid "TOME_INQUISITION@SKILL3@DESCRIPTION"
msgstr "[bulletlist][bullet/]{stability} {GLOBAL.CityStabilityConcept.Hyperlink}[bullet/]{research} {GLOBAL.KnowledgeConcept.Hyperlink} per {GLOBAL.PopulationConcept.Hyperlink}[/bulletlist]"

msgid "TOME_INQUISITION@SKILL3@NAME"
msgstr "Tribunal"

msgid "TOME_INQUISITION@SKILL4@DESCRIPTION"
msgstr "Makes attacks of enchanted units have a:[bulletlist][bullet/]Base {CONDEMN_RESISTANCE>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink} until end of combat, reducing enemy {GLOBAL.StatusResistanceConcept.Hyperlink}.[bullet/]Base {WEAKENED_RESISTANCE>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.WEAKENED.Hyperlink}, reducing enemy damage.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_INQUISITION@SKILL4@NAME"
msgstr "Inquisitor's Mark"

msgid "TOME_INQUISITION@SKILL4@PROPERTY_DESCRIPTION"
msgstr "Unit's attacks have a:[bulletlist][bullet/]Base {CONDEMN_RESISTANCE>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink} until end of battle.[bullet/]Base {WEAKENED_RESISTANCE>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.WEAKENED.Hyperlink}.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_INQUISITION@SKILL5@DESCRIPTION"
msgstr "Target enemy army:[bulletlist][bullet/]Sustains {damage} {GLOBAL.SpiritDamageConcept.Hyperlink}.[bullet/]Loses {amount}% of its <<m:{GLOBAL.MovePointConcept}>> on the {GLOBAL.WorldMapConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_INQUISITION@SKILL5@NAME"
msgstr "Burden of Guilt"

msgid "TOME_INQUISITION@SKILL6@DESCRIPTION"
msgstr "Summon a {GLOBAL.UNITS.LIGHTBRINGER_UNIT.Hyperlink} {GLOBAL.PROPERTIES.BATTLE_MAGE.Hyperlink} that can convert other units to your cause."

msgid "TOME_INQUISITION@SKILL6@NAME"
msgstr "Summon Lightbringer"

msgid "TOME_INQUISITION@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Hunt down those who do not agree with your authority. Inflict {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink} on enemies and restrict their Movement."

msgid "TOME_INQUISITION@TOME@LORE_AUTHOR"
msgstr "Shira Snowblood, Godir of the Covenant"

msgid "TOME_INQUISITION@TOME@LORE_DESCRIPTION"
msgstr "\"The unrighteous shall feel the wrath of our unerring virtue. We shall strike down upon them with devout rage and furious vengeance! Their limbs shall be leaden with the weight of their wickedness, while our own subjects shall be driven by nobility of spirit!\""

msgid "TOME_INQUISITION@TOME@NAME"
msgstr "Tome of the Inquisition"

msgid "TOME_INQUISITION@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Shoots crossbow at target enemy unit."

msgid "TOME_INQUISITION@UNIT1@ABILITY1@NAME"
msgstr "Bolt of Judgment"

msgid "TOME_LICH@SKILL3@NAME"
msgstr "Wightborn"

msgid "TOME_MAYHEM@PASSIVE@DESCRIPTION"
msgstr "Gain {income} {GLOBAL.ManaConcept} per {GLOBAL.EmpireConcept} you are at {GLOBAL.WarConcept} with."

msgid "TOME_MAYHEM@PASSIVE@NAME"
msgstr "Ritual Warfare"

msgid "TOME_MAYHEM@SKILL1@DESCRIPTION"
msgstr "Makes attacks of enchanted units:[bulletlist][bullet/]Inflict {GLOBAL.PROPERTIES.MISFORTUNE.Hyperlink}.[/bulletlist] [br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_MAYHEM@SKILL1@DESCRIPTION_HS"
msgstr "The hero's base attacks:[bulletlist][bullet/]Inflict {GLOBAL.PROPERTIES.MISFORTUNE.Hyperlink}[/bulletlist] [br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_MAYHEM@SKILL1@NAME"
msgstr "Mark of Misfortune"

msgid "TOME_MAYHEM@SKILL1@PROP_DESCRIPTION"
msgstr "Unit's attacks:[bulletlist][bullet/]Inflict {GLOBAL.PROPERTIES.MISFORTUNE.Hyperlink}.[/bulletlist] [br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_MAYHEM@SKILL2@DESCRIPTION"
msgstr "Summons a {GLOBAL.UNITS.GREMLIN_UNIT.Hyperlink} onto the target world hex. This unit is a disruptive and fiendish {GLOBAL.PROPERTIES.MAGIC_FIGHTER.Hyperlink}."

msgid "TOME_MAYHEM@SKILL2@NAME"
msgstr "Summon Gremlin"

msgid "TOME_MAYHEM@SKILL3@DESCRIPTION"
msgstr "Targets in a {CURSE_OF_MISFORTUNE_UNIT_TARGETER_CIRCLE>AREA>Radius}-hex radius suffer {stacks} {GLOBAL.PROPERTIES.MISFORTUNE.Hyperlink}."

msgid "TOME_MAYHEM@SKILL3@NAME"
msgstr "Curse of Misfortune"

msgid "TOME_MAYHEM@SKILL4@DESCRIPTION"
msgstr "At the start of the battle, enemy units:[bulletlist][bullet/]Are displaced by {displacement} hexes.[bullet/]Suffer {GLOBAL.PROPERTIES.MISFORTUNE.Hyperlink} for {turn1}.[bullet/]Suffer {GLOBAL.PROPERTIES.SLOWED.Hyperlink} for {turn2}.[/bulletlist]"

msgid "TOME_MAYHEM@SKILL4@NAME"
msgstr "Sow Confusion"

msgid "TOME_MAYHEM@SKILL5@DESCRIPTION"
msgstr "Target Unit has:[bulletlist][bullet/]{INFECTIOUS_INSANITY_RESISTANCE>ResolvedStrength}% chance of being inflicted with {GLOBAL.PROPERTIES.INFECTIOUS_INSANITY.Hyperlink} for {INFECTIOUS_INSANITY_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>. [bullet/] If resisted, the target is inflicted with {GLOBAL.PROPERTIES.INSANITY.Hyperlink} for {INSANITY_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "TOME_MAYHEM@SKILL5@NAME"
msgstr "Infectious Insanity"

msgid "TOME_MAYHEM@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Cause chaos on the battlefield by randomly displacing enemies and inflicting {GLOBAL.PROPERTIES.MISFORTUNE.Hyperlink}."

msgid "TOME_MAYHEM@TOME@LORE_AUTHOR"
msgstr "Kruul Blightlord, Chaos Prince"

msgid "TOME_MAYHEM@TOME@LORE_DESCRIPTION"
msgstr "\"Be the fog that seeps into the mind, bringing confusion, making fingers numbed by uncertainty lose their grip. Be the malaise that creeps into thoughts, sowing the seeds of madness, of insanity in those who oppose you! Be the victor, standing over the gibbering mess that was once your enemy!\""

msgid "TOME_MAYHEM@TOME@NAME"
msgstr "Tome of Mayhem"

msgid "TOME_MAYHEM@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Target unit:[bulletlist][bullet/]Sustains damage.[bullet/]Turns 180 degrees.[bullet/]Has their {GLOBAL.DefenseModeConcept.Hyperlink} canceled and removes <<m:{GLOBAL.RetaliationConcept.Hyperlink}>>, unless the target has {GLOBAL.PROPERTIES.CHARGE_RESISTANCE.Hyperlink}.[/bulletlist]"

msgid "TOME_MAYHEM@UNIT1@ABILITY1@NAME"
msgstr "Behind You!"

msgid "TOME_MAYHEM@UNIT1@NAME"
msgstr "Gremlin^n"

msgid "TOME_NECROMANCER@HERO_SKILL@DESCRIPTION"
msgstr "While army leader, non-{GLOBAL.PROPERTIES.HERO.Hyperlink} {GLOBAL.PROPERTIES.UNDEAD.Hyperlink} units in army have:[bulletlist][bullet/]+{UNHOLY_AURA_DAMAGE_MULTIPLIER>ResolvedMultiplier}% damage[bullet/]+{UNHOLY_AURA_DAMAGE_STAT_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]+{UNHOLY_AURA_DAMAGE_STAT_BONUS>BONUS>REDUCTION>Fire} {GLOBAL.FireResistanceConcept.Hyperlink}[bullet/]+{UNHOLY_AURA_DAMAGE_STAT_BONUS>BONUS>REDUCTION>Spirit} {GLOBAL.SpiritResistanceConcept.Hyperlink}[/bulletlist]"

msgid "TOME_NECROMANCER@HERO_SKILL@NAME"
msgstr "Unholy Leader"

msgid "TOME_NECROMANCER@HERO_SKILL@PROP_DESCRIPTION"
msgstr "Unit deals +{UNHOLY_AURA_DAMAGE_MULTIPLIER>ResolvedMultiplier}% damage."

msgid "TOME_NECROMANCY@PASSIVE@DESCRIPTION"
msgstr "Pillaging <<m:{GLOBAL.ProvinceConcept}>> and razing <<m:{GLOBAL.CityConcept}>> also grants <<m:{GLOBAL.SoulConcept}>>."

msgid "TOME_NECROMANCY@PASSIVE@NAME"
msgstr "Haunted Ruins"

msgid "TOME_NECROMANCY@SKILL1@DESCRIPTION"
msgstr "{GLOBAL.UNITS.NECROMANCER.Hyperlink} strengthen the Undead and create them from corpses."

msgid "TOME_NECROMANCY@SKILL1@NAME"
msgstr "Necromancer"

msgid "TOME_NECROMANCY@SKILL2@DESCRIPTION"
msgstr "Raises corpses in a {RAISE_ZOMBIE_CIRCLE>AREA>Radius}-hex radius as {GLOBAL.UNITS.DECAYING_ZOMBIE.Hyperlink} units that die at the end of combat.[br/][br/]{LOC.TACTICAL@ABILITY@NEVER_IN_WATER}"

msgid "TOME_NECROMANCY@SKILL2@NAME"
msgstr "Raise Zombies"

msgid "TOME_NECROMANCY@SKILL2@SPELL_DESCRIPTION"
msgstr "Creates a Bone Golem by combining two Skeleton units."

msgid "TOME_NECROMANCY@SKILL2@SPELL_NAME"
msgstr "Create Bone Golem"

msgid "TOME_NECROMANCY@SKILL3@DESCRIPTION"
msgstr "Target friendly army:[bulletlist][bullet/]Heal non-{GLOBAL.PROPERTIES.UNDEAD.Hyperlink} units for {amount} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[bullet/]Heal Undead units for {amount2} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[/bulletlist]"

msgid "TOME_NECROMANCY@SKILL3@NAME"
msgstr "Feast of Souls"

msgid "TOME_NECROMANCY@SKILL4@DESCRIPTION"
msgstr "Grants attacks of enchanted units:[bulletlist][bullet/]A base {DECAYING_RESISTANCE>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.DECAYING.Hyperlink}, a damage-over-time effect that decreases healing received.[/bulletlist] [br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_NECROMANCY@SKILL4@NAME"
msgstr "Necrotic Imbuement"

msgid "TOME_NECROMANCY@SKILL4@PROP_DESCRIPTION"
msgstr "Unit's attacks have:[bulletlist][bullet/]A base {DECAYING_RESISTANCE>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.DECAYING.Hyperlink}.[/bulletlist] [br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_NECROMANCY@SKILL5@DESCRIPTION"
msgstr "Target friendly {GLOBAL.UNITS.ZOMBIE.Hyperlink} or Skeleton unit explodes, all enemies in a {ROTTING_EXPLOSION_TARGETER>AREA>Radius}-hex radius:[bulletlist][bullet/]Sustain {ROTTING_EXPLOSION_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink} and {ROTTING_EXPLOSION_DAMAGE>DAMAGE>Blight} {GLOBAL.BlightDamageConcept.Hyperlink}.[bullet/]Gain {count} {GLOBAL.PROPERTIES.DECAYING.Hyperlink} for {DECAYING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "TOME_NECROMANCY@SKILL5@NAME"
msgstr "Rotting Explosion"

msgid "TOME_NECROMANCY@SKILL6@DESCRIPTION"
msgstr "Summons a {GLOBAL.UNITS.CORRUPT_SOUL.Hyperlink}, a {GLOBAL.PROPERTIES.MAGIC_FIGHTER.Hyperlink} that exploits low enemy unit {GLOBAL.UnitMoraleConcept.Hyperlink}."

msgid "TOME_NECROMANCY@SKILL6@NAME"
msgstr "Summon Corrupt Soul"

msgid "TOME_NECROMANCY@SKILL7@DESCRIPTION"
msgstr "When killing non-racial Tier {amount1} units, gain the option to spend <<m:{GLOBAL.SoulConcept.Hyperlink}>> to create a {GLOBAL.UNITS.BONE_GOLEM.Hyperlink} after combat.[br/]One {GLOBAL.UNITS.BONE_GOLEM.Hyperlink} can be created for every {tieramount} tiers worth of units killed."

msgid "TOME_NECROMANCY@SKILL7@NAME"
msgstr "Bone Horror Reanimation"

msgid "TOME_NECROMANCY@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Create advanced {GLOBAL.PROPERTIES.UNDEAD.Hyperlink} creatures and gain ways to collect more <<m:{GLOBAL.SoulConcept}>>. Specialize in buffs and healing for {GLOBAL.PROPERTIES.UNDEAD.Hyperlink} units."

msgid "TOME_NECROMANCY@TOME@LORE_AUTHOR"
msgstr "Gloom Hooknail, Dark Lady of the Corrupted Goblins"

msgid "TOME_NECROMANCY@TOME@LORE_DESCRIPTION"
msgstr "\"Necromancers are the greatest healers of all, as they have the power to cure the greatest ailment itself: death! Some will fear such an existence, but what healing ritual doesn't have its side effects? There is also a grim, yet satisfying efficiency in recycling your fallen. When your army succumbs, raise them again!\""

msgid "TOME_NECROMANCY@TOME@NAME"
msgstr "Tome of Necromancy"

msgid "TOME_NECROMANCY@UNIT_1@ABILITY_1@DESCRIPTION"
msgstr "Consumes target corpse and heals +{hp} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>."

msgid "TOME_NECROMANCY@UNIT_1@ABILITY_1@NAME"
msgstr "Consume Corpse"

msgid "TOME_NECROMANCY@UNIT_1@ABILITY_2@DESCRIPTION"
msgstr "When this unit dies, it spawns an enfeebled {GLOBAL.UNITS.SKELETON_UNIT.Hyperlink} unit."

msgid "TOME_NECROMANCY@UNIT_1@ABILITY_2@NAME"
msgstr "Disassemble"

msgid "TOME_NECROMANCY@UNIT_1@ABILITY_3@DESCRIPTION"
msgstr "The first time this unit's total <<m:{GLOBAL.HitPointConcept.Hyperlink}>> reaches {CORPSE_CAGE_THRESHOLD_EVENT>ResolvedTriggerProportion}% or lower, it summons a {GLOBAL.UNITS.DECAYING_ZOMBIE.Hyperlink}.[br/]Does not function in water battles."

msgid "TOME_NECROMANCY@UNIT_1@ABILITY_3@NAME"
msgstr "Corpse Cage"

msgid "TOME_NECROMANCY@UNIT_1@DESCRIPTION"
msgstr "This amalgamation of reanimated corpses has the sole purpose of killing your foes, with no regard for its own survival."

msgid "TOME_NECROMANCY@UNIT_1@NAME"
msgstr "Bone Horror^n"

msgid "TOME_NECROMANCY@UNIT_2@ABILITY_1@DESCRIPTION"
msgstr "Target:[bulletlist][bullet/]Friendly {GLOBAL.PROPERTIES.UNDEAD.Hyperlink} corpse is revived with {RAISE_UNDEAD_RESURRECT>ResolvedHitPoints}% of its total <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[bullet/]Non-{GLOBAL.PROPERTIES.UNDEAD.Hyperlink} corpse is raised as a {GLOBAL.UNITS.ZOMBIE.Hyperlink}.[/bulletlist]"

msgid "TOME_NECROMANCY@UNIT_2@ABILITY_1@NAME"
msgstr "Raise Undead"

msgid "TOME_NECROMANCY@UNIT_2@ABILITY_2@DESCRIPTION"
msgstr "Target {GLOBAL.PROPERTIES.UNDEAD.Hyperlink} gains:[bulletlist][bullet/]{amount} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.HASTENED.Hyperlink}[/bulletlist]"

msgid "TOME_NECROMANCY@UNIT_2@ABILITY_2@DESCRIPTION_2"
msgstr "Target {GLOBAL.PROPERTIES.UNDEAD.Hyperlink}:[bulletlist][bullet/]Gains {amount} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}[bullet/]Gains {GLOBAL.PROPERTIES.HASTENED.Hyperlink}[bullet/]Heals {STRENGTHEN_UNDEAD_HEAL>NumHitpointsToRestore}{GLOBAL.TemporaryHitPointConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_NECROMANCY@UNIT_2@ABILITY_2@DESCRIPTION_CHAMPION"
msgstr "Strengthen Undead:[bulletlist][bullet/]Grants an additional {amount} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}.[bullet/]Heals the target for {STRENGTHEN_UNDEAD_HEAL>NumHitpointsToRestore}{GLOBAL.TemporaryHitPointConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_NECROMANCY@UNIT_2@ABILITY_2@NAME"
msgstr "Strengthen Undead"

msgid "TOME_NECROMANCY@UNIT_2@ABILITY_2@NAME_CHAMPION"
msgstr "Champion Strengthen Undead"

msgid "TOME_NECROMANCY@UNIT_2@NAME"
msgstr "Necromancer^m"

msgid "TOME_OBLIVION@HERO_SKILL@DESCRIPTION"
msgstr "Base {GLOBAL.MagicConcept.Hyperlink} attacks have a base {INSANITY_RESISTANCE>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.INSANITY.Hyperlink}.[br/][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_OBLIVION@HERO_SKILL@NAME"
msgstr "Mind Crush"

msgid "TOME_OBLIVION@PASSIVE@DESCRIPTION"
msgstr "Executing a prisoner gives you {amount} {GLOBAL.KnowledgeConcept.Hyperlink}."

msgid "TOME_OBLIVION@PASSIVE@NAME"
msgstr "Memory Extraction"

msgid "TOME_OBLIVION@SKILL1@DESCRIPTION"
msgstr "In the target enemy army:[bulletlist][bullet/]At the start of each battle, all units have a base {chance}% chance of becoming {GLOBAL.PROPERTIES.STUNNED.Hyperlink} for {turn} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Lasts {straTurn} {GLOBAL.WorldMapConcept.Hyperlink} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "TOME_OBLIVION@SKILL1@NAME"
msgstr "Ritual of Somnia"

msgid "TOME_OBLIVION@SKILL1@PROPERTY@DESCRIPTION"
msgstr "Has a base {chance}% chance of becoming {GLOBAL.PROPERTIES.STUNNED.Hyperlink} for {turn} <<m:{GLOBAL.TurnConcept}>> at the start of each battle."

msgid "TOME_OBLIVION@SKILL2@DESCRIPTION"
msgstr "Target non-{GLOBAL.PROPERTIES.HERO.Hyperlink} unit dies. After {SLEEP_OF_OBLIVION_UNDYING>TurnsTilRes} <<m:{GLOBAL.TurnConcept}>>, they come back to life with {SLEEP_OF_OBLIVION_UNDYING>ResolvedHealthProportion}% of their total <<m:{GLOBAL.HitPointConcept.Hyperlink}>> and are inflicted with {GLOBAL.PROPERTIES.INSANITY.Hyperlink}.[br/][br/]While dead this way the unit cannot be revived or have its corpse destroyed."

msgid "TOME_OBLIVION@SKILL2@NAME"
msgstr "Sleep of Oblivion"

msgid "TOME_OBLIVION@SKILL2@PROPERTY@DESCRIPTION"
msgstr "Come back to life with {SLEEP_OF_OBLIVION_UNDYING>ResolvedHealthProportion}% of their total <<m:{GLOBAL.HitPointConcept.Hyperlink}>> and are inflicted with {GLOBAL.PROPERTIES.INSANITY.Hyperlink}."

msgid "TOME_OBLIVION@SKILL3@DESCRIPTION"
msgstr "Summons a {GLOBAL.UNITS.LIVING_FOG_UNIT.Hyperlink} unit onto the target world hex."

msgid "TOME_OBLIVION@SKILL3@NAME"
msgstr "Summon Living Fog"

msgid "TOME_OBLIVION@SKILL4@DESCRIPTION"
msgstr "[bulletlist][bullet/]Conjures a {GLOBAL.DevouringVoidConcept.Hyperlink} in a {DEVOURING_VOID_POSITION_TARGETER_CIRCLE_1>AREA>Radius}-hex radius.[bullet/]Each turn, the radius increases by {increase} <<m:hex>>.[bullet/]Lasts for {DEVOURING_VOID_AUTO_SPELL_1>Duration} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "TOME_OBLIVION@SKILL4@NAME"
msgstr "Devouring Void"

msgid "TOME_OBLIVION@SKILL5@DESCRIPTION"
msgstr "Target friendly {GLOBAL.CityConcept.Hyperlink}. Any battle in the {GLOBAL.DomainConcept.Hyperlink} of the {GLOBAL.CityConcept.Hyperlink} now has the Fog of Insanity battle enchantment, which causes enemies to have a base {chance}% chance of gaining {GLOBAL.PROPERTIES.INSANITY.Hyperlink} every {GLOBAL.TurnConcept.Hyperlink}."

msgid "TOME_OBLIVION@SKILL5@NAME"
msgstr "Fog of Insanity"

msgid "TOME_OBLIVION@SKILL5@PROPERTY@DESCRIPTION"
msgstr "Each turn, owner's enemies have a base {INSANITY_RESISTANCE>ResolvedStrength}% chance of becoming inflicted with {GLOBAL.PROPERTIES.INSANITY.Hyperlink}."

msgid "TOME_OBLIVION@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Use powerful magic capable of sending your enemies to the nothingness of oblivion. Specialize in inflicting {GLOBAL.PROPERTIES.INSANITY} and making parts of the world and the battlefield inhospitable."

msgid "TOME_OBLIVION@TOME@LORE_AUTHOR"
msgstr "Meandor, Shadow Lord of the Dark Elves"

msgid "TOME_OBLIVION@TOME@LORE_DESCRIPTION"
msgstr "\"Death is not truly the opposite of life. The end is part of the journey. The true opposite of life is oblivion. When you have mastered this understanding, when you can harness the essence of the void and cast your enemies into non-existence, then you will truly command life, death, and what really lies beyond.\""

msgid "TOME_OBLIVION@TOME@NAME"
msgstr "Tome of Oblivion"

msgid "TOME_OBLIVION@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Damage can not be reduced by {GLOBAL.DefenseConcept.Hyperlink} or {GLOBAL.ResistanceConcept.Hyperlink}."

msgid "TOME_OBLIVION@UNIT1@ABILITY1@NAME"
msgstr "Mind Strike"

msgid "TOME_OBLIVION@UNIT1@ABILITY2@NAME"
msgstr "Unblockable Damage"

msgid "TOME_OBLIVION@UNIT1@ABILITY3@DESCRIPTION"
msgstr "Conjure a {GLOBAL.DevouringVoidConcept.Hyperlink} hazard in a {DEVOURING_VOID_POSITION_TARGETER_CIRCLE_1>AREA>Radius}-hex radius that lasts for {DEVOURING_VOID_PLACE_MARKER_1>Duration} <<m:{GLOBAL.TurnConcept}>>."

msgid "TOME_OBLIVION@UNIT1@ABILITY3@NAME"
msgstr "Call the Void"

msgid "TOME_OBLIVION@UNIT1@DESCRIPTION"
msgstr "A being from the void whose attacks cannot be blocked and that makes mortals go insane."

msgid "TOME_OBLIVION@UNIT1@NAME"
msgstr "Living Fog^n"

msgid "TOME_PANDEMONIUM@HERO_SKILL@DESCRIPTION"
msgstr "Unit's base {GLOBAL.MagicConcept.Hyperlink} attacks have:[bulletlist][bullet/]A base {chance}% chance of inflicting a random {GLOBAL.NegativeStatusEffectConcept.Hyperlink}.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_PANDEMONIUM@NEGATIVE_STATUS@CHANCE_PROP"
msgstr "Base {amount}% chance of inflicting a random {GLOBAL.NegativeStatusEffectConcept.Hyperlink}."

msgid "TOME_PANDEMONIUM@NEGATIVE_STATUS@PROP"
msgstr "Inflict a random {GLOBAL.NegativeStatusEffectConcept.Hyperlink}."

msgid "TOME_PANDEMONIUM@PASSIVE@DESCRIPTION"
msgstr "Gains {amount} {GLOBAL.ManaConcept} per {GLOBAL.UnitConcept} tier killed in {GLOBAL.CombatConcept}."

msgid "TOME_PANDEMONIUM@PASSIVE@NAME"
msgstr "Chaos Dissolution"

msgid "TOME_PANDEMONIUM@SKILL1@DESCRIPTION"
msgstr "Inflicts a random {GLOBAL.NegativeStatusEffectConcept.Hyperlink} on all units in a {MASS_HYSTERIA_UNIT_TARGETER_CIRCLE>AREA>Radius}-hex radius."

msgid "TOME_PANDEMONIUM@SKILL1@NAME"
msgstr "Mass Hysteria"

msgid "TOME_PANDEMONIUM@SKILL2@DESCRIPTION"
msgstr "Summons a {GLOBAL.UNITS.CHAOES_EATER_UNIT.Hyperlink}, a close-range {GLOBAL.PROPERTIES.BATTLE_MAGE.Hyperlink} that thrives on eating <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>>."

msgid "TOME_PANDEMONIUM@SKILL2@NAME"
msgstr "Summon Chaos Eater"

msgid "TOME_PANDEMONIUM@SKILL3@DESCRIPTION"
msgstr "Grants base {GLOBAL.MagicConcept.Hyperlink} attacks of enchanted units:[bulletlist][bullet/]Base {chance}% chance of inflicting a random {GLOBAL.NegativeStatusEffectConcept.Hyperlink}.[/bulletlist] [br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_PANDEMONIUM@SKILL3@MOD_DESCRIPTION"
msgstr "{chance}% chance of inflicting a random {GLOBAL.NegativeStatusEffectConcept.Hyperlink}."

msgid "TOME_PANDEMONIUM@SKILL3@NAME"
msgstr "Havoc Magic"

msgid "TOME_PANDEMONIUM@SKILL3@PROPERTY_DESCRIPTION"
msgstr "Unit's base {GLOBAL.MagicConcept.Hyperlink} attacks have:[bulletlist][bullet/]A base {chance}% chance of inflicting a random {GLOBAL.NegativeStatusEffectConcept.Hyperlink}.[/bulletlist] [br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_PANDEMONIUM@SKILL4@DESCRIPTION"
msgstr "Turns the target race into a conduit for chaotic energies, granting them:[bulletlist][bullet/]+{VESSELS_OF_CHAOS_COUNTING_DAMAGE_MULTIPLIER>ResolvedDamageMultip}% damage for each of the target's <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>>. Stacks up to {VESSELS_OF_CHAOS_COUNTING_DAMAGE_MULTIPLIER>MaxCount} times.[/bulletlist]"

msgid "TOME_PANDEMONIUM@SKILL4@NAME"
msgstr "Vessels of Chaos"

msgid "TOME_PANDEMONIUM@SKILL4@PROPERTY_DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]+{VESSELS_OF_CHAOS_COUNTING_DAMAGE_MULTIPLIER>ResolvedDamageMultip}% damage per {GLOBAL.NegativeStatusEffectConcept.Hyperlink} on the target. Stacks up to {VESSELS_OF_CHAOS_COUNTING_DAMAGE_MULTIPLIER>MaxCount} times.[/bulletlist]"

msgid "TOME_PANDEMONIUM@SKILL5@DESCRIPTION"
msgstr "Target enemy city:[bulletlist][bullet/]Loses a border province and the population is lost.[bullet/]Spawns a Brigand Camp on land provinces.[bullet/]Spawns a Pirate Cove on coastal provinces.[/bulletlist]"

msgid "TOME_PANDEMONIUM@SKILL5@NAME"
msgstr "Incite Revolution"

msgid "TOME_PANDEMONIUM@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Thrive in the chaos of battle and specialize in inflicting random <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>> on your enemies and dealing more damage to enemies that are already inflicted."

msgid "TOME_PANDEMONIUM@TOME@LORE_AUTHOR"
msgstr "Karissa the Red, Mistress of Passions"

msgid "TOME_PANDEMONIUM@TOME@LORE_DESCRIPTION"
msgstr "\"There is a subtle artistry to true chaos. There is nothing as delightful as watching the seeds of discord grow into mass hysteria, spreading panic and disorder throughout entire populations! To me, it is simply... bliss!\""

msgid "TOME_PANDEMONIUM@TOME@NAME"
msgstr "Tome of Pandemonium"

msgid "TOME_PANDEMONIUM@UNIT1@ABILITY1@DESCRIPTION"
