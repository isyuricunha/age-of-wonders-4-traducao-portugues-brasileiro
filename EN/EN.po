msgstr "Primal Boon"

msgid "DLC@PRIMALFURY@PRIMAL_FURY_ABILITY@CROCODILE@DESCRIPTION"
msgstr "Unit is blessed by the Mire Crocodile:[bulletlist][bullet/]It gains a {GLOBAL.PROPERTIES.PRIMAL_FURY_CROCODILE.Hyperlink} stack when attacking.[bullet/]At {amount} stacks, these turn into stacks of {GLOBAL.PROPERTIES.FURY_CROCODILE.Hyperlink}. The unit's base attacks:[bulletlist][bullet/]Gain +{FURY_CROCODILE_EXTRA_DAMAGE>DAMAGE>Blight} {GLOBAL.BlightDamageConcept.Hyperlink}.[bullet/]Inflict {GLOBAL.PROPERTIES.DISEASED.Hyperlink}.[/bulletlist][bullet/]Each attack removes a stack of {GLOBAL.PROPERTIES.FURY_CROCODILE.Hyperlink}.[/bulletlist]"

msgid "DLC@PRIMALFURY@PRIMAL_FURY_ABILITY@CROCODILE@NAME"
msgstr "Mire Crocodile's Boon"

msgid "DLC@PRIMALFURY@PRIMAL_FURY_ABILITY@CROCODILE_FURY@DESCRIPTION"
msgstr "Attacks:[bulletlist][bullet/]Gain +{FURY_CROCODILE_EXTRA_DAMAGE>DAMAGE>Blight} {GLOBAL.BlightDamageConcept.Hyperlink}.[bullet/]Inflict {GLOBAL.PROPERTIES.DISEASED.Hyperlink}.[/bulletlist][br/]Each attack removes a stack of this buff."

msgid "DLC@PRIMALFURY@PRIMAL_FURY_ABILITY@CROCODILE_FURY@NAME"
msgstr "Fury of the Mire Crocodile"

msgid "DLC@PRIMALFURY@PRIMAL_FURY_ABILITY@CROCODILE_STACK@DESCRIPTION"
