msgstr "Frost Blades"

msgid "TOME_CRYOMANCY@SKILL_3@PROP_DESCRIPTION"
msgstr "Unit's attacks have:[bulletlist][bullet/]+{FROST_BLADES_EXTRA_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]+{FROST_BLADES_DAMAGE_MULTIPLIER>ResolvedMultiplier}% damage against {GLOBAL.PROPERTIES.FROZEN.Hyperlink} and {GLOBAL.PROPERTIES.SLOWED.Hyperlink} units.[/bulletlist] [br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CRYOMANCY@SKILL_4@DESCRIPTION"
