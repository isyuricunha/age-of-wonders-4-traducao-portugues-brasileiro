msgid "ADVICE@HEROCAP_REMINDER@INSTRUCTION"
msgstr "Left-click to open your Throne City panel"

msgid "ADVICE@HEROCAP_REMINDER@TITLE"
msgstr "Time to recruit a new Hero!"

