msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@REALM_SHROUDEDREALM@SUBTITLE"
msgstr "This realm shelters Shrouded Isles, where the Wizard Kings concealed their most prized—and most shameful—creations, guarded against all who dare claim them."

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@REALM_SHROUDEDREALM@TEMPLATE_NAME"
msgstr "Shrouded Isles"

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@TRAIT_CREEPING_MISTS@DESCRIPTION"
msgstr "An unnatural mist moves over the land, threatening everyone caught inside.[bulletlist][bullet/]<<m:{GLOBAL.ProvinceConcept.Hyperlink}>> with {GLOBAL.PROPERTIES.MISTY.Hyperlink} are [abilityblue]Dangerous[/abilityblue].[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@TRAIT_CREEPING_MISTS@NAME"
msgstr "Creeping Mists (NON-FUNCTIONAL)"

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@TRAIT_HILLS_NO_MOUNTAINS@DESCRIPTION"
msgstr "The peoples of this realm live in burrows dug beneath the hilly landscape.[bulletlist][bullet/]Mountain <<m:{GLOBAL.ProvinceFeatureConcept.Hyperlink}>> are [abilityblue]Rare[/abilityblue].[bullet/]Hills are [abilityblue]Common[/abilityblue].[bullet/]<<m:{GLOBAL.IndependentCityConcept.Hyperlink} >> only exist in the {GLOBAL.UndergroundConcept.Hyperlink}.[bullet/]All <<m:{GLOBAL.IndependentCityConcept.Hyperlink} >> and marauder races have animalistic forms.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@TRAIT_HILLS_NO_MOUNTAINS@NAME"
msgstr "Burrowed Realm"

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@TRAIT_LAVA_ISLANDS@DESCRIPTION"
msgstr "This realm is covered in lava and various small islands, but contains a vast underground to explore. [bulletlist][bullet/]The following <<m:{GLOBAL.ProvinceFeatureConcept.Hyperlink}>> are [abilityblue]Abundant[/abilityblue]:[bulletlist][bullet/]{GLOBAL.AshlandsConcept.Hyperlink}, {GLOBAL.ChasmConcept.Hyperlink}, and {GLOBAL.LavaConcept.Hyperlink}.[/bulletlist][bullet/]The following Province Feature is [abilityblue]Scarce[/abilityblue]:[bulletlist][bullet/]{GLOBAL.SandConcept.Hyperlink}.[/bulletlist][bullet/]The following Province Features are [abilityblue]Absent[/abilityblue]:[bulletlist][bullet/]{GLOBAL.FrozenWasteConcept.Hyperlink}[/bulletlist][/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@TRAIT_LAVA_ISLANDS@NAME"
msgstr "Lava Drenched Realm"

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@TRAIT_MISTWALKER_INCURSION@DESCRIPTION"
msgstr "The Mistwalkers have invaded this realm, setting up a permanent military presence.[bulletlist][bullet/]Mistwalker Camp <<m:{GLOBAL.InfestationConcept.Hyperlink}>> are [abilityblue]Common[/abilityblue].[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@TRAIT_MISTWALKER_INCURSION@NAME"
msgstr "Mistwalker Incursion"

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@TRAIT_NO_CITY_START@DESCRIPTION"
msgstr "You arrive on this realm without a {GLOBAL.ThroneCityConcept.Hyperlink}, only with your starting {GLOBAL.ArmyConcept.Hyperlink}."

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@TRAIT_NO_CITY_START@NAME"
