msgid "DLC@GIANTKINGS@TSR_DGC@OBJECTIVE_01"
msgstr "{TSR_DGC_CHAMBER_01_EXCAVATED}/1 First Chamber Excavated"

msgid "DLC@GIANTKINGS@TSR_DGC@OBJECTIVE_02"
msgstr "{TSR_DGC_CHAMBER_01_COMPLETED}/1 First Chamber: Spider Nest Destroyed"

