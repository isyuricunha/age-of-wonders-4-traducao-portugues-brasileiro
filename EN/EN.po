msgstr "Grants {FAST_MOVEMENT>TacticalMovePoints} {GLOBAL.CombatSpeedConcept.Hyperlink}."

msgid "FORM_TRAITS@09@LORE"
msgstr "[helpcolor]Units move faster in combat.[/helpcolor]"

