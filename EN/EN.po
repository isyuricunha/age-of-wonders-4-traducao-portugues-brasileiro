msgstr "Dwellings"

msgid "INTERFACE@DIPLOMACY@DWELLING@DESCRIPTION"
msgstr "[minorcity/] Dwellings are independent <<m:{GLOBAL.CityConcept.Hyperlink}>> that are inhabited by specific types of <<m:{GLOBAL.UnitConcept.Hyperlink}>>.[br/][br/]Like <<m:{GLOBAL.IndependentCityConcept.Hyperlink}>> they:[bulletlist][bullet/]Have a {GLOBAL.FreeCityLordConcept.Hyperlink}.[bullet/]Have [hyperlink,GLOBAL.PvEDiplStateConcept]diplomatic standings[/hyperlink] with you that can be improved to gain benefits.[bullet/]Do not belong to an {GLOBAL.EmpireConcept.Hyperlink}.[/bulletlist][br/][br/]Dwellings are not affected by Realm Traits or <<m:{GLOBAL.SpellConcept.Hyperlink}>> that affect Free Cities."

msgid "INTERFACE@DIPLOMACY@DWELLING@HYPERLINK"
msgstr "[minorcity/][hyperlink,GLOBAL.DwellingConcept]Dwelling[/hyperlink]"

msgid "INTERFACE@DIPLOMACY@EMPIRE_RELATION"
msgstr "Empire Relations"

msgid "INTERFACE@DIPLOMACY@EMPIRE_RELATION_DESCRIPTION"
msgstr "Represents the degree to which two <<m:{GLOBAL.EmpireConcept.Hyperlink}>> are on good terms with one another.[br/][br/]Good Empire Relations are required to [hyperlink,GLOBAL.TradeConcept]negotiate[/hyperlink] a {GLOBAL.MutualConsulateConcept.Hyperlink} and <<m:{GLOBAL.TreatyConcept.Hyperlink}>>. Eventually good relations can lead to an {GLOBAL.DSAllianceConcept.Hyperlink}.[br/][br/]Bad Empire Relations increase the chance of {GLOBAL.WarConcept.Hyperlink} being declared.[br/][br/]Empire Relations can be improved by:[bulletlist][bullet/]High {GLOBAL.AlignmentConcept.Hyperlink}[bullet/]<<m:{GLOBAL.PronouncementsConcept.Hyperlink}>>[bullet/]Gifts[bullet/][hyperlink,GLOBAL.TradeConcept]Trades[/hyperlink][/bulletlist]"

msgid "INTERFACE@DIPLOMACY@EMPIRE_RELATION_HYPERLINK"
msgstr "[hyperlink,GLOBAL.EmpireRelationConcept]Empire Relations[/hyperlink]"

msgid "INTERFACE@DIPLOMACY@FORGED_ALLIANCE_WITH"
