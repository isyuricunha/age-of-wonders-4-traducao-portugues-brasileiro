msgid "DLC@ARCHMAGE@DESCRIPTION"
msgstr "Expansion Pass bonus"

msgid "DLC@ARCHMAGE@DISPLAYDESCRIPTION"
msgstr "The Wizards of Magehaven dress to impress, representing their grand personalities and ambitions. This outfit pack unlocks a new set of clothing you can wear as a whole or mix and match with other items."

msgid "DLC@ARCHMAGE@DISPLAYNAME"
msgstr "Age of Wonders 4: Archmage Attire"

msgid "DLC@ARCHMAGE@DISPLAYNAME_PC"
msgstr "Age of Wonders 4: Archmage Attire (PC)"

msgid "DLC@ARCHONPROPHECY@@SHOPS_STRATEGIC@TRAINING_CAMP@REEDUCATION_BATTLESAINT"
msgstr "Battlesaint Reeducation"

msgid "DLC@ARCHONPROPHECY@CHARIOT_MOUNT@DESCRIPTION"
msgstr "Unit gains:[bulletlist][bullet/]{GLOBAL.PROPERTIES.VERY_FAST_MOVEMENT.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.CAVALRY_GROUP.Hyperlink} unit type[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@CHARIOT_MOUNT@EFFECT_DESCRITPION_01"
msgstr "Ruler starts with a Chariot mount."

msgid "DLC@ARCHONPROPHECY@CHARIOT_MOUNT@EFFECT_DESCRITPION_02"
msgstr "+{CHARIOT_NON_FLANKING>DEF_MOD>Armor} {GLOBAL.DefenseConcept.Hyperlink} against non-{GLOBAL.FlankingConcept.Hyperlink} attacks."

msgid "DLC@ARCHONPROPHECY@CHARIOT_MOUNT@EFFECT_DESCRITPION_03"
msgstr "Reduces members in the unit to one, granting immunity to [hyperlink,GLOBAL.CasualtyConcept]Casualties[/hyperlink]."

msgid "DLC@ARCHONPROPHECY@COMBATPROPERTIES_TACTICAL@ARMAMENTS_OF_DECAY@DESCRIPTION"
msgstr "All applicable units in the attacking army gain {GLOBAL.PROPERTIES.WITHERING_DECAY_PROPERTY_GROUP.Hyperlink}[br/]Works for Skirmisher, Fighter, Shield, Shock, and Polearm units."

msgid "DLC@ARCHONPROPHECY@COMBATPROPERTIES_TACTICAL@ARMAMENTS_OF_DECAY@NAME"
msgstr "Armaments of Decay"

msgid "DLC@ARCHONPROPHECY@COMBATPROPERTIES_TACTICAL@BRINGER_OF_JUDGEMENT@DESCRIPTION"
msgstr "Your {GLOBAL.PROPERTIES.EXPEDITION_LEADER.Hyperlink} gains {GLOBAL.PROPERTIES.ARCHONS_SMITE.Hyperlink} for the duration of this combat."

msgid "DLC@ARCHONPROPHECY@COMBATPROPERTIES_TACTICAL@BRINGER_OF_JUDGEMENT@NAME"
msgstr "Bringer of Judgment"

msgid "DLC@ARCHONPROPHECY@COMBATPROPERTIES_TACTICAL@CELESTIAL_RAIN@DESCRIPTION"
msgstr "Every {turn} <<m:{GLOBAL.TurnConcept.Hyperlink}>>:[bulletlist][bullet/]All units become {GLOBAL.PROPERTIES.WET.Hyperlink} for {turn2} [turn/] Turns[bullet/]All {GLOBAL.PROPERTIES.FAITHFUL.Hyperlink}, {GLOBAL.PROPERTIES.ZEAL.Hyperlink}, and {GLOBAL.PROPERTIES.CELESTIAL.Hyperlink} units have their negative status effects cleansed.[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@COMBATPROPERTIES_TACTICAL@CELESTIAL_RAIN@NAME"
msgstr "Celestial Rain"

msgid "DLC@ARCHONPROPHECY@COMBATPROPERTIES_TACTICAL@CORRUPTED_SOULS@DESCRIPTION"
msgstr "When a defending {GLOBAL.PROPERTIES.UNDEAD.Hyperlink} Unit dies, they resurrect as a {GLOBAL.UNITS.CORRUPT_SOUL.Hyperlink} after {CORRUPTED_SOULS_UNDYING>TurnsTilRes} {GLOBAL.TurnConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@COMBATPROPERTIES_TACTICAL@CORRUPTED_SOULS@NAME"
msgstr "Corrupted Souls"

msgid "DLC@ARCHONPROPHECY@COMBATPROPERTIES_TACTICAL@DEFENSIVE_TRAINING@DESCRIPTION"
msgstr "All units in the attacking army gain {GLOBAL.PROPERTIES.DEFENSIVE_TACTICS_HALO.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@COMBATPROPERTIES_TACTICAL@DEFENSIVE_TRAINING@NAME"
msgstr "Defensive Training"

msgid "DLC@ARCHONPROPHECY@COMBATPROPERTIES_TACTICAL@EMBODIMENT_OF_LIGHT@DESCRIPTION"
msgstr "Your {GLOBAL.PROPERTIES.EXPEDITION_LEADER.Hyperlink} gains {GLOBAL.PROPERTIES.HOLY_AURA_ENCHANTMENT_PROPERTY_GROUP.Hyperlink} during battle."

msgid "DLC@ARCHONPROPHECY@COMBATPROPERTIES_TACTICAL@EMBODIMENT_OF_LIGHT@NAME"
msgstr "Embodiment of Light"

msgid "DLC@ARCHONPROPHECY@COMBATPROPERTIES_TACTICAL@EMBRACE_THE_RAGE@DESCRIPTION"
msgstr "All attacking units gain {GLOBAL.PROPERTIES.BERSERKERS_RAGE_THRESHOLD_EVENT.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@COMBATPROPERTIES_TACTICAL@EMBRACE_THE_RAGE@NAME"
msgstr "Embrace the Rage"

msgid "DLC@ARCHONPROPHECY@COMBATPROPERTIES_TACTICAL@FREE_SOULS@ABILITY_DESCRIPTION"
msgstr "Destroys the target corpse."

msgid "DLC@ARCHONPROPHECY@COMBATPROPERTIES_TACTICAL@FREE_SOULS@DESCRIPTION"
msgstr "Attacking {GLOBAL.PROPERTIES.SUPPORT_UNIT.Hyperlink} units gain {GLOBAL.PROPERTIES.FREE_THEIR_SOULS.Hyperlink} during battle."

msgid "DLC@ARCHONPROPHECY@COMBATPROPERTIES_TACTICAL@FREE_SOULS@NAME"
msgstr "Free Their Souls"

msgid "DLC@ARCHONPROPHECY@COMBATPROPERTIES_TACTICAL@LAST_STAND@DESCRIPTION"
msgstr "Your {GLOBAL.PROPERTIES.EXPEDITION_LEADER.Hyperlink} gains {GLOBAL.PROPERTIES.STEADFAST.Hyperlink} for {turn} {GLOBAL.TurnConcept.Hyperlink} the first time they fall below {LAST_STAND_THERSHOLD>ResolvedTriggerProportion}% <<m:{GLOBAL.HitPointConcept.Hyperlink}>>."

msgid "DLC@ARCHONPROPHECY@COMBATPROPERTIES_TACTICAL@LAST_STAND@NAME"
msgstr "Last Stand"

msgid "DLC@ARCHONPROPHECY@COMBATPROPERTIES_TACTICAL@ORACLES_HELP@DESCRIPTION"
msgstr "An {GLOBAL.UNITS.ORACLE.Hyperlink} unit joins you at the start of the battle."

msgid "DLC@ARCHONPROPHECY@COMBATPROPERTIES_TACTICAL@ORACLES_HELP@NAME"
msgstr "Oracles Help"

msgid "DLC@ARCHONPROPHECY@COMBATPROPERTIES_TACTICAL@PROPHECY_OF_DEATH@DESCRIPTION"
msgstr "At the start of combat, the enemy oracle inflicts {GLOBAL.PROPERTIES.MARKED_FOR_DEATH.Hyperlink} on your leader. This effect lasts until the end of combat, but can be dispelled if the oracle is killed."

msgid "DLC@ARCHONPROPHECY@COMBATPROPERTIES_TACTICAL@PROPHECY_OF_DEATH@NAME"
msgstr "Prophecy of Death"

msgid "DLC@ARCHONPROPHECY@COMBATPROPERTIES_TACTICAL@RADIANT_RESISTANCE@DESCRIPTION"
msgstr "All attacking units gain +{value} {GLOBAL.SpiritResistanceConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@COMBATPROPERTIES_TACTICAL@RADIANT_RESISTANCE@NAME"
msgstr "Radiant Resistance"

msgid "DLC@ARCHONPROPHECY@COMBATPROPERTIES_TACTICAL@RIGHTEOUS_MARTYR@DESCRIPTION"
msgstr "Your {GLOBAL.PROPERTIES.EXPEDITION_LEADER.Hyperlink} gains {GLOBAL.PROPERTIES.MARTYRS_REBIRTH.Hyperlink} during combat."

msgid "DLC@ARCHONPROPHECY@COMBATPROPERTIES_TACTICAL@RIGHTEOUS_MARTYR@NAME"
msgstr "Righteous Martyr"

msgid "DLC@ARCHONPROPHECY@COMBATPROPERTIES_TACTICAL@SOULBINDER@DESCRIPTION"
msgstr "Your {GLOBAL.PROPERTIES.EXPEDITION_LEADER.Hyperlink} gains {GLOBAL.PROPERTIES.SOULBINDERS_GROUP.Hyperlink} on their attacks during battle."

msgid "DLC@ARCHONPROPHECY@COMBATPROPERTIES_TACTICAL@SOULBINDER@NAME"
msgstr "Soulbinder"

msgid "DLC@ARCHONPROPHECY@COMBATPROPERTIES_TACTICAL@STAR_READING@DESCRIPTION"
msgstr "All attacking units gain {GLOBAL.PROPERTIES.TRUE_STRIKE.Hyperlink} at the start of combat."

msgid "DLC@ARCHONPROPHECY@COMBATPROPERTIES_TACTICAL@STAR_READING@NAME"
msgstr "Star Reading"

msgid "DLC@ARCHONPROPHECY@COMBATPROPERTIES_TACTICAL@SUPPORTING_DIVINATION@DESCRIPTION"
msgstr "All attacking units gain {GLOBAL.PROPERTIES.PRECOGNITION.Hyperlink} at the start of combat."

msgid "DLC@ARCHONPROPHECY@COMBATPROPERTIES_TACTICAL@SUPPORTING_DIVINATION@NAME"
msgstr "Supporting Divination"

msgid "DLC@ARCHONPROPHECY@COMBATPROPERTIES_TACTICAL@THE_UNTOUCHABLES@DESCRIPTION"
msgstr "The defenders have forced the Oracles to bring forth prophecies to make their army untouchable.[br/]Each turn of combat a different prophecy will come into effect in order:"

msgid "DLC@ARCHONPROPHECY@COMBATPROPERTIES_TACTICAL@THE_UNTOUCHABLES@EFFECT1_DESCRIPTION"
msgstr "Prophecy of Misfortune: All attacking units suffer {GLOBAL.PROPERTIES.MISFORTUNE.Hyperlink}"

msgid "DLC@ARCHONPROPHECY@COMBATPROPERTIES_TACTICAL@THE_UNTOUCHABLES@EFFECT2_DESCRIPTION"
msgstr "Prophecy of Evasion: All defending units gain {GLOBAL.EvasionConcept.Hyperlink}"

msgid "DLC@ARCHONPROPHECY@COMBATPROPERTIES_TACTICAL@THE_UNTOUCHABLES@EFFECT3_DESCRIPTION"
msgstr "Prophecy of Precognition: All defending units gain {GLOBAL.PROPERTIES.PRECOGNITION.Hyperlink}"

msgid "DLC@ARCHONPROPHECY@COMBATPROPERTIES_TACTICAL@THE_UNTOUCHABLES@EFFECT4_DESCRIPTION"
msgstr "Prophecy of Grace: All defending units gain {GLOBAL.PROPERTIES.GRACE.Hyperlink}"

msgid "DLC@ARCHONPROPHECY@COMBATPROPERTIES_TACTICAL@THE_UNTOUCHABLES@NAME"
msgstr "The Untouchables"

msgid "DLC@ARCHONPROPHECY@COMBATPROPERTIES_TACTICAL@UNBOUND_FROM_DEATH@DESCRIPTION"
msgstr "Your {GLOBAL.PROPERTIES.EXPEDITION_LEADER.Hyperlink} gains {GLOBAL.PROPERTIES.UNDYING.Hyperlink} during battle."

msgid "DLC@ARCHONPROPHECY@COMBATPROPERTIES_TACTICAL@UNBOUND_FROM_DEATH@NAME"
msgstr "Unbound from Death"

msgid "DLC@ARCHONPROPHECY@CONCEPT@HERO_CLASS@BATTLESAINT@DESCRIPTION"
msgstr "{LOC.DLC@ARCHONPROPHECY@CONCEPT@HERO_CLASS@BATTLESAINT@DESCRIPTION_SHORT}[br/][br/]Compatible weapons:[bulletlist][bullet/]{GLOBAL.GreatWeaponConcept.Hyperlink}[bullet/]{GLOBAL.OneHandedWeaponConcept.Hyperlink}[bullet/]{GLOBAL.ShieldConcept.Hyperlink}[bullet/]{GLOBAL.FistWeaponConcept.Hyperlink}[bullet/]{GLOBAL.PolearmWeaponConcept.Hyperlink}[bullet/]{GLOBAL.MagicStaffWeaponConcept.Hyperlink}[bullet/]{GLOBAL.MagicOrbWeaponConcept.Hyperlink}[bullet/]{GLOBAL.SkirmishingWeaponConcept.Hyperlink}[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@CONCEPT@HERO_CLASS@BATTLESAINT@DESCRIPTION_SHORT"
msgstr "Battlesaints gain Fervor through particular actions that they spend for powerful support abilities or to empower themselves and smite their enemies."

msgid "DLC@ARCHONPROPHECY@CONCEPT@HERO_CLASS@BATTLESAINT@GAMEPLAY_HYPERLINK"
msgstr "[classBattlesaint/] [hyperlink,GLOBAL.HeroClassBattlesaint]Battlesaint[/hyperlink]"

msgid "DLC@ARCHONPROPHECY@CONCEPT@HERO_CLASS@BATTLESAINT@HYPERLINK"
msgstr "[hyperlink,GLOBAL.HeroClassBattlesaint]Hero Class: Battlesaint[/hyperlink]"

msgid "DLC@ARCHONPROPHECY@CRISIS@991_8119@DESCRIPTION"
msgstr "Emnora is divided into four rings, representing different levels of Ascension. To talk to the Archon High Council, you must reach the Fourth Ring."

msgid "DLC@ARCHONPROPHECY@CRISIS@991_8119@NAME"
msgstr "The Rings of Emnora"

msgid "DLC@ARCHONPROPHECY@CRISIS@991_8119@SUB_HEADER"
msgstr "Ascend and reach the Archon High Council."

msgid "DLC@ARCHONPROPHECY@CRISIS@991_8391@DESCRIPTION"
msgstr "Your fears are manifesting into physical shapes, attacking your cities."

msgid "DLC@ARCHONPROPHECY@CRISIS@991_8391@NAME"
msgstr "Incarnations of Woe"

msgid "DLC@ARCHONPROPHECY@CRISIS@991_8391@SUB_HEADER"
msgstr "Prepare to face the manifestations of your fears..."

msgid "DLC@ARCHONPROPHECY@CULTURE_ARCHITECT@AFFINITY_INCARNATE@ASTRAL@AFFINITY_DESCRIPTION"
msgstr "Units gain: +{damageincrease} {GLOBAL.LightningDamageConcept.Hyperlink} and +{defenseincrease} {GLOBAL.LightningResistanceConcept.Hyperlink}[br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@ARCHONPROPHECY@CULTURE_ARCHITECT@AFFINITY_INCARNATE@ASTRAL@DESCRIPTION"
msgstr "For each stack of Affinity Incarnate, this unit gains:[bulletlist][bullet/]+{damageincrease} {GLOBAL.LightningDamageConcept.Hyperlink}[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@ARCHONPROPHECY@CULTURE_ARCHITECT@AFFINITY_INCARNATE@ASTRAL@NAME"
msgstr "Astral Incarnate"

msgid "DLC@ARCHONPROPHECY@CULTURE_ARCHITECT@AFFINITY_INCARNATE@CHAOS@AFFINITY_DESCRIPTION"
