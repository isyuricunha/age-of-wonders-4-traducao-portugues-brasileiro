msgid "EXPANSION_VICTORY@EVENT_BEACONS_UNLOCKED@PLAYER"
msgstr "{Player.Name} has control over enough of the {GLOBAL.WorldMapConcept.Hyperlink} to unlock the {GLOBAL.STRUCTURE_UPGRADES.BEACONOFUNITY.Hyperlink} improvement! They are on their way to achieving the {VictoryConditionName}!"

msgid "EXPANSION_VICTORY@EVENT_BEACONS_UNLOCKED@YOU"
msgstr "You have control over enough of the {GLOBAL.WorldMapConcept.Hyperlink} to unlock the {GLOBAL.STRUCTURE_UPGRADES.BEACONOFUNITY.Hyperlink} improvement! Building these <<m:{GLOBAL.SpecialImprovementConcept.Hyperlink}>> will put you on the path to achieving the {VictoryConditionName}!"

msgid "EXPANSION_VICTORY@EVENT_BEACON_BUILT@PLAYER"
msgstr "{Player.Name} has built a {GLOBAL.STRUCTURE_UPGRADES.BEACONOFUNITY.Hyperlink} and is working towards the {VictoryConditionName}!"

