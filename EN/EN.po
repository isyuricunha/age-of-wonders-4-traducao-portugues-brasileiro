msgstr "Shardspire Ridge"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@LITHORITE_PEAKS@NAME_OVERRIDE_03"
msgstr "Aetherglow Mountains"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@LITHORITE_PEAKS@NAME_OVERRIDE_04"
msgstr "The Mirrorcrest"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@RAGING_VOLCANO@DESCRIPTION"
msgstr "<<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacent to this Landmark gain:[bulletlist][bullet/]{income}.[bullet/]The {combatproperty} <<m:{GLOBAL.CombatEnchantmentConcept.Hyperlink}>>.[bullet/]<<m{GLOBAL.UnitConcept.Hyperlink}>> in the Province gain {GLOBAL.PROPERTIES.VOLCANIC_HEAT_UNIT_PROPERTY.Hyperlink}.[/bulletlist][br/]A {GLOBAL.CityConcept.Hyperlink} with {amount} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacent to this Landmark gains:[bulletlist][bullet/]Unlock recruitment of {GLOBAL.PROPERTIES.INFERNAL_FIEND.Hyperlink} and {GLOBAL.UNITS.MAGMA_SPIRIT.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>>.[/bulletlist]"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@RAGING_VOLCANO@LORE"
msgstr "\"One need only witness what devastation volcanoes precipitate to understand its arcane potential... And mythical allure. Some propose these fiery chasms serve as portals to {GLOBAL.ObbadothLoreConcept.Hyperlink}. I have yet to confirm whether the fiends encountered here emerged from the molten heart itself, or if they have simply claimed it as their home.\"[br/][br/]— Larissa Mirabilis, Myth and Truth: Folklore and its Arcane Origins"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@RAGING_VOLCANO@NAME"
msgstr "Infernal Volcano"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@RAGING_VOLCANO@NAME_OVERRIDE_01"
msgstr "Pyremaw Peak"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@RAGING_VOLCANO@NAME_OVERRIDE_02"
