msgid "DLC@WAYSOFWAR@UNITS_OATHSWORN@ABILITY16@BRAVERY_NAME"
msgstr "Paragon of Strife"

msgid "DLC@WAYSOFWAR@UNITS_OATHSWORN@ABILITY16@NAME"
msgstr "Sworn Paragon"

msgid "DLC@WAYSOFWAR@UNITS_OATHSWORN@ABILITY16@RIGHTEOUSNESS_DESCRIPTION"
msgstr "At {GLOBAL.Devotion3Concept.Hyperlink} level {GLOBAL.DevotionConcept.Hyperlink}, gain the {GLOBAL.PROPERTIES.RENDING_SLASH.Hyperlink} ability."

msgid "DLC@WAYSOFWAR@UNITS_OATHSWORN@ABILITY16@RIGHTEOUSNESS_NAME"
