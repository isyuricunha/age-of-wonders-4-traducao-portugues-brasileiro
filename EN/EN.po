msgid "ADVICE@LOWSTABILITY_REMINDER@DESCRIPTION"
msgstr "{LowStabCity.Name} has low {GLOBAL.CityStabilityConcept.Hyperlink}.[br/][br/] Stability dictates how much control you have over a {GLOBAL.CityConcept.Hyperlink}. The higher the stability, the better the bonus. With negative stability, also comes troublesome events, like {GLOBAL.CityStabilityUnrest.Hyperlink} or {GLOBAL.CityStabilityRioting.Hyperlink}.[br/][br/] Each {GLOBAL.ProvinceImprovementConcept.Hyperlink} decreases the amount of stability by a small amount. Some <<m:{GLOBAL.CityStructureConcept.Hyperlink}>>, such as a tavern, increase stability."

msgid "ADVICE@LOWSTABILITY_REMINDER@INSTRUCTION"
msgstr "Select to go to {LowStabCity.Name}"

msgid "ADVICE@LOWSTABILITY_REMINDER@TITLE"
msgstr "{LowStabCity.Name} has low stability"

