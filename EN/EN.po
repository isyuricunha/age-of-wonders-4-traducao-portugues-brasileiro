msgstr "Gain the {GLOBAL.PROPERTIES.COSMOS_MANIFEST.Hyperlink} passive."

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@ASCENSION_TRAIT@COSMOS_CHOSEN@HERO_TRAIT_NAME"
msgstr "Ascension: Cosmos Chosen"

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@ASCENSION_TRAIT@FIELD_ABJURER@HERO_TRAIT_DESCRIPTION"
msgstr "Non-hero units in your army have:[bulletlist][bullet/]When this unit's total <<m:{GLOBAL.HitPointConcept.Hyperlink}>> reach {FIELD_ABJURER_UNIT>ResolvedTriggerProportion}% or lower, gain {amount} {GLOBAL.PROPERTIES.GRACE.Hyperlink}.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@ASCENSION_TRAIT@FIELD_ABJURER@HERO_TRAIT_NAME"
msgstr "Ascension: Field Abjurer"

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@ASCENSION_TRAIT@FIELD_ABJURER@HERO_TRAIT_PROP_DESCRIPTION"
msgstr "When this unit's total <<m:{GLOBAL.HitPointConcept.Hyperlink}>> reach {FIELD_ABJURER_UNIT>ResolvedTriggerProportion}% or lower, gain {amount} {GLOBAL.PROPERTIES.GRACE.Hyperlink}."

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@ASCENSION_TRAIT@FIELD_ABJURER@NAME"
msgstr "Field Abjurer"

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@ASCENSION_TRAIT@FIELD_ABJURER@PROP_NAME"
msgstr "Field Abjurer's Boon"

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@ASCENSION_TRAIT@FIERY_SEDUCTOR@HERO_TRAIT_DESCRIPTION"
msgstr "[bulletlist][bullet/]Gain the {GLOBAL.PROPERTIES.KISS_OF_SEDUCTION.Hyperlink} ability.[bullet/]Attacks gain +{FIERY_SEDUCTOR_EXTRA_DMG>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}. Increased for Single Shot.[bullet/]Gain +{FIERY_SEDUCTOR_FIRE_RESISTANCE>REDUCTION>Fire} {GLOBAL.FireResistanceConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@ASCENSION_TRAIT@FIERY_SEDUCTOR@HERO_TRAIT_NAME"
msgstr "Ascension: Fiery Seductor"

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@ASCENSION_TRAIT@FIERY_SEDUCTOR@NAME"
msgstr "Fiery Seductor"

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@ASCENSION_TRAIT@LIVING_SPIDER_NEST@HERO_TRAIT_DESCRIPTION"
msgstr "[bulletlist][bullet/]When this unit's total <<m:{GLOBAL.HitPointConcept.Hyperlink}>> reach {LIVING_SPIDER_NEST_THRESHOLD_60>ResolvedTriggerProportion}% or lower, conjure a Tier {tier2} {GLOBAL.PROPERTIES.SPIDER.Hyperlink}.[bullet/]When this unit's total <<m:{GLOBAL.HitPointConcept.Hyperlink}>> reach {LIVING_SPIDER_NEST_THRESHOLD_30>ResolvedTriggerProportion}% or lower, conjure a Tier {tier2} {GLOBAL.PROPERTIES.SPIDER.Hyperlink}.[/bulletlist]{LOC.CONCEPT@SUMMON_LIVE_SHARED}[br/][br/]Additionally allows for the drafting of Tier {tier1} and Tier {tier2} Spiders in cities."

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@ASCENSION_TRAIT@LIVING_SPIDER_NEST@HERO_TRAIT_NAME"
msgstr "Ascension: Living Spider Nest"

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@ASCENSION_TRAIT@LIVING_SPIDER_NEST@NAME"
msgstr "Living Spider Nest"

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@ASCENSION_TRAIT@OVERLORDS_HUNGER@DESCRIPTION"
msgstr "[bulletlist][bullet/]Gain a permanent stack of {GLOBAL.PROPERTIES.GORGED.Hyperlink}:[bulletlist][bullet/]At the start of combat.[bullet/]When killing an enemy unit.[/bulletlist][bullet/]Upon reaching {amount} stacks of {GLOBAL.PROPERTIES.GORGED.Hyperlink}, remove them and:[bulletlist][bullet/]Gain a permanent stack of {GLOBAL.PROPERTIES.DEMONIC_SATIATION.Hyperlink}.[bullet/]All friendly units within {IMPS_HUNGER_CIRCLE>AREA>Radius}-hexes:[bulletlist][bullet/]Heal {IMPS_HUNGER_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Gain {GLOBAL.PROPERTIES.GORGED.Hyperlink} if they have {GLOBAL.PROPERTIES.DEMONIC_HUNGER_PROPERTY_GROUP.Hyperlink}.[/bulletlist][/bulletlist][/bulletlist]"

