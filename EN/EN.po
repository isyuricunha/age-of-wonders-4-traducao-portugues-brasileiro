msgstr "Gain {GLOBAL.PROPERTIES.SAND_WALK.Hyperlink}, increasing world map movement speed on sand."

msgid "FORM_TRAITS@15@EFFECT_02@DESCRIPTION"
msgstr "Able to build <<m:{GLOBAL.FarmConcept.Hyperlink}>> on Sand terrain."

