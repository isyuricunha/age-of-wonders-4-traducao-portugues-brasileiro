msgid "DLC@SECRETSOFTHEARCHMAGES@SECRET_SPELLS@02@DESCRIPTION"
msgstr "Up to {amount} random <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> gain an Ice Age Hazard. At the start of the next turn those hazards expire and:[bulletlist][bullet/]Enemy units sustain {amountDamage} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Provinces are destroyed.[bullet/]The province:[bulletlist][bullet/]Gains {GLOBAL.SnowConcept.Hyperlink} and {GLOBAL.FrozenWasteConcept.Hyperlink}.[bullet/]Loses {GLOBAL.ChasmConcept.Hyperlink}, {GLOBAL.SwampConcept.Hyperlink}, {GLOBAL.AshlandsConcept.Hyperlink}, {GLOBAL.SandConcept.Hyperlink}, {GLOBAL.CavernFloorConcept.Hyperlink}, {GLOBAL.FungusFieldsConcept.Hyperlink}, and {GLOBAL.GloomTerrainConcept.Hyperlink}."

msgid "DLC@SECRETSOFTHEARCHMAGES@SECRET_SPELLS@02@DISPLAY_PROPERTY"
msgstr "When this hazard expires:[bulletlist][bullet/]Enemy units sustain {amountDamage} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Provinces are destroyed.[bullet/]The province:[bulletlist][bullet/]Gains {GLOBAL.SnowConcept.Hyperlink} and {GLOBAL.FrozenWasteConcept.Hyperlink}.[bullet/]Loses {GLOBAL.ChasmConcept.Hyperlink}, {GLOBAL.SwampConcept.Hyperlink}, {GLOBAL.AshlandsConcept.Hyperlink}, {GLOBAL.SandConcept.Hyperlink}, {GLOBAL.CavernFloorConcept.Hyperlink}, {GLOBAL.FungusFieldsConcept.Hyperlink}, and {GLOBAL.GloomTerrainConcept.Hyperlink}."

msgid "DLC@SECRETSOFTHEARCHMAGES@SECRET_SPELLS@02@NAME"
