msgstr "[temphp/] Temporary Hit Point"

msgid "CONCEPT@UNIT_MORALE@DESCRIPTION"
msgstr "{GLOBAL.UnitConcept.Hyperlink} Morale represents willingness to battle.[br/][bulletlist][bullet/]High Morale increases {GLOBAL.CriticalHitChanceConcept.Hyperlink}.[bullet/]Low Morale increases {GLOBAL.FumbleConcept.Hyperlink} chance in battle and Desertion chance on the World Map.[bullet/]Very Low Morale further increases {GLOBAL.FumbleConcept.Hyperlink} chance and can lead to {GLOBAL.RoutingConcept.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> in battle and Desertion chance on the World Map .[/bulletlist][br/][br/]Morale States:[bulletlist][bullet/]{GLOBAL.HighMoraleConcept.Hyperlink}[bullet/]{GLOBAL.NeutralMoraleConcept.Hyperlink}[bullet/]{GLOBAL.LowMoraleConcept.Hyperlink}.[bullet/]{GLOBAL.VeryLowMoraleConcept.Hyperlink}[bullet/]{GLOBAL.RoutingConcept.Hyperlink}[/bulletlist]"

