msgid "DLC@GIANTKINGS@TOME_GEOMANCY@SKILL5@DESCRIPTION"
msgstr "City gains different resources based on the terrain features of the city core's location:[bulletlist][bullet/]+{amount1} {GLOBAL.FoodConcept.Hyperlink} if in Grasslands, Swamp or Fungus Fields.[bullet/]+{amount2} {GLOBAL.StructureProductionConcept.Hyperlink} if in Forest, Mushroom Forest, Rocky or Mountains.[bullet/]+{amount3} {GLOBAL.GoldConcept.Hyperlink} if in Ashlands.[bullet/]+{amount4} {GLOBAL.ManaConcept.Hyperlink} if in Snow, Ice or Sand.[/bulletlist]"

msgid "DLC@GIANTKINGS@TOME_GEOMANCY@SKILL5@NAME"
msgstr "Hall of Geomantic Resonance"

msgid "DLC@GIANTKINGS@TOME_GEOMANCY@TOME@DESCRIPTION"
msgstr "Become attuned to the Ley energies beneath you and use them to change the damage and resistances of your armies based on where they stand."

msgid "DLC@GIANTKINGS@TOME_GEOMANCY@TOME@LORE_DESCRIPTION"
msgstr "\"Geomancy taps into the earth's purest arcane connection. Plant your feet to feel the invisible Ley lines and connect to the Astral Flows that resonate below. Sense the subtle contrasts between sand and ash, rock and ice. Embrace these distinctions, become the crystal that resonates with this ancient song. Open yourself to the earth's magic and witness its boundless offerings.\""

msgid "DLC@GIANTKINGS@TOME_GEOMANCY@TOME@NAME"
msgstr "Tome of Geomancy"

msgid "DLC@GIANTKINGS@TOOLTIP@LANDMARK@DESCRIPTION"
msgstr "Landmarks are a type of location the size of an entire region. Landmarks themselves cannot be annexed or claimed. Instead, landmarks grant effects to all adjacent <<m:{GLOBAL.ProvinceConcept.Hyperlink}>>.[br/][br/]If a {GLOBAL.CityConcept.Hyperlink} has a certain amount of provinces in their domain adjacent to one Landmark, they gain an additional bonus effect depending on the type of landmark.[br/][br/]Landmarks count as <<m:{GLOBAL.HandcraftedRegionConcept.Hyperlink}>>, meaning they can be disabled with the Untouched Realm Trait."

msgid "DLC@GIANTKINGS@TOOLTIP@LANDMARK@HYPERLINK"
msgstr "[hyperlink,GLOBAL.LandmarkConcept]Landmark[/hyperlink]"

msgid "DLC@GIANTKINGS@TOOLTIP@LANDMARK@TITLE"
msgstr "Landmark"

msgid "DLC@GIANTKINGS@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@ETERNAL_COUNCIL@HYPERLINK"
msgstr "[hyperlink,GLOBAL.EternalCouncilConcept]Council Prolocutor[/hyperlink]"

msgid "DLC@GIANTKINGS@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@GIANT_KING@DESCRIPTION"
msgstr "{LOC.DLC@GIANTKINGS@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@GIANT_KING@DESCRIPTION_SHORT}[br/][bulletlist][bullet/]Capital city starts with {GLOBAL.STRUCTURE_UPGRADES.WIZARD_TOWER_ITEM_FORGE.Hyperlink}.[bullet/]Has access to a Runestele spell that slowly alters terrain to the Giant's preference.[bullet/]Gains economic bonuses from preferred terrain.[bullet/]Giant Kings are <<m:{GLOBAL.PROPERTIES.HEROTRAIT_GOVERNANCE_GIANT_GOVERNOR_ROCK.Hyperlink}>>.[bullet/]Giant Kings have a {amount2} {GLOBAL.ManaConcept.Hyperlink} {GLOBAL.UnitUpkeepConcept.Hyperlink} and cannot equip Mount items.[/bulletlist]"

msgid "DLC@GIANTKINGS@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@GIANT_KING@DESCRIPTION_SHORT"
msgstr "[helpcolor]A formidable Giant who harnesses the elemental force of the Fire, Rock, Storm, or Frost Clan to refashion realms.[/helpcolor]"

msgid "DLC@GIANTKINGS@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@GIANT_KING_FIRE@DESCRIPTION"
msgstr "{LOC.DLC@GIANTKINGS@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@GIANT_KING_FIRE@DESCRIPTION_SHORT}[br/][bulletlist][bullet/]Capital city starts with {GLOBAL.STRUCTURE_UPGRADES.WIZARD_TOWER_ITEM_FORGE.Hyperlink}.[bullet/]Has the {GLOBAL.SPECIAL_OPERATIONS.LAVA_FLOW.Hyperlink} spell.[bullet/]Can build <<m:{GLOBAL.FarmConcept.Hyperlink}>> on Ashlands.[bullet/]Provinces with Lava or Lava Chasms provide +{amount} {GLOBAL.StructureProductionConcept.Hyperlink} and don't apply the extra {GLOBAL.CityStabilityConcept.Hyperlink} penalty normally found in these.[bullet/]Giant Kings are <<m:{GLOBAL.PROPERTIES.HEROTRAIT_GOVERNANCE_GIANT_GOVERNOR_FIRE.Hyperlink}>>.[bullet/]Giant Kings have a {amount2} {GLOBAL.ManaConcept.Hyperlink} {GLOBAL.UnitUpkeepConcept.Hyperlink} and cannot equip Mount items.[/bulletlist]"

msgid "DLC@GIANTKINGS@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@GIANT_KING_FIRE@DESCRIPTION_SHORT"
msgstr "[helpcolor]A searing Giant who cleaves realms by molding lava.[/helpcolor]"

msgid "DLC@GIANTKINGS@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@GIANT_KING_FIRE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.FireGiantKingConcept]Fire Giant King[/hyperlink]"

msgid "DLC@GIANTKINGS@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@GIANT_KING_FROST@DESCRIPTION"
msgstr "{LOC.DLC@GIANTKINGS@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@GIANT_KING_FROST@DESCRIPTION_SHORT}[br/][bulletlist][bullet/]Capital city starts with {GLOBAL.STRUCTURE_UPGRADES.WIZARD_TOWER_ITEM_FORGE.Hyperlink}.[bullet/]Has the {GLOBAL.SPECIAL_OPERATIONS.SUMMON_ICE_RUNESTELE.Hyperlink} spell.[bullet/]Can build <<m:{GLOBAL.FarmConcept.Hyperlink}>> on Snow.[bullet/]Provinces with Snow or Ice provide +{amount} {GLOBAL.ManaConcept.Hyperlink}.[bullet/]Giant Kings are <<m:{GLOBAL.PROPERTIES.HEROTRAIT_GOVERNANCE_GIANT_GOVERNOR_FROST.Hyperlink}>>.[bullet/]Giant Kings have a {amount2} {GLOBAL.ManaConcept.Hyperlink} {GLOBAL.UnitUpkeepConcept.Hyperlink} and cannot equip Mount items.[/bulletlist]"

msgid "DLC@GIANTKINGS@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@GIANT_KING_FROST@DESCRIPTION_SHORT"
msgstr "[helpcolor]An icy Giant who freezes realms by shaping glaciers.[/helpcolor]"

msgid "DLC@GIANTKINGS@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@GIANT_KING_FROST@HYPERLINK"
msgstr "[hyperlink,GLOBAL.FrostGiantKingConcept]Frost Giant King[/hyperlink]"

msgid "DLC@GIANTKINGS@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@GIANT_KING_STONE@DESCRIPTION"
msgstr "{LOC.DLC@GIANTKINGS@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@GIANT_KING_STONE@DESCRIPTION_SHORT}[br/][bulletlist][bullet/]Capital city starts with {GLOBAL.STRUCTURE_UPGRADES.WIZARD_TOWER_ITEM_FORGE.Hyperlink}.[bullet/]Has the {GLOBAL.SPECIAL_OPERATIONS.SHAPE_ROCK.Hyperlink} spell.[bullet/]Provinces with Mountains or Stalagmites provide +{amount} {GLOBAL.StructureProductionConcept.Hyperlink}.[bullet/]Giant Kings are <<m:{GLOBAL.PROPERTIES.HEROTRAIT_GOVERNANCE_GIANT_GOVERNOR_ROCK.Hyperlink}>>.[bullet/]Giant Kings have a {amount2} {GLOBAL.ManaConcept.Hyperlink} {GLOBAL.UnitUpkeepConcept.Hyperlink} and cannot equip Mount items.[/bulletlist]"

msgid "DLC@GIANTKINGS@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@GIANT_KING_STONE@DESCRIPTION_SHORT"
msgstr "[helpcolor]An adamant Giant who sculpts realms by raising mountains.[/helpcolor]"

msgid "DLC@GIANTKINGS@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@GIANT_KING_STONE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.StoneGiantKingConcept]Rock Giant King[/hyperlink]"

msgid "DLC@GIANTKINGS@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@GIANT_KING_STORM@DESCRIPTION"
msgstr "{LOC.DLC@GIANTKINGS@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@GIANT_KING_STORM@DESCRIPTION_SHORT}[br/][bulletlist][bullet/]Capital city starts with {GLOBAL.STRUCTURE_UPGRADES.WIZARD_TOWER_ITEM_FORGE.Hyperlink}.[bullet/]Has the {GLOBAL.SPECIAL_OPERATIONS.ABRADE_MOUNTAIN.Hyperlink} spell.[bullet/]Provinces with Rivers or Water provide +{amount} {GLOBAL.FoodConcept.Hyperlink} and +{amount2} {GLOBAL.ManaConcept.Hyperlink}.[bullet/]Giant Kings are <<m:{GLOBAL.PROPERTIES.HEROTRAIT_GOVERNANCE_GIANT_GOVERNOR.Hyperlink}>>.[bullet/]Giant Kings have a {amount3} {GLOBAL.ManaConcept.Hyperlink} {GLOBAL.UnitUpkeepConcept.Hyperlink} and cannot equip Mount items.[/bulletlist]"

msgid "DLC@GIANTKINGS@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@GIANT_KING_STORM@DESCRIPTION_SHORT"
msgstr "[helpcolor]A thunderous Giant who levels realms by flattening peaks.[/helpcolor]"

msgid "DLC@GIANTKINGS@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@GIANT_KING_STORM@HYPERLINK"
msgstr "[hyperlink,GLOBAL.StormGiantKingConcept]Storm Giant King[/hyperlink]"

msgid "DLC@GIANTKINGS@TRIGGER@TOOLTIP@ANCIENTWONDER_APE@AFFINITY_CHECK_MATERIUM@FAILURE"
msgstr "The Lithorine creatures resist your manipulations of their movement."

msgid "DLC@GIANTKINGS@TRIGGER@TOOLTIP@ANCIENTWONDER_APE@AFFINITY_CHECK_MATERIUM@HEADER"
msgstr "Disperse the Lithorine critters by hastening or slowing them:"

msgid "DLC@GIANTKINGS@TRIGGER@TOOLTIP@ANCIENTWONDER_APE@AFFINITY_CHECK_MATERIUM@SUCCESS"
msgstr "Some of the creatures are slowed, whereas others are hastened."

msgid "DLC@GIANTKINGS@TRIGGER@TOOLTIP@ANCIENTWONDER_APE@AFFINITY_CHECK_ORDER@FAILURE"
msgstr "Your army is not roused by your hollow words."

msgid "DLC@GIANTKINGS@TRIGGER@TOOLTIP@ANCIENTWONDER_APE@AFFINITY_CHECK_ORDER@HEADER"
msgstr "Inspire your army to stand tall against the gargantuan creature."

msgid "DLC@GIANTKINGS@TRIGGER@TOOLTIP@ANCIENTWONDER_APE@AFFINITY_CHECK_ORDER@SUCCESS"
msgstr "Your warriors close rank in unison with determination in their hearts."

msgid "DLC@GIANTKINGS@TRIGGER@TOOLTIP@ANCIENTWONDER_CULTISTS@AFFINITY_CHECK_NATURE@FAILURE"
msgstr "This primal power is beyond you."

msgid "DLC@GIANTKINGS@TRIGGER@TOOLTIP@ANCIENTWONDER_CULTISTS@AFFINITY_CHECK_NATURE@HEADER"
msgstr "Take away the primal energies that empower the cultists:"

msgid "DLC@GIANTKINGS@TRIGGER@TOOLTIP@ANCIENTWONDER_CULTISTS@AFFINITY_CHECK_NATURE@SUCCESS"
msgstr "You control the energies."

msgid "DLC@GIANTKINGS@TRIGGER@TOOLTIP@ANCIENTWONDER_CULTISTS@PRIMAL_CHECK_GIANT@FAILURE"
msgstr " You are not their Giant God."

msgid "DLC@GIANTKINGS@TRIGGER@TOOLTIP@ANCIENTWONDER_CULTISTS@PRIMAL_CHECK_GIANT@HEADER"
msgstr "Intimidate these giant worshipers:"

msgid "DLC@GIANTKINGS@TRIGGER@TOOLTIP@ANCIENTWONDER_CULTISTS@PRIMAL_CHECK_GIANT@SUCCESS"
msgstr "They cower before you."

msgid "DLC@GIANTKINGS@TRIGGER@TOOLTIP@ANCIENTWONDER_GIANT@AFFINITY_CHECK_NATURE@FAILURE"
msgstr "Your army trembles in the shadows of these giant adversaries."

msgid "DLC@GIANTKINGS@TRIGGER@TOOLTIP@ANCIENTWONDER_GIANT@AFFINITY_CHECK_NATURE@HEADER"
msgstr "Motivate your army to stand together:"

