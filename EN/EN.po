msgid "TOME_BEACON@ABILITY_1@DESCRIPTION"
msgstr "Base {CONVERT_RESISTANCE_CHECK>ResolvedStrength}% chance of making target non-{GLOBAL.HeroConcept.Hyperlink} enemy unit become {GLOBAL.PROPERTIES.DOMINATED.Hyperlink}, if unsuccessful, the unit sustains {amount} {GLOBAL.SpiritDamageConcept.Hyperlink} instead.[br/][br/]The unit enters {GLOBAL.DefenseModeConcept.Hyperlink} after use."

msgid "TOME_BEACON@ABILITY_1@ENHANCED_DESCRIPTION"
msgstr "Convert:[bulletlist][bullet/]Deals an additional {CONVERT_ENHANCED_DAMAGE>DAMAGE>Spirit}{GLOBAL.SpiritDamageConcept.Hyperlink}[bullet/]Has +{CONVERT_ENHANCED_RANGE>ADD>MaxRange}{GLOBAL.RangeConcept.Hyperlink}[/bulletlist]"

msgid "TOME_BEACON@ABILITY_1@ENHANCED_NAME"
msgstr "Enhanced Convert"

msgid "TOME_BEACON@ABILITY_1@MASTER_DESCRIPTION"
msgstr "Convert:[bulletlist][bullet/]Has +{CONVERT_MASTER_RANGE>ADD>OptimalRange}{GLOBAL.RangeConcept.Hyperlink}.[bullet/]Has {amount}{GLOBAL.TurnConcept.Hyperlink} cooldown.[/bulletlist]"

msgid "TOME_BEACON@ABILITY_1@MASTER_NAME"
msgstr "Champion Convert"

msgid "TOME_BEACON@ABILITY_1@NAME"
msgstr "Convert"

msgid "TOME_BEACON@HERO_SKILL@DESCRIPTION"
msgstr "[bulletlist][bullet/]Unit becomes {GLOBAL.PROPERTIES.FAITHFUL.Hyperlink}.[bullet/]Non-{GLOBAL.HeroConcept.Hyperlink} {GLOBAL.PROPERTIES.FAITHFUL.Hyperlink} units gain +{CHAMPION_OF_THE_FAITHFUL_MORALE_EFFECT>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink} at the start of battle.[/bulletlist]"

msgid "TOME_BEACON@HERO_SKILL@NAME"
msgstr "Champion of the Faithful"

msgid "TOME_BEACON@PASSIVE@DESCRIPTION"
msgstr "Your <<m:{GLOBAL.DiplomaticTokenConcept}>> grant +{amount} {GLOBAL.HouseInfluenceConcept.Hyperlink} per turn."

msgid "TOME_BEACON@PASSIVE@NAME"
msgstr "Preachers of the Beacon"

msgid "TOME_BEACON@SKILL1@DESCRIPTION"
msgstr "Summons a {GLOBAL.UNITS.LESSER_LIGHT_SPIRIT.Hyperlink} {GLOBAL.PROPERTIES.SUPPORT_UNIT.Hyperlink}."

msgid "TOME_BEACON@SKILL1@NAME"
msgstr "Summon Lesser Light Spirit"

msgid "TOME_BEACON@SKILL2@DESCRIPTION"
msgstr "Units recruited through {GLOBAL.RequestMilitaryAidConcept.Hyperlink} from the target {GLOBAL.PvEVassalConcept.Hyperlink} have {GLOBAL.PROPERTIES.FAITHFUL.Hyperlink}.[br/]Target Vassal city grants the player {amount} {GLOBAL.ManaConcept.Hyperlink} each {GLOBAL.TurnConcept}."

msgid "TOME_BEACON@SKILL2@NAME"
msgstr "Covenant of the Faith"

msgid "TOME_BEACON@SKILL3@DESCRIPTION"
msgstr "Summons a {GLOBAL.UNITS.BLESSED_SOUL.Hyperlink} {GLOBAL.PROPERTIES.SHIELD_UNIT.Hyperlink} that can rally your units and condemn the enemy."

msgid "TOME_BEACON@SKILL3@NAME"
msgstr "Summon Blessed Soul"

msgid "TOME_BEACON@SKILL5@DESCRIPTION"
msgstr "Grants enchanted units:[bulletlist][bullet/]{GLOBAL.PROPERTIES.FAITHFUL.Hyperlink}, which reduces {GLOBAL.UnitUpkeepConcept.Hyperlink}.[bullet/]+{MIGHTY_MEEK_RESISTANCE>Resistance} {GLOBAL.StatusResistanceConcept.Hyperlink}.[bullet/]+{MIGHTY_MEEK_COUNTING_TIER_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink} on attacks for each Unit Tier of the target.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_BEACON@SKILL5@MOD_DESCRIPTION"
msgstr "+{MIGHTY_MEEK_COUNTING_TIER_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink} for each Unit Tier of the target."

msgid "TOME_BEACON@SKILL5@NAME"
msgstr "Mighty Meek"

msgid "TOME_BEACON@SKILL5@PROPERTY_DESCRIPTION"
msgstr "Unit:[bulletlist][bullet/]Has {GLOBAL.PROPERTIES.FAITHFUL.Hyperlink}.[bullet/]Has +{MIGHTY_MEEK_RESISTANCE>Resistance} {GLOBAL.StatusResistanceConcept.Hyperlink}.[bullet/]Deals +{MIGHTY_MEEK_COUNTING_TIER_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink} on attacks for each Unit Tier of the target.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_BEACON@SKILL6@DESCRIPTION"
msgstr "Summons a {GLOBAL.UNITS.DIVINE_BEACON_UNIT.Hyperlink}. Upon casting and at the start of each turn, friendly units in a {DIVINE_BEACONS_GRACE_UNIT_TARGETER_CIRCLE>AREA>Radius}-hex radius:[bulletlist][bullet/]Heal +{DIVINE_BEACONS_GRACE_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Gain +{DIVINE_BEACONS_GRACE_MORALE_GAIN>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}.[/bulletlist]{LOC.CONCEPT@SUMMON_LIVE_SHARED}[br/][br/]{LOC.TACTICAL@ABILITY@NEVER_IN_WATER}"

msgid "TOME_BEACON@SKILL6@NAME"
msgstr "Conjure Divine Beacon"

msgid "TOME_BEACON@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Brings out the inner radiance of the {GLOBAL.PROPERTIES.FAITHFUL.Hyperlink} to smite enemies and bolster allies."

msgid "TOME_BEACON@TOME@LORE_AUTHOR"
msgstr "Sola the Pure, Exalted Human"

msgid "TOME_BEACON@TOME@LORE_DESCRIPTION"
msgstr "\"Faith, fervor, righteous glory: such things may spread like a holy flame, bringing the light of truth even to the eyes of your enemies! A true beacon of faith shines so brightly that it binds the very wounds of the faithful and instills doubt in the unfaithful, turning them on to the true path... your path.\""

msgid "TOME_BEACON@TOME@NAME"
msgstr "Tome of the Beacon"

msgid "TOME_BEACON@UNIT2@NAME"
msgstr "Divine Beacon^n"

msgid "TOME_BEACON@UNIT2_ABILITY@DESCRIPTION"
msgstr "Friendly units within {DIVINE_BEACONS_GRACE_UNIT_TARGETER_CIRCLE>AREA>Radius} hexes:[bulletlist][bullet/]Heal +{DIVINE_BEACONS_GRACE_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Gain {DIVINE_BEACONS_GRACE_MORALE_GAIN>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_BEACON@UNIT2_ABILITY@NAME"
msgstr "Divine Beacon's Grace"

msgid "TOME_BEACON@UNIT@NAME"
msgstr "Lightbringer^n"

msgid "TOME_BEASTS@PASSIVE@DESCRIPTION"
msgstr "<<m:{GLOBAL.PROPERTIES.ANIMAL.Hyperlink}>> have {amount} Rank."

msgid "TOME_BEASTS@PASSIVE@NAME"
msgstr "Sharpen Instincts"

msgid "TOME_CHAOS_CHANNELING@HERO_SKILL@DESCRIPTION"
msgstr "Enemy attackers within {CHAOTIC_REBUKE_MAGIC_EFFECT_SHIELD>MaxAttackerDistance} hexes have a base {chance}% chance of gaining a random status effect."

msgid "TOME_CHAOS_CHANNELING@HERO_SKILL@NAME"
msgstr "Chaotic Rebuke"

msgid "TOME_CHAOS_CHANNELING@PASSIVE@DESCRIPTION"
msgstr "Pillaging <<m:{GLOBAL.ProvinceConcept}>> grants {amount} {GLOBAL.ManaConcept}."

msgid "TOME_CHAOS_CHANNELING@PASSIVE@NAME"
msgstr "Extract Chaos"

msgid "TOME_CHAOS_CHANNELING@SKILL1@DESCRIPTION"
msgstr "[bulletlist][bullet/]Summons a full army of random non-Scout Tier I units that can be produced in a city on the target hex.[bullet/]If cast within an enemy {GLOBAL.ProvinceConcept.Hyperlink}, instantly pillages it.[/bulletlist]"

msgid "TOME_CHAOS_CHANNELING@SKILL1@NAME"
msgstr "Golden Horde"

msgid "TOME_CHAOS_CHANNELING@SKILL2@DESCRIPTION"
msgstr "All enemy units:[bulletlist][bullet/]Sustain {FAN_THE_INFERNO_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} that ignores {BREACHING>MODIFIERS>ResolvedResistance}% of {GLOBAL.ResistanceConcept.Hyperlink}.[bullet/]Are inflicted with {GLOBAL.PROPERTIES.BURNING.Hyperlink}.[/bulletlist]"

msgid "TOME_CHAOS_CHANNELING@SKILL2@NAME"
msgstr "Fan the Inferno"

msgid "TOME_CHAOS_CHANNELING@SKILL3@DESCRIPTION"
msgstr "Makes the target race the embodiment of fire, granting them:[bulletlist][bullet/]{SCION_OF_FLAME_DEFENSE>REDUCTION>Fire} {GLOBAL.FireResistanceConcept.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.VENGEFUL_FLAMES.Hyperlink}, which damages {GLOBAL.MeleeConcept.Hyperlink} attackers.[bullet/]{GLOBAL.PROPERTIES.FIERY_WAKE.Hyperlink}, which ignites flammable terrain such as <<m:{GLOBAL.FloraObstacleConcept.Hyperlink}>>.[bullet/]Immunity to {GLOBAL.PROPERTIES.BURNING.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.LAVA_WALK.Hyperlink}.[bullet/]<<m:{GLOBAL.CityConcept.Hyperlink}>> of this race ignore the {GLOBAL.CityStabilityConcept.Hyperlink} penalty from Chasm and Lava in their {GLOBAL.DomainConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CHAOS_CHANNELING@SKILL3@NAME"
msgstr "Scion of Flame"

msgid "TOME_CHAOS_CHANNELING@SKILL3@PROPERTY_DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]{SCION_OF_FLAME_DEFENSE>REDUCTION>Fire} {GLOBAL.FireResistanceConcept.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.VENGEFUL_FLAMES.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.FIERY_WAKE.Hyperlink}[bullet/]Immunity to {GLOBAL.PROPERTIES.BURNING.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.LAVA_WALK.Hyperlink}[/bulletlist]"

msgid "TOME_CHAOS_CHANNELING@SKILL4@DESCRIPTION"
msgstr "Whenever another unit dies in battle, enchanted unit gains:[bulletlist][bullet/]{GLOBAL.PROPERTIES.INFERNAL_MIGHT.Hyperlink} for {INFERNAL_BLAZE_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]+{DEMONIC_SIPHON_MORALE>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}.[/bulletlist][br/]Does not trigger on the death of <<m:{GLOBAL.PROPERTIES.COMBAT_SUMMON.Hyperlink}>>, {GLOBAL.PROPERTIES.TOWER_UNIT.Hyperlink}, and {GLOBAL.PROPERTIES.SIEGECRAFT_UNIT.Hyperlink} units."

msgid "TOME_CHAOS_CHANNELING@SKILL4@NAME"
msgstr "Demonic Siphon"

msgid "TOME_CHAOS_CHANNELING@SKILL4@PROPERTY_DESCRIPTION"
msgstr "Whenever another unit dies in battle, this unit gains:[bulletlist][bullet/]{GLOBAL.PROPERTIES.INFERNAL_MIGHT.Hyperlink} for {INFERNAL_BLAZE_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]+{DEMONIC_SIPHON_MORALE>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}.[br/][br/]Does not trigger on the death of <<m:{GLOBAL.PROPERTIES.COMBAT_SUMMON.Hyperlink}>>, {GLOBAL.PROPERTIES.TOWER_UNIT.Hyperlink}, and {GLOBAL.PROPERTIES.SIEGECRAFT_UNIT.Hyperlink} units.[/bulletlist]"

msgid "TOME_CHAOS_CHANNELING@SKILL4@PROP_DESCRIPTION"
msgstr "[bulletlist][bullet/]Attacks have +{amount} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.FIEND.Hyperlink} units gain +{INFERNAL_BLAZE_FIEND_CRIT>ResolvedCritChanceBonus}% critical chance.[bullet/]Can stack up to {amountStacks} times.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CHAOS_CHANNELING@SKILL4@PROP_NAME"
msgstr "Infernal Might"

msgid "TOME_CHAOS_CHANNELING@SKILL5@DESCRIPTION"
msgstr "Targets a city, and whenever you fight in that domain, a {GLOBAL.UNITS.GREMLIN_UNIT.Hyperlink} is summoned next to one of your units every {GLOBAL.TurnConcept.Hyperlink}.[br/]Up to {amount} <<m:{GLOBAL.UNITS.GREMLIN_UNIT.Hyperlink}>> can be summoned per battle."

msgid "TOME_CHAOS_CHANNELING@SKILL5@NAME"
msgstr "Gremlin Ambushers"

msgid "TOME_CHAOS_CHANNELING@SKILL5@PROP_DESCRIPTION"
msgstr "A {GLOBAL.UNITS.GREMLIN_UNIT.Hyperlink} is summoned next to one of the owner's units every {GLOBAL.TurnConcept.Hyperlink}."

msgid "TOME_CHAOS_CHANNELING@SKILL6@DESCRIPTION"
msgstr "Summons a non-{GLOBAL.PROPERTIES.FIEND.Hyperlink} Tier V {GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink} with Fire and Burning-related abilities on target hex."

msgid "TOME_CHAOS_CHANNELING@SKILL6@NAME"
msgstr "Summon Flame Incarnate"

msgid "TOME_CHAOS_CHANNELING@SKILL7@ABILITY_DESCRIPTION"
msgstr "Deal damage to units in a {FIRE_BOMB_TARGETER_CIRCLE>AREA>Radius}-hex radius."

msgid "TOME_CHAOS_CHANNELING@SKILL7@ABILITY_NAME"
msgstr "Fire Bomb"

msgid "TOME_CHAOS_CHANNELING@SKILL7@DESCRIPTION"
msgstr "Enchanted units gain:[bulletlist][bullet/]The {GLOBAL.PROPERTIES.FIRE_BOMB.Hyperlink} ability, which deals magical damage in an area.[bullet/]The damage of this ability increases with the unit's tier.[/bulletlist]"

msgid "TOME_CHAOS_CHANNELING@SKILL7@NAME"
msgstr "Flamer Focus"

msgid "TOME_CHAOS_CHANNELING@SKILL7@PROP_DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]The {GLOBAL.PROPERTIES.FIRE_BOMB.Hyperlink} ability.[/bulletlist]"

msgid "TOME_CHAOS_CHANNELING@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Become the master of chaos by exploiting your accumulated chaotic powers from previous {GLOBAL.ChaosConcept.Hyperlink} <<m:{GLOBAL.TomeConcept.Hyperlink}>>."

msgid "TOME_CHAOS_CHANNELING@TOME@LORE_AUTHOR"
msgstr "Karissa the Red, Mistress of Passions"

msgid "TOME_CHAOS_CHANNELING@TOME@LORE_DESCRIPTION"
msgstr "\"Embrace the chaos, and it will embrace you, too, and spread fervor to all you touch! A true agent of bedlam will see order and logic warped into madness and turmoil, twisted ever in their favor!\""

msgid "TOME_CHAOS_CHANNELING@TOME@NAME"
msgstr "Tome of Chaos Channeling"

msgid "TOME_CHAOS_LORD@HERO_SKILL@DESCRIPTION"
msgstr "Summons a random Tier I {GLOBAL.PROPERTIES.INFERNAL_FIEND.Hyperlink} whenever this unit kills another unit. There is a small chance a Tier II {GLOBAL.PROPERTIES.INFERNAL_FIEND.Hyperlink} will be summoned instead.[br/]Does not work in Water battles."

msgid "TOME_CHAOS_LORD@HERO_SKILL@NAME"
msgstr "Demonic Slaughter"

msgid "TOME_CHAOS_LORD@PASSIVE@DESCRIPTION"
msgstr "Replaces a Headlong Assault with an Unstoppable Assault, which:[bulletlist][bullet/]Deals more damage to the city's {GLOBAL.FortificationHealthConcept}.[bullet/]Does not lower the <<m:{GLOBAL.HitPointConcept}>> of your units.[bullet/]Does not cause your units to become {GLOBAL.PROPERTIES.EXHAUSTED.Hyperlink}.[/bulletlist]"

msgid "TOME_CHAOS_LORD@PASSIVE@NAME"
msgstr "Unstoppable Assault"

msgid "TOME_CHAOS_LORD@PASSIVE@PROPERTY@DESCRIPTION"
msgstr "Significantly speeds up a siege."

msgid "TOME_CHAOS_LORD@SKILL1@DESCRIPTION"
msgstr "Turns the target race into demonic beings, which grants them:[bulletlist][bullet/]The {GLOBAL.PROPERTIES.INFERNAL_FIEND.Hyperlink} unit type.[bullet/]{GLOBAL.PROPERTIES.FLYING_MOVEMENT.Hyperlink}, increasing mobility.[bullet/]{GLOBAL.PROPERTIES.FRENZY.Hyperlink}, increasing damage as they attack.[bullet/]<<m:{GLOBAL.CityConcept.Hyperlink}>> of this race ignore the {GLOBAL.CityStabilityConcept.Hyperlink} penalty from Chasm and Lava in their {GLOBAL.DomainConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CHAOS_LORD@SKILL1@NAME"
msgstr "Demonkin"

msgid "TOME_CHAOS_LORD@SKILL2@DESCRIPTION"
msgstr "All attacking units gain {GLOBAL.PROPERTIES.KILLING_MOMENTUM.Hyperlink} and {GLOBAL.PROPERTIES.HASTENED.Hyperlink} for {HASTENED_EFFECT_DESCRIPTION_3>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "TOME_CHAOS_LORD@SKILL2@NAME"
msgstr "Demonic Onslaught"

msgid "TOME_CHAOS_LORD@SKILL3@DESCRIPTION"
msgstr "[bulletlist][bullet/]After {turn} [turn/] in battle, {Number} enemy non-{GLOBAL.HeroConcept.Hyperlink} units are {GLOBAL.PROPERTIES.MIND_CONTROLLED} until the end of combat.[bullet/]The city suffers -{HappinessDebuff} {GLOBAL.CityStabilityConcept.Hyperlink} while it is besieged.[/bulletlist]"

msgid "TOME_CHAOS_LORD@SKILL3@NAME"
msgstr "Incite Rebellion"

msgid "TOME_CHAOS_LORD@SKILL4@DESCRIPTION"
msgstr "Summons an avatar of your {GLOBAL.LeaderConcept.Hyperlink} into a battle. The avatar has the same abilities as your Ruler and spawns with full <<m:{GLOBAL.ActionPointConcept.Hyperlink}>>. All <<m:{GLOBAL.PROPERTIES.FIEND.Hyperlink}>> gain +{AVATAR_OF_CHAOS_MORALE>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}.[br/][br/]{LOC.TACTICAL@ABILITY@NEVER_IN_WATER}[br/]Cannot be used in battles where your {GLOBAL.LeaderConcept.Hyperlink} is present."

msgid "TOME_CHAOS_LORD@SKILL4@NAME"
msgstr "Call Forth Avatar of Chaos"

msgid "TOME_CHAOS_LORD@SKILL5@NAME"
msgstr "Age of Chaos"

msgid "TOME_CHAOS_LORD@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Unleash chaos forces upon the world. Specialize in offensive buffs."

msgid "TOME_CHAOS_LORD@TOME@LORE_AUTHOR"
msgstr "Karissa the Red, Mistress of Passions"

msgid "TOME_CHAOS_LORD@TOME@LORE_DESCRIPTION"
msgstr "\"Delight in disorder! Thrive on turmoil! Your aura of chaos is like an insidious mist that warps reality and incites madness. The very land seems to tremble as you arrive, with beings from demonic realms taking notice. Be birthed in fire and blood, o Godir, and bring forth the Age of Chaos!\""

msgid "TOME_CHAOS_LORD@TOME@NAME"
msgstr "Tome of the Chaos Lord"

msgid "TOME_COLD_DARK@HERO_SKILL@DESCRIPTION"
msgstr "Base {GLOBAL.MagicConcept.Hyperlink} attacks have a base {BLINDED_RESISTANCE>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.BLINDED.Hyperlink}.[br/][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_COLD_DARK@HERO_SKILL@NAME"
msgstr "Blinding Magic"

msgid "TOME_COLD_DARK@PASSIVE@DESCRIPTION"
msgstr "Razing <<m:{GLOBAL.CityConcept}>> and pillaging <<m:{GLOBAL.ProvinceConcept}>> turns the {GLOBAL.ProvinceConcept} into an Arctic province."

msgid "TOME_COLD_DARK@PASSIVE@NAME"
msgstr "Frozen Ruins"

msgid "TOME_COLD_DARK@PASSIVE_FARMING@DESCRIPTION"
msgstr "Able to build <<m:{GLOBAL.FarmConcept.Hyperlink}>> on Snow terrain.[br/][br/]<<m:{GLOBAL.FarmConcept.Hyperlink}>> on Snow terrain gain +{amount} {GLOBAL.FoodConcept.Hyperlink} if your race has Arctic Adaptation."

msgid "TOME_COLD_DARK@PASSIVE_FARMING@NAME"
msgstr "Arctic Farming"

msgid "TOME_COLD_DARK@PASSIVE_STABILITY@DESCRIPTION"
msgstr "<<m:{GLOBAL.ProvinceConcept.Hyperlink}>> with Snow give +{amount} {GLOBAL.CityStabilityConcept.Hyperlink}."

msgid "TOME_COLD_DARK@PASSIVE_STABILITY@NAME"
msgstr "Snow Preference"

msgid "TOME_COLD_DARK@SKILL1@DESCRIPTION"
msgstr "Each turn, for {BLINDING_MIST_AUTO_SPELL>TimeToLive} <<m:{GLOBAL.TurnConcept}>>, all enemies:[bulletlist][bullet/]Sustain {WITHERING_MIST_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Have a base {BLINDED_RESISTANCE>ResolvedStrength}% chance of becoming {GLOBAL.PROPERTIES.BLINDED.Hyperlink} for {BLINDED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Have a base {WEAKENED_RESISTANCE>ResolvedStrength}% chance of becoming {GLOBAL.PROPERTIES.WEAKENED.Hyperlink} for {WEAKENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "TOME_COLD_DARK@SKILL1@NAME"
msgstr "Withering Mist"

msgid "TOME_COLD_DARK@SKILL1@PROPERTY@DESCRIPTION"
msgstr "Each turn, all enemies:[bulletlist][bullet/]Sustain {WITHERING_MIST_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Have a base {BLINDED_RESISTANCE>ResolvedStrength}% chance of becoming {GLOBAL.PROPERTIES.BLINDED.Hyperlink} for {BLINDED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Have a base {WEAKENED_RESISTANCE>ResolvedStrength}% chance of becoming {GLOBAL.PROPERTIES.WEAKENED.Hyperlink} for {WEAKENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "TOME_COLD_DARK@SKILL2@DESCRIPTION"
msgstr "Summon a {GLOBAL.UNITS.SNOW_SPIRIT.Hyperlink}, a {GLOBAL.PROPERTIES.MAGIC_FIGHTER.Hyperlink} with attacks that inflict {GLOBAL.PROPERTIES.FROZEN.Hyperlink}."

msgid "TOME_COLD_DARK@SKILL2@NAME"
msgstr "Summon Snow Spirit"

msgid "TOME_COLD_DARK@SKILL3@DESCRIPTION"
msgstr "Makes winter run through the target race's veins, granting them:[bulletlist][bullet/]{FROSTLING_TRANSFORMATION_DEFENSE>REDUCTION>Frost} {GLOBAL.FrostResistanceConcept.Hyperlink}.[bullet/]Immunity to {GLOBAL.PROPERTIES.FROZEN.Hyperlink}.[bullet/]+{FROSTLING_TRANSFORMATION_MORALE_BONUS_FROZEN_WASTE>MoraleBonus} {GLOBAL.UnitMoraleConcept.Hyperlink} while on cold terrain.[bullet/]{GLOBAL.PROPERTIES.ARCTIC_WALK.Hyperlink}, which allows them to traverse cold terrain faster.[/bulletlist]"

msgid "TOME_COLD_DARK@SKILL3@NAME"
msgstr "Frostling Transformation"

msgid "TOME_COLD_DARK@SKILL3@PROP_DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]{FROSTLING_TRANSFORMATION_DEFENSE>REDUCTION>Frost} {GLOBAL.FrostResistanceConcept.Hyperlink}.[bullet/]Immunity to {GLOBAL.PROPERTIES.FROZEN.Hyperlink}.[bullet/]+{FROSTLING_TRANSFORMATION_MORALE_BONUS_FROZEN_WASTE>MoraleBonus} {GLOBAL.UnitMoraleConcept.Hyperlink} while on cold terrain.[bullet/]{GLOBAL.PROPERTIES.ARCTIC_WALK.Hyperlink}.[/bulletlist]"

msgid "TOME_COLD_DARK@SKILL4@DESCRIPTION"
msgstr "Target that is leading an army gains {GLOBAL.PROPERTIES.UNIVERSAL_CAMOUFLAGE.Hyperlink} for its entire army for {turns} <<m:{GLOBAL.TurnConcept}>>."

msgid "TOME_COLD_DARK@SKILL4@NAME"
msgstr "Veil of Darkness"

msgid "TOME_COLD_DARK@SKILL4@PROPERTY@DESCRIPTION"
msgstr "The entire army gains {GLOBAL.PROPERTIES.UNIVERSAL_CAMOUFLAGE.Hyperlink}."

msgid "TOME_COLD_DARK@SKILL5@DESCRIPTION"
msgstr "Target friendly {GLOBAL.CityConcept.Hyperlink} gains:[bulletlist]Every {GLOBAL.TurnConcept.Hyperlink}, {amount} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> within or adjacent to the {GLOBAL.DomainConcept.Hyperlink}:[bulletlist][bullet/]Gain {GLOBAL.SnowConcept.Hyperlink} and {GLOBAL.FrozenWasteConcept.Hyperlink}.[bullet/]Lose {GLOBAL.ChasmConcept.Hyperlink}, {GLOBAL.SwampConcept.Hyperlink}, {GLOBAL.AshlandsConcept.Hyperlink}, {GLOBAL.SandConcept.Hyperlink}, {GLOBAL.CavernFloorConcept.Hyperlink}, {GLOBAL.FungusFieldsConcept.Hyperlink}, and {GLOBAL.GloomTerrainConcept.Hyperlink}.[/bulletlist][bullet/]Provinces in the domain with Snow or Ice provide +{resources} {GLOBAL.FoodConcept.Hyperlink} and +{resources} {GLOBAL.StructureProductionConcept.Hyperlink} income.[/bulletlist]"

msgid "TOME_COLD_DARK@SKILL5@NAME"
msgstr "Marching Winter"

msgid "TOME_COLD_DARK@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Spread Arctic terrain throughout the world and envelop your units with its power, so they may be empowered by its presence."

msgid "TOME_COLD_DARK@TOME@LORE_AUTHOR"
msgstr "Artica the Cold, Queen of the Frostlings"

msgid "TOME_COLD_DARK@TOME@LORE_DESCRIPTION"
msgstr "\"Light brings both warmth and hope. Snuff it out and you plunge your foes into cold, everlasting night! Rob them of comfort, shatter their hope, leave them with numb limbs and blinded eyes. Darkness will sap your enemies' will to fight, to win, to live!\""

msgid "TOME_COLD_DARK@TOME@NAME"
msgstr "Tome of the Cold Dark"

msgid "TOME_CREATOR@HERO_SKILL@DESCRIPTION"
msgstr "Unit grows in size and gains:[bulletlist][bullet/]{GLOBAL.PROPERTIES.LARGE_TARGET.Hyperlink}[bullet/]+{ANCIENT_OF_EARTH_STAT_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]+{ANCIEN_OF_EARTH_DAMAGE_MULTIPLIER>ResolvedMultiplier}% damage[/bulletlist][br/]Unit can no longer use a mount."

msgid "TOME_CREATOR@HERO_SKILL@DESCRIPTION_DRGON"
msgstr "Unit gains:[bulletlist][bullet/]+{ANCIENT_OF_EARTH_STAT_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]+{ANCIEN_OF_EARTH_DAMAGE_MULTIPLIER>ResolvedMultiplier}% damage[/bulletlist]"

msgid "TOME_CREATOR@HERO_SKILL@ES_NAME"
msgstr "Ancient One"

msgid "TOME_CREATOR@HERO_SKILL@NAME"
msgstr "Ancient of Earth"

msgid "TOME_CREATOR@PASSIVE@DESCRIPTION"
msgstr "Non-{GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink} units are produced with {amount} Rank."

msgid "TOME_CREATOR@PASSIVE@NAME"
msgstr "Legendary Forges"

msgid "TOME_CREATOR@SKILL1@SPELL2@DESCRIPTION"
msgstr "Target Mountain province becomes a Rocky province."

msgid "TOME_CREATOR@SKILL1@SPELL2@NAME"
msgstr "Lower Mountains"

msgid "TOME_CREATOR@SKILL2@DESCRIPTION"
msgstr "[bulletlist][bullet/]Summons a {GLOBAL.UNITS.EARTH_TITAN_UNIT.Hyperlink} onto the target unoccupied hex.[bullet/]All adjacent enemies lose their {GLOBAL.DefenseModeConcept.Hyperlink} and {GLOBAL.RetaliationConcept.Hyperlink}.[/bulletlist][br/][br/]{LOC.TACTICAL@ABILITY@NEVER_IN_WATER}"

msgid "TOME_CREATOR@SKILL2@NAME"
msgstr "Call the Titan of the Earth"

msgid "TOME_CREATOR@SKILL3@DESCRIPTION"
msgstr "[bulletlist][bullet/]All enemies sustain {TECTONIC_SHATTER_UNIT_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]All enemies have a base {STUNNED_RESISTANCE>ResolvedStrength}% chance of becoming {GLOBAL.PROPERTIES.STUNNED.Hyperlink}.[bullet/]All obstacles on the map have a {obstacles} chance of being destroyed.[/bulletlist]"

msgid "TOME_CREATOR@SKILL3@NAME"
msgstr "Tectonic Shatter"

msgid "TOME_CREATOR@SKILL4@DESCRIPTION"
msgstr "Grants enchanted units:[bulletlist][bullet/]{GLOBAL.PROPERTIES.NATURAL_REGENERATION_GROUP.Hyperlink}[bullet/]+{SHAPERS_TOUCH_STAT_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]+{SHAPERS_TOUCH_DEFENSE>REDUCTION>Shock} {GLOBAL.LightningResistanceConcept.Hyperlink}[/bulletlist]"

msgid "TOME_CREATOR@SKILL4@NAME"
msgstr "Shaper's Touch"

msgid "TOME_CREATOR@SKILL4@PROP_DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]{GLOBAL.PROPERTIES.NATURAL_REGENERATION_GROUP.Hyperlink}[bullet/]+{SHAPERS_TOUCH_STAT_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]+{SHAPERS_TOUCH_DEFENSE>REDUCTION>Shock} {GLOBAL.LightningResistanceConcept.Hyperlink}[/bulletlist]"

msgid "TOME_CREATOR@SKILL5@NAME"
msgstr "Age of Materium"

msgid "TOME_CREATOR@SKILL6@DESCRIPTION"
msgstr "[bulletlist][bullet/]At the start of the battle, all Wall obstacles are damaged.[bullet/]At the start of the battle, gain {amount} {GLOBAL.UNITS.EARTHSHATTER_ENGINE_UNIT.Hyperlink} units on the attacker's side until the end of battle.[bullet/]<<m:{GLOBAL.UNITS.EARTHSHATTER_ENGINE_UNIT.Hyperlink}>> are {GLOBAL.PROPERTIES.SIEGECRAFT_UNIT.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> with short range, area of effect attacks that can destroy obstacles and knock enemy units out of {GLOBAL.DefenseModeConcept.Hyperlink}.[bullet/]Only one type of Siegecraft unit can be brought into {GLOBAL.CombatConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CREATOR@SKILL6@NAME"
msgstr "Create Earthshatter Engines"

msgid "TOME_CREATOR@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Shape the world, summon slumbering titans, and become the master of the earth."

msgid "TOME_CREATOR@TOME@LORE_AUTHOR"
msgstr "Mother Mab, Goddess of Goblins"

msgid "TOME_CREATOR@TOME@LORE_DESCRIPTION"
msgstr "\"Those who master Materium stand above the world, razing and toppling lands at a whim, and harnessing the primordial forces of creation. The titans themselves shall walk with you, while the very essences of element and mineral take a knee. You are the Creator, a shaper of worlds.\""

msgid "TOME_CREATOR@TOME@NAME"
msgstr "Tome of the Creator"

msgid "TOME_CREATOR@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Targets all enemies within {SEISMIC_SLAM_UNIT_TARGETER_CIRCLE>AREA>Radius} hexes."

msgid "TOME_CREATOR@UNIT1@ABILITY1@NAME"
msgstr "Seismic Slam"

msgid "TOME_CREATOR@UNIT1@DESCRIPTION"
msgstr "Only obeying the command of the absolute masters of the earth, the Earth Titan is an unstoppable force and the embodiment of the earth's rage."

msgid "TOME_CREATOR@UNIT1@NAME"
msgstr "Earth Titan^n"

msgid "TOME_CREATOR@UNIT2@ABILITY1@DESCRIPTION"
msgstr "Enemy units in a {EARTH_TREMOR_UNIT_TARGETER_CIRCLE>AREA>Radius}-hex radius:[bulletlist][bullet/]Sustain damage[bullet/]Lose their {GLOBAL.DefenseModeConcept.Hyperlink}[bullet/]Lose {GLOBAL.RetaliationConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CREATOR@UNIT2@ABILITY1@NAME"
msgstr "Earth Tremor"

msgid "TOME_CREATOR@UNIT2@DESCRIPTION"
msgstr "Slow but strong siege engine capable of destroying whole sections of walls within moments."

msgid "TOME_CREATOR@UNIT2@NAME"
msgstr "Earthshatter Engine^n"

msgid "TOME_CRICIBLE@SKILL2@DEFENSE_DESCRIPTION"
msgstr "Adds Crucible Battlements obstacles in {GLOBAL.CombatConcept.Hyperlink} during a {GLOBAL.SiegeConcept.Hyperlink}.[br/][br/]Crucible Battlement obstacles grant {GLOBAL.RangedConcept.Hyperlink} and {GLOBAL.MagicConcept.Hyperlink} attacks:[bulletlist][bullet/]Deals {damage} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Sets affected hexes {GLOBAL.OnFireConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CRUCIBLE@HERO_SKILL@DESCRIPTION"
msgstr "[bulletlist][bullet/]Base attacks deal {METEOR_ARROWS_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} to the target and adjacent enemies.[bullet/]All attacks gain {GLOBAL.PROPERTIES.DEMOLISHER.Hyperlink}.[br/][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}[/bulletlist]"

msgid "TOME_CRUCIBLE@HERO_SKILL@MOD_DESCRIPTION"
msgstr "+{METEOR_ARROWS_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} to the target and adjacent enemies."

msgid "TOME_CRUCIBLE@HERO_SKILL@NAME"
msgstr "Meteor Strikes"

msgid "TOME_CRUCIBLE@PASSIVE@DESCRIPTION"
msgstr "[bulletlist][bullet/]Mines grant {amount} {GLOBAL.ManaConcept} income.[bullet/]Mines can now be built on <<m:{GLOBAL.ProvinceConcept}>> with a Lava or Chasm feature.[/bulletlist]"

msgid "TOME_CRUCIBLE@PASSIVE@NAME"
msgstr "Pyrosiphon Mining"

msgid "TOME_CRUCIBLE@SKILL1@DESCRIPTION"
msgstr "Target {GLOBAL.ProvinceConcept.Hyperlink}:[bulletlist][bullet/]If it contains an enemy {GLOBAL.ProvinceImprovementConcept.Hyperlink}, it will be [hyperlink,GLOBAL.PillagingConcept]Pillaged[/hyperlink].[bulletlist][bullet/]You will not gain its rewards or lose {GLOBAL.AlignmentConcept.Hyperlink}.[/bulletlist][bullet/]Enemy <<m:{GLOBAL.UnitConcept.Hyperlink}>> in the province sustain {damage} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]The province gains {GLOBAL.AshlandsConcept.Hyperlink}.[bullet/]The province loses {GLOBAL.RiverConcept.Hyperlink}, {GLOBAL.FertilePlainsConcept.Hyperlink}, {GLOBAL.SwampConcept.Hyperlink}, {GLOBAL.SnowConcept.Hyperlink}, {GLOBAL.FrozenWasteConcept.Hyperlink}, {GLOBAL.SandConcept.Hyperlink}, {GLOBAL.CavernFloorConcept.Hyperlink}, and {GLOBAL.GloomTerrainConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CRUCIBLE@SKILL1@NAME"
msgstr "Pyroclastic Eruption"

msgid "TOME_CRUCIBLE@SKILL2@DEFENSE_DESCRIPTION"
msgstr "Adds Crucible Battlements obstacles in {GLOBAL.CombatConcept.Hyperlink} during a {GLOBAL.SiegeConcept.Hyperlink}.[br/][br/]Crucible Battlement obstacles grant {GLOBAL.RangedConcept.Hyperlink} and {GLOBAL.MagicConcept.Hyperlink} attacks:[bulletlist][bullet/]Deals {damage} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Sets affected hexes {GLOBAL.OnFireConcept.Hyperlink}.[bullet/]Ignore {GLOBAL.ObscuredConcept.Hyperlink} on targets.[bullet/]{rangebonus} {GLOBAL.RangeConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CRUCIBLE@SKILL2@DESCRIPTION"
msgstr "{GLOBAL.CityBattlementStructureConcept.Hyperlink}[br/][bulletlist][bullet/]Battlements grant {GLOBAL.RangedConcept.Hyperlink} and {GLOBAL.MagicConcept.Hyperlink} attacks:[bulletlist][bullet/]Deals {damage}.[bullet/]Sets affected hexes {GLOBAL.OnFireConcept.Hyperlink}.[bullet/]Ignore {GLOBAL.ObscuredConcept.Hyperlink} on targets.[bullet/]{rangebonus} {GLOBAL.RangeConcept.Hyperlink}[/bulletlist][bullet/]The City ignores negative {GLOBAL.CityStabilityConcept.Hyperlink} penalties from annexing provinces with {GLOBAL.ChasmConcept.Hyperlink} or {GLOBAL.LavaConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CRUCIBLE@SKILL2@MARKER@DESCRIPTION"
msgstr "Base {GLOBAL.RangedConcept.Hyperlink} and {GLOBAL.MagicConcept.Hyperlink} attacks:[bulletlist][bullet/]Deal {damage} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Set the ground {GLOBAL.OnFireConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CRUCIBLE@SKILL2@MARKER@NAME"
msgstr "Immolating Runes"

msgid "TOME_CRUCIBLE@SKILL2@MODIFIER_DESCRIPTION"
msgstr "This unit was built in a City with the Fortified Crucible structure, making this unit's attacks deal {damage}."

msgid "TOME_CRUCIBLE@SKILL2@NAME"
msgstr "Crucible Battlements"

msgid "TOME_CRUCIBLE@SKILL2@UNLOCK@NAME"
msgstr "Crucible Battlements in Combat"

msgid "TOME_CRUCIBLE@SKILL3@DESCRIPTION"
msgstr "Targets a {LAVA_BURST_OBSTACLE_TARGETER_CIRCLE>AREA>Radius}-hex radius:[bulletlist][bullet/]All units sustain {LAVA_BURST_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]All units are inflicted with {GLOBAL.PROPERTIES.BURNING.Hyperlink}.[bullet/]All units are {GLOBAL.PROPERTIES.SLOWED.Hyperlink}.[bullet/]The ground is set {GLOBAL.OnFireConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CRUCIBLE@SKILL3@NAME"
msgstr "Lava Burst"

msgid "TOME_CRUCIBLE@SKILL4@DESCRIPTION"
msgstr "Up to {METEOR_SHOWER_AUTO_SPELL>MaxCastCount} random enemy units and enemies adjacent to those:[bulletlist][bullet/]Sustain {METEOR_SHOWER_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} and {METEOR_SHOWER_UNIT_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[/bulletlist][br/]This spell repeats at the start of each turn for the next {METEOR_SHOWER_AUTO_SPELL>TimeToLive} <<m:{GLOBAL.TurnConcept}>>."

msgid "TOME_CRUCIBLE@SKILL4@NAME"
msgstr "Meteor Shower"

msgid "TOME_CRUCIBLE@SKILL5@DESCRIPTION"
msgstr "Makes base attacks of enchanted units:[bulletlist][bullet/]Deal +{METEOR_ARROWS_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} to the target and adjacent enemies.[bullet/]Gain {GLOBAL.PROPERTIES.DEMOLISHER.Hyperlink}, making them able to destroy reinforced obstacles.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CRUCIBLE@SKILL5@MOD_DESCRIPTION"
msgstr "[bulletlist][bullet/]+{METEOR_ARROWS_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} to the target and adjacent enemies.[bullet/]Has {GLOBAL.PROPERTIES.DEMOLISHER.Hyperlink}[/bulletlist]"

msgid "TOME_CRUCIBLE@SKILL5@NAME"
msgstr "Meteor Imbuement"

msgid "TOME_CRUCIBLE@SKILL5@PROP_DESCRIPTION"
msgstr "Unit's base attacks have:[bulletlist][bullet/]+{METEOR_ARROWS_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} on the target and adjacent enemies.[bullet/]{GLOBAL.PROPERTIES.DEMOLISHER.Hyperlink}.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CRUCIBLE@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Bury your enemies in lava and shape the land using the destructive forces of both earth and fire."

msgid "TOME_CRUCIBLE@TOME@LORE_AUTHOR"
msgstr "Yaka, self-proclaimed God of Fire"

msgid "TOME_CRUCIBLE@TOME@LORE_DESCRIPTION"
msgstr "\"Is not magma a glorious spectacle to behold? A union of fire and earth streaming inexorably toward your enemies, swallowing them, bringing fiery death! The landscape itself is reshaped when it flows, with beautiful scars traced over the realm.\""

msgid "TOME_CRUCIBLE@TOME@NAME"
msgstr "Tome of the Crucible"

msgid "TOME_CRYOMANCY@PASSIVE@DESCRIPTION"
