msgid "CORE_SIEGEPROJECTS@HASTEFUL_ASSAULT@NAME"
msgstr "Headlong Assault"

msgid "CORE_SIEGEPROJECTS@RAIDING_PARTY@DESCRIPTION"
msgstr "[bulletlist][bullet/]When the walls are breached, gain {gold} per tier of the besieged City.[bullet/]When the walls are breached, you gain {alingment} {GLOBAL.AlignmentConcept.Hyperlink}.[/bulletlist]"

msgid "CORE_SIEGEPROJECTS@RAIDING_PARTY@MODIFIER"
msgstr "Used Raiding Party during a {GLOBAL.SiegeConcept.Hyperlink}"

msgid "CORE_SIEGEPROJECTS@RAIDING_PARTY@NAME"
msgstr "Raiding Party [reputation2/]"

msgid "CORE_SIEGEPROJECTS@SABOTAGE_SUPPORT@DESCRIPTION"
