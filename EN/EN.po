msgid "DLC@RISEFROMRUIN@PRIMAL_CHECK@AFTERMATH_EVENT_TSR@BUTTON"
msgstr "Try to engulf the essence of your fallen and contaminated [hp/] comrade."

msgid "DLC@RISEFROMRUIN@REALM_TRAIT@TSR_FRACTURED_TALES@DESCRIPTION"
msgstr "Long ago, this realm was home to some of the experiments of the {GLOBAL.UnmakersLoreConcept.Hyperlink}.[br/][bulletlist][bullet/]There are Fated Regions present on the map which offer quest chains exploring the present and past of {GLOBAL.TheFracturingLoreConcept.Hyperlink}.[bullet/]Gain <<m:{GLOBAL.ArtifactConcept.Hyperlink}>> when completing Fated Regions, which grant control over the {GLOBAL.CataclysmConcept.Hyperlink} that ravages this realm. Obtaining three of them will lead to a {GLOBAL.CataclysmVictoryConcept.Hyperlink}.[bullet/]Fated Regions are affected by {GLOBAL.PROPERTIES.WARDED_BY_FATE.Hyperlink}.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@REALM_TRAIT@TSR_FRACTURED_TALES@NAME"
msgstr "Echoes of The Fracturing"

msgid "DLC@RISEFROMRUIN@RELIC@ANTI_ESSENCE@DESCRIPTION"
msgstr "[bulletlist][bullet/]Unlocks the spell {GLOBAL.SPECIAL_OPERATIONS.MEND_FRACTURE.Hyperlink}.[bullet/]Unlocks the {GLOBAL.RaceTransformationConcept.Hyperlink} spell {GLOBAL.SPECIAL_OPERATIONS.FRACTURED_TRANSFORMATION.Hyperlink}.[bullet/]Unlocks the spell {GLOBAL.SPECIAL_OPERATIONS.DETONATE_INFESTATION_WINDS.Hyperlink}.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@RELIC@ANTI_ESSENCE@LORE"
msgstr "\"The blood taints the shore, of a home lost and sore[br/]Blood that carries the curse, that the Unmakers wore[br/]All they touched fell undone, all they touched fractured and tore[br/]The future, the land, our own; flesh, life, and more, more, more...\""

msgid "DLC@RISEFROMRUIN@RELIC@ANTI_ESSENCE@NAME"
msgstr "Anti Essence Elixir"

msgid "DLC@RISEFROMRUIN@RELIC@DETONATE_INFESTATION@SPELL@DESCRIPTION"
msgstr "Target {GLOBAL.STRUCTURES.FRACTURED_INFESTATION.Hyperlink} or {GLOBAL.STRUCTURES.FLEETING_FRACTURED_INFESTATION.Hyperlink} is destroyed, does not grant its rewards.[br/][br/]This spell does not contribute to the {GLOBAL.FracturingWindsConcept.Hyperlink} and cannot [hyperlink,GLOBAL.BackfireConcept]Backfire[/hyperlink]."

msgid "DLC@RISEFROMRUIN@RELIC@DETONATE_INFESTATION@SPELL@NAME"
msgstr "Detonate Infestation"

msgid "DLC@RISEFROMRUIN@RELIC@DIVERT_WINDS@SPELL@DESCRIPTION"
msgstr "Target {GLOBAL.ProvinceConcept.Hyperlink} that is marked to be struck by a {GLOBAL.CataclysmConcept.Hyperlink} loses its mark and will not be struck next Cataclysm.[br/][br/]This spell does not contribute to the {GLOBAL.FracturingWindsConcept.Hyperlink} and cannot [hyperlink,GLOBAL.BackfireConcept]Backfire[/hyperlink]."

msgid "DLC@RISEFROMRUIN@RELIC@DIVERT_WINDS@SPELL@NAME"
msgstr "Divert Devouring Winds"

msgid "DLC@RISEFROMRUIN@RELIC@ESSENCE_SHEATH@DESCRIPTION"
msgstr "[bulletlist][bullet/]Unlocks the spell {GLOBAL.SPECIAL_OPERATIONS.MEND_FRACTURE.Hyperlink}.[bullet/]Restoring a {GLOBAL.RuinedNodeConcept.Hyperlink} is {amount}% cheaper. Scales with the amount of [hyperlink,GLOBAL.ArtifactConcept]Artifacts[/hyperlink] of the {GLOBAL.UnmakersLoreConcept.Hyperlink} owned by the player.[bullet/]Receive additional {IntGoldAmount} {GLOBAL.GoldConcept.Hyperlink} and {IntProductionAmount} {GLOBAL.StructureProductionConcept.Hyperlink} in {GLOBAL.AstralBarrensConcept.Hyperlink} and {GLOBAL.SandConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@RELIC@ESSENCE_SHEATH@LORE"
msgstr "\"Ruins rise from the red sands, ghosts that still follow commands[br/]There is a siege frozen in time, yet only one side withstands[br/]Like a tapestry of our past, when we could call home these lost lands\""

msgid "DLC@RISEFROMRUIN@RELIC@ESSENCE_SHEATH@NAME"
msgstr "Essence Sheath^n"

msgid "DLC@RISEFROMRUIN@RELIC@MEND_FRACTURE@SPELL@DESCRIPTION"
msgstr "Decreases the {GLOBAL.FracturingWindsConcept.Hyperlink} value by {value}, temporarily reducing the chance of a {GLOBAL.CataclysmConcept.Hyperlink}.[br/]The cost of this spell is reduced based on the amount of [hyperlink,GLOBAL.ArtifactConcept]Artifacts[/hyperlink] of the {GLOBAL.UnmakersLoreConcept.Hyperlink} the caster has.[br/][br/]This spell does not contribute to the {GLOBAL.FracturingWindsConcept.Hyperlink} and cannot [hyperlink,GLOBAL.BackfireConcept]Backfire[/hyperlink]."

msgid "DLC@RISEFROMRUIN@RELIC@MEND_FRACTURE@SPELL@NAME"
msgstr "Mend Fracture"

msgid "DLC@RISEFROMRUIN@RELIC@WELLS_TEAR@SPELL@NAME"
msgstr "Tear Fracture"

msgid "DLC@RISEFROMRUIN@RELIC@WELLS_TEAR@SPELL@NAME2"
msgstr "Tear Fracture 2 Old"

msgid "DLC@RISEFROMRUIN@RELIC@WELL_TEAR@DESCRIPTION"
msgstr "[bulletlist][bullet/]Unlocks the spell {GLOBAL.SPECIAL_OPERATIONS.MEND_FRACTURE.Hyperlink}.[bullet/]Unlocks the spell {GLOBAL.SPECIAL_OPERATIONS.TEAR_FRACTURE.Hyperlink}.[bullet/]Unlocks the spell {GLOBAL.SPECIAL_OPERATIONS.IRRADIANT_FLARE.Hyperlink}.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@RELIC@WELL_TEAR@FLAG@DESCRIPTION"
msgstr "Units in this hex will be struck for {amount} {GLOBAL.PhysicalDamageConcept.Hyperlink} and have a {amount2}% base chance of receiving {GLOBAL.PROPERTIES.MANA_DRAINED.Hyperlink} at the start of the owner's [turn/] [hyperlink,GLOBAL.TurnConcept]Next Turn[/hyperlink]"

msgid "DLC@RISEFROMRUIN@RELIC@WELL_TEAR@LORE"
msgstr "\"Down in the underground, lies a place by doom bound[br/]Irradiating taint, contamination crowned[br/]Seek it not, there are secrets, better lost than found\""

msgid "DLC@RISEFROMRUIN@RELIC@WELL_TEAR@NAME"
msgstr "Tear of the Well^n"

msgid "DLC@RISEFROMRUIN@RELIC@WELL_TEAR@SPELL@DESCRIPTION"
msgstr "Target hex becomes marked, Units in {TEAR_FRACTURE_CIRCLE_TARGETER_DISRUPTED>AREA>Radius}-hex radius of the marked hex have a {amount1}% base chance of receiving {GLOBAL.PROPERTIES.DISRUPTION_TOOLTIP_PROPERTY.Hyperlink}. After {time} {GLOBAL.TurnConcept.Hyperlink}, the marked hex explodes and inflicts the following in a {TEAR_FRACTURE_CIRCLE_TARGETER_DISRUPTED>AREA>Radius}-hex radius:[bulletlist][bullet/]Units suffer {amount2} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Units have {amount3}% base chance of suffering {GLOBAL.PROPERTIES.MANA_DRAINED.Hyperlink}.[bullet/]Each hex has {amount4}% chance of creating a Mana Fracture obstacle, which have {GLOBAL.DrainingConcept.Hyperlink} and spread to adjacent hexes when spells are cast.[/bulletlist][br/][br/]This spell cannot [hyperlink,GLOBAL.BackfireConcept]Backfire[/hyperlink]."

msgid "DLC@RISEFROMRUIN@RELIC@WIND_ROSE@DESCRIPTION"
msgstr "[bulletlist][bullet/]Unlocks the spell {GLOBAL.SPECIAL_OPERATIONS.MEND_FRACTURE.Hyperlink}.[bullet/]Player gains {GLOBAL.BackfireTailwindsConcept.Hyperlink}.[bullet/]Unlocks the spell {GLOBAL.SPECIAL_OPERATIONS.DIVERT_DEVOURING_WINDS.Hyperlink}.[bullet/] All your <<m:{GLOBAL.UnitConcept.Hyperlink}>> gain {GLOBAL.PROPERTIES.SAND_WALK.Hyperlink}.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@RELIC@WIND_ROSE@LORE"
msgstr "\"Three Fractures devour, all magic and power[br/]Heed not the wind's murmur, from the gone Wizard's Tower[br/]Which whispers doomed secrets, of the world's darkest hour\""

msgid "DLC@RISEFROMRUIN@RELIC@WIND_ROSE@NAME"
msgstr "Devouring Wind Rose^n"

msgid "DLC@RISEFROMRUIN@RELIC_SET@HUBRIS_OF_THE_UNMAKERS@BONUS"
msgstr "Hubris of the Unmakers"

msgid "DLC@RISEFROMRUIN@RELIC_SET@HUBRIS_OF_THE_UNMAKERS@DESCRIPTION"
msgstr "The turn after collecting all Artifacts from this set, the Happening \"The Fracturing\" will trigger."

msgid "DLC@RISEFROMRUIN@RELIC_SET@TALES_OF_THE_FRACTURING@NAME"
msgstr "Tales of The Fracturing"

msgid "DLC@RISEFROMRUIN@RUINED_WONDER_EVENT_BUTTONS@TEMPLE_NEW_CREED"
msgstr "\"No more creeds. The very {EventStructure} [unit/] shall serve my designs.\" [evilact/]"

msgid "DLC@RISEFROMRUIN@RUINED_WONDER_EVENT_BUTTONS@TEMPLE_NEW_CREED@PROPERTY_TOOLTIP"
msgstr "<<CA:EventUnit>> gains {GLOBAL.PROPERTIES.BOON_STEALING_PROPERTY_GROUP.Hyperlink}."

msgid "DLC@RISEFROMRUIN@RUINED_WONDER_EVENT_BUTTONS@TEMPLE_SCROLLS_TERROR"
msgstr "Unleash [evilact/] the full potential of the scroll [unit/] and crumble the {EventStructure}."

msgid "DLC@RISEFROMRUIN@RUINED_WONDER_EVENT_BUTTONS@TEMPLE_SCROLLS_TERROR@GAIN_6_EVENTUNIT"
msgstr "You gain an army of 6 {EventUnit.Name} units that all have the {Trait.Name} trait."

msgid "DLC@RISEFROMRUIN@RUINED_WONDER_EVENT_BUTTONS@WELLSPRING_FAIRY_COURT"
msgstr "Sack [evilact/] [influence/] the {EventStructure}. Take their banquet [food/] and treasure. [gold/]"

msgid "DLC@RISEFROMRUIN@RUINED_WONDER_EVENT_BUTTONS@WELLSPRING_FROZEN_LAKE"
msgstr "Shatter the {EventStructure} to harness the secrets [knowledge/] of the ice. [mana/]"

msgid "DLC@RISEFROMRUIN@RUINED_WONDER_EVENT_BUTTONS@WELLSPRING_FROZEN_LAKE_KNOWLEDGE_ONLY"
msgstr "Shatter the {EventStructure} to harness the secrets [knowledge/] of the ice."

msgid "DLC@RISEFROMRUIN@RUINED_WONDER_EVENT_BUTTONS@WORLD_TREE_GUARDIAN"
msgstr "\"I now leech [evilact/] your life energy [hp/] and that of the {EventStructure}.\""

msgid "DLC@RISEFROMRUIN@RUINED_WONDER_EVENT_BUTTONS@WORLD_TREE_THUNDERED"
msgstr "Wield the <<G:lightning^n,EventUnit>> [mana/] to shatter the {EventStructure}. [structureprod/]"

msgid "DLC@RISEFROMRUIN@RUINED_WONDER_EVENT_BUTTONS@WORLD_TREE_THUNDERED_KNOWLEDGE"
msgstr "Wield the <<G:lightning^n,EventUnit>> [knowledge/] to shatter the {EventStructure}. [structureprod/]"

msgid "DLC@RISEFROMRUIN@SECTORDEFINITIONS_STRATEGIC@ASTRAL_BARRENS_FEATURE@DESCRIPTION"
msgstr "A {GLOBAL.ProvinceFeatureConcept.Hyperlink}.[br/][br/]These lands have been eroded by a wind that rips all forms of magic from everyone and everything.[br/][bulletlist][bullet/]{GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> do not regenerate <<m:{GLOBAL.HitPointConcept.Hyperlink}>> in this province.[bullet/]<<m:{GLOBAL.WorldMapSpellConcept.Hyperlink}>> and <<m:{GLOBAL.CombatSpellConcept.Hyperlink}>> cast in this province gain a {percentage} chance of {GLOBAL.BackfireConcept.Hyperlink}.[bullet/]No {GLOBAL.ManaConcept.Hyperlink} income can be gained from this Province.[bullet/]<<m:{GLOBAL.NodeConcept.Hyperlink}>> in the province become [hyperlink,GLOBAL.RuinedNodeConcept]Ruined[/hyperlink].[bullet/]Ruined Nodes cannot be restored while this province has Astral Barrens.[bullet/]Terrain cannot be altered by most spells and effects.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@SECTORDEFINITIONS_STRATEGIC@MAGIC_EROSION@DESCRIPTION"
msgstr "This unit is being affected from being in {GLOBAL.AstralBarrensConcept.Hyperlink} and therefore does not regenerate <<m:{GLOBAL.HitPointConcept.Hyperlink}>> in the world map."

msgid "DLC@RISEFROMRUIN@SECTORDEFINITIONS_STRATEGIC@MAGIC_EROSION@NAME"
