msgid "DLC@ARCHONPROPHECY@SPAWNERS_STRATEGIC@CALL_TO_CRUSADE@DESCRIPTION"
msgstr "Attempt to persuade the Infestation to fight somewhere else or crusade against an [reputation1/] [hyperlink,GLOBAL.AlignmentConcept]evil[/hyperlink] {GLOBAL.EmpireConcept.Hyperlink} you are at [rs_war/] War with, which removes this Crusader Host permanently.[br/][br/]The Infestation must be {GLOBAL.InfestationNeutralityConcept.Hyperlink} to you to use this option."

msgid "DLC@ARCHONPROPHECY@SPAWNERS_STRATEGIC@CRUSADER_HOST@DESCRIPTION"
msgstr "Devotees and celestials gather to vanquish evil.[br/]If left unchecked, they will grow in strength, expand their territory, and send out invasion armies.[br/][br/]This Infestation will be {GLOBAL.InfestationNeutralityConcept.Hyperlink} to those with {GLOBAL.PROPERTIES.GOOD_2_UNIT_PROPERTY.Name} or better {GLOBAL.AlignmentConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@SPAWNERS_STRATEGIC@CRUSADER_HOST@LORE"
msgstr "If walls could talk, the cracks in this structure would whisper the chronicles of the crusades against Urrath. After ages of strife, this Crusader Host still stands unshaken, serving as a meeting ground for the [hyperlink,GLOBAL.ArchonsLoreConcept]Archons[/hyperlink] and other champions of light. Yet the Crusaders' duty is not limited to the Umbral infestations; their honor compels them to raise their swords against all who rule through evil."

msgid "DLC@ARCHONPROPHECY@SPAWNERS_STRATEGIC@CRUSADER_HOST@NAME"
msgstr "Crusader Host"

msgid "DLC@ARCHONPROPHECY@STACKENCOUNTER_EVENTS@CRUSADER_HOST@DESTROY_PREDICTION"
msgstr "The Crusader Host will be removed permanently."

msgid "DLC@ARCHONPROPHECY@STACKENCOUNTER_EVENTS@CRUSADER_HOST@PREDICTION"
msgstr "Immediately spawns {amount} {GLOBAL.MarauderConcept.Hyperlink} <<m:{GLOBAL.ArmyConcept.Hyperlink}>> that will travel to and attack <<g:Empire^n,TargetRuler>>."

msgid "DLC@ARCHONPROPHECY@STACKENCOUNTER_EVENTS@CRUSADER_HOST@PREDICTION_UMBRAL"
msgstr "Immediately spawns {amount} {GLOBAL.MarauderConcept.Hyperlink} <<m:{GLOBAL.ArmyConcept.Hyperlink}>> next to the {GLOBAL.UmbralDwellingConcept.Hyperlink} and will attempt to capture it."

msgid "DLC@ARCHONPROPHECY@STACKENCOUNTER_EVENTS@CRUSADER_HOST@REQUIREMENT"
msgstr "You must be [reputation8/] [hyperlink,GLOBAL.AlignmentConcept]Pure Good[/hyperlink] to convince them."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1004@BODY_FOOTER"
msgstr "The world returns to normal when your vision ends. Yet still you laugh. For it is you who will ruin the world."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1004@BODY_HEADER"
msgstr "Donning the mask of the maniacal mage, you see the hidden magical connections in the world. Powers surges through you."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1004@BODY_LORE"
msgstr "You extend your hand, and lightning jumps from your fingertips. You laugh. It scorches your enemies and amplifies the power of your {EventRace}. The more spells you cast, the stronger you become. You laugh. The world bows before your arcane supremacy. {GLOBAL.GodirLoreConcept.Hyperlink} bow. <<m: {GLOBAL.MagicMaterialConcept.Hyperlink}>> fuse to your body. <<m:{GLOBAL.AncientWonderConcept.Hyperlink}>> reveal their ancient secrets to you. You laugh."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1004@BUTTON_0"
msgstr "\"I will herald an Age of Magic!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1004@REWARD"
msgstr "Gain {amount}{GLOBAL.ManaConcept.Hyperlink} per turn."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1004@TITLE"
msgstr "Desolations of Magic"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1005@BODY_FOOTER"
msgstr "All you remember are the unending strands of arcane power. You have become Magic, Consumer of Worlds."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1005@BODY_HEADER"
msgstr "The deed is done. The devastation of the realm is complete. And you were the architect of its destruction."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1005@BODY_LORE"
msgstr "While your {EventRace} revel in the destruction and chaos in the realm, you try to remember the world as it once was. But images of the days before your reaping are gone."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1005@BUTTON_0"
msgstr "\"Now is my time. The Age of Magic.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1005@REWARD"
msgstr "All Rulers can cast an additional spell per turn in combat."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1005@REWARD2"
msgstr "Your spells cost {percentage}% less <<m:{GLOBAL.WorldMapCastingPointConcept.Hyperlink}>> and <<m:{GLOBAL.CombatCastingPointConcept.Hyperlink}>>."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1005@TITLE"
msgstr "Age of Magic"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1008@BODY_FOOTER"
msgstr "The vision ends there. The world returns to normal. Your path is clear. You and your {EventRace} shall ruin the world."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1008@BODY_HEADER"
msgstr "Donning the mask of the snarling general, the world is set ablaze. A bloodthirst overcomes you. Your snarl becomes a grin."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1008@BODY_LORE"
msgstr "A restless power swells within you. You discover an axe and sword in your hands. Countless enemies assail you from all sides. Peasants and princes. Mages and <<m:{GLOBAL.HeroConcept.Hyperlink}>>. Even {GLOBAL.GodirLoreConcept.Hyperlink}. You sing and laugh as you mow them all down like wheat during harvest. You bellow as your banners unfurl in their fallen cities. Your frenzied {EventRace} chant your name. The carnelian war mask and your face are one and the same."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1008@BUTTON_0"
msgstr "\"I will herald an Age of War!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1008@REWARD"
msgstr "Your {GLOBAL.ThroneCityConcept.Hyperlink} gains {amount}{GLOBAL.UnitProductionConcept.Hyperlink} per turn."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1008@TITLE"
msgstr "Desolations of War"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1009@BODY_FOOTER"
msgstr "All you remember is the eternal tides of battles. You have become War, Executioner of Worlds."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1009@BODY_HEADER"
msgstr "The necessary work is done. The devastation of the realm is complete. And you were the architect of its destruction."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1009@BODY_LORE"
msgstr "While your {EventRace} revel in the destruction and chaos in the realm, you try to remember the world as it once was. But images of the days before your reaping are gone."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1009@BUTTON_0"
msgstr "Now is your time: the Age of War."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1009@TITLE"
msgstr "Age of War"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1016@BODY_FOOTER"
msgstr "Your vision ends and the world returns to normal. Your path is clear. You and your {EventRace} shall ruin the world."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1016@BODY_HEADER"
msgstr "Donning the mask of the weeping grave keeper, the world grows dark and cold. An eerie silence descends on the lands."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1016@BODY_LORE"
msgstr "Among countless lifeless <<m:{GLOBAL.CityRuinConcept.Hyperlink}>>, only your {EventRace} thrive. The fields are sown with the bones of your rivals, crushed under the decaying feet of ravaging Undead. You feel Death's hand on your shoulder. You turn to face <<P:PlayerLeader>> and see that you are both wearing the same obsidian mask. You simultaneously remove your masks to discover that the face of Death is yours."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1016@BUTTON_0"
msgstr "\"I will herald an Age of Death!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1016@REWARD"
msgstr "Gain {amount}{GLOBAL.SoulConcept.Hyperlink} per turn."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1016@TITLE"
msgstr "Desolations of Death"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1017@BODY_FOOTER"
msgstr "All you remember are endless fields of corpses. You have become Death, Destroyer of Worlds."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1017@BODY_HEADER"
msgstr "The deed is done. The devastation of the realm is complete. And you were the architect of its destruction."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1017@BODY_LORE"
msgstr "While your {EventRace} revel in the destruction and chaos in the realm, you try to remember the world as it once was. But images of the days before your reaping are gone."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1017@BUTTON_0"
msgstr "Now is your time: the Age of Death."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1017@REWARD"
msgstr "{GLOBAL.PROPERTIES.AGE_OF_DEATH.Hyperlink} is now active during all battles, with {PlayerLeader.Name} as the Prophet."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1017@SOULS_INCOME_REWARD"
msgstr "As the Prophet, you gain +{Soulsincome} <<m:{GLOBAL.SoulConcept.Hyperlink}>> per [turn/] turn."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1017@TITLE"
msgstr "Age of Death"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1018@BODY_FOOTER"
msgstr "That is the branch you must follow. Which voice, which color, does your heart elect? Where does your destiny lie?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1018@BODY_HEADER"
msgstr "As you prepare your strategy for ruling this new realm, the world around you gives way to the vision of a World Tree."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1018@BODY_LORE"
msgstr "You climb the kaleidoscopic Tree of unprecedented vastness. It is the Cosmic Tree: its branches extend endlessly towards all poles of the {GLOBAL.AstralSeaLoreConcept.Hyperlink}. Whispers, songs, and shouts call and beckon you. Some friendly. Some harsh. Some seductive. They all know your name. Yet you realize that there is one color—one branch—that harbors the destiny of your {EventRace}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1018@BUTTON_0"
msgstr "[order/] Follow the golden branch towards the chanting."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1018@BUTTON_1"
msgstr "[chaos/] Follow the crimson branch towards the loud laughter."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1018@BUTTON_2"
msgstr "[arcana/] Follow the blue branch towards the incantations."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1018@BUTTON_3"
msgstr "[matter/] Follow the crystal branch leading down to the ground."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1018@BUTTON_4"
msgstr "[nature/] Follow the blossoming branch towards the singing."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1018@BUTTON_5"
msgstr "[shadow/] Follow the dead branch towards the whispers."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1018@TITLE"
msgstr "Vision of Destiny"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1021@BODY_FOOTER"
msgstr "When Law and {GLOBAL.OrderConcept.Hyperlink} rule the realm at your behest, the divine light shall once more embrace you. And empower you."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1021@BODY_HEADER"
msgstr "Your spirit is lifted when golden trumpets herald your arrival as you near the end of the golden branch."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1021@BODY_LORE"
msgstr "Pillars of light beam down from the very heavens to anoint you as their serving knight. You feel a primordial presence that both judges and blesses you. A glimpse of immense divine power. With a final flash, the light is then dimmed. Your vision ends. Yet your mission is revealed."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1021@BUTTON_0"
msgstr "\"I will prove that I am a Steward of Peace and Order.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1021@TITLE"
msgstr "Destiny of Order"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1022@BODY_FOOTER"
msgstr "This has always been your destiny. And with the blessing of the {GLOBAL.EndailonLoreConcept.Hyperlink} of {GLOBAL.OrderConcept.Hyperlink}, your supremacy is only just beginning."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1022@BODY_HEADER"
msgstr "You have become the Apex of {GLOBAL.OrderConcept.Hyperlink}. The <<PlayerLeader{Master/Mistress}>> of Lawfulness. You brought Order onto this realm."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1022@BODY_LORE"
msgstr "You delivered your own destiny through relentless effort and determination. Your {EventRace}, your trusty followers, tools, and weapons, have diligently helped you complete your tasks. Your work is now complete. But now is not the time to grow idle. Not when victory is within your reach."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1022@BUTTON_0"
msgstr "\"Wherever Order exists, so will my {EventRace}. As will I.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1022@REWARD"
msgstr "All owned units gain {GLOBAL.PROPERTIES.PROPHECY_MARK_OF_ORDER.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1022@REWARD2"
msgstr "The {GLOBAL.UNITS.LIGHT_SPIRIT.Hyperlink}, {GLOBAL.UNITS.BLESSED_SOUL.Hyperlink}, and {GLOBAL.UNITS.ARCHON_ASTRA.Hyperlink} become available in the {GLOBAL.RequestMilitaryAidConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1022@TITLE"
msgstr "Exalted by Order"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1025@BODY_FOOTER"
msgstr "When the denizens of this realm serve no other Master than {GLOBAL.ChaosConcept.Hyperlink}, your burning dominion will be unfettered."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1025@BODY_HEADER"
msgstr "All of your fears and inhibitions melt away as you sprint over the crimson branch into the burning canopy."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1025@BODY_LORE"
msgstr "Their raging fires set you free. There are no rules here. Everything is permitted in the realm of {GLOBAL.ChaosConcept.Hyperlink}. An unseen entity observes you. You feel it savoring your presence. Your excitement becomes its pleasure. With a final blaze, the fires are suddenly snuffed. Your vision ends. Yet your mission is revealed."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1025@BUTTON_0"
msgstr "\"I will prove that I am a Conqueror and a Kindler of Chaos.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1025@TITLE"
msgstr "Destiny of Chaos"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1026@BODY_FOOTER"
msgstr "This has always been your destiny. And with the blessing of the {GLOBAL.EndailonLoreConcept.Hyperlink} of {GLOBAL.ChaosConcept.Hyperlink}, your dominion is only just beginning."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1026@BODY_HEADER"
msgstr "You have become the Apex of {GLOBAL.ChaosConcept.Hyperlink}. The <<PlayerLeader{Master/Mistress}>> of Liberation. You brought {GLOBAL.ChaosConcept.Name} onto this realm."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1026@BODY_LORE"
msgstr "You delivered your own destiny through relentless effort and determination. Your {EventRace}, your trusty followers, tools, and weapons, have diligently helped you complete your tasks. Your work is now complete. But now is not the time to grow idle. Not when victory is within your reach."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1026@BUTTON_0"
msgstr "\"Wherever Chaos exists, so will my {EventRace}. As will I.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1026@REWARD"
msgstr "All owned units gain {GLOBAL.PROPERTIES.PROPHECY_MARK_OF_CHAOS.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1026@REWARD2"
msgstr "The {GLOBAL.UNITS.INFERNO_HOUND.Hyperlink}, {GLOBAL.UNITS.NIGHTMARE_UNIT.Hyperlink}, and {GLOBAL.UNITS.BALOR.Hyperlink} become available in the {GLOBAL.RequestMilitaryAidConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1026@TITLE"
msgstr "Unleashed by Chaos"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1029@BODY_FOOTER"
msgstr "When your mastery over magic binds this realm and its secrets, the full extent of your {GLOBAL.AstralConcept.Hyperlink} talents are unleashed."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1029@BODY_HEADER"
msgstr "The blue branch leads you higher and higher, until it disappears from underneath your feet. You float, immersed in {GLOBAL.AstralConcept.Hyperlink} essence."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1029@BODY_LORE"
msgstr "The fundamental teachings of the cosmos are archived here. Yet before you can study them, you learn that something ethereal dwells within the lofty library. You cannot see it, but you can sense its presence, like lightning. It studies you for a spell. With a sudden thunderclap, your vision ends. Yet your mission is now revealed, inscribed in your mind."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1029@BUTTON_0"
msgstr "\"I will prove my devotion to magic as a Scholar of Astral.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1029@TITLE"
msgstr "Destiny of Astral"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1030@BODY_FOOTER"
msgstr "This has always been your destiny. And with the blessing of the {GLOBAL.EndailonLoreConcept.Hyperlink} of {GLOBAL.AstralConcept.Hyperlink}, your star has only just begun to rise."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1030@BODY_HEADER"
msgstr "You have become the Apex of {GLOBAL.AstralConcept.Hyperlink}. The <<PlayerLeader{Master/Mistress}>> of Magic. You brought {GLOBAL.AstralConcept.Name} onto this realm."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1030@BODY_LORE"
msgstr "You delivered your own destiny through relentless effort and determination. Your {EventRace}, your trusty followers, tools, and weapons, have diligently helped you complete your tasks. Your work is now complete. But now is not the time to grow idle. Not when victory is within your reach."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1030@BUTTON_0"
msgstr "\"Wherever Astral exists, so will my {EventRace}. As will I.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1030@REWARD"
msgstr "All owned units gain {GLOBAL.PROPERTIES.PROPHECY_MARK_OF_ASTRAL.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1030@REWARD2"
msgstr "The {GLOBAL.UNITS.LOST_WIZARD_UNIT.Hyperlink} and {GLOBAL.UNITS.MAGE_BANE_UNIT.Hyperlink} become available in the {GLOBAL.RequestMilitaryAidConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1030@TITLE"
msgstr "Ascended by Astral"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1033@BODY_FOOTER"
msgstr "When your cities adorn the realm like jewels, crafted and placed with precision and intent, secrets of {GLOBAL.MateriumConcept.Hyperlink} are yours."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1033@BODY_HEADER"
msgstr "You follow the crystal branch, your road. It leads underground, where infinite crystal branches grow and collide with each other."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1033@BODY_LORE"
msgstr "The crystal branches' endless knocking reminds you of smiths hammering and masons hewing. Thick and slender limbs alike have twisted and entwined into awe-inspiring cathedrals of crystalline wood. You sense their architect, concealing itself inside its work. It observes your motions and ponders your appreciation. The vision suddenly ends as the structures collapse. You awake, your mind fixed on your mission."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1033@BUTTON_0"
msgstr "\"I will prove that I am an Artisan and a Keeper of Materium.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1033@TITLE"
msgstr "Destiny of Materium"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1034@BODY_FOOTER"
msgstr "This has always been your destiny. And with the blessing of the {GLOBAL.EndailonLoreConcept.Hyperlink} of {GLOBAL.MateriumConcept.Hyperlink}, your craftsmanship has only just begun to develop."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1034@BODY_HEADER"
msgstr "You have become the Apex of {GLOBAL.MateriumConcept.Hyperlink}. The <<PlayerLeader{Master/Mistress}>> of Craft. You brought {GLOBAL.MateriumConcept.Name} onto this realm."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1034@BODY_LORE"
msgstr "You delivered your own destiny through relentless effort and determination. Your {EventRace}, your trusty followers, tools, and weapons, have diligently helped you complete your tasks. Your work is now complete. But now is not the time to grow idle. Not when victory is within your reach."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1034@BUTTON_0"
msgstr "\"Wherever Materium exists, so will my {EventRace}. As will I.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1034@REWARD"
msgstr "All owned units gain {GLOBAL.PROPERTIES.PROPHECY_MARK_OF_MATERIUM.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1034@REWARD2"
msgstr "The {GLOBAL.UNITS.EARTH_TITAN_UNIT.Hyperlink}, and {GLOBAL.UNITS.GOLD_GOLEM.Hyperlink} become available in the {GLOBAL.RequestMilitaryAidConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1034@TITLE"
msgstr "Reinforced by Materium"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1035@BODY_FOOTER"
msgstr "This has always been your destiny. And with the blessing of the {GLOBAL.EndailonLoreConcept.Hyperlink} of {GLOBAL.NatureConcept.Hyperlink}, your blossoming is only just beginning."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1035@BODY_HEADER"
msgstr "You have become the Apex of {GLOBAL.NatureConcept.Hyperlink}. The <<PlayerLeader{Master/Mistress}>> of Life. You brought {GLOBAL.NatureConcept.Name} onto this realm."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1035@BODY_LORE"
msgstr "You delivered your own destiny through relentless effort and determination. Your {EventRace}, your trusty followers, tools, and weapons, have diligently helped you complete your tasks. Your work is now complete. But now is not the time to grow idle. Not when victory is within your reach."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1035@BUTTON_0"
msgstr "\"Wherever Nature exists, so will my {EventRace}. As will I.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1035@REWARD"
msgstr "All owned units gain {GLOBAL.PROPERTIES.PROPHECY_MARK_OF_NATURE.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1035@REWARD2"
msgstr "The {GLOBAL.UNITS.ENTWINED_SCOURGE_UNIT.Hyperlink} and {GLOBAL.UNITS.HORNED_GOD.Hyperlink} become available in the {GLOBAL.RequestMilitaryAidConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1035@REWARD3"
msgstr "All cities gain {GLOBAL.ManaConcept.Hyperlink} income equal to {percentage}% of their {GLOBAL.FoodConcept.Hyperlink} income."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1035@TITLE"
msgstr "Embraced by Nature"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1039@BODY_FOOTER"
msgstr "When your gardens reach the horizon and your {EventRace} have multiplied and fortified, you shall be granted full power over {GLOBAL.NatureConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1039@BODY_HEADER"
msgstr "The blossoms' sweet scents invigorate you as you eventually reach the verdant bough's end in the thick canopy."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1039@BODY_LORE"
msgstr "You have arrived in a paradise where everything infinitely expands and grows to fill the great nothingness beyond. Flora and fauna alike curiously notice your presence. As does another sprawling entity, hidden just out of sight. It plants a seed in your thoughts. As it buds, the vision withers away before your eyes. Yet your mission is grafted in your mind."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1039@BUTTON_0"
msgstr "\"I will prove that I am a Tender of Growth and Nature.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1039@TITLE"
msgstr "Destiny of Nature"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1045@BODY_FOOTER"
msgstr "When you sit in your web of shadows and deceits, the full potency of {GLOBAL.ShadowConcept.Hyperlink} is yours to manipulate."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1045@BODY_HEADER"
msgstr "The dead branch leads you down, not up. You are guided into the coldest and darkest shadows of the Tree."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1045@BODY_LORE"
msgstr "An unspeakable terror dwells here, but you feel no fear, only admiration. The entity extends one of its hooked limbs to grace you. Its touch intoxicates you. You desire more. You drink from a cool well of secrets. But soon light begins to pierce the shadows. You are back in the world. Your vision has ended. Yet your mission is revealed."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1045@BUTTON_0"
msgstr "\"I will prove that I am a Manipulator, and a Servant of Shadow.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1045@TITLE"
msgstr "Destiny of Shadow"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1046@BODY_FOOTER"
msgstr "This has always been your destiny. And with the blessing of the {GLOBAL.EndailonLoreConcept.Hyperlink} of {GLOBAL.ShadowConcept.Hyperlink}, your influence is only just growing."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1046@BODY_HEADER"
msgstr "You have become the Apex of {GLOBAL.ShadowConcept.Hyperlink}. The <<PlayerLeader{Master/Mistress}>> of Decay. And you have brought {GLOBAL.ShadowConcept.Name} into this realm."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1046@BODY_LORE"
msgstr "You delivered your own destiny through relentless effort and determination. Your {EventRace}, your trusty followers, tools, and weapons, have diligently helped you complete your tasks. Your work is now complete. But now is not the time to grow idle. Not when victory is within your reach."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1046@BUTTON_0"
msgstr "\"Wherever Shadow exists, so will my {EventRace}. As will I.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1046@REWARD"
msgstr "All owned units gain {GLOBAL.PROPERTIES.PROPHECY_MARK_OF_SHADOW_AUTOSPELL.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1046@REWARD2"
msgstr "The {GLOBAL.UNITS.FALLEN_ANGEL.Hyperlink}, {GLOBAL.UNITS.UNDEAD_TITAN.Hyperlink}, and {GLOBAL.UNITS.BONE_DRAGON.Hyperlink} become available in the {GLOBAL.RequestMilitaryAidConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1046@TITLE"
msgstr "Immersed in Shadow"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1085@BODY_FOOTER"
msgstr "As long as the {EventStackLeader} remains at the {EventStructure}, your destiny cannot be fulfilled."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1085@BODY_HEADER"
msgstr "You have found the {EventStructure} from your visions. But it is not uninhabited."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1085@BODY_LORE"
msgstr "You remember the sinister presence in your dreams. That ominous guardian of the prophesied location of your Paradise. It is a {EventStackLeader} that roars when <<p:EventStackLeader>> notices your presence, even from afar. <<Cp:EventStackLeader>> stands in your way."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1085@BUTTON_0"
msgstr "\"This {EventStackLeader} must vacate this {EventStructure}.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1085@TITLE"
msgstr "The Dweller Of Ruins"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1086@BODY_FOOTER"
msgstr "To fulfill your destiny and deliver on the prophecy, you must rebuild a great {GLOBAL.CityConcept.Hyperlink} from these {EventStructure}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1086@BODY_HEADER"
msgstr "The {EventStackLeader} has been removed from the {EventStructure}. Your destiny is within reach."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1086@BODY_LORE"
msgstr "The <<m:{GLOBAL.CityRuinConcept.Hyperlink}>> call to you. You experience a sense of inner peace and belonging. Amid the rubble of the Ruins lies the Silver Crown from your vision. Blackened by weather and time, a slight polish is all that's required to see the gleaming promise hidden inside. It is the same as these Ruins: they are a broken heap of stones now, but they contain the promise of a {GLOBAL.CityConcept.Hyperlink} beyond reckoning."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1086@BUTTON_0"
msgstr "\"A fine City these Ruins will make.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1086@TITLE"
msgstr "Clearing the Rubble"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1096@BODY_FOOTER"
msgstr "<<g:sentries^p,EventHouse>> mock you from the ramparts. You must claim this city from them."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1096@BODY_HEADER"
msgstr "You near the site of your Prophesied Land. It is the Free City of {EventHouse}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1096@BODY_LORE"
msgstr "The {EventHouseRace}, led by {EventHouseLord}, occupy the territory that is yours by divine right. You see the gleaming crown from your vision suspended in the air high over the city. Its sight inspires you and your warriors. It bids you to free {EventHouse} from its unrightful occupants."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1096@BUTTON_0"
msgstr "\"I will oust {EventHouseLord} and <<o:EventHouseLord>> {EventHouseRace} from my city!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1096@TITLE"
msgstr "Marching on Paradise"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1097@BODY_FOOTER"
msgstr "{EventHouse} is ready to become your {GLOBAL.ThroneCityConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1097@BODY_HEADER"
msgstr "{EventHouse} has fallen to your glorious might. Your {EventRace} triumphantly march through its streets."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1097@BODY_LORE"
msgstr "Your craftsmen are already repairing the city gates that your army destroyed moments before. This is your new home. You cannot explain it, but this feels just to you. This is the way the world should be."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1097@BUTTON_0"
msgstr "\"They were no match for me and my mighty {EventRace}.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1097@TITLE"
msgstr "Paradise Conquered"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1115@BODY_FOOTER"
msgstr "Will you risk angering your people and allow the pilgrims into {EventCity}?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1115@BODY_HEADER"
msgstr "News of your efforts to build your Paradise travels far and wide. Pilgrims have arrived to settle in {EventCity}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1115@BODY_LORE"
msgstr "The pilgrims are {EventRace}, kin of your people. They have come from all corners of this realm to join you in your quest to fulfill your Prophecy. Yet their arrival upsets the citizens of {EventCity}. Why should the pilgrims profit from their hard work, they argue. If you allow them to enter, that will surely upset your population."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1115@BUTTON_0"
msgstr "Welcome the pilgrims [population/] to the discontent [unhappiness/] of your citizens."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1115@BUTTON_1"
msgstr "Slaughter the pilgrims [evilact/] and feed [food/] them to your population in {EventCity}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1115@BUTTON_2"
msgstr "Turn the pilgrims away."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1115@BUTTON_3"
msgstr "Build [structureprod/] and furbish [gold/] dedicated homes [population/] for the pilgrims."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1115@TITLE"
msgstr "Pilgrims to Paradise"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1119@BODY_FOOTER"
msgstr "Their threats and insults continue for several hours. Perhaps it is best to end their lives quickly."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1119@BODY_HEADER"
msgstr "Your efforts to bring about an Age of Death have not gone unnoticed. Crusaders have rallied against you."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1119@BODY_LORE"
msgstr "A company of {RandomWarriorTitle} of the {RandomIdol} have marched into your domain. They have vowed to kill the one responsible for delivering so much death on this realm. Three Heroes ride at the head of the company, repeating the same message over and over again: \"Evil one! Your reign of death will end by our blades!\" shouts {EventHero1}. \"Your cursed soul shall be cleansed by our zeal,\" cries {EventHero2}. \"Your cities of decay shall be purged by our holy flames!\", roars {EventHero3}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1119@BUTTON_0"
msgstr "\"My crypt welcomes you.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1119@BUTTON_2"
msgstr "\"Wait, you think I am evil?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1119@TITLE"
msgstr "Death Sentence"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1120@BODY_FOOTER"
msgstr "Those who died will be moved to your {GLOBAL.CryptConcept.Hyperlink}. Those who survived ought to join their <<EventHero1{brothers/sisters}>> in arms soon."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1120@BODY_HEADER"
msgstr "You have defeated the zealous {RandomWarriorTitle} of the {RandomIdol}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1120@BODY_LORE"
msgstr "You have proven their threats empty and their fervor idle. Now they lie at your feet, sacrificed to the great goal you serve, kindling for the cold flames of death."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1120@BUTTON_0"
msgstr "\"Ever closer creeps the hour of Death.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1120@TITLE"
msgstr "Death Sentence: Aftermath"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1129@BODY_FOOTER"
msgstr "This {EventMaterial} is nearby, although any new source of the {GLOBAL.MagicMaterialConcept.Hyperlink} secured through trade or conquest will do. Will you claim it?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1129@BODY_HEADER"
msgstr "Your ongoing efforts to ruin the realm with the unfathomable force of Magic are proceeding well. Yet critical components remain missing."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1129@BODY_LORE"
msgstr "You sense you may need {EventMaterial} to complete a set of <<m:{GLOBAL.MagicMaterialConcept.Hyperlink}>> and thus achieve your arcane goals. There is a source not too far from your realm. Its image appears in your mind's eye. You can almost touch it."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1129@BUTTON_0"
msgstr "Go forth and obtain the {EventMaterial}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1129@BUTTON_1"
msgstr "Brush off the sensation."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1129@TITLE"
msgstr "Securing the Set"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1133@BODY_FOOTER"
msgstr "Although your scheme has not come into full fruition, the inevitability of your plotted course becomes increasingly apparent."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1133@BODY_HEADER"
msgstr "You have secured the {EventMaterial}. Your plans are advancing with every hour."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1133@BODY_LORE"
msgstr "You can feel how the {GLOBAL.MagicMaterialConcept.Hyperlink} acts as a conduit for the magical energies that course through it. The air in your realm grows a bit thicker and becomes slightly more static. The pressure is building."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1133@BUTTON_0"
msgstr "This world shall crumble soon."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1133@TITLE"
msgstr "Magical Match"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1159@BODY_FOOTER"
msgstr "Inspired by the Endailon, you know it in your heart: claiming the {EventMaterial}, you will boost the productivity of your realm."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1159@BODY_HEADER"
msgstr "While overseeing construction in {EventCity}, you are suddenly overwhelmed by a compulsion to create. An entity reveals itself to you."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1159@BODY_LORE"
msgstr "You know the entity from your vision. This is the architect of the Cathedral of Crystalline Wood. Within you swells the desire to craft fine tools and build high towers. The entity, the very {GLOBAL.EndailonLoreConcept.Hyperlink} of {GLOBAL.MateriumConcept.Hyperlink} that was drawn to your realm by your dedication to building, reveals to you a nearby {EventMaterial}, which harbors secrets to build faster, higher, and better. It then pauses, seemingly observing your response."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1159@BUTTON_0"
msgstr "Yes, the {EventMaterial} shall be mine!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1159@BUTTON_3"
msgstr "Purge the urge. Reject your innate instincts. [materiumcrisis/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1159@BUTTON_4"
msgstr "Instruct the citizens of {EventCity} to work [structureprod/], never rest. [food/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1159@TITLE"
msgstr "The Muse of Craft"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1160@BODY_FOOTER"
msgstr "You realize that the {GLOBAL.EndailonLoreConcept.Hyperlink} has departed. But your building fever abides."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1160@BODY_HEADER"
msgstr "You have claimed the {EventMaterial} and you are struck with an inspired revelation."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1160@BODY_LORE"
msgstr "You instantly have a better understanding of architectural designs, structural integrities, and the qualities of materials. This understanding does not originate from your inner self alone. It was amplified, if not granted, to you by the absolute embodiment of Making: the {GLOBAL.EndailonLoreConcept.Hyperlink} of {GLOBAL.MateriumConcept.Hyperlink}. But the inspiration is fleeting. The Endailon must tend to other creations."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1160@BUTTON_0"
msgstr "From the deepest caverns to the highest heavens, we build!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1160@TITLE"
msgstr "Constructive Intervention"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1163@BODY_FOOTER"
msgstr "You realize that the {EventSpawner} is not a goal, but a means. You ponder your next move."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1163@BODY_HEADER"
msgstr "Scheming and plotting your next move, a sudden sensation of awe and terror washes over you. A familiar entity reveals itself to you."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1163@BODY_LORE"
msgstr "You have admired its presence before, in the decaying, dark realm of your vision. Before you, stretching out its immense corpus of darkness like the dead of night, is the very {GLOBAL.EndailonLoreConcept.Hyperlink} of {GLOBAL.ShadowConcept.Hyperlink}. It lay hidden in the shadows you cast on your realm. Some of its hooked limbs point you towards a {EventSpawner}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1163@BUTTON_0"
msgstr "Direct your armies to assault the {EventSpawner}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1163@BUTTON_1"
msgstr "Channel the Endailon's terror [happiness/] to recruit more warriors [unitprod/] in {EventCity}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1163@BUTTON_2"
msgstr "Rebuke the invitation of the Endailon. [shadowcrisis/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1163@TITLE"
msgstr "The Muse of Deceit"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1164@BODY_FOOTER"
msgstr "The victory nevertheless inspires your {EventRace} to serve you in battle. And serve you, they shall."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1164@BODY_HEADER"
msgstr "The {EventSpawner} is in ruins, and your warriors collect the spoils. Yet you feel dissatisfied."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1164@BODY_LORE"
msgstr "You wonder if the {EventSpawner} served another purpose. Perhaps it should not have been obliterated. Perhaps it ought to obliterate. You ponder the manipulations of the {GLOBAL.EndailonLoreConcept.Hyperlink} of {GLOBAL.ShadowConcept.Hyperlink}, whose bleak presence you feel receding, slinking back into the shadows of the realm."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1164@BUTTON_0"
msgstr "\"I will steal your favor, O Endailon!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1164@TITLE"
msgstr "Concealed Intervention"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1171@BODY_FOOTER"
msgstr "Your cities require {GLOBAL.FoodConcept.Hyperlink} to grow. The {GLOBAL.EndailonLoreConcept.Hyperlink} offers you a succulent feast: hunt the {EvenStackleader}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1171@BODY_HEADER"
msgstr "The sight of your expanding cities makes your <<PlayerLeader{virility/vivacity}>> grow. Suddenly, an entity reveals itself to you."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1171@BODY_LORE"
msgstr "You have met this entity before in you vision of the ever-growing paradise. You are met by the very {GLOBAL.EndailonLoreConcept.Hyperlink} of {GLOBAL.NatureConcept.Hyperlink}, drawn to your blooming domain. Your hunger to expand grows in its presence. The entity shows you a plump {EventStackLeader} roaming nearby."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1171@BUTTON_0"
msgstr "Hunt the {EventStackLeader} for <<o:EventStackLeader>> meat."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1171@BUTTON_1"
msgstr "Your {EventRace} desire no meat. Send all laborers [structureprod/] to the farms! [food/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1171@BUTTON_2"
msgstr "Refuse to poach the {EventStackLeader}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1171@TITLE"
msgstr "The Muse of Growth"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1172@BODY_FOOTER"
msgstr "Under the wings of the {GLOBAL.EndailonLoreConcept.Hyperlink}, the collected meat multiplies to become a banquet that feeds all citizens in your realm."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1172@BODY_HEADER"
msgstr "As you harvest the meat of the slaughtered {EventStackleader}, you feel the {GLOBAL.EndailonLoreConcept.Hyperlink} of {GLOBAL.NatureConcept.Hyperlink} re-emerge."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1172@BODY_LORE"
msgstr "It studies the corpse of the {EventStackLeader} with growing curiosity. You expected it to decry the decay, but through the entity you witness the injection of new life in the <<G:carcass^n,EventStackLeader>>: insects picking clean the bones, fungi growing in the cadaver, and whatever remains will fertilize budding seeds. The Endailon, pleased with life's cycle renewed, grants one last boon before departing."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1172@BUTTON_0"
msgstr "\"Go forth and multiply, my {EventRace}!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1172@TITLE"
msgstr "Nutritious Intervention"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1175@BODY_FOOTER"
msgstr "The Endailon inspires you to perform a divine deed. Will you vow to destroy the {EventSpawner} or appease it some other way?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1175@BODY_HEADER"
msgstr "Your devotion and authority slowly shape this realm. Pride and exaltation engulf you as an entity reveals itself to you."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1175@BODY_LORE"
msgstr "Surrounded by golden pillars of light, the {GLOBAL.EndailonLoreConcept.Hyperlink} of {GLOBAL.OrderConcept.Hyperlink} graces you with its presence. It gazes over your domain and the Free Cities you inspire with fatherly approval. Yet you divine that an anomaly irks the entity. A blemish on the orderly lands you govern. A {EventSpawner} is a source of corruption and chaos. You sense the Endailon's expectations of you."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1175@BUTTON_0"
msgstr "I will deliver Order to the realm by destroying the {EventSpawner}"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1175@BUTTON_2"
msgstr "Offer protection [unitprod/] against the {EventSpawner} to friendly Free Cities. [allegiance/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1175@BUTTON_4"
msgstr "Deny the call. [ordercrisis/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1175@TITLE"
msgstr "The Muse of Harmony"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1176@BODY_FOOTER"
msgstr "It is not often that one as magnificent as yourself graces the realms. Bask in the light of your supremacy."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1176@BODY_HEADER"
msgstr "The {EventSpawner} is shattered. This realm is one step closer to perfect order."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1176@BODY_LORE"
msgstr "The {GLOBAL.EndailonLoreConcept.Hyperlink} of {GLOBAL.OrderConcept.Hyperlink} abides your work. An Angelic choir then begins to sing. First in whispers, until the light that surrounds the Endailon begins to fade. The choir's voices then build to a crescendo, at which point the entity vanishes with a deafening boom. The light is gone, save for one pillar beaming down from the heavens. It beams on you, crowning your head with golden glory."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1176@BUTTON_0"
msgstr "No one is as worthy as you."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1176@TITLE"
msgstr "Divine Intervention"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1185@BODY_FOOTER"
msgstr "Whatever drove them here, defeat the ravagers before they destroy your resources or harm your {EventRace}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1185@BODY_HEADER"
msgstr "<<m:{GLOBAL.MarauderConcept.Hyperlink}>> in the realm caught wind of your efforts to tear this world apart in the flames of war. Some agree. Others do not."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1185@BODY_LORE"
msgstr "Some of those who object have arrived at your borders to demand justice and hold you accountable for your misdeeds. They fly no flag other than their own. The one thing more peculiar than the timing of their arrival is the wanton mayhem they cause, as if to provoke you."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1185@BUTTON_0"
msgstr "Ravage the ravagers."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1185@TITLE"
msgstr "Just Objections"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1186@BODY_FOOTER"
msgstr "This letter is proof of a blatant attempt to attack you underhandedly. More importantly, you may use it to press your claims against {RivalPlayer}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1186@BODY_HEADER"
msgstr "Your warriors have defeated the marauding {EventStackLeader} and <<o:EventStackLeader>> companions. Among the spoils you discover something surprising."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1186@BODY_LORE"
msgstr "It seems that the marauders' assault was no coincidence. They carry a letter sent by {RivalPlayer}, who expresses <<o:RivalPlayer>> deep fears about your visions of ruin for the realm. The bandits were dispatched to end, or at least hamper, your plans."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1186@BUTTON_0"
msgstr "{RivalPlayer} ought to pay for <<o:RivalPlayer>> transgression."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1186@TITLE"
msgstr "Just Cause"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1192@BODY_FOOTER"
msgstr "A slave to the <<o:{GLOBAL.EndailonLoreConcept.Hyperlink}>> will, {EventHouseLord} of {EventHouse} promptly vows to destroy you and your {EventRace}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1192@BODY_HEADER"
msgstr "By your hand, this realm slowly falls to chaos. Suddenly, an entity drawn to the havoc you wreak reveals itself to you."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1192@BODY_LORE"
msgstr "The entity liberates your soul; its presence ignites your heart. You remember this entity from your vision of the burning canopy. Your actions have drawn the very {GLOBAL.EndailonLoreConcept.Hyperlink} of {GLOBAL.ChaosConcept.Hyperlink} to your domain. Yet the entity's appetite for destruction is still not satisfied. It surveys the realm and, craving more disarray, wounds the heart of the {EventHouseLord.Title} of {EventHouse} to incite hatred inside."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1192@BUTTON_0"
msgstr "Another City must fall to your burning blades."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1192@BUTTON_2"
msgstr "Pacify {EventHouse} by purchasing [gold/] their swords [unitprod/] for your army."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1192@BUTTON_3"
msgstr "I have no quarrel with {EventHouse}. I reject this war. [chaoscrisis/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1192@TITLE"
msgstr "The Muse of Conflict"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1193@BODY_FOOTER"
msgstr "This newly kindled battle frenzy will be a useful asset as you continue to wreak havoc in the name of {GLOBAL.ChaosConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1193@BODY_HEADER"
msgstr "As your warriors feast amid the ruins of {EventHouse}, you sense the return of the {GLOBAL.EndailonLoreConcept.Hyperlink} of {GLOBAL.ChaosConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1193@BODY_LORE"
msgstr "The burning light of the entity exhilarates you. You share its delight as it oversees the crushed walls of {EventHouse}. Despite your ecstasy, you begin to understand that this war was a favor from the entity. When the {GLOBAL.EndailonLoreConcept.Hyperlink} fixes its gaze on you, you almost explode with fervor. The feeling bursts from you and spreads to all {EventRace} in your realm."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1193@BUTTON_0"
msgstr "Death to Order! Glory to Chaos!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1193@TITLE"
msgstr "Discordant Intervention"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1197@BODY_FOOTER"
msgstr "It's uncanny, but you inexplicably feel like satisfying the <<o:{GLOBAL.EndailonLoreConcept.Hyperlink}>> request to obtain {EventMaterial} will reveal veiled secrets to you."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1197@BODY_HEADER"
msgstr "One by one, this realm's secrets are uncovered by you. You suddenly feel enlightened when an entity reveals itself to you."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1197@BODY_LORE"
msgstr "You know its identity: the very {GLOBAL.EndailonLoreConcept.Hyperlink} of {GLOBAL.AstralConcept.Hyperlink}. Remembering your encounter with the entity in the Astral library of your vision, your minds briefly connect. You catch a glimpse of a {EventMaterial} not far from here. You sense the entity's curiosity: it desires that you claim the substance for yourself. To study it... and potentially for other reasons."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1197@BUTTON_0"
msgstr "The Endailon knows best. I will obtain the {EventMaterial}"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1197@BUTTON_3"
msgstr "Reject the Endailon's mentorship. [astralcrisis/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1197@BUTTON_4"
msgstr "Benefit from the Endailon's presence to extract [mana/] cosmic knowledge. [knowledge/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1197@TITLE"
msgstr "The Muse of Discovery"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1198@BODY_FOOTER"
msgstr "This is your true reward. The combined resonances of the {GLOBAL.EndailonLoreConcept.Hyperlink} and the {EventMaterial} show the location of an unclaimed {GLOBAL.AncientWonderConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1198@BODY_HEADER"
msgstr "You have successfully claimed the {EventMaterial}, which is covered by a thick layer of [hyperlink,GLOBAL.ManaConcept]mana dust[/hyperlink]."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1198@BODY_LORE"
msgstr "The enigmatic {GLOBAL.EndailonLoreConcept.Hyperlink} of {GLOBAL.AstralConcept.Hyperlink} reappears, yet it focuses on the {EventMaterial}. You sense their inherent magics interacting—an intoxicating experience—when slowly the mana dust rearranges itself into a crude map. It details the path to an {GLOBAL.AncientWonderConcept.Hyperlink} you haven't yet explored. The entity then relaxes again, before turning its attention to something else in the {GLOBAL.AstralSeaLoreConcept.Hyperlink} and vanishes."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1198@BUTTON_0"
msgstr "\"I have been blessed by this arcane augury.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1198@TITLE"
msgstr "Arcane Intervention"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1205@BODY_FOOTER"
msgstr "Your architects believe that the {EventMaterial} will speed up construction in {EventCity}. Will you humor their proposal?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1205@BODY_HEADER"
msgstr "{EventCity} grows. Both its population and its buildings multiply and become stronger."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1205@BODY_LORE"
msgstr "Excitedly, <<G:architects^p,EventCity>> present an opportunity to you. They discovered new structural properties in {EventMaterial}, claiming that it may be mixed into the stone and earth of {EventCity} to strengthen it! \"If {EventCity} is truly our Paradise,\" they argue, \"Surely only the best materials should be used in its construction, O {PlayerLeader.Title}.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1205@BUTTON_0"
msgstr "Resolve to find the {EventMaterial} for {EventCity}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1205@BUTTON_4"
msgstr "Decide that {EventCity} currently requires no magical augmentation."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1205@TITLE"
msgstr "Designs of Stability"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1206@BODY_FOOTER"
msgstr "Euphoria spreads among your citizens. Their belief that {EventCity} is their Paradise has never been more ardent."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1206@BODY_HEADER"
msgstr "You have secured the {EventMaterial}. It will now be incorporated in the construction of {EventCity}!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1206@BODY_LORE"
msgstr "News of your achievement spreads fast. The population of {EventCity} cheers on the builders and laborers, encouraging them to work better, harder, and faster. The walls and towers of your great city grow ever higher. The chanting of your name is heard far and wide. \"{PlayerLeader}! Long live {PlayerLeader}!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1206@BUTTON_0"
msgstr "{EventCity} will know no equal in all the realms."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1206@TITLE"
msgstr "Foundation of Stability"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1207@BODY_FOOTER"
msgstr "You are faced with a dilemma: press the attack and win more easily, or hold back to preserve the city's structures."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1207@BODY_HEADER"
msgstr "Your victory is within reach: the siege of {EventCity} has commenced. You've waited a long time for this moment."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1207@BODY_LORE"
msgstr "But a thought slowly overtakes your mind as you oversee the siege preparations. If this city is to be your Paradise, what wisdom is there then in assailing {EventCity} with fire and steel?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1207@BUTTON_0"
msgstr "Call in reinforcements from {PlayerCity} [unitprod/] and aggravate [siegehealthdamage/] the attack!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1207@BUTTON_1"
msgstr "Oblige your troops [hp/] to minimize casualties [goodact/] among the population. [population/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1207@BUTTON_2"
msgstr "Continue with the siege as normal."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1207@BUTTON_3"
msgstr "Impel your troops [morale/] to minimize damage to <<G:structures^p,EventCity>>. [structureprod/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1207@TITLE"
msgstr "Knocking on Prophesied Gates"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1210@BODY_FOOTER"
msgstr "This cannot stand. You are bound by your Prophecy. Reclaim what is rightfully yours! Conquer {EventCity}!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1210@BODY_HEADER"
msgstr "It is your destiny to build your Paradise on the <<m:{GLOBAL.CityRuinConcept.Hyperlink}>>. However, {RivalPlayer} beat you to it."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1210@BODY_LORE"
msgstr "It barely matters whether it was malice, ignorance, or happenstance. Your rival has constructed a city of their own on the <<m:{GLOBAL.CityRuinConcept.Hyperlink}>> that were yours to claim. <<Co:RivalPlayer>> {EventRace} now live, work, and multiply where your {PlayerRace} are preordained to thrive."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1210@BUTTON_0"
msgstr "The insolence! {EventCity} must be mine!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1210@TITLE"
msgstr "Ruined Expectations"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1211@BODY_FOOTER"
msgstr "You can leave this war behind you now and focus on your prosperous future in {EventCity}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1211@BODY_HEADER"
msgstr "You have conquered {EventCity} from the unworthy clutches of {RivalPlayer}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1211@BODY_LORE"
msgstr "Your rival {GLOBAL.GodirLoreConcept.Hyperlink} may never fathom why it was so vital for you to settle on these <<m:{GLOBAL.CityRuinConcept.Hyperlink}>>. You belong to a select company: the chosen few charged with the pursuit of monumental achievements. You have been weighed. And you have been found worthy."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1211@BUTTON_0"
msgstr "Today belongs to the potent {PlayerRace}!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_1211@TITLE"
msgstr "Restoration of Reclamation"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_939@BODY_FOOTER"
msgstr "Which destination belongs to you? The Walled City? The Forest of Debris? Or will you remain inside the Foundations of Clay?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_939@BODY_HEADER"
msgstr "This realm breathes a scent of fate that affects you. It doesn't take long before you succumb to a dream."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_939@BODY_LORE"
msgstr "You stand amid unfinished Foundations of Clay at dawn, familiar and safe. Heath surrounds you, with only two landmarks in sight. The rising Sun's rays bounce off a crown suspended in the sky, looming over a Walled City atop a steep hill. Meanwhile the Moon illuminates a path of debris leading into a dense forest, where countless eyes gleam beneath its canopies. A thundering voice commands: \"Guide your {EventRace} towards their Paradise.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_939@BUTTON_0"
msgstr "[order/] Ascend the faraway hill, towards the walled city."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_939@BUTTON_1"
msgstr "[nature/] Follow the path of debris into the forest of eyes."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_939@BUTTON_2"
msgstr "[matter/] Plant your feet at the center of the clay foundations."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_939@TITLE"
msgstr "Visions of Promise"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_942@BODY_FOOTER"
msgstr "The dream ebbs away, its message clear. Find the Prophesied Land occupied by the pretenders and conquer it for your {EventRace}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_942@BODY_HEADER"
msgstr "You arrive at the Walled City. Its gate is barred. Dark figures march along its high ramparts. The way is shut."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_942@BODY_LORE"
msgstr "The crown floating over the city beckons you. Its glow warms your heart and incites a rousing promise in your soul. You see carvings in the city walls. Faded images of your {EventRace} and... of yourself! This is your land. This city belongs to you. Yet you are not its <<PlayerLeader{lord/lady}>>. Enemies, leering at you from imposing fortifications, stand in your way."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_942@BUTTON_0"
msgstr "\"By the swords of the {EventRace}, I will win my Paradise!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_942@TITLE"
msgstr "Promise of Paradise"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_954@BODY_FOOTER"
msgstr "{EventCity} shall deliver unprecedented wealth and productivity for your {EventRace}. Long may you reign here."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_954@BODY_HEADER"
msgstr "Your determined labor is finally rewarded. The Great Work is done. The construction of {EventCity}, your Paradise, is now complete."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_954@BODY_LORE"
msgstr "Your {EventRace} celebrate while you reminisce about the vision you had so long ago. Noting the zeal and determination of your people, you wonder if that Vision of Prophecy brought you this monumental achievement, or if the will to win was inside you all along. Or perhaps they are one and the same."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_954@BUTTON_0"
msgstr "Now is the time to reap the fruits of our labor."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_954@BUTTON_2"
msgstr "We conquered the {EventMonster}. Now we conquer the realm."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_954@BUTTON_3"
msgstr "Now is the time to reap the fruits of our labor.\\"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_954@TITLE"
msgstr "Capstones on Paradise"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_957@BODY_FOOTER"
msgstr "You awake with the urge to find the {EventStructure} and defeat whatever entity dwells there. Your Paradise must be rebuilt."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_957@BODY_HEADER"
msgstr "The debris of the winding forest path crunches beneath your steps until you finally arrive in a moonlit clearing."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_957@BODY_LORE"
msgstr "The clearing once harbored an ancient city, now scattered into rubble and bones. You find a silver crown with your name engraved on it. These are the <<m:{GLOBAL.CityRuinConcept.Hyperlink}>> of your Prophesied Land. Then, dark trees that surround the clearing creak and give way to something sinister that has made its lair here. You hear bones crunching. The dream ends there."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_957@BUTTON_0"
msgstr "The land now ruined shall blossom again!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_957@TITLE"
msgstr "Paradise, Lost"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_977@BODY_FOOTER"
msgstr "Your Paradise is {EventCity}. All you must do to realize its potential is grow your population and keep them happy."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_977@BODY_HEADER"
msgstr "You stroll between the clay foundations and discover that you navigate its layout with uncanny familiarity. It reminds you of home."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_977@BODY_LORE"
msgstr "Then, the low walls begin to close in on you. You feel cramped. Contained. Inhibited. This will not do. You must expand. Grow. Build. This is to be your destiny. To transform your home into a bastion of vigor and craft. Your resolve repels the encroaching walls. Your dream abruptly ends and you realize: the foundations in your visions were those of {EventCity}, home of your {EventRace}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_977@BUTTON_0"
msgstr "Commence our great work in {EventCity}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_977@REWARD"
msgstr "Your {GLOBAL.ThroneCityConcept.Hyperlink} gains {amount}{GLOBAL.CityStabilityConcept.Hyperlink} per {GLOBAL.MagicMaterialConcept.Hyperlink} you control."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_977@TITLE"
msgstr "Foundations of Paradise"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_979@BODY_HEADER"
msgstr "You have secured a new home for your {EventRace}. Paradise is finally yours."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_979@BUTTON_0"
msgstr "\"From this new seat of power, I shall rule the realm.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_979@TITLE"
msgstr "Conquest of Paradise"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_988@BODY_HEADER"
msgstr "Once, this was a ruined wasteland. Now, your gleaming city stands tall and sturdy. You have reclaimed your Paradise."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_988@BUTTON_0"
msgstr "We wrested {EventCity} from the wilderness. Now we conquer the realm."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_988@TITLE"
msgstr "Paradise, Reclaimed"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_998@BODY_FOOTER"
msgstr "\"{PlayerLeader}, this world must end by your hand. Choose your tools of destruction.\" Which mask of destruction will you don?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_998@BODY_HEADER"
msgstr "You and your {EventRace} gaze on this new realm, ripe for the taking, when dark clouds blacken the skies."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_998@BODY_LORE"
msgstr "A terrifying visage appears in the sky: a cackling skull, pierced by blades of ice, fire, and lightning. You suddenly find three masks on three pedestals before you: an obsidian mask of a weeping grave keeper, a carnelian mask of a snarling general, and a lapis mask of a mage laughing maniacally. The earth around you rumbles, shifts, and tears while the skull in the sky screeches your name."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_998@BUTTON_0"
msgstr "[arcana/] Become the laughing mage."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_998@BUTTON_1"
msgstr "[chaos/] Become the snarling general."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_998@BUTTON_2"
msgstr "[shadow/] Become the weeping grave keeper."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1167_998@TITLE"
msgstr "Visions of Ruin"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1171_3692@BODY_FOOTER"
msgstr "The Host gathers before you and eagerly await your decree."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1171_3692@BODY_HEADER"
msgstr "By being perceived as pure by the Crusader Host, you could convince them to continue their fight somewhere else. Removing their Infestation permanently."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1171_3692@BODY_LORE"
msgstr "If you have attained the alignment of Pure Good, you could even convince them to launch a final decisive crusade against an enemy of your choice."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1171_3692@BUTTON_0"
msgstr "[influence/] \"This land is free from corruption, you must continue the fight elsewhere.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1171_3692@BUTTON_1"
msgstr "[reputation8/] [influence/] \"In the name of the Archons, cast down {Ruler1.Name}!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1171_3692@BUTTON_3"
msgstr "[reputation8/] [influence/] \"Honor your oaths, take up arms against {Ruler2.Name}!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1171_3692@BUTTON_4"
msgstr "[reputation8/] [influence/] \"For the good of the realm, vanquish {Ruler3.Name}!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1171_3692@BUTTON_5"
msgstr "Leave for now."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1171_3692@BUTTON_6"
msgstr "[reputation8/]\"March against {GLOBAL.UrrathLoreConcept}! Smite [minorcity/] {House.Name}!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1171_3692@TITLE"
msgstr "Call to Crusade"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1574@BODY_FOOTER"
msgstr "Footer"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1574@BODY_HEADER"
msgstr "The {EventHouseLord.Title} of {EventHouse} strides forward with open arms to speak on behalf of <<o:EventHouseLord>> {GLOBAL.IndependentCityConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1574@BODY_LORE"
msgstr "\"Glory!\" announces {EventHouseLord.Title} {EventHouseLord.FirstName} as <<p:EventHouseLord>> raises <<o:EventHouseLord>> index finger up high, \"O Godir, O Godir. Praise be the great plan that I am graced with an equal of culture on this day.\" <<Cp:EventHouseLord>> extends both hands and smiles. \"Behold, I am {EventHouseLord.TitleName} of the {EventHouseRace}. Do tell, what foundation shall we henceforth construct together?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1574@BUTTON_0"
msgstr "See what foundations {EventHouse.Name} is worthy of."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1574@BUTTON_1"
msgstr "\"You call me your equal? How curious.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1574@BUTTON_2"
msgstr "Overjoy them with an oration about Order."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1574@BUTTON_3"
msgstr "Sway them with a speech about the Shadow."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1574@BUTTON_4"
msgstr "Move them with a monologue about Materium."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1574@BUTTON_5"
msgstr "Enamor them with a narrative about Nature."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1574@BUTTON_6"
msgstr "Awe them with an address about the Astral."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1574@BUTTON_7"
msgstr "Coax them with a catharsis about Chaos."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1574@TITLE"
msgstr "Meeting Exalted {EventHouse}"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1769@BODY_FOOTER"
msgstr "The distance may be a blessing. For now the Umbral Abyss may slumber, but their forces may be overwhelming if you stir them without preparation."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1769@BODY_HEADER"
msgstr "You have settled on an island off the {EventRealm}. A light mist rests on the islands around you, obscuring the coast in the distance."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1769@BODY_LORE"
msgstr "You remember the description of the realm you were given. To the north and south, you see the outlines of jagged islands, small patches of land dotting the ocean. To the east, you imagine the looming Cliffs of Sordünn, claimed by the {GLOBAL.ShadowRealmLoreConcept.Hyperlink}. The ocean blocks them from your reach—and you from theirs."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1769@BUTTON_0"
msgstr "We must prepare our invasion of the Umbral Abyss."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1769@TITLE"
msgstr "The {EventRealm}"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1771@BODY_FOOTER"
msgstr "Your soldiers sweep across the {EventRealm}, clearing out the last infestations of Umbral influence. This [hyperlink,GLOBAL.WorldsWithinLoreConcept]World[/hyperlink] can heal once more."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1771@BODY_HEADER"
msgstr "You have defeated {Merlin.TitleName} and <<o:Merlin>> [hyperlink,GLOBAL.ShadowDemonsLoreConcept]Umbral forces[/hyperlink]. <<Cp:Merlin>> sinks to the ground. {Sundren.FirstName} and {Julia.FirstName} appear and kneel next to <<P:Merlin>>."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1771@BODY_HEADER@NO_SUNDREN"
msgstr "You have defeated {Merlin.TitleName} and <<o:Merlin>> [hyperlink,GLOBAL.ShadowDemonsLoreConcept]Umbral forces[/hyperlink]. <<Cp:Merlin>> sinks to the ground, as {Julia.FirstName} appears and kneels next to <<P:Merlin>>."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1771@BODY_LORE"
msgstr "{Julia.FirstName} gently closes <<o:Merlin>> eyes. \"I am sorry, my old friend.\" <<Cp:Julia>> whispers, a single tear running down <<o:Julia>> face. {Sundren.FirstName} fixes her harsh gaze on you. \"The Prophecy... I tried to do right by my father, mother, and mentor. Perhaps I was wrong. Wrong in coming here, or in trusting you.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1771@BODY_LORE@NO_SUNDREN"
msgstr "{Julia.FirstName} gently closes <<o:Merlin>> eyes. \"I am sorry, my old friend.\" <<Cp:Julia>> whispers, a single tear running down <<o:Julia>> face. \"If only fate had been more kind to us...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1771@BUTTON_0"
msgstr "A hard-earned victory."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1771@TITLE"
msgstr "A Vengeful Demise"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1772@BODY_FOOTER"
msgstr "\"As a token of goodwill, I offer you the knowledge to traverse the seas of Sordünn. I also realize you may have more questions for me.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1772@BODY_HEADER"
msgstr "You are approached by a regal Elven woman. <<Co:Julia>> stature is proud, but <<o:Julia>> eyes betray ages of strife, loss, and hope."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1772@BODY_LORE"
msgstr "\"Hail, {PlayerLeader.TitleName},\" <<p:Julia>> says. \"My name is {Julia.Name}, {Julia.Title}. I was sent here by the {GLOBAL.ArchonsLoreConcept.Hyperlink} to aid you on this realm.\" <<Cp:Julia>> gazes upon the coast in the distance, and her voice fades for a moment. \"So many worlds, ravaged by the darkness... We must fight back.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1772@BUTTON_0"
msgstr "\"Who are you?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1772@BUTTON_1"
msgstr "\"Do you know anything about the Prophecy that brought us here?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1772@BUTTON_2"
msgstr "\"Have you fought the Umbral Abyss before?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1772@BUTTON_3"
msgstr "\"I accept your aid. Let us fight the Umbral Abyss, together.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1772@TITLE"
msgstr "The Archon Champion"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1773@BODY_FOOTER"
msgstr "\"... But above all, I am a mother. To my two children: Thannis and [hyperlink,GLOBAL.SundrenLoreConcept]Sundren[/hyperlink]... In life, and beyond.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1773@BODY_HEADER"
msgstr "{Julia.FirstName} smiles with a profound sadness. \"Who am I? That is a hard question to answer...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1773@BODY_LORE"
msgstr "\"I am the daughter of the late Emperor Inioch of {GLOBAL.AthlaLoreConcept.Hyperlink}, who I have loved and warred against. I am sister to [hyperlink,GLOBAL.MeandorLoreConcept]Meandor[/hyperlink], who I have warred against and loved. I am-\" her voice catches, only shortly: \"... Widow to my beloved king Saridas. I have warred, loved, followed, and reigned. I have seen great atrocities and beautiful kindness... I have been an outcast and a queen.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1773@BUTTON_1"
msgstr "\"Do you know anything about the Prophecy that brought us here?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1773@BUTTON_2"
msgstr "\"Have you fought the Umbral Abyss before?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1773@BUTTON_3"
msgstr "\"I accept your aid. Let us fight the Umbral Abyss, together.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1773@TITLE"
msgstr "Rebel, Queen, Mother"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1774@BODY_FOOTER"
msgstr "\"The Archons may push, but in the end, you decide whether and how this Prophecy is fulfilled. A grand responsibility, {PlayerLeader.TitleName}.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1774@BODY_HEADER"
msgstr "{Julia.FirstName} nods slowly. \"I know of the Prophecy of Anon, and I have seen the {GLOBAL.ArchonsLoreConcept.Hyperlink} debate its interpretation.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1774@BODY_LORE"
msgstr "\"I may be the Champion of the Archons, but I speak for myself when I say: Words carry many meanings, and Prophecies can be as dangerous as they are helpful. I have seen many wise men and women who became blinded by their own radiance. The Archons believe that all impurities need to be purged. I think the Prophecy speaks of an alternative.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1774@BUTTON_0"
msgstr "\"Who are you?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1774@BUTTON_2"
msgstr "\"Have you fought the Umbral Abyss before?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1774@BUTTON_3"
msgstr "\"I accept your aid. Let us fight the Umbral Abyss, together.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1774@TITLE"
msgstr "Divine Myopia"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1775@BODY_FOOTER"
msgstr "\"I was found by an [hyperlink,GLOBAL.ArchonsLoreConcept]Archon[/hyperlink] vanguard and led to Emnora. I have learned much about their culture, but I am glad to travel and rebuild the realms again.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1775@BODY_HEADER"
msgstr "{Julia.FirstName} sighs and nods. \"I have fought the forces of the {GLOBAL.ShadowRealmLoreConcept.Hyperlink} many times before... The final time, I lost.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1775@BODY_LORE"
msgstr "\"When the [hyperlink,GLOBAL.WorldGateLoreConcept]World Gates[/hyperlink] opened, the Empires of {GLOBAL.AthlaLoreConcept.Hyperlink} were already torn by war and conspiracy. We stood valiantly, but... My husband, he was—assassinated. I was captured instead.\" A bitter tone creeps into <<o:Julia>> voice as she continues: \"One day, I was freed, through an act as kind as it was foolish.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1775@BUTTON_0"
msgstr "\"Who are you?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1775@BUTTON_1"
msgstr "\"Do you know anything about the Prophecy that brought us here?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1775@BUTTON_3"
msgstr "\"I accept your aid. Let us fight the Umbral Abyss, together.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1775@TITLE"
msgstr "Lithyl's Prisoner"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1776@BODY_FOOTER"
msgstr "{Julia.FirstName} pleads: \"I implore you to investigate this call, {PlayerLeader.TitleName}. I feel it is important.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1776@BODY_HEADER"
msgstr "As you travel the {EventRealm}, {Julia.FirstName} contacts you. \"{PlayerLeader.FirstName}, I realize we must focus on our mission, but I sense another presence nearby.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1776@BODY_LORE"
msgstr "\"Something, or someone, reaches out to me from the {GLOBAL.ShadowRealmLoreConcept.Hyperlink}. My nature rejects the darkness I sense, and yet something deep within me urges me to investigate. It feels twisted, yet familiar, almost as if... No, I must not hope in vain...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1776@BUTTON_0"
msgstr "\"I will consider this.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1776@TITLE"
msgstr "Flicker in the Dark"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1777@BODY_FOOTER"
msgstr "After a moment, Julia's tone grows stern: \"I have heard much of your endeavors, Sundren... And the ire you provoke.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1777@BODY_HEADER"
msgstr "You have defeated the last [hyperlink,GLOBAL.ShadowDemonsLoreConcept]Umbral Demon[/hyperlink] that threatened the entity hidden in the watchtower. Now, a figure emerges from it."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1777@BODY_LORE"
msgstr "You recognize the figure as a female elf, wreathed in shadows. {Julia.FirstName} gasps. \"... Sundren? Is it truly you?\"[br/]The harsh gaze of the shadowy elf shifts and her eyes widen. \"Mother?!\" {Sundren.FirstName} exclaims, and the two of them embrace at last. \"I have scoured the [hyperlink,GLOBAL.AstralSeaLoreConcept]Astral Sea[/hyperlink] for you,\" {Sundren.FirstName} finally says.[br/]{Julia.FirstName} nods, with tears in her eyes. \"My daughter, what pain you have seen.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1777@BUTTON_0"
msgstr "Allow the two their conversation."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1777@BUTTON_1"
msgstr "\"We have no time for this. Tell me why you are here, Sundren.\" [Skip]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1777@TITLE"
msgstr "Flicker in the Dark: Aftermath"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1778@BODY_FOOTER"
msgstr "\"There is a watchtower, where I made my stand. Free me, and I will be in your debt.\" The voice pauses for a moment. \"... Please.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1778@BODY_HEADER"
msgstr "Your troops enter the {GLOBAL.ShadowRealmLoreConcept.Hyperlink}. Immediately, a whisper reaches you, growing into an ethereal voice carried through the heavy air of the Umbral Abyss."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1778@BODY_LORE"
msgstr "\"I am on an important mission that will change the war against the {GLOBAL.ShadowRealmLoreConcept.Hyperlink}. But these cursed {GLOBAL.ShadowDemonsLoreConcept.Hyperlink} have proven to be... challenging. Help me, so I can finish my quest.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1778@BUTTON_0"
msgstr "\"I will consider this.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1778@TITLE"
msgstr "Flicker in the Dark: Into the Abyss"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1779@BODY_FOOTER"
msgstr "\"{Merlin.FirstName} attempts to corrupt the Affinities on the {EventRealm}. With the power of the {GLOBAL.EndailonLoreConcept.Hyperlink}, I believe we can break Urrath's influence over him instead.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1779@BODY_HEADER"
msgstr "Sundren continues: \"{Merlin.FirstName} is currently [hyperlink,GLOBAL.UrrathLoreConcept]Urrath's[/hyperlink] most powerful thrall and general. <<Co:Merlin>> mastery of magic has given the {GLOBAL.ShadowRealmLoreConcept.Hyperlink} terrible opportunities.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1779@BODY_LORE"
msgstr "\"{Merlin.FirstName} has used this realm to initiate experiments, in order to corrupt the other {GLOBAL.AffinitiesLoreConcept.Hyperlink} and even the {GLOBAL.ArchonsLoreConcept.Hyperlink} themselves. But this connection to the greater magics also provides opportunity for us.\" {Sundren.FirstName} lifts her chin proudly. \"When a gate is opened, two sides can pass. We can use the powers of the Affinities against {GLOBAL.UrrathLoreConcept.Hyperlink} and break its grasp on {Merlin.FirstName}.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1779@BUTTON_0"
msgstr "\"Go on...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1779@TITLE"
msgstr "Through Fractured Light"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1780@BODY_FOOTER"
msgstr "\"With the power of the {GLOBAL.EndailonLoreConcept.Hyperlink} with us, we can confront {Merlin.FirstName} in his capital... and break [hyperlink,GLOBAL.UrrathLoreConcept]Urrath's[/hyperlink] grasp on him.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1780@BODY_HEADER"
msgstr "You have collected and channeled all six [hyperlink,GLOBAL.AffinitiesLoreConcept]Affinity[/hyperlink] Aspects. {Sundren.FirstName} approaches you."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1780@BODY_LORE"
msgstr "\"Now you have the attention of all {GLOBAL.EndailonLoreConcept.Hyperlink}, we can undo Merlin's corruption... both his on his realm, and [hyperlink,GLOBAL.UrrathLoreConcept]Urrath's[/hyperlink] corruption on him. It will require us to confront him. There is no doubt he will resist...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1780@BUTTON_0"
msgstr "\"Onward.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1780@TITLE"
msgstr "Through Fractured Light: Completed"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1781@BODY_FOOTER"
msgstr "Your soldiers sweep across the {EventRealm}, clearing out the last infestations of Umbral influence. {Merlin.FirstName} and this [hyperlink,GLOBAL.WorldsWithinLoreConcept]World[/hyperlink] can heal once more."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1781@BODY_HEADER"
msgstr "You have decided to grant mercy to {Merlin.FirstName} and end your magical assault on him. {Sundren.FirstName} and {Julia.FirstName} kneel next to the corrupted wizard."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1781@BODY_LORE"
msgstr "\"His breath is shallow, but he lives,\" {Julia.FirstName} says. \"The cost of mercy... The Prophecy has been fulfilled.\"[br/]{Sundren.FirstName} nods. \"His path to restoration will be arduous, but at least there will be hope for him.\" She looks up to you. \"Thank you, {PlayerLeader.FirstName}, for granting him this chance.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1781@BUTTON_0"
msgstr "A hard-earned victory."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1781@BUTTON_1"
msgstr "nah, he deserves to die"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1781@TITLE"
msgstr "Mercy and Restoration"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1783@BODY_FOOTER"
msgstr "\"Let Urrath embrace all that is and will be. These petty struggles... All will be unmade in the peace of the Void.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1783@BODY_HEADER"
msgstr "From the eldritch darkness that looms over the {EventRealm}, a hooded figure appears. \"Such perseverance, such... Defiance.\" {Merlin.FirstName} says."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1783@BODY_LORE"
msgstr "<<Cg:sad gaze^n,Merlin>> rests upon you. \"You cannot stop the all-consuming darkness. Behold, how deep even the mighty Titans of the {GLOBAL.ArchonsLoreConcept.Hyperlink} can fall...\" {Merlin.FirstName} gestures and another Ruler appears in front of you, a [hyperlink,GLOBAL.RevenantsLoreConcept]Revenant[/hyperlink], whose undead gaze falls upon you coldly. \"{Revenant.FirstName} now too serves Urrath, as all of us will. Through our work, all will cease to be.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1783@BUTTON_0"
msgstr "\"I will never bow to a fallen wizard like you.\" [influence/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1783@BUTTON_1"
msgstr "Allow Urrath to caress your mind [knowledge/], if only for a moment... [evilact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1783@TITLE"
msgstr "Darkness Reigns"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1784@BODY_FOOTER"
msgstr "Julia's expression hardens. \"You took that choice from me, {Merlin.FirstName}, as much as [hyperlink,GLOBAL.LithylTrueLoreConcept]Lithyl[/hyperlink] did. And now all other [hyperlink,GLOBAL.WorldsWithinLoreConcept]Worlds[/hyperlink] suffer because of the talents you allowed {GLOBAL.UrrathLoreConcept.Hyperlink} to corrupt.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1784@BODY_HEADER"
msgstr "\"Oh, Merlin... What happened to you.\" {Julia.FirstName} appears, and {Merlin.FirstName} winces, startled.[br/]\"Julia? You're- I did not mean for this to happen.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1784@BODY_LORE"
msgstr "\"And yet, you chose this.\" {Julia.FirstName} says sadly. \"What have you done?\"[br/]\"I did this for you,\" {Merlin.FirstName} protests. \"For...\"[br/]\"Your actions may have come from love, but they caused so much suffering.\" {Julia.FirstName} says. \"I would have never agreed to what you sacrificed to grant me my freedom... And I think you knew.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1784@BUTTON_0"
msgstr "\"Perhaps death truly is a mercy.\" [unit/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1784@BUTTON_3"
msgstr "\"It is never too late to right what is wrong.\" [relationLvl3/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1784@TITLE"
msgstr "Love and Suffering"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1785@BODY_FOOTER"
msgstr "\"I refuse to kill one of [hyperlink,GLOBAL.AthlaLoreConcept]Athla's[/hyperlink] greatest heroes. That is why I am here. I believe I can save {Merlin.FirstName}, instead of smiting him.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1785@BODY_HEADER"
msgstr "{Sundren.FirstName} meets Julia's stern gaze. \"I did not make my decisions lightly, mother... I am here to shape the war against {GLOBAL.UrrathLoreConcept.Hyperlink}.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1785@BODY_LORE"
msgstr "{Sundren.FirstName} pauses for a moment. \"Do you know who we are facing here, on the {EventRealm}? Who the {GLOBAL.ArchonsLoreConcept.Hyperlink} asked you to fight? Mother, Urrath's greatest thrall is {Merlin.FirstName}. That is who you are asked to destroy.\" {Julia.FirstName} pales and Sundren's expression darkens as she continues: \"I refuse to join the endless wheel of war and destruction.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1785@BUTTON_0"
msgstr "Keep listening."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1785@TITLE"
msgstr "Fate's Trail Divides"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1786@BODY_FOOTER"
msgstr "\"I hereby grant you, {PlayerLeader.TitleName}, the Aspect of Shadow, and my aid.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1786@BODY_HEADER"
msgstr "{Sundren.FirstName} nods. \"This realm contains Aspects of each [hyperlink,GLOBAL.AffinitiesLoreConcept]Affinity[/hyperlink]. Channeling them attracts the attention of the {GLOBAL.EndailonLoreConcept.Hyperlink}.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1786@BODY_LORE"
msgstr "\"I have already committed myself too closely to the Aspect of Shadow to channel the others. And, seeing how you pierced through the {GLOBAL.ShadowRealmLoreConcept.Hyperlink} where I could not... Perhaps it is time I place my faith in another {GLOBAL.GodirLoreConcept.Hyperlink}. I can open <<m:EventGate>> towards the Aspects, near Merlin's old research site. But I ask you to channel them and find a path of redemption for {Merlin.FirstName}, my mentor... my friend.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1786@BUTTON_0"
msgstr "\"Join me as a Hero then, {Sundren.FirstName}.\" [unit/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1786@BUTTON_3"
msgstr "\"I do not require your aid.\" [influence/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1786@TITLE"
msgstr "The Aspect of Shadow"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1822@BODY_FOOTER"
msgstr "The feeling fades, but you notice that someone—or something—is watching you, asking you to proceed further through the frozen halls."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1822@BODY_HEADER"
msgstr "Your army, having traversed grand frozen peaks, enters a massive hallway. Several cave-ins block your path, but an icy draft suggests a path forward."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1822@BODY_LORE"
msgstr "You notice these walls are not natural. They were finely crafted by hands bigger than those of any other regular mortal. Suddenly, you are overwhelmed with its beauty. The quality of the material, the craftsmanship, the promise of untold treasures at the end of this hallway... It beckons you further. To uncover its creator."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1822@BUTTON_0"
msgstr "Nowhere to go but forward."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1822@TITLE"
msgstr "Giant Empires Fall"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1823@BODY_FOOTER"
msgstr "The awakened Giant regards you with infinite patience. \"Why are you here, on this realm of dust and ruin?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1823@BODY_HEADER"
msgstr "You enter the grand halls of the Frost Giant who slumbers here and notice how the walls and floor start to rumble as something awakens deeper within."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1823@BODY_LORE"
msgstr "\"Godir,\" the Giant rumbles. \"My {GiantRace} and I have slept in ice so the [hyperlink,GLOBAL.ShadowRealmLoreConcept]dark affliction[/hyperlink] could not reach us. I have seen many Giant Empires fall, mine will not be one of them. I will not face the darkness alone. Yet, you dug and tore to reach us, to awaken us. Why?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1823@BUTTON_0"
msgstr "\"I was sent here by Magehaven.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1823@BUTTON_1"
msgstr "\"I fight to aid the Archons.\" [knowledge/] [relationLvl-3/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1823@BUTTON_2"
msgstr "\"I am here for the glory of Myrrida!\" [relationLvl3/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1823@BUTTON_3"
msgstr "\"I am here to save lost souls.\" [goodact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1823@BUTTON_4"
msgstr "\"I am here for naught but my own glory!\" [influence/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1823@BUTTON_5"
msgstr "\"I am here to form an alliance against the Umbral Abyss!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1823@TITLE"
msgstr "Giant Empires Fall: {Giant.FirstName}"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1828@BODY_FOOTER"
msgstr "You approach the frozen capital of the Giant who once ruled here. A rumbling feeling from before pushes you onward, promising treasures and marvels to the one who awakens <<P:Giant>>."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1828@BODY_HEADER"
msgstr "You fought and dug your way through the frozen cave. Strangely enough, the cold only seems to increase, the deeper you go."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1828@BODY_LORE"
msgstr "The frost-covered walls tell the story of the [hyperlink,GLOBAL.GiantKingLoreConcept]Giant Kings[/hyperlink] of {GLOBAL.MyrridaLoreConcept.Hyperlink}, their wars against {GLOBAL.DragonsLoreConcept.Hyperlink} and {GLOBAL.ArchonsLoreConcept.Hyperlink}, and their inevitable downfall. One [hyperlink,GLOBAL.GiantsLoreConcept]Giant[/hyperlink] stood high atop the mountain peaks and watched as the realm was finally invaded by the {GLOBAL.ShadowRealmLoreConcept.Hyperlink}. The final carving shows how the Giant and <<o:Giant>> people hid underground and encased themselves in ice."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1828@BUTTON_0"
msgstr "I will meet this slumbering Giant."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1828@TITLE"
msgstr "Giant Empires Fall: Frozen Dreams"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1829@BODY_FOOTER"
msgstr "\"The world crafter, master of creation,\" {Giant.FirstName} whispers. \"It grants you its blessing. A great honor.\" You feel the power of the creator flow through you. You..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1829@BODY_HEADER"
msgstr "{Giant.TitleName} nods slowly. \"I see...\" Then <<p:Giant>> stirs as something else overwhelms your senses."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1829@BODY_LORE"
msgstr "Icicles shatter and rocks tumble as a tremor runs through the underground. You see cracks in the walls open and reveal veins of precious minerals. You feel the ground beneath you shift and mold, as if the realm itself takes a deep breath. You feel the grandeur of the mountains above and the pressure of molten earth below. Infinite clay, infinite potential."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1829@BUTTON_0"
msgstr "... Pull riches [gold/] from the earth."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1829@BUTTON_3"
msgstr "... Form a non-living metal servant. [unit/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1829@BUTTON_4"
msgstr "... Call forth a creator of stone and rock. [unit/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1829@BUTTON_5"
msgstr "... Bless your cities with prosperity. [structureprod/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1829@TITLE"
msgstr "The Aspect of Materium"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1835@BODY_FOOTER"
msgstr "\"I take no joy in seeing our old enemies turned into thralls of [hyperlink,GLOBAL.UrrathLoreConcept]Urrath[/hyperlink]. But I will not hesitate to strike them down.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1835@BODY_HEADER"
msgstr "You sense the presence of {Giant.FirstName}. \"{Revenant.FirstName}...\" <<Cp:Giant>> growls. \"I remember <<P:Revenant>>. A Titan of the {GLOBAL.ArchonsLoreConcept.Hyperlink}, who fell battling my kin.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1835@BODY_LORE"
msgstr "\"Now, {Revenant.FirstName} returns from the dead, a twisted jest of fate. These {GLOBAL.RevenantsLoreConcept.Hyperlink} remind me of the desperate cursed magics of my [hyperlink,GLOBAL.GiantsLoreConcept]kin's[/hyperlink] {GLOBAL.TraitorKingsLoreConcept.Hyperlink}. Could our Traitor Kings have inspired the tainted touch of [hyperlink,GLOBAL.UrrathLoreConcept]Urrath[/hyperlink] and these fallen {GLOBAL.ArchonsLoreConcept.Hyperlink}? Did my kin's knowledge bring about this realm's doom?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1835@BUTTON_0"
msgstr "\"Our holy light shall cleanse this realm's affliction.\" [orderboon/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1835@BUTTON_3"
msgstr "\"Only through wild magics can we purge ourselves of any thralldom!\" [chaosboon/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1835@BUTTON_4"
msgstr "\"The knowledge we keep will protect us against this cursed fate.\" [astralboon/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1835@BUTTON_5"
msgstr "\"Even through the Umbral Abyss, nature will prevail.\" [natureboon/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1835@BUTTON_6"
msgstr "\"Urrath can taint all but gold and rock, so to gold and rock we must turn.\" [materiumboon/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1835@BUTTON_7"
msgstr "\"Only by accepting our own shadow can be learn to pass through it.\" [shadowboon/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1835@BUTTON_8"
msgstr "\"Through strong bonds [relationLvl3/] we can overcome any threat.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1835@TITLE"
msgstr "Highest Rise, Deepest Fall"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1841@BODY_FOOTER"
msgstr "\"The path forward will be risky and costly,\" {Sundren.FirstName} warns you. \"One misstep can mean it was all for naught. But it is the only way.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1841@BODY_HEADER"
msgstr "Your siege of {MerlinCapital} is completed. Your troops prepare themselves for a possible final battle at the heart of the {GLOBAL.ShadowRealmLoreConcept.Hyperlink} on this realm."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1841@BODY_LORE"
msgstr "\"This is our chance,\" {Sundren.FirstName} says. \"With its defenses breached, I found a way into {MerlinCapital}. At his throne, we can use <<g:connection^n,Merlin>> to the greater magics to end [hyperlink,GLOBAL.UrrathLoreConcept]Urrath's[/hyperlink] grasp on him!\"[br/]{Julia.FirstName} nods slowly. \"The {GLOBAL.ArchonsLoreConcept.Hyperlink} wish for us to smite any [hyperlink,GLOBAL.ShadowRealmLoreConcept]Umbral agent[/hyperlink] without mercy. And yet... Ages ago, {Merlin.FirstName} used his magic to save me from possession. Perhaps it can be done.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1841@BUTTON_0"
msgstr "Initiate the ritual to break Merlin from Urrath's grasp."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1841@BUTTON_3"
msgstr "\"No, Merlin must be defeated and the Umbral Abyss eradicated.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1841@BUTTON_4"
msgstr "a"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1841@BUTTON_5"
msgstr "a"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1841@TITLE"
msgstr "The Cost of Mercy"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1850@BODY_FOOTER"
msgstr "{Merlin.FirstName} connects to the {GLOBAL.AstralSeaLoreConcept.Hyperlink}. Arcane energies twist, and visions of places far beyond your reach threaten to flood your mind. You..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1850@BODY_HEADER"
msgstr "With effort, {Sundren.FirstName} shrouds you and {Julia.FirstName} in shadows. You sneak past {GLOBAL.ShadowDemonsLoreConcept.Hyperlink} and city guards, into the heart of {MerlinCapital}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1850@BODY_LORE"
msgstr "As soon as you enter the throne room, the heavy air of the {GLOBAL.ShadowRealmLoreConcept.Hyperlink} befalls you. \"You,\" {Merlin.FirstName} sighs. \"Why do you persevere? You are too late, my experiments are nearly done. {GLOBAL.UrrathLoreConcept.Hyperlink} reaches all... Behold.\"[br/]You can sense {Merlin.FirstName} call upon a twisted form of pure magic. \"There it is,\" {Sundren.FirstName} shouts, \"this connection! Channel its Aspect to fight back Urrath's corruption!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1850@BUTTON_0"
msgstr "... Channel the Aspect of Chaos."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1850@BUTTON_10"
msgstr "Channel all Aspects (TEMP BUTTON)"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1850@BUTTON_3"
msgstr "... Channel the Aspect of Order."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1850@BUTTON_5"
msgstr "... Channel the Aspect of Astral."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1850@BUTTON_6"
msgstr "... Channel the Aspect of Materium."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1850@BUTTON_7"
msgstr "... Channel the Aspect of Nature."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1850@BUTTON_8"
msgstr "... Channel the Aspect of Shadow."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1850@BUTTON_9"
msgstr "... Give up and fight Merlin directly, as the Archons intended."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1850@TITLE"
msgstr "Corrupted Connections"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1851@BODY_FOOTER"
msgstr "{Sundren.FirstName} screams and blinks you away, outside of {MerlinCapital}. After a short silence, Julia says, softly: \"It seems there is only one path forward now. {Merlin.FirstName} must be defeated.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1851@BODY_HEADER"
msgstr "You attempt to banish the corruption of {GLOBAL.UrrathLoreConcept.Hyperlink}, but your channeled Aspect does not match the one corrupted by {Merlin.FirstName}. Your attempt fails."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1851@BODY_LORE"
msgstr "{Sundren.FirstName} curses. \"No, no! This was supposed to work! {Merlin.FirstName}, you taught me this! You were supposed to break free!\"[br/]\"Foolish girl,\" {Merlin.FirstName} sighs. \"Even your light will flicker and die in the embrace of Urrath...\"[br/]{Julia.FirstName} closes her eyes, unable to look on further, as dark tentacles threaten to wrap around her and you."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1851@BUTTON_0"
msgstr "So be it."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1851@TITLE"
msgstr "For Naught"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1854@BODY_FOOTER"
msgstr "{Merlin.FirstName} calls upon forces of wild magic. Demons appear, screaming as eldritch tentacles tear into their infernal flesh. Madness threatens to overwhelm you. You..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1854@BODY_HEADER"
msgstr "{Merlin.FirstName} grimaces when you channel the arcane power of Astral. Overwhelmed by its force, Merlin's corrupted connection is replaced with something... pure."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1854@BODY_LORE"
msgstr "An annoyed tentacle quickly snaps the connection, and {Merlin.FirstName} taps into a different source of magic. You sense how the temperature in the throne room starts to rise, you see how corrupted tendrils reach into demonic figures that rise from the heat. Anarchy, destruction, and rage, corrupted by passivity, disdain, and the craving for the complete undoing of creation."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1854@BUTTON_0"
msgstr "... Channel the Aspect of Chaos."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1854@BUTTON_3"
msgstr "... Channel the Aspect of Order."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1854@BUTTON_5"
msgstr "... Channel the Aspect of Astral."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1854@BUTTON_6"
msgstr "... Channel the Aspect of Materium."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1854@BUTTON_7"
msgstr "... Channel the Aspect of Nature."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1854@BUTTON_8"
msgstr "... Channel the Aspect of Shadow."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1854@BUTTON_9"
msgstr "... Give up and fight Merlin directly, as the Archons intended."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1854@TITLE"
msgstr "Corrupted Connections"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1855@BODY_FOOTER"
msgstr "Corrupted plants burst in your wake. You hear the wailing of animals, desperate to escape the poisonous air that fills the room. You..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1855@BODY_HEADER"
msgstr "You channel pure Chaos, the heat of its passion burning away the corruption. {Merlin.FirstName} wails as the emotions that {GLOBAL.UrrathLoreConcept.Hyperlink} had suppressed for so long crash into him."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1855@BODY_LORE"
msgstr "{Merlin.FirstName} tears away his connection to Chaos. His gaze snaps to {Julia.FirstName}. \"You,\" he says to her in a voice not his own, \"you, too, shall fall... Child of Inioch.\" The air grows heavy as thorns burst from the ground, glistening with dark poison. {Julia.FirstName} winces as she readies herself against the corruption of her powers."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1855@BUTTON_0"
msgstr "... Channel the Aspect of Chaos."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1855@BUTTON_3"
msgstr "... Channel the Aspect of Order."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1855@BUTTON_5"
msgstr "... Channel the Aspect of Astral."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1855@BUTTON_6"
msgstr "... Channel the Aspect of Materium."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1855@BUTTON_7"
msgstr "... Channel the Aspect of Nature."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1855@BUTTON_8"
msgstr "... Channel the Aspect of Shadow."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1855@BUTTON_9"
msgstr "... Give up and fight Merlin directly, as the Archons intended."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1855@TITLE"
msgstr "Corrupted Connections"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1856@BODY_FOOTER"
msgstr "Your armor and the ground beneath you start to crumble and decay under Merlin's arcane pressure. Wealth, the power of the elements, nothing matters under the eye of Urrath. You..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1856@BODY_HEADER"
msgstr "You channel the growth of Nature, healing the ground beneath you and spreading a rejuvenating aura around you, {Julia.FirstName} and {Sundren.FirstName}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1856@BODY_LORE"
msgstr "{Julia.FirstName} sighs in relief. \"You will not take me, {GLOBAL.UrrathLoreConcept.Hyperlink}!\" She shouts, channeling protective growths around her and {Merlin.FirstName}. \"Merlin! Fight back! I know you can!\"[br/]{Merlin.FirstName} opens his mouth to speak, but an enraged tentacle severs his connection to nature. {Merlin.FirstName} groans and the ground begins to tremble, crushing the young plants that grow into the throne room."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1856@BUTTON_0"
msgstr "... Channel the Aspect of Chaos."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1856@BUTTON_3"
msgstr "... Channel the Aspect of Order."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1856@BUTTON_5"
msgstr "... Channel the Aspect of Astral."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1856@BUTTON_6"
msgstr "... Channel the Aspect of Materium."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1856@BUTTON_7"
msgstr "... Channel the Aspect of Nature."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1856@BUTTON_8"
msgstr "... Channel the Aspect of Shadow."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1856@BUTTON_9"
msgstr "... Give up and fight Merlin directly, as the Archons intended."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1856@TITLE"
msgstr "Corrupted Connections"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1857@BODY_FOOTER"
msgstr "{Merlin.FirstName} attempts to corrupt another Affinity. Its authority smothers you, claws its way inside of your soul, replacing faith with mindless servitude. You..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1857@BODY_HEADER"
msgstr "You channel the strength of Materium. The earth roars, a tempest batters {Merlin.FirstName}, and the building wards itself against the {GLOBAL.ShadowRealmLoreConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1857@BODY_LORE"
msgstr "{Merlin.FirstName} yelps. Desperate and overwhelmed, he grasps for another Affinity, before he looks at you with newfound authority. You feel a light, like the light of an eclipse or a dying sun. It is bright—too bright, and wrong, devoid of any warmth. \"Where flames burn brightest, shadows root the deepest,\" Merlin mutters. \"Even the {GLOBAL.ArchonsLoreConcept.Hyperlink}... Must fall...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1857@BUTTON_0"
msgstr "... Channel the Aspect of Chaos."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1857@BUTTON_3"
msgstr "... Channel the Aspect of Order."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1857@BUTTON_5"
msgstr "... Channel the Aspect of Astral."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1857@BUTTON_6"
msgstr "... Channel the Aspect of Materium."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1857@BUTTON_7"
msgstr "... Channel the Aspect of Nature."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1857@BUTTON_8"
msgstr "... Channel the Aspect of Shadow."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1857@BUTTON_9"
msgstr "... Give up and fight Merlin directly, as the Archons intended."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1857@TITLE"
msgstr "Corrupted Connections"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1858@BODY_FOOTER"
msgstr "\"Quick, {PlayerLeader.FirstName}, channel the final Aspect! He cannot escape the Shadow, the {GLOBAL.ShadowRealmLoreConcept.Hyperlink} is tied to it!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1858@BODY_HEADER"
msgstr "You channel the Aspect of Order, its burning light burns away any corruption that threatened it, and you."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1858@BODY_LORE"
msgstr "{Merlin.FirstName} screams in pain and quickly severs the divine connection. Only one Affinity remains tethered to {Merlin.FirstName} and the {GLOBAL.ShadowRealmLoreConcept.Hyperlink}. The darkest one, its roots interwoven with the Abyss itself. \"Death and frost,\" {Merlin.FirstName} coughs, \"never the beginning, never the end...\"[br/]{Sundren.FirstName} growls. \"You may have corrupted the {GLOBAL.AstralVoidLoreConcept.Hyperlink} you crawled out of, but you know the {GLOBAL.EndailonLoreConcept.Hyperlink} can fight you.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1858@BUTTON_0"
msgstr "... Channel the Aspect of Chaos."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1858@BUTTON_3"
msgstr "... Channel the Aspect of Order."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1858@BUTTON_5"
msgstr "... Channel the Aspect of Astral."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1858@BUTTON_6"
msgstr "... Channel the Aspect of Materium."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1858@BUTTON_7"
msgstr "... Channel the Aspect of Nature."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1858@BUTTON_8"
msgstr "... Channel the Aspect of Shadow."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1858@BUTTON_9"
msgstr "... Give up and fight Merlin directly, as the Archons intended."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1858@TITLE"
msgstr "Corrupted Connections"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1859@BODY_FOOTER"
msgstr "Finally, Merlin's gaze becomes sharp and for the first time he seems to truly see the ones before him. \"{Sundren.FirstName}... {Julia.FirstName}? What did I... I...\" He gasps, and collapses."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1859@BODY_HEADER"
msgstr "You channel the Aspect of Shadow, its pure power clashing with the corruption of {GLOBAL.UrrathLoreConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1859@BODY_LORE"
msgstr "{Merlin.FirstName} screams, and desperate tentacles strike at the connection, but the {GLOBAL.ShadowRealmLoreConcept.Hyperlink} is too entwined with Shadow to tear away. Eldritch limbs freeze and decay in the cold darkness as the Shadow regains its pure strength, crawling its way to Merlin, tearing at his corrupted arcane power. With all Affinities combined, his connection to {GLOBAL.UrrathLoreConcept.Hyperlink} weakens."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1859@BUTTON_0"
msgstr "Grant mercy to Merlin and set him on a path of restoration."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1859@BUTTON_6"
msgstr "Defeat Merlin and banish him to the void."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1859@BUTTON_9"
msgstr "c"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1859@TITLE"
msgstr "Corruption Severed"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1865@BODY_FOOTER"
msgstr "\"You will find our champion in the north. <<Cp:Julia>> may not be an Archon, but <<p:Julia>> will be a powerful ally to your cause.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1865@BODY_HEADER"
msgstr "Before you can investigate further, a divine chime interrupts your thoughts and you are contacted by an [hyperlink,GLOBAL.ArchonsLoreConcept]Archon[/hyperlink]."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1865@BODY_LORE"
msgstr "\"Hail, {PlayerLeader.TitleName}. I am {Anon.FirstName}, {Anon.Title}. It was I who recorded the Prophecy that brought you here. 'Tis a strange twist of fate, to write the very Prophecy that forbids me to act upon it. Alas, as an Archon myself, I must abide by it, and will instead provide insight where I can.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1865@BUTTON_0"
msgstr "\"Tell me more about this Prophecy.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1865@BUTTON_1"
msgstr "\"Very well, I will find this ally.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1865@TITLE"
msgstr "Divine Mandate"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1870@BODY_FOOTER"
msgstr "\"The {EventRealm} used to be part of {GLOBAL.MyrridaLoreConcept.Hyperlink}. We believe Traitor's Blood connects to those who stand by {GLOBAL.UrrathLoreConcept.Hyperlink}. Lastly, we {GLOBAL.ArchonsLoreConcept.Hyperlink} believe ourselves to be the divine guard, and you, {PlayerLeader.TitleName} are the new power to rise.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1870@BODY_HEADER"
msgstr "{Anon.FirstName} nods gravely, recalling his own Prophecy:"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1870@BODY_LORE"
msgstr "\"Divine Myopia; Balance Enchained;[br/]Giant Empires Fall; Darkness Reigns;[br/]From Traitor's Blood; Fate's Trail Divides;[br/]Corruption Cleansed, Through Fractured Light;[br/]Divine Guard must Rest; For New Powers to Rise;[br/]Who Weigh the Cost of Mercy; Against a Vengeful Demise.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1870@BUTTON_0"
msgstr "\"Very well.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1870@TITLE"
msgstr "The Prophecy of Anon"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1878@BODY_FOOTER"
msgstr "{Sundren.Name} was wounded, but has escaped death. It will take some time for her to regrow her strength."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1878@BODY_HEADER"
msgstr "{Sundren.TitleName} was defeated in battle under your command!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1878@BODY_LORE"
msgstr "Through effort, luck, or something else entirely, she managed to survive the onslaught and made it back to safety, where she appears in a cloud of shadows. She grimaces, a darker expression marking her face before the shadows disappear and she turns to you again. \"I have withstood many hardships in the {GLOBAL.AstralVoidLoreConcept.Hyperlink}. It shall not claim me yet.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1878@BUTTON_0"
msgstr "So be it."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1878@TITLE"
msgstr "Sundren Defeated"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1881@BODY_FOOTER"
msgstr "\"The Archon High Council urge you to stay on course of your mission: to destroy the {GLOBAL.ShadowRealmLoreConcept.Hyperlink} and all who affiliate with it.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1881@BODY_HEADER"
msgstr "{Anon.FirstName} approaches you once more. \"The [hyperlink,GLOBAL.ArchonsLoreConcept]Archon[/hyperlink] High Council are happy to see {Sundren.FirstName} and {Julia.TitleName} reunited. The love between mother and daughter burns strong.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1881@BODY_LORE"
msgstr "\"However, I was asked to convey the Archons' stance on {Sundren.FirstName}...\" {Anon.FirstName} sighs and continues: \"Let it be known {Sundren.Name} is a known rogue, a loose blade who unshackled cosmic forces meant to stay bound. Let any who heed her words do so with utmost caution, for her path strays far from order... Much like her grandfather's.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1881@BUTTON_0"
msgstr "\"I will heed the Council's warning.\" [unit/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1881@BUTTON_3"
msgstr "\"The Archons hold no power here, I do what I decree is right.\" [influence/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1881@TITLE"
msgstr "Blood of Inioch"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1883@BODY_FOOTER"
msgstr "{Sundren.FirstName} interjects. \"The Archon High Council are blind to any other interpretation. How are they so sure whose blood this 'Traitor's Blood' is? There are other paths to salvation than through holy fire and blade.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1883@BODY_HEADER"
msgstr "You have collected multiple Aspects of the Affinities on the {EventRealm}. {Anon.FirstName} appears before you once more."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1883@BODY_LORE"
msgstr "\"It has come to the attention of the [hyperlink,GLOBAL.ArchonsLoreConcept]Archon[/hyperlink] High Council that you are focusing on a side-track to your mission, coming in contact with the {GLOBAL.EndailonLoreConcept.Hyperlink}.\" {Anon.FirstName} pauses for a moment. \"The High Council condemns this path, for the Prophecy states that the blood of the traitors {Merlin.FirstName} and {Revenant.FirstName} must flow.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1883@BUTTON_0"
msgstr "\"The Archons are right, Urrath must be destroyed.\" [unit/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1883@BUTTON_3"
msgstr "\"Sundren is right, there may be other ways.\" [morale/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1883@BUTTON_4"
msgstr "\"I will find my own way forward.\" [influence/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1883@BUTTON_5"
msgstr "\"I am here to fight, not to discuss Prophecies!\" [unitprod/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1883@TITLE"
msgstr "Divine Dispute"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1885@BODY_FOOTER"
msgstr "\"I believe the Endailon and their Aspects are the Fractured Light mentioned in the Prophecy, and Traitor's Blood... I think that may be... me.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1885@BODY_HEADER"
msgstr "After you initiate your siege of the capital of {Merlin.FirstName}, {Sundren.FirstName} appears before you. \"Soon we will confront {Merlin.FirstName} at his throne.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1885@BODY_LORE"
msgstr "\"I have been thinking about the Prophecy, especially after {Anon.FirstName} mentioned my grandfather, Emperor Inioch of {GLOBAL.AthlaLoreConcept.Hyperlink}. Inioch once broke an ancient covenant with the Archons, which led to much strife on Athla. My entire family bears its scars, and I have also invoked the Archons' ire. Could it be... Traitor's Blood...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1885@BUTTON_0"
msgstr "\"No way to go now but forward.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1194_1885@TITLE"
msgstr "Traitor's Blood"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_109@BODY_FOOTER"
msgstr "What will be the fate of this Angelic envoy?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_109@BODY_HEADER"
msgstr "After the battle, a radiant flash blinds you—leaving behind an Angelic figure bound in chains."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_109@BODY_LORE"
msgstr "The Angel lifts <<o:EventUnit>> face and speaks with a trembling voice: \"At last... the [hyperlink,GLOBAL.ArchonsLoreConcept]Archons[/hyperlink] have heard my prayers. I implore you—free me from these bonds. I was imprisoned and left to be guarded by those you defeated, destined to be sacrificed. My body no longer has the strength to fight... but my voice still holds. Free me, and I will be your herald.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_109@BUTTON_0"
msgstr "\"Your intervention in {EventHouse} would be most welcome.\" [allegiance/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_109@BUTTON_1"
msgstr "\"{EventHouseB} calls for your guiding presence.\" [allegiance/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_109@BUTTON_2"
msgstr "\"May your voice reach {EventHouseC}.\" [allegiance/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_109@BUTTON_3"
msgstr "\"No reward is needed to do what is right.\" [goodact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_109@BUTTON_4"
msgstr "\"You will fulfill your purpose as a sacrifice!\" [evilact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_109@TITLE"
msgstr "Angelic Envoy"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_113@BODY_FOOTER"
msgstr "The {OracleUnit} awaits an answer to <<o:OracleUnit>> plea. What will {EventHero.TitleName} do to those who dare to meddle with destiny?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_113@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "The {OracleUnit} awaits an answer to <<o:OracleUnit>> plea. What will you do to those who dare to meddle with destiny?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_113@BODY_HEADER"
msgstr "A hooded figure approaches {EventHero.Name}. Revealing herself as an {OracleUnit}—those who read the stars in the {EventStructure}—she proclaims:"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_113@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "A hooded figure approaches you. Revealing herself as an {OracleUnit}—those who read the stars in the {EventStructure}—she proclaims:"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_113@BODY_LORE"
msgstr "\"Grand Liberator {EventHero.Name}... It was foretold you would arrive in a time of great need. The {EventStructure} has fallen into the hands of <<a:EventStackLeader>> and <<o:EventStackLeader>> acolytes. They are forcing us to predict their futures, seeking to exploit this knowledge for their own gain. I escaped the temple to bring you this message... but my sisters remain trapped.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_113@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "\"Grand Liberator {EventHero.Name}... it was foretold you would arrive in a time of great need. The {EventStructure} has fallen into the hands of {EventStackLeader} and <<o:EventStackLeader>> acolytes. They are forcing us to predict their futures, seeking to exploit this knowledge for their own gain. I escaped the temple to bring you this message... but my sisters remain trapped.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_113@BUTTON_0"
msgstr "\"Attack!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_113@BUTTON_1"
msgstr "Ask the {OracleUnit} for a divination [mana/] of the upcoming battle."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_113@BUTTON_2"
msgstr "Convince [influence/] the {OracleUnit} that <<p:EventHero>> will need <<o:OracleUnit>> help to reconquer the {EventStructure}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_113@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "Convince [influence/] the {OracleUnit} that you will need <<o:OracleUnit>> help to reconquer the {EventStructure}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_113@BUTTON_3"
msgstr "Read the stars to predict the enemy's tactics."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_113@BUTTON_4"
msgstr "Embrace the shadows to cast a curse upon the acolytes."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_113@TITLE"
msgstr "Forcing Fate"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_114@BODY_FOOTER"
msgstr "What weighs upon the mind of {EventHero.Name}? The wars to come? The wealth of the kingdom? <<Co:EventHero>> uncertain fate?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_114@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "What weighs upon your mind? The wars to come? The wealth of the kingdom? Your uncertain fate?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_114@BODY_HEADER"
msgstr "The last of the acolytes falls—for knowing the future does not grant the power to prevent it."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_114@BODY_LORE"
msgstr "The Star Seer, high priestess of the {EventStructure}, approaches {EventHero.Name} and says: \"While the {GLOBAL.ArchonsLoreConcept.Hyperlink} waged war on distant fronts, these thugs seized their chance and claimed this place. But like the stars in the firmament, our destiny shines brightly once more. Grand Liberator, allow us to shed light on your future, as a token of our gratitude.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_114@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "The Star Seer, high priestess of the {EventStructure}, approaches you and says: \"While the {GLOBAL.ArchonsLoreConcept.Hyperlink} waged war on distant fronts, these thugs seized their chance and claimed this place. But like the stars in the firmament, our destiny shines brightly once more. Grand Liberator, allow us to shed light on your future, as a token of our gratitude.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_114@BUTTON_0"
msgstr "Ask for a prophecy about war. [unitprod/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_114@BUTTON_1"
msgstr "Ask for a prophecy about prosperity. [food/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_114@BUTTON_2"
msgstr "Ask for a personal prophecy. [xp/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_114@TITLE"
msgstr "Forcing Fate: Aftermath"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_134@BUTTON_5"
msgstr "Channel <<o:EventHero>> sacred duty to bring judgment upon the wicked."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_134@BUTTON_5@HERO_IS_PLAYERLE"
msgstr "Channel your sacred duty to bring judgment upon the wicked."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_134@BUTTON_6"
msgstr "Leave the place for the moment."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_136@BODY_FOOTER"
msgstr "{EventHero.TitleName} has only a few seconds before the guards attack <<P:EventHero>>. What will <<p:EventHero>> do?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_136@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "You have only a few seconds before the guards attack. What will you do?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_136@BODY_HEADER"
msgstr "The footsteps of {EventHero.TitleName} echo through the halls of the {EventStructure}. A figure scribbles in a colossal tome."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_136@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Your footsteps echo through the halls of the {EventStructure}. An {EventUnit} scribbles in a colossal tome."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_136@BODY_LORE"
msgstr "The {EventUnit} continues writing as <<p:EventUnit>> clamors: \"The [hyperlink,GLOBAL.ArchonsLoreConcept]Archons[/hyperlink] condemned us for recording the deaths foretold in the stars. But there is one name that returns again and again, an impossible blasphemy, a chance of redemption. The death of {PlayerLeader.TitleName} was decreed by fate long ago. Today, I will correct this flaw in destiny, starting with <<o:PlayerLeader>> vassal.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_136@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "The {EventUnit} continues writing as <<p:EventUnit>> clamors: \"The [hyperlink,GLOBAL.ArchonsLoreConcept]Archons[/hyperlink] condemned us for recording the deaths foretold in the stars. But there is one name that returns again and again, an impossible blasphemy, a chance of redemption. Your death was decreed by fate long ago, {PlayerLeader.TitleName}. Today, I will correct this flaw in destiny\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_136@BUTTON_0"
msgstr "\"Attack!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_136@BUTTON_1"
msgstr "Proclaim [influence/] the eternal glory of <<g: immortal reign^n,{PlayerLeader.TitleName}>>."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_136@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "Proclaim [influence/] the eternal glory of your immortal reign."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_136@BUTTON_2"
msgstr "Cast [mana/] a spell to keep <<r:EventHero>> alive in <<o:EventHero>> last stand."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_136@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "Cast [mana/] a spell to keep yourself alive in your last stand."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_136@BUTTON_4"
msgstr "Draw strength from the Astral Plane to keep <<r:EventHero>> alive in <<o:EventHero>> last stand."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_136@BUTTON_4@HERO_IS_PLAYERLE"
msgstr "Draw strength from the Astral Plane to keep yourself alive in your last stand."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_136@BUTTON_5"
msgstr "\"Not even death dares to bind me.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_136@BUTTON_6"
msgstr "\"The righteous shall rise once more.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_136@BUTTON_7"
msgstr "Retreat the troops."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_136@TITLE"
msgstr "A Death Foretold"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_137@BODY_FOOTER"
msgstr "What will {EventHero.Name} ask the Star Seer?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_137@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "What will you ask the Star Seer?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_137@BODY_HEADER"
msgstr "The Star Seer—high priestess of the {EventStructure}—kneels before {EventHero.Name}, defeated. Doubts plague <<o:EventUnit>> mind as <<p:EventUnit>> says:"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_137@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "The Star Seer—high priestess of the {EventStructure}—kneels before you, defeated. Doubts plague <<o:EventUnit>> mind as <<p:EventUnit>> says:"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_137@BODY_LORE"
msgstr "\"How can this be? Does fate not want me to succeed? Are the {GLOBAL.GodirLoreConcept.Hyperlink} heralds of fate, and not its detractors? I have much to reflect upon, {EventHero.Name}. This observatory is now yours—please, allow me to serve, so that I might correct my undoing. I possess knowledge that may be of your interest. Ask wisely.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_137@BUTTON_0"
msgstr "Consult the oracle about <<o:EventHero>> death."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_137@BUTTON_0@HERO_IS_PLAYERLE"
msgstr "Consult the oracle about your next death."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_137@BUTTON_1"
msgstr "Let the scholars of {EventCity} pose their questions."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_137@BUTTON_2"
msgstr "Consult the oracle about the death of <<o:EventHero>> enemies."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_137@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "Consult the oracle about the death of your enemies."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_137@TITLE"
msgstr "A Death Foretold: Aftermath"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_138@BODY_FOOTER"
msgstr "{EventHero.Name} troops gather the crystals on their way out. What will {EventHero} do before it all decays?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_138@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Your troops gather the crystals on their way out. What will you do before it all decays?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_138@BODY_HEADER"
msgstr "As the last undead is defeated, the souls start leaving their empty carcasses, echoing like a cursed choir."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_138@BODY_LORE"
msgstr "The voices of the dead chant one final sentence: \"The prophecy was never found. The war against Urrath never ended.\" The columns begin to crack, and the telescopes rust in an instant, suddenly aging. Ancient relics tumble from their shelves, crashing to the floor. As a massive surge of energy is released, mana crystals form throughout the structure."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_138@BUTTON_0"
msgstr "Save one of the relics. [item/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_138@BUTTON_1"
msgstr "Look through the telescope."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_138@BUTTON_2"
msgstr "Harvest the souls of the damned. [souls/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_138@TITLE"
msgstr "Forever in Servitude: Aftermath"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_139@BODY_FOOTER"
msgstr "These {GLOBAL.RevenantsLoreConcept.Hyperlink} are cursed to chase a purpose forever just out of their reach. Will {EventHero.Name} free them from their eternal torment?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_139@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "These {GLOBAL.RevenantsLoreConcept.Hyperlink} are cursed to chase a purpose forever just out of their reach. Will you free them from their eternal torment?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_139@BODY_HEADER"
msgstr "When {EventHero.Name} enters the {EventStructure}, everything seems to be working normally—but something uncanny lingers in the air."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_139@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "When you enter the {EventStructure}, everything seems to be working normally—but something uncanny lingers in the air."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_139@BODY_LORE"
msgstr "The oracles continue their duty of seeking for prophecies in the stars. One of them looks through the telescope. As {EventHero.Name} approaches, the figure turns. <<Co:EventUnit>> face has no eyes. A voice forces its way out of <<o:EventUnit>> throat, as if <<p:EventUnit>> was unused to speaking: \"We must fulfill our task... find the prophecy... defend the {EventStructure}...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_139@BODY_LORE@HERO_IS_PLAYERLE"
msgstr "The oracles continue their duty of seeking for prophecies in the stars. One of them looks through the telescope. As you approach, the figure turns. <<Co:EventUnit>> face has no eyes. A voice forces its way out of <<o:EventUnit>> throat, as if <<p:EventUnit>> was unused to speaking: \"We must fulfill our task... find the prophecy... defend the {EventStructure}...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_139@BUTTON_0"
msgstr "\"We shall destroy these tormented souls!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_139@BUTTON_1"
msgstr "Infuse [mana/] <<o:EventHero>> units with the power to free the souls."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_139@BUTTON_1@HERO_IS_PLAYERLE"
msgstr "Infuse [mana/] your units with the power to free the souls."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_139@BUTTON_2"
msgstr "Produce [structureprod/] holy water and consecrate this Observatory before attacking."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_139@BUTTON_3"
msgstr "Teach <<o:EventHero>> units how to free their souls."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_139@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "Teach your units how to free their souls."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_139@BUTTON_4"
msgstr "\"Their souls belong to me.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_139@BUTTON_5"
msgstr "\"We must embody the light to cast away these shadows!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_139@BUTTON_6"
msgstr "Leave these wretched souls."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_139@TITLE"
msgstr "Forever in Servitude"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_140@BODY_FOOTER"
msgstr "How will {EventHero} face this test of might?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_140@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "How will you face this test of might?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_140@BODY_HEADER"
msgstr "Several figures stand on the high balconies of the {EventStructure}, their silhouettes outlined by a Celestial light behind them."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_140@BODY_LORE"
msgstr "An ominous voice resonates within the structure: \"At last, {EventHero}—the hero we’ve been waiting for. But is <<p:EventHero>> ready to take up <<o:EventHero>> role as Champion of the [hyperlink,GLOBAL.ArchonsLoreConcept]Archons[/hyperlink]? Protect our {ProtectUnit}, and prove that you are not only capable of fighting... but also of nurturing.\"\n"
"\n"
"{ProtectUnit} must survive the battle to pass the [hyperlink,GLOBAL.ArchonsLoreConcept]Archon's[/hyperlink] test."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_140@BUTTON_0"
msgstr "\"Let them witness our glory!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_140@BUTTON_1"
msgstr "Train [unitprod/] the troops to shield, not to strike."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_140@BUTTON_2"
msgstr "Bind the lament of the damned [souls/] to <<o:EventHero>> weapons."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_140@BUTTON_3"
msgstr "Bathe <<r:EventHero>> in the protective light."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_140@BUTTON_3@HERO_IS_PLAYERLE"
msgstr "Bind the lament of the damned [souls/] to your weapons."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_140@BUTTON_4"
msgstr "Call upon the shadows cast by the light."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_140@BUTTON_5"
msgstr "Embrace chaos to fight the order."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_140@BUTTON_6"
msgstr "\"We are not ready for this test yet.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_140@TITLE"
msgstr "Test of Might"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_141@BODY_FOOTER"
msgstr "What great boon will {EventHero} seek?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_141@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "What great boon will you seek?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_141@BODY_HEADER"
msgstr "You stand victorious with the {ProtectUnit} by your side. The [hyperlink,GLOBAL.ArchonsLoreConcept]Archons[/hyperlink] rise, exhausted by the battle."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_141@BODY_LORE"
msgstr "The voice echoes once more in the {EventStructure}: \"The mighty contestant has deemed <<r:EventHero>> worthy. With pride, we name you Champion of the [hyperlink,GLOBAL.ArchonsLoreConcept]Archons[/hyperlink]. The prophecies of [hyperlink,GLOBAL.UrrathLoreConcept]Urrath's[/hyperlink] downfall speak of a hero—and perhaps, that one is you. Take up these sacred arms, forged to shield the helpless. And before your crusade begins, one final blessing will be granted to you.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_141@BUTTON_0"
msgstr "Gain the power to smite your enemies."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_141@BUTTON_1"
msgstr "A glorious {EventUnit} will join [unit/] your army."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_141@BUTTON_2"
msgstr "\"You have misread the prophecy—you will fall by my hand.\" [evilact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_141@TITLE"
msgstr "Test of Might Surpassed: Aftermath"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_142@BODY_FOOTER"
msgstr "Which boon will {EventHero} seek?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_142@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Which boon will you seek?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_142@BODY_HEADER"
msgstr "You withstood the test, but the {ProtectUnit} did not. The [hyperlink,GLOBAL.ArchonsLoreConcept]Archons[/hyperlink] rise, exhausted by the battle."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_142@BODY_LORE"
msgstr "The voice echoes once more through the {EventStructure}: \"Mighty warrior—you have not overcome the test. The mantle of Champion is not yours to bear. But your valor in battle cannot be denied, and every blade is needed in the war against darkness. Take up these sacred arms, and before your crusade begins, one final blessing shall be bestowed upon you.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_142@BUTTON_0"
msgstr "Be empowered with the radiance of the light."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_142@BUTTON_1"
msgstr "A {EventUnit} will join [unit/] your army."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_142@BUTTON_2"
msgstr "\"You have misread the prophecy—you will fall by my hand.\" [evilact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_142@TITLE"
msgstr "Test of Might Survived: Aftermath"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_151@BODY_FOOTER"
msgstr "Which boon will you seek from this divine delegate?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_151@BODY_HEADER"
msgstr "As the skirmish ends, a blazing light dazzles you. From its splendor, an {AngelUnit} emerges."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_151@BODY_LORE"
msgstr "<<Co:AngelUnit>> layered voice—resonating with a metallic harmony—exclaims: \"Be not afraid, for this was your ordeal, and in its glory you have bathed. These foul creatures shall no longer ravage these sacred lands. Rise now, and seize your divine retribution.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_151@BUTTON_0"
msgstr "\"Uplift the glory of {PlayerLeader.TitleName} in the realm.\" [allegiance/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_151@BUTTON_1"
msgstr "Request reinforcements for your crusade. [unit/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_151@BUTTON_3"
msgstr "\"Your blessing alone shall suffice.\" [goodact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_151@BUTTON_4"
msgstr "Strike down the {AngelUnit} in the name of the unholy. [evilact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_151@TITLE"
msgstr "Divine Delegate"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_152@BODY_FOOTER"
msgstr "What task will the penitent endure in your service?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_152@BODY_HEADER"
msgstr "Still captive, a graceful figure stands before you. <<Cp:EventUnit>> wears humble clothes and no shoes, yet there is something divine in <<P:EventUnit>>."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_152@BODY_LORE"
msgstr "<<Cp:EventUnit>> says: \"May the [hyperlink,GLOBAL.ArchonsLoreConcept]Archons[/hyperlink] bless you, my savior. Once, I was among the divine, but now I am nothing more than a penitent. I wander these lands seeking atonement through service to the righteous. Please, allow me to redeem my faults. Tell me—what penance must I endure?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_152@BUTTON_0"
msgstr "\"Walk to a city and proclaim [allegiance/] my glory.\" [goodact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_152@BUTTON_1"
msgstr "\"March as long as your feet can carry you, exalting [allegiance/] my name.\" [evilact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_152@BUTTON_3"
msgstr "\"I will host you in {EventCity}. Spread your good deeds there.\" [goodact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_152@BUTTON_4"
msgstr "Slay the penitent to get <<o:EventUnit>> possessions [item/]. [evilact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_152@TITLE"
msgstr "Fallen From Grace"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_153@BODY_FOOTER"
msgstr "What will you ask from this gentle soul?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_153@BODY_HEADER"
msgstr "When you approach the Angel's body, a soul rises from it. <<Co:EventUnit>> voice, warm as sunshine, says:"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_153@BODY_LORE"
msgstr "\"Well met, wayfarer. What you see at your feet is my body, which could not bear the hardships of my imprisonment. But now, my eternal soul is free. Your actions have brought peace to this unfortunate Angel. Allow me to bestow upon you a parting gift.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_153@BUTTON_0"
msgstr "\"Uplift the glory of {PlayerLeader.TitleName} in the realm.\" [allegiance/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_153@BUTTON_1"
msgstr "\"Grant healing to those who bled for your salvation.\" [goodact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_153@BUTTON_3"
msgstr "\"Do not yet depart, your saviors still need your light.\" [unit/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_153@BUTTON_4"
msgstr "Siphon what remains of the soul's light. [evilact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1224_153@TITLE"
msgstr "Ascension"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_100@BODY_FOOTER"
msgstr "The Astral Aspect was not found here, it is probably hidden elsewhere."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_100@BODY_HEADER"
msgstr "After searching the tower up and down, nothing is found, but then the Aspect speaks to your mind again..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_100@BODY_LORE"
msgstr "\"Look 'ere,\" he begins \"I know that you know you've got some queer new thoughts inside o' you that seem to know more than you gone-thought did before. Just... Focus on that new 'wispy' thought, rite? An you'll know where I'm hidden-like! And no, I cannot just say it, lest {GLOBAL.UrrathLoreConcept.Hyperlink} gone find me. Since he's listening in after all... Now, howay!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_100@BUTTON_0"
msgstr "\"I'll find you yet.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_100@TITLE"
msgstr "Out of Sight, Out of..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_101@BODY_FOOTER"
msgstr "As the remnants of that strange thought fade away, you still hold the fate of the disembodied mind in your hand. What do you do?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_101@BODY_HEADER"
msgstr "After searching the tower, a peculiar crystal skull is found that suddenly begins to talk!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_101@BODY_LORE"
msgstr "\"Knew you'd do it! Ey up, 'tis me! Lo, I'm naught but a disembodied mind now, innit? Well aye, I'll admit 'twas a daft plan, but... Also a last resort, ere {GLOBAL.UrrathLoreConcept.Hyperlink} gone did me like he did poor old {Merlin.FirstName}. Well, y'know what's up, rite? Here, I'll go grant you the Aspect of Astral. Now, before it's all gone, you go and tap into that queer thought from before, now won't ye? Then I'll nip m'self outta here, all teleport-like. Ta-ra!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_101@BUTTON_0"
msgstr "Recruit the speaking skull [item/] to your side."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_101@BUTTON_1"
msgstr "Tap into the fading thought to glean greater wisdom. [knowledge/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_101@BUTTON_2"
msgstr "Destroy the skull [evilact/] and consume its knowledge! [knowledge/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_101@TITLE"
msgstr "An Out of Body Experience: Out of His Mind"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_103@BODY_FOOTER"
msgstr "Reality returns, and your mind is now magnified with a profound clarity as you graduate into the Aspect of Astral."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_103@BODY_HEADER"
msgstr "With a maddening rush, your mind feels suddenly expanded, as if you can hold onto a hundred thoughts all at once!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_103@BODY_LORE"
msgstr "Reality fades away, and with stupendous euphoria your thought-space feels flooded by the omniscience of the cosmos itself. Thinking and knowing coalesce, and it seems as if the thoughts of all beings in existence are available to you now! Though, one clear realization crystallizes above all others, the full knowledge that you are appointed by a higher wisdom—the {GLOBAL.EndailonLoreConcept.Hyperlink} of the Astral!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_103@BUTTON_0"
msgstr "\"I knew this all along.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_103@TITLE"
msgstr "The New Aspect of Astral"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_13@BODY_FOOTER"
msgstr "With a sly grin, <<p:EventHouseLord>> adds, \"I would consider it a great honor if you would sponsor my grand project.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_13@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} announces <<r:EventHouseLord>> with a nervous cough. \"Respected neighbor,\" <<p:EventHouseLord>> begins, \"A moment of your time?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_13@BODY_LORE"
msgstr "\"My rival in the council has challenged my rule with the construction of some lofty monument! I will not be bested, and have therefore devised a most grandiose design that will surely outshine that of my rival!\" <<Cp:EventHouseLord>> shows you <<o:EventHouseLord>> extravagant plans, followed by a painful silence. \"Unfortunately no one in {EventHouse} is willing to sponsor its construction...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_13@BUTTON_0"
msgstr "Refuse to fund this project."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_13@BUTTON_1"
msgstr "\"I can lend you my craftsfolk [structureprod/] instead.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_13@BUTTON_2"
msgstr "Fund [gold/] this opulent project."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_13@BUTTON_3"
msgstr "Secretly sell [gold/] these designs to the rival of <<o:EventHouseLord>>."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_13@BUTTON_4"
msgstr "\"Why build your own? Destroy your rival’s monument instead!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_13@BUTTON_5"
msgstr "Propose a more economic redesign [structureprod/] of <<o:EventHouseLord>> plan."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_13@BUTTON_6"
msgstr "\"Let us think this one through first, shall we?\" [knowledge/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_13@BUTTON_7"
msgstr "Propose to solve this matter through clever statecraft. [influence/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_13@BUTTON_8"
msgstr "\"Do not build sterility, plant fertility! [food/] Let me show you how...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_13@TITLE"
msgstr "Monumental Donations"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_14@BODY_FOOTER"
msgstr "Smiling, <<p:EventHouseLord>> concludes, \"What say you? Will you honor the memory of our late philosopher with an oration?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_14@BODY_HEADER"
msgstr "\"Glory!\" announces {EventHouseLord} with open arms, \"My esteemed confederate, I come before you with a wonderful announcement!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_14@BODY_LORE"
msgstr "\"Today, the people of {EventHouse} celebrate the anniversary of our founding philosopher. As our esteemed friend and a most eminent {GLOBAL.GodirLoreConcept.Hyperlink}, I graciously invite you to honor us by performing the opening oration! Admittedly, the invitation is a bit sudden, but I am certain a capable Godir as yourself will manage just fine.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_14@BUTTON_0"
msgstr "Perform a modestly organized speech. [influence/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_14@BUTTON_1"
msgstr "Demand adequate compensation [gold/] for your time."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_14@BUTTON_2"
msgstr "Just improvise on the spot. [chaosboon/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_14@BUTTON_3"
msgstr "Take this time to moralize the importance of philosophy in general. [orderboon/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_14@BUTTON_4"
msgstr "Use this opportunity to propagandize your own ideology. [shadowboon/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_14@BUTTON_5"
msgstr "Accept, but silently invite all to meditate on their ethics inwardly. [natureboon/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_14@BUTTON_6"
msgstr "Just speak at length about architecture, everybody loves architecture! [materiumboon/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_14@BUTTON_7"
msgstr "Perform a philosophical dialog that questions the basics of their principles. [astralboon/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_14@BUTTON_8"
msgstr "\"Never. I will only aggrandize myself!\" [influence/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_14@TITLE"
msgstr "An Opening Oration"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_157@BODY_FOOTER"
msgstr "It seems this curious yearning is coming from without, rather than within, some external force appears to be provoking you."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_157@BODY_HEADER"
msgstr "Realizing that the Chaos Aspect is further ahead, a strange sensation of lean hunger suddenly overcomes you."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_157@BODY_LORE"
msgstr "Without any discernible reason, an unshakable, restless yearning emerges from every fiber of your being, reminding you that you are ever so close to your goal, and yet still so very far away."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_157@BUTTON_0"
msgstr "\"Keep your guard up.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_157@TITLE"
msgstr "The Aspect of Chaos"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_158@BODY_FOOTER"
msgstr "As you grasp the Aspect of Chaos for yourself, the restlessness subsides, but a new craving remains, one that tastes like more."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_158@BODY_HEADER"
msgstr "With the taste of victory fresh on your senses, your old, odd hunger subsides, but that unnatural restlessness still remains..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_158@BODY_LORE"
msgstr "Then, it suddenly fuels and spurs on your cravings like a raging wildfire! From the turmoil of your own restlessness a new one emerges that purges all mental clutter until only a grand, satiating awareness of the present remains. And, for a brief, burning instant, you become all with the pandemonium of the {GLOBAL.EndailonLoreConcept.Hyperlink} of Chaos—and it feels truly exhilarating!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_158@BUTTON_0"
msgstr "\"I want more!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_158@TITLE"
msgstr "The New Aspect of Chaos"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_15@BODY_FOOTER"
msgstr "\"Say,\" notices the {EventStackLeader}, \"you seem to poses a worldly mind, how would you define pure good and evil?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_15@BODY_HEADER"
msgstr "On the {EventStructure.Name} stands an army arguing with one-another. \"Murder!\" says one fighter, \"Betrayal!\" says another, \"Landlords!\" utters a third."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_15@BODY_LORE"
msgstr "While watching them argue for a while, their leader, a {EventStackLeader} regards your presence and waves, saying, \"Salutations. We were sent here by the master of {EventHouse.Name} to cultivate an understanding of pure of good and evil. We have all been philosophizing this topic at length, but cannot agree on a fitting definition.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_15@BUTTON_0"
msgstr "\"I cannot say. Come, please study the topic [knowledge/] with my scholars instead.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_15@BUTTON_1"
msgstr "Refuse the inquiry and move along."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_15@BUTTON_2"
msgstr "\"Questing for knowledge; or its selfish destruction.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_15@BUTTON_3"
msgstr "\"To do either, solely for the sake of it.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_15@BUTTON_4"
msgstr "\"The pursuit of wealth; lest it be greed.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_15@BUTTON_5"
msgstr "\"To safeguard all life; or to cause its corruption.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_15@BUTTON_6"
msgstr "\"Stability and harmony; versus tyranny and discord.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_15@BUTTON_7"
msgstr "\"Preserving greatness; or consuming the weak.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_15@BUTTON_8"
msgstr "\"Enough philosophical prattle, to battle!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_15@TITLE"
msgstr "Pondering Moral Qualms"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_160@BODY_FOOTER"
msgstr "Before your forces can reach the Aspect, <<p:EventUnit>> teleports deeper into the abyss, <<o:EventUnit>> mad cackling echoes off in the distance."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_160@BODY_HEADER"
msgstr "Nearing the edge of the abyss, a cackling dance is happening as the Chaos Aspect revels with <<o:EventUnit>> friends."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_160@BODY_LORE"
msgstr "\"Hi-hi, ho-ho, ha-ha! What a wonderful time to be alive!\" <<p:EventUnit>> cackles, \"The whole realm is falling apart and eating itself up! But, ack, what's this, I see? A stranger, touched by khaos and shadow, eh? Say, you are not khoming to khatch me now, are you? Whoah! Hi-hi, ho-ho! No-no! You'll never khatch me, not me! I am khaos inkharnate, whee!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_160@BUTTON_0"
msgstr "Chase after <<P:EventUnit>>."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_160@TITLE"
msgstr "Allegro Chaotica"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_161@BODY_FOOTER"
msgstr "The Aspect of Chaos struggles and will not submit, what must be done?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_161@BODY_HEADER"
msgstr "After a hazardous chase, the Chaos Aspect has finally been caught and pinned down."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_161@BODY_LORE"
msgstr "\"Ho-ho-ho, hi-hi-hi! You khannot khatch me, I am khaos inkharnate! I am–\" it suddenly snaps out of it, \"Eh? No! I am khaught? Ach! No, no! Let me go! I'll not be tamed!\" the Chaos Aspect squirms uncontrollably, \"Nay, here, you be Aspekht, eh? Just kill me now! But do not hold me! I wish to see the realm fall to great khaos! I wish to be free! Free!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_161@BUTTON_0"
msgstr "\"Join me [unit/], and you will see greater chaos still!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_161@BUTTON_1"
msgstr "Slay the Gremlin."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_161@BUTTON_2"
msgstr "Demand payment [gold/] for its freedom."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_161@TITLE"
msgstr "Allegro Chaotica: Finale"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_168@BODY_FOOTER"
msgstr "Then, the ethereal bouquet evaporates and your scent is again restored, save for a fading trace of those foreign reflections..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_168@BODY_HEADER"
msgstr "As your forces enter the abyss, you pick up a faint, unusual scent that stirs up a long lost memory."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_168@BODY_LORE"
msgstr "What started as a single sniff then turns into an off amalgamation of smells, each confusingly blossoming manyfold memories within. Reflections of days long past, and even of times you do not recollect having ever experienced yourself at all!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_168@BUTTON_0"
msgstr "\"Something fishy is afoot...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_168@TITLE"
msgstr "The Aspect of Nature"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_169@BODY_FOOTER"
msgstr "Breathing out, the full vigor of the Aspect of Nature bursts forth from within, and with this power you..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_169@BODY_HEADER"
msgstr "An ethereal breeze brushes past your face, and as you breathe in, you are met by a most welcome scent."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_169@BODY_LORE"
msgstr "Your senses become intoxicated in an all-encompassing sensation of bliss. Memories of cosmic youth enter your awareness, reminding you that, ultimately, all things wither. Just like how balance once fell to corruption, so too, shall corruption pass into restoration. And for a fleeting moment, it feels like the {GLOBAL.EndailonLoreConcept.Hyperlink} of Nature itself comforts your person... What has happened before shall happen again."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_169@BUTTON_0"
msgstr "... Revive the withering {EventUnit}. [unit/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_169@BUTTON_1"
msgstr "... Share its bounty [food/] with your population."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_169@BUTTON_2"
msgstr "... Cultivate powers [knowledge/] to restore the realm."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_169@TITLE"
msgstr "The New Aspect of Nature"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_16@BODY_FOOTER"
msgstr "The {EventUnit} is stuck completing <<o:EventUnit>> immaculate masterpiece and will not leave until <<p:EventUnit>> is done. What does <<p:EventUnit>> need?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_16@BODY_HEADER"
msgstr "Approaching the {EventStructure.Name}, a loud, frustrated groan is heard, followed by a shout of, \"Not now, go away!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_16@BODY_LORE"
msgstr "A {EventUnit} stands before a marvelous sculpture, chipping off tiny bits with a chisel. \"If you must know,\" <<p:EventUnit>> groans, \"we are using this {EventStructure.Name} to craft the masterpiece commissioned by {EventHouseLord}. But, in order to finish it I need... I still need...\" <<Cp:EventUnit>> steps back and inspects the impeccable sculpture with a strained gaze. \"What do I need?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_16@BUTTON_0"
msgstr "Offer your workshops [structureprod/] for the {EventUnit} to work in peace."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_16@BUTTON_1"
msgstr "Leave the {EventUnit} to <<o:EventUnit>> labor."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_16@BUTTON_2"
msgstr "\"Impressive work! You deserve a far wealthier [gold/] patron, like me.\" [unit/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_16@BUTTON_3"
msgstr "Enact your Materium-inspired hand to finish the piece."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_16@BUTTON_4"
msgstr "Declare to all that, \"good\" is good enough!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_16@BUTTON_5"
msgstr "\"It is hopeless! You need to give up.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_16@BUTTON_6"
msgstr "\"You need some sense knocked into you, have at!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_16@BUTTON_7"
msgstr "\"Come, when one is tethered from within, take inspiration from without.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_16@BUTTON_8"
msgstr "\"Truly, when is something ever finished?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_16@BUTTON_9"
msgstr "\"Just chop off that one bit and be done with it!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_16@TITLE"
msgstr "Chipping at a Masterpiece"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_172@BODY_FOOTER"
msgstr "The Nature Aspect appears to be stuck in a never ending cycle, bring it to the nucleus of the labyrinth to break it."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_172@BODY_HEADER"
msgstr "The Nature Aspect appears severely hurt as it stands there, just mumbling to itself."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_172@BODY_LORE"
msgstr "\"I must plant it... I must plant the seed,\" it murmurs with an exhausted stutter, \"No matter if the realm should die tomorrow, the last world tree seed must be planted at the nucleus of the labyrinth! This is my plight. Again, and again, I make this journey, though the corruption be too great to overcome... I must go on.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_172@BUTTON_0"
msgstr "Help the Nature Aspect."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_172@TITLE"
msgstr "Of a Labyrinthine Nature"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_174@BODY_FOOTER"
msgstr "\"Now, with the world-seed planted, I can finally wither, knowing a new Aspect shall... Take... My... Place—you.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_174@BODY_HEADER"
msgstr "As your army approaches the Wellspring at the center, the Nature Aspect steps forward in great strides."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_174@BODY_LORE"
msgstr "He reaches the center, carefully plants the seed in the wellspring then collapses beside it with an exhausted groan. [br/][br/]\"I have watched over the {EventRealm} since it was but a seedling realm,\" it grunts, \"Ah, I have seen the {GLOBAL.ArchonsLoreConcept.Hyperlink} come and go, and the Empire of {GLOBAL.MyrridaLoreConcept.Hyperlink} rise before them. Yes, I outlasted them all, but for the corruption of {GLOBAL.UrrathLoreConcept.Hyperlink}...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_174@BUTTON_0"
msgstr "\"So be it.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_174@BUTTON_1"
msgstr "Let him die and claim some of his power. (DEPRECATED)"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_174@TITLE"
msgstr "Of a Labyrinthine Nature: Germination"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_2@BODY_HEADER"
msgstr "{EventHouseLord.TitleName} of {EventHouse} presents <<r:EventHouseLord>> with one hand on <<o:EventHouseLord>> heart to speak on behalf of <<o:EventHouseLord>> {GLOBAL.IndependentCityConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_2@BODY_LORE"
msgstr "\"Salutations, oh {PlayerLeader.Title}, O {PlayerLeader.Title},\" <<p:EventHouseLord>> orates, moving one hand to <<o:EventHouseLord>> chest, \"We, the {EventHouseRace}, bid you welcome, and are most curious to discover the designs of our peer. I am named {EventHouseLord.TitleName}. Pray, do tell, shall we build bridges on this day, or must we make walls?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_2@BUTTON_0"
msgstr "Assess whether {EventHouse} deserves bridges or walls."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_2@BUTTON_1"
msgstr "\"Build as you wish, my designs remain my own.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_2@TITLE"
msgstr "Meeting Delighted {EventHouse}"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_3@BODY_HEADER"
msgstr "The {EventHouseLord.Title} of {EventHouse} appears before you, studiously massaging <<o:eventHouseLord>> chin, then begins to speak on behalf of <<o:EventHouseLord>> {GLOBAL.IndependentCityConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_3@BODY_LORE"
msgstr "\"Lo and behold! A Godir, a Godir comes before me at this hour,\" <<p:EventHouseLord>> ponders aloud while gesturing towards the ground, \"In accord with the great plan, I bid you welcome, {PlayerLeader.TitleName}. But what is it you bid us in return, I wonder? Indeed, what is it you shall bid us in return?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_3@BUTTON_0"
msgstr "\"Let me see if {EventHouse} is worthy of my biddings.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_3@BUTTON_1"
msgstr "Bid them nothing, for now."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_3@TITLE"
msgstr "Meeting Ponderous {EventHouse}"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_4@BODY_HEADER"
msgstr "The {EventHouseLord.Title} of {EventHouse} steps up with one fist against <<o:EventHouseLord>> chest and speaks on behalf of <<o:EventHouseLord>> {GLOBAL.IndependentCityConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_4@BODY_LORE"
msgstr "\"Step no further!\" <<p:EventHouseLord>> commands with an outstretched hand, \"We, Architects of the {EventHouseRace}, shall not invite ruin upon our domain. I, {EventHouseLord.TitleName}, bid you state your purpose, or leave us to our works.\" <<Cp:EventHouseLord>> regards you for a space, then raises up <<o:EventHouseLord>> chin. \"So, what shall it be?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_4@BUTTON_0"
msgstr "Inspect {EventHouse}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_4@BUTTON_1"
msgstr "Leave them be, for now."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_4@TITLE"
msgstr "Meeting Indignant {EventHouse}"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_5@BODY_HEADER"
msgstr "The {EventHouseLord.Title} of {EventHouse.Name} steps back with an upraised chin and speaks on behalf of <<o:EventHouseLord>> {GLOBAL.IndependentCityConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_5@BODY_LORE"
msgstr "<<Cp:EventHouseLord>> observes you for a space, then flares up <<o:EventHouseLord>> eyes and announces, \"A doom greets us this hour, bringing ruin to our domain. With all the {EventHouseRace} as my witness, I, {EventHouseLord.Name}, {EventHouseLord.Title} of {EventHouse.Name} will see to it that your empire shall crumble! Crumble I say!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_5@BUTTON_0"
msgstr "Inspect {EventHouse}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_5@BUTTON_1"
msgstr "\"You brought ruin upon yourselves!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_5@TITLE"
msgstr "Meeting Irate {EventHouse}"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_69@BODY_FOOTER"
msgstr "“But hold, ye Aspect of Shadow! Who art thou truly?” challenges the Titan, “Art thou an ally come to relieve me, or yet another foe?”"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_69@BODY_HEADER"
msgstr "When approaching the observatory, a deep, magnificent voice suddenly booms out over the main gate."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_69@BODY_LORE"
msgstr "“Praise be! At last, our savior cometh, I hearken thy presence!” declares a grime-soaked {EventUnit} appearing behind the gates, “Lo! I alone am last of the Endailon Titans, who, since the {GLOBAL.EndailonCrisisLoreConcept.Hyperlink}, rejected the {GLOBAL.ArchonsLoreConcept.Hyperlink} and their {GLOBAL.AllfatherLoreConcept.Hyperlink}, and thence pursued closeness with the great Endailon of Order in exile. For many cycles we abode hither, the lone bastion of our kind. But alas, despite our defiant resistance, {GLOBAL.UrrathLoreConcept.Hyperlink} hath corrupted mine brethren and so wrought chaos upon our house...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_69@BUTTON_0"
msgstr "\"I am your ally.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_69@BUTTON_1"
msgstr "\"I am your foe!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_69@TITLE"
msgstr "Last Endailon Titan"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_71@BODY_FOOTER"
msgstr "This strange music steals your attention, before wholly fading away, save for that slight, distant ringing."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_71@BODY_HEADER"
msgstr "As your army approaches the area where {Sundren.FirstName} said the Order Aspect would be, a sudden sharp whistle fills your inner ear."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_71@BODY_LORE"
msgstr "What starts off as a slight, distant ringing at first, gradually sounds a lot more like.... Like a distant chorus?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_71@BUTTON_0"
msgstr "\"Curious.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_71@TITLE"
msgstr "The Aspect of Order"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_72@BODY_FOOTER"
msgstr "As the sound fades, you become utterly inspired by the might of the Aspect of Order."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_72@BODY_HEADER"
msgstr "Your inner ear notices the sound of that Celestial chorus again... Which now fills your spirit with light and rapture!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_72@BODY_LORE"
msgstr "A bright flash overtakes your senses as a great Celestial chorus suddenly crashes down upon you. But you stand like a rock and are thus overcome with exaltation and righteous purpose. As that once foreign music becomes wholly native to your being, you assume its blessed power. Then, what once seemed like a thousand voices, coalesce into one—the {GLOBAL.EndailonLoreConcept.Hyperlink} of Order."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_72@BUTTON_0"
msgstr "\"Onwards!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_72@TITLE"
msgstr "The New Aspect of Order"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_89@BODY_FOOTER"
msgstr "Chimes and chants resonate in the air, greater forces are listening in to this moment, how will you respond?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_89@BODY_HEADER"
msgstr "As your army enters the demon infested observatory, that faint, celestial chime echoes again in the distance."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_89@BODY_LORE"
msgstr "Venturing forth, you cannot help but notice the overwhelming corruptive infestation that creeps out of every crevice and stone. It seems the Endailon Titans are truly making their last stand here, or even that they have already failed. [br/][br/]\"Lo, our enemy cometh,\" observes the {EventUnit}, as <<p:EventUnit>> rests his stern senses upon you, \"Ready thyself.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_89@BUTTON_0"
msgstr "\"To arms!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_89@BUTTON_1"
msgstr "First cast a spell to strengthen your forces."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_89@BUTTON_6"
msgstr "Leave the battle for later."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_89@TITLE"
msgstr "Order Under Siege"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_90@BODY_FOOTER"
msgstr "\"Speak, O new Aspect of Order, and render thy judgment upon me.\" The Titan kneels down and awaits your judgment."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_90@BODY_HEADER"
msgstr "After the battle, the dust settles and the {EventUnit} speaks up one final time."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_90@BODY_LORE"
msgstr "\"Thou hast fought with bravery and valor!\" acknowledges the wearied Titan, \"Truly, the {GLOBAL.EndailonLoreConcept.Hyperlink} of Order is with thee, I doth not doubt it. Nay, it so appears that the age of the Endailon Titans has thus ended. And with it, mine great charge here also... Behold, I now bestow upon thee the 'Aspect of Order', as victorious protector of our ancient seat, the position art justly thine by right. May ye go forth with righteous purpose and thence restore order, where I hath failed!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_90@BUTTON_0"
msgstr "\"Arise [unit/], and continue your fight at my side.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_90@BUTTON_1"
msgstr "\"The age of your kind ends now, perish!\" [evilact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_90@BUTTON_2"
msgstr "\"Order is restored, for victory is its own reward.\" [goodact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_90@TITLE"
msgstr "Order Under Siege: Restored"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_95@BODY_FOOTER"
msgstr "It appears that supernatural forces are inspiring your next move."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_95@BODY_HEADER"
msgstr "Upon deplaning onto the {GLOBAL.ShadowRealmLoreConcept.Hyperlink}, a curious new thought suddenly enters into your awareness..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_95@BODY_LORE"
msgstr "It is a thought wholly without words, sounds, or images. Nevertheless, it asserts itself into your consciousness with great clarity, so that you simply just 'know'... \"Search towers. Find {EventUnit.Name}.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_95@BUTTON_0"
msgstr "Focus further on the thought..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_95@TITLE"
msgstr "Aspect of the Astral"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_97@BODY_FOOTER"
msgstr "\"Looky 'ere, would'ye 'mind' securing me before them drat Umbral Demons do, ey? I, ehrm... Done 'stored' meself in one o' these here towers.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_97@BODY_HEADER"
msgstr "Before you can dwell on your last thought, a strange new voice speaks to your mind directly."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_97@BODY_LORE"
msgstr "\"Oy! You there! Splendid, an 'Aspect-initiate'. Rite, a little help would be appreciated,\" urges the crass speaker, \"Gha, as the old Aspect I tried as hard as I could to fight this blasted corruption offa {EventRealm}, but bugger me, how I failed... Now, me old body might well be puppeted by {GLOBAL.ShadowDemonsLoreConcept.Hyperlink}-like, but me mind, at least... Well, that's 'stored away', as a manner of speaking...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_97@BUTTON_0"
msgstr "Help the Aspect and kill his old body. (DEPRECATED)"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_97@BUTTON_1"
msgstr "Seek out the hidden Aspect."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_97@TITLE"
msgstr "An Out of Body Experience"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_98@BODY_FOOTER"
msgstr "You are invited to enter into the {EventStructure} and fight the demonic animated {EnemyUnit} inside."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_98@BODY_HEADER"
msgstr "Upon entering the {EventStructure}, a familiar voice forces itself into your mind again..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_98@BODY_LORE"
msgstr "\"Oy! What'cha doing in {Merlin.FirstName} and mine's old {GLOBAL.EndailonLoreConcept.Hyperlink} study tower? Sorry lot, what's left of it...\" Ahead, a mindless {EnemyUnit} floats amidst a cascade of books, jewels, and other magic items. \"Look at that! My old body is animated by {GLOBAL.UrrathLoreConcept.Hyperlink}. Ugh, seems it's hoarding this stuff for Merlin to collect later... Well, now you're here anyway, could ye do us a favor and clobber it for me?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_98@BUTTON_0"
msgstr "Attack the animated {EnemyUnit} head-on!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_98@BUTTON_1"
msgstr "Prepare an improvised spell [mana/] to sunder the magical defenses of the {EnemyUnit}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_98@BUTTON_6"
msgstr "\"Not now.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_98@BUTTON_7"
msgstr "Draw upon your affinity with the Astral to weaken the animated {EventUnit}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_98@BUTTON_8"
msgstr "Call on Godebald to taunt his old animated body with crass insults."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_98@TITLE"
msgstr "Time Out of Mind"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_99@BODY_FOOTER"
msgstr "As the treasure slowly disappears, you have only one chance to save the most valuable artifact!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_99@BODY_HEADER"
msgstr "Upon defeating the animated body, a great crack is heard and the whole tower rumbles, before a familiar voice pops up again."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_99@BODY_LORE"
msgstr "\"Yikes, a right spectacle that was! An end of an era, innit? {Merlin.FirstName} and I used to research the Aspects here, we did. At least, before he gone left to look for the apple o' his eye...\" Then, the floor cracks and collapses, revealing the vast {GLOBAL.ShadowRealmLoreConcept.Hyperlink} beyond it. Screeching and clawing, the body is sucked into the abyss and with it all the items, gems, and tomes previously floating around the space are slowly sucked in as well!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_99@BUTTON_0"
msgstr "Save the nearest magic item. [item/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_99@BUTTON_1"
msgstr "Save the grandest looking journal. [knowledge/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_99@BUTTON_2"
msgstr "Bugger Merlin (DEPRECATED)"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_99@BUTTON_3"
msgstr "Save the jewels! [gold/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_99@BUTTON_4"
msgstr "\"Oy! Grab me drab ledger!\" Save the priceless Aspect Research of Godebald! [arcana/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@1229_99@TITLE"
msgstr "Time Out of Mind: Out of Time"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8093@BODY_FOOTER"
msgstr "\"They see your fears,\" {OracleName} abruptly says. \"All must confess to the light or despair!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8093@BODY_HEADER"
msgstr "With vertigo you awake in an irenic landscape. Your guide, {OracleName} of the {EventRace}, slowly comes into focus again, smiling."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8093@BODY_LORE"
msgstr "\"We have arrived, {PlayerLeader},\" <<p:OracleName>> declares, while the visions from the {GLOBAL.AstralSeaLoreConcept.Hyperlink} still perpetuate within your mind. \"This is one of the blessed realms which the {GLOBAL.ArchonsLoreConcept.Hyperlink} call Emnora. Here they reside, dwelling on divine amendments and the construction of their mighty temples.\" As {OracleName} speaks, the [hyperlink,GLOBAL.AstralFlowsLoreConcept]Astral Currents[/hyperlink] around you swell again, conjuring up the image of the terrible light that you beheld."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8093@BUTTON_0"
msgstr "\"I saw thieves, skulking in shadows to steal my treasures [gold/].\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8093@BUTTON_1"
msgstr "\"Sin and mayhem shook the realms. The Age of Obbadoth [influence/] was at its dawn.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8093@BUTTON_2"
msgstr "\"There was no strife [unitprod/] or emotion. All life subdued in predictable patterns.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8093@BUTTON_3"
msgstr "\"The Astral Flows [mana/] depleted, and there was magic no more.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8093@BUTTON_4"
msgstr "\"Hunted and cornered, the great beasts [unit/] of the realms were driven to extinction.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8093@BUTTON_5"
msgstr "\"The plebs usurped the throne, forever ignorant [knowledge/] of its powers unsought.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8093@BUTTON_6"
msgstr "\"My people [population/] were reduced to pawns, sacrificed in Magehaven's games of power.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8093@BUTTON_7"
msgstr "\"The towers of the Archmages [monument/] crumbled, their arcane wealth forever lost.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8093@BUTTON_DRAGON"
msgstr "\"Vengeful and envious, the Giant Kings slew all dragons [unit/] far and wide.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8093@BUTTON_GIANT"
msgstr "\"Like ancient Myrrida, the great kingdoms of Giant Kin [structureprod/] perished in dragon fire.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8093@TITLE"
msgstr "Visions of Exaltation"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8110@BODY_FOOTER"
msgstr "\"The gateways between Emnora's Rings are the <<m:{GLOBAL.STRUCTURES.GOLDEN_ZIGGURAT.Hyperlink}>> on this realm,\" {OracleName} concludes. \"I foresaw your desire to tread there, though I do not know the purpose.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8110@BODY_HEADER"
msgstr "\"The light of truth can burn violently,\" {OracleName} says. \"As an {EventUnit}, I must ward my eyes from its touch.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8110@BODY_LORE"
msgstr "\"You did well, {PlayerLeader},\" <<p:OracleName>> continues, \"yet your journey towards the {GLOBAL.ArchonsLoreConcept.Hyperlink} has only begun. The rings of Emnora are like long-winded stairways to heaven. Except no foot may walk its steps, only a spirit in search of enlightenment. We are on the Fourth Ring where the least divine souls seek ascension. In the First Ring, the Archon High Council confers.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8110@BUTTON_0"
msgstr "\"There is no magic gateway my arcane wits cannot unriddle.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8110@BUTTON_1"
msgstr "\"In the sanctuary of these Archon monuments, my prayers find new meaning.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8110@BUTTON_2"
msgstr "\"There must be other aspirants at these gateways. They may know how to pass.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8110@BUTTON_3"
msgstr "\"When I threaten to smash their precious portals, the Archons will listen to my demands.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8110@TITLE"
msgstr "Pathways of Ascension"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8111@BODY_FOOTER"
msgstr "\"If you are to complete your journey to Emnora,\" {OracleName} concludes, \"you will have to master your fears. In time, you will understand the full meaning of this.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8111@BODY_HEADER"
msgstr "Having examined the {EventStructure}, you are expected by {OracleName}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8111@BODY_LORE"
msgstr "\"Have you found what you were looking for, {PlayerLeader.Name}?\" <<p:EventUnit>> asks with a knowing smile. \"The answer could only be 'yes'. You may have noticed it by now: on Emnora the hopes and fears of the magically gifted may take tangible shape. It is one of the reasons why only the virtuous and worthy may ascend to the higher rings.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8111@BUTTON_0"
msgstr "Thank {OracleName} for <<o:EventUnit>> insights."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8111@TITLE"
msgstr "Pathways of Ascension: Aftermath"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BODY_FOOTER"
msgstr "The Celestial vortex within the arch beckons you to enter. Where do you wish to go?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BODY_FOOTER@FIRST_OTHER"
msgstr "The dormant portal arch does not offer {EventHero} passage to the higher rings of Emnora. What does {EventHero} do?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BODY_FOOTER@FIRST_RULER"
msgstr "The dormant portal arch does not offer you passage to the higher rings of Emnora. What do you do?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BODY_FOOTER@NO_RULER"
msgstr "The Celestial vortex within the arch beckons {EventHero} to enter. Where does {EventHero} wish to go?"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BODY_HEADER"
msgstr "Once again climbing the stairs of the {EventStructure}, you return to the portal chamber at the top."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BODY_HEADER@FIRST_OTHER"
msgstr "Climbing the stairs of the {EventStructure}, {EventHero} beholds the grandeur of ancient [hyperlink,GLOBAL.ArchonsLoreConcept]Archon[/hyperlink] architecture."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BODY_HEADER@FIRST_RULER"
msgstr "Climbing the stairs of the {EventStructure}, you behold the grandeur of ancient [hyperlink,GLOBAL.ArchonsLoreConcept]Archon[/hyperlink] architecture."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BODY_HEADER@NO_RULER"
msgstr "Once again climbing the stairs of the {EventStructure}, {EventHero} returns to the portal chamber at the top."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BODY_LORE"
msgstr "Inside the chamber at the top, the rune-covered arch still rests. As you approach the ancient arch, it suddenly crackles with energy and a star-lit vortex appears in its center."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BODY_LORE@FIRST_OTHER"
msgstr "Inside the chamber at the top, {EventHero} finds a rune-covered arch not unlike the <<m:{GLOBAL.WorldGateLoreConcept.Hyperlink}>> of {GLOBAL.MagehavenLoreConcept.Hyperlink}. The arch is still dormant, without trace of any arcane mechanism that might activate it."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BODY_LORE@FIRST_RULER"
msgstr "Inside the chamber at the top, you find a rune-covered arch not unlike the <<m:{GLOBAL.WorldGateLoreConcept.Hyperlink}>> of {GLOBAL.MagehavenLoreConcept.Hyperlink}. The arch is still dormant, without trace of any arcane mechanism that might activate it."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BODY_LORE@NO_RULER"
msgstr "Inside the chamber at the top, the rune-covered arch still rests. As {EventHero} approaches the ancient arch, it suddenly crackles with energy and a star-lit vortex appears in its center."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BUTTON_0"
msgstr "Enter the portal to the First Ring."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BUTTON_1"
msgstr "Enter the portal to the Second Ring."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BUTTON_2"
msgstr "Leave."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BUTTON_3"
msgstr "Enter the portal to the Third Ring."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BUTTON_4"
msgstr "Enter the portal to the Fourth Ring."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BUTTON_5"
msgstr "Examine the arch more closely to unravel its secrets..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BUTTON_6"
msgstr "Kneel at the arch to commence your prayers..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BUTTON_7"
msgstr "Engage the figure near the other end of the chamber..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@BUTTON_8"
msgstr "Raise the {EventItem} to threaten destruction of the arch..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8117@TITLE"
msgstr "At the Pathway of Ascension"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8122@BODY_FOOTER"
msgstr "\"It is our calling to plunge the {GLOBAL.RevenantsLoreConcept.Hyperlink} into the {GLOBAL.AstralVoidLoreConcept.Hyperlink},\" {EventPlayer} concludes. \"Interfere, {PlayerLeader}, and you too will be smote.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8122@BODY_HEADER"
msgstr "From the {EventGeo} {EventDirection} {EventCity} a croaking chorus swells, enchanting yet terrifying, until {EventPlayer} reveals <<r:EventPlayer>> to you."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8122@BODY_LORE"
msgstr "\"Hear our rendition:\", <<p:EventPlayer>> chants, <<o:EventPlayer>> vocal sac pulsating with fervor, \"We {EventRace} have sailed to the shores of Emnora in search of Archon grace, yet we found denizens as foul as the deep terrors of the {GLOBAL.AstralSeaLoreConcept.Hyperlink}. It is the {GLOBAL.RevenantsLoreConcept.Hyperlink} that I speak of, their vile presence imperiling this Celestial sanctuary.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8122@BUTTON_0"
msgstr "\"The divine chants of the {EventRace} are inspirational. [relationLvl3/] Let us join in their rousing fervor!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8122@BUTTON_3"
msgstr "\"Proceed as you may. We do not take sides in holy crusades.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8122@BUTTON_4"
msgstr "\"It is not upon you to decide on life and death, {EventPlayer}. [relationLvl-3/] It is upon me!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8122@TITLE"
msgstr "The Wicked We Smite"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8129@BODY_FOOTER"
msgstr "\"We are no agents of {GLOBAL.UrrathLoreConcept.Hyperlink},\" {EventPlayer} shouts defiantly. \"We are {GLOBAL.ArchonsLoreConcept.Hyperlink}!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8129@BODY_HEADER"
msgstr "Bearing a scent of fragrant oil, yet also decay, a wrinkled <<EventPlayer{man/woman}>> in Archon armor descends the stairs of <<o:EventPlayer>> Necropolis."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8129@BODY_LORE"
msgstr "\"I am {EventPlayer}, leader of the ones so unfairly proscribed as '{EventRace}',\" <<p:EventPlayer>> introduces <<r:EventPlayer>>, showing an embittered grin. \"My people became doomed twice: once when the Lizardfolk denied us departure in the First Age on {GLOBAL.AthlaLoreConcept.Hyperlink}; and again near the end of its Second Age, when the mark of {GLOBAL.UrrathLoreConcept.Hyperlink} was placed on our Necropolises. We rose as tainted puppets, yet when the seals on {GLOBAL.AthlaLoreConcept.Hyperlink} broke, our {GLOBAL.SoulsLoreConcept.Hyperlink} became rekindled with faith.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8129@BUTTON_0"
msgstr "Continue listening to {EventPlayer}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8129@TITLE"
msgstr "Damnation"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8132@BODY_FOOTER"
msgstr "\"The {GLOBAL.ArchonsLoreConcept.Hyperlink} will without doubt favor the ones who can put the {GLOBAL.RevenantsLoreConcept.Hyperlink} to rest,\" {OracleName} concludes. \"For they fear what must not be.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8132@BODY_HEADER"
msgstr "As the chorus of the {EventRace} subsides, {OracleName} raises <<o:EventUnit>> voice, speaking to you."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8132@BODY_LORE"
msgstr "\"The fate of the {GLOBAL.RevenantsLoreConcept.Hyperlink} is a twisted one,\" <<p:EventUnit>> says, <<o:EventUnit>> words spoken with unusual fragility. \"Once {GLOBAL.ArchonsLoreConcept.Hyperlink} in life, their {GLOBAL.SoulsLoreConcept.Hyperlink} were denied passage to the {GLOBAL.AllfatherLoreConcept.Hyperlink}—until the most potent Necromancy returned them to unlife, forever stained with the mark of {GLOBAL.UrrathLoreConcept.Hyperlink}.\" {OracleName} hesitates, then continues: \"If there are {GLOBAL.RevenantsLoreConcept.Hyperlink} on Emnora, things do not bode well.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8132@BUTTON_0"
msgstr "We will deal with this Revenant threat in time."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8132@TITLE"
msgstr "The Revenant Curse"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8133@BODY_FOOTER"
msgstr "\"I can see the emanations at the {EventStructure} shift,\" {OracleName} reports. \"The path towards Emnora continues, {PlayerLeader}.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8133@BODY_HEADER"
msgstr "Having witnessed the defeat of {EventPlayer}, {OracleName} shares <<o:EventUnit>> thoughts."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8133@BODY_LORE"
msgstr "\"May you find peace at last, {EventPlayer.FirstName}—your compassionate heart did not deserve such ill,\" <<p:EventUnit>> says, <<o:EventUnit>> hands performing gestures of leave-taking.[br/][br/]Then {OracleName} turns to you: \"You have done the Archons a great service today, {PlayerLeader}, even if they won't openly acknowledge this.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8133@BUTTON_0"
msgstr "Plan your return to the {EventStructure}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8133@BUTTON_2"
msgstr "Reward 2"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8133@BUTTON_3"
msgstr "Reward 3"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8133@BUTTON_4"
msgstr "Reward 4"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8133@BUTTON_5"
msgstr "Reward 5"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8133@BUTTON_6"
msgstr "Reward 6"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8133@TITLE"
msgstr "The Revenant Curse: Aftermath"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8142@BODY_FOOTER"
msgstr "\"We {EventRace} have fostered the ascension of new {GLOBAL.ArchonsLoreConcept.Hyperlink} on many worlds\", {EventPlayer} pronounces. \"Alas, that blessed age has passed.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8142@BODY_HEADER"
msgstr "Flanked by Angels, a mighty chariot descends from the mountains, its exalted rider illuminated by god rays."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8142@BODY_LORE"
msgstr "\"Hail the {GLOBAL.AllfatherLoreConcept.Hyperlink}, {PlayerLeader.Name},\" <<p:EventPlayer>> calls out with splendor, \"for you are entering the blessed lands of the {EventRace}. I am {EventPlayer.TitleName} and it is upon me to judge who may ascend further to reach Emnora.\" {EventPlayer} looks over you with <<o:EventPlayer>> radiant gaze. \"I see you are a {EventPlayerForm}. A pity.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8142@BODY_LORE@PLAYER_HUMANFORM"
msgstr "\"Hail the {GLOBAL.AllfatherLoreConcept.Hyperlink}, {PlayerLeader.Name},\" <<p:EventPlayer>> calls out with splendor, \"for you are entering the blessed lands of the {EventRace}. I am {EventPlayer.TitleName} and it is upon me to judge who may ascend further to reach Emnora.\" {EventPlayer} looks over you with <<o:EventPlayer>> radiant gaze. \"I see you are a {EventPlayerForm}. How promising!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8142@BUTTON_0"
msgstr "Continue listening to {EventPlayer}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8142@TITLE"
msgstr "A Higher Destiny"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8147@BODY_FOOTER"
msgstr "\"The souls of the worthy are reforged in the light of the {EventRace},\" {EventPlayer} proclaims, igniting <<o:EventPlayer>> {EventItem}. \"Yet the impure incinerate...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8147@BODY_HEADER"
msgstr "The expression on <<ge:face^n,EventPlayer>> grows harsh, resplendent yet terrible."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8147@BODY_LORE"
msgstr "\"I must urge you to turn back, {PlayerLeader},\" <<p:EventPlayer>> speaks slowly, and you feel an urgent desire to follow <<o:EventPlayer>> command. \"Leave, while you can, for to reach Emnora, one must stride through cleansing flames.\"[br/][br/]As you do not recede, {EventPlayer} continues: \"By the mandate bestowed upon me through the High Council, I decree my challenge to you. Overcome my divine powers, and I shall grant you passage.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8147@BUTTON_0"
msgstr "\"Your Celestial hosts shall tremble before me, {EventPlayer}!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8147@TITLE"
msgstr "Ordeal by Fire"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8149@BODY_FOOTER"
msgstr "{OracleName} asks: \"Will you accept the {TitanUnit} into your ranks?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8149@BODY_HEADER"
msgstr "While the doors to the Third Ring of Emnora have opened wide, {OracleName} has more good news to share."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8149@BODY_LORE"
msgstr "\"Your deeds on this realm have not gone unnoticed, {PlayerLeader},\" <<p:EventUnit>> says with a serious voice. \"A {TitanUnit}, previously in allegiance with {EventPlayer}, is offering you, the {PlayerLeader.Title}, <<o:TitanUnit>> fealty.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8149@BUTTON_0"
msgstr "Recruit the {TitanUnit} [unit/] for your army."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8149@BUTTON_2"
msgstr "Ask the {TitanUnit} to work in the forges [unitprod/] of {EventCity} instead."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8149@BUTTON_3"
msgstr "Commune with the {TitanUnit} to learn <<o:TitanUnit>> rite of passing souls."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8149@TITLE"
msgstr "Ordeal by Fire: Aftermath"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8153@BODY_FOOTER"
msgstr "\"I am {EventPlayer}, {EventPlayer.Title},\" the man says, lifting <<o:EventPlayer>> hood. \"Yet, who are you?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8153@BODY_HEADER"
msgstr "Accompanied by a single scribe, a hooded man, humble yet exalted, awaits you at the bottom of the Ziggurat's stairs."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8153@BODY_LORE"
msgstr "\"So the Oracle of Alanor divined the truth,\" the man speaks, \"and there comes 'one, bearing a letter of need, who walks in <<ge:starlight^n,{EventGodir}>>'.\" <<Cp:EventPlayer>> looks at the sky, where indeed the constellation of {EventGodir} gleams brighter than any other. \"Well then. You must be on your path to Emnora. If that is so, let it be known to you that you have arrived at the Lakes of Sagacity, where the waters can mirror the truth.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8153@BUTTON_0"
msgstr "\"I am {PlayerLeader.TitleName}.\" [influence/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8153@BUTTON_3"
msgstr "\"I am {PlayerLeader.FirstName}, Seeker of Truth.\" [knowledge/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8153@BUTTON_4"
msgstr "\"My name bears no significance in the light of the Allfather.\" [goodact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8153@TITLE"
msgstr "Starlit Revelations"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8162@BODY_FOOTER"
msgstr "\"Stroll beneath the domes of our Observatories, {PlayerLeader.TitleName}\", {EventPlayer} ends <<o:EventPlayer>> speech, \"and you may yet reach Emnora.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8162@BODY_FOOTER@NO_NAME"
msgstr "\"Stroll beneath the domes of our Observatories, pilgrim\", {EventPlayer} ends <<o:EventPlayer>> speech, \"and you may yet reach Emnora.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8162@BODY_FOOTER@PLAIN_NAME"
msgstr "\"Stroll beneath the domes of our Observatories, {PlayerLeader.Name}\", {EventPlayer} ends <<o:EventPlayer>> speech, \"and you may yet reach Emnora.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8162@BODY_HEADER"
msgstr "\"A {PlayerLeader.Title}, I see,\" {EventPlayer} repeats pensively, <<o:EventPlayer>> thoughts veiled beneath <<o:EventPlayer>> hood."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8162@BODY_HEADER@NO_NAME"
msgstr "\"A pilgrim, I see,\" {EventPlayer} says pensively, <<o:EventPlayer>> thoughts veiled beneath <<o:EventPlayer>> hood."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8162@BODY_HEADER@PLAIN_NAME"
msgstr "\"{PlayerLeader.Name}, I see,\" {EventPlayer} repeats pensively, <<o:EventPlayer>> thoughts veiled beneath <<o:EventPlayer>> hood."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8162@BODY_LORE"
msgstr "\"It is rare for a stranger to visit the Lakes of Sagacity,\" <<p:EventPlayer>> continues. \"But you are free to enter our houses of wisdom, engross your mind in the presence of our blessed waters; let the prophecies of our Oracles sink in.\"[br/][br/]\"The [hyperlink,GLOBAL.AllfatherLoreConcept]Allfather's[/hyperlink] light bespeaks the fate of our cosmos,\" {EventPlayer} explains empathetically, \"yet he who gazes at {GLOBAL.TheWellLoreConcept.Hyperlink} will drown in its truth. Thus the Order of Augurs watches only its faint reflections, echoed as starlight.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8162@BUTTON_0"
msgstr "Agree to study the Order of Augurs' prophecies."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8162@BUTTON_4"
msgstr "This is the moment to strike the Archons when they least expect it. [evilact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8162@TITLE"
msgstr "Omens and Prophecies"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8163@BODY_FOOTER"
msgstr "\"I am hereby granting you the right to approach the High Council,\" {EventPlayer} proclaims. \"May the Allfather inspire your speech as you beseech them.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8163@BODY_HEADER"
msgstr "Much has transpired since you arrived at the Lakes of Sagacity. Now {EventPlayer} has summoned you and {EventHero} to join <<P:EventPlayer>> at the blessed waters."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8163@BODY_LORE"
msgstr "\"You have shown signs of great wisdom and patience during your stay in these lands, {PlayerLeader} and {EventHero},\" {EventPlayer} says with a glimmer of solemnity in <<o:EventPlayer>> voice. \"Both of you gained an understanding of how prophecies can guide our actions and both of you faced their fears, mastering them in different ways.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8163@BUTTON_0"
msgstr "Prepare to face the Archon High Council."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8163@TITLE"
msgstr "Omens and Prophecies: Aftermath"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8169@BODY_FOOTER"
msgstr "Footer"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8169@BODY_HEADER"
msgstr "Header"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8169@BODY_LORE"
msgstr "Lore"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8169@BUTTON_0"
msgstr "Ok"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8169@TITLE"
msgstr "Behold Council Event"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8171@BODY_FOOTER"
msgstr "\"My name is {EventHero},\" the woman introduces <<r:EventHero>>. \"And I, too, am on the path to Emnora.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8171@BODY_HEADER"
msgstr "Wandering the Lakes of Sagacity, you find a lone woman watching the waters. As <<p:EventHero>> notices you, <<p:EventHero>> looks up."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8171@BODY_LORE"
msgstr "\"I was told that one has arrived with intentions not unlike my own,\" <<p:EventHero>> speaks, revealing <<o:EventHero>> fair Elven face. \"And though it is my great desire to know more, I must not ask about the Great Umbral War. For it would grieve me too much; while I sit here, idly, reading Astral tea leaves...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8171@BUTTON_0"
msgstr "Continue listening to {EventHero}..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8171@TITLE"
msgstr "The Lady at the Lake"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8177@BODY_FOOTER"
msgstr "\"I will follow your lead, {PlayerLeader},\" {EventHero.FirstName} says with a smile. \"The last step of our journey lies before us.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8177@BODY_HEADER"
msgstr "Together with {EventHero} you climb down the stairway of the last Ziggurat, beholding the seat of the Archon High Council in the distance."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8177@BODY_LORE"
msgstr "Angelic statues and sacred trees flank your path, which winds down to an enormous {EventStructure}. \"It is said,\" {EventHero.FirstName} whispers, \"that the Archons of the High Council have transcended physical shape, becoming a duality of light and soul. To commune with them, we will have to enter their shrine and await their calling.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8177@BUTTON_0"
msgstr "Ready your spirit to commune with the High Council."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8177@TITLE"
msgstr "The Archon High Council"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8178@BODY_FOOTER"
msgstr "Imbued with this new meaning, your spirit becomes elevated, basking in the light of {GLOBAL.TheWellLoreConcept.Hyperlink}..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8178@BODY_HEADER"
msgstr "While the words of the Archon High Council still resonate in your mind, you reflect on the journey behind you."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8178@BODY_LORE"
msgstr "You have ascended the Celestial rings, proving your endurance, valor, and wisdom. Now, in the drizzle of the {EventStructure}, you at last understand the words of {OracleName}. 'Emnora' is not this realm, nor the site of the High Council, nor any hallowed ground. It is a state of clarity and peace, a transformation of your inner spirit, a truth beyond the veils of reality."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8178@BUTTON_0"
msgstr "... until it reaches Emnora."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8178@TITLE"
msgstr "The Archon High Council: Aftermath"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8180@BODY_FOOTER"
msgstr "Imbued with this new meaning, your spirit becomes elevated, basking in the light of {GLOBAL.TheWellLoreConcept.Hyperlink}..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8180@BODY_HEADER"
msgstr "While the words of the Archon High Council still resonate in your mind, you reflect on the journey behind you."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8180@BODY_LORE"
msgstr "You have ascended the Celestial rings, proving your endurance, valor, and wisdom. Now, in the drizzle of the {EventStructure}, you at last understand the words of {OracleName}. 'Emnora' is not this realm, nor the site of the High Council, nor any hallowed ground. It is a state of clarity and peace, a transformation of your inner spirit, a truth beyond the veils of reality."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8180@BUTTON_0"
msgstr "... until it reaches Emnora."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8180@TITLE"
msgstr "Rings of Emnora: Victory"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8193@BODY_FOOTER"
msgstr "While {OracleName} is safe and sound, <<o:OracleName>> self-rescue drained a noteworthy amount of your mana reserves..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8193@BODY_HEADER"
msgstr "It had seemed as though <<ge:fate^n,{OracleName}>> had been sealed. Yet in the aftermath of the battle, <<p:OracleName>> returns, emerging from an Astral tear."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8193@BODY_LORE"
msgstr "\"That was close,\" {OracleName} exclaims, still gasping for air. \"As an {EventUnit} experienced in skirmishes I have developed a unique awareness for my own safety. However, foreseeing death's approach doesn't naturally mean you can cheat it.\" <<Cp:OracleName>> rips a small piece of cloth from <<o:OracleName>> robe, polishing the orb on <<o:OracleName>> staff. \"So let's not get into this again, {PlayerLeader}, agreed?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8193@BUTTON_0"
msgstr "'Tis the price of immortality."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8193@TITLE"
msgstr "An Escape Foreseen"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8203@BODY_FOOTER"
msgstr "\"You are a Godir, {PlayerLeader},\" {EventPlayer} appeals to you. \"Talk to the {EventUnit} at the {EventStructure}. Speak of our intentions, convince <<P:EventUnit>> we are not corrupted...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8203@BODY_HEADER"
msgstr "\"We came to Emnora in search of redemption,\" {EventPlayer} continues. \"Yet we found the passage to the higher rings blocked, our prayers answered by stoic silence.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8203@BODY_LORE"
msgstr "\"Do they not see? Our coming is a gift, a willing host offering itself to find a cure for what cannot be cured...\" {EventPlayer} sounds desperate, though <<p:EventPlayer>> soon regains <<o:EventPlayer>> composure. \"Our pleas remained unanswered for too long. Now we have sinned, capturing an {EventUnit} to negotiate a talk. We merely ask to be heard, but the {EventUnit} will not speak.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8203@BUTTON_0"
msgstr "\"Show me the {EventStructure}, and I will fight for your redemption.\" [relationLvl3/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8203@TITLE"
msgstr "Desperate Measures"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8204@BODY_FOOTER"
msgstr "\"My fate on Emnora is sealed,\" {EventPlayer} concludes.\" Yet how may I aid you on your journey, {PlayerLeader}?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8204@BODY_HEADER"
msgstr "Not long after what transpired at the {EventStructure}, {EventPlayer} contacts you, overjoyed."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8204@BODY_LORE"
msgstr "\"You have performed a miracle, {PlayerLeader},\" <<p:EventPlayer>> says, deeply moved. \"The {EventUnit} has now returned to the higher rings of Emnora, where <<p:EventUnit>> will speak in our favor. <<Cp:EventUnit>> fears that our only path to redemption might be through a rite of passing. If that be so, we will be glad to leave the world as Archons at last.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8204@BUTTON_0"
msgstr "\"I would regard you as a valuable ally [rs_alliance/], {EventPlayer}.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8204@TITLE"
msgstr "Desperate Measures: Aftermath"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8205@BODY_FOOTER@REVENANT_BETRAYE"
msgstr "\"We may be damned, {PlayerLeader},\" {EventPlayer} shouts frantically, \"but we are left with one vengeful purpose: to destroy you and your people.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8205@BODY_HEADER@REVENANT_BETRAYE"
msgstr "Not long after what transpired at the {EventStructure}, {EventPlayer} contacts you, trembling with rage."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8205@BODY_LORE@REVENANT_BETRAYE"
msgstr "\"You have doomed us, {PlayerLeader}!\" <<p:EventPlayer>> calls out in agony. \"I was a fool to trust you in my desperation. Now, our hope of Archon reconciliation has been crushed, a cure made impossible.\" Violently screaming, {EventPlayer} rips off the mask protecting <<o:EventPlayer>> face, gazing at you as a hateful skull."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8205@BUTTON_7"
msgstr "\"Leave your lands for my people to settle.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8205@BUTTON_8"
msgstr "\"I desire no greater reward than that your souls might be saved.\" [goodact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8205@BUTTON_9"
msgstr "\"So be it!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8206@BUTTON_4"
msgstr "\"I will speak with the {EventUnit}, though I cannot promise more.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8206@BUTTON_5"
msgstr "\"The Archons are right: the Revenant curse mustn't spread.\" [relationLvl-3/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8212@BODY_FOOTER"
msgstr "\"So, the Revenant sends another proponent,\" the {EventUnit} speaks. \"Corruption can take many forms, {EventHero}.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8212@BODY_FOOTER@NO_QUEST"
msgstr "Your troops find nothing of interest, leaving the temple in peace."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8212@BODY_HEADER"
msgstr "Reaching the {EventStructure}, its grand doors are opened by the {EventRace} of {EventPlayer}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8212@BODY_HEADER@NO_QUEST"
msgstr "Your troops find a temple of Archon architecture, abandoned and sealed."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8212@BODY_LORE"
msgstr "They silently lead you to the center of the temple, where an {EventUnit} is detained within a circle of dark magic. The {EventUnit} kneels on the ground, sheltered by <<o:EventUnit>> four mighty wings. As <<p:EventUnit>> notices you, <<p:EventUnit>> lifts <<o:EventUnit>> head, slightly. <<Co:EventUnit>> words, brilliant and sharp, resonate through the temple like an ordeal."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8212@BODY_LORE@NO_QUEST"
msgstr "There is a distinct scent of lavender and myrrh in the air, like a lingering testament to distant ceremonies when the Archons sanctified the dead. Your troops stride around the structure complex, but the only gate once leading into the temple is blocked from within."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8212@BODY_LORE@NO_RULER"
msgstr "They silently lead {EventHero} to the center of the temple, where an {EventUnit} is detained within a circle of dark magic. The {EventUnit} kneels on the ground, sheltered by <<o:EventUnit>> four mighty wings. As <<p:EventUnit>> notices {EventHero}, <<p:EventUnit>> lifts <<o:EventUnit>> head, slightly. <<Co:EventUnit>> words, brilliant and sharp, resonate through the temple like an ordeal."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8212@BUTTON_0"
msgstr "\"You are mistaken, {EventUnit}. I have come to free you from this prison!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8212@BUTTON_1"
msgstr "\"Such pride. Such confidence. By the curse of the Revenants [evilact/], you shall be my thrall!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8212@BUTTON_2"
msgstr "Leave."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8212@BUTTON_3"
msgstr "\"Hear me out, {EventUnit}, for the sake of the {EventRace}.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8212@TITLE"
msgstr "The {EventStructure}"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8213@BODY_FOOTER"
msgstr "\"Before you leave, I may bestow upon you my blessing, {EventHero},\" the {EventUnit} concludes. \"Which Celestial calling do you wish to follow?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8213@BODY_FOOTER@ASTRA_CORRUPTED"
msgstr "\"You have awoken the Void within me, {EventHero},\" the {FallenUnit} speaks. \"Which powers do you desire?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8213@BODY_HEADER"
msgstr "\"Your words seem guided by the Allfather, {PlayerLeader},\" the {EventUnit} says and for a moment a smile illuminates <<o:EventUnit>> face."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8213@BODY_HEADER@ASTRA_CORRUPTED"
msgstr "Neither the {EventRace} nor the {EventUnit} <<r:EventUnit>> could stop you. Now dark whispers spread the Revenant curse."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8213@BODY_HEADER@ASTRA_FREED"
msgstr "With the {EventRace} at the {EventStructure} slain, the spell binding the {EventUnit} has been broken."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8213@BODY_LORE"
msgstr "<<Cp:EventUnit>> beckons the present leader of the {EventRace} to come closer, saying <<p:EventUnit>> wishes to speak to {EventPlayer}.[br/][br/]Then the {EventUnit} turns back to you. \"I can see your desire to reach Emnora, {EventHero}. Return to the {EventZiggurat} and it will be good.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8213@BODY_LORE@ASTRA_CORRUPTED"
msgstr "\"Grace to Disgrace[br/]Life to Unlife[br/]To become what you fought[br/][runicfont]And dwell in Urrath's shadow[/runicfont]\"[br/][br/]As the insidious whispers speak, dark tendrils lash out from the deceased corpses of the {EventRace}, covering the {EventUnit} until <<p:EventUnit>> rises again as a {FallenUnit}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8213@BODY_LORE@ASTRA_FREED"
msgstr "\"You have freed me,\" the {EventUnit} says, spreading <<o:EventUnit>> wings. \"And for this I am grateful. I can see your desire to reach Emnora, {EventHero}. Return to the {EventZiggurat} and it will be good.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8213@BUTTON_0"
msgstr "\"I wish to smite the wicked.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8213@BUTTON_1"
msgstr "\"I wish to heal the meek.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8213@BUTTON_2"
msgstr "\"I wish to be a beacon of sanctity.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8213@BUTTON_3"
msgstr "\"I desire to rend my enemies with freezing decay.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8213@BUTTON_4"
msgstr "\"I desire to bind all to my corruption.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8213@BUTTON_5"
msgstr "\"I desire to thrive in death.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8213@TITLE"
msgstr "The {EventStructure}: Aftermath"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8216@BODY_FOOTER"
msgstr "\"The [hyperlink,GLOBAL.RevenantsLoreConcept]Revenant[/hyperlink] curse is a corruption of holiness itself,\" the {EventUnit} ends. \"We must ward our Celestial lands from its reach, or all may be tainted.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8216@BODY_HEADER"
msgstr "\"You seem determined,\" the {EventUnit} says, spreading <<o:EventUnit>> wings. \"Yet, compassion is a gift best reserved for the living.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8216@BODY_LORE"
msgstr "\"There is sanctity within each soul, be it Man, Elf or Archon,\" <<p:EventUnit>> explains with gravity. \"We {GLOBAL.ArchonsLoreConcept.Hyperlink} watch over the integrity of all {GLOBAL.SoulsLoreConcept.Hyperlink} as they leave their mortal husks, protecting their journey to rejoin the {GLOBAL.AllfatherLoreConcept.Hyperlink}. Necromancy, however, is a perversion of the soul. It opens the door to the path of no return. Only the end of their unlife may restore peace to the souls who suffered such fate.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8216@BUTTON_0"
msgstr "\"We must not let fear control our actions [influence/] or Urrath will have won this war!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8216@BUTTON_1"
msgstr "\"To achieve the impossible, cure the incurable — what greater calling could there be for the sages [knowledge/] of the divine?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8216@BUTTON_2"
msgstr "\"When we turn our backs on the meek and diseased, we lose the spark of divinity that hallowed our actions.\" [goodact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8216@BUTTON_3"
msgstr "Leave, for now."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8216@TITLE"
msgstr "The Price of Unlife"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8232@BODY_FOOTER"
msgstr "{EventPlayer} expires, <<o:EventPlayer>> body resting as if it found peace at last. Yet you know the works of Urrath can be deceptive."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8232@BODY_HEADER"
msgstr "Beaten and wounded, {EventPlayer} last words are spoken as if in a feverish, Umbral dream."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8232@BODY_LORE"
msgstr "\"The stars are fading, the divine light... devoured,\" <<p:EventPlayer>> utters, \"A blackness thickens, absolute and all-encompassing... The Well eclipsed, forever dessicated... [runicfont]our mouths, Celestial gates no longer[/runicfont]...\" Suddenly <<o:EventPlayer>> eyes tear open and <<o:EventPlayer>> hands cramp violently. \"Stay with me, brothers!\" <<p:EventPlayer>> yells. \"My sin must not stain your souls. Flee the ceaseless Void! [runicfont]Flee![/runicfont]\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8232@BUTTON_0"
msgstr "Sanctify [mana/] the location at which {EventPlayer} fell. [goodact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8232@BUTTON_1"
msgstr "Leave the remaining {EventRace} to mourn their leader."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8232@BUTTON_2"
msgstr "Stir the darkness, to graft the souls [souls/] of the {EventRace}. [evilact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8232@TITLE"
msgstr "The Fall of {EventPlayer}"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8234@BODY_FOOTER"
msgstr "But tremendous Astral shears tear at the vortex. There is no time to enter, only to pull something through..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8234@BODY_HEADER"
msgstr "Examining the arch, you seek to attune your mind to its arcane emanations."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8234@BODY_LORE"
msgstr "There is a strong Celestial magic dwelling within the arch. You can sense the divine incantations that imbued the arch with its power, yet when retracing their underlying Astral currents they elude your reach. You delve deeper, following the currents through ripples and into the maelstrom. You reach out to its center—and force open a star-lit vortex at the Ziggurat's chamber!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8234@BUTTON_0"
msgstr "Summon a divine being [unit/] of Emnora."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8234@BUTTON_3"
msgstr "Summon a corrupt being [unit/] seeking to infiltrate Emnora."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8234@BUTTON_4"
msgstr "Summon an Astral being [unit/] encircling Emnora."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8234@TITLE"
msgstr "Secrets of Ascension"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8235@BODY_FOOTER"
msgstr "In a shower of revelation you raise your own voice and speak..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8235@BODY_FOOTER@NO_RULER"
msgstr "In a shower of revelation {EventHero} raises <<o:EventHero>> voice and speaks..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8235@BODY_HEADER"
msgstr "Kneeling at the arch, your mind embarks on a spiritual journey."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8235@BODY_HEADER@NO_RULER"
msgstr "Kneeling at the arch, the mind of {EventHero} embarks on a spiritual journey."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8235@BODY_LORE"
msgstr "It is as if your spirit had ventured through the {EventStructure}, visiting the higher rings of Emnora. You see blessed trees and grand statuary. People with Angelic features are traveling the paved roads, entering starlit halls in which oracles speak of the days to come. At last your mind follows their divine emanations, soaring the {GLOBAL.AstralSeaLoreConcept.Hyperlink}, until the vivid image of {GLOBAL.TheWellLoreConcept.Hyperlink} replenishes your thoughts, gently encompassing your consciousness, washing away grief, ambition, sin..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8235@BODY_LORE@NO_RULER"
msgstr "It is as if <<o:EventHero>> spirit had ventured through the {EventStructure}, visiting the higher rings of Emnora. <<Cp:EventHero>> sees blessed trees and grand statuary. People with Angelic features are traveling the paved roads, entering starlit halls in which oracles speak of the days to come. At last <<o:EventHero>> mind follows their divine emanations, soaring the {GLOBAL.AstralSeaLoreConcept.Hyperlink}, until the vivid image of {GLOBAL.TheWellLoreConcept.Hyperlink} replenishes <<o:EventHero>> thoughts, gently encompassing <<o:EventHero>> consciousness, washing away grief, ambition, sin..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8235@BUTTON_0"
msgstr "... a mantra [mana/] of faith. [knowledge/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8235@BUTTON_3"
msgstr "... a mantra [mana/] of zeal. [knowledge/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8235@BUTTON_4"
msgstr "... a mantra [mana/] of virtue. [knowledge/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8235@BUTTON_5"
msgstr "... a mantra [mana/] of light. [knowledge/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8235@BUTTON_6"
msgstr "... a mantra of humility. [order/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8235@TITLE"
msgstr "Prayers of Ascension"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8236@BODY_FOOTER"
msgstr "\"I can tell you desire to pass yourself, {PlayerLeader},\" {EventHero} concludes. \"Allow me to aid you on your journey. Together we will make it through.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8236@BODY_HEADER"
msgstr "Approaching the figure at the end of the chamber, it steps out of the shadows."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8236@BODY_LORE"
msgstr "\"Greetings, fellow {GLOBAL.GodirLoreConcept.Hyperlink},\" <<p:EventHero>> says. \"I am {EventHero.TitleName}. I have observed this {EventStructure}. Many have come to step through its portal arch, yet they all left disgruntled. Only for two, a devout Simian and an Elven lady in dismay, the starlit vortex opened, but without allowing much insight to be gained about its Celestial magic...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8236@BUTTON_0"
msgstr "\"Join me [unitHero/], {EventHero.TitleName}.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8236@BUTTON_3"
msgstr "\"Join me [unitHero/], {EventHero.TitleName}, when the time has come.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8236@BUTTON_4"
msgstr "\"The path to Emnora [influence/] is a solitary one.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8236@TITLE"
msgstr "Partners of Ascension"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8237@BODY_FOOTER"
msgstr "\"You have summoned me, master!\" the {EventUnit} shouts giggling. \"Now command me, O god of destruction!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8237@BODY_HEADER"
msgstr "You stand with the {EventItem} raised, ready to smash the arch..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8237@BODY_LORE"
msgstr "... and nothing happens. So you strike the arch with all your might. The ground is shaking, yet the ancient arch shows not even the smallest crack. You strike again, and again, until at last a crimson vortex opens in the arch's center. Before you can enter in triumph however, the vortex collapses again as a {EventUnit} hops through."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8237@BUTTON_0"
msgstr "Accept the {EventUnit} into your ranks. [unit/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8237@BUTTON_3"
msgstr "Kill the {EventUnit} for training. [xp/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8237@BUTTON_4"
msgstr "Command the {EventUnit} to shatter [bindingfragments/] as many Archon relics as <<p:EventUnit>> can find."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8237@TITLE"
msgstr "Shattered Ascension"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8370@BODY_FOOTER"
msgstr "\"Do not underestimate {EventPlayer},\" {OracleName} urges you. \"<<Co:EventPlayer>> divine wrath will unleash when you least expect it.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8370@BODY_HEADER"
msgstr "In the tension of <<ge:ordeal^n,{EventPlayer}>>, {OracleName} comes before you with a warning."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8370@BODY_LORE"
msgstr "\"It is a grim twist of fate that you must face the {EventRace}, {PlayerLeader},\" <<p:EventUnit>> says with a concerned voice. \"Their Order is renowned for their martial skills—and belligerence. Since my own leave-taking, their influence among the Archon Orders has diminished. But they remain a force to be reckoned with, their Celestial hosts a fearsome sight to behold.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8370@BUTTON_0"
msgstr "\"When they descend, we will be prepared.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8370@TITLE"
msgstr "Sacred Warriors"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8374@BODY_FOOTER"
msgstr "At <<ge:command^n,{EventPlayer}>> the Celestial hosts of the realm are marching upon your cities."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8374@BODY_HEADER"
msgstr "The clouds above your cities are breaking as the trumpets of the {EventRace} are sounded."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8374@BODY_LORE"
msgstr "Accompanied by their divine clarion call, the voice of {EventPlayer} swells, sublime and terrible:[br/][br/]\"Gather, my holy champions![br/]Focus the sacred light of the {GLOBAL.AllfatherLoreConcept.Hyperlink} until it burns as a cleansing flame![br/]Make {PlayerLeader} tremble before your might!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8374@BUTTON_0"
msgstr "Prepare to face the heavenly forces."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8374@TITLE"
msgstr "Call of the Archon"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8382@BODY_FOOTER"
msgstr "Following <<ge:mandate^n,EventPlayer>>, the Celestial hosts of the realm continue their assault."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8382@BODY_HEADER"
msgstr "The sounding of trumpets heralds the arrival of another {GLOBAL.STRUCTURES.CRUSADER_HOST.Hyperlink} {EventDirection} {EventCity}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8382@BODY_HEADER@NO_CITIES"
msgstr "The sounding of trumpets heralds the arrival of another {GLOBAL.STRUCTURES.CRUSADER_HOST.Hyperlink} {EventDirection} you."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8382@BODY_LORE"
msgstr "With a {EventStackLeader} at their lead, the holy warriors of the realm show no sign of tiredness or remorse. By now it is clear that in order to stop their attacks, you must overcome {EventPlayer} <<r:EventPlayer>>."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8382@BUTTON_0"
msgstr "\"We will endure until {EventPlayer} is overwhelmed!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8382@TITLE"
msgstr "Celestial Tenacity"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8386@BODY_FOOTER"
msgstr "\"Today I must withdraw,\" {EventPlayer} speaks as the Ward of the Archons begins to enshroud <<P:EventPlayer>>. \"Tomorrow, the {EventRace} will face you in replenished glory.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8386@BODY_FOOTER@PLAYER_HUMANFORM"
msgstr "\"Ascend to Emnora!\" {EventPlayer} calls out while the Ward of the Archons begins to enshroud <<P:EventPlayer>>. \"And we may yet meet again as {EventRace}.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8386@BODY_HEADER"
msgstr "Amid splintered chariot wheels and shattered Celestial armor, {EventPlayer} stands, defeated but not broken."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8386@BODY_LORE"
msgstr "\"Your powers are formidable, {PlayerLeader},\" <<p:EventPlayer>> says with forced calm, but you can sense a wrathful torrent raging within <<P:EventPlayer>>. \"You have overcome my soldiers, torn down my walls, stridden through cleansing flame. Thus, you have passed my ordeal and I shall honor my word to grant you passage.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8386@BODY_LORE@PLAYER_HUMANFORM"
msgstr "\"Your powers are formidable, {PlayerLeader},\" <<p:EventPlayer>> congratulates you, and there is a strange notion of pride in <<o:EventPlayer>> voice. \"You have overcome my soldiers, torn down my walls, stridden through cleansing flame. Truly, you have proven your potential as an Archon aspirant and passed my ordeal.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8386@BUTTON_0"
msgstr "Plan your return to the {EventStructure}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8386@TITLE"
msgstr "<<Cge:admission^n,{EventPlayer}>>"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8398@BODY_FOOTER"
msgstr "\"You must master your fears, {PlayerLeader}\" {OracleName} prophesies, \"or you will succumb to the incarnations of woe.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8398@BODY_HEADER"
msgstr "Having ascended to the Third Ring of Emnora, {OracleName} appears before you, <<o:EventUnit>> face pale as marble."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8398@BODY_LORE"
msgstr "\"The visions are growing stronger, are they not, {PlayerLeader}?\" <<p:EventUnit>> asks and you know <<p:EventUnit>> needs no answer. \"I spoke of this before, as you recall: the {GLOBAL.AstralFlowsLoreConcept.Hyperlink} of Emnora are like dangerous mirrors of each Ascendant's soul. The higher you move up, the stronger your fears will become—until they step through the looking glass, manifesting into phantasms assaulting your sanity and life.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8398@BUTTON_0"
msgstr "\"I shall be ready when the time has come.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8398@BUTTON_3"
msgstr "\"My disciplined mind [mana/] will push back these visions.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8398@BUTTON_4"
msgstr "\"I embrace [xp/] this opportunity to confront my fears!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8398@TITLE"
msgstr "Looming Woe"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@BODY_FOOTER"
msgstr "The manifestations of your fears are marching on {EventCity}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@BODY_FOOTER@NO_CITIES"
msgstr "The manifestations of your fears are marching on you!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@BODY_HEADER"
msgstr "Awaking from a nightmare, you find the subjects of your perturbation vividly taking shape."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@BODY_LORE"
msgstr "There are scoundrels, looters, thieves, encroaching on your domain to steal your treasures. The most ruthless among them, a {EventStackLeader}, presents <<o:EventStackLeader>> empty pouch with a grin."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@BODY_LORE@ASTRAL"
msgstr "There are wisps, {GLOBAL.AstralMonstersLoreConcept.Hyperlink}, cosmic leeches, encroaching on your domain to siphon your arcane wealth. The most horrifying among them, a {EventStackLeader}, invokes the horrors of the {GLOBAL.AstralVoidLoreConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@BODY_LORE@CHAMPION"
msgstr "There are <<m:{GLOBAL.WizardKingLoreConcept.Hyperlink}>> and their retinue of battle mages, encroaching on your domain to wreak magic havoc on your people. The first of the <<m:{GLOBAL.WizardKingLoreConcept.Hyperlink}>>, {EventStackLeader}, channels a terrible {EventItem}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@BODY_LORE@CHAOS"
msgstr "There are zealots, inquisitors, tyrants, encroaching on your domain to enforce uttermost order. The most hallowed among them, a {EventStackLeader}, recites the commandments for all to follow."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@BODY_LORE@DRAGON"
msgstr "The very earth trembles as the <<m:{GLOBAL.GiantKingLoreConcept.Hyperlink}>> rise, commanding their kindred to tear down your cities. Towering above all is {EventStackLeader}, <<o:EventStackLeader>> {EventItem} lusting for dragon's blood."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@BODY_LORE@ELDRITCH"
msgstr "Shadowy tendrils lash out as the denizens of the {GLOBAL.UmbralAbyssConcept.Hyperlink} inflict the mark of {GLOBAL.UrrathLoreConcept.Hyperlink} upon the land and your people. Their Sovereign, {EventStackLeader}, calls out to you: \"[runicfont]Rejoice! Your return is nigh.[/runicfont]\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@BODY_LORE@GIANT"
msgstr "The skies tear open as the {GLOBAL.DragonsLoreConcept.Hyperlink} descend with destruction, ready to tear down your cities. Their Elder, {EventStackLeader}, roars with primal might, invoking the horrors of [hyperlink,GLOBAL.MyrridaLoreConcept]Myrrida's[/hyperlink] fall."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@BODY_LORE@NATURE"
msgstr "There are hunters, slayers, adventurers, encroaching on your domain to hunt all creatures small and tall. The most keen-eyed among them, a {EventStackLeader}, is wearing the skull of a {AnimalUnit}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@BODY_LORE@ORDER"
msgstr "There are infernal jesters, ravishers, demons, encroaching on your domain to plunge your people into sin. The most terrifying among them, a {EventStackLeader}, bares the teeth of <<o:EventStackLeader>> grotesque face."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@BODY_LORE@SHADOW"
msgstr "There are armed peasants, preachers, so-called 'champions of the meek', encroaching on your domain to instigate your population. The most audacious among them, a {EventStackLeader}, stages the hanging of a puppet clearly resembling you, {PlayerLeader}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@BODY_LORE@WK"
msgstr "The very earth trembles as its elemental incarnations rise, encroaching on your domain to tear down your cities. Towering above all is a {EventStackLeader}, <<o:EventStackLeader>> gaze imbued with primal fury."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@BUTTON_0"
msgstr "We must resist!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@TITLE"
msgstr "Incarnations of Woe"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@TITLE@ASTRAL"
msgstr "Incarnations of Drought"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@TITLE@CHAMPION"
msgstr "Incarnations of Hubris"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@TITLE@CHAOS"
msgstr "Incarnations of Subjugation"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@TITLE@DRAGON"
msgstr "Incarnations of Giant Vengeance"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@TITLE@ELDRITCH"
msgstr "Incarnations of Corruption"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@TITLE@GIANT"
msgstr "Incarnations of Draconic Wrath"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@TITLE@MATERIUM"
msgstr "Incarnations of Thievery"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@TITLE@NATURE"
msgstr "Incarnations of the Hunt"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@TITLE@ORDER"
msgstr "Incarnations of Sin"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@TITLE@SHADOW"
msgstr "Incarnations of Upheaval"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8400@TITLE@WK"
msgstr "Incarnations of Devastation"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8463@BODY_FOOTER"
msgstr "While the Archon savants gaze at the fountain, you are left to ponder your own steps."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8463@BODY_HEADER"
msgstr "Entering the center hall of the {EventStructure}, you hear the gentle splashing of water."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8463@BODY_LORE"
msgstr "The noise comes from the enormous fountain located right below the cupola roof of the observatory. Most of the savants of the Order of Augurs are watching the fountain and its ever-shifting reflections from a variety of viewpoints within the hall. Their concerted silence is oddly captivating, enticing you to join their meditations."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8463@BUTTON_0"
msgstr "Mingle with the Order of Augurs and meditate at the fountain."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8463@BUTTON_1"
msgstr "Follow the waters to the courtyard garden."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8463@BUTTON_2"
msgstr "Leave."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8463@BUTTON_3"
msgstr "Visit the Chamber of Prophecies."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8463@TITLE"
msgstr "Flowing Wisdom"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8464@BODY_FOOTER"
msgstr "While the voice subsides, the Prophecy of Irith still resonates within your mind."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8464@BODY_HEADER"
msgstr "At the Chamber of Prophecies a beacon is lit. From within its floating light a pure voice recites:"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8464@BODY_LORE"
msgstr "\"From darkness whole the sun was born[br/]Its light shaped all, its light gave life[br/]Chromatic rays, through aeons torn[br/]Are captured after sun guard's strife[br/]Lo! once eclipsed, a darkness new[br/]The rising of an Umbral moon[br/]Distorts the light, snarls false and true[br/]Its shadows cast bring sun guard's doom\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8464@BUTTON_0"
msgstr "Leave, for now."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8464@BUTTON_3"
msgstr "\"The 'Umbral moon' has a name. We must fight Urrath till the bitter end!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8464@BUTTON_4"
msgstr "\"The 'sun guard's doom' mustn't be irrevocable. The Revenants should be met with compassion [goodact/], not fear.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8464@BUTTON_5"
msgstr "\"The 'chromatic rays' are again unbound and the Endailon's raw powers [mana/] can restore the old balance.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8464@TITLE"
msgstr "The Prophecy of Irith"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8465@BODY_FOOTER"
msgstr "\"It is easy to condemn the past once a prophecy has come to fruition,\" {EventPlayer} concludes with a smile. \"Is it not, {PlayerLeader}?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8465@BODY_HEADER"
msgstr "While your words still echo through the chamber of prophecies, {EventPlayer} enters the room."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8465@BODY_LORE"
msgstr "\"The Prophecy of Irith foretold much ill that would come upon the cosmos,\" <<p:EventPlayer>> says pensively. \"Among it, the sundering of my people.\" {EventPlayer} points at a relief on the wall, depicting a {GLOBAL.MaerLoreConcept.Hyperlink} floating through [hyperlink,GLOBAL.AstralFlowsLoreConcept]Astral Currents[/hyperlink]. \"I know who of the {GLOBAL.GloomwatchLoreConcept.Hyperlink} has led you to these shores, {PlayerLeader}. Tell {OracleName} that <<p:EventUnit>> is welcome to stay at the Lakes of Sagacity as long as <<p:EventUnit>> wishes.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8465@BUTTON_0"
msgstr "Agree. There were too many ways this prophecy could unfold."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8465@BUTTON_5"
msgstr "Disagree. Despite knowing the future, the Archons made grave mistakes."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8465@TITLE"
msgstr "Flowing Wisdom: Aftermath"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8466@BODY_FOOTER"
msgstr "Mesmerized by the scene, it takes a while until you ponder what to do."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8466@BODY_HEADER"
msgstr "Echoing from the cupola of the {EventStructure}, an ecstatic voice can be heard."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8466@BODY_LORE"
msgstr "The voice belongs to an {EventUnit}, seated high upon a stand. The <<EventUnit{man/woman}>> seems to be shaken by visions, bursting out in exclamations, while <<p:EventUnit>> clutches at the golden poles of <<o:EventUnit>> stand. Several scribes are gathered below the {EventUnit}, noting down <<o:EventUnit>> revelations, while three attendants administer <<P:EventUnit>> with waters and oils to relieve <<o:EventUnit>> feverish frenzy."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8466@BUTTON_0"
msgstr "Observe the {EventUnit} more closely."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8466@BUTTON_1"
msgstr "Enter the library wing of the {EventStructure}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8466@BUTTON_2"
msgstr "Leave, for now."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8466@BUTTON_3"
msgstr "Visit the Chamber of Prophecies."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8466@TITLE"
msgstr "Fervid Divination"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8467@BODY_FOOTER"
msgstr "Turning to you the savant adds: \"The friends of {OracleName} are welcome guests. By all means, take a look around.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8467@BODY_HEADER"
msgstr "Entering the {EventStructure}, you are joined by {OracleName}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8467@BODY_LORE"
msgstr "Both of you find the Order of Augurs working in silent sedulousness, engaged in various archiving tasks. However as you walk through the cupola hall, hushed whispers start to spread, while the Augurs covertly glance in your direction. At last one of the savants steps up, speaking to {OracleName}: \"It is a great pleasure to welcome you back in this house of wisdom, <<OracleName{brother/sister}>>. You will find that we kept your works in high esteem.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8467@BUTTON_0"
msgstr "Climb the stairs to the observatory roof."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8467@BUTTON_1"
msgstr "Take {OracleName} to a side room to speak in private..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8467@BUTTON_2"
msgstr "Leave."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8467@BUTTON_3"
msgstr "Visit the Chamber of Prophecies."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8467@TITLE"
msgstr "A Return Unforeseen"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8468@BODY_FOOTER"
msgstr "\"Though as you see,\" {EventPlayer} ends <<o:EventPlayer>> speech, \"this is no ending for an Oracle, only the transition to something new.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8468@BODY_HEADER"
msgstr "While your words still echo through the Chamber of Prophecies, {EventPlayer} enters the room."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8468@BODY_LORE"
msgstr "\"It would seem you are destined for something of great importance,\" <<p:EventPlayer>> addresses you, smoothing out <<o:EventPlayer>> robe, \"for you witnessed a rare moment of true enlightenment. And no less one intertwining with my own prophecy—the Prophecy of Anon. You may have wondered why our prophecies are named after their prophet. It is quite simple: once an Oracle has basked in the light of truth, their divine senses grow dim and they will never again reveal the Allfather's light.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8468@BUTTON_0"
msgstr "Thank {EventPlayer} for <<o:EventPlayer>> insights."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8468@TITLE"
msgstr "Fervid Divination: Aftermath"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8469@BODY_FOOTER"
msgstr "\"For disbelievers doubt appears to be the enemy of faith,\" {EventPlayer} concludes. \"Yet it is often he without doubt who is forsaken.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8469@BODY_HEADER"
msgstr "While your words still echo through the Chamber of Prophecies, {EventPlayer} enters the room."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8469@BODY_LORE"
msgstr "\"As you can see, {PlayerLeader},\" <<p:EventPlayer>> says, \"the interpretation of a prophecy can cause division even among us {GLOBAL.ArchonsLoreConcept.Hyperlink}. In a sense it is the reason why the Order of Augurs exists: so a healthy theological discourse can be had on the matters of cosmic importance. Where other Orders formulate dogmas to guide their followers, we formulate doubt. For it is when we stop doubting that the gravest missteps are taken.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8469@BUTTON_0"
msgstr "Agree. The sheep which blindly follows its shepherd can be easily led astray."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8469@BUTTON_5"
msgstr "Disagree. Doubt is the chink through which Urrath's whispers may enter."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8469@TITLE"
msgstr "A Return Unforeseen: Aftermath"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8470@BODY_FOOTER"
msgstr "While the voice subsides, the Prophecy of Anon still resonates within your mind."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8470@BODY_HEADER"
msgstr "At the Chamber of Prophecies, a beacon is lit. From within its floating light a deep voice, which you recognize as <<ge:voice^n,EventPlayer.FirstName>>, recites:"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8470@BODY_LORE"
msgstr "\"Divine Myopia, Balance Enchained;[br/]Giant Empires Fall, Corruption Reigns;[br/][br/]From Traitor's Blood, Fate's Trail Divides;[br/]Darkness Slain, Through Fractured Light;[br/][br/]Divine Guard must Rest, For New Powers to Rise;[br/]Who Weigh the Cost of Mercy, To a Vengeful Demise.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8470@BUTTON_0"
msgstr "Leave, for now."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8470@BUTTON_3"
msgstr "\"Myrrida fell to its hubris. We mustn't repeat their mistakes!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8470@BUTTON_4"
msgstr "\"The time of 'Divine Guard must Rest' has come to an end. Magehaven calls upon the Archons [influence/] and their might!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8470@BUTTON_5"
msgstr "\"On Sordünn the 'Fractured Light' shall be reforged!\" [bindingessence/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8470@TITLE"
msgstr "The Prophecy of Anon"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8471@BODY_FOOTER"
msgstr "While the voice subsides, the Prophecy of Miopthera still resonates within your mind."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8471@BODY_HEADER"
msgstr "At the chamber of prophecies a beacon is lit. From within its floating light a familiar voice—<<ge:voice^n,{OracleName}>>!—recites:"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8471@BODY_LORE"
msgstr "\"Young are the children of twilight[br/]Their creative powers unbound[br/]Not ours is their will to guide[br/]In need of a freedom profound[br/]Fear not their dreams in violent night[br/]Ward them from harm and boundaries cold[br/]From cradles shaped to their delight[br/]Their sublime destiny will unfold.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8471@BUTTON_0"
msgstr "Leave, for now."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8471@BUTTON_3"
msgstr "\"We Godir are the 'children of twilight.' Archon dogmas will not hold us back!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8471@BUTTON_4"
msgstr "\"Human favoritism has cost the Archons much credibility. Amends [gold/] for the other races could change that...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8471@BUTTON_5"
msgstr "\"We must learn more [knowledge/] about the Dreamers and their 'sublime destiny!'\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8471@TITLE"
msgstr "The Prophecy of Miopthera"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8473@BODY_FOOTER"
msgstr "\"Allow me to help you interpret the prophecies, {PlayerLeader},\" {EventHero.FirstName} urges you, \"so you can reach the High Council.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8473@BODY_HEADER"
msgstr "\"Or so they say.\" {EventHero} returns to gaze at the rippling waters."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8473@BODY_LORE"
msgstr "\"Staying at the Lakes of Sagacity has soothed my mind,\" <<p:EventHero>> continues after a while. \"Observing the {GLOBAL.AstralSeaLoreConcept.Hyperlink}, listening to the Order of Augurs, reading Archon tracts about prophecies—it's all part of a journey I did not expect. Yet my heart is too restless to savor these gifts.\"[br/][br/]\"Perhaps it is not my fate to reach Emnora myself. Perhaps,\"—{EventHero.FirstName} turns to you again—\"I have been brought here as an aide.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8473@BUTTON_0"
msgstr "Accept {EventHero} into your ranks. [unitHero/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8473@BUTTON_3"
msgstr "Invite {EventHero.FirstName} to your Wizard's Tower [caststrategic/] to bolster your magecraft instead."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8473@TITLE"
msgstr "A Fateful Calling"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8475@BODY_FOOTER"
msgstr "\"The answer is inherent in these waters,\" the savant suggests, \"hidden yet palpable. Can you read it, {PlayerLeader.Name}?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8475@BODY_HEADER"
msgstr "Standing amid the savants of the Order of Augurs, one of them quietly approaches you."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8475@BODY_LORE"
msgstr "\"The waters of the fountain are entrancing, aren't they?\" <<p:EventUnit>> remarks with a muffled voice. \"Under their spell, Irith pronounced her fateful prophecy. The ages past and here we still sit, pondering its full meaning: has the 'sun guard's doom' yet come to fulfillment? Or is it the destiny of all {GLOBAL.ArchonsLoreConcept.Hyperlink} to become {GLOBAL.RevenantsLoreConcept.Hyperlink} at last?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8475@BUTTON_0"
msgstr "Decline to read the waters."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8475@BUTTON_3"
msgstr "Let your arcane eye [mana/] harness the secrets [knowledge/] of the fountain."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8475@TITLE"
msgstr "A Doom Foretold"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8476@BODY_FOOTER"
msgstr "\"I feel the presence of the {GLOBAL.EndailonLoreConcept.Hyperlink}, distant, yet all-encompassing,\" {EventHero.FirstName} concludes. \"Can you sense it too?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8476@BODY_HEADER"
msgstr "Entering the garden, you are joined by {EventHero}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8476@BODY_LORE"
msgstr "\"There dwells a beauty in these Archon gardens that I did not expect,\" {EventHero.FirstName} says, <<o:EventHero>> eyes closed as <<p:EventHero>> slowly breathes in. \"We see the {GLOBAL.ArchonsLoreConcept.Hyperlink} as holy warriors, priests, paladins, unaware that they were the worlds' architects and gardeners.\" <<Cp:EventHero>> draws you to a lush bed of flowers. \"If only they had remembered the beauty of all colors. But by culling bad weeds, they condemned their own works.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8476@BUTTON_0"
msgstr "\"I feel fervor, ardent and rousing.\" [chaosboon/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8476@BUTTON_3"
msgstr "\"I feel rancor, cold and relentless.\" [shadowboon/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8476@BUTTON_4"
msgstr "\"I feel growth, tangled and rampant.\" [natureboon/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8476@BUTTON_5"
msgstr "\"I feel industriousness, steady and firm.\" [materiumboon/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8476@BUTTON_6"
msgstr "\"I feel unity, structured and harmonious.\" [orderboon/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8476@BUTTON_7"
msgstr "\"I feel ingenuity, surging and enchanting.\" [astralboon/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8476@BUTTON_8"
msgstr "\"I am devoid of the Endailon's influence.\" [influence/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8476@TITLE"
msgstr "Blooming Echoes"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8493@BODY_FOOTER"
msgstr "\"I urge you to explore these early Archon works,\" {EventHero.FirstName} beckons you. \"It is enlightening, even if not necessarily in the Archon sense.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8493@BODY_HEADER"
msgstr "At the library wing of the {EventStructure} you are joined by {EventHero}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8493@BODY_LORE"
msgstr "\"Getting a glimpse at the wealth of texts debating their prophecies has taught me much about the {GLOBAL.ArchonsLoreConcept.Hyperlink},\" <<p:EventHero>> says, <<o:EventHero>> fingers slowly moving over the symbols at the bookshelves, denoting their era and category. \"They long thought Anon's Prophecy foretold the fall of {GLOBAL.MyrridaLoreConcept.Hyperlink}. Hence, after Myrrida had been sieged down, they withdrew from many {GLOBAL.WorldsWithinLoreConcept.Hyperlink}, since 'Divine Guard must Rest, For New Powers to Rise'. Which in turn facilitated the {GLOBAL.EndailonCrisisLoreConcept.Hyperlink}...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8493@BUTTON_0"
msgstr "Read about the Allfather and the creation of the Archons. [order/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8493@BUTTON_3"
msgstr "Read about the spreading of the Astral Sea. [arcana/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8493@BUTTON_4"
msgstr "Read about the Urwilderness and its rampant evolution. [nature/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8493@BUTTON_5"
msgstr "Read about the shaping of the Worlds Within through Dragons and Giants. [matter/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8493@BUTTON_6"
msgstr "Read about the cosmic uproar during the Endailon Crisis. [chaos/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8493@BUTTON_7"
msgstr "Read about the emergence of Urrath from the Astral Void. [shadow/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8493@TITLE"
msgstr "Chronicled Aberrations"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8494@BODY_FOOTER"
msgstr "<<Cge:eyes^p,{EventHero.FirstName}>> grow misty as <<p:EventHero>> gazes at the stars above. \"We never knew about the cosmic stakes involved. But we all suffered the consequences.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8494@BODY_HEADER"
msgstr "Reaching the starlit roof of the {EventStructure}, you find {EventHero} deep in thoughts."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8494@BODY_LORE"
msgstr "\"Being confronted with the prophecy that has shaped the lives of my family—and of entire races on {GLOBAL.AthlaLoreConcept.Hyperlink}—is staggering,\" {EventHero.FirstName} says once <<p:EventHero>> notices you. \"The Order of {EventRace} formed around a very specific belief: the belief that Miopthera's Prophecy spoke of the then still young Human race. They let the Elves seed world after world for Humans to inhabit, so they might ascend to Archonhood. Until my father broke their ancient agreement on {GLOBAL.AthlaLoreConcept.Hyperlink}...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8494@BUTTON_0"
msgstr "Console {EventHero} by connecting with the flows [mana/] to accentuate the Astral Sea's beauty."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8494@BUTTON_3"
msgstr "Leave {EventHero.FirstName} to <<o:EventHero>> dolefulness."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8494@TITLE"
msgstr "Highmen Tragedies"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8495@BODY_FOOTER"
msgstr "After this last revelation, the {EventUnit} is taken to a resting place in the chambers behind the cupola hall."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8495@BODY_HEADER"
msgstr "Moving closer to the {EventUnit}, <<o:EventUnit>> violently called out words become clearer."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8495@BODY_LORE"
msgstr "\"... fractured light, it is fading... tainted by traitor's malformed hands... the daughter, she must rejoin the mother... impossible union of darkness and light...\"[br/][br/]The {EventUnit} collapses, carried to rest by <<o:EventUnit>> attendants. As they walk past you, the <<EventUnit{man/woman}>> suddenly draws <<r:EventUnit>> up once more: \"On Sordünn... on Sordünn's Cliffs new powers rise!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8495@BUTTON_0"
msgstr "Reflect on the words of the {EventUnit}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8495@TITLE"
msgstr "A Moment of Prophecy"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8496@BODY_FOOTER"
msgstr "\"It was only after the {GLOBAL.GloomwatchLoreConcept.Hyperlink} found me in exile that my prophecy—and thus my life—received new meaning,\" {OracleName} concludes <<o:OracleName>> reminiscence. \"Now I foster the {GLOBAL.DreamersLoreConcept.Hyperlink}, the true 'Children of Twilight.'\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8496@BODY_HEADER"
msgstr "Once alone, before you can confront <<P:OracleName>>, {OracleName} already raises <<o:OracleName>> voice:"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8496@BODY_LORE"
msgstr "\"I knew this conversation would come,\" <<p:OracleName>> says, touching <<o:OracleName>> temples. \"And at this stage you deserve to know more. A long time ago—in a different life—I used to be an Archon of the Order of Augurs. After my epiphany, the consequences of my own prophecy were daunting: the rise of the Order of {EventRace}, the dressing of entire worlds for humanity, the growing tensions with other races—I despaired, unable to stop what my words had set in motion.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8496@BUTTON_0"
msgstr "Thank {OracleName} for <<o:OracleName>> trust in you."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8496@TITLE"
msgstr "The Archon Renegade"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8534@BODY_FOOTER"
msgstr "The voices fade, allowing your strained mind to rest. You can intuit that their verdict is still to come."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8534@BODY_HEADER"
msgstr "Standing amid the grand statuary of the High Council a radiant light enfolds your senses. You see visions of flaring spirits, their words of debate echoing through your mind:"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8534@BODY_LORE"
msgstr "\"They have shown signs of great promise.\"[br/]\"It matters not. The [hyperlink,GLOBAL.GodirLoreConcept]Deogai[/hyperlink] are not to be trusted.\"[br/]\"They are not uniform, their voices in discordance.\"[br/]\"The ways of [hyperlink,GLOBAL.AllfatherLoreConcept]Illaetas[/hyperlink] are manifold.\"[br/]\"[hyperlink,GLOBAL.TurielLoreConcept]Turiel[/hyperlink] warned us about their ambitions.\"[br/]\"The [hyperlink,GLOBAL.GrexolisLoreConcept]task[/hyperlink] we burdened him with drowned him in Shadows.\"[br/]\"There are Shepherds among them, earnest and vigilant.\"[br/]\"Yet there are Butchers, Hatemongers, Defilers.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8534@BUTTON_0"
msgstr "Approach the next seat of communion."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8534@TITLE"
msgstr "The Archon High Council: Alpha"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8536@BODY_FOOTER"
msgstr "The voices fade, allowing your exhausted mind to rest. You can intuit that their verdict is near."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8536@BODY_HEADER"
msgstr "As the radiant light returns, the council's debate continues:"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8536@BODY_LORE"
msgstr "\"The [hyperlink,GLOBAL.MagehavenLoreConcept]beacon[/hyperlink] was abandoned, the luminaries darkened.\"[br/]\"The custodian's fallacy must not be repeated.\"[br/]\"Their war is our war, our paths coalesce.\"[br/]\"They are susceptible to the voice of [hyperlink,GLOBAL.UrrathLoreConcept]Nilfero[/hyperlink].\"[br/]\"Its anguish grapples even Emnora.\"[br/]\"Their destiny foretells finality.\"[br/]\"Do their souls not long for [hyperlink,GLOBAL.AllfatherLoreConcept]Illaetas[/hyperlink]?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8536@BUTTON_0"
msgstr "Approach the next seat of communion."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8536@TITLE"
msgstr "The Archon High Council: Nu"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8537@BODY_FOOTER"
msgstr "The council's voice fades, {EventHero} vanishing in their light."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8537@BODY_HEADER"
msgstr "From the radiant light a flaring wheel of eyes emerges. Its gaze petrifies your existence, while you hear the council's unified voice:"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8537@BODY_LORE"
msgstr "\"Hark, {PlayerLeader}, harbinger of need: the light that you sought is yet kindled inside. Be the torch that emblazes Magehaven's beacons, signaling the return of the Allfather's Host!\"[br/][br/]\"Hark, {EventHero}, progeny of autumn: the deadness of winter lies behind you. Fear not. Step into the light. In Emnora the buds of spring bloom.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8537@BUTTON_0"
msgstr "It is done."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8537@TITLE"
msgstr "The Archon High Council: Omega"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8539@BODY_FOOTER"
msgstr "\"I... will need some time to think. Please, {PlayerLeader}, allow me to withdraw to your Wizard's Tower, for the time being.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8539@BODY_HEADER"
msgstr "In the heat of the battle, just as {EventHero} is about to fall, the Ward of the Archons suddenly enshrouds <<P:EventHero>>."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8539@BODY_LORE"
msgstr "When <<p:EventHero>> reemerges from the light, <<o:EventHero>> wounds appear to be mended. \"I am not sure what happened,\" {EventHero.FirstName} says, looking at <<o:EventHero>> pristine hands in disbelief. \"But it appears that once again there are forces in play that do not want my journey to end.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8539@BUTTON_0"
msgstr "Let {EventHero.FirstName} suspend <<o:EventHero>> duties as your hero."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8539@BUTTON_1"
msgstr "Decline <<ge:request^n,{EventHero.FirstName}>>. [happiness/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8539@TITLE"
msgstr "Divine Intervention"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8549@BODY_FOOTER"
msgstr "\"By the power of {EventPlayer}, {EventPlayer.Title},\" the man says, revealing <<o:EventPlayer>> face. \"You shall not pass!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8549@BODY_FOOTER@SURPRISE_ATTACK"
msgstr "\"By the power of the Order of Augurs,\" {EventPlayer} shouts defiantly, \"you shall not pass!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8549@BODY_HEADER"
msgstr "Accompanied by a single scribe, a hooded man, humble yet exalted, awaits you at the bottom of the Ziggurat's stairs."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8549@BODY_HEADER@SURPRISE_ATTACK"
msgstr "You strike without warning, yet in a split second {EventPlayer} raises <<o:EventPlayer>> staff to invoke a shield of starlight."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8549@BODY_LORE"
msgstr "\"Recede, foul {PlayerLeader}!\" the man calls out, raising <<o:EventPlayer>> staff in defiance. \"The stars have unveiled to me your vicious machinations. I shall not let you taint these blessed lands. Return to the shadows or you will face the true wrath of the {GLOBAL.ArchonsLoreConcept.Hyperlink}!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8549@BODY_LORE@SURPRISE_ATTACK"
msgstr "\"Recede, foul {PlayerLeader}!\" {EventPlayer} calls out, enduring behind <<o:EventPlayer>> ward. \"The stars have unveiled to me your vicious intentions. I shall not let you taint these blessed lands. Return to the shadows or you will face the true wrath of the {GLOBAL.ArchonsLoreConcept.Hyperlink}!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8549@BUTTON_0"
msgstr "Accept the challenge. Tomorrow, the heavens will be weeping blood."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8549@TITLE"
msgstr "Unhallowed Revelations"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8551@BODY_FOOTER"
msgstr "\"You are forever condemned, {PlayerLeader},\" {EventPlayer} exclaims as the Ward of the Archons enshrouds <<P:EventPlayer>>. \"In the [hyperlink,GLOBAL.AstralVoidLoreConcept]Void[/hyperlink] you will regret.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8551@BODY_HEADER"
msgstr "The Lakes of Sagacity are tainted with the blood of the {EventRace}. {EventPlayer} <<r:EventPlayer>> has been brought to <<o:EventPlayer>> knees."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8551@BODY_LORE"
msgstr "\"The stirring evilness of the Pantheon has grown in power beyond our previsions,\" <<p:EventPlayer>> says slowly, collecting <<o:EventPlayer>> last strength. \"Could it be... the Prophecy of Dygenion... I should have seen it earlier.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8551@BUTTON_0"
msgstr "Such a fool. My victory was foretold!"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8551@TITLE"
msgstr "Wicked Triumph"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8552@BODY_FOOTER"
msgstr "Thick shadows swell at the {EventStructure}, binding its magic to your will. The path to the highest ring, it is open at last."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8552@BODY_HEADER"
msgstr "Standing at the site of <<ge:fall^n,{EventPlayer}>>, you channel <<o:EventPlayer>> lingering arcana to perform a dark ritual:"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8552@BODY_LORE"
msgstr "\"From tainted light[br/]To shadows deep[br/]Unholy blight[br/]A key will reap[br/]The holy door[br/]Unshut forevermore.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8552@BUTTON_0"
msgstr "Prepare to face the Archon High Council."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8552@TITLE"
msgstr "Unhallowed Revelations: Aftermath"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8559@BODY_FOOTER"
msgstr "The Celestial tempest of the Archon High Council rages. They know you are coming."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8559@BODY_HEADER"
msgstr "Descending the stairway of the last Ziggurat in sinister triumph, you behold the seat of the Archon High Council."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8559@BODY_LORE"
msgstr "Angelic statues and sacred trees flank your path, which winds down to an enormous {EventStructure}. Yet as soon as you step onto the path, the tranquility disperses. An unnatural breeze quickly swells into a storm, bending the holy tree lines, and thundering voices, exalted yet disturbed, echo from the walls of the monumental fountain."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8559@BUTTON_0"
msgstr "Approach the seat of the Archon High Council."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8559@TITLE"
msgstr "A Council in Turmoil"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8560@BODY_FOOTER"
msgstr "With concerted divine might, the Archon High Council banishes you from Emnora. Yet they cannot undo what you accomplished..."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8560@BODY_HEADER"
msgstr "Reaching the waters of the {EventStructure}, you become blinded by an all-encompassing light."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8560@BODY_LORE"
msgstr "There are shapes in the light, wrathful, aghast. You imagine you see wings, countless, flapping in terror, while the thundering voices call out your name with such fervor that the heavens themselves are shaken."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8560@BUTTON_0"
msgstr "\"I... shall... return!\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8560@TITLE"
msgstr "A Council in Turmoil: Aftermath"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8561@BODY_FOOTER"
msgstr "\"My duties as your ascended envoy have ended,\" {OracleName} calls out, invoking a sphere of starlight around <<r:OracleName>>. \"We will meet again as enemies.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8561@BODY_HEADER"
msgstr "As you strategize your conquest of Emnora, you are interrupted by {OracleName}."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8561@BODY_LORE"
msgstr "\"I have guided you through enigmas and cleansing flame,\" <<p:OracleName>> says, <<o:OracleName>> face pale as ivory. \"But alas, when it comes to you, {PlayerLeader}, my precognition has failed me. Now you seek to bring corruption to the most hallowed lands of my people.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8561@BUTTON_0"
msgstr "Let <<P:OracleName>> vanish. <<Cp:OracleName>> will pay for <<o:OracleName>> treason in time."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8561@TITLE"
msgstr "The Departure of {OracleName}"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8575@BODY_FOOTER"
msgstr "\"No!\" {EventPlayer} calls out with <<o:EventPlayer>> last strength. \"Through the {GLOBAL.AstralSeaLoreConcept.Hyperlink} our {GLOBAL.SoulsLoreConcept.Hyperlink} shall swim, unerring, enduring, until we return to... {GLOBAL.TheWellLoreConcept.Hyperlink}...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8575@BODY_HEADER"
msgstr "<<Co:EventPlayer>> vocal sac bleeding with every voiced syllable, {EventPlayer} feebly chants <<o:EventPlayer>> own dirge."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8575@BODY_LORE"
msgstr "\"Where is the Archon galley with blessed reinforcements?\" <<p:EventPlayer>> laments. \"Where the lighthouse guiding us to safe havens? The {EventRace} lie squashed upon the shores of battle. Is their fate not worthy of Archon deliverance?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8575@BUTTON_0"
msgstr "Light a beacon [mana/], guiding the {EventRace} on their final journey."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8575@BUTTON_1"
msgstr "Let <<P:EventPlayer>> die in peace."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8575@BUTTON_2"
msgstr "'Fish' for the afloat souls [souls/] of the {EventRace}. [evilact/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8575@TITLE"
msgstr "The Fall of {EventPlayer}"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8618@BODY_FOOTER"
msgstr "\"What say you, {PlayerLeader},\" {EventPlayer} asks, <<o:EventPlayer>> skin now reaching a yellow hue, \"shall we feast in friendship?\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8618@BODY_HEADER"
msgstr "While your scouts patrol the borders, looking out for the {GLOBAL.RevenantsLoreConcept.Hyperlink} of {RevenantPlayer}, you hear the familiar croaking of {EventPlayer} from afar."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8618@BODY_LORE"
msgstr "\"Righteous {PlayerLeader},\" {EventPlayer} chants, <<o:EventPlayer>> skin shifting in colors as if relaying a message of its own. \"We are pleased to see you joining the crusade against {RevenantPlayer}. The troubled waters near {EventCity} are treacherous to navigate. Yet if we set sail together, our landing will be triumphant!\"[br/][br/]\"It is customary among my people to seal an alliance with an exchange of food and men,\" <<p:EventPlayer>> continues, revealing a large banquet with presumed delicacies of the {EventRace} behind <<P:EventPlayer>>."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8618@BUTTON_0"
msgstr "Accept the alliance [rs_alliance/] and an exchange of troops. [unit/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8618@BUTTON_3"
msgstr "Accept the alliance [rs_alliance/] and an exchange of food. [food/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8618@BUTTON_4"
msgstr "Accept the alliance [rs_alliance/], but politely decline the rest."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8618@BUTTON_5"
msgstr "Decline the offer. The war with {RevenantPlayer} is your own."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8618@TITLE"
msgstr "A Warm Breeze"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8623@BODY_FOOTER"
msgstr "\"In the name of {GLOBAL.AthlaLoreConcept.Hyperlink} and {GLOBAL.MagehavenLoreConcept.Hyperlink} I beseech you, {PlayerLeader}:\" {EventHero} ends <<o:EventHero>> call, \"stop this madness now, when your soul can still find peace.\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8623@BODY_HEADER"
msgstr "Invading the Lakes of Sagacity, you find a lone Elven <<EventHero{man/woman}>>, calling out to you from a distance."

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8623@BODY_LORE"
msgstr "\"Leave now, {PlayerLeader}!\" <<p:EventHero>> shouts, <<o:EventHero>> gentle voice emanating authority. \"For these blessed lands deserve to remain in peace. I came here shaken by horrors. Staying with the Order of Augurs has soothed my mind.\"[br/][br/]\"I am {EventHero}, my people sharing a violent history with the {GLOBAL.ArchonsLoreConcept.Hyperlink},\" <<p:EventHero>> continues, revealing <<r:EventHero>> to you. \"Like few others I know the tainted allure of vengeance. When we bear a grudge we invite evil. The path to Emnora leads through forgiveness...\""

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8623@BUTTON_0"
msgstr "<<Co:EventHero>> warning is a testament to your might! [influence/]"

msgid "DLC@ARCHONPROPHECY@STORY_EVENT@991_8623@TITLE"
msgstr "An Elf Among Archons"

msgid "DLC@ARCHONPROPHECY@STORY_REALMS@NAME"
msgstr "Divine Intervention"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@CB@DAFAEL"
msgstr "Revenant Threat to Emnora"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@CB@MALIEL"
msgstr "Heavenly Mandate"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@CB@REVENANT_FREED_ASTRA"
msgstr "Destroyed Revenant Hopes for a Cure"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@COUNCIL_COMMUNION_OBJECTIVE"
msgstr "{INT_0}/{INT_1} Communed with High Council"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@DEFEAT_ANONL_QUEST_OBJECTIVE"
msgstr "{INT_0}/{INT_1} Anon Defeated"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@DEFEAT_MALIEL_QUEST_OBJECTIVE"
msgstr "{INT_0}/{INT_1} Maliel Defeated"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@DEFEAT_REVENANT_QUEST_OBJECTIVE"
msgstr "{INT_0}/{INT_1} Revenants Defeated"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@DESCRIPTION"
msgstr "Enter the hidden realm of Emnora, stronghold of the {GLOBAL.ArchonsLoreConcept.Hyperlink}, in a search for aid against {GLOBAL.UrrathLoreConcept.Hyperlink}. Fight or negotiate your way through the layers of Celestial Order to prove yourself and {GLOBAL.MagehavenLoreConcept.Hyperlink} worthy of the Archon High Council's attention."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@EFFECT@WIZARD_TOWER_REWARD"
msgstr "Your {GLOBAL.ThroneCityConcept.Hyperlink} {EventCity} gains the {GLOBAL.STRUCTURE_UPGRADES.WIZARD_TOWER_FOUNDATION.Hyperlink} {GLOBAL.CityStructureConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@FALLEN_ANGEL_NO_UPKEEP_PROP@DESCRIPTION"
msgstr "This unit is bound to their owner by the Revenant Curse and costs no upkeep."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@FALLEN_ANGEL_NO_UPKEEP_PROP@NAME"
msgstr "Bond of Corruption"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@GLOOMWATCH_RACE@DESCRIPTION"
msgstr "In the {GLOBAL.GloomwatchLoreConcept.Hyperlink} people of many different races and backgrounds meld, united by their service to the {GLOBAL.DreamersLoreConcept.Hyperlink}—and defiance against {GLOBAL.UrrathLoreConcept.Hyperlink}. A specifically mysterious group among them are the Gloomwatch Envoys. They are fair in appearance and adamant worshipers of the {GLOBAL.AllfatherLoreConcept.Hyperlink}. As such, they are very knowledgeable about the {GLOBAL.ArchonsLoreConcept.Hyperlink} and willing to aid [hyperlink,GLOBAL.MagehavenLoreConcept]Magehaven's[/hyperlink] {GLOBAL.GodirLoreConcept.Hyperlink} in their search of Archon contact."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@GLOOMWATCH_RACE@NAME"
msgstr "Gloomwatch Envoys^p"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@HIGH_COUNCIL@NAME"
msgstr "Seat of the Council^N"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@INFILTRATE_COUNCIL_OBJECTIVE"
msgstr "High Council Infiltrated"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@JULIA_WITHDRAWS"
msgstr "You lose {EventHero} as an on map {GLOBAL.HeroConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@MAIN_OBJECTIVE_FINAL"
msgstr "{AP1_COUNCIL_COMMUNED}/1 Archon High Council Contacted"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@MAIN_OBJECTIVE_FINAL_ALT"
msgstr "{AP1_COUNCIL_COMMUNED}/1 Archon High Council Infiltrated"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@MAIN_OBJECTIVE_FOURTH_RING"
msgstr "{AP1_RING_04_UNLOCKED}/1 Fourth Ring Reachable"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@MAIN_OBJECTIVE_FOURTH_RING_02"
msgstr "{AP1_RING_04_ENTERED}/1 Fourth Ring Entered"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@MAIN_OBJECTIVE_SECOND_RING"
msgstr "{AP1_RING_02_UNLOCKED}/1 Second Ring Reachable"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@MAIN_OBJECTIVE_SECOND_RING_02"
msgstr "{AP1_RING_02_ENTERED}/1 Second Ring Entered"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@MAIN_OBJECTIVE_THIRD_RING"
msgstr "{AP1_RING_03_UNLOCKED}/1 Third Ring Reachable"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@MAIN_OBJECTIVE_THIRD_RING_02"
msgstr "{AP1_RING_03_ENTERED}/1 Third Ring Entered"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@MOF@DRAFT_DEBUFF"
msgstr "While any crisis army is active, your <<m:{GLOBAL.CityConcept.Hyperlink}>> have {AP1_MOF_INCOME_DEBUFF}% {GLOBAL.UnitProductionConcept.Hyperlink} income."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@MOF@FOOD_DEBUFF"
msgstr "While any crisis army is active, your <<m:{GLOBAL.CityConcept.Hyperlink}>> have {AP1_MOF_INCOME_DEBUFF}% {GLOBAL.FoodConcept.Hyperlink} income."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@MOF@GLOOM_DEBUFF"
msgstr "While any crisis army is active, a random {GLOBAL.ProvinceConcept.Hyperlink} within your {GLOBAL.DomainConcept.Hyperlink} will terraform into {GLOBAL.GloomTerrainConcept.Hyperlink} every {AP1_MOF_DEBUFF_INTERVAL} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@MOF@GOLD_DEBUFF"
msgstr "While any crisis army is active, your <<m:{GLOBAL.CityConcept.Hyperlink}>> have {AP1_MOF_INCOME_DEBUFF}% {GLOBAL.GoldConcept.Hyperlink} income."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@MOF@HEADER_ASSAULT"
msgstr "The manifestations of your fears are assaulting your cities!"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@MOF@MANA_DEBUFF"
msgstr "While any crisis army is active, your <<m:{GLOBAL.CityConcept.Hyperlink}>> have {AP1_MOF_INCOME_DEBUFF}% {GLOBAL.ManaConcept.Hyperlink} income."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@MOF@NEXT_TOOLTIP"
msgstr "The next crisis army will spawn in {CrisisTimer} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@MOF@OBJ_ARMIES"
msgstr "Active Crisis Armies: {AP1_MOF_NUM_ARMIES}"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@MOF@POP_LOSS_DEBUFF"
msgstr "While any crisis army is active, one of your <<m:{GLOBAL.CityConcept.Hyperlink}>> loses a {GLOBAL.PopulationConcept.Hyperlink} every {AP1_MOF_DEBUFF_INTERVAL} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@MOF@SIEGE_DAMAGE"
