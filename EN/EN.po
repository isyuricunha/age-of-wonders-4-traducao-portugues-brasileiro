msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@TRAIT_WATER_VOID_PANGEA@DESCRIPTION"
msgstr "This realm consists of a single, connected landmass, shaken by cataclysms.[bulletlist][bullet/]Temperate <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> are [abilityblue]Rare[/abilityblue].[bullet/]Hostile climes such as Desolate <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> are [abilityblue]Common[/abilityblue].[bullet/]Ruins and ruined wonders are [abilityblue]Common[/abilityblue].[bullet/]<<m:{GLOBAL.IndependentCityConcept.Hyperlink} >> are [abilityblue]Absent[/abilityblue].[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@TRAIT_WATER_VOID_PANGEA@NAME"
msgstr "Devastated Pangea"

msgid "DLC@SECRETSOFTHEARCHMAGES@MINORFACTIONS_WORLD@RACE01@BIO"
msgstr "The disciples of the {GLOBAL.HorwyndLoreConcept.Hyperlink} School of Warding were originally tasked with preserving knowledge of battle and war. When the {GLOBAL.ArchonsLoreConcept.Hyperlink} established the <<m:{GLOBAL.CircleOfDeogaiLoreConcept.Hyperlink}>>, the School of honorable warriors and knights deployed their holy power to protect the Portals to the <<m:{GLOBAL.ShroudedIsleConcept.Hyperlink}>> against invading forces and the inquisitive agents of the Archons."

msgid "DLC@SECRETSOFTHEARCHMAGES@MINORFACTIONS_WORLD@RACE01@NAME"
msgstr "Scholars of Warding"

msgid "DLC@SECRETSOFTHEARCHMAGES@MINORFACTIONS_WORLD@RACE02@BIO"
msgstr "Placeholder"

msgid "DLC@SECRETSOFTHEARCHMAGES@MINORFACTIONS_WORLD@RACE02@NAME"
msgstr "Guardian Owls"

msgid "DLC@SECRETSOFTHEARCHMAGES@MINORFACTIONS_WORLD@RACE03@BIO"
msgstr "The disciples of the {GLOBAL.HorwyndLoreConcept.Hyperlink} School of Vitalizing were primarily conservators and breeders of flora and fauna. Once the <<m:{GLOBAL.ShroudedIsleConcept.Hyperlink}>> were shaped, the Scholars of Vitalizing applied their knowledge of growth and life to create regenerating habitats, where the [hyperlink,GLOBAL.GodirLoreConcept]Godir's[/hyperlink] sanctuaries remain untouched by the oppression of the {GLOBAL.ArchonsLoreConcept.Hyperlink}."

msgid "DLC@SECRETSOFTHEARCHMAGES@MINORFACTIONS_WORLD@RACE03@NAME"
msgstr "Scholars of Vitalizing"

msgid "DLC@SECRETSOFTHEARCHMAGES@MINORFACTIONS_WORLD@RACE04@BIO"
msgstr "The disciples of the {GLOBAL.HorwyndLoreConcept.Hyperlink} School of Shrouding were conservators and archivists of secret knowledge found in the {GLOBAL.WorldsWithinLoreConcept.Hyperlink}. When the development of experimental spells was repressed by the {GLOBAL.ArchonsLoreConcept.Hyperlink}, the guileful Scholars of Shrouding suggested securing them in the <<m:{GLOBAL.ShroudedIsleConcept.Hyperlink}>>, while also shrouding the Portals that lead to them."

msgid "DLC@SECRETSOFTHEARCHMAGES@MINORFACTIONS_WORLD@RACE04@NAME"
msgstr "Scholars of Shrouding"

msgid "DLC@SECRETSOFTHEARCHMAGES@MINORFACTIONS_WORLD@RACE05@BIO"
msgstr "Placeholder"

msgid "DLC@SECRETSOFTHEARCHMAGES@MINORFACTIONS_WORLD@RACE05@NAME"
msgstr "Guardian Owls"

msgid "DLC@SECRETSOFTHEARCHMAGES@MINORFACTIONS_WORLD@RACE06@BIO"
msgstr "The disciples of the {GLOBAL.HorwyndLoreConcept.Hyperlink} School of Artificing diligently collect and preserve magical artifacts and monuments. When the Scholars of Shrouding proposed to cache the [hyperlink,GLOBAL.GodirLoreConcept]Godir's[/hyperlink] secrets in the <<m:{GLOBAL.ShroudedIsleConcept.Hyperlink}>>, the Scholars of Artificing drew on their expertise in magical structures to construct the Portals that connect these hidden Realms to the {GLOBAL.WorldsWithinLoreConcept.Hyperlink}."

msgid "DLC@SECRETSOFTHEARCHMAGES@MINORFACTIONS_WORLD@RACE06@NAME"
msgstr "Scholars of Artificing"

