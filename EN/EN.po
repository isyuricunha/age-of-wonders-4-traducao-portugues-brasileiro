msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_04@DESCRIPTION"
msgstr "Deal damage to target unit and up to {BLIGHT_COIL_JUMP_TARGETER>MaxJumps} other enemies within {BLIGHT_COIL_JUMP_TARGETER>MaxDistance} hexes."

