msgid "DLC@ELDRITCHREALMS@STORY_REALM_02@REALM_TRAIT@BATTLE_FOR_ATHLA@DESCRIPTION"
msgstr "All <<m:{GLOBAL.UmbralDwellingConcept.Hyperlink}>> on this realm are following the commands of the Harbinger of Urrath:[bulletlist][bullet/]The Harbinger of Urrath has <<m:{GLOBAL.EldritchPactConcept.Hyperlink}>> with all <<m:{GLOBAL.UmbralDwellingConcept.Hyperlink}>>.[bullet/]Enemies of the Harbinger cannot reach peaceful relations with an {GLOBAL.UmbralDwellingConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@STORY_REALM_02@REALM_TRAIT@BATTLE_FOR_ATHLA@NAME"
msgstr "Harbinger's Hive"

msgid "DLC@ELDRITCHREALMS@STORY_REALM_02@REALM_TRAIT@URRATHS_GRASP@DESCRIPTION"
msgstr "The people on this realm have fallen under Urrath's influence:[bulletlist][bullet/]Racial marauder units have the {GLOBAL.SPECIAL_OPERATIONS.GLOOMSTRIDER_TRANSFORMATION.Hyperlink} and {GLOBAL.SPECIAL_OPERATIONS.UMBRAL_FLESH.Hyperlink} transformations.[bullet/]All <<m:{GLOBAL.IndependentCityConcept.Hyperlink}>> have the Initiates of the Umbral Abyss or Masters of Corruption trait.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@STORY_REALM_02@REALM_TRAIT@URRATHS_GRASP@NAME"
msgstr "Urrath's Grasp"

