msgid "DLC@ARCHONPROPHECY@META_EMPIRE@TRAIT_ARCHON_WARD@DESCRIPTION"
msgstr "A powerful spell woven by the Archons wards off death, preventing true death for Celestials.[bulletlist][bullet/]All non-Ruler {GLOBAL.PROPERTIES.CELESTIAL.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> gain {GLOBAL.PROPERTIES.IMMORTAL_ARCHON_WARD.Hyperlink}.[bullet/][hyperlink.RoutingConcept.HeroConcept]<<Routed>>[/hyperlink] {GLOBAL.PROPERTIES.CELESTIAL.Hyperlink} units are never lost.[/bulletlist]"

