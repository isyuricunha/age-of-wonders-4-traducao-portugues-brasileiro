msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@RAGING_VOLCANO@NAME_OVERRIDE_05"
msgstr "The Demonmaw"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@ROAR_DRAGONKIN@DESCRIPTION"
msgstr "All friendly {GLOBAL.PROPERTIES.DRAGON.Hyperlink} gain {GLOBAL.PROPERTIES.KILLING_MOMENTUM.Hyperlink} for {turns} {GLOBAL.TurnConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@ROAR_DRAGONKIN@NAME"
msgstr "Roar of the Ancient Dragonkin"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@SUBTERRANEAN_MONUMENTS@DESCRIPTION"
msgstr "<<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacent to this Landmark gain:[bulletlist][bullet/] A [quarry/] Quarry in this province grants {income}.[bullet/]A [mine/] Mine in this province grants {income2}.[/bulletlist][br/]A {GLOBAL.CityConcept.Hyperlink} with {amount} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacent to this Landmark gains:[bulletlist][bullet/]Gain {income3} {GLOBAL.BindingEssenceConcept.Hyperlink} and {income4} [bindingfragments/] [hyperlink,GLOBAL.BindingEssenceConcept]Fragments[/hyperlink] additional income.[/bulletlist]"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@SUBTERRANEAN_MONUMENTS@LORE"
msgstr "\"I see the fallen empire of {GLOBAL.MyrridaLoreConcept.Hyperlink} and my heart aches for what my kin have lost. Endless corridors and districts, sprawling through the Underground... How I grieve for Myrrida's Golden Age, its lost majesty carved into our history. But as a [hyperlink,GLOBAL.GiantKingLoreConcept]Giant King[/hyperlink] I must try and live up to its legacy...\"[br/][br/]— Fjalla Tor-Builder, In the Giant's Footsteps: As cited by Ham Binger"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@SUBTERRANEAN_MONUMENTS@NAME"
msgstr "Subterranean Monuments"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@SUBTERRANEAN_MONUMENTS@NAME_OVERRIDE_01"
msgstr "Deep Corridors"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@SUBTERRANEAN_MONUMENTS@NAME_OVERRIDE_02"
