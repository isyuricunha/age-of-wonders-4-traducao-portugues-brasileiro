msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_07@NAME"
msgstr "Primordial Envy"

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_07@PROP_DESCRIPTION"
msgstr "This unit's attacks have a {BOON_STEALING_RESISTANCE_CHECK>ResolvedStrength}% chance of stealing one {GLOBAL.PositiveStatusEffectConcept.Hyperlink}.[br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_08@NAME"
msgstr "Pyrescale Blast"

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_09@DESCRIPTION"
msgstr "Consume all {GLOBAL.PROPERTIES.BURNING.Hyperlink} stacks from target enemy unit.[bulletlist][bullet/]For each stack consumed, the enemy sustains {REJUVENATING_FLAMES_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Friendly units in a 2-hex radius of the target:[bulletlist][bullet/]Heal {REJUVENATING_FLAMES_FRIENDLY_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Gain a stack of {GLOBAL.PROPERTIES.REGENERATION.Hyperlink} for {REGENERATION_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][/bulletlist]"

