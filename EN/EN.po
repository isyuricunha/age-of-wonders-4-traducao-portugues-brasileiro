msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_7@DESCRIPTION"
msgstr "A {GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink} with a strong charge attack and the ability to create a chain of lightning that can trigger {GLOBAL.PROPERTIES.VOLATILE_CHARGE.Hyperlink}. Draftable in cities."

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_7@NAME"
msgstr "Lithorine Simulacrum"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_8@DESCRIPTION"
msgstr "A {GLOBAL.PROPERTIES.SUPPORT_UNIT.Hyperlink} that can link to units and take their damage for them. Draftable in cities."

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_8@NAME"
msgstr "Lithorine Core"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_9@DESCRIPTION"
msgstr "A {GLOBAL.PROPERTIES.RANGED_UNIT.Hyperlink} with a ranged attack that applies {GLOBAL.PROPERTIES.VOLATILE_CHARGE.Hyperlink}. Draftable in cities."

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_9@NAME"
msgstr "Lithorine Needler"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@TOME@DESCRIPTION"
msgstr "These boons can be purchased from a {GLOBAL.CrystalDwellingConcept.Hyperlink} by reaching a Crystal or Eternal pact with them. They will give you access to Lithorine units and the power of the Eternals."

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@TOME@NAME"
