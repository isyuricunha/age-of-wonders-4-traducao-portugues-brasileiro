msgstr "Astral Root Node"

msgid "NODES_STRATEGIC@CHAOS_ROOT_NODE@DESCRIPTION"
msgstr "This Root Node has been converted to the {GLOBAL.ChaosConcept.Hyperlink} and is overflowing with power. It will contribute to Magic Victory."

msgid "NODES_STRATEGIC@CHAOS_ROOT_NODE@NAME"
msgstr "Chaos Root Node"

msgid "NODES_STRATEGIC@FISH@DESCRIPTION"
msgstr "A plentiful source of fish."

msgid "NODES_STRATEGIC@FISH@NAME"
msgstr "Fishing Ground"

msgid "NODES_STRATEGIC@GOLD_VEIN@DESCRIPTION"
msgstr "A large vein of valuable gold."

msgid "NODES_STRATEGIC@GOLD_VEIN@NAME"
msgstr "Gold Vein"

msgid "NODES_STRATEGIC@IRON_DEPOSIT@DESCRIPTION"
msgstr "A rich vein full of iron."

msgid "NODES_STRATEGIC@IRON_DEPOSIT@NAME"
msgstr "Iron Deposit"

msgid "NODES_STRATEGIC@MANA_NODE@DESCRIPTION"
msgstr "Magical currents converge at this location."

msgid "NODES_STRATEGIC@MANA_NODE@NAME"
msgstr "Mana Node"

msgid "NODES_STRATEGIC@MATERIUM_ROOT_NODE@DESCRIPTION"
msgstr "This Root Node has been converted to the {GLOBAL.MateriumConcept.Hyperlink} and is overflowing with power. It will contribute to Magic Victory."

msgid "NODES_STRATEGIC@MATERIUM_ROOT_NODE@NAME"
msgstr "Materium Root Node"

msgid "NODES_STRATEGIC@NATURE_ROOT_NODE@DESCRIPTION"
msgstr "This Root Node has been converted to the {GLOBAL.NatureConcept.Hyperlink} and is overflowing with power. It will contribute to Magic Victory."

msgid "NODES_STRATEGIC@NATURE_ROOT_NODE@NAME"
msgstr "Nature Root Node"

msgid "NODES_STRATEGIC@NODE@INCOME"
msgstr "{income}"

msgid "NODES_STRATEGIC@NODES@RUINED_ARCANIUMORE_NODE@NAME"
msgstr "Ruined Arcanium Ore^ns"

msgid "NODES_STRATEGIC@NODES@RUINED_ARCHONBLOOD_NODE@NAME"
msgstr "Ruined Archon Blood^ns"

msgid "NODES_STRATEGIC@NODES@RUINED_ASTRALDEW_NODE@NAME"
msgstr "Ruined Astral Dew^ns"

msgid "NODES_STRATEGIC@NODES@RUINED_FIREFORGESTONE_NODE@NAME"
msgstr "Ruined Fireforge Stone^ns"

msgid "NODES_STRATEGIC@NODES@RUINED_FISH_NODE@NAME"
msgstr "Ruined Fishing Grounds"

msgid "NODES_STRATEGIC@NODES@RUINED_FOCUSCRYSTALS_NODE@NAME"
msgstr "Ruined Focus Crystals^ns"

msgid "NODES_STRATEGIC@NODES@RUINED_FOOD_NODE@NAME"
msgstr "Ruined Pastures"

msgid "NODES_STRATEGIC@NODES@RUINED_GOLD_NODE@NAME"
msgstr "Ruined Gold Vein"

msgid "NODES_STRATEGIC@NODES@RUINED_HASTE_BERRIES_NODE@NAME"
msgstr "Ruined Haste Berries^ns"

msgid "NODES_STRATEGIC@NODES@RUINED_MANA_NODE@NAME"
msgstr "Ruined Mana Node"

msgid "NODES_STRATEGIC@NODES@RUINED_NODE@DESCRIPTION"
msgstr "This {GLOBAL.NodeConcept.Hyperlink} is ruined and provides no income or bonuses. It can be restored at a cost which will make it provide its income and bonuses again."

msgid "NODES_STRATEGIC@NODES@RUINED_OASIS_NODE@NAME"
msgstr "Ruined Oasis"

msgid "NODES_STRATEGIC@NODES@RUINED_PEARL_NODE@NAME"
msgstr "Ruined Pearl Reef"

msgid "NODES_STRATEGIC@NODES@RUINED_PRODUTION_NODE@NAME"
msgstr "Ruined Iron Deposit"

msgid "NODES_STRATEGIC@NODES@RUINED_RAINBOWCLOVER_NODE@NAME"
msgstr "Ruined Rainbow Clover^ns"

msgid "NODES_STRATEGIC@NODES@RUINED_SILVERTONGUEFRUIT_NODE@NAME"
msgstr "Ruined Silvertongue Fruit^ns"

msgid "NODES_STRATEGIC@NODES@RUINED_TRANQUILITYPOOL_NODE@NAME"
msgstr "Ruined Tranquility Pool^ns"

msgid "NODES_STRATEGIC@OASIS@DESCRIPTION"
msgstr "A lush oasis full of nutritious food."

msgid "NODES_STRATEGIC@OASIS@NAME"
msgstr "Oasis"

msgid "NODES_STRATEGIC@ORDER_ROOT_NODE@DESCRIPTION"
msgstr "This Root Node has been converted to the {GLOBAL.OrderConcept.Hyperlink} and is overflowing with power. It will contribute to Magic Victory."

msgid "NODES_STRATEGIC@ORDER_ROOT_NODE@NAME"
msgstr "Order Root Node"

msgid "NODES_STRATEGIC@OYSTER@DESCRIPTION"
msgstr "A bloom of valuable pearls."

msgid "NODES_STRATEGIC@OYSTER@NAME"
msgstr "Pearl Reef"

msgid "NODES_STRATEGIC@PASTURES@DESCRIPTION"
msgstr "Roaming herds on lush fields."

msgid "NODES_STRATEGIC@PASTURES@NAME"
msgstr "Pastures"

msgid "NODES_STRATEGIC@ROOT_NODE@DESCRIPTION"
msgstr "A Root Node is a {GLOBAL.LocationConcept.Hyperlink} where the magical flows of the realm converge into a single source of power. [br/][br/]Root Nodes can be converted to an {GLOBAL.AffinityConcept.Hyperlink} through a {GLOBAL.WorldSpellConcept.Hyperlink}. Converted Root Nodes give additional resources and contribute to the Magic Victory. {LOC.AFFINITYCONTENT@NODE_CONVERSION@CASUSBELLIWARNING}"

msgid "NODES_STRATEGIC@ROOT_NODE@LORE"
msgstr "As a Godir's might grows, they begin to gain an almost innate understanding and attunement to places of powerful resonance. Root Nodes are physically manifest confluences of ambient magic present throughout the land. The mightiest of Godir can sense these locations and even manipulate and alter the latent magics therein to reflect their own affinities."

msgid "NODES_STRATEGIC@ROOT_NODE@NAME"
msgstr "Root Node"

msgid "NODES_STRATEGIC@RUINED_NODE_SETTINGS@RUINED_NODE_RESTORATION_OPERATION@DESCRIPTION"
msgstr "Requires this location to be within your {GLOBAL.DomainConcept.Hyperlink} or occupied by one of your <<m:{GLOBAL.UnitConcept.Hyperlink}>>. Replaces this ruined node with a {NodeName}, providing income and bonuses again.[br/][br/]The cost of this action decreases per {GLOBAL.TurnConcept.Hyperlink} till it reaches a minimum cost."

msgid "NODES_STRATEGIC@RUINED_NODE_SETTINGS@RUINED_NODE_RESTORATION_OPERATION@NAME"
msgstr "Restore Node"

msgid "NODES_STRATEGIC@SHADOW_ROOT_NODE@DESCRIPTION"
msgstr "This Root Node has been converted to the {GLOBAL.ShadowConcept.Hyperlink} and is overflowing with power. It will contribute to Magic Victory."

msgid "NODES_STRATEGIC@SHADOW_ROOT_NODE@NAME"
msgstr "Shadow Root Node"

msgid "ONBOARDING_OBJECTIVES@ANNEX_EXPLORATION_SITE@DESCRIPTION"
msgstr "Now that you have claimed this {GLOBAL.AncientWonderConcept.Hyperlink}, you can add it to your domain by annexing it to a City. If you have no city nearby, you can found an {GLOBAL.OutpostConcept.Hyperlink} in an adjacent sector and annex it with that."

msgid "ONBOARDING_OBJECTIVES@ANNEX_EXPLORATION_SITE@FINISHER@DESCRIPTION"
msgstr "You have annexed an {GLOBAL.AncientWonderConcept.Hyperlink} which will now provide you with a powerful yield in one of your <<m:{GLOBAL.CityConcept.Hyperlink}>>."

msgid "ONBOARDING_OBJECTIVES@ANNEX_EXPLORATION_SITE@INSTRUCTION"
msgstr "Ancient Wonders provide unique units to the {GLOBAL.RequestMilitaryAidConcept.Hyperlink} as well as large amounts of resource income, including valuable {GLOBAL.ImperiumConcept.Hyperlink}, when they are added to your empire."

msgid "ONBOARDING_OBJECTIVES@ANNEX_EXPLORATION_SITE@NAME"
msgstr "Ancient Wonder Annexation"

msgid "ONBOARDING_OBJECTIVES@ANNEX_EXPLORATION_SITE@OBJECTIVE"
msgstr "Ancient Wonder Annexed"

msgid "ONBOARDING_OBJECTIVES@ANNEX_WATER@DESCRIPTION"
msgstr "The domain of one of your cities has expanded to a coastline. Provinces in the water can be annexed like any other province, and the first Province Improvement built in the water will automatically become that city's harbor. The harbor of a city is the location where any new ships that are built in that city will appear. Expanding your city onto the water will unlock further city structures."

msgid "ONBOARDING_OBJECTIVES@ANNEX_WATER@NAME"
msgstr "Rule the Seas"

msgid "ONBOARDING_OBJECTIVES@ANNEX_WATER@OBJECTIVE"
msgstr "Water Province Annexed"

msgid "ONBOARDING_OBJECTIVES@DIPLOMACY_FIRST_CITY@DESCRIPTION"
msgstr "You have found a friendly free city! Now that you have established contact, you may provide them with a {GLOBAL.DiplomaticTokenConcept.Hyperlink}. This artifact will sway their relation with you over time, until they are ready to become your vassal."

msgid "ONBOARDING_OBJECTIVES@DIPLOMACY_FIRST_CITY@NAME"
msgstr "Negotiating with Free Cities"

msgid "ONBOARDING_OBJECTIVES@DIPLOMACY_FIRST_CITY@OBJECTIVE"
msgstr "Whispering Stone Assigned"

msgid "ONBOARDING_OBJECTIVES@DIPLOMACY_FIRST_CITY_NO_WHISPERINGSTONE@DESCRIPTION"
msgstr "You have found a friendly {GLOBAL.IndependentCityConcept.Hyperlink}! Now that you have established contact, you may investigate them and decide how to negotiate."

msgid "ONBOARDING_OBJECTIVES@DIPLOMACY_FIRST_CITY_NO_WHISPERINGSTONE@INSTRUCTION"
msgstr "If you have a {GLOBAL.DiplomaticTokenConcept.Hyperlink}, you can give one to them. Otherwise, your culture may provide you with other ways to gain {GLOBAL.HouseInfluenceConcept.Hyperlink} over them.[br/][br/]Once enough {GLOBAL.HouseInfluenceConcept.Hyperlink} is gained, the Free City will become your {GLOBAL.PvEVassalConcept.Hyperlink}, and they can be [hyperlink,GLOBAL.PactOfIntegrationConcept]integrated[/hyperlink]. This will turn them into a fully functional city under your direct control. [br/][br/]Be mindful of your {GLOBAL.CityCapConcept.Hyperlink} to evaluate whether you want to integrate a free city or keep them as a vassal!"

msgid "ONBOARDING_OBJECTIVES@DIPLOMACY_FIRST_CITY_NO_WHISPERINGSTONE@OBJECTIVE"
msgstr "Free City Investigated"

msgid "ONBOARDING_OBJECTIVES@EXPAND_ARMY@DESCRIPTION"
msgstr "Now that you have a second scout, you will need more powerful armies to claim the valuable locations you may come across in the realm. You can gain access to new kinds of units through research and upgrading your cities. [br/]Bear in mind, Scouts are not meant for combat, so build your {GLOBAL.ArmyConcept.Hyperlink} wisely."

msgid "ONBOARDING_OBJECTIVES@EXPAND_ARMY@FINISHER@DESCRIPTION"
msgstr "Now that you have a sufficient army, you are ready to expand and conquer. Armies are expensive, so put them to good use. Send them out with a {GLOBAL.HeroConcept.Hyperlink} to gain {GLOBAL.ExperienceConcept.Hyperlink} and discover new <<m:{GLOBAL.NodeConcept.Hyperlink}>> or potential {GLOBAL.CityConcept.Hyperlink} locations."

msgid "ONBOARDING_OBJECTIVES@EXPAND_ARMY@FINISHER@DESCRIPTION_2"
msgstr "Don't forget to build more units. As your empire grows, you will need more armies and it's a good idea to start building them early!"

msgid "ONBOARDING_OBJECTIVES@EXPAND_ARMY@NAME"
msgstr "Making a Full Army"

msgid "ONBOARDING_OBJECTIVES@EXPAND_ARMY@OBJECTIVE"
msgstr "Army of Six Units Made"

msgid "ONBOARDING_OBJECTIVES@EXPLORATION@DESCRIPTION"
msgstr "You are about to begin exploring your surroundings. While the wide world holds plenty of things to find, two of the most valuable places you can come across are <<m:{GLOBAL.IndependentCityConcept.Hyperlink}>> and <<m:{GLOBAL.AncientWonderConcept.Hyperlink}>>. "

msgid "ONBOARDING_OBJECTIVES@EXPLORATION@NAME"
msgstr "Exploration"

msgid "ONBOARDING_OBJECTIVES@EXPLORE_EXPLORATION_SITE@DESCRIPTION"
msgstr "You have discovered an {GLOBAL.AncientWonderConcept.Hyperlink}! It now needs to be explored before it can be claimed. Only armies led by a {GLOBAL.HeroConcept.Hyperlink} can explore Ancient Wonders. While exploring, you can encounter obstacles which can be overcome in various ways, though they can always be cleared through {GLOBAL.CombatConcept.Hyperlink}."

msgid "ONBOARDING_OBJECTIVES@EXPLORE_EXPLORATION_SITE@NAME"
msgstr "Ancient Wonder Exploration"

msgid "ONBOARDING_OBJECTIVES@EXPLORE_EXPLORATION_SITE@OBJECTIVE"
msgstr "Ancient Wonder Explored"

msgid "ONBOARDING_OBJECTIVES@FIND_EXPLORATION_SITE@DESCRIPTION"
msgstr "Ancient Wonders are some of the most valuable locations that can be found in a realm. There are three different tiers of Ancient Wonders; bronze, silver and gold. The higher the tier of an Ancient Wonder, the more challenging it will be to claim for your own."

msgid "ONBOARDING_OBJECTIVES@FIND_EXPLORATION_SITE@NAME"
msgstr "The Ancient Wonders"

msgid "ONBOARDING_OBJECTIVES@FIND_EXPLORATION_SITE@OBJECTIVE"
msgstr "Ancient Wonder Discovered"

msgid "ONBOARDING_OBJECTIVES@FOOD_CITY@DESCRIPTION"
msgstr "In order for your cities to grow large and prosperous, it is key that they have enough food income for healthy population growth. To expand on a city's food income, you can build farms in surrounding provinces and build city structures that provide food income."

msgid "ONBOARDING_OBJECTIVES@FOOD_CITY@NAME"
msgstr "A Healthy City"

msgid "ONBOARDING_OBJECTIVES@FOOD_CITY@OBJECTIVE"
msgstr "Improve your Food Income"

msgid "ONBOARDING_OBJECTIVES@FOUND_CITY@DESCRIPTION"
msgstr "Your new Outpost is finished! You can turn it into another city by spending {GLOBAL.ImperiumConcept.Hyperlink}.[br/][br/]Cities develop over time and are the main source of income for your empire.[br/][br/]Be mindful of your {GLOBAL.CityCapConcept.Hyperlink} however, as going over this cap will reduce the income of all your cities."

msgid "ONBOARDING_OBJECTIVES@FOUND_CITY@FINISHER@DESCRIPTION"
msgstr "Congratulations, O {PlayerLeader.Title}! Your new city is finished and can start growing. Be aware that {GLOBAL.FoodConcept.Hyperlink}, {GLOBAL.StructureProductionConcept.Hyperlink}, and {GLOBAL.UnitProductionConcept.Hyperlink} are not shared across cities, so each city is responsible for its own growth and construction."

msgid "ONBOARDING_OBJECTIVES@FOUND_CITY@FINISHER@INSTRUCTION"
msgstr "If you already have a second {GLOBAL.HeroConcept.Hyperlink}, you can assign this hero to be your city's new {GLOBAL.GovernorConcept.Hyperlink}, granting it extra bonuses."

msgid "ONBOARDING_OBJECTIVES@FOUND_CITY@FINISHER@SUMMARY"
msgstr "Tutorial about your new city"

msgid "ONBOARDING_OBJECTIVES@FOUND_CITY@NAME"
msgstr "A New City"

msgid "ONBOARDING_OBJECTIVES@FOUND_CITY@OBJECTIVE"
msgstr "City Founded"

msgid "ONBOARDING_OBJECTIVES@FOUND_CITY@SUMMARY"
msgstr "Tutorial about founding cities from outposts"

msgid "ONBOARDING_OBJECTIVES@INFESTATION@DESCRIPTION"
msgstr "Infestations are dangerous locations which will continue to send armies your way, burning and pillaging your realm... unless you strike first, of course."

msgid "ONBOARDING_OBJECTIVES@INFESTATION@NAME"
msgstr "The First Infestation"

msgid "ONBOARDING_OBJECTIVES@INFESTATION@OBJECTIVE"
msgstr "Infestation Destroyed"

msgid "ONBOARDING_OBJECTIVES@INTEGRATE_FREE_CITY@DESCRIPTION"
msgstr "You have established your first contact! Once enough {GLOBAL.HouseInfluenceConcept.Hyperlink} is gained with a {GLOBAL.IndependentCityConcept.Hyperlink} and they have become your {GLOBAL.PvEVassalConcept.Hyperlink}, they can be integrated. [br/][br/] Integrating a free city will turn them into a fully functional city under your direct control. Be mindful of your {GLOBAL.CityCapConcept.Hyperlink} to evaluate whether you want to integrate a free city or keep them as a vassal!"

msgid "ONBOARDING_OBJECTIVES@INTEGRATE_FREE_CITY@FINISHER@DESCRIPTION"
msgstr "A {GLOBAL.IndependentCityConcept.Hyperlink} has successfully been integrated into your {GLOBAL.EmpireConcept.Hyperlink}, granting you complete control over its resources and production.[br/][br/]If the city is of a different race to your own, you will be able to build that race's units. You can also migrate the city to your own race in the [cityinformation/] City Information screen. This is an [evilact/] Evil act, however."

msgid "ONBOARDING_OBJECTIVES@INTEGRATE_FREE_CITY@NAME"
msgstr "Vassal Integration"

msgid "ONBOARDING_OBJECTIVES@INTEGRATE_FREE_CITY@OBJECTIVE"
msgstr "Free City Integrated"

msgid "ONBOARDING_OBJECTIVES@INTEGRATE_FREE_CITY_NO_WHISPERINGSTONE@DESCRIPTION"
msgstr "Once enough {GLOBAL.HouseInfluenceConcept.Hyperlink} is gained with a {GLOBAL.IndependentCityConcept.Hyperlink} and they have become your {GLOBAL.PvEVassalConcept.Hyperlink}, they can be [hyperlink,GLOBAL.PactOfIntegrationConcept]integrated[/hyperlink]. [br/][br/] Integrating a free city will turn them into a fully functional city under your direct control. Be mindful of your {GLOBAL.CityCapConcept.Hyperlink} to evaluate whether you want to integrate a free city or keep them as a vassal!"

msgid "ONBOARDING_OBJECTIVES@LEVEL_HERO@DESCRIPTION"
msgstr "Heroes are powerful units just like your Ruler. An army can contain multiple heroes, but be mindful that support hero skills which affect the whole army will only be given to the units of that army by the hero that is the army leader. The highest level of hero will always be the army leader."

msgid "ONBOARDING_OBJECTIVES@LEVEL_HERO@NAME"
msgstr "Worthy Hero"

msgid "ONBOARDING_OBJECTIVES@LEVEL_HERO@OBJECTIVE"
msgstr "Reach Level 5 with a Hero"

msgid "ONBOARDING_OBJECTIVES@LEVEL_RULER@DESCRIPTION"
msgstr "Once your Ruler gains enough experience, they will level up. Each time they level up, you may pick a single hero skill in either Warfare, Battle Magic or Support. Every five levels your hero may choose a signature hero skill. These are powerful abilities unique to heroes that can turn the tide in combat and will permanently alter the affinity of that hero."

msgid "ONBOARDING_OBJECTIVES@LEVEL_RULER@NAME"
msgstr "Lead by Example"

msgid "ONBOARDING_OBJECTIVES@LEVEL_RULER@OBJECTIVE"
msgstr "Reach Level 5 with a Ruler"

msgid "ONBOARDING_OBJECTIVES@MEET_FREE_CITY@DESCRIPTION"
msgstr "Not all <<m:{GLOBAL.CityConcept.Hyperlink}>> you may come across will belong to your opponents. <<m:{GLOBAL.IndependentCityConcept.Hyperlink}>> are small neutral factions that can be vassalized, integrated, or conquered. Speed is of the essence, as once a {GLOBAL.IndependentCityConcept.Hyperlink} swears an {GLOBAL.HouseInfluenceConcept.Hyperlink}, it becomes impossible to convince them to join you instead. A vassalized city will provide units for your {GLOBAL.RequestMilitaryAidConcept.Hyperlink}."

msgid "ONBOARDING_OBJECTIVES@MEET_FREE_CITY@NAME"
msgstr "The First Free City"

msgid "ONBOARDING_OBJECTIVES@MEET_FREE_CITY@OBJECTIVE"
msgstr "Discover a Friendly Free City"

msgid "ONBOARDING_OBJECTIVES@MULTI_SELECT@DESCRIPTION"
msgstr "You can select multiple armies at once, allowing you to move them in groups."

msgid "ONBOARDING_OBJECTIVES@MULTI_SELECT@INSTRUCTIONS"
msgstr "[bulletlist][bullet/]Select an army you own.[bullet/]Use SHIFT+[leftMouseButton/] to select another army you own.[bullet/]Use [rightMouseButton/] to move the first army.[bullet/]The second army will move to get as close as it can to the first.[/bulletlist][br/]You can select up to {amount} armies in this way."

msgid "ONBOARDING_OBJECTIVES@MULTI_SELECT@INSTRUCTIONS_CONTROLLER"
msgstr "[bulletlist][bullet/]Select an army you own.[bullet/]Use [ci_rightstickpress/] to select another army you own.[bullet/]When you move the first army, the second army will move to get as close as it can to the first.[/bulletlist][br/]You can select up to {amount} armies in this way."

msgid "ONBOARDING_OBJECTIVES@MULTI_SELECT@SUMMARY"
msgstr "Tutorial on moving multiple armies at once."

msgid "ONBOARDING_OBJECTIVES@MULTI_SELECT@TITLE"
msgstr "Selecting Multiple Armies"

msgid "ONBOARDING_OBJECTIVES@OUTPOST@DESCRIPTION"
msgstr "You have managed to defeat your first infestation! Infestations are often found near <<m:{GLOBAL.NodeConcept.Hyperlink}>>, so they are good places to put <<m:{GLOBAL.OutpostConcept.Hyperlink}>>."

msgid "ONBOARDING_OBJECTIVES@OUTPOST@DESCRIPTION_2"
msgstr "Once built, your Outpost can be upgraded into a new {GLOBAL.CityConcept.Hyperlink} by spending {GLOBAL.ImperiumConcept.Hyperlink}."

msgid "ONBOARDING_OBJECTIVES@OUTPOST@INSTRUCTION"
msgstr "Outposts can be used to {GLOBAL.ClaimConcept.Hyperlink} nearby provinces, and can collect resources from Resource Nodes in their domain.[br/][br/]You need a {GLOBAL.HeroConcept.Hyperlink} to construct an Outpost in a province."

msgid "ONBOARDING_OBJECTIVES@OUTPOST@INSTRUCTION_2"
msgstr "Cities can also make use of {GLOBAL.FoodConcept.Hyperlink}, {GLOBAL.StructureProductionConcept.Hyperlink}, and {GLOBAL.UnitProductionConcept.Hyperlink}, unlike Outposts which can only collect {GLOBAL.GoldConcept.Hyperlink}, {GLOBAL.ManaConcept.Hyperlink} and {GLOBAL.KnowledgeConcept.Hyperlink}."

msgid "ONBOARDING_OBJECTIVES@OUTPOST@NAME"
msgstr "Expansion through Outposts"

msgid "ONBOARDING_OBJECTIVES@OUTPOST@OBJECTIVE"
msgstr "Outpost Built"

msgid "ONBOARDING_OBJECTIVES@RESEARCH@DESCRIPTION"
msgstr "The arcane research of your empire is struggling. If we wish to unlock more tomes of power and the spells they contain, we should invest in building structures in our cities that yield knowledge income."

msgid "ONBOARDING_OBJECTIVES@RESEARCH@NAME"
msgstr "More Knowledge Required"

msgid "ONBOARDING_OBJECTIVES@RESEARCH@OBJECTIVE"
msgstr "Research Structure Built"

msgid "ONBOARDING_OBJECTIVES@SCOUTING@DESCRIPTION"
msgstr "As is often the case, knowledge is power. To gather information on your surroundings, scouts are of utmost importance due to their speed and vision range. Without them your rivals might find and claim valuable locations before you do!"

msgid "ONBOARDING_OBJECTIVES@SCOUTING@NAME"
msgstr "Preparing to Scout"

msgid "ONBOARDING_OBJECTIVES@SCOUTING@OBJECTIVE"
msgstr "[unitScout/] {GLOBAL.PROPERTIES.SCOUT_UNIT} Recruited"

msgid "ONBOARDING_OBJECTIVES@SKIP_SHOW_OF_FORCE@DESCRIPTION"
msgstr "Now that you have a second scout and a sufficient army, you are ready to expand and conquer. Armies are expensive, so put them to good use. Send them out with a {GLOBAL.HeroConcept.Hyperlink} to gain {GLOBAL.ExperienceConcept.Hyperlink} and discover new <<m:{GLOBAL.NodeConcept.Hyperlink}>> or potential {GLOBAL.CityConcept.Hyperlink} locations."

msgid "ONBOARDING_OBJECTIVES@SKIP_SHOW_OF_FORCE@NAME"
msgstr "Expand and Conquer"

msgid "ONBOARDING_OBJECTIVES@TO_BATTLE@DESCRIPTION"
msgstr "Your armies need purpose to pay for their upkeep. The common usage for armies during peace times is clearing of Marauder Guards and Infestations around your Empire."

msgid "ONBOARDING_OBJECTIVES@TO_BATTLE@TITLE"
msgstr "To Battle"

msgid "ONBOARDING_OBJECTIVES@TRANSFORM_RACE@DESCRIPTION"
msgstr "One of your tomes of magic contains a powerful new spell capable of transforming your people. These spells will add powerful bonuses to your people as well as alter how they look. There are both minor and major transformations. A race can have multiple minor transformations, though some cannot be combined with others. A race can only ever have one major transformation."

msgid "ONBOARDING_OBJECTIVES@TRANSFORM_RACE@NAME"
msgstr "Transformative"

msgid "ONBOARDING_OBJECTIVES@TRANSFORM_RACE@OBJECTIVE"
msgstr "Transform your Race"

msgid "ONBOARDING_OBJECTIVES@VASSAL_FREE_CITY@DESCRIPTION"
msgstr "The speed of turning a free city into your vassal can be boosted by spending Imperium. This can be useful should another empire compete with you in gaining their allegiance. Be aware, if a free city is vassalized, they will return all Whispering Stones assigned to them, other than those of their overlord."

msgid "ONBOARDING_OBJECTIVES@VASSAL_FREE_CITY@NAME"
msgstr "Free City Vassalization"

msgid "ONBOARDING_OBJECTIVES@VASSAL_FREE_CITY@OBJECTIVE"
msgstr "Vassalize a Free City"

msgid "ONBOARDING_OBJECTIVES@VICTORY@DESCRIPTION"
msgstr "There are many paths to victory in this realm, but they all need the right strategy. You can [expansionvictory/] [hyperlink,GLOBAL.ExpansionVictoryConcept]expand[/hyperlink] your empire far and wide to become the dominant power within the realm, use [magicvictory/] [hyperlink,GLOBAL.MagicVictoryConcept]magic[/hyperlink] to bend the very land to your will, or use [conquestvictory/] [hyperlink,GLOBAL.DefaultVictoryConcept]force[/hyperlink] and military prowess to crush all those who stand in your way.[br/][br/]Evaluate your progress to victory by tracking a victory condition through the [scorevictory/] quest panel on the top-left."

msgid "ONBOARDING_OBJECTIVES@VICTORY@FINISHER@DESCRIPTION"
msgstr "Great choice, {PlayerLeader.Title}! You have chosen a victory condition which will guide you towards success! [br/] You can always change strategies when necessary."

msgid "ONBOARDING_OBJECTIVES@VICTORY@NAME"
msgstr "Path to Victory"

msgid "ONBOARDING_OBJECTIVES@VICTORY@OBJECTIVE"
msgstr "Victory Condition Tracked"

msgid "ONBOARDING_OBJECTIVES@WIZARD_TOWER@DESCRIPTION"
msgstr "Your {GLOBAL.ThroneCityConcept.Hyperlink} has grown large enough for you to construct a {GLOBAL.WizardTowerConcept}. This beacon of your power provides many bonuses, including valuable {GLOBAL.ImperiumConcept.Hyperlink}."

msgid "ONBOARDING_OBJECTIVES@WIZARD_TOWER@FINISHER@DESCRIPTION"
msgstr "You have finished constructing the first floor of your {GLOBAL.WizardTowerConcept.Hyperlink}. You can now build your first set of rooms and improvements!"

msgid "ONBOARDING_OBJECTIVES@WIZARD_TOWER@FINISHER@INSTRUCTIONS"
msgstr "Of particular interest:[bulletlist][bullet/]The {GLOBAL.STRUCTURE_UPGRADES.WIZARD_TOWER_LEVEL_I.Hyperlink} lets you cast more powerful <<m:{GLOBAL.StrategicSummonSpellConcept.Hyperlink}>>.[bullet/]The {GLOBAL.ItemForgeConcept.Hyperlink} lets you craft equipment for your heroes.[/bulletlist]"

msgid "ONBOARDING_OBJECTIVES@WIZARD_TOWER@FINISHER@NAME"
msgstr "Wizard's Tower Complete"

msgid "ONBOARDING_OBJECTIVES@WIZARD_TOWER@FINISHER@SUMMARY"
msgstr "Tutorial about your completed Wizard's tower"

msgid "ONBOARDING_OBJECTIVES@WIZARD_TOWER@NAME"
msgstr "The Wizard Tower"

msgid "ONBOARDING_OBJECTIVES@WIZARD_TOWER@OBJECTIVE"
msgstr "Wizard Tower Built"

msgid "ONBOARDING_OBJECTIVES@WIZARD_TOWER@SUMMARY"
msgstr "Tutorial about building a Wizard's Tower"

msgid "OPERATIONDEFINITIONS_STRATEGIC@ACCELERATE_OVERHARVEST_OPERATION@DESCRIPTION"
msgstr "Halves the remaining time to Harvest nodes in this province, cost depends on time remaining."

msgid "OPERATIONDEFINITIONS_STRATEGIC@ACCELERATE_OVERHARVEST_OPERATION@MAX_REDUCTION_DESCRIPTION"
msgstr "Blocked: Cannot be reduced further"

