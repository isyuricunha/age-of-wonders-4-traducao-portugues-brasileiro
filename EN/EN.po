msgstr "Ammunition"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@HERO_SKILL1@DESCRIPTION"
msgstr "Hero gains the {GLOBAL.PROPERTIES.ARTILLERY_BARRAGE.Hyperlink} ability."

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@HERO_SKILL1@NAME"
msgstr "Artillerist"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@HERO_SKILL@DESCRIPTION"
msgstr "Target a {ARTILLERY_BARRAGE_CIRCLE_TARGETER_MARKED>AREA>Radius}-hex radius.[bulletlist][bullet/]Inflicts {GLOBAL.PROPERTIES.MARKED.Hyperlink}.[bullet/]At the start of next turn, inflict {amount} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@HERO_SKILL@NAME"
msgstr "Artillery Barrage"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@MODIFIER_AMMO_2@TARGETER_DESCRIPTION"
