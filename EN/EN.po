msgid "DLC@GIANTKINGS@RELIC@MENHIR_OF_FIRE@LORE"
msgstr "\"Baleful the fire that shook Titan's Henge[br/]Flaring the light of Archon revenge[br/]Gaping the maws of the Lindworm's swarm\""

msgid "DLC@GIANTKINGS@RELIC@MENHIR_OF_FIRE@NAME"
msgstr "Menhir of Fire^n"

msgid "DLC@GIANTKINGS@RELIC@MENHIR_OF_FIRE@UNIT_PROP@DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]+{RELIC_UNIT_EXTRA_DMG>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} on base attacks, [hyperlink,GLOBAL.EnchantingNonRepeatingConcept]increased[/hyperlink] for Single Shot attacks.[bullet/]+{RELIC_UNIT_EXTRA_RESISTANCE>DEF_MOD>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}[bullet/]+{RELIC_UNIT_EXTRA_RESISTANCE>REDUCTION>Fire} {GLOBAL.FireResistanceConcept.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.VENGEFUL_FLAMES.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.STATUS_EFFECT_IMMUNITY_BURNING.Hyperlink}[/bulletlist]"

msgid "DLC@GIANTKINGS@RELIC@MENHIR_OF_FIRE@UNIT_PROP@NAME"
msgstr "Blessing of Flame"

msgid "DLC@GIANTKINGS@RELIC@MENHIR_OF_STONE@DESCRIPTION"
