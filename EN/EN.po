msgid "DLC@EMPIRESANDASHES@WILDLIFE_PROPERTIES@ROVING_FURNACE@ABILITY01@MOD_DESCRIPTION"
msgstr "Adjacent units:[bulletlist][bullet/]Suffer {amount} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Have a base {chance}% chance of becoming {GLOBAL.PROPERTIES.BURNING.Hyperlink}.[/bulletlist]"

