msgstr "Warped Seasons: Autumn"

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@TRAIT_WARPED_SEASONS@DESCRIPTION"
msgstr "The seasons are unusually potent on this realm, causing constant change and turmoil.[bulletlist][bullet/]Each season, a part of the land is [hyperlink,GLOBAL.TerraformingConcept]terraformed[/hyperlink] into different climes and <<m:{GLOBAL.ProvinceFeatureConcept.Hyperlink}>>.[bullet/]Each season, different weather effects are active.[bullet/]All <<m:{GLOBAL.UnitConcept.Hyperlink}>> become vulnerable to [damageBlight/] Blight, [damageFire/] Fire, [damageLightning/] Lightning, or [damageFrost/] Frost Damage according to the season.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@TRAIT_WARPED_SEASONS@NAME"
msgstr "Warped Seasons"

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@TRAIT_WARPED_SEASONS@OBJECTIVE@AUTUMN_TERRAFORMING_INFO"
msgstr "Provinces change to cool and wet climes."

