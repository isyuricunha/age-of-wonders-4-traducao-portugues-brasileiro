msgid "DLC@PRIMALFURY@EVENT@PREY_OF_SPIRITANIMAL_EVENTPHRASE@CROCODILE"
msgstr "we lie in wait until it draws near us, then rip it asunder with ferocious strength"

msgid "DLC@PRIMALFURY@EVENT@PREY_OF_SPIRITANIMAL_EVENTPHRASE@CROW"
msgstr "we climb to high ground, then swoop in for the quick kill"

msgid "DLC@PRIMALFURY@EVENT@PREY_OF_SPIRITANIMAL_EVENTPHRASE@MAMMOTH"
msgstr "we overpower small creatures with intimidating might and trample them underfoot"

msgid "DLC@PRIMALFURY@EVENT@PREY_OF_SPIRITANIMAL_EVENTPHRASE@SABERTOOTH"
msgstr "we pounce on feeble prey swiftly and without mercy, then drink its blood"

msgid "DLC@PRIMALFURY@EVENT@PREY_OF_SPIRITANIMAL_EVENTPHRASE@SERPENT"
msgstr "we coat our spears and arrows in venom, making the slightest wounds lethal"

msgid "DLC@PRIMALFURY@EVENT@PREY_OF_SPIRITANIMAL_EVENTPHRASE@SPIDER"
msgstr "we set traps and snares, then wait for our prey to walk into them"

msgid "DLC@PRIMALFURY@EVENT@PREY_OF_SPIRITANIMAL_EVENTPHRASE@WOLF"
msgstr "we execute a coordinated attack with the devoted hunters from my clan"

msgid "DLC@PRIMALFURY@EVENT@SPIRIT_QUEST_ENCOUNTER_EVENTPHRASE@CROCODILE"
msgstr "water pools between its roots, flooding the ground"

msgid "DLC@PRIMALFURY@EVENT@SPIRIT_QUEST_ENCOUNTER_EVENTPHRASE@CROW"
