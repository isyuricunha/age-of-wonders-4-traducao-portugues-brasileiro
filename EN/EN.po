msgid "DLC@RISEFROMRUIN@CATACLYSM@TOOLTIP@DEFEAT_PLAYER"
msgstr "Each {GLOBAL.TurnConcept.Hyperlink}, the {GLOBAL.CataclysmConcept.Hyperlink} level will decrease. When it reaches 0, the world will be cleansed of the fractured energies, destroying the cataclysm and the <<m:{GLOBAL.ArtifactConcept.Hyperlink}>>, and ceasing any unfinished Fated Region. You can stop this and seize the artifacts by defeating {PlayerLeader}."

msgid "DLC@RISEFROMRUIN@CATACLYSM@TOOLTIP@DEFEAT_PLAYER_SELF"
msgstr "Each {GLOBAL.TurnConcept.Hyperlink}, the {GLOBAL.CataclysmConcept.Hyperlink} level will decrease. When it reaches 0, the world will be cleansed of the fractured energies, destroying the cataclysm and the <<m:{GLOBAL.ArtifactConcept.Hyperlink}>>, and ceasing any unfinished Fated Region."

msgid "DLC@RISEFROMRUIN@CATACLYSM@TOOLTIP@NEW_HERALD"
