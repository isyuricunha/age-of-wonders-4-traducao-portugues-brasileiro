msgid "DLC@THRONESOFBLOOD@META_EMPIRE@REALM_SUNLESS@NAME_05"
msgstr "Kovar Drozhka"

msgid "DLC@THRONESOFBLOOD@META_EMPIRE@REALM_SUNLESS@NAME_06"
msgstr "Drelna Veytur"

msgid "DLC@THRONESOFBLOOD@META_EMPIRE@REALM_SUNLESS@SUBTITLE"
msgstr "A realm of eternal dusk, where the remnants of fallen empires fester in bitter rivalry."

msgid "DLC@THRONESOFBLOOD@META_EMPIRE@REALM_SUNLESS@TEMPLATE_NAME"
msgstr "Twilight Realm"

msgid "DLC@THRONESOFBLOOD@META_EMPIRE@TRAIT_SUNLESS_HIGHLANDS@DESCRIPTION"
msgstr "This realm consists of a mountainous and sunless heartland that gets colder towards the edges.[bulletlist][bullet/]The following <<m:{GLOBAL.ProvinceFeatureConcept.Hyperlink}>> are [abilityblue]Abundant[/abilityblue]:[bulletlist][bullet/]{GLOBAL.SunlessConcept.Hyperlink}, {GLOBAL.SnowConcept.Hyperlink}, and {GLOBAL.FrozenWasteConcept.Hyperlink}.[/bulletlist][bullet/]The following Province Features are [abilityblue]Scarce[/abilityblue]:[bulletlist][bullet/]{GLOBAL.AshlandsConcept.Hyperlink}, {GLOBAL.ChasmConcept.Hyperlink}, and {GLOBAL.LavaConcept.Hyperlink}.[/bulletlist][bullet/]The following Province Feature is [abilityblue]Absent[/abilityblue]:[bulletlist][bullet/]{GLOBAL.SandConcept.Hyperlink}[/bulletlist][/bulletlist]"

msgid "DLC@THRONESOFBLOOD@META_EMPIRE@TRAIT_SUNLESS_HIGHLANDS@NAME"
msgstr "Sunless Highlands"

msgid "DLC@THRONESOFBLOOD@MINOR_FACTION@UPGRADE_SET@DREADFUL@DESCRIPTION"
msgstr "This Free City is led by a Vampire nobility. They use terror and torment against their opponents while relishing in the sensation of their own pain."

msgid "DLC@THRONESOFBLOOD@MINOR_FACTION@UPGRADE_SET@DREADFUL@NAME"
msgstr "Dreadful Vampires"

msgid "DLC@THRONESOFBLOOD@MINOR_FACTION@UPGRADE_SET@SANGUINE@DESCRIPTION"
msgstr "This Free City is led by a Vampire nobility. They are experts at spilling blood and use it to empower themselves or nurture blood parasites."

msgid "DLC@THRONESOFBLOOD@MINOR_FACTION@UPGRADE_SET@SANGUINE@NAME"
msgstr "Sanguine Vampires"

msgid "DLC@THRONESOFBLOOD@MOUNT@DOOMBAT_MOUNT"
msgstr "Shrieking Bat Mount^n"

msgid "DLC@THRONESOFBLOOD@MOUNT@SKELETON_HORSE_MOUNT"
msgstr "Skeleton Horse Mount^n"

msgid "DLC@THRONESOFBLOOD@MOUNT_TRAIT@DOOM_BAT"
msgstr "Shrieking Bat Mounts"

msgid "DLC@THRONESOFBLOOD@MOUNT_TRAIT@DOOM_BAT@@EFEFCT_03@DESCRIPTION"
msgstr "Ruler starts with a Shrieking Bat mount."

msgid "DLC@THRONESOFBLOOD@MOUNT_TRAIT@DOOM_BAT@BIO"
msgstr "They darken the sky, mounted on their shrieking bats."

msgid "DLC@THRONESOFBLOOD@MOUNT_TRAIT@DOOM_BAT@LORE"
msgstr "[helpcolor]Mounted units are more common and gain a Shrieking Bat mount.[/helpcolor]"

msgid "DLC@THRONESOFBLOOD@NODES_STRATEGIC@BLOOD_GLASS@DESCRIPTION"
msgstr "Unique global effect:[bulletlist][bullet/]<<m:{GLOBAL.UnitConcept.Hyperlink}>> gain +{amount} {GLOBAL.HitPointConcept.Hyperlink} regeneration per {GLOBAL.WorldMapConcept.Hyperlink} {GLOBAL.TurnConcept}.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@NODES_STRATEGIC@BLOOD_GLASS@LORE"
msgstr "\"An alluring flower, trapping its victims in a thorny prison. From their drained blood crimson crystals bloom. My druids, wearing pendants of this Blood Glass, feel rejuvenated at dawn, as if its siphoned life force was bestowed upon them. Yet in nightly whispers they invoke the name of the [hyperlink,GLOBAL.UrvatoghLoreConcept]Pale Prince[/hyperlink], and I wonder: is it wrong to harness his curse?\"[br/][br/]— Sylvani Laurel, Survival within the Sunless Lands"

msgid "DLC@THRONESOFBLOOD@NODES_STRATEGIC@BLOOD_GLASS@NAME"
msgstr "Blood Glass^ns"

msgid "DLC@THRONESOFBLOOD@NODES_STRATEGIC@NODES@RUINED_BLOOD_GLASS@NAME"
msgstr "Ruined Blood Glass"

msgid "DLC@THRONESOFBLOOD@ONBOARDING_OBJECTIVES@VAMPIRE_CASTLE@DESCRIPTION"
msgstr "Your {GLOBAL.ThroneCityConcept.Hyperlink} has grown large enough for you to construct a Vampire's Castle. This beacon of your power provides many bonuses, including valuable {GLOBAL.ImperiumConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@ONBOARDING_OBJECTIVES@VAMPIRE_CASTLE@FINISHER@DESCRIPTION"
msgstr "You have finished constructing the first floor of your Vampire's Castle. You can now build your first set of rooms and improvements!"

msgid "DLC@THRONESOFBLOOD@ONBOARDING_OBJECTIVES@VAMPIRE_CASTLE@FINISHER@INSTRUCTIONS"
msgstr "Of particular interest:[bulletlist][bullet/]The {GLOBAL.STRUCTURE_UPGRADES.LORD_CASTLE_2.Hyperlink} lets you cast more powerful <<m:{GLOBAL.StrategicSummonSpellConcept.Hyperlink}>>.[bullet/]The [hyperlink,GLOBAL.ItemForgeConcept]{GLOBAL.STRUCTURE_UPGRADES.LORD_CASTLE_SOUL_FORGE.Name}[/hyperlink] lets you craft equipment for your heroes.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@ONBOARDING_OBJECTIVES@VAMPIRE_CASTLE@FINISHER@NAME"
msgstr "Vampire Castle Complete"

msgid "DLC@THRONESOFBLOOD@ONBOARDING_OBJECTIVES@VAMPIRE_CASTLE@FINISHER@PAGE02@DESCRIPTION"
msgstr "Your Castle also allows you to start collecting <<m:{GLOBAL.ThrallConcept.Hyperlink}>>, whom you can sacrifice to cast powerful ritual <<m:{GLOBAL.SpellConcept.Hyperlink}>>."

msgid "DLC@THRONESOFBLOOD@ONBOARDING_OBJECTIVES@VAMPIRE_CASTLE@FINISHER@PAGE02@INSTRUCTIONS"
msgstr "You can increase the speed at which you gain thralls by increasing the {GLOBAL.FoodConcept.Hyperlink} income of your {GLOBAL.ThroneCityConcept.Hyperlink}.[br/][br/]You can unlock more <<m:{GLOBAL.SpellConcept.Hyperlink}>> by upgrading your castle."

msgid "DLC@THRONESOFBLOOD@ONBOARDING_OBJECTIVES@VAMPIRE_CASTLE@FINISHER@SUMMARY"
msgstr "Tutorial about your completed Vampire's Castle"

msgid "DLC@THRONESOFBLOOD@ONBOARDING_OBJECTIVES@VAMPIRE_CASTLE@NAME"
msgstr "The Vampire Castle"

msgid "DLC@THRONESOFBLOOD@ONBOARDING_OBJECTIVES@VAMPIRE_CASTLE@OBJECTIVE"
msgstr "Vampire Castle Built"

msgid "DLC@THRONESOFBLOOD@ONBOARDING_OBJECTIVES@VAMPIRE_CASTLE@SUMMARY"
msgstr "Tutorial about building a Vampire Castle"

msgid "DLC@THRONESOFBLOOD@RITUAL_SPELL_01@NAME"
msgstr "Blood Transfer Ritual"

msgid "DLC@THRONESOFBLOOD@RITUAL_SPELL_01@SPELL_DESCRIPTION"
msgstr "In target friendly army:[bulletlist][bullet/]Heal Vampires for {amount}% of their maximum <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[bullet/]Heal non-Vampires for {amount2}% of their maximum <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@RITUAL_SPELL_02@NAME"
msgstr "Desecration Ritual"

msgid "DLC@THRONESOFBLOOD@RITUAL_SPELL_02@SPELL_DESCRIPTION"
msgstr "Target and adjacent surface <<m:{GLOBAL.ProvinceConcept.Hyperlink}>>:[bulletlist][bullet/]Gains {GLOBAL.SunlessConcept.Hyperlink}.[bullet/]Enemy armies sustain {amount} {GLOBAL.FrostDamageConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@RITUAL_SPELL_03@DESCRIPTION"
msgstr "For the next {amount} {GLOBAL.WorldMapConcept.Hyperlink} <<m:{GLOBAL.TurnConcept}>> Vampires:[bulletlist][bullet/]Don't suffer from {GLOBAL.PROPERTIES.SUNLIGHT_WEAKNESS.Hyperlink}.[bullet/]+{amount2} {GLOBAL.HitPointConcept.Hyperlink} regeneration on the World Map.[bullet/]Gain +{amount3}% damage.[bullet/]Gain +{amount4} {GLOBAL.ResistanceConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@RITUAL_SPELL_03@DESCRIPTION_HAPPENING"
msgstr "For the next 10 {GLOBAL.WorldMapConcept.Hyperlink} <<m:{GLOBAL.TurnConcept}>> Vampires:[bulletlist][bullet/]Don't suffer from {GLOBAL.PROPERTIES.SUNLIGHT_WEAKNESS.Hyperlink}.[bullet/]+15 {GLOBAL.HitPointConcept.Hyperlink} regeneration on the World Map.[bullet/]Gain +20% damage.[bullet/]Gain +2 {GLOBAL.ResistanceConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@RITUAL_SPELL_03@NAME"
msgstr "Blood Moon Ritual"

msgid "DLC@THRONESOFBLOOD@RITUAL_SPELL_03@PROP_DESCRIPTION"
msgstr "This unit:[bulletlist][bullet/]Doesn't suffer from {GLOBAL.PROPERTIES.SUNLIGHT_WEAKNESS.Hyperlink}.[bullet/]Has +{BLOOD_MOON_RITUAL_STAT_BONUS>BONUS>Regen} regeneration on the World Map.[bullet/]Has +{BLOOD_MOON_RITUAL_DAMAGE>ResolvedMultiplier}% damage.[bullet/]Has +{BLOOD_MOON_RITUAL_RESISTANCE>DEF_MOD>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@RITUAL_SPELL_04@NAME"
msgstr "Vivisection Ritual"

msgid "DLC@THRONESOFBLOOD@RITUAL_SPELL_04@SPELL_DESCRIPTION"
msgstr "Target enemy army sustains {amount} {GLOBAL.PhysicalDamageConcept.Hyperlink} damage. Then gain +{amount2} {GLOBAL.KnowledgeConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@RITUAL_SPELL_05@DISPLAY_PROPERTY_DESCRIPTION"
msgstr "This province has temporarily gained {GLOBAL.SunlessConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@RITUAL_SPELL_05@NAME"
msgstr "Pall of Darkness Ritual"

msgid "DLC@THRONESOFBLOOD@RITUAL_SPELL_05@SPELL_DESCRIPTION"
msgstr "Target surface <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> gain {GLOBAL.SunlessConcept.Hyperlink} for {duration} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@THRONESOFBLOOD@ROSE_PALACE@REWARD_HERO_FEMALE@FIRSTNAME_01"
msgstr "Rose^F"

msgid "DLC@THRONESOFBLOOD@ROSE_PALACE@REWARD_HERO_FEMALE@LASTNAME_01"
msgstr "of Thorns^z"

msgid "DLC@THRONESOFBLOOD@ROSE_PALACE@REWARD_HERO_MALE@FIRSTNAME_01"
msgstr "Thorne^M"

msgid "DLC@THRONESOFBLOOD@ROSE_PALACE@REWARD_HERO_MALE@LASTNAME_01"
msgstr "of Roses^z"

msgid "DLC@THRONESOFBLOOD@SECTORDEFINITIONS_STRATEGIC@CRIMSON_COURT_STRATEGIC_PROP@DESCRIPTION"
msgstr "[bulletlist][bullet/]Gain {amount} {GLOBAL.ManaConcept.Hyperlink} on successfully {GLOBAL.PillagingConcept.Hyperlink} a {GLOBAL.ProvinceImprovementConcept.Hyperlink}.[bullet/]Gain {amount2} {GLOBAL.ManaConcept.Hyperlink} on successfully {GLOBAL.RazingConcept.Hyperlink} a conquered {GLOBAL.CityConcept.Hyperlink} per {GLOBAL.PopulationConcept.Hyperlink} and {GLOBAL.ProvinceImprovementConcept.Hyperlink} that hasn't been Pillaged.[bullet/]Gain {amount3} {GLOBAL.ManaConcept.Hyperlink} on successfully {GLOBAL.MigratingConcept.Hyperlink} a conquered {GLOBAL.CityConcept.Hyperlink} per {GLOBAL.PopulationConcept.Hyperlink}. But the City loses additional [population/] Population afterward.[bullet/]<<m:{GLOBAL.PvEVassalConcept.Hyperlink}>> grant {amount4} {GLOBAL.ManaConcept.Hyperlink} income per {GLOBAL.PopulationConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@SECTORDEFINITIONS_STRATEGIC@CRIMSON_COURT_STRATEGIC_PROP@HYPERLINK"
msgstr "[hyperlink,GLOBAL.CrimsonCourtMagistrateConcept]Crimson Court Magistrate[/hyperlink]"

msgid "DLC@THRONESOFBLOOD@SECTORDEFINITIONS_STRATEGIC@CRIMSON_COURT_STRATEGIC_PROP@NAME"
msgstr "Crimson Court Magistrate"

msgid "DLC@THRONESOFBLOOD@SECTORDEFINITIONS_STRATEGIC@SUNLESS_FEATURE@DESCRIPTION"
msgstr "A {GLOBAL.ProvinceFeatureConcept.Hyperlink}[br/][br/]The absence of sunlight has spread thorny and dark flora dotted with crimson roses.[br/][bulletlist][bullet/]<<m:{GLOBAL.CityConcept.Hyperlink}>> annexing this {GLOBAL.ProvinceConcept.Hyperlink} suffer {stabilitypenalty} {GLOBAL.CityStabilityConcept.Hyperlink}.[bullet/]<<m:{GLOBAL.UnitConcept.Hyperlink}>> regenerate {regen} <<m:{GLOBAL.HitPointConcept.Hyperlink}>> per {GLOBAL.TurnConcept.Hyperlink} in the {GLOBAL.WorldMapConcept.Hyperlink}.[bullet/]<<m:{GLOBAL.UnitConcept.Hyperlink}>> only receive {percentage} of <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> when healed in {GLOBAL.CombatConcept.Hyperlink}.[bullet/]Units and Cities that have {GLOBAL.PROPERTIES.HEARTLESS.Hyperlink} or are of an empire led by a {GLOBAL.VampireLordConcept.Hyperlink} are immune to these effects.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@SECTORDEFINITIONS_STRATEGIC@SUNLESS_FEATURE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.SunlessConcept]Sunless[/hyperlink]"

msgid "DLC@THRONESOFBLOOD@SECTORDEFINITIONS_STRATEGIC@SUNLESS_FEATURE@NAME"
msgstr "Sunless"

msgid "DLC@THRONESOFBLOOD@SECTORDEFINITIONS_STRATEGIC@SUNLESS_FEATURE@PROPERTY_DESCRIPTION"
msgstr "Units without {GLOBAL.PROPERTIES.HEARTLESS.Hyperlink} in Sunless terrain regenerate {regen} <<m:{GLOBAL.HitPointConcept.Hyperlink}>> per {GLOBAL.TurnConcept.Hyperlink} in the {GLOBAL.WorldMapConcept.Hyperlink} and only receive {percentage} of <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> when healed in {GLOBAL.CombatConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@SHAREDMODIFIERS_UNITPROPERTIES@BENEVOLENT_BLOOD_PARASITE@DESCRIPTION"
msgstr "On unit death, it spawns a {GLOBAL.UNITS.BLOOD_MAGGOT.Hyperlink} under the defender's control until end of combat."

msgid "DLC@THRONESOFBLOOD@SHAREDMODIFIERS_UNITPROPERTIES@BENEVOLENT_BLOOD_PARASITE@NAME"
msgstr "Benevolent Blood Parasite"

msgid "DLC@THRONESOFBLOOD@SHAREDMODIFIERS_UNITPROPERTIES@BERSERK_BLOOD_PARASITE@DESCRIPTION"
msgstr "On unit death, it spawns a {GLOBAL.UNITS.BLOOD_MAGGOT.Hyperlink} with {GLOBAL.PROPERTIES.BERSERK.Hyperlink} under the defender's control until end of combat."

msgid "DLC@THRONESOFBLOOD@SHAREDMODIFIERS_UNITPROPERTIES@BERSERK_BLOOD_PARASITE@NAME"
msgstr "Berserk Blood Parasite"

msgid "DLC@THRONESOFBLOOD@SHAREDMODIFIERS_UNITPROPERTIES@BLOOD_PARASITE@DESCRIPTION"
msgstr "[bulletlist][bullet/]Unit sustains {BLOOD_PARASITE_DAMAGE_OVER_TIME>ATTACK>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink} each [turn/].[bullet/]Replaces and counts as {GLOBAL.PROPERTIES.BLEEDING.Hyperlink}, but ignores {GLOBAL.PROPERTIES.STATUS_EFFECT_IMMUNITY_BLEEDING.Hyperlink}.[bullet/]Stacks up to {amount} times.[/bulletlist][bulletlist][br/]On unit death, it spawns a {GLOBAL.UNITS.BLOOD_MAGGOT.Hyperlink} under the opponent's control until end of combat.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@SHAREDMODIFIERS_UNITPROPERTIES@BLOOD_PARASITE@GUARANTEED_MODIFIER_DESCRIPTION"
msgstr "Inflicts {GLOBAL.PROPERTIES.BLOOD_PARASITE.Hyperlink} for {BLOOD_PARASITE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "DLC@THRONESOFBLOOD@SHAREDMODIFIERS_UNITPROPERTIES@BLOOD_PARASITE@MODIFIER_DESCRIPTION"
msgstr "Base {BLOOD_PARASITE_RESISTANCE>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.BLOOD_PARASITE.Hyperlink} for {BLOOD_PARASITE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "DLC@THRONESOFBLOOD@SHAREDMODIFIERS_UNITPROPERTIES@BLOOD_PARASITE@NAME"
msgstr "Blood Parasite"

msgid "DLC@THRONESOFBLOOD@SHAREDMODIFIERS_UNITPROPERTIES@COAGULATE@DESCRIPTION"
msgstr "Once per turn when hit by an attack, gain for {BOLSTERED_DEFENSE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>:[bulletlist][bullet/]{GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink}[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@SHAREDMODIFIERS_UNITPROPERTIES@COAGULATE@NAME"
msgstr "Coagulate"

msgid "DLC@THRONESOFBLOOD@SHAREDMODIFIERS_UNITPROPERTIES@LIFEDRINKER@DESCRIPTION"
msgstr "When an adjacent unit dies:[bulletlist][bullet/]Gain {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} for {STRENGTHENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Heal for {LIFEDRINKER_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@SHAREDMODIFIERS_UNITPROPERTIES@LIFEDRINKER@NAME"
msgstr "Lifedrinker"

msgid "DLC@THRONESOFBLOOD@SHOPS_STRATEGIC@BEAST_WRANGLER@EXOTIC_DOOM_BAT"
msgstr "Shrieking Bat Mount Contract"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@TURNED_VAMPIRE_BONUS@DESCRIPTION"
msgstr "This unit has:[bulletlist][bullet/]+{TURNED_VAMPIRE_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>> and +{TURNED_VAMPIRE_BONUS>BONUS>DEFENSE>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}.[/bulletlist][br/]A Turned Vampire gains a stack of this for each Signature Skill the Elder Vampire has."

msgid "DLC@THRONESOFBLOOD@SIGNATURES@TURNED_VAMPIRE_BONUS@NAME"
msgstr "Elder Vampire's Gift"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@BATSWARM@ABILITY_DESCRIPTION"
msgstr "Adjacent enemy units:[bulletlist][bullet/]Sustain damage.[bullet/]Have a base {BLINDED_RESISTANCE>ResolvedStrength}% chance of becoming {GLOBAL.PROPERTIES.BLINDED.Hyperlink} for {BLINDED_EFFECT_DESCRIPTION>NumTurns} {GLOBAL.TurnConcept}.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@SIGNATURES@VAMPIRE@BATSWARM@ABILITY_NAME"
msgstr "Bat Swarm"

