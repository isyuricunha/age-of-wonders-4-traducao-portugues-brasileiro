msgstr "Burning Dust:[bulletlist][bullet/]Deals an additional {BURNING_DAMAGE_OVER_TIME>ATTACK>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Gains a base {BLINDED_RESISTANCE>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.BLINDED.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_11@NAME"
msgstr "Burning Dust"

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_11@NAME_CHAMPION"
msgstr "Champion Burning Dust"

