msgid "DLC@GIANTKINGS@EXPLORATIONSITE_STRATEGIC@GIANTSTHRONE@LORE"
msgstr "A palatial monument to a [hyperlink,GLOBAL.GiantsLoreConcept]Giant King of old[/hyperlink], revered as a god by their smallfolk subjects. Richly decorated with gold and black marble, such Thrones are faint echoes of the splendor of {GLOBAL.MyrridaLoreConcept.Hyperlink} that once spanned much of the {GLOBAL.AstralSeaLoreConcept.Hyperlink}. Despite their immeasurable age, these majestic statues display no signs of decay."

msgid "DLC@GIANTKINGS@EXPLORATIONSITE_STRATEGIC@GIANTSTHRONE@NAME"
msgstr "Giant's Throne"

msgid "DLC@GIANTKINGS@EXPLORATIONSITE_STRATEGIC@MAGMAPRISON@DESCRIPTION"
