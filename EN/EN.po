msgid "DLC@PRIMALFURY@META_EMPIRE@REALM_STORMWREATHED_ISLES@SUBTITLE"
msgstr "A realm of storms and islands inhabited by fey creatures that plays host to a dispute between two powerful Godir."

msgid "DLC@PRIMALFURY@META_EMPIRE@REALM_STORMWREATHED_ISLES@TEMPLATE_NAME"
msgstr "Stormwreathed Isles"

msgid "DLC@PRIMALFURY@META_EMPIRE@REALM_TRAIT@PRIMAL_DISPUTE@DESCRIPTION"
msgstr "This Realm is the stage of a violent dispute between the Godir Serena and Nimue, whose primal followers fight a bloody conflict.[bulletlist][bullet/]The Primal Godir {PRIMAL_DISPUTE_LEADER_1.Hyperlink} and {PRIMAL_DISPUTE_LEADER_2.Hyperlink} start with powerful Nature Skills.[bullet/]{PRIMAL_DISPUTE_LEADER_1.Hyperlink} and {PRIMAL_DISPUTE_LEADER_2.Hyperlink} start at {GLOBAL.WarConcept.Hyperlink}.[bullet/]Whoever forms an alliance with or defeats each Primal Godir is [abilityblue]Victorious[abilityblue/].[/bulletlist]"

msgid "DLC@PRIMALFURY@META_EMPIRE@REALM_TRAIT@PRIMAL_DISPUTE@NAME"
msgstr "Primal Dispute"

msgid "DLC@PRIMALFURY@META_EMPIRE@REALM_TRAIT@PRIMAL_DISPUTE@NIMUE_BIO"
msgstr "Her mind is a torrent of unpredictable chaos. She wills it, and her children rise from the surge, breathing her very lifeblood. Like the tide beating against the changing coastline, so too is Nimue among the Godir. Her power is undeniable, yet her moods swirl like waves in a tide pool. Her children all accept that, inevitably, all will find themselves drowned in a watery grave."

msgid "DLC@PRIMALFURY@META_EMPIRE@REALM_TRAIT@PRIMAL_DISPUTE@OBJECTIVE"
msgstr "Nimue Defeated or Allied"

msgid "DLC@PRIMALFURY@META_EMPIRE@REALM_TRAIT@PRIMAL_DISPUTE@OBJECTIVE2"
msgstr "Serena Defeated or Allied"

msgid "DLC@PRIMALFURY@META_EMPIRE@REALM_TRAIT@PRIMAL_DISPUTE@RELATION_MODIFIER"
msgstr "Supported her view of the Primal Dispute"

msgid "DLC@PRIMALFURY@META_EMPIRE@REALM_TRAIT@PRIMAL_DISPUTE@RELATION_MODIFIER2"
msgstr "Rejected her view of the Primal Dispute"

msgid "DLC@PRIMALFURY@MINOR_FACTION@UPGRADE_SET@FEY@DESCRIPTION"
msgstr "These are the Followers of Fey, who have integrated the mystical and fickle nature of the Fey into their society, becoming territorial and unpredictable."

