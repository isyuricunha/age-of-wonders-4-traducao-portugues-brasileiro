msgid "DLC@ELDRITCHREALMS@STORY_REALM_02@TRIGGER_TOOLTIP@ALFRED_HERO_SKILL"
msgstr "{EventPlayer.Name} learns the {GLOBAL.SKILLS.HS_CLEANSING_FLAMEHERALD.Hyperlink} hero skill."

msgid "DLC@ELDRITCHREALMS@STORY_REALM_02@TRIGGER_TOOLTIP@DAMAGED_STARTING_ARMY"
msgstr "You and your troops start with {IntPercentage}% of their maximum <<m:{GLOBAL.HitPointConcept.Hyperlink}>>."

msgid "DLC@ELDRITCHREALMS@STORY_REALM_02@TRIGGER_TOOLTIP@DREAMROOT_OAK_HINT"
msgstr "The {EventStructure} can be entered from anywhere within its sector, also when owned by other players."

msgid "DLC@ELDRITCHREALMS@STORY_REALM_02@TRIGGER_TOOLTIP@ENDAILON_INSTRUCTION_INFO"
msgstr "Destroy <<m:{EventStructure.Name}>> and <<m:{EventInfestation.Name}>> to greatly delay the Nightweaver Ritual."

msgid "DLC@ELDRITCHREALMS@STORY_REALM_02@TRIGGER_TOOLTIP@LITHYL_DEFEAT_DELAY"
msgstr "The Nightweaver Ritual is continued by {Merlin.Name}, but delayed by {IntDuration} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@ELDRITCHREALMS@STORY_REALM_02@TRIGGER_TOOLTIP@LITHYL_WAR"
msgstr "{EventPlayer.Name} declares {GLOBAL.WarConcept.Hyperlink} on every {GLOBAL.GodirLoreConcept.Hyperlink} present ."

msgid "DLC@ELDRITCHREALMS@STORY_REALM_02@TRIGGER_TOOLTIP@MERLIN_DEFEAT_DELAY"
msgstr "The Nightweaver Ritual is delayed by {IntDuration} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@ELDRITCHREALMS@STORY_REALM_02@TRIGGER_TOOLTIP@MERLIN_WAR"
msgstr "{EventPlayer.Name} declares {GLOBAL.WarConcept.Hyperlink} on every present {GLOBAL.GodirLoreConcept.Hyperlink} outside the Umbral alliance."

msgid "DLC@ELDRITCHREALMS@STORY_REALM_02@TRIGGER_TOOLTIP@ONERON_COVENANT"
msgstr "{EventPlayer.Name} joins the {GLOBAL.CovenantFactionLoreConcept.Hyperlink} {GLOBAL.DSAllianceConcept.Hyperlink}."

msgid "DLC@ELDRITCHREALMS@STORY_REALM_02@TRIGGER_TOOLTIP@PANTHEON_JOIN_OPTION"
msgstr "{EventHero} joins you as a hero, but you lose all non-scout starting units."

msgid "DLC@ELDRITCHREALMS@STORY_REALM_02@TRIGGER_TOOLTIP@RANK_UP_STARTING_ARMY"
msgstr "All your normal <<m:{GLOBAL.UnitConcept.Hyperlink}>> gain enough {GLOBAL.ExperienceConcept.Hyperlink} to rank up {IntLvlUps} times."

msgid "DLC@ELDRITCHREALMS@STORY_REALM_02@TRIGGER_TOOLTIP@REVEAL_UNDERGROUND"
msgstr "A large part of the underground near {EventCity} is revealed."

msgid "DLC@ELDRITCHREALMS@STORY_REALM_02@TRIGGER_TOOLTIP@RITUAL_INFO_1"
