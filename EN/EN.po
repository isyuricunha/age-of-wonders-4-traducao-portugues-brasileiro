msgstr "Restart the Cycle: [bulletlist][bullet/]Heals an additional {healAmount}<<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Resurrects units with an additional {resurrectPercentage}% of their total <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[/bulletlist]"

msgid "TOME_CYCLES@ABILITY_3@ERROR_MESSAGE"
msgstr "Requires {GLOBAL.PROPERTIES.LIFE_FROM_DEATH_ABILITY_MODIFIER.Hyperlink} to be used."

msgid "TOME_CYCLES@ABILITY_3@NAME"
msgstr "Restart the Cycle"

msgid "TOME_CYCLES@ABILITY_3@NAME_CHAMPION"
msgstr "Champion Restart the Cycle"

msgid "TOME_CYCLES@ABILITY_4@DESCRIPTION"
msgstr "Target non-hero friendly unit is killed, adjacent enemies suffer {SACRIFICIAL_BLIGHT_DAMAGE>DAMAGE>Blight} {GLOBAL.BlightDamageConcept.Hyperlink} per tier of the unit sacrificed.[br/][br/]This ability always triggers {GLOBAL.PROPERTIES.LIFE_FROM_DEATH_ABILITY_MODIFIER.Hyperlink},"

msgid "TOME_CYCLES@ABILITY_4@NAME"
msgstr "Sacrificial Blight"

