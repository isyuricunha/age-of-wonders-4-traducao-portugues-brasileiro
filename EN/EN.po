msgid "INTERFACE@TEXT@CITY_MORALE"
msgstr "[happiness/] City Stability"

msgid "INTERFACE@TEXT@CITY_MORALE_DESCRIPTION"
msgstr "[happiness/] City Stability represents your overall control over a {GLOBAL.CityConcept.Hyperlink}.[br/][bulletlist][bullet/]High Stability boosts {GLOBAL.FoodConcept.Hyperlink}, {GLOBAL.UnitProductionConcept.Hyperlink}, and {GLOBAL.StructureProductionConcept.Hyperlink} income.[bullet/]Low Stability reduces all {GLOBAL.CityIncomeConcept.Hyperlink}.[bullet/]Very Low Stability can lead to the city losing <<m:{GLOBAL.ProvinceConcept.Hyperlink}>>.[/bulletlist][br/]It drops as the city's {GLOBAL.DomainConcept.Hyperlink} grows, and can be regained by building certain <<m:{GLOBAL.CityStructureConcept.Hyperlink}>>.[br/][bulletlist][bullet/]{harmonymin} to {harmonymax}: {GLOBAL.CityStabilityHarmony.Hyperlink}.[bullet/]{ordermin} to {ordermax}: {GLOBAL.CityStabilityOrderly.Hyperlink}.[bullet/]{stablemin} to {stablemax}: {GLOBAL.CityStabilityStable.Hyperlink}.[bullet/]{neutralmin} to {neutralmax}: Neutral.[bullet/]{unstablemin} to {unstablemax}: {GLOBAL.CityStabilityUnstable.Hyperlink}.[bullet/]{unrestmin} to {unrestmax}: {GLOBAL.CityStabilityUnrest.Hyperlink}.[bullet/]{riotmin} to {riotmax}: {GLOBAL.CityStabilityRioting.Hyperlink}.[/bulletlist]"

msgid "INTERFACE@TEXT@CITY_MORALE_DESCRIPTION_HARMONY"
msgstr "{harmonyvalue} {GLOBAL.StructureProductionConcept.Hyperlink}, {GLOBAL.UnitProductionConcept.Hyperlink} and {GLOBAL.FoodConcept.Hyperlink} income."

msgid "INTERFACE@TEXT@CITY_MORALE_DESCRIPTION_ORDERLY"
msgstr "{ordervalue} {GLOBAL.StructureProductionConcept.Hyperlink}, {GLOBAL.UnitProductionConcept.Hyperlink} and {GLOBAL.FoodConcept.Hyperlink} income."

msgid "INTERFACE@TEXT@CITY_MORALE_DESCRIPTION_RIOTING"
msgstr "{riotingvalue} {GLOBAL.CityIncomeConcept.Hyperlink}. There is a chance that the provinces might defect from the city."

msgid "INTERFACE@TEXT@CITY_MORALE_DESCRIPTION_STABLE"
msgstr "{stablevalue} {GLOBAL.StructureProductionConcept.Hyperlink}, {GLOBAL.UnitProductionConcept.Hyperlink} and {GLOBAL.FoodConcept.Hyperlink} income."

