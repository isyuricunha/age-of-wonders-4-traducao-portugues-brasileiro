msgstr "- Access to Giant's Keep, a building that allows the recruitment of Giants[br/]- Cities led by Giants gain +10[production/]"

msgid "TRAITS_BACKGROUND_CHARACTERS@GIANTL_LEADERS@NAME"
msgstr "Giant Leader"

msgid "TRAITS_BACKGROUND_CHARACTERS@HIGH_SWORD_CROSSBOW@DESCRIPTION"
msgstr "{GLOBAL.LeaderConcept.Hyperlink} starts with:[bulletlist][bullet/]{GLOBAL.HeroClassRanger.Hyperlink}[bullet/]{GLOBAL.EQUIPMENT.HIGH_CROSSBOW_SWORD.Hyperlink}[bullet/]{GLOBAL.HeroMountConcept.Hyperlink}[/bulletlist]"

msgid "TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@GIANT"
msgstr "Giant Leader"

msgid "TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@GIANT@DESCRIPTION"
msgstr "[helpcolor]A Giant ascended to be a monsterous overlord.[/helpcolor][br/][bulletlist][bullet/]Cities led by Giants gain +10[production/] Production.[bullet/]Powerful unit, but unable to equip man-sized[br/]items. [abilityred]<DEV - can for now equip items>[/abilityred][/bulletlist]"

msgid "TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@RACIAL_LEADER"
msgstr "Champion"

msgid "TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@RACIAL_LEADER@DESCRIPTION"
msgstr "{LOC.TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@RACIAL_LEADER@DESCRIPTION_SHORT}[br/][bulletlist][bullet/]Mortal Champions have access to unique army leadership hero skills.[bullet/]Mortal Champion Rulers gain {xpbonus} {GLOBAL.ExperienceConcept.Hyperlink}.[bullet/]Start with {relation} Relation with [hyperlink,GLOBAL.IndependentCityRelationConcept]Free Cities[/hyperlink].[bullet/]Mortal Champion Rulers start with the {GLOBAL.PROPERTIES.SPUR_TO_ACTION.Hyperlink} ability in {GLOBAL.CombatConcept.Hyperlink}.[bullet/]Mortal Champions are <<m:{GLOBAL.PROPERTIES.HEROTRAIT_GOVERNANCE_CHAMPION_GOVERNOR.Hyperlink}>>.[/bulletlist]"

msgid "TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@RACIAL_LEADER@DESCRIPTION_SHORT"
msgstr "[helpcolor]A Ruler risen from the ranks of their people.[/helpcolor]"

msgid "TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@RACIAL_LEADER@HYPERLINK"
msgstr "[hyperlink,GLOBAL.MortalChampionConcept]Champion[/hyperlink]"

msgid "TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@RACIAL_LEADER@RELATION_MODIFIER"
msgstr "Ruler Origin: Champion of the People"

msgid "TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@UNIT_RULER"
