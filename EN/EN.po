msgstr "Fumigation"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL6@DESCRIPTION"
msgstr "[bulletlist][bullet/]{KnowledgeBonus}{GLOBAL.KnowledgeConcept.Hyperlink} income.[bullet/]{GoldBonus}{GLOBAL.GoldConcept.Hyperlink} income.[bullet/]{KnowledgePerMaterial}{GLOBAL.KnowledgeConcept.Hyperlink} income per {GLOBAL.MagicMaterialConcept.Hyperlink} in this city's {GLOBAL.DomainConcept.Hyperlink}.[bullet/]{GoldPerMaterial}{GLOBAL.GoldConcept.Hyperlink} income per {GLOBAL.MagicMaterialConcept.Hyperlink} in this city's {GLOBAL.DomainConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL6@NAME"
msgstr "Material Refinery"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@TACTICALOBSTACLES@AFFLICTING_MIASMA@DESCRIPTION"
msgstr "Units passing through or ending their turn on this hex will be inflicted with {GLOBAL.PROPERTIES.WEAKENED.Hyperlink}.[br/]Units on this hex have {GLOBAL.PROPERTIES.AFFLICTING_MIASMA_STATUS_EFFECT.Hyperlink}."

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@TACTICALOBSTACLES@AFFLICTING_MIASMA@NAME"
msgstr "Afflicting Miasma"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Inflict your enemies with <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>> and mitigate them on your own units. Tinctures and a powerful ranged unit will help you manipulate the tides of battle."

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@TOME@LORE_AUTHOR"
msgstr "Fauster, the Meticulous"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@TOME@LORE_DESCRIPTION"
msgstr "\"The perfect alchemical formula requires an equal measure of both time and fortune. Who else but the alchemist spends years of meticulous research into understanding the very essence of nature... Only to find the solution through sheer happenstance! Alchemy truly is a gamble with nature, entailing the power to both create, or destroy.\""

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@TOME@NAME"
msgstr "Tome of Alchemy"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@UNIT_ABILITY_1@DESCRIPTION"
msgstr "Deal damage to target unit and create {GLOBAL.AfflictingMiasmaHazard.Hyperlink} on their hex."

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@UNIT_ABILITY_1@NAME"
msgstr "Miasma Shot"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@HERO_SKILL1@DESCRIPTION"
msgstr "While army leader, all <<m:{GLOBAL.PROPERTIES.CONSTRUCT.Hyperlink}>> have:[bulletlist][bullet/]+{EXPERIENCED_WARSMITH_DEFENSE>DEF_MOD>Armor} {GLOBAL.DefenseConcept.Hyperlink}[bullet/]Heal +{EXPERIENCED_WARSMITH_REGENERATION>BONUS>Regen} <<m:{GLOBAL.HitPointConcept.Hyperlink}>> per {GLOBAL.WorldMapConcept.Hyperlink} {GLOBAL.TurnConcept.Hyperlink}.[/bulletlist][br/]Start combat with a {GLOBAL.UNITS.IRON_GOLEM_ASSISTANT_UNIT.Hyperlink}, a Tier I {GLOBAL.PROPERTIES.FIGHTER.Hyperlink} (does not work in water battles)."

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@HERO_SKILL1@NAME"
msgstr "Experienced Warsmith"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@LINKED_MINDS_DESCRIPTION"
msgstr "This unit gains {GLOBAL.PROPERTIES.HYPER_AWARE_UNIT_PASSIVE.Hyperlink} when it is adjacent to a {GLOBAL.PROPERTIES.CONSTRUCT.Hyperlink} or unit with Linked Minds."

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@PROVINCE_IMPROVEMENT@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{baseamount} {GLOBAL.StructureProductionConcept.Hyperlink}.[bullet/]{amount1} {GLOBAL.FoodConcept.Name} per adjacent {GLOBAL.FarmConcept.Hyperlink}.[bullet/]{amount2} {GLOBAL.StructureProductionConcept.Hyperlink} per adjacent {GLOBAL.QuarryConcept.Hyperlink} or {GLOBAL.ForesterConcept.Hyperlink}.[bullet/]{amount4} {GLOBAL.ManaConcept.Hyperlink} per adjacent {GLOBAL.ConduitConcept.Hyperlink}. [bullet/]{amount5} {GLOBAL.KnowledgeConcept.Hyperlink} per adjacent {GLOBAL.ResearchPostConcept.Hyperlink}.[bullet/]{amount6} {GLOBAL.GoldConcept.Name} per adjacent {GLOBAL.MineConcept.Hyperlink}.[bullet/]Counts as a {GLOBAL.QuarryConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@PROVINCE_IMPROVEMENT@TITLE"
msgstr "[quarry/] Worker Construct Nexus"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@SKILL1@DESCRIPTION"
msgstr "A {GLOBAL.PROPERTIES.POLEARM_UNIT.Hyperlink} capable of inflicting {GLOBAL.PROPERTIES.WEAKENED.Hyperlink}."

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@SKILL1@NAME"
msgstr "Bronze Golem"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@SKILL2@DESCRIPTION"
msgstr "Target friendly {GLOBAL.PROPERTIES.CONSTRUCT.Hyperlink} or {GLOBAL.PROPERTIES.LINKED_MINDS_PROPERTY_GROUP.Hyperlink} unit: [bulletlist][bullet/]Gains {GLOBAL.PROPERTIES.DEFENSIVE_MASTERS.Hyperlink} for {CASCADING_COMMAND_DEFEND_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Has {CASCADING_COMMAND_DEFEND_EFFECT_DISPEL>NumThingsToDispel} <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>> dispelled.[bullet/]This effect then applies to adjacent friendly Construct or Linked Mind units and is repeated.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@SKILL2@NAME"
msgstr "Cascading Command: Defend"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@SKILL3@DESCRIPTION"
msgstr "When adjacent to another unit with Compounding Defense this unit gains:[bulletlist][bullet/]+{COMPOUNDING_DEFENSE_DEFENSE>DEF_MOD>Armor} {GLOBAL.DefenseConcept.Hyperlink}[bullet/]+{COMPOUNDING_DEFENSE_DEFENSE>DEF_MOD>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@SKILL3@NAME"
msgstr "Compounding Defense"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@SKILL4@DESCRIPTION"
msgstr "Target friendly {GLOBAL.PROPERTIES.CONSTRUCT.Hyperlink} or {GLOBAL.PROPERTIES.LINKED_MINDS_PROPERTY_GROUP.Hyperlink} unit gains:[bulletlist][bullet/]{GLOBAL.PROPERTIES.HASTENED.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}[bullet/]This effect then cascades to adjacent friendly Construct or Linked Mind units and is repeated.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@SKILL4@NAME"
msgstr "Cascading Command: Reposition"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@SKILL5@DESCRIPTION"
msgstr "Target friendly city gains +{amount} {GLOBAL.FoodConcept.Hyperlink}.[br/]This spell costs Binding Essence."

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@SKILL5@NAME"
msgstr "Construct Population"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@SKILL6@DESCRIPTION"
msgstr "Units of this race gain the ability to share senses, granting them:[bulletlist][bullet/]{GLOBAL.PROPERTIES.HYPER_AWARE_UNIT_PASSIVE.Hyperlink} when standing next to a {GLOBAL.PROPERTIES.CONSTRUCT.Hyperlink} or another unit with Linked Minds.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@SKILL6@NAME"
msgstr "Linked Minds"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Master legions of constructs, fighting in uncannily synchronized formations, commanding them perfectly and crushing your foes beneath the march of their boots."

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@TOME@LORE_DESCRIPTION"
msgstr "\"Are constructs 'alive'? For this I have only one answer: Does it matter? Constructs are obedient war machines created for one purpose: To crush everything in their path. In my opinion, the true question anyone should ask is: 'How do I escape their deadly march?'\""

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@TOME@NAME"
msgstr "Tome of the Construct"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@ABILITY1@DESCRIPTION"
msgstr "Blast the target with the main gun and knock them back."

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@ABILITY1@NAME"
msgstr "Direct Fire"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@ABILITY2@DESCRIPTION"
msgstr "Deals damage in a {BARRAGE_CIRCLE_TARGETER>AREA>Radius}-hex radius."

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@ABILITY2@FLAG@DESCRIPTION"
msgstr "This hex will be struck for {amount} {GLOBAL.PhysicalDamageConcept.Hyperlink} at the start of the owner's [turn/] [hyperlink,GLOBAL.TurnConcept]Next Turn[/hyperlink]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@ABILITY2@NAME"
msgstr "Barrage"

