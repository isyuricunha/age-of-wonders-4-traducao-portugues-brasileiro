msgid "DLC@ELDRITCHREALMS@CITYDEFINITIONS_STRATEGIC@SANCTUARY@NAME"
msgstr "Sanctuary Outpost"

msgid "DLC@ELDRITCHREALMS@CITYDEFINITIONS_STRATEGIC@UMBRAL_DWELLING@ALIGNMENT"
msgstr "Umbral Dwelling Destroyed"

msgid "DLC@ELDRITCHREALMS@CITYDEFINITIONS_STRATEGIC@UMBRAL_DWELLING@DESCRIPTION"
msgstr "Umbral Dwellings are a type of {GLOBAL.DwellingConcept.Hyperlink} inhabited by {GLOBAL.ShadowDemonsLoreConcept.Hyperlink} that can only be found in the {GLOBAL.ShadowRealmLoreConcept.Hyperlink}.[br/][bulletlist][bullet/]Umbral Dwellings are always considered {GLOBAL.PROPERTIES.EVIL_3_UNIT_PROPERTY.Hyperlink} and will have positive relations with other [reputation2/] Evil Empires and negative relations with [reputation6/] Good Empires.[bullet/]You cannot assign a {GLOBAL.DiplomaticTokenConcept.Hyperlink} to them.[bullet/]To improve {GLOBAL.HouseInfluenceConcept.Hyperlink}, you will be asked to make sacrifices during random events and via the Boost Allegiance action.[bullet/]Upon reaching a {GLOBAL.EldritchPactConcept.Hyperlink}, you can purchase unique <<m:{GLOBAL.SpellConcept.Hyperlink}>> and other bonuses to benefit from {GLOBAL.GloomTerrainConcept.Hyperlink} terrain.[bullet/]Umbral Dwellings slowly alter terrain in and adjacent to their {GLOBAL.DomainConcept.Hyperlink} into {GLOBAL.GloomTerrainConcept.Hyperlink}[bullet/]Umbral Dwellings cannot be [hyperlink,GLOBAL.PactOfVassalageConcept]vassalized[/hyperlink] or [hyperlink,GLOBAL.AbsorbingConcept]conquered[/hyperlink]. Instead, they are destroyed upon being captured.[bullet/] Umbral Dwellings are led by unique <<{GLOBAL.UNITS.UMBRAL_TYRANT.Hyperlink}>> <<m:{GLOBAL.PROPERTIES.HERO.Hyperlink}>> who cannot be recruited or converted.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@CITYDEFINITIONS_STRATEGIC@UMBRAL_DWELLING@NAME"
msgstr "Umbral Dwelling"

msgid "DLC@ELDRITCHREALMS@CITYDEFINITIONS_STRATEGIC@UMBRAL_DWELLING@NAME_PLURAL"
msgstr "Umbral Dwellings"

