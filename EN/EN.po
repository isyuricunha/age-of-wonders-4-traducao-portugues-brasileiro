msgid "CULTURE_FEUDAL@HERO_SKILL@FEUDAL_LORD@DESCRIPTION"
msgstr "While army leader, all non-{GLOBAL.HeroConcept} units in army have:[bulletlist][bullet/]-{HS_FEUDAL_LORD_UPKEEP_MOD>ResolvedUpkeepModifier}% base {GLOBAL.UnitUpkeepConcept.Hyperlink}[/bulletlist]"

msgid "CULTURE_FEUDAL@HERO_SKILL@FEUDAL_LORD@NAME"
msgstr "Feudal Lord"

msgid "CULTURE_FEUDAL@HERO_SKILL_1@DESCRIPTION"
msgstr "Gain {GLOBAL.PROPERTIES.STAND_TOGETHER.Hyperlink}."

msgid "CULTURE_FEUDAL@HERO_SKILL_1@NAME"
msgstr "Army Respite"

msgid "CULTURE_FEUDAL@HERO_SKILL_1@PROPERTY@DESCRIPTION"
msgstr "Heals +{hp} <<m:{GLOBAL.HitPointConcept.Hyperlink}>> at the end of battle."

msgid "CULTURE_FEUDAL@HERO_SKILL_2@ABILITY@DESCRIPTION"
msgstr "Target friendly unit gains {GLOBAL.PROPERTIES.STEADFAST.Hyperlink} for {STEADFAST_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "CULTURE_FEUDAL@HERO_SKILL_2@DESCRIPTION"
msgstr "Gains the {GLOBAL.PROPERTIES.HS_UNDYIND_LOYALTY.Hyperlink} ability."

msgid "CULTURE_FEUDAL@HERO_SKILL_2@NAME"
msgstr "Undying Loyalty"

msgid "CULTURE_FEUDAL@HERO_SKILL_3@DESCRIPTION"
msgstr "Adjacent friendly units have:[bulletlist][bullet/]+{HS_FEUDAL_COMMANDER_DAMAGE>ResolvedMultiplier}% damage[bullet/]+{HS_FEUDAL_COMMANDER_STAT>BONUS>DEFENSE>Armor} {GLOBAL.DefenseConcept.Hyperlink}[/bulletlist]"

