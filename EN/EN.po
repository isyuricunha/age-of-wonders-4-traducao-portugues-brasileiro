msgid "INTERFACE@DIPLOMACY@ALIGNMENT_AGENDA_DESCRIPTION"
msgstr "The {GLOBAL.HighConcept.Hyperlink} Culture has an {GLOBAL.AlignmentConcept.Hyperlink} Agenda, which grants bonuses for the following alignment levels:[bulletlist][bullet/][reputation8/] Pure Good: {citystabilitybonus} {GLOBAL.CityStabilityConcept.Hyperlink} in all <<m:{GLOBAL.CityConcept.Hyperlink}>>.[bullet/][reputation4/] Neutral: {foodbonus} {GLOBAL.FoodConcept.Hyperlink} and {productionbonus} {GLOBAL.StructureProductionConcept.Hyperlink} per {GLOBAL.CityStabilityConcept.Hyperlink} level above Neutral in all <<m:{GLOBAL.CityConcept.Hyperlink}>>.[bullet/][reputation0/] Pure Evil: <<m:{GLOBAL.UnitConcept.Hyperlink}>> start {GLOBAL.CombatConcept.Hyperlink} in an {GLOBAL.PROPERTIES.AWAKENED.Hyperlink} state.[/bulletlist]"

msgid "INTERFACE@DIPLOMACY@ALIGNMENT_AGENDA_HYPERLINK"
msgstr "[hyperlink,GLOBAL.AlignmentAgendaConcept]Alignment Agenda[/hyperlink]"

msgid "INTERFACE@DIPLOMACY@ALIGNMENT_DESCRIPTION"
msgstr "Determines how <<m:{GLOBAL.IndependentCityConcept.Hyperlink}>> and other <<m:{GLOBAL.EmpireConcept.Hyperlink}>> see you. Affected by {GLOBAL.LeaderConcept.Hyperlink} traits and various actions.[br/][br/]Affects relations with <<m:{GLOBAL.IndependentCityConcept.Hyperlink}>> and <<m:{GLOBAL.EmpireConcept.Hyperlink}>> with Neutral or better Alignment. In addition a [reputation6/] Good Alignment (or better) will increase the chance of positive random events occurring, while an [reputation2/] Evil Alignment (or worse) will make negative random events more likely.[br/][br/]{GLOBAL.HighConcept.Hyperlink} Culture has an {GLOBAL.AlignmentAgendaConcept.Hyperlink}.[br/][br/]{GLOBAL.EmpireRelationConcept.Hyperlink} for each Alignment level: [bulletlist][bullet/]{PureGoodMinValue} to {PureGoodMaxValue}: [reputation8/]Pure Good: {PureGoodRelationValue} [goodRelation/][bullet/]{VeryGoodMinValue} to {VeryGoodMaxValue}: [reputation7/]Very Good: {VeryGoodRelationValue} [goodRelation/][bullet/]{GoodMinValue} to {GoodMaxValue}: [reputation6/]Good: {GoodRelationValue} [goodRelation/][bullet/]{NeutralMaxValue} to {NeutralMinValue}: [reputation4/]Neutral: No effects[bullet/]{EvilMaxValue} to {EvilMinValue}: [reputation2/]Evil: {EvilRelationValue} [badRelation/][bullet/]{VeryEvilMaxValue} to {VeryEvilMinValue}: [reputation1/]Very Evil: {VeryEvilRelationValue} [badRelation/][bullet/]{PureEvilMaxValue} to {PureEvilMinValue}: [reputation0/]Pure Evil: {PureEvilRelationValue} [badRelation/][/bulletlist]"

msgid "INTERFACE@DIPLOMACY@ALIGNMENT_HYPERLINK"
msgstr "[hyperlink,GLOBAL.AlignmentConcept]Alignment[/hyperlink]"

