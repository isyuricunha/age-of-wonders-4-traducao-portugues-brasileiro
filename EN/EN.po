msgstr "After the {GLOBAL.ColtLoreConcept.Hyperlink} betrayed {TSR_WINNING_PLAYER}, they were wiped out within {TSR_DGC_STRUCTURE}. Now the Deepglitter Chambers are under control of {TSR_WINNING_PLAYER}!"

msgid "DLC@GIANTKINGS@TSR_DGC@NOTE_PLAYER_WON_HEADER"
msgstr "{TSR_WINNING_PLAYER} has claimed {TSR_DGC_STRUCTURE}!"

