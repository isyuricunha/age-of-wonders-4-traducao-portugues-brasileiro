msgid "DLC@GIANTKINGS@REALM_TRAIT@TSR_SET_03@NAME"
msgstr "TSR Set: Glory of Myrrida (DO NOT SHIP THIS)"

msgid "DLC@GIANTKINGS@RELIC@FLOWROCK_CORNUCOPIA@DESCRIPTION"
msgstr "[bulletlist][bullet/]Unlocks the production of the {GLOBAL.STRUCTURE_UPGRADES.GIANT_FORUM_SPI.Hyperlink} {GLOBAL.SpecialImprovementConcept.Hyperlink} in your <<m:{GLOBAL.CityConcept.Hyperlink}>>.[bullet/]The {GLOBAL.STRUCTURE_UPGRADES.GIANT_FORUM_SPI.Hyperlink} receives the following buffs:[bulletlist][bullet/]{IntProdBonus} {GLOBAL.StructureProductionConcept.Hyperlink} income.[bullet/]{IntFoodBonus} {GLOBAL.FoodConcept.Hyperlink} per adjacent {GLOBAL.FarmConcept.Hyperlink} or {GLOBAL.ForesterConcept.Hyperlink}.[bullet/]Counts as a {GLOBAL.FarmConcept.Hyperlink} and {GLOBAL.ForesterConcept.Hyperlink} in addition to its other types.[/bulletlist][/bulletlist]"

msgid "DLC@GIANTKINGS@RELIC@FLOWROCK_CORNUCOPIA@LORE"
msgstr "“I pledge my protection to the survivors[br/]Of the Urwilderness’ clutches[br/]To herd them is my charge, to feed them, my duty”"

msgid "DLC@GIANTKINGS@RELIC@FLOWROCK_CORNUCOPIA@NAME"
msgstr "Flowrock Cornucopia^n"

msgid "DLC@GIANTKINGS@RELIC@FLOWROCK_CREST@DESCRIPTION"
msgstr "[bulletlist][bullet/]Unlocks the production of the {GLOBAL.STRUCTURE_UPGRADES.GIANT_FORUM_SPI.Hyperlink} {GLOBAL.SpecialImprovementConcept.Hyperlink} in your <<m:{GLOBAL.CityConcept.Hyperlink}>>.[bullet/]The {GLOBAL.STRUCTURE_UPGRADES.GIANT_FORUM_SPI.Hyperlink} receives the following buffs:[bulletlist][bullet/]{IntProdBonus} {GLOBAL.StructureProductionConcept.Hyperlink} income.[bullet/]{IntGoldBonus} {GLOBAL.GoldConcept.Hyperlink} per adjacent {GLOBAL.MineConcept.Hyperlink} or {GLOBAL.QuarryConcept.Hyperlink}.[bullet/]Counts as a {GLOBAL.MineConcept.Hyperlink} in addition to its other types.[/bulletlist][/bulletlist]"

msgid "DLC@GIANTKINGS@RELIC@FLOWROCK_CREST@LORE"
msgstr "“The shelter I carve bears the weight of civilization[br/]I shall build grand and I shall build firm[br/]In richness all dwell who enter my halls”"

msgid "DLC@GIANTKINGS@RELIC@FLOWROCK_CREST@NAME"
msgstr "Flowrock Crest^n"

msgid "DLC@GIANTKINGS@RELIC@FLOWROCK_SCALES@DESCRIPTION"
msgstr "[bulletlist][bullet/]Unlocks the production of the {GLOBAL.STRUCTURE_UPGRADES.GIANT_FORUM_SPI.Hyperlink} {GLOBAL.SpecialImprovementConcept.Hyperlink} in your <<m:{GLOBAL.CityConcept.Hyperlink}>>.[bullet/]The {GLOBAL.STRUCTURE_UPGRADES.GIANT_FORUM_SPI.Hyperlink} receives the following buffs:[bulletlist][bullet/]{IntProdBonus} {GLOBAL.StructureProductionConcept.Hyperlink} income.[bullet/]{IntKnowledgeBonus} {GLOBAL.KnowledgeConcept.Hyperlink} per adjacent {GLOBAL.ConduitConcept.Hyperlink} or {GLOBAL.ResearchPostConcept.Hyperlink}.[bullet/]Counts as a {GLOBAL.ConduitConcept.Hyperlink} and {GLOBAL.ResearchPostConcept.Hyperlink} in addition to its other types.[/bulletlist][/bulletlist]"

msgid "DLC@GIANTKINGS@RELIC@FLOWROCK_SCALES@LORE"
msgstr "“Where equality reigns among races, large and small[br/]With wisdom I must forge and hammer the law[br/]All this I swear by the blood of Gudfjalla[br/]Let the Titans be the judges of this Giant King”"

msgid "DLC@GIANTKINGS@RELIC@FLOWROCK_SCALES@NAME"
msgstr "Flowrock Scales^n"

msgid "DLC@GIANTKINGS@RELIC@LITHORITE_GLOBE@DESCRIPTION"
msgstr "[bulletlist][bullet/]Unlocks Eternal Studies in your <<m:{GLOBAL.CityConcept.Hyperlink}>>, which converts the city's {GLOBAL.StructureProductionConcept.Hyperlink} into {GLOBAL.KnowledgeConcept.Hyperlink}.[/bulletlist]"

