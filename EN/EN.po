msgstr "\"Their fear is their demise. Only through strife [devotedact/] are true warriors forged!\" [evilact/]"

msgid "DLC@WAYSOFWAR@PICKUPS_STRATEGIC@IMPERIUM_PICKUP@DESCRIPTION"
msgstr "An opulent sculpture made from exotic materials. Ready to adorn a ruler's residence and inspire legends.[br/][br/]Moving your army onto it will instantly grant you some {GLOBAL.ImperiumConcept.Hyperlink}."

msgid "DLC@WAYSOFWAR@PICKUPS_STRATEGIC@IMPERIUM_PICKUP@NAME"
msgstr "Prestigious Statue"

msgid "DLC@WAYSOFWAR@PROSPERITY_DRAGON@BESTOW_MASK_OF_PROSPERITY@DESCRIPTION"
msgstr "Link to target friendly unit:[bulletlist][bullet/]Damage sustained by the linked unit is dealt to this unit as well with a {BESTOW_MASK_OF_PROSPERITY_MARTYRDOM>ResolvedDamageMultiplier}% reduction.[bullet/]At the start of each turn, this unit and the linked unit gain {GLOBAL.PROPERTIES.GRACE.Hyperlink}.[/bulletlist][br/]While active, gain {GLOBAL.PROPERTIES.RECALL_MASK_OF_PROSPERITY.Hyperlink}."

msgid "DLC@WAYSOFWAR@PROSPERITY_DRAGON@BESTOW_MASK_OF_PROSPERITY@NAME"
msgstr "Bestow Mask of Prosperity"

msgid "DLC@WAYSOFWAR@PROSPERITY_DRAGON@BESTOW_MASK_OF_PROSPERITY@STATUS_DESCRIPTION_CASTER"
msgstr "[bulletlist][bullet/]This unit is absorbing the damage of another unit, reduced by {amount}%.[bullet/]At the start of each turn, gain {GLOBAL.PROPERTIES.GRACE.Hyperlink}.[/bulletlist]"

msgid "DLC@WAYSOFWAR@PROSPERITY_DRAGON@BESTOW_MASK_OF_PROSPERITY@STATUS_DESCRIPTION_TARGET"
msgstr "[bulletlist][bullet/]Damage taken is being shared with another unit with a {amount}% reduction.[bullet/]At the start of each turn, gain {GLOBAL.PROPERTIES.GRACE.Hyperlink}.[/bulletlist]"

msgid "DLC@WAYSOFWAR@PROSPERITY_DRAGON@BESTOW_MASK_OF_PROSPERITY@STATUS_NAME"
msgstr "Mask of Prosperity"

msgid "DLC@WAYSOFWAR@PROSPERITY_DRAGON@RADIANT_REBUKE@NAME"
msgstr "Radiant Rebuke"

msgid "DLC@WAYSOFWAR@PROSPERITY_DRAGON@RADIANT_SPIKE@DESCRIPTION"
msgstr "Damage target unit, adjacent enemies take {RADIANT_SPIKE_CIRCLE_TARGETER>ResolvedEffectMultiplier}% damage."

msgid "DLC@WAYSOFWAR@PROSPERITY_DRAGON@RADIANT_SPIKE@NAME"
msgstr "Radiant Spike"

msgid "DLC@WAYSOFWAR@PROSPERITY_DRAGON@RAIN_OF_PROSPERITY@DESCRIPTION"
msgstr "All friendly units:[bulletlist][bullet/]Gain {GLOBAL.PROPERTIES.GRACE.Hyperlink}[bullet/]Loses one random {GLOBAL.NegativeStatusEffectConcept.Hyperlink}[/bulletlist]"

msgid "DLC@WAYSOFWAR@PROSPERITY_DRAGON@RAIN_OF_PROSPERITY@NAME"
msgstr "Rain of Prosperity"

msgid "DLC@WAYSOFWAR@PROSPERITY_DRAGON@RECALL_MASK_OF_PROSPERITY@DESCRIPTION"
msgstr "[bulletlist][bullet/]Break the {GLOBAL.PROPERTIES.BESTOW_MASK_OF_PROSPERITY_CASTER.Hyperlink} link.[bullet/]Consume all {GLOBAL.PROPERTIES.GRACE.Hyperlink} stacks. Then per consumed stack:[bulletlist][bullet/]Heal {RECALL_MASK_OF_PROSPERITY_HEAL_EFFECT>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Gain a stack of {GLOBAL.PROPERTIES.REGENERATION.Hyperlink}.[/bulletlist][/bulletlist]"

msgid "DLC@WAYSOFWAR@PROSPERITY_DRAGON@RECALL_MASK_OF_PROSPERITY@NAME"
msgstr "Recall Mask of Prosperity"

msgid "DLC@WAYSOFWAR@RACE_NAMES@RACE1@NAME"
msgstr "Othrakar"

