msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@ARCHON_OBSERVATORY@EVIL2"
msgstr "{EventHero} gains enough experience to level up [xp/] twice."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@ARCHON_OBSERVATORY@EVIL3"
msgstr "{EventHero} gains enough experience to level up [xp/] once."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@ARCHON_OBSERVATORY_01@AFFINITY_CHOICE_ASTRAL@FAILLURE"
msgstr "You were unable to untangle the destiny written in the stars."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@ARCHON_OBSERVATORY_01@AFFINITY_CHOICE_ASTRAL@HEADER"
msgstr "Decipher the prophecies written in the stars."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@ARCHON_OBSERVATORY_01@AFFINITY_CHOICE_ASTRAL@SUCCESS"
msgstr "You predicted the tactics of the enemy."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@ARCHON_OBSERVATORY_01@AFFINITY_CHOICE_ORDER@FAILLURE"
msgstr "The Archons did not answer your call."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@ARCHON_OBSERVATORY_01@AFFINITY_CHOICE_ORDER@HEADER"
msgstr "Call upon the Archons to empower you."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@ARCHON_OBSERVATORY_01@AFFINITY_CHOICE_ORDER@SUCCESS"
msgstr "The Archons have blessed you with the power to smite your enemies."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@ARCHON_OBSERVATORY_01@AFFINITY_CHOICE_SHADOW@FAILLURE"
msgstr "The shadows did not answer your call."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@ARCHON_OBSERVATORY_01@AFFINITY_CHOICE_SHADOW@HEADER"
msgstr "Embrace the shadows to curse your enemies."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@ARCHON_OBSERVATORY_01@AFFINITY_CHOICE_SHADOW@SUCCESS"
msgstr "Your enemies are weakened against your attacks."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@ARCHON_OBSERVATORY_02@AFFINITY_CHOICE_ASTRAL@FAILLURE"
msgstr "The energies of the Astral Plane are unaltered."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@ARCHON_OBSERVATORY_02@AFFINITY_CHOICE_ASTRAL@HEADER"
msgstr "Draw strength from the Astral Plane."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@ARCHON_OBSERVATORY_02@AFFINITY_CHOICE_ASTRAL@SUCCESS"
msgstr "The energy of the Astral Plane flows into your hero."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@ARCHON_OBSERVATORY_02@AFFINITY_CHOICE_ORDER@FAILLURE"
msgstr "You are unworthy of the blessing of Order."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@ARCHON_OBSERVATORY_02@AFFINITY_CHOICE_ORDER@HEADER"
msgstr "Show your devotion to Order."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@ARCHON_OBSERVATORY_02@AFFINITY_CHOICE_ORDER@SUCCESS"
msgstr "The light of Order blesses your hero."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@ARCHON_OBSERVATORY_02@AFFINITY_CHOICE_SHADOW@FAILLURE"
msgstr "Your troops hear an echoing laugh saying: \"Memento mori.\""

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@ARCHON_OBSERVATORY_02@AFFINITY_CHOICE_SHADOW@HEADER"
msgstr "Defy death."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@ARCHON_OBSERVATORY_02@AFFINITY_CHOICE_SHADOW@SUCCESS"
msgstr "A dark energy embraces your hero."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@ARCHON_OBSERVATORY_03@AFFINITY_CHOICE_ASTRAL@FAILLURE"
msgstr "Your troops are unable to understand the lesson."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@ARCHON_OBSERVATORY_03@AFFINITY_CHOICE_ASTRAL@HEADER"
msgstr "Teach a lesson in magic unraveling."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@ARCHON_OBSERVATORY_03@AFFINITY_CHOICE_ASTRAL@SUCCESS"
msgstr "Your troops have learned the magic cantrip."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@ARCHON_OBSERVATORY_03@AFFINITY_CHOICE_ORDER@FAILLURE"
msgstr "Light has not deemed you worthy."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@ARCHON_OBSERVATORY_03@AFFINITY_CHOICE_ORDER@HEADER"
msgstr "Become the embodiment of light."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@ARCHON_OBSERVATORY_03@AFFINITY_CHOICE_ORDER@SUCCESS"
msgstr "Light shines from within you."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@ARCHON_OBSERVATORY_03@AFFINITY_CHOICE_SHADOW@FAILLURE"
msgstr "The undead are unperturbed by your magic."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@ARCHON_OBSERVATORY_03@AFFINITY_CHOICE_SHADOW@HEADER"
msgstr "Claim the souls of the undead."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@ARCHON_OBSERVATORY_03@AFFINITY_CHOICE_SHADOW@SUCCESS"
msgstr "The souls of the undead hear your claim."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@HOUSE_FIRST_MEET_ARCHITECT@AFFINITY_CHOICE_ASTRAL@FAILURE"
msgstr "You accidentally err, the audience, alas, abhors the awkward aberration."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@HOUSE_FIRST_MEET_ARCHITECT@AFFINITY_CHOICE_ASTRAL@HEADER"
msgstr "Attempt to impress the denizens of {EventHouse.Name} with an elaborate address."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@HOUSE_FIRST_MEET_ARCHITECT@AFFINITY_CHOICE_ASTRAL@SUCCESS"
msgstr "You animate all in attendance to award you abounding applause!"

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@HOUSE_FIRST_MEET_ARCHITECT@AFFINITY_CHOICE_CHAOS@FAILURE"
msgstr "You miscalculate, causing quite a cacophony of castigating critiques."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@HOUSE_FIRST_MEET_ARCHITECT@AFFINITY_CHOICE_CHAOS@HEADER"
msgstr "Attempt to impress the denizens of {EventHouse.Name} with a cathartic oration."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@HOUSE_FIRST_MEET_ARCHITECT@AFFINITY_CHOICE_CHAOS@SUCCESS"
msgstr "Your conclusions casually instigate the crowd to clamor with accolades!"

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@HOUSE_FIRST_MEET_ARCHITECT@AFFINITY_CHOICE_MATERIUM@FAILURE"
msgstr "You make a monumental mistake and are most miserably mocked for it."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@HOUSE_FIRST_MEET_ARCHITECT@AFFINITY_CHOICE_MATERIUM@HEADER"
msgstr "Attempt to impress the denizens of {EventHouse.Name} with an elaborate monologue."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@HOUSE_FIRST_MEET_ARCHITECT@AFFINITY_CHOICE_MATERIUM@SUCCESS"
msgstr "Your moving message masterfully impresses the immersed masses!"

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@HOUSE_FIRST_MEET_ARCHITECT@AFFINITY_CHOICE_NATURE@FAILURE"
msgstr "You bungle on nasty minutiae and the notables remain unmoved."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@HOUSE_FIRST_MEET_ARCHITECT@AFFINITY_CHOICE_NATURE@HEADER"
msgstr "Attempt to impress the denizens of {EventHouse.Name} with an elaborate narration."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@HOUSE_FIRST_MEET_ARCHITECT@AFFINITY_CHOICE_NATURE@SUCCESS"
msgstr "Your enticing narrative earns you unanimous renown!"

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@HOUSE_FIRST_MEET_ARCHITECT@AFFINITY_CHOICE_ORDER@FAILURE"
msgstr "You err in your ode and offend all onlookers."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@HOUSE_FIRST_MEET_ARCHITECT@AFFINITY_CHOICE_ORDER@HEADER"
msgstr "Attempt to impress the denizens of {EventHouse} with an elaborate oration."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@HOUSE_FIRST_MEET_ARCHITECT@AFFINITY_CHOICE_ORDER@SUCCESS"
msgstr "You obtain a standing ovation with your opus!"

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@HOUSE_FIRST_MEET_ARCHITECT@AFFINITY_CHOICE_SHADOW@FAILURE"
msgstr "You sadly stammer, so the spectators stiffly scoff at these sorry solicitations."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@HOUSE_FIRST_MEET_ARCHITECT@AFFINITY_CHOICE_SHADOW@HEADER"
msgstr "Attempt to impress the denizens of {EventHouse.Name} with an elaborate speech."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@HOUSE_FIRST_MEET_ARCHITECT@AFFINITY_CHOICE_SUCCESS@SUCCESS"
msgstr "You succeed in sweetening the citizenry with your sweeping spiel!"

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@HOUSE_OPINION_ARCHITECT_01@AFFINITY_CHOICE_ASTRAL@FAILURE"
msgstr "Oops. The rational approach only added fuel to the fire, causing <<P:EventHouseLord>> to storm off."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@HOUSE_OPINION_ARCHITECT_01@AFFINITY_CHOICE_ASTRAL@HEADER"
msgstr "Attempt to calm <<o:EventHouseLord>> vindictive excitement with rational arguments."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@HOUSE_OPINION_ARCHITECT_01@AFFINITY_CHOICE_ASTRAL@SUCCESS"
msgstr "{EventHouseLord.Name} concedes and leaves you <<o:EventHouseLord>> plans."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@HOUSE_OPINION_ARCHITECT_01@AFFINITY_CHOICE_CHAOS@FAILURE"
msgstr "Outraged, the Architect {HouseLord.Title} condemns the suggestion."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@HOUSE_OPINION_ARCHITECT_01@AFFINITY_CHOICE_CHAOS@HEADER"
msgstr "Motivate {EventHouseLord} to destroy the monument of <<o:EventHouseLord>> rival."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@HOUSE_OPINION_ARCHITECT_01@AFFINITY_CHOICE_CHAOS@SUCCESS"
msgstr "You inspire <<P:EventHouseLord>> to revel in destruction and win <<o.EventHouseLord>> favor."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@HOUSE_OPINION_ARCHITECT_01@AFFINITY_CHOICE_MATERIUM@FAILURE"
msgstr "Your proposals greatly offend the Architect {EventHouseLord.Title}."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@HOUSE_OPINION_ARCHITECT_01@AFFINITY_CHOICE_MATERIUM@HEADER"
msgstr "Attempt to redesign <<o:EventHouseLord>> design to be more affordable."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@HOUSE_OPINION_ARCHITECT_01@AFFINITY_CHOICE_MATERIUM@SUCCESS"
msgstr "Your redesigns are so efficient you even impress yourself!"

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@HOUSE_OPINION_ARCHITECT_01@AFFINITY_CHOICE_NATURE@FAILURE"
msgstr "Unconvinced and insulted, {EventHouseLord} steps away with an indignant chortle."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@HOUSE_OPINION_ARCHITECT_01@AFFINITY_CHOICE_NATURE@HEADER"
msgstr "Attempt to convince {EventHouseLord} to plant orchards for a fraction of the cost."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@HOUSE_OPINION_ARCHITECT_01@AFFINITY_CHOICE_NATURE@SUCCESS"
msgstr "The well fed people of {EventHouse} praise their leader and gladly share the bounty!"

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@HOUSE_OPINION_ARCHITECT_01@AFFINITY_CHOICE_ORDER@FAILURE"
msgstr "{EventHouseLord} follows your instructions, but only makes <<r:EventHouseLord>> look bad in the council..."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@HOUSE_OPINION_ARCHITECT_01@AFFINITY_CHOICE_ORDER@HEADER"
msgstr "Attempt to educate {EventHouseLord} how to regain authority through statecraft."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@HOUSE_OPINION_ARCHITECT_01@AFFINITY_CHOICE_ORDER@SUCCESS"
msgstr "Inspired, {EventHouseLord} outplays <<o:EventHouseLord>> rival and showers you with praise.\""

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@HOUSE_OPINION_ARCHITECT_01@AFFINITY_CHOICE_SHADOW@FAILURE"
msgstr "{EventHouseLord} finds out and furiously stops you!"

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@HOUSE_OPINION_ARCHITECT_01@AFFINITY_CHOICE_SHADOW@HEADER"
msgstr "Secretly sell <<g:plans^m,EventHouseLord>> behind <<o:EventHouseLord>> back."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@HOUSE_OPINION_ARCHITECT_01@AFFINITY_CHOICE_SHADOW@SUCCESS"
msgstr "You dupe <<P:EventHouseLord>> and <<o:EventHouseLord>> rival pays a handsome price."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@STACKENCOUNTER_EVENT@ANGELIC_ENVOY"
msgstr "All units in the army are restored [hp/] to full HP."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@STRUCTURE_GUARD_ARCHITECT_01@AFFINITY_ASTRAL@FAILURE"
msgstr "The debate ends up in a heated argument and the {EventUnit} demands you leave—now!"

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@STRUCTURE_GUARD_ARCHITECT_01@AFFINITY_CHAOS@FAILURE"
msgstr "<<P:EventUnit>> hits off the bit, inspects the result and panics, \"No, no, no! That ruined it!\""

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@STRUCTURE_GUARD_ARCHITECT_01@AFFINITY_CHOICE@FAILURE"
msgstr "It seems you yet lack the didactic acumen required to persuade the guards."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@STRUCTURE_GUARD_ARCHITECT_01@AFFINITY_CHOICE@HEADER"
msgstr "Test your affinity expertise to enlighten and expel the guards."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@STRUCTURE_GUARD_ARCHITECT_01@AFFINITY_CHOICE@SUCCESS"
msgstr "Enlightened, the {EventUnit} departs to report your teachings back at home."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@STRUCTURE_GUARD_ARCHITECT_01@AFFINITY_NATURE@FAILURE"
msgstr "After a moment of restless sitting, <<p:EventUnit>> throws up <<o:EventUnit>> hands and grunts, \"It's useless!\""

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@STRUCTURE_GUARD_ARCHITECT_01@AFFINITY_ORDER@FAILURE"
msgstr "Indignant, the artist shrugs and chips on..."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@STRUCTURE_GUARD_ARCHITECT_01@AFFINITY_SHADOW@FAILURE"
msgstr "Irritated, <<p:EventUnit>> plugs <<o:EventUnit>> ears and ignores you."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@STRUCTURE_GUARD_ARCHITECT_02@AFFINITY_CHOICE_ASTRAL@HEADER"
msgstr "Attempt to philosophically debate the definition of completion."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@STRUCTURE_GUARD_ARCHITECT_02@AFFINITY_CHOICE_ASTRAL@SUCCESS"
msgstr "After a brief back and forth, <<p:EventUnit>> concedes: 'Completion' exists only in the mind of the maker."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@STRUCTURE_GUARD_ARCHITECT_02@AFFINITY_CHOICE_CHAOS@HEADER"
msgstr "Attempt to convince the {EventUnit} to pursue a quick fix: If it ain't fixed, break it!"

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@STRUCTURE_GUARD_ARCHITECT_02@AFFINITY_CHOICE_CHAOS@SUCCESS"
msgstr "The {EventUnit} ponders your suggestion for a space, hits off the bit, and laughs aloud, \"That's it!\""

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@STRUCTURE_GUARD_ARCHITECT_02@AFFINITY_CHOICE_MATERIUM@HEADER"
msgstr "Enact your Materium inspired hand to finish the piece."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@STRUCTURE_GUARD_ARCHITECT_02@AFFINITY_CHOICE_MATERIUM@SUCCESS"
msgstr "Baffled, the {EventUnit} gives up and leaves you the piece."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@STRUCTURE_GUARD_ARCHITECT_02@AFFINITY_CHOICE_NATURE@HEADER"
msgstr "Guide the {EventUnit} to meditate on the beauty of nature for inspiration."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@STRUCTURE_GUARD_ARCHITECT_02@AFFINITY_CHOICE_NATURE@SUCCESS"
msgstr "After an instance of breathing, the {EventUnit} jumps up with new insights and showers you with gold!"

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@STRUCTURE_GUARD_ARCHITECT_02@AFFINITY_CHOICE_ORDER@HEADER"
msgstr "Attempt to restore order and reveal the obvious."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@STRUCTURE_GUARD_ARCHITECT_02@AFFINITY_CHOICE_ORDER@SUCCESS"
msgstr "Your omniscience inspires productivity across the realm!"

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@STRUCTURE_GUARD_ARCHITECT_02@AFFINITY_CHOICE_SHADOW@HEADER"
msgstr "Attempt to discourage the {EventUnit} to continue and just retire."

msgid "DLC@ARCHONPROPHECY@TRIGGER@TOOLTIP@STRUCTURE_GUARD_ARCHITECT_02@AFFINITY_CHOICE_SHADOW@SUCCESS"
msgstr "Dispirited, <<p:EventUnit>> abandons all and packs up."

msgid "DLC@ARCHONPROPHECY@TUTORIAL@MONUMENTS_AND_WONDERSTONE@DESCRIPTION"
msgstr "Tutorial on Monuments and Wonderstone"

msgid "DLC@ARCHONPROPHECY@TUTORIAL@MONUMENTS_AND_WONDERSTONE@TITLE"
msgstr "[monument/]Monuments"

msgid "DLC@ARCHONPROPHECY@TUTORIAL@MONUMENTS_AND_WONDERSTONE@TITLE02"
msgstr "[wonderstone/]Wonderstone"

msgid "DLC@ARCHONPROPHECY@TUTORIAL@MONUMENTS_AND_WONDERSTONE_PAGE01@DESCRIPTION"
msgstr "<<m:{GLOBAL.ArchitectConcept.Hyperlink}>> can build <<m:{GLOBAL.ArchitectMonumentConcept.Hyperlink}>>:[br/] powerful <<m:{GLOBAL.ProvinceImprovementConcept.Hyperlink}>> dedicated to the <<m:{GLOBAL.AffinityConcept.Hyperlink}>>."

msgid "DLC@ARCHONPROPHECY@TUTORIAL@MONUMENTS_AND_WONDERSTONE_PAGE01@INSTRUCTIONS"
msgstr "Once built, <<m:{GLOBAL.ArchitectMonumentConcept.Hyperlink}>> start at tier I and can be upgraded up to tier IV.[br/]Each tier built grants their units {GLOBAL.PROPERTIES.AFFINITY_INCARNATE_UNIT_PROPERTY.Hyperlink}, while higher tiers grant <<m:{GLOBAL.AffinityConcept.Hyperlink}>> and empower the city they are attached to."

msgid "DLC@ARCHONPROPHECY@TUTORIAL@MONUMENTS_AND_WONDERSTONE_PAGE01@INSTRUCTIONS_CONTROLLER"
msgstr "Once built, <<m:{GLOBAL.ArchitectMonumentConcept.Hyperlink}>> start at tier I and can be upgraded up to tier IV.[br/]Each tier built grants their units {GLOBAL.PROPERTIES.AFFINITY_INCARNATE_UNIT_PROPERTY.Hyperlink}, while higher tiers grant <<m:{GLOBAL.AffinityConcept.Hyperlink}>> and empower the city they are attached to."

msgid "DLC@ARCHONPROPHECY@TUTORIAL@MONUMENTS_AND_WONDERSTONE_PAGE02@DESCRIPTION"
msgstr "<<m:{GLOBAL.ArchitectMonumentConcept.Hyperlink}>> cost {GLOBAL.WonderStoneConcept.Hyperlink} to build and upgrade.[br/][br/]Wonderstone can be obtained from Magic Materials:[bulletlist][bullet/]Surveying provinces that contain <<m:{GLOBAL.MagicMaterialConcept.Hyperlink}>> using your Surveyor <<m:{GLOBAL.PROPERTIES.SCOUT_UNIT.Hyperlink}>>. [bullet/]Any <<m:{GLOBAL.MagicMaterialConcept.Hyperlink}>> your empire obtains will grant you a steady income of {GLOBAL.WonderStoneConcept.Hyperlink} each {GLOBAL.TurnConcept.Hyperlink}.[/bulletlist]"

