msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL1@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{amount1} {GLOBAL.GoldConcept.Hyperlink}[bullet/]+{amount2} {GLOBAL.GoldConcept.Hyperlink} per adjacent Dungeon {GLOBAL.ProvinceConcept.Hyperlink}.[bullet/]+{amount3} {GLOBAL.BindingEssenceConcept.Hyperlink} per adjacent Dungeon {GLOBAL.ProvinceConcept.Hyperlink}[bullet/]Counts as a {GLOBAL.MineConcept.Hyperlink}[/bulletlist]"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL1@NAME"
msgstr "[mine/] Underground Vault"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL2@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{amount1} {GLOBAL.StructureProductionConcept.Hyperlink} per adjacent Dungeon {GLOBAL.ProvinceConcept.Hyperlink}.[bullet/]+{amount2} {GLOBAL.UnitProductionConcept.Hyperlink} per adjacent Dungeon {GLOBAL.ProvinceConcept.Hyperlink}.[bullet/]Allows the drafting of the {GLOBAL.UNITS.CLAY_ARBALEST.Hyperlink}, {GLOBAL.UNITS.CLAY_CHARGER.Hyperlink}, and {GLOBAL.UNITS.CLAY_DEFENDER.Hyperlink} units.[bullet/]Counts as a {GLOBAL.QuarryConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL2@NAME"
msgstr "[quarry/] Clay Forge"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL3@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{amount1} {GLOBAL.FortificationHealthConcept.Hyperlink} per adjacent Dungeon {GLOBAL.ProvinceConcept.Hyperlink}.[bullet/]+{amount2} {GLOBAL.CityStabilityConcept.Hyperlink} per adjacent Dungeon {GLOBAL.ProvinceConcept.Hyperlink}.[bullet/]A {GLOBAL.UNITS.CLAY_ARBALEST.Hyperlink}, {GLOBAL.UNITS.CLAY_CHARGER.Hyperlink}, or a {GLOBAL.UNITS.CLAY_DEFENDER.Hyperlink} joins combat on your side when fighting in this city's domain (does not function in water or lava).[bullet/]Counts as a {GLOBAL.QuarryConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL3@EFFECT_DESCRIPTION"
msgstr "Randomly adds a {GLOBAL.UNITS.CLAY_ARBALEST.Hyperlink}, {GLOBAL.UNITS.CLAY_CHARGER.Hyperlink}, or a {GLOBAL.UNITS.CLAY_DEFENDER.Hyperlink} unit to this fight."

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL3@NAME"
msgstr "[quarry/] Silent Barracks"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL4@DESCRIPTION"
msgstr "Target enemy army:[bulletlist][bullet/]Sustains {amount} {GLOBAL.PhysicalDamageConcept.Hyperlink}, doubled if cast on a Dungeon {GLOBAL.ProvinceConcept.Hyperlink}.[bullet/]For {duration} {GLOBAL.WorldMapConcept.Hyperlink} {GLOBAL.TurnConcept}, at the start of combat units in this army become {GLOBAL.PROPERTIES.SLOWED.Hyperlink} for {duration2} {GLOBAL.TurnConcept}.[/bulletlist]"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL4@NAME"
msgstr "Dungeon Hazard"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL4@PROP_DESCRIPTION"
msgstr "At the start of combat, this unit becomes {GLOBAL.PROPERTIES.SLOWED.Hyperlink} for {SLOWED_EFFECT_DESCRIPTION>NumTurns} {GLOBAL.TurnConcept}."

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL5@DESCRIPTION"
msgstr "Enchanted units gain:[bulletlist][bullet/]{GLOBAL.PROPERTIES.CAVE_WALK.Hyperlink}[bullet/]While in the Underground:[bulletlist][bullet/]+{amount1} {GLOBAL.DefenseConcept.Hyperlink}[bullet/]+{amount2} {GLOBAL.ResistanceConcept.Hyperlink}[/bulletlist][bullet/]While above ground:[bulletlist][bullet/]Deal +{amount3}% damage[/bulletlist][/bulletlist]"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL5@NAME"
msgstr "Raiders of the Deep"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL5@PROP_DESCRIPTION"
msgstr "This unit has:[bulletlist][bullet/]{GLOBAL.PROPERTIES.CAVE_WALK.Hyperlink}[bullet/]While in the Underground:[bulletlist][bullet/]+{amount1} {GLOBAL.DefenseConcept.Hyperlink}[bullet/]+{amount2} {GLOBAL.ResistanceConcept.Hyperlink}[/bulletlist][bullet/]While above ground:[bulletlist][bullet/]Deal +{amount3}% damage[/bulletlist][/bulletlist]"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SPI@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{amount} {GLOBAL.KnowledgeConcept.Hyperlink} [bullet/]Every {GLOBAL.TurnConcept.Hyperlink}, a {GLOBAL.ProvinceConcept.Hyperlink} in the {GLOBAL.CityConcept.Hyperlink}'s {GLOBAL.DomainConcept.Hyperlink}:[bulletlist][bullet/]Gains {GLOBAL.DungeonConcept.Hyperlink}.[/bulletlist][bullet/]Gain +{amount2} {GLOBAL.StructureProductionConcept.Hyperlink} per adjacent Dungeon {GLOBAL.ProvinceConcept.Hyperlink}.[bullet/]Counts as a {GLOBAL.ResearchPostConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SPI@NAME"
msgstr "[researchpost/] Dungeoneering Conclave"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@TOME@DESCRIPTION"
msgstr "Build a grand Dungeon Underground, fill it with structures that will enrich you, and protect it with eternal clay soldiers and traps."

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@TOME@LORE_DESCRIPTION"
msgstr "\"Rulers who build lasting empires understand the value of the Underground. Let others bicker on the surface as their empires crumble under the harsh light of the sun, whilst your city sprawls across endless caverns and grottoes. Build mighty Dungeons and armies of clay to thwart those who dare venture Underground. Let time pass above, for your legacy in the depths is eternal.\""

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@TOME@NAME"
msgstr "Tome of the Dungeon Depths"

