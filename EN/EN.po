msgid "DLC@EMPIRESANDASHES@WORLD_TRAIT@SEALS_VICTORY@DEFAULT@DESCRIPTION"
msgstr "Seals are present on this realm. Capturing them will lead to a {GLOBAL.SealsVictoryConcept.Hyperlink}."

msgid "DLC@EMPIRESANDASHES@WORLD_TRAIT@SEALS_VICTORY@DEFAULT@NAME"
msgstr "World Seals"

msgid "DLC@EMPIRESANDASHES@WORLD_TRAIT@SEALS_VICTORY@DORMANT@DESCRIPTION"
msgstr "Seals are present on this realm. Capturing them will lead to a {GLOBAL.SealsVictoryConcept.Hyperlink}.[br/]- More Seal Points are required to achieve victory."

msgid "DLC@EMPIRESANDASHES@WORLD_TRAIT@SEALS_VICTORY@DORMANT@NAME"
msgstr "World Seals (Dormant)"

msgid "DLC@EMPIRESANDASHES@WORLD_TRAIT@SEALS_VICTORY@SCARCE@DESCRIPTION"
msgstr "Seals are present on this realm. Capturing them will lead to a {GLOBAL.SealsVictoryConcept.Hyperlink}.[br/]- Fewer Seals are present on this realm."

msgid "DLC@EMPIRESANDASHES@WORLD_TRAIT@SEALS_VICTORY@SCARCE@NAME"
