msgid "DIPLOMACY@DISCUSSION@TASKDURATION"
msgstr "Task Duration: {Duration}[turn/]"

msgid "DIPLOMACY@DISCUSSION_COMPLIMENT@DESCRIPTION"
msgstr "Compliment the other Ruler. This will improve your relations with them by {RelationValue}[goodRelation/]."

msgid "DIPLOMACY@DISCUSSION_COMPLIMENT@NAME"
msgstr "Compliment"

msgid "DIPLOMACY@DISCUSSION_DECLARATIONOFFRIENDSHIP@DESCRIPTION"
msgstr "Declare your Friendship with another {GLOBAL.LeaderConcept.Hyperlink} publicly.[br/][br/]A modifier that slowly increases towards {RelationValue}[goodRelation/] will be added to your [hyperlink,GLOBAL.EmpireRelationConcept]relations[/hyperlink] with the Ruler. Any <<m:{GLOBAL.CasusBelliConcept.Hyperlink}>> gained against that Ruler will be reduced by {Reduction}%. When two Rulers declare Friendship with each other, each active diplomatic treaty they have increases the maximum relations bonus by {RelationBonus}[goodRelation/], up to {MaxRelationBonus}[goodRelation/] in total.[br/][br/]Maintaining a declaration costs {cost} upkeep per {GLOBAL.TurnConcept.Hyperlink}, which increases by {costScale} for each additional declaration.[br/][br/]Declarations can be made and ended through <<m:{GLOBAL.PronouncementsConcept.Hyperlink}>>."

msgid "DIPLOMACY@DISCUSSION_DECLARATIONOFFRIENDSHIP@EVENT_OTHER"
msgstr "Other Rulers declared a friendship"

msgid "DIPLOMACY@DISCUSSION_DECLARATIONOFFRIENDSHIP@EVENT_RECEIVER"
msgstr "A Friendship with you was declared"

msgid "DIPLOMACY@DISCUSSION_DECLARATIONOFFRIENDSHIP@EVENT_SELF"
msgstr "You declared a Friendship"

msgid "DIPLOMACY@DISCUSSION_DECLARATIONOFFRIENDSHIP@HYPERLINK"
msgstr "[hyperlink,GLOBAL.DeclFriendshipConcept]Declaration of Friendship[/hyperlink]"

msgid "DIPLOMACY@DISCUSSION_DECLARATIONOFFRIENDSHIP@INFOPANEL"
msgstr "{PlayerB.Name} has declared a [hyperlink,GLOBAL.DeclFriendshipConcept]Friendship[/hyperlink] with {Target.Name}. Over time their relations may improve and grow into an {GLOBAL.DSAllianceConcept.Hyperlink}. Declaring a [hyperlink,GLOBAL.DeclFriendshipConcept]Friendship[/hyperlink] with {Target.Name} can strengthen your relations with {PlayerB.Name}, while a [hyperlink,GLOBAL.DeclRivalryConcept]Rivalry[/hyperlink] can turn {PlayerB.Name} against you."

msgid "DIPLOMACY@DISCUSSION_DECLARATIONOFFRIENDSHIP@INFOPANEL_SELF"
msgstr "{PlayerB.Name} has declared a [hyperlink,GLOBAL.DeclFriendshipConcept]Friendship[/hyperlink] with you. Over time your relations may improve and grow into an {GLOBAL.DSAllianceConcept.Hyperlink}."

msgid "DIPLOMACY@DISCUSSION_DECLARATIONOFFRIENDSHIP@NAME"
msgstr "Declaration of Friendship"

msgid "DIPLOMACY@DISCUSSION_DECLARATIONOFRIVALRY@DESCRIPTION"
msgstr "Declare a Rivalry with another {GLOBAL.LeaderConcept.Hyperlink} publicly.[br/][br/]A modifier that slowly decreases towards {RelationValue}[badRelation/] will be added to your [hyperlink,GLOBAL.EmpireRelationConcept]relations[/hyperlink] with the Ruler. Any <<m:{GLOBAL.CasusBelliConcept.Hyperlink}>> gained against that Ruler will be increased by {Increase}%. However, making treaties becomes impossible and any existing treaties will be broken.[br/][br/]Additionally a rising {GLOBAL.RivalJustificationConcept.Hyperlink} modifier will be gained, which increases by {casusbellibonusperturn}[casusBelli/] per {GLOBAL.TurnConcept.Hyperlink} up to {casusbellibonusmax}[casusBelli/].[br/][br/]Maintaining a declaration costs {cost} upkeep per {GLOBAL.TurnConcept.Hyperlink}, which increases by {costScale} for each additional declaration.[br/][br/]Declarations can be made and ended through <<m:{GLOBAL.PronouncementsConcept.Hyperlink}>>."

msgid "DIPLOMACY@DISCUSSION_DECLARATIONOFRIVALRY@EVENT_OTHER"
msgstr "Other Rulers declared a rivalry"

msgid "DIPLOMACY@DISCUSSION_DECLARATIONOFRIVALRY@EVENT_RECEIVER"
msgstr "A Rivalry was declared on you"

msgid "DIPLOMACY@DISCUSSION_DECLARATIONOFRIVALRY@EVENT_SELF"
msgstr "You declared a Rivalry"

msgid "DIPLOMACY@DISCUSSION_DECLARATIONOFRIVALRY@HYPERLINK"
msgstr "[hyperlink,GLOBAL.DeclRivalryConcept]Declaration of Rivalry[/hyperlink]"

msgid "DIPLOMACY@DISCUSSION_DECLARATIONOFRIVALRY@INFOPANEL"
msgstr "{HouseALord.Name} has declared a [hyperlink,GLOBAL.DeclRivalryConcept]Rivalry[/hyperlink] with {HouseBLord.Name}. Over time their relations may deteriorate and lead to {GLOBAL.WarConcept.Hyperlink}. Declaring a [hyperlink,GLOBAL.DeclRivalryConcept]Rivalry[/hyperlink] with {HouseBLord.FirstName} can strengthen your relations with the {HouseALord.FirstName}, while a [hyperlink,GLOBAL.DeclFriendshipConcept]Friendship[/hyperlink] can turn {HouseALord.FirstName} against you."

msgid "DIPLOMACY@DISCUSSION_DECLARATIONOFRIVALRY@INFOPANEL_SELF"
msgstr "{HouseBLord.Name} has declared a [hyperlink,GLOBAL.DeclRivalryConcept]Rivalry[/hyperlink] with you. Over time your relations may deteriorate and lead to {GLOBAL.WarConcept.Hyperlink}."

msgid "DIPLOMACY@DISCUSSION_DECLARATIONOFRIVALRY@NAME"
msgstr "Declaration of Rivalry"

msgid "DIPLOMACY@DISCUSSION_DETERIORATETHIRDPARTY@NAME"
msgstr "Sabotage Relations"

msgid "DIPLOMACY@DISCUSSION_END_DECLARATIONOFFRIENDSHIP@DESCRIPTION"
msgstr "Ends your declaration of friendship. This also breaks the opposing Ruler's declaration of friendship if they have one, and any gains in relations from the declaration will be lost."

msgid "DIPLOMACY@DISCUSSION_END_DECLARATIONOFFRIENDSHIP@EVENT_OTHER"
msgstr "Other Rulers ended their friendship"

msgid "DIPLOMACY@DISCUSSION_END_DECLARATIONOFFRIENDSHIP@EVENT_RECEIVER"
msgstr "A Friendship with you was ended"

msgid "DIPLOMACY@DISCUSSION_END_DECLARATIONOFFRIENDSHIP@EVENT_SELF"
msgstr "You ended your Friendship"

msgid "DIPLOMACY@DISCUSSION_END_DECLARATIONOFFRIENDSHIP@INFOPANEL"
msgstr "{HouseALord.Name}'s [hyperlink,GLOBAL.DeclFriendshipConcept]Friendship[/hyperlink] with {HouseBLord.Name} has ended. Their relations may deteriorate because of this."

msgid "DIPLOMACY@DISCUSSION_END_DECLARATIONOFFRIENDSHIP@INFOPANEL_SELF"
msgstr "Your [hyperlink,GLOBAL.DeclFriendshipConcept]Friendship[/hyperlink] with {HouseBLord.Name} has ended."

msgid "DIPLOMACY@DISCUSSION_END_DECLARATIONOFFRIENDSHIP@NAME"
msgstr "End Declaration of Friendship"

msgid "DIPLOMACY@DISCUSSION_END_DECLARATIONOFRIVALRY@DESCRIPTION"
msgstr "End your rivalry with this Ruler. Any losses in relations will be regained and treaties will become available again if they have not declared you to be their rival."

msgid "DIPLOMACY@DISCUSSION_END_DECLARATIONOFRIVALRY@EVENT_OTHER"
msgstr "Other Rulers ended their rivalry"

msgid "DIPLOMACY@DISCUSSION_END_DECLARATIONOFRIVALRY@EVENT_RECEIVER"
msgstr "A Rivalry with you ended"

msgid "DIPLOMACY@DISCUSSION_END_DECLARATIONOFRIVALRY@EVENT_SELF"
msgstr "You ended your Rivalry"

msgid "DIPLOMACY@DISCUSSION_END_DECLARATIONOFRIVALRY@INFOPANEL"
msgstr "{HouseALord.Name}'s [hyperlink,GLOBAL.DeclRivalryConcept]Rivalry[/hyperlink] with {HouseBLord.Name} has ended. This may improve their relations."

msgid "DIPLOMACY@DISCUSSION_END_DECLARATIONOFRIVALRY@INFOPANEL_SELF"
msgstr "Your [hyperlink,GLOBAL.DeclRivalryConcept]Rivalry[/hyperlink] with {HouseBLord.Name} has ended. This may improve your relations."

msgid "DIPLOMACY@DISCUSSION_END_DECLARATIONOFRIVALRY@NAME"
msgstr "End Declaration of Rivalry"

msgid "DIPLOMACY@DISCUSSION_FABRICATECASUSBELLI@DESCRIPTION"
msgstr "[hyperlink,GLOBAL.FabricatedCasusBelliConcept]Fabricates[/hyperlink] a [casusBelli/][hyperlink,GLOBAL.CasusBelliConcept]Grievance[/hyperlink] ({GrievanceValue}[casusBelli/]) against the opponent. This will enable you to start a [hyperlink,GLOBAL.WarJustificationConcept]justified[/hyperlink] {GLOBAL.WarConcept.Hyperlink} as normal, but it cannot be forgiven and will have a negative impact on your [hyperlink,GLOBAL.EmpireRelationConcept]relations[/hyperlink].[br/][br/]Trying to [hyperlink,GLOBAL.DenounceConcept]denounce[/hyperlink] an opposing {GLOBAL.LeaderConcept.Hyperlink} using a Fabricated {GLOBAL.CasusBelliConcept.Hyperlink} will cause them to have a [hyperlink,GLOBAL.CasusBelliConcept]Grievance[/hyperlink] against you!"

msgid "DIPLOMACY@DISCUSSION_FABRICATECASUSBELLI@NAME"
msgstr "Fabricate Grievance"

msgid "DIPLOMACY@DISCUSSION_IMPROVETHIRDPARTY@NAME"
msgstr "Support Relations"

msgid "DIPLOMACY@DISCUSSION_INSULT@DESCRIPTION"
msgstr "Insult the other Ruler. This will grant them a {GLOBAL.CasusBelliConcept.Hyperlink} ({Points}[casusBelli/]) against you."

msgid "DIPLOMACY@DISCUSSION_INSULT@NAME"
msgstr "Insult"

