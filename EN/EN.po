msgstr "[bulletlist][bullet/]+{DamageBonus}% damage.[bullet/]{Stunchance}% chance of this unit suffering {GLOBAL.PROPERTIES.STUNNED.Hyperlink} for {duration} <<m:{GLOBAL.TurnConcept}>> after completing this attack.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@OVERCHARGED@NAME"
msgstr "Overcharged"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@OVERCHARGE_ABILITY@DESCRIPTION"
msgstr "Target friendly unit:[bulletlist][bullet/]Gains {GLOBAL.PROPERTIES.OVERCHARGED.Hyperlink} until end of combat.[bullet/]Heals {HS_ARTIFICERS_KIT_HEAL>NumHitpointsToRestore} {GLOBAL.TemporaryHitPointConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@OVERCHARGE_ABILITY@DESCRIPTION_CONSTRUCT"
msgstr "Target friendly {GLOBAL.PROPERTIES.CONSTRUCT.Hyperlink} unit:[bulletlist][bullet/]Gains {GLOBAL.PROPERTIES.OVERCHARGED.Hyperlink} until end of combat.[bullet/]Heals {HS_ARTIFICERS_KIT_HEAL>NumHitpointsToRestore} {GLOBAL.TemporaryHitPointConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@OVERCHARGE_ABILITY@NAME"
msgstr "Overcharge"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@PROPERTY_AMMO_1@DESCRIPTION"
msgstr "Next attack:[bulletlist][bullet/]Inflicts {sunderingcount} {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink}.[bullet/]Ignores {PIERCING>MODIFIERS>ResolvedArmor}% of the target's {GLOBAL.DefenseConcept.Hyperlink}[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@PROPERTY_AMMO_1@NAME"
msgstr "Ammunition: Sundering Shot"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@PROPERTY_AMMO_2@DESCRIPTION"
msgstr "Next attack:[bulletlist][bullet/]Inflicts {DamageBonus} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Random hexes in the target Area gain {GLOBAL.OnFireConcept.Hyperlink}[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@PROPERTY_AMMO_2@NAME"
msgstr "Ammunition: Incendiary Shot"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@PROPERTY_AMMO_2@TARGETERS_DESCRIPTION"
msgstr "Random hexes in or near target area gain {GLOBAL.OnFireConcept.Hyperlink}"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@PROPERTY_AMMO_3@DESCRIPTION"
msgstr "Next attack:[bulletlist][bullet/]Inflicts {Bleedcount} {GLOBAL.PROPERTIES.BLEEDING.Hyperlink}[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@PROPERTY_AMMO_3@NAME"
msgstr "Ammunition: Shrapnel Shot"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@PROVINCE_IMPROVEMENT@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{baseamount} {GLOBAL.UnitProductionConcept.Hyperlink}.[bullet/]+{bonusamount} {GLOBAL.UnitProductionConcept.Hyperlink} per adjacent {GLOBAL.QuarryConcept.Hyperlink} or {GLOBAL.MineConcept.Hyperlink} {GLOBAL.ProvinceConcept.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.CONSTRUCT.Hyperlink} Units produced in the owner city gain +{rankamount}[medalGold/] Ranks.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@PROVINCE_IMPROVEMENT@NAME"
msgstr "[quarry/] War Foundry"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL1@DESCRIPTION"
msgstr "An armored {GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink} with a powerful tri-barreled cannon able to load and fire specialized shells at significant range."

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL1@NAME"
msgstr "Ironclad^n"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL2@DESCRIPTION"
msgstr "Units in a {PINNING_BARRAGE_UNIT_TARGETER_CIRCLE>AREA>Radius}-hex radius:[bulletlist][bullet/]Suffer {PINNING_BARRAGE_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Become {GLOBAL.PROPERTIES.MARKED.Hyperlink}.[bullet/]Have a base {IMMOBILIZED_RESISTANCE>ResolvedStrength}% chance of becoming {GLOBAL.PROPERTIES.IMMOBILIZED.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL2@NAME"
msgstr "Pinning Barrage"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL3@DESCRIPTION"
msgstr "Grants enchanted units:[bulletlist][bullet/]The {GLOBAL.PROPERTIES.OVERCHARGE_ABILITY.Hyperlink} ability, which can grant a {GLOBAL.PROPERTIES.CONSTRUCT.Hyperlink} unit {GLOBAL.PROPERTIES.OVERCHARGED.Hyperlink} until the end of battle.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL3@NAME"
msgstr "Tuning Kits"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL3@PROP_DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]The {GLOBAL.PROPERTIES.OVERCHARGE_ABILITY.Hyperlink} ability.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL4@DESCRIPTION"
msgstr "At the start of the battle, gain {GLOBAL.UNITS.GREAT_BOMBARD_UNIT.Hyperlink} on the attacker's side until the end of battle. [bulletlist][bullet/]Great Bombard is an immobile {GLOBAL.PROPERTIES.SIEGECRAFT_UNIT.Hyperlink} {GLOBAL.UnitConcept.Hyperlink}.[bullet/] Only one type of Siegecraft unit can be brought into {GLOBAL.CombatConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL4@NAME"
msgstr "Construct Great Bombard"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL5@DESCRIPTION"
msgstr "Grants enchanted units:[bulletlist][bullet/]+{TEMPERED_METALS_DEFENSE>DEF_MOD>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL5@NAME"
msgstr "Warding Metals"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL5@PROP_DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]+{TEMPERED_METALS_DEFENSE>DEF_MOD>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL6@DESCRIPTION"
msgstr "Units in {DESTABILIZED_MANA_CORE_CIRCLE_TARGETER_MARKED>AREA>Radius}-hex radius are {GLOBAL.PROPERTIES.MARKED.Hyperlink}. After {time} {GLOBAL.TurnConcept.Hyperlink} the Mana Core explodes inflicting:[bulletlist][bullet/]{amount} {GLOBAL.PhysicalDamageConcept.Hyperlink}[bullet/]{amount2} {GLOBAL.LightningDamageConcept.Hyperlink}.[bullet/]{amount3}% base chance of receiving {GLOBAL.PROPERTIES.DISRUPTION_TOOLTIP_PROPERTY.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL6@FLAG@DESCRIPTION"
msgstr "This hex will be struck for {amount} {GLOBAL.PhysicalDamageConcept.Hyperlink} and {amount} {GLOBAL.LightningDamageConcept.Hyperlink} at the start of the owner's [turn/] [hyperlink,GLOBAL.TurnConcept]Next Turn[/hyperlink]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@SKILL6@NAME"
msgstr "Destabilized Mana Core"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Call upon the power of mighty machines and obliterate your enemies with powerful barrages."

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@TOME@LORE_AUTHOR"
msgstr "Edward Portsmith, Last Dreadnought of the Commonwealth"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@TOME@LORE_DESCRIPTION"
msgstr "\"Dreadnought technologies are unmatched on the battlefield. Envision a fusion of steel and craftsmanship, dominating everything in its path. Explosions shatter the earth and rain down fire on your foes. An astounding sight to behold. Truly, when an Ironclad rolls into battle, the fight is already over.\""

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@TOME@NAME"
msgstr "Tome of the Dreadnought"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@UNIT2@NAME"
msgstr "Great Bombard"

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@ABILITY02@DESCRIPTION"
msgstr "Up to {MAGICAL_DISRUPTION_COMBAT_UNIT_AUTO_SPELL>MinCastCount} random enemies:[bulletlist][bullet/]Sustain {MAGICAL_DISRUPTION_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Have a base {DISRUPTION_RESISTANCE>ResolvedStrength}% chance of becoming {GLOBAL.PROPERTIES.DISRUPTION_TOOLTIP_PROPERTY.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@ABILITY02@NAME"
msgstr "Magical Disruption"

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@ABILITY03@DESCRIPTION"
msgstr "[bulletlist][bullet/]Each friendly unit within {DISPELLING_FIELD_TARGETER>AREA>Radius} hexes has one of their <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>> dispelled.[bullet/]For each unit that had a status dispelled this way this unit gains:[bulletlist][bullet/]{GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} for {STRENGTHENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]{GLOBAL.PROPERTIES.STATUS_PROTECTION.Hyperlink} for {STATUS_PROTECTION_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@ABILITY03@NAME"
msgstr "Dispelling Field"

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@HERO_SKILL@DESCRIPTION"
msgstr "Physical Melee and Ranged attacks gain {DISRUPTION_RESISTANCE>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.DISRUPTION_TOOLTIP_PROPERTY.Hyperlink}."

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@HERO_SKILL@NAME"
msgstr "Master of Disruption"

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@SKILL1@DESCRIPTION"
msgstr "Target {GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink} {GLOBAL.UnitConcept.Hyperlink}:[bulletlist][bullet/]Has a base {ASTRAL_SEVERANCE_RESISTANCE_CHECK>ResolvedStrength}% chance of being killed.[bullet/]If unsuccessful, inflicts {GLOBAL.PROPERTIES.DISRUPTION_TOOLTIP_PROPERTY.Hyperlink} and {amount} stacks of {GLOBAL.PROPERTIES.DECAYING.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@SKILL1@NAME"
msgstr "Astral Severance"

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@SKILL2@COMBAT_PROPERTY_DESCRIPTION"
msgstr "Enemy <<m:{GLOBAL.SpellConcept.Hyperlink}>> cost +{amount1}% <<m:{GLOBAL.CombatCastingPointConcept.Hyperlink}>> in {GLOBAL.CombatConcept.Hyperlink} in <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacent to a Spellward structure."

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@SKILL2@DESCRIPTION"
msgstr "Conjures a Spellward on an empty hex in the target {GLOBAL.ProvinceConcept.Hyperlink}. This structure:[bulletlist][bullet/]Functions as a {GLOBAL.SpellJammerConcept.Hyperlink} for this and adjacent provinces.[bullet/]Provides vision in {hex}-hex radius.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@SKILL2@NAME"
