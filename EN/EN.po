msgstr "{TSR_DGC_CHAMBER_02_EXCAVATED}/1 Second Chamber Excavated"

msgid "DLC@GIANTKINGS@TSR_DGC@OBJECTIVE_04"
msgstr "{TSR_DGC_CHAMBER_02_DEFENDERS_CURRENT}/{TSR_DGC_CHAMBER_02_DEFENDERS_TOTAL} Second Chamber Defenders Slain"

msgid "DLC@GIANTKINGS@TSR_DGC@OBJECTIVE_05"
msgstr "{TSR_DGC_CHAMBER_03_EXCAVATED}/1 Third Chamber Excavated"

msgid "DLC@GIANTKINGS@TSR_DGC@OBJECTIVE_06"
msgstr "{TSR_DGC_CHAMBER_03_COMPLETED}/1 {TSR_DGC_STRUCTURE} Explored"

