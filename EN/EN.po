msgid "INTERFACE@TEXT@CITY_INCOME"
msgstr "City Income"

msgid "INTERFACE@TEXT@CITY_INCOME_DESCRIPTION"
msgstr "City Income is the amount of <<m:{GLOBAL.ResourceConcept.Hyperlink}>> a {GLOBAL.CityConcept.Hyperlink} generates each {GLOBAL.TurnConcept.Hyperlink}."

msgid "INTERFACE@TEXT@CITY_INCOME_HYPERLINK"
