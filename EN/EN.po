msgstr "Owner's units heal +{amount3}<<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>."

msgid "TOME_CYCLES@SKILL5@SUMMER_NAME"
msgstr "Cycle of Seasons: Summer"

msgid "TOME_CYCLES@SKILL5@WINTER_NAME"
msgstr "Cycle of Seasons: Winter"

msgid "TOME_CYCLES@SKILL5@WINTER_PROP_DESCRIPTION"
msgstr "Owner's enemies sustain {amount} {GLOBAL.FrostDamageConcept.Hyperlink}."

msgid "TOME_CYCLES@SKILL6@DESCRIPTION"
msgstr "Makes attacks of enchanted units:[bulletlist][bullet/]Gain a base {LIFE_SEED_RESISTANCE_CHECK>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.LIFE_SEED_ON_DEATH.Hyperlink} for {LIFE_SEED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Deal +{BLOOMING_PROJECTILES_DAMAGE_MULTIPLIER>ResolvedMultiplier}% damage against {GLOBAL.PROPERTIES.DECAYING.Hyperlink} units.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CYCLES@SKILL6@NAME"
msgstr "Blooming Imbuement"

msgid "TOME_CYCLES@SKILL6@PROP_DESCRIPTION"
msgstr "Unit's attacks have:[bulletlist][bullet/]A base {LIFE_SEED_RESISTANCE_CHECK>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.LIFE_SEED_ON_DEATH.Hyperlink} for {LIFE_SEED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]+{BLOOMING_PROJECTILES_DAMAGE_MULTIPLIER>ResolvedMultiplier}% damage against {GLOBAL.PROPERTIES.DECAYING.Hyperlink} units.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CYCLES@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Master the natural cycles of life and death and specialize in debuffing enemies and healing allies."

msgid "TOME_CYCLES@TOME@LORE_AUTHOR"
msgstr "Serena, Elven Wizard of Life"

msgid "TOME_CYCLES@TOME@LORE_DESCRIPTION"
msgstr "\"There is a cycle to all things. The beast feeds upon its prey, gaining strength. The corpse rots, nourishing the land. Life gives way to death, which, in turn, gives way to more life. Master this ebb and flow, and you will find you can manipulate both its gifts as well as the toll it demands!\""

msgid "TOME_CYCLES@TOME@NAME"
msgstr "Tome of Cycles"

msgid "TOME_CYCLES@UNIT@NAME"
msgstr "Druid of the Cycle"

msgid "TOME_DEMON_GATE@HERO_SKILL@DESCRIPTION"
msgstr "While this unit is the army leader, friendly non-{GLOBAL.PROPERTIES.FIEND} and non-{GLOBAL.HeroConcept} units in the army:[bulletlist][bullet/]Transform into Tier I <<m:{GLOBAL.PROPERTIES.FIEND.Hyperlink}>> upon death in battle.[bullet/]Have a small chance of transforming into Tier II <<m:{GLOBAL.PROPERTIES.FIEND.Hyperlink}>> instead.[/bulletlist]"

msgid "TOME_DEMON_GATE@HERO_SKILL@NAME"
msgstr "Demonic Anthem"

msgid "TOME_DEMON_GATE@HERO_SKILL@PROP_DESCRIPTION"
msgstr "When this unit dies, it transforms into a Tier I {GLOBAL.PROPERTIES.FIEND}. It has a small chance of transforming into a Tier II {GLOBAL.PROPERTIES.FIEND} instead."

msgid "TOME_DEMON_GATE@PASSIVE@DESCRIPTION"
msgstr "When a friendly non-{GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink} unit dies in battle, it has a {chance}% chance of spawning a Tier {tier} {GLOBAL.PROPERTIES.FIEND.Hyperlink} until the end of battle."

msgid "TOME_DEMON_GATE@PASSIVE@NAME"
msgstr "Death's Gateway"

msgid "TOME_DEMON_GATE@PASSIVE@PROPERTY@DESCRIPTION"
msgstr "When this unit dies, it has a {chance}% chance of spawning a Tier {tier} {GLOBAL.PROPERTIES.INFERNAL_FIEND.Hyperlink} until the end of battle."

msgid "TOME_DEMON_GATE@SKILL1@DESCRIPTION"
msgstr "Target city loses {amount} {GLOBAL.PopulationConcept.Hyperlink} and spawns a {GLOBAL.UNITS.BALOR.Hyperlink}, a mythic unit that wreaks havoc on your foes."

msgid "TOME_DEMON_GATE@SKILL1@NAME"
msgstr "Summon Balor"

msgid "TOME_DEMON_GATE@SKILL2@DESCRIPTION"
msgstr "Target one of your {GLOBAL.IndependentCityConcept.Hyperlink} <<m:{GLOBAL.PvEVassalConcept.Hyperlink}>>:[bulletlist][bullet/]Summon {summon} random <<m:{GLOBAL.PROPERTIES.FIEND.Hyperlink}>> under your control, one will be Tier III and the other Tier IV.[bullet/]The {GLOBAL.PvEVassalConcept.Hyperlink} loses:[bulletlist][bullet/]A {GLOBAL.VassalagePhaseConcept.Hyperlink} diplomatic stage.[bullet/]{pop} {GLOBAL.PopulationConcept.Hyperlink}.[/bulletlist][/bulletlist][br/]Cannot be cast on a {GLOBAL.PactOfVassalageLvl-3Concept.Hyperlink}."

msgid "TOME_DEMON_GATE@SKILL2@NAME"
msgstr "Demonic Summoning"

msgid "TOME_DEMON_GATE@SKILL3@DESCRIPTION"
msgstr "Two {GLOBAL.PROPERTIES.FIEND.Hyperlink} units of the same Tier in the target army fight each other. One dies and the other transforms into a {GLOBAL.PROPERTIES.FIEND.Hyperlink} with a Tier one level higher than before."

msgid "TOME_DEMON_GATE@SKILL3@DIALOG_SUBHEADER"
msgstr "Several demons emerge through the soot and flames, vying for the honor of serving you."

msgid "TOME_DEMON_GATE@SKILL3@NAME"
msgstr "Fight for Power"

msgid "TOME_DEMON_GATE@SKILL4@DESCRIPTION"
msgstr "Target friendly unit explodes and enemy units within {SACRIFICIAL_SLAUGHTER_UNIT_TARGETER_CIRCLE>AREA>Radius} hexes:[bulletlist][bullet/]Sustain {SACRIFICIAL_SLAUGHTER_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} plus {SACRIFICIAL_SLAUGHTER_TIER_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} per Tier of the sacrificed unit.[bullet/]Suffer one random {GLOBAL.NegativeStatusEffectConcept.Hyperlink} per Tier of the sacrificed unit.[/bulletlist]"

msgid "TOME_DEMON_GATE@SKILL4@NAME"
msgstr "Sacrificial Slaughter"

msgid "TOME_DEMON_GATE@SKILL5@DESCRIPTION"
msgstr "Target {GLOBAL.ProvinceConcept.Hyperlink}:[bulletlist][bullet/]Enemy <<m:{GLOBAL.UnitConcept.Hyperlink}>> suffer -{amount} {GLOBAL.FireResistanceConcept.Hyperlink} for {duration} {GLOBAL.WorldMapConcept.Hyperlink} {GLOBAL.TurnConcept}.[bullet/]The provinces gain {GLOBAL.AshlandsConcept.Hyperlink}.[bullet/]The provinces lose {GLOBAL.RiverConcept.Hyperlink}, {GLOBAL.FertilePlainsConcept.Hyperlink}, {GLOBAL.SwampConcept.Hyperlink}, {GLOBAL.SnowConcept.Hyperlink}, {GLOBAL.FrozenWasteConcept.Hyperlink}, {GLOBAL.SandConcept.Hyperlink}, {GLOBAL.CavernFloorConcept.Hyperlink}, and {GLOBAL.GloomTerrainConcept.Hyperlink}.[bullet/]Summon a {GLOBAL.UNITS.MAGMA_SPIRIT.Hyperlink} on the targeted hex.[/bulletlist]"

msgid "TOME_DEMON_GATE@SKILL5@NAME"
msgstr "Abyssal Flames"

msgid "TOME_DEMON_GATE@SKILL5@PROP_DESCRIPTION"
msgstr "{ABYSSAL_FLAMES_FIRE_RESISTANCE>REDUCTION>Fire} {GLOBAL.FireResistanceConcept.Hyperlink}"

msgid "TOME_DEMON_GATE@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Open rifts to summon <<m:{GLOBAL.PROPERTIES.FIEND.Hyperlink}>> and burn the world in your wake."

msgid "TOME_DEMON_GATE@TOME@LORE_AUTHOR"
msgstr "Kruul Blightlord, Chaos Prince"

msgid "TOME_DEMON_GATE@TOME@LORE_DESCRIPTION"
msgstr "\"Those who master the art of summoning will always have ready allies, though perhaps not entirely willing ones. Demons may be terrifying to some, but, if properly summoned, they are the most valuable minion a Godir can find. Of course, they would rather rend the flesh from your face if they could... but they can not, so the point is moot!\""

msgid "TOME_DEMON_GATE@TOME@NAME"
msgstr "Tome of the Demon Gate"

msgid "TOME_DEMON_GATE@UNIT@NAME"
msgstr "Balor^n"

msgid "TOME_DEMON_GATE@UNIT_ABILITY_1@DESCRIPTION"
msgstr "When this unit dies, units in a {DEATH_EXPLOSION_UNIT_TARGETER>AREA>Radius}-hex radius:[bulletlist][bullet/]Sustain {DEATH_EXPLOSION_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}. Halved for friendly units.[bullet/]Become {GLOBAL.PROPERTIES.BURNING.Hyperlink} for {BURNING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "TOME_DEMON_GATE@UNIT_ABILITY_1@NAME"
msgstr "Death Explosion"

msgid "TOME_DEMON_GATE@UNIT_ABILITY_2@DESCRIPTION"
msgstr "Target unit:[bulletlist][bullet/]Sustains damage.[bullet/]Gains {GLOBAL.PROPERTIES.BERSERK.Hyperlink} and {GLOBAL.PROPERTIES.CHAOS_BRAND_ON_DEATH.Hyperlink} until the end of battle.[/bulletlist][br/]Cannot affect Heroes, Fiends or Siegecraft units."

msgid "TOME_DEMON_GATE@UNIT_ABILITY_2@NAME"
msgstr "Chaos Brand"

msgid "TOME_DEMON_GATE@UNIT_ABILITY_3@DESCRIPTION"
