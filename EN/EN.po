msgstr "Gain {GLOBAL.PROPERTIES.AMMUNITION_INCENDIARY_SHOT_PROPERTY.Hyperlink}"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@ABILITY_AMMO_2@NAME"
msgstr "Load Incendiary Shot"

