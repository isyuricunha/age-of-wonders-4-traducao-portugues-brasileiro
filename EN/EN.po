msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_10@DESCRIPTION"
msgstr "While this unit is in battle, all friendly units gain:[bulletlist][bullet/]Once per turn, when this unit is hit by an attack, the attacker gains a stack of {GLOBAL.PROPERTIES.BURNING.Hyperlink} for {BURNING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_10@NAME"
msgstr "Primordial Pride"

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_10@PROP_DESCRIPTION"
msgstr "Once per turn, when this unit is hit by an attack, the attacker gains a stack of {GLOBAL.PROPERTIES.BURNING.Hyperlink} for {BURNING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "DLC@GIANTKINGS@PRIMORDIAL_UNIT_ABILITY_11@DESCRIPTION"
msgstr "Deals damage to enemy units in a {BURNING_DUST_OBSTACLE_TARGETER_CIRCLE>AREA>Radius}-hex radius."

