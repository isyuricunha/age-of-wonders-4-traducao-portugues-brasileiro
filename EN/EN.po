msgstr "Bloodspring Thicket"

msgid "DLC@THRONESOFBLOOD@MEGAWONDERS_STRATEGIC@THORN_HEART@NAME_OVERRIDE_05"
msgstr "Tanglescream Pulse"

msgid "DLC@THRONESOFBLOOD@META_EMPIRE@ASCENSION_TRAIT@BLOOD_PEST@HERO_TRAIT_DESCRIPTION"
