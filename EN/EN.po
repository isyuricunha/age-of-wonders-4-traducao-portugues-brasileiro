msgid "DLC@GIANTKINGS@RELIC@MENHIR_OF_STONE@LORE"
msgstr "\"Thagnokar fell, ground down like a stone[br/]Myrrida his flesh, Myrrida his bone[br/]Remember, my kindred, our blood that drenched[br/]These hallowed rune-rocks from Titan's Henge\""

msgid "DLC@GIANTKINGS@RELIC@MENHIR_OF_STONE@NAME"
msgstr "Menhir of Rock^n"

msgid "DLC@GIANTKINGS@RELIC@MENHIR_OF_STONE@UNIT_PROP@DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]+{RELIC_UNIT_EXTRA_DMG>ResolvedMultiplier}% damage.[bullet/]+{RELIC_UNIT_EXTRA_RESISTANCE>DEF_MOD>Armor} {GLOBAL.DefenseConcept.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.EXPEDITED_MOUNTAIN.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.CAVE_WALK.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.STATUS_EFFECT_IMMUNITY_BLEEDING.Hyperlink}[/bulletlist]"

msgid "DLC@GIANTKINGS@RELIC@MENHIR_OF_STONE@UNIT_PROP@NAME"
msgstr "Blessing of Rock"

msgid "DLC@GIANTKINGS@RELIC@MENHIR_OF_STORMS@DESCRIPTION"
msgstr "[bulletlist][bullet/]Adds {IntRallyPoints} <<m:{GLOBAL.RecruitmentPointsConcept.Hyperlink}>> and the {GLOBAL.UNITS.STORM_GIANT.Hyperlink} unit to the {GLOBAL.RequestMilitaryAidConcept.Hyperlink}.[bullet/]All non-hero <<m:{GLOBAL.PROPERTIES.GIANT.Hyperlink} >> and Demigiants you control gain {GLOBAL.PROPERTIES.TSR_CSP_RELIC_UNIT_PROP.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@RELIC@MENHIR_OF_STORMS@LORE"
msgstr "\"Yet Thagnokar stood, mountain in the storm[br/]His hammer he swung, crushing foe after foe[br/]Draconic distress, celestial woe\""

