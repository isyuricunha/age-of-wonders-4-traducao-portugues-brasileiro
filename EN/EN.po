msgid "TOME_WILD@SKILL3@DIALOG_SUBHEADER_ARCTIC_UNDERGROUND"
msgstr "Several beasts emerge from the frozen caves, answering your call."

msgid "TOME_WILD@SKILL3@DIALOG_SUBHEADER_ASTRAL_BARRENS"
msgstr "Several beasts emerge from the barren wastes, answering your call."

msgid "TOME_WILD@SKILL3@DIALOG_SUBHEADER_COLD"
msgstr "Several beasts emerge from the freezing mists, answering your call."

msgid "TOME_WILD@SKILL3@DIALOG_SUBHEADER_DEFAULT"
msgstr "Several beasts emerge from the wilderness, answering your call."

msgid "TOME_WILD@SKILL3@DIALOG_SUBHEADER_HOT"
msgstr "Several beasts emerge from the burning wastes, answering your call."

msgid "TOME_WILD@SKILL3@DIALOG_SUBHEADER_SUNLESS"
msgstr "Several beasts emerge from the shadowy wastes, answering your call."

msgid "TOME_WILD@SKILL3@DIALOG_SUBHEADER_UNDERGROUND"
msgstr "Several beasts emerge from the shadowy caves, answering your call."

msgid "TOME_WILD@SKILL3@DIALOG_SUBHEADER_UNDERGROUND_FIRE"
msgstr "Several beasts emerge from the fiery caves, answering your call."

msgid "TOME_WILD@SKILL3@DIALOG_SUBHEADER_WATER"
msgstr "Several beasts emerge from beneath the waves, answering your call."

msgid "TOME_WILD@SKILL3@NAME"
msgstr "Call Wild Animal"

msgid "TOME_WILD@SKILL4@DESCRIPTION"
msgstr "A {GLOBAL.PROPERTIES.SUPPORT_UNIT.Hyperlink} that summons and empowers <<m:{GLOBAL.PROPERTIES.ANIMAL.Hyperlink}>>."

msgid "TOME_WILD@SKILL4@NAME"
msgstr "Wildspeaker^f"

msgid "TOME_WILD@SKILL5@DESCRIPTION"
msgstr "Friendly {GLOBAL.PROPERTIES.ANIMAL.Hyperlink} and {GLOBAL.PROPERTIES.CAVALRY_GROUP.Hyperlink} units in a {CALL_OF_THE_WILD_CIRCLE_TARGETER>AREA>Radius}-hex radius gain:[bulletlist][bullet/]{defense} {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink}[bullet/]{damage} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}[/bulletlist]"

msgid "TOME_WILD@SKILL5@NAME"
msgstr "Call of the Wild"

msgid "TOME_WILD@TOME@DESCRIPTION"
msgstr "Walk beside the <<m:{GLOBAL.PROPERTIES.ANIMAL.Hyperlink}>> of nature. Specialize in summoning and buffing <<m:{GLOBAL.PROPERTIES.ANIMAL.Hyperlink}>> and become stronger when standing next to them."

msgid "TOME_WILD@TOME@LORE_AUTHOR"
msgstr "Serena, Elven Wizard of Life"

msgid "TOME_WILD@TOME@LORE_DESCRIPTION"
msgstr "\"It is the beasts that shall inherit the world. Their paws will tread on our graves long after their fangs have ground our bones to dust. Call upon their might, if you dare. Command their ferocity and nourish it, so that you may reap the benefits of this primal power.\""

msgid "TOME_WILD@TOME@NAME"
msgstr "Tome of Beasts"

msgid "TOME_WILD_MAGIC@SKILL1@DESCRIPTION"
msgstr "[bulletlist][bullet/]At the start of battle, the attacker gains {amount} {GLOBAL.UNITS.DEVASTATOR_SPHERE_UNIT.Hyperlink} until the end of battle.[bullet/]<<m:{GLOBAL.UNITS.DEVASTATOR_SPHERE_UNIT.Hyperlink}>> are {GLOBAL.PROPERTIES.SIEGECRAFT_UNIT.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> that can detonate themselves into target obstacles or {GLOBAL.UnitConcept.Hyperlink} to deal massive damage and destroy obstacles.[bullet/]Only one type of Siegecraft unit can be brought into {GLOBAL.CombatConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_WILD_MAGIC@SKILL1@DETONATE@DESCRIPTION"
msgstr "Unit detonates itself. In a {DETONATE_UNIT_TARGETER_CIRCLE>AREA>Radius}-hex radius:[bulletlist][bullet/]Units sustain damage.[bullet/]All obstacles are destroyed.[bullet/]Sets hexes {GLOBAL.OnFireConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_WILD_MAGIC@SKILL1@DETONATE@NAME"
msgstr "Detonate and Devastate"

msgid "TOME_WILD_MAGIC@SKILL1@NAME"
msgstr "Construct Devastator Spheres"

msgid "TOME_WILD_MAGIC@SKILL2@DESCRIPTION"
msgstr "Monstrous {GLOBAL.PROPERTIES.SHOCK_UNIT.Hyperlink} that is used as a living siege weapon."

msgid "TOME_WILD_MAGIC@SKILL2@NAME"
msgstr "Warbreed"

msgid "TOME_WILD_MAGIC@SKILL3@DESCRIPTION"
msgstr "Grants enchanted units:[bulletlist][bullet/]+{FLAMEBURST_WEAPONS_CRITICAL>ResolvedCritChanceBonus}% {GLOBAL.CriticalHitChanceConcept.Hyperlink}.[bullet/]Killing a unit causes it to explode, adjacent enemies:[bulletlist][bullet/]Sustain {FLAMEBURST_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Gain {amount} {GLOBAL.PROPERTIES.BURNING.Hyperlink} for {BURNING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][/bulletlist]"

msgid "TOME_WILD_MAGIC@SKILL3@MODIFIER_DESCRIPTION"
msgstr "Killing a unit causes it to explode, adjacent enemies:[bulletlist][bullet/]Sustain {FLAMEBURST_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Gain {amount} {GLOBAL.PROPERTIES.BURNING.Hyperlink} for {BURNING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "TOME_WILD_MAGIC@SKILL3@NAME"
msgstr "Flameburst Weapons"

msgid "TOME_WILD_MAGIC@SKILL3@PROPERTY_DESCRIPTION"
msgstr "This unit has:[bulletlist][bullet/]+{FLAMEBURST_WEAPONS_CRITICAL>ResolvedCritChanceBonus}% {GLOBAL.CriticalHitChanceConcept.Hyperlink}[bullet/]Killing a unit causes it to explode, adjacent enemies:[bulletlist][bullet/]Sustain {FLAMEBURST_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Gain {amount} {GLOBAL.PROPERTIES.BURNING.Hyperlink} for {BURNING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][/bulletlist]"

msgid "TOME_WILD_MAGIC@SKILL4@DESCRIPTION"
msgstr "[bulletlist][bullet/]At the start of the battle, gain {amount} {GLOBAL.UNITS.WAR_HOUND_UNIT.Hyperlink} units on the attacker's side until the end of battle.[/bulletlist]"

msgid "TOME_WILD_MAGIC@SKILL4@NAME"
msgstr "Unleash the War Hounds"

msgid "TOME_WILD_MAGIC@SKILL6@DESCRIPTION"
msgstr "Target friendly Tier I, II, or III non-{GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink}, non-{GLOBAL.PROPERTIES.CONSTRUCT.Hyperlink} unit:[bulletlist][bullet/]Transforms into a {GLOBAL.UNITS.WARBREED_UNIT.Hyperlink}.[bullet/]Heals {MONSTROUS_REBIRTH_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Dies at the end of combat.[/bulletlist][br][br/]Cannot be used in Water Combat."

msgid "TOME_WILD_MAGIC@SKILL6@NAME"
msgstr "Monstrous Rebirth"

msgid "TOME_WILD_MAGIC@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Gain the means to take cities with overwhelming force. Specialize in <<m:{GLOBAL.SiegeConcept.Hyperlink}>> and dealing damage."

msgid "TOME_WILD_MAGIC@TOME@LORE_AUTHOR"
msgstr "Asgera Spinesplitter, War Queen of the Bloodfang Orcs"

msgid "TOME_WILD_MAGIC@TOME@LORE_DESCRIPTION"
msgstr "\"Above all, the fray! Those who live and breathe war will always grapple for victory, even after their blades have broken, their bones have shattered and their brains have been turned to pulp. Build the mightiest war machines and impart your army with a hunger for victory. Then... Then you will be unstoppable!\""

msgid "TOME_WILD_MAGIC@TOME@NAME"
msgstr "Tome of Devastation"

msgid "TOME_WILD_MAGIC@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Displaces the attacked target and moves onto its hex."

msgid "TOME_WILD_MAGIC@UNIT1@ABILITY1@DESCRIPTION_IF_MOVED"
msgstr "If the unit moved, displaces the attacked target and moves onto its hex."

msgid "TOME_WILD_MAGIC@UNIT1@ABILITY1@NAME"
msgstr "Displace and Replace"

msgid "TOME_WILD_MAGIC@UNIT1@ABILITY2@DESCRIPTION"
msgstr "Attacks enemy units in a {unitsAmount}-hex cone.[bulletlist][bullet/]Cancels {GLOBAL.DefenseModeConcept.Hyperlink}.[bullet/]Removes {GLOBAL.RetaliationConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_WILD_MAGIC@UNIT1@ABILITY2@NAME"
msgstr "Power Cleave"

msgid "TOME_WILD_MAGIC@UNIT1@NAME"
msgstr "Warbreed^m"

msgid "TOME_WILD_MAGIC@UNIT2@NAME"
msgstr "Devastator Sphere^n"

msgid "TOME_WINDS@HERO_SKILL@DESCRIPTION"
msgstr "Whenever this unit is hit by an attack, the attacker has a base {AVENGING_WINDS_RESISTANCE_CHECK>ResolvedStrength}% chance of being pushed back {push} <<m:hex>>."

msgid "TOME_WINDS@HERO_SKILL@NAME"
msgstr "Avenging Winds"

msgid "TOME_WINDS@PASSIVE@DESCRIPTION"
msgstr "[bulletlist][bullet/]Rivers count as Roads for the purposes of Movement[bullet/]River <<m:{GLOBAL.ProvinceConcept}>> grant +{amount} {GLOBAL.GoldConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_WINDS@PASSIVE@NAME"
msgstr "Riversailors"

msgid "TOME_WINDS@SKILL1@DESCRIPTION"
msgstr "Pulls the closest enemy within {ABDUCTING_CYCLONE_UNIT_TARGETER_NEAREST_TO_TARGET>MaxDistance} hexes to target empty hex. They have a base {STUNNED_RESISTANCE>ResolvedStrength}% chance of becoming {GLOBAL.PROPERTIES.STUNNED.Hyperlink} for {STUNNED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "TOME_WINDS@SKILL1@NAME"
msgstr "Abducting Cyclone"

msgid "TOME_WINDS@SKILL2@DESCRIPTION"
msgstr "Grants enchanted units:[bulletlist][bullet/]Flying mounts.[/bulletlist]"

msgid "TOME_WINDS@SKILL2@NAME"
msgstr "Windborne Scouts"

msgid "TOME_WINDS@SKILL2@PROP_DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]A flying mount.[/bulletlist]"

msgid "TOME_WINDS@SKILL3@DESCRIPTION"
msgstr "Enemy units in a {DUST_STORM_UNIT_TARGETER_SINGLE>AREA>Radius}-hex radius:[bulletlist][bullet/]Sustain {DUST_STORM_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Have a base {BLINDED_RESISTANCE>ResolvedStrength}% chance of becoming {GLOBAL.PROPERTIES.BLINDED.Hyperlink} for {BLINDED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "TOME_WINDS@SKILL3@NAME"
msgstr "Dust Storm"

msgid "TOME_WINDS@SKILL4@DESCRIPTION"
msgstr "Target friendly army regains all their Movement points if they are on water. Half if they are on land.[br/]A unit cannot benefit from this spell more than once per turn."

msgid "TOME_WINDS@SKILL4@NAME"
msgstr "Favorable Winds"

msgid "TOME_WINDS@SKILL5@DESCRIPTION"
msgstr "Summon a {GLOBAL.UNITS.WIND_RAGER_UNIT.Hyperlink}, a fast and disruptive {GLOBAL.PROPERTIES.FIGHTER.Hyperlink}"

msgid "TOME_WINDS@SKILL5@NAME"
msgstr "Summon Wind Rager"

msgid "TOME_WINDS@SKILL6@DESCRIPTION"
msgstr "A {GLOBAL.PROPERTIES.RANGED_UNIT.Hyperlink} with extra range and an area of effect ability."

msgid "TOME_WINDS@SKILL6@NAME"
msgstr "Zephyr Archer"

msgid "TOME_WINDS@TOME@DESCRIPTION"
msgstr "Harness the powers of the wind to gain boosts of speed and disrupt enemies."

msgid "TOME_WINDS@TOME@LORE_AUTHOR"
msgstr "Tempest, Master of Storms"

msgid "TOME_WINDS@TOME@LORE_DESCRIPTION"
msgstr "\"High above the petty machinations of mortals lies the domain of the sky. Here, the winds flow wild and free, unfettered by the land below, uncaring, powerful. Those who manage to bend these winds to their will harness a truly powerful and liberating force. Foes are swept away, plucked from safety, and allies are buoyed, bolstered beyond their land-bound capabilities.\""

msgid "TOME_WINDS@TOME@NAME"
msgstr "Tome of Winds"

msgid "TOME_WINDS@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Deals damage to all adjacent enemies and displaces them up to {WHIRLWIND_DISPLACEMENT>MaxDistance} hexes."

msgid "TOME_WINDS@UNIT1@ABILITY1@NAME"
msgstr "Whirlwind"

msgid "TOME_WINDS@UNIT1@ABILITY2@DESCRIPTION"
msgstr "Adjacent friendly units are {WIND_BARRIER>ResolvedAccuracyModifier}% harder to hit by {GLOBAL.RangedConcept.Hyperlink} and ranged {GLOBAL.MagicConcept.Hyperlink} attacks."

msgid "TOME_WINDS@UNIT1@ABILITY2@NAME"
msgstr "Wind Barrier Aura"

msgid "TOME_WINDS@UNIT1@NAME"
msgstr "Wind Rager^n"

msgid "TOME_WINDS@UNIT2@ABILITY1@DESCRIPTION"
msgstr "Deals damage to target unit. Adjacent enemy units sustain {ZEPHYR_SHOT_CIRCLE_TARGETER>ResolvedEffectMultiplier}% of the damage."

msgid "TOME_WINDS@UNIT2@ABILITY1@NAME"
msgstr "Zephyr Shot"

msgid "TOME_WINDS@UNIT@NAME"
msgstr "Zephyr Archer"

msgid "TOME_ZEAL@HERO_SKILL@DESCRIPTION"
msgstr "Target enemy unit becomes {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink} until the end of battle."

msgid "TOME_ZEAL@HERO_SKILL@NAME"
msgstr "Condemn"

msgid "TOME_ZEAL@PASSIVE@DESCRIPTION"
msgstr "This unit heals +{ZEALOUS_ENDURANCE_AFTER_BATTLE_HEAL>Health} <<m:{GLOBAL.HitPointConcept.Hyperlink}>> after battle."

msgid "TOME_ZEAL@PASSIVE@NAME"
msgstr "Zealous Endurance"

msgid "TOME_ZEAL@SKILL1@DESCRIPTION"
msgstr "Summons a {GLOBAL.UNITS.ZEALOT_UNIT.Hyperlink} onto the target world hex. A Zealot is a reckless {GLOBAL.PROPERTIES.FIGHTER.Hyperlink} that is advantageous against {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink} units."

msgid "TOME_ZEAL@SKILL1@NAME"
msgstr "Summon Zealot"

msgid "TOME_ZEAL@SKILL2@DESCRIPTION"
msgstr "Target enemy unit:[bulletlist][bullet/]Sustains {CONDEMNATION_UNIT_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink}.[bullet/]Becomes {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink} until the end of battle.[/bulletlist]"

msgid "TOME_ZEAL@SKILL2@NAME"
msgstr "Condemnation"

msgid "TOME_ZEAL@SKILL3@DESCRIPTION"
msgstr "For {duration} <<m:{GLOBAL.TurnConcept}>>, target owned city:[bulletlist][bullet/]Gains {production} {GLOBAL.StructureProductionConcept.Hyperlink} income.[bullet/]Loses {food} {GLOBAL.FoodConcept.Hyperlink} income.[/bulletlist]"

msgid "TOME_ZEAL@SKILL3@NAME"
msgstr "Fanatical Workforce"

msgid "TOME_ZEAL@SKILL4@DESCRIPTION"
msgstr "Friendly units in a {INSPIRING_CHANT_UNIT_TARGETER_CIRCLE>AREA>Radius}-hex radius:[bulletlist][bullet/]Gain +{INSPIRING_CHANT_CHANGE_MORALE>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}.[bullet/]Become {amount} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} if they have {GLOBAL.PROPERTIES.ZEAL.Hyperlink}.[/bulletlist]"

msgid "TOME_ZEAL@SKILL4@NAME"
msgstr "Inspiring Chant"

msgid "TOME_ZEAL@SKILL5@DESCRIPTION"
msgstr "Grants enchanted units:[bulletlist][bullet/]{GLOBAL.PROPERTIES.ZEAL.Hyperlink}, which makes attacks deal extra {GLOBAL.SpiritDamageConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_ZEAL@SKILL5@NAME"
msgstr "Legion of Zeal"

msgid "TOME_ZEAL@SKILL5@PROP_DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]{GLOBAL.PROPERTIES.ZEAL.Hyperlink}[/bulletlist]"

msgid "TOME_ZEAL@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Rile up your fanatic population for a common goal. Use units with {GLOBAL.PROPERTIES.ZEAL.Hyperlink} and inflict {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink} on enemies."

msgid "TOME_ZEAL@TOME@LORE_AUTHOR"
msgstr "Sola the Pure, Exalted Human"

msgid "TOME_ZEAL@TOME@LORE_DESCRIPTION"
msgstr "\"The fervor of righteousness is a gift unto your subjects. When it courses through their veins, they become mightier, more valiant. They brush off their wounds and any pain, shielded by the holy knowledge that they are in the right! Those who reject your gift shall know condemnation, and it shall wither their very souls.\""

msgid "TOME_ZEAL@TOME@NAME"
msgstr "Tome of Zeal"

msgid "TOME_ZEAL@UNIT1@DESCRIPTION"
msgstr "Cheap fanatical Fighter unit that is advantageous against {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink} units."

msgid "TOME_ZEAL@UNIT1@NAME"
msgstr "Zealot^m"

msgid "TOOLTIP@LANDMARK@DESCRIPTION"
msgstr "Landmarks are a type of location the size of an entire region. Landmarks themselves cannot be annexed or claimed. Instead, landmarks grant effects to all adjacent <<m:{GLOBAL.ProvinceConcept.Hyperlink}>>.[br/][br/]If a {GLOBAL.CityConcept.Hyperlink} has a certain amount of provinces in their domain adjacent to one Landmark, they gain an additional bonus effect depending on the type of landmark.[br/][br/]Landmarks count as <<m:{GLOBAL.HandcraftedRegionConcept.Hyperlink}>>, meaning they can be disabled with the Untouched Realm Trait."

msgid "TOOLTIP@LANDMARK@HYPERLINK"
msgstr "[hyperlink,GLOBAL.LandmarkConcept]Landmark[/hyperlink]"

msgid "TOOLTIP@LANDMARK@NAME"
msgstr "Landmark"

msgid "TOOLTIP_DEFINITIONS@BACKFIRING@DESCRIPTION"
msgstr "<<m:{GLOBAL.SpellConcept.Hyperlink}>> may have a chance of backfiring.[br/][br/]When a spell can backfire, the chance is displayed in the casting menu. Upon casting the spell, you will be informed if the spell backfired or not. When a spell does not backfire, the spell is resolved as normal and nothing else happens.[br/][br/]When a spell backfires, its original effects are still resolved, but additional effects are added to the spell. These additional effects are random and usually affect the targets of the original spell.[br/][br/]For example: When a {GLOBAL.HealingSpellConcept.Hyperlink} backfires, it could have the additional effect of teleporting the unit that was healed up to 3 hexes away from its location."

msgid "TOOLTIP_DEFINITIONS@BACKFIRING@HYPERLINK"
msgstr "[hyperlink,GLOBAL.BackfireConcept]Backfiring[/hyperlink]"

msgid "TOOLTIP_DEFINITIONS@BACKFIRING@NAME"
msgstr "Spell Backfiring"

