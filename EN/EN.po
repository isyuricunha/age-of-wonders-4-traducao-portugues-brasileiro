msgid "INTERFACE@STRATEGIC_MAP@ANCIENT_WONDER"
msgstr "Ancient Wonder"

msgid "INTERFACE@STRATEGIC_MAP@ANCIENT_WONDER_DESCRIPTION"
msgstr "An Ancient Wonder is a {GLOBAL.LocationConcept.Hyperlink} that contains adventure and rewards. It can only be explored by a single {GLOBAL.ArmyConcept.Hyperlink} led by a {GLOBAL.HeroConcept.Hyperlink}.[br/][br/]When cleared, it can be annexed by a {GLOBAL.CityConcept.Hyperlink}. When annexed it will provide {GLOBAL.CityIncomeConcept.Hyperlink} and special <<m:{GLOBAL.UnitConcept.Hyperlink}>> in the {GLOBAL.RequestMilitaryAidConcept.Hyperlink}. An annexed Ancient Wonder counts as a type of {GLOBAL.ProvinceImprovementConcept.Hyperlink}.[br/][br/]Ancient Wonders can be [siteBronze/]Bronze, [siteSilver/]Silver, or [siteGold/]Gold, depending on rarity, difficulty and value."

msgid "INTERFACE@STRATEGIC_MAP@ANCIENT_WONDER_HYPERLINK"
msgstr "[hyperlink,GLOBAL.AncientWonderConcept]Ancient Wonder[/hyperlink]"

msgid "INTERFACE@STRATEGIC_MAP@BASE_IMPROVEMENT_DESCRIPTION"
msgstr "[bullet/]Meeting the {GLOBAL.BoostConcept.Hyperlink} requirement for <<m:{GLOBAL.CityStructureConcept.Hyperlink}>>.[bullet/]Adjacency bonuses of <<m:{GLOBAL.SpecialImprovementConcept.Hyperlink}>>.[bullet/]Bonuses that scale over specific province improvement types in the {GLOBAL.DomainConcept.Hyperlink}."

msgid "INTERFACE@STRATEGIC_MAP@CITY_CENTER"
msgstr "City Center"

msgid "INTERFACE@STRATEGIC_MAP@CITY_CENTER_DESCRIPTION"
msgstr "The {GLOBAL.LocationConcept.Hyperlink} on the {GLOBAL.WorldMapConcept.Hyperlink} which lies at the origin of the {GLOBAL.CityConcept.Hyperlink} Domain."

msgid "INTERFACE@STRATEGIC_MAP@CITY_CENTER_HYPERLINK"
msgstr "[hyperlink,GLOBAL.CityCenterConcept]City Center[/hyperlink]"

msgid "INTERFACE@STRATEGIC_MAP@CITY_TIER"
msgstr "City Tier"

msgid "INTERFACE@STRATEGIC_MAP@CITY_TIER_DESCRIPTION"
msgstr "{GLOBAL.CityConcept.Hyperlink} Tier is determined by its last completed Town Hall {GLOBAL.CityStructureConcept.Hyperlink}."

msgid "INTERFACE@STRATEGIC_MAP@CITY_TIER_HYPERLINK"
msgstr "[hyperlink,GLOBAL.CityTierConcept]City Tier[/hyperlink]"

msgid "INTERFACE@STRATEGIC_MAP@CONDUIT_DESCRIPTION"
msgstr "A Conduit is a base {GLOBAL.ProvinceImprovementConcept.Hyperlink} with the following benefits:[bulletlist][bullet/]Provides {GLOBAL.ManaConcept.Hyperlink} income.{LOC.INTERFACE@STRATEGIC_MAP@BASE_IMPROVEMENT_DESCRIPTION}[/bulletlist]"

msgid "INTERFACE@STRATEGIC_MAP@CONDUIT_HYPERLINK"
msgstr "[conduit/] [hyperlink,GLOBAL.ConduitConcept]Conduit[/hyperlink]"

msgid "INTERFACE@STRATEGIC_MAP@DOMAIN"
msgstr "Domain"

msgid "INTERFACE@STRATEGIC_MAP@DOMAIN_DESCRIPTION"
msgstr "The collection of <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> belonging to the city. The Ruler will have a {GLOBAL.ClaimConcept.Hyperlink} on provinces adjacent to their city domain. Friendly units have to spend {amount1} less <<m:{GLOBAL.MovePointConcept.Hyperlink}>> to traverse terrain in friendly domains."

msgid "INTERFACE@STRATEGIC_MAP@DOMAIN_HYPERLINK"
msgstr "[hyperlink,GLOBAL.DomainConcept]Domain[/hyperlink]"

msgid "INTERFACE@STRATEGIC_MAP@FARM_DESCRIPTION"
msgstr "A Farm is a base {GLOBAL.ProvinceImprovementConcept.Hyperlink} with the following benefits:[bulletlist][bullet/]Provides {GLOBAL.FoodConcept.Hyperlink} income.{LOC.INTERFACE@STRATEGIC_MAP@BASE_IMPROVEMENT_DESCRIPTION}[/bulletlist]"

msgid "INTERFACE@STRATEGIC_MAP@FARM_HYPERLINK"
msgstr "[farm/] [hyperlink,GLOBAL.FarmConcept]Farm[/hyperlink]"

msgid "INTERFACE@STRATEGIC_MAP@FISHERY_DESCRIPTION"
msgstr "A Fishery is a base {GLOBAL.ProvinceImprovementConcept.Hyperlink} with the following benefits:[bulletlist][bullet/]Provides {GLOBAL.FoodConcept.Hyperlink} income.{LOC.INTERFACE@STRATEGIC_MAP@BASE_IMPROVEMENT_DESCRIPTION}[/bulletlist]"

msgid "INTERFACE@STRATEGIC_MAP@FISHERY_HYPERLINK"
msgstr "[fishery/] [hyperlink,GLOBAL.FisheryConcept]Fishery[/hyperlink]"

msgid "INTERFACE@STRATEGIC_MAP@FORESTER_DESCRIPTION"
msgstr "A Forester is a base {GLOBAL.ProvinceImprovementConcept.Hyperlink} with the following benefits:[bulletlist][bullet/]Provides {GLOBAL.FoodConcept.Hyperlink} and {GLOBAL.StructureProductionConcept.Hyperlink} income.{LOC.INTERFACE@STRATEGIC_MAP@BASE_IMPROVEMENT_DESCRIPTION}[/bulletlist]"

msgid "INTERFACE@STRATEGIC_MAP@FORESTER_HYPERLINK"
msgstr "[forester/] [hyperlink,GLOBAL.ForesterConcept]Forester[/hyperlink]"

msgid "INTERFACE@STRATEGIC_MAP@GUILD_SLOT"
msgstr "Guild Slot"

msgid "INTERFACE@STRATEGIC_MAP@GUILD_SLOT_DESCRIPTION"
msgstr "Represents a [hyperlink,GLOBAL.CityConcept]City's[/hyperlink] capacity for powerful economic <<m:{GLOBAL.CityStructureConcept.Hyperlink}>> called Guilds.[br/][br/]Typically a city will only have a single Guild Slot."

msgid "INTERFACE@STRATEGIC_MAP@GUILD_SLOT_HYPERLINK"
msgstr "[hyperlink,GLOBAL.GuildSlotConcept]Guild Slot[/hyperlink]"

msgid "INTERFACE@STRATEGIC_MAP@HUT_HYPERLINK"
msgstr "[hut/] [hyperlink,GLOBAL.HutConcept]Hut[/hyperlink]"

msgid "INTERFACE@STRATEGIC_MAP@INFESTATION"
msgstr "Infestation"

msgid "INTERFACE@STRATEGIC_MAP@INFESTATION_DESCRIPTION"
msgstr "Areas under the control of <<m:{GLOBAL.MarauderConcept.Hyperlink}>>, who increase in numbers and over time take over adjacent <<m:{GLOBAL.ProvinceConcept.Hyperlink}>>. They will periodically send forth raiding parties that can potentially start a {GLOBAL.SiegeConcept.Hyperlink} on a {GLOBAL.CityConcept.Hyperlink} without needing a {GLOBAL.HeroConcept.Hyperlink}.[br/][br/]Destroying the {GLOBAL.InfestationSpawnerConcept.Hyperlink} will clear the infestation and grant the destroyer great rewards based on tier and size of the Infestation.[br/][br/]When an Infestation grows into one of your <<m:{GLOBAL.ProvinceConcept.Hyperlink}>>, it will continuously [hyperlink,GLOBAL.PillagingConcept]pillage[/hyperlink] its {GLOBAL.ProvinceImprovementConcept.Hyperlink} until the {GLOBAL.InfestationSpawnerConcept.Hyperlink} is destroyed.[br/][br/]Infestations have several states, its {GLOBAL.InfestationSpawnerConcept.Hyperlink} will indicate its current state, and each state will take several <<m:{GLOBAL.TurnConcept.Hyperlink}>> to activate:[bulletlist][bullet/][infestationDormant/] Deep Sleep/Sleeping/Awakening. The infestation will become active.[bullet/][infestationPatrolling/] Patrolling. The infestation will patrol its domain.[bullet/][infestationInvasion/] Invasion. A raiding party will emerge.[bullet/][infestationRecovering/] Recovering. The infestation will reinforce its patrolling armies.[/bulletlist][br/]Infestations can be {GLOBAL.InfestationNeutralityConcept.Hyperlink} to certain <<m:{GLOBAL.EmpireConcept.Hyperlink}>>."

msgid "INTERFACE@STRATEGIC_MAP@INFESTATION_HYPERLINK"
msgstr "[hyperlink,GLOBAL.InfestationConcept]Infestation[/hyperlink]"

msgid "INTERFACE@STRATEGIC_MAP@INFESTATION_NEUTRALITY"
msgstr "Infestation Neutrality"

msgid "INTERFACE@STRATEGIC_MAP@INFESTATION_NEUTRALITY@DESCRIPTION"
msgstr "<<m:{GLOBAL.InfestationConcept.Hyperlink}>> are hostile to all <<m:{GLOBAL.EmpireConcept.Hyperlink}>> by default, but they can become neutral to one or more Empires in certain circumstances.[br/][br/]While neutral to an Empire:[bulletlist][bullet/]The Infestation's armies will never attack the Empire.[bullet/]The Infestation will not pillage the Empire's Province Improvements.[bullet/]The Infestation will not send out raiding parties to the Empire.[bullet/]The Infestation can still grow into the Empire's domain.[bullet/]If the Empire attacks the Infestation's armies, the Infestation stops being neutral towards the Empire.[/bulletlist][br/]Infestations summoned by an Empire always start out neutral towards them."

msgid "INTERFACE@STRATEGIC_MAP@INFESTATION_NEUTRALITY@HYPERLINK"
msgstr "[hyperlink,GLOBAL.InfestationNeutralityConcept]Neutral[/hyperlink]"

msgid "INTERFACE@STRATEGIC_MAP@INFESTATION_SPAWNER"
msgstr "Infestation Spawner"

msgid "INTERFACE@STRATEGIC_MAP@INFESTATION_SPAWNER_DESCRIPTION"
msgstr "An Infestation Spawner is a {GLOBAL.LocationConcept.Hyperlink} that causes an {GLOBAL.InfestationConcept.Hyperlink} to take place."

msgid "INTERFACE@STRATEGIC_MAP@INFESTATION_SPAWNER_HYPERLINK"
msgstr "[hyperlink,GLOBAL.InfestationSpawnerConcept]Infestation Spawner[/hyperlink]"

msgid "INTERFACE@STRATEGIC_MAP@LOCATION"
msgstr "Location"

msgid "INTERFACE@STRATEGIC_MAP@LOCATION_DESCRIPTION"
msgstr "A special building or site on the {GLOBAL.WorldMapConcept.Hyperlink}, such as a watchtower, gold vein or bandit lair.[br/][bulletlist][bullet/]Guarded locations can be conquered to earn rewards.[bullet/]Take ownership of a location by moving <<m:{GLOBAL.UnitConcept.Hyperlink}>> onto to it.[bullet/]Many locations give <<m:{GLOBAL.ResourceConcept.Hyperlink}>> when within a city's domain.[/bulletlist]"

msgid "INTERFACE@STRATEGIC_MAP@LOCATION_HYPERLINK"
msgstr "[hyperlink,GLOBAL.LocationConcept]Location[/hyperlink]"

msgid "INTERFACE@STRATEGIC_MAP@MAGIC_MATERIAL_DESCRIPTION"
msgstr "Magic Materials are <<m:{GLOBAL.NodeConcept.Hyperlink}>> that provide bonus effects to your {GLOBAL.EmpireConcept.Hyperlink}, as well as provide {GLOBAL.CityIncomeConcept.Hyperlink}. These bonus effects can be traded to other <<m:{GLOBAL.EmpireConcept.Hyperlink}>> and <<m:{GLOBAL.IndependentCityConcept.Hyperlink}>>.[br/][br/]If all Magic Materials of the type are collected, they will provide an additional powerful bonus. The following bonuses are available:[br/][br/][bulletlist][bullet/]{GLOBAL.TOKENSETBONUS.IMPERIAL_ESSENCE.Hyperlink}[bullet/]{GLOBAL.TOKENSETBONUS.COSMICFLUX_ELIXIR.Hyperlink}[bullet/]{GLOBAL.TOKENSETBONUS.RINGS_OF_BINDING.Hyperlink}[/bulletlist]"

msgid "INTERFACE@STRATEGIC_MAP@MAGIC_MATERIAL_HYPERLINK"
msgstr "[hyperlink,GLOBAL.MagicMaterialConcept]Magic Material[/hyperlink]"

msgid "INTERFACE@STRATEGIC_MAP@MINE_DESCRIPTION"
msgstr "A Mine is a base {GLOBAL.ProvinceImprovementConcept.Hyperlink} with the following benefits:[bulletlist][bullet/]Provides {GLOBAL.GoldConcept.Hyperlink} income.{LOC.INTERFACE@STRATEGIC_MAP@BASE_IMPROVEMENT_DESCRIPTION}[/bulletlist]"

msgid "INTERFACE@STRATEGIC_MAP@MINE_HYPERLINK"
msgstr "[mine/] [hyperlink,GLOBAL.MineConcept]Mine[/hyperlink]"

msgid "INTERFACE@STRATEGIC_MAP@NODE"
msgstr "Node"

msgid "INTERFACE@STRATEGIC_MAP@NODE_DESCRIPTION"
msgstr "Nodes are <<m:{GLOBAL.LocationConcept.Hyperlink}>> on the {GLOBAL.WorldMapConcept.Hyperlink} which grant bonus income when the {GLOBAL.ProvinceConcept.Hyperlink} they are located in is annexed to a {GLOBAL.CityConcept.Hyperlink}."

msgid "INTERFACE@STRATEGIC_MAP@NODE_HYPERLINK"
msgstr "[hyperlink,GLOBAL.NodeConcept]Resource Node[/hyperlink]"

msgid "INTERFACE@STRATEGIC_MAP@PICKUP"
msgstr "Pickup"

msgid "INTERFACE@STRATEGIC_MAP@PICKUP_DESCRIPTION"
msgstr "One-time {GLOBAL.ResourceConcept.Hyperlink} packs on the {GLOBAL.WorldMapConcept.Hyperlink}. Their rewards can be acquired by moving an {GLOBAL.ArmyConcept.Hyperlink} onto them.[br/][br/]A Pickup is removed once its rewards are collected."

msgid "INTERFACE@STRATEGIC_MAP@PICKUP_HYPERLINK"
msgstr "[hyperlink,GLOBAL.PickupConcept]Pickup[/hyperlink]"

