msgid "DLC@THRONESOFBLOOD@MEGAWONDERS_STRATEGIC@THORN_HEART@DESCRIPTION"
msgstr "<<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacent to this Landmark gain:[bulletlist][bullet/]{income}.[bullet/]{income3}.[bullet/]A Farm [farm/] in this province grants {income2} additional income.[/bulletlist][br/]A {GLOBAL.CityConcept.Hyperlink} with {amount} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacent to this Landmark gains:[bulletlist][bullet/]The City terraforms 1 province on the surface within a {range} province radius of its {GLOBAL.DomainConcept.Hyperlink} per {GLOBAL.TurnConcept.Hyperlink}. The terraformed province:[bulletlist][bullet/]Gains {GLOBAL.SunlessConcept.Hyperlink}.[bullet/]Loses {GLOBAL.GloomTerrainConcept.Hyperlink}.[/bulletlist][bullet/]The City's {GLOBAL.EmpireConcept.Hyperlink} gains the {combatproperty} {GLOBAL.CombatEnchantmentConcept.Hyperlink} when fighting in a province with Sunless.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@MEGAWONDERS_STRATEGIC@THORN_HEART@LORE"
msgstr "\"Following the blood rivers upstream, my Orcs found the literal heart of the Sunless Lands, beating within the trunk of a defiled World Tree. Soon after, they succumbed to the Blood Parasites, devoured from the inside. Some say the heart's infection is a curse from the ancient times, others call it the vile progeny of Vampiric cults. Me, I call it perfection.\"[br/][br/]— Karissa the Red, Blood Rites throughout the Ages"

msgid "DLC@THRONESOFBLOOD@MEGAWONDERS_STRATEGIC@THORN_HEART@NAME"
msgstr "Thorn Heart"

msgid "DLC@THRONESOFBLOOD@MEGAWONDERS_STRATEGIC@THORN_HEART@NAME_OVERRIDE_01"
msgstr "Heart of Thorns"

msgid "DLC@THRONESOFBLOOD@MEGAWONDERS_STRATEGIC@THORN_HEART@NAME_OVERRIDE_02"
msgstr "Crimson Crest"

msgid "DLC@THRONESOFBLOOD@MEGAWONDERS_STRATEGIC@THORN_HEART@NAME_OVERRIDE_03"
msgstr "Sanguine Spring"

