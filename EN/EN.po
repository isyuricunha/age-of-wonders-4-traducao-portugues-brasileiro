msgstr "Slight chance of instantly killing an injured target. This chance increases the lower the target's <<m:{GLOBAL.HitPointConcept}>> are. If unsuccessful, the target gains {amount2} {GLOBAL.PROPERTIES.WEAKENED.Hyperlink}."

msgid "TOME_CYCLES@ABILITY_2@NAME"
msgstr "Cycle's End"

msgid "TOME_CYCLES@ABILITY_3@DESCRIPTION"
msgstr "Target friendly unit:[bulletlist][bullet/]If alive, heals +{RESTART_THE_CYCLE_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]If dead, is brought back to life with {RESTART_THE_CYCLE_RESSURECT>ResolvedHitPoints}% of its total <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[/bulletlist]"

