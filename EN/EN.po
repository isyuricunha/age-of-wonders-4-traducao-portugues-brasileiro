msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@DRAGON_REMAINS@NAME_OVERRIDE_03"
msgstr "Hoard of the Fallen"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@DRAGON_REMAINS@NAME_OVERRIDE_04"
msgstr "Dragon's Dusk"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@GRAND_STATUARY@DESCRIPTION"
msgstr "<<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacent to this Landmark gain:[bulletlist][bullet/]{income}.[bullet/] A [researchpost/] Research Post in this province grants {income2}.[/bulletlist][br/]A {GLOBAL.CityConcept.Hyperlink} with {amount} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacent to this Landmark gain:[bulletlist][bullet/]The {GLOBAL.GovernorConcept.Hyperlink} of the City gains {renown} {GLOBAL.RenownConcept.Hyperlink} every {GLOBAL.TurnConcept.Hyperlink}.[bullet/]<<m:{GLOBAL.UnitConcept.Hyperlink}>> recruited in the City gain {rankbonus} starting Rank.[/bulletlist]"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@GRAND_STATUARY@LORE"
msgstr "\"When I walk among these weathered statues, I ponder the souls they immortalize. Even those whose names are forgotten command my respect. Will I too, be remembered—or forgotten—like this? Will offerings grace my stone likeness, or will it be abandoned to time? Were my features carved into stone, would they become a beacon of hope—or of dread?\"[br/][br/]— Alfred Elderstone, Musings on Rulership"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@GRAND_STATUARY@NAME"
msgstr "Grand Statuary"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@GRAND_STATUARY@NAME_OVERRIDE_01"
