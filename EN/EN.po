msgid "DLC@WAYSOFWAR@TOME_SHADES@SMUGGLING_OPERATION@NAME"
msgstr "Smuggling Operation"

msgid "DLC@WAYSOFWAR@TOME_SHADES@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Strike from the shadows, blind your foes and find their weak points to deliver the perfect, fatal blow."

msgid "DLC@WAYSOFWAR@TOME_SHADES@TOME@LORE_DESCRIPTION"
msgstr "\"Every seasoned assassin knows that swift execution yields the cleanest results. Factor in that most beings - including your target - are blind in the dark, and your course of action is obvious. Exploit that vulnerability and maximize your efficiency. Move through the shadows, cloak yourself in darkness and ensure your target never sees when or where the fatal blow will fall.\""

msgid "DLC@WAYSOFWAR@TOME_SHADES@TOME@NAME"
msgstr "Tome of Shades"

