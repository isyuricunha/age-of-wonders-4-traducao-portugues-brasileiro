msgid "EXPANSION_VICTORY@VICTORY_CONDITION@DESCRIPTION"
msgstr "When an {GLOBAL.EmpireConcept.Hyperlink} grows large enough, either by itself {GLOBAL.DomainConcept.Hyperlink} or by [hyperlink,GLOBAL.PactOfVassalageConcept]Vassalizing[/hyperlink] <<m:{GLOBAL.IndependentCityConcept.Hyperlink}>>, it can strive for the expansion victory. To do so, it will need to build three <<m:{GLOBAL.STRUCTURE_UPGRADES.BEACONOFUNITY.Hyperlink}>> and light them. If the empire and its [hyperlink,GLOBAL.DSAllianceConcept]Allies[/hyperlink] can defend and hold onto their beacons for long enough, they will be victorious."

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ANCIENT_TREE@DESCRIPTION"
msgstr "[bulletlist][bullet/]{manabonus} {GLOBAL.ManaConcept.Hyperlink} and {knowledgebonus} {GLOBAL.KnowledgeConcept.Hyperlink} per {GLOBAL.ForesterConcept.Hyperlink} in {GLOBAL.CityConcept.Hyperlink} {GLOBAL.DomainConcept.Hyperlink}.[bullet/]Adds {GLOBAL.UNITS.ENTWINED_THRALL_UNIT.Hyperlink}, {GLOBAL.UNITS.ENTWINED_PROTECTOR_UNIT.Hyperlink}, and {GLOBAL.UNITS.ENTWINED_SCOURGE_UNIT.Hyperlink} to the {GLOBAL.RequestMilitaryAidConcept.Hyperlink}.[/bulletlist]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ANCIENT_TREE@LORE"
msgstr "[lorefontsize][lorefont]Scripture describes how the First Elves visited all [hyperlink,GLOBAL.WorldsWithinLoreConcept]Worlds[/hyperlink] to seed them with life. This magnificent tree stands as a testament to that age. It is said the souls of these First Ones still reside within it, sometimes manifesting themselves as the Entwined, eternally bound to protect its growth.[/lorefont][/lorefontsize]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ANCIENT_TREE@NAME"
msgstr "World Tree"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ANCIENT_WELLSPRING@DESCRIPTION"
msgstr "[bulletlist][bullet/]{stabilitybonus} {GLOBAL.CityStabilityConcept.Hyperlink} per {GLOBAL.FarmConcept.Hyperlink} and {GLOBAL.ForesterConcept.Hyperlink} in {GLOBAL.CityConcept.Hyperlink} {GLOBAL.DomainConcept.Hyperlink}.[bullet/]Friendly <<m:{GLOBAL.UnitConcept.Hyperlink}>> in {GLOBAL.DomainConcept.Hyperlink} are healed for {healamount} <<m:{GLOBAL.HitPointConcept.Hyperlink}>> at the end of each strategic {GLOBAL.TurnConcept.Hyperlink}.[bullet/]Adds {GLOBAL.UNITS.SPRING_FAIRY.Hyperlink}, {GLOBAL.UNITS.SUMMER_FAIRY.Hyperlink}, {GLOBAL.UNITS.AUTUMN_FAIRY.Hyperlink}, and {GLOBAL.UNITS.WINTER_FAIRY.Hyperlink} to the {GLOBAL.RequestMilitaryAidConcept.Hyperlink}.[/bulletlist]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ANCIENT_WELLSPRING@LORE"
msgstr "[lorefontsize][lorefont]This lush location is fed by a magical wellspring that flows directly from the fey realm. Mystical waters attract all manner of creatures, unaware that they are potential victims to tricks of the fairy folk. Though what a fairy considers mischief, can be potentially deadly to others! Even the most powerful beings should proceed with a measure of caution.[/lorefont][/lorefontsize]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ANCIENT_WELLSPRING@NAME"
msgstr "Hidden Wellspring"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ARCHON_RUINS@DESCRIPTION"
msgstr "[bulletlist][bullet/]{quarryincome} per {GLOBAL.QuarryConcept.Hyperlink} in {GLOBAL.CityConcept.Hyperlink} {GLOBAL.DomainConcept.Hyperlink}.[bullet/]Can be set as a {GLOBAL.UnitConcept.Hyperlink} deploy location.[bullet/]Adds the {GLOBAL.UNITS.BREWER_OGRE.Hyperlink} and {GLOBAL.UNITS.BUTCHER_OGRE.Hyperlink} units to the {GLOBAL.RequestMilitaryAidConcept.Hyperlink}.[/bulletlist]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ARCHON_RUINS@LORE"
msgstr "[lorefontsize][lorefont]The ruins of a massive stronghold dating back to an age when the first civilizations made a stand against rampant, gargantuan monsters and magical storms. Although battered, its weathered walls still offer a degree of protection to those within as well as those nearby during times of strife.[/lorefont][/lorefontsize]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ARCHON_RUINS@NAME"
msgstr "Castle Ruins"

