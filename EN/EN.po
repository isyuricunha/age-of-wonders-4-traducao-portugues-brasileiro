msgstr "Adds {amount} <<m:{GLOBAL.UNITS.BOLT_REPEATER_TOWER_UNIT.Hyperlink}>> in {GLOBAL.CombatConcept.Hyperlink} during a {GLOBAL.SiegeConcept.Hyperlink}."

msgid "TOME_ARTIFICING@SKILL5@PROP_NAME"
msgstr "Bolt Repeater Towers in Combat"

msgid "TOME_ARTIFICING@TOME@GAMEPLAY"
msgstr "Specialize in siegecraft, expertly crafted weapons, and Golems."

msgid "TOME_ARTIFICING@UNIT1@NAME"
msgstr "Iron Golem^n"

msgid "TOME_ARTIFICING@UNIT2@DESCRIPTION"
msgstr "Expandable {GLOBAL.PROPERTIES.FIGHTER.Hyperlink} that is immune to Status Effects."

msgid "TOME_ARTIFICING@UNIT2@NAME"
msgstr "Iron Golem Assistant^n"

msgid "TOME_ARTIFICING@UNIT3@NAME"
msgstr "Bolt Repeater^n"

msgid "TOME_ARTIFICING@UNIT4@NAME"
msgstr "Bolt Repeater Tower^n"

