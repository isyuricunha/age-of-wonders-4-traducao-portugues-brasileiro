msgid "ADVICE@IMPERIUMHIGH_REMINDER@TITLE"
msgstr "Invest your Imperium"

msgid "ADVICE@LOWFOOD_REMINDER@DESCRIPTION"
msgstr "{LowFoodCity.Name} is suffering from low {GLOBAL.FoodConcept.Hyperlink} income.[br/][br/] Food regulates the pace at which each {GLOBAL.CityConcept.Hyperlink} can get new {GLOBAL.PopulationConcept.Hyperlink} and so annex new <<m:{GLOBAL.ProvinceConcept.Hyperlink}>>.{GLOBAL.PopulationUpkeepConcept.Hyperlink} requires food and may be the cause of such a shortage.[br/][br/] Some <<m:{GLOBAL.CityStructureConcept.Hyperlink}>> and <<m:{GLOBAL.ProvinceImprovementConcept.Hyperlink}>> can increase the amount of food that a city produces per {GLOBAL.TurnConcept.Hyperlink}."

msgid "ADVICE@LOWFOOD_REMINDER@INSTRUCTION"
