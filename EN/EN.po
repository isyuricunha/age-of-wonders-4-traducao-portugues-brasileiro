msgid "DLC@WAYSOFWAR@UNITS_OATHSWORN@ABILITY05@DESCRIPTION_GENERIC_ENHANCED"
msgstr "The Sealbearer's seals become more powerful."

msgid "DLC@WAYSOFWAR@UNITS_OATHSWORN@ABILITY05@DESCRIPTION_GENERIC_MASTER"
msgstr "[oathswornHarmony/]Resonance Seal:[bulletlist][bullet/]Does an additional {resonance}{GLOBAL.BlightDamageConcept.Hyperlink} per attack.[/bulletlist][br/][oathswornStrife/]Fire Seal:[bulletlist][bullet/]Does an additional {fire}{GLOBAL.FireDamageConcept.Hyperlink} per turn.[bullet/]Does an additional {fire2}{GLOBAL.FireDamageConcept.Hyperlink} when the target dies.[/bulletlist][br/][oathswornRighteousness/]Transference Seal:[bulletlist][bullet/]Heals an addition {trans}{GLOBAL.TemporaryHitPointConcept.Hyperlink} per attack.[/bulletlist]"

