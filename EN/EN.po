msgid "TOME_CRYOMANCY@SKILL_5@PROPERTY@DESCRIPTION"
msgstr "{BLIZZARD_STATUS_RESISTANCE>Resistance} {GLOBAL.StatusResistanceConcept.Hyperlink}"

msgid "TOME_CRYOMANCY@SKILL_6@DESCRIPTION"
msgstr "Makes attacks of enchanted units gain:[bulletlist][bullet/]+{FROST_BLADES_EXTRA_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]A base {SLOWED_RESISTANCE>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.SLOWED.Hyperlink}.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CRYOMANCY@SKILL_6@NAME"
msgstr "Frost Arrows"

msgid "TOME_CRYOMANCY@SKILL_6@PROP_DESCRIPTION"
msgstr "Unit's attacks have:[bulletlist][bullet/]+{FROST_BLADES_EXTRA_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]A base {SLOWED_RESISTANCE>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.SLOWED.Hyperlink}.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CRYOMANCY@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Specialize in dealing {GLOBAL.FrostDamageConcept.Hyperlink} and inflicting {GLOBAL.PROPERTIES.FROZEN.Hyperlink}."

msgid "TOME_CRYOMANCY@TOME@LORE_AUTHOR"
msgstr "Artica the Cold, Queen of the Frostlings"

msgid "TOME_CRYOMANCY@TOME@LORE_DESCRIPTION"
msgstr "\"When all the world has turned to ice, I see a pure, Frostling paradise! Frost their limbs and make their bones brittle, entombed in icy blood! Summon the blizzard to freeze flesh and inspire fear that hearkens back to a time when mortals huddled in caves, fearing the cold would claim them...\""

msgid "TOME_CRYOMANCY@TOME@NAME"
msgstr "Tome of Cryomancy"

msgid "TOME_CRYOMANCY@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Deal damage to target enemy unit."

msgid "TOME_CRYOMANCY@UNIT1@ABILITY1@ENHANCED_DESCRIPTION"
msgstr "Freezing Blast:[bulletlist][bullet/]Does an additional {FREEZING_BLAST_ENHANCED_DAMAGE>DAMAGE>Frost}{GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]has no cooldown.[/bulletlist]"

msgid "TOME_CRYOMANCY@UNIT1@ABILITY1@ENHANCED_NAME"
msgstr "Enhanced Freezing Blast"

msgid "TOME_CRYOMANCY@UNIT1@ABILITY1@MASTER_DESCRIPTION"
msgstr "Freezing Blast:[bulletlist][bullet/]Does an additional {FREEZING_BLAST_ENHANCED_DAMAGE>DAMAGE>Frost}{GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Has a base {FROZEN_RESISTANCE>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.FROZEN.Hyperlink}.[/bulletlist]"

msgid "TOME_CRYOMANCY@UNIT1@ABILITY1@MASTER_NAME"
msgstr "Champion Freezing Blast"

msgid "TOME_CRYOMANCY@UNIT1@ABILITY1@NAME"
msgstr "Freezing Blast"

msgid "TOME_CYCLES@ABILITY1@DESCRIPTION"
msgstr "When this unit kills another, its cooldowns are reset."

msgid "TOME_CYCLES@ABILITY1@NAME"
msgstr "Life From Death"

