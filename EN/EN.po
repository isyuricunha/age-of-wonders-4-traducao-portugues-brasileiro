msgid "TOME_AMPLIFICATION@SKILL1@DESCRIPTION"
msgstr "Conjures an {GLOBAL.UNITS.AMPLIFICATION_PYLON_UNIT.Hyperlink}, a stationary structure that deals damage and increases the damage of your spells by {damage}.{LOC.CONCEPT@SUMMON_LIVE_SHARED}[br/][br/]{LOC.TACTICAL@ABILITY@NEVER_IN_WATER}"

