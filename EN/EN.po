msgid "DLC@WAYSOFWAR@TRIGGER@TOOLTIP@BANQUET_OF_TRIUMPH@AFFINITY_CHECK_ASTRAL@FAILURE"
msgstr "The {EventHouse} troops ignore your meager conjuration attempt and resume their feasting."

msgid "DLC@WAYSOFWAR@TRIGGER@TOOLTIP@BANQUET_OF_TRIUMPH@AFFINITY_CHECK_ASTRAL@HEADER"
msgstr "Create an illusion of the reanimated {EventUnitB} to draw the {EventHouse} army away."

msgid "DLC@WAYSOFWAR@TRIGGER@TOOLTIP@BANQUET_OF_TRIUMPH@AFFINITY_CHECK_ASTRAL@SUCCESS"
msgstr "The {EventStackleader} shouts: \"Looks like it isn't dead after all, soldiers! Move out!\""

msgid "DLC@WAYSOFWAR@TRIGGER@TOOLTIP@BANQUET_OF_TRIUMPH@AFFINITY_CHECK_CHAOS@FAILURE"
msgstr "Your extravagant celebrations are ignored by the disciplined troops from {EventHouse}."

msgid "DLC@WAYSOFWAR@TRIGGER@TOOLTIP@BANQUET_OF_TRIUMPH@AFFINITY_CHECK_CHAOS@HEADER"
msgstr "Use your talents for debauchery to kick the revels up a notch."

msgid "DLC@WAYSOFWAR@TRIGGER@TOOLTIP@BANQUET_OF_TRIUMPH@AFFINITY_CHECK_CHAOS@SUCCESS"
msgstr "The festive bonfires burn bright and quickly. Out reveled, the {EventHouse} troops move out soon after."

msgid "DLC@WAYSOFWAR@TRIGGER@TOOLTIP@DEVOTION@DECREASE"
msgstr "Oath breaking character action: -{IntAlignmentChange} Devotion. [undevotedact/]"

msgid "DLC@WAYSOFWAR@TRIGGER@TOOLTIP@DEVOTION@INCREASE"
msgstr "Devoted character action: +{IntAlignmentChange} Devotion. [devotedact/]"

msgid "DLC@WAYSOFWAR@TRIGGER@TOOLTIP@OATHBREAKERS@AFFINITY_CHECK_CHAOS@FAILURE"
msgstr "The Oathbreaker strikes down the {EventHouseLord.Title}, proving <<o:EventUnit>> innocence."

msgid "DLC@WAYSOFWAR@TRIGGER@TOOLTIP@OATHBREAKERS@AFFINITY_CHECK_CHAOS@HEADER"
msgstr "Propose that {EventHouseLord.FirstName} should duel a {EventUnit} to decide who is right"

msgid "DLC@WAYSOFWAR@TRIGGER@TOOLTIP@OATHBREAKERS@AFFINITY_CHECK_CHAOS@LORD_DIES"
msgstr "{EventHouseLord.TitleName} is killed!"

msgid "DLC@WAYSOFWAR@TRIGGER@TOOLTIP@OATHBREAKERS@AFFINITY_CHECK_CHAOS@SUCCESS"
msgstr "{EventHouseLord.FirstName} efficiently slays the {EventUnit} in a thrilling duel."

msgid "DLC@WAYSOFWAR@TRIGGER@TOOLTIP@OATHBREAKERS@AFFINITY_CHECK_ORDER@FAILURE"
msgstr "\"I asked you to be executioner,\" yells {EventHouseLord.FirstName}, \"Not their judge!\""

msgid "DLC@WAYSOFWAR@TRIGGER@TOOLTIP@OATHBREAKERS@AFFINITY_CHECK_ORDER@HEADER"
msgstr "Insist that the accused should be judged fairly."

msgid "DLC@WAYSOFWAR@TRIGGER@TOOLTIP@OATHBREAKERS@AFFINITY_CHECK_ORDER@SUCCESS"
msgstr "{EventHouseLord.FirstName} accepts your wisdom. The <<m:EventUnit>> will be lawfully tried."

msgid "DLC@WAYSOFWAR@TRIGGER@TOOLTIP@OATHBREAKER_QUEST_HARMONY@AFFINITY_CHECK@CHAOS@FAILURE"
msgstr "The <<m:EventUnit>> shielded themselves from your spells of chaotic disruption."

msgid "DLC@WAYSOFWAR@TRIGGER@TOOLTIP@OATHBREAKER_QUEST_HARMONY@AFFINITY_CHECK@CHAOS@HEADER"
msgstr "Attempt to extract the sacred wards that protect the <<m:EventUnit>>."

msgid "DLC@WAYSOFWAR@TRIGGER@TOOLTIP@OATHBREAKER_QUEST_HARMONY@AFFINITY_CHECK@CHAOS@SUCCESS"
msgstr "You've stolen the secrets of {GLOBAL.PROPERTIES.BLESSED_ARMORS_GROUP.Hyperlink} from the horrified <<m:EventUnit>>."

msgid "DLC@WAYSOFWAR@TRIGGER@TOOLTIP@OATHBREAKER_QUEST_RIGHTEOUSNESS@AFFINITY_CHECK@SHADOW@FAILURE"
msgstr "The {EventStackLeader} guards <<o:EventStackLeader>> secrets, even in death."

msgid "DLC@WAYSOFWAR@TRIGGER@TOOLTIP@OATHBREAKER_QUEST_RIGHTEOUSNESS@AFFINITY_CHECK@SHADOW@HEADER"
msgstr "Ignore the {EventUnit} and turn your attention to the dead {EventStackLeader}."

msgid "DLC@WAYSOFWAR@TRIGGER@TOOLTIP@OATHBREAKER_QUEST_RIGHTEOUSNESS@AFFINITY_CHECK@SHADOW@SUCCESS"
msgstr "Experimenting on the lifeless body of the {EventStackLeader} yields you {GLOBAL.PROPERTIES.ACCURSED_ARMORS_GROUP.Hyperlink}."

msgid "DLC@WAYSOFWAR@TRIGGER@TOOLTIP@OATHBREAKER_QUEST_STRIFE@AFFINITY_CHECK@ASTRAL@FAILURE"
msgstr "The {EventUnit} resists your hex and, with a chilling roar, vanishes."

msgid "DLC@WAYSOFWAR@TRIGGER@TOOLTIP@OATHBREAKER_QUEST_STRIFE@AFFINITY_CHECK@ASTRAL@HEADER"
msgstr "Use your Astral manipulations to force the {EventUnit} to fight for you."

msgid "DLC@WAYSOFWAR@TRIGGER@TOOLTIP@OATHBREAKER_QUEST_STRIFE@AFFINITY_CHECK@ASTRAL@SUCCESS"
msgstr "After a brief struggle, the will of the {EventUnit} breaks and <<p:EventUnit>> obeys."

msgid "DLC@WAYSOFWAR@TRIGGER@TOOLTIP@OATHSWORN_EVENTS@SPEND_DEVOTION"
msgstr "Willingly expend {EventNumber} {GLOBAL.DevotionConcept.Hyperlink}. [undevotedact/]"

msgid "DLC@WAYSOFWAR@TRIGGER@TOOLTIP@STAUNCH_SENTINELS@AFFINITY_CHECK_ORDER@FAILURE"
msgstr "The sentinels consider their oaths yet unfulfilled, despite your wheedling words."

msgid "DLC@WAYSOFWAR@TRIGGER@TOOLTIP@STAUNCH_SENTINELS@AFFINITY_CHECK_ORDER@HEADER"
msgstr "Give an ardent speech about duty, honor, and fulfilling oaths."

msgid "DLC@WAYSOFWAR@TRIGGER@TOOLTIP@STAUNCH_SENTINELS@AFFINITY_CHECK_ORDER@SUCCESS"
msgstr "The {EventStructure} guards pack up and return to {EventHouse}, most of them relieved."

msgid "DLC@WAYSOFWAR@TRIGGER@TOOLTIP@STAUNCH_SENTINELS@AFFINITY_CHECK_SHADOW@FAILURE"
msgstr "Unfazed by your lies, the sentinels return to their guard duties."

msgid "DLC@WAYSOFWAR@TRIGGER@TOOLTIP@STAUNCH_SENTINELS@AFFINITY_CHECK_SHADOW@HEADER"
msgstr "Attempt to trick the sentinels into thinking they can leave the {EventStructure}."

msgid "DLC@WAYSOFWAR@TRIGGER@TOOLTIP@STAUNCH_SENTINELS@AFFINITY_CHECK_SHADOW@SUCCESS"
msgstr "The inexperienced sentinels fall for your ruse and abandon their post."

msgid "DLC@WAYSOFWAR@TUTORIAL@DEVOTION@DESCRIPTION"
msgstr "Tutorial on Devotion"

msgid "DLC@WAYSOFWAR@TUTORIAL@DEVOTION@TITLE"
msgstr "[devotion0/] Devotion"

msgid "DLC@WAYSOFWAR@TUTORIAL@DEVOTION_PAGE01@DESCRIPTION"
msgstr "{GLOBAL.DevotionConcept.Hyperlink} represents how well your actions conform to the ideals of your {GLOBAL.OathswornConcept.Hyperlink} subculture. Higher devotion levels grant benefits to your faction, while becoming an Oathbreaker can lead to serious penalties."

msgid "DLC@WAYSOFWAR@TUTORIAL@DEVOTION_PAGE01@INSTRUCTIONS"
msgstr "You can track your current Devotion level, what your culture likes and dislikes, and what bonus it confers on the [devotion0/] indicator on the top bar."

msgid "DLC@WAYSOFWAR@TUTORIAL@DEVOTION_PAGE01@INSTRUCTIONS_CONTROLLER"
msgstr "You can track your current Devotion level, what your culture likes and dislikes, and what bonus it confers on the [devotion0/] indicator on the top bar."

