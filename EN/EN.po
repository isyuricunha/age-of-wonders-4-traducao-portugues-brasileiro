msgid "DLC@GIANTKINGS@HOTGK_FINISHER@DESCRIPTION_NON_HEIR"
msgstr "The Giant Clans have united to assault all empires of the realm. They call upon \"Thagnokar's Heir\" to lead them to victory against the smaller races."

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@GRIEVANCE"
msgstr "{STR_leaderName} is leading the assault of the Giant Clans on this realm!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@HEADER_ACTIVE_ASSAULT"
msgstr "Defend {HOTGK_TARGET_CITY} against the {HOTGK_CLAN_NAME} army!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@HEADER_ACTIVE_ASSAULT_HEIR"
msgstr "The Giant Clans are assaulting the realm!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@HEADER_CITY_CONQUERED"
msgstr "Stop the {HOTGK_CLAN_NAME} before they raze {HOTGK_TARGET_CITY}!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@HEADER_CITY_RAZED"
msgstr "After razing {HOTGK_TARGET_CITY}, the {HOTGK_CLAN_NAME} has withdrawn from your domain."

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@HEADER_CITY_RAZED_OTHER"
msgstr "After {HOTGK_TARGET_CITY} was razed, the {HOTGK_CLAN_NAME} has aborted their assault."

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@HEADER_CITY_TARGET_SCRIED"
msgstr "Thagnokar's Heir: {HOTGK_TARGET_CITY} will be attacked!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@HEADER_CITY_TARGET_SCRIED_DESC"
msgstr "Through your connection with the earth, you have descried that the Giant Clans are moving towards your city of {HOTGK_TARGET_CITY}. All defenses must be prepared!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@HEADER_DEFEATED_ASSAULT"
msgstr "You have vanquished the invading {HOTGK_CLAN_NAME}!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@HEADER_END"
msgstr "The assaults of the Giant Clans have ended."

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@HEADER_INCOMING_ASSAULT"
msgstr "Prepare for the assault of the Giant Clans!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@ARMY_DESTROYED@DESCRIPTION"
msgstr "One of the Giant Clan armies attacking the realm has been destroyed by another player."

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@ARMY_DESTROYED@HEADER"
msgstr "Thagnokar's Heir: Clan Army destroyed!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@CITY_LOST@DESCRIPTION"
msgstr "The {HOTGK_CLAN_NAME} has captured {HOTGK_TARGET_CITY} and begun razing it to the ground. Retake the city to stop them!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@CITY_LOST@HEADER"
msgstr "Thagnokar's Heir: {HOTGK_TARGET_CITY} lost!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@CITY_RAZED@DESCRIPTION"
msgstr "The {HOTGK_CLAN_NAME} has razed {HOTGK_TARGET_CITY}. After their work of devastation, they have withdrawn from your domain, but the events of this day have scarred your empire for the ages to come."

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@CITY_RAZED@HEADER"
msgstr "Thagnokar's Heir: {HOTGK_TARGET_CITY} razed!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@CITY_RAZED_HEIR@DESCRIPTION"
msgstr "One of the Giant Clan armies has razed the city they assaulted. They have devoted this victory to you, Thagnokar's Heir, and you gain {HOTGK_RAZE_IMP_REWARD} {GLOBAL.ImperiumConcept.Hyperlink}. Afterwards the clan army has withdrawn with their spoils to recover from battle."

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@CITY_RAZED_HEIR@HEADER"
msgstr "Thagnokar's Heir: Clan raid successful!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@CITY_RAZED_OTHER@DESCRIPTION"
msgstr "Irritated by the destruction of their target {HOTGK_TARGET_CITY}, the {HOTGK_CLAN_NAME} has withdrawn into their hidden halls of deep."

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@CITY_RAZED_OTHER@HEADER"
msgstr "Thagnokar's Heir: The {HOTGK_CLAN_NAME} has withdrawn!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@CITY_RAZED_OTHER_HEIR@DESCRIPTION"
msgstr "Seeing the city they assaulted destroyed by another faction, one of the Giant Clan armies has aborted their raid and withdrawn to their hidden halls of deep."

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@CITY_RAZED_OTHER_HEIR@HEADER"
msgstr "Thagnokar's Heir: Clan raid aborted!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@CITY_SIEGED@DESCRIPTION"
msgstr "The {HOTGK_CLAN_NAME} is laying siege to {HOTGK_TARGET_CITY}. Bring in reinforcements to break the siege or trust in the power of your defenses."

