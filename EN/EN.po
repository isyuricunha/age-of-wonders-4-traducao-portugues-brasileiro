msgstr "Eldritch Relic Weapon"

msgid "INTERFACE@TEXT@ITEM_TYPE_FIST_WEAPON@DESCRIPTION"
msgstr "These are small weapons that are used in each hand. They grant the hero melee attacks that often have a special effect on the third attack.[br/][br/]Usable by:[bulletlist][bullet/]{GLOBAL.HeroClassDefender.Hyperlink}[bullet/]{GLOBAL.HeroClassWarrior.Hyperlink}[bullet/]{GLOBAL.HeroClassDeathKnight.Hyperlink}[bullet/]{GLOBAL.HeroClassSpellblade.Hyperlink}[/bulletlist]"

