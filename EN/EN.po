msgid "INTERFACE@LORE_CONCEPT@WIZARD_KING@DESCRIPTION"
msgstr "Wizard Kings are ancient archmages who seek power across the realms of the {GLOBAL.AstralSeaLoreConcept.Hyperlink}. Before joining the {GLOBAL.PantheonLoreConcept.Hyperlink} at {GLOBAL.MagehavenLoreConcept.Hyperlink}, the {GLOBAL.ShadowTrialLoreConcept.Hyperlink} left many mentally warped. Wizard Kings are no longer limited to their original mortal form, and can create people vastly different from themselves."

msgid "INTERFACE@LORE_CONCEPT@WIZARD_KING@HYPERLINK"
msgstr "[hyperlink,GLOBAL.WizardKingLoreConcept]Wizard King[/hyperlink]"

msgid "INTERFACE@LORE_CONCEPT@WIZARD_KING@TITLE"
msgstr "Wizard King"

