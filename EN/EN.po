msgid "INTERFACE@TEXT@ITEM_TYPE_POLEARM@DESCRIPTION"
msgstr "These are long melee weapons such as spears, polearms, and glaives. They grant the hero {GLOBAL.FirstStrikeConcept.Hyperlink} and {GLOBAL.PROPERTIES.CHARGE_RESISTANCE.Hyperlink}.[br/][br/]Usable by:[bulletlist][bullet/]{GLOBAL.HeroClassDefender.Hyperlink}[bullet/]{GLOBAL.HeroClassWarrior.Hyperlink}[bullet/]{GLOBAL.HeroClassDeathKnight.Hyperlink}[bullet/]{GLOBAL.HeroClassSpellblade.Hyperlink}[/bulletlist]"

