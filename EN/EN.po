msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@ICEBOUND_BEHEMOTH@DESCRIPTION"
msgstr "<<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacent to this Landmark gain:[bulletlist][bullet/]{income}.[bullet/] A [researchpost/] Research Post in this province grants {income2}.[bullet/]The {combatproperty} {GLOBAL.CombatEnchantmentConcept.Hyperlink}[/bulletlist][br/]A {GLOBAL.CityConcept.Hyperlink} with {amount} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacent to this Landmark gain:[bulletlist][bullet/]Gain {visionbonus} {GLOBAL.VisionRangeConcept.Hyperlink} and {sensingbonus} {GLOBAL.SensorRangeConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@ICEBOUND_BEHEMOTH@LORE"
msgstr "\"To gaze upon these vast, frozen eyes is to stand on the edge of eternity itself. Even sealed in frost, they pierce me—through flesh, soul, the very fabric of the cosmos. We, who claim mastery of the arcane, know nothing compared to this colossus of the {GLOBAL.UrwildernessLoreConcept.Hyperlink}. What are we to such an ageless, forgotten seer?\"[br/][br/]— Merlin the Wanderer, recovered Journals from the Fourth Age"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@ICEBOUND_BEHEMOTH@NAME"
msgstr "Icebound Behemoth"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@ICEBOUND_BEHEMOTH@NAME_OVERRIDE_01"
msgstr "Frozen Urwilder"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@ICEBOUND_BEHEMOTH@NAME_OVERRIDE_02"
