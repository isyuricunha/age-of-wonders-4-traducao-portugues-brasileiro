msgid "TUTORIAL@ARCANE_INSPIRATION_PAGE01@INSTRUCTIONS"
msgstr "<<m:{GLOBAL.CombatSpellConcept.Hyperlink}>> gain an inspiration after any combat in which they were cast.[br/]<<m:{GLOBAL.WorldSpellConcept.Hyperlink}>> gain an inspiration any time they are cast.[br/]Check the spell book to view the status of a spell’s inspiration and view the benefit of its potential."

msgid "TUTORIAL@ARCANE_INSPIRATION_PART_2@DESCRIPTION"
msgstr "Tutorial on exploiting potentials"

msgid "TUTORIAL@ARCANE_INSPIRATION_PART_2@TITLE"
msgstr "School of Potential: Exploiting Potentials"

msgid "TUTORIAL@ARCANE_INSPIRATION_PART_2_PAGE01@DESCRIPTION"
msgstr "One of your spells has gained enough inspiration to be exploited. While it is being exploited, you gain the benefit of its potential, but lose access to that spell for the duration."

msgid "TUTORIAL@ARCANE_INSPIRATION_PART_2_PAGE01@INSTRUCTIONS"
msgstr "You can exploit spells with full inspiration from your spellbook by clicking the inspiration indicator to the top-right of the spell icon."

msgid "TUTORIAL@ARMIES@DESCRIPTION"
msgstr "Tutorial about your armies on the world map"

msgid "TUTORIAL@ARMIES@PAGE00@INSTRUCTION"
msgstr "Select one of the armies on the map to learn more about them."

msgid "TUTORIAL@ARMIES@PAGE00@OBJECTIVE"
msgstr "Select an army"

msgid "TUTORIAL@ARMIES@PAGE01@DESCRIPTION"
msgstr "You have selected an army. Armies are the core of your military strength. They can explore the world, attack your foes, and defend your lands."

msgid "TUTORIAL@ARMIES@PAGE01@INSTRUCTION"
msgstr "The banners above each army shows what faction they belong to. The panel at the bottom of your screen gives more information about that army."

msgid "TUTORIAL@ARMIES@PAGE01@TITLE"
msgstr "Armies"

msgid "TUTORIAL@ARMIES@PAGE02@DESCRIPTION"
msgstr "An army can contain up to 6 individual units. You can see a unit's tier, unit role, and movement points in the army panel."

msgid "TUTORIAL@ARMIES@PAGE02@INSTRUCTION"
msgstr "To learn more about an individual unit's capabilities, [rightmousebutton/] right-click their portrait in the army panel at the bottom of your screen."

msgid "TUTORIAL@ARMIES@PAGE02@INSTRUCTION_CONTROLLER"
msgstr "To learn more about an individual unit's capabilities, press [ci_dpaddown/] to go into the army panel, then press [ci_buttony/] on any unit."

msgid "TUTORIAL@ARMIES@PAGE02@OBJECTIVE"
msgstr "Inspect a unit"

msgid "TUTORIAL@ARMIES@PAGE02@TITLE"
msgstr "Army Stack Panel"

msgid "TUTORIAL@ARMIES@TITLE"
msgstr "Units & Armies"

msgid "TUTORIAL@ARMYMOVEMENT@DESCRIPTION"
msgstr "Tutorial on moving your armies over the world map."

msgid "TUTORIAL@ARMYMOVEMENT@FINISHER@DESCRIPTION"
msgstr "A glorious victory, O {PlayerLeader.Title}! You have beaten an {GLOBAL.ArmyConcept.Hyperlink} in {GLOBAL.CombatConcept.Hyperlink}, rewarding you with loot and your surviving units with {GLOBAL.ExperienceConcept.Hyperlink}. The more experience they get, the stronger your armies become."

msgid "TUTORIAL@ARMYMOVEMENT@FINISHER@OBJECTIVE"
msgstr "You have beaten an {GLOBAL.ArmyConcept.Hyperlink} in {GLOBAL.CombatConcept.Hyperlink}. You have gained some loot and your units and heroes gain {GLOBAL.ExperienceConcept.Hyperlink}. As units survive combat they get stronger and learn new abilities. The higher the {GLOBAL.UnitTierConcept.Hyperlink}, the more they benefit from {GLOBAL.ExperienceConcept.Hyperlink} so upgrade your units regularly."

msgid "TUTORIAL@ARMYMOVEMENT@PAGE01@DESCRIPTION"
msgstr "Your armies can move a limited distance every turn. The distance they can move depends on the terrain they traverse."

msgid "TUTORIAL@ARMYMOVEMENT@PAGE01@INSTRUCTION"
msgstr "You can move your army by [rightmousebutton/] right-clicking on a hex on the world map.[br/][br/]You can control which units in the army move by [leftmousebutton/] left-clicking on their portrait."

msgid "TUTORIAL@ARMYMOVEMENT@PAGE01@INSTRUCTION_CONTROLLER"
msgstr "While having your army selected, you can move it by pressing [ci_buttona/] on a hex on the world map.[br/][br/]"

msgid "TUTORIAL@ARMYMOVEMENT@PAGE01@OBJECTIVE"
msgstr "Moved one of your armies"

msgid "TUTORIAL@ARMYMOVEMENT@PAGE01@TITLE"
msgstr "Army Movement"

msgid "TUTORIAL@ARMYMOVEMENT@PAGE02@INSTRUCTION"
msgstr "Whenever an {GLOBAL.ArmyConcept} moves onto a hex occupied by enemy army, it initiates {GLOBAL.CombatConcept.Hyperlink}. As well as the attacking and defending armies, up to {count} nearby armies for each side can [hyperlink,GLOBAL.ReinforcementRuleConcept]reinforce[/hyperlink] the battle."

msgid "TUTORIAL@ARMYMOVEMENT@PAGE02@OBJECTIVE"
msgstr "Attack an enemy army"

msgid "TUTORIAL@ARMYMOVEMENT@TITLE"
msgstr "Army Movement"

msgid "TUTORIAL@ARMYMOVEMENT_FINISHER@TITLE"
msgstr "Deserved Victory"

msgid "TUTORIAL@ARMYUPKEEP@DESCRIPTION"
msgstr "Tutorial on Army Upkeep."

msgid "TUTORIAL@ARMYUPKEEP@PAGE01@DESCRIPTION"
msgstr "Beware, O {PlayerLeader.Title}! Your units do not fight for free. They require a certain amount of {GLOBAL.GoldConcept} and {GLOBAL.ManaConcept} each {GLOBAL.TurnConcept.Hyperlink}. If you cannot provide these resources, they lose {GLOBAL.UnitMoraleConcept.Hyperlink} and eventually desert your army."

msgid "TUTORIAL@ARMYUPKEEP@TITLE"
msgstr "Army Upkeep"

msgid "TUTORIAL@ASTRAL_ECHO@DESCRIPTION"
msgstr "Tutorial on Astral Echoes (Attunement)"

msgid "TUTORIAL@ASTRAL_ECHO@TITLE"
msgstr "School of Attunement: Astral Echoes"

msgid "TUTORIAL@ASTRAL_ECHO_PAGE01@DESCRIPTION"
msgstr "You have gained your first {GLOBAL.AstralEchoesConcept.Hyperlink}. This unique resource is used by School of Attunement Mystics for [hyperlink,GLOBAL.EchoCastingConcept]Echo Casting[/hyperlink]."

msgid "TUTORIAL@ASTRAL_ECHO_PAGE01@INSTRUCTIONS"
msgstr "<<m:{GLOBAL.AstralEchoesConcept.Hyperlink}>> are obtained from Astral Echoes pickups and by researching new skills."

msgid "TUTORIAL@ASTRAL_ECHO_PAGE02@DESCRIPTION"
msgstr "Through [hyperlink,GLOBAL.EchoCastingConcept]Echo Casting[/hyperlink] you can cast <<m:{GLOBAL.SpellConcept.Hyperlink}>> even when you lack sufficient casting points."

msgid "TUTORIAL@ASTRAL_ECHO_PAGE02@INSTRUCTIONS"
msgstr "<<m:{GLOBAL.CombatSpellConcept.Hyperlink}>> indicate it in their cost when <<m:{GLOBAL.AstralEchoesConcept.Hyperlink}>> are needed to cast the spell. This is automatic once you run out of <<m:{GLOBAL.CombatCastingPointConcept.Hyperlink}>>.[br/]<<m:{GLOBAL.WorldSpellConcept.Hyperlink}>> can be manually accelerated by clicking the button on the top left of the priming spell."

msgid "TUTORIAL@ASTRAL_ECHO_PAGE02@TITLE"
msgstr "School of Attunement: Echo Casting"

msgid "TUTORIAL@ASTRAL_ECHO_SUMMONING@DESCRIPTION"
msgstr "Tutorial on Astral Echoes (Summoning)"

msgid "TUTORIAL@ASTRAL_ECHO_SUMMONING@TITLE"
msgstr "School of Summoning: Astral Echoes"

msgid "TUTORIAL@ASTRAL_ECHO_SUMMONING_PAGE01@DESCRIPTION"
msgstr "You have gained your first [hyperlink,GLOBAL.AstralEchoesConcept]Astral Echo[/hyperlink]. This unique resource is used by School of Summoning Mystics for [hyperlink,GLOBAL.EchoInfusionConcept]Echo Infusion[/hyperlink]."

msgid "TUTORIAL@ASTRAL_ECHO_SUMMONING_PAGE01@INSTRUCTIONS"
msgstr "<<m:{GLOBAL.AstralEchoesConcept.Hyperlink}>> are obtained from Astral Echoes pickups."

msgid "TUTORIAL@ASTRAL_ECHO_SUMMONING_PAGE02@DESCRIPTION"
msgstr "[hyperlink,GLOBAL.EchoInfusionConcept]Echo Infusion[/hyperlink] allows the use of <<m:{GLOBAL.AstralEchoesConcept.Hyperlink}>> to empower {GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink} units by granting them additional ranks."

msgid "TUTORIAL@ASTRAL_ECHO_SUMMONING_PAGE02@INSTRUCTIONS"
msgstr "The cost of this infusion is based on the remaining {GLOBAL.ExperienceConcept.Hyperlink} required before the unit reaches the next rank."

msgid "TUTORIAL@ASTRAL_ECHO_SUMMONING_PAGE02@TITLE"
msgstr "School of Summoning: Echo Infusion"

msgid "TUTORIAL@BOOSTING@DESCRIPTION"
msgstr "Some city structures can be [hyperlink,GLOBAL.BoostConcept]Boosted[/hyperlink] to make them cheaper and faster to produce. Check the structure's tooltip to see the boost conditions."

msgid "TUTORIAL@BOOSTING@INSTRUCTION"
msgstr "Most structures are boosted by having certain <<m:{GLOBAL.ProvinceImprovementConcept.Hyperlink}>> in the city's domain, while others are boosted by having a certain amount of {GLOBAL.PopulationConcept.Hyperlink}.[br/][br/]If you boost something that's already in production, you will be refunded the gold you would have saved."

msgid "TUTORIAL@BOOSTING@SUMMARY"
msgstr "Tutorial on boosting production of city structures."

msgid "TUTORIAL@BOOSTING@TITLE"
msgstr "Boosting Production"

msgid "TUTORIAL@BOUNTYOVERVIEW@DESCRIPTION"
msgstr "Tutorial on the Bounty Panel"

msgid "TUTORIAL@BOUNTYOVERVIEW@PAGE_01@DESCRIPTION"
msgstr "This is the Bounty panel. Here, you can create a {GLOBAL.CallToArmsConcept.Hyperlink} to offer it to other <<m:{GLOBAL.LeaderConcept.Hyperlink}>>."

msgid "TUTORIAL@BOUNTYOVERVIEW@PAGE_01@INSTRUCTION"
msgstr "Bounties are quests that are offered to other Rulers in exchange for a reward. Bounties can target <<m:{GLOBAL.CityConcept.Hyperlink}>>, <<m:{GLOBAL.InfestationConcept.Hyperlink}>> and important structures owned by enemies."

msgid "TUTORIAL@BOUNTYOVERVIEW@TITLE"
msgstr "Bounty Panel"

msgid "TUTORIAL@CAMERA@DESCRIPTION"
msgstr "Tutorial on camera controls on the world map."

msgid "TUTORIAL@CAMERA@PAGE01@DESCRIPTION"
msgstr "Take some time to look around and familiarize yourself with your new surroundings."

msgid "TUTORIAL@CAMERA@PAGE01@INSTRUCTION"
msgstr "To move the camera around, use the W, A, S, D keys or hold [leftmousebutton/] and drag your mouse."

msgid "TUTORIAL@CAMERA@PAGE01@INSTRUCTION_CONTROLLER"
msgstr "To move your cursor and the camera around, use [ci_leftstick/]"

msgid "TUTORIAL@CAMERA@PAGE01@OBJECTIVE"
msgstr "Move Camera"

msgid "TUTORIAL@CAMERA@PAGE01@TITLE"
msgstr "Camera Controls"

msgid "TUTORIAL@CAMERA@PAGE02@INSTRUCTION"
msgstr "To rotate the camera, hold the [middlemousebutton/] middle mouse button and drag your mouse.[br/][br/]Press R to reset your rotation."

msgid "TUTORIAL@CAMERA@PAGE02@INSTRUCTION_CONTROLLER"
msgstr "To rotate the camera, use [ci_rightstick/].[br/][br/]Press [ci_rightstickpress/] to reset your rotation."

msgid "TUTORIAL@CAMERA@PAGE02@OBJECTIVE"
msgstr "Reset Camera"

msgid "TUTORIAL@CAMERA@PAGE03@DESCRIPTION"
msgstr "You can take a closer look at the land by zooming in. Or get a better overview of the world by zooming out. Zoom out far enough to reach the overview map."

msgid "TUTORIAL@CAMERA@PAGE03@INSTRUCTION"
msgstr "Zoom in and out by scrolling the [middlemousebutton/] middle mouse button."

msgid "TUTORIAL@CAMERA@PAGE03@INSTRUCTION_CONTROLLER"
msgstr "Zoom in and out using [ci_rightstickupdown/]."

msgid "TUTORIAL@CAMERA@PAGE03@OBJECTIVE"
msgstr "Reach the overview map"

msgid "TUTORIAL@CAMERA@TITLE"
msgstr "Camera Controls"

msgid "TUTORIAL@CITIES@DESCRIPTION"
msgstr "Tutorial on how to manage your cities."

msgid "TUTORIAL@CITIES@PAGE00@INSTRUCTION"
msgstr "To learn more about city management, select your city: {VarThroneCity.Name} on the map."

msgid "TUTORIAL@CITIES@PAGE01@DESCRIPTION"
msgstr "You have selected one of your cities. Cities are central to your economy, and allow you to build more units for your armies."

msgid "TUTORIAL@CITIES@PAGE01@INSTRUCTION"
msgstr "{GLOBAL.FoodConcept.Hyperlink}, {GLOBAL.UnitProductionConcept.Hyperlink}, and {GLOBAL.StructureProductionConcept.Hyperlink} are resources used to develop your cities.[br/][br/]{GLOBAL.GoldConcept.Hyperlink}, {GLOBAL.ManaConcept.Hyperlink}, {GLOBAL.ImperiumConcept.Hyperlink}, and {GLOBAL.KnowledgeConcept.Hyperlink} are resources that can be spent on any city, unit or spell."

msgid "TUTORIAL@CITIES@PAGE01@OBJECTIVE"
msgstr "Select your city"

msgid "TUTORIAL@CITIES@PAGE01@TITLE"
msgstr "Managing your cities"

msgid "TUTORIAL@CITIES@PAGE02@DESCRIPTION"
msgstr "<<m:{GLOBAL.LocationConcept.Hyperlink}>> and <<m:{GLOBAL.ProvinceImprovementConcept.Hyperlink}>> located in a city's domain will provide you with income.[br/][br/][hyperlink,GLOBAL.CityStructureConcept]Structures[/hyperlink] can be also be built to provide extra income, as well as unlocking units and boosting the city's defenses."

msgid "TUTORIAL@CITIES@PAGE02@INSTRUCTION"
msgstr "Select the [cityupgradeproduction/] hammer button located in the right side of the city panel and choose a structure to build.[br/][br/][recommended/] Recommendation: Build a [food/] {VarCityUpgradeTwo} or [structureprod/] {VarCityUpgradeOne}."

msgid "TUTORIAL@CITIES@PAGE02@OBJECTIVE"
msgstr "Start building a structure"

msgid "TUTORIAL@CITIES@PAGE03@DESCRIPTION"
msgstr "Cities also recruit your units. Units cost [hyperlink,GLOBAL.UnitUpkeepConcept.Hyperlink]Upkeep[/hyperlink] every turn, so keep an eye on your income to ensure you can pay for your units."

msgid "TUTORIAL@CITIES@PAGE03@INSTRUCTION"
msgstr "Select the [cityunitproduction/] helmet button located under the production queue and choose a unit to recruit.[br/][br/][recommended/] Your faction's [unitScout/] {GLOBAL.PROPERTIES.SCOUT_UNIT.Hyperlink} is the {VarScoutUnit}"

msgid "TUTORIAL@CITIES@PAGE03@OBJECTIVE"
msgstr "Start recruiting a [unitScout/]{VarScoutUnit}"

msgid "TUTORIAL@CITIES@TITLE"
msgstr "City Management"

msgid "TUTORIAL@CITYCAP@DESCRIPTION"
msgstr "Tutorial on City Cap"

msgid "TUTORIAL@CITYCAP@PAGE01@DESCRIPTION"
msgstr "You are close to reaching your maximum number of cities. Acquiring more cities than your maximum will result in major economic penalties."

msgid "TUTORIAL@CITYCAP@PAGE01@INSTRUCTION"
msgstr "You can increase your {GLOBAL.CityCapConcept.Hyperlink} via the Empire Development Tree or you can continue to grow your empire by making newly acquired cities your <<m:{GLOBAL.PvEVassalConcept.Hyperlink}>> instead."

msgid "TUTORIAL@CITYCAP@PAGE01@TITLE"
msgstr "City Cap"

msgid "TUTORIAL@CITYCAP@TITLE"
msgstr "City Cap"

msgid "TUTORIAL@CITYEXPANSION@DESCRIPTION"
msgstr "Tutorial on annexing new provinces to your cities"

msgid "TUTORIAL@CITYEXPANSION@PAGE00@INSTRUCTION"
msgstr "Select a city that has increased its population."

msgid "TUTORIAL@CITYEXPANSION@PAGE01@DESCRIPTION"
msgstr "This city has grown and gained a new {GLOBAL.PopulationConcept.Hyperlink}. Each additional population enables you to expand the city's domain by placing a {GLOBAL.ProvinceImprovementConcept.Hyperlink}."

msgid "TUTORIAL@CITYEXPANSION@PAGE01@TITLE"
msgstr "City Expansion"

msgid "TUTORIAL@CITYEXPANSION@PAGE02@DESCRIPTION"
msgstr "Every {GLOBAL.ProvinceConcept.Hyperlink} has different features which determine what type of improvement can be built in it."

msgid "TUTORIAL@CITYEXPANSION@PAGE02@INSTRUCTION"
msgstr "Click [leftmousebutton/] on the pin button [province/] to add the province to your city's domain.[br/][br/]Remember that provinces with <<m:{GLOBAL.NodeConcept.Hyperlink}>> will give you more income."

msgid "TUTORIAL@CITYEXPANSION@PAGE02@INSTRUCTION_CONTROLLER"
msgstr "Select the pin button [province/] in the city panel to start selecting a province and improvement to build there."

msgid "TUTORIAL@CITYEXPANSION@PAGE02@OBJECTIVE"
msgstr "Place a province improvement"

msgid "TUTORIAL@CITYEXPANSION@TITLE"
msgstr "City Expansion"

msgid "TUTORIAL@CITYPRODUCTION@DESCRIPTION"
msgstr "Tutorial on city production."

msgid "TUTORIAL@CITYPRODUCTION@TITLE"
msgstr "City Production"

msgid "TUTORIAL@COMBATEENGAGEMENT@DESCRIPTION"
msgstr "Tutorial on starting combat with hostile armies"

msgid "TUTORIAL@COMBATEENGAGEMENT@PAGE01@DESCRIPTION"
msgstr "You are about to enter combat. Inspect all participants and their combined strength before deciding if you want to fight manually or have your army automatically fight the battle."

msgid "TUTORIAL@COMBATEENGAGEMENT@PAGE01@INSTRUCTION"
msgstr "If you use Auto Combat, the fight will be simulated and you will be able to replay the battle yourself if you don't like the results."

msgid "TUTORIAL@COMBATEENGAGEMENT@PAGE01@TITLE"
msgstr "Combat Preview"

msgid "TUTORIAL@COMBATEENGAGEMENT@TITLE"
msgstr "Starting Combat"

msgid "TUTORIAL@DEFENDINGYOURCITY@DESCRIPTION"
msgstr "Cities without defending <<m:{GLOBAL.ArmyConcept.Hyperlink}>> are vulnerable, but building [hyperlink,GLOBAL.CityWallStructureConcept]Walls[/hyperlink] will force attackers to besiege a city giving you valuable time to bring in reinforcements."

msgid "TUTORIAL@DEFENDINGYOURCITY@INSTRUCTIONS"
msgstr "Building {GLOBAL.STRUCTURE_UPGRADES.PALISADE_WALLS.Hyperlink} will grant basic protection to your new cities and unlock more advanced defenses such as the {GLOBAL.STRUCTURE_UPGRADES.CALTROP_STASH.Hyperlink} and {GLOBAL.STRUCTURE_UPGRADES.ARCHER_BATTLEMENTS.Hyperlink}.[br/][br/]Your {GLOBAL.ThroneCityConcept.Hyperlink} starts with {GLOBAL.STRUCTURE_UPGRADES.PALISADE_WALLS} already constructed."

msgid "TUTORIAL@DEFENDINGYOURCITY@SUMMARY"
msgstr "A tutorial about defending your cities"

msgid "TUTORIAL@DEFENDINGYOURCITY@TITLE"
msgstr "Defending Your Cities"

msgid "TUTORIAL@DIPLOMACY@DESCRIPTION"
msgstr "Tutorial on diplomatic interactions with other Rulers"

msgid "TUTORIAL@DIPLOMACY@PAGE00@OBJECTIVE"
msgstr "Open the Diplomacy screen with another player."

msgid "TUTORIAL@DIPLOMACY@PAGE01@DESCRIPTION"
msgstr "You have encountered another {GLOBAL.LeaderConcept}. They will be your biggest roadblock to victory. But they may also prove to be powerful allies."

msgid "TUTORIAL@DIPLOMACY@PAGE01@TITLE"
msgstr "Diplomacy"

msgid "TUTORIAL@DIPLOMACY@PAGE02@DESCRIPTION"
msgstr "This overview will show you in-depth information about another Ruler: their personality, <<m:{GLOBAL.TreatyConcept.Hyperlink}>> and current [hyperlink,GLOBAL.EmpireRelationConcept]Relations[/hyperlink] with you."

msgid "TUTORIAL@DIPLOMACY@PAGE02@INSTRUCTION"
msgstr "Inspect the other Ruler and decide if this is someone you wish to forge an alliance with, to defeat... Or anything in between."

msgid "TUTORIAL@DIPLOMACY@TITLE"
msgstr "Diplomacy"

msgid "TUTORIAL@EMBALMING@DESCRIPTION"
msgstr "Tutorial on Prison and Crypt and Embalmed Sacrifices"

msgid "TUTORIAL@EMBALMING@PAGE01@TITLE"
msgstr "Prison & Crypt and Embalmed Sacrifices"

msgid "TUTORIAL@EMBALMING@TITLE"
msgstr "Cult of Death: Prison & Crypt and Embalmed Sacrifices"

msgid "TUTORIAL@EMBALMING_PAGE01@DESCRIPTION"
msgstr "A defeated hero has been put in your prison or crypt. You can either hand them over to their rightful owners for a reward, or if they are in your crypt, embalm them to gain [hyperlink,GLOBAL.EmbalmedSacrificeConcept][embalmedsacrifice/]Embalmed Sacrifices[/hyperlink]. You may execute heroes in your prison to move them to the crypt."

msgid "TUTORIAL@EMBALMING_PAGE01@INSTRUCTIONS"
msgstr "As the Cult of Death, you may use [hyperlink,GLOBAL.EmbalmedSacrificeConcept][embalmedsacrifice/]Embalmed Sacrifices[/hyperlink] to build powerful City Structures or cast {GLOBAL.SPECIAL_OPERATIONS.MORBID_SACRIFICE.Hyperlink}.[br/]Upgrading your {GLOBAL.WizardTowerConcept.Hyperlink} in the {GLOBAL.ThroneCityConcept.Hyperlink} will unlock <<m:{GLOBAL.CityStructureConcept.Hyperlink}>> that grant additional benefits to the prison and crypt."

msgid "TUTORIAL@EMPIREDEVELOPMENT@DESCRIPTION"
msgstr "Tutorial on gaining empire skills"

msgid "TUTORIAL@EMPIREDEVELOPMENT@PAGE01@DESCRIPTION"
msgstr "This is the empire development tree. Here you will specialize your empire towards certain play styles. Increase your empire's {GLOBAL.AffinityConcept.Hyperlink} to open more options."

msgid "TUTORIAL@EMPIREDEVELOPMENT@PAGE01@INSTRUCTION"
msgstr "Learn about each empire skill by hovering over it."

msgid "TUTORIAL@EMPIREDEVELOPMENT@PAGE01@TITLE"
msgstr "Empire Development"

msgid "TUTORIAL@EMPIREDEVELOPMENT@PAGE02@DESCRIPTION"
msgstr "You will progress toward unlocking your next empire skill every turn, depending on your {GLOBAL.AffinityConcept.Hyperlink} values. Unlocked skills can be obtained by spending {GLOBAL.ImperiumConcept.Hyperlink}."

msgid "TUTORIAL@EMPIREDEVELOPMENT@PAGE02@INSTRUCTION"
msgstr "Most skills provide passive bonuses, but some skills provide you with a one time bonus like resources or units."

msgid "TUTORIAL@EMPIREDEVELOPMENT@TITLE"
msgstr "Empire Skills"

msgid "TUTORIAL@ENCHANTMENTS@DESCRIPTION"
msgstr "Tutorial on enchanting units"

msgid "TUTORIAL@ENCHANTMENTS@PAGE01@DESCRIPTION"
msgstr "You have just researched a {GLOBAL.UnitEnchantmentConcept.Hyperlink} spell. These spells allow you to empower your armies. They apply to all units with a specific role and cost upkeep for each unit affected."

msgid "TUTORIAL@ENCHANTMENTS@PAGE01@INSTRUCTION"
msgstr "In order to use the enchantment you'll need to cast it. You can do this from the Spell Book."

msgid "TUTORIAL@ENCHANTMENTS@PAGE01@INSTRUCTION_CONTROLLER"
msgstr "In order to use the enchantment, you'll need to cast it. Press [ci_buttony/] to open the radial menu and select the [spellbutton/] Spells button."

msgid "TUTORIAL@ENCHANTMENTS@PAGE01@OBJECTIVE"
msgstr "Open the Spell Book."

msgid "TUTORIAL@ENCHANTMENTS@PAGE01@TITLE"
msgstr "Unit Enchantments"

msgid "TUTORIAL@ENCHANTMENTS@PAGE02@DESCRIPTION"
msgstr "Race transformations will cost a lot in terms of resources. The changes they make are more drastic and powerful and cannot be reversed. Your entire race will evolve into something... more."

msgid "TUTORIAL@ENCHANTMENTS@PAGE02@TITLE"
msgstr "Transformations"

msgid "TUTORIAL@ENCHANTMENTS@TITLE"
msgstr "Enchantments"

msgid "TUTORIAL@FEUDAL_HOUSES@DESCRIPTION"
msgstr "Tutorial on Feudal Houses (Aristocracy)"

msgid "TUTORIAL@FEUDAL_HOUSES@TITLE"
msgstr "Feudal Aristocracy: Feudal Houses"

msgid "TUTORIAL@FEUDAL_HOUSES_PAGE01@DESCRIPTION"
msgstr "You have just founded a {GLOBAL.FeudalHouseConcept.Hyperlink}, this is a unique entity for the Feudal Aristocracy to manage."

msgid "TUTORIAL@FEUDAL_HOUSES_PAGE01@INSTRUCTIONS"
msgstr "The assigned Governor is now the {GLOBAL.PROPERTIES.LIEGE_LORD.Hyperlink} of this House, any units produced in this city or summoned into armies of this House will likewise become part of their House and gain benefits from fighting alongside their Liege!"

msgid "TUTORIAL@FEUDAL_HOUSES_PAGE02@DESCRIPTION"
msgstr "As the House's {GLOBAL.PROPERTIES.LIEGE_LORD.Hyperlink} gains {GLOBAL.RenownConcept.Hyperlink}, units of that house gain {GLOBAL.ExperienceConcept.Hyperlink} and the {G LOBAL.PROPERTIES.LIEGE_LORD.Hyperlink}'s effect increases."

msgid "TUTORIAL@FEUDAL_HOUSES_PAGE02@INSTRUCTIONS"
msgstr "Field units of each House alongside their {GLOBAL.PROPERTIES.LIEGE_LORD.Hyperlink} to drastically reduce their upkeep and increase their effectiveness!"

msgid "TUTORIAL@FREECITIES@DESCRIPTION"
msgstr "Tutorial on interacting with Free Cities"

msgid "TUTORIAL@FREECITIES@PAGE01@DESCRIPTION"
msgstr "You have encountered a free city. They are independents that can be vassalized, integrated or conquered."

msgid "TUTORIAL@FREECITIES@PAGE01@INSTRUCTION"
msgstr "Inspect the Free City and give them a {GLOBAL.DiplomaticTokenConcept.Hyperlink} to start building a relationship with them."

msgid "TUTORIAL@FREECITIES@PAGE01@TITLE"
msgstr "Free Cities"

msgid "TUTORIAL@FREECITIES@TITLE"
msgstr "Free Cities"

msgid "TUTORIAL@FRONT_END@FACTION_CREATION@DESCRIPTION_PRIMARY"
msgstr "In the following steps, you will create your people, followed by your Ruler."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION@DESCRIPTION_SECONDARY"
msgstr "For your first faction, we suggest you focus on the theme instead of the numbers; role-play your favorite trope or go crazy with experimentation!"

msgid "TUTORIAL@FRONT_END@FACTION_CREATION@NAME"
msgstr "Faction Creation"

msgid "TUTORIAL@FRONT_END@FACTION_CREATION@RECOMMENDED"
msgstr "[recommended/] Each tutorial will suggest a good option, if you’re unsure what to pick."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_ADVANCED_SETTINGS@DESCRIPTION_PRIMARY"
msgstr "In this step, you can customize your faction further to control how your faction acts when under AI control."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_ADVANCED_SETTINGS@DESCRIPTION_SECONDARY"
msgstr "This section allows you to create a list of city names for your faction to use, as well as to create extra heroes who you will be able to recruit as the game progresses.[br/][br/]It also lets you control how the AI will behave when it controls your faction, letting you control the tomes it will research and the way it will behave diplomatically."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_ADVANCED_SETTINGS@NAME"
msgstr "Faction Creation: Advanced Settings"

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_CULTURE@DESCRIPTION_PRIMARY"
msgstr "In this step, you will pick your people’s culture, which defines your starting units and economy."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_CULTURE@DESCRIPTION_SECONDARY"
msgstr "Some cultures have subcultures that have slightly different units and mechanics.[br/][br/]The icons ([order/] [chaos/] [matter/] [nature/] [arcana/] [shadow/]) next to the culture names are called [hyperlink,GLOBAL.AffinityConcept]Magic Affinities[/hyperlink], reflecting your people’s attunement to 6 cosmic forces. Your affinity score has a big impact on your playstyle!"

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_CULTURE@NAME"
msgstr "Faction Creation: Culture"

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_CULTURE@RECOMMENDED"
msgstr "[recommended/] Feudal - Monarchy is an easy to play culture where your Ruler gives bonuses to their units in battle."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_FINALIZE@DESCRIPTION_PRIMARY"
msgstr "You’re nearly done, all that’s left now is to name your Ruler and race, and you can begin!"

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_FINALIZE@DESCRIPTION_SECONDARY"
msgstr "If you wish, you can also change your Ruler's {GLOBAL.AmbitionConcept.Hyperlink} or look at the Advanced Settings which let you customize your race even further, but we recommend that you leave that for later once you’ve had time to familiarize yourself with the game itself!"

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_FINALIZE@NAME"
msgstr "Faction Creation: Finalize"

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_FORM@DESCRIPTION_PRIMARY"
msgstr "In this step, you can choose your faction’s physical form, which controls how they look and affects their performance in battle."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_FORM@DESCRIPTION_SECONDARY"
msgstr "Each form has its own set of traits, which affects their abilities in battle as well as the types of terrain they find comfortable and if they can ride special mounts. If you don’t like a Form’s default traits, you can always change them to something else!"

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_FORM@NAME"
msgstr "Faction Creation: Form"

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_FORM@RECOMMENDED"
msgstr "[recommended/] Humans are an easy to play form that develop quickly and are resilient to damage."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_RULER_AMBITION@DESCRIPTION_PRIMARY"
msgstr "In this step, you can pick an ambition that your Ruler can fulfill in order to earn bonuses that affect your throne city."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_RULER_AMBITION@DESCRIPTION_SECONDARY"
msgstr "Each ambition has 2 objectives for your Ruler to fulfill. A major one that can only be completed once, and a minor one that can be completed repeatedly.[br/][br/]Fulfilling ambitions grants {GLOBAL.RenownConcept.Hyperlink}, which strengthens the bonuses your Ruler grants to your starting city."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_RULER_AMBITION@NAME"
msgstr "Faction Creation: Ruler Ambition"

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_RULER_AMBITION@RECOMMENDED"
msgstr "[recommended/] Instructor is a simple ambition which you fulfill by accompanying your units in battle."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_RULER_APPEARANCE@DESCRIPTION_PRIMARY"
msgstr "In this step, you can change how your Ruler looks, as well as their class, which determines their abilities in battle."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_RULER_APPEARANCE@DESCRIPTION_SECONDARY"
msgstr "Once you’ve chosen a class, you can choose which equipment your Ruler will start with. You can always change your equipment later in game, as long as the new equipment is compatible with your class![br/][br/]The rest of the choices only affect your appearance, and the appearance of your race’s units. Feel free to pick whatever you wish, it will have no impact on your stats or economy."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_RULER_APPEARANCE@NAME"
msgstr "Faction Creation: Ruler Appearance"

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_RULER_APPEARANCE@RECOMMENDED"
msgstr "[recommended/] The Warrior is a powerful class, focused on melee combat and survivability."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_RULER_ORIGIN@DESCRIPTION_PRIMARY"
msgstr "In this step, you will start to create your Ruler, a powerful hero who accompanies your armies and carries out your will!"

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_RULER_ORIGIN@DESCRIPTION_SECONDARY"
msgstr "The Ruler origin grants a number of economic bonuses to your empire, as well as determining the kinds of abilities they have in combat."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_RULER_ORIGIN@NAME"
msgstr "Faction Creation: Ruler Origin"

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_RULER_ORIGIN@RECOMMENDED"
msgstr "[recommended/] The Champion is a good choice for a strong starting army and a large throne city."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_SOCIETY_TRAITS@DESCRIPTION_PRIMARY"
msgstr "In this step, you will pick two society traits, which shape how your race plays on the world map."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_SOCIETY_TRAITS@DESCRIPTION_SECONDARY"
msgstr "Each society trait gives an economic bonus that rewards a particular playstyle, as well as a small starting bonus that helps you when the game starts. Some also affect your race’s starting {GLOBAL.AlignmentConcept.Hyperlink}, which has a big impact on how rival empires view you.[br/][br/]Like cultures, your society traits also affect your [hyperlink,GLOBAL.AffinityConcept]Magic Affinity[/hyperlink]!"

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_SOCIETY_TRAITS@NAME"
msgstr "Faction Creation: Society Traits"

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_SOCIETY_TRAITS@RECOMMENDED"
msgstr "[recommended/] Gifted Casters makes it easier to cast spells.[br/][recommended/] Fabled Hunters increases the rewards you get from battles.[br/][recommended/] Prolific Swarmers strengthens early game units."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_TOME@DESCRIPTION_PRIMARY"
msgstr "In this step you will pick a starting Tome—a collection of magical spells, units and bonuses that you will be able to research to empower your empire."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_TOME@DESCRIPTION_SECONDARY"
msgstr "A tome represents a path that your race will follow as they develop through magical research. They contain spells, units, and enchantments you can use to empower and even transform your people![br/][br/]You will be able to choose more tomes later in the game, once you’ve researched enough skills."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_TOME@NAME"
msgstr "Faction Creation: Tome"

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_TOME@RECOMMENDED"
msgstr "[recommended/] The Tome of Pyromancy has a good selection of powerful fire spells, as well as 2 [unitBattleMage/]<<m:{GLOBAL.PROPERTIES.BATTLE_MAGE.Hyperlink}>> to reinforce your armies."

msgid "TUTORIAL@FRONT_END@REALM_SELECTION@DESCRIPTION_PRIMARY"
msgstr "On this screen you choose where your grand adventure will begin. You can choose a premade realm for a unique experience, or create a realm of your own to explore!"

msgid "TUTORIAL@FRONT_END@REALM_SELECTION@DESCRIPTION_SECONDARY"
msgstr "[bulletlist][bullet/]Story Realms have extra narrative, telling the saga of Magehaven and the Astral Sea.[bullet/]Challenge Realms have special rules and mechanics for experienced players. [bullet/]Unknown Realms have randomized, hidden traits that you discover as you play and are not for the faint hearted![/bulletlist]"

msgid "TUTORIAL@FRONT_END@REALM_SELECTION@NAME"
msgstr "Realm Selection"

msgid "TUTORIAL@FRONT_END@REALM_SELECTION@RECOMMENDED"
msgstr "[recommended/] For your first adventure, the Fields of Rebirth is a relaxing introduction to the game."

msgid "TUTORIAL@FRONT_END@REALM_SETUP@DESCRIPTION_PRIMARY"
msgstr "Here you can create your own realm in the Astral Sea for you to explore. You can choose how many other Rulers will be present, as well as how powerful they are."

msgid "TUTORIAL@FRONT_END@REALM_SETUP@DESCRIPTION_SECONDARY"
msgstr "Customize Realm lets you select a number of realm traits—these are advanced settings that can radically change how a realm plays. You can change the realm’s geography and inhabitants, as well as adding special rules or victory conditions.[br/][br/]Advanced Settings gives you even more control about how your realm is configured and the rules that govern how the game functions."

msgid "TUTORIAL@FRONT_END@REALM_SETUP@NAME"
msgstr "Realm Setup"

msgid "TUTORIAL@FRONT_END@REALM_SETUP@RECOMMENDED"
msgstr "[recommended/] For your first adventure, it is not recommended that you add any traits to the realm."

msgid "TUTORIAL@GOVERNORS@DESCRIPTION"
msgstr "Tutorial on city governors"

msgid "TUTORIAL@GOVERNORS@PAGE01@DESCRIPTION"
msgstr "You have opened the governor assignment menu. Here you can see all available <<m:{GLOBAL.HeroConcept.Hyperlink}>> that can become the governor of this city, along with the bonuses they would provide."

msgid "TUTORIAL@GOVERNORS@PAGE01@TITLE"
msgstr "Governors"

msgid "TUTORIAL@GOVERNORS@TITLE"
msgstr "Governors"

msgid "TUTORIAL@GRIEVANCES@DESCRIPTION"
msgstr "Tutorial on declaring wars and the grievances required to justify them"

msgid "TUTORIAL@GRIEVANCES@PAGE01@DESCRIPTION"
msgstr "You have just gained or caused a {GLOBAL.CasusBelliConcept.Hyperlink} against another Ruler. These are used to justify wars. You could also forgive them to improve your [hyperlink,GLOBAL.EmpireRelationConcept]Relations[/hyperlink]."

msgid "TUTORIAL@GRIEVANCES@PAGE01@INSTRUCTION"
msgstr "Your wars need to be justified, otherwise they are considered [evilact/] evil. Your {GLOBAL.WarJustificationConcept.Hyperlink} is determined by both your <<m:{GLOBAL.CasusBelliConcept}>> and those of the other Ruler. They can be inspected by hovering over the [casusBelli/] icon in the diplomacy overview."

msgid "TUTORIAL@GRIEVANCES@PAGE01@TITLE"
msgstr "War Declaration & Grievances"

msgid "TUTORIAL@GRIEVANCES@TITLE"
msgstr "Declaring War & Grievances"

msgid "TUTORIAL@HEROES@DESCRIPTION"
msgstr "Tutorial on what you can do with heroes and how to get additional ones."

msgid "TUTORIAL@HEROES@PAGE00@INSTRUCTION"
msgstr "Select an army with a hero and [rightmousebutton/] right-click the hero portrait to inspect that hero. A silver army banner signifies an army led by a hero. A golden army banner signifies an army led by a special hero: your Ruler."

msgid "TUTORIAL@HEROES@PAGE00@INSTRUCTION_CONTROLLER"
msgstr "Select an army with a hero, press [ci_dpaddown/] to go into the army panel, then press [ci_buttony/] to inspect that hero. A silver army banner signifies an army led by a hero. A golden army banner signifies an army led by a special hero: your Ruler."

msgid "TUTORIAL@HEROES@PAGE01@DESCRIPTION"
msgstr "You have selected a hero. Heroes lead your armies around the world. Only they have the authority to explore <<m:{GLOBAL.AncientWonderConcept.Hyperlink}>> and start <<m:{GLOBAL.SiegeConcept.Hyperlink}>>. They can also construct <<m:{GLOBAL.OutpostConcept.Hyperlink}>> in order to [hyperlink,GLOBAL.FoundingConcept]Found Cities[/hyperlink]"

msgid "TUTORIAL@HEROES@PAGE01@INSTRUCTION"
msgstr "Level up heroes by using them in {GLOBAL.CombatConcept.Hyperlink} and equip them with items you find as loot."

msgid "TUTORIAL@HEROES@PAGE01@OBJECTIVE"
msgstr "Open the Hero Panel"

msgid "TUTORIAL@HEROES@PAGE01@TITLE"
msgstr "Rulers & Heroes"

msgid "TUTORIAL@HEROES@TITLE"
msgstr "Rulers & Heroes"

msgid "TUTORIAL@HEROLEVELING@DESCRIPTION"
msgstr "Tutorial on selecting skills when a hero levels up"

msgid "TUTORIAL@HEROLEVELING@PAGE01@DESCRIPTION"
msgstr "One of your <<m:{GLOBAL.HeroConcept.Hyperlink}>> has gained a level! This grants them a skill point they can spend on a hero skill from one of their skill trees."

msgid "TUTORIAL@HEROLEVELING@PAGE01@INSTRUCTION"
msgstr "Select your hero and open the level up screen from the unit panel to view your available hero skills."

msgid "TUTORIAL@HEROLEVELING@PAGE01@TITLE"
msgstr "Hero Level Up"

msgid "TUTORIAL@HEROLEVELING@TITLE"
msgstr "Hero Level Up"

msgid "TUTORIAL@HEROLEVELINGSCREEN@DESCRIPTION"
msgstr "Tutorial on opening the hero skill trees"

msgid "TUTORIAL@HEROLEVELINGSCREEN@PAGE01@DESCRIPTION"
msgstr "On this panel, you can acquire new skills to upgrade your hero, granting them new active abilities as well as powerful passive bonuses."

msgid "TUTORIAL@HEROLEVELINGSCREEN@PAGE01@INSTRUCTION"
msgstr "A hero gains a new skill point each time they level up. Every few levels they also gain a [hyperlink,GLOBAL.HeroDedication]Signature Skill[/hyperlink], which unlocks new skills and grants a bonus skill point."

msgid "TUTORIAL@HEROLEVELINGSCREEN@PAGE01@TITLE"
msgstr "Hero Skill Trees"

msgid "TUTORIAL@HEROLEVELINGSCREEN@TITLE"
msgstr "Hero Skill Trees"

msgid "TUTORIAL@HERORECRUITMENT@DESCRIPTION"
msgstr "Here you can recruit a new {GLOBAL.HeroConcept.Hyperlink}, if your {GLOBAL.HeroCapConcept.Hyperlink} is high enough. Your hero cap increases over time, but you can spend {GLOBAL.ImperiumConcept.Hyperlink} to increase it immediately.[br/][br/]Heroes from your own realm are always available, but heroes from the <<m:{GLOBAL.IndependentCityConcept.Hyperlink}>> you meet can also appear."

msgid "TUTORIAL@HERORECRUITMENT@INSTRUCTION"
msgstr "<<m:{GLOBAL.HeroConcept.Hyperlink}>> who originate from other <<m:{GLOBAL.IndependentCityConcept.Hyperlink}>> have their own race, granting them different bonuses and abilities."

msgid "TUTORIAL@HERORECRUITMENT@SUMMARY"
msgstr "Tutorial about hero recruitment"

msgid "TUTORIAL@HERORECRUITMENT@TITLE"
msgstr "Hero Recruitment"

msgid "TUTORIAL@HOSTAGE_DIPLOMACY@DESCRIPTION"
msgstr "Tutorial on Hostage Diplomacy (Cult of Tyranny)"

msgid "TUTORIAL@HOSTAGE_DIPLOMACY@TITLE"
msgstr "Cult of Tyranny: Hostage Diplomacy"

msgid "TUTORIAL@HOSTAGE_DIPLOMACY_PAGE01@DESCRIPTION"
msgstr "The Dark Subculture \"Cult of Tyranny\" uses heroes in their prison to take control of Free Cities and exploit Vassals."

msgid "TUTORIAL@HOSTAGE_DIPLOMACY_PAGE01@INSTRUCTIONS"
msgstr "[bulletlist][bullet/]Defeated <<m:{GLOBAL.HeroConcept.Hyperlink}>> belonging to <<m:{GLOBAL.IndependentCityConcept.Hyperlink}>> become Hostages in your {GLOBAL.PrisonConcept.Hyperlink}.[bullet/]Hostages provide {GLOBAL.HouseInfluenceConcept.Hyperlink} every turn and count as an assigned {GLOBAL.DiplomaticTokenConcept.Hyperlink}.[bullet/]Conquered Cities released as Vassals also immediately grant you a Hostage.[bullet/]When Vassalizing a city that belonged to another {GLOBAL.EmpireConcept.Hyperlink}, all <<m:{GLOBAL.HeroConcept.Hyperlink}>> of that empire in your prison become hostages of this new Vassal instead.[/bulletlist]"

msgid "TUTORIAL@HOSTILECITY@DESCRIPTION"
msgstr "Tutorial on hostile Free Cities"

msgid "TUTORIAL@HOSTILECITY@PAGE1@DESCRIPTION"
msgstr "You have encountered a hostile {GLOBAL.IndependentCityConcept.Hyperlink}. They are independents that can be vassalized, integrated or conquered."

msgid "TUTORIAL@HOSTILECITY@PAGE1@INSTRUCTION"
msgstr "This city is at {GLOBAL.IndependentCityWarConcept.Hyperlink} with you. You can defeat them through conquest, or negotiate a peace, after which you can give them a {GLOBAL.DiplomaticTokenConcept.Hyperlink} to start building a relationship with them."

msgid "TUTORIAL@HOSTILECITY@TITLE"
msgstr "Hostile Free City"

msgid "TUTORIAL@IMPERIUM@DESCRIPTION"
msgstr "Tutorial on Imperium"

msgid "TUTORIAL@IMPERIUM@INSTRUCTIONS"
msgstr "Imperium income can be increased by building parts of your Wizard Tower in your {GLOBAL.ThroneCityConcept.Hyperlink} or by annexing <<m:{GLOBAL.AncientWonderConcept.Hyperlink}>>."

msgid "TUTORIAL@IMPERIUM@PAGE01@DESCRIPTION"
msgstr "You have gathered a large amount of {GLOBAL.ImperiumConcept.Hyperlink}. This represents the influence you have over the world. You can use it to acquire new cities, unlock new <<m:{GLOBAL.EmpireSkillConcept.Hyperlink}>> or speed up city growth."

msgid "TUTORIAL@IMPERIUM@PAGE01@INSTRUCTION"
msgstr "Imperium is mainly gained by building parts of your {GLOBAL.WizardTowerConcept.Hyperlink} in your {GLOBAL.ThroneCityConcept.Hyperlink} or by annexing <<m:{GLOBAL.AncientWonderConcept.Hyperlink}>>."

msgid "TUTORIAL@IMPERIUM@PAGE01@OBJECTIVE"
msgstr "Open the Empire Skill Tree"

msgid "TUTORIAL@IMPERIUM@PAGE01@TITLE"
msgstr "Imperium"

msgid "TUTORIAL@IMPERIUM@TITLE"
msgstr "Imperium"

msgid "TUTORIAL@INFESTATIONS@DESCRIPTION"
msgstr "Tutorial on infestations"

msgid "TUTORIAL@INFESTATIONS@PAGE01@DESCRIPTION"
msgstr "An infestation is close by. Invading armies will be sent from its spawner location to your lands if left unchecked for too long. Destroying them, however, might prove challenging."

msgid "TUTORIAL@INFESTATIONS@PAGE01@TITLE"
msgstr "Infestations"

msgid "TUTORIAL@INFESTATIONS@TITLE"
msgstr "Infestations"

msgid "TUTORIAL@ITEMFORGE@DESCRIPTION"
msgstr "Tutorial on the Item Forge"

msgid "TUTORIAL@ITEMFORGE@PAGE01@DESCRIPTION"
msgstr "This is the Item Forge, where you can forge new items for your Heroes. Making items costs {GLOBAL.BindingEssenceConcept.Hyperlink}, which you gain by disenchanting the Items in your Arsenal."

msgid "TUTORIAL@ITEMFORGE@PAGE01@INSTRUCTION"
msgstr "Higher tier items also cost [bindingfragments/] Binding Fragments, which can only be gained by disenchanting higher tier items.[br/][br/]You can empower your items with Infusions to grant them special properties. You can get access to more infusions by collecting <<m:{GLOBAL.MagicMaterialConcept.Hyperlink}>>. Collecting more of the same material will unlock more powerful infusions."

msgid "TUTORIAL@ITEMFORGE@PAGE01@TITLE"
msgstr "Item Forge"

msgid "TUTORIAL@ITEMFORGE@PAGE02@INSTRUCTION"
msgstr "Each Infusion has a point cost. The total amount of points used determines the tier of the item. Higher tier items:[bulletlist][bullet/]Cost more {GLOBAL.BindingEssenceConcept.Name}.[bullet/]Take longer to craft.[bullet/]Do more damage (in the case of weapons).[/bulletlist][br/][br/]Only one item can be crafted at a time. If you cancel crafting, all resources spent will be refunded."

msgid "TUTORIAL@ITEMFORGE@TITLE"
msgstr "Item Forge"

msgid "TUTORIAL@LAVA@DESCRIPTION"
msgstr "Tutorial about lava provinces found on the world map."

msgid "TUTORIAL@LAVA@TITLE"
msgstr "Lava Provinces"

msgid "TUTORIAL@LAVA@TUTORIAL_DESCRIPTION"
msgstr "You have discovered a lava province. You can annex lava provinces to grow your empire, but doing so will negatively affect your {GLOBAL.CityStabilityConcept.Hyperlink}. Only units with specific properties will be able to traverse lava."

msgid "TUTORIAL@LAVA@TUTORIAL_INSTRUCTION"
msgstr "The {GLOBAL.CityStabilityConcept.Hyperlink} penalty can be avoided by having either the Underground or Desolate Adaptation.[br/][br/]You can build the {GLOBAL.MineConcept.Hyperlink} and {GLOBAL.ConduitConcept.Hyperlink} <<m:{GLOBAL.ProvinceImprovementConcept.Hyperlink}>> in this sector.[br/][br/]{GLOBAL.PROPERTIES.FLYING_MOVEMENT.Hyperlink} and {GLOBAL.PROPERTIES.FLOATING_MOVEMENT.Hyperlink} units can traverse this sector without any issues, but land walking units will need {GLOBAL.PROPERTIES.LAVA_WALK.Hyperlink}."

msgid "TUTORIAL@LOCATIONS@DESCRIPTION"
msgstr "Tutorial on the various locations found on the world map"

msgid "TUTORIAL@LOCATIONS@PAGE01@DESCRIPTION"
msgstr "You have encountered a {GLOBAL.NodeConcept.Hyperlink}, they provide additional yield to the {GLOBAL.ProvinceConcept.Hyperlink} they are located in."

msgid "TUTORIAL@LOCATIONS@PAGE01@INSTRUCTION"
msgstr "To gain the benefits of this node, you will need to [hyperlink,GLOBAL.ProvinceAnnexationConcept]Annex[/hyperlink] its province to one of your Cities."

msgid "TUTORIAL@LOCATIONS@PAGE01@TITLE"
msgstr "World Map Locations"

msgid "TUTORIAL@LOCATIONS@PAGE02@DESCRIPTION"
msgstr "You have found an army of Marauders; these often guard important locations and grant a reward when destroyed."

msgid "TUTORIAL@LOCATIONS@PAGE02@INSTRUCTION"
msgstr "Not all neutral armies are the same. An army bearing the tower banner represents a Free City. A black banner with a skull signifies a Marauder Guard. The Red banner with a skull signifies an army belonging to an Infestation."

msgid "TUTORIAL@LOCATIONS@PAGE02@TITLE"
msgstr "Marauder Guard"

msgid "TUTORIAL@LOCATIONS@TITLE"
msgstr "Locations"

msgid "TUTORIAL@LOW_FOOD@DESCRIPTION"
msgstr "Tutorial about low food income in cities"

msgid "TUTORIAL@LOW_FOOD@NAME"
msgstr "Low Food Income"

msgid "TUTORIAL@LOW_FOOD@PAGE01@DESCRIPTION"
msgstr "{GLOBAL.FoodConcept.Hyperlink} income in one of your cities is running low, this means your city will grow more slowly and may eventually lead to {GLOBAL.StarvationConcept.Hyperlink}!"

msgid "TUTORIAL@LOW_FOOD@PAGE01@INSTRUCTIONS"
msgstr "Each {GLOBAL.PopulationConcept.Hyperlink} in the city [hyperlink,GLOBAL.PopulationUpkeepConcept]eats some food[/hyperlink], so you need to ensure the income increases as the city grows.[br/][br/]To increase your city’s food income:[bulletlist][bullet/]Annex provinces with Pastures.[bullet/]Build {GLOBAL.FarmConcept.Hyperlink} province improvements[bullet/]Build Food giving city structures like <<m:{VarCityUpgradeOne}>> and <<m:{VarCityUpgradeTwo}>>.[/bulletlist]"

msgid "TUTORIAL@LOW_GOLD@DESCRIPTION"
msgstr "Tutorial explaining how to deal with low [gold/] gold income."

msgid "TUTORIAL@LOW_GOLD@PAGE01@DESCRIPTION"
msgstr "Your empire’s {GLOBAL.GoldConcept.Hyperlink} income is getting very low. If you run out of gold, your units will lose {GLOBAL.UnitMoraleConcept.Hyperlink} and may even desert!"

msgid "TUTORIAL@LOW_GOLD@PAGE01@INSTRUCTION"
msgstr "{GLOBAL.UnitUpkeepConcept.Hyperlink} is a common cause of low gold income, so you may want to disband some units if you have too many.[br/][br/]To increase your gold income:[bulletlist][bullet/]Annex provinces with Gold Veins.[bullet/]Build {GLOBAL.MineConcept.Hyperlink} province improvements.[bullet/]Build gold giving city structures like <<m:{VarCityUpgradeOne}>> and <<m:{VarCityUpgradeTwo}>>.[/bulletlist]"

msgid "TUTORIAL@LOW_GOLD@TITLE"
msgstr "Low Gold Income"

msgid "TUTORIAL@LOW_MANA@DESCRIPTION"
msgstr "Tutorial explaining how to deal with low [mana/] mana income."

msgid "TUTORIAL@LOW_MANA@PAGE01@DESCRIPTION"
msgstr "Your empire’s {GLOBAL.ManaConcept.Hyperlink} income is getting very low. If you run out of mana, you will not be able to cast spells!"

msgid "TUTORIAL@LOW_MANA@PAGE01@INSTRUCTION"
msgstr "{GLOBAL.UnitUpgradeUpkeepConcept.Hyperlink} is a common cause of low mana income, so you may want to cancel any active <<m:{GLOBAL.UnitEnchantmentConcept.Hyperlink}>> you have.[br/][br/]{GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink} units, like Spirits, Fairies, and Skeletons cost mana each turn, which may also be a cause.[br/][br/]To increase your mana income:[bulletlist][bullet/]Annex provinces with Mana Nodes.[bullet/]Build {GLOBAL.ConduitConcept.Hyperlink} province improvements.[bullet/]Build mana giving city structures like <<m:{VarCityUpgradeOne}>> and <<m:{VarCityUpgradeTwo}>>.[/bulletlist]"

msgid "TUTORIAL@LOW_MANA@TITLE"
msgstr "Low Mana Income"

msgid "TUTORIAL@LOW_STABILITY@DESCRIPTION"
msgstr "Tutorial explaining how to deal with low {GLOBAL.CityStabilityConcept.Name}."

msgid "TUTORIAL@LOW_STABILITY@NAME"
msgstr "Low City Stability"

msgid "TUTORIAL@LOW_STABILITY@PAGE01@DESCRIPTION"
msgstr "{GLOBAL.CityStabilityConcept.Hyperlink} in one of your cities is running low, this will reduce the city’s income and may eventually lead to more serious issues unless you fix it."

msgid "TUTORIAL@LOW_STABILITY@PAGE01@INSTRUCTION"
msgstr "City Stability drops as a city [hyperlink,GLOBAL.ProvinceAnnexationConcept]annexes more provinces[/hyperlink] and may also be caused by invading enemies or narrative events.[br/][br/]To increase city stability, try building a {VarCityUpgradeOne} or {VarCityUpgradeTwo}, which are unlocked by building the {VarCityUpgradeThree}."

msgid "TUTORIAL@MAGICMATERIALS@DESCRIPTION"
msgstr "Tutorial on magic materials"

msgid "TUTORIAL@MAGICMATERIALS@PAGE01@DESCRIPTION"
msgstr "You have selected a magic material. These have various unique effects if acquired via annexation or through trade. Gathering all materials from a category will yield a powerful empire-wide bonus."

msgid "TUTORIAL@MAGICMATERIALS@PAGE01@TITLE"
msgstr "Magic Materials"

msgid "TUTORIAL@MAGICMATERIALS@TITLE"
msgstr "Magic Materials"

msgid "TUTORIAL@MARAUDERS@DESCRIPTION"
msgstr "A tutorial about independent armies."

msgid "TUTORIAL@MARAUDERS@TITLE"
msgstr "Marauders"

msgid "TUTORIAL@NEGOTIATION@DESCRIPTION"
msgstr "Tutorial on negotiations between Rulers."

msgid "TUTORIAL@NEGOTIATION@PAGE01@DESCRIPTION"
msgstr "Negotiations are mutually beneficial agreements with fellow <<m:{GLOBAL.LeaderConcept.Hyperlink}>>. You can propose <<m:{GLOBAL.TreatyConcept.Hyperlink}>> to strengthen the bond between your empires, you can [hyperlink,GLOBAL.TradeConcept]Trade[/hyperlink] assets to make a profit, or you can send gifts to improve [hyperlink,GLOBAL.EmpireRelationConcept]Relations[/hyperlink]."

msgid "TUTORIAL@NEGOTIATION@PAGE01@TITLE"
msgstr "Negotiation"

msgid "TUTORIAL@NEGOTIATION@TITLE"
msgstr "Negotiation"

msgid "TUTORIAL@NOTIFICATIONS@DESCRIPTION"
msgstr "Tutorial on notifications and ending the turn"

msgid "TUTORIAL@NOTIFICATIONS@PAGE01@DESCRIPTION"
msgstr "Deal with all notifications to ensure no important tasks remain unattended. Then, you can safely end your turn."

msgid "TUTORIAL@NOTIFICATIONS@PAGE01@INSTRUCTION"
msgstr "[leftmousebutton/] Click the notifications on the right to go through them or skip them with [rightmousebutton/]."

msgid "TUTORIAL@NOTIFICATIONS@PAGE01@INSTRUCTION_CONTROLLER"
msgstr "Use [ci_righttrigger/] to go through the notifications in order. The list can be opened using [ci_dpadright/], allowing you to skip notifications with [ci_buttonx/]."

msgid "TUTORIAL@NOTIFICATIONS@PAGE01@TITLE"
msgstr "Notifications & Ending the Turn"

msgid "TUTORIAL@NOTIFICATIONS@TITLE"
msgstr "Notifications & Ending Turns"

msgid "TUTORIAL@OUTPOST@DESCRIPTION"
msgstr "Tutorial on settling new outposts"

msgid "TUTORIAL@OUTPOST@TITLE"
msgstr "Outposts"

msgid "TUTORIAL@OUTPOSTS@DESCRIPTION"
msgstr "Tutorial on the importance of outposts"

msgid "TUTORIAL@OUTPOSTS@PAGE01@DESCRIPTION"
msgstr "Outposts solidify your control over a region. You can use them as a safe place to recuperate, to lay claim to the surrounding lands, and they can also be turned into cities."

msgid "TUTORIAL@OUTPOSTS@PAGE01@INSTRUCTION"
msgstr "Outposts can only be built by heroes standing on the center of a province.[br/][br/]Outposts can collect resources of the <<m:{GLOBAL.LocationConcept.Hyperlink}>> within its {GLOBAL.DomainConcept.Hyperlink} similar to cities. Its defenses can be upgraded to help protect your claimed land."

msgid "TUTORIAL@OUTPOSTS@PAGE01@TITLE"
msgstr "Outposts"

msgid "TUTORIAL@OUTPOSTS@TITLE"
msgstr "Outposts"

msgid "TUTORIAL@OVERVIEWMAP@DESCRIPTION"
msgstr "Tutorial on using the Overview Map"

msgid "TUTORIAL@OVERVIEWMAP@PAGE01@DESCRIPTION"
msgstr "You have reached the overview map. As you explore the world, you will have many threats and opportunities to consider. Use this to inform your strategies."

msgid "TUTORIAL@OVERVIEWMAP@PAGE01@INSTRUCTION"
msgstr "Zooming back in will get you back to the regular view."

msgid "TUTORIAL@OVERVIEWMAP@PAGE01@TITLE"
msgstr "Overview Map"

msgid "TUTORIAL@OVERVIEWMAP@TITLE"
msgstr "Overview Map"

msgid "TUTORIAL@PILLAGING@DESCRIPTION"
msgstr "Tutorial on pillaging provinces and the ruins that remain"

msgid "TUTORIAL@PILLAGING@PAGE01@DESCRIPTION"
msgstr "When you are inside of the domain belonging to your enemy, you can pillage their <<m:{GLOBAL.ProvinceImprovementConcept.Hyperlink}>> to gain resources."

msgid "TUTORIAL@PILLAGING@PAGE01@INSTRUCTION"
msgstr "Move an army onto a {GLOBAL.ProvinceImprovementConcept.Hyperlink} and select the \"Pillage Province Improvement\" button."

msgid "TUTORIAL@PILLAGING@PAGE01@TITLE"
msgstr "Pillaging Provinces"

msgid "TUTORIAL@PILLAGING@TITLE"
msgstr "Pillaging & Ruins"

msgid "TUTORIAL@PRISONCRYPT@DESCRIPTION"
msgstr "Tutorial on the prison and crypt in your Throne City"

msgid "TUTORIAL@PRISONCRYPT@PAGE01@DESCRIPTION"
msgstr "A defeated hero has been put in your prison or crypt. You can either hand them over to their rightful owners for a reward, or you can keep them there for now."

msgid "TUTORIAL@PRISONCRYPT@PAGE01@INSTRUCTION"
msgstr "Upgrading your {GLOBAL.WizardTowerConcept.Hyperlink} in the {GLOBAL.ThroneCityConcept.Hyperlink} will unlock <<m:{GLOBAL.CityStructureConcept.Hyperlink}>> that grant additional benefits to the prison and crypt."

msgid "TUTORIAL@PRISONCRYPT@PAGE01@TITLE"
msgstr "Prison & Crypt"

msgid "TUTORIAL@PRISONCRYPT@TITLE"
msgstr "Prison & Crypt"

msgid "TUTORIAL@QUESTOVERVIEW@DESCRIPTION"
msgstr "Tutorial on the Quest Panel"

msgid "TUTORIAL@QUESTOVERVIEW@PAGE_01@DESCRIPTION"
msgstr "This is the Quest Panel. Here, you can review your progress on Victory Conditions, Quests, and Bounties."

msgid "TUTORIAL@QUESTOVERVIEW@PAGE_01@INSTRUCTION"
msgstr "From this panel you can abort quests, or track them to keep their current objectives visible when the panel is closed."

msgid "TUTORIAL@QUESTOVERVIEW@TITLE"
msgstr "Quest Panel"

msgid "TUTORIAL@RALLYOFLIEGES@DESCRIPTION"
msgstr "Tutorial on the Rally of the Lieges"

msgid "TUTORIAL@RALLYOFLIEGES@PAGE00@DESCRIPTION"
msgstr "Something is available in your {GLOBAL.RequestMilitaryAidConcept.Hyperlink}. To access your Rally of the Lieges, select the button from the top bar."

msgid "TUTORIAL@RALLYOFLIEGES@PAGE00@OBJECTIVE"
msgstr "Open Rally of the Lieges"

msgid "TUTORIAL@RALLYOFLIEGES@PAGE01@DESCRIPTION"
msgstr "You have opened the Rally of the Lieges overview. Here you can rally armies from your <<m:{GLOBAL.PvEVassalConcept.Hyperlink}>> and conquered <<m:{GLOBAL.AncientWonderConcept.Hyperlink}>>. The amount of units you can rally is determined by how many vassals and Ancient Wonders you own."

msgid "TUTORIAL@RALLYOFLIEGES@PAGE01@INSTRUCTION"
msgstr "A rally happens regularly. This can be sped up by spending {GLOBAL.GoldConcept.Hyperlink}.[br/][br/]You can come back to the Rally of Lieges at any time before the next rally starts to recruit more units."

msgid "TUTORIAL@RALLYOFLIEGES@PAGE01@TITLE"
msgstr "Rally of the Lieges"

msgid "TUTORIAL@RALLYOFLIEGES@TITLE"
msgstr "Rally of the Lieges"

msgid "TUTORIAL@RESEARCH@DESCRIPTION"
msgstr "Tutorial on selecting tomes and researching their skills"

msgid "TUTORIAL@RESEARCH@PAGE00@INSTRUCTION"
msgstr "Open the Arcane Research screen with the button on the top left of the screen."

msgid "TUTORIAL@RESEARCH@PAGE00@INSTRUCTION_CONTROLLER"
msgstr "Open the Arcane Research screen by opening the radial menu using [ci_buttony/] and selecting the tome icon."

msgid "TUTORIAL@RESEARCH@PAGE00@OBJECTIVE"
msgstr "Open Arcane Research"

msgid "TUTORIAL@RESEARCH@PAGE01@DESCRIPTION"
msgstr "Arcane research enables you to learn new <<m:{GLOBAL.SpellConcept.Hyperlink}>> and acquire new units. The culture and {GLOBAL.TomeConcept.Hyperlink} you have chosen for your faction determine the initial skills you can unlock through arcane research."

msgid "TUTORIAL@RESEARCH@PAGE01@INSTRUCTION"
msgstr "Choose one of the skills that seems the most useful to you."

msgid "TUTORIAL@RESEARCH@PAGE01@OBJECTIVE"
msgstr "Choose a skill"

msgid "TUTORIAL@RESEARCH@PAGE01@TITLE"
msgstr "Arcane Research"

msgid "TUTORIAL@RESEARCH@PAGE02@DESCRIPTION"
msgstr "Your empire will research the skill over time using your {GLOBAL.KnowledgeConcept.Hyperlink} income. Once the research is completed, you will choose between three new skills."

msgid "TUTORIAL@RESEARCH@PAGE02@INSTRUCTION"
msgstr "Every time you research {count} things, you will unlock a new {GLOBAL.TomeConcept.Hyperlink} to research things from."

msgid "TUTORIAL@RESEARCH@TITLE"
msgstr "Research"

msgid "TUTORIAL@RULER_LOST@DESCRIPTION"
msgstr "Tutorial about your Ruler dying in battle."

msgid "TUTORIAL@RULER_LOST@PAGE01@DESCRIPTION"
msgstr "Your {GLOBAL.LeaderConcept.Hyperlink}, {RulerDead.Name}, has perished in {GLOBAL.CombatConcept.Hyperlink}, this is a setback but all is not lost! They will return from the void in 3 turns at your {GLOBAL.ThroneCityConcept.Hyperlink}."

msgid "TUTORIAL@RULER_LOST@PAGE01@INSTRUCTIONS"
msgstr "While your Ruler is gone, you will not be able to cast <<m:{GLOBAL.SpellConcept.Hyperlink}>>, progress {GLOBAL.ResearchConcept.Hyperlink}, or do Diplomacy.[br/][br/]Additionally, if you lose your Throne while your Ruler is in the void, you will lose the game!"

msgid "TUTORIAL@RULER_LOST@TITLE"
msgstr "Your Ruler has fallen!"

msgid "TUTORIAL@SEALS@DESCRIPTION"
msgstr "Tutorial on Seals"

msgid "TUTORIAL@SEALS@PAGE01@DESCRIPTION"
msgstr "You have encountered a Seal. These structures can be captured to achieve a {GLOBAL.SealsVictoryConcept.Hyperlink}. They are guarded by powerful defenders that will attack any who claim their Seals."

msgid "TUTORIAL@SEALS@PAGE01@INSTRUCTION"
msgstr "There are multiple Seals in a world, and each one that you claim contributes {amount1} point every turn, the first {GLOBAL.EmpireConcept.Hyperlink} to reach the predetermined amount is victorious. Every {amount2} turns, seal defenders will spawn to retake their Seals. They increase in strength as you approach victory, so be prepared to fight for them."

msgid "TUTORIAL@SEALS@PAGE01@TITLE"
msgstr "Seals Victory"

msgid "TUTORIAL@SEALS@TITLE"
msgstr "Seals"

msgid "TUTORIAL@SIEGING@DESCRIPTION"
msgstr "Tutorial on laying siege to cities"

msgid "TUTORIAL@SIEGING@PAGE01@DESCRIPTION"
msgstr "You have started a {GLOBAL.SiegeConcept} on this city. It takes a number of turns to breach the city's walls, depending on its {GLOBAL.FortificationHealthConcept}.[br/]The following assault may be bloody, but a city is a valuable prize when captured."

msgid "TUTORIAL@SIEGING@PAGE01@INSTRUCTION"
msgstr "To influence the duration of a siege, you can pick <<m:{GLOBAL.SiegeProjectConcept.Hyperlink}>> on the bottom left of the siege screen. These can speed up the siege or destroy enemy defenses to make the upcoming battle easier."

msgid "TUTORIAL@SIEGING@PAGE01@TITLE"
msgstr "Laying Siege"

msgid "TUTORIAL@SIEGING@TITLE"
msgstr "Sieges"

msgid "TUTORIAL@SPECIALIMPROVEMENTS@DESCRIPTION"
msgstr "Tutorial on special improvements"

msgid "TUTORIAL@SPECIALIMPROVEMENTS@PAGE00@INSTRUCTION"
msgstr "Special Improvements can be built in your cities. Go to the production list of one of your cities."

msgid "TUTORIAL@SPECIALIMPROVEMENTS@PAGE01@DESCRIPTION"
msgstr "You are about to build a special province improvement. These must be built on top of existing improvements. They provide better economic bonuses and are often affected by the provinces around them."

msgid "TUTORIAL@SPECIALIMPROVEMENTS@PAGE01@INSTRUCTION"
msgstr "Select a province you want to build this special province improvement on."

msgid "TUTORIAL@SPECIALIMPROVEMENTS@PAGE01@TITLE"
msgstr "Special Improvements"

msgid "TUTORIAL@SPECIALIMPROVEMENTS@TITLE"
msgstr "Special Improvements"

msgid "TUTORIAL@SPELLCASTING@DESCRIPTION"
msgstr "Tutorial on priming and casting spells"

msgid "TUTORIAL@SPELLCASTING@PAGE00@INSTRUCTION"
msgstr "To access your spells, select the blue button next to your Ruler in the bottom right."

msgid "TUTORIAL@SPELLCASTING@PAGE00@INSTRUCTION_CONTROLLER"
msgstr "To access your spells, open the radial menu with [ci_buttony/] and select the [spellbutton/] Spell icon."

msgid "TUTORIAL@SPELLCASTING@PAGE00@OBJECTIVE"
msgstr "Open spell list"

msgid "TUTORIAL@SPELLCASTING@PAGE01@DESCRIPTION"
msgstr "This is your spell list. You can cast various spells from here to bolster your units and cities, or to smite your enemies."

msgid "TUTORIAL@SPELLCASTING@PAGE01@INSTRUCTION"
msgstr "When you select a spell, you pay its {GLOBAL.ManaConcept.Hyperlink} cost and start to cast it. A spell will take a number of {GLOBAL.TurnConcept.Hyperlink} to cast depending on its cost in <<m:{GLOBAL.WorldMapCastingPointConcept.Hyperlink}>>, the more casting points you have the less time this will take.[br/][br/]Some spells, such as <<m:{GLOBAL.UnitEnchantmentConcept.Hyperlink}>> cost {GLOBAL.SpellUpkeepConcept.Hyperlink} each turn. You can review your ongoing spells under the Active tab."

msgid "TUTORIAL@SPELLCASTING@PAGE01@TITLE"
msgstr "Spells"

msgid "TUTORIAL@SPELLCASTING@TITLE"
msgstr "Spellcasting"

msgid "TUTORIAL@STABILITY@DESCRIPTION"
msgstr "Stability measures how happy the people in your cities are. Outside of Dark Cultures which do not suffer from low stability penalties, you generally want to keep your stability high."

msgid "TUTORIAL@STABILITY@INSTRUCTIONS"
msgstr "You can find the stability of your cities by hovering over the [happiness/] mask symbol next to the city name in the city interface."

msgid "TUTORIAL@STABILITY@TITLE"
msgstr "City Stability"

msgid "TUTORIAL@THRALLS@DESCRIPTION"
msgstr "Tutorial on Thralls"

msgid "TUTORIAL@THRALLS@TITLE"
msgstr "[thralls/] Thralls"

msgid "TUTORIAL@THRALLS_PAGE01@DESCRIPTION"
msgstr "As an Eldritch Sovereign, you can enslave Thralls, who can be sacrificed to cast ritual <<m:{GLOBAL.SpellConcept.Hyperlink}>>. Thralls are enslaved automatically when you are victorious in battle."

msgid "TUTORIAL@THRALLS_PAGE01@INSTRUCTIONS"
msgstr "The more and stronger enemies you fight, the greater the chance and amount of thralls gained.[br/][br/]You can learn more ritual spells by acquiring certain hero skills as your Ruler levels up."

msgid "TUTORIAL@THRONECITY@DESCRIPTION"
msgstr "Tutorial on the Throne City"

msgid "TUTORIAL@THRONECITY@PAGE01@DESCRIPTION"
msgstr "You have selected your {GLOBAL.ThroneCityConcept.Hyperlink}. Your Throne City is the most important city in your {GLOBAL.EmpireConcept.Hyperlink}."

msgid "TUTORIAL@THRONECITY@PAGE01@INSTRUCTIONS"
msgstr "Your current Throne City is {VarThroneCity}. This is where you can build your {GLOBAL.WizardTowerConcept.Hyperlink} and where your Ruler will reappear when <<p:PlayerLeader>> [hyperlink,GLOBAL.RulerVoidConcept]perishes[/hyperlink].[br/][br/]If you lose both your Throne City and your {GLOBAL.LeaderConcept.Hyperlink}, you are defeated.[br/][br/]You can relocate your throne to any other city through the [cityinformation/] City Information screen."

msgid "TUTORIAL@THRONECITY@TITLE"
msgstr "Throne City"

msgid "TUTORIAL@TOMEOFWONDERS@DESCRIPTION"
msgstr "You can open the Encyclopedia to find information about various units, mechanics, or spells."

msgid "TUTORIAL@TOMEOFWONDERS@INSTRUCTIONS"
msgstr "The button is located in the top right corner of the screen, marked by [tow/]."

msgid "TUTORIAL@TOMEOFWONDERS@INSTRUCTIONS_CONTROLLER"
msgstr "To open the Encyclopedia screen:[bulletlist][bullet/]Press [ci_buttony/] to open the radial menu.[bullet/]Choose the [inspect/] button.[bullet/]Choose the [tow/] button.[/bulletlist]"

msgid "TUTORIAL@TOMEOFWONDERS@TITLE"
msgstr "Encyclopedia"

msgid "TUTORIAL@TOMESELECTION@DESCRIPTION"
msgstr "Tutorial on selecting tomes and advancing in arcane research"

msgid "TUTORIAL@TOMESELECTION@PAGE01@DESCRIPTION"
msgstr "You have acquired enough arcane skills to choose a new {GLOBAL.TomeConcept.Hyperlink} to add to your research library. Additional tomes will expand the selection of arcane skills available to you."

msgid "TUTORIAL@TOMESELECTION@PAGE01@INSTRUCTION"
msgstr "Every Tome grants a collection of spells, units, and other upgrades to research. Read the summaries and pick a Tome that fits your play style."

msgid "TUTORIAL@TOMESELECTION@PAGE01@TITLE"
msgstr "Tome Selection"

msgid "TUTORIAL@TOMESELECTION@PAGE02@DESCRIPTION"
msgstr "For every two tomes you pick, you will unlock the next tier of tomes. Higher tier tomes also require a certain amount {GLOBAL.AffinityConcept.Hyperlink} to be unlocked."

msgid "TUTORIAL@TOMESELECTION@PAGE02@INSTRUCTION"
msgstr "The Tome Library in the research screen shows the complete collection of tomes as well as what is needed to unlock them.[br/][br/]The cost of a tome's skills depends on the number of tomes chosen beforehand—each tome’s skills are more expensive than the ones before them."

msgid "TUTORIAL@TOMESELECTION@PAGE02@OBJECTIVE"
msgstr "Choose a new tome"

msgid "TUTORIAL@TOMESELECTION@PAGE02@SUMMARY"
msgstr "Tutorial about unlocking higher tier tomes"

msgid "TUTORIAL@TOMESELECTION@PAGE02@TITLE"
msgstr "Tome Progression"

msgid "TUTORIAL@TOMESELECTION@TITLE"
msgstr "Tome Selection"

msgid "TUTORIAL@TOOLTIPS@DESCRIPTION"
msgstr "Tutorial on the use of hyperlinks and tooltips."

msgid "TUTORIAL@TOOLTIPS@PAGE01@DESCRIPTION"
msgstr "You can always find out more about a topic if you ever need more information to inform your decisions."

msgid "TUTORIAL@TOOLTIPS@PAGE01@INSTRUCTION"
msgstr "You will often find a {GLOBAL.HyperlinkConcept.Hyperlink} in text. Hovering over one will show important information about a concept or system. Hover your mouse over the underscored word \"Hyperlink\" above to open a tooltip."

msgid "TUTORIAL@TOOLTIPS@PAGE01@INSTRUCTION_CONTROLLER"
msgstr "You will often find a {GLOBAL.HyperlinkConcept.Hyperlink} in text. Hovering over one will show important information about a concept or system. Move your selection over the underscored word \"Hyperlink\" above and use [ci_options/] to go into the tooltip."

msgid "TUTORIAL@TOOLTIPS@PAGE01@TITLE"
msgstr "Hyperlinks & Tooltips"

msgid "TUTORIAL@TOOLTIPS@TITLE"
msgstr "Hyperlinks & Tooltips"

msgid "TUTORIAL@TRANSFORMATION@DESCRIPTION"
msgstr "Tutorial on Race Transformations"

msgid "TUTORIAL@TRANSFORMATION@TITLE"
msgstr "Transformations"

msgid "TUTORIAL@TRANSFORMATIONS@PAGE01@DESCRIPTION"
msgstr "You have just researched a {GLOBAL.RaceTransformationConcept.Hyperlink} spell. These powerful spells alter a race of which you are a {GLOBAL.KeeperConcept.Hyperlink}, granting them powerful permanent bonuses."

msgid "TUTORIAL@TRANSFORMATIONS@PAGE01@INSTRUCTIONS"
msgstr "Major Transformations are exclusive, so each race may only have one. Minor Transformations are weaker, but have no such limitation.[br/][br/]In order to use the transformation, you'll need to cast it. You can do this from the Spell Book."

msgid "TUTORIAL@TRANSFORMATIONS@PAGE01@INSTRUCTIONS_CONTROLLER"
msgstr "Major Transformations are exclusive, so each race may only have one. Minor Transformations are weaker, but have no such limitation.[br/][br/]In order to use the transformation, you'll need to cast it. Press [ci_buttony/] to open the radial menu and select the [spellbutton/] Spells button."

msgid "TUTORIAL@UNDERGROUND@DESCRIPTION"
msgstr "Tutorial on the Underground layer"

msgid "TUTORIAL@UNDERGROUND@PAGE01@DESCRIPTION"
msgstr "This is the {GLOBAL.UndergroundConcept.Hyperlink}. It is rich in minerals and <<m:{GLOBAL.AncientWonderConcept.Hyperlink}>>. As long as you have access to a passage, you can freely move between the surface and the underground."

msgid "TUTORIAL@UNDERGROUND@PAGE01@INSTRUCTION"
msgstr "The {GLOBAL.ExcavationConcept.Hyperlink} {GLOBAL.EmpireSkillConcept.Hyperlink} is useful for navigating the underground by removing diggable earth. This can sometimes hide treasures or marauder armies ready to attack and pillage your cities. Races with the Underground Adaptation trait fare better in the Underground. [br/] To leave the underground you can [leftmousebutton/] click on the layer button in the top right corner."

msgid "TUTORIAL@UNDERGROUND@PAGE01@INSTRUCTION_CONTROLLER"
msgstr "The {GLOBAL.ExcavationConcept.Hyperlink} {GLOBAL.EmpireSkillConcept.Hyperlink} is useful for navigating the underground by removing diggable earth. This can sometimes hide treasures or marauder armies ready to attack and pillage your cities. Races with the Underground Adaptation trait fare better in the Underground. [br/] To leave the underground press [ci_lefttrigger/]."

msgid "TUTORIAL@UNDERGROUND@PAGE01@TITLE"
msgstr "The Underground"

msgid "TUTORIAL@UNDERGROUND@PAGE02@DESCRIPTION"
msgstr "When a {GLOBAL.ProvinceConcept.Hyperlink} containing an Underground Passage is [hyperlink,GLOBAL.ProvinceAnnexationConcept]Annexed[/hyperlink], the city may use the passage to expand to the other layer."

msgid "TUTORIAL@UNDERGROUND@PAGE02@INSTRUCTION"
msgstr "Some <<m:{GLOBAL.MagicMaterialConcept.Hyperlink}>> are more common underground, while others may be more common on the surface."

msgid "TUTORIAL@UNDERGROUND@PAGE02@TITLE"
msgstr "Expanding through Passages"

msgid "TUTORIAL@UNDERGROUND@TITLE"
msgstr "Underground"

msgid "TUTORIAL@UNITPANEL@DESCRIPTION"
msgstr "Tutorial on how to use the Unit Panel to get information on each unit."

msgid "TUTORIAL@UNITPANEL@PAGE01@DESCRIPTION"
msgstr "You have selected a unit and opened the unit panel. This panel shows the details on a unit and what the unit is capable of, as well as any weaknesses you could exploit."

msgid "TUTORIAL@UNITPANEL@PAGE01@INSTRUCTION"
msgstr "You can hover over the icons to learn more about a unit's abilities, passives and unit types."

msgid "TUTORIAL@UNITPANEL@PAGE01@TITLE"
msgstr "Unit Panel"

msgid "TUTORIAL@UNITPANEL@TITLE"
msgstr "Unit Information"

msgid "TUTORIAL@UNITTIER@DESCRIPTION"
msgstr "Beware! You are engaging combat with a high tier unit. A [hyperlink,GLOBAL.UnitTierConcept]Unit's Tier[/hyperlink] is shown in the bottom left of their portrait in the army panel."

msgid "TUTORIAL@UNITTIER@INSTRUCTION"
msgstr "The higher a unit's tier, the more dangerous they are. [rightmousebutton/] Right-click on their portrait to investigate them further, and prepare accordingly—or rethink this combat."

msgid "TUTORIAL@UNITTIER@INSTRUCTION_CONTROLLER"
msgstr "The higher a unit's tier, the more dangerous it is. Press [ci_rightbumper/] to go into the army panel, then press [ci_buttony/] on any unit to investigate it further and prepare accordingly—or rethink this combat."

msgid "TUTORIAL@UNITTIER@SUMMARY"
msgstr "Tutorial over fighting higher tier units."

msgid "TUTORIAL@UNITTIER@TITLE"
msgstr "Unit Tiers"

msgid "TUTORIAL@VICOTRY@PAGE01@INSTRUCTION"
msgstr "Victory can be claimed through the Expansion Victory, Magic Victory, Score Victory or Military Victory.[br/][br/]You can click on each victory to see detail of its conditions and your progress."

msgid "TUTORIAL@VICTORY@DESCRIPTION"
msgstr "Tutorial on the types of victory conditions"

msgid "TUTORIAL@VICTORY@PAGE01@DESCRIPTION"
msgstr "There are many paths to becoming the Ruler of this realm. Some may wage war, but others may take a more peaceful approach."

msgid "TUTORIAL@VICTORY@PAGE01@TITLE"
msgstr "Victory Conditions"

msgid "TUTORIAL@VICTORY@TITLE"
msgstr "Victory Conditions"

msgid "TUTORIAL@WARBOUNTIES@DESCRIPTION"
msgstr "Tutorial on War Bounties"

msgid "TUTORIAL@WARBOUNTIES@PAGE01@DESCRIPTION"
msgstr "You can now create a {GLOBAL.CallToArmsConcept.Hyperlink} to request aid in your war! Bounties are quests created by <<m:{GLOBAL.LeaderConcept.Hyperlink}>> and offered to other Rulers in exchange for a reward."

msgid "TUTORIAL@WARBOUNTIES@PAGE01@INSTRUCTION"
msgstr "Go to the [scorevictory/] Quests panel on the top-left to create a bounty. There, you can also find bounties you and other Rulers have posted and bounties you have accepted.[br/][br/]Bounties can target <<m:{GLOBAL.CityConcept.Hyperlink}>> and important structures owned by enemies."

msgid "TUTORIAL@WARBOUNTIES@PAGE01@TITLE"
msgstr "War Bounties"

msgid "TUTORIAL@WELCOME@DESCRIPTION"
msgstr "An introduction message"

msgid "TUTORIAL@WELCOME@PAGE01@DESCRIPTION"
msgstr "A new Age of Wonders dawns."

msgid "TUTORIAL@WELCOME@PAGE01@INSTRUCTION"
msgstr "Allow me to lend some aid, O {PlayerLeader.Title}. During play, messages like this will provide advice on how to achieve victory on this realm. Some of these will trigger objectives for your growing empire.[br/][br/]Click on the [questionmark/] button on the bottom right to open additional advice, and reread any tutorials you've already completed.[br/][br/]You can disable the tutorial in the settings menu."

msgid "TUTORIAL@WELCOME@PAGE01@INSTRUCTION_CONTROLLER"
msgstr "Allow me to lend some aid, O {PlayerLeader.Title}. During play, messages like this will provide advice on how to achieve victory on this realm. Some of these will trigger objectives for your growing empire.[br/][br/]You can get extra information and reread completed tutorials by opening the radial menu with [ci_buttony/] and selecting the [questionmark/] Advice option.[br/][br/]You can disable the tutorial in the settings menu."

msgid "TUTORIAL@WELCOME@PAGE01@TITLE"
msgstr "Welcome to Age of Wonders!"

msgid "TUTORIAL@WELCOME@TITLE"
msgstr "Welcome to Age of Wonders"

msgid "TUTORIAL@WORLD_MAP_TUTORIAL@DESCRIPTION"
msgstr "Tutorial about healing armies outside of combat."

msgid "TUTORIAL@WORLD_MAP_TUTORIAL@PAGE01@DESCRIPTION"
msgstr "Some of your units have lost <<m:{GLOBAL.HitPointConcept.Hyperlink}>> and will need some time to regain them."

msgid "TUTORIAL@WORLD_MAP_TUTORIAL@PAGE01@INSTRUCTION"
msgstr "Each unit [hyperlink,GLOBAL.WorldMapRegeneration]regenerates[/hyperlink] a certain amount of health each turn. Moving the unit back into your {GLOBAL.DomainConcept.Hyperlink} speeds this process up, while staying in enemy domain or near an {GLOBAL.InfestationConcept.Hyperlink} will slow it down.[br/][br/]You can still fight while your units are damaged, but they might be weaker due to having <<m:{GLOBAL.CasualtyConcept.Hyperlink}>>."

msgid "TUTORIAL@WORLD_MAP_TUTORIAL@TITLE"
msgstr "World Map Regeneration"

msgid "UNITPROPERTIES@ACCURACY@DESCRIPTION"
msgstr "+{ACCURACY_INCREASE_BOOST>ResolvedAccuracyModifier}% {GLOBAL.AccuracyConcept.Hyperlink} on {GLOBAL.MagicConcept.Hyperlink} and {GLOBAL.RangedConcept.Hyperlink} attacks."

msgid "UNITPROPERTIES@ACCURACY@MODIFIER@NAME"
msgstr "Increased Accuracy"

msgid "UNITPROPERTIES@ACCURACY@NAME"
msgstr "+{ACCURACY_INCREASE_BOOST>ResolvedAccuracyModifier}% {GLOBAL.AccuracyConcept.Hyperlink}"

msgid "UNITPROPERTIES@ANIMAL_SLAYER@DESCRIPTION"
msgstr "Base attacks deal +{ANIMAL_SLAYER_DAMAGE>ResolvedMultiplier}% damage to {GLOBAL.PROPERTIES.ANIMAL.Hyperlink} units."

msgid "UNITPROPERTIES@ANIMAL_SLAYER@NAME"
msgstr "Animal Slayer"

msgid "UNITPROPERTIES@ANTI_CAVALRY@DESCRIPTION"
msgstr "Unit deals +{damage}% damage against Cavalry units."

msgid "UNITPROPERTIES@ANTI_CAVALRY@NAME"
msgstr "Cavalry Break"

msgid "UNITPROPERTIES@ARMY_MOUNTAIN_WALK@DESCRIPTION"
msgstr "All units in the army gain {GLOBAL.PROPERTIES.MOUNTAIN_WALK.Hyperlink}."

msgid "UNITPROPERTIES@ARMY_MOUNTAIN_WALK@NAME"
msgstr "Army Climbing"

msgid "UNITPROPERTIES@ARMY_RECUPERATION@DESCRIPTION"
msgstr "All units in the army heal +{ARMY_RECUPERATION_STAT_BONUS>BONUS>Regen} <<m:{GLOBAL.HitPointConcept.Hyperlink}>> every {GLOBAL.WorldMapConcept.Hyperlink} {GLOBAL.TurnConcept.Hyperlink}.[br/][br/]Does not stack."

msgid "UNITPROPERTIES@ARMY_RECUPERATION@NAME"
msgstr "Army Recuperation"

msgid "UNITPROPERTIES@ARMY_SIEGE_BREAKERS@DESCRIPTION"
msgstr "Grants {GLOBAL.PROPERTIES.SIEGE_BREAKER.Hyperlink} to all units in the army."

msgid "UNITPROPERTIES@ARMY_SIEGE_BREAKERS@NAME"
msgstr "Siege Master"

msgid "UNITPROPERTIES@ARMY_TRAINER@DESCRIPTION"
msgstr "Units in the army gain +{ARMY_EXPERIENCE_XP_BONUS>ResolvedProportion}% {GLOBAL.ExperienceConcept.Hyperlink}."

msgid "UNITPROPERTIES@ARMY_TRAINER@NAME"
msgstr "Army Trainer"

msgid "UNITPROPERTIES@ARMY_UPKEEP@DESCRIPTION"
msgstr "Units in the army cost -{ARMY_UPKEEP_MODIFIER>ResolvedUpkeepModifier}% base {GLOBAL.UnitUpkeepConcept.Hyperlink}."

msgid "UNITPROPERTIES@ARMY_UPKEEP@NAME"
msgstr "Army Maintenance"

msgid "UNITPROPERTIES@ASPIRANT_KNIGHT@DESCRIPTION"
msgstr "When this unit gains Legendary Rank, it instead promotes into a {GLOBAL.UNITS.KNIGHT.Hyperlink}[br/][br/]Requires a Feudal Tier 4 Town Hall to be built in the Empire."

msgid "UNITPROPERTIES@ASPIRANT_KNIGHT@NAME"
msgstr "Aspirant: Knight"

msgid "UNITPROPERTIES@ASPIRANT_LIEGE_GUARD@DESCRIPTION"
msgstr "When this unit gains Legendary Rank, it instead promotes into a {GLOBAL.UNITS.LIEGE_GUARD.Hyperlink}[br/][br/]Requires a Feudal Tier 3 Town Hall to be built in the Empire."

msgid "UNITPROPERTIES@ASPIRANT_LIEGE_GUARD@NAME"
msgstr "Aspirant: Liege Guard"

msgid "UNITPROPERTIES@ASPIRANT_LONGBOW@DESCRIPTION"
msgstr "When this unit gains Legendary Rank, it instead promotes into a {GLOBAL.UNITS.LONGBOW.Hyperlink}[br/][br/]Requires a Feudal Tier 3 Town Hall to be built in the Empire."

