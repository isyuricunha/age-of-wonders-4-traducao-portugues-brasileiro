msgid "CULTURE_INDUSTRIOUS@STRENGTH_FROM_STEEL@DESCRIPTION"
msgstr "Target friendly unit loses all stacks of {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink} and {GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink}. For each stack lost:[bulletlist][bullet/]Heals +{STRENGTH_OF_STEEL_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept}>>.[bullet/]Gains {stacks} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}.[/bulletlist]"

