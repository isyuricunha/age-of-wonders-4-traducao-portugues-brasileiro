msgstr "Your {GLOBAL.PROPERTIES.EXPEDITION_LEADER.Hyperlink} refracts Bloodlight.[br/][br/]When ending their turn, they remove Bloodlight in a {radius}-hex radius.[br/]If they remove any Bloodlight this way, they gain {GLOBAL.PROPERTIES.REFLECTION_SPIRIT_SHIELD.Hyperlink} for {duration}."

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@BLOODLIGHT_REFRACTION@NAME"
msgstr "Bloodlight Refraction"

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@ECHOING_ACOUSTICS@DESCRIPTION"
msgstr "All <<m:{GLOBAL.UNITS.SHRIEKING_BAT.Hyperlink}>> have their attacks affect all targets in a {radius}-hex area of their primary target and have {GLOBAL.PROPERTIES.DEMOLISHER.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@ECHOING_ACOUSTICS@NAME"
msgstr "Reverberant Acoustics"

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@FRAGMENTED_BLOODLIGHT_REFLECTIONS@DESCRIPTION"
msgstr "Every {GLOBAL.TurnConcept.Hyperlink}, a few positions gain Bloodlight for {turn}.[br/][br/]{GLOBAL.PROPERTIES.UNDEAD.Hyperlink} units in Bloodlight gain {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} and {GLOBAL.PROPERTIES.REGENERATION.Hyperlink} at the end of the Turn."

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@FRAGMENTED_BLOODLIGHT_REFLECTIONS@NAME"
msgstr "Fragmented Bloodstone Reflections"

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@JOINING_THE_FUN@DESCRIPTION"
msgstr "Your {GLOBAL.PROPERTIES.EXPEDITION_LEADER.Hyperlink} gains {GLOBAL.PROPERTIES.PAINBOUND_PROPERTY_GROUP.Hyperlink} and {GLOBAL.PROPERTIES.CURSE_EATER.Hyperlink} until the end of the battle."

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@JOINING_THE_FUN@NAME"
msgstr "Joining the Fun"

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@OVERGROWN_BUSH_GARDEN@DESCRIPTION"
msgstr "Instead of additional Creeping Rosevine obstacles, additional Bush obstacles are present during the battle, which are {GLOBAL.ObscuringConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@OVERGROWN_BUSH_GARDEN@NAME"
msgstr "Overgrown Bush Garden"

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@OVERGROWN_ROSE_GARDEN@DESCRIPTION"
msgstr "Additional Creeping Rosevine obstacles are present during the battle. They are {GLOBAL.SharpConcept.Hyperlink} and {GLOBAL.CreepingConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@OVERGROWN_ROSE_GARDEN@NAME"
msgstr "Overgrown Rose Garden"

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@PARASITIC_INFECTION@DESCRIPTION"
msgstr "Every {GLOBAL.TurnConcept.Hyperlink}, all enemy units with {GLOBAL.PROPERTIES.BLEEDING.Hyperlink} have a {chance} chance of suffering {GLOBAL.PROPERTIES.BLOOD_PARASITE.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@PARASITIC_INFECTION@NAME"
msgstr "Parasitic Contamination"

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@PLEASURE_FROM_PAIN@DESCRIPTION"
msgstr "All defending units have {GLOBAL.PROPERTIES.CURSE_EATER.Hyperlink} and {GLOBAL.PROPERTIES.PAINBOUND_PROPERTY_GROUP.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@PLEASURE_FROM_PAIN@NAME"
msgstr "Pleasure from Pain"

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@STUNNING_SOUNDS@DESCRIPTION"
msgstr "Every {turns}, a {GLOBAL.UNITS.SHRIEKING_BAT.Hyperlink} has a {chance} of suffering {GLOBAL.PROPERTIES.STUNNED.Hyperlink} for {turns2}. If failed, it suffers {GLOBAL.PROPERTIES.DISTRACTED.Hyperlink} for {turns2} instead."

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@STUNNING_SOUNDS@NAME"
msgstr "Stunning Sounds"

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@TAUNTED_QUEEN@DESCRIPTION"
msgstr "The entire enemy army is {GLOBAL.PROPERTIES.TAUNTED.Hyperlink} by the attacking {GLOBAL.PROPERTIES.EXPEDITION_LEADER.Hyperlink} until the end of the battle."

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@TAUNTED_QUEEN@NAME"
msgstr "Taunted Queen"

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@WAILING_PODS_GARDEN@DESCRIPTION"
msgstr "Additional Wailing Pods obstacles are present during battle. They trigger {GLOBAL.PROPERTIES.WAIL_OF_THE_BANSHEE.Hyperlink} when destroyed."

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@WAILING_PODS_GARDEN@NAME"
msgstr "Wailing Pods Garden"

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@WITHERING_GARDEN@DESCRIPTION"
msgstr "Every {GLOBAL.TurnConcept.Hyperlink}, each Creeping Rosevine has a {chance} chance of being destroyed."

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@WITHERING_GARDEN@NAME"
msgstr "Withering Garden"

msgid "DLC@THRONESOFBLOOD@CONCEPT@BLOOD_DRAIN_ABILITY@DESCRIPTION"
msgstr "The blood draining abilities of a Vampire: {GLOBAL.PROPERTIES.DRAINING_BITE.Hyperlink} and {GLOBAL.PROPERTIES.SIPHON_BLOOD.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@CONCEPT@BLOOD_DRAIN_ABILITY@HYPERLINK"
msgstr "[hyperlink,GLOBAL.BloodDrainConcept]Blood Drain[/hyperlink]"

msgid "DLC@THRONESOFBLOOD@CONCEPT@BLOOD_DRAIN_ABILITY@NAME"
msgstr "Blood Drain"

msgid "DLC@THRONESOFBLOOD@DESCRIPTION"
msgstr "Thrones of Blood"

msgid "DLC@THRONESOFBLOOD@DISPLAYDESCRIPTION"
msgstr "Embrace the night and command legions of the damned with the Age of Wonders 4: Thrones of Blood expansion. Rise as a powerful Vampire ruler, build your dark empire in the shadows, and wield ancient blood magic to dominate the realms. Explore sunless lands where rivers of blood flow, and forge pacts with creatures of the night to ensure your eternal reign."

msgid "DLC@THRONESOFBLOOD@DISPLAYNAME"
msgstr "Age of Wonders 4: Thrones of Blood"

msgid "DLC@THRONESOFBLOOD@EMPIRE_CORE@SUNLESS_REGIONS@DESCRIPTION"
msgstr "There are various places on this realm's surface the sun never seems to touch.[bulletlist][bullet/]Several hand-crafted regions with {GLOBAL.SunlessConcept.Hyperlink} can appear on the Surface.[bullet/]The {GLOBAL.STRUCTURES.THORN_HEART_LANDMARK.Hyperlink} can appear on the Surface.[bullet/]{GLOBAL.STRUCTURES.BLOOD_GLASS.Hyperlink} can appear on the Surface.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@EMPIRE_CORE@SUNLESS_REGIONS@NAME"
msgstr "Sunless Regions"

msgid "DLC@THRONESOFBLOOD@EXPLORATIONSITES_STRATEGIC@CRIMSON_FANE@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{amount} {GLOBAL.ManaConcept.Hyperlink} per {GLOBAL.ResearchPostConcept.Hyperlink} in {GLOBAL.CityConcept.Hyperlink} {GLOBAL.DomainConcept.Hyperlink}.[bullet/]Adds the {GLOBAL.UNITS.SHRIEKING_BAT.Hyperlink} unit to the {GLOBAL.RequestMilitaryAidConcept.Hyperlink}.[bullet/]If <<m:{GLOBAL.ThrallConcept.Hyperlink}>> are available, the [thralls/] Thrall Sacrifice action on this structure becomes available to permanently gain +{castingpoints1} <<m:{GLOBAL.WorldMapCastingPointConcept.Hyperlink}>> and +{castingpoints2} <<m:{GLOBAL.CombatCastingPointConcept.Hyperlink}>> from this structure.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@EXPLORATIONSITES_STRATEGIC@CRIMSON_FANE@LORE"
msgstr "Within dark and forgotten holes that pierce the realm's surface, ominous gates lead to shadowed shrines. Here, unspeakable horrors fester and develop at the hands of mad cultists and the forsaken. Even more unsettling than the metallic stench of blood that rises from these profane pits are the maddening screams and screeches that echo from darkness within."

msgid "DLC@THRONESOFBLOOD@EXPLORATIONSITES_STRATEGIC@CRIMSON_FANE@NAME"
msgstr "Crimson Fane"

msgid "DLC@THRONESOFBLOOD@EXPLORATIONSITES_STRATEGIC@CRIMSON_FANE@OPERATION@DESCRIPTION"
msgstr "Sacrifice {thralls} <<m:{GLOBAL.ThrallConcept.Hyperlink}>> to permanently gain +{castingpoints1} <<m:{GLOBAL.WorldMapCastingPointConcept.Hyperlink}>> and +{castingpoints2} <<m:{GLOBAL.CombatCastingPointConcept.Hyperlink}>> from this structure.[br/][br/]Can only be done once."

msgid "DLC@THRONESOFBLOOD@EXPLORATIONSITES_STRATEGIC@CRIMSON_FANE@OPERATION@NAME"
msgstr "[thralls/] Thrall Sacrifice"

msgid "DLC@THRONESOFBLOOD@EXPLORATIONSITES_STRATEGIC@ROSE_CHOKED_PALACE@DESCRIPTION"
msgstr "[bulletlist][bullet/]The {GLOBAL.CityConcept.Hyperlink} ignores the {GLOBAL.CityStabilityConcept.Hyperlink} penalty of {GLOBAL.SunlessConcept.Hyperlink} in its {GLOBAL.DomainConcept.Hyperlink}.[bullet/]Adds the {GLOBAL.UNITS.ROSE_KNIGHT.Hyperlink} and various Rose Choked Skeleton units to the {GLOBAL.RequestMilitaryAidConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@EXPLORATIONSITES_STRATEGIC@ROSE_CHOKED_PALACE@LORE"
msgstr "Imposing mansions raised long ago by dark overlords, the overgrowth of crimson roses and thorny vines suggests abandonment and disrepair. Yet at night, flickering lights appear behind red-stained glass windows, suggesting that not all life—or indeed unlife—has vacated the palace's grand halls and labyrinthian courtyards."

msgid "DLC@THRONESOFBLOOD@EXPLORATIONSITES_STRATEGIC@ROSE_CHOKED_PALACE@NAME"
msgstr "Rose Choked Palace"

msgid "DLC@THRONESOFBLOOD@EXPLORATIONSITES_STRATEGIC@STRUCTURE_CRIMSONFANE@NAME_OVERRIDE@BLOODLETTERS_1"
msgstr "Bloodthroat"

msgid "DLC@THRONESOFBLOOD@EXPLORATIONSITES_STRATEGIC@STRUCTURE_CRIMSONFANE@NAME_OVERRIDE@BLOODLETTERS_2"
msgstr "Sanguine Sanctorium"

msgid "DLC@THRONESOFBLOOD@EXPLORATIONSITES_STRATEGIC@STRUCTURE_CRIMSONFANE@NAME_OVERRIDE@BLOODLETTERS_3"
msgstr "Archblood's Altar"

msgid "DLC@THRONESOFBLOOD@EXPLORATIONSITES_STRATEGIC@STRUCTURE_CRIMSONFANE@NAME_OVERRIDE@DOOMBATS_1"
msgstr "Shrieking Shrine"

msgid "DLC@THRONESOFBLOOD@EXPLORATIONSITES_STRATEGIC@STRUCTURE_CRIMSONFANE@NAME_OVERRIDE@DOOMBATS_2"
msgstr "Echoing Abyss"

msgid "DLC@THRONESOFBLOOD@EXPLORATIONSITES_STRATEGIC@STRUCTURE_CRIMSONFANE@NAME_OVERRIDE@DOOMBATS_3"
msgstr "Leatherwing Lair"

msgid "DLC@THRONESOFBLOOD@EXPLORATIONSITES_STRATEGIC@STRUCTURE_CRIMSONFANE@NAME_OVERRIDE@PAINBRINGER_1"
msgstr "Pit of Pain"

msgid "DLC@THRONESOFBLOOD@EXPLORATIONSITES_STRATEGIC@STRUCTURE_CRIMSONFANE@NAME_OVERRIDE@PAINBRINGER_2"
msgstr "Temple of Torment"

msgid "DLC@THRONESOFBLOOD@EXPLORATIONSITES_STRATEGIC@STRUCTURE_CRIMSONFANE@NAME_OVERRIDE@PAINBRINGER_3"
msgstr "Sanctum of Screams"

msgid "DLC@THRONESOFBLOOD@EXPLORATIONSITES_STRATEGIC@STRUCTURE_ROSEPALACE@NAME_OVERRIDE@BANQUET_1"
msgstr "Debaucher's Château"

msgid "DLC@THRONESOFBLOOD@EXPLORATIONSITES_STRATEGIC@STRUCTURE_ROSEPALACE@NAME_OVERRIDE@BANQUET_2"
msgstr "Court of Carousing"

msgid "DLC@THRONESOFBLOOD@EXPLORATIONSITES_STRATEGIC@STRUCTURE_ROSEPALACE@NAME_OVERRIDE@BANQUET_3"
msgstr "Moonlit Mansion"

msgid "DLC@THRONESOFBLOOD@EXPLORATIONSITES_STRATEGIC@STRUCTURE_ROSEPALACE@NAME_OVERRIDE@BANSHEE_1"
msgstr "Lovemourn Manor"

msgid "DLC@THRONESOFBLOOD@EXPLORATIONSITES_STRATEGIC@STRUCTURE_ROSEPALACE@NAME_OVERRIDE@BANSHEE_2"
msgstr "Griever's Gardens"

msgid "DLC@THRONESOFBLOOD@EXPLORATIONSITES_STRATEGIC@STRUCTURE_ROSEPALACE@NAME_OVERRIDE@BANSHEE_3"
msgstr "Keening Courtyard"

msgid "DLC@THRONESOFBLOOD@EXPLORATIONSITES_STRATEGIC@STRUCTURE_ROSEPALACE@NAME_OVERRIDE@SLEEPING_1"
msgstr "Thorngarth Estate"

msgid "DLC@THRONESOFBLOOD@EXPLORATIONSITES_STRATEGIC@STRUCTURE_ROSEPALACE@NAME_OVERRIDE@SLEEPING_2"
msgstr "Reposed Rosarium"

msgid "DLC@THRONESOFBLOOD@EXPLORATIONSITES_STRATEGIC@STRUCTURE_ROSEPALACE@NAME_OVERRIDE@SLEEPING_3"
msgstr "Dormant Labyrinth"

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@CATEGORY@NAME"
msgstr "Vampire"

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@ABILITY_TYPE@NAME"
msgstr "Blood Drain"

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL01@DESCRIPTION"
msgstr "Deal damage to target unit and heal for {DRAIN_LIFESTEAL>ResolvedHealProportion}% of the damage dealt.[br/][br/]Cannot target units that are immune to {GLOBAL.PROPERTIES.BLEEDING.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL01@NAME"
msgstr "Draining Bite"

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL02@NAME"
msgstr "Siphon Blood"

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL03@DESCRIPTION"
msgstr "{GLOBAL.PROPERTIES.DRAINING_BITE.Hyperlink} removes {GLOBAL.DefenseModeConcept.Hyperlink} and <<m:{GLOBAL.RetaliationConcept.Hyperlink}>> unless the target has {GLOBAL.PROPERTIES.CHARGE_RESISTANCE.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL03@MOD_DESCRIPTION"
msgstr "Cancels {GLOBAL.DefenseModeConcept.Hyperlink} and <<m:{GLOBAL.RetaliationConcept.Hyperlink}>> unless the target has {GLOBAL.PROPERTIES.CHARGE_RESISTANCE.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL03@NAME"
msgstr "Staggering Bite"

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL04@DESCRIPTION"
msgstr "{GLOBAL.BloodDrainConcept.Hyperlink} abilities gain a base {STUNNED_RESISTANCE>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.STUNNED.Hyperlink} for {STUNNED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL04@NAME"
msgstr "Stunning Drain"

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL05@DESCRIPTION"
msgstr "{GLOBAL.BloodDrainConcept.Hyperlink} abilities now have a chance of inflicting {GLOBAL.PROPERTIES.MIND_CONTROLLED.Hyperlink} for {MIND_CONTROL_TEMP>NumTurns} <<m:{GLOBAL.TurnConcept}>> instead of {GLOBAL.PROPERTIES.STUNNED.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL05@NAME"
msgstr "Draining Charm"

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL06@DESCRIPTION"
msgstr "{GLOBAL.BloodDrainConcept.Hyperlink} abilities now have a chance of inflicting {GLOBAL.PROPERTIES.DOMINATED.Hyperlink} instead of {GLOBAL.PROPERTIES.MIND_CONTROLLED.Hyperlink}, which lasts until the end of combat."

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL06@NAME"
msgstr "Mesmerizing Drain"

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL07@DESCRIPTION"
msgstr "Deal unblockable damage to target friendly unit. Then the caster:[bulletlist][bullet/]Heals for {DRAIN_FAMILIAR_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Gains {amount} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} for {STRENGTHENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL07@NAME"
msgstr "Drain Familiar"

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL08@ABILITY_DESCRIPTION"
msgstr "Deal unblockable damage to target friendly unit, it gains:[bulletlist][bullet/]{amount} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} for {STRENGTHENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][br/]The caster then:[bulletlist][bullet/]Heals for {DRAIN_FAMILIAR_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Gains {amount2} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} for {STRENGTHENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL08@DESCRIPTION"
msgstr "{GLOBAL.PROPERTIES.DRAIN_FAMILIAR.Hyperlink} now grants the targeted unit {amount} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL08@NAME"
msgstr "Profane Strength"

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL09@ABILITY_DESCRIPTION"
msgstr "Deal unblockable damage to target friendly unit, it gains:[bulletlist][bullet/]{amount} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}[bullet/]{amount2} {GLOBAL.PROPERTIES.REGENERATION.Hyperlink}[/bulletlist][br/]The caster then:[bulletlist][bullet/]Heals for {DRAIN_FAMILIAR_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Gains {amount3} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} for {STRENGTHENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL09@DESCRIPTION"
msgstr "{GLOBAL.PROPERTIES.DRAIN_FAMILIAR.Hyperlink} also grants the targeted unit {amount} {GLOBAL.PROPERTIES.REGENERATION.Hyperlink} and the heal is increased to {amount2} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>."

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL09@NAME"
msgstr "Deep Bond"

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL10@DESCRIPTION"
msgstr "Reduce the cooldown of your {GLOBAL.BloodDrainConcept.Hyperlink} ability by {amount} {GLOBAL.TurnConcept}."

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL10@NAME"
msgstr "Deep Hunger"

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL11@DESCRIPTION"
msgstr "{GLOBAL.PROPERTIES.SIPHON_BLOOD.Hyperlink} gains +{amount} range."

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL11@NAME"
msgstr "Reaching Drain"

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL12@DESCRIPTION"
msgstr "Your {GLOBAL.BloodDrainConcept.Hyperlink} ability ignores {GLOBAL.DefenseConcept.Hyperlink} and {GLOBAL.ResistanceConcept.Hyperlink} from units suffering from {GLOBAL.PROPERTIES.BLEEDING.Hyperlink} or {GLOBAL.PROPERTIES.BLOOD_PARASITE.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL12@MOD_DESCRIPTION"
msgstr "Ignores {SANGUINE_EXTRACTION_DEFENSE_BYPASS>MODIFIERS>ResolvedArmor}% of {GLOBAL.DefenseConcept.Hyperlink} and {GLOBAL.ResistanceConcept.Hyperlink} from units suffering from {GLOBAL.PROPERTIES.BLEEDING.Hyperlink} or {GLOBAL.PROPERTIES.BLOOD_PARASITE.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL12@NAME"
msgstr "Sanguine Extraction"

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL13@DESCRIPTION"
msgstr "When this unit's <<m:{GLOBAL.HitPointConcept.Hyperlink}>> are reduced to zero, it is displaced by {MIST_AWAY_DISPLACEMENT>MaxDistance} hexes and heals +{hp} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[br/]Works once per battle."

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL13@NAME"
msgstr "Mist Away"

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL14@DESCRIPTION"
msgstr "When not mounted this unit gains:[bulletlist][bullet/]{GLOBAL.PROPERTIES.FLYING_MOVEMENT.Hyperlink} movement.[bullet/]{GLOBAL.PROPERTIES.FAST_MOVEMENT.Hyperlink}[bullet/]{VAMPIRIC_FLIGHT_ACCURACY>ResolvedAccuracyModifier}% evasion against {GLOBAL.RangedConcept.Hyperlink} and {GLOBAL.MagicConcept.Hyperlink} attacks.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL14@NAME"
msgstr "Vampiric Flight"

msgid "DLC@THRONESOFBLOOD@HERO_SKILL@VAMPIRE@SKILL14@PROP_DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]{GLOBAL.PROPERTIES.FLYING_MOVEMENT.Hyperlink}.[bullet/]{VAMPIRIC_FLIGHT_ACCURACY>ResolvedAccuracyModifier}% evasion against {GLOBAL.RangedConcept.Hyperlink} and {GLOBAL.MagicConcept.Hyperlink} attacks.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@HERO_TRAIT@GOVERNANCE@VAMPIRE_GOVERNOR@LVL0"
msgstr "Each {GLOBAL.PopulationConcept.Hyperlink} grants +{FoodBonusIncome}{GLOBAL.FoodConcept.Hyperlink}, +{DraftBonusIncome}{GLOBAL.UnitProductionConcept.Hyperlink}, and +{KnowledgeBonusIncome}{GLOBAL.KnowledgeConcept}."

msgid "DLC@THRONESOFBLOOD@HERO_TRAIT@GOVERNANCE@VAMPIRE_GOVERNOR@LVL1"
msgstr "Acquiring new {GLOBAL.PopulationConcept.Hyperlink} and <<m:{GLOBAL.ThrallConcept.Hyperlink}>> requires -{amount}% less {GLOBAL.FoodConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@HERO_TRAIT@GOVERNANCE@VAMPIRE_GOVERNOR@LVL2"
msgstr "Each {GLOBAL.MineConcept.Hyperlink} grants +{ImperiumBonus}{GLOBAL.ImperiumConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@HERO_TRAIT@GOVERNANCE@VAMPIRE_GOVERNOR@LVL3"
msgstr "Units cost -{Discount}% less {GLOBAL.GoldConcept.Hyperlink}, {GLOBAL.UnitProductionConcept.Hyperlink} and <<m:{GLOBAL.SoulConcept.Hyperlink}>> to recruit."

msgid "DLC@THRONESOFBLOOD@HERO_TRAIT@VAMPIRE_GOVERNOR@DESCRIPTION"
msgstr "While Governor, the governed city gains benefits based on the Renown level of this Hero:[bulletlist][bullet/][white]Renown level 1[/white][br/]Each {GLOBAL.PopulationConcept.Hyperlink} grants +{FoodBonusIncome}{GLOBAL.FoodConcept.Hyperlink}, +{DraftBonusIncome}{GLOBAL.UnitProductionConcept.Hyperlink}, and +{KnowledgeBonusIncome}{GLOBAL.KnowledgeConcept}.[bullet/][white]Renown level 2[/white][br/]Acquiring new {GLOBAL.PopulationConcept.Hyperlink} and <<m:{GLOBAL.ThrallConcept.Hyperlink}>> requires -{amount}% less {GLOBAL.FoodConcept.Hyperlink}[bullet/][white]Renown level 3[/white][br/]Each {GLOBAL.MineConcept.Hyperlink} grants +{ImperiumBonus}{GLOBAL.ImperiumConcept.Hyperlink}[bullet/][white]Renown level 4[/white][br/]Units cost -{Discount}% less {GLOBAL.GoldConcept.Hyperlink}, {GLOBAL.UnitProductionConcept.Hyperlink} and <<m:{GLOBAL.SoulConcept.Hyperlink}>> to recruit.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@HERO_TRAIT@VAMPIRE_GOVERNOR@NAME"
msgstr "Elder Vampire Governor"

msgid "DLC@THRONESOFBLOOD@INTERFACE@LOST_SOUL"
msgstr "Lost Soul"

msgid "DLC@THRONESOFBLOOD@INTERFACE@LOST_SOUL@DESCRIPTION"
msgstr "Ghostly presences, bound to this world until their unfinished business is put to rest.[br/][br/]Moving a [unitHero/] {GLOBAL.HeroConcept.Hyperlink} or [unitRuler/] {GLOBAL.LeaderConcept.Hyperlink} onto it will trigger a Lost Soul Quest."

msgid "DLC@THRONESOFBLOOD@INTERFACE@LOST_SOUL@HERO_NEEDED"
msgstr "The soul will only manifest in the presence of greater wills, like the ones of [unitHero/] [hyperlink,GLOBAL.HeroConcept]Heroes[/hyperlink] and [unitRuler/] [hyperlink,GLOBAL.LeaderConcept]Rulers[/hyperlink]."

msgid "DLC@THRONESOFBLOOD@INTERFACE@SWORD_SHIELD@NAME"
msgstr "Sword and Shield"

