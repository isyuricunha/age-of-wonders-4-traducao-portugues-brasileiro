msgid "DIPLOMACY@HOUSE_DIPLOMATIC_STATE@WAR"
msgstr "War"

msgid "DIPLOMACY@HOUSE_INFLUENCE@BLOCKED"
msgstr "Allegiance blocked"

msgid "DIPLOMACY@HOUSE_INFLUENCE@DESCRIPTION"
msgstr "Allegiance represents the commitment of a {GLOBAL.IndependentCityConcept.Hyperlink} to an {GLOBAL.EmpireConcept.Hyperlink}.[br/][br/]Allegiance is primarily gained by giving a {GLOBAL.DiplomaticTokenConcept} to the {GLOBAL.FreeCityLordConcept.Hyperlink} which starts <<m:{GLOBAL.NegotiationConcept.Hyperlink}>>. Increasing allegiance will result in better <<m:{GLOBAL.PvEDiplStateConcept.Hyperlink}>> with the city, eventually leading to a {GLOBAL.PactOfVassalageConcept.Hyperlink} and {GLOBAL.PactOfIntegrationConcept.Hyperlink}."

msgid "DIPLOMACY@HOUSE_INFLUENCE@HOSTAGES"
msgstr "Hostages"

msgid "DIPLOMACY@HOUSE_INFLUENCE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.HouseInfluenceConcept][allegiance/]Allegiance[/hyperlink]"

msgid "DIPLOMACY@HOUSE_INFLUENCE@MAX"
msgstr "Max Allegiance: [allegiance/]{MaxPoints}"

msgid "DIPLOMACY@HOUSE_INFLUENCE@MIN"
msgstr "Min Allegiance: [allegiance/]{MinPoints}"

msgid "DIPLOMACY@HOUSE_INFLUENCE@TEXT"
msgstr "Allegiance"

msgid "DIPLOMACY@HOUSE_INFLUENCE@TITLE"
msgstr "[allegiance/] Allegiance"

msgid "DIPLOMACY@HOUSE_INFLUENCE_BOOST@DESCRIPTION"
msgstr "Boosts negotiations by adding half of the required allegiance to reach the next diplomatic state. The cost of this action increases with the amount of allegiance gained. This action can only be executed once while in the current diplomatic state.[br/][br/]You gain: {Influence}[br/]Cost: {Cost}"

msgid "DIPLOMACY@HOUSE_INFLUENCE_BOOST@TEXT"
msgstr "Boost [allegiance/] Allegiance"

msgid "DIPLOMACY@HOUSE_INFLUENCE_BOOST@WARNING_ALREADYBOOSTED"
msgstr "[fireCol]Already boosted Allegiance during this Diplomatic State![/fireCol]"

msgid "DIPLOMACY@HOUSE_INFLUENCE_BOOST@WARNING_BLOCKED"
msgstr "[fireCol]Cannot boost because Allegiance gains are blocked![/fireCol]"

msgid "DIPLOMACY@HOUSE_INFLUENCE_BOOST@WARNING_CANNOTAFFORD"
msgstr "[fireCol]Cannot afford boost costs![/fireCol]"

msgid "DIPLOMACY@HOUSE_INFLUENCE_BOOST@WARNING_COOLDOWN"
msgstr "[fireCol]Cannot boost for another {Cooldown}<<m:{GLOBAL.TurnConcept.Hyperlink}>>![/fireCol]"

msgid "DIPLOMACY@HOUSE_INFLUENCE_BOOST@WARNING_NOGAIN"
msgstr "[fireCol]Boosting does not generate enough Allegiance![/fireCol]"

msgid "DIPLOMACY@HOUSE_INFLUENCE_BOOST@WARNING_NONEXTSTATE"
msgstr "[fireCol]There is no next Diplomatic State to boost toward![/fireCol]"

msgid "DIPLOMACY@HOUSE_INFLUENCE_BOOST@WARNING_REQUIREINFLUENCE"
msgstr "[fireCol]A {GLOBAL.DiplomaticTokenConcept.Hyperlink} must be assigned in order to boost Allegiance![/fireCol]"

msgid "DIPLOMACY@HOUSE_INFLUENCE_BOOST@WARNING_VASSAL"
msgstr "[fireCol]Cannot boost relations with <<m:{GLOBAL.IndependentCityConcept.Hyperlink}>> that are a [hyperlink,GLOBAL.PactOfVassalageConcept]Vassal[/hyperlink] of another Ruler.[/fireCol]"

msgid "DIPLOMACY@HOUSE_INFLUENCE_PER_TURN@TEXT"
msgstr "Allegiance per [turn/] turn"

msgid "DIPLOMACY@HOUSE_INFLUENCE_REQUIRED@TEXT"
msgstr "Required Allegiance"

msgid "DIPLOMACY@HOUSE_NEGOTIATION@TOOLTIP_ALREADYINTEGRATED"
msgstr "[fireCol]This {FreeCityType.Hyperlink} is already [hyperlink,GLOBAL.PactOfIntegrationConcept]Integrated[/hyperlink] by another Ruler.[/fireCol]"

msgid "DIPLOMACY@HOUSE_NEGOTIATION@TOOLTIP_ALREADYVASSALIZED"
msgstr "[fireCol]This {FreeCityType.Hyperlink} is already a [hyperlink,GLOBAL.PactOfVassalageConcept]Vassal[/hyperlink] to another Ruler.[/fireCol]"

msgid "DIPLOMACY@HOUSE_NEGOTIATION@TOOLTIP_CANNOTAFFORDCOST"
msgstr "[fireCol]Cannot afford negotiation costs![/fireCol]"

msgid "DIPLOMACY@HOUSE_NEGOTIATION@TOOLTIP_COOLDOWN"
msgstr "[fireCol]The {FreeCityType.Hyperlink} will not negotiate at this moment. Wait {Cooldown}[turn/] [hyperlink,GLOBAL.TurnConcept]turn(s)[/hyperlink] to negotiate![/fireCol]"

msgid "DIPLOMACY@HOUSE_NEGOTIATION@TOOLTIP_FIXEDRELATION"
msgstr "[fireCol]The {FreeCityType.Hyperlink} will not negotiate. Your relation with them is fixed![/fireCol]"

msgid "DIPLOMACY@HOUSE_NEGOTIATION@TOOLTIP_HOUSEOCCUPIED"
msgstr "[fireCol]The {FreeCityType.Hyperlink} cannot negotiate while it is being occupied![/fireCol]"

msgid "DIPLOMACY@HOUSE_NEGOTIATION@TOOLTIP_HOUSESIEGED"
msgstr "[fireCol]The {FreeCityType.Hyperlink} cannot negotiate while it is being [hyperlink,GLOBAL.SiegeConcept]sieged[/hyperlink]![/fireCol]"

msgid "DIPLOMACY@HOUSE_TRADE@CANNOTAFFORD"
msgstr "[fireCol]Cannot afford the per-turn [turn/] costs of this trade![/fireCol]"

msgid "DIPLOMACY@HOUSE_TRADE@CANNOTAFFORD_INSTANT"
msgstr "[fireCol]Cannot afford the costs of this trade![/fireCol]"

msgid "DIPLOMACY@HOUSE_WAR@COOLDOWN"
msgstr "[fireCol]Cannot declare war yet. Wait {Cooldown}<<m:{GLOBAL.TurnConcept.Hyperlink}>>.[/fireCol]"

msgid "DIPLOMACY@HOUSE_WAR_CHANCE@DESCRIPTION"
msgstr "Because of your {GLOBAL.IndependentCityRelationConcept.Hyperlink} with the {GLOBAL.IndependentCityConcept.Hyperlink}, there is a chance of the City declaring {GLOBAL.IndependentCityWarConcept.Hyperlink} on you at the start of every {GLOBAL.TurnConcept.Hyperlink}.[br/][br/]You will not suffer any penalties for this, but the City may start sending armies to attack you when war is declared."

msgid "DIPLOMACY@HOUSE_WAR_CHANCE@TEXT"
msgstr "[fireCol]{CHANCE} chance of the Free City declaring war while the state of relations is {STATE}![/fireCol]"

msgid "DIPLOMACY@HOUSE_WAR_CHANCE@TEXT_SHORT"
msgstr "[fireCol]{CHANCE} chance of War[/fireCol]"

msgid "DIPLOMACY@MANAGE_RELATION@TITLE"
msgstr "Settle Grievances"

msgid "DIPLOMACY@MANAGE_RELATION@TOOLTIP"
msgstr "Review and manage <<m:{GLOBAL.CasusBelliConcept.Hyperlink}>>. Grievances the opponent has against you can be paid off. You can also sell your own grievances or forgive them."

msgid "DIPLOMACY@MORALE_DESCRIPTION@HIGH"
msgstr "The unit is in high spirits and confident of victory.[br/][br/]Effects:[bulletlist][bullet/]{criticalChance}% {GLOBAL.CriticalHitChanceConcept.Hyperlink}[/bulletlist]"

msgid "DIPLOMACY@MORALE_DESCRIPTION@LOW"
msgstr "The unit is wavering and doubtful of victory.[br/][br/]Effects:[bulletlist][bullet/]Fumble Chance: {fumbleChance}%.[/bulletlist]"

msgid "DIPLOMACY@MORALE_DESCRIPTION@NORMAL"
msgstr "The unit is content and ready for battle.[br/][br/]Effects:[bulletlist][bullet/]None.[/bulletlist]"

msgid "DIPLOMACY@MORALE_DESCRIPTION@ROUTING"
msgstr "The unit is terrified and is fleeing for its life![br/][br/]Effects:[bulletlist][bullet/]Ignores zones of control and attacks of opportunity.[bullet/]{dodgeChance}% harder to hit with ranged attacks.[bullet/]Moves toward nearest [hyperlink,GLOBAL.RetreatingConcept]Retreat Point.[/hyperlink][/bulletlist]"

msgid "DIPLOMACY@MORALE_DESCRIPTION@VERY_LOW"
msgstr "The unit is despairing and close to breaking.[br/][br/]Effects:[bulletlist][bullet/]Fumble Chance: {fumbleChance}%.[/bulletlist]"

msgid "DIPLOMACY@MORALE_NAME@HIGH"
msgstr "High"

msgid "DIPLOMACY@MORALE_NAME@LOW"
msgstr "Low"

msgid "DIPLOMACY@MORALE_NAME@NORMAL"
msgstr "Neutral"

msgid "DIPLOMACY@MORALE_NAME@ROUTING"
msgstr "Routing"

msgid "DIPLOMACY@MORALE_NAME@VERY_LOW"
msgstr "Very Low"

