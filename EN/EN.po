msgid "DLC@WAYSOFWAR@UNITS_OATHSWORN@ABILITY08@NAME"
msgstr "Line Shot"

msgid "DLC@WAYSOFWAR@UNITS_OATHSWORN@ABILITY09@DESCRIPTION"
msgstr "Target unit:[bulletlist][bullet/]Sustains damage.[bullet/]Has a base {ARROW_OF_REMORSE_RESISTANCE_CHECK>ResolvedStrength}% chance of becoming {GLOBAL.PROPERTIES.PACIFIED.Hyperlink} for {PACIFICED_STATUS_DESCRIPTION>NumTurns} {GLOBAL.TurnConcept}.[/bulletlist]"

msgid "DLC@WAYSOFWAR@UNITS_OATHSWORN@ABILITY09@NAME"
msgstr "Arrow of Harmony"

msgid "DLC@WAYSOFWAR@UNITS_OATHSWORN@ABILITY10@DESCRIPTION"
msgstr "Deals damage to target unit."

msgid "DLC@WAYSOFWAR@UNITS_OATHSWORN@ABILITY10@NAME"
msgstr "Helmsplitter"

msgid "DLC@WAYSOFWAR@UNITS_OATHSWORN@ABILITY11@DESCRIPTION"
msgstr "Enemy units in a {RENDING_SLASH_TARGETER>AREA>Length}-hex long, {RENDING_SLASH_SIDE_TARGETER>AREA>Radius}-hex wide line:[bulletlist][bullet/]Sustain damage.[bullet/]Gain {GLOBAL.PROPERTIES.BLINDED.Hyperlink} for {BLINDED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@WAYSOFWAR@UNITS_OATHSWORN@ABILITY11@NAME"
msgstr "Radiant Slash"

msgid "DLC@WAYSOFWAR@UNITS_OATHSWORN@ABILITY12@DESCRIPTION"
msgstr "A Charge attack:[bulletlist][bullet/]Gains +{FLAMING_CHARGE_STRIKE_DISTANCE_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} per hex traveled, up to {FLAMING_CHARGE_STRIKE_DISTANCE_DAMAGE>MaxCount} hexes.[bullet/]Cancels {GLOBAL.DefenseModeConcept.Hyperlink}.[bullet/]Removes {GLOBAL.RetaliationConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@WAYSOFWAR@UNITS_OATHSWORN@ABILITY12@NAME"
msgstr "Flaming Charge Strike"

msgid "DLC@WAYSOFWAR@UNITS_OATHSWORN@ABILITY13@DESCRIPTION"
msgstr "Move {BULLDOZE_MOVE_TARGETER>AREA>Offset} hexes forward. Enemies in the way sustain damage."

msgid "DLC@WAYSOFWAR@UNITS_OATHSWORN@ABILITY13@NAME"
msgstr "Bulldoze"

msgid "DLC@WAYSOFWAR@UNITS_OATHSWORN@ABILITY14@DESCRIPTION"
msgstr "[bulletlist][bullet/]Gain {amount} {GLOBAL.PROPERTIES.INFERNAL_MIGHT.Hyperlink} for {INFERNAL_BLAZE_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Adjacent enemies sustain damage.[/bulletlist]"

msgid "DLC@WAYSOFWAR@UNITS_OATHSWORN@ABILITY14@NAME"
