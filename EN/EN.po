msgid "DLC@ELDRITCHREALMS@STORY_REALM_02@CRISIS@NOTIFICATION_DESC@TREE_TAKEN"
msgstr "{WORLD.ER2_WORLD_TREE_PLAYER} has conquered the {WORLD.ER2_WORLD_TREE_STRUCTURE} and is entering dark communion with Athla. The Nightweaver Ritual will progress twice as fast until the {WORLD.ER2_WORLD_TREE_STRUCTURE} is liberated again!"

msgid "DLC@ELDRITCHREALMS@STORY_REALM_02@GOOD_VIC_QUEST@OBJECTIVE_01"
msgstr "{INT_0}/{INT_1} Lithyl defeated"

msgid "DLC@ELDRITCHREALMS@STORY_REALM_02@GOOD_VIC_QUEST@OBJECTIVE_02"
msgstr "{INT_0}/{INT_1} Merlin defeated"

msgid "DLC@ELDRITCHREALMS@STORY_REALM_02@GOOD_VIC_QUEST@OBJECTIVE_03"
