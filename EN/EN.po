msgstr "The Gelid Throne^N"

msgid "DLC@GIANTKINGS@TSR_DGC@TOOLTIP@COBWEB_SECTOR"
msgstr "This chamber is affected by {GLOBAL.PROPERTIES.TSR_DGC_COBWEB_INFESTATION.Hyperlink}."

