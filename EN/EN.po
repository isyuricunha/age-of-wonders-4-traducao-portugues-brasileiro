msgid "DLC@GIANTKINGS@TSR_DGC@NOTIFICATION@PHASE2_HEADER"
msgstr "Deepglitter Chambers: {TSR_WINNING_PLAYER} excavated First Chamber!"

msgid "DLC@GIANTKINGS@TSR_DGC@NOTIFICATION@PHASE3_DESC"
msgstr "After {TSR_WINNING_PLAYER} dealt with the spider infestation within the First Chamber, the {GLOBAL.ColtLoreConcept.Hyperlink} moved in with their <<m:{GLOBAL.UNITS.DEVASTATOR_SPHERE_UNIT.Hyperlink}>> to break through the bedrock, opening way to the Second Chamber."

msgid "DLC@GIANTKINGS@TSR_DGC@NOTIFICATION@PHASE3_HEADER"
msgstr "Deepglitter Chambers: Second Tunnel Breached!"

msgid "DLC@GIANTKINGS@TSR_DGC@NOTIFICATION@PHASE4_DESC"
msgstr "{TSR_WINNING_PLAYER} has excavated the second Deepglitter Chamber, a dungeon filled with tireless clay soldiers and traps. The dungeon must be cleared, so the {GLOBAL.ColtLoreConcept.Hyperlink} can break open the path to the next chamber."

msgid "DLC@GIANTKINGS@TSR_DGC@NOTIFICATION@PHASE4_HEADER"
msgstr "Deepglitter Chambers: {TSR_WINNING_PLAYER} excavated Second Chamber!"

msgid "DLC@GIANTKINGS@TSR_DGC@NOTIFICATION@PHASE5_DESC"
msgstr "After {TSR_WINNING_PLAYER} dealt with the dungeon defenders of the Second Chamber, the {GLOBAL.ColtLoreConcept.Hyperlink} moved in with their <<m:{GLOBAL.UNITS.DEVASTATOR_SPHERE_UNIT.Hyperlink}>> to break through the bedrock, opening way to the Third Chamber."

msgid "DLC@GIANTKINGS@TSR_DGC@NOTIFICATION@PHASE5_HEADER"
msgstr "Deepglitter Chambers: Third Tunnel Breached!"

msgid "DLC@GIANTKINGS@TSR_DGC@NOTIFICATION@PHASE6_DESC"
msgstr "{TSR_WINNING_PLAYER} has excavated the third Deepglitter Chamber, revealing {TSR_DGC_STRUCTURE}! We must make haste if we want to claim the treasures inside."

msgid "DLC@GIANTKINGS@TSR_DGC@NOTIFICATION@PHASE6_HEADER"
msgstr "Deepglitter Chambers: {TSR_WINNING_PLAYER} excavated Third Chamber!"

msgid "DLC@GIANTKINGS@TSR_DGC@NOTIFICATION_TRAP_DESC"
