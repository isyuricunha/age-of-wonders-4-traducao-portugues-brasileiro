msgid "TOME_SANCTUARY@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Create a safe haven for all believers. Specialize in healing and buffing defenses."

msgid "TOME_SANCTUARY@TOME@LORE_AUTHOR"
msgstr "Anon, Archon Wizard of Life"

msgid "TOME_SANCTUARY@TOME@LORE_DESCRIPTION"
msgstr "\"My faith is my shield. I am armored by love. I shall envelop the world in this armor, to safeguard it and bless it with healing light! I am the bastion of the weak. I fortify the strong. The warriors of truth follow in my wake, like a wave of justice made flesh!\""

msgid "TOME_SANCTUARY@TOME@NAME"
msgstr "Tome of Sanctuary"

msgid "TOME_SANCTUARY@UNIT1@NAME"
msgstr "Healing Spire^n"

