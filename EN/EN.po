msgid "INTERFACE@TEXT@PANTHEON_INTRO_DESC"
msgstr "{GLOBAL.MagehavenLoreConcept.Hyperlink} is a sanctuary between worlds. From here, powerful Rulers called [hyperlink,GLOBAL.GodirLoreConcept]Godir[/hyperlink] venture to realms within the [hyperlink,GLOBAL.AstralSeaLoreConcept]Astral Sea[/hyperlink]. \n"
"\n"
