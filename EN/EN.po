msgstr "Base attacks gain a base {DECAYING_RESISTANCE>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.DECAYING.Hyperlink}.[br/][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CYCLES@HERO_SKILL@NAME"
msgstr "Withering Decay"

msgid "TOME_CYCLES@PASSIVE@DESCRIPTION"
msgstr "Decreases in morale that arise from the death of friendly units are halved."

msgid "TOME_CYCLES@PASSIVE@NAME"
msgstr "Cycle of Life"

msgid "TOME_CYCLES@SKILL1@DESCRIPTION"
msgstr "Makes attacks of enchanted units:[bulletlist][bullet/]Inflict {GLOBAL.PROPERTIES.DECAYING.Hyperlink}, a damage-over-time effect that decreases healing received.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CYCLES@SKILL1@NAME"
msgstr "Blades of Decay"

msgid "TOME_CYCLES@SKILL1@PROP_DESCRIPTION"
msgstr "Unit's attacks:[bulletlist][bullet/]Inflict {GLOBAL.PROPERTIES.DECAYING.Hyperlink}.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CYCLES@SKILL2@DESCRIPTION"
msgstr "{GLOBAL.PROPERTIES.SUPPORT_UNIT.Hyperlink} that manipulates life and death as part of the natural cycle."

msgid "TOME_CYCLES@SKILL2@NAME"
msgstr "Druid of the Cycle^n"

msgid "TOME_CYCLES@SKILL3@DESCRIPTION"
msgstr "Target enemy unit:[bulletlist][bullet/]Sustains {DIFFUSE_HEALTH_DAMAGE>DAMAGE>Blight} {GLOBAL.BlightDamageConcept.Hyperlink}.[bullet/]Gains {amountDecaying} {GLOBAL.PROPERTIES.DECAYING_DAMAGE_OVER_TIME.Hyperlink}.[/bulletlist][br/]Friendly units in a {DIFFUSE_HEALTH_UNIT_TARGETER_FRIENDLY>AREA>Radius}-hex range. [bulletlist][bullet/]Heal +{DIFFUSE_HEALTH_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Gain {amountRegeneration} {GLOBAL.PROPERTIES.REGENERATION.Hyperlink}.[/bulletlist]"

msgid "TOME_CYCLES@SKILL3@NAME"
msgstr "Diffuse Health"

msgid "TOME_CYCLES@SKILL4@DESCRIPTION"
msgstr "Until the end of battle, whenever a friendly unit dies, all other friendly units within {PARTING_GIFTS_UNIT_TARGETER_CIRCLE>AREA>Radius} hexes heal +{PARTING_GIFTS_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>."

msgid "TOME_CYCLES@SKILL4@NAME"
msgstr "Parting Gifts"

msgid "TOME_CYCLES@SKILL4@PROP_DESCRIPTION"
msgstr "When this unit dies, friendly units within {amount} hexes heal it +{amount2} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>."

msgid "TOME_CYCLES@SKILL5@AUTUMN_DESCRIPTION"
msgstr "Owner's enemies are inflicted with {amount4} {GLOBAL.PROPERTIES.WEAKENED.Hyperlink}."

msgid "TOME_CYCLES@SKILL5@AUTUMN_NAME"
msgstr "Cycle of Seasons: Autumn"

msgid "TOME_CYCLES@SKILL5@DESCRIPTION"
msgstr "All battles that take place in target city's domain gain [abilityblue]Cycle of Seasons[/abilityblue], granting a different effect each battle turn in the following order:[bulletlist][bullet/]Winter: All enemies sustain {amount} [damageFrost/].[bullet/]Spring: All friendly units become {amount2} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}.[bullet/]Summer: All friendly units heal +{amount3} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Autumn: All enemies become {amount4} {GLOBAL.PROPERTIES.WEAKENED.Hyperlink}.[/bulletlist]"

msgid "TOME_CYCLES@SKILL5@DISPLAY_DESCRIPTION"
msgstr "Grant a different effect each turn in the following order:"

msgid "TOME_CYCLES@SKILL5@NAME"
msgstr "Cycle of Seasons"

msgid "TOME_CYCLES@SKILL5@SPRING_DESCRIPTION"
msgstr "Owner's units become {amount2} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}."

