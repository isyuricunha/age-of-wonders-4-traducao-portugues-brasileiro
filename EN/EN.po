msgstr "Deals damage and inflicts {GLOBAL.PROPERTIES.FIRE_SEAL_DEBUFF_GROUP.Hyperlink}, a link effect that lasts for {FIRE_SEAL_LINK>Duration}<<m:{GLOBAL.TurnConcept}>>."

msgid "DLC@WAYSOFWAR@UNITS_OATHSWORN@ABILITY07@ENHANCED_NAME"
msgstr "Enhanced Fire Seal"

msgid "DLC@WAYSOFWAR@UNITS_OATHSWORN@ABILITY07@MASTER_NAME"
msgstr "Champion Fire Seal"

msgid "DLC@WAYSOFWAR@UNITS_OATHSWORN@ABILITY07@NAME"
msgstr "Fire Seal"

msgid "DLC@WAYSOFWAR@UNITS_OATHSWORN@ABILITY07@PROP_DESCRIPTION"
msgstr "At the start of the turn, this unit sustains {FIRE_SEAL_AUTO_SPELL_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[br/][br/]If the unit dies while under this effect, it explodes dealing {FIRE_SEAL_ON_UNIT_DEATH_DAMAGE>DAMAGE>Fire}{GLOBAL.FireDamageConcept.Hyperlink} to adjacent friendly units."

msgid "DLC@WAYSOFWAR@UNITS_OATHSWORN@ABILITY07@PROP_NAME"
msgstr "Seal of Fire"

msgid "DLC@WAYSOFWAR@UNITS_OATHSWORN@ABILITY07@PROP_NAME_ENHANCED"
msgstr "Enhanced Seal of Fire"

msgid "DLC@WAYSOFWAR@UNITS_OATHSWORN@ABILITY07@PROP_NAME_MASTER"
msgstr "Champion Seal of Fire"

msgid "DLC@WAYSOFWAR@UNITS_OATHSWORN@ABILITY08@DESCRIPTION"
