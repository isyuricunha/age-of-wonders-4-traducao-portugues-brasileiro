msgid "CULTURE_FEUDAL@HERO_SKILL_4@DESCRIPTION"
msgstr "While army leader, units in the army [hyperlink,GLOBAL.WorldMapRegeneration]regenerate[/hyperlink] +{hprestore} <<m:{GLOBAL.HitPointConcept.Hyperlink}>> in friendly and neutral territory.[br/][br/]In addition, after winning combat, units in the army regain {mprestore} <<m:{GLOBAL.MovePointConcept.Hyperlink}>>.[br/]This triggers once per {GLOBAL.WorldMapConcept.Hyperlink} {GLOBAL.TurnConcept.Hyperlink}[br/][br/]Only one Hero can be this Lord at any time."

msgid "CULTURE_FEUDAL@HERO_SKILL_4@NAME"
msgstr "Lord of War"

msgid "CULTURE_FEUDAL@HERO_SKILL_4@UNIT_EFFECT_DESCRIPTION"
msgstr "This unit restores {hprestore} <<m:{GLOBAL.HitPointConcept.Hyperlink}>> and {mprestore} <<m:{GLOBAL.MovePointConcept.Hyperlink}>> after winning combat once per {GLOBAL.WorldMapConcept.Hyperlink} {GLOBAL.TurnConcept.Hyperlink}."

