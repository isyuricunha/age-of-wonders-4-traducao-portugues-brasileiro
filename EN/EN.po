msgstr "{STR_leaderName} became an enemy through a call to war"

msgid "DIPLOMACY_CASUS_BELLI@ANTIWARMONGER@TITLE"
msgstr "{STR_leaderName} is evil and should be eradicated"

msgid "DIPLOMACY_CASUS_BELLI@ATTACKEDALLIEDFACTION@TITLE"
msgstr "{STR_leaderName} attacked our allied factions"

msgid "DIPLOMACY_CASUS_BELLI@ATTACKEDTRESPASSER@TITLE"
msgstr "{STR_leaderName} attacked a non-hostile army"

msgid "DIPLOMACY_CASUS_BELLI@ATTACKED_SHOP@TITLE"
msgstr "{STR_leaderName} attacked a shop in my domain"

