msgstr "Divination Dome"

msgid "DLC@ARCHONPROPHECY@EXPLORATIONSITES_STRATEGIC@STRUCTURE_OBSERVATORY@NAME_OVERRIDE@SERVITUDE_1"
msgstr "Forgotten Astrarium"

