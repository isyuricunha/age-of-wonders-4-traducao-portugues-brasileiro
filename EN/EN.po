msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@CASCADE_FALLS@NAME_OVERRIDE_04"
msgstr "Spiritfalls"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@DESTROYTHERING@DESCRIPTION"
msgstr "The Halfling Hero will cast their ring into the volcano. The Ring will be permanently destroyed and you will gain {alignment} Alignment."

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@DESTROYTHERING@NAME"
msgstr "Destroy the Ring [reputation6/]"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@DRAGON_REMAINS@DESCRIPTION"
msgstr "<<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacent to this Landmark gain:[bulletlist][bullet/]{income}[bullet/]The {combatproperty} {GLOBAL.CombatEnchantmentConcept.Hyperlink}[/bulletlist][br/]A {GLOBAL.CityConcept.Hyperlink} with {amount} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacent to this Landmark gain:[bulletlist][bullet/]Unlocks recruitment of tier 4 and 5 {GLOBAL.PROPERTIES.DRAGON.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>>.[/bulletlist]"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@DRAGON_REMAINS@LORE"
msgstr "\"Gazing up at the remnants of what once was a majestic hoard, one cannot help but contemplate the [hyperlink,GLOBAL.DragonsLoreConcept]Dragon[/hyperlink] that fell here, and its destructive rivalry with the {GLOBAL.GiantsLoreConcept.Hyperlink}. See how even the bones seem to still protect its treasures. As the wind howled through the peaks, I swear I could hear the dragon's ancient roar still...\"[br/][br/]— Fangir Rockborne, Journals from the Second Age: Part II"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@DRAGON_REMAINS@NAME"
msgstr "Ancient Dragon Hoard"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@DRAGON_REMAINS@NAME_OVERRIDE_01"
msgstr "Dragonteeth Ridge"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@DRAGON_REMAINS@NAME_OVERRIDE_02"
