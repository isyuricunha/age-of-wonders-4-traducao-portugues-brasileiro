msgid "DLC@PRIMALFURY@EVENT@SPIRIT_QUEST_ENCOUNTER_EVENTPHRASE@MAMMOTH"
msgstr "the tree draws in all heat from the air"

msgid "DLC@PRIMALFURY@EVENT@SPIRIT_QUEST_ENCOUNTER_EVENTPHRASE@SABERTOOTH"
msgstr "its branches continuously twist and gnarl before your eyes"

msgid "DLC@PRIMALFURY@EVENT@SPIRIT_QUEST_ENCOUNTER_EVENTPHRASE@SERPENT"
msgstr "sand slowly heaps up at the bottom of its trunk"

msgid "DLC@PRIMALFURY@EVENT@SPIRIT_QUEST_ENCOUNTER_EVENTPHRASE@SPIDER"
