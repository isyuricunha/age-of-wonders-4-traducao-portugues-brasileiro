msgid "INTERFACE@STRATEGIC_MAP@WIZARD_TOWER"
msgstr "Wizard Tower"

msgid "INTERFACE@STRATEGIC_MAP@WIZARD_TOWER_DESCRIPTION"
msgstr "The Wizard Tower is the center of a {GLOBAL.LeaderConcept.Hyperlink}'s powers. Only one can be built in the {GLOBAL.ThroneCityConcept.Hyperlink} after building the Town Hall II .[br/][br/]It unlocks Empire-wide benefits, provides {GLOBAL.ImperiumConcept.Hyperlink} income, and improves the {GLOBAL.VisionRangeConcept.Hyperlink} of the {GLOBAL.ThroneCityConcept.Hyperlink}.[br/][br/]Allows the construction of the {GLOBAL.ItemForgeConcept.Hyperlink} after building the {GLOBAL.STRUCTURE_UPGRADES.WIZARD_TOWER_FOUNDATION.Hyperlink}."

