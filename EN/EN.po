msgid "DLC@THRONESOFBLOOD@META_EMPIRE@ASCENSION_TRAIT@BLOOD_RITE@HERO_TRAIT_NAME"
msgstr "Ascension: Blood Rite"

msgid "DLC@THRONESOFBLOOD@META_EMPIRE@ASCENSION_TRAIT@BLOOD_RITE@HERO_TRAIT_PROP_DESCRIPTION"
