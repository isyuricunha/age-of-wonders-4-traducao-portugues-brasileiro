msgid "CRISIS@1194_642@DESCRIPTION"
msgstr "The Infernal [hyperlink,GLOBAL.WorldsWithinLoreConcept]World[/hyperlink] of {GLOBAL.ObbadothLoreConcept.Hyperlink}, realm of war and [hyperlink,GLOBAL.ChaosConcept]Chaos[/hyperlink], is cause for many a wary tale. The beings who rule Obbadoth promise great powers... to those who can pay the price."

msgid "CRISIS@1194_642@NAME"
msgstr "Fiendish Takeover"

msgid "CRISIS@1194_642@SUB_HEADER"
msgstr "{IntriguePreviousRuler} has been replaced..."

msgid "CRISIS@1224_784@DESCRIPTION"
msgstr "The last survivor of a nomadic tribe asks for your aid. The protecting ritual to keep the region safe has been lost. The origin of the contamination must be eradicated to save the realm."

msgid "CRISIS@1224_784@NAME"
msgstr "Core of Contamination"

msgid "CRISIS@1224_784@SUB_HEADER"
msgstr "Excavate the sectors to reach the source."

msgid "CRISIS@1224_784@SUB_HEADER_2"
msgstr "Clear the {TSR_RFR_SOE_STRUCTURE} to eradicate the contamination."

msgid "CRISIS@991_6559@DESCRIPTION"
msgstr "The Gilded Wastes once were a flourishing gold mining complex. The days of ancient Myrrida are long gone, but it appears that many of its riches survived the ages unspoiled."

msgid "CRISIS@991_6559@NAME"
msgstr "Gilded Wastes"

msgid "CRISIS@991_6559@SUB_HEADER"
msgstr "Seek the old Myrridan treasures!"

msgid "CRISIS@991_6829@DESCRIPTION"
msgstr "The Molten Scar is an arrangement of chasms whose shape bears semblance to the markings of a gargantuan claw. It is believed to have been inflicted on the land during the Great Hunt, when the Elder Giants battled the large Primordial Beasts."

msgid "CRISIS@991_6829@NAME"
msgstr "Molten Scar"

msgid "CRISIS@991_6829@SUB_HEADER"
msgstr "Free the beasts captured by the {GLOBAL.FireClanLoreConcept.Hyperlink}!"

msgid "CRISIS@991_6947@DESCRIPTION"
msgstr "The {GLOBAL.StoneClanLoreConcept.Hyperlink} has built up these halls anew, aspiring to emulate the grandeur of their [hyperlink,GLOBAL.GiantKingLoreConcept]Elder Giant[/hyperlink] forefathers. They believe in a Creator watching over their chambers, where one can commune with the mysteries of the material world."

msgid "CRISIS@991_6947@NAME"
msgstr "Hall of Enigmas"

msgid "CRISIS@991_6947@SUB_HEADER"
msgstr "Unravel the mysteries of the {GLOBAL.StoneClanLoreConcept.Hyperlink}."

msgid "CRISIS@991_7025@DESCRIPTION"
msgstr "The Giant Clans believe that you, the owner of their Menhir Artifacts from Titan's Henge, are the spiritual Heir of Thagnokar, destined to unite Giant kin and lead them to new glory. To them, this glory may only be achieved through combat and the downfall of the empires of the smaller races."

msgid "CRISIS@991_7025@NAME"
msgstr "Thagnokar's Heir"

msgid "CRISIS@991_7025@SUB_HEADER"
msgstr "The Giant Clans are preparing their assault."

msgid "CRISIS@991_7490@DESCRIPTION"
msgstr "This region was once a bastion of the {GLOBAL.BloodClanLoreConcept.Hyperlink}. Now it is taken over by the {GLOBAL.TraitorKingCultLoreConcept.Hyperlink}, and the {TSR_TROLL_KING} seeks help to regain control of <<o:{TSR_TROLL_KING}>> throne."

msgid "CRISIS@991_7490@NAME"
msgstr "Mount Godkeep"

msgid "CRISIS@991_7490@SUB_HEADER"
msgstr "The {GLOBAL.TraitorKingCultLoreConcept.Hyperlink} are practicing dark rituals in this region..."

msgid "CRISIS@991_7562@DESCRIPTION"
msgstr "The {GLOBAL.ColtLoreConcept.Hyperlink} are busy excavating and looting the ruins of a Myrridan city. They make use of <<m:{GLOBAL.UNITS.DEVASTATOR_SPHERE_UNIT.Hyperlink}>> to break through even the hardest bedrock, yet there are many dangers that may be unearthed this way..."

msgid "CRISIS@991_7562@NAME"
msgstr "Deepglitter Chambers"

msgid "CRISIS@991_7562@SUB_HEADER"
msgstr "The {GLOBAL.ColtLoreConcept.Hyperlink} are excavating the ruins of a Myrridan city..."

msgid "CRISIS@991_7674@DESCRIPTION"
msgstr "A {TSR_HORNED_GOD} watches over the overgrown ruins of this region. <<Cp:{TSR_HORNED_GOD}>> holds grudges against all Dragon kin and seeks to eradicate the Draconic creatures disturbing the peace of <<o:{TSR_HORNED_GOD}>> garden."

msgid "CRISIS@991_7674@NAME"
msgstr "Colonnade Garden"

msgid "CRISIS@991_7674@SUB_HEADER"
msgstr "There are Draconic denizens roaming this region..."

msgid "CRISIS@991_7747@DESCRIPTION"
msgstr "The three islands of this region are watched over by a powerful {TSR_CRYSTAL_LORD}. Answer well in <<o:{TSR_CRYSTAL_LORD}>> trials to inherit <<o:{TSR_CRYSTAL_LORD}>> ancient knowledge—or fail and face <<o:{TSR_CRYSTAL_LORD}>> wrathful judgment."

msgid "CRISIS@991_7747@NAME"
msgstr "Trinity Island"

msgid "CRISIS@991_7747@SUB_HEADER"
msgstr "Visit the eternal prisoners of the {TSR_CRYSTAL_LORD} to answer <<o:{TSR_CRYSTAL_LORD}>> three trials!"

msgid "CULTURE_ARCHITECT@CITY_ADJECTIVE_01@NAME"
msgstr "Perfectum^a"

msgid "CULTURE_BARB@INVIGORATE@DESCRIPTION"
msgstr "Grants friendly units in a {INVIGORATE_TARGETER>AREA>Radius}-hex radius:[bulletlist][bullet/]{INVIGORATE_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>[bullet/]{GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.REGENERATION.Hyperlink}[/bulletlist]"

msgid "CULTURE_BARB@INVIGORATE@DESCRIPTION_2"
msgstr "Grants friendly units in a {INVIGORATE_TARGETER>AREA>Radius}-hex radius:[bulletlist][bullet/]{INVIGORATE_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>[bullet/]{strengthAmount} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}[bullet/]{regenAmount} {GLOBAL.PROPERTIES.REGENERATION.Hyperlink}[/bulletlist]"

msgid "CULTURE_BARB@INVIGORATE@DESCRIPTION_CHAMPION"
msgstr "Invigorate:[bulletlist][bullet/]Grants an additional {stregnthAmount} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}.[bullet/]Grants an additional {regenAmount} {GLOBAL.PROPERTIES.REGENERATION.Hyperlink}.[bullet/]Cooldown reduced by {cooldown} {GLOBAL.TurnConcept.Hyperlink}[/bulletlist]"

msgid "CULTURE_BARB@INVIGORATE@NAME"
msgstr "Invigorate"

msgid "CULTURE_BARB@INVIGORATE@NAME_CHAMPION"
msgstr "Champion Invigorate"

msgid "CULTURE_BARB@KINDLE_RESOLVE@DESCRIPTION"
msgstr "Target friendly unit:[bulletlist][bullet/]Loses {GENERAL_DISPEL_NEGATIVE>NumThingsToDispel} <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>>.[bullet/]Gains {KINDLE_RESOLVE_MORALE>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}.[/bulletlist]"

msgid "CULTURE_BARB@KINDLE_RESOLVE@NAME"
msgstr "Kindle Resolve"

