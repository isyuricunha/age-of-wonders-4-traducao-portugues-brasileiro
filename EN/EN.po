msgid "DLC@SECRETSOFTHEARCHMAGES@STORY_REALM_MISSION_02@TOOLTIP@BREAK_ALL_CHAINS"
msgstr "You empower the {Beast} enough for it to break free from its chains![bulletlist][bullet/]This destroys the defensive structures and populations of all nearby Chain Cities in the process.[bullet/]All units of any remaining {GLOBAL.DemonicPrinceLoreConcept.Hyperlink} will become utterly demoralized.[bullet/]All remaining enemy factions will join in a desperate {GLOBAL.DefensivePactConcept.Hyperlink}.[bullet/]Freeing the {Beast} instantly completes the {EventQuest}.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@STORY_REALM_MISSION_02@TOOLTIP@CHAIN_DESTROYED"
