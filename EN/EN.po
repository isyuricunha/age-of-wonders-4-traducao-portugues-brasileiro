msgid "DLC@GIANTKINGS@DIPLOMACY@CRYSTAL_DWELLING@STONE_PACT@DESRCIPTION"
msgstr "[bulletlist][bullet/]The {GLOBAL.CrystalDwellingConcept.Hyperlink} opens its borders.[bullet/]Unlocks purchase of the following trade items via Cooperation:[bulletlist][bullet/]{GLOBAL.TOKENDEFINITION.LITHORITE_SCROLL_ARTIFACT.Hyperlink}[bullet/]{GLOBAL.UNITS.LITHORINE_NEEDLER.Hyperlink}[bullet/]{GLOBAL.EQUIPMENT.GOLDSEEKERS_PICKAXE.Hyperlink}[bullet/]{GLOBAL.EQUIPMENT.LITHORITE_ORB.Hyperlink}[bullet/]{GLOBAL.EQUIPMENT.SHATTER_BLADES.Hyperlink}[bullet/]{GLOBAL.EQUIPMENT.TITANS_GREATBOW.Hyperlink}[/bulletlist][bullet/]Completing Dwelling quests rewards guaranteed hero items in addition to their other rewards.[/bulletlist]"

