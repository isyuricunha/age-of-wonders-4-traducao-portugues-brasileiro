msgstr "Torment and Pain"

msgid "DLC@THRONESOFBLOOD@META_EMPIRE@ASCENSION_TRAIT@TORMENT_AND_PAIN@HERO_TRAIT_DESCRIPTION"
msgstr "In a {TORMENT_AND_PAIN_CIRCLE>AREA>Radius}-hex radius enemy units:[bulletlist][bullet/]Sustain damage.[bullet/]Gain {TORMENT_REPEATER>Count} stacks of {GLOBAL.PROPERTIES.TORMENT.Hyperlink}.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@META_EMPIRE@ASCENSION_TRAIT@TORMENT_AND_PAIN@HERO_TRAIT_NAME"
msgstr "Ascension: Torment and Pain"

