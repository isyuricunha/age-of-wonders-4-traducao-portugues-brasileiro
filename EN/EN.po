msgstr "Beware the roaming wyverns!"

msgid "DLC@GIANTKINGS@TSR_CSP@DESCRIPTION"
msgstr "At the center of the Crystalstorm Plateau, a terrible storm rages. It attracts large quantities of Lithorine, making the region dangerous to traverse."

msgid "DLC@GIANTKINGS@TSR_CSP@HEADER"
msgstr "There are {GLOBAL.PROPERTIES.TSR_CRYSTAL_STORM_AUTO_SPELL.Hyperlink} raging in this region."

msgid "DLC@GIANTKINGS@TSR_CSP@HEADER_02"
msgstr "Collect Lithorine cores for the Swamp Troll."

msgid "DLC@GIANTKINGS@TSR_CSP@HEADER_03"
msgstr "The {GLOBAL.PROPERTIES.TSR_CRYSTAL_STORM_AUTO_SPELL.Hyperlink} has been repelled to the center of the region."

msgid "DLC@GIANTKINGS@TSR_CSP@HEADER_04"
msgstr "You have foiled the plans of the {GLOBAL.StormClanLoreConcept.Hyperlink}!"

msgid "DLC@GIANTKINGS@TSR_CSP@HEADER_04_OTHER_PLAYER"
msgstr "{TSR_WINNING_PLAYER} has foiled the plans of the {GLOBAL.StormClanLoreConcept.Hyperlink}!"

