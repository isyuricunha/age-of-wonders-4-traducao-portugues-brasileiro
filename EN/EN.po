msgstr "A truce is a {GLOBAL.TreatyConcept.Hyperlink} formed between two <<m:{GLOBAL.EmpireConcept.Hyperlink}>> to end a {GLOBAL.WarConcept.Hyperlink} peacefully. They can then choose to further improve their relations through <<m:{GLOBAL.TradeConcept.Hyperlink}>>.[br/][br/]A truce lasts {Duration} <<m:{GLOBAL.TurnConcept.Hyperlink}>> and grants {AlignmentBonus}. If one of the Rulers decides to declare war on the other during the truce, they will receive a severe alignment penalty.[br/][br/]Rulers can only form this treaty when going to {GLOBAL.DSNeutralConcept.Hyperlink} from war."

msgid "TOMEOFWONDERS@VASSALAGE@NAME"
msgstr "Vassalage"

msgid "TOMEOFWONDERS@VICTORY@NAME"
msgstr "Victory"

msgid "TOME_AMPLIFICATION@HERO_SKILL@NAME"
msgstr "Spell Amplification"

msgid "TOME_AMPLIFICATION@PASSIVE@DESCRIPTION"
msgstr "<<m:{GLOBAL.DamageSpellConcept.Hyperlink}>> cost -{amount} <<m:{GLOBAL.CombatCastingPointConcept.Hyperlink}>>."

msgid "TOME_AMPLIFICATION@PASSIVE@NAME"
