msgid "DLC@GIANTKINGS@BASE_ABILITY@MAGIC_BLAST@ETERNALS"
msgstr "Eternal's Blast"

msgid "DLC@GIANTKINGS@BASE_ABILITY@MAGIC_BLAST@ETERNALS_DESCRIPTION"
msgstr "Deal damage to units in a {ETERNALS_BLAST_TARGETER>AREA>Radius}-hex radius."

msgid "DLC@GIANTKINGS@BASE_ABILITY@MAGIC_BLAST@VOLATILE"
msgstr "Volatile Blast"

msgid "DLC@GIANTKINGS@BOON_STEAL@CHANCE_MODIFIER"
msgstr "Base {BOON_STEALING_RESISTANCE_CHECK>ResolvedStrength}% chance of stealing {amount1} {GLOBAL.PositiveStatusEffectConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@CITYDEFINITION_STRATEGIC@CRYSTAL_DWELLING@DESCRIPTION"
msgstr "Crystal Dwellings are a type of {GLOBAL.DwellingConcept.Hyperlink} inhabited by remnants of the Giant Kings in Lithorine forms.[br/][bulletlist][bullet/]Only 1 Crystal Dwelling exists within a realm.[bullet/]The only way to improve {GLOBAL.HouseInfluenceConcept.Hyperlink} with the Dwelling is through Quests.[bullet/]Having a Pact with the Crystal Dwelling will unlock several trading options with them, such as {GLOBAL.TomeConcept.Hyperlink} content, <<m:{GLOBAL.ArtifactConcept.Hyperlink}>>, Lithorine <<m:{GLOBAL.UnitConcept.Hyperlink}>>, and revealing points of interests on the map.[bullet/]Once captured, a Crystal Dwelling is immediately destroyed and awards some of the Dwelling's trade items to the conqueror.[/bulletlist]"

msgid "DLC@GIANTKINGS@CITYDEFINITION_STRATEGIC@CRYSTAL_DWELLING@NAME"
msgstr "Crystal Dwelling"

msgid "DLC@GIANTKINGS@CITYDEFINITION_STRATEGIC@CRYSTAL_DWELLING@TYPE"
msgstr "Crystal Dwellings"

msgid "DLC@GIANTKINGS@CITYDEFINITION_STRATEGIC@LITHORINE_WALLS@NAME"
msgstr "Lithorite Walls"

msgid "DLC@GIANTKINGS@CITYDEFINITION_STRATEGIC@LITHORINE_WALLS@UNLOCK"
msgstr "Lithorite Wall obstacles in combat"

msgid "DLC@GIANTKINGS@CITYDEFINITION_STRATEGIC@LITHORINE_WALLS@UNLOCK_DESCRIPTION"
msgstr "Lithorite Wall obstacles are {GLOBAL.FortifiedConcept.Hyperlink} with a high amount of <<m:{GLOBAL.HitPointConcept.Hyperlink}>> and inflict {GLOBAL.PROPERTIES.VOLATILE_CHARGE.Hyperlink} on Units in a {radius}-hex radius when destroyed."

msgid "DLC@GIANTKINGS@CITYDEFINITION_STRATEGIC@VOLATILE_RUNES@NAME"
msgstr "Volatile Runes"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@ACIDIC_VAPOURS@DESCRIPTION"
msgstr "Every {GLOBAL.TurnConcept.Hyperlink}, a few positions become {GLOBAL.PROPERTIES.POISONOUS.Hyperlink} for {timer} turns. All defending units are immune to the poison effect."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@ACIDIC_VAPOURS@NAME"
msgstr "Acidic Pools"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@ANCIENT_DRACONIC_INSTINCT@DESCRIPTION"
msgstr "All {GLOBAL.PROPERTIES.DRAGON.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> gain {GLOBAL.PROPERTIES.FRENZY.Hyperlink} until the end of combat."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@ANCIENT_DRACONIC_INSTINCT@NAME"
msgstr "Ancient Draconic Frenzy"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@BEHEMOTHS_DREADFUL_PRESENCE@DESCRIPTION"
msgstr "Every {GLOBAL.TurnConcept.Hyperlink}, every unit has a {chance} of suffering {GLOBAL.PROPERTIES.REMORSE.Hyperlink}."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@BEHEMOTHS_DREADFUL_PRESENCE@NAME"
msgstr "Behemoth's Dreadful Presence"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@BERSERK_WYRMS@DESCRIPTION"
msgstr "Lesser serpents become {GLOBAL.PROPERTIES.BERSERK.Hyperlink}."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@BERSERK_WYRMS@NAME"
msgstr "Serpentine Frenzy"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@BINDING_HEX@DESCRIPTION"
msgstr "Several positions in the map contain a Binding Hex. When an Infernal Demon traverses through a Binding Hex, it is {GLOBAL.PROPERTIES.STUNNED.Hyperlink} for {timer} {GLOBAL.TurnConcept.Hyperlink} and the Binding Hex is removed."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@BINDING_HEX@NAME"
msgstr "Binding Hex"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@BLINDED_MOTH@DESCRIPTION"
msgstr "At the start of combat, the Primordial Moth is {GLOBAL.PROPERTIES.BLINDED.Hyperlink} for {value} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@BLINDED_MOTH@NAME"
msgstr "Sensory Overload"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@BRING_IN_DEVASTATORS@DESCRIPTION"
msgstr "At the start of combat, your stack leader brings in {NumberOfSpheres} <<m:{GLOBAL.UNITS.DEVASTATOR_SPHERE_UNIT}>>."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@BRING_IN_DEVASTATORS@NAME"
msgstr "Bring in Devastators"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@CHAINED_BASILISK@DESCRIPTION"
msgstr "The Primordial Basilisk starts the battle {GLOBAL.PROPERTIES.STUNNED.Hyperlink} for {timer} {GLOBAL.TurnConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@CHAINED_BASILISK@NAME"
msgstr "Chained Basilisk"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@CINDER_STORM@DESCRIPTION"
msgstr "Every {value} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, the Primordial Moth flaps its wings, causing one of the attacking units to become {GLOBAL.PROPERTIES.BLINDED.Hyperlink} for {BlindValue} <<m:{GLOBAL.TurnConcept.Hyperlink}>> and {GLOBAL.PROPERTIES.BURNING.Hyperlink} for {BurnValue} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@CINDER_STORM@NAME"
msgstr "Cinder Storm"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@CLAY_REBIRTH@DESCRIPTION"
msgstr "The defending clay soldiers gain {GLOBAL.PROPERTIES.FIERY_REBIRTH.Hyperlink}."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@CLAY_REBIRTH@NAME"
msgstr "Created by primordial flames"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@DELAYED_SURGE@DESCRIPTION"
msgstr "Every {value} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, all attacking units have {chance} chance of suffering Volatile Charge."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@DELAYED_SURGE@NAME"
msgstr "Delayed Volatile Surge"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@DEMORALIZED_DEFENDERS@DESCRIPTION"
msgstr "At the start of combat, all defending units gain {numberOfStacks} stacks of {GLOBAL.PROPERTIES.DEMORALIZED.Hyperlink} until the end of combat."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@DEMORALIZED_DEFENDERS@NAME"
msgstr "Demoralized Defenders"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@DISPERSE_DEFENDERS@DESCRIPTION"
msgstr "At the start of combat, half of the defending Lithorine units become {GLOBAL.PROPERTIES.HASTENED.Hyperlink} for {value} <<m:{GLOBAL.TurnConcept.Hyperlink}>> and half of them become {GLOBAL.PROPERTIES.SLOWED.Hyperlink} for {value} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@DISPERSE_DEFENDERS@NAME"
msgstr "Disperse Defenders"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@ELEMENTAL_ATTUNEMENT@DESCRIPTION"
msgstr "All {GLOBAL.PROPERTIES.ELEMENTAL.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> gain {GLOBAL.PROPERTIES.ELEMENTAL_ATTUNEMENT_UNITPROP.Hyperlink} until the end of combat."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@ELEMENTAL_ATTUNEMENT@NAME"
msgstr "Elemental Attunement"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@ELEMENTAL_ATTUNEMENT@PROPERTY_DESCRIPTION"
msgstr "When a {GLOBAL.SpellConcept.Hyperlink} is cast, this unit's base attack gains +{amount} damage based on the {GLOBAL.AffinityConcept.Hyperlink} of the spell:[bulletlist][bullet/]{GLOBAL.OrderConcept.Hyperlink} - {GLOBAL.SpiritDamageConcept.Hyperlink}[bullet/]{GLOBAL.ChaosConcept.Hyperlink} - {GLOBAL.FireDamageConcept.Hyperlink}[bullet/]{GLOBAL.AstralConcept.Hyperlink} - {GLOBAL.LightningDamageConcept.Hyperlink}[bullet/]{GLOBAL.MateriumConcept.Hyperlink} - {GLOBAL.PhysicalDamageConcept.Hyperlink}[bullet/]{GLOBAL.NatureConcept.Hyperlink} - {GLOBAL.BlightDamageConcept.Hyperlink}[bullet/]{GLOBAL.ShadowConcept.Hyperlink} - {GLOBAL.FrostDamageConcept.Hyperlink}[/bulletlist][br/]Stacks up to {STAR_BLADES_STATUS_DESCRIPTION>MaxStacks} times.[br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@GIANTS_BLESSING@DESCRIPTION"
msgstr "Every {GLOBAL.TurnConcept.Hyperlink}, one of the defending units that hasn't been targeted yet gains the {GLOBAL.PROPERTIES.SUPERGROWTH_PROPERTY_GROUP.Hyperlink} {GLOBAL.RaceTransformationConcept.Hyperlink} and heals to full <<m:{GLOBAL.HitPointConcept.Hyperlink}>>."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@GIANTS_BLESSING@NAME"
msgstr "Giant's Blessing"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@GIANTS_BLESSING_ATTACKERS@DESCRIPTION"
msgstr "Every {GLOBAL.TurnConcept.Hyperlink}, one of the attacking units that hasn't been targeted yet gains the {GLOBAL.PROPERTIES.SUPERGROWTH_PROPERTY_GROUP.Hyperlink} {GLOBAL.RaceTransformationConcept.Hyperlink} and heals to full <<m:{GLOBAL.HitPointConcept.Hyperlink}>>."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@GIANTS_JUDGEMENT@DESCRIPTION"
msgstr "Your Giant Ruler's attacks inflict {GLOBAL.PROPERTIES.REMORSE.Hyperlink} for {NumberOfTurns} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@GIANTS_JUDGEMENT@NAME"
msgstr "Giant's Judgment"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@GIANT_DISTRACTION_TACTICS@DESCRIPTION"
msgstr "{GLOBAL.FlankingConcept.Hyperlink} attacks of the attacking units have {chance} chance of inflicting {GLOBAL.PROPERTIES.DISTRACTED.Hyperlink}."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@GIANT_DISTRACTION_TACTICS@NAME"
msgstr "Giant Distraction Tactics"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@GIANT_SLAYING_LEGEND@DESCRIPTION"
msgstr "The {GLOBAL.PROPERTIES.EXPEDITION_LEADER.Hyperlink} gains the {GLOBAL.SKILLS.HUNTERS_CROSSBOW_SKILL.Hyperlink} property."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@GIANT_SLAYING_LEGEND@NAME"
msgstr "Giant Slaying Legend"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@INFERNAL_FEED@DESCRIPTION"
msgstr "Every time Infernal Invaders spawn a unit, your Expedition Leader gains {StackCount} stacks of {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} for {timer} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@INFERNAL_FEED@NAME"
msgstr "Infernal Feed"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@INFERNAL_INVADERS@DESCRIPTION"
msgstr "Every {timer} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, while the defending Primordial Hound is alive, a defending tier {tiers} Fiend spawns near it. These units last until the end of combat."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@INFERNAL_INVADERS@NAME"
msgstr "Infernal Invaders"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@LITHORITE_DISRUPTION@DESCRIPTION"
msgstr "Half of the defending Lithorine units start the battle {GLOBAL.PROPERTIES.STUNNED.Hyperlink} for {value} {GLOBAL.TurnConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@LITHORITE_DISRUPTION@NAME"
msgstr "Lithorite Disruption"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@LITHORITE_RECOMBINATION@DESCRIPTION"
msgstr "While the Primordial Bloodback is alive, whenever a defending Lithorine Tier 1 - Tier 3 Unit dies, if there is another Lithorine Corpse on the map, resurrect that one as a Lithorine unit that is 1 tier higher than the Lithorine unit that just died."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@LITHORITE_RECOMBINATION@NAME"
msgstr "Stoneshard Recycling"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@PUNY_SLAYING@DESCRIPTION"
msgstr "All defending units gain {GLOBAL.PROPERTIES.PUNY_SLAYER.Hyperlink} until the end of combat."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@PUNY_SLAYING@NAME"
msgstr "Puny Slaying"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@REVERSE_GROWTH@DESCRIPTION"
msgstr "Every {GLOBAL.TurnConcept.Hyperlink}, one of the defending units that hasn't been targeted yet gains the {GLOBAL.PROPERTIES.SPAWNKIN_PROPERTY_GROUP.Hyperlink} {GLOBAL.RaceTransformationConcept.Hyperlink} and has their Maximum {GLOBAL.HitPointConcept.Hyperlink} reduced by {ReducedHealth}."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@REVERSE_GROWTH@NAME"
msgstr "Puny Curse"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@SLOWED_INVADERS@DESCRIPTION"
msgstr "Units spawned by Infernal Invaders suffer {GLOBAL.PROPERTIES.SLOWED.Hyperlink} for {timer} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@SLOWED_INVADERS@NAME"
msgstr "Slowed Invaders"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@STAND_TOGETHER@DESCRIPTION"
msgstr "All attacking units gain {GLOBAL.PROPERTIES.STAND_TOGETHER.Hyperlink} until the end of combat."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@STAND_TOGETHER@NAME"
msgstr "Together We Stand"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@STOKED_FIRE@DESCRIPTION"
msgstr "The defending clay units start combat {GLOBAL.PROPERTIES.BURNING.Hyperlink}."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@STOKED_FIRE@NAME"
msgstr "Stoked Fire"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@STOP_UNDYING@DESCRIPTION"
msgstr "All defending clay soldiers are unable to use their {GLOBAL.PROPERTIES.UNDYING.Hyperlink} and {GLOBAL.PROPERTIES.FIERY_REBIRTH.Hyperlink} ability."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@STOP_UNDYING@NAME"
msgstr "Sealed Resurrection"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@TAUNTED_SENTRIES@DESCRIPTION"
msgstr "Every defending unit is {GLOBAL.PROPERTIES.TAUNTED.Hyperlink} by a random attacking unit until the end of battle."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@TAUNTED_SENTRIES@NAME"
msgstr "Taunted Sentries"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@UNDYING_BATTLEFIELD@DESCRIPTION"
msgstr "Every {GLOBAL.TurnConcept.Hyperlink}, each corpse is resurrected as a random Skeleton unit with {GLOBAL.PROPERTIES.BERSERK.Hyperlink}.[br/][br/]Skeleton units themselves are not resurrected by this effect, are {GLOBAL.PROPERTIES.NON_VITAL.Hyperlink}, and die at the end of combat."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@UNDYING_BATTLEFIELD@NAME"
msgstr "Undying Battlefield"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@VOLATILE_SURGE@DESCRIPTION"
msgstr "Every {value} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, all attacking units have {Chance} chance of suffering {GLOBAL.PROPERTIES.VOLATILE_CHARGE.Hyperlink}."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@VOLATILE_SURGE@NAME"
msgstr "Volatile Surge"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@VOLATILE_WAVE@DESCRIPTION"
msgstr "Every {turn} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, all attacking units have {Chance} chance of suffering {GLOBAL.PROPERTIES.VOLATILE_CHARGE.Hyperlink} unless they already suffer from it. {GLOBAL.PROPERTIES.VOLATILE_CHARGE.Hyperlink} expires in {turn2} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@VOLATILE_WAVE@NAME"
msgstr "Volatile Wave"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@VOLATILE_WAVE@UNLOCK"
msgstr "Volatile Wave during combat"

msgid "DLC@GIANTKINGS@CRISIS@1167_878@DESCRIPTION"
msgstr "The {GLOBAL.EternalSagesLoreConcept.Hyperlink} seek to commune with their kin across the {GLOBAL.AstralSeaLoreConcept.Hyperlink}. They've enlisted someone with the power of a {GLOBAL.GodirLoreConcept.Hyperlink} to function as their Medium."

msgid "DLC@GIANTKINGS@CRISIS@1167_878@DESCRIPTION_ACTIVE"
msgstr "[bulletlist][bullet/]Cities gain +100% {GLOBAL.KnowledgeConcept.Hyperlink} income.[/bulletlist]"

msgid "DLC@GIANTKINGS@CRISIS@1167_878@DESCRIPTION_ACTIVE_MEDIUM"
msgstr "[bulletlist][bullet/]Cities gain +100% {GLOBAL.KnowledgeConcept.Hyperlink} income.[bullet/]As the Medium, you gain additional rewards when any player completes {GLOBAL.ResearchConcept.Hyperlink}:[bulletlist][bullet/]{GLOBAL.OrderConcept.Hyperlink} research yields {GLOBAL.CityStabilityConcept.Hyperlink} in all your Cities.[bullet/]{GLOBAL.ChaosConcept.Hyperlink} research yields {GLOBAL.UnitProductionConcept.Hyperlink} in all your Cities.[bullet/]{GLOBAL.AstralConcept.Hyperlink} research yields {GLOBAL.ManaConcept.Hyperlink}.[bullet/]{GLOBAL.MateriumConcept.Hyperlink} research yields {GLOBAL.GoldConcept.Hyperlink}.[bullet/]{GLOBAL.NatureConcept.Hyperlink} research yields {GLOBAL.FoodConcept.Hyperlink} in all your Cities.[bullet/]{GLOBAL.ShadowConcept.Hyperlink} research yields {GLOBAL.KnowledgeConcept.Hyperlink} in all your Cities.[bullet/]Research without any {GLOBAL.AffinityConcept.Hyperlink} yields you {GLOBAL.ImperiumConcept.Hyperlink}.[bullet/]Dual {GLOBAL.AffinityConcept.Hyperlink} research yields the rewards for both Affinities.[/bulletlist][/bulletlist]"

msgid "DLC@GIANTKINGS@CRISIS@1167_878@NAME"
msgstr "The Cosmic Conclave"

msgid "DLC@GIANTKINGS@CRISIS@1167_878@SUB_HEADER"
msgstr "The {GLOBAL.CrystalDwellingConcept.Hyperlink} initiates the Cosmic Conclave ritual."

msgid "DLC@GIANTKINGS@CRISIS@1167_878@SUB_HEADER_ACTIVE"
msgstr "[bulletlist][bullet/]Global {GLOBAL.KnowledgeConcept.Hyperlink} income increased by +100%.[/bulletlist]"

msgid "DLC@GIANTKINGS@CRISIS@1167_878@SUB_HEADER_ACTIVE_MEDIUM"
msgstr "[bulletlist][bullet/]Global {GLOBAL.KnowledgeConcept.Hyperlink} income increased by +100%.[bullet/] You gain additional bonuses when any player completes {GLOBAL.ResearchConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@CRISIS@1194_1502@DESCRIPTION"
msgstr "The cult of the Sons of the Kjörnoe believe that you, the owner of the Soulcursed Artifacts, can reawaken their beloved Traitor Kings. For that to happen, a dark ritual needs to take place, which requires a powerful sacrifice..."

msgid "DLC@GIANTKINGS@CRISIS@1194_1502@NAME"
msgstr "Return of the Kjörnoe"

msgid "DLC@GIANTKINGS@CRISIS@1194_1502@SUB_HEADER"
msgstr "A strange Cult approaches the Keeper of the Soulcursed Artifacts."

msgid "DLC@GIANTKINGS@CRISIS@991_7303@DESCRIPTION"
msgstr "The Famished Fields are cursed by a ceaseless hunger. Shrouded in malice, the gluttonous {TSR_TRAITOR_KING} has manifested <<r:TSR_TRAITOR_KING>> with three different aspects to challenge and weaken."

msgid "DLC@GIANTKINGS@CRISIS@991_7303@NAME"
msgstr "Famished Fields"

