msgid "TOME_ASTRAL_CONVERGENCE@PASSIVE@NAME"
msgstr "Efficient Spellweaving"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL1@ATTUNEMNT_DESCRIPTION"
msgstr "When a friendly spell is cast, this unit gains a random {GLOBAL.PositiveStatusEffectConcept.Hyperlink}."

msgid "TOME_ASTRAL_CONVERGENCE@SKILL1@ATTUNEMNT_NAME"
msgstr "Attunement: Astral Omen"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL1@DESCRIPTION"
msgstr "Links the target race to the Astral Sea, granting them:[bulletlist][bullet/]The {GLOBAL.PROPERTIES.ETHEREAL.Hyperlink} unit type.[bullet/]{GLOBAL.PROPERTIES.ATTUNEMENT_ASTRAL_OMEN.Hyperlink}, granting a random {GLOBAL.PositiveStatusEffectConcept.Hyperlink} when a spell is cast in combat.[/bulletlist]"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL1@NAME"
msgstr "Astral Attunement"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL1@PROPERTY_DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]The {GLOBAL.PROPERTIES.ETHEREAL.Hyperlink} unit type[bullet/]{GLOBAL.PROPERTIES.ATTUNEMENT_ASTRAL_OMEN.Hyperlink}[/bulletlist]"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL2@DESCRIPTION"
msgstr "Target non-occupied hex:[bulletlist][bullet/]Conjure an {GLOBAL.UNITS.ASTRAL_SERPENT_UNIT.Hyperlink} or {GLOBAL.UNITS.ASTRAL_SIPHONER_UNIT.Hyperlink} unit at random that lasts for {SUMMON_POSITION_EFFECT>TurnsToLive} <<m:{GLOBAL.TurnConcept}>>.[bullet/]All adjacent units sustain {EXPLOSIVE_MANIFESTATION_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}, {EXPLOSIVE_MANIFESTATION_DAMAGE>DAMAGE>Shock} {GLOBAL.LightningDamageConcept.Hyperlink}, and {EXPLOSIVE_MANIFESTATION_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL2@NAME"
msgstr "Explosive Manifestation"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL3@DESCRIPTION"
msgstr "[bulletlist][bullet/]At the start of combat, gain {castingpoints}.[bullet/]During combat, all enemy <<m:{GLOBAL.UnitConcept.Hyperlink}>> suffer {resistancepenalty}.[/bulletlist]"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL3@NAME"
msgstr "Arcane Accumulation"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL3@PROPERTY@DESCRIPTION"
msgstr "Each turn in combat up to {amount} random enemies:[bulletlist][bullet/]Become {GLOBAL.PROPERTIES.ELECTRIFIED.Hyperlink}.[bullet/]Sustain {damage} {GLOBAL.FireDamageConcept.Hyperlink}, {damage} {GLOBAL.LightningDamageConcept.Hyperlink}, or {damage} {GLOBAL.FrostDamageConcept.Hyperlink} .[/bulletlist]"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL4@DESCRIPTION"
msgstr "Target {GLOBAL.ProvinceConcept.Hyperlink}:[bulletlist][bullet/]If it contains an enemy {GLOBAL.ProvinceImprovementConcept.Hyperlink} and no {GLOBAL.AncientWonderConcept.Hyperlink}, it becomes ruins.[bullet/]Spawns a powerful marauding {GLOBAL.ArmyConcept.Hyperlink} of Astral Sea <<m:{GLOBAL.UnitConcept.Hyperlink}>>.[/bulletlist]"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL4@NAME"
msgstr "Astral Shattering"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL5@DESCRIPTION"
msgstr "Whenever you cast a spell in Tactical Combat, add a {GLOBAL.PROPERTIES.CASCADING_POWER_AUTO_SPELL.Hyperlink} to that combat."

msgid "TOME_ASTRAL_CONVERGENCE@SKILL5@NAME"
msgstr "Cascading Power"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL5@PROP_DESCRIPTION"
msgstr "[bulletlist][bullet/]A random enemy unit takes {amount} {GLOBAL.LightningDamageConcept.Hyperlink} at the start of the owner's {GLOBAL.TurnConcept}.[bullet/]For each stack another random enemy unit sustains damage.[/bulletlist]"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL5@PROP_NAME"
msgstr "Stack of Cascading Power"

msgid "TOME_ASTRAL_CONVERGENCE@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Become stronger the more spells you cast and summon creatures from the Astral Sea."

msgid "TOME_ASTRAL_CONVERGENCE@TOME@LORE_AUTHOR"
msgstr "Merlin the Wanderer"

msgid "TOME_ASTRAL_CONVERGENCE@TOME@LORE_DESCRIPTION"
msgstr "\"When you alter the currents of the Astral Sea, the currents alter you as well. True masters of the arcane will become conduits of the magical energy they command, letting it flow through their very being. This energy can be used to infuse their subjects, enhancing them in a number of ways.\""

msgid "TOME_ASTRAL_CONVERGENCE@TOME@NAME"
msgstr "Tome of Astral Convergence"

msgid "TOME_ASTRAL_MIRROR@AUTO_REVERT@DESCRIPTION"
msgstr "This unit is a Mimic.[br/]When this unit's <<m:{GLOBAL.HitPointConcept.Hyperlink}>> drop to 0, it reverts back to its original form and revives with {REVERT_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[br/]This can only happen once per battle."

msgid "TOME_ASTRAL_MIRROR@AUTO_REVERT@NAME"
msgstr "Mimicking"

msgid "TOME_ASTRAL_MIRROR@HERO_SKILL@DESCRIPTION"
msgstr "Reflects {MAGIC_DEFLECTION_DAMAGE_REFLECTION>ResolvedDamageReflected}% of damage sustained back onto attackers."

msgid "TOME_ASTRAL_MIRROR@HERO_SKILL@NAME"
msgstr "Damage Deflection"

msgid "TOME_ASTRAL_MIRROR@MIMIC@ABILITY_DESCRIPTION"
msgstr "Transform into target enemy non-{GLOBAL.HeroConcept.Hyperlink} unit:[bulletlist][bullet/]Status effects are copied.[bullet/]Enchantments are copied.[bullet/]Hit Points are copied if higher than the unit's.[bullet/]Becomes stronger when transforming into lower tier units.[bullet/]Becomes weaker when transforming into higher tier units.[/bulletlist]"

msgid "TOME_ASTRAL_MIRROR@MIMIC@ABILITY_NAME"
msgstr "Mimic"

msgid "TOME_ASTRAL_MIRROR@PASSIVE@DESCRIPTION"
msgstr "All your <<m:{GLOBAL.CityConcept}>> gain half the {GLOBAL.GovernorConcept.Hyperlink} bonus of your {GLOBAL.LeaderConcept}."

msgid "TOME_ASTRAL_MIRROR@PASSIVE@NAME"
msgstr "Split Attention"

msgid "TOME_ASTRAL_MIRROR@REFLECTION_PROPERTY@DESCRIPTION"
msgstr "A copy of another unit:[bulletlist][bullet/]If the original unit dies, this unit replaces it.[bullet/]Cannot summon other units.[/bulletlist]"

msgid "TOME_ASTRAL_MIRROR@REFLECTION_PROPERTY@NAME"
msgstr "Astral Reflection"

msgid "TOME_ASTRAL_MIRROR@SKILL1@DESCRIPTION"
msgstr "Units and Cities you control gain +{amount} Vision Range."

msgid "TOME_ASTRAL_MIRROR@SKILL1@NAME"
msgstr "Astral Revelation"

msgid "TOME_ASTRAL_MIRROR@SKILL2@DESCRIPTION"
msgstr "Summons a {GLOBAL.UNITS.MIRROR_MIMIC_UNIT.Hyperlink}, a {GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink} that can take the form of other units, gaining their abilities and healing themselves."

msgid "TOME_ASTRAL_MIRROR@SKILL2@NAME"
msgstr "Summon Mirror Mimic"

msgid "TOME_ASTRAL_MIRROR@SKILL3@DESCRIPTION"
msgstr "Summons a {GLOBAL.PROPERTIES.REFLECTION.Hyperlink} of target friendly unit onto an unoccupied adjacent hex.[br/][br/]Cannot target <<m:{GLOBAL.PROPERTIES.HERO.Hyperlink}>>, <<m:{GLOBAL.PROPERTIES.COMBAT_SUMMON.Hyperlink}>>, and <<m:{GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink}>>."

msgid "TOME_ASTRAL_MIRROR@SKILL3@NAME"
msgstr "Summon Astral Reflection"

msgid "TOME_ASTRAL_MIRROR@SKILL4@DESCRIPTION"
msgstr "Makes enchanted units:[bulletlist][bullet/]Reflect {MIRROR_VEIL_DAMAGE_REFLECTION>ResolvedDamageReflected}% of non-{GLOBAL.PhysicalDamageConcept.Hyperlink} sustained back onto attackers.[/bulletlist]"

msgid "TOME_ASTRAL_MIRROR@SKILL4@NAME"
msgstr "Mirror Veil"

msgid "TOME_ASTRAL_MIRROR@SKILL4@PROPERTY_DESCRIPTION"
msgstr "This unit:[bulletlist][bullet/]Reflects {MIRROR_VEIL_DAMAGE_REFLECTION>ResolvedDamageReflected}% of non-{GLOBAL.PhysicalDamageConcept.Hyperlink} sustained back at attackers.[/bulletlist]"

msgid "TOME_ASTRAL_MIRROR@SKILL5@DESCRIPTION"
msgstr "[bulletlist][bullet/]When a fight occurs in the city's domain, the player gains a {GLOBAL.PROPERTIES.REFLECTION.Hyperlink} of their {GLOBAL.LeaderConcept.Hyperlink} if they are not present themselves.[bullet/]Your Ruler gains {xp} {GLOBAL.ExperienceConcept.Hyperlink} per {GLOBAL.TurnConcept.Hyperlink} per owned City with this city structure built.[/bulletlist]"

msgid "TOME_ASTRAL_MIRROR@SKILL5@NAME"
msgstr "Throne of Mirrors"

msgid "TOME_ASTRAL_MIRROR@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Create <<m:{GLOBAL.PROPERTIES.REFLECTION.Hyperlink}>> of your units and leader and reflect damage back onto attackers."

msgid "TOME_ASTRAL_MIRROR@TOME@LORE_AUTHOR"
msgstr "Enam'ru Enkhanan, Arcane Matriarch"

msgid "TOME_ASTRAL_MIRROR@TOME@LORE_DESCRIPTION"
msgstr "\"The ability to conjure an exact likeness of one's own body in its present circumstance is a feat in itself. But additionally infusing these likenesses with reflection magic that sends destructive energy back at one's foes... sheer genius, truly!\""

msgid "TOME_ASTRAL_MIRROR@TOME@NAME"
msgstr "Tome of the Astral Mirror"

msgid "TOME_ASTRAL_MIRROR@UNIT@NAME"
msgstr "Mirror Mimic^n"

