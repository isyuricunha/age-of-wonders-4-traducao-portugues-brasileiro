msgstr "Together you can slay the greatest foe."

msgid "DLC@GIANTKINGS@TRIGGER@TOOLTIP@ANCIENTWONDER_GIANT@AFFINITY_CHECK_ORDER@FAILURE"
msgstr "No one knows the tale you speak of."

msgid "DLC@GIANTKINGS@TRIGGER@TOOLTIP@ANCIENTWONDER_GIANT@AFFINITY_CHECK_ORDER@HEADER"
msgstr "Invoke the legend of the boy who slew a giant:"

msgid "DLC@GIANTKINGS@TRIGGER@TOOLTIP@ANCIENTWONDER_GIANT@AFFINITY_CHECK_ORDER@SUCCESS"
msgstr "The legend empowers you!"

