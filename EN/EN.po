msgid "INTERFACE@TEXT@CITY_SUPPORT_STRUCTURE"
msgstr "Support Structure"

msgid "INTERFACE@TEXT@CITY_SUPPORT_STRUCTURE_DESCRIPTION"
msgstr "Support Structures are a type of {GLOBAL.CityDefenseStructureConcept.Hyperlink} which adds <<m:{GLOBAL.CombatEnchantmentConcept.Hyperlink}>> to the {GLOBAL.CombatConcept.Hyperlink} in a {GLOBAL.SiegeConcept.Hyperlink}.[br/][br/]These <<m:{GLOBAL.CombatEnchantmentConcept.Hyperlink}>> add tactical benefits to the Defender in {GLOBAL.CombatConcept.Hyperlink}.[br/][br/]Multiple Support Structures can be built and active in one {GLOBAL.CityConcept.Hyperlink}."

msgid "INTERFACE@TEXT@CITY_SUPPORT_STRUCTURE_HYPERLINK"
msgstr "[hyperlink,GLOBAL.CitySupportStructureConcept]Support Structure[/hyperlink]"

msgid "INTERFACE@TEXT@CITY_TOWER_STRUCTURE"
msgstr "Tower Structure"

msgid "INTERFACE@TEXT@CITY_TOWER_STRUCTURE_DESCRIPTION"
msgstr "Tower Structures are a type of {GLOBAL.CityDefenseStructureConcept.Hyperlink} which spawns Tower units in {GLOBAL.CombatConcept.Hyperlink} during a {GLOBAL.SiegeConcept.Hyperlink}.[br/]Tower units are typically long range units that cannot move and act automatically.[br/][br/]When multiple Tower Structures are built, only the most powerful Tower units will be present in {GLOBAL.CombatConcept.Hyperlink}."

msgid "INTERFACE@TEXT@CITY_TOWER_STRUCTURE_HYPERLINK"
msgstr "[hyperlink,GLOBAL.CityTowerStructureConcept]Tower Structure[/hyperlink]"

