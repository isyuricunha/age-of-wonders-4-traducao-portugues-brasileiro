msgstr "Income from vassals"

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_ACTION_DECLARATION_CALL_TO_FRIENDSHIP_DEFAULT"
msgstr "{HouseBLord.FirstName} calls on you to issue a {GLOBAL.DeclFriendshipConcept.Hyperlink} to [hyperlink,Target]{Target.Lord.FirstName}[/hyperlink] with a view to establishing better relations with them."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_ACTION_DECLARATION_CALL_TO_RIVALRY_DEFAULT"
msgstr "{HouseBLord.FirstName} calls on you to issue a {GLOBAL.DeclRivalryConcept.Hyperlink} to [hyperlink,Target]{Target.Lord.FirstName}[/hyperlink]."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_ACTION_DECLARATION_FRIENDSHIP_DEFAULT"
msgstr "{HouseBLord.FirstName} has issued you with a {GLOBAL.DeclFriendshipConcept.Hyperlink}."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_ACTION_DECLARATION_RIVALRY_DEFAULT"
msgstr "{HouseBLord.FirstName} has issued you with a {GLOBAL.DeclRivalryConcept.Hyperlink}."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_ACTION_DECLAREWAR_DEFAULT"
msgstr "[fireCol]Your Diplomatic State with {HouseBLord.FirstName} has changed to {DiplomaticState.Hyperlink}![/fireCol][br/][hyperlink,GLOBAL.TradeConcept]Negotiate[/hyperlink] a {GLOBAL.TruceConcept.Hyperlink} with them to end the war.[br/]They have cited the following reasons for the declaration of war: {Reasons}"

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_ACTION_DENOUNCE_DEFAULT"
msgstr "{HouseBLord.Name} has denounced you. You will incur a relation penalty from all AI Rulers that know both you and {HouseBLord.Name}."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_ACTION_DENOUNCE_OTHER_DEFAULT"
msgstr "{HouseALord.Name} has denounced {HouseBLord.Name}. This has a damaging effect on the relations of AI Rulers with {HouseBLord.Name}."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_DIPLOMACYEVENT_NEGATIVE"
msgstr "{HouseBLord.Name} insults you based on your recent actions. This worsens your relations by {RelationPenalty}[badRelation/] and you also gain a {GLOBAL.CasusBelliConcept.Hyperlink} ({CBPoints}[casusBelli/]) against {HouseBLord.Name}."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_DIPLOMACYEVENT_NEUTRAL"
msgstr "{HouseBLord.Name} responds to your recent action in a neutral manner."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_DIPLOMACYEVENT_POSITIVE"
msgstr "{HouseBLord.Name} compliments you on your actions and improves your relations by {RelationBonus}[goodRelation/]."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_DIPLOMATICSTATECHANGED_DEFAULT"
msgstr "Your diplomatic state with {HouseBLord.Name} has changed to {DiplomaticState.Hyperlink}."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_DIPLOMATICSTATECHANGED_QUEUED"
msgstr "Your diplomatic state with {HouseBLord.Name} will change to {DiplomaticState.Hyperlink} in 1 {GLOBAL.TurnConcept.Hyperlink}."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_FIRSTMEET_DEFAULT"
msgstr "How do you greet {HouseBLord.TitleName}?"

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_FIRSTMEET_HUMAN"
msgstr "You have met {HouseBLord.TitleName}"

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_FIRSTMEET_INDIFFERENT"
msgstr "{HouseBLord.FirstName} greets you cautiously ([hyperlink,GLOBAL.EmpireRelationConcept]relations[/hyperlink]: [hyperlink,HeroRelation]{RelationValue}[/hyperlink])[br/]{LOC.DIPLOMACY@PLAYERINTERACTION@FOOTER_FIRSTMEET_DEFAULT}"

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_FIRSTMEET_NEGATIVE"
msgstr "{HouseBLord.FirstName} greets you with contempt ([hyperlink,GLOBAL.EmpireRelationConcept]relations[/hyperlink]: [hyperlink,HeroRelation]{RelationValue}[/hyperlink])[br/]{LOC.DIPLOMACY@PLAYERINTERACTION@FOOTER_FIRSTMEET_DEFAULT}"

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_FIRSTMEET_POSITIVE"
msgstr "{HouseBLord.FirstName} greets you cordially ([hyperlink,GLOBAL.EmpireRelationConcept]relations[/hyperlink]: [hyperlink,HeroRelation]{RelationValue}[/hyperlink])[br/]{LOC.DIPLOMACY@PLAYERINTERACTION@FOOTER_FIRSTMEET_DEFAULT}"

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_FIRSTMEET_VOID"
msgstr "{LOC.DIPLOMACY@PLAYERINTERACTION@FOOTER_FIRSTMEET_HUMAN}[br/]While either {GLOBAL.LeaderConcept.Hyperlink} is in the {GLOBAL.AstralVoidLoreConcept.Hyperlink}, interactions are disabled until the Rulers return."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_FORESHADOW_DEGRADE_DEFAULT"
msgstr "{HouseBLord.Name} makes it clear <<p:HouseBLord>> will break the current treaties and pacts you have if you continue on this path."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_FORESHADOW_ENDWAR_DEFAULT"
msgstr "{HouseBLord.Name} might be ready to end your war, negotiate with them to formulate a truce."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_FORESHADOW_IMPROVE_DEFAULT"
msgstr "{HouseBLord.Name} is ready to discuss another treaty or diplomatic state."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_FORESHADOW_WAR_DEFAULT"
msgstr "{HouseBLord.Name} makes it clear they will declare war soon unless you appease them.[br/]They cite the following reasons: {Reasons}"

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_PERSONALITY_DISLIKE"
msgstr "{HouseBLord.Name} has a [hyperlink,Personality]Personal[/hyperlink] dislike for your actions of '{Preference.Name}'. This worsens your relations by {Value}[badRelation/]."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_PERSONALITY_LIKE"
msgstr "{HouseBLord.Name} has a [hyperlink,Personality]Personal[/hyperlink] preference for your actions of '{Preference.Name}'. This improves your relations by {Value}[goodRelation/]."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_RESPONSE_CALLTOWAR_ACCEPTED"
msgstr "{HouseBLord.Name} answers your call to war and joins you in the fight against [hyperlink,Target]{Target.Name}[/hyperlink]."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_RESPONSE_CALLTOWAR_DECLINED"
msgstr "{HouseBLord.Name} has declined to answer your call to war against [hyperlink,Target]{Target.Name}[/hyperlink]."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_RESPONSE_CALLTOWAR_RECEIVED"
msgstr "{HouseBLord.TitleName} will respond to your call to war soon."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_RESPONSE_CALLTOWAR_REPLY_ACCEPTED"
msgstr "You have accepted {HouseBLord.FirstName}'s call to war against [hyperlink,Target]{Target.Name}[/hyperlink]."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_RESPONSE_CALLTOWAR_REPLY_DECLINED"
msgstr "You have declined {HouseBLord.FirstName}'s call to war against [hyperlink,Target]{Target.Name}[/hyperlink]."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_RESPONSE_DECLARATION_FRIENDOFRIVAL_DEFAULT"
msgstr "{HouseBLord.Name} calls you out on your [hyperlink,GLOBAL.DeclFriendshipConcept]Declared Friendship[/hyperlink] with their [hyperlink,GLOBAL.DeclRivalryConcept]Rival[/hyperlink] [hyperlink,Target]{Target.Lord.FirstName}[/hyperlink]. This worsens your relations by {RelationValue}[badRelation/] while the situation lasts."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_RESPONSE_DECLARATION_MUTUALFRIENDSHIP_DEFAULT"
msgstr "{HouseBLord.FirstName} is pleased that you share a common [hyperlink,GLOBAL.DeclFriendshipConcept]Friendship[/hyperlink] with [hyperlink,Target]{Target.Lord.FirstName}[/hyperlink]. This improves your relations by {RelationValue}[goodRelation/] while the situation lasts."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_RESPONSE_DECLARATION_MUTUALRIVALRY_DEFAULT"
msgstr "{HouseBLord.FirstName} is pleased that you share a common [hyperlink,GLOBAL.DeclRivalryConcept]Rivalry[/hyperlink] with [hyperlink,Target]{Target.Lord.FirstName}[/hyperlink]. This improves your relations by {RelationValue}[goodRelation/] while the situation lasts."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_RESPONSE_DECLARATION_PLAYERFRIENDSHIP_DEFAULT"
msgstr "You have issued a {GLOBAL.DeclFriendshipConcept.Hyperlink} to {HouseBLord.FirstName}. In time, this could help improve your relations."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_RESPONSE_DECLARATION_PLAYERRIVALRY_DEFAULT"
msgstr "You have issued a {GLOBAL.DeclRivalryConcept.Hyperlink} to {HouseBLord.FirstName}. In time, this may lead to war!"

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_RESPONSE_DECLARATION_RIVALOFFRIEND_DEFAULT"
msgstr "{HouseBLord.Name} calls you out on your [hyperlink,GLOBAL.DeclRivalryConcept]Declared Rivalry[/hyperlink] with their [hyperlink,GLOBAL.DeclFriendshipConcept]Friend[/hyperlink] [hyperlink,Target]{Target.Lord.FirstName}[/hyperlink]. This worsens your relations by {RelationValue}[badRelation/] while the situation lasts."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_RESPONSE_DENOUNCE_DEFAULT"
msgstr "You denounced {HouseBLord.Name}. This will have a damaging effect on the relations {HouseBLord.Name} has with all AI Rulers that know both you and {HouseBLord.Name}."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_WARCOORDINATION_ACCEPTED_DEFAULT"
msgstr "{HouseBLord.FirstName} has accepted your {GLOBAL.CallToArmsConcept.Hyperlink}, they have {TurnsRemaining} <<m:{GLOBAL.TurnConcept.Hyperlink}>> to complete the bounty."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_WARCOORDINATION_DECLINED_DEFAULT"
msgstr "{HouseBLord.FirstName} has declined your {GLOBAL.CallToArmsConcept.Hyperlink}."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_WARCOORDINATION_FAILED_DEFAULT"
msgstr "{HouseBLord.FirstName} has failed to complete your {GLOBAL.CallToArmsConcept.Hyperlink} that they accepted."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_WARCOORDINATION_SUCCESS_DEFAULT"
msgstr "{HouseBLord.FirstName} has completed your {GLOBAL.CallToArmsConcept.Hyperlink} and received the rewards."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_WARCOORDINATION_UPDATE_PENDING_DEFAULT"
msgstr "{HouseBLord.FirstName} is still considering whether they can complete the {GLOBAL.CallToArmsConcept.Hyperlink} and have not made any actions yet."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_WARCOORDINATION_UPDATE_RUNNING_NEARTARGET_DEFAULT"
msgstr "{HouseBLord.FirstName} is close to the {GLOBAL.CallToArmsConcept.Hyperlink} target and may be able to complete it soon. {LOC.DIPLOMACY@PLAYERINTERACTION@FOOTER_WARCOORDINATION_UPDATE_RUNNING_TIMEESTIMATE}"

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_WARCOORDINATION_UPDATE_RUNNING_NEGATIVE_DEFAULT"
msgstr "{HouseBLord.FirstName} will take longer to reach the {GLOBAL.CallToArmsConcept.Hyperlink} target. {LOC.DIPLOMACY@PLAYERINTERACTION@FOOTER_WARCOORDINATION_UPDATE_RUNNING_TIMEESTIMATE}"

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_WARCOORDINATION_UPDATE_RUNNING_NEUTRAL_DEFAULT"
msgstr "{HouseBLord.FirstName} is still moving their armies to reach the {GLOBAL.CallToArmsConcept.Hyperlink} target but has not made any progress. {LOC.DIPLOMACY@PLAYERINTERACTION@FOOTER_WARCOORDINATION_UPDATE_RUNNING_TIMEESTIMATE}"

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_WARCOORDINATION_UPDATE_RUNNING_PAUSED_DEFAULT"
msgstr "{HouseBLord.FirstName} is no longer focusing on the {GLOBAL.CallToArmsConcept.Hyperlink}; they may make another attempt later."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_WARCOORDINATION_UPDATE_RUNNING_POSITIVE_DEFAULT"
msgstr "{HouseBLord.FirstName} is making progress in reaching the {GLOBAL.CallToArmsConcept.Hyperlink} target. {LOC.DIPLOMACY@PLAYERINTERACTION@FOOTER_WARCOORDINATION_UPDATE_RUNNING_TIMEESTIMATE}"

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_WARCOORDINATION_UPDATE_RUNNING_TIMEESTIMATE"
msgstr "They estimate {TurnsUntilTarget} <<m:{GLOBAL.TurnConcept.Hyperlink}>> to complete the bounty."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_WARCOORDINATION_UPDATE_START_DEFAULT"
msgstr "{HouseBLord.FirstName} has evaluated the {GLOBAL.CallToArmsConcept.Hyperlink} and will make an attempt at completing it."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_WAR_DEFAULT"
msgstr "[fireCol]You are now at {GLOBAL.WarConcept.Hyperlink} with {HouseBLord.Name}.[/fireCol][br/][hyperlink,GLOBAL.TradeConcept]Negotiate[/hyperlink] a {GLOBAL.TruceConcept.Hyperlink} with them to end the war."

msgid "DIPLOMACY@PLAYERINTERACTION@FOOTER_WAR_QUEUED_DEFAULT"
msgstr "[fireCol]You will be at {GLOBAL.WarConcept.Hyperlink} with {HouseBLord.Name} in {QueuedDuration} <<m:{GLOBAL.TurnConcept.Hyperlink}>>.[/fireCol][br/][hyperlink,GLOBAL.TradeConcept]Negotiate[/hyperlink] a {GLOBAL.TruceConcept.Hyperlink} with them to end the war."

msgid "DIPLOMACY@PLAYERINTERACTION@HEADER_DEFEATED"
msgstr "..."

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_CALLTOWAR_RECEIVED_ALLIANCE_AGGRESSIVE"
msgstr "\"Join us in our war, {Player.Lord.FirstName}! Together we shall crush the pathetic {Target.Race}!\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_CALLTOWAR_RECEIVED_ALLIANCE_DEFENSIVE"
msgstr "\"Join us in our war, {Player.Lord.FirstName}! We shall make {Target.Lord.FirstName} regret the day <<p:Target.Lord>> attacked our mighty alliance!\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_CALLTOWAR_RECEIVED_DEFENSIVEPACT"
msgstr "\"We are under attack, {Player.Lord.FirstName}! We hope that you will honor your oath and come to our aid.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_DECLARATION_CALL_TO_FRIENDSHIP_DEFAULT"
msgstr "\"{Target.Lord.Name} has proven themselves a worthy friend to me. A shared friendship between you and {Target.Lord.FirstName} can only make us stronger!\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_DECLARATION_CALL_TO_RIVALRY_DEFAULT"
msgstr "\"My rivalry with {Target.Lord.FirstName} is no secret. Join me and we will prevail over <<P:Target.Lord>> together!\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_DECLARATION_FRIENDSHIP_DEFAULT"
msgstr "\"I consider you my friend, {HouseALord.TitleName}. Together, we shall prosper!\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_DECLARATION_FRIENDSHIP_DEFAULT_ISOLATIONIST"
msgstr "\"I... Actually consider you a friend, {HouseALord.FirstName}. Perhaps {HouseBRace} and {HouseARace} can live together in harmony.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_DECLARATION_RIVALRY_DEFAULT"
msgstr "\"Think of this as an official announcement that I, {HouseBLord.TitleName}, consider you an enemy.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_DECLARATION_RIVALRY_DEFAULT_ISOLATIONIST"
msgstr "\"This realm would be better off without the likes of you, {HouseALord.FirstName}. I'm warning you. Stay away from me and my people.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_DECLARATION_RIVALRY_DEFAULT_SPY"
msgstr "\"We would all be better off without Rulers like you. Stay away from me and do not interfere with my plans.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_DECLAREWAR_DEFAULT"
msgstr "\"You have been a thorn in my side long enough, {HouseALord.TitleName}. Prepare for war!\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_DECLAREWAR_DEFAULT_DIPLOMAT"
msgstr "\"Everyone has their limits, even those who aim for peace. And you have just crossed the line, {HouseALord.TitleName}. Prepare for battle.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_DECLAREWAR_DEFAULT_ISOLATIONIST"
msgstr "\"Congratulations, {HouseALord.TitleName}. You have managed to annoy me enough that I actually have to take action and destroy you myself.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_DECLAREWAR_DEFAULT_WARLORD"
msgstr "\"You will see the true might of {HouseBLord.TitleName} and <<o:HouseBLord>> {HouseBRace.Name}.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_DECLAREWAR_MAGICVICTORY_DEFAULT_1"
msgstr "\"You don't think I will stand idly by while you channel the powers of the Ancient Wonders, {HouseALord.TitleName}. Prepare for war!\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_DECLAREWAR_MAGICVICTORY_DEFAULT_2"
msgstr "\"You are not worthy of channeling the powers of the Ancient Wonders, {HouseALord.TitleName}. You must be stopped!\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_DENOUNCE_DEFAULT"
msgstr "\"You have crossed me, {HouseALord.TitleName}! I advise you to stop this treachery, or there will be consequences.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_DENOUNCE_OTHER_DEFAULT"
msgstr "\"Let it be known that {TargetLord.Name} has crossed me. <<Cp:TargetLord>> is not to be trusted!\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_DIPLOMATICSTATECHANGE_DECREASED_DEFAULT"
msgstr "\"I am saddened to announce our coalition is breaking up. It seems like a bond between us was not as beneficial as I thought.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_DIPLOMATICSTATECHANGE_DECREASED_DEFAULT_WARLORD"
msgstr "\"I no longer see the value in collaborating with you. I shall continue my conquest alone.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_DIPLOMATICSTATECHANGE_INCREASED_DEFAULT"
msgstr "\"I am glad to announce our bonds have strengthened, {HouseALord.TitleName}. Let us work toward a brighter age for both of us.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ACTION_DIPLOMATICSTATECHANGE_INCREASED_DEFAULT_DIPLOMAT"
msgstr "\"I am glad that you, too, see the value in treaties and diplomacy. Together we shall forge a brighter age for our people.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_DEFAULT"
msgstr "\"Greetings {HouseALord.TitleName}, what is it that you want to discuss?\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_DEFAULT_DIPLOMAT"
msgstr "\"Hail, {HouseALord.TitleName}. What matters of diplomacy shall we discuss today?\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_DEFAULT_ISOLATIONIST"
msgstr "\"{HouseALord.TitleName}. I am very busy, what do you need?\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_DEFAULT_MERCHANT"
msgstr "\"Greetings, {HouseALord.TitleName}! What matters shall we discuss?\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_DEFAULT_SAGE"
msgstr "\"Fate brings us together once more. What questions burden you, {HouseALord.Name}?\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_DEFAULT_SPY"
msgstr "\"Greetings, {HouseALord.TitleName}. How fare your grand plans?\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_DEFAULT_WARLORD"
msgstr "\"Strength, {HouseALord.TitleName}. What brings you to my war room?\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_ENDWAR"
msgstr "\"Welcome, {HouseALord.TitleName}. This war has been very costly for us both. I hope that you are here so we may discuss its end.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_DEFAULT"
msgstr "\"Allow me to introduce myself. I am {HouseBLord.TitleName} of the {HouseBRace}. Let us hope this realm is big enough for all of us.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_DEFAULT_DIPLOMAT"
msgstr "\"Hail, {HouseALord.TitleName}. Allow me to introduce myself. I am {HouseBLord.TitleName}. Many Godir make war, I aim to make peace.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_DEFAULT_DRAGON_TO_GIANT"
msgstr "\"Yet another Giant King rises to destroy our marvels. Have you come to seek redemption, or will you thrash in futility as the fools of Myrrida once did?\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_DEFAULT_GIANT_TO_DRAGON"
msgstr "\"A Dragon crosses my path. Stay your forked tongue in my presence, lest you suffer my primal might.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_DEFAULT_ISOLATIONIST"
msgstr "\"Another Ruler in this realm. How many more can this realm take? Let us just agree to stay out of each other's way, hm?\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_DEFAULT_SAGE"
msgstr "\"Greetings, {HouseALord.TitleName}. May wisdom guide your path in this realm.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_DEFAULT_SPY"
msgstr "\"A new contender for power in this realm appears before me. Tell me, {HouseALord.TitleName}, are you a master, or a pawn?\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_DEFAULT_VOID"
msgstr "\"It seems we meet under special circumstances, {HouseALord.TitleName}. Perhaps we'll discuss our relations at a later time.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_DEFAULT_WARLORD"
msgstr "\"Well met, {HouseALord.TitleName}. I am {HouseBLord.TitleName}. Prove your strength to me, and we may yet conquer this realm together.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_NEGATIVE"
msgstr "\"So you are the notorious {HouseALord.Name}. I suggest you keep your distance from my lands, otherwise life here may become very unpleasant for you.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_NEGATIVE_DIPLOMAT"
msgstr "\"So you are the inconsiderate {HouseALord.TitleName}. I am {HouseBLord.TitleName}. Many Godir make war, I aim to make peace. Even with the likes of you.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_NEGATIVE_DRAGON_TO_GIANT"
msgstr "\"Yet another Giant rises to destroy our marvels. Bow before your betters and plead for redemption, lest I reduce you to dust.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_NEGATIVE_GIANT_TO_DRAGON"
msgstr "\"So this realm is infested with Dragons. It falls to us Giants to put your forgotten breed in your place.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_NEGATIVE_ISOLATIONIST"
msgstr "\"Another ruler comes to threaten my empire. Just stay out of my way, and I will stay out of yours.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_NEGATIVE_SAGE"
msgstr "\"Sometimes fate puts adversaries in our way to test our resolve. I hope for all our sakes that you are no such adversary.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_NEGATIVE_SPY"
msgstr "\"A new pawn appears before me. You look like a Godir, but are you ready to face the likes of me?\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_NEGATIVE_WARLORD"
msgstr "\"So you are {HouseALord.TitleName} of the {HouseARace.Name}. I am not impressed. Tread carefully, before I decide that your realm is actually worth conquering.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_POSITIVE"
msgstr "\"I have heard great things about you, {HouseALord.TitleName}. I look forward to seeing your progress here.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_POSITIVE_DIPLOMAT"
msgstr "\"Hail, {HouseALord.TitleName}! It seems we share kinship. My name is {HouseBLord.Name}. Too many Godir wage war on the realms. I find it more rewarding to make peace. Don't you agree?\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_POSITIVE_DRAGON_TO_GIANT"
msgstr "\"I rarely meet a reasonable Giant. Will you be the first one that earns my trust?\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_POSITIVE_GIANT_TO_DRAGON"
msgstr "\"I rarely meet a reasonable Dragon. Prove and redeem yourself to me before you gain my trust.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_POSITIVE_ISOLATIONIST"
msgstr "\"Of the many strangers on this realm, you seem to be the most reasonable. However, I do not engage in the petty squabbles of the other Godir. Let us simply live and let live.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_POSITIVE_MERCHANT"
msgstr "\"I have heard great things about you, {HouseALord.TitleName}. I look forward to seeing your progress here alongside mine.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_POSITIVE_SAGE"
msgstr "\"It is a blessed day when a {HouseBLord.Title} meets a {HouseALord.Title} like you. Welcome, {HouseALord.Name}. Let us rule this realm with wisdom.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_POSITIVE_SPY"
msgstr "\"So a new Ruler has appeared in this realm of schemes and conquest. Welcome, {HouseALord.FirstName}. Let us hope we can manipulate this realm together.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_POSITIVE_WARLORD"
msgstr "\"I rarely meet a powerful Ruler like myself who knows that true power lies in strength. Prove your strength to me, and we may yet conquer this realm together.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FIRSTMEET_SECTORCLAIM"
msgstr "\"So you are the one who just took away that promising province... Let us hope it does not happen again.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FORESHADOW_DEGRADE_DEFAULT"
msgstr "\"I feel like our empires are drifting apart, {HouseALord.TitleName}. Perhaps our alliance was a mistake...\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FORESHADOW_DEGRADE_DEFAULT_ISOLATIONIST"
msgstr "\"Your schemes and squabbles are starting to annoy me, {HouseALord.TitleName}. Perhaps I am better off without you.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FORESHADOW_DEGRADE_DEFAULT_SAGE"
msgstr "\"Your actions give me pause, {HouseALord.FirstName}. Perhaps my trust in you was misplaced.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FORESHADOW_DEGRADE_DEFAULT_SPY"
msgstr "\"Your actions are interfering with my plans, {HouseALord.TitleName}. Tread carefully, before I decide to end your rulership.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FORESHADOW_DEGRADE_DEFAULT_WARLORD"
msgstr "\"Your strategies are beginning to anger me, {HouseALord.TitleName}. Tread carefully, lest you find yourself at the receiving end of my wrath.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FORESHADOW_ENDWAR_DEFAULT"
msgstr "\"This war of ours is tiresome, {HouseALord.FirstName}. Sometimes I wonder if it would be better to end it.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FORESHADOW_IMPROVE_DEFAULT"
msgstr "\"I was thinking of you, {HouseALord.Name}. We have much in common. Perhaps we can bring our empires closer together.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FORESHADOW_IMPROVE_DEFAULT_DIPLOMAT"
msgstr "\"I have been pondering the many allies and enemies I have in this realm. I am glad that you seem to be one of the former. Let us try to bring our empires closer.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FORESHADOW_IMPROVE_DEFAULT_ISOLATIONIST"
msgstr "\"I must say, you may actually be worth my attention, {HouseALord.FirstName}. Perhaps our empires may actually be able to coexist.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FORESHADOW_IMPROVE_DEFAULT_MERCHANT"
msgstr "\"I was just thinking about you, {HouseALord.FirstName}. How fare our treaties and trade deals? Perhaps we can improve them.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FORESHADOW_IMPROVE_DEFAULT_SAGE"
msgstr "\"Your actions speak for your wisdom, {HouseALord.FirstName}. I am glad to see our fates entwining.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FORESHADOW_IMPROVE_DEFAULT_SPY"
msgstr "\"I usually consider others to be pawns, to be used as I see fit. But you, {HouseALord.TitleName}, may well be more than that.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_FORESHADOW_WAR_DEFAULT"
msgstr "\"You're angering me, {HouseALord.Name}. I'm warning you, if you keep going like this, I will see an end to your reign right here.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_MAINTAINWAR"
msgstr "\"Let us waste no time with words, {HouseALord.FirstName}. Only on the field of battle will our differences be settled.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_NEGATIVE"
msgstr "\"What do you want? Be quick, I have an empire to lead.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_NEGATIVE_DIPLOMAT"
msgstr "\"The crude {HouseALord.Title} speaks to me once more. As always, I will do my best to be courteous.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_NEGATIVE_ISOLATIONIST"
msgstr "\"What do you want? I have more important things to do than to listen to you.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_NEGATIVE_MERCHANT"
msgstr "\"{HouseALord.TitleName}. I am incredibly busy dealing with more important matters than you. What do you want?\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_NEGATIVE_SAGE"
msgstr "\"Some conversations only happen to test our patience. This seems to be one such conversation.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_NEGATIVE_SPY"
msgstr "\"{HouseALord.TitleName}. I would ask how you fare, but, honestly, I do not care about your well-being.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_NEGATIVE_WARLORD"
msgstr "\"I warn you not to disturb me too much, lest our next meeting take place on the battlefield.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_PERSONALITY_DISLIKE"
msgstr "\"Some would consider your course of action deeply unwise, {HouseALord.FirstName}. Especially if you want to avoid vexing me!\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_PERSONALITY_LIKE"
msgstr "\"We may be not so different after all, {HouseALord.FirstName}. Your actions are promising. By all means, continue!\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_POSITIVE"
msgstr "\"It is always a pleasure to speak with you, {HouseALord.FirstName}. What do you want to discuss?\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_POSITIVE_DIPLOMAT"
msgstr "\"Hail, {HouseALord.TitleName}! It is a pleasure to speak with you. Please, tell me what you need.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_POSITIVE_ISOLATIONIST"
msgstr "\"Greetings, {HouseALord.TitleName}. Of all the squabbling Rulers in this realm, you seem to be somewhat reasonable. What brings you to my empire?\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_POSITIVE_MERCHANT"
msgstr "\"Greetings, {HouseALord.TitleName}! Are you here to trade, or merely to gaze upon my grand empire?\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_POSITIVE_SAGE"
msgstr "\"The tides of fate favor me, bringing you here. What can I do for you, {HouseALord.FirstName}?\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_POSITIVE_SPY"
msgstr "\"Greetings, {HouseALord.TitleName}. May all your plans come to fruition!\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_POSITIVE_WARLORD"
msgstr "\"Strength, {HouseALord.TitleName}! May the fields be flooded with the blood of your enemies.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_CALLTOWAR_ACCEPTED"
msgstr "\"Me and my {HouseBRace.Name} will join you in your war against {Target.Name}!\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_CALLTOWAR_DECLINED"
msgstr "\"I cannot join you in your war, {HouseALord.TitleName}.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_CALLTOWAR_RECEIVED"
msgstr "\"The rules of honor allow me some time before responding to your call to war. Let me think about it.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_CALLTOWAR_REPLY_ACCEPTED"
msgstr "\"Welcome to the war, {HouseALord.FirstName}! {Target.Name} has no chance against us both!\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_CALLTOWAR_REPLY_DECLINED"
msgstr "\"So this is how you honor your oaths, {HouseALord.FirstName}? It seems that it is time for us to re-evaluate our relationship.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_DECLARATION_FRIENDOFRIVAL_DEFAULT"
msgstr "\"You dare break bread with {Target.Lord.TitleName}?!\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_DECLARATION_MUTUALFRIENDSHIP_DEFAULT"
msgstr "\"I am pleased to see we share a friend in {Target.Lord.Name}. Together, we shall prevail!\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_DECLARATION_MUTUALRIVALRY_DEFAULT"
msgstr "\"I am pleased that you have seen the true colors of my rival {Target.Lord.FirstName}. <<Cp:Target.Lord>> deserves nothing more.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_DECLARATION_PLAYERFRIENDSHIP_BROKEN_DEFAULT"
msgstr "\"I am disappointed to learn you are not willing to commit to your promise of friendship, {HouseALord.FirstName}.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_DECLARATION_PLAYERFRIENDSHIP_DEFAULT"
msgstr "\"I am pleased to know you consider me your friend, {HouseALord.TitleName}. I will remember this.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_DECLARATION_PLAYERFRIENDSHIP_NEGATIVE"
msgstr "\"So you seek friendship with the {HouseBRace}? We shall see, perhaps you will prove worthy.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_DECLARATION_PLAYERRIVALRY_BROKEN_DEFAULT"
msgstr "\"I hear you are finally willing to end your dispute with me. Very promising. Perhaps we may still forge good relations after all.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_DECLARATION_PLAYERRIVALRY_DEFAULT"
msgstr "\"You would declare me your rival? Very well, let us see who laughs last!\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_DECLARATION_PLAYERRIVALRY_POSITIVE"
msgstr "\"This is a great shame, {HouseALord.Name}, we had such high hopes for the future.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_DECLARATION_RIVALOFFRIEND_DEFAULT"
msgstr "\"I consider {Target.Lord.TitleName} to be my friend. It disappoints me that you would make an enemy out of <<P:Target.Lord>>.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_DECLAREWAR_DEFAULT"
msgstr "\"Very well, {HouseALord.Name}...\" <<p:HouseBLord>> says through gritted teeth. \"If it is a war you want, a war you will get. Call the banners!\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_DENOUNCE_DEFAULT"
msgstr "\"I recognize my transgression, {HouseALord.TitleName}. I hope there is no bad blood between us.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_DIPLOMATICSTATECHANGE_DECREASED_DEFAULT"
msgstr "\"I am saddened to see our coalition fall apart. Perhaps a bond between us is not as beneficial as I thought.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_DIPLOMATICSTATECHANGE_INCREASED_DEFAULT"
msgstr "\"I am glad to see the bonds we have forged are stronger, {HouseALord.TitleName}. Let us work toward a brighter age for both of us.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_NEGATIVEFIRSTMEET_NEGATIVE"
msgstr "\"Perhaps insults were to be expected from a '{HouseALord.Title}' such as you. Make no mistake, you will pay for addressing me like this.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_NEGATIVEFIRSTMEET_POSITIVE"
msgstr "\"I am disappointed by your hostility, {HouseALord.FirstName}. Perhaps my positive assumptions about you were misplaced.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_POSITIVEFIRSTMEET_NEGATIVE"
msgstr "\"You think a feeble attempt at flattery will convince me of your goodwill? You will need more than that, \"{HouseALord.Title}\".\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_RESPONSE_POSITIVEFIRSTMEET_POSITIVE"
msgstr "\"I accept this gesture of goodwill, {HouseALord.Name}. Thank you.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_WARCOORDINATION_ACCEPTED_DEFAULT"
msgstr "\"I cannot promise you anything, {HouseALord.Name}, but I accept your bounty.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_WARCOORDINATION_DECLINED_DEFAULT"
msgstr "\"Unfortunately, I cannot help you with this bounty, {HouseALord.TitleName}. Perhaps later.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_WARCOORDINATION_FAILED_DEFAULT"
msgstr "\"I am sorry, {HouseALord.TitleName}, I cannot complete this bounty.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_WARCOORDINATION_SUCCESS_DEFAULT"
msgstr "\"I did as you asked, {HouseALord.TitleName}, the bounty has been fulfilled.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_WARCOORDINATION_UPDATE_PENDING_DEFAULT"
msgstr "\"I am considering my tactics, {HouseALord.TitleName}, I am not sure yet if I can complete the bounty.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_WARCOORDINATION_UPDATE_RUNNING_NEARTARGET_DEFAULT"
msgstr "\"My army is near the target, {HouseALord.TitleName}. I may be able to complete the bounty.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_WARCOORDINATION_UPDATE_RUNNING_NEGATIVE_DEFAULT"
msgstr "\"Reaching the target may take longer than anticipated, {HouseALord.TitleName}.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_WARCOORDINATION_UPDATE_RUNNING_NEUTRAL_DEFAULT"
msgstr "\"No news yet on the bounty! I'll keep you informed, {HouseALord.TitleName}.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_WARCOORDINATION_UPDATE_RUNNING_PAUSED_DEFAULT"
msgstr "\"Unfortunately, my priorities have shifted, {HouseALord.TitleName}. I may be able to resume progress on achieving the bounty later.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_WARCOORDINATION_UPDATE_RUNNING_POSITIVE_DEFAULT"
msgstr "\"My army is getting closer to the target, I hope to reach it soon.\""

msgid "DIPLOMACY@PLAYERINTERACTION@OPINION_WARCOORDINATION_UPDATE_START_DEFAULT"
msgstr "\"My army has just left on a mission towards the target, {HouseALord.TitleName}. I will keep you informed on their progress.\""

msgid "DIPLOMACY@PLAYERINTERACTION@REASON_GENERIC"
msgstr "{HouseALord.Name} is a threat to me."

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_ACCEPTED"
msgstr "\"Thank you, {HouseALord.Name}, it's a deal.\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_DECLINED"
msgstr "\"Apologies, {HouseALord.Name}. This trade will not work.\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_DEFAULT"
msgstr "\"A trade, {HouseALord.FirstName}? Very well. What do you propose?\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_DEFAULT_NEGATIVE"
msgstr "\"I warn you to not waste my time, {HouseALord.FirstName}. What do you offer?\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_DEFAULT_POSITIVE"
msgstr "\"It will be a pleasure to practice the fine art of trading with you, {HouseALord.Name}.\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_FAIR_DEFAULT"
msgstr "\"This exchange seems fair to me. Agreed?\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_NODEAL_DEFAULT"
msgstr "\"Apologies, {HouseALord.Name}. This trade will not work.\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_NODEAL_DEMAND_RESOURCE_DEFAULT"
msgstr "\"I currently do not want to part with this particular resource. Perhaps I will reconsider when you have something more interesting to offer.\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_NODEAL_GIFT_RESOURCE_DEFAULT"
msgstr "\"This resource is of no interest to me at the moment.\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_OFFER_DEFAULT"
msgstr "\"Greetings {HouseALord.TitleName}. I would like to propose a trade, what do you think?\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_OFFER_ENDWAR_DEFAULT"
msgstr "\"This war has been going on long enough; let us put an end to it.\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_OFFER_ENDWAR_LOSING"
msgstr "\"I know when I am outmatched, please let us end this senseless war.\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_OFFER_ENDWAR_LOSING_VASSALAGE"
msgstr "\"You have won this war {HouseALord.Name}. I am defeated but I can still be of use. Do not cast me into the void, allow me to serve you instead!\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_OFFER_ENDWAR_WINNING_VASSALAGE"
msgstr "\"You have lost this war {HouseALord.Name}, but I do not wish to cast you into the void. Take the knee, and join me in glory!\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_OFFER_FAIR_DEFAULT"
msgstr "\"{HouseALord.Name}, would you be interested in a trade? This seems like a fair proposition to me.\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_OFFER_REQUEST_DEFAULT"
msgstr "\"{HouseALord.Name}, would you be interested in a trade? In return I can offer you the following.\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_OFFER_SELL_DEFAULT"
msgstr "\"Greetings, {HouseALord.Name}. My empire has something to offer, are you interested?\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_PROPOSAL_DEMAND_DEFAULT"
msgstr "\"Your request is reasonable, but I require something in return. Perhaps one of the following.\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_PROPOSAL_DEMAND_RESOURCE_DEFAULT"
msgstr "\"I may be willing to provide some of my resources, but I require something from you as well, {HouseALord.FirstName}.\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_PROPOSAL_GIFT_DEFAULT"
msgstr "\"An interesting proposal, {HouseALord.Name}, I can offer you the following in return.\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_PROPOSAL_GIFT_RESOURCE_DEFAULT"
msgstr "\"Interesting, I suppose I could use this resource, {HouseALord.TitleName}. I would be willing to part with the following.\""

msgid "DIPLOMACY@PLAYERINTERACTION@TRADE_PROPOSAL_OFFERGIFT_DEFAULT"
msgstr "\"You would offer me a gift? I appreciate that, {HouseALord.TitleName}. I prefer one of the following.\""

msgid "DIPLOMACY@PLAYEROPINION@GRUDGE"
msgstr "Grudge due to <<m:{GLOBAL.CasusBelliConcept.Hyperlink}>>"

msgid "DIPLOMACY@PLAYEROPINION@GRUDGE_REMAIN"
msgstr "Grudge due to expired <<m:{GLOBAL.CasusBelliConcept.Hyperlink}>>"

msgid "DIPLOMACY@PRESSURE@DESCRIPTION"
msgstr "The threat level represents how threatened other <<m:{GLOBAL.LeaderConcept.Hyperlink}>> feel.[br/][br/]This level is influenced by many factors that look at how well each Ruler is doing: for example if they have large <<m:{GLOBAL.ArmyConcept.Hyperlink}>>, many <<m:{GLOBAL.CityConcept.Hyperlink}>>, or are supported by many [hyperlink,GLOBAL.DSAllianceConcept]allies[/hyperlink].[br/][br/]The threat level is expressed as a [hyperlink,GLOBAL.EmpireRelationConcept]relations[/hyperlink] modifier."

msgid "DIPLOMACY@PRESSURE@FACTORS"
msgstr "We've found out the following contributing factors."

msgid "DIPLOMACY@PRESSURE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.AIPressureConcept]Threat Level[/hyperlink]"

msgid "DIPLOMACY@PRESSURE@LEVEL_-1"
msgstr "Uneasy"

msgid "DIPLOMACY@PRESSURE@LEVEL_-1_DESCRIPTION"
msgstr "The {GLOBAL.LeaderConcept.Hyperlink} feels threatened by your {GLOBAL.EmpireConcept.Hyperlink}, which affects your [hyperlink,GLOBAL.EmpireRelationConcept]relations[/hyperlink] with them by {RelationValue}[badRelation/] and also makes trading with them more costly."

msgid "DIPLOMACY@PRESSURE@LEVEL_-2"
msgstr "Vigilant"

msgid "DIPLOMACY@PRESSURE@LEVEL_-3"
msgstr "Wary"

msgid "DIPLOMACY@PRESSURE@LEVEL_-4"
msgstr "Threatened"

msgid "DIPLOMACY@PRESSURE@LEVEL_0"
msgstr "Indifferent"

msgid "DIPLOMACY@PRESSURE@LEVEL_0_DESCRIPTION"
msgstr "The {GLOBAL.LeaderConcept.Hyperlink} feels indifferent about your {GLOBAL.EmpireConcept.Hyperlink} which may still change over time."

msgid "DIPLOMACY@PRESSURE@LEVEL_1"
msgstr "At ease"

msgid "DIPLOMACY@PRESSURE@LEVEL_1_DESCRIPTION"
msgstr "The {GLOBAL.LeaderConcept.Hyperlink} feels confident toward your {GLOBAL.EmpireConcept.Hyperlink}, which affects your [hyperlink,GLOBAL.EmpireRelationConcept]Relations[/hyperlink] with them by {RelationValue}[goodRelation/]."

msgid "DIPLOMACY@PRESSURE@LEVEL_2"
msgstr "Confident"

msgid "DIPLOMACY@PRESSURE@LEVEL_3"
msgstr "Trusting"

msgid "DIPLOMACY@PRESSURE@TITLE"
msgstr "Threat Level"

msgid "DIPLOMACY@PRONOUNCEMENTS@ACTIVEINFO"
msgstr "Active pronouncement actions that target this Ruler are still running. Their effects are applied once the actions finish."

msgid "DIPLOMACY@PRONOUNCEMENTS@DESCRIPTION"
msgstr "A statement or declaration that <<m:{GLOBAL.LeaderConcept.Hyperlink}>> can make towards other Rulers to enhance their [hyperlink,GLOBAL.EmpireRelationConcept]Relations[/hyperlink]. Includes [hyperlink,GLOBAL.FabricatedCasusBelliConcept]fabricating[/hyperlink] <<m:{GLOBAL.CasusBelliConcept.Hyperlink}>>, making declarations, [hyperlink,GLOBAL.CallToWarConcept]Calling Rulers to War[/hyperlink] and more."

msgid "DIPLOMACY@PRONOUNCEMENTS@HYPERLINK"
msgstr "[hyperlink,GLOBAL.PronouncementsConcept]Pronouncement[/hyperlink]"

msgid "DIPLOMACY@PRONOUNCEMENTS@TITLE"
msgstr "Pronouncements"

msgid "DIPLOMACY@PRONOUNCEMENTS@TOOLTIP"
msgstr "Opens the pronouncement sub-options. These enable you to make statements or declarations which will affect your relationship with the opposing Ruler."

msgid "DIPLOMACY@PVE_NEGOTIATION_PHASE@DESCRIPTION"
msgstr "During the negotiation phase, all <<m:{GLOBAL.EmpireConcept.Hyperlink}>> may [hyperlink,GLOBAL.NegotiationConcept]negotiate[/hyperlink] with a {GLOBAL.IndependentCityConcept.Hyperlink} for higher {GLOBAL.HouseInfluenceConcept.Hyperlink} and better diplomatic states. Once an {GLOBAL.EmpireConcept.Hyperlink} has secured enough {GLOBAL.HouseInfluenceConcept.Hyperlink} for a {GLOBAL.PactOfVassalageConcept.Hyperlink}, this [hyperlink,GLOBAL.CompetitorConcept]competition[/hyperlink] ends and the \\\"winning\\\" {GLOBAL.EmpireConcept.Hyperlink} enters the {GLOBAL.VassalagePhaseConcept.Hyperlink}.[br/][br/]These are the <<m:{GLOBAL.PvEDiplStateConcept.Hyperlink}>> of the Negotiation Phase:[bulletlist][bullet/]{GLOBAL.IndependentCityWarConcept.Hyperlink}[bullet/]{GLOBAL.IndependentCityNeutralConcept.Hyperlink}[bullet/]{GLOBAL.PactOfCooperationConcept.Hyperlink}[bullet/]{GLOBAL.PactOfLoyaltyConcept.Hyperlink}[bullet/]{GLOBAL.PactOfVassalageConcept.Hyperlink}[/bulletlist]"

msgid "DIPLOMACY@PVE_NEGOTIATION_PHASE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.NegotiationPhaseConcept]Negotiation Phase[/hyperlink]"

msgid "DIPLOMACY@PVE_NEGOTIATION_PHASE@TITLE"
msgstr "Negotiation Phase of Free Cities"

msgid "DIPLOMACY@PVE_VASSALAGE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.PvEVassalConcept]Vassal[/hyperlink]"

msgid "DIPLOMACY@PVE_VASSALAGE@TITLE"
msgstr "City Vassalage"

msgid "DIPLOMACY@PVE_VASSALAGE_PHASE@DESCRIPTION"
msgstr "During the vassalage phase, only the overlord {GLOBAL.EmpireConcept.Hyperlink} may [hyperlink,GLOBAL.NegotiationConcept]negotiate[/hyperlink] with a {GLOBAL.IndependentCityConcept.Hyperlink}. Other <<m:{GLOBAL.EmpireConcept.Hyperlink}>> can only declare {GLOBAL.IndependentCityWarConcept.Hyperlink} on the {GLOBAL.IndependentCityConcept.Hyperlink} by declaring war on the Free City overlord.[br/][br/]These are the <<m:{GLOBAL.PvEDiplStateConcept.Hyperlink}>> of the Vassalage Phase:[bulletlist][bullet/]{GLOBAL.PactOfVassalageLvl-3Concept.Hyperlink}[bullet/]{GLOBAL.PactOfVassalageLvl-2Concept.Hyperlink}[bullet/]{GLOBAL.PactOfVassalageLvl-1Concept.Hyperlink}[bullet/]{GLOBAL.PactOfVassalageLvl0Concept.Hyperlink}[bullet/]{GLOBAL.PactOfVassalageLvl1Concept.Hyperlink}[bullet/]{GLOBAL.PactOfVassalageLvl2Concept.Hyperlink}[bullet/]{GLOBAL.PactOfVassalageLvl3Concept.Hyperlink}[/bulletlist][br/][br/]Once {GLOBAL.PactOfVassalageLvl2Concept.Hyperlink} is reached, the {GLOBAL.PactOfIntegrationConcept.Hyperlink} becomes available, allowing an {GLOBAL.EmpireConcept.Hyperlink} to fully absorb the {GLOBAL.IndependentCityConcept.Hyperlink}."

msgid "DIPLOMACY@PVE_VASSALAGE_PHASE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.VassalagePhaseConcept]Vassalage Phase[/hyperlink]"

msgid "DIPLOMACY@PVE_VASSALAGE_PHASE@TITLE"
msgstr "Vassalage Phase of Free Cities"

msgid "DIPLOMACY@PVE_VASSLAGE@DESCRIPTION"
msgstr "Free Cities can be vassalized by Rulers through [hyperlink,GLOBAL.NegotiationConcept]Negotiations[/hyperlink] or by converting an owned or conquered {GLOBAL.CityConcept.Hyperlink} into a vassal city.[br/][br/]Vassal cities have many advantages:[bulletlist][bullet/]They will share their income and magic materials.[bullet/]They will aid you in wars.[bullet/]They will grant you vision of their domain.[/bulletlist][br/]Vassal cities may eventually also be [hyperlink,GLOBAL.PactOfIntegrationConcept]integrated[/hyperlink] into the Ruler's empire."

