msgid "CULTURE_FEUDAL@SUBCULTURE@ARISTOCRACY@BANNERLORD@DESCRIPTION"
msgstr "This hero is the Liege Lord of their House, granting them and House units in their army:[bulletlist][bullet/]-{LIEGE_LORD_STACK_UPKEEP_MODIFIER>ResolvedUpkeepModifier}% base {GLOBAL.UnitUpkeepConcept.Hyperlink}.[bullet/]Regenerate an additional +{LIEGE_LORD_STACK_PROPERTY_STAT_BONUS>BONUS>Regen} <<m:{GLOBAL.HitPointConcept.Hyperlink}>> per {GLOBAL.WorldMapConcept.Name} {GLOBAL.TurnConcept.Hyperlink}.[bullet/]+{LIEGE_LORD_STAT_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[bullet/]+{LIEGE_LORD_MORALE_BONUS>MoraleBonus} {GLOBAL.UnitMoraleConcept.Hyperlink}.[/bulletlist][br/][br/]This bonus increases as this Hero gains {GLOBAL.RenownConcept.Hyperlink}."

msgid "CULTURE_FEUDAL@SUBCULTURE@ARISTOCRACY@BANNERLORD@NAME"
msgstr "Liege Lord"

msgid "CULTURE_FEUDAL@SUBCULTURE@ARISTOCRACY@BANNERLORD@UNIT_PROPERTY_NAME"
msgstr "For the Liege!"

msgid "CULTURE_FEUDAL@SUBCULTURE@ARISTOCRACY@DESCRIPTION"
msgstr "Your cities form powerful Houses, able to field efficient armies when led by their Liege Lords:[bulletlist][bullet/]Each city has a {GLOBAL.FeudalHouseConcept.Hyperlink} led by its governor, who becomes the House's {GLOBAL.PROPERTIES.LIEGE_LORD.Hyperlink}.[Bullet/]Units produced in Feudal cities become part of that city's {GLOBAL.FeudalHouseConcept.Hyperlink}, gaining {GLOBAL.ExperienceConcept.Hyperlink} as their Liege Lord gains {GLOBAL.RenownConcept.Hyperlink}.[Bullet/]Certain units can promote into higher Tier units on attaining Legendary Rank.[/bulletlist]"

msgid "CULTURE_FEUDAL@SUBCULTURE@ARISTOCRACY@LORENAME"
msgstr "Aristocracy^n"

msgid "CULTURE_FEUDAL@SUBCULTURE@ARISTOCRACY@NAME"
msgstr "Aristocracy"

msgid "CULTURE_FEUDAL@SUBCULTURE@ARISTOCRACY@TOME_NAME"
msgstr "Feudal - Aristocracy"

msgid "CULTURE_FEUDAL@SUBCULTURE@MONARCHY@DESCRIPTION"
msgstr "Your people are loyal to the absolute rule of their Monarch, gaining power from the presence of their ruler:[bulletlist][bullet/]The Ruler gains {GLOBAL.PROPERTIES.FEUDAL_MONARCHS_DOMINION.Hyperlink}.[bullet/]Units gain {GLOBAL.PROPERTIES.FOR_THE_MONARCH.Hyperlink}.[Bullet/]Certain units can promote into higher Tier units on attaining Legendary Rank.[/bulletlist]"

msgid "CULTURE_FEUDAL@SUBCULTURE@MONARCHY@LORENAME"
msgstr "Monarchy^n"

msgid "CULTURE_FEUDAL@SUBCULTURE@MONARCHY@NAME"
msgstr "Monarchy"

msgid "CULTURE_FEUDAL@SUBCULTURE@MONARCHY@TOME_NAME"
msgstr "Feudal - Monarchy"

msgid "CULTURE_FEUDAL@SUBCULTURE@MONARCHY@UNIT_PROPERTY@FOR_THE_MONARCH@DESCRIPTION"
msgstr "While in combat in own Domain or alongside their {GLOBAL.LeaderConcept.Hyperlink}, this unit gains:[bulletlist][bullet/]+{Armorbonus} {GLOBAL.DefenseConcept.Hyperlink} and +{Resistance} {GLOBAL.ResistanceConcept.Hyperlink}[bullet/]+{DamagebonusPercentage}% damage[bullet/]+{moralebonus} {GLOBAL.UnitMoraleConcept.Hyperlink}[/bulletlist]"

msgid "CULTURE_FEUDAL@SUBCULTURE@MONARCHY@UNIT_PROPERTY@FOR_THE_MONARCH@NAME"
msgstr "For the Monarch"

msgid "CULTURE_FEUDAL@SUBCULTURE@MONARCHY@UNIT_PROPERTY@MONARCHS_DECREE@COMBAT_PROP_DESCRIPTION"
msgstr "All friendly units gain the benefit from {GLOBAL.PROPERTIES.FOR_THE_MONARCH.Hyperlink} as though the Ruler were present."

msgid "CULTURE_FEUDAL@SUBCULTURE@MONARCHY@UNIT_PROPERTY@MONARCHS_DOMINION@DESCRIPTION"
msgstr "The unit is the absolute Monarch of their faction:[bulletlist][bullet/]In combat, activates {GLOBAL.PROPERTIES.FOR_THE_MONARCH.Hyperlink} on friendly units.[bullet/]While army leader, all units in the army with {GLOBAL.PROPERTIES.FOR_THE_MONARCH.Hyperlink} cost -{FEUDAL_MONARCHS_DOMINION_UPKEEP_MOD>ResolvedUpkeepModifier}% {GLOBAL.UnitUpkeepConcept.Hyperlink}.[bullet/]This unit gains: +{LED_BY_MONARCH_STAT>BONUS>DEFENSE>Armor} {GLOBAL.DefenseConcept.Hyperlink}, +{LED_BY_MONARCH_STAT>BONUS>DEFENSE>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}, +{LED_BY_MONARCH_MOD>ResolvedMultiplier}% damage, and +{LED_BY_MONARCH_MORALE>MoraleBonus} {GLOBAL.UnitMoraleConcept.Hyperlink}.[/bulletlist]"

msgid "CULTURE_FEUDAL@SUBCULTURE@MONARCHY@UNIT_PROPERTY@MONARCHS_DOMINION@NAME"
msgstr "Monarch's Dominion"

msgid "CULTURE_FEUDAL@SUBCULTURE@MONARCHY@UNIT_PROPERTY@MONARCHS_DOMINION@PROPERTY_NAME"
msgstr "Defending the Monarchy"

msgid "CULTURE_FEUDAL@SUBCULTURE@MONARCHY@UNIT_PROPERTY@MONARCHS_DOMINION@UNIT_PROP_DESCRIPTION"
msgstr "This unit is fighting in their Domain or alongside their {GLOBAL.LeaderConcept.Hyperlink}, granting this unit:[bulletlist][bullet/]+{LED_BY_MONARCH_STAT>BONUS>DEFENSE>Armor} {GLOBAL.DefenseConcept.Hyperlink} and +{LED_BY_MONARCH_STAT>BONUS>DEFENSE>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}[bullet/]+{LED_BY_MONARCH_MOD>ResolvedMultiplier}% damage[bullet/]+{LED_BY_MONARCH_MORALE>MoraleBonus} {GLOBAL.UnitMoraleConcept.Hyperlink}[/bulletlist]"

