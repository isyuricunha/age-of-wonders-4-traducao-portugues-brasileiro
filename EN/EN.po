msgstr "The clay warriors are wreathed by immolating flames."

msgid "DLC@GIANTKINGS@TRIGGER@TOOLTIP@ANCIENTWONDER_MOTH@AFFINITY_CHECK_MATERIUM@FAILURE"
msgstr "The clay from which the warriors are shaped is unaffected."

msgid "DLC@GIANTKINGS@TRIGGER@TOOLTIP@ANCIENTWONDER_MOTH@AFFINITY_CHECK_MATERIUM@HEADER"
msgstr "Make the warriors' clay brittle so that they take more damage:"

msgid "DLC@GIANTKINGS@TRIGGER@TOOLTIP@ANCIENTWONDER_MOTH@AFFINITY_CHECK_MATERIUM@SUCCESS"
msgstr "Your attacks will crumble the clay soldiers more easily."

msgid "DLC@GIANTKINGS@TRIGGER@TOOLTIP@ANCIENTWONDER_MOTH@AFFINITY_CHECK_NATURE@FAILURE"
msgstr "The {EnemyUnit} manages to resist the alluring light and attacks."

msgid "DLC@GIANTKINGS@TRIGGER@TOOLTIP@ANCIENTWONDER_MOTH@AFFINITY_CHECK_NATURE@HEADER"
msgstr "Conjure a lightning orb to overstimulate the <<G:vision^n,EnemyUnit>>:"

msgid "DLC@GIANTKINGS@TRIGGER@TOOLTIP@ANCIENTWONDER_MOTH@AFFINITY_CHECK_NATURE@SUCCESS"
msgstr "The {EnemyUnit} is drawn to the orb's light, blinding it!"

msgid "DLC@GIANTKINGS@TRIGGER@TOOLTIP@ANCIENTWONDER_SENTRIES@AFFINITY_CHECK_ASTRAL@FAILURE"
msgstr "Your attempts lead to nothing."

msgid "DLC@GIANTKINGS@TRIGGER@TOOLTIP@ANCIENTWONDER_SENTRIES@AFFINITY_CHECK_ASTRAL@HEADER"
msgstr "Delay the surges of magic that course through the sentries:"

msgid "DLC@GIANTKINGS@TRIGGER@TOOLTIP@ANCIENTWONDER_SENTRIES@AFFINITY_CHECK_ASTRAL@SUCCESS"
msgstr "The waves decrease."

msgid "DLC@GIANTKINGS@TRIGGER@TOOLTIP@ANCIENTWONDER_SENTRIES@AFFINITY_CHECK_CHAOS@FAILURE"
msgstr "The sentries focus on the cleanup task at hand."

msgid "DLC@GIANTKINGS@TRIGGER@TOOLTIP@ANCIENTWONDER_SENTRIES@AFFINITY_CHECK_CHAOS@HEADER"
msgstr "Taunt the sentries to protect your army:"

msgid "DLC@GIANTKINGS@TRIGGER@TOOLTIP@ANCIENTWONDER_SENTRIES@AFFINITY_CHECK_CHAOS@SUCCESS"
msgstr "The sentries are confused."

msgid "DLC@GIANTKINGS@TRIGGER@TOOLTIP@ANCIENTWONDER_SENTRIES@AFFINITY_CHECK_MATERIUM@FAILURE"
msgstr "Your attempts crumble."

msgid "DLC@GIANTKINGS@TRIGGER@TOOLTIP@ANCIENTWONDER_SENTRIES@AFFINITY_CHECK_MATERIUM@HEADER"
msgstr "Attempt to bolster your army's armor:"

msgid "DLC@GIANTKINGS@TRIGGER@TOOLTIP@ANCIENTWONDER_SENTRIES@AFFINITY_CHECK_MATERIUM@SUCCESS"
msgstr "The power of the Giant Kings surges through you."

msgid "DLC@GIANTKINGS@TRIGGER@TOOLTIP@ANCIENTWONDER_SERPENT@AFFINITY_CHECK_CHAOS@FAILURE"
msgstr "You fail to affect the Serpents' minds. They lunge at your troops."

msgid "DLC@GIANTKINGS@TRIGGER@TOOLTIP@ANCIENTWONDER_SERPENT@AFFINITY_CHECK_CHAOS@HEADER"
msgstr "Draw out the lesser Serpents' natural instincts to make them go berserk:"

msgid "DLC@GIANTKINGS@TRIGGER@TOOLTIP@ANCIENTWONDER_SERPENT@AFFINITY_CHECK_CHAOS@SUCCESS"
msgstr "Some of the Serpents writhe and coil before biting into their kin."

msgid "DLC@GIANTKINGS@TRIGGER@TOOLTIP@ANCIENTWONDER_SERPENT@AFFINITY_CHECK_MATERIUM@FAILURE"
msgstr "You are unable to counter the effect of the caustic venom."

msgid "DLC@GIANTKINGS@TRIGGER@TOOLTIP@ANCIENTWONDER_SERPENT@AFFINITY_CHECK_MATERIUM@HEADER"
msgstr "Bolster the Archon collar that inhibits the <<G:power^n,EnemyUnit>>:"

msgid "DLC@GIANTKINGS@TRIGGER@TOOLTIP@ANCIENTWONDER_SERPENT@AFFINITY_CHECK_MATERIUM@SUCCESS"
msgstr "The collar will endure for a little while longer."

msgid "DLC@GIANTKINGS@TRIGGER@TOOLTIP@RELIC_REWARD"
msgstr "You gain the {EventRelic} relic."

msgid "DLC@GIANTKINGS@TRIGGER@TOOLTIP@TSR_REVEAL"
msgstr "Reveals the closest uncompleted Fated Region. Completing those regions yields high rewards, including a unique {GLOBAL.ArtifactConcept.Hyperlink}."

