msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@ICEBOUND_BEHEMOTH@NAME_OVERRIDE_03"
msgstr "Icebound Field"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@ICEBOUND_BEHEMOTH@NAME_OVERRIDE_04"
msgstr "Watcher's Glacier"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@ICEBOUND_BEHEMOTH@NAME_OVERRIDE_05"
msgstr "Urwilder Glacier"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@LITHORITE_PEAKS@DESCRIPTION"
msgstr "<<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacent to this Landmark gain:[bulletlist][bullet/]{income} and {income2}.[bullet/]Allows the construction of a {GLOBAL.ConduitConcept.Hyperlink}.[bullet/]The {combatproperty} {GLOBAL.CombatEnchantmentConcept.Hyperlink}.[/bulletlist][br/]A {GLOBAL.CityConcept.Hyperlink} with {amount} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacent to this Landmark gains:[bulletlist][bullet/]Unlocks recruitment of Lithorine <<m:{GLOBAL.UnitConcept.Hyperlink}>>.[bullet/]{income3} and {income4}.[/bulletlist]"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@LITHORITE_PEAKS@LORE"
msgstr "\"Contrary to the 'cold' magic of the Focus Crystal, Lithorite emits a pulsating warmth. Perhaps this is why the ancient [hyperlink,GLOBAL.GiantKingLoreConcept]Giant Kings[/hyperlink] picked this material for the creation of Lithorine creatures. Even though those are fairly common, large clusters of the material itself are rare. When the sun catches the crystal peaks, it is truly a sight to behold.\"[br/][br/]— Edward Portsmith, Advanced Reports on Mana Infusion"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@LITHORITE_PEAKS@NAME"
msgstr "Lithorine Peaks"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@LITHORITE_PEAKS@NAME_OVERRIDE_01"
msgstr "Sun-Caught Peaks"

