msgid "DIPLOMACY_PERSONALITY@DIPLOMACY_NEUTRAL@NAME"
msgstr "Neutral"

msgid "DIPLOMACY_PERSONALITY@DIPLOMACY_NEVERBREAKTREATIES@DESCRIPTION"
msgstr "The Ruler is committed to the <<m:{GLOBAL.TreatyConcept.Hyperlink}>> they have with other Rulers and will always try to prevent them from being broken."

msgid "DIPLOMACY_PERSONALITY@DIPLOMACY_NEVERBREAKTREATIES@HYPERLINK"
msgstr "[hyperlink,GLOBAL.PTDNeverBreakTreatiesConcept]Never breaks treaties[/hyperlink]"

msgid "DIPLOMACY_PERSONALITY@DIPLOMACY_NEVERBREAKTREATIES@NAME"
msgstr "Never breaks <<m:{GLOBAL.TreatyConcept.Hyperlink}>>"

msgid "DIPLOMACY_PERSONALITY@DIPLOMACY_NEVERSURRENDER@DESCRIPTION"
msgstr "The Ruler will not submit to becoming another Ruler's vassal. During {GLOBAL.WarConcept.Hyperlink}, they will not make peace of their own accord. They are more eager to call allies to war and will also more readily answer a {GLOBAL.CallToWarConcept.Hyperlink}."

msgid "DIPLOMACY_PERSONALITY@DIPLOMACY_NEVERSURRENDER@HYPERLINK"
msgstr "[hyperlink,GLOBAL.PTDNeverSurrenderConcept]Never Surrender[/hyperlink]"

msgid "DIPLOMACY_PERSONALITY@DIPLOMACY_NEVERSURRENDER@NAME"
msgstr "Never Surrender"

msgid "DIPLOMACY_PERSONALITY@DIPLOMACY_NOTREATIES@DESCRIPTION"
msgstr "In general, the Ruler is not interested in having <<m:{GLOBAL.TreatyConcept.Hyperlink}>> with other Rulers, making such trades more costly for the opposing side. They are reluctant to call another Ruler to war and to answer any incoming [hyperlink,GLOBAL.CallToWarConcept]Calls to War[/hyperlink]."

msgid "DIPLOMACY_PERSONALITY@DIPLOMACY_NOTREATIES@HYPERLINK"
msgstr "[hyperlink,GLOBAL.PTDNoTreatiesConcept]Wary of Treaties[/hyperlink]"

msgid "DIPLOMACY_PERSONALITY@DIPLOMACY_NOTREATIES@NAME"
msgstr "Wary of Treaties"

msgid "DIPLOMACY_PERSONALITY@DIPLOMACY_TRADING@DESCRIPTION"
msgstr "The Ruler is keen on making [hyperlink,GLOBAL.TradeConcept]Trade[/hyperlink] offers fairly often."

msgid "DIPLOMACY_PERSONALITY@DIPLOMACY_TRADING@HYPERLINK"
msgstr "[hyperlink,GLOBAL.PTDTradingConcept]Trading[/hyperlink]"

msgid "DIPLOMACY_PERSONALITY@DIPLOMACY_TRADING@NAME"
msgstr "Trading"

msgid "DIPLOMACY_PERSONALITY@DIPLOMACY_TREATIES@DESCRIPTION"
msgstr "The Ruler prefers forming <<m:{GLOBAL.TreatyConcept.Hyperlink}>> with other Rulers and will not break any treaties or [hyperlink,GLOBAL.DSAllianceConcept]Alliances[/hyperlink] they have."

msgid "DIPLOMACY_PERSONALITY@DIPLOMACY_TREATIES@HYPERLINK"
msgstr "[hyperlink,GLOBAL.PTDTreatiesConcept]Favors treaties[/hyperlink]"

msgid "DIPLOMACY_PERSONALITY@DIPLOMACY_TREATIES@NAME"
msgstr "{GLOBAL.TreatyConcept.Hyperlink}"

msgid "DIPLOMACY_PERSONALITY@DIPLOMACY_VASSALIZETOSTRONG@DESCRIPTION"
msgstr "The Ruler is tempted to make vassals of other strong Rulers."

msgid "DIPLOMACY_PERSONALITY@DIPLOMACY_VASSALIZETOSTRONG@HYPERLINK"
msgstr "[hyperlink,GLOBAL.PTDVassalizeToStrongConcept]Vassalize the Strong[/hyperlink]"

msgid "DIPLOMACY_PERSONALITY@DIPLOMACY_VASSALIZETOSTRONG@NAME"
msgstr "Vassalize the Strong"

msgid "DIPLOMACY_PERSONALITY@DIPLOMACY_WARDRIVEN@DESCRIPTION"
msgstr "The Ruler is easily provoked into going to {GLOBAL.WarConcept.Hyperlink}, even over minor <<m:{GLOBAL.CasusBelliConcept}>>. They will not sell or forgive any of their grievances and are more eager to send and answer a {GLOBAL.CallToWarConcept.Hyperlink}."

msgid "DIPLOMACY_PERSONALITY@DIPLOMACY_WARDRIVEN@HYPERLINK"
msgstr "[hyperlink,GLOBAL.PTDWarDrivenConcept]Driven by War[/hyperlink]"

msgid "DIPLOMACY_PERSONALITY@DIPLOMACY_WARDRIVEN@NAME"
msgstr "Driven by War"

msgid "DIPLOMACY_PERSONALITY@DIPLOMACY_WARJUSTIFIED@DESCRIPTION"
msgstr "The Ruler will not go to <<m:{GLOBAL.WarConcept.Hyperlink}>> over minor <<m:{GLOBAL.CasusBelliConcept}>> and will want to justify their war."

msgid "DIPLOMACY_PERSONALITY@DIPLOMACY_WARJUSTIFIED@HYPERLINK"
msgstr "[hyperlink,GLOBAL.PTDWarJustifiedConcept]War must be justified[/hyperlink]"

msgid "DIPLOMACY_PERSONALITY@DIPLOMACY_WARJUSTIFIED@NAME"
msgstr "War must be justified"

msgid "DIPLOMACY_PERSONALITY@DISLIKE@DESCRIPTION"
msgstr "Dislikes are part of how an AI Ruler perceives other Rulers and determines which Actions or statuses of another Ruler they will dislike. Relations with Rulers that trigger these dislikes will incur a relation penalty."

msgid "DIPLOMACY_PERSONALITY@DISLIKE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.PersonalityPreferenceConcept]Dislike[/hyperlink]"

msgid "DIPLOMACY_PERSONALITY@DISLIKE@NAME"
msgstr "Dislike"

msgid "DIPLOMACY_PERSONALITY@PREFERENCE@DESCRIPTION"
msgstr "Preferences are part of how an AI Ruler perceives other Rulers and determine which Actions or statuses they like or dislike other Rulers to pursue.[br/][br/]Relations with Rulers that conform to these preferences will receive a relation bonus, while Relations with Rulers that trigger Dislikes will incur a relation penalty."

msgid "DIPLOMACY_PERSONALITY@PREFERENCE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.PersonalityPreferenceConcept]Preference[/hyperlink]"

msgid "DIPLOMACY_PERSONALITY@PREFERENCE@NAME"
msgstr "Personality Preference"

msgid "DIPLOMACY_PERSONALITY@PREFERENCE_ALLIES_FEW@NAME"
msgstr "Empires with few Alliances"

msgid "DIPLOMACY_PERSONALITY@PREFERENCE_ALLIES_MANY@NAME"
msgstr "Empires that have many Alliances"

msgid "DIPLOMACY_PERSONALITY@PREFERENCE_CASUSBELLI_TRADED@NAME"
msgstr "Empires that trade <<m:{GLOBAL.CasusBelliConcept.Hyperlink}>>"

msgid "DIPLOMACY_PERSONALITY@PREFERENCE_ECONOMY_STRONGER@NAME"
msgstr "Empires with a stronger Economy"

msgid "DIPLOMACY_PERSONALITY@PREFERENCE_ECONOMY_WEAKER@NAME"
msgstr "Empires with a weaker Economy"

msgid "DIPLOMACY_PERSONALITY@PREFERENCE_EXPANSION_STRONGER@NAME"
msgstr "Empires with a larger Domain"

msgid "DIPLOMACY_PERSONALITY@PREFERENCE_EXPANSION_WEAKER@NAME"
msgstr "Empires with a smaller Domain"

msgid "DIPLOMACY_PERSONALITY@PREFERENCE_MILITARY_STRONGER@NAME"
msgstr "Empires with a stronger Military"

msgid "DIPLOMACY_PERSONALITY@PREFERENCE_MILITARY_WEAKER@NAME"
msgstr "Empires with a weaker Military"

msgid "DIPLOMACY_PERSONALITY@PREFERENCE_PLAYERS_DEFEATED@NAME"
msgstr "Empires that have defeated other Empires"

msgid "DIPLOMACY_PERSONALITY@PREFERENCE_PRISONERS_EXECUTED@NAME"
msgstr "Empires that Execute Prisoners"

msgid "DIPLOMACY_PERSONALITY@PREFERENCE_PVE_BAD@NAME"
msgstr "Empires without relationships with Free Cities"

msgid "DIPLOMACY_PERSONALITY@PREFERENCE_PVE_GOOD@NAME"
msgstr "Empires with good Relations with Free Cities"

msgid "DIPLOMACY_PERSONALITY@PREFERENCE_RACIALCITIES_MULTIPLE@NAME"
msgstr "Empires with multiple Races"

msgid "DIPLOMACY_PERSONALITY@PREFERENCE_RACIALCITIES_SINGLE@NAME"
msgstr "Empires with a single Race"

msgid "DIPLOMACY_PERSONALITY@PREFERENCE_RESEARCH_STRONGER@NAME"
msgstr "Empires with stronger Research"

msgid "DIPLOMACY_PERSONALITY@PREFERENCE_RESEARCH_WEAKER@NAME"
msgstr "Empires with weaker Research"

msgid "DIPLOMACY_PERSONALITY@PREFERENCE_TRADES@NAME"
msgstr "Empires that Trade"

msgid "DIPLOMACY_PERSONALITY@PREFERENCE_TREATIES_BROKEN@NAME"
msgstr "Empires that break Treaties"

msgid "DIPLOMACY_PERSONALITY@PREFERENCE_TREATIES_KEPT@NAME"
msgstr "Empires that don't break Treaties"

msgid "DIPLOMACY_PERSONALITY@PREFERENCE_UNITS_SUMMONED@NAME"
msgstr "Empires that have Summoned Units"

msgid "DIPLOMACY_PERSONALITY@PREFERENCE_VASSALS@NAME"
msgstr "Empires with Vassals"

msgid "DIPLOMACY_PERSONALITY@PREFERENCE_WARS@NAME"
msgstr "Empires that are at War"

msgid "DIPLOMACY_PERSONALITY@PREFERENCE_WAR_DEFENDING@NAME"
msgstr "Empires which get declared war upon"

msgid "DIPLOMACY_PERSONALITY@PREFERENCE_WAR_NOTSTARTED@NAME"
msgstr "Empires that do not start Wars"

msgid "DIPLOMACY_PERSONALITY@PREFERENCE_WAR_STARTED@NAME"
msgstr "Empires that start Wars"

msgid "DIPLOMACY_PERSONALITY@STRATEGY@DESCRIPTION"
msgstr "A Ruler's Strategy determines how they will act in terms of their Economy, Research, and Military, but also on a Diplomatic Level."

msgid "DIPLOMACY_PERSONALITY@STRATEGY@HYPERLINK"
msgstr "[hyperlink,GLOBAL.PersonalityStrategyConcept]Strategy[/hyperlink]"

msgid "DIPLOMACY_PERSONALITY@STRATEGY@NAME"
msgstr "Strategy"

msgid "DIPLOMACY_PERSONALITY@STRATEGY_EXPANSION@DESCRIPTION"
msgstr "The Ruler favors expanding their empire by building and absorbing cities. They focus on improving their cities and defending them."

msgid "DIPLOMACY_PERSONALITY@STRATEGY_EXPANSION@HYPERLINK"
msgstr "[hyperlink,GLOBAL.PTSExpansionConcept]Expansion[/hyperlink]"

msgid "DIPLOMACY_PERSONALITY@STRATEGY_EXPANSION@NAME"
msgstr "Expansion"

msgid "DIPLOMACY_PERSONALITY@STRATEGY_EXPLOITATION@DESCRIPTION"
msgstr "The Ruler favors exploiting all forms of resources near them and will hunt down <<m:{GLOBAL.PickupConcept.Hyperlink}>>, marauders and cities with their army. Captured cities will be migrated into their own population."

msgid "DIPLOMACY_PERSONALITY@STRATEGY_EXPLOITATION@HYPERLINK"
msgstr "[hyperlink,GLOBAL.PTSExploitationConcept]Exploitation[/hyperlink]"

msgid "DIPLOMACY_PERSONALITY@STRATEGY_EXPLOITATION@NAME"
msgstr "Exploitation"

msgid "DIPLOMACY_PERSONALITY@STRATEGY_EXPLORATION@DESCRIPTION"
msgstr "The Ruler favors exploring the map, seeking out potential resources such as <<m:{GLOBAL.PickupConcept.Hyperlink}>> and <<m:{GLOBAL.AncientWonderConcept.Hyperlink}>>."

msgid "DIPLOMACY_PERSONALITY@STRATEGY_EXPLORATION@HYPERLINK"
msgstr "[hyperlink,GLOBAL.PTSExplorationConcept]Exploration[/hyperlink]"

msgid "DIPLOMACY_PERSONALITY@STRATEGY_EXPLORATION@NAME"
msgstr "Exploration"

msgid "DIPLOMACY_PERSONALITY@STRATEGY_EXTERMINATION@DESCRIPTION"
msgstr "The Ruler favors capturing resources using large armies rather than building them themselves and will raze other Rulers' cities that they have occupied."

msgid "DIPLOMACY_PERSONALITY@STRATEGY_EXTERMINATION@HYPERLINK"
msgstr "[hyperlink,GLOBAL.PTSExterminationConcept]Extermination[/hyperlink]"

msgid "DIPLOMACY_PERSONALITY@STRATEGY_EXTERMINATION@NAME"
msgstr "Extermination"

msgid "DIPLOMACY_PERSONALITY@STRATEGY_NEUTRAL@DESCRIPTION"
msgstr "The Ruler has no specific agenda or focus and acts more on the opportunities that present themselves."

msgid "DIPLOMACY_PERSONALITY@STRATEGY_NEUTRAL@HYPERLINK"
msgstr "[hyperlink,GLOBAL.PTSNeutralConcept]Neutral[/hyperlink]"

msgid "DIPLOMACY_PERSONALITY@STRATEGY_NEUTRAL@NAME"
msgstr "Neutral"

msgid "DIPLOMACY_PERSONALITY@TEXT@CRYSTAL_DWELLING_INTERACTION"
msgstr "Trading"

msgid "DIPLOMACY_PERSONALITY@TRAIT_ASTRAL_01@DESCRIPTION"
msgstr "A knowledgeable Ruler who believes in mind over matter."

msgid "DIPLOMACY_PERSONALITY@TRAIT_ASTRAL_01@HYPERLINK"
msgstr "[personalityAstral01/][hyperlink,GLOBAL.PTAstral01Concept]Pure Sage[/hyperlink]"

msgid "DIPLOMACY_PERSONALITY@TRAIT_ASTRAL_01@TITLE"
msgstr "Pure Sage"

msgid "DIPLOMACY_PERSONALITY@TRAIT_ASTRAL_02@DESCRIPTION"
msgstr "An ambitious Ruler who values strategy and magical prowess."

msgid "DIPLOMACY_PERSONALITY@TRAIT_ASTRAL_02@HYPERLINK"
msgstr "[personalityAstral02/][hyperlink,GLOBAL.PTAstral02Concept]Strategist Warlord[/hyperlink]"

msgid "DIPLOMACY_PERSONALITY@TRAIT_ASTRAL_02@TITLE"
msgstr "Strategist Warlord"

msgid "DIPLOMACY_PERSONALITY@TRAIT_ASTRAL_03@DESCRIPTION"
msgstr "A peaceful Ruler who values wisdom and learning."

msgid "DIPLOMACY_PERSONALITY@TRAIT_ASTRAL_03@HYPERLINK"
msgstr "[personalityAstral03/][hyperlink,GLOBAL.PTAstral03Concept]Erudite Sage[/hyperlink]"

msgid "DIPLOMACY_PERSONALITY@TRAIT_ASTRAL_03@TITLE"
msgstr "Erudite Sage"

msgid "DIPLOMACY_PERSONALITY@TRAIT_CHAOS_01@DESCRIPTION"
msgstr "A power-hungry Ruler who believes that might makes right."

msgid "DIPLOMACY_PERSONALITY@TRAIT_CHAOS_01@HYPERLINK"
msgstr "[personalityChaos01/][hyperlink,GLOBAL.PTChaos01Concept]Militant Warlord[/hyperlink]"

msgid "DIPLOMACY_PERSONALITY@TRAIT_CHAOS_01@TITLE"
msgstr "Militant Warlord"

msgid "DIPLOMACY_PERSONALITY@TRAIT_CHAOS_02@DESCRIPTION"
msgstr "A rebellious Ruler who values both freedom and alliances."

msgid "DIPLOMACY_PERSONALITY@TRAIT_CHAOS_02@HYPERLINK"
msgstr "[personalityChaos02/][hyperlink,GLOBAL.PTChaos02Concept]Revolutionary Diplomat[/hyperlink]"

msgid "DIPLOMACY_PERSONALITY@TRAIT_CHAOS_02@TITLE"
msgstr "Revolutionary Diplomat"

msgid "DIPLOMACY_PERSONALITY@TRAIT_CHAOS_03@DESCRIPTION"
msgstr "A bloodthirsty Ruler who prefers treachery to weakness."

msgid "DIPLOMACY_PERSONALITY@TRAIT_CHAOS_03@HYPERLINK"
msgstr "[personalityChaos03/][hyperlink,GLOBAL.PTChaos03Concept]Demonic Warlord[/hyperlink]"

msgid "DIPLOMACY_PERSONALITY@TRAIT_CHAOS_03@TITLE"
msgstr "Demonic Warlord"

msgid "DIPLOMACY_PERSONALITY@TRAIT_MATERIUM_01@DESCRIPTION"
msgstr "A coin-savvy Ruler who is willing to trade... for the right price."

msgid "DIPLOMACY_PERSONALITY@TRAIT_MATERIUM_01@HYPERLINK"
msgstr "[personalityMaterium01/][hyperlink,GLOBAL.PTMaterium01Concept]Competitive Merchant[/hyperlink]"

msgid "DIPLOMACY_PERSONALITY@TRAIT_MATERIUM_01@TITLE"
msgstr "Competitive Merchant"

msgid "DIPLOMACY_PERSONALITY@TRAIT_MATERIUM_02@DESCRIPTION"
msgstr "An isolated Ruler who believes in a strong defensive force."

msgid "DIPLOMACY_PERSONALITY@TRAIT_MATERIUM_02@HYPERLINK"
msgstr "[personalityMaterium02/][hyperlink,GLOBAL.PTMaterium02Concept]Solitary Isolationist[/hyperlink]"

msgid "DIPLOMACY_PERSONALITY@TRAIT_MATERIUM_02@TITLE"
msgstr "Solitary Isolationist"

msgid "DIPLOMACY_PERSONALITY@TRAIT_MATERIUM_03@DESCRIPTION"
msgstr "An expressive creator who values both matter and mind."

msgid "DIPLOMACY_PERSONALITY@TRAIT_MATERIUM_03@HYPERLINK"
msgstr "[personalityMaterium03/][hyperlink,GLOBAL.PTMaterium03Concept]Artisan Merchant[/hyperlink]"

msgid "DIPLOMACY_PERSONALITY@TRAIT_MATERIUM_03@TITLE"
msgstr "Artisan Merchant"

msgid "DIPLOMACY_PERSONALITY@TRAIT_MATERIUM_04@DESCRIPTION"
msgstr "A greedy Ruler who will stop at nothing to achieve economic goals."

msgid "DIPLOMACY_PERSONALITY@TRAIT_MATERIUM_04@HYPERLINK"
msgstr "[personalityMaterium04/][hyperlink,GLOBAL.PTMaterium04Concept]Economic Warlord[/hyperlink]"

msgid "DIPLOMACY_PERSONALITY@TRAIT_MATERIUM_04@TITLE"
msgstr "Economic Warlord"

msgid "DIPLOMACY_PERSONALITY@TRAIT_NATURE_01@DESCRIPTION"
msgstr "A peace-keeping Ruler who believes in good relations."

msgid "DIPLOMACY_PERSONALITY@TRAIT_NATURE_01@HYPERLINK"
msgstr "[personalityNature01/][hyperlink,GLOBAL.PTNature01Concept]Persevering Diplomat[/hyperlink]"

msgid "DIPLOMACY_PERSONALITY@TRAIT_NATURE_01@TITLE"
msgstr "Persevering Diplomat"

msgid "DIPLOMACY_PERSONALITY@TRAIT_NATURE_02@DESCRIPTION"
msgstr "A forgiving Ruler who values alliances and exploration."

msgid "DIPLOMACY_PERSONALITY@TRAIT_NATURE_02@HYPERLINK"
msgstr "[personalityNature02/][hyperlink,GLOBAL.PTNature02Concept]Harmonious Sage[/hyperlink]"

msgid "DIPLOMACY_PERSONALITY@TRAIT_NATURE_02@TITLE"
msgstr "Harmonious Sage"

msgid "DIPLOMACY_PERSONALITY@TRAIT_NATURE_03@DESCRIPTION"
msgstr "A vigilant Ruler who prefers vassalization and magic."

msgid "DIPLOMACY_PERSONALITY@TRAIT_NATURE_03@HYPERLINK"
msgstr "[personalityNature03/][hyperlink,GLOBAL.PTNature03Concept]Protective Sage[/hyperlink]"

msgid "DIPLOMACY_PERSONALITY@TRAIT_NATURE_03@TITLE"
msgstr "Protective Sage"

msgid "DIPLOMACY_PERSONALITY@TRAIT_ORDER_01@DESCRIPTION"
msgstr "An honorable Ruler who believes in justice and peace."

msgid "DIPLOMACY_PERSONALITY@TRAIT_ORDER_01@HYPERLINK"
msgstr "[personalityOrder01/][hyperlink,GLOBAL.PTOrder01Concept]Chivalrous Diplomat[/hyperlink]"

msgid "DIPLOMACY_PERSONALITY@TRAIT_ORDER_01@TITLE"
msgstr "Chivalrous Diplomat"

msgid "DIPLOMACY_PERSONALITY@TRAIT_ORDER_02@DESCRIPTION"
msgstr "A strict Ruler who believes in high civic order."

msgid "DIPLOMACY_PERSONALITY@TRAIT_ORDER_02@HYPERLINK"
msgstr "[personalityOrder02/][hyperlink,GLOBAL.PTOrder02Concept]Authoritarian Diplomat[/hyperlink]"

msgid "DIPLOMACY_PERSONALITY@TRAIT_ORDER_02@TITLE"
msgstr "Authoritarian Diplomat"

msgid "DIPLOMACY_PERSONALITY@TRAIT_ORDER_03@DESCRIPTION"
msgstr "An imperialistic Ruler who favors stability through subjugation."

msgid "DIPLOMACY_PERSONALITY@TRAIT_ORDER_03@HYPERLINK"
msgstr "[personalityOrder03/][hyperlink,GLOBAL.PTOrder03Concept]Imperial Warlord[/hyperlink]"

msgid "DIPLOMACY_PERSONALITY@TRAIT_ORDER_03@TITLE"
msgstr "Imperial Warlord"

msgid "DIPLOMACY_PERSONALITY@TRAIT_ORDER_04@DESCRIPTION"
msgstr "A secluded Ruler who values purity of mind and empire."

msgid "DIPLOMACY_PERSONALITY@TRAIT_ORDER_04@HYPERLINK"
msgstr "[personalityOrder04/][hyperlink,GLOBAL.PTOrder04Concept]Fanatic Isolationist[/hyperlink]"

msgid "DIPLOMACY_PERSONALITY@TRAIT_ORDER_04@TITLE"
msgstr "Fanatic Isolationist"

msgid "DIPLOMACY_PERSONALITY@TRAIT_SHADOW_01@DESCRIPTION"
msgstr "A cunning Ruler who values power and treachery."

msgid "DIPLOMACY_PERSONALITY@TRAIT_SHADOW_01@HYPERLINK"
msgstr "[personalityShadow01/][hyperlink,GLOBAL.PTShadow01Concept]Deceptive Spy[/hyperlink]"

msgid "DIPLOMACY_PERSONALITY@TRAIT_SHADOW_01@TITLE"
msgstr "Deceptive Spy"

msgid "DIPLOMACY_PERSONALITY@TRAIT_SHADOW_02@DESCRIPTION"
msgstr "An individualistic Ruler who prefers peaceful co-existence."

msgid "DIPLOMACY_PERSONALITY@TRAIT_SHADOW_02@HYPERLINK"
msgstr "[personalityShadow02/][hyperlink,GLOBAL.PTShadow02Concept]Reserved Isolationist[/hyperlink]"

msgid "DIPLOMACY_PERSONALITY@TRAIT_SHADOW_02@TITLE"
msgstr "Reserved Isolationist"

msgid "DIPLOMACY_PERSONALITY@TRAIT_SHADOW_03@DESCRIPTION"
msgstr "A self-centered Ruler who prefers to deal with the weak."

msgid "DIPLOMACY_PERSONALITY@TRAIT_SHADOW_03@HYPERLINK"
msgstr "[personalityShadow03/][hyperlink,GLOBAL.PTShadow03Concept]Sinister Spy[/hyperlink]"

msgid "DIPLOMACY_PERSONALITY@TRAIT_SHADOW_03@TITLE"
msgstr "Sinister Spy"

msgid "DIPLOMATICSTATES_DEFINITIONS@ALLOWCLAIMEDSECTORS@AI_DESC"
msgstr "Let's fortify our positions. Allowing me to build near your borders will make the both of us stronger."

msgid "DIPLOMATICSTATES_DEFINITIONS@ALLOWCLAIMEDSECTORS@DESCRIPTION"
msgstr "Both <<m:{GLOBAL.LeaderConcept.Hyperlink}>> are allowed to build on each other's [hyperlink,GLOBAL.ClaimConcept]claimed[/hyperlink] <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> without triggering <<m:{GLOBAL.CasusBelliConcept.Hyperlink}>>."

msgid "DIPLOMATICSTATES_DEFINITIONS@ALLOWCLAIMEDSECTORS@HYPERLINK"
msgstr "[hyperlink,GLOBAL.AllowClaimedSectorsConcept]Province-Claiming Pact[/hyperlink]"

msgid "DIPLOMATICSTATES_DEFINITIONS@ALLOWCLAIMEDSECTORS@NAME"
msgstr "Province-Claiming Pact"

msgid "DIPLOMATICSTATES_DEFINITIONS@ALLOWCLAIMEDSECTORSFORTURNS@DESCRIPTION"
msgstr "Both Rulers are allowed to build on each other's claimed provinces for a fixed duration.[br/][br/]Effects:[bulletList][bullet/]{RelationValue}[goodRelation/] Relations[bullet/]Rulers can capture and build on claimed provinces without incurring a penalty.[/bulletList]"

msgid "DIPLOMATICSTATES_DEFINITIONS@BREAK_ALLIANCE@AI_DESC"
msgstr "This alliance no longer seems favorable to me. This is where we part ways."

msgid "DIPLOMATICSTATES_DEFINITIONS@BREAK_ALLIANCE@DESCRIPTION"
msgstr "Break your alliance and revert back to a peace state."

msgid "DIPLOMATICSTATES_DEFINITIONS@BREAK_ALLIANCE@NAME"
msgstr "Break Alliance"

msgid "DIPLOMATICSTATES_DEFINITIONS@BREAK_ALLOWCLAIMEDSECTORS@DESCRIPTION"
msgstr "Neither Ruler is allowed to build on each other's claimed provinces."

msgid "DIPLOMATICSTATES_DEFINITIONS@BREAK_ALLOWCLAIMEDSECTORS@NAME"
msgstr "Break Province-Claiming Pact"

msgid "DIPLOMATICSTATES_DEFINITIONS@BREAK_CONSULATE@DESCRIPTION"
msgstr "The wizard's bond as well as any treaties and states that depend on it will be broken."

msgid "DIPLOMATICSTATES_DEFINITIONS@BREAK_CONSULATE@NAME"
msgstr "Break Wizard's Bond"

msgid "DIPLOMATICSTATES_DEFINITIONS@BREAK_DEFENSIVEPACT@DESCRIPTION"
msgstr "The defensive pact is broken. Rulers will no longer automatically be called into defensive wars and no longer aid each other in battle against common enemies."

msgid "DIPLOMATICSTATES_DEFINITIONS@BREAK_DEFENSIVEPACT@NAME"
msgstr "Break Defensive Pact"

msgid "DIPLOMATICSTATES_DEFINITIONS@BREAK_OPENBORDERS@DESCRIPTION"
msgstr "Neither Ruler will be allowed to move their armies through each other's domain."

msgid "DIPLOMATICSTATES_DEFINITIONS@BREAK_OPENBORDERS@NAME"
msgstr "Close Borders"

msgid "DIPLOMATICSTATES_DEFINITIONS@BREAK_SHAREVISION@DESCRIPTION"
msgstr "Vision sharing between the two Rulers will end."

msgid "DIPLOMATICSTATES_DEFINITIONS@BREAK_SHAREVISION@NAME"
msgstr "Break Share Vision"

msgid "DIPLOMATICSTATES_DEFINITIONS@BREAK_TELEPORTERPACT@DESCRIPTION"
msgstr "Neither Ruler will be allowed to use the teleporters of the other."

msgid "DIPLOMATICSTATES_DEFINITIONS@BREAK_TELEPORTERPACT@NAME"
msgstr "Break Teleporter Pact"

msgid "DIPLOMATICSTATES_DEFINITIONS@BREAK_VASSALAGE@DESCRIPTION"
msgstr "End the vassalage. This releases the vassal but maintains the alliance without incurring any penalties."

msgid "DIPLOMATICSTATES_DEFINITIONS@BREAK_VASSALAGE@NAME"
msgstr "End Vassalage"

msgid "DIPLOMATICSTATES_DEFINITIONS@CONSULATE@AI_DESC"
msgstr "A wizard's bond will improve our relations and expand our diplomatic options."

msgid "DIPLOMATICSTATES_DEFINITIONS@CONSULATE@DESCRIPTION"
msgstr "Both <<m:{GLOBAL.LeaderConcept.Hyperlink}>> agree to a wizard's bond to improve {GLOBAL.EmpireRelationConcept.Hyperlink} and access new <<m:{GLOBAL.TreatyConcept.Hyperlink}>> and Diplomatic States.[br/][br/]Effects:[bulletList][bullet/]The {GLOBAL.ThroneCityConcept.Hyperlink} of each Ruler will be revealed.[bullet/]Rulers can [hyperlink,GLOBAL.CallToWarConcept]call each other to war[/hyperlink].[/bulletList][br/][br/]Leads to:[bulletlist][bullet/]{GLOBAL.DefensivePactConcept.Hyperlink}[bullet/]{GLOBAL.OpenBordersConcept.Hyperlink}[bullet/]{GLOBAL.AllowClaimedSectorsConcept.Hyperlink}[bullet/]{GLOBAL.TeleporterPactConcept.Hyperlink}[/bulletlist]"

msgid "DIPLOMATICSTATES_DEFINITIONS@CONSULATE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.MutualConsulateConcept]Wizard's Bond[/hyperlink]"

msgid "DIPLOMATICSTATES_DEFINITIONS@CONSULATE@NAME"
msgstr "Wizard's Bond"

msgid "DIPLOMATICSTATES_DEFINITIONS@DEFENSIVEPACT@AI_DESC"
msgstr "A defensive pact will ensure no other Ruler dares defy us."

msgid "DIPLOMATICSTATES_DEFINITIONS@DEFENSIVEPACT@DESCRIPTION"
msgstr "A Diplomatic State in which the <<m:{GLOBAL.LeaderConcept.Hyperlink}>> vow to come to each other's aid in defensive wars.[br/][br/]When war is declared on either Ruler, they will automatically send a {GLOBAL.CallToWarConcept.Hyperlink} to the other, asking them to aid them in the war. Answering this call to war will give the Ruler additional <<m:{GLOBAL.CasusBelliConcept.Hyperlink}>> to use directly. Rulers may still refuse to accept this call but will break the defensive pact if they do.[br/][br/]Leads to:[bulletlist][bullet/]{GLOBAL.DSAllianceConcept.Hyperlink}[bullet/]{GLOBAL.ShareVisionConcept.Hyperlink}[/bulletlist]"

msgid "DIPLOMATICSTATES_DEFINITIONS@DEFENSIVEPACT@HYPERLINK"
msgstr "[rs_defensivepact/][hyperlink,GLOBAL.DefensivePactConcept]Defensive Pact[/hyperlink]"

msgid "DIPLOMATICSTATES_DEFINITIONS@DEFENSIVEPACT@NAME"
msgstr "Defensive Pact"

msgid "DIPLOMATICSTATES_DEFINITIONS@OPENBORDERS@AI_DESC"
msgstr "Let us open our borders to each other. This would greatly improve our mobility."

msgid "DIPLOMATICSTATES_DEFINITIONS@OPENBORDERS@DESCRIPTION"
msgstr "Both <<m:{GLOBAL.LeaderConcept}>> open their borders to each other. This allows <<m:{GLOBAL.ArmyConcept.Hyperlink}>> to move through <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> of the opposing Ruler without [hyperlink,GLOBAL.TrespassingConcept]trespassing[/hyperlink]."

msgid "DIPLOMATICSTATES_DEFINITIONS@OPENBORDERS@HYPERLINK"
msgstr "[hyperlink,GLOBAL.OpenBordersConcept]Open Borders[/hyperlink]"

msgid "DIPLOMATICSTATES_DEFINITIONS@OPENBORDERS@NAME"
msgstr "Open Borders"

msgid "DIPLOMATICSTATES_DEFINITIONS@OPENBORDERSFORTURNS@DESCRIPTION"
msgstr "Both Rulers open their borders to each other for a fixed duration.[br/][br/]Effects:[bulletList][bullet/]{RelationValue}[goodRelation/] Relations.[bullet/]Rulers may move their armies freely through each other's domain.[/bulletList]"

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_ALLIANCE@AI_DESC"
msgstr "I propose we forge an alliance so that we may come to each other's aid in times of war."

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_ALLIANCE@DESCRIPTION"
msgstr "Propose an {GLOBAL.DSAllianceConcept.Hyperlink} with the other Ruler. These are the strongest possible relations one can have. Both Rulers need to agree to a {GLOBAL.DefensivePactConcept.Hyperlink} first. {LOC.DIPLOMATICSTATES_DEFINITIONS@OPTION_RETURNCAPTUREDHEROES@DESCRIPTION_TRADE}"

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_ALLIANCE@NAME"
msgstr "Propose Alliance"

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_NEUTRAL@AI_DESC"
msgstr "Let us forget about the past and move into a new future!"

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_NEUTRAL@DESCRIPTION"
msgstr "Both Rulers agree to end the war and declare a truce, where they promise to cease all hostile action."

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_NEUTRAL@NAME"
msgstr "Make Peace"

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_OVERLORD@AI_DESC"
msgstr "Surrender to me and survive as my loyal vassal. Together, the world will be ours."

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_OVERLORD@DESCRIPTION"
msgstr "Become overlord over the other Ruler. {LOC.DIPLOMATICSTATES_DEFINITIONS@OPTION_VASSALAGE@DESCRIPTION_GENERIC}"

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_OVERLORD@NAME"
msgstr "You become overlord "

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_RETURNCAPTUREDHEROES@DESCRIPTION"
msgstr "When captured <<m:{GLOBAL.HeroConcept.Hyperlink}>> are returned to their original owner, they will become available for recruitment (for free). Heroes in the {GLOBAL.CryptConcept.Hyperlink} will be returned to the crypt of the original owner instead.[br/][br/]When reaching an {GLOBAL.DSAllianceConcept.Hyperlink}, <<m:{GLOBAL.LeaderConcept.Hyperlink}>> will automatically return their captured heroes to the other ruler."

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_RETURNCAPTUREDHEROES@DESCRIPTION_TRADE"
msgstr "Both sides will [hyperlink,GLOBAL.ReturnCapturedHeroesConcept]return their captured heroes[/hyperlink]."

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_RETURNCAPTUREDHEROES@HYPERLINK"
msgstr "[hyperlink,GLOBAL.ReturnCapturedHeroesConcept]return captured heroes[/hyperlink]."

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_RETURNCAPTUREDHEROES@NAME"
msgstr "Returning captured heroes."

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_VASSALAGE@AI_DESC"
msgstr "I surrender my empire to you. Let us forge an alliance and work together with me as your vassal."

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_VASSALAGE@DESCRIPTION"
msgstr "Become a vassal of the other Ruler. {LOC.DIPLOMATICSTATES_DEFINITIONS@OPTION_VASSALAGE@DESCRIPTION_GENERIC}"

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_VASSALAGE@DESCRIPTION_GENERIC"
msgstr "This effectively creates a fixed {GLOBAL.DSAllianceConcept.Hyperlink} with the other Ruler which only the overlord can break. The deal only works if neither Ruler is already a vassal. The overlord will gain additional resources per turn based on the income of their vassal.[br/][br/]The vassal will automatically be drawn into any wars their overlord is fighting and will end any wars the overlord is not involved in. {LOC.DIPLOMATICSTATES_DEFINITIONS@OPTION_RETURNCAPTUREDHEROES@DESCRIPTION_TRADE}"

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_VASSALAGE@NAME"
msgstr "You become a vassal"

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_WAR@AI_DESC"
msgstr "This relationship is over. I'll be coming for you!"

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_WAR@DESCRIPTION"
msgstr "Declare war on the other Ruler. This will change your diplomatic state to war and you suffer alignment and relation penalties with other Rulers and cities."

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_WAR@NAME"
msgstr "Declare war without justification"

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_WAR_CB@NAME"
msgstr "Declare justified war"

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_WAR_DISABLED@DESCRIPTION"
msgstr "You cannot declare war on the other Ruler while either of you is the vassal of another Ruler. Overlords can enter into wars and their vassals will join them."

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_WAR_MAJOR_CB@AI_DESC"
msgstr "Your actions cannot be forgiven. I will have my revenge!"

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_WAR_MAJOR_CB@DESCRIPTION"
msgstr "Declare war on the other Ruler with major {GLOBAL.WarJustificationConcept.Hyperlink}. Your diplomatic state will change to war and other Rulers and vassal cities will support you."

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_WAR_MAJOR_CB@NAME"
msgstr "Declare war with major {GLOBAL.WarJustificationConcept.Hyperlink} (51+ [CasusBelli/])"

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_WAR_MINOR_CB@AI_DESC"
msgstr "You have wronged me too many times. You are next on my list!"

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_WAR_MINOR_CB@DESCRIPTION"
msgstr "Declare war on the other Ruler with minor {GLOBAL.WarJustificationConcept.Hyperlink}."

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_WAR_MINOR_CB@NAME"
msgstr "Declare war with minor {GLOBAL.WarJustificationConcept.Hyperlink} (1-25[CasusBelli/])"

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_WAR_NORMAL_CB@AI_DESC"
msgstr "You didn't think I would simply forget, did you?"

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_WAR_NORMAL_CB@DESCRIPTION"
msgstr "Declare war on the other Ruler with moderate {GLOBAL.WarJustificationConcept.Hyperlink}. Your diplomatic state will change to war and your relations may suffer."

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_WAR_NORMAL_CB@NAME"
msgstr "Declare war with moderate {GLOBAL.WarJustificationConcept.Hyperlink} (26-50[CasusBelli/])"

msgid "DIPLOMATICSTATES_DEFINITIONS@SHAREINTELLIGENCE@AI_DESC"
msgstr "Sharing our intel will provide us with mutual protection!"

msgid "DIPLOMATICSTATES_DEFINITIONS@SHAREINTELLIGENCE@DESCRIPTION"
msgstr "The Rulers form a mutual intelligence sharing pact."

msgid "DIPLOMATICSTATES_DEFINITIONS@SHAREINTELLIGENCE@NAME"
msgstr "Research Pact"

msgid "DIPLOMATICSTATES_DEFINITIONS@SHAREINTELLIGENCEFORTURNS@DESCRIPTION"
msgstr "The Rulers form a mutual intelligence sharing pact for a fixed duration."

msgid "DIPLOMATICSTATES_DEFINITIONS@SHAREINTELLIGENCEFORTURNS@NAME"
msgstr "Intelligence Sharing Pact"

msgid "DIPLOMATICSTATES_DEFINITIONS@SHAREVISION@AI_DESC"
msgstr "Let us share our vision so we can better assist each other!"

msgid "DIPLOMATICSTATES_DEFINITIONS@SHAREVISION@DESCRIPTION"
msgstr "Both <<m:{GLOBAL.LeaderConcept.Hyperlink}>> share their [hyperlink,GLOBAL.VisionRangeConcept]Vision[/hyperlink] with each other and will reveal explored areas to each other."

msgid "DIPLOMATICSTATES_DEFINITIONS@SHAREVISION@HYPERLINK"
msgstr "[hyperlink,GLOBAL.ShareVisionConcept]Share Vision[/hyperlink]"

msgid "DIPLOMATICSTATES_DEFINITIONS@SHAREVISION@NAME"
msgstr "Share Vision"

msgid "DIPLOMATICSTATES_DEFINITIONS@SHAREVISIONFORTURNS@DESCRIPTION"
msgstr "Both Rulers share their vision with each other for a fixed duration.[br/][br/]Effects:[bulletList][bullet/]{RelationValue}[goodRelation/] Relations.[bullet/]Rulers gain active vision from one another.[/bulletList]"

msgid "DIPLOMATICSTATES_DEFINITIONS@TELEPORTERPACT@DESCRIPTION"
msgstr "Both <<m:{GLOBAL.LeaderConcept.Hyperlink}>> allow each other to teleport to and from their <<m:{GLOBAL.TeleporterConcept.Hyperlink}>>."

msgid "DIPLOMATICSTATES_DEFINITIONS@TELEPORTERPACT@HYPERLINK"
msgstr "[hyperlink,GLOBAL.TeleporterPactConcept]Teleporter Pact[/hyperlink]"

msgid "DIPLOMATICSTATES_DEFINITIONS@TELEPORTERPACT@NAME"
msgstr "Teleporter Pact"

msgid "DIPLOMATICSTATES_DEFINITIONS@TRADE_MODIFIER@DESCRIPTION"
msgstr "The following modifiers are removed:[br/]{STR_modifiers}[br/]Trading these modifiers will remove them from the relations."

msgid "DIPLOMATICSTATES_DEFINITIONS@TRADE_MODIFIER_DISLIKE@NAME"
msgstr "Overcome Dislikes"

