msgstr "Unit has:[bulletlist][bullet/]The {GLOBAL.PROPERTIES.UMBRAL_DEMON.Hyperlink} unit type.[bullet/]{GLOBAL.PROPERTIES.FLOATING_MOVEMENT.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.FAST_MOVEMENT.Hyperlink}.[bulletlist][br/][br/]Mounted units lose their mounts.[br/][br/]Heroes lose their Mount and Leg equipment slots.[/bulletlist][/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@SKILL3@NAME"
msgstr "Gloom Strider"

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@SKILL4@DESCRIPTION"
msgstr "Create a {GLOBAL.PROPERTIES.TREACHEROUS_REFLECTION.Hyperlink} of target enemy unit.[br/][br/]Cannot target <<m:{GLOBAL.PROPERTIES.HERO.Hyperlink}>>, <<m:{GLOBAL.PROPERTIES.COMBAT_SUMMON.Hyperlink}>>, and <<m:{GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink}>>."

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@SKILL4@NAME"
msgstr "Treacherous Reflection"

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@SKILL4@PROP_DESCRIPTION"
msgstr "A copy of another unit:[bulletlist][bullet/]The reflection dies when the enemy unit dies.[bullet/]The reflection gains the {GLOBAL.PROPERTIES.UMBRAL_DEMON.Hyperlink} unit type.[bullet/]Cannot summon other units.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@SKILL5@DESCRIPTION"
msgstr "Target enemy unit:[bulletlist][bullet/]Loses all <<m:{GLOBAL.PositiveStatusEffectConcept.Hyperlink}>>.[bullet/]If a lost status effect has any {GLOBAL.OpposingStatusEffectsConcept}, then the unit gains a stack of that {GLOBAL.NegativeStatusEffectConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@SKILL5@NAME"
msgstr "Corrupted Boon"

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@SKILL6@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{baseincome} {GLOBAL.ManaConcept.Hyperlink} income[bullet/]{castingpointsbonus} <<m:{GLOBAL.WorldMapCastingPointConcept.Hyperlink}>>[bullet/]{combatcastingpointsbonus} <<m:{GLOBAL.CombatCastingPointConcept.Hyperlink}>>[/bulletlist][br/]At the start of combat in this city's domain: [bulletlist][bullet/] {NumberUnits} enemy units have a base {InsanityPercentage}% chance of suffering {GLOBAL.PROPERTIES.INSANITY} for {NumberTurnsInsanity} <<m:{GLOBAL.TurnConcept.Hyperlink}>>. If unsuccessful, are {GLOBAL.PROPERTIES.STUNNED} for {NumberTurnsStunned} {GLOBAL.TurnConcept.Hyperlink}.[/bulletlist][br/][br/]Can only be built in the {GLOBAL.ThroneCityConcept.Hyperlink}."

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@SKILL6@NAME"
msgstr "Throne of Insidious Whispers"

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@SKILL6@PROPERTY"
msgstr "At the start of combat in this city's domain: [bulletlist][bullet/] {NumberUnits} Enemy units have a base {InsanityPercentage}% chance of suffering {GLOBAL.PROPERTIES.INSANITY} for {NumberTurnsInsanity} <<m:{GLOBAL.TurnConcept.Hyperlink}>>. If unsuccessful, are {GLOBAL.PROPERTIES.STUNNED} for {NumberTurnsStunned} {GLOBAL.TurnConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Become closer to the umbral demons, and punish your enemies with their own strengths."

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@TOME@HERO_SKILL@DESCRIPTION"
msgstr "Base attacks steal {NumberEffects} {GLOBAL.PositiveStatusEffectConcept.Hyperlink} from the target to this unit."

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@TOME@HERO_SKILL@MOD_DESCRIPTION"
msgstr "On hit, attacks steal {NumberEffects} {GLOBAL.PositiveStatusEffectConcept.Hyperlink} from the target to this unit."

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@TOME@HERO_SKILL@NAME"
msgstr "Boon Stealing"

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@TOME@LORE_DESCRIPTION"
msgstr "\"Embrace the corruption within. Those who fear and deny it are blinded, but you, you will see clearly. The gloom of the Abyss shall not frighten, but empower you. Become the mirror that reveals the void in the hearts of the ignorant. Take everything they have and show them Urrath's greatest truth: that there is corruption in everything, and everyone.\""

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@TOME@NAME"
msgstr "Tome of Corruption"

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@UNIT_ABILITY_1@DESCRIPTION"
msgstr "Unleashes a magical bolt at target enemy.[bulletlist][bullet/]Inflicts {WRACK_MORALE_DAMAGE>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}.[bullet/]If target is {GLOBAL.PROPERTIES.ENCHAINED.Hyperlink}, this attack cannot miss.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@UNIT_ABILITY_1@NAME"
msgstr "Wrack"

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@UNIT_ABILITY_2@DESCRIPTION"
msgstr "Target enemy unit has a base {Percentage}% chance of becoming {GLOBAL.PROPERTIES.ENCHAINED.Hyperlink}.[br/][br/]Only one unit can be linked at a time."

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@UNIT_ABILITY_2@NAME"
msgstr "Enchain Mind"

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@UNIT_ABILITY_3@DESCRIPTION"
msgstr "Target linked unit is inflicted with {GLOBAL.PROPERTIES.INSANITY.Hyperlink} for {InsanityTurns} <<m:{GLOBAL.TurnConcept}>>.[br/][br/]Disables {GLOBAL.PROPERTIES.GRATITUDE.Hyperlink} and {GLOBAL.PROPERTIES.SURRENDER.Hyperlink} for this turn."

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@UNIT_ABILITY_3@NAME"
msgstr "Fury"

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@UNIT_ABILITY_4@DESCRIPTION"
msgstr "Target linked unit suffers:[bulletlist][bullet/]{MoralLoss} {GLOBAL.UnitMoraleConcept.Hyperlink}[bullet/]{amount} {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink} for {DefenseTime} <<m:{GLOBAL.TurnConcept}>>[bullet/]{amount} {GLOBAL.PROPERTIES.SUNDERED_RESISTANCE.Hyperlink} for {ResistanceTime} <<m:{GLOBAL.TurnConcept}>>[/bulletlist][br/][br/]Disables {GLOBAL.PROPERTIES.FURY.Hyperlink} and {GLOBAL.PROPERTIES.GRATITUDE.Hyperlink} for this turn."

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@UNIT_ABILITY_4@NAME"
msgstr "Surrender"

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@UNIT_ABILITY_5@DESCRIPTION"
msgstr "[bulletlist][bullet/]Linked unit:[bulletlist][bullet/]Sustains {hitpoints} {GLOBAL.PhysicalDamageConcept.Hyperlink} that ignores {GLOBAL.DefenseConcept.Hyperlink}.[/bulletlist][bullet/]Caster unit:[bulletlist][bullet/]Heals {hitpoints} {GLOBAL.TemporaryHitPointConcept.Hyperlink}.[bullet/]Steals up to {MaxTransfer} <<m:{GLOBAL.PositiveStatusEffectConcept.Hyperlink}>> from linked unit.[/bulletlist][/bulletlist][br/][br/]Disables {GLOBAL.PROPERTIES.FURY.Hyperlink} and {GLOBAL.PROPERTIES.SURRENDER.Hyperlink} for this turn."

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@UNIT_ABILITY_5@NAME"
msgstr "Gratitude"

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@UNIT_ABILITY_6@DESCRIPTION"
msgstr "End the {GLOBAL.PROPERTIES.ENCHAINED_MIND.Hyperlink} link early."

msgid "DLC@ELDRITCHREALMS@TOME_CORRUPTION@UNIT_ABILITY_6@NAME"
msgstr "Unchain Mind"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@DESCRIPTON"
msgstr "This is the Constrictor unit"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@NAME"
msgstr "Constrictor"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Conjure tentacled mutations and creatures from the depths to restrain and constrict your enemies, keeping them right where you want them."

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@HERO_SKILL@DESCRIPTION"
msgstr "Conjure a {GLOBAL.UNITS.TENTACLE_UNIT.Hyperlink} unit on target hex.{LOC.CONCEPT@SUMMON_LIVE_SHARED}"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@HERO_SKILL@NAME"
msgstr "Manifest Tentacle"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@LORE_DESCRIPTION"
msgstr "\"Be inspired by the tentacle and see how the limits of your flesh are mere self-imposed restrictions. Caress, hold, tighten your grip around your followers and adversaries. Enchant your people with the many-armed blessing so they, too, can spread your love. Be cradled in the tentacle's embrace and realize that the only limit to your reach is your own imagination.\""

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@NAME"
msgstr "Tome of the Tentacle"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@SKILL1@DESCRIPTION"
msgstr "A {GLOBAL.PROPERTIES.POLEARM_UNIT.Hyperlink} capable of pulling in and restraining opponents."

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@SKILL1@NAME"
msgstr "Constrictor"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@SKILL1@STATUS_EFFECT_NAME"
msgstr "Constricting"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@SKILL2@DESCRIPTION"
msgstr "Summon an [hyperlink,GLOBAL.PROPERTIES.IMMOBILIZED]Immobile[/hyperlink] {GLOBAL.PROPERTIES.FIGHTER.Hyperlink} with {GLOBAL.PROPERTIES.HYPER_AWARE_UNIT_PASSIVE.Hyperlink}.{LOC.CONCEPT@SUMMON_LIVE_SHARED}"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@SKILL2@NAME"
msgstr "Conjure Tentacle"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@SKILL3@DESCRIPTION"
msgstr "Base {GLOBAL.MagicConcept.Hyperlink} attacks of enchanted units:[bulletlist][bullet/]Deal +{TENTACLES_CONSTRICTING_FOCUS_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}[bullet/]Gain base {CONSTRICTED_RESISTANCE_CHECK>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.CONSTRICTED.Hyperlink} for {CONSTRICTED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Chance increased to {strongerChance}% against {GLOBAL.PROPERTIES.MARKED.Hyperlink} or {GLOBAL.PROPERTIES.SLOWED.Hyperlink} units.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@SKILL3@MODIFIER_DESCRIPTION"
msgstr "[bulletlist][bullet/]Base {CONSTRICTED_RESISTANCE_CHECK>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.CONSTRICTED.Hyperlink} for {duration} {GLOBAL.TurnConcept}.[bullet/]{strongerChance}% chance against {GLOBAL.PROPERTIES.MARKED.Hyperlink} or {GLOBAL.PROPERTIES.SLOWED.Hyperlink} units.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@SKILL3@MODIFIER_DESCRIPTION_SIMPLE"
msgstr "Base {CONSTRICTED_RESISTANCE_CHECK>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.CONSTRICTED.Hyperlink} for {duration} {GLOBAL.TurnConcept}."

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@SKILL3@NAME"
msgstr "Constricting Focus"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@SKILL4@DESCRIPTION"
msgstr "City gains:[bulletlist][bullet/]{goldamount} {GLOBAL.GoldConcept.Hyperlink}[bullet/]{happinessamount} {GLOBAL.CityStabilityConcept.Hyperlink}[bullet/]When besieged, conjure {amountTentacles} {GLOBAL.UNITS.TENTACLE_UNIT.Hyperlink} units adjacent to enemy units at the start of battle.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@SKILL4@NAME"
msgstr "Tendril Labyrinth"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@SKILL4@PROP_DESCRIPTION"
msgstr "{Amount} {GLOBAL.UNITS.TENTACLE_UNIT.Hyperlink} units are summoned next to random enemy units at the start of battle."

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@SKILL4@STRUCTURE_DESCRIPTION"
msgstr "When besieged, conjure {amountTentacles} <<m:{GLOBAL.UNITS.TENTACLE_UNIT.Hyperlink}>> units adjacent to enemy units at the start of battle."

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@SKILL5@DESCRIPTION"
msgstr "Target friendly unit gains {GLOBAL.PROPERTIES.RETALIATING_GROWTHS_PROPERTY_GROUP.Hyperlink} for {RETALIATING_GROWTHS>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@SKILL5@NAME"
msgstr "Retaliating Growths"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@SKILL5@PROPERTY_DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]A base {chance}% chance of inflicting {GLOBAL.PROPERTIES.CONSTRICTED.Hyperlink} for {duration} {GLOBAL.TurnConcept} with its base {GLOBAL.MeleeConcept.Hyperlink} attacks.[bullet/]Unlimited <<m:{GLOBAL.RetaliationConcept.Hyperlink}>>.[bullet/]{GLOBAL.PROPERTIES.HYPER_AWARE_UNIT_PASSIVE.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.DEFENSIVE_MASTERS.Hyperlink}.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Target unit:[bulletlist][bullet/]Sustains damage.[bullet/]Has a base {CONSTRICTOR_PULL_RESISTANCE_CHECK>ResolvedStrength}% chance of:[bulletlist][bullet/]Being pulled to an adjacent space.[bullet/]Becoming {GLOBAL.PROPERTIES.CONSTRICTED.Hyperlink} for {CONSTRICTED_EFFECT_DESCRIPTION>NumTurns} {GLOBAL.TurnConcept}.[/bulletlist][/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@UNIT1@ABILITY1@EFFECT_DESCRIPTION"
msgstr "{CONSTRICTOR_PULL_RESISTANCE_CHECK>ResolvedStrength}% chance of pulling target to an adjacent space and inflicting {GLOBAL.PROPERTIES.CONSTRICTED.Hyperlink}."

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@UNIT1@ABILITY1@EFFECT_PREVIEW"
msgstr "[bulletlist][bullet/]Pulled[bullet/]Constricted {duration}[turn/][/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@UNIT1@ABILITY1@NAME"
msgstr "Pull"

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@UNIT1@DESCRIPTION"
msgstr "A stationary tentacle that constricts nearby targets in its reach."

msgid "DLC@ELDRITCHREALMS@TOME_TENTACLE@TOME@UNIT1@NAME"
msgstr "Tentacle^n"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@HERO_SKILL@DESCRIPTION"
msgstr "While this unit is the leader of the army, units gain:[bulletlist][bullet/]{GLOBAL.PROPERTIES.SHADOW_SICKNESS_IMMUNITY.Hyperlink}[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@HERO_SKILL@NAME"
msgstr "Gloom Shepherd"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@HERO_SKILL@PROPERTY_DESCRIPTION"
msgstr "This unit has:[bulletlist][bullet/]{GLOBAL.PROPERTIES.SHADOW_SICKNESS_IMMUNITY.Hyperlink}.[bullet/][hyperlink,GLOBAL.WorldMapRegeneration]Regenerate[/hyperlink] +{GLOOM_SHEPHERD_HEALTH_REGEN>BONUS>Regen} {GLOBAL.HitPointConcept.Hyperlink} per {GLOBAL.TurnConcept.Hyperlink} on the world map while in Gloom terrain.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@PROVINCE_IMPROVEMENT@DESCRIPTION"
msgstr "[bulletlist][bullet/]{basemanaamount} {GLOBAL.ManaConcept.Hyperlink} income.[bullet/]Every {GLOBAL.TurnConcept.Hyperlink}, {amount} {GLOBAL.ProvinceConcept.Hyperlink} within a radius equal to the City Tier:[bulletlist][bullet/]Gains {GLOBAL.GloomTerrainConcept.Hyperlink}.[bullet/]Loses {GLOBAL.ChasmConcept.Hyperlink}, {GLOBAL.RiverConcept.Hyperlink}, {GLOBAL.SwampConcept.Hyperlink}, {GLOBAL.SandConcept.Hyperlink}, {GLOBAL.SnowConcept.Hyperlink}, {GLOBAL.FrozenWasteConcept.Hyperlink}, and {GLOBAL.AshlandsConcept.Hyperlink}.[/bulletlist][bullet/]Counts as a {GLOBAL.ConduitConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@PROVINCE_IMPROVEMENT@NAME"
msgstr "[conduit/] Altar of Marching Gloom"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@SKILL1@DESCRIPTION"
msgstr "Target {GLOBAL.ProvinceConcept.Hyperlink} and adjacent <<m:{GLOBAL.ProvinceConcept.Hyperlink}>>:[bulletlist][bullet/]Gain {GLOBAL.GloomTerrainConcept.Hyperlink}[bullet/]Lose {GLOBAL.ChasmConcept.Hyperlink}, {GLOBAL.RiverConcept.Hyperlink}, {GLOBAL.SandConcept.Hyperlink}, {GLOBAL.SnowConcept.Hyperlink}, {GLOBAL.FrozenWasteConcept.Hyperlink}, {GLOBAL.AshlandsConcept.Hyperlink}, {GLOBAL.SwampConcept.Hyperlink}, {GLOBAL.CavernFloorConcept.Hyperlink}, and {GLOBAL.DungeonConcept.Hyperlink}.[bullet/]Enemy <<m:{GLOBAL.UnitConcept.Hyperlink}>> suffer {colddamage} {GLOBAL.FrostDamageConcept.Hyperlink} and {blightdamage} {GLOBAL.BlightDamageConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@SKILL1@NAME"
msgstr "Pall of Gloom"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@SKILL2@DESCRIPTION"
msgstr "Create an Umbral Rift in the target Umbral Abyss province, and another nearby on the Surface layer."

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@SKILL2@NAME"
msgstr "Umbral Rift"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@SKILL3@DESCRIPTION"
msgstr "Target unit has a base {UMBRAL_EXILE_RESIST>ResolvedStrength}% chance of:[bulletlist][bullet/]Being immediately removed from combat.[bullet/]Appearing at a random location in the Umbral Abyss after battle.[bullet/]If unsuccessful, inflicts {GLOBAL.PROPERTIES.STUNNED.Hyperlink} for {STUNNED_EFFECT_DESCRIPTION>NumTurns}{GLOBAL.TurnConcept.Name} instead.[/bulletlist][br/][br/]Cannot be used in Water Combat."

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@SKILL3@LOG_MESSAGE"
msgstr "Exiled"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@SKILL3@NAME"
msgstr "Umbral Exile"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@SKILL4@DESCRIPTION"
msgstr "Summons an {GLOBAL.UNITS.UMBRAL_JUGGERNAUT.Hyperlink} on target hex."

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@SKILL4@NAME"
msgstr "Summon Umbral Juggernaut"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@SKILL5@DESCRIPTION"
msgstr "Gives the target race blessings of the Umbral Abyss, granting them:[bulletlist][bullet/]{GLOBAL.PROPERTIES.SHADOW_SICKNESS_IMMUNITY.Hyperlink}[bullet/]While in {GLOBAL.GloomTerrainConcept.Hyperlink} terrain units gain:[bulletlist][bullet/]+{UMBRAL_FLESH_MORALE>MoraleBonus} {GLOBAL.UnitMoraleConcept.Hyperlink}[bullet/]+{GLOOM_SHEPHERD_HEALTH_REGEN>BONUS>Regen} {GLOBAL.HitPointConcept.Hyperlink} per {GLOBAL.TurnConcept.Hyperlink} on the world map.[/bulletlist][bullet/]<<m:{GLOBAL.CityConcept.Hyperlink}>> of the race:[bulletlist][bullet/]Gain +{KnowledgeAmount} {GLOBAL.KnowledgeConcept.Hyperlink} income for each province with Gloom terrain.[bullet/]Ignore {GLOBAL.CityStabilityConcept.Hyperlink} penalties from Gloom terrain.[/bulletlist][bullet/]Hero units gain {GLOBAL.PROPERTIES.GLOOM_SHEPHERD.Hyperlink}.[/bulletlist][br/]This transformation is incompatible with {GLOBAL.SPECIAL_OPERATIONS.PURE_SOUL.Hyperlink}."

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@SKILL5@NAME"
msgstr "Umbral Flesh"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@SKILL5@PROPERTY_DESCRIPTION"
msgstr "This unit has {GLOBAL.PROPERTIES.SHADOW_SICKNESS_IMMUNITY.Hyperlink} and while in {GLOBAL.GloomTerrainConcept.Hyperlink} terrain:[bulletlist][bullet/]+{UMBRAL_FLESH_MORALE>MoraleBonus} {GLOBAL.UnitMoraleConcept.Hyperlink}[bullet/]+{GLOOM_SHEPHERD_HEALTH_REGEN>BONUS>Regen} {GLOBAL.HitPointConcept.Hyperlink} per {GLOBAL.TurnConcept.Hyperlink} on the world map.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@SKILL6@DESCRIPTION"
msgstr "All <<m:{GLOBAL.UnitConcept.Hyperlink}>> in your {GLOBAL.EmpireConcept.Hyperlink} gain {GLOBAL.PROPERTIES.SHADOW_SICKNESS_IMMUNITY.Hyperlink}."

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@SKILL6@NAME"
msgstr "Ritual of the Gloomveil"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@TOME@DESCRIPTION"
msgstr "These boons can be purchased from a {GLOBAL.UmbralDwellingConcept.Hyperlink} by reaching an {GLOBAL.EldritchPactConcept.Hyperlink} with them. They help your Empire adapt to the {GLOBAL.UmbralAbyssConcept.Hyperlink} and spread {GLOBAL.GloomTerrainConcept.Hyperlink}."

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSS@TOME@NAME"
msgstr "Eldritch Pact"

msgid "DLC@ELDRITCHREALMS@TOME_UMBRAL_ABYSSTOME_UMBRAL_ABYSS@SKILL2@NAME"
msgstr "Gloomstrider Transformation"

msgid "DLC@ELDRITCHREALMS@TRAITS_BACKGROUND_CHARACTERS@ELDRITCH01@DESCRIPTION"
msgstr "{GLOBAL.LeaderConcept.Hyperlink} starts with:[bulletlist][bullet/]A {GLOBAL.EQUIPMENT.RELIC_OF_MIND.Hyperlink}, a long range weapon that deals {GLOBAL.PhysicalDamageConcept.Hyperlink} and bypasses enemy defenses.[bullet/]{GLOBAL.PROPERTIES.DELIRIUM.Hyperlink}, an ability that makes a unit vulnerable and uncontrollable.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TRAITS_BACKGROUND_CHARACTERS@ELDRITCH01@NAME"
msgstr "{LOC.INTERFACE@TEXT@CLASS@MAGE} Relic of Mind"

msgid "DLC@ELDRITCHREALMS@TRAITS_BACKGROUND_CHARACTERS@ELDRITCH02@DESCRIPTION"
msgstr "{GLOBAL.LeaderConcept.Hyperlink} starts with:[bulletlist][bullet/]A {GLOBAL.EQUIPMENT.RELIC_OF_FLESH.Hyperlink}, a long range weapon that deals {GLOBAL.BlightDamageConcept.Hyperlink} and inflicts {GLOBAL.PROPERTIES.DECAYING.Hyperlink} and {GLOBAL.PROPERTIES.POISONED.Hyperlink}.[bullet/]{GLOBAL.SKILLS.ELDRITCH_RITUALS.Hyperlink}, a hero skill that grants economic spells costing <<m:{GLOBAL.ThrallConcept.Hyperlink}>>.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TRAITS_BACKGROUND_CHARACTERS@ELDRITCH02@NAME"
msgstr "{LOC.INTERFACE@TEXT@CLASS@RITUALIST} Relic of Flesh"

msgid "DLC@ELDRITCHREALMS@TRAITS_BACKGROUND_CHARACTERS@ELDRITCH03@DESCRIPTION"
msgstr "{GLOBAL.LeaderConcept.Hyperlink} starts with:[bulletlist][bullet/]A {GLOBAL.EQUIPMENT.RELIC_OF_HAVOC.Hyperlink}, a long range weapon that deals {GLOBAL.FireDamageConcept.Hyperlink} and inflicts a random {GLOBAL.NegativeStatusEffectConcept.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.ELDRITCH_PHASE.Hyperlink}, an ability that allows for a swift teleport in combat.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TRAITS_BACKGROUND_CHARACTERS@ELDRITCH03@NAME"
msgstr "{LOC.INTERFACE@TEXT@CLASS@MAGE} Relic of Havoc"

msgid "DLC@ELDRITCHREALMS@TRAITS_BACKGROUND_CHARACTERS@ELDRITCH04@DESCRIPTION"
msgstr "{GLOBAL.LeaderConcept.Hyperlink} starts with:[bulletlist][bullet/]A {GLOBAL.EQUIPMENT.RELIC_OF_THE_COSMOS.Hyperlink}, a long range weapon that deals {GLOBAL.FireDamageConcept.Hyperlink}, {GLOBAL.FrostDamageConcept.Hyperlink}, and {GLOBAL.LightningDamageConcept.Hyperlink}.[bullet/]{GLOBAL.SKILLS.HS_ASTRAL_WISP_RITUAL.Hyperlink}, a skill that enables the summoning of an {GLOBAL.UNITS.ASTRAL_WISP_UNIT.Hyperlink} at the cost of <<m:{GLOBAL.ThrallConcept.Hyperlink}>>.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@TRAITS_BACKGROUND_CHARACTERS@ELDRITCH04@NAME"
msgstr "{LOC.INTERFACE@TEXT@CLASS@MAGE} Relic of the Cosmos"

msgid "DLC@ELDRITCHREALMS@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@ELDRITCH_LORD"
msgstr "Eldritch Sovereign"

msgid "DLC@ELDRITCHREALMS@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@ELDRITCH_LORD@HYPERLINK"
msgstr "[hyperlink,GLOBAL.EldritchSovereignConcept]Eldritch Sovereign[/hyperlink]"

msgid "DLC@ELDRITCHREALMS@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@UMBRAL_TYRANT@HYPERLINK"
msgstr "[hyperlink,GLOBAL.BroodmasterConcept]Broodmaster[/hyperlink]"

msgid "DLC@ELDRITCHREALMS@TRIGGER@TOOLTIP@ABANDONED_CASTLE_UMBRAL_01@AFFINITY_CHOICE_ORDER@FAILURE"
msgstr "Your light cannot pierce the darkness."

msgid "DLC@ELDRITCHREALMS@TRIGGER@TOOLTIP@ABANDONED_CASTLE_UMBRAL_01@AFFINITY_CHOICE_ORDER@HEADER"
msgstr "Strengthen your army's faith against the eldritch onslaught:"

msgid "DLC@ELDRITCHREALMS@TRIGGER@TOOLTIP@ABANDONED_CASTLE_UMBRAL_01@AFFINITY_CHOICE_ORDER@SUCCESS"
msgstr "Your guidance is a beacon for your troops."

msgid "DLC@ELDRITCHREALMS@TRIGGER@TOOLTIP@ABANDONED_CASTLE_UMBRAL_01@AFFINITY_CHOICE_SHADOW@FAILURE"
msgstr "The darkness slips through your grasp."

msgid "DLC@ELDRITCHREALMS@TRIGGER@TOOLTIP@ABANDONED_CASTLE_UMBRAL_01@AFFINITY_CHOICE_SHADOW@HEADER"
msgstr "Empower your army through the shadows:"

msgid "DLC@ELDRITCHREALMS@TRIGGER@TOOLTIP@ABANDONED_CASTLE_UMBRAL_01@AFFINITY_CHOICE_SHADOW@SUCCESS"
msgstr "The shadows strengthen you!"

msgid "DLC@ELDRITCHREALMS@TRIGGER@TOOLTIP@ABANDONED_TOWER_UMBRAL_01@AFFINITY_CHOICE_ASTRAL@FAILURE"
msgstr "You are unable to affect the eldritch magics."

msgid "DLC@ELDRITCHREALMS@TRIGGER@TOOLTIP@ABANDONED_TOWER_UMBRAL_01@AFFINITY_CHOICE_ASTRAL@HEADER"
msgstr "Use the arcane flows to weaken the eldritch being:"

msgid "DLC@ELDRITCHREALMS@TRIGGER@TOOLTIP@ABANDONED_TOWER_UMBRAL_01@AFFINITY_CHOICE_ASTRAL@SUCCESS"
msgstr "The being screams as more energy is siphoned away from it."

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALABYSS@DESCRIPTION"
msgstr "Tutorial on the Umbral Abyss"

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALABYSS@PAGE1@DESCRIPTION"
msgstr "You have entered the {GLOBAL.UmbralAbyssConcept.Hyperlink}! [br/]Great rewards and abundant resources await as you explore and conquer within this {GLOBAL.WorldMapConcept.Hyperlink} Layer."

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALABYSS@PAGE1@INSTRUCTION"
msgstr "The Umbral Abyss is a hostile place, inhabited by powerful <<m:{GLOBAL.PROPERTIES.UMBRAL_DEMON.Hyperlink}>> that mass in locations like Umbral Nest <<m:{GLOBAL.InfestationConcept.Hyperlink}>>. In addition, your <<m:{GLOBAL.ArmyConcept.Hyperlink}>> suffer from {GLOBAL.PROPERTIES.SHADOW_SICKNESS.Hyperlink} while within the Umbral abyss."

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALABYSS@PAGE2@DESCRIPTION"
msgstr "To survive in the Umbral Abyss, you must build <<m:{GLOBAL.SanctuaryOutpostConcept.Hyperlink}>>, which protect your <<m:{GLOBAL.ArmyConcept.Hyperlink}>> from {GLOBAL.PROPERTIES.SHADOW_SICKNESS.Hyperlink}. This will also allow you to annex <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> in the Umbral Abyss."

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALABYSS@PAGE2@INSTRUCTION"
msgstr "<<m:{GLOBAL.SanctuaryOutpostConcept.Hyperlink}>> can only be built on <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> with a {GLOBAL.BeaconOfLightConcept.Hyperlink}. These can be found while exploring the {GLOBAL.UmbralAbyssConcept.Hyperlink} and by defeating Umbral Nest <<m:{GLOBAL.InfestationConcept.Hyperlink}>>.[br/]Sanctuary Outposts cannot be used to found <<m:{GLOBAL.CityConcept.Hyperlink}>>."

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALABYSS@PAGE2@TITLE"
msgstr "Beacons of Light"

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALABYSS@TITLE"
msgstr "The Umbral Abyss"

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALDWELLING@DESCRIPTION"
msgstr "Tutorial on Umbral Dwellings"

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALDWELLING@PAGE1@DESCRIPTION"
msgstr "You have met an {GLOBAL.UmbralDwellingConcept.Hyperlink}! [br/]These <<m:{GLOBAL.DwellingConcept.Hyperlink}>> are teeming with <<m:{GLOBAL.PROPERTIES.UMBRAL_DEMON.Hyperlink}>> and spread {GLOBAL.GloomTerrainConcept.Hyperlink} as they expand throughout the {GLOBAL.UmbralAbyssConcept.Hyperlink} and into the other {GLOBAL.WorldMapConcept.Hyperlink} Layers."

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALDWELLING@PAGE1@INSTRUCTION"
msgstr "Therefore they are a threat that should be destroyed. A destroyed Umbral Dwelling will leave behind a {GLOBAL.BeaconOfLightConcept.Hyperlink}."

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALDWELLING@PAGE2@DESCRIPTION"
msgstr "You can also choose to befriend the {GLOBAL.UmbralDwellingConcept.Hyperlink} in order to gain unique bonuses.[br/]To access these, you must reach an {GLOBAL.EldritchPactConcept.Hyperlink}. This can be done by increasing {GLOBAL.HouseInfluenceConcept.Hyperlink} with the {GLOBAL.UmbralDwellingConcept.Hyperlink}."

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALDWELLING@PAGE2@INSTRUCTION"
msgstr "<<m:{GLOBAL.UmbralDwellingConcept.Hyperlink}>> are always considered {GLOBAL.PROPERTIES.EVIL_3_UNIT_PROPERTY.Hyperlink} and will not accept a {GLOBAL.DiplomaticTokenConcept.Hyperlink}. For [hyperlink,GLOBAL.AlignmentConcept][reputation2/] Evil[/hyperlink] <<m:{GLOBAL.LeaderConcept.Hyperlink}>>, {GLOBAL.HouseInfluenceConcept.Hyperlink} will slowly increase over time.[br/][br/]Fulfilling the Umbral Dwelling's [reputation2/] Evil demands will also increase [allegiance/] Allegiance."

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALDWELLING@PAGE2@TITLE"
msgstr "Offerings or destruction"

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALDWELLING@TITLE"
msgstr "Umbral Dwellings"

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALGATE@DESCRIPTION"
msgstr "Tutorial on Umbral Gates"

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALGATE@PAGE1@DESCRIPTION"
msgstr "You have encountered an Umbral Gate! [br/]Umbral Gates are portals to the {GLOBAL.UmbralAbyssConcept.Hyperlink}, which is a layer on the {GLOBAL.WorldMapConcept.Hyperlink} filled with both bounty and peril."

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALGATE@PAGE1@INSTRUCTION"
msgstr "Umbral Gates are the only way to access the {GLOBAL.UmbralAbyssConcept.Hyperlink} layer. They are spread around on all layers in the {GLOBAL.WorldMapConcept.Hyperlink}.[br/][br/]Within the Umbral Abyss are valuable <<m:{GLOBAL.NodeConcept.Hyperlink}>>, unique <<m:{GLOBAL.PickupConcept.Hyperlink}>>, and exotic <<m:{GLOBAL.VisitSiteConcept.Hyperlink}>>."

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALGATE@PAGE2@DESCRIPTION"
msgstr "Be aware that terrain near Umbral Gates and in the {GLOBAL.UmbralAbyssConcept.Hyperlink} are affected by {GLOBAL.GloomTerrainConcept.Hyperlink}."

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALGATE@PAGE2@GLOOM"
msgstr "Gloom"

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALGATE@PAGE2@INSTRUCTION"
msgstr "<<m:{GLOBAL.UnitConcept.Hyperlink}>> in <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> affected by {GLOBAL.GloomTerrainConcept.Hyperlink} will suffer {GLOBAL.PROPERTIES.SHADOW_SICKNESS.Hyperlink}, [warningred]causing them to lose <<m:{GLOBAL.HitPointConcept.Hyperlink}>> every {GLOBAL.TurnConcept.Hyperlink}[/warningred] and their Vision Range to be reduced.[br/][br/]Damage from Umbral Malady can never reduce a unit below {HPPercentage}% of their Total [hp/] Hit Points."

msgid "DLC@ELDRITCHREALMS@TUTORIAL_WORLD@UMBRALGATE@TITLE"
msgstr "Umbral Gates"

