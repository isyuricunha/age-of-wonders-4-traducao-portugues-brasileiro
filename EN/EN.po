msgid "TOME_AMPLIFICATION@SKILL3@PROPERTY_DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]{GLOBAL.PROPERTIES.FRENZY.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.NEW_LIFE_STEAL.Hyperlink}[/bulletlist]"

msgid "TOME_AMPLIFICATION@SKILL4@DESCRIPTION"
msgstr "Makes magic begin to flow through the veins of the target race, granting them:[bulletlist][bullet/]{GLOBAL.PROPERTIES.ATTUNEMENT_FORTUNE.Hyperlink}, which increases {GLOBAL.CriticalHitChanceConcept.Hyperlink} when spells are cast.[/bulletlist]"

msgid "TOME_AMPLIFICATION@SKILL4@NAME"
msgstr "Astral Blood"

msgid "TOME_AMPLIFICATION@SKILL4@PROPERTY_DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]{GLOBAL.PROPERTIES.ATTUNEMENT_FORTUNE.Hyperlink}.[/bulletlist]"

msgid "TOME_AMPLIFICATION@SKILL5@DESCRIPTION"
msgstr "Target owned city gains:[bulletlist][bullet/]{knowledge} {GLOBAL.KnowledgeConcept.Hyperlink} income[bullet/]{happiness} {GLOBAL.CityStabilityConcept.Hyperlink}[/bulletlist]"

msgid "TOME_AMPLIFICATION@SKILL5@NAME"
msgstr "Amplify Minds"

msgid "TOME_AMPLIFICATION@SKILL6@DESCRIPTION"
msgstr "Makes attacks of enchanted units:[bulletlist][bullet/]Deal +{LIGHTNING_FOCUS_EXTRA_DAMAGE>DAMAGE>Shock} {GLOBAL.LightningDamageConcept.Hyperlink}.[bullet/]Gain base {ELECTRIFIED_RESISTANCE>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.ELECTRIFIED.Hyperlink}, a damage-over-time effect.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_AMPLIFICATION@SKILL6@NAME"
msgstr "Lightning Focus"

msgid "TOME_AMPLIFICATION@SKILL6@PROPERTY_DESCRIPTION"
msgstr "Unit's attacks have:[bulletlist][bullet/]+{LIGHTNING_FOCUS_EXTRA_DAMAGE>DAMAGE>Shock} {GLOBAL.LightningDamageConcept.Hyperlink}.[bullet/]A base {ELECTRIFIED_RESISTANCE>ResolvedStrength}% chance of inflicting {GLOBAL.PROPERTIES.ELECTRIFIED.Hyperlink}.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_AMPLIFICATION@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Enhance your mages and your spellcasting with more advanced arcane magic."

msgid "TOME_AMPLIFICATION@TOME@LORE_AUTHOR"
msgstr "Merlin the Wanderer"

msgid "TOME_AMPLIFICATION@TOME@LORE_DESCRIPTION"
msgstr "\"One of the more fascinating aspects of the arcane is that it can be turned back on itself, augmenting and amplifying its own essence. Any wizard can cast a spell, but a true master seeks to perfect it and elevate themselves and their magic beyond what mere practitioners think possible.\""

msgid "TOME_AMPLIFICATION@TOME@NAME"
msgstr "Tome of Amplification"

msgid "TOME_AMPLIFICATION@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Makes tactical spells deal +{SPELL_AMPLIFICATION_DAMAGE_MULTIPLIER>ResolvedMultiplier}% damage. This does not stack."

msgid "TOME_AMPLIFICATION@UNIT1@ABILITY1@NAME"
msgstr "Spell Amplification"

msgid "TOME_AMPLIFICATION@UNIT1@DESCRIPTION"
msgstr "Stationary tower that shoots enemies and amplifies spell damage."

msgid "TOME_AMPLIFICATION@UNIT1@NAME"
msgstr "Amplification Pylon^n"

msgid "TOME_ANIMISM@UNIT_1@NAME"
msgstr "Spirit Hawk"

msgid "TOME_ARCHDRUID@HERO_SKILL@DESCRIPTION"
msgstr "All friendly <<m:{GLOBAL.PROPERTIES.ANIMAL.Hyperlink}>> and <<m:{GLOBAL.PROPERTIES.PLANT.Hyperlink}>> within {NATURE_AVENGER_UNIT_TARGETER_CIRCLE>AREA>Radius} hexes become {stacks} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}."

msgid "TOME_ARCHDRUID@HERO_SKILL@NAME"
msgstr "Nature's Avenger"

msgid "TOME_ARCHDRUID@PASSIVE@DESCRIPTION"
msgstr "After capturing a {GLOBAL.CityConcept}, you can choose to return it to nature. If you do:[bulletlist][bullet/]The {GLOBAL.CityConcept} will be razed.[bullet/]Every {amount1} out of {amount2} members of the {GLOBAL.CityConcept} {GLOBAL.PopulationConcept} will be evenly distributed throughout your {GLOBAL.EmpireConcept}.[bullet/]The target {GLOBAL.ProvinceConcept} will be transformed into forest.[/bulletlist]"

msgid "TOME_ARCHDRUID@PASSIVE@NAME"
msgstr "Return to Nature"

msgid "TOME_ARCHDRUID@PASSIVE@OPERATION@DESCRIPTION"
msgstr "[bulletlist][bullet/]The {GLOBAL.CityConcept} will be razed.[bullet/]Every {amount1} out of {amount2} members of the {GLOBAL.CityConcept} {GLOBAL.PopulationConcept} will be evenly distributed throughout your {GLOBAL.EmpireConcept}.[bullet/]The target {GLOBAL.ProvinceConcept} will be transformed into forest.[/bulletlist]"

msgid "TOME_ARCHDRUID@PASSIVE@OPERATION_PROGRESS@DESCRIPTION"
msgstr "The city is being returned to nature. Process will complete in {Duration.Turn}."

msgid "TOME_ARCHDRUID@PIERCING_ROOTS@DESCRIPTION"
msgstr "Target enemy unit:[bulletlist][bullet/]Takes {GLOBAL.BlightDamageConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_ARCHDRUID@ROOT_BURST@DESCRIPTION"
msgstr "All adjacent units:[bulletlist][bullet/]Take {GLOBAL.BlightDamageConcept.Hyperlink}.[bullet/]Are [abilityred]Displaced[/abilityred] by {hex} [range/] hex[/bulletlist]"

msgid "TOME_ARCHDRUID@SKILL1@DESCRIPTION"
msgstr "Target non-{GLOBAL.PROPERTIES.HERO.Hyperlink} enemy:[bulletlist][bullet/]Has a base {DEVOLVE_RESISTANCE_CHECK>ResolvedStrength}% chance of being transformed into a random Tier I animal until the end of battle.[bullet/]If resisted, inflicts {GLOBAL.PROPERTIES.STUNNED.Hyperlink} instead.[/bulletlist][br/][br/]{LOC.TACTICAL@ABILITY@NEVER_IN_WATER}"

msgid "TOME_ARCHDRUID@SKILL1@NAME"
msgstr "Devolve"

msgid "TOME_ARCHDRUID@SKILL2@DESCRIPTION"
msgstr "On Target {GLOBAL.ProvinceConcept.Hyperlink}:[bulletlist][bullet/]Enemy units sustain {damageamount} {GLOBAL.BlightDamageConcept.Hyperlink} and suffer {blightResistance} {GLOBAL.BlightResistanceConcept.Hyperlink} for {duration} {GLOBAL.TurnConcept.Hyperlink}.[bullet/]If it contains an enemy {GLOBAL.ProvinceImprovementConcept.Hyperlink}, it becomes [hyperlink,GLOBAL.PillagingConcept]Pillaged[/hyperlink].[bulletlist][bullet/]You are not granted its rewards nor do you lose {GLOBAL.AlignmentConcept.Hyperlink}.[/bulletlist][bullet/]The province gains {GLOBAL.ForestConcept.Hyperlink} if on the Surface or {GLOBAL.MushroomForestConcept.Hyperlink} if in the Underground.[/bulletlist]"

msgid "TOME_ARCHDRUID@SKILL2@NAME"
msgstr "Destructive Regrowth"

msgid "TOME_ARCHDRUID@SKILL2@PROPERTY@DESCRIPTION"
msgstr "Unit has {DESTRUCTIVE_REGROWTH_DEFENSE>REDUCTION>Blight} {GLOBAL.BlightResistanceConcept.Hyperlink}."

msgid "TOME_ARCHDRUID@SKILL3@DESCRIPTION"
msgstr "Summons the Horned God, a Tier V {GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink} with potent summoning abilities."

msgid "TOME_ARCHDRUID@SKILL3@NAME"
msgstr "Summon Horned God"

msgid "TOME_ARCHDRUID@SKILL4@DESCRIPTION"
msgstr "All friendly units in a {AWAKEN_INSTINCTS_CIRCLE_TARGETER>AREA>Radius}-hex radius:[bulletlist][bullet/]Heal +{AWAKEN_INSTINCTS_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Regain all <<m:{GLOBAL.ActionPointConcept.Hyperlink}>>.[bullet/]Become {GLOBAL.PROPERTIES.BERSERK.Hyperlink} for {BERSERK_DESCRIPTION_2>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][br/]Does not affect units with {GLOBAL.ControlLossImmunityConcept.Hyperlink}."

msgid "TOME_ARCHDRUID@SKILL4@NAME"
msgstr "Awaken Instincts"

msgid "TOME_ARCHDRUID@SKILL5@DESCRIPTION"
msgstr "Target {GLOBAL.ProvinceConcept.Hyperlink} with {GLOBAL.ForestConcept.Hyperlink}:[bulletlist][bullet/]Loses {GLOBAL.ForestConcept.Hyperlink}.[bullet/]An {GLOBAL.ArmyConcept.Hyperlink} of <<m:{GLOBAL.PROPERTIES.ANIMAL.Hyperlink}>> and <<m:{GLOBAL.PROPERTIES.PLANT.Hyperlink}>> is summoned under your control.[/bulletlist]"

msgid "TOME_ARCHDRUID@SKILL5@NAME"
msgstr "Awaken the Forest"

msgid "TOME_ARCHDRUID@SKILL5@UNIT_DESCRIPTION"
msgstr "A powerful warden of nature and the personification of its wrath. Capable of summoning and healing."

msgid "TOME_ARCHDRUID@SKILL5@UNIT_NAME"
msgstr "Horned God^n"

msgid "TOME_ARCHDRUID@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Grants powerful spells that unleash the uncontrollable power of nature."

msgid "TOME_ARCHDRUID@TOME@LORE_AUTHOR"
msgstr "Serena, Elven Wizard of Life"

msgid "TOME_ARCHDRUID@TOME@LORE_DESCRIPTION"
msgstr "\"Nature is the leaf upon the wind, the nestling, newborn lamb. It is also the furious tempest rending the land asunder, the mighty maelstrom tearing apart stone and flesh alike. Nature can be cruel, unforgiving... powerful! Harness it and you will command the primal energies that leave lesser beings quaking in terror.\""

msgid "TOME_ARCHDRUID@TOME@NAME"
msgstr "Tome of Nature's Wrath"

msgid "TOME_ARCHDRUID@UNIT1@ABILITY1@JUMP@DESCRIPTION"
msgstr "Heals an allied unit adjacent to the target +{RECLAIMING_BOLT_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>."

msgid "TOME_ARCHDRUID@UNIT1@ABILITY1@JUMP@NAME"
msgstr "Reclaim"

msgid "TOME_ARCHDRUID@UNIT1@ABILITY1@NAME"
msgstr "Reclaiming Bolt"

msgid "TOME_ARCHDRUID@UNIT1@ABILITY2@DESCRIPTION"
msgstr "Within a {WILD_ERUPTION_POSITION_TARGETER_CIRCLE>AREA>Radius}-hex radius:[bulletlist][bullet/]Deals {GLOBAL.PhysicalDamageConcept.Hyperlink} to all units and obstacles.[bullet/]Summons Living Vines onto each unoccupied hex.[/bulletlist]"

msgid "TOME_ARCHDRUID@UNIT1@ABILITY2@NAME"
msgstr "Wild Eruption"

msgid "TOME_ARCHDRUID@UNIT1@ABILITY3@DESCRIPTION"
msgstr "Target {GLOBAL.FloraObstacleConcept.Hyperlink} transforms into a {GLOBAL.UNITS.FLORAL_STINGER.Hyperlink} unit under your control.{LOC.CONCEPT@SUMMON_LIVE_SHARED}"

msgid "TOME_ARCHDRUID@UNIT1@ABILITY3@NAME"
msgstr "Animate Flora"

msgid "TOME_ARCHDRUID@UNIT1@ABILITY4@DESCRIPTION"
msgstr "Friendly {GLOBAL.PROPERTIES.FEY.Hyperlink}, {GLOBAL.PROPERTIES.ANIMAL.Hyperlink}, and {GLOBAL.PROPERTIES.PLANT.Hyperlink} units gain {GLOBAL.PROPERTIES.STALWART.Hyperlink}.[br/][br/]Does not affect Horned Gods."

msgid "TOME_ARCHDRUID@UNIT1@ABILITY4@NAME"
msgstr "Shepherd of the Wilds"

msgid "TOME_ARCHDRUID@VINE_ERUPTION@DESCRIPTION"
msgstr "In target {radius}-hex radius [range/]:[bulletlist][bullet/]Units sustain {GLOBAL.BlightDamageConcept.Hyperlink}.[bullet/]Obstacles sustain double damage.[/bulletlist]"

msgid "TOME_ARCHDRUID@VINE_ERUPTION@NAME"
msgstr "Vine Eruption"

msgid "TOME_ARCH_MAGE@HERO_SKILL@DESCRIPTION"
msgstr "Grants {GLOBAL.MagicConcept.Hyperlink} attacks:[bulletlist][bullet/]+{MAXIMIZED_MAGIC_CRITICAL_CHANCE>ResolvedCritChanceBonus}% {GLOBAL.CriticalHitChanceConcept.Hyperlink}[bullet/]+{MAXIMIZED_MAGIC_ACCURACY_BOOST>ResolvedAccuracyModifier}% {GLOBAL.AccuracyConcept.Hyperlink}[/bulletlist]"

msgid "TOME_ARCH_MAGE@HERO_SKILL@MODIFIER@DESCRIPTION"
msgstr "Grants +{MAXIMIZED_MAGIC_CRITICAL_CHANCE>ResolvedCritChanceBonus}% {GLOBAL.CriticalHitChanceConcept.Hyperlink} and +{amount2}% {GLOBAL.AccuracyConcept.Hyperlink}."

msgid "TOME_ARCH_MAGE@HERO_SKILL@NAME"
msgstr "Maximized Magic"

msgid "TOME_ARCH_MAGE@PASSIVE@DESCRIPTION"
msgstr "When your {GLOBAL.LeaderConcept} enters battle, the unit gains {amount} <<m:{GLOBAL.CombatCastingPointConcept}>> until the end of battle."

msgid "TOME_ARCH_MAGE@PASSIVE@NAME"
msgstr "Master Spellweaver"

msgid "TOME_ARCH_MAGE@SKILL1@DESCRIPTION"
msgstr "Makes your leader teleport to the target world hex."

msgid "TOME_ARCH_MAGE@SKILL1@NAME"
msgstr "Astral Travel"

msgid "TOME_ARCH_MAGE@SKILL2@DESCRIPTION"
msgstr "Target enemy units in a {TIME_STOP_UNIT_TARGETER_CIRCLE>AREA>Radius}-hex radius:[bulletlist][bullet/]Become {GLOBAL.PROPERTIES.STUNNED.Hyperlink} for {STUNNED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Become {GLOBAL.PROPERTIES.DISTRACTED.Hyperlink} for {DISTRACTED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Gain {stacks} {GLOBAL.PROPERTIES.MARKED.Hyperlink} for {MARKED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "TOME_ARCH_MAGE@SKILL2@NAME"
msgstr "Time Stop"

msgid "TOME_ARCH_MAGE@SKILL3@DESCRIPTION"
msgstr "Grants enchanted units:[bulletlist][bullet/]+{COSMIC_OVERDRIVE_DAMAGE_MULTIPLIER>ResolvedMultiplier}% damage.[bullet/]{GLOBAL.PROPERTIES.VERY_FAST_MOVEMENT.Hyperlink}.[/bulletlist]"

msgid "TOME_ARCH_MAGE@SKILL3@NAME"
msgstr "Cosmic Overdrive"

msgid "TOME_ARCH_MAGE@SKILL3@PROPERTY_DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]+{COSMIC_OVERDRIVE_DAMAGE_MULTIPLIER>ResolvedMultiplier}% damage.[bullet/]{GLOBAL.PROPERTIES.VERY_FAST_MOVEMENT.Hyperlink}.[/bulletlist]"

msgid "TOME_ARCH_MAGE@SKILL4@DESCRIPTION"
msgstr "[bulletlist][bullet/]Enemy units have a base {DISRUPTION_RESISTANCE>ResolvedStrength}% chance of becoming {GLOBAL.PROPERTIES.DISRUPTION_TOOLTIP_PROPERTY.Hyperlink} for {DISRUPTION_DISABLE>Duration} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Dispels {DISRUPTION_WAVE_PROPERTY_DISPEL_ENEMIES>NumThingsToDispel} <<m:{GLOBAL.PositiveStatusEffectConcept.Hyperlink}>> from enemies.[bullet/]Dispels {DISRUPTION_WAVE_DISPEL_ALLIES>NumThingsToDispel} <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>> from allies.[/bulletlist]"

msgid "TOME_ARCH_MAGE@SKILL4@NAME"
msgstr "Disruption Wave"

msgid "TOME_ARCH_MAGE@SKILL5@NAME"
msgstr "Age of Astral"

msgid "TOME_ARCH_MAGE@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Reach the pinnacle of the arcane arts by bending space and time to your will."

msgid "TOME_ARCH_MAGE@TOME@LORE_AUTHOR"
msgstr "High Councilor Gabriel, Keeper of Evermore"

msgid "TOME_ARCH_MAGE@TOME@LORE_DESCRIPTION"
msgstr "\"When your capacity to command the arcane reaches its pinnacle, you will find that your connection to the Astral Sea starts to seep through into this realm and affects your own reality. Distance, for example, is a problem for lesser beings. For you, the farthest corner of the world is but a thought away.\""

msgid "TOME_ARCH_MAGE@TOME@NAME"
msgstr "Tome of the Archmage"

msgid "TOME_ARTIFICER@PASSIVE@DESCRIPTION"
msgstr "<<m:{GLOBAL.SiegeProjectConcept}>> are {amount}% cheaper."

msgid "TOME_ARTIFICER@TOME@LORE_AUTHOR"
msgstr "Edward Portsmith, Last Dreadnought of the Commonwealth"

msgid "TOME_ARTIFICER@TOME@LORE_DESCRIPTION"
msgstr "\"Artifice, I like to think, is the ultimate expression of genius made physical. To translate something as intangible as an idea into a working, walking automaton is truly a magnificent thing. When one can turn such creations into behemoths, marrying machine with magic that can level or raise a city... they may veritably claim the title of artificer!\""

msgid "TOME_ARTIFICER@TOME@NAME"
msgstr "Tome of Artificing"

msgid "TOME_ARTIFICING@ABILITY1@DESCRIPTION"
msgstr "This unit ends its turn and goes into a defensive mode:[bulletlist][bullet/]Extends its {GLOBAL.ZoneOfControlConcept.Hyperlink} to all adjacent hexes.[bullet/]Gains +{PROTECTIVE_WALL_DEFENSE_INCREASE>DEF_MOD>Armor} {GLOBAL.DefenseConcept.Hyperlink}.[bullet/]Gains +{PROTECTIVE_WALL_DEFENSE_INCREASE>DEF_MOD>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}.[bullet/]Immune to {GLOBAL.FlankingConcept.Hyperlink}.[bullet/]All adjacent friendly units gain +{SHIELD_DEFENSE_DEFENSE>DEF_MOD>Armor} {GLOBAL.DefenseConcept.Hyperlink}[bullet/]All adjacent friendly units gain +{PROTECTIVE_WALL_STATUS_RESISTANCE>Resistance} {GLOBAL.StatusResistanceConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_ARTIFICING@ABILITY1@HYPERLINK"
msgstr "{GLOBAL.DEFENSES.PROTECTIVE_WALL.Hyperlink}"

msgid "TOME_ARTIFICING@ABILITY1@NAME"
msgstr "Defense Mode: Protective Wall"

msgid "TOME_ARTIFICING@ABILITY1@PROP_NAME"
msgstr "Protective Wall"

msgid "TOME_ARTIFICING@ABILITY2@DESCRIPTION"
msgstr "Deals damage in a {HAIL_OF_BOLTS_UNIT_TARGETER>AREA>Radius}-hex radius."

msgid "TOME_ARTIFICING@ABILITY2@NAME"
msgstr "Great Bolt"

msgid "TOME_ARTIFICING@PASSIVE@NAME"
msgstr "Artisan Engineers"

msgid "TOME_ARTIFICING@SKILL1@DESCRIPTION"
msgstr "[bulletlist]At the start of the battle, gain {amount} {GLOBAL.UNITS.BOLT_REPEATER_UNIT.Hyperlink} units on the attacker's side until the end of battle.[bullet/] <<m:{GLOBAL.UNITS.BOLT_REPEATER_UNIT.Hyperlink}>> are immobile {GLOBAL.PROPERTIES.SIEGECRAFT_UNIT.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> with long range area of effect attacks that are repeating, unlike <<m:{GLOBAL.UNITS.CATAPULT_UNIT.Hyperlink}>>.[bullet/]Only one type of Siegecraft unit can be brought into {GLOBAL.CombatConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_ARTIFICING@SKILL1@NAME"
msgstr "Construct Bolt Repeaters"

msgid "TOME_ARTIFICING@SKILL2@DESCRIPTION"
msgstr "Grants enchanted units:[bulletlist][bullet/]+{ARTISAN_BLADES_CRITICAL_CHANCE>ResolvedCritChanceBonus}% {GLOBAL.CriticalHitChanceConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_ARTIFICING@SKILL2@NAME"
msgstr "Artisan Armaments"

msgid "TOME_ARTIFICING@SKILL2@PROP_DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]+{ARTISAN_BLADES_CRITICAL_CHANCE>ResolvedCritChanceBonus}% {GLOBAL.CriticalHitChanceConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_ARTIFICING@SKILL3@DESCRIPTION"
msgstr "Highly defensive {GLOBAL.PROPERTIES.SHIELD_UNIT.Hyperlink} that is resistant to <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>> and protects allies from them."

msgid "TOME_ARTIFICING@SKILL3@NAME"
msgstr "Iron Golem"

msgid "TOME_ARTIFICING@SKILL4@DESCRIPTION"
msgstr "Grants enchanted units:[bulletlist][bullet/]+{SIEGE_MAGIC_DAMAGE>ResolvedMultiplier}% damage[bullet/]{GLOBAL.PROPERTIES.SIEGE_BREAKER.Hyperlink}, dealing extra fortification damage during a siege.[bullet/]{GLOBAL.PROPERTIES.DEMOLISHER.Hyperlink}, making them able to destroy reinforced obstacles.[/bulletlist]"

msgid "TOME_ARTIFICING@SKILL4@NAME"
msgstr "Siege Magic"

msgid "TOME_ARTIFICING@SKILL4@PROP_DESCRIPTION"
msgstr "Unit has:[bulletlist][bullet/]+{SIEGE_MAGIC_DAMAGE>ResolvedMultiplier}% damage[bullet/]{GLOBAL.PROPERTIES.SIEGE_BREAKER.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.DEMOLISHER.Hyperlink}.[/bulletlist]"

msgid "TOME_ARTIFICING@SKILL5@DESCRIPTION"
msgstr "A {GLOBAL.CityTowerStructureConcept.Hyperlink} that grants the city {GLOBAL.UNITS.BOLT_REPEATER_UNIT.Hyperlink} Towers during siege combat."

msgid "TOME_ARTIFICING@SKILL5@NAME"
msgstr "Artisan Fortification"

