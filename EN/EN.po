msgid "TOME_DOOMHERALD@PASSIVE@NAME"
msgstr "Destiny Fulfilled"

msgid "TOME_ENCHANTMENT @SKILL5@NAME"
msgstr "Awakened Tools"

msgid "TOME_ENCHANTMENT@ABILITY01@DESCRIPTION"
msgstr "Deal damage to units in a {unitsAmount}-hex cone."

msgid "TOME_ENCHANTMENT@ABILITY01@NAME"
