msgid "META_EMPIRE@REALM_SEAL@NAME6"
msgstr "Keya'Manda"

msgid "META_EMPIRE@REALM_SEAL@SUBTITLE"
msgstr "An ancient Krazura land, scattered with mystical Seals of Power. The one who controls the Seals, can claim the realm for themself."

msgid "META_EMPIRE@REALM_SEAL@TEMPLATE_NAME"
msgstr "Seals of Power"

msgid "META_EMPIRE@REALM_SHIRE@NAME_1"
msgstr "Greenshire"

msgid "META_EMPIRE@REALM_SHIRE@NAME_2"
msgstr "Paradise Plains"

msgid "META_EMPIRE@REALM_SHIRE@NAME_3"
msgstr "Idella"

msgid "META_EMPIRE@REALM_SHIRE@SUBTITLE"
msgstr "A realm of lush green, uncorrupted and idyllic, shielded from evil."

msgid "META_EMPIRE@REALM_SHIRE@TEMPLATE_NAME"
msgstr "Fey-blessed Fields"

msgid "META_EMPIRE@REALM_TUTORIAL@DESCRIPTION"
msgstr "The returning Wizard Kings first preyed on small, bountiful and harmonious realms to hone their skills. Will you be a protector or invader of this beautiful domain?"

msgid "META_EMPIRE@REALM_TUTORIAL@NAME_1"
msgstr "Fields of Rebirth"

msgid "META_EMPIRE@REALM_TUTORIAL@SUBTITLE"
msgstr "The returning <<m:{GLOBAL.WizardKingLoreConcept.Hyperlink}>> first preyed on small, bountiful and harmonic realms to hone their skills. Will you be a protector or invader of this beautiful domain?"

msgid "META_EMPIRE@REALM_TUTORIAL@TEMPLATE_NAME"
msgstr "Initiation Realm"

msgid "META_EMPIRE@REALM_TUTORIAL@TRAIT@DESCRIPTION"
msgstr "This realm is more peaceful, but still not without danger.[br/][bulletlist][bullet/]High tier <<m:{GLOBAL.InfestationSpawnerConcept.Hyperlink}>> are [abilityblue]Absent[/abilityblue].[/bulletlist]"

msgid "META_EMPIRE@REALM_TUTORIAL@TRAIT@NAME"
msgstr "Harmonious Lands"

msgid "META_EMPIRE@REALM_YOUNG_REALM@NAME_1"
msgstr "The Vacant Garden"

msgid "META_EMPIRE@REALM_YOUNG_REALM@NAME_2"
msgstr "The Forming Fields"

msgid "META_EMPIRE@REALM_YOUNG_REALM@NAME_3"
msgstr "The Ashen Garden"

msgid "META_EMPIRE@REALM_YOUNG_REALM@NAME_4"
msgstr "The Steppes of Creation"

msgid "META_EMPIRE@REALM_YOUNG_REALM@NAME_5"
msgstr "The Crucible"

msgid "META_EMPIRE@REALM_YOUNG_REALM@SUBTITLE"
msgstr "A primordial realm walked by {GLOBAL.GiantsLoreConcept.Hyperlink}, forming itself before the eyes of any would-be conqueror."

msgid "META_EMPIRE@REALM_YOUNG_REALM@TEMPLATE_NAME"
msgstr "Primordial Realm"

msgid "META_EMPIRE@TRAIT_ARCHON_PROPHET@OBJECTIVE"
msgstr "Archon Prophet Defeated"

msgid "META_EMPIRE@TRAIT_ARCTIC_BLIZZARDS@COMBAT_PROPERTY_DESCRIPTION"
msgstr "At the end of the attacker's {GLOBAL.TurnConcept.Hyperlink}:[bulletlist][bullet/]All non-{GLOBAL.PROPERTIES.FROSTLING_TRANSFORMATION_PROPERTY_GROUP.Hyperlink} units suffer {Frostdamage} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]{frozenchange} base chance of all {GLOBAL.PROPERTIES.WET.Hyperlink} units suffering {GLOBAL.PROPERTIES.FROZEN.Hyperlink}.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_ARCTIC_BLIZZARDS@DESCRIPTION"
msgstr "Freezing blizzards rage over this realm's arctic regions.[bulletlist][bullet/]Arctic <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> are affected by arctic blizzards.[bullet/]All surface combat is affected by {GLOBAL.PROPERTIES.COMBATPROPERTY_ARCTIC_BLIZZARDS.Hyperlink}.[bullet/]<<m:{GLOBAL.UnitConcept.Hyperlink}>> in these provinces suffer {GLOBAL.PROPERTIES.ARCTIC_BLIZZARDS_UNIT_PROPERTY.Hyperlink}.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_ARCTIC_BLIZZARDS@DISPLAY_DESCRIPTION"
msgstr "Units in this {GLOBAL.ProvinceConcept.Hyperlink} suffer:[bulletlist][bullet/]{GLOBAL.PROPERTIES.ARCTIC_BLIZZARDS_UNIT_PROPERTY.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.COMBATPROPERTY_ARCTIC_BLIZZARDS.Hyperlink} in combat[/bulletlist]"

msgid "META_EMPIRE@TRAIT_ARCTIC_BLIZZARDS@NAME"
msgstr "Arctic Blizzards"

msgid "META_EMPIRE@TRAIT_ARCTIC_BLIZZARDS@NAME_COMBAT_EFFECT"
msgstr "Snow Storm"

msgid "META_EMPIRE@TRAIT_ARCTIC_BLIZZARDS@PROPERTY_DESCRIPTION"
msgstr "This unit is in an Arctic Blizzard and subject to the following:[bulletlist][bullet/]This Unit {GLOBAL.PROPERTIES.CANNOT_REGENERATE.Hyperlink}.[bullet/]This Unit suffers {Visionrangereduction} {GLOBAL.VisionRangeConcept.Hyperlink}.[bullet/]This Unit gains {GLOBAL.PROPERTIES.UNIVERSAL_CAMOUFLAGE.Hyperlink}.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_ARTISAN_KINGS@DESCRIPTION"
msgstr "This realm is home to two powerful cities, each an empire in itself, lead by Artisan Kings.[bulletlist][bullet/]The Artisan Kings {ARTISAN_KINGS_INDUSTRIOUS_LEADER_1.Hyperlink} and {ARTISAN_KINGS_HIGH_LEADER_1.Hyperlink} start with massive <<m:{GLOBAL.ThroneCityConcept.Hyperlink}>>.[bullet/]Each Artisan King starts with a nearby {GLOBAL.IndependentCityConcept.Hyperlink} as a {GLOBAL.PvEVassalConcept.Hyperlink}.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_ARTISAN_KINGS@LEADER_1@CUSTOM_TITLE_1"
msgstr "High Conductor"

msgid "META_EMPIRE@TRAIT_ARTISAN_KINGS@LEADER_1@CUSTOM_TITLE_1@GENDER"
msgstr "^m"

msgid "META_EMPIRE@TRAIT_ARTISAN_KINGS@LEADER_1@FIRST_NAME"
msgstr "Qualok^M"

msgid "META_EMPIRE@TRAIT_ARTISAN_KINGS@LEADER_1@LAST_NAME"
msgstr "Many-Marshes^z"

msgid "META_EMPIRE@TRAIT_ARTISAN_KINGS@NAME"
msgstr "Artisan Kings"

msgid "META_EMPIRE@TRAIT_ARTISAN_KINGS@RACE_1@NAME"
msgstr "Qualok's Choir"

msgid "META_EMPIRE@TRAIT_ASTRAL_INVADERS@DESCRIPTION"
msgstr "Astral sea creatures have been drawn to this realm's sources of mana and guard them jealously.[bulletlist][bullet/]{GLOBAL.ManaConcept.Hyperlink} <<m:{GLOBAL.NodeConcept.Hyperlink}>> and <<m:{GLOBAL.PickupConcept.Hyperlink}>> are defended by {GLOBAL.PROPERTIES.ETHEREAL.Hyperlink} {GLOBAL.AstralMonstersLoreConcept.Hyperlink}.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_ASTRAL_INVADERS@NAME"
msgstr "Astral Invaders"

msgid "META_EMPIRE@TRAIT_BANNERLORDS@NAME"
msgstr "Bannerlords"

msgid "META_EMPIRE@TRAIT_BANNERLORDS@TRAIT_DESCRIPTION"
msgstr "This world's Free Cities make powerful allies.[bulletlist][bullet/]{GLOBAL.RequestMilitaryAidConcept.Hyperlink} occur {PaceIncreasePercentage} more often.[bullet/]All <<m:{GLOBAL.EmpireConcept.Hyperlink}>> gain {RecruitPointBonus} <<m:{GLOBAL.RecruitmentPointsConcept.Hyperlink}>>.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_BARREN_OCEANS@DESCRIPTION"
msgstr "Contested landmasses separated by uninhabitable deserts where sandstorms rage.[bulletlist][bullet/]This realm consists of several large landmasses separated by oceans of Uninhabitable Deserts.[bullet/]Each {GLOBAL.EmpireConcept.Hyperlink} shares a landmass with one or two other <<m:{GLOBAL.EmpireConcept.Hyperlink}>>.[bullet/]Uninhabitable Desert <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> are affected by Sandstorms.[bullet/]All surface combat in these <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> are affected by {GLOBAL.PROPERTIES.COMBATPROPERTY_SANDSTORM.Hyperlink} [bullet/]Units in these <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> suffer {GLOBAL.PROPERTIES.SANDSTORMS_UNIT_PROPERTY.Hyperlink}[/bulletlist]"

msgid "META_EMPIRE@TRAIT_BARREN_OCEANS@NAME"
msgstr "Barren Oceans"

msgid "META_EMPIRE@TRAIT_BARREN_PANGEA@DESCRIPTION"
msgstr "This realm is dominated by a single, enormous connected landmass surrounded by uninhabitable Deserts on all sides.[bulletlist][bullet/]This realm consists of a single massive landmass surrounded by uninhabitable Deserts.[bullet/]Mountain/Stalagmites <<m:{GLOBAL.ProvinceFeatureConcept.Hyperlink}>> are [abilityblue]Rare[/abilityblue].[bullet/]Each {GLOBAL.EmpireConcept.Hyperlink} shares a single landmass.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_BARREN_PANGEA@NAME"
msgstr "Barren Pangaea"

msgid "META_EMPIRE@TRAIT_BLOCKED_UNDERGROUND@DESCRIPTION"
msgstr "This realm features a dense earth, resulting in an absence of underground caverns and passages.[bulletlist][bullet/]The {GLOBAL.UndergroundConcept.Hyperlink} is [abilityblue]Absent[abilityblue/].[/bulletlist]"

msgid "META_EMPIRE@TRAIT_BLOCKED_UNDERGROUND@NAME"
msgstr "Blocked Underground"

msgid "META_EMPIRE@TRAIT_CITY_STATES@DESCRIPTION"
msgstr "This realm features unusually powerful free cities, which have grown into city states of their own right with a pride to match.[bulletlist][bullet/]<<m:{GLOBAL.IndependentCityConcept.Hyperlink}>> start with {Bonuspop} {GLOBAL.PopulationConcept.Hyperlink}.[bullet/]{GLOBAL.InfluenceConcept.Hyperlink} is reduced by {ReductionStrength}.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_CITY_STATES@MULTIPLIER_NAME"
msgstr "Independent City State"

msgid "META_EMPIRE@TRAIT_CITY_STATES@NAME"
msgstr "City States"

msgid "META_EMPIRE@TRAIT_COAST_MAP@DESCRIPTION"
msgstr "This realm consists of a single connected landmass next to a small sea.[bulletlist][bullet/]This realm features a single massive landmass.[bullet/]Each {GLOBAL.EmpireConcept.Hyperlink} shares a single landmass.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_COAST_MAP@NAME"
msgstr "Coast"

msgid "META_EMPIRE@TRAIT_CONTINENTS_MAP@DESCRIPTION"
msgstr "This realm is dominated by several large contested landmasses.[bulletlist][bullet/]This realm consists of several large landmasses separated by oceans.[bullet/]Each {GLOBAL.EmpireConcept.Hyperlink} shares a landmass with one or two other <<m:{GLOBAL.EmpireConcept.Hyperlink}>>.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_CONTINENTS_MAP@NAME"
msgstr "Continents"

msgid "META_EMPIRE@TRAIT_CRYSTALLINE_ABUNDANCE@DESCRIPTION"
msgstr "Mana crystals grow more easily on this realm, making them unusually abundant.[bulletlist][bullet/]{GLOBAL.ManaConcept.Hyperlink} <<m:{GLOBAL.NodeConcept.Hyperlink}>>, and <<m:{GLOBAL.PickupConcept.Hyperlink}>> are [abilityblue]abundant[/abilityblue].[/bulletlist]"

msgid "META_EMPIRE@TRAIT_CRYSTALLINE_ABUNDANCE@NAME"
msgstr "Crystalline Abundance"

msgid "META_EMPIRE@TRAIT_CURSE_OF_UNDEATH@DESCRIPTION"
msgstr "The inhabitants of this realm are cursed with a restless death.[bulletlist][bullet/]{GLOBAL.MarauderConcept.Hyperlink} and {GLOBAL.IndependentCityConcept.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> gain {GLOBAL.PROPERTIES.CURSE_OF_UNDEATH.Hyperlink}.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_CURSE_OF_UNDEATH@NAME"
msgstr "Curse of Undeath"

msgid "META_EMPIRE@TRAIT_CURSE_OF_UNDEATH@PROPERTY_DESCRIPTION"
msgstr "When this Unit dies, it is resurrected with {Healthonrespawn} of its maximum {GLOBAL.HitPointConcept.Hyperlink} after {Respawntimer} {GLOBAL.TurnConcept.Hyperlink}."

msgid "META_EMPIRE@TRAIT_DEATHCASTING@DESCRIPTION"
msgstr "Units grant their owner {CastPoints} <<m:{GLOBAL.CombatCastingPointConcept.Hyperlink}>> on death."

msgid "META_EMPIRE@TRAIT_DEATHCASTING@NAME"
msgstr "Deathcasting"

msgid "META_EMPIRE@TRAIT_DEATHCASTING@TRAIT_DESCRIPTION"
msgstr "The mortals of this realm are infused with its magic, releasing it on their deaths.[bulletlist][bullet/]<<m:{GLOBAL.UnitConcept.Hyperlink}>> grant their owner {CastPoints} <<m:{GLOBAL.CombatCastingPointConcept.Hyperlink}>> on death.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_DEMONIC_PRINCE@LEADER_1@FIRST_NAME"
msgstr "Karavar^M"

msgid "META_EMPIRE@TRAIT_DEMONIC_PRINCE@LEADER_1@LAST_NAME"
msgstr "The Willbreaker^z"

msgid "META_EMPIRE@TRAIT_DEMONIC_PRINCE@RACE_3@NAME"
msgstr "Obbadothan Orcs"

msgid "META_EMPIRE@TRAIT_DEMONIC_REALM@DESCRIPTION"
msgstr "Infernal Fiends plague this realm.[bulletlist][bullet/]{GLOBAL.PROPERTIES.INFERNAL_FIEND.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> are [abilityblue]Common[/abilityblue].[/bulletlist]"

msgid "META_EMPIRE@TRAIT_DEMONIC_REALMS@NAME"
msgstr "Demonic Realm"

msgid "META_EMPIRE@TRAIT_DEMON_PRINCE@DESCRIPTION"
msgstr "This realm is dominated by a powerful Demonic Prince of Obbadoth and their minions.[bulletlist][bullet/]The Demonic Prince {DEMONIC_PRINCE_LEADER.Hyperlink} starts with a large {GLOBAL.ThroneCityConcept.Hyperlink}.[bullet/]The Demonic Prince starts with {NumberCities} additional <<m:{GLOBAL.CityConcept.Hyperlink}>>.[bullet/]The Demonic Prince's minions gain {GLOBAL.PROPERTIES.DEMONKIN.Hyperlink} and {GLOBAL.PROPERTIES.SUPERGROWTH_PROPERTY_GROUP.Hyperlink}.[bullet/]Whoever defeats {DEMONIC_PRINCE_LEADER.Hyperlink} is [abilityblue]Victorious[abilityblue/].[/bulletlist]"

msgid "META_EMPIRE@TRAIT_DEMON_PRINCE@LEADER_1@CUSTOM_TITLE_1"
msgstr "Demonic Prince"

msgid "META_EMPIRE@TRAIT_DEMON_PRINCE@LEADER_1@CUSTOM_TITLE_1@GENDER"
msgstr "^m"

msgid "META_EMPIRE@TRAIT_DEMON_PRINCE@NAME"
msgstr "Demon Prince"

msgid "META_EMPIRE@TRAIT_DEMON_PRINCE@OBJECTIVE"
msgstr "Demonic Prince Defeated"

msgid "META_EMPIRE@TRAIT_DEMON_PRINCE@RACE_BIO"
msgstr "Karavar the Willbreaker earned his name through many conquests. Where his brethren might prefer manipulation or subterfuge, Karavar prefers violent domination. War is in his nature, and he engages in it like a bird engages in flight.[br/][br/]The [hyperlink,GLOBAL.ObbadothLoreConcept]Obbadothan[/hyperlink] Orcs are an unusual people, demons of warfare, standing taller than their rivals through fell magic that enhance their strength. They are brutal, if simple people, perfect tools for their Demon Prince’s conquests."

msgid "META_EMPIRE@TRAIT_DESERT_REALM@DESCRIPTION"
msgstr "This World's climate is warm and dry, leaving little for flora to thrive on.[bulletlist][bullet/]Desert <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> are [abilityblue]Common[/abilityblue].[bullet/]Arctic, Highlands, Temperate and Desolate <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> are [abilityblue]Absent[/abilityblue].[bullet/]Forest <<m:{GLOBAL.ProvinceFeatureConcept.Hyperlink}>> are [abilityblue]Rare[/abilityblue].[bullet/]Wetlands <<m:{GLOBAL.ProvinceFeatureConcept.Hyperlink}>> are [abilityblue]Absent[/abilityblue].[/bulletlist]"

msgid "META_EMPIRE@TRAIT_DESERT_REALM@NAME"
msgstr "Desert Realm"

msgid "META_EMPIRE@TRAIT_DISSONANT_ENCHANTMENTS@DESCRIPTION"
msgstr "This realm resists enchantment magic, requiring significantly more mana and effort to be cast and maintained than usual.[bulletlist][bullet/]<<m:{GLOBAL.UnitEnchantmentConcept.Hyperlink}>> cost +{Costincrease}% more to cast.[bullet/]{GLOBAL.UnitUpgradeUpkeepConcept.Hyperlink} is increased by +{UpkeepIncrease}%.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_DISSONANT_ENCHANTMENTS@NAME"
msgstr "Dissonant Enchantments"

msgid "META_EMPIRE@TRAIT_DISTAIN_FOR_EVIL@DESCRIPTION"
msgstr "The people on this realm despise evil and will fight to prevent it from taking root.[bulletlist][bullet/]All <<m:{GLOBAL.EmpireConcept.Hyperlink}>> gain <<m:{GLOBAL.CasusBelliConcept.Hyperlink}>> against <<m:{GLOBAL.EmpireConcept.Hyperlink}>> with Evil {GLOBAL.AlignmentConcept.Hyperlink}.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_DISTAIN_FOR_EVIL@MODIFIER_DESCRIPTION"
msgstr "{STR_leaderName} is Evil."

msgid "META_EMPIRE@TRAIT_DISTRUSTING_LOCALS@DESCRIPTION"
msgstr "The locals do not trust easily, making diplomacy difficult.[bulletlist][bullet/]{GLOBAL.InfluenceConcept.Hyperlink} is reduced by {ReductionStrength}.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_DISTRUSTING_LOCALS@NAME"
msgstr "Distrusting Locals"

msgid "META_EMPIRE@TRAIT_DIVIDE_MAP@DESCRIPTION"
msgstr "A land-dominated realm divided in two by an ocean.[bulletlist][bullet/]This realm consists of two massive landmasses separated by an ocean.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_DIVIDE_MAP@NAME"
msgstr "Divide"

msgid "META_EMPIRE@TRAIT_DOMAIN_OF_MAYHEM@DESCRIPTION"
msgstr "This realm has a maddening influence, seeping into the minds of those that fight in its lands.[bulletlist][bullet/]All {GLOBAL.CombatConcept.Hyperlink} is affected by {GLOBAL.PROPERTIES.DOMAIN_OF_MAYHEM.Hyperlink}.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_DOMAIN_OF_MAYHEM@NAME"
msgstr "Domain of Mayhem"

msgid "META_EMPIRE@TRAIT_DOMAIN_OF_MAYHEM@SPELL@DESCRIPTION"
msgstr "Every {turn} <<m:{GLOBAL.TurnConcept}>> all units have a base {chance}% of being inflicted with {GLOBAL.PROPERTIES.BERSERK.Hyperlink}."

msgid "META_EMPIRE@TRAIT_DRACONIC_HOMELAND@DESCRIPTION"
msgstr "Dragons claim this realm as their hunting grounds, their lairs dominating much of the land, warding off any competition.[bulletlist][bullet/]{GLOBAL.PROPERTIES.DRAGON.Hyperlink} <<m:{GLOBAL.InfestationConcept.Hyperlink}>> are [abilityblue]Common[/abilityblue].[/bulletlist]"

msgid "META_EMPIRE@TRAIT_DRACONIC_HOMELAND@NAME"
msgstr "Dragon Territories"

msgid "META_EMPIRE@TRAIT_DRUIDIC_ALLIANCE@LEADER_1@CUSTOM_TITLE_1"
msgstr "Arch Druid"

msgid "META_EMPIRE@TRAIT_DRUIDIC_ALLIANCE@LEADER_1@CUSTOM_TITLE_1@GENDER"
msgstr "^f"

msgid "META_EMPIRE@TRAIT_DRUIDIC_ALLIANCE@LEADER_1@FIRST_NAME"
msgstr "Myrala^F"

msgid "META_EMPIRE@TRAIT_DRUIDIC_ALLIANCE@LEADER_1@LAST_NAME"
msgstr "The Grovetender"

msgid "META_EMPIRE@TRAIT_DRUIDIC_ALLIANCE@LEADER_2@FIRST_NAME"
msgstr "Kyrma^M"

msgid "META_EMPIRE@TRAIT_DRUIDIC_ALLIANCE@LEADER_2@LAST_NAME"
msgstr "Hunt-Herald"

msgid "META_EMPIRE@TRAIT_DRUIDIC_ALLIANCE@RACE_1@NAME"
msgstr "Grovetender's Chosen"

msgid "META_EMPIRE@TRAIT_DRUIDIC_ALLIANCE@RACE_2@NAME"
msgstr "The First Hunters"

msgid "META_EMPIRE@TRAIT_DRUID_ALLIANCE@DESCRIPTION"
msgstr "This Realm has attracted the interest of two powerful Druids, seeking to guide its growth and protect it from meddlers.[bulletlist][bullet/]The Druids {DRUID_ALLIANCE_LEADER_1.Hyperlink} and {DRUID_ALLIANCE_LEADER_2.Hyperlink} start with powerful Nature Skills.[bullet/]{DRUID_ALLIANCE_LEADER_1.Hyperlink} and {DRUID_ALLIANCE_LEADER_2.Hyperlink} start in an {GLOBAL.DSAllianceConcept.Hyperlink}.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_DRUID_ALLIANCE@NAME"
msgstr "Druidic Alliance"

msgid "META_EMPIRE@TRAIT_EARTH_KING@DESCRIPTION"
msgstr "The Iron Emperor, Ydgaard, has chosen this realm to build a new empire.[bulletlist][bullet/]The Iron Emperor {EARTH_KING_LEADER.Hyperlink} starts with powerful Materium Skills.[bullet/]{EARTH_KING_LEADER.Hyperlink} starts with {NumberCities} additional {GLOBAL.CityConcept.Hyperlink}.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_EARTH_KING@NAME"
msgstr "Iron Emperor"

msgid "META_EMPIRE@TRAIT_ENDLESS_FIELDS_REALM@DESCRIPTION"
msgstr "This realm features mostly rolling green plains, where food is abundant.[bulletlist][bullet/]Temperate <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> are [abilityblue]Common[/abilityblue].[bullet/]Desolate <<m:{GLOBAL.ProvinceFeatureConcept.Hyperlink}>> are [abilityblue]Absent[/abilityblue].[bullet/]Grassland <<m:{GLOBAL.ProvinceFeatureConcept.Hyperlink}>> are [abilityblue]Common[/abilityblue].[bullet/]{GLOBAL.FoodConcept.Hyperlink} <<m:{GLOBAL.NodeConcept.Hyperlink}>> are [abilityblue]Common[/abilityblue].[/bulletlist]"

msgid "META_EMPIRE@TRAIT_ENDLESS_FIELDS_REALM@NAME"
msgstr "Endless Fields"

msgid "META_EMPIRE@TRAIT_ETERNAL_BATTLEGROUND@DESCRIPTION"
msgstr "A realm dominated by violence, where war is the only law.[bulletlist][bullet/]All <<m:{GLOBAL.LeaderConcept.Hyperlink}>> and {GLOBAL.IndependentCityConcept.Hyperlink} lords will declare {GLOBAL.WarConcept.Hyperlink} on each other when they first meet. It is not possible to negotiate {GLOBAL.DSNeutralConcept.Hyperlink}.[bullet/]This does not affect <<m:{GLOBAL.CityConcept.Hyperlink}>> released as [hyperlink,GLOBAL.PactOfVassalageConcept]Vassals[/hyperlink] or remnant <<m:{GLOBAL.CityConcept.Hyperlink}>> of defeated <<m:{GLOBAL.EmpireConcept.Hyperlink}>>.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_ETERNAL_BATTLEGROUND@NAME"
msgstr "Eternal Battleground"

msgid "META_EMPIRE@TRAIT_FEY_INVASION@DESCRIPTION"
msgstr "This realm is affected by the \"Toll of Seasons,\" where mysterious Fey folk emerge from the mists to attack the cities of the unwary.[bulletlist][bullet/]The \"Toll of Seasons\" Happening is guaranteed to occur during the mid game.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_FEY_INVASION@NAME"
msgstr "Toll of Seasons"

msgid "META_EMPIRE@TRAIT_FORMING_REALM@DESCRIPTION"
msgstr "This realm is young and little of it has yet formed from its volcanic crucible. Over time it will become a new realm, chaotic as it may be.[bulletlist][bullet/]The following {GLOBAL.ProvinceFeatureConcept.Hyperlink} is [abilityblue]common[/abilityblue]: {GLOBAL.AshlandsConcept.Hyperlink}.[bullet/] The following Province Features are [abilityblue]absent[/abilityblue]: {GLOBAL.FertilePlainsConcept.Hyperlink}, {GLOBAL.SwampConcept.Hyperlink}, {GLOBAL.SandConcept.Hyperlink}, {GLOBAL.RiverConcept.Hyperlink}, and {GLOBAL.SunlessConcept.Hyperlink}.[bullet/]Each Round, all unowned <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> have a small chance of {GLOBAL.TerraformingConcept.Hyperlink} into having different Province Features.[bullet/]<<m:{GLOBAL.IndependentCityConcept.Hyperlink}>> are [abilityblue]absent[/abilityblue].[/bulletlist]"

msgid "META_EMPIRE@TRAIT_FORMING_REALM@NAME"
msgstr "Forming Realm"

msgid "META_EMPIRE@TRAIT_FROSTLING_INFLUENCE@DESCRIPTION"
msgstr "Frostlings have long since found this world, and none are unaffected by their freezing influence.[bulletlist][bullet/]Independent Units gain {GLOBAL.PROPERTIES.FROSTLING_TRANSFORMATION_PROPERTY_GROUP.Hyperlink}.[bullet/]Independent Units gain {GLOBAL.PROPERTIES.FROST_BLADES_PROPERTY_GROUP.Hyperlink}.[bullet/]Independent Units gain {GLOBAL.PROPERTIES.FROST_ARROWS_PROPERTY_GROUP.Hyperlink}.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_FROSTLING_INFLUENCE@NAME"
msgstr "Frostling Influence"

msgid "META_EMPIRE@TRAIT_FROZEN_REALM@DESCRIPTION"
msgstr "This World's climate is harsh and cold. Frozen plains take the place of lush grasslands.[bulletlist][bullet/]Arctic and Highlands <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> are [abilityblue]Common[/abilityblue].[bullet/]Desert, Desolate, Temperate and Tropical <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> are [abilityblue]Absent[/abilityblue].[/bulletlist]"

msgid "META_EMPIRE@TRAIT_FROZEN_REALM@NAME"
msgstr "Frozen Realm"

msgid "META_EMPIRE@TRAIT_GIGANTISM@DESCRIPTION"
msgstr "The beings of this realm are lower in number but especially large.[bulletlist][bullet/]Racial {GLOBAL.MarauderConcept.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> gain {GLOBAL.PROPERTIES.SUPERGROWTH_PROPERTY_GROUP.Hyperlink}.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_GIGANTISM@NAME"
msgstr "Gigantism"

msgid "META_EMPIRE@TRAIT_GREAT_LAKES_MAP@DESCRIPTION"
msgstr "This Map features several Large Bodies of Water."

msgid "META_EMPIRE@TRAIT_GREAT_LAKES_MAP@NAME"
msgstr "Great Lakes"

msgid "META_EMPIRE@TRAIT_HIGHLANDS@DESCRIPTION"
msgstr "This world features plenty of Highlands and Mountains.[bulletlist][bullet/]Mountains and Highlands <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> are [abilityblue]Common[/abilityblue].[/bulletlist]"

msgid "META_EMPIRE@TRAIT_HIGHLANDS@NAME"
msgstr "Highlands"

msgid "META_EMPIRE@TRAIT_HIGH_MAINTENANCE@DESCRIPTION"
msgstr "Materials on this realm are weak, easily worked with, but hard to maintain.[bulletlist][bullet/]Base {GLOBAL.UnitUpkeepConcept.Hyperlink} is increased by {UpkeepIncrease}.[bullet/]{GLOBAL.UnitConcept.Hyperlink} recruit costs are reduced by {BuildcostReduction}.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_HIGH_MAINTENANCE@NAME"
msgstr "High Maintenance"

msgid "META_EMPIRE@TRAIT_HOSTILE_HOUSES@DESCRIPTION"
msgstr "The houses of this realm are used to treachery and war, taking no chances with outsiders.[bulletlist][bullet/]<<m:{GLOBAL.EmpireConcept.Hyperlink}>> suffer {AllegiancePenalty} {GLOBAL.HouseInfluenceConcept.Hyperlink} and {Relationpenalty} {GLOBAL.IndependentCityRelationConcept.Hyperlink} with each {GLOBAL.IndependentCityConcept.Hyperlink} they meet.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_HOSTILE_HOUSES@NAME"
msgstr "Hostile Houses"

msgid "META_EMPIRE@TRAIT_HOSTILE_OCEANS@COMBAT_PROPERTY_DESCRIPTION"
msgstr "[bulletlist][bullet/]All units are permanently {GLOBAL.PROPERTIES.WET.Hyperlink}[bullet/]At the start of the Defender's turn, up to {HOSTILE_OCEANS_SEA_STORM_COMBAT_AUTO_SPELL>MaxCastCount} random units:[bulletlist][bullet/]Sustain {HOSTILE_OCEANS_SEA_STORM_DAMAGE>DAMAGE>Shock} {GLOBAL.LightningDamageConcept.Hyperlink}.[bullet/]Have a base {ELECTRIFIED_RESISTANCE>ResolvedStrength}% chance of suffering {GLOBAL.PROPERTIES.ELECTRIFIED.Hyperlink} for {ELECTRIFIED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][/bulletlist]"

msgid "META_EMPIRE@TRAIT_HOSTILE_OCEANS@COMBAT_PROPERTY_NAME"
msgstr "Sea Storm"

msgid "META_EMPIRE@TRAIT_HOSTILE_OCEANS@DESCRIPTION"
msgstr "Sea Storms are a permanent feature of this world's seas, making them exceptionally dangerous.[bulletlist][bullet/]Surface water <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> are affected by Sea Storms.[bullet/]Combat in these <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> is affected by {GLOBAL.PROPERTIES.HOSTILE_OCEANS_SEA_STORM_COMBAT_AUTO_SPELL.Hyperlink}.[bullet/]<<m:{GLOBAL.UnitConcept.Hyperlink}>> in these provinces suffer {GLOBAL.PROPERTIES.HOSTILE_OCEANS_UNIT_PROPERTY.Hyperlink}.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_HOSTILE_OCEANS@DISPLAY_DESCRIPTION"
msgstr "Units in this <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> suffer:[bulletlist][bullet/]{GLOBAL.PROPERTIES.HOSTILE_OCEANS_UNIT_PROPERTY.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.HOSTILE_OCEANS_SEA_STORM_COMBAT_AUTO_SPELL.Hyperlink} in combat[/bulletlist][br/]Independent units are not affected."

msgid "META_EMPIRE@TRAIT_HOSTILE_OCEANS@NAME"
msgstr "Hostile Seas"

msgid "META_EMPIRE@TRAIT_HOSTILE_OCEANS@PROPERTY_DESCRIPTION"
msgstr "This unit is in a Sea Storm and subject to the following:[bulletlist][bullet/]This unit {GLOBAL.PROPERTIES.CANNOT_REGENERATE.Hyperlink}.[bullet/]This unit suffers -{REALM_TRAIT_UNIT_PROPERTY_HEALTH_DRAIN>HealthLoss} <<m:{GLOBAL.HitPointConcept.Hyperlink}>> each {GLOBAL.TurnConcept.Hyperlink}.[bullet/]This unit suffers {REALM_TRAIT_UNIT_PROPERTY_STAT_BONUS>BONUS>SightRange} {GLOBAL.VisionRangeConcept.Hyperlink}.[bullet/]This unit gains {GLOBAL.PROPERTIES.UNIVERSAL_CAMOUFLAGE.Hyperlink}.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_ICE_QUEEN@DESCRIPTION"
msgstr "This realm is dominated by a powerful queen of frost and winter.[bulletlist][bullet/]The Frost Queen {ICE_QUEEN_LEADER.Hyperlink} starts with a large {GLOBAL.ThroneCityConcept.Hyperlink}.[bullet/]The Frost Queen starts with {NumberCities} additional <<m:{GLOBAL.CityConcept.Hyperlink}>>.[bullet/]The Frost Queen's minions gain {GLOBAL.PROPERTIES.FROSTLING_TRANSFORMATION_PROPERTY_GROUP.Hyperlink}.[bullet/]Whoever defeats {ICE_QUEEN_LEADER.Hyperlink} is [abilityblue]Victorious[abilityblue/].[/bulletlist]"

msgid "META_EMPIRE@TRAIT_ICE_QUEEN@NAME"
msgstr "Domain of the Frost Queen"

msgid "META_EMPIRE@TRAIT_ICE_QUEEN@OBJECTIVE"
msgstr "Frost Queen Defeated"

msgid "META_EMPIRE@TRAIT_IMMORTALS@DESCRIPTION"
msgstr "This realm's magic wards off death, preventing true death for many.[bulletlist][bullet/]All non-Ruler <<m:{GLOBAL.UnitConcept.Hyperlink}>> gain {GLOBAL.PROPERTIES.IMMORTAL.Hyperlink}.[bullet/][hyperlink.RoutingConcept.HeroConcept]<<Routed>>[/hyperlink] units are never lost.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_IMMORTALS@NAME"
msgstr "Immortals"

msgid "META_EMPIRE@TRAIT_IMMORTALS@PROPERTY_DESCRIPTION"
msgstr "When this unit's total <<m:{GLOBAL.HitPointConcept.Hyperlink}>> reach {HitPointThreshold} or lower, it is immediately [hyperlink.RoutingConcept.HeroConcept]<<Routed>>[/hyperlink]."

msgid "META_EMPIRE@TRAIT_IMMORTALS@PROPERTY_NAME"
msgstr "Immortal"

msgid "META_EMPIRE@TRAIT_IMMORTAL_SPIRITS@DESCRIPTION"
msgstr "This realm features many Ethereal spirits.[bulletlist][bullet/]{GLOBAL.PROPERTIES.ETHEREAL.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> are [abilityblue]Common[/abilityblue].[/bulletlist]"

msgid "META_EMPIRE@TRAIT_IMMORTAL_SPIRITS@NAME"
msgstr "Immortal Spirits"

msgid "META_EMPIRE@TRAIT_INTRIGUE_HAPPENINGS@DESCRIPTION"
msgstr "In this realm, intrigue and skulduggery are rampant.[bulletlist][bullet/]The \"Intrigue\" Happening type has a high chance of occurring during the mid game.[bullet/]A diverse set of Rulers will increase the chance of occurrence.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_INTRIGUE_HAPPENINGS@NAME"
msgstr "Unfolding Mysteries"

msgid "META_EMPIRE@TRAIT_ISLANDS_MAP@DESCRIPTION"
msgstr "This realm is dominated by oceans, but features many small islands.[bulletlist][bullet/]This realm consists of several small landmasses separated by oceans.[bullet/]Each {GLOBAL.EmpireConcept.Hyperlink} has their own landmass.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_ISLANDS_MAP@NAME"
msgstr "Islands"

msgid "META_EMPIRE@TRAIT_LAKES_MAP@DESCRIPTION"
msgstr "Lakes Type B"

msgid "META_EMPIRE@TRAIT_LAKES_MAP@NAME"
msgstr "Lakes"

msgid "META_EMPIRE@TRAIT_LAND_MAP@DESCRIPTION"
msgstr "This realm consists of one large landmass without any large bodies of water.[bulletlist][bullet/]This realm features a single massive landmass.[bullet/]Each {GLOBAL.EmpireConcept.Hyperlink} shares a single landmass.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_LAND_MAP@NAME"
msgstr "Land"

msgid "META_EMPIRE@TRAIT_LAVA_DIVIDE@DESCRIPTION"
msgstr "This realm features primarily land, divided in two by an ocean of lava.[bulletlist][bullet/]This realm consists of two massive landmasses separated by an impassable ocean of lava.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_LAVA_DIVIDE@NAME"
msgstr "Lava Divide"

msgid "META_EMPIRE@TRAIT_LICH_QUEEN@COMBAT_PROPERTY_DESCRIPTION"
msgstr "All non-zombie units summon a {GLOBAL.UNITS.DECAYING_ZOMBIE.Hyperlink} under Melenis' control on death."

msgid "META_EMPIRE@TRAIT_LICH_QUEEN@DESCRIPTION"
msgstr "Dark Lady Melenis holds court on this realm, her assassins keeping the minor houses in line, while the undead legions under her command crush any false claimants.[bulletlist][bullet/]The Lich Queen {LICH_QUEEN_LEADER.Hyperlink} starts with a large {GLOBAL.ThroneCityConcept.Hyperlink}.[bullet/]{LICH_QUEEN_LEADER.Hyperlink} starts with some <<m:{GLOBAL.IndependentCityConcept.Hyperlink}>> as <<m:{GLOBAL.PvEVassalConcept.Hyperlink}>>.[bullet/]Whoever defeats {LICH_QUEEN_LEADER.Hyperlink} is [abilityblue]Victorious[abilityblue/].[/bulletlist]"

msgid "META_EMPIRE@TRAIT_LICH_QUEEN@NAME"
msgstr "Lich Queen"

msgid "META_EMPIRE@TRAIT_LICH_QUEEN@OBJECTIVE"
msgstr "Lich Queen Defeated"

msgid "META_EMPIRE@TRAIT_LICH_QUEEN@PROPERTY_DESCRIPTION"
msgstr "When slain, this unit summons a {GLOBAL.UNITS.DECAYING_ZOMBIE.Hyperlink} for Melenis' side."

msgid "META_EMPIRE@TRAIT_LICH_QUEEN@PROPERTY_NAME"
msgstr "Melenis' Call"

msgid "META_EMPIRE@TRAIT_LIGHTLESS@DESCRIPTION"
msgstr "In this realm, endless banks of fog obscure vision.[bulletlist][bullet/]{GLOBAL.VisionRangeConcept.Hyperlink} of all <<m:{GLOBAL.UnitConcept.Hyperlink}>> is reduced by {visionreduction}.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_LIGHTLESS@NAME"
msgstr "Heavy Fog"

msgid "META_EMPIRE@TRAIT_LINGERING_CREATORS@DESCRIPTION"
msgstr "Giants and demigiants are prevalent on this realm.[bulletlist][bullet/]{GLOBAL.PROPERTIES.GIANT.Hyperlink} and ogre <<m:{GLOBAL.UnitConcept.Hyperlink}>> are [abilityblue]Common[/abilityblue].[/bulletlist]"

msgid "META_EMPIRE@TRAIT_LINGERING_CREATORS@NAME"
msgstr "Lingering Creators"

msgid "META_EMPIRE@TRAIT_LOW_POPULATION@DESCRIPTION"
msgstr "This realm features less civilization than others.[bulletlist][bullet/]<<m:{GLOBAL.IndependentCityConcept.Hyperlink}>> are [abilityblue]Rare[/abilityblue].[/bulletlist]"

msgid "META_EMPIRE@TRAIT_LOW_POPULATION@NAME"
msgstr "Low Population"

msgid "META_EMPIRE@TRAIT_MAGIC_ORIGINS@DESCRIPTION"
msgstr "Astral influence on this realm makes creatures of a magic origin unusually common.[bulletlist][bullet/]<<m:{GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink}>> creatures are [abilityblue]Common[/abilityblue] on this realm.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_MAGIC_ORIGINS@NAME"
msgstr "Magic Origins"

msgid "META_EMPIRE@TRAIT_MASSIVE_UNDERGROUND@DESCRIPTION"
msgstr "This realm has unusually large caverns.[bulletlist][bullet/]The {GLOBAL.UndergroundConcept.Hyperlink} is [abilityblue]bigger[abilityblue/].[/bulletlist]"

msgid "META_EMPIRE@TRAIT_MASSIVE_UNDERGROUND@NAME"
msgstr "Massive Underground"

msgid "META_EMPIRE@TRAIT_MEGACITIES@NAME"
msgstr "Megacities"

msgid "META_EMPIRE@TRAIT_MEGACITIES@TRAIT_DESCRIPTION"
msgstr "This world allows for the construction of immense megacities, yet traditional expansion is impossible.[bulletlist][bullet/]Cannot absorb, migrate or settle new <<m:{GLOBAL.CityConcept.Hyperlink}>>.[bullet/]<<m:{GLOBAL.CityConcept.Hyperlink}>> can perform {GLOBAL.ProvinceAnnexationConcept.Hyperlink} {RangeBonus} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> further away.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_MEGAFAUNA@DESCRIPTION"
msgstr "The beasts of this realm are especially large and ferocious.[bulletlist][bullet/]{GLOBAL.PROPERTIES.ANIMAL.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> are [abilityblue]Common[/abilityblue].[bullet/]{GLOBAL.MarauderConcept.Hyperlink} {GLOBAL.PROPERTIES.ANIMAL.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> gain {GLOBAL.PROPERTIES.EMPOWERED_BEASTS_PROPERTY_GROUP.Hyperlink}.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_MEGAFAUNA@NAME"
msgstr "Megafauna"

msgid "META_EMPIRE@TRAIT_MIGHT_MAKES_RIGHT@DESCRIPTION"
msgstr "The houses of this realm respect strength above all. They will grow more loyal to proven conquerors.[bulletlist][bullet/]Conquering <<m:{GLOBAL.IndependentCityConcept.Hyperlink}>> grants {Allegiancegain} {GLOBAL.HouseInfluenceConcept.Hyperlink} with all other <<m:{GLOBAL.IndependentCityConcept.Hyperlink}>>.[bullet/]<<m:{GLOBAL.PvEVassalConcept.Hyperlink}>> gain {AllegianceGain} Allegiance Levels when first vassalized through conquest.[bullet/]{GLOBAL.InfluenceConcept.Hyperlink} is reduced by {ReductionStrength}.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_MIGHT_MAKES_RIGHT@NAME"
msgstr "Might Makes Right"

msgid "META_EMPIRE@TRAIT_MIGHT_MAKES_RIGHT@PROPERTY_NAME"
msgstr "{GLOBAL.PROPERTIES.MIGHT_MAKES_RIGHT_DUMMY.Hyperlink}"

msgid "META_EMPIRE@TRAIT_NO_FREE_CITIES@DESCRIPTION"
msgstr "This realm is young and unclaimed.[bulletlist][bullet/]<<m:{GLOBAL.IndependentCityConcept.Hyperlink}>> are [abilityblue]Absent[/abilityblue].[/bulletlist]"

msgid "META_EMPIRE@TRAIT_NO_FREE_CITIES@NAME"
msgstr "No Free Cities"

msgid "META_EMPIRE@TRAIT_NO_RESPITE@DESCRIPTION"
msgstr "This realm actively interferes with natural healing.[bulletlist][bullet/]{GLOBAL.EmpireConcept.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> suffer {GLOBAL.PROPERTIES.NO_RESPITE_PROPERTY.Hyperlink}.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_NO_RESPITE@NAME"
msgstr "No Respite"

msgid "META_EMPIRE@TRAIT_NO_RESPITE@PROPERTY_DESCRIPTION"
msgstr "This unit [hyperlink,GLOBAL.WorldMapRegeneration]Regenerates[/hyperlink] {Regenpen} fewer <<m:{GLOBAL.HitPointConcept.Hyperlink}>> per {GLOBAL.TurnConcept.Hyperlink} outside Friendly {GLOBAL.DomainConcept.Hyperlink}."

msgid "META_EMPIRE@TRAIT_NO_UNDERGROUND@DESCRIPTION"
msgstr "This realm has unusually small caverns.[bulletlist][bullet/]The {GLOBAL.UndergroundConcept.Hyperlink} is [abilityblue]smaller[abilityblue/].[/bulletlist]"

msgid "META_EMPIRE@TRAIT_NO_UNDERGROUND@NAME"
msgstr "Small Underground"

msgid "META_EMPIRE@TRAIT_NO_UNDERGROUND_START@DESCRIPTION"
msgstr "This realm has unusually small, unwelcoming caverns.[bulletlist][bullet/]The {GLOBAL.UndergroundConcept.Hyperlink} is [abilityblue]smaller[/abilityblue]. [bullet/]Each {GLOBAL.EmpireConcept} starts aboveground, regardless of adaptation traits.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_NO_UNDERGROUND_START@NAME"
msgstr "Uninhabitable Underground"

msgid "META_EMPIRE@TRAIT_OCEAN_STORMS@DESCRIPTION"
msgstr "Storms rage across the ocean on this realm.[bulletlist][bullet/][abilityred]Ocean Storms[/abilityred] occur in [abilityred]Ocean[/abilityred] sectors.[bullet/]Units in these sectors suffer {Visionpenalty} Vision Range.[bullet/][abilityred]Ocean Storm[/abilityred]: Each turn, 1–3 random units take {Damage} {GLOBAL.LightningDamageConcept.Hyperlink} and each unit on the battlefield becomes {GLOBAL.PROPERTIES.WET.Hyperlink}.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_OCEAN_STORMS@NAME"
msgstr "Ocean Storms"

msgid "META_EMPIRE@TRAIT_OVERGROWN_REALM@DESCRIPTION"
msgstr "A realm where plant life flourishes nearly everywhere.[bulletlist][bullet/]Forest <<m:{GLOBAL.ProvinceFeatureConcept.Hyperlink}>> are [abilityblue]Common[/abilityblue].[bullet/]Desert and Arctic <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> are [abilityblue]Rare[/abilityblue].[bullet/]Desolate <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> are [abilityblue]Absent[/abilityblue].[/bulletlist]"

msgid "META_EMPIRE@TRAIT_OVERGROWN_REALM@NAME"
msgstr "Overgrown Realm"

msgid "META_EMPIRE@TRAIT_PANGEA_MAP@DESCRIPTION"
msgstr "This realm is dominated by a single, enormous connected landmass surrounded by ocean on all sides.[bulletlist][bullet/]This realm consists of a single massive landmass surrounded by oceans.[bullet/]Each {GLOBAL.EmpireConcept.Hyperlink} shares a single landmass.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_PANGEA_MAP@NAME"
msgstr "Pangea"

msgid "META_EMPIRE@TRAIT_PEACEFUL_LANDS@DESCRIPTION"
msgstr "This realm features mostly benevolent spirits and creatures.[bulletlist][bullet/]{GLOBAL.PROPERTIES.FEY.Hyperlink}, {GLOBAL.PROPERTIES.PLANT.Hyperlink} and {GLOBAL.PROPERTIES.ANIMAL.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> are [abilityblue]Common[/abilityblue].[/bulletlist]"

msgid "META_EMPIRE@TRAIT_PEACEFUL_LANDS@NAME"
msgstr "Peaceful Lands"

msgid "META_EMPIRE@TRAIT_PRETENDER_KINGS@DESCRIPTION"
msgstr "The kingdom that once dominated this realm has fallen, and 3 successors lay claim to the throne of this once prosperous kingdom.[bulletlist][bullet/]The Pretender Kings {PRETENDER_KINGS_FEUDAL_LEADER_1.Hyperlink}, {PRETENDER_KINGS_FEUDAL_LEADER_2.Hyperlink} and {PRETENDER_KINGS_DARK_LEADER_1.Hyperlink} start with {AdditionalCities} additional <<m:{GLOBAL.CityConcept.Hyperlink}>>.[bullet/]Each Pretender King starts at {GLOBAL.WarConcept.Hyperlink} with the other Pretender Kings.[bullet/]Whoever forms an alliance with or defeats each Pretender King is [abilityblue]Victorious[abilityblue/].[/bulletlist]"

msgid "META_EMPIRE@TRAIT_PRETENDER_KINGS@LEADER_1@CUSTOM_TITLE_1"
msgstr "Rightful King of Vossin"

msgid "META_EMPIRE@TRAIT_PRETENDER_KINGS@LEADER_1@CUSTOM_TITLE_1@GENDER"
msgstr "^m"

msgid "META_EMPIRE@TRAIT_PRETENDER_KINGS@LEADER_1@CUSTOM_TITLE_2"
msgstr "Warrior King of Vossin"

msgid "META_EMPIRE@TRAIT_PRETENDER_KINGS@LEADER_1@CUSTOM_TITLE_2@GENDER"
msgstr "^m"

msgid "META_EMPIRE@TRAIT_PRETENDER_KINGS@LEADER_1@CUSTOM_TITLE_3"
msgstr "Inheritor King of Vossin"

msgid "META_EMPIRE@TRAIT_PRETENDER_KINGS@LEADER_1@CUSTOM_TITLE_3@GENDER"
msgstr "^m"

msgid "META_EMPIRE@TRAIT_PRETENDER_KINGS@LEADER_1@FIRST_NAME"
msgstr "Darman^M"

msgid "META_EMPIRE@TRAIT_PRETENDER_KINGS@LEADER_1@LAST_NAME"
msgstr "Voss^z"

msgid "META_EMPIRE@TRAIT_PRETENDER_KINGS@LEADER_1@RACE_BIO"
msgstr "Darman Voss is the rightful heir according to many, a weakling not worth following according to others. He refused to act when his brother Skogan split from the Kingdom, further fracturing the kingdom as Jarlan went to extreme measures to reunite it. He is a diplomat at heart, seeking peace at any cost, many would think him weak for this, yet the lives of his subjects are prosperous and stable in spite of the kingdom's fracturing.[br/][br/]His Loyalists are a people of principles, lawful to a fault and eager to serve."

msgid "META_EMPIRE@TRAIT_PRETENDER_KINGS@LEADER_2@FIRST_NAME"
msgstr "Jarlan^M"

msgid "META_EMPIRE@TRAIT_PRETENDER_KINGS@LEADER_2@RACE_BIO"
msgstr "Jarlan Voss, second son of the late king, had no aspiration to rule, but as the kingdom split and his brother refused to take up arms, he took action instead. He was exiled, and now he leads a people seeking the rebirth of Vossin against both his brothers. Jarlan is a warrior through and through, and he vows to not rest until Vossin is whole once more.[br/][br/]Jarlan's Secessionists consist of much of the warrior class of old Vossin. Hardy and dedicated to the cause, they believe in might over diplomatic prattle."

msgid "META_EMPIRE@TRAIT_PRETENDER_KINGS@LEADER_3@FIRST_NAME"
msgstr "Skogan^M"

msgid "META_EMPIRE@TRAIT_PRETENDER_KINGS@LEADER_3@RACE_BIO"
msgstr "Skogan Voss, bastard son of the late king, was shunned by many, but made a name for himself as a powerful healer. He came to lead a faction of devoted healers, but unknown to many he had bigger plans. He would seize his father's kingdom and turn it toward a singular purpose: Ascension. When the time came however, his influence was not as effective as he'd hoped. The secession of the provinces where he held the most sway plunged the kingdom into chaos, now he seeks to reunite the kingdom under his own rule and complete his plan.[br/][br/]Skogan's Fanatics consist of his devout followers, healers, covert agents and ambitious warriors. Each of the Fanatics sees themselves as eventually usurping the position above them, yet direct violence is prohibited, thus schemes and plots are plentiful in their domain."

msgid "META_EMPIRE@TRAIT_PRETENDER_KINGS@NAME"
msgstr "Pretender Kings"

msgid "META_EMPIRE@TRAIT_PRETENDER_KINGS@OBJECTIVE_1"
msgstr "Darman Voss Defeated or Allied"

msgid "META_EMPIRE@TRAIT_PRETENDER_KINGS@OBJECTIVE_2"
msgstr "Jarlan Voss Defeated or Allied"

msgid "META_EMPIRE@TRAIT_PRETENDER_KINGS@OBJECTIVE_3"
msgstr "Skogan Voss Defeated or Allied"

msgid "META_EMPIRE@TRAIT_PRETENDER_KINGS@RACE_1@NAME"
msgstr "Darman's Loyalists"

msgid "META_EMPIRE@TRAIT_PRETENDER_KINGS@RACE_2@NAME"
msgstr "Jarlan's Secessionists"

msgid "META_EMPIRE@TRAIT_PRETENDER_KINGS@RACE_3@NAME"
msgstr "Skogan's Fanatics"

msgid "META_EMPIRE@TRAIT_PROPHET@DESCRIPTION"
msgstr "Claiming to be the chosen of the Archon, a prophet has united the houses of this realm under their banner.[bulletlist][bullet/]The Archon Prophet {PROPHET_LEADER.Hyperlink} starts with a large {GLOBAL.ThroneCityConcept.Hyperlink}.[bullet/]{PROPHET_LEADER.Hyperlink} starts with all <<m:{GLOBAL.IndependentCityConcept.Hyperlink}>> as <<m:{GLOBAL.PvEVassalConcept.Hyperlink}>>.[bullet/]Whoever defeats {PROPHET_LEADER.Hyperlink} is [abilityblue]Victorious[abilityblue/].[/bulletlist]"

msgid "META_EMPIRE@TRAIT_PROPHET@NAME"
msgstr "Archon Prophet"

msgid "META_EMPIRE@TRAIT_QUARTERED_MAP@DESCRIPTION"
msgstr "A land realm split into quarters by oceans.[bulletlist][bullet/]This realm consists of four large landmasses separated by thin oceans.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_QUARTERED_MAP@NAME"
msgstr "Quartered"

msgid "META_EMPIRE@TRAIT_RAMPANT_ENTWINED@DESCRIPTION"
msgstr "Living flora sprawls all over this realm.[bulletlist][bullet/]{GLOBAL.PROPERTIES.PLANT.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> are [abilityblue]Common[/abilityblue].[/bulletlist]"

msgid "META_EMPIRE@TRAIT_RAMPANT_ENTWINED@NAME"
msgstr "Rampant Flora"

msgid "META_EMPIRE@TRAIT_RAMPANT_UNDEATH@DESCRIPTION"
msgstr "The Undead plague this realm.[bulletlist][bullet/]{GLOBAL.PROPERTIES.UNDEAD.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> are [abilityblue]Common[/abilityblue].[/bulletlist]"

msgid "META_EMPIRE@TRAIT_RAMPANT_UNDEATH@NAME"
msgstr "Rampant Undeath"

msgid "META_EMPIRE@TRAIT_REGENERATING_INFESTATION@DESCRIPTION"
msgstr "Beasts and monsters never cease nesting in this realm.[bulletlist][bullet/]<<m:{GLOBAL.InfestationConcept.Hyperlink}>> emerge in unoccupied <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> every {SpawnTurnInterval} <<m:{GLOBAL.TurnConcept.Hyperlink}>>.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_REGENERATING_INFESTATIONS@NAME"
msgstr "Regenerating Infestations"

msgid "META_EMPIRE@TRAIT_RUINED_REALM@DESCRIPTION"
msgstr "This realm has seen brutal conflict in the past.[bulletlist][bullet/]<<m:{GLOBAL.IndependentCityConcept.Hyperlink}>> are [abilityblue]Rare[/abilityblue].[bullet/]<<m:{GLOBAL.CityRuinConcept.Hyperlink}>> are [abilityblue]Common[/abilityblue].[/bulletlist]"

msgid "META_EMPIRE@TRAIT_RUINED_REALM@NAME"
msgstr "Ruined Realm"

msgid "META_EMPIRE@TRAIT_SANDSTORMS@COMBAT_PROPERTY_DESCRIPTION"
msgstr "At the end of the attacker's {GLOBAL.TurnConcept.Hyperlink}:[bulletlist][bullet/]{Blindchance} base chance for units of suffering {GLOBAL.PROPERTIES.BLINDED.Hyperlink}.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_SANDSTORMS@DISPLAY_DESCRIPTION"
msgstr "Units in this {GLOBAL.ProvinceConcept.Hyperlink} suffer:[bulletlist][bullet/]{GLOBAL.PROPERTIES.SANDSTORMS_UNIT_PROPERTY.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.COMBATPROPERTY_SANDSTORM.Hyperlink} in combat[/bulletlist]"

msgid "META_EMPIRE@TRAIT_SANDSTORMS@PROPERTY_NAME"
msgstr "Blinding Sandstorm"

msgid "META_EMPIRE@TRAIT_SANDSTORMS@UNIT_PROPERTY_DESCRIPTION"
msgstr "This unit is in a sandstorm and subject to the following:[bulletlist][bullet/]This unit {GLOBAL.PROPERTIES.CANNOT_REGENERATE.Hyperlink}.[bullet/]This unit suffers {Visionrangereduction} {GLOBAL.VisionRangeConcept.Hyperlink}.[bullet/]This unit gains {GLOBAL.PROPERTIES.UNIVERSAL_CAMOUFLAGE.Hyperlink}[/bulletlist]"

msgid "META_EMPIRE@TRAIT_SCARRED@DESCRIPTION"
msgstr "This realm suffered a great scarring in the past, marking it with death and dividing the land.[bulletlist][bullet/]This realm consists of two massive landmasses separated by an uninhabitable, desolate ocean.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_SCARRED@NAME"
msgstr "Scarred Divide"

msgid "META_EMPIRE@TRAIT_SCORCHED_CLIMATE@DESCRIPTION"
msgstr "This realm's climate is marked by scorching heat.[bulletlist][bullet/]Desolate <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> are [abilityblue]Common[/abilityblue].[bullet/]Arctic, Temperate and Highlands <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> are [abilityblue]Absent[/abilityblue].[/bulletlist]"

msgid "META_EMPIRE@TRAIT_SCORCHED_CLIMATE@NAME"
msgstr "Scorched Climate"

msgid "META_EMPIRE@TRAIT_SCORCHING_CONTINENTS@DESCRIPTION"
msgstr "This realm consists of one large landmass pocked with lakes of lava.[bulletlist][bullet/]This realm features a single massive landmass.[bullet/]This realm features lakes of lava.[bullet/]Each {GLOBAL.EmpireConcept.Hyperlink} shares a single landmass.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_SCORCHING_CONTINENTS@NAME"
msgstr "Lava Lakes"

msgid "META_EMPIRE@TRAIT_SCORCHING_HEAT@DESCRIPTION"
msgstr "The heat in this realm's Deserts and Desolation is as infamous as it is withering.[bulletlist][bullet/]A [abilityred]Scorching Heat[/abilityred] is present in [abilityred]Desert[/abilityred], [abilityred]Desolate[/abilityred], and [abilityred]Lava[/abilityred] provinces.[bullet/]Units in these provinces suffer {FireResist}{GLOBAL.FireResistanceConcept.Hyperlink}, gain {FrostResist}{GLOBAL.FrostResistanceConcept.Hyperlink}, and cannot heal outside of combat.[bullet/][abilityred]Scorching Heat[/abilityred]: each turn during Tactical combat, each unit has a base {burnchance} chance of suffering {GLOBAL.PROPERTIES.BURNING.Hyperlink} for {duration}[turn/] turns.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_SCORCHING_HEAT@NAME"
msgstr "Scorching Heat HIDE"

msgid "META_EMPIRE@TRAIT_SCORCHING_HEAT@PROPERTY_DESCRIPTION"
msgstr "This unit is in a province suffering [abilityred]Scorching Heat[/abilityred] and suffers {FireResist}[firedefense/] while gaining {FrostResist}[frostdefense/]"

msgid "META_EMPIRE@TRAIT_THE_LIBRARIAN@DESCRIPTION"
msgstr "An Astral ruler known only as \"the Librarian\" rules an empire on this realm.[bulletlist][bullet/]The Librarian {THE_LIBRARIAN_LEADER.Hyperlink} starts with powerful Astral Skills.[bullet/]{THE_LIBRARIAN_LEADER.Hyperlink} starts with {NumberCities} additional {GLOBAL.CityConcept.Hyperlink}.[bullet/]{THE_LIBRARIAN_LEADER.Hyperlink} gains accelerated {GLOBAL.ResearchConcept.Hyperlink}.[bullet/]Whoever defeats {THE_LIBRARIAN_LEADER.Hyperlink} is [abilityblue]Victorious[abilityblue/].[/bulletlist]"

msgid "META_EMPIRE@TRAIT_THE_LIBRARIAN@NAME"
msgstr "The Librarian"

msgid "META_EMPIRE@TRAIT_THE_LIBRARIAN@OBJECTIVE"
msgstr "Librarian Defeated"

msgid "META_EMPIRE@TRAIT_THE_WIZARD_KING@NAME"
msgstr "The Wizard King"

msgid "META_EMPIRE@TRAIT_THUNDERSTORMS@DESCRIPTION"
msgstr "Lethal Thunderstorms ravage this realm.[bulletlist][bullet/][abilityred]Thunderstorms[/abilityred] occur during Tactical Combat.[bullet/][abilityred]Thunderstorm[/abilityred]: each turn, 1–3 random units take {Damage} {GLOBAL.LightningDamageConcept.Hyperlink} and each unit on the battlefield suffers {GLOBAL.PROPERTIES.WET.Hyperlink}.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_THUNDERSTORMS@NAME"
msgstr "Thunderstorms"

msgid "META_EMPIRE@TRAIT_TROPICAL_REALM@DESCRIPTION"
msgstr "The realm is a tropical paradise, with golden sands, rolling jungles, and the occasional swamp.[bulletlist][bullet/]Tropical, swamp, and forest <<m:{GLOBAL.ProvinceFeatureConcept.Hyperlink}>> are [abilityblue]Common[/abilityblue].[bullet/]Arctic, desert, and desolate <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> are [abilityblue]Rare[/abilityblue].[bullet/]Blossom Orchard <<m:{GLOBAL.NodeConcept.Hyperlink}>> and Prestigious Statue <<m:{GLOBAL.PickupConcept.Hyperlink}>> are [abilityblue]Abundant.[/abilityblue][/bulletlist]"

msgid "META_EMPIRE@TRAIT_TROPICAL_REALM@NAME"
msgstr "Tropical Realm"

msgid "META_EMPIRE@TRAIT_UNBOUND_TOMES@DESCRIPTION"
msgstr "The affinities blur and blend on this realm, allowing access to tomes otherwise restricted.[bulletlist][bullet/]<<m:{GLOBAL.TomeConcept.Hyperlink}>> have no {GLOBAL.AffinityConcept.Hyperlink} requirements.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_UNBOUND_TOMES@NAME"
msgstr "Unbound Tomes"

msgid "META_EMPIRE@TRAIT_UNDERGROUND_START@DESCRIPTION"
msgstr "Civilization only thrives underground on this realm, forcing the throne cities of each empire underground.[bulletlist][bullet/]Each {GLOBAL.EmpireConcept} starts {GLOBAL.UndergroundConcept.Hyperlink}, regardless of any adaptation traits.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_UNDERGROUND_START@NAME"
msgstr "Underground Start"

msgid "META_EMPIRE@TRAIT_UNLIMITED_POWER@DESCRIPTION"
msgstr "This realm is awash with Astral power, and spells flow freely without limit, though they require more mana to channel.[bulletlist][bullet/]Can now cast multiple <<m:{GLOBAL.CombatSpellConcept.Hyperlink}>> per {GLOBAL.TurnConcept.Hyperlink}.[bullet/]<<m:{GLOBAL.CombatSpellConcept.Hyperlink}>> cost {Manacost} more {GLOBAL.ManaConcept.Hyperlink} to cast.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_UNLIMITED_POWER@NAME"
msgstr "Unlimited Power"

msgid "META_EMPIRE@TRAIT_VOID_DIVIDE_MAP@DESCRIPTION"
msgstr "A land-dominated realm divided in two by an impassible void.[bulletlist][bullet/]This realm consists of two massive landmasses separated by Astral Void.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_VOID_DIVIDE_MAP@NAME"
msgstr "Void Divide"

msgid "META_EMPIRE@TRAIT_VOID_OCEANS@DESCRIPTION"
msgstr "This realm is crumbling into the Astral Void."

msgid "META_EMPIRE@TRAIT_VOID_OCEANS@NAME"
msgstr "Void Oceans"

msgid "META_EMPIRE@TRAIT_VOID_PANGEA@DESCRIPTION"
msgstr "This realm is dominated by a single, enormous connected landmass surrounded by Astral Void on all sides.[bulletlist][bullet/]This realm consists of a single massive landmass surrounded by impassable Astral Void.[bullet/]Each {GLOBAL.EmpireConcept.Hyperlink} shares a single landmass.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_VOID_PANGEA@NAME"
msgstr "Void Pangea"

msgid "META_EMPIRE@TRAIT_VOID_POCKETS@DESCRIPTION"
msgstr "This realm consists one large landmass pocked with impassible void.[bulletlist][bullet/]This realm features a single massive landmass.[bullet/]This realm features lakes of Astral Void.[bullet/]Each {GLOBAL.EmpireConcept.Hyperlink} shares a single landmass.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_VOID_POCKETS@NAME"
msgstr "Void Pockets"

msgid "META_EMPIRE@TRAIT_VOLCANIC_ERUPTIONS@COMBAT_PROPERTY_DESCRIPTION"
msgstr "Every {timer} {GLOBAL.TurnConcept.Hyperlink}, a marker is placed. Then, after {expiretimer} [turn/] the ground will erupt and units within {range} [range/] of the marker will suffer {damagephysical} {GLOBAL.PhysicalDamageConcept.Hyperlink} and {damagefire} {GLOBAL.FireDamageConcept.Hyperlink}. Random affected hexes will gain {GLOBAL.OnFireConcept.Hyperlink}."

msgid "META_EMPIRE@TRAIT_VOLCANIC_ERUPTIONS@DESCRIPTION"
msgstr "Volcanic activity rages beneath this realm's desolate regions.[bulletlist][bullet/]All surface combat in desolate <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> is affected by {GLOBAL.PROPERTIES.COMBATPROPERTY_VOLCANIC_ERUPTION.Hyperlink}.[bullet/]Units in desolate <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> suffer {GLOBAL.PROPERTIES.VOLCANIC_HEAT_UNIT_PROPERTY.Hyperlink}.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_VOLCANIC_ERUPTIONS@DISPLAY_DESCRIPTION"
msgstr "Units in this {GLOBAL.ProvinceConcept.Hyperlink} suffer:[bulletlist][bullet/]{GLOBAL.PROPERTIES.VOLCANIC_HEAT_UNIT_PROPERTY.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.COMBATPROPERTY_VOLCANIC_ERUPTION.Hyperlink} in combat[/bulletlist]"

msgid "META_EMPIRE@TRAIT_VOLCANIC_ERUPTIONS@MARKER_DESCRIPTION"
msgstr "When this expires, the ground will erupt and units within {range} [range/] will suffer {damagephysical} {GLOBAL.PhysicalDamageConcept.Hyperlink} and {damagefire} {GLOBAL.FireDamageConcept.Hyperlink}. The target hexes will gain {GLOBAL.OnFireConcept.Hyperlink}."

msgid "META_EMPIRE@TRAIT_VOLCANIC_ERUPTIONS@NAME"
msgstr "Volcanic Eruptions"

msgid "META_EMPIRE@TRAIT_VOLCANIC_ERUPTIONS@UNIT_PROPERTY_DESCRIPTION"
msgstr "This unit is in a province affected by volcanic activity and subject to the following:[bulletlist][bullet/]This unit {GLOBAL.PROPERTIES.CANNOT_REGENERATE.Hyperlink}.[bullet/]This unit suffers {FireRestistanceReduction} {GLOBAL.FireResistanceConcept.Hyperlink}, but gains {FrostResistanceIncrease} {GLOBAL.FrostResistanceConcept.Hyperlink}.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_VOLCANIC_ERUPTIONS@UNIT_PROPERTY_NAME"
msgstr "Volcanic Heat"

msgid "META_EMPIRE@TRAIT_WARPED_LAND@DESCRIPTION"
msgstr "This realm is in an unnatural state of flux, warping and transforming constantly.[bulletlist][bullet/]Each strategic {GLOBAL.TurnConcept.Hyperlink}, all unowned surface provinces have a small chance of transforming their {GLOBAL.ProvinceFeatureConcept.Hyperlink} to new ones.[/bulletlist]"

msgid "META_EMPIRE@TRAIT_WARPED_LAND@NAME"
msgstr "Warping Wilds"

msgid "META_EMPIRE@TRAIT_WILDLANDS@DESCRIPTION"
msgstr "Wild animals are common on this realm, replacing all other infestations and Ancient Wonders.[bulletlist][bullet/]{GLOBAL.PROPERTIES.ANIMAL.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> are [abilityblue]Common[/abilityblue].[bullet/]{GLOBAL.PROPERTIES.ANIMAL.Hyperlink} <<m:{GLOBAL.InfestationConcept.Hyperlink}>> are [abilityblue]Common[/abilityblue].[bullet/]Constructed <<m:{GLOBAL.AncientWonderConcept.Hyperlink}>> such as Ziggurats are [abilityblue]Rare[/abilityblue].[/bulletlist]"

msgid "META_EMPIRE@TRAIT_WILDLANDS@NAME"
msgstr "Wildlands"

msgid "META_EMPIRE@TRAIT_WONDEROUS_PAST@DESCRIPTION"
msgstr "Due to the rich past of this realm, there are many Ancient Wonders present.[bulletlist][bullet/]<<m:{GLOBAL.AncientWonderConcept.Hyperlink}>> are [abilityblue]Common[abilityblue/].[/bulletlist]"

msgid "META_EMPIRE@TRAIT_WONDEROUS_PAST@NAME"
msgstr "Wondrous Past"

msgid "META_EMPIRE@UNKNOWN_REALM@NAME1"
msgstr "Enigmus"

msgid "META_EMPIRE@UNKNOWN_REALM@NAME2"
msgstr "Mystera"

msgid "META_EMPIRE@UNKNOWN_REALM@NAME3"
msgstr "Capricia"

msgid "META_EMPIRE@UNKNOWN_REALM@NAME4"
msgstr "Randomora"

msgid "META_EMPIRE@UNKNOWN_REALM@NAME5"
msgstr "Obscuron"

msgid "META_EMPIRE@UNKNOWN_REALM@NAME6"
msgstr "Anomala"

msgid "META_EMPIRE@WORLD_CONTENT@COSMIC_HAPPENINGS@DESCRIPTION"
msgstr "This realm is shaken by cosmic events, from altered Astral Flows to misaligned stars."

msgid "META_EMPIRE@WORLD_CONTENT@COSMIC_HAPPENINGS@NAME"
msgstr "Cosmic Happenings"

msgid "META_EMPIRE@WORLD_CONTENT@FEY_INVASION@DESCRIPTION"
msgstr "This realm is affected by the \"Toll of Seasons,\" where mysterious Fey folk emerge from the mists to attack the cities of the unwary."

msgid "META_EMPIRE@WORLD_CONTENT@FEY_INVASION@NAME"
msgstr "Toll of Seasons"

msgid "META_EMPIRE@WORLD_CONTENT@INTRIGUE_HAPPENINGS@DESCRIPTION"
msgstr "In this realm, intrigue and skulduggery are rampant. A diverse set of Rulers will increase the chance of occurrence."

msgid "META_EMPIRE@WORLD_CONTENT@INTRIGUE_HAPPENINGS@NAME"
msgstr "Intrigue Happenings"

msgid "META_EMPIRE@WORLD_CONTENT@LOST_SOULS@DESCRIPTION"
msgstr "Lost souls wander this realm. Either cursed or driven by unfinished business, they seek help."

msgid "META_EMPIRE@WORLD_CONTENT@LOST_SOULS@NAME"
msgstr "Lost Souls"

msgid "META_EMPIRE@WORLD_CONTENT@OPTION@AUTOMATIC@DESCRIPTION"
msgstr "The content can appear in this realm."

msgid "META_EMPIRE@WORLD_CONTENT@OPTION@AUTOMATIC@NAME"
msgstr "Automatic"

msgid "META_EMPIRE@WORLD_CONTENT@OPTION@NEVER@DESCRIPTION"
msgstr "The content will be blocked in this realm."

msgid "META_EMPIRE@WORLD_CONTENT@OPTION@NEVER@NAME"
msgstr "Never"

msgid "META_EMPIRE@WORLD_CONTENT@OPTION@PRIORITIZED@DESCRIPTION"
msgstr "The content will be prioritized, giving it a much higher chance of appearing in this realm."

msgid "META_EMPIRE@WORLD_CONTENT@OPTION@PRIORITIZED@NAME"
msgstr "Prioritized"

msgid "META_EMPIRE@WORLD_CONTENT@WANDERING_MERCHANTS@DESCRIPTION"
msgstr "The roads of this realm are often traveled by Wandering Merchants, offering exotic mounts, valuable information, and even the services of a martial trainer."

msgid "META_EMPIRE@WORLD_CONTENT@WANDERING_MERCHANTS@NAME"
msgstr "Wandering Merchants"

msgid "MINOR_FACTION@UPGRADE_SET@ASTRAL_FOLLOWER@DESCRIPTION"
msgstr "These people are Followers of Astral. They have begun to unravel the mysteries of the arcane. They use creatures from the Astral Sea and devices to empower their spellcasting."

msgid "MINOR_FACTION@UPGRADE_SET@ASTRAL_FOLLOWER@NAME"
msgstr "Followers of Astral"

msgid "MINOR_FACTION@UPGRADE_SET@ASTRAL_INITIATE@DESCRIPTION"
msgstr "These people are Initiates of Astral. They have learned to use basic spells and enchantments to bolster their armies."

msgid "MINOR_FACTION@UPGRADE_SET@ASTRAL_INITIATE@NAME"
msgstr "Initiates of Astral"

msgid "MINOR_FACTION@UPGRADE_SET@ASTRAL_MASTER@DESCRIPTION"
msgstr "These people are Masters of Astral. They have discovered the secrets of the cosmos. They can manipulate time and space and use advanced spells to manipulate the flow of magic."

msgid "MINOR_FACTION@UPGRADE_SET@ASTRAL_MASTER@NAME"
msgstr "Masters of Astral"

msgid "MINOR_FACTION@UPGRADE_SET@BEAST_MASTER@DESCRIPTION"
msgstr "These are the Masters of Beasts. They have formed a strong connection with the animals of the world, and most of their residents are powerful and ferocious beasts."

msgid "MINOR_FACTION@UPGRADE_SET@BEAST_MASTER@NAME"
msgstr "Masters of Beasts"

msgid "MINOR_FACTION@UPGRADE_SET@CHAOS_FOLLOWER@DESCRIPTION"
msgstr "These people are Followers of Chaos. They commune with mischievous demons and seek the greatest pleasures in life and on the battlefield."

msgid "MINOR_FACTION@UPGRADE_SET@CHAOS_FOLLOWER@NAME"
msgstr "Followers of Chaos"

msgid "MINOR_FACTION@UPGRADE_SET@CHAOS_INITIATE@DESCRIPTION"
msgstr "These people are Initiates of Chaos. They wield uncontrollable fire and aim to subjugate their enemies."

msgid "MINOR_FACTION@UPGRADE_SET@CHAOS_INITIATE@NAME"
msgstr "Initiates of Chaos"

msgid "MINOR_FACTION@UPGRADE_SET@CHAOS_MASTER@DESCRIPTION"
msgstr "These people are Masters of Chaos. They call on demonic powers to serve them and practice vile magic that breaks the minds of men and beast alike."

msgid "MINOR_FACTION@UPGRADE_SET@CHAOS_MASTER@NAME"
msgstr "Masters of Chaos"

msgid "MINOR_FACTION@UPGRADE_SET@CREATION_MASTER@DESCRIPTION"
msgstr "These are the Masters of Creation, Giants and their cousins who helped shape the world and have a strong connection to the earth."

msgid "MINOR_FACTION@UPGRADE_SET@CREATION_MASTER@NAME"
msgstr "Masters of Creation"

msgid "MINOR_FACTION@UPGRADE_SET@CULTURE_FEUDAL@NAME"
msgstr "Feudal City"

msgid "MINOR_FACTION@UPGRADE_SET@DEMON_MASTER@DESCRIPTION"
msgstr "These are the Masters of Demons. They bend demons to their will and call upon cruel infernal powers to fulfill their desires."

msgid "MINOR_FACTION@UPGRADE_SET@DEMON_MASTER@NAME"
msgstr "Masters of Demons"

msgid "MINOR_FACTION@UPGRADE_SET@ETHEREAL_MASTER@DESCRIPTION"
msgstr "These are the Masters of the Ethereal. They see the world differently than most, peering into a realm beyond, where the living, dead, and otherworldly beings mingle."

msgid "MINOR_FACTION@UPGRADE_SET@ETHEREAL_MASTER@NAME"
msgstr "Masters of the Ethereal"

msgid "MINOR_FACTION@UPGRADE_SET@FLORA_MASTER@DESCRIPTION"
msgstr "These are the Masters of Flora. They have become of one mind with the trees and their spreading roots. Entire forests come to life to protect the lands of these people."

msgid "MINOR_FACTION@UPGRADE_SET@FLORA_MASTER@NAME"
msgstr "Masters of Flora"

msgid "MINOR_FACTION@UPGRADE_SET@FROST_MASTER@DESCRIPTION"
msgstr "These are the Masters of Frost. They thrive in the cold where others would freeze to death. They have mastery over frost magic, and among them are many creature of the cold."

msgid "MINOR_FACTION@UPGRADE_SET@FROST_MASTER@NAME"
msgstr "Masters of Frost"

msgid "MINOR_FACTION@UPGRADE_SET@MATERIUM_FOLLOWER@DESCRIPTION"
msgstr "These people are Followers of Materium. They create wondrous buildings and use their magical control of the physical forces of the world to enhance their equipment and manipulate the world."

msgid "MINOR_FACTION@UPGRADE_SET@MATERIUM_FOLLOWER@NAME"
msgstr "Followers of Materium"

msgid "MINOR_FACTION@UPGRADE_SET@MATERIUM_INITIATE@DESCRIPTION"
msgstr "These people are Initiates of Materium. They craft warriors to fight for them and imbue their weapons and armor with magical enchantments."

msgid "MINOR_FACTION@UPGRADE_SET@MATERIUM_INITIATE@NAME"
msgstr "Initiates of Materium"

msgid "MINOR_FACTION@UPGRADE_SET@MATERIUM_MASTER@DESCRIPTION"
msgstr "These people are Masters of Materium. They value material wealth above all else. They can transmute the physical world to their liking, from creating gold for their own to boiling magma for their enemies."

msgid "MINOR_FACTION@UPGRADE_SET@MATERIUM_MASTER@NAME"
msgstr "Masters of Materium"

msgid "MINOR_FACTION@UPGRADE_SET@NATURE_FOLLOWER@DESCRIPTION"
msgstr "These people are Followers of Nature. They are able to control the forests and fields and borrow the aid of magical forest creatures."

msgid "MINOR_FACTION@UPGRADE_SET@NATURE_FOLLOWER@NAME"
msgstr "Followers of Nature"

msgid "MINOR_FACTION@UPGRADE_SET@NATURE_INITIATE@DESCRIPTION"
msgstr "These people are Initiates of Nature. They learned to work and live together with the animals and plants of Mother Nature."

msgid "MINOR_FACTION@UPGRADE_SET@NATURE_INITIATE@NAME"
msgstr "Initiates of Nature"

msgid "MINOR_FACTION@UPGRADE_SET@NATURE_MASTER@DESCRIPTION"
msgstr "Being Masters of Nature, the roots of {City} run deep through the nearby forests. It is said that once per year the citizens leave their homes and travel the realm, tending to the life of the forests as a form of pilgrimage."

msgid "MINOR_FACTION@UPGRADE_SET@NATURE_MASTER@NAME"
msgstr "Masters of Nature"

msgid "MINOR_FACTION@UPGRADE_SET@NECROMANCY_MASTER@DESCRIPTION"
msgstr "These are the Masters of Necromancy. They have overcome death itself and become undead. They use armies of the dead and dark magic to overwhelm their foes."

msgid "MINOR_FACTION@UPGRADE_SET@NECROMANCY_MASTER@NAME"
msgstr "Masters of Necromancy"

msgid "MINOR_FACTION@UPGRADE_SET@ORDER_FOLLOWER@DESCRIPTION"
msgstr "These people are Followers of Order. They follow their laws to the letter. They seek to spread their beliefs and hunt down any who dare oppose them."

msgid "MINOR_FACTION@UPGRADE_SET@ORDER_FOLLOWER@NAME"
msgstr "Followers of Order"

msgid "MINOR_FACTION@UPGRADE_SET@ORDER_INITIATE@DESCRIPTION"
msgstr "These people are Initiates of Order. They organize themselves according to their beliefs to stand strong together."

msgid "MINOR_FACTION@UPGRADE_SET@ORDER_INITIATE@NAME"
msgstr "Initiates of Order"

msgid "MINOR_FACTION@UPGRADE_SET@ORDER_MASTER@DESCRIPTION"
msgstr "These people are Masters of Order. Their word is law, to be followed as a divine mandate. The heavens bless them, while they inspire awe in any who do not follow them."

msgid "MINOR_FACTION@UPGRADE_SET@ORDER_MASTER@NAME"
msgstr "Masters of Order"

msgid "MINOR_FACTION@UPGRADE_SET@SHADOW_FOLLOWER@DESCRIPTION"
msgstr "These people are Followers of Shadow. They are experts in molding flesh and bone to their will. They cause dread and fear to those who oppose them."

msgid "MINOR_FACTION@UPGRADE_SET@SHADOW_FOLLOWER@NAME"
msgstr "Followers of Shadow"

msgid "MINOR_FACTION@UPGRADE_SET@SHADOW_INITIATE@DESCRIPTION"
msgstr "These people are Initiates of Shadow. They dabble in the dark side of magic. They can often raise the Undead or cast frost spells."

msgid "MINOR_FACTION@UPGRADE_SET@SHADOW_INITIATE@NAME"
msgstr "Initiates of Shadow"

msgid "MINOR_FACTION@UPGRADE_SET@SHADOW_MASTER@DESCRIPTION"
msgstr "These people are Masters of Shadow. They have transformed themselves to gain newfound powers. Their mastery over Shadow grants them powerful magic that can either kill you, or remove you from this plane altogether."

msgid "MINOR_FACTION@UPGRADE_SET@SHADOW_MASTER@NAME"
msgstr "Masters of Shadow"

msgid "MISCTOKENDEFINITIONS_STRATEGIC@DIPLOMATIC@HYPERLINK"
msgstr "[whisperingStone/] [hyperlink,GLOBAL.DiplomaticTokenConcept]Whispering Stones[/hyperlink]"

msgid "MISCTOKENDEFINITIONS_STRATEGIC@DIPLOMATIC@NAME"
msgstr "[whisperingStone/] Whispering Stone"

msgid "MISCTOKENDEFINITIONS_STRATEGIC@GUILD_SLOT@DESCRIPTION"
msgstr "Determines how many Guild structures a City may build."

msgid "MISCTOKENDEFINITIONS_STRATEGIC@GUILD_SLOT@NAME"
msgstr "Guild Slot"

msgid "MODREQUIREMENTS_UNITPROPERTIES@ABILITY_TYPE_NAME@GIANT_SMASH"
msgstr "Giant Smash"

msgid "MODREQUIREMENTS_UNITPROPERTIES@ABILITY_TYPE_NAME@MELEE"
msgstr "Melee"

msgid "MORALE_EVENT@ALLY_DIES@NAME"
msgstr "Ally Killed"

msgid "MORALE_EVENT@ALLY_DIES@NAME_MARTYR"
msgstr "Ally Killed (Martyr)"

msgid "MORALE_EVENT@ALLY_ROUTED@NAME"
msgstr "Ally Routed"

msgid "MORALE_EVENT@ALLY_ROUTED@NAME_MARTYR"
msgstr "Ally Routed (Martyr)"

msgid "MORALE_EVENT@ARMY_LOST@NAME"
msgstr "New Turn: Too Many Allies Died"

msgid "MORALE_EVENT@CRITICAL_HIT@NAME"
msgstr "Performed a Critical Hit"

msgid "MORALE_EVENT@ENEMY_DIES@NAME"
msgstr "Enemy Died"

msgid "MORALE_EVENT@ENEMY_HERO_DIES@NAME"
msgstr "Enemy Hero Died"

msgid "MORALE_EVENT@ENEMY_ROUTED@NAME"
msgstr "Enemy Routed"

msgid "MORALE_EVENT@FUMBLE_HIT@NAME"
msgstr "Fumbled an Attack"

msgid "MORALE_EVENT@HERO_DIES@NAME"
msgstr "Allied Hero Killed"

msgid "MORALE_EVENT@HERO_DIES@NAME_MARTYR"
msgstr "Allied Hero Killed (Martyr)"

msgid "MORALE_EVENT@HIT_BY_CRITICAL@NAME"
msgstr "Hit by a Critical Attack"

msgid "MORALE_EVENT@HIT_BY_FLANKED@NAME"
msgstr "Hit by a [flank/] Flanking Attack"

msgid "MORALE_EVENT@NEW_TURN_CAP@NAME"
msgstr "New Turn: Cannot Exceed {capValue}"

