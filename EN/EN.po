msgid "INTERFACE@SETTINGS_GAMEPLAY@SUPPRESS_CAMERA_EFFECTS_TOOLTIP"
msgstr "Suppresses movement effects that happen on the camera. For example, screen shakes will not trigger anymore."

msgid "INTERFACE@SETTINGS_GAMEPLAY@TUTORIAL_SETTING"
