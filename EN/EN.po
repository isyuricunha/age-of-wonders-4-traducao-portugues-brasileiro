msgid "DLC@THRONESOFBLOOD@TOME_BLOOD_RITE@BLOOD_CULTIST@NAME"
msgstr "Blood Cultist^m"

msgid "DLC@THRONESOFBLOOD@TOME_BLOOD_RITE@GAMEPLAY_DESCRIPTION"
msgstr "Perform forbidden and dangerous rites on your units to bleed your enemies and strengthen your allies."

msgid "DLC@THRONESOFBLOOD@TOME_BLOOD_RITE@LORE_DESCRIPTION"
msgstr "\"Forbidden rites in a forgotten tongue, burned scrolls of a kingdom raised on blood and sacrifice. These are the memories of the one we now call the Deathless God. His tenets—now He whispers them in my mind, as words to be carved into our flesh. For every gift He bestows demands a price. And that price is blood.\""

