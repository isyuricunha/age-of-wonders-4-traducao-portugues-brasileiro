msgid "DLC@WAYSOFWAR@RADIANT_GUARDIAN@RADIANT_TRANSPOSITION@DESCRIPTION"
msgstr "Swap position with a friendly unit and enter {GLOBAL.DefenseModeConcept.Hyperlink}. Enemies adjacent to the unit:[bulletlist][bullet/]Sustain damage.[bullet/]Have a base {PACIFIED_RESISTANCE>ResolvedStrength}% chance of becoming {GLOBAL.PROPERTIES.PACIFIED.Hyperlink} for {PACIFICED_STATUS_DESCRIPTION>NumTurns}.{GLOBAL.TurnConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@WAYSOFWAR@RADIANT_GUARDIAN@RADIANT_TRANSPOSITION@NAME"
msgstr "Radiant Transposition"

msgid "DLC@WAYSOFWAR@RIGHTEOUS_JUDGE@RIGHTEOUS_JUDGEMENT@DESCRIPTION"
