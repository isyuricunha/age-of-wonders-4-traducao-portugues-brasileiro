msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@SKILL2@OPERATION_DESCRIPTION"
msgstr "Destroy the Spellward."

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@SKILL2@OPERATION_NAME"
msgstr "Raze Spellward"

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@SKILL2@STRUCTURE_DESCRIPTION"
msgstr "[bulletlist][bullet/]Enemies cannot target <<m:{GLOBAL.WorldMapSpellConcept.Hyperlink}>> in this and adjacent <<m:{GLOBAL.ProvinceConcept.Hyperlink}>>.[bullet/]Enemy <<m:{GLOBAL.SpellConcept.Hyperlink}>> cost +{amount1}% <<m:{GLOBAL.CombatCastingPointConcept.Hyperlink}>> in {GLOBAL.CombatConcept.Hyperlink} in this and adjacent <<m:{GLOBAL.ProvinceConcept.Hyperlink}>>.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_SEVERING@SKILL2@STRUCTURE_NAME"
