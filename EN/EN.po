msgstr "Small [hyperlink,GLOBAL.PickupConcept]Pickup[/hyperlink]"

msgid "INTERFACE@STRATEGIC_MAP@PROVINCE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.ProvinceConcept]Province[/hyperlink]"

msgid "INTERFACE@STRATEGIC_MAP@PROVINCE_ANNEX@HYPERLINK"
msgstr "[hyperlink,GLOBAL.ProvinceAnnexationConcept]Province Annexation[/hyperlink]"

msgid "INTERFACE@STRATEGIC_MAP@PROVINCE_ANNEX_DESCRIPTION"
msgstr "Province Annexation is the process of expanding your {GLOBAL.CityConcept.Hyperlink} {GLOBAL.DomainConcept.Hyperlink} by building a {GLOBAL.ProvinceImprovementConcept.Hyperlink}.[br/][bulletlist][bullet/]Increase the distance a city can annex provinces by upgrading your town hall.[bullet/]Annex provinces from your <<m:{GLOBAL.PvEVassalConcept.Hyperlink}>> by paying {GLOBAL.ImperiumConcept.Hyperlink}.[bullet/]Annex ruined provinces from enemy cities by {GLOBAL.PillagingConcept.Hyperlink} them first.[/bulletlist]"

msgid "INTERFACE@STRATEGIC_MAP@PROVINCE_DESCRIPTION"
msgstr "An area on the {GLOBAL.WorldMapConcept.Hyperlink} marked by borders.[br/][br/]Provinces:[bulletlist][bullet/]Have <<m:{GLOBAL.ProvinceFeatureConcept.Hyperlink}>>, which determine the <<m:{GLOBAL.ProvinceImprovementConcept.Hyperlink}>> that can be built there.[bullet/]Can be [hyperlink,GLOBAL.ProvinceAnnexationConcept]annexed[/hyperlink] to a {GLOBAL.CityConcept.Hyperlink} by building a {GLOBAL.ProvinceImprovementConcept.Hyperlink} within.[bullet/]May contain <<m:{GLOBAL.NodeConcept.Hyperlink}>>, <<m:{GLOBAL.PickupConcept.Hyperlink}>>, or an {GLOBAL.AncientWonderConcept.Hyperlink}.[/bulletlist]"

msgid "INTERFACE@STRATEGIC_MAP@PROVINCE_FEATURE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.ProvinceFeatureConcept]Province Feature[/hyperlink]"

msgid "INTERFACE@STRATEGIC_MAP@PROVINCE_IMPROVEMENT"
msgstr "Province Improvement"

msgid "INTERFACE@STRATEGIC_MAP@PROVINCE_IMPROVEMENT_DESCRIPTION"
msgstr "Structures that a {GLOBAL.CityConcept.Hyperlink} builds in a {GLOBAL.ProvinceConcept.Hyperlink} to add that province to its {GLOBAL.DomainConcept.Hyperlink}.[br/][br/]Different improvements are available in a province depending on what <<m:{GLOBAL.ProvinceFeatureConcept.Hyperlink}>> and <<m:{GLOBAL.LocationConcept.Hyperlink}>> are within it.[br/][br/]A city can support one improvement for each {GLOBAL.PopulationConcept.Hyperlink} it has after the first one."

msgid "INTERFACE@STRATEGIC_MAP@PROVINCE_IMPROVEMENT_HYPERLINK"
msgstr "[hyperlink,GLOBAL.ProvinceImprovementConcept]Province Improvement[/hyperlink]"

msgid "INTERFACE@STRATEGIC_MAP@QUARRY_DESCRIPTION"
msgstr "A Quarry is a base {GLOBAL.ProvinceImprovementConcept.Hyperlink} with the following benefits:[bulletlist][bullet/]Provides {GLOBAL.StructureProductionConcept.Hyperlink} income.{LOC.INTERFACE@STRATEGIC_MAP@BASE_IMPROVEMENT_DESCRIPTION}[/bulletlist]"

msgid "INTERFACE@STRATEGIC_MAP@QUARRY_HYPERLINK"
msgstr "[quarry/] [hyperlink,GLOBAL.QuarryConcept]Quarry[/hyperlink]"

msgid "INTERFACE@STRATEGIC_MAP@RESEARCH_POST_DESCRIPTION"
msgstr "A Research Post is a base {GLOBAL.ProvinceImprovementConcept.Hyperlink} with the following benefits:[bulletlist][bullet/]Provides {GLOBAL.KnowledgeConcept.Hyperlink} income.{LOC.INTERFACE@STRATEGIC_MAP@BASE_IMPROVEMENT_DESCRIPTION}[/bulletlist]"

msgid "INTERFACE@STRATEGIC_MAP@RESEARCH_POST_HYPERLINK"
msgstr "[researchpost/] [hyperlink,GLOBAL.ResearchPostConcept]Research Post[/hyperlink]"

msgid "INTERFACE@STRATEGIC_MAP@ROOT_NODE_DESCRIPTION"
msgstr "<<m:{GLOBAL.NodeConcept.Hyperlink}>> required to achieve {GLOBAL.MagicVictoryConcept.Hyperlink}. Base Root Nodes provide {GLOBAL.ManaConcept.Hyperlink} and can be converted to a different {GLOBAL.AffinityConcept.Hyperlink} for additional {GLOBAL.CityIncomeConcept.Hyperlink}."

msgid "INTERFACE@STRATEGIC_MAP@ROOT_NODE_HYPERLINK"
msgstr "[hyperlink,GLOBAL.RootNodeConcept]Root Node[/hyperlink]"

msgid "INTERFACE@STRATEGIC_MAP@RUINED_NODE@DESCRIPTION"
msgstr "Ruined Nodes are <<m:{GLOBAL.NodeConcept.Hyperlink}>> that have been depleted by overharvesting or other means.[bulletlist][bullet/]Ruined Nodes no longer provide any income or bonuses.[bullet/]Ruined Nodes still grant the option of building certain <<m:{GLOBAL.ProvinceImprovementConcept.Hyperlink}>> in the {GLOBAL.ProvinceConcept.Hyperlink} their intact versions would allow.[bullet/]Ruined Nodes can be restored as long as you have claimed them, restoring them costs {GLOBAL.ManaConcept.Hyperlink}.[bulletlist][bullet/]This cost is decreased each {GLOBAL.TurnConcept.Hyperlink} the Ruined Node exists, until a minimum cost is reached.[bullet/]When restored, Ruined Nodes are replaced by their intact versions which provide their income and bonuses again.[/bulletlist][/bulletlist]"

msgid "INTERFACE@STRATEGIC_MAP@RUINED_NODE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.RuinedNodeConcept]Ruined Node[/hyperlink]"

msgid "INTERFACE@STRATEGIC_MAP@RUINED_NODE@NAME"
msgstr "Ruined Node"

