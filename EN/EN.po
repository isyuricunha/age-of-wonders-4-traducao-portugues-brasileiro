msgid "DLC@RISEFROMRUIN@CULTURE_NOMAD@NOMAD@DESCRIPTION"
msgstr "[bulletlist][bullet/]Mobile units that focus on maneuvering and flanking.[bullet/]Nomad Cities are able to pack up into a {GLOBAL.NomadSettlerConcept.Hyperlink} and relocate.[bullet/]Nodes in domain of their Cities are [hyperlink,GLOBAL.OverharvestingConcept]Overharvested[/hyperlink] over time, exhausting the Nodes to gain {GLOBAL.EssenceConcept.Hyperlink} in that city.[bullet/]Nomad Cities require {PercentageDecrease}% more {GLOBAL.FoodConcept.Hyperlink} to gain {GLOBAL.PopulationConcept.Hyperlink}.[/bulletlist]"

