msgstr "{TSR_WINNING_PLAYER} has foiled the plans of the {GLOBAL.StormClanLoreConcept.Hyperlink}, dispersing the crystal storm raging in the region. <<Cp:TSR_WINNING_PLAYER>> has claimed the {TSR_RELIC} {GLOBAL.ArtifactConcept.Hyperlink} for their empire!"

msgid "DLC@GIANTKINGS@TSR_CSP@NOTE_PLAYER_WON_HEADER"
msgstr "Crystalstorm Plateau: Completed by {TSR_WINNING_PLAYER}!"

msgid "DLC@GIANTKINGS@TSR_CSP@OBJECTIVE_01"
msgstr "{TSR_INT_STORM_INVESTIGATED}/1 Eye of the Storm Investigated"

msgid "DLC@GIANTKINGS@TSR_CSP@OBJECTIVE_02"
msgstr "Beware the roaming Lithorine!"

msgid "DLC@GIANTKINGS@TSR_CSP@OBJECTIVE_03"
msgstr "{GLOBAL.PROPERTIES.TSR_CRYSTAL_STORM_AUTO_SPELL.Hyperlink} is active in this region."

