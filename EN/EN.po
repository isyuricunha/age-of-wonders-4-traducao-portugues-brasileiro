msgid "DLC@WAYSOFWAR@UNITS_OATHSWORN@ABILITY06@MASTER_NAME"
msgstr "Champion Transference Seal"

msgid "DLC@WAYSOFWAR@UNITS_OATHSWORN@ABILITY06@NAME"
msgstr "Transference Seal"

msgid "DLC@WAYSOFWAR@UNITS_OATHSWORN@ABILITY06@PROP_DESCRIPTION"
msgstr "Enemy attacking units restore {TRANSFERENCE_SEAL_DEBUFF_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> on hit.[br/][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

