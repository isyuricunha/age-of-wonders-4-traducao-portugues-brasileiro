msgid "TOME_WILD_MAGIC@SKILL2@NAME"
msgstr "Raça de Guerra"

msgid "TOME_WILD_MAGIC@SKILL3@DESCRIPTION"
msgstr "Concede às unidades encantadas:[bulletlist][bullet/]+{FLAMEBURST_WEAPONS_CRITICAL>ResolvedCritChanceBonus}% {GLOBAL.CriticalHitChanceConcept.Hyperlink}.[bullet/]Matar uma unidade faz com que ela exploda, inimigos adjacentes:[bulletlist][bullet/]Sustentam {FLAMEBURST_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Ganham {amount} {GLOBAL.PROPERTIES.BURNING.Hyperlink} por {BURNING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][/bulletlist]"

msgid "TOME_WILD_MAGIC@SKILL3@MODIFIER_DESCRIPTION"
msgstr "Matar uma unidade faz com que ela exploda, inimigos adjacentes:[bulletlist][bullet/]Sustentam {FLAMEBURST_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Ganham {amount} {GLOBAL.PROPERTIES.BURNING.Hyperlink} por {BURNING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "TOME_WILD_MAGIC@SKILL3@NAME"
msgstr "Armas de Explosão Flamejante"

msgid "TOME_WILD_MAGIC@SKILL3@PROPERTY_DESCRIPTION"
msgstr "Esta unidade tem:[bulletlist][bullet/]+{FLAMEBURST_WEAPONS_CRITICAL>ResolvedCritChanceBonus}% {GLOBAL.CriticalHitChanceConcept.Hyperlink}[bullet/]Matar uma unidade faz com que ela exploda, inimigos adjacentes:[bulletlist][bullet/]Sustentam {FLAMEBURST_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Ganham {amount} {GLOBAL.PROPERTIES.BURNING.Hyperlink} por {BURNING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][/bulletlist]"

msgid "TOME_WILD_MAGIC@SKILL4@DESCRIPTION"
msgstr "[bulletlist][bullet/]No início da batalha, ganha {amount} {GLOBAL.UNITS.WAR_HOUND_UNIT.Hyperlink} unidades do lado do atacante até o final da batalha.[/bulletlist]"

msgid "TOME_WILD_MAGIC@SKILL4@NAME"
msgstr "Liberar os Cães de Guerra"

msgid "TOME_WILD_MAGIC@SKILL6@DESCRIPTION"
msgstr "Alvo: unidade amiga de Nível I, II ou III que não seja {GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink}, nem {GLOBAL.PROPERTIES.CONSTRUCT.Hyperlink}:[bulletlist][bullet/]Transforma-se em um(a) {GLOBAL.UNITS.WARBREED_UNIT.Hyperlink}.[bullet/]Cura {MONSTROUS_REBIRTH_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Morre ao final do combate.[/bulletlist][br][br/]Não pode ser usada em Combate Aquático."

msgid "TOME_WILD_MAGIC@SKILL6@NAME"
msgstr "Renascimento Monstruoso"

msgid "TOME_WILD_MAGIC@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Obtenha os meios para conquistar cidades com força avassaladora. Especialize‑se em <<m:{GLOBAL.SiegeConcept.Hyperlink}>> e em causar dano."

msgid "TOME_WILD_MAGIC@TOME@LORE_AUTHOR"
msgstr "Asgera Spinesplitter, Rainha de Guerra dos Orcs Bloodfang"

msgid "TOME_WILD_MAGIC@TOME@LORE_DESCRIPTION"
msgstr "\"Acima de tudo, a batalha! Aqueles que vivem e respiram guerra sempre lutarão pela vitória, mesmo depois que suas lâminas se quebrarem, seus ossos se despedaçarem e seus cérebros se tornarem polpa. Construa as mais poderosas máquinas de guerra e incuta em seu exército uma fome de vitória. Então... então você será imbatível!\""

msgid "TOME_WILD_MAGIC@TOME@NAME"
msgstr "Tomo da Devastação"

msgid "TOME_WILD_MAGIC@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Desloca o alvo atacado e move‑se para o seu hexágono."

msgid "TOME_WILD_MAGIC@UNIT1@ABILITY1@DESCRIPTION_IF_MOVED"
msgstr "Se a unidade se mover, desloca o alvo atacado e move‑se para o seu hexágono."

msgid "TOME_WILD_MAGIC@UNIT1@ABILITY1@NAME"
msgstr "Deslocar e Substituir"

msgid "TOME_WILD_MAGIC@UNIT1@ABILITY2@DESCRIPTION"
msgstr "Ataca unidades inimigas em um cone de {unitsAmount} hexágonos.[bulletlist][bullet/]Cancela {GLOBAL.DefenseModeConcept.Hyperlink}.[bullet/]Remove {GLOBAL.RetaliationConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_WILD_MAGIC@UNIT1@ABILITY2@NAME"
msgstr "Corte Poderoso"

msgid "TOME_WILD_MAGIC@UNIT1@NAME"
msgstr "Warbreed^m"

msgid "TOME_WILD_MAGIC@UNIT2@NAME"
msgstr "Esfera Devastadora^n"

msgid "TOME_WINDS@HERO_SKILL@DESCRIPTION"
