msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@NOTIFY_VICTORY_IMMINENT@YOU"
msgstr "Você alcançará a Vitória dos Selos em {Turns} turnos"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@RESULT@ALLIED_VICTORY@TEXT"
msgstr "Seu aliado {OtherPlayer.Name} ativou os Selos Mundiais adormecidos e assumiu o controle deles, banindo todos os outros Godir deste reino. Após as cataclismas resultantes, o povo não tem escolha a não ser aceitar você e {OtherPlayer.Name} como seu único Godir pelos séculos vindouros."

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@RESULT@DEFEAT"
msgstr "{OtherPlayer.Name} alcançou a Vitória dos Selos"

