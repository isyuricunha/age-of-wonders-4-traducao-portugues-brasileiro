msgid "FEY_INVASION@MIST_TRAIL@NAME"
msgstr "Trilha de Névoas"

msgid "FEY_INVASION@PORTAL_WONDER@DESCRIPTION"
msgstr "Um caminho para o reino Feérico, {GLOBAL.DuathaLoreConcept.Hyperlink}."

msgid "FEY_INVASION@PORTAL_WONDER@NAME"
msgstr "Fenda Feérica"

msgid "FEY_INVASION@RACE@BIO"
msgstr "Quando uma névoa persistente se arrasta pelos campos e colinas, os Caminhantes da Névoa estão prestes a atacar um reino. Não se sabe quando, onde ou por que esse povo silencioso Feérico inicia suas violentas incursões de sequestro em massa, mas os horrores liberados do reino Feérico derrubaram impérios inteiros e ganharam o infame nome \"Toll of Seasons\"."

msgid "FEY_INVASION@RACE@NAME"
msgstr "Caminhantes da Névoa"

msgid "FEY_INVASION@RELIC_BONUS@AUTUMN@NAME"
msgstr "Asa de Luth"

msgid "FEY_INVASION@RELIC_BONUS@SPRING@NAME"
