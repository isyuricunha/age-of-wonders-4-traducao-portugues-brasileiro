msgid "TOME_ASTRAL_CONVERGENCE@HERO_SKILL@NAME"
msgstr "Surto Arcano"

msgid "TOME_ASTRAL_CONVERGENCE@PASSIVE@DESCRIPTION"
msgstr "[bulletlist][bullet/]{amount} <<m:{GLOBAL.CombatCastingPointConcept.Hyperlink}>>[bullet/]{amount} <<m:{GLOBAL.WorldMapCastingPointConcept}>>[/bulletlist]"

msgid "TOME_ASTRAL_CONVERGENCE@PASSIVE@NAME"
msgstr "Tecelagem de Feitiços Eficiente"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL1@ATTUNEMNT_DESCRIPTION"
msgstr "Quando um feitiço aliado é lançado, esta unidade ganha um {GLOBAL.PositiveStatusEffectConcept.Hyperlink} aleatório."

msgid "TOME_ASTRAL_CONVERGENCE@SKILL1@ATTUNEMNT_NAME"
msgstr "Sintonização: Presságio Astral"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL1@DESCRIPTION"
msgstr "Liga a raça-alvo ao Mar Astral, concedendo a eles:[bulletlist][bullet/]O tipo de unidade {GLOBAL.PROPERTIES.ETHEREAL.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.ATTUNEMENT_ASTRAL_OMEN.Hyperlink}, concedendo um {GLOBAL.PositiveStatusEffectConcept.Hyperlink} aleatório quando um feitiço é lançado em combate.[/bulletlist]"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL1@NAME"
msgstr "Afinidade Astral"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL1@PROPERTY_DESCRIPTION"
msgstr "Unidade tem:[bulletlist][bullet/]O tipo de unidade {GLOBAL.PROPERTIES.ETHEREAL.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.ATTUNEMENT_ASTRAL_OMEN.Hyperlink}[/bulletlist]"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL2@DESCRIPTION"
msgstr "Alvo hex não ocupado:[bulletlist][bullet/]Conjure um(a) {GLOBAL.UNITS.ASTRAL_SERPENT_UNIT.Hyperlink} ou {GLOBAL.UNITS.ASTRAL_SIPHONER_UNIT.Hyperlink} unidade aleatória que dura {SUMMON_POSITION_EFFECT>TurnsToLive} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Todas as unidades adjacentes sofrem {EXPLOSIVE_MANIFESTATION_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}, {EXPLOSIVE_MANIFESTATION_DAMAGE>DAMAGE>Shock} {GLOBAL.LightningDamageConcept.Hyperlink} e {EXPLOSIVE_MANIFESTATION_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL2@NAME"
msgstr "Manifestação Explosiva"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL3@DESCRIPTION"
msgstr "[bulletlist][bullet/]No início do combate, ganha {castingpoints}.[bullet/]Durante o combate, todos os <<m:{GLOBAL.UnitConcept.Hyperlink}>> inimigos sofrem {resistancepenalty}.[/bulletlist]"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL3@NAME"
msgstr "Acúmulo Arcano"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL3@PROPERTY@DESCRIPTION"
msgstr "A cada turno em combate, até {amount} inimigos aleatórios:[bulletlist][bullet/]Tornam-se {GLOBAL.PROPERTIES.ELECTRIFIED.Hyperlink}.[bullet/]Sofrem {damage} {GLOBAL.FireDamageConcept.Hyperlink}, {damage} {GLOBAL.LightningDamageConcept.Hyperlink}, ou {damage} {GLOBAL.FrostDamageConcept.Hyperlink} .[/bulletlist]"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL4@DESCRIPTION"
msgstr "Alvo {GLOBAL.ProvinceConcept.Hyperlink}:[bulletlist][bullet/]Se contiver um(a) inimigo {GLOBAL.ProvinceImprovementConcept.Hyperlink} e não {GLOBAL.AncientWonderConcept.Hyperlink}, torna-se ruínas.[bullet/]Gera um(a) poderoso(a) {GLOBAL.ArmyConcept.Hyperlink} do Mar Astral <<m:{GLOBAL.UnitConcept.Hyperlink}>>.[/bulletlist]"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL4@NAME"
msgstr "Estilhaçamento Astral"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL5@DESCRIPTION"
msgstr "Sempre que lançar um feitiço em Combate Tático, adicione um {GLOBAL.PROPERTIES.CASCADING_POWER_AUTO_SPELL.Hyperlink} a esse combate."

msgid "TOME_ASTRAL_CONVERGENCE@SKILL5@NAME"
msgstr "Poder em Cascata"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL5@PROP_DESCRIPTION"
msgstr "[bulletlist][bullet/]Uma unidade inimiga aleatória recebe {amount} {GLOBAL.LightningDamageConcept.Hyperlink} no início do {GLOBAL.TurnConcept} do proprietário.[bullet/]Para cada pilha, outra unidade inimiga aleatória sofre dano.[/bulletlist]"

msgid "TOME_ASTRAL_CONVERGENCE@SKILL5@PROP_NAME"
msgstr "Pilha de Poder em Cascata"

msgid "TOME_ASTRAL_CONVERGENCE@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Fique mais forte quanto mais feitiços lançar e invocar criaturas do Mar Astral."

msgid "TOME_ASTRAL_CONVERGENCE@TOME@LORE_AUTHOR"
msgstr "Merlin, o Errante"

msgid "TOME_ASTRAL_CONVERGENCE@TOME@LORE_DESCRIPTION"
msgstr "\"Quando você altera as correntes do Mar Astral, as correntes também o alteram. Verdadeiros mestres do arcano se tornarão condutos da energia mágica que comandam, permitindo que ela flua através de seu próprio ser. Essa energia pode ser usada para infundir seus súditos, aprimorando-os de várias maneiras.\""

msgid "TOME_ASTRAL_CONVERGENCE@TOME@NAME"
msgstr "Tomo de Convergência Astral"

msgid "TOME_ASTRAL_MIRROR@AUTO_REVERT@DESCRIPTION"
