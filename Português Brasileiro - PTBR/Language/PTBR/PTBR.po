msgid "DLC@ELDRITCHREALMS@NODES_STRATEGIC@NODES@RUINED_MONOLITHS_NODE@NAME"
msgstr "Monólitos Arruinados"

msgid "DLC@ELDRITCHREALMS@NODES_STRATEGIC@NODES@RUINED_VOID_STONES@NAME"
msgstr "Pedras do Vazio Arruinadas"

msgid "DLC@ELDRITCHREALMS@NODES_STRATEGIC@VOID_INK@DESCRIPTION"
msgstr "[bulletlist][bullet/]<<m:{GLOBAL.PvEVassalConcept.Hyperlink}>> concedem +{amount1} {GLOBAL.KnowledgeConcept.Hyperlink}.[bullet/]<<m:{GLOBAL.UmbralDwellingConcept.Hyperlink}>> com um {GLOBAL.EldritchPactConcept.Hyperlink} concedem +{amount2}.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@NODES_STRATEGIC@VOID_INK@NAME"
msgstr "Tinta do Vazio"

msgid "DLC@ELDRITCHREALMS@NODES_STRATEGIC@VOID_STONES@DESCRIPTION"
msgstr "Efeito global único: [bulletlist][bullet/]Obtenha {allegiance}{GLOBAL.HouseInfluenceConcept.Hyperlink} com <<m:{GLOBAL.UmbralDwellingConcept.Hyperlink}>> descoberto por {GLOBAL.TurnConcept.Hyperlink}.[bullet/]Permite a forja de itens diversos que concedem imunidade a {GLOBAL.PROPERTIES.SHADOW_SICKNESS.Hyperlink} no {GLOBAL.ItemForgeConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@NODES_STRATEGIC@VOID_STONES@LORE"
msgstr "\"Pedras flutuantes, lisas como seda, diferentes de tudo que encontrei acima ou abaixo dos mundos conhecidos. Toque em uma, e as palavras proibidas dos habitantes Umbrais escapam da sua língua. Bata numa com um martelo, e sua sintonia Astral ressoa. Elas parecem impossíveis de dividir ao meio, mas suspeito que sejam, na verdade, geodos. Que tesouro está guardado dentro?\"[br/][br/]—Fangir Rockborne, Diários da Segunda Era: Apêndice"

msgid "DLC@ELDRITCHREALMS@NODES_STRATEGIC@VOID_STONES@NAME"
msgstr "Pedras do Vazio"

msgid "DLC@ELDRITCHREALMS@NODES_STRATEGIC@VOID_STONES_SET_BONUS@DESCRIPTION"
msgstr "[bulletlist][bullet/]<<m:{GLOBAL.UmbralDwellingConcept.Hyperlink}>> com um {GLOBAL.EldritchPactConcept.Hyperlink} concedem +{amount1} {GLOBAL.KnowledgeConcept.Hyperlink}.[bullet/]<<m:{GLOBAL.PvEVassalConcept.Hyperlink}>> concedem +{amount2} {GLOBAL.KnowledgeConcept.Hyperlink}.[/bulletlist][br/][br/]Requer:[bulletlist][bullet/]{amount3} {GLOBAL.STRUCTURES.VOID_STONES.Hyperlink}[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@NODES_STRATEGIC@VOID_STONES_SET_BONUS@NAME"
msgstr "Tinta do Vazio"

msgid "DLC@ELDRITCHREALMS@PICKUPS_STRATEGIC@CHITIN_PICKUP@DESCRIPTION"
msgstr "As cascas descartadas e endurecidas de várias criaturas Demônios Umbrais. Podem ser usadas na construção de armaduras ou edifícios, ou vendidas como materiais exóticos.[br/][br/]Podem conceder grande quantidade de {GLOBAL.GoldConcept.Hyperlink}, {GLOBAL.UnitProductionConcept.Hyperlink}, ou {GLOBAL.StructureProductionConcept.Hyperlink}."

msgid "DLC@ELDRITCHREALMS@PICKUPS_STRATEGIC@CHITIN_PICKUP@NAME"
msgstr "Quitina Descartada"

msgid "DLC@ELDRITCHREALMS@PICKUPS_STRATEGIC@SOULS_PICKUP@DESCRIPTION"
msgstr "Casca de seres antes poderosos, assombrando a área ao redor. Podem conter segredos sombrios ou ser transformadas em poder bruto.[br/][br/]Podem conceder grande quantidade de {GLOBAL.ManaConcept.Hyperlink} e {GLOBAL.KnowledgeConcept.Hyperlink}. Se disponível, também concedem {amount} <<m:{GLOBAL.SoulConcept.Hyperlink}>>."

msgid "DLC@ELDRITCHREALMS@PICKUPS_STRATEGIC@SOULS_PICKUP@NAME"
msgstr "Almas Atormentadas"

msgid "DLC@ELDRITCHREALMS@PICKUPS_STRATEGIC@TOME_PICKUP@DESCRIPTION"
msgstr "Páginas e mais páginas descrevendo ritos, rituais e sinais. E ainda assim apenas um fragmento de um {GLOBAL.TomeConcept.Hyperlink} completo.[br/][br/]Ao ser coletado, desbloqueia um único {GLOBAL.SpellConcept.Hyperlink} que você ainda não [hyperlink,GLOBAL.ResearchConcept]pesquisou[/hyperlink] e não está pesquisando no momento."

msgid "DLC@ELDRITCHREALMS@PICKUPS_STRATEGIC@TOME_PICKUP@NAME"
msgstr "Fragmento de Tomo"

msgid "DLC@ELDRITCHREALMS@RACETRAITS_WORLD@KEEPERS_OF_KNOWLEDGE@BIO"
msgstr "Seu vasto conhecimento lhes garante poder e respeito em todos os reinos."

msgid "DLC@ELDRITCHREALMS@RACETRAITS_WORLD@KEEPERS_OF_KNOWLEDGE@EFFECT1@DESCRIPTION"
msgstr "Desbloquear uma nova Habilidade de Pesquisa concede +10 {GLOBAL.HouseInfluenceConcept.Hyperlink} a todos os <<m:{GLOBAL.IndependentCityConcept.Hyperlink}>> a quem você atribuiu um {GLOBAL.DiplomaticTokenConcept.Hyperlink}."

msgid "DLC@ELDRITCHREALMS@RACETRAITS_WORLD@KEEPERS_OF_KNOWLEDGE@EFFECT2@DESCRIPTION"
msgstr "Desbloquear um novo {GLOBAL.TomeConcept.Hyperlink} concede +{amount} de Relacionamento com todos os <<m:{GLOBAL.EmpireConcept.Hyperlink}>>."

msgid "DLC@ELDRITCHREALMS@RACETRAITS_WORLD@KEEPERS_OF_KNOWLEDGE@EFFECT3@DESCRIPTION"
msgstr "Ganhe +{amount} de {GLOBAL.KnowledgeConcept.Hyperlink} de renda para cada império com o qual você tem {GLOBAL.OpenBordersConcept.Hyperlink}."

msgid "DLC@ELDRITCHREALMS@RACETRAITS_WORLD@KEEPERS_OF_KNOWLEDGE@INCOME_MODIFIER_DESCRIPTION"
msgstr "Guardiões do Conhecimento: Tratado de Fronteiras Abertas"

msgid "DLC@ELDRITCHREALMS@RACETRAITS_WORLD@KEEPERS_OF_KNOWLEDGE@LORE"
msgstr "Eles sabem que conhecimento é poder, e poder exige respeito."

msgid "DLC@ELDRITCHREALMS@RACETRAITS_WORLD@KEEPERS_OF_KNOWLEDGE@MODIFIER_DESCRIPTION"
msgstr "Guardiões do Conhecimento: Tomo Desbloqueado"

msgid "DLC@ELDRITCHREALMS@RACETRAITS_WORLD@KEEPERS_OF_KNOWLEDGE@NAME"
msgstr "Guardiões do Conhecimento [goodact/]"

msgid "DLC@ELDRITCHREALMS@RACETRAITS_WORLD@UMBRAL_DISCIPLES@BIO"
msgstr "Eles sabem que as sombras não devem ser temidas, mas estudadas e usadas."

msgid "DLC@ELDRITCHREALMS@RACETRAITS_WORLD@UMBRAL_DISCIPLES@EFFECT1@DESCRIPTION"
msgstr "Comece com {GLOBAL.SPECIAL_OPERATIONS.UMBRAL_FLESH.Hyperlink} ativo."

msgid "DLC@ELDRITCHREALMS@RACETRAITS_WORLD@UMBRAL_DISCIPLES@EFFECT2@DESCRIPTION"
msgstr "Cidades podem construir o {GLOBAL.STRUCTURE_UPGRADES.ALTAR_OF_MARCHING_GLOOM.Hyperlink}."

msgid "DLC@ELDRITCHREALMS@RACETRAITS_WORLD@UMBRAL_DISCIPLES@EFFECT3@DESCRIPTION"
msgstr "Seu Governante ganha {GLOBAL.PROPERTIES.TYRANTS_RETINUE_HERO.Hyperlink}."

msgid "DLC@ELDRITCHREALMS@RACETRAITS_WORLD@UMBRAL_DISCIPLES@EFFECT4@DESCRIPTION"
msgstr "Comece com {GLOBAL.SPECIAL_OPERATIONS.GLOOM_WARD.Hyperlink} desbloqueado."

msgid "DLC@ELDRITCHREALMS@RACETRAITS_WORLD@UMBRAL_DISCIPLES@LORE"
msgstr "As sombras sussurram, e os discípulos escutam."

