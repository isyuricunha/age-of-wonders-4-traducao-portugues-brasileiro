msgid "PLAYER_INTERACTION@EVENT_DEFEATEDPLAYER@POSITIVE"
msgstr "\"Muito bem! O império de {Player.Name} foi derrotado. Isso nos aproxima um passo de conquistar a vitória.\""

msgid "PLAYER_INTERACTION@EVENT_HIGHESTCAPABILITY@NEGATIVE"
msgstr "\"Ha, você pode ser a estrela em ascensão agora, mas isso não vai durar. Mais cedo ou mais tarde, meu império se erguerá acima de tudo!\""

msgid "PLAYER_INTERACTION@EVENT_HIGHESTCAPABILITY@NEUTRAL"
