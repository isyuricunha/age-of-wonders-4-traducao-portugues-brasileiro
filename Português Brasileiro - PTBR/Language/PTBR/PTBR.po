msgstr "Unidades do dono deste efeito recebem:[bulletlist][bullet/]{GLOBAL.PROPERTIES.RALLYING.Hyperlink}[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@WILDHUNT_PRESENCE_03@DESCRIPTION"
msgstr "Enquanto esta unidade estiver em combate, todas as unidades amigas recebem:[bulletlist][bullet/]{GLOBAL.PROPERTIES.WIND_BARRIER.Hyperlink}[/bulletlist]"

