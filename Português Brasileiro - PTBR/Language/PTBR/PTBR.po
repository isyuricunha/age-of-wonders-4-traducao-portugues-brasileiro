msgid "TOME_CYCLES@SKILL1@PROP_DESCRIPTION"
msgstr "Ataques da unidade:[bulletlist][bullet/]Inflijam {GLOBAL.PROPERTIES.DECAYING.Hyperlink}.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

