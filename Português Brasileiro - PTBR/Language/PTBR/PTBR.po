msgstr "Suas ações não podem ser perdoadas. Eu terei minha vingança!"

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_WAR_MAJOR_CB@DESCRIPTION"
msgstr "Declarar guerra ao outro Governante com grande {GLOBAL.WarJustificationConcept.Hyperlink}. Seu estado diplomático mudará para guerra e outros Governantes e cidades vassalas o apoiarão."

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_WAR_MAJOR_CB@NAME"
msgstr "Declarar guerra com grande {GLOBAL.WarJustificationConcept.Hyperlink} (51+ [CasusBelli/])"

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_WAR_MINOR_CB@AI_DESC"
msgstr "Você me ofendeu muitas vezes. Você é o próximo da minha lista!"

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_WAR_MINOR_CB@DESCRIPTION"
msgstr "Declarar guerra ao outro Governante com pequeno {GLOBAL.WarJustificationConcept.Hyperlink}."

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_WAR_MINOR_CB@NAME"
msgstr "Declarar guerra com pequeno {GLOBAL.WarJustificationConcept.Hyperlink} (1-25[CasusBelli/])"

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_WAR_NORMAL_CB@AI_DESC"
msgstr "Você não achou que eu simplesmente esqueceria, não é?"

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_WAR_NORMAL_CB@DESCRIPTION"
msgstr "Declare guerra ao outro Governante com {GLOBAL.WarJustificationConcept.Hyperlink} moderado. Seu status diplomático mudará para guerra e suas relações podem sofrer."

msgid "DIPLOMATICSTATES_DEFINITIONS@OPTION_WAR_NORMAL_CB@NAME"
msgstr "Declare guerra com {GLOBAL.WarJustificationConcept.Hyperlink} moderado (26-50[CasusBelli/])"

msgid "DIPLOMATICSTATES_DEFINITIONS@SHAREINTELLIGENCE@AI_DESC"
msgstr "Compartilhar nossa inteligência nos proporcionará proteção mútua!"

