msgid "FEY_INVASION@RELIC_SPELL_AUTUMN@DESCRIPTION"
msgstr "Alvo {GLOBAL.HeroConcept.Hyperlink} que lidera um exército sob seu controle é transformado permanentemente em um {GLOBAL.UNITS.SCOURGE_AUTUMN.Hyperlink}. Isso também restaura todos os <<m:{GLOBAL.HitPointConcept.Hyperlink}>> e <<m:{GLOBAL.MovePointConcept.Hyperlink}>> da unidade.[br/][br/]Esta transformação não pode ser revertida e o {GLOBAL.HeroConcept.Hyperlink} perde seu status de herói, tornando‑se um {GLOBAL.UnitConcept.Hyperlink} normal!"

msgid "FEY_INVASION@RELIC_SPELL_AUTUMN@NAME"
msgstr "Escolhido de Luth"

msgid "FEY_INVASION@RELIC_SPELL_SPRING@DESCRIPTION"
msgstr "Alvo {GLOBAL.HeroConcept.Hyperlink} que lidera um exército sob seu controle é transformado permanentemente em um {GLOBAL.UNITS.SCOURGE_SPRING.Hyperlink}. Isso também restaura todos os <<m:{GLOBAL.HitPointConcept.Hyperlink}>> e <<m:{GLOBAL.MovePointConcept.Hyperlink}>> da unidade.[br/][br/]Esta transformação não pode ser revertida e o {GLOBAL.HeroConcept.Hyperlink} perde seu status de herói, tornando‑se um {GLOBAL.UnitConcept.Hyperlink} normal!"

msgid "FEY_INVASION@RELIC_SPELL_SPRING@INSTRUCTION"
msgstr "Alveje um herói não‑líder que você controla."

msgid "FEY_INVASION@RELIC_SPELL_SPRING@NAME"
msgstr "Escolhido de Ilandra"

msgid "FEY_INVASION@RELIC_SPELL_SUMMER@DESCRIPTION"
msgstr "Alvo {GLOBAL.HeroConcept.Hyperlink} que lidera um exército sob seu controle é transformado permanentemente em um {GLOBAL.UNITS.SCOURGE_SUMMER.Hyperlink}. Isso também restaura todos os <<m:{GLOBAL.HitPointConcept.Hyperlink}>> e <<m:{GLOBAL.MovePointConcept.Hyperlink}>> da unidade.[br/][br/]Esta transformação não pode ser revertida e o {GLOBAL.HeroConcept.Hyperlink} perde seu status de herói, tornando‑se um {GLOBAL.UnitConcept.Hyperlink} normal!"

msgid "FEY_INVASION@RELIC_SPELL_SUMMER@NAME"
msgstr "Escolhido de Ventrogh"

msgid "FEY_INVASION@RELIC_SPELL_WINTER@DESCRIPTION"
msgstr "Alvo {GLOBAL.HeroConcept.Hyperlink} que lidera um exército sob seu controle é transformado permanentemente em um {GLOBAL.UNITS.SCOURGE_WINTER.Hyperlink}. Isso também restaura todos os <<m:{GLOBAL.HitPointConcept.Hyperlink}>> e <<m:{GLOBAL.MovePointConcept.Hyperlink}>> da unidade.[br/][br/]Esta transformação não pode ser revertida e o {GLOBAL.HeroConcept.Hyperlink} perde seu status de herói, tornando‑se um {GLOBAL.UnitConcept.Hyperlink} normal!"

