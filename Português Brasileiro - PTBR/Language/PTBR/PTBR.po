msgid "TOME_REAPER@ABILITY_2@NAME"
msgstr "Consumo de Cadáver Superior"

msgid "TOME_REAPER@ABILITY_3@DESCRIPTION"
msgstr "[bulletlist][bullet/]Quando uma unidade inimiga morre:[bulletlist][bullet/]Cura {DARK_RITES_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Ganha {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}.[/bulletlist][bullet/]Não é acionado ao morrer de <<m:{GLOBAL.PROPERTIES.COMBAT_SUMMON.Hyperlink}>>, {GLOBAL.PROPERTIES.TOWER_UNIT.Hyperlink} e {GLOBAL.PROPERTIES.SIEGECRAFT_UNIT.Hyperlink} unidades.[/bulletlist]"

