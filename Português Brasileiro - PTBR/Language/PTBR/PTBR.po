msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_WEAVER@SKILL3@PROP_DESCRIPTION"
msgstr "Unidade:[bulletlist][bullet/]Ganha {GLOBAL.PROPERTIES.DEMORALIZER.Hyperlink}[bullet/]Ataques causam +{DREAD_HUNTERS_DAMAGE>ResolvedMultiplier}% ddano contra alvos {GLOBAL.PROPERTIES.IMMOBILIZED.Hyperlink} ou {GLOBAL.PROPERTIES.FROZEN.Hyperlink}.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_WEAVER@SKILL4@DESCRIPTION"
msgstr "Unidades em um raio de {DREADFUL_BIND_UNIT_TARGETER_CIRCLE>AREA>Radius} hexágonos:[bulletlist][bullet/]Têm um {IMMOBILIZED_RESISTANCE>ResolvedStrength}% caumento base de chance de se tornar {GLOBAL.PROPERTIES.IMMOBILIZED.Hyperlink} por {IMMOBILIZED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Ganham {amount} {GLOBAL.PROPERTIES.REMORSE.Hyperlink} por {REMORSE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

