msgid "DLC@SECRETSOFTHEARCHMAGES@STORY_REALM_MISSION_02@YSARIEL_QUEST@CUSTOM_PREDICTION_02@ORDERBOUND"
msgstr "Você se recusa a assinar um pacto com {PactProposer}, mas promete proteger o Círculo da Cova de Azh'Ruun.[bulletlist][bullet/]Essa ação atrai a atenção de forças superiores da Ordem. [order/][bullet/]Se {PactProposer.FirstName} for derrotado, a missão será perdida![/bulletlist]"

