msgstr "Unidade tem:[bulletlist][bullet/]+{ARTISAN_BLADES_CRITICAL_CHANCE>ResolvedCritChanceBonus}% {GLOBAL.CriticalHitChanceConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_ARTIFICING@SKILL3@DESCRIPTION"
