msgid "TOME_REAPER@SKILL1@DESCRIPTION"
msgstr "Unidade alvo:[bulletlist][bullet/]Sofre {VISIONS_OF_DEATH_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink} imune a bloqueio.[bullet/]Perde {VISION_OF_DEATH_MORALE>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}.[bullet/]Tem um {GLOBAL.UNITS.DECAYING_ZOMBIE.Hyperlink} gerado adjacente a ele.[bullet/]Está afetado por {GLOBAL.PROPERTIES.MARKED_FOR_DEATH.Hyperlink} até o fim do combate.[/bulletlist]"

msgid "TOME_REAPER@SKILL1@NAME"
msgstr "Marcado para a Morte"

msgid "TOME_REAPER@SKILL2@DESCRIPTION"
