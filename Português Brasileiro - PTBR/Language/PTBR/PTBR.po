msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@REVENANT_TEMPLE@NAME"
msgstr "Templo Mórbido"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@STARTER_QUEST_OBJECTIVE"
msgstr "{INT_0}/{INT_1} {GLOBAL.STRUCTURES.GOLDEN_ZIGGURAT.Hyperlink} Examinado"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@STORYREALM_VICTORY@ALT@DESCRIPTION"
msgstr "Você forçou seu caminho até o anel mais alto de Emnora, vislumbrando o Alto Conselho dos Arcontes e seus segredos Celestiais."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@STORYREALM_VICTORY@ALT@VICTORY"
msgstr "Infiltrou os Arcontes!"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@STORYREALM_VICTORY@DESCRIPTION"
msgstr "Você se comunicou com o Alto Conselho dos Arcontes, convencendo‑os a lutar contra as forças de Urrath lado a lado com Godir de Magehaven."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@STORYREALM_VICTORY@VICTORY"
msgstr "Contactou os Arcontes!"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@TITAN_XP_BONUS"
msgstr "Titan Smithcraft"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@TITAN_XP_BONUS@DESC"
msgstr "<<m:{GLOBAL.UnitConcept.Hyperlink}>> neste {GLOBAL.CityConcept.Hyperlink} são recrutados com +{Rankbonus1} [medalGold/] de Posto."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@TOOLTIP@ASTRA_CONVINCED"
msgstr "Você convence o {EventUnit} a ouvir {EventPlayer}."

