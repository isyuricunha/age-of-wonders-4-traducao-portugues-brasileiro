msgid "TOME_CYCLES@SKILL3@DESCRIPTION"
msgstr "Unidade inimiga alvo:[bulletlist][bullet/]Sofre {DIFFUSE_HEALTH_DAMAGE>DAMAGE>Blight} {GLOBAL.BlightDamageConcept.Hyperlink}.[bullet/]Ganha {amountDecaying} {GLOBAL.PROPERTIES.DECAYING_DAMAGE_OVER_TIME.Hyperlink}.[/bulletlist][br/]Unidades amigas em um alcance de {DIFFUSE_HEALTH_UNIT_TARGETER_FRIENDLY>AREA>Radius}‑hexágonos. [bulletlist][bullet/]Cura +{DIFFUSE_HEALTH_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Ganha {amountRegeneration} {GLOBAL.PROPERTIES.REGENERATION.Hyperlink}.[/bulletlist]"

msgid "TOME_CYCLES@SKILL3@NAME"
msgstr "Difusão de Saúde"

msgid "TOME_CYCLES@SKILL4@DESCRIPTION"
msgstr "Até o fim da batalha, sempre que uma unidade amiga morre, todas as outras unidades amigas dentro de {PARTING_GIFTS_UNIT_TARGETER_CIRCLE>AREA>Radius} hexágonos curam +{PARTING_GIFTS_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>."

msgid "TOME_CYCLES@SKILL4@NAME"
