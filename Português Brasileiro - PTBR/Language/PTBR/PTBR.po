msgid "TOME_REAPER@ABILITY_4@DESCRIPTION"
msgstr "[bulletlist][bullet/]Tem um {REAPER_UPKEEP_MODIFIER>FlatUpkeep} {GLOBAL.SoulConcept.Hyperlink} de manutenção adicional.[bullet/]{GLOBAL.GoldConcept.Hyperlink} e {GLOBAL.ManaConcept.Hyperlink} base {GLOBAL.UnitUpkeepConcept.Hyperlink} é reduzido em -{REAPER_UPKEEP_MODIFIER>ResolvedUpkeepModifier}%[/bulletlist]"

msgid "TOME_REAPER@ABILITY_4@NAME"
