msgstr "Faz com que os ataques base de unidades encantadas:[bulletlist][bullet/]Causem +{METEOR_ARROWS_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} ao alvo e inimigos adjacentes.[bullet/]Ganham {GLOBAL.PROPERTIES.DEMOLISHER.Hyperlink}, permitindo que destruam obstáculos reforçados.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CRUCIBLE@SKILL5@MOD_DESCRIPTION"
msgstr "[bulletlist][bullet/]+{METEOR_ARROWS_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} ao alvo e inimigos adjacentes.[bullet/]Possui {GLOBAL.PROPERTIES.DEMOLISHER.Hyperlink}[/bulletlist]"

