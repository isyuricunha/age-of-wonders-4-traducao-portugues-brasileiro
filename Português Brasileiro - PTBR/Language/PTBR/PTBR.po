msgid "DLC@GIANTKINGS@CRISIS_EVENT@CC_FINISHER@ORDER_RESEARCH_REWARD"
msgstr "A pesquisa de {GLOBAL.OrderConcept.Hyperlink} foi concluída neste reino durante o Conclave Cósmico.[br/]Suas cidades ganham uma pequena quantidade de {GLOBAL.CityStabilityConcept.Hyperlink} por 6[turn/]."

msgid "DLC@GIANTKINGS@CRISIS_EVENT@CC_FINISHER@SHADOW_RESEARCH_COMPLETED"
msgstr "Conclave Cósmico: Pesquisa de Sombra Concluída"

