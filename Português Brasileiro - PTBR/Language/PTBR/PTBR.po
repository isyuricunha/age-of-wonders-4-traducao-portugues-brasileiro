msgid "TOME_WARDING@SKILL5@DESCRIPTION"
msgstr "Inscreve guardas mágicas na raça-alvo, concedendo:[bulletlist][bullet/]+{MAGIAL_WARDS_RESISTANCE>REDUCTION>Shock} {GLOBAL.LightningResistanceConcept.Hyperlink}[bullet/]+{MAGIAL_WARDS_RESISTANCE>REDUCTION>Fire} {GLOBAL.FireResistanceConcept.Hyperlink}[bullet/]+{MAGIAL_WARDS_RESISTANCE>REDUCTION>Frost} {GLOBAL.FrostResistanceConcept.Hyperlink}[/bulletlist]"

msgid "TOME_WARDING@SKILL5@NAME"
msgstr "Guardas Mágicas"

msgid "TOME_WARDING@SKILL5@PROPERTY_DESCRIPTION"
msgstr "Unidade tem:[bulletlist][bullet/]+{MAGIAL_WARDS_RESISTANCE>REDUCTION>Shock} {GLOBAL.LightningResistanceConcept.Hyperlink}[bullet/]+{MAGIAL_WARDS_RESISTANCE>REDUCTION>Fire} {GLOBAL.FireResistanceConcept.Hyperlink}[bullet/]+{MAGIAL_WARDS_RESISTANCE>REDUCTION>Frost} {GLOBAL.FrostResistanceConcept.Hyperlink}[/bulletlist]"

msgid "TOME_WARDING@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Especialize-se em magia que protege suas unidades de dano e retalia contra inimigos que lhe atacam."

msgid "TOME_WARDING@TOME@LORE_AUTHOR"
msgstr "Tempest, Mestre das Tempestades"

msgid "TOME_WARDING@TOME@LORE_DESCRIPTION"
msgstr "\"Aqueles que dominam o arcano são como uma brisa suave sobre seus aliados, envolvendo‑os em um manto protetor de ar, afastando golpes e canalizando o relâmpago para castigar aqueles que ousam chegar muito perto! Um mestre da proteção encontrará inúmeras maneiras de manter seus súditos seguros.\""

msgid "TOME_WARDING@TOME@NAME"
msgstr "Tomo de Proteção"

msgid "TOME_WARDING@UNIT@NAME"
msgstr "Guerreiro Fantasma"

msgid "TOME_WILD@BEASTMASTER@ABILITY_1@DESCRIPTION"
