msgid "DLC@RISEFROMRUIN@EMPIRE_CORE@REALM_TRAITS@BARREN_AND_FRACTURED@DESCRIPTION"
msgstr "Este reino carrega cicatrizes de uma calamidade mágica.[bulletlist][bullet/]Regiões artesanais contendo {GLOBAL.SandConcept.Hyperlink} e {GLOBAL.AstralBarrensConcept.Hyperlink} são [abilityblue]comuns[/abilityblue].[bullet/]<<m:{GLOBAL.AncientWonderConcept.Hyperlink}>> arruinados, como o {GLOBAL.STRUCTURES.WITHERED_TREE.Hyperlink}, são mais [abilityblue]comuns[/abilityblue].[/bulletlist]"

msgid "DLC@RISEFROMRUIN@EMPIRE_CORE@REALM_TRAITS@BARREN_AND_FRACTURED@NAME"
