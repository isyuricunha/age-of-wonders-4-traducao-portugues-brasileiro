msgstr "Thorne^M"

msgid "DLC@THRONESOFBLOOD@ROSE_PALACE@REWARD_HERO_MALE@LASTNAME_01"
msgstr "das Rosas^z"

msgid "DLC@THRONESOFBLOOD@SECTORDEFINITIONS_STRATEGIC@CRIMSON_COURT_STRATEGIC_PROP@DESCRIPTION"
msgstr "[bulletlist][bullet/]Ganhe {amount} {GLOBAL.ManaConcept.Hyperlink} ao conseguir {GLOBAL.PillagingConcept.Hyperlink} um {GLOBAL.ProvinceImprovementConcept.Hyperlink}. [bullet/]Ganhe {amount2} {GLOBAL.ManaConcept.Hyperlink} ao conseguir {GLOBAL.RazingConcept.Hyperlink} um {GLOBAL.CityConcept.Hyperlink} por {GLOBAL.PopulationConcept.Hyperlink} e {GLOBAL.ProvinceImprovementConcept.Hyperlink} que não foi Saqueada. [bullet/]Ganhe {amount3} {GLOBAL.ManaConcept.Hyperlink} ao conseguir {GLOBAL.MigratingConcept.Hyperlink} um {GLOBAL.CityConcept.Hyperlink} por {GLOBAL.PopulationConcept.Hyperlink}. Mas a Cidade perde [population/] População adicional depois. [bullet/]<<m:{GLOBAL.PvEVassalConcept.Hyperlink}>> concede {amount4} {GLOBAL.ManaConcept.Hyperlink} renda por {GLOBAL.PopulationConcept.Hyperlink}. [/bulletlist]"

msgid "DLC@THRONESOFBLOOD@SECTORDEFINITIONS_STRATEGIC@CRIMSON_COURT_STRATEGIC_PROP@HYPERLINK"
msgstr "[hyperlink,GLOBAL.CrimsonCourtMagistrateConcept]Crimson Court Magistrate[/hyperlink]"

msgid "DLC@THRONESOFBLOOD@SECTORDEFINITIONS_STRATEGIC@CRIMSON_COURT_STRATEGIC_PROP@NAME"
msgstr "Magistrado da Corte Carmesim"

msgid "DLC@THRONESOFBLOOD@SECTORDEFINITIONS_STRATEGIC@SUNLESS_FEATURE@DESCRIPTION"
msgstr "A {GLOBAL.ProvinceFeatureConcept.Hyperlink}[br/][br/]ausência de luz solar espalhou flora espinhosa e sombria pontilhada de rosas carmesim.[br/][bulletlist][bullet/]<<m:{GLOBAL.CityConcept.Hyperlink}>> anexando este {GLOBAL.ProvinceConcept.Hyperlink} sofrer {stabilitypenalty} {GLOBAL.CityStabilityConcept.Hyperlink}.[bullet/]<<m:{GLOBAL.UnitConcept.Hyperlink}>> regenera {regen} <<m:{GLOBAL.HitPointConcept.Hyperlink}>> por {GLOBAL.TurnConcept.Hyperlink} na {GLOBAL.WorldMapConcept.Hyperlink}.[bullet/]<<m:{GLOBAL.UnitConcept.Hyperlink}>> só recebe {percentage} de <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> ao ser curado em {GLOBAL.CombatConcept.Hyperlink}.[bullet/]Unidades e Cidades que possuem {GLOBAL.PROPERTIES.HEARTLESS.Hyperlink} ou que pertencem a um império liderado por um {GLOBAL.VampireLordConcept.Hyperlink} são imunes a esses efeitos.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@SECTORDEFINITIONS_STRATEGIC@SUNLESS_FEATURE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.SunlessConcept]Sombrio[/hyperlink]"

msgid "DLC@THRONESOFBLOOD@SECTORDEFINITIONS_STRATEGIC@SUNLESS_FEATURE@NAME"
msgstr "Sombrio"

msgid "DLC@THRONESOFBLOOD@SECTORDEFINITIONS_STRATEGIC@SUNLESS_FEATURE@PROPERTY_DESCRIPTION"
msgstr "Unidades sem {GLOBAL.PROPERTIES.HEARTLESS.Hyperlink} em terreno Sombrio regeneram {regen} <<m:{GLOBAL.HitPointConcept.Hyperlink}>> por {GLOBAL.TurnConcept.Hyperlink} na {GLOBAL.WorldMapConcept.Hyperlink} e recebem apenas {percentage} de <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> ao serem curadas em {GLOBAL.CombatConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@SHAREDMODIFIERS_UNITPROPERTIES@BENEVOLENT_BLOOD_PARASITE@DESCRIPTION"
msgstr "Ao morrer, a unidade gera um {GLOBAL.UNITS.BLOOD_MAGGOT.Hyperlink} sob controle do defensor até o fim do combate."

msgid "DLC@THRONESOFBLOOD@SHAREDMODIFIERS_UNITPROPERTIES@BENEVOLENT_BLOOD_PARASITE@NAME"
msgstr "Parasita de Sangue Benevolente"

msgid "DLC@THRONESOFBLOOD@SHAREDMODIFIERS_UNITPROPERTIES@BERSERK_BLOOD_PARASITE@DESCRIPTION"
msgstr "Ao morrer, a unidade gera um {GLOBAL.UNITS.BLOOD_MAGGOT.Hyperlink} com {GLOBAL.PROPERTIES.BERSERK.Hyperlink} sob controle do defensor até o fim do combate."

