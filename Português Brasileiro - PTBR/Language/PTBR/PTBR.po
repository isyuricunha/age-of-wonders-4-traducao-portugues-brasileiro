msgid "TOME_SUPREMACY@SKILL2@NAME"
msgstr "Monumento da Supremacia"

msgid "TOME_SUPREMACY@SKILL2@STRUCTURE_DESCRIPTION"
msgstr "{stability} {GLOBAL.CityStabilityConcept.Hyperlink} por Monumento da Supremacia em seu império."

msgid "TOME_SUPREMACY@SKILL3@DESCRIPTION"
msgstr "Exército inimigo alvo:[bulletlist][bullet/]Recebe {damage} {GLOBAL.SpiritDamageConcept.Hyperlink}[bullet/]Torna-se {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink} por {turn} {GLOBAL.WorldMapConcept.Hyperlink} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "TOME_SUPREMACY@SKILL3@NAME"
msgstr "Condenar Exército"

msgid "TOME_SUPREMACY@SKILL4@DESCRIPTION"
msgstr "Para unidades encantadas:[bulletlist][bullet/]Concede {GLOBAL.PROPERTIES.ZEAL.Hyperlink}, que faz os ataques causarem {GLOBAL.SpiritDamageConcept.Hyperlink} extra.[bullet/]Os ataques ignoram {SUPREME_MAGIC_RESISTANCE_CHECK_BYPASS>ResistanceBypass} {GLOBAL.StatusResistanceConcept.Hyperlink}.[bullet/]Matar uma unidade faz com que ela exploda, causando {SUPREME_MAGIC_UNIT_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink} às unidades inimigas adjacentes.[/bulletlist]"

msgid "TOME_SUPREMACY@SKILL4@MODIFIER_DESCRIPTION"
msgstr "Matar uma unidade faz com que ela exploda, causando {SUPREME_MAGIC_UNIT_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink} às unidades inimigas adjacentes."

msgid "TOME_SUPREMACY@SKILL4@NAME"
msgstr "Magia Suprema"

msgid "TOME_SUPREMACY@SKILL4@PROPERTY_DESCRIPTION"
msgstr "[bulletlist][bullet/]Unidade tem {GLOBAL.PROPERTIES.ZEAL.Hyperlink}.[bullet/]Os ataques ignoram {SUPREME_MAGIC_RESISTANCE_CHECK_BYPASS>ResistanceBypass} {GLOBAL.StatusResistanceConcept.Hyperlink}.[bullet/]Matar uma unidade faz com que ela exploda, causando {SUPREME_MAGIC_UNIT_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink} às unidades inimigas adjacentes.[/bulletlist]"

msgid "TOME_SUPREMACY@SKILL5@DESCRIPTION"
msgstr "Todas as unidades aliadas recebem:[bulletlist][bullet/]{strengthened} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}.[bullet/]+{ANTHEM_OF_VICTORY_CHANGE_MORALE>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_SUPREMACY@SKILL5@NAME"
msgstr "Hino da Vitória"

msgid "TOME_SUPREMACY@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Lidere seu povo rumo a uma vitória gloriosa. Especialize-se em aumentar {GLOBAL.UnitMoraleConcept.Hyperlink.} e administrar um grande império."

msgid "TOME_SUPREMACY@TOME@LORE_AUTHOR"
msgstr "Inioch, Imperador da Corte Élfica"

msgid "TOME_SUPREMACY@TOME@LORE_DESCRIPTION"
msgstr "\"Nós, que buscamos pastorear e guiar nosso povo, somos agraciados com um propósito glorioso. Essa glória justa surge de nosso próprio ser, permeando a carne e o espírito de nossos súditos, e inspirando-os à grandeza! A vitória, para aqueles que trilham este caminho divino, não é uma possibilidade, mas uma certeza.\""

msgid "TOME_SUPREMACY@TOME@NAME"
msgstr "Tomo da Supremacia"

msgid "TOME_SUPREMACY@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Unidades amigas dentro de um raio de {EMBOLDEN_ALLIES_CIRCLE_AROUND_CASTER>AREA>Radius} hexágonos recebem, por {RALLYING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>: [bulletlist][bullet/]{amount} {GLOBAL.PROPERTIES.RALLYING.Hyperlink}.[bullet/]{strengthened} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}.[/bulletlist][br/]Entrar {GLOBAL.DefenseModeConcept.Hyperlink}."

msgid "TOME_SUPREMACY@UNIT1@ABILITY1@NAME"
msgstr "Encorajar Aliados"

msgid "TOME_SUPREMACY@UNIT1@ABILITY2@DESCRIPTION"
msgstr "Enquanto em combate, esta e todas as demais unidades amigas têm um modificador de +{INSPIRING_PRESENCE_MORALE_RESISTANCE>ResolvedMoraleRiseModifier}% ao ganho de {GLOBAL.UnitMoraleConcept.Hyperlink} positivo.[br/][br/]Este efeito não acumula."

msgid "TOME_SUPREMACY@UNIT1@ABILITY2@NAME"
msgstr "Presença Inspiradora"

msgid "TOME_SUPREMACY@UNIT1@ABILITY2@PROPERTY@NAME"
msgstr "Inspirado"

msgid "TOME_SUPREMACY@UNIT1@ABILITY2@PROPERY@DESCRIPTION"
msgstr "Ganha {GLOBAL.UnitMoraleConcept.Hyperlink} {INSPIRING_PRESENCE_MORALE_RESISTANCE>ResolvedMoraleRiseModifier}% faster."

msgid "TOME_TELEPORTATION@HERO_SKILL@DESCRIPTION"
msgstr "Faz o conjurador teleportar para o hexágono alvo."

msgid "TOME_TELEPORTATION@HERO_SKILL@NAME"
msgstr "Fase Rápida"

msgid "TOME_TELEPORTATION@PASSIVE@DESCRIPTION"
msgstr "Todos os <<m:{GLOBAL.ProvinceConcept}>> podem ser definidos como ponto de geração de exército da Cidade."

msgid "TOME_TELEPORTATION@PASSIVE@NAME"
msgstr "Portais de Implantação"

msgid "TOME_TELEPORTATION@SKILL1@DESCRIPTION"
msgstr "Faz o exército aliado alvo teleportar de volta à cidade mais próxima que você possui."

msgid "TOME_TELEPORTATION@SKILL1@NAME"
msgstr "Recall em Massa"

msgid "TOME_TELEPORTATION@SKILL2@DESCRIPTION"
msgstr "Invoca um {GLOBAL.UNITS.PHASE_BEAST_UNIT.Hyperlink} no hexágono mundial alvo."

msgid "TOME_TELEPORTATION@SKILL2@NAME"
msgstr "Invocar Besta de Fase"

msgid "TOME_TELEPORTATION@SKILL3@DESCRIPTION"
msgstr "Teleporta a unidade aliada mais próxima dentro de {EMERGENCY_TELEPORTATION_UNIT_TARGETER_NEAREST_TO_TARGET>MaxDista} hexágonos para o hexágono vazio alvo.[br/]Essa unidade cura +{EMERGENCY_TELEPORTATION_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> e tem todos os <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>> removidos."

msgid "TOME_TELEPORTATION@SKILL3@NAME"
msgstr "Teleporte de Emergência"

msgid "TOME_TELEPORTATION@SKILL4@DESCRIPTION"
msgstr "Concede às unidades encantadas:[bulletlist][bullet/]A habilidade {GLOBAL.PROPERTIES.CHARGED_PHASE_TELEPORT.Hyperlink}, que permite que elas teleportem em batalha.[/bulletlist]"

msgid "TOME_TELEPORTATION@SKILL4@NAME"
msgstr "Encantamento de Fase"

msgid "TOME_TELEPORTATION@SKILL4@PROPERTY_DESCRIPTION"
msgstr "Unidade tem:[bulletlist][bullet/]A habilidade {GLOBAL.PROPERTIES.CHARGED_PHASE_TELEPORT.Hyperlink}.[/bulletlist]"

msgid "TOME_TELEPORTATION@SKILL5@DESCRIPTION"
msgstr "[bulletlist][bulletlist][bullet/]{gold} renda de {GLOBAL.GoldConcept.Hyperlink}.[bullet/]{goldStack} renda de {GLOBAL.GoldConcept.Hyperlink} para cada Relé de Comércio Astral construído em seu império.[/bulletlist][/bulletlist]"

msgid "TOME_TELEPORTATION@SKILL5@NAME"
msgstr "Repetidor Comercial Astral"

msgid "TOME_TELEPORTATION@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Explore ao máximo a magia espacial. Reposicione estrategicamente suas unidades em batalha em um instante."

msgid "TOME_TELEPORTATION@TOME@LORE_AUTHOR"
msgstr "Laryssa Mirabilis, Feiticeira da Comunidade"

msgid "TOME_TELEPORTATION@TOME@LORE_DESCRIPTION"
msgstr "\"O mago que utiliza plenamente o potencial da magia para ampliar suas opções táticas no campo de batalha... esse é um mago astuto. Imagine um comandante desamparado, todo preparado para um ataque iminente, e de repente se vê cercado por um ataque de pinça. A arte da teletransporte oferece possibilidades infinitas ao verdadeiro estrategista criativo.\""

msgid "TOME_TELEPORTATION@TOME@NAME"
msgstr "Tomo de Teleporte"

msgid "TOME_TELEPORTATION@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Executa um ataque de Carga de Fase que:[bulletlist][bullet/]Teleporta a unidade para trás do alvo.{LOC.CONCEPT@CHARGE_SHARED}[/bulletlist]"

msgid "TOME_TELEPORTATION@UNIT1@ABILITY1@NAME"
msgstr "Carga de Fase"

msgid "TOME_TELEPORTATION@UNIT1@DESCRIPTION"
msgstr "Uma unidade de choque ágil e evasiva, capaz de teletransporte."

msgid "TOME_TELEPORTATION@UNIT1@NAME"
msgstr "Fera de Fase^n"

msgid "TOME_TERRA@@SKILL6@NAME"
msgstr "Montanhas Baixas"

msgid "TOME_TERRA@HERO_SKILL@DESCRIPTION"
msgstr "Faz com que ataques base {GLOBAL.MeleeConcept.Hyperlink} ganhem:[bulletlist][bullet/]+{LEADEN_BLOW_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Chance base {SLOWED_RESISTANCE>ResolvedStrength}% c de infligir {GLOBAL.PROPERTIES.SLOWED.Hyperlink}.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_TERRA@HERO_SKILL@NAME"
msgstr "Golpes de Chumbo"

msgid "TOME_TERRA@SKILL1@DESCRIPTION"
msgstr "Unidade inimiga alvo:[bulletlist][bullet/]Sustenta {CRUSHING_EARTH_UNIT_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Sofre {amount} {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink} por {SUNDERED_DEFENSE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Tem uma chance base {STUNNED_RESISTANCE>ResolvedStrength}% c de se tornar {GLOBAL.PROPERTIES.STUNNED.Hyperlink} por {STUNNED_EFFECT_DESCRIPTION>NumTurns} {GLOBAL.TurnConcept}.[/bulletlist]"

msgid "TOME_TERRA@SKILL1@NAME"
msgstr "Terra Esmagadora"

msgid "TOME_TERRA@SKILL2@DESCRIPTION"
msgstr "Causa {SEISMIC_SHOCK_UNIT_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink} a unidades em um raio de {SEISMIC_SHOCK_OBSTACLE_TARGETER>AREA>Radius} hexágonos e inflige {GLOBAL.PROPERTIES.SLOWED.Hyperlink}.[br/]Esta magia causa dano dobrado a obstáculos."

msgid "TOME_TERRA@SKILL2@NAME"
msgstr "Choque Sísmico"

msgid "TOME_TERRA@SKILL3@DESCRIPTION"
msgstr "Na {GLOBAL.ProvinceConcept.Hyperlink} alvo habitável ou inabitável:[bulletlist][bullet/]Inimigo <<m:{GLOBAL.UnitConcept.Hyperlink}>> sofre {damage}.[bullet/]A província perde quaisquer {GLOBAL.MountainConcept.Hyperlink}, {GLOBAL.StalagmitesConcept.Hyperlink} e {GLOBAL.DiggableEarthConcept.Hyperlink}.[bullet/]Invoca um {GLOBAL.UNITS.STONE_SPIRIT.Hyperlink} no hexágono alvo.[/bulletlist]"

msgid "TOME_TERRA@SKILL3@NAME"
msgstr "Rachadura da Terra"

msgid "TOME_TERRA@SKILL4@DESCRIPTION"
msgstr "[bulletlist][bullet/]Em batalha, a cada {turn} uma unidade inimiga aleatória é atingida por um terremoto:[bulletlist][bullet/]Unidades inimigas não voadoras e não flutuantes dentro de um raio de {range} hexágonos recebem {damage}.[bullet/]Unidades inimigas não voadoras e não flutuantes dentro de um raio de {range} hexágonos têm {chance} de chance de sofrer {GLOBAL.PROPERTIES.SLOWED.Hyperlink} por {turn2}.[bullet/]Obstáculos, incluindo Muros, Torres e Bastiões dentro de um raio de {range} hexágonos são destruídos.[/bulletlist][/bulletlist]"

msgid "TOME_TERRA@SKILL4@NAME"
msgstr "Ritual de Tremor"

msgid "TOME_TERRA@SKILL5@DESCRIPTION"
msgstr "Invoca um {GLOBAL.UNITS.ROCK_GIANT.Hyperlink}, um {GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink} que arremessa pedregulhos que atrapalham inimigos e os esmaga com tremores semelhantes a terremotos."

msgid "TOME_TERRA@SKILL5@NAME"
msgstr "Invocar Gigante de Rocha"

msgid "TOME_TERRA@SKILL6@BUFF_DESCRIPTION"
msgstr "Até que a unidade se mova, ela tem:[bulletlist][bullet/]+{LEY_LINE_FOCUS_DAMAGE_MULT>ResolvedMultiplier}% ddano[bullet/]+{LEY_LINE_FOCUS_DEFENSE>DEF_MOD>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_TERRA@SKILL6@DESCRIPTION"
msgstr "Unidades encantadas recebem:[bulletlist][bullet/]No início do turno e até que a unidade se mova, esta unidade tem:[bulletlist][bullet/]+{LEY_LINE_FOCUS_DAMAGE_MULT>ResolvedMultiplier}% ddano[bullet/]+{LEY_LINE_FOCUS_DEFENSE>DEF_MOD>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}.[/bulletlist][/bulletlist]"

msgid "TOME_TERRA@SKILL6@MOD_DESCRIPTION"
msgstr "+{LEY_LINE_FOCUS_DAMAGE_MULT>ResolvedMultiplier}% ddano até mover."

msgid "TOME_TERRA@SKILL6@NAME"
msgstr "Foco da Linha Ley"

msgid "TOME_TERRA@SKILL6@PROP_DESCRIPTION"
msgstr "No início do turno e até que a unidade se mova, esta unidade tem:[bulletlist][bullet/]+{LEY_LINE_FOCUS_DAMAGE_MULT>ResolvedMultiplier}% ddano[bullet/]+{LEY_LINE_FOCUS_DEFENSE>DEF_MOD>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}[/bulletlist]"

msgid "TOME_TERRAMANCY@PASSIVE@DESCRIPTION"
msgstr "<<m:{GLOBAL.CityConcept}>> recebem {amount} {GLOBAL.FortificationHealthConcept} por cada Rocha {GLOBAL.ProvinceConcept}."

msgid "TOME_TERRAMANCY@PASSIVE@NAME"
msgstr "Moldadores da Terra"

msgid "TOME_TERRAMANCY@TOME@GAMEPLAY"
msgstr "Manipule a terra à vontade. Especialize-se em causar {GLOBAL.PhysicalDamageConcept.Hyperlink} e dificultar o movimento inimigo."

msgid "TOME_TERRAMANCY@TOME@LORE"
msgstr "\"Ignore os magos medianos que buscam ressuscitar os mortos ou dominar relâmpagos e fogo para lançar contra você. Esses tolos desconhecem o poder que repousa sob seus próprios pés! Mas eles... nos momentos finais de suas existências insignificantes, quando você os enterrar sob uma montanha e despedaçar a terra sob suas cidades.\""

msgid "TOME_TERRAMANCY@TOME@LORE_AUTHOR"
msgstr "Mãe Mab, Deusa dos Goblins"

msgid "TOME_TERRAMANCY@TOME@NAME"
msgstr "Tomo de Terramança"

msgid "TOME_TRANSMUTATION@PASSIVE@DESCRIPTION"
msgstr "Pedreiras concedem {amount} {GLOBAL.FoodConcept}."

msgid "TOME_TRANSMUTATION@PASSIVE@NAME"
msgstr "Transustento"

msgid "TOME_TRANSMUTATION@SKILL1@DESCRIPTION"
msgstr "Uma vez a cada {GLOBAL.TurnConcept}, sempre que unidades encantadas são danificadas por ataques ou feitiços {GLOBAL.MagicConcept.Hyperlink}, elas recebem:[bulletlist][bullet/]{GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink}, aumentando sua resistência a dano mágico.[bullet/]{GLOBAL.PROPERTIES.STATUS_PROTECTION.Hyperlink}, reduzindo a chance de a unidade ser afetada por <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>>.[/bulletlist]"

msgid "TOME_TRANSMUTATION@SKILL1@NAME"
msgstr "Armadura Adaptativa"

msgid "TOME_TRANSMUTATION@SKILL1@PROP_DESCRIPTION"
msgstr "Uma vez a cada {GLOBAL.TurnConcept}, quando esta unidade é danificada por ataques ou feitiços {GLOBAL.MagicConcept.Hyperlink}, ela recebe:[bulletlist][bullet/]{GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.STATUS_PROTECTION.Hyperlink}[/bulletlist]"

msgid "TOME_TRANSMUTATION@SKILL2@DESCRIPTION"
msgstr "A cidade-alvo controlada converte sua renda de {GLOBAL.ManaConcept}, ganhando renda de {GLOBAL.GoldConcept}, {GLOBAL.StructureProductionConcept} e {GLOBAL.FoodConcept} igual a {amount}% o da renda de {GLOBAL.ManaConcept}."

msgid "TOME_TRANSMUTATION@SKILL2@NAME"
msgstr "Transmutar Recursos"

msgid "TOME_TRANSMUTATION@SKILL3@DESCRIPTION"
msgstr "Alveje inimigos em um raio de {MELT_ARMOR_OBSTACLE_TARGETER_CIRCLE>AREA>Radius} hexágonos:[bulletlist][bullet/]Ganhe {stacks} {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink}.[bullet/]Sustente {MELT_ARMOR_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_TRANSMUTATION@SKILL3@NAME"
msgstr "Derreter Armadura"

msgid "TOME_TRANSMUTATION@SKILL4@DESCRIPTION"
msgstr "Um {GLOBAL.PROPERTIES.BATTLE_MAGE.Hyperlink} que transforma inimigos em ouro e pode roubar sua armadura e concedê‑la às unidades amigas."

msgid "TOME_TRANSMUTATION@SKILL4@NAME"
msgstr "Transmutador"

msgid "TOME_TRANSMUTATION@SKILL5@DESCRIPTION"
msgstr "Transmuta a pele da raça-alvo em aço, concedendo a eles:[bulletlist][bullet/]+{STEELSKIN_DEFENSE>REDUCTION>Physical} {GLOBAL.PhysicalResistanceConcept.Hyperlink}.[bullet/]+{STEELSKIN_DEFENSE>REDUCTION>Blight} {GLOBAL.BlightResistanceConcept.Hyperlink}[bullet/]{STEELSKIN_DEFENSE>REDUCTION>Shock} {GLOBAL.LightningResistanceConcept.Hyperlink}[/bulletlist]"

msgid "TOME_TRANSMUTATION@SKILL5@NAME"
msgstr "Pele de Aço"

msgid "TOME_TRANSMUTATION@SKILL5@PROP_DESCRIPTION"
msgstr "Unidade tem:[bulletlist][bullet/]+{STEELSKIN_DEFENSE>REDUCTION>Physical} {GLOBAL.PhysicalResistanceConcept.Hyperlink}.[bullet/]+{STEELSKIN_DEFENSE>REDUCTION>Blight} {GLOBAL.BlightResistanceConcept.Hyperlink}.[bullet/]{STEELSKIN_DEFENSE>REDUCTION>Shock} {GLOBAL.LightningResistanceConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_TRANSMUTATION@TOME@GAMEPLAY@DESCRIPTION"
msgstr "Altera substâncias físicas usando grandes quantidades de mana. Especializa‑se em enfraquecer inimigos, fortalecer aliados e transformar sua economia."

msgid "TOME_TRANSMUTATION@TOME@LORE@AUTHOR"
msgstr "Tugrum Hammerhall, Mestre Artífice Anão"

msgid "TOME_TRANSMUTATION@TOME@LORE@DESCRIPTION"
msgstr "\"Uma vez dominado o reino mineral, pode‑se alcançar o realmente maravilhoso. Imagine a capacidade de manipular e alterar a própria natureza física. Olhar para uma substância e decidir \\\"não ser isto, ser aquilo em vez\\\". E assim pode‑se começar a compreender o que pode ser alcançado ao dominar os inúmeros dons da transmutação.\""

msgid "TOME_TRANSMUTATION@TOME@NAME"
msgstr "Tomo de Transmutação"

msgid "TOME_TRANSMUTATION@UNIT1@ABILITY1@BOLT_NAME"
msgstr "Setas Derretidas"

msgid "TOME_TRANSMUTATION@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Inflige {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink} enquanto concede {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink} a um aliado aleatório dentro de {SHIFT_ARMOR_UNIT_TARGETER_JUMP>MaxDistance} hexágonos."

msgid "TOME_TRANSMUTATION@UNIT1@ABILITY1@NAME"
msgstr "Deslocar Armadura"

msgid "TOME_TRANSMUTATION@UNIT1@ABILITY2@DESCRIPTION"
msgstr "Unidades inimigas em um raio de {TRANSMUTE_UNIT_TARGETER_CIRCLE>AREA>Radius} hexágonos:[bulletlist][bullet/]Sustentam dano.[bullet/]Ganham {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink} por {SUNDERED_DEFENSE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Ganham {GLOBAL.PROPERTIES.SUNDERED_RESISTANCE.Hyperlink} por {SUNDERED_RESISTANCE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][br/]Se bem‑sucedido, conceda {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink} e {GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink} por {SUNDERED_DEFENSE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>> a todas as unidades amigas dentro de {TRANSMUTE_CIRCLE_ROUND_CASTER>AREA>Radius} hexágonos do conjurador."

msgid "TOME_TRANSMUTATION@UNIT1@ABILITY2@MASTER_DESCRIPTION"
msgstr "Unidades inimigas em um raio de {TRANSMUTE_UNIT_TARGETER_CIRCLE>AREA>Radius} hexágonos:[bulletlist][bullet/]Sustentam dano.[bullet/]Ganham {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink} por {SUNDERED_DEFENSE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Têm uma base {GILDED_RESISTANCE>ResolvedStrength}% cchance de se tornar {GLOBAL.PROPERTIES.GILDED.Hyperlink} por {GILDED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][br/]Se bem‑sucedido, conceda {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink} por {SUNDERED_DEFENSE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>> a todas as unidades amigas dentro de {TRANSMUTE_CIRCLE_ROUND_CASTER>AREA>Radius} hexágonos do conjurador."

msgid "TOME_TRANSMUTATION@UNIT1@ABILITY2@MASTER_NAME"
msgstr "Campeão da Transmutação"

msgid "TOME_TRANSMUTATION@UNIT1@ABILITY2@MASTER_PROP_DESCRIPTION"
msgstr "Transmutar:[bulletlist][bullet/]Ganha uma base {GILDED_RESISTANCE>ResolvedStrength}% cchance de infligir {GLOBAL.PROPERTIES.GILDED.Hyperlink} aos inimigos.[/bulletlist]"

msgid "TOME_TRANSMUTATION@UNIT1@ABILITY2@NAME"
msgstr "Transmutar"

msgid "TOME_TRANSMUTATION@UNIT@NAME"
msgstr "Transmutador^f"

msgid "TOME_UNDEATH@UNIT_2@NAME"
msgstr "Zumbi"

msgid "TOME_VIGOR@HERO_SKILL@DESCRIPTION"
msgstr "Enquanto esta unidade for a líder do exército, unidades não‑herói ganham:[bulletlist][bullet/]+{VIGOROUS_LEADER_STAT_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]Cura +{VIGOROUS_LEADER_STAT_BONUS>BONUS>Regen} <<m:{GLOBAL.HitPointConcept.Hyperlink}>> por turno no mapa‑mundo.[/bulletlist]"

msgid "TOME_VIGOR@HERO_SKILL@NAME"
msgstr "Líder Vigoroso"

msgid "TOME_VIGOR@PASSIVE@DESCRIPTION"
msgstr "<<m:{GLOBAL.NodeConcept}>> em seu {GLOBAL.DomainConcept} concedem {amount} {GLOBAL.FoodConcept.Hyperlink} e {GLOBAL.UnitProductionConcept.Hyperlink}."

msgid "TOME_VIGOR@PASSIVE@NAME"
msgstr "Jardins Antigos"

msgid "TOME_VIGOR@SKILL1@DESCRIPTION"
msgstr "A unidade alvo {GLOBAL.PROPERTIES.ANIMAL.Hyperlink} ou {GLOBAL.PROPERTIES.CAVALRY_GROUP.Hyperlink} ganha, por {UNLEASH_BEAST_STATUS_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>:[bulletlist][bullet/]{amount2} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}[bullet/]{amount3} {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.BERSERK.Hyperlink}.[/bulletlist]"

msgid "TOME_VIGOR@SKILL1@NAME"
msgstr "Liberar Besta"

msgid "TOME_VIGOR@SKILL2@DESCRIPTION"
msgstr "[bulletlist][bullet/]Escolha uma unidade de Nível III ou Nível IV {GLOBAL.PROPERTIES.ANIMAL.Hyperlink} para adicionar ao seu exército.[bullet/]Os <<m:{GLOBAL.PROPERTIES.ANIMAL.Hyperlink}>> disponíveis dependem do tipo de terreno onde o feitiço é lançado.[/bulletlist]"

msgid "TOME_VIGOR@SKILL2@NAME"
msgstr "Invocar Animal Maior"

msgid "TOME_VIGOR@SKILL3@DESCRIPTION"
msgstr "Faz a raça-alvo crescer em massa e estatura, concedendo a ela:[bulletlist][bullet/]+{SUPERGROWTH_STAT_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[bullet/]+{VIGILANT_NUM_OVERWATCH>NumTriggersToAdd} {GLOBAL.RetaliationConcept.Hyperlink}.[bullet/]Número reduzido de unidades na formação.[/bulletlist][br/]Esta transformação é incompatível com {GLOBAL.PROPERTIES.SPAWNKIN_PROPERTY_GROUP.Hyperlink}."

msgid "TOME_VIGOR@SKILL3@NAME"
msgstr "Supercrescimento"

msgid "TOME_VIGOR@SKILL3@PROP_DESCRIPTION"
msgstr "Unidade tem:[bulletlist][bullet/]+{SUPERGROWTH_STAT_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]+{VIGILANT_NUM_OVERWATCH>NumTriggersToAdd} {GLOBAL.RetaliationConcept.Hyperlink}[/bulletlist]"

msgid "TOME_VIGOR@SKILL4@DESCRIPTION"
