msgid "TOME_ARTIFICING@SKILL1@DESCRIPTION"
msgstr "[bulletlist]No início da batalha, ganha {amount} {GLOBAL.UNITS.BOLT_REPEATER_UNIT.Hyperlink} unidades do lado do atacante até o fim da batalha.[bullet/] <<m:{GLOBAL.UNITS.BOLT_REPEATER_UNIT.Hyperlink}>> são imóveis {GLOBAL.PROPERTIES.SIEGECRAFT_UNIT.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> com ataques de área de longo alcance que se repetem, ao contrário de <<m:{GLOBAL.UNITS.CATAPULT_UNIT.Hyperlink}>>.[bullet/]Apenas um tipo de unidade de Cerco pode ser trazido para {GLOBAL.CombatConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_ARTIFICING@SKILL1@NAME"
msgstr "Construtor de Repetidores de Raio"

