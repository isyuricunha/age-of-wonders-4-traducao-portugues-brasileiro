msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@LITHORITE_PEAKS@DESCRIPTION"
msgstr "<<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacente a este Marco ganha:[bulletlist][bullet/]{income} e {income2}.[bullet/]Permite a construção de um(a) {GLOBAL.ConduitConcept.Hyperlink}.[bullet/]O {combatproperty} {GLOBAL.CombatEnchantmentConcept.Hyperlink}.[/bulletlist][br/]Um {GLOBAL.CityConcept.Hyperlink} com {amount} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacente a este Marco ganha:[bulletlist][bullet/]Desbloqueia o recrutamento de Lithorine <<m:{GLOBAL.UnitConcept.Hyperlink}>>.[bullet/]{income3} e {income4}.[/bulletlist]"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@LITHORITE_PEAKS@LORE"
msgstr "\"Ao contrário da magia 'fria' do Cristal de Foco, a Lithorite emite um calor pulsante. Talvez seja por isso que os antigos [hyperlink,GLOBAL.GiantKingLoreConcept]Reis Gigantes[/hyperlink] escolheram este material para a criação de criaturas Lithorinas. Embora sejam relativamente comuns, grandes aglomerados do próprio material são raros. Quando o sol ilumina os picos de cristal, é realmente um espetáculo de se admirar.\"[br/][br/]— Edward Portsmith, Relatórios Avançados sobre Infusão de Mana"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@LITHORITE_PEAKS@NAME"
msgstr "Picos Lithorinos"

