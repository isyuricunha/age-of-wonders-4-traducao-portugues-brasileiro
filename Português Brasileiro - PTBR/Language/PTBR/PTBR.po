msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@DRAGON_REMAINS@DESCRIPTION"
msgstr "<<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacente a este Marco ganha:[bulletlist][bullet/]{income}[bullet/]O {combatproperty} {GLOBAL.CombatEnchantmentConcept.Hyperlink}[/bulletlist][br/]Um {GLOBAL.CityConcept.Hyperlink} com {amount} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacente a este Marco ganha:[bulletlist][bullet/]Desbloqueia o recrutamento de unidades de nível 4 e 5 {GLOBAL.PROPERTIES.DRAGON.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>>.[/bulletlist]"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@DRAGON_REMAINS@LORE"
msgstr "\"Observando os vestígios do que antes foi um magnífico tesouro, não se pode deixar de contemplar o [hyperlink,GLOBAL.DragonsLoreConcept]Dragão[/hyperlink] que caiu aqui, e sua rivalidade destrutiva com o {GLOBAL.GiantsLoreConcept.Hyperlink}. Veja como até os ossos ainda parecem proteger seus tesouros. Enquanto o vento uivava pelos picos, juro que ainda podia ouvir o antigo rugido do dragão...\"[br/][br/]— Fangir Rockborne, Diários da Segunda Era: Parte II"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@DRAGON_REMAINS@NAME"
