msgstr "Escolhido de Onoka"

msgid "FEY_INVASION@SIEGE_EVENT@AFFINITY_BUTTON@ASTRAL@FAILURE"
msgstr "A canção Feérica aumenta, até se tornar um ruído quase ensurdecedor."

msgid "FEY_INVASION@SIEGE_EVENT@AFFINITY_BUTTON@ASTRAL@HEADER"
msgstr "Tente silenciar os Feéricos com uma poderosa barreira astral:"

msgid "FEY_INVASION@SIEGE_EVENT@AFFINITY_BUTTON@ASTRAL@SUCCESS"
msgstr "As vozes assustadoras além dos portões se acalmam, e seu povo recupera a sanidade."

msgid "FEY_INVASION@SIEGE_EVENT@AFFINITY_BUTTON@MATERIUM@FAILURE"
msgstr "As vítimas desamparadas dos Feéricos ainda encontram fissuras e buracos pelos quais escapam."

msgid "FEY_INVASION@SIEGE_EVENT@AFFINITY_BUTTON@MATERIUM@HEADER"
msgstr "Tente selar as paredes para torná‑las intransponíveis:"

msgid "FEY_INVASION@SIEGE_EVENT@AFFINITY_BUTTON@MATERIUM@SUCCESS"
msgstr "Mesmo em seu mais selvagem encantamento, o povo de {EventCity} não pode deixar a cidade."

msgid "FEY_INVASION@SIEGE_EVENT@AFFINITY_BUTTON@SHADOW@FAILURE"
msgstr "Os pesadelos que você provocou fazem ainda mais pessoas fugirem além dos portões da cidade."

msgid "FEY_INVASION@SIEGE_EVENT@AFFINITY_BUTTON@SHADOW@HEADER"
msgstr "Tente aprisionar o povo de {EventCity} em prisões mentais de sua própria criação:"

msgid "FEY_INVASION@SIEGE_EVENT@AFFINITY_BUTTON@SHADOW@SUCCESS"
msgstr "Envolvidos em seus pensamentos, seus cidadãos não conseguem seguir a canção Feérica."

msgid "FEY_INVASION@SIEGE_PROJECT@ABDUCT_POP@DESCRIPTION"
msgstr "[bulletlist][bullet/]Enquanto sitiada, a cidade perde {IntPopLoss} {GLOBAL.PopulationConcept.Hyperlink} a cada {GLOBAL.TurnConcept.Hyperlink}. Quando alcançar {IntZero} {GLOBAL.PopulationConcept.Hyperlink}, a cidade será arrasada.[/bulletlist]"

msgid "FEY_INVASION@SIEGE_PROJECT@ABDUCT_POP@NAME"
