msgid "DLC@RISEFROMRUIN@TUTORIAL@NOMAD_CONQUERORS@PAGE02@DESCRIPTION"
msgstr "Quando <<m:{GLOBAL.NodeConcept.Hyperlink}>> ao alcance de uma cidade Nômade se esgotam, a cidade pode querer realocar.[br/][br/]Cidades Nômades podem ser empacotadas em um {GLOBAL.NomadSettlerConcept.Hyperlink} e mover‑se para um novo local."

msgid "DLC@RISEFROMRUIN@TUTORIAL@NOMAD_CONQUERORS@PAGE02@INSTRUCTIONS"
msgstr "Conquistadores, em particular, preferem fundar suas cidades próximas a {GLOBAL.DomainConcept.Hyperlink} hostis, já que recebem benefício adicional ao anexar províncias hostis por meio de {GLOBAL.AggressiveExpansionConcept.Hyperlink}."

msgid "DLC@RISEFROMRUIN@TUTORIAL@NOMAD_CONQUERORS@TITLE"
msgstr "Cidades Nômades Conquistadoras"

msgid "DLC@RISEFROMRUIN@TUTORIAL@NOMAD_SCAVENGER@DESCRIPTION"
msgstr "Tutorial da cultura Nômade Saqueadora"

msgid "DLC@RISEFROMRUIN@TUTORIAL@NOMAD_SCAVENGER@TITLE"
msgstr "Cidades Nômades Saqueadoras"

msgid "DLC@RISEFROMRUIN@TUTORIAL@NOMAD_SCAVENGERS@PAGE02@DESCRIPTION"
msgstr "Quando <<m:{GLOBAL.NodeConcept.Hyperlink}>> ao alcance de uma cidade Nômade se esgotam, a cidade pode querer mudar para um novo local.[br/][br/]Cidades Nômades podem ser empacotadas em um {GLOBAL.NomadSettlerConcept.Hyperlink} e mover‑se para um novo local."

msgid "DLC@RISEFROMRUIN@TUTORIAL@NOMAD_SCAVENGERS@PAGE02@INSTRUCTIONS"
msgstr "Saqueadores, em particular, buscam <<m:{GLOBAL.AncientWonderConcept.Hyperlink}>> para explorar {GLOBAL.WonderScavengingConcept.Hyperlink}. Procure locais próximos a <<m:{GLOBAL.AncientWonderConcept.Hyperlink}>> com abundância de <<m:{GLOBAL.NodeConcept.Hyperlink}>>."

msgid "DLC@RISEFROMRUIN@TUTORIAL@OVERHARVESTING@PAGE01@DESCRIPTION"
msgstr "Cidades da cultura Nômade realizam passivamente [hyperlink,GLOBAL.OverharvestingConcept]Supercolheita[/hyperlink] <<m:{GLOBAL.NodeConcept.Hyperlink}>> em seus {GLOBAL.DomainConcept.Hyperlink}. [br/][br/]Uma vez concluído esse processo, o {GLOBAL.NodeConcept.Hyperlink} se esgota e a cidade ganha um {GLOBAL.EssenceConcept.Hyperlink} que concede renda baseada no Nó ou {GLOBAL.MagicMaterialConcept.Hyperlink} que foi colhido."

msgid "DLC@RISEFROMRUIN@TUTORIAL@OVERHARVESTING@PAGE01@INSTRUCTIONS"
msgstr "A supercolheita de um nó pode ser acelerada usando {GLOBAL.ImperiumConcept.Hyperlink} proporcional ao tempo restante."

msgid "DLC@RISEFROMRUIN@TUTORIAL@OVERHARVESTING@TITLE"
