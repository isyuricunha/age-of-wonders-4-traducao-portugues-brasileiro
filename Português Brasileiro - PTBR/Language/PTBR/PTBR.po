msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@FRAGMENTED_BLOODLIGHT_REFLECTIONS@DESCRIPTION"
msgstr "A cada {GLOBAL.TurnConcept.Hyperlink}, algumas posições recebem Luz de Sangue por {turn}.[br/][br/]{GLOBAL.PROPERTIES.UNDEAD.Hyperlink} unidades em Luz de Sangue recebem {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} e {GLOBAL.PROPERTIES.REGENERATION.Hyperlink} ao final do turno."

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@FRAGMENTED_BLOODLIGHT_REFLECTIONS@NAME"
