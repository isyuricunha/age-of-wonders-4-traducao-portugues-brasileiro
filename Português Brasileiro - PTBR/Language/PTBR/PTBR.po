msgid "DIPLOMACY@DIPLOMATIC_STATE@NEUTRAL_DESCRIPTION"
msgstr "A paz é o estado padrão das relações. Termos melhores são alcançados através de {GLOBAL.NegotiationConcept.Hyperlink}, ou {GLOBAL.WarConcept.Hyperlink} pode ser declarado."

