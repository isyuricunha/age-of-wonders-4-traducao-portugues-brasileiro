msgstr "Barragem"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@ABILITY3@DESCRIPTION"
msgstr "Ataca a unidade inimiga alvo.[bulletlist][bullet/]Empurrar Para Trás[br/]Alvo é empurrado {hex} hexágono(s). [bullet/]Move-se para o hexágono vazio.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@ABILITY3@NAME"
