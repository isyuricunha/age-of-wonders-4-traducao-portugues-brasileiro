msgid "DLC@WAYSOFWAR@PROSPERITY_DRAGON@RADIANT_SPIKE@NAME"
msgstr "Espinho Radiante"

msgid "DLC@WAYSOFWAR@PROSPERITY_DRAGON@RAIN_OF_PROSPERITY@DESCRIPTION"
