msgid "DLC@THRONESOFBLOOD@TOME_BLOOD_RITE@SKILL2@DESCRIPTION"
msgstr "Ataques de unidades encantadas:[bulletlist][bullet/]Causam +{BLOOD_DRINKING_BLADES_REPEATING>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Ao atingir unidades com {GLOBAL.PROPERTIES.BLEEDING.Hyperlink}, curam {BLOOD_DRINKING_BLADES_LIFE_STEAL>MinHeal} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

