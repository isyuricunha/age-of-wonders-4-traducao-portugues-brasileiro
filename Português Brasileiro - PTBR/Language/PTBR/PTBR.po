msgid "TOME_ARTIFICING@SKILL4@DESCRIPTION"
msgstr "Concede unidades encantadas:[bulletlist][bullet/]+{SIEGE_MAGIC_DAMAGE>ResolvedMultiplier}% damage[bullet/]{GLOBAL.PROPERTIES.SIEGE_BREAKER.Hyperlink}, causando dano extra de fortificação durante um cerco.[bullet/]{GLOBAL.PROPERTIES.DEMOLISHER.Hyperlink}, permitindo que destruam obstáculos reforçados.[/bulletlist]"

msgid "TOME_ARTIFICING@SKILL4@NAME"
msgstr "Magia de Cerco"

msgid "TOME_ARTIFICING@SKILL4@PROP_DESCRIPTION"
msgstr "Unidade tem:[bulletlist][bullet/]+{SIEGE_MAGIC_DAMAGE>ResolvedMultiplier}% damage[bullet/]{GLOBAL.PROPERTIES.SIEGE_BREAKER.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.DEMOLISHER.Hyperlink}.[/bulletlist]"

msgid "TOME_ARTIFICING@SKILL5@DESCRIPTION"
msgstr "Um {GLOBAL.CityTowerStructureConcept.Hyperlink} que concede à cidade {GLOBAL.UNITS.BOLT_REPEATER_UNIT.Hyperlink} Torres durante o combate de cerco."

msgid "TOME_ARTIFICING@SKILL5@NAME"
msgstr "Fortificação Artesanal"

msgid "TOME_ARTIFICING@SKILL5@PROP_DESCRIPTION"
msgstr "Adiciona {amount} <<m:{GLOBAL.UNITS.BOLT_REPEATER_TOWER_UNIT.Hyperlink}>> em {GLOBAL.CombatConcept.Hyperlink} durante um {GLOBAL.SiegeConcept.Hyperlink}."

msgid "TOME_ARTIFICING@SKILL5@PROP_NAME"
