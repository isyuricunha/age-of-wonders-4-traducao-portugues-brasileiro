msgid "TOME_CRYOMANCY@SKILL_6@DESCRIPTION"
msgstr "Faz com que os ataques de unidades encantadas ganhem:[bulletlist][bullet/]+{FROST_BLADES_EXTRA_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Uma chance base {SLOWED_RESISTANCE>ResolvedStrength}% c de infligir {GLOBAL.PROPERTIES.SLOWED.Hyperlink}.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CRYOMANCY@SKILL_6@NAME"
msgstr "Setas de Gelo"

msgid "TOME_CRYOMANCY@SKILL_6@PROP_DESCRIPTION"
msgstr "Os ataques da unidade têm:[bulletlist][bullet/]+{FROST_BLADES_EXTRA_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Uma chance base {SLOWED_RESISTANCE>ResolvedStrength}% c de infligir {GLOBAL.PROPERTIES.SLOWED.Hyperlink}.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CRYOMANCY@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Especialize-se em causar {GLOBAL.FrostDamageConcept.Hyperlink} e infligir {GLOBAL.PROPERTIES.FROZEN.Hyperlink}."

msgid "TOME_CRYOMANCY@TOME@LORE_AUTHOR"
msgstr "Artica, a Fria, Rainha dos Frostlings"

msgid "TOME_CRYOMANCY@TOME@LORE_DESCRIPTION"
msgstr "\"Quando todo o mundo se transforma em gelo, vejo um puro paraíso Frostling! Congele seus membros e torne seus ossos frágeis, sepultados em sangue gelado! Invoco a nevasca para congelar a carne e inspirar medo que remonta a uma época em que os mortais se encolhiam em cavernas, temendo que o frio os consumisse...\""

msgid "TOME_CRYOMANCY@TOME@NAME"
