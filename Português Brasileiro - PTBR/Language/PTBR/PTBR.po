msgstr "Por meio da sua conexão com a terra, você percebeu que os Clãs Gigantes estão se dirigindo à sua cidade de {HOTGK_TARGET_CITY}. Todas as defesas devem ser preparadas!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@HEADER_DEFEATED_ASSAULT"
msgstr "Você derrotou o invasor {HOTGK_CLAN_NAME}!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@HEADER_END"
msgstr "Os ataques dos Clãs Gigantes terminaram."

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@HEADER_INCOMING_ASSAULT"
msgstr "Prepare‑se para o ataque dos Clãs Gigantes!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@ARMY_DESTROYED@DESCRIPTION"
msgstr "Um dos exércitos dos Clãs Gigantes que atacavam o reino foi destruído por outro jogador."

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@ARMY_DESTROYED@HEADER"
msgstr "Herdeiro de Thagnokar: Exército do Clã destruído!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@CITY_LOST@DESCRIPTION"
msgstr "O {HOTGK_CLAN_NAME} capturou {HOTGK_TARGET_CITY} e começou a arrasá‑la. Reconquiste a cidade para detê‑los!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@CITY_LOST@HEADER"
msgstr "Herdeiro de Thagnokar: {HOTGK_TARGET_CITY} perdido!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@CITY_RAZED@DESCRIPTION"
msgstr "O {HOTGK_CLAN_NAME} arrasou {HOTGK_TARGET_CITY}. Após sua devastação, retirou‑se do seu domínio, mas os acontecimentos deste dia marcaram seu império para as eras vindouras."

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@CITY_RAZED@HEADER"
msgstr "Herdeiro de Thagnokar: {HOTGK_TARGET_CITY} arrasado!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@CITY_RAZED_HEIR@DESCRIPTION"
msgstr "Um dos exércitos dos Clãs Gigantes arrasou a cidade que atacou. Eles dedicaram essa vitória a você, Herdeiro de Thagnokar, e você ganha {HOTGK_RAZE_IMP_REWARD} {GLOBAL.ImperiumConcept.Hyperlink}. Depois, o exército do clã retirou‑se com seus despojos para se recuperar da batalha."

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@CITY_RAZED_HEIR@HEADER"
msgstr "Herdeiro de Thagnokar: Saque do clã bem‑sucedido!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@CITY_RAZED_OTHER@DESCRIPTION"
msgstr "Irritado pela destruição de seu alvo {HOTGK_TARGET_CITY}, o {HOTGK_CLAN_NAME} retirou‑se para suas profundas salas ocultas."

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@CITY_RAZED_OTHER@HEADER"
msgstr "Herdeiro de Thagnokar: O {HOTGK_CLAN_NAME} retirou‑se!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@CITY_RAZED_OTHER_HEIR@DESCRIPTION"
msgstr "Ao ver a cidade que atacaram destruída por outra facção, um dos exércitos dos Clãs Gigantes abortou o saque e retirou‑se para suas profundas salas ocultas."

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@CITY_RAZED_OTHER_HEIR@HEADER"
msgstr "Herdeiro de Thagnokar: Saque do clã abortado!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@CITY_SIEGED@DESCRIPTION"
msgstr "O {HOTGK_CLAN_NAME} está sitiando {HOTGK_TARGET_CITY}. Traga reforços para romper o cerco ou confie no poder de suas defesas."

