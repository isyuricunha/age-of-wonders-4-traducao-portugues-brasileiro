msgstr "Concede unidades encantadas:[bulletlist][bullet/]+{ARTISAN_BLADES_CRITICAL_CHANCE>ResolvedCritChanceBonus}% {GLOBAL.CriticalHitChanceConcept.Hyperlink}.[/bulletlist]"

