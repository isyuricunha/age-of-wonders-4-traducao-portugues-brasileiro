msgid "DLC@WAYSOFWAR@TOME_CALAMITY@SKILL2@DESCRIPTION"
msgstr "Unidades em um raio de {METEOR_OF_CALAMITY_UNIT_TARGETER_CIRCLE>AREA>Radius} hexágonos:[bulletlist][bullet/]Sustentam {METEOR_OF_CALAMITY_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Sustentam {METEOR_OF_CALAMITY_UNIT_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Têm {FROZEN_RESISTANCE>ResolvedStrength}% de chance base de se tornar {GLOBAL.PROPERTIES.FROZEN.Hyperlink} por {FROZEN_EFFECT_DESCRIPTION>NumTurns} {GLOBAL.TurnConcept}.[bullet/]Ganham {amountStacks1} pilhas de {GLOBAL.PROPERTIES.GHOSTFIRE.Hyperlink} por {GHOSTFIRE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

