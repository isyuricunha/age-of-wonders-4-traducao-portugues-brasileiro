msgstr "Como seu império não possui mais cidades, os Clãs Gigantes não enviaram nenhum exército ao seu domínio."

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@NOTIFICATION@NO_CITY_TO_RAID@HEADER"
msgstr "Herdeiro de Thagnokar: Clãs Gigantes abortaram o ataque"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@OBJECTIVE_ACTIVE_ASSAULT_HEIR"
