msgid "PLAYER_INTERACTION@EVENT_IDLE@NEUTRAL"
msgstr "\"O resto do mundo não tem ouvido falar de suas ações há algum tempo. Esse silêncio pode ser bom ou ruim.\""

msgid "PLAYER_INTERACTION@EVENT_IDLE@POSITIVE"
msgstr "\"Não ouvi nada sobre suas conquistas há algum tempo. Espero que esteja bem em seus esforços para expandir seu império, para que possamos nos erguer das ruínas juntos.\""

msgid "PLAYER_INTERACTION@EVENT_IMPROVEDRELATIONWITHFACTION@NEGATIVE"
msgstr "\"Você acha que fazer amizade com {House.Name} ajudará a garantir seu caminho para a vitória? Será o meu império que se erguerá acima de tudo.\""

msgid "PLAYER_INTERACTION@EVENT_IMPROVEDRELATIONWITHFACTION@NEUTRAL"
