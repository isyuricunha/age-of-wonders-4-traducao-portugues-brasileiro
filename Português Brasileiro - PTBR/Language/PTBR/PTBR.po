msgid "DLC@ARCHONPROPHECY@STORY_REALM_MISSION_02@TRIGGER@EFFECT@TOOLTIP_JULIA_SUNDREN_RECRUIT"
msgstr "{Player.TitleName} recruta {Unit.Name}."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_MISSION_02@VICTORY"
msgstr "Vitória em Sordünn!"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_MISSION_02@VICTORY_TEXT"
msgstr "Você destruiu a fortaleza do Abismo Umbral em Sordünn. Vitorioso, você retorna a Magehaven..."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_MISSION_03@BRIEFING_02@DESCRIPTION"
msgstr "Esta Profecia proibiu os Arcontes de se envolverem diretamente, e por isso coube ao Godir de Magehaven escolher um dos seus que considerassem poderoso o suficiente para cumprir esta missão vital. Os Arcontes emprestariam sua força enviando seu campeão — um protégé Élfico que haviam tomado sob suas asas divinas."

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SKILL1@DESCRIPTION"
msgstr "Invocar um(a) {GLOBAL.UNITS.ARCHON_ASTRA.Hyperlink} {GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink}, uma unidade Anjo com ataques poderosos e habilidades de cura."

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SKILL1@NAME"
msgstr "Invocar Astra"

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SKILL2@DESCRIPTION"
msgstr "Purifique as almas da raça-alvo, concedendo a elas:[bulletlist][bullet/]No início de cada turno de combate, dissipe {amount} {GLOBAL.NegativeStatusEffectConcept.Hyperlink}.[bullet/]Se o Efeito de Status Negativo removido possuía um [hyperlink,GLOBAL.OpposingStatusEffectsConcept]contador positivo[/hyperlink], ganhe o {GLOBAL.PositiveStatusEffectConcept.Hyperlink}.[/bulletlist][br/]Esta transformação é incompatível com {GLOBAL.SPECIAL_OPERATIONS.UMBRAL_FLESH.Hyperlink} e {GLOBAL.SPECIAL_OPERATIONS.GLOOMSTRIDER_TRANSFORMATION.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SKILL2@NAME"
msgstr "Alma Pura"

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SKILL2@PROP_DESCRIPTION"
msgstr "Unidade tem:[bulletlist][bullet/]No início de cada turno em combate, dissipar {amount} {GLOBAL.NegativeStatusEffectConcept.Hyperlink}.[bullet/]Se o Efeito de Status Negativo removido tinha um [hyperlink,GLOBAL.OpposingStatusEffectsConcept]contador positivo[/hyperlink], ganha o {GLOBAL.PositiveStatusEffectConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SKILL3@DESCRIPTION"
msgstr "Alvo: unidade morta que não seja Herói nem Celestial:[bulletlist][bullet/]Revive como um(a) {GLOBAL.UNITS.ARCHON_ANGEL.Hyperlink} sob controle do conjurador até o fim do combate.[bullet/]Ao reviver, todas as unidades amigas em um raio de {ASCENDED_REBIRTH_HEAL_TARGETER>AREA>Radius} hexágonos são curadas em {ASCENDED_REBIRTH_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SKILL3@NAME"
msgstr "Renascimento Ascendido"

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SKILL4@DESCRIPTION"
msgstr "O líder-alvo de um exército ganha {GLOBAL.PROPERTIES.CELESTIAL_GUARDIANS_AUTO_SPELL.Hyperlink} por {amount2} {GLOBAL.WorldMapConcept.Hyperlink} {GLOBAL.TurnConcept}, conjurando unidades Archon de Nível III {amount} no início do combate durante a duração."

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SKILL4@NAME"
msgstr "Guard iões Celestiais"

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SKILL4@PROP_DESCRIPTION"
msgstr "Conjure {amount} unidades Archon de Nível III no início do combate."

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SKILL5@DESCRIPTION"
msgstr "Concede unidades encantadas:[bulletlist][bullet/]{GLOBAL.PROPERTIES.HOLY_AURA_PROP.Hyperlink}, concedendo proteção de status às unidades amigas adjacentes e causando dano aos inimigos adjacentes.[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SKILL5@NAME"
msgstr "Aura Sagrada"

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SKILL5@PROP_DESCRIPTION"
msgstr "Unidade tem:{LOC.DLC@ARCHONPROPHECY@WILDLIFE_UNITPROPERTIES@HOLY_AURA@DESCRIPTION}"

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SPI@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{amount} {GLOBAL.CityStabilityConcept.Hyperlink}[bullet/]{GLOBAL.UnitConcept.Hyperlink} local de implantação.[bullet/]Permite o alistamento de <<m:{GLOBAL.UNITS.ARCHON_TITAN.Hyperlink}>>.[bullet/]Funciona como um(a) {GLOBAL.TeleporterConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@SPI@NAME"
msgstr "[teleporter/] Portão Archon"

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Evoque aliados Celestiais e eleve suas unidades ao escalão dos Archons."

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@TOME@LORE_DESCRIPTION"
msgstr "\"Alegrem-se! Pois os Archons descem dos céus mais uma vez. O dia do juízo chegou, e vocês se erguem exaltados ao lado de Titãs e Anjos. Anunciem sua chegada, testemunhem como sua ira devasta os ímpios e suas bênçãos concedem graça aos inocentes. Você, justo, não teme mais a morte — pois a ascensão é alcançada através do sacrifício.\""

msgid "DLC@ARCHONPROPHECY@TOME_ARCHON@TOME@NAME"
msgstr "Tomo do Archon"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@EVENT_PROPERTY@DESCRIPTION"
msgstr "Unidade tem uma {HAND_OF_PROVIDENCE_RESISTANCE_CHECK>ResolvedStrength}% c chance no início de um turno de ganhar:[bulletlist][bullet/]{GLOBAL.PROPERTIES.TRUE_STRIKE.Hyperlink} por {TRUE_STRIKE_EFFECT_DESCRIPTION>NumTurns} {GLOBAL.TurnConcept}.[bullet/]{GLOBAL.PROPERTIES.FORTUNE.Hyperlink} por {FORTUNE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@EVENT_PROPERTY@NAME"
msgstr "Mão da Providência"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@SKILL1@DESCRIPTION"
msgstr "Um(a) {GLOBAL.PROPERTIES.SUPPORT_UNIT.Hyperlink} que pode prever o futuro e usar esse conhecimento para fortalecer e proteger outras unidades."

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@SKILL2@AUTOSPELL"
msgstr "Aplique estes efeitos à batalha na seguinte ordem:"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@SKILL2@DESCRIPTION"
msgstr "Quando lançado e pelos próximos {duration} <<m:{GLOBAL.TurnConcept}>>, aplique o efeito à batalha na seguinte ordem:[bulletlist][bullet/]Todas as unidades amigas ganham +{amount}% {GLOBAL.EvasionConcept.Hyperlink} neste turno.[bullet/]Todas as unidades amigas ganham {GLOBAL.PROPERTIES.PRECOGNITION.Hyperlink}.[bullet/]Todas as unidades amigas ganham +{damage}% d de dano neste turno.[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@SKILL2@NAME"
msgstr "Adivinhação de Batalha"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@SKILL2@NAME_PROP"
msgstr "Adivinhação de Batalha - Dano"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@SKILL2@NAME_PROP_EVASION"
msgstr "Adivinhação de Batalha - Evasão"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@SKILL2@PROP1_DESCRIPTION"
msgstr "Todas as unidades amigas ganham +{amount}% {GLOBAL.EvasionConcept.Hyperlink} neste turno."

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@SKILL2@PROP2_DESCRIPTION"
msgstr "Todas as unidades amigas ganham {GLOBAL.PROPERTIES.PRECOGNITION.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@SKILL2@PROP3_DESCRIPTION"
msgstr "Todas as unidades amigas ganham +{BATTLE_DIVINATION_DAMAGE_MULT>ResolvedMultiplier}% d de dano neste turno."

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@SKILL3@DESCRIPTION"
msgstr "No início do combate:[bulletlist][bullet/]Unidades amigas ganham:[bulletlist][bullet/]{GLOBAL.PROPERTIES.PRECOGNITION.Hyperlink}[bullet/]+{amount2}% {GLOBAL.CriticalHitChanceConcept.Hyperlink} durante todo o combate.[/bulletlist][bullet/]Unidades inimigas ganham:[bulletlist][bullet/]Uma chance de {amount4}% {GLOBAL.FumbleConcept.Hyperlink} durante todo o combate.[/bulletlist][/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@SKILL3@NAME"
msgstr "Prever a Queda"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@SKILL4@DESCRIPTION"
msgstr "Concede unidades encantadas:[bulletlist][bullet/]+{FATED_PROJECTILES_CRITICAL_CHANCE>ResolvedCritChanceBonus}% {GLOBAL.CriticalHitChanceConcept.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.FAITHFUL.Hyperlink}.[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@SKILL4@NAME"
msgstr "Imbuimento Fatal"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@SKILL4@PROP_DESCRIPTION"
msgstr "Unidade tem:[bulletlist][bullet/]+{FATED_PROJECTILES_CRITICAL_CHANCE>ResolvedCritChanceBonus}% {GLOBAL.CriticalHitChanceConcept.Hyperlink}[bullet/]Tem {GLOBAL.PROPERTIES.FAITHFUL.Hyperlink}[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@SKILL5@DESCRIPTION"
msgstr "Concede unidades encantadas:[bulletlist][bullet/]Ganha {GLOBAL.PROPERTIES.PRECOGNITION.Hyperlink} ao entrar em {GLOBAL.DefenseModeConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@SKILL5@NAME"
msgstr "Aros Prescientes"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@SKILL5@PROP_DESCRIPTION"
msgstr "Unidade ganha {GLOBAL.PROPERTIES.PRECOGNITION.Hyperlink} ao entrar em {GLOBAL.DefenseModeConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@SPI@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{manaamount} {GLOBAL.ManaConcept.Hyperlink}.[bullet/]+{knowledgeamount} {GLOBAL.KnowledgeConcept.Hyperlink} por adjacente {GLOBAL.ConduitConcept.Hyperlink}.[bullet/]Conta como um(a) {GLOBAL.ConduitConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@SPI@NAME"
msgstr "[conduit/] Templo do Profeta"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Previna ataques inimigos e preveja a queda de seus inimigos."

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@TOME@LORE_DESCRIPTION"
msgstr "\"Conhecer o próprio destino pode ser uma bênção ou uma maldição. Oráculos garantem que o inimigo preveja sua queda, e o aliado, sua fortuna — enquanto a adivinhação agita o futuro, acelerando seu curso. Desgraça aos que confundem profecias com meras palavras — pois não há poder maior que o destino, determinado a cumprir sua promessa.\""

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@TOME@NAME"
msgstr "Tomo das Profecias"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@UNIT@ABILITY1@DESCRIPTION"
msgstr "Unidades amigas em um raio de {HEALING_PORTENT_UNIT_TARGETER_SINGLE>AREA>Radius} hexágonos:[bulletlist][bullet/]Cura {HEALING_PORTENT_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Ganha {GLOBAL.PROPERTIES.PRECOGNITION.Hyperlink}.[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@UNIT@ABILITY1@DESCRIPTION_CHAMPION"
msgstr "Presságio de Cura:[bulletlist][bullet/]Cura adicional {healAmount}<<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@UNIT@ABILITY1@NAME"
msgstr "Presságio de Cura"

msgid "DLC@ARCHONPROPHECY@TOME_PROPHECIES@UNIT@ABILITY1@NAME_CHAMPION"
