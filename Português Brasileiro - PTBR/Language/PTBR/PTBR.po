msgid "DIPLOMATICSTATES_DEFINITIONS@SHAREVISION@AI_DESC"
msgstr "Vamos compartilhar nossa visão para podermos nos ajudar melhor!"

msgid "DIPLOMATICSTATES_DEFINITIONS@SHAREVISION@DESCRIPTION"
msgstr "Ambos <<m:{GLOBAL.LeaderConcept.Hyperlink}>> compartilham sua [hyperlink,GLOBAL.VisionRangeConcept]Vision[/hyperlink] entre si e revelarão as áreas exploradas um ao outro."

