msgid "TOME_VIGOR@SKILL4@NAME"
msgstr "Bestas Potencializadas"

msgid "TOME_VIGOR@SKILL4@PROP_DESCRIPTION"
msgstr "Unidade encantada:[bulletlist][bullet/]Inflige +{EMPOWERED_BEASTS_DAMAGE_MULTIPLIER>ResolvedMultiplier}% d dano.[bullet/]Ganha +{EMPOWERED_BEASTS_HP_BONUS>BONUS>HitPoints}<<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[bullet/]Ganha {GLOBAL.PROPERTIES.DEMOLISHER.Hyperlink}.[/bulletlist]"

msgid "TOME_VIGOR@SKILL5@DESCRIPTION"
msgstr "Invoca um {GLOBAL.UNITS.TOTEM_OF_THE_WILD_UNIT.Hyperlink}, que gera uma unidade animal aleatória de Nível I ou II quando criado e no início do seu próximo {count} <<m:{GLOBAL.TurnConcept}>>.[br/][br/]{LOC.TACTICAL@ABILITY@NEVER_IN_WATER}"

msgid "TOME_VIGOR@SKILL5@NAME"
msgstr "Totem da Selva^n"

msgid "TOME_VIGOR@SKILL5@PROP_DESCRIPTION"
msgstr "No início de cada {GLOBAL.TurnConcept.Hyperlink}, invoca uma unidade animal aleatória de Nível I ou II.{LOC.CONCEPT@SUMMON_LIVE_SHARED}"

msgid "TOME_VIGOR@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Fortaleça suas unidades e exércitos com o poder bruto das bestas selvagens. Especialize‑se em fortalecer <<m:{GLOBAL.PROPERTIES.ANIMAL.Hyperlink}>> e aumentar <<m:{GLOBAL.HitPointConcept}>>."

msgid "TOME_VIGOR@TOME@LORE_AUTHOR"
msgstr "Zaethyl, Guardião Selvagem dos Primeiros Elfos"

msgid "TOME_VIGOR@TOME@LORE_DESCRIPTION"
msgstr "\"O poder desenfreado da manada trovejando sobre a planície, a força bruta do urso majestoso ao se aproximar de sua presa. Ouça a música primal que pulsa nos tendões e ossos das bestas! Então você poderá dominá‑la e fortalecer sua matilha com a força da própria natureza.\""

msgid "TOME_VIGOR@TOME@NAME"
msgstr "Tomo de Vigor"

msgid "TOME_VIGOR@UNIT1@NAME"
msgstr "Totem da Selva"

msgid "TOME_WARDING@HERO_SKILL@DESCRIPTION"
