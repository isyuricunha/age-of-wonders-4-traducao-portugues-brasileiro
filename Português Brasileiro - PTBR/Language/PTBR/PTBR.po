msgstr "Miopthera^F"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@RELATION_MODIFIER@PLAYER_DAFAEL_FRIENDLY_MEET"
msgstr "Unidade Justa"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@RELATION_MODIFIER@PLAYER_DAFAEL_HOSTILE_MEET"
