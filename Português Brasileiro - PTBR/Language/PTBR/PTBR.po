msgstr "{HouseBLord.Name} é seu suserano, e você não pode atacá‑lo ou declarar guerra a ele enquanto for seu suserano. Você ainda pode tentar [hyperlink,GLOBAL.TradeConcept]Negociar[/hyperlink] sua liberdade com {HouseBLord.FirstName}."

msgid "INTERFACE@MODAL_HOSTILE_ACTION@DESCRIPTION_VASSALAGEOVERLORD"
msgstr "{HouseBLord.Name} é seu vassalo, e você não pode atacá‑lo ou declarar guerra a ele enquanto for seu vassalo. Você ainda pode conceder‑lhe liberdade através de <<m:{GLOBAL.TradeConcept.Hyperlink}>>."

msgid "INTERFACE@MODAL_HOSTILE_ACTION@DESCRIPTION_WARCOOLDOWN"
msgstr "Seu estado diplomático com {Target.Name} mudou recentemente e {GLOBAL.WarConcept.Hyperlink} não pode ser declarado para {Duration} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "INTERFACE@MODAL_HOSTILE_ACTION@HEADER_VASSALAGE"
msgstr "Encontrando seu suserano, {HouseBLord.FirstName}"

msgid "INTERFACE@MODAL_HOSTILE_ACTION@HEADER_VASSALAGEOVERLORD"
msgstr "Encontrando seu vassalo, {HouseBLord.FirstName}"

msgid "INTERFACE@MODAL_HOSTILE_ACTION@HEADER_WARCOOLDOWN"
