msgstr "Peste Escarlate"

msgid "DLC@THRONESOFBLOOD@TOME_BLOOD_RITE@ABILITY02@DESCRIPTION"
msgstr "O conjurador:[bulletlist][bullet/]Sofre {DAGGER_OF_THE_RITE_DAMAGE>DAMAGE>Physical} inbloqueável {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Ganha +{DAGGER_OF_THE_RITE_DAMAGE_MULT>ResolvedMultiplier}% d dano.[bullet/]Ganha {GLOBAL.PROPERTIES.RESURGENCE.Hyperlink}[bullet/]Morre ao final do turno.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_BLOOD_RITE@ABILITY02@NAME"
msgstr "Adaga do Rito"

msgid "DLC@THRONESOFBLOOD@TOME_BLOOD_RITE@ABILITY02@PROP_DESCRIPTION"
msgstr "Esta unidade[bulletlist][bullet/]Tem +{DAGGER_OF_THE_RITE_DAMAGE_MULT>ResolvedMultiplier}% d dano.[bullet/]Tem {GLOBAL.PROPERTIES.RESURGENCE.Hyperlink}[bullet/]Morre ao final do turno.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_BLOOD_RITE@BLOOD_CULTIST@NAME"
msgstr "Cultista de Sangue^m"

msgid "DLC@THRONESOFBLOOD@TOME_BLOOD_RITE@GAMEPLAY_DESCRIPTION"
msgstr "Realize ritos proibidos e perigosos em suas unidades para sangrar seus inimigos e fortalecer seus aliados."

msgid "DLC@THRONESOFBLOOD@TOME_BLOOD_RITE@LORE_DESCRIPTION"
msgstr "\"Ritos proibidos em uma língua esquecida, pergaminhos queimados de um reino erguido sobre sangue e sacrifício. Estas são as memórias daquele que agora chamamos de Deus Imortal. Seus preceitos—agora Ele sussurra em minha mente, como palavras a serem gravadas em nossa carne. Cada presente que Ele concede exige um preço. E esse preço é sangue.\""

msgid "DLC@THRONESOFBLOOD@TOME_BLOOD_RITE@NAME"
msgstr "Tomo do Rito de Sangue"

msgid "DLC@THRONESOFBLOOD@TOME_BLOOD_RITE@SKILL1@DESCRIPTION"
msgstr "Unidade amiga alvo sofre {RITE_OF_LIFE_LEECHING_DAMAGE>DAMAGE>Physical} inbloqueável {GLOBAL.PhysicalDamageConcept.Hyperlink}. Então todas as unidades amigas adjacentes ganham:[bulletlist][bullet/]{GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} por {STRENGTHENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]{GLOBAL.PROPERTIES.NEW_LIFE_STEAL.Hyperlink} por {RITE_OF_LIFE_LEECHING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_BLOOD_RITE@SKILL1@NAME"
