msgid "DLC@SECRETSOFTHEARCHMAGES@MINORFACTIONS_WORLD@RACE01@BIO"
msgstr "Os discípulos da {GLOBAL.HorwyndLoreConcept.Hyperlink} Escola de Guardiões foram originalmente encarregados de preservar o conhecimento da batalha e da guerra. Quando o {GLOBAL.ArchonsLoreConcept.Hyperlink} estabeleceu o <<m:{GLOBAL.CircleOfDeogaiLoreConcept.Hyperlink}>>, a Escola de guerreiros e cavaleiros honoráveis empregou seu poder sagrado para proteger os Portais para o <<m:{GLOBAL.ShroudedIsleConcept.Hyperlink}>> contra forças invasoras e os inquisitivos agentes dos Arcontes."

msgid "DLC@SECRETSOFTHEARCHMAGES@MINORFACTIONS_WORLD@RACE01@NAME"
