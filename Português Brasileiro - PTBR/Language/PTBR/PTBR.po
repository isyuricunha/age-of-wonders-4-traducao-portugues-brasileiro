msgid "DLC@WAYSOFWAR@OATHSWORN@UNIT_MECHANIC01@DESCRIPTION"
msgstr "Quando esta unidade ficar abaixo de {maxHP}% of de seu máximo <<m:{GLOBAL.HitPointConcept.Hyperlink}>>, ganha um efeito baseado na {GLOBAL.DevotionConcept.Hyperlink} da cultura: [bulletlist][bullet/][devotion3/] Exemplar: Curar {amountParagon} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>[bullet/][devotion2/] Devoto: Curar {amountDevotee} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>[bullet/][devotion1/] Adepto: Curar {amountAdherent} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>[bullet/][devotion0/] Neutro: Curar {amountNeutral} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>[bullet/][devotion-1/] Quebrador de Juramento: {Weakamount} {GLOBAL.PROPERTIES.WEAKENED.Hyperlink} por {weakduration} <<m:{GLOBAL.TurnConcept}>>[/bulletlist]"

msgid "DLC@WAYSOFWAR@OATHSWORN@UNIT_MECHANIC01@NAME"
msgstr "Harmonizar"

msgid "DLC@WAYSOFWAR@OATHSWORN@UNIT_MECHANIC02@DESCRIPTION"
msgstr "Os ataques não flanqueadores da unidade causam dano extra com base na {GLOBAL.DevotionConcept.Hyperlink} da cultura:[bulletlist][bullet/][devotion3/] Paragon: +{paragonamount} {GLOBAL.SpiritDamageConcept.Hyperlink}[bullet/][devotion2/] Devoto: +{devoteeamount} {GLOBAL.SpiritDamageConcept.Hyperlink}[bullet/][devotion1/] Adepto: +{adherentamount} {GLOBAL.SpiritDamageConcept.Hyperlink}[bullet/][devotion0/] Neutro: +{neutralamount} {GLOBAL.SpiritDamageConcept.Hyperlink}[bullet/][devotion-1/] Quebrador de Juramento: -{OathbreakerDamage}% damage[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@WAYSOFWAR@OATHSWORN@UNIT_MECHANIC02@NAME"
msgstr "Nobreza"

msgid "DLC@WAYSOFWAR@OATHSWORN@UNIT_MECHANIC03@BUFF_DESCRIPTION"
msgstr "Os ataques desta unidade causam +{WARRIOR_SOUL_REPEATING_DAMAGE>DAMAGE>Fire}{GLOBAL.FireDamageConcept.Hyperlink}.[br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@WAYSOFWAR@OATHSWORN@UNIT_MECHANIC03@BUFF_NAME"
msgstr "Fúria do Guerreiro"

msgid "DLC@WAYSOFWAR@OATHSWORN@UNIT_MECHANIC03@BUFF_NAME_ADHERENT"
