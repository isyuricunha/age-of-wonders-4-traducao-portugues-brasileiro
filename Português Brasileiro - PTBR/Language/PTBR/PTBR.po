msgstr "Pequena chance de matar instantaneamente um alvo ferido. Essa chance aumenta quanto menores forem os <<m:{GLOBAL.HitPointConcept}>> do alvo. Se falhar, o alvo ganha {amount2} {GLOBAL.PROPERTIES.WEAKENED.Hyperlink}."

msgid "TOME_CYCLES@ABILITY_2@NAME"
msgstr "Fim do Ciclo"

msgid "TOME_CYCLES@ABILITY_3@DESCRIPTION"
