msgid "DLC@SECRETSOFTHEARCHMAGES@@ESSENCE_GRACE@SKIN_OWLKIN@BIO"
msgstr "Aves de rapina de olhos arregalados que inflam as penas quando ameaçadas. Seus pios sinalizam reverência ou aflição."

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY01@NAME"
msgstr "Atirar Teia"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY02@DESCRIPTION"
msgstr "Unidades adjacentes recebem dano. Em seguida, teletransportam‑se para o hexágono alvo."

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY02@NAME"
msgstr "Retirada do Tecelão"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY03@DESCRIPTION"
msgstr "[bulletlist][bullet/]A unidade inimiga alvo recebe dano.[bullet/]Aumenta em {COMBUST_EXTRA_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} para cada {GLOBAL.PROPERTIES.BURNING.Hyperlink} que o alvo possui.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY03@NAME"
msgstr "Combustão"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY04@DESCRIPTION"
msgstr "Unidade inimiga alvo tem uma base {RIDDLE_OF_LIGHT_CHECK>ResolvedStrength}% c chance de ganhar {amount} dos seguintes: [bulletlist][bullet/]{GLOBAL.PROPERTIES.STUNNED.Hyperlink} por {STUNNED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>. [bullet/]{GLOBAL.PROPERTIES.BLINDED.Hyperlink} por {BLINDED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>. [bullet/]{RIDDLE_OF_LIGHT_REPEATER_1>Count} {GLOBAL.PROPERTIES.BURNING.Hyperlink} por {BURNING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>. [bullet/]{RIDDLE_OF_LIGHT_REPEATER_2>Count} {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink} e {RIDDLE_OF_LIGHT_REPEATER_2>Count} {GLOBAL.PROPERTIES.SUNDERED_RESISTANCE.Hyperlink} por {SUNDERED_DEFENSE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY04@NAME"
msgstr "Enigma da Luz"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY05@DESCRIPTION"
msgstr "A unidade inimiga alvo tem uma chance base {RIDDLE_OF_NIGHT_CHECK>ResolvedStrength}% c de ganhar {amount} do seguinte: [bulletlist][bullet/]{GLOBAL.PROPERTIES.FROZEN.Hyperlink} por {FROZEN_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>. [bullet/]{GLOBAL.PROPERTIES.INSANITY.Hyperlink} por {INSANITY_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>. [bullet/]{RIDDLE_OF_NIGHT_REPEATER_1>Count} {GLOBAL.PROPERTIES.ELECTRIFIED.Hyperlink} por {ELECTRIFIED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>. [bullet/]{RIDDLE_OF_NIGHT_REPEATER_2>Count} {GLOBAL.PROPERTIES.MISFORTUNE.Hyperlink} por {MISFORTUNE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY05@NAME"
msgstr "Enigma da Noite"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY06@DESCRIPTION"
msgstr "[bulletlist][bullet/]A unidade inimiga alvo recebe dano.[bullet/]Então, unidades amigas em um raio de {SUN_AND_LIFE_CIRCLE_TARGETER>AREA>Radius}-hexágonos do alvo:[bulletlist][bullet/]Cura {SUN_AND_LIFE_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Remova {GENERAL_DISPEL_NEGATIVE>NumThingsToDispel} Efeitos de Status Negativos.[/bulletlist][/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY06@NAME"
msgstr "Sol e Vida"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY07@DESCRIPTION"
msgstr "[bulletlist][bullet/]A unidade inimiga alvo recebe dano.[bullet/]Então, unidades amigas em um raio de {MOON_AND_SHADOW_CIRCLE_TARGETER>AREA>Radius}-hexágonos do alvo:[bulletlist][bullet/]Ganham {amount} {GLOBAL.EvasionConcept.Hyperlink} por {EVASION_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Remova {GENERAL_DISPEL_NEGATIVE>NumThingsToDispel} Efeitos de Status Negativos.[/bulletlist][/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY07@NAME"
msgstr "Lua e Sombra"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY08@DESCRIPTION"
msgstr "No final do turno, unidades inimigas adjacentes a esta sofrem {PARASITIC_CORAL_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}. Então cura {PARASITIC_CORAL_LIFE_STEAL>MinHeal} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> por cada inimigo atingido."

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY08@NAME"
msgstr "Coral Parasita"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY09@DESCRIPTION"
msgstr "Unidades de nível {tier} ou inferior {GLOBAL.PROPERTIES.PENGUIN.Hyperlink} no exército recebem:[bulletlist][bullet/]+{PENGUIN_COMMAND_DAMAGE>ResolvedMultiplier}% d dano.[bullet/]+{PENGUIN_COMMAND_DEFENSE>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[bullet/]+{PENGUIN_COMMAND_DEFENSE>BONUS>DEFENSE>Armor} {GLOBAL.DefenseConcept.Hyperlink}.[bullet/]+{PENGUIN_COMMAND_DEFENSE>BONUS>DEFENSE>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}[/bulletlist][br/]Não podem ser acumulados."

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY09@NAME"
msgstr "Comandante Pinguim"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY09@PROP_DESCRIPTION"
msgstr "Unidade tem:[bulletlist][bullet/]+{PENGUIN_COMMAND_DAMAGE>ResolvedMultiplier}% d dano[bullet/]+{PENGUIN_COMMAND_DEFENSE>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]+{PENGUIN_COMMAND_DEFENSE>BONUS>DEFENSE>Armor} {GLOBAL.DefenseConcept.Hyperlink}[bullet/]+{PENGUIN_COMMAND_DEFENSE>BONUS>DEFENSE>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY09@PROP_NAME"
msgstr "Comando Pinguim"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY10@DESCRIPTION"
msgstr "Quando esta unidade morre, unidades em um raio de {GLITTER_EXPLOSION_UNIT_TARGETER>AREA>Radius}-hexágonos:[bulletlist][bullet/]Sofrem {GLITTER_EXPLOSION_UNIT_DAMAGE>DAMAGE>Shock} {GLOBAL.LightningDamageConcept.Hyperlink} e {GLITTER_EXPLOSION_UNIT_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}. Reduzido à metade para unidades amigas.[bullet/]Adquire um Efeito de Status Negativo aleatório.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY10@NAME"
msgstr "Explosão Cintilante"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY11@DESCRIPTION"
msgstr "Unidade alvo:[bulletlist][bullet/]Recebe dano.[bullet/]Ganha {GLOBAL.PROPERTIES.INSANITY.Hyperlink} e {GLOBAL.PROPERTIES.TWISTED_BRAND_ON_DEATH.Hyperlink} até o fim da batalha.[/bulletlist][br/]Não afeta Heróis, Feéricos ou unidades de Cerco."

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY11@NAME"
msgstr "Marca Torcida"

msgid "DLC@SECRETSOFTHEARCHMAGES@ABILITIES_WILDLIFE@ABILITY11@PROP_DESCRIPTION"
msgstr "Quando esta unidade morre, transforma‑se em um {GLOBAL.UNITS.EVENING_SPRITE.Hyperlink} sob controle inimigo.[br/][br/]Se esta unidade sobreviver ao combate, evolui e pode ser mantida por um custo de {GLOBAL.ManaConcept.Hyperlink}."

