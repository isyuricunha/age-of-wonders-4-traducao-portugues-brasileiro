msgid "INTERFACE@RESOURCE_ITEM@MANA"
msgstr "[mana/] Mana"

msgid "INTERFACE@RESOURCE_ITEM@MANA_DESCRIPTION"
msgstr "[mana/] Mana é a fonte bruta de magia. Usado para:[bulletlist][bullet/]Conjuração <<m:{GLOBAL.SpellConcept.Hyperlink}>>.[bullet/]Invocação de magia <<m:{GLOBAL.UnitConcept.Hyperlink}>>.[bullet/]Pagamento de {GLOBAL.UnitUpkeepConcept.Hyperlink}.[/bulletlist][br/]Ganhar [mana/] Mana por:[bulletlist][bullet/][hyperlink,GLOBAL.ProvinceAnnexationConcept]Anexando [/hyperlink] Nódulos de Mana.[bullet/]Construindo Condutos em <<m:{GLOBAL.ProvinceConcept.Hyperlink}>>.[bullet/]Construindo certos <<m:{GLOBAL.CityStructureConcept.Hyperlink}>>.[bullet/]Coletando <<m:{GLOBAL.PickupConcept.Hyperlink}>>.[/bulletlist]"

