msgid "INTERFACE@MAP_SETUP_TOOLTIP@WORLD_THREAT_DANGEROUS"
msgstr "Exércitos inimigos têm sua força aumentada e aumentam ao longo do tempo em ritmo mais rápido.[br/][br/]Cidades livres e infestações enviarão exércitos de ataque frequentes."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@WORLD_THREAT_LOW"
msgstr "Exércitos inimigos têm sua força reduzida e aumentam ao longo do tempo em ritmo lento.[br/][br/]Cidades livres e infestações enviarão menos exércitos de ataque."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@WORLD_THREAT_MODERATE"
msgstr "Exércitos inimigos têm força normal e aumentam ao longo do tempo em ritmo equilibrado.[br/][br/]Cidades livres e infestações enviarão exércitos de ataque regulares."

