msgid "TOME_SOULS@SKILL7@NAME"
msgstr "Reanimação de Esqueleto"

msgid "TOME_SOULS@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Colha <<m:{GLOBAL.SoulConcept}>> de seus inimigos e crie criaturas {GLOBAL.PROPERTIES.UNDEAD.Hyperlink}. Especialize-se em unidades descartáveis e no início da sua economia {GLOBAL.SoulConcept}."

msgid "TOME_SOULS@TOME@LORE_AUTHOR"
msgstr "Nocrom, a Mão Amaldiçoada"

msgid "TOME_SOULS@TOME@LORE_DESCRIPTION"
msgstr "\"Corpos são frágeis, porém forte é a vontade de todas as almas de se agarrar à vida. Conceda-lhes seu desejo! Forje vasos de carne podre e osso! Até o inimigo mais feroz servirá aos seus desejos quando ressuscitado do campo de batalha. Pois a morte alcança a todos, e, na morte, você habitará.\""

msgid "TOME_SOULS@TOME@NAME"
msgstr "Tomo de Almas"

msgid "TOME_SOULS@UNIT_1@NAME"
msgstr "Esqueleto^n"

