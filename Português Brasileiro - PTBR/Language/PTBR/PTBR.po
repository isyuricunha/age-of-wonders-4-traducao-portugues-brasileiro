msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@OVERGROWN_BUSH_GARDEN@NAME"
msgstr "Jardim de Arbustos Exuberantes"

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@OVERGROWN_ROSE_GARDEN@DESCRIPTION"
msgstr "Obstáculos adicionais de Trepadeiras de Rosa rastejantes estão presentes durante a batalha. Eles são {GLOBAL.SharpConcept.Hyperlink} e {GLOBAL.CreepingConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@OVERGROWN_ROSE_GARDEN@NAME"
msgstr "Jardim de Rosas Exuberante"

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@PARASITIC_INFECTION@DESCRIPTION"
