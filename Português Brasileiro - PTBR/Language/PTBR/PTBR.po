msgstr "Fragilidade Elemental"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@ELEMENTAL_MAYHEM@DESCRIPTION"
msgstr "Na primeira vez que cada {GLOBAL.PROPERTIES.ELEMENTAL.Hyperlink} {GLOBAL.UnitConcept.Hyperlink} defensor cair abaixo de {percent} de seu <<m:{GLOBAL.HitPointConcept.Hyperlink}>>:[bulletlist][bullet/]A Unidade teleporta até {hex} hexágonos longe dos atacantes.[bullet/]A Unidade se transforma em outra Unidade Elemental de Nível 1 aleatória.[bullet/]A Unidade recebe cura de {hp} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>[/bulletlist]"

msgid "DLC@RISEFROMRUIN@COMBATPROPERTIES_TACTICAL@ELEMENTAL_MAYHEM@NAME"
