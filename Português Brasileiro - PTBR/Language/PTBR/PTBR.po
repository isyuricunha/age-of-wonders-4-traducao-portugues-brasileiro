msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_ABJURATION@SKILL05@NAME"
msgstr "Armadura de Mago"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_ABJURATION@SKILL05@PROP_DESCRIPTION"
msgstr "Unidade tem:[bulletlist][bullet/]+{MAGE_ARMOR_DEFENSE>DEF_MOD>Armor} {GLOBAL.DefenseConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_ABJURATION@SKILL06@DESCRIPTION"
msgstr "Alvo: cidade própria ou cidade livre não hostil:[bulletlist][bullet/]Ganha +{amount} {GLOBAL.CityStabilityConcept.Hyperlink}.[bullet/]Ganha +{amount2} {GLOBAL.FortificationHealthConcept.Hyperlink} se não estiver sitiada.[bullet/]Se o alvo for uma cidade livre com um(a) {GLOBAL.DiplomaticTokenConcept.Hyperlink} próprio(a), ganha +{amount3} {GLOBAL.HouseInfluenceConcept.Hyperlink} por turno."

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_ABJURATION@SKILL06@NAME"
msgstr "Barreiras de Cidade"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_ABJURATION@SPI@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{amount} {GLOBAL.CityStabilityConcept.Hyperlink}[bullet/]Por cada {GLOBAL.ConduitConcept.Hyperlink} adjacente:[bulletlist][bullet/]+{amount2} {GLOBAL.CityStabilityConcept.Hyperlink}[bullet/]+{amount3} {GLOBAL.FortificationHealthConcept.Hyperlink}[/bulletlist][bullet/]Conta como um(a) {GLOBAL.ConduitConcept.Hyperlink}[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_ABJURATION@SPI@NAME"
msgstr "[conduit/] Torre de Glifo"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_ABJURATION@TOME@GAMEPLAY"
msgstr "Crie barreiras e proteções para preservar suas unidades."

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_ABJURATION@TOME@LORE_DESCRIPTION"
msgstr "\"O novato da arte arcana costuma se encantar com o espetáculo, confundindo chama e tempestade com maestria. Contudo, a maior magia é aquela que nos protege das forças do mal. Nenhum fogo ou relâmpago desfaz uma maldição, nenhuma nevasca protege totalmente aqueles ao seu lado, e nenhum poder proibido manterá os que você ama ao seu lado.\""

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_ABJURATION@TOME@NAME"
msgstr "Tomo de Abjuração"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_ABJURATION@UNIT@NAME"
msgstr "Pílono de Abjurador"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_BURNING_PASSION@SKILL01@DESCRIPTION"
msgstr "Um(a) {GLOBAL.PROPERTIES.MAGIC_FIGHTER.Hyperlink} que pode infligir {GLOBAL.PROPERTIES.DOMINATED.Hyperlink} em unidades inimigas."

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_BURNING_PASSION@SKILL01@NAME"
msgstr "Sedutora"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_BURNING_PASSION@SKILL02@DESCRIPTION"
msgstr "Conjurar um(a) {GLOBAL.UNITS.ORB_OF_DESIRE.Hyperlink} no hexágono alvo que <<m:{GLOBAL.PROPERTIES.ORB_TAUNT.Hyperlink}>> inimigos e queima atacantes.{LOC.CONCEPT@SUMMON_LIVE_SHARED}"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_BURNING_PASSION@SKILL02@NAME"
msgstr "Conjurar Orbe do Desejo"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_BURNING_PASSION@SKILL03@DESCRIPTION"
msgstr "Unidades encantadas recebem:[bulletlist][bullet/]{GLOBAL.PROPERTIES.BLAZING_AURA.Hyperlink}, queimando e causando dano aos inimigos próximos.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_BURNING_PASSION@SKILL03@NAME"
msgstr "Aura Ardente"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_BURNING_PASSION@SKILL03@PROP_DESCRIPTION"
msgstr "Unidade tem:[bulletlist][bullet/]{GLOBAL.PROPERTIES.BLAZING_AURA.Hyperlink}[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_BURNING_PASSION@SKILL04@DESCRIPTION"
msgstr "Os ataques base da unidade encantada recebem:[bulletlist][bullet/]Uma chance base {STRENGTH_SAPPING_PROJECTILES_RESISTANCE>ResolvedStrength}% c de infligir {GLOBAL.PROPERTIES.WEAKENED.Hyperlink} por {WEAKENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>. Ao ter sucesso, ganha {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} por {STRENGTHENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_BURNING_PASSION@SKILL04@MODIFIER_DESCRIPTION"
msgstr "Chance base {STRENGTH_SAPPING_PROJECTILES_RESISTANCE>ResolvedStrength}% c de infligir {GLOBAL.PROPERTIES.WEAKENED.Hyperlink} por {WEAKENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>. Ao ter sucesso, ganha {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} por {STRENGTHENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_BURNING_PASSION@SKILL04@NAME"
msgstr "Imbuimento Drenador de Força"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_BURNING_PASSION@SKILL04@PROP_DESCRIPTION"
msgstr "Os ataques base da unidade têm:[bulletlist][bullet/]Uma chance base {STRENGTH_SAPPING_PROJECTILES_RESISTANCE>ResolvedStrength}% c de infligir {GLOBAL.PROPERTIES.WEAKENED.Hyperlink} por {WEAKENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>. Ao ter sucesso, ganha {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} por {STRENGTHENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_BURNING_PASSION@SKILL05@DESCRIPTION"
msgstr "Alvo unidade amiga ganha:[bulletlist][bullet/]{GLOBAL.PROPERTIES.BERSERK.Hyperlink} por {THRILL_OF_COMBAT_STATUS_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]{amount} {GLOBAL.PROPERTIES.INFERNAL_MIGHT.Hyperlink} por {INFERNAL_BLAZE_DESCRIPTION>NumTurns}<<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_BURNING_PASSION@SKILL05@NAME"
msgstr "Excitação do Combate"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_BURNING_PASSION@SKILL06@DESCRIPTION"
msgstr "A raça-alvo ganha um núcleo ígneo, recebendo:[bulletlist][bullet/]+{FIERY_HEART_DEFENSE>REDUCTION>Fire} {GLOBAL.FireResistanceConcept.Hyperlink}[bullet/]+{FIERY_HEART_CRIT_CHANCE>ResolvedCritChanceBonus}% de chance {GLOBAL.CriticalHitConcept.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.FIRE_HAZARD_IMMUNITY.Hyperlink}"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_BURNING_PASSION@SKILL06@NAME"
msgstr "Coração Ardente"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_BURNING_PASSION@SKILL06@PROP_DESCRIPTION"
msgstr "Unidade tem:[bulletlist][bullet/]+{FIERY_HEART_DEFENSE>REDUCTION>Fire} {GLOBAL.FireResistanceConcept.Hyperlink}.[bullet/]+{FIERY_HEART_CRIT_CHANCE>ResolvedCritChanceBonus}% de chance {GLOBAL.CriticalHitConcept.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.FIRE_HAZARD_IMMUNITY.Hyperlink}.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_BURNING_PASSION@SPI@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{amount} {GLOBAL.UnitProductionConcept.Hyperlink}.[bullet/]+{amount2} {GLOBAL.GoldConcept.Hyperlink} por adjacente {GLOBAL.FarmConcept.Hyperlink}.[bullet/]Conta como um(a) {GLOBAL.QuarryConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_BURNING_PASSION@SPI@NAME"
msgstr "[quarry/] Casa da Paixão"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_BURNING_PASSION@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Fortaleça suas unidades com ira demoníaca, seduza seus inimigos com luxúria diabólica e envolva ambos em chamas infernais."

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_BURNING_PASSION@TOME@LORE_DESCRIPTION"
msgstr "\"O que seu coração ardente realmente deseja? Renda-se a ele — entregue-se aos seus prazeres, submeta-se aos seus anseios. Pois uma vida sem paixão é uma vida que não vale a pena viver. Abrace esse poder, minha doce sedutora. O amor, afinal, é uma arma à qual até os deuses mais poderosos são vulneráveis.\""

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_BURNING_PASSION@TOME@NAME"
msgstr "Tomo de Paixão Ardente"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_BURNING_PASSION@UNIT01@NAME"
msgstr "Orbe do Desejo"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_BURNING_PASSION@UNIT02@NAME"
msgstr "Sedutora"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_BURNING_PASSION@UNIT@ABILITY01@DESCRIPTION"
msgstr "A unidade inimiga-alvo tem uma base {TAUNTED_RESISTANCE>ResolvedStrength}% cança de se tornar {GLOBAL.PROPERTIES.TAUNTED.Hyperlink} por {TAUNTED_LINK_EFFECT>Duration} <<m:{GLOBAL.TurnConcept}>>."

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_BURNING_PASSION@UNIT@ABILITY02@DESCRIPTION"
msgstr "O dano recebido é refletido de volta ao atacante como {GLOBAL.FireDamageConcept.Hyperlink}."

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_BURNING_PASSION@UNIT@ABILITY02@NAME"
msgstr "Reflexão Ardente"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_BURNING_PASSION@UNIT@ABILITY03@DESCRIPTION"
msgstr "Unidade inimiga não-{GLOBAL.HeroConcept.Hyperlink} alvo tem uma base {KISS_OF_SEDUCTION_RESISTANCE_CHECK>ResolvedStrength}% cança de ser infligida com {GLOBAL.PROPERTIES.THRILLING_DOMINATION.Hyperlink}. Se falhar, o alvo em vez disso:[bulletlist][bullet/]Sustenta {KISS_OF_SEDUCTION_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Ganha {amount} {GLOBAL.PROPERTIES.BURNING.Hyperlink} por {BURNING_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][br/]Entra {GLOBAL.DefenseModeConcept.Hyperlink}."

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_BURNING_PASSION@UNIT@ABILITY03@NAME"
msgstr "Beijo da Sedução"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_BURNING_PASSION@UNIT@ABILITY04@DESCRIPTION"
msgstr "Atacantes adjacentes não-{GLOBAL.PROPERTIES.HERO.Hyperlink} não-{GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink} têm uma base {DISTRACTED_RESISTANCE>ResolvedStrength}% cança de se tornar {GLOBAL.PROPERTIES.DISTRACTED.Hyperlink}."

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_BURNING_PASSION@UNIT@ABILITY04@NAME"
msgstr "Maldição do Desejo"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_COSMOS@ABILITY01@DESCRIPTION"
msgstr "Inflige {COSMOS_BOLTS_EXTRA_DAMAGE>DAMAGE>Blight} de dano de um canal aleatório ao alvo."

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_COSMOS@ABILITY01@NAME"
msgstr "Raios Cósmicos"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_COSMOS@ABILITY02@DESCRIPTION"
msgstr "Unidades em uma linha de {COSMOS_BEAM_UNIT_TARGETER_LINE>AREA>Length}-hex de comprimento e {COSMOS_BEAM_UNIT_TARGETER_LINE>AREA>Width}-hex de largura recebem dano. Esta habilidade causa dano de acordo com os pontos de Afinidade que seu controlador possui:[bulletlist][bullet/]+{amount} {GLOBAL.LightningDamageConcept.Hyperlink} por {GLOBAL.AstralConcept.Hyperlink}[bullet/]+{amount} {GLOBAL.FireDamageConcept.Hyperlink} por {GLOBAL.ChaosConcept.Hyperlink}[bullet/]+{amount} {GLOBAL.PhysicalDamageConcept.Hyperlink} por {GLOBAL.MateriumConcept.Hyperlink}[bullet/]+{amount} {GLOBAL.BlightDamageConcept.Hyperlink} por {GLOBAL.NatureConcept.Hyperlink}[bullet/]+{amount} {GLOBAL.SpiritDamageConcept.Hyperlink} por {GLOBAL.OrderConcept.Hyperlink}[bullet/]+{amount} {GLOBAL.FrostDamageConcept.Hyperlink} por {GLOBAL.ShadowConcept.Hyperlink}[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_COSMOS@ABILITY02@NAME"
msgstr "Feixe Cósmico"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_COSMOS@ABILITY03@ASTRAL@DESCRIPTION"
msgstr "No início do turno, dentro de {COSMOS_MANIFEST_ENEMY_TARGETER_ASTRAL>AREA>Radius} hexágonos:[bulletlist][bullet/]Unidades amigas curam {COSMOS_MANIFEST_HEAL_ASTRAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> e recebem {GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink} por {BOLSTERED_RESISTANCE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Unidades inimigas sofrem {COSMOS_MANIFEST_DAMAGE_ASTRAL>DAMAGE>Shock} {GLOBAL.LightningDamageConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_COSMOS@ABILITY03@ASTRAL@NAME"
msgstr "Manifestação Cósmica: Astral"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_COSMOS@ABILITY03@CHAOS@DESCRIPTION"
msgstr "No início do turno, dentro de {COSMOS_MANIFEST_ENEMY_TARGETER_CHAOS>AREA>Radius} hexágonos:[bulletlist][bullet/]Unidades amigas recebem {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} e {GLOBAL.PROPERTIES.FORTUNE.Hyperlink} por {STRENGTHENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Unidades inimigas sofrem {COSMOS_MANIFEST_DAMAGE_CHAOS>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_COSMOS@ABILITY03@CHAOS@NAME"
msgstr "Manifestação Cósmica: Caos"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_COSMOS@ABILITY03@DESCRIPTION"
msgstr "Para cada afinidade igual ou superior a {amount}, receba a Habilidade Passiva correspondente:[bulletlist][bullet/]{GLOBAL.PROPERTIES.COSMOS_MANIFEST_ASTRAL.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.COSMOS_MANIFEST_CHAOS.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.COSMOS_MANIFEST_MATERIUM.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.COSMOS_MANIFEST_NATURE.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.COSMOS_MANIFEST_ORDER.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.COSMOS_MANIFEST_SHADOW.Hyperlink}[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_COSMOS@ABILITY03@MATERIUM@DESCRIPTION"
msgstr "No início do turno, dentro de {COSMOS_MANIFEST_ENEMY_TARGETER_MATERIUM>AREA>Radius} hexágonos:[bulletlist][bullet/]Unidades amigas curam {COSMOS_MANIFEST_HEAL_MATERIUM>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> e recebem {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink} por {BOLSTERED_DEFENSE_EFFECT_DESCRIPTION>NumTurns}<<m:{GLOBAL.TurnConcept}>>.[bullet/]Unidades inimigas sofrem {COSMOS_MANIFEST_DAMAGE_MATERIUM>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_COSMOS@ABILITY03@MATERIUM@NAME"
msgstr "Manifestação Cósmica: Materium"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_COSMOS@ABILITY03@NAME"
msgstr "Manifestação Cósmica"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_COSMOS@ABILITY03@NATURE@DESCRIPTION"
msgstr "No início do turno, dentro de {COSMOS_MANIFEST_ENEMY_TARGETER_NATURE>AREA>Radius} hexágonos:[bulletlist][bullet/]Unidades amigas curam {COSMOS_MANIFEST_NATURE_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Unidades inimigas sofrem {COSMOS_MANIFEST_DAMAGE_NATURE>DAMAGE>Blight} {GLOBAL.BlightDamageConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_COSMOS@ABILITY03@NATURE@NAME"
msgstr "Manifestação Cósmica: Natureza"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_COSMOS@ABILITY03@ORDER@DESCRIPTION"
msgstr "No início do turno, dentro de {COSMOS_MANIFEST_ENEMY_TARGETER_ORDER>AREA>Radius} hexágonos:[bulletlist][bullet/]Unidades amigas recebem {COSMOS_MANIFEST_MORALE>Morale Change Absolute} {GLOBAL.UnitMoraleConcept.Hyperlink}.[bullet/]Unidades inimigas sofrem {COSMOS_MANIFEST_DAMAGE_ORDER>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_COSMOS@ABILITY03@ORDER@NAME"
msgstr "Manifestação Cósmica: Ordem"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_COSMOS@ABILITY03@SHADOW@DESCRIPTION"
msgstr "No início do turno, dentro de {COSMOS_MANIFEST_ENEMY_TARGETER_SHADOW>AREA>Radius} hexágonos:[bulletlist][bullet/]Unidades amigas têm {GENERAL_DISPEL_NEGATIVE>NumThingsToDispel} Efeitos de Status Negativos removidos.[bullet/]Unidades inimigas sofrem {COSMOS_MANIFEST_DAMAGE_SHADOW>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_COSMOS@ABILITY03@SHADOW@NAME"
msgstr "Manifestação Cósmica: Sombra"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_COSMOS@ABILITY04@DESCRIPTION"
msgstr "Quando um feitiço é lançado em combate, receba +{COSMIC_RESONANCE_ASTRAL_PROTECTION>REDUCTION>Shock} Proteção de acordo com as afinidades do feitiço."

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_COSMOS@ABILITY04@NAME"
msgstr "Ressonância Cósmica"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_COSMOS@SKILL1@DESCRIPTION"
msgstr "Evoque o {GLOBAL.UNITS.AVATAR_OF_THE_COSMOS.Hyperlink}, um {GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink} que é fortalecido pelas suas próprias afinidades."

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_COSMOS@SKILL1@NAME"
msgstr "Evoque o Avatar do Cosmos"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_COSMOS@SKILL2@DESCRIPTION"
msgstr "Unidades encantadas recebem:[bulletlist][bullet/]+{COSMOS_AWAKENING_DAMAGE>DAMAGE>Shock} de dano de cada canal de dano.[bullet/]+{COSMOS_AWAKENING_PROTCTION>REDUCTION>Shock} de proteção de cada canal de dano.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_COSMOS@SKILL2@NAME"
msgstr "Despertar Cósmico"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_COSMOS@SKILL2@PROP_DESCRIPTION"
msgstr "Unidades têm:[bulletlist][bullet/]+{COSMOS_AWAKENING_DAMAGE>DAMAGE>Shock} de dano de cada canal de dano.[bullet/]+{COSMOS_AWAKENING_PROTCTION>REDUCTION>Shock} de proteção de cada canal de dano.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_COSMOS@SKILL3@DESCRIPTION"
msgstr "[bulletlist][bullet/]Revele o Mapa.[bullet/]+{amount} {GLOBAL.WorldMapCastingPointConcept.Hyperlink}.[bullet/]+{amount2} {GLOBAL.CombatCastingPointConcept.Hyperlink}.[bullet/]Para cada {GLOBAL.AffinityConcept.Hyperlink} com nível igual ou superior a {amount3} a cidade ganha +{amount4} do recurso baseado nessa afinidade.[bulletlist][bullet/]{GLOBAL.AstralConcept.Hyperlink} - {GLOBAL.ManaConcept.Hyperlink}[bullet/]{GLOBAL.ChaosConcept.Hyperlink} - {GLOBAL.UnitProductionConcept.Hyperlink}[bullet/]{GLOBAL.MateriumConcept.Hyperlink} - {GLOBAL.StructureProductionConcept.Hyperlink}[bullet/]{GLOBAL.NatureConcept.Hyperlink} - {GLOBAL.FoodConcept.Hyperlink}[bullet/]{GLOBAL.OrderConcept.Hyperlink} - {GLOBAL.GoldConcept.Hyperlink}[bullet/]{GLOBAL.ShadowConcept.Hyperlink} - {GLOBAL.KnowledgeConcept.Hyperlink}[/bulletlist][/bulletlist][br/][br/]Só pode ser construído no {GLOBAL.ThroneCityConcept.Hyperlink}."

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_COSMOS@SKILL3@NAME"
msgstr "Torre Prismática"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_COSMOS@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Use sua maestria sobre a magia do universo para fortalecer suas unidades e sua economia, e invocar um poderoso Avatar do Cosmos."

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_COSMOS@TOME@LORE_DESCRIPTION"
msgstr "\"Um dos passos decisivos rumo ao despertar cósmico é tornar‑se um errante, entregando‑se às correntes do Mar Astral. Nenhum verdadeiro mestre permanece preso a um único aspecto do arcano, ao contrário, abraça todo o seu espectro prismático. Pois, no fim, somos apenas a convergência de alma e corpo, ordem e caos, vida e morte.\""

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_COSMOS@TOME@NAME"
msgstr "Tomo do Cosmos"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_COSMOS@UNIT@NAME"
msgstr "Avatar do Cosmos^n"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_GLUTTONY@ABILITY01@DESCRIPTION"
msgstr "Unidade inimiga alvo recebe dano."

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_GLUTTONY@ABILITY01@NAME"
msgstr "Regurgitar"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_GLUTTONY@ABILITY02@DESCRIPTION"
msgstr "[bulletlist][bullet/]Ganhe uma pilha permanente de {GLOBAL.PROPERTIES.GORGED.Hyperlink}:[bulletlist][bullet/]No início do combate.[bullet/]Ao matar uma unidade inimiga.[/bulletlist][bullet/]Ao alcançar {amount} pilhas de {GLOBAL.PROPERTIES.GORGED.Hyperlink}, remova‑as e todas as unidades amigas dentro de {IMPS_HUNGER_CIRCLE>AREA>Radius} hexágonos:[bulletlist][bullet/]Cure {IMPS_HUNGER_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Ganhe {GLOBAL.PROPERTIES.GORGED.Hyperlink} se elas tiverem {GLOBAL.PROPERTIES.DEMONIC_HUNGER_PROPERTY_GROUP.Hyperlink}.[/bulletlist][/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_GLUTTONY@ABILITY02@NAME"
msgstr "Fome do Diabrete"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_GLUTTONY@DEMONIC_SATIATION@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{DEMONIC_SATIATION_HP_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[bullet/]Causa +{DEMONIC_SATIATION_MULT>ResolvedMultiplier}% damage.[bullet/]Acúmulo até {amount} vezes.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_GLUTTONY@DEMONIC_SATIATION@NAME"
msgstr "Satisfação Demoníaca"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_GLUTTONY@GORGED@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{GORGED>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]Acúmulo até {amount} vezes.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_GLUTTONY@GORGED@MOD_DESCRIPTION"
msgstr "Ao matar, ganhe {GLOBAL.PROPERTIES.GORGED.Hyperlink}."

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_GLUTTONY@GORGED@MOD_NAME"
msgstr "Devorar"

