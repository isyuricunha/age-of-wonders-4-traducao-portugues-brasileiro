msgstr "Herói ganha a habilidade {GLOBAL.PROPERTIES.ARTILLERY_BARRAGE.Hyperlink}."

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@HERO_SKILL1@NAME"
