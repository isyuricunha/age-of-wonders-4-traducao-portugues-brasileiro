msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_ABJURATION@SKILL03@DESCRIPTION"
msgstr "Alvo unidade inimiga:[bulletlist][bullet/]Tem uma chance base {ABJURE_VIOLENCE_CHECK>ResolvedStrength}% c de se tornar {GLOBAL.PROPERTIES.PACIFIED.Hyperlink} por {PACIFICED_STATUS_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]A chance diminui conforme a perda de <<m:{GLOBAL.HitPointConcept.Hyperlink}>> do alvo.[/bulletlist]"

