msgstr "Névoa"

msgid "FEY_INVASION@MIST_HAZARD@DESCRIPTION"
msgstr "Unidades que terminarem o turno neste hexágono recebem {GLOBAL.PROPERTIES.CLINGING_MIST.Hyperlink}."

