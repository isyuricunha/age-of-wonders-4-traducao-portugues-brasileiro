msgid "DLC@EMPIRESANDASHES@REALM_TRAIT@WARDEN_OF_MANUHARI@NAME"
msgstr "Guardião de Manuhari"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT01@DESCRIPTION"
msgstr "A cada {amount} <<m:{GLOBAL.TurnConcept}>>, unidades inimigas:[bulletlist][bullet/]Sofrem {CONDEMNATION_STRIKE_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink}.[bullet/]Têm uma chance base de {CONDEMN_RESISTANCE>ResolvedStrength}% c se tornarem {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT01@NAME"
msgstr "Surto Condenatório"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT02@DESCRIPTION"
msgstr "Quando uma unidade aliada morre, todas as unidades inimigas adjacentes:[bulletlist][bullet/]Sofrem {MARTYRDOM_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink}.[bullet/]Tornam‑se {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT02@NAME"
msgstr "Martírio"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT02@PROP_DESCRIPTION"
msgstr "Quando esta unidade morre, todas as unidades inimigas adjacentes:[bulletlist][bullet/]Sofrem {MARTYRDOM_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink}[bullet/]Tornam‑se {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT03@DESCRIPTION"
msgstr "A cada {amount} <<m:{GLOBAL.TurnConcept}>>, uma unidade aliada aleatória:[bulletlist][bullet/]Ganha {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink}.[bullet/]Ganha {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}.[bullet/]Esse efeito então se aplica às unidades aliadas adjacentes e se repete.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT03@NAME"
msgstr "Empoderamento em Cascata"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT04@DESCRIPTION"
msgstr "A cada {amount} <<m:{GLOBAL.TurnConcept}>>, unidades inimigas:[bulletlist][bullet/]Têm uma chance base de {MISFORTUNE_RESISTANCE>ResolvedStrength}% c ganhar {GLOBAL.PROPERTIES.MISFORTUNE.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT04@NAME"
msgstr "Onda de Desgraça"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT05@DESCRIPTION"
msgstr "A cada {amount} <<m:{GLOBAL.TurnConcept}>>, {amount2} unidades inimigas aleatórias têm uma:[bulletlist][bullet/]Chance base de {GHOSTFIRE_RESISTANCE>ResolvedStrength}% c ser afetadas por {GLOBAL.PROPERTIES.GHOSTFIRE.Hyperlink}.[bullet/]Chance base de {ELECTRIFIED_RESISTANCE>ResolvedStrength}% c ser afetadas por {GLOBAL.PROPERTIES.ELECTRIFIED.Hyperlink}.[bullet/]Chance base de {FROZEN_RESISTANCE>ResolvedStrength}% c ser afetadas por {GLOBAL.PROPERTIES.FROZEN.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT05@NAME"
msgstr "Flagelo Elemental"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT06@DESCRIPTION"
msgstr "Cada turno, uma unidade aleatória dos inimigos do proprietário, e unidades inimigas adjacentes:[bulletlist][bullet/]Sofrem {METEOR_SHOWER_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Sofrem {METEOR_SHOWER_UNIT_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT06@NAME"
msgstr "Meteoro Minúsculo"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT07@DESCRIPTION"
msgstr "Um {GLOBAL.UNITS.DECAYING_ZOMBIE.Hyperlink} é invocado ao lado de uma das unidades do proprietário a cada {amount} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT07@NAME"
msgstr "Abrir Túmulos"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT08@DESCRIPTION"
msgstr "A cada {GLOBAL.TurnConcept}, {amount2} unidades aleatórias dos inimigos do proprietário sofrem:[bulletlist][bullet/]{COSMIC_BOLT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}[bullet/]{COSMIC_BOLT_DAMAGE>DAMAGE>Shock} {GLOBAL.LightningDamageConcept.Hyperlink}[bullet/]{COSMIC_BOLT_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT08@NAME"
msgstr "Raios Cósmicos"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@COMBAT_ENCHANTMENT09@DESCRIPTION"
msgstr "Um {GLOBAL.UNITS.GREMLIN_UNIT.Hyperlink} é invocado ao lado de uma das unidades do proprietário a cada {amount} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@CONDITION@DESCRIPTION"
msgstr "Para alcançar a Vitória dos Selos, um {GLOBAL.EmpireConcept.Hyperlink} precisa acumular pontos suficientes capturando e mantendo Selos.[br/][br/]Selos são encontrados por todo o mundo e podem ser capturados a qualquer momento. Para cada selo que você capturou, ganha 1 ponto a cada {GLOBAL.TurnConcept.Hyperlink}. Durante esse período, defensores dos Selos surgirão a cada <<m:{GLOBAL.TurnConcept.Hyperlink}>> em um dos seus Selos reivindicados e tentarão retomar o Selo sob seu controle. Se você controlar mais Selos, eles surgirão com mais frequência.[br/][br/]A Vitória dos Selos precisa ser ativada adicionando um dos Traços de Reino dos Selos."

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@CONDITION@NAME"
msgstr "Vitória dos Selos"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@EVENT_SEAL_CAPTURED@OTHER"
msgstr "É evidente que <<p:{Player.Name}>> está buscando um {GLOBAL.SealsVictoryConcept.Hyperlink}. Você precisará impedir que <<P:{Player.Name}>> mantenha Selos, ou manter Selos por conta própria."

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@EVENT_SEAL_CAPTURED@YOU"
msgstr "Enquanto você mantiver um exército no Selo, ganhará pontos para um {GLOBAL.SealsVictoryConcept.Hyperlink}. Cuidado, pois os Guardiões do Selo tentarão reconquistá‑lo!"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@NOTIFY_ATTACKERS_SPAWNED@YOU"
msgstr "Defensores do Selo surgiram"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@NOTIFY_SEAL_CAPTURED@OTHER"
msgstr "{Player.Name} capturou o primeiro Selo <<o:{Player.Name}>>"

msgid "DLC@EMPIRESANDASHES@SEALS_VICTORY@NOTIFY_SEAL_CAPTURED@YOU"
