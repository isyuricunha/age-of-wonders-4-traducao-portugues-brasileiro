msgid "DLC@WAYSOFWAR@META_EMPIRE@REALM_PARADISE_DIVIDED@SUBTITLE"
msgstr "Já conhecido como um reino de paz e paraíso, sua prosperidade e ordem foram ameaçadas por calamidade e conflito. Três Impérios lutam para reconstruir o paraíso à sua imagem."

msgid "DLC@WAYSOFWAR@META_EMPIRE@REALM_PARADISE_DIVIDED@TEMPLATE_NAME"
msgstr "Paraíso Dividido"

msgid "DLC@WAYSOFWAR@META_EMPIRE@REALM_THREEWAYWAR@TEMPLATE_NAME"
msgstr "Guerra de Três Frentes"

msgid "DLC@WAYSOFWAR@META_EMPIRE@REALM_TRAIT@OATHSWORN_DISPUTE@DESCRIPTION"
msgstr "Este Reino é o palco de uma disputa violenta entre três Godir Juramentados, que discordam em questões de doutrina.[bulletlist][bullet/]Os Godir Juramentados {OATHSWORN_DISPUTE_LEADER_1.Hyperlink}, {OATHSWORN_DISPUTE_LEADER_2.Hyperlink} e {OATHSWORN_DISPUTE_LEADER_3.Hyperlink} estão presentes e começam em nível mais alto.[bullet/]{OATHSWORN_DISPUTE_LEADER_1.Hyperlink}, {OATHSWORN_DISPUTE_LEADER_2.Hyperlink} e {OATHSWORN_DISPUTE_LEADER_3.Hyperlink} começam em {GLOBAL.WarConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@WAYSOFWAR@META_EMPIRE@REALM_TRAIT@OATHSWORN_DISPUTE@NAME"
msgstr "Rivalidade Juramentada"

msgid "DLC@WAYSOFWAR@META_EMPIRE@TRAIT_LAND_OF_CONFLICT@DESCRIPTION"
msgstr "Forças de calamidade e prosperidade ocupam esta terra.[bulletlist][bullet/]{GLOBAL.PROPERTIES.ACCURSED.Hyperlink} e Prosperidade <<m:{GLOBAL.UnitConcept.Hyperlink}>> são [abilityblue]Comum[/abilityblue].[/bulletlist]"

msgid "DLC@WAYSOFWAR@META_EMPIRE@TRAIT_LAND_OF_CONFLICT@NAME"
msgstr "Terra do Conflito"

msgid "DLC@WAYSOFWAR@MINOR_FACTION@UPGRADE_SET@CALAMITY@DESCRIPTION"
msgstr "Estes são os Mestres da Calamidade, que se arruinam e arruinam os outros para apaziguar forças destrutivas de outros mundos. Eles invocam sombras cegantes e seres amaldiçoados para erradicar aqueles que os opõem."

msgid "DLC@WAYSOFWAR@MINOR_FACTION@UPGRADE_SET@CALAMITY@NAME"
msgstr "Mestres da Calamidade"

msgid "DLC@WAYSOFWAR@MINOR_FACTION@UPGRADE_SET@PROSPERITY@DESCRIPTION"
msgstr "Estes são os Mestres da Prosperidade, clérigos e monges que se revigoram através de sua graça interior. Forças de prosperidade e da natureza abençoam suas ações e os protegem em tempos de crise."

msgid "DLC@WAYSOFWAR@MINOR_FACTION@UPGRADE_SET@PROSPERITY@NAME"
msgstr "Mestres da Prosperidade"

