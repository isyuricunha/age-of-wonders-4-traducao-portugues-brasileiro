msgstr "Trocar Localização"

msgid "STACK@CONFIRM_SPEED_MARCH@DESCRIPTION"
msgstr "As unidades deste exército ganham {movepointgain} de seu total <<m:{GLOBAL.MovePointConcept.Hyperlink}>> de volta.[br/]As unidades perdem {STR_HitpointPcnt}% of de seu total <<m:{GLOBAL.HitPointConcept.Hyperlink}>> e tornam-se {GLOBAL.PROPERTIES.EXHAUSTED.Hyperlink} por {STR_ExhaustTurns} <<m:{GLOBAL.TurnConcept.Hyperlink}>>.[br/]Custo: {STR_Cost} ({STR_UnitCost} por unidade)."

