msgid "COMBATPROPERTIES_TACTICAL@ORDER_OF_GLUTTON@NAME"
msgstr "Poder Glutão"

msgid "COMBATPROPERTIES_TACTICAL@ORDER_OF_GLUTTON_ABILITY@DESCRIPTION"
msgstr "Consuma alimento para ganhar 1 camada de {GLOBAL.PROPERTIES.COMBATPROPERTY_DEVOURED_POWER.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@ORDER_OF_GLUTTON_ABILITY@NAME"
msgstr "Devorar Alimento"

msgid "COMBATPROPERTIES_TACTICAL@ORDER_OF_GLUTTON_CONDEMN@DESCRIPTION"
msgstr "Todas as unidades defensoras sofrem {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink} até o fim da batalha."

msgid "COMBATPROPERTIES_TACTICAL@ORDER_OF_GLUTTON_CONDEMN@NAME"
