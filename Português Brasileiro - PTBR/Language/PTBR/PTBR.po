msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_WEAVER@ABILITY2@NAME"
msgstr "Renascimento da Aranha"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_WEAVER@ABILITY3@DESCRIPTION"
msgstr "[bulletlist][bullet/]Alvo: unidade amiga:[bulletlist][bullet/]Cura {WEBBED_TRANSFUSION_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Remove seus Efeitos de Status Negativos.[/bulletlist][bullet/]Então uma unidade inimiga dentro de {WEBBED_TRANSFUSION_JUMP_TARGETER>MaxDistance} hexágonos:[bulletlist][bullet/]Sofre {WEBBED_TRANSFUSION_DAMAGE>DAMAGE>Blight} {GLOBAL.BlightDamageConcept.Hyperlink} e {WEBBED_TRANSFUSION_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Tem uma chance base {IMMOBILIZED_RESISTANCE>ResolvedStrength}% c chance de se tornar {GLOBAL.PROPERTIES.IMMOBILIZED.Hyperlink} por {IMMOBILIZED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@TOME_WEAVER@ABILITY3@NAME"
msgstr "Transfusão de Teia"

