msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@RAGING_VOLCANO@DESCRIPTION"
msgstr "<<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacente a este Marco recebe:[bulletlist][bullet/]{income}.[bullet/]O {combatproperty} <<m:{GLOBAL.CombatEnchantmentConcept.Hyperlink}>>.[bullet/]<<m{GLOBAL.UnitConcept.Hyperlink}>> na Província recebe {GLOBAL.PROPERTIES.VOLCANIC_HEAT_UNIT_PROPERTY.Hyperlink}.[/bulletlist][br/]Um {GLOBAL.CityConcept.Hyperlink} com {amount} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacente a este Marco recebe:[bulletlist][bullet/]Desbloqueia o recrutamento de {GLOBAL.PROPERTIES.INFERNAL_FIEND.Hyperlink} e {GLOBAL.UNITS.MAGMA_SPIRIT.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>>.[/bulletlist]"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@RAGING_VOLCANO@LORE"
msgstr "\"Basta observar a devastação que os vulcões provocam para entender seu potencial arcano... E seu encanto mítico. Alguns propõem que esses abismos flamejantes servem como portais para {GLOBAL.ObbadothLoreConcept.Hyperlink}. Ainda não confirmei se os demônios encontrados aqui surgiram do próprio coração fundido, ou se simplesmente o reivindicaram como sua morada.\"[br/][br/]— Larissa Mirabilis, Mito e Verdade: Folclore e suas Origens Arcanas"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@RAGING_VOLCANO@NAME"
