msgstr "Obstáculos de Muralha de Lithorita são {GLOBAL.FortifiedConcept.Hyperlink} com grande quantidade de <<m:{GLOBAL.HitPointConcept.Hyperlink}>> e infligem {GLOBAL.PROPERTIES.VOLATILE_CHARGE.Hyperlink} nas Unidades em um raio de {radius} hexágonos quando destruídos."

msgid "DLC@GIANTKINGS@CITYDEFINITION_STRATEGIC@VOLATILE_RUNES@NAME"
msgstr "Runas Voláteis"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@ACIDIC_VAPOURS@DESCRIPTION"
msgstr "A cada {GLOBAL.TurnConcept.Hyperlink}, algumas posições tornam-se {GLOBAL.PROPERTIES.POISONOUS.Hyperlink} por {timer} turnos. Todas as unidades defensoras são imunes ao efeito de veneno."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@ACIDIC_VAPOURS@NAME"
msgstr "Poças Ácidas"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@ANCIENT_DRACONIC_INSTINCT@DESCRIPTION"
msgstr "Todos os {GLOBAL.PROPERTIES.DRAGON.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> recebem {GLOBAL.PROPERTIES.FRENZY.Hyperlink} até o final do combate."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@ANCIENT_DRACONIC_INSTINCT@NAME"
msgstr "Frenesi Dracônico Antigo"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@BEHEMOTHS_DREADFUL_PRESENCE@DESCRIPTION"
msgstr "A cada {GLOBAL.TurnConcept.Hyperlink}, cada unidade tem {chance} de sofrer {GLOBAL.PROPERTIES.REMORSE.Hyperlink}."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@BEHEMOTHS_DREADFUL_PRESENCE@NAME"
msgstr "Presença Aterrorizante do Beemote"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@BERSERK_WYRMS@DESCRIPTION"
msgstr "Serpentes menores tornam-se {GLOBAL.PROPERTIES.BERSERK.Hyperlink}."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@BERSERK_WYRMS@NAME"
msgstr "Frenesi Serpentino"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@BINDING_HEX@DESCRIPTION"
msgstr "Várias posições no mapa contêm uma Hexa de Vinculação. Quando um Demônio Infernal atravessa uma Hexa de Vinculação, ele fica {GLOBAL.PROPERTIES.STUNNED.Hyperlink} por {timer} {GLOBAL.TurnConcept.Hyperlink} e a Hexa de Vinculação é removida."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@BINDING_HEX@NAME"
msgstr "Hexa de Vinculação"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@BLINDED_MOTH@DESCRIPTION"
msgstr "No início do combate, a Mariposa Primordial está {GLOBAL.PROPERTIES.BLINDED.Hyperlink} por {value} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@BLINDED_MOTH@NAME"
msgstr "Sobrecarga Sensorial"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@BRING_IN_DEVASTATORS@DESCRIPTION"
msgstr "No início do combate, o líder da sua pilha traz {NumberOfSpheres} <<m:{GLOBAL.UNITS.DEVASTATOR_SPHERE_UNIT}>>."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@BRING_IN_DEVASTATORS@NAME"
msgstr "Recrutar Devastadores"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@CHAINED_BASILISK@DESCRIPTION"
msgstr "O Basilisco Primordial inicia a batalha {GLOBAL.PROPERTIES.STUNNED.Hyperlink} por {timer} {GLOBAL.TurnConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@CHAINED_BASILISK@NAME"
msgstr "Basilisco Encadeado"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@CINDER_STORM@DESCRIPTION"
msgstr "A cada {value} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, a Mariposa Primordial bate as asas, fazendo com que uma das unidades atacantes se torne {GLOBAL.PROPERTIES.BLINDED.Hyperlink} por {BlindValue} <<m:{GLOBAL.TurnConcept.Hyperlink}>> e {GLOBAL.PROPERTIES.BURNING.Hyperlink} por {BurnValue} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@CINDER_STORM@NAME"
msgstr "Tempestade de Cinzas"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@CLAY_REBIRTH@DESCRIPTION"
msgstr "Os soldados de barro defensores recebem {GLOBAL.PROPERTIES.FIERY_REBIRTH.Hyperlink}."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@CLAY_REBIRTH@NAME"
msgstr "Criado por chamas primordiais"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@DELAYED_SURGE@DESCRIPTION"
msgstr "A cada {value} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, todas as unidades atacantes têm {chance} de chance de sofrer Carga Volátil."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@DELAYED_SURGE@NAME"
msgstr "Surto Volátil Atrasado"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@DEMORALIZED_DEFENDERS@DESCRIPTION"
msgstr "No início do combate, todas as unidades defensoras recebem {numberOfStacks} pilhas de {GLOBAL.PROPERTIES.DEMORALIZED.Hyperlink} até o final do combate."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@DEMORALIZED_DEFENDERS@NAME"
msgstr "Defensores Desmoralizados"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@DISPERSE_DEFENDERS@DESCRIPTION"
msgstr "No início do combate, metade das unidades Lithorinas defensoras torna-se {GLOBAL.PROPERTIES.HASTENED.Hyperlink} por {value} <<m:{GLOBAL.TurnConcept.Hyperlink}>> e a outra metade torna-se {GLOBAL.PROPERTIES.SLOWED.Hyperlink} por {value} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@DISPERSE_DEFENDERS@NAME"
msgstr "Dispersar Defensores"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@ELEMENTAL_ATTUNEMENT@DESCRIPTION"
msgstr "Todos os {GLOBAL.PROPERTIES.ELEMENTAL.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> recebem {GLOBAL.PROPERTIES.ELEMENTAL_ATTUNEMENT_UNITPROP.Hyperlink} até o final do combate."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@ELEMENTAL_ATTUNEMENT@NAME"
msgstr "Sintonização Elemental"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@ELEMENTAL_ATTUNEMENT@PROPERTY_DESCRIPTION"
msgstr "Quando um {GLOBAL.SpellConcept.Hyperlink} é lançado, o ataque base desta unidade recebe +{amount} de dano com base no {GLOBAL.AffinityConcept.Hyperlink} do feitiço:[bulletlist][bullet/]{GLOBAL.OrderConcept.Hyperlink} - {GLOBAL.SpiritDamageConcept.Hyperlink}[bullet/]{GLOBAL.ChaosConcept.Hyperlink} - {GLOBAL.FireDamageConcept.Hyperlink}[bullet/]{GLOBAL.AstralConcept.Hyperlink} - {GLOBAL.LightningDamageConcept.Hyperlink}[bullet/]{GLOBAL.MateriumConcept.Hyperlink} - {GLOBAL.PhysicalDamageConcept.Hyperlink}[bullet/]{GLOBAL.NatureConcept.Hyperlink} - {GLOBAL.BlightDamageConcept.Hyperlink}[bullet/]{GLOBAL.ShadowConcept.Hyperlink} - {GLOBAL.FrostDamageConcept.Hyperlink}[/bulletlist][br/]Acumula até {STAR_BLADES_STATUS_DESCRIPTION>MaxStacks} vezes.[br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@GIANTS_BLESSING@DESCRIPTION"
msgstr "A cada {GLOBAL.TurnConcept.Hyperlink}, uma das unidades defensoras que ainda não foi alvo recebe o {GLOBAL.PROPERTIES.SUPERGROWTH_PROPERTY_GROUP.Hyperlink} {GLOBAL.RaceTransformationConcept.Hyperlink} e recupera totalmente o <<m:{GLOBAL.HitPointConcept.Hyperlink}>>."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@GIANTS_BLESSING@NAME"
msgstr "Bênção do Gigante"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@GIANTS_BLESSING_ATTACKERS@DESCRIPTION"
msgstr "A cada {GLOBAL.TurnConcept.Hyperlink}, uma das unidades atacantes que ainda não foi alvo recebe o {GLOBAL.PROPERTIES.SUPERGROWTH_PROPERTY_GROUP.Hyperlink} {GLOBAL.RaceTransformationConcept.Hyperlink} e recupera totalmente o <<m:{GLOBAL.HitPointConcept.Hyperlink}>>."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@GIANTS_JUDGEMENT@DESCRIPTION"
msgstr "Os ataques do seu Gigante Governante infligem {GLOBAL.PROPERTIES.REMORSE.Hyperlink} por {NumberOfTurns} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@GIANTS_JUDGEMENT@NAME"
msgstr "Julgamento do Gigante"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@GIANT_DISTRACTION_TACTICS@DESCRIPTION"
msgstr "Os ataques {GLOBAL.FlankingConcept.Hyperlink} das unidades atacantes têm {chance} de chance de infligir {GLOBAL.PROPERTIES.DISTRACTED.Hyperlink}."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@GIANT_DISTRACTION_TACTICS@NAME"
msgstr "Táticas de Distração do Gigante"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@GIANT_SLAYING_LEGEND@DESCRIPTION"
msgstr "O {GLOBAL.PROPERTIES.EXPEDITION_LEADER.Hyperlink} ganha a propriedade {GLOBAL.SKILLS.HUNTERS_CROSSBOW_SKILL.Hyperlink}."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@GIANT_SLAYING_LEGEND@NAME"
msgstr "Lenda da Matança do Gigante"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@INFERNAL_FEED@DESCRIPTION"
msgstr "Sempre que Invasores Infernais geram uma unidade, seu Líder de Expedição ganha {StackCount} pilhas de {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} por {timer} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@INFERNAL_FEED@NAME"
msgstr "Alimento Infernal"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@INFERNAL_INVADERS@DESCRIPTION"
msgstr "A cada {timer} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, enquanto o Cão Primordial defensor estiver vivo, um Demônio de nível {tiers} defensor surge próximo a ele. Essas unidades permanecem até o fim do combate."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@INFERNAL_INVADERS@NAME"
msgstr "Invasores Infernais"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@LITHORITE_DISRUPTION@DESCRIPTION"
msgstr "Metade das unidades Lithorinas defensoras iniciam a batalha {GLOBAL.PROPERTIES.STUNNED.Hyperlink} por {value} {GLOBAL.TurnConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@LITHORITE_DISRUPTION@NAME"
msgstr "Disrupção Lithorita"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@LITHORITE_RECOMBINATION@DESCRIPTION"
msgstr "Enquanto o Primordial Bloodback estiver vivo, sempre que uma Unidade Lithorina Defensora de Nível 1 a 3 morrer, se houver outro Cadáver Lithorino no mapa, ressuscite-o como uma unidade Lithorina um nível acima da unidade que acabou de morrer."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@LITHORITE_RECOMBINATION@NAME"
msgstr "Reciclagem de Pedra Rachada"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@PUNY_SLAYING@DESCRIPTION"
msgstr "Todas as unidades defensoras recebem {GLOBAL.PROPERTIES.PUNY_SLAYER.Hyperlink} até o fim do combate."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@PUNY_SLAYING@NAME"
msgstr "Matança dos Fracos"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@REVERSE_GROWTH@DESCRIPTION"
msgstr "A cada {GLOBAL.TurnConcept.Hyperlink}, uma das unidades defensoras que ainda não foi alvo recebe o {GLOBAL.PROPERTIES.SPAWNKIN_PROPERTY_GROUP.Hyperlink} {GLOBAL.RaceTransformationConcept.Hyperlink} e tem seu Máximo {GLOBAL.HitPointConcept.Hyperlink} reduzido em {ReducedHealth}."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@REVERSE_GROWTH@NAME"
msgstr "Maldição dos Fracos"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@SLOWED_INVADERS@DESCRIPTION"
msgstr "Unidades geradas pelos Invasores Infernais sofrem {GLOBAL.PROPERTIES.SLOWED.Hyperlink} por {timer} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@SLOWED_INVADERS@NAME"
msgstr "Invasores Lentos"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@STAND_TOGETHER@DESCRIPTION"
msgstr "Todas as unidades atacantes recebem {GLOBAL.PROPERTIES.STAND_TOGETHER.Hyperlink} até o fim do combate."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@STAND_TOGETHER@NAME"
msgstr "Juntos Resistimos"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@STOKED_FIRE@DESCRIPTION"
msgstr "As unidades de barro defensoras iniciam o combate {GLOBAL.PROPERTIES.BURNING.Hyperlink}."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@STOKED_FIRE@NAME"
msgstr "Fogo Inflamado"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@STOP_UNDYING@DESCRIPTION"
msgstr "Todos os soldados de barro defensores não podem usar suas habilidades {GLOBAL.PROPERTIES.UNDYING.Hyperlink} e {GLOBAL.PROPERTIES.FIERY_REBIRTH.Hyperlink}."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@STOP_UNDYING@NAME"
msgstr "Ressurreição Selada"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@TAUNTED_SENTRIES@DESCRIPTION"
msgstr "Cada unidade defensora é {GLOBAL.PROPERTIES.TAUNTED.Hyperlink} por uma unidade atacante aleatória até o fim da batalha."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@TAUNTED_SENTRIES@NAME"
msgstr "Sentinelas Provocadas"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@UNDYING_BATTLEFIELD@DESCRIPTION"
msgstr "A cada {GLOBAL.TurnConcept.Hyperlink}, cada cadáver é ressuscitado como uma unidade Esqueleto aleatória com {GLOBAL.PROPERTIES.BERSERK.Hyperlink}.[br/][br/] As unidades Esqueleto não são ressuscitadas por este efeito, são {GLOBAL.PROPERTIES.NON_VITAL.Hyperlink} e morrem ao final do combate."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@UNDYING_BATTLEFIELD@NAME"
msgstr "Campo de Batalha Imortal"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@VOLATILE_SURGE@DESCRIPTION"
msgstr "A cada {value} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, todas as unidades atacantes têm {Chance} de chance de sofrer {GLOBAL.PROPERTIES.VOLATILE_CHARGE.Hyperlink}."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@VOLATILE_SURGE@NAME"
msgstr "Surto Volátil"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@VOLATILE_WAVE@DESCRIPTION"
msgstr "A cada {turn} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, todas as unidades atacantes têm {Chance} de chance de sofrer {GLOBAL.PROPERTIES.VOLATILE_CHARGE.Hyperlink} a menos que já estejam sofrendo disso. {GLOBAL.PROPERTIES.VOLATILE_CHARGE.Hyperlink} expira em {turn2} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@VOLATILE_WAVE@NAME"
msgstr "Onda Volátil"

msgid "DLC@GIANTKINGS@COMBATPROPERTIES_TACTICAL@VOLATILE_WAVE@UNLOCK"
msgstr "Onda Volátil durante o combate"

msgid "DLC@GIANTKINGS@CRISIS@1167_878@DESCRIPTION"
msgstr "Os {GLOBAL.EternalSagesLoreConcept.Hyperlink} buscam se comunicar com seus semelhantes através do {GLOBAL.AstralSeaLoreConcept.Hyperlink}. Eles recrutaram alguém com o poder de um {GLOBAL.GodirLoreConcept.Hyperlink} para atuar como seu Mediador."

msgid "DLC@GIANTKINGS@CRISIS@1167_878@DESCRIPTION_ACTIVE"
msgstr "[bulletlist][bullet/]Cidades ganham +100% {GLOBAL.KnowledgeConcept.Hyperlink} de renda.[/bulletlist]"

msgid "DLC@GIANTKINGS@CRISIS@1167_878@DESCRIPTION_ACTIVE_MEDIUM"
msgstr "[bulletlist][bullet/]Cidades recebem +100% {GLOBAL.KnowledgeConcept.Hyperlink} de renda.[bullet/]Como Médium, você ganha recompensas adicionais quando qualquer jogador completa {GLOBAL.ResearchConcept.Hyperlink}:[bulletlist][bullet/]{GLOBAL.OrderConcept.Hyperlink} pesquisa gera {GLOBAL.CityStabilityConcept.Hyperlink} em todas as suas Cidades.[bullet/]{GLOBAL.ChaosConcept.Hyperlink} pesquisa gera {GLOBAL.UnitProductionConcept.Hyperlink} em todas as suas Cidades.[bullet/]{GLOBAL.AstralConcept.Hyperlink} pesquisa gera {GLOBAL.ManaConcept.Hyperlink}.[bullet/]{GLOBAL.MateriumConcept.Hyperlink} pesquisa gera {GLOBAL.GoldConcept.Hyperlink}.[bullet/]{GLOBAL.NatureConcept.Hyperlink} pesquisa gera {GLOBAL.FoodConcept.Hyperlink} em todas as suas Cidades.[bullet/]{GLOBAL.ShadowConcept.Hyperlink} pesquisa gera {GLOBAL.KnowledgeConcept.Hyperlink} em todas as suas Cidades.[bullet/]Pesquisa sem nenhum {GLOBAL.AffinityConcept.Hyperlink} concede a você {GLOBAL.ImperiumConcept.Hyperlink}.[bullet/]Dupla {GLOBAL.AffinityConcept.Hyperlink} pesquisa gera as recompensas para ambas as Afinidades.[/bulletlist][/bulletlist]"

msgid "DLC@GIANTKINGS@CRISIS@1167_878@NAME"
msgstr "O Conclave Cósmico"

msgid "DLC@GIANTKINGS@CRISIS@1167_878@SUB_HEADER"
msgstr "O {GLOBAL.CrystalDwellingConcept.Hyperlink} inicia o ritual do Conclave Cósmico."

msgid "DLC@GIANTKINGS@CRISIS@1167_878@SUB_HEADER_ACTIVE"
msgstr "[bulletlist][bullet/]Renda global de {GLOBAL.KnowledgeConcept.Hyperlink} aumentou em +100%.[/bulletlist]"

msgid "DLC@GIANTKINGS@CRISIS@1167_878@SUB_HEADER_ACTIVE_MEDIUM"
msgstr "[bulletlist][bullet/]Renda global de {GLOBAL.KnowledgeConcept.Hyperlink} aumentou em +100%.[bullet/] Você ganha bônus adicionais quando qualquer jogador completa {GLOBAL.ResearchConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@CRISIS@1194_1502@DESCRIPTION"
msgstr "O culto dos Filhos de Kjörnoe acredita que você, o proprietário dos Artefatos Malditos da Alma, pode reavivar seus amados Reis Traidores. Para que isso aconteça, um ritual sombrio precisa ser realizado, o que requer um sacrifício poderoso..."

msgid "DLC@GIANTKINGS@CRISIS@1194_1502@NAME"
msgstr "Retorno de Kjörnoe"

msgid "DLC@GIANTKINGS@CRISIS@1194_1502@SUB_HEADER"
msgstr "Um culto estranho se aproxima do Guardião dos Artefatos Malditos da Alma."

msgid "DLC@GIANTKINGS@CRISIS@991_7303@DESCRIPTION"
msgstr "Os Campos Famintos são amaldiçoados por uma fome incessante. Envolto em malícia, o guloso {TSR_TRAITOR_KING} manifestou <<r:TSR_TRAITOR_KING>> com três aspectos diferentes para desafiar e enfraquecer."

msgid "DLC@GIANTKINGS@CRISIS@991_7303@NAME"
msgstr "Campos Famintos"

msgid "DLC@GIANTKINGS@CRISIS@991_7303@SUB_HEADER"
msgstr "Esta região está amaldiçoada com {GLOBAL.PROPERTIES.TSR_FF_MALDICTION_OF_GLUTTONY.Hyperlink}."

msgid "DLC@GIANTKINGS@CRISIS@991_7797@DESCRIPTION"
msgstr "Ao obter os três Artefatos de Pedra de Fluxo antigos {GLOBAL.MyrridaLoreConcept.Hyperlink}, você despertou a Última Legião, um exército de Soldados de Argila e Armas Animadas que remonta ao tempo em que {GLOBAL.MyrridaLoreConcept.Hyperlink} foi sitiada. Seguindo suas ordens ancestrais, tomando você como um {GLOBAL.GiantKingLoreConcept.Hyperlink}, a Última Legião agora busca atacar qualquer \"invasor\" do reino."

msgid "DLC@GIANTKINGS@CRISIS@991_7797@NAME"
msgstr "A Última Legião"

msgid "DLC@GIANTKINGS@CRISIS@991_7797@SUB_HEADER"
msgstr "A Última Legião está preparando seu ataque ao reino!"

msgid "DLC@GIANTKINGS@CRISIS_EVENT@CC_FINISHER@ASTRAL_RESEARCH_COMPLETED"
msgstr "Conclave Cósmico: Pesquisa Astral Concluída"

msgid "DLC@GIANTKINGS@CRISIS_EVENT@CC_FINISHER@ASTRAL_RESEARCH_REWARD"
msgstr "A pesquisa de {GLOBAL.AstralConcept.Hyperlink} foi concluída neste reino durante o Conclave Cósmico.[br/]Você recebe uma quantidade média de {GLOBAL.ManaConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@CRISIS_EVENT@CC_FINISHER@CHAOS_RESEARCH_COMPLETED"
msgstr "Conclave Cósmico: Pesquisa de Caos Concluída"

msgid "DLC@GIANTKINGS@CRISIS_EVENT@CC_FINISHER@CHAOS_RESEARCH_REWARD"
msgstr "A pesquisa de {GLOBAL.ChaosConcept.Hyperlink} foi concluída neste reino durante o Conclave Cósmico.[br/]Suas cidades ganham uma pequena quantidade de {GLOBAL.UnitProductionConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@CRISIS_EVENT@CC_FINISHER@MATERIUM_RESEARCH_COMPLETED"
msgstr "Conclave Cósmico: Pesquisa de Materium Concluída"

msgid "DLC@GIANTKINGS@CRISIS_EVENT@CC_FINISHER@MATERIUM_RESEARCH_REWARD"
msgstr "A pesquisa de {GLOBAL.MateriumConcept.Hyperlink} foi concluída neste reino durante o Conclave Cósmico.[br/]Você recebe uma quantidade média de {GLOBAL.GoldConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@CRISIS_EVENT@CC_FINISHER@NATURE_RESEARCH_COMPLETED"
msgstr "Conclave Cósmico: Pesquisa de Natureza Concluída"

msgid "DLC@GIANTKINGS@CRISIS_EVENT@CC_FINISHER@NATURE_RESEARCH_REWARD"
msgstr "A pesquisa de {GLOBAL.NatureConcept.Hyperlink} foi concluída neste reino durante o Conclave Cósmico.[br/]Suas cidades ganham uma pequena quantidade de {GLOBAL.FoodConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@CRISIS_EVENT@CC_FINISHER@NON_AFFINITY_RESEARCH_COMPLETED"
msgstr "Conclave Cósmico: Pesquisa Geral Concluída"

msgid "DLC@GIANTKINGS@CRISIS_EVENT@CC_FINISHER@NON_AFFINITY_RESEARCH_REWARD"
msgstr "Pesquisa não vinculada a nenhum {GLOBAL.AffinityConcept.Hyperlink} foi concluída neste reino durante o Conclave Cósmico.[br/]Você recebe uma pequena quantidade de {GLOBAL.ImperiumConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@CRISIS_EVENT@CC_FINISHER@NOTIFICATION_DWELLING_DESTROYED_DESCRIPTION"
msgstr "A Morada de Cristal neste reino foi destruída. O ritual do Conclave Cósmico, portanto, não pode ser concluído."

msgid "DLC@GIANTKINGS@CRISIS_EVENT@CC_FINISHER@NOTIFICATION_DWELLING_DESTROYED_TITLE"
