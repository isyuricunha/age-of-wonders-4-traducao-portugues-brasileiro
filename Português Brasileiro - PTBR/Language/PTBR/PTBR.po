msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@BLOODLIGHT_REFLECTIONS@DESCRIPTION"
msgstr "A cada {GLOBAL.TurnConcept.Hyperlink}, várias áreas de {radius} hexágonos recebem Luz de Sangue por {turn}.[br/][br/]{GLOBAL.PROPERTIES.UNDEAD.Hyperlink} unidades em Luz de Sangue recebem {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} e {GLOBAL.PROPERTIES.REGENERATION.Hyperlink} ao final do turno."

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@BLOODLIGHT_REFLECTIONS@NAME"
