msgstr "Tem certeza de que deseja cancelar? Configurações não salvas serão perdidas."

msgid "INTERFACE@MESSAGE_PANEL@ARE_YOU_SURE_SETTINGS_HEADER"
msgstr "Cancelar Configurações"

