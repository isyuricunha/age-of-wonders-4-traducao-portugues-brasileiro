msgstr "{INT_0}/{INT_1} Noctus, Aliado"

msgid "DLC@EMPIRESANDASHES@STORY_REALM_MISSION_02@REALM_TRAIT_OASIS@DESCRIPTION"
msgstr "Este reino consiste em um Oásis central cercado por desertos.[bulletlist][bullet/]Deserto <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> são [abilityblue]Comum[/abilityblue].[bullet/]Ártico, Altiplanos e Temperado <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> são [abilityblue]Ausentes[/abilityblue].[bullet/]Floresta <<m:{GLOBAL.ProvinceFeatureConcept.Hyperlink}>> e Pântanos <<m:{GLOBAL.ProvinceFeatureConcept.Hyperlink}>> são [abilityblue]Raros[/abilityblue].[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@STORY_REALM_MISSION_02@REALM_TRAIT_OASIS@NAME"
msgstr "Oásis"

msgid "DLC@EMPIRESANDASHES@STORY_REALM_MISSION_02@VICTORY"
msgstr "Revelou o Endailon do Caos!"

msgid "DLC@EMPIRESANDASHES@STORY_REALM_MISSION_02@VICTORY_TEXT"
msgstr "Você revelou o Endailon do Caos e impediu Edward Portsmith de sucumbir à sua natureza violenta. Vitorioso, você e Laryssa conduzem Edward até Magehaven."

msgid "DLC@EMPIRESANDASHES@STRUCTURE_STRATEGIC@SEAL@DESCRIPTION"
msgstr "Concede +{amount1} ponto ao {GLOBAL.SealsVictoryConcept.Hyperlink} a cada turno para o {GLOBAL.EmpireConcept.Hyperlink} que tem unidades posicionadas sobre o Selo."

msgid "DLC@EMPIRESANDASHES@STRUCTURE_STRATEGIC@SEAL@LORE"
msgstr "[lorefontsize][lorefont]Selos foram construídos por ordem dos antigos {GLOBAL.ArchonsLoreConcept.Hyperlink}, para proteger o {GLOBAL.WorldsWithinLoreConcept.Hyperlink} das influências do {GLOBAL.AstralSeaLoreConcept.Hyperlink}... ou vice‑versa. Quem ativar essas estruturas poderosas terá controle total sobre quem entrar ou sair do reino. Por isso, os Selos foram fortemente guardados. Na maioria dos mundos, essas maquinações arcanas agora jazem adormecidas e esquecidas... A menos que um poderoso {GLOBAL.GodirLoreConcept.Hyperlink} descubra como ativá‑las novamente.[/lorefont][/lorefontsize]"

msgid "DLC@EMPIRESANDASHES@STRUCTURE_STRATEGIC@SEAL@NAME"
msgstr "[sealsvictory/] Selo"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@PROVINCE_IMPROVEMENT@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{baseamount} {GLOBAL.KnowledgeConcept.Hyperlink}.[bullet/]+{bonusamount} {GLOBAL.KnowledgeConcept.Hyperlink} por cada {GLOBAL.ProvinceImprovementConcept.Hyperlink} adjacente único.[bullet/]Conta como um {GLOBAL.ResearchPostConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@PROVINCE_IMPROVEMENT@NAME"
msgstr "[researchpost/] Laboratório do Alquimista"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL1@ABILITY_DESCRIPTION"
msgstr "Unidade alvo:[bulletlist][bullet/]Ganha {amount} aleatório <<m:{GLOBAL.PositiveStatusEffectConcept.Hyperlink}>>.[bullet/]Tem um de seus <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>> dissipado.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL1@ABILITY_NAME"
msgstr "Distribuir Tônico"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL1@DESCRIPTION"
msgstr "Concede unidades encantadas:[bulletlist][bullet/]{GLOBAL.PROPERTIES.DISTRIBUTE_TONIC.Hyperlink}, concedendo <<m:{GLOBAL.PositiveStatusEffectConcept.Hyperlink}>> enquanto remove uma negativa.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL1@NAME"
msgstr "Tônico Misterioso"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL1@PROP_DESCRIPTION"
msgstr "Unidade tem:[bulletlist][bullet/]A habilidade {GLOBAL.PROPERTIES.DISTRIBUTE_TONIC.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL2@DESCRIPTION"
msgstr "Crie {GLOBAL.AfflictingMiasmaHazard.Hyperlink} em um raio de {hex}."

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL2@NAME"
msgstr "Dispersar Miasma Afligente"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL3@DESCRIPTION"
msgstr "{GLOBAL.PROPERTIES.RANGED_UNIT.Hyperlink} que pode criar Miasmas para debilitar inimigos."

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL3@NAME"
msgstr "Afligidor^f"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL4@DESCRIPTION"
msgstr "Unidades amigas em um raio de {ANTIMAGIC_TINCTURE_CIRCLE>AREA>Radius} hexágonos:[bulletlist][bullet/]Têm {ANTIMAGIC_TINCTURE_DISPEL>NumThingsToDispel} <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>> dissipado.[bullet/]Ganham {amount} {GLOBAL.PROPERTIES.STATUS_PROTECTION.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL4@NAME"
msgstr "Tintura Antimágica"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL5@DESCRIPTION"
msgstr "No início do combate, unidades que defendem a cidade:[bulletlist][bullet/]Sofrem {amount} {GLOBAL.BlightDamageConcept.Hyperlink}.[bullet/]Sofrem {PoisonAmount} {GLOBAL.PROPERTIES.WEAKENED.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL5@NAME"
msgstr "Fumigação"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL6@DESCRIPTION"
msgstr "[bulletlist][bullet/]{KnowledgeBonus}{GLOBAL.KnowledgeConcept.Hyperlink} renda.[bullet/]{GoldBonus}{GLOBAL.GoldConcept.Hyperlink} renda.[bullet/]{KnowledgePerMaterial}{GLOBAL.KnowledgeConcept.Hyperlink} renda por {GLOBAL.MagicMaterialConcept.Hyperlink} nesta cidade {GLOBAL.DomainConcept.Hyperlink}.[bullet/]{GoldPerMaterial}{GLOBAL.GoldConcept.Hyperlink} renda por {GLOBAL.MagicMaterialConcept.Hyperlink} nesta cidade {GLOBAL.DomainConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@SKILL6@NAME"
msgstr "Refinaria de Material"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@TACTICALOBSTACLES@AFFLICTING_MIASMA@DESCRIPTION"
msgstr "Unidades que passam ou terminam o turno neste hexágono serão afetadas por {GLOBAL.PROPERTIES.WEAKENED.Hyperlink}.[br/]Unidades neste hexágono têm {GLOBAL.PROPERTIES.AFFLICTING_MIASMA_STATUS_EFFECT.Hyperlink}."

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@TACTICALOBSTACLES@AFFLICTING_MIASMA@NAME"
msgstr "Miasma Afligente"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Inflija aos seus inimigos <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>> e mitigue-os em suas próprias unidades. Tinturas e uma poderosa unidade à Distância ajudarão a manipular o rumo da batalha."

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@TOME@LORE_AUTHOR"
msgstr "Fauster, o Meticuloso"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@TOME@LORE_DESCRIPTION"
msgstr "\"A fórmula alquímica perfeita requer uma medida igual de tempo e sorte. Quem mais, senão o alquimista, passa anos em pesquisas meticulosas para compreender a própria essência da natureza... Apenas para encontrar a solução por puro acaso! A alquimia é realmente um risco com a natureza, conferindo o poder de criar ou destruir.\""

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@TOME@NAME"
msgstr "Tomo de Alquimia"

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@UNIT_ABILITY_1@DESCRIPTION"
msgstr "Cause dano à unidade alvo e crie {GLOBAL.AfflictingMiasmaHazard.Hyperlink} em seu hexágono."

msgid "DLC@EMPIRESANDASHES@TOME_ALCHEMY@UNIT_ABILITY_1@NAME"
msgstr "Disparo de Miasma"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@HERO_SKILL1@DESCRIPTION"
msgstr "Enquanto líder do exército, todos os <<m:{GLOBAL.PROPERTIES.CONSTRUCT.Hyperlink}>> têm:[bulletlist][bullet/]+{EXPERIENCED_WARSMITH_DEFENSE>DEF_MOD>Armor} {GLOBAL.DefenseConcept.Hyperlink}[bullet/]Cura +{EXPERIENCED_WARSMITH_REGENERATION>BONUS>Regen} <<m:{GLOBAL.HitPointConcept.Hyperlink}>> por {GLOBAL.WorldMapConcept.Hyperlink} {GLOBAL.TurnConcept.Hyperlink}.[/bulletlist][br/]Inicie o combate com um {GLOBAL.UNITS.IRON_GOLEM_ASSISTANT_UNIT.Hyperlink}, um {GLOBAL.PROPERTIES.FIGHTER.Hyperlink} de Tier I (não funciona em batalhas aquáticas)."

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@HERO_SKILL1@NAME"
msgstr "Ferreiro de Guerra Experiente"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@LINKED_MINDS_DESCRIPTION"
msgstr "Esta unidade ganha {GLOBAL.PROPERTIES.HYPER_AWARE_UNIT_PASSIVE.Hyperlink} quando está adjacente a um {GLOBAL.PROPERTIES.CONSTRUCT.Hyperlink} ou a uma unidade com Mentes Ligadas."

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@PROVINCE_IMPROVEMENT@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{baseamount} {GLOBAL.StructureProductionConcept.Hyperlink}.[bullet/]{amount1} {GLOBAL.FoodConcept.Name} por cada adjacente {GLOBAL.FarmConcept.Hyperlink}. [bullet/]{amount2} {GLOBAL.StructureProductionConcept.Hyperlink} por cada adjacente {GLOBAL.QuarryConcept.Hyperlink} ou {GLOBAL.ForesterConcept.Hyperlink}. [bullet/]{amount4} {GLOBAL.ManaConcept.Hyperlink} por cada adjacente {GLOBAL.ConduitConcept.Hyperlink}. [bullet/]{amount5} {GLOBAL.KnowledgeConcept.Hyperlink} por cada adjacente {GLOBAL.ResearchPostConcept.Hyperlink}. [bullet/]{amount6} {GLOBAL.GoldConcept.Name} por cada adjacente {GLOBAL.MineConcept.Hyperlink}. [bullet/]Conta como um {GLOBAL.QuarryConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@PROVINCE_IMPROVEMENT@TITLE"
msgstr "[quarry/] Nexus de Construto Trabalhador"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@SKILL1@DESCRIPTION"
msgstr "Um {GLOBAL.PROPERTIES.POLEARM_UNIT.Hyperlink} capaz de infligir {GLOBAL.PROPERTIES.WEAKENED.Hyperlink}."

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@SKILL1@NAME"
msgstr "Golem de Bronze"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@SKILL2@DESCRIPTION"
msgstr "Alvo: unidade amiga {GLOBAL.PROPERTIES.CONSTRUCT.Hyperlink} ou {GLOBAL.PROPERTIES.LINKED_MINDS_PROPERTY_GROUP.Hyperlink}: [bulletlist][bullet/]Ganha {GLOBAL.PROPERTIES.DEFENSIVE_MASTERS.Hyperlink} por {CASCADING_COMMAND_DEFEND_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>. [bullet/]Tem {CASCADING_COMMAND_DEFEND_EFFECT_DISPEL>NumThingsToDispel} <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>> dissipado.[bullet/]Esse efeito então se aplica às unidades amigas adjacentes de Construto ou Mentes Ligadas e se repete.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@SKILL2@NAME"
msgstr "Comando em Cascata: Defender"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@SKILL3@DESCRIPTION"
msgstr "Quando adjacente a outra unidade com Defesa Compensada, esta unidade ganha:[bulletlist][bullet/]+{COMPOUNDING_DEFENSE_DEFENSE>DEF_MOD>Armor} {GLOBAL.DefenseConcept.Hyperlink}[bullet/]+{COMPOUNDING_DEFENSE_DEFENSE>DEF_MOD>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@SKILL3@NAME"
msgstr "Defesa Compensada"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@SKILL4@DESCRIPTION"
msgstr "Alvo: unidade amiga {GLOBAL.PROPERTIES.CONSTRUCT.Hyperlink} ou {GLOBAL.PROPERTIES.LINKED_MINDS_PROPERTY_GROUP.Hyperlink} ganha:[bulletlist][bullet/]{GLOBAL.PROPERTIES.HASTENED.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}[bullet/]Esse efeito então se propaga para unidades amigas adjacentes de Construto ou Mentes Ligadas e se repete.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@SKILL4@NAME"
msgstr "Comando em Cascata: Reposicionar"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@SKILL5@DESCRIPTION"
msgstr "Alvo: cidade amiga ganha +{amount} {GLOBAL.FoodConcept.Hyperlink}. [br/]Esta magia custa Essência Vinculadora."

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@SKILL5@NAME"
msgstr "População de Construto"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@SKILL6@DESCRIPTION"
msgstr "Unidades desta raça ganham a habilidade de compartilhar sentidos, concedendo-lhes:[bulletlist][bullet/]{GLOBAL.PROPERTIES.HYPER_AWARE_UNIT_PASSIVE.Hyperlink} ao ficar ao lado de um {GLOBAL.PROPERTIES.CONSTRUCT.Hyperlink} ou outra unidade com Mentes Ligadas.[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@SKILL6@NAME"
msgstr "Mentes Ligadas"

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Comande legiões de construtos, lutando em formações assustadoramente sincronizadas, controlando-os com perfeição e esmagando seus inimigos sob a marcha de suas botas."

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@TOME@LORE_DESCRIPTION"
msgstr "\"Os construtos são 'vivos'? Para isso tenho apenas uma resposta: importa? Os construtos são máquinas de guerra obedientes criadas para um único propósito: esmagar tudo em seu caminho. Na minha opinião, a verdadeira pergunta que todos deveriam fazer é: 'Como escapar da marcha mortal deles?'\""

msgid "DLC@EMPIRESANDASHES@TOME_CONSTRUCT@TOME@NAME"
msgstr "Tomo do Construto"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@ABILITY1@DESCRIPTION"
msgstr "Dispare contra o alvo com o canhão principal e empurre-o para trás."

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@ABILITY1@NAME"
msgstr "Fogo Direto"

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@ABILITY2@DESCRIPTION"
msgstr "Causa dano em um raio de {BARRAGE_CIRCLE_TARGETER>AREA>Radius} hexágonos."

msgid "DLC@EMPIRESANDASHES@TOME_DREADNAUGHT@ABILITY2@FLAG@DESCRIPTION"
msgstr "Este hexágono será atingido por {amount} {GLOBAL.PhysicalDamageConcept.Hyperlink} no início do [turn/] [hyperlink,GLOBAL.TurnConcept]Próximo Turno[/hyperlink]"

