msgid "TOME_CYCLES@ABILITY_3@DESCRIPTION_CHAMPION"
msgstr "Reiniciar o Ciclo: [bulletlist][bullet/]Cura um adicional {healAmount}<<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Ressuscita unidades com um adicional {resurrectPercentage}% o de seu total <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[/bulletlist]"

msgid "TOME_CYCLES@ABILITY_3@ERROR_MESSAGE"
msgstr "Requer {GLOBAL.PROPERTIES.LIFE_FROM_DEATH_ABILITY_MODIFIER.Hyperlink} para ser usado."

msgid "TOME_CYCLES@ABILITY_3@NAME"
msgstr "Reiniciar o Ciclo"

msgid "TOME_CYCLES@ABILITY_3@NAME_CHAMPION"
msgstr "Reiniciar o Ciclo do Campeão"

msgid "TOME_CYCLES@ABILITY_4@DESCRIPTION"
msgstr "Unidade amiga não‑herói alvo é morta, inimigos adjacentes sofrem {SACRIFICIAL_BLIGHT_DAMAGE>DAMAGE>Blight} {GLOBAL.BlightDamageConcept.Hyperlink} por nível da unidade sacrificada.[br/][br/]Esta habilidade sempre dispara {GLOBAL.PROPERTIES.LIFE_FROM_DEATH_ABILITY_MODIFIER.Hyperlink},"

msgid "TOME_CYCLES@ABILITY_4@NAME"
msgstr "Calamidade Sacrificial"

msgid "TOME_CYCLES@HERO_SKILL@DESCRIPTION"
msgstr "Os ataques base ganham uma chance base {DECAYING_RESISTANCE>ResolvedStrength}% c de infligir {GLOBAL.PROPERTIES.DECAYING.Hyperlink}.[br/][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CYCLES@HERO_SKILL@NAME"
msgstr "Decadência Murcha"

msgid "TOME_CYCLES@PASSIVE@DESCRIPTION"
msgstr "As quedas de moral que surgem com a morte de unidades amigas são reduzidas à metade."

msgid "TOME_CYCLES@PASSIVE@NAME"
msgstr "Ciclo da Vida"

msgid "TOME_CYCLES@SKILL1@DESCRIPTION"
msgstr "Faz com que os ataques de unidades encantadas:[bulletlist][bullet/]Inflijam {GLOBAL.PROPERTIES.DECAYING.Hyperlink}, um efeito de dano ao longo do tempo que diminui a cura recebida.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CYCLES@SKILL1@NAME"
