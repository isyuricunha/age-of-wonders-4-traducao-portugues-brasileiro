msgstr "Os Governantes formam um pacto de compartilhamento mútuo de inteligência."

msgid "DIPLOMATICSTATES_DEFINITIONS@SHAREINTELLIGENCE@NAME"
msgstr "Pacto de Pesquisa"

msgid "DIPLOMATICSTATES_DEFINITIONS@SHAREINTELLIGENCEFORTURNS@DESCRIPTION"
msgstr "Os Governantes formam um pacto de compartilhamento mútuo de inteligência por um período determinado."

msgid "DIPLOMATICSTATES_DEFINITIONS@SHAREINTELLIGENCEFORTURNS@NAME"
