msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@STUNNING_SOUNDS@DESCRIPTION"
msgstr "A cada {turns}, um(a) {GLOBAL.UNITS.SHRIEKING_BAT.Hyperlink} tem uma {chance} de sofrer {GLOBAL.PROPERTIES.STUNNED.Hyperlink} por {turns2}. Se falhar, sofre {GLOBAL.PROPERTIES.DISTRACTED.Hyperlink} por {turns2} ao invés."

msgid "DLC@THRONESOFBLOOD@COMBATPROPERTIES_TACTICAL@STUNNING_SOUNDS@NAME"
