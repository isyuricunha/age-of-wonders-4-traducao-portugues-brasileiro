msgid "TOME_CREATOR@PASSIVE@NAME"
msgstr "Forjas Lendárias"

msgid "TOME_CREATOR@SKILL1@SPELL2@DESCRIPTION"
msgstr "A província de Montanha alvo torna‑se uma província Rochosa."

msgid "TOME_CREATOR@SKILL1@SPELL2@NAME"
msgstr "Montanhas Baixas"

msgid "TOME_CREATOR@SKILL2@DESCRIPTION"
msgstr "[bulletlist][bullet/]Invoca um {GLOBAL.UNITS.EARTH_TITAN_UNIT.Hyperlink} no hexágono desocupado alvo.[bullet/]Todos os inimigos adjacentes perdem seu {GLOBAL.DefenseModeConcept.Hyperlink} e {GLOBAL.RetaliationConcept.Hyperlink}.[/bulletlist][br/][br/]{LOC.TACTICAL@ABILITY@NEVER_IN_WATER}"

msgid "TOME_CREATOR@SKILL2@NAME"
msgstr "Invocar o Titã da Terra"

msgid "TOME_CREATOR@SKILL3@DESCRIPTION"
msgstr "[bulletlist][bullet/]Todos os inimigos sofrem {TECTONIC_SHATTER_UNIT_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Todos os inimigos têm uma base {STUNNED_RESISTANCE>ResolvedStrength}% cança de se tornar {GLOBAL.PROPERTIES.STUNNED.Hyperlink}.[bullet/]Todos os obstáculos no mapa têm {obstacles} de chance de serem destruídos.[/bulletlist]"

msgid "TOME_CREATOR@SKILL3@NAME"
msgstr "Rachadura Tectônica"

msgid "TOME_CREATOR@SKILL4@DESCRIPTION"
msgstr "Concede unidades encantadas:[bulletlist][bullet/]{GLOBAL.PROPERTIES.NATURAL_REGENERATION_GROUP.Hyperlink}[bullet/]+{SHAPERS_TOUCH_STAT_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]+{SHAPERS_TOUCH_DEFENSE>REDUCTION>Shock} {GLOBAL.LightningResistanceConcept.Hyperlink}[/bulletlist]"

msgid "TOME_CREATOR@SKILL4@NAME"
msgstr "Toque do Modelador"

msgid "TOME_CREATOR@SKILL4@PROP_DESCRIPTION"
msgstr "Unidade tem:[bulletlist][bullet/]{GLOBAL.PROPERTIES.NATURAL_REGENERATION_GROUP.Hyperlink}[bullet/]+{SHAPERS_TOUCH_STAT_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]+{SHAPERS_TOUCH_DEFENSE>REDUCTION>Shock} {GLOBAL.LightningResistanceConcept.Hyperlink}[/bulletlist]"

msgid "TOME_CREATOR@SKILL5@NAME"
msgstr "Era do Materium"

msgid "TOME_CREATOR@SKILL6@DESCRIPTION"
msgstr "[bulletlist][bullet/]No início da batalha, todos os obstáculos de Muro são danificados.[bullet/]No início da batalha, ganhe {amount} unidades {GLOBAL.UNITS.EARTHSHATTER_ENGINE_UNIT.Hyperlink} do lado do atacante até o fim da batalha.[bullet/]<<m:{GLOBAL.UNITS.EARTHSHATTER_ENGINE_UNIT.Hyperlink}>> são {GLOBAL.PROPERTIES.SIEGECRAFT_UNIT.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> com alcance curto, ataques de área que podem destruir obstáculos e derrubar unidades inimigas de {GLOBAL.DefenseModeConcept.Hyperlink}.[bullet/]Só um tipo de unidade de Cerco pode ser levado para {GLOBAL.CombatConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CREATOR@SKILL6@NAME"
msgstr "Criar Máquinas de Ruptura Terrestre"

msgid "TOME_CREATOR@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Molde o mundo, invoque titãs adormecidos e torne‑se o mestre da terra."

msgid "TOME_CREATOR@TOME@LORE_AUTHOR"
msgstr "Mãe Mab, Deusa dos Goblins"

msgid "TOME_CREATOR@TOME@LORE_DESCRIPTION"
msgstr "\"Aqueles que dominam o Materium estão acima do mundo, devastando e derrubando terras à vontade, e controlando as forças primordiais da criação. Os próprios titãs caminharão ao seu lado, enquanto as próprias essências de elemento e mineral se curvarão. Você é o Criador, um modelador de mundos.\""

msgid "TOME_CREATOR@TOME@NAME"
msgstr "Tomo do Criador"

msgid "TOME_CREATOR@UNIT1@ABILITY1@DESCRIPTION"
msgstr "Alvo todos os inimigos dentro de {SEISMIC_SLAM_UNIT_TARGETER_CIRCLE>AREA>Radius} hexágonos."

msgid "TOME_CREATOR@UNIT1@ABILITY1@NAME"
msgstr "Golpe Sísmico"

msgid "TOME_CREATOR@UNIT1@DESCRIPTION"
msgstr "Obedecendo apenas ao comando dos mestres absolutos da terra, o Titã da Terra é uma força imbatível e a personificação da fúria da terra."

msgid "TOME_CREATOR@UNIT1@NAME"
msgstr "Titã da Terra^n"

msgid "TOME_CREATOR@UNIT2@ABILITY1@DESCRIPTION"
msgstr "Unidades inimigas em um raio de {EARTH_TREMOR_UNIT_TARGETER_CIRCLE>AREA>Radius} hexágonos:[bulletlist][bullet/]Sofrem dano[bullet/]Perdem seu {GLOBAL.DefenseModeConcept.Hyperlink}[bullet/]Perdem {GLOBAL.RetaliationConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CREATOR@UNIT2@ABILITY1@NAME"
msgstr "Tremor Terrestre"

msgid "TOME_CREATOR@UNIT2@DESCRIPTION"
msgstr "Máquina de cerco lenta porém poderosa, capaz de destruir trechos inteiros de muros em instantes."

msgid "TOME_CREATOR@UNIT2@NAME"
msgstr "Máquina de Ruptura Terrestre^n"

msgid "TOME_CRICIBLE@SKILL2@DEFENSE_DESCRIPTION"
msgstr "Adiciona obstáculos Baluartes do Cadinho em {GLOBAL.CombatConcept.Hyperlink} durante um {GLOBAL.SiegeConcept.Hyperlink}.[br/][br/]Obstáculos Baluarte do Cadinho concedem ataques {GLOBAL.RangedConcept.Hyperlink} e {GLOBAL.MagicConcept.Hyperlink}:[bulletlist][bullet/]Causa {damage} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Define os hexágonos afetados {GLOBAL.OnFireConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CRUCIBLE@HERO_SKILL@DESCRIPTION"
msgstr "[bulletlist][bullet/]Ataques base causam {METEOR_ARROWS_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} ao alvo e inimigos adjacentes.[bullet/]Todos os ataques ganham {GLOBAL.PROPERTIES.DEMOLISHER.Hyperlink}.[br/][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}[/bulletlist]"

msgid "TOME_CRUCIBLE@HERO_SKILL@MOD_DESCRIPTION"
msgstr "+{METEOR_ARROWS_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} ao alvo e inimigos adjacentes."

msgid "TOME_CRUCIBLE@HERO_SKILL@NAME"
msgstr "Impactos de Meteoro"

msgid "TOME_CRUCIBLE@PASSIVE@DESCRIPTION"
msgstr "[bulletlist][bullet/]Minas concedem {amount} renda {GLOBAL.ManaConcept}.[bullet/]Minas agora podem ser construídas em <<m:{GLOBAL.ProvinceConcept}>> com recurso de Lava ou Abismo.[/bulletlist]"

msgid "TOME_CRUCIBLE@PASSIVE@NAME"
msgstr "Mineração de Piro‑sifão"

msgid "TOME_CRUCIBLE@SKILL1@DESCRIPTION"
msgstr "Alvo {GLOBAL.ProvinceConcept.Hyperlink}:[bulletlist][bullet/]Se contiver um inimigo {GLOBAL.ProvinceImprovementConcept.Hyperlink}, ele será [hyperlink,GLOBAL.PillagingConcept]Saqueado[/hyperlink].[bulletlist][bullet/]Você não receberá suas recompensas nem perderá {GLOBAL.AlignmentConcept.Hyperlink}.[/bulletlist][bullet/]Inimigo <<m:{GLOBAL.UnitConcept.Hyperlink}>> na província sustenta {damage} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]A província ganha {GLOBAL.AshlandsConcept.Hyperlink}.[bullet/]A província perde {GLOBAL.RiverConcept.Hyperlink}, {GLOBAL.FertilePlainsConcept.Hyperlink}, {GLOBAL.SwampConcept.Hyperlink}, {GLOBAL.SnowConcept.Hyperlink}, {GLOBAL.FrozenWasteConcept.Hyperlink}, {GLOBAL.SandConcept.Hyperlink}, {GLOBAL.CavernFloorConcept.Hyperlink}, e {GLOBAL.GloomTerrainConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CRUCIBLE@SKILL1@NAME"
msgstr "Erupção Piroclástica"

msgid "TOME_CRUCIBLE@SKILL2@DEFENSE_DESCRIPTION"
msgstr "Adiciona obstáculos de Crucible Battlements em {GLOBAL.CombatConcept.Hyperlink} durante um {GLOBAL.SiegeConcept.Hyperlink}.[br/][br/]Obstáculos de Crucible Battlement concedem ataques {GLOBAL.RangedConcept.Hyperlink} e {GLOBAL.MagicConcept.Hyperlink}:[bulletlist][bullet/]Causa {damage} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Define os hexágonos afetados {GLOBAL.OnFireConcept.Hyperlink}.[bullet/]Ignora {GLOBAL.ObscuredConcept.Hyperlink} nos alvos.[bullet/]{rangebonus} {GLOBAL.RangeConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CRUCIBLE@SKILL2@DESCRIPTION"
msgstr "{GLOBAL.CityBattlementStructureConcept.Hyperlink}[br/][bulletlist][bullet/]Baluartes concedem {GLOBAL.RangedConcept.Hyperlink} e {GLOBAL.MagicConcept.Hyperlink} ataques:[bulletlist][bullet/]Causa {damage}.[bullet/]Define os hexágonos afetados {GLOBAL.OnFireConcept.Hyperlink}.[bullet/]Ignora {GLOBAL.ObscuredConcept.Hyperlink} nos alvos.[bullet/]{rangebonus} {GLOBAL.RangeConcept.Hyperlink}[/bulletlist][bullet/]A Cidade ignora penalidades negativas de {GLOBAL.CityStabilityConcept.Hyperlink} ao anexar províncias com {GLOBAL.ChasmConcept.Hyperlink} ou {GLOBAL.LavaConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CRUCIBLE@SKILL2@MARKER@DESCRIPTION"
msgstr "Ataques base {GLOBAL.RangedConcept.Hyperlink} e {GLOBAL.MagicConcept.Hyperlink}:[bulletlist][bullet/]Causa {damage} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Define o terreno {GLOBAL.OnFireConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CRUCIBLE@SKILL2@MARKER@NAME"
msgstr "Runas Imolantes"

msgid "TOME_CRUCIBLE@SKILL2@MODIFIER_DESCRIPTION"
msgstr "Esta unidade foi construída em uma Cidade com a estrutura Crisol Fortificado, fazendo com que os ataques desta unidade causem {damage}."

