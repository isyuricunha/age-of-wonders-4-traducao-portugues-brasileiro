msgid "TOME_CRYOMANCY@SKILL_3@DESCRIPTION"
msgstr "Faz com que os ataques de unidades encantadas causem:[bulletlist][bullet/]+{FROST_BLADES_EXTRA_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]+{FROST_BLADES_DAMAGE_MULTIPLIER>ResolvedMultiplier}% d dano contra unidades {GLOBAL.PROPERTIES.FROZEN.Hyperlink} ou {GLOBAL.PROPERTIES.SLOWED.Hyperlink}.[/bulletlist] [br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CRYOMANCY@SKILL_3@NAME"
msgstr "Lâminas de Gelo"

