msgid "DLC@WAYSOFWAR@OATHSWORN@UNIT_MECHANIC03@BUFF_NAME_PARAGON"
msgstr "Fúria do Guerreiro (Exemplar)"

msgid "DLC@WAYSOFWAR@OATHSWORN@UNIT_MECHANIC03@DESCRIPTION"
msgstr "No início do turno da unidade, se as unidades amigas não superarem em número as unidades inimigas, a unidade recebe {GLOBAL.PROPERTIES.WARRIOR_FURY_NEUTRAL.Hyperlink} até o final do combate.[br/][br/]{GLOBAL.PROPERTIES.WARRIOR_FURY_NEUTRAL.Hyperlink} aumenta o dano dos ataques, com base no {GLOBAL.DevotionConcept.Hyperlink} da cultura: [bulletlist][bullet/][devotion3/] Exemplar: +{paragonamount} {GLOBAL.FireDamageConcept.Hyperlink}[bullet/][devotion2/] Devoto: +{devoteeamount} {GLOBAL.FireDamageConcept.Hyperlink}[bullet/][devotion1/] Adepto: +{adherentamount} {GLOBAL.FireDamageConcept.Hyperlink}[bullet/][devotion0/] Neutro: +{neutralamount} {GLOBAL.FireDamageConcept.Hyperlink}[bullet/][devotion-1/] Quebrador de Juramento: Fúria do Guerreiro está desativada, ataques causam -{OathbreakerDamage}% d dano.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

