msgstr "Puxão de Sangue"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@BLOOD_EXARCH@ABILITY05@DESCRIPTION"
msgstr "Ao final do turno, inimigos adjacentes têm uma chance base {OPPRESSING_AURA_RESISTANCE>ResolvedStrength}% c de sofrer:[bulletlist][bullet/]{GLOBAL.PROPERTIES.MISFORTUNE.Hyperlink} por {MISFORTUNE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]{OPPRESSING_AURA_MORALE_CHANGE>Morale Change Absolute} {GLOBAL.UnitMoraleConcept.Hyperlink} de perda.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@BLOOD_EXARCH@ABILITY05@NAME"
msgstr "Aura Opressora"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@BLOOD_EXARCH@NAME"
msgstr "Exarca de Sangue^n"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@SKILL1@DESCRIPTION"
msgstr "Convoque um(a) {GLOBAL.UNITS.BLOOD_EXARCH.Hyperlink} {GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink} com poderosas habilidades de suporte e ofensivas que devastam unidades de baixo nível."

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@SKILL1@NAME"
msgstr "Convoque o Exarca de Sangue"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@SKILL2@AUTOSPELL"
msgstr "No início do turno do conjurador:[bulletlist][bullet/]Até {TEARS_OF_THE_CRIMSON_SOVEREIGN_ENEMY_TARGETER>NumTargets} unidades inimigas:[bulletlist][bullet/]Sustentar {TEARS_OF_THE_CRIMSON_SOVEREIGN_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Tenha uma base {BLOOD_PARASITE_RESISTANCE>ResolvedStrength}% cchance de ganhar {GLOBAL.PROPERTIES.BLOOD_PARASITE.Hyperlink} por {BLOOD_PARASITE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][bullet/]Até {TEARS_OF_THE_CRIMSON_SOVEREIGN_FRIENDLY_TARGETER>NumTargets} unidades amigas:[bulletlist][bullet/]Cure por {TEARS_OF_THE_CRIMSON_SOVEREIGN_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Ganhe {GLOBAL.PROPERTIES.FORTUNE.Hyperlink} por {FORTUNE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@SKILL2@DESCRIPTION"
msgstr "Ao ser conjurado e pelos próximos {TEARS_OF_THE_CRIMSON_SOVEREIGN_UNIT_AUTO_SPELL>TimeToLive} <<m:{GLOBAL.TurnConcept}>>:[bulletlist][bullet/]Até {TEARS_OF_THE_CRIMSON_SOVEREIGN_ENEMY_TARGETER>NumTargets} unidades inimigas:[bulletlist][bullet/]Sustentar {TEARS_OF_THE_CRIMSON_SOVEREIGN_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Tem uma base {BLOOD_PARASITE_RESISTANCE>ResolvedStrength}% cchance de ganhar {GLOBAL.PROPERTIES.BLOOD_PARASITE.Hyperlink} por {BLOOD_PARASITE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][bullet/]Até {TEARS_OF_THE_CRIMSON_SOVEREIGN_FRIENDLY_TARGETER>NumTargets} unidades amigas:[bulletlist][bullet/]Cura por {TEARS_OF_THE_CRIMSON_SOVEREIGN_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Ganha {GLOBAL.PROPERTIES.FORTUNE.Hyperlink} por {FORTUNE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@SKILL2@NAME"
msgstr "Lágrimas do Soberano Carmesim"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@SKILL3@BUFF_DESCRIPTION"
msgstr "Unidade:[bulletlist][bullet/]Tem +{MANTLE_OF_THE_BLOOD_NOBLE_HP_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>.[bullet/]Recebe +{MANTLE_OF_THE_BLOOD_NOBLE_HEAL_MODIFIER>ResolvedHealing Multipli}% healing em combate.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@SKILL3@DESCRIPTION"
msgstr "Concede unidades encantadas:[bulletlist][bullet/]{GLOBAL.PROPERTIES.COAGULATE.Hyperlink}[bullet/]No início do combate, para cada unidade aliada não invocada de Nível I e Nível II:[bulletlist][bullet/]+{amount1} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]+{amount2}% healing recebido em combate.[/bulletlist][/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@SKILL3@NAME"
msgstr "Manto do Nobre de Sangue"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@SKILL3@PROP_DESCRIPTION"
msgstr "Unidade:[bulletlist][bullet/]Tem {GLOBAL.PROPERTIES.COAGULATE.Hyperlink}[bullet/]No início do combate, para cada unidade aliada não invocada de Nível I e Nível II, ganha:[bulletlist][bullet/]+{amount1} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]+{amount2}% healing recebido em combate.[/bulletlist][/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@SKILL4@DESCRIPTION"
msgstr "[bulletlist][bullet/]Unidades de Nível III, IV e V que você possui ganham:[bulletlist][bullet/]+{amount1} {GLOBAL.HitPointConcept.Hyperlink} regeneração no mapa mundial.[bullet/]Ganhe {amount2} {GLOBAL.ExperienceConcept.Hyperlink} por turno no mapa mundial.[/bulletlist][bullet/]Ganhe {GLOBAL.CrimsonCourtMagistrateConcept.Hyperlink}, permitindo que você obtenha mana de Vassalo e ao Migrar, Arrasar ou Saquear.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@SKILL4@NAME"
msgstr "Corte Carmesim"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@SKILL4@PROP_DESCRIPTION"
msgstr "Esta unidade:[bulletlist][bullet/]Tem +{CRIMSON_COURT_REGEN_PER_TURN>BONUS>Regen} {GLOBAL.HitPointConcept.Hyperlink} regeneração no mapa mundial.[bullet/]Ganha {CRIMSON_COURT_XP_PER_TURN>XP} {GLOBAL.ExperienceConcept.Hyperlink} por turno no mapa mundial.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@SKILL5@DESCRIPTION"
msgstr "Transforme suas unidades enquanto elas absorvem ritualisticamente sangue de um Exarca, concedendo-lhes:[bulletlist][bullet/]O tipo de unidade {GLOBAL.PROPERTIES.UNDEAD.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.LIFEDRINKER.Hyperlink}.[bullet/]Ataques base têm uma chance base de {BLOOD_PARASITE_RESISTANCE>ResolvedStrength}% c infligir {GLOBAL.PROPERTIES.BLOOD_PARASITE.Hyperlink} por {BLOOD_PARASITE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>. Este efeito é aumentado para ataques de disparo único.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@SKILL5@NAME"
msgstr "Dom do Sangue Antigo"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@SKILL5@PROP_DESCRIPTION"
msgstr "Unidade tem:[bulletlist][bullet/]O tipo de unidade {GLOBAL.PROPERTIES.UNDEAD.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.LIFEDRINKER.Hyperlink}.[bullet/]Ataques base têm uma chance base de {BLOOD_PARASITE_RESISTANCE>ResolvedStrength}% c infligir {GLOBAL.PROPERTIES.BLOOD_PARASITE.Hyperlink} por {BLOOD_PARASITE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>. Este efeito é aumentado para ataques de disparo único.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Abrace uma magia esquecida e corrupta que fortalece suas unidades de alto nível e faz sua facção adotar uma forma ancestral de não‑morte, ganhando o poder de espalhar <<m:{GLOBAL.PROPERTIES.BLOOD_PARASITE.Hyperlink}>> sobre seus inimigos."

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@TOME@LORE_DESCRIPTION"
msgstr "\"O sangue carrega um poder maior do que os mortais podem imaginar. O sangue dos Arcontes não carrega sua essência? Não usamos o sangue como pagamento por nossa magia? O sangue é onde a alma reside! E assim, bebemos, para preencher o vazio interior. Pois o Dom do Sangue Antigo exige almas para sacrifício... E nós já gastamos as nossas há muito tempo.\""

msgid "DLC@THRONESOFBLOOD@TOME_CRIMSON_REIGN@TOME@NAME"
msgstr "Tomo do Reinado Carmesim"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@ABILITY01@DESCRIPTION"
msgstr "Ataca a unidade alvo e ganha <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>> igual a {DRAINING_STRIKE_LIFE_STEAL>ResolvedHealProportion}% do dano causado."

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@ABILITY01@NAME"
msgstr "Golpe Drenante"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@ABILITY02@NAME"
msgstr "Chicote de Tormento"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@ABILITY03@DESCRIPTION"
msgstr "Teleporte para o hexágono alvo."

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@ABILITY03@NAME"
msgstr "Passo das Sombras"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@GAMEPLAY_DESCRIPTION"
msgstr "Atormente seus inimigos virando suas próprias ações contra eles e faça suas unidades serem fortalecidas pela dor."

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@LORE_DESCRIPTION"
msgstr "\"Faça seus corpos tremerem de tormento. A cada centímetro que se movem, pagarão com gemidos de agonia. Deixe o sofrimento escorrer como mel sobre sua pele pulsante. Faça-os curvar-se, implorar, suplicar ao seu portador de dor... E guarde um pouco de tormento para si mesmo, pois o sofrimento é melhor infligido quando desfrutado em primeira mão.\""

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@NAME"
msgstr "Tomo do Tormento"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@PAIN_BRINGER@NAME"
msgstr "Portador de Dor^f"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SKILL1@DESCRIPTION"
msgstr "A raça-alvo abraça a dor e, ao ser atingida por um ataque, ganha:[bulletlist][bullet/]{PAINBOUND_MORALE>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}.[bullet/]Um efeito de status positivo aleatório.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SKILL1@NAME"
msgstr "Atado à Dor"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SKILL1@PROP_DESCRIPTION"
msgstr "Quando esta unidade é atingida por um ataque, ela ganha:[bulletlist][bullet/]{PAINBOUND_MORALE>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}.[bullet/]Um efeito de status positivo aleatório.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SKILL2@DESCRIPTION"
msgstr "{GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink} que atormenta seus inimigos e pode facilmente flanqueá‑los e drenar sua vitalidade."

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SKILL2@NAME"
msgstr "Portador de Dor"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SKILL3@DESCRIPTION"
msgstr "Ataques de unidades encantadas:[bulletlist][bullet/]Têm uma chance base de {TORMENTED_RESISTANCE>ResolvedStrength}% c infligir {GLOBAL.PROPERTIES.TORMENT.Hyperlink} até o fim do combate.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SKILL3@NAME"
msgstr "Imbuimento de Tormento"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SKILL3@PROP_DESCRIPTION"
msgstr "Ataques da unidade:[bulletlist][bullet/]Têm uma chance base de {TORMENTED_RESISTANCE>ResolvedStrength}% c infligir {GLOBAL.PROPERTIES.TORMENT.Hyperlink} até o fim do combate.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SKILL4@DESCRIPTION"
msgstr "Unidades inimigas em um raio de {AGONIZE_UNIT_TARGETER_CIRCLE>AREA>Radius} hexágonos:[bulletlist][bullet/]Sustentam {AGONIZE_UNIT_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}[bullet/]Têm uma chance base de {AGONIZE_RESISTANCE_CHECK>ResolvedStrength}% c ganhar {TORMENT_REPEATER>Count} pilhas de {GLOBAL.PROPERTIES.TORMENT.Hyperlink} até o fim do combate. Em caso de falha, inflige {amount} pilha de {GLOBAL.PROPERTIES.TORMENT.Hyperlink} em vez disso.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SKILL4@NAME"
msgstr "Agonizar"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SKILL5@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{amount} {GLOBAL.ManaConcept.Hyperlink}.[bullet/]+{amount2} <<m:{GLOBAL.CombatCastingPointConcept.Hyperlink}>>.[bullet/]<<m:{GLOBAL.DamageSpellConcept.Hyperlink}>> e <<m:{GLOBAL.DebuffSpellConcept.Hyperlink}>> aplicam uma perda extra de {amount3} {GLOBAL.UnitMoraleConcept.Hyperlink}.[/bulletlist][br/][br/]Só pode ser construído no {GLOBAL.ThroneCityConcept.Hyperlink}."

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SKILL5@MOD_DESCRIPTION"
msgstr "Alvos perdem {amount} {GLOBAL.UnitMoraleConcept.Hyperlink}"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SKILL5@NAME"
msgstr "Lente da Angústia"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SPI@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{amount} {GLOBAL.ManaConcept.Hyperlink} renda.[bullet/]+{amount2} {GLOBAL.KnowledgeConcept.Hyperlink} renda.[bullet/]+{amount3} {GLOBAL.CityStabilityConcept.Hyperlink}[bullet/]+{amount4} {GLOBAL.ManaConcept.Hyperlink} por adjacente {GLOBAL.FarmConcept.Hyperlink}.[bullet/]+{amount5} {GLOBAL.KnowledgeConcept.Hyperlink} por adjacente {GLOBAL.ForesterConcept.Hyperlink}.[bullet/]Conta como um {GLOBAL.ConduitConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TOME_TORMENT@SPI@NAME"
msgstr "[conduit/] Basílica da Lamentação"

msgid "DLC@THRONESOFBLOOD@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@VAMPIRE_LORD@DESCRIPTION"
msgstr "{LOC.DLC@THRONESOFBLOOD@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@VAMPIRE_LORD@DESCRIPTION_SHORT}[br/][bulletlist][bullet/]Uma {GLOBAL.PROPERTIES.UNDEAD.Hyperlink} unidade com uma [hyperlink,GLOBAL.PROPERTIES.SUNLIGHT_WEAKNESS]avversão à luz[/hyperlink].[bullet/]Tem acesso a {GLOBAL.STRUCTURE_UPGRADES.LORD_CASTLE_FOUNDATION.Hyperlink} que substitui o {GLOBAL.STRUCTURE_UPGRADES.WIZARD_TOWER_FOUNDATION.Hyperlink} e concede o uso de <<m:{GLOBAL.ThrallConcept.Hyperlink}>> para lançar poderosos rituais <<m:{GLOBAL.SpellConcept.Hyperlink}>>.[bullet/]Drena {amountXP}% o do combate {GLOBAL.ExperienceConcept.Hyperlink} obtido pelos heróis Turned Vampire.[bullet/]A facção é imune às penalidades do Sunless terrain em {GLOBAL.CityStabilityConcept.Hyperlink} e {GLOBAL.UnitMoraleConcept.Hyperlink}.[bullet/]Elder Vampires são <<m:{GLOBAL.PROPERTIES.HEROTRAIT_GOVERNANCE_VAMPIRE_GOVERNOR.Hyperlink}>>.[bullet/]Elder Vampires têm um {amount3} {GLOBAL.GoldConcept.Hyperlink} {GLOBAL.UnitUpkeepConcept.Hyperlink}[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@VAMPIRE_LORD@DESCRIPTION_SHORT"
msgstr "[helpcolor]Um vampiro imortal que drena a vida dos inimigos sob o manto da noite.[/helpcolor]"

msgid "DLC@THRONESOFBLOOD@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@VAMPIRE_LORD@HYPERLINK"
msgstr "[hyperlink,GLOBAL.VampireLordConcept]Vampiro Ancião[/hyperlink]"

msgid "DLC@THRONESOFBLOOD@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@VAMPIRE_LORD_HYBRID@DESCRIPTION"
msgstr "{LOC.DLC@THRONESOFBLOOD@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@VAMPIRE_LORD_HYBRID@DESCRIPTION_SHORT}[br/][bulletlist][bullet/]Pode ser de qualquer forma.[/bulletlist][br/]"

msgid "DLC@THRONESOFBLOOD@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@VAMPIRE_LORD_HYBRID@DESCRIPTION_SHORT"
msgstr "[helpcolor]Um vampiro descendente de uma das muitas raças que habitam o Mar Astral.[/helpcolor]"

msgid "DLC@THRONESOFBLOOD@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@VAMPIRE_LORD_PUREBLOOD@DESCRIPTION"
msgstr "{LOC.DLC@THRONESOFBLOOD@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@VAMPIRE_LORD_PUREBLOOD@DESCRIPTION_SHORT}[br/][bulletlist][bullet/]Possui opções de aparência únicas.[/bulletlist][br/]"

msgid "DLC@THRONESOFBLOOD@TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@VAMPIRE_LORD_PUREBLOOD@DESCRIPTION_SHORT"
msgstr "[helpcolor]Um vampiro descendente dos Arquivampiros de Drevanya.[/helpcolor]"

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_ECHOES_01@AFFINITY_CHOICE_MATERIUM@FAILURE"
msgstr "Suas tentativas de transmutação não têm efeito."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_ECHOES_01@AFFINITY_CHOICE_MATERIUM@HEADER"
msgstr "Negue os ecos que ricocheteiam nas paredes da caverna:"

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_ECHOES_01@AFFINITY_CHOICE_MATERIUM@SUCCESS"
msgstr "A determinação do seu exército cresce contra o <<m:EventUnit>>."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_MAGGOTS_01@AFFINITY_CHOICE_NATURE@FAILURE"
msgstr "A Natureza não pode superar a manipulação do <<m:EventUnit>>."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_MAGGOTS_01@AFFINITY_CHOICE_NATURE@HEADER"
msgstr "Negue qualquer influência que o <<m:EnemyUnit>> tenha sobre o <<m:EventUnit>>:"

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_MAGGOTS_01@AFFINITY_CHOICE_NATURE@SUCCESS"
msgstr "Os recém-eclodidos <<m:EventUnit>> atacam seus hospedeiros dispostos primeiro."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_MAGGOTS_01@AFFINITY_CHOICE_SHADOW@FAILURE"
msgstr "A sede de sangue do <<m:EventUnit>> transcende sua carne de gosto repugnante."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_MAGGOTS_01@AFFINITY_CHOICE_SHADOW@HEADER"
msgstr "Encante seu exército para impedir que o <<m:EventUnit>> beba seu sangue:"

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_MAGGOTS_01@AFFINITY_CHOICE_SHADOW@SUCCESS"
msgstr "É menos provável que o <<m:EventUnit>> injete parasitas sanguíneos em seus guerreiros."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_TORMENT_01@AFFINITY_CHOICE_CHAOS@FAILURE"
msgstr "Para o <<G:disappointment^n,{EventHero.FirstName}>>, a dor ainda causa dano."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_TORMENT_01@AFFINITY_CHOICE_CHAOS@HEADER"
msgstr "{EventHero} também busca prazer na dor:"

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_TORMENT_01@AFFINITY_CHOICE_CHAOS@SUCCESS"
msgstr "A mesma exaltação que inspira os ritualistas também beneficia o {EventHero.FirstName}."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_TORMENT_01@AFFINITY_CHOICE_ORDER@FAILURE"
msgstr "Os discípulos {EnemyUnit} e <<o:EnemyUnit>> zombam da sua desaprovação prudente."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_TORMENT_01@AFFINITY_CHOICE_ORDER@HEADER"
msgstr "Tente condenar o <<G:ritualists^p,EnemyUnit>>:"

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@CRIMSON_FANE_TORMENT_01@AFFINITY_CHOICE_ORDER@SUCCESS"
msgstr "Suas palavras acertam o alvo. Seus oponentes são sobrecarregados pela vergonha."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@ENTHRALL_HUNTRESS@AFFINITY_CHOICE@FAILURE"
msgstr "Furioso, {Huntress.FirstName} resiste à sua tentativa de escravizar <<o:Huntress>>."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@ENTHRALL_HUNTRESS@AFFINITY_CHOICE@HEADER"
msgstr "Tente escravizar {Huntress.FirstName} no momento de distração de <<P:Huntress>>."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@ENTHRALL_HUNTRESS@AFFINITY_CHOICE@SUCCESS"
msgstr "{Huntress.FirstName} torna-se seu escravo e <<P:Huntress>> {Huntress.Race} seguem o mesmo caminho."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@ENTHRALL_HUNTRESS@AFFINITY_CHOICE@SUCCESS_ALT"
msgstr "{Huntress.FirstName} torna-se escravizado. Todos os <<o:Huntress>> <<m:{GLOBAL.CityConcept.Hyperlink}>> e <<m:{GLOBAL.UnitConcept.Hyperlink}>> serão removidos do mapa."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@LOST_SOUL@LEVEL_UP_TWICE"
msgstr "{EventHero} ganha experiência suficiente para subir de nível [xp/] duas vezes."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@LOST_SOUL@SPIRIT_RES"
msgstr "{EventHero} ganha +2 {GLOBAL.SpiritResistanceConcept.Name}[defensespirit/]."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@ROSE_PALACE_BANQUET_01@AFFINITY_CHOICE_MATERIUM@FAILURE"
msgstr "Seus tremores invocados falham em quebrar as janelas de Vidro de Sangue."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@ROSE_PALACE_BANQUET_01@AFFINITY_CHOICE_MATERIUM@HEADER"
msgstr "Quebre as janelas de Vidro de Sangue para dispersar a luz maléfica:"

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@ROSE_PALACE_BANQUET_01@AFFINITY_CHOICE_MATERIUM@SUCCESS"
msgstr "O vidro rachado permite que menos raios da Lua de Sangue o atravessem."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@ROSE_PALACE_BANQUET_01@AFFINITY_CHOICE_ORDER@FAILURE"
msgstr "A luz maléfica recusa-se a se curvar à sua piedade."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@ROSE_PALACE_BANQUET_01@AFFINITY_CHOICE_ORDER@HEADER"
msgstr "Tente transformar a astuta luz vermelha em uma Aura Sagrada:"

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@ROSE_PALACE_BANQUET_01@AFFINITY_CHOICE_ORDER@SUCCESS"
msgstr "Quando a luz vermelha toca {EventHero}, ela fortalece a santidade de <<o:EventHero>>."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@ROSE_PALACE_BANSHEE_01@AFFINITY_CHOICE_ASTRAL@FAILURE"
msgstr "{EnemyUnit} envia <<o:EnemyUnit>> <<m:EventUnit>> voando através da face para atacá-lo."

msgid "DLC@THRONESOFBLOOD@TRIGGER@TOOLTIP@ROSE_PALACE_BANSHEE_01@AFFINITY_CHOICE_ASTRAL@HEADER"
msgstr "Evoque uma ilusão espectral de <<G:husband^n,{EnemyUnit.FirstName}>>, como se ainda estivesse vivo:"

