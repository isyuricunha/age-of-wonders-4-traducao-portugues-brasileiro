msgstr "Libere a Fera"

msgid "TOME_WILD@BEASTMASTER@ABILITY_2@DESCRIPTION"
msgstr "Invoca uma unidade animal aleatória de Nível I.{LOC.CONCEPT@SUMMON_LIVE_SHARED}[br/][br/]Entra {GLOBAL.DefenseModeConcept.Hyperlink} após o uso."

msgid "TOME_WILD@BEASTMASTER@ABILITY_2@DESCRIPTION_2"
