msgid "TOME_PARADISE@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Crie um paraíso verdejante e exuberante para seu povo. Foque na economia, cura e bônus."

msgid "TOME_PARADISE@TOME@LORE_AUTHOR"
msgstr "Birchfoot, Ermitão da Clareira"

msgid "TOME_PARADISE@TOME@LORE_DESCRIPTION"
msgstr "\"Dê-me um manto de floresta para espalhar pelo mundo. Desdobre seu abraço esmeralda sobre todas as regiões, lance uma sombra verdejante e frondosa sobre cada terra. Isto! Isto será o meu paraíso. Quando a música do canto dos pássaros e o rugido das feras acompanharem a brisa que atravessa as florestas eternas, então estarei satisfeito!\""

msgid "TOME_PARADISE@TOME@NAME"
msgstr "Tomo do Paraíso"

