msgid "TOME_CYCLES@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Domine os ciclos naturais da vida e da morte e especialize‑se em aplicar penalidades aos inimigos e curar aliados."

msgid "TOME_CYCLES@TOME@LORE_AUTHOR"
