msgstr "Selecione um setor."

msgid "DLC@RISEFROMRUIN@INTERFACE@ROAMING_CITY_INCOME@DESCRIPTION"
msgstr "Renda da Cidade Errante é a quantidade de <<m:{GLOBAL.ResourceConcept.Hyperlink}>> que um {GLOBAL.NomadSettlerConcept.Hyperlink} gera a cada {GLOBAL.TurnConcept.Hyperlink} enquanto está embalado."

msgid "DLC@RISEFROMRUIN@INTERFACE@ROAMING_CITY_INCOME@HYPERLINK"
