msgstr "Todas as unidades atacantes têm {morale} {GLOBAL.UnitMoraleConcept.Hyperlink} até o final da batalha."

msgid "COMBATPROPERTIES_TACTICAL@DISCOURAGED@NAME"
msgstr "Atacantes Desanimados"

msgid "COMBATPROPERTIES_TACTICAL@DISCOURAGED_ENEMIES@DESCRIPTION"
msgstr "Todas as unidades defensoras têm {morale} {GLOBAL.UnitMoraleConcept.Hyperlink} até o final da batalha."

msgid "COMBATPROPERTIES_TACTICAL@DISCOURAGED_ENEMIES@NAME"
msgstr "Defensores Desanimados"

msgid "COMBATPROPERTIES_TACTICAL@DISPERSE_MIST@DESCRIPTION"
msgstr "Invocar ventos para dispersar {value} das nuvens de névoa."

msgid "COMBATPROPERTIES_TACTICAL@DISPERSE_MIST@NAME"
msgstr "Dispersar Névoa"

msgid "COMBATPROPERTIES_TACTICAL@DISPLACING_REALITY@DESCRIPTION"
msgstr "A cada {turn} [turn/], todas as unidades são teleportadas por {range} hexágonos."

msgid "COMBATPROPERTIES_TACTICAL@DISPLACING_REALITY@NAME"
msgstr "Realidade Deslocada"

msgid "COMBATPROPERTIES_TACTICAL@DISTRACTED_ARMY@DESCRIPTION"
msgstr "Todas as unidades atacantes têm {GLOBAL.PROPERTIES.DISTRACTED.Hyperlink} até o final da batalha."

msgid "COMBATPROPERTIES_TACTICAL@DISTRACTED_ARMY@NAME"
msgstr "Atacantes Distráidos"

msgid "COMBATPROPERTIES_TACTICAL@DRACONIC_CATALYST@DESCRIPTION"
msgstr "Quando um Dragão Vermelho tem {GLOBAL.PROPERTIES.DRACONIC_RAGE.Hyperlink}, todas as unidades atacantes têm {chanceBurning} de chance de sofrer {GLOBAL.PROPERTIES.BURNING.Hyperlink} a cada turno.[br/][br/]Quando um Dragão Azul tem {GLOBAL.PROPERTIES.DRACONIC_RAGE.Hyperlink}, todas as unidades atacantes têm {chanceFrozen} de chance de receber {GLOBAL.PROPERTIES.FROZEN.Hyperlink} a cada turno."

msgid "COMBATPROPERTIES_TACTICAL@DRACONIC_CATALYST@NAME"
msgstr "Catalisador Dracônico"

msgid "COMBATPROPERTIES_TACTICAL@ELECTRIFIED@DESCRIPTION"
msgstr "[bulletlist][bullet/]A unidade sofre {ELECRIFIED_DAMAGE_OVER_TIME>ATTACK>Shock} {GLOBAL.LightningDamageConcept.Hyperlink} a cada [turn/].[bullet/]Acúmulo de até {stacksMax} vezes.[/bulletlist]"

msgid "COMBATPROPERTIES_TACTICAL@ELECTRIFIED@NAME"
msgstr "Eletrificado"

msgid "COMBATPROPERTIES_TACTICAL@ENCOURAGED@DESCRIPTION"
msgstr "Todas as unidades atacantes têm {morale} {GLOBAL.UnitMoraleConcept.Hyperlink} até o final da batalha."

msgid "COMBATPROPERTIES_TACTICAL@ENCOURAGED@NAME"
msgstr "Atacantes Incentivados"

msgid "COMBATPROPERTIES_TACTICAL@ENCOURAGED_ENEMIES@DESCRIPTION"
msgstr "Todas as unidades defensoras têm {morale} {GLOBAL.UnitMoraleConcept.Hyperlink} até o final da batalha."

msgid "COMBATPROPERTIES_TACTICAL@ENCOURAGED_ENEMIES@NAME"
msgstr "Defensores Incentivados"

msgid "COMBATPROPERTIES_TACTICAL@ENDLESS_TREASURE@DESCRIPTION"
msgstr "A área está repleta de pilhas de moedas falsas e sem valor que [abilityred]retardam[/abilityred] as unidades e podem ser perigosas ao receber [damageshock/] dano de Choque."

msgid "COMBATPROPERTIES_TACTICAL@ENDLESS_TREASURE@NAME"
msgstr "Tesouro Infinito"

msgid "COMBATPROPERTIES_TACTICAL@ETERNALSERVANTS@DESCRIPTION"
msgstr "Servos Mortos-vivos lutam para proteger a Rainha Morto-viva![br/][br/]Todas as unidades defensoras ressuscitam {turn} {GLOBAL.TurnConcept} após serem mortas pela primeira vez.[br/][br/]Destruir o {GLOBAL.HeroConcept.Hyperlink} defensor elimina instantaneamente todos os inimigos."

msgid "COMBATPROPERTIES_TACTICAL@ETERNALSERVANTS@NAME"
msgstr "Servos Mortos-vivos"

msgid "COMBATPROPERTIES_TACTICAL@EXPEDITION_LEADER@DESCRIPTION"
msgstr "O Herói que lidera este exército é o Líder da Expedição. Se o Líder da Expedição fugir ou morrer, mas a batalha for vencida, as forças restantes reviverão o Líder da Expedição após a batalha."

msgid "COMBATPROPERTIES_TACTICAL@EXPEDITION_LEADER@NAME"
msgstr "Líder da Expedição"

msgid "COMBATPROPERTIES_TACTICAL@FIRESTARTER@DESCRIPTION"
msgstr "Várias áreas e obstáculos inflamáveis estão {GLOBAL.OnFireConcept.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@FIRESTARTER@NAME"
msgstr "Fogo Desenfreado"

msgid "COMBATPROPERTIES_TACTICAL@FIRE_IMMUNITY@DESCRIPTION"
msgstr "Até o final da batalha, todas as unidades atacantes são imunes a sofrer {GLOBAL.PROPERTIES.BURNING.Hyperlink}"

msgid "COMBATPROPERTIES_TACTICAL@FIRE_IMMUNITY@NAME"
msgstr "Imunidade a Atacantes em Chamas"

msgid "COMBATPROPERTIES_TACTICAL@FOCUSED_GAZE@DESCRIPTION"
msgstr "Ataques base {GLOBAL.RangedConcept.Hyperlink} e {GLOBAL.MagicConcept.Hyperlink} de todas as unidades defensoras recebem +{FOCUSED_GAZE_RANGE_BOOST>ADD>MaxRange} {GLOBAL.RangeConcept.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@FOCUSED_GAZE@NAME"
msgstr "Olhar Focado"

msgid "COMBATPROPERTIES_TACTICAL@FOCUSSED_GAZE@NAME"
msgstr "Olhar Focado"

msgid "COMBATPROPERTIES_TACTICAL@FREEZING_WINDS@DESCRIPTION"
msgstr "A cada {timer} [turn/], todas as unidades atacantes sofrem {damage} e têm {chance} de chance de sofrer {GLOBAL.PROPERTIES.FROZEN.Hyperlink}. Se falhar, as unidades sofrem {GLOBAL.SlowingConcept.Hyperlink} em vez disso."

msgid "COMBATPROPERTIES_TACTICAL@FREEZING_WINDS@NAME"
msgstr "Ventos Congelantes"

msgid "COMBATPROPERTIES_TACTICAL@FRIGID_WINDS@DESCRIPTION"
msgstr "Depois que um Relâmpago da Tempestade de Relâmpagos atinge, todas as unidades defensoras recebem {damage} {GLOBAL.FrostDamageConcept.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@FRIGID_WINDS@NAME"
msgstr "Ventos Gélidos"

msgid "COMBATPROPERTIES_TACTICAL@GORGING_PREDATORS@DESCRIPTION"
msgstr "Todas as unidades defensoras possuem a habilidade {GLOBAL.PROPERTIES.VIOLENT_GORGING.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@GORGING_PREDATORS@NAME"
msgstr "Predadores Vorazes"

msgid "COMBATPROPERTIES_TACTICAL@HASTEFUL_ONSLAUGHT@DESCRIPTION"
msgstr "As unidades defensoras têm {GLOBAL.PROPERTIES.HASTENED.Hyperlink}, {GLOBAL.PROPERTIES.SWIFT.Hyperlink} e {GLOBAL.PROPERTIES.SLIPPERY.Hyperlink} até o final do combate."

msgid "COMBATPROPERTIES_TACTICAL@HASTEFUL_ONSLAUGHT@NAME"
msgstr "Velocidade Anormal"

msgid "COMBATPROPERTIES_TACTICAL@HASTENED_ARMY@DESCRIPTION"
msgstr "No início da batalha, todas as unidades atacantes têm {GLOBAL.PROPERTIES.HASTENED.Hyperlink} por {time} [turn/]."

msgid "COMBATPROPERTIES_TACTICAL@HASTENED_ARMY@NAME"
msgstr "Atacantes Acelerados"

msgid "COMBATPROPERTIES_TACTICAL@HASTENED_ENEMIES@DESCRIPTION"
msgstr "No início da batalha, todas as unidades defensoras têm {GLOBAL.PROPERTIES.HASTENED.Hyperlink} por {time} [turn/]."

msgid "COMBATPROPERTIES_TACTICAL@HASTENED_ENEMIES@NAME"
msgstr "Defensores Acelerados"

msgid "COMBATPROPERTIES_TACTICAL@HASTENING_STORM@DESCRIPTION"
msgstr "No início de um turno, pelos próximos {TimeToLive} <<m:{GLOBAL.TurnConcept}>>, uma unidade atacante aleatória recebe {Shock} {GLOBAL.LightningDamageConcept.Hyperlink}, mas também se torna {GLOBAL.PROPERTIES.HASTENED.Hyperlink} por {valueOfHaste} {GLOBAL.TurnConcept}."

msgid "COMBATPROPERTIES_TACTICAL@HASTENING_STORM@NAME"
msgstr "Tempestade Aceleradora"

msgid "COMBATPROPERTIES_TACTICAL@HIDDEN_TRAPS@DESCRIPTION"
msgstr "Várias armadilhas ocultas estão espalhadas pelo mapa! Se uma unidade passar por elas, será afetada por {GLOBAL.PROPERTIES.BLEEDING.Hyperlink} por {turns} <<m:{GLOBAL.TurnConcept}>> e revelará a armadilha! [br/][br/]Não afeta unidades {GLOBAL.PROPERTIES.FLOATING_MOVEMENT.Hyperlink}, {GLOBAL.PROPERTIES.FLYING_MOVEMENT.Hyperlink} ou {GLOBAL.PROPERTIES.ETHEREAL.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@HIDDEN_TRAPS@NAME"
msgstr "Armadilhas Ocultas"

msgid "COMBATPROPERTIES_TACTICAL@IMMUMESEDUCED@DESCRIPTION"
msgstr "Todas as unidades atacantes estão {GLOBAL.PROPERTIES.IMMUMESEDUCED.Hyperlink} até o fim da batalha!"

msgid "COMBATPROPERTIES_TACTICAL@LEECHING_FROM_NATURE@DESCRIPTION"
msgstr "O Deus Cornudo defensor está sugando energia da natureza ao redor. Cada {GLOBAL.TurnConcept}, todos os obstáculos {GLOBAL.FloraObstacleConcept.Hyperlink} dentro de um alcance de {range} hexágonos são consumidos, curando o Deus Cornudo em +{healamount} [hp/] e concedendo {stackamount} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} por {duration} <<m:{GLOBAL.TurnConcept}>>."

msgid "COMBATPROPERTIES_TACTICAL@LEECHING_FROM_NATURE@NAME"
msgstr "Sucção de Natureza"

msgid "COMBATPROPERTIES_TACTICAL@LIGHTNING_RESISTANCE@DESCRIPTION"
msgstr "Até o fim do combate, as unidades defensoras recebem Proteção adicional contra Relâmpago."

msgid "COMBATPROPERTIES_TACTICAL@LIGHTNING_RESISTANCE@NAME"
msgstr "Proteção Avançada contra Relâmpago"

msgid "COMBATPROPERTIES_TACTICAL@LIGHTNING_STORM@DESCRIPTION"
msgstr "No início de um turno, pelos próximos {TimeToLive} <<m:{GLOBAL.TurnConcept}>>, uma unidade atacante aleatória recebe {Shock} {GLOBAL.LightningDamageConcept.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@LIGHTNING_STORM@NAME"
msgstr "Tempestade de Relâmpagos"

msgid "COMBATPROPERTIES_TACTICAL@LITTERED_CORPSES@DESCRIPTION"
msgstr "Vários cadáveres estão espalhados pelo mapa. Eles podem ser úteis para necromancia..."

msgid "COMBATPROPERTIES_TACTICAL@LITTERED_CORPSES@NAME"
msgstr "Coberto de Cadáveres"

msgid "COMBATPROPERTIES_TACTICAL@LOST_PUPPETEER@DESCRIPTION"
msgstr "A cada {Cooldown} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, uma das unidades do atacante torna‑se permanentemente {GLOBAL.PROPERTIES.MIND_CONTROLLED.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@LOST_PUPPETEER@NAME"
msgstr "Sussurros das Trevas"

msgid "COMBATPROPERTIES_TACTICAL@LOST_PUPPETEER_IMMUNITY@DESCRIPTION"
msgstr "Unidades atacantes que estão {GLOBAL.PROPERTIES.FAITHFUL.Hyperlink} ganham {GLOBAL.ControlLossImmunityConcept.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@LOST_PUPPETEER_IMMUNITY@NAME"
msgstr "Lealdade Fiel"

msgid "COMBATPROPERTIES_TACTICAL@LOST_PUPPETEER_REVERSE@DESCRIPTION"
msgstr "Após o primeiro {NumberOfTurns} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, force uma das unidades defensoras a tornar‑se {GLOBAL.PROPERTIES.MIND_CONTROLLED.Hyperlink} e lutar ao seu lado."

msgid "COMBATPROPERTIES_TACTICAL@LOST_PUPPETEER_REVERSE@NAME"
msgstr "Cortar Laços"

msgid "COMBATPROPERTIES_TACTICAL@LOST_PUPPETEER_STUN@DESCRIPTION"
msgstr "Unidades atacantes que se tornam {GLOBAL.PROPERTIES.MIND_CONTROLLED.Hyperlink} ficam {GLOBAL.PROPERTIES.STUNNED.Hyperlink} por {StunNumber} {GLOBAL.TurnConcept.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@LOST_PUPPETEER_STUN@NAME"
msgstr "Talismãs de Controle"

msgid "COMBATPROPERTIES_TACTICAL@LOST_PUPPETEER_STUN_SINGLE@DESCRIPTION"
msgstr "No início do combate, a segunda unidade mais forte do exército defensor torna‑se {GLOBAL.PROPERTIES.STUNNED.Hyperlink} por {value} <<m:{GLOBAL.TurnConcept.Hyperlink}>>"

msgid "COMBATPROPERTIES_TACTICAL@LOST_PUPPETEER_STUN_SINGLE@NAME"
msgstr "Quebrar Controle"

msgid "COMBATPROPERTIES_TACTICAL@MASS_SPAWNING2@NAME"
msgstr "Geração em Massa: Segunda Onda"

msgid "COMBATPROPERTIES_TACTICAL@MASS_SPAWNING3@NAME"
msgstr "Geração em Massa: Terceira Onda"

msgid "COMBATPROPERTIES_TACTICAL@MASS_SPAWNING@DESCRIPTION"
msgstr "Uma onda de {amount} unidades defensoras adicionais surgirá em {timer} [turn/]!"

msgid "COMBATPROPERTIES_TACTICAL@MASS_SPAWNING@NAME"
msgstr "Gerar Primeira Onda"

msgid "COMBATPROPERTIES_TACTICAL@MIRROR_VEIL_ARMY@DESCRIPTION"
msgstr "Todas as unidades atacantes têm {GLOBAL.PROPERTIES.MIRROR_VEIL_DAMAGE_REFLECTION}"

msgid "COMBATPROPERTIES_TACTICAL@MIRROR_VEIL_ARMY@NAME"
msgstr "Atacantes do Véu Espelhado"

msgid "COMBATPROPERTIES_TACTICAL@MIRROR_VEIL_ENEMIES@DESCRIPTION"
msgstr "Todas as unidades defensoras têm {GLOBAL.PROPERTIES.MIRROR_VEIL_DAMAGE_REFLECTION}"

msgid "COMBATPROPERTIES_TACTICAL@MIRROR_VEIL_ENEMIES@NAME"
msgstr "Defensores do Véu Espelhado"

msgid "COMBATPROPERTIES_TACTICAL@MISTY_MAGIC@DESCRIPTION"
msgstr "{GLOBAL.ObscuringConcept.Hyperlink} Névoa cobre o campo de batalha, concedendo a todas as unidades que permanecem na névoa {value} {GLOBAL.ResistanceConcept.Hyperlink}, mas as unidades atacantes também ganham {GLOBAL.PROPERTIES.DISTRACTED.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@MISTY_MAGIC@NAME"
msgstr "Magia Nebulosa"

msgid "COMBATPROPERTIES_TACTICAL@MISTY_MAGIC@SPELL@DESCRIPTION"
msgstr "{GLOBAL.ObscuringConcept.Hyperlink} Névoa cobre o campo de batalha por {numTurns} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, concedendo às suas unidades que permanecem na névoa {value} {GLOBAL.ResistanceConcept.Hyperlink} e as unidades inimigas tornam‑se {GLOBAL.PROPERTIES.DISTRACTED.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@OH_SO_LUCKY@DESCRIPTION"
msgstr "A cada {turn} <<m:{GLOBAL.TurnConcept.Hyperlink}>>, todas as unidades defensoras ganham {GLOBAL.PROPERTIES.RALLYING.Hyperlink} e {GLOBAL.PROPERTIES.FORTUNE.Hyperlink}."

msgid "COMBATPROPERTIES_TACTICAL@OH_SO_LUCKY@NAME"
msgstr "Que Sorte"

msgid "COMBATPROPERTIES_TACTICAL@OMNI_ATTUNEMENT@DESCRIPTION"
msgstr "O {GLOBAL.UNITS.LOST_WIZARD_UNIT.Hyperlink} defensor anseia por conhecimento proibido e feitiços antigos. Cada vez que um Feitiço é lançado, ele ganha {amount} <<m:{GLOBAL.PositiveStatusEffectConcept.Hyperlink}>> aleatórios."

msgid "COMBATPROPERTIES_TACTICAL@OMNI_ATTUNEMENT@NAME"
msgstr "Sintonização Omniversal"

msgid "COMBATPROPERTIES_TACTICAL@OPENED_COOLING_VENTS@DESCRIPTION"
