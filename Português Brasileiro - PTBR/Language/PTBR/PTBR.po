msgstr "Eles acreditam que paz e silêncio são essenciais para o estudo e lutarão para garantir que esses valores sejam alcançados."

msgid "DLC@EMPIRESANDASHES@RACETRAITS_WORLD@HERMIT_KINGDOM@EFFECT1@DESCRIPTION"
msgstr "<<m:{GLOBAL.CityConcept.Hyperlink}>> ganham {knowledgeIncome} {GLOBAL.KnowledgeConcept.Hyperlink}, {amount2} {GLOBAL.FoodConcept.Hyperlink}, {amount3} {GLOBAL.StructureProductionConcept.Hyperlink} e {HappinessIncome} {GLOBAL.CityStabilityConcept.Hyperlink} de renda quando sua {GLOBAL.DomainConcept.Hyperlink} não faz fronteira com o {GLOBAL.DomainConcept.Hyperlink} de qualquer outro {GLOBAL.CityConcept.Hyperlink} ou {GLOBAL.OutpostConcept.Hyperlink}."

msgid "DLC@EMPIRESANDASHES@RACETRAITS_WORLD@HERMIT_KINGDOM@EFFECT2@DESCRIPTION"
msgstr "Agravos infligidos por outros impérios que invadem seu território são aumentados em {GrievanceMultiplier}%."

msgid "DLC@EMPIRESANDASHES@RACETRAITS_WORLD@HERMIT_KINGDOM@LORE"
msgstr "Eles desejam apenas ficar a sós com seus estudos e protegerão agressivamente seu isolamento estudioso de quaisquer perturbações."

msgid "DLC@EMPIRESANDASHES@RACETRAITS_WORLD@HERMIT_KINGDOM@NAME"
msgstr "Reino do Ermitão"

msgid "DLC@EMPIRESANDASHES@RACETRAITS_WORLD@RECLAIMERS@BIO"
msgstr "Eles acreditam que tudo deve ser recuperado e forjado novamente, mais forte."

msgid "DLC@EMPIRESANDASHES@RACETRAITS_WORLD@RECLAIMERS@EFFECT1@DESCRIPTION"
msgstr "Ganhe [hyperlink,GLOBAL.BindingEssenceConcept][bindingessence/] Essência Vinculante e [bindingfragments/] Fragmentos[/hyperlink] ao limpar <<m:{GLOBAL.InfestationSpawnerConcept.Hyperlink}>>, limpar <<m:{GLOBAL.AncientWonderConcept.Hyperlink}>>, [hyperlink,GLOBAL.RazingConcept]Arrasando[/hyperlink] <<m:{GLOBAL.CityConcept.Hyperlink}>>, e {GLOBAL.PillagingConcept.Hyperlink} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>>."

msgid "DLC@EMPIRESANDASHES@RACETRAITS_WORLD@RECLAIMERS@LORE"
msgstr "Eles acreditam que tudo pode ser forjado novamente em algo melhor, mas antes disso, deve ser recuperado."

msgid "DLC@EMPIRESANDASHES@RACETRAITS_WORLD@RECLAIMERS@NAME"
msgstr "Recuperadores"

msgid "DLC@EMPIRESANDASHES@REALM_TRAIT@AMAZONIAN_REALM@DESCRIPTION"
msgstr "O reino é uma selva exuberante, cercada por Vazio Astral.[bulletlist][bullet/]Tropical <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> e floresta <<m:{GLOBAL.ProvinceFeatureConcept.Hyperlink}>> são [abilityblue]Comum[/abilityblue].[bullet/]Rio <<m:{GLOBAL.ProvinceFeatureConcept.Hyperlink}>> são [abilityblue]Comum[/abilityblue].[bullet/]Ártico, deserto e áreas desoladas <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> são [abilityblue]Raro[/abilityblue].[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@REALM_TRAIT@AMAZONIAN_REALM@NAME"
msgstr "Selva Perdida"

msgid "DLC@EMPIRESANDASHES@REALM_TRAIT@AVIAN_INHABITANTS@DESCRIPTION"
msgstr "O reino abriga muitas aves, civilizadas e selvagens.[bulletlist][bullet/]Aviário <<m:{GLOBAL.IndependentCityConcept.Hyperlink}>> são [abilityblue]Comum[/abilityblue].[bullet/]<<m:{GLOBAL.STRUCTURES.GREAT_BIRD_NEST_SPAWNER.Hyperlink}>> são [abilityblue]Comum[/abilityblue].[bullet/]Ave <<m:{GLOBAL.UnitConcept.Hyperlink}>> são [abilityblue]Comum[/abilityblue].[/bulletlist]"

msgid "DLC@EMPIRESANDASHES@REALM_TRAIT@AVIAN_INHABITANTS@NAME"
msgstr "Pássaros do Paraíso"

msgid "DLC@EMPIRESANDASHES@REALM_TRAIT@WARDEN_OF_MANUHARI@DESCRIPTION"
