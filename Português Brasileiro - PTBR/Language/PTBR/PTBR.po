msgstr "Os ataques da unidade têm:[bulletlist][bullet/]+{FROST_BLADES_EXTRA_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]+{FROST_BLADES_DAMAGE_MULTIPLIER>ResolvedMultiplier}% d dano contra unidades {GLOBAL.PROPERTIES.FROZEN.Hyperlink} e {GLOBAL.PROPERTIES.SLOWED.Hyperlink}.[/bulletlist] [br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

