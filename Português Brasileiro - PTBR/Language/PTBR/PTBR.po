msgid "INTERFACE@MAP_SETUP_TOOLTIP@PLAYER_EMPIRE_MECHANICS"
msgstr "Quando ativado, {GLOBAL.PantheonLoreConcept.Hyperlink} <<m:{GLOBAL.LeaderConcept.Hyperlink}>> começará com <<m:{GLOBAL.AscensionTraitConcept.Hyperlink}>>, <<m:{GLOBAL.AscendedTransformationConcept.Hyperlink}>> e habilidades de herói ascendido. Além disso, governantes do panteão marcados como heróis recrutáveis podem ser oferecidos como herói e, na vitória, um governante pode ascender ao Panteão.[br/][br/]Governantes do panteão podem ser sempre selecionados independentemente desta configuração."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@PLAYER_EMPIRE_MECHANICS_BONUSTRAIT"
msgstr "Quando ativado, {GLOBAL.PantheonLoreConcept.Hyperlink} <<m:{GLOBAL.LeaderConcept.Hyperlink}>> começará com <<m:{GLOBAL.AscensionTraitConcept.Hyperlink}>>.{LOC.INTERFACE@MAP_SETUP_TOOLTIP@PLAYER_EMPIRE_MECHANICS_GENERAL}"

msgid "INTERFACE@MAP_SETUP_TOOLTIP@PLAYER_EMPIRE_MECHANICS_GENERAL"
msgstr "[br/][br/]Governantes do Panteão podem ser sempre selecionados independentemente desta configuração e, na vitória, um governante pode ascender ao Panteão."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@PLAYER_EMPIRE_MECHANICS_HERORECRUITMENT"
