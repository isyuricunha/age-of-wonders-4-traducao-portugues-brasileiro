msgid "DLC@GIANTKINGS@DIPLOMACY@CRYSTAL_DWELLING@CRYSTAL_PACT@DESCRIPTION"
msgstr "[bulletlist][bullet/]Será [hyperlink,GLOBAL.ReinforcementRuleConcept]reforçado[/hyperlink] em {GLOBAL.CombatConcept.Hyperlink} contra <<m:{GLOBAL.MarauderConcept.Hyperlink}>> e <<m:{GLOBAL.LeaderConcept.Hyperlink}>> o {GLOBAL.DwellingConcept.Hyperlink} está em {GLOBAL.IndependentCityWarConcept.Hyperlink} com.[bullet/]Desbloqueia a compra dos seguintes itens comerciais via Cooperação:[bulletlist][bullet/]{GLOBAL.TOKENDEFINITION.LITHORITE_PRISM_ARTIFACT.Hyperlink}[bullet/]{GLOBAL.SPECIAL_OPERATIONS.CRYSTAL_FOCUS.Hyperlink}[bullet/]{GLOBAL.SPECIAL_OPERATIONS.CRYSTALLIZE_ESSENCE.Hyperlink}[bullet/]{GLOBAL.SPECIAL_OPERATIONS.CRYSTAL_CRASH.Hyperlink}[bullet/]{GLOBAL.UNITS.LITHORINE_SHARDLANCER.Hyperlink}[bullet/]{GLOBAL.UNITS.LITHORINE_GEMCASTER.Hyperlink}[/bulletlist][bullet/]Completar missões de Moradia garante {GLOBAL.ManaConcept.Hyperlink} além de suas outras recompensas.[/bulletlist]"

msgid "DLC@GIANTKINGS@DIPLOMACY@CRYSTAL_DWELLING@CRYSTAL_PACT@HYPERLINK"
msgstr "[rs_crystal/] [hyperlink,GLOBAL.CrystalDwellingCrystalPactConcept]Pacto de Cristal[/hyperlink]"

msgid "DLC@GIANTKINGS@DIPLOMACY@CRYSTAL_DWELLING@CRYSTAL_PACT@NAME"
msgstr "Pacto de Cristal"

msgid "DLC@GIANTKINGS@DIPLOMACY@CRYSTAL_DWELLING@ETERNAL_PACT@DESCRIPTION"
msgstr "[bulletlist][bullet/]{GLOBAL.DwellingConcept.Hyperlink} compartilha sua visão.[bullet/]Desbloqueia a compra dos seguintes itens comerciais via Cooperação:[bulletlist][bullet/]{GLOBAL.TOKENDEFINITION.LITHORITE_ASTROLABE_ARTIFACT.Hyperlink}[bullet/]{GLOBAL.STRUCTURE_UPGRADES.ETERNAL_EMBASSY.Hyperlink}[bullet/]{GLOBAL.UNITS.LITHORINE_SIMULACRUM.Hyperlink}[bullet/]{GLOBAL.EQUIPMENT.ETERNAL_GOLDSEEKERS_PICKAXE.Hyperlink}[bullet/]{GLOBAL.EQUIPMENT.ETERNAL_LITHORINE_ORB.Hyperlink}[bullet/]{GLOBAL.EQUIPMENT.ETERNAL_SHATTERBLADES.Hyperlink}[bullet/]{GLOBAL.EQUIPMENT.ETERNAL_TITANS_GREATBOW.Hyperlink}[/bulletlist][bullet/]Completar missões de Moradia garante {GLOBAL.ImperiumConcept.Hyperlink} além de outras recompensas.[bullet/]O {GLOBAL.DwellingConcept.Hyperlink} concede um considerável aumento de renda {GLOBAL.KnowledgeConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@DIPLOMACY@CRYSTAL_DWELLING@ETERNAL_PACT@HYPERLINK"
msgstr "[rs_eternal/] [hyperlink,GLOBAL.CrystalDwellingEternalPactConcept]Pacto Eterno[/hyperlink]"

msgid "DLC@GIANTKINGS@DIPLOMACY@CRYSTAL_DWELLING@ETERNAL_PACT@NAME"
msgstr "Pacto Eterno"

msgid "DLC@GIANTKINGS@DIPLOMACY@CRYSTAL_DWELLING@STONE_PACT@DESRCIPTION"
msgstr "[bulletlist][bullet/]O {GLOBAL.CrystalDwellingConcept.Hyperlink} abre suas fronteiras.[bullet/]Desbloqueia a compra dos seguintes itens comerciais via Cooperação:[bulletlist][bullet/]{GLOBAL.TOKENDEFINITION.LITHORITE_SCROLL_ARTIFACT.Hyperlink}[bullet/]{GLOBAL.UNITS.LITHORINE_NEEDLER.Hyperlink}[bullet/]{GLOBAL.EQUIPMENT.GOLDSEEKERS_PICKAXE.Hyperlink}[bullet/]{GLOBAL.EQUIPMENT.LITHORITE_ORB.Hyperlink}[bullet/]{GLOBAL.EQUIPMENT.SHATTER_BLADES.Hyperlink}[bullet/]{GLOBAL.EQUIPMENT.TITANS_GREATBOW.Hyperlink}[/bulletlist][bullet/]Completar missões de Moradia concede itens de herói garantidos além de suas outras recompensas.[/bulletlist]"

msgid "DLC@GIANTKINGS@DIPLOMACY@CRYSTAL_DWELLING@STONE_PACT@HYPERLINK"
