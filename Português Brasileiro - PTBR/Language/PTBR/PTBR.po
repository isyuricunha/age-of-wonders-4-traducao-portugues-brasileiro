msgid "DLC@WAYSOFWAR@PROSPERITY_DRAGON@RECALL_MASK_OF_PROSPERITY@DESCRIPTION"
msgstr "[bulletlist][bullet/]Quebre o vínculo {GLOBAL.PROPERTIES.BESTOW_MASK_OF_PROSPERITY_CASTER.Hyperlink}.[bullet/]Consuma todas as pilhas de {GLOBAL.PROPERTIES.GRACE.Hyperlink}. Então, por pilha consumida:[bulletlist][bullet/]Cure {RECALL_MASK_OF_PROSPERITY_HEAL_EFFECT>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Ganhe uma pilha de {GLOBAL.PROPERTIES.REGENERATION.Hyperlink}.[/bulletlist][/bulletlist]"

