msgstr "Esta unidade está adjacente a uma unidade amiga com {GLOBAL.PROPERTIES.ANIMAL_KINSHIP.Hyperlink} e recebe:[bulletlist][bullet/]+{ANIMAL_KINSHIP_DAMAGE>ResolvedMultiplier}% damage[bullet/]+{ANIMAL_KINSHIP_CRIT_CHANCE>ResolvedCritChanceBonus}% {GLOBAL.CriticalHitChanceConcept}[/bulletlist]"

msgid "TOME_WILD@SKILL2@PROPERTY@DESCRIPTION"
