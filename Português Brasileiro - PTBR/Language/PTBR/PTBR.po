msgid "DLC@GIANTKINGS@HOTGK_FINISHER@DESCRIPTION_NON_HEIR"
msgstr "Os Clãs Gigantes se uniram para atacar todos os impérios do reino. Eles convocam \"Herdeiro de Thagnokar\" para liderá‑los à vitória contra as raças menores."

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@GRIEVANCE"
msgstr "{STR_leaderName} está liderando o ataque dos Clãs Gigantes neste reino!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@HEADER_ACTIVE_ASSAULT"
msgstr "Defenda {HOTGK_TARGET_CITY} contra o exército {HOTGK_CLAN_NAME}!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@HEADER_ACTIVE_ASSAULT_HEIR"
msgstr "Os Clãs Gigantes estão atacando o reino!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@HEADER_CITY_CONQUERED"
msgstr "Pare o {HOTGK_CLAN_NAME} antes que eles arrasem {HOTGK_TARGET_CITY}!"

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@HEADER_CITY_RAZED"
msgstr "Depois de arrasar {HOTGK_TARGET_CITY}, o {HOTGK_CLAN_NAME} retirou‑se do seu domínio."

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@HEADER_CITY_RAZED_OTHER"
msgstr "Depois que {HOTGK_TARGET_CITY} foi arrasado, o {HOTGK_CLAN_NAME} abortou o ataque."

msgid "DLC@GIANTKINGS@HOTGK_FINISHER@HEADER_CITY_TARGET_SCRIED"
msgstr "Herdeiro de Thagnokar: {HOTGK_TARGET_CITY} será atacado!"

