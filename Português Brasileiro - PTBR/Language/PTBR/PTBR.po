msgid "TOME_WINDS@SKILL2@PROP_DESCRIPTION"
msgstr "Unidade possui:[bulletlist][bullet/]Uma montaria voadora.[/bulletlist]"

msgid "TOME_WINDS@SKILL3@DESCRIPTION"
msgstr "Unidades inimigas em um raio de {DUST_STORM_UNIT_TARGETER_SINGLE>AREA>Radius} hexágonos:[bulletlist][bullet/]Sustentam {DUST_STORM_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Têm uma base {BLINDED_RESISTANCE>ResolvedStrength}% cchance de se tornar {GLOBAL.PROPERTIES.BLINDED.Hyperlink} por {BLINDED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "TOME_WINDS@SKILL3@NAME"
msgstr "Tempestade de Areia"

