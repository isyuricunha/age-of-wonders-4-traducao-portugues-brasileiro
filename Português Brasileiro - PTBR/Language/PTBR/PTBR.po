msgid "TOME_CRUCIBLE@SKILL5@PROP_DESCRIPTION"
msgstr "Os ataques base da unidade têm:[bulletlist][bullet/]+{METEOR_ARROWS_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} no alvo e inimigos adjacentes.[bullet/]{GLOBAL.PROPERTIES.DEMOLISHER.Hyperlink}.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CRUCIBLE@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Enterre seus inimigos em lava e molde a terra usando as forças destrutivas da terra e do fogo."

msgid "TOME_CRUCIBLE@TOME@LORE_AUTHOR"
msgstr "Yaka, autoproclamado Deus do Fogo"

msgid "TOME_CRUCIBLE@TOME@LORE_DESCRIPTION"
msgstr "\"Não é o magma um espetáculo glorioso de se contemplar? Uma união de fogo e terra que flui inexoravelmente em direção aos seus inimigos, engolindo-os, trazendo morte flamejante! A própria paisagem se remodela quando flui, com belas cicatrizes traçadas sobre o reino.\""

msgid "TOME_CRUCIBLE@TOME@NAME"
msgstr "Tomo do Crisol"

msgid "TOME_CRYOMANCY@PASSIVE@DESCRIPTION"
