msgstr "Parasita de Sangue Frenético"

msgid "DLC@THRONESOFBLOOD@SHAREDMODIFIERS_UNITPROPERTIES@BLOOD_PARASITE@DESCRIPTION"
msgstr "[bulletlist][bullet/]Unidade sofre {BLOOD_PARASITE_DAMAGE_OVER_TIME>ATTACK>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink} a cada [turn/].[bullet/]Substitui e conta como {GLOBAL.PROPERTIES.BLEEDING.Hyperlink}, mas ignora {GLOBAL.PROPERTIES.STATUS_EFFECT_IMMUNITY_BLEEDING.Hyperlink}.[bullet/]Acumula até {amount} vezes.[/bulletlist][bulletlist][br/]Ao morrer, a unidade gera um {GLOBAL.UNITS.BLOOD_MAGGOT.Hyperlink} sob controle do oponente até o fim do combate.[/bulletlist]"

msgid "DLC@THRONESOFBLOOD@SHAREDMODIFIERS_UNITPROPERTIES@BLOOD_PARASITE@GUARANTEED_MODIFIER_DESCRIPTION"
msgstr "Inflige {GLOBAL.PROPERTIES.BLOOD_PARASITE.Hyperlink} por {BLOOD_PARASITE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "DLC@THRONESOFBLOOD@SHAREDMODIFIERS_UNITPROPERTIES@BLOOD_PARASITE@MODIFIER_DESCRIPTION"
msgstr "Base {BLOOD_PARASITE_RESISTANCE>ResolvedStrength}% c de infligir {GLOBAL.PROPERTIES.BLOOD_PARASITE.Hyperlink} por {BLOOD_PARASITE_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "DLC@THRONESOFBLOOD@SHAREDMODIFIERS_UNITPROPERTIES@BLOOD_PARASITE@NAME"
msgstr "Parasita de Sangue"

