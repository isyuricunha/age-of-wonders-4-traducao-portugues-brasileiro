msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@FRACTURED@ABILITY02@CHAMPION_DESCRIPTION"
msgstr "Drenagem de Mana:[bulletlist][bullet/]O dano base aumenta para {MANA_DRAIN_UNIT_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.DISRUPTION_TOOLTIP_PROPERTY.Hyperlink} e a chance de {GLOBAL.PROPERTIES.MANA_STARVED.Hyperlink} aumenta para {MANA_DRAINED_RESISTANCE>ResolvedStrength}%[/bulletlist]"

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@FRACTURED@ABILITY02@CHAMPION_NAME"
msgstr "Drenagem de Mana do Campeão"

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@FRACTURED@ABILITY02@DESCRIPTION"
msgstr "Unidade alvo:[bulletlist][bullet/]Sofre dano.[bullet/]Tem uma chance base de {DISRUPTION_RESISTANCE>ResolvedStrength}% c de se tornar {GLOBAL.PROPERTIES.DISRUPTION_TOOLTIP_PROPERTY.Hyperlink} por {DISRUPTION_DISABLE>Duration} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Tem uma chance base de {MANA_DRAINED_RESISTANCE>ResolvedStrength}% c de se tornar {GLOBAL.PROPERTIES.MANA_DRAINED.Hyperlink} por {MANA_DRAINED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@FRACTURED@ABILITY02@NAME"
msgstr "Drenagem de Mana"

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@FRACTURED@ABILITY03@DESCRIPTION"
msgstr "Unidade alvo sofre dano. Entre {GLOBAL.DefenseModeConcept.Hyperlink}."

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@FRACTURED@ABILITY03@NAME"
msgstr "Ferrão Desestabilizador"

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@FRACTURED@ABILITY04@DESCRIPTION"
msgstr "Mover para o hexágono alvo."

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@FRACTURED@ABILITY04@NAME"
msgstr "Mudança de Fase"

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@FRACTURED@ABILITY05@DESCRIPTION"
msgstr "Unidades inimigas em um raio de {SEVERING_TREMOR_TARGETER>AREA>Radius} hexágonos:[bulletlist][bullet/]Sofrem dano.[bullet/]{GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink} unidades sofrem dano dobrado.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@FRACTURED@ABILITY05@NAME"
msgstr "Tremor Cortante"

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@FRACTURED@ABILITY06@DESCRIPTION"
msgstr "[bulletlist][bullet/]Causa dano a todas as unidades em um cone de {ANTIMAGIC_BREATH_TARGETER>AREA>Length} hexágonos.[bullet/]{GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink} unidades têm uma chance base de {ANTIMAGIC_BREATH_RESISTANCE_CHECK>ResolvedStrength}% c morrer instantaneamente.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@FRACTURED@ABILITY06@NAME"
msgstr "Sopro Anti‑Magia"

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@FRACTURED@ABILITY07@DESCRIPTION"
msgstr "No início do turno, unidades inimigas adjacentes:[bulletlist][bullet/]Sofrem {DISRUPTING_AURA_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Têm uma chance base de {DISRUPTION_RESISTANCE>ResolvedStrength}% c de se tornar {GLOBAL.PROPERTIES.DISRUPTION_TOOLTIP_PROPERTY.Hyperlink} por {DISRUPTION_DISABLE>Duration} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@FRACTURED@ABILITY07@NAME"
msgstr "Aura Desestabilizadora"

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@FRACTURED@ABILITY08@DESCRIPTION"
msgstr "Unidade inimiga alvo:[bulletlist][bullet/]Sofre dano.[bullet/]Torna‑se {GLOBAL.PROPERTIES.MANA_DRAINED.Hyperlink} por {MANA_DRAINED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][br/]Ao acertar, todas as outras unidades amigas com {GLOBAL.PROPERTIES.MANA_STARVED.Hyperlink} ganham {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} e {GLOBAL.PROPERTIES.REGENERATION.Hyperlink} por {STRENGTHENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@FRACTURED@ABILITY08@NAME"
msgstr "Toque de Drenagem de Mana"

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@FRACTURED@SHARED@DESCRIPTION"
msgstr "Esta unidade:[bulletlist][bullet/]Ganha {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} e {GLOBAL.PROPERTIES.REGENERATION.Hyperlink} por {STRENGTHENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>:[bulletlist][bullet/]Quando aplica {GLOBAL.PROPERTIES.DISRUPTION_TOOLTIP_PROPERTY.Hyperlink} e {GLOBAL.PROPERTIES.MANA_DRAIN.Hyperlink}.[bullet/]Quando atingida por um ataque {GLOBAL.MagicConcept.Hyperlink}:[/bulletlist][bullet/]Não pode ter Encantamentos ou Transformações de Unidade.[bullet/]Tem {GLOBAL.ControlLossImmunityConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@FRACTURED@SHARED@NAME"
msgstr "Privado de Mana"

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@SAND_WORM@ABILITY01@DESCRIPTION"
msgstr "Unidades inimigas em um raio de {EARTH_TREMOR_TARGETER>AREA>Radius}-hexágonos recebem dano.[br/][br/]Causam dano dobrado aos obstáculos."

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@SAND_WORM@ABILITY01@NAME"
msgstr "Tremor de Terra"

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@SAND_WORM@ABILITY02@DESCRIPTION"
msgstr "Chance base de {SAND_WORM_SWALLOW_WHOLE_RESISTANCE>ResolvedStrength}% c de [hyperlink,GLOBAL.SwallowedConcept]Engolir[/hyperlink] uma unidade não‑herói."

msgid "DLC@RISEFROMRUIN@WILDLIFE_UNITPROPERTIES@SAND_WORM@ABILITY02@NAME"
msgstr "Engolir Inteiro"

