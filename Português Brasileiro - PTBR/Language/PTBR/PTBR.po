msgid "TOME_REAPER@SKILL3@NAME"
msgstr "Reanimação Superior"

msgid "TOME_REAPER@SKILL4@DESCRIPTION"
msgstr "Invoca um Ceifador, um {GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink} que pode matar unidades instantaneamente e fortalece seus Mortos-Vivos."

msgid "TOME_REAPER@SKILL4@NAME"
msgstr "Invocar Ceifador"

msgid "TOME_REAPER@SKILL5@DESCRIPTION"
msgstr "Alvo aliado {GLOBAL.CityConcept}:[bulletlist][bullet/]Não recebe mais nenhuma renda de {GLOBAL.FoodConcept}.[bullet/]Ganha +{amount2} <<m:{GLOBAL.SoulConcept}>> renda.[bullet/]Possui {amount3} {GLOBAL.CityStabilityConcept.Hyperlink}[/bulletlist]"

msgid "TOME_REAPER@SKILL5@NAME"
msgstr "Colher População"

msgid "TOME_REAPER@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Extraia <<m:{GLOBAL.SoulConcept.Hyperlink}>> de forma brutal e use-os para trazer terrores {GLOBAL.PROPERTIES.UNDEAD.Hyperlink} ao mundo. Use efeitos de morte instantânea e sinergia suprema de {GLOBAL.PROPERTIES.UNDEAD.Hyperlink}."

msgid "TOME_REAPER@TOME@LORE_AUTHOR"
msgstr "Melenis, o Sem Vida, Lorde da Tempestade Morta-Viva"

msgid "TOME_REAPER@TOME@LORE_DESCRIPTION"
msgstr "\"Tantos desperdiçam o dom divino de suas almas, apenas tentando trazer algum vislumbre de esperança para suas vidas insignificantes. Eles realmente carecem de visão. Que potencial desperdiçado! Não são dignos de uma fonte de poder tão eficaz. Ceifadores corrigem essa falha dilacerando o espírito, usando-o para alimentar as artes mais sombrias, e trazendo a deliciosa morte-viva à terra!\""

msgid "TOME_REAPER@TOME@NAME"
