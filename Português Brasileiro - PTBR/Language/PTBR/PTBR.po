msgid "TOME_WILD@BEASTMASTER@ABILITY_3@DESCRIPTION"
msgstr "Animais neste exército requerem {CARETAKER_UPKEEP_MODIFIER>ResolvedUpkeepModifier}% le base {GLOBAL.UnitUpkeepConcept.Hyperlink}."

