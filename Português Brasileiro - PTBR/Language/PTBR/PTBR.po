msgstr "Anéis de Emnora"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@NOTE_FIRST_RING_UNLOCKED_DARK@DESC"
msgstr "Canalizando um eco fraco e corrupto de seus poderes de Arconte, o {GLOBAL.UNITS.FALLEN_ANGEL.Hyperlink} manipulou o {GLOBAL.STRUCTURES.GOLDEN_ZIGGURAT.Hyperlink}, concedendo-lhe acesso ao segundo anel de Emnora."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@NOTE_FIRST_RING_UNLOCKED_DARK@HEADER"
msgstr "Os Anéis de Emnora: Segundo Anel Acessível"

