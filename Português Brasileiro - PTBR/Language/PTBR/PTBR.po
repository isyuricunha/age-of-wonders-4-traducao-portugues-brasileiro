msgid "INTERFACE@MESSAGE_PANEL@ABORT_SESSION_DESCRIPTION"
msgstr "Você está prestes a abortar e encerrar a sessão. Todos os jogadores que se juntaram serão expulsos automaticamente. [br/][br/]Deseja continuar?"

msgid "INTERFACE@MESSAGE_PANEL@ARE_YOU_SURE"
msgstr "Tem certeza?"

