msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@ASCENSION_TRAIT@FIELD_ABJURER@HERO_TRAIT_DESCRIPTION"
msgstr "Unidades não‑heróis do seu exército têm:[bulletlist][bullet/]Quando o total de <<m:{GLOBAL.HitPointConcept.Hyperlink}>> desta unidade atingir {FIELD_ABJURER_UNIT>ResolvedTriggerProportion}% or lower, ganhe {amount} {GLOBAL.PROPERTIES.GRACE.Hyperlink}.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@ASCENSION_TRAIT@FIELD_ABJURER@HERO_TRAIT_NAME"
msgstr "Ascensão: Abjurador de Campo"

