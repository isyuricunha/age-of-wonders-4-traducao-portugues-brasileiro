msgid "DLC@ARCHONPROPHECY@TOME_REVENANT@SKILL1@NAME"
msgstr "Invocar Anjo Caído"

msgid "DLC@ARCHONPROPHECY@TOME_REVENANT@SKILL2@DESCRIPTION"
msgstr "Unidades mortas‑vivas alistadas nesta cidade recebem {GLOBAL.PROPERTIES.NATURAL_REGENERATION_GROUP.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@TOME_REVENANT@SKILL2@NAME"
msgstr "Câmara do Rito"

msgid "DLC@ARCHONPROPHECY@TOME_REVENANT@SKILL3@DESCRIPTION"
msgstr "Concede unidades encantadas:[bulletlist][bullet/]+{UNDEAD_RESENTMENT_RESISTANCES>REDUCTION>Spirit} {GLOBAL.SpiritResistanceConcept.Hyperlink}[bullet/]+{UNDEAD_RESENTMENT_RESISTANCES>REDUCTION>Fire} {GLOBAL.FireResistanceConcept.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.VICIOUS_KILLER.Hyperlink}[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_REVENANT@SKILL3@NAME"
msgstr "Ressentimento dos Mortos‑Vivos"

msgid "DLC@ARCHONPROPHECY@TOME_REVENANT@SKILL3@PROP_DESCRIPTION"
msgstr "Unidade tem:[bulletlist][bullet/]+{UNDEAD_RESENTMENT_RESISTANCES>REDUCTION>Spirit} {GLOBAL.SpiritResistanceConcept.Hyperlink}[bullet/]+{UNDEAD_RESENTMENT_RESISTANCES>REDUCTION>Fire} {GLOBAL.FireResistanceConcept.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.VICIOUS_KILLER.Hyperlink}[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_REVENANT@SKILL4@COMBAT_DESCRIPTION"
msgstr "Gerar {amount} Esqueletos com {GLOBAL.PROPERTIES.UNHOLY_CHAMPION_PROPERTY_GROUP.Hyperlink} no lado do atacante."

msgid "DLC@ARCHONPROPHECY@TOME_REVENANT@SKILL4@DESCRIPTION"
msgstr "Por {amount} {GLOBAL.WorldMapConcept.Hyperlink} {GLOBAL.TurnConcept}, o exército inimigo alvo ganha:[bulletlist][bullet/]{amount2} {GLOBAL.PROPERTIES.DEMORALIZED}.[bullet/]Quando atacado, conjura {amount3} Esqueletos com {GLOBAL.PROPERTIES.UNHOLY_CHAMPION_PROPERTY_GROUP.Hyperlink} no lado do atacante.[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_REVENANT@SKILL4@NAME"
msgstr "Sussurros do Revenante"

msgid "DLC@ARCHONPROPHECY@TOME_REVENANT@SKILL4@STRAT_DEBUFF_DESCRIPTION"
msgstr "Quando atacado, conjura {amount} Esqueletos com {GLOBAL.PROPERTIES.UNHOLY_CHAMPION_PROPERTY_GROUP.Hyperlink} no lado do atacante."

msgid "DLC@ARCHONPROPHECY@TOME_REVENANT@SKILL5@DESCRIPTION"
msgstr "Unidade amiga alvo ganha:[bulletlist][bullet/]+{UNHOLY_CHAMPION_DAMAGE_MULTIPLIER>ResolvedMultiplier}% d dano.[bullet/]{GLOBAL.PROPERTIES.UNDYING.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.ARMOR_OF_FEAR.Hyperlink}[/bulletlist][br/]Ao conjurar, unidades inimigas em um raio de {UNHOLY_CHAMPION_CIRCLE_TARGETER>AREA>Radius} hexágonos perdem {amount} {GLOBAL.UnitMoraleConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@TOME_REVENANT@SKILL5@MODIFIER@DESCRIPTION"
msgstr "Causa +{UNHOLY_CHAMPION_DAMAGE_MULTIPLIER>ResolvedMultiplier}% d dano."

msgid "DLC@ARCHONPROPHECY@TOME_REVENANT@SKILL5@MOD_DESCRIPTION"
msgstr "Unidade tem:[bulletlist][bullet/]+{UNHOLY_CHAMPION_DAMAGE_MULTIPLIER>ResolvedMultiplier}% d dano[bullet/]{GLOBAL.PROPERTIES.UNDYING.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.ARMOR_OF_FEAR.Hyperlink}[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_REVENANT@SKILL5@NAME"
msgstr "Campeão Profano"

msgid "DLC@ARCHONPROPHECY@TOME_REVENANT@SPI@DESCRIPTION"
msgstr "[bulletlist][bullet/]+{amount} {GLOBAL.SoulConcept.Hyperlink}[bullet/]+{amount2} {GLOBAL.SoulConcept.Hyperlink} por adjacente {GLOBAL.ResearchPostConcept.Hyperlink}.[bullet/]Permite o alistamento de Esqueletos, <<m:{GLOBAL.UNITS.CORRUPT_SOUL.Hyperlink}>> e <<m:{GLOBAL.UNITS.UNDEAD_TITAN.Hyperlink}>>.[bullet/]Conta como um(a) {GLOBAL.ResearchPostConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_REVENANT@SPI@NAME"
msgstr "[researchpost/] Necropole"

msgid "DLC@ARCHONPROPHECY@TOME_REVENANT@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Erga um exército de Arcontes corrompidos e mortos‑vivos e use seu conhecimento para fazer seus mortos‑vivos ressuscitarem repetidamente, protegendo‑os daqueles que usariam os poderes da luz e do fogo."

msgid "DLC@ARCHONPROPHECY@TOME_REVENANT@TOME@LORE_DESCRIPTION"
msgstr "\"Nós, que perecemos pela luz, enquanto eles se deleitam em seu esplendor. Nós, que somos abandonados, enquanto eles são amados. Construiremos nossas necropóleis, a partir dos ossos de seus fracassos. Da escuridão do exílio, tramaremos sua ruína.\""

msgid "DLC@ARCHONPROPHECY@TOME_REVENANT@TOME@NAME"
msgstr "Tomo do Revenante"

msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@SKILL1@DESCRIPTION"
msgstr "Um(a) {GLOBAL.PROPERTIES.SHIELD_UNIT.Hyperlink} com capacidades de cura e um golpe poderoso."

msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@SKILL2@DESCRIPTION"
msgstr "Invoca um(a) {GLOBAL.UNITS.ARCHON_ANGEL.Hyperlink} {GLOBAL.PROPERTIES.BATTLE_MAGE.Hyperlink}, uma unidade que lança fogo sagrado para purificar seus inimigos."

msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@SKILL2@NAME"
msgstr "Invocar Vigil"

msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@SKILL3@BUFF_PROPERTY_DESCRIPTION"
msgstr "Unidade:[bulletlist][bullet/]Ignora {VIRTUOUS_SPIRIT_REDUCE_HEALTH_LOSS_PENALTY>ResolvedPenaltyMultip}% of <<m:{GLOBAL.CasualtyConcept.Hyperlink}>>.[bullet/]Tem +{VIRTUOUS_SPIRIT_DEFENSE>DEF_MOD>Armor} {GLOBAL.DefenseConcept.Hyperlink}.[bullet/]Tem +{VIRTUOUS_SPIRIT_DEFENSE>DEF_MOD>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@SKILL3@DESCRIPTION"
msgstr "Concede força à raça-alvo em momentos de fraqueza, concedendo a eles:[bulletlist][bullet/]+{VIRTUOUS_SPIRIT_SPIRIT_DEFENSE>REDUCTION>Spirit} {GLOBAL.SpiritResistanceConcept.Hyperlink}[bullet/]Quando esta unidade ficar abaixo de {VIRTUOUS_SPIRIT_THRESHOLD>ResolvedTriggerProportion}% of seu máximo <<m:{GLOBAL.HitPointConcept.Hyperlink}>>:[bulletlist][bullet/]Ignora {VIRTUOUS_SPIRIT_REDUCE_HEALTH_LOSS_PENALTY>ResolvedPenaltyMultip}% of seu <<m:{GLOBAL.CasualtyConcept.Hyperlink}>>.[bullet/]Ganha +{VIRTUOUS_SPIRIT_DEFENSE>DEF_MOD>Armor} {GLOBAL.DefenseConcept.Hyperlink}.[bullet/]Ganha +{VIRTUOUS_SPIRIT_DEFENSE>DEF_MOD>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}.[/bulletlist][/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@SKILL3@NAME"
msgstr "Espírito Virtuoso"

msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@SKILL3@PROPERTY_DESCRIPTION"
msgstr "Unidade tem:[bulletlist][bullet/]+{VIRTUOUS_SPIRIT_SPIRIT_DEFENSE>REDUCTION>Spirit} {GLOBAL.SpiritResistanceConcept.Hyperlink}[bullet/]Quando esta unidade ficar abaixo de {VIRTUOUS_SPIRIT_THRESHOLD>ResolvedTriggerProportion}% o do seu máximo <<m:{GLOBAL.HitPointConcept.Hyperlink}>>:[bulletlist][bullet/]Ignora {VIRTUOUS_SPIRIT_REDUCE_HEALTH_LOSS_PENALTY>ResolvedPenaltyMultip}% o da sua <<m:{GLOBAL.CasualtyConcept.Hyperlink}>>.[bullet/]Ganha +{VIRTUOUS_SPIRIT_DEFENSE>DEF_MOD>Armor} {GLOBAL.DefenseConcept.Hyperlink}.[bullet/]Ganha +{VIRTUOUS_SPIRIT_DEFENSE>DEF_MOD>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}.[/bulletlist][/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@SKILL4@DESCRIPTION"
msgstr "Alvo: unidade amiga:[bulletlist][bullet/]Remove seu <<m:{GLOBAL.NegativeStatusEffectConcept.Hyperlink}>>.[bullet/]Ganha {GLOBAL.PROPERTIES.STEADFAST.Hyperlink} por {HEROIC_STAND_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Ignora as penalidades de <<m:{GLOBAL.CasualtyConcept.Hyperlink}>> por {HEROIC_STAND_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist][br/][br/]Só pode afetar uma unidade uma vez por batalha."

msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@SKILL4@NAME"
msgstr "Posição Heroica"

msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@SKILL4@PROP_DESCRIPTION"
msgstr "Unidade tem:[bulletlist][bullet/]{GLOBAL.PROPERTIES.STEADFAST.Hyperlink}[bullet/]Ignora as penalidades de <<m:{GLOBAL.CasualtyConcept.Hyperlink}>>.[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@SKILL5@DESCRIPTION"
msgstr "A cidade perde {amount}% o de sua renda de {GLOBAL.GoldConcept.Hyperlink}, e ganha o dobro desse valor como {GLOBAL.FoodConcept.Hyperlink} e {GLOBAL.StructureProductionConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@SKILL5@NAME"
msgstr "Casa da Caridade"

msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Crie um exército virtuoso e faça‑o lutar com força até o fim."

msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@TOME@LORE_DESCRIPTION"
msgstr "\"Não na noite mais escura, não diante do horror, nem mesmo em seu último suspiro os virtuosos devem ceder. Você é a última baliza contra a vilania, a última luz no abismo. Uma era pode chegar em que a esperança morra, quando não houver mais pessoas justas — mas não é esta era, pois você ainda não caiu.\""

msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@TOME@NAME"
msgstr "Tomo da Virtude"

msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@UNIT@ABILITY1@DESCRIPTION"
msgstr "Cause dano à unidade alvo. Entre em {GLOBAL.DefenseModeConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@UNIT@ABILITY1@NAME"
msgstr "Castigo"

msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@UNIT@ABILITY2@DESCRIPTION"
msgstr "Alvo: unidade amiga:[bulletlist][bullet/]Cura por {LAY_ON_HANDS_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Ganha {amount} {GLOBAL.PROPERTIES.STATUS_PROTECTION.Hyperlink} por {STATUS_PROTECTION_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@UNIT@ABILITY2@NAME"
msgstr "Impor Mãos"

msgid "DLC@ARCHONPROPHECY@TOME_VIRTUE@UNIT@NAME"
