msgstr "Enquanto esta unidade estiver em combate, todas as unidades amigas recebem:[bulletlist][bullet/]{GLOBAL.PROPERTIES.MORALE_DRAIN.Hyperlink}[bullet/]+{amount}% d dano ao atacar unidades com 'Baixo' ou inferior {GLOBAL.UnitMoraleConcept.Hyperlink}.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@WILDHUNT_PRESENCE_04@NAME"
msgstr "Presença de Tristeza"

msgid "WILDLIFE_UNITPROPERTIES@WILDHUNT_PRESENCE_04@PROP_DESCRIPTION"
msgstr "Unidades do dono deste efeito recebem:[bulletlist][bullet/]{GLOBAL.PROPERTIES.MORALE_DRAIN.Hyperlink}[bullet/]+{amount}% d dano ao atacar unidades com 'Baixo' ou inferior {GLOBAL.UnitMoraleConcept.Hyperlink}.[/bulletlist]"

msgid "WILDLIFE_UNITPROPERTIES@WIND_BARRIER@DESCRIPTION"
msgstr "Esta unidade é {WIND_BARRIER>ResolvedAccuracyModifier}% mais difícil de ser atingida por ataques de {GLOBAL.RangedConcept.Hyperlink} e à distância {GLOBAL.MagicConcept.Hyperlink}."

msgid "WILDLIFE_UNITPROPERTIES@WIND_BARRIER@NAME"
