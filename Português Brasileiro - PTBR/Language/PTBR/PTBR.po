msgid "DIPLOMACY@PLAYEROPINION@GRUDGE_REMAIN"
msgstr "Rancor devido a <<m:{GLOBAL.CasusBelliConcept.Hyperlink}>> expirado"

msgid "DIPLOMACY@PRESSURE@DESCRIPTION"
msgstr "O nível de ameaça representa o quanto outros <<m:{GLOBAL.LeaderConcept.Hyperlink}>> se sentem ameaçados.[br/][br/]Esse nível é influenciado por diversos fatores que avaliam o desempenho de cada Governante: por exemplo, se eles possuem grande <<m:{GLOBAL.ArmyConcept.Hyperlink}>>, muitos <<m:{GLOBAL.CityConcept.Hyperlink}>>, ou são apoiados por muitos [hyperlink,GLOBAL.DSAllianceConcept]aliados[/hyperlink].[br/][br/]O nível de ameaça é expresso como um modificador de [hyperlink,GLOBAL.EmpireRelationConcept]relações[/hyperlink]."

msgid "DIPLOMACY@PRESSURE@FACTORS"
msgstr "Descobrimos os seguintes fatores contribuintes."

msgid "DIPLOMACY@PRESSURE@HYPERLINK"
msgstr "[hyperlink,GLOBAL.AIPressureConcept]Nível de Ameaça[/hyperlink]"

msgid "DIPLOMACY@PRESSURE@LEVEL_-1"
msgstr "Inquieto"

msgid "DIPLOMACY@PRESSURE@LEVEL_-1_DESCRIPTION"
msgstr "O {GLOBAL.LeaderConcept.Hyperlink} sente-se ameaçado pelo seu {GLOBAL.EmpireConcept.Hyperlink}, o que afeta suas [hyperlink,GLOBAL.EmpireRelationConcept]relações[/hyperlink] com ele em {RelationValue}[badRelation/] e também torna o comércio com ele mais caro."

msgid "DIPLOMACY@PRESSURE@LEVEL_-2"
msgstr "Vigilante"

msgid "DIPLOMACY@PRESSURE@LEVEL_-3"
msgstr "Cauteloso"

msgid "DIPLOMACY@PRESSURE@LEVEL_-4"
msgstr "Ameaçado"

msgid "DIPLOMACY@PRESSURE@LEVEL_0"
msgstr "Indiferente"

msgid "DIPLOMACY@PRESSURE@LEVEL_0_DESCRIPTION"
msgstr "O {GLOBAL.LeaderConcept.Hyperlink} sente-se indiferente ao seu {GLOBAL.EmpireConcept.Hyperlink}, o que ainda pode mudar com o tempo."

msgid "DIPLOMACY@PRESSURE@LEVEL_1"
msgstr "Tranquilo"

msgid "DIPLOMACY@PRESSURE@LEVEL_1_DESCRIPTION"
msgstr "O {GLOBAL.LeaderConcept.Hyperlink} sente-se confiante em relação ao seu {GLOBAL.EmpireConcept.Hyperlink}, o que afeta suas [hyperlink,GLOBAL.EmpireRelationConcept]Relações[/hyperlink] com ele em {RelationValue}[goodRelation/]."

