msgid "EXPANSION_VICTORY@VICTORY_CONDITION@DESCRIPTION"
msgstr "Quando um {GLOBAL.EmpireConcept.Hyperlink} cresce o suficiente, seja por si mesmo {GLOBAL.DomainConcept.Hyperlink} ou ao [hyperlink,GLOBAL.PactOfVassalageConcept]Vassalizing[/hyperlink] <<m:{GLOBAL.IndependentCityConcept.Hyperlink}>>, ele pode buscar a vitória de expansão. Para isso, precisará construir três <<m:{GLOBAL.STRUCTURE_UPGRADES.BEACONOFUNITY.Hyperlink}>> e iluminá‑los. Se o império e seus [hyperlink,GLOBAL.DSAllianceConcept]Allies[/hyperlink] puderem defender e manter seus faróis por tempo suficiente, serão vitoriosos."

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ANCIENT_TREE@DESCRIPTION"
msgstr "[bulletlist][bullet/]{manabonus} {GLOBAL.ManaConcept.Hyperlink} e {knowledgebonus} {GLOBAL.KnowledgeConcept.Hyperlink} por {GLOBAL.ForesterConcept.Hyperlink} em {GLOBAL.CityConcept.Hyperlink} {GLOBAL.DomainConcept.Hyperlink}.[bullet/]Adiciona {GLOBAL.UNITS.ENTWINED_THRALL_UNIT.Hyperlink}, {GLOBAL.UNITS.ENTWINED_PROTECTOR_UNIT.Hyperlink} e {GLOBAL.UNITS.ENTWINED_SCOURGE_UNIT.Hyperlink} ao {GLOBAL.RequestMilitaryAidConcept.Hyperlink}.[/bulletlist]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ANCIENT_TREE@LORE"
msgstr "[lorefontsize][lorefont]Escritura descreve como os Primeiros Elfos visitaram todos os [hyperlink,GLOBAL.WorldsWithinLoreConcept]Worlds[/hyperlink] para semear vida neles. Esta magnífica árvore permanece como um testemunho daquela era. Dizem que as almas desses Primeiros ainda residem dentro dela, às vezes manifestando‑se como os Entwined, eternamente ligados a proteger seu crescimento.[/lorefont][/lorefontsize]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ANCIENT_TREE@NAME"
msgstr "Árvore-Mundo"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ANCIENT_WELLSPRING@DESCRIPTION"
msgstr "[bulletlist][bullet/]{stabilitybonus} {GLOBAL.CityStabilityConcept.Hyperlink} por {GLOBAL.FarmConcept.Hyperlink} e {GLOBAL.ForesterConcept.Hyperlink} em {GLOBAL.CityConcept.Hyperlink} {GLOBAL.DomainConcept.Hyperlink}.[bullet/]Amigável <<m:{GLOBAL.UnitConcept.Hyperlink}>> em {GLOBAL.DomainConcept.Hyperlink} são curados por {healamount} <<m:{GLOBAL.HitPointConcept.Hyperlink}>> no final de cada turno estratégico {GLOBAL.TurnConcept.Hyperlink}.[bullet/]Adiciona {GLOBAL.UNITS.SPRING_FAIRY.Hyperlink}, {GLOBAL.UNITS.SUMMER_FAIRY.Hyperlink}, {GLOBAL.UNITS.AUTUMN_FAIRY.Hyperlink} e {GLOBAL.UNITS.WINTER_FAIRY.Hyperlink} ao {GLOBAL.RequestMilitaryAidConcept.Hyperlink}.[/bulletlist]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ANCIENT_WELLSPRING@LORE"
msgstr "[lorefontsize][lorefont]Esta localização exuberante é alimentada por uma nascente mágica que flui diretamente do reino feérico. Águas místicas atraem todo tipo de criaturas, sem saber que são potenciais vítimas das artimanhas dos seres feéricos. O que uma fada considera travessura pode ser potencialmente mortal para outros! Mesmo os seres mais poderosos devem prosseguir com certa cautela.[/lorefont][/lorefontsize]"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ANCIENT_WELLSPRING@NAME"
msgstr "Nascente Oculta"

msgid "EXPLORATIONSITES_STRATEGIC@STRUCTURE_ARCHON_RUINS@DESCRIPTION"
