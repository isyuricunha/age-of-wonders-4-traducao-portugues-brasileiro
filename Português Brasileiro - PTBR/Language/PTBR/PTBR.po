msgstr "{INT_0}/{INT_1} Comunicou-se com o Alto Conselho"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@DEFEAT_ANONL_QUEST_OBJECTIVE"
msgstr "{INT_0}/{INT_1} Anon Derrotado"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@DEFEAT_MALIEL_QUEST_OBJECTIVE"
msgstr "{INT_0}/{INT_1} Maliel Derrotado"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@DEFEAT_REVENANT_QUEST_OBJECTIVE"
msgstr "{INT_0}/{INT_1} Revenants Derrotados"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@DESCRIPTION"
msgstr "Entre no reino oculto de Emnora, fortaleza do {GLOBAL.ArchonsLoreConcept.Hyperlink}, em busca de ajuda contra {GLOBAL.UrrathLoreConcept.Hyperlink}. Lute ou negocie seu caminho pelas camadas da Ordem Celestial para provar seu valor e {GLOBAL.MagehavenLoreConcept.Hyperlink} digno da atenção do Alto Conselho dos Arcontes."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@EFFECT@WIZARD_TOWER_REWARD"
msgstr "Seu {GLOBAL.ThroneCityConcept.Hyperlink} {EventCity} ganha o {GLOBAL.STRUCTURE_UPGRADES.WIZARD_TOWER_FOUNDATION.Hyperlink} {GLOBAL.CityStructureConcept.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@FALLEN_ANGEL_NO_UPKEEP_PROP@DESCRIPTION"
msgstr "Esta unidade está ligada ao seu dono pela Maldição dos Revenants e não tem manutenção."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@FALLEN_ANGEL_NO_UPKEEP_PROP@NAME"
msgstr "Vínculo da Corrupção"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@GLOOMWATCH_RACE@DESCRIPTION"
msgstr "No {GLOBAL.GloomwatchLoreConcept.Hyperlink}, pessoas de muitas raças e origens diferentes se unem, ligadas ao serviço do {GLOBAL.DreamersLoreConcept.Hyperlink} — e à resistência contra {GLOBAL.UrrathLoreConcept.Hyperlink}. Um grupo particularmente misterioso entre eles são os Enviados da Vigília Sombria. Eles têm aparência justa e são adoradores inabaláveis do {GLOBAL.AllfatherLoreConcept.Hyperlink}. Como tal, são muito conhecedores do {GLOBAL.ArchonsLoreConcept.Hyperlink} e estão dispostos a ajudar [hyperlink,GLOBAL.MagehavenLoreConcept]Magehaven's[/hyperlink] {GLOBAL.GodirLoreConcept.Hyperlink} em sua busca por contato com os Arcontes."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@GLOOMWATCH_RACE@NAME"
msgstr "Enviados da Vigília Sombria^p"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@HIGH_COUNCIL@NAME"
msgstr "Sede do Conselho^N"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@INFILTRATE_COUNCIL_OBJECTIVE"
msgstr "Alto Conselho Infiltrado"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@JULIA_WITHDRAWS"
msgstr "Você perde {EventHero} como um {GLOBAL.HeroConcept.Hyperlink} no mapa."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@MAIN_OBJECTIVE_FINAL"
msgstr "{AP1_COUNCIL_COMMUNED}/1 Alto Conselho dos Arcontes Contatado"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@MAIN_OBJECTIVE_FINAL_ALT"
