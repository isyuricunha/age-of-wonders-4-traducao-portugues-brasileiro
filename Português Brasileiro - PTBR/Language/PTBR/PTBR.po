msgstr "Um(a) {GLOBAL.PROPERTIES.SUPPORT_UNIT.Hyperlink} que invoca e fortalece <<m:{GLOBAL.PROPERTIES.ANIMAL.Hyperlink}>>."

msgid "TOME_WILD@SKILL4@NAME"
msgstr "Falante Selvagem^f"

msgid "TOME_WILD@SKILL5@DESCRIPTION"
msgstr "Unidades amigas {GLOBAL.PROPERTIES.ANIMAL.Hyperlink} e {GLOBAL.PROPERTIES.CAVALRY_GROUP.Hyperlink} em um raio de {CALL_OF_THE_WILD_CIRCLE_TARGETER>AREA>Radius} hexágonos recebem:[bulletlist][bullet/]{defense} {GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink}[bullet/]{damage} {GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink}[/bulletlist]"

msgid "TOME_WILD@SKILL5@NAME"
msgstr "Chamado da Selva"

msgid "TOME_WILD@TOME@DESCRIPTION"
msgstr "Caminhe ao lado do <<m:{GLOBAL.PROPERTIES.ANIMAL.Hyperlink}>> da natureza. Especialize-se em invocar e fortalecer <<m:{GLOBAL.PROPERTIES.ANIMAL.Hyperlink}>> e torne-se mais forte ao ficar ao lado deles."

msgid "TOME_WILD@TOME@LORE_AUTHOR"
msgstr "Serena, Feiticeira Élfica da Vida"

msgid "TOME_WILD@TOME@LORE_DESCRIPTION"
msgstr "\"São as bestas que herdarão o mundo. Suas patas pisarão sobre nossas sepulturas muito depois que suas presas reduzirem nossos ossos a pó. Invocai seu poder, se ousardes. Comandai sua ferocidade e nutri-a, para que possais colher os benefícios deste poder primal.\""

msgid "TOME_WILD@TOME@NAME"
msgstr "Tomo das Bestas"

msgid "TOME_WILD_MAGIC@SKILL1@DESCRIPTION"
msgstr "[bulletlist][bullet/]No início da batalha, o atacante ganha {amount} {GLOBAL.UNITS.DEVASTATOR_SPHERE_UNIT.Hyperlink} até o final da batalha.[bullet/]<<m:{GLOBAL.UNITS.DEVASTATOR_SPHERE_UNIT.Hyperlink}>> são {GLOBAL.PROPERTIES.SIEGECRAFT_UNIT.Hyperlink} <<m:{GLOBAL.UnitConcept.Hyperlink}>> que podem detonar em obstáculos-alvo ou {GLOBAL.UnitConcept.Hyperlink} para causar dano massivo e destruir obstáculos.[bullet/]Só um tipo de unidade de Cerco pode ser levado para {GLOBAL.CombatConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_WILD_MAGIC@SKILL1@DETONATE@DESCRIPTION"
msgstr "A unidade detona a si mesma. Em um raio de {DETONATE_UNIT_TARGETER_CIRCLE>AREA>Radius} hexágonos:[bulletlist][bullet/]Unidades recebem dano.[bullet/]Todos os obstáculos são destruídos.[bullet/]Define hexágonos {GLOBAL.OnFireConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_WILD_MAGIC@SKILL1@DETONATE@NAME"
msgstr "Detonar e Devastar"

msgid "TOME_WILD_MAGIC@SKILL1@NAME"
msgstr "Construir Esferas Devastadoras"

msgid "TOME_WILD_MAGIC@SKILL2@DESCRIPTION"
