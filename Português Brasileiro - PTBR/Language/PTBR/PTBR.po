msgid "TOME_SUBJUGATION@TOME@LORE_DESCRIPTION"
msgstr "\"Aos justos é concedido o dever de trazer luz àqueles que ainda estão na escuridão. Quem assumir esse dever receberá o direito ao poder. A semente errante deve ser esmagada sob o calcanhar da virtude antes que possa crescer! Seus inimigos podem recuar a princípio, mas seus exércitos serão sempre encorajados por seu glorioso propósito.\""

msgid "TOME_SUBJUGATION@TOME@NAME"
msgstr "Tomo de Subjugação"

