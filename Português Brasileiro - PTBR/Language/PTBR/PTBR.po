msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@GRAND_STATUARY@LORE"
msgstr "\"Ao caminhar entre estas estátuas desgastadas, reflito sobre as almas que elas imortalizam. Até mesmo aqueles cujos nomes foram esquecidos exigem meu respeito. Serei eu também lembrado—ou esquecido—como estas? Receberão oferendas minha imagem de pedra, ou será abandonada ao tempo? Se minhas feições fossem esculpidas em pedra, tornariam‑se um farol de esperança—ou de temor?\"[br/][br/]— Alfred Elderstone, Reflexões sobre o Governo"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@GRAND_STATUARY@NAME"
