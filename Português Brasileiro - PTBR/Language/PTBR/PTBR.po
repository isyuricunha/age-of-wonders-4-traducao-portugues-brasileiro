msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@MOF@NEXT_TOOLTIP"
msgstr "O próximo exército de crise surgirá em {CrisisTimer} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@MOF@OBJ_ARMIES"
msgstr "Exércitos de Crise Ativos: {AP1_MOF_NUM_ARMIES}"

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@MOF@POP_LOSS_DEBUFF"
msgstr "Enquanto qualquer exército de crise estiver ativo, um dos seus <<m:{GLOBAL.CityConcept.Hyperlink}>> perde um {GLOBAL.PopulationConcept.Hyperlink} a cada {AP1_MOF_DEBUFF_INTERVAL} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@MOF@SIEGE_DAMAGE"
msgstr "Enquanto qualquer exército de crise estiver ativo, seu <<m:{GLOBAL.CityConcept.Hyperlink}>> perde {AP1_MOF_SIEGE_DAMAGE} {GLOBAL.FortificationHealthConcept.Hyperlink} a cada {AP1_MOF_DEBUFF_INTERVAL} <<m:{GLOBAL.TurnConcept.Hyperlink}>>."

msgid "DLC@ARCHONPROPHECY@STORY_REALM_01@MOF@STABILITY_DEBUFF"
msgstr "Enquanto qualquer exército de crise estiver ativo, seu <<m:{GLOBAL.CityConcept.Hyperlink}>> tem {AP1_MOF_INCOME_DEBUFF} {GLOBAL.CityStabilityConcept.Hyperlink}."

