msgid "DLC@ELDRITCHREALMS@ELDRITCH_SPECIALIZATION@HAVOC_CASTER@NAME"
msgstr "Conjurador do Caos"

msgid "DLC@ELDRITCHREALMS@ELDRITCH_SPECIALIZATION@MADCASTER@ABILITY01@DESCRIPTION"
msgstr "Inimigos em um raio de {hex} hexágonos têm {amount} desses efeitos ocorrendo aleatoriamente:[bulletlist][bullet/]Transformar-se em um {GLOBAL.PROPERTIES.ANIMAL.Hyperlink} de Tier I aleatório por {animalDuration} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Manter {firedamage} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Ganhar {GLOBAL.PROPERTIES.INSANITY.Hyperlink} por {InsaneDuration} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Tornar-se {GLOBAL.PROPERTIES.BLINDED.Hyperlink} até o final do combate.[bullet/]{moraleAmount} {GLOBAL.UnitMoraleConcept.Hyperlink}.[bullet/]Sofrer {frostdamage} {GLOBAL.FrostDamageConcept.Hyperlink} e tornar-se {GLOBAL.PROPERTIES.FROZEN.Hyperlink} por {frozenDuration} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Ganhar {GLOBAL.PROPERTIES.INFERNAL_REBIRTH.Hyperlink} até o final do combate.[bullet/]Ganhar {electrifyAmount} {GLOBAL.PROPERTIES.ELECTRIFIED.Hyperlink}.[bullet/]Curar {healAmount} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[/bulletlist]"

msgid "DLC@ELDRITCHREALMS@ELDRITCH_SPECIALIZATION@MADCASTER@ABILITY01@NAME"
msgstr "Pulso de Caos"

msgid "DLC@ELDRITCHREALMS@ELDRITCH_SPECIALIZATION@MADCASTER@ABILITY02@DESCRIPTION"
