msgid "DIPLOMACY@CALLTOWAR@BUTTON_ANSWER"
msgstr "Responder ao Chamado à Guerra de {Player.Lord.FirstName}"

msgid "DIPLOMACY@CALLTOWAR@BUTTON_ANSWER_AGAINST"
