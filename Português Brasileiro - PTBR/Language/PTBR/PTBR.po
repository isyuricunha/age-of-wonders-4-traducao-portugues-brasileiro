msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@ASCENSION_TRAIT@FIELD_ABJURER@NAME"
msgstr "Abjurador de Campo"

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@ASCENSION_TRAIT@FIELD_ABJURER@PROP_NAME"
msgstr "Bênção do Abjurador de Campo"

msgid "DLC@SECRETSOFTHEARCHMAGES@META_EMPIRE@ASCENSION_TRAIT@FIERY_SEDUCTOR@HERO_TRAIT_DESCRIPTION"
