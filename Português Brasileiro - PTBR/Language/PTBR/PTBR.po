msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@ICEBOUND_BEHEMOTH@DESCRIPTION"
msgstr "<<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacentes a este Marco recebem:[bulletlist][bullet/]{income}.[bullet/] Um [researchpost/] Posto de Pesquisa nesta província concede {income2}.[bullet/] O {combatproperty} {GLOBAL.CombatEnchantmentConcept.Hyperlink}[/bulletlist][br/] Um {GLOBAL.CityConcept.Hyperlink} com {amount} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> adjacente a este Marco recebe:[bulletlist][bullet/] Ganhe {visionbonus} {GLOBAL.VisionRangeConcept.Hyperlink} e {sensingbonus} {GLOBAL.SensorRangeConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@ICEBOUND_BEHEMOTH@LORE"
msgstr "\"Olhar para esses vastos olhos congelados é estar à beira da própria eternidade. Mesmo selados em gelo, eles me perfuram — através da carne, da alma, da própria trama do cosmos. Nós, que reivindicamos domínio do arcano, não somos nada comparados a esse colosso do {GLOBAL.UrwildernessLoreConcept.Hyperlink}. O que somos para esse vidente atemporal e esquecido?\"[br/][br/]— Merlin, o Errante, diários recuperados da Quarta Era"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@ICEBOUND_BEHEMOTH@NAME"
msgstr "Behemoth Congelado"

msgid "DLC@GIANTKINGS@MEGAWONDERS_STRATEGIC@ICEBOUND_BEHEMOTH@NAME_OVERRIDE_01"
