msgstr "Invoca um(a) {GLOBAL.UNITS.LESSER_LIGHT_SPIRIT.Hyperlink} {GLOBAL.PROPERTIES.SUPPORT_UNIT.Hyperlink}."

msgid "TOME_BEACON@SKILL1@NAME"
msgstr "Invocar Espírito de Luz Menor"

msgid "TOME_BEACON@SKILL2@DESCRIPTION"
msgstr "Unidades recrutadas através de {GLOBAL.RequestMilitaryAidConcept.Hyperlink} da {GLOBAL.PvEVassalConcept.Hyperlink} alvo têm {GLOBAL.PROPERTIES.FAITHFUL.Hyperlink}.[br/]A cidade Vassalo alvo concede ao jogador {amount} {GLOBAL.ManaConcept.Hyperlink} a cada {GLOBAL.TurnConcept}."

msgid "TOME_BEACON@SKILL2@NAME"
msgstr "Aliança da Fé"

msgid "TOME_BEACON@SKILL3@DESCRIPTION"
msgstr "Invoca um(a) {GLOBAL.UNITS.BLESSED_SOUL.Hyperlink} {GLOBAL.PROPERTIES.SHIELD_UNIT.Hyperlink} que pode reunir suas unidades e condenar o inimigo."

msgid "TOME_BEACON@SKILL3@NAME"
msgstr "Invocar Alma Abençoada"

msgid "TOME_BEACON@SKILL5@DESCRIPTION"
msgstr "Concede unidades encantadas:[bulletlist][bullet/]{GLOBAL.PROPERTIES.FAITHFUL.Hyperlink}, que reduz {GLOBAL.UnitUpkeepConcept.Hyperlink}.[bullet/]+{MIGHTY_MEEK_RESISTANCE>Resistance} {GLOBAL.StatusResistanceConcept.Hyperlink}.[bullet/]+{MIGHTY_MEEK_COUNTING_TIER_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink} nos ataques para cada Nível de Unidade do alvo.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_BEACON@SKILL5@MOD_DESCRIPTION"
msgstr "+{MIGHTY_MEEK_COUNTING_TIER_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink} para cada Nível de Unidade do alvo."

msgid "TOME_BEACON@SKILL5@NAME"
msgstr "Manso Poderoso"

msgid "TOME_BEACON@SKILL5@PROPERTY_DESCRIPTION"
msgstr "Unidade:[bulletlist][bullet/]Tem {GLOBAL.PROPERTIES.FAITHFUL.Hyperlink}.[bullet/]Tem +{MIGHTY_MEEK_RESISTANCE>Resistance} {GLOBAL.StatusResistanceConcept.Hyperlink}.[bullet/]Causa +{MIGHTY_MEEK_COUNTING_TIER_DAMAGE>DAMAGE>Spirit} {GLOBAL.SpiritDamageConcept.Hyperlink} nos ataques para cada Nível da Unidade do alvo.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_BEACON@SKILL6@DESCRIPTION"
msgstr "Invoca um(a) {GLOBAL.UNITS.DIVINE_BEACON_UNIT.Hyperlink}. Ao conjurar e no início de cada turno, unidades amigas em um raio de {DIVINE_BEACONS_GRACE_UNIT_TARGETER_CIRCLE>AREA>Radius} hexágonos:[bulletlist][bullet/]Cura +{DIVINE_BEACONS_GRACE_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Ganha +{DIVINE_BEACONS_GRACE_MORALE_GAIN>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}.[/bulletlist]{LOC.CONCEPT@SUMMON_LIVE_SHARED}[br/][br/]{LOC.TACTICAL@ABILITY@NEVER_IN_WATER}"

msgid "TOME_BEACON@SKILL6@NAME"
msgstr "Conjurar Farol Divino"

msgid "TOME_BEACON@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Libera a radiação interior do(a) {GLOBAL.PROPERTIES.FAITHFUL.Hyperlink} para castigar inimigos e fortalecer aliados."

msgid "TOME_BEACON@TOME@LORE_AUTHOR"
msgstr "Sola, a Pura, Humano Exaltado"

msgid "TOME_BEACON@TOME@LORE_DESCRIPTION"
msgstr "\"Fé, fervor, glória justa: tais coisas podem se espalhar como uma chama sagrada, trazendo a luz da verdade até os olhos de seus inimigos! Um verdadeiro farol de fé brilha tão intensamente que sela as próprias feridas dos fiéis e incute dúvida nos infiéis, conduzindo-os ao caminho verdadeiro... o seu caminho.\""

msgid "TOME_BEACON@TOME@NAME"
msgstr "Tomo do Farol"

msgid "TOME_BEACON@UNIT2@NAME"
msgstr "Farol Divino^n"

msgid "TOME_BEACON@UNIT2_ABILITY@DESCRIPTION"
msgstr "Unidades amigas dentro de {DIVINE_BEACONS_GRACE_UNIT_TARGETER_CIRCLE>AREA>Radius} hexágonos:[bulletlist][bullet/]Cura +{DIVINE_BEACONS_GRACE_HEAL>NumHitpointsToRestore} <<m:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>.[bullet/]Ganha {DIVINE_BEACONS_GRACE_MORALE_GAIN>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_BEACON@UNIT2_ABILITY@NAME"
msgstr "Graça do Farol Divino"

msgid "TOME_BEACON@UNIT@NAME"
msgstr "Portador de Luz^n"

msgid "TOME_BEASTS@PASSIVE@DESCRIPTION"
msgstr "<<m:{GLOBAL.PROPERTIES.ANIMAL.Hyperlink}>> tem o Posto {amount}."

msgid "TOME_BEASTS@PASSIVE@NAME"
msgstr "Afiar Instintos"

msgid "TOME_CHAOS_CHANNELING@HERO_SKILL@DESCRIPTION"
msgstr "Atacantes inimigos dentro de {CHAOTIC_REBUKE_MAGIC_EFFECT_SHIELD>MaxAttackerDistance} hexágonos têm uma base {chance}% c de chance de ganhar um efeito de status aleatório."

msgid "TOME_CHAOS_CHANNELING@HERO_SKILL@NAME"
msgstr "Repreensão Caótica"

msgid "TOME_CHAOS_CHANNELING@PASSIVE@DESCRIPTION"
msgstr "Saqueando <<m:{GLOBAL.ProvinceConcept}>> concede {amount} {GLOBAL.ManaConcept}."

msgid "TOME_CHAOS_CHANNELING@PASSIVE@NAME"
msgstr "Extrair Caos"

msgid "TOME_CHAOS_CHANNELING@SKILL1@DESCRIPTION"
msgstr "[bulletlist][bullet/]Invoca um exército completo de unidades aleatórias de Nível I que não sejam Batedor e que podem ser produzidas em uma cidade no hexágono alvo.[bullet/]Se conjurada dentro de um {GLOBAL.ProvinceConcept.Hyperlink} inimigo, saqueia-o instantaneamente.[/bulletlist]"

msgid "TOME_CHAOS_CHANNELING@SKILL1@NAME"
msgstr "Horda Dourada"

msgid "TOME_CHAOS_CHANNELING@SKILL2@DESCRIPTION"
msgstr "Todas as unidades inimigas:[bulletlist][bullet/]Mantêm {FAN_THE_INFERNO_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink} que ignora {BREACHING>MODIFIERS>ResolvedResistance}% of {GLOBAL.ResistanceConcept.Hyperlink}.[bullet/]São afetadas por {GLOBAL.PROPERTIES.BURNING.Hyperlink}.[/bulletlist]"

msgid "TOME_CHAOS_CHANNELING@SKILL2@NAME"
msgstr "Incendiar o Inferno"

msgid "TOME_CHAOS_CHANNELING@SKILL3@DESCRIPTION"
msgstr "Transforma a raça-alvo na personificação do fogo, concedendo a ela:[bulletlist][bullet/]{SCION_OF_FLAME_DEFENSE>REDUCTION>Fire} {GLOBAL.FireResistanceConcept.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.VENGEFUL_FLAMES.Hyperlink}, que causa dano a {GLOBAL.MeleeConcept.Hyperlink} atacantes.[bullet/]{GLOBAL.PROPERTIES.FIERY_WAKE.Hyperlink}, que incendeia terrenos inflamáveis como <<m:{GLOBAL.FloraObstacleConcept.Hyperlink}>>.[bullet/]Imunidade a {GLOBAL.PROPERTIES.BURNING.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.LAVA_WALK.Hyperlink}.[bullet/]<<m:{GLOBAL.CityConcept.Hyperlink}>> desta raça ignoram a penalidade de {GLOBAL.CityStabilityConcept.Hyperlink} de Abismo e Lava em seus {GLOBAL.DomainConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CHAOS_CHANNELING@SKILL3@NAME"
msgstr "Descendente da Chama"

msgid "TOME_CHAOS_CHANNELING@SKILL3@PROPERTY_DESCRIPTION"
msgstr "Unidade tem:[bulletlist][bullet/]{SCION_OF_FLAME_DEFENSE>REDUCTION>Fire} {GLOBAL.FireResistanceConcept.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.VENGEFUL_FLAMES.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.FIERY_WAKE.Hyperlink}[bullet/]Imunidade a {GLOBAL.PROPERTIES.BURNING.Hyperlink}[bullet/]{GLOBAL.PROPERTIES.LAVA_WALK.Hyperlink}[/bulletlist]"

msgid "TOME_CHAOS_CHANNELING@SKILL4@DESCRIPTION"
msgstr "Sempre que outra unidade morre em batalha, a unidade encantada ganha:[bulletlist][bullet/]{GLOBAL.PROPERTIES.INFERNAL_MIGHT.Hyperlink} por {INFERNAL_BLAZE_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]+{DEMONIC_SIPHON_MORALE>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}.[/bulletlist][br/]Não ocorre ao morrerem unidades <<m:{GLOBAL.PROPERTIES.COMBAT_SUMMON.Hyperlink}>>, {GLOBAL.PROPERTIES.TOWER_UNIT.Hyperlink} e {GLOBAL.PROPERTIES.SIEGECRAFT_UNIT.Hyperlink}."

msgid "TOME_CHAOS_CHANNELING@SKILL4@NAME"
msgstr "Sifão Demoníaco"

msgid "TOME_CHAOS_CHANNELING@SKILL4@PROPERTY_DESCRIPTION"
msgstr "Sempre que outra unidade morre em batalha, esta unidade ganha:[bulletlist][bullet/]{GLOBAL.PROPERTIES.INFERNAL_MIGHT.Hyperlink} por {INFERNAL_BLAZE_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]+{DEMONIC_SIPHON_MORALE>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}.[br/][br/]Não ocorre ao morrerem unidades <<m:{GLOBAL.PROPERTIES.COMBAT_SUMMON.Hyperlink}>>, {GLOBAL.PROPERTIES.TOWER_UNIT.Hyperlink} e {GLOBAL.PROPERTIES.SIEGECRAFT_UNIT.Hyperlink}.[/bulletlist]"

msgid "TOME_CHAOS_CHANNELING@SKILL4@PROP_DESCRIPTION"
msgstr "[bulletlist][bullet/]Ataques têm +{amount} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.FIEND.Hyperlink} unidades ganham +{INFERNAL_BLAZE_FIEND_CRIT>ResolvedCritChanceBonus}% c de chance crítica.[bullet/]Pode acumular até {amountStacks} vezes.[/bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_CHAOS_CHANNELING@SKILL4@PROP_NAME"
msgstr "Poder Infernal"

msgid "TOME_CHAOS_CHANNELING@SKILL5@DESCRIPTION"
msgstr "Alvo: uma cidade, e sempre que lutar nesse domínio, um(a) {GLOBAL.UNITS.GREMLIN_UNIT.Hyperlink} é invocado(a) ao lado de uma de suas unidades a cada {GLOBAL.TurnConcept.Hyperlink}.[br/]Até {amount} <<m:{GLOBAL.UNITS.GREMLIN_UNIT.Hyperlink}>> podem ser invocados por batalha."

msgid "TOME_CHAOS_CHANNELING@SKILL5@NAME"
msgstr "Emboscadores Gremlin"

msgid "TOME_CHAOS_CHANNELING@SKILL5@PROP_DESCRIPTION"
msgstr "Um(a) {GLOBAL.UNITS.GREMLIN_UNIT.Hyperlink} é invocado(a) ao lado de uma das unidades do proprietário a cada {GLOBAL.TurnConcept.Hyperlink}."

msgid "TOME_CHAOS_CHANNELING@SKILL6@DESCRIPTION"
msgstr "Invoca um(a) não-{GLOBAL.PROPERTIES.FIEND.Hyperlink} de Nível V {GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink} com habilidades de Fogo e Queimando no hexágono alvo."

msgid "TOME_CHAOS_CHANNELING@SKILL6@NAME"
msgstr "Invocar Incarnado da Chama"

msgid "TOME_CHAOS_CHANNELING@SKILL7@ABILITY_DESCRIPTION"
msgstr "Causa dano a unidades em um raio de {FIRE_BOMB_TARGETER_CIRCLE>AREA>Radius} hexágonos."

msgid "TOME_CHAOS_CHANNELING@SKILL7@ABILITY_NAME"
msgstr "Bomba de Fogo"

msgid "TOME_CHAOS_CHANNELING@SKILL7@DESCRIPTION"
msgstr "Unidades encantadas ganham:[bulletlist][bullet/]A habilidade {GLOBAL.PROPERTIES.FIRE_BOMB.Hyperlink}, que causa dano mágico em área.[bullet/]O dano desta habilidade aumenta com o nível da unidade.[/bulletlist]"

msgid "TOME_CHAOS_CHANNELING@SKILL7@NAME"
msgstr "Foco de Incendiário"

msgid "TOME_CHAOS_CHANNELING@SKILL7@PROP_DESCRIPTION"
msgstr "Unidade tem:[bulletlist][bullet/]A habilidade {GLOBAL.PROPERTIES.FIRE_BOMB.Hyperlink}.[/bulletlist]"

msgid "TOME_CHAOS_CHANNELING@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Torne‑se o mestre do Caos ao explorar seus poderes caóticos acumulados dos {GLOBAL.ChaosConcept.Hyperlink} <<m:{GLOBAL.TomeConcept.Hyperlink}>> anteriores."

msgid "TOME_CHAOS_CHANNELING@TOME@LORE_AUTHOR"
msgstr "Karissa, a Vermelha, Senhora das Paixões"

msgid "TOME_CHAOS_CHANNELING@TOME@LORE_DESCRIPTION"
msgstr "\"Abrace o Caos, e ele o abraçará também, espalhando fervor a tudo que tocar! Um verdadeiro agente da desordem verá a ordem e a lógica distorcidas em loucura e tumulto, sempre torcidas a seu favor!\""

msgid "TOME_CHAOS_CHANNELING@TOME@NAME"
msgstr "Tomo de Canalização do Caos"

msgid "TOME_CHAOS_LORD@HERO_SKILL@DESCRIPTION"
msgstr "Invoca um {GLOBAL.PROPERTIES.INFERNAL_FIEND.Hyperlink} aleatório de Nível I sempre que esta unidade mata outra unidade. Há uma pequena chance de que um {GLOBAL.PROPERTIES.INFERNAL_FIEND.Hyperlink} de Nível II seja invocado em vez disso.[br/]Não funciona em batalhas aquáticas."

msgid "TOME_CHAOS_LORD@HERO_SKILL@NAME"
msgstr "Carnificina Demoníaca"

msgid "TOME_CHAOS_LORD@PASSIVE@DESCRIPTION"
msgstr "Substitui um Assalto Impetuoso por um Assalto Imparável, que:[bulletlist][bullet/]Causa mais dano ao {GLOBAL.FortificationHealthConcept} da cidade.[bullet/]Não reduz o <<m:{GLOBAL.HitPointConcept}>> das suas unidades.[bullet/]Não faz com que suas unidades se tornem {GLOBAL.PROPERTIES.EXHAUSTED.Hyperlink}.[/bulletlist]"

msgid "TOME_CHAOS_LORD@PASSIVE@NAME"
msgstr "Assalto Imparável"

msgid "TOME_CHAOS_LORD@PASSIVE@PROPERTY@DESCRIPTION"
msgstr "Acelera significativamente um cerco."

msgid "TOME_CHAOS_LORD@SKILL1@DESCRIPTION"
msgstr "Transforma a raça-alvo em seres demoníacos, concedendo-lhes:[bulletlist][bullet/]O tipo de unidade {GLOBAL.PROPERTIES.INFERNAL_FIEND.Hyperlink}.[bullet/]{GLOBAL.PROPERTIES.FLYING_MOVEMENT.Hyperlink}, aumentando a mobilidade.[bullet/]{GLOBAL.PROPERTIES.FRENZY.Hyperlink}, aumentando o dano ao atacar.[bullet/]<<m:{GLOBAL.CityConcept.Hyperlink}>> desta raça ignoram a penalidade de {GLOBAL.CityStabilityConcept.Hyperlink} de Abismo e Lava em seu {GLOBAL.DomainConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CHAOS_LORD@SKILL1@NAME"
msgstr "Filho de Demônio"

msgid "TOME_CHAOS_LORD@SKILL2@DESCRIPTION"
msgstr "Todas as unidades atacantes recebem {GLOBAL.PROPERTIES.KILLING_MOMENTUM.Hyperlink} e {GLOBAL.PROPERTIES.HASTENED.Hyperlink} por {HASTENED_EFFECT_DESCRIPTION_3>NumTurns} <<m:{GLOBAL.TurnConcept}>>."

msgid "TOME_CHAOS_LORD@SKILL2@NAME"
msgstr "Investida Demoníaca"

msgid "TOME_CHAOS_LORD@SKILL3@DESCRIPTION"
msgstr "[bulletlist][bullet/]Após {turn} [turn/] em batalha, {Number} unidades inimigas não-{GLOBAL.HeroConcept.Hyperlink} são {GLOBAL.PROPERTIES.MIND_CONTROLLED} até o fim do combate.[bullet/]A cidade sofre -{HappinessDebuff} {GLOBAL.CityStabilityConcept.Hyperlink} enquanto está sob cerco.[/bulletlist]"

msgid "TOME_CHAOS_LORD@SKILL3@NAME"
msgstr "Incitar Rebelião"

msgid "TOME_CHAOS_LORD@SKILL4@DESCRIPTION"
msgstr "Invoca um avatar do seu {GLOBAL.LeaderConcept.Hyperlink} para a batalha. O avatar possui as mesmas habilidades que o seu Governante e nasce com <<m:{GLOBAL.ActionPointConcept.Hyperlink}>> cheio. Todos os <<m:{GLOBAL.PROPERTIES.FIEND.Hyperlink}>> recebem +{AVATAR_OF_CHAOS_MORALE>Morale Change} {GLOBAL.UnitMoraleConcept.Hyperlink}.[br/][br/]{LOC.TACTICAL@ABILITY@NEVER_IN_WATER}[br/]Não pode ser usado em batalhas onde o seu {GLOBAL.LeaderConcept.Hyperlink} está presente."

msgid "TOME_CHAOS_LORD@SKILL4@NAME"
msgstr "Invocar Avatar do Caos"

msgid "TOME_CHAOS_LORD@SKILL5@NAME"
msgstr "Era do Caos"

msgid "TOME_CHAOS_LORD@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Liberte forças caóticas sobre o mundo. Especialize‑se em bônus ofensivos."

msgid "TOME_CHAOS_LORD@TOME@LORE_AUTHOR"
msgstr "Karissa, a Vermelha, Senhora das Paixões"

msgid "TOME_CHAOS_LORD@TOME@LORE_DESCRIPTION"
msgstr "\"Delicie‑se com a desordem! Prospere no tumulto! Sua aura de Caos é como uma névoa insidiosa que distorce a realidade e incita a loucura. A própria terra parece tremer ao seu chegar, e seres dos reinos demoníacos percebem sua presença. Nasça em fogo e sangue, ó Godir, e traga a Era do Caos!\""

msgid "TOME_CHAOS_LORD@TOME@NAME"
msgstr "Tomo do Lorde do Caos"

msgid "TOME_COLD_DARK@HERO_SKILL@DESCRIPTION"
msgstr "Ataques base {GLOBAL.MagicConcept.Hyperlink} têm uma chance base {BLINDED_RESISTANCE>ResolvedStrength}% c de infligir {GLOBAL.PROPERTIES.BLINDED.Hyperlink}.[br/][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "TOME_COLD_DARK@HERO_SKILL@NAME"
msgstr "Magia Cegante"

msgid "TOME_COLD_DARK@PASSIVE@DESCRIPTION"
msgstr "Arrasar <<m:{GLOBAL.CityConcept}>> e pilhar <<m:{GLOBAL.ProvinceConcept}>> transforma o {GLOBAL.ProvinceConcept} em uma província Ártica."

msgid "TOME_COLD_DARK@PASSIVE@NAME"
msgstr "Ruínas Congeladas"

msgid "TOME_COLD_DARK@PASSIVE_FARMING@DESCRIPTION"
msgstr "Capaz de construir <<m:{GLOBAL.FarmConcept.Hyperlink}>> em terreno de Neve.[br/][br/]<<m:{GLOBAL.FarmConcept.Hyperlink}>> em terreno de Neve ganham +{amount} {GLOBAL.FoodConcept.Hyperlink} se sua raça possui Adaptação Ártica."

msgid "TOME_COLD_DARK@PASSIVE_FARMING@NAME"
msgstr "Agricultura Ártica"

msgid "TOME_COLD_DARK@PASSIVE_STABILITY@DESCRIPTION"
msgstr "<<m:{GLOBAL.ProvinceConcept.Hyperlink}>> com Neve concedem +{amount} {GLOBAL.CityStabilityConcept.Hyperlink}."

msgid "TOME_COLD_DARK@PASSIVE_STABILITY@NAME"
msgstr "Preferência por Neve"

msgid "TOME_COLD_DARK@SKILL1@DESCRIPTION"
msgstr "A cada turno, por {BLINDING_MIST_AUTO_SPELL>TimeToLive} <<m:{GLOBAL.TurnConcept}>>, todos os inimigos:[bulletlist][bullet/]Sustentam {WITHERING_MIST_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Têm uma chance base {BLINDED_RESISTANCE>ResolvedStrength}% c de se tornarem {GLOBAL.PROPERTIES.BLINDED.Hyperlink} por {BLINDED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Têm uma chance base {WEAKENED_RESISTANCE>ResolvedStrength}% c de se tornarem {GLOBAL.PROPERTIES.WEAKENED.Hyperlink} por {WEAKENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "TOME_COLD_DARK@SKILL1@NAME"
msgstr "Névoa Murcha"

msgid "TOME_COLD_DARK@SKILL1@PROPERTY@DESCRIPTION"
msgstr "A cada turno, todos os inimigos:[bulletlist][bullet/]Sustentam {WITHERING_MIST_DAMAGE>DAMAGE>Frost} {GLOBAL.FrostDamageConcept.Hyperlink}.[bullet/]Têm uma chance base {BLINDED_RESISTANCE>ResolvedStrength}% c de se tornarem {GLOBAL.PROPERTIES.BLINDED.Hyperlink} por {BLINDED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[bullet/]Têm uma chance base {WEAKENED_RESISTANCE>ResolvedStrength}% c de se tornarem {GLOBAL.PROPERTIES.WEAKENED.Hyperlink} por {WEAKENED_EFFECT_DESCRIPTION>NumTurns} <<m:{GLOBAL.TurnConcept}>>.[/bulletlist]"

msgid "TOME_COLD_DARK@SKILL2@DESCRIPTION"
msgstr "Invoca um {GLOBAL.UNITS.SNOW_SPIRIT.Hyperlink}, um {GLOBAL.PROPERTIES.MAGIC_FIGHTER.Hyperlink} cujos ataques infligem {GLOBAL.PROPERTIES.FROZEN.Hyperlink}."

msgid "TOME_COLD_DARK@SKILL2@NAME"
msgstr "Invocar Espírito da Neve"

msgid "TOME_COLD_DARK@SKILL3@DESCRIPTION"
msgstr "Faz o inverno percorrer as veias da raça-alvo, concedendo-lhes:[bulletlist][bullet/]{FROSTLING_TRANSFORMATION_DEFENSE>REDUCTION>Frost} {GLOBAL.FrostResistanceConcept.Hyperlink}.[bullet/]Imunidade a {GLOBAL.PROPERTIES.FROZEN.Hyperlink}.[bullet/]+{FROSTLING_TRANSFORMATION_MORALE_BONUS_FROZEN_WASTE>MoraleBonus} {GLOBAL.UnitMoraleConcept.Hyperlink} enquanto estiverem em terreno frio.[bullet/]{GLOBAL.PROPERTIES.ARCTIC_WALK.Hyperlink}, o que permite atravessar terreno frio mais rapidamente.[/bulletlist]"

msgid "TOME_COLD_DARK@SKILL3@NAME"
msgstr "Transformação de Frostling"

msgid "TOME_COLD_DARK@SKILL3@PROP_DESCRIPTION"
msgstr "A unidade possui:[bulletlist][bullet/]{FROSTLING_TRANSFORMATION_DEFENSE>REDUCTION>Frost} {GLOBAL.FrostResistanceConcept.Hyperlink}.[bullet/]Imunidade a {GLOBAL.PROPERTIES.FROZEN.Hyperlink}.[bullet/]+{FROSTLING_TRANSFORMATION_MORALE_BONUS_FROZEN_WASTE>MoraleBonus} {GLOBAL.UnitMoraleConcept.Hyperlink} enquanto estiver em terreno frio.[bullet/]{GLOBAL.PROPERTIES.ARCTIC_WALK.Hyperlink}.[/bulletlist]"

msgid "TOME_COLD_DARK@SKILL4@DESCRIPTION"
msgstr "Alvo que lidera um exército ganha {GLOBAL.PROPERTIES.UNIVERSAL_CAMOUFLAGE.Hyperlink} para todo o seu exército por {turns} <<m:{GLOBAL.TurnConcept}>>."

msgid "TOME_COLD_DARK@SKILL4@NAME"
msgstr "Véu das Trevas"

msgid "TOME_COLD_DARK@SKILL4@PROPERTY@DESCRIPTION"
msgstr "Todo o exército ganha {GLOBAL.PROPERTIES.UNIVERSAL_CAMOUFLAGE.Hyperlink}."

msgid "TOME_COLD_DARK@SKILL5@DESCRIPTION"
msgstr "Alvo aliado {GLOBAL.CityConcept.Hyperlink} ganha:[bulletlist]Cada {GLOBAL.TurnConcept.Hyperlink}, {amount} <<m:{GLOBAL.ProvinceConcept.Hyperlink}>> dentro ou adjacente ao {GLOBAL.DomainConcept.Hyperlink}:[bulletlist][bullet/]Ganha {GLOBAL.SnowConcept.Hyperlink} e {GLOBAL.FrozenWasteConcept.Hyperlink}.[bullet/]Perde {GLOBAL.ChasmConcept.Hyperlink}, {GLOBAL.SwampConcept.Hyperlink}, {GLOBAL.AshlandsConcept.Hyperlink}, {GLOBAL.SandConcept.Hyperlink}, {GLOBAL.CavernFloorConcept.Hyperlink}, {GLOBAL.FungusFieldsConcept.Hyperlink} e {GLOBAL.GloomTerrainConcept.Hyperlink}.[/bulletlist][bullet/]Províncias no domínio com Neve ou Gelo concedem +{resources} {GLOBAL.FoodConcept.Hyperlink} e +{resources} {GLOBAL.StructureProductionConcept.Hyperlink} de renda.[/bulletlist]"

msgid "TOME_COLD_DARK@SKILL5@NAME"
msgstr "Inverno Marchante"

msgid "TOME_COLD_DARK@TOME@GAMEPLAY_DESCRIPTION"
msgstr "Espalhe terreno Ártico por todo o mundo e envolva suas unidades com seu poder, para que elas sejam fortalecidas por sua presença."

msgid "TOME_COLD_DARK@TOME@LORE_AUTHOR"
msgstr "Artica, a Fria, Rainha dos Frostlings"

msgid "TOME_COLD_DARK@TOME@LORE_DESCRIPTION"
msgstr "\"A luz traz tanto calor quanto esperança. Apague-a e você mergulhará seus inimigos em uma noite fria e eterna! Roube-lhes o conforto, destrua sua esperança, deixe-os com membros dormentes e olhos cegos. A escuridão drenará a vontade de lutar, vencer e viver dos seus inimigos!\""

msgid "TOME_COLD_DARK@TOME@NAME"
msgstr "Tomo da Escuridão Fria"

msgid "TOME_CREATOR@HERO_SKILL@DESCRIPTION"
msgstr "Unidade cresce em tamanho e ganha:[bulletlist][bullet/]{GLOBAL.PROPERTIES.LARGE_TARGET.Hyperlink}[bullet/]+{ANCIENT_OF_EARTH_STAT_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]+{ANCIEN_OF_EARTH_DAMAGE_MULTIPLIER>ResolvedMultiplier}% damage[/bulletlist][br/]Unidade não pode mais usar montaria."

msgid "TOME_CREATOR@HERO_SKILL@DESCRIPTION_DRGON"
msgstr "Unidade ganha:[bulletlist][bullet/]+{ANCIENT_OF_EARTH_STAT_BONUS>BONUS>HitPoints} <<m:{GLOBAL.HitPointConcept.Hyperlink}>>[bullet/]+{ANCIEN_OF_EARTH_DAMAGE_MULTIPLIER>ResolvedMultiplier}% damage[/bulletlist]"

msgid "TOME_CREATOR@HERO_SKILL@ES_NAME"
msgstr "Ancião"

msgid "TOME_CREATOR@HERO_SKILL@NAME"
msgstr "Ancião da Terra"

msgid "TOME_CREATOR@PASSIVE@DESCRIPTION"
