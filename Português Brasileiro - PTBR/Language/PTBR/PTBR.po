msgid "DLC@ELDRITCHREALMS@ELDRITCH_SPECIALIZATION@FLESHWEAVER@POSSESSED_THRALL@DESCRIPTION"
msgstr "{GLOBAL.PROPERTIES.ENTHRALL.Hyperlink}:[bulletlist][bullet/] Agora aplica {GLOBAL.PROPERTIES.DOMINATED.Hyperlink} aumentado para {amount}%.[bullet/] Em caso de sucesso também aplica {GLOBAL.PROPERTIES.EMPOWER.Hyperlink}.[bullet/] Se a unidade morrer, ainda se torna um {GLOBAL.ThrallConcept.Hyperlink} ao final da batalha.[/bulletlist]"

