msgid "TOME_CRUCIBLE@SKILL2@UNLOCK@NAME"
msgstr "Baluartes do Crisol em Combate"

msgid "TOME_CRUCIBLE@SKILL3@DESCRIPTION"
msgstr "Alvo: raio de {LAVA_BURST_OBSTACLE_TARGETER_CIRCLE>AREA>Radius} hexágonos:[bulletlist][bullet/]Todas as unidades recebem {LAVA_BURST_UNIT_DAMAGE>DAMAGE>Fire} {GLOBAL.FireDamageConcept.Hyperlink}.[bullet/]Todas as unidades são afetadas por {GLOBAL.PROPERTIES.BURNING.Hyperlink}.[bullet/]Todas as unidades são {GLOBAL.PROPERTIES.SLOWED.Hyperlink}.[bullet/]O terreno é definido {GLOBAL.OnFireConcept.Hyperlink}.[/bulletlist]"

msgid "TOME_CRUCIBLE@SKILL3@NAME"
msgstr "Explosão de Lava"

msgid "TOME_CRUCIBLE@SKILL4@DESCRIPTION"
